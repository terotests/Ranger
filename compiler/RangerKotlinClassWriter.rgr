; SPDX-License-Identifier: MIT

Import "TraitAnalysis.rgr"
Import "ForLoopAnalysis.rgr"
Import "EnumAnalysis.rgr"

class RangerKotlinClassWriter {
  Extends (RangerGenericClassWriter)
  def compiler:LiveCompiler
  ; S5 (PLAN_SHAPES.md): a union becomes a `sealed interface` its members
  ; implement, so the JVM keeps the static type a shape declares instead of
  ; erasing it to Any. Declared once, before the first class of the file.
  def kotlin_unions_written:boolean false

  ; which behaviour-only Ranger `trait`s become a Kotlin interface
  def ktTraits:TraitInterfaceAnalysis (new TraitInterfaceAnalysis())
  ; can a `for` be the target's own loop over the collection?
  ; Target-neutral question, one place: compiler/ForLoopAnalysis.rgr
  def ktLoops:ForLoopShape (new ForLoopShape())
  def kotlin_traits_written:boolean false

  ; which Ranger `Enum`s survive as a Kotlin `enum class` rather than an Int.
  ; Same question Rust and C++ ask: compiler/EnumAnalysis.rgr.
  def ktEnums:EnumNativeAnalysis (new EnumNativeAnalysis())
  def kotlin_enums_written:boolean false

  fn ktEnumIsNative:boolean (enumName:string ctx:RangerAppWriterContext) {
    ktEnums.targetName = "kotlin"
    ktEnums.fallbackType = "Int"
    return (ktEnums.isNative(enumName ctx))
  }

  ; `enum class Color { Red, Green, Blue }`. No discriminants: an enum only
  ; reaches this form when no use in the program observes its integer value,
  ; which is exactly what the analysis checks.
  fn writeKotlinNativeEnums:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    if kotlin_enums_written {
      return
    }
    kotlin_enums_written = true
    def enumRoot:RangerAppWriterContext (ctx.getRoot())
    for (keys enumRoot.definedEnums) ken:string kei {
      if (this.ktEnumIsNative(ken ctx)) {
        def keDef:RangerAppEnum (unwrap (get enumRoot.definedEnums ken))
        wr.out("" true)
        wr.out(("enum class " + ken + " {") true)
        wr.indent(1)
        for (keys keDef.values) kmn:string kmi {
          wr.out(((ctx.transformWord(kmn)) + ",") true)
        }
        wr.indent(-1)
        wr.out("}" true)
      }
    }
  }

  ; A behaviour-only trait named as a type, as a Kotlin interface. The mixin
  ; copy still gives each consumer its own body; this makes the name a type,
  ; and the bodies become `override`s of it.
  fn writeKotlinTraitInterfaces:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    if kotlin_traits_written {
      return
    }
    kotlin_traits_written = true
    ktTraits.compute(ctx)
    for (keys ktTraits.ifaceTraits) tn:string tni {
      def tc:RangerAppClassDesc (ctx.findClass(tn))
      wr.out("" true)
      wr.out(("interface " + tn) false)
      wr.out(" {" true)
      wr.indent(1)
      for tc.defined_variants fnVar:string fvi {
        def mVs:RangerAppMethodVariants (get tc.method_variants fnVar)
        for mVs.variants variant:RangerAppFunctionDesc vi {
          wr.out(("fun " + variant.compiledName + "(") false)
          this.writeArgsDef(variant ctx wr)
          wr.out(") : " false)
          this.writeTypeDef( (unwrap variant.nameNode ) ctx wr)
          wr.out("" true)
        }
      }
      wr.indent(-1)
      wr.out("}" true)
    }
  }

  fn writeKotlinUnionInterfaces:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    if kotlin_unions_written {
      return
    }
    kotlin_unions_written = true
    def names:[string] (this.sealableUnionNames(ctx))
    for names uname:string ui {
      wr.out("" true)
      wr.out(("sealed interface " + (this.unionInterfaceName(uname))) true)
    }
  }

  fn WriteScalarValue:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    switch node.value_type {
      case RangerNodeType.Double {
        ; the value, never a source slice: getParsedString reads the file back
        ; by the node's recorded position, and a file with CRLF line endings --
        ; or a macro-shifted position -- slices unrelated bytes into the
        ; output. `def value:double 0.0` in a CRLF file wrote `= lue`.
        ; The `.0` suffix is what makes the literal a Double rather than an Int.
        def dd_str:string ("" + node.double_value)
        if (this.doubleNeedsPointZero(dd_str)) {
          wr.out((dd_str + ".0") false)
        } {
          wr.out(dd_str false)
        }
      }
      case RangerNodeType.String {
        def s:string (this.EncodeString(node ctx wr))
        wr.out((("\"" + s) + "\"") false)
      }
      case RangerNodeType.Integer {
        ; Kotlin `Int` is signed 32-bit. Literals outside that range are Long
        ; and will not type-check against Int parameters or `and`/`or`.
        ; -2147483648 is written as (-2147483647 - 1): the literal 2147483648
        ; does not fit a signed 32-bit int, and on C# a constant expression that
        ; overflows is a compile error, not a wrap.
        if ((node.int_value > 2147483647) || (node.int_value < ((0 - 2147483647) - 1))) {
          wr.out((("(" + node.int_value) + "L).toInt()") false)
        } {
          wr.out(("" + node.int_value) false)
        }
      }
      case RangerNodeType.Boolean {
        if node.boolean_value {
          wr.out("true" false)
        } {
          wr.out("false" false)
        }
      }
    }
  }

  ; Kotlin has no bare `[]` array literal (outside annotations). Empty and
  ; non-empty lists both go through typed `arrayListOf`, matching the
  ; `MutableList<T>` the rest of the writer emits.
  fn writeArrayLiteral( node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def elemType:string node.eval_array_type
    if ((strlen elemType) == 0) {
      elemType = node.array_type
    }
    wr.out("arrayListOf<" false)
    if ((strlen elemType) > 0) {
      wr.out((this.getObjectTypeString(elemType ctx)) false)
    } {
      wr.out("Any" false)
    }
    wr.out(">(" false)
    node.children.forEach({
      if( index > 0 ) {
        wr.out(", " false)
      }
      this.WalkNode( item ctx wr )
    })
    wr.out(")" false)
  }
  fn adjustType:string (tn:string) {
    if (tn == "this") {
      return "this"
    }
    return tn
  }
  fn getObjectTypeString:string (type_string:string ctx:RangerAppWriterContext) {
    if ((strlen type_string) >= 2) {
      if ((charAt type_string 0) == (ccode "[")) {
        return (this.collectionTypeStringToKotlin(type_string ctx))
      }
    }
    ; A `union` names no type of its own on the JVM — nothing declares it, so
    ; the union name reached the output and kotlinc saw an undeclared type. The
    ; narrowing `case` operator tests with `is` and casts, both of which work
    ; off Any. (A sealed interface would be the better representation and is
    ; what `shape` should generate; see PLAN_SHAPES.md.)
    if (ctx.isDefinedClass(type_string)) {
      def cc:RangerAppClassDesc (ctx.findClass(type_string))
      if (cc.is_union) {
        ; a union of classes is a sealed interface; anything else (the
        ; compiler's own `Any`, a union over primitives) stays the top type
        if (this.unionIsSealable(cc ctx)) {
          return (this.unionInterfaceName(type_string))
        }
        return "Any"
      }
      ; A systemclass names one type per target. Without this the Ranger name
      ; reached the output and kotlinc saw an undeclared type: JSONValueUnion
      ; instead of the Any? that JSON.rgr declares for Kotlin.
      if cc.is_system {
        def sysName@(optional):string (get cc.systemNames "kotlin")
        if (!null? sysName) {
          return (unwrap sysName)
        }
      }
    }
    switch type_string {
      case "int" {
        return "Int"
      }
      case "string" {
        return "String"
      }
      case "chararray" {
        return "CharArray"
      }
      case "buffer" {
        return "ByteArray"
      }
      case "int_buffer" {
        return "LongArray"
      }
      case "double_buffer" {
        return "DoubleArray"
      }
      case "char" {
        ; an integer code unit, not Kotlin's Char: `charAt` and `charcode` both
        ; hand back `.code`, and Char does not compare with an Int literal
        return "Int"
      }
      case "boolean" {
        return "Boolean"
      }
      case "double" {
        return "Double"
      }
    }
    ; An Enum value is an Int on Kotlin, and the enum name is no Kotlin type.
    ; Only the value_type == Enum path in writeTypeDef knew that, so an enum in
    ; a RETURN position -- `fn typeNameAsType:RangerNodeType (...)` -- wrote its
    ; Ranger name and kotlinc saw an undeclared type.
    if (ctx.isEnumDefined(type_string)) {
      return "Int"
    }
    return type_string
  }
  ; Convert a nested collection type string such as "[string]" or
  ; "[string:[int]]" into the corresponding Kotlin type, recursing on the
  ; element/value types.
  fn collectionTypeStringToKotlin:string (type_string:string ctx:RangerAppWriterContext) {
    def n:int (strlen type_string)
    def inner:string (substring type_string 1 (n - 1))
    def il:int (strlen inner)
    def depth:int 0
    def sep:int (0 - 1)
    def i:int 0
    while (i < il) {
      def c:int (charAt inner i)
      if (c == (ccode "[")) {
        depth = depth + 1
      }
      if (c == (ccode "]")) {
        depth = depth - 1
      }
      if ((c == (ccode ":")) && (depth == 0)) {
        sep = i
      }
      i = i + 1
    }
    if (sep >= 0) {
      def kt:string (substring inner 0 sep)
      def vt:string (substring inner (sep + 1) il)
      return (((("MutableMap<" + (this.getObjectTypeString(kt ctx))) + ",") + (this.getObjectTypeString(vt ctx))) + ">")
    }
    return (("MutableList<" + (this.getObjectTypeString(inner ctx))) + ">")
  }
  fn getTypeString:string (type_string:string) {
    switch type_string {
      case "int" {
        return "Int"
      }
      case "string" {
        return "String"
      }
      case "chararray" {
        return "CharArray"
      }
      case "buffer" {
        return "ByteArray"
      }
      case "int_buffer" {
        return "LongArray"
      }
      case "double_buffer" {
        return "DoubleArray"
      }
      case "char" {
        ; an integer code unit, not Kotlin's Char: `charAt` and `charcode` both
        ; hand back `.code`, and Char does not compare with an Int literal
        return "Int"
      }
      case "boolean" {
        return "Boolean"
      }
      case "double" {
        return "Double"
      }
    }
    return type_string
  }
  ; A Kotlin function type: `(A, B) -> R`. Without this case the type of a
  ; lambda-valued parameter or local came out EMPTY -- `fun forTree(cb : )` --
  ; and the reads inside the body could not resolve either, which was most of
  ; the 1000 "unresolved reference: item" errors.
  fn writeLambdaType:void (expression_value:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def rv:CodeNode (itemAt expression_value.children 0)
    def sec:CodeNode (itemAt expression_value.children 1)
    wr.out("(" false)
    for sec.children arg:CodeNode i {
      if (i > 0) {
        wr.out(", " false)
      }
      this.writeTypeDef(arg ctx wr)
    }
    wr.out(") -> " false)
    if ((rv.type_name == "void") || (rv.eval_type_name == "void")) {
      wr.out("Unit" false)
    } {
      this.writeTypeDef(rv ctx wr)
    }
  }

  fn writeTypeDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def v_type:RangerNodeType node.value_type
    if (node.eval_type != RangerNodeType.NoType) {
      v_type = node.eval_type
    }
    switch v_type {
      case RangerNodeType.ExpressionType {
        ; parenthesised, because the `?` below binds to the whole type: an
        ; optional lambda field is `((String) -> CodeNode?)?` and never
        ; `(String) -> CodeNode??`
        if (node.hasFlag("optional")) {
          wr.out("(" false)
          this.writeLambdaType((unwrap node.expression_value) ctx wr)
          wr.out(")" false)
        } {
          this.writeLambdaType((unwrap node.expression_value) ctx wr)
        }
      }
      case RangerNodeType.Enum {
        def ktEnumName:string (ktEnums.enumNameOf(node ctx))
        if (this.ktEnumIsNative(ktEnumName ctx)) {
          wr.out(ktEnumName false)
        } {
          wr.out("Int" false)
        }
      }
      case RangerNodeType.Integer {
        wr.out("Int" false)
      }
      case RangerNodeType.Double {
        wr.out("Double" false)
      }
      case RangerNodeType.Char {
        wr.out("Int" false)
      }
      case RangerNodeType.CharBuffer {
        wr.out("CharArray" false)
      }
      case RangerNodeType.Buffer {
        wr.out("ByteArray" false)
      }
      case RangerNodeType.IntBuffer {
        wr.out("LongArray" false)
      }
      case RangerNodeType.DoubleBuffer {
        wr.out("DoubleArray" false)
      }
      case RangerNodeType.String {
        wr.out("String" false)
      }
      case RangerNodeType.Boolean {
        wr.out("Boolean" false)
      }
      case RangerNodeType.Hash {
        wr.out((((("MutableMap<" + (this.getObjectTypeString(node.key_type ctx))) + ",") + (this.getObjectTypeString(node.array_type ctx))) + ">") false)
      }
      case RangerNodeType.Array {
        wr.out((("MutableList<" + (this.getObjectTypeString(node.array_type ctx))) + ">") false)
      }
      default {
        if (node.type_name == "void") {
          wr.out("Unit" false)
        } {
          ; A trait CARRYING FIELDS is not a Kotlin interface: its consumers
          ; each own their own copy of the field, so there is nothing for an
          ; interface to promise. It used to reach the file as the bare name,
          ; which kotlinc answers with "unresolved reference". A trait of
          ; methods only is an interface (writeKotlinTraitInterfaces) and does
          ; name a type.
          if (ctx.isDefinedClass(node.type_name)) {
            def ktTC:RangerAppClassDesc (ctx.findClass(node.type_name))
            if ktTC.is_trait {
              if ((ktTraits.isInterface(node.type_name ctx)) == false) {
                ctx.addError(node (("the Kotlin target writes a `trait` as a mixin, so `" + node.type_name) + "` is not a type it can name. A trait that declares only METHODS becomes a Kotlin interface and can be used as a type; this one carries fields, which its consumers each hold their own copy of. Use a class with subclasses, or give the parameter a concrete type."))
              }
            }
          }
          ; getObjectTypeString, not getTypeString: a union has no Kotlin type
          ; of its own and has to be written as Any here too, not only as a
          ; collection element type.
          wr.out((this.getObjectTypeString(node.type_name ctx)) false)
        }
      }
    }
    if (node.hasFlag("optional")) {
      wr.out("?" false)
    }
  }
  ; A Kotlin lambda is `{ a, b -> ... }`. The generic writer emits the
  ; JavaScript arrow form `(a, b) => { ... }`, which is not Kotlin at all: the
  ; parameters were never declared, so every read of `item` or `index` inside
  ; the body was an unresolved reference, and the `=>` itself accounted for most
  ; of the parse errors around each call site.
  fn CreateLambda:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def lambdaCtx (unwrap node.lambda_ctx)
    def rv:CodeNode (itemAt node.children 0)
    def args:CodeNode (itemAt node.children 1)
    def body:CodeNode (itemAt node.children 2)
    ; An anonymous FUNCTION rather than a lambda literal. The generic writer
    ; emits the JavaScript arrow form `(a, b) => { … }`, which is not Kotlin at
    ; all -- the parameters were never declared, so every read of `item` or
    ; `index` inside the body was an unresolved reference.
    ;
    ; `fun(a: T, b: Int): R { … }` and not `{ a, b -> … }` because Kotlin does
    ; not allow a bare `return` inside a lambda literal: it would return from
    ; the ENCLOSING function, and is only legal when the lambda is inline. The
    ; compiler's lambdas return values -- `map`, `filter`, `sort` -- and 120 of
    ; the errors were exactly that, with another 78 downstream of the body's
    ; type then being inferred as Unit. An anonymous function takes the same
    ; plain `return` every other target writes.
    wr.out("fun(" false)
    for args.children arg:CodeNode i {
      if (i > 0) {
        wr.out(", " false)
      }
      if (arg.flow_done == false) {
        this.compiler.parser.WalkNode(arg lambdaCtx wr)
      }
      this.WalkNode(arg lambdaCtx wr)
      wr.out(" : " false)
      this.writeTypeDef(arg lambdaCtx wr)
    }
    wr.out(") : " false)
    if ((rv.type_name == "void") || (rv.eval_type_name == "void")) {
      wr.out("Unit" false)
    } {
      this.writeTypeDef(rv lambdaCtx wr)
    }
    wr.out(" {" true)
    wr.indent(1)
    lambdaCtx.restartExpressionLevel()
    for body.children item:CodeNode i {
      this.WalkNode(item lambdaCtx wr)
    }
    wr.newline()
    wr.indent(-1)
    wr.out("}" false)
  }

  fn WriteVRef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (node.vref == "this") {
      wr.out("this" false)
      return
    }
    if (node.eval_type == RangerNodeType.Enum) {
      if( (array_length node.ns) > 1) {
        def rootObjName:string (itemAt node.ns 0)
        def enumName:string (itemAt node.ns 1)
        def e@(optional):RangerAppEnum (ctx.getEnum(rootObjName))
        if (!null? e) {
          ; `Color.Green`, not `1`, when the enum survives as an enum class
          if (this.ktEnumIsNative(rootObjName ctx)) {
            wr.out((rootObjName + "." + (ctx.transformWord(enumName))) false)
            return
          }
          wr.out(("" + (unwrap (get e.values enumName))) false)
          return
        }
      }
    }
    def max_len:int (array_length node.ns)
    if ((array_length node.nsp) > 0) {
      for node.nsp p:RangerAppParamDesc i {
        if (i == 0) {
          def part:string (itemAt node.ns 0)
          if(part == "this") {
            wr.out("this" false)
            continue
          }
          ; Check if this is a reference to current class (instance method call)
          def uc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
          if (!null? uc) {
            def currC:RangerAppClassDesc (unwrap uc)
            if (part == currC.name) {
              ; Replace ClassName with this for instance method calls -- but
              ; NOT when the member named after it is a static one. A static
              ; method lives in the companion object, so `this.create(...)`
              ; does not resolve; the class name in `EVGColor.create(...)` has
              ; to survive.
              if( (false == (ctx.isInStatic())) && (false == (this.namesStaticMember(currC node))) ) {
                wr.out("this" false)
                continue
              }
            }
          }
          ; Check if this is a member variable
          if (ctx.isMemberVariable(part)) {
            if( false == (ctx.isInStatic()) ) {
              wr.out("this." false)
            }
          }
        }
        if (i > 0) {
          wr.out("." false)
        }
        if ((strlen p.compiledName) > 0) {
          wr.out((this.adjustType(p.compiledName)) false)
        } {
          if ((strlen p.name) > 0) {
            wr.out((this.adjustType(p.name)) false)
          } {
            wr.out((this.adjustType((itemAt node.ns i))) false)
          }
        }
        if (i == 0) {
          if (p.nameNode.hasFlag("optional")) {
            wr.out("!!" false)
          }
        } {
          ; A segment in the MIDDLE of a path needs the same `!!`. Kotlin smart
          ; casts a local after a null test but never a mutable property, so
          ; `target.nameNode` stays `CodeNode?` inside
          ; `if (!null? target.nameNode)` and reading through it is an error --
          ; "only safe (?.) or non-null asserted (!!.) calls are allowed", and
          ; "smart cast is impossible, because it is a mutable property that
          ; could have been changed by this time". Only the last segment is left
          ; bare: there the optional IS the value.
          if (i < ((array_length node.nsp) - 1)) {
            if (p.nameNode.hasFlag("optional")) {
              wr.out("!!" false)
            }
          }
        }
      }
      return
    }
    if node.hasParamDesc {
      def p:RangerAppParamDesc node.paramDesc
      wr.out(p.compiledName false)
      return
    }
    for node.ns part:string i {
      if (i > 0) {
        wr.out("." false)
      }
      if (i == 0) {
        ; Check if first part is the current class name
        def uc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
        if (!null? uc) {
          def currC:RangerAppClassDesc (unwrap uc)
          if (part == currC.name) {
            if( (false == (ctx.isInStatic())) && (false == (this.namesStaticMember(currC node))) ) {
              wr.out("this" false)
              continue
            }
          }
        }
      }
      wr.out((this.adjustType(part)) false)
    }
  }
  ; Kotlin reads `$name` and `${expr}` inside a string literal as a template
  ; substitution, so a dollar sign has to be escaped -- without this a program
  ; that BUILDS a template string, as the TS engine does, either fails to parse
  ; (`"${"`) or silently interpolates a local. Everything else is the encoding
  ; RangerGenericClassWriter does.
  fn EncodeString:string (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def encoded_str:string ""
    def str_length:int (strlen node.string_value)
    def ii:int 0
    while (ii < str_length) {
      def cc:int (charAt node.string_value ii)
      switch cc {
        case 8 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 98))
        }
        case 9 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 116))
        }
        case 10 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 110))
        }
        case 12 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 102))
        }
        case 13 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 114))
        }
        case 34 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 34))
        }
        case 36 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 36))
        }
        case 92 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 92))
        }
        default {
          encoded_str = (encoded_str + (strfromcode cc))
        }
      }
      ii = (ii + 1)
    }
    return encoded_str
  }

  ; True when the receiver of a call is spelled with a nullable Kotlin type --
  ; either the reference itself carries the optional flag, or it names a
  ; variable whose declaration does. writeTypeDef gives such a declaration a
  ; trailing `?`, and Kotlin then refuses a plain `.` call on it.
  fn receiverIsNullable:boolean (obj:CodeNode) {
    if (obj.hasFlag("optional")) {
      return true
    }
    if obj.hasParamDesc {
      def p:RangerAppParamDesc obj.paramDesc
      def nn@(optional):CodeNode p.nameNode
      if (!null? nn) {
        if ((unwrap nn).hasFlag("optional")) {
          return true
        }
      }
    }
    return false
  }

  ; Same shape as RangerGenericClassWriter.CreateCallExpression, plus the null
  ; assertion Kotlin needs: a field declared without an initializer comes out
  ; as `EvalContext?`, and `(moduleScope).has(k)` on it does not compile --
  ; "only safe (?.) or non-null asserted (!!.) calls are allowed". The
  ; namespaced path in WriteVRef already writes `!!`; a bare single-name
  ; receiver reached this one instead and got neither that nor `this.`.
  fn CreateCallExpression(node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.has_call {
      def obj:CodeNode (node.getSecond())
      def method:CodeNode (node.getThird())
      def args:CodeNode (itemAt node.children 3)

      this.writeCallReceiver(obj ctx wr)
      if (this.receiverIsNullable(obj)) {
        wr.out("!!" false)
      }
      wr.out("." false)
      def methodName method.vref
      if ((!null? node.fnDesc) && ((strlen node.fnDesc.compiledName) > 0)) {
        methodName = node.fnDesc.compiledName
      }
      wr.outMapped(methodName method false method.vref)
      wr.out("(" false)
      ctx.setInExpr()
      def pms (filter (args.children) {
        if( item.hasFlag('keyword')) {
          return false
        }
        return true
      })
      for pms arg:CodeNode i {
        if (i > 0) {
          wr.out(", " false)
        }
        this.WalkNode(arg ctx wr)
      }
      ctx.unsetInExpr()
      wr.out(")" false)
      if ((ctx.expressionLevel()) == 0) {
        wr.out(";" true)
      }
    }
  }

  ; True when a namespaced path whose root is the class name goes on to name a
  ; static member of it -- `EVGColor.create` inside EVGColor. Kotlin puts those
  ; in the companion object, where `this` cannot reach them.
  fn namesStaticMember:boolean (cl:RangerAppClassDesc node:CodeNode) {
    if ((array_length node.ns) < 2) {
      return false
    }
    def member:string (itemAt node.ns 1)
    if (cl.hasStaticMethod(member)) {
      return true
    }
    return false
  }

  fn writeVarDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasParamDesc {
      def nn:CodeNode (itemAt node.children 1)
      def p:RangerAppParamDesc nn.paramDesc
      if ((p.ref_cnt == 0) && (p.is_class_variable == false)) {
        if ((array_length node.children) > 2) {
          def value:CodeNode (node.getThird())
          if (this.defValueHasSideEffects(value)) {
            this.writeSideEffectOnlyStmt(value ctx wr)
            return
          }
        }
        wr.out("/* unused:  " false)
      }
      if p.is_class_variable {
        wr.out("@JvmField " false)
      }
      if ((p.set_cnt > 0) || p.is_class_variable) {
        wr.out("var " false)
      } {
        wr.out("val " false)
      }
      wr.out(p.compiledName false)
      wr.out(" : " false)
      this.writeTypeDef((unwrap p.nameNode) ctx wr)
      wr.out(" " false)
      if ((array_length node.children) > 2) {
        wr.out(" = " false)
        ctx.setInExpr()
        def value:CodeNode (node.getThird())
        this.WalkNode(value ctx wr)
        ctx.unsetInExpr()
      } {
        if (nn.hasFlag("optional")) {
          wr.out(" = null" false)
        } {
          if (nn.value_type == RangerNodeType.Array) {
            wr.out(" = arrayListOf()" false)
          }
          if (nn.value_type == RangerNodeType.Hash) {
            wr.out(" = hashMapOf()" false)
          }
        }
      }
      if ((p.ref_cnt == 0) && (p.is_class_variable == true)) {
        wr.out("     /* note: unused */" false)
      }
      if ((p.ref_cnt == 0) && (p.is_class_variable == false)) {
        wr.out("   **/ ;" true)
      } {
        wr.out(";" false)
        wr.newline()
      }
    }
  }
  fn paramEmitName:string (arg:RangerAppParamDesc ctx:RangerAppWriterContext) {
    if ((strlen arg.compiledName) > 0) {
      return arg.compiledName
    }
    return (ctx.transformWord(arg.name))
  }

  ; A Kotlin function parameter is a `val` and can not be assigned. The compiler
  ; does assign to a couple of its own -- `node = (this.spliceFunctionBody(...))`
  ; -- which every other target takes without comment. The parameter is given a
  ; suffixed name in the signature and the body opens with a `var` of the
  ; original name copied from it, so the body needs no other change.
  fn paramIsMutated:boolean (arg:RangerAppParamDesc) {
    if (arg.set_cnt > 0) {
      return true
    }
    return false
  }

  fn kotlinWriteMutableParamCopies:void (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    for fnDesc.params arg:RangerAppParamDesc i {
      if (arg.nameNode.hasFlag("keyword")) {
        continue _
      }
      if ((this.paramIsMutated(arg)) == false) {
        continue _
      }
      def nm:string (this.paramEmitName(arg ctx))
      wr.out((("var " + nm) + " : ") false)
      this.writeTypeDef((unwrap arg.nameNode) ctx wr)
      wr.out(((" = " + nm) + "__p") true)
    }
  }
  ; The constructor of a `record` holds a marker parameter for each keyword,
  ; next to the parameter that carries the value. The marker has a name and no
  ; type, so it must not reach the signature: without this filter the
  ; constructor of `record Point { def xpos:int 0 def ypos:int 0 }` comes out
  ; with four parameters, two of them without a type.
  fn writeArgsDef:void (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    def pms (filter (fnDesc.params) {
      if (item.nameNode.hasFlag("keyword")) {
        return false
      }
      return true
    })
    for pms arg:RangerAppParamDesc i {
      if (i > 0) {
        wr.out("," false)
      }
      wr.out(" " false)
      def emitName:string (this.paramEmitName(arg ctx))
      if (this.paramIsMutated(arg)) {
        emitName = (emitName + "__p")
      }
      wr.out((emitName + " : ") false)
      this.writeTypeDef( (unwrap arg.nameNode) ctx wr)
    }
  }
  fn writeFnCall:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasFnCall {
      ctx.setInExpr()
      def fc:CodeNode (node.getFirst())
      this.WriteVRef(fc ctx wr)
      wr.out("(" false)
      def givenArgs:CodeNode (node.getSecond())
      for node.fnDesc.params arg:RangerAppParamDesc i {
        if (i > 0) {
          wr.out(", " false)
        }
        if( (array_length givenArgs.children) <= i) {
          def defVal@(optional):CodeNode (arg.nameNode.getFlag("default"))
          if (!null? defVal) {
            def fc:CodeNode (defVal.vref_annotation.getFirst())
            this.WalkNode(fc ctx wr)
          } {
            ctx.addError(node "Default argument was missing")
          }
          continue 
        }
        def n:CodeNode (itemAt givenArgs.children i)
        this.WalkNode(n ctx wr)
      }
      wr.out(")" false)
      ctx.unsetInExpr()
      if ((ctx.expressionLevel()) == 0) {
        wr.out(";" true)
      }
    }
  }
  fn writeNewCall:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasNewOper {
      def cl:RangerAppClassDesc node.clDesc
      def givenArgs:CodeNode (node.getThird())
      if (this.tryWriteProcessNewCall(node ctx wr)) {
        return
      }
      if (cl.isSingletonClass()) {
        wr.out(" " false)
        wr.out((node.clDesc.name + ".__singleton") false)
        wr.out("(" false)
        for givenArgs.children n:CodeNode i {
          if (i > 0) {
            wr.out(", " false)
          }
          this.WalkNode(n ctx wr)
        }
        wr.out(")" false)
        return
      }

      def fc:CodeNode (node.getSecond())
      wr.out(" " false)
      wr.out(node.clDesc.name false)
      wr.out("(" false)
      def constr:RangerAppFunctionDesc cl.constructor_fn
      if (!null? constr) {
        ; A keyword marker of a record constructor names the field and carries
        ; no value. The signature drops it, so the call drops it as well.
        def written 0
        for constr.params arg:RangerAppParamDesc i {
          if (arg.nameNode.hasFlag("keyword")) {
            continue
          }
          def n:CodeNode (itemAt givenArgs.children i)
          if (written > 0) {
            wr.out(", " false)
          }
          written = written + 1
          this.WalkNode(n ctx wr)
        }
      }
      wr.out(")" false)
    }
  }
  ; The package statement is written once, before the imports. A library whose
  ; types sit in the default package is not one anybody can depend on.
  def kotlin_package_written:boolean false

  fn writeClass:void (node:CodeNode ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def cl:RangerAppClassDesc node.clDesc
    if (null? cl) {
      return
    }
    def declaredFunction:[string:boolean]
    ; A property a subclass redeclares is not a second field on Kotlin -- it is
    ; an ERROR ("hides member of supertype and needs 'override'"), and @JvmField
    ; cannot go on an override at all. RangerAppFunctionDesc redeclares `name`,
    ; `node` and six more from RangerAppParamDesc, all with the same
    ; initializer, and every language writer redeclares `compiler`. One slot,
    ; like every other target.
    def declaredVariable:[string:boolean]
    def wr:CodeWriter orig_wr
    def importFork:CodeWriter (wr.fork())
    if (kotlin_package_written == false) {
      kotlin_package_written = true
      def pkgName:string ""
      if (ctx.hasCompilerSetting("ktpackage")) {
        pkgName = (ctx.getCompilerSetting("ktpackage"))
      } {
        if (ctx.hasCompilerFlag("apipackage")) {
          if (ctx.hasCompilerSetting("name")) {
            pkgName = (ctx.getCompilerSetting("name"))
          }
        }
      }
      if ((strlen pkgName) > 0) {
        ; `package` has to be the FIRST statement of a Kotlin file, ahead of
        ; the imports, so it goes in the tag that precedes them
        def pkgHead:CodeWriter (wr.getTag("before_imports"))
        pkgHead.out(("package " + pkgName) true)
        pkgHead.out("" true)
      }
    }
    this.writeKotlinNativeEnums(ctx wr)
    this.writeKotlinTraitInterfaces(ctx wr)
    this.writeKotlinUnionInterfaces(ctx wr)
    wr.out("" true)
    if cl.has_doc {
      def clDocWr:RangerDocCommentWriter (new RangerDocCommentWriter)
      clDocWr.writeKotlinDocForClass((unwrap cl) ctx wr)
    }
    def ktVis:RangerDocCommentWriter (new RangerDocCommentWriter)
    wr.out((ktVis.classVisibility((unwrap cl) "" "" "internal ")) false)
    if (cl.is_extended_by_children || (cl.name == "RangerProcessBase")) {
      wr.out(("open class " + cl.name) false)
    } {
      wr.out(("class " + cl.name) false)
    }
    if cl.has_constructor {
      def constr:RangerAppFunctionDesc (unwrap cl.constructor_fn)
      wr.out("(" false)
      this.writeArgsDef(constr ctx wr)
      wr.out(" )" false)
    }
    if ((array_length cl.extends_classes) > 0) {
      wr.out(" : " false)
      for cl.extends_classes pName:string i {
        if (i > 0) {
          wr.out(", " false)
        }
        def parentClass:RangerAppClassDesc (ctx.findClass(pName))
        for parentClass.defined_variants fnVar:string j {
          def mVs:RangerAppMethodVariants (get parentClass.method_variants fnVar)
          for mVs.variants variant:RangerAppFunctionDesc k {
            set declaredFunction variant.name true
          }
        }
        for parentClass.variables pv:RangerAppParamDesc j {
          set declaredVariable pv.name true
        }
        wr.out(parentClass.compiledName false)
        if parentClass.has_constructor {
          wr.out("(" false)
          if cl.has_constructor {
            def constr:RangerAppFunctionDesc (unwrap cl.constructor_fn)
            def pConstr:RangerAppFunctionDesc (unwrap parentClass.constructor_fn)
            for pConstr.params pArg:RangerAppParamDesc j {
              if (j > 0) {
                wr.out(", " false)
              }
              def foundByName:boolean false
              for constr.params cArgByName:RangerAppParamDesc k {
                if (cArgByName.name == pArg.name) {
                  wr.out(cArgByName.compiledName false)
                  foundByName = true
                  break
                }
              }
              if (false == foundByName) {
                if (j < (array_length constr.params)) {
                  def cArg:RangerAppParamDesc (itemAt constr.params j)
                  wr.out(cArg.compiledName false)
                }
              }
            }
          }
          wr.out(")" false)
        } {
          ; Kotlin requires explicit super constructor invocation: class Child : Parent()
          wr.out("()" false)
        }
      }
    }
    ; the unions this class belongs to are its interfaces — nothing has to be
    ; wrapped at a call site for a value to become a union member
    def clUnions:[string] (this.unionInterfacesOf((unwrap cl) ctx))
    def ktSupers:int (array_length cl.extends_classes)
    if ((array_length clUnions) > 0) {
      if (ktSupers > 0) {
        wr.out(", " false)
      } {
        wr.out(" : " false)
      }
      for clUnions uname:string ui {
        if (ui > 0) {
          wr.out(", " false)
        }
        wr.out(uname false)
        ktSupers = ktSupers + 1
      }
    }
    ; …and so are the behaviour-only traits it `does` that something names as
    ; a type. Registering their method names in declaredFunction is what makes
    ; the copied bodies come out as `override`, which Kotlin requires.
    def ktIfaces:[string] (ktTraits.basesOf((unwrap cl) ctx))
    for ktIfaces ifName:string ifi {
      if (ktSupers > 0) {
        wr.out(", " false)
      } {
        wr.out(" : " false)
      }
      wr.out(ifName false)
      ktSupers = ktSupers + 1
      def ifC:RangerAppClassDesc (ctx.findClass(ifName))
      for ifC.defined_variants ifVar:string ifj {
        def ifVs:RangerAppMethodVariants (get ifC.method_variants ifVar)
        for ifVs.variants ifVariant:RangerAppFunctionDesc ifk {
          set declaredFunction ifVariant.name true
        }
      }
    }
    wr.out(" " true)
    wr.out(" {" true)
    wr.indent(1)
    def has_static_vars false
    for cl.variables pvar:RangerAppParamDesc i {
      if pvar.is_static {
        has_static_vars = true
      }
    }
    ; `sfn m@(main)` is lifted to a top-level `fun main()` and skipped in the
    ; companion, so a class whose only static IS main wanted a companion and
    ; then had nothing to put in it — `companion object { }`, empty, in every
    ; program with an entry point.
    def companion_statics:int 0
    for cl.static_methods cmVariant:RangerAppFunctionDesc cmi {
      def cmNN@(optional):CodeNode cmVariant.nameNode
      if (!null? cmNN) {
        def cmN:CodeNode (unwrap cmNN)
        if (cmN.hasFlag("main")) {
          continue _
        }
      }
      companion_statics = (companion_statics + 1)
    }
    def wants_companion false
    if ((companion_statics > 0) || has_static_vars) {
      wants_companion = true
    }
    if (cl.isSingletonClass()) {
      wants_companion = true
    }
    for cl.variables pvar:RangerAppParamDesc i {
      if pvar.is_static {
        continue _
      }
      if (has declaredVariable pvar.name) {
        continue _
      }
      if pvar.has_doc {
        def fDocWr:RangerDocCommentWriter (new RangerDocCommentWriter)
        fDocWr.writeKotlinDocForField(pvar wr)
      }
      def fVis:RangerDocCommentWriter (new RangerDocCommentWriter)
      wr.out((fVis.memberVisibility((unwrap cl) pvar "" "" "internal ")) false)
      this.writeVarDef((unwrap pvar.node) ctx wr)
    }
    if cl.has_constructor {
      def constr:RangerAppFunctionDesc cl.constructor_fn
      wr.out("" true)
      wr.out("init {" true)
      wr.indent(1)
      wr.newline()
      def subCtx:RangerAppWriterContext (unwrap constr.fnCtx)
      subCtx.is_function = true
      this.kotlinWriteMutableParamCopies((unwrap constr) subCtx wr)
      this.WalkNode( (unwrap constr.fnBody) subCtx wr)
      wr.newline()
      wr.indent(-1)
      wr.out("}" true)
    }
    if wants_companion {
      wr.out("companion object {" true)
      wr.indent(1)
    }
    for cl.variables pvar:RangerAppParamDesc i {
      if (false == pvar.is_static) {
        continue _
      }
      this.writeVarDef((unwrap pvar.node) ctx wr)
    }
    if (cl.isSingletonClass()) {
      wr.out(("private var __singleton_instance : " + cl.compiledName + "? = null") true)
      wr.out("fun __singleton(" false)
      if cl.has_constructor {
        def constr:RangerAppFunctionDesc (unwrap cl.constructor_fn)
        this.writeArgsDef(constr ctx wr)
      }
      wr.out((") : " + cl.compiledName + " {") true)
      wr.indent(1)
      wr.out("if (__singleton_instance == null) {" true)
      wr.indent(1)
      wr.out(("__singleton_instance = " + cl.compiledName + "(") false)
      if cl.has_constructor {
        def constr:RangerAppFunctionDesc (unwrap cl.constructor_fn)
        for constr.params arg:RangerAppParamDesc i {
          if (i > 0) {
            wr.out(", " false)
          }
          wr.out(arg.compiledName false)
        }
      }
      wr.out(")" true)
      wr.indent(-1)
      wr.out("}" true)
      wr.out("return __singleton_instance!!" true)
      wr.indent(-1)
      wr.out("}" true)
    }
    for cl.static_methods variant:RangerAppFunctionDesc i {
      if variant.is_doc_example {
        if ((ctx.hasCompilerFlag("keep-examples")) == false) {
          continue _
        }
      }
      wr.out("" true)
      if (variant.nameNode.hasFlag("main")) {
        continue _
      }
      if (variant.nameNode.hasFlag("open")) {
        wr.out("open " false)
      }
      def sIsOverride:boolean (variant.nameNode.hasFlag("override"))
      if variant.has_doc {
        def sDocWr:RangerDocCommentWriter (new RangerDocCommentWriter)
        sDocWr.writeKotlinDocForMethod((unwrap cl) variant ctx wr)
      }
      if sIsOverride {
        wr.out("override " false)
      } {
        ; an override may not change the visibility it inherits, so only a
        ; declaration that is not one takes a modifier from its doc block
        def sVis:RangerDocCommentWriter (new RangerDocCommentWriter)
        wr.out((sVis.memberVisibility((unwrap cl) variant "" "" "internal ")) false)
      }
      wr.out("fun " false)
      wr.out(" " false)
      wr.out((variant.compiledName + "(") false)
      this.writeArgsDef(variant ctx wr)
      wr.out(") : " false)
      this.writeTypeDef( (unwrap variant.nameNode ) ctx wr)
      wr.out(" {" true)
      wr.indent(1)
      wr.newline()
      def subCtx:RangerAppWriterContext (unwrap variant.fnCtx)
      subCtx.is_function = true
      subCtx.in_method = true
      subCtx.in_static_method = false
      subCtx.currentMethod = variant
      subCtx.setCurrentClass( (unwrap cl) )
      this.kotlinWriteMutableParamCopies(variant subCtx wr)
      this.WalkNode( (unwrap variant.fnBody ) subCtx wr)
      wr.newline()
      wr.indent(-1)
      wr.out("}" true)
    }
    if wants_companion {
      wr.indent(-1)
      wr.out("}" true)
    }
    for cl.defined_variants fnVar:string i {
      def mVs:RangerAppMethodVariants (get cl.method_variants fnVar)
      for mVs.variants variant:RangerAppFunctionDesc i {
        if variant.is_doc_example {
          if ((ctx.hasCompilerFlag("keep-examples")) == false) {
            continue _
          }
        }
        wr.out("" true)
        def shouldOverride:boolean false
        if (variant.nameNode.hasFlag("override")) {
          shouldOverride = true
        }
        if (has declaredFunction variant.name) {
          shouldOverride = true
        }
        ; toString() and hashCode() DO override the ones every Kotlin class
        ; inherits -- but only in their no-argument form, and `equals` never
        ; does: Any.equals takes Any?, so `equals(other:EvalValue)` is an
        ; overload, and marking it `override` made the file refuse to compile
        ; with "'equals' overrides nothing".
        if ((variant.compiledName == "toString") || (variant.compiledName == "hashCode")) {
          if ((array_length variant.params) == 0) {
            shouldOverride = true
          }
        }
        if variant.has_doc {
          def mDocWr:RangerDocCommentWriter (new RangerDocCommentWriter)
          mDocWr.writeKotlinDocForMethod((unwrap cl) variant ctx wr)
        }
        if shouldOverride {
          wr.out("override " false)
        } {
          def mVis:RangerDocCommentWriter (new RangerDocCommentWriter)
          wr.out((mVis.memberVisibility((unwrap cl) variant "" "" "internal ")) false)
          if cl.is_extended_by_children {
            wr.out("open " false)
          }
        }
        wr.out("fun " false)
        wr.out(" " false)
        wr.out((variant.compiledName + "(") false)
        this.writeArgsDef(variant ctx wr)
        wr.out(") : " false)
        this.writeTypeDef( (unwrap variant.nameNode ) ctx wr)
        wr.out(" {" true)
        wr.indent(1)
        wr.newline()
        def subCtx:RangerAppWriterContext (unwrap variant.fnCtx)
        subCtx.is_function = true
        subCtx.in_method = true
        subCtx.in_static_method = false
        subCtx.currentMethod = variant
        subCtx.setCurrentClass( (unwrap cl) )
        this.kotlinWriteMutableParamCopies(variant subCtx wr)
        this.WalkNode( (unwrap variant.fnBody ) subCtx wr)
        wr.newline()
        wr.indent(-1)
        wr.out("}" true)
      }
    }
    wr.indent(-1)
    wr.out("}" true)
    for cl.static_methods variant:RangerAppFunctionDesc i {
      wr.out("" true)
      if ( (variant.nameNode.hasFlag("main")) && (variant.nameNode.code.filename == (ctx.getRootFile()))) {
        ; Only main() can see the array Kotlin hands it. The shell_arg
        ; operators read __g_args, so main copies it there first -- the same
        ; shape as __g_argv on C++ and __g_args on Dart. Declared here rather
        ; than in the operator template: main is written once, and a program
        ; that never reads an argument would otherwise assign to a name that
        ; was never declared.
        wr.out("var __g_args : Array<String> = arrayOf()" true)
        wr.out("" true)
        wr.out("fun main(args : Array<String>) {" true)
        wr.indent(1)
        wr.out("__g_args = args" true)
        wr.newline()
        def subCtx:RangerAppWriterContext (unwrap variant.fnCtx )
        subCtx.is_function = true
        subCtx.in_method = false
        subCtx.in_static_method = true
        subCtx.currentMethod = variant
        this.kotlinWriteMutableParamCopies(variant subCtx wr)
        this.WalkNode( (unwrap variant.fnBody ) subCtx wr)
        wr.newline()
        wr.indent(-1)
        wr.out("}" true)
      }
    }
  }

  ; --- the generated `for` (PLAN_CPP_IDIOMS C4, the Kotlin half) --------------
  ; `for (i in xs.indices) { val v = xs[i]; ... }` is a loop a Kotlin
  ; programmer writes only when they want the index. When the body neither
  ; reads it nor touches the collection it is `for (v in xs)` -- and the two
  ; conditions are the ones every target asks (ForLoopShape): the iterator form
  ; takes one iterator for the whole loop, so a body that adds to the list gets
  ; a ConcurrentModificationException where the index form saw the growth.
  fn ktWriteOperand:void (arg:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ctx.setInExpr()
    this.WalkNode(arg ctx wr)
    ctx.unsetInExpr()
  }

  fn ktWriteForLoop:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if ((array_length node.children) < 5) {
      return
    }
    def coll:CodeNode (node.getSecond())
    def item:CodeNode (itemAt node.children 2)
    def idx:CodeNode (itemAt node.children 3)
    def body:CodeNode (itemAt node.children 4)

    if (ktLoops.canIterate(node)) {
      wr.out("for ( " false)
      this.ktWriteOperand(item ctx wr)
      wr.out(" in " false)
      this.ktWriteOperand(coll ctx wr)
      wr.out(" ) {" true)
      wr.indent(1)
      def rCtx:RangerAppWriterContext (ctx.fork())
      rCtx.restartExpressionLevel()
      this.WalkNode(body rCtx wr)
      wr.indent(-1)
      wr.out("}" true)
      return
    }

    ; the index form, what the template wrote before
    wr.out("for ( " false)
    this.ktWriteOperand(idx ctx wr)
    wr.out(" in " false)
    this.ktWriteOperand(coll ctx wr)
    wr.out(".indices ) {" true)
    wr.indent(1)
    wr.out("val " false)
    this.ktWriteOperand(item ctx wr)
    wr.out(" = " false)
    this.ktWriteOperand(coll ctx wr)
    wr.out("[" false)
    this.ktWriteOperand(idx ctx wr)
    wr.out("]" true)
    def sCtx:RangerAppWriterContext (ctx.fork())
    sCtx.restartExpressionLevel()
    this.WalkNode(body sCtx wr)
    wr.indent(-1)
    wr.out("}" true)
  }

  ; Nothing else routes a template through this writer, so the only command
  ; that arrives is the one Lang.rgr declares `(custom _)` for it.
  ; `when` over an enum subject has to be exhaustive, and a Ranger `switch`
  ; need not have a `default`; `else` also has to come last, while a Ranger
  ; `default` may sit anywhere in the case list. The template form could do
  ; neither, so the whole statement is written here: the cases in source
  ; order, then the default -- or an empty `else` when there is none.
  fn ktWriteSwitch:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def condition:CodeNode (node.getSecond())
    def case_nodes:CodeNode (node.getThird())
    wr.newline()
    wr.out("when (" false)
    this.WalkNode(condition ctx wr)
    wr.out(") {" true)
    wr.indent(1)
    def defaultBlock@(optional):CodeNode
    for case_nodes.children ch:CodeNode i {
      def blockName:CodeNode (ch.getFirst())
      if (blockName.vref == "default") {
        defaultBlock = (ch.getSecond())
      } {
        def caseValue:CodeNode (ch.getSecond())
        def caseBlock:CodeNode (ch.getThird())
        this.WalkNode(caseValue ctx wr)
        wr.out(" -> {" true)
        wr.indent(1)
        this.WalkNode(caseBlock ctx wr)
        wr.indent(-1)
        wr.out("}" true)
      }
    }
    wr.out("else -> {" true)
    wr.indent(1)
    if (!null? defaultBlock) {
      this.WalkNode((unwrap defaultBlock) ctx wr)
    }
    wr.indent(-1)
    wr.out("}" true)
    wr.indent(-1)
    wr.out("}" true)
  }

  fn CustomOperator:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def fc:CodeNode (node.getFirst())
    def cmd:string fc.vref
    if (cmd == "for") {
      this.ktWriteForLoop(node ctx wr)
    }
    if (cmd == "switch") {
      this.ktWriteSwitch(node ctx wr)
    }
  }

}

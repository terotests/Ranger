; Provides ANSI colors, Unicode symbols, and formatted output for the compiler
; CLI experience. Falls back to plain text on non-TTY terminals.

operators {
    ; ANSI escape code operators - return empty string for non-ES6 targets
    ansi_reset      cmdAnsiReset:string () {
        templates {
            llvm ( "(ansi_reset)" )
            es6 ( "\"\\x1b[0m\"" )
            cpp ( "std::string(\"\\x1b[0m\")" )
            rust ( "\"\\x1b[0m\".to_string()" )
            * ( "\"\"" )
        }
    }
    ansi_bold       cmdAnsiBold:string () {
        templates {
            llvm ( "(ansi_bold)" )
            es6 ( "\"\\x1b[1m\"" )
            cpp ( "std::string(\"\\x1b[1m\")" )
            rust ( "\"\\x1b[1m\".to_string()" )
            * ( "\"\"" )
        }
    }
    ansi_dim        cmdAnsiDim:string () {
        templates {
            llvm ( "(ansi_dim)" )
            es6 ( "\"\\x1b[2m\"" )
            cpp ( "std::string(\"\\x1b[2m\")" )
            rust ( "\"\\x1b[2m\".to_string()" )
            * ( "\"\"" )
        }
    }
    ansi_green      cmdAnsiGreen:string () {
        templates {
            llvm ( "(ansi_green)" )
            es6 ( "\"\\x1b[32m\"" )
            cpp ( "std::string(\"\\x1b[32m\")" )
            rust ( "\"\\x1b[32m\".to_string()" )
            * ( "\"\"" )
        }
    }
    ansi_red        cmdAnsiRed:string () {
        templates {
            llvm ( "(ansi_red)" )
            es6 ( "\"\\x1b[31m\"" )
            cpp ( "std::string(\"\\x1b[31m\")" )
            rust ( "\"\\x1b[31m\".to_string()" )
            * ( "\"\"" )
        }
    }
    ansi_yellow     cmdAnsiYellow:string () {
        templates {
            llvm ( "(ansi_yellow)" )
            es6 ( "\"\\x1b[33m\"" )
            cpp ( "std::string(\"\\x1b[33m\")" )
            rust ( "\"\\x1b[33m\".to_string()" )
            * ( "\"\"" )
        }
    }
    ansi_blue       cmdAnsiBlue:string () {
        templates {
            llvm ( "(ansi_blue)" )
            es6 ( "\"\\x1b[34m\"" )
            cpp ( "std::string(\"\\x1b[34m\")" )
            rust ( "\"\\x1b[34m\".to_string()" )
            * ( "\"\"" )
        }
    }
    ansi_magenta    cmdAnsiMagenta:string () {
        templates {
            llvm ( "(ansi_magenta)" )
            es6 ( "\"\\x1b[35m\"" )
            cpp ( "std::string(\"\\x1b[35m\")" )
            rust ( "\"\\x1b[35m\".to_string()" )
            * ( "\"\"" )
        }
    }
    ansi_cyan       cmdAnsiCyan:string () {
        templates {
            llvm ( "(ansi_cyan)" )
            es6 ( "\"\\x1b[36m\"" )
            cpp ( "std::string(\"\\x1b[36m\")" )
            rust ( "\"\\x1b[36m\".to_string()" )
            * ( "\"\"" )
        }
    }
    ansi_gray       cmdAnsiGray:string () {
        templates {
            llvm ( "(ansi_gray)" )
            es6 ( "\"\\x1b[90m\"" )
            cpp ( "std::string(\"\\x1b[90m\")" )
            rust ( "\"\\x1b[90m\".to_string()" )
            * ( "\"\"" )
        }
    }
    ansi_white      cmdAnsiWhite:string () {
        templates {
            llvm ( "(ansi_white)" )
            es6 ( "\"\\x1b[37m\"" )
            cpp ( "std::string(\"\\x1b[37m\")" )
            rust ( "\"\\x1b[37m\".to_string()" )
            * ( "\"\"" )
        }
    }
    
    ; Background colors
    ansi_bg_red     cmdAnsiBgRed:string () {
        templates {
            llvm ( "(ansi_bg_red)" )
            es6 ( "\"\\x1b[41m\"" )
            cpp ( "std::string(\"\\x1b[41m\")" )
            rust ( "\"\\x1b[41m\".to_string()" )
            * ( "\"\"" )
        }
    }
    ansi_bg_green   cmdAnsiBgGreen:string () {
        templates {
            llvm ( "(ansi_bg_green)" )
            es6 ( "\"\\x1b[42m\"" )
            cpp ( "std::string(\"\\x1b[42m\")" )
            rust ( "\"\\x1b[42m\".to_string()" )
            * ( "\"\"" )
        }
    }
    
    ; Check if running in TTY (terminal)
    is_tty          cmdIsTTY:boolean () {
        templates {
            llvm ( "(is_tty)" )
            es6 ( "((typeof process !== \"undefined\" && process.stdout && process.stdout.isTTY) || false)" )
            cpp ( "(isatty(1) != 0)" (imp "<unistd.h>") )
            ; the `*` fallback is the JavaScript literal `false`, which Python
            ; reads as a name
            python ( "sys.stdout.isatty()" (imp "sys") )
            dart ( "stdout.hasTerminal" (imp "dart:io") )
            kotlin ( "System.console() != null" )
            * ( "false" )
        }
    }
    
    ; Get current timestamp in milliseconds
    current_time_ms cmdCurrentTimeMs:double () {
        templates {
            es6 ( "Date.now()" )
            go ( "float64(time.Now().UnixMilli())" (imp "time") )
            cpp ( "((double)std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch()).count())" (imp "<chrono>") )
            csharp ( "(System.DateTime.UtcNow - new System.DateTime(1970, 1, 1, 0, 0, 0, System.DateTimeKind.Utc)).TotalMilliseconds" )
            kotlin ( "System.currentTimeMillis().toDouble()" )
            dart ( "DateTime.now().millisecondsSinceEpoch.toDouble()" )
            python ( "(time.time() * 1000.0)" (imp "time") )
            * ( "0.0" )
        }
    }
}

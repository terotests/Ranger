; SPDX-License-Identifier: MIT

; Tree literals. `DesugarTrees` lowers `tree { }` into the factory calls a target
; writes, and reports the ones left standing where no factory matched.

extension RangerFlowParser {

  fn DesugarTrees:void (node@(lives):CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    this.collectTreeFactories(node true ctx)
    if ((array_length (keys treeFactoryNames)) > 0) {
      this.expandTreesIn(node ctx wr)
      ; A literal lowers to statements, so it can only live where a statement
      ; can go. Anything still standing after the walk is somewhere there was no
      ; block to hoist into, and says so rather than failing later as a type
      ; error on a name nobody wrote.
      ;
      ; This does NOT catch a class FIELD initializer: by the time this pass
      ; runs, a class member's value is no longer reachable from the AST the
      ; walk can see, and such a literal fails as "Unknown type: type ID : 11"
      ; instead. Build the tree in the constructor, which is where a retained
      ; tree belongs anyway.
      this.reportStrayTrees(node ctx)
    }
  }

  fn reportStrayTrees:void (node:CodeNode ctx:RangerAppWriterContext) {
    if (this.isTreeLiteral(node)) {
      ctx.addError(node "a tree literal has to be inside a function body: it builds a tree with statements, and a class field initializer has nowhere to put them")
      return
    }
    for node.children ch:CodeNode i {
      this.reportStrayTrees(ch ctx)
    }
  }

  fn isTreeFactoryDeclaration:boolean (node:CodeNode) {
    if ((array_length node.children) != 3) {
      return false
    }
    def head:CodeNode (node.getFirst())
    if (head.vref != "treefactory") {
      return false
    }
    if ((array_length head.ns) > 1) {
      return false
    }
    def nameNode:CodeNode (node.getSecond())
    if ((strlen nameNode.vref) == 0) {
      return false
    }
    if nameNode.expression {
      return false
    }
    def bodyNode:CodeNode (node.getThird())
    return bodyNode.is_block_node
  }

  fn collectTreeFactories:void (node@(lives):CodeNode atTopLevel:boolean ctx:RangerAppWriterContext) {
    def childScope:boolean atTopLevel
    if (node.isFirstVref("class")) {
      childScope = false
    }
    if (node.isFirstVref("record")) {
      childScope = false
    }
    if (node.isFirstVref("fn")) {
      childScope = false
    }
    if (node.isFirstVref("sfn")) {
      childScope = false
    }
    def kept:[CodeNode]
    def removed:boolean false
    for node.children ch@(lives):CodeNode i {
      if (this.isTreeFactoryDeclaration(ch)) {
        if atTopLevel {
          this.registerTreeFactory(ch ctx)
        } {
          ctx.addError(ch "treefactory has to be declared at the top level of a file")
        }
        removed = true
      } {
        push kept ch
        this.collectTreeFactories(ch childScope ctx)
      }
    }
    if removed {
      clear node.children
      for kept k@(lives):CodeNode j {
        node.add(k)
      }
    }
  }

  fn registerTreeFactory:void (node:CodeNode ctx:RangerAppWriterContext) {
    def nameNode:CodeNode (node.getSecond())
    def fname:string nameNode.vref
    if (has treeFactoryNames fname) {
      ctx.addError(node ("treefactory " + fname + " is declared twice"))
      return
    }
    set treeFactoryNames fname true
    set treeChildCall fname ""
    set treeTextField fname ""

    def body:CodeNode (node.getThird())
    for body.children st@(lives):CodeNode i {
      if ((array_length st.children) == 0) {
        ctx.addError(st "expected child, text or tag")
      } {
        def head:CodeNode (st.getFirst())
        def kw:string head.vref
        if (kw == "child") {
          if ((array_length st.children) == 2) {
            set treeChildCall fname ((st.getSecond()).vref)
          } {
            ctx.addError(st "child takes one method name")
          }
        } {
          if (kw == "text") {
            if ((array_length st.children) == 2) {
              set treeTextField fname ((st.getSecond()).vref)
            } {
              ctx.addError(st "text takes one field name")
            }
          } {
            if (kw == "tag") {
              def argc:int (array_length st.children)
              if ((argc == 3) || (argc == 4)) {
                def tagName:string ((st.getSecond()).vref)
                def clsName:string ((st.getThird()).vref)
                def tagKey:string ((fname + " ") + tagName)
                set treeTags tagKey clsName
                if (argc == 4) {
                  def defs:CodeNode (at st.children 3)
                  if (this.isTreeKeyword(defs "props")) {
                    set treeTagDefaults tagKey defs
                  } {
                    ctx.addError(defs "a tag's defaults are a props form")
                  }
                }
              } {
                ctx.addError(st "tag takes a tag name, a class name and optionally a props form")
              }
            } {
              ctx.addError(st (("unknown treefactory member " + kw) + ", expected child, text or tag"))
            }
          }
        }
      }
    }
  }

  fn isTreeLiteral:boolean (node:CodeNode) {
    if ((array_length node.children) != 3) {
      return false
    }
    def head:CodeNode (node.getFirst())
    if (head.vref != "tree") {
      return false
    }
    if ((array_length head.ns) > 1) {
      return false
    }
    def nameNode:CodeNode (node.getSecond())
    if ((strlen nameNode.vref) == 0) {
      return false
    }
    return (nameNode.expression == false)
  }

  fn expandTreesIn:void (node@(lives):CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def memberScope:boolean false
    if (node.isFirstVref("class")) {
      memberScope = true
    }
    if (node.isFirstVref("record")) {
      memberScope = true
    }
    if (node.isFirstVref("systemclass")) {
      memberScope = true
    }
    if memberScope {
      for node.children ch@(lives):CodeNode i {
        if ch.is_block_node {
          ; the members themselves — a method body inside one is an ordinary
          ; block and is found by the recursion
          for ch.children m@(lives):CodeNode j {
            this.expandTreesIn(m ctx wr)
          }
        } {
          this.expandTreesIn(ch ctx wr)
        }
      }
      return
    }
    if node.is_block_node {
      this.expandTreesInBlock(node ctx wr)
      return
    }
    for node.children ch@(lives):CodeNode i {
      this.expandTreesIn(ch ctx wr)
    }
  }

  fn expandTreesInBlock:void (block@(lives):CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def out:[CodeNode]
    for block.children stmt@(lives):CodeNode i {
      def prelude:[CodeNode]
      this.lowerTreesIn(stmt prelude ctx wr)
      for prelude p@(lives):CodeNode j {
        push out p
      }
      push out stmt
    }
    clear block.children
    for out n@(lives):CodeNode k {
      ; add(), not a bare push: a node the walker meets without a parent link
      ; takes the compiler down when it tries to attach a scope to it.
      block.add(n)
    }
  }

  fn lowerTreesIn:void (node@(lives):CodeNode prelude:[CodeNode] ctx:RangerAppWriterContext wr:CodeWriter) {
    ; A nested block is its own scope: hoisting out of an `if` body into the
    ; statement above it would build the tree whether the branch ran or not.
    if node.is_block_node {
      this.expandTreesInBlock(node ctx wr)
      return
    }
    if (this.isTreeLiteral(node)) {
      def fname:string ((node.getSecond()).vref)
      if ((has treeFactoryNames fname) == false) {
        ctx.addError(node ("no treefactory named " + fname))
        return
      }
      def reg:string (this.lowerTreeElement((node.getThird()) fname prelude ctx wr))
      if ((strlen reg) > 0) {
        this.rewriteAsVRef(node reg)
      }
      return
    }
    for node.children ch@(lives):CodeNode i {
      this.lowerTreesIn(ch prelude ctx wr)
    }
  }

  fn rewriteAsVRef:void (node@(lives):CodeNode name:string) {
    clear node.children
    node.expression = false
    node.vref = name
    node.value_type = RangerNodeType.VRef
    node.parsed_type = RangerNodeType.VRef
    clear node.ns
    push node.ns name
  }

  fn lowerTreeElement:string (el:CodeNode fname:string prelude:[CodeNode] ctx:RangerAppWriterContext wr:CodeWriter) {
    if ((array_length el.children) == 0) {
      ctx.addError(el "expected a tag")
      return ""
    }
    def head:CodeNode (el.getFirst())
    def tagName:string head.vref
    def key:string ((fname + " ") + tagName)
    if ((has treeTags key) == false) {
      ctx.addError(el ((("treefactory " + fname) + " has no tag ") + tagName))
      return ""
    }
    def clsName:string (unwrap (get treeTags key))

    treeTmpCount = (treeTmpCount + 1)
    def reg:string ("_tree" + (to_string treeTmpCount))

    ; def <reg> (new <Class>) — untyped on purpose: Ranger already infers the
    ; type from `new`, and an annotation here would be a second place for the
    ; tag mapping to be wrong.
    def defNode:CodeNode (el.newExpressionNode())
    defNode.add((el.newVRefNode("def")))
    defNode.add((el.newVRefNode(reg)))
    def newNode:CodeNode (el.newExpressionNode())
    newNode.add((el.newVRefNode("new")))
    newNode.add((el.newVRefNode(clsName)))
    defNode.add(newNode)
    push prelude defNode

    ; The tag's own defaults first, so a use site can still override one.
    if (has treeTagDefaults key) {
      this.lowerTreeProps((unwrap (get treeTagDefaults key)) reg prelude ctx wr)
    }

    def idx:int 1
    while (idx < (array_length el.children)) {
      def ch:CodeNode (at el.children idx)
      if (this.isTreeKeyword(ch "props")) {
        this.lowerTreeProps(ch reg prelude ctx wr)
      } {
        if (this.isTreeKeyword(ch "child")) {
          ; An explicit computed child: `(child (UserBadge user))`. A component
          ; is an ordinary function that returns a node, and this is how one is
          ; spliced in — marked, because `(UserBadge user)` and a mistyped tag
          ; are the same shape, and guessing between them would turn a typo
          ; into a call to something that does not exist.
          this.lowerComputedChildren(ch reg fname prelude ctx wr)
        } {
          this.lowerTreeChild(ch reg fname prelude ctx wr)
        }
      }
      idx = (idx + 1)
    }
    return reg
  }

  fn isTreeKeyword:boolean (node:CodeNode word:string) {
    if ((array_length node.children) == 0) {
      return false
    }
    def head:CodeNode (node.getFirst())
    if ((array_length head.ns) > 1) {
      return false
    }
    return (head.vref == word)
  }

  fn lowerComputedChildren:void (ch:CodeNode reg:string fname:string prelude:[CodeNode] ctx:RangerAppWriterContext wr:CodeWriter) {
    def childCall:string (unwrap (get treeChildCall fname))
    if ((strlen childCall) == 0) {
      ctx.addError(ch (("treefactory " + fname) + " has no `child` method"))
      return
    }
    if ((array_length ch.children) < 2) {
      ctx.addError(ch "child takes one or more expressions")
      return
    }
    def idx:int 1
    while (idx < (array_length ch.children)) {
      push prelude (this.treeCall(ch reg childCall (at ch.children idx)))
      idx = (idx + 1)
    }
  }

  fn treeCall:CodeNode (at_node:CodeNode reg:string method:string arg:CodeNode) {
    def call:CodeNode (at_node.newExpressionNode())
    call.add((at_node.newVRefNode((reg + ".") + method)))
    def args:CodeNode (at_node.newExpressionNode())
    args.add((arg.copy()))
    call.add(args)
    return call
  }

  fn lowerTreeProps:void (propsNode:CodeNode reg:string prelude:[CodeNode] ctx:RangerAppWriterContext wr:CodeWriter) {
    def idx:int 1
    while (idx < (array_length propsNode.children)) {
      def pair:CodeNode (at propsNode.children idx)
      if ((array_length pair.children) != 2) {
        ctx.addError(pair "a property is a name and a value")
      } {
        def pName:string ((pair.getFirst()).vref)
        push prelude (this.treeAssign(pair reg pName (pair.getSecond())))
      }
      idx = (idx + 1)
    }
  }

  fn treeAssign:CodeNode (at_node:CodeNode reg:string field:string value:CodeNode) {
    def assign:CodeNode (at_node.newExpressionNode())
    assign.add((at_node.newVRefNode("=")))
    assign.add((at_node.newVRefNode((reg + ".") + field)))
    assign.add((value.copy()))
    return assign
  }

  fn lowerTreeChild:void (ch:CodeNode reg:string fname:string prelude:[CodeNode] ctx:RangerAppWriterContext wr:CodeWriter) {
    ; Another element of this factory, or a value.
    def isElement:boolean false
    if ((array_length ch.children) > 0) {
      def head:CodeNode (ch.getFirst())
      if ((array_length head.ns) == 1) {
        if (has treeTags ((fname + " ") + head.vref)) {
          isElement = true
        }
      }
    }
    if isElement {
      def childCall:string (unwrap (get treeChildCall fname))
      if ((strlen childCall) == 0) {
        ctx.addError(ch (("treefactory " + fname) + " has no `child` method, so it cannot nest"))
        return
      }
      def childReg:string (this.lowerTreeElement(ch fname prelude ctx wr))
      if ((strlen childReg) == 0) {
        return
      }
      push prelude (this.treeCall(ch reg childCall (ch.newVRefNode(childReg))))
      return
    }
    if (ch.expression) {
      if ((array_length ch.children) == 0) {
        ctx.addError(ch "empty child: props are optional, so `()` is never needed")
        return
      }
      def h:CodeNode (ch.getFirst())
      if ((array_length h.ns) == 1) {
        ctx.addError(ch ((((h.vref + " is not a tag of treefactory ") + fname) + " — declare it with `tag`, or wrap a computed child in `(child ")) + h.vref + " …)"))
        return
      }
    }
    ; A value child: the text field takes it.
    def textField:string (unwrap (get treeTextField fname))
    if ((strlen textField) == 0) {
      ctx.addError(ch (("treefactory " + fname) + " has no `text` field, so a value cannot be a child here"))
      return
    }
    push prelude (this.treeAssign(ch reg textField ch))
  }

}

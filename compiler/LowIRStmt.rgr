      def cellPtr (this.loadSlotRaw(varName lctx.ptrType lctx))
      def logT:string (this.boxedCellType(varName lctx))
      def wrote:string (this.widenForBoxCell(tmp logT lctx))
      ; A REFERENCE written into the cell is now held by the cell, so it has to
      ; be claimed out of the statement arena -- otherwise the arena frees it at
      ; the end of this very statement and the cell is left pointing at memory
      ; that has been handed back. `s = (s + x)` inside a lambda read as garbage
      ; because of exactly this. The value it replaces is not released: this
      ; backend leaks a replaced capture rather than risk freeing one that the
      ; enclosing scope still names.

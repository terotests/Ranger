; -------- developer documentation part comes over here --------------


operator type:void all {
  fn r.func:RangerAppFunctionDesc ( node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter ) {
    def parser (new RangerFlowParser)
    return (parser.CreateFunctionObject(node ctx wr))
  }
}

class ClassJoinPoint {
  def class_def:RangerAppClassDesc
  def node@(weak):CodeNode
}

class WalkLater {
  def arg@(weak):CodeNode
  def callArg@(weak):CodeNode
}

; The four parts EnterFn used to hand to a callback. A callback that calls
; back into the parser cannot be borrow-checked on Rust — the receiver is
; already borrowed by the call taking the callback — so the parts are
; returned instead.
class RangerFnParts {
  def ok:boolean false
  def nameNode:CodeNode
  def fnArgs:CodeNode
  def fnBody:CodeNode
  def desc:RangerAppClassDesc
}

class RangerFlowParser {

  def hasRootPath false
  def rootPath:string ""
  def _debug false
  ; def is_chaining false
  ; def chainRoot:CodeNode

  ; SHAPES (PLAN_SHAPES.md). What each shape declared, recorded while it is
  ; lowered and read back when a `match` over it is checked for exhaustiveness.
  ; Keys are the generated class names (`Value_Num`); the alias maps also carry
  ; the unqualified spelling (`Num`) when it names exactly one case in the
  ; program, and "" when more than one shape claims it.
  ; TREE LITERALS. `treefactory Name { … }` declares what a tag means and how a
  ; child is attached; `(tree Name (Tag …))` builds one. Both are lowered to
  ; ordinary Ranger — a `new`, some field assignments and some method calls —
  ; before anything else looks at the program, so no target writer knows this
  ; feature exists and the existing type checker does all the checking.
  ;
  ; There is deliberately no node type, no runtime, no element class and no
  ; knowledge of EVG here. A factory whose tags map to SQL nodes or AST nodes
  ; lowers exactly the same way.
  def treeChildCall:[string:string]
  def treeTextField:[string:string]
  ; "<factory> <Tag>" -> the class the tag builds.
  def treeTags:[string:string]
  ; "<factory> <Tag>" -> a props form every use of that tag starts with, so a
  ; tag can mean "an EVGElement that is a text leaf" rather than making every
  ; call site repeat it.
  def treeTagDefaults:[string:CodeNode]
  ; Every factory that was declared, so an unknown one can say so.
  def treeFactoryNames:[string:boolean]
  def treeTmpCount:int 0

  def shapeCases:[string:[string]]
  def shapeGroupCases:[string:[string]]
  def caseAlias:[string:string]
  def groupAlias:[string:string]
  def caseShape:[string:string]
  def caseDisplay:[string:string]
  ; S4: does this case compare by content (value) or by identity (reference),
  ; and which fields its generated equality reads
  def caseIsValue:[string:boolean]
  def caseFieldNames:[string:[string]]
  ; C1: nominal shape / group / case views with their allowed case sets
  def shapeViews:[string:ShapeViewDesc]
  ; group → parent group (nested `group Child does Parent`)
  def shapeGroupParent:[string:string]
  ; C5: fields available through a group union (own + inherited), keyed by
  ; mangled group class name (`Value_Ref`). Types keyed by `Group.field`.
  def shapeGroupFields:[string:[string]]
  def shapeGroupFieldTypeName:[string:string]
  def shapeGroupFieldArrayType:[string:string]
  def shapeGroupFieldKeyType:[string:string]
  ; groups whose members are all @(value) — field sets are rejected
  def shapeGroupAllValue:[string:boolean]
  ; default `new Case(…)` argument source for widen fallbacks (C6)
  def shapeCaseCtorArgs:[string:string]

  def stdCommands@(optional):CodeNode
  def lastProcessedNode@(weak):CodeNode
  def collectWalkAtEnd:[CodeNode]
  def walkAlso@(weak):[CodeNode]
  ; placeholder classes and generic forms made by checkNativeGenerics; held
  ; here because nothing else in the tree owns them
  def genericCheckNodes:[CodeNode]
  def serializedClasses@(weak):[RangerAppClassDesc]
  def immutableClasses@(weak):[RangerAppClassDesc]
  def processClasses@(weak):[RangerAppClassDesc]
  def classesWithTraits:[ClassJoinPoint]
  def collectedIntefaces:[RangerAppClassDesc]
  def definedInterfaces:[string:boolean]

  def signatureCnt 0
  def argSignatureCnt 0
  def mainCnt 0
  def isDefinedSignature:[string:int]
  def isDefinedArgSignature:[string:int]

  def extendedClasses:[string:string]

  def allNewRNodes:[CodeNode]

  fn fixExpressionAssignmentChains:void (node@(lives):CodeNode) {
    def is_chaining false
    def last_is_assign false
    def chain_start_idx:int 0
    def chainRoot@(weak):CodeNode
    def innerNode@(weak):CodeNode
    def assignNode@(weak):CodeNode
    def newNode:CodeNode

    def ch_len (size node.children)
    for node.children item:CodeNode i {
      def did_find false
      def dotName:string ""
      def mArgs@(optional):CodeNode
      if (has item.children) {
        def fc (item.getFirst())
        dotName = fc.vref
        if ((size item.children) > 1) {
          mArgs = item.getSecond()
        }
      } {
        dotName = item.vref
        if ((i + 1) < ch_len) {
          mArgs = (at node.children (i + 1))
        }
      }
      if ( ( (strlen dotName) > 0 ) && ( ( charAt dotName 0) == (charcode ".")) ) {
        did_find = true
        if(i>0) {
          def last_line (at node.children (i - 1))
          if (is_chaining == false ) {
            chain_start_idx = (i - 1)
            last_line.createChainTarget()
            is_chaining = true
            if(!null? last_line.chainTarget) {
              chainRoot = last_line.chainTarget
              innerNode = last_line.chainTarget
              assignNode = last_line
              last_is_assign = true
            } {
              chainRoot = last_line
              innerNode = last_line
            }
          }
          def method_name (substring dotName 1 (strlen dotName))
          def callArgs:CodeNode (node.newExpressionNode())
          if (!null? mArgs) {
            callArgs = mArgs.copy()
          }
          newNode = (node.newExpressionNode())
          newNode.add( (node.newVRefNode("call") ) )
          newNode.add( (innerNode.copy() ) )
          newNode.add( (node.newVRefNode(method_name)) )
          newNode.add( callArgs )
          innerNode = newNode
          item.is_part_of_chain = true
          if (false == (has item.children)) {
            if ((i + 1) < ch_len) {
              def flatArg (at node.children (i + 1))
              flatArg.is_part_of_chain = true
            }
          }
        }
      }
      def maybe_chain_arg false
      if (is_chaining && (did_find == false) && (i > 0)) {
        def prev_item (itemAt node.children (i - 1))
        def prev_name:string ""
        if (has prev_item.children) {
          def prev_fc (prev_item.getFirst())
          prev_name = prev_fc.vref
        } {
          prev_name = prev_item.vref
        }
        if ( ( (strlen prev_name) > 0 ) && ( ( charAt prev_name 0) == (charcode ".")) ) {
          maybe_chain_arg = true
          item.is_part_of_chain = true
        }
      }
      if ( (i == (ch_len - 1)) || ( (did_find == false) && (maybe_chain_arg == false) ) ) {
        if is_chaining {
          def chainResult (unwrap innerNode)
          chainResult.finalizeAsCallChainRoot()
          if (last_is_assign && (!null? assignNode)) {
            def assignment:CodeNode (unwrap assignNode)
            while ( (array_length assignment.children) > 3 ) {
              removeLast assignment.children
            }
            if ( (array_length assignment.children) >= 3 ) {
              removeLast assignment.children
              push assignment.children chainResult
            }
          } {
            def kept:[CodeNode]
            def ci:int 0
            while (ci < chain_start_idx) {
              push kept (itemAt node.children ci)
              ci = ci + 1
            }
            push kept chainResult
            clear node.children
            for kept ch:CodeNode j {
              push node.children ch
              ch.parent = node
            }
          }
        }
        is_chaining = false
        last_is_assign = false
      }
    }
  }

  ; A PARENTHESISED RECEIVER -- `(unwrap x).field`, `(f()).m(a)`,
  ; `(a b).c.d` -- arrives from the reader as the expression with the
  ; `.name` token attached as its flagged last child. No writer can put a
  ; member access on an expression result, so the expression is bound to a
  ; temporary in the enclosing statement's register expressions (the slot
  ; operator arguments are hoisted into) and the node is replaced by one
  ; ordinary variable path, `<tmp>.field`, which every target already
  ; writes. A method call keeps its argument list after the new path, so
  ; `<tmp>.m (a)` is the normal local-call shape.
  ;
  ; The hoisted binding runs once, before the statement. In a loop CONDITION
  ; that would evaluate the receiver once for the whole loop, so that shape
  ; is refused with a message rather than compiled wrong.
  fn hoistParenthesisedReceivers:void (node@(lives):CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def i:int 0
    while (i < (size node.children)) {
      def item:CodeNode (at node.children i)
      def advanced:boolean false
      if (item.expression && ((size node.children) > 0)) {
        def icnt:int (size item.children)
        if (icnt > 1) {
          def lastCh:CodeNode (at item.children (icnt - 1))
          if lastCh.is_paren_member {
            def dotName:string lastCh.vref
            def blockOpU@(optional weak):CodeNode (ctx.getLastBlockOp())
            if (!null? blockOpU) {
              def BlockOP:CodeNode (unwrap blockOpU)
              def inLoopHead:boolean false
              if (has BlockOP.children) {
                def opHead:CodeNode (BlockOP.getFirst())
                if ((opHead.vref == "while") || (opHead.vref == "for")) {
                  inLoopHead = true
                }
              }
              remove item.children (icnt - 1)
              if inLoopHead {
                ctx.addError(lastCh ("A parenthesised receiver cannot be used in a loop condition: bind it first, as in `def recv " + (item.getCode()) + "` and then `recv" + dotName + "`"))
              } {
                def regName:string (ctx.createNewRegName())
                def regExpr:CodeNode (node.newExpressionNode())
                regExpr.add( (node.newVRefNode("def")) )
                regExpr.add( (node.newVRefNode(regName)) )
                regExpr.add( (item.copy()) )
                this.WalkNode( regExpr ctx wr )
                BlockOP.register_expressions.push( regExpr )
                def joined:CodeNode (node.newVRefNode((regName + dotName)))
                joined.parent = node
                set node.children i joined
                advanced = true
              }
            }
          }
        }
      }
      if (false == advanced) {
        i = (i + 1)
      }
    }
  }

  fn WalkNodeChildren:void (node@(lives):CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (node.hasStringProperty("todo")) {
      ctx.addTodo(node (node.getStringProperty("todo")))
    }
    if node.expression {
      this.hoistParenthesisedReceivers(node ctx wr)
      this.fixExpressionAssignmentChains(node)
      for node.children item@(lives):CodeNode i {

        if( (ctx.expressionLevel()) == 0 ) {
          ctx.lastBlockOp = item
        }
        item.parent = node
        this.WalkNode(item ctx wr)
        node.copyEvalResFrom(item)
      }      
    }
  }

  fn WalkNode:boolean (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ; nothing here reads the source line. Asking for it cost a walk over
    ; every line of the file -- getLine sums line lengths from the start --
    ; once per node, which is the whole tree against the whole file.
    if node.flow_done {
      return true
    }
    if( ctx.isPluginOp(node)) {
      return true
    }
    node.flow_ctx = ctx
    node.flow_done = true
    
    ; Before anything reads the first child: `((unwrap x).m (a))` must become
    ; `(<tmp>.m (a))` so the local-call detection below sees a name.
    if node.expression {
      this.hoistParenthesisedReceivers(node ctx wr)
    }

    this.lastProcessedNode = node
    if (node.hasStringProperty("todo")) {
      ctx.addTodo(node (node.getStringProperty("todo")))
    }
    ; currently skip...
    if(node.is_part_of_chain) {
      return true
    }
    if (node.isPrimitive()) {
      if ((ctx.expressionLevel()) == 0) {
        if! (ctx.hasCompilerFlag('voidexpr'))  {
          ctx.addError( node "Primitive element at top level!")
        }
      }
      this.WriteScalarValue(node ctx wr)
      return true
    }
    if (node.value_type == RangerNodeType.VRef || node.value_type == RangerNodeType.Hash || node.value_type == RangerNodeType.Array) { 
      this.WriteVRef(node ctx wr)
      return true
    }
    if (node.value_type == RangerNodeType.Comment) {
      return true
    }

    ; if node is defined from register, get the value from the register...
    if( (has node.register_name)) {
      if( ctx.isVarDefined( node.register_name )) {
        def regInfo (ctx.getVariableDef(node.register_name))
        if(!null? regInfo.nameNode ) {
          node.copyEvalResFrom( (unwrap regInfo.nameNode) )
          return true
        } {
          ; ctx.addError( node ('compiler error: could not find temporary register ' + node.register_name) )
        }
      } {
        ; ctx.addError( node ('compiler error: could not find temporary register ' + node.register_name) )
      }
      return true
    }

    ; if(node.expression && ((size node.children) > 0)) {
    if(node.value_type == RangerNodeType.XMLNode) {

      def fc node

      if(fc.value_type == RangerNodeType.XMLNode) {

        ; operator function...
        def opBody (r.block)
        def opTpl (r.expression (r.vref 'defn') (r.vref 'tmp_create') (r.expression) )
        
        def currCnt 1


        currCnt = (this.walkXmlCreate( fc 'r1' currCnt opBody ctx wr))

        push opBody.children (r.expression (r.vref 'ret') (r.vref 'r1'))
        push opTpl.children opBody

        node.value_type = RangerNodeType.NoType
        node.getChildrenFrom( (r.expression (r.vref 'tmp_create')))

        node.value_type = RangerNodeType.NoType
        node.expression = true

        this.TransformOpFn( ([] opTpl) node ctx wr)
        return true
      }

    }  

    if( (size node.children) == 1 ) {
      def fc (first node.children)
      if( ctx.isVarDefined( fc.vref )) {
        fc.parent = node
        if(!null? fc.evalCtx) {
          this.WalkNode(fc (unwrap fc.evalCtx) wr)
        } {
          this.WalkNode(fc ctx wr)
        }
        node.copyEvalResFrom(fc)
        return true        
      }
    }

    def skip_if ([] "Extends" "operator" "extends" "operators" "systemclass" "systemunion" "union" "flag" "trait" "enum" "Import")
    if( has node.children ) {

      def fc (first node.children)
      if( (indexOf skip_if fc.vref ) >= 0) {
        return true
      }      

      ; _1 _2 _3 _4 _5 _6 

      ; createNewOpFnName
      ; ("" + (_ * 10))
      ; (=> "" + (_ * 10))
      ; defn tmp_anon1 (v1) ("" + (v1 * 10))
      ; (=> "" + (_ * 10)) --> tmp_anon1
      ; map items (# print '' + _)

      ; (# _ > 10) item

      if(fc.vref == '#') {

        ; print "--> arrow op " + (node.getCode()) + " err cnt " + (ctx.errCnt())

        def fnCtx (ctx.findFunctionCtx())
        this.DefineArrowOpFn( node fnCtx wr)

        node.value_type = RangerNodeType.VRef
        node.expression = false
        node.is_block_node = false
        ; node.vref = ''
        clear node.ns
        push node.ns node.vref

        clear node.children
        nullify node.paramDesc
        node.hasParamDesc = false
        return true
      } {
        if(fc.expression  && (has fc.children)) {
          def exprFc (first fc.children)
          if(exprFc.vref == '#') {
            ; def opFnName ( ctx.createNewOpFnName() )
            this.DefineArrowOpFn( fc ctx wr)
          }
        }        
      }
      

      if (fc.vref == "proc_send") {
        if (RangerProcessProcSend.transform(this node ctx wr)) {
          return true
        }
      }

      if (fc.vref == "proc_start") {
        RangerProcessProcStartCheck.validate(this node ctx wr)
      }

      def b_found true
      def opFn (ctx.getOpFns(fc.vref))
      if(has opFn) {
        if (fc.vref == "=") {
          this.repairAssignMethodCallRhs(node)
        }
        this.TransformOpFn( opFn node ctx wr)
        return true
      }
      
      switch fc.vref {
        case 'page' {
          def sc (node.getSecond())
          ctx.addPage( sc.vref node )
        }
        case 'def' { 
          this.repairAssignMethodCallRhs(node)
          EnterVarDef this node ctx wr
        }
        case 'var' {
          this.repairAssignMethodCallRhs(node)
          EnterVarDef this node ctx wr
        }
        case 'let' {
          this.repairAssignMethodCallRhs(node)
          EnterVarDef this node ctx wr
        }
        case 'property' {
          this.GetProperty(node ctx wr)
        }
        case 'CreateClass' {
          this.EnterClass(node ctx wr)
        }
        case 'class' {
          this.EnterClass(node ctx wr)
        }
        case 'record' {
          this.EnterClass(node ctx wr)
        }
        case 'defn' {
          this.DefineOpFn(node ctx wr)
        }
        case 'fn' {
          if(ctx.isInMethod()) {    
            this.EnterLambdaMethod( node ctx wr )
          } {
            this.EnterMethod(node ctx wr)
          }      
        }
        case 'sfn' {
          this.EnterStaticMethod(node ctx wr)
        }
        case 'static' {
          this.EnterStaticMethod(node ctx wr)
        }
        case '=' {
          this.cmdAssign(node ctx wr)
        }
        case 'constructor' {
          this.Constructor(node ctx wr)
        }
        case 'Constructor' {
          this.Constructor(node ctx wr)
        }
        case 'new' {
          this.cmdNew(node ctx wr)
        }
        case '[]' {
          this.cmdArray( node ctx wr )      
        }
        case 'call' {
          this.cmdCall( node ctx wr )      
        }
        case 'fun' {
          this.EnterLambdaMethod( node ctx wr )      
        }
        case 'extension' {
          this.EnterClass(node ctx wr)
        }
        case 'service' {
          try {
            def sc (node.getSecond())
            def params (node.getThird())
            ctx.addService( sc.vref node )
            def paramClass (params.getFirst())
            def rvClassDef (ctx.findClass(sc.type_name))
            def paramClassDef (ctx.findClass(paramClass.type_name))
            node.appGUID = sc.vref+"_"+(sha256 ( (rvClassDef.node.getCode()) + (paramClassDef.node.getCode()) ) )

          } {
            ctx.addError(node "invalid service definition")
          }          
        }
        default {
          b_found = false
        }
      }
      if b_found {
        return true
      }
    }    

    if (this.matchNode(node ctx wr)) {
      return true
    }

    if ((size node.children) > 0) {
      
      def fc:CodeNode (at node.children 0)

      ; (  (someObject) '.someProperty' )
      if( fc.expression && ( ( size node.children ) == 2) ) {
        def sec (node.getSecond())
        if( (has sec.vref) && (first sec.vref) == '.' ) {


          ; TODO: implement also pure property access...
;          print "Possible property access " + (node.getCode()) + " : " + (substring sec.vref 1)
;          print "--> Walking "
          this.WalkNode( fc ctx wr )
;          print "<-- returned from walk of Possible property access " + (node.getCode()) + " : " + (substring sec.vref 1)
;          print "<-- type == " + fc.eval_type_name
          
          if( (has fc.eval_type_name) && (ctx.isDefinedClass(fc.eval_type_name)) ) {
            
            def parts (strsplit (substring sec.vref 1) ".")
            def method_name (first parts)
            def classDesc (ctx.findClass(fc.eval_type_name))

            def objExpr (fc.copy()) 
            def calledItem (r.expression 
                            (r.vref 'property')
                            (fc.copy())
                            (r.vref method_name)
                          )
            parts.forEach({
              if(index > 0) {
                  try {
                    def p (classDesc.findVariable(method_name))
                    ; the class may not have the property at all -- findVariable
                    ; answers nothing, and only JavaScript survives reading
                    ; `nameNode` off that nothing. The `try` around this catches
                    ; a raised unwrap, and a plain field read is not one.
                    if (null? p) {
                      ctx.addError(sec ('invalid property ' + method_name))
                      return
                    }
                    def propertyDesc:RangerAppParamDesc (unwrap p)
                    if (null? propertyDesc.nameNode) {
                      ctx.addError(sec ('invalid property ' + method_name))
                      return
                    }
                    def propertyName:CodeNode (unwrap propertyDesc.nameNode)
                    classDesc = (ctx.findClass(propertyName.type_name))
                    calledItem = (r.expression 
                                    (r.vref 'property')
                                    (calledItem.copy())
                                    (r.vref item)
                                )
                    method_name = item
                  } {
                    ctx.addError(sec ('invalid property'))
                  }
              }
            })

            def m (classDesc.findVariable(method_name))
            if (!null? m) {
                node.getChildrenFrom( calledItem )
                node.flow_done = false
                this.WalkNode( node ctx wr)
                return true
            }

            def m (classDesc.findMethod(method_name))
            if (!null? m) {
                ; ( (<something>) .someMethod )
                node.getChildrenFrom( calledItem )
                node.flow_done = false
                this.transformMethodToLambda( node (unwrap m) ctx wr )
                return true
            }
          }
        }
      } 

      ; (  (someObject) '.methodName' (<arguments>) )
      if( fc.expression && ( ( size node.children ) == 3) ) {
        if (this.transformDotMethodCallExpr(node ctx wr)) {
          return true
        }
      } 
      
      if (fc.value_type == RangerNodeType.VRef) {
        def was_called:boolean true
        switch fc.vref {
          case "Enum" {
            ; this.cmdEnum(node ctx wr)
            was_called = true
          }
          default {
            was_called = false
          }
        }
        if was_called {
          return true
        }
        if ((size node.children) > 1) {
          if (this.cmdLocalCall(node ctx wr)) {
            return true
          }
        }
      } 
    }
    if node.expression {
      this.hoistParenthesisedReceivers(node ctx wr)
      this.fixExpressionAssignmentChains(node)
      for node.children item@(lives):CodeNode i {

        if( (ctx.expressionLevel()) == 0 ) {
          ctx.lastBlockOp = item
        }
        
        item.parent = node
        if(!null? item.evalCtx) {
          this.WalkNode(item (unwrap item.evalCtx) wr)
        } {
          this.WalkNode(item ctx wr)
        }
        node.copyEvalResFrom(item)

        if( (i == 0) && ( (size node.children ) == 2) ) {
          
          if(item.eval_type == RangerNodeType.Method && (!null? item.paramDesc) ) {
            
            def mDesc (unwrap item.paramDesc)
            ;def mDesc (cast pDesc to:RangerAppFunctionDesc)
            def methodName:CodeNode (unwrap mDesc.nameNode)

            node.eval_type = methodName.value_type
            node.eval_type_name = methodName.type_name
            node.eval_array_type = methodName.array_type
            node.eval_key_type = methodName.eval_key_type

            node.is_direct_method_call = true
            return true

          }
        }

        ; the first node could be lambda expression, which transforms to lambda call ...
        if( (!null? item.expression_value) || item.value_type == RangerNodeType.ExpressionType || item.eval_type == RangerNodeType.ExpressionType ) {
          
          ; localLambdaCall
          if( (i == 0) && ( (size node.children ) == 2) ) {
            
            node.has_lambda_call = true            
            def second ( at node.children 1)
            ctx.setInExpr()
            this.WalkNode( second ctx wr)
            ctx.unsetInExpr()

            ; set the lambda expression return value as the value of the current node...
            if(!null? item.expression_value) {
              def lambdaNode (unwrap item.expression_value)

              def nn:CodeNode (at lambdaNode.children 0)
              node.eval_type = (nn.typeNameAsType(ctx))
              node.eval_type_name = nn.type_name
              node.eval_array_type = nn.array_type
              node.eval_key_type = nn.key_type
              if(node.eval_type == RangerNodeType.ExpressionType) {
                node.expression_value = (nn.expression_value.copy())
              }
              if(nn.hasFlag("optional")) {
                node.setFlag("optional")
              }
              this.testLambdaCallArgs( lambdaNode second ctx wr )
            }
            break
          }
        }
      }
      ; ctx.addError(node "Could not understand this part")
      return true
    }

    ctx.addError(node "Could not understand this part")

    return true
  }



  fn getVoidNameSignature:string () {
      def s "void"
      if(has isDefinedSignature s) {
        def cc (unwrap (get isDefinedSignature s))
        return ("void_" + cc)
      }
      signatureCnt = signatureCnt + 1
      def voidSigNo:int signatureCnt
      set isDefinedSignature s voidSigNo
      return ( "void_" + signatureCnt )
  }  

  fn getNameSignature:string (node:CodeNode) {
      def s ( (node.type_name) + (node.buildTypeSignature()) )
      if(has isDefinedSignature s) {
        def cc (unwrap (get isDefinedSignature s))
        if(cc == 1) {
          return node.type_name
        }        
        return ("_" + cc)
      }
      signatureCnt = signatureCnt + 1
      def nameSigNo:int signatureCnt
      set isDefinedSignature s nameSigNo
      if(signatureCnt == 1) {
        return node.type_name
      }
      return ( node.type_name + "_" + signatureCnt )
  }  

  fn getArgsSignature:string (node:CodeNode) {
      def exp_s ""
      for node.children arg:CodeNode i {
        exp_s = exp_s + (arg.buildTypeSignature())
        exp_s = exp_s + ","
      }
      if(has isDefinedArgSignature exp_s) {
        def cc (unwrap (get isDefinedArgSignature exp_s))
        if(cc == 1) {
          return ""
        }       
        return ("_" + cc)
      }
      signatureCnt = signatureCnt + 1
      def argSigNo:int signatureCnt
      set isDefinedArgSignature exp_s argSigNo
      if(signatureCnt == 1) {
        return ""
      }      
      return ( "_" + signatureCnt )
  }    
  fn getThisName:string () {
    return "this"
  }

  ; (property obj someProperty)
  ; (property obj x)
  fn GetProperty:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if( (size node.children ) != 3) {
      ctx.addError(node 'Invalid property descriptor')
      return
    }
    def obj (node.getSecond())
    def prop (node.getThird())
    this.WalkNode( obj ctx wr )
    
    if( ctx.isDefinedClass(obj.eval_type_name) ) {
      try {
        def currC ( ctx.findClass(obj.eval_type_name) )
        def varDef (currC.findVariable(prop.vref))
        if(!null? varDef) {

          prop.flow_done = true
          prop.eval_type = RangerNodeType.VRef
          ; The NAME to emit lives on the descriptor, not on this node. A
          ; property whose name is a keyword of the target is renamed at its
          ; declaration -- `def async` becomes `self._async` on Python -- and
          ; this vref still carries the source spelling. Writers reach it two
          ; ways, and both read the descriptor list rather than the vref, so
          ; putting it here fixes every target at once.
          ;
          ; Without it, `if ((h.nodeOf()).async)` emitted `h.nodeOf().async`
          ; against a `self._async` declaration: a Python SyntaxError the
          ; compiler reported as a successful build, and the reason the TS
          ; engine had never once built for Python (ISSUES.md #80).
          if ((array_length prop.nsp) == 0) {
            push prop.nsp (unwrap varDef)
          }

          node.hasParamDesc = true
          node.ownParamDesc = varDef
          node.paramDesc = varDef
          varDef.ref_cnt = (1 + varDef.ref_cnt)
          def vNameNode:CodeNode varDef.nameNode
          if (!null? vNameNode)  {
            if (vNameNode.hasFlag("optional")) {
              node.setFlag("optional")
            }

            node.eval_type = (vNameNode.typeNameAsType(ctx))
            node.eval_type_name = vNameNode.type_name
            if (vNameNode.value_type == RangerNodeType.Array) {
              node.eval_type = RangerNodeType.Array
              node.eval_array_type = vNameNode.array_type
            }
            if (vNameNode.value_type == RangerNodeType.Hash) {
              node.eval_type = RangerNodeType.Hash
              node.eval_key_type = vNameNode.key_type
              node.eval_array_type = vNameNode.array_type
            }
          }
          return
        }
        ; C5: group field projection — `r.identityId` on a group union
        if (currC.is_union && (this.shapeGroupHasField(currC.name prop.vref))) {
          this.rewriteToGroupFieldGet(node obj prop.vref currC.name ctx wr)
          return
        }
        def mDef (currC.findMethod(prop.vref))
        if(!null? mDef) {
          ; node.flow_done = true
          node.eval_type = RangerNodeType.Method
          node.hasParamDesc = true
          node.ownParamDesc = mDef
          node.paramDesc = mDef
          mDef.ref_cnt = (1 + mDef.ref_cnt)
          return
        } 
        ctx.addError(node ('Did not find property from class ' + currC.name))        
      } {
        ctx.addError(node 'Not valid property access')
      }

    } {
      ctx.addError(obj 'Can not access property of a non-class value')
    }

  }

  fn WriteVRef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (node.vref == "_") {
      return
    }
    if (node.vref == "#") {
      return
    }

    def rootObjName:string (at node.ns 0)
    if (ctx.isInStatic()) {
      if(rootObjName == "this") {
        ctx.addError(node "This can not be used in static context")
      }
    }
    if (ctx.isEnumDefined(rootObjName)) {
      def enumName:string (at node.ns 1)
      def ee@(optional):RangerAppEnum (ctx.getEnum(rootObjName))
      def e:RangerAppEnum (unwrap ee)
      if (has e.values enumName) {
        node.eval_type = RangerNodeType.Enum
        node.eval_type_name = rootObjName
        node.int_value = (unwrap (get e.values enumName))
      } {
        ctx.addError(node ('Undefined Enum ' + rootObjName + '.' + enumName))
        node.eval_type = RangerNodeType.InvalidType
      }
      return 
    }
    if (node.vref == (this.getThisName())) {
      def cd@(optional):RangerAppClassDesc (ctx.getCurrentClass())
      def thisClassDesc:RangerAppClassDesc cd
      node.eval_type = RangerNodeType.Object
      node.eval_type_name = thisClassDesc.name
      node.ref_type = RangerNodeRefType.StrongImmutable
      ; def ts:RangerTypeClass (thisClassDesc.nameNode.createTypeSignature(ctx))
      ;node.typeClass = ts
      return
    }

    if( ctx.isCapturing()) {
      if( (ctx.isVarDefined(rootObjName)) ) {
        if ( (ctx.isLocalToCapture(rootObjName)) == false ) {
          ; is_captured
          def captDef@(lives):RangerAppParamDesc (ctx.getVariableDef(rootObjName))
          def cd@(optional):RangerAppClassDesc (ctx.getCurrentClass())
          ; capturedLocals
          push cd.capturedLocals captDef

          captDef.is_captured = true
          ctx.addCapturedVariable(  rootObjName) 
        }    
      }
    }
    if ( rootObjName == "this" || (ctx.isVarDefined(rootObjName)) ) {

      ; C5: `r.identityId` where r is a shape group union → ops getter
      if (((size node.ns) == 2) && (ctx.isVarDefined(rootObjName))) {
        def rootDef:RangerAppParamDesc (ctx.getVariableDef(rootObjName))
        if (!null? rootDef.nameNode) {
          def rootName:CodeNode (unwrap rootDef.nameNode)
          if ((strlen rootName.type_name) > 0) {
          def gType:string rootName.type_name
          def fieldName:string (at node.ns 1)
          if (this.shapeGroupHasField(gType fieldName)) {
            def recv:CodeNode (node.newVRefNode(rootObjName))
            this.rewriteToGroupFieldGet(node recv fieldName gType ctx wr)
            return
          }
          }
        }
      }

      def vDef2:RangerAppParamDesc (ctx.getVariableDef(rootObjName))
      def activeFn:RangerAppFunctionDesc (ctx.getCurrentMethod())
      def vDef@(optional):RangerAppParamDesc (this.findParamDesc(node ctx wr))

      if(!null? vDef) {
        node.hasParamDesc = true
        node.ownParamDesc = vDef
        node.paramDesc = vDef
        vDef.ref_cnt = (1 + vDef.ref_cnt)
        vDef.read_cnt = (1 + vDef.read_cnt)
        def vNameNode:CodeNode vDef.nameNode

        if( ctx.isDefinedClass( node.type_name)) {
          def m (ctx.getCurrentMethod())
          m.addClassUsage( (ctx.findClass(node.type_name)) ctx)
        }
        if( ctx.isDefinedClass( node.eval_type_name)) {
          def m (ctx.getCurrentMethod())
          m.addClassUsage( (ctx.findClass(node.eval_type_name)) ctx)
        }

        if (!null? vNameNode)  {
          if (vNameNode.hasFlag("optional")) {
            node.setFlag("optional")
          }
          ;def ts:RangerTypeClass (vNameNode.createTypeSignature(ctx))
          ;node.typeClass = ts
          node.eval_type = (vNameNode.typeNameAsType(ctx))
          node.eval_type_name = vNameNode.type_name
          if (vNameNode.value_type == RangerNodeType.Array) {
            node.eval_type = RangerNodeType.Array
            node.eval_array_type = vNameNode.array_type
          }
          if (vNameNode.value_type == RangerNodeType.Hash) {
            node.eval_type = RangerNodeType.Hash
            node.eval_key_type = vNameNode.key_type
            node.eval_array_type = vNameNode.array_type
          }
        }
      } {
        ctx.addError( node 'Undefined variable')
      }
    } {
      def class_or_this:boolean (rootObjName == (this.getThisName()))
      if (ctx.isDefinedClass(rootObjName)) {
        class_or_this = true
        node.eval_type = RangerNodeType.Class
        node.eval_type_name = rootObjName
        def m (ctx.getCurrentMethod())
        m.addClassUsage( (ctx.findClass(rootObjName)) ctx)
      }
      if (ctx.hasTemplateNode(rootObjName)) {
        class_or_this = true
      }
      if (false == class_or_this) {
        def udesc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
        def desc:RangerAppClassDesc (unwrap udesc)

        def opList (ctx.getOpFns(node.vref))
        ; if {

        if( (has opList) || node.vref == "fun" || node.vref == "fn" || (node.hasFlag('keyword'))) {
          ; print "TODO: fix the 'fun'"
        } {

          ctx.addError(node ('WriteVREF -> Undefined variable ' + node.vref + ' in class ' + desc.name + ' node : ' + (node.getCode())))
          if (!null? node.parent) {
            def parent:CodeNode (unwrap node.parent)
            ctx.addError(node ('WriteVREF -> Undefined variable ' + rootObjName + ' in class ' + desc.name + ' node : ' + (parent.getCode())))
            if(!null? parent.parent) {
              def grandparent:CodeNode (unwrap parent.parent)
              ctx.addError(node ('WriteVREF -> Undefined variable ' + rootObjName + ' in class ' + desc.name + ' node : ' + (grandparent.getCode())))
            }
          }
        }


      }
      return
    }
  }

  ; The name node, the argument list, the body and the class a function
  ; definition is made of — or nothing, with the error already reported.
  fn EnterFnParts:RangerFnParts (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ; the result is always an object, with `ok` saying whether it was filled:
    ; an OPTIONAL return out of a function holding a `try` is a shape the Go
    ; writer types from the catch value rather than from the declaration.
    def res:RangerFnParts (new RangerFnParts)
    ; one exit only: a `return` out of a try block is not something every
    ; target can write either
    try {
      if( (size node.children ) < 4) {
        ctx.addError( node 'Function has too few arguments')
      } {
        def idx 0
        node.children.forEach({
          if(item.vref == 'static') {
            idx = idx + 1
          }
        })
        def currClass (ctx.getCurrentClass())
        if(null? currClass) {
          ctx.addError( node 'Current class was not defined when entering method')
        } {
          res.nameNode = (at node.children (idx + 1))
          res.fnArgs = (at node.children (idx + 2))
          res.fnBody = (at node.children (idx + 3))
          res.desc = (unwrap currClass)
          res.ok = true
        }
      }
    } {
      ctx.addError( node ('Error parsing function ' + (error_msg)))
    }
    return res
  }

  fn Constructor:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    this.shouldHaveChildCnt(3 node ctx "Method expexts four arguments")
    def cn:CodeNode (at node.children 1)
    def fnBody:CodeNode (at node.children 2)
    def udesc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
    def desc:RangerAppClassDesc (unwrap udesc)
    def m@(lives):RangerAppFunctionDesc desc.constructor_fn
    def subCtx:RangerAppWriterContext (unwrap m.fnCtx)
    
    subCtx.is_function = true
    subCtx.currentMethod = m
    subCtx.setInMethod()
    for m.params v@(lives):RangerAppParamDesc i {
      subCtx.defineVariable(v.name v)
    }
    this.WalkNodeChildren(fnBody subCtx wr)
    subCtx.unsetInMethod()
    if (fnBody.didReturnAtIndex >= 0) {
      ctx.addError(node "constructor should not return any values!")
    }
    for subCtx.localVarNames n:string i {
      def p:RangerAppParamDesc (get subCtx.localVariables n)
      if (p.set_cnt > 0) {
        if(p.is_immutable) {
          ctx.addError( node "Immutable variable was assigned a value")
        }        
        def defNode:CodeNode p.node
        defNode.setFlag("mutable")
        def nNode:CodeNode p.nameNode
        nNode.setFlag("mutable")
      }
    }
  }
  fn WriteScalarValue:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    TTypes.baseTypeAsEval( node ctx wr )
    node.evalTypeClass = (TFactory.new_scalar_signature( node ctx wr ))
  }
 
  fn normalizeNewArgList:void (node:CodeNode) {
    if ((node.chlen()) <= 3) {
      return
    }
    def third:CodeNode (node.getThird())
    if (third.expression && ((size third.children) > 0)) {
      return
    }
    def argList:CodeNode (new CodeNode ( (unwrap node.code) node.sp node.ep))
    argList.expression = true
    def ci 2
    def chlen (node.chlen())
    while (ci < chlen) {
      push argList.children (at node.children ci)
      ci = ci + 1
    }
    while ((node.chlen()) > 2) {
      removeLast node.children
    }
    push node.children argList
  }

  fn cmdNew:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (node.tryDesugarNewMethodChain()) {
      node.flow_done = false
      this.cmdCall(node ctx wr)
      return
    }
    if ((size node.children) < 2) {
      ctx.addError(node "the new operator expects at lest two arguments")
      return
    }
    if ((size node.children) < 3) {
      def expr (new CodeNode ( (unwrap node.code) node.sp node.ep))
      expr.expression = true
      push node.children expr
    }
    this.normalizeNewArgList(node)
    def obj:CodeNode (node.getSecond())
    def params:CodeNode (node.getThird())
    def currC@(lives optional):RangerAppClassDesc
    def b_template:boolean false

    def expects_error:boolean false
    def err_cnt:int (ctx.getErrorCount())
    if( node.hasBooleanProperty("error")) {
      expects_error = true
    } 

    ; transform generic trait into a class if necessary
    if(obj.has_vref_annotation) {
      this.CheckVRefTypeAnnotationOf( obj ctx wr )
    }    
    this.WalkNode(obj ctx wr)

    if (b_template == false) {
      currC = (ctx.findClass(obj.vref))
    }
    def fnDescr@(optional):RangerAppFunctionDesc
    if (!null? currC) {
      def clTmp:RangerAppClassDesc (unwrap currC)
      fnDescr = clTmp.constructor_fn
    }
    if (!null? fnDescr) {
      def ctorFn:RangerAppFunctionDesc (unwrap fnDescr)
      if (!null? currC) {
        def newCl:RangerAppClassDesc (unwrap currC)
        this.expandRecordCtorArgsIfNeeded(newCl ctorFn params node)
      }
      ctorFn.params.forEach({
        if(item.nameNode.hasFlag('keyword')) {
          if ((size params.children) > index) {
            ( (at params.children index) .setFlag('keyword'))
          }
        }
      })
    }

    for params.children arg:CodeNode i {
      if (arg.hasFlag('keyword')) {
        continue
      }
      ctx.setInExpr()
      this.WalkNode(arg ctx wr)
      ctx.unsetInExpr()
    }
    node.eval_type = RangerNodeType.Object
    node.eval_type_name = obj.vref
    if (b_template == false) {
      if (null? currC) {
        currC = (ctx.findClass(obj.vref))
      }
      ; `new Foo` where Foo names no declared class -- the walk of `obj` above
      ; has already said so, and there is no class here to record a usage of.
      ; addClassUsage reads the descriptor's variables, which is a null
      ; dereference anywhere but JavaScript.
      if (!null? currC) {
        def currM (ctx.getCurrentMethod())
        currM.addClassUsage( (unwrap currC) ctx )
      }
    }
    node.hasNewOper = true
    node.clDesc = currC
    if (null? currC) {
    } {
      def newCl:RangerAppClassDesc (unwrap currC)
      if (newCl.is_process) {
        def procCodegen:RangerProcessCodegen (new RangerProcessCodegen())
        procCodegen.validateProcessNewSite(node newCl ctx)
      }
    }
    if (!null? fnDescr) {
      def ctorFn:RangerAppFunctionDesc (unwrap fnDescr)
      if( (size ctorFn.params) > (size params.children)) {
        ctx.addError(node 'Not enough arguments for class constructor ' + (ctorFn.node.getLineAsString()))
        return
      }
      for ctorFn.params param:RangerAppParamDesc i {
        def has_default:boolean false
        def parameterName:CodeNode (unwrap param.nameNode)
        if (parameterName.hasFlag('default')) {
          has_default = true
        }

        if( parameterName.hasFlag('keyword')) {
          continue
        }

        if( (size params.children) <= i) {
          if has_default {
            continue _
          }
          ctx.addError(node 'Missing arguments for function')
          ctx.addError(parameterName 'To fix the previous error: Check original function declaration')
        }

        def argNode:CodeNode (at params.children i)

        if (false == (this.areEqualTypes(parameterName argNode ctx wr))) {
          def className:string ""
          if (!null? currC) {
            def currentClass:RangerAppClassDesc (unwrap currC)
            className = currentClass.name
          }
          ctx.addError(argNode ('ERROR, invalid argument type for ' + className + ' constructor '))
        }

        def pNode:CodeNode parameterName
        if( pNode.hasFlag("optional")) {
          ;if ( false == (argNode.hasFlag("optional")) ) {
          ;    ctx.addError(node ( 'new parameter optionality does not match, expected optional parameter' + (argNode.getCode())) )          
          ;}
        }
        if( argNode.hasFlag('optional')) {
          if ( false == (pNode.hasFlag('optional')) ) {
              ctx.addError(node ( 'new parameter optionality does not match, expected non-optional, optional given' + (argNode.getCode())) )          
          }
        }
      }
    }

    if(expects_error) {
      def cnt_now:int (ctx.getErrorCount())
      if (cnt_now == err_cnt) {
        ctx.addParserError( node "LANGUAGE_PARSER_ERROR: expected generated error, err counts : " + err_cnt + " : " +cnt_now)
      }
    } {
      def cnt_now:int (ctx.getErrorCount())
      if (cnt_now > err_cnt) {
        ctx.addParserError( node "LANGUAGE_PARSER_ERROR: did not expect generated error, err counts : " + err_cnt + " : " +cnt_now)
      }      
    }
  }

  fn transformParams:[CodeNode] ( list:[CodeNode] fnArgs:[RangerAppParamDesc] ctx:RangerAppWriterContext) {
    def res:[CodeNode]
    for list item:CodeNode i {
      if(item.is_block_node) {
        def newNode:CodeNode (new CodeNode ( (unwrap item.code) item.sp item.ep))
        def fnArg:RangerAppParamDesc (at fnArgs i)
        def nn:CodeNode (fnArg.nameNode)
        if(null? nn.expression_value) {
          ctx.addError( item "Parameter is not lambda expression")
          break
        }
        def fnDef:CodeNode (unwrap nn.expression_value)
        def match:RangerArgMatch (new RangerArgMatch ())
        def copyOf:CodeNode (fnDef.rebuildWithType( match false ))
        ; example:
        ;     fn  mapToStrings:[string] ( callback:( f:string (item:T))  ) {
        def fc:CodeNode (at copyOf.children 0)
        fc.vref = "fun"
        ; then add the block as the last children
        def itemCopy:CodeNode (item.rebuildWithType (match false))
        push copyOf.children itemCopy
        def cnt:int ( size item.children )
        while( cnt > 0) {
          removeLast item.children
          cnt = cnt - 1
        }
        for copyOf.children ch@(lives):CodeNode i {
          ; ch.flow_done = false
          push item.children ch
        }
      } 
      push res item
    } 
    return res
  }

  fn transformParams2:[CodeNode] ( list:[CodeNode] fnArgs:[CodeNode] ctx:RangerAppWriterContext) {
    def res:[CodeNode]
    for list item:CodeNode i {
      if(item.is_block_node) {
        print "Transforming --> " + (item.getCode())
        def newNode:CodeNode (new CodeNode ( (unwrap item.code) item.sp item.ep))
        def nn:CodeNode (at fnArgs i)
        if(null? nn.expression_value) {
          ctx.addError( item "Parameter is not lambda expression")
          break
        }
        def fnDef:CodeNode (unwrap nn.expression_value)
        def match:RangerArgMatch (new RangerArgMatch ())
        def copyOf:CodeNode (fnDef.rebuildWithType( match false ))
        ; example:
        ;     fn  mapToStrings:[string] ( callback:( f:string (item:T))  ) {
        def fc:CodeNode (at copyOf.children 0)
        fc.vref = "fun"
        ; then add the block as the last children
        def itemCopy:CodeNode (item.rebuildWithType (match false))
        push copyOf.children itemCopy
        def cnt:int ( size item.children )
        while( cnt > 0) {
          removeLast item.children
          cnt = cnt - 1
        }
        for copyOf.children ch@(lives):CodeNode i {
          ; ch.flow_done = false
          push item.children ch
        }
      } 
      push res item
    } 
    return res
  }

  ; compile time type information
  fn CreateCTTI (node:CodeNode ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def root (ctx.getRoot())    
    def wr (new CodeWriter)

    root.definedClasses.forEach({
      if(item.isNormalClass()) {
          wr.raw(`
      operators {
        class_name _:string ( ` + item.name + `@(keyword) ) {
          templates {
            * ( '\"` + item.name + `\"' )
          }
        }
      }    
          ` , true)
      }
    })
    root.pushAndCollectCode( (wr.getCode()) orig_wr )
  }

  ; run-time type information ... 
  fn CreateRTTI (node:CodeNode ctx:RangerAppWriterContext orig_wr:CodeWriter) {

    def root (ctx.getRoot())    
    def wr (new CodeWriter)



    wr.out('operator type:void all {' true)
    wr.indent(1)
    wr.out('fn rtti_get_classes:[string] () {' true)
      wr.indent(1)    
      wr.out('return ([] ' false)
      root.definedClasses.forEach({
        if(item.isNormalClass()) {
          wr.out( `'` + item.name +  `' ` , false )
        }
      })
      wr.out(')' true)
    wr.indent(-1)
    wr.out('}' true)


    wr.out('fn rtti_get_fields:[RTTIClassField] (className:string) {' true)
      wr.indent(1)   
      wr.out(`def fields:[RTTIClassField]` true)
      root.definedClasses.forEach({
        if(item.isNormalClass()) {
          wr.out(`if(className == '` + item.name +`') {` , true)
          wr.indent(1)
          item.variables.forEach({
            def variableName:CodeNode (unwrap item.nameNode)
            wr.out('def f (new RTTIClassField)' true)
            wr.out('f.name = `' + item.compiledName +  '`' , true)
            wr.out('f.type_name = `' + variableName.type_name +  '`' , true)
            wr.out('push fields f' true)
          })
            ; -->
          wr.indent(-1)
          wr.out(`}` true)
        }
      })
      wr.out('return fields' true)
      wr.indent(-1)
      wr.out('}' true)
    wr.indent(-1)
    wr.out('}' true)

    ; print (wr.getCode())

    root.pushAndCollectCode( (wr.getCode()) orig_wr )
  }
  

  ; Lower one XML node into the create-expression body. This was a recursive
  ; lambda inside WalkNode; Rust cannot borrow-check a recursive closure that
  ; mutates what it captures, so the captured state travels as arguments and
  ; the register counter is threaded through the return value - which keeps
  ; the generated register names identical to what the lambda produced.
  fn walkXmlCreate:int (xmlNode:CodeNode regName:string in_currCnt:int opBody:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def currCnt:int in_currCnt


    def rootClassDef (ctx.findClass(xmlNode.vref))

    if rootClassDef.is_system {
      push opBody.children (r.expression (r.vref 'def') (r.vref regName) (r.expression (r.vref 'create') (r.vref xmlNode.vref)))
      xmlNode.attrs.forEach({
        if( (size item.children) > 0) {
          def fc (at item.children 0)
          ; print " - attr expression for " + item.vref +   " " + (fc.getCode())
          push opBody.children (r.expression (r.vref 'attr') (r.vref regName)  (r.vref item.vref) (fc.copy()) )
          return
        }
        if(has item.string_value) {
          push opBody.children (r.expression (r.vref 'attr') (r.vref regName)  (r.vref item.vref) (r.value item.string_value) )
        }
      })

      ; -- walk the children...
      xmlNode.children.forEach({
        if(item.value_type != RangerNodeType.XMLNode) {
          if( item.expression ) {
            ; for example maps
            def itemCopy (item.copy())
            def theNode item
            ctx.setTestCompile()
            this.WalkNode( itemCopy ctx wr )
            ctx.unsetTestCompile()
            if(ctx.hasClass(itemCopy.eval_array_type)) {
              def paramClassDef (ctx.findClass(itemCopy.eval_array_type))
              def chNode item
              def t (r.vref 'tmp')
              t.setFlag('temp')
              push opBody.children (r.expression (r.vref 'forEach' ) (theNode.copy()) 
                (r.block 
                  (r.expression (r.vref 'def') t (r.vref 'item') )
                  (r.expression (r.vref 'push') (r.vref regName) (r.vref 'tmp'))
                )
              )
            } {
              if(ctx.hasClass(itemCopy.eval_type_name)) {
                push opBody.children (r.expression (r.vref 'push') (r.vref regName) (theNode.copy()))
              }
            }
          } {
            ; print "--> not expression, vref -->  " + (item.vref) 
            ; if(ctx.hasClass(itemCopy.eval_type)) {
            ;  push opBody.children (r.expression (r.vref 'push') (r.vref regName) (item.copy()))
            ; }
          }
        }
        if(item.value_type == RangerNodeType.XMLNode) {
          if(ctx.hasClass(item.vref)) {
            def paramClassDef (ctx.findClass(item.vref))
            def chNode item
            currCnt = currCnt + 1
            def regN ('r' + currCnt)
            currCnt = (this.walkXmlCreate( chNode regN currCnt opBody ctx wr))
            push opBody.children (r.expression (r.vref 'push') (r.vref regName) (r.vref regN) )
          }
        }
      })
      ; ***** system class ends ****
    } {

      def match (new RangerArgMatch)
;   fn areEqualATypes:boolean (type1:string type2:string ctx:RangerAppWriterContext) {

      ; areEqualATypes

      push opBody.children (r.expression (r.vref 'def') (r.vref regName) (r.expression (r.vref 'new') (r.vref xmlNode.vref)))
      ; print "XML node " + xmlNode.vref
      xmlNode.attrs.forEach({
        ; print "attr " + item.vref + " str val -> " + item.string_value
        if( (size item.children) > 0) {
          def fc (at item.children 0)
          ; print " - attr expression for " + item.vref +   " " + (fc.getCode())
          push opBody.children (r.expression (r.vref '=') (r.vref (regName + '.' + item.vref)) (fc.copy()) )
          return
        }
        if(has item.string_value) {
          push opBody.children (r.expression (r.vref '=') (r.vref (regName + '.' + item.vref)) (r.value item.string_value) )
        }
        if(item.parsed_type == RangerNodeType.Integer) {
          push opBody.children (r.expression (r.vref '=') (r.vref (regName + '.' + item.vref)) (r.value item.int_value) )
        }
      })
      ; -- walk the children...
      xmlNode.children.forEach({
        if(item.value_type != RangerNodeType.XMLNode) {

          if( item.expression ) {
            ; for example maps
            def itemCopy (item.copy())
            def theNode item

            ctx.setTestCompile()
            this.WalkNode( itemCopy ctx wr )
            ctx.unsetTestCompile()

            if(ctx.hasClass(itemCopy.eval_array_type)) {
              def paramClassDef (ctx.findClass(itemCopy.eval_array_type))
              def chNode item
              rootClassDef.variables.forEach({
                def variableName:CodeNode (unwrap item.nameNode)
                ; --> comparing, are the same class ?? 
                if( match.areEqualATypes(variableName.array_type itemCopy.eval_array_type ctx)) {                      ; if(item.nameNode.array_type == itemCopy.eval_array_type) {
                  def t (r.vref 'tmp')
                  t.setFlag('temp')
                  push opBody.children (r.expression (r.vref 'forEach' ) (theNode.copy()) 
                    (r.block 
                      (r.expression (r.vref 'def') t (r.vref 'item') )
                      (r.expression (r.vref 'push') (r.vref (regName +'.' +item.name)) (r.vref 'tmp'))
                    )
                  )
                }
              })
            } {
              print "could not find class" + itemCopy.eval_array_type
            }
          }
        }
        if(item.value_type == RangerNodeType.XMLNode) {
          if(ctx.hasClass(item.vref)) {
            def paramClassDef (ctx.findClass(item.vref))
            def chNode item
            ; find the variable which has this class as array...
            rootClassDef.variables.forEach({
              def variableName:CodeNode (unwrap item.nameNode)
              if( match.areEqualATypes(variableName.array_type chNode.vref ctx)) {                      
                ; if(item.nameNode.array_type == itemCopy.eval_array_type) {
              ; if(item.nameNode.array_type == chNode.vref) {
                ; found the variable...
                currCnt = currCnt + 1
                def regN ('r' + currCnt)
                currCnt = (this.walkXmlCreate( chNode regN currCnt opBody ctx wr))
                if paramClassDef.is_immutable {
                  ; if Immutable should first walk the children and only after that add..
                  ;   r1_5 = (r1_5).set_children(operatorsOfVector.push_3(r1_5.children, (r7_1)));

                  push opBody.children (r.expression (r.vref '=') 
                                            (r.vref (regName +'.' +item.name)) 
                                            (r.expression (r.vref 'push') 
                                              (r.vref (regName +'.' +item.name)) (r.vref regN) ) )

                } {
                  push opBody.children (r.expression (r.vref 'push') (r.vref (regName +'.' +item.name)) (r.vref regN) )
                }
              }
            })
          }
        }
      })
    }

    return currCnt
  }

  ; The two async walks below were recursive lambdas declared inside
  ; SolveAsyncFuncs. Rust cannot borrow-check a recursive closure that also
  ; mutates what it captures, and the only thing either captured was the
  ; `visited` list (and `ctx`, for the variant walk), so they take those as
  ; arguments and recurse as methods. The two bodies differed — the variant
  ; walk also follows `forOtherVersions` — so they stay two.
  fn markAsyncFrom:void (f:RangerAppFunctionDesc visited:[RangerAppFunctionDesc]) {
    if( (indexOf visited f ) >= 0 ) {
      return
    }
    push visited f
    if( (!null? f.nameNode) ) {
      f.nameNode.setFlag('async')
    }
    f.isCalledBy.forEach({
      this.markAsyncFrom( item visited)
    })
    if( !null? f.insideFn) {
      this.markAsyncFrom( (unwrap f.insideFn ) visited)
    }
  }

  fn markAsyncFromVariant:void (f:RangerAppFunctionDesc visited:[RangerAppFunctionDesc] ctx:RangerAppWriterContext) {
    if( (indexOf visited f ) >= 0 ) {
      return
    }
    push visited f
    ; TODO: must also iterate all the inherited class functions...
    if( (!null? f.nameNode) ) {
      f.nameNode.setFlag('async')
    }
    f.forOtherVersions( ctx {
      this.markAsyncFromVariant( item visited ctx)
    })
    f.isCalledBy.forEach({
      this.markAsyncFromVariant( item visited ctx)
    })
    if( !null? f.insideFn) {
      this.markAsyncFromVariant( (unwrap f.insideFn ) visited ctx)
    }
  }

  ; Walk everything main reaches and mark it. This was a recursive lambda
  ; declared inside SolveAsyncFuncs; Rust cannot borrow-check a recursive
  ; closure that also mutates what it captures, and the only thing this one
  ; captured was `ctx`, so it takes it as an argument instead.
  fn markCalledFromMain:void (f:RangerAppFunctionDesc ctx:RangerAppWriterContext) {
    if(f.is_called_from_main) {
      return
    }
    f.is_called_from_main = true
    f.isUsingClasses.forEach({
      item.is_used_by_main = true
      if(!null? item.constructor_fn) {
        this.markCalledFromMain( (unwrap item.constructor_fn) ctx)
      }
    })
    f.forOtherVersions( ctx {
      this.markCalledFromMain(item ctx)
    })
    f.isCalling.forEach({
      this.markCalledFromMain( item ctx)
    })
    f.myLambdas.forEach({
      this.markCalledFromMain( item ctx)
    })
    if( !null? f.container_class) {
      def containerClass:RangerAppClassDesc (unwrap f.container_class)
      if(!null? containerClass.constructor_fn) {
        this.markCalledFromMain( (unwrap containerClass.constructor_fn) ctx)
      }
    }
  }

  fn SolveAsyncFuncs (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {

    def root (ctx.getRoot())
    root.definedClasses.forEach({

      item.static_methods.forEach({

          def thisFn (item)
          def visited@(weak):[RangerAppFunctionDesc]
          if( (!null? item.nameNode) ) {
            if(item.nameNode.hasFlag("async")) {
              item.isCalledBy.forEach({
                this.markAsyncFrom( item visited)
              })
              item.forOtherVersions( ctx {
                this.markAsyncFrom( item visited)
              })
              if( !null? item.insideFn) {
                this.markAsyncFrom( (unwrap item.insideFn ) visited)
              }
            }
          }
          item.myLambdas.forEach({
            if( (!null? item.nameNode) ) {
              if(item.nameNode.hasFlag("async")) {
                item.isCalledBy.forEach({
                  this.markAsyncFrom( item visited)
                })
                if( !null? item.insideFn) {
                  this.markAsyncFrom( (unwrap item.insideFn ) visited)
                }
              }
            }
          })            
      })
      
      item.method_variants.forEach({
        item.variants.forEach({

          def thisFn (item)
          def visited@(weak):[RangerAppFunctionDesc]
          if( (!null? item.nameNode) ) {
            if(item.nameNode.hasFlag("async")) {
              item.isCalledBy.forEach({
                this.markAsyncFromVariant( item visited ctx)
              })
              item.forOtherVersions( ctx {
                this.markAsyncFromVariant( item visited ctx)
              })
              if( !null? item.insideFn) {
                this.markAsyncFromVariant( (unwrap item.insideFn ) visited ctx)
              }
            }
          }
          item.myLambdas.forEach({
            if( (!null? item.nameNode) ) {
              if(item.nameNode.hasFlag("async")) {
                item.isCalledBy.forEach({
                  this.markAsyncFromVariant( item visited ctx)
                })
                if( !null? item.insideFn) {
                  this.markAsyncFromVariant( (unwrap item.insideFn ) visited ctx)
                }
              }
            }            
          })
        })
      })
    })

    def notUsedFunctionCnt 0

    root.definedClasses.forEach({
      item.method_variants.forEach({
        item.variants.forEach({
          if( (size item.isCalledBy ) == 0 ) {
            if( !null? item.container_class) {
              def cc (unwrap item.container_class)
              if( (has cc.extends_classes ) || cc.is_inherited )  {
                ; `is_inherited` alone reaches here with an EMPTY list, and the
                ; read below is index 0. On JavaScript that gives undefined and
                ; findClass shrugs; on a target where an out-of-range read is an
                ; error it stopped the compile with no diagnostic.
                if( has cc.extends_classes ) {
                  def eC (at cc.extends_classes 0)
                  ctx.findClass( eC )
                }
                ; not sure if this function is necessary or not...
              } {
                ; print " unused function " + item.name + " in class " + item.container_class.name
                notUsedFunctionCnt = notUsedFunctionCnt + 1
                item.is_unsed = true
              }
            } 
          }
        })
      })
    })

    def use_dce false
    if(ctx.hasCompilerFlag('dead4main')) {
      def mainFn:RangerAppFunctionDesc
      root.definedClasses.forEach({
        def cl item
        for cl.static_methods variant@(lives):RangerAppFunctionDesc i {
          ctx.disableCurrentClass()
            def variantName:CodeNode (unwrap variant.nameNode)
            def variantSource:SourceCode (unwrap variantName.code)
            if ( (variantName.hasFlag("main")) && (variantSource.filename == (ctx.getRootFile()))) {  
            mainFn = variant
            mainFn.addClassUsage( cl ctx )
          }
        }
      })
      if(!null? mainFn) {
        this.markCalledFromMain( (unwrap mainFn) ctx)
        use_dce = true
      }
    }
    if(ctx.hasCompilerSetting('dceclass')) {
      def dc (ctx.getCompilerSetting('dceclass'))
      print "DCE : " + dc
      root.definedClasses.forEach({
        def cl item
        if(cl.name == dc) {
          use_dce = true
          cl.is_used_by_main = true
          for cl.static_methods variant@(lives):RangerAppFunctionDesc i {
            this.markCalledFromMain( variant ctx)
          }
          item.method_variants.forEach({
            item.variants.forEach({
              this.markCalledFromMain(item ctx)
            })
          })          
        }
      })
    }

    if use_dce {
      def verbose (ctx.hasCompilerFlag('verbose'))
      root.definedClasses.forEach({
        if( item.is_used_by_main == false && verbose ) {
          print "class not used by main : " + item.name
        }
        item.static_methods = (filter item.static_methods {
          def cc (unwrap item.container_class)
          if( item.is_called_from_main == false ) {
            if verbose {
              print "removing as dead " + item.name + " from " + cc.name
            }
          }
          return item.is_called_from_main
        })        
        item.method_variants.forEach({
          item.variants = (filter item.variants {
            def cc (unwrap item.container_class)
            if( item.is_called_from_main == false ) {
              if verbose {
                print "removing as dead " + item.name + " from " + cc.name
              }
            }
            return item.is_called_from_main
          })
        })
      })      
    }
    
    if(ctx.hasCompilerFlag('deadcode')) {
      root.definedClasses.forEach({
        item.method_variants.forEach({
          item.variants = (filter item.variants {
            return (item.is_unsed == false)
          })
        })
      })
    }
  }

  fn matchMethodCall@(optional):RangerAppFunctionDesc (cl:RangerAppClassDesc methodName:string callArgs:CodeNode ctx:RangerAppWriterContext wr:CodeWriter errNode:CodeNode) {
    def noMatch@(optional):RangerAppFunctionDesc
    if (cl.hasMethod(methodName) == false) {
      return noMatch
    }
    def mVs@(optional):RangerAppMethodVariants (get cl.method_variants methodName)
    if (null? mVs) {
      return noMatch
    }
    def variants:RangerAppMethodVariants (unwrap mVs)
    def argCnt (size callArgs.children)
    def picked@(optional):RangerAppFunctionDesc
    def matchCnt 0
    for variants.variants variant:RangerAppFunctionDesc i {
      if ((size variant.params) != argCnt) {
        continue
      }
      def sigOk true
      def pi 0
      while (pi < argCnt) {
        def param:RangerAppParamDesc (at variant.params pi)
        def argNode:CodeNode (at callArgs.children pi)
        if (this.areEqualTypes((unwrap param.nameNode) argNode ctx wr) == false) {
          sigOk = false
          break
        }
        pi = (+ pi 1)
      }
      if (sigOk == false) {
        continue
      }
      matchCnt = (+ matchCnt 1)
      picked = variant
    }
    if (matchCnt == 0) {
      ctx.addError(errNode ("No matching overload for method \"" + methodName + "\" on " + cl.name))
      return noMatch
    }
    if (matchCnt > 1) {
      ctx.addError(errNode ("Ambiguous overload for method \"" + methodName + "\" on " + cl.name))
      return noMatch
    }
    def outMatch@(optional):RangerAppFunctionDesc
    outMatch = (unwrap picked)
    return outMatch
  }

  fn cmdCall:boolean (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    
    def obj (node.getSecond())
    def method (node.getThird())
    def callArgs (at node.children 3)

;    print "PARAMS : " + (callArgs.getCode())
;    this.ModernSyntax( callArgs ctx wr true)
;    print "AFTER WALK : " + (callArgs.getCode())
;    this.WalkNode( callParams subCtx wr)

    ; test if the method could be operator
    ; (call 4 + (5))
    def possible_cmd method.vref
    ; def op_list (ctx.getOperators(possible_cmd))
    ; for op_list cmd:CodeNode i {

      def altVersion ( node.newExpressionNode() )
      def origCopy  ( node.copy() )

      altVersion.add( (node.newVRefNode( possible_cmd)) )
      altVersion.add( (obj.copy()) )      
      for callArgs.children ca:CodeNode i {
        altVersion.add( (ca.copy()) )
      }
      altVersion.parent = node
      node.getChildrenFrom( altVersion )
      if ( this.stdParamMatch(node ctx wr false) ) {
        return true
      } {
        ; no match
        node.getChildrenFrom( origCopy )
      }
    ; }

    ; refresh the variables...
    def obj (node.getSecond())
    def method (node.getThird())
    def callArgs (at node.children 3)

    this.WalkNode( obj ctx wr ) 

    if ( (ctx.isDefinedClass(obj.eval_type_name) == false) && (!null? obj.clDesc) ) {
      def objectClass:RangerAppClassDesc (unwrap obj.clDesc)
      obj.eval_type_name = objectClass.name
    }

    ctx.setInExpr()
    for callArgs.children callArg:CodeNode i {
      this.WalkNode( callArg ctx wr)
    }
    ctx.unsetInExpr()

    if(ctx.isDefinedClass(obj.eval_type_name)) {
      def cl (ctx.findClass(obj.eval_type_name))
      def m@(optional):RangerAppFunctionDesc
      if (cl.hasMethod(method.vref)) {
        def mVs@(optional):RangerAppMethodVariants (get cl.method_variants method.vref)
        if (!null? mVs) {
          def variants:RangerAppMethodVariants (unwrap mVs)
          if ((size variants.variants) > 0) {
          m = (this.matchMethodCall(cl method.vref callArgs ctx wr node))
          if (null? m) {
            return false
          }
          }
        }
      }
      if (null? m) {
        m = (cl.findMethod(method.vref))
        if (null? m) {
          m = (cl.findMethodByCompiledName(method.vref))
        }
      }
      if(!null? m) {
        def methodDesc:RangerAppFunctionDesc (unwrap m)
        def nn:CodeNode (unwrap methodDesc.nameNode)
        node.has_call = true
        node.fnDesc = methodDesc

        def currM (ctx.getCurrentMethod())
        currM.addCallTo(methodDesc)
        node.eval_type = (nn.typeNameAsType(ctx))
        node.eval_type_name = nn.type_name
        node.eval_array_type = nn.array_type
        node.eval_key_type = nn.key_type
        if(nn.hasFlag("throws")) {
          if(false == (ctx.isTryBlock()) ) {
            ctx.addError(obj ('The method ' + methodDesc.name + " potentially throws an exception, try { } block is required"))
          }
        }              
        if(nn.value_type == RangerNodeType.ExpressionType) {
          node.expression_value = (nn.expression_value.copy())
        }
        if(nn.hasFlag("optional")) {
          node.setFlag("optional")
        }        
        return true
      } {
        ctx.addError(node ('Class ' + obj.eval_type_name + ' does not have method ' + method.vref))
        return false
      }
    } {
      ctx.addError( node ('can not call non-class type'))
    }
    return true
  }  
 
  ; getAnon:(_:string ( n:string )) () 
  ; (fn:string (nn:string) {
  fn matchLambdaArgs:boolean (n1:CodeNode n2:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def chLen1 (size n1.children)
    def chLen2 (size n2.children)
    if(chLen1 < 2) {
      ctx.addError(n1 "Invalid Lambda definition, missing args or return value")
      ctx.addError(n2 "^ Invalid Lambda definition, missing args or return value")
      return false
    }
    if(chLen2 < 2) {
      ctx.addError(n1 "Invalid Lambda definition, missing args or return value")
      ctx.addError(n2 "^ Invalid Lambda definition, missing args or return value")
      ; print "--> error " + (n1.getCode()) + ", " + (n2.getCode())
      return false
    }
    ; create copies, just in case...
    def rv1 (n1.getFirst())
    def args1 (n1.getSecond())
    def rv2 (n2.getFirst())
    def args2 (n2.getSecond())

    def rvExpr1 (n1.newExpressionNode())
    rvExpr1.push( (rv1.copy()) )
    def rvExpr2 (n2.newExpressionNode())
    rvExpr2.push( (rv2.copy()) )

    def argsExpr1 (args1.copy())
    def argsExpr2 (args2.copy())

    def all_matched true

    ; to work around typescript bug
    if(ctx.hasCompilerFlag('notreallyexistingflag')) {
      all_matched = false
    }

    if( (size argsExpr1.children) != (size argsExpr2.children) ) {
      ctx.addError(n2 "Invalid parameter count for the lambda expression")
      return false
    }

    argsExpr1.children.forEach({
      def item2 (at argsExpr2.children index)
      if ( item2.value_type != item.value_type ) {
        all_matched = false
      }
      if ( item2.type_name != item.type_name ) {
        all_matched = false
      }
      if ( item2.array_type != item.array_type ) {
        all_matched = false
      }
      if ( item2.key_type != item.key_type ) {
        all_matched = false
      }
      if ( all_matched && item.value_type == RangerNodeType.ExpressionType ) {
       if( false == (this.matchLambdaArgs( (unwrap item.expression_value) (unwrap item2.expression_value) ctx wr) ) ) {
         all_matched = false
       }
      }
    })
    if( all_matched == false) {
      ctx.addError(n2 "Invalid lambda argument types")
      return false
    }

    rvExpr1.children.forEach({
      def item2 (at rvExpr2.children index)
      if ( item2.value_type != item.value_type ) {
        all_matched = false
      }
      if ( item2.type_name != item.type_name ) {
        all_matched = false
      }
      if ( item2.array_type != item.array_type ) {
        all_matched = false
      }
      if ( item2.key_type != item.key_type ) {
        all_matched = false
      }
      if ( all_matched && item.value_type == RangerNodeType.ExpressionType ) {
       if( false == (this.matchLambdaArgs( (unwrap item.expression_value) (unwrap item2.expression_value) ctx wr) ) ) {
         all_matched = false
       }
      }
    })

    if(ctx.hasCompilerFlag('notreallyexistingflag')) {
      all_matched = false
    }
    if( all_matched == false) {
      ctx.addError(n2 "Invalid lambda return value type")
      return false
    }     
    return true
  }

  fn testLambdaCallArgs:boolean ( lambda_expression:CodeNode callParams:CodeNode ctx:RangerAppWriterContext wr:CodeWriter ) {
    def lambdaDef (at lambda_expression.children 0)
    def lambdaArgs (at lambda_expression.children 1)
    def all_matched true
    if( (size callParams.children) != (size lambdaArgs.children) ) {
      ctx.addError(callParams "Invalid parameter count for the lambda expression " )
      ctx.addError(callParams (' ^ expected : ' + (lambdaArgs.getCode()) ) )
;      ctx.addError(node (' ^ definition : ' + (d.nameNode.getParsedString()) ) )
      all_matched = false
    }
    lambdaArgs.children.forEach({
      def item2 (at callParams.children index)
      if ( item2.eval_type_name != item.type_name ) {
        ; missing: union types handling
        if( item.type_name != 'Any' ) {
          ctx.addError( item2 ( 'Argument of wrong type given for the lambda parameter ' + index))
          all_matched = false
        }
      }
      if ( item2.eval_array_type != item.array_type ) {
        ctx.addError( item2 ( 'Argument of wrong type given for the lambda parameter ' + index))
        all_matched = false
      }
      if ( item2.eval_key_type != item.key_type ) {
        ctx.addError( item2 ( 'Argument of wrong type given for the lambda parameter ' + index))
        all_matched = false
      }
    })
    if( all_matched == false) {
      ctx.addError(callParams "Invalid types for lambda call")
    }
    return all_matched
  }

  fn cmdLocalCall:boolean (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def fnNode@(lives):CodeNode (node.getFirst())
    def udesc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
    def desc:RangerAppClassDesc (unwrap udesc)
    def expects_error:boolean false
    def err_cnt:int (ctx.getErrorCount())
    if( node.hasBooleanProperty("error")) {
      expects_error = true
    } 
    ; print "childnode count : " + (size node.children)
    ; collect also the chain here..

    ; obj.foo() .bar() .foor2()
    ; --> obj.foo() will be the innerNode...


    def chlen (size node.children)

    if( chlen > 2) {
      def i 2
      def chainRoot:CodeNode (node)
      def innerNode@(weak):CodeNode
      def newNode (node.newExpressionNode())
      def sc (node.getSecond())
      newNode.add( (fnNode.copy()) )
      newNode.add( (sc.copy()) )
      innerNode = newNode

;       print "Chaining " + (node.getCode())

      def chain_cnt 0
      def b_valid true
      ; push the first into bottom of stack
      ; obj.foo.something ()
      while ( i < (chlen - 1) ) {
        def fc (at node.children i)
        def args@(lives) (at node.children (i + 1))
        def name (fc.vref)
        if( ( (strlen name) > 0 ) && ( ( charAt name 0) == (charcode ".")) ) {
          def method_name (substring name 1 (strlen name))
          def newNode (node.newExpressionNode())
          newNode.add( (node.newVRefNode("call") ) ) 
          newNode.add( (innerNode.copy() ) )
          newNode.add( (node.newVRefNode(method_name)) )
          newNode.add( (args.copy()))
          innerNode = newNode
          chain_cnt = chain_cnt + 1
        } {
          b_valid = false
          ; ctx.addError(node "Invalid chaining op")
        }
        i = i + 2
      }
      if ( b_valid && (chain_cnt > 0 ) ) {
        node.getChildrenFrom( (unwrap innerNode ) )
        node.finalizeAsCallChainRoot()
        node.flow_done = false
        this.WalkNode( node ctx wr)
        return true
      }
    }

    if ((size fnNode.ns) > 1) {

      def rootName (at fnNode.ns 0)
      this.checkInitializedObjectReceiver(rootName node ctx)
      def vFnDef@(optional):RangerAppFunctionDesc (this.findFunctionDesc(fnNode ctx wr))

      if (!null? vFnDef) {

        ; -inline-statics: a trivial static forwarder expands into its body
        ; here instead of becoming a call
        if( ctx.hasCompilerFlag("inline-statics") ) {
          if( this.tryInlineTrivialStatic( node fnNode (unwrap vFnDef) ctx wr ) ) {
            return true
          }
        }

        if(vFnDef.nameNode.hasFlag("throws")) {
          if(false == (ctx.isTryBlock()) ) {
            ctx.addError(node ('The method ' + vFnDef.name + " potentially throws an exception, try { } block is required"))
          }
        }

        def currM@(lives) (ctx.getCurrentMethod())
        currM.addCallTo( (unwrap vFnDef) )


        vFnDef.ref_cnt = (vFnDef.ref_cnt + 1)
        def subCtx:RangerAppWriterContext (ctx.fork())
        node.hasFnCall = true
        node.fnDesc = vFnDef
        def p@(lives):RangerAppParamDesc (new RangerAppParamDesc ())
        p.name = fnNode.vref
        p.value_type = fnNode.value_type
        p.node = fnNode
        p.nameNode = fnNode
        p.varType = RangerContextVarType.Function
        subCtx.defineVariable(p.name p)
        this.WalkNode(fnNode subCtx wr)
        def callParams:CodeNode (at node.children 1)
        def keyword_cnt 0 
        vFnDef.params.forEach({
          if(item.nameNode.hasFlag('keyword')) {
            keyword_cnt = keyword_cnt + 1
            ( (at callParams.children index) .setFlag('keyword'))
          }
        })
        def nodeList:[CodeNode] (this.transformParams( callParams.children vFnDef.params subCtx))
        if(ctx.hasCompilerFlag('dbg')) {
          print "Local: " + vFnDef.name
        }
              
        for nodeList arg:CodeNode i {
          ; expression as parameter is a lambda 
          ctx.setInExpr()
          def was_lambda false
          if(arg.isFirstVref("fun")) {
            arg.flow_done = false
            arg.forTree({
              item.flow_done = false
            })
            was_lambda = true
          }       
          this.WalkNode(arg subCtx wr)

          if was_lambda {
            def currM@(lives) (ctx.getCurrentMethod())
            if(!null? arg.lambdaFnDesc) {
              vFnDef.addCallTo( (unwrap arg.lambdaFnDesc))
              currM.addCallTo( (unwrap vFnDef ) )
              push currM.myLambdas (unwrap arg.lambdaFnDesc)
              push vFnDef.myLambdas (unwrap arg.lambdaFnDesc)
            }
            arg.forTree({
              if(!null? item.lambdaFnDesc) {
                def nestedLambda:RangerAppFunctionDesc (unwrap item.lambdaFnDesc)
                nestedLambda.insideFn = currM
              }
              if(!null? item.fnDesc) {
                if(!null? arg.lambdaFnDesc) {
                  arg.lambdaFnDesc.addCallTo( (unwrap item.fnDesc) )
                } 
                vFnDef.addCallTo( (unwrap item.fnDesc ) )
              }
            })
          }       
          ctx.unsetInExpr()
          if( (size vFnDef.params) > i) {
            def fnArg:RangerAppParamDesc (at vFnDef.params i)
            def callArgP:RangerAppParamDesc arg.paramDesc
            if (!null? callArgP) {
              ; a descriptor passed to its own parameter slot is the same
              ; object on both sides, and moving a reference to itself says
              ; nothing. Rust cannot read it while holding it for the write.
              def callArgD:RangerAppParamDesc (unwrap arg.paramDesc)
              def sameSlot:boolean (fnArg == callArgD)
              if (sameSlot == false) {
                callArgP.moveRefTo(node fnArg ctx)
              }
            }
          }
        }
        def cp_len:int ( (size callParams.children) - keyword_cnt )
        if( cp_len > ( size vFnDef.params )) {
          def lastCallParam:CodeNode (at callParams.children (cp_len - 1))
          ctx.addError( lastCallParam "Too many arguments for function")
          ctx.addError( (unwrap vFnDef.nameNode) "NOTE: To fix the previous error: Check original function declaration which was")
        }
        for vFnDef.params param:RangerAppParamDesc i {
          if( (size callParams.children) <= i) {
            if (param.nameNode.hasFlag("default")) {
              continue 
            }
            ctx.addError(node "Missing arguments for function")
            ctx.addError( (unwrap param.nameNode) "NOTE: To fix the previous error: Check original function declaration which was")
            break
          }
          if( param.nameNode.hasFlag('keyword')) {
            continue
          }
          def argNode:CodeNode (at callParams.children i)
          if (false == (this.areEqualTypes( (unwrap param.nameNode) argNode ctx wr))) {
            ctx.addError(argNode ('ERROR, invalid argument type for method ' + vFnDef.name))
          }
          def pNode:CodeNode (unwrap param.nameNode)
          if( pNode.hasFlag('optional')) {
            if ( false == (argNode.hasFlag('optional')) ) {
               ctx.addError(node ( 'function parameter optionality does not match, consider making parameter optional ' + (argNode.getCode())) )          
            }
          }
          if( argNode.hasFlag('optional')) {
            if ( false == (pNode.hasFlag('optional')) ) {
               ctx.addError(node ( 'function parameter optionality does not match, consider unwrapping ' + (argNode.getCode())) )          
            }
          }
        }
        def nn:CodeNode vFnDef.nameNode
        node.eval_type = (nn.typeNameAsType(ctx))
        node.eval_type_name = nn.type_name
        node.eval_array_type = nn.array_type
        node.eval_key_type = nn.key_type

        if(node.eval_type == RangerNodeType.ExpressionType) {
          node.expression_value = (nn.expression_value.copy())
        }

        if(nn.hasFlag("optional")) {
          node.setFlag("optional")
        }

        if(expects_error) {
          def cnt_now:int (ctx.getErrorCount())
          if (cnt_now == err_cnt) {
            ctx.addParserError( node "LANGUAGE_PARSER_ERROR: expected generated error, err counts : " + err_cnt + " : " +cnt_now)
          }
        } {
          def cnt_now:int (ctx.getErrorCount())
          if (cnt_now > err_cnt) {
            ctx.addParserError( node "LANGUAGE_PARSER_ERROR: did not expect generated error, err counts : " + err_cnt + " : " +cnt_now)
          }      
        }
        return true
      } {
        ctx.addError(node "Called Object or Property was not defined")
      }
    }
    if (desc.hasMethod(fnNode.vref)) {
      def fnDescr@(optional):RangerAppFunctionDesc (desc.findMethod(fnNode.vref))


      if(fnDescr.nameNode.hasFlag("throws")) {
        if(false == (ctx.isTryBlock()) ) {
          ctx.addError(node ('The method ' + fnDescr.name + " potentially throws an exception, try { } block is required"))
        }
      }

      def currM (ctx.getCurrentMethod())
      currM.addCallTo( (unwrap fnDescr) )

      if(ctx.hasCompilerFlag('dbg')) {
        print "Local 2 : " + fnDescr.name
      }


      def subCtx:RangerAppWriterContext (ctx.fork())
      node.hasFnCall = true
      node.fnDesc = fnDescr
      def p@(lives):RangerAppParamDesc (new RangerAppParamDesc ())
      p.name = fnNode.vref
      p.value_type = fnNode.value_type
      p.node = fnNode
      p.nameNode = fnNode
      p.varType = RangerContextVarType.Function
      subCtx.defineVariable(p.name p)
      this.WalkNode(fnNode subCtx wr)
      for node.children arg:CodeNode i {
        if (i < 1) {
          continue _
        }
        ctx.setInExpr()
        this.WalkNode(arg subCtx wr)
        ctx.unsetInExpr()
      }
      for fnDescr.params param:RangerAppParamDesc i {
        if( (size node.children) <= (i + 1)) {
          ctx.addError(node "Argument was not defined")
          break
        }
                
        def argNode:CodeNode (at node.children (i + 1))
        if (false == (this.areEqualTypes( (unwrap param.nameNode) argNode ctx wr))) {
          ctx.addError(argNode ('ERROR, invalid argument type for ' + desc.name + ' method ' + fnDescr.name))
        }
      }
      def nn:CodeNode fnDescr.nameNode
      nn.defineNodeTypeTo(node ctx)
      if(expects_error) {
        def cnt_now:int (ctx.getErrorCount())
        if (cnt_now == err_cnt) {
          ctx.addParserError( node "LANGUAGE_PARSER_ERROR: expected generated error, err counts : " + err_cnt + " : " +cnt_now)
        }
      } {
        def cnt_now:int (ctx.getErrorCount())
        if (cnt_now > err_cnt) {
          ctx.addParserError( node "LANGUAGE_PARSER_ERROR: did not expect generated error, err counts : " + err_cnt + " : " +cnt_now)
        }      
      }      
      return true
    } 

    ; TODO: first lambda call check comes here... continue to other variants later
    if (ctx.isVarDefined(fnNode.vref)) {
        def d (ctx.getVariableDef(fnNode.vref))
        def lambdaName:CodeNode (unwrap d.nameNode)

        d.ref_cnt = (1 + d.ref_cnt)

        if( lambdaName.hasFlag('optional')) {
          ctx.addError( node 'Can not call optional lambda function, unwrap the function first!')
        }

        if(lambdaName.value_type == RangerNodeType.ExpressionType) {

          def cnNode1 (at node.children 0)
          this.WalkNode(cnNode1 ctx wr)

          def lambdaExpr:CodeNode (unwrap lambdaName.expression_value)
          def lambdaDefArgs (at lambdaExpr.children 1)
          def callParams:CodeNode (at node.children 1)
          
          for callParams.children arg:CodeNode i {
            ctx.setInExpr()
            this.WalkNode(arg ctx wr)
            ctx.unsetInExpr()
          }

          this.testLambdaCallArgs(lambdaExpr callParams ctx wr)

          def lambdaDef (at lambdaExpr.children 0)
          node.has_lambda_call = true
          node.eval_type = (lambdaDef.typeNameAsType(ctx))
          node.eval_type_name = lambdaDef.type_name
          node.eval_array_type = lambdaDef.array_type
          node.eval_key_type = lambdaDef.key_type

          if(node.eval_type == RangerNodeType.ExpressionType) {
            if(!null? lambdaDef.expression_value) {
              node.expression_value = (lambdaDef.expression_value.copy())
            }
          }
        
          return true
        })
    }
    ; Everything that used to follow the `return false` above was unreachable
    ; -- an error report and an expects_error check that no run could ever
    ; reach. Dead on every target; javac is the only one that says so.
    return false
  }

  ; obj.firstChild.name = "name of firstChild"
  ; obj = (call obj set_firstChild ( (call obj.firstChild set_name ("name of firstChild")) ))
  fn transformImmutableAssigment:CodeNode (node:CodeNode) {

    def target (node.getSecond())         ;  obj.firstChild.name
    def assign_value (node.getThird())    ; "name of firstChild"
    def root (node.newExpressionNode())

    root.add( (node.newVRefNode("=")))
    root.add( (node.newVRefNode( (at target.ns 0)  ))) ; obj

    def i 1
    def cnt (size target.ns)
    def valueExpression (node.newExpressionNode())
    def obj_ref (at target.ns 0)
    def currentParent@(weak temp) root
    while( i < cnt ) {
      def callExpr@(lives) (node.newExpressionNode())  
      callExpr.add( (node.newVRefNode("call")))
      callExpr.add( (node.newVRefNode(obj_ref)))
      def next_ref (at target.ns (i))
      def set_ref ("set_" + next_ref )
      callExpr.add( (node.newVRefNode(set_ref)))       
      i = i + 1
      if( i < cnt ) {
        obj_ref = obj_ref + "." + next_ref
        def paramsNode (node.newExpressionNode())
        paramsNode.add(callExpr)
        currentParent.add( paramsNode )  
        currentParent = callExpr      
      } {
        def callParams (node.newExpressionNode())
        callParams.add((assign_value.copy()))
        callExpr.add( callParams )
        def paramsNode (node.newExpressionNode())
        paramsNode.add( (callExpr.copy()) )
        currentParent.add( paramsNode )          
      }
    }
    return root
  }

  fn transformDotMethodCallExpr:boolean (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if( (size node.children) == 2) {
      def fc (node.getFirst())
      def sec (node.getSecond())
      def dotNode:CodeNode sec
      def mArgs:CodeNode
      if( (has sec.vref) && ( (strlen sec.vref) > 0 ) ) {
        if ( (first sec.vref) == '.' ) {
          ; `o.m` with nothing after it has no argument list to take: getSecond
          ; answers nothing, and copying that nothing is a null dereference off
          ; JavaScript. An absent list is an EMPTY one, which is what the other
          ; branch of this same `if` already builds.
          if ( (size sec.children) > 1 ) {
            mArgs = (sec.getSecond())
          } {
            mArgs = (node.newExpressionNode())
          }
        } {
          return false
        }
      } {
        if( (size sec.children) < 1 ) {
          return false
        }
        dotNode = (sec.getFirst())
        if( (has dotNode.vref) == false ) {
          return false
        }
        if ( (first dotNode.vref) != '.' ) {
          return false
        }
        if ( (size sec.children) > 1 ) {
          mArgs = (sec.getSecond())
        } {
          mArgs = (node.newExpressionNode())
        }
      }
      def method_name (substring dotNode.vref 1 (strlen dotNode.vref))
      ; The receiver is copied BEFORE it is walked, and the copy is what the
      ; rewritten call gets. Walking an array literal REPLACES the node's
      ; children with its elements and marks the node with is_array_literal;
      ; a copy carries the new children but not the mark, which is not an array
      ; literal any more but a bare list of its elements -- `b.take("a""b")`,
      ; which does not parse, and `b.take("a")` for one element, which does and
      ; is silently wrong (ISSUES.md #85). The unwalked copy is re-analysed by
      ; the walk below and comes out whole.
      def preWalkFc (fc.copy())
      this.WalkNode( fc ctx wr )
      if( ctx.isDefinedClass(fc.eval_type_name) ) {
        def callNode (node.newExpressionNode())
        callNode.add( (node.newVRefNode("call")) )
        callNode.add( preWalkFc )
        callNode.add( (node.newVRefNode(method_name)) )
        callNode.add( (mArgs.copy()) )
        node.getChildrenFrom( callNode )
        node.flow_done = false
        this.WalkNode( node ctx wr)
        return true
      }
      return false
    }
    if( (size node.children) != 3) {
      return false
    }
    def fc (node.getFirst())
    def sec (node.getSecond())
    def third (node.getThird())
    if( (has sec.vref) == false) {
      return false
    }
    if ( (first sec.vref) != '.' ) {
      return false
    }
    ; Copied before the walk, for the reason given in the branch above.
    def preWalkChainFc (fc.copy())
    this.WalkNode( fc ctx wr )
    if( (ctx.isDefinedClass(fc.eval_type_name)) == false) {
      return false
    }
    def parts (strsplit (substring sec.vref 1) ".")
    def method_name (last parts)
    def classDesc (ctx.findClass(fc.eval_type_name))
    def calledItem preWalkChainFc

    parts.forEach({
      if(index < ((size parts) - 1) ) {
          try {
            calledItem = (r.expression 
                            (r.vref 'property')
                            (calledItem.copy())
                            (r.vref item)
                        )
            ; findVariable answers nothing for a property the class does not
            ; have. The `try` around this only catches a raised `unwrap`, and a
            ; plain field read is not one -- on JavaScript the TypeError happens
            ; to land in the same handler, everywhere else it is a crash.
            def p@(optional):RangerAppParamDesc (classDesc.findVariable(item))
            if (null? p) {
              ctx.addError(sec ('invalid property ' + item))
              return
            }
            def pDesc:RangerAppParamDesc (unwrap p)
            if (null? pDesc.nameNode) {
              ctx.addError(sec ('invalid property ' + item))
              return
            }
            def propertyName:CodeNode (unwrap pDesc.nameNode)
            classDesc = (ctx.findClass(propertyName.type_name))
          } {
            ctx.addError(sec ('invalid property ' + item ))
          }
      }
    })

    def calledItem (r.expression 
                    (r.vref 'call')
                    calledItem
                    (r.vref method_name)
                    (third.copy())
                   )
    node.getChildrenFrom( calledItem )
    node.flow_done = false
    this.WalkNode( node ctx wr)
    return true
  }

  fn repairUnaryMinusExpr:void (node:CodeNode) {
    def chCnt (size node.children)
    if (chCnt != 2) {
      return
    }
    def fc (node.getFirst())
    if (fc.vref != "-") {
      return
    }
    def operand:CodeNode (at node.children 1)
    def zero:CodeNode (CodeNode.newInt(0))
    def minus:CodeNode (fc.copy())
    clear node.children
    push node.children zero
    push node.children minus
    push node.children (operand.copy())
    node.expression = true
    node.flow_done = false
    for node.children ch@(lives):CodeNode i {
      ch.flow_done = false
    }
  }

  fn repairAssignUnaryMinusRhs:void (node:CodeNode) {
    def chCnt (size node.children)
    if (chCnt != 4) {
      return
    }
    def fc (node.getFirst())
    if (fc.vref != "=") {
      return
    }
    def mid:CodeNode (at node.children 2)
    if (mid.vref != "-") {
      return
    }
    def operand:CodeNode (at node.children 3)
    def rhs:CodeNode (node.newExpressionNode())
    def zero:CodeNode (CodeNode.newInt(0))
    push rhs.children zero
    push rhs.children (mid.copy())
    push rhs.children (operand.copy())
    removeLast node.children
    removeLast node.children
    push node.children rhs
    node.flow_done = false
    rhs.flow_done = false
  }

  fn repairAssignMethodCallRhs:void (node:CodeNode) {
    this.repairAssignUnaryMinusRhs(node)
    def chCnt (size node.children)
    if (chCnt < 4) {
      if ((size node.children) > 2) {
        def fc (node.getFirst())
        if ((fc.vref == "=") || (fc.vref == "def")) {
          def rhsNode:CodeNode (at node.children 2)
          this.repairUnaryMinusExpr(rhsNode)
        }
      }
      return
    }
    def fc (node.getFirst())
    def rhsStart:int 0
    if (fc.vref == "=") {
      rhsStart = 2
    } {
      if (fc.vref == "def") {
        rhsStart = 2
      } {
        return
      }
    }
    ; The infix parser flattens a method-call RHS into siblings of '=' / 'def',
    ; e.g. (= lhs this.flag ()) instead of (= lhs (this.flag ())).
    ; Re-wrap everything after the name (and type) into a single expression node.
    def rhs (node.newExpressionNode())
    def i:int rhsStart
    while (i < chCnt) {
      def child:CodeNode (itemAt node.children i)
      rhs.add( (child.copy()) )
      i = i + 1
    }
    while ( (size node.children) > rhsStart ) {
      removeLast node.children
    }
    push node.children rhs
    node.flow_done = false
    rhs.flow_done = false
    for rhs.children ch:CodeNode ci {
      ch.flow_done = false
    }
    if ((size node.children) > rhsStart) {
      def rhsNode:CodeNode (at node.children rhsStart)
      this.repairUnaryMinusExpr(rhsNode)
    }
  }

  fn checkInitializedObjectReceiver:void (receiverName:string node:CodeNode ctx:RangerAppWriterContext) {
    if (receiverName == "this") {
      return
    }
    if (false == (ctx.isVarDefined(receiverName))) {
      return
    }
    if (ctx.isDefinedClass(receiverName)) {
      return
    }
    def vDef:RangerAppParamDesc (ctx.getVariableDef(receiverName))
    if (vDef.is_class_variable) {
      return
    }
    if (vDef.varType == RangerContextVarType.FunctionParameter) {
      return
    }
    if (null? vDef.nameNode) {
      return
    }
    def nameN:CodeNode (unwrap vDef.nameNode)
    if (false == (ctx.isDefinedClass(nameN.type_name))) {
      return
    }
    if ((vDef.init_cnt == 0) && (vDef.set_cnt == 0)) {
      ctx.addError(node ("Use of uninitialized object " + receiverName))
    }
  }

  fn cmdAssign:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {

    this.repairAssignMethodCallRhs(node)
    def target:CodeNode (node.getSecond())

    ; C5: assign through a group field projection before walking the dotted
    ; path (which would otherwise fail — group unions have no variables).
    if (((array_length target.ns) == 2) && (ctx.isVarDefined((at target.ns 0)))) {
      def gRoot:string (at target.ns 0)
      def gField:string (at target.ns 1)
      def gRootDef:RangerAppParamDesc (ctx.getVariableDef(gRoot))
      if (!null? gRootDef.nameNode) {
        def rootName:CodeNode (unwrap gRootDef.nameNode)
        if ((strlen rootName.type_name) > 0) {
        def gType:string rootName.type_name
        if (this.shapeGroupHasField(gType gField)) {
          if (has shapeGroupAllValue gType) {
            if (unwrap (get shapeGroupAllValue gType)) {
              ctx.addError(node (("cannot assign to a field of group " + gType) + ": its members are @(value) cases and immutable"))
              return
            }
          }
          def rhsNode:CodeNode (node.getThird())
          def opsName:string (gType + "__ops")
          def callNode:CodeNode (node.newExpressionNode())
          def opsRef:CodeNode (node.newVRefNode((opsName + ".set_") + gField))
          clear opsRef.ns
          push opsRef.ns opsName
          push opsRef.ns (("set_" + gField))
          def args:CodeNode (node.newExpressionNode())
          push args.children (node.newVRefNode(gRoot))
          push args.children (rhsNode.copy())
          push callNode.children opsRef
          push callNode.children args
          node.expression = true
          node.flow_done = false
          node.value_type = RangerNodeType.NoType
          node.getChildrenFrom(callNode)
          this.WalkNode(node ctx wr)
          return
        }
        }
      }
    }

    this.WalkNode(target ctx wr)

    ; S4: a @(value) case compares by CONTENT, so its fields must not change
    ; after construction — otherwise two values that compared equal can drift
    ; apart, and a target that copies the case (S5) and one that shares it stop
    ; agreeing about what the program does.
    if ((array_length target.nsp) > 0) {
      if ((array_length target.ns) > 1) {
        ; nsp[0] is the ROOT of the path: `a.value = …` assigns through `a`
        def valDesc:RangerAppParamDesc (itemAt target.nsp 0)
        def valNN@(optional):CodeNode valDesc.nameNode
        if (!null? valNN) {
          def valNode:CodeNode (unwrap valNN)
          if (has caseIsValue valNode.type_name) {
            if (unwrap (get caseIsValue valNode.type_name)) {
              def valDisp:string valNode.type_name
              if (has caseDisplay valNode.type_name) {
                valDisp = (unwrap (get caseDisplay valNode.type_name))
              }
              ctx.addError(node ("cannot assign to a field of " + valDisp + ": a value case is immutable, because it compares by content — build a new one instead"))
            }
          }
        }
      }
    }

    ; immutable check which denies assigent operation
    if(target.hasParamDesc) {
      def targetDesc:RangerAppParamDesc (unwrap target.paramDesc)
      if( !null? targetDesc.propertyClass) {
        def propertyClass:RangerAppClassDesc (unwrap targetDesc.propertyClass)
        def nn (unwrap propertyClass.nameNode)
        if(nn.hasFlag("immutable")) {

          def do_transform false
          def propC:RangerAppClassDesc propertyClass
          def currC (ctx.getCurrentClass())
          if (!null? currC) {
            def currentClass:RangerAppClassDesc (unwrap currC)
            if( currentClass == propC ) {
              if( (at target.ns 0) == "this" ) {
                ; ctx.addError( node "Assigment to immutable class this variable")            
                do_transform = true
              }
            }
          } {
            ; ctx.addError( node "Assigment to immutable class node")
            do_transform = true
          }

          if do_transform {

            def n1:CodeNode (node.getSecond())
            def n2:CodeNode (node.getThird())
            this.WalkNode(n1 ctx wr)
            ctx.setInExpr()
            this.WalkNode(n2 ctx wr)
            ctx.unsetInExpr()

            this.convertToUnion( n1.eval_type_name n2 ctx wr) 
            ; --> should test here
            this.shouldBeEqualTypes( n1 n2 ctx "Can not assign variable.")

            def immAss (this.transformImmutableAssigment(node))
            ; print "immutable assigment => " + (immAss.getCode())
            node.getChildrenFrom( immAss )
            ; print "eventual assigment => " + (node.getCode())
            this.cmdAssign( node ctx wr)
            return
          } 
        }
      }
    }

    def chlen (size node.children)
    wr.newline()
    def n1:CodeNode (node.getSecond())
    def n2:CodeNode (node.getThird())
    this.WalkNode(n1 ctx wr)
    ctx.setInExpr()
    if (this.transformDotMethodCallExpr(n2 ctx wr)) {
    } {
      this.WalkNode(n2 ctx wr)
    }
    ctx.unsetInExpr()
    if n1.hasParamDesc {
      def targetDesc:RangerAppParamDesc (unwrap n1.paramDesc)
      targetDesc.ref_cnt = (targetDesc.ref_cnt + 1)
      targetDesc.set_cnt = (targetDesc.set_cnt + 1)
      ; The walk above counted the assignment TARGET as a mention. It is a
      ; write, not a read, so take it back out: `x = 1` alone must leave
      ; read_cnt at zero, while `x = x + 1` leaves it at one.
      targetDesc.read_cnt = (targetDesc.read_cnt - 1)
    }
    if n2.hasParamDesc {
      def valueDesc:RangerAppParamDesc (unwrap n2.paramDesc)
      valueDesc.ref_cnt = (valueDesc.ref_cnt + 1)
    }
    if (n2.hasFlag("optional")) {
      if (false == (n1.hasFlag("optional"))) {
        ctx.addError(node "Can not assign optional to non-optional type")
      }
    }
    ; `x = <a value>` narrows x from here on, `x = <an optional>` ends it
    if ((n1.expression == false) && ((strlen n1.vref) > 0)) {
      def target:string n1.vref
      if ((array_length n1.ns) == 1) {
        target = (itemAt n1.ns 0)
      }
      def valuePresent:boolean (false == (n2.hasFlag("optional")))
      if ((n2.expression == false) && ((strlen n2.vref) > 0)) {
        def source:string n2.vref
        if ((array_length n2.ns) == 1) {
          source = (itemAt n2.ns 0)
        }
        if (ctx.isPresentForStrict(source)) {
          valuePresent = true
        }
      }
      if valuePresent {
        ctx.setFlowNarrowed(target 2)
      } {
        ctx.setFlowNarrowed(target 0)
      }
    }
    this.stdParamMatch(node ctx wr true)
    this.convertToUnion( n1.eval_type_name n2 ctx wr) 
    this.shouldBeEqualTypes( n1 n2 ctx "Can not assign variable.")
  }
  fn EnterTemplateClass:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
  
  }

  fn EnterClass:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ; `class Foo @params(T)` is a template, not a class. Its body says `T`,
    ; which is not a type, so there is nothing here to check -- the copies
    ; made at each `Foo@(Arg)` reference are what gets checked.
    if (node.hasExpressionProperty("params")) {
      return
    }
    def body_index ( (node.chlen())  - 1)
    if( (size node.children) != 3) {
      if( (node.chlen()) == 5 ) {

      } {
        ctx.addError(node "Invalid class declaration")
        return
      }
    }
    if(node.hasBooleanProperty("trait")) {
      return
    }
    def cn:CodeNode (at node.children 1)
    def cBody:CodeNode (at node.children body_index)
    def desc@(lives):RangerAppClassDesc (ctx.findClass(cn.vref))
    def subCtx:RangerAppWriterContext (unwrap desc.ctx)

    subCtx.setCurrentClass(desc)
    subCtx.class_level_context = true
    for desc.variables p:RangerAppParamDesc i {
      def vNode:CodeNode p.node
      if ((size vNode.children) > 2) {
        def value:CodeNode (at vNode.children 2)
        ctx.setInExpr()
        this.WalkNode(value ctx wr)
        ctx.unsetInExpr()
      }
      p.is_class_variable = true
      def variableName:CodeNode (unwrap p.nameNode)
      variableName.eval_type = (variableName.typeNameAsType(ctx))
      variableName.eval_type_name = variableName.type_name
    }

    for cBody.children fNode:CodeNode i {
      if ((fNode.isFirstVref("fn")) || (fNode.isFirstVref("constructor")) || (fNode.isFirstVref("Constructor"))) {
        this.WalkNode(fNode subCtx wr)
      }
    }
    for cBody.children fNode:CodeNode i {
      if ((fNode.isFirstVref("fn")) || (fNode.isFirstVref("PublicMethod"))) {
        this.WalkNode(fNode subCtx wr)
      }
    }
    def staticCtx:RangerAppWriterContext (ctx.fork())
    staticCtx.setCurrentClass(desc)
    for cBody.children fNode:CodeNode i {
      if ((fNode.isFirstVref("sfn")) || (fNode.isFirstVref("StaticMethod")) || (fNode.isFirstVref("static"))) {
        if (fNode.isFirstVref("static")) {
          if ((fNode.chlen()) >= 2) {
            def staticCmd:string (fNode.getVRefAt(1))
            if ((staticCmd == "def") || (staticCmd == "let")) {
              continue _
            }
          }
        }
        this.WalkNode(fNode staticCtx wr)
      }
    }

    cBody.children.forEach({
      try {
        if( item.isFirstVref('doc')) {
          def sc (item.getSecond())
          def fndesc (desc.findMethod(sc.vref))
          if (fndesc) {
            def third (item.getThird())
            fndesc.git_doc = third.string_value
          }
        }
      } {

      }
    })
    node.hasClassDescription = true
    node.clDesc = desc
    desc.classNode = node
  }
  

  fn walkFunctionBody (m@(lives):RangerAppFunctionDesc fnBody:CodeNode ctx:RangerAppWriterContext subCtx:RangerAppWriterContext wr:CodeWriter) {
    def prev_fnc subCtx.function_level_context
    def prev_isfn subCtx.is_function 
    subCtx.function_level_context = true
    subCtx.is_function = true
    subCtx.currentMethod = m
    for m.params v@(lives):RangerAppParamDesc i {
      if( false == (subCtx.isVarDefined(v.name)) ) {
        subCtx.defineVariable(v.name v)
      }
      def parameterName:CodeNode (unwrap v.nameNode)
      parameterName.eval_type = (parameterName.typeNameAsType(subCtx))
      parameterName.eval_type_name = parameterName.type_name
      ctx.hadValidType(parameterName)

      if( (ctx.isDefinedClass(parameterName.type_name)) ) {
        def cl (ctx.findClass(parameterName.type_name))
        m.addClassUsage( cl ctx )
      }
      if( (ctx.isDefinedClass(parameterName.array_type)) ) {
        def cl (ctx.findClass(parameterName.array_type))
        m.addClassUsage( cl ctx )
      }      
    }
    subCtx.setInMethod()
    this.WalkNodeChildren(fnBody subCtx wr)
    subCtx.unsetInMethod()
    def methodName:CodeNode (unwrap m.nameNode)
    ; an if/else whose two blocks both return also ends every path
    if ((fnBody.didReturnAtIndex == -1) && (false == (this.blockAlwaysExits(fnBody)))) {
      if (methodName.type_name != "void") {
          if( false == (ctx.getFlag("in_task")) ) {
            ctx.addError(methodName "Function does not return any values!")
          }
      }
    } {
      if( (methodName.type_name == "void") || ( (has methodName.type_name) == false ) && ( (has methodName.array_type) == false )  ) {
        if( false == (ctx.getFlag("in_task")) ) {
          def rvNode ( at fnBody.children fnBody.didReturnAtIndex)
          if( (size rvNode.children ) > 1) {
            ctx.addError(methodName "No return value type defined for a function which returns value")
            ctx.addError( rvNode "Returning value from a function without set return value")
          }
        }
      }      
    }
    for subCtx.localVarNames n:string i {
      def p:RangerAppParamDesc (get subCtx.localVariables n)
      if (p.set_cnt > 0) {
          if(p.is_immutable) {
            ctx.addError( (unwrap p.nameNode) "Immutable variable was assigned a value")
          }        
          def defNode:CodeNode p.node
          defNode.setFlag("mutable")
          def nNode:CodeNode p.nameNode
          nNode.setFlag("mutable")
      }
    }      
;    subCtx.function_level_context = prev_fnc
;    subCtx.is_function = prev_isfn
  }

  fn EnterMethod:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def parts:RangerFnParts (this.EnterFnParts(node ctx wr))
    if (parts.ok == false) {
      return
    }
    def nameNode:CodeNode (unwrap parts.nameNode)
    def fnBody:CodeNode (unwrap parts.fnBody)
    def desc:RangerAppClassDesc (unwrap parts.desc)
    try {
      def m@(optional):RangerAppFunctionDesc
      if (null? node.fnDesc) {
      } {
        m = (cast (unwrap node.fnDesc) to:RangerAppFunctionDesc)
      }
      if (null? m) {
        m = (desc.findMethod(nameNode.vref))
      }
      if (null? m) {
        ctx.addError(node ("Error, no description for method " + nameNode.vref))
        return
      }
      def method:RangerAppFunctionDesc (unwrap m)
      def subCtx:RangerAppWriterContext (unwrap method.fnCtx)
      this.walkFunctionBody( method fnBody ctx subCtx wr)      
    } {
      ctx.addError( node ('Error parsing function ' + (error_msg)))
    }
  }
  fn EnterStaticMethod:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def parts:RangerFnParts (this.EnterFnParts(node ctx wr))
    if (parts.ok == false) {
      return
    }
    def nameNode:CodeNode (unwrap parts.nameNode)
    def fnBody:CodeNode (unwrap parts.fnBody)
    def desc:RangerAppClassDesc (unwrap parts.desc)
    try {
      def m@(lives) (unwrap (desc.findStaticMethod(nameNode.vref)))
      def subCtx (ctx.fork())
      m.fnCtx = subCtx
      subCtx.in_static_method = true
      this.walkFunctionBody( m fnBody ctx subCtx wr)
      subCtx.in_static_method = false
    } {
      ctx.addError( node ('Error parsing function ' + (error_msg)))
    }
  }

  ; (=> _ * 10)
  ; (=> _1 + _2 * 10)
  ; (=> () )
  ; --->? 

  fn DefineArrowOpFn:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    
    ; (# print '' + _1)
    def myName (ctx.createNewOpFnName())
    def argsNode (r.expression)
    def fBody (node.copy())
    remove fBody.children 0
    def opNode@(lives) (r.expression (r.vref 'defn') (r.vref myName ) argsNode fBody )

    ; (_arg1 _arg2)
    def setArg (fn:void (idx:int) {
      def i (size argsNode.children )
      while( i <= idx ) {
        push argsNode.children (r.vref (myName + '_arg' + i) )
        i = i + 1
      }
    })
    fBody.forTree({

      ; note: should be recursive...
      item.attrs.forEach({
        item.forTree({
          if(has item.vref) {
            if(item.vref == '_') {
              setArg(0)
              item.vref = (myName + '_arg0')
            }
            def parts (strsplit item.vref '_')
            if( (size parts) == 2) {
              def rest (at parts 1)
              def nbr (to_int rest)
              if(!null? nbr) {
                def n (unwrap nbr)
                setArg( (n - 1))
                item.vref = (myName + '_arg' + (n - 1))  
              }
            }
          }
        })
      }))
      
      if(has item.vref) {
        if(item.vref == '_') {
          setArg(0)
          item.vref = (myName + '_arg0')
        }
        def parts (strsplit item.vref '_')
        if( (size parts) == 2) {
          def rest (at parts 1)
          def nbr (to_int rest)
          if(!null? nbr) {
            def n (unwrap nbr)
            setArg( (n - 1))
            item.vref = (myName + '_arg' + (n - 1))  
          }
        }
      }
    })
    ctx.addOpFn( myName opNode )
    clear node.children
    node.vref = myName
    node.expression = false
  }
  
  fn DefineOpFn:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ; defn inc (x) (x + 1)
    if( (size node.children ) < 4) {
      ctx.addError(node 'invalid operator function')
      return
    }
    def fnName (at node.children 1)
    if(! (has fnName.vref)) {
      ctx.addError(node 'operator function has no name')
      return      
    }
    ; print "OP -> " + (node.getCode())
    ctx.addOpFn( fnName.vref node )
    ; set ctx.opFns fnName.vref node 
    node.disabled_node = true
    node.flow_done = true
  }

  ; returns the evaluated codenodes for the parameters in this compilation...
  fn testCompile@(weak):[string:CodeNode] (opFn:CodeNode node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    
    def ok false
    def rootCtx (ctx.getRoot())
    def errCnt (size rootCtx.compilerErrors)

    def opParams (at opFn.children 2)
    def opBody (at opFn.children 3)
    def xValue (node.copy())
    remove xValue.children 0  ; (inc 1) -> (1)

    ; collect the actual function parameters so that they can be placed
    ; into registers...
    def regToArg@(weak lives):[string:CodeNode]
    def am@(lives) (new RangerArgMatch)
    opParams.parallelTree( xValue {
      if( (!null? left) && (!null? right) ) {
        if(has left.vref) {
          def v (unwrap right)
          if v.expression  {
            set regToArg left.vref (unwrap right) 
          }
          set am.nodes left.vref (unwrap right) 
        }
      }
    })

    ; print "xValue " + (xValue.getCode())
    ; print "params " + (opParams.getCode())
    def opParamSet:[string:boolean]
    def regParams:[string:boolean]
    def regNames:[string:string]
    ; IMPORTANT: do not process if this node has already been made to register
    if(! ( has node.register_name ) ) {
      opBody.forTree({
        if(has regToArg item.vref) {
          if(has opParamSet item.vref) {
            if(! (has regParams item.vref) ) {
              def realArg (unwrap (get regToArg item.vref))
              if( has realArg.register_name ) {

              } {
                def regName = (ctx.createNewRegName())
                set regNames item.vref regName
                def argCopy (realArg.copy())
                def regExpr (r.expression (r.vref 'def') (r.vref regName) argCopy)
                this.WalkNode( regExpr ctx wr )
                def regArg (at regExpr.children 1)
                ; read through the local, not through a second (at …): the
                ; writers add the `!` a nullable path needs on a named path,
                ; not inside a parenthesised receiver.
                def realRegDesc:RangerAppParamDesc (unwrap regArg.paramDesc)
                def realRegName ( realRegDesc.compiledName )
                realRegDesc.set_cnt = 1
                realRegDesc.ref_cnt = 1

                def BlockOP (ctx.getLastBlockOp())
                BlockOP.register_expressions.push( regExpr )

                ; realArg.register_expressions.push( regExpr )
                realArg.register_name = regName
                realArg.reg_compiled_name = realRegName            
              }

            }
            set regParams item.vref true
          }
          set opParamSet item.vref true
        }
      })
    }

    def bodyCopy (opBody.copy())

    def newNode (opBody.rebuildWithType(am true))

    clear node.children
    forEach newNode.children {
      def tmp@(lives) item
      push node.children tmp
    }
    ; node.getChildrenFrom( newNode )
    node.flow_done = false

    if(opBody.is_block_node) {
      print "Block -> " + (opBody.getCode())
      def blockCtx (ctx.fork())
      blockCtx.newBlock()
      this.WalkNode( node blockCtx wr )
    } {
      this.WalkNode( node ctx wr )
    }

    ;; -- test compile cutted part was here

    ; am.nodes.forEach({
    ;   print " - " + index + " --> " + item.eval_type
    ; })

    return am.builtNodes
  }

  ; ---- -inline-statics ------------------------------------------------------
  ; A TRIVIAL static forwarder -- `sfn isUndefined:boolean (v:EvHandle) {
  ; return (v.isUndefined()) }` -- expands into its body at the call site
  ; instead of paying a function call (and, on the Rust target, an Rc clone
  ; per handle argument). Deliberately conservative: the body must be exactly
  ; one `return (expr)`, every name in it must be a parameter, a
  ; class-qualified reference or a language operator, and every call
  ; argument must be a plain bare name, so nothing can double-evaluate or
  ; change evaluation order. Anything else keeps the ordinary call.
  def inline_static_depth:int 0

  fn inlineStaticEligible:boolean (m:RangerAppFunctionDesc fnNode:CodeNode ctx:RangerAppWriterContext) {
    if( null? m.fnBody ) {
      return false
    }
    def body:CodeNode (unwrap m.fnBody)
    if( (array_length body.children) != 1 ) {
      return false
    }
    def ret (first body.children)
    if( false == (ret.isFirstVref("return")) ) {
      return false
    }
    if( (array_length ret.children) != 2 ) {
      return false
    }
    if( m.nameNode.hasFlag("optional") ) {
      return false
    }
    def retExpr (at ret.children 1)
    ; a bare-atom body (`return v`) is possible but rare -- only expression
    ; bodies are expanded, so the call node keeps its expression shape
    if( retExpr.expression == false ) {
      return false
    }
    def paramNames:[string:boolean]
    def b_ok true
    for m.params p:RangerAppParamDesc i {
      if( p.nameNode.hasFlag("optional") ) {
        b_ok = false
      }
      if( p.nameNode.hasFlag("keyword") ) {
        b_ok = false
      }
      if( p.nameNode.hasFlag("default") ) {
        b_ok = false
      }
      set paramNames p.name true
    }
    if( b_ok == false ) {
      return false
    }
    def fullName:string fnNode.vref
    retExpr.forTree({
      if( (strlen item.vref) > 0 ) {
        def rootName:string item.vref
        if( (array_length item.ns) > 0 ) {
          rootName = (first item.ns)
        }
        if( has paramNames rootName ) {
          ; a parameter use
        } {
          if( item.vref == fullName ) {
            ; direct recursion can never terminate the expansion
            b_ok = false
          } {
            if( ctx.isDefinedClass(rootName) ) {
              ; a class-qualified reference resolves the same anywhere
            } {
              def ops (ctx.getOperators(item.vref))
              if( (array_length ops) > 0 ) {
                ; a language operator
              } {
                ; a bare name from the callee's scope -- substituting it
                ; into the caller would capture the wrong binding
                b_ok = false
              }
            }
          }
        }
      }
    })
    return b_ok
  }

  fn tryInlineTrivialStatic:boolean (node:CodeNode fnNode:CodeNode m:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    if( inline_static_depth > 6 ) {
      return false
    }
    if( m.is_static == false ) {
      return false
    }
    ; only the plain `Class.name args` shape -- a variable-rooted or deeper
    ; chain is an instance call or a namespace walk
    if( (array_length fnNode.ns) != 2 ) {
      return false
    }
    def clName:string (first fnNode.ns)
    if( false == (ctx.isDefinedClass(clName)) ) {
      return false
    }
    def cl (ctx.findClass(clName))
    if( cl.is_template ) {
      return false
    }
    if( false == (cl.hasStaticMethod( (last fnNode.ns) )) ) {
      return false
    }
    if( (array_length node.children) != 2 ) {
      return false
    }
    def callArgs (node.getSecond())
    if( callArgs.expression == false ) {
      return false
    }
    if( (array_length callArgs.children) != (array_length m.params) ) {
      return false
    }
    ; every argument must be a plain bare name: an expression argument moved
    ; into the body's position could evaluate in a different order (or, if a
    ; parameter repeats, twice), and a literal cannot root a member chain
    def b_atoms true
    for callArgs.children a:CodeNode i {
      if( a.expression || ( (array_length a.children) > 0 ) || ( (array_length a.ns) > 1 ) || ( (strlen a.vref) == 0 ) ) {
        b_atoms = false
      }
    }
    if( b_atoms == false ) {
      return false
    }
    if( false == (this.inlineStaticEligible(m fnNode ctx)) ) {
      return false
    }
    def am@(lives) (new RangerArgMatch)
    for callArgs.children a:CodeNode i {
      def p:RangerAppParamDesc (at m.params i)
      am.addNode( p.name a )
    }
    def body:CodeNode (unwrap m.fnBody)
    def ret (first body.children)
    def retExpr (at ret.children 1)
    def newExpr (retExpr.rebuildWithType(am true))
    if(ctx.hasCompilerFlag("show-inline-statics")) {
      print "inline-statics: " + fnNode.vref + " -> " + (newExpr.getCode())
    }
    ; splice the rebuilt body into the call node and re-flow it in the
    ; CALLER's context -- types, param descriptors and ref counts are all
    ; computed for the new expression exactly as if it had been written here
    node.getChildrenFrom(newExpr)
    node.flow_done = false
    node.hasFnCall = false
    inline_static_depth = inline_static_depth + 1
    this.WalkNode(node ctx wr)
    inline_static_depth = inline_static_depth - 1
    return true
  }

  ; transforms a node
  ; origNode has the syntax (opname x y z)
  ; against given operator definition nodes in opFnList in format
  ;   defn someOp (x) (x + 1)
  ;
  def infinite_recursion false
  def match_types:[string:string]

  fn TransformOpFn:void (opFnList:[CodeNode] origNode:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    
    if infinite_recursion {
      return
    }
    def ok false
    def rootCtx (ctx.getRoot())
    def errCnt (size rootCtx.compilerErrors)

    def use_delta true

    def least_err_cnt 99999
    def least_errs:[RangerCompilerMessage]

    def depth (transaction_depth 'TransformOpFn' ctx)

    if( depth > 20 ) {
      ctx.addError( origNode 'Error: recursive operator function detected')
      infinite_recursion = true
      return
    }

    ; print "Depth : " + (transaction_depth 'TransformOpFn' ctx)

    if( has origNode.register_name ) {
      if( ctx.isVarDefined( origNode.register_name )) {
        def regInfo (ctx.getVariableDef(origNode.register_name))
        if(!null? regInfo.nameNode ) {
          origNode.copyEvalResFrom( (unwrap regInfo.nameNode) )
          return
        } {
          ; ctx.addError( origNode ('compiler error: could not find temporary register ' + origNode.register_name) )
        }
      } {
        ; ctx.addError( origNode ('compiler error: could not find temporary register ' + origNode.register_name) )
      }
      ; return
    }

    def fc (at origNode.children 0)
    if (fc.vref == "=") {
      this.repairAssignMethodCallRhs(origNode)
    }
    ; print "--> " + fc.vref + ", depth : " + (transaction_depth 'TransformOpFn' ctx)
    ; print (origNode.getCode())
    def myT (start_transaction 'TransformOpFn' fc.vref ctx) 

    def newOps:[CodeNode]

    def tryTypes ([] 'string' 'int' 'double' 'boolean')

    def codeStrHash (origNode.getSource())
    if( has match_types codeStrHash) {
      insert tryTypes 0 (unwrap (get match_types codeStrHash))    
    } 

    def cList (reverse ( (ctx.getRoot()) .getClasses()))
    cList.forEach({
      if( (item.isNormalClass()) || (item.is_system) ) {
        if( (indexOf codeStrHash item.name) >= 0) {
          insert tryTypes 0 item.name
        } {
          push tryTypes item.name
        }
      }
    })

    ; print codeStrHash
    ; print "try order : " + (join tryTypes ",")

    opFnList.forEach({
      def had_v false
      item.forTree({
        if(item.array_type == '?' || item.key_type == '?' || item.type_name == '?') {
          had_v = true
        }
      })
      if had_v {

        def opFn (item.copy())
        def opParams (at opFn.children 2)
        def opBody (at opFn.children 3)
        
        def typeName ""
        tryTypes.forEach({
          def copyOfFn (opFn.copy())
          typeName = item
          copyOfFn.forTree({
            if(item.array_type == '?') {
              item.array_type = typeName
            }
            if(item.key_type == '?') {
              item.key_type = typeName
            }
            if(item.type_name == '?') {
              item.type_name = typeName
            }
          })
          copyOfFn.matched_type = typeName
          push newOps copyOfFn
        })
      }

    })

    if( (size newOps) > 0) {
      ; print "now has " + (size newOps) + " variants "
      forEach newOps {
        def tmp@(temp) item
        push opFnList item
      }
    }

    def oNodeParams (size origNode.children)
    filter opFnList {
      def opParams (at item.children 2)
      return (oNodeParams == ( (size opParams.children) - 1) )
    }

    opFnList.forEach({
      if ok {
        return
      } {
        ; if last round did not work, try again...
        def currentErrCnt (size rootCtx.compilerErrors)
        def errDelta ( currentErrCnt - errCnt )
        if( errDelta > 0) {
          if( errDelta < least_err_cnt ) {
            least_err_cnt = errDelta
            def i errCnt 
            clear least_errs
            while( i < currentErrCnt) {
              def tmp@(temp) (at rootCtx.compilerErrors i)
              push least_errs tmp
              i = i + 1
            }
          }
          def i errCnt 
          while( i < currentErrCnt) {
            removeLast rootCtx.compilerErrors
            i = i + 1
          }
        }
      }

      def originalOpFn item
      def node (origNode.copy())
      def opFn item
      def opParams (at opFn.children 2)
      def opBody (at opFn.children 3)
      def xValue (node.copy())
      remove xValue.children 0  ; (inc 1) -> (1)

      opBody.forTree({
        if(item.vref == 'return') {
          ; ctx.addError( item 'Return keyword is not allowed in defn macros')
        }
      })

      ; collect the actual function parameters so that they can be placed
      ; into registers...
      def regToArg@(weak):[string:CodeNode]
      def am@(lives) (new RangerArgMatch)
      opParams.parallelTree( xValue {
        if( (!null? left) && (!null? right) ) {
          if(has left.vref) {
            def v (unwrap right)
            if v.expression  {
              set regToArg left.vref (unwrap right) 
            }
            set am.nodes left.vref (unwrap right) 
          }
        }
      })

      ; print "xValue " + (xValue.getCode())
      ; print "params " + (opParams.getCode())
      def opParamSet:[string:boolean]
      def regParams:[string:boolean]
      def regNames:[string:string]

      def BlockOP (ctx.getLastBlockOp())
      def newDefNodes:[CodeNode]
      def newRNodes:[CodeNode]

      ; IMPORTANT: do not process if this node has already been made to register
      if(! ( has node.register_name ) ) {
        opBody.forTree({
          if(has regToArg item.vref) {
            if(has opParamSet item.vref) {
              if(! (has regParams item.vref) ) {
                def realArg (unwrap (get regToArg item.vref))
                if( has realArg.register_name ) {

                } {
                  
                  def regName = (ctx.createNewRegName())
                  set regNames item.vref regName
                  def argCopy (realArg.copy())
                  def regExpr@(temp lives) (r.expression (r.vref 'def') (r.vref regName) argCopy)

                  ; *** Walk the Def and move expressions which are dynamically created into newRNodes
                  ; list so that we can decide if this compilation was a test run prevent those lines
                  ; to be added 
                  def cnt (size BlockOP.register_expressions)
                  ; ctx.setTestCompile()

                  this.WalkNode( regExpr ctx wr )
                  ; ctx.unsetTestCompile()
                  def opCntDelta ((size BlockOP.register_expressions) - cnt)

                  if(use_delta && opCntDelta > 0 ) {
                    def opCnt (size BlockOP.register_expressions)
                    def i cnt
                    while( i < opCnt ) {
                      def tmp@(temp) (at BlockOP.register_expressions i)
                      push newRNodes tmp
                      i = i + 1
                    }
                    i = cnt
                    while( i < opCnt ) {
                      removeLast BlockOP.register_expressions
                      i = i + 1
                    }
                  }

                  def regArg (at regExpr.children 1)
                  def realRegDesc:RangerAppParamDesc (unwrap regArg.paramDesc)
                  def realRegName ( realRegDesc.compiledName )
                  realRegDesc.set_cnt = 1
                  realRegDesc.ref_cnt = 1
                  
                  if use_delta {
                    push newRNodes regExpr
                  } {
                    def BlockOP (ctx.getLastBlockOp())
                    BlockOP.register_expressions.push( regExpr )
                  }
                  realArg.register_name = regName
                  realArg.reg_compiled_name = realRegName            
                }

              }
              set regParams item.vref true
            }
            set opParamSet item.vref true
          }
        })
      }

      def newNode (opBody.rebuildWithType(am true))
      node.getChildrenFrom( newNode )
      node.flow_done = false

      ; if( (size xValue.children ) != (size opParams.children) ) {
      ;  ctx.addError( origNode 'Invalid arg count')
      ;}

      ctx.setTestCompile()

      if(opBody.is_block_node) {
        ; print "Block -> " + (opBody.getCode())
        def blockCtx (ctx.fork())
        blockCtx.newBlock()
        this.WalkNode( node blockCtx wr )
      } {
        this.WalkNode( node ctx wr )
      }

      if( errCnt == (size rootCtx.compilerErrors) ) {
        ctx.unsetTestCompile()

        if(has originalOpFn.matched_type) {
          set match_types codeStrHash originalOpFn.matched_type
          ; print "--> had matched type " + originalOpFn.matched_type
          ; origNode.matched_type = originalOpFn.matched_type
        }

        ; matched_type

        if(! (ctx.isTestCompile() ) ) {
          forEach newDefNodes {
            def tmp@(temp) item
            push BlockOP.register_expressions tmp
          }
          forEach newRNodes {
            def tmp@(temp) item
            push BlockOP.register_expressions tmp
          }
        }
        
        ok = true
        def newNode (opBody.rebuildWithType(am true))
        origNode.getChildrenFrom( newNode )
        origNode.flow_done = false
        if(opBody.is_block_node) {
          def blockCtx (ctx.fork())
          blockCtx.newBlock()
          this.WalkNode( origNode blockCtx wr )
          def lastLine (last origNode.children)

          if( (lastLine.isFirstVref('ret')) || (has lastLine.eval_array_type ) || ( (has lastLine.eval_type_name) && (lastLine.eval_type_name != 'void') ) ) {


            def argVal (at lastLine.children 1)

            this.WalkNode( argVal blockCtx wr )

            ; print "arg val --> " + (argVal.getCode()) + " reg " + argVal.register_name
            origNode.copyEvalResFrom( argVal )

            def regName = (ctx.createNewRegName())
            set regNames item.vref regName
            def argCopy (argVal.copy())
            def nameNode (r.vref regName)
            
            nameNode.value_type = origNode.eval_type 
            nameNode.type_name = origNode.eval_type_name
            nameNode.array_type = origNode.eval_array_type
            nameNode.key_type = origNode.eval_key_type 

            if(argVal.eval_type == RangerNodeType.ExpressionType) {
              if(!null? argVal.expression_value) {
                nameNode.expression_value = (argVal.expression_value.copy())
              } {
                nameNode.expression_value = (argVal.copy())
              }
            }
            ;if(!null? argVal.expression_value) {
            ;  nameNode.expression_value = (argVal.expression_value.copy())
            ;}

            ; note: must set this flag to force unwrap, otherwise the node will be optional
            nameNode.setFlag('unwrap')

            def regExpr (r.expression (r.vref 'def') nameNode)

            ; print "Defining " + (regExpr.getCode()) + " <- " + regName
            ; print "Depth : " + (transaction_depth 'TransformOpFn' ctx)
            
            this.WalkNode( regExpr ctx wr )
            def regArg (at regExpr.children 1)
            def realRegDesc:RangerAppParamDesc (unwrap regArg.paramDesc)
            def realRegName ( realRegDesc.compiledName )
            realRegDesc.set_cnt = 1
            realRegDesc.ref_cnt = 1

            def BlockOP (ctx.getLastBlockOp())
            if(! (ctx.isTestCompile() ) ) {
              ; print "adding regExpr to block " + (BlockOP.getCode())
            }

            ; realArg.register_expressions.push( regExpr )
            origNode.register_name = regName
            origNode.reg_compiled_name = realRegName            
            
            lastLine.flow_done = false
            clear lastLine.children
            lastLine.getChildrenFrom( (r.expression (r.vref '=') (r.vref regName) argCopy ) )

            def regE (at regExpr.children 1)
            ; print "Defining 'lastline' -> " + (lastLine.getCode()) + " <- " + regName
            
            this.WalkNode( lastLine blockCtx wr)

            ;; def nn (blockCtx.getVariableDef(regName))

            ;; print "regname --> " + (nn.getCode())


            def myBlock (r.expression)
            myBlock.getChildrenFrom( origNode )
            if(! (ctx.isTestCompile() ) ) {
              insert myBlock.children 0 regExpr
              ; push myBlock.register_expressions regExpr 
              push BlockOP.register_expressions myBlock
            }
            clear origNode.children
            origNode.flow_done = true
          }
        } {
          this.WalkNode( origNode ctx wr )
          origNode.flow_done = true
        }
      } {
        ctx.unsetTestCompile()
      }
 
    })

    def depth (transaction_depth 'TransformOpFn' ctx)

    def errDelta ( (size rootCtx.compilerErrors) - errCnt )
    def currentErrCnt (size rootCtx.compilerErrors)
    def errDelta ( currentErrCnt - errCnt )
    if( errDelta > 0 ) {
      if( errDelta < least_err_cnt ) {
        def i errCnt 
        clear least_errs
        while( i < currentErrCnt) {
          def tmp@(temp) (at rootCtx.compilerErrors i)
          push least_errs tmp
          i = i + 1
        }
      }
      def i errCnt 
      while( i < currentErrCnt) {
        removeLast rootCtx.compilerErrors
        i = i + 1
      }
    }

    if(errDelta > 0 ) {
      least_errs.forEach({
        def tmp@(temp) item
        push rootCtx.compilerErrors tmp
      })
      print "^ had errors..."
      ctx.addError( origNode 'Could not find suitable match for the operator node' )
    }

    if infinite_recursion {
      ctx.addError( origNode 'Error: max recursiion depth of > 20 for inline operators detected')
    }

    end_transaction myT
    
    
  }

  fn cmdArray:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {

    ; ([] _:int (2 3 4 5))
    if( (size node.children ) == 3 ) {
      def sc (node.getSecond())
      if(  ( (strlen sc.vref) > 0 )  && ( (strlen sc.type_name ) > 0 ) ) {
        node.eval_array_type = sc.type_name
        node.eval_type = RangerNodeType.Array
        def items (node.getThird())
        def b_union false
        def union_types@(weak temp):[string]
        if( ctx.isDefinedClass( sc.type_name)) {
          def cl (ctx.findClass( sc.type_name))
          if(cl.is_union) {
            b_union = true
            union_types = cl.is_union_of
          }
        }
        def arrayItems (node.newExpressionNode())
        for items.children it:CodeNode i {
          def itemCopy (it.copy())
          this.WalkNode( itemCopy ctx wr )
          if( itemCopy.eval_type_name != sc.type_name ) {
            if( b_union ) {
              if( (indexOf union_types itemCopy.eval_type_name) >= 0 ) {
                ; OK 
              } {
                ctx.addError( it ( itemCopy.eval_type_name + " is Not part of union " + sc.type_name ) )
                break                
              }
            } {
              ctx.addError( it ( 'The array type should be ' + sc.type_name ) )
              break
            }
          }
          push arrayItems.children itemCopy
        }
        node.getChildrenFrom( arrayItems )
        node.is_array_literal = true
        return
      }
    }
    
    ; A type marker (`_:T`) is only meaningful as the SECOND child of the
    ; three-child form `([] _:T ( a b c ))` handled above. Written WITHOUT the
    ; parenthesised element group -- `([] _:T a b c)` -- it used to fall through
    ; to the generic branch below, which treats every child as an element. The
    ; marker was then emitted as a literal `_` (undefined at runtime in ES6) and,
    ; counting as a second distinct "type", degraded eval_array_type to Any --
    ; `r_union_Any[]` in C++, `[]interface{}` in Go. Silent wrong code on every
    ; backend, with no diagnostic. See ISSUES.md #67.
    ;
    ; `name:Type` is the only syntax that sets both vref and type_name, and it is
    ; never a valid element expression, so this cannot reject a legitimate array.
    for node.children marker:CodeNode mi {
      if( mi == 0 ) {
        continue
      }
      if( ( (strlen marker.vref) > 0 ) && ( (strlen marker.type_name) > 0 ) ) {
        ctx.addError( node ("Array literal type marker '" + marker.vref + ":" + marker.type_name + "' must be followed by a parenthesised element group, as in ([] _:" + marker.type_name + " ( a b c )). To let the element type be inferred, drop the marker: ([] a b c).") )
        return
      }
    }

    def arrayItems (node.newExpressionNode())
    def types:[string]
    for node.children it:CodeNode i {
      if( i == 0 ) {
        continue
      }
      def itemCopy (it.copy())
      this.WalkNode( itemCopy ctx wr )

      if( (indexOf types itemCopy.eval_type_name) < 0 ) {
        push types itemCopy.eval_type_name
      }
      push arrayItems.children itemCopy
    }
    def typeCnt ( size types )
    if( typeCnt == 0 ) {
      ctx.addError( node "Invalid array types")
      return
    }
    node.eval_type = RangerNodeType.Array
    if( ( size types ) > 1 ) {
      node.eval_array_type = "Any"
    } {
      node.eval_array_type = (at types 0) 
    }
    node.is_array_literal = true
    node.getChildrenFrom( arrayItems )
  }

  fn EnterLambdaMethod:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {

    def args:CodeNode (at node.children 1)
    def body@(lives):CodeNode (at node.children 2)
    def subCtx:RangerAppWriterContext (ctx.fork())

    if(! args.expression ) {
      ctx.addError(node 'Invalid anonymous function: second param should be an expression')
    }

    ctx.incLambdaCnt()
    subCtx.is_capturing = true

    node.evalTypeClass = (TFactory.new_lambda_signature(node ctx wr))

    def currM@(lives) (ctx.getCurrentMethod())

    def cn:CodeNode (at node.children 0)
    def m@(lives):RangerAppFunctionDesc (new RangerAppFunctionDesc ())
    m.name = "lambda"
    m.node = node
    m.is_lambda = true
    m.nameNode = (at node.children 0)
    m.insideFn = currM

    subCtx.newBlock()
    currM.myLambdas.push( m )

    subCtx.is_function = true
    subCtx.currentMethod = m
;      m.fnCtx = subCtx
    if (cn.hasFlag("weak")) {
      m.changeStrength(0 1 node)
    } {
      m.changeStrength(1 1 node)
    }
    m.fnBody = (at node.children 2)
    for args.children arg@(lives):CodeNode ii {

      this.CheckTypeAnnotationOf( arg subCtx wr )
      
      def p2@(lives):RangerAppParamDesc (new RangerAppParamDesc ())
      
      p2.name = arg.vref
      p2.value_type = arg.value_type
      p2.node = arg
      p2.nameNode = arg
      p2.init_cnt = 1
      p2.refType = RangerNodeRefType.Weak
      p2.initRefType = RangerNodeRefType.Weak
      if (args.hasBooleanProperty("strong")) {
        p2.refType = RangerNodeRefType.Strong
        p2.initRefType = RangerNodeRefType.Strong
      }
      p2.varType = RangerContextVarType.FunctionParameter
      push m.params p2
      arg.hasParamDesc = true
      arg.paramDesc = p2
      arg.eval_type = arg.value_type
      arg.eval_type_name = arg.type_name 
      if (arg.hasFlag("strong")) {
        p2.changeStrengthSelf(1 1)
      } {
        arg.setFlag("lives")
        p2.changeStrengthSelf(0 1)
      }           
      ; subCtx.hadValidType(p2.nameNode)
      subCtx.defineVariable(p2.name p2)
    }

    def cnt:int ( size body.children )
    ; def activeFn:RangerAppFunctionDesc (ctx.getCurrentMethod())

    for body.children item:CodeNode i {
      def tmp@(lives) item
      subCtx.lastBlockOp = tmp
      this.WalkNode(item subCtx wr)
      if( i == ( (size body.children ) - 1) ) {
          if( (size item.children ) > 0) {
            def fc (item.getFirst())
            if(fc.vref != "return") {
              cn.type_name = "void"
            }
          }
      }      
    }
    node.has_lambda = true
    node.lambda_ctx = subCtx
    node.eval_type = RangerNodeType.ExpressionType
    node.eval_function = node
    node.expression_value = (node.copy())
    node.lambdaFnDesc = m
    ; capture 2nd tier
    if((ctx.isCapturing())) {
      node.lambda_ctx.captured_variables.forEach({
        if( (ctx.isVarDefined(item)) ) {
          if ( (ctx.isLocalToCapture(item)) == false ) {
            ctx.addCapturedVariable( item )
          }
        }
      })
    }
  }

  ; myClass@(xxx)
  ; Is this annotation a list of TYPE ARGUMENTS, or a list of FLAGS? Both are
  ; spelled `@( … )` after a type: `def p:Node@(int)` names a type argument and
  ; `def p:RangerProcessBase@(optional)` names a flag, and the parser hands
  ; both over the same field. Every argument of a type argument list names a
  ; type; no flag does. Getting this wrong in the permissive direction loses an
  ; error message, and in the strict direction rejects `@(optional)` on every
  ; process class in the runtime -- which is what it did.
  fn annotationIsTypeArgs:boolean (tAnn:CodeNode ctx:RangerAppWriterContext) {
    if ((size tAnn.children) == 0) {
      return false
    }
    for tAnn.children ch:CodeNode i {
      def nm:string ch.vref
      if ((strlen nm) == 0) {
        return false
      }
      if (ctx.hasTemplateNode(nm)) {
        continue
      }
      if ((ctx.isDefinedType(nm)) == false) {
        return false
      }
    }
    return true
  }

  ; A MAP type argument arrives in two pieces. `Store@([string:int])` is one
  ; token to a reader and three to the tokeniser, because a colon inside a
  ; word is a type separator everywhere else in the language: the argument
  ; comes back as vref `[string` with type_name `int]`. Putting it back
  ; together here is a great deal safer than teaching the tokeniser about
  ; brackets, which would put every other token in the language up for
  ; re-checking.
  fn normalizeTypeArg:void (ch:CodeNode) {
    def v:string ch.vref
    def vlen:int (strlen v)
    if (vlen < 2) {
      return
    }
    if ((charAt v 0) != (charcode "[")) {
      return
    }
    def vLast:int (vlen - 1)
    if ((charAt v vLast) == (charcode "]")) {
      ; already whole -- an array argument has no colon to split on
      return
    }
    def t:string ch.type_name
    def tlen:int (strlen t)
    if (tlen < 1) {
      return
    }
    def tLast:int (tlen - 1)
    if ((charAt t tLast) != (charcode "]")) {
      return
    }
    ch.vref = ((v + ":") + t)
    ch.type_name = ""
    ch.has_type_annotation = false
  }

  ; `History@(SlideOp)` -> the name of its concrete class, `History_SlideOp`.
  ; Each type argument is resolved first, so `Store@(History@(int))` expands
  ; the inner class before it names the outer one.
  fn genericInstanceName:string (baseName:string tAnn:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def tstr:string ""
    for tAnn.children ch:CodeNode i {
      this.normalizeTypeArg(ch)
      this.CheckVRefTypeAnnotationOf( ch ctx wr )
      def part:string (this.typeArgKey(ch.vref))
      tstr = ((tstr + "_") + part)
    }
    return (baseName + tstr)
  }

  ; --- native generics ------------------------------------------------------
  ;
  ; Every `History@(int)` is still expanded into `History_int` and type
  ; checked as a class of its own: that is what the call sites are checked
  ; against. A target that has generics of its own can instead be handed ONE
  ; class, `History<Op>`, when the body is the same for every argument.
  ;
  ; That is decided here, once per template, after the whole program has been
  ; walked. The template is expanded one more time with each parameter bound
  ; to an empty placeholder class (`__tp_History_Op`), its GENERIC FORM. A
  ; body that only stores, moves and returns its parameter values checks
  ; cleanly against a class with no fields and no methods; anything that
  ; needs to know what the value is -- arithmetic, `+` on strings, a method,
  ; a comparison -- either fails to check or uses an operator outside the
  ; list below, and the template keeps its expanded copies. The errors of a
  ; failed check are taken back: they describe the check, not the program.
  fn nativeGenericsTarget:boolean (ctx:RangerAppWriterContext) {
    if (ctx.hasCompilerFlag("no-native-generics")) {
      return false
    }
    def lang:string (ctx.getTargetLangName())
    def langs:[string] ([] _:string ( "cpp" "java7" "go" "es6" "python" "php" "csharp" "dart" "kotlin" "scala" ))
    return ((indexOf langs lang) >= 0)
  }

  ; Operators that treat a value of a parameter type as an opaque value.
  ; Go writes a map read through a helper named and typed after the map
  ; (`r_get_string_int`), which a type parameter cannot be.
  fn genericOpaqueOperator:boolean (name:string ctx:RangerAppWriterContext) {
    def lang:string (ctx.getTargetLangName())
    if ((lang == "go") && (name == "get")) {
      return false
    }
    def ok:[string] ([] _:string ( "push" "clear" "itemAt" "at" "set_at" "remove_index" "removeLast" "insert" "last" "first" "array_length" "size" "set" "get" "has" "unwrap" "=" "def" "let" "var" "return" "null?" "!null?" "??" "call" "new" ))
    return ((indexOf ok name) >= 0)
  }

  ; What the target can not write generically whatever the body says. Go
  ; gives a class that extends an interface of its own, spelled after the
  ; class name.
  ; C# spells an optional int `int?` and an optional class bare, and an
  ; unconstrained type parameter has neither, so an optional one is not
  ; written generically there.
  fn genericFormFitsTarget:boolean (form:RangerAppClassDesc ctx:RangerAppWriterContext) {
    def lang:string (ctx.getTargetLangName())
    if (lang == "go") {
      if ((array_length form.extends_classes) > 0) {
        return false
      }
    }
    if (lang == "csharp") {
      def fnOpt@(optional):CodeNode form.classNode
      if (!null? fnOpt) {
        if (this.genericUsesOptionalParam((unwrap fnOpt))) {
          return false
        }
      }
    }
    return true
  }

  fn genericUsesOptionalParam:boolean (node:CodeNode) {
    if (node.hasFlag("optional")) {
      if (((indexOf node.type_name "__tp_") >= 0) || ((indexOf node.eval_type_name "__tp_") >= 0)) {
        return true
      }
    }
    for node.children c:CodeNode i {
      if (this.genericUsesOptionalParam(c)) {
        return true
      }
    }
    return false
  }

  fn genericTypeIsPlaceholder:boolean (n:CodeNode) {
    if ((indexOf n.eval_type_name "__tp_") >= 0) {
      return true
    }
    if ((indexOf n.eval_array_type "__tp_") >= 0) {
      return true
    }
    if ((indexOf n.eval_key_type "__tp_") >= 0) {
      return true
    }
    return false
  }

  ; True when the generic form uses a parameter value only opaquely.
  fn genericBodyIsOpaque:boolean (node:CodeNode ctx:RangerAppWriterContext) {
    def cnt:int (array_length node.children)
    if (node.expression && (cnt > 1)) {
      def fc:CodeNode (node.getFirst())
      def opName:string fc.vref
      if ((strlen opName) > 0) {
        if (((array_length fc.ns) <= 1) && ((this.genericOpaqueOperator(opName ctx)) == false)) {
          def ops:[CodeNode] (ctx.getOperators(opName))
          if ((array_length ops) > 0) {
            for node.children ch:CodeNode i {
              if (i == 0) {
                continue
              }
              if (this.genericTypeIsPlaceholder(ch)) {
                return false
              }
            }
          }
        }
      }
    }
    for node.children c:CodeNode ci {
      if ((this.genericBodyIsOpaque(c ctx)) == false) {
        return false
      }
    }
    return true
  }

  fn makeGenericPlaceholder:string (templateName:string paramName:string ctx:RangerAppWriterContext wr:CodeWriter) {
    def cname:string ((("__tp_" + templateName) + "_") + paramName)
    if (ctx.isDefinedClass(cname)) {
      return cname
    }
    def theCode:string (("class " + cname) + " {\n}\n")
    def code:SourceCode (new SourceCode(theCode))
    code.filename = ("generic parameter " + paramName)
    def parser:RangerLispParser (new RangerLispParser(code))
    parser.parse((ctx.hasCompilerFlag("no-op-transform")))
    def rn@(lives):CodeNode (unwrap parser.rootNode)
    push genericCheckNodes rn
    this.WalkCollectMethods(rn ctx wr)
    this.WalkNode(rn ctx wr)
    if (ctx.isDefinedClass(cname)) {
      def pc:RangerAppClassDesc (ctx.findClass(cname))
      pc.is_type_param = true
      pc.type_param_name = paramName
    }
    return cname
  }

  ; C++ writes a parameter bound to boolean or charbuffer differently from
  ; the same type written out: an optional one of those is a bare value
  ; there, and std::optional<T> in a template.
  fn genericArgsFitTarget:boolean (templateName:string ctx:RangerAppWriterContext) {
    def lang:string (ctx.getTargetLangName())
    def root:RangerAppWriterContext (ctx.getRoot())
    for root.definedClassList cn:string i {
      def cl:RangerAppClassDesc (root.findClass(cn))
      if (cl.generic_template != templateName) {
        continue
      }
      for cl.generic_args a:string ai {
        if (lang == "cpp") {
          if ((a == "boolean") || (a == "charbuffer")) {
            return false
          }
        }
      }
    }
    return true
  }

  fn checkNativeGenerics:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    if ((this.nativeGenericsTarget(ctx)) == false) {
      return
    }
    def root:RangerAppWriterContext (ctx.getRoot())
    if ((array_length root.compilerErrors) > 0) {
      return
    }
    def checked:[string:boolean]
    ; template -> the classes its generic form brought into being
    def madeBy:[string:[string]]
    def progress:boolean true
    while progress {
      progress = false
      def todo:[string]
      for root.definedClassList cn:string i {
        def cl:RangerAppClassDesc (root.findClass(cn))
        def tn:string cl.generic_template
        if ((strlen tn) == 0) {
          continue
        }
        if (has checked tn) {
          continue
        }
        if ((indexOf todo tn) < 0) {
          push todo tn
        }
      }
      for todo tpl:string ti {
        set checked tpl true
        progress = true
        def native:boolean (this.checkGenericForm(tpl ctx wr))
        root.setNativeGeneric(tpl native)
        if (ctx.hasCompilerFlag("generics-report")) {
          def nv:string "no"
          if native {
            nv = "yes"
          }
          print ((("generic " + tpl) + " native=") + nv)
        }
      }
    }
    ; a generic form naming another template's placeholder instance
    ; (`Slot<T>` inside Holder) is only as native as that template
    def changed:boolean true
    while changed {
      changed = false
      for root.definedClassList cn:string i {
        def cl:RangerAppClassDesc (root.findClass(cn))
        if ((cl.generic_has_placeholder == false) || cl.is_generic_form) {
          continue
        }
        if (root.isNativeGeneric(cl.generic_template)) {
          continue
        }
        ; this placeholder instance is not native: every template whose
        ; generic form uses it falls back too
        for root.templateClassList owner:string oi {
          if ((root.isNativeGeneric(owner)) == false) {
            continue
          }
          def ownerForm:string ("__gf_" + owner)
          if (has root.genericFormUses ownerForm) {
            def uses:[string] (unwrap (get root.genericFormUses ownerForm))
            if ((indexOf uses cn) >= 0) {
              root.setNativeGeneric(owner false)
              changed = true
            }
          }
        }
      }
    }
  }

  ; Expand `tpl` at its own placeholders and answer whether it is native.
  fn checkGenericForm:boolean (tpl:string ctx:RangerAppWriterContext wr:CodeWriter) {
    def root:RangerAppWriterContext (ctx.getRoot())
    if ((root.hasTemplateNode(tpl)) == false) {
      return false
    }
    def tplNode:CodeNode (root.findTemplateNode(tpl))
    def paramsOpt@(optional):CodeNode (tplNode.getExpressionProperty("params"))
    if (null? paramsOpt) {
      return false
    }
    def params:CodeNode (unwrap paramsOpt)
    ; a parameter spelled like a type the program already has would shadow
    ; it inside the generic class on every target
    for params.children pn:CodeNode pi {
      if ((root.isDefinedType(pn.vref)) || (root.hasTemplateNode(pn.vref))) {
        return false
      }
    }
    if ((this.genericArgsFitTarget(tpl ctx)) == false) {
      return false
    }
    def typeArgs:CodeNode (tplNode.newExpressionNode())
    def formName:string tpl
    for params.children pn:CodeNode pi {
      def ph:string (this.makeGenericPlaceholder(tpl pn.vref ctx wr))
      typeArgs.add((tplNode.newVRefNode(ph)))
      formName = ((formName + "_") + ph)
    }
    push genericCheckNodes typeArgs
    def errBefore:int (array_length root.compilerErrors)
    def classesBefore:int (array_length root.definedClassList)
    def made@(optional):RangerAppClassDesc (ctx.createGenericClassInstance(tpl formName typeArgs this wr))
    def ok:boolean ((array_length root.compilerErrors) == errBefore)
    while ((array_length root.compilerErrors) > errBefore) {
      removeLast root.compilerErrors
    }
    if (null? made) {
      return false
    }
    def form:RangerAppClassDesc (unwrap made)
    form.is_generic_form = true
    ; a static of a generic class has no instance to take its parameter from,
    ; and none can be called (FlowTypes says so), so a template carrying one
    ; keeps its copies
    if ((array_length form.static_methods) > 0) {
      ok = false
    }
    if ((this.genericFormFitsTarget(form ctx)) == false) {
      ok = false
    }
    if (form.isSingletonClass()) {
      ok = false
    }
    def uses:[string]
    def classesAfter:int (array_length root.definedClassList)
    def k:int classesBefore
    while (k < classesAfter) {
      push uses (itemAt root.definedClassList k)
      k = (k + 1)
    }
    set root.genericFormUses ("__gf_" + tpl) uses
    if (ok == false) {
      return false
    }
    def formNodeOpt@(optional):CodeNode form.classNode
    if (null? formNodeOpt) {
      return false
    }
    return (this.genericBodyIsOpaque((unwrap formNodeOpt) ctx))
  }

  ; A type argument as a piece of an identifier. `[string]` and `[string:int]`
  ; are legal Ranger types and illegal names everywhere, so `History@([string])`
  ; instantiates `History_arr_string` rather than `History_[string]`.
  fn typeArgKey:string (spelling:string) {
    def res:string ""
    def ii:int 0
    def ilen:int (strlen spelling)
    while (ii < ilen) {
      def c:int (charAt spelling ii)
      def nextAt:int (ii + 1)
      if (c == (charcode "[")) {
        res = (res + "arr_")
      } {
        if (c == (charcode "]")) {
          ; the closing bracket adds nothing a reader needs
        } {
          if ((c == (charcode ":")) || (c == (charcode " "))) {
            res = (res + "_")
          } {
            res = (res + (substring spelling ii nextAt))
          }
        }
      }
      ii = nextAt
    }
    return res
  }

  fn CheckVRefTypeAnnotationOf:boolean (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if(node.has_vref_annotation) {
      def tAnn (node.vref_annotation)
      ; `new History@(SlideOp) ()` -- expand the class, then point the `new` at it
      if (ctx.hasTemplateNode(node.vref)) {
        def instName:string (this.genericInstanceName(node.vref (unwrap tAnn) ctx wr))
        def made@(optional):RangerAppClassDesc (ctx.createGenericClassInstance( node.vref instName (unwrap tAnn) this wr ))
        ; Nothing was built -- the arguments were wrong and have been reported.
        ; Pointing the reference at a class that does not exist only turns one
        ; error into three.
        if (null? made) {
          return true
        }
        node.vref = instName
        node.has_vref_annotation = false
        return true
      }
      if(false == (ctx.isDefinedClass(node.vref))) {
        ctx.addError(node ('Trait class ' + node.vref + ' is not defined'))
      } {
        def testC (ctx.findClass(node.vref))
        ; A type argument list on a class that takes none used to be dropped in
        ; silence, so `new Plain@(int)` compiled as `new Plain` and the author
        ; was left believing Plain was generic.
        if ((testC.is_trait == false) && ((testC.node.hasExpressionProperty("params")) == false)) {
          if (this.annotationIsTypeArgs((unwrap tAnn) ctx)) {
            ctx.addError(node ((node.vref + ' takes no type arguments: it is not declared with @params(...)')))
            node.has_vref_annotation = false
          }
          return false
        }
        if(testC.is_trait) {
          if (testC.node.hasExpressionProperty("params")) {
            def params (testC.node.getExpressionProperty("params"))

            def cnt (size tAnn.children)
            def tstr ""
            for tAnn.children ch:CodeNode i {
              this.CheckVRefTypeAnnotationOf( ch ctx wr ) 
              tstr = tstr + "_" + ch.vref
            }
            def my_class_name ( testC.name + tstr)
            def ann (unwrap tAnn)
            ctx.createTraitInstanceClass( testC.name my_class_name ann this wr )
            node.vref = my_class_name
            node.has_vref_annotation = false
            return true
          }
        }
      }
    }    
    return false
  }

  ; def xxx:vectorOf@(int)
  fn CheckTypeAnnotationOf:boolean (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if(node.has_type_annotation) {
      def tAnn (node.type_annotation)

      ; `def kids:[Node@(int)]` and `def byId:[string:Node@(int)]` carry the
      ; arguments on the ELEMENT type, which lives in array_type rather than in
      ; type_name. The parser already collects the annotation onto the
      ; collection node; without this the lookup ran against an empty name and
      ; the program was told "Trait class  is not defined".
      def onElement:boolean false
      def targetName:string node.type_name
      if ((strlen targetName) == 0) {
        if ((strlen node.array_type) > 0) {
          targetName = node.array_type
          onElement = true
        }
      }

      ; `def h:History@(SlideOp)`, a parameter of that type or a method
      ; returning one -- all three arrive here
      if (ctx.hasTemplateNode(targetName)) {
        def instName:string (this.genericInstanceName(targetName (unwrap tAnn) ctx wr))
        def made@(optional):RangerAppClassDesc (ctx.createGenericClassInstance( targetName instName (unwrap tAnn) this wr ))
        if (null? made) {
          return true
        }
        if onElement {
          node.array_type = instName
        } {
          node.type_name = instName
        }
        node.has_type_annotation = false
        return true
      }
      if(false == (ctx.isDefinedClass(targetName))) {
        ctx.addError(node ('Trait class ' + targetName + ' is not defined'))
      } {
        def testC (ctx.findClass(targetName))
        if ((testC.is_trait == false) && ((testC.node.hasExpressionProperty("params")) == false)) {
          if (this.annotationIsTypeArgs((unwrap tAnn) ctx)) {
            ctx.addError(node ((targetName + ' takes no type arguments: it is not declared with @params(...)')))
            node.has_type_annotation = false
          }
          return false
        }
        if(testC.is_trait) {
          if (testC.node.hasExpressionProperty("params")) {
            def params (testC.node.getExpressionProperty("params"))

            def cnt (size tAnn.children)
            def tstr ""
            for tAnn.children ch:CodeNode i {
              this.CheckVRefTypeAnnotationOf( ch ctx wr ) 
              tstr = tstr + "_" + ch.vref
            }
            def my_class_name ( testC.name + tstr)
            def ann (unwrap tAnn)
            ctx.createTraitInstanceClass( testC.name my_class_name ann this wr )
            if onElement {
              node.array_type = my_class_name
            } {
              node.type_name = my_class_name
            }
            node.has_type_annotation = false
            return true
          }
        }
      }
    }    
    return false
  }


  fn matchNode:boolean (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (0 == (size node.children)) {
      return false
    }
    def fc:CodeNode (node.getFirst())
    stdCommands = (ctx.getStdCommands())
    def op_list (ctx.getOperators(fc.vref))
    for op_list cmd:CodeNode i {
      def cmdName:CodeNode (cmd.getFirst())
      if (cmdName.vref == fc.vref && (! (ctx.isVarDefined(cmdName.vref)))) {
        if (fc.vref == "-") {
          this.repairUnaryMinusExpr(node)
        }
        if (fc.vref == "=") {
          this.repairAssignMethodCallRhs(node)
        }
        this.stdParamMatch(node ctx wr true)
        if (!null? node.parent) {
          ; node.parent.copyEvalResFrom(node)
        }
        return true
      }
    }
    ; convert into  a call because it handles the lambda functions correctly
    if( ( (size fc.ns) > 1 ) && ( ( size node.children) > 1) ) {
      def possible_cmd (last fc.ns)
      def op_list (ctx.getOperators(possible_cmd))

      if( (has op_list) ) {
;       for op_list cmd:CodeNode i {
        
        ;def m (new RangerArgMatch)        
        ;def altVersion ( node.rebuildWithType (m false) )
        ;def origCopy  ( node.rebuildWithType (m false) )

        def args (node.getSecond())
        def nn (fc.copy())
        removeLast nn.ns

        def objName (join nn.ns ".")

        def newNode (node.newExpressionNode())
        newNode.add( ( node.newVRefNode("call")) )
        newNode.add( ( node.newVRefNode(objName)) )
        newNode.add( ( node.newVRefNode(possible_cmd)))
        newNode.add( ( args.copy()))

        ; preserve any trailing method-chain elements ( .trim () .foo (...) )
        def total (size node.children)
        if ( total > 2 ) {
          def innerNode@(weak):CodeNode
          innerNode = newNode
          def k 2
          while ( k < (total - 1) ) {
            def mName (at node.children k)
            def mArgs (at node.children (k + 1))
            def chName (mName.vref)
            if( ( (strlen chName) > 0 ) && ( ( charAt chName 0) == (charcode ".")) ) {
              def method_name (substring chName 1 (strlen chName))
              def wrap (node.newExpressionNode())
              wrap.add( ( node.newVRefNode("call")) )
              wrap.add( ( innerNode.copy()) )
              wrap.add( ( node.newVRefNode(method_name)) )
              wrap.add( ( mArgs.copy()) )
              innerNode = wrap
            }
            k = k + 2
          }
          node.getChildrenFrom( (unwrap innerNode) )
          node.finalizeAsCallChainRoot()
        } {
          node.getChildrenFrom( newNode )
        }

        if( ( (ctx.expressionLevel()) == 0 ) ) {
          ctx.lastBlockOp = node
        }

        node.flow_done = false
        this.WalkNode( node ctx wr)
        return true
     }
    }
    
    return false
  }
  fn StartWalk:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ; walkAlso
    this.WalkNode(node ctx wr)
    for walkAlso ch:CodeNode i {
      this.WalkNode(ch ctx wr)
    }
  }
  

  ; ---------------------------------------------------------------------------
  ; SHAPES (PLAN_SHAPES.md, stage S1)
  ;
  ; A `shape` is a closed family of variants:
  ;
  ;   shape EvalValue {
  ;       group Reference { def identityId:int 0 }
  ;       case Null
  ;       case Number { def value:double 0.0 }
  ;       case Array does Reference { def items:[EvalValue] }
  ;   }
  ;
  ; It lowers to constructs every target already has — one `record` per case
  ; plus a `union` over them, and one `union` per group over that group's
  ; members. Nothing below this pass knows the word `shape`, which is why no
  ; writer had to change to support it. A case's fields are its own plus the
  ; fields of the group it belongs to.
  ;
  ; The lowering runs before class collection and rewrites the source spelling
  ; `EvalValue.Number` to the generated class name `EvalValue_Number` across the
  ; whole tree, so a shape reads as one type with variants while the compiler
  ; sees ordinary classes.
  ; ---------------------------------------------------------------------------
  ; ==========================================================================
  ; Tree literals
  ; ==========================================================================
  ; Two forms, and nothing else:
  ;
  ;   treefactory EVGTree {
  ;       child addChild          ; how a parent takes a child
  ;       text  textContent       ; the field a bare value child sets
  ;       tag   View   EVGView    ; what a tag means
  ;       tag   Text   EVGText
  ;   }
  ;
  ;   (tree EVGTree
  ;       (View (props (className "card"))
  ;           (Text (props (id "t")) title)))
  ;
  ; lowers to, in the enclosing block:
  ;
  ;   def _tree1 (new EVGView)
  ;   _tree1.className = "card"
  ;   def _tree2 (new EVGText)
  ;   _tree2.id = "t"
  ;   _tree2.textContent = title
  ;   _tree1.addChild(_tree2)
  ;
  ; and the expression itself becomes `_tree1`.
  ;
  ; Everything the feature checks, it checks by lowering to code that was
  ; already checkable: a misspelled property is an assignment to a field that
  ; does not exist, a wrongly typed one is a type error on that assignment, and
  ; a child that the parent cannot take is an argument mismatch on the child
  ; call. There is no separate property table and no new diagnostics to keep in
  ; step with the type checker, because the type checker is doing the work.

  ; `treefactory Name { … }` and nothing else. Recognised by its whole form
  ; rather than its first word, for the same reason `shape` is: `treefactory`
  ; is a perfectly ordinary identifier until it heads a three-part declaration.
  ; A factory declares names, so it has to be a top-level form: inside a class
  ; body it would read as a member and take the class down with it.
  ; `(tree Name element)`. The factory name is NOT checked here: a literal
  ; naming a factory nobody declared has to say that, and returning false would
  ; leave it to fail much later as "Undefined variable tree".
  ; Find the blocks; each one then hoists the trees its own statements contain.
  ;
  ; A class body is a block too, and it is the one that must NOT be treated as
  ; one: its children are member declarations, and hoisting `def _tree1 (new X)`
  ; in among them puts a statement where a member belongs. Measured — a tree
  ; literal in a field initializer compiled to a class whose body had loose
  ; statements in it, and failed as "Unknown type: type ID : 11", which tells
  ; nobody anything. The literal is now left alone there and named by
  ; reportStrayTrees instead.
  ; A tree literal is an expression, and it lowers to statements — so the
  ; statements go in front of the statement that contained it, and the literal
  ; becomes the name they built. Nothing about the enclosing expression changes,
  ; which is why `return (tree …)`, `x = (tree …)` and `f((tree …))` all work
  ; without the feature knowing what any of them are.
  ; `(Tag (props (name value) …) child …)` → the name of the temporary holding
  ; it, with everything needed to build it pushed onto `prelude`.
  ; <reg>.<method>(<arg>)
  ; <reg>.<field> = <value>
  ; `shape Name { … }` and nothing else: `shape` is an ordinary identifier in
  ; existing code (`shape.initSphere(1.0)` in the physics sources), so the
  ; declaration is recognised by its whole form — three parts, a bare name, a
  ; block — rather than by its first word alone.
  ; A shape lowers to top-level declarations, so it has to BE one: spliced into
  ; a class body the generated records would land inside the class and take the
  ; compiler down with them. `atTopLevel` goes false the moment the walk enters
  ; a declaration body, and a shape found there is a named error.
  ; One spelling may name one case only: a name claimed by two shapes is
  ; recorded as empty, so a `match` arm using it can say so instead of picking.
  ; A field the generated equality can compare with `==`: a scalar, not a
  ; collection and not another object. A `@(value)` case may hold nothing else,
  ; which is what makes "copies compare equal" true on every target.
  ; The body block of a shape member (`case A { … }` / `group G { … }`). A
  ; member with no fields has no block, and answers the statement itself — the
  ; caller tests is_block_node rather than unwrapping an optional.
  ; Exact signature key for conformance (C3): return type + each parameter type.
  ; Rewrite bare field names inside a case/group method body to `self.field`
  ; so an `fn` that used instance field lookup still works as an ops `sfn`.
  ; Moves method nodes onto a generated ops class. The method node is reused:
  ; `fn` becomes `sfn`, a non-static method gains `self:<selfType>` as its first
  ; parameter, and bare field names in the body become `self.field`.
  ; Build get_/set_ source for every field available through a group view.
  ; Rewrite a node into `Group__ops.get_field(receiver)`.
  ; Widen a subgroup-typed value to a parent group via a generated helper.
  ; Name is `widen_to_*` (not `__as_*`) so Python does not mangledouble-underscore names.
  ; ---------------------------------------------------------------------------
  ; MATCH (PLAN_SHAPES.md, stage S2)
  ;
  ;   match value {
  ;       Nothing | Text  { … }        ; several variants, one arm
  ;       Num n           { … }        ; binds the variant
  ;       Ref r           { … }        ; a group covers all of its members
  ;   }
  ;
  ; Every variant of the shape must be covered exactly once — that check is the
  ; reason the construct exists; without it a match is a `case` chain with extra
  ; syntax. There is no catch-all arm: one added later to a shape would be
  ; silently swallowed by it, which is the bug class this is meant to remove.
  ;
  ; The lowering is a chain of `case` narrowings, which every target already
  ; runs (S0). The arms are mutually exclusive, so a chain and a switch mean the
  ; same thing.
  ; ---------------------------------------------------------------------------
  ; `enclosing` is the nearest fn/sfn/Constructor node, which is where the
  ; scrutinee's declared type is looked up — a match over a GROUP type is
  ; complete when it covers that group, and without the declared type the check
  ; would have to accept any complete group for any scrutinee.
  ; `is v _:Shape.Group` — a group is not a discriminant any target can test.
  ; The generated union carries one tag per CASE, so asking a writer for a
  ; group tag produces a name that does not exist (`union_Val::union_Val_Prim`
  ; on Rust, `union_Val_tag_union_Val_Prim` on Go) or, on the tag-string
  ; targets, a comparison that is simply never true. So a group test expands
  ; here into a disjunction over the group's member cases — the same move
  ; `match` makes for a group arm — and every target then sees only per-case
  ; tests it already knows how to lower.
  ;
  ; Runs on the renamed tree, so the annotation already reads as the generated
  ; group class name.
  ; One `is v _:Case` node, built the way expandMatch builds its narrowings.
  ; The declared type of `name` inside this function: a parameter first, then a
  ; `def name:Type` anywhere in the body. Empty when it cannot be read off the
  ; source, which makes the exhaustiveness check demand the full shape.
  ; The case classes an arm name covers: one for a case, all of its members for
  ; a group. An unknown or ambiguous name reports itself and answers empty.
  ; Point a reference at its generated name. The replacement may itself be a
  ; path (`Value.equals` becomes `Value__ops.equals`), and a call resolves
  ; through the segments in `ns`, not through the joined spelling.
  ;       this.CollectMethods( (unwrap parser.rootNode ) ctx wr)
  ; Record `child` as a subclass of the class `ee` names -- reporting it, rather
  ; than dereferencing null, when no such class exists. `findClass` answers
  ; nothing for a name that was never declared (a missing Import, a typo), and
  ; JavaScript is the only host on which writing to that "nothing" merely
  ; throws where the compiler already catches: every other target dies on the
  ; spot, so `Extends` naming an unknown class killed the process instead of
  ; producing a diagnostic.
  ; The node forms that only make sense inside a class body, and that
  ; WalkCollectMethods handles by reading ctx.currentClass.
  fn isClassMemberForm:boolean (node:CodeNode) {
    if (node.isFirstVref("extends")) { return true }
    if (node.isFirstVref("Extends")) { return true }
    if (node.isFirstVref("constructor")) { return true }
    if (node.isFirstVref("Constructor")) { return true }
    if (node.isFirstVref("def")) { return true }
    if (node.isFirstVref("let")) { return true }
    if (node.isFirstVref("static")) { return true }
    if (node.isFirstVref("StaticMethod")) { return true }
    if (node.isFirstVref("sfn")) { return true }
    if (node.isFirstVref("PublicMethod")) { return true }
    if (node.isFirstVref("fn")) { return true }
    return false
  }

  fn markParentClass:void (ee:CodeNode childName:string ctx:RangerAppWriterContext) {
    if ((ctx.isDefinedClass(ee.vref)) == false) {
      ctx.addError(ee ("Class " + childName + " extends " + ee.vref + ", which is not defined"))
      return
    }
    def ParentClass:RangerAppClassDesc (ctx.findClass(ee.vref))
    ParentClass.is_inherited = true
    ParentClass.is_extended_by_children = true
    push ParentClass.child_classes childName
  }

  ; Register `class X @params(T)` everywhere in the tree, imports included.
  ; Nothing else is collected here: the body of a template says `T`, which is
  ; not a type, and only the copies made at each reference are ever checked.
  ; Declarations that may carry a `doc { … }` tail. PLAN_API_DOCS.md §2.3.
  ; Moves a trailing `doc { … }` off the declaration node and onto docNode,
  ; BEFORE anything counts children. Every existing arity check and index
  ; lookup then sees exactly the tree it saw before the feature existed --
  ; which is also what keeps EnterClass from taking the doc block for the
  ; class body and emitting an unanalysed method (ISSUES.md #75).
  ;
  ; A head that is not a declaration is left alone rather than reported: an
  ; ordinary `if doc { … }` over a variable called `doc` has the same shape.
  ; A field or local variable may be named the same as a Ranger system type
  ; such as `buffer` (defined in Lang.rgr as `systemclass buffer`), which is
  ; also registered as a defined class. When resolving the receiver of a member
  ; access (e.g. `buffer.writeByte(...)`) the variable/field must win over the
  ; type, otherwise the call resolves against the empty system type and the
  ; method is reported as "not found". Only primitive/system type names can
  ; collide this way — ordinary user classes are never primitive types — so
  ; this guard is intentionally narrow and leaves all other resolution intact.
}

Import "FlowStdMatch.rgr"
Import "FlowProcess.rgr"
Import "FlowShape.rgr"
Import "FlowCollect.rgr"
Import "FlowTypes.rgr"
Import "FlowTree.rgr"
Import "FlowImport.rgr"


; Ranger Low IR ? typed three-address intermediate representation.
; Phase 1: Ranger AST ? Low IR ? LLVM IR / WAT

class LowIRUtil {
  static fn typeFromRanger:string (typeName:string) {
    switch typeName {
      case "int" {
        return "i32"
      }
      case "boolean" {
        return "i1"
      }
      case "bool" {
        return "i1"
      }
      case "double" {
        return "f64"
      }
      ; A `char` is a code unit -- charAt and ccode both answer one, and every
      ; other target treats it as an integer. Leaving it out of this table made
      ; isObjectTypeName call it an object, so `firstC == (ccode "-")` compared
      ; an i32 against a value the backend had decided was pointer sized.
      case "char" {
        return "i32"
      }
      case "void" {
        return "void"
      }
    }
    return ""
  }

  static fn isSupportedPrimitive:boolean (typeName:string) {
    def t (LowIRUtil.typeFromRanger(typeName))
    return ((strlen t) > 0)
  }

  ; `charbuffer` is the string's own bytes on this backend -- `to_charbuffer`
  ; hands back the pointer it was given, the way the C++ template answers
  ; `c_str()`. Treating it as anything else made a charbuffer FIELD an object:
  ; the assignment emitted ranger_obj_retain over an i8*, and `length` on one
  ; went to the collection path and answered the pointer.
  static fn isStringType:boolean (typeName:string) {
    if (typeName == "charbuffer") {
      return true
    }
    return (typeName == "string")
  }

  static fn isArrayTypeName:boolean (typeName:string) {
    if ((strlen typeName) < 3) {
      return false
    }
    return ((indexOf typeName "[") == 0)
  }

  static fn isBufferTypeName:boolean (typeName:string) {
    return (((typeName == "buffer") || (typeName == "int_buffer")) || (typeName == "double_buffer"))
  }

  ; The JSON systemclasses. They have no Ranger-side class body, so the backend
  ; can not learn their shape from a layout: every one of them is a handle into
  ; the C JSON runtime (runtime/ranger_json.c), and the operators that touch
  ; them are lowered to RtJson_* calls rather than to field reads.
  static fn isJsonTypeName:boolean (typeName:string) {
    if (typeName == "JSONDataObject") { return true }
    if (typeName == "JSONArrayObject") { return true }
    if (typeName == "JSONValueUnion") { return true }
    if (typeName == "JSONArrayUnion") { return true }
    if (typeName == "JSONObjectUnion") { return true }
    if (typeName == "JSONKeyValue") { return true }
    return false
  }

  static fn isSupportedParam:boolean (typeName:string) {
    if (LowIRUtil.isSupportedPrimitive(typeName)) {
      return true
    }
    if (LowIRUtil.isStringType(typeName)) {
      return true
    }
    return false
  }

  static fn fieldIrType:string (typeName:string) {
    if (LowIRUtil.isArrayTypeName(typeName)) {
      return "i32"
    }
    if (LowIRUtil.isStringType(typeName)) {
      return "i32"
    }
    def t (LowIRUtil.typeFromRanger(typeName))
    if (t == "i1") {
      return "i32"
    }
    if ((strlen t) == 0) {
      return "i32"
    }
    return t
  }

  static fn mangleMethod:string (className:string methodName:string) {
    return (className + "_" + methodName)
  }

  static fn structPtrType:string (className:string) {
    return ("%struct." + className + "*")
  }

  static fn structType:string (className:string) {
    return ("%struct." + className)
  }

  static fn moduleUsesHeap:boolean (module:LowIRModule) {
    if ((array_length module.structs) > 0) {
      return true
    }
    for module.functions fn:LowIRFunction i {
      for fn.blocks bb:LowIRBlock i {
        for bb.instrs ins:LowIRInstr i {
          if (ins.op == "heap_alloc") {
            return true
          }
        }
      }
    }
    return false
  }
}

class LowIRParam {
  def name:string ""
  def irType:string "i32"
}

class LowIRInstr {
  def op:string ""
  def dest:string ""
  def irType:string "i32"
  def arg1:string ""
  def arg2:string ""
  def arg3:string ""
  def pred:string ""
  def fnName:string ""
  def callArgs:[string]
  def callTypes:[string]
  def callSig:string ""
  def structName:string ""
  def fieldIndex:int 0
  def structSize:int 0
}

class LowIRBlock {
  def label:string "entry"
  def instrs:[LowIRInstr]
  def termKind:string "ret"
  def termType:string "i32"
  def termValue:string ""
  def termTarget:string ""
  def termIfTrue:string ""
  def termIfFalse:string ""
}

class LowIRFunction {
  def name:string ""
  def exportFn:boolean false
  def isMain:boolean false
  def returnType:string "i32"
  def params:[LowIRParam]
  def blocks:[LowIRBlock]
}

class LowIRField {
  def name:string ""
  def irType:string "i32"
  def isPtrArray:boolean false
  ; A `[string:T]` field. Backed by the RtSMap_* runtime rather than the
  ; generated integer-keyed RtMap_*, which cannot hash a string key.
  def isStringMap:boolean false
  ; An `[int:T]` field whose values are references. Distinct from isStringMap
  ; because the runtimes differ (RtIMap_* vs RtSMap_*) and from `[int:int]`,
  ; which stays on the 4-byte RtMap_*.
  def isIntMap:boolean false
  def isIntMapStr:boolean false
  ; `[string:int]` rather than `[string:<object>]`: the runtime hands back a
  ; pointer-sized value, so an int-valued map has to narrow it.
  def isStringMapInt:boolean false
  ; `[string:string]`: the value is a pointer, not an integer.
  def isStringMapStr:boolean false
  def isBool:boolean false
  def isString:boolean false
  def isBuffer:boolean false
  def isObject:boolean false
}

class LowIRTypeFieldDesc {
  def offset:int 0
  def kind:int 0
  def owned:int 1
}

class LowIRTypeDesc {
  def className:string ""
  def size:int 0
  def fields:[LowIRTypeFieldDesc]
}

class LowIRStruct {
  def name:string ""
  def fields:[LowIRField]
}

class LowIRStringGlobal {
  def name:string ""
  def text:string ""
  def byteLen:int 0
  def withNewline:boolean false
}

class LowIRExternDecl {
  def fnName:string ""
  def retType:string "i32"
  def paramTypes:[string]
  def isVararg:boolean false
  def declSig:string ""
}

class LowIRModule {
  def name:string "module"
  def triple:string "unknown-unknown-unknown"
  def ptrType:string "i32"
  def useLibcHeap:boolean false
  ; freestanding WASM under -wasmrc: route heap_alloc through the free-list Heap
  ; (Heap_alloc/Heap_free) so collections share the one coherent heap that
  ; objects and strings use — not the leak-forever bump pointer, which would also
  ; collide with the free-list control words at Mem[0]/Mem[4].
  def useFreeListHeap:boolean false
  def structs:[LowIRStruct]
  def typeDescs:[LowIRTypeDesc]
  def functions:[LowIRFunction]
  def stringGlobals:[LowIRStringGlobal]
  def externDecls:[LowIRExternDecl]
  ; class names that need a mutable wasm global holding their lazy singleton
  ; instance (the WAT writer emits `(global $singleton_<name> (mut i32) 0)`).
  def singletonClasses:[string]
  ; hoisted lambda function names in table-index order; the WAT writer emits a
  ; `(table funcref (elem …))` of these for call_indirect. Index = position.
  def lambdaTableFuncs:[string]
  ; distinct call_indirect signatures ("t0,t1,…:ret") that need a `(type …)`.
  def lambdaSigs:[string]
  ; the module contains a `throw` or an `error_msg`, so it needs the global that
  ; carries the thrown message from the one to the other
  def usesErrorMsg:boolean false
  ; the @main body was emitted as @__rg_main_body and needs the entry-point shim
  ; that runs it on a thread with a large stack (see writeBigStackMain).
  def bigStackMain:boolean false
}

; Compile-session singleton ? holds the module being built for one translation unit.
class LowIRSession @singleton(true) {
  def module:LowIRModule (new LowIRModule())

  fn beginModule:void (moduleName:string) {
    this.module = (new LowIRModule())
    this.module.name = moduleName
  }

  static fn current:LowIRSession () {
    return (LowIRSession.__singleton())
  }
}

class LowIRBuilder {
  def irModule:LowIRModule
  def tempCounter:int 0
  def blockCounter:int 0
  def blocks:[LowIRBlock]
  def currentBlock@(optional weak):LowIRBlock
  ; SSA name -> the IR type the instruction that defines it produces. Asking
  ; the SOURCE node what type an expression has is guesswork in a few shapes
  ; (a parenthesised comparison, a narrowed map read); asking what was actually
  ; emitted is not.
  def destTypes:[string:string]

  Constructor (module:LowIRModule) {
    irModule = module
  }

  ; Generated temporaries are prefixed with "." (valid in LLVM, but not a legal
  ; start for a Ranger identifier) so they can never collide with source-level
  ; parameter or variable names such as "v11".
  fn freshTemp:string (prefix:string) {
    def n (this.tempCounter)
    this.tempCounter = n + 1
    return ("%." + prefix + ("" + n))
  }

  fn freshLabel:string (prefix:string) {
    def n (this.blockCounter)
    this.blockCounter = n + 1
    return (prefix + ("" + n))
  }

  fn reset:void () {
    this.tempCounter = 0
    this.blockCounter = 0
    def emptyBlocks:[LowIRBlock]
    this.blocks = emptyBlocks
  }

  fn startBlock:string (label:string) {
    if (!null? this.currentBlock) {
      def cur (unwrap this.currentBlock)
      if (cur.termKind == "") {
        cur.termKind = "ret"
      }
    }
    def bb@(lives):LowIRBlock (new LowIRBlock())
    bb.label = label
    bb.termKind = ""
    push this.blocks bb
    this.currentBlock = bb
    return label
  }

  fn emit:LowIRInstr (instr:LowIRInstr) {
    def cur (unwrap this.currentBlock)
    push cur.instrs instr
    if ((strlen instr.dest) > 0) {
      set destTypes instr.dest instr.irType
    }
    return instr
  }

  ; The IR type of an already-emitted value, or "" for a name this builder did
  ; not produce (a parameter, a global).
  fn emittedType:string (value:string) {
    if (has destTypes value) {
      return (unwrap (get destTypes value))
    }
    return ""
  }

  ; Allocas must live in the entry block so their SSA value dominates every
  ; use. Emitting them into a conditional block creates a dynamic alloca whose
  ; pointer is undefined on paths that skip that block.
  fn emitToEntry:LowIRInstr (instr:LowIRInstr) {
    if ((array_length this.blocks) > 0) {
      def entry (itemAt this.blocks 0)
      push entry.instrs instr
      return instr
    }
    return (this.emit(instr))
  }

  fn emitConst:string (irType:string value:string) {
    def tag:string "c"
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "const"
    ins.dest = dest
    ins.irType = irType
    ins.arg1 = value
    this.emit(ins)
    return dest
  }

  fn emitBin:string (kind:string irType:string lhs:string rhs:string) {
    def tag:string "t"
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = kind
    ins.dest = dest
    ins.irType = irType
    ins.arg1 = lhs
    ins.arg2 = rhs
    this.emit(ins)
    return dest
  }

  fn emitIcmp:string (pred:string lhs:string rhs:string) {
    return (this.emitIcmpTyped(pred "i32" lhs rhs))
  }

  fn emitIcmpTyped:string (pred:string operandType:string lhsIn:string rhsIn:string) {
    ; Both operands must have the compared type. The lowering picks it from the
    ; source node and a few shapes hide the truth (a boolean from a C helper, a
    ; captured value), so reconcile against what was emitted.
    def lhs:string (this.coerceTo(lhsIn operandType))
    def rhs:string (this.coerceTo(rhsIn operandType))
    def tag:string "p"
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "icmp"
    ins.dest = dest
    ins.irType = "i1"
    ins.pred = pred
    ins.arg1 = lhs
    ins.arg2 = rhs
    ins.arg3 = operandType
    this.emit(ins)
    return dest
  }

  fn emitPtrToInt:string (ptr:string) {
    def tag:string "pt"
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "ptr_to_int"
    ins.dest = dest
    ins.irType = this.irModule.ptrType
    ins.arg1 = ptr
    this.emit(ins)
    return dest
  }

  fn emitCall:string (fnName:string retType:string args:[string] argTypes:[string]) {
    return (this.emitCallWithSig(fnName retType "" args argTypes))
  }

  fn emitComment:void (text:string) {
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "comment"
    ins.arg1 = text
    this.emit(ins)
  }

  ; Every argument must have the declared parameter type. The lowering decides
  ; these from the source node, which a handful of shapes hide (a captured
  ; collection, an optional over a primitive, a lambda-typed parameter), and a
  ; width mismatch at a call boundary is IR that will not assemble. What the
  ; builder actually EMITTED for a value is known here, so the fix belongs
  ; here: insert the integer widen/narrow rather than leave a broken call.
  fn coerceCallArgs:[string] (args:[string] argTypes:[string]) {
    def out:[string]
    def n (array_length args)
    def i:int 0
    while (i < n) {
      def a:string (itemAt args i)
      def want:string "i32"
      if (i < (array_length argTypes)) {
        want = (itemAt argTypes i)
      }
      def got:string ""
      if (has destTypes a) {
        got = (unwrap (get destTypes a))
      }
      def fixed:string a
      if ((strlen got) > 0) {
        if (got != want) {
          if ((want == "i64") && (got == "i32")) {
            fixed = (this.emitCast("zext" "i64" "i32" a))
          }
          if ((want == "i64") && (got == "i1")) {
            fixed = (this.emitCast("zext" "i64" "i1" a))
          }
          if ((want == "i32") && (got == "i64")) {
            fixed = (this.emitCast("trunc" "i32" "i64" a))
          }
          if ((want == "i32") && (got == "i1")) {
            fixed = (this.emitZextI1ToI32(a))
          }
          ; A missing value answers a zero of the wrong shape when the
          ; parameter is a pointer; a null of the right one keeps the call
          ; well typed.
          if (want == "i8*") {
            if (((got == "i32") || (got == "i64")) || (got == "i1")) {
              fixed = (this.emitIntToI8Ptr(a got))
            }
          }
          ; ...and the mirror: a pointer where an integer is declared.
          if (got == "i8*") {
            if ((want == "i32") || (want == "i64")) {
              def asInt (this.emitPtrToInt(a))
              fixed = asInt
              if (want == "i32") {
                if (this.irModule.ptrType == "i64") {
                  fixed = (this.emitCast("trunc" "i32" "i64" asInt))
                }
              }
            }
          }
        }
      }
      push out fixed
      i = i + 1
    }
    return out
  }

  fn emitCallWithSig:string (fnName:string retType:string callSig:string rawArgs:[string] argTypes:[string]) {
    def args (this.coerceCallArgs(rawArgs argTypes))
    def voidType:string "void"
    if (retType == voidType) {
      def ins@(lives):LowIRInstr (new LowIRInstr())
      ins.op = "call"
      ins.fnName = fnName
      ins.irType = voidType
      ins.callArgs = args
      ins.callTypes = argTypes
      ins.callSig = callSig
      this.emit(ins)
      return ""
    }
    def tag:string "c"
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "call"
    ins.dest = dest
    ins.fnName = fnName
    ins.irType = retType
    ins.callArgs = args
    ins.callTypes = argTypes
    ins.callSig = callSig
    this.emit(ins)
    return dest
  }

  fn emitAllocaStruct:string (className:string slotName:string fieldCount:int) {
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "alloca_struct"
    ins.dest = slotName
    ins.structName = className
    ins.structSize = fieldCount
    this.emitToEntry(ins)
    return slotName
  }

  fn emitGep:string (className:string structPtr:string fieldIndex:int) {
    def tag:string "f"
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "gep"
    ins.dest = dest
    ins.structName = className
    ins.arg1 = structPtr
    ins.fieldIndex = fieldIndex
    this.emit(ins)
    return dest
  }

  fn emitAlloca:string (irType:string slotName:string) {
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "alloca"
    ins.dest = slotName
    ins.irType = irType
    this.emitToEntry(ins)
    return slotName
  }

  fn emitZeroInitToEntry:void (irType:string slotName:string) {
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "store"
    ins.irType = irType
    ins.arg1 = "0"
    ins.arg2 = slotName
    this.emitToEntry(ins)
  }

  ; emitZeroInitToEntry for a POINTER slot. LLVM rejects an integer 0 as a
  ; pointer operand, so a slot declared `i8*` has to be initialised with `null`.
  fn emitNullInitToEntry:void (irType:string slotName:string) {
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "store"
    ins.irType = irType
    ins.arg1 = "null"
    ins.arg2 = slotName
    this.emitToEntry(ins)
  }

  fn emitLoad:string (irType:string slotName:string) {
    def tag:string "v"
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "load"
    ins.dest = dest
    ins.irType = irType
    ins.arg1 = slotName
    this.emit(ins)
    return dest
  }

  fn emitStore:void (irType:string valueIn:string slotName:string) {
    ; The stored value has to have the slot's type. Every mismatch the lowering
    ; could not see from the source node -- a captured collection, an optional
    ; over a primitive, a boolean from a C helper -- otherwise lands here as
    ; `store i64 <i32 value>`, which does not assemble.
    def value:string (this.coerceTo(valueIn irType))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "store"
    ins.irType = irType
    ins.arg1 = value
    ins.arg2 = slotName
    this.emit(ins)
  }

  fn emitHeapAlloc:string (byteCount:string) {
    def ptrType (this.irModule.ptrType)
    def sizeArg:string byteCount
    if (ptrType == "i64") {
      sizeArg = (this.emitZextI32ToPtr(byteCount))
    }
    if this.irModule.useLibcHeap {
      def one (this.emitConst(ptrType "1"))
      def args:[string]
      def argTypes:[string]
      push args one
      push argTypes ptrType
      push args sizeArg
      push argTypes ptrType
      return (this.emitCall("calloc" ptrType args argTypes))
    }
    ; freestanding WASM under -wasmrc: allocate from the free-list Heap so the
    ; block can later be freed (Heap.alloc zeroes nothing, but collection/new
    ; code initialises what it needs). One coherent heap for all allocation.
    if this.irModule.useFreeListHeap {
      def hargs:[string]
      def hargTypes:[string]
      push hargs sizeArg
      push hargTypes "i32"
      return (this.emitCall("Heap_calloc" ptrType hargs hargTypes))
    }
    def tag:string "h"
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "heap_alloc"
    ins.dest = dest
    ins.irType = ptrType
    ins.arg1 = sizeArg
    this.emit(ins)
    return dest
  }

  fn emitIntToI8Ptr:string (addr:string addrTypeIn:string) {
    def tag:string "s"
    ; The SOURCE width has to match the value: an i32 handed to `inttoptr i64`
    ; does not assemble. Trust what was emitted for it over what the caller
    ; assumed.
    def addrType:string addrTypeIn
    def addrVal:string addr
    if (has destTypes addr) {
      def at:string (unwrap (get destTypes addr))
      if ((at == "i32") || (at == "i64")) {
        addrType = at
      }
      ; An i1 is not an address at all. Widening it first keeps the
      ; instruction well formed; the value was already wrong upstream.
      if (at == "i1") {
        addrVal = (this.emitZextI1ToI32(addr))
        addrType = "i32"
      }
    }
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "inttoptr_i8"
    ins.dest = dest
    ; The result IS an i8*. Leaving irType at its i32 default made destTypes
    ; report a pointer as a 32-bit integer, and every decision that consults it
    ; (widen-before-push, condition type, comparison width) then went wrong.
    ins.irType = "i8*"
    ins.arg1 = addrVal
    ins.arg2 = addrType
    this.emit(ins)
    return dest
  }

  fn emitIntToStructPtr:string (className:string addr:string) {
    def tag:string "p"
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "inttoptr_struct"
    ins.dest = dest
    ins.structName = className
    ins.arg1 = addr
    ins.arg2 = this.irModule.ptrType
    ins.irType = (LowIRUtil.structPtrType(className))
    this.emit(ins)
    return dest
  }

  fn emitCast:string (castOp:string destType:string srcTypeIn:string value:string) {
    def tag:string "cast"
    ; The SOURCE type has to be the one the value really has: a widen written
    ; as `zext i32 <i1 value>` does not assemble. Callers name the type they
    ; expect, and a handful of shapes (a boolean from a map or an array) hand
    ; over an i1 instead.
    def srcType:string srcTypeIn
    if (has destTypes value) {
      def got:string (unwrap (get destTypes value))
      if ((got == "i1") || (got == "i32")) {
        if ((srcTypeIn == "i1") || (srcTypeIn == "i32")) {
          srcType = got
        }
      }
    }
    if (srcType == destType) {
      return value
    }
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = castOp
    ins.dest = dest
    ins.irType = destType
    ins.arg1 = value
    ins.arg2 = srcType
    this.emit(ins)
    return dest
  }

  fn emitZextI1ToI32:string (v:string) {
    def tag:string "z"
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "zext_i1"
    ins.dest = dest
    ins.irType = "i32"
    ins.arg1 = v
    this.emit(ins)
    return dest
  }

  fn emitZextI32ToPtr:string (v:string) {
    def pt (this.irModule.ptrType)
    if (pt == "i32") {
      return v
    }
    def tag:string "z"
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "zext"
    ins.dest = dest
    ins.irType = pt
    ins.arg1 = v
    this.emit(ins)
    return dest
  }

  ; The integer width an ADDRESS value actually has. Defaults to the module's
  ; pointer type for anything this builder did not produce.
  fn addrWidthOf:string (ptr:string) {
    if (has destTypes ptr) {
      def t:string (unwrap (get destTypes ptr))
      if ((t == "i32") || (t == "i64")) {
        return t
      }
    }
    return this.irModule.ptrType
  }

  fn emitPtrLoad:string (ptr:string) {
    return (this.emitPtrLoadTyped(ptr this.irModule.ptrType))
  }

  fn emitPtrLoadTyped:string (ptr:string valueType:string) {
    def tag:string "m"
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "ptr_load"
    ins.dest = dest
    ins.irType = valueType
    ins.arg1 = ptr
    ; The ADDRESS operand's width has to match the value: an i32 address in an
    ; `inttoptr i64` does not assemble.
    ins.arg2 = (this.addrWidthOf(ptr))
    this.emit(ins)
    return dest
  }

  fn emitPtrStore:void (ptr:string value:string) {
    this.emitPtrStoreTyped(ptr value this.irModule.ptrType)
  }

  fn emitPtrStoreTyped:void (ptr:string value:string valueType:string) {
    def n (this.tempCounter)
    this.tempCounter = n + 1
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "ptr_store"
    ins.dest = ("ps" + ("" + n))
    ins.irType = valueType
    ins.arg1 = ptr
    ins.arg2 = (this.coerceTo(value valueType))
    ins.arg3 = (this.addrWidthOf(ptr))
    this.emit(ins)
  }

  fn emitPtrLoad8:string (ptr:string) {
    def dest (this.freshTemp("m"))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "ptr_load8"
    ins.dest = dest
    ins.irType = "i32"
    ins.arg1 = ptr
    this.emit(ins)
    return dest
  }

  fn emitPtrStore8:void (ptr:string value:string) {
    def n (this.tempCounter)
    this.tempCounter = n + 1
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "ptr_store8"
    ins.dest = ("ps" + ("" + n))
    ins.arg1 = ptr
    ins.arg2 = value
    this.emit(ins)
  }

  ; current linear-memory size in 64 KiB pages (wasm memory.size)
  fn emitMemSize:string () {
    def dest (this.freshTemp("m"))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "mem_size"
    ins.dest = dest
    ins.irType = "i32"
    this.emit(ins)
    return dest
  }

  ; grow linear memory by `pages` 64 KiB pages; result = previous page count, or
  ; -1 on failure (wasm memory.grow)
  fn emitMemGrow:string (pages:string) {
    def dest (this.freshTemp("m"))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "mem_grow"
    ins.dest = dest
    ins.irType = "i32"
    ins.arg1 = pages
    this.emit(ins)
    return dest
  }

  ; read a named mutable wasm global (wasm global.get)
  fn emitGlobalGet:string (name:string) {
    def dest (this.freshTemp("g"))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "global_get"
    ins.dest = dest
    ins.irType = this.irModule.ptrType
    ins.arg1 = name
    this.emit(ins)
    return dest
  }

  ; write a named mutable wasm global (wasm global.set)
  fn emitGlobalSet:void (name:string value:string) {
    def n (this.tempCounter)
    this.tempCounter = n + 1
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "global_set"
    ins.dest = ("gs" + ("" + n))
    ins.irType = this.irModule.ptrType
    ins.arg1 = name
    ins.arg2 = value
    this.emit(ins)
  }

  ; table index of a hoisted lambda function (i32) — the writer resolves the
  ; name to its position in the module's lambda function table.
  fn emitFuncRef:string (name:string) {
    def dest (this.freshTemp("fr"))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "func_ref"
    ins.dest = dest
    ins.irType = "i32"
    ins.arg1 = name
    this.emit(ins)
    return dest
  }

  ; indirect call through the function table. args already include the closure
  ; env as the first entry; `selector` is the table index (fn_index) loaded from
  ; the closure record. callSig ("t0,t1,…:ret") selects the wasm (type …).
  fn emitCallIndirect:string (retType:string callSig:string rawArgs:[string] argTypes:[string] selector:string) {
    def args (this.coerceCallArgs(rawArgs argTypes))
    def voidType:string "void"
    if (retType == voidType) {
      def ins@(lives):LowIRInstr (new LowIRInstr())
      ins.op = "call_indirect"
      ins.irType = voidType
      ins.callArgs = args
      ins.callTypes = argTypes
      ins.callSig = callSig
      ins.arg1 = selector
      this.emit(ins)
      return ""
    }
    def dest (this.freshTemp("ci"))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "call_indirect"
    ins.dest = dest
    ins.irType = retType
    ins.callArgs = args
    ins.callTypes = argTypes
    ins.callSig = callSig
    ins.arg1 = selector
    this.emit(ins)
    return dest
  }

  fn emitI32At:string (base:string byteOff:int) {
    def pt (this.irModule.ptrType)
    def off (this.emitConst(pt ("" + byteOff)))
    def addr (this.emitBin("add" pt base off))
    return (this.emitPtrLoadTyped(addr "i32"))
  }

  fn emitStoreI32At:void (base:string byteOff:int value:string) {
    def pt (this.irModule.ptrType)
    def off (this.emitConst(pt ("" + byteOff)))
    def addr (this.emitBin("add" pt base off))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "ptr_store"
    ins.irType = "i32"
    ins.arg1 = addr
    ins.arg2 = (this.coerceTo(value "i32"))
    ins.arg3 = (this.addrWidthOf(addr))
    this.emit(ins)
  }

  ; Typed variants of the two above. The closure record used the i32 pair for
  ; every capture, which truncated a pointer on a 64-bit target -- and the
  ; store said i32 while emitLoadI32At read a pointer-sized word back, so the
  ; two did not even agree with each other.
  fn emitStoreTypedAt:void (base:string byteOff:int value:string valueType:string) {
    def pt (this.irModule.ptrType)
    def off (this.emitConst(pt ("" + byteOff)))
    def addr (this.emitBin("add" pt base off))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "ptr_store"
    ins.irType = valueType
    ins.arg1 = addr
    ins.arg2 = (this.coerceTo(value valueType))
    ins.arg3 = (this.addrWidthOf(addr))
    this.emit(ins)
  }

  fn emitLoadTypedAt:string (base:string byteOff:int valueType:string) {
    def pt (this.irModule.ptrType)
    if (byteOff == 0) {
      return (this.emitPtrLoadTyped(base valueType))
    }
    def off (this.emitConst(pt ("" + byteOff)))
    def addr (this.emitBin("add" pt base off))
    return (this.emitPtrLoadTyped(addr valueType))
  }

  fn emitLoadI32At:string (base:string byteOff:int) {
    def pt (this.irModule.ptrType)
    if (byteOff == 0) {
      return (this.emitPtrLoad(base))
    }
    def off (this.emitConst(pt ("" + byteOff)))
    def addr (this.emitBin("add" pt base off))
    return (this.emitPtrLoad(addr))
  }

  fn emitStrPtr:string (globalName:string byteLen:int) {
    def tag:string "s"
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "str_ptr"
    ins.dest = dest
    ins.irType = "i8*"
    ins.arg1 = globalName
    ins.arg2 = ("" + byteLen)
    this.emit(ins)
    return dest
  }

  ; Address of a class type descriptor in the static data segment (WASM). The
  ; writer resolves the class name to the descriptor's data-segment address.
  fn emitTypeDescPtr:string (className:string) {
    def tag:string "td"
    def dest (this.freshTemp(tag))
    def ins@(lives):LowIRInstr (new LowIRInstr())
    ins.op = "typedesc_ptr"
    ins.dest = dest
    ; An address, so it is as wide as one. It was pinned to i32, which is right
    ; only on wasm; on a 64-bit native target a comparison against it was made
    ; at the wrong width.
    ins.irType = this.irModule.ptrType
    ins.arg1 = className
    this.emit(ins)
    return dest
  }

  fn terminateRet:void (retType:string value:string) {
    def cur (unwrap this.currentBlock)
    cur.termKind = "ret"
    cur.termType = retType
    cur.termValue = value
  }

  fn terminateBr:void (target:string) {
    def cur (unwrap this.currentBlock)
    cur.termKind = "br"
    cur.termTarget = target
  }

  ; A branch condition must be an i1. A few lowerings hand over the raw i32 a
  ; C helper answered; comparing it against zero here is what every consumer
  ; meant anyway.
  ; Adjust an already-emitted value to `want`, when the change is an ordinary
  ; integer widen/narrow or a pointer/integer reinterpretation.
  fn coerceTo:string (v:string want:string) {
    if ((has destTypes v) == false) {
      return v
    }
    def got:string (unwrap (get destTypes v))
    if (got == want) {
      return v
    }
    if ((want == "i1") && ((got == "i32") || (got == "i64"))) {
      def z (this.emitConst(got "0"))
      return (this.emitIcmpTyped("ne" got v z))
    }
    if ((want == "i32") && (got == "i1")) {
      return (this.emitZextI1ToI32(v))
    }
    if ((want == "i64") && (got == "i1")) {
      return (this.emitCast("zext" "i64" "i1" v))
    }
    if ((want == "i64") && (got == "i32")) {
      return (this.emitCast("zext" "i64" "i32" v))
    }
    if ((want == "i32") && (got == "i64")) {
      return (this.emitCast("trunc" "i32" "i64" v))
    }
    if ((want == "i8*") && ((got == "i32") || (got == "i64") || (got == "i1"))) {
      return (this.emitIntToI8Ptr(v got))
    }
    if (got == "i8*") {
      if ((want == "i32") || (want == "i64")) {
        def asInt (this.emitPtrToInt(v))
        if (want == "i32") {
          if (this.irModule.ptrType == "i64") {
            return (this.emitCast("trunc" "i32" "i64" asInt))
          }
        }
        return asInt
      }
    }
    return v
  }

  fn asI1:string (v:string) {
    if (has destTypes v) {
      def t:string (unwrap (get destTypes v))
      if (t == "i1") {
        return v
      }
      if ((t == "i32") || (t == "i64")) {
        def z (this.emitConst(t "0"))
        return (this.emitIcmpTyped("ne" t v z))
      }
    }
    return v
  }

  fn terminateBrIf:void (cond:string ifTrue:string ifFalse:string) {
    cond = (this.asI1(cond))
    def cur (unwrap this.currentBlock)
    cur.termKind = "br_if"
    cur.termValue = cond
    cur.termIfTrue = ifTrue
    cur.termIfFalse = ifFalse
  }

  fn terminateUnreachable:void () {
    def cur (unwrap this.currentBlock)
    cur.termKind = "unreachable"
  }

  fn finishFunction:string (name:string retType:string params:[LowIRParam] exportFn:boolean isMain:boolean) {
    if (!null? this.currentBlock) {
      def cur (unwrap this.currentBlock)
      if (cur.termKind == "") {
        cur.termKind = "ret"
        cur.termType = retType
      }
    }
    def fn@(lives):LowIRFunction (new LowIRFunction())
    fn.name = name
    fn.returnType = retType
    fn.params = params
    fn.blocks = this.blocks
    fn.exportFn = exportFn
    fn.isMain = isMain
    push this.irModule.functions fn
    return name
  }
}

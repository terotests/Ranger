
Import "ng_LowIR.rgr"
Import "ng_LowIRRuntime.rgr"
Import "ng_LowIRTarget.rgr"

class LowIRLowerContext {
  def ctx@(weak):RangerAppWriterContext
  def builder:LowIRBuilder
  def target:LowIRTarget
  def ptrType:string "i32"
  def slots:[string:string]
  def slotTypes:[string:string]
  def objectSlots:[string:string]
  def collectionSlots:[string:string]
  def ptrArrayElemTypes:[string:string]
  def ownedObjectLocals:[string]
  def ownedCollectionLocals:[string]
  def escapedLocals:[string:string]
  def currentRetType:string "i32"
  def llvmRetType:string "i32"
  def className:string ""
  def selfPtr:string ""
}

class LowIRBuilderPass {
  def irModule:LowIRModule (new LowIRModule())
  def usedMapRuntime:boolean false
  def usedArrayRuntime:boolean false
  def usedPtrArrayRuntime:boolean false
  def usedMemRuntime:boolean false

  fn canLowerFunction:boolean (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext) {
    if (fnDesc.is_static == false) {
      return false
    }
    return (this.canLowerMethod(fnDesc))
  }

  fn canLowerMethod:boolean (fnDesc:RangerAppFunctionDesc) {
    if (fnDesc.name == "Constructor") {
      for fnDesc.params p:RangerAppParamDesc i {
        if (null? p.nameNode) {
          return false
        }
        def pn (unwrap p.nameNode)
        def paramTypeName (this.varTypeName(pn))
        if (false == (this.isLowerableParamType(paramTypeName))) {
          return false
        }
      }
      return true
    }
    if (null? fnDesc.nameNode) {
      return false
    }
    def retNode (unwrap fnDesc.nameNode)
    def retTypeName (this.varTypeName(retNode))
    def retType (LowIRUtil.typeFromRanger(retTypeName))
    def voidType:string "void"
    if ((strlen retType) == 0) {
      if (fnDesc.name == "Constructor") {
        retType = voidType
      } {
        if (LowIRUtil.isStringType(retTypeName)) {
          retType = "i8*"
        } {
          if (LowIRUtil.isArrayTypeName(retTypeName)) {
            retType = this.irModule.ptrType
          } {
            if ((strlen retTypeName) > 0) {
              if (LowIRUtil.isSupportedPrimitive(retTypeName) == false) {
                retType = this.irModule.ptrType
              } {
                return false
              }
            } {
              return false
            }
          }
        }
      }
    }
    for fnDesc.params p:RangerAppParamDesc i {
      if (null? p.nameNode) {
        return false
      }
      def pn (unwrap p.nameNode)
      def paramTypeName (this.varTypeName(pn))
      if (false == (this.isLowerableParamType(paramTypeName))) {
        return false
      }
    }
    return true
  }

  fn canLowerInstanceMethod:boolean (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext) {
    if fnDesc.is_static {
      return false
    }
    return (this.canLowerMethod(fnDesc))
  }

  fn isMainEntry:boolean (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext) {
    if (null? fnDesc.nameNode) {
      return false
    }
    def nn (unwrap fnDesc.nameNode)
    if (nn.hasFlag("main")) {
      if (nn.code.filename == (ctx.getRootFile())) {
        return true
      }
    }
    return false
  }

  fn shouldExport:boolean (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext) {
    if (this.isMainEntry(fnDesc ctx)) {
      return true
    }
    if (ctx.hasCompilerFlag("freestanding")) {
      return true
    }
    if (fnDesc.name == "main") {
      return false
    }
    if (fnDesc.is_static == false) {
      return false
    }
    return (this.canLowerFunction(fnDesc ctx))
  }

  fn lowerModule:LowIRModule (appCtx:RangerAppWriterContext) {
    def moduleName:string "ranger_module"
    def session (LowIRSession.current())
    session.beginModule(moduleName)
    this.irModule = session.module
    def target (LowIRTarget.resolve(appCtx))
    this.irModule.triple = target.triple
    this.irModule.ptrType = target.ptrType
    this.irModule.useLibcHeap = target.usesLibc
    if target.usesLibc {
      this.ensureLibcExtern(target)
    }

    for appCtx.definedClassList cName:string i {
      if (cName == "RangerStaticMethods") {
        continue _
      }
      def cl (unwrap (get appCtx.definedClasses cName))
      if (cl.is_operator_class || cl.is_trait || cl.is_system || cl.is_union) {
        continue
      }
      this.lowerStruct(cl appCtx)
      for cl.static_methods m:RangerAppFunctionDesc i {
        if (cl.name == "Mem") {
          continue
        }
        if (cl.name == "RangerMem") {
          continue
        }
        if (this.canLowerFunction(m appCtx)) {
          def isMain (this.isMainEntry(m appCtx))
          this.lowerFunction(m cl.name appCtx (this.shouldExport(m appCtx)) isMain false)
        }
      }
      if cl.has_constructor {
        if (!null? cl.constructor_fn) {
          def ctor (unwrap cl.constructor_fn)
          if (this.canLowerMethod(ctor)) {
            this.lowerFunction(ctor cl.name appCtx false false true)
          }
        } {
          for cl.methods m:RangerAppFunctionDesc i {
            if (m.name == "Constructor") {
              if (this.canLowerMethod(m)) {
                this.lowerFunction(m cl.name appCtx false false true)
              }
            }
          }
        }
      }
      for cl.methods m:RangerAppFunctionDesc i {
        if (m.name == "Constructor") {
          continue
        }
        if (this.canLowerInstanceMethod(m appCtx)) {
          this.lowerFunction(m cl.name appCtx false false true)
        }
      }
    }
    if this.usedArrayRuntime {
      LowIRRuntimeGen.ensureArrayRuntime(this.irModule)
    }
    if this.usedMapRuntime {
      LowIRRuntimeGen.ensureMapRuntime(this.irModule)
    }
    if this.usedPtrArrayRuntime {
      LowIRRuntimeGen.ensurePtrArrayRuntime(this.irModule)
    }
    if this.usedMemRuntime {
      this.ensureMemExtern(target)
    }
    return this.irModule
  }

  fn ensureExternDecl:void (fnName:string retType:string paramTypes:[string] isVararg:boolean) {
    if (this.hasExternDecl(fnName)) {
      return
    }
    def decl@(lives):LowIRExternDecl (new LowIRExternDecl())
    decl.fnName = fnName
    decl.retType = retType
    decl.isVararg = isVararg
    for paramTypes pt:string i {
      push decl.paramTypes pt
    }
    push this.irModule.externDecls decl
  }

  fn ensureLibcExtern:void (target:LowIRTarget) {
    def ioParams:[string]
    push ioParams "i8*"
    this.ensureExternDecl(target.ioFn target.ioFnRet ioParams target.ioFnVararg)
    def mallocParams:[string]
    push mallocParams target.ptrType
    this.ensureExternDecl("malloc" target.ptrType mallocParams false)
    def callocParams:[string]
    push callocParams target.ptrType
    push callocParams target.ptrType
    this.ensureExternDecl("calloc" target.ptrType callocParams false)
    def reallocParams:[string]
    push reallocParams target.ptrType
    push reallocParams target.ptrType
    this.ensureExternDecl("realloc" target.ptrType reallocParams false)
    def strcmpParams:[string]
    push strcmpParams "i8*"
    push strcmpParams "i8*"
    this.ensureExternDecl("strcmp" "i32" strcmpParams false)
    def strlenParams:[string]
    push strlenParams "i8*"
    this.ensureExternDecl("strlen" "i32" strlenParams false)
    def termInitParams:[string]
    this.ensureExternDecl("ranger_term_init" "void" termInitParams false)
    def pollParams:[string]
    this.ensureExternDecl("ranger_poll_key" "i8*" pollParams false)
    def termVoidParams:[string]
    this.ensureExternDecl("ranger_clear_screen" "void" termVoidParams false)
    this.ensureExternDecl("ranger_hide_cursor" "void" termVoidParams false)
    this.ensureExternDecl("ranger_show_cursor" "void" termVoidParams false)
    def moveParams:[string]
    push moveParams "i32"
    push moveParams "i32"
    this.ensureExternDecl("ranger_move_cursor" "void" moveParams false)
    def sprintfParams:[string]
    push sprintfParams "i8*"
    push sprintfParams "i8*"
    this.ensureExternDecl("sprintf" "i32" sprintfParams true)
    def shellCntParams:[string]
    this.ensureExternDecl("ranger_shell_arg_cnt" "i32" shellCntParams false)
    def shellArgParams:[string]
    push shellArgParams "i32"
    this.ensureExternDecl("ranger_shell_arg" "i8*" shellArgParams false)
    def readFileParams:[string]
    push readFileParams "i8*"
    push readFileParams "i8*"
    this.ensureExternDecl("ranger_read_file" "i8*" readFileParams false)
    def charAtParams:[string]
    push charAtParams "i8*"
    push charAtParams "i32"
    this.ensureExternDecl("ranger_char_at" "i32" charAtParams false)
    def atCharParams:[string]
    push atCharParams "i8*"
    push atCharParams "i32"
    this.ensureExternDecl("ranger_at_char" "i8*" atCharParams false)
    def substringParams:[string]
    push substringParams "i8*"
    push substringParams "i32"
    push substringParams "i32"
    this.ensureExternDecl("ranger_substring" "i8*" substringParams false)
    def str2dblParams:[string]
    push str2dblParams "i8*"
    this.ensureExternDecl("ranger_str2double" "f64" str2dblParams false)
    def str2intParams:[string]
    push str2intParams "i8*"
    this.ensureExternDecl("ranger_str2int" "i32" str2intParams false)
    def cliInitParams:[string]
    push cliInitParams "i32"
    push cliInitParams "i8**"
    this.ensureExternDecl("ranger_cli_init" "void" cliInitParams false)
    def strdupParams:[string]
    push strdupParams "i8*"
    this.ensureExternDecl("ranger_strdup" "i8*" strdupParams false)
    def fromCodeParams:[string]
    push fromCodeParams "i32"
    this.ensureExternDecl("ranger_str_fromcode" "i8*" fromCodeParams false)
    def fromByteParams:[string]
    push fromByteParams "i32"
    this.ensureExternDecl("ranger_str_frombyte" "i8*" fromByteParams false)
    def freeParams:[string]
    push freeParams "i8*"
    this.ensureExternDecl("free" "void" freeParams false)
    this.ensureBufferExtern(target)
  }

  fn ensureBufferExtern:void (target:LowIRTarget) {
    if (this.hasExternDecl("ranger_buffer_alloc")) {
      return
    }
    def ptrType (target.ptrType)
    def allocParams:[string]
    push allocParams "i32"
    this.ensureExternDecl("ranger_buffer_alloc" ptrType allocParams false)
    def bufLenParams:[string]
    push bufLenParams ptrType
    this.ensureExternDecl("ranger_buffer_length" "i32" bufLenParams false)
    def bufGetParams:[string]
    push bufGetParams ptrType
    push bufGetParams "i32"
    this.ensureExternDecl("ranger_buffer_get" "i32" bufGetParams false)
    def bufSetParams:[string]
    push bufSetParams ptrType
    push bufSetParams "i32"
    push bufSetParams "i32"
    this.ensureExternDecl("ranger_buffer_set" "void" bufSetParams false)
    def bufReadParams:[string]
    push bufReadParams "i8*"
    push bufReadParams "i8*"
    this.ensureExternDecl("ranger_buffer_read_file" ptrType bufReadParams false)
    def bufWriteParams:[string]
    push bufWriteParams "i8*"
    push bufWriteParams "i8*"
    push bufWriteParams ptrType
    this.ensureExternDecl("ranger_buffer_write_file" "void" bufWriteParams false)
    def relParams:[string]
    push relParams ptrType
    this.ensureExternDecl("ranger_buffer_release" "void" relParams false)
    def intAllocParams:[string]
    push intAllocParams "i32"
    this.ensureExternDecl("ranger_int_buffer_alloc" ptrType intAllocParams false)
    def intGetParams:[string]
    push intGetParams ptrType
    push intGetParams "i32"
    this.ensureExternDecl("ranger_int_buffer_get" "i32" intGetParams false)
    def intSetParams:[string]
    push intSetParams ptrType
    push intSetParams "i32"
    push intSetParams "i32"
    this.ensureExternDecl("ranger_int_buffer_set" "void" intSetParams false)
    def intFillParams:[string]
    push intFillParams ptrType
    push intFillParams "i32"
    push intFillParams "i32"
    push intFillParams "i32"
    this.ensureExternDecl("ranger_int_buffer_fill" "void" intFillParams false)
    this.ensureExternDecl("ranger_int_buffer_release" "void" relParams false)
  }

  fn ensureMemExtern:void (target:LowIRTarget) {
    if (this.hasExternDecl("ranger_obj_new")) {
      return
    }
    def destroyTy:string "ptr"
    def declSig:string "(i32, ptr)"
    def objNewParams:[string]
    push objNewParams "i32"
    push objNewParams destroyTy
    def decl@(lives):LowIRExternDecl (new LowIRExternDecl())
    decl.fnName = "ranger_obj_new"
    decl.retType = target.ptrType
    decl.paramTypes = objNewParams
    decl.declSig = declSig
    push this.irModule.externDecls decl
    def relParams:[string]
    push relParams target.ptrType
    this.ensureExternDecl("ranger_obj_release" "void" relParams false)
    def strRelParams:[string]
    push strRelParams "i8*"
    this.ensureExternDecl("ranger_str_release" "void" strRelParams false)
    def liveParams:[string]
    this.ensureExternDecl("ranger_mem_live_objects" "i32" liveParams false)
    def voidParams:[string]
    this.ensureExternDecl("ranger_mem_reset_stats" "void" voidParams false)
    this.ensureExternDecl("ranger_obj_retain" "void" relParams false)
    def pushOwnedParams:[string]
    push pushOwnedParams target.ptrType
    push pushOwnedParams target.ptrType
    this.ensureExternDecl("ranger_ptrarray_push_owned" "void" pushOwnedParams false)
    this.ensureExternDecl("ranger_ptrarray_release" "void" relParams false)
  }

  fn memEnabled:boolean (lctx:LowIRLowerContext) {
    def memTarget (LowIRTarget.resolve((unwrap lctx.ctx)))
    if (memTarget.usesLibc == false) {
      return false
    }
    return this.usedMemRuntime
  }

  ; Object reference-counting enabled: the libc path (full RC), OR the WASM
  ; free-list path under -wasmrc. This gates ONLY the object new/release path;
  ; string/array RC stays behind memEnabled/usesLibc because their WASM runtime
  ; (ranger_ptrarray_*, ranger_str_*) is not emitted yet (PLAN_WASM_MEMORY v2).
  fn objRcEnabled:boolean (lctx:LowIRLowerContext) {
    def memTarget (LowIRTarget.resolve((unwrap lctx.ctx)))
    if (memTarget.usesLibc) {
      return true
    }
    def ctx (unwrap lctx.ctx)
    return (ctx.hasCompilerFlag("wasmrc"))
  }

  ; The freestanding-WASM string runtime (ranger_str_*) is in play: non-libc
  ; target under -wasmrc. When true, string ops route to the WASM-native runtime
  ; (ranger_str_len/concat/from_int/dup/cmp) instead of libc (strlen/sprintf/...).
  fn wasmStrEnabled:boolean (lctx:LowIRLowerContext) {
    def memTarget (LowIRTarget.resolve((unwrap lctx.ctx)))
    if (memTarget.usesLibc) {
      return false
    }
    def ctx (unwrap lctx.ctx)
    return (ctx.hasCompilerFlag("wasmrc"))
  }

  fn isLowerableParamType:boolean (typeName:string) {
    if (LowIRUtil.isSupportedParam(typeName)) {
      return true
    }
    if ((strlen typeName) == 0) {
      return false
    }
    if (LowIRUtil.isArrayTypeName(typeName)) {
      return true
    }
    return true
  }

  fn llvmTypeForRanger:string (typeName:string ptrType:string) {
    if (LowIRUtil.isStringType(typeName)) {
      return "i8*"
    }
    if (LowIRUtil.isBufferTypeName(typeName)) {
      return ptrType
    }
    if (LowIRUtil.isArrayTypeName(typeName)) {
      return ptrType
    }
    def mapped (LowIRUtil.typeFromRanger(typeName))
    if ((strlen mapped) > 0) {
      return mapped
    }
    return ptrType
  }

  fn varTypeName:string (nameNode:CodeNode) {
    if ((strlen nameNode.type_name) > 0) {
      return nameNode.type_name
    }
    if (nameNode.value_type == RangerNodeType.Array) {
      if ((strlen nameNode.array_type) > 0) {
        return ("[" + nameNode.array_type + "]")
      }
    }
    return nameNode.eval_type_name
  }

  fn exprIsObjectPtr:boolean (node:CodeNode lctx:LowIRLowerContext) {
    if (node.hasNewOper) {
      return true
    }
    if (node.value_type != RangerNodeType.VRef) {
      return false
    }
    if ((indexOf node.vref ".") >= 0) {
      def parts:[string] (strsplit node.vref ".")
      if ((array_length parts) >= 2) {
        def recv (itemAt parts 0)
        def fld (itemAt parts 1)
        def cls (this.resolveObjectClass(recv lctx))
        if ((strlen cls) > 0) {
          if (this.fieldIsStringSlot(cls fld)) {
            return false
          }
          if (this.fieldIsBufferSlot(cls fld)) {
            return false
          }
          if (this.fieldIsBoolSlot(cls fld)) {
            return false
          }
          if (this.fieldIsPtrArraySlot(cls fld)) {
            return false
          }
          def ftype (this.fieldIrTypeFor(cls fld))
          if (ftype == "i32") {
            return false
          }
          return true
        }
      }
    }
    if (this.isClassField(node.vref lctx.className this.irModule)) {
      if (this.fieldIsStringSlot(lctx.className node.vref)) {
        return false
      }
      if (this.fieldIsBufferSlot(lctx.className node.vref)) {
        return false
      }
      if (this.fieldIsBoolSlot(lctx.className node.vref)) {
        return false
      }
      if (this.fieldIsPtrArraySlot(lctx.className node.vref)) {
        return false
      }
      def ftype (this.fieldIrTypeFor(lctx.className node.vref))
      if (ftype == "i32") {
        return false
      }
      return true
    }
    if (has lctx.objectSlots node.vref) {
      return true
    }
    return false
  }

  fn isObjectTypeName:boolean (typeName:string) {
    if ((strlen typeName) == 0) {
      return false
    }
    if (LowIRUtil.isStringType(typeName)) {
      return false
    }
    if (LowIRUtil.isArrayTypeName(typeName)) {
      return false
    }
    if (LowIRUtil.isBufferTypeName(typeName)) {
      return false
    }
    if (LowIRUtil.isSupportedPrimitive(typeName)) {
      return false
    }
    return true
  }

  fn exprIsString:boolean (node:CodeNode) {
    if (node.value_type == RangerNodeType.String) {
      return true
    }
    if (node.expression) {
      for node.children item:CodeNode i {
        if (this.exprIsString(item)) {
          return true
        }
      }
    }
    return false
  }

  fn exprMightBeString:boolean (node:CodeNode lctx:LowIRLowerContext) {
    if (this.exprIsStringish(node lctx)) {
      return true
    }
    if (node.has_operator) {
      def op (node.getOperator())
      if (op == "+") {
        def aNode (node.getSecond())
        def bNode (node.getThird())
        if ((this.exprIsStringish(aNode lctx)) || (this.exprIsStringish(bNode lctx))) {
          return true
        }
      }
    }
    if (node.infix_operator) {
      if (!null? node.infix_node) {
        return (this.exprMightBeString((unwrap node.infix_node) lctx))
      }
    }
    return false
  }

  fn lowerConcatOperand:string (node:CodeNode isStr:boolean lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def v (this.lowerExpr(node lctx))
    if (isStr == false) {
      if (this.exprProducesI1(node lctx)) {
        v = (builder.emitZextI1ToI32(v))
      }
    }
    return v
  }

  fn emitStrdupExpr:string (strPtr:string lctx:LowIRLowerContext) {
    def dupArgs:[string]
    def dupArgTypes:[string]
    push dupArgs strPtr
    push dupArgTypes "i8*"
    def dupFn:string "ranger_strdup"
    if (this.wasmStrEnabled(lctx)) {
      dupFn = "ranger_str_dup"
    }
    return (lctx.builder.emitCall(dupFn "i8*" dupArgs dupArgTypes))
  }

  fn lowerStringConcat:string (aNode:CodeNode bNode:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def aStr (this.exprIsStringish(aNode lctx))
    def bStr (this.exprIsStringish(bNode lctx))
    if (this.exprIsString(aNode)) {
      aStr = true
    }
    if (this.exprIsString(bNode)) {
      bStr = true
    }
    ; freestanding WASM: convert int operands to strings, then ranger_str_concat.
    if (this.wasmStrEnabled(lctx)) {
      def aV (this.lowerConcatOperand(aNode aStr lctx))
      def sa aV
      if (aStr == false) {
        def a1:[string]
        def a1t:[string]
        push a1 aV
        push a1t "i32"
        sa = (builder.emitCall("ranger_str_from_int" "i8*" a1 a1t))
      }
      def bV (this.lowerConcatOperand(bNode bStr lctx))
      def sb bV
      if (bStr == false) {
        def b1:[string]
        def b1t:[string]
        push b1 bV
        push b1t "i32"
        sb = (builder.emitCall("ranger_str_from_int" "i8*" b1 b1t))
      }
      def cargs:[string]
      def cargTypes:[string]
      push cargs sa
      push cargTypes "i8*"
      push cargs sb
      push cargTypes "i8*"
      return (builder.emitCall("ranger_str_concat" "i8*" cargs cargTypes))
    }
    def sz (builder.emitConst("i32" "4096"))
    def raw (builder.emitHeapAlloc(sz))
    def buf (builder.emitIntToI8Ptr(raw lctx.ptrType))
    def fmtLit:string "%s%s"
    if (aStr && bStr) {
      fmtLit = "%s%s"
    } {
      if (aStr && (bStr == false)) {
        fmtLit = "%s%d"
      } {
        if ((aStr == false) && bStr) {
          fmtLit = "%d%s"
        } {
          fmtLit = "%d%d"
        }
      }
    }
    def args:[string]
    def argTypes:[string]
    push args buf
    push argTypes "i8*"
    def fmtG (this.internStringGlobal(fmtLit false))
    push args (builder.emitStrPtr(fmtG (this.stringGlobalByteLen(fmtG))))
    push argTypes "i8*"
    def aVal (this.lowerConcatOperand(aNode aStr lctx))
    if aStr {
      push args aVal
      push argTypes "i8*"
    } {
      push args aVal
      push argTypes "i32"
    }
    def bVal (this.lowerConcatOperand(bNode bStr lctx))
    if bStr {
      push args bVal
      push argTypes "i8*"
    } {
      push args bVal
      push argTypes "i32"
    }
    builder.emitCall("sprintf" "i32" args argTypes)
    def memTarget (LowIRTarget.resolve((unwrap lctx.ctx)))
    if (memTarget.usesLibc) {
      def dup (this.emitStrdupExpr(buf lctx))
      def freeArgs:[string]
      def freeArgTypes:[string]
      push freeArgs buf
      push freeArgTypes "i8*"
      def voidType:string "void"
      builder.emitCall("free" voidType freeArgs freeArgTypes)
      return dup
    }
    return buf
  }

  fn hasExternDecl:boolean (fnName:string) {
    for this.irModule.externDecls d:LowIRExternDecl i {
      if (d.fnName == fnName) {
        return true
      }
    }
    return false
  }

  fn internStringGlobal:string (text:string withNewline:boolean) {
    for this.irModule.stringGlobals g:LowIRStringGlobal i {
      if (g.text == text) {
        if (g.withNewline == withNewline) {
          return g.name
        }
      }
    }
    def cnt (array_length this.irModule.stringGlobals)
    def gname:string (".str." + ("" + cnt))
    def g@(lives):LowIRStringGlobal (new LowIRStringGlobal())
    g.name = gname
    g.text = text
    g.withNewline = withNewline
    def contentBytes (this.utf8ByteLen(text))
    if withNewline {
      g.byteLen = contentBytes + 2
    } {
      g.byteLen = contentBytes + 1
    }
    push this.irModule.stringGlobals g
    return gname
  }

  ; Count the UTF-8 byte length of a string. The host charAt returns a UTF-16
  ; code unit; codepoints in the BMP encode to 1-3 UTF-8 bytes. (Surrogate pairs
  ; / 4-byte sequences are rare in compiler string literals and counted as 3+3.)
  fn utf8ByteLen:int (text:string) {
    def i:int 0
    def n:int (strlen text)
    def total:int 0
    while (i < n) {
      def code:int (charAt text i)
      if (code < 128) {
        total = total + 1
      } {
        if (code < 2048) {
          total = total + 2
        } {
          total = total + 3
        }
      }
      i = i + 1
    }
    return total
  }

  fn stringGlobalByteLen:int (gname:string) {
    for this.irModule.stringGlobals g:LowIRStringGlobal i {
      if (g.name == gname) {
        return g.byteLen
      }
    }
    return 0
  }

  fn printTextFromNode:string (node:CodeNode) {
    if (node.value_type == RangerNodeType.String) {
      return node.string_value
    }
    return ""
  }

  fn emitIoString:void (text:string withNewline:boolean lctx:LowIRLowerContext) {
    if ((strlen text) == 0) {
      return
    }
    def target (lctx.target)
    if ((strlen target.ioFn) == 0) {
      return
    }
    def builder (lctx.builder)
    def gname (this.internStringGlobal(text withNewline))
    def byteLen (this.stringGlobalByteLen(gname))
    def strPtr (builder.emitStrPtr(gname byteLen))
    def args:[string]
    def argTypes:[string]
    push args strPtr
    push argTypes "i8*"
    def voidType:string "void"
    if (target.ioFnRet == voidType) {
      builder.emitCall(target.ioFn voidType args argTypes)
      return
    }
    builder.emitCall(target.ioFn target.ioFnRet args argTypes)
  }

  fn emitPrintfFmt:void (fmt:string args:[string] argTypes:[string] lctx:LowIRLowerContext) {
    def target (lctx.target)
    if ((strlen target.ioFn) == 0) {
      return
    }
    def builder (lctx.builder)
    def gname (this.internStringGlobal(fmt false))
    def byteLen (this.stringGlobalByteLen(gname))
    def fmtPtr (builder.emitStrPtr(gname byteLen))
    def callArgs:[string]
    def callTypes:[string]
    push callArgs fmtPtr
    push callTypes "i8*"
    for args a:string i {
      push callArgs a
    }
    for argTypes at:string i {
      push callTypes at
    }
    builder.emitCall(target.ioFn target.ioFnRet callArgs callTypes)
  }

  fn lowerPrint:void (node:CodeNode lctx:LowIRLowerContext) {
    def textNode (node.getSecond())
    def text (this.printTextFromNode(textNode))
    if ((strlen text) > 0) {
      this.emitIoString(text true lctx)
      return
    }
    def strPtr (this.lowerExpr(textNode lctx))
    def args:[string]
    def argTypes:[string]
    push args strPtr
    push argTypes "i8*"
    this.emitPrintfFmt("%s\n" args argTypes lctx)
  }

  fn lowerWrite:void (node:CodeNode lctx:LowIRLowerContext) {
    def textNode (node.getSecond())
    def text (this.printTextFromNode(textNode))

  ; `nullify x` clears an optional. Optionals are NULL pointers here, so the
  ; slot is overwritten with a null of whatever type it already holds; a slot
  ; the function has never bound has nothing to clear.
  fn lowerNullify:void (node:CodeNode lctx:LowIRLowerContext) {
    def target (node.getSecond())
    if (target.value_type != RangerNodeType.VRef) {
      return
    }
    def varName:string target.vref
    if ((has lctx.slots varName) == false) {
      return
    }
    def slotType:string lctx.ptrType
    if (has lctx.slotTypes varName) {
      slotType = (unwrap (get lctx.slotTypes varName))
    }
    def nullVal (lctx.builder.emitConst(slotType "0"))
    if (slotType == "i8*") {
      nullVal = "null"
    }
    def slot (unwrap (get lctx.slots varName))
    lctx.builder.emitStore(slotType nullVal slot)
  }


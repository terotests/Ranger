  }

  fn lowerPtrIsNull:string (ptr:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def asInt (builder.emitPtrToInt(ptr))
    def zero (builder.emitConst(lctx.ptrType "0"))
    return (builder.emitIcmpTyped("eq" lctx.ptrType asInt zero))
  }

  fn lowerPtrIsNotNull:string (ptr:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def asInt (builder.emitPtrToInt(ptr))
    def zero (builder.emitConst(lctx.ptrType "0"))
    return (builder.emitIcmpTyped("ne" lctx.ptrType asInt zero))
  }

  fn loadArrayDescExpr:string (arrNode:CodeNode lctx:LowIRLowerContext) {
    def desc (this.loadPtrArrayDescExpr(arrNode lctx))
    if (arrNode.value_type == RangerNodeType.VRef) {
      if ((strlen (this.ptrArrayDescFromVref(arrNode.vref lctx))) > 0) {
        return desc
      }
      if (this.isClassField(arrNode.vref lctx.className this.irModule)) {
        if (this.fieldIsPtrArraySlot(lctx.className arrNode.vref)) {
          return (this.emitFieldLoad(arrNode.vref lctx))
        }
      }
    }
    return (this.lowerExpr(arrNode lctx))
  }

  fn lowerPush:void (node:CodeNode lctx:LowIRLowerContext) {
    def arrNode (node.getSecond())
    def itemNode (node.getThird())
    def desc (this.loadArrayDescExpr(arrNode lctx))
    def itemAddr (this.lowerExpr(itemNode lctx))
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args itemAddr
    push argTypes lctx.ptrType
    def voidType:string "void"
    if (this.exprIsObjectPtr(itemNode lctx)) {
      if (this.memEnabled(lctx)) {
        ; Move ownership of an owned local into the array (no retain).
        ; The array owns the element and releases it once on free.
        def isMove:boolean false
        if (itemNode.value_type == RangerNodeType.VRef) {
          if (this.isOwnedObjectLocal(itemNode.vref lctx)) {
            isMove = true
          }
        }
        if isMove {
          set lctx.escapedLocals itemNode.vref "1"
          this.usedPtrArrayRuntime = true
          lctx.builder.emitCall("RtPtrArray_push" voidType args argTypes)
          return
        }
        this.usedMemRuntime = true
        this.ensureMemExtern((LowIRTarget.resolve((unwrap lctx.ctx))))
        lctx.builder.emitCall("ranger_ptrarray_push_owned" voidType args argTypes)
        return
      }
    }
    this.usedPtrArrayRuntime = true
    lctx.builder.emitCall("RtPtrArray_push" voidType args argTypes)
  }

  fn lowerFor:void (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    if ((array_length node.children) <= 4) {
      return
    }
    def listNode (node.getSecond())
    def itemNode (node.getThird())
    def bodyNode (itemAt node.children 4)
    def idxNode (itemAt node.children 3)
    def idxName (this.forIndexName(idxNode))
    def desc (this.loadArrayDescExpr(listNode lctx))
    this.usedPtrArrayRuntime = true
    def lenArgs:[string]
    def lenTypes:[string]
    push lenArgs desc
    push lenTypes lctx.ptrType
    def len (builder.emitCall("RtPtrArray_len" "i32" lenArgs lenTypes))
    def zero (builder.emitConst("i32" "0"))
    this.bindSlot(idxName "i32" zero lctx)
    def condLabel (builder.freshLabel("for_cond"))
    def bodyLabel (builder.freshLabel("for_body"))
    def exitLabel (builder.freshLabel("for_exit"))
    def incLabel (builder.freshLabel("for_inc"))
    builder.terminateBr(condLabel)
    builder.startBlock(condLabel)
    def idxVal (this.loadSlot(idxName "i32" lctx))
    def cond (builder.emitIcmp("slt" idxVal len))
    builder.terminateBrIf(cond bodyLabel exitLabel)
    builder.startBlock(bodyLabel)
    def elemArgs:[string]
    def elemTypes:[string]
    push elemArgs desc
    push elemTypes lctx.ptrType
    push elemArgs idxVal
    push elemTypes "i32"
    def elemAddr (builder.emitCall("RtPtrArray_get" lctx.ptrType elemArgs elemTypes))
    def itemName:string itemNode.vref
    def itemClass (this.resolveItemClass(itemNode))
    this.bindSlot(itemName lctx.ptrType elemAddr lctx)
    if ((strlen itemClass) > 0) {
      set lctx.objectSlots itemName itemClass
    }
    this.lowerBlock(bodyNode lctx)
    def bodyBb (unwrap builder.currentBlock)
    if (bodyBb.termKind == "") {
      builder.terminateBr(incLabel)
    }
    builder.startBlock(incLabel)
    def idxEnd (this.loadSlot(idxName "i32" lctx))
    def one (builder.emitConst("i32" "1"))
    def idxNext (builder.emitBin("add" "i32" idxEnd one))
    def idxSlot (unwrap (get lctx.slots idxName))
    builder.emitStore("i32" idxNext idxSlot)
    builder.terminateBr(condLabel)
    builder.startBlock(exitLabel)
  }

  fn emitStrcmpEq:string (lhs:string rhs:string ctx:LowIRLowerContext) {
    def args:[string]
    def argTypes:[string]
    push args lhs
    push argTypes "i8*"
    push args rhs
    push argTypes "i8*"
    def cmp (ctx.builder.emitCall("strcmp" "i32" args argTypes))
    def zero (ctx.builder.emitConst("i32" "0"))
    return (ctx.builder.emitIcmp("eq" cmp zero))
  }

  fn lowerStrlen:string (node:CodeNode lctx:LowIRLowerContext) {
    def irI32:string "i32"
    def textNode (node.getSecond())
    def text (this.printTextFromNode(textNode))
    def builder (lctx.builder)
    if ((strlen text) > 0) {
      def len (strlen text)
      return (builder.emitConst(irI32 ("" + len)))
    }
    def strPtr (this.lowerExpr(textNode lctx))
    def args:[string]
    def argTypes:[string]
    push args strPtr
    push argTypes "i8*"
    return (builder.emitCall("strlen" "i32" args argTypes))
  }

  fn isIntArrayTypeNode:boolean (node:CodeNode) {
    if (node.value_type == RangerNodeType.Array) {
      return (node.array_type == "int")
    }
    return false
  }

  fn isIntIntMapTypeNode:boolean (node:CodeNode) {
    if (node.value_type == RangerNodeType.Hash) {
      if (node.key_type == "int") {
        return (node.array_type == "int")
      }
    }
    return false
  }

  fn isObjectPtrArrayTypeNode:boolean (node:CodeNode) {
    if (node.value_type == RangerNodeType.Array) {
      if ((strlen node.array_type) > 0) {
        if (node.array_type != "int") {
          return true
        }
      }
    }
    return false
  }

  fn emitPtrArrayNewEmpty:string (lctx:LowIRLowerContext owned:boolean) {
    this.usedPtrArrayRuntime = true
    def builder (lctx.builder)
    def cap (builder.emitConst("i32" "256"))
    def args:[string]
    def argTypes:[string]
    push args cap
    push argTypes "i32"
    def desc (builder.emitCall("RtPtrArray_new" lctx.ptrType args argTypes))
    if owned {
      def one (builder.emitConst("i32" "1"))
      builder.emitStoreI32At(desc (this.ptrArrayOwnedOff(lctx)) one)
    }
    return desc
  }

  fn bindPtrArraySlot:void (varName:string desc:string lctx:LowIRLowerContext owned:boolean) {
    this.bindSlot(varName lctx.ptrType desc lctx)
    set lctx.collectionSlots varName "ptr_array"
    if owned {
      push lctx.ownedCollectionLocals varName
    }
  }

  fn collectionKind:string (varName:string lctx:LowIRLowerContext) {
    if (has lctx.collectionSlots varName) {
      return (unwrap (get lctx.collectionSlots varName))
    }
    return ""
  }

  fn arrayLenOff:int (lctx:LowIRLowerContext) {
    if (lctx.ptrType == "i64") {
      return 8
    }
    return 4
  }

  fn arrayCapOff:int (lctx:LowIRLowerContext) {
    if (lctx.ptrType == "i64") {
      return 12
    }
    return 8
  }

  fn arrayDescBytes:int (lctx:LowIRLowerContext) {
    if (lctx.ptrType == "i64") {
      return 20
    }
    return 16
  }

  fn ptrArrayOwnedOff:int (lctx:LowIRLowerContext) {
    def capOff (this.arrayCapOff(lctx))
    return (capOff + 4)
  }

  fn bindCollectionSlot:void (varName:string kind:string desc:string lctx:LowIRLowerContext) {
    this.bindSlot(varName lctx.ptrType desc lctx)
    set lctx.collectionSlots varName kind
  }

  fn loadCollectionDesc:string (varName:string lctx:LowIRLowerContext) {
    return (this.loadSlot(varName lctx.ptrType lctx))
  }

  fn emitDescLoad:string (desc:string byteOff:int lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def pt (lctx.ptrType)
    def off (builder.emitConst(pt ("" + byteOff)))
    def addr (builder.emitBin("add" pt desc off))
    return (builder.emitPtrLoad(addr))
  }

  fn emitRtArrayNewEmpty:string (lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def descBytes (builder.emitConst("i32" ("" + (this.arrayDescBytes(lctx)))))
    def desc (builder.emitHeapAlloc(descBytes))
    def sixteen (builder.emitConst("i32" "16"))
    def data (builder.emitHeapAlloc(sixteen))
    builder.emitPtrStore(desc data)
    def zero (builder.emitConst("i32" "0"))
    builder.emitStoreI32At(desc (this.arrayLenOff(lctx)) zero)
    def four (builder.emitConst("i32" "4"))
    builder.emitStoreI32At(desc (this.arrayCapOff(lctx)) four)
    return desc
  }

  fn emitRtArrayNewSized:string (cap:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def descBytes (builder.emitConst("i32" ("" + (this.arrayDescBytes(lctx)))))
    def desc (builder.emitHeapAlloc(descBytes))
    def four (builder.emitConst("i32" "4"))
    def nbytes (builder.emitBin("mul" "i32" cap four))
    def data (builder.emitHeapAlloc(nbytes))
    builder.emitPtrStore(desc data)
    def zero (builder.emitConst("i32" "0"))
    builder.emitStoreI32At(desc (this.arrayLenOff(lctx)) zero)
    builder.emitStoreI32At(desc (this.arrayCapOff(lctx)) cap)
    return desc
  }

  fn emitRtArrayGet:string (desc:string idx:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def pt (lctx.ptrType)
    def data (this.emitDescLoad(desc 0 lctx))
    def four (builder.emitConst("i32" "4"))
    def offI32 (builder.emitBin("mul" "i32" idx four))
    def off (builder.emitZextI32ToPtr(offI32))
    def slot (builder.emitBin("add" pt data off))
    return (builder.emitPtrLoadTyped(slot "i32"))
  }

  fn emitRtArraySet:void (desc:string idx:string val:string lctx:LowIRLowerContext) {
    this.usedArrayRuntime = true
    def builder (lctx.builder)
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args idx
    push argTypes "i32"
    push args val
    push argTypes "i32"
    def voidType:string "void"
    builder.emitCall("RtArray_set" voidType args argTypes)
  }

  fn emitRtArrayLen:string (desc:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    return (builder.emitI32At(desc (this.arrayLenOff(lctx))))
  }

  fn emitRtMapNew:string (cap:string lctx:LowIRLowerContext) {
    this.usedMapRuntime = true
    def builder (lctx.builder)
    def args:[string]
    def argTypes:[string]
    push args cap
    push argTypes "i32"
    return (builder.emitCall("RtMap_new" lctx.ptrType args argTypes))
  }

  fn emitRtMapPut:void (desc:string key:string val:string lctx:LowIRLowerContext) {
    this.usedMapRuntime = true
    def builder (lctx.builder)
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args key
    push argTypes "i32"
    push args val
    push argTypes "i32"
    def voidType:string "void"
    builder.emitCall("RtMap_put" voidType args argTypes)
  }

  fn emitRtMapGet:string (desc:string key:string lctx:LowIRLowerContext) {
    this.usedMapRuntime = true
    def builder (lctx.builder)
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args key
    push argTypes "i32"
    return (builder.emitCall("RtMap_get" "i32" args argTypes))
  }

  fn emitRtMapHas:string (desc:string key:string lctx:LowIRLowerContext) {
    this.usedMapRuntime = true
    def builder (lctx.builder)
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args key
    push argTypes "i32"
    return (builder.emitCall("RtMap_has" "i32" args argTypes))
  }

  fn lowerCollectionMake:string (node:CodeNode lctx:LowIRLowerContext) {
    def sizeNode (node.getThird())
    def cap (this.lowerExpr(sizeNode lctx))
    def innerNode (node.getSecond())
    if (this.isObjectPtrArrayTypeNode(innerNode)) {
      this.usedPtrArrayRuntime = true
      def builder (lctx.builder)
      def args:[string]
      def argTypes:[string]
      push args cap
      push argTypes "i32"
      return (builder.emitCall("RtPtrArray_new" lctx.ptrType args argTypes))
    }
    return (this.emitRtArrayNewSized(cap lctx))
  }

  fn lowerCollectionGet:string (node:CodeNode lctx:LowIRLowerContext) {
    def collNode (node.getSecond())
    def keyNode (node.getThird())
    def varName:string collNode.vref
    def kind (this.collectionKind(varName lctx))
    def desc (this.loadCollectionDesc(varName lctx))
    def key (this.lowerExpr(keyNode lctx))
    if (kind == "map") {
      return (this.emitRtMapGet(desc key lctx))
    }
    return (this.emitRtArrayGet(desc key lctx))
  }

  fn lowerCollectionLen:string (node:CodeNode lctx:LowIRLowerContext) {
    def collNode (node.getSecond())
    if (collNode.value_type == RangerNodeType.VRef) {
      def pdesc (this.ptrArrayDescFromVref(collNode.vref lctx))
      if ((strlen pdesc) > 0) {
        return (this.emitPtrArrayLen(pdesc lctx))
      }
    }
    def varName:string collNode.vref
    def desc (this.loadCollectionDesc(varName lctx))
    return (this.emitRtArrayLen(desc lctx))
  }

  fn lowerCollectionHas:string (node:CodeNode lctx:LowIRLowerContext) {
    def collNode (node.getSecond())
    def keyNode (node.getThird())
    def varName:string collNode.vref
    def desc (this.loadCollectionDesc(varName lctx))
    def key (this.lowerExpr(keyNode lctx))
    return (this.emitRtMapHas(desc key lctx))
  }

  fn lowerCollectionSet:void (node:CodeNode lctx:LowIRLowerContext) {
    def collNode (node.getSecond())
    def keyNode (node.getThird())
    def valNode@(optional):CodeNode
    if ((array_length node.children) > 3) {
      valNode = (itemAt node.children 3)
    }
    if (null? valNode) {
      return
    }
    def varName:string collNode.vref
    def kind (this.collectionKind(varName lctx))
    def desc (this.loadCollectionDesc(varName lctx))
    def key (this.lowerExpr(keyNode lctx))
    def val (this.lowerExpr((unwrap valNode) lctx))
    if (kind == "map") {
      this.emitRtMapPut(desc key val lctx)
      return
    }
    this.emitRtArraySet(desc key val lctx)
  }

  fn lowerStruct:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    if ((array_length cl.variables) == 0) {
      return
    }
    def st@(lives):LowIRStruct (new LowIRStruct())
    st.name = cl.name
    def ptrType (this.irModule.ptrType)
    for cl.variables v:RangerAppParamDesc i {
      if (null? v.nameNode) {
        continue
      }
      def nn (unwrap v.nameNode)
      def f@(lives):LowIRField (new LowIRField())
      f.name = v.name
      def isObjArray:boolean false
      if (LowIRUtil.isArrayTypeName(nn.type_name)) {
        isObjArray = true
      } {
        if (nn.value_type == RangerNodeType.Array) {
          if ((strlen nn.array_type) > 0) {
            if (nn.array_type != "int") {
              isObjArray = true
            }
          }
        }
      }
      if isObjArray {
        f.irType = ptrType
        f.isPtrArray = true
      } {
        if (LowIRUtil.isStringType(nn.type_name)) {
          f.irType = ptrType
          f.isString = true
        } {
          if (nn.type_name == "boolean") {
            f.irType = "i32"
            f.isBool = true
          } {
            if (LowIRUtil.isSupportedPrimitive(nn.type_name)) {
              f.irType = (LowIRUtil.fieldIrType(nn.type_name))
            } {
              f.irType = ptrType
              f.isObject = true
            }
          }
        }
      }
      push st.fields f
    }
    push this.irModule.structs st
    def target (LowIRTarget.resolve(ctx))
    this.lowerTypeDesc(st target)
  }

  fn lowerTypeDesc:void (st:LowIRStruct target:LowIRTarget) {
    def td@(lives):LowIRTypeDesc (new LowIRTypeDesc())
    td.className = st.name
    td.size = (this.structByteSize(st.name this.irModule))
    def fi:int 0
    for st.fields f:LowIRField i {
      def kind:int 3
      if (f.isString) {
        kind = 0
      } {
        if (f.isObject) {
          kind = 1
        } {
          if (f.isPtrArray) {
            kind = 2
          }
        }
      }
      if (kind != 3) {
        def fd@(lives):LowIRTypeFieldDesc (new LowIRTypeFieldDesc())
        fd.offset = (this.fieldByteOffset(st.name fi this.irModule))
        fd.kind = kind
        ; Object fields (kind=1) and ptr-array fields (kind=2) default to BORROW
        ; (owned=0): they typically alias memory owned elsewhere (array elements,
        ; other nodes, a collection passed in and stored into a field). The
        ; destructor must not recursively free them (would double-free when the
        ; original owner also releases). String fields (kind=0) stay owned, since
        ; each object holds its own strdup'd copy. Borrow analysis (Vaihe 3) can
        ; later promote provably-owned object/array fields back to owned.
        fd.owned = 1
        if (kind == 1) {
          fd.owned = 0
        }
        if (kind == 2) {
          fd.owned = 0
        }
        push td.fields fd
      }
      fi = fi + 1
    }
    push this.irModule.typeDescs td
    this.usedMemRuntime = true
    this.ensureMemExtern(target)
  }

  fn fieldByteOffset:int (className:string fieldIndex:int module:LowIRModule) {
    for module.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      def size:int 0
      def fi:int 0
      for st.fields f:LowIRField i {
        if (fi == fieldIndex) {
          return size
        }
        def fsize:int 4
        def falign:int 4
        if (f.irType != "i32") {
          fsize = 8
          falign = 8
        }
        def rem:int (size % falign)
        if (rem != 0) {
          size = size + (falign - rem)
        }
        size = size + fsize
        fi = fi + 1
      }
    }
    return 0
  }

  fn bindSlot:void (varName:string irType:string value:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    if (has lctx.slots varName) {
      def slot (unwrap (get lctx.slots varName))
      builder.emitStore(irType value slot)
      set lctx.slotTypes varName irType
      return
    }
    def slotName:string ("%" + varName + "_addr")
    builder.emitAlloca(irType slotName)
    ; Zero-init pointer slots in the entry block (before the value store) so that
    ; owned object/collection locals defined inside a conditional branch but
    ; released unconditionally at scope end hold NULL on skipped paths. Releasing
    ; NULL is a guarded no-op; releasing garbage (uninitialized alloca) crashes.
    ; Only needed (and only valid) on manual-memory targets that emit the ARC
    ; runtime; other backends (e.g. WASM) manage slots differently.
    if (this.memEnabled(lctx)) {
      if (irType == lctx.ptrType) {
        builder.emitZeroInitToEntry(irType slotName)
      }
    }
    builder.emitStore(irType value slotName)
    set lctx.slots varName slotName
    set lctx.slotTypes varName irType
  }

  fn loadSlot:string (varName:string irType:string lctx:LowIRLowerContext) {
    if (has lctx.slots varName) {
      def slot (unwrap (get lctx.slots varName))
      def builder (lctx.builder)
      def loadType (irType)
      if (has lctx.slotTypes varName) {
        loadType = (unwrap (get lctx.slotTypes varName))
      }
      if (has lctx.objectSlots varName) {
        loadType = lctx.ptrType
      }
      return (builder.emitLoad(loadType slot))
    }
    return ("%" + varName)
  }

  fn fieldIrTypeFor:string (className:string fieldName:string) {
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.name == fieldName) {
          return f.irType
        }
      }
    }
    return "i32"
  }

  fn fieldIsPtrArraySlot:boolean (className:string fieldName:string) {
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.name == fieldName) {
          return f.isPtrArray
        }
      }
    }
    return false
  }

  fn fieldIsObjectSlot:boolean (className:string fieldName:string) {
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.name == fieldName) {
          return f.isObject
        }
      }
    }
    return false
  }

  fn fieldIsStringSlot:boolean (className:string fieldName:string) {
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.name == fieldName) {
          return f.isString
        }
      }
    }
    return false
  }

  fn fieldIsBoolSlot:boolean (className:string fieldName:string) {
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.name == fieldName) {
          return f.isBool
        }
      }
    }
    return false
  }

  fn ptrArrayDescFromVref:string (vref:string lctx:LowIRLowerContext) {
    if ((indexOf vref ".") >= 0) {
      def parts:[string] (strsplit vref ".")
      if ((array_length parts) < 2) {
        return ""
      }
      def recv (itemAt parts 0)
      def fld (itemAt parts 1)
      def cls (this.resolveObjectClass(recv lctx))
      if ((strlen cls) == 0) {
        return ""
      }
      if (this.fieldIsPtrArraySlot(cls fld) == false) {
        return ""
      }
      def sptr (this.resolveObjectPtr(recv cls lctx))
      return (this.emitFieldLoadOn(cls sptr fld lctx))
    }
    if (this.isClassField(vref lctx.className this.irModule)) {
      if (this.fieldIsPtrArraySlot(lctx.className vref)) {
        return (this.emitFieldLoad(vref lctx))
      }
    }
    if (has lctx.collectionSlots vref) {
      def kind (unwrap (get lctx.collectionSlots vref))
      if (kind == "ptr_array") {
        return (this.loadSlot(vref lctx.ptrType lctx))
      }
    }
    return ""
  }

  fn loadPtrArrayDescExpr:string (arrNode:CodeNode lctx:LowIRLowerContext) {
    if (arrNode.value_type == RangerNodeType.VRef) {
      def desc (this.ptrArrayDescFromVref(arrNode.vref lctx))
      if ((strlen desc) > 0) {
        return desc
      }
    }
    return (this.lowerExpr(arrNode lctx))
  }

  fn emitPtrArrayLen:string (desc:string lctx:LowIRLowerContext) {
    this.usedPtrArrayRuntime = true
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    return (lctx.builder.emitCall("RtPtrArray_len" "i32" args argTypes))
  }

  fn lowerItemAt:string (node:CodeNode lctx:LowIRLowerContext) {
    def arrNode (node.getSecond())
    def idxNode (node.getThird())
    def idx (this.lowerExpr(idxNode lctx))
    if (arrNode.value_type == RangerNodeType.VRef) {
      def kind (this.collectionKind(arrNode.vref lctx))
      if (kind == "array") {
        def desc (this.loadCollectionDesc(arrNode.vref lctx))
        return (this.emitRtArrayGet(desc idx lctx))
      }
      if (kind == "ptr_array") {
        def desc (this.loadSlot(arrNode.vref lctx.ptrType lctx))
        this.usedPtrArrayRuntime = true
        def args:[string]
        def argTypes:[string]
        push args desc
        push argTypes lctx.ptrType
        push args idx
        push argTypes "i32"
        return (lctx.builder.emitCall("RtPtrArray_get" lctx.ptrType args argTypes))
      }
    }
    def desc (this.loadPtrArrayDescExpr(arrNode lctx))
    this.usedPtrArrayRuntime = true
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args idx
    push argTypes "i32"
    return (lctx.builder.emitCall("RtPtrArray_get" lctx.ptrType args argTypes))
  }

  fn emitFieldLoadOn:string (className:string structPtr:string fieldName:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def idx (this.findFieldIndex(className fieldName this.irModule))
    def fieldPtr (builder.emitGep(className structPtr idx))
    def ftype (this.fieldIrTypeFor(className fieldName))
    def raw (builder.emitLoad(ftype fieldPtr))
    if (this.fieldIsStringSlot(className fieldName)) {
      return (builder.emitIntToI8Ptr(raw lctx.ptrType))
    }
    if (this.fieldIsBoolSlot(className fieldName)) {
      def zero (builder.emitConst("i32" "0"))
      return (builder.emitIcmp("ne" raw zero))
    }
    return raw
  }

  fn emitReleaseFieldValue:void (className:string fieldName:string rawVal:string lctx:LowIRLowerContext) {
    if (this.memEnabled(lctx) == false) {
      return
    }
    def builder (lctx.builder)
    def voidType:string "void"
    def args:[string]
    def argTypes:[string]
    if (this.fieldIsStringSlot(className fieldName)) {
      def i8p (builder.emitIntToI8Ptr(rawVal lctx.ptrType))
      push args i8p
      push argTypes "i8*"
      builder.emitCall("ranger_str_release" voidType args argTypes)
      return
    }
    ; Object and ptr-array fields are borrows (owned elsewhere): an object
    ; field aliases another node/array element, and an array field commonly
    ; aliases a collection owned by the caller (e.g. parser.tokens = toks).
    ; Neither is released on overwrite (the original owner frees it).
  }

  fn emitFieldStoreOn:void (className:string structPtr:string fieldName:string value:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def idx (this.findFieldIndex(className fieldName this.irModule))
    def fieldPtr (builder.emitGep(className structPtr idx))
    def ftype (this.fieldIrTypeFor(className fieldName))
    if (this.memEnabled(lctx)) {
      def oldRaw (builder.emitLoad(ftype fieldPtr))
      this.emitReleaseFieldValue(className fieldName oldRaw lctx)
    }
    def storeVal:string value
    if (this.fieldIsStringSlot(className fieldName)) {
      def owned (this.emitStrdupExpr(value lctx))
      storeVal = (builder.emitPtrToInt(owned))
    } {
      if (this.fieldIsBoolSlot(className fieldName)) {
        storeVal = (builder.emitZextI1ToI32(value))
      } {
        ; Object fields are borrows: store the pointer without retaining.
        storeVal = value
      }
    }
    builder.emitStore(ftype storeVal fieldPtr)
  }

  fn emitFieldLoad:string (fieldName:string lctx:LowIRLowerContext) {
    return (this.emitFieldLoadOn(lctx.className lctx.selfPtr fieldName lctx))
  }

  fn emitFieldStore:void (fieldName:string value:string lctx:LowIRLowerContext) {
    this.emitFieldStoreOn(lctx.className lctx.selfPtr fieldName value lctx)
  }

  fn resolveObjectPtr:string (varName:string className:string lctx:LowIRLowerContext) {
    if (varName == "this") {
      return lctx.selfPtr
    }
    def addr (this.loadSlot(varName lctx.ptrType lctx))
    return (lctx.builder.emitIntToStructPtr(className addr))
  }

  fn resolveObjectClass:string (varName:string lctx:LowIRLowerContext) {
    if (varName == "this") {
      return lctx.className
    }
    if (has lctx.objectSlots varName) {
      return (unwrap (get lctx.objectSlots varName))
    }
    return ""
  }

  fn resolveFieldPtrExpr:string (vref:string lctx:LowIRLowerContext) {
    def dotPos:int (indexOf vref ".")
    if (dotPos < 0) {
      return ""
    }
    def parts:[string] (strsplit vref ".")
    if ((array_length parts) < 2) {
      return ""
    }
    def recv (itemAt parts 0)
    def fld (itemAt parts 1)
    def cls (this.resolveObjectClass(recv lctx))
    if ((strlen cls) == 0) {
      return ""
    }
    def sptr (this.resolveObjectPtr(recv cls lctx))
    def builder (lctx.builder)
    def idx (this.findFieldIndex(cls fld this.irModule))
    return (builder.emitGep(cls sptr idx))
  }

  fn isObjectArrayField:boolean (v:RangerAppParamDesc) {
    if (null? v.nameNode) {
      return false
    }
    def nn (unwrap v.nameNode)
    if (LowIRUtil.isArrayTypeName(nn.type_name)) {
      return true
    }
    if (nn.value_type == RangerNodeType.Array) {
      if ((strlen nn.array_type) > 0) {
        if (nn.array_type != "int") {
          return true
        }
      }
    }
    return false
  }

  fn emitFieldDefault:void (className:string objPtr:string fieldName:string valNode:CodeNode lctx:LowIRLowerContext) {
    def tmp (this.lowerExpr(valNode lctx))
    this.emitFieldStoreOn(className objPtr fieldName tmp lctx)
  }

  fn initFieldDefaultsInObject:void (className:string objPtr:string lctx:LowIRLowerContext) {
    def appCtx (unwrap lctx.ctx)
    if (false == (has appCtx.definedClasses className)) {
      return
    }
    def cl (unwrap (get appCtx.definedClasses className))
    for cl.variables v:RangerAppParamDesc i {
      if (this.isObjectArrayField(v)) {
        continue
      }
      if (null? v.def_value) {
        continue
      }
      if ((v.has_default == false) && (v.init_cnt == 0)) {
        continue
      }
      this.emitFieldDefault(className objPtr v.name (unwrap v.def_value) lctx)
    }
  }

  fn initFieldDefaultsInConstructor:void (className:string lctx:LowIRLowerContext) {
    this.initFieldDefaultsInObject(className lctx.selfPtr lctx)
  }

  fn initArrayFieldsInObject:void (className:string objPtr:string lctx:LowIRLowerContext) {
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.isPtrArray == false) {
          continue
        }
        def cap (lctx.builder.emitConst("i32" "256"))
        def args:[string]
        def argTypes:[string]
        push args cap
        push argTypes "i32"
        this.usedPtrArrayRuntime = true
        def desc (lctx.builder.emitCall("RtPtrArray_new" lctx.ptrType args argTypes))
        def one (lctx.builder.emitConst("i32" "1"))
        lctx.builder.emitStoreI32At(desc (this.ptrArrayOwnedOff(lctx)) one)
        this.emitFieldStoreOn(className objPtr f.name desc lctx)
      }
    }
  }

  fn initArrayFieldsInConstructor:void (className:string lctx:LowIRLowerContext) {
    this.initArrayFieldsInObject(className lctx.selfPtr lctx)
  }

  fn structByteSize:int (className:string module:LowIRModule) {
    for module.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      def size:int 0
      for st.fields f:LowIRField i {
        def fsize:int 4
        def falign:int 4
        if (f.irType != "i32") {
          fsize = 8
          falign = 8
        }
        def rem:int (size % falign)
        if (rem != 0) {
          size = size + (falign - rem)
        }
        size = size + fsize
      }
      def remEnd:int (size % 8)
      if (remEnd != 0) {
        size = size + (8 - remEnd)
      }
      return size
    }
    return 0
  }

  fn lowerNewObject:string (className:string argsNode:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def byteCnt (this.structByteSize(className this.irModule))
    if (byteCnt == 0) {
      def fieldCnt (this.structFieldCount(className this.irModule))
      byteCnt = fieldCnt * 4
      if (lctx.ptrType == "i64") {
        byteCnt = fieldCnt * 8
      }
    }
    def bytes (builder.emitConst("i32" ("" + byteCnt)))
    def heapAddr:string ""
    def memTarget (LowIRTarget.resolve((unwrap lctx.ctx)))
    if (memTarget.usesLibc) {
      this.usedMemRuntime = true
      this.ensureMemExtern(memTarget)
      def dtorArg:string ""
      dtorArg = ("ptr @" + className + "_typeDesc")
      def newArgs:[string]
      def newArgTypes:[string]
      push newArgs bytes
      push newArgTypes "i32"
      push newArgs dtorArg
      push newArgTypes ""
      def newSig:string ("i32, ptr")
      heapAddr = (builder.emitCallWithSig("ranger_obj_new" lctx.ptrType newSig newArgs newArgTypes))
    } {
      heapAddr = (builder.emitHeapAlloc(bytes))
    }
    def objSlot (builder.emitIntToStructPtr(className heapAddr))
    this.initFieldDefaultsInObject(className objSlot lctx)
    def ctorDesc@(optional):RangerAppFunctionDesc
    if (!null? lctx.ctx) {
      def appCtx (unwrap lctx.ctx)
      if (has appCtx.definedClasses className) {
        def cl (unwrap (get appCtx.definedClasses className))
        if cl.has_constructor {
          if (!null? cl.constructor_fn) {
            ctorDesc = (unwrap cl.constructor_fn)
          }
        }
        if (null? ctorDesc) {
          for cl.methods m:RangerAppFunctionDesc i {
            if (m.name == "Constructor") {
              ctorDesc = m
            }
          }
        }
      }
    }
    if (!null? ctorDesc) {
      def ctorName (LowIRUtil.mangleMethod(className "Constructor"))
      def args:[string]
      def argTypes:[string]
      push args objSlot
      push argTypes (LowIRUtil.structPtrType(className))
      def argIdx:int 0
      for argsNode.children arg:CodeNode i {
        push args (this.lowerExpr(arg lctx))
        push argTypes (this.paramIrTypeFromDesc(argIdx (unwrap ctorDesc) lctx))
        argIdx = argIdx + 1
      }
      def voidType:string "void"
      builder.emitCall(ctorName voidType args argTypes)
    } {
      this.initArrayFieldsInObject(className objSlot lctx)
    }
    return heapAddr
  }

  fn findFieldIndex:int (className:string fieldName:string module:LowIRModule) {
    for module.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      def fi:int 0
      for st.fields f:LowIRField i {
        if (f.name == fieldName) {
          return fi
        }
        fi = fi + 1
      }
    }
    return -1
  }

  fn isClassField:boolean (fieldName:string className:string module:LowIRModule) {
    if ((strlen className) == 0) {
      return false
    }
    return (this.findFieldIndex(className fieldName module) >= 0)
  }

  fn structFieldCount:int (className:string module:LowIRModule) {
    for module.structs st:LowIRStruct i {
      if (st.name == className) {
        return (array_length st.fields)
      }
    }
    return 0
  }

  fn lowerFunction:void (fnDesc:RangerAppFunctionDesc className:string appCtx:RangerAppWriterContext exportFn:boolean isMain:boolean isInstance:boolean) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(this.irModule))
    builder.reset()
    def lctx@(lives):LowIRLowerContext (new LowIRLowerContext())
    lctx.ctx = appCtx
    lctx.builder = builder
    lctx.target = (LowIRTarget.resolve(appCtx))
    lctx.ptrType = lctx.target.ptrType
    def emptySlots:[string:string]
    lctx.slots = emptySlots
    def emptySlotTypes:[string:string]
    lctx.slotTypes = emptySlotTypes
    def emptyObjects:[string:string]
    lctx.objectSlots = emptyObjects
    def emptyCollections:[string:string]
    lctx.collectionSlots = emptyCollections
    def emptyOwned:[string]
    lctx.ownedObjectLocals = emptyOwned
    def emptyColl:[string]
    lctx.ownedCollectionLocals = emptyColl
    def emptyEscaped:[string:string]
    lctx.escapedLocals = emptyEscaped
    if isInstance {
      lctx.className = className
      lctx.selfPtr = "%self"
    }

    def voidType:string "void"
    if (fnDesc.name == "Constructor") {
      lctx.currentRetType = voidType
      lctx.llvmRetType = voidType
    } {
      def retNode (unwrap fnDesc.nameNode)
      def retTypeName (this.varTypeName(retNode))
      lctx.currentRetType = retTypeName
      lctx.llvmRetType = (this.llvmTypeForRanger(retTypeName lctx.ptrType))
    }
    if isMain {
      lctx.llvmRetType = "i32"
    }
    if (isMain && (lctx.currentRetType == voidType)) {
      lctx.llvmRetType = "i32"
    }

    def params:[LowIRParam]
    if isInstance {
      def selfParam@(lives):LowIRParam (new LowIRParam())
      selfParam.name = "self"
      selfParam.irType = (LowIRUtil.structPtrType(className))
      push params selfParam
    }
    for fnDesc.params p:RangerAppParamDesc i {
      def lp@(lives):LowIRParam (new LowIRParam())
      lp.name = p.compiledName
      if ((strlen lp.name) == 0) {
        lp.name = p.name
      }
      def pn (unwrap p.nameNode)
      def paramTypeName (this.varTypeName(pn))
      lp.irType = (this.llvmTypeForRanger(paramTypeName lctx.ptrType))
      push params lp
    }

    def fnName:string (LowIRUtil.mangleMethod(className fnDesc.name))
    if isMain {
      fnName = "main"
    }
    if ((strlen fnName) == 0) {
      fnName = fnDesc.compiledName
    }
    if ((strlen fnName) == 0) {
      fnName = fnDesc.name
    }

    def entryLabel:string "entry"
    builder.startBlock(entryLabel)

    if isInstance {
      if (fnDesc.name == "Constructor") {
        this.initFieldDefaultsInConstructor(className lctx)
        this.initArrayFieldsInConstructor(className lctx)
      }
    }

    for fnDesc.params p:RangerAppParamDesc i {
      def lpName:string p.compiledName
      if ((strlen lpName) == 0) {
        lpName = p.name
      }
      def pn (unwrap p.nameNode)
      def paramTypeName (this.varTypeName(pn))
      def pType (this.llvmTypeForRanger(paramTypeName lctx.ptrType))
      def paramVal:string ("%" + lpName)
      this.bindSlot(p.name pType paramVal lctx)
      if (LowIRUtil.isArrayTypeName(paramTypeName)) {
        set lctx.collectionSlots p.name "ptr_array"
      }
      if (this.isObjectTypeName(paramTypeName)) {
        set lctx.objectSlots p.name paramTypeName
      }
    }

    if (!null? fnDesc.fnBody) {
      this.lowerBlock((unwrap fnDesc.fnBody) lctx)
    }

    def cur (unwrap builder.currentBlock)
    if (cur.termKind == "") {
      this.emitReleaseOwnedLocals(lctx)
      if isMain {
        if (lctx.currentRetType == voidType) {
          def zero:string "0"
          def retVal (builder.emitConst("i32" zero))
          builder.terminateRet(lctx.llvmRetType retVal)
        }
      }
    }

    builder.finishFunction(fnName lctx.llvmRetType params exportFn isMain)
  }

  fn isOwnedObjectLocal:boolean (varName:string lctx:LowIRLowerContext) {
    for lctx.ownedObjectLocals n:string i {
      if (n == varName) {
        return true
      }
    }
    return false
  }

  fn releaseOwnedLocal:void (varName:string lctx:LowIRLowerContext) {
    def memTarget (LowIRTarget.resolve((unwrap lctx.ctx)))
    if (memTarget.usesLibc == false) {
      return
    }
    if (has lctx.escapedLocals varName) {
      return
    }
    if (false == (has lctx.slots varName)) {
      return
    }
    def builder (lctx.builder)
    def voidType:string "void"
    def val (this.loadSlot(varName lctx.ptrType lctx))
    def args:[string]
    def argTypes:[string]
    push args val
    push argTypes lctx.ptrType
    builder.emitCall("ranger_obj_release" voidType args argTypes)
  }

  fn strictOwnershipEnabled:boolean (lctx:LowIRLowerContext) {
    def ctx (unwrap lctx.ctx)
    return (ctx.hasCompilerFlag("strict-ownership"))
  }

  ; Diagnostic (manual targets + -strict-ownership): emit a per-exit summary of
  ; how each owned local is disposed, so the target-specific ownership handling
  ; is visible in the IR. Foundation for turning ambiguous cases into warnings.
  fn emitOwnershipSummary:void (lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def objCount (array_length lctx.ownedObjectLocals)
    def collCount (array_length lctx.ownedCollectionLocals)
    if ((objCount + collCount) == 0) {
      return
    }
    builder.emitComment("ownership[manual]: scope-exit disposition")
    for lctx.ownedObjectLocals name:string i {
      if (has lctx.escapedLocals name) {
        builder.emitComment(("  owned object '" + name + "' -> escaped (moved/returned), caller owns"))
      } {
        builder.emitComment(("  owned object '" + name + "' -> released"))
      }
    }
    for lctx.ownedCollectionLocals name:string i {
      if (has lctx.escapedLocals name) {
        builder.emitComment(("  owned array '" + name + "' -> escaped, caller owns"))
      } {
        builder.emitComment(("  owned array '" + name + "' -> released (elements freed)"))
      }
    }
  }

  fn emitReleaseOwnedLocals:void (lctx:LowIRLowerContext) {
    def memTarget (LowIRTarget.resolve((unwrap lctx.ctx)))
    if (memTarget.isManualMemory() == false) {
      return
    }
    if (this.strictOwnershipEnabled(lctx)) {
      this.emitOwnershipSummary(lctx)
    }
    for lctx.ownedObjectLocals name:string i {
      this.releaseOwnedLocal(name lctx)
    }
    def builder (lctx.builder)
    def voidType:string "void"
    for lctx.ownedCollectionLocals name:string i {
      if (has lctx.escapedLocals name) {
        continue
      }
      if (false == (has lctx.slots name)) {
        continue
      }
      def desc (this.loadSlot(name lctx.ptrType lctx))
      def args:[string]
      def argTypes:[string]
      push args desc
      push argTypes lctx.ptrType
      builder.emitCall("ranger_ptrarray_release" voidType args argTypes)
    }
  }

  fn lowerBlock:void (block:CodeNode lctx:LowIRLowerContext) {
    if block.is_block_node {
      def childCnt (array_length block.children)
      if (childCnt > 0) {
        for block.children stmt:CodeNode i {
          this.lowerStmt(stmt lctx)
        }
        return
      }
      if (has block.register_expressions) {
        for block.register_expressions reg:CodeNode i {
          this.lowerStmt(reg lctx)
        }
      }
      return
    }
    if block.expression {
      def childCnt (array_length block.children)
      if (childCnt > 0) {
        for block.children stmt:CodeNode i {
          this.lowerStmt(stmt lctx)
        }
        return
      }
    }
    if (has block.register_expressions) {
      for block.register_expressions reg:CodeNode i {
        this.lowerStmt(reg lctx)
      }
      return
    }
    this.lowerStmt(block lctx)
  }

  fn isAssignNode:boolean (node:CodeNode) {
    if ((array_length node.children) < 3) {
      return false
    }
    def fc (node.getFirst())
    return (fc.vref == "=")
  }

  fn lowerStmt:void (node:CodeNode lctx:LowIRLowerContext) {
    if node.disabled_node {
      return
    }
    if (this.isAssignNode(node)) {
      this.lowerAssign(node lctx)
      return
    }
    if node.infix_operator {
      if (!null? node.infix_node) {
        def infix (unwrap node.infix_node)
        if infix.has_operator {
          def opName (infix.getOperator())
          if (opName == "=") {
            this.lowerAssign(infix lctx)
            return
          }
        }
      }
    }
    if node.hasVarDef {
      this.lowerVarDef(node lctx)
      return
    }
    if node.has_operator {
      def opName (node.getOperator())
      if (opName == "return") {
        this.lowerReturn(node lctx)
        return
      }
      if (opName == "if") {
        this.lowerIf(node lctx)
        return
      }
      if (opName == "while") {
        this.lowerWhile(node lctx)
        return
      }
      if (opName == "=") {
        this.lowerAssign(node lctx)
        return
      }
      if (opName == "set") {
        this.lowerCollectionSet(node lctx)
        return
      }
      if (opName == "print") {
        this.lowerPrint(node lctx)
        return
      }
      if (opName == "write") {
        this.lowerWrite(node lctx)
        return
      }
      if (opName == "exit") {
        this.lowerExit(node lctx)
        return
      }
      if (opName == "sleep_ms") {
        this.lowerSleepMs(node lctx)
        return
      }
      if (opName == "clear_screen") {
        this.lowerClearScreen(node lctx)
        return
      }
      if (opName == "hide_cursor") {
        this.lowerHideCursor(node lctx)
        return
      }
      if (opName == "show_cursor") {
        this.lowerShowCursor(node lctx)
        return
      }
      if (opName == "move_cursor") {
        this.lowerMoveCursor(node lctx)
        return
      }
      if (opName == "for") {
        this.lowerFor(node lctx)
        return
      }
      if (opName == "push") {
        this.lowerPush(node lctx)
        return
      }
      if (opName == "on_keypress") {
        this.lowerOnKeypress(node lctx)
        return
      }
    }
    if (node.has_call || node.is_direct_method_call) {
      this.lowerCall(node lctx)
      return
    }
    if node.hasFnCall {
      this.lowerExpr(node lctx)
      return
    }
    if node.expression {
      for node.children item:CodeNode i {
        this.lowerStmt(item lctx)
      }
    }
  }

  fn lowerVarDef:void (node:CodeNode lctx:LowIRLowerContext) {
    def nameNode (node.getSecond())
    def varName:string nameNode.vref
    def valNode@(optional):CodeNode
    def cnt (array_length node.children)
    if (cnt > 2) {
      def last (itemAt node.children (cnt - 1))
      valNode = last
    }
    if (null? valNode) {
      if (this.isIntArrayTypeNode(nameNode)) {
        def emptyArr (this.emitRtArrayNewEmpty(lctx))
        this.bindCollectionSlot(varName "array" emptyArr lctx)
        return
      }
      if (this.isObjectPtrArrayTypeNode(nameNode)) {
        def emptyPtrArr (this.emitPtrArrayNewEmpty(lctx true))
        this.bindPtrArraySlot(varName emptyPtrArr lctx true)
        return
      }
      if (this.isIntIntMapTypeNode(nameNode)) {
        def eight (lctx.builder.emitConst("i32" "8"))
        def newMap (this.emitRtMapNew(eight lctx))
        this.bindCollectionSlot(varName "map" newMap lctx)
        return
      }
      return
    }
    def val (unwrap valNode)
    if val.has_operator {
      def valOp (val.getOperator())
      if (valOp == "make") {
        def made (this.lowerCollectionMake(val lctx))
        if (this.isObjectPtrArrayTypeNode(nameNode)) {
          this.bindPtrArraySlot(varName made lctx true)
        } {
          this.bindCollectionSlot(varName "array" made lctx)
        }
        return
      }
    }
    if (val.has_call || val.is_direct_method_call || val.hasFnCall) {
      def callTmp (this.lowerCall(val lctx))
      def irTypeFromCall:string "i32"
      def typeName (this.varTypeName(nameNode))
      if ((strlen typeName) == 0) {
        if (!null? val.fnDesc) {
          if (!null? val.fnDesc.nameNode) {
            def retNode (unwrap val.fnDesc.nameNode)
            typeName = (this.varTypeName(retNode))
          }
        }
      }
      if ((strlen typeName) > 0) {
        irTypeFromCall = (this.llvmTypeForRanger(typeName lctx.ptrType))
        if (this.isObjectTypeName(typeName)) {
          set lctx.objectSlots varName typeName
        }
      }
      ; A call returning a collection ([T] / [int] / map) yields a descriptor
      ; pointer. Register it as a collection slot so for/array_length/itemAt work;
      ; the caller takes ownership (escaped from callee) and releases at scope end.
      if (this.isObjectPtrArrayTypeNode(nameNode)) {
        this.bindPtrArraySlot(varName callTmp lctx true)
        return
      }
      if (this.isIntArrayTypeNode(nameNode)) {
        this.bindCollectionSlot(varName "array" callTmp lctx)
        return
      }
      if (this.isIntIntMapTypeNode(nameNode)) {
        this.bindCollectionSlot(varName "map" callTmp lctx)
        return
      }
      this.bindSlot(varName irTypeFromCall callTmp lctx)
      return
    }
    if val.hasNewOper {
      if (!null? val.clDesc) {
        def cl (unwrap val.clDesc)
        def argsNode (val.getThird())
        if (this.isOwnedObjectLocal(varName lctx)) {
          this.releaseOwnedLocal(varName lctx)
        }
        def objPtr (this.lowerNewObject(cl.name argsNode lctx))
        set lctx.objectSlots varName cl.name
        if (this.isOwnedObjectLocal(varName lctx) == false) {
          push lctx.ownedObjectLocals varName
        }
        ; bindSlot zero-inits new pointer slots at entry, so an owned object
        ; local defined only in a conditional branch is NULL (not garbage) on
        ; skipped paths and the scope-end release is a safe no-op.
        this.bindSlot(varName lctx.ptrType objPtr lctx)
        return
      }
    }
    def tmp (this.lowerExpr(val lctx))
    def typeName (this.varTypeName(nameNode))
    def irType (this.llvmTypeForRanger(typeName lctx.ptrType))
    if (val.value_type == RangerNodeType.Boolean) {
      irType = "i1"
    }
    if (this.isObjectTypeName(typeName)) {
      set lctx.objectSlots varName typeName
    }
    if (irType == "i8*") {
      tmp = (this.emitStrdupExpr(tmp lctx))
    }
    this.bindSlot(varName irType tmp lctx)
  }

  fn lowerAssign:void (node:CodeNode lctx:LowIRLowerContext) {
    def lhs (node.getSecond())
    def rhs (itemAt node.children 2)
    def varName:string lhs.vref
    def tmp (this.lowerExpr(rhs lctx))
    def irType:string "i32"
    def builder (lctx.builder)
    if ((indexOf varName ".") >= 0) {
      def parts:[string] (strsplit varName ".")
      if ((array_length parts) >= 2) {
        def recv (itemAt parts 0)
        def fld (itemAt parts 1)
        def cls (this.resolveObjectClass(recv lctx))
        if ((strlen cls) > 0) {
          def sptr (this.resolveObjectPtr(recv cls lctx))
          ; Storing an owned local into a (borrow) object field: the field now
          ; holds the reference, so the local must not be released at scope end
          ; (would dangle the field). Mark it escaped. Object fields don't own,
          ; so the object leaks until borrow analysis can assign an owner.
          if (this.fieldIsObjectSlot(cls fld)) {
            if (rhs.value_type == RangerNodeType.VRef) {
              if (this.isOwnedObjectLocal(rhs.vref lctx)) {
                set lctx.escapedLocals rhs.vref "1"
              }
            }
          }
          this.emitFieldStoreOn(cls sptr fld tmp lctx)
          return
        }
      }
    }
    if (this.isClassField(varName lctx.className this.irModule)) {
      if (rhs.value_type == RangerNodeType.Boolean) {
        tmp = (builder.emitZextI1ToI32(tmp))
      }
      this.emitFieldStore(varName tmp lctx)
      return
    }
    if (has lctx.slots varName) {
      def slot (unwrap (get lctx.slots varName))
      def storeType (irType)
      if (has lctx.slotTypes varName) {
        storeType = (unwrap (get lctx.slotTypes varName))
      }
      if (rhs.value_type == RangerNodeType.Boolean) {
        if (storeType != "i1") {
          tmp = (builder.emitZextI1ToI32(tmp))
          storeType = "i32"
        }
      }
      if (storeType == "i8*") {
        tmp = (this.emitStrdupExpr(tmp lctx))
      }
      builder.emitStore(storeType tmp slot)
      return
    }
    this.bindSlot(varName irType tmp lctx)
  }

  fn lowerReturn:void (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def voidType:string "void"
    def retType:string lctx.llvmRetType
    if ((array_length node.children) > 1) {
      def valNode (node.getSecond())
      if (valNode.value_type == RangerNodeType.VRef) {
        ; A returned local escapes: the caller now owns it, so it must not be
        ; released here. Covers owned objects AND owned collections (ptr-arrays).
        set lctx.escapedLocals valNode.vref "1"
      }
      def tmp:string ""
      if (valNode.has_call || valNode.is_direct_method_call) {
        tmp = (this.lowerCall(valNode lctx))
      } {
        tmp = (this.lowerExpr(valNode lctx))
      }
      this.emitReleaseOwnedLocals(lctx)
      builder.terminateRet(retType tmp)
    } {
      this.emitReleaseOwnedLocals(lctx)
      if (retType == voidType) {
        builder.terminateRet(voidType "")
      } {
        def zero:string "0"
        def retVal (builder.emitConst("i32" zero))
        builder.terminateRet(retType retVal)
      }
    }
  }

  fn isCompareOp:boolean (op:string) {
    if (op == "==") {
      return true
    }
    if (op == "!=") {
      return true
    }
    if (op == "<") {
      return true
    }
    if (op == ">") {
      return true
    }
    if (op == "<=") {
      return true
    }
    if (op == ">=") {
      return true
    }
    return false
  }

  fn unwrapInfixExpr:CodeNode (node:CodeNode) {
    if node.infix_operator {
      if (!null? node.infix_node) {
        return (unwrap node.infix_node)
      }
    }
    return node
  }

  fn unwrapCondExpr:CodeNode (node:CodeNode) {
    def n (this.unwrapInfixExpr(node))
    if n.expression {
      def ecnt (array_length n.children)
      if (ecnt == 1) {
        return (this.unwrapCondExpr((itemAt n.children 0)))
      }
    }
    return n
  }

  fn exprProducesI1:boolean (node:CodeNode lctx:LowIRLowerContext) {
    def exprNode (this.unwrapCondExpr(node))
    if (exprNode.value_type == RangerNodeType.Boolean) {
      return true
    }
    if (exprNode.has_call || exprNode.is_direct_method_call || exprNode.hasFnCall) {
      if (!null? exprNode.fnDesc) {
        def fd (unwrap exprNode.fnDesc)
        if (!null? fd.nameNode) {
          def rn (unwrap fd.nameNode)
          if (rn.type_name == "boolean") {
            return true
          }
        }
      }
    }
    if (exprNode.value_type == RangerNodeType.VRef) {
      if (has lctx.slotTypes exprNode.vref) {
        def st (unwrap (get lctx.slotTypes exprNode.vref))
        if (st == "i1") {
          return true
        }
      }
      if (this.isClassField(exprNode.vref lctx.className this.irModule)) {
        if (this.fieldIsBoolSlot(lctx.className exprNode.vref)) {
          return true
        }
      }
      if ((indexOf exprNode.vref ".") >= 0) {
        def parts:[string] (strsplit exprNode.vref ".")
        if ((array_length parts) >= 2) {
          def recv (itemAt parts 0)
          def fld (itemAt parts 1)
          def cls (this.resolveObjectClass(recv lctx))
          if ((strlen cls) > 0) {
            if (this.fieldIsBoolSlot(cls fld)) {
              return true
            }
          }
        }
      }
    }
    if exprNode.has_operator {
      def op (exprNode.getOperator())
      if (op == "||") {
        return true
      }
      if (op == "&&") {
        return true
      }
      if (op == "null?") {
        return true
      }
      if (op == "!null?") {
        return true
      }
      return (this.isCompareOp(op))
    }
    return false
  }

  fn condVref:string (node:CodeNode) {
    if (node.value_type == RangerNodeType.VRef) {
      return node.vref
    }
    if ((array_length node.children) > 0) {
      def child (itemAt node.children 0)
      return (this.condVref(child))
    }
    return ""
  }

  fn lowerCond:string (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def condNode (this.unwrapCondExpr(node))
    if (condNode.value_type == RangerNodeType.VRef) {
      def vref:string condNode.vref
      if (has lctx.slotTypes vref) {
        def st (unwrap (get lctx.slotTypes vref))
        if (st == "i1") {
          return (this.loadSlot(vref "i1" lctx))
        }
      }
      if (this.isClassField(vref lctx.className this.irModule)) {
        if (this.fieldIsBoolSlot(lctx.className vref)) {
          return (this.emitFieldLoad(vref lctx))
        }
      }
    }
    def v (this.lowerExpr(condNode lctx))
    if (this.exprProducesI1(condNode lctx)) {
      return v
    }
    def vref (this.condVref(condNode))
    if ((strlen vref) > 0) {
      if (has lctx.slotTypes vref) {
        def st (unwrap (get lctx.slotTypes vref))
        if (st == "i1") {
          return v
        }
      }
    }
    def zero (builder.emitConst("i32" "0"))
    return (builder.emitIcmp("ne" v zero))
  }

  fn lowerIf:void (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def condNode (node.getSecond())
    def thenNode (node.getThird())
    def cond (this.lowerCond(condNode lctx))
    def thenTag:string "then"
    def elseTag:string "else"
    def mergeTag:string "merge"
    def thenLabel (builder.freshLabel(thenTag))
    def elseLabel (builder.freshLabel(elseTag))
    def mergeLabel (builder.freshLabel(mergeTag))

    def hasElse:boolean false
    if ((array_length node.children) > 3) {
      hasElse = true
    }

    if hasElse {
      builder.terminateBrIf(cond thenLabel elseLabel)
    } {
      builder.terminateBrIf(cond thenLabel mergeLabel)
    }

    builder.startBlock(thenLabel)
    this.lowerBlock(thenNode lctx)
    def thenBlock (unwrap builder.currentBlock)
    if (thenBlock.termKind == "") {
      builder.terminateBr(mergeLabel)
    }

    if hasElse {
      def elseNode@(optional):CodeNode
      if ((array_length node.children) > 3) {
        elseNode = (itemAt node.children 3)
      }
      if (!null? elseNode) {
        builder.startBlock(elseLabel)
        this.lowerBlock((unwrap elseNode) lctx)
        def elseBlock (unwrap builder.currentBlock)
        if (elseBlock.termKind == "") {
          builder.terminateBr(mergeLabel)
        }
      }
    }

    builder.startBlock(mergeLabel)
  }

  fn lowerWhile:void (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def condNode (node.getSecond())
    def bodyNode (node.getThird())
    def condTag:string "while_cond"
    def bodyTag:string "while_body"
    def exitTag:string "while_exit"
    def condLabel (builder.freshLabel(condTag))
    def bodyLabel (builder.freshLabel(bodyTag))
    def exitLabel (builder.freshLabel(exitTag))

    builder.terminateBr(condLabel)
    builder.startBlock(condLabel)
    def cond (this.lowerCond(condNode lctx))
    builder.terminateBrIf(cond bodyLabel exitLabel)

    builder.startBlock(bodyLabel)
    this.lowerBlock(bodyNode lctx)
    def bodyBlock (unwrap builder.currentBlock)
    if (bodyBlock.termKind == "") {
      builder.terminateBr(condLabel)
    }

    builder.startBlock(exitLabel)
  }

  fn lowerExpr:string (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def irI32:string "i32"
    def irF64:string "f64"
    def irI1:string "i1"
    def zero:string "0"
    def one:string "1"

    if (node.has_call || node.is_direct_method_call) {
      return (this.lowerCall(node lctx))
    }

    if node.infix_operator {
      if (!null? node.infix_node) {
        return (this.lowerExpr((unwrap node.infix_node) lctx))
      }
    }

    if node.has_operator {
      def opName (node.getOperator())
      if (opName == "get") {
        return (this.lowerCollectionGet(node lctx))
      }
      if (opName == "has") {
        return (this.lowerCollectionHas(node lctx))
      }
      if (opName == "array_length") {
        return (this.lowerCollectionLen(node lctx))
      }
      if (opName == "strlen") {
        return (this.lowerStrlen(node lctx))
      }
      if (opName == "length") {
        def lenNode (node.getSecond())
        if (lenNode.value_type == RangerNodeType.VRef) {
          def pdesc (this.ptrArrayDescFromVref(lenNode.vref lctx))
          if ((strlen pdesc) > 0) {
            return (this.emitPtrArrayLen(pdesc lctx))
          }
        }
        if ((strlen (this.collectionKind(lenNode.vref lctx))) > 0) {
          return (this.lowerCollectionLen(node lctx))
        }
        if (lenNode.value_type == RangerNodeType.String) {
          return (this.lowerStrlen(node lctx))
        }
      }
      if (opName == "itemAt") {
        return (this.lowerItemAt(node lctx))
      }
      if (opName == "make") {
        return (this.lowerCollectionMake(node lctx))
      }
      if (opName == "poll_keypress") {
        return (this.lowerPollKeypress(lctx))
      }
      if (opName == "shell_arg_cnt") {
        return (this.lowerShellArgCnt(lctx))
      }
      if (opName == "shell_arg") {
        return (this.lowerShellArg(node lctx))
      }
      if (opName == "read_file") {
        return (this.lowerReadFile(node lctx))
      }
      if (opName == "charAt") {
        return (this.lowerCharAt(node lctx))
      }
      if (opName == "at") {
        return (this.lowerAt(node lctx))
      }
      if (opName == "null?") {
        def argNode (node.getSecond())
        def ptr (this.lowerExpr(argNode lctx))
        if (this.exprIsObjectPtr(argNode lctx)) {
          def zero (builder.emitConst(lctx.ptrType "0"))
          return (builder.emitIcmpTyped("eq" lctx.ptrType ptr zero))
        }
        return (this.lowerPtrIsNull(ptr lctx))
      }
      if (opName == "!null?") {
        def argNode (node.getSecond())
        def ptr (this.lowerExpr(argNode lctx))
        if (this.exprIsObjectPtr(argNode lctx)) {
          def zero (builder.emitConst(lctx.ptrType "0"))
          return (builder.emitIcmpTyped("ne" lctx.ptrType ptr zero))
        }
        return (this.lowerPtrIsNotNull(ptr lctx))
      }
      if (opName == "unwrap") {
        def argNode (node.getSecond())
        return (this.lowerExpr(argNode lctx))
      }
      def binResult (this.lowerBinaryOp(opName node lctx))
      if ((strlen binResult) > 0) {
        return binResult
      }
    }

    if (node.infix_operator) {
      if (!null? node.infix_node) {
        return (this.lowerExpr((unwrap node.infix_node) lctx))
      }
    }

    if node.expression {
      if ((node.hasFnCall == false) && (node.is_direct_method_call == false) && (node.has_call == false)) {
        def ecnt (array_length node.children)
        if (ecnt > 0) {
          return (this.lowerExpr((itemAt node.children 0) lctx))
        }
      }
    }

    if (node.isPrimitive()) {
      switch node.value_type {
        case RangerNodeType.Integer {
          return (builder.emitConst(irI32 ("" + node.int_value)))
        }
        case RangerNodeType.Double {
          return (builder.emitConst(irF64 ("" + node.double_value)))
        }
        case RangerNodeType.Boolean {
          if node.boolean_value {
            return (builder.emitConst(irI1 one))
          }
          return (builder.emitConst(irI1 zero))
        }
      }
    }

    if (node.value_type == RangerNodeType.String) {
      def text (node.string_value)
      def gname (this.internStringGlobal(text false))
      def byteLen (this.stringGlobalByteLen(gname))
      return (builder.emitStrPtr(gname byteLen))
    }

    if node.hasNewOper {
      if (!null? node.clDesc) {
        def cl (unwrap node.clDesc)
        def argsNode (node.getThird())
        return (this.lowerNewObject(cl.name argsNode lctx))
      }
    }

    if (node.value_type == RangerNodeType.VRef) {
      if ((indexOf node.vref ".") >= 0) {
        def parts:[string] (strsplit node.vref ".")
        if ((array_length parts) >= 2) {
          def recv (itemAt parts 0)
          def fld (itemAt parts 1)
          def cls (this.resolveObjectClass(recv lctx))
          if ((strlen cls) > 0) {
            def sptr (this.resolveObjectPtr(recv cls lctx))
            return (this.emitFieldLoadOn(cls sptr fld lctx))
          }
        }
      }
      if (this.isClassField(node.vref lctx.className this.irModule)) {
        return (this.emitFieldLoad(node.vref lctx))
      }
      if (has lctx.collectionSlots node.vref) {
        def collKind (unwrap (get lctx.collectionSlots node.vref))
        if (collKind == "ptr_array") {
          return (this.loadSlot(node.vref lctx.ptrType lctx))
        }
        if (collKind == "array") {
          return (this.loadCollectionDesc(node.vref lctx))
        }
      }
      return (this.loadSlot(node.vref irI32 lctx))
    }

    if node.hasFnCall {
      return (this.lowerCall(node lctx))
    }

    if node.is_direct_method_call {
      return (this.lowerCall(node lctx))
    }

    return (builder.emitConst(irI32 zero))
  }

  fn exprIsStringish:boolean (node:CodeNode lctx:LowIRLowerContext) {
    def exprNode (this.unwrapCondExpr(node))
    if (this.exprProducesI1(exprNode lctx)) {
      return false
    }
    if (this.exprIsString(exprNode)) {
      return true
    }
    if (exprNode.has_call || exprNode.is_direct_method_call || exprNode.hasFnCall) {
      if (!null? exprNode.fnDesc) {
        def fd (unwrap exprNode.fnDesc)
        if (!null? fd.nameNode) {
          def rn (unwrap fd.nameNode)
          if (LowIRUtil.isStringType(rn.type_name)) {
            return true
          }
        }
      }
    }
    if exprNode.has_operator {
      if ((node.getOperator()) == "+") {
        def aNode (node.getSecond())
        def bNode (node.getThird())
        if ((this.exprIsStringish(aNode lctx)) || (this.exprIsStringish(bNode lctx))) {
          return true
        }
      }
    }
    if (exprNode.value_type == RangerNodeType.VRef) {
      if (LowIRUtil.isStringType(exprNode.type_name)) {
        return true
      }
      if (LowIRUtil.isStringType(exprNode.eval_type_name)) {
        return true
      }
      if ((indexOf exprNode.vref ".") >= 0) {
        def parts:[string] (strsplit exprNode.vref ".")
        if ((array_length parts) >= 2) {
          def recv (itemAt parts 0)
          def fld (itemAt parts 1)
          def cls (this.resolveObjectClass(recv lctx))
          if ((strlen cls) > 0) {
            if (this.fieldIsStringSlot(cls fld)) {
              return true
            }
          }
        }
      }
      if (has lctx.slotTypes exprNode.vref) {
        def st (unwrap (get lctx.slotTypes exprNode.vref))
        if (st == "i8*") {
          return true
        }
      }
    }
    return false
  }

  fn lowerStringCompare:string (aNode:CodeNode bNode:CodeNode pred:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def lhs (this.lowerExpr(aNode lctx))
    def rhs (this.lowerExpr(bNode lctx))
    def args:[string]
    def argTypes:[string]
    push args lhs
    push argTypes "i8*"
    push args rhs
    push argTypes "i8*"
    def sc (builder.emitCall("strcmp" "i32" args argTypes))
    def zero (builder.emitConst("i32" "0"))
    return (builder.emitIcmp(pred sc zero))
  }

  fn lowerCompareI32:string (aNode:CodeNode bNode:CodeNode pred:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def a (this.lowerExpr(aNode lctx))
    def b (this.lowerExpr(bNode lctx))
    def aI1:boolean (this.exprProducesI1(aNode lctx))
    def bI1:boolean (this.exprProducesI1(bNode lctx))
    if (aI1 && bI1) {
      return (builder.emitIcmpTyped(pred "i1" a b))
    }
    if (aI1 || (aNode.value_type == RangerNodeType.Boolean)) {
      a = (builder.emitZextI1ToI32(a))
    }
    if (bI1 || (bNode.value_type == RangerNodeType.Boolean)) {
      b = (builder.emitZextI1ToI32(b))
    }
    return (builder.emitIcmp(pred a b))
  }

  fn lowerBinaryOp:string (opName:string node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def irI32:string "i32"
    switch opName {
      case "+" {
        def aNode (node.getSecond())
        def bNode (node.getThird())
        if ((this.exprMightBeString(aNode lctx)) || (this.exprMightBeString(bNode lctx))) {
          return (this.lowerStringConcat(aNode bNode lctx))
        }
        def a (this.lowerExpr(aNode lctx))
        def b (this.lowerExpr(bNode lctx))
        def kind:string "add"
        return (builder.emitBin(kind irI32 a b))
      }
      case "-" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        def kind:string "sub"
        return (builder.emitBin(kind irI32 a b))
      }
      case "*" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        def kind:string "mul"
        return (builder.emitBin(kind irI32 a b))
      }
      case "/" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        def kind:string "sdiv"
        return (builder.emitBin(kind irI32 a b))
      }
      case "%" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        def kind:string "srem"
        return (builder.emitBin(kind irI32 a b))
      }
      case "<" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        def pred:string "slt"
        return (builder.emitIcmp(pred a b))
      }
      case ">" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        def pred:string "sgt"
        return (builder.emitIcmp(pred a b))
      }
      case "<=" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        def pred:string "sle"
        return (builder.emitIcmp(pred a b))
      }
      case ">=" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        def pred:string "sge"
        return (builder.emitIcmp(pred a b))
      }
      case "==" {
        def aNode (node.getSecond())
        def bNode (node.getThird())
        if (((this.exprProducesI1(aNode lctx)) == false) && ((this.exprProducesI1(bNode lctx)) == false)) {
          if ((this.exprIsStringish(aNode lctx)) || (this.exprIsStringish(bNode lctx))) {
            return (this.lowerStringCompare(aNode bNode "eq" lctx))
          }
        }
        return (this.lowerCompareI32(aNode bNode "eq" lctx))
      }
      case "!=" {
        def aNode (node.getSecond())
        def bNode (node.getThird())
        if (((this.exprProducesI1(aNode lctx)) == false) && ((this.exprProducesI1(bNode lctx)) == false)) {
          if ((this.exprIsStringish(aNode lctx)) || (this.exprIsStringish(bNode lctx))) {
            return (this.lowerStringCompare(aNode bNode "ne" lctx))
          }
        }
        return (this.lowerCompareI32(aNode bNode "ne" lctx))
      }
      case "||" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        return (builder.emitBin("or" "i1" a b))
      }
      case "&&" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        return (builder.emitBin("and" "i1" a b))
      }
    }
    return ""
  }

  fn tryLowerIntrinsic:string (fnName:string argsNode:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def notIntrinsic:string ""
    def handledVoid:string "__void__"
    if (fnName == "Mem_alloc") {
      if ((array_length argsNode.children) > 0) {
        def nbytes (this.lowerExpr((itemAt argsNode.children 0) lctx))
        return (builder.emitHeapAlloc(nbytes))
      }
      return notIntrinsic
    }
    if (fnName == "Mem_loadI32") {
      if ((array_length argsNode.children) > 0) {
        def ptr (this.lowerExpr((itemAt argsNode.children 0) lctx))
        return (builder.emitPtrLoad(ptr))
      }
      return notIntrinsic
    }
    if (fnName == "Mem_storeI32") {
      if ((array_length argsNode.children) > 1) {
        def ptr (this.lowerExpr((itemAt argsNode.children 0) lctx))
        def val (this.lowerExpr((itemAt argsNode.children 1) lctx))
        builder.emitPtrStore(ptr val)
        return handledVoid
      }
      return notIntrinsic
    }
    if (fnName == "RangerMem_liveObjects") {
      this.usedMemRuntime = true
      this.ensureMemExtern((LowIRTarget.resolve((unwrap lctx.ctx))))
      def args:[string]
      def argTypes:[string]
      return (builder.emitCall("ranger_mem_live_objects" "i32" args argTypes))
    }
    if (fnName == "RangerMem_resetStats") {
      this.usedMemRuntime = true
      this.ensureMemExtern((LowIRTarget.resolve((unwrap lctx.ctx))))
      def args:[string]
      def argTypes:[string]
      def voidType:string "void"
      builder.emitCall("ranger_mem_reset_stats" voidType args argTypes)
      return handledVoid
    }
    return notIntrinsic
  }

  fn finishObjectCall:string (rv:string) {
    if ((strlen rv) > 0) {
      return rv
    }
    def voidTag:string "__void__"
    return voidTag
  }

  fn lowerCall:string (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def voidTag:string "__void__"
    def objectCall (this.tryLowerObjectCall(node lctx))
    if (objectCall == voidTag) {
      return ""
    }
    if ((strlen objectCall) > 0) {
      return objectCall
    }
    if (node.is_direct_method_call || node.has_call) {
      return (this.lowerInstanceCall(node lctx))
    }
    def calleeNode (node.getFirst())
    def argsNode (node.getSecond())
    def calleeVref:string calleeNode.vref
    def calleeDot:int (indexOf calleeVref ".")
    if (calleeDot >= 0) {
      def calleeParts:[string] (strsplit calleeVref ".")
      if ((array_length calleeParts) >= 2) {
        def recvPart (itemAt calleeParts 0)
        if (recvPart == "this") {
          def methPart (itemAt calleeParts 1)
          calleeNode.eval_type_name = lctx.className
          return (this.lowerInstanceCallOn(node "this" calleeNode methPart lctx))
        }
      }
    }
    if ((array_length calleeNode.ns) >= 2) {
      def recvName (itemAt calleeNode.ns 0)
      def methName (itemAt calleeNode.ns 1)
      if (has lctx.objectSlots recvName) {
        calleeNode.eval_type_name = (unwrap (get lctx.objectSlots recvName))
        return (this.lowerInstanceCallOn(node recvName calleeNode methName lctx))
      }
    }
    def fnName:string (this.resolveCalleeName(calleeNode))
    if (fnName == "at") {
      return (this.lowerAtCall(argsNode lctx))
    }
    def intrinsic (this.tryLowerIntrinsic(fnName argsNode lctx))
    if (intrinsic == "__void__") {
      return ""
    }
    if ((strlen intrinsic) > 0) {
      return intrinsic
    }
    def retType:string "i32"
    if (!null? node.fnDesc) {
      if (!null? node.fnDesc.nameNode) {
        def rn (unwrap node.fnDesc.nameNode)
        retType = (this.llvmTypeForRanger(rn.type_name lctx.ptrType))
      }
    }
    def args:[string]
    def argTypes:[string]
    def argIdx:int 0
    for argsNode.children arg:CodeNode i {
      push args (this.lowerExpr(arg lctx))
      if (!null? node.fnDesc) {
        push argTypes (this.paramIrTypeFromDesc(argIdx (unwrap node.fnDesc) lctx))
      } {
        push argTypes (this.argIrType(arg lctx))
      }
      argIdx = argIdx + 1
    }
    return (builder.emitCall(fnName retType args argTypes))
  }

  fn tryLowerObjectCall:string (node:CodeNode lctx:LowIRLowerContext) {
    if ((array_length node.children) < 2) {
      return ""
    }
    if node.has_call {
      if ((array_length node.children) > 3) {
        def recv (node.getSecond())
        def meth (node.getThird())
        if (has lctx.objectSlots recv.vref) {
          recv.eval_type_name = (unwrap (get lctx.objectSlots recv.vref))
          return (this.finishObjectCall((this.lowerInstanceCallOn(node recv.vref recv meth.vref lctx))))
        }
      }
    }
    def callee (node.getFirst())
    def argsNode (node.getSecond())
    def v:string callee.vref
    def dotPos:int (indexOf v ".")
    if (dotPos >= 0) {
      def parts:[string] (strsplit v ".")
      if ((array_length parts) >= 2) {
        def recvName (itemAt parts 0)
        if (recvName == "this") {
          def methName (itemAt parts 1)
          callee.eval_type_name = lctx.className
          return (this.finishObjectCall((this.lowerInstanceCallOn(node recvName callee methName lctx))))
        }
        if (has lctx.objectSlots recvName) {
          def methName (itemAt parts 1)
          callee.eval_type_name = (unwrap (get lctx.objectSlots recvName))
          return (this.finishObjectCall((this.lowerInstanceCallOn(node recvName callee methName lctx))))
        }
      }
    }
    if (callee.value_type == RangerNodeType.VRef) {
      if (has lctx.objectSlots callee.vref) {
        return (this.finishObjectCall((this.lowerInstanceCallOn(node callee.vref callee node.vref lctx))))
      }
    }
    return ""
  }

  fn callArgsNode:CodeNode (node:CodeNode) {
    if node.has_call {
      if ((array_length node.children) > 3) {
        return (itemAt node.children 3)
      }
    }
    return (node.getSecond())
  }

  fn resolveMethodName:string (node:CodeNode defaultName:string) {
    if ((strlen defaultName) > 0) {
      return defaultName
    }
    if (!null? node.fnDesc) {
      def fd (unwrap node.fnDesc)
      return fd.name
    }
    def callee (node.getFirst())
    def v:string callee.vref
    def dotPos:int (indexOf v ".")
    if (dotPos >= 0) {
      def parts:[string] (strsplit v ".")
      if ((array_length parts) >= 2) {
        return (itemAt parts 1)
      }
    }
    return ""
  }

  fn argIrType:string (arg:CodeNode lctx:LowIRLowerContext) {
    if (arg.value_type == RangerNodeType.String) {
      return "i8*"
    }
    if (arg.value_type == RangerNodeType.VRef) {
      if (has lctx.slotTypes arg.vref) {
        def st (unwrap (get lctx.slotTypes arg.vref))
        if ((strlen st) > 0) {
          return st
        }
      }
    }
    return "i32"
  }

  fn paramIrTypeFromDesc:string (paramIndex:int fnDesc:RangerAppFunctionDesc lctx:LowIRLowerContext) {
    if (paramIndex >= (array_length fnDesc.params)) {
      return "i32"
    }
    def p (itemAt fnDesc.params paramIndex)
    if (null? p.nameNode) {
      return "i32"
    }
    def pn (unwrap p.nameNode)
    return (this.llvmTypeForRanger(pn.type_name lctx.ptrType))
  }

  fn lowerInstanceCallOn:string (node:CodeNode receiverName:string recvNode:CodeNode methodName:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def objPtr:string ""
    def className:string recvNode.eval_type_name
    if (receiverName == "this") {
      objPtr = lctx.selfPtr
      className = lctx.className
    } {
      if ((strlen className) == 0) {
        if (has lctx.objectSlots receiverName) {
          className = (unwrap (get lctx.objectSlots receiverName))
        }
      }
      def addr (this.loadSlot(receiverName lctx.ptrType lctx))
      objPtr = (builder.emitIntToStructPtr(className addr))
    }
    def methName (this.resolveMethodName(node methodName))
    if (!null? node.fnDesc) {
      def fd (unwrap node.fnDesc)
      methName = fd.name
      if ((strlen className) == 0) {
        className = fd.container_class.name
      }
    }
    def fnName (LowIRUtil.mangleMethod(className methName))
    def voidType:string "void"
    def retType:string "i32"
    if (!null? node.fnDesc) {
      if (!null? node.fnDesc.nameNode) {
        def rn (unwrap node.fnDesc.nameNode)
        retType = (this.llvmTypeForRanger(rn.type_name lctx.ptrType))
      }
    } {
      if ((methName == "push") || (methName == "put") || (methName == "putAt") || (methName == "storeI32")) {
        retType = voidType
      }
    }
    def args:[string]
    def argTypes:[string]
    push args objPtr
    push argTypes (LowIRUtil.structPtrType(className))
    def argsNode (this.callArgsNode(node))
    def argIdx:int 0
    for argsNode.children arg:CodeNode i {
      push args (this.lowerExpr(arg lctx))
      if (!null? node.fnDesc) {
        push argTypes (this.paramIrTypeFromDesc(argIdx (unwrap node.fnDesc) lctx))
      } {
        push argTypes (this.argIrType(arg lctx))
      }
      argIdx = argIdx + 1
    }
    return (builder.emitCall(fnName retType args argTypes))
  }

  fn lowerInstanceCall:string (node:CodeNode lctx:LowIRLowerContext) {
    def objNode@(optional):CodeNode
    def methodName:string node.vref
    if node.is_direct_method_call {
      objNode = (node.getFirst())
      if ((array_length node.children) > 2) {
        def methodNode (node.getSecond())
        methodName = methodNode.vref
      }
    } {
      if ((array_length node.children) > 3) {
        objNode = (node.getSecond())
        def methodNode (node.getThird())
        methodName = methodNode.vref
      }
    }
    if (null? objNode) {
      def builder (lctx.builder)
      return (builder.emitConst("i32" "0"))
    }
    def obj (unwrap objNode)
    return (this.lowerInstanceCallOn(node obj.vref obj methodName lctx))
  }

  fn resolveCalleeName:string (callee:CodeNode) {
    if ((array_length callee.ns) >= 2) {
      def cls (itemAt callee.ns 0)
      def meth (itemAt callee.ns 1)
      return (LowIRUtil.mangleMethod(cls meth))
    }
    def v:string callee.vref
    def dotPos:int (indexOf v ".")
    if (dotPos >= 0) {
      def parts:[string] (strsplit v ".")
      if ((array_length parts) >= 2) {
        def p0 (itemAt parts 0)
        def p1 (itemAt parts 1)
        if (p0 != "this") {
          return (LowIRUtil.mangleMethod(p0 p1))
        }
      }
    }
    return v
  }
}

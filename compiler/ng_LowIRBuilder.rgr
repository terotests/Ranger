  fn lowerAtArgs:string (textNode:CodeNode posNode:CodeNode lctx:LowIRLowerContext) {
    def text (this.lowerExpr(textNode lctx))
    def pos (this.lowerExpr(posNode lctx))
    def args:[string]
    def argTypes:[string]
    push args text
    push argTypes "i8*"
    push args pos
    push argTypes "i32"
    def chPtr (lctx.builder.emitCall("ranger_at_char" "i8*" args argTypes))
    def dupArgs:[string]
    def dupArgTypes:[string]
    push dupArgs chPtr
    push dupArgTypes "i8*"
    return (lctx.builder.emitCall("ranger_strdup" "i8*" dupArgs dupArgTypes))
  }

  fn lowerAt:string (node:CodeNode lctx:LowIRLowerContext) {
    return (this.lowerAtArgs((node.getSecond()) (node.getThird()) lctx))
  }

  fn lowerAtCall:string (argsNode:CodeNode lctx:LowIRLowerContext) {
    if ((array_length argsNode.children) < 2) {
      return ""
    }
    return (this.lowerAtArgs((itemAt argsNode.children 0) (itemAt argsNode.children 1) lctx))
  }

  fn lowerPtrIsNull:string (ptr:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def vt:string (builder.emittedType(ptr))
    if ((vt == "i32") || (vt == "i1")) {
      def zeroI (builder.emitConst(vt "0"))
      return (builder.emitIcmpTyped("eq" vt ptr zeroI))
    }
    if (vt == "f64") {
      def zeroF (builder.emitConst("f64" "0.0"))
      return (builder.emitIcmpTyped("eq" "f64" ptr zeroF))
    }
    def asInt (builder.emitPtrToInt(ptr))
    def zero (builder.emitConst(lctx.ptrType "0"))
    return (builder.emitIcmpTyped("eq" lctx.ptrType asInt zero))
  }

  ; `!null? x`. `x` is usually a POINTER, but an optional whose value type is a
  ; primitive (`def idx@(optional) (get someIntMap k)`) is already an integer,
  ; and ptrtoint over one does not assemble. The type the builder actually
  ; emitted says which it is.
  fn lowerPtrIsNotNull:string (ptr:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def vt:string (builder.emittedType(ptr))
    if ((vt == "i32") || (vt == "i1")) {
      def zeroI (builder.emitConst(vt "0"))
      return (builder.emitIcmpTyped("ne" vt ptr zeroI))
    }
    if (vt == "f64") {
      def zeroF (builder.emitConst("f64" "0.0"))
      return (builder.emitIcmpTyped("ne" "f64" ptr zeroF))
    }
    def asInt (builder.emitPtrToInt(ptr))
    def zero (builder.emitConst(lctx.ptrType "0"))
    return (builder.emitIcmpTyped("ne" lctx.ptrType asInt zero))
  }

  fn loadArrayDescExpr:string (arrNode:CodeNode lctx:LowIRLowerContext) {
    def desc (this.loadPtrArrayDescExpr(arrNode lctx))
    if (arrNode.value_type == RangerNodeType.VRef) {
      if ((strlen (this.ptrArrayDescFromVref(arrNode.vref lctx))) > 0) {
        return desc
      }
      if (this.resolvesToField(arrNode.vref lctx)) {
        if (this.fieldIsPtrArraySlot(lctx.className arrNode.vref)) {
          return (this.emitFieldLoad(arrNode.vref lctx))
        }
      }
    }
    return (this.lowerExpr(arrNode lctx))
  }

  ; True when a value pushed into a ptr-array is a 32-bit int that must be widened
  ; to the pointer-sized element slot (i.e. not an object pointer, string, or double).
  ; An element READ OUT of a pointer array is already pointer-sized: the runtime
  ; getter returns i64. exprIsObjectPtr only recognises VRefs, so pushing one
  ; array's element into another produced `zext i32 <i64 value> to i64` -- an
  ; operand type clang rejects outright.
  fn exprIsPtrSizedRead:boolean (rawNode:CodeNode lctx:LowIRLowerContext) {
    ; `( (itemAt xs i) )` -- a parenthesised group is one more node in the way,
    ; and stopping at it reported "not a pointer read" and widened an i64.
    def itemNode (this.unwrapCondExpr(rawNode))
    if ((itemNode.has_operator) == false) {
      return false
    }
    def op (itemNode.getOperator())
    ; `unwrap` is transparent: `push list (unwrap (get m n))` is the same read
    ; with a wrapper around it, and stopping at the wrapper widened a value
    ; that was already pointer sized.
    if (op == "unwrap") {
      return (this.exprIsPtrSizedRead((itemNode.getSecond()) lctx))
    }
    if ((op != "itemAt") && (op != "get")) {
      return false
    }
    def collNode (itemNode.getSecond())
    ; `(get m k)` on a MAP: the runtime answers i64 for every value kind except
    ; int, so an object or string value is already pointer sized. Only the
    ; array element type was consulted, so `push list (get map n)` widened a
    ; value that was an i64 already.
    if (op == "get") {
      if (collNode.value_type == RangerNodeType.VRef) {
        def mk:string (this.smapValueKind(collNode.vref lctx))
        if (this.isStringMapVref(collNode.vref lctx)) {
          if (mk == "int") {
            return false
          }
          return true
        }
      }
    }
    def elemType (this.arrayElemTypeName(collNode lctx))
    if ((strlen elemType) == 0) {
      return false
    }
    ; Only the types the runtime stores as a pointer. Anything scalar still
    ; needs the widen, so an unknown element type keeps the old behaviour.
    if (LowIRUtil.isStringType(elemType)) {
      return true
    }
    if (elemType == "int") { return false }
    if (elemType == "boolean") { return false }
    if (elemType == "double") { return false }
    if (elemType == "float") { return false }
    if (elemType == "char") { return false }
    return true
  }

  ; Whether a value has to be widened before it goes into a pointer-sized
  ; array slot. `emitted` is the type the builder actually produced for it,
  ; which settles the question outright when it is known; the shape tests
  ; below are the fallback for values it did not produce.
  fn pushValueNeedsWiden:boolean (itemNode:CodeNode value:string lctx:LowIRLowerContext) {
    def et:string (lctx.builder.emittedType(value))
    if ((strlen et) > 0) {
      if (et == "i32") { return true }
      if (et == "i1") { return true }
      return false
    }
    return (this.pushItemNeedsWiden(itemNode lctx))
  }

  fn pushItemNeedsWiden:boolean (itemNode:CodeNode lctx:LowIRLowerContext) {
    ; `this` lowers to a ptrtoint and is already pointer sized, so widening it
    ; emitted `zext i32 <i64 value>`. exprIsObjectPtr only recognises named
    ; locals, and `this` is a parameter, not a slot.
    if (itemNode.value_type == RangerNodeType.VRef) {
      if (itemNode.vref == "this") {
        return false
      }
    }
    if (this.exprIsObjectPtr(itemNode lctx)) {
      return false
    }
    if (this.exprIsPtrSizedRead(itemNode lctx)) {
      return false
    }
    if (this.exprIsStringish(itemNode lctx)) {
      return false
    }
    if (this.exprIsF64(itemNode)) {
      return false
    }
    ; Last resort, from the node's own TYPE: a static call answering a class
    ; (`CodeNode.fromList(...)`) has no fnDesc for the tests above to read, and
    ; widening its i64 result emitted `zext i32 <i64 value>`.
    if ((this.argIrType(itemNode lctx)) == lctx.ptrType) {
      if (lctx.ptrType != "i32") {
        return false
      }
    }
    return true
  }

  ; The declared element type name of an array referenced by arrNode (field,
  ; receiver.field, or "" if unknown).
  fn arrayElemTypeName:string (arrNode:CodeNode lctx:LowIRLowerContext) {
    if ((strlen arrNode.array_type) > 0) {
      return arrNode.array_type
    }
    if (arrNode.value_type == RangerNodeType.VRef) {
      def vr:string arrNode.vref
      if ((indexOf vr ".") >= 0) {
        def parts:[string] (strsplit vr ".")
        def np:int (array_length parts)
        if (np >= 2) {
          ; The receiver is everything before the last segment, so a chain such
          ; as `callArgs.parent.children` resolves. Reading only the first two
          ; segments answered "" and `indexOf` over it went to the STRING
          ; helper with an array descriptor.
          def recv:string (this.joinDotPrefix(parts (np - 1)))
          def fld (itemAt parts (np - 1))
          def cls (this.resolveObjectClassChain(recv lctx))
          if ((strlen cls) > 0) {
            return (this.fieldArrayElemType(cls fld lctx))
          }
        }
        return ""
      }
      if (this.resolvesToField(vr lctx)) {
        return (this.fieldArrayElemType(lctx.className vr lctx))
      }
      if (has lctx.ptrArrayElemTypes vr) {
        return (unwrap (get lctx.ptrArrayElemTypes vr))
      }
    }
    return ""
  }

  ; Is this expression an ARRAY (rather than a string)? Only reads type
  ; information -- it must not emit anything, because it decides which lowering
  ; runs.
  fn nodeIsArrayExpr:boolean (node:CodeNode lctx:LowIRLowerContext) {
    if (node.value_type == RangerNodeType.Array) {
      return true
    }
    if (LowIRUtil.isArrayTypeName(node.type_name)) {
      return true
    }
    if (LowIRUtil.isArrayTypeName(node.eval_type_name)) {
      return true
    }
    if (node.value_type == RangerNodeType.VRef) {
      if (has lctx.ptrArrayElemTypes node.vref) {
        return true
      }
      if (has lctx.collectionSlots node.vref) {
        return true
      }
      if ((strlen (this.arrayElemTypeName(node lctx))) > 0) {
        return true
      }
    }
    return false
  }

  ; `indexOf xs v` over a pointer array: the position of the first element
  ; equal to `v`, or -1. Emitted as a loop rather than sent to C, because the
  ; element may be an object, a string pointer or a widened int and only this
  ; side knows which.
  fn lowerArrayIndexOf:string (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def arrNode (node.getSecond())
    def valNode (node.getThird())
    def desc (this.loadArrayDescExpr(arrNode lctx))
    def needle (this.lowerExpr(valNode lctx))
    def elemIsStr:boolean (LowIRUtil.isStringType((this.arrayElemTypeName(arrNode lctx))))
    ; The array's slots are pointer sized. Widen only a value that really is
    ; 32 bits: `this` is already an i64 (ptrtoint), and zext'ing it emitted
    ; `zext i32 <i64 value>`.
    if (elemIsStr == false) {
      if ((this.argIrType(valNode lctx)) == "i32") {
        if (this.exprProducesI1(valNode lctx)) {
          needle = (builder.emitCast("zext" "i64" "i1" needle))
        } {
          needle = (builder.emitCast("zext" "i64" "i32" needle))
        }
      }
    }
    this.usedPtrArrayRuntime = true
    def lenArgs:[string]
    def lenTypes:[string]
    push lenArgs desc
    push lenTypes lctx.ptrType
    def n (builder.emitCall("RtPtrArray_len" "i32" lenArgs lenTypes))
    def zero (builder.emitConst("i32" "0"))
    def one (builder.emitConst("i32" "1"))
    def minusOne (builder.emitConst("i32" "-1"))
    def iSlot (builder.emitAlloca("i32" (builder.freshTemp("aidxi"))))
    def rSlot (builder.emitAlloca("i32" (builder.freshTemp("aidxr"))))
    builder.emitStore("i32" zero iSlot)
    builder.emitStore("i32" minusOne rSlot)
    def condL (builder.freshLabel("aidx_cond"))
    def bodyL (builder.freshLabel("aidx_body"))
    def hitL (builder.freshLabel("aidx_hit"))
    def nextL (builder.freshLabel("aidx_next"))
    def doneL (builder.freshLabel("aidx_done"))
    builder.terminateBr(condL)
    builder.startBlock(condL)
    def iNow (builder.emitLoad("i32" iSlot))
    builder.terminateBrIf((builder.emitIcmp("slt" iNow n)) bodyL doneL)
    builder.startBlock(bodyL)
    def iCur (builder.emitLoad("i32" iSlot))
    def gArgs:[string]
    def gTypes:[string]
    push gArgs desc
    push gTypes lctx.ptrType
    push gArgs iCur
    push gTypes "i32"
    def elem (builder.emitCall("RtPtrArray_get" lctx.ptrType gArgs gTypes))
    def same:string ""
    if elemIsStr {
      ; string elements compare by CONTENT, the way `indexOf` does on every
      ; other target
      def elemPtr (builder.emitIntToI8Ptr(elem lctx.ptrType))
      def cmpPs:[string]
      push cmpPs "i8*"
      push cmpPs "i8*"
      ; libc has strcmp; only the freestanding WASM runtime needs its own.
      def elemCmpFn:string "strcmp"
      if (this.wasmStrEnabled(lctx)) {
        elemCmpFn = "ranger_str_cmp"
      }
      this.ensureExternDecl(elemCmpFn "i32" cmpPs false)
      def cArgs:[string]
      def cTypes:[string]
      push cArgs elemPtr
      push cTypes "i8*"
      push cArgs needle
      push cTypes "i8*"
      def cmpV (builder.emitCall(elemCmpFn "i32" cArgs cTypes))
      same = (builder.emitIcmp("eq" cmpV zero))
    } {
      ; both operands are pointer-sized array slots
      same = (builder.emitIcmpTyped("eq" lctx.ptrType elem needle))
    }
    builder.terminateBrIf(same hitL nextL)
    builder.startBlock(hitL)
    builder.emitStore("i32" (builder.emitLoad("i32" iSlot)) rSlot)
    builder.terminateBr(doneL)
    builder.startBlock(nextL)
    def iAt (builder.emitLoad("i32" iSlot))
    builder.emitStore("i32" (builder.emitBin("add" "i32" iAt one)) iSlot)
    builder.terminateBr(condL)
    builder.startBlock(doneL)
    return (builder.emitLoad("i32" rSlot))
  }

  ; `([] _:T ( a b c ))` and the untyped `([] a b c)`. The element type comes
  ; from the declared one when there is one, and otherwise from the first
  ; element -- the compiler writes `def skip_if ([] "Extends" "operator" …)`
  ; with no annotation at all. Nothing lowered this: the literal answered its
  ; FIRST element, so `indexOf skip_if x` searched a string as if it were an
  ; array descriptor.
  ; The literal does not always arrive with has_operator set, so the head vref
  ; is the reliable test.
  ; `def xs ([] "a" "b")`. By the time the backend sees it the `[]` head is
  ; gone: the value node IS the array, with the elements as its children and
  ; nothing on the node itself to say so. What does say so is the DEFINITION --
  ; the flow parser gave the name an array type. Without this the literal
  ; lowered to its first element, so `indexOf skip_if x` searched a string as
  ; if it were an array descriptor.
  fn isArrayLiteralValue:boolean (nameNode:CodeNode val:CodeNode) {
    if (nameNode.value_type != RangerNodeType.Array) {
      return false
    }
    if (val.has_operator) { return false }
    if (val.has_call) { return false }
    if (val.hasFnCall) { return false }
    if (val.has_lambda) { return false }
    if (val.has_lambda_call) { return false }
    if (val.is_direct_method_call) { return false }
    if (val.hasNewOper) { return false }
    if ((strlen val.vref) > 0) { return false }
    return ((array_length val.children) > 0)
  }

  fn arrayLiteralElemType:string (nameNode:CodeNode node:CodeNode lctx:LowIRLowerContext) {
    if ((strlen nameNode.array_type) > 0) {
      return nameNode.array_type
    }
    if ((strlen node.array_type) > 0) {
      return node.array_type
    }
    if ((array_length node.children) > 0) {
      def first (itemAt node.children 0)
      if (first.value_type == RangerNodeType.String) {
        return "string"
      }
      if (first.value_type == RangerNodeType.Integer) {
        return "int"
      }
      if (first.value_type == RangerNodeType.Double) {
        return "double"
      }
      if ((strlen first.eval_type_name) > 0) {
        return first.eval_type_name
      }
      if ((strlen first.type_name) > 0) {
        return first.type_name
      }
    }
    return ""
  }

  fn lowerArrayLiteral:string (nameNode:CodeNode node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def elemType:string (this.arrayLiteralElemType(nameNode node lctx))
    def kind:int 1
    if (LowIRUtil.isStringType(elemType)) {
      kind = 2
    }
    if (elemType == "int") { kind = 0 }
    if (elemType == "boolean") { kind = 0 }
    if (elemType == "double") { kind = 0 }
    if (elemType == "float") { kind = 0 }
    if (elemType == "char") { kind = 0 }
    this.usedPtrArrayRuntime = true
    def desc (this.emitPtrArrayNewEmpty(lctx kind))
    if true {
      for node.children el:CodeNode i {
        def v (this.lowerExpr(el lctx))
        if (kind == 2) {
          def owned:string v
          if (this.memEnabled(lctx)) {
            owned = (this.emitStrdupExpr(v lctx))
          }
          v = (builder.emitPtrToInt(owned))
        } {
          if (lctx.ptrType == "i64") {
            if (this.pushValueNeedsWiden(el v lctx)) {
              if (this.exprProducesI1(el lctx)) {
                v = (builder.emitCast("zext" "i64" "i1" v))
              } {
                v = (builder.emitCast("zext" "i64" "i32" v))
              }
            }
          }
        }
        def args:[string]
        def argTypes:[string]
        push args desc
        push argTypes lctx.ptrType
        push args v
        push argTypes lctx.ptrType
        def voidT:string "void"
        builder.emitCall("RtPtrArray_push" voidT args argTypes)
      }
    }
    return desc
  }

  fn lowerPush:void (node:CodeNode lctx:LowIRLowerContext) {
    def arrNode (node.getSecond())
    def itemNode (node.getThird())
    def desc (this.loadArrayDescExpr(arrNode lctx))
    def itemAddr:string ""
    if itemNode.hasNewOper {
      def itemCls (this.newTargetClassName(itemNode lctx))
      if ((strlen itemCls) == 0) {
        itemCls = (this.arrayElemTypeName(arrNode lctx))
      }
      if ((strlen itemCls) > 0) {
        itemAddr = (this.lowerNewObject(itemCls (itemNode.getThird()) lctx))
      } {
        itemAddr = (this.lowerExpr(itemNode lctx))
      }
    } {
      itemAddr = (this.lowerExpr(itemNode lctx))
    }
    ; A ptr-array stores pointer-sized (i64) INTEGERS. An int element is computed
    ; as i32, so widen it; an object element is already an integer address; a
    ; string element is a POINTER and has to be converted, which is the mirror of
    ; the inttoptr emitPtrArrayElemGet does on the way out. Pushing one without
    ; the conversion passed `i64 <ptr value>`, which clang rejects.
    if (lctx.ptrType == "i64") {
      if (this.pushValueNeedsWiden(itemNode itemAddr lctx)) {
        ; A boolean element arrives as i1, an int one as i32 -- widen from
        ; whichever it really is, the way lowerCollectionSet already did.
        if (this.exprProducesI1(itemNode lctx)) {
          itemAddr = (lctx.builder.emitCast("zext" "i64" "i1" itemAddr))
        } {
          itemAddr = (lctx.builder.emitCast("zext" "i64" "i32" itemAddr))
        }
      } {
        if (LowIRUtil.isStringType((this.arrayElemTypeName(arrNode lctx)))) {
          ; The array OWNS its string elements (element kind 2 -- released with
          ; the array), so it stores a private copy. Storing the pointer as-is
          ; made the array own a literal or a borrowed local, and freeing that
          ; on release crashed.
          def ownedStr:string itemAddr
          if (this.memEnabled(lctx)) {
            ownedStr = (this.emitStrdupExpr(itemAddr lctx))
          }
          itemAddr = (lctx.builder.emitPtrToInt(ownedStr))
        }
        if (this.arrayElemIsDouble(arrNode lctx)) {
          itemAddr = (lctx.builder.emitCast("bitcast" "i64" "f64" itemAddr))
        }
      }
    }
    ; Freestanding WASM [string] array: the array owns a dup'd private copy of
    ; each element (like a string field), freed via str_release on array release.
    ; The source value keeps its own lifetime (arena temp / owned local).
    if (this.wasmStrEnabled(lctx)) {
      if (LowIRUtil.isStringType((this.arrayElemTypeName(arrNode lctx)))) {
        def dupStr (this.emitStrdupExpr(itemAddr lctx))
        def sArgs:[string]
        def sArgTypes:[string]
        push sArgs desc
        push sArgTypes lctx.ptrType
        push sArgs dupStr
        push sArgTypes lctx.ptrType
        this.usedPtrArrayRuntime = true
        lctx.builder.emitCall("RtPtrArray_push" "void" sArgs sArgTypes)
        return
      }
    }
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args itemAddr
    push argTypes lctx.ptrType
    def voidType:string "void"
    ; An array whose ELEMENT TYPE is a class owns its elements: release frees
    ; each one. Ownership therefore has to be decided by the ARRAY, not by the
    ; shape of the pushed expression -- `push arr (itemAt other i)` took the
    ; plain path and stored an element the array had never retained, so freeing
    ; the array over-released it.
    def elemIsObject:boolean (this.isObjectTypeName((this.arrayElemTypeName(arrNode lctx))))
    if ((this.exprIsObjectPtr(itemNode lctx)) || elemIsObject) {
      if ((this.memEnabled(lctx)) || (this.wasmCollectionRcEnabled(lctx))) {
        ; On the native path the array RETAINS what it is given, so nothing is
        ; moved and no local is escaped. Escaping is per-NAME while ownership is
        ; per-VALUE: a local pushed once and then reassigned kept the escape for
        ; the rest of the function, which silently disabled the release of every
        ; later value it held. That is what leaked one reference per property
        ; assignment -- `result` in assignMember is pushed early and reassigned
        ; on the plain-property path further down.
        def isMove:boolean false
        if ((this.memEnabled(lctx)) == false) {
          if (itemNode.value_type == RangerNodeType.VRef) {
            if (this.isOwnedObjectLocal(itemNode.vref lctx)) {
              isMove = true
            }
          }
        }
        ; A freshly-constructed `new T()` pushed directly has rc=1 and no other
        ; owner, so it is moved (the array owns that single reference and frees it
        ; on release) rather than retained — retaining would leave rc=1 after the
        ; array releases, leaking it. WASM only, to keep the libc path unchanged.
        def freshNew:boolean false
        if itemNode.hasNewOper {
          if (this.wasmCollectionRcEnabled(lctx)) {
            freshNew = true
          }
        }
        if (isMove || freshNew) {
          if (itemNode.value_type == RangerNodeType.VRef) {
            set lctx.escapedLocals itemNode.vref "1"
          }
          this.usedPtrArrayRuntime = true
          lctx.builder.emitCall("RtPtrArray_push" voidType args argTypes)
          return
        }
        if (this.memEnabled(lctx)) {
          this.usedMemRuntime = true
          this.ensureMemExtern((LowIRTarget.resolve((unwrap lctx.ctx))))
        }
        lctx.builder.emitCall("ranger_ptrarray_push_owned" voidType args argTypes)
        return
      }
    }
    this.usedPtrArrayRuntime = true
    lctx.builder.emitCall("RtPtrArray_push" voidType args argTypes)
  }

  ; `for map item:T key { }` and `for map key { }` over a string-keyed map.
  ; The map runtime keeps its entries in insertion order and answers the i-th
  ; live key, so the loop is an index walk over RtSMap_keyAt -- the same shape
  ; `keys` uses. Answers false when the loop source is not a string map, and
  ; the array lowering below then runs unchanged.
  fn lowerForMap:boolean (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def cnt (array_length node.children)
    if (cnt < 4) {
      return false
    }
    def hashNode (node.getSecond())
    if (hashNode.value_type != RangerNodeType.VRef) {
      return false
    }
    def desc (this.smapDescFromVref(hashNode.vref lctx))
    if ((strlen desc) == 0) {
      return false
    }
    ; 5 children -> `for m item:T key {}`, 4 -> `for m key {}`
    def hasItem:boolean (cnt > 4)
    def itemNode (node.getThird())
    def keyNode:CodeNode itemNode
    def bodyNode (itemAt node.children 3)
    if hasItem {
      keyNode = (itemAt node.children 3)
      bodyNode = (itemAt node.children 4)
    }
    def keyName:string keyNode.vref
    def nRest:[string]
    def nTypes:[string]
    def n (this.emitSMapCall("RtSMap_size" "i32" desc nRest nTypes lctx))
    def iSlot (builder.emitAlloca("i32" (builder.freshTemp("formapi"))))
    def zero (builder.emitConst("i32" "0"))
    builder.emitStore("i32" zero iSlot)
    def condL (builder.freshLabel("formap_cond"))
    def bodyL (builder.freshLabel("formap_body"))
    def incL (builder.freshLabel("formap_inc"))
    def exitL (builder.freshLabel("formap_exit"))
    builder.terminateBr(condL)

    builder.startBlock(condL)
    def iNow (builder.emitLoad("i32" iSlot))
    def more (builder.emitIcmp("slt" iNow n))
    builder.terminateBrIf(more bodyL exitL)

    builder.startBlock(bodyL)
    def iCur (builder.emitLoad("i32" iSlot))
    def kRest:[string]
    def kTypes:[string]
    push kRest iCur
    push kTypes "i32"
    def keyPtr (this.emitSMapCall("RtSMap_keyAt" "i8*" desc kRest kTypes lctx))
    ; The key is the MAP's own buffer, borrowed for the body. It is not
    ; registered as an owned string local: releasing it would free the map's key.
    ; Both names SHADOW anything outside the loop, for the same reason the
    ; array loop shadows its index.
    push lctx.shadowStack keyName
    def prevKeySlot:string (this.shadowBind(keyName "i8*" keyPtr lctx))
    def prevItemSlotM:string ""
    def itemNameM:string ""
    if hasItem {
      def vRest:[string]
      def vTypes:[string]
      push vRest keyPtr
      push vTypes "i8*"
      def rawVal (this.emitSMapCall("RtSMap_get" "i64" desc vRest vTypes lctx))
      def vKind (this.smapValueKind(hashNode.vref lctx))
      def itemName:string itemNode.vref
      itemNameM = itemName
      push lctx.shadowStack itemName
      if (vKind == "int") {
        prevItemSlotM = (this.shadowBind(itemName "i32" (builder.emitCast("trunc" "i32" "i64" rawVal)) lctx))
      } {
        if (vKind == "string") {
          prevItemSlotM = (this.shadowBind(itemName "i8*" (builder.emitIntToI8Ptr(rawVal lctx.ptrType)) lctx))
        } {
          prevItemSlotM = (this.shadowBind(itemName lctx.ptrType rawVal lctx))
          def itemClass (this.resolveItemClass(itemNode))
          if ((strlen itemClass) > 0) {
            set lctx.objectSlots itemName itemClass
          }
        }
      }
    }
    def savedBreak:string lctx.breakLabel
    def savedCont:string lctx.continueLabel
    def savedMark:int lctx.loopOwnedMark
    def savedMarkColl:int lctx.loopOwnedCollMark
    def savedMarkStr:int lctx.loopOwnedStrMark
    lctx.breakLabel = exitL
    lctx.continueLabel = incL
    lctx.loopOwnedMark = (array_length lctx.ownedObjectLocals)
    lctx.loopOwnedCollMark = (array_length lctx.ownedCollectionLocals)
    lctx.loopOwnedStrMark = (array_length lctx.ownedStringLocals)
    this.lowerBlock(bodyNode lctx)
    lctx.breakLabel = savedBreak
    lctx.continueLabel = savedCont
    lctx.loopOwnedMark = savedMark
    lctx.loopOwnedCollMark = savedMarkColl
    lctx.loopOwnedStrMark = savedMarkStr
    def bodyBb (unwrap builder.currentBlock)
    if (bodyBb.termKind == "") {
      builder.terminateBr(incL)
    }

    builder.startBlock(incL)
    def iAt (builder.emitLoad("i32" iSlot))
    def one (builder.emitConst("i32" "1"))
    builder.emitStore("i32" (builder.emitBin("add" "i32" iAt one)) iSlot)
    builder.terminateBr(condL)

    builder.startBlock(exitL)
    if hasItem {
      this.restoreShadow(itemNameM prevItemSlotM lctx)
      removeLast lctx.shadowStack
    }
    this.restoreShadow(keyName prevKeySlot lctx)
    removeLast lctx.shadowStack
    return true
  }

  fn lowerFor:void (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    if (this.lowerForMap(node lctx)) {
      return
    }
    if ((array_length node.children) <= 4) {
      return
    }
    def listNode (node.getSecond())
    def itemNode (node.getThird())
    def bodyNode (itemAt node.children 4)
    def idxNode (itemAt node.children 3)
    def idxName (this.forIndexName(idxNode))
    def desc (this.loadArrayDescExpr(listNode lctx))
    this.usedPtrArrayRuntime = true
    def lenArgs:[string]
    def lenTypes:[string]
    push lenArgs desc
    push lenTypes lctx.ptrType
    def zero (builder.emitConst("i32" "0"))
    ; The loop's own index and item SHADOW anything of the same name outside
    ; it: nested `for … i` is ordinary Ranger, and sharing one slot let the
    ; inner loop reset the outer counter.
    push lctx.shadowStack idxName
    def prevIdxSlot:string (this.shadowBind(idxName "i32" zero lctx))
    def condLabel (builder.freshLabel("for_cond"))
    def bodyLabel (builder.freshLabel("for_body"))
    def exitLabel (builder.freshLabel("for_exit"))
    def incLabel (builder.freshLabel("for_inc"))
    builder.terminateBr(condLabel)
    builder.startBlock(condLabel)
    ; The length is read HERE, once per iteration, not once before the loop.
    ; JavaScript's `i < arr.length` and C++'s `i < v.size()` are both
    ; re-evaluated, so a body that grows or shrinks the array it is walking --
    ; which expandShapesInScope does, inserting the classes a shape desugars to
    ; into the very list it is iterating -- sees the new elements on every
    ; target except this one, where the loop stopped at the old count.
    def len (builder.emitCall("RtPtrArray_len" "i32" lenArgs lenTypes))
    def idxVal (this.loadSlot(idxName "i32" lctx))
    def cond (builder.emitIcmp("slt" idxVal len))
    builder.terminateBrIf(cond bodyLabel exitLabel)
    builder.startBlock(bodyLabel)
    def elemArgs:[string]
    def elemTypes:[string]
    push elemArgs desc
    push elemTypes lctx.ptrType
    push elemArgs idxVal
    push elemTypes "i32"
    def elemAddr (builder.emitCall("RtPtrArray_get" lctx.ptrType elemArgs elemTypes))
    def itemName:string itemNode.vref
    def itemClass (this.resolveItemClass(itemNode))
    ; A STRING element is a pointer to everything that consumes it -- strdup,
    ; sprintf, strcmp, the map runtime. Binding it into a pointer-sized INTEGER
    ; slot made the declared type (string) and the slot type (i64) disagree, and
    ; every consumer then received an i64 where it wanted i8*.
    def itemIsString:boolean (LowIRUtil.isStringType(itemNode.type_name))
    push lctx.shadowStack itemName
    def prevItemSlot:string ""
    if itemIsString {
      def elemStr (builder.emitIntToI8Ptr(elemAddr lctx.ptrType))
      prevItemSlot = (this.shadowBind(itemName "i8*" elemStr lctx))
    } {
      ; A `[int]` / `[boolean]` / `[double]` element is stored widened in the
      ; array's pointer-sized slot. Binding the raw i64 gave the loop variable
      ; the wrong type: `for bytes b:int i { this.hexByte(b) }` passed an i64
      ; to a parameter declared i32.
      def elemTn:string (this.arrayElemTypeName(listNode lctx))
      if ((strlen elemTn) == 0) {
        elemTn = itemNode.type_name
      }
      if (elemTn == "int") {
        prevItemSlot = (this.shadowBind(itemName "i32" (builder.emitCast("trunc" "i32" "i64" elemAddr)) lctx))
      } {
        if (elemTn == "char") {
          prevItemSlot = (this.shadowBind(itemName "i32" (builder.emitCast("trunc" "i32" "i64" elemAddr)) lctx))
        } {
          if (elemTn == "boolean") {
            prevItemSlot = (this.shadowBind(itemName "i1" (this.toI1((builder.emitCast("trunc" "i32" "i64" elemAddr)) lctx)) lctx))
          } {
            if ((elemTn == "double") || (elemTn == "float")) {
              prevItemSlot = (this.shadowBind(itemName "f64" (builder.emitCast("bitcast" "f64" "i64" elemAddr)) lctx))
            } {
              prevItemSlot = (this.shadowBind(itemName lctx.ptrType elemAddr lctx))
            }
          }
        }
      }
    }
    ; Not for a string item: objectSlots forces loadSlot to the POINTER type,
    ; which would read the i8* slot back as an integer.
    if (itemIsString == false) {
      if ((strlen itemClass) > 0) {
        set lctx.objectSlots itemName itemClass
      }
    }
    def savedBreakF:string lctx.breakLabel
    def savedContF:string lctx.continueLabel
    def savedMarkF:int lctx.loopOwnedMark
    def savedMarkCollF:int lctx.loopOwnedCollMark
    lctx.breakLabel = exitLabel
    ; `continue` in a for-loop runs the INCREMENT, or the loop never advances.
    lctx.continueLabel = incLabel
    ; This for-loop lowering does not itself scope-release body locals, so a
    ; jump out of it has nothing extra to drop.
    lctx.loopOwnedMark = (array_length lctx.ownedObjectLocals)
    lctx.loopOwnedCollMark = (array_length lctx.ownedCollectionLocals)
    ; Strings need the same mark. Left at an enclosing loop's value, a `break`
    ; inside this for-loop would release -- and NULL -- string locals belonging
    ; to the loop around it, which then reads NULL for the rest of its body.
    def savedMarkStrF:int lctx.loopOwnedStrMark
    lctx.loopOwnedStrMark = (array_length lctx.ownedStringLocals)
    this.lowerBlock(bodyNode lctx)
    lctx.breakLabel = savedBreakF
    lctx.continueLabel = savedContF
    lctx.loopOwnedMark = savedMarkF
    lctx.loopOwnedCollMark = savedMarkCollF
    lctx.loopOwnedStrMark = savedMarkStrF
    def bodyBb (unwrap builder.currentBlock)
    if (bodyBb.termKind == "") {
      builder.terminateBr(incLabel)
    }
    builder.startBlock(incLabel)
    def idxEnd (this.loadSlot(idxName "i32" lctx))
    def one (builder.emitConst("i32" "1"))
    def idxNext (builder.emitBin("add" "i32" idxEnd one))
    def idxSlot (unwrap (get lctx.slots idxName))
    builder.emitStore("i32" idxNext idxSlot)
    builder.terminateBr(condLabel)
    builder.startBlock(exitLabel)
    ; the loop's names go out of scope here
    this.restoreShadow(itemName prevItemSlot lctx)
    this.restoreShadow(idxName prevIdxSlot lctx)
    removeLast lctx.shadowStack
    removeLast lctx.shadowStack
  }

  fn emitStrcmpEq:string (lhs:string rhs:string ctx:LowIRLowerContext) {
    def args:[string]
    def argTypes:[string]
    push args lhs
    push argTypes "i8*"
    push args rhs
    push argTypes "i8*"
    def cmp (ctx.builder.emitCall("strcmp" "i32" args argTypes))
    def zero (ctx.builder.emitConst("i32" "0"))
    return (ctx.builder.emitIcmp("eq" cmp zero))
  }

  ; strfromcode/rawbytechar: turn an integer code into a freshly allocated
  ; string. The runtime returns a heap pointer (UTF-8 for strfromcode, a single
  ; raw byte for rawbytechar).
  ; to_string(value): format an integer (or double) into a fresh heap string.
  ; The receiver CLASS of a `(property obj field)` node ("" when unknown).
  fn propertyReadClass:string (node:CodeNode lctx:LowIRLowerContext) {
    if ((this.isPropertyReadNode(node)) == false) {
      return ""
    }
    def objNode (node.getSecond())
    if ((strlen objNode.eval_type_name) > 0) {
      return objNode.eval_type_name
    }
    if (objNode.value_type == RangerNodeType.VRef) {
      return (this.resolveObjectClass(objNode.vref lctx))
    }
    return ""
  }

  fn isPropertyReadNode:boolean (node:CodeNode) {
    if ((array_length node.children) != 3) {
      return false
    }
    def head (node.getFirst())
    if (head.value_type != RangerNodeType.VRef) {
      return false
    }
    return (head.vref == "property")
  }

  ; (property obj fieldName): read `fieldName` off the object produced by the
  ; `obj` expression. The receiver may be any expression (a call, an itemAt),
  ; so it is lowered to a value and reinterpreted as the struct pointer.
  fn lowerPropertyRead:string (node:CodeNode lctx:LowIRLowerContext) {
    def objNode (node.getSecond())
    def propNode (node.getThird())
    def fieldName:string propNode.vref
    def cls:string objNode.eval_type_name
    if ((strlen cls) == 0) {
      if (objNode.value_type == RangerNodeType.VRef) {
        cls = (this.resolveObjectClass(objNode.vref lctx))
      }
    }
    if ((strlen cls) == 0) {
      return (lctx.builder.emitConst("i32" "0"))
    }
    def objVal (this.lowerExpr(objNode lctx))
    def objPtr (lctx.builder.emitIntToStructPtr(cls objVal))
    return (this.emitFieldLoadOn(cls objPtr fieldName lctx))
  }

  fn isLibmUnaryOp:boolean (op:string) {
    if (op == "tan") { return true }
    if (op == "sin") { return true }
    if (op == "cos") { return true }
    if (op == "asin") { return true }
    if (op == "acos") { return true }
    if (op == "atan") { return true }
    if (op == "sqrt") { return true }
    if (op == "log") { return true }
    if (op == "exp") { return true }
    return false
  }

  fn isLibmBinaryOp:boolean (op:string) {
    if (op == "atan2") { return true }
    if (op == "pow") { return true }
    return false
  }

  fn lowerLibmUnary:string (fnName:string node:CodeNode lctx:LowIRLowerContext) {
    def aNode (node.getSecond())
    def av (this.promoteToF64(aNode (this.lowerExpr(aNode lctx)) lctx))
    def decl:[string]
    push decl "double"
    this.ensureExternDecl(fnName "double" decl false)
    def cArgs:[string]
    def cTypes:[string]
    push cArgs av
    push cTypes "f64"
    return (lctx.builder.emitCall(fnName "f64" cArgs cTypes))
  }

  fn lowerLibmBinary:string (fnName:string node:CodeNode lctx:LowIRLowerContext) {
    def aNode (node.getSecond())
    def bNode (node.getThird())
    def av (this.promoteToF64(aNode (this.lowerExpr(aNode lctx)) lctx))
    def bv (this.promoteToF64(bNode (this.lowerExpr(bNode lctx)) lctx))
    def decl:[string]
    push decl "double"
    push decl "double"
    this.ensureExternDecl(fnName "double" decl false)
    def cArgs:[string]
    def cTypes:[string]
    push cArgs av
    push cTypes "f64"
    push cArgs bv
    push cTypes "f64"
    return (lctx.builder.emitCall(fnName "f64" cArgs cTypes))
  }

  fn lowerToString:string (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def valNode (node.getSecond())
    def isF64 (this.exprIsF64(valNode))
    def val (this.lowerExpr(valNode lctx))
    ; A BOOLEAN answers "true"/"false", the way every other target spells it --
    ; not the 1/0 that "%d" writes. `to_string (a == b)` came out as `1`.
    if (isF64 == false) {
      if (this.exprProducesI1(valNode lctx)) {
        if ((this.wasmStrEnabled(lctx)) == false) {
          def tG (this.internStringGlobal("true" false))
          def fG (this.internStringGlobal("false" false))
          lctx.shadowCounter = (lctx.shadowCounter + 1)
          def bslot:string ("%bstr" + ("" + lctx.shadowCounter))
          builder.emitAlloca("i8*" bslot)
          def tL (builder.freshLabel("bs_true"))
          def fL (builder.freshLabel("bs_false"))
          def eL (builder.freshLabel("bs_end"))
          builder.terminateBrIf(val tL fL)
          builder.startBlock(tL)
          builder.emitStore("i8*" (builder.emitStrPtr(tG (this.stringGlobalByteLen(tG)))) bslot)
          builder.terminateBr(eL)
          builder.startBlock(fL)
          builder.emitStore("i8*" (builder.emitStrPtr(fG (this.stringGlobalByteLen(fG)))) bslot)
          builder.terminateBr(eL)
          builder.startBlock(eL)
          return (builder.emitLoad("i8*" bslot))
        }
      }
    }
    ; A boolean operand arrives as i1; sprintf's "%d" takes an i32. Widen it
    ; here so `to_string (v.isFunction())` does not pass an i1 in an i32 slot.
    if (isF64 == false) {
      if (this.exprProducesI1(valNode lctx)) {
        val = (builder.emitZextI1ToI32(val))
      }
    }
    ; freestanding WASM: ranger_str_from_int (f64 truncated to i32 for now).
    if (this.wasmStrEnabled(lctx)) {
      def iv val
      if isF64 {
        iv = (builder.emitCast("fptosi" "i32" "f64" val))
      }
      def sargs:[string]
      def sargTypes:[string]
      push sargs iv
      push sargTypes "i32"
      def sres (builder.emitCall("ranger_str_from_int" "i8*" sargs sargTypes))
      this.registerFreshStringTemp(sres lctx)
      return sres
    }
    ; A double formats by JavaScript's rules, not "%g" -- see
    ; ranger_double_to_string. sprintf stays for the integer case.
    if isF64 {
      def dstr (this.emitDoubleToString(val lctx))
      this.registerFreshStringTemp(dstr lctx)
      return dstr
    }
    def sz (builder.emitConst("i32" "64"))
    def raw (builder.emitHeapAlloc(sz))
    def buf (builder.emitIntToI8Ptr(raw lctx.ptrType))
    def fmtLit:string "%d"
    def valType:string "i32"
    def fmtG (this.internStringGlobal(fmtLit false))
    def args:[string]
    def argTypes:[string]
    push args buf
    push argTypes "i8*"
    push args (builder.emitStrPtr(fmtG (this.stringGlobalByteLen(fmtG))))
    push argTypes "i8*"
    push args val
    push argTypes valType
    builder.emitCall("sprintf" "i32" args argTypes)
    def memTarget (LowIRTarget.resolve((unwrap lctx.ctx)))
    if (memTarget.usesLibc) {
      def dup (this.emitStrdupExpr(buf lctx))
      def freeArgs:[string]
      def freeArgTypes:[string]
      push freeArgs buf
      push freeArgTypes "i8*"
      builder.emitCall("free" "void" freeArgs freeArgTypes)
      return dup
    }
    return buf
  }

  fn lowerStrFromCode:string (node:CodeNode fnName:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def codeNode (node.getSecond())
    def code (this.lowerExpr(codeNode lctx))
    def args:[string]
    def argTypes:[string]
    push args code
    push argTypes "i32"
    def codeRes (builder.emitCall(fnName "i8*" args argTypes))
    this.registerFreshStringTemp(codeRes lctx)
    return codeRes
  }

  ; strlen of an ALREADY-CHOSEN operand node (lowerStrlen takes the operator
  ; node and reads its second child).
  fn lowerStrlenOn:string (textNode:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def strPtr (this.lowerExpr(textNode lctx))
    def args:[string]
    def argTypes:[string]
    push args strPtr
    push argTypes "i8*"
    def lenFn:string "strlen"
    if (this.wasmStrEnabled(lctx)) {
      lenFn = "ranger_str_len"
    }
    return (builder.emitCall(lenFn "i32" args argTypes))
  }

  ; Peel `(unwrap x)` wrappers off an expression.
  fn unwrapUnwrapOper:CodeNode (node:CodeNode) {
    def n (this.unwrapCondExpr(node))
    if n.has_operator {
      if ((n.getOperator()) == "unwrap") {
        return (this.unwrapUnwrapOper((n.getSecond())))
      }
    }
    return n
  }

  fn lowerStrlen:string (node:CodeNode lctx:LowIRLowerContext) {
    def irI32:string "i32"
    def textNode (node.getSecond())
    def text (this.printTextFromNode(textNode))
    def builder (lctx.builder)
    if ((strlen text) > 0) {
      def len (strlen text)
      return (builder.emitConst(irI32 ("" + len)))
    }
    def strPtr (this.lowerExpr(textNode lctx))
    def args:[string]
    def argTypes:[string]
    push args strPtr
    push argTypes "i8*"
    def lenFn:string "strlen"
    if (this.wasmStrEnabled(lctx)) {
      lenFn = "ranger_str_len"
    }
    return (builder.emitCall(lenFn "i32" args argTypes))
  }

  fn isIntArrayTypeNode:boolean (node:CodeNode) {
    if (node.value_type == RangerNodeType.Array) {
      return (node.array_type == "int")
    }
    return false
  }

  ; An `[int:T]` map whose values are NOT ints: object or string references,
  ; which are pointer sized. The generated RtMap_* runtime stores 4-byte slots
  ; and cannot hold one, and a reference in a map has to be retained or the map
  ; outlives what it points at -- so these route to RtIMap_* in
  ; runtime/ranger_rt.c, the integer-keyed twin of the string-map runtime.
  fn isIntKeyValueMapTypeNode:boolean (node:CodeNode) {
    if (node.value_type == RangerNodeType.Hash) {
      if (node.key_type == "int") {
        if ((strlen node.array_type) == 0) {
          return false
        }
        return (node.array_type != "int")
      }
    }
    return false
  }

  fn ensureIMapExterns:void () {
    def pKV:[string]
    push pKV "i64"
    push pKV "i64"
    push pKV "i64"
    def pK:[string]
    push pK "i64"
    push pK "i64"
    def pM:[string]
    push pM "i64"
    def pKind:[string]
    push pKind "i32"
    def none:[string]
    this.ensureExternDecl("RtIMap_new" "i64" none false)
    this.ensureExternDecl("RtIMap_new_kind" "i64" pKind false)
    this.ensureExternDecl("RtIMap_set" "void" pKV false)
    this.ensureExternDecl("RtIMap_get" "i64" pK false)
    this.ensureExternDecl("RtIMap_has" "i32" pK false)
    this.ensureExternDecl("RtIMap_remove" "void" pK false)
    this.ensureExternDecl("RtIMap_size" "i32" pM false)
    this.ensureExternDecl("RtIMap_free" "void" pM false)
    this.ensureExternDecl("RtIMap_retain" "void" pM false)
  }

  ; An int key arrives as i32 (or i1 for a boolean-typed expression); RtIMap
  ; takes i64, so widen rather than letting the call type-mismatch.
  fn widenToI64:string (val:string keyNode:CodeNode lctx:LowIRLowerContext) {
    if (this.exprProducesI1(keyNode lctx)) {
      return (lctx.builder.emitCast("zext" "i64" "i1" val))
    }
    return (lctx.builder.emitCast("zext" "i64" "i32" val))
  }

  fn emitIMapCall:string (fnName:string retType:string desc:string rest:[string] restTypes:[string] lctx:LowIRLowerContext) {
    this.ensureIMapExterns()
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes "i64"
    def i:int 0
    while (i < (array_length rest)) {
      push args (itemAt rest i)
      push argTypes (itemAt restTypes i)
      i = (i + 1)
    }
    return (lctx.builder.emitCall(fnName retType args argTypes))
  }

  ; The map descriptor for a name bound to an int-keyed reference map, or "".
  fn imapDescFromVref:string (vref:string lctx:LowIRLowerContext) {
    if ((this.collectionKind(vref lctx)) == "imap") {
      return (this.loadCollectionDesc(vref lctx))
    }
    if ((indexOf vref ".") >= 0) {
      def parts:[string] (strsplit vref ".")
      if ((array_length parts) >= 2) {
        def recv (itemAt parts 0)
        def fld (itemAt parts 1)
        def cls (this.resolveObjectClass(recv lctx))
        if ((strlen cls) > 0) {
          if (this.fieldIsIntMapSlot(cls fld)) {
            return (this.emitFieldLoadOn(cls (this.resolveObjectPtrChain(recv cls lctx)) fld lctx))
          }
        }
      }
      return ""
    }
    if ((strlen lctx.className) > 0) {
      if (this.fieldIsIntMapSlot(lctx.className vref)) {
        return (this.emitFieldLoad(vref lctx))
      }
    }
    return ""
  }

  fn imapValueKind:string (vref:string lctx:LowIRLowerContext) {
    if (has lctx.imapValueTypes vref) {
      def t:string (unwrap (get lctx.imapValueTypes vref))
      if (LowIRUtil.isStringType(t)) {
        return "string"
      }
      if (LowIRUtil.isSupportedPrimitive(t)) {
        return "int"
      }
      return "object"
    }
    return "object"
  }

  ; 0 plain / 1 owned object / 2 owned string, matching RtIMap's valkind.
  fn imapValueOwnKind:int (typeName:string) {
    if (LowIRUtil.isStringType(typeName)) {
      return 2
    }
    if (LowIRUtil.isSupportedPrimitive(typeName)) {
      return 0
    }
    return 1
  }

  fn isIntIntMapTypeNode:boolean (node:CodeNode) {
    if (node.value_type == RangerNodeType.Hash) {
      if (node.key_type == "int") {
        return (node.array_type == "int")
      }
    }
    return false
  }

  ; A `[string:T]` map. The generated RtMap_* runtime hashes an i32 key with
  ; `key % cap` and stores 4-byte slots, so it cannot hold one: the key has to
  ; be hashed by CONTENT and both key and value are pointer-sized. These route
  ; to the RtSMap_* functions in runtime/ranger_rt.c instead, which also keep
  ; INSERTION order -- JavaScript enumerates string keys that way and the
  ; TypeScript engine's object model depends on it.
  ; Extern declarations for the string-map runtime (runtime/ranger_rt.c).
  fn ensureSMapExterns:void () {
    def pOnly:[string]
    push pOnly "i64"
    def pStr:[string]
    push pStr "i64"
    push pStr "i8*"
    def pStrVal:[string]
    push pStrVal "i64"
    push pStrVal "i8*"
    push pStrVal "i64"
    def pIdx:[string]
    push pIdx "i64"
    push pIdx "i32"
    def none:[string]
    def pKind:[string]
    push pKind "i32"
    this.ensureExternDecl("RtSMap_new" "i64" none false)
    this.ensureExternDecl("RtSMap_new_kind" "i64" pKind false)
    this.ensureExternDecl("RtSMap_put" "void" pStrVal false)
    this.ensureExternDecl("RtSMap_get" "i64" pStr false)
    this.ensureExternDecl("RtSMap_has" "i32" pStr false)
    this.ensureExternDecl("RtSMap_remove" "void" pStr false)
    this.ensureExternDecl("RtSMap_size" "i32" pOnly false)
    this.ensureExternDecl("RtSMap_keyAt" "i8*" pIdx false)
    this.ensureExternDecl("RtSMap_free" "void" pOnly false)
  }

  fn emitSMapNew:string (lctx:LowIRLowerContext) {
    return (this.emitSMapNewKind(0 lctx))
  }

  ; valKind: 0 plain / 1 owned object / 2 owned string. A map that OWNS its
  ; values retains on put and releases on overwrite, remove and free -- without
  ; it an object stored in a map died with the local that produced it.
  fn emitSMapNewKind:string (valKind:int lctx:LowIRLowerContext) {
    this.ensureSMapExterns()
    def kindArgs:[string]
    def kindTypes:[string]
    push kindArgs (lctx.builder.emitConst("i32" ("" + valKind)))
    push kindTypes "i32"
    return (lctx.builder.emitCall("RtSMap_new_kind" "i64" kindArgs kindTypes))
  }

  ; The ownership kind implied by a map's declared VALUE type.
  fn smapValueOwnKind:int (valueTypeName:string) {
    ; Objects are refcounted, so owning one is always safe.
    if (this.isObjectTypeName(valueTypeName)) {
      return 1
    }
    ; A STRING value is owned too (kind 2): the runtime copies it on put and
    ; frees the copy on overwrite or removal. Storing the caller's pointer
    ; instead -- what this used to do -- left the map holding memory the
    ; caller freed at the end of the statement, which is how `-o=hello2.js`
    ; came back out of the compiler's own parameter map as another string.
    if (LowIRUtil.isStringType(valueTypeName)) {
      return 2
    }
    ; An ARRAY value is owned too (kind 3). A `[string:[string]]` used to be
    ; kind 0: the map stored the descriptor without a retain while the local it
    ; was built in was released at scope end, so the map was left pointing at a
    ; freed array -- reading one back handed RtPtrArray_get whatever had reused
    ; that memory.
    if (LowIRUtil.isArrayTypeName(valueTypeName)) {
      return 3
    }
    return 0
  }

  fn emitSMapCall:string (fnName:string retType:string descIn:string rest:[string] restTypes:[string] lctx:LowIRLowerContext) {
    this.ensureSMapExterns()
    ; A descriptor the resolution could not work out used to be emitted as an
    ; empty operand -- `call i32 @RtSMap_size(i64 )`, which does not parse.
    def desc:string descIn
    if ((strlen desc) == 0) {
      desc = (lctx.builder.emitConst("i64" "0"))
    }
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes "i64"
    def i:int 0
    while (i < (array_length rest)) {
      push args (itemAt rest i)
      push argTypes (itemAt restTypes i)
      i = (i + 1)
    }
    return (lctx.builder.emitCall(fnName retType args argTypes))
  }

  ; `(keys m)` on a string map: a fresh pointer-array of the keys, in insertion
  ; order. Built here rather than in C so the array is an ordinary RtPtrArray
  ; the rest of the backend already understands -- the C side only answers how
  ; many keys there are and what the i-th one is.
  fn lowerSMapKeys:string (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def collNode (node.getSecond())
    def desc (this.smapDescFromVref(collNode.vref lctx))
    def outArr (this.emitPtrArrayNewEmpty(lctx 2))
    def nRest:[string]
    def nTypes:[string]
    def n (this.emitSMapCall("RtSMap_size" "i32" desc nRest nTypes lctx))

    ; A UNIQUE slot name: two `keys` calls in one function shared a fixed name
    ; and defined the same SSA value twice, the way %heap_next used to.
    def iSlot (builder.emitAlloca("i32" (builder.freshTemp("smapki"))))
    def zero (builder.emitConst("i32" "0"))
    builder.emitStore("i32" zero iSlot)
    def condL (builder.freshLabel("smap_keys_cond"))
    def bodyL (builder.freshLabel("smap_keys_body"))
    def doneL (builder.freshLabel("smap_keys_done"))
    builder.terminateBr(condL)

    builder.startBlock(condL)
    def iNow (builder.emitLoad("i32" iSlot))
    def more (builder.emitIcmp("slt" iNow n))
    builder.terminateBrIf(more bodyL doneL)

    builder.startBlock(bodyL)
    def iCur (builder.emitLoad("i32" iSlot))
    def kRest:[string]
    def kTypes:[string]
    push kRest iCur
    push kTypes "i32"
    def keyPtr (this.emitSMapCall("RtSMap_keyAt" "i8*" desc kRest kTypes lctx))
    ; RtSMap_keyAt hands back the MAP's own key buffer. The result array owns
    ; its elements (kind 2) and frees them on release, so it takes a private
    ; copy -- otherwise releasing the key list freed the map's keys under it.
    def keyOwned:string keyPtr
    if (this.memEnabled(lctx)) {
      keyOwned = (this.emitStrdupExpr(keyPtr lctx))
    }
    ; The array stores pointer-sized integers, so the key pointer converts in --
    ; the same direction emitPtrArrayElemGet converts back out.
    def keyInt (builder.emitPtrToInt(keyOwned))
    def pArgs:[string]
    def pTypes:[string]
    push pArgs outArr
    push pTypes lctx.ptrType
    push pArgs keyInt
    push pTypes lctx.ptrType
    this.usedPtrArrayRuntime = true
    def voidT:string "void"
    builder.emitCall("RtPtrArray_push" voidT pArgs pTypes)
    def one (builder.emitConst("i32" "1"))
    def iNext (builder.emitBin("add" "i32" iCur one))
    builder.emitStore("i32" iNext iSlot)
    builder.terminateBr(condL)

    builder.startBlock(doneL)
    return outArr
  }

  ; ---------------------------------------------------------------------------
  ; JSON.
  ;
  ; A JSON value is an int64 handle into runtime/ranger_json.c. The @serialize
  ; machinery generates a toDictionary / fromDictionary pair for every
  ; serializable class, so these operators are not optional for a target that
  ; wants to compile the compiler -- they are most of what that generated code
  ; is made of.
  ; ---------------------------------------------------------------------------

  ; The JSON systemclass a node evaluates to, or "" when it is not JSON. A
  ; local's class is on objectSlots (recorded when the slot was bound); an
  ; expression carries it on eval_type_name / type_name.
  ; `EnumName.Member` -> the member's integer value, or "" when the node is not
  ; an enum reference. Enums are `Enum X:int ( A B C )`, so the value is just
  ; the position, and the writer context already holds the table.
  fn lowerEnumRef:string (node:CodeNode lctx:LowIRLowerContext) {
    if (node.eval_type != RangerNodeType.Enum) {
      return ""
    }
    if ((array_length node.ns) < 2) {
      return ""
    }
    if (null? lctx.ctx) {
      return ""
    }
    def ctx (unwrap lctx.ctx)
    def rootObjName:string (itemAt node.ns 0)
    def e@(optional):RangerAppEnum (ctx.getEnum(rootObjName))
    if (null? e) {
      return ""
    }
    def enumName:string (itemAt node.ns 1)
    def theEnum (unwrap e)
    if ((has theEnum.values enumName) == false) {
      return ""
    }
    def v:int (unwrap (get theEnum.values enumName))
    return (lctx.builder.emitConst("i32" ("" + v)))
  }

  fn jsonTypeNameOfNode:string (node:CodeNode lctx:LowIRLowerContext) {
    def tn:string ""
    if (node.value_type == RangerNodeType.VRef) {
      if (has lctx.objectSlots node.vref) {
        tn = (unwrap (get lctx.objectSlots node.vref))
      }
    }
    if ((strlen tn) == 0) {
      tn = node.eval_type_name
    }
    if ((strlen tn) == 0) {
      tn = node.type_name
    }
    if (LowIRUtil.isJsonTypeName(tn)) {
      return tn
    }
    ; `(json_object)` / `(getObject o k)` in operand position: the operator
    ; itself says what comes back, and an inline call has no declared type.
    if node.has_operator {
      def op (node.getOperator())
      ; `(unwrap v)` keeps the type of what is inside. The generated
      ; fromDictionary is written as `def o (unwrap values)`, so without this
      ; `keys o` went to the string-map runtime instead of the JSON one.
      if (op == "unwrap") {
        return (this.jsonTypeNameOfNode((node.getSecond()) lctx))
      }
      if (op == "json_object") { return "JSONDataObject" }
      if (op == "json_array") { return "JSONArrayObject" }
      if (op == "getObject") { return "JSONDataObject" }
      if (op == "getArray") { return "JSONArrayObject" }
      if (op == "getValue") { return "JSONValueUnion" }
      if (op == "asArray") { return "JSONArrayObject" }
      if (op == "from_string") { return "JSONDataObject" }
    }
    return ""
  }

  fn nodeIsJson:boolean (node:CodeNode lctx:LowIRLowerContext) {
    return ((strlen (this.jsonTypeNameOfNode(node lctx))) > 0)
  }

  ; Which RtJson_set_* / RtJson_push_* to call for a value expression:
  ; "json", "str", "bool", "double" or "int".
  fn jsonValueKind:string (valNode:CodeNode lctx:LowIRLowerContext) {
    if (this.nodeIsJson(valNode lctx)) {
      return "json"
    }
    if (this.exprIsStringish(valNode lctx)) {
      return "str"
    }
    def tn:string valNode.eval_type_name
    if ((strlen tn) == 0) {
      tn = valNode.type_name
    }
    if (tn == "boolean") { return "bool" }
    if (tn == "bool") { return "bool" }
    if (tn == "double") { return "double" }
    if (tn == "float") { return "double" }
    if (tn == "string") { return "str" }
    if (this.exprProducesI1(valNode lctx)) {
      return "bool"
    }
    return "int"
  }

  fn ensureJsonExtern:void (fnName:string retType:string params:[string]) {
    this.ensureExternDecl(fnName retType params false)
  }

  ; The ANSI escape operators of CLIProgress. Each is a constant string; they
  ; all carry a `*` template (the empty string), so they type checked here and
  ; then emitted their own name as a value. The escapes match the es6 and cpp
  ; templates rather than the empty fallback -- a native build writes to a
  ; terminal, and is_tty already guards the colour output.
  fn emitAnsiConst:string (code:string lctx:LowIRLowerContext) {
    def esc:string ((strfromcode 27) + "[" + code + "m")
    def g (this.internStringGlobal(esc false))
    def bl (this.stringGlobalByteLen(g))
    return (lctx.builder.emitStrPtr(g bl))
  }

  fn tryLowerAnsi:string (opName:string lctx:LowIRLowerContext) {
    if (opName == "ansi_reset") { return (this.emitAnsiConst("0" lctx)) }
    if (opName == "ansi_bold") { return (this.emitAnsiConst("1" lctx)) }
    if (opName == "ansi_dim") { return (this.emitAnsiConst("2" lctx)) }
    if (opName == "ansi_green") { return (this.emitAnsiConst("32" lctx)) }
    if (opName == "ansi_red") { return (this.emitAnsiConst("31" lctx)) }
    if (opName == "ansi_yellow") { return (this.emitAnsiConst("33" lctx)) }
    if (opName == "ansi_blue") { return (this.emitAnsiConst("34" lctx)) }
    if (opName == "ansi_magenta") { return (this.emitAnsiConst("35" lctx)) }
    if (opName == "ansi_cyan") { return (this.emitAnsiConst("36" lctx)) }
    if (opName == "ansi_gray") { return (this.emitAnsiConst("90" lctx)) }
    if (opName == "ansi_white") { return (this.emitAnsiConst("37" lctx)) }
    if (opName == "ansi_bg_red") { return (this.emitAnsiConst("41" lctx)) }
    if (opName == "ansi_bg_green") { return (this.emitAnsiConst("42" lctx)) }
    return ""
  }

  fn emitJsonCall:string (fnName:string retType:string args:[string] argTypes:[string] cParams:[string] lctx:LowIRLowerContext) {
    this.ensureJsonExtern(fnName retType cParams)
    return (lctx.builder.emitCall(fnName retType args argTypes))
  }

  ; `json_object` / `json_array` -> a fresh handle.
  fn lowerJsonNew:string (fnName:string lctx:LowIRLowerContext) {
    def ps:[string]
    def args:[string]
    def argTypes:[string]
    return (this.emitJsonCall(fnName "i64" args argTypes ps lctx))
  }

  ; The (object, key) getters. `retIr` is the IR type the C function answers.
  fn lowerJsonGet:string (node:CodeNode fnName:string retIr:string cRet:string lctx:LowIRLowerContext) {
    def objNode (node.getSecond())
    def keyNode (node.getThird())
    def obj (this.lowerExpr(objNode lctx))
    def key (this.lowerExpr(keyNode lctx))
    def ps:[string]
    push ps "i64"
    push ps "i8*"
    def args:[string]
    def argTypes:[string]
    push args obj
    push argTypes "i64"
    push args key
    push argTypes "i8*"
    return (this.emitJsonCall(fnName cRet args argTypes ps lctx))
  }

  ; `set obj key value` on a JSON object.
  fn lowerJsonSet:void (node:CodeNode lctx:LowIRLowerContext) {
    def objNode (node.getSecond())
    def keyNode (node.getThird())
    def valNode (itemAt node.children 3)
    def obj (this.lowerExpr(objNode lctx))
    def key (this.lowerExpr(keyNode lctx))
    def val (this.lowerExpr(valNode lctx))
    def kind (this.jsonValueKind(valNode lctx))
    def fnName:string "RtJson_set_int"
    def valIr:string "i64"
    if (kind == "str") {
      fnName = "RtJson_set_str"
      valIr = "i8*"
    }
    if (kind == "bool") {
      fnName = "RtJson_set_bool"
      valIr = "i32"
      val = (lctx.builder.emitCast("zext" "i32" "i1" val))
    }
    if (kind == "double") {
      fnName = "RtJson_set_double"
      valIr = "f64"
    }
    if (kind == "json") {
      fnName = "RtJson_set_value"
      valIr = "i64"
    }
    if (kind == "int") {
      val = (lctx.builder.emitCast("sext" "i64" "i32" val))
    }
    def ps:[string]
    push ps "i64"
    push ps "i8*"
    push ps valIr
    def args:[string]
    def argTypes:[string]
    push args obj
    push argTypes "i64"
    push args key
    push argTypes "i8*"
    push args val
    push argTypes valIr
    def voidT:string "void"
    this.emitJsonCall(fnName voidT args argTypes ps lctx)
  }

  ; `push arr value` on a JSON array.
  fn lowerJsonPush:void (node:CodeNode lctx:LowIRLowerContext) {
    def arrNode (node.getSecond())
    def valNode (node.getThird())
    def arr (this.lowerExpr(arrNode lctx))
    def val (this.lowerExpr(valNode lctx))
    def kind (this.jsonValueKind(valNode lctx))
    def fnName:string "RtJson_push_int"
    def valIr:string "i64"
    if (kind == "str") {
      fnName = "RtJson_push_str"
      valIr = "i8*"
    }
    if (kind == "bool") {
      fnName = "RtJson_push_bool"
      valIr = "i32"
      val = (lctx.builder.emitCast("zext" "i32" "i1" val))
    }
    if (kind == "double") {
      fnName = "RtJson_push_double"
      valIr = "f64"
    }
    if (kind == "json") {
      fnName = "RtJson_push_value"
      valIr = "i64"
    }
    if (kind == "int") {
      val = (lctx.builder.emitCast("sext" "i64" "i32" val))
    }
    def ps:[string]
    push ps "i64"
    push ps valIr
    def args:[string]
    def argTypes:[string]
    push args arr
    push argTypes "i64"
    push args val
    push argTypes valIr
    def voidT:string "void"
    this.emitJsonCall(fnName voidT args argTypes ps lctx)
  }

  ; One-handle helpers: keys / array_length / to_string / isArray / parse.
  fn lowerJson1:string (node:CodeNode fnName:string cRet:string lctx:LowIRLowerContext) {
    def vNode (node.getSecond())
    def v (this.lowerExpr(vNode lctx))
    def ps:[string]
    push ps "i64"
    def args:[string]
    def argTypes:[string]
    push args v
    push argTypes "i64"
    return (this.emitJsonCall(fnName cRet args argTypes ps lctx))
  }

  ; `getValue arr index`
  fn lowerJsonGetValue:string (node:CodeNode lctx:LowIRLowerContext) {
    def arrNode (node.getSecond())
    def idxNode (node.getThird())
    def arr (this.lowerExpr(arrNode lctx))
    def idx (this.lowerExpr(idxNode lctx))
    def ps:[string]
    push ps "i64"
    push ps "i32"
    def args:[string]
    def argTypes:[string]
    push args arr
    push argTypes "i64"
    push args idx
    push argTypes "i32"
    return (this.emitJsonCall("RtJson_get_value" "i64" args argTypes ps lctx))
  }

  ; `case value binding:T { }` where value is a JSON union. The runtime tags
  ; every node with its kind, so the narrowing is a kind test plus one read.
  ; Kind numbers mirror the RJ_* constants in runtime/ranger_json.c.
  fn jsonCaseKindFor:int (typeName:string) {
    if (typeName == "boolean") { return 1 }
    if (typeName == "bool") { return 1 }
    if (typeName == "int") { return 2 }
    if (typeName == "double") { return 3 }
    if (typeName == "float") { return 3 }
    if (typeName == "string") { return 4 }
    if (typeName == "JSONArrayObject") { return 5 }
    if (typeName == "JSONDataObject") { return 6 }
    return -1
  }

  fn lowerJsonCase:boolean (node:CodeNode lctx:LowIRLowerContext) {
    def cnt (array_length node.children)
    if (cnt < 4) {
      return false
    }
    def valNode (node.getSecond())
    def bindNode (node.getThird())
    def bodyNode (itemAt node.children 3)
    if ((this.nodeIsJson(valNode lctx)) == false) {
      return false
    }
    def wantKind (this.jsonCaseKindFor(bindNode.type_name))
    if (wantKind < 0) {
      return false
    }
    def builder (lctx.builder)
    def v (this.lowerExpr(valNode lctx))
    def kps:[string]
    push kps "i64"
    def kArgs:[string]
    def kTypes:[string]
    push kArgs v
    push kTypes "i64"
    def kind (this.emitJsonCall("RtJson_kind" "i32" kArgs kTypes kps lctx))
    def want (builder.emitConst("i32" (to_string wantKind)))
    def hit (builder.emitIcmp("eq" kind want))
    def bodyL (builder.freshLabel("json_case_body"))
    def doneL (builder.freshLabel("json_case_done"))
    builder.terminateBrIf(hit bodyL doneL)
    builder.startBlock(bodyL)
    def bindName:string bindNode.vref
    def ps1:[string]
    push ps1 "i64"
    def vArgs:[string]
    def vTypes:[string]
    push vArgs v
    push vTypes "i64"
    if (wantKind == 4) {
      def sv (this.emitJsonCall("RtJson_value_str" "i8*" vArgs vTypes ps1 lctx))
      this.bindSlot(bindName "i8*" sv lctx)
    } {
      if (wantKind == 2) {
        def iv (this.emitJsonCall("RtJson_value_int" "i64" vArgs vTypes ps1 lctx))
        this.bindSlot(bindName "i32" (builder.emitCast("trunc" "i32" "i64" iv)) lctx)
      } {
        if (wantKind == 3) {
          def dv (this.emitJsonCall("RtJson_value_double" "f64" vArgs vTypes ps1 lctx))
          this.bindSlot(bindName "f64" dv lctx)
        } {
          if (wantKind == 1) {
            def bv (this.emitJsonCall("RtJson_value_bool" "i32" vArgs vTypes ps1 lctx))
            this.bindSlot(bindName "i1" (this.toI1(bv lctx)) lctx)
          } {
            ; an object or an array: the handle itself, narrowed by the tag
            this.bindSlot(bindName "i64" v lctx)
            set lctx.objectSlots bindName bindNode.type_name
          }
        }
      }
    }
    this.lowerBlock(bodyNode lctx)
    def bodyBb (unwrap builder.currentBlock)
    if (bodyBb.termKind == "") {
      builder.terminateBr(doneL)
    }
    builder.startBlock(doneL)
    return true
  }

  ; `(sort arr cb)` -> a NEW array, leaving the argument alone, which is the
  ; operator's contract on every target. The comparator is an ordinary Ranger
  ; lambda, so it is called through the closure record the same way
  ; lowerLambdaCall does: the first word of the record is the function index.
  ;
  ; Insertion sort, emitted as IR rather than handed to a C helper: qsort would
  ; need a C-callable comparator, and the closure ABI (env pointer + indirect
  ; call through the signature table) only exists on this side.
  ;
  ; The result array does NOT own its elements (element kind 0): it holds the
  ; same pointers the source array does, and the source keeps owning them.
  fn lowerArraySort:string (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def arrNode (node.getSecond())
    def cbNode (node.getThird())
    def srcDesc (this.loadArrayDescExpr(arrNode lctx))
    def env (this.lowerExpr(cbNode lctx))
    def fnIdx (builder.emitPtrLoad(env))
    def sig:string ("i32," + lctx.ptrType + "," + lctx.ptrType + ":i32")
    this.addLambdaSig(sig)
    this.usedPtrArrayRuntime = true
    def out (this.emitPtrArrayNewEmpty(lctx 0))

    def lenArgs:[string]
    def lenTypes:[string]
    push lenArgs srcDesc
    push lenTypes lctx.ptrType
    def n (builder.emitCall("RtPtrArray_len" "i32" lenArgs lenTypes))

    ; --- copy the source into the result ---
    def ci (builder.emitAlloca("i32" (builder.freshTemp("sortci"))))
    def zero (builder.emitConst("i32" "0"))
    def one (builder.emitConst("i32" "1"))
    builder.emitStore("i32" zero ci)
    def cCond (builder.freshLabel("sort_copy_cond"))
    def cBody (builder.freshLabel("sort_copy_body"))
    def cDone (builder.freshLabel("sort_copy_done"))
    builder.terminateBr(cCond)
    builder.startBlock(cCond)
    def ciNow (builder.emitLoad("i32" ci))
    builder.terminateBrIf((builder.emitIcmp("slt" ciNow n)) cBody cDone)
    builder.startBlock(cBody)
    def ciCur (builder.emitLoad("i32" ci))
    def gArgs:[string]
    def gTypes:[string]
    push gArgs srcDesc
    push gTypes lctx.ptrType
    push gArgs ciCur
    push gTypes "i32"
    def elem (builder.emitCall("RtPtrArray_get" lctx.ptrType gArgs gTypes))
    def pArgs:[string]
    def pTypes:[string]
    push pArgs out
    push pTypes lctx.ptrType
    push pArgs elem
    push pTypes lctx.ptrType
    def voidT:string "void"
    builder.emitCall("RtPtrArray_push" voidT pArgs pTypes)
    builder.emitStore("i32" (builder.emitBin("add" "i32" ciCur one)) ci)
    builder.terminateBr(cCond)
    builder.startBlock(cDone)

    ; --- insertion sort over the copy ---
    ; for (i = 1; i < n; i++) { v = out[i]; j = i - 1
    ;   while (j >= 0 && cb(out[j], v) > 0) { out[j+1] = out[j]; j-- }
    ;   out[j+1] = v }
    def iSlot (builder.emitAlloca("i32" (builder.freshTemp("sorti"))))
    def jSlot (builder.emitAlloca("i32" (builder.freshTemp("sortj"))))
    def vSlot (builder.emitAlloca(lctx.ptrType (builder.freshTemp("sortv"))))
    builder.emitStore("i32" one iSlot)
    def oCond (builder.freshLabel("sort_out_cond"))
    def oBody (builder.freshLabel("sort_out_body"))
    def oDone (builder.freshLabel("sort_out_done"))
    builder.terminateBr(oCond)
    builder.startBlock(oCond)
    def iNow (builder.emitLoad("i32" iSlot))
    builder.terminateBrIf((builder.emitIcmp("slt" iNow n)) oBody oDone)

    builder.startBlock(oBody)
    def iCur (builder.emitLoad("i32" iSlot))
    def viArgs:[string]
    def viTypes:[string]
    push viArgs out
    push viTypes lctx.ptrType
    push viArgs iCur
    push viTypes "i32"
    builder.emitStore(lctx.ptrType (builder.emitCall("RtPtrArray_get" lctx.ptrType viArgs viTypes)) vSlot)
    builder.emitStore("i32" (builder.emitBin("sub" "i32" iCur one)) jSlot)
    def wCond (builder.freshLabel("sort_in_cond"))
    def wTest (builder.freshLabel("sort_in_test"))
    def wBody (builder.freshLabel("sort_in_body"))
    def wDone (builder.freshLabel("sort_in_done"))
    builder.terminateBr(wCond)

    builder.startBlock(wCond)
    def jNow (builder.emitLoad("i32" jSlot))
    builder.terminateBrIf((builder.emitIcmp("sge" jNow zero)) wTest wDone)

    builder.startBlock(wTest)
    def jCur (builder.emitLoad("i32" jSlot))
    def ljArgs:[string]
    def ljTypes:[string]
    push ljArgs out
    push ljTypes lctx.ptrType
    push ljArgs jCur
    push ljTypes "i32"
    def leftV (builder.emitCall("RtPtrArray_get" lctx.ptrType ljArgs ljTypes))
    def vNow (builder.emitLoad(lctx.ptrType vSlot))
    def cArgs:[string]
    def cTypes:[string]
    push cArgs env
    push cTypes lctx.ptrType
    push cArgs leftV
    push cTypes lctx.ptrType
    push cArgs vNow
    push cTypes lctx.ptrType
    def cmpRes (builder.emitCallIndirect("i32" sig cArgs cTypes fnIdx))
    builder.terminateBrIf((builder.emitIcmp("sgt" cmpRes zero)) wBody wDone)

    builder.startBlock(wBody)
    def jAt (builder.emitLoad("i32" jSlot))
    def sjArgs:[string]
    def sjTypes:[string]
    push sjArgs out
    push sjTypes lctx.ptrType
    push sjArgs jAt
    push sjTypes "i32"
    def moved (builder.emitCall("RtPtrArray_get" lctx.ptrType sjArgs sjTypes))
    def setArgs:[string]
    def setTypes:[string]
    push setArgs out
    push setTypes lctx.ptrType
    push setArgs (builder.emitBin("add" "i32" jAt one))
    push setTypes "i32"
    push setArgs moved
    push setTypes lctx.ptrType
    builder.emitCall("RtPtrArray_set" voidT setArgs setTypes)
    builder.emitStore("i32" (builder.emitBin("sub" "i32" jAt one)) jSlot)
    builder.terminateBr(wCond)

    builder.startBlock(wDone)
    def jEnd (builder.emitLoad("i32" jSlot))
    def vEnd (builder.emitLoad(lctx.ptrType vSlot))
    def fArgs:[string]
    def fTypes:[string]
    push fArgs out
    push fTypes lctx.ptrType
    push fArgs (builder.emitBin("add" "i32" jEnd one))
    push fTypes "i32"
    push fArgs vEnd
    push fTypes lctx.ptrType
    builder.emitCall("RtPtrArray_set" voidT fArgs fTypes)
    def iEnd (builder.emitLoad("i32" iSlot))
    builder.emitStore("i32" (builder.emitBin("add" "i32" iEnd one)) iSlot)
    builder.terminateBr(oCond)

    builder.startBlock(oDone)
    return out
  }

  ; `insert xs i v` / `remove xs i` / `array_extract xs i`. The emitted
  ; RtPtrArray_* runtime has no element-shifting routine, so these three go to
  ; C, which writes the shared descriptor directly (ranger_mem.c).
  fn lowerArrayInsert:void (node:CodeNode lctx:LowIRLowerContext) {
    def arrNode (node.getSecond())
    def idxNode (node.getThird())
    def valNode (itemAt node.children 3)
    def desc (this.loadArrayDescExpr(arrNode lctx))
    def idx (this.lowerExpr(idxNode lctx))
    def val (this.lowerExpr(valNode lctx))
    ; the array's slots are pointer sized: widen a 32-bit element the same way
    ; lowerPush does, and convert a string pointer to its integer form.
    if (this.pushValueNeedsWiden(valNode val lctx)) {
      if (this.exprProducesI1(valNode lctx)) {
        val = (lctx.builder.emitCast("zext" "i64" "i1" val))
      } {
        val = (lctx.builder.emitCast("zext" "i64" "i32" val))
      }
    } {
      if (LowIRUtil.isStringType((this.arrayElemTypeName(arrNode lctx)))) {
        def ownedStr:string val
        if (this.memEnabled(lctx)) {
          ownedStr = (this.emitStrdupExpr(val lctx))
        }
        val = (lctx.builder.emitPtrToInt(ownedStr))
      }
    }
    def ps:[string]
    push ps "i64"
    push ps "i32"
    push ps "i64"
    def voidT:string "void"
    this.ensureExternDecl("ranger_ptrarray_insert" voidT ps false)
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args idx
    push argTypes "i32"
    push args val
    push argTypes lctx.ptrType
    lctx.builder.emitCall("ranger_ptrarray_insert" voidT args argTypes)
  }

  fn emitArrayRemoveCall:string (node:CodeNode lctx:LowIRLowerContext) {
    def arrNode (node.getSecond())
    def idxNode (node.getThird())
    def desc (this.loadArrayDescExpr(arrNode lctx))
    def idx (this.lowerExpr(idxNode lctx))
    def ps:[string]
    push ps "i64"
    push ps "i32"
    this.ensureExternDecl("ranger_ptrarray_remove" "i64" ps false)
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args idx
    push argTypes "i32"
    return (lctx.builder.emitCall("ranger_ptrarray_remove" lctx.ptrType args argTypes))
  }

  fn lowerArrayRemove:void (node:CodeNode lctx:LowIRLowerContext) {
    this.emitArrayRemoveCall(node lctx)
  }

  fn lowerArrayRemoveLast:void (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def arrNode (node.getSecond())
    def desc (this.loadArrayDescExpr(arrNode lctx))
    this.usedPtrArrayRuntime = true
    def lenArgs:[string]
    def lenTypes:[string]
    push lenArgs desc
    push lenTypes lctx.ptrType
    def n (builder.emitCall("RtPtrArray_len" "i32" lenArgs lenTypes))
    def one (builder.emitConst("i32" "1"))
    def last (builder.emitBin("sub" "i32" n one))
    def ps:[string]
    push ps "i64"
    push ps "i32"
    this.ensureExternDecl("ranger_ptrarray_remove" "i64" ps false)
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args last
    push argTypes "i32"
    builder.emitCall("ranger_ptrarray_remove" lctx.ptrType args argTypes)
  }

  ; `clear xs` -- drop every element. The length is written straight through
  ; the descriptor by the C helper.
  fn lowerArrayClear:void (node:CodeNode lctx:LowIRLowerContext) {
    def arrNode (node.getSecond())
    def desc (this.loadArrayDescExpr(arrNode lctx))
    def ps:[string]
    push ps "i64"
    def voidT:string "void"
    this.ensureExternDecl("ranger_ptrarray_clear" voidT ps false)
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    lctx.builder.emitCall("ranger_ptrarray_clear" voidT args argTypes)
  }

  ; `array_extract` is `remove` that answers the element it took out. A string
  ; element comes back as an integer slot value and has to become a pointer
  ; again, the mirror of what lowerPush stores.
  fn lowerArrayExtract:string (node:CodeNode lctx:LowIRLowerContext) {
    def raw (this.emitArrayRemoveCall(node lctx))
    def arrNode (node.getSecond())
    def et:string (this.arrayElemTypeName(arrNode lctx))
    if (LowIRUtil.isStringType(et)) {
      return (lctx.builder.emitIntToI8Ptr(raw lctx.ptrType))
    }
    if (et == "int") {
      return (lctx.builder.emitCast("trunc" "i32" "i64" raw))
    }
    if (et == "boolean") {
      return (this.toI1((lctx.builder.emitCast("trunc" "i32" "i64" raw)) lctx))
    }
    return raw
  }

  ; `(? cond a b)`. Branches rather than a `select`, because either arm may
  ; call something and a select evaluates both.
  fn lowerTernary:string (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def condNode (node.getSecond())
    def aNode (node.getThird())
    def bNode (itemAt node.children 3)
    def irt:string (this.argIrType(aNode lctx))
    if (irt == "i1") {
      irt = "i32"
    }
    def slot (builder.emitAlloca(irt (builder.freshTemp("tern"))))
    def cond (this.lowerCond(condNode lctx))
    def aL (builder.freshLabel("tern_a"))
    def bL (builder.freshLabel("tern_b"))
    def endL (builder.freshLabel("tern_end"))
    builder.terminateBrIf(cond aL bL)
    builder.startBlock(aL)
    def av (this.lowerExpr(aNode lctx))
    if (this.exprProducesI1(aNode lctx)) {
      av = (builder.emitZextI1ToI32(av))
    }
    builder.emitStore(irt av slot)
    builder.terminateBr(endL)
    builder.startBlock(bL)
    def bv (this.lowerExpr(bNode lctx))
    if (this.exprProducesI1(bNode lctx)) {
      bv = (builder.emitZextI1ToI32(bv))
    }
    builder.emitStore(irt bv slot)
    builder.terminateBr(endL)
    builder.startBlock(endL)
    return (builder.emitLoad(irt slot))
  }

  ; `reverse` -> a new array holding the same elements back to front. Like
  ; `sort` the result borrows: the source array keeps owning its elements.
  fn lowerArrayReverse:string (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def arrNode (node.getSecond())
    def srcDesc (this.loadArrayDescExpr(arrNode lctx))
    this.usedPtrArrayRuntime = true
    def out (this.emitPtrArrayNewEmpty(lctx 0))
    def lenArgs:[string]
    def lenTypes:[string]
    push lenArgs srcDesc
    push lenTypes lctx.ptrType
    def n (builder.emitCall("RtPtrArray_len" "i32" lenArgs lenTypes))
    def one (builder.emitConst("i32" "1"))
    def zero (builder.emitConst("i32" "0"))
    def iSlot (builder.emitAlloca("i32" (builder.freshTemp("revi"))))
    builder.emitStore("i32" (builder.emitBin("sub" "i32" n one)) iSlot)
    def condL (builder.freshLabel("rev_cond"))
    def bodyL (builder.freshLabel("rev_body"))
    def doneL (builder.freshLabel("rev_done"))
    builder.terminateBr(condL)
    builder.startBlock(condL)
    def iNow (builder.emitLoad("i32" iSlot))
    builder.terminateBrIf((builder.emitIcmp("sge" iNow zero)) bodyL doneL)
    builder.startBlock(bodyL)
    def iCur (builder.emitLoad("i32" iSlot))
    def gArgs:[string]
    def gTypes:[string]
    push gArgs srcDesc
    push gTypes lctx.ptrType
    push gArgs iCur
    push gTypes "i32"
    def elem (builder.emitCall("RtPtrArray_get" lctx.ptrType gArgs gTypes))
    def pArgs:[string]
    def pTypes:[string]
    push pArgs out
    push pTypes lctx.ptrType
    push pArgs elem
    push pTypes lctx.ptrType
    def voidT:string "void"
    builder.emitCall("RtPtrArray_push" voidT pArgs pTypes)
    builder.emitStore("i32" (builder.emitBin("sub" "i32" iCur one)) iSlot)
    builder.terminateBr(condL)
    builder.startBlock(doneL)
    return out
  }

  ; Two-string -> scalar helpers (indexOf / lastIndexOf / contains), and the
  ; one-string -> string ones (to_lowercase / to_uppercase). All live in
  ; runtime/ranger_rt.c: they are ordinary C, and emitting a search loop as IR
  ; would buy nothing.
  ; A C helper that answers a boolean returns int; Ranger booleans are i1, so
  ; the result is compared against zero. Without this a `||` over one of them
  ; emitted `or i1 <i32 value>, ...`.
  fn toI1:string (v:string lctx:LowIRLowerContext) {
    def zero (lctx.builder.emitConst("i32" "0"))
    return (lctx.builder.emitIcmp("ne" v zero))
  }

  fn lowerStr2Fn:string (node:CodeNode fnName:string retType:string lctx:LowIRLowerContext) {
    def aNode (node.getSecond())
    def bNode (node.getThird())
    def a (this.lowerExpr(aNode lctx))
    def b (this.lowerExpr(bNode lctx))
    def ps:[string]
    push ps "i8*"
    push ps "i8*"
    this.ensureExternDecl(fnName retType ps false)
    def args:[string]
    def argTypes:[string]
    push args a
    push argTypes "i8*"
    push args b
    push argTypes "i8*"
    return (lctx.builder.emitCall(fnName retType args argTypes))
  }

  ; Three-string -> string helper (`replace`). The result is a fresh malloc'd
  ; buffer, so it is registered as a temp the way lowerStr1Fn does -- without
  ; that every `(replace s a b)` in an expression leaks.
  fn lowerStr3Fn:string (node:CodeNode fnName:string lctx:LowIRLowerContext) {
    def aNode (node.getSecond())
    def bNode (node.getThird())
    def cNode (itemAt node.children 3)
    def a (this.lowerExpr(aNode lctx))
    def b (this.lowerExpr(bNode lctx))
    def c (this.lowerExpr(cNode lctx))
    def ps:[string]
    push ps "i8*"
    push ps "i8*"
    push ps "i8*"
    this.ensureExternDecl(fnName "i8*" ps false)
    def args:[string]
    def argTypes:[string]
    push args a
    push argTypes "i8*"
    push args b
    push argTypes "i8*"
    push args c
    push argTypes "i8*"
    def res (lctx.builder.emitCall(fnName "i8*" args argTypes))
    this.registerFreshStringTemp(res lctx)
    return res
  }

  ; (string, string, int) -> scalar (`indexOfFrom`).
  fn lowerStr2IntFn:string (node:CodeNode fnName:string retType:string lctx:LowIRLowerContext) {
    def aNode (node.getSecond())
    def bNode (node.getThird())
    def cNode (itemAt node.children 3)
    def a (this.lowerExpr(aNode lctx))
    def b (this.lowerExpr(bNode lctx))
    def c (this.lowerExpr(cNode lctx))
    def ps:[string]
    push ps "i8*"
    push ps "i8*"
    push ps "i32"
    this.ensureExternDecl(fnName retType ps false)
    def args:[string]
    def argTypes:[string]
    push args a
    push argTypes "i8*"
    push args b
    push argTypes "i8*"
    push args c
    push argTypes "i32"
    return (lctx.builder.emitCall(fnName retType args argTypes))
  }

  ; One string -> scalar (`dir_exists`).
  fn lowerStr1IntFn:string (node:CodeNode fnName:string retType:string lctx:LowIRLowerContext) {
    def aNode (node.getSecond())
    def a (this.lowerExpr(aNode lctx))
    def ps:[string]
    push ps "i8*"
    this.ensureExternDecl(fnName retType ps false)
    def args:[string]
    def argTypes:[string]
    push args a
    push argTypes "i8*"
    return (lctx.builder.emitCall(fnName retType args argTypes))
  }

  ; A no-argument C helper answering a fresh string.
  fn lowerStr0Fn:string (fnName:string lctx:LowIRLowerContext) {
    def ps:[string]
    this.ensureExternDecl(fnName "i8*" ps false)
    def args:[string]
    def argTypes:[string]
    def res (lctx.builder.emitCall(fnName "i8*" args argTypes))
    this.registerFreshStringTemp(res lctx)
    return res
  }

  fn lowerStr1Fn:string (node:CodeNode fnName:string lctx:LowIRLowerContext) {
    def aNode (node.getSecond())
    def a (this.lowerExpr(aNode lctx))
    def ps:[string]
    push ps "i8*"
    this.ensureExternDecl(fnName "i8*" ps false)
    def args:[string]
    def argTypes:[string]
    push args a
    push argTypes "i8*"
    def res (lctx.builder.emitCall(fnName "i8*" args argTypes))
    this.registerFreshStringTemp(res lctx)
    return res
  }

  fn isStringKeyMapTypeNode:boolean (node:CodeNode) {
    if (node.value_type == RangerNodeType.Hash) {
      return (LowIRUtil.isStringType(node.key_type))
    }
    return false
  }

  fn isObjectPtrArrayTypeNode:boolean (node:CodeNode) {
    if (node.value_type == RangerNodeType.Array) {
      if ((strlen node.array_type) > 0) {
        if (node.array_type != "int") {
          ; `[boolean]` and `[char]` are not references. Only "int" was spelled
          ; out here, so every other primitive element type fell through to the
          ; object case: the array was built with element kind 1 (owned
          ; objects) and its scope-end release called ranger_obj_release on the
          ; literal `true`, a wild pointer.
          if (this.isPlainValueArrayTypeNode(node)) {
            return false
          }
          return true
        }
      }
    }
    return false
  }

  ; An array whose elements live in the ptr-array's pointer-sized slots as RAW
  ; VALUES rather than references -- `[double]`, `[float]`, `[boolean]`,
  ; `[char]`. Reading one back is a truncation, not a dereference, and nothing
  ; is released per element.
  fn isPlainValueArrayTypeNode:boolean (node:CodeNode) {
    if (this.isDoubleArrayTypeNode(node)) {
      return true
    }
    if (node.value_type == RangerNodeType.Array) {
      if (LowIRUtil.isStringType(node.array_type)) {
        return false
      }
      return (LowIRUtil.isSupportedPrimitive(node.array_type))
    }
    return false
  }

  ; A `[double]` array. Its elements live in the ptr-array's pointer-sized
  ; slots as RAW BIT PATTERNS (bitcast both ways) -- there is no separate
  ; double-typed array runtime, and a double is exactly 64 bits.
  fn isDoubleArrayTypeNode:boolean (node:CodeNode) {
    if (node.value_type == RangerNodeType.Array) {
      if (node.array_type == "double") {
        return true
      }
      if (node.array_type == "float") {
        return true
      }
    }
    return false
  }

  fn arrayElemIsDouble:boolean (arrNode:CodeNode lctx:LowIRLowerContext) {
    def et:string (this.arrayElemTypeName(arrNode lctx))
    if (et == "double") { return true }
    if (et == "float") { return true }
    return false
  }

  fn isStringArrayTypeNode:boolean (node:CodeNode) {
    if (node.value_type == RangerNodeType.Array) {
      return (LowIRUtil.isStringType(node.array_type))
    }
    return false
  }

  ; elemKind: 0 = plain values (int, no element release), 1 = owned objects
  ; (obj_release each on free), 2 = owned strings (str_release each on free).
  ; The value is written to the descriptor's flag word; the release runtime
  ; dispatches on it. libc reads it as a truthy "owned" flag (kind 1 = its
  ; existing object-array behaviour).
  fn emitPtrArrayNewEmpty:string (lctx:LowIRLowerContext elemKind:int) {
    this.usedPtrArrayRuntime = true
    def builder (lctx.builder)
    ; Start SMALL and let RtPtrArray_reserve grow it. Every array used to be
    ; born with room for 256 elements -- 2 KB of backing store apiece -- and the
    ; JS engine builds two per object, so a benchmark allocating millions of
    ; objects moved gigabytes through malloc and spent its whole runtime in the
    ; kernel rather than interpreting.
    def cap (builder.emitConst("i32" "4"))
    def args:[string]
    def argTypes:[string]
    push args cap
    push argTypes "i32"
    def desc (builder.emitCall("RtPtrArray_new" lctx.ptrType args argTypes))
    if (elemKind > 0) {
      def kindC (builder.emitConst("i32" ("" + elemKind)))
      builder.emitStoreI32At(desc (this.ptrArrayOwnedOff(lctx)) kindC)
    }
    return desc
  }

  fn isOwnedCollectionLocal:boolean (varName:string lctx:LowIRLowerContext) {
    for lctx.ownedCollectionLocals own:string i {
      if (own == varName) {
        return true
      }
    }
    return false
  }

  fn bindPtrArraySlot:void (varName:string desc:string lctx:LowIRLowerContext owned:boolean) {
    this.bindSlot(varName lctx.ptrType desc lctx)
    set lctx.collectionSlots varName "ptr_array"
    ; A name declared twice in one function (two branches of a long evaluator)
    ; must be released ONCE at scope end. Registering it per declaration emitted
    ; two releases of the same descriptor.
    if (this.isOwnedCollectionLocal(varName lctx)) {
      return
    }
    if owned {
      push lctx.ownedCollectionLocals varName
    } {
      ; On freestanding WASM every locally-created array (including [int], which
      ; is owned=0 at the element level) must still be freed at scope end — its
      ; backing store and descriptor live on the free-list heap. ranger_ptrarray_
      ; release reads the descriptor's owned flag, so it frees int arrays without
      ; touching elements. The libc path keeps its existing behaviour.
      if (this.wasmCollectionRcEnabled(lctx)) {
        push lctx.ownedCollectionLocals varName
      }
    }
  }

  ; Collections are freed on scope exit on the freestanding-WASM path too (not
  ; only libc): -wasmrc routes their allocation to the free-list heap, so they
  ; can — and must — be released.
  fn wasmCollectionRcEnabled:boolean (lctx:LowIRLowerContext) {
    def memTarget (LowIRTarget.resolve((unwrap lctx.ctx)))
    if (memTarget.usesLibc) {
      return false
    }
    def ctx (unwrap lctx.ctx)
    return (ctx.hasCompilerFlag("wasmrc"))
  }

  fn collectionKind:string (varName:string lctx:LowIRLowerContext) {
    if (has lctx.collectionSlots varName) {
      return (unwrap (get lctx.collectionSlots varName))
    }
    return ""
  }

  fn arrayLenOff:int (lctx:LowIRLowerContext) {
    if (lctx.ptrType == "i64") {
      return 8
    }
    return 4
  }

  fn arrayCapOff:int (lctx:LowIRLowerContext) {
    if (lctx.ptrType == "i64") {
      return 12
    }
    return 8
  }

  fn arrayDescBytes:int (lctx:LowIRLowerContext) {
    if (lctx.ptrType == "i64") {
      return 20
    }
    return 16
  }

  fn ptrArrayOwnedOff:int (lctx:LowIRLowerContext) {
    def capOff (this.arrayCapOff(lctx))
    return (capOff + 4)
  }

  fn bindCollectionSlot:void (varName:string kind:string desc:string lctx:LowIRLowerContext) {
    this.bindSlot(varName lctx.ptrType desc lctx)
    set lctx.collectionSlots varName kind
    if (this.isOwnedCollectionLocal(varName lctx)) {
      return
    }
    ; On freestanding WASM a locally-created map is freed at scope end too. The
    ; release loop dispatches by collectionKind (map -> RtMap_free).
    if (this.wasmCollectionRcEnabled(lctx)) {
      push lctx.ownedCollectionLocals varName
    }
  }

  fn loadCollectionDesc:string (varName:string lctx:LowIRLowerContext) {
    return (this.loadSlot(varName lctx.ptrType lctx))
  }

  fn emitDescLoad:string (desc:string byteOff:int lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def pt (lctx.ptrType)
    def off (builder.emitConst(pt ("" + byteOff)))
    def addr (builder.emitBin("add" pt desc off))
    return (builder.emitPtrLoad(addr))
  }

  fn emitRtArrayNewEmpty:string (lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def descBytes (builder.emitConst("i32" ("" + (this.arrayDescBytes(lctx)))))
    def desc (builder.emitHeapAlloc(descBytes))
    def sixteen (builder.emitConst("i32" "16"))
    def data (builder.emitHeapAlloc(sixteen))
    builder.emitPtrStore(desc data)
    def zero (builder.emitConst("i32" "0"))
    builder.emitStoreI32At(desc (this.arrayLenOff(lctx)) zero)
    def four (builder.emitConst("i32" "4"))
    builder.emitStoreI32At(desc (this.arrayCapOff(lctx)) four)
    return desc
  }

  fn emitRtArrayNewSized:string (cap:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def descBytes (builder.emitConst("i32" ("" + (this.arrayDescBytes(lctx)))))
    def desc (builder.emitHeapAlloc(descBytes))
    def four (builder.emitConst("i32" "4"))
    def nbytes (builder.emitBin("mul" "i32" cap four))
    def data (builder.emitHeapAlloc(nbytes))
    builder.emitPtrStore(desc data)
    def zero (builder.emitConst("i32" "0"))
    builder.emitStoreI32At(desc (this.arrayLenOff(lctx)) zero)
    builder.emitStoreI32At(desc (this.arrayCapOff(lctx)) cap)
    return desc
  }

  fn emitRtArrayGet:string (desc:string idx:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def pt (lctx.ptrType)
    def data (this.emitDescLoad(desc 0 lctx))
    def four (builder.emitConst("i32" "4"))
    def offI32 (builder.emitBin("mul" "i32" idx four))
    def off (builder.emitZextI32ToPtr(offI32))
    def slot (builder.emitBin("add" pt data off))
    return (builder.emitPtrLoadTyped(slot "i32"))
  }

  fn emitRtArraySet:void (desc:string idx:string val:string lctx:LowIRLowerContext) {
    this.usedArrayRuntime = true
    def builder (lctx.builder)
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args idx
    push argTypes "i32"
    push args val
    push argTypes "i32"
    def voidType:string "void"
    builder.emitCall("RtArray_set" voidType args argTypes)
  }

  fn emitRtArrayLen:string (desc:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    return (builder.emitI32At(desc (this.arrayLenOff(lctx))))
  }

  fn emitRtMapNew:string (cap:string lctx:LowIRLowerContext) {
    this.usedMapRuntime = true
    def builder (lctx.builder)
    def args:[string]
    def argTypes:[string]
    push args cap
    push argTypes "i32"
    return (builder.emitCall("RtMap_new" lctx.ptrType args argTypes))
  }

  fn emitRtMapPut:void (desc:string key:string val:string lctx:LowIRLowerContext) {
    this.usedMapRuntime = true
    def builder (lctx.builder)
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args key
    push argTypes "i32"
    push args val
    push argTypes "i32"
    def voidType:string "void"
    builder.emitCall("RtMap_put" voidType args argTypes)
  }

  fn emitRtMapGet:string (desc:string key:string lctx:LowIRLowerContext) {
    this.usedMapRuntime = true
    def builder (lctx.builder)
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args key
    push argTypes "i32"
    return (builder.emitCall("RtMap_get" "i32" args argTypes))
  }

  fn emitRtMapHas:string (desc:string key:string lctx:LowIRLowerContext) {
    this.usedMapRuntime = true
    def builder (lctx.builder)
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args key
    push argTypes "i32"
    return (builder.emitCall("RtMap_has" "i32" args argTypes))
  }

  fn lowerCollectionMake:string (node:CodeNode lctx:LowIRLowerContext) {
    def sizeNode (node.getThird())
    def cap (this.lowerExpr(sizeNode lctx))
    def innerNode (node.getSecond())
    if (this.isObjectPtrArrayTypeNode(innerNode)) {
      this.usedPtrArrayRuntime = true
      def builder (lctx.builder)
      def args:[string]
      def argTypes:[string]
      push args cap
      push argTypes "i32"
      return (builder.emitCall("RtPtrArray_new" lctx.ptrType args argTypes))
    }
    ; [int] arrays are also stored as ptr-arrays (8-byte slots) for a single,
    ; consistent representation across make / push / at / set / for.
    this.usedPtrArrayRuntime = true
    def iargs:[string]
    def iargTypes:[string]
    push iargs cap
    push iargTypes "i32"
    return (lctx.builder.emitCall("RtPtrArray_new" lctx.ptrType iargs iargTypes))
  }

  fn lowerCollectionGet:string (node:CodeNode lctx:LowIRLowerContext) {
    def collNode (node.getSecond())
    def keyNode (node.getThird())
    def varName:string collNode.vref
    def kind (this.collectionKind(varName lctx))
    def desc (this.loadCollectionDesc(varName lctx))
    def key (this.lowerExpr(keyNode lctx))
    def gsm (this.smapDescFromVref(varName lctx))
    if ((strlen gsm) > 0) {
      def gRest:[string]
      def gTypes:[string]
      push gRest (this.strKeyPtr(keyNode key lctx))
      push gTypes "i8*"
      def gres (this.emitSMapCall("RtSMap_get" "i64" gsm gRest gTypes lctx))
      def gkind (this.smapValueKind(varName lctx))
      if (gkind == "int") {
        return (lctx.builder.emitCast("trunc" "i32" "i64" gres))
      }
      if (gkind == "string") {
        return (lctx.builder.emitIntToI8Ptr(gres lctx.ptrType))
      }
      return gres
    }
    def gim (this.imapDescFromVref(varName lctx))
    if ((strlen gim) > 0) {
      def giRest:[string]
      def giTypes:[string]
      push giRest (this.widenToI64(key keyNode lctx))
      push giTypes "i64"
      def gires (this.emitIMapCall("RtIMap_get" "i64" gim giRest giTypes lctx))
      def gikind (this.imapValueKind(varName lctx))
      if (gikind == "int") {
        return (lctx.builder.emitCast("trunc" "i32" "i64" gires))
      }
      if (gikind == "string") {
        return (lctx.builder.emitIntToI8Ptr(gires lctx.ptrType))
      }
      return gires
    }
    if (kind == "map") {
      return (this.emitRtMapGet(desc key lctx))
    }
    return (this.emitPtrArrayElemGet(desc key collNode lctx))
  }

  fn lowerCollectionLen:string (node:CodeNode lctx:LowIRLowerContext) {
    def collNode (node.getSecond())
    if (collNode.value_type == RangerNodeType.VRef) {
      def pdesc (this.ptrArrayDescFromVref(collNode.vref lctx))
      if ((strlen pdesc) > 0) {
        return (this.emitPtrArrayLen(pdesc lctx))
      }
    } {
      ; An EXPRESSION collection: `(array_length (keys m))`. Every lookup below
      ; is by NAME, and an expression has none -- the descriptor came back
      ; empty and the length load read offset 8 of nothing.
      return (this.emitPtrArrayLen((this.lowerExpr(collNode lctx)) lctx))
    }
    def varName:string collNode.vref
    def desc (this.loadCollectionDesc(varName lctx))
    def lsm (this.smapDescFromVref(varName lctx))
    if ((strlen lsm) > 0) {
      def lRest:[string]
      def lTypes:[string]
      return (this.emitSMapCall("RtSMap_size" "i32" lsm lRest lTypes lctx))
    }
    def lim (this.imapDescFromVref(varName lctx))
    if ((strlen lim) > 0) {
      def liRest:[string]
      def liTypes:[string]
      return (this.emitIMapCall("RtIMap_size" "i32" lim liRest liTypes lctx))
    }
    return (this.emitRtArrayLen(desc lctx))
  }

  fn lowerCollectionHas:string (node:CodeNode lctx:LowIRLowerContext) {
    def collNode (node.getSecond())
    def keyNode (node.getThird())
    def varName:string collNode.vref
    def desc (this.loadCollectionDesc(varName lctx))
    def key (this.lowerExpr(keyNode lctx))
    def hsm (this.smapDescFromVref(varName lctx))
    if ((strlen hsm) > 0) {
      def hRest:[string]
      def hTypes:[string]
      push hRest (this.strKeyPtr(keyNode key lctx))
      push hTypes "i8*"
      return (this.toI1((this.emitSMapCall("RtSMap_has" "i32" hsm hRest hTypes lctx)) lctx))
    }
    def him (this.imapDescFromVref(varName lctx))
    if ((strlen him) > 0) {
      def hiRest:[string]
      def hiTypes:[string]
      push hiRest (this.widenToI64(key keyNode lctx))
      push hiTypes "i64"
      return (this.toI1((this.emitIMapCall("RtIMap_has" "i32" him hiRest hiTypes lctx)) lctx))
    }
    return (this.emitRtMapHas(desc key lctx))
  }

  fn lowerCollectionSet:void (node:CodeNode lctx:LowIRLowerContext) {
    def collNode (node.getSecond())
    def keyNode (node.getThird())
    def valNode@(optional):CodeNode
    if ((array_length node.children) > 3) {
      valNode = (itemAt node.children 3)
    }
    if (null? valNode) {
      return
    }
    def key (this.lowerExpr(keyNode lctx))
    def val (this.lowerExpr((unwrap valNode) lctx))
    if (collNode.value_type == RangerNodeType.VRef) {
      def varName:string collNode.vref
      def kind (this.collectionKind(varName lctx))
      def sim (this.imapDescFromVref(varName lctx))
      if ((strlen sim) > 0) {
        def siRest:[string]
        def siTypes:[string]
        push siRest (this.widenToI64(key keyNode lctx))
        push siTypes "i64"
        def sival:string val
        def sikind (this.imapValueKind(varName lctx))
        if (sikind == "int") {
          if (this.exprProducesI1((unwrap valNode) lctx)) {
            sival = (lctx.builder.emitCast("zext" "i64" "i1" val))
          } {
            sival = (lctx.builder.emitCast("zext" "i64" "i32" val))
          }
        }
        if (sikind == "string") {
          sival = (lctx.builder.emitPtrToInt(val))
        }
        push siRest sival
        push siTypes "i64"
        def voidI:string "void"
        this.emitIMapCall("RtIMap_set" voidI sim siRest siTypes lctx)
        return
      }
      def ssm (this.smapDescFromVref(varName lctx))
      if ((strlen ssm) > 0) {
        def sdesc:string ssm
        def sRest:[string]
        def sTypes:[string]
        push sRest (this.strKeyPtr(keyNode key lctx))
        push sTypes "i8*"
        def sval:string val
        def skind (this.smapValueKind(varName lctx))
        if (skind == "int") {
          ; A `[string:boolean]` value arrives as i1, an int one as i32; widen
          ; from whichever it actually is.
          if (this.exprProducesI1((unwrap valNode) lctx)) {
            sval = (lctx.builder.emitCast("zext" "i64" "i1" val))
          } {
            sval = (lctx.builder.emitCast("zext" "i64" "i32" val))
          }
        }
        if (skind == "string") {
          sval = (lctx.builder.emitPtrToInt(val))
        }
        push sRest sval
        push sTypes "i64"
        def _sp (this.emitSMapCall("RtSMap_put" "void" sdesc sRest sTypes lctx))
        return
      }
      if (kind == "map") {
        def mdesc (this.loadCollectionDesc(varName lctx))
        this.emitRtMapPut(mdesc key val lctx)
        return
      }
      if (kind == "array") {
        def adesc (this.loadCollectionDesc(varName lctx))
        this.emitRtArraySet(adesc key val lctx)
        return
      }
      if (kind == "ptr_array") {
        def pdesc (this.loadSlot(varName lctx.ptrType lctx))
        this.emitPtrArrayElemSet(pdesc key val collNode lctx)
        return
      }
      def fdesc (this.ptrArrayDescFromVref(varName lctx))
      if ((strlen fdesc) > 0) {
        this.emitPtrArrayElemSet(fdesc key val collNode lctx)
        return
      }
    }
    def desc (this.loadPtrArrayDescExpr(collNode lctx))
    this.emitPtrArrayElemSet(desc key val collNode lctx)
  }

  ; The class's own variables preceded by every INHERITED one, base first. The
  ; struct is flat -- there is no LLVM-side inheritance -- so a field declared
  ; on a base class has to be in the derived struct or its index comes back -1
  ; and the load is `getelementptr … i32 -1`, which clang rejects.
  ;
  ; A derived class may RESTATE a base field (RangerAppFunctionDesc does, to
  ; change its ownership annotation): the first declaration wins, so the two
  ; names stay one slot.
  fn collectStructVars:[RangerAppParamDesc] (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    def out:[RangerAppParamDesc]
    def seen:[string:boolean]
    this.collectStructVarsInto(cl ctx out seen 0)
    return out
  }

  fn collectStructVarsInto:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext out@(mutates):[RangerAppParamDesc] seen@(mutates):[string:boolean] depth:int) {
    if (depth > 16) {
      return
    }
    for cl.extends_classes baseName:string bi {
      if (ctx.isDefinedClass(baseName)) {
        def baseCl (ctx.findClass(baseName))
        this.collectStructVarsInto(baseCl ctx out seen (depth + 1))
      }
    }
    for cl.variables v@(lives):RangerAppParamDesc i {
      if (has seen v.name) {
        continue
      }
      set seen v.name true
      push out v
    }
  }

  fn lowerStruct:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    def st@(lives):LowIRStruct (new LowIRStruct())
    st.name = cl.name
    def ptrType (this.irModule.ptrType)
    def structVars (this.collectStructVars(cl ctx))
    for structVars v:RangerAppParamDesc i {
      if (null? v.nameNode) {
        continue
      }
      def nn (unwrap v.nameNode)
      def f@(lives):LowIRField (new LowIRField())
      f.name = v.name
      def isObjArray:boolean false
      if (LowIRUtil.isArrayTypeName(nn.type_name)) {
        isObjArray = true
      } {
        if (nn.value_type == RangerNodeType.Array) {
          if ((strlen nn.array_type) > 0) {
            ; All array-typed fields (including [int]) are stored as ptr-arrays:
            ; element access uses RtPtrArray_* and the field must be allocated in
            ; the constructor. (Local [int] vars still use the inline RtArray desc.)
            isObjArray = true
          }
        }
      }
      def isStrMap:boolean false
      def isIntRefMap:boolean false
      if (nn.value_type == RangerNodeType.Hash) {
        if (LowIRUtil.isStringType(nn.key_type)) {
          isStrMap = true
        } {
          ; `[int:T]` with a REFERENCE value: RtIMap_*, not the 4-byte RtMap_*.
          if (nn.key_type == "int") {
            if ((strlen nn.array_type) > 0) {
              if (nn.array_type != "int") {
                isIntRefMap = true
              }
            }
          }
        }
      }
      if isIntRefMap {
        f.irType = ptrType
        f.isIntMap = true
        if (LowIRUtil.isStringType(nn.array_type)) {
          f.isIntMapStr = true
        }
      }
      if isStrMap {
        f.irType = ptrType
        f.isStringMap = true
        if (nn.array_type == "int") {
          f.isStringMapInt = true
        }
        if (nn.array_type == "boolean") {
          f.isStringMapInt = true
        }
        if (LowIRUtil.isStringType(nn.array_type)) {
          f.isStringMapStr = true
        }
      } {
      if isObjArray {
        f.irType = ptrType
        f.isPtrArray = true
      } {
        if (LowIRUtil.isBufferTypeName(nn.type_name)) {
          f.irType = ptrType
          f.isBuffer = true
        } {
          if (LowIRUtil.isStringType(nn.type_name)) {
            f.irType = ptrType
            f.isString = true
          } {
            if (nn.type_name == "boolean") {
              f.irType = "i32"
              f.isBool = true
            } {
              if (LowIRUtil.isSupportedPrimitive(nn.type_name)) {
                f.irType = (LowIRUtil.fieldIrType(nn.type_name))
              } {
                ; An ENUM field is an int, not an object. Without this
                ; `def eval_type:RangerNodeType` became a pointer-sized field
                ; and every `node.eval_type == RangerNodeType.Array` compared
                ; an i64 against the i32 the enum constant lowers to.
                if (this.isEnumTypeName(nn.type_name)) {
                  f.irType = "i32"
                } {
                  f.irType = ptrType
                  f.isObject = true
                }
              }
            }
          }
        }
      }
      }
      push st.fields f
    }
    push this.irModule.structs st
    def target (LowIRTarget.resolve(ctx))
    this.lowerTypeDesc(st target)
  }

  fn lowerTypeDesc:void (st:LowIRStruct target:LowIRTarget) {
    def td@(lives):LowIRTypeDesc (new LowIRTypeDesc())
    td.className = st.name
    td.size = (this.structByteSize(st.name this.irModule))
    def fi:int 0
    for st.fields f:LowIRField i {
      def kind:int 9
      if (f.isString) {
        kind = 0
      } {
        if (f.isObject) {
          kind = 1
        } {
          if (f.isPtrArray) {
            kind = 2
          } {
            ; A string-keyed MAP field had no kind at all, so destroying an
            ; object leaked its map AND every value in it. An EvalContext's
            ; `bindings` is one of these: each JS call bound its arguments into a
            ; map that was never freed, leaking one value per argument per call.
            if (f.isStringMap) {
              kind = 3
            } {
              ; An int-keyed reference map field: same story as kind 3, other
              ; runtime. Without a kind, destroying the object leaks the map and
              ; every reference in it.
              if (f.isIntMap) {
                kind = 4
              }
            }
          }
        }
      }
      if (kind != 9) {
        def fd@(lives):LowIRTypeFieldDesc (new LowIRTypeFieldDesc())
        fd.offset = (this.fieldByteOffset(st.name fi this.irModule))
        fd.kind = kind
        ; Object fields (kind=1) and ptr-array fields (kind=2) default to BORROW
        ; (owned=0): they typically alias memory owned elsewhere (array elements,
        ; other nodes, a collection passed in and stored into a field). The
        ; destructor must not recursively free them (would double-free when the
        ; original owner also releases). String fields (kind=0) stay owned, since
        ; each object holds its own strdup'd copy. Borrow analysis (Vaihe 3) can
        ; later promote provably-owned object/array fields back to owned.
        ; Every field kind holds a COUNTED reference: emitFieldStoreOnEx retains
        ; on store, so destruction has to release. Retaining on store while
        ; leaving the field a borrow leaked one reference per assignment --
        ; `new C(i)` in a loop leaked its instance, because `this.v = v` and the
        ; protoRef store each added a reference nothing ever gave back.
        fd.owned = 1
        push td.fields fd
      }
      fi = fi + 1
    }
    push this.irModule.typeDescs td
    this.usedMemRuntime = true
    this.ensureMemExtern(target)
  }

  fn fieldByteOffset:int (className:string fieldIndex:int module:LowIRModule) {
    for module.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      def size:int 0
      def fi:int 0
      for st.fields f:LowIRField i {
        ; Align to THIS field before answering for it. The check used to come
        ; first, so a field following a narrower one reported the unaligned
        ; running total: in a struct laid out { .. i32, i64 .. } the i64 was
        ; reported at 44 where LLVM puts it at 48. Every reader of these offsets
        ; then straddled two fields -- the object destructor read a garbage
        ; pointer out of the seam and called free() on it.
        def fsize:int 4
        def falign:int 4
        if (f.irType != "i32") {
          fsize = 8
          falign = 8
        }
        def rem:int (size % falign)
        if (rem != 0) {
          size = size + (falign - rem)
        }
        if (fi == fieldIndex) {
          return size
        }
        size = size + fsize
        fi = fi + 1
      }
    }
    return 0
  }

  ; A loop's item and index names SHADOW anything of the same name outside it.
  ; Without that a nested loop reuses the enclosing loop's slot -- and the
  ; compiler's own source nests `for … i { … for … i { … } }` freely -- so the
  ; inner loop reset the outer loop's counter and the outer loop never ended.
  ; That is what made the native build allocate until the process died.
  ;
  ; The inner binding gets its OWN alloca under a generated name; the previous
  ; mapping is put back by restoreShadow when the body is done.
  fn shadowBind:string (varName:string irType:string value:string lctx:LowIRLowerContext) {
    if ((has lctx.slots varName) == false) {
      this.bindSlot(varName irType value lctx)
      return ""
    }
    def prev:string (unwrap (get lctx.slots varName))
    ; A MONOTONIC counter, not the stack depth: two sibling loops at the same
    ; depth would otherwise pick the same alloca name.
    lctx.shadowCounter = (lctx.shadowCounter + 1)
    def fresh:string ("%" + varName + "_sh" + ("" + lctx.shadowCounter))
    lctx.builder.emitAlloca(irType fresh)
    lctx.builder.emitStore(irType value fresh)
    set lctx.slots varName fresh
    set lctx.slotTypes varName irType
    return prev
  }

  fn restoreShadow:void (varName:string prev:string lctx:LowIRLowerContext) {
    if ((strlen prev) == 0) {
      return
    }
    set lctx.slots varName prev
  }

  ; True when varName is queued for a fresh alloca (see forceFreshSlots); the
  ; entry is consumed, so a second bindSlot for the same name reuses the new slot.
  fn takeForceFresh:boolean (varName:string lctx:LowIRLowerContext) {
    def n (array_length lctx.forceFreshSlots)
    def idx:int -1
    def fi:int 0
    while (fi < n) {
      if ((itemAt lctx.forceFreshSlots fi) == varName) {
        idx = fi
        fi = n
      } {
        fi = fi + 1
      }
    }
    if (idx < 0) {
      return false
    }
    remove_index lctx.forceFreshSlots idx
    return true
  }

  fn bindSlot:void (varName:string irType:string value:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def wantFresh:boolean (this.takeForceFresh(varName lctx))
    if (wantFresh == false) {
      if (has lctx.slots varName) {
        def slot (unwrap (get lctx.slots varName))
        builder.emitStore(irType value slot)
        set lctx.slotTypes varName irType
        return
      }
    }
    def slotName:string ("%" + varName + "_addr")
    if wantFresh {
      lctx.shadowCounter = (lctx.shadowCounter + 1)
      slotName = ("%" + varName + "_rd" + ("" + lctx.shadowCounter) + "_addr")
    }
    builder.emitAlloca(irType slotName)
    ; Zero-init pointer slots in the entry block (before the value store) so that
    ; owned object/collection locals defined inside a conditional branch but
    ; released unconditionally at scope end hold NULL on skipped paths. Releasing
    ; NULL is a guarded no-op; releasing garbage (uninitialized alloca) crashes.
    ; Only needed (and only valid) on manual-memory targets that emit the ARC
    ; runtime; other backends (e.g. WASM) manage slots differently.
    if (this.memEnabled(lctx)) {
      if (irType == lctx.ptrType) {
        builder.emitZeroInitToEntry(irType slotName)
      }
    }
    ; String slots need the same guard, for the same reason: `def second:string
    ; (at source i)` nested three ifs deep is still released on the exit path
    ; that never reached it, and the alloca would hold whatever the stack had.
    ; ranger_str_release treats NULL as nothing to free.
    if (this.strRcEnabled(lctx)) {
      if (irType == "i8*") {
        builder.emitNullInitToEntry(irType slotName)
      }
    }
    builder.emitStore(irType value slotName)
    set lctx.slots varName slotName
    set lctx.slotTypes varName irType
  }

  fn loadSlot:string (varName:string irType:string lctx:LowIRLowerContext) {
    if (has lctx.slots varName) {
      def slot (unwrap (get lctx.slots varName))
      def builder (lctx.builder)
      def loadType (irType)
      if (has lctx.slotTypes varName) {
        loadType = (unwrap (get lctx.slotTypes varName))
      }
      ; objectSlots forces the POINTER type, but only when the slot has no
      ; recorded type of its own. It is never cleared, so a name redeclared
      ; later in the same function (`def cv:EvalValue` … `def cv:double`) keeps
      ; the stale class entry; slotTypes always reflects the latest store, and
      ; every object binding records the pointer type there anyway.
      if ((has lctx.slotTypes varName) == false) {
        if (has lctx.objectSlots varName) {
          loadType = lctx.ptrType
        }
      }
      return (builder.emitLoad(loadType slot))
    }
    ; A FUNCTION PARAMETER is an SSA name, not a slot, so the bare name is
    ; right for one. Any other unknown name is a name this function never
    ; defined, and emitting it produced IR that would not assemble -- a zero of
    ; the requested type keeps the module valid and localises the damage.
    if (this.isParamName(varName lctx)) {
      return ("%" + varName)
    }
    def z:string "0"
    if (irType == "i8*") {
      return "null"
    }
    if (irType == "f64") {
      z = "0.0"
    }
    ; An unknown OBJECT name (one objectSlots knows the class of, or one the
    ; caller asked for at the pointer width) answers a pointer-sized zero.
    if (has lctx.objectSlots varName) {
      return (lctx.builder.emitConst(lctx.ptrType "0"))
    }
    return (lctx.builder.emitConst(irType z))
  }

  fn isParamName:boolean (varName:string lctx:LowIRLowerContext) {
    for lctx.paramNames pn:string i {
      if (pn == varName) {
        return true
      }
    }
    return false
  }

  fn fieldIrTypeFor:string (className:string fieldName:string) {
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.name == fieldName) {
          return f.irType
        }
      }
    }
    return "i32"
  }

  fn fieldIsPtrArraySlot:boolean (className:string fieldName:string) {
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.name == fieldName) {
          return f.isPtrArray
        }
      }
    }
    return false
  }

  fn fieldIsObjectSlot:boolean (className:string fieldName:string) {
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.name == fieldName) {
          return f.isObject
        }
      }
    }
    return false
  }

  ; The RtSMap descriptor behind `vref`, whether it is a local slot or a field
  ; (bare or `recv.field`). "" when the name is not a string map.
  ; A string map key must reach the runtime as an i8*. A key that came out of a
  ; `[string]` array or a pointer-sized slot is an integer address at this
  ; point, so it is converted; one the backend already knows is a string is
  ; passed through.
  fn strKeyPtr:string (keyNode:CodeNode key:string lctx:LowIRLowerContext) {
    ; Decide on the SLOT, not the declaration. A `for xs kk:string` loop
    ; variable is declared string but bound into a pointer-sized integer slot,
    ; so the declaration says i8* while the value in hand is i64.
    if (keyNode.value_type == RangerNodeType.VRef) {
      if (has lctx.slotTypes keyNode.vref) {
        def kst (unwrap (get lctx.slotTypes keyNode.vref))
        if (kst == "i8*") {
          return key
        }
        return (lctx.builder.emitIntToI8Ptr(key lctx.ptrType))
      }
    }
    if (this.exprIsStringish(keyNode lctx)) {
      return key
    }
    if (this.exprIsString(keyNode)) {
      return key
    }
    return (lctx.builder.emitIntToI8Ptr(key lctx.ptrType))
  }

  fn smapDescFromVref:string (vref:string lctx:LowIRLowerContext) {
    if ((this.collectionKind(vref lctx)) == "smap") {
      return (this.loadCollectionDesc(vref lctx))
    }
    if ((indexOf vref ".") >= 0) {
      def parts:[string] (strsplit vref ".")
      if ((array_length parts) >= 2) {
        def recv (itemAt parts 0)
        def fld (itemAt parts 1)
        def cls (this.resolveObjectClass(recv lctx))
        if ((strlen cls) > 0) {
          if (this.fieldIsStringMapSlot(cls fld)) {
            return (this.emitFieldLoadOn(cls (this.resolveObjectPtrChain(recv cls lctx)) fld lctx))
          }
        }
      }
      return ""
    }
    if (this.resolvesToField(vref lctx)) {
      if (this.fieldIsStringMapSlot(lctx.className vref)) {
        return (this.emitFieldLoad(vref lctx))
      }
    }
    return ""
  }

  ; "int", "string" or "" (an object/pointer value) for the map named by vref.
  ; Does this name refer to a [string:T] map? Reads type information only --
  ; smapDescFromVref EMITS a field load, so it can not be used as a predicate.
  fn isStringMapVref:boolean (vref:string lctx:LowIRLowerContext) {
    if (has lctx.smapValueTypes vref) {
      return true
    }
    if ((this.collectionKind(vref lctx)) == "smap") {
      return true
    }
    if ((indexOf vref ".") >= 0) {
      def parts:[string] (strsplit vref ".")
      def n:int (array_length parts)
      if (n >= 2) {
        def recv:string (this.joinDotPrefix(parts (n - 1)))
        def fld (itemAt parts (n - 1))
        def cls (this.resolveObjectClassChain(recv lctx))
        if ((strlen cls) > 0) {
          return (this.fieldIsStringMapSlot(cls fld))
        }
      }
      return false
    }
    if (this.resolvesToField(vref lctx)) {
      return (this.fieldIsStringMapSlot(lctx.className vref))
    }
    return false
  }

  fn smapValueKind:string (vref:string lctx:LowIRLowerContext) {
    ; A LOCAL string map records its value type on the context (no field to
    ; carry it), so answer from there before looking for a class field.
    if (has lctx.smapValueTypes vref) {
      def lvt:string (unwrap (get lctx.smapValueTypes vref))
      if (lvt == "int") { return "int" }
      if (lvt == "boolean") { return "int" }
      if (LowIRUtil.isStringType(lvt)) { return "string" }
      return ""
    }
    def cls:string ""
    def fld:string ""
    if ((indexOf vref ".") >= 0) {
      def parts:[string] (strsplit vref ".")
      if ((array_length parts) >= 2) {
        cls = (this.resolveObjectClass((itemAt parts 0) lctx))
        fld = (itemAt parts 1)
      }
    } {
      if (this.resolvesToField(vref lctx)) {
        cls = lctx.className
        fld = vref
      }
    }
    if ((strlen cls) == 0) {
      return ""
    }
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != cls) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.name == fld) {
          if f.isStringMapInt { return "int" }
          if f.isStringMapStr { return "string" }
          return ""
        }
      }
    }
    return ""
  }

  ; True when `vref` names a string map whose VALUES are ints.
  fn smapValueIsInt:boolean (vref:string lctx:LowIRLowerContext) {
    if (has lctx.smapValueTypes vref) {
      return ((this.smapValueKind(vref lctx)) == "int")
    }
    def cls:string ""
    def fld:string ""
    if ((indexOf vref ".") >= 0) {
      def parts:[string] (strsplit vref ".")
      if ((array_length parts) >= 2) {
        cls = (this.resolveObjectClass((itemAt parts 0) lctx))
        fld = (itemAt parts 1)
      }
    } {
      if (this.resolvesToField(vref lctx)) {
        cls = lctx.className
        fld = vref
      }
    }
    if ((strlen cls) == 0) {
      return false
    }
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != cls) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.name == fld) {
          return f.isStringMapInt
        }
      }
    }
    return false
  }

  fn fieldIsIntMapSlot:boolean (className:string fieldName:string) {
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.name == fieldName) {
          return f.isIntMap
        }
      }
    }
    return false
  }

  fn fieldIsStringMapSlot:boolean (className:string fieldName:string) {
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.name == fieldName) {
          return f.isStringMap
        }
      }
    }
    return false
  }

  fn fieldIsStringSlot:boolean (className:string fieldName:string) {
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.name == fieldName) {
          return f.isString
        }
      }
    }
    return false
  }

  fn fieldIsBufferSlot:boolean (className:string fieldName:string) {
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.name == fieldName) {
          return f.isBuffer
        }
      }
    }
    return false
  }

  fn fieldIsBoolSlot:boolean (className:string fieldName:string) {
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      for st.fields f:LowIRField i {
        if (f.name == fieldName) {
          return f.isBool
        }
      }
    }
    return false
  }

  fn ptrArrayDescFromVref:string (vref:string lctx:LowIRLowerContext) {
    if ((indexOf vref ".") >= 0) {
      def parts:[string] (strsplit vref ".")
      if ((array_length parts) < 2) {
        return ""
      }
      ; The receiver is EVERYTHING before the last segment, so a chain such as
      ; `cl.node.children` resolves too. Reading only parts 0 and 1 made a
      ; three-deep array reference produce a bare `%cl.node.children`.
      def n:int (array_length parts)
      def recv:string (this.joinDotPrefix(parts (n - 1)))
      def fld (itemAt parts (n - 1))
      def cls (this.resolveObjectClassChain(recv lctx))
      if ((strlen cls) == 0) {
        return ""
      }
      if (this.fieldIsPtrArraySlot(cls fld) == false) {
        return ""
      }
      def sptr (this.resolveObjectPtrChain(recv cls lctx))
      return (this.emitFieldLoadOn(cls sptr fld lctx))
    }
    if (this.resolvesToField(vref lctx)) {
      if (this.fieldIsPtrArraySlot(lctx.className vref)) {
        return (this.emitFieldLoad(vref lctx))
      }
    }
    if (has lctx.collectionSlots vref) {
      def kind (unwrap (get lctx.collectionSlots vref))
      if (kind == "ptr_array") {
        return (this.loadSlot(vref lctx.ptrType lctx))
      }
    }
    return ""
  }

  fn loadPtrArrayDescExpr:string (arrNode:CodeNode lctx:LowIRLowerContext) {
    if (arrNode.value_type == RangerNodeType.VRef) {
      def desc (this.ptrArrayDescFromVref(arrNode.vref lctx))
      if ((strlen desc) > 0) {
        return desc
      }
    }
    return (this.lowerExpr(arrNode lctx))
  }

  fn emitPtrArrayLen:string (desc:string lctx:LowIRLowerContext) {
    this.usedPtrArrayRuntime = true
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    return (lctx.builder.emitCall("RtPtrArray_len" "i32" args argTypes))
  }

  ; The declared element type of an array field on the given class, or "".
  fn fieldArrayElemType:string (className:string fieldName:string lctx:LowIRLowerContext) {
    def appCtx (unwrap lctx.ctx)
    if (false == (has appCtx.definedClasses className)) {
      return ""
    }
    def cl (unwrap (get appCtx.definedClasses className))
    ; INHERITED fields too -- the struct is flat, and a field declared on a
    ; base class is just as much a field of this one.
    def allVars (this.collectStructVars(cl appCtx))
    for allVars v:RangerAppParamDesc i {
      if (v.name == fieldName) {
        if (null? v.nameNode) {
          return ""
        }
        def nn (unwrap v.nameNode)
        return nn.array_type
      }
    }
    return ""
  }

  ; A `[int]` array stored as a ptr-array holds its int values in pointer-sized
  ; (i64) slots. Element reads/writes therefore need an i64<->i32 conversion.
  fn ptrArrayElemIsInt:boolean (arrNode:CodeNode lctx:LowIRLowerContext) {
    if (arrNode.array_type == "int") {
      return true
    }
    if (arrNode.value_type == RangerNodeType.VRef) {
      def vr:string arrNode.vref
      if ((indexOf vr ".") >= 0) {
        def parts:[string] (strsplit vr ".")
        if ((array_length parts) >= 2) {
          def recv (itemAt parts 0)
          def fld (itemAt parts 1)
          def cls (this.resolveObjectClass(recv lctx))
          if ((strlen cls) > 0) {
            if ((this.fieldArrayElemType(cls fld lctx)) == "int") {
              return true
            }
          }
        }
        return false
      }
      if (this.resolvesToField(vr lctx)) {
        if ((this.fieldArrayElemType(lctx.className vr lctx)) == "int") {
          return true
        }
      }
      if (has lctx.ptrArrayElemTypes vr) {
        if ((unwrap (get lctx.ptrArrayElemTypes vr)) == "int") {
          return true
        }
      }
    }
    return false
  }

  fn lowerItemAt:string (node:CodeNode lctx:LowIRLowerContext) {
    def arrNode (node.getSecond())
    def idxNode (node.getThird())
    def idx (this.lowerExpr(idxNode lctx))
    if (arrNode.value_type == RangerNodeType.VRef) {
      def kind (this.collectionKind(arrNode.vref lctx))
      if (kind == "array") {
        def desc (this.loadCollectionDesc(arrNode.vref lctx))
        return (this.emitRtArrayGet(desc idx lctx))
      }
      if (kind == "ptr_array") {
        def desc (this.loadSlot(arrNode.vref lctx.ptrType lctx))
        return (this.emitPtrArrayElemGet(desc idx arrNode lctx))
      }
    }
    def desc (this.loadPtrArrayDescExpr(arrNode lctx))
    return (this.emitPtrArrayElemGet(desc idx arrNode lctx))
  }

  fn emitPtrArrayElemGet:string (desc:string idx:string arrNode:CodeNode lctx:LowIRLowerContext) {
    this.usedPtrArrayRuntime = true
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args idx
    push argTypes "i32"
    def raw (lctx.builder.emitCall("RtPtrArray_get" lctx.ptrType args argTypes))
    if (lctx.ptrType == "i64") {
      if (this.ptrArrayElemIsInt(arrNode lctx)) {
        return (lctx.builder.emitCast("trunc" "i32" "i64" raw))
      }
      ; A pointer array stores pointer-sized INTEGERS. A string element is a
      ; pointer to every consumer of it -- ranger_strdup, concat, compare -- so
      ; it is converted back on the way out. The write side does the mirror, and
      ; a push(get(x)) round trip folds to a no-op.
      if (LowIRUtil.isStringType((this.arrayElemTypeName(arrNode lctx)))) {
        return (lctx.builder.emitIntToI8Ptr(raw lctx.ptrType))
      }
      if (this.arrayElemIsDouble(arrNode lctx)) {
        return (lctx.builder.emitCast("bitcast" "f64" "i64" raw))
      }
      ; A `[boolean]` element is stored widened; every consumer of a boolean on
      ; this backend wants an i1. Without this `def isStatic:boolean (itemAt
      ; flags i)` stored the raw i64 into an i1 slot.
      if ((this.arrayElemTypeName(arrNode lctx)) == "boolean") {
        return (this.toI1((lctx.builder.emitCast("trunc" "i32" "i64" raw)) lctx))
      }
    }
    return raw
  }

  fn emitPtrArrayElemSet:void (desc:string idx:string val:string arrNode:CodeNode lctx:LowIRLowerContext) {
    this.usedPtrArrayRuntime = true
    def storeVal:string val
    if (lctx.ptrType == "i64") {
      if (this.ptrArrayElemIsInt(arrNode lctx)) {
        storeVal = (lctx.builder.emitCast("zext" "i64" "i32" val))
      } {
        if (LowIRUtil.isStringType((this.arrayElemTypeName(arrNode lctx)))) {
          def ownedSet:string val
          if (this.memEnabled(lctx)) {
            ownedSet = (this.emitStrdupExpr(val lctx))
          }
          storeVal = (lctx.builder.emitPtrToInt(ownedSet))
        }
        if (this.arrayElemIsDouble(arrNode lctx)) {
          storeVal = (lctx.builder.emitCast("bitcast" "i64" "f64" val))
        }
        ; An object array OWNS its elements (kind 1 -- released with the array),
        ; so a stored element gains a reference. push goes through
        ; ranger_ptrarray_push_owned, which already retains; set did not.
        if (this.isObjectTypeName((this.arrayElemTypeName(arrNode lctx)))) {
          this.emitObjRetainPtr(storeVal lctx)
        }
      }
    }
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    push args idx
    push argTypes "i32"
    push args storeVal
    push argTypes lctx.ptrType
    def voidType:string "void"
    lctx.builder.emitCall("RtPtrArray_set" voidType args argTypes)
  }

  fn emitFieldLoadOn:string (className:string structPtr:string fieldName:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def idx (this.findFieldIndex(className fieldName this.irModule))
    def fieldPtr (builder.emitGep(className structPtr idx))
    def ftype (this.fieldIrTypeFor(className fieldName))
    def raw (builder.emitLoad(ftype fieldPtr))
    if (this.fieldIsStringSlot(className fieldName)) {
      return (builder.emitIntToI8Ptr(raw lctx.ptrType))
    }
    if (this.fieldIsBoolSlot(className fieldName)) {
      def zero (builder.emitConst("i32" "0"))
      return (builder.emitIcmp("ne" raw zero))
    }
    return raw
  }

  fn emitReleaseFieldValue:void (className:string fieldName:string rawVal:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def voidType:string "void"
    def args:[string]
    def argTypes:[string]
    ; string fields carry a dup'd private copy on both the libc (memEnabled) and
    ; freestanding-WASM (wasmStrEnabled) paths, so both release it on overwrite.
    if (this.fieldIsStringSlot(className fieldName)) {
      if ((this.memEnabled(lctx)) || (this.wasmStrEnabled(lctx))) {
        def i8p (builder.emitIntToI8Ptr(rawVal lctx.ptrType))
        push args i8p
        push argTypes "i8*"
        builder.emitCall("ranger_str_release" voidType args argTypes)
      }
      return
    }
    ; remaining field kinds (buffer) are libc-only
    if (this.memEnabled(lctx) == false) {
      return
    }
    if (this.fieldIsBufferSlot(className fieldName)) {
      push args rawVal
      push argTypes lctx.ptrType
      builder.emitCall("ranger_buffer_release" voidType args argTypes)
      return
    }
    ; Object and ptr-array fields hold COUNTED references (emitFieldStoreOnEx
    ; retains on store), so overwriting one drops its reference. Treating them
    ; as pure borrows meant nothing a field pointed at was ever released --
    ; 798554 objects allocated and 2 freed in one benchmark loop.
    if (this.fieldIsPtrArraySlot(className fieldName)) {
      push args rawVal
      push argTypes lctx.ptrType
      builder.emitCall("ranger_ptrarray_release" voidType args argTypes)
      return
    }
    if (this.fieldIsIntMapSlot(className fieldName)) {
      if (this.memEnabled(lctx)) {
        this.ensureIMapExterns()
        def imArgs:[string]
        def imTypes:[string]
        push imArgs rawVal
        push imTypes "i64"
        def voidIM:string "void"
        builder.emitCall("RtIMap_free" voidIM imArgs imTypes)
      }
      return
    }
    if (this.fieldIsStringMapSlot(className fieldName)) {
      push args rawVal
      push argTypes lctx.ptrType
      this.ensureSMapExterns()
      builder.emitCall("RtSMap_free" voidType args argTypes)
      return
    }
    if (this.fieldIsObjectSlot(className fieldName)) {
      this.emitObjReleasePtr(rawVal lctx)
    }
  }

  ; An expression that already carries a reference the caller owns: a call
  ; result, a `new`, or an operator that BUILDS a fresh collection. Everything
  ; else names something someone else still owns.
  fn exprCarriesFreshRef:boolean (node:CodeNode lctx:LowIRLowerContext) {
    def n (this.unwrapInfixExpr(node))
    if n.hasNewOper {
      return true
    }
    if ((n.has_call || n.is_direct_method_call) || n.hasFnCall) {
      return true
    }
    if n.has_operator {
      def op (n.getOperator())
      if (op == "keys") { return true }
      if (op == "strsplit") { return true }
      if (op == "make") { return true }
    }
    return false
  }

  ; A VRef naming a ptr-array the current scope does NOT own: a field, a
  ; parameter, or any array slot not registered as an owned local.
  fn exprIsBorrowedPtrArrayRef:boolean (node:CodeNode lctx:LowIRLowerContext) {
    def vr:string node.vref
    if ((indexOf vr ".") >= 0) {
      def parts:[string] (strsplit vr ".")
      if ((array_length parts) >= 2) {
        def n:int (array_length parts)
        def recvPrefix:string (this.joinDotPrefix(parts (n - 1)))
        def fld (itemAt parts (n - 1))
        def cls (this.resolveObjectClassChain(recvPrefix lctx))
        if ((strlen cls) > 0) {
          return (this.fieldIsPtrArraySlot(cls fld))
        }
      }
      return false
    }
    if (this.resolvesToField(vr lctx)) {
      return (this.fieldIsPtrArraySlot(lctx.className vr))
    }
    if ((this.collectionKind(vr lctx)) != "ptr_array") {
      return false
    }
    for lctx.ownedCollectionLocals own:string i {
      if (own == vr) {
        return false
      }
    }
    return true
  }

  ; `def b:[T] a` names the SAME array as `a`: the new local is a second owner
  ; and releases it at scope end, so the count has to grow. Only an alias needs
  ; this -- a fresh array (a call result, `keys`, `strsplit`) already arrives
  ; with the caller's reference.
  fn retainAliasedArray:void (valNode:CodeNode desc:string lctx:LowIRLowerContext) {
    if ((this.memEnabled(lctx)) == false) {
      return
    }
    if (valNode.value_type == RangerNodeType.VRef) {
      this.emitPtrArrayRetain(desc lctx)
      return
    }
    ; Reading an array OUT of a collection is an alias too -- the map or the
    ; array it came from still holds it. `def gs:[string] (unwrap (get m k))`
    ; bound an owned local with no matching retain, so the scope-end release
    ; freed an array the map was still pointing at.
    if (this.isBorrowedArrayExpr(valNode)) {
      this.emitPtrArrayRetain(desc lctx)
    }
  }

  ; An expression that hands back an array somebody ELSE owns: a read out of a
  ; map or an array, or the same read behind an `unwrap`. A call result is not
  ; one of these -- it arrives with the caller's own reference, and retaining it
  ; would leak.
  fn isBorrowedArrayExpr:boolean (valNode:CodeNode) {
    if ((array_length valNode.children) == 0) {
      return false
    }
    def head:CodeNode (valNode.getFirst())
    if (head.vref == "unwrap") {
      if ((array_length valNode.children) > 1) {
        return (this.isBorrowedArrayExpr((valNode.getSecond())))
      }
      return false
    }
    if (head.vref == "get") {
      return true
    }
    if (head.vref == "itemAt") {
      return true
    }
    if (head.vref == "at") {
      return true
    }
    return false
  }

  ; Bump a string map's refcount: the value gains another owner.
  fn emitSMapRetain:void (desc:string lctx:LowIRLowerContext) {
    def relParams:[string]
    push relParams lctx.ptrType
    this.ensureExternDecl("RtSMap_retain" "void" relParams false)
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    lctx.builder.emitCall("RtSMap_retain" "void" args argTypes)
  }

  ; Bump a ptr-array descriptor's refcount: the value gains another owner.
  fn emitPtrArrayRetain:void (desc:string lctx:LowIRLowerContext) {
    def relParams:[string]
    push relParams lctx.ptrType
    this.ensureExternDecl("ranger_ptrarray_retain" "void" relParams false)
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    lctx.builder.emitCall("ranger_ptrarray_retain" "void" args argTypes)
  }

  fn emitFieldStoreOn:void (className:string structPtr:string fieldName:string value:string lctx:LowIRLowerContext) {
    this.emitFieldStoreOnEx(className structPtr fieldName value false lctx)
  }

  ; srcIsFresh: the value is a freshly-constructed object (rc=1, sole owner) that
  ; the field takes over by MOVE (no retain). A borrowed value (local/param/field)
  ; is RETAINED so the field holds a counted reference — RC then frees it exactly
  ; once regardless of how many fields alias it (cycles still leak, never crash).
  fn emitFieldStoreOnEx:void (className:string structPtr:string fieldName:string value:string srcIsFresh:boolean lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def idx (this.findFieldIndex(className fieldName this.irModule))
    def fieldPtr (builder.emitGep(className structPtr idx))
    def ftype (this.fieldIrTypeFor(className fieldName))
    def isWasmObjField:boolean false
    if (this.objRcEnabled(lctx)) {
      if (this.memEnabled(lctx) == false) {
        if (this.fieldIsObjectSlot(className fieldName)) {
          isWasmObjField = true
        }
      }
    }
    if (this.memEnabled(lctx)) {
      ; Array and object fields hold COUNTED references. Retain before
      ; releasing the old value: storing a value over itself would otherwise
      ; free it. A freshly-constructed `new T` arrives with the only reference
      ; and is moved in, so it is not retained.
      if (this.fieldIsPtrArraySlot(className fieldName)) {
        if (srcIsFresh == false) {
          this.emitPtrArrayRetain(value lctx)
        }
      }
      if (this.fieldIsStringMapSlot(className fieldName)) {
        if (srcIsFresh == false) {
          this.emitSMapRetain(value lctx)
        }
      }
      if (this.fieldIsObjectSlot(className fieldName)) {
        if (srcIsFresh == false) {
          this.emitObjRetainPtr(value lctx)
        }
      }
      def oldRaw (builder.emitLoad(ftype fieldPtr))
      this.emitReleaseFieldValue(className fieldName oldRaw lctx)
    } {
      ; freestanding WASM RC: release the old value this field held before
      ; overwriting it (string field: str_release its dup'd copy; object field:
      ; obj_release its retained/owned reference). Field is zero-initialised by
      ; obj_new, so the first store sees 0 and the release is a no-op.
      if (this.wasmStrEnabled(lctx)) {
        if (this.fieldIsStringSlot(className fieldName)) {
          def oldRawW (builder.emitLoad(ftype fieldPtr))
          this.emitReleaseFieldValue(className fieldName oldRawW lctx)
        }
      }
      if isWasmObjField {
        def oldObj (builder.emitLoad(ftype fieldPtr))
        this.emitObjReleasePtr(oldObj lctx)
      }
    }
    def storeVal:string value
    if (this.fieldIsStringSlot(className fieldName)) {
      def owned (this.emitStrdupExpr(value lctx))
      storeVal = (builder.emitPtrToInt(owned))
    } {
      if (this.fieldIsBoolSlot(className fieldName)) {
        storeVal = (builder.emitZextI1ToI32(value))
      } {
        ; Object field on WASM: retain a borrowed reference (a fresh `new` is
        ; moved in as-is). libc keeps borrow semantics (no retain).
        if isWasmObjField {
          if (srcIsFresh == false) {
            this.emitObjRetainPtr(value lctx)
          }
        }
        storeVal = value
      }
    }
    builder.emitStore(ftype storeVal fieldPtr)
  }

  fn emitObjRetainPtr:void (ptr:string lctx:LowIRLowerContext) {
    def args:[string]
    def argTypes:[string]
    push args ptr
    push argTypes lctx.ptrType
    lctx.builder.emitCall("ranger_obj_retain" "void" args argTypes)
  }

  fn emitObjReleasePtr:void (ptr:string lctx:LowIRLowerContext) {
    def args:[string]
    def argTypes:[string]
    push args ptr
    push argTypes lctx.ptrType
    lctx.builder.emitCall("ranger_obj_release" "void" args argTypes)
  }

  fn emitFieldLoad:string (fieldName:string lctx:LowIRLowerContext) {
    return (this.emitFieldLoadOn(lctx.className lctx.selfPtr fieldName lctx))
  }

  fn emitFieldStore:void (fieldName:string value:string lctx:LowIRLowerContext) {
    this.emitFieldStoreOn(lctx.className lctx.selfPtr fieldName value lctx)
  }

  ; The object class of an object-typed field on the given class, or "".
  fn fieldObjectClassName:string (className:string fieldName:string lctx:LowIRLowerContext) {
    def appCtx (unwrap lctx.ctx)
    if (false == (has appCtx.definedClasses className)) {
      return ""
    }
    def cl (unwrap (get appCtx.definedClasses className))
    ; INHERITED fields too: `cl.node.children` walks through RangerAppClassDesc's
    ; `node`, which is declared on the base class. Without this the chain
    ; resolved to nothing and the array read emitted a bare `%cl.node.children`.
    def allVars (this.collectStructVars(cl appCtx))
    for allVars v:RangerAppParamDesc i {
      if (v.name == fieldName) {
        if (null? v.nameNode) {
          return ""
        }
        def nn (unwrap v.nameNode)
        def tn:string nn.type_name
        if ((strlen tn) > 0) {
          if (has appCtx.definedClasses tn) {
            return tn
          }
        }
        return ""
      }
    }
    return ""
  }

  fn resolveObjectPtr:string (varName:string className:string lctx:LowIRLowerContext) {
    if (varName == "this") {
      return lctx.selfPtr
    }
    if (has lctx.slots varName) {
      def addr (this.loadSlot(varName lctx.ptrType lctx))
      return (lctx.builder.emitIntToStructPtr(className addr))
    }
    ; A field of the current class used as a receiver (e.g. this.currentChunk.next):
    ; load the field's object pointer from self, then reinterpret as the struct.
    if (this.resolvesToField(varName lctx)) {
      def raw (this.emitFieldLoad(varName lctx))
      return (lctx.builder.emitIntToStructPtr(className raw))
    }
    def addr (this.loadSlot(varName lctx.ptrType lctx))
    return (lctx.builder.emitIntToStructPtr(className addr))
  }

  fn joinDotPrefix:string (parts:[string] count:int) {
    def out:string ""
    def i:int 0
    while (i < count) {
      if (i > 0) {
        out = (out + ".")
      }
      out = (out + (itemAt parts i))
      i = i + 1
    }
    return out
  }

  ; Resolve the object class of a (possibly dotted) receiver chain, e.g.
  ; "huffman.dcTable0" -> HuffmanTable.
  fn resolveObjectClassChain:string (varName:string lctx:LowIRLowerContext) {
    if ((indexOf varName ".") < 0) {
      return (this.resolveObjectClass(varName lctx))
    }
    def parts:[string] (strsplit varName ".")
    def n:int (array_length parts)
    def cls (this.resolveObjectClass((itemAt parts 0) lctx))
    def i:int 1
    while (i < n) {
      if ((strlen cls) == 0) {
        return ""
      }
      cls = (this.fieldObjectClassName(cls (itemAt parts i) lctx))
      i = i + 1
    }
    return cls
  }

  ; Resolve the runtime struct pointer for a (possibly dotted) receiver chain.
  fn resolveObjectPtrChain:string (varName:string className:string lctx:LowIRLowerContext) {
    if ((indexOf varName ".") < 0) {
      return (this.resolveObjectPtr(varName className lctx))
    }
    def parts:[string] (strsplit varName ".")
    def n:int (array_length parts)
    def cls (this.resolveObjectClass((itemAt parts 0) lctx))
    def ptr (this.resolveObjectPtr((itemAt parts 0) cls lctx))
    def i:int 1
    while (i < n) {
      def fld:string (itemAt parts i)
      def fcls (this.fieldObjectClassName(cls fld lctx))
      def raw (this.emitFieldLoadOn(cls ptr fld lctx))
      ptr = (lctx.builder.emitIntToStructPtr(fcls raw))
      cls = fcls
      i = i + 1
    }
    return ptr
  }

  fn resolveObjectClass:string (varName:string lctx:LowIRLowerContext) {
    if (varName == "this") {
      return lctx.className
    }
    if (has lctx.objectSlots varName) {
      return (unwrap (get lctx.objectSlots varName))
    }
    if (this.resolvesToField(varName lctx)) {
      def fc (this.fieldObjectClassName(lctx.className varName lctx))
      if ((strlen fc) > 0) {
        return fc
      }
    }
    return ""
  }

  fn resolveFieldPtrExpr:string (vref:string lctx:LowIRLowerContext) {
    def dotPos:int (indexOf vref ".")
    if (dotPos < 0) {
      return ""
    }
    def parts:[string] (strsplit vref ".")
    if ((array_length parts) < 2) {
      return ""
    }
    def recv (itemAt parts 0)
    def fld (itemAt parts 1)
    def cls (this.resolveObjectClass(recv lctx))
    if ((strlen cls) == 0) {
      return ""
    }
    def sptr (this.resolveObjectPtr(recv cls lctx))
    def builder (lctx.builder)
    def idx (this.findFieldIndex(cls fld this.irModule))
    return (builder.emitGep(cls sptr idx))
  }

  fn isObjectArrayField:boolean (v:RangerAppParamDesc) {
    if (null? v.nameNode) {
      return false
    }
    def nn (unwrap v.nameNode)
    if (LowIRUtil.isArrayTypeName(nn.type_name)) {
      return true
    }
    if (nn.value_type == RangerNodeType.Array) {
      if ((strlen nn.array_type) > 0) {
        if (nn.array_type != "int") {
          return true
        }
      }
    }
    return false
  }

  ; Resolve the class name a (new X(...)) expression constructs. clDesc is set by
  ; flow analysis for in-body expressions, but field-default value nodes are not
  ; always flow-analyzed, so fall back to the class name vref (child 1) when the
  ; name resolves to a defined class.
  fn newTargetClassName:string (node:CodeNode lctx:LowIRLowerContext) {
    if (!null? node.clDesc) {
      def cl (unwrap node.clDesc)
      return cl.name
    }
    if ((array_length node.children) < 2) {
      return ""
    }
    def appCtx (unwrap lctx.ctx)
    def sec (node.getSecond())
    def nm:string sec.vref
    if ((strlen nm) > 0) {
      if (has appCtx.definedClasses nm) {
        return nm
      }
    }
    ; Fall back to the node's resolved type (e.g. when `new` appears as a call
    ; argument and its class-name child is not a plain vref).
    def tn:string node.eval_type_name
    if ((strlen tn) > 0) {
      if (has appCtx.definedClasses tn) {
        return tn
      }
    }
    def tn2:string node.type_name
    if ((strlen tn2) > 0) {
      if (has appCtx.definedClasses tn2) {
        return tn2
      }
    }
    return ""
  }

  fn emitFieldDefault:void (className:string objPtr:string fieldName:string valNode:CodeNode lctx:LowIRLowerContext) {
    if valNode.hasNewOper {
      def clsName (this.newTargetClassName(valNode lctx))
      if ((strlen clsName) == 0) {
        ; A synthesized default-construct for an uninitialized object field
        ; (e.g. `def huffman:HuffmanDecoder`) carries no class info on the node;
        ; fall back to the field's declared object type.
        clsName = (this.fieldObjectClassName(className fieldName lctx))
      }
      if ((strlen clsName) > 0) {
        def newPtr (this.lowerNewObject(clsName (valNode.getThird()) lctx))
        ; the default `(new T)` is a fresh sole-owner object -> move into the field
        this.emitFieldStoreOnEx(className objPtr fieldName newPtr true lctx)
        return
      }
    }
    def tmp (this.lowerExpr(valNode lctx))
    this.emitFieldStoreOn(className objPtr fieldName tmp lctx)
  }

  fn initFieldDefaultsInObject:void (className:string objPtr:string lctx:LowIRLowerContext) {
    def appCtx (unwrap lctx.ctx)
    if (false == (has appCtx.definedClasses className)) {
      return
    }
    def cl (unwrap (get appCtx.definedClasses className))
    ; Inherited fields need their defaults too, or a base-class field starts as
    ; whatever the allocator left there.
    def allVars (this.collectStructVars(cl appCtx))
    for allVars v:RangerAppParamDesc i {
      if (this.isObjectArrayField(v)) {
        continue
      }
      if (null? v.def_value) {
        continue
      }
      if ((v.has_default == false) && (v.init_cnt == 0)) {
        continue
      }
      this.emitFieldDefault(className objPtr v.name (unwrap v.def_value) lctx)
    }
  }

  fn initFieldDefaultsInConstructor:void (className:string lctx:LowIRLowerContext) {
    this.initFieldDefaultsInObject(className lctx.selfPtr lctx)
  }

  fn initArrayFieldsInObject:void (className:string objPtr:string lctx:LowIRLowerContext) {
    for this.irModule.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      for st.fields f:LowIRField i {
        if f.isStringMap {
          def smVal:string (this.fieldArrayElemType(className f.name lctx))
          def sm (this.emitSMapNewKind((this.smapValueOwnKind(smVal)) lctx))
          this.emitFieldStoreOnEx(className objPtr f.name sm true lctx)
          continue
        }
        ; An int-keyed reference map field needs the same constructor
        ; allocation; without it every put wrote into a null map.
        if f.isIntMap {
          this.ensureIMapExterns()
          def imVal:string (this.fieldArrayElemType(className f.name lctx))
          def imArgs:[string]
          def imTypes:[string]
          push imArgs (lctx.builder.emitConst("i32" (to_string (this.imapValueOwnKind(imVal)))))
          push imTypes "i32"
          def im (lctx.builder.emitCall("RtIMap_new_kind" "i64" imArgs imTypes))
          this.emitFieldStoreOnEx(className objPtr f.name im true lctx)
          continue
        }
        if (f.isPtrArray == false) {
          continue
        }
        def cap (lctx.builder.emitConst("i32" "4"))
        def args:[string]
        def argTypes:[string]
        push args cap
        push argTypes "i32"
        this.usedPtrArrayRuntime = true
        def desc (lctx.builder.emitCall("RtPtrArray_new" lctx.ptrType args argTypes))
        ; The flag word is the element KIND (0 plain / 1 object / 2 string).
        ; Hardcoding 1 made a [string] field array release each element as an
        ; object, reading memory before a plain malloc'd buffer.
        def fElem:string (this.fieldArrayElemType(className f.name lctx))
        def kindLit:string "1"
        if (LowIRUtil.isStringType(fElem)) {
          kindLit = "2"
        }
        if (fElem == "int") {
          kindLit = "0"
        }
        if ((fElem == "double") || (fElem == "float")) {
          kindLit = "0"
        }
        if (fElem == "boolean") {
          kindLit = "0"
        }
        def one (lctx.builder.emitConst("i32" kindLit))
        lctx.builder.emitStoreI32At(desc (this.ptrArrayOwnedOff(lctx)) one)
        ; freshly constructed: the field takes over its single reference
        this.emitFieldStoreOnEx(className objPtr f.name desc true lctx)
      }
    }
  }

  fn initArrayFieldsInConstructor:void (className:string lctx:LowIRLowerContext) {
    this.initArrayFieldsInObject(className lctx.selfPtr lctx)
  }

  fn structByteSize:int (className:string module:LowIRModule) {
    for module.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      def size:int 0
      for st.fields f:LowIRField i {
        def fsize:int 4
        def falign:int 4
        if (f.irType != "i32") {
          fsize = 8
          falign = 8
        }
        def rem:int (size % falign)
        if (rem != 0) {
          size = size + (falign - rem)
        }
        size = size + fsize
      }
      def remEnd:int (size % 8)
      if (remEnd != 0) {
        size = size + (8 - remEnd)
      }
      return size
    }
    return 0
  }

  ; True when the class has at least one owned field (a string field today;
  ; object/ptr-array fields are borrow until borrow analysis promotes them), so
  ; its objects need a type descriptor for recursive destruction on WASM.
  fn classHasOwnedFields:boolean (className:string) {
    for this.irModule.typeDescs td:LowIRTypeDesc i {
      if (td.className == className) {
        for td.fields fd:LowIRTypeFieldDesc j {
          if (fd.owned == 1) {
            return true
          }
          ; WASM retains object fields (kind 1), so they are freed on destruction
          ; too — the class needs a descriptor even if only object fields are owned.
          if this.irModule.useFreeListHeap {
            if (fd.kind == 1) {
              return true
            }
          }
        }
      }
    }
    return false
  }

  ; The argument list of a `new`. `hasNewOper` is set on the enclosing node as
  ; well as on the `new` expression itself, so a caller's `node.getThird()` can
  ; hand back the WHOLE `(new Class (args))` rather than its argument list --
  ; which it does for a dotted class name such as a shape's `new Val.Num(42)`.
  ; Taking the third child of that is the argument list either way.
  fn newArgListOf:CodeNode (argsNode:CodeNode) {
    if ((array_length argsNode.children) > 2) {
      def head:CodeNode (argsNode.getFirst())
      if (head.vref == "new") {
        return (argsNode.getThird())
      }
    }
    return argsNode
  }

  fn lowerNewObject:string (className:string argsNodeIn:CodeNode lctx:LowIRLowerContext) {
    def argsNode:CodeNode (this.newArgListOf(argsNodeIn))
    def builder (lctx.builder)
    def byteCnt (this.structByteSize(className this.irModule))
    if (byteCnt == 0) {
      def fieldCnt (this.structFieldCount(className this.irModule))
      byteCnt = fieldCnt * 4
      if (lctx.ptrType == "i64") {
        byteCnt = fieldCnt * 8
      }
    }
    def bytes (builder.emitConst("i32" ("" + byteCnt)))
    def heapAddr:string ""
    def memTarget (LowIRTarget.resolve((unwrap lctx.ctx)))
    if (memTarget.usesLibc) {
      this.usedMemRuntime = true
      this.ensureMemExtern(memTarget)
      def dtorArg:string ""
      dtorArg = ("ptr @" + className + "_typeDesc")
      def newArgs:[string]
      def newArgTypes:[string]
      push newArgs bytes
      push newArgTypes "i32"
      push newArgs dtorArg
      push newArgTypes ""
      def newSig:string ("i32, ptr")
      heapAddr = (builder.emitCallWithSig("ranger_obj_new" lctx.ptrType newSig newArgs newArgTypes))
    } {
      if (this.objRcEnabled(lctx)) {
        ; WASM free-list RC: ranger_obj_new(size, typeDesc). typeDesc points at
        ; the class descriptor in the static data segment when the class has
        ; owned (string) fields, so obj_release -> destroyFields frees them; 0
        ; otherwise (nothing to recurse). The runtime prepends the rc/size/type
        ; header and returns the body pointer.
        def tdArg:string ""
        if (this.classHasOwnedFields(className)) {
          tdArg = (builder.emitTypeDescPtr(className))
        } {
          tdArg = (builder.emitConst("i32" "0"))
        }
        def wArgs:[string]
        def wArgTypes:[string]
        push wArgs bytes
        push wArgTypes "i32"
        push wArgs tdArg
        push wArgTypes "i32"
        heapAddr = (builder.emitCall("ranger_obj_new" lctx.ptrType wArgs wArgTypes))
      } {
        heapAddr = (builder.emitHeapAlloc(bytes))
      }
    }
    def objSlot (builder.emitIntToStructPtr(className heapAddr))
    this.initFieldDefaultsInObject(className objSlot lctx)
    def ctorDesc@(optional):RangerAppFunctionDesc
    if (!null? lctx.ctx) {
      def appCtx (unwrap lctx.ctx)
      if (has appCtx.definedClasses className) {
        def cl (unwrap (get appCtx.definedClasses className))
        if cl.has_constructor {
          if (!null? cl.constructor_fn) {
            ctorDesc = (unwrap cl.constructor_fn)
          }
        }
        ; ...but only when the class really HAS one. RangerFlowParser has an
        ; ordinary method named `Constructor` (its handler for the keyword),
        ; and taking that for a constructor made `new RangerFlowParser()` call
        ; a four-parameter function with one argument.
        if (null? ctorDesc) {
          if cl.has_constructor {
            for cl.methods m:RangerAppFunctionDesc i {
              if (m.name == "Constructor") {
                ctorDesc = m
              }
            }
          }
        }
      }
    }
    if (!null? ctorDesc) {
      def ctorName (LowIRUtil.mangleMethod(className "Constructor"))
      def args:[string]
      def argTypes:[string]
      push args objSlot
      push argTypes (LowIRUtil.structPtrType(className))
      ; Walk the PARAMETERS and index the arguments, the way the C++ writer
      ; does: the front end expands a record constructor call to one argument
      ; per parameter, keyword markers included, and the signature drops those.
      ; The front end expands a record constructor call to one argument per
      ; parameter and flags the arguments that stand where a keyword marker
      ; does (cmdNew). Those carry no value and the signature drops them, so
      ; the call must drop them too. A shape's generated case marks the
      ; ARGUMENT without marking the parameter, so both sides are asked.
      def ctorFnDesc:RangerAppFunctionDesc (unwrap ctorDesc)
      def paramCnt:int (array_length ctorFnDesc.params)
      def argIdx:int 0
      for argsNode.children arg:CodeNode i {
        def isMarker:boolean (arg.hasFlag("keyword"))
        if (argIdx < paramCnt) {
          if (this.isKeywordMarkerParam((itemAt ctorFnDesc.params argIdx))) {
            isMarker = true
          }
        }
        if (isMarker == false) {
          push args (this.lowerExpr(arg lctx))
          push argTypes (this.paramIrTypeFromDesc(argIdx ctorFnDesc lctx))
        }
        argIdx = argIdx + 1
      }
      def voidType:string "void"
      builder.emitCall(ctorName voidType args argTypes)
    } {
      this.initArrayFieldsInObject(className objSlot lctx)
    }
    return heapAddr
  }

  fn findFieldIndex:int (className:string fieldName:string module:LowIRModule) {
    for module.structs st:LowIRStruct i {
      if (st.name != className) {
        continue
      }
      def fi:int 0
      for st.fields f:LowIRField i {
        if (f.name == fieldName) {
          return fi
        }
        fi = fi + 1
      }
    }
    return -1
  }

  ; Does a BARE name refer to a field of the current class? Only when nothing
  ; in scope binds it: a local or a parameter SHADOWS a field of the same name,
  ; which is what every other target does. This backend asked about the field
  ; first, so RangerAppClassDesc's `hasDuplicateMethodSignature(fnDesc: …)` read
  ; the class's own inherited `fnDesc` field instead of its argument -- an
  ; overloaded method anywhere in a program crashed the compiler.
  fn resolvesToField:boolean (fieldName:string lctx:LowIRLowerContext) {
    if (has lctx.slots fieldName) {
      return false
    }
    return (this.isClassField(fieldName lctx.className this.irModule))
  }

  ; Is this the class's CONSTRUCTOR, or merely a method that happens to be
  ; called `Constructor`? RangerFlowParser has the latter -- its handler for the
  ; `constructor` keyword -- and the name alone was the whole test, so the
  ; class's field-default initialisation was injected into that handler. Calling
  ; it reset every field of the live parser: `walkAlso` lost the generated
  ; @serialize extensions before StartWalk could walk them, which left every
  ; generated method with no fnCtx and crashed the writer on it.
  ;
  ; The module-level loop already gets this right -- it emits `Constructor` from
  ; cl.methods only when the class has no real constructor -- so a class whose
  ; has_constructor is set can only reach here with the genuine one.
  fn isRealConstructor:boolean (fnDesc:RangerAppFunctionDesc className:string appCtx:RangerAppWriterContext) {
    if (fnDesc.name != "Constructor") {
      return false
    }
    if ((has appCtx.definedClasses className) == false) {
      return false
    }
    def cl (unwrap (get appCtx.definedClasses className))
    return cl.has_constructor
  }

  fn isClassField:boolean (fieldName:string className:string module:LowIRModule) {
    if ((strlen className) == 0) {
      return false
    }
    return (this.findFieldIndex(className fieldName module) >= 0)
  }

  fn structFieldCount:int (className:string module:LowIRModule) {
    for module.structs st:LowIRStruct i {
      if (st.name == className) {
        return (array_length st.fields)
      }
    }
    return 0
  }

  fn lowerFunction:void (fnDesc:RangerAppFunctionDesc className:string appCtx:RangerAppWriterContext exportFn:boolean isMain:boolean isInstance:boolean) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(this.irModule))
    builder.reset()
    def lctx@(lives):LowIRLowerContext (new LowIRLowerContext())
    lctx.ctx = appCtx
    lctx.builder = builder
    lctx.target = (LowIRTarget.resolve(appCtx))
    lctx.ptrType = lctx.target.ptrType
    def emptySlots:[string:string]
    lctx.slots = emptySlots
    def emptySlotTypes:[string:string]
    lctx.slotTypes = emptySlotTypes
    def emptyObjects:[string:string]
    lctx.objectSlots = emptyObjects
    def emptyCollections:[string:string]
    lctx.collectionSlots = emptyCollections
    def emptyElemTypes:[string:string]
    lctx.ptrArrayElemTypes = emptyElemTypes
    def emptyOwned:[string]
    def emptyParamNames:[string]
    lctx.paramNames = emptyParamNames
    def emptyCaptured:[string]
    lctx.capturedNames = emptyCaptured
    lctx.ownedObjectLocals = emptyOwned
    def emptyColl:[string]
    lctx.ownedCollectionLocals = emptyColl
    def emptyStr:[string]
    lctx.ownedStringLocals = emptyStr
    def emptyPending:[string]
    lctx.pendingStringTemps = emptyPending
    def emptyObjPending:[string]
    lctx.pendingObjectTemps = emptyObjPending
    def emptyBoxCand:[string:int]
    lctx.boxedCandidates = emptyBoxCand
    def emptyBoxed:[string:int]
    lctx.boxedLocals = emptyBoxed
    def emptyEscaped:[string:string]
    lctx.escapedLocals = emptyEscaped
    if isInstance {
      lctx.className = className
      lctx.selfPtr = "%self"
    }

    def voidType:string "void"
    if (fnDesc.name == "Constructor") {
      lctx.currentRetType = voidType
      lctx.llvmRetType = voidType
    } {
      def retNode (unwrap fnDesc.nameNode)
      def retTypeName (this.varTypeName(retNode))
      lctx.currentRetType = retTypeName
      lctx.llvmRetType = (this.llvmTypeForRanger(retTypeName lctx.ptrType))
    }
    if isMain {
      lctx.llvmRetType = "i32"
    }
    if (isMain && (lctx.currentRetType == voidType)) {
      lctx.llvmRetType = "i32"
    }

    def params:[LowIRParam]
    if isInstance {
      def selfParam@(lives):LowIRParam (new LowIRParam())
      selfParam.name = "self"
      selfParam.irType = (LowIRUtil.structPtrType(className))
      push params selfParam
    }
    if isMain {
      def argcParam@(lives):LowIRParam (new LowIRParam())
      argcParam.name = "argc"
      argcParam.irType = "i32"
      push params argcParam
      def argvParam@(lives):LowIRParam (new LowIRParam())
      argvParam.name = "argv"
      argvParam.irType = "i8**"
      push params argvParam
    }
    for fnDesc.params p:RangerAppParamDesc i {
      ; a record constructor's keyword marker is not a real parameter
      if (this.isKeywordMarkerParam(p)) {
        continue
      }
      def lp@(lives):LowIRParam (new LowIRParam())
      lp.name = p.compiledName
      if ((strlen lp.name) == 0) {
        lp.name = p.name
      }
      def pn (unwrap p.nameNode)
      def paramTypeName (this.varTypeName(pn))
      lp.irType = (this.llvmTypeForRanger(paramTypeName lctx.ptrType))
      if (this.isLambdaTypeNode(pn)) {
        lp.irType = lctx.ptrType
      }
      push params lp
    }

    def fnName:string (LowIRUtil.mangleMethod(className fnDesc.name))
    if isMain {
      fnName = "main"
      ; A process gets 8MB of stack, and a recursive-descent walk over a real
      ; program -- which is what this language is for -- overflows it, dying
      ; with no diagnostic at all. A thread's stack size is ours to choose, so
      ; on a libc target the body moves off the entry point and the shim in
      ; writeBigStackMain runs it on a thread that has room. This is what the
      ; Rust target already does; freestanding WASM has no threads and keeps
      ; the plain entry point.
      if this.irModule.useLibcHeap {
        fnName = "__rg_main_body"
        this.irModule.bigStackMain = true
      }
    }
    if ((strlen fnName) == 0) {
      fnName = fnDesc.compiledName
    }
    if ((strlen fnName) == 0) {
      fnName = fnDesc.name
    }

    def entryLabel:string "entry"
    builder.startBlock(entryLabel)

    if isMain {
      ; The declaration lives with the CALL, not only in ensureLibcExtern: that
      ; runs for libc targets, while this call is emitted for every @main. On a
      ; freestanding target the module called an undeclared @ranger_cli_init,
      ; which clang rejects when it parses the module -- linking the C runtime
      ; cannot help, because the IR is invalid before any linking happens.
      def cliDeclParams:[string]
      push cliDeclParams "i32"
      push cliDeclParams "i8**"
      this.ensureExternDecl("ranger_cli_init" "void" cliDeclParams false)
      def cliArgs:[string]
      def cliArgTypes:[string]
      push cliArgs "%argc"
      push cliArgTypes "i32"
      push cliArgs "%argv"
      push cliArgTypes "i8**"
      builder.emitCall("ranger_cli_init" "void" cliArgs cliArgTypes)
    }

    if isInstance {
      if (this.isRealConstructor(fnDesc className appCtx)) {
        this.initFieldDefaultsInConstructor(className lctx)
        this.initArrayFieldsInConstructor(className lctx)
      }
    }

    for fnDesc.params p:RangerAppParamDesc i {
      if (this.isKeywordMarkerParam(p)) {
        continue
      }
      def lpName:string p.compiledName
      if ((strlen lpName) == 0) {
        lpName = p.name
      }
      def pn (unwrap p.nameNode)
      def paramTypeName (this.varTypeName(pn))
      def pType (this.llvmTypeForRanger(paramTypeName lctx.ptrType))
      if (this.isLambdaTypeNode(pn)) {
        pType = lctx.ptrType
      }
      def paramVal:string ("%" + lpName)
      push lctx.paramNames lpName
      this.bindSlot(p.name pType paramVal lctx)
      ; A MAP parameter also spells its type with a leading "[", so it matched
      ; the array test and was registered as a ptr-array: `has target alias`
      ; then went to the int-keyed RtMap runtime and passed it an i8* key.
      if (this.isStringKeyMapTypeNode(pn)) {
        this.bindCollectionSlot(p.name "smap" paramVal lctx)
        if ((strlen pn.array_type) > 0) {
          set lctx.smapValueTypes p.name pn.array_type
        }
      } {
        if (this.isIntKeyValueMapTypeNode(pn)) {
          this.bindCollectionSlot(p.name "imap" paramVal lctx)
          if ((strlen pn.array_type) > 0) {
            set lctx.imapValueTypes p.name pn.array_type
          }
        } {
          if (LowIRUtil.isArrayTypeName(paramTypeName)) {
            set lctx.collectionSlots p.name "ptr_array"
            if ((strlen pn.array_type) > 0) {
              set lctx.ptrArrayElemTypes p.name pn.array_type
            }
          }
        }
      }
      if (this.isObjectTypeName(paramTypeName)) {
        set lctx.objectSlots p.name paramTypeName
      }
    }

    ; L3: identify value locals mutated by a capturing lambda (boxing candidates)
    this.computeBoxedCandidates(fnDesc lctx)

    if (!null? fnDesc.fnBody) {
      this.lowerBlock((unwrap fnDesc.fnBody) lctx)
    }

    def cur (unwrap builder.currentBlock)
    if (cur.termKind == "") {
      this.emitReleaseOwnedLocals(lctx)
      if isMain {
        if (lctx.currentRetType == voidType) {
          def zero:string "0"
          def retVal (builder.emitConst("i32" zero))
          builder.terminateRet(lctx.llvmRetType retVal)
        }
      }
    }

    builder.finishFunction(fnName lctx.llvmRetType params exportFn isMain)
  }

  ; Generate `ClassName___singleton()` for a @singleton(true) class on the WAT
  ; backend: lazily construct the instance into a mutable wasm global and return
  ; it. Body:  cur = global; if (cur == 0) { obj = new Class(); global = obj;
  ; return obj }  return cur.  Supports no-argument construction (field defaults
  ; + a no-arg Constructor). Blocks are ordered init-before-return so the
  ; structured WAT reconstruction keeps both arms.
  fn lowerSingletonAccessor:void (cl:RangerAppClassDesc appCtx:RangerAppWriterContext) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(this.irModule))
    builder.reset()
    def lctx@(lives):LowIRLowerContext (new LowIRLowerContext())
    lctx.ctx = appCtx
    lctx.builder = builder
    lctx.target = (LowIRTarget.resolve(appCtx))
    lctx.ptrType = lctx.target.ptrType
    def emptySlots:[string:string]
    lctx.slots = emptySlots
    def emptySlotTypes:[string:string]
    lctx.slotTypes = emptySlotTypes
    def emptyObjects:[string:string]
    lctx.objectSlots = emptyObjects
    def emptyCollections:[string:string]
    lctx.collectionSlots = emptyCollections
    def emptyElemTypes:[string:string]
    lctx.ptrArrayElemTypes = emptyElemTypes
    def emptyOwned:[string]
    def emptyParamNames:[string]
    lctx.paramNames = emptyParamNames
    def emptyCaptured:[string]
    lctx.capturedNames = emptyCaptured
    lctx.ownedObjectLocals = emptyOwned
    def emptyColl:[string]
    lctx.ownedCollectionLocals = emptyColl
    def emptyStr:[string]
    lctx.ownedStringLocals = emptyStr
    def emptyPending:[string]
    lctx.pendingStringTemps = emptyPending
    def emptyObjPending:[string]
    lctx.pendingObjectTemps = emptyObjPending
    def emptyBoxCand:[string:int]
    lctx.boxedCandidates = emptyBoxCand
    def emptyBoxed:[string:int]
    lctx.boxedLocals = emptyBoxed
    def emptyEscaped:[string:string]
    lctx.escapedLocals = emptyEscaped
    lctx.currentRetType = cl.name
    lctx.llvmRetType = lctx.ptrType

    push this.irModule.singletonClasses cl.name
    def globalName:string ("singleton_" + cl.name)

    ; empty args node (no-arg constructor) built from the class's own AST node
    def factory@(weak optional):CodeNode
    if (!null? cl.classNode) {
      factory = cl.classNode
    } {
      factory = cl.nameNode
    }
    def argsNode:CodeNode ((unwrap factory).newVRefNode(""))

    def initLabel (builder.freshLabel("sgl_init"))
    def retLabel (builder.freshLabel("sgl_ret"))
    builder.startBlock("entry")
    def cur (builder.emitGlobalGet(globalName))
    def zero (builder.emitConst(lctx.ptrType "0"))
    def isZero (builder.emitIcmpTyped("eq" lctx.ptrType cur zero))
    builder.terminateBrIf(isZero initLabel retLabel)

    ; The global keeps its own reference, so each caller gets a COUNTED one --
    ; on both paths. Without this the first caller to bind the result to a local
    ; released the singleton at scope end and every later use read freed memory.
    builder.startBlock(initLabel)
    def obj (this.lowerNewObject(cl.name argsNode lctx))
    builder.emitGlobalSet(globalName obj)
    if (this.memEnabled(lctx)) {
      this.emitObjRetainPtr(obj lctx)
    }
    builder.terminateRet(lctx.ptrType obj)

    builder.startBlock(retLabel)
    if (this.memEnabled(lctx)) {
      this.emitObjRetainPtr(cur lctx)
    }
    builder.terminateRet(lctx.ptrType cur)

    def fnName (LowIRUtil.mangleMethod(cl.name "__singleton"))
    def params:[LowIRParam]
    builder.finishFunction(fnName lctx.ptrType params false false)
  }

  ; ======================================================================
  ; Lambdas / closures (WAT backend). Each lambda body is hoisted to a
  ; top-level function `lambdaN(%__env, params…)`; the value is a closure record
  ; [ fn_index | captures… ] and a call goes through call_indirect. L0/L1:
  ; non-capturing. Env is threaded for a uniform representation.
  ; ======================================================================
  fn collectLambdas:void (appCtx:RangerAppWriterContext) {
    def target (LowIRTarget.resolve(appCtx))
    def pt (target.ptrType)
    for appCtx.definedClassList cName:string i {
      if (cName == "RangerStaticMethods") {
        continue
      }
      if (false == (has appCtx.definedClasses cName)) {
        continue
      }
      def cl (unwrap (get appCtx.definedClasses cName))
      if (cl.is_trait) {
        continue
      }
      if (cl.is_system || cl.is_union) {
        continue
      }
      ; An OPERATOR class has no fields and no instance methods, but its STATIC
      ; methods ARE emitted (they are what every call to an `operator type:T`
      ; extension resolves to) -- so the lambdas inside them need names and
      ; table slots like any other. Skipping the class here left them nameless:
      ; the closure record got table index 0 and a `__closure__typeDesc`, so the
      ; call jumped to whatever lambda happened to be first in the module.
      if cl.is_operator_class {
        for cl.static_methods om:RangerAppFunctionDesc oj {
          this.collectMethodLambdas(om pt)
        }
        continue
      }
      for cl.static_methods m:RangerAppFunctionDesc j {
        this.collectMethodLambdas(m pt)
      }
      for cl.methods m:RangerAppFunctionDesc j {
        this.collectMethodLambdas(m pt)
      }
      if cl.has_constructor {
        if (!null? cl.constructor_fn) {
          this.collectMethodLambdas((unwrap cl.constructor_fn) pt)
        }
      }
    }
  }

  fn collectMethodLambdas:void (m:RangerAppFunctionDesc pt:string) {
    this.collectMethodLambdasAt(m pt 0)
  }

  ; `depth` is how deeply this lambda is NESTED inside other lambdas, which is
  ; the order its body has to be lowered in (see lowerLambdaBodies).
  fn collectMethodLambdasAt:void (m:RangerAppFunctionDesc pt:string depth:int) {
    if (depth > 12) {
      return
    }
    for m.myLambdas lam:RangerAppFunctionDesc i {
      ; myLambdas is FLAT -- a lambda nested inside another is listed on the
      ; method too -- so the recursion below reaches the same descriptor twice.
      ; Renaming it the second time left the first name pointing at a body that
      ; is lowered but never created, and (worse) the capture layout cached
      ; while lowering that dead copy is the one the live nested lambda then
      ; used: a closure with no captures at all.
      if ((strlen lam.compiledName) > 0) {
        if (has this.lambdaByName lam.compiledName) {
          ; Seen already -- but possibly at a shallower depth, because the flat
          ; list can name an inner lambda before its parent. Keep the deepest
          ; answer, and carry the correction down to anything nested in it.
          def known:int 0
          if (has this.lambdaDepths lam.compiledName) {
            known = (unwrap (get this.lambdaDepths lam.compiledName))
          }
          if (depth > known) {
            set this.lambdaDepths lam.compiledName depth
            this.collectMethodLambdasAt(lam pt (depth + 1))
          }
          continue
        }
      }
      def name:string ("lambda" + ("" + this.lambdaCounter))
      this.lambdaCounter = (this.lambdaCounter + 1)
      lam.compiledName = name
      push this.irModule.lambdaTableFuncs name
      push this.lambdaNames name
      set this.lambdaByName name lam
      set this.lambdaDepths name depth
      def sig (this.lambdaCallSig(lam pt))
      set this.lambdaSigMap name sig
      this.addLambdaSig(sig)
      ; nested lambdas defined inside this lambda's body
      this.collectMethodLambdasAt(lam pt (depth + 1))
    }
  }

  ; call_indirect signature: env(i32) + declared param IR types, then ":ret".
  fn lambdaCallSig:string (lam:RangerAppFunctionDesc pt:string) {
    def sig:string "i32"
    for lam.params p:RangerAppParamDesc i {
      if (!null? p.nameNode) {
        def pn (unwrap p.nameNode)
        def tn (this.varTypeName(pn))
        sig = (sig + ("," + (this.llvmTypeForRanger(tn pt))))
      }
    }
    def ret:string "void"
    if (!null? lam.nameNode) {
      def rn (unwrap lam.nameNode)
      ret = (this.llvmTypeForRanger((this.varTypeName(rn)) pt))
    }
    return (sig + (":" + ret))
  }

  fn addLambdaSig:void (sig:string) {
    for this.irModule.lambdaSigs s:string i {
      if (s == sig) {
        return
      }
    }
    push this.irModule.lambdaSigs sig
  }

  ; OUTERMOST FIRST. A lambda's capture layout is computed where the closure is
  ; CREATED, and a nested lambda is created inside its parent's body -- so the
  ; parent's body has to be lowered first or the child's body is emitted before
  ; anything knows what it captures. The record built later then carried the
  ; captures while the body never read them: the flow parser's
  ; `opParams.parallelTree( xValue { … set regToArg … } )`, nested in an
  ; `opFnList.forEach`, got a null map and a truncated key.
  fn lowerLambdaBodies:void (appCtx:RangerAppWriterContext) {
    def d:int 0
    while (d <= 13) {
      for this.lambdaNames name:string i {
        if ((has this.lambdaByName name) == false) {
          continue
        }
        def nd:int 0
        if (has this.lambdaDepths name) {
          nd = (unwrap (get this.lambdaDepths name))
        }
        if (nd != d) {
          continue
        }
        this.lowerLambdaFunction((unwrap (get this.lambdaByName name)) name appCtx)
      }
      d = d + 1
    }
  }

  fn lowerLambdaFunction:void (lam:RangerAppFunctionDesc fnName:string appCtx:RangerAppWriterContext) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(this.irModule))
    builder.reset()
    def lctx@(lives):LowIRLowerContext (new LowIRLowerContext())
    lctx.ctx = appCtx
    lctx.builder = builder
    lctx.target = (LowIRTarget.resolve(appCtx))
    lctx.ptrType = lctx.target.ptrType
    def emptySlots:[string:string]
    lctx.slots = emptySlots
    def emptySlotTypes:[string:string]
    lctx.slotTypes = emptySlotTypes
    def emptyObjects:[string:string]
    lctx.objectSlots = emptyObjects
    def emptyCollections:[string:string]
    lctx.collectionSlots = emptyCollections
    def emptyElemTypes:[string:string]
    lctx.ptrArrayElemTypes = emptyElemTypes
    def emptyOwned:[string]
    def emptyParamNames:[string]
    lctx.paramNames = emptyParamNames
    def emptyCaptured:[string]
    lctx.capturedNames = emptyCaptured
    lctx.ownedObjectLocals = emptyOwned
    def emptyColl:[string]
    lctx.ownedCollectionLocals = emptyColl
    def emptyStr:[string]
    lctx.ownedStringLocals = emptyStr
    def emptyPending:[string]
    lctx.pendingStringTemps = emptyPending
    def emptyObjPending:[string]
    lctx.pendingObjectTemps = emptyObjPending
    def emptyBoxCand:[string:int]
    lctx.boxedCandidates = emptyBoxCand
    def emptyBoxed:[string:int]
    lctx.boxedLocals = emptyBoxed
    def emptyEscaped:[string:string]
    lctx.escapedLocals = emptyEscaped

    def retTypeName:string "void"
    if (!null? lam.nameNode) {
      retTypeName = (this.varTypeName((unwrap lam.nameNode)))
    }
    lctx.currentRetType = retTypeName
    lctx.llvmRetType = (this.llvmTypeForRanger(retTypeName lctx.ptrType))

    builder.startBlock("entry")

    def params:[LowIRParam]
    def envParam@(lives):LowIRParam (new LowIRParam())
    envParam.name = "__env"
    envParam.irType = lctx.ptrType
    push params envParam
    for lam.params p:RangerAppParamDesc i {
      def lp@(lives):LowIRParam (new LowIRParam())
      lp.name = p.name
      def pn (unwrap p.nameNode)
      def paramTypeName (this.varTypeName(pn))
      lp.irType = (this.llvmTypeForRanger(paramTypeName lctx.ptrType))
      push params lp
      push lctx.paramNames p.name
      this.bindSlot(p.name lp.irType ("%" + p.name) lctx)
      if (this.isObjectTypeName(paramTypeName)) {
        set lctx.objectSlots p.name paramTypeName
      }
    }

    ; L2: snapshot captured variables out of the closure env (%__env) into local
    ; slots at entry. Read-only capture => a one-time copy is correct. Captured
    ; strings/objects are NOT registered as owned locals here: the closure's
    ; typedesc owns them and frees them when the record is released, so the body
    ; must not release them at scope end.
    if (has this.lambdaCaptures fnName) {
      def cinfo@(lives):LambdaCaptureInfo (unwrap (get this.lambdaCaptures fnName))
      def envRef:string "%__env"
      def ci 0
      def cn2 (array_length cinfo.names)
      while (< ci cn2) {
        def capName (itemAt cinfo.names ci)
        def capOff (itemAt cinfo.offsets ci)
        def capIrt (itemAt cinfo.irTypes ci)
        def capKnd (itemAt cinfo.kinds ci)
        def loaded (builder.emitLoadTypedAt(envRef capOff capIrt))
        this.bindSlot(capName capIrt loaded lctx)
        push lctx.capturedNames capName
        ; Restore what KIND of thing the name is, or the body treats a captured
        ; array or map as a plain integer.
        def capColl2:string (itemAt cinfo.collKinds ci)
        if ((strlen capColl2) > 0) {
          set lctx.collectionSlots capName capColl2
        }
        def capElem2:string (itemAt cinfo.elemTypes ci)
        if ((strlen capElem2) > 0) {
          set lctx.ptrArrayElemTypes capName capElem2
        }
        def capSmapVal2:string (itemAt cinfo.smapValTypes ci)
        if ((strlen capSmapVal2) > 0) {
          set lctx.smapValueTypes capName capSmapVal2
        }
        if (capKnd == 2) {
          set lctx.objectSlots capName (itemAt cinfo.objClasses ci)
        }
        if (capKnd == 3) {
          ; boxed value: the slot holds the shared cell pointer; body reads and
          ; writes of capName go through the cell (see lowerVarDef/Assign/Expr).
          ; NOT registered as an owned local — the env owns and frees the cell.
          set lctx.boxedLocals capName 4
        }
        ci = (+ ci 1)
      }
      ; ...and the enclosing receiver, so `this.m()` inside the lambda has
      ; something to call through.
      if cinfo.capturesSelf {
        def selfRaw (builder.emitLoadTypedAt(envRef cinfo.selfOffset lctx.ptrType))
        lctx.selfPtr = (builder.emitIntToStructPtr(cinfo.selfClass selfRaw))
        lctx.className = cinfo.selfClass
      }
    }

    ; nested lambdas inside this lambda body may themselves mutate captures
    this.computeBoxedCandidates(lam lctx)

    if (!null? lam.fnBody) {
      this.lowerBlock((unwrap lam.fnBody) lctx)
    }

    def cur (unwrap builder.currentBlock)
    if (cur.termKind == "") {
      this.emitReleaseOwnedLocals(lctx)
      if (lctx.llvmRetType == "void") {
        builder.terminateRet("void" "")
      } {
        def zero (builder.emitConst("i32" "0"))
        builder.terminateRet(lctx.llvmRetType zero)
      }
    }
    builder.finishFunction(fnName lctx.llvmRetType params false false)
  }

  fn lambdaTableIndex:int (name:string) {
    def idx 0
    for this.irModule.lambdaTableFuncs f:string i {
      if (f == name) {
        return idx
      }
      idx = (+ idx 1)
    }
    return 0
  }

  ; Does this subtree assign to `name`? (an assignment node [= <name> …],
  ; directly or wrapped in an infix "=" node). Used to find which captured
  ; locals a lambda mutates, so they can be boxed (L3).
  fn nodeAssignsToName:boolean (node:CodeNode name:string) {
    if (this.isAssignNode(node)) {
      def lhs (node.getSecond())
      if (lhs.vref == name) {
        return true
      }
    }
    if node.infix_operator {
      if (!null? node.infix_node) {
        def inx (unwrap node.infix_node)
        if (this.isAssignNode(inx)) {
          def lhs2 (inx.getSecond())
          if (lhs2.vref == name) {
            return true
          }
        }
      }
    }
    for node.children c:CodeNode i {
      if (this.nodeAssignsToName(c name)) {
        return true
      }
    }
    return false
  }

  ; Pre-pass over a method: any captured local that some capturing lambda in the
  ; method MUTATES is a boxing candidate (finalised in lowerVarDef once its type
  ; is known to be a value type). Recurses into nested lambdas. WAT-only.
  ; L3 value boxing runs on the native path too. Without it a captured local is
  ; COPIED into the closure, so a lambda that mutates one never writes it back
  ; -- and the flow parser counts a method's `static` prefix that way:
  ;   def idx 0
  ;   node.children.forEach({ if(item.vref == 'static') { idx = idx + 1 } })
  ; With idx stuck at 0 every `static fn` in a class was read one child off, so
  ; the natively built compiler reported "Class X does not have method y" for
  ; every static method there is.
  ; A four-byte reference-counted cell with no typedesc, for a boxed value
  ; local. The two backends spell ranger_obj_new differently: natively the
  ; second parameter is a POINTER (a literal `ptr null` here), on WASM it is a
  ; data-segment offset, which is an i32 there.
  fn emitBoxCell:string (lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def cellTarget (LowIRTarget.resolve((unwrap lctx.ctx)))
    def bytes (builder.emitConst("i32" "4"))
    if cellTarget.usesLibc {
      this.usedMemRuntime = true
      this.ensureMemExtern(cellTarget)
      def la:[string]
      def lat:[string]
      push la bytes
      push lat "i32"
      push la "ptr null"
      push lat ""
      return (builder.emitCallWithSig("ranger_obj_new" lctx.ptrType "i32, ptr" la lat))
    }
    def ca:[string]
    def cat:[string]
    push ca bytes
    push cat "i32"
    push ca (builder.emitConst("i32" "0"))
    push cat "i32"
    return (builder.emitCall("ranger_obj_new" lctx.ptrType ca cat))
  }

  fn computeBoxedCandidates:void (fnDesc:RangerAppFunctionDesc lctx:LowIRLowerContext) {
    if (this.objRcEnabled(lctx) == false) {
      return
    }
    this.collectBoxedCandidates(fnDesc lctx)
  }

  fn collectBoxedCandidates:void (m:RangerAppFunctionDesc lctx:LowIRLowerContext) {
    for m.myLambdas lam:RangerAppFunctionDesc i {
      if (!null? lam.fnBody) {
        if (!null? lam.node) {
          def lnode (unwrap lam.node)
          if (!null? lnode.lambda_ctx) {
            def lc (unwrap lnode.lambda_ctx)
            def body (unwrap lam.fnBody)
            for lc.captured_variables cn:string j {
              if (this.nodeAssignsToName(body cn)) {
                set lctx.boxedCandidates cn 4
              }
            }
          }
        }
      }
      this.collectBoxedCandidates(lam lctx)
    }
  }

  ; Analyse and lay out one lambda's closure environment (L2+). Reads the
  ; frontend's capture set (node.lambda_ctx.captured_variables) and classifies
  ; each captured enclosing local as value (copy), string (dup/owned), object
  ; (retain/owned), or boxed value (L3: a shared heap cell, retain/owned) using
  ; the CREATING context's slot types. Assigns each an env offset (fn_index sits
  ; at 0) and, if any capture is owned, registers a closure typedesc so
  ; obj_release frees the captured strings/objects/cells. Memoised per lambda so
  ; the creating site and the hoisted-body site share one layout.
  ; Byte width of an IR type in a closure record. Pointer-sized on the target
  ; the module is being built for -- the freestanding WASM path is 32-bit and
  ; keeps its four-byte slots.
  fn irTypeBytes:int (irType:string lctx:LowIRLowerContext) {
    if (irType == "f64") {
      return 8
    }
    if (irType == "i64") {
      return 8
    }
    if (irType == "i8*") {
      if (lctx.ptrType == "i64") {
        return 8
      }
      return 4
    }
    if (irType == lctx.ptrType) {
      if (lctx.ptrType == "i64") {
        return 8
      }
      return 4
    }
    return 4
  }

  ; The class a lambda ultimately belongs to: its own container, or the one of
  ; the function it was written inside, following `insideFn` up through nested
  ; lambdas. Asking the lowering CONTEXT instead is order dependent -- the
  ; layout is cached per lambda and the first body to build it wins.
  fn lambdaOwnerClass:string (lam:RangerAppFunctionDesc depth:int) {
    if (depth > 16) {
      return ""
    }
    if (!null? lam.container_class) {
      def cc (unwrap lam.container_class)
      if ((strlen cc.name) > 0) {
        return cc.name
      }
    }
    if (!null? lam.insideFn) {
      return (this.lambdaOwnerClass((unwrap lam.insideFn) (depth + 1)))
    }
    return ""
  }

  ; The names one lambda's closure record has to carry: the ones its own body
  ; reads from the enclosing scope, PLUS the ones any lambda nested inside it
  ; reads from outside itself.
  ;
  ; The frontend's capture set is per lambda, and a nested lambda's env is built
  ; from the slots live while the OUTER body is lowered. So a name only the
  ; inner lambda touches -- `c.method_variants.forEach({ item.variants.forEach({
  ; if (has varNames item.name) … }) })` in the flow parser -- reached neither
  ; env: the outer lambda did not capture `varNames` because it does not name
  ; it, and the inner one then had no slot to copy from. The map arrived as a
  ; null pointer and the compiler died inside RtMap_has.
  ;
  ; The lambda's OWN parameters are excluded: they live in its frame, and a
  ; capture of the same name would be restored over the parameter at entry.
  fn lambdaCaptureNames:[string] (node:CodeNode lam:RangerAppFunctionDesc) {
    def out:[string]
    if (!null? node.lambda_ctx) {
      def lamCtx (unwrap node.lambda_ctx)
      for lamCtx.captured_variables cn:string i {
        if ((indexOf out cn) < 0) {
          push out cn
        }
      }
    }
    def nested:[string] (this.nestedCaptureNames(lam 0))
    for nested nn:string ni {
      if ((indexOf out nn) >= 0) {
        continue
      }
      def isOwnParam:boolean false
      for lam.params p:RangerAppParamDesc pi {
        if (p.name == nn) {
          isOwnParam = true
        }
      }
      if isOwnParam {
        continue
      }
      push out nn
    }
    return out
  }

  fn nestedCaptureNames:[string] (lam:RangerAppFunctionDesc depth:int) {
    def out:[string]
    if (depth > 8) {
      return out
    }
    for lam.myLambdas sub:RangerAppFunctionDesc i {
      if (!null? sub.node) {
        def sn (unwrap sub.node)
        if (!null? sn.lambda_ctx) {
          def sc (unwrap sn.lambda_ctx)
          for sc.captured_variables cn:string j {
            if ((indexOf out cn) < 0) {
              push out cn
            }
          }
        }
      }
      def deeper:[string] (this.nestedCaptureNames(sub (depth + 1)))
      for deeper dn:string k {
        if ((indexOf out dn) < 0) {
          push out dn
        }
      }
    }
    return out
  }

  fn computeLambdaCaptures:LambdaCaptureInfo (node:CodeNode lam:RangerAppFunctionDesc lctx:LowIRLowerContext) {
    def key:string lam.compiledName
    if (has this.lambdaCaptures key) {
      return (unwrap (get this.lambdaCaptures key))
    }
    def info@(lives):LambdaCaptureInfo (new LambdaCaptureInfo())
    ; Captures start AFTER the function-table index, which occupies a whole
    ; pointer-sized word: lowerLambdaValue stores it pointer sized and
    ; lowerLambdaCall reads it back the same way, because an i32 store left the
    ; upper half undefined on a 64-bit target. Reserving four bytes for it was
    ; right only on wasm -- natively the first capture landed at offset 4 and
    ; overwrote the top half of the index, so the call went through a garbage
    ; slot of the lambda table. `filter opFnList { … }` in the flow parser's
    ; TransformOpFn, whose closure captures one int, is where it showed.
    def off (this.irTypeBytes(this.irModule.ptrType lctx))
    def capNames:[string] (this.lambdaCaptureNames(node lam))
    if true {
      for capNames cn:string i {
        ; only names that are enclosing locals/params we can load from a slot
        if (has lctx.slots cn) {
          def kind 0
          def objCls:string ""
          def cirt:string lctx.ptrType
          if (has lctx.boxedLocals cn) {
            ; L3: a boxed mutated value — the env retains the shared heap cell
            ; (owned like an object; the body reads/writes through the cell)
            kind = 3
          } {
          if (has lctx.objectSlots cn) {
            kind = 2
            objCls = (unwrap (get lctx.objectSlots cn))
          } {
            def isStr false
            if (this.isOwnedStringLocal(cn lctx)) {
              isStr = true
            }
            if (has lctx.slotTypes cn) {
              if ((unwrap (get lctx.slotTypes cn)) == "i8*") {
                isStr = true
              }
            }
            if isStr {
              kind = 1
              cirt = "i8*"
            } {
              kind = 0
              if (has lctx.slotTypes cn) {
                cirt = (unwrap (get lctx.slotTypes cn))
              }
            }
          }
          }
          ; Slot WIDTH follows the captured type. Every capture used to take
          ; four bytes, which truncates a pointer (and a double) on a 64-bit
          ; target: a captured object or string arrived in the body as its low
          ; half. An 8-byte slot is aligned to 8, so a 4-byte capture before it
          ; leaves a hole rather than a misaligned load.
          def w:int (this.irTypeBytes(cirt lctx))
          if (w == 8) {
            if (((idiv off 4) * 4) == off) {
              if (((idiv off 8) * 8) != off) {
                off = (+ off 4)
              }
            }
          }
          def capColl:string ""
          if (has lctx.collectionSlots cn) {
            capColl = (unwrap (get lctx.collectionSlots cn))
          }
          def capElem:string ""
          if (has lctx.ptrArrayElemTypes cn) {
            capElem = (unwrap (get lctx.ptrArrayElemTypes cn))
          }
          def capSmapVal:string ""
          if (has lctx.smapValueTypes cn) {
            capSmapVal = (unwrap (get lctx.smapValueTypes cn))
          }
          push info.names cn
          push info.irTypes cirt
          push info.kinds kind
          push info.objClasses objCls
          push info.collKinds capColl
          push info.elemTypes capElem
          push info.smapValTypes capSmapVal
          push info.offsets off
          if (kind != 0) {
            info.hasOwned = true
          }
          off = (+ off w)
        }
      }
    }
    ; ...and the enclosing receiver. Decided from the lambda's DECLARING class,
    ; not from the context that happens to build it first: the layout is cached
    ; per lambda, and lowerLambdaBodies lowers even a lambda whose closure is
    ; never built, so a dead body could fix the layout of a nested lambda
    ; before the live creation site was reached.
    def selfCls:string (this.lambdaOwnerClass(lam 0))
    if ((strlen selfCls) == 0) {
      selfCls = lctx.className
    }
    if ((strlen selfCls) > 0) {
      if (((idiv off 8) * 8) != off) {
        off = (+ off 4)
      }
      info.capturesSelf = true
      info.selfOffset = off
      info.selfClass = selfCls
      off = (+ off (this.irTypeBytes(lctx.ptrType lctx)))
    }
    info.totalBytes = off
    ; a closure typedesc lets obj_destroyFields free owned captures for free
    if info.hasOwned {
      def tdName:string ("__closure_" + key)
      info.tdName = tdName
      def td@(lives):LowIRTypeDesc (new LowIRTypeDesc())
      td.className = tdName
      td.size = info.totalBytes
      def k 0
      def nn (array_length info.names)
      while (< k nn) {
        def knd (itemAt info.kinds k)
        if (knd != 0) {
          def fd@(lives):LowIRTypeFieldDesc (new LowIRTypeFieldDesc())
          fd.offset = (itemAt info.offsets k)
          ; runtime typedesc kind: 0=string, 1=object
          if (knd == 1) {
            fd.kind = 0
          } {
            fd.kind = 1
          }
          fd.owned = 1
          push td.fields fd
        }
        k = (+ k 1)
      }
      push this.irModule.typeDescs td
    }
    set this.lambdaCaptures key info
    return info
  }

  ; A lambda literal -> a closure record (RC object) [ fn_index | captures… ].
  ; L0/L1 non-capturing = just fn_index; L2 stores captured value copies, string
  ; dups, and retained object refs into the env. Returns the record pointer.
  fn lowerLambdaValue:string (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    if (null? node.lambdaFnDesc) {
      def bytes0 (builder.emitConst("i32" "4"))
      return (builder.emitHeapAlloc(bytes0))
    }
    def lfd@(lives):RangerAppFunctionDesc (unwrap node.lambdaFnDesc)
    def name:string lfd.compiledName
    def idx (this.lambdaTableIndex(name))
    def info@(lives):LambdaCaptureInfo (this.computeLambdaCaptures(node lfd lctx))
    def bytes (builder.emitConst("i32" ("" + info.totalBytes)))
    def rec:string ""
    def recTarget (LowIRTarget.resolve((unwrap lctx.ctx)))
    if recTarget.usesLibc {
      ; Same shape as lowerNewObject on the native path: the descriptor is a
      ; module GLOBAL, named straight into the call, and the signature spells
      ; the pointer parameter. The WASM branch below passes a data-segment
      ; offset instead, which is an i32 there.
      this.usedMemRuntime = true
      this.ensureMemExtern(recTarget)
      def tdRef:string "ptr null"
      if info.hasOwned {
        tdRef = ("ptr @" + info.tdName + "_typeDesc")
      }
      def la:[string]
      def lat:[string]
      push la bytes
      push lat "i32"
      push la tdRef
      push lat ""
      def lsig:string ("i32, ptr")
      rec = (builder.emitCallWithSig("ranger_obj_new" lctx.ptrType lsig la lat))
    } {
    if (this.objRcEnabled(lctx)) {
      def tdArg:string ""
      if info.hasOwned {
        tdArg = (builder.emitTypeDescPtr(info.tdName))
      } {
        tdArg = (builder.emitConst("i32" "0"))
      }
      def a:[string]
      def at:[string]
      push a bytes
      push at "i32"
      push a tdArg
      push at "i32"
      rec = (builder.emitCall("ranger_obj_new" lctx.ptrType a at))
    } {
      rec = (builder.emitHeapAlloc(bytes))
    }
    }
    ; The index is read back with a pointer-sized load (emitPtrLoad in
    ; lowerLambdaCall), so it is stored pointer sized too -- an i32 store here
    ; left the upper half of the word undefined on a 64-bit target.
    def idxC (builder.emitConst(lctx.ptrType ("" + idx)))
    builder.emitStoreTypedAt(rec 0 idxC lctx.ptrType)
    ; materialise the captured environment
    def k 0
    def nn (array_length info.names)
    while (< k nn) {
      def cn (itemAt info.names k)
      def knd (itemAt info.kinds k)
      def coff (itemAt info.offsets k)
      def cirt (itemAt info.irTypes k)
      ; The capture LAYOUT is cached per lambda, and the same lambda can be
      ; built from a context where one of its captured names is not a local at
      ; all. loadSlot answers a bare `%name` for a name it does not know, which
      ; is a value nothing defines; a null of the slot's type keeps the record
      ; layout and the IR both intact.
      if ((has lctx.slots cn) == false) {
        def missing:string "0"
        if (cirt == "i8*") {
          missing = "null"
        } {
          missing = (builder.emitConst(cirt "0"))
        }
        builder.emitStoreTypedAt(rec coff missing cirt)
        k = (+ k 1)
        continue
      }
      def cval (this.loadSlot(cn cirt lctx))
      if (knd == 1) {
        ; string capture: the closure owns a private dup
        cval = (this.emitStrdupExpr(cval lctx))
      }
      if (knd == 2) {
        ; object capture: retain so it outlives the creating scope (the closure's
        ; typedesc releases it on destruction — solves premature-free)
        this.emitObjRetainPtr(cval lctx)
      }
      if (knd == 3) {
        ; boxed value capture: retain the shared heap cell (the enclosing scope
        ; and the closure both reference it; freed once, when neither holds it)
        this.emitObjRetainPtr(cval lctx)
      }
      ; The capture LAYOUT is fixed at the first lowering of this lambda, and
      ; the slot's own type at this site can disagree (a boolean local is an
      ; i1, the layout says i32). Coerce toward the layout so the write and the
      ; read side agree.
      def cvalT:string (builder.emittedType(cval))
      if ((strlen cvalT) > 0) {
        if (cvalT != cirt) {
          if ((cirt == "i32") && (cvalT == "i1")) {
            cval = (builder.emitZextI1ToI32(cval))
          }
          if ((cirt == "i64") && (cvalT == "i1")) {
            cval = (builder.emitCast("zext" "i64" "i1" cval))
          }
          if ((cirt == "i64") && (cvalT == "i32")) {
            cval = (builder.emitCast("zext" "i64" "i32" cval))
          }
          if ((cirt == "i32") && (cvalT == "i64")) {
            cval = (builder.emitCast("trunc" "i32" "i64" cval))
          }
        }
      }
      builder.emitStoreTypedAt(rec coff cval cirt)
      k = (+ k 1)
    }
    if info.capturesSelf {
      def selfWord:string (builder.emitConst(lctx.ptrType "0"))
      if ((strlen lctx.selfPtr) > 0) {
        selfWord = (builder.emitPtrToInt(lctx.selfPtr))
      }
      builder.emitStoreTypedAt(rec info.selfOffset selfWord lctx.ptrType)
    }
    ; no local owns it yet — register for statement-scoped release so an inline
    ; lambda argument (`apply((fn…){}) v)`) does not leak. A binding claims it.
    this.registerFreshObjectTemp(rec lctx)
    return rec
  }

  ; Call a lambda value: load fn_index from the record and call_indirect, passing
  ; the record itself as the hidden env (first arg).
  fn lowerLambdaCall:string (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def calleeNode (node.getFirst())
    def argsNode (node.getSecond())
    def env (this.lowerExpr(calleeNode lctx))
    def fnIdx (builder.emitPtrLoad(env))
    def callArgs:[string]
    def callTypes:[string]
    push callArgs env
    push callTypes lctx.ptrType
    def sig:string "i32"
    for argsNode.children arg:CodeNode i {
      def av (this.lowerExpr(arg lctx))
      def at (this.argIrType(arg lctx))
      if (this.exprProducesI1(arg lctx)) {
        av = (builder.emitZextI1ToI32(av))
        at = "i32"
      }
      push callArgs av
      push callTypes at
      sig = (sig + ("," + at))
    }
    def ret:string "void"
    if ((strlen node.eval_type_name) > 0) {
      ret = (this.llvmTypeForRanger(node.eval_type_name lctx.ptrType))
    }
    sig = (sig + (":" + ret))
    this.addLambdaSig(sig)
    return (builder.emitCallIndirect(ret sig callArgs callTypes fnIdx))
  }

  fn isOwnedObjectLocal:boolean (varName:string lctx:LowIRLowerContext) {
    for lctx.ownedObjectLocals n:string i {
      if (n == varName) {
        return true
      }
    }
    return false
  }

  ; objectSlots records a CLASS for a name but is never cleared, so a name
  ; redeclared with a scalar type later in the same function still looks like an
  ; object there. The slot's recorded type is the current truth.
  fn slotHoldsObject:boolean (varName:string lctx:LowIRLowerContext) {
    if ((has lctx.objectSlots varName) == false) {
      return false
    }
    if (has lctx.slotTypes varName) {
      def st:string (unwrap (get lctx.slotTypes varName))
      if (st != lctx.ptrType) {
        return false
      }
    }
    return true
  }

  fn releaseOwnedLocal:void (varName:string lctx:LowIRLowerContext) {
    if (this.objRcEnabled(lctx) == false) {
      return
    }
    if (has lctx.escapedLocals varName) {
      return
    }
    if (false == (has lctx.slots varName)) {
      return
    }
    ; A name REDECLARED with a scalar type later in the same function ends up
    ; with a non-pointer slot; releasing it would hand an i32 to obj_release.
    ; The object binding lost its slot, so there is nothing left to release.
    if (has lctx.slotTypes varName) {
      def slotT:string (unwrap (get lctx.slotTypes varName))
      if (slotT != lctx.ptrType) {
        return
      }
    }
    def builder (lctx.builder)
    def voidType:string "void"
    def val (this.loadSlot(varName lctx.ptrType lctx))
    def args:[string]
    def argTypes:[string]
    push args val
    push argTypes lctx.ptrType
    builder.emitCall("ranger_obj_release" voidType args argTypes)
  }

  ; --- string RC (freestanding WASM, -wasmrc) ------------------------------
  ; Games churn temporary strings ("SCORE " + n) every frame; without release
  ; the heap grows unbounded. Owned string locals are released at scope end via
  ; ranger_str_release (a no-op for static literal pointers below the heap base).
  fn isOwnedStringLocal:boolean (varName:string lctx:LowIRLowerContext) {
    for lctx.ownedStringLocals n:string i {
      if (n == varName) {
        return true
      }
    }
    return false
  }

  ; --- fresh-string temp arena (statement-scoped) -------------------------
  ; A fresh heap string produced mid-expression (concat/to_string/string-call)
  ; that is not (yet) owned by a local. Registered here, then either CLAIMED by
  ; an owner (assigned to a local, or returned/escaped) or FLUSHED at statement
  ; end. This frees inline throwaways like `host.drawText("S " + n)` — the concat
  ; result and its int->string temporaries — every statement, so a frame loop
  ; stays heap-flat without the value ever being bound to a named local.
  fn registerFreshStringTemp:void (tmp:string lctx:LowIRLowerContext) {
    if (this.strRcEnabled(lctx) == false) {
      return
    }
    push lctx.pendingStringTemps tmp
  }

  ; the temp became owned (moved to a local) or escaped (returned) -> drop it
  ; from the pending set so it is not double-freed at statement end.
  fn claimStringTemp:void (tmp:string lctx:LowIRLowerContext) {
    if (this.strRcEnabled(lctx) == false) {
      return
    }
    def kept:[string]
    for lctx.pendingStringTemps t:string i {
      if (t != tmp) {
        push kept t
      }
    }
    lctx.pendingStringTemps = kept
  }

  ; release + drop every pending temp registered since `mark`. Emits into the
  ; current block, so callers must flush while the temps still dominate (i.e. at
  ; the end of the linear statement / condition that produced them).
  fn flushStringTempsFrom:void (mark:int lctx:LowIRLowerContext) {
    if (this.strRcEnabled(lctx) == false) {
      return
    }
    def n (array_length lctx.pendingStringTemps)
    if (n <= mark) {
      return
    }
    def k mark
    while (< k n) {
      this.emitStrReleasePtr((itemAt lctx.pendingStringTemps k) lctx)
      k = (+ k 1)
    }
    def kept:[string]
    def j 0
    while (< j mark) {
      push kept (itemAt lctx.pendingStringTemps j)
      j = (+ j 1)
    }
    lctx.pendingStringTemps = kept
  }

  ; --- fresh object temp arena (statement-scoped) ------------------------
  ; A fresh RC object produced mid-expression that no local owns yet — today an
  ; inline lambda value used directly as a call argument, e.g.
  ; `apply((fn:… (){}) v)`. The closure record is allocated but never bound, so
  ; it is registered here and released at statement/return end (mirrors the
  ; string temp arena). Objects that ARE bound to a local claim themselves out.
  fn registerFreshObjectTemp:void (tmp:string lctx:LowIRLowerContext) {
    if (this.objRcEnabled(lctx) == false) {
      return
    }
    push lctx.pendingObjectTemps tmp
  }

  fn claimObjectTemp:void (tmp:string lctx:LowIRLowerContext) {
    if (this.objRcEnabled(lctx) == false) {
      return
    }
    def kept:[string]
    for lctx.pendingObjectTemps t:string i {
      if (t != tmp) {
        push kept t
      }
    }
    lctx.pendingObjectTemps = kept
  }

  fn flushObjectTempsFrom:void (mark:int lctx:LowIRLowerContext) {
    if (this.objRcEnabled(lctx) == false) {
      return
    }
    def n (array_length lctx.pendingObjectTemps)
    if (n <= mark) {
      return
    }
    def k mark
    while (< k n) {
      this.emitObjReleasePtr((itemAt lctx.pendingObjectTemps k) lctx)
      k = (+ k 1)
    }
    def kept:[string]
    def j 0
    while (< j mark) {
      push kept (itemAt lctx.pendingObjectTemps j)
      j = (+ j 1)
    }
    lctx.pendingObjectTemps = kept
  }

  ; free a bare string pointer (an intermediate temporary) via ranger_str_release
  fn emitStrReleasePtr:void (ptr:string lctx:LowIRLowerContext) {
    def args:[string]
    def argTypes:[string]
    push args ptr
    push argTypes "i8*"
    lctx.builder.emitCall("ranger_str_release" "void" args argTypes)
  }

  fn releaseOwnedString:void (varName:string lctx:LowIRLowerContext) {
    if (this.strRcEnabled(lctx) == false) {
      return
    }
    if (has lctx.escapedLocals varName) {
      return
    }
    if (false == (has lctx.slots varName)) {
      return
    }
    def builder (lctx.builder)
    def voidType:string "void"
    def val (this.loadSlot(varName "i8*" lctx))
    def args:[string]
    def argTypes:[string]
    push args val
    push argTypes "i8*"
    builder.emitCall("ranger_str_release" voidType args argTypes)
    ; NULL the slot, exactly as releaseAndClearOwnedLocal does for objects. A
    ; string local declared inside a branch of a loop body -- `def esc:string
    ; (substring body i (i + 1))` under an `if` -- is released at the end of
    ; EVERY iteration, so an iteration that skipped the branch would otherwise
    ; free the pointer the previous iteration already freed.
    if (has lctx.slots varName) {
      def slot (unwrap (get lctx.slots varName))
      builder.emitStore("i8*" "null" slot)
    }
  }

  ; Release one owned collection local (free backing store + descriptor, and, for
  ; element-owned object arrays, each element). Escaped collections (returned or
  ; stored into a field) are skipped. Used at scope end and per loop iteration.
  fn releaseOwnedCollectionLocal:void (varName:string lctx:LowIRLowerContext) {
    if (has lctx.escapedLocals varName) {
      return
    }
    if (false == (has lctx.slots varName)) {
      return
    }
    def desc (this.loadSlot(varName lctx.ptrType lctx))
    def args:[string]
    def argTypes:[string]
    push args desc
    push argTypes lctx.ptrType
    ; dispatch by collection kind: maps free desc+keys+vals via RtMap_free;
    ; ptr-arrays (int and object) free backing+desc (+ element RC) via
    ; ranger_ptrarray_release.
    def relFn:string "ranger_ptrarray_release"
    if ((this.collectionKind(varName lctx)) == "map") {
      relFn = "RtMap_free"
    }
    if ((this.collectionKind(varName lctx)) == "smap") {
      relFn = "RtSMap_free"
    }
    if ((this.collectionKind(varName lctx)) == "imap") {
      relFn = "RtIMap_free"
    }
    lctx.builder.emitCall(relFn "void" args argTypes)
  }

  ; Prepare a string value for a freshly-defined owned local and register it for
  ; scope-end release. Fresh strings (concat/to_string/string-call) are owned
  ; directly; borrowed ones (literal/VRef/field) are dup'd so the local owns a
  ; private copy. Non-wasm targets keep the legacy always-dup behaviour.
  fn emitOwnedStringInit:string (varName:string valNode:CodeNode strPtr:string lctx:LowIRLowerContext) {
    if (this.isCapturedName(varName lctx)) {
      return (this.emitStrdupExpr(strPtr lctx))
    }
    if (this.wasmStrEnabled(lctx) == false) {
      ; libc: always take a private copy -- the value may be a literal, a field,
      ; or another local -- and record the local so scope exit frees that copy.
      ; Storing a string into a field dups it again (emitFieldStoreOnEx) and a
      ; returned local is marked escaped, so this copy is genuinely the local's.
      def libcOwned (this.emitStrdupExpr(strPtr lctx))
      if (this.strRcEnabled(lctx)) {
        if (this.isOwnedStringLocal(varName lctx) == false) {
          push lctx.ownedStringLocals varName
        }
      }
      return libcOwned
    }
    def owned strPtr
    if ((this.exprIsFreshString(valNode lctx)) == false) {
      owned = (this.emitStrdupExpr(strPtr lctx))
    } {
      ; owning a fresh temp directly: move it out of the statement arena so it is
      ; not double-freed (the local's scope-end release now owns its lifetime).
      this.claimStringTemp(strPtr lctx)
    }
    if (this.isOwnedStringLocal(varName lctx) == false) {
      push lctx.ownedStringLocals varName
    }
    return owned
  }

  ; Reassignment of an owned string local: free the previous buffer first, then
  ; own the new value (fresh directly, borrowed dup'd). `strPtr` already holds the
  ; new value, computed independently of the old slot, so freeing old is safe
  ; even for `s = (s + "x")` (concat copied the old bytes into a fresh buffer).
  fn isCapturedName:boolean (varName:string lctx:LowIRLowerContext) {
    for lctx.capturedNames n:string i {
      if (n == varName) {
        return true
      }
    }
    return false
  }

  fn emitOwnedStringReassign:string (varName:string valNode:CodeNode strPtr:string lctx:LowIRLowerContext) {
    ; Assigning to a CAPTURED string: the closure record owns the buffer the
    ; slot came from, so releasing it here frees what the record's typedesc
    ; frees again -- and registering the name would release the new value on
    ; every exit path, including the one where the assignment never ran. A
    ; private copy is stored and left to leak, which is the safe direction
    ; while the write-back to the closure is still missing.
    if (this.isCapturedName(varName lctx)) {
      return (this.emitStrdupExpr(strPtr lctx))
    }
    if (this.wasmStrEnabled(lctx) == false) {
      ; Copy FIRST, then free what the slot held. The other order breaks `s = s`
      ; and any assignment whose right-hand side still reads the old buffer.
      def libcNew (this.emitStrdupExpr(strPtr lctx))
      if (this.strRcEnabled(lctx)) {
        if (this.isOwnedStringLocal(varName lctx)) {
          this.releaseOwnedString(varName lctx)
        } {
          push lctx.ownedStringLocals varName
        }
      }
      return libcNew
    }
    if (this.isOwnedStringLocal(varName lctx)) {
      this.releaseOwnedString(varName lctx)
    }
    def owned strPtr
    if ((this.exprIsFreshString(valNode lctx)) == false) {
      owned = (this.emitStrdupExpr(strPtr lctx))
    } {
      this.claimStringTemp(strPtr lctx)
    }
    if (this.isOwnedStringLocal(varName lctx) == false) {
      push lctx.ownedStringLocals varName
    }
    return owned
  }

  fn strictOwnershipEnabled:boolean (lctx:LowIRLowerContext) {
    def ctx (unwrap lctx.ctx)
    return (ctx.hasCompilerFlag("strict-ownership"))
  }

  ; Diagnostic (manual targets + -strict-ownership): emit a per-exit summary of
  ; how each owned local is disposed, so the target-specific ownership handling
  ; is visible in the IR. Foundation for turning ambiguous cases into warnings.
  fn emitOwnershipSummary:void (lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def objCount (array_length lctx.ownedObjectLocals)
    def collCount (array_length lctx.ownedCollectionLocals)
    if ((objCount + collCount) == 0) {
      return
    }
    builder.emitComment("ownership[manual]: scope-exit disposition")
    for lctx.ownedObjectLocals name:string i {
      if (has lctx.escapedLocals name) {
        builder.emitComment(("  owned object '" + name + "' -> escaped (moved/returned), caller owns"))
      } {
        builder.emitComment(("  owned object '" + name + "' -> released"))
      }
    }
    for lctx.ownedCollectionLocals name:string i {
      if (has lctx.escapedLocals name) {
        builder.emitComment(("  owned array '" + name + "' -> escaped, caller owns"))
      } {
        builder.emitComment(("  owned array '" + name + "' -> released (elements freed)"))
      }
    }
  }

  fn emitReleaseOwnedLocals:void (lctx:LowIRLowerContext) {
    def memTarget (LowIRTarget.resolve((unwrap lctx.ctx)))
    if (this.objRcEnabled(lctx) == false) {
      return
    }
    if (this.strictOwnershipEnabled(lctx)) {
      this.emitOwnershipSummary(lctx)
    }
    for lctx.ownedObjectLocals name:string i {
      this.releaseOwnedLocal(name lctx)
    }
    ; owned string locals (freestanding WASM): free per-scope temporaries so a
    ; frame's throwaway strings don't accumulate on the heap.
    for lctx.ownedStringLocals sname:string si {
      this.releaseOwnedString(sname lctx)
    }
    ; owned collections: freed on the libc path and on freestanding WASM (-wasmrc,
    ; where their storage is on the free-list heap). ranger_ptrarray_release frees
    ; the backing store + descriptor and, when the descriptor is element-owned
    ; (object arrays), releases each element.
    if (memTarget.usesLibc == false) {
      if ((this.wasmCollectionRcEnabled(lctx)) == false) {
        return
      }
    }
    for lctx.ownedCollectionLocals name:string i {
      this.releaseOwnedCollectionLocal(name lctx)
    }
  }

  ; A copy of `names` without `varName`. Returned rather than removed in place:
  ; a parameter this backend only reads is a `const&` on the C++ target, so an
  ; erase through it does not compile.
  fn withoutName:[string] (names:[string] varName:string) {
    def out:[string]
    for names n:string i {
      if (n != varName) {
        push out n
      }
    }
    return out
  }

  ; Undo every redeclaration journalled since `mark`, putting the enclosing
  ; scope's slot, IR type and OWNERSHIP back in place.
  ;
  ; The ownership half is the part that bites. The owned-local lists hold NAMES
  ; and are walked once at function exit, where the name is bound to the outer
  ; slot again. `fn f(wr:CodeWriter) { … if c { def wr (new CodeWriter) … } }`
  ; -- which the flow parser's convertToUnion does verbatim -- therefore had the
  ; exit path release whatever `wr` held, and on the paths where the `if` never
  ; ran that is the CALLER's writer. The caller went on using freed memory.
  ;
  ; The inner value is NOT released here. Emitting a block-end release for it
  ; looks tidier but is wrong whenever the block did not run to its end on every
  ; path, and freeing a still-referenced object hands the next `new` the same
  ; address. Redeclarations are rare and the process is short-lived, so the inner
  ; value is left to leak rather than risk that.
  fn popReslots:void (mark:int lctx:LowIRLowerContext) {
    def cnt (array_length lctx.reslotNames)
    while (cnt > mark) {
      def last:int (cnt - 1)
      def nm:string (itemAt lctx.reslotNames last)
      def ps:string (itemAt lctx.reslotPrevSlots last)
      def pt:string (itemAt lctx.reslotPrevTypes last)
      if ((itemAt lctx.reslotOwnedStr last) == 0) {
        lctx.ownedStringLocals = (this.withoutName(lctx.ownedStringLocals nm))
      }
      if ((itemAt lctx.reslotOwnedObj last) == 0) {
        lctx.ownedObjectLocals = (this.withoutName(lctx.ownedObjectLocals nm))
      }
      if ((itemAt lctx.reslotOwnedColl last) == 0) {
        lctx.ownedCollectionLocals = (this.withoutName(lctx.ownedCollectionLocals nm))
      }
      set lctx.slots nm ps
      if ((strlen pt) > 0) {
        set lctx.slotTypes nm pt
      }
      removeLast lctx.reslotNames
      removeLast lctx.reslotPrevSlots
      removeLast lctx.reslotPrevTypes
      removeLast lctx.reslotOwnedStr
      removeLast lctx.reslotOwnedObj
      removeLast lctx.reslotOwnedColl
      cnt = cnt - 1
    }
  }

  fn lowerBlock:void (block:CodeNode lctx:LowIRLowerContext) {
    def reslotMark:int (array_length lctx.reslotNames)
    this.lowerBlockBody(block lctx)
    this.popReslots(reslotMark lctx)
  }

  ; Has the block being written already ended (return / break / continue)?
  ; Everything after that in the same statement list is unreachable.
  fn blockClosed:boolean (lctx:LowIRLowerContext) {
    if (null? lctx.builder.currentBlock) {
      return false
    }
    def cur (unwrap lctx.builder.currentBlock)
    return (cur.termKind != "")
  }

  ; Lower a statement list, STOPPING at the first terminator.
  ;
  ; A LowIRBlock keeps its terminator apart from its instructions and the writer
  ; prints the instructions first, so anything lowered after a `return` was
  ; emitted BEFORE the `ret` -- and therefore ran. RangerFlowParser's
  ; WalkCollectMethods has a bare `return` with a page of dead code after it,
  ; so the release epilogue the return emitted was followed by the dead code AND
  ; by the function's own epilogue: every owned local was released twice, and
  ; the freshly built operator nodes were handed back to the allocator while
  ; stdCommands still pointed at them.
  fn lowerStmtList:void (stmts:[CodeNode] lctx:LowIRLowerContext) {
    def n (array_length stmts)
    def si:int 0
    while (si < n) {
      if (this.blockClosed(lctx)) {
        return
      }
      this.lowerStmt((itemAt stmts si) lctx)
      si = si + 1
    }
  }

  fn lowerBlockBody:void (block:CodeNode lctx:LowIRLowerContext) {
    if block.is_block_node {
      def childCnt (array_length block.children)
      if (childCnt > 0) {
        this.lowerStmtList(block.children lctx)
        return
      }
      if (has block.register_expressions) {
        this.lowerStmtList(block.register_expressions lctx)
      }
      return
    }
    if block.expression {
      def childCnt (array_length block.children)
      if (childCnt > 0) {
        this.lowerStmtList(block.children lctx)
        return
      }
    }
    if (has block.register_expressions) {
      this.lowerStmtList(block.register_expressions lctx)
      return
    }
    this.lowerStmt(block lctx)
  }

  fn isAssignNode:boolean (node:CodeNode) {
    if ((array_length node.children) < 3) {
      return false
    }
    def fc (node.getFirst())
    return (fc.vref == "=")
  }

  ; Statement wrapper: after a leaf statement lowers, release the fresh-string
  ; temporaries it produced but nobody claimed (inline throwaways such as
  ; `host.drawText("S " + n)`), so a frame loop stays heap-flat. Statements that
  ; terminate the block (return) or open nested regions (if/while/for) manage
  ; their own temps and their condition flush; here the current block is either
  ; terminated (skip — cannot emit past a terminator) or the range is already
  ; empty, so this flush is a safe leaf-only cleanup.
  fn lowerStmt:void (node:CodeNode lctx:LowIRLowerContext) {
    if node.disabled_node {
      return
    }
    ; Both arenas are statement-scoped on every target that has them. The libc
    ; path used to skip the STRING flush, which was fine only while it also
    ; registered nothing; once it does, a temp registered inside an `if` branch
    ; stays pending until some later `return` flushes it -- from a block the
    ; producing branch does not dominate, so the release read an undefined
    ; pointer. Flushing where the temps were produced keeps that impossible.
    if (this.strRcEnabled(lctx) == false) {
      this.lowerStmtDispatch(node lctx)
      return
    }
    def strMark (array_length lctx.pendingStringTemps)
    def objMark (array_length lctx.pendingObjectTemps)
    this.lowerStmtDispatch(node lctx)
    if (!null? lctx.builder.currentBlock) {
      def curBlock (unwrap lctx.builder.currentBlock)
      if (curBlock.termKind == "") {
        this.flushStringTempsFrom(strMark lctx)
        this.flushObjectTempsFrom(objMark lctx)
      }
    }
  }

  fn lowerStmtDispatch:void (node:CodeNode lctx:LowIRLowerContext) {
    if node.disabled_node {
      return
    }
    if (this.isAssignNode(node)) {
      this.lowerAssign(node lctx)
      return
    }
    if node.infix_operator {
      if (!null? node.infix_node) {
        def infix (unwrap node.infix_node)
        if infix.has_operator {
          def opName (infix.getOperator())
          if (opName == "=") {
            this.lowerAssign(infix lctx)
            return
          }
        }
      }
    }
    if node.hasVarDef {
      this.lowerVarDef(node lctx)
      return
    }
    if node.has_operator {
      def opName (node.getOperator())
      if (opName == "return") {
        this.lowerReturn(node lctx)
        return
      }
      if (opName == "if") {
        this.lowerIf(node lctx)
        return
      }
      if (opName == "case") {
        if ((array_length node.children) > 3) {
          this.lowerShapeCase(node lctx)
          return
        }
      }
      if (opName == "while") {
        this.lowerWhile(node lctx)
        return
      }
      if (opName == "=") {
        this.lowerAssign(node lctx)
        return
      }
      if (opName == "set") {
        if (this.nodeIsJson((node.getSecond()) lctx)) {
          this.lowerJsonSet(node lctx)
          return
        }
        this.lowerCollectionSet(node lctx)
        return
      }
      if (opName == "case") {
        if (this.lowerJsonCase(node lctx)) {
          return
        }
      }
      if (opName == "print") {
        this.lowerPrint(node lctx)
        return
      }
      if (opName == "write") {
        this.lowerWrite(node lctx)
        return
      }
      if (opName == "exit") {
        this.lowerExit(node lctx)
        return
      }
      if (opName == "sleep_ms") {
        this.lowerSleepMs(node lctx)
        return
      }
      if (opName == "clear_screen") {
        this.lowerClearScreen(node lctx)
        return
      }
      if (opName == "hide_cursor") {
        this.lowerHideCursor(node lctx)
        return
      }
      if (opName == "show_cursor") {
        this.lowerShowCursor(node lctx)
        return
      }
      if (opName == "move_cursor") {
        this.lowerMoveCursor(node lctx)
        return
      }
      if (opName == "for") {
        this.lowerFor(node lctx)
        return
      }
      if (opName == "break") {
        this.lowerLoopJump(lctx.breakLabel lctx)
        return
      }
      if (opName == "continue") {
        this.lowerLoopJump(lctx.continueLabel lctx)
        return
      }
      if (opName == "push") {
        if (this.nodeIsJson((node.getSecond()) lctx)) {
          this.lowerJsonPush(node lctx)
          return
        }
        this.lowerPush(node lctx)
        return
      }
      if (opName == "create_dir") {
        this.lowerCreateDir(node lctx)
        return
      }
      if (opName == "write_file") {
        this.lowerWriteFile(node lctx)
        return
      }
      if (opName == "nullify") {
        this.lowerNullify(node lctx)
        return
      }
      ; `try { … } { … }` -- this backend has no unwinding, so the try block
      ; runs and the catch block is not written, exactly as the Rust target
      ; does. `try` carries a `*` template, so it matched here all along and
      ; then reached no lowering at all: the whole block was DROPPED. The
      ; compiler wraps its entire pipeline in one, which is why the native
      ; build printed its header and then stopped without a diagnostic.
      ; `switch v { case a { … } … default { … } }`. There is no jump table
      ; here: the cases become an if / else-if chain, which is what the `*`
      ; template's C `switch` means anyway (every Ranger case ends in a break).
      ;
      ; `switch` carried a `*` template and no lowering, so the whole statement
      ; -- every case with it -- was DROPPED. The compiler's writers are
      ; switch-driven, so the native build wrote out bare identifiers and
      ; nothing else.
      if (opName == "switch") {
        this.lowerSwitch(node lctx)
        return
      }
      if (opName == "try") {
        this.lowerTry(node lctx)
        return
      }
      if (opName == "insert") {
        this.lowerArrayInsert(node lctx)
        return
      }
      if (opName == "remove") {
        this.lowerArrayRemove(node lctx)
        return
      }
      ; `remove_index xs i` is `remove` under the name the array overload uses.
      if (opName == "remove_index") {
        this.lowerArrayRemove(node lctx)
        return
      }
      ; `removeLast` and `clear` carried only text templates, so on this
      ; backend they compiled to NOTHING -- a silent no-op. The compiler pops
      ; the last path segment with removeLast when it builds its library search
      ; path, so every candidate directory still had the file name on it.
      if (opName == "removeLast") {
        this.lowerArrayRemoveLast(node lctx)
        return
      }
      if (opName == "clear") {
        this.lowerArrayClear(node lctx)
        return
      }
      if (opName == "on_keypress") {
        this.lowerOnKeypress(node lctx)
        return
      }
    }
    if node.has_lambda_call {
      this.lowerLambdaCall(node lctx)
      return
    }
    if (node.has_call || node.is_direct_method_call) {
      this.lowerCall(node lctx)
      return
    }
    if node.hasFnCall {
      this.lowerExpr(node lctx)
      return
    }
    if node.has_operator {
      this.lowerExpr(node lctx)
      return
    }
    if node.expression {
      this.lowerStmtList(node.children lctx)
    }
  }

  ; The IR type a declaration asks for, or "" when it cannot be told from the
  ; node alone. Used only to notice that a re-`def` of a live name needs a slot
  ; of a different width.
  fn declaredIrTypeOf:string (nameNode:CodeNode lctx:LowIRLowerContext) {
    if (this.isIntArrayTypeNode(nameNode)) { return lctx.ptrType }
    if (this.isStringArrayTypeNode(nameNode)) { return lctx.ptrType }
    if (this.isPlainValueArrayTypeNode(nameNode)) { return lctx.ptrType }
    if (this.isObjectPtrArrayTypeNode(nameNode)) { return lctx.ptrType }
    if (this.isStringKeyMapTypeNode(nameNode)) { return lctx.ptrType }
    if (this.isIntKeyValueMapTypeNode(nameNode)) { return lctx.ptrType }
    if (this.isIntIntMapTypeNode(nameNode)) { return lctx.ptrType }
    def tn:string (this.varTypeName(nameNode))
    if ((strlen tn) == 0) {
      return ""
    }
    if (LowIRUtil.isStringType(tn)) { return "i8*" }
    if (this.isEnumTypeName(tn)) { return "i32" }
    if (LowIRUtil.isSupportedPrimitive(tn)) { return (LowIRUtil.typeFromRanger(tn)) }
    if (this.isObjectTypeName(tn)) { return lctx.ptrType }
    return ""
  }

  ; `def x …` when `x` is already bound -- a parameter, or a local of an
  ; enclosing block. Every other Ranger backend gives that declaration a
  ; variable of its own (a C++/JS block-scoped `let`); sharing the outer slot
  ; broke two ways here:
  ;
  ;   * ng_TTypes' baseTypeAsEval declares `vType` as an enum and again, in the
  ;     else branch, as a string. The shared `alloca i32` then took an 8-byte
  ;     `store i8*` and smashed the locals next to it.
  ;   * ng_RangerFlowParser's convertToUnion takes `wr:CodeWriter` and does
  ;     `def wr (new CodeWriter)` inside an `if`. The name went on the owned-
  ;     object list, and the single scope-end release then freed whatever the
  ;     slot held -- on the paths where that `if` never ran, the CALLER's writer.
  ;
  ; So the trigger is the redeclaration itself, not a change of type. Give it its
  ; own alloca and journal the old binding (slot, IR type, ownership) so
  ; lowerBlock can hand the name back to the enclosing scope intact.
  fn noteRedeclaration:void (varName:string nameNode:CodeNode lctx:LowIRLowerContext) {
    if ((has lctx.slots varName) == false) {
      return
    }
    def curIr:string ""
    if (has lctx.slotTypes varName) {
      curIr = (unwrap (get lctx.slotTypes varName))
    }
    def wasStr:int 0
    def wasObj:int 0
    def wasColl:int 0
    if (this.isOwnedStringLocal(varName lctx)) { wasStr = 1 }
    if (this.isOwnedObjectLocal(varName lctx)) { wasObj = 1 }
    if (this.isOwnedCollectionLocal(varName lctx)) { wasColl = 1 }
    push lctx.reslotNames varName
    push lctx.reslotPrevSlots (unwrap (get lctx.slots varName))
    push lctx.reslotPrevTypes curIr
    push lctx.reslotOwnedStr wasStr
    push lctx.reslotOwnedObj wasObj
    push lctx.reslotOwnedColl wasColl
    push lctx.forceFreshSlots varName
  }

  fn lowerVarDef:void (node:CodeNode lctx:LowIRLowerContext) {
    def nameNode0 (node.getSecond())
    def varName0:string nameNode0.vref
    this.noteRedeclaration(varName0 nameNode0 lctx)
    this.lowerVarDefBody(node lctx)
    ; Not every declaration reaches a bindSlot (a `def` of a type this backend
    ; does not model falls through). Consume the request so it cannot fire on
    ; some later assignment to the same name and silently move it off its slot.
    this.takeForceFresh(varName0 lctx)
  }

  fn lowerVarDefBody:void (node:CodeNode lctx:LowIRLowerContext) {
    def nameNode (node.getSecond())
    def varName:string nameNode.vref
    def valNode@(optional):CodeNode
    def cnt (array_length node.children)
    if (cnt > 2) {
      def last (itemAt node.children (cnt - 1))
      valNode = last
    }
    if (null? valNode) {
      if (this.isIntArrayTypeNode(nameNode)) {
        def emptyArr (this.emitPtrArrayNewEmpty(lctx 0))
        this.bindPtrArraySlot(varName emptyArr lctx false)
        set lctx.ptrArrayElemTypes varName "int"
        return
      }
      ; a [string] array owns str-releasable elements (kind 2); check before the
      ; general object-array case, which also matches non-int element types.
      if (this.isStringArrayTypeNode(nameNode)) {
        def emptyStrArr (this.emitPtrArrayNewEmpty(lctx 2))
        this.bindPtrArraySlot(varName emptyStrArr lctx true)
        set lctx.ptrArrayElemTypes varName "string"
        return
      }
      ; a [double] array holds plain values (elemKind 0): its slots are bit
      ; patterns, not objects, so nothing is released per element.
      if (this.isPlainValueArrayTypeNode(nameNode)) {
        def emptyPlainArr (this.emitPtrArrayNewEmpty(lctx 0))
        this.bindPtrArraySlot(varName emptyPlainArr lctx false)
        set lctx.ptrArrayElemTypes varName nameNode.array_type
        return
      }
      if (this.isObjectPtrArrayTypeNode(nameNode)) {
        def emptyPtrArr (this.emitPtrArrayNewEmpty(lctx 1))
        this.bindPtrArraySlot(varName emptyPtrArr lctx true)
        set lctx.ptrArrayElemTypes varName nameNode.array_type
        return
      }
      if (this.isStringKeyMapTypeNode(nameNode)) {
        def newSMap (this.emitSMapNewKind((this.smapValueOwnKind(nameNode.array_type)) lctx))
        this.bindCollectionSlot(varName "smap" newSMap lctx)
        set lctx.smapValueTypes varName nameNode.array_type
        return
      }
      if (this.isIntKeyValueMapTypeNode(nameNode)) {
        this.ensureIMapExterns()
        def ikArgs:[string]
        def ikTypes:[string]
        push ikArgs (lctx.builder.emitConst("i32" (to_string (this.imapValueOwnKind(nameNode.array_type)))))
        push ikTypes "i32"
        def newIMap (lctx.builder.emitCall("RtIMap_new_kind" "i64" ikArgs ikTypes))
        this.bindCollectionSlot(varName "imap" newIMap lctx)
        set lctx.imapValueTypes varName nameNode.array_type
        return
      }
      if (this.isIntIntMapTypeNode(nameNode)) {
        def eight (lctx.builder.emitConst("i32" "8"))
        def newMap (this.emitRtMapNew(eight lctx))
        this.bindCollectionSlot(varName "map" newMap lctx)
        return
      }
      ; `def none@(optional):SomeClass` — an object local declared with no value
      ; is NULL. Without a slot the name has no LLVM value at all and any later
      ; read (`return none`) emitted a bare %none that is never defined.
      def tnNoInit:string (this.varTypeName(nameNode))
      ; `def res@(optional):string` with no value: bind a NULL i8* slot now, the
      ; same way the object case below does. Without a slot the first
      ; assignment invented one, and the type it guessed was i32 -- so a later
      ; `res = someString` stored a pointer into a 32-bit slot.
      if (LowIRUtil.isStringType(tnNoInit)) {
        this.bindSlot(varName "i8*" "null" lctx)
        return
      }
      ; The same for a declared PRIMITIVE with no value (`def d@(optional):double`):
      ; the first assignment would otherwise invent an i32 slot for it.
      if (LowIRUtil.isSupportedPrimitive(tnNoInit)) {
        def primIr:string (LowIRUtil.typeFromRanger(tnNoInit))
        def zeroTxt:string "0"
        if (primIr == "f64") {
          zeroTxt = "0.0"
        }
        this.bindSlot(varName primIr (lctx.builder.emitConst(primIr zeroTxt)) lctx)
        return
      }
      if ((strlen tnNoInit) > 0) {
        if (this.isObjectTypeName(tnNoInit)) {
          def nullObj (lctx.builder.emitConst(lctx.ptrType "0"))
          set lctx.objectSlots varName tnNoInit
          this.bindSlot(varName lctx.ptrType nullObj lctx)
          return
        }
      }
      return
    }
    def val (unwrap valNode)
    if (this.isArrayLiteralValue(nameNode val)) {
      def litElem0:string (this.arrayLiteralElemType(nameNode val lctx))
      def litArr0 (this.lowerArrayLiteral(nameNode val lctx))
      def litOwned0:boolean true
      if (litElem0 == "int") { litOwned0 = false }
      if (litElem0 == "boolean") { litOwned0 = false }
      if (litElem0 == "double") { litOwned0 = false }
      if (litElem0 == "float") { litOwned0 = false }
      if (litElem0 == "char") { litOwned0 = false }
      this.bindPtrArraySlot(varName litArr0 lctx litOwned0)
      if ((strlen litElem0) > 0) {
        set lctx.ptrArrayElemTypes varName litElem0
      }
      return
    }
    if val.has_operator {
      def valOp (val.getOperator())
      ; `def ks:[string] (keys m)` yields a fresh pointer-array of strings. The
      ; element type has to be recorded or every later `itemAt ks i` reads a raw
      ; integer where a string pointer is wanted.
      if (valOp == "keys") {
        def kArr (this.lowerSMapKeys(val lctx))
        this.bindPtrArraySlot(varName kArr lctx true)
        set lctx.ptrArrayElemTypes varName "string"
        return
      }
      if (valOp == "make") {
        def made (this.lowerCollectionMake(val lctx))
        if (this.isObjectPtrArrayTypeNode(nameNode)) {
          this.bindPtrArraySlot(varName made lctx true)
        } {
          this.bindPtrArraySlot(varName made lctx false)
          set lctx.ptrArrayElemTypes varName "int"
        }
        return
      }
    }
    if (val.has_call || val.is_direct_method_call || val.hasFnCall) {
      def callTmp (this.lowerCall(val lctx))
      def irTypeFromCall:string "i32"
      def typeName (this.varTypeName(nameNode))
      if ((strlen typeName) == 0) {
        if (!null? val.fnDesc) {
          if (!null? val.fnDesc.nameNode) {
            def retNode (unwrap val.fnDesc.nameNode)
            typeName = (this.varTypeName(retNode))
          }
        }
      }
      if ((strlen typeName) > 0) {
        irTypeFromCall = (this.llvmTypeForRanger(typeName lctx.ptrType))
        if (this.isObjectTypeName(typeName)) {
          set lctx.objectSlots varName typeName
          ; The callee handed over a reference; this local owns it and releases
          ; it at scope end. Without this `def v:T (this.f())` -- the shape every
          ; line of an evaluator has -- kept its object alive forever.
          if (this.objRcEnabled(lctx)) {
            this.claimObjectTemp(callTmp lctx)
            if (this.isOwnedObjectLocal(varName lctx) == false) {
              push lctx.ownedObjectLocals varName
            }
          }
        }
      }
      ; A call returning a collection ([T] / [int] / map) yields a descriptor
      ; pointer. Register it as a collection slot so for/array_length/itemAt work;
      ; the caller takes ownership (escaped from callee) and releases at scope end.
      ; A [string] local has to be recognised BEFORE the general object-array
      ; case, which also matches non-int element types -- the same ordering the
      ; no-initialiser branch above documents. Without it the element type went
      ; unrecorded for `def names:[string] (this.collect())`, and every later
      ; question about the element ("is it a string?") answered no: reads were
      ; left as raw integers and `(itemAt a i) == (itemAt a j)` compiled to an
      ; integer icmp rather than a string comparison.
      if (this.isStringArrayTypeNode(nameNode)) {
        this.bindPtrArraySlot(varName callTmp lctx true)
        set lctx.ptrArrayElemTypes varName "string"
        return
      }
      if (this.isPlainValueArrayTypeNode(nameNode)) {
        this.bindPtrArraySlot(varName callTmp lctx false)
        set lctx.ptrArrayElemTypes varName nameNode.array_type
        return
      }
      if (this.isObjectPtrArrayTypeNode(nameNode)) {
        this.bindPtrArraySlot(varName callTmp lctx true)
        ; record the ELEMENT type: without it an `itemAt` read out of this local
        ; looked scalar and was widened with `zext i32` over an i64 address.
        set lctx.ptrArrayElemTypes varName nameNode.array_type
        return
      }
      if (this.isIntArrayTypeNode(nameNode)) {
        this.bindPtrArraySlot(varName callTmp lctx false)
        set lctx.ptrArrayElemTypes varName "int"
        return
      }
      if (this.isStringKeyMapTypeNode(nameNode)) {
        this.bindCollectionSlot(varName "smap" callTmp lctx)
        set lctx.smapValueTypes varName nameNode.array_type
        return
      }
      if (this.isIntIntMapTypeNode(nameNode)) {
        this.bindCollectionSlot(varName "map" callTmp lctx)
        return
      }
      ; A STRING result takes a private copy, exactly as every other binding
      ; path does (emitOwnedStringInit). Skipping it here was harmless only
      ; while objects were never freed: a getter that returns a borrowed field
      ; (`toPropertyKey` ends in `return v.stringValue`) handed back a pointer
      ; into an EvalValue that the statement arena then released, so the local
      ; was reading freed memory -- property keys came back as garbage bytes.
      if (irTypeFromCall == "i8*") {
        callTmp = (this.emitOwnedStringInit(varName val callTmp lctx))
      }
      this.bindSlot(varName irTypeFromCall callTmp lctx)
      return
    }
    if val.hasNewOper {
      def clsName (this.newTargetClassName(val lctx))
      if ((strlen clsName) > 0) {
        def argsNode (val.getThird())
        if (this.isOwnedObjectLocal(varName lctx)) {
          this.releaseOwnedLocal(varName lctx)
        }
        def objPtr (this.lowerNewObject(clsName argsNode lctx))
        set lctx.objectSlots varName clsName
        if (this.isOwnedObjectLocal(varName lctx) == false) {
          push lctx.ownedObjectLocals varName
        }
        ; bindSlot zero-inits new pointer slots at entry, so an owned object
        ; local defined only in a conditional branch is NULL (not garbage) on
        ; skipped paths and the scope-end release is a safe no-op.
        this.bindSlot(varName lctx.ptrType objPtr lctx)
        return
      }
    }
    ; a lambda local holds a closure record (RC object) — release it at scope end
    if val.has_lambda {
      def rec (this.lowerLambdaValue(val lctx))
      ; the local now owns the record: claim it out of the statement arena so it
      ; is not double-freed (scope-end release owns its lifetime).
      this.claimObjectTemp(rec lctx)
      if (this.objRcEnabled(lctx)) {
        if (this.isOwnedObjectLocal(varName lctx) == false) {
          push lctx.ownedObjectLocals varName
        }
      }
      this.bindSlot(varName lctx.ptrType rec lctx)
      return
    }
    ; A collection-typed local initialised by an OPERATOR expression
    ; (`def parts:[string] (strsplit s sep)`) also needs its slot registered as
    ; a ptr-array WITH its element type. Without it every later `itemAt parts i`
    ; came back as a raw integer where a string pointer was wanted.
    if (this.isStringArrayTypeNode(nameNode)) {
      def sArrV (this.lowerExpr(val lctx))
      this.retainAliasedArray(val sArrV lctx)
      this.bindPtrArraySlot(varName sArrV lctx true)
      set lctx.ptrArrayElemTypes varName "string"
      return
    }
    if (this.isPlainValueArrayTypeNode(nameNode)) {
      def plainArrV (this.lowerExpr(val lctx))
      this.retainAliasedArray(val plainArrV lctx)
      this.bindPtrArraySlot(varName plainArrV lctx false)
      set lctx.ptrArrayElemTypes varName nameNode.array_type
      return
    }
    if (this.isObjectPtrArrayTypeNode(nameNode)) {
      def oArrV (this.lowerExpr(val lctx))
      this.retainAliasedArray(val oArrV lctx)
      this.bindPtrArraySlot(varName oArrV lctx true)
      set lctx.ptrArrayElemTypes varName nameNode.array_type
      return
    }
    def tmp (this.lowerExpr(val lctx))
    def typeName (this.varTypeName(nameNode))
    def irType (this.llvmTypeForRanger(typeName lctx.ptrType))
    if (val.value_type == RangerNodeType.Boolean) {
      irType = "i1"
    }
    ; L3: a value local mutated by a capturing lambda is promoted to a shared
    ; heap cell (RC object, td=0). Both this scope and the closure reference the
    ; cell; reads/writes go through it, and it is freed once (RC balances the
    ; scope-end release against the closure's retain-on-capture).
    if (this.objRcEnabled(lctx)) {
      if (has lctx.boxedCandidates varName) {
        if ((irType == "i32") || (irType == "i1")) {
          def cell (this.emitBoxCell(lctx))
          ; an i1 does not fit an i32 store; widen it the way every other
          ; boolean-to-word path here does
          def cellVal:string tmp
          if (irType == "i1") {
            cellVal = (lctx.builder.emitZextI1ToI32(tmp))
          }
          lctx.builder.emitStoreI32At(cell 0 cellVal)
          this.bindSlot(varName lctx.ptrType cell lctx)
          set lctx.boxedLocals varName 4
          if (this.isOwnedObjectLocal(varName lctx) == false) {
            push lctx.ownedObjectLocals varName
          }
          return
        }
      }
    }
    if (this.isObjectTypeName(typeName)) {
      set lctx.objectSlots varName typeName
      ; EVERY object local holds a counted reference, borrowed or not. A local
      ; that merely aliased a field (`def out:T scriptReturnValue`) dangled the
      ; moment that field was overwritten later in the same function -- the
      ; overwrite released the only reference while the local still named it.
      if (this.memEnabled(lctx)) {
        this.claimObjectTemp(tmp lctx)
        if ((this.exprCarriesFreshRef(val lctx)) == false) {
          this.emitObjRetainPtr(tmp lctx)
        }
        if (this.isOwnedObjectLocal(varName lctx) == false) {
          push lctx.ownedObjectLocals varName
        }
      }
    }
    if (irType == "i8*") {
      tmp = (this.emitOwnedStringInit(varName val tmp lctx))
    }
    ; A double-typed local initialized from an integer-valued expression: widen
    ; the i32 result to double so the slot store types match.
    if (irType == "f64") {
      if ((this.exprIsF64(val)) == false) {
        tmp = (lctx.builder.emitCast("sitofp" "f64" "i32" tmp))
      }
    }
    ; An `int` local initialized from a 64-bit operator result (file_mtime) has
    ; an i32 slot; narrow the value the way the C++ target's implicit
    ; conversion does, rather than storing an i64 into an i32 slot.
    if (irType == "i32") {
      if (this.exprIsI64Operator(val)) {
        tmp = (lctx.builder.emitCast("trunc" "i32" "i64" tmp))
      }
    }
    ; A JSON-typed initialiser (`def o (unwrap values)`) records its class, so
    ; that keys / array_length / set on the name reach the JSON runtime.
    def jsonTn:string (this.jsonTypeNameOfNode(val lctx))
    if ((strlen jsonTn) > 0) {
      set lctx.objectSlots varName jsonTn
    }
    ; A declared `boolean` local holds an i1. Several sources answer a wider
    ; integer -- a `[string:boolean]` map read comes back through the int path
    ; -- so narrow rather than store an i32 into an i1 slot.
    if (irType == "i1") {
      if ((lctx.builder.emittedType(tmp)) != "i1") {
        if ((this.exprProducesI1(val lctx)) == false) {
          tmp = (this.toI1(tmp lctx))
        }
      }
    }
    this.bindSlot(varName irType tmp lctx)
  }

  ; Operators whose LLVM lowering yields an i64 (not the usual i32).
  fn exprIsI64Operator:boolean (node:CodeNode) {
    def n (this.unwrapInfixExpr(node))
    if n.has_operator {
      if ((n.getOperator()) == "file_mtime") {
        return true
      }
    }
    return false
  }

  ; The object class of the assignment target (a field, possibly receiver.field),
  ; used to resolve a `new` whose own node lacks class info (synthesized default).
  fn assignTargetFieldClass:string (varName:string lctx:LowIRLowerContext) {
    if ((indexOf varName ".") >= 0) {
      def parts:[string] (strsplit varName ".")
      if ((array_length parts) >= 2) {
        def recv (itemAt parts 0)
        def fld (itemAt parts 1)
        def cls (this.resolveObjectClass(recv lctx))
        if ((strlen cls) > 0) {
          return (this.fieldObjectClassName(cls fld lctx))
        }
      }
      return ""
    }
    if (this.resolvesToField(varName lctx)) {
      return (this.fieldObjectClassName(lctx.className varName lctx))
    }
    return ""
  }

  fn lowerAssign:void (node:CodeNode lctx:LowIRLowerContext) {
    def lhs (node.getSecond())
    def rhs (itemAt node.children 2)
    def varName:string lhs.vref
    def builder (lctx.builder)
    def tmp:string ""
    def newCls:string ""
    if rhs.hasNewOper {
      newCls = (this.newTargetClassName(rhs lctx))
      if ((strlen newCls) == 0) {
        newCls = (this.assignTargetFieldClass(varName lctx))
      }
    }
    if ((strlen newCls) > 0) {
      tmp = (this.lowerNewObject(newCls (rhs.getThird()) lctx))
    } {
      tmp = (this.lowerExpr(rhs lctx))
    }
    ; L3: a boxed value local — write through the shared heap cell so the closure
    ; that captured it observes the mutation (and vice versa).
    if (has lctx.boxedLocals varName) {
      def cellPtr (this.loadSlot(varName lctx.ptrType lctx))
      builder.emitStoreI32At(cellPtr 0 tmp)
      return
    }
    def irType:string "i32"
    if ((indexOf varName ".") >= 0) {
      def parts:[string] (strsplit varName ".")
      if ((array_length parts) >= 2) {
        ; The target field is the LAST segment; everything before it is the
        ; receiver chain. For `h.pos.x` the receiver is `h.pos` (resolved by
        ; loading each intermediate object field) and the field is `x`. Using
        ; only the first two segments stored into `h.pos` itself, dropping `.x`.
        def n:int (array_length parts)
        def recvPrefix:string (this.joinDotPrefix(parts (n - 1)))
        def fld (itemAt parts (n - 1))
        def cls (this.resolveObjectClassChain(recvPrefix lctx))
        if ((strlen cls) > 0) {
          def sptr (this.resolveObjectPtrChain(recvPrefix cls lctx))
          ; An object field RETAINS what it is given (emitFieldStoreOnEx), so
          ; the local keeps its own reference and is released normally. This
          ; used to mark the local escaped -- correct under the old borrow/move
          ; model, but once the field started retaining it meant the local's
          ; reference was never given back: one leak per `field = local`, which
          ; is what every `o.key = value` did through assignMember.
          ; A string field takes a dup'd private copy (emitFieldStoreOn), so an
          ; owned string local stored into it is NOT consumed. An object field on
          ; WASM retains a borrowed value / moves a fresh `new` (rhs.hasNewOper).
          this.emitFieldStoreOnEx(cls sptr fld tmp rhs.hasNewOper lctx)
          return
        }
      }
    }
    if (this.resolvesToField(varName lctx)) {
      ; NOTE: do not zext boolean rhs here. emitFieldStore ->
      ; emitFieldStoreOn already widens an i1 value to the i32 storage slot
      ; for boolean fields. Pre-zexting produced an invalid double
      ; "zext i1 <i32> to i32" (the receiver "recv.fld" path above never did
      ; this, which is why only bare field assignments miscompiled).
      this.emitFieldStoreOnEx(lctx.className lctx.selfPtr varName tmp rhs.hasNewOper lctx)
      return
    }
    if (has lctx.slots varName) {
      def slot (unwrap (get lctx.slots varName))
      ; An object assigned into a local slot is no longer a loose statement
      ; temp -- the slot holds it past the end of this statement, so the arena
      ; must not release it. An owned local keeps a counted reference: a
      ; borrowed right-hand side is retained, and the value the slot held BEFORE
      ; is released, because the local has stopped being one of its owners.
      ;
      ; Skipping that release leaked one reference per overwrite. `def target
      ; context` … `target = (context.varScope())` is the shape: the local
      ; retained `context`, then dropped the pointer without giving the
      ; reference back, orphaning a scope on every `var` declaration the engine
      ; processed. Retain-before-release keeps `x = x` safe.
      if (this.memEnabled(lctx)) {
        if (this.slotHoldsObject(varName lctx)) {
          this.claimObjectTemp(tmp lctx)
          if (this.isOwnedObjectLocal(varName lctx)) {
            if ((this.exprCarriesFreshRef(rhs lctx)) == false) {
              this.emitObjRetainPtr(tmp lctx)
            }
            this.releaseOwnedLocal(varName lctx)
          }
        }
      }
      ; An array local reassigned to another array becomes an owner of the new
      ; one and stops owning the old. Storing the descriptor without adjusting
      ; either count left two locals releasing the same array.
      if (this.memEnabled(lctx)) {
        if ((this.collectionKind(varName lctx)) == "ptr_array") {
          if (this.isOwnedCollectionLocal(varName lctx)) {
            this.emitPtrArrayRetain(tmp lctx)
            this.releaseOwnedCollectionLocal(varName lctx)
          }
        }
      }
      ; release-before-reassign: `x = (new T)` on an owned object local must free
      ; the previous object first (the new one is already allocated in `tmp`).
      ; releaseOwnedLocal self-gates on objRcEnabled + escaped, and loads the
      ; slot's current (old) value.
      if (rhs.hasNewOper) {
        if (has lctx.objectSlots varName) {
          if (this.isOwnedObjectLocal(varName lctx)) {
            this.releaseOwnedLocal(varName lctx)
          }
        }
      }
      ; MOVE, not copy: `left = nullish` between two owned object locals leaves
      ; both slots pointing at one object, and each would release it at scope
      ; end. Marking the source escaped hands ownership to the destination, so
      ; the object is freed exactly once -- by whoever still owns it.
      ;
      ; Without this, a function that builds a node and assigns it to the local
      ; it returns (the shape every precedence level of an expression parser is
      ; written in) freed the node it had just returned, and the caller then
      ; wrote through a dangling pointer.
      if (rhs.value_type == RangerNodeType.VRef) {
        if (this.isOwnedObjectLocal(rhs.vref lctx)) {
          set lctx.escapedLocals rhs.vref "1"
        }
      }
      def storeType (irType)
      if (has lctx.slotTypes varName) {
        storeType = (unwrap (get lctx.slotTypes varName))
      }
      if (rhs.value_type == RangerNodeType.Boolean) {
        if (storeType != "i1") {
          tmp = (builder.emitZextI1ToI32(tmp))
          storeType = "i32"
        }
      }
      if (storeType == "i8*") {
        tmp = (this.emitOwnedStringReassign(varName rhs tmp lctx))
      }
      ; A boolean SLOT holds an i1. Several right-hand sides answer a wider
      ; integer -- a `[string:boolean]` map read comes back through the int
      ; path -- so narrow rather than store an i32 into an i1 slot.
      if (storeType == "i1") {
        if ((builder.emittedType(tmp)) != "i1") {
          tmp = (this.toI1(tmp lctx))
        }
      }
      builder.emitStore(storeType tmp slot)
      return
    }
    this.bindSlot(varName irType tmp lctx)
  }

  fn lowerReturn:void (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def voidType:string "void"
    def retType:string lctx.llvmRetType
    if ((array_length node.children) > 1) {
      def valNode (node.getSecond())
      ; A REFERENCE result (object or collection) is counted, so the rule is
      ; uniform and needs no analysis of where the value came from: the returned
      ; reference is retained here and every local keeps releasing normally. The
      ; one exception is an expression that already CARRIES a fresh reference --
      ; a call result or a `new` -- which is handed straight through.
      ;
      ; Trying instead to classify each returned expression as owned-or-borrowed
      ; is what broke: `return this.x` freed the field, and the list of shapes
      ; to recognise (fields, parameters, elements, unwraps, conditionals) never
      ; ends.
      def retObj:boolean (this.isObjectTypeName(lctx.currentRetType))
      ; A MAP type also starts with "[", but an RtSMap carries no refcount --
      ; retaining one wrote through a ptr-array descriptor's rc field onto
      ; unrelated bytes of the map and corrupted it. Maps stay a MOVE.
      def retArr:boolean false
      if (LowIRUtil.isArrayTypeName(lctx.currentRetType)) {
        if ((indexOf lctx.currentRetType ":") < 0) {
          retArr = true
        }
      }
      def retCounted:boolean false
      if (this.memEnabled(lctx)) {
        if (retObj || retArr) {
          retCounted = true
        }
        ; The declared return type is not always usable -- an @(optional) return
        ; can arrive without one -- so also count the case that matters: the
        ; returned name is a local this scope RETAINED when it bound it. Marking
        ; such a local escaped instead skips that release, so every lookup that
        ; found its binding (`def found (get bindings name)` … `return found`)
        ; leaked exactly one reference.
        if (valNode.value_type == RangerNodeType.VRef) {
          if (this.isOwnedObjectLocal(valNode.vref lctx)) {
            if (this.slotHoldsObject(valNode.vref lctx)) {
              retCounted = true
              retObj = true
            }
          }
        }
      }
      if (valNode.value_type == RangerNodeType.VRef) {
        ; A returned local escapes: the caller now owns it, so it must not be
        ; released here. A boxed value local (L3) is the exception: `return
        ; count` copies the VALUE out through the cell, so the cell itself does
        ; NOT escape. A counted reference does not escape either -- it is
        ; retained below, and the local releases its own reference as usual.
        if (has lctx.boxedLocals valNode.vref) {
        } {
          if (retCounted) {
          } {
            set lctx.escapedLocals valNode.vref "1"
          }
        }
      }
      def tmp:string ""
      if (valNode.has_call || valNode.is_direct_method_call) {
        tmp = (this.lowerCall(valNode lctx))
      } {
        tmp = (this.lowerExpr(valNode lctx))
      }
      if (retCounted) {
        if ((this.exprCarriesFreshRef(valNode lctx)) == false) {
          if retObj {
            this.emitObjRetainPtr(tmp lctx)
          } {
            this.emitPtrArrayRetain(tmp lctx)
          }
        }
      }
      ; the returned value escapes to the caller: claim it out of the statement
      ; arena so it is not freed, then release the remaining intermediates (e.g.
      ; the int->string temps of `return ("a" + n)`) before the terminator.
      this.claimStringTemp(tmp lctx)
      this.flushStringTempsFrom(0 lctx)
      ; a returned closure record escapes; release the rest (inline lambda args)
      this.claimObjectTemp(tmp lctx)
      this.flushObjectTempsFrom(0 lctx)
      this.emitReleaseOwnedLocals(lctx)
      ; A boolean function returns i1, but plenty of boolean-valued
      ; expressions arrive as i32 -- a `[string:boolean]` map read comes back
      ; through the int path, for one. Narrow rather than emit `ret i1 <i32>`.
      if (retType == "i1") {
        if ((builder.emittedType(tmp)) != "i1") {
          if ((this.exprProducesI1(valNode lctx)) == false) {
            tmp = (this.toI1(tmp lctx))
          }
        }
      } {
        ; Width coercion against what was actually emitted. A lambda body whose
        ; declared result is `int` can end in a pointer-sized read, and
        ; `ret i32 <i64 value>` does not assemble.
        def emittedRet:string (builder.emittedType(tmp))
        if ((strlen emittedRet) > 0) {
          if (emittedRet != retType) {
            if ((retType == "i32") && (emittedRet == "i64")) {
              tmp = (builder.emitCast("trunc" "i32" "i64" tmp))
            }
            if ((retType == "i64") && (emittedRet == "i32")) {
              tmp = (builder.emitCast("zext" "i64" "i32" tmp))
            }
            if ((retType == "i64") && (emittedRet == "i1")) {
              tmp = (builder.emitCast("zext" "i64" "i1" tmp))
            }
            if ((retType == "i32") && (emittedRet == "i1")) {
              tmp = (builder.emitZextI1ToI32(tmp))
            }
          }
        }
      }
      builder.terminateRet(retType tmp)
    } {
      this.emitReleaseOwnedLocals(lctx)
      if (retType == voidType) {
        builder.terminateRet(voidType "")
      } {
        def zero:string "0"
        def retVal (builder.emitConst("i32" zero))
        builder.terminateRet(retType retVal)
      }
    }
  }

  fn isCompareOp:boolean (op:string) {
    if (op == "==") {
      return true
    }
    if (op == "!=") {
      return true
    }
    if (op == "<") {
      return true
    }
    if (op == ">") {
      return true
    }
    if (op == "<=") {
      return true
    }
    if (op == ">=") {
      return true
    }
    return false
  }

  fn unwrapInfixExpr:CodeNode (node:CodeNode) {
    if node.infix_operator {
      if (!null? node.infix_node) {
        return (unwrap node.infix_node)
      }
    }
    return node
  }

  fn unwrapCondExpr:CodeNode (node:CodeNode) {
    def n (this.unwrapInfixExpr(node))
    if n.expression {
      def ecnt (array_length n.children)
      if (ecnt == 1) {
        return (this.unwrapCondExpr((itemAt n.children 0)))
      }
    }
    ; A parenthesised group does not always carry the `expression` flag, and
    ; stopping at it hid the comparison inside: `if (isStatic == false)` then
    ; looked like a scalar and the i1 was wrapped in a second `icmp ne i32`.
    ; Only a pure wrapper is peeled -- one child, no name, nothing applied.
    if ((array_length n.children) == 1) {
      if ((strlen n.vref) == 0) {
        if ((n.has_operator || n.has_call) == false) {
          if ((n.hasFnCall || n.is_direct_method_call) == false) {
            if ((n.has_lambda || n.has_lambda_call) == false) {
              if (n.hasNewOper == false) {
                if (n.value_type != RangerNodeType.Array) {
                  return (this.unwrapCondExpr((itemAt n.children 0)))
                }
              }
            }
          }
        }
      }
    }
    return n
  }

  fn exprProducesI1:boolean (node:CodeNode lctx:LowIRLowerContext) {
    def exprNode (this.unwrapCondExpr(node))
    if (exprNode.value_type == RangerNodeType.Boolean) {
      return true
    }
    ; A boolean FIELD read off an expression receiver: emitFieldLoadOn narrows
    ; a bool slot to i1, so the comparison has to agree.
    def pi1cls:string (this.propertyReadClass(exprNode lctx))
    if ((strlen pi1cls) > 0) {
      def pi1Node (exprNode.getThird())
      if (this.fieldIsBoolSlot(pi1cls pi1Node.vref)) {
        return true
      }
    }
    ; Operators that answer a boolean. The C helpers behind them return int and
    ; are narrowed to i1 at the call site, so every consumer has to agree they
    ; are i1 -- otherwise a comparison widens the wrong side.
    if exprNode.has_operator {
      def bOp (exprNode.getOperator())
      if (bOp == "has") { return true }
      if (bOp == "contains") { return true }
      if (bOp == "file_exists") { return true }
      if (bOp == "startsWith") { return true }
      if (bOp == "endsWith") { return true }
      if (bOp == "dir_exists") { return true }
      if (bOp == "isArray") { return true }
      if (bOp == "getBoolean") { return true }
      if (bOp == "is_tty") { return true }
      ; A COMPARISON is an i1 by construction. Leaving this out made
      ; `if (isStatic == false)` wrap the icmp in a second `icmp ne i32`.
      if (this.isCompareOp(bOp)) { return true }
      if (bOp == "&&") { return true }
      if (bOp == "||") { return true }
      if (bOp == "!") { return true }
      if (bOp == "null?") { return true }
      if (bOp == "!null?") { return true }
    }
    ; A call THROUGH a lambda value: lowerLambdaCall types the call_indirect
    ; from the node's own eval type, so a boolean-returning callback answers i1
    ; and the `if` around it has to compare an i1, not an i32.
    if exprNode.has_lambda_call {
      if (exprNode.eval_type_name == "boolean") {
        return true
      }
    }
    if (exprNode.has_call || exprNode.is_direct_method_call || exprNode.hasFnCall) {
      if (!null? exprNode.fnDesc) {
        def fd (unwrap exprNode.fnDesc)
        if (!null? fd.nameNode) {
          def rn (unwrap fd.nameNode)
          if (rn.type_name == "boolean") {
            return true
          }
        }
      }
    }
    if (exprNode.value_type == RangerNodeType.VRef) {
      if (has lctx.slotTypes exprNode.vref) {
        def st (unwrap (get lctx.slotTypes exprNode.vref))
        if (st == "i1") {
          return true
        }
      }
      if (this.resolvesToField(exprNode.vref lctx)) {
        if (this.fieldIsBoolSlot(lctx.className exprNode.vref)) {
          return true
        }
      }
      if ((indexOf exprNode.vref ".") >= 0) {
        def parts:[string] (strsplit exprNode.vref ".")
        if ((array_length parts) >= 2) {
          def recv (itemAt parts 0)
          def fld (itemAt parts 1)
          def cls (this.resolveObjectClass(recv lctx))
          if ((strlen cls) > 0) {
            if (this.fieldIsBoolSlot(cls fld)) {
              return true
            }
          }
        }
      }
    }
    if exprNode.has_operator {
      def op (exprNode.getOperator())
      if (op == "||") {
        return true
      }
      if (op == "&&") {
        return true
      }
      if (op == "null?") {
        return true
      }
      if (op == "!null?") {
        return true
      }
      return (this.isCompareOp(op))
    }
    return false
  }

  fn condVref:string (node:CodeNode) {
    if (node.value_type == RangerNodeType.VRef) {
      return node.vref
    }
    if ((array_length node.children) > 0) {
      def child (itemAt node.children 0)
      return (this.condVref(child))
    }
    return ""
  }

  ; An operand of `&&` / `||`, guaranteed to be an i1.
  fn lowerCondOperand:string (node:CodeNode lctx:LowIRLowerContext) {
    return (this.lowerCond(node lctx))
  }

  fn lowerCond:string (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def condNode (this.unwrapCondExpr(node))
    if (condNode.value_type == RangerNodeType.VRef) {
      def vref:string condNode.vref
      if (has lctx.slotTypes vref) {
        def st (unwrap (get lctx.slotTypes vref))
        if (st == "i1") {
          return (this.loadSlot(vref "i1" lctx))
        }
      }
      if (this.resolvesToField(vref lctx)) {
        if (this.fieldIsBoolSlot(lctx.className vref)) {
          return (this.emitFieldLoad(vref lctx))
        }
      }
    }
    def v (this.lowerExpr(condNode lctx))
    ; What was actually EMITTED settles it: a comparison already answers i1,
    ; and wrapping it in `icmp ne i32` produced IR that would not assemble.
    if ((builder.emittedType(v)) == "i1") {
      return v
    }
    if (this.exprProducesI1(condNode lctx)) {
      return v
    }
    def vref (this.condVref(condNode))
    if ((strlen vref) > 0) {
      if (has lctx.slotTypes vref) {
        def st (unwrap (get lctx.slotTypes vref))
        if (st == "i1") {
          return v
        }
      }
    }
    ; A POINTER-sized condition -- `if (node.left)` on an optional reference
    ; field, or on an object local -- has to be tested in the pointer type.
    ; Testing it against an i32 zero emitted `icmp ne i32 <i64 value>, 0`, which
    ; is invalid IR on a 64-bit target and would have looked only at the low
    ; half of the address if it had been accepted.
    ; The type the builder actually emitted decides the comparison; the
    ; source-shape tests below are only for values it did not produce (a
    ; parameter, a global).
    def emitted:string (builder.emittedType(v))
    if ((strlen emitted) > 0) {
      if (emitted == "f64") {
        def zeroFe (builder.emitConst("f64" "0.0"))
        return (builder.emitIcmpTyped("ne" "f64" v zeroFe))
      }
      def zeroE (builder.emitConst(emitted "0"))
      return (builder.emitIcmpTyped("ne" emitted v zeroE))
    }
    if (lctx.ptrType != "i32") {
      if (this.exprIsObjectPtr(condNode lctx)) {
        def zeroP (builder.emitConst(lctx.ptrType "0"))
        return (builder.emitIcmpTyped("ne" lctx.ptrType v zeroP))
      }
    }
    ; A DOUBLE condition -- `if (x)` on a numeric field -- compares against 0.0
    ; in f64. Against an i32 zero it was invalid IR, and would have read the
    ; low half of the bit pattern if it had been accepted.
    if (this.exprIsF64(condNode)) {
      def zeroF (builder.emitConst("f64" "0.0"))
      return (builder.emitIcmpTyped("ne" "f64" v zeroF))
    }
    def zero (builder.emitConst("i32" "0"))
    return (builder.emitIcmp("ne" v zero))
  }

  ; Compare an already-lowered switch subject against one case value.
  fn emitSwitchCaseTest:string (subj:string subjNode:CodeNode caseNode:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def subjIsStr:boolean false
    if ((builder.emittedType(subj)) == "i8*") {
      subjIsStr = true
    }
    if (this.exprIsStringish(subjNode lctx)) {
      subjIsStr = true
    }
    if subjIsStr {
      def caseVal (this.lowerExpr(caseNode lctx))
      return (this.emitStrcmpEq(subj caseVal lctx))
    }
    def cv (this.lowerExpr(caseNode lctx))
    def st:string (builder.emittedType(subj))
    if ((strlen st) == 0) {
      st = "i32"
    }
    return (builder.emitIcmpTyped("eq" st subj cv))
  }

  ; `try { … } { … }`. There is no unwinding on this backend and nothing that
  ; throws except a failing `unwrap`, so the handler is an ordinary block the
  ; failing unwrap branches to. That is exactly what the compiler's own sources
  ; use it for: RangerFlowParser's EnterStaticMethod does
  ;   try { def m (unwrap (desc.findStaticMethod(…))) … } { ctx.addError(…) }
  ; and with the handler dropped, the null went straight into `m.fnCtx = …`.
  fn lowerTry:void (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def cnt (array_length node.children)
    if (cnt < 2) {
      return
    }
    def tryBlock (node.getSecond())
    def catchL (builder.freshLabel("catch"))
    def endL (builder.freshLabel("try_end"))
    def savedCatch:string lctx.catchLabel
    lctx.catchLabel = catchL
    this.lowerBlock(tryBlock lctx)
    lctx.catchLabel = savedCatch
    if (!null? builder.currentBlock) {
      def tb (unwrap builder.currentBlock)
      if (tb.termKind == "") {
        builder.terminateBr(endL)
      }
    }
    builder.startBlock(catchL)
    if (cnt > 2) {
      def catchBlock (node.getThird())
      this.lowerBlock(catchBlock lctx)
    }
    if (!null? builder.currentBlock) {
      def cb (unwrap builder.currentBlock)
      if (cb.termKind == "") {
        builder.terminateBr(endL)
      }
    }
    builder.startBlock(endL)
  }

  ; A null `unwrap` inside a `try` jumps to the handler. Only pointer-shaped
  ; values are checked: `unwrap` over an int or a boolean cannot be the failing
  ; kind, and comparing one against zero would branch on a legitimate 0.
  fn guardUnwrapInTry:void (value:string lctx:LowIRLowerContext) {
    if ((strlen lctx.catchLabel) == 0) {
      return
    }
    def builder (lctx.builder)
    def vt:string (builder.emittedType(value))
    def isPtr:boolean false
    if (vt == lctx.ptrType) { isPtr = true }
    if (vt == "i8*") { isPtr = true }
    if (isPtr == false) {
      return
    }
    ; an i8* zero is spelled `null`; `add i8* 0, 0` is not an instruction
    def zero:string "null"
    if (vt != "i8*") {
      zero = (builder.emitConst(vt "0"))
    }
    def isNull (builder.emitIcmpTyped("eq" vt value zero))
    def okL (builder.freshLabel("unwrap_ok"))
    builder.terminateBrIf(isNull lctx.catchLabel okL)
    builder.startBlock(okL)
  }

  fn lowerSwitch:void (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    if ((array_length node.children) < 3) {
      return
    }
    def subjNode (node.getSecond())
    def caseList (node.getThird())
    def subj (this.lowerExpr(subjNode lctx))
    def endL (builder.freshLabel("switch_end"))
    def defaultBlock@(optional):CodeNode
    def savedBreak:string lctx.breakLabel
    lctx.breakLabel = endL
    for caseList.children arm:CodeNode ai {
      if ((array_length arm.children) < 2) {
        continue
      }
      def head:string (arm.getVRefAt(0))
      if (head == "default") {
        defaultBlock = (arm.getSecond())
        continue
      }
      if (head != "case") {
        continue
      }
      def caseVal (arm.getSecond())
      def bodyNode (arm.getThird())
      def hit (this.emitSwitchCaseTest(subj subjNode caseVal lctx))
      def bodyL (builder.freshLabel("case_body"))
      def nextL (builder.freshLabel("case_next"))
      builder.terminateBrIf(hit bodyL nextL)
      builder.startBlock(bodyL)
      this.lowerBlock(bodyNode lctx)
      def bb (unwrap builder.currentBlock)
      if (bb.termKind == "") {
        builder.terminateBr(endL)
      }
      builder.startBlock(nextL)
    }
    if (!null? defaultBlock) {
      this.lowerBlock((unwrap defaultBlock) lctx)
      def dbb (unwrap builder.currentBlock)
      if (dbb.termKind == "") {
        builder.terminateBr(endL)
      }
    } {
      builder.terminateBr(endL)
    }
    builder.startBlock(endL)
    lctx.breakLabel = savedBreak
  }

  ; --- shapes (PLAN_SHAPES.md) ------------------------------------------
  ;
  ; A shape desugars to one record class per case plus a union over them, so on
  ; this backend a shape value is simply a pointer to the case object. Every
  ; object already carries its RangerTypeDesc, and the virtual dispatcher
  ; already narrows on it -- so `is` and `case` are the same descriptor compare
  ; that dispatch uses, and no new representation is needed.
  ;
  ; The case class an `x:Shape.Case` binding names. The desugaring has already
  ; rewritten `Shape.Case` to the generated record name by the time this runs.
  fn shapeCaseClassName:string (itemNode:CodeNode) {
    def tn:string itemNode.type_name
    if ((strlen tn) == 0) {
      tn = itemNode.eval_type_name
    }
    ; `Shape.Case` spelled with a dot names the same generated `Shape_Case`
    def dotAt:int (indexOf tn ".")
    if (dotAt > 0) {
      tn = ((substring tn 0 dotAt) + ("_" + (substring tn (dotAt + 1) (strlen tn))))
    }
    return tn
  }

  ; Does the module carry a runtime type descriptor for this class? A `union`
  ; over SYSTEM classes -- the JSON family is the one in this compiler -- has no
  ; lowered struct and no descriptor, because that family lives in
  ; runtime/ranger_json.c rather than in the object system. Narrowing one is not
  ; a descriptor compare, so `case`/`is` over it is left alone here exactly as
  ; it was before this backend understood the operators at all.
  fn moduleHasTypeDesc:boolean (className:string) {
    for this.irModule.typeDescs td:LowIRTypeDesc i {
      if (td.className == className) {
        return true
      }
    }
    return false
  }

  ; `ranger_obj_type(v) == @Case_typeDesc` -- false for a null v, because
  ; ranger_obj_type answers 0 for one and no descriptor lives at address 0.
  fn emitShapeKindTest:string (val:string caseClass:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def pt:string lctx.ptrType
    def typeParams:[string]
    push typeParams pt
    this.ensureExternDecl("ranger_obj_type" pt typeParams false)
    def args:[string]
    def argTypes:[string]
    push args val
    push argTypes pt
    def rtType (builder.emitCall("ranger_obj_type" pt args argTypes))
    def tdp (builder.emitTypeDescPtr(caseClass))
    return (builder.emitIcmpTyped("eq" pt rtType tdp))
  }

  ; `(is v _:Shape.Case)` -- the kind test alone, as an expression.
  fn lowerShapeIs:string (node:CodeNode lctx:LowIRLowerContext) {
    def valNode (node.getSecond())
    def itemNode (node.getThird())
    def caseClass:string (this.shapeCaseClassName(itemNode))
    if ((this.moduleHasTypeDesc(caseClass)) == false) {
      return ""
    }
    def val (this.lowerExpr(valNode lctx))
    return (this.emitShapeKindTest(val caseClass lctx))
  }

  ; `case v x:Shape.Case { … }` -- the same test, and the arm runs with `x`
  ; bound to the very same pointer, narrowed to the case class. Nothing is
  ; copied: the binding aliases the scrutinee, exactly as the C#/Kotlin/Dart
  ; `is` narrowing does.
  fn lowerShapeCase:void (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def valNode (node.getSecond())
    def itemNode (node.getThird())
    def bodyNode (itemAt node.children 3)
    def caseClass:string (this.shapeCaseClassName(itemNode))
    if ((this.moduleHasTypeDesc(caseClass)) == false) {
      return
    }
    def val (this.lowerExpr(valNode lctx))
    def cond (this.emitShapeKindTest(val caseClass lctx))
    def armLabel (builder.freshLabel("case_arm"))
    def endLabel (builder.freshLabel("case_end"))
    builder.terminateBrIf(cond armLabel endLabel)
    builder.startBlock(armLabel)
    def itemName:string itemNode.vref
    ; `_` is the placeholder the `is`-style spelling uses; it binds nothing
    if ((strlen itemName) > 0) {
      if (itemName != "_") {
        push lctx.shadowStack itemName
        def prevSlot:string (this.shadowBind(itemName lctx.ptrType val lctx))
        set lctx.objectSlots itemName caseClass
        this.lowerBlock(bodyNode lctx)
        this.restoreShadow(itemName prevSlot lctx)
        removeLast lctx.shadowStack
      } {
        this.lowerBlock(bodyNode lctx)
      }
    } {
      this.lowerBlock(bodyNode lctx)
    }
    def armBlock (unwrap builder.currentBlock)
    if (armBlock.termKind == "") {
      builder.terminateBr(endLabel)
    }
    builder.startBlock(endLabel)
  }

  fn lowerIf:void (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def condNode (node.getSecond())
    def thenNode (node.getThird())
    def condMark (array_length lctx.pendingStringTemps)
    def objCondMark (array_length lctx.pendingObjectTemps)
    def cond (this.lowerCond(condNode lctx))
    ; a fresh string temp built in the condition (e.g. (("a"+x) == y)) is dead
    ; once the i1 is computed; free it here, in the pre-branch block where it is
    ; still valid, rather than leaking to the merge block.
    this.flushStringTempsFrom(condMark lctx)
    this.flushObjectTempsFrom(objCondMark lctx)
    def thenTag:string "then"
    def elseTag:string "else"
    def mergeTag:string "merge"
    def thenLabel (builder.freshLabel(thenTag))
    def elseLabel (builder.freshLabel(elseTag))
    def mergeLabel (builder.freshLabel(mergeTag))

    def hasElse:boolean false
    if ((array_length node.children) > 3) {
      hasElse = true
    }

    if hasElse {
      builder.terminateBrIf(cond thenLabel elseLabel)
    } {
      builder.terminateBrIf(cond thenLabel mergeLabel)
    }

    builder.startBlock(thenLabel)
    this.lowerBlock(thenNode lctx)
    def thenBlock (unwrap builder.currentBlock)
    if (thenBlock.termKind == "") {
      builder.terminateBr(mergeLabel)
    }

    if hasElse {
      def elseNode@(optional):CodeNode
      if ((array_length node.children) > 3) {
        elseNode = (itemAt node.children 3)
      }
      if (!null? elseNode) {
        builder.startBlock(elseLabel)
        this.lowerBlock((unwrap elseNode) lctx)
        def elseBlock (unwrap builder.currentBlock)
        if (elseBlock.termKind == "") {
          builder.terminateBr(mergeLabel)
        }
      }
    }

    builder.startBlock(mergeLabel)
  }

  ; `break` / `continue`: branch to the innermost loop's exit or condition
  ; block. Neither was lowered at all before -- they emitted NOTHING, so a loop
  ; whose only way out was a `break` spun forever. That is what made every
  ; exponent literal (`1e5`, whose lexer loop ends on a break) hang the engine.
  ;
  ; Statements after the jump are unreachable but still get lowered, so a fresh
  ; block catches them: appending them to the block just terminated would put
  ; instructions after a terminator, which is invalid IR.
  ; Emit releases for the locals the innermost loop body introduced, WITHOUT
  ; retiring them from the owned lists (unlike releaseLoopBodyOwned, which runs
  ; once at the bottom of the body and does retire them).
  fn emitLoopBodyReleases:void (lctx:LowIRLowerContext) {
    if ((this.memEnabled(lctx)) == false) {
      return
    }
    def n (array_length lctx.ownedObjectLocals)
    def k lctx.loopOwnedMark
    while (< k n) {
      this.releaseAndClearOwnedLocal((itemAt lctx.ownedObjectLocals k) lctx)
      k = (+ k 1)
    }
    def cn (array_length lctx.ownedCollectionLocals)
    def ck lctx.loopOwnedCollMark
    while (< ck cn) {
      this.releaseAndClearOwnedCollection((itemAt lctx.ownedCollectionLocals ck) lctx)
      ck = (+ ck 1)
    }
    ; Owned string locals leave through a jump too. releaseOwnedString NULLs the
    ; slot, so the bottom-of-body release on the fall-through path sees NULL
    ; rather than a pointer this one already freed.
    def sn (array_length lctx.ownedStringLocals)
    def sk lctx.loopOwnedStrMark
    while (< sk sn) {
      this.releaseOwnedString((itemAt lctx.ownedStringLocals sk) lctx)
      sk = (+ sk 1)
    }
  }

  fn lowerLoopJump:void (target:string lctx:LowIRLowerContext) {
    if ((strlen target) == 0) {
      return
    }
    def builder (lctx.builder)
    if (!null? builder.currentBlock) {
      def cur (unwrap builder.currentBlock)
      if (cur.termKind != "") {
        return
      }
    }
    ; Everything this iteration allocated is released on the way out. The
    ; end-of-body release is at the BOTTOM of the loop, which a jump never
    ; reaches -- so a loop that exits through `break` leaked every object the
    ; final iteration made, and one that `continue`s leaked on every turn.
    ; The owned lists are not truncated here: lowering continues after the jump,
    ; and the bottom-of-body release still needs to see them.
    this.emitLoopBodyReleases(lctx)
    builder.terminateBr(target)
    builder.startBlock((builder.freshLabel("after_jump")))
  }

  fn lowerWhile:void (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def condNode (node.getSecond())
    def bodyNode (node.getThird())
    def condTag:string "while_cond"
    def bodyTag:string "while_body"
    def exitTag:string "while_exit"
    def condLabel (builder.freshLabel(condTag))
    def bodyLabel (builder.freshLabel(bodyTag))
    def exitLabel (builder.freshLabel(exitTag))

    builder.terminateBr(condLabel)
    builder.startBlock(condLabel)
    def condMark (array_length lctx.pendingStringTemps)
    def objCondMark (array_length lctx.pendingObjectTemps)
    def cond (this.lowerCond(condNode lctx))
    ; free per-iteration condition string temps in the condition block (runs each
    ; iteration), so a loop whose test builds a string doesn't leak every turn.
    this.flushStringTempsFrom(condMark lctx)
    this.flushObjectTempsFrom(objCondMark lctx)
    builder.terminateBrIf(cond bodyLabel exitLabel)

    ; snapshot owned-object and owned-string locals so any declared INSIDE the
    ; loop body are released once per iteration (block scope), not leaked until
    ; function end — critical for per-frame throwaway strings.
    def ownedBefore (array_length lctx.ownedObjectLocals)
    def ownedStrBefore (array_length lctx.ownedStringLocals)
    def ownedCollBefore (array_length lctx.ownedCollectionLocals)

    builder.startBlock(bodyLabel)
    def savedBreakW:string lctx.breakLabel
    def savedContW:string lctx.continueLabel
    def savedMarkW:int lctx.loopOwnedMark
    def savedMarkStrW:int lctx.loopOwnedStrMark
    def savedMarkCollW:int lctx.loopOwnedCollMark
    lctx.breakLabel = exitLabel
    lctx.continueLabel = condLabel
    lctx.loopOwnedMark = ownedBefore
    lctx.loopOwnedStrMark = ownedStrBefore
    lctx.loopOwnedCollMark = ownedCollBefore
    this.lowerBlock(bodyNode lctx)
    lctx.breakLabel = savedBreakW
    lctx.continueLabel = savedContW
    lctx.loopOwnedMark = savedMarkW
    lctx.loopOwnedStrMark = savedMarkStrW
    lctx.loopOwnedCollMark = savedMarkCollW
    def bodyBlock (unwrap builder.currentBlock)
    if (bodyBlock.termKind == "") {
      this.releaseLoopBodyOwned(ownedBefore ownedStrBefore ownedCollBefore lctx)
      builder.terminateBr(condLabel)
    }

    builder.startBlock(exitLabel)
  }

  ; Release owned-object locals that were introduced within a loop body (indices
  ; >= ownedBefore), then drop them from the function-level list so the scope-end
  ; cleanup does not double-release. Escaped locals are skipped by releaseOwned
  ; Local. Gated on -wasmrc so the native path's existing behaviour is unchanged.
  ; Release a loop-body local and NULL its slot. The slot is zero-initialised
  ; once, at function entry, not per iteration -- so a local declared inside a
  ; branch that a later iteration does not take would still hold the pointer
  ; released on the previous turn, and be released a second time.
  fn releaseAndClearOwnedLocal:void (varName:string lctx:LowIRLowerContext) {
    this.releaseOwnedLocal(varName lctx)
    if (has lctx.escapedLocals varName) {
      return
    }
    if (false == (has lctx.slots varName)) {
      return
    }
    if ((this.slotHoldsObject(varName lctx)) == false) {
      return
    }
    def slot (unwrap (get lctx.slots varName))
    def zero (lctx.builder.emitConst(lctx.ptrType "0"))
    lctx.builder.emitStore(lctx.ptrType zero slot)
  }

  ; The collection twin of releaseAndClearOwnedLocal: same stale-slot hazard,
  ; and a descriptor released twice takes its refcount below zero and frees a
  ; live array.
  fn releaseAndClearOwnedCollection:void (varName:string lctx:LowIRLowerContext) {
    this.releaseOwnedCollectionLocal(varName lctx)
    if (has lctx.escapedLocals varName) {
      return
    }
    if (false == (has lctx.slots varName)) {
      return
    }
    def slot (unwrap (get lctx.slots varName))
    def zero (lctx.builder.emitConst(lctx.ptrType "0"))
    lctx.builder.emitStore(lctx.ptrType zero slot)
  }

  fn releaseLoopBodyOwned:void (ownedBefore:int ownedStrBefore:int ownedCollBefore:int lctx:LowIRLowerContext) {
    def ctx (unwrap lctx.ctx)
    ; Per-iteration release is not a WASM nicety -- it is the difference between
    ; a loop that holds one object and one that holds a million. Gating it on
    ; -wasmrc meant every object a native loop body created stayed alive until
    ; the FUNCTION returned: an interpreter loop leaked one EvalValue per
    ; iteration, so a benchmark grew ~100 MB/s and never finished.
    if (this.memEnabled(lctx)) {
    } {
      if ((ctx.hasCompilerFlag("wasmrc")) == false) {
        return
      }
    }
    def n (array_length lctx.ownedObjectLocals)
    if (n > ownedBefore) {
      def k ownedBefore
      while (< k n) {
        this.releaseAndClearOwnedLocal((itemAt lctx.ownedObjectLocals k) lctx)
        k = (+ k 1)
      }
      def kept:[string]
      def j 0
      while (< j ownedBefore) {
        push kept (itemAt lctx.ownedObjectLocals j)
        j = (+ j 1)
      }
      lctx.ownedObjectLocals = kept
    }
    ; same per-iteration release for owned string locals introduced in the body
    def sn (array_length lctx.ownedStringLocals)
    if (sn > ownedStrBefore) {
      def sk ownedStrBefore
      while (< sk sn) {
        this.releaseOwnedString((itemAt lctx.ownedStringLocals sk) lctx)
        sk = (+ sk 1)
      }
      def keptS:[string]
      def sj 0
      while (< sj ownedStrBefore) {
        push keptS (itemAt lctx.ownedStringLocals sj)
        sj = (+ sj 1)
      }
      lctx.ownedStringLocals = keptS
    }
    ; same per-iteration release for owned collection locals introduced in the body
    def cn (array_length lctx.ownedCollectionLocals)
    if (cn > ownedCollBefore) {
      def ck ownedCollBefore
      while (< ck cn) {
        this.releaseAndClearOwnedCollection((itemAt lctx.ownedCollectionLocals ck) lctx)
        ck = (+ ck 1)
      }
      def keptC:[string]
      def cj 0
      while (< cj ownedCollBefore) {
        push keptC (itemAt lctx.ownedCollectionLocals cj)
        cj = (+ cj 1)
      }
      lctx.ownedCollectionLocals = keptC
    }
  }

  fn lowerExpr:string (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def irI32:string "i32"
    def irF64:string "f64"
    def irI1:string "i1"
    def zero:string "0"
    def one:string "1"

    ; a call through a lambda value -> call_indirect (checked before has_call,
    ; which is also set on the node)
    if node.has_lambda_call {
      return (this.lowerLambdaCall(node lctx))
    }
    ; a lambda literal -> a closure record
    if node.has_lambda {
      return (this.lowerLambdaValue(node lctx))
    }

    ; `(new T)` in VALUE position -- a call argument, a `set m k (new T())`, a
    ; `push xs (new T())`. It also carries has_call (the constructor), so the
    ; branch below claimed it first and lowerCall fell through to a bare
    ; `%new`. Every place that already handled `new` did so before calling
    ; lowerExpr at all, which is why only these positions were affected.
    if node.hasNewOper {
      def newCls (this.newTargetClassName(node lctx))
      if ((strlen newCls) > 0) {
        return (this.lowerNewObject(newCls (node.getThird()) lctx))
      }
    }

    if (node.has_call || node.is_direct_method_call) {
      return (this.lowerCall(node lctx))
    }

    ; `(property obj field)` — the flow parser rewrites a field read off an
    ; EXPRESSION receiver (`(itemAt xs i).isHole`) into this shape. It does not
    ; carry has_operator, so it slipped past the operator switch and reached the
    ; VRef path, which emitted the bare head name `%property` -- not a value.
    if (this.isPropertyReadNode(node)) {
      return (this.lowerPropertyRead(node lctx))
    }

    if node.infix_operator {
      if (!null? node.infix_node) {
        return (this.lowerExpr((unwrap node.infix_node) lctx))
      }
    }

    if node.has_operator {
      def opName (node.getOperator())
      ; JSON first: keys / array_length / to_string are shared with the
      ; collection operators, and the receiver decides which one is meant.
      if (opName == "json_object") {
        return (this.lowerJsonNew("RtJson_new_object" lctx))
      }
      if (opName == "json_array") {
        return (this.lowerJsonNew("RtJson_new_array" lctx))
      }
      if (opName == "getStr") {
        return (this.lowerJsonGet(node "RtJson_get_str" "i8*" "i8*" lctx))
      }
      if (opName == "getInt") {
        def rawI (this.lowerJsonGet(node "RtJson_get_int" "i64" "i64" lctx))
        return (lctx.builder.emitCast("trunc" "i32" "i64" rawI))
      }
      if (opName == "getDouble") {
        return (this.lowerJsonGet(node "RtJson_get_double" "f64" "f64" lctx))
      }
      if (opName == "getBoolean") {
        return (this.toI1((this.lowerJsonGet(node "RtJson_get_bool" "i32" "i32" lctx)) lctx))
      }
      if (opName == "getObject") {
        return (this.lowerJsonGet(node "RtJson_get_object" "i64" "i64" lctx))
      }
      if (opName == "getArray") {
        return (this.lowerJsonGet(node "RtJson_get_array" "i64" "i64" lctx))
      }
      if (opName == "getValue") {
        return (this.lowerJsonGetValue(node lctx))
      }
      if (opName == "isArray") {
        return (this.toI1((this.lowerJson1(node "RtJson_is_array" "i32" lctx)) lctx))
      }
      ; `asArray` narrows a union to an array handle -- the same pointer.
      if (opName == "asArray") {
        return (this.lowerExpr((node.getSecond()) lctx))
      }
      if (opName == "from_string") {
        return (this.lowerJson1(node "RtJson_parse" "i64" lctx))
      }
      if (opName == "get") {
        return (this.lowerCollectionGet(node lctx))
      }
      if (opName == "has") {
        return (this.lowerCollectionHas(node lctx))
      }
      if (opName == "array_length") {
        if (this.nodeIsJson((node.getSecond()) lctx)) {
          return (this.lowerJson1(node "RtJson_length" "i32" lctx))
        }
        return (this.lowerCollectionLen(node lctx))
      }
      if (opName == "keys") {
        if (this.nodeIsJson((node.getSecond()) lctx)) {
          return (this.lowerJson1(node "RtJson_keys" "i64" lctx))
        }
        return (this.lowerSMapKeys(node lctx))
      }
      ; `indexOf` is BOTH the string search and the array one -- the compiler
      ; writes `(indexOf m.isCalledBy this)` to find an element. Lowering every
      ; one to ranger_str_index_of handed a descriptor to a routine expecting
      ; i8*, which clang rejects.
      if (opName == "indexOf") {
        if (this.nodeIsArrayExpr((node.getSecond()) lctx)) {
          return (this.lowerArrayIndexOf(node lctx))
        }
        return (this.lowerStr2Fn(node "ranger_str_index_of" "i32" lctx))
      }
      if (opName == "lastIndexOf") {
        return (this.lowerStr2Fn(node "ranger_str_last_index_of" "i32" lctx))
      }
      if (opName == "contains") {
        return (this.toI1((this.lowerStr2Fn(node "ranger_str_contains" "i32" lctx)) lctx))
      }
      if (opName == "startsWith") {
        return (this.toI1((this.lowerStr2Fn(node "ranger_str_starts_with" "i32" lctx)) lctx))
      }
      if (opName == "endsWith") {
        return (this.toI1((this.lowerStr2Fn(node "ranger_str_ends_with" "i32" lctx)) lctx))
      }
      ; `replace` changes EVERY occurrence (the operator's documented contract),
      ; so the C helper loops rather than stopping at the first hit.
      if (opName == "replace") {
        return (this.lowerStr3Fn(node "ranger_str_replace" lctx))
      }
      if (opName == "indexOfFrom") {
        return (this.lowerStr2IntFn(node "ranger_str_index_of_from" "i32" lctx))
      }
      if (opName == "sha256") {
        return (this.lowerStr1Fn(node "ranger_sha256_hex" lctx))
      }
      if (opName == "sort") {
        return (this.lowerArraySort(node lctx))
      }
      ; The ternary `(? cond a b)`. `max` and `min` are macros that expand to
      ; it, so a `(max a b)` anywhere emitted a bare `%?`.
      if (opName == "?") {
        return (this.lowerTernary(node lctx))
      }
      ; `join xs sep` -- the ptr-array of strings and the separator go to C,
      ; which knows the descriptor layout (the same one strsplit builds).
      if (opName == "join") {
        def jArrNode (node.getSecond())
        def jSepNode (node.getThird())
        def jDesc (this.loadArrayDescExpr(jArrNode lctx))
        def jSep (this.lowerExpr(jSepNode lctx))
        def jPs:[string]
        push jPs "i64"
        push jPs "i8*"
        this.ensureExternDecl("ranger_str_join" "i8*" jPs false)
        def jArgs:[string]
        def jTypes:[string]
        push jArgs jDesc
        push jTypes lctx.ptrType
        push jArgs jSep
        push jTypes "i8*"
        def jRes (lctx.builder.emitCall("ranger_str_join" "i8*" jArgs jTypes))
        this.registerFreshStringTemp(jRes lctx)
        return jRes
      }
      ; `current_time_ms` -- the same wall clock `wall_clock_ms` already reads.
      def ansiV:string (this.tryLowerAnsi(opName lctx))
      if ((strlen ansiV) > 0) {
        return ansiV
      }
      if (opName == "is_tty") {
        def ttyPs:[string]
        this.ensureExternDecl("ranger_is_tty" "i32" ttyPs false)
        def ttyArgs:[string]
        def ttyTypes:[string]
        return (this.toI1((lctx.builder.emitCall("ranger_is_tty" "i32" ttyArgs ttyTypes)) lctx))
      }
      if (opName == "current_time_ms") {
        def tPs:[string]
        this.ensureExternDecl("ranger_wall_clock_ms" "double" tPs false)
        def tArgs:[string]
        def tTypes:[string]
        return (lctx.builder.emitCall("ranger_wall_clock_ms" "f64" tArgs tTypes))
      }
      ; A charbuffer is the string's own bytes on this backend, the way the C++
      ; template hands back `c_str()`.
      if (opName == "to_charbuffer") {
        return (this.lowerExpr((node.getSecond()) lctx))
      }
      ; `array_extract xs i` removes the i-th element AND answers it.
      if (opName == "array_extract") {
        return (this.lowerArrayExtract(node lctx))
      }
      if (opName == "reverse") {
        return (this.lowerArrayReverse(node lctx))
      }
      if (opName == "trim") {
        return (this.lowerStr1Fn(node "ranger_str_trim" lctx))
      }
      if (opName == "trim_right") {
        return (this.lowerStr1Fn(node "ranger_str_trim_right" lctx))
      }
      if (opName == "normalize") {
        return (this.lowerStr1Fn(node "ranger_path_normalize" lctx))
      }
      ; `pathname` is the compiler's own name for dirname.
      if ((opName == "path_dirname") || (opName == "pathname")) {
        return (this.lowerStr1Fn(node "ranger_path_dirname" lctx))
      }
      if (opName == "current_directory") {
        return (this.lowerStr0Fn("ranger_current_directory" lctx))
      }
      ; The directory of argv[0]: the compiler looks for Lang.rgr and lib/ next
      ; to its own executable, the same rule the C++ build follows.
      if (opName == "install_directory") {
        return (this.lowerStr0Fn("ranger_install_directory" lctx))
      }
      if (opName == "to_lowercase") {
        return (this.lowerStr1Fn(node "ranger_str_lower" lctx))
      }
      if (opName == "to_uppercase") {
        return (this.lowerStr1Fn(node "ranger_str_upper" lctx))
      }
      if (opName == "file_exists") {
        return (this.toI1((this.lowerStr2Fn(node "ranger_file_exists" "i32" lctx)) lctx))
      }
      if (opName == "dir_exists") {
        return (this.toI1((this.lowerStr1IntFn(node "ranger_dir_exists" "i32" lctx)) lctx))
      }
      ; `env_var` is optional:string. An unset variable is a NULL pointer, which
      ; is what `null?` on a string compares against on this backend.
      if (opName == "env_var") {
        return (this.lowerStr1Fn(node "ranger_env_var" lctx))
      }
      ; `cast` carries no runtime meaning here: every object is an untyped
      ; pointer in the IR, so the value passes through. Without this the node
      ; reached the VRef path and emitted a bare `%cast`.
      if (opName == "cast") {
        return (this.lowerExpr((node.getSecond()) lctx))
      }
      ; The `try` writer has no exception value to bind on this backend, so
      ; `error_msg` answers the same placeholder the C++ template does.
      if (opName == "error_msg") {
        def emG (this.internStringGlobal("unspecified error" false))
        def emLen (this.stringGlobalByteLen(emG))
        return (lctx.builder.emitStrPtr(emG emLen))
      }
      if (opName == "M_PI") {
        return (lctx.builder.emitConst("f64" "3.141592653589793"))
      }
      ; libm unary/binary doubles. Each maps 1:1 onto the C function of the
      ; same name, so one shared lowering covers them all.
      if (this.isLibmUnaryOp(opName)) {
        return (this.lowerLibmUnary(opName node lctx))
      }
      if (this.isLibmBinaryOp(opName)) {
        return (this.lowerLibmBinary(opName node lctx))
      }
      if (opName == "buffer_to_string") {
        def bNode2 (node.getSecond())
        def bufV (this.lowerExpr(bNode2 lctx))
        def bLen (this.emitPtrArrayLenOrBufferLen(bufV lctx))
        def bp:[string]
        push bp "i64"
        push bp "i32"
        this.ensureExternDecl("ranger_buffer_to_string" "i8*" bp false)
        def bArgs:[string]
        def bTypes:[string]
        push bArgs bufV
        push bTypes lctx.ptrType
        push bArgs bLen
        push bTypes "i32"
        def bRes (lctx.builder.emitCall("ranger_buffer_to_string" "i8*" bArgs bTypes))
        this.registerFreshStringTemp(bRes lctx)
        return bRes
      }
      if (opName == "file_mtime") {
        return (this.lowerStr2Fn(node "ranger_file_mtime" "i64" lctx))
      }
      if (opName == "random") {
        def rp:[string]
        this.ensureExternDecl("ranger_random" "double" rp false)
        def rArgs:[string]
        def rTypes:[string]
        return (lctx.builder.emitCall("ranger_random" "f64" rArgs rTypes))
      }
      if (opName == "wall_clock_ms") {
        def wp:[string]
        this.ensureExternDecl("ranger_wall_clock_ms" "double" wp false)
        def wArgs:[string]
        def wTypes:[string]
        return (lctx.builder.emitCall("ranger_wall_clock_ms" "f64" wArgs wTypes))
      }
      ; `strsplit s sep` -> a fresh ptr-array of owned strings, built by the C
      ; runtime (the RtPtrArray_* routines are emitted IR and cannot be called
      ; from C, but the descriptor layout is shared).
      if (opName == "strsplit") {
        def spA (node.getSecond())
        def spB (node.getThird())
        def spAv (this.lowerExpr(spA lctx))
        def spBv (this.lowerExpr(spB lctx))
        def spDecl:[string]
        push spDecl "i8*"
        push spDecl "i8*"
        this.ensureExternDecl("ranger_str_split" lctx.ptrType spDecl false)
        def spArgs:[string]
        def spTypes:[string]
        push spArgs spAv
        push spTypes "i8*"
        push spArgs spBv
        push spTypes "i8*"
        return (lctx.builder.emitCall("ranger_str_split" lctx.ptrType spArgs spTypes))
      }
      if (opName == "strlen") {
        return (this.lowerStrlen(node lctx))
      }
      if (opName == "is") {
        if ((array_length node.children) > 2) {
          return (this.lowerShapeIs(node lctx))
        }
      }
      if (opName == "length") {
        def lenNode (node.getSecond())
        if (lenNode.value_type == RangerNodeType.VRef) {
          def pdesc (this.ptrArrayDescFromVref(lenNode.vref lctx))
          if ((strlen pdesc) > 0) {
            return (this.emitPtrArrayLen(pdesc lctx))
          }
        }
        if ((strlen (this.collectionKind(lenNode.vref lctx))) > 0) {
          return (this.lowerCollectionLen(node lctx))
        }
        if (lenNode.value_type == RangerNodeType.String) {
          return (this.lowerStrlen(node lctx))
        }
        ; None of the shapes above: a `length` with no answer used to fall out
        ; of the switch and emit a bare `%length`. A string expression (a field
        ; read, a call) is the remaining case; anything else is a collection.
        if (this.exprIsStringish(lenNode lctx)) {
          return (this.lowerStrlen(node lctx))
        }
        ; A `charbuffer` IS the string's own bytes on this backend (that is what
        ; to_charbuffer answers), so its length is the string length. Sending it
        ; to the collection path answered the pointer itself.
        def lenInner (this.unwrapUnwrapOper(lenNode))
        def lenTn:string lenInner.eval_type_name
        if ((strlen lenTn) == 0) {
          lenTn = lenInner.type_name
        }
        if (lenTn == "charbuffer") {
          return (this.lowerStrlenOn(lenInner lctx))
        }
        if (LowIRUtil.isStringType(lenTn)) {
          return (this.lowerStrlenOn(lenInner lctx))
        }
        return (this.lowerCollectionLen(node lctx))
      }
      if (opName == "itemAt") {
        return (this.lowerItemAt(node lctx))
      }
      if (opName == "make") {
        return (this.lowerCollectionMake(node lctx))
      }
      if (opName == "poll_keypress") {
        return (this.lowerPollKeypress(lctx))
      }
      if (opName == "shell_arg_cnt") {
        return (this.lowerShellArgCnt(lctx))
      }
      if (opName == "shell_arg") {
        return (this.lowerShellArg(node lctx))
      }
      if (opName == "read_file") {
        return (this.lowerReadFile(node lctx))
      }
      if (opName == "buffer_alloc") {
        return (this.lowerBufferAlloc(node lctx))
      }
      if (opName == "buffer_length") {
        return (this.lowerBufferLength(node lctx))
      }
      if (opName == "buffer_get") {
        return (this.lowerBufferGet(node lctx))
      }
      if (opName == "buffer_fill") {
        return (this.lowerBufferFill(node lctx))
      }
      if (opName == "buffer_set") {
        return (this.lowerBufferSet(node lctx))
      }
      if (opName == "buffer_read_file") {
        return (this.lowerBufferReadFile(node lctx))
      }
      if (opName == "buffer_write_file") {
        return (this.lowerBufferWriteFile(node lctx))
      }
      if (opName == "int_buffer_alloc") {
        return (this.lowerIntBufferAlloc(node lctx))
      }
      if (opName == "int_buffer_get") {
        return (this.lowerIntBufferGet(node lctx))
      }
      if (opName == "int_buffer_set") {
        return (this.lowerIntBufferSet(node lctx))
      }
      if (opName == "int_buffer_fill") {
        return (this.lowerIntBufferFill(node lctx))
      }
      if (opName == "to_double") {
        return (this.lowerToDouble(node lctx))
      }
      if (opName == "to_int") {
        return (this.lowerToInt(node lctx))
      }
      if (opName == "floor") {
        return (this.lowerFloor(node lctx))
      }
      if (opName == "str2double") {
        return (this.lowerStr2Double(node lctx))
      }
      if (opName == "str2int") {
        return (this.lowerStr2Int(node lctx))
      }
      if (opName == "charAt") {
        return (this.lowerCharAt(node lctx))
      }
      ; `ccode "["` / `charcode s` -- the code unit at index 0. Both carry a
      ; `*` template, so they type checked here all along and then emitted a
      ; bare `%ccode`, a name that is never defined, because nothing lowered
      ; them. `ccode` of a LITERAL is a compile-time constant, which is what
      ; the `(cc 1)` template does on the text targets.
      if ((opName == "ccode") || (opName == "charcode")) {
        def ccNode (node.getSecond())
        if (ccNode.value_type == RangerNodeType.String) {
          def ccLit:string ccNode.string_value
          if ((strlen ccLit) > 0) {
            def ccVal:int (charcode ccLit)
            return (lctx.builder.emitConst("i32" ("" + ccVal)))
          }
          return (lctx.builder.emitConst("i32" "0"))
        }
        def ccStr (this.lowerExpr(ccNode lctx))
        def ccPs:[string]
        push ccPs "i8*"
        push ccPs "i32"
        this.ensureExternDecl("ranger_char_at" "i32" ccPs false)
        def ccArgs:[string]
        def ccTypes:[string]
        push ccArgs ccStr
        push ccTypes "i8*"
        push ccArgs (lctx.builder.emitConst("i32" "0"))
        push ccTypes "i32"
        return (lctx.builder.emitCall("ranger_char_at" "i32" ccArgs ccTypes))
      }
      if (opName == "substring") {
        return (this.lowerSubstring(node lctx))
      }
      if (opName == "to_string") {
        if (this.nodeIsJson((node.getSecond()) lctx)) {
          def jstr (this.lowerJson1(node "RtJson_stringify" "i8*" lctx))
          this.registerFreshStringTemp(jstr lctx)
          return jstr
        }
        return (this.lowerToString(node lctx))
      }
      if (opName == "strfromcode") {
        return (this.lowerStrFromCode(node "ranger_str_fromcode" lctx))
      }
      if (opName == "rawbytechar") {
        return (this.lowerStrFromCode(node "ranger_str_frombyte" lctx))
      }
      if (opName == "at") {
        return (this.lowerAt(node lctx))
      }
      if (opName == "null?") {
        def argNode (node.getSecond())
        def ptr (this.lowerExpr(argNode lctx))
        if (this.exprIsObjectPtr(argNode lctx)) {
          def zero (builder.emitConst(lctx.ptrType "0"))
          return (builder.emitIcmpTyped("eq" lctx.ptrType ptr zero))
        }
        return (this.lowerPtrIsNull(ptr lctx))
      }
      if (opName == "!null?") {
        def argNode (node.getSecond())
        def ptr (this.lowerExpr(argNode lctx))
        if (this.exprIsObjectPtr(argNode lctx)) {
          def zero (builder.emitConst(lctx.ptrType "0"))
          return (builder.emitIcmpTyped("ne" lctx.ptrType ptr zero))
        }
        return (this.lowerPtrIsNotNull(ptr lctx))
      }
      if (opName == "unwrap") {
        def argNode (node.getSecond())
        def uv (this.lowerExpr(argNode lctx))
        this.guardUnwrapInTry(uv lctx)
        return uv
      }
      def binResult (this.lowerBinaryOp(opName node lctx))
      if ((strlen binResult) > 0) {
        return binResult
      }
    }

    if (node.infix_operator) {
      if (!null? node.infix_node) {
        return (this.lowerExpr((unwrap node.infix_node) lctx))
      }
    }

    if node.expression {
      if ((node.hasFnCall == false) && (node.is_direct_method_call == false) && (node.has_call == false)) {
        def ecnt (array_length node.children)
        if (ecnt > 0) {
          return (this.lowerExpr((itemAt node.children 0) lctx))
        }
      }
    }

    if (node.isPrimitive()) {
      switch node.value_type {
        case RangerNodeType.Integer {
          return (builder.emitConst(irI32 ("" + node.int_value)))
        }
        case RangerNodeType.Double {
          return (builder.emitConst(irF64 ("" + node.double_value)))
        }
        case RangerNodeType.Boolean {
          if node.boolean_value {
            return (builder.emitConst(irI1 one))
          }
          return (builder.emitConst(irI1 zero))
        }
      }
    }

    if (node.value_type == RangerNodeType.String) {
      def text (node.string_value)
      def gname (this.internStringGlobal(text false))
      def byteLen (this.stringGlobalByteLen(gname))
      return (builder.emitStrPtr(gname byteLen))
    }

    if node.hasNewOper {
      def clsName (this.newTargetClassName(node lctx))
      if ((strlen clsName) > 0) {
        def argsNode (node.getThird())
        return (this.lowerNewObject(clsName argsNode lctx))
      }
    }

    if (node.value_type == RangerNodeType.VRef) {
      ; `RangerNodeType.VRef` and friends: an enum member is an integer
      ; constant, the way every text writer spells it. Without this the name
      ; fell through to the slot read below and emitted a bare `%RangerNodeType.NoType`
      ; -- 900 undefined values in the compiler's own IR.
      def enumConst:string (this.lowerEnumRef(node lctx))
      if ((strlen enumConst) > 0) {
        return enumConst
      }
      ; `this` as a value (e.g. `return this`, `f(this)`): the self pointer is
      ; the LLVM parameter %self, not a slot named %this. Objects travel as the
      ; pointer-sized integer, so convert.
      if (node.vref == "this") {
        if ((strlen lctx.selfPtr) > 0) {
          return (builder.emitPtrToInt(lctx.selfPtr))
        }
      }
      ; L3: a boxed value local — read the current value through the shared cell.
      if (has lctx.boxedLocals node.vref) {
        def cellPtr (this.loadSlot(node.vref lctx.ptrType lctx))
        ; the cell holds an i32; emitLoadI32At reads a POINTER-sized word, which
        ; is the same thing only on wasm
        return (builder.emitLoadTypedAt(cellPtr 0 "i32"))
      }
      if ((indexOf node.vref ".") >= 0) {
        def parts:[string] (strsplit node.vref ".")
        if ((array_length parts) >= 2) {
          ; last segment is the field; everything before it is the receiver chain
          ; (`h.pos.x` -> receiver `h.pos`, field `x`), resolved by loading each
          ; intermediate object field.
          def n:int (array_length parts)
          def recvPrefix:string (this.joinDotPrefix(parts (n - 1)))
          def fld (itemAt parts (n - 1))
          def cls (this.resolveObjectClassChain(recvPrefix lctx))
          if ((strlen cls) > 0) {
            def sptr (this.resolveObjectPtrChain(recvPrefix cls lctx))
            return (this.emitFieldLoadOn(cls sptr fld lctx))
          }
        }
      }
      if (this.resolvesToField(node.vref lctx)) {
        return (this.emitFieldLoad(node.vref lctx))
      }
      if (has lctx.collectionSlots node.vref) {
        def collKind (unwrap (get lctx.collectionSlots node.vref))
        if (collKind == "ptr_array") {
          return (this.loadSlot(node.vref lctx.ptrType lctx))
        }
        if (collKind == "array") {
          return (this.loadCollectionDesc(node.vref lctx))
        }
      }
      return (this.loadSlot(node.vref irI32 lctx))
    }

    if node.hasFnCall {
      return (this.lowerCall(node lctx))
    }

    if node.is_direct_method_call {
      return (this.lowerCall(node lctx))
    }

    return (builder.emitConst(irI32 zero))
  }

  ; Operators whose result is an i8* string in the LLVM backend.
  fn operatorReturnsString:boolean (op:string) {
    if (op == "strfromcode") {
      return true
    }
    if (op == "rawbytechar") {
      return true
    }
    if (op == "shell_arg") {
      return true
    }
    if (op == "to_string") {
      return true
    }
    if (op == "substring") {
      return true
    }
    ; The rest of the string-producing operators. Leaving them out made a
    ; concat classify the operand as an int: the format took %d and the
    ; argument was passed as i32 while the value was an i8*, which clang
    ; rejects outright.
    if (op == "trim") { return true }
    if (op == "trim_right") { return true }
    if (op == "normalize") { return true }
    if (op == "path_dirname") { return true }
    if (op == "pathname") { return true }
    if (op == "current_directory") { return true }
    if ((indexOf op "ansi_") == 0) { return true }
    if (op == "install_directory") { return true }
    if (op == "to_lowercase") { return true }
    if (op == "to_uppercase") { return true }
    if (op == "replace") { return true }
    if (op == "join") { return true }
    if (op == "read_file") { return true }
    if (op == "buffer_to_string") { return true }
    if (op == "env_var") { return true }
    if (op == "sha256") { return true }
    if (op == "getStr") { return true }
    return false
  }

  ; A string expression that yields a FRESHLY heap-allocated buffer uniquely
  ; owned by this expression: a concat, a string-producing operator
  ; (to_string/substring/strfromcode/...), or a string-returning call whose
  ; result the caller owns (return convention marks it escaped, not freed, in
  ; the callee). Such a value is owned directly (no dup) and released at scope
  ; end. Literals and VRefs are NOT fresh (borrowed) -> the caller dups to own a
  ; private copy. Conservative: unknown shapes return false; the dup path is
  ; always safe (owns a private heap copy), it just costs one extra alloc/free.
  fn exprIsFreshString:boolean (node:CodeNode lctx:LowIRLowerContext) {
    if (this.strRcEnabled(lctx) == false) {
      return false
    }
    def exprNode (this.unwrapCondExpr(node))
    if exprNode.has_operator {
      def op (exprNode.getOperator())
      if (this.operatorReturnsString(op)) {
        return true
      }
      if (op == "+") {
        def aNode (exprNode.getSecond())
        def bNode (exprNode.getThird())
        if ((this.exprMightBeString(aNode lctx)) || (this.exprMightBeString(bNode lctx))) {
          return true
        }
      }
    }
    ; A string-returning call is deliberately NOT treated as fresh. The return
    ; path does not dup, so a getter (`return this.name`) hands back a borrowed
    ; field pointer; owning+freeing it would dangle the field. Duping the result
    ; (the not-fresh path) is always safe — at worst it leaks a genuinely fresh
    ; callee result, which is recoverable, whereas a wrong free corrupts memory.
    return false
  }

  fn exprIsStringish:boolean (node:CodeNode lctx:LowIRLowerContext) {
    def exprNode (this.unwrapCondExpr(node))
    if (this.exprProducesI1(exprNode lctx)) {
      return false
    }
    if (this.exprIsString(exprNode)) {
      return true
    }
    if (exprNode.has_call || exprNode.is_direct_method_call || exprNode.hasFnCall) {
      if (!null? exprNode.fnDesc) {
        def fd (unwrap exprNode.fnDesc)
        if (!null? fd.nameNode) {
          def rn (unwrap fd.nameNode)
          if (LowIRUtil.isStringType(rn.type_name)) {
            return true
          }
        }
      }
    }
    ; A ZERO-ARGUMENT operator (`(ansi_green)`, `(current_directory)`) does not
    ; always carry has_operator on the node the concat sees, so ask the head
    ; name directly as well -- otherwise the format took %d for a value that
    ; was an i8*.
    if ((array_length exprNode.children) > 0) {
      def headVref:string (exprNode.getVRefAt(0))
      if ((strlen headVref) > 0) {
        if (this.operatorReturnsString(headVref)) {
          return true
        }
      }
    }
    ; ...and once the wrappers are peeled the call can be the bare name.
    if ((strlen exprNode.vref) > 0) {
      if ((has lctx.slots exprNode.vref) == false) {
        if (this.operatorReturnsString(exprNode.vref)) {
          return true
        }
      }
    }
    if exprNode.has_operator {
      def eop (exprNode.getOperator())
      if (this.operatorReturnsString(eop)) {
        return true
      }
      ; A ternary answers a string when its branches do.
      if (eop == "?") {
        if ((array_length exprNode.children) > 3) {
          if (this.exprIsStringish((exprNode.getThird()) lctx)) {
            return true
          }
          if (this.exprIsStringish((itemAt exprNode.children 3) lctx)) {
            return true
          }
        }
      }
      ; `(unwrap x)` is the optional's value: ask what is inside. `print v + " = "
      ; + (unwrap (get m v))` is the shape that exposed this -- the wrapper hid
      ; a string map read, so the concat formatted a pointer with %d.
      if ((eop == "unwrap") || (eop == "??")) {
        if (this.exprIsStringish((exprNode.getSecond()) lctx)) {
          return true
        }
      }
      ; `(get m k)` / `(itemAt xs i)` answer a string when the COLLECTION holds
      ; strings, which only the collection can say.
      if ((eop == "get") || (eop == "itemAt")) {
        def collNode2 (exprNode.getSecond())
        if (collNode2.value_type == RangerNodeType.VRef) {
          if ((this.smapValueKind(collNode2.vref lctx)) == "string") {
            return true
          }
        }
        if (LowIRUtil.isStringType((this.arrayElemTypeName(collNode2 lctx)))) {
          return true
        }
      }
      ; ask the UNWRAPPED node: for an infix expression `node` is the wrapper,
      ; whose own operator is not the `+`, so its operands were never inspected.
      if (eop == "+") {
        def aNode (exprNode.getSecond())
        def bNode (exprNode.getThird())
        if ((this.exprIsStringish(aNode lctx)) || (this.exprIsStringish(bNode lctx))) {
          return true
        }
      }
    }
    if (exprNode.value_type == RangerNodeType.VRef) {
      ; The SLOT's type is the most direct answer, and the only one available
      ; for a captured local inside a hoisted lambda body -- its declared type
      ; lives on the enclosing function's node, not on this reference.
      if (has lctx.slotTypes exprNode.vref) {
        if ((unwrap (get lctx.slotTypes exprNode.vref)) == "i8*") {
          return true
        }
      }
      if (LowIRUtil.isStringType(exprNode.type_name)) {
        return true
      }
      if (LowIRUtil.isStringType(exprNode.eval_type_name)) {
        return true
      }
      if ((indexOf exprNode.vref ".") >= 0) {
        def parts:[string] (strsplit exprNode.vref ".")
        if ((array_length parts) >= 2) {
          def recv (itemAt parts 0)
          def fld (itemAt parts 1)
          def cls (this.resolveObjectClass(recv lctx))
          if ((strlen cls) > 0) {
            if (this.fieldIsStringSlot(cls fld)) {
              return true
            }
          }
        }
      }
      if (has lctx.slotTypes exprNode.vref) {
        def st (unwrap (get lctx.slotTypes exprNode.vref))
        if (st == "i8*") {
          return true
        }
      }
    }
    ; Operators that RETURN a string. Without these a concat operand built by
    ; one was treated as an int -- `("x" + (at s i))` emitted %d and passed the
    ; char pointer in an i32 slot.
    if exprNode.has_operator {
      def rOp (exprNode.getOperator())
      if (rOp == "at") { return true }
      ; NOT charAt: `at` yields a 1-char STRING, `charAt` yields the character
      ; CODE (an int). Listing it here made `(charAt key 0) == 48` compile to
      ; strcmp over an i32 code and an i32 literal.
      if (rOp == "substring") { return true }
      if (rOp == "to_string") { return true }
      if (rOp == "strfromcode") { return true }
      if (rOp == "to_lowercase") { return true }
      if (rOp == "to_uppercase") { return true }
      if (rOp == "read_file") { return true }
      if (rOp == "shell_arg") { return true }
    }
    ; An element READ out of a [string] array is a string. Without this the
    ; element was only ever a pointer-sized value to the comparison lowering, so
    ; `(itemAt names a) == (itemAt names b)` emitted an integer icmp -- which
    ; compares ADDRESSES, and would have answered "not equal" for two equal
    ; strings even if the IR had type-checked.
    if exprNode.has_operator {
      def sOp (exprNode.getOperator())
      if ((sOp == "itemAt") || (sOp == "get")) {
        def sColl (exprNode.getSecond())
        if (LowIRUtil.isStringType((this.arrayElemTypeName(sColl lctx)))) {
          return true
        }
      }
    }
    return false
  }

  fn lowerStringCompare:string (aNode:CodeNode bNode:CodeNode pred:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def lhs (this.lowerExpr(aNode lctx))
    def rhs (this.lowerExpr(bNode lctx))
    def args:[string]
    def argTypes:[string]
    push args lhs
    push argTypes "i8*"
    push args rhs
    push argTypes "i8*"
    def cmpFn:string "strcmp"
    if (this.wasmStrEnabled(lctx)) {
      cmpFn = "ranger_str_cmp"
    }
    def sc (builder.emitCall(cmpFn "i32" args argTypes))
    def zero (builder.emitConst("i32" "0"))
    return (builder.emitIcmp(pred sc zero))
  }

  fn lowerCompareI32:string (aNode:CodeNode bNode:CodeNode pred:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def a (this.lowerExpr(aNode lctx))
    def b (this.lowerExpr(bNode lctx))
    ; floating-point comparison: if either side is f64, promote both and emit a
    ; typed compare so the writer picks f64.lt/gt/le/ge/eq/ne (not i32.*_s).
    if ((this.exprIsF64(aNode)) || (this.exprIsF64(bNode))) {
      def af (this.promoteToF64(aNode a lctx))
      def bf (this.promoteToF64(bNode b lctx))
      return (builder.emitIcmpTyped(pred "f64" af bf))
    }
    def aI1:boolean (this.exprProducesI1(aNode lctx))
    def bI1:boolean (this.exprProducesI1(bNode lctx))
    if (aI1 && bI1) {
      return (builder.emitIcmpTyped(pred "i1" a b))
    }
    if (aI1 || (aNode.value_type == RangerNodeType.Boolean)) {
      a = (builder.emitZextI1ToI32(a))
    }
    if (bI1 || (bNode.value_type == RangerNodeType.Boolean)) {
      b = (builder.emitZextI1ToI32(b))
    }
    ; A pointer-sized operand -- an object reference, or an optional field
    ; tested against null -- must be compared in the POINTER type. Defaulting to
    ; i32 emitted `icmp ne i32 <i64 value>, 0`, which on a 64-bit target is both
    ; invalid IR and, if it had been accepted, would have compared only the low
    ; half of the address.
    if (lctx.ptrType != "i32") {
      ; The width each side ACTUALLY has, not just whether it is recognisably a
      ; new/vref object: a local bound from a map read, a `this`, or a call
      ; answering a class are all pointer sized, and asking about only some of
      ; them left `(ast == this)` comparing two i64 values as i32.
      ;
      ; What the builder EMITTED settles it when it knows: an enum field is an
      ; i32 even though the shape tests below call a chained field read an
      ; object.
      def aEmit:string (builder.emittedType(a))
      def bEmit:string (builder.emittedType(b))
      if ((aEmit == "i32") && (bEmit == "i32")) {
        return (builder.emitIcmp(pred a b))
      }
      def aPtr:boolean ((this.exprIsObjectPtr(aNode lctx)) || ((this.argIrType(aNode lctx)) == lctx.ptrType))
      def bPtr:boolean ((this.exprIsObjectPtr(bNode lctx)) || ((this.argIrType(bNode lctx)) == lctx.ptrType))
      if (aEmit == lctx.ptrType) { aPtr = true }
      if (bEmit == lctx.ptrType) { bPtr = true }
      if (aEmit == "i32") { aPtr = false }
      if (bEmit == "i32") { bPtr = false }
      if (aPtr || bPtr) {
        if (aPtr && bPtr) {
          return (builder.emitIcmpTyped(pred lctx.ptrType a b))
        }
        ; One side is pointer sized and the other is not (an integer literal --
        ; null is 0 -- or a 32-bit value): widen it rather than truncating the
        ; address.
        if aPtr {
          def bw (builder.emitCast("zext" lctx.ptrType "i32" b))
          return (builder.emitIcmpTyped(pred lctx.ptrType a bw))
        } {
          def aw (builder.emitCast("zext" lctx.ptrType "i32" a))
          return (builder.emitIcmpTyped(pred lctx.ptrType aw b))
        }
      }
    }
    return (builder.emitIcmp(pred a b))
  }

  fn lowerArithF64OrI32:string (intKind:string fpKind:string node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def aNode (node.getSecond())
    def bNode (node.getThird())
    ; The expression is floating-point if either operand is, or if the operator
    ; itself yields double (e.g. Ranger's `/` is float division: int/int -> double).
    if (((this.exprIsF64(node)) || (this.exprIsF64(aNode))) || (this.exprIsF64(bNode))) {
      def a (this.promoteToF64(aNode (this.lowerExpr(aNode lctx)) lctx))
      def b (this.promoteToF64(bNode (this.lowerExpr(bNode lctx)) lctx))
      return (builder.emitBin(fpKind "f64" a b))
    }
    def a (this.lowerExpr(aNode lctx))
    def b (this.lowerExpr(bNode lctx))
    return (builder.emitBin(intKind "i32" a b))
  }

  fn lowerBinaryOp:string (opName:string node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def irI32:string "i32"
    def irF64:string "f64"
    switch opName {
      case "+" {
        def aNode (node.getSecond())
        def bNode (node.getThird())
        if ((this.exprMightBeString(aNode lctx)) || (this.exprMightBeString(bNode lctx))) {
          return (this.lowerStringConcat(aNode bNode lctx))
        }
        return (this.lowerArithF64OrI32("add" "fadd" node lctx))
      }
      case "-" {
        return (this.lowerArithF64OrI32("sub" "fsub" node lctx))
      }
      case "*" {
        return (this.lowerArithF64OrI32("mul" "fmul" node lctx))
      }
      case "/" {
        return (this.lowerArithF64OrI32("sdiv" "fdiv" node lctx))
      }
      case "idiv" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        return (builder.emitBin("sdiv" irI32 a b))
      }
      case "%" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        def kind:string "srem"
        return (builder.emitBin(kind irI32 a b))
      }
      case "bit_and" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        return (builder.emitBin("and" irI32 a b))
      }
      case "bit_or" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        return (builder.emitBin("or" irI32 a b))
      }
      case "bit_xor" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        return (builder.emitBin("xor" irI32 a b))
      }
      case "bit_shl" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        return (builder.emitBin("shl" irI32 a b))
      }
      case "bit_shr" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        return (builder.emitBin("ashr" irI32 a b))
      }
      case "bit_ushr" {
        ; JavaScript's >>> is a LOGICAL shift on the 32-bit value.
        def a (this.lowerExpr((node.getSecond()) lctx))
        def b (this.lowerExpr((node.getThird()) lctx))
        return (builder.emitBin("lshr" irI32 a b))
      }
      case "bit_not" {
        def a (this.lowerExpr((node.getSecond()) lctx))
        def neg1 (builder.emitConst(irI32 "-1"))
        return (builder.emitBin("xor" irI32 a neg1))
      }
      case "<" {
        return (this.lowerCompareI32((node.getSecond()) (node.getThird()) "slt" lctx))
      }
      case ">" {
        return (this.lowerCompareI32((node.getSecond()) (node.getThird()) "sgt" lctx))
      }
      case "<=" {
        return (this.lowerCompareI32((node.getSecond()) (node.getThird()) "sle" lctx))
      }
      case ">=" {
        return (this.lowerCompareI32((node.getSecond()) (node.getThird()) "sge" lctx))
      }
      case "==" {
        def aNode (node.getSecond())
        def bNode (node.getThird())
        if (((this.exprProducesI1(aNode lctx)) == false) && ((this.exprProducesI1(bNode lctx)) == false)) {
          if ((this.exprIsStringish(aNode lctx)) || (this.exprIsStringish(bNode lctx))) {
            return (this.lowerStringCompare(aNode bNode "eq" lctx))
          }
        }
        return (this.lowerCompareI32(aNode bNode "eq" lctx))
      }
      case "!=" {
        def aNode (node.getSecond())
        def bNode (node.getThird())
        if (((this.exprProducesI1(aNode lctx)) == false) && ((this.exprProducesI1(bNode lctx)) == false)) {
          if ((this.exprIsStringish(aNode lctx)) || (this.exprIsStringish(bNode lctx))) {
            return (this.lowerStringCompare(aNode bNode "ne" lctx))
          }
        }
        return (this.lowerCompareI32(aNode bNode "ne" lctx))
      }
      ; Both operands have to BE i1. An operand that is a bare reference
      ; (`if (node.left && …)`) or a widened boolean arrives as an integer, and
      ; `and i1 <i64 value>, …` does not assemble -- narrow whatever is not
      ; already an i1.
      case "||" {
        return (this.lowerShortCircuit(node false lctx))
      }
      case "&&" {
        return (this.lowerShortCircuit(node true lctx))
      }
    }
    return ""
  }

  ; `&&` and `||` SHORT CIRCUIT: the right operand is only evaluated when the
  ; left does not already settle the answer. Emitting `and i1 a, b` instead
  ; evaluated both, which is not merely wasteful -- the compiler's own sources
  ; guard a dereference that way:
  ;
  ;   if ( returnedValue.hasParamDesc && (!null? returnedValue.paramDesc.nameNode) )
  ;
  ; With both sides evaluated, the guarded read of a null paramDesc happened
  ; anyway. JavaScript, C++ and every other target short circuit, so code like
  ; this is everywhere.
  ;
  ; The answer travels through a slot rather than a phi: allocas are hoisted to
  ; the entry block, and on WAT an alloca slot is just a local, so the same
  ; shape works on both backends.
  fn lowerShortCircuit:string (node:CodeNode isAnd:boolean lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    lctx.shadowCounter = (lctx.shadowCounter + 1)
    def slot:string ("%sc" + ("" + lctx.shadowCounter))
    builder.emitAlloca("i1" slot)
    def a (this.lowerCondOperand((node.getSecond()) lctx))
    builder.emitStore("i1" a slot)
    def rhsL (builder.freshLabel("sc_rhs"))
    def endL (builder.freshLabel("sc_end"))
    ; `a && b` runs b when a is TRUE; `a || b` runs it when a is FALSE.
    if isAnd {
      builder.terminateBrIf(a rhsL endL)
    } {
      builder.terminateBrIf(a endL rhsL)
    }
    builder.startBlock(rhsL)
    def b (this.lowerCondOperand((node.getThird()) lctx))
    builder.emitStore("i1" b slot)
    if (!null? builder.currentBlock) {
      def rb (unwrap builder.currentBlock)
      if (rb.termKind == "") {
        builder.terminateBr(endL)
      }
    }
    builder.startBlock(endL)
    return (builder.emitLoad("i1" slot))
  }

  fn tryLowerIntrinsic:string (fnName:string argsNode:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def notIntrinsic:string ""
    def handledVoid:string "__void__"
    if (fnName == "Mem_alloc") {
      if ((array_length argsNode.children) > 0) {
        def nbytes (this.lowerExpr((itemAt argsNode.children 0) lctx))
        return (builder.emitHeapAlloc(nbytes))
      }
      return notIntrinsic
    }
    if (fnName == "Mem_loadI32") {
      if ((array_length argsNode.children) > 0) {
        def ptr (this.lowerExpr((itemAt argsNode.children 0) lctx))
        return (builder.emitPtrLoad(ptr))
      }
      return notIntrinsic
    }
    if (fnName == "Mem_storeI32") {
      if ((array_length argsNode.children) > 1) {
        def ptr (this.lowerExpr((itemAt argsNode.children 0) lctx))
        def val (this.lowerExpr((itemAt argsNode.children 1) lctx))
        builder.emitPtrStore(ptr val)
        return handledVoid
      }
      return notIntrinsic
    }
    if (fnName == "Mem_loadU8") {
      if ((array_length argsNode.children) > 0) {
        def ptr (this.lowerExpr((itemAt argsNode.children 0) lctx))
        return (builder.emitPtrLoad8(ptr))
      }
      return notIntrinsic
    }
    if (fnName == "Mem_storeU8") {
      if ((array_length argsNode.children) > 1) {
        def ptr (this.lowerExpr((itemAt argsNode.children 0) lctx))
        def val (this.lowerExpr((itemAt argsNode.children 1) lctx))
        builder.emitPtrStore8(ptr val)
        return handledVoid
      }
      return notIntrinsic
    }
    if (fnName == "Mem_memSize") {
      return (builder.emitMemSize())
    }
    if (fnName == "Mem_memGrow") {
      if ((array_length argsNode.children) > 0) {
        def pages (this.lowerExpr((itemAt argsNode.children 0) lctx))
        return (builder.emitMemGrow(pages))
      }
      return notIntrinsic
    }
    if (fnName == "RangerMem_liveObjects") {
      this.usedMemRuntime = true
      this.ensureMemExtern((LowIRTarget.resolve((unwrap lctx.ctx))))
      def args:[string]
      def argTypes:[string]
      return (builder.emitCall("ranger_mem_live_objects" "i32" args argTypes))
    }
    ; RangerMem.mapPutIfPresent(m key v) -- one lookup instead of the two that
    ; `if (has m k) { set m k v }` costs. Answers whether the key was there.
    if (fnName == "RangerMem_mapPutIfPresent") {
      if ((array_length argsNode.children) > 2) {
        this.usedMemRuntime = true
        def ppDecl:[string]
        push ppDecl "i64"
        push ppDecl "i8*"
        push ppDecl "i64"
        this.ensureExternDecl("RtSMap_put_if_present" "i32" ppDecl false)
        def ppMapNode (itemAt argsNode.children 0)
        def ppDesc (this.smapDescFromVref(ppMapNode.vref lctx))
        def ppRest:[string]
        def ppTypes:[string]
        push ppRest (this.lowerExpr((itemAt argsNode.children 1) lctx))
        push ppTypes "i8*"
        push ppRest (this.lowerExpr((itemAt argsNode.children 2) lctx))
        push ppTypes "i64"
        def ppRes (this.emitSMapCall("RtSMap_put_if_present" "i32" ppDesc ppRest ppTypes lctx))
        return (this.toI1(ppRes lctx))
      }
      return notIntrinsic
    }
    ; RangerMem.mapValueUnique(m key) -- is the value under `key` held by
    ; nothing but the map itself? The test runs entirely in the runtime, where
    ; no local holds the value, so it needs no calibration: rc == 1 means the
    ; map's reference and nothing else. The caller may then update that value in
    ; place instead of allocating a replacement.
    if (fnName == "RangerMem_mapValueUnique") {
      if ((array_length argsNode.children) > 1) {
        this.usedMemRuntime = true
        this.ensureMemExtern((LowIRTarget.resolve((unwrap lctx.ctx))))
        def uqDecl:[string]
        push uqDecl "i64"
        push uqDecl "i8*"
        this.ensureExternDecl("rt_smap_value_unique" "i32" uqDecl false)
        def mapNode (itemAt argsNode.children 0)
        def uqDesc (this.smapDescFromVref(mapNode.vref lctx))
        def uqRest:[string]
        def uqTypes:[string]
        push uqRest (this.lowerExpr((itemAt argsNode.children 1) lctx))
        push uqTypes "i8*"
        def uqRes (this.emitSMapCall("rt_smap_value_unique" "i32" uqDesc uqRest uqTypes lctx))
        return (this.toI1(uqRes lctx))
      }
      return notIntrinsic
    }
    ; RangerMem.refCount(v) -- how many references the runtime is tracking for
    ; this object. Only meaningful where objects are reference counted; on the
    ; targets that are not, the class body's `return 0` stands, and a caller
    ; that uses it to decide whether a value is uniquely owned simply never
    ; takes its fast path.
    if (fnName == "RangerMem_refCount") {
      if ((array_length argsNode.children) > 0) {
        this.usedMemRuntime = true
        this.ensureMemExtern((LowIRTarget.resolve((unwrap lctx.ctx))))
        ; Declared here, not with the other mem externs: a diagnostic nothing
        ; calls must not add a line to every module's IR.
        def rcDecl:[string]
        push rcDecl lctx.ptrType
        this.ensureExternDecl("ranger_obj_refcount" "i32" rcDecl false)
        def rcArgs:[string]
        def rcArgTypes:[string]
        push rcArgs (this.lowerExpr((itemAt argsNode.children 0) lctx))
        push rcArgTypes lctx.ptrType
        return (builder.emitCall("ranger_obj_refcount" "i32" rcArgs rcArgTypes))
      }
      return notIntrinsic
    }
    if (fnName == "RangerMem_resetStats") {
      this.usedMemRuntime = true
      this.ensureMemExtern((LowIRTarget.resolve((unwrap lctx.ctx))))
      def args:[string]
      def argTypes:[string]
      def voidType:string "void"
      builder.emitCall("ranger_mem_reset_stats" voidType args argTypes)
      return handledVoid
    }
    return notIntrinsic
  }

  fn finishObjectCall:string (rv:string) {
    if ((strlen rv) > 0) {
      return rv
    }
    def voidTag:string "__void__"
    return voidTag
  }

  fn lowerCall:string (node:CodeNode lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def voidTag:string "__void__"
    def objectCall (this.tryLowerObjectCall(node lctx))
    if (objectCall == voidTag) {
      return ""
    }
    if ((strlen objectCall) > 0) {
      return objectCall
    }
    if (node.is_direct_method_call || node.has_call) {
      return (this.lowerInstanceCall(node lctx))
    }
    def calleeNode (node.getFirst())
    def argsNode (node.getSecond())
    def calleeVref:string calleeNode.vref
    def calleeDot:int (indexOf calleeVref ".")
    if (calleeDot >= 0) {
      def calleeParts:[string] (strsplit calleeVref ".")
      if ((array_length calleeParts) >= 2) {
        def recvPart (itemAt calleeParts 0)
        if (recvPart == "this") {
          def methPart (itemAt calleeParts 1)
          calleeNode.eval_type_name = lctx.className
          return (this.lowerInstanceCallOn(node "this" calleeNode methPart lctx))
        }
        if (has lctx.objectSlots recvPart) {
          def methPart (itemAt calleeParts 1)
          calleeNode.eval_type_name = (unwrap (get lctx.objectSlots recvPart))
          return (this.lowerInstanceCallOn(node recvPart calleeNode methPart lctx))
        }
        def fcls (this.fieldReceiverClass(recvPart lctx))
        if ((strlen fcls) > 0) {
          def methPart (itemAt calleeParts 1)
          calleeNode.eval_type_name = fcls
          return (this.lowerInstanceCallOn(node recvPart calleeNode methPart lctx))
        }
      }
    }
    if ((array_length calleeNode.ns) >= 2) {
      def recvName (itemAt calleeNode.ns 0)
      def methName (itemAt calleeNode.ns 1)
      if (has lctx.objectSlots recvName) {
        calleeNode.eval_type_name = (unwrap (get lctx.objectSlots recvName))
        return (this.lowerInstanceCallOn(node recvName calleeNode methName lctx))
      }
      ; A receiver that is an object-typed field of the current class (its name
      ; may collide with a systemclass, e.g. a field named "buffer").
      def fcls (this.fieldReceiverClass(recvName lctx))
      if ((strlen fcls) > 0) {
        calleeNode.eval_type_name = fcls
        return (this.lowerInstanceCallOn(node recvName calleeNode methName lctx))
      }
    }
    def fnName:string (this.resolveCalleeName(calleeNode))
    if (fnName == "at") {
      return (this.lowerAtCall(argsNode lctx))
    }
    def intrinsic (this.tryLowerIntrinsic(fnName argsNode lctx))
    if (intrinsic == "__void__") {
      return ""
    }
    if ((strlen intrinsic) > 0) {
      return intrinsic
    }
    def retType:string "i32"
    if (!null? node.fnDesc) {
      if (!null? node.fnDesc.nameNode) {
        def rn (unwrap node.fnDesc.nameNode)
        retType = (this.llvmTypeForRanger(rn.type_name lctx.ptrType))
      }
    }
    def args:[string]
    def argTypes:[string]
    def argIdx:int 0
    for argsNode.children arg:CodeNode i {
      if (!null? node.fnDesc) {
        push args (this.lowerCallArgValue(arg argIdx (unwrap node.fnDesc) lctx))
        push argTypes (this.paramIrTypeFromDesc(argIdx (unwrap node.fnDesc) lctx))
      } {
        push args (this.lowerExpr(arg lctx))
        push argTypes (this.argIrType(arg lctx))
      }
      argIdx = argIdx + 1
    }
    ; A STATIC call returning an object hands back a reference the caller owns,
    ; exactly as an instance call does. Registering only the instance path left
    ; `EvalValue.number(...)` -- the most-called constructor in the engine --
    ; with a reference nobody ever balanced, leaking one object per increment.
    ; A callee mangled out of a receiver the backend could not resolve -- which
    ; happens inside a hoisted lambda body whose capture layout was never built
    ; -- names a function nothing defines. The test is on the RECEIVER, not on
    ; whether the function has been emitted yet: a class lowered later in the
    ; module, and a function calling itself, are both perfectly good callees.
    if (this.calleeReceiverIsUnknown(calleeNode lctx)) {
      if ((this.moduleHasFunction(fnName)) == false) {
        if ((this.hasExternDecl(fnName)) == false) {
        if (retType == "void") {
          return ""
        }
        if (retType == "i8*") {
          return "null"
        }
        if (retType == "f64") {
          return (builder.emitConst("f64" "0.0"))
        }
        return (builder.emitConst(retType "0"))
        }
      }
    }
    def sCallRes (builder.emitCall(fnName retType args argTypes))
    this.registerCallObjectTemp(node sCallRes lctx)
    return sCallRes
  }

  ; The object class produced by an EXPRESSION used as a call receiver
  ; (`(itemAt xs i).m()`, `(property o f).m()`), or "" when it is not one.
  fn exprRecvClassName:string (node:CodeNode lctx:LowIRLowerContext) {
    if (this.isPropertyReadNode(node)) {
      def pcls (this.propertyReadClass(node lctx))
      if ((strlen pcls) > 0) {
        def pfld (node.getThird())
        return (this.fieldObjectClassName(pcls pfld.vref lctx))
      }
      return ""
    }
    ; A plain NAME as the innermost operand: `(unwrap nn).hasFlag(…)` bottoms
    ; out here, and answering "" left the receiver pointer empty -- the call
    ; came out as `inttoptr i64 % to %struct.CodeNode*`.
    if (node.value_type == RangerNodeType.VRef) {
      if ((strlen node.vref) > 0) {
        def vcls:string (this.resolveObjectClassChain(node.vref lctx))
        if ((strlen vcls) > 0) {
          return vcls
        }
        if ((strlen node.eval_type_name) > 0) {
          if (this.isObjectTypeName(node.eval_type_name)) {
            return node.eval_type_name
          }
        }
      }
      return ""
    }
    if ((node.has_operator) == false) {
      return ""
    }
    def rop (node.getOperator())
    ; `unwrap x` keeps the class of its operand.
    if (rop == "unwrap") {
      return (this.exprRecvClassName((node.getSecond()) lctx))
    }
    ; `at` is element access too, and the flow parser reaches a method through
    ; it: `push node.children ( (at item.children 0).copy() )`. Leaving it out
    ; gave the call a null receiver.
    if (((rop != "itemAt") && (rop != "get")) && (rop != "at")) {
      return ""
    }
    def rcoll (node.getSecond())
    def relem:string (this.arrayElemTypeName(rcoll lctx))
    if ((strlen relem) == 0) {
      return ""
    }
    if (this.isObjectTypeName(relem)) {
      return relem
    }
    return ""
  }

  fn tryLowerObjectCall:string (node:CodeNode lctx:LowIRLowerContext) {
    if ((array_length node.children) < 2) {
      return ""
    }
    if node.has_call {
      if ((array_length node.children) > 3) {
        def recv (node.getSecond())
        def meth (node.getThird())
        ; A receiver that is itself a CALL has no name to resolve, so it is
        ; lowered here and handed to lowerInstanceCallOn as a pointer.
        if ((strlen recv.vref) == 0) {
          if ((recv.has_call || recv.is_direct_method_call) || recv.hasFnCall) {
            def rp (this.lowerCall(recv lctx))
            if ((strlen rp) > 0) {
              def rcls2:string ""
              if (!null? recv.fnDesc) {
                def rfd (unwrap recv.fnDesc)
                if (!null? rfd.nameNode) {
                  def rnn (unwrap rfd.nameNode)
                  rcls2 = rnn.type_name
                }
              }
              def rptr (lctx.builder.emitIntToStructPtr(rcls2 rp))
              this.exprRecvPtr = rptr
              recv.eval_type_name = rcls2
              return (this.finishObjectCall((this.lowerInstanceCallOn(node "" recv meth.vref lctx))))
            }
          }
          ; ...and a receiver that is an OPERATOR expression (`(itemAt xs i)`,
          ; `(property o f)`) is lowered the same way. Without this the receiver
          ; pointer stayed empty and the call was emitted as `inttoptr i64 %`.
          def opRecvCls:string (this.exprRecvClassName(recv lctx))
          ; Last resort: the FRONT END already resolved which method this is, so
          ; its declaring class is the receiver's class. exprRecvClassName only
          ; knows a handful of expression shapes, and a receiver it cannot name
          ; used to be emitted as a null pointer -- `(at item.children 0).copy()`
          ; in the flow parser's EnterVarDef extension called CodeNode.copy on 0.
          if ((strlen opRecvCls) == 0) {
            if (!null? node.fnDesc) {
              def rfd2 (unwrap node.fnDesc)
              if (!null? rfd2.container_class) {
                def ccn:string rfd2.container_class.name
                if (this.isObjectTypeName(ccn)) {
                  opRecvCls = ccn
                }
              }
            }
          }
          if ((strlen opRecvCls) > 0) {
            def orv (this.lowerExpr(recv lctx))
            if ((strlen orv) > 0) {
              def orp (lctx.builder.emitIntToStructPtr(opRecvCls orv))
              this.exprRecvPtr = orp
              recv.eval_type_name = opRecvCls
              return (this.finishObjectCall((this.lowerInstanceCallOn(node "" recv meth.vref lctx))))
            }
          }
        }
        if (has lctx.objectSlots recv.vref) {
          recv.eval_type_name = (unwrap (get lctx.objectSlots recv.vref))
          return (this.finishObjectCall((this.lowerInstanceCallOn(node recv.vref recv meth.vref lctx))))
        }
      }
    }
    def callee (node.getFirst())
    def argsNode (node.getSecond())
    def v:string callee.vref
    def dotPos:int (indexOf v ".")
    if (dotPos >= 0) {
      def parts:[string] (strsplit v ".")
      def nparts:int (array_length parts)
      if (nparts >= 3) {
        ; Chained receiver: a.b.method() where a.b is an object field expression.
        def methName (itemAt parts (nparts - 1))
        def recvPrefix (this.joinDotPrefix(parts (nparts - 1)))
        def rcls (this.resolveObjectClassChain(recvPrefix lctx))
        if ((strlen rcls) > 0) {
          callee.eval_type_name = rcls
          return (this.finishObjectCall((this.lowerInstanceCallOn(node recvPrefix callee methName lctx))))
        }
      }
      if ((array_length parts) >= 2) {
        def recvName (itemAt parts 0)
        if (recvName == "this") {
          def methName (itemAt parts 1)
          callee.eval_type_name = lctx.className
          return (this.finishObjectCall((this.lowerInstanceCallOn(node recvName callee methName lctx))))
        }
        if (has lctx.objectSlots recvName) {
          def methName (itemAt parts 1)
          callee.eval_type_name = (unwrap (get lctx.objectSlots recvName))
          return (this.finishObjectCall((this.lowerInstanceCallOn(node recvName callee methName lctx))))
        }
        def fcls (this.fieldReceiverClass(recvName lctx))
        if ((strlen fcls) > 0) {
          def methName (itemAt parts 1)
          callee.eval_type_name = fcls
          return (this.finishObjectCall((this.lowerInstanceCallOn(node recvName callee methName lctx))))
        }
      }
    }
    if (callee.value_type == RangerNodeType.VRef) {
      if (has lctx.objectSlots callee.vref) {
        return (this.finishObjectCall((this.lowerInstanceCallOn(node callee.vref callee node.vref lctx))))
      }
    }
    return ""
  }

  ; Object class of a receiver that is an object-typed field of the current class.
  fn fieldReceiverClass:string (recvName:string lctx:LowIRLowerContext) {
    if ((strlen lctx.className) == 0) {
      return ""
    }
    if (this.resolvesToField(recvName lctx)) {
      return (this.fieldObjectClassName(lctx.className recvName lctx))
    }
    return ""
  }

  fn callArgsNode:CodeNode (node:CodeNode) {
    if node.has_call {
      if ((array_length node.children) > 3) {
        return (itemAt node.children 3)
      }
    }
    return (node.getSecond())
  }

  fn resolveMethodName:string (node:CodeNode defaultName:string) {
    if ((strlen defaultName) > 0) {
      return defaultName
    }
    if (!null? node.fnDesc) {
      def fd (unwrap node.fnDesc)
      return fd.name
    }
    def callee (node.getFirst())
    def v:string callee.vref
    def dotPos:int (indexOf v ".")
    if (dotPos >= 0) {
      def parts:[string] (strsplit v ".")
      if ((array_length parts) >= 2) {
        return (itemAt parts 1)
      }
    }
    return ""
  }

  ; The IR type of a lambda-call argument. It used to answer i32 for anything
  ; without a slot, so `cb(this ...)` declared an i32 parameter and handed it
  ; the pointer-sized `ptrtoint` -- IR clang will not parse.
  fn argIrType:string (arg:CodeNode lctx:LowIRLowerContext) {
    if (arg.value_type == RangerNodeType.String) {
      return "i8*"
    }
    if (arg.value_type == RangerNodeType.VRef) {
      if (arg.vref == "this") {
        return lctx.ptrType
      }
      if (has lctx.slotTypes arg.vref) {
        def st (unwrap (get lctx.slotTypes arg.vref))
        if ((strlen st) > 0) {
          return st
        }
      }
      if (has lctx.objectSlots arg.vref) {
        return lctx.ptrType
      }
      if (has lctx.collectionSlots arg.vref) {
        return lctx.ptrType
      }
    }
    def tn:string arg.eval_type_name
    if ((strlen tn) == 0) {
      tn = arg.type_name
    }
    if ((strlen tn) > 0) {
      if (LowIRUtil.isStringType(tn)) {
        return "i8*"
      }
      if (LowIRUtil.isSupportedPrimitive(tn)) {
        return (LowIRUtil.typeFromRanger(tn))
      }
      if (this.isObjectTypeName(tn)) {
        return lctx.ptrType
      }
    }
    if (this.exprIsStringish(arg lctx)) {
      return "i8*"
    }
    return "i32"
  }

  ; An ARRAY LITERAL in argument position -- `fromList( ([] _:CodeNode (a b c)) )`,
  ; which is what the variadic `r.expression` macro expands to -- has no `def`
  ; to hang its element type on, so nothing built the array and the call was
  ; handed the FIRST element instead. The parameter's declaration supplies the
  ; type; everything else is the same path a `def` takes.
  fn lowerCallArgValue:string (arg:CodeNode paramIndex:int fnDesc:RangerAppFunctionDesc lctx:LowIRLowerContext) {
    if (paramIndex < (array_length fnDesc.params)) {
      def p (itemAt fnDesc.params paramIndex)
      if (!null? p.nameNode) {
        def pn (unwrap p.nameNode)
        ; The ARGUMENT has to look like a literal too. isArrayLiteralValue is
        ; written for the `def xs:[T] …` position, where the declaration alone
        ; settles it; in argument position any parenthesised expression with
        ; children would otherwise match and be built as an array.
        if (this.isArrayLiteralValue(pn arg)) {
          ; A single-child expression is usually a GROUPING, not a one-element
          ; literal: `f( (fnDesc.params) )` passes the array through. Only a
          ; child that is not itself an array makes it a literal.
          def literal:boolean true
          if ((array_length arg.children) == 1) {
            if (this.nodeIsArrayExpr((arg.getFirst()) lctx)) {
              literal = false
            }
          }
          if literal {
            this.usedPtrArrayRuntime = true
            return (this.lowerArrayLiteral(pn arg lctx))
          }
        }
      }
    }
    return (this.lowerExpr(arg lctx))
  }

  fn paramIrTypeFromDesc:string (paramIndex:int fnDesc:RangerAppFunctionDesc lctx:LowIRLowerContext) {
    if (paramIndex >= (array_length fnDesc.params)) {
      return "i32"
    }
    def p (itemAt fnDesc.params paramIndex)
    if (null? p.nameNode) {
      return "i32"
    }
    def pn (unwrap p.nameNode)
    return (this.llvmTypeForRanger(pn.type_name lctx.ptrType))
  }

  ; The class whose emitted function actually carries `methodName`: the class
  ; itself when it declares it, otherwise the nearest base that does.
  ; Coerce an argument to the parameter's declared IR type, using what the
  ; builder actually emitted. Widths otherwise disagree in the shapes the type
  ; tests cannot see -- a lambda-typed parameter handed a pointer-sized zero,
  ; a boolean local passed where an int is declared.
  fn coerceArg:string (value:string wantType:string lctx:LowIRLowerContext) {
    def got:string (lctx.builder.emittedType(value))
    if ((strlen got) == 0) {
      return value
    }
    if (got == wantType) {
      return value
    }
    if ((wantType == "i64") && (got == "i32")) {
      return (lctx.builder.emitCast("zext" "i64" "i32" value))
    }
    if ((wantType == "i64") && (got == "i1")) {
      return (lctx.builder.emitCast("zext" "i64" "i1" value))
    }
    if ((wantType == "i32") && (got == "i64")) {
      return (lctx.builder.emitCast("trunc" "i32" "i64" value))
    }
    if ((wantType == "i32") && (got == "i1")) {
      return (lctx.builder.emitZextI1ToI32(value))
    }
    if ((wantType == "i1") && (got == "i32")) {
      return (this.toI1(value lctx))
    }
    return value
  }

  fn methodOwnerClass:string (className:string methodName:string lctx:LowIRLowerContext) {
    if ((strlen className) == 0) {
      return className
    }
    if (null? lctx.ctx) {
      return className
    }
    def appCtx (unwrap lctx.ctx)
    return (this.methodOwnerClassIn(className methodName appCtx 0))
  }

  fn methodOwnerClassIn:string (className:string methodName:string appCtx:RangerAppWriterContext depth:int) {
    if (depth > 16) {
      return className
    }
    if ((has appCtx.definedClasses className) == false) {
      return className
    }
    def cl (unwrap (get appCtx.definedClasses className))
    for cl.methods m:RangerAppFunctionDesc i {
      if (m.name == methodName) {
        return className
      }
    }
    for cl.extends_classes baseName:string bi {
      def found:string (this.methodOwnerClassIn(baseName methodName appCtx (depth + 1)))
      if (found != baseName) {
        return found
      }
      if (appCtx.isDefinedClass(baseName)) {
        def bcl (appCtx.findClass(baseName))
        for bcl.methods bm:RangerAppFunctionDesc bj {
          if (bm.name == methodName) {
            return baseName
          }
        }
      }
    }
    return className
  }

  ; --- virtual dispatch --------------------------------------------------
  ; The compiler's own architecture is one base writer plus a dozen subclasses
  ; that override its methods, and every call goes through a base-typed field.
  ; Without dispatch the LLVM build produced the BASE writer's output for every
  ; language.

  fn virtualKeyOf:string (className:string methodName:string) {
    return (className + "|" + methodName)
  }

  ; The TOPMOST ancestor of `className` that declares `methodName` -- the class
  ; a call site names when it dispatches, and the one the dispatcher is keyed
  ; on. methodOwnerClassIn finds the NEAREST one, which is the opposite end.
  fn topmostDeclaringClass:string (className:string methodName:string appCtx:RangerAppWriterContext depth:int) {
    if (depth > 16) {
      return className
    }
    if ((has appCtx.definedClasses className) == false) {
      return className
    }
    def cl (unwrap (get appCtx.definedClasses className))
    for cl.extends_classes baseName:string bi {
      if (appCtx.isDefinedClass(baseName)) {
        def up:string (this.topmostDeclaringClass(baseName methodName appCtx (depth + 1)))
        if ((strlen up) > 0) {
          if (up != baseName) {
            return up
          }
          def bcl (appCtx.findClass(baseName))
          for bcl.methods bm:RangerAppFunctionDesc bj {
            if (bm.name == methodName) {
              return baseName
            }
          }
        }
      }
    }
    return className
  }

  fn classIsLowered:boolean (cl:RangerAppClassDesc) {
    if (cl.is_operator_class || cl.is_trait || cl.is_system || cl.is_union) {
      return false
    }
    return true
  }

  fn collectVirtualMethods:void (appCtx:RangerAppWriterContext) {
    ; Pass one: any method whose declaring class is NOT the topmost declarer of
    ; that name is an override, and makes the topmost one a dispatch point.
    for appCtx.definedClassList cName:string ci {
      if (cName == "RangerStaticMethods") {
        continue _
      }
      def cl (unwrap (get appCtx.definedClasses cName))
      if ((this.classIsLowered(cl)) == false) {
        continue
      }
      for cl.methods m:RangerAppFunctionDesc mi {
        if (m.name == "Constructor") {
          continue
        }
        def top:string (this.topmostDeclaringClass(cName m.name appCtx 0))
        if (top == cName) {
          continue
        }
        def key:string (this.virtualKeyOf(top m.name))
        if (has this.virtualIsKey key) {
          continue
        }
        set this.virtualIsKey key true
        push this.virtualKeys key
        def emptyCases:[string]
        set this.virtualCases key emptyCases
        ; The base declaration carries the signature every override shares.
        def topCl (unwrap (get appCtx.definedClasses top))
        for topCl.methods tm:RangerAppFunctionDesc ti {
          if (tm.name == m.name) {
            set this.virtualDescOf key tm
          }
        }
      }
    }
    ; Pass two: for each dispatch point, every class that inherits from it gets
    ; an arm naming the implementation it should actually run. A class that
    ; inherits without overriding still needs one when an intermediate class in
    ; its ancestry overrides.
    for this.virtualKeys key:string ki {
      def parts:[string] (strsplit key "|")
      if ((array_length parts) != 2) {
        continue
      }
      def top:string (itemAt parts 0)
      def meth:string (itemAt parts 1)
      def cases:[string]
      for appCtx.definedClassList dName:string di {
        if (dName == "RangerStaticMethods") {
          continue _
        }
        if (dName == top) {
          continue
        }
        def dcl (unwrap (get appCtx.definedClasses dName))
        if ((this.classIsLowered(dcl)) == false) {
          continue
        }
        if ((this.classInheritsFrom(dName top appCtx 0)) == false) {
          continue
        }
        def impl:string (this.methodOwnerClassIn(dName meth appCtx 0))
        if (impl == top) {
          continue
        }
        if ((has appCtx.definedClasses impl) == false) {
          continue
        }
        push cases dName
        set this.virtualImplOf (this.virtualKeyOf(dName meth)) impl
      }
      set this.virtualCases key cases
    }
  }

  fn classInheritsFrom:boolean (className:string baseName:string appCtx:RangerAppWriterContext depth:int) {
    if (depth > 16) {
      return false
    }
    if ((has appCtx.definedClasses className) == false) {
      return false
    }
    def cl (unwrap (get appCtx.definedClasses className))
    for cl.extends_classes b:string bi {
      if (b == baseName) {
        return true
      }
      if (this.classInheritsFrom(b baseName appCtx (depth + 1))) {
        return true
      }
    }
    return false
  }

  fn virtualDispatcherName:string (className:string methodName:string) {
    return ("__vd_" + className + "_" + methodName)
  }

  fn hasVirtualDispatcher:boolean (className:string methodName:string) {
    def key:string (this.virtualKeyOf(className methodName))
    if ((has this.virtualIsKey key) == false) {
      return false
    }
    def cases (unwrap (get this.virtualCases key))
    return ((array_length cases) > 0)
  }

  fn emitVirtualDispatchers:void (appCtx:RangerAppWriterContext) {
    for this.virtualKeys key:string ki {
      def parts:[string] (strsplit key "|")
      if ((array_length parts) != 2) {
        continue
      }
      def top:string (itemAt parts 0)
      def meth:string (itemAt parts 1)
      if ((this.hasVirtualDispatcher(top meth)) == false) {
        continue
      }
      if ((has this.virtualDescOf key) == false) {
        continue
      }
      this.emitOneVirtualDispatcher(top meth (unwrap (get this.virtualDescOf key)) (unwrap (get this.virtualCases key)) appCtx)
    }
  }

  fn emitOneVirtualDispatcher:void (top:string meth:string fnDesc:RangerAppFunctionDesc cases:[string] appCtx:RangerAppWriterContext) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(this.irModule))
    builder.reset()
    def pt:string this.irModule.ptrType
    def voidType:string "void"
    def retType:string voidType
    if (!null? fnDesc.nameNode) {
      retType = (this.llvmTypeForRanger((this.varTypeName((unwrap fnDesc.nameNode))) pt))
    }

    def params:[LowIRParam]
    def selfParam@(lives):LowIRParam (new LowIRParam())
    selfParam.name = "self"
    selfParam.irType = (LowIRUtil.structPtrType(top))
    push params selfParam
    def argNames:[string]
    def argTypes:[string]
    def pi:int 0
    for fnDesc.params p:RangerAppParamDesc i {
      def lp@(lives):LowIRParam (new LowIRParam())
      lp.name = ("a" + ("" + pi))
      def pn (unwrap p.nameNode)
      def ptn (this.varTypeName(pn))
      lp.irType = (this.llvmTypeForRanger(ptn pt))
      if (this.isLambdaTypeNode(pn)) {
        lp.irType = pt
      }
      push params lp
      push argNames ("%" + lp.name)
      push argTypes lp.irType
      pi = pi + 1
    }

    builder.startBlock("entry")
    def typeParams:[string]
    push typeParams pt
    this.ensureExternDecl("ranger_obj_type" pt typeParams false)
    def selfArgs:[string]
    def selfArgTypes:[string]
    push selfArgs "%self"
    push selfArgTypes (LowIRUtil.structPtrType(top))
    def rtType (builder.emitCall("ranger_obj_type" pt selfArgs selfArgTypes))

    for cases dName:string di {
      def implKey:string (this.virtualKeyOf(dName meth))
      if ((has this.virtualImplOf implKey) == false) {
        continue
      }
      def impl:string (unwrap (get this.virtualImplOf implKey))
      def tdp (builder.emitTypeDescPtr(dName))
      def hit (builder.emitIcmpTyped("eq" pt rtType tdp))
      def bodyL (builder.freshLabel("vd_hit"))
      def nextL (builder.freshLabel("vd_next"))
      builder.terminateBrIf(hit bodyL nextL)
      builder.startBlock(bodyL)
      this.emitDispatchTailCall(builder impl meth retType argNames argTypes)
      builder.startBlock(nextL)
    }
    ; nothing matched: the object is the base class itself, or a subclass that
    ; inherits the base implementation unchanged.
    this.emitDispatchTailCall(builder top meth retType argNames argTypes)
    builder.finishFunction((this.virtualDispatcherName(top meth)) retType params false false)
  }

  fn emitDispatchTailCall:void (builder:LowIRBuilder cls:string meth:string retType:string argNames:[string] argTypes:[string]) {
    def args:[string]
    def types:[string]
    ; %self is passed straight through: the module uses opaque pointers, so the
    ; subclass struct pointer the callee declares and the base one this function
    ; takes are the same value.
    push args "%self"
    push types (LowIRUtil.structPtrType(cls))
    for argNames a:string i {
      push args a
      push types (itemAt argTypes i)
    }
    def callRes (builder.emitCall((LowIRUtil.mangleMethod(cls meth)) retType args types))
    if (retType == "void") {
      builder.terminateRet("void" "")
      return
    }
    builder.terminateRet(retType callRes)
  }

  fn lowerInstanceCallOn:string (node:CodeNode receiverName:string recvNode:CodeNode methodName:string lctx:LowIRLowerContext) {
    def builder (lctx.builder)
    def objPtr:string ""
    def className:string recvNode.eval_type_name
    def haveExprRecv:boolean false
    if ((strlen this.exprRecvPtr) > 0) {
      objPtr = this.exprRecvPtr
      this.exprRecvPtr = ""
      haveExprRecv = true
    }
    if haveExprRecv {
    } {
    if (receiverName == "this") {
      objPtr = lctx.selfPtr
      className = lctx.className
    } {
      if ((strlen className) == 0) {
        if (has lctx.objectSlots receiverName) {
          className = (unwrap (get lctx.objectSlots receiverName))
        }
      }
      ; Resolve a class-field receiver (e.g. a field named like a systemclass)
      ; by loading the field; resolveObjectPtr handles slots, fields, and self.
      ; Dotted receivers (e.g. "huffman.dcTable0") resolve through the chain.
      if ((indexOf receiverName ".") >= 0) {
        className = (this.resolveObjectClassChain(receiverName lctx))
      } {
        if ((strlen className) == 0) {
          className = (this.resolveObjectClass(receiverName lctx))
        }
      }
      objPtr = (this.resolveObjectPtrChain(receiverName className lctx))
    }
    }
    def methName (this.resolveMethodName(node methodName))
    if (!null? node.fnDesc) {
      def fd (unwrap node.fnDesc)
      methName = fd.name
      if ((strlen className) == 0) {
        className = fd.container_class.name
      }
    }
    ; Methods are NOT inherited into the derived class's emitted functions --
    ; each is emitted once, under the name of the class that declares it. A
    ; call to an inherited method has to name that class or it references a
    ; function the module does not contain.
    def ownerCls:string (this.methodOwnerClass(className methName lctx))
    ; A receiver whose class the backend could not work out -- a capture inside
    ; a hoisted lambda whose layout was never built -- used to mangle the
    ; ARGUMENT's name into a callee (`@arg_lambdaFnDesc`), a function nothing
    ; defines. Emitting nothing keeps the module valid; the call is lost, which
    ; is the known limit of closures on this backend (see TARGET_NOTES.md).
    if ((strlen ownerCls) == 0) {
      def missRet:string "i32"
      if (!null? node.fnDesc) {
        if (!null? node.fnDesc.nameNode) {
          def mrn (unwrap node.fnDesc.nameNode)
          missRet = (this.llvmTypeForRanger(mrn.type_name lctx.ptrType))
        }
      }
      if (missRet == "void") {
        return ""
      }
      if (missRet == "i8*") {
        return "null"
      }
      if (missRet == "f64") {
        return (builder.emitConst("f64" "0.0"))
      }
      return (builder.emitConst(missRet "0"))
    }
    def fnName (LowIRUtil.mangleMethod(ownerCls methName))
    ; The receiver's STATIC class only names the declaration; when a subclass
    ; overrides it the object decides, so the call goes through the generated
    ; dispatcher instead. The dispatch point is the topmost class declaring the
    ; method -- the same one any base-typed reference resolves to.
    if (this.hasVirtualDispatcher(ownerCls methName)) {
      fnName = (this.virtualDispatcherName(ownerCls methName))
    }
    def voidType:string "void"
    def retType:string "i32"
    if (!null? node.fnDesc) {
      if (!null? node.fnDesc.nameNode) {
        def rn (unwrap node.fnDesc.nameNode)
        retType = (this.llvmTypeForRanger(rn.type_name lctx.ptrType))
      }
    } {
      if ((methName == "push") || (methName == "put") || (methName == "putAt") || (methName == "storeI32")) {
        retType = voidType
      }
    }
    def args:[string]
    def argTypes:[string]
    ; A receiver the resolution could not work out (a captured name inside a
    ; hoisted lambda whose capture layout was never built) used to be emitted
    ; as an empty operand -- `call void @f(%struct.X* , …)`, which does not
    ; parse. A null keeps the module valid and localises the failure.
    if ((strlen objPtr) == 0) {
      objPtr = (builder.emitIntToStructPtr(ownerCls (builder.emitConst(lctx.ptrType "0"))))
    }
    push args objPtr
    push argTypes (LowIRUtil.structPtrType(ownerCls))
    def argsNode (this.callArgsNode(node))
    def argIdx:int 0
    for argsNode.children arg:CodeNode i {
      def argVal:string ""
      def wantT:string ""
      if (!null? node.fnDesc) {
        argVal = (this.lowerCallArgValue(arg argIdx (unwrap node.fnDesc) lctx))
        wantT = (this.paramIrTypeFromDesc(argIdx (unwrap node.fnDesc) lctx))
      } {
        argVal = (this.lowerExpr(arg lctx))
        wantT = (this.argIrType(arg lctx))
      }
      push args (this.coerceArg(argVal wantT lctx))
      push argTypes wantT
      argIdx = argIdx + 1
    }
    def callRes (builder.emitCall(fnName retType args argTypes))
    this.registerCallObjectTemp(node callRes lctx)
    return callRes
  }

  ; A call that returns an OBJECT hands back a reference the caller owns. When
  ; nothing binds it -- an intermediate like `(this.eval(x)).toNumber()` -- that
  ; reference has no owner at all, which is what kept half the engine's values
  ; alive forever. Registering it in the statement arena releases it once the
  ; statement finishes; binding it to a local or returning it claims it back.
  fn registerCallObjectTemp:void (node:CodeNode tmp:string lctx:LowIRLowerContext) {
    if ((this.memEnabled(lctx)) == false) {
      return
    }
    if (null? node.fnDesc) {
      return
    }
    def fd (unwrap node.fnDesc)
    if (null? fd.nameNode) {
      return
    }
    def rn (unwrap fd.nameNode)
    if ((this.isObjectTypeName((this.varTypeName(rn)))) == false) {
      return
    }
    push lctx.pendingObjectTemps tmp
  }

  fn lowerInstanceCall:string (node:CodeNode lctx:LowIRLowerContext) {
    def objNode@(optional):CodeNode
    def methodName:string node.vref
    if node.is_direct_method_call {
      objNode = (node.getFirst())
      if ((array_length node.children) > 2) {
        def methodNode (node.getSecond())
        methodName = methodNode.vref
      }
    } {
      if ((array_length node.children) > 3) {
        objNode = (node.getSecond())
        def methodNode (node.getThird())
        methodName = methodNode.vref
      }
    }
    if (null? objNode) {
      def builder (lctx.builder)
      return (builder.emitConst("i32" "0"))
    }
    def obj (unwrap objNode)
    return (this.lowerInstanceCallOn(node obj.vref obj methodName lctx))
  }

  ; Is `fnName` a function this module emits? Checked before a call whose
  ; callee name came out of a fallback path.
  ; True when the callee name was mangled from a DOTTED receiver whose first
  ; segment is neither a class nor a name this scope knows -- the shape
  ; resolveCalleeName falls back to when everything else failed.
  fn calleeReceiverIsUnknown:boolean (callee:CodeNode lctx:LowIRLowerContext) {
    if (null? lctx.ctx) {
      return false
    }
    def appCtx0 (unwrap lctx.ctx)
    ; The namespace form carries the same risk: `arg.lambdaFnDesc` inside a
    ; lambda body resolved to ns ["arg" "lambdaFnDesc"] and mangled into a
    ; callee, and `arg` is a local, not a class.
    if ((array_length callee.ns) >= 2) {
      def ns0 (itemAt callee.ns 0)
      if (has appCtx0.definedClasses ns0) {
        return false
      }
      if (ns0 == "this") {
        return false
      }
      return true
    }
    def v:string callee.vref
    if ((indexOf v ".") < 0) {
      return false
    }
    def parts:[string] (strsplit v ".")
    if ((array_length parts) < 2) {
      return false
    }
    def p0 (itemAt parts 0)
    if (p0 == "this") {
      return false
    }
    if (null? lctx.ctx) {
      return false
    }
    def appCtx (unwrap lctx.ctx)
    if (has appCtx.definedClasses p0) {
      return false
    }
    if (has lctx.slots p0) {
      return true
    }
    return true
  }

  fn moduleHasFunction:boolean (fnName:string) {
    for this.irModule.functions f:LowIRFunction i {
      if (f.name == fnName) {
        return true
      }
    }
    for this.irModule.lambdaTableFuncs lf:string j {
      if (lf == fnName) {
        return true
      }
    }
    return false
  }

  fn resolveCalleeName:string (callee:CodeNode) {
    if ((array_length callee.ns) >= 2) {
      def cls (itemAt callee.ns 0)
      def meth (itemAt callee.ns 1)
      return (LowIRUtil.mangleMethod(cls meth))
    }
    def v:string callee.vref
    def dotPos:int (indexOf v ".")
    if (dotPos >= 0) {
      def parts:[string] (strsplit v ".")
      if ((array_length parts) >= 2) {
        def p0 (itemAt parts 0)
        def p1 (itemAt parts 1)
        if (p0 != "this") {
          return (LowIRUtil.mangleMethod(p0 p1))
        }
      }
    }
    return v
  }
}

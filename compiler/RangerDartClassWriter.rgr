; SPDX-License-Identifier: MIT

Import "TraitAnalysis.rgr"
Import "ForLoopAnalysis.rgr"
Import "EnumAnalysis.rgr"

; Dart / Flutter package target writer.
; Focus: idiomatic Dart for shared application logic (models, validation,
; networking, parsers) that a handwritten Flutter UI can import — not full
; Flutter widget tree generation.
class RangerDartClassWriter {
  Extends (RangerGenericClassWriter)
  def compiler:LiveCompiler
  def wrote_header:boolean false
  ; S5 (PLAN_SHAPES.md): a union is an abstract class its members implement, so
  ; the static type a shape declares survives instead of erasing to dynamic.
  def dart_unions_written:boolean false

  ; which behaviour-only Ranger `trait`s become a Dart abstract class
  def dartTraits:TraitInterfaceAnalysis (new TraitInterfaceAnalysis())
  ; can a `for` be the target's own loop over the collection?
  ; Target-neutral question, one place: compiler/ForLoopAnalysis.rgr
  def dartLoops:ForLoopShape (new ForLoopShape())
  def dart_traits_written:boolean false

  ; which Ranger `Enum`s survive as a Dart `enum` rather than an int.
  ; Same question Rust and C++ ask: compiler/EnumAnalysis.rgr.
  def dartEnums:EnumNativeAnalysis (new EnumNativeAnalysis())
  def dart_enums_written:boolean false

  fn dartEnumIsNative:boolean (enumName:string ctx:RangerAppWriterContext) {
    dartEnums.targetName = "dart"
    dartEnums.fallbackType = "int"
    return (dartEnums.isNative(enumName ctx))
  }

  ; `enum Color { Red, Green, Blue }`. A Dart enum carries no discriminant of
  ; its own, and needs none: an enum only reaches this form when no use in the
  ; program observes its integer value.
  fn writeDartNativeEnums:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    if dart_enums_written {
      return
    }
    dart_enums_written = true
    def enumRoot:RangerAppWriterContext (ctx.getRoot())
    for (keys enumRoot.definedEnums) den:string dei {
      if (this.dartEnumIsNative(den ctx)) {
        def deDef:RangerAppEnum (unwrap (get enumRoot.definedEnums den))
        wr.out("" true)
        wr.out(("enum " + den + " {") true)
        wr.indent(1)
        for (keys deDef.values) dmn:string dmi {
          wr.out(((ctx.transformWord(dmn)) + ",") true)
        }
        wr.indent(-1)
        wr.out("}" true)
      }
    }
  }

  ; A behaviour-only trait named as a type, as an abstract class its consumers
  ; `implement`. The mixin copy still gives each consumer its own body; this
  ; makes the name a type, and those bodies are the implementations.
  fn writeDartTraitInterfaces:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    if dart_traits_written {
      return
    }
    dart_traits_written = true
    dartTraits.compute(ctx)
    for (keys dartTraits.ifaceTraits) tn:string tni {
      def tc:RangerAppClassDesc (ctx.findClass(tn))
      wr.out("" true)
      wr.out(("abstract class " + tn + " {") true)
      wr.indent(1)
      for tc.defined_variants fnVar:string fvi {
        def mVs:RangerAppMethodVariants (get tc.method_variants fnVar)
        for mVs.variants variant:RangerAppFunctionDesc vi {
          this.writeTypeDef( (unwrap variant.nameNode) ctx wr)
          wr.out((" " + variant.compiledName + "(") false)
          this.writeArgsDef(variant ctx wr)
          wr.out(");" true)
        }
      }
      wr.indent(-1)
      wr.out("}" true)
    }
  }

  fn writeDartUnionInterfaces:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    if dart_unions_written {
      return
    }
    dart_unions_written = true
    def names:[string] (this.sealableUnionNames(ctx))
    for names uname:string ui {
      wr.out("" true)
      wr.out(("abstract class " + (this.unionInterfaceName(uname)) + " {}") true)
    }
  }

  ; Dart double-quoted strings interpolate `$ident` / `${…}`, so `$` must be escaped.
  fn EncodeString:string (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def encoded_str:string ""
    def str_length:int (strlen node.string_value)
    def ii:int 0
    while (ii < str_length) {
      def cc:int (charAt node.string_value ii)
      switch cc {
        case 8 {
          encoded_str = encoded_str + (strfromcode 92) + (strfromcode 98)
        }
        case 9 {
          encoded_str = encoded_str + (strfromcode 92) + (strfromcode 116)
        }
        case 10 {
          encoded_str = encoded_str + (strfromcode 92) + (strfromcode 110)
        }
        case 12 {
          encoded_str = encoded_str + (strfromcode 92) + (strfromcode 102)
        }
        case 13 {
          encoded_str = encoded_str + (strfromcode 92) + (strfromcode 114)
        }
        case 34 {
          encoded_str = encoded_str + (strfromcode 92) + (strfromcode 34)
        }
        case 36 {
          ; `$` → `\$`
          encoded_str = encoded_str + (strfromcode 92) + (strfromcode 36)
        }
        case 92 {
          encoded_str = encoded_str + (strfromcode 92) + (strfromcode 92)
        }
        ; A character above ASCII is COPIED, not rebuilt from its code.
        ; `charAt` answers the host's own unit -- a UTF-16 code unit, a code
        ; point or a UTF-8 byte -- and `strfromcode` writes a CODE POINT, so
        ; on a byte-hosted compiler every byte of a multi byte character was
        ; encoded a second time: the C++ self-host wrote `a-em-dash-b` into
        ; its JavaScript output as C3 A2 C2 80 C2 94 instead of E2 80 94.
        ; The LLVM writer had the same bug for the same reason. A one unit
        ; `substring` carries whatever the unit is across unchanged, and the
        ; pieces concatenate back into the character on every target -- which
        ; tests/fixtures/string_units.rgr checks as `roundtrip`.
        default {
          encoded_str = (encoded_str + (substring node.string_value ii (ii + 1)))
        }
      }
      ii = ii + 1
    }
    return encoded_str
  }

  fn WriteScalarValue:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    switch node.value_type {
      case RangerNodeType.Double {
        ; Prefer the numeric value over getParsedString(): CRLF source files
        ; shift character spans, and a raw slice then injects `\r` into the
        ; output (which rewinds the line and garbles every later double).
        def dd_str:string ("" + node.double_value)
        if (this.doubleNeedsPointZero(dd_str)) {
          wr.out((dd_str + ".0") false)
        } {
          wr.out(dd_str false)
        }
      }
      case RangerNodeType.String {
        def s:string (this.EncodeString(node ctx wr))
        wr.out((("\"" + s) + "\"") false)
      }
      case RangerNodeType.Integer {
        wr.out(("" + node.int_value) false)
      }
      case RangerNodeType.Boolean {
        if node.boolean_value {
          wr.out("true" false)
        } {
          wr.out("false" false)
        }
      }
    }
  }

  fn adjustType:string (tn:string) {
    if (tn == "this") {
      return "this"
    }
    return tn
  }

  fn getObjectTypeString:string (type_string:string ctx:RangerAppWriterContext) {
    if ((strlen type_string) >= 2) {
      if ((charAt type_string 0) == (ccode "[")) {
        return (this.collectionTypeStringToDart(type_string ctx))
      }
    }
    ; A union of classes is an abstract class those classes implement; anything
    ; else (a union over primitives, the compiler's own `Any`) has no Dart type
    ; of its own and stays dynamic, which the `is` narrowing can still test.
    if (ctx.isDefinedClass(type_string)) {
      def cc:RangerAppClassDesc (ctx.findClass(type_string))
      if (cc.is_union) {
        if (this.unionIsSealable(cc ctx)) {
          return (this.unionInterfaceName(type_string))
        }
        return "dynamic"
      }
      ; A systemclass names one type per target. Without this the Ranger name
      ; reached the output and the Dart analyzer saw an undeclared type:
      ; JSONDataObject instead of the Map that JSON.rgr declares for Dart.
      if cc.is_system {
        def sysName@(optional):string (get cc.systemNames "dart")
        if (!null? sysName) {
          return (unwrap sysName)
        }
      }
    }
    switch type_string {
      case "int" {
        return "int"
      }
      case "string" {
        return "String"
      }
      case "chararray" {
        return "List<int>"
      }
      case "buffer" {
        return "Uint8List"
      }
      case "int_buffer" {
        return "Int64List"
      }
      case "double_buffer" {
        return "Float64List"
      }
      case "char" {
        return "int"
      }
      case "boolean" {
        return "bool"
      }
      case "double" {
        return "double"
      }
    }
    ; An Enum value is an int on Dart, and the enum name is no Dart type. Only
    ; the value_type == Enum path knew that, so an enum reaching this function
    ; -- a return type, a collection element -- wrote its Ranger name.
    if (ctx.isEnumDefined(type_string)) {
      return "int"
    }
    return type_string
  }

  ; Convert nested collection type strings such as "[string]" or
  ; "[string:[int]]" into Dart List / Map types.
  fn collectionTypeStringToDart:string (type_string:string ctx:RangerAppWriterContext) {
    def n:int (strlen type_string)
    def inner:string (substring type_string 1 (n - 1))
    def il:int (strlen inner)
    def depth:int 0
    def sep:int (0 - 1)
    def i:int 0
    while (i < il) {
      def c:int (charAt inner i)
      if (c == (ccode "[")) {
        depth = depth + 1
      }
      if (c == (ccode "]")) {
        depth = depth - 1
      }
      if ((c == (ccode ":")) && (depth == 0)) {
        sep = i
      }
      i = i + 1
    }
    if (sep >= 0) {
      def kt:string (substring inner 0 sep)
      def vt:string (substring inner (sep + 1) il)
      return (((("Map<" + (this.getObjectTypeString(kt ctx))) + ", ") + (this.getObjectTypeString(vt ctx))) + ">")
    }
    return (("List<" + (this.getObjectTypeString(inner ctx))) + ">")
  }

  fn getTypeString:string (type_string:string) {
    switch type_string {
      case "int" {
        return "int"
      }
      case "string" {
        return "String"
      }
      case "chararray" {
        return "List<int>"
      }
      case "buffer" {
        return "Uint8List"
      }
      case "int_buffer" {
        return "Int64List"
      }
      case "double_buffer" {
        return "Float64List"
      }
      case "char" {
        return "int"
      }
      case "boolean" {
        return "bool"
      }
      case "double" {
        return "double"
      }
      case "void" {
        return "void"
      }
    }
    return type_string
  }

  fn writeTypeDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def v_type:RangerNodeType node.value_type
    if (node.eval_type != RangerNodeType.NoType) {
      v_type = node.eval_type
    }
    switch v_type {
      ; `void Function(RangerAppFunctionDesc)` -- without this a local holding a
      ; lambda was declared with an EMPTY type, so `def set_async (fn:void …)`
      ; came out as a bare assignment to a name Dart had never seen.
      case RangerNodeType.ExpressionType {
        def rv:CodeNode (itemAt node.expression_value.children 0)
        def sec:CodeNode (itemAt node.expression_value.children 1)
        this.writeTypeDef( rv ctx wr)
        wr.out(" Function(" false)
        for sec.children arg:CodeNode i {
          if( i > 0 ) {
            wr.out(", " false)
          }
          this.writeTypeDef( arg ctx wr)
        }
        wr.out(")" false)
      }
      case RangerNodeType.Enum {
        def dEnumName:string (dartEnums.enumNameOf(node ctx))
        if (this.dartEnumIsNative(dEnumName ctx)) {
          wr.out(dEnumName false)
        } {
          wr.out("int" false)
        }
      }
      case RangerNodeType.Integer {
        wr.out("int" false)
      }
      case RangerNodeType.Double {
        wr.out("double" false)
      }
      case RangerNodeType.Char {
        wr.out("int" false)
      }
      case RangerNodeType.CharBuffer {
        wr.out("List<int>" false)
      }
      case RangerNodeType.Buffer {
        wr.out("Uint8List" false)
        wr.addImport("dart:typed_data")
      }
      case RangerNodeType.IntBuffer {
        wr.out("Int64List" false)
        wr.addImport("dart:typed_data")
      }
      case RangerNodeType.DoubleBuffer {
        wr.out("Float64List" false)
        wr.addImport("dart:typed_data")
      }
      case RangerNodeType.String {
        wr.out("String" false)
      }
      case RangerNodeType.Boolean {
        wr.out("bool" false)
      }
      case RangerNodeType.Hash {
        wr.out((((("Map<" + (this.getObjectTypeString(node.key_type ctx))) + ", ") + (this.getObjectTypeString(node.array_type ctx))) + ">") false)
      }
      case RangerNodeType.Array {
        wr.out((("List<" + (this.getObjectTypeString(node.array_type ctx))) + ">") false)
      }
      default {
        if (node.type_name == "void") {
          wr.out("void" false)
        } {
          ; A trait CARRYING FIELDS is not an abstract class its consumers can
          ; implement: each owns its own copy of the field, so there is
          ; nothing for the type to promise. It used to reach the file as the
          ; bare name, which Dart answers with "Undefined class". A trait of
          ; methods only is one (writeDartTraitInterfaces) and does name a
          ; type.
          if (ctx.isDefinedClass(node.type_name)) {
            def dTC:RangerAppClassDesc (ctx.findClass(node.type_name))
            if dTC.is_trait {
              if ((dartTraits.isInterface(node.type_name ctx)) == false) {
                ctx.addError(node (("the Dart target writes a `trait` as a mixin, so `" + node.type_name) + "` is not a type it can name. A trait that declares only METHODS becomes an abstract class and can be used as a type; this one carries fields, which its consumers each hold their own copy of. Use a class with subclasses, or give the parameter a concrete type."))
              }
            }
          }
          ; getObjectTypeString, not getTypeString: a union has no Dart type of
          ; its own and has to be written as dynamic here too, not only as a
          ; collection element type.
          wr.out((this.getObjectTypeString(node.type_name ctx)) false)
        }
      }
    }
    if (node.hasFlag("optional")) {
      ; `dynamic` is already nullable in Dart and `dynamic?` is not valid, so an
      ; optional union field must not take the question mark.
      if ((this.getObjectTypeString(node.type_name ctx)) != "dynamic") {
        wr.out("?" false)
      }
    }
  }

  ; Same rule as Kotlin: keep `ClassName.staticFn` when the named member is
  ; static. Dart rejects `this.staticFn()`, so rewriting the class name to
  ; `this` for those calls is a compile error.
  fn namesStaticMember:boolean (cl:RangerAppClassDesc node:CodeNode) {
    if ((array_length node.ns) < 2) {
      return false
    }
    def member:string (itemAt node.ns 1)
    if (cl.hasStaticMethod(member)) {
      return true
    }
    return false
  }

  fn WriteVRef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (node.vref == "this") {
      wr.out("this" false)
      return
    }
    if (node.eval_type == RangerNodeType.Enum) {
      if( (array_length node.ns) > 1) {
        def rootObjName:string (itemAt node.ns 0)
        def enumName:string (itemAt node.ns 1)
        def e@(optional):RangerAppEnum (ctx.getEnum(rootObjName))
        if (!null? e) {
          ; `Color.Green`, not `1`, when the enum survives as a Dart enum
          if (this.dartEnumIsNative(rootObjName ctx)) {
            wr.out((rootObjName + "." + (ctx.transformWord(enumName))) false)
            return
          }
          wr.out(("" + (unwrap (get e.values enumName))) false)
          return
        }
      }
    }
    if ((array_length node.nsp) > 0) {
      for node.nsp p:RangerAppParamDesc i {
        if (i == 0) {
          def part:string (itemAt node.ns 0)
          if(part == "this") {
            wr.out("this" false)
            continue
          }
          def uc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
          if (!null? uc) {
            def currC:RangerAppClassDesc (unwrap uc)
            if (part == currC.name) {
              if( (false == (ctx.isInStatic())) && (false == (this.namesStaticMember(currC node))) ) {
                wr.out("this" false)
                continue
              }
            }
          }
          if (ctx.isMemberVariable(part)) {
            if( false == (ctx.isInStatic()) ) {
              wr.out("this." false)
            }
          }
        }
        if (i > 0) {
          wr.out("." false)
        }
        if ((strlen p.compiledName) > 0) {
          wr.out((this.adjustType(p.compiledName)) false)
        } {
          if ((strlen p.name) > 0) {
            wr.out((this.adjustType(p.name)) false)
          } {
            wr.out((this.adjustType((itemAt node.ns i))) false)
          }
        }
        if (i == 0) {
          if (p.nameNode.hasFlag("optional")) {
            wr.out("!" false)
          }
        } {
          ; A segment in the MIDDLE of a path needs the same `!`. Dart promotes
          ; a local after a null test but never a field, so `target.nameNode`
          ; stays `CodeNode?` inside `if (!null? target.nameNode)` and reading
          ; through it is an error. Only the last segment is left bare: there
          ; the optional IS the value.
          if (i < ((array_length node.nsp) - 1)) {
            if (p.nameNode.hasFlag("optional")) {
              wr.out("!" false)
            }
          }
        }
      }
      return
    }
    if node.hasParamDesc {
      def p:RangerAppParamDesc node.paramDesc
      wr.out(p.compiledName false)
      return
    }
    for node.ns part:string i {
      if (i > 0) {
        wr.out("." false)
      }
      if (i == 0) {
        def uc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
        if (!null? uc) {
          def currC:RangerAppClassDesc (unwrap uc)
          if (part == currC.name) {
            if( (false == (ctx.isInStatic())) && (false == (this.namesStaticMember(currC node))) ) {
              wr.out("this" false)
              continue
            }
          }
        }
      }
      wr.out((this.adjustType(part)) false)
    }
  }

  fn writeVarDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasParamDesc {
      def nn:CodeNode (itemAt node.children 1)
      def p:RangerAppParamDesc nn.paramDesc
      if ((p.ref_cnt == 0) && (p.is_class_variable == false)) {
        if ((array_length node.children) > 2) {
          def value:CodeNode (node.getThird())
          if (this.defValueHasSideEffects(value)) {
            this.writeSideEffectOnlyStmt(value ctx wr)
            return
          }
        }
        wr.out("/* unused:  " false)
      }
      this.writeTypeDef((unwrap p.nameNode) ctx wr)
      wr.out(" " false)
      wr.out(p.compiledName false)
      if ((array_length node.children) > 2) {
        wr.out(" = " false)
        ctx.setInExpr()
        def value:CodeNode (node.getThird())
        this.WalkNode(value ctx wr)
        ctx.unsetInExpr()
      } {
        if (nn.hasFlag("optional")) {
          wr.out(" = null" false)
        } {
          if (nn.value_type == RangerNodeType.Array) {
            wr.out(" = []" false)
          }
          if (nn.value_type == RangerNodeType.Hash) {
            wr.out(" = {}" false)
          }
        }
      }
      if ((p.ref_cnt == 0) && (p.is_class_variable == true)) {
        wr.out("     /* note: unused */" false)
      }
      if ((p.ref_cnt == 0) && (p.is_class_variable == false)) {
        wr.out("   */" true)
      } {
        wr.out(";" false)
        wr.newline()
      }
    }
  }

  fn paramEmitName:string (arg:RangerAppParamDesc ctx:RangerAppWriterContext) {
    if ((strlen arg.compiledName) > 0) {
      return arg.compiledName
    }
    return (ctx.transformWord(arg.name))
  }

  ; Filter out record keyword marker parameters that have no type.
  fn writeArgsDef:void (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    def pms (filter (fnDesc.params) {
      if (item.nameNode.hasFlag("keyword")) {
        return false
      }
      return true
    })
    for pms arg:RangerAppParamDesc i {
      if (i > 0) {
        wr.out(", " false)
      }
      this.writeTypeDef( (unwrap arg.nameNode) ctx wr)
      wr.out(" " false)
      wr.out((this.paramEmitName(arg ctx)) false)
    }
  }

  ; True when the receiver of a call is spelled with a nullable Dart type --
  ; either the reference itself carries the optional flag, or it names a
  ; variable whose declaration does. writeTypeDef gives such a declaration a
  ; trailing `?`, and Dart then refuses a plain `.` call on it.
  fn receiverIsNullable:boolean (obj:CodeNode) {
    if (obj.hasFlag("optional")) {
      return true
    }
    if obj.hasParamDesc {
      def p:RangerAppParamDesc obj.paramDesc
      def nn@(optional):CodeNode p.nameNode
      if (!null? nn) {
        if ((unwrap nn).hasFlag("optional")) {
          return true
        }
      }
    }
    return false
  }

  ; Same shape as RangerGenericClassWriter.CreateCallExpression, plus the null
  ; assertion Dart needs: a field declared without an initializer comes out
  ; as `EvalContext?`, and `(moduleScope).has(k)` on it does not compile.
  ; The namespaced path in WriteVRef already writes `!`; a bare single-name
  ; receiver reached this one instead and got neither that nor `this.`.
  fn CreateCallExpression(node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.has_call {
      def obj:CodeNode (node.getSecond())
      def method:CodeNode (node.getThird())
      def args:CodeNode (itemAt node.children 3)

      this.writeCallReceiver(obj ctx wr)
      if (this.receiverIsNullable(obj)) {
        wr.out("!" false)
      }
      wr.out("." false)
      def methodName method.vref
      if ((!null? node.fnDesc) && ((strlen node.fnDesc.compiledName) > 0)) {
        methodName = node.fnDesc.compiledName
      }
      wr.outMapped(methodName method false method.vref)
      wr.out("(" false)
      ctx.setInExpr()
      def pms (filter (args.children) {
        if( item.hasFlag('keyword')) {
          return false
        }
        return true
      })
      for pms arg:CodeNode i {
        if (i > 0) {
          wr.out(", " false)
        }
        this.WalkNode(arg ctx wr)
      }
      ctx.unsetInExpr()
      wr.out(")" false)
      if ((ctx.expressionLevel()) == 0) {
        wr.out(";" true)
      }
    }
  }

  ; A Dart closure with a body is `(a, b) { … }`. The inherited writer emits the
  ; JavaScript arrow form `(a, b) => { … }`, and `=>` in Dart introduces a single
  ; EXPRESSION, so every lambda with statements in it was a syntax error. No
  ; Dart program in the tests had one, which is why nothing caught it until the
  ; compiler itself was compiled for Dart -- 356 of them in one file.
  fn CreateLambda:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def lambdaCtx (unwrap node.lambda_ctx)
    def args:CodeNode (itemAt node.children 1)
    def body:CodeNode (itemAt node.children 2)
    wr.out("(" false)
    for args.children arg:CodeNode i {
      if (i > 0) {
        wr.out(", " false)
      }
      if(arg.flow_done == false) {
        this.compiler.parser.WalkNode( arg lambdaCtx wr)
      }
      this.WalkNode(arg lambdaCtx wr)
    }
    wr.out(")" false)
    wr.out(" { " true)
    wr.indent(1)
    lambdaCtx.restartExpressionLevel()
    for body.children item:CodeNode i {
      this.WalkNode(item lambdaCtx wr)
    }
    wr.newline()
    wr.indent(-1)
    wr.out("}" true)
  }
  fn writeFnCall:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasFnCall {
      ctx.setInExpr()
      def fc:CodeNode (node.getFirst())
      this.WriteVRef(fc ctx wr)
      wr.out("(" false)
      def givenArgs:CodeNode (node.getSecond())
      for node.fnDesc.params arg:RangerAppParamDesc i {
        if (i > 0) {
          wr.out(", " false)
        }
        if( (array_length givenArgs.children) <= i) {
          def defVal@(optional):CodeNode (arg.nameNode.getFlag("default"))
          if (!null? defVal) {
            def fc:CodeNode (defVal.vref_annotation.getFirst())
            this.WalkNode(fc ctx wr)
          } {
            ctx.addError(node "Default argument was missing")
          }
          continue
        }
        def n:CodeNode (itemAt givenArgs.children i)
        this.WalkNode(n ctx wr)
      }
      wr.out(")" false)
      ctx.unsetInExpr()
      if ((ctx.expressionLevel()) == 0) {
        wr.out(";" true)
      }
    }
  }

  fn writeNewCall:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasNewOper {
      def cl:RangerAppClassDesc node.clDesc
      def givenArgs:CodeNode (node.getThird())
      if (this.tryWriteProcessNewCall(node ctx wr)) {
        return
      }
      if (cl.isSingletonClass()) {
        wr.out(" " false)
        wr.out((node.clDesc.name + ".__singleton") false)
        wr.out("(" false)
        for givenArgs.children n:CodeNode i {
          if (i > 0) {
            wr.out(", " false)
          }
          this.WalkNode(n ctx wr)
        }
        wr.out(")" false)
        return
      }

      wr.out(" " false)
      wr.out(node.clDesc.name false)
      wr.out("(" false)
      def constr:RangerAppFunctionDesc cl.constructor_fn
      if (!null? constr) {
        def written 0
        for constr.params arg:RangerAppParamDesc i {
          if (arg.nameNode.hasFlag("keyword")) {
            continue
          }
          def n:CodeNode (itemAt givenArgs.children i)
          if (written > 0) {
            wr.out(", " false)
          }
          written = written + 1
          this.WalkNode(n ctx wr)
        }
      }
      wr.out(")" false)
    }
  }

  fn writePubspec:void (node:CodeNode ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def wr:CodeWriter (orig_wr.getFileWriter("." ("pubspec.yaml")))
    def opts ([] "name" "version" "description")
    opts.forEach({
      if( (ctx.hasCompilerSetting(item)) == false ) {
        ctx.addError( node ("Dart pubspec requires option -" + item + "=<value>") )
      }
    })
    def pkgName:string (ctx.getCompilerSetting("name"))
    def pkgVersion:string (ctx.getCompilerSetting("version"))
    def pkgDesc:string (ctx.getCompilerSetting("description"))
    wr.out(("name: " + pkgName) true)
    wr.out(("description: " + pkgDesc) true)
    wr.out(("version: " + pkgVersion) true)
    wr.out("publish_to: none" true)
    wr.out("" true)
    wr.out("environment:" true)
    wr.out("  sdk: '>=3.0.0 <4.0.0'" true)
    if (ctx.hasCompilerFlag("flutter")) {
      wr.out("" true)
      wr.out("dependencies:" true)
      wr.out("  flutter:" true)
      wr.out("    sdk: flutter" true)
      wr.out("" true)
      wr.out("flutter:" true)
      wr.out("  uses-material-design: false" true)
    }
  }

  fn writeClass:void (node:CodeNode ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def cl:RangerAppClassDesc node.clDesc
    if (null? cl) {
      return
    }
    def declaredFunction:[string:boolean]
    def wr:CodeWriter orig_wr

    if (wrote_header == false) {
      if (ctx.hasCompilerFlag("pubspec")) {
        this.writePubspec(node ctx wr)
      }
      wrote_header = true
    }

    this.writeDartNativeEnums(ctx wr)
    this.writeDartTraitInterfaces(ctx wr)
    this.writeDartUnionInterfaces(ctx wr)
    wr.out("" true)
    if cl.has_doc {
      def clDocWr:RangerDocCommentWriter (new RangerDocCommentWriter)
      clDocWr.writeDartDocForClass((unwrap cl) ctx wr)
    }
    wr.out(("class " + cl.name) false)
    def dartUnions:[string] (this.unionInterfacesOf((unwrap cl) ctx))
    if ((array_length cl.extends_classes) > 0) {
      wr.out(" extends " false)
      for cl.extends_classes pName:string i {
        if (i > 0) {
          wr.out(", " false)
        }
        def parentClass:RangerAppClassDesc (ctx.findClass(pName))
        for parentClass.defined_variants fnVar:string j {
          def mVs:RangerAppMethodVariants (get parentClass.method_variants fnVar)
          for mVs.variants variant:RangerAppFunctionDesc k {
            set declaredFunction variant.name true
          }
        }
        wr.out(parentClass.compiledName false)
      }
    }
    ; `implements` is its own clause in Dart, after any `extends`, and carries
    ; both the unions this class belongs to and the behaviour-only traits it
    ; `does` that something names as a type
    def dartIfaces:[string] (dartTraits.basesOf((unwrap cl) ctx))
    def dartImpl:int 0
    for dartUnions uname:string ui {
      if (dartImpl > 0) {
        wr.out(", " false)
      } {
        wr.out(" implements " false)
      }
      wr.out(uname false)
      dartImpl = dartImpl + 1
    }
    for dartIfaces ifName:string ifi {
      if (dartImpl > 0) {
        wr.out(", " false)
      } {
        wr.out(" implements " false)
      }
      wr.out(ifName false)
      dartImpl = dartImpl + 1
    }
    wr.out(" {" true)
    wr.indent(1)

    ; Instance fields
    for cl.variables pvar:RangerAppParamDesc i {
      if pvar.is_static {
        continue _
      }
      if pvar.has_doc {
        def fDocWr:RangerDocCommentWriter (new RangerDocCommentWriter)
        fDocWr.writeDartDocForField(pvar wr)
      }
      this.writeVarDef((unwrap pvar.node) ctx wr)
    }

    ; Static fields
    for cl.variables pvar:RangerAppParamDesc i {
      if (false == pvar.is_static) {
        continue _
      }
      wr.out("static " false)
      this.writeVarDef((unwrap pvar.node) ctx wr)
    }

    if (cl.isSingletonClass()) {
      wr.out(("static " + cl.compiledName + "? __singleton_instance;") true)
    }

    ; Constructor
    if cl.has_constructor {
      def constr:RangerAppFunctionDesc (unwrap cl.constructor_fn)
      wr.out("" true)
      wr.out((cl.name + "(") false)
      this.writeArgsDef(constr ctx wr)
      wr.out(")" false)
      if ((array_length cl.extends_classes) > 0) {
        def parentClass:RangerAppClassDesc (ctx.findClass((itemAt cl.extends_classes 0)))
        if parentClass.has_constructor {
          wr.out(" : super(" false)
          def pConstr:RangerAppFunctionDesc (unwrap parentClass.constructor_fn)
          for pConstr.params pArg:RangerAppParamDesc j {
            if (j > 0) {
              wr.out(", " false)
            }
            def foundByName:boolean false
            for constr.params cArgByName:RangerAppParamDesc k {
              if (cArgByName.name == pArg.name) {
                wr.out(cArgByName.compiledName false)
                foundByName = true
                break
              }
            }
            if (false == foundByName) {
              if (j < (array_length constr.params)) {
                def cArg:RangerAppParamDesc (itemAt constr.params j)
                wr.out(cArg.compiledName false)
              }
            }
          }
          wr.out(")" false)
        }
      }
      wr.out(" {" true)
      wr.indent(1)
      wr.newline()
      def subCtx:RangerAppWriterContext (unwrap constr.fnCtx)
      subCtx.is_function = true
      this.WalkNode( (unwrap constr.fnBody) subCtx wr)
      wr.newline()
      wr.indent(-1)
      wr.out("}" true)
    } {
      ; Default constructor when extending a parent with a no-arg constructor
      if ((array_length cl.extends_classes) > 0) {
        def parentClass:RangerAppClassDesc (ctx.findClass((itemAt cl.extends_classes 0)))
        if (false == parentClass.has_constructor) {
          ; Dart synthesizes the default constructor.
        }
      }
    }

    if (cl.isSingletonClass()) {
      wr.out("" true)
      wr.out(("static " + cl.compiledName + " __singleton(") false)
      if cl.has_constructor {
        def constr:RangerAppFunctionDesc (unwrap cl.constructor_fn)
        this.writeArgsDef(constr ctx wr)
      }
      wr.out((") {") true)
      wr.indent(1)
      wr.out("if (__singleton_instance == null) {" true)
      wr.indent(1)
      wr.out(("__singleton_instance = " + cl.compiledName + "(") false)
      if cl.has_constructor {
        def constr:RangerAppFunctionDesc (unwrap cl.constructor_fn)
        for constr.params arg:RangerAppParamDesc i {
          if (i > 0) {
            wr.out(", " false)
          }
          wr.out(arg.compiledName false)
        }
      }
      wr.out(");" true)
      wr.indent(-1)
      wr.out("}" true)
      wr.out("return __singleton_instance!;" true)
      wr.indent(-1)
      wr.out("}" true)
    }

    ; Static methods (except main)
    for cl.static_methods variant:RangerAppFunctionDesc i {
      if (variant.nameNode.hasFlag("main")) {
        continue _
      }
      if variant.is_doc_example {
        if ((ctx.hasCompilerFlag("keep-examples")) == false) {
          continue _
        }
      }
      wr.out("" true)
      if variant.has_doc {
        def sDocWr:RangerDocCommentWriter (new RangerDocCommentWriter)
        sDocWr.writeDartDocForMethod(variant ctx wr)
      }
      wr.out("static " false)
      this.writeTypeDef( (unwrap variant.nameNode ) ctx wr)
      wr.out(" " false)
      wr.out((variant.compiledName + "(") false)
      this.writeArgsDef(variant ctx wr)
      wr.out(") {" true)
      wr.indent(1)
      wr.newline()
      def subCtx:RangerAppWriterContext (unwrap variant.fnCtx)
      subCtx.is_function = true
      subCtx.in_method = true
      subCtx.in_static_method = true
      subCtx.currentMethod = variant
      subCtx.setCurrentClass( (unwrap cl) )
      this.WalkNode( (unwrap variant.fnBody ) subCtx wr)
      wr.newline()
      wr.indent(-1)
      wr.out("}" true)
    }

    ; Instance methods
    for cl.defined_variants fnVar:string i {
      def mVs:RangerAppMethodVariants (get cl.method_variants fnVar)
      for mVs.variants variant:RangerAppFunctionDesc i {
        if variant.is_doc_example {
          if ((ctx.hasCompilerFlag("keep-examples")) == false) {
            continue _
          }
        }
        wr.out("" true)
        def shouldOverride:boolean false
        if (variant.nameNode.hasFlag("override")) {
          shouldOverride = true
        }
        if (has declaredFunction variant.name) {
          shouldOverride = true
        }
        if variant.has_doc {
          def mDocWr:RangerDocCommentWriter (new RangerDocCommentWriter)
          mDocWr.writeDartDocForMethod(variant ctx wr)
        }
        if shouldOverride {
          wr.out("@override" true)
        }
        this.writeTypeDef( (unwrap variant.nameNode ) ctx wr)
        wr.out(" " false)
        wr.out((variant.compiledName + "(") false)
        this.writeArgsDef(variant ctx wr)
        wr.out(") {" true)
        wr.indent(1)
        wr.newline()
        def subCtx:RangerAppWriterContext (unwrap variant.fnCtx)
        subCtx.is_function = true
        subCtx.in_method = true
        subCtx.in_static_method = false
        subCtx.currentMethod = variant
        subCtx.setCurrentClass( (unwrap cl) )
        this.WalkNode( (unwrap variant.fnBody ) subCtx wr)
        wr.newline()
        wr.indent(-1)
        wr.out("}" true)
      }
    }

    wr.indent(-1)
    wr.out("}" true)

    ; Top-level main
    for cl.static_methods variant:RangerAppFunctionDesc i {
      if ( (variant.nameNode.hasFlag("main")) && (variant.nameNode.code.filename == (ctx.getRootFile()))) {
        wr.out("" true)
        ; Only main() can see the list Dart hands it. The shell_arg operators
        ; read __g_args, so main copies it there first -- the same shape as
        ; __g_argv on C++. Declared here rather than in the operator template:
        ; main is written once, and a program that never reads an argument
        ; would otherwise assign to a name that was never declared.
        wr.out("List<String> __g_args = <String>[];" true)
        wr.out("" true)
        wr.out("void main(List<String> args) {" true)
        wr.indent(1)
        wr.out("__g_args = args;" true)
        wr.newline()
        def subCtx:RangerAppWriterContext (unwrap variant.fnCtx )
        subCtx.is_function = true
        subCtx.in_method = false
        subCtx.in_static_method = true
        subCtx.currentMethod = variant
        this.WalkNode( (unwrap variant.fnBody ) subCtx wr)
        wr.newline()
        wr.indent(-1)
        wr.out("}" true)
      }
    }
  }

  ; --- the generated `for` (PLAN_CPP_IDIOMS C4, the Dart half) --------------
  ; `for (final v in xs)` is the Dart loop. This writer emitted the C-style
  ; index one. The two conditions are the ones every target asks
  ; (ForLoopShape): the for-in form takes one iterator for the whole loop, so a
  ; body that adds to the list gets a ConcurrentModificationError where the
  ; index form saw the growth.
  fn dartWriteOperand:void (arg:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ctx.setInExpr()
    this.WalkNode(arg ctx wr)
    ctx.unsetInExpr()
  }

  fn dartWriteForLoop:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if ((array_length node.children) < 5) {
      return
    }
    def coll:CodeNode (node.getSecond())
    def item:CodeNode (itemAt node.children 2)
    def idx:CodeNode (itemAt node.children 3)
    def body:CodeNode (itemAt node.children 4)

    if (dartLoops.canIterate(node)) {
      wr.out("for ( " false)
      if (dartLoops.bodyAssignsElement(node)) {
        wr.out("var " false)
      } {
        wr.out("final " false)
      }
      this.dartWriteOperand(item ctx wr)
      wr.out(" in " false)
      this.dartWriteOperand(coll ctx wr)
      wr.out(") {" true)
      wr.indent(1)
      def rCtx:RangerAppWriterContext (ctx.fork())
      rCtx.restartExpressionLevel()
      this.WalkNode(body rCtx wr)
      wr.indent(-1)
      wr.out("}" true)
      return
    }

    ; the index form, what the template wrote before
    wr.out("for ( int " false)
    this.dartWriteOperand(idx ctx wr)
    wr.out(" = 0; " false)
    this.dartWriteOperand(idx ctx wr)
    wr.out(" < " false)
    this.dartWriteOperand(coll ctx wr)
    wr.out(".length; " false)
    this.dartWriteOperand(idx ctx wr)
    wr.out("++) {" true)
    wr.indent(1)
    wr.out("var " false)
    this.dartWriteOperand(item ctx wr)
    wr.out(" = " false)
    this.dartWriteOperand(coll ctx wr)
    wr.out("[" false)
    this.dartWriteOperand(idx ctx wr)
    wr.out("];" true)
    def sCtx:RangerAppWriterContext (ctx.fork())
    sCtx.restartExpressionLevel()
    this.WalkNode(body sCtx wr)
    wr.indent(-1)
    wr.out("}" true)
  }

  ; Nothing else routes a template through this writer, so the only command
  ; that arrives is the one Lang.rgr declares `(custom _)` for it.
  fn CustomOperator:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def fc:CodeNode (node.getFirst())
    def cmd:string fc.vref
    if (cmd == "for") {
      this.dartWriteForLoop(node ctx wr)
    }
  }

}

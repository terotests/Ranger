    def ot:RsType (RsType.of1("opt" t))
    def safe:string (this.unionSafe(v.code t))
    def name:string (this.tmp("o"))
    out.line(("def " + (this.declText(name ot))))
    out.line(((name + " = ") + safe))
    def r:RsExpr (RsExpr.of(name ot))
    r.simple = true
    return r
  }

  fn makeResult:RsExpr (name:string args:[RustNode] expect:RsType at:RustNode) {
    if (expect.kind != "result") {
      this.err(at (("`" + name) + "(…)` where the Result type is not known: annotate the `let` or the function's return type"))
      return (this.unit())

  fn emitEnum:string (e:RsEnum) {
    if ((array_length e.generics) > 0) {
      this.unsupported((new RustNode("none")) (("the generic enum `" + e.name) + "`"))
      return ""
    }
    def cname:string (this.className(e.name))
    ; methods, Debug, Clone, PartialEq live in a class of static functions
    def impl:[string]
    push impl (("class " + (this.implClass(e.name))) + " {")
    def mi:int 0
    while (mi < (array_length e.methods)) {
      def m:RsFn (itemAt e.methods mi)
      mi = mi + 1
      push impl (this.emitFn(m e.name))
    }
    if (false == e.plain) {
      push impl (this.emitEnumZero(e cname))
    }
    if (false == (this.hasFmt((RsType.named(e.name)) "Debug"))) {
      push impl (this.emitEnumDebug(e cname))
      if (false == e.plain) {
        push impl (this.emitEnumEq(e cname))
      }
    }
    if (false == e.plain) {
      ; copies of a Copy enum call it too (copyCode)
      push impl (this.emitEnumClone(e cname))
    }
    ; public with the enum's public methods, as a struct's class is
    def implDoc:RustDocInfo (new RustDocInfo())
    for e.methods pm:RsFn pmi {
      if (!null? pm.node) {
        def pmNode:RustNode (unwrap pm.node)
        if (pmNode.hasMod("pub")) {
          implDoc.isPublic = true
        }
      }
    }
    push impl ("}" + (RustDocReader.tail(implDoc "")))
    return (join impl "\n")
  }

  ; `Enum.Variant` of each enum variant a `ref mut` binding writes a field of
  def writtenCases:[string:boolean]

  fn emitEnumShape:string (e:RsEnum) {
    if ((array_length e.generics) > 0) {
      return ""
    }
    def cname:string (this.className(e.name))
    def lines:[string]
    if (e.plain) {
      def names:[string]
      for e.variants v:RsVariant i {
        push names v.name

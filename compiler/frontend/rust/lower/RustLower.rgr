      this.assignTo(target (RsExpr.of(dv cur.ty)))
    }
    def r:RsExpr (RsExpr.of(t cur.ty))
    r.simple = true
    return r
  }

  ; --------------------------------------------------------------- methods

  fn lowerMethod:RsExpr (n:RustNode expect:RsType) {
    def name:string n.name
    def recvN:RustNode (n.kid(0))
    def args:[RustNode] (this.callArgs(n 2))
    ; chains decided by their shape before the receiver is lowered
    if ((name == "count") && (recvN.kind == "method") && (recvN.name == "chars")) {
      def s:RsExpr (this.lowerExpr((recvN.kid(0)) (RsType.mk("string"))))
      return (RsExpr.of((("(rs_char_count " + s.code) + ")") (RsType.mk("int"))))
    }
    if ((name == "len") && (recvN.kind == "method") && ((recvN.name == "as_bytes") || (recvN.name == "bytes"))) {
      def s2:RsExpr (this.lowerExpr((recvN.kid(0)) (RsType.mk("string"))))
      return (RsExpr.of((("(rs_byte_len " + s2.code) + ")") (RsType.mk("int"))))
    }
    if ((name == "collect") || (name == "to_vec") || (name == "cloned") || (name == "copied")) {
      if ((recvN.kind == "method") && ((recvN.name == "split") || (recvN.name == "lines") || (recvN.name == "split_whitespace"))) {
        return (this.lowerExpr(recvN expect))
      }
    }
    if ((name == "unwrap") && (recvN.kind == "method") && (recvN.name == "parse")) {
      return (this.lowerParse(recvN expect))
    }
    if ((name == "unwrap") && (recvN.kind == "method") && (recvN.name == "partial_cmp")) {
      return (this.lowerMethod(recvN expect))
    }
    if (this.isIterConsumer(name) && (this.isIterChain(recvN))) {
      return (this.lowerIterChain(n expect))
    }
    if ((displayFormatter != "") && (recvN.kind == "path_expr") && ((this.lastSeg((recvN.kid(0)))) == displayFormatter)) {
      if ((name == "write_str") || (name == "write_fmt")) {
        def ws:RsExpr (this.arg0(args (RsType.mk("string"))))
        out.line((("rs__out = (rs__out + " + ws.code) + ")"))
        return (this.unit())
      }
      this.unsupported(n (("the Formatter method `" + name) + "`"))
      return (this.unit())
    }
    def rv:RsExpr (this.lowerExpr(recvN (RsType.mk("unknown"))))
    def t:RsType rv.ty
    if ((t.kind == "named") && (has traits t.name)) {
      def tr:RsTrait (unwrap (get traits t.name))
      def tm@(optional):RsFn (tr.method(name))
      if (null? tm) {
        this.err(n (((("no method `" + name) + "` in the trait `") + t.name) + "`"))
        return (this.unit())
      }
      def tmf:RsFn (unwrap tm)
      def recv:string (this.bindTemp(rv t "r"))
      def codes:[string] (this.lowerArgs(args (this.paramTypes(tmf))))
      def all:[string]
      push all recv
      for codes cc:string ci {
        push all cc
      }
      return (RsExpr.of(((((((("(" + (this.dynUnion(t.name))) + "_ops.") + (this.staticName(name))) + "(") + (join all " ")) + "))")) tmf.ret))
    }
    if (t.kind == "named") {
      if (has structs t.name) {
        def s3:RsStruct (unwrap (get structs t.name))
        def m@(optional):RsFn (s3.method(name))
        if (!null? m) {
          return (this.userMethodCall(rv (unwrap m) args n))
        }
        if ((name == "clone") && ((s3.derivesTrait("Clone")) || (s3.derivesTrait("Copy")))) {
          def rc:string (this.bindTemp(rv t "r"))
          return (RsExpr.of((this.cloneCode(rc t)) t))
        }
        if ((name == "to_string") && (false == (this.hasFmt(t "Display")))) {
          this.err(n (("`" + t.name) + "` has no Display impl"))
          return (this.unit())
        }
        if (name == "to_string") {
          return (this.displayCall(rv t))
        }
      }
      if (has enums t.name) {
        def en:RsEnum (unwrap (get enums t.name))
        def em@(optional):RsFn (en.method(name))
        if (!null? em) {
          return (this.userMethodCall(rv (unwrap em) args n))
        }
        if (name == "clone") {
          if (en.plain) {
            return rv
          }
          def ec:string (this.bindTemp(rv t "r"))
          return (RsExpr.of((this.cloneCode(ec t)) t))
        }
        if (name == "to_string") {
          def ed:string (this.bindTemp(rv t "r"))
          return (RsExpr.of((((("(" + (this.implClass(t.name))) + ".displayOf(") + ed) + "))") (RsType.mk("string"))))
        }
      }
      ; `w.upgrade()` on a Weak<T>: the object if it is still there (R7)
      if ((name == "upgrade") && t.weak && ((array_length args) == 0)) {
        def ut:RsType (t.copy())
        ut.weak = false
        def uo:RsType (RsType.of1("opt" ut))
        def un:string (this.tmp("o"))
        out.line(("def " + (this.declText(un uo))))
        out.line(((un + " = ") + rv.code))
        def ur:RsExpr (RsExpr.of(un uo))
        ur.simple = true
        return ur
      }
      ; `c.borrow().count`, `c.borrow_mut().label = …` on an Rc<RefCell<T>>:
      ; the object itself
      if (((name == "borrow") || (name == "borrow_mut") || (name == "as_ref") || (name == "as_mut")) && ((array_length args) == 0)) {
        return rv
      }
      this.err(n (((("no method `" + name) + "` on `") + (t.rust())) + "`"))
      return (this.unit())
    }
    return (this.stdMethod(rv name args n expect))
  }

  fn userMethodCall:RsExpr (rv:RsExpr m:RsFn args:[RustNode] at:RustNode) {
    if (at.kind == "method") {
      def recvNode:RustNode (at.kid(0))
      this.checkCallBorrows(recvNode m.selfMut (m.hasSelf && (false == m.selfByValue)) args at)
      if (m.selfByValue) {
        this.noteMove(recvNode rv.ty)
      }
    }
    def recv:string (this.bindTemp(rv rv.ty "r"))
    if ((this.hasBoxed(m)) && (false == ((rv.ty.kind == "named") && (has enums rv.ty.name)))) {
      return (this.boxedCall((((recv + ".") + m.rname) + "(") m args rv.ty "" at))
    }
    def env:[string:RsType] (this.methodEnv(rv.ty))
    def ptypes:[RsType]
    for m.params pp:RsParam ppi {
      push ptypes (this.subst(pp.ty env))
    }
    def mret:RsType (this.subst(m.ret env))
    def codes:[string] (this.lowerArgs(args ptypes))
    if ((rv.ty.kind == "named") && (has enums rv.ty.name)) {
      def all:[string]
      push all recv
      for codes cc:string ci {
        push all cc
      }
      return (RsExpr.of((((((("(" + (this.implClass(rv.ty.name))) + ".") + (this.staticName(m.name))) + "(") + (join all " ")) + "))") mret))
    }
    if (false == m.hasSelf) {
      this.err(at (("`" + m.name) + "` is an associated function: call it as `Type::name(…)`"))
    }
    return (RsExpr.of((((((("(" + recv) + ".") + m.rname) + "(") + (join codes " ")) + "))") mret))
  }

  fn displayCall:RsExpr (rv:RsExpr t:RsType) {
    def recv:string (this.bindTemp(rv t "r"))
    return (RsExpr.of((("(" + recv) + ".rs_display())") (RsType.mk("string"))))
  }

  ; `s.parse::<T>().unwrap()` / `let x: T = s.parse().unwrap()`.
  fn lowerParse:RsExpr (parseCall:RustNode expect:RsType) {
    def s:RsExpr (this.lowerExpr((parseCall.kid(0)) (RsType.mk("string"))))
    def target:RsType expect
    def targs:RustNode (parseCall.kid(1))
    if ((array_length targs.kids) > 0) {
      target = (this.typeOf((targs.kid(0))))
    }
    if (target.kind == "int") {
      return (RsExpr.of((("(unwrap (to_int (trim " + s.code) + ")))") target))
    }
    if (target.kind == "double") {
      return (RsExpr.of((("(unwrap (to_double (trim " + s.code) + ")))") target))
    }
    this.err(parseCall "`parse` needs a known target type: `parse::<i64>()` or an annotated `let`")
    return (this.unit())
  }

  fn arg0:RsExpr (args:[RustNode] t:RsType) {
    if ((array_length args) == 0) {
      return (this.unit())
    }
    def v:RsExpr (this.lowerExprCopy((itemAt args 0) t))
    return (this.coerce(v t (itemAt args 0)))
  }

  fn stdMethod:RsExpr (rv:RsExpr name:string args:[RustNode] at:RustNode expect:RsType) {
    def t:RsType rv.ty
    def k:string t.kind
    def c:string rv.code
    def it:RsType (RsType.mk("int"))
    def bt:RsType (RsType.mk("bool"))
    def st:RsType (RsType.mk("string"))
    ; methods every type answers the same way
    if ((name == "clone") || (name == "to_owned") || (name == "cloned") || (name == "copied")) {
      def rc:string (this.bindTemp(rv t "r"))
      return (RsExpr.of((this.cloneCode(rc t)) t))
    }
    if ((name == "as_str") || (name == "as_ref") || (name == "borrow") || (name == "borrow_mut") || (name == "as_mut") || (name == "into")) {
      return rv
    }
    if ((name == "to_string") && (k != "vec")) {
      return (RsExpr.of((this.fmtDisplay(rv "")) (this.ownedString())))
    }
    if (((name == "to_owned") || (name == "clone")) && (k == "string")) {
      return (RsExpr.of(c (this.ownedString())))
    }
    if (k == "vec") {
      return (this.vecMethod(rv name args at expect))
    }
    if ((k == "string") || (k == "char")) {
      return (this.strMethod(rv name args at expect))
    }
    if ((k == "int") || (k == "double")) {
      return (this.numMethod(rv name args at))
    }
    if (k == "opt") {
      return (this.optMethod(rv name args at expect))
    }
    if (k == "result") {
      return (this.resultMethod(rv name args at expect))
    }
    if (k == "entry") {
      lastEntry = rv
      return (this.entryMethod(rv name args at))
    }
    if ((k == "map") || (k == "set")) {
      return (this.mapMethod(rv name args at expect))
    }
    if (k == "unknown") {
      this.err(at (("cannot resolve `." + name) + "()` on a value of unknown type: add a type annotation"))
      return (this.unit())
    }
    this.err(at (((("no method `" + name) + "` on `") + (t.rust())) + "`"))
    return (this.unit())
  }

  fn vecMethod:RsExpr (rv:RsExpr name:string args:[RustNode] at:RustNode expect:RsType) {
    def r:RsExpr (this.vecMethodInner(rv name args at expect))
    def mutating:[string] ([] _:string ("push" "pop" "insert" "remove" "clear" "truncate" "extend" "swap" "reverse" "dedup" "sort" "sort_by" "sort_by_key" "retain"))
    if ((indexOf mutating name) >= 0) {
      this.checkIterMutation((at.kid(0)) at)
      this.writeBackElement(at rv)
    }
    return r
  }

  ; Arrays are values on Go and C++: a Vec read out of a map slot or out of
  ; another Vec is a copy there, so after it changes it is stored back.
  fn writeBackElement:void (call:RustNode rv:RsExpr) {
    def recvN:RustNode (call.kid(0))
    while ((recvN.kind == "unary") || (recvN.kind == "paren")) {
      recvN = (recvN.kid(0))
    }
    if ((recvN.kind == "method") && ((recvN.name == "or_insert") || (recvN.name == "or_insert_with") || (recvN.name == "or_default"))) {
      def bar:int (indexOf lastEntry.code "|")
      if (bar > 0) {
        def m:string (substring lastEntry.code 0 bar)
        def k:string (substring lastEntry.code (bar + 1) (strlen lastEntry.code))
        out.line((this.mapSetLine(m lastEntry.ty k (this.lastVecName))))
      }
      return
    }
    if (recvN.kind == "index") {
      this.assignTo(recvN (this.simpleExpr(lastVecName rv.ty)))
    }
    ; a local bound to a map slot
    if (recvN.kind == "path_expr") {
      def rp:RustNode (recvN.kid(0))
      if ((array_length rp.kids) == 1) {
        def sl@(optional):RsLocal (scope.lookup((this.lastSeg(rp))))
        if (!null? sl) {
          def slot:RsLocal (unwrap sl)
          if (slot.slotMap != "") {
            out.line((this.mapSetLine(slot.slotMap slot.slotTy slot.slotKey slot.rname)))
          }
          if (slot.backTo != "") {
            out.line(((slot.backTo + " = ") + slot.rname))
            this.noteWrittenCase(slot)
          }
        }
      }
    }
  }

  def lastVecName:string ""

  fn vecMethodInner:RsExpr (rv:RsExpr name:string args:[RustNode] at:RustNode expect:RsType) {
    def t:RsType rv.ty
    def et:RsType (t.arg(0))
    def v:string (this.bindTemp(rv t "vec"))
    lastVecName = v
    def it:RsType (RsType.mk("int"))
    def bt:RsType (RsType.mk("bool"))
    if (name == "len") {

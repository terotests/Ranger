      push lines (((("  sfn zeroOf:" + name) + " () {\n    return (new ") + name) + ")\n  }")
      push lines ("}" + (this.helperDoc((("A Rust `" + (t.rust())) + "`: when ok, the value is v; else the error is e"))))
      push genOut (join lines "\n")
    }
    return name
  }

  ; `Ok(x)` / `Err(e)` where the Result type is known.
  fn makeResultValue:RsExpr (isOk:boolean arg:RustNode rt:RsType at:RustNode) {
    def cls:string (this.resultClass(rt))
    def name:string (this.tmp("res"))
    out.line((((("def " + name) + ":") + cls) + ((" (new " + cls) + ")")))
    if (isOk) {

  fn lowerPathCall:RsExpr (segs:[string] args:[RustNode] expect:RsType at:RustNode) {
    def ns:int (array_length segs)
    def name:string (itemAt segs (ns - 1))
    def head:string (itemAt segs (ns - 2))
    def full:string (join segs "::")
    if (head == "Self") {
      head = selfType
    }
    if (has structs head) {
      def s:RsStruct (unwrap (get structs head))
      def m@(optional):RsFn (s.method(name))
      if ((!null? m) && ((array_length s.generics) > 0)) {
        return (this.genericAssocCall(s (unwrap m) args expect at))
      }
      if (!null? m) {
        def mf:RsFn (unwrap m)
        if (mf.hasSelf) {
          ; `Type::method(&x, …)`: a method call
          def recvN:RustNode (itemAt args 0)
          def rest:[RustNode]
          def ai:int 1
          while (ai < (array_length args)) {
            push rest (itemAt args ai)
            ai = ai + 1
          }
          def rv:RsExpr (this.lowerExpr(recvN (RsType.named(head))))
          def recv:string (this.bindTemp(rv rv.ty "r"))
          def codes0:[string] (this.lowerArgs(rest (this.paramTypes(mf))))
          return (RsExpr.of((((((("(" + recv) + ".") + mf.rname) + "(") + (join codes0 " ")) + "))") mf.ret))
        }
        def codes:[string] (this.lowerArgs(args (this.paramTypes(mf))))
        if mf.rgrCtor {
          ; the constructor of a `.rgr` class
          return (RsExpr.of((((("(new " + head) + "(") + (join codes " ")) + "))") (RsType.named(head))))
        }
        if s.rgr {
          return (RsExpr.of((((((("(" + head) + ".") + mf.rname) + "(") + (join codes " ")) + "))") mf.ret))
        }
        def sname:string (this.staticName(name))
        if (mf.statName != "") {
          sname = mf.statName
        }
        return (RsExpr.of((((((("(" + (this.className(head))) + ".") + sname) + "(") + (join codes " ")) + "))") mf.ret))
      }
      this.err(at (((("no associated function `" + name) + "` on `") + head) + "`"))
      return (this.unit())
    }
    if (has enums head) {
      def e:RsEnum (unwrap (get enums head))
      def v@(optional):RsVariant (e.variant(name))
      if (!null? v) {
        def vv:RsVariant (unwrap v)
        def ftypes:[RsType]
        for vv.fields vf:RsField fi {
          push ftypes vf.ty
        }
        def vcodes:[string] (this.lowerArgs(args ftypes))
        return (RsExpr.of((((("(new " + (this.caseType(head name))) + "(") + (join vcodes " ")) + "))") (RsType.named(head))))
      }
      def em@(optional):RsFn (e.method(name))
      if (!null? em) {
        def emf:RsFn (unwrap em)
        def ecodes:[string] (this.lowerArgs(args (this.paramTypes(emf))))
        if (emf.hasSelf) {
          ; `Enum::method(&x, …)` is `x.method(…)`
          def recvN2:RustNode (itemAt args 0)
          def rest2:[RustNode]
          def ri:int 1
          while (ri < (array_length args)) {
            push rest2 (itemAt args ri)
            ri = ri + 1
          }
          def rv2:RsExpr (this.lowerExpr(recvN2 (RsType.named(head))))
          return (this.userMethodCall(rv2 emf rest2 at))
        }
        return (RsExpr.of((((((("(" + (this.implClass(head))) + ".") + (this.staticName(name))) + "(") + (join ecodes " ")) + "))") emf.ret))
      }
      this.err(at (((("no variant or associated function `" + name) + "` in `") + head) + "`"))
      return (this.unit())
    }
    ; the standard library
    if ((full == "String::from") || (full == "String::from_str") || (full == "str::to_string")) {
      def v:RsExpr (this.lowerExpr((itemAt args 0) (RsType.mk("string"))))
      return (RsExpr.of(v.code (this.ownedString())))
    }
    if (full == "String::new") {
      def e:RsExpr (RsExpr.of("\"\"" (this.ownedString())))
      e.simple = true
      return e
    }
    if ((full == "Vec::new") || (full == "Vec::with_capacity") || (full == "HashMap::new") || (full == "BTreeMap::new") || (full == "HashSet::new") || (full == "BTreeSet::new") || (full == "VecDeque::new") || (full == "HashMap::with_capacity") || (full == "Map::new") || (full == "Map::with_capacity")) {
      return (this.emptyCollection(expect at))
    }
    if ((full == "Box::new") || (full == "Rc::new") || (full == "Arc::new") || (full == "RefCell::new") || (full == "Cell::new") || (full == "Rc::clone") || (full == "Arc::clone")) {
      def iv:RsExpr (this.lowerExpr((itemAt args 0) expect))
      return iv
    }
    ; `Rc::downgrade(&x)`: the object, held weakly where it is stored (R7)
    if ((full == "Rc::downgrade") || (full == "Arc::downgrade")) {
      def dv:RsExpr (this.lowerExpr((itemAt args 0) (RsType.mk("unknown"))))
      def wt:RsType (dv.ty.copy())
      wt.weak = true
      wt.isRef = false
      return (RsExpr.of(dv.code wt))
    }
    if ((full == "i64::from") || (full == "i32::from") || (full == "u32::from") || (full == "usize::from") || (full == "u64::from")) {
      def xv:RsExpr (this.lowerExpr((itemAt args 0) (RsType.mk("unknown"))))
      if (xv.ty.kind == "char") {
        return (RsExpr.of((("(rs_char_code " + xv.code) + ")") (RsType.mk("int"))))
      }
      if (xv.ty.kind == "bool") {
        return (RsExpr.of((("(? " + xv.code) + " 1 0)") (RsType.mk("int"))))
      }
      return (RsExpr.of(xv.code (RsType.mk("int"))))
    }
    if (full == "f64::from") {
      def dv:RsExpr (this.lowerExpr((itemAt args 0) (RsType.mk("unknown"))))
      if (dv.ty.kind == "int") {
        return (RsExpr.of((("(to_double " + dv.code) + ")") (RsType.mk("double"))))
      }
      return dv
    }
    if ((full == "std::cmp::max") || (full == "cmp::max") || (full == "max") || (full == "std::cmp::min") || (full == "cmp::min") || (full == "min")) {
      def a:RsExpr (this.lowerExpr((itemAt args 0) expect))
      def b:RsExpr (this.lowerExpr((itemAt args 1) a.ty))
      def op:string "rs_max"
      if (name == "min") {
        op = "rs_min"
      }
      return (RsExpr.of((((((("(" + op) + " ") + a.code) + " ") + b.code) + ")") a.ty))
    }
    if ((full == "std::process::exit") || (full == "process::exit")) {
      def cv:RsExpr (this.lowerExpr((itemAt args 0) (RsType.mk("int"))))
      out.line(("exit " + cv.code))
      return (RsExpr.of("" (RsType.mk("never"))))
    }
    if ((full == "std::mem::swap") || (full == "mem::swap")) {
      this.lowerSwap((itemAt args 0) (itemAt args 1))
      return (this.unit())
    }
    if ((full == "std::mem::take") || (full == "mem::take") || (full == "std::mem::replace") || (full == "mem::replace")) {
      return (this.lowerTake(full args at))
    }
    if ((full == "char::from_u32") || (full == "char::from_digit")) {
      this.unsupported(at (("`" + full) + "` (stage R2)"))
      return (this.unit())
    }
    this.unsupported(at (("the function `" + full) + "`"))
    return (this.unit())
  }

  fn emptyCollection:RsExpr (expect:RsType at:RustNode) {
    def rt:string (this.rtype(expect))
    if (rt == "") {
      this.err(at "an empty collection needs its element type: annotate the `let`")
      return (this.unit())
    }
    def name:string (this.tmp("c"))
    out.line((((("def " + name) + ":") + rt) + (this.initSuffix(expect))))
    def r:RsExpr (RsExpr.of(name expect))
    r.simple = true
    return r
  }

  fn lowerSwap:void (a:RustNode b:RustNode) {
    def av:RsExpr (this.lowerExpr(a (RsType.mk("unknown"))))
    def t:string (this.tmp("sw"))
    out.line(((("def " + (this.declText(t av.ty))) + " ") + av.code))
    def bv:RsExpr (this.lowerExpr(b av.ty))
    this.assignTo(a (RsExpr.of(bv.code av.ty)))
    this.assignTo(b (RsExpr.of(t av.ty)))
  }

  fn lowerTake:RsExpr (full:string args:[RustNode] at:RustNode) {
    def target:RustNode (itemAt args 0)
    def cur:RsExpr (this.lowerExpr(target (RsType.mk("unknown"))))
    def t:string (this.tmp("old"))
    out.line(((("def " + (this.declText(t cur.ty))) + " ") + cur.code))
    if ((indexOf full "replace") >= 0) {
      def nv:RsExpr (this.lowerExpr((itemAt args 1) cur.ty))
      this.assignTo(target nv)
    } {
      def dv:string (this.defaultValue(cur.ty))
      if (dv == "") {
        def rt:string (this.rtype(cur.ty))
        if (((cur.ty.kind == "vec") || (cur.ty.kind == "map") || (cur.ty.kind == "set")) && (rt != "")) {
          def fresh:string (this.tmp("e"))
          out.line(((("def " + fresh) + ":") + rt))
          dv = fresh

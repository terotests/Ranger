          def k:int 0
          while (k < (array_length parts)) {
            if (k > 0) {
              acc = ((("(" + acc) + " + ") + (this.strLit(((", " + (itemAt labels k)) + ": ")))) + ")"
            }
            acc = ((("(" + acc) + " + ") + (itemAt parts k)) + ")"
            k = k + 1
          }
          push lines (("      return (" + acc) + " + \" }\")")
        }
        push lines "    }"
      }
      push lines "    return \"\""
    }
    push lines "  }"
    return (join lines "\n")
  }

  ; The first variant without fields, else the first whose fields all have

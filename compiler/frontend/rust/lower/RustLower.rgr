  ; `{:?}` of an expression of a known type (only an expression; collections
  ; go through the Debug helpers of RsClone).
  fn dbgCode:string (code:string t:RsType) {
    def k:string t.kind
    if ((k == "string")) {
      return (("(rs_dbg " + code) + ")")
    }
    if (k == "char") {
      return (("(RsFmt.dbgChar(" + code) + "))")
    }
    if ((k == "int") || (k == "double") || (k == "bool")) {
      return (("(rs_dbg " + code) + ")")
    }
    if ((k == "named") && (has structs t.name)) {
      return (("(" + code) + ".rs_dbg())")
    }
    if ((k == "named") && (has enums t.name)) {
      return (((("(" + (this.implClass(t.name))) + ".dbgOf(") + code) + "))")
    }
    if (k == "vec") {
      return ((("(" + (this.vecDebugger(t))) + "(") + (code + "))"))
    }
    if (k == "result") {
      def okS:string (this.dbgCode((code + ".v") (t.arg(0))))
      def errS:string (this.dbgCode((code + ".e") (t.arg(1))))
      if ((t.arg(0)).kind == "unit") {
        okS = "\"()\""
      }
      return (((((("(? " + code) + ".ok (\"Ok(\" + (") + okS) + " + \")\")) (\"Err(\" + (") + errS) + " + \")\")))")
    }
    if (k == "opt") {
      def inner:string (this.dbgCode((("(unwrap " + code) + ")") (t.arg(0))))
      return (((("(? (null? " + code) + ") \"None\" (\"Some(\" + (") + inner) + " + \")\")))")
    }
    if (k == "tuple") {
      def parts:[string]
      def i:int 0
      for t.args a:RsType j {
        push parts (this.dbgCode((((code + ".f") + (to_string i))) a))
        i = i + 1
      }
      return (this.concat("(" parts ", " ")"))
    }
    return (("(rs_dbg " + code) + ")")
  }

  fn vecDebugger:string (t:RsType) {
    def key:string ("dbg_" + (this.mangleKey(t)))
    def name:string ("RsClone." + key)
    if (has genNames key) {
      return name
    }
    set genNames key true
    def rt:string (this.rtype(t))
    def lines:[string]
    push lines (((("  sfn " + key) + ":string (src:") + rt) + ") {")
    push lines "    def parts:[string]"
    push lines "    def n:int (array_length src)"
    push lines "    def i:int 0"
    push lines "    while (i < n) {"
    push lines (("      def e:" + (this.rtype((t.arg(0))))) + " (itemAt src i)")
    push lines (("      push parts " + (this.dbgCode("e" (t.arg(0))))))
    push lines "      i = i + 1"
    push lines "    }"
    push lines "    return ((\"[\" + (join parts \", \")) + \"]\")"
    push lines "  }"
    push clonerOut (join lines "\n")
    return name
  }

  ; The variant name of a plain enum value, for `{:?}`.
  fn enumName:string (code:string en:string) {
    def e:RsEnum (unwrap (get enums en))
    def acc:string "\"?\""
    def i:int ((array_length e.variants) - 1)
    while (i >= 0) {
      def v:RsVariant (itemAt e.variants i)
      acc = (((((("(? (" + code) + " == ") + (this.className(en))) + ".") + v.name) + (((") " + (this.strLit(v.name))) + " ") + (acc + ")")))
      i = i - 1
    }
    return acc
  }

  ; The class of each submodule's functions and consts (R6), then the root
  ; module's class, which also holds the nested fns and generic instances.
  fn emitModules:string () {
    def parts:[string]
    def mi:int 1
    while (mi < (array_length modKeys)) {
      def mk:string (itemAt modKeys mi)
      mi = mi + 1
      def sub:[string]
      push sub (("class " + (unwrap (get modClasses mk))) + " {")
      this.emitModuleItems(mk sub)
      ; public when it has public functions, as the root module class is
      def subDoc:RustDocInfo (new RustDocInfo())
      for fnOrder sfk:string sfi {
        def sf:RsFn (unwrap (get fns sfk))
        if ((sf.modKey == mk) && (!null? sf.node)) {
          def sfNode:RustNode (unwrap sf.node)
          if (sfNode.hasMod("pub")) {
            subDoc.isPublic = true
          }
        }
      }
      push sub ("}" + (RustDocReader.tail(subDoc "")))
      push parts (join sub "\n")
    }
    push parts (this.emitModule())
    return (join parts "\n\n")
  }

  fn emitModuleItems:void (mk:string lines:[string]) {
    def ci:int 0
    while (ci < (array_length constOrder)) {
      def cn:string (itemAt constOrder ci)
      ci = ci + 1
      def c:RsConst (unwrap (get consts cn))
      if (c.modKey != mk) {
        continue
      }
      def saveMod:string curMod
      curMod = mk
      push lines (this.emitConst(c))
      curMod = saveMod
    }
    def fi:int 0
    while (fi < (array_length fnOrder)) {
      def fname:string (itemAt fnOrder fi)
      fi = fi + 1
      def f:RsFn (unwrap (get fns fname))
      if (f.modKey != mk) {
        continue
      }
      if ((array_length f.generics) > 0) {
        ; written per instantiation
        continue
      }
      push lines (this.emitFn(f ""))
    }
  }

  fn emitModule:string () {
    def lines:[string]
    push lines (("class " + modClass) + " {")
    this.emitModuleItems("" lines)
    def hi:int 0
    def gi:int 0
    while ((hi < (array_length hoistQueue)) || (gi < (array_length fnInstQueue))) {
      if (hi < (array_length hoistQueue)) {
        def hf:RsFn (itemAt hoistQueue hi)
        hi = hi + 1
        push lines (this.emitFn(hf ""))
        continue
      }
      def inst:RsInst (itemAt fnInstQueue gi)
      gi = gi + 1
      genericEnv = inst.env
      fnNameOverride = inst.name
      push lines (this.emitFn((unwrap inst.fnDef) ""))
      fnNameOverride = ""
      def noEnv:[string:RsType]
      genericEnv = noEnv
    }
    ; the module is public when it has public functions
    for fnOrder pfn:string pfi {
      def pf:RsFn (unwrap (get fns pfn))
      if (!null? pf.node) {
        def pfNode:RustNode (unwrap pf.node)
        if (pfNode.hasMod("pub")) {
          moduleDoc.isPublic = true
        }
      }
    }
    push lines ("}" + (RustDocReader.tail(moduleDoc "")))
    return (join lines "\n")
  }

  ; ---------------------------------------------------------- rustdoc (R5)

  def moduleDoc:RustDocInfo (new RustDocInfo())
  ; item position -> the example functions made from its doctests
  def docExamples:[string:string]

  fn docKey:string (n:RustNode) {
    return (((to_string n.line) + ":") + (to_string n.col))
  }

  ; A generated class that stands for a Rust type in a signature (a Result,
  ; a tuple, a Map) is public: a documented public function may take or
  ; return it, and the API documentation has to name it.
  fn helperDoc:string (text:string) {
    def info:RustDocInfo (new RustDocInfo())
    ; not folded into the `new`: the Rust build passes `info` on as `&mut`,
    ; and a folded local is bound without `mut`
    def descText:string text
    info.isPublic = true
    info.description = descText
    return (RustDocReader.tail(info ""))
  }

  ; The ` doc { … }` tail of an item, or "".
  fn docTail:string (n:RustNode ind:string) {
    def info:RustDocInfo (RustDocReader.read(n.attrs (n.hasMod("pub"))))
    def key:string (this.docKey(n))
    if (has docExamples key) {
      def names:[string] (strsplit (unwrap (get docExamples key)) " ")
      for names en:string ei {
        push info.exampleNames en
      }
    }
    return (RustDocReader.tail(info ind))
  }

  ; Each rust code block under `# Examples` becomes a free function
  ; `doc_example_<item>_<n>`, lowered with the module (so it is type
  ; checked, as `cargo test` checks a doctest) and named by the item's
  ; `example` entry. Lines that `use` the crate are left out: every item is
  ; in scope already.
  fn addDocExamples:void (root:RustNode) {
    def items:[RustNode]
    for root.kids it:RustNode i {
      push items it
      if (it.kind == "impl") {
        for it.kids m:RustNode j {
          if (m.kind == "fn") {
            push items m
          }
        }
      }
    }
    def src:string ""
    def made:int 0
    for items item:RustNode k {
      def info:RustDocInfo (RustDocReader.read(item.attrs false))
      if ((array_length info.codeExamples) == 0) {
        continue
      }
      def names:[string]
      for info.codeExamples code:string ci {
        if ((indexOf code "fn main") >= 0) {
          continue
        }
        made = made + 1
        def fname:string ((((("doc_example_" + (this.docExampleStem(item.name))) + "_") + (to_string (ci + 1)))))
        push names fname
        def keep:[string]
        def codeLines:[string] (strsplit code "\n")
        for codeLines cl:string cli {
          def tcl:string (trim cl)
          if (((strlen tcl) >= 4) && ((substring tcl 0 4) == "use ")) {
            continue
          }
          push keep cl
        }
        src = (((((src + "fn ") + fname) + "() {\n") + (join keep "\n")) + "\n}\n")
      }
      if ((array_length names) > 0) {
        set docExamples (this.docKey(item)) (join names " ")
      }
    }
    if (made == 0) {
      return
    }
    def p:RustParser (new RustParser(src))
    def exRoot:RustNode (p.parseFile())
    for p.errors e:string ei {
      push errors (((fileName + ": in a doc example: ") + e))
    }
    for exRoot.kids ex:RustNode xi {
      root.add(ex)
    }
  }

  fn docExampleStem:string (n:string) {
    def out:string ""
    def cs:[int] (to_chars n)
    for cs c:int i {
      if ((c >= 65) && (c <= 90)) {
        if (i > 0) {
          out = out + "_"
        }
        out = out + (strfromcode (c + 32))
      } {
        out = out + (strfromcode c)
      }
    }
    return out
  }

  fn emitConst:string (c:RsConst) {
    ; a const is a static function: Ranger classes have no static fields
    this.beginFn()
    def node:RustNode (unwrap c.node)
    def e:RsExpr (this.lowerExpr((node.kid(1)) c.ty))
    def body:[string] out.lines
    def lines:[string]
    push lines ((((("  sfn " + (this.staticName(c.name))) + ":") + (this.rtype(c.ty))) + " () {"))
    for body b:string i {
      push lines b
    }
    push lines (("    return " + e.code))
    push lines "  }"
    return (join lines "\n")
  }

  ; Labelled-exit flags are declared at the top of the function.
  fn prependFlags:void () {
    if ((array_length pendingFlags) == 0) {
      return
    }
    def lines:[string]
    for pendingFlags f:string i {
      push lines (("    def " + f) + ":boolean false")
    }
    for out.lines l:string j {
      push lines l
    }
    out.lines = lines
    def none:[string]
    pendingFlags = none
  }

  fn beginFn:void () {
    def noLocals:[RsLocal]
    fnLocals = noLocals
    out = (new RustOut())
    out.ind = "    "
    scope = (new RsScope())
    def fresh:[string:boolean]
    used = fresh
    tmpN = 0
    def lv:[string]
    loopVals = lv
    def ll:[string]
    loopLabels = ll
    def lf:[string]
    loopFlags = lf
    def lk:[string]
    loopFlagKind = lk
  }

  ; `fn` / `sfn` text for a function or method.
  def fnNameOverride:string ""

  ; Names in a function body are looked up from the module it is in.
  fn emitFn:string (f:RsFn owner:string) {
    def saveMod:string curMod
    def saveFile:string fileName
    curMod = f.modKey
    if (has modFileOf f.modKey) {
      fileName = (unwrap (get modFileOf f.modKey))
    }
    def text:string (this.emitFnIn(f owner))
    curMod = saveMod
    fileName = saveFile
    return text
  }

  fn emitFnIn:string (f:RsFn owner:string) {
    if (((array_length f.generics) > 0) && (fnNameOverride == "")) {
      ; a generic method: written per instantiation of its call
      this.unsupported((unwrap f.node) (("the generic method `" + f.name) + "`"))
      return ""
    }
    if (false == f.hasBody) {
      return ""
    }
    this.beginFn()
    selfType = owner
    def fret:RsType (this.subst(f.ret genericEnv))
    def isFmt:boolean ((f.name == "fmt") && ((f.fromTrait == "Display") || (f.fromTrait == "Debug")))
    if (isFmt) {
      fret = (RsType.mk("unit"))
      if ((array_length f.params) > 0) {
        def fp:RsParam (itemAt f.params 0)
        displayFormatter = fp.name
      }
    }
    retType = fret
    def ps:[string]
    def destructure:[RustNode]
    def destructureNames:[string]
    def destructureTypes:[RsType]
    for f.params p:RsParam i {
      def pat:RustNode (unwrap p.pat)
      def pty:RsType (this.subst(p.ty genericEnv))
      if (isFmt) {
        ; the Formatter is the string being built
        continue
      }
      if ((pat.kind == "pat_ident") && p.boxed) {
        def bl:RsLocal (this.declare(p.name pty))
        def boxName:string (bl.rname + "_box")
        set used boxName true
        push ps ((boxName + ":") + (this.boxClass(pty)))
        bl.rname = (boxName + ".v")
        continue
      }
      if (pat.kind == "pat_ident") {
        def l:RsLocal (this.declare(p.name pty))
        push ps (this.declText(l.rname pty))
      } {
        def wn:string (this.allocLocal("arg"))
        push ps (this.declText(wn pty))
        if (pat.kind != "pat_wild") {
          push destructure pat
          push destructureNames wn
          push destructureTypes pty
        }
      }
    }
    def di:int 0
    while (di < (array_length destructure)) {
      this.bindPattern((itemAt destructure di) (itemAt destructureNames di) (itemAt destructureTypes di))
      di = di + 1
    }
    def enumOwner:boolean ((owner != "") && (has enums owner))
    def selfT:RsType (RsType.named(owner))
    for selfArgs sa:RsType sai {
      push selfT.args sa
    }
    if (f.hasSelf) {
      if (enumOwner) {
        this.alias("self" "self_" (RsType.named(owner)))
        set used "self_" true
        def selfDecl:[string]
        push selfDecl (("self_:" + (this.className(owner))))
        for ps pp:string pi2 {
          push selfDecl pp
        }
        ps = selfDecl
      } {
        this.alias("self" "this" selfT)
      }
    }
    def node:RustNode (unwrap f.node)
    def body:RustNode (node.kid(4))
    if (isFmt) {
      out.line("def rs__out:string \"\"")
    }
    def saveSelfMut:boolean selfIsMut
    selfIsMut = (f.hasSelf && f.selfMut)
    this.lowerBody(body fret)
    selfIsMut = saveSelfMut
    if (isFmt) {
      out.line("return rs__out")
      displayFormatter = ""
      fret = (RsType.mk("string"))
    }
    this.prependFlags()
    def kw:string "sfn"
    if (f.hasSelf && (false == enumOwner)) {
      kw = "fn"
    }
    def name:string f.rname
    if ((owner == "") || (false == f.hasSelf) || enumOwner) {
      name = (this.staticName(f.name))
      if (f.statName != "") {
        name = f.statName
      }
    }
    if (fnNameOverride != "") {
      name = fnNameOverride
    }
    if (isFmt) {
      if (enumOwner) {
        name = "displayOf"
        if (f.fromTrait == "Debug") {
          name = "dbgOf"
        }
      } {
        name = "rs_display"
        if (f.fromTrait == "Debug") {
          name = "rs_dbg"
        }
      }
    }
    def retText:string (this.rtype(fret))
    if (retText == "") {
      retText = "void"
      if (fret.kind != "unit") {
        this.err(node (("the return type of `" + f.name) + "` is not in the subset"))
      }
    }
    def head:string ((("  " + kw) + " ") + name)
    if (fret.kind == "opt") {
      head = head + "@(optional)"
    }
    def lines:[string]
    push lines ((((head + ":") + retText) + " (") + ((join ps " ") + ") {"))
    for out.lines b:string j {
      push lines b
    }
    def fnDoc:string ""
    if ((fnNameOverride == "") && (f.fromTrait == "") && (false == isFmt) && (!null? f.node)) {
      fnDoc = (this.docTail((unwrap f.node) "  "))
    }
    push lines ("  }" + fnDoc)
    return (join lines "\n")
  }

  ; A function body: statements, then the tail expression as the return.
  fn lowerBody:void (body:RustNode ret:RsType) {
    this.pushScope()
    def n:int (array_length body.kids)
    def i:int 0
    while (i < n) {
      def st:RustNode (body.kid(i))
      if ((i == (n - 1)) && (this.isTail(st))) {
        def e:RustNode (st.kid(0))
        if ((ret.kind == "unit") || (ret.kind == "never")) {
          this.lowerStmtExpr(e)
        } {
          this.emitReturn(e)
        }
      } {
        this.lowerStmt(st)
      }
      i = i + 1
    }
    this.popScope()
  }

  fn isTail:boolean (st:RustNode) {
    return ((st.kind == "expr_stmt") && (false == (st.hasMod(";"))))
  }

  fn emitReturn:void (e:RustNode) {
    if (displayFormatter != "") {
      this.lowerStmtExpr(e)
      out.line("return rs__out")
      return
    }
    if (this.divergesAll(e)) {
      this.lowerStmtExpr(e)
      return
    }
    def v:RsExpr (this.lowerExpr(e retType))
    this.noteMove(e v.ty)
    if (lastReturn.isUnknown()) {
      lastReturn = v.ty
    }
    def c:RsExpr (this.coerce(v retType e))
    out.line(("return " + c.code))
  }

  ; ------------------------------------------------------------ statements

  fn lowerStmt:void (st:RustNode) {
    def k:string st.kind
    if (k == "let") {
      this.lowerLet(st)
      return
    }
    if (k == "expr_stmt") {
      this.lowerStmtExpr((st.kid(0)))
      return
    }
    if (k == "empty") {
      return
    }
    if (k == "fn") {
      this.hoistFn(st)
      return
    }
    this.unsupported(st (("`" + k) + "` inside a function body"))
  }

  ; A nested fn is written as a static function of the module class, after
  ; the function that holds it (so no lowering state has to be saved).
  fn hoistFn:void (st:RustNode) {
    def f:RsFn (this.fnSig(st ""))
    f.rname = (this.staticName(st.name))
    ; written into the root module class, next to the generic instances
    f.modCls = modClass
    def hk:string (this.fnKey(curMod st.name))
    if (has fns hk) {
      this.unsupported(st (("a nested fn named like a module fn (`" + st.name) + "`)"))
      return
    }
    set fns hk f
    push hoistQueue f
  }

  def hoistQueue:[RsFn]

  fn lowerLet:void (st:RustNode) {
    def pat:RustNode (st.kid(0))
    def tyN:RustNode (st.kid(1))
    def init:RustNode (st.kid(2))
    def elseB:RustNode (st.kid(3))
    def declared:RsType (RsType.mk("unknown"))
    if (false == (tyN.isNone())) {
      declared = (this.typeOf(tyN))
    }
    if (false == (elseB.isNone())) {
      this.lowerLetElse(pat init elseB declared)
      return
    }
    if (init.isNone()) {
      if (pat.kind != "pat_ident") {
        this.unsupported(pat "a destructuring `let` without a value")
        return
      }
      if (declared.isUnknown()) {
        this.err(st "a `let` without a value needs a type annotation")
        return
      }
      def l:RsLocal (this.declare(pat.name declared))
      out.line(("def " + (this.fieldDecl(l.rname declared))))
      return
    }
    if (pat.kind == "pat_ident") {
      if ((array_length pat.kids) > 0) {
        this.unsupported(pat "`name @ pattern` in a `let`")
        return
      }
      def v:RsExpr (this.lowerExprCopy(init declared))
      def t:RsType declared
      if (t.isUnknown()) {
        t = v.ty
      }
      def c:RsExpr (this.coerce(v t init))
      def l2:RsLocal (this.declare(pat.name t))
      if (c.code == "") {
        out.line(("def " + (this.fieldDecl(l2.rname t))))
      } {
        out.line(((("def " + (this.declText(l2.rname t))) + " ") + c.code))
      }
      ; `let list = map.entry(k).or_insert_with(Vec::new)`: the Vec is a
      ; copy on Go and C++, so its changes are stored back in the slot
      def initM:RustNode init
      while ((initM.kind == "unary") || (initM.kind == "paren")) {
        initM = (initM.kid(0))
      }
      if ((initM.kind == "method") && ((initM.name == "or_insert") || (initM.name == "or_insert_with") || (initM.name == "or_default")) && ((t.kind == "vec") || (t.kind == "map") || (t.kind == "set"))) {
        def bar:int (indexOf lastEntry.code "|")
        if (bar > 0) {
          l2.slotMap = (substring lastEntry.code 0 bar)
          l2.slotKey = (substring lastEntry.code (bar + 1) (strlen lastEntry.code))
          l2.slotTy = lastEntry.ty
        }
      }
      return
    }
    if (pat.kind == "pat_wild") {
      def v2:RsExpr (this.lowerExpr(init declared))
      this.discard(v2)
      return
    }
    ; destructuring: bind the value once, then each part
    def v3:RsExpr (this.lowerExprCopy(init declared))
    def t3:RsType declared
    if (t3.isUnknown()) {
      t3 = v3.ty
    }
    def subj:string (this.bindTemp(v3 t3 "v"))
    this.bindPatternRef(pat subj t3 (this.matchesMut(init v3.ty)))
  }

  ; `let PAT = e else { … };`
  fn lowerLetElse:void (pat:RustNode init:RustNode elseB:RustNode declared:RsType) {
    def v:RsExpr (this.lowerExpr(init declared))
    def t:RsType v.ty
    def subj:string (this.bindTemp(v t "v"))
    def cond:string (this.patCond(pat subj t))
    out.line((("if (! " + cond) + ") {"))
    out.indent()
    this.lowerBlockStmts(elseB)
    out.dedent()
    out.line("}")
    this.bindPatternRef(pat subj t (this.matchesMut(init t)))
  }

  ; Lowers an expression used as a statement.
  fn lowerStmtExpr:void (e:RustNode) {
    def k:string e.kind
    if (this.isBranchy(e)) {
      this.lowerBranchy(e "stmt" "")
      return
    }
    if (k == "while") {
      this.lowerWhile(e)
      return
    }
    if (k == "loop") {
      this.lowerLoop(e "")
      return
    }
    if (k == "for") {
      this.lowerFor(e)
      return
    }
    if (k == "block") {
      if ((array_length e.mods) > 0) {
        this.unsupported(e (("a `" + (join e.mods " ")) + "` block"))
        return
      }
      this.pushScope()
      this.lowerBlockStmts(e)
      this.popScope()
      return
    }
    if (k == "assign") {
      this.lowerAssign(e)
      return
    }
    if (k == "return") {
      if (displayFormatter != "") {
        if ((array_length e.kids) > 0) {
          this.lowerStmtExpr((e.kid(0)))
        }
        out.line("return rs__out")
        return
      }
      if ((array_length e.kids) == 0) {
        out.line("return")
        return
      }
      this.emitReturn((e.kid(0)))
      return
    }
    if (k == "break") {
      this.lowerBreak(e)
      return
    }
    if (k == "continue") {
      this.lowerContinue(e)
      return
    }
    if (k == "macro_call") {
      if (this.lowerMacroStmt(e)) {
        return
      }
    }
    def v:RsExpr (this.lowerExpr(e (RsType.mk("unknown"))))
    this.discard(v)
  }

  ; A value computed for its side effects: a call becomes a statement,
  ; anything else is dropped (it has none left once its temporaries ran).
  fn discard:void (v:RsExpr) {
    if (v.code == "") {
      return
    }
    def c:string v.code
    if (this.isCallCode(c)) {
      out.line((this.unparen(c)))
    }
  }

  fn unparen:string (c:string) {
    if (((strlen c) >= 2) && ((substring c 0 1) == "(") && ((substring c ((strlen c) - 1) (strlen c)) == ")")) {
      ; only when the outer parentheses enclose the whole text
      def depth:int 0
      def cs:[int] (to_chars c)
      def i:int 0
      def n:int (array_length cs)
      while (i < n) {
        def ch:int (itemAt cs i)
        if (ch == 34) {
          ; skip a string literal
          i = i + 1
          while ((i < n) && ((itemAt cs i) != 34)) {
            if ((itemAt cs i) == 92) {
              i = i + 1
            }
            i = i + 1
          }
        } {
          if (ch == 40) {
            depth = depth + 1
          }
          if (ch == 41) {
            depth = depth - 1
            if ((depth == 0) && (i < (n - 1))) {
              return c
            }
          }
        }
        i = i + 1
      }
      return (substring c 1 ((strlen c) - 1))
    }
    return c
  }

  ; A call in Ranger text: `X.m(…)`, `(X.m(…))` or an operator statement.
  fn isCallCode:boolean (c:string) {
    def u:string (this.unparen(c))
    if ((indexOf u "(") < 0) {
      return false
    }
    if ((substring u 0 1) == "(") {
      return false
    }
    ; `recv.m(…)`, `Class.m(…)`, or `f(…)` calling a closure in a local:
    ; a name, then `(`
    def cs:[int] (to_chars u)
    def i:int 0
    while (i < (array_length cs)) {
      def c:int (itemAt cs i)
      if (c == 40) {
        return (i > 0)
      }
      def ok:boolean (((c >= 48) && (c <= 57)) || ((c >= 65) && (c <= 90)) || ((c >= 97) && (c <= 122)) || (c == 95) || (c == 46))
      if (false == ok) {
        return false
      }
      i = i + 1
    }
    return false
  }

  fn lowerBlockStmts:void (b:RustNode) {
    for b.kids st:RustNode i {
      this.lowerStmt(st)
    }
  }

  ; Lowers a block whose value goes to `target` ("return", "assign" to
  ; `var`, or "stmt" when unused).
  fn lowerBlockValue:void (b:RustNode mode:string var:string) {
    this.pushScope()
    def n:int (array_length b.kids)
    def i:int 0
    while (i < n) {
      def st:RustNode (b.kid(i))
      if ((i == (n - 1)) && (this.isTail(st))) {
        this.lowerValueTo((st.kid(0)) mode var)
      } {
        this.lowerStmt(st)
      }
      i = i + 1
    }
    this.popScope()
  }

  ; Sends the value of `e` to `mode`: return it, assign it to `var`, or drop.
  fn lowerValueTo:void (e:RustNode mode:string var:string) {
    if (mode == "stmt") {
      this.lowerStmtExpr(e)
      return
    }
    if (this.divergesAll(e)) {
      this.lowerStmtExpr(e)
      return
    }
    if (this.isBranchy(e)) {
      this.lowerBranchy(e mode var)
      return
    }
    if (e.kind == "block") {
      this.lowerBlockValue(e mode var)
      return
    }
    if (mode == "return") {
      this.emitReturn(e)
      return
    }
    def target:RsType (this.varType(var))
    def v:RsExpr (this.lowerExprCopy(e target))
    if ((target.isUnknown()) || (target.kind == "none")) {
      if ((false == (v.ty.isUnknown())) && (v.ty.kind != "never")) {
        set tempTypes var v.ty
        target = v.ty
      }
    }
    def c:RsExpr (this.coerce(v target e))
    if (c.code != "") {
      out.line(((var + " = ") + c.code))
    }
  }

  ; The type recorded for a temporary made by valueTemp.
  def tempTypes:[string:RsType]

  fn varType:RsType (var:string) {
    if (has tempTypes var) {
      def t:RsType (unwrap (get tempTypes var))
      return t
    }
    return (RsType.mk("unknown"))
  }

  ; `return`, `break`, `continue`, `panic!` -- an expression that does not
  ; produce a value.
  fn divergesAll:boolean (e:RustNode) {
    def k:string e.kind
    if ((k == "return") || (k == "break") || (k == "continue")) {
      return true
    }
    if ((k == "macro_call") && ((e.name == "panic") || (e.name == "unreachable") || (e.name == "todo") || (e.name == "unimplemented"))) {
      return true
    }
    return false
  }

  fn isBranchy:boolean (e:RustNode) {
    return ((e.kind == "if") || (e.kind == "match"))
  }

  fn lowerBranchy:void (e:RustNode mode:string var:string) {
    if (e.kind == "if") {
      this.lowerIf(e mode var)
      return
    }
    this.lowerMatch(e mode var)
  }

  ; --------------------------------------------------------------- if/else

  fn lowerIf:void (e:RustNode mode:string var:string) {
    def cond:RustNode (e.kid(0))
    def thenB:RustNode (e.kid(1))
    def elseN:RustNode (e.kid(2))
    if (this.hasLet(cond)) {
      this.lowerIfLet(e mode var)
      return
    }
    def c:RsExpr (this.lowerCond(cond))
    def before:[RsLocal] (this.movedSnapshot())
    out.line((("if " + (this.condText(c.code))) + " {"))
    out.indent()
    this.lowerBlockValue(thenB mode var)
    out.dedent()
    def afterA:[RsLocal] (this.movedSnapshot())
    if (this.blockDiverges(thenB)) {
      afterA = before
    }
    if (elseN.isNone()) {
      out.line("}")
      this.movedRestore((this.movedUnion(before afterA)))
      return
    }
    this.movedRestore(before)
    out.line("} {")
    out.indent()
    if (elseN.kind == "if") {
      this.lowerIf(elseN mode var)
    } {
      this.lowerBlockValue(elseN mode var)
    }
    out.dedent()
    out.line("}")
    def afterB:[RsLocal] (this.movedSnapshot())
    if ((elseN.kind == "block") && (this.blockDiverges(elseN))) {
      afterB = before
    }
    this.movedRestore((this.movedUnion(afterA afterB)))
  }

  ; `(cond)` as Ranger wants it after `if` / `while`.
  fn condText:string (c:string) {
    if (((strlen c) > 0) && ((substring c 0 1) == "(") && ((this.unparen(c)) != c)) {
      return c
    }
    return (("(" + c) + ")")
  }

  fn hasLet:boolean (c:RustNode) {
    if (c.kind == "let_cond") {
      return true
    }
    if ((c.kind == "bin") && (c.name == "&&")) {
      return ((this.hasLet((c.kid(0)))) || (this.hasLet((c.kid(1)))))
    }
    return false
  }

  ; `if let P = e && more { … } else { … }`: each `let` narrows, the rest
  ; of the chain is checked inside it.
  fn lowerIfLet:void (e:RustNode mode:string var:string) {
    def parts:[RustNode]
    this.flattenAnd((e.kid(0)) parts)
    def thenB:RustNode (e.kid(1))
    def elseN:RustNode (e.kid(2))
    ; a flag makes the else branch run once, whichever test failed
    def hasElse:boolean (false == (elseN.isNone()))
    def flag:string ""
    if (hasElse) {
      flag = (this.tmp("ok"))
      out.line((("def " + flag) + ":boolean false"))
    }
    this.pushScope()
    def opened:int 0
    for parts p:RustNode i {
      if (p.kind == "let_cond") {
        def v:RsExpr (this.lowerExpr((p.kid(1)) (RsType.mk("unknown"))))
        def subj:string (this.bindTemp(v v.ty "m"))
        if (this.needsOpen((p.kid(0)) v.ty)) {
          opened = opened + (this.patOpenRef((p.kid(0)) subj v.ty (this.matchesMut((p.kid(1)) v.ty))))
        } {
          def cond:string (this.patCond((p.kid(0)) subj v.ty))
          out.line((("if " + (this.condText(cond))) + " {"))
          out.indent()
          opened = opened + 1
          this.bindPatternRef((p.kid(0)) subj v.ty (this.matchesMut((p.kid(1)) v.ty)))
        }
      } {
        def c:RsExpr (this.lowerCond(p))
        out.line((("if " + (this.condText(c.code))) + " {"))
        out.indent()
        opened = opened + 1
      }
    }
    if (hasElse) {
      out.line((flag + " = true"))
    }
    def before:[RsLocal] (this.movedSnapshot())
    this.lowerBlockValue(thenB mode var)
    def afterA:[RsLocal] (this.movedSnapshot())
    if (this.blockDiverges(thenB)) {
      afterA = before
    }
    while (opened > 0) {
      out.dedent()
      out.line("}")
      opened = opened - 1
    }
    this.popScope()
    if (hasElse) {
      this.movedRestore(before)
      out.line((("if (! " + flag) + ") {"))
      out.indent()
      if (elseN.kind == "if") {
        this.lowerIf(elseN mode var)
      } {
        this.lowerBlockValue(elseN mode var)
      }
      out.dedent()
      out.line("}")
      def afterB:[RsLocal] (this.movedSnapshot())
      if ((elseN.kind == "block") && (this.blockDiverges(elseN))) {
        afterB = before
      }
      this.movedRestore((this.movedUnion(afterA afterB)))
    } {
      this.movedRestore((this.movedUnion(before afterA)))
    }
  }

  fn flattenAnd:void (c:RustNode parts:[RustNode]) {
    if ((c.kind == "bin") && (c.name == "&&")) {
      this.flattenAnd((c.kid(0)) parts)
      this.flattenAnd((c.kid(1)) parts)
      return
    }
    push parts c
  }

  ; A boolean condition; temporaries it needs are emitted before it.
  fn lowerCond:RsExpr (c:RustNode) {
    def v:RsExpr (this.lowerExpr(c (RsType.mk("bool"))))
    return v
  }

  ; ----------------------------------------------------------------- loops

  fn pushLoop:void (label:string valVar:string) {
    push loopLabels label
    push loopVals valVar
    push loopFlags ""
    push loopFlagKind ""
  }

  fn popLoop:void () {
    removeLast loopLabels
    removeLast loopVals
    removeLast loopFlags
    removeLast loopFlagKind
  }

  fn lowerWhile:void (e:RustNode) {
    def cond:RustNode (e.kid(0))
    def body:RustNode (e.kid(1))
    this.pushLoop(e.name "")
    ; the condition runs every iteration, so anything it emits must too
    def save:RustOut out
    out = (new RustOut())
    out.ind = save.ind
    out.indent()
    def isLet:boolean (this.hasLet(cond))
    def c:RsExpr (RsExpr.of("" (RsType.mk("bool"))))
    if (false == isLet) {
      c = (this.lowerCond(cond))
    }
    def pre:[string] out.lines
    out = save
    if (isLet || ((array_length pre) > 0)) {
      out.line("while true {")
      out.indent()
      if (isLet) {
        this.pushScope()
        if (this.whileLetNarrows(cond)) {
          this.whileLetOpen(cond body)
        } {
          this.whileLetHead(cond)
          this.lowerLoopBody(body)
        }
        this.popScope()
      } {
        out.addAll(pre)
        out.line((("if (! " + c.code) + ") {"))
        out.line("  break")
        out.line("}")
        this.lowerLoopBody(body)
      }
      out.dedent()
      out.line("}")
    } {
      out.line((("while " + (this.condText(c.code))) + " {"))
      out.indent()
      this.lowerLoopBody(body)
      out.dedent()
      out.line("}")
    }
    this.afterLoop()
    this.popLoop()
  }

  fn whileLetNarrows:boolean (cond:RustNode) {
    def parts:[RustNode]
    this.flattenAnd(cond parts)
    for parts p:RustNode i {
      if (p.kind == "let_cond") {
        ; the type is not known before lowering; a data-enum or Result
        ; pattern names its variant, which is enough to decide
        def pp:RustNode (p.kid(0))
        def pk:string pp.kind
        if ((pk == "pat_tuple_struct") || (pk == "pat_struct") || (pk == "pat_path")) {
          def pn:string (this.lastSeg((pp.kid(0))))
          if (pn != "Some") {
            return true
          }
          if ((array_length pp.kids) > 1) {
            def inner:RustNode (pp.kid(1))
            if ((inner.kind == "pat_tuple_struct") || (inner.kind == "pat_struct")) {
              return true
            }
          }
        }
      }
    }
    return false
  }

  ; `while let` whose pattern narrows: the body runs inside the tests, and
  ; the loop ends when they did not all pass.
  fn whileLetOpen:void (cond:RustNode body:RustNode) {
    def parts:[RustNode]
    this.flattenAnd(cond parts)
    def hit:string (this.tmp("hit"))
    out.line((("def " + hit) + ":boolean false"))
    def opened:int 0
    for parts p:RustNode i {
      if (p.kind == "let_cond") {
        def v:RsExpr (this.lowerExpr((p.kid(1)) (RsType.mk("unknown"))))
        def subj:string (this.bindTemp(v v.ty "m"))
        opened = opened + (this.patOpen((p.kid(0)) subj v.ty))
      } {
        def c:RsExpr (this.lowerCond(p))
        out.line((("if " + (this.condText(c.code))) + " {"))
        out.indent()
        opened = opened + 1
      }
    }
    out.line((hit + " = true"))
    this.lowerLoopBody(body)
    this.closeBlocks(opened)
    out.line((("if (! " + hit) + ") {"))
    out.line("  break")
    out.line("}")
  }

  ; `while let P = e && …`: test each part, break when one fails.
  fn whileLetHead:void (cond:RustNode) {
    def parts:[RustNode]
    this.flattenAnd(cond parts)
    for parts p:RustNode i {
      if (p.kind == "let_cond") {
        def v:RsExpr (this.lowerExpr((p.kid(1)) (RsType.mk("unknown"))))
        def subj:string (this.bindTemp(v v.ty "m"))
        def pc:string (this.patCond((p.kid(0)) subj v.ty))
        out.line((("if (! " + pc) + ") {"))
        out.line("  break")
        out.line("}")
        this.bindPatternRef((p.kid(0)) subj v.ty (this.matchesMut((p.kid(1)) v.ty)))
      } {
        def c:RsExpr (this.lowerCond(p))
        out.line((("if (! " + c.code) + ") {"))
        out.line("  break")
        out.line("}")
      }
    }
  }

  fn lowerLoopBody:void (body:RustNode) {
    def before:[RsLocal] (this.movedSnapshot())
    def firstInside:int (array_length fnLocals)
    this.pushScope()
    this.lowerBlockStmts(body)
    this.popScope()
    this.checkLoopMoves(before firstInside body)
    this.movedRestore((this.movedUnion(before (this.movedSnapshot()))))
  }

  ; `loop { … }`; `var` receives a `break value` when the loop is a value.
  fn lowerLoop:void (e:RustNode var:string) {
    this.pushLoop(e.name var)
    out.line("while true {")
    out.indent()
    this.lowerLoopBody((e.kid(0)))
    out.dedent()
    out.line("}")
    this.afterLoop()
    this.popLoop()
  }

  ; After an inner loop that a labelled break / continue left: pass the exit
  ; on to the loop that owns the label.
  fn afterLoop:void () {
    def n:int (array_length loopFlags)
    def flag:string (itemAt loopFlags (n - 1))
    if (flag == "") {
      return
    }
    def kind:string (itemAt loopFlagKind (n - 1))
    ; the flag names its target loop; this loop has already exited
    def target:string (this.flagTarget(flag))
    def depth:int (this.loopIndexOf(target))
    if (depth == (n - 2)) {
      ; the enclosing loop is the target
      if (kind == "break") {
        out.line((("if " + flag) + " {"))
        out.line((("  " + flag) + " = false"))
        out.line("  break")
        out.line("}")
      } {
        out.line((("if " + flag) + " {"))
        out.line((("  " + flag) + " = false"))
        out.line("  continue")
        out.line("}")
      }
    } {
      ; further out: keep leaving
      out.line((("if " + flag) + " {"))
      out.line("  break")
      out.line("}")
      def up:int (n - 2)
      if (up >= 0) {
        set_at loopFlags up flag
        set_at loopFlagKind up kind
      }
    }
  }

  def flagTargets:[string:string]

  fn flagTarget:string (flag:string) {
    if (has flagTargets flag) {
      def t:string (unwrap (get flagTargets flag))
      return t
    }
    return ""
  }

  fn loopIndexOf:int (label:string) {
    def i:int ((array_length loopLabels) - 1)
    while (i >= 0) {
      if ((itemAt loopLabels i) == label) {
        return i
      }
      i = i - 1
    }
    return -1
  }

  fn lowerBreak:void (e:RustNode) {
    def n:int (array_length loopLabels)
    if (n == 0) {
      this.err(e "`break` outside a loop")
      return
    }
    def target:int (n - 1)
    if (e.name != "") {
      target = (this.loopIndexOf(e.name))
      if (target < 0) {
        this.err(e (("unknown label " + e.name)))
        return
      }
    }
    if ((array_length e.kids) > 0) {
      def var:string (itemAt loopVals target)
      if (var == "") {
        this.err(e "`break` with a value outside a `loop` expression")
        return
      }
      def vt:RsType (this.varType(var))
      def v:RsExpr (this.lowerExprCopy((e.kid(0)) vt))
      def c:RsExpr (this.coerce(v vt (e.kid(0))))
      out.line(((var + " = ") + c.code))
    }
    if (target == (n - 1)) {
      out.line("break")
      return
    }
    this.labelledExit(target "break")
  }

  fn lowerContinue:void (e:RustNode) {
    def n:int (array_length loopLabels)
    if (n == 0) {
      this.err(e "`continue` outside a loop")
      return
    }
    def target:int (n - 1)
    if (e.name != "") {
      target = (this.loopIndexOf(e.name))
      if (target < 0) {
        this.err(e (("unknown label " + e.name)))
        return
      }
    }
    if (target == (n - 1)) {
      out.line("continue")
      return
    }
    this.labelledExit(target "continue")
  }

  ; A break / continue of an outer loop: set a flag, leave this loop, and let
  ; afterLoop pass it outward.
  fn labelledExit:void (target:int kind:string) {
    def n:int (array_length loopLabels)
    def flag:string (this.tmp(kind))
    set flagTargets flag (itemAt loopLabels target)
    ; declared before the outermost loop involved: hoisted by name, the
    ; Ranger writers put a `def` where it is written, so declare it here
    ; and rely on unique names
    push pendingFlags flag
    out.line((flag + " = true"))
    out.line("break")
    set_at loopFlags (n - 1) flag
    set_at loopFlagKind (n - 1) kind
  }

  def pendingFlags:[string]

  ; ------------------------------------------------------------------- for

  ; Does `for` iterate a chain with an adaptor the plain loops do not
  ; handle (`take`, `skip`, `filter`, `map`, `zip`, …)?
  fn forNeedsChain:boolean (iter:RustNode) {
    def cur:RustNode iter
    while ((cur.kind == "method") || (cur.kind == "paren")) {
      if (cur.kind == "paren") {
        cur = (cur.kid(0))
        continue
      }
      if ((this.isIterAdapter(cur.name)) && (cur.name != "enumerate") && (cur.name != "rev") && (cur.name != "step_by")) {
        return true
      }
      ; `lines().enumerate()`, `split(…).enumerate()`: a source the plain
      ; loop reads only bare
      if ((cur.name == "enumerate") || (cur.name == "rev")) {
        def inner:RustNode (cur.kid(0))
        if ((inner.kind == "method") && ((inner.name == "lines") || (inner.name == "split") || (inner.name == "split_whitespace") || (inner.name == "char_indices"))) {
          return true
        }
      }
      cur = (cur.kid(0))
    }
    return false
  }

  def forPat@(optional):RustNode
  def forBody@(optional):RustNode

  fn lowerFor:void (e:RustNode) {
    def pat:RustNode (e.kid(0))
    def iter:RustNode (e.kid(1))
    def body:RustNode (e.kid(2))
    if (this.forNeedsChain(iter)) {
      if (e.name != "") {
        this.unsupported(e "a label on a `for` over an iterator chain")
        return
      }
      ; the chain's loop, with the body as its consumer
      def consumer:RustNode (new RustNode("method"))
      consumer.name = "__for"
      consumer.line = e.line
      consumer.col = e.col
      consumer.add(iter)
      consumer.add((new RustNode("none")))
      def savePat@(optional):RustNode forPat
      def saveBody@(optional):RustNode forBody
      forPat = pat
      forBody = body
      def r:RsExpr (this.lowerIterChain(consumer (RsType.mk("unit"))))
      this.discard(r)
      forPat = savePat
      forBody = saveBody
      return
    }
    this.pushScope()
    ; a range: lo..hi, lo..=hi, optionally .rev() / .step_by(k)
    def rev:boolean false
    def step:string "1"
    def src:RustNode iter
    while ((src.kind == "method") && ((src.name == "rev") || (src.name == "step_by"))) {
      if (src.name == "rev") {
        rev = true
      } {
        def st:RsExpr (this.lowerExpr((src.kid(2)) (RsType.mk("int"))))
        step = (this.bindTemp(st (RsType.mk("int")) "step"))
      }
      src = (src.kid(0))
    }
    if (src.kind == "paren") {
      src = (src.kid(0))
    }
    if (src.kind == "range") {
      this.lowerForRange(pat src rev step body e.name)
      this.popScope()
      return
    }
    if (rev || (step != "1")) {
      ; .rev() of a collection iterator: walk the index backwards
      this.lowerForSeq(pat src rev body e.name)
      this.popScope()
      return
    }
    this.lowerForSeq(pat iter false body e.name)
    this.popScope()
  }

  fn lowerForRange:void (pat:RustNode r:RustNode rev:boolean step:string body:RustNode label:string) {
    def lo:RustNode (r.kid(0))
    def hi:RustNode (r.kid(1))
    if (lo.isNone() || hi.isNone()) {
      this.unsupported(r "an open range in a `for`")
      return
    }
    def it:RsType (RsType.mk("int"))
    def loE:RsExpr (this.lowerExpr(lo it))
    def hiE:RsExpr (this.lowerExpr(hi it))
    def inclusive:boolean (r.name == "..=")
    def idx:string (this.tmp("i"))
    def end:string (this.tmp("end"))
    if (rev) {
      if (inclusive) {
        out.line((("def " + idx) + (":int " + hiE.code)))
      } {
        out.line((("def " + idx) + ((":int (" + hiE.code) + " - 1)")))
      }
      out.line((("def " + end) + (":int " + loE.code)))
      out.line((((("while (" + idx) + " >= ") + end) + ") {"))
    } {
      out.line((("def " + idx) + (":int " + loE.code)))
      out.line((("def " + end) + (":int " + hiE.code)))
      def op:string " < "
      if (inclusive) {
        op = " <= "
      }
      out.line((((("while (" + idx) + op) + end) + ") {"))
    }
    out.indent()
    this.bindForPattern(pat idx it)
    if (rev) {
      out.line((((idx + " = (") + idx) + (" - " + step)) + ")")
    } {
      out.line((((idx + " = (") + idx) + (" + " + step)) + ")")
    }
    this.pushLoop(label "")
    this.lowerLoopBody(body)
    out.dedent()
    out.line("}")
    this.afterLoop()
    this.popLoop()
  }

  fn bindForPattern:void (pat:RustNode code:string t:RsType) {
    if (pat.kind == "pat_wild") {
      return
    }
    if (pat.kind == "pat_ident") {
      def l:RsLocal (this.declare(pat.name t))
      out.line(((("def " + (this.declText(l.rname t))) + " ") + code))
      return
    }
    this.bindPattern(pat code t)
  }

  ; `for p in <sequence>`: a Vec / slice / array (by `&`, `.iter()`,
  ; `.iter_mut()`, `.into_iter()`), `.enumerate()` of one, `s.chars()`,
  ; `s.bytes()`, a map's `.keys()` / `.values()` / `.iter()`.
  fn lowerForSeq:void (pat:RustNode iter0:RustNode rev:boolean body:RustNode label:string) {
    def iter:RustNode iter0
    def enumerate:boolean false
    if ((iter.kind == "method") && (iter.name == "enumerate")) {
      enumerate = true
      iter = (iter.kid(0))
    }
    def mode:string "vec"
    def mutElems:boolean false
    def src:RustNode iter
    if (src.kind == "method") {
      def mn:string src.name
      if ((mn == "iter") || (mn == "into_iter")) {
        src = (src.kid(0))
      } {
        if (mn == "iter_mut") {
          src = (src.kid(0))
          mutElems = true
        } {
          if (mn == "chars") {
            src = (src.kid(0))
            mode = "chars"
          } {
            if (mn == "bytes") {
              src = (src.kid(0))
              mode = "bytes"
            } {
              if ((mn == "keys") || (mn == "values") || (mn == "values_mut")) {
                src = (src.kid(0))
                mode = mn
              } {
                if ((mn == "lines") || (mn == "split") || (mn == "split_whitespace")) {
                  mode = "vec"
                }
              }
            }
          }
        }
      }
    }
    if ((src.kind == "unary") && ((src.name == "&") || (src.name == "&mut"))) {
      if (src.name == "&mut") {
        mutElems = true
      }
      src = (src.kid(0))
    }
    def sv:RsExpr (this.lowerExpr(src (RsType.mk("unknown"))))
    def st:RsType sv.ty
    if ((mode == "vec") && ((st.kind == "map") || (st.kind == "set"))) {
      mode = "map"
    }
    if ((mode == "vec") && (st.kind == "string")) {
      this.err(iter0 "iterating a String needs `.chars()` or `.bytes()`")
      return
    }
    def seq:string ""
    def elemT:RsType (RsType.mk("unknown"))
    def elemCode:string ""
    def idx:string (this.tmp("k"))
    def n:string (this.tmp("n"))
    if (mode == "chars") {
      seq = (this.tmp("cs"))
      out.line((((("def " + seq) + ":[int] (to_chars ") + sv.code) + ")"))
      elemT = (RsType.mk("char"))
      elemCode = (((("(rs_char_from (itemAt " + seq) + " ") + idx) + "))")
    }
    if (mode == "bytes") {
      seq = (this.tmp("bs"))
      out.line((((("def " + seq) + ":charbuffer (to_charbuffer ") + sv.code) + ")"))
      elemT = (RsType.mk("int"))
      elemCode = (((("(charAt " + seq) + " ") + idx) + ")")
    }
    if (mode == "vec") {
      seq = (this.bindTemp(sv st "seq"))
      elemT = (st.arg(0))
      elemCode = (((("(itemAt " + seq) + " ") + idx) + ")")
    }
    def mapT:RsType st
    if ((mode == "map") || (mode == "keys") || (mode == "values") || (mode == "values_mut")) {
      def m:string (this.bindTemp(sv st "map"))
      seq = (this.tmp("ks"))
      out.line((((("def " + seq) + ":[") + (this.rtype((st.arg(0))))) + "] ") + (this.mapKeysCode(m st)))
      if (st.name == "sorted") {
        this.sortStrings(seq (st.arg(0)))
      }
      if ((mode == "keys") || (st.kind == "set")) {
        elemT = (st.arg(0))
        elemCode = (((("(itemAt " + seq) + " ") + idx) + ")")
      } {
        if ((mode == "values") || (mode == "values_mut")) {
          elemT = (st.arg(1))
          elemCode = (((("(unwrap (get " + (this.mapR(m st))) + " (itemAt ") + seq) + ((" " + idx) + ")))"))
        } {
          ; (k, v) pairs
          elemT = (RsType.of2("tuple" (st.arg(0)) (st.arg(1))))
          elemCode = ""
          mapT = st
          seq = (seq + "|") + (this.mapR(m st))
        }
      }
    }
    def seqName:string seq
    def mapName:string ""
    def bar:int (indexOf seq "|")
    if (bar >= 0) {
      seqName = (substring seq 0 bar)
      mapName = (substring seq (bar + 1) (strlen seq))
    }
    if (mode == "bytes") {
      out.line((((("def " + n) + ":int (length ") + seqName) + ")"))
    } {
      out.line((((("def " + n) + ":int (array_length ") + seqName) + ")"))
    }
    if (rev) {
      out.line((((("def " + idx) + ":int (") + n) + " - 1)"))
      out.line((("while (" + idx) + " >= 0) {"))
    } {
      out.line((("def " + idx) + ":int 0"))
      out.line((((("while (" + idx) + " < ") + n) + ") {"))
    }
    out.indent()
    ; the position of this iteration, saved before the index advances
    def cur:string (this.tmp("at"))
    out.line(((("def " + cur) + ":int ") + idx))
    if (mapName != "") {
      elemCode = ""
    }
    ; advance first, so `continue` in the body cannot skip it
    if (rev) {
      out.line(((idx + " = (") + idx) + " - 1)")
    } {
      out.line(((idx + " = (") + idx) + " + 1)")
    }
    def elemAt:string (this.replaceIdx(elemCode idx cur))
    if (mapName != "") {
      ; bind k and v directly for a `(k, v)` pattern
      def kc:string (((("(itemAt " + seqName) + " ") + cur) + ")")
      def vc:string (((("(unwrap (get " + mapName) + " ") + kc) + "))")
      this.bindPairPattern(pat kc (mapT.arg(0)) vc (mapT.arg(1)) enumerate cur)
    } {
      if (enumerate) {
        ; (i, x)
        if ((pat.kind == "pat_tuple") && ((array_length pat.kids) == 2)) {
          this.bindForPattern((pat.kid(0)) cur (RsType.mk("int")))
          this.bindElem((pat.kid(1)) elemAt elemT mutElems seqName cur)
        } {
          this.unsupported(pat "an `enumerate()` loop not bound as `(i, x)`")
        }
      } {
        this.bindElem(pat elemAt elemT mutElems seqName cur)
      }
    }
    def root:string (this.placePath(src))
    if ((mode != "chars") && (mode != "bytes")) {
      push iterRoots root
    } {
      push iterRoots ""
    }
    this.pushLoop(label "")
    this.lowerLoopBody(body)
    removeLast iterRoots
    out.dedent()
    out.line("}")
    this.afterLoop()
    this.popLoop()
  }

  fn replaceIdx:string (code:string from:string to:string) {
    if ((from == to) || (code == "")) {
      return code
    }
    return (join (strsplit code ((" " + from) + ")")) ((" " + to) + ")"))
  }

  fn bindElem:void (pat:RustNode code:string t:RsType mutElems:boolean seq:string cur:string) {
    if (pat.kind == "pat_wild") {
      return
    }
    if ((pat.kind == "pat_ident") && mutElems && (t.isPrim())) {
      ; `*x = v` must write back to the vector
      def l:RsLocal (this.declare(pat.name t))
      l.iterVec = seq
      l.iterIdx = cur
      out.line(((("def " + (this.declText(l.rname t))) + " ") + code))
      return
    }
    if ((pat.kind == "pat_ref") && ((array_length pat.kids) > 0)) {
      this.bindElem((pat.kid(0)) code t mutElems seq cur)
      return
    }
    this.bindForPattern(pat code t)
  }

  fn bindPairPattern:void (pat:RustNode kc:string kt:RsType vc:string vt:RsType enumerate:boolean cur:string) {
    def p:RustNode pat
    if (enumerate) {
      if ((p.kind == "pat_tuple") && ((array_length p.kids) == 2)) {
        this.bindForPattern((p.kid(0)) cur (RsType.mk("int")))
        p = (p.kid(1))
      }
    }
    if ((p.kind == "pat_tuple") && ((array_length p.kids) == 2)) {
      this.bindForPattern((this.stripRefPat((p.kid(0)))) kc kt)
      this.bindForPattern((this.stripRefPat((p.kid(1)))) vc vt)
      return
    }
    this.unsupported(pat "a map loop not bound as `(k, v)`")
  }

  fn stripRefPat:RustNode (p:RustNode) {
    if ((p.kind == "pat_ref") && ((array_length p.kids) > 0)) {
      return (p.kid(0))
    }
    return p
  }

  ; Sorts an array of numbers or strings (BTreeMap / BTreeSet iterate in key
  ; order; `v.sort()`). Ranger's `sort` answers a sorted copy, so the result
  ; is assigned back.
  fn sortStrings:void (seq:string kt:RsType) {
    def et:string (this.rtype(kt))
    out.line((((((((seq + " = (sort ") + seq) + " (fn:int (a:") + et) + " b:") + et) + ") {"))
    if ((kt.kind == "string") || (kt.kind == "char")) {
      out.line("  return (rs_str_cmp a b)")
    } {
      out.line("  if (a < b) {")
      out.line("    return -1")
      out.line("  }")
      out.line("  if (a > b) {")
      out.line("    return 1")
      out.line("  }")
      out.line("  return 0")
    }
    out.line("}))")
  }

  ; ---------------------------------------------------------------- match

  fn lowerMatch:void (e:RustNode mode:string var:string) {
    def v:RsExpr (this.lowerExpr((e.kid(0)) (RsType.mk("unknown"))))
    def subj:string (this.bindTemp(v v.ty "m"))
    def arms:[RustNode]
    def narrow:boolean false
    def i:int 1
    while (i < (array_length e.kids)) {
      def arm:RustNode (e.kid(i))
      push arms arm
      if (this.needsOpen((arm.kid(0)) v.ty)) {
        narrow = true
      }
      i = i + 1
    }
    armBefore = (this.movedSnapshot())
    def none:[RsLocal]
    armAcc = none
    armAny = false
    def saveMut:boolean matchMut
    matchMut = (this.matchesMut((e.kid(0)) v.ty))
    if (narrow) {
      this.lowerArmsOpen(arms subj v.ty mode var)
    } {
      this.lowerArms(arms 0 subj v.ty mode var e)
    }
    matchMut = saveMut
    if (armAny) {
      this.movedRestore(armAcc)
    } {
      this.movedRestore(armBefore)
    }
  }

  ; the match being lowered is on a `&mut` (matchesMut)
  def matchMut:boolean false
  ; move state across the arms of the match being lowered
  def armBefore:[RsLocal]
  def armAcc:[RsLocal]
  def armAny:boolean false

  ; Each arm starts from the state before the match; the arms that finish
  ; normally are joined.
  fn armStart:[RsLocal] () {
    def saved:[RsLocal] (this.movedSnapshot())
    this.movedRestore(armBefore)
    return saved
  }

  fn armEnd:void (body:RustNode) {
    if (false == (this.blockDiverges(body))) {
      armAcc = (this.movedUnion(armAcc (this.movedSnapshot())))
      armAny = true
    }
  }

  ; Arms that narrow: each is tried in order while no earlier one matched.
  fn lowerArmsOpen:void (arms:[RustNode] subj:string t:RsType mode:string var:string) {
    def hit:string (this.tmp("hit"))
    out.line((("def " + hit) + ":boolean false"))
    def first:boolean true
    for arms arm:RustNode i {
      def outer:int 0
      if (false == first) {
        out.line((("if (! " + hit) + ") {"))
        out.indent()
        outer = 1
      }
      first = false
      this.pushScope()
      def pat:RustNode (arm.kid(0))
      def opened:int 0
      if (pat.kind == "pat_or") {
        ; alternatives without bindings: one test
        opened = (this.patOpenOr(pat subj t))
      } {
        opened = (this.patOpenRef(pat subj t matchMut))
      }
      def guard:RustNode (arm.kid(1))
      if (false == (guard.isNone())) {
        def g:RsExpr (this.lowerCond(guard))
        out.line((("if " + (this.condText(g.code))) + " {"))
        out.indent()
        opened = opened + 1
      }
      out.line((hit + " = true"))
      def saveBefore:[RsLocal] armBefore
      this.movedRestore(armBefore)
      this.lowerValueTo((arm.kid(2)) mode var)
      this.armEnd((arm.kid(2)))
      armBefore = saveBefore
      this.closeBlocks(opened)
      this.popScope()
      this.closeBlocks(outer)
    }
  }

  fn patOpenOr:int (pat:RustNode subj:string t:RsType) {
    for pat.kids alt:RustNode i {
      if (this.patBinds(alt)) {
        this.unsupported(alt "a binding inside an `|` pattern")
      }
    }
    def cond:string (this.patCond(pat subj t))
    if (cond == "true") {
      return 0
    }
    out.line((("if " + (this.condText(cond))) + " {"))
    out.indent()
    return 1
  }

  fn lowerArms:void (arms:[RustNode] i:int subj:string t:RsType mode:string var:string at:RustNode) {
    if (i >= (array_length arms)) {
      ; no arm matched: rustc proved this cannot happen
      return
    }
    def arm:RustNode (itemAt arms i)
    def pat:RustNode (arm.kid(0))
    def guard:RustNode (arm.kid(1))
    def body:RustNode (arm.kid(2))
    ; the condition may emit temporaries: they belong to this arm's test
    this.pushScope()
    def cond:string (this.patCond(pat subj t))
    if (false == (guard.isNone())) {
      ; the guard sees the bindings as expressions over the subject
      this.aliasPattern(pat subj t)
      def g:RsExpr (this.lowerCond(guard))
      if (cond == "true") {
        cond = g.code
      } {
        cond = ((("(" + cond) + " && ") + g.code) + ")"
      }
    }
    this.popScope()
    def always:boolean (cond == "true")
    if (always) {
      this.pushScope()
      this.bindPatternRef(pat subj t matchMut)
      this.movedRestore(armBefore)
      this.lowerValueTo(body mode var)
      this.armEnd(body)
      this.popScope()
      return
    }
    out.line((("if " + (this.condText(cond))) + " {"))
    out.indent()
    this.pushScope()
    this.bindPatternRef(pat subj t matchMut)
    this.movedRestore(armBefore)
    this.lowerValueTo(body mode var)
    this.armEnd(body)
    this.popScope()
    out.dedent()
    if ((i + 1) < (array_length arms)) {
      out.line("} {")
      out.indent()
      this.lowerArms(arms (i + 1) subj t mode var at)
      out.dedent()
    }
    out.line("}")
  }

  ; ------------------------------------------------------------- patterns

  ; A Ranger boolean expression that is true when `pat` matches `subj`.
  fn patCond:string (pat:RustNode subj:string t:RsType) {
    def k:string pat.kind
    if ((k == "pat_wild") || (k == "pat_rest")) {
      return "true"
    }
    if (k == "pat_ident") {
      if ((array_length pat.kids) > 0) {
        return (this.patCond((pat.kid(0)) subj t))
      }
      ; a bare identifier naming a unit variant or constant compares
      if (this.isUnitVariantName(pat.name t)) {
        return (this.variantTest(pat.name subj t pat))
      }
      return "true"
    }
    if (k == "pat_paren") {
      return (this.patCond((pat.kid(0)) subj t))
    }
    if (k == "pat_ref") {
      return (this.patCond((pat.kid(0)) subj t))
    }
    if (k == "pat_lit") {
      def lv:RsExpr (this.lowerExpr((pat.kid(0)) t))
      return (((("(" + subj) + " == ") + lv.code) + ")")
    }
    if (k == "pat_range") {
      def conds:[string]
      def lo:RustNode (pat.kid(0))
      def hi:RustNode (pat.kid(1))
      if (false == (lo.isNone())) {
        def le:RsExpr (this.patValue(lo t))
        push conds (((("(" + subj) + " >= ") + le.code) + ")")
      }
      if (false == (hi.isNone())) {
        def he:RsExpr (this.patValue(hi t))
        def op:string " < "
        if ((pat.name == "..=") || (pat.name == "...")) {
          op = " <= "
        }
        push conds (((("(" + subj) + op) + he.code) + ")")
      }
      if ((array_length conds) == 0) {
        return "true"
      }
      return (this.andAll(conds))
    }
    if (k == "pat_or") {
      def ors:[string]
      for pat.kids alt:RustNode i {
        if (this.patBinds(alt)) {
          this.unsupported(alt "a binding inside an `|` pattern")
        }
        push ors (this.patCond(alt subj t))
      }
      def acc:string (itemAt ors 0)
      def j:int 1
      while (j < (array_length ors)) {
        acc = ((("(" + acc) + " || ") + (itemAt ors j)) + ")"
        j = j + 1
      }
      return acc
    }
    if (k == "pat_path") {
      def pn:string (this.lastSeg((pat.kid(0))))
      return (this.variantTest(pn subj t pat))
    }
    if (k == "pat_tuple_struct") {
      def pn2:string (this.lastSeg((pat.kid(0))))
      if ((pn2 == "Some") && (t.kind == "opt")) {
        def inner:string (this.patCond((pat.kid(1)) (("(unwrap " + subj) + ")") (t.arg(0))))
        if (inner == "true") {
          return (("(!null? " + subj) + ")")
        }
        return (((("((!null? " + subj) + ") && ") + inner) + ")")
      }
      return (this.structPatCond(pat subj t pn2 true))
    }
    if (k == "pat_struct") {
      def pn3:string (this.lastSeg((pat.kid(0))))
      return (this.structPatCond(pat subj t pn3 false))
    }
    if (k == "pat_tuple") {
      if (t.kind != "tuple") {
        this.unsupported(pat "a tuple pattern on a value that is not a tuple")
        return "true"
      }
      def tc:[string]
      def ti:int 0
      for pat.kids sp:RustNode tj {
        if (sp.kind == "pat_rest") {
          this.unsupported(sp "`..` in a tuple pattern")
        }
        def c:string (this.patCond(sp ((subj + ".f") + (to_string ti)) (t.arg(ti))))
        if (c != "true") {
          push tc c
        }
        ti = ti + 1
      }
      if ((array_length tc) == 0) {
        return "true"
      }
      return (this.andAll(tc))
    }
    this.unsupported(pat (("the pattern `" + k) + "`"))
    return "true"
  }

  fn patValue:RsExpr (n:RustNode t:RsType) {
    if (n.kind == "pat_lit") {
      return (this.lowerExpr((n.kid(0)) t))
    }
    if (n.kind == "pat_path") {
      def pe:RustNode (new RustNode("path_expr"))
      pe.add((n.kid(0)))
      return (this.lowerExpr(pe t))
    }
    if (n.kind == "pat_ident") {
      def pe2:RustNode (new RustNode("path_expr"))
      def p:RustNode (new RustNode("path"))
      def s:RustNode (new RustNode("seg"))
      s.name = n.name
      p.add(s)
      pe2.add(p)
      return (this.lowerExpr(pe2 t))
    }
    this.unsupported(n "this range bound")
    return (RsExpr.of("0" t))
  }

  fn lastSeg:string (p:RustNode) {
    if ((array_length p.kids) == 0) {
      return ""
    }
    def s:RustNode (itemAt p.kids ((array_length p.kids) - 1))
    return s.name
  }

  fn isUnitVariantName:boolean (n:string t:RsType) {
    if (n == "None") {
      return true
    }
    if ((t.kind == "named") && (has enums t.name)) {
      def e:RsEnum (unwrap (get enums t.name))
      return (!null? (e.variant(n)))
    }
    return false
  }

  fn variantTest:string (name:string subj:string t:RsType at:RustNode) {
    if ((name == "None") && (t.kind == "opt")) {
      return (("(null? " + subj) + ")")
    }
    if ((t.kind == "named") && (has enums t.name)) {
      def e:RsEnum (unwrap (get enums t.name))
      if (e.plain) {
        return (((((("(" + subj) + " == ") + (this.className(e.name))) + ".") + name) + ")")
      }
      return (((("(is " + subj) + " _:") + (this.caseType(e.name name))) + ")")
    }
    if ((t.kind == "named") && (has structs t.name)) {
      ; a unit struct
      return "true"
    }
    ; a constant
    def pe:RustNode (new RustNode("path_expr"))
    def p:RustNode (new RustNode("path"))
    def s:RustNode (new RustNode("seg"))
    s.name = name
    p.add(s)
    pe.add(p)
    def cv:RsExpr (this.lowerExpr(pe t))
    return (((("(" + subj) + " == ") + cv.code) + ")")
  }

  fn structPatCond:string (pat:RustNode subj:string t:RsType name:string tupleStyle:boolean) {
    if (this.isDataEnum(t)) {
      ; only reached for a variant whose fields are all wildcards
      return (this.variantTest(name subj t pat))
    }
    if ((t.kind == "named") && (has structs t.name)) {
      def s:RsStruct (unwrap (get structs t.name))
      def conds:[string]
      def i:int 1
      while (i < (array_length pat.kids)) {
        def fp:RustNode (pat.kid(i))
        def fname:string ""
        def sub:RustNode fp
        if (tupleStyle) {
          fname = ("f" + (to_string (i - 1)))
        } {
          fname = fp.name
          sub = (fp.kid(0))
        }
        def f@(optional):RsField (s.field(fname))
        if (null? f) {
          this.err(fp (("no field `" + fname) + "`"))
          return "true"
        }
        def ff:RsField (unwrap f)
        def c:string (this.patCond(sub ((subj + ".") + (this.fieldName(fname))) ff.ty))
        if (c != "true") {
          push conds c
        }
        i = i + 1
      }
      if ((array_length conds) == 0) {
        return "true"
      }
      return (this.andAll(conds))
    }
    this.unsupported(pat (("the pattern `" + name) + "(…)` (enums with data are stage R2)"))
    return "true"
  }

  fn patBinds:boolean (pat:RustNode) {
    if ((pat.kind == "pat_ident") && (false == (this.isUnitVariantName(pat.name (RsType.mk("unknown")))))) {
      return true
    }
    for pat.kids k:RustNode i {
      if ((k.kind != "path") && (this.patBinds(k))) {
        return true
      }
    }
    return false
  }

  ; Declares the variables a pattern binds, from `subj`.
  fn bindPattern:void (pat:RustNode subj:string t:RsType) {
    this.walkBindings(pat subj t false)
  }

  ; While the bindings of a pattern matched through a `&mut` are declared:
  ; Rust binds them `ref mut` (`match v { V::N(n) => *n += 1.0 }`).
  def refMutBind:boolean false
  ; a temporary holding the value of an optional place -> that place
  def backOf:[string:string]
  ; the variable of a `case` narrowing -> `Enum.Variant`
  def caseOfVar:[string:string]

  ; the function being lowered takes `&mut self`
  def selfIsMut:boolean false

  ; True when the matched expression `e` is a `&mut`: `&mut x`, a value of
  ; type `&mut T`, or `self` in a `&mut self` method.
  fn matchesMut:boolean (e:RustNode t:RsType) {
    if (t.isMutRef) {
      return true
    }
    def n:RustNode e
    while (n.kind == "paren") {
      n = (n.kid(0))
    }
    if ((n.kind == "unary") && (n.name == "&mut")) {
      return true
    }
    if ((n.kind == "path_expr") && selfIsMut) {
      def segs:[string] (this.pathSegs((n.kid(0))))
      return (((array_length segs) == 1) && ((itemAt segs 0) == "self"))
    }
    return false
  }

  ; bindPattern / patOpen for a match, `if let`, `while let` or `let`: a
  ; `&mut` subject (matchesMut) binds its parts `ref mut`.
  fn bindPatternRef:void (pat:RustNode subj:string t:RsType refMut:boolean) {
    def save:boolean refMutBind
    refMutBind = refMut
    this.walkBindings(pat subj t false)
    refMutBind = save
  }

  fn patOpenRef:int (pat:RustNode subj:string t:RsType refMut:boolean) {
    def save:boolean refMutBind
    refMutBind = refMut
    def n:int (this.patOpen(pat subj t))
    refMutBind = save
    return n
  }

  ; True when the binding `pat` refers into the matched value: `ref mut x`,
  ; or a plain `x` under a `&mut` subject (`mut x` there is a copy).
  fn bindsRefMut:boolean (pat:RustNode) {
    if (pat.hasMod("ref")) {
      return (pat.hasMod("mut"))
    }
    if (pat.hasMod("mut")) {
      return false
    }
    return refMutBind
  }

  ; The Ranger place `subj` reads, to store a changed binding back into; ""
  ; when it is not one (the whole subject: a parameter, a temporary).
  fn backPlace:string (subj:string) {
    if (has backOf subj) {
      return (unwrap (get backOf subj))
    }
    if ((startsWith subj "(unwrap ") && (endsWith subj ")")) {
      return (this.backPlace((substring subj 8 ((strlen subj) - 1))))
    }
    if (((indexOf subj "(") >= 0) || ((indexOf subj ".") < 0)) {
      return ""
    }
    return subj
  }

  ; Declares one binding of a pattern, read from `subj`. A `ref mut`
  ; binding is a copy too (numbers and strings are values on the targets),
  ; so each change to it is written back to `subj` (assignTo); a Copy
  ; struct or enum bound by value is copied.
  fn declareBinding:void (pat:RustNode subj:string t:RsType) {
    def l:RsLocal (this.declare(pat.name t))
    def code:string subj
    if (this.bindsRefMut(pat)) {
      def place:string (this.backPlace(subj))
      if (place == "") {
        l.backBad = true
      } {
        l.backTo = place
        def root:string place
        def dot:int (indexOf place ".")
        if (dot > 0) {
          root = (substring place 0 dot)
        }
        if (has caseOfVar root) {
          l.backCase = (unwrap (get caseOfVar root))
        }
      }
    } {
      code = (this.copyCode(subj t))
    }
    out.line(((("def " + (this.declText(l.rname t))) + " ") + code))
  }

  ; `code` copied when `t` is a Copy struct or a Copy enum with data (they
  ; are objects on the targets, which a copy would share).
  fn copyCode:string (code:string t:RsType) {
    if (this.isCopyStruct(t)) {
      return (("(" + code) + ".rs_clone())")
    }
    if (this.isCopyEnum(t)) {
      return (this.cloneCode(code t))
    }
    return code
  }

  fn noteWrittenCase:void (l:RsLocal) {
    if (l.backCase != "") {
      set writtenCases l.backCase true
    }
  }

  fn isCopyEnum:boolean (t:RsType) {
    if (this.isDataEnum(t)) {
      def e:RsEnum (unwrap (get enums t.name))
      return ((indexOf e.derives "Copy") >= 0)
    }
    return false
  }

  ; Makes a pattern's names refer to the subject expressions, for a guard.
  fn aliasPattern:void (pat:RustNode subj:string t:RsType) {
    this.walkBindings(pat subj t true)
  }

  fn walkBindings:void (pat:RustNode subj:string t:RsType aliasOnly:boolean) {
    def k:string pat.kind
    if (k == "pat_ident") {
      if (this.isUnitVariantName(pat.name t)) {
        return
      }
      if (aliasOnly) {
        this.alias(pat.name subj t)
      } {
        this.declareBinding(pat subj t)
      }
      if ((array_length pat.kids) > 0) {
        this.walkBindings((pat.kid(0)) subj t aliasOnly)
      }
      return
    }
    if ((k == "pat_paren") || (k == "pat_ref") || (k == "pat_box")) {
      this.walkBindings((pat.kid(0)) subj t aliasOnly)
      return
    }
    if (k == "pat_tuple_struct") {
      def pn:string (this.lastSeg((pat.kid(0))))
      if ((pn == "Some") && (t.kind == "opt")) {
        this.walkBindings((pat.kid(1)) (("(unwrap " + subj) + ")") (t.arg(0)) aliasOnly)
        return
      }
      if ((t.kind == "named") && (has structs t.name)) {
        def s:RsStruct (unwrap (get structs t.name))
        def i:int 1
        while (i < (array_length pat.kids)) {
          def fname:string ("f" + (to_string (i - 1)))
          def f@(optional):RsField (s.field(fname))
          if (!null? f) {
            def ff:RsField (unwrap f)
            this.walkBindings((pat.kid(i)) ((subj + ".") + fname) ff.ty aliasOnly)
          }
          i = i + 1
        }
      }
      return
    }
    if (k == "pat_struct") {
      if ((t.kind == "named") && (has structs t.name)) {
        def s2:RsStruct (unwrap (get structs t.name))
        def j:int 1
        while (j < (array_length pat.kids)) {
          def fp:RustNode (pat.kid(j))
          def f2@(optional):RsField (s2.field(fp.name))
          if (!null? f2) {
            def ff2:RsField (unwrap f2)
            this.walkBindings((fp.kid(0)) ((subj + ".") + (this.fieldName(fp.name))) ff2.ty aliasOnly)
          }
          j = j + 1
        }
      }
      return
    }
    if (k == "pat_tuple") {
      def ti:int 0
      for pat.kids sp:RustNode tj {
        this.walkBindings(sp ((subj + ".f") + (to_string ti)) (t.arg(ti)) aliasOnly)
        ti = ti + 1
      }
      return
    }
  }

  ; ---------------------------------------------------------- temporaries

  ; `code` as a name that is safe to repeat: itself when simple, else a
  ; temporary holding it.
  fn bindTemp:string (v:RsExpr t:RsType base:string) {
    if (v.simple) {
      return v.code
    }
    def name:string (this.tmp(base))
    out.line(((("def " + (this.declText(name t))) + " ") + v.code))
    return name
  }

  ; A temporary to receive the value of a branchy expression.
  fn valueTemp:string (t:RsType) {
    def name:string (this.tmp("v"))
    set tempTypes name t
    out.line(("def " + (this.fieldDecl(name t))))
    return name
  }

  ; A value of an enum-with-data or trait-object type is first held in a
  ; non-optional variable of that type before it is stored in an optional:
  ; Go stores a case into an optional union without wrapping it, and the
  ; unwrap then panics (ISSUES.md #102).
  fn unionSafe:string (code:string t:RsType) {
    def isUnion:boolean (this.isDataEnum(t))
    if ((t.kind == "named") && t.isDyn && (has traits t.name)) {
      isUnion = true
    }
    if (false == isUnion) {
      return code
    }
    def n:string (this.tmp("u"))
    out.line(((("def " + (this.declText(n t))) + " ") + code))
    return n
  }

  ; Makes `v` fit where a `t` is expected: an optional from a plain value
  ; (`Some(x)` and a value passed where Option is wanted), `None`.
  fn coerce:RsExpr (v:RsExpr t:RsType at:RustNode) {
    if ((t.kind == "opt") && (v.ty.kind != "opt")) {
      def name:string (this.tmp("o"))
      def safe:string v.code
      if (v.ty.kind != "none") {
        safe = (this.unionSafe(v.code (t.arg(0))))
      }
      out.line(("def " + (this.declText(name t))))
      if (v.ty.kind != "none") {
        out.line(((name + " = ") + safe))
      }
      def r:RsExpr (RsExpr.of(name t))
      r.simple = true
      return r
    }
    if (v.ty.kind == "none") {
      this.err(at "`None` where the type is not known to be an Option")
    }
    return v
  }

  ; lowerExpr, then copy a Copy struct read from a place (Rust copies it;
  ; Ranger would share it).
  fn lowerExprCopy:RsExpr (n:RustNode expect:RsType) {
    def v:RsExpr (this.lowerExpr(n expect))
    if (false == expect.isRef) {
      this.noteMove(n v.ty)
    }
    if ((this.isCopyStruct(v.ty)) && (this.isPlace(n))) {
      def r:RsExpr (RsExpr.of((("(" + (this.bindTemp(v v.ty "c"))) + ".rs_clone())") v.ty))
      return r
    }
    if ((this.isCopyEnum(v.ty)) && (this.isPlace(n))) {
      return (RsExpr.of((this.cloneCode((this.bindTemp(v v.ty "c")) v.ty)) v.ty))
    }
    return v
  }

  fn isPlace:boolean (n:RustNode) {
    def k:string n.kind
    if ((k == "path_expr") || (k == "field") || (k == "index")) {
      return true
    }
    if ((k == "unary") && (n.name == "*")) {
      return true
    }
    if (k == "paren") {
      return (this.isPlace((n.kid(0))))
    }
    return false
  }

  ; ------------------------------------------------------------ expressions

  fn unit:RsExpr () {
    return (RsExpr.of("" (RsType.mk("unit"))))
  }

  fn lowerExpr:RsExpr (n:RustNode expect:RsType) {
    def k:string n.kind
    if (k == "lit") {
      return (this.lowerLit(n expect))
    }
    if (k == "path_expr") {
      return (this.lowerPathExpr(n expect))
    }
    if (k == "paren") {
      def inner:RsExpr (this.lowerExpr((n.kid(0)) expect))
      return inner
    }
    if (k == "bin") {
      return (this.lowerBin(n expect))
    }
    if (k == "unary") {
      return (this.lowerUnary(n expect))
    }
    if (k == "cast") {
      return (this.lowerCast(n))
    }
    if (k == "call") {
      return (this.lowerCall(n expect))
    }
    if (k == "method") {
      return (this.lowerMethod(n expect))
    }
    if (k == "field") {
      return (this.lowerField(n))
    }
    if (k == "index") {
      return (this.lowerIndex(n))
    }
    if (k == "tuple") {
      return (this.lowerTuple(n expect))
    }
    if ((k == "array") || (k == "array_repeat")) {
      return (this.lowerArray(n expect))
    }
    if (k == "struct_lit") {
      return (this.lowerStructLit(n))
    }
    if (k == "macro_call") {
      return (this.lowerMacroExpr(n expect))
    }
    if (k == "closure") {
      return (this.lowerClosure(n expect))
    }
    if ((k == "if") || (k == "match") || (k == "block") || (k == "loop")) {
      return (this.lowerValueExpr(n expect))
    }
    if ((k == "return") || (k == "break") || (k == "continue") || (k == "assign") || (k == "while") || (k == "for")) {
      this.lowerStmtExpr(n)
      if ((k == "assign") || (k == "while") || (k == "for")) {
        return (this.unit())
      }
      return (RsExpr.of("" (RsType.mk("never"))))
    }
    if (k == "try") {
      return (this.lowerTry(n expect))
    }
    if (k == "underscore") {
      this.unsupported(n "`_` as an expression")
      return (this.unit())
    }
    this.unsupported(n (("the expression `" + k) + "`"))
    return (this.unit())
  }

  ; An `if` / `match` / block / `loop` used as a value: its arms assign a
  ; temporary, declared once the first arm has shown the type.
  fn lowerValueExpr:RsExpr (n:RustNode expect:RsType) {
    def name:string (this.tmp("v"))
    set tempTypes name expect
    def save:RustOut out
    out = (new RustOut())
    out.ind = save.ind
    if (n.kind == "block") {
      if ((array_length n.mods) > 0) {
        this.unsupported(n (("a `" + (join n.mods " ")) + "` block"))
      }
      this.lowerBlockValue(n "assign" name)
    } {
      if (n.kind == "loop") {
        this.lowerLoop(n name)
      } {
        this.lowerBranchy(n "assign" name)
      }
    }
    def body:[string] out.lines
    out = save
    def t:RsType (this.varType(name))
    if (t.kind == "none") {
      t = (RsType.mk("unknown"))
    }
    if (t.isUnknown()) {
      this.err(n "the type of this expression is not known: add a type annotation")
    }
    out.line(("def " + (this.tempDecl(name t))))
    out.addAll(body)
    def r:RsExpr (RsExpr.of(name t))
    r.simple = true
    return r
  }

  ; ---------------------------------------------------------------- literals

  fn strLit:string (s:string) {
    def out:string (join (strsplit s "\\") "\\\\")
    out = (join (strsplit out "\"") "\\\"")
    out = (join (strsplit out "\n") "\\n")
    out = (join (strsplit out "\t") "\\t")
    out = (join (strsplit out (strfromcode 13)) "\\r")
    return (("\"" + out) + "\"")
  }

  fn intValue:int (n:RustNode) {
    def v:string n.value
    def base:int 10
    def start:int 0
    if ((strlen v) > 2) {
      def pre:string (substring v 0 2)
      if ((pre == "0x") || (pre == "0X")) {
        base = 16
        start = 2
      }
      if ((pre == "0o") || (pre == "0O")) {
        base = 8
        start = 2
      }
      if ((pre == "0b") || (pre == "0B")) {
        base = 2
        start = 2
      }
    }
    def acc:int 0
    def cs:[int] (to_chars v)
    def i:int start
    while (i < (array_length cs)) {
      def c:int (itemAt cs i)
      def d:int -1
      if ((c >= 48) && (c <= 57)) {
        d = c - 48
      }
      if ((c >= 97) && (c <= 102)) {
        d = c - 87
      }
      if ((c >= 65) && (c <= 70)) {
        d = c - 55
      }
      if (d >= 0) {
        acc = (acc * base) + d
      }
      i = i + 1
    }
    return acc
  }

  ; A float literal as plain decimal digits: Ranger has no exponent form.
  fn floatText:string (v:string) {
    def s:string (to_lowercase v)
    def e:int (indexOf s "e")
    if (e < 0) {
      if ((indexOf s ".") < 0) {
        return (s + ".0")
      }
      if ((substring s ((strlen s) - 1) (strlen s)) == ".") {
        return (s + "0")
      }
      return s
    }
    def mant:string (substring s 0 e)
    def expS:string (substring s (e + 1) (strlen s))
    def ex:int 0
    def neg:boolean false
    def cs:[int] (to_chars expS)
    for cs c:int i {
      if (c == 45) {
        neg = true
      }
      if ((c >= 48) && (c <= 57)) {
        ex = (ex * 10) + (c - 48)
      }
    }
    if (neg) {
      ex = 0 - ex
    }
    def dot:int (indexOf mant ".")
    def digits:string (join (strsplit mant ".") "")
    def intLen:int 0
    if (dot < 0) {
      intLen = (strlen mant) + ex
    } {
      intLen = dot + ex
    }
    def outS:string ""
    if (intLen <= 0) {
      def zeros:string ""
      def z:int 0
      while (z < (0 - intLen)) {
        zeros = zeros + "0"
        z = z + 1
      }
      outS = ("0." + zeros) + digits
    } {
      if (intLen >= (strlen digits)) {
        def pad:string ""
        def z2:int 0
        while (z2 < (intLen - (strlen digits))) {
          pad = pad + "0"
          z2 = z2 + 1
        }
        outS = (digits + pad) + ".0"
      } {
        outS = ((substring digits 0 intLen) + ".") + (substring digits intLen (strlen digits))
      }
    }
    return outS
  }

  fn lowerLit:RsExpr (n:RustNode expect:RsType) {
    if (n.hasMod("bool")) {
      return (RsExpr.of(n.value (RsType.mk("bool"))))
    }
    if (n.hasMod("str")) {
      def litT:RsType (RsType.mk("string"))
      litT.isRef = true
      def r:RsExpr (RsExpr.of((this.strLit(n.value)) litT))
      r.simple = true
      return r
    }
    if (n.hasMod("char")) {
      def rc:RsExpr (RsExpr.of((this.strLit(n.value)) (RsType.mk("char"))))
      rc.simple = true
      return rc
    }
    if (n.hasMod("byte")) {
      def cs:[int] (to_chars n.value)
      def code:int 0
      if ((array_length cs) > 0) {
        code = (itemAt cs 0)
      }
      def rb:RsExpr (RsExpr.of((to_string code) (RsType.mk("int"))))
      rb.simple = true
      return rb
    }
    if (n.hasMod("float") || (n.hasMod("f64")) || (n.hasMod("f32")) || (expect.kind == "double")) {
      def txt:string n.value
      if (n.hasMod("int")) {
        txt = (to_string (this.intValue(n)))
      }
      def rf:RsExpr (RsExpr.of((this.floatText(txt)) (RsType.mk("double"))))
      rf.simple = true
      return rf
    }
    if (n.hasMod("int")) {
      def ri:RsExpr (RsExpr.of((to_string (this.intValue(n))) (RsType.mk("int"))))
      ri.simple = true
      return ri
    }
    this.unsupported(n "this literal (byte and C strings)")
    return (this.unit())
  }

  ; ------------------------------------------------------------------ paths

  fn pathSegs:[string] (p:RustNode) {
    def list:[string]
    for p.kids s:RustNode i {
      push list s.name
    }
    ; a variant brought in by `use Enum::*` and not hidden by a local
    if ((array_length list) == 1) {
      def only:string (itemAt list 0)
      if ((has variantAliases only) && (null? (scope.lookup(only)))) {
        def full:[string]
        push full (unwrap (get variantAliases only))
        push full only
        return full
      }
    }
    return list
  }

  def variantAliases:[string:string]
  def optInCollectionReported:boolean false

  ; The enum a `use` path names, "" when it names something else.
  fn useEnum:string (path:string) {
    def segs:[string] (strsplit path "::")
    def keep:[string]
    for segs sg:string i {
      if ((sg != "") && (sg != "self") && (sg != "crate") && (sg != "super")) {
        push keep sg
      }
    }
    if ((array_length keep) != 1) {
      return ""
    }
    def e:string (itemAt keep 0)
    if (has enums e) {
      return e
    }
    return ""
  }

  fn collectUse:void (u:RustNode) {
    this.useItems("" u)
    if (u.kind == "use_glob") {
      def eg:string (this.useEnum(u.name))
      if (eg != "") {
        def en:RsEnum (unwrap (get enums eg))
        for en.variants v:RsVariant vi {
          set variantAliases v.name eg
        }
      }
      return
    }
    if (u.kind == "use_group") {
      def eg2:string (this.useEnum(u.name))
      for u.kids c:RustNode ci {
        if ((eg2 != "") && (c.kind == "use_name")) {
          if ((c.value != "") && (c.value != c.name)) {
            this.err(c "a renamed enum variant import is not in the subset")
          }
          set variantAliases c.name eg2
        }
        if ((eg2 != "") && (c.kind == "use_glob")) {
          def en2:RsEnum (unwrap (get enums eg2))
          for en2.variants v2:RsVariant vi2 {
            set variantAliases v2.name eg2
          }
        }
      }
      return
    }
    if (u.kind == "use_name") {
      def cut:int (lastIndexOf u.name "::")
      if (cut > 0) {
        def eg3:string (this.useEnum((substring u.name 0 cut)))
        if (eg3 != "") {
          set variantAliases (substring u.name (cut + 2) (strlen u.name)) eg3
        }
      }
    }
  }

  ; `use geometry::area;`, `use crate::util::{f, g as h};`,
  ; `use geometry::*;`: module-level functions and consts named bare in the
  ; current module (R6).
  fn useItems:void (prefix:string u:RustNode) {
    if (u.kind == "use_name") {
      def full:string (this.fnKey(prefix u.name))
      def segs:[string] (strsplit full "::")
      def local:string (itemAt segs ((array_length segs) - 1))
      if ((u.value != "") && (u.value != "_")) {
        local = u.value
      }
      def key:string (this.resolveItem(segs "fn"))
      if (key == "") {
        key = (this.resolveItem(segs "const"))
      }
      if (key != "") {
        set fnAlias ((curMod + "|") + local) key
      }
      return
    }
    if (u.kind == "use_group") {
      for u.kids c:RustNode ci {
        this.useItems((this.fnKey(prefix u.name)) c)
      }
      return
    }
    if (u.kind == "use_glob") {
      def gsegs:[string] (strsplit (this.fnKey(prefix u.name)) "::")
      push gsegs "*"
      def m:string (this.modPath(gsegs curMod))
      if (m == "?") {
        m = (this.modPath(gsegs ""))
      }
      if ((m == "?") || (m == curMod)) {
        return
      }
      for fnOrder fk:string fi {
        def f:RsFn (unwrap (get fns fk))
        if (f.modKey == m) {
          set fnAlias ((curMod + "|") + f.name) fk
        }
      }
      for constOrder ck:string ci2 {
        def c:RsConst (unwrap (get consts ck))
        if (c.modKey == m) {
          set fnAlias ((curMod + "|") + c.name) ck
        }
      }
    }
  }

  fn lowerPathExpr:RsExpr (n:RustNode expect:RsType) {
    def p:RustNode (n.kid(0))
    if (p.kind != "path") {
      this.unsupported(n "a qualified path expression")
      return (this.unit())
    }
    def segs:[string] (this.pathSegs(p))
    def ns:int (array_length segs)
    if (ns == 1) {
      def name:string (itemAt segs 0)
      def l@(optional):RsLocal (scope.lookup(name))
      if (!null? l) {
        def lv:RsLocal (unwrap l)
        if (lv.moved && (false == noMoveCheck)) {
          this.err(n (((("use of moved value: `" + name) + "` (moved at line ") + (to_string lv.movedLine)) + ")"))
          ; report once
          lv.moved = false
        }
        def r:RsExpr (RsExpr.of(lv.rname lv.ty))
        r.simple = true
        return r
      }
      if (name == "None") {
        return (RsExpr.of("" (RsType.mk("none"))))
      }
      def ck1:string (this.resolveItem(segs "const"))
      if (ck1 != "") {
        return (this.constValue(ck1))
      }
      if (has structs name) {
        def s:RsStruct (unwrap (get structs name))
        if (((array_length s.fields) == 0) && (false == s.isTuple)) {
          return (RsExpr.of((("(new " + (this.className(name))) + ")") (RsType.named(name))))
        }
      }
      def fk1:string (this.resolveItem(segs "fn"))
      if (fk1 != "") {
        return (this.fnValue(fk1 n))
      }
      this.err(n (("unknown name `" + name) + "`"))
      return (this.unit())
    }
    ; `geometry::ORIGIN`, `crate::util::area` (R6)
    def ck2:string (this.resolveItem(segs "const"))
    if (ck2 != "") {
      return (this.constValue(ck2))
    }
    def fk2:string (this.resolveItem(segs "fn"))
    if (fk2 != "") {
      return (this.fnValue(fk2 n))
    }
    def full:string (join segs "::")
    def last:string (itemAt segs (ns - 1))
    def head:string (itemAt segs (ns - 2))
    if (head == "Self") {
      head = selfType
    }
    if ((has enums head)) {
      def e:RsEnum (unwrap (get enums head))
      if (e.plain) {
        if (null? (e.variant(last))) {
          this.err(n (((("no variant `" + last) + "` in `") + head) + "`"))
        }
        def ev:RsExpr (RsExpr.of((((this.className(head)) + ".") + last) (RsType.named(head))))
        ev.simple = true
        return ev
      }
      def dv@(optional):RsVariant (e.variant(last))
      if (null? dv) {
        this.err(n (((("no variant `" + last) + "` in `") + head) + "`"))
        return (this.unit())
      }
      def dvv:RsVariant (unwrap dv)
      if ((array_length dvv.fields) > 0) {
        return (this.variantCtorValue(e dvv n))
      }
      return (RsExpr.of((("(new " + (this.caseType(head last))) + "())") (RsType.named(head))))
    }
    def konst:string (this.stdConst(full))
    if (konst != "") {
      def kt:RsType (RsType.mk("int"))
      if ((indexOf full "f64") >= 0) {
        kt = (RsType.mk("double"))
      }
      if ((indexOf full "f32") >= 0) {
        kt = (RsType.mk("double"))
      }
      def kr:RsExpr (RsExpr.of(konst kt))
      kr.simple = true
      return kr
    }
    this.unsupported(n (("the path `" + full) + "`"))
    return (this.unit())
  }

  fn stdConst:string (full:string) {
    def f:string full
    if ((indexOf f "std::") == 0) {
      f = (substring f 5 (strlen f))
    }
    if ((indexOf f "core::") == 0) {
      f = (substring f 6 (strlen f))
    }
    if ((f == "Ordering::Less") || (f == "cmp::Ordering::Less")) {
      return "-1"
    }
    if ((f == "Ordering::Equal") || (f == "cmp::Ordering::Equal")) {
      return "0"
    }
    if ((f == "Ordering::Greater") || (f == "cmp::Ordering::Greater")) {
      return "1"
    }
    if ((f == "f64::consts::PI") || (f == "f32::consts::PI")) {
      return "3.141592653589793"
    }
    if ((f == "f64::consts::E") || (f == "f32::consts::E")) {
      return "2.718281828459045"
    }
    if (f == "f64::consts::TAU") {
      return "6.283185307179586"
    }
    if ((f == "i64::MAX") || (f == "isize::MAX")) {
      return "9223372036854775807"
    }
    if ((f == "i64::MIN") || (f == "isize::MIN")) {
      return "(0 - 9223372036854775807 - 1)"
    }
    if (f == "i32::MAX") {
      return "2147483647"
    }
    if (f == "i32::MIN") {
      return "-2147483648"
    }
    if (f == "u8::MAX") {
      return "255"
    }
    if (f == "u32::MAX") {
      return "4294967295"
    }
    if ((f == "usize::MAX") || (f == "u64::MAX")) {
      return "9223372036854775807"
    }
    if (f == "f64::MAX") {
      return ".0"
    }
    if (f == "f64::EPSILON") {
      return "0.0000000000000002220446049250313"
    }
    return ""
  }

  fn constValue:RsExpr (key:string) {
    def c:RsConst (unwrap (get consts key))
    return (RsExpr.of((((("(" + c.modCls) + ".") + (this.staticName(c.name))) + "())") c.ty))
  }

  ; A free function used as a value: a lambda that calls it.
  fn fnValue:RsExpr (name:string at:RustNode) {
    def f:RsFn (unwrap (get fns name))
    def ps:[string]
    def as:[string]
    def i:int 0
    def ft:RsType (RsType.mk("fn"))
    for f.params p:RsParam j {
      def pn:string ("p" + (to_string i))
      push ps (this.declText(pn p.ty))
      push as pn
      push ft.args p.ty
      i = i + 1
    }
    push ft.args f.ret
    def call:string (((((f.modCls + ".") + f.rname) + "(") + (join as " ")) + ")")
    def body:string ("return " + call)
    if (f.ret.kind == "unit") {
      body = call
    }
    def code:string (((((("(fn:" + (this.rtype(f.ret))) + " (") + (join ps " ")) + ") {\n") + (out.ind + "  ")) + ((body + "\n") + (out.ind + "})")))
    return (RsExpr.of(code ft))
  }

  ; ------------------------------------------------------------- operators

  fn lowerBin:RsExpr (n:RustNode expect:RsType) {
    def op:string n.name
    if ((op == "&&") || (op == "||")) {
      return (this.lowerLogic(n))
    }
    def isCmp:boolean ((op == "==") || (op == "!=") || (op == "<") || (op == ">") || (op == "<=") || (op == ">="))
    def ex:RsType expect
    if (isCmp) {
      ex = (RsType.mk("unknown"))
    }
    def ln:RustNode (n.kid(0))
    def rn:RustNode (n.kid(1))
    def l:RsExpr (this.lowerExpr(ln ex))
    def rex:RsType ex
    if (rex.isUnknown()) {
      rex = l.ty
    }
    def r:RsExpr (this.lowerExpr(rn rex))
    if (l.ty.isUnknown() && (false == r.ty.isUnknown())) {
      ; a literal on the left typed by the right: re-lower it
      if (ln.kind == "lit") {
        l = (this.lowerExpr(ln r.ty))
      }
    }
    def t:RsType l.ty
    if (t.isUnknown() || (t.kind == "none")) {
      t = r.ty
    }
    if (isCmp) {
      return (RsExpr.of((this.compare(op l r t n)) (RsType.mk("bool"))))
    }
    if ((t.kind == "named") && (has structs t.name)) {
      return (this.operatorMethod(op l r t n))
    }
    def code:string ""
    if (op == "/") {
      if (t.kind == "double") {
        code = (((("(" + l.code) + " / ") + r.code) + ")")
      } {
        code = (((("(rs_div " + l.code) + " ") + r.code) + ")")
      }
    }
    if (op == "%") {
      code = (((("(rs_rem " + l.code) + " ") + r.code) + ")")
    }
    if ((op == "+") || (op == "-") || (op == "*")) {
      code = (((((("(" + l.code) + " ") + op) + " ") + r.code) + ")")
    }
    if ((op == "&") || (op == "|") || (op == "^")) {
      if (t.kind == "bool") {
        if (op == "&") {
          code = (((("(" + l.code) + " && ") + r.code) + ")")
        }
        if (op == "|") {
          code = (((("(" + l.code) + " || ") + r.code) + ")")
        }
        if (op == "^") {
          code = (((("(" + l.code) + " != ") + r.code) + ")")
        }
      } {
        def fname:string "bit_and"
        if (op == "|") {
          fname = "bit_or"
        }
        if (op == "^") {
          fname = "bit_xor"
        }
        code = (((((("(" + fname) + " ") + l.code) + " ") + r.code) + ")")
      }
    }
    if (op == "<<") {
      code = (((("(bit_shl " + l.code) + " ") + r.code) + ")")
    }
    if (op == ">>") {
      code = (((("(bit_shr " + l.code) + " ") + r.code) + ")")
    }
    if (code == "") {
      this.unsupported(n (("the operator `" + op) + "`"))
    }
    if ((indexOf code "(bit_") == 0) {
      ; a macro operator would print its argument back as C-style infix
      ; (`a & b`), which Ranger does not read: keep bit results in a name
      def bn:string (this.tmp("bits"))
      out.line(((("def " + bn) + ":int ") + code))
      def br:RsExpr (RsExpr.of(bn t))
      br.simple = true
      return br
    }
    if (t.kind == "char") {
      t = (RsType.mk("string"))
    }
    return (RsExpr.of(code t))
  }

  ; `a + b` on a struct that implements std::ops::Add and friends.
  fn operatorMethod:RsExpr (op:string l:RsExpr r:RsExpr t:RsType at:RustNode) {
    def mn:string ""
    if (op == "+") {
      mn = "add"
    }
    if (op == "-") {
      mn = "sub"
    }
    if (op == "*") {
      mn = "mul"
    }
    if (op == "/") {
      mn = "div"
    }
    if (op == "%") {
      mn = "rem"
    }
    def s:RsStruct (unwrap (get structs t.name))
    def m@(optional):RsFn (s.method(mn))
    if ((mn == "") || (null? m)) {
      this.err(at (((("`" + op) + "` on `") + t.name) + "` needs an impl of the operator trait"))
      return (this.unit())
    }
    def mf:RsFn (unwrap m)
    def recv:string (this.bindTemp(l t "l"))
    return (RsExpr.of((((((("(" + recv) + ".") + mf.rname) + "(") + r.code) + "))") mf.ret))
  }

  fn compare:string (op:string l:RsExpr r:RsExpr t:RsType at:RustNode) {
    ; x == None / x != None
    if ((l.ty.kind == "none") || (r.ty.kind == "none")) {
      def other:string l.code
      if (l.ty.kind == "none") {
        other = r.code
      }
      if (op == "==") {
        return (("(null? " + other) + ")")
      }
      return (("(!null? " + other) + ")")
    }
    if (this.isDataEnum(t)) {
      if ((op == "==") || (op == "!=")) {
        def eqc:string (this.eqCode(l.code r.code t))
        if (op == "==") {
          return eqc
        }
        return (("(! " + eqc) + ")")
      }
    }
    if ((t.kind == "named") && (has structs t.name)) {
      if ((op == "==") || (op == "!=")) {
        def recv:string (this.bindTemp(l t "l"))
        def eq:string (((("(" + recv) + ".rs_eq(") + r.code) + "))")
        if (op == "==") {
          return eq
        }
        return (("(! " + eq) + ")")
      }
      def lrecv:string (this.bindTemp(l t "l"))
      def sc:string (this.structCmp(lrecv r.code t))
      if (sc == "") {
        this.err(at (("`" + t.name) + "` is not ordered: derive PartialOrd or implement it"))
        return "false"
      }
      return (((("(" + sc) + " ") + op) + " 0)")
    }
    if (t.kind == "opt") {
      if ((op == "==") || (op == "!=")) {
        ; both optional, or one a plain value to compare with Some(v)
        def lc:string (this.bindTemp(l l.ty "l"))
        def rc:string (this.bindTemp(r r.ty "r"))
        def both:string ""
        if ((l.ty.kind == "opt") && (r.ty.kind == "opt")) {
          both = (((((((((("(((null? " + lc) + ") && (null? ") + rc) + ")) || ((!null? ") + lc) + ") && ((!null? ") + rc) + ") && ((unwrap ") + lc) + ((") == (unwrap " + rc) + ")))))"))
        } {
          this.unsupported(at "comparing an Option with a plain value")
          return "false"
        }
        if (op == "==") {
          return both
        }
        return (("(! " + both) + ")")
      }
    }
    if (op == "!=") {
      return (((("(" + l.code) + " != ") + r.code) + ")")
    }
    if (((t.kind == "string") || (t.kind == "char")) && (op != "==")) {
      return (((((("((rs_str_cmp " + l.code) + " ") + r.code) + ") ") + op) + " 0)")
    }
    return (((((("(" + l.code) + " ") + op) + " ") + r.code) + ")")
  }

  ; `&&` / `||`: the right side runs only when needed, including anything it
  ; had to emit ahead of itself.
  fn lowerLogic:RsExpr (n:RustNode) {
    def l:RsExpr (this.lowerExpr((n.kid(0)) (RsType.mk("bool"))))
    def save:RustOut out
    out = (new RustOut())
    out.ind = save.ind
    out.indent()
    def r:RsExpr (this.lowerExpr((n.kid(1)) (RsType.mk("bool"))))
    def pre:[string] out.lines
    out = save
    if ((array_length pre) == 0) {
      return (RsExpr.of((((((("(" + l.code) + " ") + n.name) + " ") + r.code) + ")") (RsType.mk("bool"))))
    }
    def t:string (this.tmp("b"))
    out.line(((("def " + t) + ":boolean ") + l.code))
    if (n.name == "&&") {
      out.line((("if " + t) + " {"))
    } {
      out.line((("if (! " + t) + ") {"))
    }
    out.addAll(pre)
    out.line((("  " + t) + (" = " + r.code)))
    out.line("}")
    def res:RsExpr (RsExpr.of(t (RsType.mk("bool"))))
    res.simple = true
    return res
  }

  fn lowerUnary:RsExpr (n:RustNode expect:RsType) {
    def op:string n.name
    def c:RustNode (n.kid(0))
    if ((op == "&") || (op == "&mut") || (op == "*")) {
      def v:RsExpr (this.lowerExpr(c expect))
      return v
    }
    if (op == "-") {
      if (c.kind == "lit") {
        def lv:RsExpr (this.lowerExpr(c expect))
        def neg:RsExpr (RsExpr.of(("-" + lv.code) lv.ty))
        neg.simple = true
        return neg
      }
      def v2:RsExpr (this.lowerExpr(c expect))
      if (v2.ty.kind == "int") {
        return (RsExpr.of((("(0 - " + v2.code) + ")") v2.ty))
      }
      if (v2.ty.kind == "double") {
        return (RsExpr.of((("(0.0 - " + v2.code) + ")") v2.ty))
      }
      if ((v2.ty.kind == "named") && (has structs v2.ty.name)) {
        def s:RsStruct (unwrap (get structs v2.ty.name))
        def m@(optional):RsFn (s.method("neg"))
        if (!null? m) {
          def recv:string (this.bindTemp(v2 v2.ty "n"))
          return (RsExpr.of((("(" + recv) + ".neg())") v2.ty))
        }
      }
      return (RsExpr.of((("(rs_neg " + v2.code) + ")") v2.ty))
    }
    if (op == "!") {
      def v3:RsExpr (this.lowerExpr(c expect))
      if (v3.ty.kind == "int") {
        return (RsExpr.of((("(bit_not " + v3.code) + ")") v3.ty))
      }
      return (RsExpr.of((("(! " + v3.code) + ")") (RsType.mk("bool"))))
    }
    this.unsupported(n (("the unary operator `" + op) + "`"))
    return (this.unit())
  }

  fn lowerCast:RsExpr (n:RustNode) {
    def target:RsType (this.typeOf((n.kid(1))))
    def v:RsExpr (this.lowerExpr((n.kid(0)) (RsType.mk("unknown"))))
    def s:string v.ty.kind
    def tk:string target.kind
    if (tk == "int") {
      if (s == "double") {
        return (RsExpr.of((("(rs_f2i " + v.code) + ")") target))
      }
      if (s == "char") {
        return (RsExpr.of((("(rs_char_code " + v.code) + ")") target))
      }
      if (s == "bool") {
        return (RsExpr.of((("(? " + v.code) + " 1 0)") target))
      }
      if ((s == "named") && (has enums v.ty.name)) {
        return (RsExpr.of((this.enumDisc(v.code v.ty.name)) target))
      }
      if ((target.name == "u8") || (target.name == "i8") || (target.name == "u16") || (target.name == "i16")) {
        def mask:string "255"
        if ((target.name == "u16") || (target.name == "i16")) {
          mask = "65535"
        }
        def wn:string (this.tmp("w"))
        out.line((((("def " + wn) + ":int (bit_and ") + v.code) + (" " + mask)) + ")")
        def wr:RsExpr (RsExpr.of(wn target))
        wr.simple = true
        return wr
      }
      return (RsExpr.of(v.code target))
    }
    if (tk == "double") {
      if (s == "int") {
        return (RsExpr.of((("(to_double " + v.code) + ")") target))
      }
      return (RsExpr.of(v.code target))
    }
    if (tk == "char") {
      if (s == "int") {
        return (RsExpr.of((("(rs_char_from " + v.code) + ")") target))
      }
      return (RsExpr.of(v.code target))
    }
    this.unsupported(n (("a cast to `" + (target.rust())) + "`"))
    return v
  }

  ; `Enum::X as i32`: the discriminant of a plain enum value.
  fn enumDisc:string (code:string en:string) {
    def e:RsEnum (unwrap (get enums en))
    def acc:string "0"
    def i:int ((array_length e.variants) - 1)
    while (i >= 0) {
      def v:RsVariant (itemAt e.variants i)
      acc = ((((((("(? (" + code) + " == ") + (this.className(en))) + ".") + v.name) + ") ") + (to_string v.disc)) + ((" " + acc) + ")")
      i = i - 1
    }
    return acc
  }

  ; ------------------------------------------------------------------ calls

  ; Lowers call arguments against the parameter types, copying Copy structs
  ; and wrapping values passed where an Option is expected.
  fn lowerArgs:[string] (args:[RustNode] types:[RsType]) {
    def codes:[string]
    def i:int 0
    for args a:RustNode j {
      def t:RsType (RsType.mk("unknown"))
      if (i < (array_length types)) {
        t = (itemAt types i)
      }
      def v:RsExpr (this.lowerExprCopy(a t))
      def c:RsExpr (this.coerce(v t a))
      push codes c.code
      i = i + 1
    }
    return codes
  }

  fn paramTypes:[RsType] (f:RsFn) {
    def list:[RsType]
    for f.params p:RsParam i {
      push list p.ty
    }
    return list
  }

  fn callArgs:[RustNode] (n:RustNode from:int) {
    def list:[RustNode]
    def i:int from
    while (i < (array_length n.kids)) {
      push list (n.kid(i))
      i = i + 1
    }
    return list
  }

  fn lowerCall:RsExpr (n:RustNode expect:RsType) {
    def callee:RustNode (n.kid(0))
    def args:[RustNode] (this.callArgs(n 1))
    if ((callee.kind == "path_expr") && ((callee.kid(0)).kind == "path")) {
      def segs:[string] (this.pathSegs((callee.kid(0))))
      def ns:int (array_length segs)
      def name:string (itemAt segs (ns - 1))
      if (ns == 1) {
        def l@(optional):RsLocal (scope.lookup(name))
        if (!null? l) {
          def lv:RsLocal (unwrap l)
          return (this.callValue(lv.rname lv.ty args n))
        }
        if (name == "Some") {
          return (this.makeSome(args expect n))
        }
        if ((name == "Ok") || (name == "Err")) {
          if (displayFormatter != "") {
            return (this.unit())
          }
          return (this.makeResult(name args expect n))
        }
        def fk:string (this.resolveItem(segs "fn"))
        if (fk != "") {
          return (this.callModuleFn(fk callee args expect n))
        }
        if (has structs name) {
          def s:RsStruct (unwrap (get structs name))
          if (s.isTuple) {
            def ftypes:[RsType]
            for s.fields sf:RsField fi {
              push ftypes sf.ty
            }
            def codes2:[string] (this.lowerArgs(args ftypes))
            return (RsExpr.of((((("(new " + (this.className(name))) + "(") + (join codes2 " ")) + "))") (RsType.named(name))))
          }
        }
        if (name == "drop") {
          return (this.unit())
        }
        if (this.isPreludeOp(name (array_length args))) {
          return (this.preludeOpCall(name args n))
        }
        this.err(n (("unknown function `" + name) + "`"))
        return (this.unit())
      }
      ; `geometry::area(…)`, `crate::util::f(…)` (R6)
      def fkp:string (this.resolveItem(segs "fn"))
      if (fkp != "") {
        return (this.callModuleFn(fkp callee args expect n))
      }
      return (this.lowerPathCall(segs args expect n))
    }
    def cv:RsExpr (this.lowerExpr(callee (RsType.mk("unknown"))))
    def fname:string (this.bindTemp(cv cv.ty "f"))
    return (this.callValue(fname cv.ty args n))
  }

  ; A call of a module-level function.
  fn callModuleFn:RsExpr (fk:string callee:RustNode args:[RustNode] expect:RsType n:RustNode) {
    def f:RsFn (unwrap (get fns fk))
    if ((array_length f.generics) > 0) {
      def cp:RustNode (callee.kid(0))
      def lastSeg:RustNode (itemAt cp.kids ((array_length cp.kids) - 1))
      return (this.lowerGenericCall(f args (lastSeg.kid(0)) expect n))
    }
    this.checkCallBorrows((new RustNode("none")) false false args n)
    if (this.hasBoxed(f)) {
      return (this.boxedCall((((f.modCls + ".") + f.rname) + "(") f args (RsType.mk("unknown")) "" n))
    }
    def codes:[string] (this.lowerArgs(args (this.paramTypes(f))))
    return (RsExpr.of((((((("(" + f.modCls) + ".") + f.rname) + "(") + (join codes " ")) + "))") f.ret))
  }

  ; Calls a value of function type (a closure in a local or a field).
  fn callValue:RsExpr (fname:string ft:RsType args:[RustNode] at:RustNode) {
    if (ft.kind != "fn") {
      this.err(at (("`" + fname) + "` is not a function"))
      return (this.unit())
    }
    def types:[RsType]
    def i:int 0
    while (i < ((array_length ft.args) - 1)) {
      push types (ft.arg(i))
      i = i + 1
    }
    def codes:[string] (this.lowerArgs(args types))
    def ret:RsType (ft.arg(((array_length ft.args) - 1)))
    return (RsExpr.of((((("(" + fname) + "(") + (join codes " ")) + "))") ret))
  }

  fn makeSome:RsExpr (args:[RustNode] expect:RsType at:RustNode) {
    def inner:RsType (RsType.mk("unknown"))
    if (expect.kind == "opt") {
      inner = (expect.arg(0))
    }
    def v:RsExpr (this.lowerExprCopy((itemAt args 0) inner))
    def t:RsType inner
    if (t.isUnknown()) {

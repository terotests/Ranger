  ; ------------------------------------------------ patterns that narrow

  ; True when matching `pat` needs a `case` narrowing (a variant of an enum
  ; with data, or Ok / Err), not just a boolean test.
  fn needsOpen:boolean (pat:RustNode t:RsType) {
    def k:string pat.kind
    if ((k == "pat_tuple_struct") || (k == "pat_struct")) {
      def pn:string (this.lastSeg((pat.kid(0))))
      if (((pn == "Ok") || (pn == "Err")) && (t.kind == "result")) {
        return true
      }
      if ((pn == "Some") && (t.kind == "opt")) {
        return (this.needsOpen((pat.kid(1)) (t.arg(0))))
      }
      if (this.isDataEnum(t)) {
        return true
      }
      ; a struct pattern: its fields may need narrowing
      if ((t.kind == "named") && (has structs t.name)) {
        def s:RsStruct (unwrap (get structs t.name))
        def i:int 1
        while (i < (array_length pat.kids)) {
          def sub:RustNode (pat.kid(i))
          def fname:string ("f" + (to_string (i - 1)))
          def subPat:RustNode sub
          if (k == "pat_struct") {
            fname = sub.name
            subPat = (sub.kid(0))
          }
          def f@(optional):RsField (s.field(fname))
          if (!null? f) {
            def ff:RsField (unwrap f)
            if (this.needsOpen(subPat ff.ty)) {
              return true
            }
          }
          i = i + 1
        }
      }
      return false
    }
    if ((k == "pat_ident") && ((array_length pat.kids) > 0)) {
      return (this.needsOpen((pat.kid(0)) t))
    }
    if ((k == "pat_paren") || (k == "pat_ref") || (k == "pat_box")) {
      return (this.needsOpen((pat.kid(0)) t))
    }
    if (k == "pat_tuple") {
      def ti:int 0
      for pat.kids sp:RustNode tj {
        if (this.needsOpen(sp (t.arg(ti)))) {
          return true
        }
        ti = ti + 1
      }
    }
    if (k == "pat_or") {
      for pat.kids alt:RustNode ai {
        if (this.needsOpen(alt t)) {
          return true
        }
      }
    }
    return false
  }

  ; Emits the tests of `pat` against `subj` as nested blocks, declaring its
  ; bindings inside them; answers how many blocks were opened. The caller
  ; emits the arm and closes them.
  fn patOpen:int (pat:RustNode subj0:string t:RsType) {
    def k:string pat.kind
    def subj:string subj0
    if ((k == "pat_wild") || (k == "pat_rest")) {
      return 0
    }
    if ((k == "pat_paren") || (k == "pat_ref") || (k == "pat_box")) {
      return (this.patOpen((pat.kid(0)) subj t))
    }
    if (k == "pat_ident") {
      if (this.isUnitVariantName(pat.name t)) {
        out.line((("if " + (this.condText((this.patCond(pat subj t))))) + " {"))
        out.indent()
        return 1
      }
      def n0:int 0
      if ((array_length pat.kids) > 0) {
        n0 = (this.patOpen((pat.kid(0)) subj t))
      }
      this.declareBinding(pat subj t)
      return n0
    }
    if (k == "pat_tuple") {
      if (t.kind != "tuple") {
        this.unsupported(pat "a tuple pattern on a value that is not a tuple")
        return 0
      }
      def opened:int 0
      def ti:int 0
      for pat.kids sp:RustNode tj {
        opened = opened + (this.patOpen(sp ((subj + ".f") + (to_string ti)) (t.arg(ti))))
        ti = ti + 1
      }
      return opened
    }
    if ((k == "pat_tuple_struct") || (k == "pat_struct")) {
      def pn:string (this.lastSeg((pat.kid(0))))
      if ((pn == "Some") && (t.kind == "opt")) {
        out.line((("if (!null? " + subj) + ") {"))
        out.indent()
        def u:string (this.tmp("u"))
        out.line(((("def " + (this.declText(u (t.arg(0))))) + " (unwrap ") + subj) + ")")
        set backOf u (this.backPlace(subj))
        return (1 + (this.patOpen((pat.kid(1)) u (t.arg(0)))))
      }
      if (((pn == "Ok") || (pn == "Err")) && (t.kind == "result")) {
        if (pn == "Ok") {
          out.line((("if " + subj) + ".ok {"))
        } {
          out.line((("if (! " + subj) + ".ok) {"))
        }
        out.indent()
        if (pn == "Ok") {
          if ((t.arg(0)).kind == "unit") {
            return 1
          }
          return (1 + (this.patOpen((pat.kid(1)) (subj + ".v") (t.arg(0)))))
        }
        return (1 + (this.patOpen((pat.kid(1)) (subj + ".e") (t.arg(1)))))
      }
      if (this.isDataEnum(t)) {
        def e:RsEnum (unwrap (get enums t.name))
        def v@(optional):RsVariant (e.variant(pn))
        if (null? v) {
          this.err(pat (((("no variant `" + pn) + "` in `") + t.name) + "`"))
          return 0
        }
        def vv:RsVariant (unwrap v)
        def cs:string subj
        if (((indexOf cs ".") >= 0) || ((indexOf cs "(") >= 0)) {
          cs = (this.tmp("cs"))
          out.line(((((("def " + cs) + ":") + (this.className(t.name))) + " ") + subj))
        }
        def x:string (this.tmp("x"))
        set caseOfVar x ((t.name + ".") + pn)
        out.line((((("case " + cs) + " ") + x) + (((":" + (this.caseType(t.name pn))) + " {"))))
        out.indent()
        def opened2:int 1
        def i:int 1
        while (i < (array_length pat.kids)) {
          def sub:RustNode (pat.kid(i))
          i = i + 1
          def fname:string ""
          def subPat:RustNode sub
          if (k == "pat_struct") {
            fname = sub.name
            subPat = (sub.kid(0))
          } {
            if (sub.kind == "pat_rest") {
              continue
            }
            fname = ("f" + (to_string (i - 2)))
          }
          def ft:RsType (RsType.mk("unknown"))
          def found:boolean false
          for vv.fields f:RsField fj {
            if (f.name == fname) {
              ft = f.ty
              found = true
            }
          }
          if (false == found) {
            this.err(sub (((("no field `" + fname) + "` in `") + pn) + "`"))
            continue
          }
          opened2 = opened2 + (this.patOpen(subPat ((x + ".") + (this.fieldName(fname))) ft))
        }
        return opened2
      }
      if ((t.kind == "named") && (has structs t.name)) {
        def s:RsStruct (unwrap (get structs t.name))
        def opened3:int 0
        def j:int 1
        while (j < (array_length pat.kids)) {
          def sub2:RustNode (pat.kid(j))
          j = j + 1
          def fname2:string ("f" + (to_string (j - 2)))
          def subPat2:RustNode sub2
          if (k == "pat_struct") {
            fname2 = sub2.name
            subPat2 = (sub2.kid(0))
          }
          if (sub2.kind == "pat_rest") {
            continue
          }
          def f2@(optional):RsField (s.field(fname2))
          if (null? f2) {
            this.err(sub2 (("no field `" + fname2) + "`"))
            continue
          }
          def ff2:RsField (unwrap f2)
          opened3 = opened3 + (this.patOpen(subPat2 ((subj + ".") + (this.fieldName(fname2))) ff2.ty))
        }
        return opened3
      }
    }
    ; everything else is a plain test
    def cond:string (this.patCond(pat subj t))
    if (cond == "true") {
      this.bindPattern(pat subj t)
      return 0
    }
    out.line((("if " + (this.condText(cond))) + " {"))
    out.indent()
    this.bindPattern(pat subj t)
    return 1
  }

  fn closeBlocks:void (n:int) {
    def i:int 0
    while (i < n) {
      out.dedent()
      out.line("}")
      i = i + 1
    }
  }

  ; ------------------------------------------------------ moves (stage R3)

  def noMoveCheck:boolean false

  fn ownedString:RsType () {
    def t:RsType (RsType.mk("string"))
    t.name = "String"
    return t
  }

  ; Rust's Copy: numbers, bool, char, shared references, and structs / enums
  ; that derive Copy; unknown types count as Copy (nothing is reported).
  fn isCopy:boolean (t:RsType) {
    if (t.isRef && (false == t.isMutRef)) {
      return true
    }
    def k:string t.kind
    if ((k == "int") || (k == "double") || (k == "bool") || (k == "char") || (k == "unit") || (k == "never") || (k == "unknown") || (k == "fn") || (k == "none")) {
      return true
    }
    if (k == "string") {
      ; a String owns its text; a &str (a literal, a slice) is Copy
      return (t.name != "String")
    }
    if (t.shared) {
      return false
    }
    if ((k == "vec") || (k == "map") || (k == "set") || (k == "result")) {
      return false
    }
    if (k == "opt") {
      return (this.isCopy((t.arg(0))))
    }
    if (k == "tuple") {
      for t.args a:RsType i {
        if (false == (this.isCopy(a))) {
          return false
        }
      }
      return true
    }
    if (k == "named") {
      if (has structs t.name) {
        def s:RsStruct (unwrap (get structs t.name))
        return (s.derivesTrait("Copy"))
      }
      if (has enums t.name) {
        def e:RsEnum (unwrap (get enums t.name))
        return ((indexOf e.derives "Copy") >= 0)
      }
      if (t.isDyn) {
        return false
      }
    }
    return true
  }

  ; `n` is used by value: a non-Copy local is moved; moving out of a
  ; borrowed `self` or out of a Vec element is an error, as in rustc.
  fn noteMove:void (n0:RustNode t:RsType) {
    def n:RustNode n0
    while (n.kind == "paren") {
      n = (n.kid(0))
    }
    if (this.isCopy(t)) {
      return
    }
    if (n.kind == "path_expr") {
      def p:RustNode (n.kid(0))
      if ((array_length p.kids) != 1) {
        return
      }
      def s:RustNode (p.kid(0))
      def l@(optional):RsLocal (scope.lookup(s.name))
      if (null? l) {
        return
      }
      def lv:RsLocal (unwrap l)
      if (lv.isAlias) {
        return
      }
      lv.moved = true
      lv.movedLine = n.line
      lv.movedCol = n.col
      return
    }
    if (n.kind == "field") {
      def base:RustNode (n.kid(0))
      while ((base.kind == "field") || (base.kind == "paren")) {
        base = (base.kid(0))
      }
      if ((base.kind == "path_expr") && ((this.lastSeg((base.kid(0)))) == "self")) {
        this.err(n (("cannot move out of `self." + n.name) + "`, which is behind a reference: use `.clone()` or `std::mem::take`"))
      }
      return
    }
    if (n.kind == "index") {
      this.err(n "cannot move out of an index of a Vec: use `.clone()`, or borrow it with `&`")
    }
  }

  ; The moved locals, to restore after a branch.
  fn movedSnapshot:[RsLocal] () {
    def list:[RsLocal]
    for fnLocals l:RsLocal i {
      if (l.moved) {
        push list l
      }
    }
    return list
  }

  fn movedRestore:void (list:[RsLocal]) {
    for fnLocals l:RsLocal i {
      l.moved = false
    }
    for list m:RsLocal j {
      m.moved = true
    }
  }

  fn movedUnion:[RsLocal] (a:[RsLocal] b:[RsLocal]) {
    def list:[RsLocal]
    for a x:RsLocal i {
      push list x
    }
    for b y:RsLocal j {
      if ((indexOf list y) < 0) {
        push list y
      }
    }
    return list
  }

  ; True when a block never finishes normally: its last statement returns,
  ; breaks, continues or panics.
  fn blockDiverges:boolean (b:RustNode) {
    if (b.kind != "block") {
      return (this.divergesAll(b))
    }
    def n:int (array_length b.kids)
    if (n == 0) {
      return false
    }
    def last:RustNode (b.kid((n - 1)))
    if (last.kind != "expr_stmt") {
      return false
    }
    def e:RustNode (last.kid(0))
    if (this.divergesAll(e)) {
      return true
    }
    if (e.kind == "if") {
      def el:RustNode (e.kid(2))
      if (el.isNone()) {
        return false
      }
      return ((this.blockDiverges((e.kid(1)))) && (this.blockDiverges(el)))
    }
    if (e.kind == "block") {
      return (this.blockDiverges(e))
    }
    return false
  }

  ; After a loop body: a value declared before the loop and moved inside it
  ; would be moved again by the next iteration.
  fn checkLoopMoves:void (before:[RsLocal] firstInside:int body:RustNode) {
    if (this.blockDiverges(body)) {
      return
    }
    def n:int (array_length fnLocals)
    def k:int 0
    while (k < n) {
      def l:RsLocal (itemAt fnLocals k)
      k = k + 1
      if (l.moved && (l.order < firstInside) && ((indexOf before l) < 0)) {
        this.err(body (((("value `" + l.name) + "` moved in a previous iteration of the loop (moved at line ") + (to_string l.movedLine)) + ")"))
        l.moved = false
      }
    }
  }

  ; ------------------------------------------------ ordered Map (stage R4)

  ; The prelude's `Map<K, V>` iterates in insertion order. Ranger's map is
  ; the target's own, and Go's is unordered, so a Map is a class that keeps
  ; the key order beside the map: `order` and `vals`.
  fn omapClass:string (t:RsType) {
    def plain:RsType (RsType.of2("map" (t.arg(0)) (t.arg(1))))
    def name:string ("RsOMap_" + (this.mangleKey(plain)))
    if (has genNames name) {
      return name
    }
    set genNames name true
    def kt:string (this.rtype((t.arg(0))))
    def vt:string (this.rtype((t.arg(1))))
    def lines:[string]
    push lines (("class " + name) + " {")
    push lines (("  def order:[" + kt) + "]")
    push lines (((("  def vals:[" + kt) + ":") + vt) + "]")
    push lines (((("  fn put:void (k:" + kt) + " v:") + vt) + ") {")
    push lines "    if (false == (has vals k)) {"
    push lines "      push order k"
    push lines "    }"
    push lines "    set vals k v"
    push lines "  }"
    push lines (("  fn del:void (k:" + kt) + ") {")
    push lines "    if (has vals k) {"
    push lines "      def i:int (indexOf order k)"
    push lines "      remove_index order i"
    push lines "      rs_map_remove vals k"
    push lines "    }"
    push lines "  }"
    push lines (("  fn rs_clone:" + name) + " () {")
    push lines (((("    def o:" + name) + " (new ") + name) + "())")
    push lines "    def n:int (array_length order)"
    push lines "    def i:int 0"
    push lines "    while (i < n) {"
    push lines (("      def k:" + kt) + " (itemAt order i)")
    push lines (("      def v:" + vt) + " (unwrap (get vals k))")
    push lines (("      o.put(k " + (this.cloneCode("v" (t.arg(1))))) + ")")
    push lines "      i = i + 1"
    push lines "    }"
    push lines "    return o"
    push lines "  }"
    push lines ("}" + (this.helperDoc("A ranger::Map: the keys in insertion order are `order`, the values `vals`")))
    push genOut (join lines "\n")
    return name
  }

  fn isOrderedMap:boolean (t:RsType) {
    return (((t.kind == "map") || (t.kind == "entry")) && (t.name == "ordered"))
  }

  ; The `[K:V]` to read from: the map itself or an ordered Map's `vals`.
  fn mapR:string (m:string t:RsType) {
    if (this.isOrderedMap(t)) {
      return (m + ".vals")
    }
    return m
  }

  fn mapSetLine:string (m:string t:RsType k:string v:string) {
    if (this.isOrderedMap(t)) {
      return (((((m + ".put(") + k) + " ") + v) + ")")
    }
    return (((((("set " + m) + " ") + k) + " ") + v))
  }

  ; The keys in iteration order, as an array expression. The order array
  ; itself: the borrow check keeps a loop over it from changing the Map.
  fn mapKeysCode:string (m:string t:RsType) {
    if (this.isOrderedMap(t)) {
      return (m + ".order")
    }
    if ((t.arg(0)).kind == "int") {
      ; Ranger's `keys` takes string keys
      return (("(rs_int_keys " + m) + ")")
    }
    return (("(keys " + m) + ")")
  }

  ; ` (new RsOMap_…())` after a declaration that needs a constructed value.
  fn initSuffix:string (t:RsType) {
    if ((t.kind == "map") && (t.name == "ordered")) {
      return (" " + (this.defaultValue(t)))
    }
    return ""
  }

  ; ------------------------------------------- prelude operators (stage R4)

  ; `sqrt(x)`, `path_dirname(p)`: an operator runtime/rust/ranger/src/ops.rs
  ; offers (RustPreludeOps.rgr, generated with it).
  fn isPreludeOp:boolean (name:string argc:int) {
    if (false == preludeLoaded) {
      preludeOps = (RustPreludeOps.arities())
      preludeRets = (RustPreludeOps.returns())
      preludeLoaded = true
    }
    if (false == (has preludeOps name)) {
      return false
    }
    return ((unwrap (get preludeOps name)) == argc)
  }

  ; The call becomes the operator, so each target runs its own template.
  ; `to_uppercase` / `to_lowercase` go through the prelude's full Unicode
  ; case map (the C++ operator maps ASCII only, ISSUES.md #102).
  fn preludeOpCall:RsExpr (name:string args:[RustNode] n:RustNode) {
    def ret:string (unwrap (get preludeRets name))
    def rt:RsType (RsType.mk("unit"))
    if (ret == "int") {
      rt = (RsType.mk("int"))
    }
    if (ret == "double") {
      rt = (RsType.mk("double"))
    }
    if (ret == "boolean") {
      rt = (RsType.mk("bool"))
    }
    if (ret == "string") {
      rt = (this.ownedString())
    }
    def codes:[string]
    for args a:RustNode i {
      def v:RsExpr (this.lowerExpr(a (RsType.mk("unknown"))))
      push codes v.code
    }
    def op:string name
    if (name == "to_uppercase") {
      op = "rs_upper"
    }
    if (name == "to_lowercase") {
      op = "rs_lower"
    }
    def code:string (((("(" + op) + " ") + (join codes " ")) + ")")
    if ((array_length codes) == 0) {
      code = (("(" + op) + ")")
    }
    if (ret == "void") {
      out.line(code)
      return (this.unit())
    }
    return (RsExpr.of(code rt))
  }

  ; ------------------------------------------------------ borrows (stage R3)

  ; `a`, `a.b.c`, `self.x` as a dotted string; "" for anything else.
  fn placePath:string (n0:RustNode) {
    def n:RustNode n0
    while ((n.kind == "paren") || ((n.kind == "unary") && (n.name == "*"))) {
      n = (n.kid(0))
    }
    if (n.kind == "path_expr") {
      def p:RustNode (n.kid(0))
      if ((array_length p.kids) == 1) {
        return (this.lastSeg(p))
      }
      return ""
    }
    if (n.kind == "field") {
      def b:string (this.placePath((n.kid(0))))
      if (b == "") {
        return ""
      }
      return ((b + ".") + n.name)
    }
    return ""
  }

  fn pathsOverlap:boolean (a:string b:string) {
    if (a == b) {
      return true
    }
    if ((indexOf a (b + ".")) == 0) {
      return true
    }
    return ((indexOf b (a + ".")) == 0)
  }

  ; The borrows of one call: `&mut p` and `&p` arguments and the receiver.
  ; A mutable borrow may not overlap any other borrow of the same place.
  fn checkCallBorrows:void (recv:RustNode recvMut:boolean recvBorrows:boolean args:[RustNode] at:RustNode) {
    def paths:[string]
    def muts:[boolean]
    if (recvBorrows) {
      def rp:string (this.placePath(recv))
      if (rp != "") {
        push paths rp
        push muts recvMut
      }
    }
    for args a:RustNode i {
      if ((a.kind == "unary") && ((a.name == "&mut") || (a.name == "&"))) {
        def ap:string (this.placePath((a.kid(0))))
        if (ap != "") {
          push paths ap
          push muts (a.name == "&mut")
        }
      }
    }
    def n:int (array_length paths)
    def i:int 0
    while (i < n) {
      def j:int (i + 1)
      while (j < n) {
        def pi:string (itemAt paths i)
        def pj:string (itemAt paths j)
        if ((this.pathsOverlap(pi pj)) && ((itemAt muts i) || (itemAt muts j))) {
          if ((itemAt muts i) && (itemAt muts j)) {
            this.err(at (("cannot borrow `" + pj) + "` as mutable more than once at a time"))
          } {
            this.err(at (("cannot borrow `" + pj) + "` as mutable because it is also borrowed as immutable"))
          }
          return
        }
        j = j + 1
      }
      i = i + 1
    }
  }

  ; the places iterated by the enclosing `for` loops (`for x in &v`)
  def iterRoots:[string]

  fn checkIterMutation:void (recvN:RustNode at:RustNode) {
    def p:string (this.placePath(recvN))
    if (p == "") {
      return
    }
    for iterRoots r:string i {
      if ((r != "") && (this.pathsOverlap(r p))) {
        this.err(at (("cannot borrow `" + p) + "` as mutable because it is also borrowed as immutable by the `for` loop over it"))
        return
      }
    }
  }

  ; ------------------------------------------------ &mut of a value type

  fn needsBox:boolean (t:RsType) {
    if (false == t.isMutRef) {
      return false
    }
    def k:string t.kind
    if ((k == "map") && (t.name == "ordered")) {
      ; a class: already shared
      return false
    }
    return ((k == "int") || (k == "double") || (k == "bool") || (k == "string") || (k == "char") || (k == "vec") || (k == "map") || (k == "set"))
  }

  fn hasBoxed:boolean (f:RsFn) {
    for f.params p:RsParam i {
      if (p.boxed) {
        return true
      }
    }
    return false
  }

  fn boxClass:string (t:RsType) {
    def plain:RsType (t.copy())
    plain.isRef = false
    plain.isMutRef = false
    def name:string ("RsBox_" + (this.mangleKey(plain)))
    if (false == (has genNames name)) {
      set genNames name true
      def decl:string (this.fieldDecl("v" plain))
      push genOut (((("class " + name) + " {\n  def ") + decl) + "\n}")
    }
    return name
  }

  ; A call with boxed `&mut` arguments: box each place, call as a statement,
  ; write the boxes back, then answer the result.
  fn boxedCall:RsExpr (head:string f:RsFn args:[RustNode] owner:RsType extra:string at:RustNode) {
    def env:[string:RsType] (this.methodEnv(owner))
    def codes:[string]
    def places:[RustNode]
    def boxes:[string]
    def btypes:[RsType]
    def i:int 0
    for args a:RustNode j {
      def p:RsParam (RsParam.unknown())
      if (i < (array_length f.params)) {
        p = (itemAt f.params i)
      }
      def pty:RsType (this.subst(p.ty env))
      if (p.boxed) {
        def place:RustNode a
        if ((place.kind == "unary") && (place.name == "&mut")) {
          place = (place.kid(0))
        }
        def cur:RsExpr (this.lowerExpr(place pty))
        def bn:string (this.tmp("box"))
        def bc:string (this.boxClass(pty))
        out.line((((("def " + bn) + ":") + bc) + ((" (new " + bc) + ")")))
        out.line((((bn + ".v = ") + cur.code)))
        push codes bn
        push places place
        push boxes bn
        push btypes pty
      } {
        def v:RsExpr (this.lowerExprCopy(a pty))
        def c:RsExpr (this.coerce(v pty a))
        push codes c.code
      }
      i = i + 1
    }
    def ret:RsType (this.subst(f.ret env))
    def call:string ((head + (join codes " ")) + ")")
    def result:RsExpr (this.unit())
    if ((ret.kind == "unit") || (ret.kind == "never")) {
      out.line(call)
    } {
      def rn:string (this.tmp("ret"))
      out.line(((("def " + (this.declText(rn ret))) + " (") + call) + ")"))
      result = (this.simpleExpr(rn ret))
    }
    def k:int 0
    while (k < (array_length places)) {
      this.assignTo((itemAt places k) (this.simpleExpr(((itemAt boxes k) + ".v") (itemAt btypes k))))
      k = k + 1
    }
    return result
  }
}

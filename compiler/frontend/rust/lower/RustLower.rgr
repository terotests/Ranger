  ; ------------------------------------------------------------ emission

  fn emitAll:string () {
    def parts:[string]
    push parts "Import \"rust/RsPrelude.rgr\""
    for structOrder jsn:string jsi {
      def jst:RsStruct (unwrap (get structs jsn))
      if (jst.serialize && (false == usesJson)) {
        usesJson = true
        push parts "Import \"rust/RsJson.rgr\""
      }
    }
    ; the `.rgr` modules the crate includes, relative to the entry file
    def entryDir:string (RustLower.dirOf(entryName))
    for rgrImports rip:string rii {
      def rel:string rip
      if ((entryDir != "") && ((strlen rip) > (strlen entryDir)) && ((substring rip 0 ((strlen entryDir) + 1)) == (entryDir + "/"))) {
        rel = (substring rip ((strlen entryDir) + 1) (strlen rip))
      }
      push parts (("Import \"" + rel) + "\"")
    }
    ; an enum's shape is written last: lowering the functions finds the
    ; variants a `ref mut` binding writes into (writtenCases)
    def shapeAt:[int]
    def ei:int 0
    while (ei < (array_length enumOrder)) {
      def en:string (itemAt enumOrder ei)
      ei = ei + 1
      def eo:RsEnum (unwrap (get enums en))
      push shapeAt (array_length parts)
      push parts ""
      push parts (this.emitEnum(eo))
    }
    def si:int 0
    while (si < (array_length structOrder)) {
      def sn:string (itemAt structOrder si)
      si = si + 1
      def so:RsStruct (unwrap (get structs sn))
      push parts (this.emitStruct(so))
    }
    push parts (this.emitModules())
    ; instances and trait unions found while writing, until none are new
    def qi:int 0
    def di:int 0
    while ((qi < (array_length structInstQueue)) || (di < (array_length dynQueue))) {
      if (qi < (array_length structInstQueue)) {
        def inst:RsInst (itemAt structInstQueue qi)
        qi = qi + 1
        push parts (this.emitStructInstance(inst))
        continue
      }
      def tn:string (itemAt dynQueue di)
      di = di + 1
      push parts (this.emitDyn(tn))
    }
    for genOut g:string k {
      push parts g
    }
    if ((array_length clonerOut) > 0) {
      push parts (("class RsClone {\n" + (join clonerOut "\n")) + "\n}")
    }
    for enumOrder en2:string ej {
      def eo2:RsEnum (unwrap (get enums en2))
      set_at parts (itemAt shapeAt ej) (this.emitEnumShape(eo2))
    }
    return ((join parts "\n\n") + "\n")
  }

  fn implClass:string (en:string) {
    return ("RsImpl_" + en)

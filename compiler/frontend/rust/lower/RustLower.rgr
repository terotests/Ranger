    def arg:RustNode (new RustNode("none"))
    if ((array_length args) > 0) {
      arg = (itemAt args 0)
      if ((arg.kind == "tuple") && ((array_length arg.kids) == 0)) {
        arg = (new RustNode("none"))
      }
    }
    return (this.makeResultValue((name == "Ok") arg expect at))

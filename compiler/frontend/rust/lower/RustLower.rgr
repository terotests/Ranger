      out.line((((("def " + res) + ":") + cls) + ((" (new " + cls) + ")")))
      out.line((("if (!null? " + o) + ") {"))
      out.line((("  " + res) + ".ok = true"))
      out.line((((("  " + res) + ".v = ") + (this.unionSafe((("(unwrap " + o) + ")") inner)))))
      out.line("} {")
      out.indent()
      out.addIndented(errLines lastCapturedInd)
      out.line((((res + ".e = ") + (this.unionSafe(errV.code et)))))
      out.dedent()
      out.line("}")
      return (this.simpleExpr(res rt))
    }
    if ((name == "map") || (name == "and_then") || (name == "filter")) {
      def some:RsExpr (this.simpleExpr((("(unwrap " + o) + ")") inner))
      def fv:RsExpr (this.captureClosure((itemAt args 0) ([] _:RsExpr (some)) (RsType.mk("unknown"))))
      def fLines:[string] lastCaptured
      def fInd:string lastCapturedInd
      def outT:RsType (RsType.of1("opt" fv.ty))
      if (name == "and_then") {
        outT = fv.ty
      }
      if (name == "filter") {
        outT = t
      }
      def mo:string (this.tmp("o"))
      out.line(("def " + (this.declText(mo outT))))
      out.line((("if (!null? " + o) + ") {"))
      out.indent()
      out.addIndented(fLines fInd)
      if (name == "filter") {
        out.line((("if " + (this.condText(fv.code))) + " {"))
        out.line((((("  " + mo) + " = ") + o)))
        out.line("}")
      } {
        out.line((((mo + " = ") + (this.unionSafe(fv.code (outT.arg(0)))))))
      }
      out.dedent()
      out.line("}")
      return (this.simpleExpr(mo outT))
    }
    if ((name == "unwrap_or_else") || (name == "map_or") || (name == "map_or_else")) {
      ; the value when present (mapped for map_or), else the default
      def someV:RsExpr (this.simpleExpr((("(unwrap " + o) + ")") inner))
      def dflt:RsExpr (RsExpr.of("" (RsType.mk("unknown"))))
      def dLines:[string]
      def dInd:string ""
      if (name == "unwrap_or_else") {
        dflt = (this.captureClosure((itemAt args 0) ([] _:RsExpr ()) inner))
        dLines = lastCaptured
        dInd = lastCapturedInd
      } {
        if (name == "map_or") {
          dflt = (this.captureExpr((itemAt args 0) expect))
        } {
          dflt = (this.captureClosure((itemAt args 0) ([] _:RsExpr ()) expect))
        }
        dLines = lastCaptured
        dInd = lastCapturedInd
        someV = (this.captureClosure((itemAt args 1) ([] _:RsExpr (someV)) dflt.ty))
      }
      def sLines:[string]
      if (name != "unwrap_or_else") {
        sLines = lastCaptured
      }
      def vt2:RsType dflt.ty
      if (name == "unwrap_or_else") {
        vt2 = inner
      }
      def mv:string (this.tmp("v"))
      out.line(("def " + (this.tempDecl(mv vt2))))
      out.line((("if (!null? " + o) + ") {"))
      out.indent()
      out.addIndented(sLines lastCapturedInd)
      out.line((((mv + " = ") + someV.code)))
      out.dedent()
      out.line("} {")
      out.indent()
      out.addIndented(dLines dInd)
      out.line((((mv + " = ") + dflt.code)))
      out.dedent()
      out.line("}")
      return (this.simpleExpr(mv vt2))
    }
    this.unsupported(at (("the Option method `" + name) + "` (stage R2)"))
    return (this.unit())
  }

  fn resultMethod:RsExpr (rv:RsExpr name:string args:[RustNode] at:RustNode expect:RsType) {
    def t:RsType rv.ty
    def r:string (this.bindTemp(rv t "res"))
    def vt:RsType (t.arg(0))
    if ((name == "unwrap") || (name == "expect")) {
      out.line((("if (! " + r) + ".ok) {"))
      out.line("  rs_panic \"called `Result::unwrap()` on an `Err` value\"")
      out.line("}")
      if (vt.kind == "unit") {
        return (this.unit())
      }
      return (this.simpleExpr((r + ".v") vt))
    }
    if (name == "unwrap_err") {
      out.line((("if " + r) + ".ok {"))
      out.line("  rs_panic \"called `Result::unwrap_err()` on an `Ok` value\"")
      out.line("}")
      return (this.simpleExpr((r + ".e") (t.arg(1))))
    }
    if (name == "unwrap_or") {
      def d:RsExpr (this.arg0(args vt))
      return (RsExpr.of((((("(? " + r) + ".ok ") + r) + ((".v " + d.code) + ")")) vt))
    }
    if (name == "unwrap_or_default") {
      return (RsExpr.of((((("(? " + r) + ".ok ") + r) + ((".v " + (this.defaultValue(vt))) + ")")) vt))
    }
    if (name == "is_ok") {
      return (this.simpleExpr((r + ".ok") (RsType.mk("bool"))))
    }
    if (name == "is_err") {
      return (RsExpr.of((("(! " + r) + ".ok)") (RsType.mk("bool"))))
    }
    if ((name == "ok") || (name == "err")) {
      def inner:RsType vt
      def field:string "v"
      def cond:string (r + ".ok")
      if (name == "err") {
        inner = (t.arg(1))
        field = "e"
        cond = (("(! " + r) + ".ok)")
      }
      def ot:RsType (RsType.of1("opt" inner))
      def o:string (this.tmp("o"))
      out.line(("def " + (this.declText(o ot))))
      out.line((("if " + (this.condText(cond))) + " {"))
      out.line((((("  " + o) + " = ") + r) + ".") + field)
      out.line("}")
      return (this.simpleExpr(o ot))
    }
    if ((name == "map_or") || (name == "unwrap_or_else")) {
      def okV:RsExpr (this.simpleExpr((r + ".v") vt))
      def dfl:RsExpr (RsExpr.of("" (RsType.mk("unknown"))))
      def dl:[string]
      def dInd2:string ""
      def sl:[string]
      def sInd:string ""
      if (name == "map_or") {
        dfl = (this.captureExpr((itemAt args 0) expect))
        dl = lastCaptured
        dInd2 = lastCapturedInd
        okV = (this.captureClosure((itemAt args 1) ([] _:RsExpr (okV)) dfl.ty))
        sl = lastCaptured
        sInd = lastCapturedInd
      } {
        def errArg:RsExpr (this.simpleExpr((r + ".e") (t.arg(1))))
        dfl = (this.captureClosure((itemAt args 0) ([] _:RsExpr (errArg)) vt))
        dl = lastCaptured
        dInd2 = lastCapturedInd
      }
      def rvT:RsType dfl.ty
      if (name == "unwrap_or_else") {
        rvT = vt
      }
      def mv2:string (this.tmp("v"))
      out.line(("def " + (this.tempDecl(mv2 rvT))))
      out.line((("if " + r) + ".ok {"))
      out.indent()
      out.addIndented(sl sInd)
      out.line((((mv2 + " = ") + okV.code)))
      out.dedent()
      out.line("} {")
      out.indent()
      out.addIndented(dl dInd2)
      out.line((((mv2 + " = ") + dfl.code)))
      out.dedent()
      out.line("}")
      return (this.simpleExpr(mv2 rvT))
    }
    if ((name == "map_err") || (name == "map")) {
      def arg:RsExpr (this.simpleExpr((r + ".e") (t.arg(1))))
      if (name == "map") {
        arg = (this.simpleExpr((r + ".v") vt))
      }
      def want:RsType (RsType.mk("unknown"))
      if ((name == "map_err") && (expect.kind == "result")) {
        want = (expect.arg(1))
      }
      def fv2:RsExpr (this.captureClosure((itemAt args 0) ([] _:RsExpr (arg)) want))
      def fl:[string] lastCaptured
      def fi:string lastCapturedInd
      def nvt:RsType vt
      def net:RsType (t.arg(1))
      if (name == "map_err") {
        net = fv2.ty
        if (net.kind == "string") {
          net = (this.ownedString())
        }
      } {
        nvt = fv2.ty
      }
      def nrt:RsType (RsType.of2("result" nvt net))
      def ncls:string (this.resultClass(nrt))
      def nres:string (this.tmp("res"))
      out.line((((("def " + nres) + ":") + ncls) + ((" (new " + ncls) + ")")))
      out.line((("if " + r) + ".ok {"))
      out.indent()
      out.line((nres + ".ok = true"))
      if (name == "map") {
        out.addIndented(fl fi)
        out.line((((nres + ".v = ") + (this.unionSafe(fv2.code nvt)))))
      } {
        if (vt.kind != "unit") {
          out.line((((nres + ".v = ") + r) + ".v"))
        }
      }
      out.dedent()
      out.line("} {")
      out.indent()
      if (name == "map_err") {
        out.addIndented(fl fi)
        out.line((((nres + ".e = ") + (this.unionSafe(fv2.code net)))))
      } {
        out.line((((nres + ".e = ") + r) + ".e"))
      }
      out.dedent()
      out.line("}")
      return (this.simpleExpr(nres nrt))
    }
    this.unsupported(at (("the Result method `" + name) + "`"))
    return (this.unit())
  }

  ; `map.entry(k)`: a pending slot; `.or_insert(v)` fills it when empty and
  ; answers the value.
  fn entryMethod:RsExpr (rv:RsExpr name:string args:[RustNode] at:RustNode) {
    def bar:int (indexOf rv.code "|")
    def m:string (substring rv.code 0 bar)
    def k:string (substring rv.code (bar + 1) (strlen rv.code))
    def vt:RsType (rv.ty.arg(1))
    if ((name == "or_insert") || (name == "or_insert_with") || (name == "or_default")) {
      out.line((((("if (! (has " + (this.mapR(m rv.ty))) + " ") + k) + ")) {"))
      out.indent()
      def init:string ""
      if (name == "or_insert") {
        def iv:RsExpr (this.lowerExprCopy((itemAt args 0) vt))
        init = iv.code
      }
      if (name == "or_insert_with") {
        def fnN:RustNode (itemAt args 0)
        if ((fnN.kind == "path_expr") && (((this.lastSeg((fnN.kid(0)))) == "new") || ((this.lastSeg((fnN.kid(0)))) == "default"))) {
          init = (this.newValueCode(vt at))
        } {
          def cv:RsExpr (this.applyClosure(fnN ([] _:RsExpr ()) vt))
          init = cv.code
        }
      }
      if (name == "or_default") {
        init = (this.newValueCode(vt at))
      }
      out.line((this.mapSetLine(m rv.ty k init)))
      out.dedent()
      out.line("}")
      return (RsExpr.of((((("(unwrap (get " + (this.mapR(m rv.ty))) + " ") + k) + "))") vt))
    }
    this.unsupported(at (("the entry method `" + name) + "`"))
    return (this.unit())
  }

  ; A fresh value of a type: an empty collection or the type's zero.
  fn newValueCode:string (t:RsType at:RustNode) {
    if ((t.kind == "vec") || (t.kind == "map") || (t.kind == "set")) {
      def n:string (this.tmp("new"))
      out.line((((("def " + n) + ":") + (this.rtype(t))) + (this.initSuffix(t))))
      return n
    }
    def z:string (this.zeroCode(t))
    if (z == "") {
      this.err(at (("no default value for `" + (t.rust())) + "`"))
    }
    return z
  }

  fn mapMethod:RsExpr (rv:RsExpr name:string args:[RustNode] at:RustNode expect:RsType) {
    def t:RsType rv.ty
    def m:string (this.bindTemp(rv t "map"))
    def kt:RsType (t.arg(0))
    def vt:RsType (t.arg(1))
    if (t.kind == "set") {
      vt = (RsType.mk("bool"))
    }
    if (name == "entry") {
      def ek:RsExpr (this.lowerExprCopy((itemAt args 0) kt))
      def kn:string (this.bindTemp(ek kt "key"))
      def et:RsType (RsType.of2("entry" kt vt))
      et.name = t.name
      return (RsExpr.of(((m + "|") + kn) et))
    }
    if (name == "insert") {
      def kv:RsExpr (this.lowerExprCopy((itemAt args 0) kt))
      if (t.kind == "set") {
        ; answers whether the value was new
        def kn2:string (this.bindTemp(kv kt "key"))
        def was:string (this.tmp("had"))
        out.line((((("def " + was) + ":boolean (has ") + (this.mapR(m t))) + " ") + (kn2 + ")"))
        out.line(((("set " + m) + " ") + (kn2 + " true")))
        return (RsExpr.of((("(! " + was) + ")") (RsType.mk("bool"))))
      }
      def vv:RsExpr (this.lowerExprCopy((itemAt args 1) vt))
      out.line((this.mapSetLine(m t kv.code vv.code)))
      return (this.unit())
    }
    if ((name == "contains_key") || (name == "contains")) {
      def k2:RsExpr (this.arg0(args kt))
      return (RsExpr.of((((("(has " + (this.mapR(m t))) + " ") + k2.code) + ")") (RsType.mk("bool"))))
    }
    if (name == "get") {
      def k3:RsExpr (this.arg0(args kt))
      def ot:RsType (RsType.of1("opt" vt))
      def nm:string (this.tmp("g"))
      out.line(((((("def " + (this.declText(nm ot))) + " (get ") + (this.mapR(m t))) + " ") + k3.code) + ")"))
      def r:RsExpr (RsExpr.of(nm ot))
      r.simple = true
      return r
    }
    if (name == "remove") {
      def k4:RsExpr (this.arg0(args kt))
      if (t.name == "ordered") {
        out.line((((m + ".del(") + k4.code) + ")"))
      } {
        out.line(((("rs_map_remove " + m) + " ") + k4.code))
      }
      return (this.unit())
    }
    if (name == "len") {
      return (RsExpr.of((("(rs_map_len " + (this.mapR(m t))) + ")") (RsType.mk("int"))))
    }
    if (name == "is_empty") {
      return (RsExpr.of((("((rs_map_len " + (this.mapR(m t))) + ") == 0)") (RsType.mk("bool"))))
    }
    this.unsupported(at (("the map method `" + name) + "`"))
    return (this.unit())
  }

  ; ---------------------------------------------------------- field, index

  fn lowerField:RsExpr (n:RustNode) {
    def rv:RsExpr (this.lowerExpr((n.kid(0)) (RsType.mk("unknown"))))
    def t:RsType rv.ty
    def fname:string n.name
    def fty:RsType (RsType.mk("unknown"))
    if (t.kind == "tuple") {
      def idx:int (this.intValue(n))
      fname = ("f" + n.name)
      def ti:int 0
      def cs:[int] (to_chars n.name)
      for cs ch:int i {
        ti = (ti * 10) + (ch - 48)
      }
      fty = (t.arg(ti))
    } {
      if ((t.kind == "named") && (has structs t.name)) {
        def s:RsStruct (unwrap (get structs t.name))
        def key:string fname
        if (s.isTuple) {
          key = ("f" + fname)
        }
        def f@(optional):RsField (s.field(key))
        if (null? f) {
          this.err(n (((("no field `" + n.name) + "` on `") + t.name) + "`"))
          return (this.unit())
        }
        def ff:RsField (unwrap f)
        fty = (this.fieldTypeOf(s ff t))
        fname = (this.fieldName(key))
      } {
        this.err(n (((("no field `" + n.name) + "` on a value of type `") + (t.rust())) + "`"))
        return (this.unit())
      }
    }
    def recv:string (this.bindTemp(rv t "r"))
    def r:RsExpr (RsExpr.of(((recv + ".") + fname) fty))
    r.simple = true
    return r
  }

  fn lowerIndex:RsExpr (n:RustNode) {
    def recv0:RustNode (n.kid(0))
    if ((recv0.kind == "method") && (recv0.name == "as_bytes") && ((n.kid(1)).kind != "range")) {
      ; `s.as_bytes()[i]`: the UTF-8 byte on every target
      def sv:RsExpr (this.lowerExpr((recv0.kid(0)) (RsType.mk("string"))))
      def bs:string (this.tmp("bs"))
      out.line((((("def " + bs) + ":charbuffer (to_charbuffer ") + sv.code) + ")"))
      def bi:RsExpr (this.lowerExpr((n.kid(1)) (RsType.mk("int"))))
      def bv:string (this.tmp("b"))
      out.line((((((("def " + bv) + ":int (charAt ") + bs) + " ") + bi.code) + ")"))
      return (this.simpleExpr(bv (RsType.mk("int"))))
    }
    def rv:RsExpr (this.lowerExpr((n.kid(0)) (RsType.mk("unknown"))))
    def t:RsType rv.ty
    def ixN:RustNode (n.kid(1))
    if ((t.kind == "string") && (ixN.kind == "range")) {
      def s:string (this.bindTemp(rv t "s"))
      def lo:string "0"
      def hi:string (("(rs_byte_len " + s) + ")")
      if (false == ((ixN.kid(0)).isNone())) {
        def lv:RsExpr (this.lowerExpr((ixN.kid(0)) (RsType.mk("int"))))
        lo = lv.code
      }
      if (false == ((ixN.kid(1)).isNone())) {
        def hv:RsExpr (this.lowerExpr((ixN.kid(1)) (RsType.mk("int"))))
        hi = hv.code
        if (ixN.name == "..=") {
          hi = (("(" + hi) + " + 1)")
        }
      }
      return (RsExpr.of((((((("(rs_byte_slice " + s) + " ") + lo) + " ") + hi) + ")") t))
    }
    if (t.kind == "vec") {
      if (ixN.kind == "range") {
        this.unsupported(n "slicing a Vec with a range (stage R2)")
        return (this.unit())
      }
      def v:string (this.bindTemp(rv t "vec"))
      def iv:RsExpr (this.lowerExpr(ixN (RsType.mk("int"))))
      return (RsExpr.of((((("(itemAt " + v) + " ") + iv.code) + ")") (t.arg(0))))
    }
    if (t.kind == "map") {
      def m:string (this.bindTemp(rv t "map"))
      def kv:RsExpr (this.lowerExpr(ixN (t.arg(0))))
      return (RsExpr.of((((("(unwrap (get " + (this.mapR(m t))) + " ") + kv.code) + "))") (t.arg(1))))
    }
    this.err(n (("cannot index a value of type `" + (t.rust())) + "`"))
    return (this.unit())
  }

  ; ----------------------------------------------------------- assignment

  fn lowerAssign:void (n:RustNode) {
    def op:string n.name
    def lhs:RustNode (n.kid(0))
    def rhs:RustNode (n.kid(1))
    if (op == "=") {
      def lt:RsExpr (this.placeType(lhs))
      def v:RsExpr (this.lowerExprCopy(rhs lt.ty))
      def c:RsExpr (this.coerce(v lt.ty rhs))
      this.assignTo(lhs c)
      return
    }
    ; `*map.entry(k).or_insert(d) op= v`: a map slot
    def slot:RustNode lhs
    if ((slot.kind == "unary") && (slot.name == "*")) {
      slot = (slot.kid(0))
    }
    if ((slot.kind == "method") && ((slot.name == "or_insert") || (slot.name == "or_default") || (slot.name == "or_insert_with"))) {
      def sv:RsExpr (this.lowerExpr(slot (RsType.mk("unknown"))))
      def ekind:RustNode (slot.kid(0))
      def ev:RsExpr (this.lastEntry)
      def bar:int (indexOf ev.code "|")
      def m:string (substring ev.code 0 bar)
      def k:string (substring ev.code (bar + 1) (strlen ev.code))
      def rhsV:RsExpr (this.lowerExpr(rhs sv.ty))
      def newV:string rhsV.code
      if (op != "=") {
        def bop2:string (substring op 0 ((strlen op) - 1))
        newV = (this.arith(bop2 sv rhsV sv.ty))
      }
      out.line((this.mapSetLine(m ev.ty k newV)))
      return
    }
    ; compound: read, combine, write back
    def bop:string (substring op 0 ((strlen op) - 1))
    def fake:RustNode (new RustNode("bin"))
    fake.name = bop
    fake.line = n.line
    fake.col = n.col
    fake.add(lhs)
    fake.add(rhs)
    def cur:RsExpr (this.lowerExpr(fake (RsType.mk("unknown"))))
    this.assignTo(lhs cur)
  }

  ; The type of an assignment target, without emitting anything.
  fn placeType:RsExpr (lhs:RustNode) {
    def save:RustOut out
    out = (new RustOut())
    def saveN:int tmpN
    def saveErr:int (array_length errors)
    def saveNm:boolean noMoveCheck
    noMoveCheck = true
    def v:RsExpr (this.lowerExpr(lhs (RsType.mk("unknown"))))
    noMoveCheck = saveNm
    out = save
    tmpN = saveN
    while ((array_length errors) > saveErr) {
      removeLast errors
    }
    return v
  }

  fn assignTo:void (lhs:RustNode v:RsExpr) {
    def k:string lhs.kind
    if ((k == "unary") && (lhs.name == "*")) {
      this.assignTo((lhs.kid(0)) v)
      return
    }
    if (k == "paren") {
      this.assignTo((lhs.kid(0)) v)
      return
    }
    if (k == "path_expr") {
      def p:RustNode (lhs.kid(0))
      def segs:[string] (this.pathSegs(p))
      if ((array_length segs) == 1) {
        def l@(optional):RsLocal (scope.lookup((itemAt segs 0)))
        if (!null? l) {
          def lv:RsLocal (unwrap l)
          if (lv.iterVec != "") {
            out.line(((((("set_at " + lv.iterVec) + " ") + lv.iterIdx) + " ") + v.code))
          }
          if (lv.backBad) {
            this.unsupported(lhs (("assigning to `" + lv.name) + "`, a `ref mut` binding of a whole `&mut` match subject"))
          }
          out.line(((lv.rname + " = ") + v.code))
          if (lv.backTo != "") {
            out.line(((lv.backTo + " = ") + lv.rname))
            this.noteWrittenCase(lv)
          }
          lv.moved = false
          return
        }
      }
      this.err(lhs "cannot assign to this name")
      return
    }
    if (k == "field") {
      def rv:RsExpr (this.lowerExpr((lhs.kid(0)) (RsType.mk("unknown"))))
      def recv:string (this.bindTemp(rv rv.ty "r"))
      def fname:string lhs.name
      if (rv.ty.kind == "tuple") {
        fname = ("f" + fname)
      }
      if ((rv.ty.kind == "named") && (has structs rv.ty.name)) {
        def s:RsStruct (unwrap (get structs rv.ty.name))
        if (s.isTuple) {
          fname = ("f" + fname)
        }
        fname = (this.fieldName(fname))
      }
      out.line(((((recv + ".") + fname) + " = ") + v.code))
      return
    }
    if (k == "index") {
      def cv:RsExpr (this.lowerExpr((lhs.kid(0)) (RsType.mk("unknown"))))
      if (cv.ty.kind == "map") {
        def m:string (this.bindTemp(cv cv.ty "map"))
        def kv:RsExpr (this.lowerExpr((lhs.kid(1)) (cv.ty.arg(0))))
        out.line((this.mapSetLine(m cv.ty kv.code v.code)))
        return
      }
      def vec:string (this.bindTemp(cv cv.ty "vec"))
      def iv:RsExpr (this.lowerExpr((lhs.kid(1)) (RsType.mk("int"))))
      out.line(((((("set_at " + vec) + " ") + iv.code) + " ") + v.code))
      return
    }
    this.unsupported(lhs "this assignment target")
  }

  ; ------------------------------------------------- tuples, arrays, structs

  fn lowerTuple:RsExpr (n:RustNode expect:RsType) {
    if ((array_length n.kids) == 0) {
      return (this.unit())
    }
    def tt:RsType (RsType.mk("tuple"))
    def codes:[string]
    def i:int 0
    for n.kids e:RustNode j {
      def et:RsType (RsType.mk("unknown"))
      if (expect.kind == "tuple") {
        et = (expect.arg(i))
      }
      def v:RsExpr (this.lowerExprCopy(e et))
      def t:RsType et
      if (t.isUnknown()) {
        t = v.ty
      }
      def c:RsExpr (this.coerce(v t e))
      push codes c.code
      push tt.args t
      i = i + 1
    }
    def cname:string (this.tupleClass(tt))
    return (RsExpr.of((((("(new " + cname) + "(") + (join codes " ")) + "))") tt))
  }

  fn lowerArray:RsExpr (n:RustNode expect:RsType) {
    def et:RsType (RsType.mk("unknown"))
    if (expect.kind == "vec") {
      et = (expect.arg(0))
    }
    if (n.kind == "array_repeat") {
      def v:RsExpr (this.lowerExpr((n.kid(0)) et))
      def t:RsType et
      if (t.isUnknown()) {
        t = v.ty
      }
      def cnt:RsExpr (this.lowerExpr((n.kid(1)) (RsType.mk("int"))))
      def vt:RsType (RsType.of1("vec" t))
      def name:string (this.tmp("arr"))
      out.line(((("def " + name) + ":") + (this.rtype(vt))))
      def k:string (this.tmp("k"))
      out.line((("def " + k) + ":int 0"))
      out.line((((("while (" + k) + " < ") + cnt.code) + ") {"))
      out.line(((("  push " + name) + " ") + (this.cloneCode(v.code t))))
      out.line((((("  " + k) + " = (") + k) + " + 1)"))
      out.line("}")
      def r:RsExpr (RsExpr.of(name vt))
      r.simple = true
      return r
    }
    def codes:[string]
    def t2:RsType et
    for n.kids e:RustNode i {
      def v2:RsExpr (this.lowerExprCopy(e t2))
      if (t2.isUnknown()) {
        t2 = v2.ty
      }
      push codes v2.code
    }
    def vt2:RsType (RsType.of1("vec" t2))
    def rt:string (this.rtype(t2))
    if (rt == "") {
      if ((array_length codes) == 0) {
        this.err(n "an empty array needs its element type: annotate the `let`")
      }
      return (RsExpr.of((("([] " + (join codes " ")) + ")") vt2))
    }
    return (RsExpr.of((((("([] _:" + rt) + " (") + (join codes " ")) + "))") vt2))
  }

  fn lowerStructLit:RsExpr (n:RustNode) {
    def p:RustNode (n.kid(0))
    def name:string (this.lastSeg(p))
    if (name == "Self") {
      name = selfType
    }
    if ((false == (has structs name)) && ((array_length p.kids) >= 2)) {
      def en:string (itemAt (this.pathSegs(p)) ((array_length p.kids) - 2))
      if (en == "Self") {
        en = selfType
      }
      if (has enums en) {
        return (this.lowerVariantLit(n en name))
      }
    }
    if (false == (has structs name)) {
      this.err(n (("unknown struct `" + name) + "`"))
      return (this.unit())
    }
    def s:RsStruct (unwrap (get structs name))
    def st:RsType (RsType.named(name))
    if ((array_length s.generics) > 0) {
      if ((selfType == name) && ((array_length selfArgs) > 0)) {
        for selfArgs sa:RsType sai {
          push st.args sa
        }
      } {
        this.err(n (("a literal of the generic struct `" + name) + "` outside its impl"))
        return (this.unit())
      }
    }
    def cname:string (this.rtype(st))
    def tv:string (this.tmp("s"))
    def base:RustNode (n.kid(((array_length n.kids) - 1)))
    if ((false == (base.isNone())) && (base.kind != "field_init") && (base.kind != "default_rest")) {
      def bv:RsExpr (this.lowerExpr(base st))
      def bc:string (this.bindTemp(bv st "b"))
      out.line((((("def " + tv) + ":") + cname) + (" " + (this.cloneCode(bc st)))))
    } {
      out.line((((("def " + tv) + ":") + cname) + ((" (new " + cname) + ")")))
    }
    for n.kids fi:RustNode i {
      if (fi.kind != "field_init") {
        continue
      }
      def f@(optional):RsField (s.field(fi.name))
      if (null? f) {
        this.err(fi (((("no field `" + fi.name) + "` on `") + name) + "`"))
        continue
      }
      def ff0:RsField (unwrap f)
      def ff:RsField (new RsField())
      ff.name = ff0.name
      ff.ty = (this.fieldTypeOf(s ff0 st))
      def v:RsExpr (RsExpr.of("" ff.ty))
      if (fi.hasMod("shorthand")) {
        def pe:RustNode (new RustNode("path_expr"))
        def pp:RustNode (new RustNode("path"))
        def sg:RustNode (new RustNode("seg"))
        sg.name = fi.name
        pp.add(sg)
        pe.add(pp)
        pe.line = fi.line
        pe.col = fi.col
        v = (this.lowerExprCopy(pe ff.ty))
      } {
        v = (this.lowerExprCopy((fi.kid(0)) ff.ty))
      }
      def c:RsExpr (this.coerce(v ff.ty fi))
      if (c.code != "") {
        out.line(((((tv + ".") + (this.fieldName(fi.name))) + " = ") + c.code))
      }
    }
    def r:RsExpr (RsExpr.of(tv st))
    r.simple = true
    return r
  }

  ; `|a, b| body` as a value: a Ranger lambda. Parameter types come from the
  ; annotations or from the function type expected where it goes.
  fn lowerClosure:RsExpr (n:RustNode expect:RsType) {
    def ps:RustNode (n.kid(0))
    def retN:RustNode (n.kid(1))
    def body:RustNode (n.kid(2))
    def ptypes:[RsType]
    def i:int 0
    for ps.kids p:RustNode j {
      def pt:RsType (RsType.mk("unknown"))
      def tn:RustNode (p.kid(1))
      if (false == (tn.isNone())) {
        pt = (this.typeOf(tn))
      } {
        if ((expect.kind == "fn") && (i < ((array_length expect.args) - 1))) {
          pt = (expect.arg(i))
        }
      }
      if (pt.isUnknown()) {
        this.err(p "a closure parameter needs a type: annotate it or pass the closure where a function type is expected")
      }
      push ptypes pt
      i = i + 1
    }
    def ret:RsType (RsType.mk("unknown"))
    if (false == (retN.isNone())) {
      ret = (this.typeOf(retN))
    } {
      if (expect.kind == "fn") {
        ret = (expect.arg(((array_length expect.args) - 1)))
      }
    }
    ; the body is written with its own buffer and return type
    def saveOut:RustOut out
    def saveRet:RsType retType
    def saveLast:RsType lastReturn
    out = (new RustOut())
    out.ind = (saveOut.ind + "  ")
    this.pushScope()
    def decls:[string]
    def k:int 0
    for ps.kids p2:RustNode j2 {
      def pat:RustNode (this.stripRefPat((p2.kid(0))))
      def pty:RsType (itemAt ptypes k)
      if (pat.kind == "pat_ident") {
        def l:RsLocal (this.declare(pat.name pty))
        push decls (this.declText(l.rname pty))
      } {
        def an:string (this.allocLocal("arg"))
        push decls (this.declText(an pty))
        if (pat.kind != "pat_wild") {
          this.bindPattern(pat an pty)
        }
      }
      k = k + 1
    }
    retType = ret
    lastReturn = (RsType.mk("unknown"))
    if (body.kind == "block") {
      this.lowerBody(body ret)
      if (ret.isUnknown()) {
        ret = lastReturn
      }
    } {
      def v:RsExpr (this.lowerExpr(body ret))
      if (ret.isUnknown()) {
        ret = v.ty
      }
      if ((ret.kind == "unit") || (ret.kind == "never") || (ret.isUnknown())) {
        this.discard(v)
        if (ret.isUnknown()) {
          ret = (RsType.mk("unit"))
        }
      } {
        def c:RsExpr (this.coerce(v ret body))
        out.line(("return " + c.code))
      }
    }
    this.popScope()
    def lines:[string] out.lines
    out = saveOut
    retType = saveRet
    lastReturn = saveLast
    def rt:string (this.rtype(ret))
    if (rt == "") {
      rt = "void"
    }
    def ft:RsType (RsType.mk("fn"))
    for ptypes pt2:RsType m {
      push ft.args pt2
    }
    push ft.args ret
    def text:string ((((("(fn:" + rt) + " (") + (join decls " ")) + ") {\n") + (join lines "\n"))
    text = ((text + "\n") + out.ind) + "})"
    return (RsExpr.of(text ft))
  }

  def lastReturn:RsType (new RsType("unknown"))
  def lastEntry:RsExpr (new RsExpr())
  ; the Formatter parameter while a Display / Debug `fmt` is written
  def displayFormatter:string ""

  fn hasFmt:boolean (t:RsType traitName:string) {
    def ms:[RsFn]
    if (has structs t.name) {
      def s:RsStruct (unwrap (get structs t.name))
      ms = s.methods
    }
    if (has enums t.name) {
      def e:RsEnum (unwrap (get enums t.name))
      ms = e.methods
    }
    for ms m:RsFn i {
      if ((m.name == "fmt") && (m.fromTrait == traitName)) {
        return true
      }
    }
    return false
  }

  ; `a op b` for the arithmetic of a compound assignment.
  fn arith:string (op:string a:RsExpr b:RsExpr t:RsType) {
    if (op == "/") {
      if (t.kind == "double") {
        return (((("(" + a.code) + " / ") + b.code) + ")")
      }
      return (((("(rs_div " + a.code) + " ") + b.code) + ")")
    }
    if (op == "%") {
      return (((("(rs_rem " + a.code) + " ") + b.code) + ")")
    }
    return (((((("(" + a.code) + " ") + op) + " ") + b.code) + ")")
  }

  ; Applies a closure literal inline to values (iterator adaptors); a
  ; closure held in a variable or a fn name is called instead.
  fn applyClosure:RsExpr (f:RustNode args:[RsExpr] expect:RsType) {
    if (f.kind != "closure") {
      def fv:RsExpr (this.lowerExpr(f (RsType.mk("unknown"))))
      if (fv.ty.kind != "fn") {
        this.err(f "expected a closure or a function")
        return (this.unit())
      }
      def fname:string (this.bindTemp(fv fv.ty "fn"))
      def codes:[string]
      for args a:RsExpr i {
        push codes a.code
      }
      def rt:RsType (fv.ty.arg(((array_length fv.ty.args) - 1)))
      return (RsExpr.of((((("(" + fname) + "(") + (join codes " ")) + "))") rt))
    }
    def ps:RustNode (f.kid(0))
    this.pushScope()
    def i:int 0
    for ps.kids p:RustNode j {
      if (i >= (array_length args)) {
        continue
      }
      def a:RsExpr (itemAt args i)
      def pat:RustNode (this.stripRefPat((this.stripRefPat((p.kid(0))))))
      def at:RsType a.ty
      def tn:RustNode (p.kid(1))
      if ((false == (tn.isNone())) && (at.isUnknown())) {
        at = (this.typeOf(tn))
      }
      if (pat.kind == "pat_ident") {
        def code:string (this.bindTemp(a at "a"))
        this.alias(pat.name code at)
      } {
        if (pat.kind != "pat_wild") {
          def code2:string (this.bindTemp(a at "a"))
          this.bindPattern(pat code2 at)
        }
      }
      i = i + 1
    }
    def body:RustNode (f.kid(2))
    def v:RsExpr (this.lowerExpr(body expect))
    this.popScope()
    return v
  }

  ; Lowers `f(args)` / an expression into a separate buffer: its statements
  ; go in `lastCaptured` for the caller to place inside the branch that
  ; runs it.
  def lastCaptured:[string]
  def lastCapturedInd:string ""

  fn captureClosure:RsExpr (f:RustNode args:[RsExpr] expect:RsType) {
    def saveOut:RustOut out
    out = (new RustOut())
    out.ind = saveOut.ind
    def v:RsExpr (this.applyClosure(f args expect))
    lastCaptured = out.lines
    lastCapturedInd = saveOut.ind
    out = saveOut
    return v
  }

  fn captureExpr:RsExpr (e:RustNode expect:RsType) {
    def saveOut:RustOut out
    out = (new RustOut())
    out.ind = saveOut.ind
    def v:RsExpr (this.lowerExprCopy(e expect))
    lastCaptured = out.lines
    lastCapturedInd = saveOut.ind
    out = saveOut
    return v
  }

  ; The error type a Result is expected to carry, or unknown.
  fn resultErrOf:RsType (expect:RsType) {
    if (expect.kind == "result") {
      return (expect.arg(1))
    }
    return (RsType.mk("unknown"))
  }

  ; ------------------------------------------------------ iterator chains

  fn isIterConsumer:boolean (n:string) {
    def names:[string] ([] _:string ("collect" "sum" "product" "count" "max" "min" "max_by_key" "min_by_key" "max_by" "min_by" "any" "all" "position" "find" "fold" "for_each" "last" "next" "nth" "rposition" "find_map"))
    return ((indexOf names n) >= 0)
  }

  fn isIterAdapter:boolean (n:string) {
    def names:[string] ([] _:string ("map" "filter" "filter_map" "enumerate" "rev" "skip" "take" "cloned" "copied" "take_while" "skip_while" "step_by" "inspect" "map_while" "flat_map" "zip" "chain"))
    return ((indexOf names n) >= 0)
  }

  fn isIterSource:boolean (n:string) {
    def names:[string] ([] _:string ("iter" "into_iter" "iter_mut" "chars" "bytes" "keys" "values" "split" "lines" "split_whitespace" "char_indices"))
    return ((indexOf names n) >= 0)
  }

  ; A method chain that starts at an iterator source.
  fn isIterChain:boolean (n:RustNode) {
    def cur:RustNode n
    ; not `while true`: Java rejects the return after an endless loop
    def walking:boolean true
    while walking {
      if (cur.kind == "paren") {
        cur = (cur.kid(0))
        continue
      }
      if (cur.kind == "range") {
        return true
      }
      if (cur.kind != "method") {
        return false
      }
      if (this.isIterSource(cur.name)) {
        return true
      }
      if (false == (this.isIterAdapter(cur.name))) {
        return false
      }
      cur = (cur.kid(0))
    }
    return false
  }

  ; Lowers `source.adapter(…)….consumer(…)` to one loop.
  fn lowerIterChain:RsExpr (consumer:RustNode expect:RsType) {
    ; the adapters, source first
    def stages:[RustNode]
    def cur:RustNode (consumer.kid(0))
    while true {
      if (cur.kind == "paren") {
        cur = (cur.kid(0))
        continue
      }
      if ((cur.kind == "method") && (this.isIterAdapter(cur.name))) {
        push stages cur
        cur = (cur.kid(0))
        continue
      }
      break
    }
    def ordered:[RustNode]
    def si:int ((array_length stages) - 1)
    def rev:boolean false
    def step:string "1"
    while (si >= 0) {
      def st:RustNode (itemAt stages si)
      si = si - 1
      ; a reversal or step right after the source changes the walk itself
      if ((st.name == "rev") && ((array_length ordered) == 0)) {
        rev = true
        continue
      }
      if ((st.name == "step_by") && ((array_length ordered) == 0)) {
        def sv:RsExpr (this.lowerExpr((st.kid(2)) (RsType.mk("int"))))
        step = (this.bindTemp(sv (RsType.mk("int")) "step"))
        continue
      }
      push ordered st
    }
    ; the consumer's state
    def cname:string consumer.name
    def cargs:[RustNode] (this.callArgs(consumer 2))
    def res:string (this.tmp("it"))
    def elemT:RsType (RsType.mk("unknown"))
    ; walk
    def src:RsExpr (this.iterOpen(cur rev step))
    if (src.ty.kind == "never") {
      return (this.unit())
    }
    ; the stream element and its position (for enumerate / position)
    def e:RsExpr src
    def pos:string (this.tmp("pos"))
    ; declared before the loop: `iterOpen` emitted the loop header, so the
    ; state lines are collected here and placed ahead of it afterwards
    def body:RustOut out
    def pre:[string]
    def stateDecls:[string]
    for ordered ad:RustNode ai {
      def an:string ad.name
      def aargs:[RustNode] (this.callArgs(ad 2))
      if ((an == "map") || (an == "inspect")) {
        def mv:RsExpr (this.applyClosure((itemAt aargs 0) ([] _:RsExpr (e)) (RsType.mk("unknown"))))
        if (an == "inspect") {
          this.discard(mv)
          continue
        }
        def mn:string (this.tmp("m"))
        out.line(((("def " + (this.declText(mn mv.ty))) + " ") + mv.code))
        e = (RsExpr.of(mn mv.ty))
        e.simple = true
        continue
      }
      if ((an == "filter") || (an == "take_while") || (an == "skip_while")) {
        def fv:RsExpr (this.applyClosure((itemAt aargs 0) ([] _:RsExpr (e)) (RsType.mk("bool"))))
        if (an == "filter") {
          out.line((("if (! " + fv.code) + ") {"))
          out.line("  continue")
          out.line("}")
        }
        if (an == "take_while") {
          out.line((("if (! " + fv.code) + ") {"))
          out.line("  break")
          out.line("}")
        }
        if (an == "skip_while") {
          def sk:string (this.tmp("skipping"))
          push stateDecls (("def " + sk) + ":boolean true")
          out.line((((("if (" + sk) + " && ") + fv.code) + ") {"))
          out.line("  continue")
          out.line("}")
          out.line((sk + " = false"))
        }
        continue
      }
      if ((an == "filter_map") || (an == "map_while")) {
        def ov:RsExpr (this.applyClosure((itemAt aargs 0) ([] _:RsExpr (e)) (RsType.mk("unknown"))))
        def on:string (this.bindTemp(ov ov.ty "fm"))
        if (an == "filter_map") {
          out.line((("if (null? " + on) + ") {"))
          out.line("  continue")
          out.line("}")
        } {
          out.line((("if (null? " + on) + ") {"))
          out.line("  break")
          out.line("}")
        }
        def un:string (this.tmp("m"))
        out.line(((("def " + (this.declText(un (ov.ty.arg(0))))) + " (unwrap ") + on) + ")")
        e = (RsExpr.of(un (ov.ty.arg(0))))
        e.simple = true
        continue
      }
      if (an == "enumerate") {
        def cnt:string (this.tmp("n"))
        push stateDecls (("def " + cnt) + ":int 0")
        def pt:RsType (RsType.of2("tuple" (RsType.mk("int")) e.ty))
        def tn:string (this.tmp("p"))
        out.line(((((((("def " + (this.declText(tn pt))) + " (new ") + (this.tupleClass(pt))) + "(") + cnt) + " ") + e.code) + "))")
        out.line((((cnt + " = (") + cnt) + " + 1)"))
        e = (RsExpr.of(tn pt))
        e.simple = true
        continue
      }
      if ((an == "skip") || (an == "take")) {
        def nv:RsExpr (this.lowerExpr((itemAt aargs 0) (RsType.mk("int"))))
        def c2:string (this.tmp(an))
        push stateDecls (("def " + c2) + ":int 0")
        if (an == "skip") {
          out.line((((("if (" + c2) + " < ") + nv.code) + ") {"))
          out.line((((("  " + c2) + " = (") + c2) + " + 1)"))
          out.line("  continue")
          out.line("}")
        } {
          out.line((((("if (" + c2) + " >= ") + nv.code) + ") {"))
          out.line("  break")
          out.line("}")
          out.line((((c2 + " = (") + c2) + " + 1)"))
        }
        continue
      }
      if ((an == "cloned") || (an == "copied")) {
        if ((e.ty.kind == "named") || (e.ty.kind == "vec") || (e.ty.kind == "tuple")) {
          def cn:string (this.tmp("m"))
          out.line(((("def " + (this.declText(cn e.ty))) + " ") + (this.cloneCode(e.code e.ty))))
          e = (RsExpr.of(cn e.ty))
          e.simple = true
        }
        continue
      }
      this.unsupported(ad (("the iterator adaptor `" + an) + "`"))
    }
    ; the consumer
    def result:RsExpr (this.iterConsume(cname cargs e res pos expect consumer stateDecls))
    this.iterClose()
    ; hoist the state declarations to before the loop
    this.insertBeforeLoop(stateDecls)
    return result
  }

  ; The state lines of a chain go before its loop, whose header iterOpen
  ; wrote at `loopStart`.
  def loopStart:int 0

  fn insertBeforeLoop:void (decls:[string]) {
    if ((array_length decls) == 0) {
      return
    }
    def lines:[string]
    def i:int 0
    for out.lines l:string j {
      if (i == loopStart) {
        for decls d:string k {
          push lines (loopInd + d)
        }
      }
      push lines l
      i = i + 1
    }
    out.lines = lines
  }

  def loopInd:string ""

  ; Opens the loop of an iterator source; answers the element. The loop's
  ; state is declared before the header; the body follows.
  fn iterOpen:RsExpr (src0:RustNode rev:boolean step:string) {
    def src:RustNode src0
    while (src.kind == "paren") {
      src = (src.kid(0))
    }
    def idx:string (this.tmp("k"))
    def n:string (this.tmp("len"))
    if (src.kind == "range") {
      def lo:RustNode (src.kid(0))
      def hi:RustNode (src.kid(1))
      if (lo.isNone() || hi.isNone()) {
        this.unsupported(src "an open range as an iterator")
        return (RsExpr.of("" (RsType.mk("never"))))
      }
      def lv:RsExpr (this.lowerExpr(lo (RsType.mk("int"))))
      def hv:RsExpr (this.lowerExpr(hi (RsType.mk("int"))))
      def incl:boolean (src.name == "..=")
      def end:string (this.tmp("end"))
      loopInd = out.ind
      if (rev) {
        if (incl) {
          out.line((((("def " + idx) + ":int ") + hv.code)))
        } {
          out.line((((("def " + idx) + ":int (") + hv.code) + " - 1)"))
        }
        out.line((((("def " + end) + ":int ") + lv.code)))
        loopStart = (array_length out.lines)
        out.line((((("while (" + idx) + " >= ") + end) + ") {"))
      } {
        out.line((((("def " + idx) + ":int ") + lv.code)))
        out.line((((("def " + end) + ":int ") + hv.code)))
        loopStart = (array_length out.lines)
        def op:string " < "
        if (incl) {
          op = " <= "
        }
        out.line((((("while (" + idx) + op) + end) + ") {"))
      }
      out.indent()
      def cur:string (this.tmp("at"))
      out.line(((("def " + cur) + ":int ") + idx))
      if (rev) {
        out.line((((((idx + " = (") + idx) + " - ") + step) + ")"))
      } {
        out.line((((((idx + " = (") + idx) + " + ") + step) + ")"))
      }
      def r:RsExpr (RsExpr.of(cur (RsType.mk("int"))))
      r.simple = true
      return r
    }
    ; a collection or string source
    def mode:string "vec"
    def base:RustNode src
    if (src.kind == "method") {
      def mn:string src.name
      if ((mn == "iter") || (mn == "into_iter") || (mn == "iter_mut")) {
        base = (src.kid(0))
      }
      if ((mn == "chars") || (mn == "bytes") || (mn == "keys") || (mn == "values") || (mn == "char_indices")) {
        base = (src.kid(0))
        mode = mn
      }
    }
    while ((base.kind == "unary") && ((base.name == "&") || (base.name == "&mut"))) {
      base = (base.kid(0))
    }
    def bv:RsExpr (this.lowerExpr(base (RsType.mk("unknown"))))
    def bt:RsType bv.ty
    def seq:string ""
    def elemT:RsType (RsType.mk("unknown"))
    def elemCode:string ""
    def cur2:string (this.tmp("at"))
    def isMap:boolean ((bt.kind == "map") || (bt.kind == "set"))
    if ((mode == "chars") || (mode == "char_indices")) {
      seq = (this.tmp("cs"))
      out.line((((("def " + seq) + ":[int] (to_chars ") + bv.code) + ")"))
      elemT = (RsType.mk("char"))
      elemCode = (((("(rs_char_from (itemAt " + seq) + " ") + cur2) + "))")
    } {
      if (mode == "bytes") {
        seq = (this.tmp("bs"))
        out.line((((("def " + seq) + ":charbuffer (to_charbuffer ") + bv.code) + ")"))
        elemT = (RsType.mk("int"))
        elemCode = (((("(charAt " + seq) + " ") + cur2) + ")")
      } {
        if (isMap) {
          def m:string (this.bindTemp(bv bt "map"))
          seq = (this.tmp("ks"))
          out.line((((("def " + seq) + ":[") + (this.rtype((bt.arg(0))))) + "] ") + (this.mapKeysCode(m bt)))
          if (bt.name == "sorted") {
            this.sortStrings(seq (bt.arg(0)))
          }
          if ((mode == "keys") || (bt.kind == "set")) {
            elemT = (bt.arg(0))
            elemCode = (((("(itemAt " + seq) + " ") + cur2) + ")")
          } {
            if (mode == "values") {
              elemT = (bt.arg(1))
              elemCode = (((("(unwrap (get " + (this.mapR(m bt))) + " (itemAt ") + seq) + ((" " + cur2) + ")))"))
            } {
              mode = "pairs"
              elemT = (RsType.of2("tuple" (bt.arg(0)) (bt.arg(1))))
              def kc:string (((("(itemAt " + seq) + " ") + cur2) + ")")
              elemCode = ((((((("(new " + (this.tupleClass(elemT))) + "(") + kc) + " (unwrap (get ") + (this.mapR(m bt))) + " ") + kc) + "))))")
            }
          }
        } {
          if (bt.kind != "vec") {
            this.err(src0 (("cannot iterate a value of type `" + (bt.rust())) + "`"))
            return (RsExpr.of("" (RsType.mk("never"))))
          }
          seq = (this.bindTemp(bv bt "seq"))
          elemT = (bt.arg(0))
          elemCode = (((("(itemAt " + seq) + " ") + cur2) + ")")
        }
      }
    }
    loopInd = out.ind
    if (mode == "bytes") {
      out.line((((("def " + n) + ":int (length ") + seq) + ")"))
    } {
      out.line((((("def " + n) + ":int (array_length ") + seq) + ")"))
    }
    if (rev) {
      out.line((((("def " + idx) + ":int (") + n) + " - 1)"))
      loopStart = (array_length out.lines)
      out.line((("while (" + idx) + " >= 0) {"))
    } {
      out.line((("def " + idx) + ":int 0"))
      loopStart = (array_length out.lines)
      out.line((((("while (" + idx) + " < ") + n) + ") {"))
    }
    out.indent()
    out.line(((("def " + cur2) + ":int ") + idx))
    if (rev) {
      out.line((((((idx + " = (") + idx) + " - ") + step) + ")"))
    } {
      out.line((((((idx + " = (") + idx) + " + ") + step) + ")"))
    }
    def en:string (this.tmp("e"))
    out.line(((("def " + (this.declText(en elemT))) + " ") + elemCode))
    if (mode == "char_indices") {
      ; (byte offset, char)
      def bo:string (this.tmp("bo"))
      out.line((((((("def " + bo) + ":int (rs_byte_len (RsStr.codeSlice(") + bv.code) + " 0 ") + cur2) + ")))"))
      def pt:RsType (RsType.of2("tuple" (RsType.mk("int")) (RsType.mk("char"))))
      def pn:string (this.tmp("p"))
      out.line(((((((("def " + (this.declText(pn pt))) + " (new ") + (this.tupleClass(pt))) + "(") + bo) + " ") + en) + "))"))
      def rp:RsExpr (RsExpr.of(pn pt))
      rp.simple = true
      return rp
    }
    def r2:RsExpr (RsExpr.of(en elemT))
    r2.simple = true
    return r2
  }

  fn iterClose:void () {
    out.dedent()
    out.line("}")
  }

  ; The consumer of a chain, inside the loop; answers the result.
  fn iterConsume:RsExpr (name:string args:[RustNode] e:RsExpr res:string pos:string expect:RsType at:RustNode decls:[string]) {
    def it:RsType (RsType.mk("int"))
    def bt:RsType (RsType.mk("bool"))
    def et:RsType e.ty
    if (name == "collect") {
      def target:RsType expect
      def ta:RustNode (at.kid(1))
      if ((array_length ta.kids) > 0) {
        target = (this.typeOf((ta.kid(0))))
      }
      if ((target.kind == "string")) {
        push decls (("def " + res) + ":string \"\"")
        out.line(((((res + " = (") + res) + " + ") + e.code) + ")"))
        return (this.simpleExpr(res target))
      }
      if ((target.kind == "map") || (target.kind == "set")) {
        push decls (((("def " + res) + ":") + (this.rtype(target))) + (this.initSuffix(target)))
        if (target.kind == "set") {
          out.line(((("set " + res) + " ") + e.code) + " true")
        } {
          out.line((this.mapSetLine(res target (e.code + ".f0") (e.code + ".f1"))))
        }
        return (this.simpleExpr(res target))
      }
      if ((target.kind != "vec") || ((target.arg(0)).isUnknown())) {
        target = (RsType.of1("vec" et))
      }
      push decls ((("def " + res) + ":") + (this.rtype(target)))
      out.line(((("push " + res) + " ") + e.code))
      return (this.simpleExpr(res target))
    }
    if ((name == "sum") || (name == "product")) {
      def t:RsType et
      if (false == (expect.isUnknown())) {
        t = expect
      }
      def ta2:RustNode (at.kid(1))
      if ((array_length ta2.kids) > 0) {
        t = (this.typeOf((ta2.kid(0))))
      }
      def init:string "0"
      if (t.kind == "double") {
        init = "0.0"
      }
      if (name == "product") {
        init = "1"
        if (t.kind == "double") {
          init = "1.0"
        }
      }
      push decls (((("def " + res) + ":") + (this.rtype(t))) + (" " + init))
      def op:string " + "
      if (name == "product") {
        op = " * "
      }
      out.line(((((res + " = (") + res) + op) + e.code) + ")"))
      return (this.simpleExpr(res t))
    }
    if (name == "count") {
      push decls (("def " + res) + ":int 0")
      out.line((((res + " = (") + res) + " + 1)"))
      return (this.simpleExpr(res it))
    }
    if ((name == "max") || (name == "min") || (name == "last")) {
      def ot:RsType (RsType.of1("opt" et))
      push decls ("def " + (this.declText(res ot)))
      def ec:string e.code
      if (name == "last") {
        out.line(((res + " = ") + ec))
      } {
        ; max keeps the last of equal elements, min the first
        def cmp:string " >= "
        if (name == "min") {
          cmp = " < "
        }
        out.line((((((("if ((null? " + res) + ") || (") + ec) + cmp) + ("(unwrap " + res)) + "))) {"))
        out.line((((("  " + res) + " = ") + ec)))
        out.line("}")
      }
      return (this.simpleExpr(res ot))
    }
    if ((name == "max_by_key") || (name == "min_by_key")) {
      def ot2:RsType (RsType.of1("opt" et))
      push decls ("def " + (this.declText(res ot2)))
      def kv:RsExpr (this.applyClosure((itemAt args 0) ([] _:RsExpr (e)) (RsType.mk("unknown"))))
      def best:string (this.tmp("bk"))
      push decls ((("def " + best) + ":") + ((this.rtype(kv.ty)) + (" " + (this.zeroCode(kv.ty)))))
      def kn:string (this.bindTemp(kv kv.ty "kv"))
      def cmp2:string " >= "
      if (name == "min_by_key") {
        cmp2 = " < "
      }
      out.line((((((("if ((null? " + res) + ") || (") + kn) + cmp2) + best) + ")) {"))
      out.line(((("  " + res) + " = ") + e.code))
      out.line(((("  " + best) + " = ") + kn))
      out.line("}")
      return (this.simpleExpr(res ot2))
    }
    if ((name == "any") || (name == "all")) {
      def init2:string "false"
      if (name == "all") {
        init2 = "true"
      }
      push decls ((("def " + res) + ":boolean ") + init2)
      def pv:RsExpr (this.applyClosure((itemAt args 0) ([] _:RsExpr (e)) bt))
      if (name == "any") {
        out.line((("if " + (this.condText(pv.code))) + " {"))
        out.line((("  " + res) + " = true"))
      } {
        out.line((("if (! " + pv.code) + ") {"))
        out.line((("  " + res) + " = false"))
      }
      out.line("  break")
      out.line("}")
      return (this.simpleExpr(res bt))
    }
    if ((name == "position") || (name == "find") || (name == "find_map")) {
      def rt:RsType et
      if (name == "position") {
        rt = it
        push decls (("def " + pos) + ":int 0")
      }
      def ot3:RsType (RsType.of1("opt" rt))
      push decls ("def " + (this.declText(res ot3)))
      if (name == "find_map") {
        def fm:RsExpr (this.applyClosure((itemAt args 0) ([] _:RsExpr (e)) (RsType.mk("unknown"))))
        def fmn:string (this.bindTemp(fm fm.ty "fm"))
        out.line((("if (!null? " + fmn) + ") {"))
        out.line(((("  " + res) + " = (unwrap ") + fmn) + ")")
        out.line("  break")
        out.line("}")
        return (this.simpleExpr(res fm.ty))
      }
      def pv2:RsExpr (this.applyClosure((itemAt args 0) ([] _:RsExpr (e)) bt))
      out.line((("if " + (this.condText(pv2.code))) + " {"))
      if (name == "position") {
        out.line(((("  " + res) + " = ") + pos))
      } {
        out.line(((("  " + res) + " = ") + e.code))
      }
      out.line("  break")
      out.line("}")
      if (name == "position") {
        out.line((((pos + " = (") + pos) + " + 1)"))
      }
      return (this.simpleExpr(res ot3))
    }
    if (name == "fold") {
      def iv:RsExpr (this.lowerExpr((itemAt args 0) expect))
      def ft:RsType iv.ty
      if (false == (expect.isUnknown())) {
        ft = expect
      }
      push decls ((("def " + (this.declText(res ft))) + " ") + iv.code)
      def accE:RsExpr (this.simpleExpr(res ft))
      def fv:RsExpr (this.applyClosure((itemAt args 1) ([] _:RsExpr (accE e)) ft))
      out.line(((res + " = ") + fv.code))
      return (this.simpleExpr(res ft))
    }
    if (name == "__for") {
      ; `for pat in <chain> { body }`: the body runs where the element is
      def fp:RustNode (unwrap forPat)
      def fb:RustNode (unwrap forBody)
      def saveStart:int loopStart
      def saveInd:string loopInd
      this.pushScope()
      this.bindForPattern(fp e.code e.ty)
      this.pushLoop("" "")
      this.lowerLoopBody(fb)
      this.popLoop()
      this.popScope()
      loopStart = saveStart
      loopInd = saveInd
      return (this.unit())
    }
    if (name == "for_each") {
      def bv:RsExpr (this.applyClosure((itemAt args 0) ([] _:RsExpr (e)) (RsType.mk("unit"))))
      this.discard(bv)
      return (this.unit())
    }
    if ((name == "next") || (name == "nth")) {
      def ot4:RsType (RsType.of1("opt" et))
      push decls ("def " + (this.declText(res ot4)))
      if (name == "nth") {
        def nv:RsExpr (this.lowerExpr((itemAt args 0) it))
        def cnt:string (this.tmp("nth"))
        push decls (("def " + cnt) + ":int 0")
        out.line((((("if (" + cnt) + " == ") + nv.code) + ") {"))
        out.line(((("  " + res) + " = ") + e.code))
        out.line("  break")
        out.line("}")
        out.line((((cnt + " = (") + cnt) + " + 1)"))
      } {
        out.line(((res + " = ") + e.code))
        out.line("break")
      }
      return (this.simpleExpr(res ot4))
    }
    this.unsupported(at (("the iterator consumer `" + name) + "`"))
    return (this.unit())
  }

  fn simpleExpr:RsExpr (code:string t:RsType) {
    def r:RsExpr (RsExpr.of(code t))
    r.simple = true
    return r
  }

  ; ---------------------------------------------------------------- sorting

  ; A Ranger comparator lambda for `sort_by(|a, b| …)` (an Ordering, which
  ; is an int -1 / 0 / 1 here) or `sort_by_key(|x| key)`.
  fn comparatorLambda:string (f:RustNode et:RsType keyed:boolean) {
    def saveOut:RustOut out
    out = (new RustOut())
    out.ind = (saveOut.ind + "  ")
    this.pushScope()
    def an:string (this.allocLocal("a"))
    def bn:string (this.allocLocal("b"))
    def ae:RsExpr (this.simpleExpr(an et))
    def be:RsExpr (this.simpleExpr(bn et))
    if (keyed) {
      def ka:RsExpr (this.applyClosure(f ([] _:RsExpr (ae)) (RsType.mk("unknown"))))
      def kan:string (this.bindTemp(ka ka.ty "ka"))
      def kb:RsExpr (this.applyClosure(f ([] _:RsExpr (be)) (RsType.mk("unknown"))))
      def kbn:string (this.bindTemp(kb kb.ty "kb"))
      out.line(("return " + (this.cmpCode(kan kbn ka.ty))))
    } {
      def r:RsExpr (this.applyClosure(f ([] _:RsExpr (ae be)) (RsType.mk("int"))))
      out.line(("return " + r.code))
    }
    this.popScope()
    def lines:[string] out.lines
    out = saveOut
    def rt:string (this.rtype(et))
    return ((((((((("(fn:int (" + an) + ":") + rt) + " ") + bn) + ":") + rt) + ") {\n") + (join lines "\n")) + (("\n" + out.ind) + "})"))
  }

  fn comparatorFromMethod:string (et:RsType) {
    def rt:string (this.rtype(et))
    return (((((("(fn:int (a:" + rt) + " b:") + rt) + ") {\n") + out.ind) + (("  return (a.cmp(b))\n" + out.ind) + "})"))
  }

  ; -1 / 0 / 1 comparing two values of a numeric or string type.
  fn cmpCode:string (a:string b:string t:RsType) {
    if ((t.kind == "named") && (has structs t.name)) {
      def sc:string (this.structCmp(a b t))
      if (sc != "") {
        return sc
      }
      return (((("(" + a) + ".cmp(") + b) + "))")
    }
    if ((t.kind == "string") || (t.kind == "char")) {
      return (((("(rs_str_cmp " + a) + " ") + b) + ")")
    }
    return (((((((("(? (" + a) + " < ") + b) + ") -1 (? (") + a) + " > ") + b) + ") 1 0))")
  }

  ; After a Vec method that re-created the array (`sort`, `dedup`): store
  ; it back where the Vec came from when that was not a plain local.
  fn writeBack:void (call:RustNode v:string t:RsType) {
    def recvN:RustNode (call.kid(0))
    if ((recvN.kind == "path_expr") || (recvN.kind == "unary")) {
      def inner:RustNode recvN
      while ((inner.kind == "unary") && ((inner.name == "&mut") || (inner.name == "*"))) {
        inner = (inner.kid(0))
      }
      if (inner.kind == "path_expr") {
        def l:RsExpr (this.placeType(inner))
        if (l.code != v) {
          this.assignTo(inner (this.simpleExpr(v t)))
        }
        return
      }
    }
    if ((recvN.kind == "field") || (recvN.kind == "index")) {
      this.assignTo(recvN (this.simpleExpr(v t)))
    }
  }

  ; `e?`: on an Err (or None) return it from the enclosing function, else
  ; the value.
  fn lowerTry:RsExpr (n:RustNode expect:RsType) {
    def inner:RustNode (n.kid(0))
    if ((inner.kind == "macro_call") && ((inner.name == "write") || (inner.name == "writeln"))) {
      this.lowerMacroStmt(inner)
      return (this.unit())
    }
    def v:RsExpr (this.lowerExpr(inner (RsType.mk("unknown"))))
    def t:RsType v.ty
    if (t.kind == "result") {
      def r:string (this.bindTemp(v t "q"))
      if (retType.kind != "result") {
        this.err(n "`?` on a Result inside a function that does not return a Result")
        return (this.unit())
      }
      out.line((("if (! " + r) + ".ok) {"))
      out.indent()
      def cls:string (this.resultClass(retType))
      def back:string (this.tmp("err"))
      out.line((((("def " + back) + ":") + cls) + ((" (new " + cls) + ")")))
      def et:RsType (retType.arg(1))
      if ((et.kind != "unit") && (false == (et.isUnknown()))) {
        out.line((((back + ".e = ") + r) + ".e"))
      }
      out.line(("return " + back))
      out.dedent()
      out.line("}")
      if ((t.arg(0)).kind == "unit") {
        return (this.unit())
      }
      return (this.simpleExpr((r + ".v") (t.arg(0))))
    }
    if (t.kind == "opt") {
      def o:string (this.bindTemp(v t "q"))
      if (retType.kind != "opt") {
        this.err(n "`?` on an Option inside a function that does not return an Option")
        return (this.unit())
      }
      out.line((("if (null? " + o) + ") {"))
      def none:string (this.tmp("none"))
      out.line(("  def " + (this.declText(none retType))))
      out.line(("  return " + none))
      out.line("}")
      return (RsExpr.of((("(unwrap " + o) + ")") (t.arg(0))))
    }
    this.err(n "`?` needs a Result or an Option")
    return (this.unit())
  }

  ; ------------------------------------------------------------------ macros

  ; println! and friends: true when handled as a statement.
  ; `ranger::native!(rust: expr, es6: "…{x}…", python: "…", …)` (R7): the
  ; arm of the target being written, as an operator of this file. `{x}` is
  ; the Rust local or parameter `x`, `{{` / `}}` a brace; the result type is
  ; the one the context expects (`let n: int = native!(…)`), or none.
  fn lowerNative:RsExpr (m:RustNode expect:RsType) {
    def p:RustParser (new RustParser(m.value))
    def arms:RustNode (p.parseNativeArms())
    for p.errors pe:string pi {
      this.err(m ("in native!: " + pe))
    }
    def want:string target
    if (want == "typescript") {
      want = "es6"
    }
    def code:string ""
    def found:boolean false
    def listed:[string]
    for arms.kids arm:RustNode ai {
      def an:string (RustLower.targetAlias(arm.name))
      push listed an
      if ((an == want) && (arm.kind == "native_arm")) {
        def ex:RustNode (arm.kid(0))
        if ((ex.kind != "lit") || (false == (ex.hasMod("str")))) {
          this.err(arm (("the `" + arm.name) + "` arm of native! must be a string literal of target code"))
          return (this.unit())
        }
        code = ex.value
        found = true
      }
    }
    if (false == found) {
      this.err(m (((("native! has no arm for the target `" + want) + "` (it has ") + (join listed ", ")) + ")"))
      return (this.unit())
    }
    ; the pieces of the template and the locals it reads
    def pieces:[string]
    def names:[string]
    def cur:string ""
    def i:int 0
    def n:int (strlen code)
    while (i < n) {
      def c:string (substring code i (i + 1))
      if ((c == "{") && ((i + 1) < n) && ((substring code (i + 1) (i + 2)) == "{")) {
        cur = cur + "{"
        i = i + 2
        continue
      }
      if ((c == "}") && ((i + 1) < n) && ((substring code (i + 1) (i + 2)) == "}")) {
        cur = cur + "}"
        i = i + 2
        continue
      }
      if (c == "{") {
        def close:int (indexOf (substring code i n) "}")
        if (close < 0) {
          this.err(m "native!: an unclosed `{` in the target code (write `{{` for a brace)")
          return (this.unit())
        }
        push pieces cur
        cur = ""
        push names (trim (substring code (i + 1) (i + close)))
        i = i + close + 1
        continue
      }
      cur = cur + c
      i = i + 1
    }
    push pieces cur
    ; the arguments, in order
    def argCodes:[string]
    def argTypes:[RsType]
    for names nm:string ni {
      def l@(optional):RsLocal (scope.lookup(nm))
      if (null? l) {
        this.err(m (("native!: `{" + nm) + "}` is not a local or a parameter"))
        return (this.unit())
      }
      def lv:RsLocal (unwrap l)
      push argCodes lv.rname
      push argTypes lv.ty
    }
    nativeN = nativeN + 1
    def op:string ("rs_native_" + (to_string nativeN))
    def rt:RsType expect
    if (rt.isUnknown()) {
      rt = (RsType.mk("unit"))
    }
    def rts:string (this.rtype(rt))
    if (rt.kind == "unit") {
      rts = "void"
    }
    def params:[string]
    def k:int 0
    for argTypes at:RsType ati {
      push params (this.declText(("a" + (to_string k)) at))
      k = k + 1
    }
    def tpl:[string]
    def pk:int 0
    while (pk < (array_length pieces)) {
      push tpl (this.rangerString((itemAt pieces pk)))
      if (pk < (array_length names)) {
        push tpl (("(e " + (to_string (pk + 1))) + ")")
      }
      pk = pk + 1
    }
    def tplText:string (join tpl " ")
    def tgt:string want
    if (tgt == "") {
      tgt = "*"
    }
    push genOut (((((((((("operators {\n  " + op) + " _:") + rts) + " (") + (join params " ")) + ") {\n    templates {\n      ") + tgt) + " ( ") + tplText) + (" )\n      * ( " + (tplText + " )\n    }\n  }\n}")))
    def call:string op
    if ((array_length argCodes) > 0) {
      call = (op + " ") + (join argCodes " ")
    }
    if (rt.kind == "unit") {
      return (RsExpr.of(call rt))
    }
    return (RsExpr.of((("(" + call) + ")") rt))
  }

  ; ------------------------------------------------ #[ranger::serialize] (R7)

  ; `s.to_json()` and `S::from_json(text)`, known to the type checker; the
  ; bodies are written by emitJson, the same as the prelude crate's macro
  ; (runtime/rust/ranger/macros) builds them for rustc.
  fn addSerializeMethods:void (s:RsStruct) {
    if ((array_length s.generics) > 0) {
      this.err((unwrap s.node) "#[ranger::serialize] on a generic struct")
      return
    }
    s.serialize = true
    def tj:RsFn (new RsFn())
    tj.name = "to_json"
    tj.rname = "to_json"
    tj.owner = s.name
    tj.hasSelf = true
    tj.hasBody = false
    tj.ret = (this.ownedString())
    push s.methods tj
    def fj:RsFn (new RsFn())
    fj.name = "from_json"
    fj.rname = "from_json"
    fj.owner = s.name
    fj.hasBody = false
    def tp:RsParam (new RsParam())
    tp.name = "text"
    tp.ty = (RsType.mk("string"))
    push fj.params tp
    fj.ret = (RsType.of2("result" (RsType.named(s.name)) (this.ownedString())))
    push s.methods fj
  }

  fn jsonTmp:string (base:string) {
    jsonN = jsonN + 1
    return (("rs__j" + base) + (to_string jsonN))
  }

  fn emitJson:string (s:RsStruct cname:string) {
    def st:RsType (RsType.named(s.name))
    def rcls:string (this.resultClass((RsType.of2("result" st (this.ownedString())))))
    def lines:[string]
    push lines "  fn to_json:string () {"
    push lines "    def o:string \"{\""
    def first:boolean true
    for s.fields f:RsField fi {
      def key:string (this.rangerString((("\"" + f.name) + "\":")))
      if (false == first) {
        key = (this.rangerString(((",\"" + f.name) + "\":")))
      }
      first = false
      push lines (("    o = (o + " + key) + ")")
      this.jsonWrite(("this." + (this.fieldName(f.name))) f.ty lines "    ")
    }
    push lines "    return (o + \"}\")"
    push lines "  }"
    push lines ((("  sfn from_json:" + rcls) + " (text:string) {"))
    push lines "    def p:RsJsonParser (new RsJsonParser(text))"
    push lines "    def v:RsJsonValue (p.parse())"
    push lines "    if p.failed {"
    push lines ((("      def r:" + rcls) + " (new ") + (rcls + ")"))
    push lines "      r.e = p.err"
    push lines "      return r"
    push lines "    }"
    push lines (("    return (" + cname) + ".rs_from_json_value(v))")
    push lines "  }"
    push lines ((("  sfn rs_from_json_value:" + rcls) + " (v:RsJsonValue) {"))
    push lines ((("    def r:" + rcls) + " (new ") + (rcls + ")"))
    push lines "    if (v.kind != \"obj\") {"
    push lines "      r.e = \"expected an object\""
    push lines "      return r"
    push lines "    }"
    push lines ((("    def obj:" + cname) + " (new ") + (cname + ")"))
    for s.fields f2:RsField fi2 {
      def fv:string (this.jsonTmp("f"))
      push lines (((("    def " + fv) + "@(optional):RsJsonValue (v.field(") + (this.rangerString(f2.name))) + "))")
      push lines (("    if (null? " + fv) + ") {")
      push lines (("      r.e = " + (this.rangerString((("missing field `" + f2.name) + "`")))))
      push lines "      return r"
      push lines "    }"
      def fu:string (this.jsonTmp("u"))
      push lines (((("    def " + fu) + ":RsJsonValue (unwrap ") + fv) + ")")
      this.jsonRead(fu f2.ty ("obj." + (this.fieldName(f2.name))) (this.rangerString((("field `" + f2.name) + "`: "))) lines "    ")
    }
    push lines "    r.ok = true"
    push lines "    r.v = obj"
    push lines "    return r"
    push lines "  }"
    return (join lines "\n")
  }

  ; Statements that add the JSON text of `e` (of type t) to `o`.
  fn jsonWrite:void (e:string t:RsType lines:[string] ind:string) {
    def k:string t.kind
    if (k == "int") {
      push lines (((ind + "o = (o + (to_string ") + e) + "))")
      return
    }
    if (k == "double") {
      push lines (((ind + "o = (o + (RsJson.num(") + e) + ")))")
      return
    }
    if (k == "bool") {
      push lines (((ind + "o = (o + (? ") + e) + " \"true\" \"false\"))")
      return
    }
    if (k == "string") {
      push lines (((ind + "o = (o + (RsJson.quote(") + e) + ")))")
      return
    }
    if ((k == "named") && (has structs t.name)) {
      def ns:RsStruct (unwrap (get structs t.name))
      if ns.serialize {
        def nt:string (this.jsonTmp("n"))
        push lines ((((ind + "def ") + nt) + ":") + (((this.rtype(t)) + " ") + e))
        push lines (((ind + "o = (o + (") + nt) + ".to_json()))")
        return
      }
    }
    if (k == "vec") {
      def et:RsType (t.arg(0))
      def ev:string (this.jsonTmp("e"))
      def iv:string (this.jsonTmp("i"))
      push lines (ind + "o = (o + \"[\")")
      push lines (((((((ind + "for ") + e) + " ") + ev) + ":") + (this.rtype(et))) + ((" " + iv) + " {"))
      push lines (((ind + "  if (") + iv) + " > 0) {")
      push lines (ind + "    o = (o + \",\")")
      push lines (ind + "  }")
      this.jsonWrite(ev et lines (ind + "  "))
      push lines (ind + "}")
      push lines (ind + "o = (o + \"]\")")
      return
    }
    if (k == "opt") {
      def it:RsType (t.arg(0))
      push lines (((ind + "if (null? ") + e) + ") {")
      push lines (ind + "  o = (o + \"null\")")
      push lines (ind + "} {")
      def uv:string (this.jsonTmp("o"))
      push lines ((((((ind + "  def ") + uv) + ":") + (this.rtype(it))) + " (unwrap ") + (e + ")"))
      this.jsonWrite(uv it lines (ind + "  "))
      push lines (ind + "}")
      return
    }
    this.err((new RustNode("none")) (("#[ranger::serialize]: a field of type `" + (t.rust())) + "` (i64, f64, bool, String, Vec, Option and serialized structs are)"))
  }

  ; Statements that read the JSON value `j` into `target` (of type t); an
  ; error returns `r` with the message after `prefix` (a Ranger expression).
  fn jsonRead:void (j:string t:RsType target:string prefix:string lines:[string] ind:string) {
    def k:string t.kind
    if (k == "int") {
      push lines ((((((ind + "if ((") + j) + ".kind != \"num\") || (RsJson.hasFrac(") + j) + ".text)) || (false == (RsJson.intOk(") + (j + ".text)))) {"))
      push lines ((((ind + "  r.e = (") + prefix) + " + \"expected an integer\")"))
      push lines (ind + "  return r")
      push lines (ind + "}")
      push lines (((((ind + target) + " = (RsJson.toInt(") + j) + ".text))"))
      return
    }
    if (k == "double") {
      push lines ((((ind + "if (") + j) + ".kind != \"num\") {"))
      push lines ((((ind + "  r.e = (") + prefix) + " + \"expected a number\")"))
      push lines (ind + "  return r")
      push lines (ind + "}")
      push lines (((((ind + target) + " = (RsJson.toDouble(") + j) + ".text))"))
      return
    }
    if (k == "bool") {
      push lines ((((ind + "if (") + j) + ".kind != \"bool\") {"))
      push lines ((((ind + "  r.e = (") + prefix) + " + \"expected a boolean\")"))
      push lines (ind + "  return r")
      push lines (ind + "}")
      push lines ((((ind + target) + " = ") + j) + ".b")
      return
    }
    if (k == "string") {
      push lines ((((ind + "if (") + j) + ".kind != \"str\") {"))
      push lines ((((ind + "  r.e = (") + prefix) + " + \"expected a string\")"))
      push lines (ind + "  return r")
      push lines (ind + "}")
      push lines ((((ind + target) + " = ") + j) + ".text")
      return
    }
    if ((k == "named") && (has structs t.name)) {
      def ns:RsStruct (unwrap (get structs t.name))
      if ns.serialize {
        def rt:RsType (RsType.of2("result" t (this.ownedString())))
        def rc:string (this.resultClass(rt))
        def rv:string (this.jsonTmp("r"))
        push lines (((((((ind + "def ") + rv) + ":") + rc) + " (") + (this.className(t.name))) + ((".rs_from_json_value(" + j) + "))"))
        push lines ((((ind + "if (false == ") + rv) + ".ok) {"))
        push lines ((((((ind + "  r.e = (") + prefix) + " + ") + rv) + ".e)"))
        push lines (ind + "  return r")
        push lines (ind + "}")
        push lines ((((ind + target) + " = ") + rv) + ".v")
        return
      }
    }
    if (k == "vec") {
      def et:RsType (t.arg(0))
      push lines ((((ind + "if (") + j) + ".kind != \"arr\") {"))
      push lines ((((ind + "  r.e = (") + prefix) + " + \"expected an array\")"))
      push lines (ind + "  return r")
      push lines (ind + "}")
      def av:string (this.jsonTmp("a"))
      push lines ((((ind + "def ") + av) + ":") + (this.rtype(t)))
      def itv:string (this.jsonTmp("it"))
      def iv:string (this.jsonTmp("i"))
      push lines (((((((ind + "for ") + j) + ".items ") + itv) + ":RsJsonValue ") + iv) + " {")
      def elv:string (this.jsonTmp("el"))
      push lines (((ind + "  def ") + (this.fieldDecl(elv et))))
      def ip:string (((("(" + prefix) + " + (\"item \" + ((to_string ") + iv) + ") + \": \")))")
      this.jsonRead(itv et elv ip lines (ind + "  "))
      push lines ((((ind + "  push ") + av) + " ") + elv)
      push lines (ind + "}")
      push lines ((((ind + target) + " = ") + av))
      return
    }
    if (k == "opt") {
      def it2:RsType (t.arg(0))
      push lines ((((ind + "if (") + j) + ".kind != \"null\") {"))
      def ov:string (this.jsonTmp("ov"))
      push lines (((ind + "  def ") + (this.fieldDecl(ov it2))))
      this.jsonRead(j it2 ov prefix lines (ind + "  "))
      push lines ((((ind + "  ") + target) + " = ") + ov)
      push lines (ind + "}")
      return
    }
    this.err((new RustNode("none")) (("#[ranger::serialize]: a field of type `" + (t.rust())) + "` (i64, f64, bool, String, Vec, Option and serialized structs are)"))
  }

  ; `ranger::tree! { Node { name: "root", children: [Node { name: "a" }] } }`
  ; (R7): a tree of structs written as one literal. A field left out keeps
  ; its default, `[…]` is a Vec and a string literal is a String -- what the
  ; prelude's macro fills in with `..Default::default()`, `vec!` and
  ; `.into()`. The body is a Rust struct literal, lowered as one.
  fn lowerTree:RsExpr (m:RustNode expect:RsType) {
    def p:RustParser (new RustParser(m.value))
    def body:RustNode (p.parseExpr())
    for p.errors pe:string pi {
      this.err(m ("in tree!: " + pe))
    }
    if (body.kind != "struct_lit") {
      this.err(m "tree! holds one struct literal: `tree! { Node { field: value, children: [ … ] } }`")
      return (this.unit())
    }
    return (this.lowerExpr(body expect))
  }

  ; A Ranger string literal holding `s`.
  fn rangerString:string (s:string) {
    def t:string (replace s "\\" "\\\\")
    t = (replace t "\"" "\\\"")
    t = (replace t "\n" "\\n")
    return (("\"" + t) + "\"")
  }

  fn lowerMacroStmt:boolean (m:RustNode) {
    def name:string m.name
    if (((name == "write") || (name == "writeln")) && (displayFormatter != "") && ((array_length m.kids) >= 1)) {
      def rest:[RustNode]
      def ri:int 1
      while (ri < (array_length m.kids)) {
        push rest (m.kid(ri))
        ri = ri + 1
      }
      def text:string "\"\""
      if ((array_length rest) > 0) {
        text = (this.formatArgs(rest m))
      }
      if (name == "writeln") {
        text = (("(" + text) + " + \"\\n\")")
      }
      out.line((("rs__out = (rs__out + " + text) + ")"))
      return true
    }
    if ((name == "native") || (name == "ranger::native")) {
      def nv:RsExpr (this.lowerNative(m (RsType.mk("unit"))))
      if (nv.code != "") {
        out.line(nv.code)
      }
      return true
    }
    if ((name == "println") || (name == "print") || (name == "eprintln") || (name == "eprint")) {
      def text:string "\"\""
      if ((array_length m.kids) > 0) {
        text = (this.formatArgs(m.kids m))
      } {
        if ((trim m.value) != "") {
          this.err(m (("the arguments of `" + name) + "!` do not parse as expressions"))
          return true
        }
      }
      if ((name == "println")) {
        out.line(("print " + text))
      }
      if (name == "print") {
        out.line(("write " + text))
      }
      if ((name == "eprintln") || (name == "eprint")) {
        ; stderr is not part of what the parity tests compare
        out.line(("rs_eprint " + text))
      }
      return true
    }
    if ((name == "assert") || (name == "debug_assert")) {
      def c:RsExpr (this.lowerExpr((m.kid(0)) (RsType.mk("bool"))))
      out.line((("if (! " + c.code) + ") {"))
      out.line("  rs_panic \"assertion failed\"")
      out.line("}")
      return true
    }
    if ((name == "assert_eq") || (name == "assert_ne") || (name == "debug_assert_eq")) {
      def a:RsExpr (this.lowerExpr((m.kid(0)) (RsType.mk("unknown"))))
      def b:RsExpr (this.lowerExpr((m.kid(1)) a.ty))
      def t:RsType a.ty
      if (t.isUnknown()) {
        t = b.ty
      }
      def eq:string (this.compare("==" a b t m))
      if (name == "assert_ne") {
        out.line((("if " + eq) + " {"))
      } {
        out.line((("if (! " + eq) + ") {"))
      }
      out.line(("  rs_panic " + (this.strLit((name + " failed")))))
      out.line("}")
      return true
    }
    if ((name == "panic") || (name == "unreachable") || (name == "todo") || (name == "unimplemented")) {
      def msg:string (this.strLit((name + "!")))
      if ((array_length m.kids) > 0) {
        msg = (this.formatArgs(m.kids m))
      }
      out.line(("rs_panic " + msg))
      return true
    }
    return false
  }

  fn lowerMacroExpr:RsExpr (m:RustNode expect:RsType) {
    def name:string m.name
    if ((name == "native") || (name == "ranger::native")) {
      return (this.lowerNative(m expect))
    }
    if ((name == "tree") || (name == "ranger::tree")) {
      return (this.lowerTree(m expect))
    }
    if (name == "format") {
      if ((array_length m.kids) == 0) {
        this.err(m "the arguments of `format!` do not parse as expressions")
        return (this.unit())
      }
      return (RsExpr.of((this.formatArgs(m.kids m)) (this.ownedString())))
    }
    if (name == "vec") {
      def arr:RustNode (new RustNode("array"))
      if (m.hasMod("repeat")) {
        arr.kind = "array_repeat"
      }
      arr.line = m.line
      arr.col = m.col
      for m.kids k:RustNode i {
        arr.add(k)
      }
      if (((array_length m.kids) == 0) && ((trim m.value) != "")) {
        this.err(m "the elements of `vec!` do not parse as expressions")
      }
      if ((array_length m.kids) == 0) {
        return (this.emptyCollection(expect m))
      }
      return (this.lowerArray(arr expect))
    }
    if (this.lowerMacroStmt(m)) {
      return (RsExpr.of("" (RsType.mk("never"))))
    }
    this.unsupported(m (("the macro `" + name) + "!`"))
    return (this.unit())
  }

  ; The string expression for format!-style arguments: a literal format
  ; string, then its arguments.
  fn formatArgs:string (kids:[RustNode] at:RustNode) {
    def fmtN:RustNode (itemAt kids 0)
    if ((fmtN.kind != "lit") || (false == (fmtN.hasMod("str")))) {
      this.err(at "the first argument of a formatting macro must be a string literal")
      return "\"\""
    }
    def fmt:string fmtN.value
    def args:[RsExpr]
    def i:int 1
    ; Rust evaluates the arguments left to right; written into one string
    ; expression, a C++ `+` evaluates its operands in either order. With more
    ; than one argument, a call is bound to a temporary first.
    def several:boolean ((array_length kids) > 2)
    while (i < (array_length kids)) {
      def a:RsExpr (this.lowerExpr((itemAt kids i) (RsType.mk("unknown"))))
      if (several && (false == a.simple) && ((indexOf a.code "(") >= 0)) {
        def ak:string a.ty.kind
        if ((false == (a.ty.isUnknown())) && (ak != "unit") && (ak != "fn") && (ak != "none")) {
          def an:string (this.bindTemp(a a.ty "fa"))
          def ab:RsExpr (RsExpr.of(an a.ty))
          ab.simple = true
          a = ab
        }
      }
      push args a
      i = i + 1
    }
    return (this.formatString(fmt args at))
  }

  fn formatString:string (fmt:string args:[RsExpr] at:RustNode) {
    def parts:[string]
    def lit:string ""
    def cs:[int] (to_chars fmt)
    def n:int (array_length cs)
    def i:int 0
    def next:int 0
    while (i < n) {
      def c:int (itemAt cs i)
      if ((c == 123) && ((i + 1) < n) && ((itemAt cs (i + 1)) == 123)) {
        lit = lit + "{"
        i = i + 2
        continue
      }
      if ((c == 125) && ((i + 1) < n) && ((itemAt cs (i + 1)) == 125)) {
        lit = lit + "}"
        i = i + 2
        continue
      }
      if (c == 123) {
        def j:int (i + 1)
        def spec:string ""
        while ((j < n) && ((itemAt cs j) != 125)) {
          spec = spec + (strfromcode (itemAt cs j))
          j = j + 1
        }
        i = j + 1
        if (lit != "") {
          push parts (this.strLit(lit))
          lit = ""
        }
        def colon:int (indexOf spec ":")
        def argName:string spec
        def fspec:string ""
        if (colon >= 0) {
          argName = (substring spec 0 colon)
          fspec = (substring spec (colon + 1) (strlen spec))
        }
        def val:RsExpr (RsExpr.of("\"\"" (RsType.mk("string"))))
        if (argName == "") {
          if (next < (array_length args)) {
            val = (itemAt args next)
          } {
            this.err(at "more `{}` than arguments")
          }
          next = next + 1
        } {
          def fc:int (itemAt (to_chars argName) 0)
          if ((fc >= 48) && (fc <= 57)) {
            def idx:int (unwrap (str2int argName))
            if (idx < (array_length args)) {
              val = (itemAt args idx)
            }
          } {
            ; an inline name: `{x}`
            def l@(optional):RsLocal (scope.lookup(argName))
            if (null? l) {
              this.err(at (("unknown name `" + argName) + "` in a format string"))
            } {
              def lv:RsLocal (unwrap l)
              val = (RsExpr.of(lv.rname lv.ty))
              val.simple = true
            }
          }
        }
        push parts (this.formatValue(val fspec at))
        continue
      }
      lit = lit + (strfromcode c)
      i = i + 1
    }
    if (lit != "") {
      push parts (this.strLit(lit))
    }
    if ((array_length parts) == 0) {
      return "\"\""
    }
    def acc:string (itemAt parts 0)
    def k:int 1
    while (k < (array_length parts)) {
      acc = ((("(" + acc) + " + ") + (itemAt parts k)) + ")"
      k = k + 1
    }
    if ((array_length parts) == 1) {
      def only:string (itemAt parts 0)
      if ((substring only 0 1) != "\"") {
        return (("(\"\" + " + only) + ")")
      }
    }
    return acc
  }

  ; One `{…}`: `?` debug, `.N` precision, a width with `<` `>` `^` alignment
  ; and a fill character, `0` padding.
  fn formatValue:string (v:RsExpr spec:string at:RustNode) {
    def debug:boolean ((indexOf spec "?") >= 0)
    def s:string (join (strsplit spec "?") "")
    s = (join (strsplit s "#") "")
    def prec:int -1
    def dot:int (indexOf s ".")
    if (dot >= 0) {
      def ps:string (substring s (dot + 1) (strlen s))
      prec = (unwrap (str2int ps))
      s = (substring s 0 dot)
    }
    def align:string ""
    def fill:string " "
    def cs:[int] (to_chars s)
    if ((array_length cs) >= 2) {
      def c1:int (itemAt cs 1)
      if ((c1 == 60) || (c1 == 62) || (c1 == 94)) {
        fill = (strfromcode (itemAt cs 0))
        align = (strfromcode c1)
        s = (substring s 2 (strlen s))
      }
    }
    def cs2:[int] (to_chars s)
    if ((align == "") && ((array_length cs2) >= 1)) {
      def c0:int (itemAt cs2 0)
      if ((c0 == 60) || (c0 == 62) || (c0 == 94)) {
        align = (strfromcode c0)
        s = (substring s 1 (strlen s))
      }
    }
    def zero:boolean false
    if (((strlen s) > 1) && ((substring s 0 1) == "0")) {
      zero = true
      s = (substring s 1 (strlen s))
    }
    def width:int 0
    if ((strlen s) > 0) {
      width = (unwrap (str2int s))
    }
    def code:string ""
    if (debug) {
      def tv:string (this.bindTemp(v v.ty "d"))
      code = (this.dbgCode(tv v.ty))
    } {
      if ((prec >= 0) && (v.ty.kind == "double")) {
        code = (((("(rs_fmt_prec " + v.code) + " ") + (to_string prec)) + ")")
      } {
        code = (this.fmtDisplay(v ""))
      }
    }
    if (width > 0) {
      def num:boolean ((v.ty.kind == "int") || (v.ty.kind == "double"))
      if (align == "") {
        if (num) {
          align = ">"
        } {
          align = "<"
        }
      }
      if (zero) {
        return (((("(RsFmt.padZero(" + code) + " ") + (to_string width)) + "))")
      }
      return (((((((("(RsFmt.pad(" + code) + " ") + (to_string width)) + " ") + (this.strLit(align))) + " ") + (this.strLit(fill))) + "))")
    }
    return code
  }

  ; `{}` of a value.
  fn fmtDisplay:string (v:RsExpr prec:string) {
    def k:string v.ty.kind
    if ((k == "string") || (k == "char")) {
      return v.code
    }
    if (k == "int") {
      return (("(to_string " + v.code) + ")")
    }
    if (k == "bool") {
      return (("(? " + v.code) + " \"true\" \"false\")")
    }
    if ((k == "named") && (has structs v.ty.name)) {
      if (false == (this.hasFmt(v.ty "Display"))) {
        this.err((new RustNode("none")) (("`" + v.ty.name) + "` has no Display impl"))
      }
      def r:string (this.bindTemp(v v.ty "d"))
      return (("(" + r) + ".rs_display())")
    }
    if ((k == "named") && (has enums v.ty.name)) {
      if (this.hasFmt(v.ty "Display")) {
        def r2:string (this.bindTemp(v v.ty "d"))
        return (((("(" + (this.implClass(v.ty.name))) + ".displayOf(") + r2) + "))")
      }
      this.err((new RustNode("none")) (("`" + v.ty.name) + "` has no Display impl"))
    }
    return (("(rs_fmt " + v.code) + ")")
  }

  ; `Enum::Variant { a: 1, b }`: the case constructor takes the fields in
  ; declaration order.
  fn lowerVariantLit:RsExpr (n:RustNode en:string vn:string) {
    def e:RsEnum (unwrap (get enums en))
    def v@(optional):RsVariant (e.variant(vn))
    if (null? v) {
      this.err(n (((("no variant `" + vn) + "` in `") + en) + "`"))
      return (this.unit())

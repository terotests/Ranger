; SPDX-License-Identifier: MIT

; Lowers a parsed Rust module to Ranger source (PLAN_RUST_SYNTAX.md, R1/R2).
;
; The result is ordinary Ranger text, read by the Lisp parser like any `.rgr`
; file, so everything after parsing -- type checking, the flow passes, the
; twelve writers -- is shared. The text imports lib/rust/RsPrelude.rgr for the
; operators that give Rust's semantics (truncating division, float
; formatting, `as` casts).
;
; Shape of the output:
;   struct S { … } + impl S { … }   -> class S { def fields; fn methods; sfn assoc fns }
;   enum E { A, B }                 -> Enum E ( A B )
;   enum E { A(i64), B { x: f64 } } -> shape E { case A { … } case B { … } }  (R2)
;   free fns, consts, fn main       -> class RsMain { sfn … }
;   (A, B)                          -> a concrete class per tuple type
;
; Everything outside the subset is reported with its line and never dropped.

Import "../ast/RustAst.rgr"
Import "../parser/RustParser.rgr"
Import "RustTypes.rgr"
Import "RustOut.rgr"
Import "RustReserved.rgr"
Import "RustPreludeOps.rgr"
Import "../doc/RustDocReader.rgr"
Import "RustRgrScan.rgr"

class RustLower {
  def errors:[string]
  def fileName:string ""
  ; impl-level generics while signatures of an impl are collected
  def ownerGenerics:[string]
  ; generic name -> function type, for `F: Fn(A) -> B`
  def fnBoundTypes:[string:RsType]
  ; the type arguments of the instance being written (`Self` of Stack<i64>)
  def selfArgs:[RsType]
  ; monomorphized generic functions and structs still to write
  def fnInstQueue:[RsInst]
  def fnInstNames:[string:boolean]
  def structInstQueue:[RsInst]
  def structInstNames:[string:boolean]
  ; trait-object unions still to write
  def dynQueue:[string]
  def dynNames:[string:boolean]
  def modClass:string "RsMain"
  ; the crate's modules (R6): the entry file and every `mod` it reaches,
  ; lowered together so helper classes and types are shared
  def curMod:string ""
  def modRoots:[RustNode]
  def modKeys:[string]
  def modFiles:[string]
  def modDirs:[string]
  def modClasses:[string:string]
  def modFileOf:[string:string]
  ; `mod x;` declarations whose file is still to be read
  def pendingKeys:[string]
  def pendingDirs:[string]
  def pendingNames:[string]
  def pendingNodes:[RustNode]
  def pendingPos:int 0
  def usesJson:boolean false
  def jsonN:int 0
  def nativeN:int 0
  ; the target being compiled for (`es6`, `cpp`, …), for `#[ranger::target]`
  def target:string ""
  def declLate:boolean false
  ; the file itself for an `import_rgr!`, "" for a `mod x;`
  def pendingFiles:[string]
  ; `.rgr` files included with `ranger::import_rgr!`, for the Import lines
  def rgrImports:[string]
  def entryName:string ""
  ; `use geometry::area;` inside module m: "m|area" -> "geometry::area"
  def fnAlias:[string:string]
  def preludeOps:[string:int]
  def preludeRets:[string:string]
  def preludeLoaded:boolean false

  def structs:[string:RsStruct]
  def structOrder:[string]
  def enums:[string:RsEnum]
  def enumOrder:[string]
  def traits:[string:RsTrait]
  def traitOrder:[string]
  def fns:[string:RsFn]
  def fnOrder:[string]
  def consts:[string:RsConst]
  def constOrder:[string]
  def aliases:[string:RustNode]
  def reserved:[string:boolean]
  def localReserved:[string:boolean]

  ; generated concrete classes: tuples, monomorphized generics
  def genNames:[string:boolean]
  def genOut:[string]
  ; nested fns hoisted to the module class
  def hoisted:[string]

  ; per function
  def out:RustOut (new RustOut())
  def scope:RsScope (new RsScope())
  def used:[string:boolean]
  def tmpN:int 0
  def selfType:string ""
  def retType:RsType (new RsType("unit"))
  ; per enclosing loop: the temporary a `break value` assigns ("" when none)
  def loopVals:[string]
  ; per enclosing loop: its label ("" when none) and the flag a labelled
  ; break / continue from an inner loop sets
  def loopLabels:[string]
  def loopFlags:[string]
  def loopFlagKind:[string]
  ; generic name -> concrete type, while a monomorphized body is lowered
  def genericEnv:[string:RsType]

  Constructor () {
    reserved = (RustReserved.build())
    def kw:[string] ([] _:string ("def" "fn" "sfn" "class" "new" "if" "while" "for" "return" "break" "continue" "print" "true" "false" "null" "this" "switch" "case" "default" "try" "throw" "match" "shape" "trait" "does" "Import" "Enum" "record" "union" "operators" "Extends" "Constructor" "static" "write" "exit" "push" "set" "set_at" "remove" "removeLast" "clear" "ret" "defn" "unwrap" "group" "variant" "extension" "systemclass" "doc" "self" "super" "catch" "and" "or" "not" "is" "in" "del" "pass" "lambda" "yield" "None" "True" "False" "nil" "var" "val" "let" "const" "func" "function" "undefined" "arguments" "delete" "typeof" "instanceof" "void" "with" "package" "import" "export" "interface" "implements" "public" "private" "protected" "struct" "enum" "go" "chan" "select" "range" "type" "map" "string" "int" "double" "boolean" "char" "float" "long" "short" "byte" "auto" "register" "extern" "goto" "sizeof" "volatile" "typedef" "unsigned" "signed" "namespace" "template" "typename" "using" "virtual" "friend" "inline" "operator" "delete" "fun" "object" "when" "init" "deinit" "guard" "repeat" "internal" "open" "final" "override" "abstract" "sealed" "data" "companion" "lateinit" "native" "synchronized" "transient" "strictfp" "assert" "global" "nonlocal" "elif" "except" "finally" "raise" "from" "as" "async" "await" "def" "print"))
    for kw k:string i {
      set localReserved k true
      set reserved k true
    }
    def ops:[string:boolean] (RustReserved.operatorNames())
    def opNames:[string] (keys ops)
    for opNames on:string oi {
      set localReserved on true
    }
  }

  ; ------------------------------------------------------------- reporting

  fn err:void (n:RustNode msg:string) {
    push errors ((((((fileName + ":") + (to_string n.line)) + ":") + (to_string n.col)) + ": ") + msg)
  }

  fn unsupported:void (n:RustNode what:string) {
    this.err(n (what + " is not in the Ranger subset of Rust"))
  }

  ; ----------------------------------------------------------------- names

  fn staticName:string (n:string) {
    if (has reserved n) {
      return (n + "_")
    }
    return n
  }

  fn methodName:string (n:string) {
    if (has localReserved n) {
      return (n + "_")
    }
    return n
  }

  fn fieldName:string (n:string) {
    if (has localReserved n) {
      return (n + "_")
    }
    return n
  }

  fn className:string (n:string) {
    if (has reserved n) {
      return ("Rs" + n)
    }
    return n
  }

  fn tmp:string (base:string) {
    tmpN = tmpN + 1
    return (("rs__" + base) + (to_string tmpN))
  }

  ; A fresh Ranger name for a Rust local: shadowing and reuse across blocks
  ; become distinct names, and a name Ranger reserves gets a suffix.
  fn allocLocal:string (n:string) {
    def base:string n
    if (has localReserved n) {
      base = n + "_"
    }
    if (false == (has used base)) {
      set used base true
      return base
    }
    def k:int 2
    def searching:boolean true
    while searching {
      def cand:string ((base + "_") + (to_string k))
      if (false == (has used cand)) {
        set used cand true
        return cand
      }
      k = k + 1
    }
    return base
  }

  fn declare:RsLocal (n:string t:RsType) {
    def l:RsLocal (new RsLocal())
    l.name = n
    l.rname = (this.allocLocal(n))
    l.ty = t
    l.order = (array_length fnLocals)
    push fnLocals l
    set scope.vars n l
    return l
  }

  ; every local of the function being lowered, in declaration order
  def fnLocals:[RsLocal]

  ; Binds a Rust name to an existing Ranger expression (match bindings used in
  ; a guard, `self`).
  fn alias:RsLocal (n:string code:string t:RsType) {
    def l:RsLocal (new RsLocal())
    l.name = n
    l.rname = code
    l.ty = t
    l.isAlias = true
    set scope.vars n l
    return l
  }

  fn pushScope:void () {
    def s:RsScope (new RsScope())
    s.parent = scope
    scope = s
  }

  fn popScope:void () {
    if (!null? scope.parent) {
      scope = (unwrap scope.parent)
    }
  }

  ; ----------------------------------------------------------- entry point

  sfn isRustFile:boolean (name:string) {
    def n:int (strlen name)
    if (n < 3) {
      return false
    }
    return ((substring name (n - 3) n) == ".rs")
  }

  ; The module class, which holds the free functions: the file name in
  ; UpperCamelCase (`geometry.rs` -> `Geometry`, `word_count.rs` ->
  ; `WordCount`), so the API documentation names the module. The
  ; `RsMod_<file>` form when that name is taken or reserved.
  sfn moduleCamelFor:string (name:string) {
    def fallback:string (RustLower.moduleClassFor(name))
    def stem:string (substring fallback 6 (strlen fallback))
    def parts:[string] (strsplit stem "_")
    def out:string ""
    for parts pt:string i {
      if ((strlen pt) > 0) {
        out = out + ((to_uppercase (substring pt 0 1)) + (substring pt 1 (strlen pt)))
      }
    }
    if ((out == "") || (((charAt out 0) >= 48) && ((charAt out 0) <= 57))) {
      return fallback
    }
    ; a class `Main` collides with the entry method `Main` on C#
    if (out == "Main") {
      return fallback
    }
    return out
  }

  sfn moduleClassFor:string (name:string) {
    def base:string name
    def slash:int (lastIndexOf base "/")
    if (slash >= 0) {
      base = (substring base (slash + 1) (strlen base))
    }
    def dot:int (lastIndexOf base ".")
    if (dot > 0) {
      base = (substring base 0 dot)
    }
    def outS:string ""
    def cs:[int] (to_chars base)
    for cs c:int i {
      if (((c >= 48) && (c <= 57)) || ((c >= 65) && (c <= 90)) || ((c >= 97) && (c <= 122))) {
        outS = outS + (strfromcode c)
      } {
        outS = outS + "_"
      }
    }
    return ("RsMod_" + outS)
  }

  ; Parses and lowers `src`; the Ranger text, or "" with `errors` filled.
  ; A file with `mod x;` needs the module files: use begin / addModule /
  ; finish, which read them.
  fn translate:string (src:string name:string) {
    this.begin(src name)
    while (this.hasPendingModule()) {
      this.moduleNotFound()
    }
    return (this.finish())
  }

  ; Parses the entry file. The `mod x;` it declares are then read one at a
  ; time: nextModuleFiles() names the files that may hold the next one,
  ; addModule() hands one over, moduleNotFound() reports none exists.
  fn begin:void (src:string name:string) {
    fileName = name
    entryName = name
    modClass = (RustLower.moduleClassFor((RustLower.moduleFileName(name))))
    def p:RustParser (new RustParser(src))
    def root:RustNode (p.parseFile())
    for p.errors e:string i {
      push errors ((name + ":") + e)
    }
    if ((array_length errors) > 0) {
      return
    }
    ; rustdoc (R5): `//!` for the module class, and each `# Examples` code
    ; block of an item compiled as an example function
    moduleDoc = (RustDocReader.read(root.attrs false))
    this.addDocExamples(root)
    this.registerModule(root "" name (RustLower.dirOf(name)))
  }

  ; The file a module class is named after: `shapes/mod.rs` is `shapes`.
  sfn moduleFileName:string (path:string) {
    if ((RustLower.baseName(path)) == "mod.rs") {
      def d:string (RustLower.dirOf(path))
      if (d != "") {
        return ((RustLower.baseName(d)) + ".rs")
      }
    }
    return path
  }

  ; The path the module class is named after, when begin() was given only
  ; the file name.
  fn setEntryName:void (name:string) {
    entryName = name
    modClass = (RustLower.moduleClassFor((RustLower.moduleFileName(name))))
  }

  sfn dirOf:string (path:string) {
    def slash:int (lastIndexOf path "/")
    if (slash < 0) {
      return ""
    }
    return (substring path 0 slash)
  }

  sfn baseName:string (path:string) {
    def slash:int (lastIndexOf path "/")
    if (slash < 0) {
      return path
    }
    return (substring path (slash + 1) (strlen path))
  }

  sfn joinPath:string (dir:string name:string) {
    if (dir == "") {
      return name
    }
    return ((dir + "/") + name)
  }

  ; A module's items; inline `mod m { … }` blocks are modules too, and a
  ; `mod m;` waits for its file.
  fn registerModule:void (root:RustNode key:string file:string dir:string) {
    this.filterTargets(root 0)
    push modRoots root
    push modKeys key
    push modFiles file
    push modDirs dir
    set modFileOf key file
    for root.kids it:RustNode i {
      ; `ranger::import_rgr!("legacy")`: the classes of legacy.rgr, beside
      ; the file (where build.rs finds it)
      if ((it.kind == "macro_item") && (this.isImportRgr(it.name))) {
        def rgrName:string (this.macroString(it))
        if (rgrName == "") {
          this.err(it "ranger::import_rgr! takes the module name as a string literal")
          continue
        }
        push pendingKeys key
        push pendingDirs dir
        push pendingNames rgrName
        push pendingNodes it
        push pendingFiles (RustLower.joinPath((RustLower.dirOf(file)) (rgrName + ".rgr")))
        continue
      }
      if (it.kind != "mod") {
        continue
      }
      def sub:string (this.fnKey(key it.name))
      if (it.hasMod("inline")) {
        this.registerModule(it sub file (RustLower.joinPath(dir it.name)))
      } {
        push pendingKeys sub
        push pendingDirs dir
        push pendingNames it.name
        push pendingNodes it
        push pendingFiles ""
      }
    }
  }

  fn setTarget:void (t:string) {
    target = t
  }

  ; `#[ranger::target(es6, python)]` on an item or a method: the item is
  ; there only when compiling for one of those targets (R7). rustc builds the
  ; Rust target, and the prelude's `target` macro keeps the item only when
  ; `rust` is listed.
  fn targetKeeps:boolean (it:RustNode) {
    for it.attrs a:RustNode ai {
      if ((a.name != "ranger::target") && (a.name != "target")) {
        continue
      }
      if (target == "") {
        return true
      }
      def inner:string (trim a.value)
      if ((strlen inner) >= 2) {
        inner = (substring inner 1 ((strlen inner) - 1))
      }
      def keep:boolean false
      ; bound first: the Kotlin writer cannot loop over an expression
      def parts:[string] (strsplit inner ",")
      for parts part:string pi {
        def t:string (RustLower.targetAlias((trim part)))
        if ((t == target) || ((t == "es6") && (target == "typescript"))) {
          keep = true
        }
      }
      if (keep == false) {
        return false
      }
    }
    return true
  }

  sfn targetAlias:string (t:string) {
    if ((t == "js") || (t == "javascript")) {
      return "es6"
    }
    if (t == "java") {
      return "java7"
    }
    if (t == "swift") {
      return "swift6"
    }
    if (t == "ts") {
      return "typescript"
    }
    return t
  }

  ; Drops the items (and the methods of impl blocks) not written for the
  ; target; `first` kids are fixed slots, not items.
  fn filterTargets:void (root:RustNode first:int) {
    def kept:[RustNode]
    def i:int 0
    for root.kids it:RustNode ki {
      if ((i >= first) && (false == (this.targetKeeps(it)))) {
        i = i + 1
        continue
      }
      if ((i >= first) && (it.kind == "impl")) {
        this.filterTargets(it 4)
      }
      push kept it
      i = i + 1
    }
    root.kids = kept
  }

  fn isImportRgr:boolean (name:string) {
    return ((name == "import_rgr") || (name == "ranger::import_rgr"))
  }

  ; The string literal a macro was given: `import_rgr!("legacy")` -> legacy
  fn macroString:string (m:RustNode) {
    def v:string (trim m.value)
    def n:int (strlen v)
    if ((n >= 2) && ((charAt v 0) == 34) && ((charAt v (n - 1)) == 34)) {
      return (substring v 1 (n - 1))
    }
    return ""
  }

  fn hasPendingModule:boolean () {
    return (pendingPos < (array_length pendingKeys))
  }

  ; `mod m;` in a module whose files live in `dir` is `dir/m.rs` or
  ; `dir/m/mod.rs`, as rustc looks for it.
  fn nextModuleFiles:[string] () {
    def list:[string]
    if (false == (this.hasPendingModule())) {
      return list
    }
    def d:string (itemAt pendingDirs pendingPos)
    def m:string (itemAt pendingNames pendingPos)
    def rf:string (itemAt pendingFiles pendingPos)
    if (rf != "") {
      push list rf
      return list
    }
    push list (RustLower.joinPath(d (m + ".rs")))
    push list (RustLower.joinPath((RustLower.joinPath(d m)) "mod.rs"))
    return list
  }

  fn addModule:void (path:string src:string) {
    if (false == (this.hasPendingModule())) {
      return
    }
    def key:string (itemAt pendingKeys pendingPos)
    def m:string (itemAt pendingNames pendingPos)
    def d:string (itemAt pendingDirs pendingPos)
    def rf:string (itemAt pendingFiles pendingPos)
    def at:RustNode (itemAt pendingNodes pendingPos)
    pendingPos = pendingPos + 1
    if (rf != "") {
      this.addRgr(path src at)
      return
    }
    def p:RustParser (new RustParser(src))
    def root:RustNode (p.parseFile())
    for p.errors e:string i {
      push errors ((path + ":") + e)
    }
    if ((array_length errors) > 0) {
      return
    }
    ; `m/mod.rs` keeps its directory; `m.rs` puts its own modules in `m/`
    def own:string (RustLower.joinPath(d m))
    this.registerModule(root key path own)
  }

  ; The classes of an included `.rgr` file: known by name to the `.rs`
  ; code, written by an ordinary Import of the file.
  fn addRgr:void (path:string src:string at:RustNode) {
    def sc:RsRgrScan (new RsRgrScan())
    sc.scan(src path)
    for sc.classes c:RsStruct ci {
      if ((has structs c.name) || (has enums c.name)) {
        this.err(at (((("`" + c.name) + "` of ") + path) + " is also declared in the Rust code"))
        continue
      }
      set structs c.name c
    }
    push rgrImports path
  }

  fn moduleNotFound:void () {
    if (false == (this.hasPendingModule())) {
      return
    }
    def files:[string] (this.nextModuleFiles())
    def at:RustNode (itemAt pendingNodes pendingPos)
    def m:string (itemAt pendingNames pendingPos)
    def rf2:string (itemAt pendingFiles pendingPos)
    pendingPos = pendingPos + 1
    if (rf2 != "") {
      this.err(at (("file not found for ranger::import_rgr!: " + rf2)))
      return
    }
    this.err(at ((((("file not found for module `" + m) + "`: looked for ") + (itemAt files 0)) + " and ") + (itemAt files 1)))
  }

  ; Lowers the entry file and its modules to one Ranger text.
  fn finish:string () {
    if ((array_length errors) > 0) {
      return ""
    }
    this.collectModules()
    if ((array_length errors) > 0) {
      return ""
    }
    def camel:string (RustLower.moduleCamelFor((RustLower.moduleFileName(entryName))))
    if ((false == (has structs camel)) && (false == (has enums camel)) && (false == (has traits camel)) && ((this.className(camel)) == camel)) {
      modClass = camel
    }
    set modClasses "" modClass
    def ki:int 1
    while (ki < (array_length modKeys)) {
      def mk:string (itemAt modKeys ki)
      ki = ki + 1
      set modClasses mk (this.moduleClassOf(mk))
    }
    for fnOrder fk:string fki {
      def fo:RsFn (unwrap (get fns fk))
      fo.modCls = (unwrap (get modClasses fo.modKey))
    }
    for constOrder ck:string cki {
      def co:RsConst (unwrap (get consts ck))
      co.modCls = (unwrap (get modClasses co.modKey))
    }
    def text:string (this.emitAll())
    if ((array_length errors) > 0) {
      return ""
    }
    return text
  }

  ; `shapes::round` -> `ShapesRound`, unless a type has that name
  fn moduleClassOf:string (key:string) {
    def flat:string (join (strsplit key "::") "_")
    def camel:string (RustLower.moduleCamelFor((flat + ".rs")))
    def used:boolean ((has structs camel) || (has enums camel) || (has traits camel) || ((this.className(camel)) != camel) || (camel == modClass))
    for modKeys ok:string oi {
      if ((ok != key) && (has modClasses ok)) {
        if ((unwrap (get modClasses ok)) == camel) {
          used = true
        }
      }
    }
    if used {
      return (RustLower.moduleClassFor((flat + ".rs")))
    }
    return camel
  }

  ; The key of a module-level item: `area` in the root, `geometry::area`
  fn fnKey:string (mod:string name:string) {
    if (mod == "") {
      return name
    }
    return ((mod + "::") + name)
  }

  fn parentMod:string (mod:string) {
    def cut:int (lastIndexOf mod "::")
    if (cut < 0) {
      return ""
    }
    return (substring mod 0 cut)
  }

  ; A path to a module-level function or const, as the current module sees
  ; it: `area` (declared here or brought in by `use`), `geometry::area`,
  ; `crate::geometry::area`, `super::area`, `self::area`. "" if none.
  fn resolveItem:string (segs:[string] table:string) {
    def ns:int (array_length segs)
    if (ns == 0) {
      return ""
    }
    def last:string (itemAt segs (ns - 1))
    if (ns == 1) {
      def here:string (this.fnKey(curMod last))
      if (this.hasItem(here table)) {
        return here
      }
      def ak:string ((curMod + "|") + last)
      if (has fnAlias ak) {
        def target:string (unwrap (get fnAlias ak))
        if (this.hasItem(target table)) {
          return target
        }
      }
      return ""
    }
    ; relative to the current module first (Rust 2018 paths), then from the
    ; crate root
    def rel:string (this.modPath(segs curMod))
    if (rel != "?") {
      def k1:string (this.fnKey(rel last))
      if (this.hasItem(k1 table)) {
        return k1
      }
    }
    def abs:string (this.modPath(segs ""))
    if (abs != "?") {
      def k2:string (this.fnKey(abs last))
      if (this.hasItem(k2 table)) {
        return k2
      }
    }
    return ""
  }

  ; The module named by all segments but the last, starting from `from`;
  ; "?" when a segment is not a module.
  fn modPath:string (segs:[string] from:string) {
    def cur:string from
    def i:int 0
    def ns:int (array_length segs)
    while (i < (ns - 1)) {
      def sg:string (itemAt segs i)
      i = i + 1
      if (sg == "crate") {
        cur = ""
        continue
      }
      if (sg == "self") {
        continue
      }
      if (sg == "super") {
        cur = (this.parentMod(cur))
        continue
      }
      def next:string (this.fnKey(cur sg))
      if (false == (has modFileOf next)) {
        return "?"
      }
      cur = next
    }
    return cur
  }

  fn hasItem:boolean (key:string table:string) {
    if (table == "fn") {
      return (has fns key)
    }
    return (has consts key)
  }

  ; --------------------------------------------------------------- collect

  fn deriveList:[string] (attrs:[RustNode]) {
    def list:[string]
    for attrs a:RustNode i {
      if (a.name == "derive") {
        def inner:string (trim a.value)
        if ((strlen inner) >= 2) {
          inner = (substring inner 1 ((strlen inner) - 1))
        }
        def parts:[string] (strsplit inner ",")
        for parts p:string j {
          def t:string (trim p)
          def dc:int (lastIndexOf t "::")
          if (dc >= 0) {
            t = (substring t (dc + 2) (strlen t))
          }
          if ((strlen t) > 0) {
            push list t
          }
        }
      }
    }
    return list
  }

  fn genericNames:[string] (g:RustNode) {
    def list:[string]
    for g.kids k:RustNode i {
      if (k.kind == "type_param") {
        push list k.name
      }
    }
    return list
  }

  fn collectModules:void () {
    ; pass 1: names, so types can refer to anything declared in the crate
    def mi1:int 0
    while (mi1 < (array_length modRoots)) {
      this.enterModule(mi1)
      this.collectNames((itemAt modRoots mi1))
      mi1 = mi1 + 1
    }
    ; pass 2: fields, variants, signatures
    def mi2:int 0
    while (mi2 < (array_length modRoots)) {
      this.enterModule(mi2)
      def r2:RustNode (itemAt modRoots mi2)
      for r2.kids it2:RustNode j {
        this.collectItem(it2)
      }
      mi2 = mi2 + 1
    }
    ; `use Expr::*;` / `use Shape::{Circle, Rect}`: variants named bare;
    ; `use geometry::area;`: a function of another module
    def mi3:int 0
    while (mi3 < (array_length modRoots)) {
      this.enterModule(mi3)
      def r3:RustNode (itemAt modRoots mi3)
      for r3.kids ut:RustNode uj {
        if (ut.kind == "use") {
          for ut.kids uk:RustNode uk_i {
            this.collectUse(uk)
          }
        }
      }
      mi3 = mi3 + 1
    }
    this.enterModule(0)
    this.collectRest()
  }

  fn enterModule:void (i:int) {
    curMod = (itemAt modKeys i)
    fileName = (itemAt modFiles i)
  }

  fn collectNames:void (root:RustNode) {
    for root.kids it:RustNode i {
      if (it.kind == "struct") {
        def s:RsStruct (new RsStruct())
        s.name = it.name
        s.node = it
        s.derives = (this.deriveList(it.attrs))
        s.generics = (this.genericNames((it.kid(0))))
        set structs it.name s
        push structOrder it.name
      }
      if (it.kind == "enum") {
        def e:RsEnum (new RsEnum())
        e.name = it.name
        e.derives = (this.deriveList(it.attrs))
        e.generics = (this.genericNames((it.kid(0))))
        e.node = it
        set enums it.name e
        push enumOrder it.name
      }
      if (it.kind == "trait") {
        def tr:RsTrait (new RsTrait())
        tr.name = it.name
        set traits it.name tr
        push traitOrder it.name
      }
      if (it.kind == "type_alias") {
        set aliases it.name (it.kid(3))
      }
    }
  }

  fn collectRest:void () {
    ; a method named like a field of its struct is renamed: Ranger does not
    ; allow both
    for structOrder sn:string si {
      def st0:RsStruct (unwrap (get structs sn))
      for st0.methods sm:RsFn smi {
        if (!null? (st0.field(sm.name))) {
          sm.rname = (sm.name + "_m")
          if (false == sm.hasSelf) {
            sm.statName = ((this.staticName(sm.name)) + "_m")
          }
        }
      }
    }
    ; default methods of traits reach every implementor that lacks them
    def toi:int 0
    while (toi < (array_length traitOrder)) {
      def tn:string (itemAt traitOrder toi)
      toi = toi + 1
      def tr2:RsTrait (unwrap (get traits tn))
      for tr2.implementors impl:string ii {
        for tr2.methods tm:RsFn mi {
          if (false == tm.hasBody) {
            continue
          }
          if (has structs impl) {
            def st:RsStruct (unwrap (get structs impl))
            if (null? (st.method(tm.name))) {
              def cm:RsFn (this.retarget(tm impl))
              if (!null? (st.field(cm.name))) {
                cm.rname = (cm.name + "_m")
              }
              push st.methods cm
            }
          }
          if (has enums impl) {
            def en:RsEnum (unwrap (get enums impl))
            if (null? (en.method(tm.name))) {
              push en.methods (this.retarget(tm impl))
            }
          }
        }
      }
    }
  }

  ; A trait's default method, copied into an implementor.
  fn retarget:RsFn (m:RsFn owner:string) {
    def c:RsFn (new RsFn())
    c.name = m.name
    c.rname = m.rname
    c.generics = m.generics
    c.params = m.params
    c.ret = m.ret
    c.hasSelf = m.hasSelf
    c.selfMut = m.selfMut
    c.selfByValue = m.selfByValue
    c.owner = owner
    c.fromTrait = m.fromTrait
    c.hasBody = m.hasBody
    c.node = m.node
    c.modKey = m.modKey
    return c
  }

  fn collectItem:void (it:RustNode) {
    def k:string it.kind
    if ((k == "use") || (k == "extern_crate") || (k == "mod")) {
      return
    }
    if (k == "struct") {
      def s:RsStruct (unwrap (get structs it.name))
      if (this.hasStructAttr(s "serialize")) {
        this.addSerializeMethods(s)
      }
      def fs:RustNode (it.kid(2))
      if (fs.kind == "fields_tuple") {
        s.isTuple = true
      }
      def sg:RustNode (it.kid(0))
      for sg.kids gk:RustNode gi {
        if (gk.kind == "lifetime_param") {
          this.unsupported(gk (("a lifetime parameter on the struct `" + it.name) + "` (a struct cannot hold references)"))
        }
      }
      for fs.kids f:RustNode i {
        def rf:RsField (new RsField())
        rf.name = f.name
        if (s.isTuple) {
          rf.name = ("f" + f.name)
        }
        rf.node = f
        rf.ty = (this.typeOfIn((f.kid(0)) s.generics))
        this.fieldMarkers(f rf s)
        if (rf.ty.isRef) {
          this.unsupported(f (("a reference stored in the field `" + f.name) + "`: own the value, or share it with Rc"))
        }
        push s.fields rf
      }
      return
    }
    if (k == "enum") {
      def e:RsEnum (unwrap (get enums it.name))
      def disc:int 0
      def ki:int 3
      while (ki <= (array_length it.kids)) {
        def v:RustNode (it.kid((ki - 1)))
        ki = ki + 1
        if (v.kind != "variant") {
          continue
        }
        def rv:RsVariant (new RsVariant())
        rv.name = v.name
        def vf:RustNode (v.kid(0))
        if (vf.kind == "fields_tuple") {
          rv.shape = "tuple"
          e.plain = false
        }
        if (vf.kind == "fields_named") {
          rv.shape = "named"
          e.plain = false
        }
        for vf.kids f:RustNode fi {
          def rf:RsField (new RsField())
          rf.name = f.name
          if (rv.shape == "tuple") {
            rf.name = ("f" + f.name)
          }
          rf.ty = (this.typeOfIn((f.kid(0)) e.generics))
          push rv.fields rf
        }
        def dn:RustNode (v.kid(1))
        if (false == (dn.isNone())) {
          if (dn.kind == "lit") {
            disc = (this.intValue(dn))
          } {
            this.unsupported(dn "a non-literal enum discriminant")
          }
        }
        rv.disc = disc
        disc = disc + 1
        push e.variants rv
      }
      return
    }
    if (k == "trait") {
      def tr:RsTrait (unwrap (get traits it.name))
      def ti:int 3
      while (ti < (array_length it.kids)) {
        def m:RustNode (it.kid(ti))
        ti = ti + 1
        if (m.kind == "fn") {
          def f:RsFn (this.fnSig(m it.name))
          f.fromTrait = it.name
          push tr.methods f
        } {
          if ((m.kind == "type_alias") || (m.kind == "const")) {
            this.unsupported(m "an associated type or const in a trait")
          }
        }
      }
      return
    }
    if (k == "impl") {
      def selfT:RustNode (it.kid(2))
      def owner:string (this.typeNameOf(selfT))
      if (false == ((has structs owner) || (has enums owner))) {
        this.err(it ("impl for a type not declared in this file: " + owner))
        return
      }
      def traitN:RustNode (it.kid(1))
      def traitName:string ""
      if (false == (traitN.isNone())) {
        traitName = (this.typeNameOf(traitN))
      }
      def saveSelf:string selfType
      selfType = owner
      ownerGenerics = (this.genericNames((it.kid(0))))
      def mi:int 4
      while (mi < (array_length it.kids)) {
        def m2:RustNode (it.kid(mi))
        mi = mi + 1
        if (m2.kind != "fn") {
          if ((m2.kind == "type_alias") && (traitName != "")) {
            ; `type Output = …` of an operator trait: nothing to write
            continue
          }
          this.unsupported(m2 ("`" + (m2.kind + "` inside an impl")))
          continue
        }
        def f2:RsFn (this.fnSig(m2 owner))
        f2.fromTrait = traitName
        if (has structs owner) {
          def st:RsStruct (unwrap (get structs owner))
          push st.methods f2
        } {
          def en:RsEnum (unwrap (get enums owner))
          push en.methods f2
        }
      }
      selfType = saveSelf
      def noGen:[string]
      ownerGenerics = noGen
      if (traitName != "") {
        this.noteTraitImpl(traitName owner it)
      }
      return
    }
    if (k == "fn") {
      def ff:RsFn (this.fnSig(it ""))
      ff.rname = (this.staticName(it.name))
      def fk:string (this.fnKey(curMod it.name))
      set fns fk ff
      push fnOrder fk
      return
    }
    if ((k == "const") || (k == "static")) {
      def c:RsConst (new RsConst())
      c.name = it.name
      c.node = it
      c.ty = (this.typeOf((it.kid(0))))
      c.modKey = curMod
      if (it.hasMod("mut")) {
        this.unsupported(it "`static mut`")
      }
      def ck:string (this.fnKey(curMod it.name))
      set consts ck c
      push constOrder ck
      return
    }
    if ((k == "struct") || (k == "enum") || (k == "type_alias")) {
      return
    }
    if ((k == "macro_item") && (this.isImportRgr(it.name))) {
      return
    }
    if (k == "macro_item") {
      this.unsupported(it (("the macro invocation `" + it.name) + "!` at item level"))
      return
    }
    this.unsupported(it ("`" + (k + "`")))
  }

  ; `#[ranger::weak]` / `#[ranger::late]` on a field (R7); the struct needs
  ; `#[ranger::fields]` or `#[ranger::serialize]`, which rustc runs to remove
  ; them.
  fn fieldMarkers:void (f:RustNode rf:RsField s:RsStruct) {
    for f.attrs a:RustNode ai {
      def an:string a.name
      if ((an == "ranger::weak") || (an == "ranger::late")) {
        if (false == (this.hasStructAttr(s "fields") || (this.hasStructAttr(s "serialize")))) {
          this.err(f (("`#[" + an) + "]` on a field needs `#[ranger::fields]` on the struct: rustc runs no attribute macro on a field"))
          return
        }
      }
      if (an == "ranger::weak") {
        if (rf.ty.kind == "opt") {
          def w:RsType ((rf.ty.arg(0)).copy())
          w.weak = true
          def o:RsType (RsType.of1("opt" w))
          rf.ty = o
        } {
          def w2:RsType (rf.ty.copy())
          w2.weak = true
          rf.ty = w2
        }
      }
      if (an == "ranger::late") {
        if (rf.ty.kind != "opt") {
          this.err(f "`#[ranger::late]` is for an `Option` field")
          return
        }
        def lt:RsType (rf.ty.copy())
        lt.late = true
        rf.ty = lt
      }
    }
  }

  fn hasStructAttr:boolean (s:RsStruct name:string) {
    if (null? s.node) {
      return false
    }
    def sn:RustNode (unwrap s.node)
    for sn.attrs a:RustNode ai {
      if ((a.name == ("ranger::" + name)) || (a.name == name)) {
        return true
      }
    }
    return false
  }

  fn noteTraitImpl:void (traitName:string owner:string it:RustNode) {
    if (has traits traitName) {
      def tr:RsTrait (unwrap (get traits traitName))
      push tr.implementors owner
    }
    if (has structs owner) {
      def st:RsStruct (unwrap (get structs owner))
      push st.traits traitName
    }
    if (has enums owner) {
      def en:RsEnum (unwrap (get enums owner))
      push en.traits traitName
    }
  }

  fn fnSig:RsFn (m:RustNode owner:string) {
    def f:RsFn (new RsFn())
    f.name = m.name
    f.rname = (this.methodName(m.name))
    f.owner = owner
    f.node = m
    f.modKey = curMod
    def all:[string] (this.genericNames((m.kid(0))))
    ; a generic bounded by an Fn trait is a function type, not a generic
    def gp:RustNode (m.kid(0))
    def fnBound:[string:boolean]
    for gp.kids g:RustNode gi {
      if (g.kind == "type_param") {
        def bs:RustNode (g.kid(0))
        def names:[string]
        for bs.kids b:RustNode bi {
          push names (this.typeNameOf(b))
          if (this.isFnBound(b)) {
            def bt:RsType (this.typeOfIn(b ownerGenerics))
            set fnBoundTypes g.name bt
            set fnBound g.name true
          }
        }
        set f.bounds g.name (join names "+")
      }
    }
    def wh:RustNode (m.kid(3))
    for wh.kids wp:RustNode wi {
      if (wp.kind == "where_pred") {
        def target:string (this.typeNameOf((wp.kid(0))))
        def wb:RustNode (wp.kid(1))
        for wb.kids b2:RustNode bj {
          if (this.isFnBound(b2)) {
            def bt2:RsType (this.typeOfIn(b2 ownerGenerics))
            set fnBoundTypes target bt2
            set fnBound target true
          }
        }
      }
    }
    for all gn:string gk {
      if (false == (has fnBound gn)) {
        push f.generics gn
      }
    }
    def sigGen:[string]
    for f.generics g1:string g1i {
      push sigGen g1
    }
    for ownerGenerics g2:string g2i {
      push sigGen g2
    }
    f.ownerGenerics = ownerGenerics
    def params:RustNode (m.kid(1))
    for params.kids p:RustNode pi {
      if (p.kind == "self_param") {
        f.hasSelf = true
        if (p.hasMod("mut") && (p.hasMod("&"))) {
          f.selfMut = true
        }
        if (false == (p.hasMod("&"))) {
          f.selfByValue = true
        }
        continue
      }
      def rp:RsParam (new RsParam())
      def pat:RustNode (p.kid(0))
      rp.pat = pat
      if (pat.kind == "pat_ident") {
        rp.name = pat.name
      } {
        rp.name = ""
      }
      rp.ty = (this.typeOfIn((p.kid(1)) sigGen))
      rp.boxed = (this.needsBox(rp.ty))
      push f.params rp
    }
    def ret:RustNode (m.kid(2))
    if ((array_length ret.kids) > 0) {
      f.ret = (this.typeOfIn((ret.kid(0)) sigGen))
    } {
      f.ret = (RsType.mk("unit"))
    }
    def body:RustNode (m.kid(4))
    f.hasBody = (false == (body.isNone()))
    return f
  }

  ; `Fn(A) -> B` / `FnMut(…)` / `FnOnce(…)` in a bound.
  fn isFnBound:boolean (b:RustNode) {
    if (b.kind != "path_type") {
      return false
    }
    def p:RustNode (b.kid(0))
    if ((array_length p.kids) == 0) {
      return false
    }
    def last:RustNode (itemAt p.kids ((array_length p.kids) - 1))
    def a:RustNode (last.kid(0))
    return (a.kind == "fn_args")
  }

  ; ----------------------------------------------------------------- types

  ; The last path segment of a type, for impl targets and trait names.
  fn typeNameOf:string (t:RustNode) {
    if (t.kind == "path_type") {
      def p:RustNode (t.kid(0))
      if ((array_length p.kids) > 0) {
        def last:RustNode (itemAt p.kids ((array_length p.kids) - 1))
        return last.name
      }
    }
    if ((t.kind == "ref_type") || (t.kind == "paren_type")) {
      return (this.typeNameOf((t.kid(0))))
    }
    if ((t.kind == "dyn_type") || (t.kind == "impl_type")) {
      return (this.typeNameOf((t.kid(0))))
    }
    return ""
  }

  fn typeOf:RsType (t:RustNode) {
    def none:[string]
    return (this.typeOfIn(t none))
  }

  fn typeOfIn:RsType (t:RustNode generics:[string]) {
    def k:string t.kind
    if (k == "none") {
      return (RsType.mk("unknown"))
    }
    if (k == "ref_type") {
      def inner:RsType ((this.typeOfIn((t.kid(0)) generics)).copy())
      inner.isRef = true
      if (t.hasMod("mut")) {
        inner.isMutRef = true
      }
      return inner
    }
    if ((k == "paren_type") || (k == "ptr_type")) {
      return (this.typeOfIn((t.kid(0)) generics))
    }
    if ((k == "slice_type") || (k == "array_type")) {
      return (RsType.of1("vec" (this.typeOfIn((t.kid(0)) generics))))
    }
    if (k == "tuple_type") {
      if ((array_length t.kids) == 0) {
        return (RsType.mk("unit"))
      }
      def tt:RsType (RsType.mk("tuple"))
      for t.kids e:RustNode i {
        push tt.args (this.typeOfIn(e generics))
      }
      return tt
    }
    if (k == "never_type") {
      return (RsType.mk("never"))
    }
    if (k == "infer_type") {
      return (RsType.mk("unknown"))
    }
    if (k == "fn_type") {
      def ft:RsType (RsType.mk("fn"))
      def n:int (array_length t.kids)
      def i:int 0
      while (i < (n - 1)) {
        push ft.args (this.typeOfIn((t.kid(i)) generics))
        i = i + 1
      }
      push ft.args (this.retTypeOf((t.kid((n - 1))) generics))
      return ft
    }
    if ((k == "impl_type") || (k == "dyn_type")) {
      ; the first bound decides: an Fn trait is a function type, anything
      ; else a trait object
      def b:RustNode (t.kid(0))
      def bt:RsType ((this.typeOfIn(b generics)).copy())
      bt.isDyn = true
      return bt
    }
    if (k == "path_type") {
      return (this.pathType((t.kid(0)) generics t))
    }
    if (k == "qself_type") {
      this.unsupported(t "a qualified path type")
      return (RsType.mk("unknown"))
    }
    this.unsupported(t ("the type form `" + (k + "`")))
    return (RsType.mk("unknown"))
  }

  fn retTypeOf:RsType (ret:RustNode generics:[string]) {
    if ((array_length ret.kids) > 0) {
      return (this.typeOfIn((ret.kid(0)) generics))
    }
    return (RsType.mk("unit"))
  }

  fn segArgs:[RsType] (seg:RustNode generics:[string]) {
    def list:[RsType]
    def a:RustNode (seg.kid(0))
    if (a.kind == "args") {
      for a.kids x:RustNode i {
        if ((x.kind == "lifetime") || (x.kind == "binding") || (x.kind == "constraint")) {
          continue
        }
        push list (this.typeOfIn(x generics))
      }
    }
    return list
  }

  fn pathType:RsType (p:RustNode generics:[string] at:RustNode) {
    if (p.kind != "path") {
      this.unsupported(at "a qualified path type")
      return (RsType.mk("unknown"))
    }
    def n:int (array_length p.kids)
    if (n == 0) {
      return (RsType.mk("unknown"))
    }
    def seg:RustNode (itemAt p.kids (n - 1))
    def name:string seg.name
    def args:[RsType] (this.segArgs(seg generics))
    ; Fn(A, B) -> R sugar
    def sa:RustNode (seg.kid(0))
    if (sa.kind == "fn_args") {
      def ft:RsType (RsType.mk("fn"))
      def an:int (array_length sa.kids)
      def ai:int 0
      while (ai < (an - 1)) {
        push ft.args (this.typeOfIn((sa.kid(ai)) generics))
        ai = ai + 1
      }
      push ft.args (this.retTypeOf((sa.kid((an - 1))) generics))
      return ft
    }
    if (has fnBoundTypes name) {
      def fb:RsType (unwrap (get fnBoundTypes name))
      return (fb.copy())
    }
    for generics g:string gi {
      if (g == name) {
        if (has genericEnv name) {
          def bound:RsType (unwrap (get genericEnv name))
          return (bound.copy())
        }
        def pt:RsType (RsType.mk("param"))
        pt.name = name
        return pt
      }
    }
    if (has genericEnv name) {
      def bound2:RsType (unwrap (get genericEnv name))
      return (bound2.copy())
    }
    if ((name == "i8") || (name == "i16") || (name == "i32") || (name == "i64") || (name == "i128") || (name == "isize") || (name == "u8") || (name == "u16") || (name == "u32") || (name == "u64") || (name == "u128") || (name == "usize") || (name == "int")) {
      def it:RsType (RsType.mk("int"))
      it.name = name
      return it
    }
    if ((name == "f32") || (name == "f64") || (name == "double")) {
      return (RsType.mk("double"))
    }
    if ((name == "bool") || (name == "boolean")) {
      return (RsType.mk("bool"))
    }
    if ((name == "String") || (name == "str") || (name == "string")) {
      def stT:RsType (RsType.mk("string"))
      if (name == "String") {
        stT.name = "String"
      }
      return stT
    }
    if (name == "char") {
      return (RsType.mk("char"))
    }
    if ((name == "Vec") || (name == "VecDeque")) {
      return (RsType.of1("vec" (this.argOr(args 0))))
    }
    if ((name == "HashMap") || (name == "BTreeMap") || (name == "Map")) {
      def mt:RsType (RsType.of2("map" (this.argOr(args 0)) (this.argOr(args 1))))
      if (name == "BTreeMap") {
        mt.name = "sorted"
      }
      if (name == "Map") {
        ; the prelude's Map keeps insertion order on every target
        mt.name = "ordered"
      }
      return mt
    }
    if ((name == "HashSet") || (name == "BTreeSet")) {
      def st:RsType (RsType.of1("set" (this.argOr(args 0))))
      if (name == "BTreeSet") {
        st.name = "sorted"
      }
      return st
    }
    if (name == "Option") {
      return (RsType.of1("opt" (this.argOr(args 0))))
    }
    if (name == "Result") {
      return (RsType.of2("result" (this.argOr(args 0)) (this.argOr(args 1))))
    }
    if ((name == "Box") || (name == "Rc") || (name == "Arc") || (name == "RefCell") || (name == "Cell") || (name == "Mutex")) {
      def inner:RsType ((this.argOr(args 0)).copy())
      inner.shared = true
      return inner
    }
    if (name == "Weak") {
      def w:RsType ((this.argOr(args 0)).copy())
      w.weak = true
      w.shared = true
      return w
    }
    if (name == "Self") {
      if (selfType != "") {
        def sft:RsType (RsType.named(selfType))
        for selfArgs sa:RsType sai {
          push sft.args sa
        }
        if (((array_length selfArgs) == 0) && (has structs selfType)) {
          ; inside a generic impl: Self<T…>, substituted per instance
          def ss:RsStruct (unwrap (get structs selfType))
          for ss.generics g:string gi {
            def gp:RsType (RsType.mk("param"))
            gp.name = g
            push sft.args gp
          }
        }
        return sft
      }
    }
    if (has aliases name) {
      def an2:RustNode (unwrap (get aliases name))
      return (this.typeOfIn(an2 generics))
    }
    if ((has structs name) || (has enums name) || (has traits name)) {
      def nt:RsType (RsType.named(name))
      nt.args = args
      return nt
    }
    if ((name == "Formatter") || (name == "Arguments")) {
      return (RsType.named("Formatter"))
    }
    if ((name == "ParseIntError") || (name == "ParseFloatError")) {
      ; carried as its Display text
      return (this.ownedString())
    }
    if (name == "Ordering") {
      def ordT:RsType (RsType.mk("int"))
      ordT.name = "Ordering"
      return ordT
    }
    if ((name == "Display") || (name == "Debug")) {
      def ot:RsType (RsType.named(name))
      return ot
    }
    this.err(at (("unknown type `" + name) + "`"))
    return (RsType.mk("unknown"))
  }

  fn argOr:RsType (args:[RsType] i:int) {
    if (i < (array_length args)) {
      def a:RsType (itemAt args i)
      return a
    }
    return (RsType.mk("unknown"))
  }

  ; The Ranger spelling of a type ("" when unknown).
  fn rtype:string (t:RsType) {
    def k:string t.kind
    if (k == "int") {
      return "int"
    }
    if (k == "double") {
      return "double"
    }
    if (k == "bool") {
      return "boolean"
    }
    if ((k == "string") || (k == "char")) {
      return "string"
    }
    if (k == "unit") {
      return "void"
    }
    if (k == "vec") {
      if ((t.arg(0)).kind == "opt") {
        ; a Ranger array has no empty element
        if (false == optInCollectionReported) {
          optInCollectionReported = true
          push errors (fileName + ": a Vec of Option is not in the Ranger subset: keep the present values (`filter_map`, `flatten`) or use a sentinel")
        }
        return ""
      }
      def e:string (this.rtype((t.arg(0))))
      if (e == "") {
        return ""
      }
      return (("[" + e) + "]")
    }
    if (k == "map") {
      def mk:string (this.rtype((t.arg(0))))
      def mv:string (this.rtype((t.arg(1))))
      if ((mk == "") || (mv == "")) {
        return ""
      }
      if (t.name == "ordered") {
        return (this.omapClass(t))
      }
      return (((("[" + mk) + ":") + mv) + "]")
    }
    if (k == "set") {
      def sk:string (this.rtype((t.arg(0))))
      if (sk == "") {
        return ""
      }
      return (("[" + sk) + ":boolean]")
    }
    if (k == "opt") {
      return (this.rtype((t.arg(0))))
    }
    if (k == "tuple") {
      return (this.tupleClass(t))
    }
    if (k == "fn") {
      def n:int (array_length t.args)
      def ps:[string]
      def i:int 0
      while (i < (n - 1)) {
        push ps ((("p" + (to_string i)) + ":") + (this.rtype((t.arg(i)))))
        i = i + 1
      }
      return (((("(fn:" + (this.rtype((t.arg((n - 1)))))) + " (") + (join ps " ")) + "))")
    }
    if (k == "named") {
      if (t.isDyn && (has traits t.name)) {
        return (this.dynUnion(t.name))
      }
      if ((array_length t.args) > 0) {
        return (this.instanceClass(t))
      }
      return (this.className(t.name))
    }
    if (k == "result") {
      return (this.resultClass(t))
    }
    return ""
  }

  ; `def name:T` / `def name@(optional):T` / `def name` for a type.
  fn declText:string (rname:string t:RsType) {
    def s:string rname
    if (t.kind == "opt") {
      ; `Option<Weak<T>>` is an optional weak reference; a late field is
      ; optional to the generated code, present to `-strict` (R7)
      def inner:RsType (t.arg(0))
      if (t.late && declLate) {
        s = s + "@(late)"
      } {
        if inner.weak {
          s = s + "@(optional weak)"
        } {
          s = s + "@(optional)"
        }
      }
    } {
      if (t.weak) {
        s = s + "@(weak)"
      }
    }
    def tt:string (this.rtype(t))
    if (tt != "") {
      s = (s + ":") + tt
    }
    return s
  }

  fn isCopyStruct:boolean (t:RsType) {
    if (t.kind != "named") {
      return false
    }
    if (has structs t.name) {
      def s:RsStruct (unwrap (get structs t.name))
      return (s.derivesTrait("Copy"))
    }
    return false
  }

  ; ------------------------------------------------ generated concrete classes

  fn tupleClass:string (t:RsType) {
    def parts:[string]
    for t.args a:RsType i {
      push parts (this.mangleKey(a))
    }
    def name:string ("RsTup_" + (join parts "_"))
    if (false == (has genNames name)) {
      set genNames name true
      def lines:[string]
      push lines (("class " + name) + " {")
      def ci:int 0
      def cps:[string]
      for t.args a2:RsType j {
        push lines (("  def " + (this.fieldDecl(("f" + (to_string ci)) a2))))
        push cps (this.declText(("a" + (to_string ci)) a2))
        ci = ci + 1
      }
      push lines (("  Constructor (" + (join cps " ")) + ") {")
      def ck:int 0
      for t.args a4:RsType j3 {
        push lines (((("    this.f" + (to_string ck)) + " = a") + (to_string ck)))
        ck = ck + 1
      }
      push lines "  }"
      push lines (("  fn rs_clone:" + name) + " () {")
      def cargs:[string]
      def cj:int 0
      for t.args a3:RsType j2 {
        push cargs (this.cloneCode(("this.f" + (to_string cj)) a3))
        cj = cj + 1
      }
      push lines (((("    return (new " + name) + "(") + (join cargs " ")) + "))")
      push lines "  }"
      push lines ("}" + (this.helperDoc((("A Rust tuple `" + (t.rust())) + "`: its parts are f0, f1, …"))))
      push genOut (join lines "\n")
    }
    return name
  }

  fn mangleKey:string (t:RsType) {
    def k:string (t.key())
    def out:string ""
    def cs:[int] (to_chars k)
    for cs c:int i {
      if (((c >= 48) && (c <= 57)) || ((c >= 65) && (c <= 90)) || ((c >= 97) && (c <= 122)) || (c == 95)) {
        out = out + (strfromcode c)
      }
    }
    return out
  }

  ; `name:T default` for a class field. A field of a struct, enum, tuple or
  ; Result type starts with that type's zero, so it is never optional: an
  ; optional object field has to be unwrapped wherever it is passed on, and
  ; on Go an optional union field does not unwrap (ISSUES.md #102).
  fn fieldDecl:string (name:string t:RsType) {
    ; `@(late)` is for the field only; a local copy of it is optional
    declLate = true
    def d:string (this.declText(name t))
    declLate = false
    def dv:string (this.defaultValue(t))
    if (dv != "") {
      return ((d + " ") + dv)
    }
    if ((t.kind == "named") || (t.kind == "tuple") || (t.kind == "result")) {
      if (false == t.weak) {
        def z:string (this.zeroCode(t))
        if (z != "") {
          return ((d + " ") + z)
        }
      }
    }
    return d
  }

  fn defaultValue:string (t:RsType) {
    if (t.kind == "opt") {
      return ""
    }
    def k:string t.kind
    if (k == "int") {
      return "0"
    }
    if (k == "double") {
      return "0.0"
    }
    if (k == "bool") {
      return "false"
    }
    if ((k == "string") || (k == "char")) {
      return "\"\""
    }
    if ((k == "map") && (t.name == "ordered")) {
      return (("(new " + (this.omapClass(t))) + "())")
    }
    return ""
  }

  ; A value of type `t` to start a temporary with: temporaries are never
  ; optional, so returning one needs no unwrap (optional shape values do not
  ; unwrap on Go). "" when a bare declaration is fine (collections, Option).
  fn zeroCode:string (t:RsType) {
    def dv:string (this.defaultValue(t))
    if (dv != "") {
      return dv
    }
    def k:string t.kind
    if (k == "vec") {
      def et:string (this.rtype((t.arg(0))))
      if (et != "") {
        return (("([] _:" + et) + " ())")
      }
      return ""
    }
    if (k == "named") {
      if (t.isDyn && (has traits t.name)) {
        def tr:RsTrait (unwrap (get traits t.name))
        if ((array_length tr.implementors) > 0) {
          def first:string (itemAt tr.implementors 0)
          return (this.zeroCode((RsType.named(first))))
        }
        return ""
      }
      if (has structs t.name) {
        if ((array_length t.args) > 0) {
          return (("(" + (this.rtype(t))) + ".zeroOf())")
        }
        return (("(" + (this.className(t.name))) + ".zeroOf())")
      }
      if (has enums t.name) {
        def e:RsEnum (unwrap (get enums t.name))
        if (e.plain) {
          def v0:RsVariant (itemAt e.variants 0)
          return (((this.className(t.name)) + ".") + v0.name)
        }
        return (("(" + (this.implClass(t.name))) + ".zeroOf())")
      }
    }
    if (k == "tuple") {
      def zs:[string]
      for t.args a:RsType i {
        push zs (this.zeroCode(a))
      }
      return (((("(new " + (this.tupleClass(t))) + "(") + (join zs " ")) + "))")
    }
    if (k == "result") {
      return (("(" + (this.resultClass(t))) + ".zeroOf())")
    }
    return ""
  }

  ; `def name:T <zero>` for a temporary.
  fn tempDecl:string (name:string t:RsType) {
    def z:string (this.zeroCode(t))
    if ((z != "") && (t.kind != "opt")) {
      return (((this.declText(name t)) + " ") + z)
    }
    return (this.declText(name t))
  }

  ; A deep copy of `code` for `.clone()`, as Rust's derived Clone makes it.
  ; Only an expression: collections copy through a generated class method.
  fn cloneCode:string (code:string t:RsType) {
    def k:string t.kind
    if (t.shared) {
      ; Rc::clone shares
      return code
    }
    if (this.isDataEnum(t)) {
      return (((("(" + (this.implClass(t.name))) + ".cloneOf(") + code) + "))")
    }
    if ((k == "named") && ((has structs t.name) || ((array_length t.args) > 0))) {
      return (("(" + code) + ".rs_clone())")
    }
    if ((k == "tuple")) {
      return (("(" + code) + ".rs_clone())")
    }
    if ((k == "map") && (t.name == "ordered")) {
      return (("(" + code) + ".rs_clone())")
    }
    if ((k == "vec") || (k == "map") || (k == "set")) {
      return ((("(" + (this.collectionCloner(t))) + "(") + (code + "))"))
    }
    return code
  }

  ; A static helper that copies a collection element by element.
  fn collectionCloner:string (t:RsType) {
    def key:string ("c_" + (this.mangleKey(t)))
    def name:string ("RsClone." + key)
    if (has genNames key) {
      return name
    }
    set genNames key true
    def rt:string (this.rtype(t))
    def lines:[string]
    push lines (((("  sfn " + key) + ":") + rt) + ((" (src:" + rt) + ") {"))
    push lines ("    def out:" + rt)
    if (t.kind == "vec") {
      push lines "    def n:int (array_length src)"
      push lines "    def i:int 0"
      push lines "    while (i < n) {"
      push lines (("      def e:" + (this.rtype((t.arg(0))))) + " (itemAt src i)")
      push lines ("      push out " + (this.cloneCode("e" (t.arg(0)))))
      push lines "      i = i + 1"
      push lines "    }"
    } {
      push lines ((("    def ks:[" + (this.rtype((t.arg(0))))) + "] ") + (this.mapKeysCode("src" (RsType.of2("map" (t.arg(0)) (t.arg(0)))))))
      push lines "    def n:int (array_length ks)"
      push lines "    def i:int 0"
      push lines "    while (i < n) {"
      push lines (("      def k:" + (this.rtype((t.arg(0))))) + " (itemAt ks i)")
      if (t.kind == "set") {
        push lines "      set out k true"
      } {
        push lines (("      def v:" + (this.rtype((t.arg(1))))) + " (unwrap (get src k))")
        push lines ("      set out k " + (this.cloneCode("v" (t.arg(1)))))
      }
      push lines "      i = i + 1"
      push lines "    }"
    }
    push lines "    return out"
    push lines "  }"
    push clonerOut (join lines "\n")
    return name
  }

  def clonerOut:[string]

  ; The class written for one instantiation of a generic struct.
  fn instanceClass:string (t:RsType) {
    def name:string (this.mangleKey(t))
    if (false == (has structs t.name)) {
      this.err((new RustNode("none")) (("generic type `" + (t.rust())) + "` is not a struct of this module"))
      return name
    }
    for t.args a:RsType i {
      if ((a.kind == "param") || (a.isUnknown())) {
        ; still generic: the caller is itself being lowered generically
        return name
      }
    }
    if (false == (has structInstNames name)) {
      set structInstNames name true
      def inst:RsInst (new RsInst())
      inst.name = name
      inst.ty = t
      def s:RsStruct (unwrap (get structs t.name))
      inst.env = (this.envFor(s.generics t.args))
      push structInstQueue inst
    }
    return name
  }

  fn envFor:[string:RsType] (names:[string] args:[RsType]) {
    def env:[string:RsType]
    def i:int 0
    for names n:string j {
      if (i < (array_length args)) {
        set env n (itemAt args i)
      }
      i = i + 1
    }
    return env
  }

  ; `t` with generic names replaced by their bindings in `env`.
  fn subst:RsType (t:RsType env:[string:RsType]) {
    if (t.kind == "param") {
      if (has env t.name) {
        def b:RsType ((unwrap (get env t.name)).copy())
        b.isRef = t.isRef
        b.isMutRef = t.isMutRef
        return b
      }
      return t
    }
    if ((array_length t.args) == 0) {
      return t
    }
    def c:RsType (t.copy())
    def na:[RsType]
    for t.args a:RsType i {
      push na (this.subst(a env))
    }
    c.args = na
    return c
  }

  ; Binds the generic names in `pt` from the argument type `at`.
  fn unify:void (pt:RsType at:RsType env:[string:RsType]) {
    if (at.isUnknown()) {
      return
    }
    if (pt.kind == "param") {
      if (false == (has env pt.name)) {
        def b:RsType (at.copy())
        b.isRef = false
        b.isMutRef = false
        set env pt.name b
      }
      return
    }
    if (pt.kind != at.kind) {
      return
    }
    def i:int 0
    for pt.args a:RsType j {
      if (i < (array_length at.args)) {
        this.unify(a (itemAt at.args i) env)
      }
      i = i + 1
    }
  }

  ; A struct's field type as seen through an instance (`Stack<i64>`).
  fn fieldTypeOf:RsType (s:RsStruct f:RsField owner:RsType) {
    if ((array_length s.generics) == 0) {
      return f.ty
    }
    def env:[string:RsType] (this.envFor(s.generics owner.args))
    return (this.subst(f.ty env))
  }

  ; A method signature as seen through the receiver's instance.
  fn methodEnv:[string:RsType] (owner:RsType) {
    if ((owner.kind == "named") && (has structs owner.name)) {
      def s:RsStruct (unwrap (get structs owner.name))
      return (this.envFor(s.generics owner.args))
    }
    def none:[string:RsType]
    return none
  }

  ; A call of a generic free function: bind its type parameters from the
  ; arguments (and a turbofish), write the instance once, call it.
  fn lowerGenericCall:RsExpr (f:RsFn args:[RustNode] targs:RustNode expect:RsType at:RustNode) {
    def env:[string:RsType]
    if (targs.kind == "args") {
      def ti:int 0
      for targs.kids ta:RustNode tj {
        if (ti < (array_length f.generics)) {
          set env (itemAt f.generics ti) (this.typeOf(ta))
        }
        ti = ti + 1
      }
    }
    def vals:[RsExpr]
    def i:int 0
    for args a:RustNode j {
      def pt:RsType (RsType.mk("unknown"))
      if (i < (array_length f.params)) {
        def p:RsParam (itemAt f.params i)
        pt = (this.subst(p.ty env))
      }
      def want:RsType pt
      if (this.hasParam(pt)) {
        want = (RsType.mk("unknown"))
      }
      def v:RsExpr (this.lowerExprCopy(a want))
      if (i < (array_length f.params)) {
        def p2:RsParam (itemAt f.params i)
        this.unify(p2.ty v.ty env)
      }
      push vals v
      i = i + 1
    }
    if (this.hasParam(f.ret)) {
      this.unify(f.ret expect env)
    }
    def keys:[string]
    for f.generics g:string gi {
      if (false == (has env g)) {
        this.err(at (((("cannot infer the type parameter `" + g) + "` of `") + f.name) + "`: add a turbofish `::<…>`"))
        return (this.unit())
      }
      def gt:RsType (unwrap (get env g))
      push keys (this.mangleKey(gt))
    }
    def name:string ((f.rname + "__") + (join keys "_"))
    if (false == (has fnInstNames name)) {
      set fnInstNames name true
      def inst:RsInst (new RsInst())
      inst.name = name
      inst.fnDef = f
      inst.env = env
      push fnInstQueue inst
    }
    def codes:[string]
    def k:int 0
    for vals v2:RsExpr vj {
      def pt2:RsType (RsType.mk("unknown"))
      if (k < (array_length f.params)) {
        def p3:RsParam (itemAt f.params k)
        pt2 = (this.subst(p3.ty env))
      }
      def c:RsExpr (this.coerce(v2 pt2 (itemAt args k)))
      push codes c.code
      k = k + 1
    }
    return (RsExpr.of((((((("(" + modClass) + ".") + name) + "(") + (join codes " ")) + "))") (this.subst(f.ret env))))
  }

  ; `Stack::new()` of a generic struct: the instance comes from the expected
  ; type, from `Self` inside the struct's own impl, or from the arguments.
  fn genericAssocCall:RsExpr (s:RsStruct m:RsFn args:[RustNode] expect:RsType at:RustNode) {
    def inst:RsType (RsType.named(s.name))
    if ((expect.kind == "named") && (expect.name == s.name) && ((array_length expect.args) > 0)) {
      inst = expect
    } {
      if ((selfType == s.name) && ((array_length selfArgs) > 0)) {
        for selfArgs sa:RsType i {
          push inst.args sa
        }
      }
    }
    def env:[string:RsType] (this.envFor(s.generics inst.args))
    def vals:[RsExpr]
    def k:int 0
    for args a:RustNode j {
      def pt:RsType (RsType.mk("unknown"))
      if (k < (array_length m.params)) {
        def p:RsParam (itemAt m.params k)
        pt = (this.subst(p.ty env))
        if (this.hasParam(pt)) {
          pt = (RsType.mk("unknown"))
        }
      }
      def v:RsExpr (this.lowerExprCopy(a pt))
      if (k < (array_length m.params)) {
        def p2:RsParam (itemAt m.params k)
        this.unify(p2.ty v.ty env)
      }
      push vals v
      k = k + 1
    }
    if ((array_length inst.args) == 0) {
      for s.generics g:string gi {
        if (has env g) {
          push inst.args (unwrap (get env g))
        } {
          this.err(at (((("cannot infer the type parameter `" + g) + "` of `") + s.name) + "`: annotate the `let`"))
          return (this.unit())
        }
      }
    }
    def codes:[string]
    for vals v2:RsExpr vj {
      push codes v2.code
    }
    def cls:string (this.rtype(inst))
    if (m.hasSelf) {
      this.err(at (("`" + m.name) + "` takes self: call it as a method"))
    }
    return (RsExpr.of((((((("(" + cls) + ".") + (this.staticName(m.name))) + "(") + (join codes " ")) + "))") (this.subst(m.ret env))))
  }

  fn hasParam:boolean (t:RsType) {
    if (t.kind == "param") {
      return true
    }
    for t.args a:RsType i {
      if (this.hasParam(a)) {
        return true
      }
    }
    return false
  }

  ; ------------------------------------------------------- trait objects

  ; `dyn Trait` / `impl Trait` is a union of the structs implementing it,
  ; with a dispatcher per method.
  fn dynUnion:string (traitName:string) {
    def name:string ("Dyn" + traitName)
    if (false == (has dynNames name)) {
      set dynNames name true
      push dynQueue traitName
    }
    return name
  }

  fn emitDyn:string (traitName:string) {
    def tr:RsTrait (unwrap (get traits traitName))
    def uname:string ("Dyn" + traitName)
    def members:[string]
    for tr.implementors im:string i {
      if (has enums im) {
        this.unsupported((new RustNode("none")) (((("the enum `" + im) + "` as a `dyn ") + traitName) + "` (only structs)"))
        continue
      }
      push members (this.className(im))
    }
    if ((array_length members) == 0) {
      this.err((new RustNode("none")) (("no struct implements `" + traitName) + "`"))
      return ""
    }
    def lines:[string]
    push lines (((("union " + uname) + " (") + (join members " ")) + ")")
    push lines (("class " + uname) + "_ops {")
    for tr.methods m:RsFn mi {
      if (false == m.hasSelf) {
        continue
      }
      def ps:[string]
      def as:[string]
      push ps ("x:" + uname)
      def pi:int 0
      for m.params p:RsParam pj {
        def pn:string ("a" + (to_string pi))
        push ps (this.declText(pn p.ty))
        push as pn
        pi = pi + 1
      }
      def rt:string (this.rtype(m.ret))
      if (rt == "") {
        rt = "void"
      }
      def head:string ((("  sfn " + (this.staticName(m.name))) + ":") + rt)
      if (m.ret.kind == "opt") {
        head = ((("  sfn " + (this.staticName(m.name))) + "@(optional):") + rt)
      }
      push lines (((head + " (") + (join ps " ")) + ") {")
      def hasRet:boolean ((m.ret.kind != "unit") && (m.ret.kind != "never"))
      if (hasRet) {
        push lines ("    def r:" + ((this.tempDecl2(m.ret))))

  fn isDataEnum:boolean (t:RsType) {
    if ((t.kind == "named") && (has enums t.name)) {
      def e:RsEnum (unwrap (get enums t.name))
      return (false == e.plain)
    }
    return false
  }

  fn isEnumType:boolean (t:RsType) {

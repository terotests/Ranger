  ; A tuple variant named without arguments, used as a function value.
  fn variantCtorValue:RsExpr (e:RsEnum v:RsVariant at:RustNode) {
    def ps:[string]
    def as:[string]
    def ft:RsType (RsType.mk("fn"))

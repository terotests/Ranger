; SPDX-License-Identifier: MIT

Import "TraitAnalysis.rgr"
Import "ForLoopAnalysis.rgr"
Import "EnumAnalysis.rgr"

class RangerGolangClassWriter {
  Extends (RangerGenericClassWriter)
  def compiler:LiveCompiler
  def thisName:string "this"
  def write_raw_type:boolean false
  ; which behaviour-only Ranger `trait`s become a Go interface -- the same
  ; question every target with interfaces asks, answered in one place
  def goTraits:TraitInterfaceAnalysis (new TraitInterfaceAnalysis())
  ; can a `for` be a `range`? target-neutral question, one place
  def goLoops:ForLoopShape (new ForLoopShape())
  def did_write_nullable:boolean false
  def did_write_sseclient:boolean false
  ; S5 (PLAN_SHAPES.md): a sealable union is a tagged struct with one pointer
  ; field per variant. Construction wraps a case into the handle; narrowing
  ; switches on the tag. Replaces the earlier marker-interface step.
  def go_unions_written:boolean false

  ; which Ranger `Enum`s survive as a Go named type rather than a bare int64.
  ; Same question Rust and C++ ask: compiler/EnumAnalysis.rgr.
  def goEnums:EnumNativeAnalysis (new EnumNativeAnalysis())
  def go_enums_written:boolean false

  fn goEnumIsNative:boolean (enumName:string ctx:RangerAppWriterContext) {
    goEnums.targetName = "go"
    goEnums.fallbackType = "int64"
    return (goEnums.isNative(enumName ctx))
  }

  ; Go has no member namespace, so `Color.Green` becomes the constant
  ; `ColorGreen` of the named type `Color`. The prefix is what every Go
  ; codebase writes for the same reason, and it keeps two enums that share a
  ; member name apart.
  fn goEnumMemberName:string (enumName:string memberName:string ctx:RangerAppWriterContext) {
    return (enumName + (ctx.transformWord(memberName)))
  }

  ; `type Color int64` plus a const block. The underlying type is int64 --
  ; the type the fallback lowering uses -- so a conversion back is exact.
  fn writeGoNativeEnums:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    if go_enums_written {
      return
    }
    go_enums_written = true
    def enumRoot:RangerAppWriterContext (ctx.getRoot())
    for (keys enumRoot.definedEnums) gen:string gei {
      if (this.goEnumIsNative(gen ctx)) {
        def geDef:RangerAppEnum (unwrap (get enumRoot.definedEnums gen))
        wr.out("" true)
        wr.out(("type " + gen + " int64") true)
        wr.out("const (" true)
        wr.indent(1)
        for (keys geDef.values) gmn:string gmi {
          def gmv:int (unwrap (get geDef.values gmn))
          wr.out(((this.goEnumMemberName(gen gmn ctx)) + " " + gen + " = " + (to_string gmv)) true)
        }
        wr.indent(-1)
        wr.out(")" true)
      }
    }
  }
  fn writeGoUnionStructs:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    if go_unions_written {
      return
    }
    go_unions_written = true
    def names:[string] (this.sealableUnionNames(ctx))
    for names uname:string ui {
      def ucl:RangerAppClassDesc (ctx.findClass(uname))
      def iface:string (this.unionInterfaceName(uname))
      wr.out("" true)
      wr.out("const (" true)
      wr.indent(1)
      def tagIdx:int 1
      for ucl.is_union_of mname:string mi {
        wr.out((((((iface + "_tag_") + mname) + " = ") + tagIdx) + "") true)
        tagIdx = tagIdx + 1
      }
      wr.indent(-1)
      wr.out(")" true)
      wr.out((("type " + iface) + " struct {") true)
      wr.indent(1)
      wr.out("tag int" true)
      for ucl.is_union_of mname2:string mi2 {
        wr.out(((mname2 + " *") + mname2) true)
      }
      wr.indent(-1)
      wr.out("}" true)
      for ucl.is_union_of mname3:string mi3 {
        def mk:string (((("func mk_" + iface) + "_") + mname3) + "(p *")
        wr.out(((((mk + mname3) + ") ") + iface) + " {") true)
        wr.indent(1)
        wr.out((("return " + iface) + "{") true)
        wr.indent(1)
        wr.out((((( "tag: " + iface) + "_tag_") + mname3) + ",") true)
        wr.out((mname3 + ": p,") true)
        wr.indent(-1)
        wr.out("}" true)
        wr.indent(-1)
        wr.out("}" true)
      }
    }
  }

  ; Declared class of a value node (new → constructed class, name → its type).
  fn goDeclaredClassOf:string (nVal:CodeNode) {
    if nVal.hasNewOper {
      def newClOpt@(optional):RangerAppClassDesc nVal.clDesc
      if (!null? newClOpt) {
        def newCl:RangerAppClassDesc (unwrap newClOpt)
        return newCl.name
      }
    }
    if nVal.hasParamDesc {
      def pd:RangerAppParamDesc nVal.paramDesc
      def pdNN@(optional):CodeNode pd.nameNode
      if (!null? pdNN) {
        def pdNode:CodeNode (unwrap pdNN)
        return pdNode.type_name
      }
    }
    if ((strlen nVal.eval_type_name) > 0) {
      return nVal.eval_type_name
    }
    return ""
  }

  fn goUnionHasMember:boolean (ucl:RangerAppClassDesc memberName:string) {
    return ((indexOf ucl.is_union_of memberName) >= 0)
  }

  ; Writes a value into a union-typed slot. A MEMBER is wrapped with mk_<union>_<case>;
  ; a value already of the family is written as-is. Returns true when it wrote.
  fn goWriteUnionValue:boolean (targetTypeName:string nVal:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if ((strlen targetTypeName) == 0) {
      return false
    }
    ; hasClass first: findClass ends in `(unwrap (get definedClasses name))`
    ; with no guard of its own, which answers undefined on JavaScript and
    ; PANICS on Go -- "interface conversion: interface {} is nil". Generating
    ; Go from the Go build stopped here.
    if ((ctx.hasClass(targetTypeName)) == false) {
      return false
    }
    def tcOpt@(optional):RangerAppClassDesc (ctx.findClass(targetTypeName))
    if (null? tcOpt) {
      return false
    }
    def target:RangerAppClassDesc (unwrap tcOpt)
    if ((this.unionIsSealable(target ctx)) == false) {
      return false
    }
    def enumName:string (this.unionInterfaceName(targetTypeName))
    def valClass:string (this.goDeclaredClassOf(nVal))
    if (this.goUnionHasMember(target valClass)) {
      wr.out((((("mk_" + enumName) + "_") + valClass) + "(") false)
      ctx.setInExpr()
      this.WalkNode(nVal ctx wr)
      ctx.unsetInExpr()
      wr.out(")" false)
      return true
    }
    ; already a handle of the family (or unknown) — pass through
    ctx.setInExpr()
    this.WalkNode(nVal ctx wr)
    ctx.unsetInExpr()
    return true
  }

  fn goWriteUnionArg:boolean (arg:RangerAppParamDesc nVal:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def argNN@(optional):CodeNode arg.nameNode
    if (null? argNN) {
      return false
    }
    def argNameNode:CodeNode (unwrap argNN)
    return (this.goWriteUnionValue(argNameNode.type_name nVal ctx wr))
  }
 
  fn WriteScalarValue:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    switch node.value_type {
      case RangerNodeType.Double {
        ; the value, never a source slice: getParsedString reads the file by
        ; the node's recorded position, and a macro-shifted position slices
        ; unrelated bytes into the output
        def dd_str ("" + node.double_value)
        if (this.doubleNeedsPointZero(dd_str)) {
          wr.out((dd_str + ".0") false)
        } {
          wr.out(dd_str false)
        }
      }
      case RangerNodeType.String {
        def s:string (this.EncodeString(node ctx wr))
        wr.out((("\"" + s) + "\"") false)
      }
      case RangerNodeType.Integer {
        wr.out(("int64(" + node.int_value+")") false)
      }
      case RangerNodeType.Boolean {
        if node.boolean_value {
          wr.out("true" false)
        } {
          wr.out("false" false)
        }
      }
    }
  }
  ; True for a type name that is itself a collection: the Ranger spelling
  ; "[string]" or "[string:[int]]". Only a collection NESTED in another one
  ; reaches the writer this way -- the outer one arrives as a value_type with a
  ; separate key_type and array_type.
  fn isCollectionTypeString:boolean (type_string:string) {
    if ((strlen type_string) >= 2) {
      if ((charAt type_string 0) == (ccode "[")) {
        return true
      }
    }
    return false
  }

  ; Convert nested collection type strings such as "[string]" or
  ; "[string:[int]]" into Go slice / map types. Without this the fallthrough at
  ; the end of getObjectTypeString returned the Ranger spelling unchanged and
  ; the field came out as `map[string]*[string]`.
  fn collectionTypeStringToGo:string (type_string:string ctx:RangerAppWriterContext) {
    def n:int (strlen type_string)
    def inner:string (substring type_string 1 (n - 1))
    def il:int (strlen inner)
    def depth:int 0
    def sep:int (0 - 1)
    def i:int 0
    while (i < il) {
      def c:int (charAt inner i)
      if (c == (ccode "[")) {
        depth = depth + 1
      }
      if (c == (ccode "]")) {
        depth = depth - 1
      }
      if ((c == (ccode ":")) && (depth == 0)) {
        sep = i
      }
      i = i + 1
    }
    if (sep >= 0) {
      def kt:string (substring inner 0 sep)
      def vt:string (substring inner (sep + 1) il)
      return ((("map[" + (this.getObjectTypeString(kt ctx))) + "]") + (this.goElementTypeString(vt ctx)))
    }
    return ("[]" + (this.goElementTypeString(inner ctx)))
  }

  ; The element of a Go collection: a class is held as a pointer, a primitive
  ; and a nested collection are not -- a slice and a map are already reference
  ; types and `*[]string` is not the same thing.
  fn goElementTypeString:string (type_string:string ctx:RangerAppWriterContext) {
    if (this.isCollectionTypeString(type_string)) {
      return (this.collectionTypeStringToGo(type_string ctx))
    }
    if (ctx.isDefinedClass(type_string)) {
      def cc:RangerAppClassDesc (ctx.findClass(type_string))
      if cc.is_union {
        return (this.getObjectTypeString(type_string ctx))
      }
    }
    if (ctx.isPrimitiveType(type_string)) {
      return (this.getObjectTypeString(type_string ctx))
    }
    if (this.goIsTypeParam(type_string ctx)) {
      return (this.getObjectTypeString(type_string ctx))
    }
    return ("*" + (this.getObjectTypeString(type_string ctx)))
  }

  ; --- native generics: `type History[Op any] struct`, `*History[int64]` ---
  fn goClassRef:string (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    if cl.is_type_param {
      return cl.type_param_name
    }
    if (ctx.isNativeGenericInstance(cl)) {
      def res:string (cl.generic_template + "[")
      for cl.generic_args a:string i {
        if (i > 0) {
          res = (res + ", ")
        }
        res = (res + (this.goElementTypeString(a ctx)))
      }
      return (res + "]")
    }
    return (ctx.transformTypeName(cl.name))
  }
  ; a type parameter is written bare: no `*` in front of it
  fn goIsTypeParam:boolean (type_string:string ctx:RangerAppWriterContext) {
    if (ctx.isDefinedClass(type_string)) {
      def cc:RangerAppClassDesc (ctx.findClass(type_string))
      return cc.is_type_param
    }
    return false
  }

  fn getObjectTypeString:string (type_string:string ctx:RangerAppWriterContext) {
    if (type_string == "this") {
      return thisName
    }

    if (this.isCollectionTypeString(type_string)) {
      return (this.collectionTypeStringToGo(type_string ctx))
    }

    if(ctx.isDefinedClass(type_string)) {
      def cc:RangerAppClassDesc (ctx.findClass(type_string))
      if (cc.is_type_param || (ctx.isNativeGenericInstance(cc))) {
        return (this.goClassRef(cc ctx))
      }

      if(cc.is_union) {
        return (this.sealableUnionTypeOr(type_string "interface{}" ctx))
      }

      if(cc.doesInherit()) {
        return "IFACE_" + (ctx.transformTypeName(type_string))
      }
    }
    
    switch type_string {
      case "int" {
        return "int64"
      }
      case "string" {
        return "string"
      }
      case "boolean" {
        return "bool"
      }
      case "double" {
        return "float64"
      }
      case "char" {
        return "byte"
      }
      case "charbuffer" {
        return "[]byte"
      }
      case "buffer" {
        return "[]byte"
      }
      case "int_buffer" {
        return "[]int64"
      }
      case "double_buffer" {
        return "[]float64"
      }
      ; HTTP system types
      case "HttpRequest" {
        return "*http.Request"
      }
      case "HttpResponse" {
        return "http.ResponseWriter"
      }
      case "SSEClient" {
        return "*SSEClient"
      }
      case "HttpServer" {
        return "*http.Server"
      }
    }
    return (ctx.transformTypeName(type_string))
  }
  fn getTypeString2:string (type_string:string ctx:RangerAppWriterContext) {
    if (type_string == "this") {
      return thisName
    }
    switch type_string {
      case "int" {
        return "int64"
      }
      case "string" {
        return "string"
      }
      case "boolean" {
        return "bool"
      }
      case "double" {
        return "float64"
      }
      case "char" {
        return "byte"
      }
      case "charbuffer" {
        return "[]byte"
      }
      case "buffer" {
        return "[]byte"
      }
      case "int_buffer" {
        return "[]int64"
      }
      case "double_buffer" {
        return "[]float64"
      }
      ; HTTP system types
      case "HttpRequest" {
        return "*http.Request"
      }
      case "HttpResponse" {
        return "http.ResponseWriter"
      }
      case "SSEClient" {
        return "*SSEClient"
      }
      case "HttpServer" {
        return "*http.Server"
      }
    }

    if(ctx.isDefinedClass(type_string)) {
      def cc:RangerAppClassDesc (ctx.findClass(type_string))
      if (cc.is_type_param || (ctx.isNativeGenericInstance(cc))) {
        return (this.goClassRef(cc ctx))
      }
      if(cc.is_union) {
        return (this.sealableUnionTypeOr(type_string "interface{}" ctx))
      }
    }    
    return (ctx.transformTypeName(type_string))
  }
  fn writeRawTypeDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    write_raw_type = true
    this.writeTypeDef(node ctx wr)
    write_raw_type = false
  }
  fn writeTypeDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    this.writeTypeDef2(node ctx wr)
  }

  fn writeArrayTypeDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
        
    def v_type:RangerNodeType node.value_type    
    def a_name:string node.array_type

    if ((v_type == RangerNodeType.Object) || (v_type == RangerNodeType.VRef) || (v_type == RangerNodeType.NoType)) {
      v_type = (node.typeNameAsType(ctx))
    }
    if (node.eval_type != RangerNodeType.NoType) {
      v_type = node.eval_type
      if ( (strlen node.eval_array_type) > 0 ) {
        a_name = node.eval_array_type
      }
    }

    switch v_type {

      case RangerNodeType.Hash {
        if(ctx.isDefinedClass(a_name)) {
          def cc:RangerAppClassDesc (ctx.findClass(a_name))
          if(cc.is_union) {
            wr.out((this.getObjectTypeString(a_name ctx)) false)
            return
          }
          if(cc.doesInherit()) {
            wr.out("IFACE_" + (this.getTypeString2(a_name ctx)) , false)
            return
          }
        }                    
        ; a nested collection is already a reference type: *[]string is not it
        if ( ((ctx.isPrimitiveType(a_name)) == false) && ((this.isCollectionTypeString(a_name)) == false) ) {
          wr.out("*" false)
        }
        wr.out(((this.getObjectTypeString(a_name ctx)) + "") , false)
      }
      
      case RangerNodeType.Array {

        if(ctx.isDefinedClass(a_name)) {
          def cc:RangerAppClassDesc (ctx.findClass(a_name))
          if(cc.is_union) {
            wr.out((this.getObjectTypeString(a_name ctx)) false)
            return
          }
          if(cc.doesInherit()) {
            wr.out("IFACE_" + (this.getTypeString2(a_name ctx)) , false)
            return
          }
        }
        if ((write_raw_type == false) && ((ctx.isPrimitiveType(a_name)) == false) && ((this.isCollectionTypeString(a_name)) == false) && ((this.goIsTypeParam(a_name ctx)) == false)) {
          wr.out("*" false)
        }
        wr.out(((this.getObjectTypeString(a_name ctx)) + "") false)
      }
      default {

      }
    }
  }  


  fn writeTypeDef2:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
        
    def v_type:RangerNodeType node.value_type    
    def t_name:string node.type_name
    def a_name:string node.array_type
    def k_name:string node.key_type

  
    if ((v_type == RangerNodeType.Object) || (v_type == RangerNodeType.VRef) || (v_type == RangerNodeType.NoType)) {
      v_type = (node.typeNameAsType(ctx))
    }
    if (node.eval_type != RangerNodeType.NoType) {
      v_type = node.eval_type
      if ( (strlen node.eval_type_name) > 0 ) {
        t_name = node.eval_type_name
      }
      if ( (strlen node.eval_array_type) > 0 ) {
        a_name = node.eval_array_type
      }
      if ( (strlen node.eval_key_type) > 0 ) {
        k_name = node.eval_key_type
      }
    }

    switch v_type {
      case RangerNodeType.ExpressionType {
        def lambdaExpression:CodeNode (unwrap node.expression_value)
        def rv:CodeNode (itemAt lambdaExpression.children 0)
        def sec:CodeNode (itemAt lambdaExpression.children 1)
        def fc:CodeNode (sec.getFirst())
        wr.out("func(" false)

        for sec.children arg:CodeNode i {
          if( i > 0 ) {
            wr.out(", " false)
          }
          ; An optional is a *GoNullable everywhere else in the writer -- the
          ; struct field, the method parameter, the local. The function TYPE
          ; ignored the flag, so `callback:( fn:void (left@(optional):CodeNode
          ; …))` was declared as func(*CodeNode, …) while the lambda passed to
          ; it took *GoNullable, and neither side would accept the other.
          if (arg.hasFlag("optional")) {
            wr.out("*GoNullable" false)
          } {
            this.writeTypeDef2( arg ctx wr)
          }
        }
        wr.out( ") " false)
        if (rv.hasFlag("optional")) {
          wr.out("*GoNullable" false)
        } {
          this.writeTypeDef2( rv ctx wr)
        }
      }
      case RangerNodeType.Enum {
        def goEnumName:string (goEnums.enumNameOf(node ctx))
        if (this.goEnumIsNative(goEnumName ctx)) {
          wr.out(goEnumName false)
        } {
          wr.out("int64" false)
        }
      }
      case RangerNodeType.Integer {
        wr.out("int64" false)
      }
      case RangerNodeType.Double {
        wr.out("float64" false)
      }
      case RangerNodeType.String {
        wr.out("string" false)
      }
      case RangerNodeType.Boolean {
        wr.out("bool" false)
      }
      case RangerNodeType.Char {
        wr.out("byte" false)
      }
      case RangerNodeType.CharBuffer {
        wr.out("[]byte" false)
      }
      case RangerNodeType.Buffer {
        wr.out("[]byte" false)
      }
      case RangerNodeType.IntBuffer {
        wr.out("[]int64" false)
      }
      case RangerNodeType.DoubleBuffer {
        wr.out("[]float64" false)
      }
      case RangerNodeType.Hash {
        if write_raw_type {
          wr.out( ( (this.getObjectTypeString(a_name ctx) ) + "") , false)
        } {
          wr.out((("map[" + (this.getObjectTypeString(k_name ctx))) + "]") , false)

          if(ctx.isDefinedClass(a_name)) {
            def cc:RangerAppClassDesc (ctx.findClass(a_name))
            if(cc.is_union) {
              wr.out((this.getObjectTypeString(a_name ctx)) false)
              return
            }
            if(cc.doesInherit()) {
              wr.out("IFACE_" + (this.getTypeString2(a_name ctx)) , false)
              return
            }
          }
                    
          if ((write_raw_type == false) && ((ctx.isPrimitiveType(a_name)) == false) && ((this.isCollectionTypeString(a_name)) == false) && ((this.goIsTypeParam(a_name ctx)) == false)) {
            wr.out("*" false)
          }
          wr.out(((this.getObjectTypeString(a_name ctx)) + "") , false)
        }
      }
      case RangerNodeType.Array {
        if (false == write_raw_type) {
          wr.out("[]" false)
        }

        if(ctx.isDefinedClass(a_name)) {
          def cc:RangerAppClassDesc (ctx.findClass(a_name))
          if(cc.is_union) {
            wr.out((this.getObjectTypeString(a_name ctx)) false)
            return
          }          
          if(cc.doesInherit()) {
            wr.out("IFACE_" + (this.getTypeString2(a_name ctx)) , false)
            return
          }
        }

        if ((write_raw_type == false) && ((ctx.isPrimitiveType(a_name)) == false) && ((this.isCollectionTypeString(a_name)) == false) && ((this.goIsTypeParam(a_name ctx)) == false)) {
          wr.out("*" false)
        }
        wr.out(((this.getObjectTypeString(a_name ctx)) + "") false)
      }
      default {
        ; t_name, not node.type_name: an expression node carries its type in
        ; eval_type_name and leaves type_name empty, so testing the raw field
        ; wrote the placeholder `()` for `(unwrap (get map key))` -- which is
        ; an empty type assertion and does not parse.
        if( (t_name == "void") || (! (has t_name)) )  {
          (wr.out("()" false))
          return
        }

        ; Handle HTTP system types directly
        if (t_name == "HttpRequest") {
          wr.addImport("net/http")
          wr.out("*http.Request" false)
          return
        }
        if (t_name == "HttpResponse") {
          wr.addImport("net/http")
          wr.out("http.ResponseWriter" false)
          return
        }
        if (t_name == "SSEClient") {
          wr.out("*SSEClient" false)
          return
        }
        if (t_name == "HttpServer") {
          wr.addImport("net/http")
          wr.out("*http.Server" false)
          return
        }

        def b_iface false
        if(ctx.isDefinedClass(t_name)) {
          def cc:RangerAppClassDesc (ctx.findClass(t_name))
          b_iface = cc.is_interface
          if(cc.is_system) {
            def sysName (get cc.systemNames "go")
            if(!null? sysName) {
              wr.out( (unwrap sysName) false)
            } {
              ctx.addError(node ( "No system class " + t_name +  "defined for Go "))
            }
            return
          }
        }
        
        if(ctx.isDefinedClass(t_name)) {
          def cc:RangerAppClassDesc (ctx.findClass(t_name))

          if(cc.is_union) {
            wr.out((this.getObjectTypeString(t_name ctx)) false)
            return
          }
          if(cc.doesInherit()) {
            wr.out("IFACE_" + (this.getTypeString2(t_name ctx)) , false)
            return
          }
          ; A behaviour-only trait named as a type is a Go interface, written
          ; beside the ones a parent class gets. Go is structural, so *User
          ; and *Bot satisfy it by having the methods -- nothing has to
          ; declare that it does. An interface value is not a pointer, so this
          ; returns before the `*` below.
          if cc.is_trait {
            if (goTraits.isInterface(t_name ctx)) {
              wr.out("IFACE_" + (this.getTypeString2(t_name ctx)) , false)
              return
            }
            ; and one carrying FIELDS is not an interface: each consumer owns
            ; its own copy, so there is nothing for the interface to promise.
            ; It used to reach the file as `*Named`, which Go answers with
            ; "undefined: Named".
            ctx.addError(node (("the Go target writes a `trait` as a mixin, so `" + t_name) + "` is not a type it can name. A trait that declares only METHODS becomes a Go interface and can be used as a type; this one carries fields, which its consumers each hold their own copy of. Use a class with subclasses, or give the parameter a concrete type."))
          }
        }

        if ((write_raw_type == false) && ((node.isPrimitiveType()) == false) && (b_iface == false) && ((this.goIsTypeParam(t_name ctx)) == false)) {
          (wr.out("*" false))
        }        

        wr.out((this.getTypeString2(t_name ctx)) false))
      }
    }
  }

  fn WriteVRef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (node.vref == "this") {
      wr.out(thisName false)
      return
    }
    if (node.eval_type == RangerNodeType.Enum) {
      if( (array_length node.ns) > 1) {
        def rootObjName:string (itemAt node.ns 0)
        def enumName:string (itemAt node.ns 1)
        def e@(optional):RangerAppEnum (ctx.getEnum(rootObjName))
        if (!null? e) {
          ; `ColorGreen`, not `1`, when the enum survives as a Go type
          if (this.goEnumIsNative(rootObjName ctx)) {
            wr.out((this.goEnumMemberName(rootObjName enumName ctx)) false)
            return
          }
          wr.out(("" + (unwrap (get e.values enumName) ) ) false)
          return
        }
      }
    }

    def next_is_gs:boolean false
    def last_was_setter:boolean false
    def needs_par:boolean false    
    def ns_last:int ( (array_length node.ns) - 1)

    if ((array_length node.nsp) > 0) {
      def had_static:boolean false
     
      for node.nsp p:RangerAppParamDesc i {
 
        if next_is_gs {

          if(p.isProperty()) {
            wr.out(".Get_" false)
            needs_par = true
          } {
            needs_par = false
          }
          next_is_gs = false
        }         

        if (needs_par == false) {
          if (i > 0) {
            if had_static {
              wr.out("_static_" false)
            } {
              wr.out("." false)
            }
          }
        }

        if (!null? p.nameNode) {
          def parameterName:CodeNode (unwrap p.nameNode)
          if (ctx.isDefinedClass(parameterName.type_name)) {
            def c:RangerAppClassDesc (ctx.findClass(parameterName.type_name))
            if(c.doesInherit()) {
              next_is_gs = true
            }
          }
        }        
        if (i == 0) {
          def part:string (itemAt node.ns 0)

          if(part == "this") {
            wr.out(thisName false)
            continue
          } 

          def cc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
          if ((part != thisName) && (!null? cc) && (false == (ctx.isInStatic())) ) {
            def currC:RangerAppClassDesc (unwrap cc)
            def up@(optional):RangerAppParamDesc (currC.findVariable(part))  
            def lvDef (ctx.getVariableDef(part))          
            if ( (!null? up) && (lvDef.is_class_variable) ) {
              def p3:RangerAppParamDesc (unwrap up)
              wr.out((thisName + ".") false)
            }
          }
        }
        if ((strlen p.compiledName) > 0) {
          wr.out((this.adjustType(p.compiledName)) false)
        } {
          if ((strlen p.name) > 0) {
            wr.out((this.adjustType(p.name)) false)
          } {
            wr.out((this.adjustType( (itemAt node.ns i))) false)
          }
        }

        if needs_par {
          wr.out("()" false)
          needs_par = false
        }        

        if ( (!null? p.nameNode) && (p.nameNode.hasFlag("optional")) && ( i != ns_last)) {
          wr.out(".value.(" false)
          this.writeTypeDef( (unwrap p.nameNode ) ctx wr)
          wr.out(")" false)
        }

        if (p.isClass()) {
          had_static = true
        }

      }
      return
    }
    if node.hasParamDesc {
      def part:string (itemAt node.ns 0)
      def cc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
      
      if ((part != thisName) && (!null? cc) && (false == (ctx.isInStatic()))) {
;          def cc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
          def currC:RangerAppClassDesc (unwrap cc)
          def up@(optional):RangerAppParamDesc (currC.findVariable(part))
          def lvDef (ctx.getVariableDef(part))          
          if ( (!null? up) && (lvDef.is_class_variable) ) {
            def p3:RangerAppParamDesc (unwrap up)
            wr.out((thisName + ".") false)
          }
      }
      def p:RangerAppParamDesc node.paramDesc
      wr.out(p.compiledName false)
      return
    }
    def b_was_static:boolean false
    for node.ns part:string i {
      if (i > 0) {
        if ((i == 1) && b_was_static) {
          wr.out("_static_" false)
        } {
          wr.out("." false)
        }
      }
      if (i == 0) {

        if(part == "this") {
          wr.out(thisName false)
          continue
        }        

        if (ctx.hasClass(part)) {
          b_was_static = true
        }
        def cc@(optional):RangerAppClassDesc (ctx.getCurrentClass())      
        if ((part != "this") && (!null? cc) && (false == (ctx.isInStatic()))) {
          def currC:RangerAppClassDesc (unwrap cc)
          def up@(optional):RangerAppParamDesc (currC.findVariable(part))          
          def lvDef (ctx.getVariableDef(part))          
          if ( (!null? up) && (lvDef.is_class_variable) ) {

            def p3:RangerAppParamDesc (unwrap up)
            wr.out((thisName + ".") false)
          }
        }
      }
      wr.out((this.adjustType(part)) false)
    }
  }


  fn WriteSetterVRef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (node.vref == "this") {
      wr.out(thisName false)
      return
    }
    if (node.eval_type == RangerNodeType.Enum) {
      def rootObjName:string (itemAt node.ns 0)
      def enumName:string (itemAt node.ns 1)
      def e@(optional):RangerAppEnum (ctx.getEnum(rootObjName))
      if (!null? e) {
        ; `ColorGreen`, not `1`, when the enum survives as a Go type
        if (this.goEnumIsNative(rootObjName ctx)) {
          wr.out((this.goEnumMemberName(rootObjName enumName ctx)) false)
          return
        }
        wr.out(("" + (unwrap (get e.values enumName) ) ) false)
        return
      }
    }

    ; A `(goset N)` argument is normally a variable path -- this function writes
    ; the setter form of a vref. But `??` expands to
    ; `(? (!null? X) (unwrap X) Y)` and the `!null?` template reaches here with
    ; whatever X is: `(?? (get env.envVars name) "")` is a CALL, with no name
    ; path at all, and every loop below then wrote nothing -- the output was
    ; `if (.has_value)`. An expression is written as an expression.
    if ((array_length node.ns) == 0) {
      if (node.hasParamDesc == false) {
        this.WalkNode(node ctx wr)
        return
      }
    }

    def next_is_gs:boolean false
    def last_was_setter:boolean false
    def needs_par:boolean false

    def ns_len:int ((array_length node.ns) - 1)

    if ((array_length node.nsp) > 0) {
      def had_static:boolean false
     
      for node.nsp p:RangerAppParamDesc i {

        if next_is_gs {
          if(p.isProperty()) {
            wr.out(".Get_" false)
            needs_par = true
          } {
            needs_par = false
          }
          next_is_gs = false
        }         

        if (needs_par == false) {
          if (i > 0) {
            if had_static {
              wr.out("_static_" false)
            } {
              wr.out("." false)
            }
          }
        }

        if(!null? p.nameNode) {
          def parameterName:CodeNode (unwrap p.nameNode)
          if(ctx.isDefinedClass(parameterName.type_name)) {
            def c:RangerAppClassDesc (ctx.findClass(parameterName.type_name))
            if(c.doesInherit()) {
              next_is_gs = true
            }
          }
        }        
        if (i == 0) {
          def part:string (itemAt node.ns 0)

          if(part == "this") {
            wr.out(thisName false)
            continue
          } 

          def cc@(optional):RangerAppClassDesc (ctx.getCurrentClass())

          if ((part != thisName) && (!null? cc) && (false == (ctx.isInStatic()))) {
            def currC:RangerAppClassDesc (unwrap cc)
            def up@(optional):RangerAppParamDesc (currC.findVariable(part))            
            def lvDef (ctx.getVariableDef(part))          
            if ( (!null? up) && (lvDef.is_class_variable) ) {
              def p3:RangerAppParamDesc (unwrap up)
              wr.out((thisName + ".") false)
            }
          }
        }
        if ((strlen p.compiledName) > 0) {
          wr.out((this.adjustType(p.compiledName)) false)
        } {
          if ((strlen p.name) > 0) {
            wr.out((this.adjustType(p.name)) false)
          } {
            wr.out((this.adjustType( (itemAt node.ns i))) false)
          }
        }

        if needs_par {
          wr.out("()" false)
          needs_par = false
        }        

        ; i == 0
        if (i < (ns_len )) {
          if (p.nameNode.hasFlag("optional")) {
            wr.out(".value.(" false)
            this.writeTypeDef( ( unwrap p.nameNode )ctx wr)
            wr.out(")" false)
          }
        }        
        if (p.isClass()) {
          had_static = true
        }

      } 
      return
    }
    if node.hasParamDesc {
      def part:string (itemAt node.ns 0)
      def cc@(optional):RangerAppClassDesc (ctx.getCurrentClass())      
      if ((part != thisName) && (!null? cc) && (false == (ctx.isInStatic()))) {
;        def cc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
        def currC:RangerAppClassDesc (unwrap cc)
        def up@(optional):RangerAppParamDesc (currC.findVariable(part))
        def lvDef (ctx.getVariableDef(part))          
        if ( (!null? up) && (lvDef.is_class_variable) ) {
          def p3:RangerAppParamDesc (unwrap up)
          wr.out((thisName + ".") false)
        }
      }
      def p:RangerAppParamDesc node.paramDesc
      wr.out(p.compiledName false) 
      return
    }
    def b_was_static:boolean false
    for node.ns part:string i {
      if (i > 0) {
        if ((i == 1) && b_was_static) {
          wr.out("_static_" false)
        } {
          wr.out("." false)
        }
      }
      if (i == 0) {

        if(part == "this") {
          wr.out(thisName false)
          continue
        }        

        if (ctx.hasClass(part)) {
          b_was_static = true
        }
        def cc@(optional):RangerAppClassDesc (ctx.getCurrentClass())              
        if ((part != "this") && (!null? cc) && (false == (ctx.isInStatic()))) {
;          def cc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
          def currC:RangerAppClassDesc (unwrap cc)
          def up@(optional):RangerAppParamDesc (currC.findVariable(part))
          def lvDef (ctx.getVariableDef(part))          
          if ( (!null? up) && (lvDef.is_class_variable) ) {
            def p3:RangerAppParamDesc (unwrap up)
            wr.out((thisName + ".") false)
          }
        }
      }
      wr.out((this.adjustType(part)) false)
    }
  }


  fn goExtractAssign:void ( value:CodeNode p:RangerAppParamDesc ctx:RangerAppWriterContext wr:CodeWriter) {

    def arr_node@(lives):CodeNode (itemAt value.children 1)  

    wr.newline()
    wr.out("" true)
    wr.out("// array_extract operator " true)
    wr.out("var " false)
    
    def pArr@(lives):RangerAppParamDesc (new RangerAppParamDesc ())
    pArr.name = "_arrTemp"
    pArr.node = arr_node
    pArr.nameNode = arr_node
    pArr.is_optional = false
    ctx.defineVariable(p.name pArr)

    wr.out(pArr.compiledName false)
    wr.out(" " false)
    this.writeTypeDef(arr_node ctx wr)
    wr.newline()
    
    wr.out((p.compiledName + " , " + pArr.compiledName + " = ") false)

    ctx.setInExpr()
    this.WalkNode(value ctx wr)
    ctx.unsetInExpr()
    wr.out(";" true)

    def left:CodeNode arr_node

    def a_len:int ( (array_length left.ns) - 1)
    def last_part:string (itemAt left.ns a_len)

    def next_is_gs:boolean false
    def last_was_setter:boolean false
    def needs_par:boolean false
    def b_was_static:boolean false

    for left.ns part:string i {

      if next_is_gs {
        if( i == a_len) {
          wr.out(".Set_" false)
          last_was_setter = true      
        } {
          wr.out(".Get_" false)
          needs_par = true
          next_is_gs = false
          last_was_setter = false
        }
      }
      
      if( last_was_setter == false && needs_par == false) {
        if (i > 0) {
          if ((i == 1) && b_was_static) {
            wr.out("_static_" false)
          } {
            wr.out("." false)
          }
        }
      }

      if (i == 0) {

        if(part == "this") {
          wr.out(thisName false)
          continue
        }        

        if (ctx.hasClass(part)) {
          b_was_static = true
        }

        def partDef:RangerAppParamDesc (ctx.getVariableDef(part))
        if(!null? partDef.nameNode) {
          def partName:CodeNode (unwrap partDef.nameNode)
          if(ctx.isDefinedClass(partName.type_name)) {
            def c:RangerAppClassDesc (ctx.findClass(partName.type_name))
            if(c.doesInherit()) {
              next_is_gs = true
            }
          }
        }

        
        def cc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
        ;ctx.isMemberVariable(part)
        if ((part != "this") && (!null? cc) && (false == (ctx.isInStatic())) ) {
          def currC:RangerAppClassDesc (unwrap cc)
          def up@(optional):RangerAppParamDesc (currC.findVariable(part))
          def lvDef (ctx.getVariableDef(part))          
          if ( (!null? up) && (lvDef.is_class_variable) ) {
            def p3:RangerAppParamDesc (unwrap up)
            wr.out((thisName + ".") false)
          }
        }
      }

      if( (array_length left.nsp ) > 0) {
        def p:RangerAppParamDesc (itemAt left.nsp i)
        wr.out((this.adjustType(p.compiledName)) false)    
      } {
        if(left.hasParamDesc) {
          def leftDesc:RangerAppParamDesc (unwrap left.paramDesc)
          wr.out(leftDesc.compiledName false)
        } {
          wr.out((this.adjustType(part)) false)
        }
      }

      if needs_par {
        wr.out("()" false)
        needs_par = false        
      }

      if( (array_length left.nsp ) >= (i+1)) {
        def pp:RangerAppParamDesc (itemAt left.nsp i)
        if(pp.nameNode.hasFlag("optional")) {
          wr.out(".value.(" false)
          this.writeTypeDef( (unwrap pp.nameNode) ctx wr)
          wr.out(")" false)                
        }
      }      

    }
    if last_was_setter {
      wr.out( "(" false)
      wr.out( pArr.compiledName  false)
      wr.out("); "  true)
    } {
      wr.out(" = " false)
      wr.out( pArr.compiledName  false)
      wr.out("; " true)
    }

    wr.out("" true)
    

  }



   ; Every ancestor of a class, direct parents first, then theirs, and so on,
  ; each named once however many paths reach it.
  ;
  ; Go has no inheritance, so a derived class is emitted as a FLAT struct
  ; carrying every field and method it inherits. Walking one level meant
  ; `C extends B extends A` got B's and not A's: the struct was missing
  ; fields, the constructor left them uninitialised, and the interface
  ; generated for A was not implemented — three separate errors naming things
  ; nobody had written.
  fn goAncestors:[string] (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    def out:[string]
    def seen:[string:boolean]
    def pending:[string]
    for cl.extends_classes seedName:string si {
      push pending seedName
    }
    def at:int 0
    while ( at < ( array_length pending ) ) {
      def pName:string (itemAt pending at)
      at = (at + 1)
      if( has seen pName ) {
        continue
      }
      set seen pName true
      push out pName
      def pC:RangerAppClassDesc (ctx.findClass(pName))
      for pC.extends_classes upName:string ui {
        push pending upName
      }
    }
    return out
  }

 fn writeStructField:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasParamDesc {
      def nn:CodeNode (itemAt node.children 1)
      def p:RangerAppParamDesc nn.paramDesc
      wr.out((p.compiledName + " ") false)
      if (p.nameNode.hasFlag("optional")) {
        wr.out("*GoNullable" false)
      } {
        this.writeTypeDef(( unwrap p.nameNode )ctx wr)
      }
      if (p.ref_cnt == 0) {
        wr.out(" /**  unused  **/ " false)
      }
      wr.out( (' `json:"' + p.name +  '"` ') false)
      wr.out("" true)
      if (p.nameNode.hasFlag("optional")) {
      }
    }
  }

  ; Override CreateCallExpression to handle unwrapping GoNullable objects for method calls
  fn CreateCallExpression:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.has_call {
      def obj:CodeNode (node.getSecond())
      def method:CodeNode (node.getThird())
      def args:CodeNode (itemAt node.children 3)
      
      ; Check if the object is an optional class member that needs unwrapping
      def needs_unwrap:boolean false
      def obj_type_name:string ""
      
      ; obj.nsp is empty in method call context, need to check differently
      ; Check if obj has paramDesc and it's optional
      if obj.hasParamDesc {
        def p:RangerAppParamDesc (unwrap obj.paramDesc)
        if (p.is_optional) {
          if (!null? p.nameNode) {
            def parameterName:CodeNode (unwrap p.nameNode)
            needs_unwrap = true
            obj_type_name = parameterName.type_name
          }
        }
      }
      
      if needs_unwrap {
        ; the type assertion needs the receiver delimited whatever its shape
        wr.out("(" false)
        ctx.setInExpr()
        this.WalkNode(obj ctx wr)
        ctx.unsetInExpr()
        wr.out(").value.(*" false)
        wr.out(obj_type_name false)
        wr.out(")." false)
      } {
        this.writeCallReceiver(obj ctx wr)
        wr.out("." false)
      }
      
      wr.out(method.vref false)
      wr.out("(" false)
      ctx.setInExpr()
      
      def pms (filter (args.children) {
        if( item.hasFlag("keyword")) {
          return false
        }
        return true
      })
      
      for pms arg:CodeNode i {
        if (i > 0) {
          wr.out(", " false)
        }
        this.WalkNode(arg ctx wr)
      }
      ctx.unsetInExpr()
      wr.out(")" false)
      if ((ctx.expressionLevel()) == 0) {
        wr.out(";" true)
      }
    }
  }

  fn writeVarDef:void  (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasParamDesc {
      def nn:CodeNode (itemAt node.children 1)
      def p:RangerAppParamDesc nn.paramDesc
      def b_not_used:boolean false
      if ((p.ref_cnt == 0) && (p.is_class_variable == false)) {

        ; testing if variable definition can be omitted is here...
        def b_can_skip true
        if ((array_length node.children) > 2) {
          def value:CodeNode (node.getThird())
          ; hasFnCall as well as has_call: a METHOD call sets only the former,
          ; so `def ignored:T (this.doWork())` -- the language's
          ; evaluate-and-discard form -- was commented out and the call
          ; silently disappeared, taking the reads inside it with it.
          if((value.has_call || value.has_lambda_call) || value.hasFnCall) {
            b_can_skip = false
          }
          value.forTree({
            ; can you detect operators with side effects ?
            if((item.has_call || item.has_lambda_call) || item.hasFnCall) {
              b_can_skip = false
            }
          })
          if( b_can_skip == false ) {
            wr.out(" _ = " false)
            ctx.setInExpr()
            this.WalkNode(value ctx wr)
            ctx.unsetInExpr()
            wr.out('' true)
            return            
          }
        }
        if b_can_skip {
          wr.out((("/* unused:  " + p.compiledName) + "*/") true)
          b_not_used = true
          return
        }
      }
      def map_or_hash:boolean ((nn.value_type == RangerNodeType.Array) || (nn.value_type == RangerNodeType.Hash))
      if (nn.hasFlag("optional")) {
        wr.out((("var " + p.compiledName) + " *GoNullable = new(GoNullable); ") true)
        if ((array_length node.children) > 2) {
          def value:CodeNode (itemAt node.children 2)
          if value.hasParamDesc {
            def valueDesc:RangerAppParamDesc (unwrap value.paramDesc)
            def pnn:CodeNode (unwrap valueDesc.nameNode)
            if (pnn.hasFlag("optional")) {
              wr.out((p.compiledName + ".value = ") false)
              ctx.setInExpr()
              def value:CodeNode (node.getThird())
              this.WalkNode(value ctx wr)
              ctx.unsetInExpr()
              wr.out(".value;" true)
              wr.out((p.compiledName + ".has_value = ") false)
              ctx.setInExpr()
              def value:CodeNode (node.getThird())
              this.WalkNode(value ctx wr)
              ctx.unsetInExpr()
              wr.out(".has_value;" true)
              return
            } {
              wr.out((p.compiledName + ".value = ") false)
              ctx.setInExpr()
              def value:CodeNode (node.getThird())
              this.WalkNode(value ctx wr)
              ctx.unsetInExpr()
              wr.out(";" true)
              wr.out((p.compiledName + ".has_value = true;") true)
              return
            }
          } {
            if (value.hasNewOper || (false == (value.hasFlag("optional")))) {
              wr.out((p.compiledName + ".value = ") false)
              ctx.setInExpr()
              def value:CodeNode (node.getThird())
              this.WalkNode(value ctx wr)
              ctx.unsetInExpr()
              wr.out(";" true)
              wr.out((p.compiledName + ".has_value = true;") true)
              return
            }
            ; An optional is a *GoNullable BOX, so a plain assignment makes the
            ; local ALIAS the box the initializer came from -- and a later write
            ; through the local then lands in the object that owns it.
            ; `def wr (file.getWriter())` did exactly that, and the `wr =
            ; contentFork` further down VirtualCompiler.run replaced the FILE's
            ; writer: every tag slice -- the imports, the utilities, file_end --
            ; belonged to the writer that had just been dropped, so the output
            ; came out with no import lines, no polyfills and no entry point.
            ;
            ; Copy the two fields instead. The temporary keeps the initializer
            ; to one evaluation.
            def srcName:string (p.compiledName + "__src")
            wr.out((("var " + srcName) + " *GoNullable = ") false)
            ctx.setInExpr()
            def value:CodeNode (node.getThird())
            this.WalkNode(value ctx wr)
            ctx.unsetInExpr()
            wr.out(";" true)
            wr.out(((((p.compiledName + ".value = ") + srcName) + ".value;")) true)
            wr.out(((((p.compiledName + ".has_value = ") + srcName) + ".has_value;")) true)
            return
          }
        }
        return
      } {
        if (((p.set_cnt > 0) || p.is_class_variable) || map_or_hash) {
          wr.out((("var " + p.compiledName) + " ") false)
        } {
          wr.out((("var " + p.compiledName) + " ") false)
        }
      }

      def parameterName:CodeNode (unwrap p.nameNode)
      def ti_ok (ctx.canUseTypeInference(parameterName))     
      if( (false == ti_ok ) || ( (false == (parameterName.hasFlag("optional"))) && ( (array_length node.children) == 2) ) ) {    
        this.writeTypeDef2(parameterName ctx wr)
      } 
      if ((array_length node.children) > 2) {
        def value:CodeNode (node.getThird())
        if (value.expression && ((array_length value.children) > 1)) {
          def fc:CodeNode (itemAt value.children 0)
          if (fc.vref == "array_extract") {
            ; special case to create assigment for array_extract in golang         
             
            this.goExtractAssign( value (unwrap p) ctx wr )
            return
          } 
        }
        wr.out("= " false)
        def slotType:string parameterName.type_name
        if ((strlen parameterName.eval_type_name) > 0) {
          slotType = parameterName.eval_type_name
        }
        def wroteSlot:boolean (this.goWriteUnionValue(slotType value ctx wr))
        if (wroteSlot == false) {
          ctx.setInExpr()
          if(parameterName.eval_type_name == "char") {
            wr.out("byte(" false)
          }
          ; Handle char to int conversion - Go requires explicit cast from byte to int64
          if((parameterName.eval_type_name == "int") && (value.eval_type_name == "char")) {
            wr.out("int64(" false)
          }
          this.WalkNode(value ctx wr)
          if(parameterName.eval_type_name == "char") {
            wr.out(")" false)
          }
          if((parameterName.eval_type_name == "int") && (value.eval_type_name == "char")) {
            wr.out(")" false)
          }
          ctx.unsetInExpr()
        }
      } {
        if (nn.value_type == RangerNodeType.Array) {
          wr.out(" = make(" false)
          this.writeTypeDef(( unwrap p.nameNode ) ctx wr)
          wr.out(", 0)" false)
        }
        if (nn.value_type == RangerNodeType.Hash) {
          wr.out(" = make(" false)
          this.writeTypeDef(( unwrap p.nameNode ) ctx wr)
          wr.out(")" false)
        }
      }
      wr.out(";" false)
      ; Go refuses a local that is declared and never read -- and a flag that
      ; every branch sets and no branch consults is ordinary code in every
      ; other target, so dropping the declaration is not an option (the later
      ; assignments to it still have to compile). A blank assignment marks it
      ; used; the Go compiler discards `_ = x` entirely. Writing one for a
      ; variable that is in fact read is harmless, so an under-count of
      ; read_cnt costs nothing here.
      if ((p.read_cnt <= 0) && (p.is_class_variable == false)) {
        wr.out((" _ = " + p.compiledName) false)
      }
      if ((p.ref_cnt == 0) && (p.is_class_variable == true)) {
        wr.out("     /* note: unused */" false)
      }
      if ((p.ref_cnt == 0) && (p.is_class_variable == false)) {

      } {
        wr.newline()
      }
      if (b_not_used == false) {
        if (nn.hasFlag("optional")) {
          wr.addImport("errors")
        }
      }
    }
  }
  ; The constructor of a `record` holds a marker parameter for each keyword,
  ; next to the parameter that carries the value. The marker has a name and no
  ; type, and Go has no keyword argument. `writeNewCall` already drops it from
  ; the call; without this filter the declaration keeps it, so the two do not
  ; agree: `func CreateNew_Point(xpos (), xpos int64, ypos (), ypos int64)`
  ; against a call with two arguments.
  fn writeArgsDef:void  (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    def pms (filter (fnDesc.params) {
      if (item.nameNode.hasFlag("keyword")) {
        return false
      }
      return true
    })
    for pms arg:RangerAppParamDesc i {
      if (i > 0) {
        wr.out(", " false)
      }
      wr.out((arg.compiledName + " ") false)

      if (arg.nameNode.hasFlag("optional")) {
        wr.out("*GoNullable" false)
      } {
        this.writeTypeDef( (unwrap arg.nameNode) ctx wr)
      }      
      
    }
  }

  fn writeFnCall:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasFnCall {
      def fc:CodeNode (node.getFirst())
      this.WriteVRef(fc ctx wr)
      wr.out("(" false)
      def givenArgs:CodeNode (node.getSecond())
      ctx.setInExpr()
      def cnt 0
      def fnDesc:RangerAppFunctionDesc (unwrap node.fnDesc)
      for fnDesc.params arg:RangerAppParamDesc i {
        def argumentName:CodeNode (unwrap arg.nameNode)
        if (argumentName.hasFlag("keyword")) {
          continue
        }
        if (cnt > 0) {
          wr.out(", " false)
        }
        cnt = cnt + 1
        if ((array_length givenArgs.children) <= i) {
          def defVal@(optional):CodeNode (argumentName.getFlag("default"))
          if (!null? defVal) {
            def fcDef:CodeNode (defVal.vref_annotation.getFirst())
            this.WalkNode(fcDef ctx wr)
          } {
            ctx.addError(node "Default argument was missing")
          }
          continue
        }
        def n:CodeNode (itemAt givenArgs.children i)
        if (this.goWriteUnionArg(arg n ctx wr)) {
          continue
        }
        this.WalkNode(n ctx wr)
      }
      ctx.unsetInExpr()
      wr.out(")" false)
      if (has node.methodChain) {
        for node.methodChain cc:CallChain i {
          wr.out(("." + cc.methodName) false)
          wr.out("(" false)
          ctx.setInExpr()
          def chainArgs:CodeNode (unwrap cc.args)
          for chainArgs.children arg:CodeNode i {
            if (i > 0) {
              wr.out(", " false)
            }
            this.WalkNode(arg ctx wr)
          }
          ctx.unsetInExpr()
          wr.out(")" false)
        }
      }
      if ((ctx.expressionLevel()) == 0) {
        wr.out(";" true)
      }
    }
  }

  fn writeNewCall:void  (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasNewOper {
      def cl:RangerAppClassDesc (unwrap node.clDesc)
      def fc:CodeNode (node.getSecond())
      wr.out((("CreateNew_" + (this.goClassRef(cl ctx))) + "(") false)
      def constr:RangerAppFunctionDesc cl.constructor_fn
      def givenArgs:CodeNode (node.getThird())
      def pms (filter (givenArgs.children) {
        if( item.hasFlag('keyword')) {
          return false
        }
        return true
      })
      def cnt 0
      for pms n:CodeNode i {
        if (cnt > 0) {
          wr.out(", " false)
        }
        cnt = cnt + 1
        this.WalkNode(n ctx wr)
      }
      wr.out(")" false)
    }
  }

  fn writeArrayLiteral( node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    this.writeTypeDef(node ctx wr)
    wr.out(" {" false)
    def elemType:string node.eval_array_type
    if ((strlen elemType) == 0) {
      elemType = node.array_type
    }
    node.children.forEach({
      if( index > 0 ) {
        wr.out(", " false)
      }
      if ((strlen elemType) > 0) {
        if (this.goWriteUnionValue(elemType item ctx wr)) {
          return
        }
      }
      this.WalkNode( item ctx wr )
    })
    wr.out("}" false)
  }
  
  fn CreateLambdaCall:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def fName:CodeNode (itemAt node.children 0)
    def givenArgs:CodeNode (itemAt node.children 1)

    def args:CodeNode
    if( (!null? fName.expression_value) ) {
      def lambdaExpression:CodeNode (unwrap fName.expression_value)
      args  = (itemAt lambdaExpression.children 1)
    } {
      def paramOpt@(optional):RangerAppParamDesc (ctx.getVariableDef(fName.vref))
      def param:RangerAppParamDesc (unwrap paramOpt)
      def parameterName:CodeNode (unwrap param.nameNode)
      def lambdaExpression:CodeNode (unwrap parameterName.expression_value)
      args  = (itemAt lambdaExpression.children 1)
    }
    ctx.setInExpr()
    this.WalkNode(fName ctx wr)
    wr.out("(" false)
    def subCtx (ctx.fork())
    def lambdaArgs:CodeNode (unwrap args)
    for lambdaArgs.children arg:CodeNode i {
      def n:CodeNode (itemAt givenArgs.children i)
      if (i > 0) {
        wr.out(", " false)
      }
      if(arg.value_type != RangerNodeType.NoType) {
        this.WalkNode(n subCtx wr)
      } {
        this.WalkNode(n subCtx wr)
      }   
    }
    ctx.unsetInExpr()
    wr.out(")" false)
    if ((ctx.expressionLevel()) == 0) {
      wr.out(";" true)
    }
  }
  fn CreateLambda:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def lambdaCtx (unwrap node.lambda_ctx)
    def fnNode:CodeNode (itemAt node.children 0)
    def args:CodeNode (itemAt node.children 1)
    def body:CodeNode (itemAt node.children 2)
    ; def nameNode:CodeNode (itemAt fnNode.expression_value.children 0)
    wr.out("func (" false)
    for args.children arg:CodeNode i {
      if (i > 0) {
        wr.out(", " false)
      }
      wr.out(arg.vref false)
      ; this.WalkNode(arg lambdaCtx wr)
      wr.out(" " false)
      if (arg.hasFlag("optional")) {
        wr.out("*GoNullable" false)
      } {
        this.writeTypeDef( arg lambdaCtx wr)
      }        
    }
    wr.out(") " false)
    
    if (fnNode.hasFlag("optional")) {
      wr.out("*GoNullable" false)
    } {
      this.writeTypeDef(fnNode lambdaCtx wr)
    }    

    wr.out(" {" true)
    wr.indent(1)
    lambdaCtx.restartExpressionLevel()
    for body.children item:CodeNode i {
      this.WalkNode(item lambdaCtx wr)
    }
    wr.newline()
    wr.indent(-1)
    wr.out("}" false)
  }  


  ;   current:
  ;   a.Get_friendList() = append(a.Get_friendList(),b);
  ;   goal:
  ;   a.Set_FriendList( append(a.Get_friendList(),b) )
  ;   push arr item
  

  ; --- the generated `for` (PLAN_CPP_IDIOMS C4, the Go half) ------------------
  ; `for xs v:int i { ... }` used to be, always:
  ;
  ;   var i int64 = 0
  ;   for ; i < int64(len(xs)) ; i++ {
  ;     v := xs[i]
  ;     ...
  ;   }
  ;
  ; which is the loop Go had before `range`, and the first thing a Go reviewer
  ; says about the file. When the body neither reads the index nor touches the
  ; collection, the same loop is `for _, v := range xs {` -- and `for range xs`
  ; when it does not name the element either, because Go rejects a binding
  ; nothing reads.
  ;
  ; The index is deliberately NOT carried into the range form. Ranger declares
  ; it `int` and the body arithmetics it against other `int64`s, where `range`
  ; hands back an `int`; keeping the index means a conversion at the top of
  ; every such loop, which is the tell this was trying to remove. A body that
  ; reads its index keeps the loop it had.
  ;
  ; The collection condition is the same one every target asks (ForLoopShape):
  ; `range` evaluates its operand ONCE, so a body that appends to the slice
  ; iterates the old one, where the index form re-reads `len` every turn.
  fn goWriteForLoop:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if ((array_length node.children) < 5) {
      return
    }
    def coll:CodeNode (node.getSecond())
    def item:CodeNode (itemAt node.children 2)
    def idx:CodeNode (itemAt node.children 3)
    def body:CodeNode (itemAt node.children 4)

    if ((goLoops.canIterate(node)) == false) {
      this.goWriteIndexForLoop(node ctx wr)
      return
    }

    def itemName:string item.vref
    def usesItem:boolean false
    if ((strlen itemName) > 0) {
      usesItem = (goLoops.treeMentions(body itemName))
    }
    wr.out("for " false)
    if usesItem {
      wr.out("_, " false)
      this.goWriteOperand(item ctx wr)
      wr.out(" := " false)
    }
    wr.out("range " false)
    this.goWriteOperand(coll ctx wr)
    wr.out(" {" true)
    wr.indent(1)
    def rCtx:RangerAppWriterContext (ctx.fork())
    rCtx.restartExpressionLevel()
    this.WalkNode(body rCtx wr)
    wr.indent(-1)
    wr.out("}" true)
  }

  fn goWriteOperand:void (arg:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ctx.setInExpr()
    this.WalkNode(arg ctx wr)
    ctx.unsetInExpr()
  }

  ; the index form, what the template wrote before
  fn goWriteIndexForLoop:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def coll:CodeNode (node.getSecond())
    def item:CodeNode (itemAt node.children 2)
    def idx:CodeNode (itemAt node.children 3)
    def body:CodeNode (itemAt node.children 4)

    wr.out("var " false)
    this.goWriteOperand(idx ctx wr)
    wr.out(" int64 = 0;  " true)
    wr.out("for ; " false)
    this.goWriteOperand(idx ctx wr)
    wr.out(" < int64(len(" false)
    this.goWriteOperand(coll ctx wr)
    wr.out(")) ; " false)
    this.goWriteOperand(idx ctx wr)
    wr.out("++ {" true)
    wr.indent(1)
    ; Go rejects a binding nothing reads, so the element is bound only when the
    ; body names it -- the rule the `go_for_bind` template command applied
    def itemName:string item.vref
    if ((strlen itemName) > 0) {
      if (goLoops.treeMentions(body itemName)) {
        this.goWriteOperand(item ctx wr)
        wr.out(" := " false)
        this.goWriteOperand(coll ctx wr)
        wr.out("[" false)
        this.goWriteOperand(idx ctx wr)
        wr.out("]" true)
      }
    }
    def sCtx:RangerAppWriterContext (ctx.fork())
    sCtx.restartExpressionLevel()
    this.WalkNode(body sCtx wr)
    wr.indent(-1)
    wr.out("}" true)
  }

  fn CustomOperator:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {

    def fc:CodeNode (node.getFirst())
    def cmd:string fc.vref

    ; an index loop, or `for _, v := range xs` when that is safe
    if (cmd == "for") {
      this.goWriteForLoop(node ctx wr)
      return
    }

    if(cmd == "return" ) {
      if( (array_length node.children ) > 1 ) {
        def rValue (node.getSecond())
        def retUnion:string ""
        def currFnRet (ctx.getCurrentMethod())
        if (!null? currFnRet.nameNode) {
          def returnName:CodeNode (unwrap currFnRet.nameNode)
          retUnion = returnName.type_name
        }
        if( (ctx.isCatchBlock()) || (ctx.isTryBlock()) ) {
          wr.out("__ex_returned = true" true)
          wr.out("__exReturn = " false)
          def wroteRet:boolean (this.goWriteUnionValue(retUnion rValue ctx wr))
          if (wroteRet == false) {
            ctx.setInExpr()
            this.WalkNode( rValue ctx wr )
            ctx.unsetInExpr()
          }
          wr.newline()
          if( ctx.isTryBlock() ) {
            wr.out("return __ex_returned, __exReturn" true)
          }
        } {
          wr.out("return " false)
          def wroteRet2:boolean (this.goWriteUnionValue(retUnion rValue ctx wr))
          if (wroteRet2 == false) {
            ctx.setInExpr()
            this.WalkNode( rValue ctx wr )
            ctx.unsetInExpr()
          }
          wr.newline()
        }
      } {
        if(ctx.isCatchBlock()) {
          wr.out("__ex_returned = true" true)
        }
        if(ctx.isTryBlock()) {
          wr.out("return false, nil" true)
        }
        wr.out("return" true)
      }
      return
    }

    ; create custom try... catch... operator 
    if(cmd == "try" ) {
      
      def tryBlock (node.getSecond())
      def catchBlock (node.getThird())

      def currFn (ctx.getCurrentMethod())
      def currentName:CodeNode (unwrap currFn.nameNode)
      ; def ex1 (create_var ctx "did_throw" "boolean")
      def ex2 (create_var ctx "did_return" "boolean")
      def ex3 (create_var ctx "ex_result" currentName )

      if(currentName.type_name == "void") {
        wr.out( ex2.compiledName + ", _ := (func () ( __ex_returned bool,  __exReturn interface{}) {" , true)
        ; wr.out( "(func () ( __ex_returned bool, __exReturn interface{}) {" , true)
      } {
        wr.out( ex2.compiledName + ", " + ex3.compiledName + " := (func () ( __ex_returned bool,  __exReturn interface{}) {" , true)
      }

        wr.indent(1)
          wr.out("defer func() {" true)
          wr.indent(1)
            wr.out("if r:= recover(); r != nil {" true)
            wr.indent(1)

            def subCtx (ctx.fork())
            subCtx.is_catch_block = true            
            ; -- here the return should be converted
            this.WalkNode( catchBlock subCtx wr)
            wr.indent(-1)
            wr.out("}" true)
          wr.indent(-1)
        wr.out("}()" true)
        ; the try block here...   
        def subCtx (ctx.fork())
        subCtx.is_try_block = true
        this.WalkNode( tryBlock subCtx wr)
        ; wr.out("if")
        wr.out("return __ex_returned, __exReturn" true)
        wr.indent(-1)
      wr.out("})()" true)

      if(currentName.type_name != "void") {
        wr.out("if " + ex2.compiledName + " {" , true)
        wr.indent(1)
          wr.out("return " + ex3.compiledName , false)
          wr.out(".(" false)
          this.writeTypeDef(currentName ctx wr)
          wr.out(")" true)                 
          
        wr.indent(-1)
        wr.out("}" true)
      } {
        wr.out("if " + ex2.compiledName + " {" , true)
        wr.indent(1)
          wr.out("return ", true)
        wr.indent(-1)
        wr.out("}" true)
      }
      return
    }

    if(cmd == "=" || cmd == "push" || cmd == "removeLast") {

      def left:CodeNode (node.getSecond())
      def right:CodeNode left

      if(cmd == "=" || cmd == "push") {
        right = (node.getThird())
      }

      wr.newline()

      def b_was_static:boolean false

      if(left.hasParamDesc) {

        def a_len:int ( (array_length left.ns) - 1)
        def last_part:string (itemAt left.ns a_len)

        def next_is_gs:boolean false
        def last_was_setter:boolean false
        def needs_par:boolean false

        for left.ns part:string i {
          if next_is_gs {
            if( i == a_len) {
              wr.out(".Set_" false)
              last_was_setter = true      
            } {
              wr.out(".Get_" false)
              needs_par = true
              next_is_gs = false
              last_was_setter = false
            }
          }          
          if( last_was_setter == false && needs_par == false) {
            if (i > 0) {
              if ((i == 1) && b_was_static) {
                wr.out("_static_" false)
              } {
                wr.out("." false)
              }
            }
          }
          if (i == 0) {
            if(part == "this") {
              wr.out(thisName false)
              continue
            }        
            if (ctx.hasClass(part)) {
              b_was_static = true
            }
            def cc@(optional):RangerAppClassDesc (ctx.getCurrentClass())      
            if ((part != "this") && (!null? cc) && (false == (ctx.isInStatic())) ) {
;              def cc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
              def currC:RangerAppClassDesc (unwrap cc)
              def up@(optional):RangerAppParamDesc (currC.findVariable(part))
              def lvDef (ctx.getVariableDef(part))          
              if ( (!null? up) && (lvDef.is_class_variable) ) {
                def p3:RangerAppParamDesc (unwrap up)
                wr.out((thisName + ".") false)
              }
            }
          }

          def partDef:RangerAppParamDesc (ctx.getVariableDef(part))
          if( (array_length left.nsp) > i ) {
            partDef = (itemAt left.nsp i)
          }
          
          if(!null? partDef.nameNode) {
            def partName:CodeNode (unwrap partDef.nameNode)
            if(ctx.isDefinedClass(partName.type_name)) {
              def c:RangerAppClassDesc (ctx.findClass(partName.type_name))
              if(c.doesInherit()) {
                next_is_gs = true
              }
            }
          } 

          if( (array_length left.nsp ) > 0) {
            def p:RangerAppParamDesc (itemAt left.nsp i)
            wr.out((this.adjustType(p.compiledName)) false)    
          } {
            if(left.hasParamDesc) {
              def leftDesc:RangerAppParamDesc (unwrap left.paramDesc)
              wr.out(leftDesc.compiledName false)
            } {
              wr.out((this.adjustType(part)) false)
            }
          }

          if needs_par {
            wr.out("()" false)
            needs_par = false        
          }

          if( (array_length left.nsp ) >= (i+1)) {
            def pp:RangerAppParamDesc (itemAt left.nsp i)
            if(pp.nameNode.hasFlag("optional")) {
              if( (array_length left.nsp ) > (i+1)) {
                wr.out(".value.(" false)
                this.writeTypeDef((unwrap pp.nameNode) ctx wr)
                wr.out(")" false)                 
              } { 
                wr.out(".value" false)
                if( (right.hasFlag("optional")) == false) {
                  wr.out(" /* right is not optional, should set the has_value -> true */" false)
                }
              }
            }
          }          

        }

        ; go ( (e 1) "= " (e 1) "[:len(" (e 1)") - 1]")
        if( cmd == "removeLast") {
          if last_was_setter {
            wr.out("(" false)
            ctx.setInExpr()
            this.WalkNode(left ctx wr)
            wr.out("[:len(" false)
            this.WalkNode(left ctx wr)
            wr.out(")-1]" false)
            ctx.unsetInExpr()
            wr.out("); "  true)
          } {
            wr.out(" = " false)
            ctx.setInExpr()
            this.WalkNode(left ctx wr)
            wr.out("[:len(" false)
            this.WalkNode(left ctx wr)
            wr.out(")-1]" false)
            ctx.unsetInExpr()
            wr.out("; "  true)
          }
          return
        }
        

        if( cmd == "push") {
          def pushElemType:string ""
          if left.hasParamDesc {
            def leftDesc:RangerAppParamDesc (unwrap left.paramDesc)
            def pushNN@(optional):CodeNode leftDesc.nameNode
            if (!null? pushNN) {
              def pushNode:CodeNode (unwrap pushNN)
              pushElemType = pushNode.array_type
            }
          }
          if last_was_setter {
            wr.out("(" false)
            ctx.setInExpr()
            wr.out("append(" false)
            this.WalkNode(left ctx wr)
            wr.out("," false)
            def pushed:boolean false
            if ((strlen pushElemType) > 0) {
              pushed = (this.goWriteUnionValue(pushElemType right ctx wr))
            }
            if (pushed == false) {
              this.WalkNode(right ctx wr)
            }
            ctx.unsetInExpr()
            wr.out(")); "  true)
          } {
            wr.out(" = " false)
            wr.out("append(" false)
            ctx.setInExpr()
            this.WalkNode(left ctx wr)
            wr.out("," false)
            def pushed2:boolean false
            if ((strlen pushElemType) > 0) {
              pushed2 = (this.goWriteUnionValue(pushElemType right ctx wr))
            }
            if (pushed2 == false) {
              this.WalkNode(right ctx wr)
            }
            ctx.unsetInExpr()
            wr.out("); "  true)
          }
          return
        }

        def assignSlotType:string ""
        if left.hasParamDesc {
          def leftDesc:RangerAppParamDesc (unwrap left.paramDesc)
          def assignNN@(optional):CodeNode leftDesc.nameNode
          if (!null? assignNN) {
            def assignNode:CodeNode (unwrap assignNN)
            assignSlotType = assignNode.type_name
          }
        }
        if last_was_setter {
          wr.out("(" false)
          def wroteAssign:boolean false
          if ((strlen assignSlotType) > 0) {
            wroteAssign = (this.goWriteUnionValue(assignSlotType right ctx wr))
          }
          if (wroteAssign == false) {
            ctx.setInExpr()
            this.WalkNode(right ctx wr)
            ctx.unsetInExpr()
          }
          wr.out("); "  true)
        } {
          wr.out(" = " false)
          def wroteAssign2:boolean false
          if ((strlen assignSlotType) > 0) {
            wroteAssign2 = (this.goWriteUnionValue(assignSlotType right ctx wr))
          }
          if (wroteAssign2 == false) {
            ctx.setInExpr()
            this.WalkNode(right ctx wr)
            ctx.unsetInExpr()
          }
          wr.out("; " true)
        }
        return
        
      }

      this.WriteSetterVRef(left ctx wr)
      wr.out(" = " false)
      def assignSlotType2:string ""
      if left.hasParamDesc {
        def leftDesc:RangerAppParamDesc (unwrap left.paramDesc)
        def assignNN2@(optional):CodeNode leftDesc.nameNode
        if (!null? assignNN2) {
          def assignNode2:CodeNode (unwrap assignNN2)
          assignSlotType2 = assignNode2.type_name
        }
      }
      def wroteAssign3:boolean false
      if ((strlen assignSlotType2) > 0) {
        wroteAssign3 = (this.goWriteUnionValue(assignSlotType2 right ctx wr))
      }
      if (wroteAssign3 == false) {
        ctx.setInExpr()
        this.WalkNode(right ctx wr)
        ctx.unsetInExpr()
      }
      wr.out("; /* custom */" true)
    }
  }

  fn writeInterface:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext wr:CodeWriter) {

    wr.out((("type " + cl.name) + " interface { ") true)
    wr.indent(1)
    for cl.defined_variants fnVar:string i {
      def mVs:RangerAppMethodVariants (get cl.method_variants fnVar)
      for mVs.variants variant:RangerAppFunctionDesc i {
        wr.out( variant.compiledName + "(" , false)
        this.writeArgsDef(variant ctx wr)
        wr.out(") " false)
        if (variant.nameNode.hasFlag("optional")) {
          wr.out("*GoNullable" false)
        } {
          this.writeTypeDef(( unwrap variant.nameNode ) ctx wr)
        }
        wr.out("" true)
      }
    }     
    wr.indent(-1)
    wr.out("}" true)     
  }
  ; The Go body of the synthetic `__singleton` accessor the resolver advertises
  ; for a @singleton(true) class. Call sites already emit
  ; `ClassName_static___singleton()` through the ordinary static-call path, so
  ; only the definition was missing. A package-level slot filled on first call:
  ; first-call constructor arguments win, which is what es6, C++ and Rust do.
  fn writeSingletonAccessor:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    def slot:string (cl.name + "__singleton_instance")
    wr.newline()
    wr.out((((("var " + slot) + " *") + cl.name) + " = nil") true)
    wr.out((("func " + cl.name) + "_static___singleton(") false)
    def written:int 0
    if cl.has_constructor {
      def sgc@(optional):RangerAppFunctionDesc cl.constructor_fn
      if (!null? sgc) {
        def sgcF:RangerAppFunctionDesc (unwrap sgc)
        for sgcF.params arg:RangerAppParamDesc i {
          if (arg.nameNode.hasFlag("keyword")) {
            continue
          }
          if (written > 0) {
            wr.out(", " false)
          }
          written = written + 1
          wr.out((arg.name + " ") false)
          this.writeTypeDef((unwrap arg.nameNode) ctx wr)
        }
      }
    }
    wr.out(((") *" + cl.name) + " {") true)
    wr.indent(1)
    wr.out((("if " + slot) + " == nil {") true)
    wr.indent(1)
    wr.out((((slot + " = CreateNew_") + cl.name) + "(") false)
    def fwd:int 0
    if cl.has_constructor {
      def sgc2@(optional):RangerAppFunctionDesc cl.constructor_fn
      if (!null? sgc2) {
        def sgc2F:RangerAppFunctionDesc (unwrap sgc2)
        for sgc2F.params arg:RangerAppParamDesc i {
          if (arg.nameNode.hasFlag("keyword")) {
            continue
          }
          if (fwd > 0) {
            wr.out(", " false)
          }
          fwd = fwd + 1
          wr.out(arg.name false)
        }
      }
    }
    wr.out(")" true)
    wr.indent(-1)
    wr.out("}" true)
    wr.out(("return " + slot) true)
    wr.indent(-1)
    wr.out("}" true)
  }

  ; Does this program have an @(optional) anywhere? GoNullable is how an
  ; optional is carried on this target, and it used to be declared in every
  ; file — Go does not complain about an unused type, but it is four lines of
  ; "this was generated" at the top of a program that has no optional at all.
  ;
  ; Errs towards emitting: an unused type costs nothing, a missing one is a
  ; program that does not build.
  fn goNodeUsesOptional:boolean (node:CodeNode) {
    if (node.hasFlag("optional")) {
      return true
    }
    if (node.hasParamDesc) {
      def nodeDesc:RangerAppParamDesc (unwrap node.paramDesc)
      if (nodeDesc.is_optional) {
        return true
      }
      def pdNN@(optional):CodeNode nodeDesc.nameNode
      if (!null? pdNN) {
        def pdN:CodeNode (unwrap pdNN)
        if (pdN.hasFlag("optional")) {
          return true
        }
      }
    }
    for node.children ch:CodeNode i {
      if (this.goNodeUsesOptional(ch)) {
        return true
      }
    }
    return false
  }

  fn goScanFnsForOptional:boolean (fns:[RangerAppFunctionDesc]) {
    for fns m:RangerAppFunctionDesc mi {
      def mnn@(optional):CodeNode m.nameNode
      if (!null? mnn) {
        def mn:CodeNode (unwrap mnn)
        if (mn.hasFlag("optional")) {
          return true
        }
      }
      for m.params mp:RangerAppParamDesc mpi {
        if mp.is_optional {
          return true
        }
      }
      def mNodeOpt@(optional):CodeNode m.node
      if (!null? mNodeOpt) {
        if (this.goNodeUsesOptional((unwrap mNodeOpt))) {
          return true
        }
      }
    }
    return false
  }

  fn goProgramUsesOptional:boolean (ctx:RangerAppWriterContext) {
    def root:RangerAppWriterContext (ctx.getRoot())
    for root.definedClasses cl:RangerAppClassDesc i {
      if ((((cl.is_system || cl.is_trait) || cl.is_template) || cl.is_operator_class) || cl.is_union) {
        continue
      }
      for cl.variables pvar:RangerAppParamDesc j {
        if pvar.is_optional {
          return true
        }
      }
      if (this.goScanFnsForOptional(cl.methods)) {
        return true
      }
      if (this.goScanFnsForOptional(cl.static_methods)) {
        return true
      }
    }
    return false
  }

  ; A behaviour-only trait named as a type, as a Go interface. Go is
  ; structural: every class that `does` the trait already has the methods, so
  ; nothing needs to declare that it implements this.
  fn writeGoTraitInterfaces:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    goTraits.compute(ctx)
    for (keys goTraits.ifaceTraits) tn:string tni {
      def tc:RangerAppClassDesc (ctx.findClass(tn))
      wr.out((("type IFACE_" + tn) + " interface { ") true)
      wr.indent(1)
      for tc.defined_variants fnVar:string fvi {
        def mVs:RangerAppMethodVariants (get tc.method_variants fnVar)
        for mVs.variants variant:RangerAppFunctionDesc vi {
          wr.out( variant.compiledName + "(" , false)
          this.writeArgsDef(variant ctx wr)
          wr.out(") " false)
          if (variant.nameNode.hasFlag("optional")) {
            wr.out("*GoNullable" false)
          } {
            this.writeTypeDef(( unwrap variant.nameNode ) ctx wr)
          }
          wr.out("" true)
        }
      }
      wr.indent(-1)
      wr.out("}" true)
    }
  }

  fn writeClass:void  (node:CodeNode ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def cl:RangerAppClassDesc node.clDesc
    if (null? cl) {
      return
    }
    def wr:CodeWriter orig_wr
    if (did_write_nullable == false) {
      if (this.goProgramUsesOptional(ctx)) {
        wr.raw("\r\ntype GoNullable struct { \r\n  value interface{}\r\n  has_value bool\r\n}\r\n" true)
      }
      wr.createTag("utilities")
      did_write_nullable = true
      this.writeGoNativeEnums(ctx wr)
      this.writeGoTraitInterfaces(ctx wr)
    }
    this.writeGoUnionStructs(ctx wr)
    
    def declaredVariable:[string:boolean]
    def declaredFunction:[string:boolean]
    def declaredIfFunction:[string:boolean]

    ; a generic form is declared `History[Op any]` and named `History[Op]`
    def goName:string (this.goClassRef((unwrap cl) ctx))
    def goDecl:string cl.name
    if cl.is_generic_form {
      goDecl = (cl.generic_template + "[")
      for cl.generic_args ga:string gai {
        if (gai > 0) {
          goDecl = (goDecl + ", ")
        }
        goDecl = ((goDecl + (this.goClassRef((ctx.findClass(ga)) ctx))) + " any")
      }
      goDecl = (goDecl + "]")
    }

    wr.out((("type " + goDecl) + " struct { ") true)
    wr.indent(1)

    for cl.variables pvar:RangerAppParamDesc i {
      this.writeStructField(( unwrap pvar.node ) ctx wr)
      set declaredVariable pvar.name true
    }

    for (this.goAncestors((unwrap cl) ctx)) pName:string ai {
      def pC:RangerAppClassDesc (ctx.findClass(pName))
      wr.out("// inherited from parent class " + pName , true)
      for pC.variables pvar:RangerAppParamDesc i {
        if(has declaredVariable pvar.name) {
          continue
        }
        set declaredVariable pvar.name true
        this.writeStructField(( unwrap pvar.node ) ctx wr)
      }
    }


    wr.indent(-1)
    wr.out("}" true)

    if( (cl.doesInherit()) || (has cl.extends_classes) ) {
      wr.out((("type IFACE_" + cl.name) + " interface { ") true)
      wr.indent(1)
      for cl.variables p:RangerAppParamDesc i {
          wr.out("Get_" false)
          wr.out((p.compiledName + "() ") false)
          if (p.nameNode.hasFlag("optional")) {
            wr.out("*GoNullable" false)
          } {
            this.writeTypeDef(( unwrap p.nameNode )ctx wr)
          }
          wr.out("" true)
          wr.out("Set_" false)
          wr.out(p.compiledName + "(value " , false )
          if (p.nameNode.hasFlag("optional")) {
            wr.out("*GoNullable" false)
          } {
            this.writeTypeDef(( unwrap p.nameNode )ctx wr)
          }
          wr.out(") " true)       
      }
      for cl.defined_variants fnVar:string i {
        def mVs:RangerAppMethodVariants (get cl.method_variants fnVar)
        for mVs.variants variant:RangerAppFunctionDesc i {
          if(has declaredIfFunction variant.name) {
            continue
          }
          set declaredIfFunction variant.name true         
          wr.out( variant.compiledName + "(" , false)
          this.writeArgsDef(variant ctx wr)
          wr.out(") " false)
          if (variant.nameNode.hasFlag("optional")) {
            wr.out("*GoNullable" false)
          } {
            this.writeTypeDef(( unwrap variant.nameNode ) ctx wr)
          }
          wr.out("" true)
        }
      }     
      wr.indent(-1)
      wr.out("}" true)    
      
    }



    thisName = "me"
    wr.out("" true)
    wr.out((("func CreateNew_" + goDecl) + "(") false)
    if cl.has_constructor {
      def constr:RangerAppFunctionDesc cl.constructor_fn
      ; The keyword marker of a record constructor has a name and no type; only
      ; a language with keyword arguments writes it, and this one has none.
      def written 0
      for constr.params arg:RangerAppParamDesc i  {
        if (arg.nameNode.hasFlag("keyword")) {
          continue
        }
        if (written > 0) {
          wr.out(", " false)
        }
        written = written + 1
        wr.out((arg.name + " ") false)
        this.writeTypeDef((unwrap arg.nameNode) ctx wr)
      }
    }
    wr.out(((") *" + goName) + " {") true)
    wr.indent(1)
    wr.newline()
    wr.out((("me := new(" + goName) + ")") true)


    ; write inherited vriables
    def initedVariable:[string:boolean]
    for (this.goAncestors((unwrap cl) ctx)) pName:string ai {
      {
        def pC:RangerAppClassDesc (ctx.findClass(pName))

        for pC.variables pvar:RangerAppParamDesc i {
          if(has initedVariable pvar.name) {
            continue
          }
          set initedVariable pvar.name true
          def nn:CodeNode ( unwrap pvar.node )
          if ((array_length nn.children) > 2) {
            def valueNode:CodeNode (itemAt nn.children 2)
            wr.out((("me." + pvar.compiledName) + " = ") false)
            def fldTypeName:string ""
            if (!null? pvar.nameNode) {
              def fieldName:CodeNode (unwrap pvar.nameNode)
              fldTypeName = fieldName.type_name
            }
            def wroteFld:boolean false
            if ((strlen fldTypeName) > 0) {
              wroteFld = (this.goWriteUnionValue(fldTypeName valueNode ctx wr))
            }
            if (wroteFld == false) {
              this.WalkNode(valueNode ctx wr)
            }
            wr.out("" true)
          } {
            def pNameN:CodeNode (unwrap pvar.nameNode)
            if (pNameN.value_type == RangerNodeType.Array) {
              wr.out((("me." + pvar.compiledName) + " = ") false)
              wr.out("make(" false)
              this.writeTypeDef( (unwrap pvar.nameNode) ctx wr)
              wr.out(",0)" true)
            }
            if (pNameN.value_type == RangerNodeType.Hash) {
              wr.out((("me." + pvar.compiledName) + " = ") false)
              wr.out("make(" false)
              this.writeTypeDef((unwrap pvar.nameNode)  ctx wr)
              wr.out(")" true)
            }
          }
        }
        for pC.variables pvar:RangerAppParamDesc i {
          if (pvar.nameNode.hasFlag("optional")) {
            wr.out((("me." + pvar.compiledName) + " = new(GoNullable);") true)
          }
        }
        if pC.has_constructor {
          def constr:RangerAppFunctionDesc pC.constructor_fn
          def subCtx:RangerAppWriterContext ( unwrap constr.fnCtx )
          subCtx.is_function = true
          this.WalkNode(( unwrap constr.fnBody ) subCtx wr)
        }
      }
    }   


    for cl.variables pvar:RangerAppParamDesc i {
      def nn:CodeNode ( unwrap pvar.node )
      if ((array_length nn.children) > 2) {
        def valueNode:CodeNode (itemAt nn.children 2)
        wr.out((("me." + pvar.compiledName) + " = ") false)
        def fldTypeName2:string ""
        if (!null? pvar.nameNode) {
          def fieldName:CodeNode (unwrap pvar.nameNode)
          fldTypeName2 = fieldName.type_name
        }
        def wroteFld2:boolean false
        if ((strlen fldTypeName2) > 0) {
          wroteFld2 = (this.goWriteUnionValue(fldTypeName2 valueNode ctx wr))
        }
        if (wroteFld2 == false) {
          this.WalkNode(valueNode ctx wr)
        }
        wr.out("" true)
      } {
        def pNameN:CodeNode pvar.nameNode
        if (pNameN.value_type == RangerNodeType.Array) {
          wr.out((("me." + pvar.compiledName) + " = ") false)
          wr.out("make(" false)
          this.writeTypeDef((unwrap pvar.nameNode) ctx wr)
          wr.out(",0)" true)
        }
        if (pNameN.value_type == RangerNodeType.Hash) {
          wr.out((("me." + pvar.compiledName) + " = ") false)
          wr.out("make(" false)
          this.writeTypeDef((unwrap pvar.nameNode) ctx wr)
          wr.out(")" true)
        }
      }
    }
    for cl.variables pvar:RangerAppParamDesc i {
      if (pvar.nameNode.hasFlag("optional")) {
        wr.out((("me." + pvar.compiledName) + " = new(GoNullable);") true)
      }
    }

    if cl.has_constructor {
      def constr:RangerAppFunctionDesc cl.constructor_fn
      def subCtx:RangerAppWriterContext ( unwrap constr.fnCtx )
      subCtx.is_function = true
      this.WalkNode(( unwrap constr.fnBody ) subCtx wr)
    }

    wr.out("return me;" true)
    wr.indent(-1)
    wr.out("}" true)
    thisName = "this"
    if (cl.isSingletonClass()) {
      this.writeSingletonAccessor((unwrap cl) ctx wr)
    }
    for cl.static_methods variant:RangerAppFunctionDesc i {
      if (variant.nameNode.hasFlag("main")) {
        continue _
      }
      wr.newline()
      wr.out((((("func " + cl.name) + "_static_") + variant.compiledName) + "(") false)
      this.writeArgsDef(variant ctx wr)
      wr.out(") " false)

      def vnn (unwrap variant.nameNode)
      if (vnn.hasFlag("optional")) {
        wr.out("*GoNullable" false)
      } {
        this.writeTypeDef(vnn ctx wr)
      }        
;       this.writeTypeDef(( unwrap variant.nameNode ) ctx wr)
      wr.out(" {" true)
      wr.indent(1)
      wr.newline()
      def subCtx:RangerAppWriterContext (unwrap variant.fnCtx)
      subCtx.is_function = true
      subCtx.in_static_method = true
      this.WalkNode(( unwrap variant.fnBody ) subCtx wr)
      subCtx.in_static_method = false
      wr.newline()
      wr.indent(-1)
      wr.out("}" true)
    }


    def declaredFn:[string:boolean]

    for cl.defined_variants fnVar:string i {
      def mVs:RangerAppMethodVariants (get cl.method_variants fnVar)
      for mVs.variants variant:RangerAppFunctionDesc i {

        if(has declaredFunction variant.name) {
          continue
        }
        set declaredFunction variant.name true      
        set declaredFn variant.name true
        wr.out((((("func (this *" + goName) + ") ") + variant.compiledName) + " (") false)
        this.writeArgsDef(variant ctx wr)
        wr.out(") " false)
        if (variant.nameNode.hasFlag("optional")) {
          wr.out("*GoNullable" false)
        } {
          this.writeTypeDef(( unwrap variant.nameNode ) ctx wr)
        }
        wr.out(" {" true)
        wr.indent(1)
        wr.newline()
        def subCtx:RangerAppWriterContext (unwrap variant.fnCtx)
        subCtx.is_function = true
        this.WalkNode(( unwrap variant.fnBody ) subCtx wr)
        wr.newline()
        wr.indent(-1)
        wr.out("}" true)
      }
    }


    for (this.goAncestors((unwrap cl) ctx)) pName:string ai {
      {
        def pC:RangerAppClassDesc (ctx.findClass(pName))
        wr.out("// inherited methods from parent class " + pName , true)
        for pC.defined_variants fnVar:string i {
          def mVs:RangerAppMethodVariants (get pC.method_variants fnVar)
          for mVs.variants variant:RangerAppFunctionDesc i {

            if(has declaredFn variant.name) {
              ; print variant.name + "was declared already!"
              continue
            }
            ; The NEAREST ancestor that defines a method wins, and the ones
            ; above it are skipped. Without this the walk emitted `parse`
            ; twice for a class whose parent and grandparent both define it,
            ; and Go refuses a method declared on the same type twice.
            set declaredFn variant.name true

            wr.out((((("func (this *" + goName) + ") ") + variant.compiledName) + " (") false)
            this.writeArgsDef(variant ctx wr)
            wr.out(") " false)
            if (variant.nameNode.hasFlag("optional")) {
              wr.out("*GoNullable" false)
            } {
              this.writeTypeDef(( unwrap variant.nameNode ) ctx wr)
            }
            wr.out(" {" true)
            wr.indent(1)
            wr.newline()
            def subCtx:RangerAppWriterContext (unwrap variant.fnCtx)
            subCtx.is_function = true
            this.WalkNode(( unwrap variant.fnBody ) subCtx wr)
            wr.newline()
            wr.indent(-1)
            wr.out("}" true)
          }
        }
        
      }
    }


    def declaredGetter:[string:boolean]

    if( (cl.doesInherit())  || (has cl.extends_classes) ) {

      for cl.variables p:RangerAppParamDesc i {

          set declaredGetter p.name true

          wr.newline()
          wr.out("// getter for variable " + p.name , true)
          wr.out( "func (this *" + goName + ") " , false)
          wr.out("Get_" false)
          wr.out((p.compiledName + "() ") false)
          if (p.nameNode.hasFlag("optional")) {
            wr.out("*GoNullable" false)
          } {
            this.writeTypeDef(( unwrap p.nameNode )ctx wr)
          }
          wr.out(" {" true)
            wr.indent(1)
            wr.out("return this." + p.compiledName , true)
            wr.indent(-1)
          wr.out("}" true)

          wr.newline()
          wr.out("// setter for variable " + p.name , true)
          wr.out( "func (this *" + goName + ") " , false)
          wr.out("Set_" false)
          wr.out(p.compiledName + "( value " , false)
          if (p.nameNode.hasFlag("optional")) {
            wr.out("*GoNullable" false)
          } {
            this.writeTypeDef(( unwrap p.nameNode )ctx wr)
          }        
          wr.out(") " false)

          wr.out(" {" true)
            wr.indent(1)
            wr.out("this." + p.compiledName +" = value " , true)
            wr.indent(-1)
          wr.out("}" true)     
      }    

      ; Every ancestor, not only the direct parents.
      ;
      ; A Go interface is satisfied by having the methods, so a class two
      ; levels down from the one an interface was generated for needs the
      ; grandparent's accessors as much as the parent's. Walking one level
      ; meant `C extends B extends A` silently failed to implement A's
      ; interface, and the error named a method nobody had written.
      for (this.goAncestors((unwrap cl) ctx)) pName:string ai {
        {
          def pC:RangerAppClassDesc (ctx.findClass(pName))
          wr.out("// inherited getters and setters from the parent class " + pName , true)
          for pC.variables p:RangerAppParamDesc i {

            if( has declaredGetter p.name ) {
              continue
            }
            wr.newline()
            wr.out("// getter for variable " + p.name , true)
            wr.out( "func (this *" + goName + ") " , false)
            wr.out("Get_" false)
            wr.out((p.compiledName + "() ") false)
            if (p.nameNode.hasFlag("optional")) {
              wr.out("*GoNullable" false)
            } {
              this.writeTypeDef(( unwrap p.nameNode )ctx wr)
            }
            wr.out(" {" true)
              wr.indent(1)
              wr.out("return this." + p.compiledName , true)
              wr.indent(-1)
            wr.out("}" true)

            wr.newline()
            wr.out("// getter for variable " + p.name , true)
            wr.out( "func (this *" + goName + ") " , false)
            wr.out("Set_" false)
            wr.out(p.compiledName + "( value " , false)
            if (p.nameNode.hasFlag("optional")) {
              wr.out("*GoNullable" false)
            } {
              this.writeTypeDef(( unwrap p.nameNode )ctx wr)
            }        
            wr.out(") " false)

            wr.out(" {" true)
              wr.indent(1)
              wr.out("this." + p.compiledName +" = value " , true)
              wr.indent(-1)
            wr.out("}" true) 
            set declaredGetter p.name true
          }
        }
      }
    }

    for cl.static_methods variant:RangerAppFunctionDesc i {
      def variantName:CodeNode (unwrap variant.nameNode)
      def variantCode:SourceCode (unwrap variantName.code)
      if ((variantName.hasFlag("main")) && (variantCode.filename == (ctx.getRootFile()))) {
        wr.out("func main() {" true)
        wr.indent(1)
        wr.newline()
        def subCtx:RangerAppWriterContext (unwrap variant.fnCtx)
        subCtx.is_function = true
        subCtx.in_static_method = true
        this.WalkNode(( unwrap variant.fnBody ) subCtx wr)
        subCtx.in_static_method = false
        
        if( ctx.hasCompilerFlag('forever')) {
          wr.out(`for {}` true)
        }
        
        wr.newline()
        wr.indent(-1)
        wr.out("}" true)
      }
    }
    
    ; HTTP server boilerplate is now generated by the 'start' operator
    ; httpServerWriter.writeHttpServerClass((unwrap cl) ctx wr)
  }
}


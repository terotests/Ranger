
Import "ng_LowIR.rgr"

class LLVMIRWriter {

  ; Length of the current output line before an instruction's switch runs, so
  ; writeInstr can tell whether any case actually matched.
  def instrLineLen:int 0
  def varargNames:[string]
  def varargSigs:[string]

  fn collectVarargFns:void (module:LowIRModule) {
    def names:[string]
    def sigs:[string]
    this.varargNames = names
    this.varargSigs = sigs
    for module.externDecls d:LowIRExternDecl i {
      if (d.isVararg == false) {
        continue
      }
      def sig:string ""
      def pcnt (array_length d.paramTypes)
      for d.paramTypes pt:string j {
        sig = (sig + pt)
        if (j < (pcnt - 1)) {
          sig = (sig + ", ")
        }
      }
      if (pcnt > 0) {
        sig = (sig + ", ...")
      } {
        sig = (sig + "...")
      }
      push this.varargNames d.fnName
      push this.varargSigs sig
    }
  }

  fn varargSigFor:string (fnName:string) {
    def cnt (array_length this.varargNames)
    def i:int 0
    while (i < cnt) {
      if ((itemAt this.varargNames i) == fnName) {
        return (itemAt this.varargSigs i)
      }
      i = i + 1
    }
    return ""
  }

  ; Map shared Low IR type names to LLVM type names. The Low IR uses "f64" for
  ; doubles (matching the WASM backend); LLVM spells that type "double".
  fn llTy:string (t:string) {
    if (t == "f64") {
      return "double"
    }
    return t
  }

  ; LLVM requires floating-point literals to look like floats ("1" -> "1.0").
  fn normalizeDoubleLit:string (lit:string) {
    if ((indexOf lit ".") >= 0) {
      return lit
    }
    if ((indexOf lit "e") >= 0) {
      return lit
    }
    if ((indexOf lit "E") >= 0) {
      return lit
    }
    if ((indexOf lit "n") >= 0) {
      return lit
    }
    return (lit + ".0")
  }

  fn hexDigit:string (d:int) {
    if (d < 10) {
      return (strfromcode (48 + d))
    }
    return (strfromcode (65 + (d - 10)))
  }

  fn hexByte:string (b:int) {
    def hi:int (to_int (b / 16))
    def lo:int (b - (hi * 16))
    return ("\\" + (this.hexDigit(hi)) + (this.hexDigit(lo)))
  }

  fn llvmEscapeCString:string (text:string) {
    def out:string ""
    def i:int 0
    def n:int (strlen text)
    while (i < n) {
      def code:int (charAt text i)
      if (code == 34) {
        out = out + "\\22"
      } {
        if (code == 92) {
          out = out + "\\\\"
        } {
          if ((code >= 32) && (code < 127)) {
            out = out + (strfromcode code)
          } {
            ; Control chars and non-ASCII: emit raw UTF-8 bytes as \HH escapes
            ; so the byte length matches utf8ByteLen and the constant is valid.
            if (code < 128) {
              out = out + (this.hexByte(code))
            } {
              if (code < 2048) {
                def hi6:int (to_int (code / 64))
                def b1:int (192 + hi6)
                def b2:int (128 + (code - (hi6 * 64)))
                out = out + (this.hexByte(b1))
                out = out + (this.hexByte(b2))
              } {
                def c1:int (to_int (code / 4096))
                def rem:int (code - (c1 * 4096))
                def mid:int (to_int (rem / 64))
                def b1:int (224 + c1)
                def b2:int (128 + mid)
                def b3:int (128 + (rem - (mid * 64)))
                out = out + (this.hexByte(b1))
                out = out + (this.hexByte(b2))
                out = out + (this.hexByte(b3))
              }
            }
          }
        }
      }
      i = i + 1
    }
    return out
  }

  fn writeModule:void (module:LowIRModule wr:CodeWriter) {
    this.collectVarargFns(module)
    wr.out("; Generated by Ranger LLVM backend" true)
    def triple:string module.triple
    if ((strlen triple) == 0) {
      triple = "unknown-unknown-unknown"
    }
    wr.out(("target triple = \"" + triple + "\"") true)
    if (module.useLibcHeap == false) {
      if (LowIRUtil.moduleUsesHeap(module)) {
        wr.out(("@heap_ptr = global " + module.ptrType + " 0") true)
      }
    }
    ; One mutable module global per @singleton class: the accessor builds the
    ; instance on first call and reads it back afterwards.
    for module.singletonClasses sc:string i {
      wr.out(("@singleton_" + sc + " = internal global " + module.ptrType + " 0") true)
    }
    for module.stringGlobals g:LowIRStringGlobal i {
      def esc (this.llvmEscapeCString(g.text))
      if g.withNewline {
        wr.out(("@" + g.name + " = private unnamed_addr constant [" + ("" + g.byteLen) + " x i8] c\"" + esc + "\\0A\\00\"") true)
      } {
        wr.out(("@" + g.name + " = private unnamed_addr constant [" + ("" + g.byteLen) + " x i8] c\"" + esc + "\\00\"") true)
      }
    }
    for module.externDecls d:LowIRExternDecl i {
      if ((strlen d.declSig) > 0) {
        wr.out(("declare " + d.retType + " @" + d.fnName + d.declSig) true)
        continue _
      }
      wr.out(("declare " + (this.llTy(d.retType)) + " @" + d.fnName + "(") false)
      def pcnt (array_length d.paramTypes)
      for d.paramTypes pt:string j {
        wr.out(((this.llTy(pt)) + "") false)
        if (j < (pcnt - 1)) {
          wr.out(", " false)
        }
      }
      if d.isVararg {
        if (pcnt > 0) {
          wr.out(", " false)
        }
        wr.out("...)" true)
      } {
        wr.out(")" true)
      }
    }
    wr.newline()
    for module.structs st:LowIRStruct i {
      this.writeStruct(st wr)
    }
    if ((array_length module.typeDescs) > 0) {
      this.writeTypeDescs(module wr)
    }
    for module.functions fn:LowIRFunction i {
      this.writeFunction(fn wr)
    }
  }

  fn writeTypeDescs:void (module:LowIRModule wr:CodeWriter) {
    wr.out("%struct.RangerFieldDesc = type { i32, i8, i8, i8, i8 }" true)
    wr.out("%struct.RangerTypeDesc = type { i32, i16, i16, ptr }" true)
    for module.typeDescs td:LowIRTypeDesc i {
      this.writeOneTypeDesc(td wr)
    }
    wr.newline()
  }

  fn writeOneTypeDesc:void (td:LowIRTypeDesc wr:CodeWriter) {
    def fc (array_length td.fields)
    def fieldsRef:string "ptr null"
    if (fc > 0) {
      def arrName:string (td.className + "_typeFields")
      wr.out(("@" + arrName + " = private constant [" + ("" + fc) + " x %struct.RangerFieldDesc] [") false)
      def j:int 0
      while (j < fc) {
        def fd (itemAt td.fields j)
        wr.out(("%struct.RangerFieldDesc { i32 " + ("" + fd.offset) + ", i8 " + ("" + fd.kind) + ", i8 " + ("" + fd.owned) + ", i8 0, i8 0 }") false)
        if (j < (fc - 1)) {
          wr.out(", " false)
        }
        j = j + 1
      }
      wr.out("]" true)
      fieldsRef = ("ptr @" + arrName)
    }
    def tdName:string (td.className + "_typeDesc")
    wr.out(("@" + tdName + " = private constant %struct.RangerTypeDesc { i32 " + ("" + td.size) + ", i16 " + ("" + fc) + ", i16 0, " + fieldsRef + " }") true)
  }

  fn writeStruct:void (st:LowIRStruct wr:CodeWriter) {
    wr.out(("%struct." + st.name + " = type { ") false)
    def cnt (array_length st.fields)
    for st.fields f:LowIRField i {
      wr.out((this.llTy(f.irType)) false)
      if (i < (cnt - 1)) {
        wr.out(", " false)
      }
    }
    wr.out(" }" true)
  }

  fn writeFunction:void (fn:LowIRFunction wr:CodeWriter) {
    wr.newline()
    if fn.exportFn {
      wr.out("define dso_local " false)
    } {
      wr.out("define private " false)
    }
    wr.out((this.llTy(fn.returnType)) false)
    wr.out((" @" + fn.name + "(") false)
    def pcnt (array_length fn.params)
    for fn.params p:LowIRParam i {
      wr.out(((this.llTy(p.irType)) + " %" + p.name) false)
      if (i < (pcnt - 1)) {
        wr.out(", " false)
      }
    }
    wr.out(") {" true)

    for fn.blocks bb:LowIRBlock i {
      wr.out((bb.label + ":") true)
      for bb.instrs ins:LowIRInstr i {
        this.writeInstr(ins wr)
      }
      this.writeTerminator(bb wr)
    }
    wr.out("}" true)
  }

  ; An op with no case in writeInstrBody used to write NOTHING -- the indent is
  ; already out, so the instruction silently vanished while its SSA temp had
  ; already been handed to whatever consumed it. The module then referenced a
  ; value nothing defined, and the only symptom was clang's "use of undefined
  ; value" a long way from the cause. Twice. Comparing the line length across
  ; the switch says whether a case actually ran.
  fn writeInstr:void (ins:LowIRInstr wr:CodeWriter) {
    wr.out("  " false)
    this.instrLineLen = (strlen wr.currentLine)
    this.writeInstrBody(ins wr)
    if ((strlen wr.currentLine) == this.instrLineLen) {
      ; Deliberately invalid IR rather than a comment: this has to stop the
      ; build, not decorate it.
      wr.out(("UNHANDLED-LOWIR-OP " + (ins.op + (" dest=" + ins.dest))) true)
    }
  }

  fn writeInstrBody:void (ins:LowIRInstr wr:CodeWriter) {
    switch ins.op {
      case "comment" {
        wr.out(("; " + ins.arg1) true)
      }
      case "const" {
        if (ins.irType == "i1") {
          if (ins.arg1 == "1") {
            wr.out((ins.dest + " = icmp ne i32 1, 0") true)
          } {
            wr.out((ins.dest + " = icmp eq i32 0, 1") true)
          }
        } {
          if (ins.irType == "f64") {
            wr.out((ins.dest + " = fadd double 0.0, " + (this.normalizeDoubleLit(ins.arg1))) true)
          } {
            wr.out((ins.dest + " = add " + ins.irType + " 0, " + ins.arg1) true)
          }
        }
      }
      case "add" {
        wr.out((ins.dest + " = add " + ins.irType + " " + ins.arg1 + ", " + ins.arg2) true)
      }
      case "sub" {
        wr.out((ins.dest + " = sub " + ins.irType + " " + ins.arg1 + ", " + ins.arg2) true)
      }
      case "mul" {
        wr.out((ins.dest + " = mul " + ins.irType + " " + ins.arg1 + ", " + ins.arg2) true)
      }
      case "sdiv" {
        wr.out((ins.dest + " = sdiv " + ins.irType + " " + ins.arg1 + ", " + ins.arg2) true)
      }
      case "srem" {
        wr.out((ins.dest + " = srem " + ins.irType + " " + ins.arg1 + ", " + ins.arg2) true)
      }
      case "or" {
        wr.out((ins.dest + " = or " + ins.irType + " " + ins.arg1 + ", " + ins.arg2) true)
      }
      case "and" {
        wr.out((ins.dest + " = and " + ins.irType + " " + ins.arg1 + ", " + ins.arg2) true)
      }
      case "xor" {
        wr.out((ins.dest + " = xor " + ins.irType + " " + ins.arg1 + ", " + ins.arg2) true)
      }
      case "shl" {
        wr.out((ins.dest + " = shl " + ins.irType + " " + ins.arg1 + ", " + ins.arg2) true)
      }
      case "ashr" {
        wr.out((ins.dest + " = ashr " + ins.irType + " " + ins.arg1 + ", " + ins.arg2) true)
      }
      case "lshr" {
        wr.out((ins.dest + " = lshr " + ins.irType + " " + ins.arg1 + ", " + ins.arg2) true)
      }
      case "heap_alloc" {
        ; The bump-pointer update needs a UNIQUE SSA name. It used to be the
        ; fixed "%heap_next", so a function containing two allocations emitted
        ; two definitions of the same value -- invalid IR that clang and
        ; llvm-verify both reject. Derived from the destination, which is
        ; already unique.
        def nextName:string (ins.dest + "_next")
        wr.out((ins.dest + " = load " + ins.irType + ", " + ins.irType + "* @heap_ptr") true)
        wr.out(("  " + nextName + " = add " + ins.irType + " " + ins.dest + ", " + ins.arg1) true)
        wr.out(("  store " + ins.irType + " " + nextName + ", " + ins.irType + "* @heap_ptr") true)
      }
      case "ptr_load" {
        def addrType:string ins.arg2
        if ((strlen addrType) == 0) {
          addrType = ins.irType
        }
        def valTy (this.llTy(ins.irType))
        wr.out((ins.dest + "_p = inttoptr " + addrType + " " + ins.arg1 + " to " + valTy + "*") true)
        wr.out(("  " + ins.dest + " = load " + valTy + ", " + valTy + "* " + ins.dest + "_p") true)
      }
      case "ptr_store" {
        def valType:string (this.llTy(ins.irType))
        def addrType:string ins.arg3
        if ((strlen addrType) == 0) {
          addrType = valType
        }
        def castName:string (ins.arg1 + "_p")
        if ((strlen ins.dest) > 0) {
          castName = (ins.arg1 + "_p_" + ins.dest)
        }
        wr.out((castName + " = inttoptr " + addrType + " " + ins.arg1 + " to " + valType + "*") true)
        wr.out(("  store " + valType + " " + ins.arg2 + ", " + valType + "* " + castName) true)
      }
      case "inttoptr_struct" {
        wr.out((ins.dest + " = inttoptr " + ins.arg2 + " " + ins.arg1 + " to %struct." + ins.structName + "*") true)
      }
      case "inttoptr_i8" {
        wr.out((ins.dest + " = inttoptr " + ins.arg2 + " " + ins.arg1 + " to i8*") true)
      }
      case "ptr_to_int" {
        wr.out((ins.dest + " = ptrtoint i8* " + ins.arg1 + " to " + ins.irType) true)
      }
      case "sitofp" {
        wr.out((ins.dest + " = sitofp " + (this.llTy(ins.arg2)) + " " + ins.arg1 + " to " + (this.llTy(ins.irType))) true)
      }
      case "fptosi" {
        wr.out((ins.dest + " = fptosi " + (this.llTy(ins.arg2)) + " " + ins.arg1 + " to " + (this.llTy(ins.irType))) true)
      }
      case "fadd" {
        wr.out((ins.dest + " = fadd " + (this.llTy(ins.irType)) + " " + ins.arg1 + ", " + ins.arg2) true)
      }
      case "fsub" {
        wr.out((ins.dest + " = fsub " + (this.llTy(ins.irType)) + " " + ins.arg1 + ", " + ins.arg2) true)
      }
      case "fmul" {
        wr.out((ins.dest + " = fmul " + (this.llTy(ins.irType)) + " " + ins.arg1 + ", " + ins.arg2) true)
      }
      case "fdiv" {
        wr.out((ins.dest + " = fdiv " + (this.llTy(ins.irType)) + " " + ins.arg1 + ", " + ins.arg2) true)
      }
      case "zext" {
        ; The SOURCE type was hard-coded to i32, so widening an i1 (a boolean
        ; stored into a pointer-sized map slot) wrote `zext i32 <i1 value>`.
        def zsrc:string "i32"
        if ((strlen ins.arg2) > 0) {
          zsrc = ins.arg2
        }
        wr.out((ins.dest + " = zext " + zsrc + " " + ins.arg1 + " to " + ins.irType) true)
      }
      case "zext_i1" {
        wr.out((ins.dest + " = zext i1 " + ins.arg1 + " to i32") true)
      }
      case "global_get" {
        wr.out((ins.dest + " = load " + (this.llTy(ins.irType)) + ", " + (this.llTy(ins.irType)) + "* @" + ins.arg1) true)
      }
      case "global_set" {
        wr.out(("store " + (this.llTy(ins.irType)) + " " + ins.arg2 + ", " + (this.llTy(ins.irType)) + "* @" + ins.arg1) true)
      }
      case "bitcast" {
        wr.out((ins.dest + " = bitcast " + (this.llTy(ins.arg2)) + " " + ins.arg1 + " to " + (this.llTy(ins.irType))) true)
      }
      case "trunc" {
        wr.out((ins.dest + " = trunc " + (this.llTy(ins.arg2)) + " " + ins.arg1 + " to " + (this.llTy(ins.irType))) true)
      }
      case "icmp" {
        def cmpType:string "i32"
        if ((strlen ins.arg3) > 0) {
          cmpType = ins.arg3
        }
        ; A FLOAT comparison is `fcmp` with an ordered predicate, not `icmp`.
        ; The type and predicate were written through verbatim, so any f64
        ; compare emitted `icmp ne f64 ...` -- which LLVM rejects at "expected
        ; type". Nothing had exercised it until a `double` reached lowerCond.
        if (cmpType == "f64") {
          def fpred:string ins.pred
          if (ins.pred == "eq") { fpred = "oeq" }
          if (ins.pred == "ne") { fpred = "one" }
          if (ins.pred == "slt") { fpred = "olt" }
          if (ins.pred == "sgt") { fpred = "ogt" }
          if (ins.pred == "sle") { fpred = "ole" }
          if (ins.pred == "sge") { fpred = "oge" }
          wr.out((ins.dest + " = fcmp " + fpred + " double " + ins.arg1 + ", " + ins.arg2) true)
        } {
          wr.out((ins.dest + " = icmp " + ins.pred + " " + cmpType + " " + ins.arg1 + ", " + ins.arg2) true)
        }
      }
      case "str_ptr" {
        wr.out((ins.dest + " = getelementptr inbounds [" + ins.arg2 + " x i8], [" + ins.arg2 + " x i8]* @" + ins.arg1 + ", i64 0, i64 0") true)
      }
      case "call" {
        def vsig (this.varargSigFor(ins.fnName))
        def retTy (this.llTy(ins.irType))
        def calleeType:string (retTy + " ")
        if ((strlen ins.callSig) > 0) {
          calleeType = (retTy + " (" + ins.callSig + ") ")
        } {
          if ((strlen vsig) > 0) {
            calleeType = (retTy + " (" + vsig + ") ")
          }
        }
        if ((strlen ins.dest) > 0) {
          wr.out((ins.dest + " = call " + calleeType + "@" + ins.fnName + "(") false)
        } {
          wr.out(("call " + calleeType + "@" + ins.fnName + "(") false)
        }
        def acnt (array_length ins.callArgs)
        for ins.callArgs a:string j {
          def argType:string "i32"
          if (j < (array_length ins.callTypes)) {
            argType = (itemAt ins.callTypes j)
          }
          if ((strlen argType) == 0) {
            wr.out(a false)
          } {
            wr.out(((this.llTy(argType)) + " " + a) false)
          }
          if (j < (acnt - 1)) {
            wr.out(", " false)
          }
        }
        wr.out(")" true)
      }
      case "alloca" {
        wr.out((ins.dest + " = alloca " + (this.llTy(ins.irType))) true)
      }
      case "alloca_struct" {
        wr.out((ins.dest + " = alloca %struct." + ins.structName) true)
      }
      case "gep" {
        wr.out((ins.dest + " = getelementptr %struct." + ins.structName + ", %struct." + ins.structName + "* " + ins.arg1 + ", i32 0, i32 " + ("" + ins.fieldIndex)) true)
      }
      case "load" {
        def lt (this.llTy(ins.irType))
        wr.out((ins.dest + " = load " + lt + ", " + lt + "* " + ins.arg1) true)
      }
      case "store" {
        def stt (this.llTy(ins.irType))
        wr.out(("store " + stt + " " + ins.arg1 + ", " + stt + "* " + ins.arg2) true)
      }
    }
  }

  fn writeTerminator:void (bb:LowIRBlock wr:CodeWriter) {
    wr.out("  " false)
    switch bb.termKind {
      case "ret" {
        if ((strlen bb.termValue) > 0) {
          wr.out(("ret " + (this.llTy(bb.termType)) + " " + bb.termValue) true)
        } {
          wr.out("ret void" true)
        }
      }

      case "br" {
        wr.out(("br label %" + bb.termTarget) true)
      }
      case "br_if" {
        wr.out(("br i1 " + bb.termValue + ", label %" + bb.termIfTrue + ", label %" + bb.termIfFalse) true)
      }
      case "unreachable" {
        wr.out("unreachable" true)
      }
    }
  }
}

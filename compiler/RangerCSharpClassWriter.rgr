class RangerCSharpClassWriter {
  Extends (RangerGenericClassWriter)
  def compiler:LiveCompiler
  fn adjustType:string (tn:string) {
    if (tn == "this") {
      return "this"
    }
    return tn
  }
  ; S5 (PLAN_SHAPES.md): a union is an interface its members implement, so the
  ; static type survives. `dynamic` compiled but gave up every compile-time
  ; check and routed each call through the DLR.
  def csharp_unions_written:boolean false

  ; The file-scoped namespace is written once, before the first type. A NuGet
  ; package whose types sit in the global namespace is not a package anybody
  ; can consume next to another one.
  def csharp_namespace_written:boolean false

  ; Serial number for the lambda parameter renaming in CreateLambda below.
  def csLambdaArgCounter:int 0

  ; which behaviour-only Ranger `trait`s become a C# interface
  def csTraits:TraitInterfaceAnalysis (new TraitInterfaceAnalysis())
  ; can a `for` be the target's own loop over the collection?
  ; Target-neutral question, one place: compiler/ForLoopAnalysis.rgr
  def csLoops:ForLoopShape (new ForLoopShape())
  def csharp_traits_written:boolean false

  ; which Ranger `Enum`s survive as a C# `enum` rather than a bare int. The
  ; question is the same one Rust and C++ ask, so the rules live in
  ; EnumNativeAnalysis (compiler/EnumAnalysis.rgr).
  def csEnums:EnumNativeAnalysis (new EnumNativeAnalysis())
  def csharp_enums_written:boolean false

  fn csEnumIsNative:boolean (enumName:string ctx:RangerAppWriterContext) {
    csEnums.targetName = "csharp"
    csEnums.fallbackType = "int"
    return (csEnums.isNative(enumName ctx))
  }

  ; `public enum Color : int { Red = 0, Green = 1 }`. The underlying type is
  ; pinned to int -- the type the fallback lowering uses -- so a cast back is
  ; exact and nothing downstream has to know which form the enum got.
  fn writeCSharpNativeEnums:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    if csharp_enums_written {
      return
    }
    csharp_enums_written = true
    def enumRoot:RangerAppWriterContext (ctx.getRoot())
    for (keys enumRoot.definedEnums) cen:string cei {
      if (this.csEnumIsNative(cen ctx)) {
        def ceDef:RangerAppEnum (unwrap (get enumRoot.definedEnums cen))
        wr.out("" true)
        wr.out(("public enum " + cen + " : int {") true)
        wr.indent(1)
        for (keys ceDef.values) cmn:string cmi {
          def cmv:int (unwrap (get ceDef.values cmn))
          wr.out(((ctx.transformWord(cmn)) + " = " + (to_string cmv) + ",") true)
        }
        wr.indent(-1)
        wr.out("}" true)
      }
    }
  }

  ; A behaviour-only trait named as a type, as a C# interface. The mixin copy
  ; still gives each consumer its own body; this makes the name a type, and
  ; those bodies are the implementations. C# interface members are implicitly
  ; public, and the copied methods already are.
  fn writeCSharpTraitInterfaces:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    if csharp_traits_written {
      return
    }
    csharp_traits_written = true
    csTraits.compute(ctx)
    for (keys csTraits.ifaceTraits) tn:string tni {
      def tc:RangerAppClassDesc (ctx.findClass(tn))
      wr.out("" true)
      wr.out(("public interface " + tn + " {") true)
      wr.indent(1)
      for tc.defined_variants fnVar:string fvi {
        def mVs:RangerAppMethodVariants (get tc.method_variants fnVar)
        for mVs.variants variant:RangerAppFunctionDesc vi {
          this.writeTypeDef( (unwrap variant.nameNode) ctx wr)
          wr.out((" " + variant.compiledName + "(") false)
          this.writeArgsDef(variant ctx wr)
          wr.out(");" true)
        }
      }
      wr.indent(-1)
      wr.out("}" true)
    }
  }

  fn writeCSharpUnionInterfaces:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    if csharp_unions_written {
      return
    }
    csharp_unions_written = true
    def names:[string] (this.sealableUnionNames(ctx))
    for names uname:string ui {
      wr.out("" true)
      wr.out(("public interface " + (this.unionInterfaceName(uname)) + " { }") true)
    }
  }

  ; --- native generics: `class History<Op>`, used as `History<int>` ---
  fn csClassRef:string (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    if cl.is_type_param {
      return cl.type_param_name
    }
    if (ctx.isNativeGenericInstance(cl)) {
      def res:string (cl.generic_template + "<")
      for cl.generic_args a:string i {
        if (i > 0) {
          res = (res + ", ")
        }
        res = (res + (this.getObjectTypeString(a ctx)))
      }
      return (res + ">")
    }
    return cl.name
  }
  fn genericClassRef:string (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    return (this.csClassRef(cl ctx))
  }

  fn getObjectTypeString:string (type_string:string ctx:RangerAppWriterContext) {

    ; A collection nested inside another collection arrives here as its Ranger
    ; spelling -- "[string]" for the value type of a [string:[string]] -- and
    ; the fallthrough at the end of this function returned it unchanged, so the
    ; declaration came out as Dictionary<String,[string]>.
    if ((strlen type_string) >= 2) {
      if ((charAt type_string 0) == (ccode "[")) {
        return (this.collectionTypeStringToCS(type_string ctx))
      }
    }

    if(ctx.isDefinedClass(type_string)) {
      def cc (ctx.findClass(type_string))
      if (cc.is_type_param || (ctx.isNativeGenericInstance(cc))) {
        return (this.csClassRef(cc ctx))
      }
      if(cc.is_union) {
        if (this.unionIsSealable(cc ctx)) {
          return (this.unionInterfaceName(type_string))
        }
        return "dynamic"
      }

      if(cc.is_system) {
        def sysName (get cc.systemNames "csharp")
        if(!null? sysName) {
          return (unwrap sysName)
        } {
          def node (new CodeNode( (new SourceCode("")) 0 0 ))
          ctx.addError(node ( 'No system class ' + type_string +  'defined for C# '))
        }
      }      
    }
    
    switch type_string {
      case "int" {
        return "int"
      }
      case "string" {
        return "String"
      }
      case "chararray" {
        return "byte[]"
      }
      case "buffer" {
        return "byte[]"
      }
      case "int_buffer" {
        return "long[]"
      }
      case "double_buffer" {
        return "double[]"
      }
      case "char" {
        return "byte"
      }
      case "boolean" {
        return "bool"
      }
      case "double" {
        return "double"
      }
    }
    return type_string
  }

  ; Convert nested collection type strings such as "[string]" or
  ; "[string:[int]]" into C# List / Dictionary types.
  fn collectionTypeStringToCS:string (type_string:string ctx:RangerAppWriterContext) {
    def n:int (strlen type_string)
    def inner:string (substring type_string 1 (n - 1))
    def il:int (strlen inner)
    def depth:int 0
    def sep:int (0 - 1)
    def i:int 0
    while (i < il) {
      def c:int (charAt inner i)
      if (c == (ccode "[")) {
        depth = depth + 1
      }
      if (c == (ccode "]")) {
        depth = depth - 1
      }
      if ((c == (ccode ":")) && (depth == 0)) {
        sep = i
      }
      i = i + 1
    }
    if (sep >= 0) {
      def kt:string (substring inner 0 sep)
      def vt:string (substring inner (sep + 1) il)
      return (((("Dictionary<" + (this.getObjectTypeString(kt ctx))) + ",") + (this.getObjectTypeString(vt ctx))) + ">")
    }
    return (("List<" + (this.getObjectTypeString(inner ctx))) + ">")
  }

  fn getTypeString:string (type_string:string) {
    switch type_string {
      case "int" {
        return "int"
      }
      case "string" {
        return "String"
      }
      case "chararray" {
        return "byte[]"
      }
      case "buffer" {
        return "byte[]"
      }
      case "int_buffer" {
        return "long[]"
      }
      case "double_buffer" {
        return "double[]"
      }
      case "char" {
        return "byte"
      }
      case "boolean" {
        return "bool"
      }
      case "double" {
        return "double"
      }
    }
    return type_string
  }

  fn writeLambdaType (expression_value:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {

    def rv:CodeNode (itemAt expression_value.children 0)
    def sec:CodeNode (itemAt expression_value.children 1)
    def fc:CodeNode (sec.getFirst())
;        this.import_lib("<functional>" ctx wr)
    def is_void false
    if(rv.type_name == "void" || rv.eval_type_name == "void") {
      is_void = true
    }
    if is_void {
      wr.out("Action" false)
      if( (array_length sec.children) > 0 ) {
        wr.out("<" false)
      }
    } {
      wr.out("Func<" false)
    }
    for sec.children arg:CodeNode i {
      if( i > 0 ) {
        wr.out(', ' false)
      }
      this.writeTypeDef( arg ctx wr)
    }
    if( is_void == false ) {
      if( (array_length sec.children) > 0 ) {
        wr.out(', ' false)
      }
      this.writeTypeDef( rv ctx wr)
    }
    if is_void {
      if( (array_length sec.children) > 0 ) {
        wr.out(">" false)
      }
    } {
      wr.out(">" false)
    }    
  }

  ; `?` after a value type when the declaration is optional.
  fn writeNullableMark:void (node:CodeNode wr:CodeWriter) {
    if (node.hasFlag("optional")) {
      wr.out("?" false)
    }
  }

  fn writeTypeDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def v_type:RangerNodeType node.value_type    
    def t_name:string node.type_name
    def a_name:string node.array_type
    def k_name:string node.key_type
    if ((v_type == RangerNodeType.Object) || (v_type == RangerNodeType.VRef) || (v_type == RangerNodeType.NoType)) {
      v_type = (node.typeNameAsType(ctx))
    }
    if (node.eval_type != RangerNodeType.NoType) {
      v_type = node.eval_type
      if ( (strlen node.eval_type_name) > 0 ) {
        t_name = node.eval_type_name
      }
      if ( (strlen node.eval_array_type) > 0 ) {
        a_name = node.eval_array_type
      }
      if ( (strlen node.eval_key_type) > 0 ) {
        k_name = node.eval_key_type
      }
    }

    switch v_type {

      case RangerNodeType.ExpressionType {
        this.writeLambdaType( (unwrap node.expression_value) ctx wr)
      }   
      
      ; An optional primitive is Nullable<T> on C#. Without the `?` the
      ; declaration is a plain value type: it can never be null, the `!= null`
      ; test the operator writes is always true, and `.Value` does not exist on
      ; it. A reference type is already nullable and takes no marker.
      case RangerNodeType.Enum {
        ; the enum's own name when every use in the program is one a C# enum
        ; can carry, int otherwise
        if (this.csEnumIsNative(t_name ctx)) {
          wr.out(t_name false)
        } {
          wr.out("int" false)
        }
        this.writeNullableMark(node wr)
      }
      case RangerNodeType.Integer {
        wr.out("int" false)
        this.writeNullableMark(node wr)
      }
      case RangerNodeType.Double {
        wr.out("double" false)
        this.writeNullableMark(node wr)
      }
      case RangerNodeType.Char {
        wr.out("byte" false)
        this.writeNullableMark(node wr)
      }
      case RangerNodeType.CharBuffer {
        wr.out("byte[]" false)
      }
      case RangerNodeType.Buffer {
        wr.out("byte[]" false)
      }
      case RangerNodeType.IntBuffer {
        wr.out("long[]" false)
      }
      case RangerNodeType.DoubleBuffer {
        wr.out("double[]" false)
      }
      case RangerNodeType.String {
        wr.out("String" false)
      }
      case RangerNodeType.Boolean {
        wr.out("bool" false)
        this.writeNullableMark(node wr)
      }
      case RangerNodeType.Hash {
        wr.out((((("Dictionary<" + (this.getObjectTypeString(k_name ctx))) + ",") + (this.getObjectTypeString(a_name ctx))) + ">") false)
        wr.addImport("System.Collections")
        wr.addImport("System.Collections.Generic")
      }
      case RangerNodeType.Array {
        wr.out((("List<" + (this.getObjectTypeString(a_name ctx))) + ">") false)
        wr.addImport("System.Collections")
        wr.addImport("System.Collections.Generic")
      }
      default {
        if (node.type_name == "void") {
          wr.out("void" false)
          return
        }

        if(ctx.isDefinedClass(t_name)) {
          def cc (ctx.findClass(t_name))
          if (cc.is_type_param || (ctx.isNativeGenericInstance(cc))) {
            wr.out((this.csClassRef(cc ctx)) false)
            return
          }
          if(cc.is_union) {
            ; a union of classes is an interface those classes implement; a
            ; union over primitives (and the compiler's own `Any`) stays dynamic
            if (this.unionIsSealable(cc ctx)) {
              wr.out((this.unionInterfaceName(t_name)) false)
              return
            }
            wr.out("dynamic" false)
            ;if (node.hasFlag("optional")) {
            ;  wr.out("?" false)
            ;}            
            return
          }
          if(cc.is_system) {
            def sysName (get cc.systemNames "csharp")
            if(!null? sysName) {
              wr.out( (unwrap sysName) false)
            } {
              ctx.addError(node ( 'No system class ' + t_name +  "defined for C# "))
            }
            return
          }      
          ; A trait CARRYING FIELDS is not a C# interface: its consumers each
          ; own their own copy of the field, so there is nothing for an
          ; interface to promise. It used to reach the file as the bare name,
          ; which mcs answers with "The type or namespace name could not be
          ; found". A trait of methods only is an interface
          ; (writeCSharpTraitInterfaces) and does name a type.
          if cc.is_trait {
            if ((csTraits.isInterface(t_name ctx)) == false) {
              ctx.addError(node (("the C# target writes a `trait` as a mixin, so `" + t_name) + "` is not a type it can name. A trait that declares only METHODS becomes a C# interface and can be used as a type; this one carries fields, which its consumers each hold their own copy of. Use a class with subclasses, or give the parameter a concrete type."))
            }
          }
        }        
        wr.out((this.getTypeString(node.type_name)) false)
      }
    }

    ; if (node.hasFlag("optional")) {
    ;   wr.out("?" false)
    ; }
  }
  fn WriteVRef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (node.eval_type == RangerNodeType.Enum) {
      if( (array_length node.ns) > 1) {
        def rootObjName:string (itemAt node.ns 0)
        def enumName:string (itemAt node.ns 1)
        def e@(optional):RangerAppEnum (ctx.getEnum(rootObjName))
        if (!null? e) {
          ; `Color.Green`, not `1`, when the enum survives as a C# enum
          if (this.csEnumIsNative(rootObjName ctx)) {
            wr.out((rootObjName + "." + (ctx.transformWord(enumName))) false)
            return
          }
          wr.out(("" + (unwrap (get e.values enumName))) false)
          return
        }
      }
    }
    if ((array_length node.nsp) > 0) {
      for node.nsp p:RangerAppParamDesc i {
        if (i > 0) {
          wr.out("." false)
        }
  
        if (i == 0) {
          def part:string (itemAt node.ns 0)
          if(part == "this") {
            if( ctx.inLambda() ) {
              wr.out("this" false)
              ; def currC (ctx.getCurrentClass())
              ; wr.out( (currC.name + ".this") false)
            } {
              wr.out("this" false)
            }            
            continue
          } 
        }

        if (i == 0) {
          if (p.nameNode.hasFlag("optional")) {
          }
        }
        if ((strlen p.compiledName) > 0) {
          wr.out((this.adjustType(p.compiledName)) false)
        } {
          if ((strlen p.name) > 0) {
            wr.out((this.adjustType(p.name)) false)
          } {
            wr.out((this.adjustType( (itemAt node.ns i))) false)
          }
        }
      }
      return
    }
    if node.hasParamDesc {
      def p:RangerAppParamDesc node.paramDesc
      wr.out(p.compiledName false)
      return
    }
    for node.ns part:string i {
      if (i > 0) {
        wr.out("." false)
      }
      wr.out((this.adjustType(part)) false)
    }
  }
  ; True when a node, or anything under it, calls something.
  fn csNodeContainsCall:boolean (node:CodeNode) {
    if node.hasFnCall {
      return true
    }
    if node.has_call {
      return true
    }
    if node.has_lambda_call {
      return true
    }
    for node.children ch:CodeNode ci {
      if (this.csNodeContainsCall(ch)) {
        return true
      }
    }
    return false
  }

  fn writeVarDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasParamDesc {
      def nn:CodeNode (itemAt node.children 1)
      def p:RangerAppParamDesc nn.paramDesc
      ; An unused `def` whose initializer CALLS still has to run --
      ; `def ignored:T (this.work())` is the language's evaluate-and-discard
      ; form. Commenting it out dropped the call: the TS engine's for-loop
      ; update clause vanished this way, so every `for` ran until the
      ; interpreter's own iteration guard stopped it.
      def unusedDef:boolean ((p.ref_cnt == 0) && (p.is_class_variable == false))
      def keepsCall:boolean false
      if unusedDef {
        if ((array_length node.children) > 2) {
          if (this.csNodeContainsCall((node.getThird()))) {
            keepsCall = true
          }
        }
      }
      if (unusedDef && (keepsCall == false)) {
        wr.out('/* unused:  ' false)
      }
      if ((p.set_cnt > 0) || p.is_class_variable) {
        wr.out("" false)
      } {
        ; const could be set here, if detected correctly
        wr.out("" false)
      }
      this.writeTypeDef(( unwrap p.nameNode ) ctx wr)
      wr.out(' ' false)
      if keepsCall {
        wr.out("_" false)
      }
      wr.out(p.compiledName false)
      if ((array_length node.children) > 2) {
        wr.out(' = ' false)
        ctx.setInExpr()
        def value:CodeNode (node.getThird())
        this.WalkNode(value ctx wr)
        ctx.unsetInExpr()
      } {
        if (nn.value_type == RangerNodeType.Array) {
          wr.out(' = new ' false)
          this.writeTypeDef(( unwrap p.nameNode ) ctx wr)
          wr.out('()' false)
        }
        if (nn.value_type == RangerNodeType.Hash) {
          wr.out(' = new ' false)
          this.writeTypeDef(( unwrap p.nameNode ) ctx wr)
          wr.out('()' false)
        }
        ; An optional with no initializer is `def x@(optional):T` -- the
        ; language's empty value. C# calls a local that is never assigned
        ; DEFINITELY UNASSIGNED and refuses to read it, so it needs the null
        ; written out. (A field gets its default automatically; only locals
        ; have the rule.)
        if ((nn.value_type != RangerNodeType.Array) && (nn.value_type != RangerNodeType.Hash)) {
          if ((p.is_class_variable == false) && (nn.hasFlag("optional"))) {
            wr.out(' = null' false)
          }
        }
      }
      if ((p.ref_cnt == 0) && (p.is_class_variable == true)) {
        wr.out('     /* note: unused */' false)
      }
      if (unusedDef && (keepsCall == false)) {
        wr.out("   **/ ;" true)
      } {
        wr.out(";" false)
        wr.newline()
      }
    }
  }

  ; C# does not allow a lambda parameter to reuse a name that is already live in
  ; an enclosing scope: `xs.forEach({ ys.forEach({ ... }) })` writes `item` and
  ; `index` twice and stops with CS0136, "would give a different meaning". The
  ; implicit names of a nested forEach make that shape common -- it was 96 of
  ; the errors the generated compiler produced. Ranger allows the shadowing, so
  ; the writer renames the inner parameter. Renaming the ParamDesc renames the
  ; reads too: WriteVRef writes compiledName, and the body resolves to this same
  ; descriptor.
  ;
  ; A member variable is left alone -- C# is happy for a local to shadow a
  ; field, and renaming there would only make the output harder to read.
  fn renameShadowedLambdaArg:void (arg:CodeNode ctx:RangerAppWriterContext) {
    if (arg.hasParamDesc == false) {
      return
    }
    ; unwrap, not a plain read: paramDesc is @(weak optional), and on the C++
    ; target a plain member read of it is an alias the writer tries to bind a
    ; reference to -- which does not compile against the temporary that the
    ; weak-to-shared conversion produces.
    def p:RangerAppParamDesc (unwrap arg.paramDesc)
    def nm:string p.name
    if ((strlen nm) == 0) {
      return
    }
    ; already renamed on an earlier visit to this same descriptor
    if ((indexOf p.compiledName "__l") >= 0) {
      return
    }
    if ((ctx.isVarDefined(nm)) == false) {
      return
    }
    if (ctx.isMemberVariable(nm)) {
      return
    }
    csLambdaArgCounter = csLambdaArgCounter + 1
    p.compiledName = ((nm + "__l") + csLambdaArgCounter)
  }

  fn CreateLambda:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {

    ;         this.writeLambdaType( (unwrap node.expression_value) ctx wr)

    def lambdaCtx (unwrap node.lambda_ctx)
    def fName:CodeNode (itemAt node.children 1)
    def body:CodeNode (itemAt node.children 2)
    def args:CodeNode (itemAt node.children 1)
    
    wr.out('(' false)
    wr.out('(' false)
    this.writeLambdaType( node ctx wr)
    wr.out(')' false)

    wr.out('(' false)
;    this.WalkNode(fName ctx wr)
    wr.out("(" false)
    for args.children arg:CodeNode i {
      if (i > 0) {
        wr.out(', ' false)
      }
      if(arg.flow_done == false) {
        this.compiler.parser.WalkNode( arg lambdaCtx wr)
      }
      this.renameShadowedLambdaArg(arg ctx)
      this.WalkNode(arg lambdaCtx wr)
    }
    wr.out(')' false)
    wr.out(' => { ' true)
    wr.indent(1)
    lambdaCtx.restartExpressionLevel()
    for body.children item:CodeNode i {
      this.WalkNode(item lambdaCtx wr)
    }
    wr.newline()
    wr.indent(-1)
    wr.out("}" false)
    wr.out('))' false)

    if ((ctx.expressionLevel()) == 0) {
      wr.out(';' true)
    }

  }


  ; The constructor of a `record` holds a marker parameter for each keyword,
  ; next to the parameter that carries the value. The marker has a name and no
  ; type, so it must not reach the signature: without this filter the
  ; constructor of `record Point { def xpos:int 0 def ypos:int 0 }` comes out
  ; with four parameters, two of them without a type.
  fn writeArgsDef:void (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    def pms (filter (fnDesc.params) {
      if (item.nameNode.hasFlag("keyword")) {
        return false
      }
      return true
    })
    for pms arg:RangerAppParamDesc i {
      if (i > 0) {
        wr.out("," false)
      }
      wr.out(' ' false)
      this.writeTypeDef( (unwrap arg.nameNode ) ctx wr)
      wr.out(((' ' + arg.compiledName) + " ") false)
    }
  }

  fn writeArrayLiteral( node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {

    wr.out('new List<' false)
    wr.out( (this.getObjectTypeString( node.eval_array_type ctx )) false )
    wr.out('> {' false)
    node.children.forEach({
      if( index > 0 ) {
        wr.out(', ' false)
      }
      this.WalkNode( item ctx wr )
    })
    wr.out("}" false)
  }

  ; C# is not JavaScript, and the difference is not cosmetic:
  ;
  ;   * a field a subclass redeclares is a SECOND storage slot, so a write
  ;     through the subclass and a read through a base typed reference touch
  ;     different memory. RangerAppFunctionDesc redeclares `name`, `node`,
  ;     `nameNode` and five more from RangerAppParamDesc, all with the same
  ;     initializer, exactly the way JavaScript lets you.
  ;   * a method a subclass redeclares WITHOUT `override` is a second method,
  ;     and a call through a base typed reference runs the base one. Every
  ;     language writer redeclares writeClass from RangerGenericClassWriter, so
  ;     `langWriter.writeClass(...)` wrote the generic placeholder -- the C#
  ;     build of the compiler produced `class X { /* static main */ }` for
  ;     every target and reported success.
  ;
  ; Neither showed up as an error: 894 CS0108 warnings and a program that ran.
  fn csCollectInherited:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext vars:[string:boolean] methods:[string:int]) {
    for cl.extends_classes pName:string i {
      if (ctx.isDefinedClass(pName)) {
        def pc:RangerAppClassDesc (ctx.findClass(pName))
        for pc.variables pvar:RangerAppParamDesc j {
          set vars pvar.name true
        }
        for pc.defined_variants fnVar:string j {
          def mVs:RangerAppMethodVariants (get pc.method_variants fnVar)
          for mVs.variants variant:RangerAppFunctionDesc k {
            set methods variant.compiledName (array_length variant.params)
          }
        }
        this.csCollectInherited(pc ctx vars methods)
      }
    }
  }

  fn writeClass:void (node:CodeNode ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def cl:RangerAppClassDesc node.clDesc
    if (null? cl) {
      return
    }

    def inheritedVars:[string:boolean]
    def inheritedMethods:[string:int]
    this.csCollectInherited((unwrap cl) ctx inheritedVars inheritedMethods)

    def wr orig_wr

    ; def wr:CodeWriter (orig_wr.getFileWriter("." (cl.name + ".cs")))
    ; def importFork:CodeWriter (wr.fork())
    
    this.import_lib("System" ctx wr)

    if (csharp_namespace_written == false) {
      csharp_namespace_written = true
      def nsName:string ""
      if (ctx.hasCompilerSetting("csnamespace")) {
        nsName = (ctx.getCompilerSetting("csnamespace"))
      } {
        if (ctx.hasCompilerFlag("apipackage")) {
          if (ctx.hasCompilerSetting("name")) {
            nsName = (ctx.getCompilerSetting("name"))
          }
        }
      }
      if ((strlen nsName) > 0) {
        ; a BLOCK namespace, not the file-scoped C# 10 form: Mono's mcs is a
        ; supported host for this repository and rejects `namespace X;`
        def nsHead:CodeWriter (wr.getTag("after_imports"))
        nsHead.out(("namespace " + nsName + " {") true)
        def nsEnd:CodeWriter (wr.getTag("file_end"))
        nsEnd.out("}" true)
        wr.indent(1)
      }
    }
    this.writeCSharpNativeEnums(ctx wr)
    this.writeCSharpTraitInterfaces(ctx wr)
    this.writeCSharpUnionInterfaces(ctx wr)
    if cl.has_doc {
      def clDocWr:RangerDocCommentWriter (new RangerDocCommentWriter)
      clDocWr.writeCsDocForClass((unwrap cl) ctx wr)
      def clDoc:RangerDocBlock (unwrap cl.docBlock)
      if clDoc.is_public {
        wr.out('public ' false)
      }
    }
    ; a generic form is declared as the template over its parameters
    wr.out(('class ' + (this.csClassRef((unwrap cl) ctx)) + ' ') false )
    def csUnions:[string] (this.unionInterfacesOf((unwrap cl) ctx))
    ; …and the behaviour-only traits this class `does` that something names as
    ; a type. Both are interfaces, and C# takes the base class first.
    def csIfaces:[string] (csTraits.basesOf((unwrap cl) ctx))
    def csBases:int 0
    if ( ( array_length cl.extends_classes ) > 0 ) { 
      wr.out(' : ' false)
      for cl.extends_classes pName:string i {
        wr.out(pName false)
        csBases = csBases + 1
;        parentClass = (ctx.findClass(pName))
      }
    }
    for csUnions uname:string ui {
      if (csBases > 0) {
        wr.out(', ' false)
      } {
        wr.out(' : ' false)
      }
      wr.out(uname false)
      csBases = csBases + 1
    }
    for csIfaces ifName:string ifi {
      if (csBases > 0) {
        wr.out(', ' false)
      } {
        wr.out(' : ' false)
      }
      wr.out(ifName false)
      csBases = csBases + 1
    }
      
    wr.out(  " {" true)
    wr.indent(1)

    wr.createTag("utilities")

    for cl.variables pvar:RangerAppParamDesc i {
      ; a redeclaration of a parent's field: one slot, like every other target
      if (has inheritedVars pvar.name) {
        continue
      }
      if pvar.has_doc {
        def fDocWr:RangerDocCommentWriter (new RangerDocCommentWriter)
        fDocWr.writeCsDocForField(pvar wr)
      }
      def fVis:RangerDocCommentWriter (new RangerDocCommentWriter)
      wr.out((fVis.memberVisibility((unwrap cl) pvar "public " "public " "internal ")) false)
      this.writeVarDef( (unwrap pvar.node) ctx wr)
    }
    if cl.has_constructor {
      def constr:RangerAppFunctionDesc (unwrap cl.constructor_fn)
      ; A C# member with no access modifier is private, so every class with a
      ; declared Constructor could only be instantiated from inside itself.
      wr.out("public " false)
      if cl.is_generic_form {
        wr.out((cl.generic_template + "(") false)
      } {
        wr.out((cl.name + "(") false)
      }
      this.writeArgsDef(constr ctx wr)
      wr.out(' ) {' true)
      wr.indent(1)
      wr.newline()
      def subCtx:RangerAppWriterContext (unwrap constr.fnCtx )
      subCtx.is_function = true
      this.WalkNode( (unwrap constr.fnBody ) subCtx wr)
      wr.newline()
      wr.indent(-1)
      wr.out("}" true)
    }
    ; The synthetic accessor of a @singleton(true) class. Call sites already
    ; write `ClassName.__singleton()` through the ordinary static path; only
    ; the definition was missing. First-call constructor arguments win, which
    ; is what es6, C++, Rust, Go, Kotlin and Python all do.
    if (cl.isSingletonClass()) {
      wr.out((("static " + cl.name) + " __singleton_instance = null;") true)
      wr.out((("public static " + cl.name) + " __singleton(") false)
      def sgHasArgs:boolean false
      if cl.has_constructor {
        def sgc@(optional):RangerAppFunctionDesc cl.constructor_fn
        if (!null? sgc) {
          this.writeArgsDef((unwrap sgc) ctx wr)
          sgHasArgs = true
        }
      }
      wr.out(") {" true)
      wr.indent(1)
      wr.out("if (__singleton_instance == null) {" true)
      wr.indent(1)
      wr.out((("__singleton_instance = new " + cl.name) + "(") false)
      if sgHasArgs {
        def sgc2@(optional):RangerAppFunctionDesc cl.constructor_fn
        if (!null? sgc2) {
          def sgc2F:RangerAppFunctionDesc (unwrap sgc2)
          def fwd:int 0
          for sgc2F.params arg:RangerAppParamDesc i {
            if (arg.nameNode.hasFlag("keyword")) {
              continue
            }
            if (fwd > 0) {
              wr.out(", " false)
            }
            fwd = fwd + 1
            wr.out(arg.compiledName false)
          }
        }
      }
      wr.out(");" true)
      wr.indent(-1)
      wr.out("}" true)
      wr.out("return __singleton_instance;" true)
      wr.indent(-1)
      wr.out("}" true)
    }
    for cl.static_methods variant:RangerAppFunctionDesc i {
      def variantName:CodeNode (unwrap variant.nameNode)
      def variantCode:SourceCode (unwrap variantName.code)
      if variant.is_doc_example {
        if ((ctx.hasCompilerFlag("keep-examples")) == false) {
          continue
        }
      }
      if ((variantName.hasFlag("main")) && (variantCode.filename != (ctx.getRootFile()))) {
        continue
      }
      if (variantName.hasFlag("main")) {
        wr.out('static void Main( string [] args ) {' true)
      } {
        if variant.has_doc {
          def sDocWr:RangerDocCommentWriter (new RangerDocCommentWriter)
          sDocWr.writeCsDocForMethod(variant ctx wr)
        }
        def sVis:RangerDocCommentWriter (new RangerDocCommentWriter)
        wr.out((sVis.memberVisibility((unwrap cl) variant "public " "public " "internal ")) false)
        wr.out('static ' false)
        this.writeTypeDef( (unwrap variant.nameNode ) ctx wr)
        wr.out(' ' false)
        ; compiledName, not name: a method called `string` or `null` in Ranger
        ; is a keyword in C#, and reserved_words already renames it -- the CALL
        ; sites were writing `EvalValue._string(...)` while the declaration
        ; still read `string(`, so nothing resolved.
        wr.out((variant.compiledName + "(") false)
        this.writeArgsDef(variant ctx wr)
        wr.out(') {' true)
      }
      wr.indent(1)
      wr.newline()
      def subCtx:RangerAppWriterContext (unwrap variant.fnCtx)
      subCtx.is_function = true
      this.WalkNode( (unwrap variant.fnBody) subCtx wr)
      wr.newline()
      wr.indent(-1)
      wr.out("}" true)
    }
    for cl.defined_variants fnVar:string i {
      def mVs:RangerAppMethodVariants (get cl.method_variants fnVar)
      for mVs.variants variant:RangerAppFunctionDesc i {
        if variant.is_doc_example {
          if ((ctx.hasCompilerFlag("keep-examples")) == false) {
            continue
          }
        }
        if variant.has_doc {
          def mDocWr:RangerDocCommentWriter (new RangerDocCommentWriter)
          mDocWr.writeCsDocForMethod(variant ctx wr)
        }
        def mVis:RangerDocCommentWriter (new RangerDocCommentWriter)
        wr.out((mVis.memberVisibility((unwrap cl) variant "public " "public " "internal ")) false)
        ; `override` only when the parent really declares the same method --
        ; matched on the compiled name AND the argument count, because a
        ; same-named method with a different signature is an overload and
        ; `override` would not compile against it.
        def parentArgc@(optional):int (get inheritedMethods variant.compiledName)
        if (!null? parentArgc) {
          if ((unwrap parentArgc) == (array_length variant.params)) {
            wr.out('override ' false)
          }
        } {
          if cl.is_extended_by_children {
            wr.out('virtual ' false)
          }
        }
        this.writeTypeDef( (unwrap variant.nameNode) ctx wr)
        wr.out(' ' false)
        ; compiledName, not name: a method called `string` or `null` in Ranger
        ; is a keyword in C#, and reserved_words already renames it -- the CALL
        ; sites were writing `EvalValue._string(...)` while the declaration
        ; still read `string(`, so nothing resolved.
        wr.out((variant.compiledName + "(") false)
        this.writeArgsDef(variant ctx wr)
        wr.out(') {' true)
        wr.indent(1)
        def subCtx:RangerAppWriterContext (unwrap variant.fnCtx)
        subCtx.is_function = true
        this.WalkNode((unwrap variant.fnBody) subCtx wr)
        wr.indent(-1)
        wr.out("}" true)
      }
    }
    wr.indent(-1)
    wr.out("}" true)
  }

  ; --- the generated `for` (PLAN_CPP_IDIOMS C4, the C# half) --------------
  ; `foreach (var v in xs)` is the C# loop. This writer emitted the C-style
  ; index one, which is what you write when you need the index and nothing
  ; else. The two conditions are the ones every target asks (ForLoopShape):
  ; `foreach` takes one enumerator for the whole loop, so a body that adds to
  ; the list throws InvalidOperationException where the index form saw the
  ; growth.
  fn csWriteOperand:void (arg:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ctx.setInExpr()
    this.WalkNode(arg ctx wr)
    ctx.unsetInExpr()
  }

  fn csWriteForLoop:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if ((array_length node.children) < 5) {
      return
    }
    def coll:CodeNode (node.getSecond())
    def item:CodeNode (itemAt node.children 2)
    def idx:CodeNode (itemAt node.children 3)
    def body:CodeNode (itemAt node.children 4)

    if (csLoops.canIterate(node)) {
      wr.out("foreach ( " false)
      if item.hasParamDesc {
        this.writeTypeDef((unwrap item.paramDesc.nameNode) ctx wr)
      } {
        this.writeTypeDef(item ctx wr)
      }
      wr.out(" " false)
      this.csWriteOperand(item ctx wr)
      wr.out(" in " false)
      this.csWriteOperand(coll ctx wr)
      wr.out(") {" true)
      wr.indent(1)
      def rCtx:RangerAppWriterContext (ctx.fork())
      rCtx.restartExpressionLevel()
      this.WalkNode(body rCtx wr)
      wr.indent(-1)
      wr.out("}" true)
      return
    }

    ; the index form, what the template wrote before
    wr.out("for ( int " false)
    this.csWriteOperand(idx ctx wr)
    wr.out(" = 0; " false)
    this.csWriteOperand(idx ctx wr)
    wr.out(" < " false)
    this.csWriteOperand(coll ctx wr)
    wr.out(".Count; " false)
    this.csWriteOperand(idx ctx wr)
    wr.out("++) {" true)
    wr.indent(1)
    if item.hasParamDesc {
      this.writeTypeDef((unwrap item.paramDesc.nameNode) ctx wr)
    } {
      this.writeTypeDef(item ctx wr)
    }
    wr.out(" " false)
    this.csWriteOperand(item ctx wr)
    wr.out(" = " false)
    this.csWriteOperand(coll ctx wr)
    wr.out("[" false)
    this.csWriteOperand(idx ctx wr)
    wr.out("];" true)
    def sCtx:RangerAppWriterContext (ctx.fork())
    sCtx.restartExpressionLevel()
    this.WalkNode(body sCtx wr)
    wr.indent(-1)
    wr.out("}" true)
  }

  ; Nothing else routes a template through this writer, so the only command
  ; that arrives is the one Lang.rgr declares `(custom _)` for it.
  fn CustomOperator:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def fc:CodeNode (node.getFirst())
    def cmd:string fc.vref
    if (cmd == "for") {
      this.csWriteForLoop(node ctx wr)
    }
  }

}

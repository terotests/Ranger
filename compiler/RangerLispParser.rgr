      ; the frame kept looping and parsed the REST of the file, one dead frame
      ; per statement: `end_expression` pops an implicit statement node without
      ; breaking out, and only a literal `)` or `}` ever ended a frame. Measured
      ; on EvHandle.rgr before the fix: call depth 245 with just 12 nodes
      ; actually open, and 2117 on ComponentEngine.rgr, which put the engine at
      ; the edge of V8's default stack and made its compilation fail about two
      ; runs in five.
      if (((array_length parents)) < entry_depth) {
        return
      }

      if(!null? curr_node) {
        ; called from the XML parser...
        if(curr_node.value_type == RangerNodeType.XMLAttr) {
          return
        }
        if(curr_node.value_type == RangerNodeType.XMLNode) {
          return
        }
      }

      if (had_error) {
        break
      }
      last_i = i
      def is_block_parent:boolean false
      if (had_lf) {
        had_lf = false
        this.end_expression(true)
        break
      }
      if ((!null? curr_node)) {
        if ((!null? curr_node.parent)) {
          def nodeParent@(optional):CodeNode curr_node.parent
          if (nodeParent.is_block_node) {
            is_block_parent = true
          }
        }
      }
      if ((this.skip_space(s is_block_parent))) {
        break
      }
      had_lf = false
      c = (charAt s i)
      if (i < len) {
        c = (charAt s i)

        if ( (ccode "<") == c) {
          if( (i + 1) < len ) {
            def next_c (charAt s (i + 1))
            if ( (ccode "A") < next_c  && (ccode "z") > next_c)  {
              ; print "XML start found"
              def spos i
;              i = i + 1
              this.parseXML(s)
              ; print "XML parsed at index " + i + " the leng was " + len 
              ; print "XML was " + (substring s spos i)
              i = i + 1
              continue
            }
          }
          if( i > 0 ) {
            def prev_c (charAt s (i - 1))
            if ( (ccode ">") == prev_c)  {
              ; print "XML END found"
            }
          }
        } 


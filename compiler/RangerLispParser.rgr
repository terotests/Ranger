              ; broken. `strlen`, `charAt` and `substring` index the same
              ; unit as each other on any one target, and every character
              ; this loop looks at (`\`, `"`, `n`, ...) is ASCII, so
              ; reading the string directly is right everywhere.
              ; docs/plans/PLAN_STRING_INDEXING.md 3.3.
              def subs:string (substring s sp ep)
              def str_length:int (strlen subs)
              def ii:int 0
              while (ii < str_length) {def cc:int (charAt subs ii)
                if (cc == 92 ) {
                  def next_ch:int (charAt subs (ii + 1))
                  switch (next_ch ) { 
                    case 34 { 
                      encoded_str = encoded_str + ((strfromcode 34))
                    }
                    case 92 { 
                      encoded_str = encoded_str + ((strfromcode 92))
                    }
                    case 47 { 
                      encoded_str = encoded_str + ((strfromcode 47))
                    }
                    case 98 { 
                      encoded_str = encoded_str + ((strfromcode 8))
                    }
                    case 102 { 
                      encoded_str = encoded_str + ((strfromcode 12))
                    }
                    case 110 { 
                      encoded_str = encoded_str + ((strfromcode 10))
                    }
                    case 114 { 
                      encoded_str = encoded_str + ((strfromcode 13))
                    }
                    case 116 { 
                      encoded_str = encoded_str + ((strfromcode 9))
                    }
                    case 117 { 
                      ii = ii + 4
                    }
                    default { 
                    }
                  }
                  ii = ii + 2
                } {
                  encoded_str = encoded_str + ((substring subs ii (1 + ii)))
                  ii = ii + 1
                }
              }
            } {
              ; print "string without encoding"
            }

            def new_str_node:CodeNode (new CodeNode(( unwrap code) sp ep))
            new_str_node.parsed_type = RangerNodeType.String
            new_str_node.value_type = RangerNodeType.String
            if (must_encode ) {
              new_str_node.string_value = encoded_str
            } {
              new_str_node.string_value = (substring s sp ep)
            }
            this.insert_node(new_str_node)
            i = 1 + i
            continue 
          }
        }
        ; Check for 'true' keyword - but only if followed by a word boundary (not part of longer identifier)
        ; The lookahead is read BEFORE the keyword test, so it needs its own
        ; bounds check: the chained `charAt` calls below are safe because each
        ; one is guarded by the previous character matching, but this one is
        ; not. `charbuffer` is a raw pointer on the C++ target, and reading past
        ; the terminator is an out-of-bounds read (AddressSanitizer:

        ; next sibling (the property or method below). Otherwise it trails
        ; the expression currently being parsed.
        if (c == 59) {
          sp = i + 1
          while ((i < len) && (((charAt s i)) > 31)) {
            i = 1 + i
          }
          if (i >= len) {
            break
          }
          new_node = (new CodeNode(( unwrap code) sp i))
          def commentNode:CodeNode (unwrap new_node)
          commentNode.parsed_type = RangerNodeType.Comment
          commentNode.value_type = RangerNodeType.Comment
          commentNode.string_value = (substring s sp i)
          if (!null? curr_node) {
            def current:CodeNode (unwrap curr_node)
            if (current.is_block_node) {
              push pending_comments commentNode
            } {
              push current.comments commentNode
            }
          }
          continue 
        }

        if (i < (len - 1)) {
          fc = (charAt s (i + 1))


          if ((c == 40) || (c == ((ccode "{"))) ) {
            paren_cnt = paren_cnt + 1
            if ((null? curr_node) ) {
              def newRoot:CodeNode (new CodeNode(( unwrap code) i i))
              rootNode = newRoot
              curr_node = newRoot
              newRoot.expression = true
              push parents newRoot
            } {
              def new_qnode@(lives):CodeNode (new CodeNode(( unwrap code) i i))
              new_qnode.expression = true
              did_fold_call = false
              if ((c == 40) && (false == disable_ops_set)) {
                did_fold_call = (this.insertCallOrNode(new_qnode))
              } {
                this.insert_node(new_qnode)
              }
              if (did_fold_call) {
                folded_call = last_call_group
              }
              push parents new_qnode
              curr_node = new_qnode
            }
            def current:CodeNode (unwrap curr_node)
            if (c == ((ccode "{"))) {
              current.is_block_node = true
            }
            def closedNode@(optional weak):CodeNode current
            def closedWasCall:boolean did_fold_call
            i = 1 + i
            this.parseBuf(s disable_ops_set)
            if (did_fold_call) {

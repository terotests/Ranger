          ; be stale here (the guard condition above deliberately re-reads
          ; `charAt s i` alongside it), and a leftover dot from an earlier token
          ; would reject innocent lines.
          def current:CodeNode (unwrap curr_node)
          if ((current.is_block_node == true) && (((charAt s i)) == ((ccode ".")))) {

              this.end_expression(false)
            }
            current.ep = (i + 1)
          }
          i = 1 + i
          paren_cnt = paren_cnt - 1
          if (paren_cnt < 0) {
            break
          }
          removeLast parents
          if (((array_length parents)) > 0 ) {
            curr_node = (itemAt parents (((array_length parents)) - 1))
          } {
            curr_node = rootNode
          }
          break
        }
        if (last_i == i) {
          i = 1 + i
        }
      }
    }
  }
}

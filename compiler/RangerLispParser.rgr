        ; and the `(i + 4) >= len` arm of the test already covers the case.
        def nextCharT:char 0
        if ((i + 4) < len) {
          nextCharT = (charAt s (i + 4))
        }
        if ((fc == ((ccode "t"))) && (((charAt s (i + 1))) == ((ccode "r"))) && (((charAt s (i + 2))) == ((ccode "u"))) && (((charAt s (i + 3))) == ((ccode "e"))) && ((nextCharT <= 32) || (nextCharT == 40) || (nextCharT == 41) || (nextCharT == 58) || (nextCharT == ((ccode "}"))) || ((i + 4) >= len))) {
          def newBoolNode:CodeNode (new CodeNode(( unwrap code) sp sp + 4))
          newBoolNode.value_type = RangerNodeType.Boolean
          newBoolNode.parsed_type = RangerNodeType.Boolean
          newBoolNode.boolean_value = true
          this.insert_node(newBoolNode)
          i = i + 4
          continue 
        }
        ; Check for 'false' keyword - see the bounds note on nextCharT above.
        def nextCharF:char 0
        if ((i + 5) < len) {
          nextCharF = (charAt s (i + 5))
        }
        if ((fc == ((ccode "f"))) && (((charAt s (i + 1))) == ((ccode "a"))) && (((charAt s (i + 2))) == ((ccode "l"))) && (((charAt s (i + 3))) == ((ccode "s"))) && (((charAt s (i + 4))) == ((ccode "e"))) && ((nextCharF <= 32) || (nextCharF == 40) || (nextCharF == 41) || (nextCharF == 58) || (nextCharF == ((ccode "}"))) || ((i + 5) >= len))) {
          def newBoolNodeF:CodeNode (new CodeNode(( unwrap code) sp sp + 5))
          newBoolNodeF.value_type = RangerNodeType.Boolean
          newBoolNodeF.parsed_type = RangerNodeType.Boolean
          newBoolNodeF.boolean_value = false
          this.insert_node(newBoolNodeF)
          i = i + 5
          continue 
        }

        if (fc == ((ccode "@"))) {
          i = i + 1
          sp = i
          ep = i
          c = (charAt s i)
          while ((i < len) && (((charAt s i)) > 32) && (c != 40) && (c != 41) && (c != ((ccode "}"))  )) {
            i = 1 + i
            c = (charAt s i)
          }
          ep = i
          if ((i < len) && (ep > sp)) {
            def a_node2@(lives):CodeNode (new CodeNode(( unwrap code) sp ep))
            def a_name:string (substring s sp ep)
            if( a_name == "noinfix") {
              disable_ops_set = true
            }
            a_node2.expression = true
            curr_node = a_node2
            push parents a_node2
            i = i + 1
            paren_cnt = paren_cnt + 1
            this.parseBuf(s disable_ops_set)
            def use_first:boolean false
            if (1 == ((array_length a_node2.children))) {
              def ch1:CodeNode (itemAt a_node2.children 0)
              use_first = (ch1.isPrimitive())
            }
            if (!null? curr_node) {
              def current:CodeNode (unwrap curr_node)
              if (use_first ) {
                def theNode:CodeNode (array_extract a_node2.children 0)
                set current.props a_name theNode
              } {
                set current.props a_name a_node2
              }
              push current.prop_keys a_name
            }
            continue 
          }
        }
        def ns_list@(temp):[string]
        def last_ns:int i
        def ns_cnt:int 1
        def vref_had_type_ann:boolean false
        def vref_ann_node@(optional temp):CodeNode
        def vref_end:int i
        if ((i < len) && (((charAt s i)) > 32) && (c != 58) && (c != 40) && (c != 41) && (c != ((ccode "}")) )  ) {
          ; A statement can not BEGIN with a chained call on a parenthesised
          ; receiver -- "(expr).method()" at statement level. The branch below
          ; would open a fresh statement at ".method", and its recursive parse()
          ; then absorbs every remaining statement of the block as extra
          ; children which codegen silently discards: the rest of the method
          ; body disappears with no diagnostic at all (ISSUES.md #65).
          ; Chained receivers INSIDE an expression -- "((a.b()).c())" -- are
          ; fine and stay fine: curr_node is an expression there, not a block
          ; node, so this guard cannot reject them.

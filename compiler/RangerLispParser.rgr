operator type:void all {

  fn is_not_limiter:boolean (c:char) {
    return ( (c > 32 ) && 
             (c != (ccode ";")) && 
             (c != (ccode ")")) && 
             (c != (ccode "(")) && 
             (c != (ccode "}")) && 
             (c != (ccode ",")) )
  }
}

class RangerLispParser { 

  def code@(optional):SourceCode
  ; The normalized source, kept as a field on purpose. `charbuffer` is a
  ; BORROWED `const char*` on the C++ target, so `buff` only stays valid while
  ; the string it was taken from is alive. Taken from a local in the
  ; constructor, every read in parse() was a use-after-free — the C++ build of
  ; the compiler segfaulted before it read the first token.
  def source_text:string ""
  def buff@(optional):charbuffer
  def len:int 0
  def i:int 0
  def last_line_start 0
  def current_line_index 0
  def parents@(weak):[CodeNode]
  def next@(optional):CodeNode
  def paren_cnt:int 0
  def get_op_pred:int 0
  def rootNode@(optional):CodeNode
  def curr_node@(optional weak):CodeNode
  def had_error:boolean false
  def disableOperators false
  ; ISSUES.md #76: numbers the temporaries that `recv.call(a).field = v` is
  ; desugared into. Per parser instance, so per FILE; the temporaries are
  ; block locals, so two files never see each other's.
  def recv_tmp_count:int 0
  ; The call group most recently folded by insertCallOrNode, so parseBuf can
  ; close its source range once the argument list has been parsed.
  def last_call_group@(optional weak):CodeNode
  ; Leading `;` comments in a block, held until the next statement. A comment
  ; immediately above a `def` / `fn` is documentation of that member, not of
  ; the class body. Trailing comments on a non-block stay on curr_node.
  ; Children of the tree are unchanged — only `.comments` moves.
  def pending_comments:[CodeNode]

  ; Accept LF, CRLF, and lone CR — normalize to LF before tokenization.
  ; Use split/join (linear) instead of repeated substring rebuilds (quadratic on
  ; large CRLF sources such as Lang.rgr / lib/*.rgr).
  static fn normalizeLineEndings:string (src:string) {
    if ((indexOf src "\r") < 0) {
      return src
    }
    def s:string (join (strsplit src "\r\n") "\n")
    return (join (strsplit s "\r") "\n")
  }
  
  Constructor ( code_module:SourceCode ) {
    source_text = (RangerLispParser.normalizeLineEndings(code_module.code))
    buff = (to_charbuffer source_text)
    code = code_module
    len = (length (( unwrap buff)))
    rootNode = (new CodeNode(( unwrap code) 0 0))
    def root:CodeNode (unwrap rootNode)
    ; V8 gives a field the representation of the first value stored in it, and
    ; the CodeNode constructor stores the integer 0 in double_value and in
    ; int_value, so both begin as small integers. The first fractional literal
    ; in a program, and the first integer past 2^31, then changed the
    ; representation of that field on every CodeNode already made, and each of
    ; those nodes was rewritten on its next access: 2.4 s of the RtHost
    ; compile, paid by whichever pass first walked the tree. Storing such
    ; values once, here, moves the change to a point where one node exists.
    ; JavaScript only: the sum is past a 32-bit int on the other targets.
    if_javascript {
      root.double_value = 0.5
      root.int_value = (1073741824 + 1073741824)
      root.double_value = 0.0
      root.int_value = 0
    }
    root.is_block_node = true
    root.expression = true
    curr_node = root
    push parents ( unwrap curr_node)
    paren_cnt = 1
  }
  
  fn joo:void ( cm@(lives):SourceCode) {
  }
    
  fn parse_raw_annotation:CodeNode () {
    def sp:int i
    def ep:int i
    i = i + 1
    sp = i
    ep = i
    if (i < len ) {
      def a_node2@(returnvalue):CodeNode (new CodeNode(( unwrap code) sp ep))
      a_node2.expression = true
      a_node2.row = current_line_index
      curr_node = a_node2
      push parents a_node2
      i = i + 1
      paren_cnt = paren_cnt + 1
      this.parse(false)
      return a_node2
    } {
    }
    return (new CodeNode(( unwrap code) sp ep))
  }
  
  fn skip_space:boolean ( s:charbuffer is_block_parent@(lives):boolean) {
    ; The buffer arrives as a parameter rather than being read out of the
    ; field. `def s:charbuffer (unwrap buff)` copies the whole source on a
    ; value-model target: C++ binds `const char*`, but Rust cloned all 384KB
    ; of Lang.rgr on every call -- and these run once per character, inside a
    ; parser that also recurses per nested expression. callgrind put 98.8% of
    ; the program's instructions in memcpy because of it.
    def did_break:boolean false
    if (i >= len) {
      return true
    }
    def c:char (charAt s i)
    def bb:boolean c == ((ccode "."))
    while ((i < len) && (c <= 32)) {
      if( c < 8 ) {
        i = len
        return true
;        throw "Invalid string"
      }
      if (is_block_parent && ((c == 10) || (c == 13))) {
        this.end_expression(true)
        current_line_index = current_line_index + 1
        did_break = true
        break
      }
      ;         current_line_index = current_line_index + 1
      def had_break false
      while( (i < len ) &&  c == 10 || c == 13) {
        had_break = true
        i = i + 1
        if (i >= len) {
          return true
        }
        c = (charAt s i)
        if( c == 10 || c == 13) {
        }
      }

      if had_break {
        current_line_index = current_line_index + 1
      } {
        i = 1 + i
        if (i >= len) {
          return true
        }
        c = (charAt s i)
      }

    }
    return did_break
  }
  
  ; `(expr).name` -- a member access on a parenthesised expression. The
  ; `.name` token written right against the closing paren is attached to the
  ; expression node as its flagged last child; the flow parser binds the
  ; expression to a temporary and reads `<tmp>.name` instead, so no writer
  ; has to put a member access on an expression result.
  ;
  ; Only an INFIX context is rewritten -- `(expr).name == x`, `x + (expr).name`
  ; -- because that is where the infix rewriter took the `.name` token as an
  ; operand on its own and lost the expression. Every other shape
  ; (`def n (expr).name`, `((expr).name)`, `(expr).name = v`, a call
  ; `(expr).m(a)`) already reaches the writers through the existing chain
  ; machinery and keeps its code generation. A call inside an infix
  ; expression -- `(expr).m(a) + 1` -- is not rewritten: bind the receiver.
  fn attachParenMember:void ( closed@(lives):CodeNode  listNode@(lives):CodeNode) {
    def s:charbuffer ( unwrap buff)
    if (closed.is_block_node) {
      return
    }
    if ((i + 1) >= len) {
      return
    }
    if (((charAt s i)) != ((ccode "."))) {
      return
    }
    def c1:char (charAt s (i + 1))
    def isIdStart:boolean false
    if ((c1 >= 65) && (c1 <= 90)) {
      isIdStart = true
    }
    if ((c1 >= 97) && (c1 <= 122)) {
      isIdStart = true
    }
    if ((c1 == ((ccode "_"))) || (c1 == ((ccode "$")))) {
      isIdStart = true
    }
    if (false == isIdStart) {
      return
    }
    def msp:int i
    i = i + 1
    while (i < len) {
      def mc:char (charAt s i)
      if ((mc <= 32) || (mc == 40) || (mc == 41) || (mc == ((ccode "}"))) || (mc == ((ccode ","))) || (mc == 58)) {
        break
      }
      if ((mc == ((ccode "="))) || (mc == ((ccode "<"))) || (mc == ((ccode ">"))) || (mc == ((ccode "!"))) || (mc == ((ccode "&"))) || (mc == ((ccode "|"))) || (mc == ((ccode "+"))) || (mc == ((ccode "-"))) || (mc == ((ccode "*"))) || (mc == ((ccode "/")))) {
        break
      }
      i = i + 1
    }
    ; A METHOD call -- `(expr).m(args)` -- keeps the shape the method-chain
    ; machinery already handles: the `.m` stays a sibling of the expression.
    ; Only a property read is attached here.
    if ((i < len) && (((charAt s i)) == 40)) {
      i = msp
      return
    }
    def inInfix:boolean listNode.infix_operator
    if (false == inInfix) {
      ; the operand on the LEFT of an operator: peek past the spaces
      def pk:int i
      while ((pk < len) && (((charAt s pk)) <= 32) && (((charAt s pk)) != 10) && (((charAt s pk)) != 13)) {
        pk = pk + 1
      }
      if (pk < len) {
        def oc:char (charAt s pk)
        def oc2:char 0
        if ((pk + 1) < len) {
          oc2 = (charAt s (pk + 1))
        }
        if ((oc == ((ccode "+"))) || (oc == ((ccode "-"))) || (oc == ((ccode "*"))) || (oc == ((ccode "/"))) || (oc == ((ccode "<"))) || (oc == ((ccode ">")))) {
          inInfix = true
        }
        if ((oc == ((ccode "&"))) && (oc2 == ((ccode "&")))) {
          inInfix = true
        }
        if ((oc == ((ccode "|"))) && (oc2 == ((ccode "|")))) {
          inInfix = true
        }
        if ((oc == ((ccode "!"))) && (oc2 == ((ccode "=")))) {
          inInfix = true
        }
        if ((oc == ((ccode "="))) && (oc2 == ((ccode "=")))) {
          inInfix = true
        }
      }
    }
    if (false == inInfix) {
      i = msp
      return
    }
    def memberNode:CodeNode (new CodeNode(( unwrap code) msp i))
    memberNode.vref = (substring s msp i)
    memberNode.value_type = RangerNodeType.VRef
    memberNode.is_paren_member = true
    memberNode.parent = closed
    push closed.children memberNode
  }

  fn end_expression:boolean (consumeCurrent:boolean) {
    if (consumeCurrent) {
      i = 1 + i
      if (i >= len) {
        return false
      }
    }
    paren_cnt = paren_cnt - 1
    if (paren_cnt < 0) {
      print "Parser error ) mismatch"
    }
    removeLast parents
    if ((!null? curr_node)) {
      def current:CodeNode (unwrap curr_node)
      current.ep = i
      current.infix_operator = false
    }
    if (((array_length parents)) > 0 ) {
      curr_node = (itemAt parents (((array_length parents)) - 1))
    } {
      curr_node = rootNode
    }
    def active:CodeNode (unwrap curr_node)
    active.infix_operator = false
    return true
  }
  
  fn getOperator:int ( s:charbuffer disabled:boolean ) {
    if disabled {
      return 0
    }
    if ((i + 2) >= len) {
      return 0
    }
    def c:char (charAt s i)
    def c2:char (charAt s (i + 1))
    switch ( c ) { 
      case (ccode "*") { 
        i = i + 1
        return 14
      }
      case (ccode "/") { 
        i = i + 1
        return 14
      }
      case (ccode "%") { 
        i = i + 1
        return 14
      }
      case (ccode "+") { 
        i = i + 1
        return 13
      }
      case (ccode "-") { 
        i = i + 1
        return 13
      }
      case (ccode "<") { 
        if (c2 == ((ccode "="))) {
          i = i + 2
          return 11
        }
        i = i + 1
        return 11
      }
      case (ccode ">") { 
        if (c2 == ((ccode "="))) {
          i = i + 2
          return 11
        }
        i = i + 1
        return 11
      }
      case (ccode "!") { 
        if (c2 == ((ccode "="))) {
          i = i + 2
          return 10
        }
        return 0
      }
      case (ccode "=") { 
        if (c2 == ((ccode "="))) {
          i = i + 2
          return 10
        }
        i = i + 1
        return 3
      }
      case (ccode "&") { 
        if (c2 == ((ccode "&"))) {
          i = i + 2
          return 6
        }
        return 0
      }
      case (ccode "|") { 
        if (c2 == ((ccode "|"))) {
          i = i + 2
          return 5
        }
        return 0
      }
      default { 
      }
    }
    return 0
  }
  
  fn isOperator:int ( s:charbuffer disabled:boolean ) {
    if disabled {
      return 0
    }
    if ((i - 2) > len) {
      return 0
    }
    def c:char (charAt s i)
    def c2:char (charAt s (i + 1))
    switch (c ) { 
      case (ccode "*") { 
        return 1
      }
      case (ccode "/") { 
        return 14
      }
      case (ccode "+") { 
        return 13
      }
      case (ccode "%") { 
        return 14
      }
      case (ccode "-") { 
        return 13
      }
      case (ccode "<") { 
        if (c2 == ((ccode "="))) {
          return 11
        }
        return 11
      }
      case (ccode ">") { 
        if (c2 == ((ccode "="))) {
          return 11
        }
        return 11
      }
      case (ccode "!") { 
        if (c2 == ((ccode "="))) {
          return 10
        }
        return 0
      }
      case (ccode "=") { 
        if (c2 == ((ccode "="))) {
          return 10
        }
        return 3
      }
      case (ccode "&") { 
        if (c2 == ((ccode "&"))) {
          return 6
        }
        return 0
      }
      case (ccode "|") { 
        if (c2 == ((ccode "|"))) {
          return 5
        }
        return 0
      }
      default { 
      }
    }
    return 0
  }
  
  fn getOperatorPred:int ( str@(lives):string disabled:boolean) {
    if(disabled) {
      return 0
    }
    switch (str ) { 
      case "<" { 
        return 11
      }
      case ">" { 
        return 11
      }
      case "<=" { 
        return 11
      }
      case ">=" { 
        return 11
      }
      case "==" { 
        return 10
      }
      case "!=" { 
        return 10
      }
      case "=" { 
        return 3
      }
      case "&&" { 
        return 6
      }
      case "||" { 
        return 5
      }
      case "+" { 
        return 13
      }
      case "-" { 
        return 13
      }
      case "%" { 
        return 14
      }
      case "*" { 
        return 14
      }
      case "/" { 
        return 14
      }
      default { 
      }
    }
    return 0
  }

  fn isComparisonOpPred:boolean (pred:int) {
    if (pred == 10) {
      return true
    }
    if (pred == 11) {
      return true
    }
    return false
  }

  ; Infix operators whose left operand may be a call written without its own
  ; parentheses. Everything but `=` (pred 3): an assignment's left side is a
  ; target, never a call, and folding there would change what `a.b().c = v`
  ; means (that shape is desugared further down instead).
  fn isFoldableInfixPred:boolean (pred:int) {
    if (pred < 1) {
      return false
    }
    if (pred == 3) {
      return false
    }
    return true
  }

  fn isDotVRef:boolean (n:CodeNode) {
    if (n.parsed_type != RangerNodeType.VRef) {
      return false
    }
    if ((indexOf n.vref ".") >= 0) {
      return true
    }
    if ((array_length n.ns) >= 2) {
      return true
    }
    return false
  }

  fn isDotCallPairOnNode:boolean (node:CodeNode) {
    if ((array_length node.children) != 2) {
      return false
    }
    def ch0:CodeNode (itemAt node.children 0)
    return (this.isDotVRef(ch0))
  }

  ; A whole method chain standing alone in an expression:
  ; `a.b(x).c(y)` parses flat, as name/arglist pairs. `isDotCallPairOnNode`
  ; only recognises the one-call case, so a chain used as the left operand of
  ; an infix operator still came apart. Every pair after the first leads with
  ; a dot, and every arglist has to TOUCH the name in front of it, which is
  ; what separates a chain from an operand followed by a group.
  fn isCallChainOnNode:boolean (node:CodeNode) {
    def cnt:int (array_length node.children)
    if (cnt < 2) {
      return false
    }
    def idx:int 0
    while (idx < cnt) {
      if ((idx + 1) >= cnt) {
        return false
      }
      def nameNode:CodeNode (itemAt node.children idx)
      def argNode:CodeNode (itemAt node.children (idx + 1))
      if (nameNode.parsed_type != RangerNodeType.VRef) {
        return false
      }
      if ((strlen nameNode.vref) < 2) {
        return false
      }
      if (idx == 0) {
        if ((this.isDotVRef(nameNode)) == false) {
          return false
        }
        if ((charAt nameNode.vref 0) == ((ccode "."))) {
          return false
        }
      } {
        if ((charAt nameNode.vref 0) != ((ccode "."))) {
          return false
        }
      }
      if (nameNode.has_vref_annotation) {
        return false
      }
      if ((array_length nameNode.children) > 0) {
        return false
      }
      if (false == argNode.expression) {
        return false
      }
      if (argNode.is_block_node) {
        return false
      }
      if (argNode.parsed_type != RangerNodeType.NoType) {
        return false
      }
      if (argNode.sp != nameNode.ep) {
        return false
      }
      idx = idx + 2
    }
    return true
  }

  fn foldCallChainToGroup:void (node:CodeNode) {
    if ((this.isCallChainOnNode(node)) == false) {
      return
    }
    def cnt:int (array_length node.children)
    def firstCh:CodeNode (itemAt node.children 0)
    def lastCh:CodeNode (itemAt node.children (cnt - 1))
    def callGroup@(temp lives):CodeNode (new CodeNode(( unwrap code) firstCh.sp lastCh.ep))
    callGroup.expression = true
    callGroup.parent = node
    def left:int cnt
    while (left > 0) {
      def moved:CodeNode (array_extract node.children 0)
      moved.parent = callGroup
      push callGroup.children moved
      left = left - 1
    }
    push node.children callGroup
  }

  fn foldDotCallPairToGroup:void (node:CodeNode) {
    if ((this.isDotCallPairOnNode(node)) == false) {
      return
    }
    def ch0:CodeNode (array_extract node.children 0)
    def ch1:CodeNode (array_extract node.children 0)
    def callGroup@(temp lives):CodeNode (new CodeNode(( unwrap code) ch0.sp ch1.ep))
    callGroup.expression = true
    ch0.parent = callGroup
    ch1.parent = callGroup
    push callGroup.children ch0
    push callGroup.children ch1
    push node.children callGroup
  }

  ; A name that is the RECEIVER of a call written without its own pair of
  ; parentheses: dotted, and touching the `(` with no space in between.
  ; `recv.method(...)` means the same call as `(recv.method(...))`, so the
  ; parser folds the two into one node instead of leaving them as siblings —
  ; the shape `return this.helper()` used to fail analysis with (ISSUES.md
  ; #63), and the same shape is what made arithmetic on a call result need a
  ; temporary variable.
  ;
  ; The three exclusions are what keep everything else parsing as before:
  ; a name with a space before the `(` is an operand followed by a group, not
  ; a call (`print (x)`); an undotted name is a form such as
  ; `(new CodeNode(...))` or `fn name:int ()`; and a name that BEGINS with a
  ; dot is the `.tail()` of a chain, which the chain fold below already owns.
  fn isPlainDotCallee:boolean (n:CodeNode paren_pos:int) {
    if (n.parsed_type != RangerNodeType.VRef) {
      return false
    }
    if (n.ep != paren_pos) {
      return false
    }
    if ((strlen n.type_name) > 0) {
      return false
    }
    if (n.has_vref_annotation) {
      return false
    }
    if (n.has_type_annotation) {
      return false
    }
    if ((array_length n.children) > 0) {
      return false
    }
    if ((strlen n.vref) < 2) {
      return false
    }
    if ((charAt n.vref 0) == ((ccode "."))) {
      return false
    }
    return (this.isDotVRef(n))
  }

  ; The `.method` of a chain whose receiver has already been folded into a
  ; call group — `return a.b().c()` folds `a.b()` first, and this is what
  ; carries the rest of the chain into that same group instead of leaving it
  ; as loose siblings.
  fn isChainTailCallee:boolean (n:CodeNode paren_pos:int) {
    if (n.parsed_type != RangerNodeType.VRef) {
      return false
    }
    if (n.ep != paren_pos) {
      return false
    }
    if ((strlen n.vref) < 2) {
      return false
    }
    if ((charAt n.vref 0) != ((ccode "."))) {
      return false
    }
    if (n.has_vref_annotation) {
      return false
    }
    if (n.has_type_annotation) {
      return false
    }
    if ((array_length n.children) > 0) {
      return false
    }
    return true
  }

  ; Attaches an opening `(` either as the argument list of the name in front
  ; of it (a folded call) or, as before, as a plain sibling node. Returns true
  ; when it folded; the new group is left in `last_call_group`.
  fn insertCallOrNode:boolean ( p_node@(strong lives):CodeNode) {
    def push_target@(optional weak lives):CodeNode curr_node
    def current:CodeNode (unwrap curr_node)
    if (current.infix_operator) {
      push_target = current.infix_node
      if (push_target.to_the_right) {
        push_target = push_target.right_node
        p_node.parent = push_target
      }
    }
    def target:CodeNode (unwrap push_target)
    def cnt:int (array_length target.children)
    def inside_args:boolean target.is_call_args
    def may_fold:boolean (cnt > 1)
    if (inside_args && (cnt == 1)) {
      may_fold = true
    }
    ; `new Some.Name(args)` is a construction, not a call on a receiver: the
    ; dotted name is the TYPE and the parentheses are the constructor's
    ; arguments, which the `new` form already reads as its own children.
    ; Folding them would leave `new` without its type. Found by compiling the
    ; repository's own fixtures with the fold in place.
    if (cnt > 1) {
      def beforeCallee:CodeNode (itemAt push_target.children (cnt - 2))
      if (beforeCallee.parsed_type == RangerNodeType.VRef) {
        if (beforeCallee.vref == "new") {
          may_fold = false
        }
      }
    }
    if (may_fold) {
      def callee:CodeNode (itemAt target.children (cnt - 1))
      if ((cnt > 2) && (this.isChainTailCallee(callee i))) {
        def prevGroup:CodeNode (itemAt target.children (cnt - 2))
        def continues:boolean (this.isCallChainOnNode(prevGroup))
        if (continues && (callee.sp == prevGroup.ep)) {
          def movedTail:CodeNode (array_extract target.children (cnt - 1))
          movedTail.parent = prevGroup
          p_node.parent = prevGroup
          p_node.is_call_args = true
          push prevGroup.children movedTail
          push prevGroup.children p_node
          last_call_group = prevGroup
          return true
        }
      }
      if (this.isPlainDotCallee(callee i)) {
        def callGroup@(temp lives):CodeNode (new CodeNode(( unwrap code) callee.sp i))
        callGroup.expression = true
        callGroup.parent = target
        def moved:CodeNode (array_extract target.children (cnt - 1))
        moved.parent = callGroup
        p_node.parent = callGroup
        push callGroup.children moved
        push callGroup.children p_node
        p_node.is_call_args = true
        last_call_group = callGroup
        push target.children callGroup
        return true
      }
    }
    if (target.is_block_node) {
      this.attachPendingComments(p_node)
    }
    ; Not folded, but still an argument list when the name in front of it is a
    ; call the canonical shape already covers (a statement that STARTS with
    ; `recv.method(`). Marking it is what lets a bare call nested inside those
    ; arguments fold.
    if (cnt == 1) {
      def onlyCh:CodeNode (itemAt target.children 0)
      if (this.isPlainDotCallee(onlyCh i)) {
        p_node.is_call_args = true
      }
    }
    push target.children p_node
    return false
  }

  fn tryCloseCallArgParenBeforeInfix:boolean () {
    def current:CodeNode (unwrap curr_node)
    def pr@(optional weak):CodeNode current.parent
    if (null? pr) {
      return false
    }
    def parentNode:CodeNode (unwrap pr)
    if ((array_length current.children) < 1) {
      return false
    }
    def prCnt:int (array_length parentNode.children)
    if (prCnt < 2) {
      return false
    }
    def prevCh:CodeNode (itemAt parentNode.children (prCnt - 2))
    if ((this.isDotVRef(prevCh)) == false) {
      return false
    }
    paren_cnt = paren_cnt - 1
    removeLast parents
    current.ep = i
    curr_node = parentNode
    return true
  }
  
  fn insert_node:void ( p_node@(strong lives):CodeNode) {
    def push_target@(optional weak lives):CodeNode curr_node
    def current:CodeNode (unwrap curr_node)
    if (current.infix_operator) {
      push_target = current.infix_node
      if (push_target.to_the_right) {
        push_target = push_target.right_node
        p_node.parent = push_target
      }
    }
    def target:CodeNode (unwrap push_target)
    if (target.is_block_node) {
      this.attachPendingComments(p_node)
    }
    push target.children p_node
  }

  ; Move leading block comments onto the statement that follows them.
  fn attachPendingComments:void (node@(lives):CodeNode) {
    if ((array_length pending_comments) == 0) {
      return
    }
    while ((array_length pending_comments) > 0) {
      def c:CodeNode (array_extract pending_comments 0)
      push node.comments c
    }
  }

  fn parse_attributes:boolean (s:charbuffer) {
    def last_i:int 0
    def do_break:boolean false
    def attr_name:string ""
    def sp:int i
    def ep:int i
    def c:char 0
    def cc1:char 0
    def cc2:char 0
    cc1 = (charAt s i)
    while (i < len) {
      last_i = i
      while ((i < len) && ((charAt s i) <= 32)) {
        i = (1 + i)
      }
      cc1 = (charAt s i)
      cc2 = (charAt s (i + 1))
      if (i >= len) {
        break _
      }
      if (cc1 == (ccode ">")) {
        return do_break
      }
      if ((cc1 == (ccode "/")) && (cc2 == (ccode ">"))) {
        i = (2 + i)
        return true
      }
      sp = i
      ep = i
      c = (charAt s i)
      while ((i < len) && (((c >= 65) && (c <= 90)) || ((c >= 97) && (c <= 122)) || ((c >= 48) && (c <= 57)) || (c == (ccode "_")) || (c == (ccode "-")))) {
        i = (1 + i)
        c = (charAt s i)
      }
      i = (i - 1)
      def an_sp:int sp
      def an_ep:int i
      c = (charAt s i)
      while ((i < len) && (c != (ccode "="))) {
        i = (1 + i)
        c = (charAt s i)
      }
      if (c == (ccode "=")) {
        i = (1 + i)
      }
      while ((i < len) && ((charAt s i) <= 32)) {
        i = (1 + i)
      }
      if (i >= len) {
        break _
      }
      c = (charAt s i)

      ; parse attribute node...
      if( c == (ccode "{")) {

        def cNode@(lives):CodeNode (unwrap curr_node)

        def new_attr@(lives):CodeNode (new CodeNode(( unwrap code) sp ep))
        new_attr.value_type = RangerNodeType.XMLAttr
        new_attr.parsed_type = new_attr.value_type
        new_attr.vref = (substring s an_sp (an_ep + 1))
        new_attr.string_value = (substring s sp ep)
        push cNode.attrs new_attr
        
        curr_node = new_attr

        paren_cnt = paren_cnt + 1
        def new_qnode@(lives):CodeNode (new CodeNode(( unwrap code) i i))
        new_qnode.expression = true
        this.insert_node(new_qnode)
        push parents new_qnode
        curr_node = new_qnode
        i = 1 + i
        this.parse(false)

        curr_node = cNode

        continue 
      }

      if( (c == 34) || ( c == (ccode "'")) ) {
        i = (i + 1)
        sp = i
        ep = i
        c = (charAt s i)
        while ((i < len) && (c != 34) && ( c!= (ccode "'"))) {
          i = (1 + i)
          c = (charAt s i)
        }
        ep = i
        if ((i < len) && (ep > sp)) {
          def new_attr@(lives):CodeNode (new CodeNode(( unwrap code) sp ep))
          new_attr.value_type = RangerNodeType.XMLAttr
          new_attr.parsed_type = new_attr.value_type
          new_attr.vref = (substring s an_sp (an_ep + 1))
          new_attr.string_value = (substring s sp ep)
          if (!null? curr_node) {
            def current:CodeNode (unwrap curr_node)
            push current.attrs new_attr
          }
        }
        i = (1 + i)
      }
      if (last_i == i) {
        i = (1 + i)
      }
    }
    return do_break
  }

  fn parseXML:void (s:charbuffer) {

    def c:char 0
    def next_c:char 0
    def fc:char 0
    def new_node:CodeNode
    def sp:int i
    def ep:int i
    def last_i:int 0
    def cc1:char 0
    def cc2:char 0
    def tag_depth 0 

    ; print "parseXML called"
    
    while (i < len) {
      last_i = i
      if (i >= (len - 1)) {
        break _
      }
      cc1 = (charAt s i)
      cc2 = (charAt s (i + 1))

      if( cc1 == (ccode "{")) {
        def cNode@(lives) curr_node
        paren_cnt = paren_cnt + 1
        def new_qnode@(lives):CodeNode (new CodeNode(( unwrap code) i i))
        new_qnode.expression = true
        this.insert_node(new_qnode)
        push parents new_qnode
        curr_node = new_qnode
        i = 1 + i
        this.parse(false)
        curr_node = cNode
        continue 
      }

      if (cc1 == (ccode ">")) {
        i = (i + 1)
        cc1 = (charAt s i)
        cc2 = (charAt s (i + 1))
        continue 1
      }
      if (((ccode "/") == cc1) && (cc2 == (ccode ">"))) {
        tag_depth = (tag_depth - 1)
        i = (i + 2)
        if( tag_depth <= 0 ) {
          removeLast parents
          def p_cnt:int (array_length parents)        
          def last_parent@(lives):CodeNode (itemAt parents (p_cnt - 1))
          curr_node = last_parent          
          return
        }
        continue 1
      }
      if (i >= len) {
        break _
      }
      if (((ccode "<") == cc1) && (cc2 == (ccode "/"))) {
        tag_depth = (tag_depth - 1)
        i = (i + 2)
        sp = i
        ep = i
        c = (charAt s i)
        while ((i < len) && (c > 32) && (c != (ccode ">"))) {
          i = (1 + i)
          c = (charAt s i)
        }
        ep = i
        removeLast parents
        def p_cnt:int (array_length parents)
        def last_parent@(lives):CodeNode (itemAt parents (p_cnt - 1))
        curr_node = last_parent
        if( tag_depth <= 0 ) {
          return
        }
        continue 
      }
      if (cc1 == (ccode "<")) {
        i = (i + 1)
        sp = i
        ep = i
        c = (charAt s i)
        while ((i < len) && (c != (ccode ">")) && (((c >= 65) && (c <= 90)) || ((c >= 97) && (c <= 122)) || ((c >= 48) && (c <= 57)) || (c == 95) || (c == 46) || (c == 64))) {
          i = (1 + i)
          c = (charAt s i)
        }
        tag_depth = tag_depth  + 1
        ep = i
        def new_tag:string (substring s sp ep)
        if (!null? curr_node) {
          def current:CodeNode (unwrap curr_node)
          def new_node:CodeNode (new CodeNode(( unwrap code) sp ep))
          new_node.vref = new_tag
          new_node.value_type = RangerNodeType.XMLNode
          new_node.parsed_type = new_node.value_type
          push current.children new_node
          new_node.parent = current
          push parents new_node
          curr_node = new_node
        } {
          def new_rnode:CodeNode (new CodeNode(( unwrap code) sp ep))
          new_rnode.vref = new_tag
          new_rnode.value_type = RangerNodeType.XMLNode
          new_rnode.parsed_type = new_rnode.value_type
          rootNode = new_rnode
          push parents new_rnode
          curr_node = new_rnode
        }        
        if (this.parse_attributes(s)) {
          removeLast parents
          def p_cnt:int (array_length parents)
          def last_parent@(lives):CodeNode (itemAt parents (p_cnt - 1))
          curr_node = last_parent
          tag_depth = (tag_depth - 1)
          if( tag_depth <= 0 ) {
            return
          }
          continue           
        }
        continue 1
      }
      if (!null? curr_node) {
        sp = i
        ep = i
        c = (charAt s i)
        while ((i < len) && (c != (ccode "<")) && (c != (ccode "{")) ) {
          i = (1 + i)
          c = (charAt s i)
        }
        ep = i
        if (ep > sp) {
          def new_node:CodeNode (new CodeNode(( unwrap code) sp ep))
          new_node.string_value = (substring s sp ep)
          new_node.value_type = RangerNodeType.XMLText
          new_node.parsed_type = new_node.value_type
          push curr_node.children new_node
          new_node.parent = curr_node
        }
      }
      if (last_i == i) {
        i = (1 + i)
      }
    }
  }
  
  
  ; The public entry: reads the buffer ONCE and hands the borrow down.
  fn parse:void ( disable_ops:boolean ) {
    def srcBuf:charbuffer ( unwrap buff)
    this.parseBuf(srcBuf disable_ops)
  }
  fn parseBuf:void ( s:charbuffer disable_ops:boolean ) {
    def c:char (charAt s 0)
    def next_c:char 0
    def fc:char 0
    def new_node@(optional):CodeNode
    def sp:int 0
    def ep:int 0
    def last_i:int 0
    def had_lf:boolean false
    def disable_ops_set disable_ops
    def did_fold_call:boolean false
    def folded_call@(optional weak):CodeNode

    ; ISSUES.md #70. Every one of the three recursion sites below pushes a node
    ; onto `parents` and then calls parseBuf. This records how deep `parents` was
    ; when THIS frame started, so the loop can tell when the node this frame is
    ; parsing has been closed.

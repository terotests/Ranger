class RangerKotlinClassWriter {
  Extends (RangerGenericClassWriter)
  def compiler:LiveCompiler
  ; S5 (PLAN_SHAPES.md): a union becomes a `sealed interface` its members
  ; implement, so the JVM keeps the static type a shape declares instead of
  ; erasing it to Any. Declared once, before the first class of the file.
  def kotlin_unions_written:boolean false

  fn writeKotlinUnionInterfaces:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    if kotlin_unions_written {
      return
    }
    kotlin_unions_written = true
    def names:[string] (this.sealableUnionNames(ctx))
    for names uname:string ui {
      wr.out("" true)
      wr.out(("sealed interface " + (this.unionInterfaceName(uname))) true)
    }
  }

  fn WriteScalarValue:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    switch node.value_type {
      case RangerNodeType.Double {
        ; the value, never a source slice: getParsedString reads the file back
        ; by the node's recorded position, and a file with CRLF line endings --
        ; or a macro-shifted position -- slices unrelated bytes into the
        ; output. `def value:double 0.0` in a CRLF file wrote `= lue`.
        ; The `.0` suffix is what makes the literal a Double rather than an Int.
        def dd_str:string ("" + node.double_value)
        def ii_str:string ("" + (to_int node.double_value))
        if (dd_str == ii_str) {
          wr.out((("" + node.double_value) + ".0") false)
        } {
          wr.out(("" + node.double_value) false)
        }
      }
      case RangerNodeType.String {
        def s:string (this.EncodeString(node ctx wr))
        wr.out((("\"" + s) + "\"") false)
      }
      case RangerNodeType.Integer {
        ; Kotlin `Int` is signed 32-bit. Literals outside that range are Long
        ; and will not type-check against Int parameters or `and`/`or`.
        ; -2147483648 is written as (-2147483647 - 1): the literal 2147483648
        ; does not fit a signed 32-bit int, and on C# a constant expression that
        ; overflows is a compile error, not a wrap.
        if ((node.int_value > 2147483647) || (node.int_value < ((0 - 2147483647) - 1))) {
          wr.out((("(" + node.int_value) + "L).toInt()") false)
        } {
          wr.out(("" + node.int_value) false)
        }
      }
      case RangerNodeType.Boolean {
        if node.boolean_value {
          wr.out("true" false)
        } {
          wr.out("false" false)
        }
      }
    }
  }

  ; Kotlin has no bare `[]` array literal (outside annotations). Empty and
  ; non-empty lists both go through typed `arrayListOf`, matching the
  ; `MutableList<T>` the rest of the writer emits.
  fn writeArrayLiteral( node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def elemType:string node.eval_array_type
    if ((strlen elemType) == 0) {
      elemType = node.array_type
    }
    wr.out("arrayListOf<" false)
    if ((strlen elemType) > 0) {
      wr.out((this.getObjectTypeString(elemType ctx)) false)
    } {
      wr.out("Any" false)
    }
    wr.out(">(" false)
    node.children.forEach({
      if( index > 0 ) {
        wr.out(", " false)
      }
      this.WalkNode( item ctx wr )
    })
    wr.out(")" false)
  }
  fn adjustType:string (tn:string) {
    if (tn == "this") {
      return "this"
    }
    return tn
  }
  fn getObjectTypeString:string (type_string:string ctx:RangerAppWriterContext) {
    if ((strlen type_string) >= 2) {
      if ((charAt type_string 0) == (ccode "[")) {
        return (this.collectionTypeStringToKotlin(type_string ctx))
      }
    }
    ; A `union` names no type of its own on the JVM — nothing declares it, so
    ; the union name reached the output and kotlinc saw an undeclared type. The
    ; narrowing `case` operator tests with `is` and casts, both of which work
    ; off Any. (A sealed interface would be the better representation and is
    ; what `shape` should generate; see PLAN_SHAPES.md.)
    if (ctx.isDefinedClass(type_string)) {
      def cc:RangerAppClassDesc (ctx.findClass(type_string))
      if (cc.is_union) {
        ; a union of classes is a sealed interface; anything else (the
        ; compiler's own `Any`, a union over primitives) stays the top type
        if (this.unionIsSealable(cc ctx)) {
          return (this.unionInterfaceName(type_string))
        }
        return "Any"
      }
    }
    switch type_string {
      case "int" {
        return "Int"
      }
      case "string" {
        return "String"
      }
      case "chararray" {
        return "CharArray"
      }
      case "buffer" {
        return "ByteArray"
      }
      case "int_buffer" {
        return "LongArray"
      }
      case "double_buffer" {
        return "DoubleArray"
      }
      case "char" {
        return "Char"
      }
      case "boolean" {
        return "Boolean"
      }
      case "double" {
        return "Double"
      }
    }
    return type_string
  }
  ; Convert a nested collection type string such as "[string]" or
  ; "[string:[int]]" into the corresponding Kotlin type, recursing on the
  ; element/value types.
  fn collectionTypeStringToKotlin:string (type_string:string ctx:RangerAppWriterContext) {
    def n:int (strlen type_string)
    def inner:string (substring type_string 1 (n - 1))
    def il:int (strlen inner)
    def depth:int 0
    def sep:int (0 - 1)
    def i:int 0
    while (i < il) {
      def c:int (charAt inner i)
      if (c == (ccode "[")) {
        depth = depth + 1
      }
      if (c == (ccode "]")) {
        depth = depth - 1
      }
      if ((c == (ccode ":")) && (depth == 0)) {
        sep = i
      }
      i = i + 1
    }
    if (sep >= 0) {
      def kt:string (substring inner 0 sep)
      def vt:string (substring inner (sep + 1) il)
      return (((("MutableMap<" + (this.getObjectTypeString(kt ctx))) + ",") + (this.getObjectTypeString(vt ctx))) + ">")
    }
    return (("MutableList<" + (this.getObjectTypeString(inner ctx))) + ">")
  }
  fn getTypeString:string (type_string:string) {
    switch type_string {
      case "int" {
        return "Int"
      }
      case "string" {
        return "String"
      }
      case "chararray" {
        return "CharArray"
      }
      case "buffer" {
        return "ByteArray"
      }
      case "int_buffer" {
        return "LongArray"
      }
      case "double_buffer" {
        return "DoubleArray"
      }
      case "char" {
        return "Char"
      }
      case "boolean" {
        return "Boolean"
      }
      case "double" {
        return "Double"
      }
    }
    return type_string
  }
  fn writeTypeDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def v_type:RangerNodeType node.value_type
    if (node.eval_type != RangerNodeType.NoType) {
      v_type = node.eval_type
    }
    switch v_type {
      case RangerNodeType.Enum {
        wr.out("Int" false)
      }
      case RangerNodeType.Integer {
        wr.out("Int" false)
      }
      case RangerNodeType.Double {
        wr.out("Double" false)
      }
      case RangerNodeType.Char {
        wr.out("Char" false)
      }
      case RangerNodeType.CharBuffer {
        wr.out("CharArray" false)
      }
      case RangerNodeType.Buffer {
        wr.out("ByteArray" false)
      }
      case RangerNodeType.IntBuffer {
        wr.out("LongArray" false)
      }
      case RangerNodeType.DoubleBuffer {
        wr.out("DoubleArray" false)
      }
      case RangerNodeType.String {
        wr.out("String" false)
      }
      case RangerNodeType.Boolean {
        wr.out("Boolean" false)
      }
      case RangerNodeType.Hash {
        wr.out((((("MutableMap<" + (this.getObjectTypeString(node.key_type ctx))) + ",") + (this.getObjectTypeString(node.array_type ctx))) + ">") false)
      }
      case RangerNodeType.Array {
        wr.out((("MutableList<" + (this.getObjectTypeString(node.array_type ctx))) + ">") false)
      }
      default {
        if (node.type_name == "void") {
          wr.out("Unit" false)
        } {
          ; getObjectTypeString, not getTypeString: a union has no Kotlin type
          ; of its own and has to be written as Any here too, not only as a
          ; collection element type.
          wr.out((this.getObjectTypeString(node.type_name ctx)) false)
        }
      }
    }
    if (node.hasFlag("optional")) {
      wr.out("?" false)
    }
  }
  fn WriteVRef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (node.vref == "this") {
      wr.out("this" false)
      return
    }
    if (node.eval_type == RangerNodeType.Enum) {
      if( (array_length node.ns) > 1) {
        def rootObjName:string (itemAt node.ns 0)
        def enumName:string (itemAt node.ns 1)
        def e@(optional):RangerAppEnum (ctx.getEnum(rootObjName))
        if (!null? e) {
          wr.out(("" + (unwrap (get e.values enumName))) false)
          return
        }
      }
    }
    def max_len:int (array_length node.ns)
    if ((array_length node.nsp) > 0) {
      for node.nsp p:RangerAppParamDesc i {
        if (i == 0) {
          def part:string (itemAt node.ns 0)
          if(part == "this") {
            wr.out("this" false)
            continue
          }
          ; Check if this is a reference to current class (instance method call)
          def uc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
          if (!null? uc) {
            def currC:RangerAppClassDesc (unwrap uc)
            if (part == currC.name) {
              ; Replace ClassName with this for instance method calls -- but
              ; NOT when the member named after it is a static one. A static
              ; method lives in the companion object, so `this.create(...)`
              ; does not resolve; the class name in `EVGColor.create(...)` has
              ; to survive.
              if( (false == (ctx.isInStatic())) && (false == (this.namesStaticMember(currC node))) ) {
                wr.out("this" false)
                continue
              }
            }
          }
          ; Check if this is a member variable
          if (ctx.isMemberVariable(part)) {
            if( false == (ctx.isInStatic()) ) {
              wr.out("this." false)
            }
          }
        }
        if (i > 0) {
          wr.out("." false)
        }
        if ((strlen p.compiledName) > 0) {
          wr.out((this.adjustType(p.compiledName)) false)
        } {
          if ((strlen p.name) > 0) {
            wr.out((this.adjustType(p.name)) false)
          } {
            wr.out((this.adjustType((itemAt node.ns i))) false)
          }
        }
        if (i == 0) {
          if (p.nameNode.hasFlag("optional")) {
            wr.out("!!" false)
          }
        }
      }
      return
    }
    if node.hasParamDesc {
      def p:RangerAppParamDesc node.paramDesc
      wr.out(p.compiledName false)
      return
    }
    for node.ns part:string i {
      if (i > 0) {
        wr.out("." false)
      }
      if (i == 0) {
        ; Check if first part is the current class name
        def uc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
        if (!null? uc) {
          def currC:RangerAppClassDesc (unwrap uc)
          if (part == currC.name) {
            if( (false == (ctx.isInStatic())) && (false == (this.namesStaticMember(currC node))) ) {
              wr.out("this" false)
              continue
            }
          }
        }
      }
      wr.out((this.adjustType(part)) false)
    }
  }
  ; Kotlin reads `$name` and `${expr}` inside a string literal as a template
  ; substitution, so a dollar sign has to be escaped -- without this a program
  ; that BUILDS a template string, as the TS engine does, either fails to parse
  ; (`"${"`) or silently interpolates a local. Everything else is the encoding
  ; RangerGenericClassWriter does.
  fn EncodeString:string (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def encoded_str:string ""
    def str_length:int (strlen node.string_value)
    def ii:int 0
    while (ii < str_length) {
      def cc:int (charAt node.string_value ii)
      switch cc {
        case 8 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 98))
        }
        case 9 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 116))
        }
        case 10 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 110))
        }
        case 12 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 102))
        }
        case 13 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 114))
        }
        case 34 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 34))
        }
        case 36 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 36))
        }
        case 92 {
          encoded_str = ((encoded_str + (strfromcode 92)) + (strfromcode 92))
        }
        default {
          encoded_str = (encoded_str + (strfromcode cc))
        }
      }
      ii = (ii + 1)
    }
    return encoded_str
  }

  ; True when the receiver of a call is spelled with a nullable Kotlin type --
  ; either the reference itself carries the optional flag, or it names a
  ; variable whose declaration does. writeTypeDef gives such a declaration a
  ; trailing `?`, and Kotlin then refuses a plain `.` call on it.
  fn receiverIsNullable:boolean (obj:CodeNode) {
    if (obj.hasFlag("optional")) {
      return true
    }
    if obj.hasParamDesc {
      def p:RangerAppParamDesc obj.paramDesc
      def nn@(optional):CodeNode p.nameNode
      if (!null? nn) {
        if ((unwrap nn).hasFlag("optional")) {
          return true
        }
      }
    }
    return false
  }

  ; Same shape as RangerGenericClassWriter.CreateCallExpression, plus the null
  ; assertion Kotlin needs: a field declared without an initializer comes out
  ; as `EvalContext?`, and `(moduleScope).has(k)` on it does not compile --
  ; "only safe (?.) or non-null asserted (!!.) calls are allowed". The
  ; namespaced path in WriteVRef already writes `!!`; a bare single-name
  ; receiver reached this one instead and got neither that nor `this.`.
  fn CreateCallExpression(node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.has_call {
      def obj:CodeNode (node.getSecond())
      def method:CodeNode (node.getThird())
      def args:CodeNode (itemAt node.children 3)

      wr.out("(" false)
      ctx.setInExpr()
      this.WalkNode( obj ctx wr)
      ctx.unsetInExpr()
      wr.out(")" false)
      if (this.receiverIsNullable(obj)) {
        wr.out("!!" false)
      }
      wr.out("." false)
      def methodName method.vref
      if ((!null? node.fnDesc) && ((strlen node.fnDesc.compiledName) > 0)) {
        methodName = node.fnDesc.compiledName
      }
      wr.outMapped(methodName method false method.vref)
      wr.out("(" false)
      ctx.setInExpr()
      def pms (filter (args.children) {
        if( item.hasFlag('keyword')) {
          return false
        }
        return true
      })
      for pms arg:CodeNode i {
        if (i > 0) {
          wr.out(", " false)
        }
        this.WalkNode(arg ctx wr)
      }
      ctx.unsetInExpr()
      wr.out(")" false)
      if ((ctx.expressionLevel()) == 0) {
        wr.out(";" true)
      }
    }
  }

  ; True when a namespaced path whose root is the class name goes on to name a
  ; static member of it -- `EVGColor.create` inside EVGColor. Kotlin puts those
  ; in the companion object, where `this` cannot reach them.
  fn namesStaticMember:boolean (cl:RangerAppClassDesc node:CodeNode) {
    if ((array_length node.ns) < 2) {
      return false
    }
    def member:string (itemAt node.ns 1)
    if (cl.hasStaticMethod(member)) {
      return true
    }
    return false
  }

  fn writeVarDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasParamDesc {
      def nn:CodeNode (itemAt node.children 1)
      def p:RangerAppParamDesc nn.paramDesc
      if ((p.ref_cnt == 0) && (p.is_class_variable == false)) {
        if ((array_length node.children) > 2) {
          def value:CodeNode (node.getThird())
          if (this.defValueHasSideEffects(value)) {
            this.writeSideEffectOnlyStmt(value ctx wr)
            return
          }
        }
        wr.out("/** unused:  " false)
      }
      if p.is_class_variable {
        wr.out("@JvmField " false)
      }
      if ((p.set_cnt > 0) || p.is_class_variable) {
        wr.out("var " false)
      } {
        wr.out("val " false)
      }
      wr.out(p.compiledName false)
      wr.out(" : " false)
      this.writeTypeDef((unwrap p.nameNode) ctx wr)
      wr.out(" " false)
      if ((array_length node.children) > 2) {
        wr.out(" = " false)
        ctx.setInExpr()
        def value:CodeNode (node.getThird())
        this.WalkNode(value ctx wr)
        ctx.unsetInExpr()
      } {
        if (nn.hasFlag("optional")) {
          wr.out(" = null" false)
        } {
          if (nn.value_type == RangerNodeType.Array) {
            wr.out(" = arrayListOf()" false)
          }
          if (nn.value_type == RangerNodeType.Hash) {
            wr.out(" = hashMapOf()" false)
          }
        }
      }
      if ((p.ref_cnt == 0) && (p.is_class_variable == true)) {
        wr.out("     /** note: unused */" false)
      }
      if ((p.ref_cnt == 0) && (p.is_class_variable == false)) {
        wr.out("   **/ ;" true)
      } {
        wr.out(";" false)
        wr.newline()
      }
    }
  }
  fn paramEmitName:string (arg:RangerAppParamDesc ctx:RangerAppWriterContext) {
    if ((strlen arg.compiledName) > 0) {
      return arg.compiledName
    }
    return (ctx.transformWord(arg.name))
  }
  ; The constructor of a `record` holds a marker parameter for each keyword,
  ; next to the parameter that carries the value. The marker has a name and no
  ; type, so it must not reach the signature: without this filter the
  ; constructor of `record Point { def xpos:int 0 def ypos:int 0 }` comes out
  ; with four parameters, two of them without a type.
  fn writeArgsDef:void (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    def pms (filter (fnDesc.params) {
      if (item.nameNode.hasFlag("keyword")) {
        return false
      }
      return true
    })
    for pms arg:RangerAppParamDesc i {
      if (i > 0) {
        wr.out("," false)
      }
      wr.out(" " false)
      wr.out(( (this.paramEmitName(arg ctx)) + " : ") false)
      this.writeTypeDef( (unwrap arg.nameNode) ctx wr)
    }
  }
  fn writeFnCall:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasFnCall {
      ctx.setInExpr()
      def fc:CodeNode (node.getFirst())
      this.WriteVRef(fc ctx wr)
      wr.out("(" false)
      def givenArgs:CodeNode (node.getSecond())
      for node.fnDesc.params arg:RangerAppParamDesc i {
        if (i > 0) {
          wr.out(", " false)
        }
        if( (array_length givenArgs.children) <= i) {
          def defVal@(optional):CodeNode (arg.nameNode.getFlag("default"))
          if (!null? defVal) {
            def fc:CodeNode (defVal.vref_annotation.getFirst())
            this.WalkNode(fc ctx wr)
          } {
            ctx.addError(node "Default argument was missing")
          }
          continue 
        }
        def n:CodeNode (itemAt givenArgs.children i)
        this.WalkNode(n ctx wr)
      }
      wr.out(")" false)
      ctx.unsetInExpr()
      if ((ctx.expressionLevel()) == 0) {
        wr.out(";" true)
      }
    }
  }
  fn writeNewCall:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasNewOper {
      def cl:RangerAppClassDesc node.clDesc
      def givenArgs:CodeNode (node.getThird())
      if (this.tryWriteProcessNewCall(node ctx wr)) {
        return
      }
      if (cl.isSingletonClass()) {
        wr.out(" " false)
        wr.out((node.clDesc.name + ".__singleton") false)
        wr.out("(" false)
        for givenArgs.children n:CodeNode i {
          if (i > 0) {
            wr.out(", " false)
          }
          this.WalkNode(n ctx wr)
        }
        wr.out(")" false)
        return
      }

      def fc:CodeNode (node.getSecond())
      wr.out(" " false)
      wr.out(node.clDesc.name false)
      wr.out("(" false)
      def constr:RangerAppFunctionDesc cl.constructor_fn
      if (!null? constr) {
        ; A keyword marker of a record constructor names the field and carries
        ; no value. The signature drops it, so the call drops it as well.
        def written 0
        for constr.params arg:RangerAppParamDesc i {
          if (arg.nameNode.hasFlag("keyword")) {
            continue
          }
          def n:CodeNode (itemAt givenArgs.children i)
          if (written > 0) {
            wr.out(", " false)
          }
          written = written + 1
          this.WalkNode(n ctx wr)
        }
      }
      wr.out(")" false)
    }
  }
  fn writeClass:void (node:CodeNode ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def cl:RangerAppClassDesc node.clDesc
    if (null? cl) {
      return
    }
    def declaredFunction:[string:boolean]
    def wr:CodeWriter orig_wr
    def importFork:CodeWriter (wr.fork())
    this.writeKotlinUnionInterfaces(ctx wr)
    wr.out("" true)
    if (cl.is_extended_by_children || (cl.name == "RangerProcessBase")) {
      wr.out(("open class " + cl.name) false)
    } {
      wr.out(("class " + cl.name) false)
    }
    if cl.has_constructor {
      def constr:RangerAppFunctionDesc (unwrap cl.constructor_fn)
      wr.out("(" false)
      this.writeArgsDef(constr ctx wr)
      wr.out(" )" false)
    }
    if ((array_length cl.extends_classes) > 0) {
      wr.out(" : " false)
      for cl.extends_classes pName:string i {
        if (i > 0) {
          wr.out(", " false)
        }
        def parentClass:RangerAppClassDesc (ctx.findClass(pName))
        for parentClass.defined_variants fnVar:string j {
          def mVs:RangerAppMethodVariants (get parentClass.method_variants fnVar)
          for mVs.variants variant:RangerAppFunctionDesc k {
            set declaredFunction variant.name true
          }
        }
        wr.out(parentClass.compiledName false)
        if parentClass.has_constructor {
          wr.out("(" false)
          if cl.has_constructor {
            def constr:RangerAppFunctionDesc (unwrap cl.constructor_fn)
            def pConstr:RangerAppFunctionDesc (unwrap parentClass.constructor_fn)
            for pConstr.params pArg:RangerAppParamDesc j {
              if (j > 0) {
                wr.out(", " false)
              }
              def foundByName:boolean false
              for constr.params cArgByName:RangerAppParamDesc k {
                if (cArgByName.name == pArg.name) {
                  wr.out(cArgByName.compiledName false)
                  foundByName = true
                  break
                }
              }
              if (false == foundByName) {
                if (j < (array_length constr.params)) {
                  def cArg:RangerAppParamDesc (itemAt constr.params j)
                  wr.out(cArg.compiledName false)
                }
              }
            }
          }
          wr.out(")" false)
        } {
          ; Kotlin requires explicit super constructor invocation: class Child : Parent()
          wr.out("()" false)
        }
      }
    }
    ; the unions this class belongs to are its interfaces — nothing has to be
    ; wrapped at a call site for a value to become a union member
    def clUnions:[string] (this.unionInterfacesOf((unwrap cl) ctx))
    if ((array_length clUnions) > 0) {
      if ((array_length cl.extends_classes) > 0) {
        wr.out(", " false)
      } {
        wr.out(" : " false)
      }
      for clUnions uname:string ui {
        if (ui > 0) {
          wr.out(", " false)
        }
        wr.out(uname false)
      }
    }
    wr.out(" " true)
    wr.out(" {" true)
    wr.indent(1)
    def has_static_vars false
    for cl.variables pvar:RangerAppParamDesc i {
      if pvar.is_static {
        has_static_vars = true
      }
    }
    def wants_companion false
    if (((array_length cl.static_methods) > 0) || has_static_vars) {
      wants_companion = true
    }
    if (cl.isSingletonClass()) {
      wants_companion = true
    }
    for cl.variables pvar:RangerAppParamDesc i {
      if pvar.is_static {
        continue _
      }
      this.writeVarDef((unwrap pvar.node) ctx wr)
    }
    if cl.has_constructor {
      def constr:RangerAppFunctionDesc cl.constructor_fn
      wr.out("" true)
      wr.out("init {" true)
      wr.indent(1)
      wr.newline()
      def subCtx:RangerAppWriterContext (unwrap constr.fnCtx)
      subCtx.is_function = true
      this.WalkNode( (unwrap constr.fnBody) subCtx wr)
      wr.newline()
      wr.indent(-1)
      wr.out("}" true)
    }
    if wants_companion {
      wr.out("companion object {" true)
      wr.indent(1)
    }
    for cl.variables pvar:RangerAppParamDesc i {
      if (false == pvar.is_static) {
        continue _
      }
      this.writeVarDef((unwrap pvar.node) ctx wr)
    }
    if (cl.isSingletonClass()) {
      wr.out(("private var __singleton_instance : " + cl.compiledName + "? = null") true)
      wr.out("fun __singleton(" false)
      if cl.has_constructor {
        def constr:RangerAppFunctionDesc (unwrap cl.constructor_fn)
        this.writeArgsDef(constr ctx wr)
      }
      wr.out((") : " + cl.compiledName + " {") true)
      wr.indent(1)
      wr.out("if (__singleton_instance == null) {" true)
      wr.indent(1)
      wr.out(("__singleton_instance = " + cl.compiledName + "(") false)
      if cl.has_constructor {
        def constr:RangerAppFunctionDesc (unwrap cl.constructor_fn)
        for constr.params arg:RangerAppParamDesc i {
          if (i > 0) {
            wr.out(", " false)
          }
          wr.out(arg.compiledName false)
        }
      }
      wr.out(")" true)
      wr.indent(-1)
      wr.out("}" true)
      wr.out("return __singleton_instance!!" true)
      wr.indent(-1)
      wr.out("}" true)
    }
    for cl.static_methods variant:RangerAppFunctionDesc i {
      wr.out("" true)
      if (variant.nameNode.hasFlag("main")) {
        continue _
      }
      if (variant.nameNode.hasFlag("open")) {
        wr.out("open " false)
      }
      if (variant.nameNode.hasFlag("override")) {
        wr.out("override " false)
      }
      wr.out("fun " false)
      wr.out(" " false)
      wr.out((variant.compiledName + "(") false)
      this.writeArgsDef(variant ctx wr)
      wr.out(") : " false)
      this.writeTypeDef( (unwrap variant.nameNode ) ctx wr)
      wr.out(" {" true)
      wr.indent(1)
      wr.newline()
      def subCtx:RangerAppWriterContext (unwrap variant.fnCtx)
      subCtx.is_function = true
      subCtx.in_method = true
      subCtx.in_static_method = false
      subCtx.currentMethod = variant
      subCtx.setCurrentClass( (unwrap cl) )
      this.WalkNode( (unwrap variant.fnBody ) subCtx wr)
      wr.newline()
      wr.indent(-1)
      wr.out("}" true)
    }
    if wants_companion {
      wr.indent(-1)
      wr.out("}" true)
    }
    for cl.defined_variants fnVar:string i {
      def mVs:RangerAppMethodVariants (get cl.method_variants fnVar)
      for mVs.variants variant:RangerAppFunctionDesc i {
        wr.out("" true)
        def shouldOverride:boolean false
        if (variant.nameNode.hasFlag("override")) {
          shouldOverride = true
        }
        if (has declaredFunction variant.name) {
          shouldOverride = true
        }
        ; toString() and hashCode() DO override the ones every Kotlin class
        ; inherits -- but only in their no-argument form, and `equals` never
        ; does: Any.equals takes Any?, so `equals(other:EvalValue)` is an
        ; overload, and marking it `override` made the file refuse to compile
        ; with "'equals' overrides nothing".
        if ((variant.compiledName == "toString") || (variant.compiledName == "hashCode")) {
          if ((array_length variant.params) == 0) {
            shouldOverride = true
          }
        }
        if shouldOverride {
          wr.out("override " false)
        } {
          if cl.is_extended_by_children {
            wr.out("open " false)
          }
        }
        wr.out("fun " false)
        wr.out(" " false)
        wr.out((variant.compiledName + "(") false)
        this.writeArgsDef(variant ctx wr)
        wr.out(") : " false)
        this.writeTypeDef( (unwrap variant.nameNode ) ctx wr)
        wr.out(" {" true)
        wr.indent(1)
        wr.newline()
        def subCtx:RangerAppWriterContext (unwrap variant.fnCtx)
        subCtx.is_function = true
        subCtx.in_method = true
        subCtx.in_static_method = false
        subCtx.currentMethod = variant
        subCtx.setCurrentClass( (unwrap cl) )
        this.WalkNode( (unwrap variant.fnBody ) subCtx wr)
        wr.newline()
        wr.indent(-1)
        wr.out("}" true)
      }
    }
    wr.indent(-1)
    wr.out("}" true)
    for cl.static_methods variant:RangerAppFunctionDesc i {
      wr.out("" true)
      if ( (variant.nameNode.hasFlag("main")) && (variant.nameNode.code.filename == (ctx.getRootFile()))) {
        wr.out("fun main(args : Array<String>) {" true)
        wr.indent(1)
        wr.newline()
        def subCtx:RangerAppWriterContext (unwrap variant.fnCtx )
        subCtx.is_function = true
        subCtx.in_method = false
        subCtx.in_static_method = true
        subCtx.currentMethod = variant
        this.WalkNode( (unwrap variant.fnBody ) subCtx wr)
        wr.newline()
        wr.indent(-1)
        wr.out("}" true)
      }
    }
  }
}


; SPDX-License-Identifier: MIT

; `writeClass` and everything that puts a struct on the page: its fields and
; their types, the trait a shared class is reached through, the accessor pair
; a trait field needs, and the Rc state a constructor has to set up.

extension RangerRustClassWriter {

  fn rustMethodInTraitIface:boolean (cl:RangerAppClassDesc name:string ctx:RangerAppWriterContext) {
    if cl.is_extended_by_children {
      return true
    }
    for cl.extends_classes tiParent:string tiPi {
      def tiPC@(optional):RangerAppClassDesc (ctx.findClass(tiParent))
      if (!null? tiPC) {
        def tiC:RangerAppClassDesc (unwrap tiPC)
        if tiC.is_extended_by_children {
          if (has tiC.defined_methods name) {
            return true
          }
        }
      }
    }
    return false
  }

  fn rustClassMethodKnownShared:boolean (cls:RangerAppClassDesc name:string ctx:RangerAppWriterContext) {
    def kmRootO@(optional):RangerAppClassDesc (this.rustTraitRootOf(cls ctx))
    if (!null? kmRootO) {
      def kmRoot:RangerAppClassDesc (unwrap kmRootO)
      if (has kmRoot.method_variants name) {
        this.rustFillTraitMutations(kmRoot ctx)
        return ((has kmRoot.rust_trait_mut name) == false)
      }
    }
    if ((has cls.method_variants name) == false) {
      def kmM@(optional):RangerAppFunctionDesc (cls.findMethod(name))
      if (null? kmM) {
        return false
      }
      def kmMD:RangerAppFunctionDesc (unwrap kmM)
      return (kmMD.rust_mut_self == false)
    }
    def kmVs:RangerAppMethodVariants (get cls.method_variants name)
    if ((array_length kmVs.variants) == 0) {
      return false
    }
    for kmVs.variants kmV:RangerAppFunctionDesc kmVi {
      if kmV.rust_mut_self {
        return false
      }
    }
    return true
  }

  fn rustCollectInheritedVars:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext seen:[string:boolean] into:[RangerAppParamDesc]) {
    for cl.extends_classes pName:string i {
      if (ctx.isDefinedClass(pName)) {
        def pc:RangerAppClassDesc (ctx.findClass(pName))
        for pc.variables pvar:RangerAppParamDesc j {
          if (has seen pvar.name) {
          } {
            set seen pvar.name true
            push into pvar
          }
        }
        this.rustCollectInheritedVars(pc ctx seen into)
      }
    }
  }

  fn rustAllStructVars:[RangerAppParamDesc] (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    def res:[RangerAppParamDesc]
    def seen:[string:boolean]
    ; The class's own declarations go in first and win. Neither order is
    ; right while a subclass may restate a parent's field with a different
    ; strength: RangerAppParamDesc declares `nameNode` strong and
    ; RangerAppFunctionDesc restates it `@(weak)`, an inherited method body
    ; is emitted into every subclass's impl unchanged (the body of
    ; RangerAppParamDesc::isAllocatedType lands in RangerAppFunctionDesc's
    ; impl and reads `self.nameNode` there), and a trait accessor's
    ; signature comes from the parent while its body reads the subclass's
    ; slot. Letting the parent win fixes those two and breaks more
    ; elsewhere — measured twice, 1708 -> 1879 and 869 -> 1141. The real
    ; repair is to stop restating fields with a different strength.
    for cl.variables pvar:RangerAppParamDesc i {
      set seen pvar.name true
      push res pvar
    }
    this.rustCollectInheritedVars(cl ctx seen res)
    return res
  }

  fn writeStructFieldType:void (p:RangerAppParamDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    rust_writing_field_type = true
    this.writeStructFieldTypeInner(p ctx wr)
    rust_writing_field_type = false
  }

  fn writeStructFieldTypeInner:void (p:RangerAppParamDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    if p.rust_interior_cell {
      def cellNameN:CodeNode (unwrap p.nameNode)
      if (this.rustCellIsCopy(p)) {
        wr.out("std::cell::Cell<" false)
        this.writeTypeDef(cellNameN ctx wr)
        wr.out(">" false)
        return
      }
      if (this.rustCellIsString(p)) {
        wr.out("RefCell<String>" false)
        return
      }
      if (this.rustCellIsCollection(p)) {
        wr.out("RefCell<" false)
        this.writeTypeDef(cellNameN ctx wr)
        wr.out(">" false)
        return
      }
      wr.out("RefCell<Option<" false)
      wr.out((this.rustSharedTypeString(cellNameN.type_name ctx)) false)
      wr.out(">>" false)
      return
    }
    def nameN:CodeNode (unwrap p.nameNode)
    ; A field of a shared class holds the Rc (PLAN_RUST_OWNERSHIP 2b). A
    ; weak field keeps its Weak form, and a collection wraps its element
    ; inside writeTypeDef instead.
    def shared_field:boolean false
    if p.rust_needs_rc_wrap {
      if (nameN.hasFlag("weak") == false) {
        if (((strlen nameN.array_type) == 0) && ((strlen nameN.key_type) == 0)) {
          shared_field = true
        }
      }
    }
    if shared_field {
      if p.is_optional {
        wr.out((("Option<" + (this.rustSharedTypeString(nameN.type_name ctx))) + ">") false)
      } {
        wr.out((this.rustSharedTypeString(nameN.type_name ctx)) false)
      }
    } {
      if p.rust_static_str {
        ; a never-computed string: a pointer to the literal, Copy, no
        ; allocation on any assignment (rust_static_str)
        wr.out("&'static str" false)
      } {
        this.writeTypeDef(nameN ctx wr)
      }
    }
  }

  fn rustSegThroughTrait:boolean (node:CodeNode idx:int ctx:RangerAppWriterContext) {
    if (idx < 1) {
      return false
    }
    if ((array_length node.nsp) <= idx) {
      return false
    }
    def owner:RangerAppParamDesc (itemAt node.nsp (idx - 1))
    def ownerNN@(optional):CodeNode owner.nameNode
    if (null? ownerNN) {
      return false
    }
    def onn:CodeNode (unwrap ownerNN)
    ; a collection segment yields its element, so the owner's own class name
    ; is not what the next segment is read out of
    if (((strlen onn.array_type) > 0) || ((strlen onn.key_type) > 0)) {
      return false
    }
    if ((this.rustTypeIsOwnHandle(onn.type_name ctx)) == false) {
      return false
    }
    ; only a FIELD comes from an accessor. A method segment keeps its own
    ; name — routing one through rgf_… produced `x.rgf_getStrength_mut()()`,
    ; an accessor that does not exist called as if it returned a function.
    def ownerCls@(optional):RangerAppClassDesc (ctx.findClass(onn.type_name))
    if (null? ownerCls) {
      return false
    }
    def oc:RangerAppClassDesc (unwrap ownerCls)
    def seg:RangerAppParamDesc (itemAt node.nsp idx)
    def fv@(optional):RangerAppParamDesc (oc.findVariable(seg.name))
    if (null? fv) {
      return false
    }
    return true
  }

  fn writeStructField (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasParamDesc {
      def nn:CodeNode (itemAt node.children 1)
      def p:RangerAppParamDesc (unwrap nn.paramDesc)
      wr.out(((this.adjustType(p.compiledName)) + " : ") false)
      this.writeStructFieldType(p ctx wr)
      wr.out(", " true)
    }
  }

  fn writeTraitFieldAccessorDecls:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    for cl.variables pvar:RangerAppParamDesc i {
      def acc:string (this.rustFieldAccessorName(pvar))
      if ((this.rustFieldIsCopyScalar(pvar ctx)) || (this.rustFieldIsPlainString(pvar ctx))) {
        wr.out((("fn " + acc) + "(&self) -> ") false)
      } {
        wr.out((("fn " + acc) + "(&self) -> &") false)
      }
      this.writeStructFieldType(pvar ctx wr)
      wr.out(";" true)
      wr.out((("fn " + acc) + "_mut(&mut self) -> &mut ") false)
      this.writeStructFieldType(pvar ctx wr)
      wr.out(";" true)
    }
  }

  fn writeTraitFieldAccessorImpls:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    for cl.variables pvar:RangerAppParamDesc i {
      def acc:string (this.rustFieldAccessorName(pvar))
      def fld:string (this.adjustType(pvar.compiledName))
      if (this.rustFieldIsPlainString(pvar ctx)) {
        wr.out((("fn " + acc) + "(&self) -> ") false)
        this.writeStructFieldType(pvar ctx wr)
        wr.out(((" { self." + fld) + ".clone() }") true)
      } {
      if (this.rustFieldIsCopyScalar(pvar ctx)) {
        wr.out((("fn " + acc) + "(&self) -> ") false)
        this.writeStructFieldType(pvar ctx wr)
        wr.out(((" { self." + fld) + " }") true)
      } {
        wr.out((("fn " + acc) + "(&self) -> &") false)
        this.writeStructFieldType(pvar ctx wr)
        wr.out(((" { &self." + fld) + " }") true)
      }
      }
      wr.out((("fn " + acc) + "_mut(&mut self) -> &mut ") false)
      this.writeStructFieldType(pvar ctx wr)
      wr.out(((" { &mut self." + fld) + " }") true)
    }
  }

  fn rustClassIsShared:boolean (typeName:string ctx:RangerAppWriterContext) {
    if ((strlen typeName) == 0) {
      return false
    }
    if (ctx.hasCompilerFlag("rust-value-classes")) {
      return false
    }
    def typeClass@(optional):RangerAppClassDesc (ctx.findClass(typeName))
    if (null? typeClass) {
      return false
    }
    def tc:RangerAppClassDesc (unwrap typeClass)
    ; A union itself is Rc<dyn Any> already — never wrap it again. Its MEMBERS
    ; are marked shared by StaticAnalyzer.analyzeClassSharing, so they arrive
    ; here through rust_needs_ref_semantics like any other shared class.
    if tc.is_union {
      return false
    }
    return (tc.rust_needs_ref_semantics)
  }

  fn rustNeedsSelfRc:boolean (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext) {
    ; precomputed by StaticAnalyzer.computeSelfRcNeeds: the direct users of
    ; `this` as a value plus, transitively, every method that self-calls one
    return (fnDesc.rust_needs_self_rc)
  }

  fn rustEnclosingMethod:RangerAppFunctionDesc (fnDesc:RangerAppFunctionDesc) {
    def res:RangerAppFunctionDesc fnDesc
    def rounds:int 0
    while (res.is_lambda && (rounds < 30)) {
      rounds = rounds + 1
      if (null? res.insideFn) {
        return res
      }
      res = (unwrap res.insideFn)
    }
    return res
  }

  fn rustInitRcState:int (value:CodeNode ctx:RangerAppWriterContext) {
    ; A class that has subclasses is written as Rc<RefCell<dyn XTrait>>
    ; everywhere — the handle IS the type — so any value of one is already
    ; an owned Rc, whether it is a name, an element read or a call result.
    ; Only `new` hands back the bare struct.
    ; A NAME keeps its state-1 answer: it is a handle somebody else owns, and
    ; sharing it means cloning the Rc.
    if (value.expression && (value.hasNewOper == false)) {
      if (this.rustTypeIsOwnHandle((this.rustArgValueTypeName(value)) ctx)) {
        return 2
      }
    }
    if (value.expression == false) {
      ; `this` as a VALUE is written as __self_rc, which IS the owned Rc —
      ; wrapping it gave Rc<RefCell<Rc<RefCell<T>>>> at every site that
      ; passes or stores the receiver
      if (value.vref == "this") {
        def trCls@(optional):RangerAppClassDesc (ctx.getCurrentClass())
        if (!null? trCls) {
          def trC:RangerAppClassDesc (unwrap trCls)
          if (this.rustClassIsShared(trC.name ctx)) {
            return 2
          }
        }
      }
      if value.hasParamDesc {
        def ip:RangerAppParamDesc value.paramDesc
        if ip.rust_needs_rc_wrap {
          return 1
        }
      }
      return 0
    }
    ; a macro expansion can wrap its result in an extra pair of parens
    if ((array_length value.children) == 1) {
      def only:CodeNode (value.getFirst())
      ; …and a bare NAME in parens is still that name — `def ctx (in_ctx)`
      ; answered from the parens' evaluated type instead, which says "an
      ; owned Rc" and drops the clone the aliasing binding needs
      if (only.expression || (only.value_type == RangerNodeType.VRef)) {
        return (this.rustInitRcState(only ctx))
      }
    }
    ; a `new` produces the raw struct and still needs the wrap; any other
    ; expression whose value is a shared class — an element read, a map get,
    ; a call — already evaluates to an owned Rc under the flag
    if (value.hasNewOper == false) {
      if (this.rustClassIsShared(value.eval_type_name ctx)) {
        return 2
      }
    }
    ; a call that returns a shared class already hands out an owned Rc —
    ; but a `new` carries a call node of its own (the constructor) and still
    ; produces the raw struct
    if (value.hasFnCall && (value.hasNewOper == false)) {
      if (!null? value.fnDesc) {
        def cfd:RangerAppFunctionDesc (unwrap value.fnDesc)
        if (!null? cfd.nameNode) {
          def rt:CodeNode (unwrap cfd.nameNode)
          if (((strlen rt.array_type) == 0) && ((strlen rt.key_type) == 0)) {
            if (this.rustClassIsShared(rt.type_name ctx)) {
              return 2
            }
          }
        }
      }
    }
    if ((array_length value.children) >= 2) {
      def first:CodeNode (value.getFirst())
      if (first.vref == "unwrap") {
        def arg:CodeNode (value.getSecond())
        if arg.hasParamDesc {
          def pp:RangerAppParamDesc arg.paramDesc
          if (!null? pp.nameNode) {
            def nn:CodeNode (unwrap pp.nameNode)
            if (nn.hasFlag("weak")) {
              if (this.rustClassIsShared(nn.type_name ctx)) {
                return 2
              }
            }
            ; unwrap of a strong optional field of a shared class:
            ; .clone().unwrap() gives an owned Rc as well
            if pp.rust_needs_rc_wrap {
              if (((strlen nn.array_type) == 0) && ((strlen nn.key_type) == 0)) {
                return 2
              }
            }
          }
        }
      }
    }
    return 0
  }

  fn rustSelfRcParamType:string (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext) {
    if (null? fnDesc.container_class) {
      return ""
    }
    def scc:RangerAppClassDesc (unwrap fnDesc.container_class)
    def sccName:string scc.name
    if scc.is_extended_by_children {
      return (("dyn " + scc.name) + "Trait")
    }
    for scc.extends_classes sccP:string sccPi {
      if (ctx.isDefinedClass(sccP)) {
        def sccPC:RangerAppClassDesc (ctx.findClass(sccP))
        if sccPC.is_extended_by_children {
          if (has sccPC.defined_methods fnDesc.name) {
            sccName = (("dyn " + sccPC.name) + "Trait")
          }
        }
      }
    }
    return sccName
  }

  fn rustSelfRcCoerceTo:string (fc:CodeNode fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext) {
    def want:string (this.rustSelfRcParamType(fnDesc ctx))
    if ((strlen want) < 5) {
      return ""
    }
    if ((substring want 0 4) != "dyn ") {
      return ""
    }
    def nsLen:int (array_length fc.ns)
    if (nsLen < 2) {
      return ""
    }
    ; the class the receiver is declared as: `this` is the enclosing class,
    ; anything else is the desc of the segment the method hangs off
    def rcvType:string ""
    if (((itemAt fc.ns 0) == "this") && (nsLen == 2)) {
      def ccOpt@(optional):RangerAppClassDesc (ctx.getCurrentClass())
      if (null? ccOpt) {
        return ""
      }
      def ccCls:RangerAppClassDesc (unwrap ccOpt)
      rcvType = ccCls.name
    } {
      if ((array_length fc.nsp) < (nsLen - 1)) {
        return ""
      }
      def rcvD:RangerAppParamDesc (itemAt fc.nsp (nsLen - 2))
      def rcvNN@(optional):CodeNode rcvD.nameNode
      if (null? rcvNN) {
        return ""
      }
      def rcvN:CodeNode (unwrap rcvNN)
      if (((strlen rcvN.array_type) > 0) || ((strlen rcvN.key_type) > 0)) {
        return ""
      }
      rcvType = rcvN.type_name
    }
    if ((strlen rcvType) == 0) {
      return ""
    }
    ; a receiver that is ITSELF written as a trait object already has the
    ; declared type — nothing to coerce
    if (this.rustTypeIsOwnHandle(rcvType ctx)) {
      return ""
    }
    if ((this.rustClassIsShared(rcvType ctx)) == false) {
      return ""
    }
    return want
  }

  fn writeSelfRcReceiverArg:boolean (node:CodeNode fc:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (null? node.fnDesc) {
      rust_last_recv_tmp = ""
      return false
    }
    if ((this.rustNeedsSelfRc((unwrap node.fnDesc) ctx)) == false) {
      rust_last_recv_tmp = ""
      return false
    }
    ; the receiver was hoisted a moment ago: the same local IS the handle
    if ((strlen rust_last_recv_tmp) > 0) {
      wr.out(("&" + rust_last_recv_tmp) false)
      rust_last_recv_tmp = ""
      return true
    }
    def nsLen:int (array_length fc.ns)
    if (nsLen < 2) {
      ; the receiver is an expression the writer cannot name, so there is no
      ; Rc to pass; a silent skip would be a rustc error about a missing
      ; argument, so say what to do instead
      ctx.addError(node "This method stores `this`, so its Rust form needs the receiver's Rc. Bind the receiver to a variable first: def recv:T (expr) — then recv.method(...).")
      return false
    }
    def root:string (itemAt fc.ns 0)
    if ((root == "this") && (nsLen == 2)) {
      ; a self-call: the caller holds the Rc, because computeSelfRcNeeds
      ; marked it transitively. From a constructor there is no Rc to hold —
      ; the object is not in its cell yet — so the call cannot be written.
      def cm@(optional):RangerAppFunctionDesc (ctx.getCurrentMethod())
      if (!null? cm) {
        def cmf:RangerAppFunctionDesc (this.rustEnclosingMethod((unwrap cm)))
        if (cmf.rust_needs_self_rc == false) {
          ctx.addError(node "A method that stores `this` cannot be called from here on Rust: the constructor runs before the object is inside its Rc. Call it on the constructed value instead.")
          return false
        }
      }
      def selfCoerce:string (this.rustSelfRcCoerceTo(fc (unwrap node.fnDesc) ctx))
      if ((strlen selfCoerce) > 0) {
        wr.out((("&(__self_rc.clone() as Rc<RefCell<" + selfCoerce) + ">>)") false)
      } {
        wr.out("__self_rc" false)
      }
      return true
    }
    ; build the receiver path: a bare member roots at self, and a strong
    ; optional segment holds Option<Rc<…>> — reach the Rc with
    ; .as_ref().unwrap() so the hidden __self_rc argument is the live Rc
    ; `thisName`, not the literal "self": a constructor body calls its
    ; receiver `me`, and a hidden-argument path that said `self` there
    ; referred to the module keyword in a function with no self parameter.
    def path:string ""
    def segIdx:int 0
    if (root == "this") {
      path = (this.rustThisPathPrefix(ctx))
      segIdx = 1
    }
    while (segIdx < (nsLen - 1)) {
      def segName:string (this.adjustType((itemAt fc.ns segIdx)))
      def haveSegD:boolean false
      def segOptional:boolean false
      def segMember:boolean false
      ; the path descs can be missing — the front end fills `nsp` only where
      ; it resolved the whole path. A bare member name still answers from
      ; the class, and without it an `@(optional)` field went into the
      ; hidden argument as the Option rather than the Rc inside it.
      if ((array_length fc.nsp) <= segIdx) {
        if (segIdx == 0) {
          def fbClsO@(optional):RangerAppClassDesc (ctx.getCurrentClass())
          if (!null? fbClsO) {
            def fbCls:RangerAppClassDesc (unwrap fbClsO)
            def fbVarO@(optional):RangerAppParamDesc (fbCls.findVariable((itemAt fc.ns 0)))
            if (!null? fbVarO) {
              def fbVar:RangerAppParamDesc (unwrap fbVarO)
              segMember = true
              if fbVar.is_optional {
                def fbNNO@(optional):CodeNode fbVar.nameNode
                if (!null? fbNNO) {
                  def fbNN:CodeNode (unwrap fbNNO)
                  if (((strlen fbNN.array_type) == 0) && ((strlen fbNN.key_type) == 0)) {
                    segOptional = true
                  }
                }
              }
            }
          }
        }
      }
      if ((array_length fc.nsp) > segIdx) {
        def segD:RangerAppParamDesc (itemAt fc.nsp segIdx)
        haveSegD = true
        segMember = segD.is_class_variable
        ; the receiver itself is written through WriteVRef, which prefers the
        ; de-shadowed compiledName (`left` → `left_1`); the hidden-arg path
        ; must follow it or it names a variable that no longer exists (E0425)
        if ((strlen segD.compiledName) > 0) {
          segName = (this.adjustType(segD.compiledName))
        }
        ; a field reached through a parent-typed reference comes from the
        ; trait's accessor here as well — `dyn Trait` has no fields, so the
        ; bare name is "no field `nameNode` on type `dyn …Trait`" (E0609)
        if (this.rustSegThroughTrait(fc segIdx ctx)) {
          segName = ((this.rustFieldAccessorName(segD)) + "()")
        }
        if segD.is_optional {
          def sdNN@(optional):CodeNode segD.nameNode
          def segColl:boolean false
          if (!null? sdNN) {
            def sdN:CodeNode (unwrap sdNN)
            if (((strlen sdN.array_type) > 0) || ((strlen sdN.key_type) > 0)) {
              segColl = true
            }
          }
          if (segColl == false) {
            segOptional = true
          }
        }
      }
      if ((strlen path) == 0) {
        if segMember {
          path = (((this.rustThisPathPrefix(ctx)) + ".") + segName)
        } {
          path = segName
        }
      } {
        path = ((path + ".") + segName)
      }
      if segOptional {
        path = (path + ".as_ref().unwrap()")
      }
      ; a WEAK segment holds a Weak, and the hidden argument has to be a
      ; live Rc — `&self.compiler…parser.as_ref().unwrap()` was a `&&Weak`.
      ; The upgraded Rc is a temporary that lives to the end of the
      ; statement, which is as long as the call it is an argument to.
      if haveSegD {
        def segWkD:RangerAppParamDesc (itemAt fc.nsp segIdx)
        def segWkNN@(optional):CodeNode segWkD.nameNode
        if (!null? segWkNN) {
          def segWkN:CodeNode (unwrap segWkNN)
          if (segWkN.hasFlag("weak")) {
            ; only a FIELD holds a Weak — the same rule the path writer and
            ; the assignment side follow
            if segWkD.is_class_variable {
              if (((strlen segWkN.array_type) == 0) && ((strlen segWkN.key_type) == 0)) {
                path = (path + ".upgrade().unwrap()")
              }
            }
          }
        }
      }
      ; a segment that holds an Rc has to be borrowed before the next field
      ; is read out of it — the handle has no fields of its own. The Ref this
      ; makes lives to the end of the statement, which is exactly as long as
      ; the argument it is being built for.
      if (segIdx < (nsLen - 2)) {
        if haveSegD {
          def segRcD:RangerAppParamDesc (itemAt fc.nsp segIdx)
          if segRcD.rust_needs_rc_wrap {
            def segRcNN@(optional):CodeNode segRcD.nameNode
            if (!null? segRcNN) {
              def segRcN:CodeNode (unwrap segRcNN)
              ; a weak segment borrows too: the `.upgrade().unwrap()` written
              ; above already turned it back into an Rc, and a `@(weak)` local
              ; never held anything else
              if (((strlen segRcN.array_type) == 0) && ((strlen segRcN.key_type) == 0)) {
                path = (path + ".borrow()")
              }
            }
          }
        }
      }
      segIdx = segIdx + 1
    }
    def pathCoerce:string (this.rustSelfRcCoerceTo(fc (unwrap node.fnDesc) ctx))
    if ((strlen pathCoerce) > 0) {
      wr.out((((("&(" + path) + ".clone() as Rc<RefCell<") + pathCoerce) + ">>)") false)
    } {
      wr.out(("&" + path) false)
    }
    return true
  }

  fn writeRustReceiver:void (mutSelf:boolean wr:CodeWriter) {
    rust_receiver_written = true
    if mutSelf {
      wr.out("&mut self" false)
    } {
      wr.out("&self" false)
    }
  }

  fn writeTraitForwardArgs:void (variant:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter lead:boolean) {
    def wroteAny:boolean lead
    if (this.rustNeedsSelfRc(variant ctx)) {
      if wroteAny {
        wr.out(", " false)
      }
      wroteAny = true
      wr.out("__self_rc" false)
    }
    for variant.params arg:RangerAppParamDesc pi {
      if (arg.nameNode.hasFlag("keyword")) {
        continue
      }
      if wroteAny {
        wr.out(", " false)
      }
      wroteAny = true
      wr.out((this.adjustType(arg.compiledName)) false)
    }
  }

  fn writeSingletonAccessor:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    wr.newline()
    wr.out("pub fn __singleton(" false)
    def sgWritten:int 0
    if cl.has_constructor {
      def sgc@(optional):RangerAppFunctionDesc cl.constructor_fn
      if (!null? sgc) {
        def sgcF:RangerAppFunctionDesc (unwrap sgc)
        for sgcF.params arg:RangerAppParamDesc i {
          if (arg.nameNode.hasFlag("keyword")) {
            continue
          }
          if (sgWritten > 0) {
            wr.out(", " false)
          }
          sgWritten = sgWritten + 1
          wr.out((arg.name + " : ") false)
          def sgNameN:CodeNode (unwrap arg.nameNode)
          this.writeTypeDef(sgNameN ctx wr)
        }
      }
    }
    wr.out(((") -> Rc<RefCell<" + cl.name) + ">> {") true)
    wr.indent(1)
    wr.out(((("thread_local!(static __SINGLETON: RefCell<Option<Rc<RefCell<" + cl.name) + ">>>> = RefCell::new(None));")) true)
    wr.out("__SINGLETON.with(|s| {" true)
    wr.indent(1)
    wr.out("let mut slot = s.borrow_mut();" true)
    wr.out("if slot.is_none() {" true)
    wr.indent(1)
    wr.out((("*slot = Some(Rc::new(RefCell::new(" + cl.name) + "::new(") false)
    def sgFwd:int 0
    if cl.has_constructor {
      def sgc2@(optional):RangerAppFunctionDesc cl.constructor_fn
      if (!null? sgc2) {
        def sgc2F:RangerAppFunctionDesc (unwrap sgc2)
        for sgc2F.params arg:RangerAppParamDesc i {
          if (arg.nameNode.hasFlag("keyword")) {
            continue
          }
          if (sgFwd > 0) {
            wr.out(", " false)
          }
          sgFwd = sgFwd + 1
          wr.out(arg.name false)
        }
      }
    }
    wr.out("))));" true)
    wr.indent(-1)
    wr.out("}" true)
    wr.out("slot.as_ref().unwrap().clone()" true)
    wr.indent(-1)
    wr.out("})" true)
    wr.indent(-1)
    wr.out("}" true)
  }

  ; PLAN_RUST_SEMANTIC_IDIOMS I: is this trait one the Rust target turns into a
  ; real `trait`? Behaviour only — methods and no fields — and consumed by at
  ; least one class. A field-bearing trait stays the pure mixin it is on every
  ; other target: its fields are copied into each consumer and Rust has no
  ; associated fields to hold them.
  fn rustTraitIsInterface:boolean (name:string ctx:RangerAppWriterContext) {
    if ((strlen name) == 0) {
      return false
    }
    if ((ctx.isDefinedClass(name)) == false) {
      return false
    }
    def tc:RangerAppClassDesc (ctx.findClass(name))
    if (tc.is_trait == false) {
      return false
    }
    if ((array_length tc.variables) > 0) {
      return false
    }
    if ((array_length tc.methods) == 0) {
      return false
    }
    return tc.is_extended_by_children
  }

  ; --- native Rust enums (PLAN_RUST_SEMANTIC_IDIOMS F) ------------------------
  ; A Ranger `Enum` is an integer on every target, so `Color.Green` reaches the
  ; Rust file as the literal `1` and `colorName` takes an `i64`. The name is
  ; gone, which is the loudest "this was generated" tell in the gallery studies.
  ;
  ; It cannot simply become a Rust `enum`: Ranger source is free to do
  ; arithmetic on an enum, index an array with one, use one as a map key or
  ; round-trip one through @serialize, and a Rust enum supports none of those
  ; without a cast. So the decision is per enum and conservative — emit the
  ; native form only when every use in the program is one a Rust enum can carry,
  ; and keep the i64 lowering for the rest. `-strict-ownership` prints the
  ; verdict and its reason, the way the sharing verdicts do, so a fallback is
  ; visible rather than mysterious.
  ;
  ; The safe uses are: a declaration of that type, an `Enum.Member` reference,
  ; `==` / `!=` against something else of the same enum, an assignment whose
  ; other side is the same enum, a `switch`/`case`, and a `return`. Everything
  ; else — every operator not in that list, and every call whose parameter is
  ; not declared as this enum — is a fallback. When in doubt, i64.

  fn rustNodeIsEnumOf:boolean (node:CodeNode enumName:string ctx:RangerAppWriterContext) {
    if (node.eval_type == RangerNodeType.Enum) {
      if (node.type_name == enumName) {
        return true
      }
      if ((array_length node.ns) > 1) {
        def rootName:string (itemAt node.ns 0)
        if (rootName == enumName) {
          return true
        }
      }
      if (node.eval_type_name == enumName) {
        return true
      }
      if (node.hasParamDesc) {
        def pdNNe@(optional):CodeNode node.paramDesc.nameNode
        if (!null? pdNNe) {
          def pdNe:CodeNode (unwrap pdNNe)
          if (pdNe.type_name == enumName) {
            return true
          }
        }
      }
      ; an enum-typed node that names no enum at all: the writer cannot say
      ; WHICH enum it is, so it counts against every one of them. Answering
      ; "not this enum" here would let a genuinely unsafe use through, and the
      ; cost of answering "yes" is a fallback to the lowering we already had.
      if ((strlen node.type_name) == 0) {
        if ((strlen node.eval_type_name) == 0) {
          if ((array_length node.ns) < 2) {
            return true
          }
        }
      }
    }
    if (node.type_name == enumName) {
      return true
    }
    return false
  }

  ; The enum a node names, or "" when it names none.
  fn rustEnumNameOf:string (node:CodeNode ctx:RangerAppWriterContext) {
    ; `Color.Green` has the enum as its root; `node.eval_type` has an OBJECT as
    ; its root, and reading that as an enum name reported the variable as the
    ; enum being switched on. Only a root that is actually a declared enum
    ; counts.
    if ((array_length node.ns) > 1) {
      def rootN:string (itemAt node.ns 0)
      def re@(optional):RangerAppEnum ((ctx.getRoot()).getEnum(rootN))
      if (!null? re) {
        return rootN
      }
    }
    if ((strlen node.type_name) > 0) {
      return node.type_name
    }
    if ((strlen node.eval_type_name) > 0) {
      return node.eval_type_name
    }
    if (node.hasParamDesc) {
      def pdNNn@(optional):CodeNode node.paramDesc.nameNode
      if (!null? pdNNn) {
        def pdNn:CodeNode (unwrap pdNNn)
        return pdNn.type_name
      }
    }
    return ""
  }

  ; Every enum named by a `case` label inside this switch body.
  fn rustCollectCaseEnums:void (node:CodeNode found:[string:boolean]) {
    if node.expression {
      if ((array_length node.children) > 1) {
        def h:CodeNode (node.getFirst())
        if (h.vref == "case") {
          def lbl:CodeNode (node.getSecond())
          if ((array_length lbl.ns) > 1) {
            set found (itemAt lbl.ns 0) true
          }
        }
      }
    }
    for node.children ch:CodeNode i {
      this.rustCollectCaseEnums(ch found)
    }
  }

  ; The operators an enum-typed operand may appear under. `switch` and `case`
  ; carry the scrutinee and the labels; `=`, `def` and `return` place a value
  ; into a slot that was declared with the type.
  fn rustEnumOperandIsSafe:boolean (headVref:string) {
    if (headVref == "==") { return true }
    if (headVref == "!=") { return true }
    if (headVref == "=") { return true }
    if (headVref == "def") { return true }
    if (headVref == "switch") { return true }
    if (headVref == "case") { return true }
    if (headVref == "return") { return true }
    return false
  }

  ; Walks one function body. Answers the first reason this enum cannot be
  ; native, or "" when it found none.
  fn rustEnumUnsafeReason:string (node:CodeNode enumName:string ctx:RangerAppWriterContext) {
    if node.expression {
      if ((array_length node.children) > 0) {
        def head:CodeNode (node.getFirst())
        def hv:string head.vref
        ; A `switch` whose case labels name a DIFFERENT enum than the scrutinee
        ; compiles today only because both sides are integers and the members
        ; happen to line up. `RangerAppParamDesc.getVarTypeName` in this very
        ; compiler switches on a `RangerNodeRefType` field and labels its arms
        ; `RangerContextVarType.NoType` / `.This` — the second arm means `Weak`.
        ; A Rust enum has no such coincidence, so neither enum can be native.
        if (hv == "switch") {
          if ((array_length node.children) > 1) {
            def scrut:CodeNode (node.getSecond())
            def scrutEnum:string (this.rustEnumNameOf(scrut ctx))
            def caseEnums:[string:boolean]
            this.rustCollectCaseEnums(node caseEnums)
            for (keys caseEnums) ce:string cei {
              if (ce != scrutEnum) {
                if ((ce == enumName) || (scrutEnum == enumName)) {
                  return (("switched on `" + scrutEnum) + ("` with a `" + ce) + "` case label")
                }
              }
            }
          }
        }
        if ((this.rustEnumOperandIsSafe(hv)) == false) {
          for node.children ch:CodeNode ci {
            if (ci > 0) {
              if (this.rustNodeIsEnumOf(ch enumName ctx)) {
                if ((strlen hv) == 0) {
                  return "used as a call receiver or argument"
                }
                return ("used under `" + hv + "`")
              }
            }
          }
        }
      }
    }
    for node.children ch2:CodeNode ci2 {
      def sub:string (this.rustEnumUnsafeReason(ch2 enumName ctx))
      if ((strlen sub) > 0) {
        return sub
      }
    }
    return ""
  }

  fn rustComputeNativeEnums:void (ctx:RangerAppWriterContext) {
    if rustNativeEnumsDone {
      return
    }
    rustNativeEnumsDone = true
    def root:RangerAppWriterContext (ctx.getRoot())
    def diag:boolean (ctx.hasCompilerFlag("strict-ownership"))
    for (keys root.definedEnums) ename:string ei {
      def reason:string ""
      for root.definedClasses cl:RangerAppClassDesc ci {
        if ((strlen reason) > 0) {
          continue
        }
        if ((((cl.is_system || cl.is_trait) || cl.is_template) || cl.is_operator_class) || cl.is_union) {
          continue
        }
        ; a serialized class reads and writes its fields as JSON numbers, and a
        ; Rust enum is not a number there
        if (cl.is_serialized) {
          for cl.variables sv:RangerAppParamDesc svi {
            def svNN@(optional):CodeNode sv.nameNode
            if (!null? svNN) {
              def svN:CodeNode (unwrap svNN)
              if (svN.type_name == ename) {
                reason = "a field of an @serialize class"
              }
            }
          }
        }
        reason = (this.rustScanEnumFns(cl.methods ename ctx reason))
        reason = (this.rustScanEnumFns(cl.static_methods ename ctx reason))
      }
      if ((strlen reason) == 0) {
        set rustNativeEnums ename true
        if diag {
          print (("enum[rust] " + ename) + " -> Rust enum")
        }
      } {
        if diag {
          print (((("enum[rust] " + ename) + " -> i64 (") + reason) + ")")
        }
      }
    }
  }

  fn rustScanEnumFns:string (fns:[RangerAppFunctionDesc] enumName:string ctx:RangerAppWriterContext reasonIn:string) {
    def reason:string reasonIn
    for fns m:RangerAppFunctionDesc mi {
      if ((strlen reason) > 0) {
        return reason
      }
      def mNodeOpt@(optional):CodeNode m.node
      if (null? mNodeOpt) {
        continue
      }
      def mNode:CodeNode (unwrap mNodeOpt)
      reason = (this.rustEnumUnsafeReason(mNode enumName ctx))
    }
    return reason
  }

  fn rustEnumIsNative:boolean (enumName:string ctx:RangerAppWriterContext) {
    if ((strlen enumName) == 0) {
      return false
    }
    this.rustComputeNativeEnums(ctx)
    if (has rustNativeEnums enumName) {
      return true
    }
    return false
  }

  ; --- reachability of the header helpers (PLAN_RUST_SEMANTIC_IDIOMS G) -------
  ; The map preamble and the character-indexing string helpers used to be
  ; written into every file. On study 07 of gallery/friendly that is 16 lines of
  ; Ranger and 195 of Rust, 140 of them `RgOrderedMap` / `FxHasher` the binary
  ; never calls. They are emitted now only when the program can reach them.
  ;
  ; The question for the map is "does a hash type appear anywhere": a Ranger map
  ; is always spelled with a key type, on a field, a parameter, a return or a
  ; local, so a node carrying a `key_type` is the signal and there is no way to
  ; hold one without writing it down. The question for the string helpers is
  ; which operators lower to them — three, listed below.
  ;
  ; Both scans err towards emitting: a helper written and unused is a
  ; `dead_code` allow the header already carries, a helper missing is a program
  ; that does not build.
  fn rustNodeUsesHash:boolean (node:CodeNode) {
    if ((strlen node.key_type) > 0) {
      return true
    }
    ; a `def m:[string:int]` local is rewritten by CollectMethods into
    ; `new Map@(string int)` with value_type VRef, so the key_type is no longer
    ; on the name node by the time a writer sees it — the class name is.
    if (node.type_name == "Map") {
      return true
    }
    if (node.value_type == RangerNodeType.Hash) {
      return true
    }
    if (node.eval_type == RangerNodeType.Hash) {
      return true
    }
    if (node.hasParamDesc) {
      def pdNN@(optional):CodeNode node.paramDesc.nameNode
      if (!null? pdNN) {
        def pdN:CodeNode (unwrap pdNN)
        if ((strlen pdN.key_type) > 0) {
          return true
        }
      }
    }
    for node.children ch:CodeNode i {
      if (this.rustNodeUsesHash(ch)) {
        return true
      }
    }
    return false
  }

  fn rustNodeUsesStringIndex:boolean (node:CodeNode) {
    def v:string node.vref
    if ((((v == "indexOf") || (v == "indexOfFrom")) || (v == "lastIndexOf"))) {
      return true
    }
    for node.children ch:CodeNode i {
      if (this.rustNodeUsesStringIndex(ch)) {
        return true
      }
    }
    return false
  }

  ; 0 = neither, 1 = maps only, 2 = string index only, 3 = both.
  fn rustHeaderHelperNeeds:int (ctx:RangerAppWriterContext) {
    def res:int 0
    def root:RangerAppWriterContext (ctx.getRoot())
    for root.definedClasses cl:RangerAppClassDesc ci {
      ; a class the file never writes cannot reach a helper. The operator and
      ; template classes of Lang.rgr / stdops.rgr declare maps all over, and
      ; counting them meant every program "needed" the map preamble — which is
      ; how it came to be in every file in the first place.
      ; the same "this class is not written to the file" set the Weak scan uses,
      ; minus is_generic_instance — a `Stack@(int)` IS written and may hold a
      ; map. `Map` itself is a trait class here, which is why an unfiltered scan
      ; said every program needed the preamble: that is how it came to be in
      ; every file in the first place.
      if ((((cl.is_system || cl.is_trait) || cl.is_template) || cl.is_operator_class) || cl.is_union) {
        continue
      }
      for cl.variables cv:RangerAppParamDesc cvi {
        def cvNN@(optional):CodeNode cv.nameNode
        if (!null? cvNN) {
          def cvN:CodeNode (unwrap cvNN)
          if ((strlen cvN.key_type) > 0) {
            if ((res == 0) || (res == 2)) {
              res = (res + 1)
            }
          }
        }
      }
      res = (this.rustScanFnList(cl.methods res))
      ; `sfn` lands in static_methods, not methods, and a program whose only
      ; entry point is `sfn m@(main)` has an EMPTY methods list — which is how
      ; the first version of this scan answered "no map" for a program that is
      ; nothing but a map.
      res = (this.rustScanFnList(cl.static_methods res))
      if (res == 3) {
        return 3
      }
    }
    return res
  }

  fn rustScanFnList:int (fns:[RangerAppFunctionDesc] resIn:int) {
    def res:int resIn
    for fns m:RangerAppFunctionDesc mi {
      if (res == 3) {
        return 3
      }
      def mNodeOpt@(optional):CodeNode m.node
      if (null? mNodeOpt) {
        continue
      }
      def mNode:CodeNode (unwrap mNodeOpt)
      if ((res == 0) || (res == 2)) {
        if (this.rustNodeUsesHash(mNode)) {
          res = (res + 1)
        }
      }
      if ((res == 0) || (res == 1)) {
        if (this.rustNodeUsesStringIndex(mNode)) {
          res = (res + 2)
        }
      }
    }
    return res
  }

  fn writeClass (node:CodeNode ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def ucl@(optional):RangerAppClassDesc node.clDesc
    if (null? ucl) {
      return
    }
    def cl:RangerAppClassDesc (unwrap ucl)
    
    ; Save previous class and set current class for self-referential type detection
    def prevClass@(optional):RangerAppClassDesc (ctx.getCurrentClass())
    ctx.setCurrentClass(cl)
    
    def wr:CodeWriter orig_wr
    
    ; Write file header with allow directives for common warnings.
    ; The lines go into the "before_imports" slice: an inner attribute (#![..])
    ; has to precede every item in the file, and an (imp "...") from an operator
    ; template writes a `use` line ahead of the class content. Written here they
    ; ended up after that line and rustc rejected the file.
    if (fileHeaderWritten == false) {
      def header:CodeWriter (wr.getTag("before_imports"))
      ; which of the two header helper families this program can reach
      def helperNeeds:int (this.rustHeaderHelperNeeds(ctx))
      ; …and which Ranger `Enum`s survive as Rust enums, whose declarations go
      ; into the header before anything can name one
      this.rustComputeNativeEnums(ctx)
      def needsMap:boolean ((helperNeeds == 1) || (helperNeeds == 3))
      def needsStrIndex:boolean ((helperNeeds == 2) || (helperNeeds == 3))
      header.out("#![allow(unused_parens)]" true)
      header.out("#![allow(unused_mut)]" true)
      header.out("#![allow(unused_variables)]" true)
      header.out("#![allow(unused_assignments)]" true)
      header.out("#![allow(non_snake_case)]" true)
      header.out("#![allow(dead_code)]" true)
      header.out("// The clippy allows below cover shapes that mirror the Ranger source" true)
      header.out("// itself - statement-level clamp chains, nested ifs, function arity and" true)
      header.out("// type names - which the transpiler must not rewrite or rename." true)
      header.out("#![allow(clippy::manual_clamp)]" true)
      header.out("#![allow(clippy::collapsible_if)]" true)
      header.out("#![allow(clippy::too_many_arguments)]" true)
      header.out("#![allow(clippy::upper_case_acronyms)]" true)
      ; ptr_arg still fires on borrowed COLLECTION params (&Vec<T> of
      ; non-scalar elements); borrowed strings are &str already
      header.out("#![allow(clippy::ptr_arg)]" true)
      header.out("" true)
      header.out("use std::rc::Rc;" true)
      ; Weak only reaches the output through a @(weak) field; without one
      ; the use line is rustc's unused_imports warning on every file
      def anyWeakField:boolean false
      def hdrRoot:RangerAppWriterContext (ctx.getRoot())
      for hdrRoot.definedClasses hcl:RangerAppClassDesc hci {
        def hclSpecial:boolean (((((hcl.is_system || hcl.is_trait) || hcl.is_template) || hcl.is_operator_class) || hcl.is_generic_instance) || hcl.is_union)
        if (hclSpecial == false) {
          for hcl.variables hv:RangerAppParamDesc hvi {
            def hvNN@(optional):CodeNode hv.nameNode
            if (!null? hvNN) {
              def hvN:CodeNode (unwrap hvNN)
              if (hvN.hasFlag("weak")) {
                anyWeakField = true
              }
            }
          }
        }
      }
      if anyWeakField {
        header.out("use std::rc::Weak;" true)
      }
      header.out("use std::cell::RefCell;" true)
      ; …but `Cell` is NOT imported. A program is free to declare a class of
      ; its own by that name, and the import made the two collide — `struct
      ; Cell` against `use std::cell::Cell` is "the name `Cell` is defined
      ; multiple times", and every later mention resolved to the std type
      ; instead ("field `value` is private", "missing generics"). The interior
      ; cell spells the std type in full at its two use sites, as the pool
      ; header already does with UnsafeCell, so nothing is brought into scope
      ; to be shadowed. It also drops an unused-import warning from every
      ; generated program that has no interior cell at all.
      header.out("" true)
      ; D-UNION (PLAN_SHAPES.md S5): a union is a real Rust enum, one variant
      ; per member, each holding that member's cell. A `case` narrowing is then
      ; an `if let` on the tag — no trait object, no downcast, and a closed set
      ; the compiler can see. The enum is `Clone` because a union value passes
      ; as a clone of the handle, exactly as the Rc did.
      ;
      ; `Any` is the compiler's own union of every declared class, so it is not
      ; written: the enum would name every class in the program.
      ; PLAN_RUST_SEMANTIC_IDIOMS I: the `trait NamedTrait { … }` for every
      ; behaviour-only Ranger trait something consumes. A parent class with
      ; subclasses gets its declaration from writeClass, but a `trait` class is
      ; never written to the file on any target — so this one is emitted here,
      ; from the same descs and with the same receiver rules, before anything
      ; can name it. The consumers' `impl`s come from writeClass, alongside the
      ; ones a subclass gets for its parent.
      def hdrTraitRoot:RangerAppWriterContext (ctx.getRoot())
      for hdrTraitRoot.definedClassList htName:string hti {
        if (this.rustTraitIsInterface(htName ctx)) {
          def htc:RangerAppClassDesc (hdrTraitRoot.findClass(htName))
          header.out("" true)
          header.out(("pub trait " + htName + "Trait: RgAnyRef {") true)
          header.indent(1)
          this.rustFillTraitMutations(htc ctx)
          for htc.defined_variants htVar:string htvi {
            def htVs:RangerAppMethodVariants (get htc.method_variants htVar)
            for htVs.variants htv:RangerAppFunctionDesc htvj {
              header.out(("fn " + (this.adjustType(htv.name)) + "(") false)
              this.writeRustReceiver((has htc.rust_trait_mut htv.name) header)
              rust_in_trait_decl = true
              this.writeArgsDef(htv ctx header)
              rust_in_trait_decl = false
              this.writeRustFnClose(htv ctx header)
              header.out(";" true)
            }
          }
          header.indent(-1)
          header.out("}" true)
        }
      }

      ; PLAN_RUST_SEMANTIC_IDIOMS F: a Ranger `Enum` whose every use a Rust enum
      ; can carry is written as one. #[repr(i64)] with explicit discriminants
      ; keeps the integer representation exact, so `Color::Green as i64` is
      ; still 1 and nothing downstream has to know which form it got.
      def hdrEnumRoot:RangerAppWriterContext (ctx.getRoot())
      def anyNativeEnum:boolean false
      for (keys hdrEnumRoot.definedEnums) hen:string hei {
        if (this.rustEnumIsNative(hen ctx)) {
          def heDef:RangerAppEnum (unwrap (get hdrEnumRoot.definedEnums hen))
          header.out("#[repr(i64)]" true)
          header.out("#[derive(Clone, Copy, PartialEq, Eq, Debug)]" true)
          header.out(("pub enum " + hen + " {") true)
          for (keys heDef.values) hmn:string hmi {
            def hmv:int (unwrap (get heDef.values hmn))
            def heLine:string ((("    " + hmn) + " = ") + (to_string hmv))
            header.out((heLine + ",") true)
          }
          header.out("}" true)
          anyNativeEnum = true
        }
      }
      if anyNativeEnum {
        header.out("" true)
      }
      def unionNames:[string] (this.sealableUnionNames(ctx))
      for unionNames uname:string uni {
        def ucl:RangerAppClassDesc (hdrRoot.findClass(uname))
        header.out("#[derive(Clone)]" true)
        header.out(("pub enum " + (this.unionInterfaceName(uname)) + " {") true)
        for ucl.is_union_of mname:string mi {
          ; a case that holds only scalars rides INSIDE the variant — no cell,
          ; no allocation; a reference case keeps its Rc<RefCell<T>>
          if (this.rustClassIsShared(mname ctx)) {
            header.out(("    " + mname + "(Rc<RefCell<" + mname + ">>),") true)
          } {
            header.out(("    " + mname + "(" + mname + "),") true)
          }
        }
        header.out("}" true)
      }
      ; --- identity of a value of the family --------------------------------
      ; `identical` asks whether two names hold the same object. On this target
      ; that was `Rc::ptr_eq`, which an enum cannot be handed — so the operator
      ; did not build at all for a value of a closed family. It goes through a
      ; trait instead, so the same spelling serves both a shared class and a
      ; family, and the answer follows the family's own split: a reference case
      ; is the same object, a value case has no object to share (it rides
      ; inside the tag) and answers on its content.
      ; the trait is written for every program: `identical` on a plain shared
      ; class goes through it too, so one spelling serves both
      ; A Ranger `cast` from a parent-typed handle down to a subclass one.
      ; Rust has no dynamic_pointer_cast: Rc<RefCell<dyn Trait>> and
      ; Rc<RefCell<Concrete>> are different pointer shapes, so the conversion
      ; checks the concrete type through Any and then rebuilds the Rc around
      ; the same allocation — which is what Rc::<dyn Any>::downcast does in
      ; std. Every generated trait carries RgAnyRef so the check is available
      ; whatever the trait object is.
      header.out("pub trait RgAnyRef { fn rg_as_any(&self) -> &dyn std::any::Any; }" true)
      header.out("fn rg_downcast<T: 'static, D: ?Sized + RgAnyRef>(v: &Rc<RefCell<D>>) -> Rc<RefCell<T>> {" true)
      header.out("    assert!(v.borrow().rg_as_any().is::<T>(), \"invalid downcast\");" true)
      header.out("    let p = Rc::into_raw(v.clone()) as *const () as *const RefCell<T>;" true)
      header.out("    unsafe { Rc::from_raw(p) }" true)
      header.out("}" true)
      header.out("pub trait RgIdentical { fn rg_identical(&self, other: &Self) -> bool; }" true)
      header.out("impl<T: ?Sized> RgIdentical for Rc<RefCell<T>> {" true)
      header.out("    fn rg_identical(&self, other: &Self) -> bool { Rc::ptr_eq(self, other) }" true)
      header.out("}" true)
      if ((array_length unionNames) > 0) {
        for unionNames uname:string uni2 {
          def ucl2:RangerAppClassDesc (hdrRoot.findClass(uname))
          def ename:string (this.unionInterfaceName(uname))
          header.out((("impl RgIdentical for " + ename) + " {") true)
          header.out("    fn rg_identical(&self, other: &Self) -> bool {" true)
          header.out("        match (self, other) {" true)
          for ucl2.is_union_of mname2:string mi2 {
            if (this.rustClassIsShared(mname2 ctx)) {
              def armS:string ((("            (" + ename) + "::") + mname2) + "(a), "
              armS = ((((armS + ename) + "::") + mname2) + "(b)) => Rc::ptr_eq(a, b),")
              header.out(armS true)
            } {
              def armV:string ((("            (" + ename) + "::") + mname2) + "(a), "
              armV = ((((armV + ename) + "::") + mname2) + "(b)) => a == b,")
              header.out(armV true)
            }
          }
          header.out("            _ => false," true)
          header.out("        }" true)
          header.out("    }" true)
          header.out("}" true)
        }
      }
      if ((array_length unionNames) > 0) {
        header.out("" true)
      }
      if (ctx.hasCompilerFlag("native-fast-alloc")) {
        header.out("// -native-fast-alloc: thread-local size-class freelist over the system" true)
        header.out("// allocator. Interpreter-style workloads spend a third of their time in" true)
        header.out("// malloc/free; freed blocks park in per-size lists (32-byte classes up" true)
        header.out("// to 1024 bytes) and are handed straight back. Memory is never returned" true)
        header.out("// to the OS - fine for a benchmark or tool process, wrong for a daemon." true)
        header.out("struct RgPoolAlloc;" true)
        header.out("const RG_POOL_CLASSES: usize = 32;" true)
        header.out("std::thread_local! {" true)
        header.out("    static RG_POOL_HEADS: std::cell::UnsafeCell<[usize; RG_POOL_CLASSES + 1]> =" true)
        header.out("        const { std::cell::UnsafeCell::new([0usize; RG_POOL_CLASSES + 1]) };" true)
        header.out("}" true)
        header.out("#[allow(unused_unsafe)]" true)
        header.out("unsafe impl std::alloc::GlobalAlloc for RgPoolAlloc {" true)
        header.out("    unsafe fn alloc(&self, layout: std::alloc::Layout) -> *mut u8 {" true)
        header.out("        let size = layout.size();" true)
        header.out("        if size > 0 && size <= 1024 && layout.align() <= 16 {" true)
        header.out("            let class = (size + 31) >> 5;" true)
        header.out("            let took = RG_POOL_HEADS.try_with(|h| {" true)
        header.out("                let heads = unsafe { &mut *h.get() };" true)
        header.out("                let head = heads[class];" true)
        header.out("                if head != 0 {" true)
        header.out("                    heads[class] = unsafe { *(head as *mut usize) };" true)
        header.out("                    return head as *mut u8;" true)
        header.out("                }" true)
        header.out("                std::ptr::null_mut()" true)
        header.out("            });" true)
        header.out("            if let Ok(p) = took {" true)
        header.out("                if !p.is_null() {" true)
        header.out("                    return p;" true)
        header.out("                }" true)
        header.out("            }" true)
        header.out("            let l = unsafe { std::alloc::Layout::from_size_align_unchecked(class << 5, 16) };" true)
        header.out("            return unsafe { std::alloc::System.alloc(l) };" true)
        header.out("        }" true)
        header.out("        unsafe { std::alloc::System.alloc(layout) }" true)
        header.out("    }" true)
        header.out("    unsafe fn dealloc(&self, ptr: *mut u8, layout: std::alloc::Layout) {" true)
        header.out("        let size = layout.size();" true)
        header.out("        if size > 0 && size <= 1024 && layout.align() <= 16 {" true)
        header.out("            let class = (size + 31) >> 5;" true)
        header.out("            let parked = RG_POOL_HEADS.try_with(|h| {" true)
        header.out("                let heads = unsafe { &mut *h.get() };" true)
        header.out("                unsafe { *(ptr as *mut usize) = heads[class] };" true)
        header.out("                heads[class] = ptr as usize;" true)
        header.out("            });" true)
        header.out("            if parked.is_ok() {" true)
        header.out("                return;" true)
        header.out("            }" true)
        header.out("            let l = unsafe { std::alloc::Layout::from_size_align_unchecked(class << 5, 16) };" true)
        header.out("            unsafe { std::alloc::System.dealloc(ptr, l) };" true)
        header.out("            return;" true)
        header.out("        }" true)
        header.out("        unsafe { std::alloc::System.dealloc(ptr, layout) }" true)
        header.out("    }" true)
        header.out("}" true)
        header.out("#[global_allocator]" true)
        header.out("static RG_POOL_ALLOC: RgPoolAlloc = RgPoolAlloc;" true)
        header.out("" true)
      }
      if needsMap {
        header.out("// FxHash (rustc-hash style): these maps are keyed by short program" true)
        header.out("// strings; SipHash's DoS resistance cost ~14% of all instructions in" true)
        header.out("// map-heavy code. Swap back to std's default by deleting the alias." true)
        header.out("#[derive(Default, Clone)]" true)
        header.out("struct FxHasher { hash: u64 }" true)
        header.out("impl std::hash::Hasher for FxHasher {" true)
        header.out("    #[inline]" true)
        header.out("    fn write(&mut self, bytes: &[u8]) {" true)
        header.out("        const SEED: u64 = 0x517cc1b727220a95;" true)
        header.out("        let mut b = bytes;" true)
        header.out("        while b.len() >= 8 {" true)
        header.out("            let v = u64::from_le_bytes([b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]]);" true)
        header.out("            self.hash = (self.hash.rotate_left(5) ^ v).wrapping_mul(SEED);" true)
        header.out("            b = &b[8..];" true)
        header.out("        }" true)
        header.out("        for &x in b {" true)
        header.out("            self.hash = (self.hash.rotate_left(5) ^ (x as u64)).wrapping_mul(SEED);" true)
        header.out("        }" true)
        header.out("    }" true)
        header.out("    #[inline]" true)
        header.out("    fn finish(&self) -> u64 { self.hash }" true)
        header.out("}" true)
        header.out("// Insertion-ordered map (mirrors the C++ rg_ordered_map): entries in a" true)
        header.out("// vector plus an open-addressed FxHash index. Lookups hash once; keys()" true)
        header.out("// iterates in INSERTION order, which is what JS key enumeration needs." true)
        header.out("// Aliased over the HashMap name so declarations stay untouched." true)
        header.out("#[derive(Clone)]" true)
        header.out("struct RgOrderedMap<K, V> {" true)
        header.out("    entries: Vec<(K, V)>," true)
        header.out("    index: Vec<i32>," true)
        header.out("}" true)
        header.out("impl<K, V> Default for RgOrderedMap<K, V> {" true)
        header.out("    fn default() -> Self { RgOrderedMap { entries: Vec::new(), index: Vec::new() } }" true)
        header.out("}" true)
        ; `for (k, v) in map` is how the hash form of the for loop is written,
        ; and it needs the map to be iterable. Insertion order is the order the
        ; entries are held in, which is the order every other target walks a
        ; Ranger hash in.
        header.out("impl<K, V> IntoIterator for RgOrderedMap<K, V> {" true)
        header.out("    type Item = (K, V);" true)
        header.out("    type IntoIter = std::vec::IntoIter<(K, V)>;" true)
        header.out("    fn into_iter(self) -> Self::IntoIter { self.entries.into_iter() }" true)
        header.out("}" true)
        header.out("impl<'a, K, V> IntoIterator for &'a RgOrderedMap<K, V> {" true)
        header.out("    type Item = &'a (K, V);" true)
        header.out("    type IntoIter = std::slice::Iter<'a, (K, V)>;" true)
        header.out("    fn into_iter(self) -> Self::IntoIter { self.entries.iter() }" true)
        header.out("}" true)
        header.out("impl<K: std::hash::Hash + Eq, V> RgOrderedMap<K, V> {" true)
        header.out("    fn rg_hash<Q: std::hash::Hash + ?Sized>(k: &Q) -> u64 {" true)
        header.out("        let mut h = FxHasher::default();" true)
        header.out("        k.hash(&mut h);" true)
        header.out("        std::hash::Hasher::finish(&h)" true)
        header.out("    }" true)
        header.out("    fn slot<Q>(&self, k: &Q) -> i32 where K: std::borrow::Borrow<Q>, Q: std::hash::Hash + Eq + ?Sized {" true)
        header.out("        if self.index.is_empty() { return -1; }" true)
        header.out("        let mask = self.index.len() - 1;" true)
        header.out("        let mut h = (Self::rg_hash(k) as usize) & mask;" true)
        header.out("        loop {" true)
        header.out("            let s = self.index[h];" true)
        header.out("            if s == -1 { return -1; }" true)
        header.out("            if self.entries[s as usize].0.borrow() == k { return s; }" true)
        header.out("            h = (h + 1) & mask;" true)
        header.out("        }" true)
        header.out("    }" true)
        header.out("    fn rehash(&mut self) {" true)
        header.out("        let mut cap = 8usize;" true)
        header.out("        while cap < (self.entries.len() + 1) * 2 { cap <<= 1; }" true)
        header.out("        self.index.clear();" true)
        header.out("        self.index.resize(cap, -1);" true)
        header.out("        for i in 0..self.entries.len() {" true)
        header.out("            let mut h = (Self::rg_hash(&self.entries[i].0) as usize) & (cap - 1);" true)
        header.out("            while self.index[h] != -1 { h = (h + 1) & (cap - 1); }" true)
        header.out("            self.index[h] = i as i32;" true)
        header.out("        }" true)
        header.out("    }" true)
        header.out("    fn insert(&mut self, k: K, v: V) -> Option<V> {" true)
        header.out("        let s = self.slot(&k);" true)
        header.out("        if s != -1 { return Some(std::mem::replace(&mut self.entries[s as usize].1, v)); }" true)
        header.out("        self.entries.push((k, v));" true)
        header.out("        if self.index.is_empty() || (self.entries.len() + 1) * 2 > self.index.len() {" true)
        header.out("            self.rehash();" true)
        header.out("        } else {" true)
        header.out("            let mask = self.index.len() - 1;" true)
        header.out("            let mut h = (Self::rg_hash(&self.entries[self.entries.len() - 1].0) as usize) & mask;" true)
        header.out("            while self.index[h] != -1 { h = (h + 1) & mask; }" true)
        header.out("            self.index[h] = (self.entries.len() - 1) as i32;" true)
        header.out("        }" true)
        header.out("        None" true)
        header.out("    }" true)
        header.out("    fn get<Q>(&self, k: &Q) -> Option<&V> where K: std::borrow::Borrow<Q>, Q: std::hash::Hash + Eq + ?Sized {" true)
        header.out("        let s = self.slot(k);" true)
        header.out("        if s == -1 { None } else { Some(&self.entries[s as usize].1) }" true)
        header.out("    }" true)
        header.out("    fn contains_key<Q>(&self, k: &Q) -> bool where K: std::borrow::Borrow<Q>, Q: std::hash::Hash + Eq + ?Sized {" true)
        header.out("        self.slot(k) != -1" true)
        header.out("    }" true)
        header.out("    fn keys(&self) -> impl Iterator<Item = &K> { self.entries.iter().map(|e| &e.0) }" true)
        header.out("    fn len(&self) -> usize { self.entries.len() }" true)
        header.out("    fn clear(&mut self) {" true)
        header.out("        self.entries.clear();" true)
        header.out("        for s in self.index.iter_mut() { *s = -1; }" true)
        header.out("    }" true)
        header.out("}" true)
        header.out("type HashMap<K, V> = RgOrderedMap<K, V>;" true)
      }
      ; Every other string operator on this target counts CHARACTERS:
      ; `strlen` is chars().count(), `charAt` is chars().nth(), `substring`
      ; skips and takes characters. `str::find` counts BYTES, so an
      ; `indexOf` handed straight to `charAt` pointed past the character it
      ; found the moment anything non-ASCII stood before it. An OOXML parser
      ; reading a slide with "Hameenlinna" spelled with an umlaut in it
      ; sliced the rest of the document one byte short per accent and
      ; dropped every shape after the first. These three do the conversion
      ; once, in one place.
      if needsStrIndex {
        header.out("fn rg_index_of(s: &str, key: &str) -> i64 {" true)
        header.out("    match s.find(key) { Some(b) => s[..b].chars().count() as i64, None => -1 }" true)
        header.out("}" true)
        header.out("fn rg_index_of_from(s: &str, key: &str, start: i64) -> i64 {" true)
        header.out("    if start <= 0 { return rg_index_of(s, key); }" true)
        header.out("    let b0 = match s.char_indices().nth(start as usize) { Some((b, _)) => b, None => return -1 };" true)
        header.out("    match s[b0..].find(key) { Some(b) => start + s[b0..b0 + b].chars().count() as i64, None => -1 }" true)
        header.out("}" true)
        header.out("fn rg_last_index_of(s: &str, key: &str) -> i64 {" true)
        header.out("    match s.rfind(key) { Some(b) => s[..b].chars().count() as i64, None => -1 }" true)
        header.out("}" true)
      }
      header.out("" true)
      ; receiver-mutability pre-pass: every plain class method's
      ; &self / &mut self verdict lands on its desc BEFORE any emission,
      ; so call sites in earlier-emitted classes borrow the receiver's
      ; cell in the matching mode. Trait-related classes keep the
      ; conservative default (&mut) — their emission special-cases.
      ;
      ; It runs to a FIXPOINT. A method that calls a mutating method on a
      ; field mutates through this struct too, and the answer for the
      ; field's class is not settled when the class holding the field is
      ; read — so the first pass answers the old question, and every
      ; further pass may only turn a `&self` into a `&mut self`. That is
      ; monotone, so it converges; the round cap is a backstop, not a plan.
      def mutPass:int 0
      def mutChanged:boolean true
      while ((mutPass < 12) && mutChanged) {
        mutChanged = false
        rust_field_call_mut_ready = (mutPass > 0)
        ; the family answer is cached on the trait root, and this pass is
        ; about to ask it again with more known
        if (mutPass > 0) {
          for hdrRoot.definedClasses rcl:RangerAppClassDesc rci {
            rcl.rust_trait_mut_ready = false
          }
        }
      for hdrRoot.definedClasses mcl:RangerAppClassDesc mci {
        def mclSpecial:boolean (((((mcl.is_system || mcl.is_trait) || mcl.is_template) || mcl.is_operator_class) || mcl.is_generic_instance) || mcl.is_union)
        ; a trait-related class keeps &mut self on every method of the trait
        ; interface whatever its body does, so its verdict is that — but the
        ; verdict still has to be RECORDED, or a call site reads the
        ; conservative default and borrows mutably where the signature says
        ; &self, which is a run-time panic rather than a compile error
        def mclTraitRel:boolean (mcl.is_extended_by_children || ((array_length mcl.extends_classes) > 0))
        if (mclSpecial == false) {
          def mDirect:[string:boolean]
          def mGraph:[string:MethodCallList]
          this.buildClassMutationGraph(mcl ctx mDirect mGraph)
          this.buildInheritedMutationGraph(mcl ctx mDirect mGraph)
          this.markTraitIfaceMutations(mcl ctx mDirect)
          for mcl.methods mm:RangerAppFunctionDesc mmi {
            def mmB@(optional):CodeNode mm.fnBody
            if (!null? mmB) {
              def mmCtxO@(optional):RangerAppWriterContext mm.fnCtx
              def mmCtx:RangerAppWriterContext ctx
              if (!null? mmCtxO) {
                mmCtx = (unwrap mmCtxO)
              }
              ; the SAME question the emission asks, so a call site and the
              ; signature it calls agree on the borrow — they used to differ
              ; whenever the receiver decision was not the strict one, and a
              ; borrow_mut() where the callee takes &self is a run-time panic
              def mmMut:boolean false
              if (this.rustMethodNeedsReceiver(mm (unwrap mmB) mmCtx ctx)) {
                ; a trait-interface method reads the family's answer, which
                ; markTraitIfaceMutations has already put into mDirect
                mmMut = (this.methodMutatesThis(mm.name mDirect mGraph))
                ; …and the verdict only ever rises, which is what makes the
                ; rounds terminate
                if (mutPass > 0) {
                  if mm.rust_mut_self {
                    mmMut = true
                  }
                }
              }
              if (mmMut != mm.rust_mut_self) {
                mutChanged = true
              }
              mm.rust_mut_self = mmMut
            }
          }
          ; …and onto the variants, which is the set the emission writes from.
          ; The variant's answer WINS: it is the descriptor the signature is
          ; written from, and the two sets can disagree about whether the
          ; method carries the hidden handle.
          for mcl.defined_variants mvName:string mvi {
            def mVs2:RangerAppMethodVariants (get mcl.method_variants mvName)
            for mVs2.variants mv:RangerAppFunctionDesc mvj {
              def mvB@(optional):CodeNode mv.fnBody
              if (!null? mvB) {
                def mvCtxO@(optional):RangerAppWriterContext mv.fnCtx
                def mvCtx:RangerAppWriterContext ctx
                if (!null? mvCtxO) {
                  mvCtx = (unwrap mvCtxO)
                }
                def mvMut:boolean false
                if (this.rustMethodNeedsReceiver(mv (unwrap mvB) mvCtx ctx)) {
                  mvMut = (this.methodMutatesThis(mv.name mDirect mGraph))
                  if (mutPass > 0) {
                    if mv.rust_mut_self {
                      mvMut = true
                    }
                  }
                }
                if (mvMut != mv.rust_mut_self) {
                  mutChanged = true
                }
                mv.rust_mut_self = mvMut
                def mvOther@(optional):RangerAppFunctionDesc (mcl.findMethod(mv.name))
                if (!null? mvOther) {
                  def mvOtherD:RangerAppFunctionDesc (unwrap mvOther)
                  mvOtherD.rust_mut_self = mvMut
                }
              }
            }
          }
        }
        ; rust_can_be_static tells a CALL site to write `Class::m(…)` rather
        ; than `self.m(…)`, and it was only set while the class was being
        ; written — so any call site emitted before that class reached the
        ; writer said `self.m(…)` for a method emitted without a receiver.
        ; It is a property of the body alone, so it is settled here for
        ; every class, ahead of the first call site.
        ; A trait method and the inherent method each impl forwards to share
        ; one signature. The forwarding is written from the PARENT's variant,
        ; so a parent that takes the hidden __self_rc while the child's own
        ; variant does not passes an argument too many. These are the
        ; descriptors the writer emits from -- cl.methods holds different
        ; ones, which is why aligning through those changed nothing.
        for mcl.extends_classes mclParent:string mclPi {
          if (ctx.isDefinedClass(mclParent)) {
            def mclPC:RangerAppClassDesc (ctx.findClass(mclParent))
            if mclPC.is_extended_by_children {
              for mclPC.defined_variants pvName:string pvi {
                if (has mcl.method_variants pvName) {
                  def pMVs:RangerAppMethodVariants (get mclPC.method_variants pvName)
                  def cMVs:RangerAppMethodVariants (get mcl.method_variants pvName)
                  ; …and the other way too: a CHILD that takes the hidden
                  ; argument is forwarded to from a signature the parent's
                  ; variant shaped, so a parent that does not take one leaves
                  ; the call an argument short. Both directions run over
                  ; every class twice, so a parent lit by a later child still
                  ; reaches the children settled before it.
                  for pMVs.variants pV:RangerAppFunctionDesc pvj {
                    for cMVs.variants cV:RangerAppFunctionDesc cvj {
                      if (pV.rust_needs_self_rc || cV.rust_needs_self_rc) {
                        pV.rust_needs_self_rc = true
                        cV.rust_needs_self_rc = true
                      }
                    }
                  }
                }
              }
            }
          }
        }
        for mcl.methods scm:RangerAppFunctionDesc scmi {
          def scmB@(optional):CodeNode scm.fnBody
          if (!null? scmB) {
            def scmCtxO@(optional):RangerAppWriterContext scm.fnCtx
            def scmCtx:RangerAppWriterContext ctx
            if (!null? scmCtxO) {
              scmCtx = (unwrap scmCtxO)
            }
            scm.rust_can_be_static = ((this.fnBodyUsesThis((unwrap scmB) scmCtx)) == false)
          }
        }
      }
        mutPass = (mutPass + 1)
      }
      ; every class has an answer now, so the emission may ask the same
      ; question of a call through a field as the pre-pass did
      rust_field_call_mut_ready = true
      ; A second sweep, so the flag a late child raised on its parent reaches
      ; the siblings whose turn had already passed.
      for hdrRoot.definedClasses aCl:RangerAppClassDesc aCi {
        this.alignTraitSelfRcNeeds(aCl ctx)
      }
      fileHeaderWritten = true
    }
    
    ; the class's own fields plus everything it inherits: Rust copies no
    ; layout down, so this is what the struct, the literal and the Clone
    ; question all work from
    def allStructVars:[RangerAppParamDesc] (this.rustAllStructVars(cl ctx))

    ; Check if class has trait object fields (cannot derive Clone) — its own
    ; and the ones it holds INLINE, however deep
    def hasTraitObjectField:boolean (this.rustClassBlocksClone(cl ctx 0))
    
    if hasTraitObjectField {
      ; Don't derive Clone for structs with trait object fields
      wr.out("// Cannot derive Clone due to trait object fields" true)
    } {
      ; a case carried inside the tag compares by content, so it derives the
      ; comparison the generated RgIdentical arm uses
      if (this.rustUnionValueCase(cl ctx)) {
        wr.out("#[derive(Clone, PartialEq)]" true)

                wr.out(("fn " + (this.adjustType(variant.name)) + "(") false)
                this.rustFillTraitMutations(pc ctx)
                this.writeRustReceiver((has pc.rust_trait_mut variant.name) wr)
                this.writeArgsDef(variant ctx wr)
                this.writeRustFnClose(variant ctx wr)
                wr.out(" {" true)
                wr.indent(1)
                ; Determine if we should use the child's version or inherited version
                ; and whether the method is static
                def isStatic:boolean variant.rust_can_be_static
                ; NOTE: the call goes to the CHILD's inherent method, but the
                ; forwarding uses the PARENT's descriptor for the argument
                ; list -- the impl's own signature came from the parent too,
                ; and __self_rc is only in scope when the parent declared it.
                ; Switching to the child's descriptor at this one site costs
                ; more than it saves (159 -> 165); the two are made to agree
                ; in the analysis instead, by alignTraitSelfRcNeeds.
                if (has cl.defined_methods variant.name) {
                  ; Child overrides - check child's method for static status
                  if (has cl.method_variants variant.name) {
                    def cmvs:RangerAppMethodVariants (get cl.method_variants variant.name)
                    if ((array_length cmvs.variants) > 0) {
                      def childVariant:RangerAppFunctionDesc (at cmvs.variants 0)
                      isStatic = childVariant.rust_can_be_static
                    }
                  }
                }
                ; Generate the call
                if isStatic {
                  wr.out(((cl.name + "::" + (this.adjustType(variant.name))) + "(") false)
                  this.writeTraitForwardArgs(variant ctx wr false)
                } {
                  wr.out(((cl.name + "::" + (this.adjustType(variant.name))) + "(self") false)
                  this.writeTraitForwardArgs(variant ctx wr true)
                }
                wr.out(")" true)
                wr.indent(-1)
                wr.out("}" true)
              }
            }
            wr.indent(-1)
            wr.out("}" true)
          }
        }
      }
    }
    
    for cl.static_methods variant:RangerAppFunctionDesc i {
      def nn:CodeNode (unwrap variant.nameNode)
      if ((nn.hasFlag("main")) && (nn.code.filename == (ctx.getRootFile()))) {
        ; A Ranger `main:int` body ends in `return <code>`, but Rust's `fn main`
        ; returns (), so the body was emitted verbatim into a signature that
        ; could not accept it:
        ;   error[E0308]: expected `()`, found integer
        ; Run the body as a closure and hand its value to process::exit -- that
        ; is precisely what `return 0` from a C/C++ main means, so the exit code
        ; now survives to the shell instead of failing to compile.
        ; A `main:void` needs none of this and is emitted as before.
        def mainReturns:boolean (((strlen nn.type_name) > 0) && (nn.type_name != "void"))
        ; The body runs on a thread with a large stack. Rust gives the main
        ; thread 8MB, and a recursive-descent walk over a real program — which
        ; is what this language is for — overflows it, with `fatal runtime
        ; error: stack overflow` and no diagnostic. A spawned thread's stack
        ; size is ours to choose, so the entry point becomes a shim.
        wr.out("fn main() {" true)
        wr.indent(1)
        wr.out("let __rg_main_thread = std::thread::Builder::new().stack_size(512 * 1024 * 1024)" true)
        wr.out("  .spawn(__rg_main_body).expect(\"could not start the main thread\");" true)
        wr.out("__rg_main_thread.join().expect(\"main thread panicked\");" true)
        wr.indent(-1)
        wr.out("}" true)
        wr.out("fn __rg_main_body() {" true)
        wr.indent(1)
        wr.newline()
        if mainReturns {
          wr.out("let __rg_exit_code = (|| {" true)
          wr.indent(1)
          wr.newline()
        }
        def subCtx@(optional):RangerAppWriterContext variant.fnCtx
        if (!null? subCtx) {
          def sCtx:RangerAppWriterContext (unwrap subCtx)
          sCtx.is_function = true
          def fnB:CodeNode (unwrap variant.fnBody)
          rustFnReturnsUnion = (this.rustUnionReturnOf(variant ctx))
          this.walkRustFnBody(fnB sCtx wr)
          rustFnReturnsUnion = ""
        }
        if mainReturns {
          wr.newline()
          wr.indent(-1)
          wr.out("})();" true)
          wr.out("std::process::exit(__rg_exit_code as i32);" true)
        }
        wr.newline()
        wr.indent(-1)
        wr.out("}" true)
      }
    }
    ; A free `fn main` is attached to a class as an ordinary method and no
    ; crate main was emitted, so the file failed with E0601: `main` function
    ; not found. When the program declares no `sfn m@(main)`, the free main
    ; becomes the crate entry.
    if ((this.rustProgramHasMainFlag(ctx)) == false) {
      if (has cl.defined_methods "main") {
        def freeMVs:RangerAppMethodVariants (get cl.method_variants "main")
        for freeMVs.variants variant:RangerAppFunctionDesc fmvi {
          if ((array_length variant.params) == 0) {
            def fmNN@(optional):CodeNode variant.nameNode
            if (!null? fmNN) {
              def fmN:CodeNode (unwrap fmNN)
              if ((fmN.code.filename) == (ctx.getRootFile())) {
                wr.out("fn main() {" true)
                wr.indent(1)
                if variant.rust_can_be_static {
                  wr.out((cl.name + "::main();") true)
                } {
                  wr.out((("let mut __rg_main = " + cl.name) + "::new();") true)
                  wr.out("__rg_main.main();" true)
                }
                wr.indent(-1)
                wr.out("}" true)
              }
            }
          }
        }
      }
    }
    ; Restore previous class context
    if (!null? prevClass) {
      ctx.setCurrentClass((unwrap prevClass))
    }
  }

  fn rustProgramHasMainFlag:boolean (ctx:RangerAppWriterContext) {
    def root:RangerAppWriterContext (ctx.getRoot())
    for root.definedClasses rcl:RangerAppClassDesc rci {
      for rcl.static_methods sm:RangerAppFunctionDesc smi {
        def smNN@(optional):CodeNode sm.nameNode
        if (!null? smNN) {
          def smN:CodeNode (unwrap smNN)
          if (smN.hasFlag("main")) {
            return true
          }
        }
      }
    }
    return false
  }

  fn rustClassBlocksClone:boolean (cl:RangerAppClassDesc ctx:RangerAppWriterContext depth:int) {
    if (depth > 6) {
      return false
    }
    def cbcVars:[RangerAppParamDesc] (this.rustAllStructVars(cl ctx))
    for cbcVars pvar:RangerAppParamDesc i {
      def nameN@(optional):CodeNode pvar.nameNode
      if (!null? nameN) {
        def nn:CodeNode (unwrap nameN)
        ; a CLOSURE field is Box<dyn FnMut(…)>, which is no more Clone than
        ; a trait object is
        def clFldT:RangerNodeType nn.value_type
        if (nn.eval_type != RangerNodeType.NoType) {
          clFldT = nn.eval_type
        }
        if (clFldT == RangerNodeType.ExpressionType) {
          return true
        }
        ; a map's value type lives in array_type as well, and a Vec or a
        ; HashMap is Clone exactly when its element is
        def cbcT:string nn.type_name
        if ((strlen nn.array_type) > 0) {
          cbcT = nn.array_type
        }
        if ((strlen cbcT) > 0) {
          if (ctx.isDefinedClass(cbcT)) {
            def tc:RangerAppClassDesc (ctx.findClass(cbcT))
            if tc.is_extended_by_children {
              return true
            }
            if ((this.rustClassIsShared(cbcT ctx)) == false) {
              if (tc.name != cl.name) {
                if (this.rustClassBlocksClone(tc ctx (depth + 1))) {
                  return true
                }
              }
            }
          }
        }
      }
    }
    return false
  }

}

  static fn ptrBytes:int (module:LowIRModule) {
    if (module.ptrType == "i64") {
      return 8
    }
    return 4
  }

  static fn descMetaOff:int (module:LowIRModule) {
    return (LowIRRuntimeGen.ptrBytes(module))
  }

  static fn ensurePtrArrayRuntime:void (module:LowIRModule) {
    if (LowIRRuntimeGen.hasFunction(module "RtPtrArray_new")) {
      return
    }
    LowIRRuntimeGen.buildRtPtrArrayNew(module)
    LowIRRuntimeGen.buildRtPtrArrayPush(module)
    LowIRRuntimeGen.buildRtPtrArrayGet(module)
    LowIRRuntimeGen.buildRtPtrArraySet(module)
    LowIRRuntimeGen.buildRtPtrArrayLen(module)
  }

  static fn buildRtPtrArrayNew:void (module:LowIRModule) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(module))
    builder.reset()
    def pt (module.ptrType)
    def pb (LowIRRuntimeGen.ptrBytes(module))
    def meta (LowIRRuntimeGen.descMetaOff(module))
    def params:[LowIRParam]
    def capP@(lives):LowIRParam (new LowIRParam())
    capP.name = "cap"
    capP.irType = "i32"
    push params capP
    builder.startBlock("entry")
    ; layout: data@0 | len@meta | cap@meta+4 | elemKind@meta+8 | rc@meta+12.
    ; The refcount is what lets an array be shared -- a local handed to a
    ; constructor that stores it in a field has two owners, and without a count
    ; both released it.
    def descBytes (builder.emitConst("i32" ("" + (pb + 16))))
    def desc (builder.emitHeapAlloc(descBytes))
    def elemBytes (builder.emitConst("i32" ("" + pb)))
    def capBytes (builder.emitBin("mul" "i32" "%cap" elemBytes))
    def data (builder.emitHeapAlloc(capBytes))
    def zeroPt (builder.emitConst(pt "0"))
    builder.emitPtrStore(desc data)
    def zeroI32 (builder.emitConst("i32" "0"))
    builder.emitStoreI32At(desc meta zeroI32)
    builder.emitStoreI32At(desc (meta + 4) "%cap")
    def oneRc (builder.emitConst("i32" "1"))
    builder.emitStoreI32At(desc (meta + 12) oneRc)
    builder.terminateRet(pt desc)
    LowIRRuntimeGen.finishFn(builder module "RtPtrArray_new" pt params false)
  }



Import "ng_LowIR.rgr"

; Heap-backed [int:int] map runtime for Lang operators (linear probing).
; Descriptor layout (16 bytes): keysPtr, valsPtr, cap, size

class LowIRRuntimeGen {
  static fn hasFunction:boolean (module:LowIRModule name:string) {
    for module.functions fn:LowIRFunction i {
      if (fn.name == name) {
        return true
      }
    }
    return false
  }

  static fn ensureArrayRuntime:void (module:LowIRModule) {
    if (LowIRRuntimeGen.hasFunction(module "RtArray_set")) {
      return
    }
    LowIRRuntimeGen.buildRtArraySet(module)
  }

  static fn ensureMapRuntime:void (module:LowIRModule) {
    if (LowIRRuntimeGen.hasFunction(module "RtMap_new")) {
      return
    }
    LowIRRuntimeGen.buildRtMapNew(module)
    LowIRRuntimeGen.buildRtMapHashSlot(module)
    LowIRRuntimeGen.buildRtMapPutAt(module)
    LowIRRuntimeGen.buildRtMapPut(module)
    LowIRRuntimeGen.buildRtMapGetAt(module)
    LowIRRuntimeGen.buildRtMapGet(module)
    LowIRRuntimeGen.buildRtMapHas(module)
  }

  static fn finishFn:void (builder:LowIRBuilder module:LowIRModule name:string retType:string params:[LowIRParam] exportFn:boolean) {
    builder.finishFunction(name retType params exportFn false)
  }

  static fn buildRtArraySet:void (module:LowIRModule) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(module))
    builder.reset()
    def pt (module.ptrType)
    def lenOff (LowIRRuntimeGen.arrayLenOff(module))
    def params:[LowIRParam]
    def descP@(lives):LowIRParam (new LowIRParam())
    descP.name = "desc"
    descP.irType = pt
    push params descP
    def idxP@(lives):LowIRParam (new LowIRParam())
    idxP.name = "idx"
    idxP.irType = "i32"
    push params idxP
    def valP@(lives):LowIRParam (new LowIRParam())
    valP.name = "val"
    valP.irType = "i32"
    push params valP
    builder.startBlock("entry")

    def data (LowIRRuntimeGen.emitDescLoad(builder module "%desc" 0))
    def four (builder.emitConst("i32" "4"))
    def offI32 (builder.emitBin("mul" "i32" "%idx" four))
    def off (builder.emitZextI32ToPtr(offI32))
    def slot (builder.emitBin("add" pt data off))
    builder.emitPtrStoreTyped(slot "%val" "i32")

    def oldLen (builder.emitI32At("%desc" lenOff))
    def one (builder.emitConst("i32" "1"))
    def idxPlus (builder.emitBin("add" "i32" "%idx" one))
    def needBump (builder.emitIcmp("slt" oldLen idxPlus))
    def bumpLabel (builder.freshLabel("arrset_bump"))
    def doneLabel (builder.freshLabel("arrset_done"))
    builder.terminateBrIf(needBump bumpLabel doneLabel)

    builder.startBlock(bumpLabel)
    builder.emitStoreI32At("%desc" lenOff idxPlus)
    builder.terminateBr(doneLabel)

    builder.startBlock(doneLabel)
    builder.terminateRet("void" "")
    LowIRRuntimeGen.finishFn(builder module "RtArray_set" "void" params false)
  }

  static fn arrayLenOff:int (module:LowIRModule) {
    return (LowIRRuntimeGen.ptrBytes(module))
  }

  static fn arrayCapOff:int (module:LowIRModule) {
    return ((LowIRRuntimeGen.ptrBytes(module)) + 4)
  }

  static fn arrayDescBytes:int (module:LowIRModule) {
    return ((LowIRRuntimeGen.ptrBytes(module)) + 8)
  }

  static fn mapValsOff:int (module:LowIRModule) {
    return (LowIRRuntimeGen.ptrBytes(module))
  }

  static fn mapCapOff:int (module:LowIRModule) {
    return ((LowIRRuntimeGen.ptrBytes(module)) * 2)
  }

  static fn mapSizeOff:int (module:LowIRModule) {
    return (((LowIRRuntimeGen.ptrBytes(module)) * 2) + 4)
  }

  static fn mapDescBytes:int (module:LowIRModule) {
    return (((LowIRRuntimeGen.ptrBytes(module)) * 2) + 8)
  }

  static fn emitDescLoad:string (builder:LowIRBuilder module:LowIRModule desc:string byteOff:int) {
    def pt (module.ptrType)
    def off (builder.emitConst(pt ("" + byteOff)))
    def addr (builder.emitBin("add" pt desc off))
    return (builder.emitPtrLoad(addr))
  }

  static fn emitKeysPtr:string (builder:LowIRBuilder module:LowIRModule desc:string) {
    return (LowIRRuntimeGen.emitDescLoad(builder module desc 0))
  }

  static fn emitValsPtr:string (builder:LowIRBuilder module:LowIRModule desc:string) {
    def valsOff (LowIRRuntimeGen.mapValsOff(module))
    return (LowIRRuntimeGen.emitDescLoad(builder module desc valsOff))
  }

  static fn emitCap:string (builder:LowIRBuilder module:LowIRModule desc:string) {
    def capOff (LowIRRuntimeGen.mapCapOff(module))
    return (builder.emitI32At(desc capOff))
  }

  static fn emitSize:string (builder:LowIRBuilder module:LowIRModule desc:string) {
    def sizeOff (LowIRRuntimeGen.mapSizeOff(module))
    return (builder.emitI32At(desc sizeOff))
  }

  static fn emitSlotAddr:string (builder:LowIRBuilder module:LowIRModule base:string slot:string) {
    def pt (module.ptrType)
    def four (builder.emitConst("i32" "4"))
    def offI32 (builder.emitBin("mul" "i32" slot four))
    def off (builder.emitZextI32ToPtr(offI32))
    return (builder.emitBin("add" pt base off))
  }

  static fn buildRtMapNew:void (module:LowIRModule) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(module))
    builder.reset()
    def pt (module.ptrType)
    def valsOff (LowIRRuntimeGen.mapValsOff(module))
    def capOff (LowIRRuntimeGen.mapCapOff(module))
    def sizeOff (LowIRRuntimeGen.mapSizeOff(module))
    def params:[LowIRParam]
    def capP@(lives):LowIRParam (new LowIRParam())
    capP.name = "cap"
    capP.irType = "i32"
    push params capP
    builder.startBlock("entry")

    def descBytes (builder.emitConst("i32" ("" + (LowIRRuntimeGen.mapDescBytes(module)))))
    def desc (builder.emitHeapAlloc(descBytes))
    def four (builder.emitConst("i32" "4"))
    def nbytes (builder.emitBin("mul" "i32" "%cap" four))
    def keys (builder.emitHeapAlloc(nbytes))
    def vals (builder.emitHeapAlloc(nbytes))
    builder.emitPtrStore(desc keys)
    def valsFld (builder.emitConst(pt ("" + valsOff)))
    def valsAddr (builder.emitBin("add" pt desc valsFld))
    builder.emitPtrStore(valsAddr vals)
    builder.emitStoreI32At(desc capOff "%cap")
    def zero (builder.emitConst("i32" "0"))
    builder.emitStoreI32At(desc sizeOff zero)

    def iSlot (builder.freshTemp("i"))
    builder.emitAlloca("i32" iSlot)
    builder.emitStore("i32" zero iSlot)
    def condLabel (builder.freshLabel("map_init_cond"))
    def bodyLabel (builder.freshLabel("map_init_body"))
    def doneLabel (builder.freshLabel("map_init_done"))
    builder.terminateBr(condLabel)

    builder.startBlock(condLabel)
    def iVal (builder.emitLoad("i32" iSlot))
    def ltCap (builder.emitIcmp("slt" iVal "%cap"))
    builder.terminateBrIf(ltCap bodyLabel doneLabel)

    builder.startBlock(bodyLabel)
    def keysPtr (LowIRRuntimeGen.emitKeysPtr(builder module desc))
    def kp (LowIRRuntimeGen.emitSlotAddr(builder module keysPtr iVal))
    def negOne (builder.emitConst("i32" "-1"))
    builder.emitPtrStoreTyped(kp negOne "i32")
    def one (builder.emitConst("i32" "1"))
    def iNext (builder.emitBin("add" "i32" iVal one))
    builder.emitStore("i32" iNext iSlot)
    builder.terminateBr(condLabel)

    builder.startBlock(doneLabel)
    builder.terminateRet(pt desc)
    LowIRRuntimeGen.finishFn(builder module "RtMap_new" pt params false)
  }

  static fn buildRtMapHashSlot:void (module:LowIRModule) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(module))
    builder.reset()
    def pt (module.ptrType)
    def params:[LowIRParam]
    def descP@(lives):LowIRParam (new LowIRParam())
    descP.name = "desc"
    descP.irType = pt
    push params descP
    def keyP@(lives):LowIRParam (new LowIRParam())
    keyP.name = "key"
    keyP.irType = "i32"
    push params keyP
    builder.startBlock("entry")

    def cap (LowIRRuntimeGen.emitCap(builder module "%desc"))
    def h (builder.emitBin("srem" "i32" "%key" cap))
    def zero (builder.emitConst("i32" "0"))
    def neg (builder.emitIcmp("slt" h zero))
    def thenLabel (builder.freshLabel("hash_then"))
    def mergeLabel (builder.freshLabel("hash_merge"))
    builder.terminateBrIf(neg thenLabel mergeLabel)

    builder.startBlock(thenLabel)
    def fixed (builder.emitBin("add" "i32" h cap))
    builder.terminateRet("i32" fixed)

    builder.startBlock(mergeLabel)
    builder.terminateRet("i32" h)
    LowIRRuntimeGen.finishFn(builder module "RtMap_hashSlot" "i32" params false)
  }

  static fn buildRtMapPutAt:void (module:LowIRModule) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(module))
    builder.reset()
    def pt (module.ptrType)
    def sizeOff (LowIRRuntimeGen.mapSizeOff(module))
    def params:[LowIRParam]
    def descP@(lives):LowIRParam (new LowIRParam())
    descP.name = "desc"
    descP.irType = pt
    push params descP
    def slotP@(lives):LowIRParam (new LowIRParam())
    slotP.name = "slot"
    slotP.irType = "i32"
    push params slotP
    def keyP@(lives):LowIRParam (new LowIRParam())
    keyP.name = "key"
    keyP.irType = "i32"
    push params keyP
    def valP@(lives):LowIRParam (new LowIRParam())
    valP.name = "val"
    valP.irType = "i32"
    push params valP
    builder.startBlock("entry")

    def cap (LowIRRuntimeGen.emitCap(builder module "%desc"))
    def geCap (builder.emitIcmp("sge" "%slot" cap))
    def retLabel (builder.freshLabel("putat_ret"))
    def bodyLabel (builder.freshLabel("putat_body"))
    builder.terminateBrIf(geCap retLabel bodyLabel)

    builder.startBlock(bodyLabel)
    def keysPtr (LowIRRuntimeGen.emitKeysPtr(builder module "%desc"))
    def valsPtr (LowIRRuntimeGen.emitValsPtr(builder module "%desc"))
    def kp (LowIRRuntimeGen.emitSlotAddr(builder module keysPtr "%slot"))
    def vp (LowIRRuntimeGen.emitSlotAddr(builder module valsPtr "%slot"))
    def k (builder.emitPtrLoadTyped(kp "i32"))
    def negOne (builder.emitConst("i32" "-1"))
    def eqKey (builder.emitIcmp("eq" k "%key"))
    def updLabel (builder.freshLabel("putat_upd"))
    def emptyLabel (builder.freshLabel("putat_empty"))
    def recurseLabel (builder.freshLabel("putat_rec"))
    def checkEmpty (builder.freshLabel("putat_chk"))
    builder.terminateBrIf(eqKey updLabel checkEmpty)

    builder.startBlock(checkEmpty)
    def isEmpty (builder.emitIcmp("eq" k negOne))
    builder.terminateBrIf(isEmpty emptyLabel recurseLabel)

    builder.startBlock(emptyLabel)
    builder.emitPtrStoreTyped(kp "%key" "i32")
    builder.emitPtrStoreTyped(vp "%val" "i32")
    def size (LowIRRuntimeGen.emitSize(builder module "%desc"))
    def one (builder.emitConst("i32" "1"))
    def newSize (builder.emitBin("add" "i32" size one))
    builder.emitStoreI32At("%desc" sizeOff newSize)
    builder.terminateRet("void" "")

    builder.startBlock(updLabel)
    builder.emitPtrStoreTyped(vp "%val" "i32")
    builder.terminateRet("void" "")

    builder.startBlock(recurseLabel)
    def one2 (builder.emitConst("i32" "1"))
    def nextSlot (builder.emitBin("add" "i32" "%slot" one2))
    def nextMod (builder.emitBin("srem" "i32" nextSlot cap))
    def args:[string]
    def argTypes:[string]
    push args "%desc"
    push argTypes pt
    push args nextMod
    push argTypes "i32"
    push args "%key"
    push argTypes "i32"
    push args "%val"
    push argTypes "i32"
    builder.emitCall("RtMap_putAt" "void" args argTypes)
    builder.terminateRet("void" "")

    builder.startBlock(retLabel)
    builder.terminateRet("void" "")
    LowIRRuntimeGen.finishFn(builder module "RtMap_putAt" "void" params false)
  }

  static fn buildRtMapPut:void (module:LowIRModule) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(module))
    builder.reset()
    def pt (module.ptrType)
    def params:[LowIRParam]
    def descP@(lives):LowIRParam (new LowIRParam())
    descP.name = "desc"
    descP.irType = pt
    push params descP
    def keyP@(lives):LowIRParam (new LowIRParam())
    keyP.name = "key"
    keyP.irType = "i32"
    push params keyP
    def valP@(lives):LowIRParam (new LowIRParam())
    valP.name = "val"
    valP.irType = "i32"
    push params valP
    builder.startBlock("entry")

    def hashArgs:[string]
    def hashTypes:[string]
    push hashArgs "%desc"
    push hashTypes pt
    push hashArgs "%key"
    push hashTypes "i32"
    def start (builder.emitCall("RtMap_hashSlot" "i32" hashArgs hashTypes))

    def putArgs:[string]
    def putTypes:[string]
    push putArgs "%desc"
    push putTypes pt
    push putArgs start
    push putTypes "i32"
    push putArgs "%key"
    push putTypes "i32"
    push putArgs "%val"
    push putTypes "i32"
    builder.emitCall("RtMap_putAt" "void" putArgs putTypes)
    builder.terminateRet("void" "")
    LowIRRuntimeGen.finishFn(builder module "RtMap_put" "void" params false)
  }

  static fn buildRtMapGetAt:void (module:LowIRModule) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(module))
    builder.reset()
    def pt (module.ptrType)
    def params:[LowIRParam]
    def descP@(lives):LowIRParam (new LowIRParam())
    descP.name = "desc"
    descP.irType = pt
    push params descP
    def slotP@(lives):LowIRParam (new LowIRParam())
    slotP.name = "slot"
    slotP.irType = "i32"
    push params slotP
    def keyP@(lives):LowIRParam (new LowIRParam())
    keyP.name = "key"
    keyP.irType = "i32"
    push params keyP
    builder.startBlock("entry")

    def cap (LowIRRuntimeGen.emitCap(builder module "%desc"))
    def negOne (builder.emitConst("i32" "-1"))
    def negRet (builder.freshLabel("getat_neg"))
    def bodyLabel (builder.freshLabel("getat_body"))
    def geCap (builder.emitIcmp("sge" "%slot" cap))
    builder.terminateBrIf(geCap negRet bodyLabel)

    builder.startBlock(bodyLabel)
    def keysPtr (LowIRRuntimeGen.emitKeysPtr(builder module "%desc"))
    def kp (LowIRRuntimeGen.emitSlotAddr(builder module keysPtr "%slot"))
    def k (builder.emitPtrLoadTyped(kp "i32"))
    def isEmpty (builder.emitIcmp("eq" k negOne))
    def keyCheck (builder.freshLabel("getat_key"))
    builder.terminateBrIf(isEmpty negRet keyCheck)

    builder.startBlock(keyCheck)
    def eqKey (builder.emitIcmp("eq" k "%key"))
    def valRet (builder.freshLabel("getat_val"))
    def recurseRet (builder.freshLabel("getat_rec"))
    builder.terminateBrIf(eqKey valRet recurseRet)

    builder.startBlock(valRet)
    def valsPtr (LowIRRuntimeGen.emitValsPtr(builder module "%desc"))
    def vp (LowIRRuntimeGen.emitSlotAddr(builder module valsPtr "%slot"))
    def v (builder.emitPtrLoadTyped(vp "i32"))
    builder.terminateRet("i32" v)

    builder.startBlock(negRet)
    builder.terminateRet("i32" negOne)

    builder.startBlock(recurseRet)
    def one (builder.emitConst("i32" "1"))
    def nextSlot (builder.emitBin("add" "i32" "%slot" one))
    def nextMod (builder.emitBin("srem" "i32" nextSlot cap))
    def args:[string]
    def argTypes:[string]
    push args "%desc"
    push argTypes pt
    push args nextMod
    push argTypes "i32"
    push args "%key"
    push argTypes "i32"
    def res (builder.emitCall("RtMap_getAt" "i32" args argTypes))
    builder.terminateRet("i32" res)
    LowIRRuntimeGen.finishFn(builder module "RtMap_getAt" "i32" params false)
  }

  static fn buildRtMapGet:void (module:LowIRModule) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(module))
    builder.reset()
    def pt (module.ptrType)
    def params:[LowIRParam]
    def descP@(lives):LowIRParam (new LowIRParam())
    descP.name = "desc"
    descP.irType = pt
    push params descP
    def keyP@(lives):LowIRParam (new LowIRParam())
    keyP.name = "key"
    keyP.irType = "i32"
    push params keyP
    builder.startBlock("entry")

    def hashArgs:[string]
    def hashTypes:[string]
    push hashArgs "%desc"
    push hashTypes pt
    push hashArgs "%key"
    push hashTypes "i32"
    def start (builder.emitCall("RtMap_hashSlot" "i32" hashArgs hashTypes))

    def getArgs:[string]
    def getTypes:[string]
    push getArgs "%desc"
    push getTypes pt
    push getArgs start
    push getTypes "i32"
    push getArgs "%key"
    push getTypes "i32"
    def res (builder.emitCall("RtMap_getAt" "i32" getArgs getTypes))
    builder.terminateRet("i32" res)
    LowIRRuntimeGen.finishFn(builder module "RtMap_get" "i32" params false)
  }

  static fn buildRtMapHas:void (module:LowIRModule) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(module))
    builder.reset()
    def pt (module.ptrType)
    def params:[LowIRParam]
    def descP@(lives):LowIRParam (new LowIRParam())
    descP.name = "desc"
    descP.irType = pt
    push params descP
    def keyP@(lives):LowIRParam (new LowIRParam())
    keyP.name = "key"
    keyP.irType = "i32"
    push params keyP
    builder.startBlock("entry")

    def getArgs:[string]
    def getTypes:[string]
    push getArgs "%desc"
    push getTypes pt
    push getArgs "%key"
    push getTypes "i32"
    def v (builder.emitCall("RtMap_get" "i32" getArgs getTypes))
    def negOne (builder.emitConst("i32" "-1"))
    def found (builder.emitIcmp("ne" v negOne))
    def one (builder.emitConst("i32" "1"))
    def zero (builder.emitConst("i32" "0"))
    def thenLabel (builder.freshLabel("has_then"))
    def mergeLabel (builder.freshLabel("has_merge"))
    builder.terminateBrIf(found thenLabel mergeLabel)

    builder.startBlock(thenLabel)
    builder.terminateRet("i32" one)

    builder.startBlock(mergeLabel)
    builder.terminateRet("i32" zero)
    LowIRRuntimeGen.finishFn(builder module "RtMap_has" "i32" params false)
  }

  static fn ptrBytes:int (module:LowIRModule) {
    if (module.ptrType == "i64") {
      return 8
    }
    return 4
  }

  static fn descMetaOff:int (module:LowIRModule) {
    return (LowIRRuntimeGen.ptrBytes(module))
  }

  static fn ensurePtrArrayRuntime:void (module:LowIRModule) {
    if (LowIRRuntimeGen.hasFunction(module "RtPtrArray_new")) {
      return
    }
    LowIRRuntimeGen.buildRtPtrArrayNew(module)
    LowIRRuntimeGen.buildRtPtrArrayPush(module)
    LowIRRuntimeGen.buildRtPtrArrayGet(module)
    LowIRRuntimeGen.buildRtPtrArraySet(module)
    LowIRRuntimeGen.buildRtPtrArrayLen(module)
  }

  static fn buildRtPtrArrayNew:void (module:LowIRModule) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(module))
    builder.reset()
    def pt (module.ptrType)
    def pb (LowIRRuntimeGen.ptrBytes(module))
    def meta (LowIRRuntimeGen.descMetaOff(module))
    def params:[LowIRParam]
    def capP@(lives):LowIRParam (new LowIRParam())
    capP.name = "cap"
    capP.irType = "i32"
    push params capP
    builder.startBlock("entry")
    def descBytes (builder.emitConst("i32" ("" + (pb + 12))))
    def desc (builder.emitHeapAlloc(descBytes))
    def elemBytes (builder.emitConst("i32" ("" + pb)))
    def capBytes (builder.emitBin("mul" "i32" "%cap" elemBytes))
    def data (builder.emitHeapAlloc(capBytes))
    def zeroPt (builder.emitConst(pt "0"))
    builder.emitPtrStore(desc data)
    def zeroI32 (builder.emitConst("i32" "0"))
    builder.emitStoreI32At(desc meta zeroI32)
    builder.emitStoreI32At(desc (meta + 4) "%cap")
    builder.terminateRet(pt desc)
    LowIRRuntimeGen.finishFn(builder module "RtPtrArray_new" pt params false)
  }

  static fn buildRtPtrArrayLen:void (module:LowIRModule) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(module))
    builder.reset()
    def pt (module.ptrType)
    def meta (LowIRRuntimeGen.descMetaOff(module))
    def params:[LowIRParam]
    def descP@(lives):LowIRParam (new LowIRParam())
    descP.name = "desc"
    descP.irType = pt
    push params descP
    builder.startBlock("entry")
    def len (builder.emitI32At("%desc" meta))
    builder.terminateRet("i32" len)
    LowIRRuntimeGen.finishFn(builder module "RtPtrArray_len" "i32" params false)
  }

  static fn buildRtPtrArrayGet:void (module:LowIRModule) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(module))
    builder.reset()
    def pt (module.ptrType)
    def pb (LowIRRuntimeGen.ptrBytes(module))
    def params:[LowIRParam]
    def descP@(lives):LowIRParam (new LowIRParam())
    descP.name = "desc"
    descP.irType = pt
    push params descP
    def idxP@(lives):LowIRParam (new LowIRParam())
    idxP.name = "idx"
    idxP.irType = "i32"
    push params idxP
    builder.startBlock("entry")
    def data (builder.emitPtrLoad("%desc"))
    def elemBytes (builder.emitConst("i32" ("" + pb)))
    def offI32 (builder.emitBin("mul" "i32" "%idx" elemBytes))
    def off (builder.emitZextI32ToPtr(offI32))
    def slot (builder.emitBin("add" pt data off))
    def val (builder.emitPtrLoadTyped(slot pt))
    builder.terminateRet(pt val)
    LowIRRuntimeGen.finishFn(builder module "RtPtrArray_get" pt params false)
  }

  static fn buildRtPtrArraySet:void (module:LowIRModule) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(module))
    builder.reset()
    def pt (module.ptrType)
    def pb (LowIRRuntimeGen.ptrBytes(module))
    def params:[LowIRParam]
    def descP@(lives):LowIRParam (new LowIRParam())
    descP.name = "desc"
    descP.irType = pt
    push params descP
    def idxP@(lives):LowIRParam (new LowIRParam())
    idxP.name = "idx"
    idxP.irType = "i32"
    push params idxP
    def valP@(lives):LowIRParam (new LowIRParam())
    valP.name = "val"
    valP.irType = pt
    push params valP
    def meta (LowIRRuntimeGen.descMetaOff(module))
    builder.startBlock("entry")
    def data (builder.emitPtrLoad("%desc"))
    def elemBytes (builder.emitConst("i32" ("" + pb)))
    def offI32 (builder.emitBin("mul" "i32" "%idx" elemBytes))
    def off (builder.emitZextI32ToPtr(offI32))
    def slot (builder.emitBin("add" pt data off))
    builder.emitPtrStore(slot "%val")
    def oldLen (builder.emitI32At("%desc" meta))
    def one (builder.emitConst("i32" "1"))
    def idxPlus (builder.emitBin("add" "i32" "%idx" one))
    def needBump (builder.emitIcmp("slt" oldLen idxPlus))
    def bumpLabel (builder.freshLabel("ptrset_bump"))
    def doneLabel (builder.freshLabel("ptrset_done"))
    builder.terminateBrIf(needBump bumpLabel doneLabel)
    builder.startBlock(bumpLabel)
    builder.emitStoreI32At("%desc" meta idxPlus)
    builder.terminateBr(doneLabel)
    builder.startBlock(doneLabel)
    builder.terminateRet("void" "")
    LowIRRuntimeGen.finishFn(builder module "RtPtrArray_set" "void" params false)
  }

  static fn buildRtPtrArrayPush:void (module:LowIRModule) {
    def builder@(lives):LowIRBuilder (new LowIRBuilder(module))
    builder.reset()
    def pt (module.ptrType)
    def pb (LowIRRuntimeGen.ptrBytes(module))
    def meta (LowIRRuntimeGen.descMetaOff(module))
    def capOff (meta + 4)
    def params:[LowIRParam]

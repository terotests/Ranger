    builder.startBlock(cont)
    def len2 (builder.emitI32At("%desc" meta))
    def data2 (builder.emitPtrLoad("%desc"))
    def elemBytes2 (builder.emitConst("i32" ("" + pb)))
    def offI32 (builder.emitBin("mul" "i32" len2 elemBytes2))
    def off (builder.emitZextI32ToPtr(offI32))
    def slot (builder.emitBin("add" pt data2 off))
    builder.emitPtrStore(slot "%val")
    def one2 (builder.emitConst("i32" "1"))
    def newLen (builder.emitBin("add" "i32" len2 one2))
    builder.emitStoreI32At("%desc" meta newLen)
    builder.terminateRet("void" "")
    LowIRRuntimeGen.finishFn(builder module "RtPtrArray_push" "void" params false)
  }
}

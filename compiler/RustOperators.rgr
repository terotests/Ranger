          if (inner_type == "boolean") { unwrap_bare_local = false }
          if (inner_type == "char") { unwrap_bare_local = false }
          if (TTypeRegistry.isIntAlias(inner_type)) { unwrap_bare_local = false }
          if (TTypeRegistry.isFloatAlias(inner_type)) { unwrap_bare_local = false }
        }
        if (is_self_field || unwrap_bare_local) {
          wr.out(".clone().unwrap()" false)
        } {
          wr.out(".unwrap()" false)
        }
      }
      ctx.unsetInExpr()
      return
    }
  }

}

extension RangerRustClassWriter {

  ; --- the generated `for` (PLAN_RUST_SEMANTIC_IDIOMS K) ----------------------
  ; `for xs v:int i { … }` used to be, always:
  ;
  ;   let __n_i = (xs.len() as i64);
  ;   for i in 0..__n_i { let mut v = xs[i as usize]; … }
  ;
  ; which is correct and reads as machine output. When the body never mentions
  ; the index and never mentions the collection, and the element is a Copy
  ; scalar, the same loop is `for v in xs.iter().copied()` — the idiom, and the
  ; bound, the cast and the index all disappear.
  ;
  ; Those three conditions are what make the rewrite safe rather than merely
  ; shorter. The iterator BORROWS the collection for the whole loop, so a body
  ; that touches it at all keeps the index form; an index that is read needs to
  ; exist; and a non-Copy element would bind `&T` where the index form binds an
  ; owned clone, which changes every use in the body.
  ;
  ; This is deliberately not an iterator-adapter lowering. A loop that pushes is
  ; respectable Rust; the shape of the loop was the tell.
  ; `(e N)` is not a bare WalkNode: it brackets the walk with setInExpr, and
  ; without that a call operand is written as a STATEMENT — `self.f(x);` with a
  ; semicolon and a line break in the middle of the expression being built.
  fn rustWriteOperand:void (arg:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if ((strlen arg.rust_use_tmpvar) > 0) {
      wr.out(arg.rust_use_tmpvar false)
      arg.rust_use_tmpvar = ""
      return
    }
    ctx.setInExpr()
    this.WalkNode(arg ctx wr)
    ctx.unsetInExpr()
  }

  ; the same walk the Swift writer's `swift_rc` does through the compiler:
  ; "does this body mention that name at all". A field path counts as a mention
  ; of its root, so `xs.len()` inside the body keeps the index form.
  fn rustTreeMentions:boolean (node:CodeNode name:string) {
    if (node.value_type == RangerNodeType.VRef) {
      if (node.vref == name) {
        return true
      }
    }
    if ((array_length node.ns) >= 2) {
      if ((itemAt node.ns 0) == name) {
        return true
      }
    }
    if (node.vref == name) {
      return true
    }
    for node.children ch:CodeNode i {
      if (this.rustTreeMentions(ch name)) {
        return true
      }
    }
    return false
  }

  fn rustForItemIsCopyScalar:boolean (item:CodeNode) {
    def tn:string ""
    if item.hasParamDesc {
      def ipd:RangerAppParamDesc item.paramDesc
      def ipdNN@(optional):CodeNode ipd.nameNode
      if (!null? ipdNN) {
        def ipdN:CodeNode (unwrap ipdNN)
        tn = ipdN.type_name
        if ((strlen ipdN.array_type) > 0) {
          tn = ipdN.array_type
        }
      }
    } {
      tn = item.type_name
      if ((strlen item.array_type) > 0) {
        tn = item.array_type
      }
    }
    if (tn == "int") { return true }
    if (tn == "double") { return true }
    if (tn == "boolean") { return true }
    if (tn == "char") { return true }
    if (TTypeRegistry.isIntAlias(tn)) { return true }
    if (TTypeRegistry.isFloatAlias(tn)) { return true }
    return false
  }

  ; The element type a `for` binds, as a class name, or "" when it is not a
  ; class of this program.
  fn rustForItemClassName:string (item:CodeNode ctx:RangerAppWriterContext) {
    def tn:string ""
    if item.hasParamDesc {
      def ipd:RangerAppParamDesc item.paramDesc
      def ipdNN@(optional):CodeNode ipd.nameNode
      if (!null? ipdNN) {
        def ipdN:CodeNode (unwrap ipdNN)
        tn = ipdN.type_name
        if ((strlen ipdN.array_type) > 0) {
          tn = ipdN.array_type
        }
      }
    } {
      tn = item.type_name
      if ((strlen item.array_type) > 0) {
        tn = item.array_type
      }
    }
    if ((strlen tn) == 0) {
      return ""
    }
    if ((ctx.isDefinedClass(tn)) == false) {
      return ""
    }
    return tn
  }

  ; Is `field` of `clName` a scalar Rust copies? `&T` binds the element by
  ; reference, and a read of a Copy field through one is a copy; a read of a
  ; String or a Vec through one is a move out of a borrow, which is an error.
  fn rustClassFieldIsCopy:boolean (clName:string field:string ctx:RangerAppWriterContext) {
    def cl:RangerAppClassDesc (ctx.findClass(clName))
    for cl.variables v:RangerAppParamDesc vi {
      if (v.name == field) {
        def vNN@(optional):CodeNode v.nameNode
        if (null? vNN) {
          return false
        }
        def vN:CodeNode (unwrap vNN)
        if (vN.hasFlag("optional")) {
          return false
        }
        if ((strlen vN.array_type) > 0) {
          return false
        }
        if ((strlen vN.key_type) > 0) {
          return false
        }
        def vt:string vN.type_name
        if (vt == "int") { return true }
        if (vt == "double") { return true }
        if (vt == "boolean") { return true }
        if (vt == "char") { return true }
        if (TTypeRegistry.isIntAlias(vt)) { return true }
        if (TTypeRegistry.isFloatAlias(vt)) { return true }
        return false
      }
    }
    return false
  }

  ; Can this loop bind `&T` -- a bare `.iter()` -- instead of cloning every
  ; element? Only when the body does nothing with the name but read Copy
  ; fields off it: `sum += line.cents * line.qty`. Every other shape (writing
  ; a field, calling a method, handing the value on, reading a String or a
  ; collection field out of it) either needs `&mut` or moves out of the
  ; borrow, so those keep the clone.
  fn rustForBodyOnlyReadsCopyFields:boolean (body:CodeNode itemName:string clName:string ctx:RangerAppWriterContext) {
    if ((strlen clName) == 0) {
      return false
    }
    if (body.expression) {
      if ((array_length body.children) > 0) {
        def h:CodeNode (body.getFirst())
        ; `line.x = v` and every mutating operator that targets the name
        if ((h.vref == "=") && ((array_length body.children) >= 3)) {
          def lhs:CodeNode (body.getSecond())
          if ((array_length lhs.ns) > 0) {
            if ((itemAt lhs.ns 0) == itemName) {
              return false
            }
          }
        }
      }
    }
    ; a method call ON the name. `rust_mut_self` is settled for every class
    ; before the first line is written, so the question the comment here used
    ; to call unanswerable -- does the callee want `&mut self`? -- is a
    ; lookup. A `&self` method is reached through a `&T` binding by
    ; auto-deref, which is what makes `for line in &self.lines` legal where
    ; the body calls `line.total()`. A method carrying the hidden __self_rc
    ; handle needs the Rc and cannot.
    if (body.hasFnCall) {
      def fc:CodeNode (body.getFirst())
      if ((array_length fc.ns) >= 2) {
        if ((itemAt fc.ns 0) == itemName) {
          if ((array_length fc.ns) != 2) {
            return false
          }
          def orcCl@(optional):RangerAppClassDesc (ctx.findClass(clName))
          if (null? orcCl) {
            return false
          }
          def orcClD:RangerAppClassDesc (unwrap orcCl)
          def orcM@(optional):RangerAppFunctionDesc (orcClD.findMethod((itemAt fc.ns 1)))
          if (null? orcM) {
            return false
          }
          def orcMD:RangerAppFunctionDesc (unwrap orcM)
          if orcMD.rust_mut_self {
            return false
          }
          if (this.rustNeedsSelfRc(orcMD ctx)) {
            return false
          }
          ; the arguments are still the body's to answer for; the receiver
          ; path itself is not a field read and must not reach the test below
          for body.children orcCh:CodeNode orcCi {
            if (orcCi > 0) {
              if ((this.rustForBodyOnlyReadsCopyFields(orcCh itemName clName ctx)) == false) {
                return false
              }
            }
          }
          return true
        }
      }
    }
    ; the name itself: only ever `item.field`, and only a Copy field
    if ((body.expression) == false) {
      def segs:int (array_length body.ns)
      if (segs > 0) {
        if ((itemAt body.ns 0) == itemName) {
          if (segs != 2) {
            return false
          }
          if ((this.rustClassFieldIsCopy(clName (itemAt body.ns 1) ctx)) == false) {
            return false
          }
        }
      } {
        if (body.vref == itemName) {
          return false
        }
      }
    }
    for body.children ch:CodeNode ci {
      if ((this.rustForBodyOnlyReadsCopyFields(ch itemName clName ctx)) == false) {
        return false
      }
    }
    return true
  }

  ; Does the body touch the thing being iterated? The iterator borrows the
  ; collection for the whole loop, so it has to be every NAME the collection
  ; expression rests on, not just the last segment: `for lctx.ownedLocals …`
  ; rests on `lctx`, and a body that passes `lctx` on mutably is a borrow error
  ; even though it never says `ownedLocals`. Testing only the tail segment is
  ; how five such loops got through the first time.
  fn rustForBodyTouchesCollection:boolean (body:CodeNode coll:CodeNode) {
    if ((strlen coll.vref) > 0) {
      if (this.rustTreeMentions(body coll.vref)) {
        return true
      }
    }
    for coll.ns seg:string si {
      if ((strlen seg) > 0) {
        if (this.rustTreeMentions(body seg)) {
          return true
        }
      }
    }
    ; an expression rather than a name — a call, an index, a chain. Anything it
    ; borrows is invisible from here, so it keeps the index form.
    if ((strlen coll.vref) == 0) {
      if ((array_length coll.ns) == 0) {
        return true
      }
    }
    return false
  }

  ; Does reading this collection take a `.borrow()`?
  ;
  ; Only then does the head need hoisting. A field of a plain struct reached
  ; through a `&self` receiver is `self.lines` -- no cell, nothing held -- and
  ; hoisting THAT would clone the collection once per loop for nothing.
  ; docs/plans/PLAN_RUST_REENTRANCY.md 1.
  fn rustForCollBorrows:boolean (coll:CodeNode ctx:RangerAppWriterContext) {
    def fcbN:int (array_length coll.ns)
    if (fcbN == 0) {
      return false
    }
    def fcbRoot:string (itemAt coll.ns 0)
    ; a receiverless method reaches every field through __self_rc.borrow()
    if rust_receiverless_method {
      if (fcbRoot == "this") {
        return true
      }
      if (ctx.isMemberVariable(fcbRoot)) {
        return true
      }
    }
    ; …and any segment BEFORE the last that is a shared class is read through
    ; its own cell, whatever the receiver is
    def fcbCls@(optional):RangerAppClassDesc (ctx.getCurrentClass())
    def fcbI:int 0
    while (fcbI < (fcbN - 1)) {
      def fcbSeg:string (itemAt coll.ns fcbI)
      if (fcbSeg != "this") {
        def fcbTn:string ""
        if ((array_length coll.nsp) > fcbI) {
          def fcbP:RangerAppParamDesc (itemAt coll.nsp fcbI)
          def fcbNNO@(optional):CodeNode fcbP.nameNode
          if (!null? fcbNNO) {
            def fcbNN:CodeNode (unwrap fcbNNO)
            fcbTn = fcbNN.type_name
          }
        }
        if ((strlen fcbTn) == 0) {
          if (!null? fcbCls) {
            def fcbC:RangerAppClassDesc (unwrap fcbCls)
            def fcbVO@(optional):RangerAppParamDesc (fcbC.findVariable(fcbSeg))
            if (!null? fcbVO) {
              def fcbV:RangerAppParamDesc (unwrap fcbVO)
              def fcbVNNO@(optional):CodeNode fcbV.nameNode
              if (!null? fcbVNNO) {
                def fcbVNN:CodeNode (unwrap fcbVNNO)
                fcbTn = fcbVNN.type_name
              }
            }
          }
        }
        if ((strlen fcbTn) > 0) {
          if (this.rustClassIsShared(fcbTn ctx)) {
            return true
          }
        }
      }
      fcbI = (fcbI + 1)
    }
    return false
  }

  fn rustWriteForLoop:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if ((array_length node.children) < 5) {
      return
    }
    def coll:CodeNode (node.getSecond())
    def item:CodeNode (itemAt node.children 2)
    def idx:CodeNode (itemAt node.children 3)
    def body:CodeNode (itemAt node.children 4)

    def itemName:string item.vref
    def idxName:string idx.vref

    ; every element kind can take the iterator form: the index loop binds an
    ; OWNED value — `xs[i]` for a Copy scalar, `xs[i].clone()` otherwise — and
    ; `.copied()` / `.cloned()` bind exactly the same thing. Binding `&T` with a
    ; bare `.iter()` would be the idiom a human writes, but it changes every use
    ; of the name in the body, which is a different change.
    def itemIsCopy:boolean (this.rustForItemIsCopyScalar(item))
    def useIter:boolean true
    if useIter {
      if ((strlen idxName) > 0) {
        if (this.rustTreeMentions(body idxName)) {
          useIter = false
        }
      }
    }
    if useIter {
      if (this.rustForBodyTouchesCollection(body coll)) {
        useIter = false
      }
    }

    if useIter {
      def needsMut:boolean false
      if item.hasParamDesc {
        def itemDesc:RangerAppParamDesc (unwrap item.paramDesc)
        if (itemDesc.set_cnt > 0) {
          needsMut = true
        }
      }
      ; A `for` head's temporaries live for the WHOLE loop. That is the one
      ; place Rust does this: the condition of an `if` or a `while` is its own
      ; temporary scope and its `Ref` is dropped before the block runs, but
      ; `for x in EXPR` desugars to a `match` over `into_iter(EXPR)` and every
      ; temporary in EXPR lives until the match ends -- which is after the
      ; last iteration.
      ;
      ; So a collection reached through a FIELD keeps that object borrowed
      ; while the body runs, and the first `borrow_mut` of the same cell
      ; inside the body panics with "RefCell already borrowed". rustc accepts
      ; the program; it fails at run time. That is how the Rust self-host came
      ; to compile with zero errors and panic on the first file it was given:
      ; `for stdCommands.children lch i { ... set opHash fc.vref newOpList }`
      ; in RangerActiveOperators borrows `this` for the head and mutably
      ; borrows it in the body. The body never mentions `stdCommands`, so the
      ; name-matching check above does not see it.
      ;
      ; Reading the collection into a local first ends the borrow at that
      ; statement's semicolon, which is what the index form below already does
      ; for its bound and what the `forEach` path does for its receiver. A
      ; bare local name borrows nothing, so it is left alone.
      def hoistColl:boolean (this.rustForCollBorrows(coll ctx))
      def itName:string ("__it_" + itemName)
      if hoistColl {
        wr.out(("let " + itName + " = ") false)
        this.rustWriteOperand(coll ctx wr)
        wr.out(".clone();" true)
      }
      wr.out("for " false)
      if needsMut {
        wr.out("mut " false)
      }
      ; the BOUND NAME goes through the walker, not out as a raw vref: a
      ; Ranger local may be called `fn` or `type`, and the reserved-word
      ; renaming lives in the walker. `let mut fn = …` does not parse.
      this.rustWriteOperand(item ctx wr)
      wr.out(" in " false)
      ; a body that only reads Copy fields off the element binds `&T` and
      ; clones nothing; anything else keeps the owned element
      def onlyReadsCopy:boolean false
      if (itemIsCopy == false) {
        if (this.rustForBodyOnlyReadsCopyFields(body itemName (this.rustForItemClassName(item ctx)) ctx)) {
          onlyReadsCopy = true
        }
      }
      ; ...and that arm is written `for line in &self.lines`, not
      ; `for line in self.lines.iter()`. The two are the same loop; the first
      ; is the one a Rust programmer writes, and it is the only arm that can
      ; take it -- `.copied()` and `.cloned()` are method chains and keep the
      ; receiver form.
      ;
      ; Only over a PLAIN Vec, though. A collection of a SHARED class is a
      ; `RefCell<Vec<...>>` field, so reading it writes `.borrow()` and hands
      ; back a `Ref`. `.iter()` reaches the Vec through Deref; `&` does not,
      ; and `for v in &self.variables.borrow()` asks for
      ; `&Ref<'_, Vec<T>>` to be an iterator, which rustc says it is not
      ; (E0277). A hoisted collection keeps `.iter()` as well -- the local
      ; holds whatever the clone gave it.
      def useAmp:boolean onlyReadsCopy
      if useAmp {
        if hoistColl {
          useAmp = false
        } {
          if (this.rustClassIsShared((this.rustForItemClassName(item ctx)) ctx)) {
            useAmp = false
          }
        }
      }
      if useAmp {
        wr.out("&" false)
      }
      if hoistColl {
        wr.out(itName false)
      } {
        this.rustWriteOperand(coll ctx wr)
      }
      if itemIsCopy {
        wr.out(".iter().copied() {" true)
      } {
        if useAmp {
          wr.out(" {" true)
        } {
          if onlyReadsCopy {
            wr.out(".iter() {" true)
          } {
            wr.out(".iter().cloned() {" true)
          }
        }
      }
      wr.indent(1)
      def iCtx:RangerAppWriterContext (ctx.fork())
      iCtx.restartExpressionLevel()
      this.WalkNode(body iCtx wr)
      wr.indent(-1)
      wr.out("}" true)
      return
    }

    ; the index form, unchanged: the bound is read into a local FIRST, because a
    ; range expression that borrows keeps that borrow alive for the whole loop
    ; and a body that borrows the same thing mutably cannot run
    ; the temporary is named after the index, so nested loops do not collide.
    ; It is the writer's own name, so the raw vref is the right thing here —
    ; unlike the BOUND names, which the walker renames.
    def nName:string ("__n_" + idxName)
    ; no parentheses: `as` binds tighter than anything that could follow, and
    ; a `let` value is a delimited position -- the pair was rustc's
    ; unused_parens on every index loop in the file
    wr.out(("let " + nName + " = ") false)
    this.rustWriteOperand(coll ctx wr)
    wr.out(".len() as i64;" true)
    wr.out("for " false)
    this.rustWriteOperand(idx ctx wr)
    wr.out((" in 0.." + nName) false)
    wr.out(" {" true)
    wr.indent(1)
    wr.out("let mut " false)
    this.rustWriteOperand(item ctx wr)
    wr.out(" = " false)
    this.rustWriteOperand(coll ctx wr)
    wr.out("[" false)
    this.rustWriteOperand(idx ctx wr)
    wr.out(" as usize]" false)
    if (itemIsCopy == false) {
      wr.out(".clone()" false)
    }
    wr.out(";" true)
    def sCtx:RangerAppWriterContext (ctx.fork())
    sCtx.restartExpressionLevel()
    this.WalkNode(body sCtx wr)
    wr.indent(-1)
    wr.out("}" true)
  }
}

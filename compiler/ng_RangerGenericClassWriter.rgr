Import "ng_RangerProcessCodegen.rgr"

class RangerGenericClassWriter {

  def compiler:LiveCompiler
  def compFlags:[string:boolean]

  ; -1 not yet read, 0 -format=none, 1 the formatter is on. Read once: the
  ; question is asked at every call site and getCompilerSetting walks the
  ; whole context chain to answer it.
  def fmtMode:int (0 - 1)

  ; ---------------------------------------------------------------------------
  ; PARENTHESES AROUND A CALL RECEIVER (PLAN_FORMAT.md S4)
  ;
  ; `CreateCallExpression` and `CreatePropertyGet` used to wrap every receiver
  ; unconditionally, with no precedence test of any kind. That one decision is
  ; where `((_data.row()).str("region", "North")).num("sales", 120.0)` comes
  ; from, and it is not something the ecosystem can clean up afterwards:
  ; prettier reprints from its own AST and drops them, but rustfmt and
  ; dart format are whitespace formatters that keep every paren node they are
  ; handed, and NO formatter of any kind reformats a doc comment -- which is
  ; where the generated API reference shows these to readers.
  ;
  ; The question is asked of the EMITTED TEXT rather than of the node, because
  ; what a receiver turns into is the target writer's business: Rust appends
  ; `.borrow()`, C++ writes `->`, a register expression becomes a temporary
  ; name. A node-shape rule would have to know all of that, sixteen writers
  ; deep. A text rule does not: a postfix expression -- a name, a path, a call,
  ; an index, and any chain of those -- binds tighter than `.` in every target
  ; language, so it never needs the pair, and anything else keeps it.
  ;
  ; The default is therefore to KEEP the parentheses. Only a shape proven not
  ; to need them loses them.
  ; ---------------------------------------------------------------------------

  ; ---------------------------------------------------------------------------
  ; BINDING POWERS (PLAN_FORMAT.md S4.2, phase 2)
  ;
  ; The Ranger tree is already fully parenthesised by construction -- the
  ; nesting IS the precedence -- so a pair of parentheses in the output is
  ; needed only where the TARGET's precedence would re-associate differently
  ; from the tree. Every target here is C-family and orders these operators the
  ; same way, so one shared table answers for all of them; a target that
  ; disagrees overrides this method.
  ;
  ; The rule is one-directional on purpose: drop the pair only when the operand
  ; binds STRICTLY TIGHTER than the operator it sits inside. Parentheses around
  ; a tighter-binding operand are never required in any context, so the rule
  ; cannot change what a program means. Equal precedence keeps its pair, which
  ; leaves `(a - b) - c` alone rather than reasoning about associativity.
  ;
  ; Higher binds tighter. 0 is "not an operator I know", and that keeps the
  ; pair.
  fn bindingPowerOf:int (opName:string) {
    if (opName == "||") { return 3 }
    if (opName == "or") { return 3 }
    if (opName == "&&") { return 4 }
    if (opName == "and") { return 4 }
    if (opName == "|") { return 5 }
    if (opName == "^") { return 6 }
    if (opName == "&") { return 7 }
    if (opName == "==") { return 8 }
    if (opName == "!=") { return 8 }
    if (opName == "<") { return 9 }
    if (opName == ">") { return 9 }
    if (opName == "<=") { return 9 }
    if (opName == ">=") { return 9 }
    if (opName == "<<") { return 10 }
    if (opName == ">>") { return 10 }
    if (opName == "+") { return 11 }
    if (opName == "-") { return 11 }
    if (opName == "*") { return 12 }
    if (opName == "/") { return 12 }
    if (opName == "%") { return 12 }
    return 0
  }

  ; Does an operand of this binding power need parentheses inside a parent of
  ; that one? Only "strictly tighter" answers no; everything else, including
  ; either side being unknown, answers yes.
  fn operandNeedsParens:boolean (childBp:int parentBp:int) {
    if (childBp <= 0) {
      return true
    }
    if (parentBp <= 0) {
      return true
    }
    if (childBp > parentBp) {
      return false
    }
    return true
  }

  fn formatterEnabled:boolean (ctx:RangerAppWriterContext) {
    if (fmtMode >= 0) {
      return (fmtMode == 1)
    }
    def setting:string (ctx.getCompilerSetting("format"))
    if (setting == "none") {
      fmtMode = 0
      return false
    }
    fmtMode = 1
    return true
  }

  fn isIdentStartChar:boolean (c:int) {
    if ((c >= 97) && (c <= 122)) {
      return true
    }
    if ((c >= 65) && (c <= 90)) {
      return true
    }
    if (c == 95) {
      return true
    }
    if (c == 36) {
      return true
    }
    return false
  }

  ; Characters a postfix expression may carry OUTSIDE any bracket: the name
  ; itself, `.` and `::` for member access, `->` for C++, `#` for a Rust raw
  ; identifier, `!` for a Rust macro or a Swift force-unwrap. A space, an
  ; operator, a comma or a `?` means this is not one -- `new X()`, `await x`,
  ; `a + b` and `x?` all stop here and keep their parentheses.
  fn isPostfixTopChar:boolean (s:string i:int c:int n:int) {
    if (this.isIdentStartChar(c)) {
      return true
    }
    if ((c >= 48) && (c <= 57)) {
      return true
    }
    if (c == 46) {
      return true
    }
    if (c == 35) {
      return true
    }
    if (c == 33) {
      return true
    }
    if (c == 58) {
      def prevOk:boolean false
      if (i > 0) {
        def pc:int (charAt s (i - 1))
        if (pc == 58) {
          prevOk = true
        }
      }
      if (i < (n - 1)) {
        def nc:int (charAt s (i + 1))
        if (nc == 58) {
          prevOk = true
        }
      }
      return prevOk
    }
    if (c == 45) {
      if (i < (n - 1)) {
        def nc2:int (charAt s (i + 1))
        if (nc2 == 62) {
          return true
        }
      }
      return false
    }
    if (c == 62) {
      if (i > 0) {
        def pc2:int (charAt s (i - 1))
        if (pc2 == 45) {
          return true
        }
      }
      return false
    }
    return false
  }

  ; A name, a path, a call, an index, or any chain of those -- and nothing
  ; else. String and character literals are stepped over whole, so a paren
  ; inside one cannot make an expression that needs the pair look as though
  ; it does not: `f("(")+g(")")` balances by accident and its `+` would
  ; otherwise be read as sitting inside a bracket.
  fn isPostfixExpression:boolean (s:string) {
    def n:int (strlen s)
    if (n == 0) {
      return false
    }
    def firstC:int (charAt s 0)
    if (false == (this.isIdentStartChar(firstC))) {
      return false
    }
    def depth:int 0
    def i:int 0
    while (i < n) {
      def c:int (charAt s i)
      if ((c == 34) || (c == 39)) {
        def quote:int c
        i = i + 1
        while (i < n) {
          def qc:int (charAt s i)
          if (qc == 92) {
            i = i + 2
          } {
            if (qc == quote) {
              break _
            }
            i = i + 1
          }
        }
        if (i >= n) {
          return false
        }
        i = i + 1
      } {
        if ((c == 40) || (c == 91)) {
          depth = depth + 1
          i = i + 1
        } {
          if ((c == 41) || (c == 93)) {
            depth = depth - 1
            if (depth < 0) {
              return false
            }
            i = i + 1
          } {
            if (depth == 0) {
              def okc:boolean (this.isPostfixTopChar(s i c n))
              if (false == okc) {
                return false
              }
            }
            i = i + 1
          }
        }
      }
    }
    if (depth != 0) {
      return false
    }
    return true
  }

  ; The receiver already carries an outer pair of its own -- `(a + b)` walked
  ; out of a suppressed operator. Wrapping it again is where the second half
  ; of `((this.arr[k])).asString()` comes from.
  fn isWrappedInParens:boolean (s:string) {
    def n:int (strlen s)
    if (n < 2) {
      return false
    }
    if ((charAt s 0) != 40) {
      return false
    }
    def depth:int 0
    def i:int 0
    while (i < n) {
      def c:int (charAt s i)
      if ((c == 34) || (c == 39)) {
        def quote:int c
        i = i + 1
        while (i < n) {
          def qc:int (charAt s i)
          if (qc == 92) {
            i = i + 2
          } {
            if (qc == quote) {
              break _
            }
            i = i + 1
          }
        }
        if (i >= n) {
          return false
        }
        i = i + 1
      } {
        if (c == 40) {
          depth = depth + 1
          i = i + 1
        } {
          if (c == 41) {
            depth = depth - 1
            if (depth == 0) {
              if (i == (n - 1)) {
                return true
              }
              return false
            }
            i = i + 1
          } {
            i = i + 1
          }
        }
      }
    }
    return false
  }

  fn receiverNeedsParens:boolean (s:string) {
    if ((strlen s) == 0) {
      return false
    }
    if (this.isPostfixExpression(s)) {
      return false
    }
    if (this.isWrappedInParens(s)) {
      return false
    }
    return true
  }

  ; Walk a call receiver into a writer of its own, then decide from what came
  ; out whether it has to be wrapped, and write it back as one string.
  ;
  ; `-format=none` restores the unconditional pair, so every target can be
  ; compiled both ways from one compiler and the two outputs diffed.
  ;
  ; Once rather than twice: walking a node a second time runs its side effects
  ; a second time -- registers, hoisted temporaries and imports among them.
  ;
  ; A detached writer rather than `wr.fork()`, which is what this first tried:
  ; a CodeWriter buffers the line it is building in `currentLine` and only
  ; flushes it into a slice at a newline, so a fork taken mid-line splices its
  ; slice AHEAD of everything the parent has buffered. `res["fs"] = ` had not
  ; reached a slice yet, and the receiver landed in front of it:
  ; `(this.filesystem)        res["fs"] = .toDictionary();`. fork() is safe
  ; only at a line boundary, which is why the imports are its only other use.
  ;
  ; The source-map columns recorded inside the receiver are relative to the
  ; receiver rather than to the line, because the detached writer starts its
  ; own `currentLine`. Seeding it with the parent's would fix that, but taking
  ; the seed back off needs `substring` against a `strlen`, and those two count
  ; different units on the C++ build -- characters and bytes -- which would
  ; break the self-hosted C++ compiler on any line holding a multi-byte
  ; character. Every existing `fork()` already has the same property, and the
  ; source-map suite checks structure rather than columns, so this takes the
  ; portable side of that trade.
  fn writeCallReceiver:void (obj:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (false == (this.formatterEnabled(ctx))) {
      wr.out("(" false)
      ctx.setInExpr()
      this.WalkNode( obj ctx wr)
      ctx.unsetInExpr()
      wr.out(")" false)
      return
    }
    def recv:CodeWriter (new CodeWriter)
    recv.parent = wr
    recv.indentAmount = 0
    recv.sourceMapsEnabled = wr.sourceMapsEnabled
    recv.sourceMapBuilder = wr.sourceMapBuilder
    recv.lineNumber = wr.lineNumber
    ; Three flags live on the WRITER and are read by the walk, so a detached
    ; one has to carry them in and hand back whatever the walk did to them.
    ; The original code shared them by walking into `wr` itself. Without this,
    ; a receiver inside a `format!` argument lost `in_format_args` and Rust
    ; stopped flattening string chains into one format! -- two codegen tests
    ; said so before this line existed.
    recv.suppress_expr_parens = wr.suppress_expr_parens
    recv.current_op_no_parens = wr.current_op_no_parens
    recv.in_format_args = wr.in_format_args
    ctx.setInExpr()
    this.WalkNode( obj ctx recv)
    ctx.unsetInExpr()
    wr.suppress_expr_parens = recv.suppress_expr_parens
    wr.current_op_no_parens = recv.current_op_no_parens
    wr.in_format_args = recv.in_format_args
    def recvCode:string (recv.getCode())
    if (this.receiverNeedsParens(recvCode)) {
      wr.out(("(" + recvCode + ")") false)
    } {
      wr.out(recvCode false)
    }
  }

  ; ---------------------------------------------------------------------------
  ; UNION INTERFACES (PLAN_SHAPES.md S5)
  ;
  ; On a class-based target a union is best written as an interface its members
  ; implement: the static type a `shape` declares survives, and — unlike a
  ; tagged handle or a native sum type — nothing has to be wrapped, converted or
  ; unwrapped at any call site, because a class simply implements it.
  ;
  ; Two unions must NOT become interfaces: one whose members are not all classes
  ; (`union prim (int string)` — Int cannot implement anything), and the
  ; compiler's own `Any`, which contains every declared class in the program.
  ; ---------------------------------------------------------------------------
  fn unionIsSealable:boolean (ucl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    if (ucl.is_union == false) {
      return false
    }
    if (ucl.name == "Any") {
      return false
    }
    if ((array_length ucl.is_union_of) == 0) {
      return false
    }
    def ok:boolean true
    for ucl.is_union_of mname:string mi {
      if (ctx.isDefinedClass(mname)) {
        def mcl:RangerAppClassDesc (ctx.findClass(mname))
        if (((mcl.is_system || mcl.is_union) || mcl.is_system_union) || mcl.is_trait) {
          ok = false
        }
      } {
        ok = false
      }
    }
    return ok
  }

  ; The interface name a union is written as.
  fn unionInterfaceName:string (unionName:string) {
    return ("union_" + unionName)
  }

  ; Every sealable union declared in the program, in declaration order.
  fn sealableUnionNames:[string] (ctx:RangerAppWriterContext) {
    def out:[string]
    def rootCtx:RangerAppWriterContext (ctx.getRoot())
    for rootCtx.definedClasses ucl:RangerAppClassDesc uci {
      if (this.unionIsSealable(ucl ctx)) {
        push out ucl.name
      }
    }
    return out
  }

  ; The interfaces this class implements: one per sealable union it belongs to.
  fn unionInterfacesOf:[string] (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    def out:[string]
    def rootCtx:RangerAppWriterContext (ctx.getRoot())
    for rootCtx.definedClasses ucl:RangerAppClassDesc uci {
      if (this.unionIsSealable(ucl ctx)) {
        if ((indexOf ucl.is_union_of cl.name) >= 0) {
          push out (this.unionInterfaceName(ucl.name))
        }
      }
    }
    return out
  }

  ; True when the class is a member of at least one sealable union (shape case).
  fn classInSealableUnion:boolean (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    def ifaces:[string] (this.unionInterfacesOf(cl ctx))
    if ((array_length ifaces) > 0) {
      return true
    }
    return false
  }

  ; Type spelling for a union on targets that use a named interface/protocol
  ; for sealable unions and a top type otherwise (Go interface{}, Swift Any, …).
  fn sealableUnionTypeOr:string (unionName:string topType:string ctx:RangerAppWriterContext) {
    if (ctx.isDefinedClass(unionName)) {
      def cc:RangerAppClassDesc (ctx.findClass(unionName))
      if cc.is_union {
        if (this.unionIsSealable(cc ctx)) {
          return (this.unionInterfaceName(unionName))
        }
        return topType
      }
    }
    return topType
  }

  fn lineEnding:string () {
    return ""
  }

  ; does this operator's template for the target already write a full
  ; `( … )` around its output? The expression walker skips its own pair
  ; then. The default claims nothing; a target writer overrides.
  fn opWritesOwnParens:boolean (opName:string node:CodeNode ctx:RangerAppWriterContext) {
    return false
  }

  fn addSystemImport:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    if cl.is_system {
      def langName (ctx.getTargetLang())
      if( has cl.systemNodes langName ) {
        def sNode (unwrap (get cl.systemNodes langName))
        if( (size sNode.children) > 2) {
          def impDefs (at sNode.children 2)   ; java7 LayoutInflater ( (imp "android.view.LayoutInflater") )
          impDefs.forTree({
            if(item.isFirstVref('imp')) {
              def name (item.getSecond())
              wr.addImport(name.string_value)
            }
          })
        }      
      }
    }
  }

  fn EncodeString:string (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def encoded_str:string ""
    def str_length:int (strlen node.string_value)
    def encoded_str:string ""
    def ii:int 0
    while (< ii str_length) {
      def cc:int (charAt node.string_value ii)
      switch cc {
        case 8 {
            encoded_str = encoded_str + (strfromcode 92 ) + (strfromcode 98 )  
        }
        case 9 {
            encoded_str = encoded_str + (strfromcode 92 ) + (strfromcode 116 ) 
        }    
        case 10 {
            ( = encoded_str ( encoded_str + (strfromcode 92 ) + (strfromcode 110 ) ) ) 
        }    
        case 12 {
            ( = encoded_str ( encoded_str + (strfromcode 92 ) + (strfromcode 102 ) ) ) 
        }    
        case 13 {
            ( = encoded_str ( encoded_str + (strfromcode 92 ) + (strfromcode 114 ) ) ) 
        }

        case 34 {
            ( = encoded_str ( encoded_str + (strfromcode 92 ) + (strfromcode 34 ) ) ) 
        }  
        case 92 {
            = encoded_str ( encoded_str + (strfromcode 92 ) + (strfromcode 92 ) ) 
        }
                                            
        default {
            ( = encoded_str ( encoded_str + (strfromcode cc) ) ) 
        }
      }
      ii = ii + 1
    }
    return encoded_str   
  }

  fn CustomOperator:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
  }

  ; Called just before a STATEMENT-level operator is written — the one place
  ; a target can still put a `let` in front of it. Targets that need nothing
  ; here inherit the empty body.
  fn beforeOperatorStatement:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
  }

  fn WriteSetterVRef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {  
  }

  fn writeArrayTypeDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {  
  }

  fn WriteEnum:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (node.eval_type == RangerNodeType.Enum) {
      def rootObjName:string (itemAt node.ns 0)
      def e@(optional):RangerAppEnum (ctx.getEnum(rootObjName))
      if (!null? e) {
        def enumName:string (itemAt node.ns 1)
        wr.out(("" + (unwrap (get e.values enumName))) false)
      } {
        if node.hasParamDesc {
          def pp:RangerAppParamDesc node.paramDesc
          def nn:CodeNode pp.nameNode
          this.WriteVRef( (unwrap nn) ctx wr)
        }
      }
    }
  }
  ; A double literal that renders as a whole number needs a `.0` so the target
  ; reads it as a double and not an integer.
  ;
  ; This used to ask the question by rendering `to_int` of the value and
  ; comparing the two strings. `int` is 32 bits wide on the native backends, so
  ; the round trip overflowed for anything past 2^31 and answered "not whole"
  ; for 2^52 -- `4503599627370496` was written where every other target wrote
  ; `4503599627370496.0`. The rendering already says whether it has a fraction;
  ; nothing needs to be converted to ask.
  fn doubleNeedsPointZero:boolean (dd_str:string) {
    if ((strlen dd_str) == 0) {
      return false
    }
    ; `Infinity` / `NaN` / an exponent form are already unambiguous, and `.0`
    ; would only make them unparseable
    if ((indexOf dd_str ".") >= 0) {
      return false
    }
    if ((indexOf dd_str "e") >= 0) {
      return false
    }
    if ((indexOf dd_str "E") >= 0) {
      return false
    }
    def first:int (charAt dd_str 0)
    if ((first == (ccode "-")) || (first == (ccode "+"))) {
      if ((strlen dd_str) < 2) {
        return false
      }
      first = (charAt dd_str 1)
    }
    return ((first >= (ccode "0")) && (first <= (ccode "9")))
  }
  fn WriteScalarValue:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    switch node.value_type {
      case RangerNodeType.Double {
        def dd_str ("" + node.double_value)
        if( this.doubleNeedsPointZero(dd_str) ) {
          wr.outMapped((dd_str + ".0") node false "")
        } {
          wr.outMapped(dd_str node false "")
        }
      }
      case RangerNodeType.String {
        def s:string (this.EncodeString(node ctx wr))
        wr.outMapped((("\"" + s) + "\"") node false "")
      }
      case RangerNodeType.Integer {
        wr.outMapped(("" + node.int_value) node false "")
      }
      case RangerNodeType.Boolean {
        if node.boolean_value {
          wr.outMapped("true" node false "")
        } {
          wr.outMapped("false" node false "")
        }
      }
    }
  }
  fn getTypeString:string (type_string:string) {
    return type_string
  }
  ; What a target has to write when a block turns out to be empty. Braced
  ; languages need nothing -- `{ }` is a statement. Python needs `pass`, or the
  ; `if:` above it has no body and the file does not parse.
  fn emptyBlockFiller:string () {
    return ""
  }

  fn import_lib:void (lib_name:string ctx:RangerAppWriterContext wr:CodeWriter) {
    wr.addImport(lib_name)
  }
  fn getObjectTypeString:string (type_string:string ctx:RangerAppWriterContext) {
    switch type_string {
      case "int" {
        return "Integer"
      }
      case "string" {
        return "String"
      }
      case "chararray" {
        return "byte[]"
      }
      case "char" {
        return "byte"
      }
      case "boolean" {
        return "Boolean"
      }
      case "double" {
        return "Double"
      }
    }
    return type_string
  }
  fn release_local_vars:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    for ctx.localVarNames n:string i {
      def p:RangerAppParamDesc (get ctx.localVariables n)
      if (p.ref_cnt == 0) {
        continue _
      }
      if (p.isAllocatedType()) {
        if (1 == (p.getStrength())) {
          if (p.nameNode.eval_type == RangerNodeType.Hash) {
          }
          if (p.nameNode.eval_type == RangerNodeType.Array) {
          }
          if ((p.nameNode.eval_type != RangerNodeType.Array) && (p.nameNode.eval_type != RangerNodeType.Hash)) {
          }
        }
        if (0 == (p.getStrength())) {
          if (p.nameNode.eval_type == RangerNodeType.Hash) {
          }
          if (p.nameNode.eval_type == RangerNodeType.Array) {
          }
          if ((p.nameNode.eval_type != RangerNodeType.Array) && (p.nameNode.eval_type != RangerNodeType.Hash)) {
          }
        }
      }
    }
    if ctx.is_function {
      return
    }
    if (!null? ctx.parent) {
      this.release_local_vars(node (unwrap ctx.parent) wr)
    }
  }
  ; Renders the BODY of a doc example in this target's own syntax.
  ;
  ; The writer is detached: it is a plain CodeWriter rather than a fork, so
  ; nothing it produces reaches the output file. Its `parent` is set to the
  ; real content writer all the same, because a body may ask upward for the
  ; import list or for a file — a fork would have registered a slice and the
  ; example would have been emitted twice.
  ;
  ; This runs BEFORE any class is written and the example is then skipped at
  ; emission, so each body is walked exactly once either way.
  fn renderDocExample:string (fd:RangerAppFunctionDesc ctx:RangerAppWriterContext outer:CodeWriter) {
    def wr:CodeWriter (new CodeWriter ())
    wr.parent = outer
    def body@(optional):CodeNode fd.fnBody
    if (null? body) {
      return ""
    }
    def fnCtx@(optional):RangerAppWriterContext fd.fnCtx
    if (null? fnCtx) {
      return ""
    }
    def subCtx:RangerAppWriterContext (unwrap fnCtx)
    def wasFn:boolean subCtx.is_function
    subCtx.is_function = true
    this.WalkNode((unwrap body) subCtx wr)
    subCtx.is_function = wasFn
    def rendered:string (wr.getCode())
    return (this.trimTrailingBlank(rendered))
  }

  ; A rendered body ends with the newline the last statement wrote, which
  ; becomes a blank line inside the fence of every doc comment that quotes it.
  ; Named trimTrailingBlank rather than trim: `trim` is one of the method names
  ; the compiler resolves elsewhere, and defining it makes every call site fail.
  fn trimTrailingBlank:string (text:string) {
    def n:int (strlen text)
    while (n > 0) {
      def last:string (substring text (n - 1) n)
      if ((last == "\n") || (last == "\r")) {
        n = n - 1
      } {
        if (last == " ") {
          n = n - 1
        } {
          return (substring text 0 n)
        }
      }
    }
    return ""
  }

  fn WalkNode:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ; ---------------------------------------------------------------------------------------
    ; TODO: find out why this ugly hack is necessary, at some point the target language changes
    ; and eval context is set to the parent language 
    ; print "lang:" + (ctx.getTargetLang()) + " code " + (node.getCode())
    node.children.forEach({
      if(!null? item.evalCtx) {
        ;print " - item lang:" + (item.evalCtx.getTargetLang()) + " code " + (item.getCode())
        if( (getTargetLang (unwrap item.evalCtx ) )  != (ctx.getTargetLang())) {
          item.evalCtx.targetLangName = (ctx.getTargetLang())
          ;print "--> changing the code lang to " + ((ctx.getTargetLang()))
        }
      }
    })
    ; ------------------------------------------------------------------------------------------
    if( !null? node.evalCtx ) {
      this.compiler.WalkNode(node (unwrap node.evalCtx) wr)
    } {
      this.compiler.WalkNode(node ctx wr)
    }
  }
  fn writeTypeDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    wr.out(node.type_name false)
  }
  fn writeRawTypeDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    this.writeTypeDef(node ctx wr)
  }
  fn adjustType:string (tn:string) {
    return tn
  }

  fn defValueHasSideEffects:boolean (value:CodeNode) {
    if (value.has_call) {
      return true
    }
    if (value.hasFnCall) {
      return true
    }
    if (value.is_direct_method_call) {
      return true
    }
    return false
  }

  fn writeSideEffectOnlyStmt:void (value:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ctx.setInExpr()
    this.WalkNode(value ctx wr)
    ctx.unsetInExpr()
    if ((ctx.expressionLevel()) == 0) {
      wr.out(";" true)
    }
    wr.newline()
  }

  fn WriteVRef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (node.eval_type == RangerNodeType.Enum) {
      if( (array_length node.ns) > 1) {
        def rootObjName:string (itemAt node.ns 0)
        def enumName:string (itemAt node.ns 1)
        def e@(optional):RangerAppEnum (ctx.getEnum(rootObjName))
        if (!null? e) {
          wr.out(("" + (unwrap (get e.values enumName))) false)
          return
        }
      }
    }
    if ((array_length node.nsp) > 0) {
      for node.nsp p:RangerAppParamDesc i {
        if (i > 0) {
          wr.out("." false)
        }
        if ((strlen p.compiledName) > 0) {
          wr.outMapped((this.adjustType(p.compiledName)) node false p.name)
        } {
          if ((strlen p.name) > 0) {
            wr.outMapped((this.adjustType(p.name)) node false p.name)
          } {
            wr.outMapped((this.adjustType( (itemAt node.ns i))) node false (itemAt node.ns i))
          }
        }
      }
      return
    }
    for node.ns part:string i {
      if (i > 0) {
        wr.out("." false)
      }
      wr.outMapped((this.adjustType(part)) node false part)
    }
  }
  fn writeVarDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasParamDesc {
      def p:RangerAppParamDesc node.paramDesc
      if (p.set_cnt > 0) {
        wr.out(("var " + p.name) false)
      } {
        wr.out(("const " + p.name) false)
      }
      if ((array_length node.children) > 2) {
        wr.out(" = " false)
        ctx.setInExpr()
        def value:CodeNode (node.getThird())
        this.WalkNode(value ctx wr)
        ctx.unsetInExpr()
        wr.out(";" true)
      } {
        wr.out(";" true)
      }
    }
  }
  fn CreateCallExpression(node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.has_call {
      def obj:CodeNode (node.getSecond())
      def method:CodeNode (node.getThird())
      def args:CodeNode (itemAt node.children 3)

      this.writeCallReceiver(obj ctx wr)
      wr.out("." false)
      def methodName method.vref
      if ((!null? node.fnDesc) && ((strlen node.fnDesc.compiledName) > 0)) {
        methodName = node.fnDesc.compiledName
      }
      wr.outMapped(methodName method false method.vref)
;       this.WriteVRef(fc ctx wr)
      wr.out("(" false)
      ctx.setInExpr()

      def pms (filter (args.children) {
        if( item.hasFlag('keyword')) {
          return false
        }
        return true
      })
      
      for pms arg:CodeNode i {
        if (i > 0) {
          wr.out(", " false)
        }
        ; TODO: optionality check here ?
        this.WalkNode(arg ctx wr)
      }
      ctx.unsetInExpr()
      wr.out(")" false)
      if ((ctx.expressionLevel()) == 0) {
        wr.out(";" true)
      }
    }    
  }

;         langWriter.CreateMethodCall(node ctx wr)

  fn CreateMethodCall(node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ; property access...
      def obj:CodeNode (node.getFirst())
      def args:CodeNode (node.getSecond())
      ctx.setInExpr()
      this.WalkNode( obj ctx wr)
      ctx.unsetInExpr()
      wr.out('(' false)
      ctx.setInExpr()

      def pms (filter (args.children) {
        if( item.hasFlag('keyword')) {
          return false
        }
        return true
      })

      for pms arg:CodeNode i {
        if (i > 0) {
          wr.out(', ' false)
        }
        ; TODO: optionality check here ?
        this.WalkNode(arg ctx wr)
      }
      ctx.unsetInExpr()
      wr.out(')' false)
  }


  fn CreatePropertyGet(node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ; property access...
      def obj:CodeNode (node.getSecond())
      def prop:CodeNode (node.getThird())
      this.writeCallReceiver(obj ctx wr)
      wr.out('.' false)
      this.WalkNode(prop ctx wr)
  }



                  optSharedT = pOptN.type_name
                }
                def optSegShared:boolean (this.rustClassIsShared(optSharedT ctx))
                ; …and the field's own mark answers it too: writeStructField
                ; gives an Option<Rc<RefCell<T>>> to anything carrying
                ; rust_needs_rc_wrap, so the unwrap hands out an Rc there
                ; whatever the class-level question says. Without this the
                ; segment after it read a field straight off the handle.
                if (optSegShared == false) {
                  if p.rust_needs_rc_wrap {
                    if (((strlen optSharedT) > 0) && (p.rust_static_str == false)) {
                      optSegShared = true
                    }
                  }
                }
                if (root_is_immutable_borrow || optSegShared) {
                  wr.out(".as_ref().unwrap()" false)
                } {
                  ; Check if we're on LHS of assignment - need as_mut
                  if (ctx.isInLhs()) {
                    wr.out(".as_mut().unwrap()" false)
                  } {
                    ; …and a call RECEIVER takes the borrow the callee needs.
                    ; `as_mut()` there asks for `&mut self` from a method the
                    ; analysis proved does not need one, and the two used to
                    ; disagree; where the callee is positively known to take
                    ; `&self`, the shared form is what it wants. Everything
                    ; else keeps the mutable default.
                    if rust_writing_call_receiver {
                      if rust_receiver_shared_known {
                        wr.out(".as_ref().unwrap()" false)
                      } {
                        wr.out(".as_mut().unwrap()" false)
                      }
                    } {
                      ; …and a plain READ has no method to mutate through:
                      ; `self.fdct.zigzagOrder[i]` asked for `&mut self` in a
                      ; `&self` method for a field it only reads
                      if rust_writing_mut_arg {
                        wr.out(".as_mut().unwrap()" false)
                      } {
                        wr.out(".as_ref().unwrap()" false)
                      }
                    }
                  }
                }
                if optSegShared {
                  if rust_writing_mut_arg {
                    wr.out(".borrow_mut()" false)
                  } {
                    if (rust_writing_call_receiver || ctx.in_lhs_of_assignment) {
                      if ((ctx.in_lhs_of_assignment == false) && (rust_call_receiver_mut == false)) {
                        wr.out(".borrow()" false)
                      } {
                        wr.out(".borrow_mut()" false)
                      }
                    } {
                      wr.out(".borrow()" false)
                    }
                  }
                }
              }
            }
          }
        }
        }
        if (p.isClass()) {
          had_static = true
        }
        ; the LAST segment of a path that names a cell field is read out of
        ; its cell — the field is a Cell wherever it is reached from, not only
        ; inside its own class
        if (i == (nsp_len - 1)) {
          if p.rust_interior_cell {
            if (this.rustCellIsCollection(p)) {
              if (rust_in_cell_assign == false) {
                if ctx.in_lhs_of_assignment {
                  wr.out(".borrow_mut()" false)
                } {
                  wr.out(".borrow()" false)
                }
              }
            } {
              if (ctx.in_lhs_of_assignment == false) {
                if (this.rustCellIsCopy(p)) {
                  wr.out(".get()" false)
                } {
                  wr.out((((".borrow().clone(); " + cellPathTmp) + " }")) false)
                }
              }
            }
          }
        }
      }
      return
    }

    if node.hasParamDesc {
      def part:string (itemAt node.ns 0)
      def p:RangerAppParamDesc (unwrap node.paramDesc)
      ; a cell field is READ out of its cell; the write side is the
      ; assignment, which calls set() instead. A STRING cell is read inside a
      ; block so the Ref is dropped before the statement continues — and the
      ; block has to open before the `self.` the prefix below writes.
      def cellRdTmp:string ""
      if p.rust_interior_cell {
        if (ctx.in_lhs_of_assignment == false) {
          if ((this.rustCellIsCopy(p)) == false) {
            if ((this.rustCellIsCollection(p)) == false) {
              cellRdTmp = (ctx.rustGetTempVar())
              wr.out((("{ let " + cellRdTmp) + " = ") false)
            }
          }
        }
      }
      if ((part != "this") && (ctx.isMemberVariable(part))) {
        def uc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
        def currC:RangerAppClassDesc (unwrap uc)
        def up@(optional):RangerAppParamDesc (currC.findVariable(part))
        if (!null? up) {
          if( false == (ctx.isInStatic()) ) {
            wr.out(((this.rustThisPathPrefix(ctx)) + ".") false)
          }
        }
      }
      if p.rust_interior_cell {
        wr.out((this.adjustType(p.compiledName)) false)
        ; a COLLECTION is used in place — read through borrow(), mutated
        ; through borrow_mut(); the mutating operators mark their target the
        ; same way an assignment does
        if (this.rustCellIsCollection(p)) {
          if rust_in_cell_assign {
            return
          }
          if ctx.in_lhs_of_assignment {
            wr.out(".borrow_mut()" false)
          } {
            wr.out(".borrow()" false)
          }
          return
        }
        if ctx.in_lhs_of_assignment {
          return
        }
        if (this.rustCellIsCopy(p)) {
          wr.out(".get()" false)
        } {
          wr.out(((".borrow().clone(); " + cellRdTmp) + " }") false)
        }
        return
      }
      wr.out((this.adjustType(p.compiledName)) false)
      ; A bare name that resolves to a weak FIELD is read here, not in the
      ; nsp walk above — `def non:ClassDesc currentClass` has one segment
      ; and no path desc — so the upgrade has to be written here too, or
      ; the reader gets the Weak where it declared an Rc (E0308).
      def pWeakTail:RangerAppParamDesc (unwrap node.paramDesc)
      this.writeRustWeakVRefTail(node pWeakTail ctx wr)
      return
    }

    def b_was_static:boolean false
    for node.ns part:string i {
      if (i > 0) {
        if ((i == 1) && b_was_static) {
          wr.out("::" false)
        } {
          wr.out("." false)
        }
      }
      if (i == 0) {
        if (ctx.hasClass(part)) {
          b_was_static = true
        }
        if ((part != "this") && (ctx.hasCurrentClass())) {
          def uc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
          def currC:RangerAppClassDesc (unwrap uc)
          def up@(optional):RangerAppParamDesc (currC.findVariable(part))
          if (!null? up) {
            if( false == (ctx.isInStatic()) ) {
              wr.out(((this.rustThisPathPrefix(ctx)) + ".") false)
            }
          }
        }
      }
      wr.out((this.adjustType(part)) false)
    }
  }
  ; A shared class in a return position hands out the Rc
  ; (PLAN_RUST_OWNERSHIP 2b); every other return type is unchanged.
  ; closes a signature: ")" then " -> T", with the arrow dropped for a void
  ; function — `-> ()` is never needed
  fn writeRustFnClose:void (variant:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    wr.out(")" false)
    def fcnn:CodeNode (unwrap variant.nameNode)
    if (((strlen fcnn.array_type) == 0) && ((strlen fcnn.key_type) == 0)) {
      if (fcnn.type_name == "void") {
        return
      }
    }
    wr.out(" -> " false)
    this.writeRustReturnType(variant ctx wr)
  }

  fn writeRustReturnType:void (variant:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    def vnn:CodeNode (unwrap variant.nameNode)
    if (((strlen vnn.array_type) == 0) && ((strlen vnn.key_type) == 0)) {
      if (this.rustClassIsShared(vnn.type_name ctx)) {
        ; NOTE: a `@(weak)` return could hand back the Weak, matching the
        ; local it usually returns, but every CALLER binds the result to an
        ; Rc name — declaring the Weak form here costs more than the returns
        ; it fixes (1630 -> 1915). The upgrade belongs at the `return`, which
        ; is a change to make with the rest of the weak modelling.
        def retSharedT:string (this.rustSharedTypeString(vnn.type_name ctx))
        ; an @(optional) return keeps its Option around the Rc
        if (vnn.hasFlag("optional")) {
          wr.out((("Option<" + retSharedT) + ">") false)
        } {
          wr.out(retSharedT false)
        }
        return
      }
    }
    rust_writing_return_type = true
    this.writeTypeDef(vnn ctx wr)
    rust_writing_return_type = false
  }

  ; Does this expression read through a shared cell (a field path rooted in
  ; an Rc<RefCell> name) or call anything that might? Used to decide whether
  ; an assignment must pre-evaluate its right side.
  ; Does this expression read a FIELD out of `name` — `cc.parent`, not the
  ; bare `cc`? Such a read borrows the cell `name` holds, and a store into
  ; `name` in the same statement would end that borrow while it is still
  ; live (E0506).
  fn rustExprReadsThrough:boolean (node:CodeNode name:string) {
    if ((array_length node.ns) >= 2) {
      if ((itemAt node.ns 0) == name) {
        return true
      }
    }
    for node.children ch:CodeNode i {
      if (this.rustExprReadsThrough(ch name)) {
        return true
      }
    }
    return false
  }

  fn rustRhsReadsSharedCell:boolean (node:CodeNode) {
    if ((array_length node.ns) >= 2) {
      if ((array_length node.nsp) > 0) {
        def rp:RangerAppParamDesc (itemAt node.nsp 0)
        if rp.rust_needs_rc_wrap {
          return true
        }
      }
    }
    if node.hasFnCall {
      return true
    }
    for node.children child:CodeNode i {
      if (this.rustRhsReadsSharedCell(child)) {
        return true
      }
    }
    return false
  }

  ; The parent fields a subclass has to carry in its own layout. Rust has no
  ; inheritance: `struct Cat` gets nothing from `struct Animal`, so a field
  ; the parent declares is simply absent — "no field `name` on type `Cat`".
  ; Every ancestor's variables are collected here, nearest first, skipping any
  ; the class already declares itself (Ranger lets a subclass restate a
  ; parent's field, and it names the same slot, so a second copy would be a
  ; second slot).
  ; The fields of `cl` in layout order: its own, then everything it inherits
  ; and has not restated.
  ; The Rust type of a field, without its name — shared by the struct
  ; declaration and by the trait accessors that hand the field out.
  ; Is the segment at `idx` of this path read out of a parent-typed
  ; reference? Its owner is the segment before it, and a class that is
  ; extended by children is written as `Rc<RefCell<dyn XTrait>>` — methods
  ; and no fields — so the field has to come from a trait accessor.
  ; A `dyn Trait` has no fields, and the compiler reads a parent's fields
  ; through parent-typed references everywhere. The trait therefore hands out
  ; each field of the trait-defining class by reference: `rgf_x()` to read,
  ; `rgf_x_mut()` to write or mutate in place. Every implementor carries the
  ; field in its own layout (rustAllStructVars flattens inherited fields
  ; down), so both bodies are the same one line whichever struct implements it.
  ; Is this field a Copy scalar? Such a field is handed back by value, not by
  ; reference: `&bool` where a `bool` is wanted is a type error at every
  ; single read, and a copy of an i64 is what the reference would have been
  ; dereferenced into anyway.
  ; A plain `string` field. Its read accessor hands back an owned String
  ; rather than a `&String`: a borrowed one reached call sites that add
  ; their own `&` — `map.contains_key(&x.rgf_name())` becomes `&&String`,
  ; which satisfies no Borrow bound — and every reader of a string field in
  ; the compiler wants a value it can keep anyway.
  ; --- build-then-fill, written as the value it builds ----------------------
  ; `def line (new CartLine)` and the field assignments that follow are one
  ; initialization; StaticAnalyzer.foldObjectInitsAll said so and checked the
  ; conditions (CodeNode.rg_init_fold). Rust builds the finished value:
  ;
  ;   let mut line : CartLine = CartLine { name: …, cents: …, qty: … };
  ;
  ; A run that leaves some field alone takes the rest from the constructor --
  ; `..CartLine::new()` -- which is exact whatever the subset, and is left off
  ; when the run covers every field (Rust rejects a base it cannot use).
  ; The statements the run swallowed are disabled here rather than in the
  ; analysis: the marking is target-neutral, and a writer that does not spell
  ; this form has to go on emitting them.
  ; Can THIS writer spell the folded run? The analysis answered the
  ; target-neutral half -- that the run is one initialization. The half that is
  ; Rust's is which conversions the statement form was doing on the way into
  ; the field, because a struct literal does none of them: a `@(weak)` field
  ; takes `Some(Rc::downgrade(&x))`, an `@(optional)` one `Some(x)`, a
  ; promoted `&'static str` field refuses the `.to_string()` an owned position
  ; adds, a cell field is written through `set`, and a shared field wants an
  ; Rc. Each of those is a case in the `=` handler; none of them is folded.
  ; When any field needs one, this returns false having written nothing and
  ; the ordinary path runs, statements and all.
  fn rustFoldedInitIsWritable:boolean (node:CodeNode ctx:RangerAppWriterContext) {
    def value:CodeNode (itemAt node.children 2)
    def clNode:CodeNode (value.getSecond())
    def cl:RangerAppClassDesc (ctx.findClass(clNode.vref))
    def cnt:int (array_length node.rg_init_fields)
    def i:int 0
    while (i < cnt) {
      def fName:string (itemAt node.rg_init_fields i)
      def fVal:CodeNode (itemAt node.rg_init_values i)
      def found:boolean false
      for cl.variables fv:RangerAppParamDesc fvi {
        if (fv.name == fName) {
          found = true
          def fNN@(optional):CodeNode fv.nameNode
          if (null? fNN) {
            return false
          }
          def fN:CodeNode (unwrap fNN)
          if (fN.hasFlag("weak")) {
            return false
          }
          if (fN.hasFlag("optional")) {
            return false
          }
          ; a collection field converts on the way in (.to_vec(), .clone())
          if ((strlen fN.array_type) > 0) {
            return false
          }
          if ((strlen fN.key_type) > 0) {
            return false
          }
          if fv.rust_static_str {
            return false
          }
          if fv.rust_interior_cell {
            return false
          }
          if fv.rust_needs_rc_wrap {
            return false
          }
          if ((strlen fN.type_name) > 0) {
            if (ctx.isDefinedClass(fN.type_name)) {
              if (this.rustClassIsShared(fN.type_name ctx)) {
                return false
              }
              def fCl:RangerAppClassDesc (ctx.findClass(fN.type_name))
              if fCl.is_union {
                return false
              }
              ; a shape field: the value is wrapped into its enum variant by
              ; rustWriteUnionValue, which a plain literal does not do
              if (this.unionIsSealable(fCl ctx)) {
                return false
              }
            }
          }
        }
      }
      if (found == false) {
        return false
      }
      ; …and the VALUE: `this` is `__self_rc` in a value position, a borrowed
      ; &str or slice needs the conversion the assignment writes
      def fvReal:CodeNode (this.rustUnwrapParens(fVal))
      if (fvReal.vref == "this") {
        return false
      }
      if (this.rustStrRefRead(fVal)) {
        return false
      }
      if (this.rustSliceRefRead(fVal)) {
        return false
      }
      i = i + 1
    }
    return true
  }

  ; Does the body go on writing to this local after the fold? The fold
  ; absorbs the run of field assignments that directly follows the `new`,
  ; and a body can write more further down -- in a branch, or after an
  ; intervening statement. Those keep the `mut`; the ones that do not are
  ; finished the moment they are bound.
  ; Ask for `#![allow(name)]`, once per file. Writing into the slice is what
  ; puts the line at the top; the call can come from anywhere.
  ; Does any name in this program keep its camelCase spelling? adjustType
  ; renames to snake_case unless the snake_case form is already some OTHER
  ; name here, in which case the original stays and rustc's non_snake_case
  ; fires on it. The whole name set answers the same question at once.
  fn rustNeedsNonSnakeCase:boolean () {
    for rustIdentNames nsV:boolean nsName:string {
      if ((strlen nsName) == 0) {
        continue
      }
      def nsSn:string (this.rustSnakeCase(nsName))
      ; a TYPE name keeps its spelling on this target whatever the set says,
      ; so a generic parameter `S` beside a local `s` is not a collision --
      ; it was every study in the gallery asking for the allow
      def nsLead@(units):int (charAt nsName 0)
      if ((nsLead < 65) || (nsLead > 90)) {
        if (nsSn != nsName) {
          if (has rustIdentNames nsSn) {
            return true
          }
        }
      }
    }
    return false
  }

  fn rustNeedAllow:void (name:string wr:CodeWriter) {
    if (has rustAllowSeen name) {
      return
    }
    if ((wr.hasTag("file_attributes")) == false) {
      return
    }
    set rustAllowSeen name true
    def naW:CodeWriter (wr.getTag("file_attributes"))
    naW.out((("#![allow(" + name) + ")]") true)
  }


  ; The same for a clippy lint, with the note that says why any of them are
  ; here written before the first one.
  fn rustNeedClippyAllow:void (name:string wr:CodeWriter) {
    def ncKey:string ("clippy::" + name)
    if (has rustAllowSeen ncKey) {
      return
    }
    if ((wr.hasTag("file_attributes")) == false) {
      return
    }
    set rustAllowSeen ncKey true
    def ncW:CodeWriter (wr.getTag("file_attributes"))
    if (rustClippyNoteWritten == false) {
      rustClippyNoteWritten = true
      ncW.out("// The clippy allows below cover shapes that mirror the Ranger source" true)
      ncW.out("// itself, which the transpiler must not rewrite or rename." true)
    }
    ncW.out((("#![allow(clippy::" + name) + ")]") true)
  }

  ; Is there a use of this local reached THROUGH its name -- `hit.ok = false`,
  ; `c.add(...)`, `decl.types.push(...)` -- at a line beyond `minLine`? Pass a
  ; negative minLine to ask about the whole method body.
  fn rustNmIsName:boolean (seg:string a:string b:string) {
    return ((seg == a) || (seg == b))
  }

  ; Does this local have to be `mut`? `set_cnt` answers for a name that is
  ; assigned; everything else is reached THROUGH the name, and the four ways
  ; that can mutate are here. A local that none of them touches binds `let`,
  ; and rustc says so when this is wrong -- which is the point: the header
  ; asks for `unused_mut` only where the answer could not be had.
  fn rustLocalNeedsMut:boolean (srcName:string cName:string typeName:string ctx:RangerAppWriterContext) {
    def nmM@(optional):RangerAppFunctionDesc (ctx.getCurrentMethod())
    if (null? nmM) {
      return true
    }
    def nmFn:RangerAppFunctionDesc (unwrap nmM)
    def nmBO@(optional):CodeNode nmFn.fnBody
    if (null? nmBO) {
      return true
    }
    def nmBody:CodeNode (unwrap nmBO)
    def nmNeeds:boolean false
    nmBody.forTree({
      if ((array_length item.children) >= 2) {
        def nmH:CodeNode (item.getFirst())
        ; `name.field = …`
        if ((nmH.vref == "=") && ((array_length item.children) >= 3)) {
          def nmL:CodeNode (itemAt item.children 1)
          if ((array_length nmL.ns) >= 2) {
            if (this.rustNmIsName((itemAt nmL.ns 0) srcName cName)) {
              nmNeeds = true
            }
          }
        }
        ; `push name v`, `set name k v`, `buffer_set name …` -- an operator
        ; that writes through its first operand
        if (this.rustIsMutatingOpName(nmH.vref)) {
          def nmT:CodeNode (itemAt item.children 1)
          if ((array_length nmT.ns) >= 1) {
            if (this.rustNmIsName((itemAt nmT.ns 0) srcName cName)) {
              nmNeeds = true
            }
          }
        }
      }
      if (item.hasFnCall) {
        def nmFc:CodeNode (item.getFirst())
        def nmSegs:int (array_length nmFc.ns)
        ; `name.m(…)` -- mut exactly when `m` is emitted `&mut self`.
        ; rust_mut_self is settled for every class before the first line is
        ; written. A longer path, or a class or method that will not resolve,
        ; keeps the mut.
        if (nmSegs >= 2) {
          if (this.rustNmIsName((itemAt nmFc.ns 0) srcName cName)) {
            if (nmSegs != 2) {
              nmNeeds = true
            } {
              def nmClO@(optional):RangerAppClassDesc (ctx.findClass(typeName))
              if (null? nmClO) {
                nmNeeds = true
              } {
                def nmCl:RangerAppClassDesc (unwrap nmClO)
                def nmMd@(optional):RangerAppFunctionDesc (nmCl.findMethod((itemAt nmFc.ns 1)))
                if (null? nmMd) {
                  nmNeeds = true
                } {
                  def nmMdD:RangerAppFunctionDesc (unwrap nmMd)
                  if nmMdD.rust_mut_self {
                    nmNeeds = true
                  }
                }
              }
            }
          }
        }
        ; `f(name)` where the callee takes that parameter by `&mut`
        if ((array_length item.children) > 1) {
          def nmArgs:CodeNode (item.getSecond())
          def nmFd@(optional):RangerAppFunctionDesc item.fnDesc
          for nmArgs.children nmA:CodeNode nmAi {
            def nmAr:CodeNode nmA
            while (nmAr.expression && ((array_length nmAr.children) == 1)) {
              nmAr = (nmAr.getFirst())
            }
            if ((array_length nmAr.ns) == 1) {
              if (this.rustNmIsName((itemAt nmAr.ns 0) srcName cName)) {
                if (null? nmFd) {
                  nmNeeds = true
                } {
                  def nmFdD:RangerAppFunctionDesc (unwrap nmFd)
                  if ((array_length nmFdD.params) > nmAi) {
                    def nmP:RangerAppParamDesc (itemAt nmFdD.params nmAi)
                    if (nmP.rust_borrow_type == 2) {
                      nmNeeds = true
                    }
                  } {
                    nmNeeds = true
                  }
                }
              }
            }
          }
        }
      }
    })
    return nmNeeds
  }

  fn rustLocalPathUseAfter:boolean (srcName:string cName:string minLine:int ctx:RangerAppWriterContext) {
    def puM@(optional):RangerAppFunctionDesc (ctx.getCurrentMethod())
    if (null? puM) {
      return true
    }
    def puFn:RangerAppFunctionDesc (unwrap puM)
    def puBodyO@(optional):CodeNode puFn.fnBody
    if (null? puBodyO) {
      return true
    }
    def puBody:CodeNode (unwrap puBodyO)
    def puFound:boolean false
    puBody.forTree({
      if ((array_length item.ns) >= 2) {
        ; the tree carries the source name, the `let` is written with the
        ; compiled one -- they differ wherever a local was renamed away from
        ; a collision (`g` -> `g_1`), so both have to match
        def puHead:string (itemAt item.ns 0)
        if ((puHead == srcName) || (puHead == cName)) {
          if ((item.getLine()) > minLine) {
            puFound = true
          }
        }
      }
    })
    return puFound
  }

  fn rustFoldedLocalIsWrittenAgain:boolean (srcName:string cName:string node:CodeNode ctx:RangerAppWriterContext) {
    def flM@(optional):RangerAppFunctionDesc (ctx.getCurrentMethod())
    if (null? flM) {
      return true
    }
    def flFn:RangerAppFunctionDesc (unwrap flM)
    def flBodyO@(optional):CodeNode flFn.fnBody
    if (null? flBodyO) {
      return true
    }
    def flBody:CodeNode (unwrap flBodyO)
    def flFound:boolean false
    ; the absorbed assignments are still in the tree -- the fold marks them
    ; rather than removing them -- so the line to compare against is the last
    ; one the literal took, not the `def` itself
    def flFoldLine:int (node.getLine())
    for node.rg_init_values flV:CodeNode flVi {
      def flVLine:int (flV.getLine())
      if (flVLine > flFoldLine) {
        flFoldLine = flVLine
      }
    }
    flBody.forTree({
      ; a write reached THROUGH the name -- `hit.ok = false`,
      ; `decl.param_types.push(...)` -- anywhere below the fold itself
      if ((array_length item.ns) >= 2) {
        ; the tree carries the source name, the `let` is written with the
        ; compiled one -- they differ wherever a local was renamed away from
        ; a collision (`g` -> `g_1`), so both have to match
        def flHead:string (itemAt item.ns 0)
        if ((flHead == srcName) || (flHead == cName)) {
          if ((item.getLine()) > flFoldLine) {
            flFound = true
          }
        }
      }
    })
    return flFound
  }

  fn rustWriteFoldedInit:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def nn:CodeNode (itemAt node.children 1)
    def p:RangerAppParamDesc nn.paramDesc
    def value:CodeNode (itemAt node.children 2)
    def clNode:CodeNode (value.getSecond())
    def clName:string clNode.vref

; SPDX-License-Identifier: MIT

Import "EnumAnalysis.rgr"

; Helper class to hold a list of method names (for call graph)
class MethodCallList {
  def calls:[string]
  
  Constructor () {
    def c:[string]
    calls = c
  }
  
  fn add:void (methodName:string) {
    push calls methodName
  }
}

class RangerRustClassWriter {
  ; True while a method-call receiver is being written: the receiver of a
  ; call must borrow mutably (every method takes &mut self), where a plain
  ; field read borrows shared so that two reads of one cell can overlap.
  def rust_writing_call_receiver:boolean false
  ; the receiver borrow mode for the call being written: false when the
  ; called method takes &self, so WriteVRef borrows shared and an argument
  ; aliasing the receiver cannot panic the RefCell at runtime
  def rust_call_receiver_mut:boolean true
  ; set when a signature has just written `&self`/`&mut self` so that
  ; writeArgsDef knows to lead with a comma — and only then, so an empty
  ; parameter list closes as `(&mut self)` and not `(&mut self, )`
  def rust_receiver_written:boolean false
  ; a trait method signature has no body, and Rust allows no pattern in one:
  ; `mut x : T` there is "patterns aren't allowed in functions without
  ; bodies". The binding mode is the implementor's business anyway.
  def rust_in_trait_decl:boolean false
  ; set while the `unwrap` handler walks its own argument. That handler adds
  ; the upgrade of a weak field itself, so the path writer must not add a
  ; second one for the same read.
  def rust_in_weak_unwrap:boolean false
  ; set while an in-place COLLECTION operator writes its target — push,
  ; clear, remove_index, array_extract. The target is written through, so a
  ; trait accessor on its path hands back `&mut`, but the operator calls a
  ; method on that reference rather than assigning to it: the `*` a real
  ; assignment target needs would be dereferencing the method's own result.
  def rust_lhs_is_receiver:boolean false
  ; set while a function's RETURN type is written. A `@(weak)` return is
  ; still an owned handle — see writeTypeDef.
  def rust_writing_return_type:boolean false
  ; set while the body of a method emitted WITHOUT a receiver is written. Such
  ; a method reaches its own object only through the hidden __self_rc, and it
  ; takes the borrow per statement rather than for the whole call — which is
  ; what lets `def root (this.getRoot())` followed by a write through `root`
  ; run when the root IS this object.
  def rust_receiverless_method:boolean false
  ; Set while the trait declaration and the trait impls of a RE-ENTRANT trait
  ; family are being written. There `Self` is `Rc<RefCell<C>>`, so `&self` IS
  ; the handle the inherent method wants as `__self_rc`: the signature must
  ; not also declare one, and the forwarding body passes `self` for it.
  ; docs/plans/PLAN_RUST_REENTRANCY.md.
  def rust_trait_self_is_handle:boolean false
  ; set while a call receiver is written and the callee is known to mutate
  def rust_receiver_mut_known:boolean false
  ; the class whose method body is being written. ctx.getCurrentClass() can
  ; answer with something else by the time a call receiver is emitted, and a
  ; `this.m(…)` has to resolve `m` in the class that actually declares it.
  def rust_emit_class_name:string ""
  ; set while a call receiver is written and the callee is known to take &self
  def rust_receiver_shared_known:boolean false
  ; what CreatePropertyGet already settled about the object in front of a
  ; `(expr).field`: 0 unknown, 1 the borrow is written, 2 the object is not
  ; a shared class. The field-tail rule in WriteVRef guesses from the field
  ; NAME alone, and only where this says nothing.
  def rust_prop_base_state:int 0
  ; set while a call RECEIVER that is an expression is written and the
  ; callee writes through it: every cell on the way to the place borrows
  ; mutably
  def rust_recv_place_mut:boolean false
  ; set while a plain-path ARGUMENT is written that the callee takes by
  ; `&mut`. An Rc handle on that path has to borrow mutably: `&mut
  ; sc.borrow().zone` is a `&mut` into a shared borrow.
  def rust_writing_mut_arg:boolean false
  ; set while a call receiver PATH is written whose head is `this` and whose
  ; target is a field held inline: the callee borrows the field, and the
  ; field is part of this struct, so the head takes the mutable borrow
  def rust_path_head_mut:boolean false
  ; set once the receiver-mutability pre-pass has a first answer for every
  ; class, so a later pass may ask what a call through a FIELD does. On the
  ; first pass nothing is settled and every answer would read the
  ; conservative default, which marks the whole program `&mut self`.
  def rust_field_call_mut_ready:boolean false
  ; set while a STRUCT FIELD's type is written. A borrowed closure needs a
  ; lifetime to sit in a struct, and the struct has none; an owned one does
  ; not. A parameter keeps the borrow, which is what call sites pass.
  def rust_writing_field_type:boolean false

  Extends (RangerGenericClassWriter)
  def compiler:LiveCompiler
  def thisName:string "self"
  ; The declared return type of the function being written, when it is a
  ; sealable union: a `return` of one MEMBER of the family has to be wrapped in
  ; its enum variant, exactly as an argument or a field assignment is.
  ; Empty for every other function.
  def rustFnReturnsUnion:string ""
  ; the declared return of the function being written, so a `return` can
  ; ask what shape the caller is expecting
  def rustFnReturnNameNode@(optional):CodeNode
  def fileHeaderWritten:boolean false
  ; Which `#![allow(...)]` lines the file has asked for. The block lives in
  ; the "file_attributes" slice, which sits ahead of everything else and stays
  ; open for the whole file, so a line can be added the moment the writer
  ; emits a shape that needs it -- and never if it does not. An allow written
  ; for every file whether or not it applies is a pragma that hides the
  ; backend's own regressions; this way rustc and clippy report them.
  def rustAllowSeen:[string:boolean]
  def rustClippyNoteWritten:boolean false
  ; every identifier name in the program, for the snake_case collision guard.
  ; adjustType is called from 40-odd places with no ctx to hand, so the SET is
  ; what gets parked here — filled once by the header pass, which has one.
  def rustIdentNames:[string:boolean]
  def rustIdentNamesDone:boolean false
  ; PLAN_RUST_SEMANTIC_IDIOMS F: which Ranger `Enum`s are written as a Rust
  ; `enum` rather than lowered to i64. The rules are target-neutral -- C++ asks
  ; the same question of `enum class` -- so they live in EnumNativeAnalysis.
  def rustEnums:EnumNativeAnalysis (new EnumNativeAnalysis())
  ; writing the TARGET of a cell assignment: the whole collection is being
  ; replaced, so the path names the RefCell itself rather than borrowing it
  def rust_in_cell_assign:boolean false
  ; the local a call receiver was hoisted into, for the hidden __self_rc
  ; argument that follows it: reading the field a second time to build that
  ; argument puts the borrow back that the hoist just took away
  def rust_last_recv_tmp:string ""
  ; Set while the hidden receiver's PATH is being written into a `let`, so
  ; the leading `&` is left off. See writeSelfRcReceiverHoist.
  def rust_selfrc_path_only:boolean false
  ; computing the family's mutation answer. The inherited-graph walk otherwise
  ; marks every trait method as mutating on principle — which is the blanket
  ; this analysis exists to replace, and feeding it back in makes the answer
  ; "yes" before a single body has been looked at.
  def rust_computing_family_mut:boolean false
  
  ; Rust needs semicolons at end of statements
  fn lineEnding:string () {
    return ";"
  }
  
  ; Escape Rust reserved words by prefixing with r#
  ; --- snake_case identifiers (PLAN_RUST_SEMANTIC_IDIOMS L) -------------------
  ; Every generated file used to carry `#![allow(non_snake_case)]` and the 708
  ; warnings behind it, because a Ranger `parseInt` came out as `parseInt`.
  ;
  ; The documented blocker was `@serialize(true)`, whose JSON keys must not move
  ; when a field is renamed. They do not: the serializer generates a Ranger
  ; `toDictionary` that writes `pvar.name` — the name as WRITTEN — as the key,
  ; and the field access beside it goes through the same rename as every other
  ; access. The wire format is tied to the source name, not to the emitted one.
  ;
  ; The other hazard is that a `.` path segment can be a field or a method and
  ; the writer often cannot tell which at the point it writes one. That stops
  ; mattering when BOTH are renamed the same way, which is why this is one
  ; transform applied at one place rather than two applied selectively.
  ;
  ; Type names are not renamed: `adjustType` is called only for identifiers in
  ; this writer — fields, locals, parameters, methods and path segments — and a
  ; class name reaches the output through `cl.name`.
  ; Two Ranger names can snake_case to one Rust name. `FlowStdMatch` has a local
  ; `pluginFn` assigned into an outer `plugin_fn`, and renaming the first gave
  ; `plugin_fn = plugin_fn.clone()` — a variable shadowing itself. That is the
  ; one way this transform can change the meaning of a program rather than just
  ; fail, so a name whose snake_case form is ALREADY a name somewhere in the
  ; program keeps its spelling. The set is every identifier the writer can see:
  ; class fields, method names, parameters and every vref in every body.
  fn rustFillIdentNames:void (ctx:RangerAppWriterContext) {
    if rustIdentNamesDone {
      return
    }
    rustIdentNamesDone = true
    def inRoot:RangerAppWriterContext (ctx.getRoot())
    for inRoot.definedClasses icl:RangerAppClassDesc ici {
      for icl.variables iv:RangerAppParamDesc ivi {
        set rustIdentNames iv.name true
      }
      this.rustCollectFnNames(icl.methods)
      this.rustCollectFnNames(icl.static_methods)
    }
  }

  fn rustCollectFnNames:void (fns:[RangerAppFunctionDesc]) {
    for fns fd:RangerAppFunctionDesc fi {
      set rustIdentNames fd.name true
      for fd.params fp:RangerAppParamDesc fpi {
        set rustIdentNames fp.name true
      }
      def bOpt@(optional):CodeNode fd.node
      if (!null? bOpt) {
        this.rustCollectVrefs((unwrap bOpt))
      }
    }
  }

  fn rustCollectVrefs:void (node:CodeNode) {
    if ((strlen node.vref) > 0) {
      set rustIdentNames node.vref true
    }
    for node.children ch:CodeNode i {
      this.rustCollectVrefs(ch)
    }
  }

  fn rustSnakeCase:string (n:string) {
    def ln:int (strlen n)
    if (ln == 0) {
      return n
    }
    def out:string ""
    def i:int 0
    while (i < ln) {
      def ch:string (substring n i (i + 1))
      def lower:string (to_lowercase ch)
      if (ch != lower) {
        ; an underscore goes in only BETWEEN things: never at the start, where
        ; it would mean "deliberately unused" to rustc, and never after one
        if (i > 0) {
          def prev:string (substring n (i - 1) i)
          def prevIsLower:boolean (prev != (to_uppercase prev))
          def nextIsLower:boolean false
          if ((i + 1) < ln) {
            def nxt:string (substring n (i + 1) (i + 2))
            if (nxt != (to_uppercase nxt)) {
              nextIsLower = true
            }
          }
          ; `parseInt` -> parse_int (lower then upper), and `HTTPServer` ->
          ; http_server (a run of capitals ending where a word begins)
          if (prevIsLower || nextIsLower) {
            if (prev != "_") {
              out = (out + "_")
            }
          }
        }
        out = (out + lower)
      } {
        out = (out + ch)
      }
      i = (i + 1)
    }
    return out
  }

  ; An identifier that may in fact be a TYPE name — the first segment of a
  ; static path is `InputFSFolder`, not a field — keeps its spelling. Renaming
  ; it gave `input_fs_folder::fromDictionary`, which rustc reads as a module.
  fn adjustIdentOrType:string (n:string ctx:RangerAppWriterContext) {
    if (ctx.isDefinedClass(n)) {
      return (this.adjustReserved(n))
    }
    return (this.adjustType(n))
  }

  fn adjustType:string (tn:string) {
    def sn:string (this.rustSnakeCase(tn))
    if (sn != tn) {
      if (has rustIdentNames sn) {
        ; the snake_case spelling is already some other name in this program,
        ; so the original stays. rustNeedsNonSnakeCase asks the same question
        ; of the whole name set, once, for the header.
        return (this.adjustReserved(tn))
      }
    }
    return (this.adjustReserved(sn))
  }

  ; the rename, with the collision guard. Everything that writes an identifier
  ; goes through adjustType, which does not have a ctx; this is the entry the
  ; two path emitters use, where one is available.
  fn adjustReserved:string (tn:string) {
    switch tn {
      case "type" { return "r#type" }
      case "static" { return "r#static" }
      case "async" { return "r#async" }
      case "await" { return "r#await" }
      case "dyn" { return "r#dyn" }
      case "impl" { return "r#impl" }
      case "trait" { return "r#trait" }
      case "mod" { return "r#mod" }
      case "pub" { return "r#pub" }
      case "use" { return "r#use" }
      case "extern" { return "r#extern" }
      case "crate" { return "r#crate" }
      case "super" { return "r#super" }
      case "where" { return "r#where" }
      case "unsafe" { return "r#unsafe" }
      case "move" { return "r#move" }
      case "ref" { return "r#ref" }
      case "mut" { return "r#mut" }
      case "const" { return "r#const" }
      case "match" { return "r#match" }
      case "as" { return "r#as" }
      case "abstract" { return "r#abstract" }
      case "become" { return "r#become" }
      case "box" { return "r#box" }
      case "do" { return "r#do" }
      case "final" { return "r#final" }
      case "macro" { return "r#macro" }
      case "override" { return "r#override" }
      case "priv" { return "r#priv" }
      case "typeof" { return "r#typeof" }
      case "unsized" { return "r#unsized" }
      case "virtual" { return "r#virtual" }
      case "yield" { return "r#yield" }
      case "try" { return "r#try" }
      case "fn" { return "r#fn" }
      case "let" { return "r#let" }
      case "loop" { return "r#loop" }
      case "if" { return "r#if" }
      case "else" { return "r#else" }
      case "while" { return "r#while" }
      case "for" { return "r#for" }
      case "in" { return "r#in" }
      case "return" { return "r#return" }
      case "break" { return "r#break" }
      case "continue" { return "r#continue" }
      case "struct" { return "r#struct" }
      case "enum" { return "r#enum" }
      ; `self` cannot be a raw identifier — suffix it
      case "self" { return "self_" }
    }
    return tn
  }
  
  fn WriteScalarValue (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    switch node.value_type {
      case RangerNodeType.Double {
        wr.out((("" + node.double_value) + "_f64") false)
      }
      case RangerNodeType.String {
        def s:string (this.EncodeString(node ctx wr))
        ; an empty owned String is `String::new()`: same type, no allocation
        ; from a literal, and what a Rust programmer writes
        if ((strlen s) == 0) {
          wr.out("String::new()" false)
        } {
          wr.out(((("\"" + s) + "\"") + ".to_string()") false)
        }
      }
      case RangerNodeType.Integer {
        wr.out(("" + node.int_value) false)
      }
      case RangerNodeType.Boolean {
        if node.boolean_value {
          wr.out("true" false)
        } {
          wr.out("false" false)
        }
      }
    }
  }
  ; a plain read whose resolved desc is a promoted static string
  ; (rust_static_str): the value is already `&'static str` — Copy, no clone,
  ; and any owned-String sink converts with .to_string() instead
  fn rustStaticStrRead:boolean (node:CodeNode) {
    def v:CodeNode node
    while (v.expression && ((array_length v.children) == 1)) {
      v = (v.getFirst())
    }
    if v.expression {
      return false
    }
    if (v.value_type != RangerNodeType.VRef) {
      return false
    }
    if ((array_length v.nsp) > 0) {
      def lastP:RangerAppParamDesc (itemAt v.nsp ((array_length v.nsp) - 1))
      return lastP.rust_static_str
    }
    if v.hasParamDesc {
      def p:RangerAppParamDesc v.paramDesc
      return p.rust_static_str
    }
    return false
  }

  ; a VALUE flowing into a static-string slot: a literal writes bare — no
  ; .to_string() — and a static read writes its Copy path; anything else
  ; walks normally and a mis-judged flow becomes a type error, never
  ; silent corruption
  fn rustWriteStaticStrValue:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def v:CodeNode node
    while (v.expression && ((array_length v.children) == 1)) {
      v = (v.getFirst())
    }
    if ((v.expression == false) && (v.value_type == RangerNodeType.String)) {
      wr.out((("\"" + (this.EncodeString(v ctx wr))) + "\"") false)
      return
    }
    ctx.setInExpr()
    this.WalkNode(v ctx wr)
    ctx.unsetInExpr()
  }

  ; a string LITERAL argument for a borrowed parameter passes bare: the
  ; parameter is &str, and `&"lit".to_string()` allocates a String just to
  ; borrow it (clippy's unnecessary_to_owned). Call only when the target
  ; parameter is an immutable borrow; writes the literal and returns true,
  ; or writes nothing.
  fn rustTryBareStrLitArg:boolean (nVal:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def v:CodeNode nVal
    while (v.expression && ((array_length v.children) == 1)) {
      v = (v.getFirst())
    }
    if v.expression {
      return false
    }
    if (v.value_type != RangerNodeType.String) {
      return false
    }
    wr.out((("\"" + (this.EncodeString(v ctx wr))) + "\"") false)
    return true
  }

  ; Is this argument a plain NAME read? A string-typed name carries
  ; value_type String, not VRef, so a `nVal.value_type == VRef` test skipped
  ; every string variable and left it moved (or left a &str where a String
  ; was declared). A literal has no vref and stays out.
  fn rustArgIsNameRead:boolean (nVal:CodeNode) {
    def v:CodeNode nVal
    while (v.expression && ((array_length v.children) == 1)) {
      v = (v.getFirst())
    }
    if (v.value_type == RangerNodeType.VRef) {
      return true
    }
    ; …and a field read whose OBJECT is an expression — `(st.getSecond())
    ; .vref` — which is a read exactly as `st.vref` is, only spelled through
    ; a call. It is a property node, so the expression test below turned it
    ; away and the field moved out of its `Ref` (E0507). The callers gate
    ; this on the PARAMETER's type, so a scalar still takes nothing.
    if (v.isFirstVref("property")) {
      return true
    }
    if v.expression {
      return false
    }
    if ((strlen v.vref) > 0) {
      return true
    }
    return ((array_length v.ns) > 0)
  }

  ; a read that yields a SLICE reference rather than an owned Vec — a
  ; borrowed collection parameter, which writeArgsDef spells `&[T]`. An owned
  ; sink converts it with .to_vec(); .clone() would only copy the reference.
  fn rustSliceRefRead:boolean (node:CodeNode) {
    def v:CodeNode node
    while (v.expression && ((array_length v.children) == 1)) {
      v = (v.getFirst())
    }
    if v.expression {
      return false
    }
    if (((array_length v.ns) == 1) && v.hasParamDesc) {
      def p:RangerAppParamDesc v.paramDesc
      if (p.rust_borrow_type == 1) {
        def pNN@(optional):CodeNode p.nameNode
        if (!null? pNN) {
          def pN:CodeNode (unwrap pNN)
          if (((strlen pN.array_type) > 0) && ((strlen pN.key_type) == 0)) {
            def ael:string pN.array_type
            if (((((ael == "int") || (ael == "double")) || (ael == "boolean")) || (ael == "string")) || (ael == "char")) {
              return true
            }
          }
          ; …and a BUFFER, which writeArgsDef gives the same slice form. It
          ; carries its element type in the type name rather than in
          ; array_type, so the test above never saw one: `bytes.clone()` on
          ; a `&[u8]` is another `&[u8]`, and the owned sink wanted a Vec.
          if ((strlen pN.key_type) == 0) {
            if (((pN.type_name == "buffer") || (pN.type_name == "int_buffer")) || (pN.type_name == "double_buffer")) {
              return true
            }
          }
        }
      }
    }
    return false
  }

  ; a read that yields a str REFERENCE rather than an owned String — a
  ; promoted static string, or a borrowed &str string parameter. An owned
  ; sink converts such a read with .to_string(); .clone() would only copy
  ; the reference.
  fn rustStrRefRead:boolean (node:CodeNode) {
    if (this.rustStaticStrRead(node)) {
      return true
    }
    def v:CodeNode node
    while (v.expression && ((array_length v.children) == 1)) {
      v = (v.getFirst())
    }
    if v.expression {
      return false
    }
    if (((v.value_type == RangerNodeType.VRef) && v.hasParamDesc) && ((array_length v.ns) == 1)) {
      def p:RangerAppParamDesc v.paramDesc
      if (p.rust_borrow_type == 1) {
        def pNN@(optional):CodeNode p.nameNode
        if (!null? pNN) {
          def pN:CodeNode (unwrap pNN)
          if ((pN.type_name == "string") && (((strlen pN.array_type) == 0) && ((strlen pN.key_type) == 0))) {
            return true
          }
        }
      }
    }
    return false
  }

  ; Calling a lambda MOVES each argument that is not Copy, and the operator
  ; helpers written in Ranger hand the element to the callback and then keep
  ; using it — `if cb(it, i) { res.push(it.clone()) }` is what `filter`
  ; compiles to. Every non-scalar argument goes in as a clone; for an Rc that
  ; is a refcount bump, and the callback owns what it was given either way.
  ; Is this value a REFERENCE to a handle rather than a handle? `this` in a
  ; method that carries the hidden argument is written `__self_rc`, which is
  ; `&Rc<RefCell<T>>`, and a proven-borrowed parameter is the same shape.
  ; Either one flowing into an owned position takes a clone.
  ; Does the target of this assignment hold an Rc? The last segment of the
  ; path answers — a shared-class name carries rust_needs_rc_wrap, and a
  ; plain struct local of the same class does not.
  fn rustLhsHoldsRc:boolean (left:CodeNode) {
    def nspLen:int (array_length left.nsp)
    if (nspLen > 0) {
      def lastD:RangerAppParamDesc (itemAt left.nsp (nspLen - 1))
      return lastD.rust_needs_rc_wrap
    }
    if left.hasParamDesc {
      def lp:RangerAppParamDesc left.paramDesc
      return lp.rust_needs_rc_wrap
    }
    return false
  }

  fn rustValueIsBorrowedHandle:boolean (node:CodeNode ctx:RangerAppWriterContext) {
    def bv:CodeNode (this.rustUnwrapParens(node))
    if (bv.vref == "this") {
      def bvCls@(optional):RangerAppClassDesc (ctx.getCurrentClass())
      def bvM@(optional):RangerAppFunctionDesc (ctx.getCurrentMethod())
      if ((!null? bvCls) && (!null? bvM)) {
        def bvC:RangerAppClassDesc (unwrap bvCls)
        def bvF:RangerAppFunctionDesc (this.rustEnclosingMethod((unwrap bvM)))
        if (this.rustClassIsShared(bvC.name ctx)) {
          return bvF.rust_needs_self_rc
        }
      }
      return false
    }
    if (bv.value_type != RangerNodeType.VRef) {
      return false
    }
    if ((array_length bv.ns) > 1) {
      return false
    }
    if (bv.hasParamDesc == false) {
      return false
    }
    def bvP:RangerAppParamDesc bv.paramDesc
    return ((bvP.rust_borrow_type == 1) && bvP.rust_needs_rc_wrap)
  }

  fn CreateLambdaCall:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def fName:CodeNode (itemAt node.children 0)
    def args:CodeNode (itemAt node.children 1)
    ctx.setInExpr()
    this.WalkNode(fName ctx wr)
    wr.out("(" false)
    for args.children arg:CodeNode i {
      if (i > 0) {
        wr.out(", " false)
      }
      this.WalkNode(arg ctx wr)
      def lcCloned:boolean false
      if (arg.expression == false) {
        if arg.hasParamDesc {
          def ap:RangerAppParamDesc (unwrap arg.paramDesc)
          if ((this.rustFieldIsCopyScalar(ap ctx)) == false) {
            wr.out(".clone()" false)
            lcCloned = true
          }
        }
      }
      ; a lambda call MOVES its arguments, and `this` has no desc to ask
      if (lcCloned == false) {
        if (this.rustValueIsBorrowedHandle(arg ctx)) {
          wr.out(".clone()" false)
        }
      }
    }
    wr.out(")" false)
    ctx.unsetInExpr()
    if ((ctx.expressionLevel()) == 0) {
      wr.out(";" true)
    }
  }

  ; A Ranger lambda is a Rust closure: `|a, b| { … }`. Without this the
  ; generic writer's JavaScript form reached the output — `(a, b) => { … }`
  ; — and rustc stopped at the arrow before it could look at anything else
  ; in the file. Argument types are left to inference: a closure literal is
  ; always written straight into the call that takes it, so the parameter's
  ; declared FnMut type fixes them.
  fn CreateLambda:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def lambdaCtx (unwrap node.lambda_ctx)
    def args:CodeNode (itemAt node.children 1)
    def body:CodeNode (itemAt node.children 2)
    ; the parameter that receives it is `&mut dyn FnMut(…)`, so the literal
    ; goes in as a mutable borrow. Without it rustc has no expected type to
    ; infer the closure's own parameters from — "type annotations needed" on
    ; every `item`.
    wr.out("&mut |" false)
    for args.children arg:CodeNode i {
      if (i > 0) {
        wr.out(", " false)
      }
      ; the body calls `&mut self` methods on the element as freely as any
      ; other name, so the binding is mutable. Whether it had to be is not
      ; answerable from here -- a lambda parameter carries no descriptor --
      ; so the header is asked for `unused_mut` on its behalf.
      this.rustNeedAllow("unused_mut" wr)
      wr.out(("mut " + (this.adjustType(arg.vref))) false)
    }
    wr.out("| {" true)
    wr.indent(1)
    lambdaCtx.restartExpressionLevel()
    for body.children item:CodeNode i {
      this.WalkNode(item lambdaCtx wr)
    }
    wr.newline()
    wr.indent(-1)
    wr.out("}" false)
  }

  ; The type of a name that holds a lambda. Rust has no bare function type,
  ; so the closure trait stands in: FnMut, because a Ranger lambda captures
  ; its enclosing scope by reference and is free to write through it. Left
  ; unwritten, a callback parameter came out as `cb : )` — a parse error at
  ; every operator helper that takes one.
  fn writeRustLambdaType:void (expression_value:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def rv:CodeNode (itemAt expression_value.children 0)
    def sec:CodeNode (itemAt expression_value.children 1)
    if rust_writing_field_type {
      wr.out("Box<dyn FnMut(" false)
    } {
      wr.out("&mut dyn FnMut(" false)
    }
    for sec.children arg:CodeNode i {
      if (i > 0) {
        wr.out(", " false)
      }
      ; the element the loop hands to the callback is the shared handle, so
      ; the signature says so. The body agrees because applySharedClassRcWrap
      ; marks a lambda's parameters too — both sides had to move together.
      if ((((strlen arg.type_name) > 0) && ((strlen arg.array_type) == 0)) && ((strlen arg.key_type) == 0)) {
        if (this.rustClassIsShared(arg.type_name ctx)) {
          ; an `@(optional)` callback parameter keeps its Option around the
          ; handle, the same shape a field or a local takes — the body asks
          ; it `is_some()` and unwraps it
          if (arg.hasFlag("optional")) {
            wr.out((("Option<" + (this.rustSharedTypeString(arg.type_name ctx))) + ">") false)
          } {
            wr.out((this.rustSharedTypeString(arg.type_name ctx)) false)
          }
        } {
          this.writeTypeDef(arg ctx wr)
        }
      } {
        this.writeTypeDef(arg ctx wr)
      }
    }
    wr.out(")" false)
    if ((rv.type_name == "void") || (rv.eval_type_name == "void")) {
    } {
      wr.out(" -> " false)
      ; …and the RETURN of a shared class is the handle too. Without this a
      ; `map` callback that hands back a CodeNode was declared to return the
      ; bare struct while every body returned the Rc.
      def lrShared:boolean false
      if ((((strlen rv.type_name) > 0) && ((strlen rv.array_type) == 0)) && ((strlen rv.key_type) == 0)) {
        lrShared = (this.rustClassIsShared(rv.type_name ctx))
      }
      if lrShared {
        if (rv.hasFlag("optional")) {
          wr.out((("Option<" + (this.rustSharedTypeString(rv.type_name ctx))) + ">") false)
        } {
          wr.out((this.rustSharedTypeString(rv.type_name ctx)) false)
        }
      } {
        this.writeTypeDef(rv ctx wr)
      }
    }
    if rust_writing_field_type {
      wr.out(">" false)
    }
  }

  ; Does getObjectTypeString already hand back the whole shared handle for
  ; this class, rather than the struct that goes inside one? A class that is
  ; extended by children has no struct type a name can hold: it is written
  ; as `Rc<RefCell<dyn XTrait>>`, handle and all. Sites that build the shared
  ; form themselves must ask this first — see rustSharedTypeString.
  ; The trait a value has to be coerced INTO on its way to this target, or ""
  ; when nothing is needed. A subclass handle is Rc<RefCell<Sub>>, and a slot
  ; typed with the trait parent holds Rc<RefCell<dyn ParentTrait>>: the two
  ; are one unsizing coercion apart, and Rust will not do it implicitly
  ; through an Option or a Weak.
  fn rustTraitCoerceName:string (targetType:string value:CodeNode ctx:RangerAppWriterContext) {
    if ((this.rustTypeIsOwnHandle(targetType ctx)) == false) {
      return ""
    }
    def vt:string (this.rustArgValueTypeName(value))
    if ((strlen vt) == 0) {
      return ""
    }
    if (vt == targetType) {
      return ""
    }
    if (this.rustTypeIsOwnHandle(vt ctx)) {
      return ""
    }
    if ((this.rustClassIsShared(vt ctx)) == false) {
      return ""
    }
    return targetType
  }

  ; The class an argument expression evaluates to, as far as the writer can
  ; tell. A named value answers from its own declaration — the evaluated type
  ; of a plain name is not always filled in — and everything else from the
  ; expression's evaluated type. A collection-typed name yields no class
  ; name: the annotation there describes the elements, not the value.
  fn rustArgValueTypeName:string (nVal:CodeNode) {
    if (nVal.value_type == RangerNodeType.VRef) {
      if nVal.hasParamDesc {
        def vP:RangerAppParamDesc nVal.paramDesc
        def vNN@(optional):CodeNode vP.nameNode
        if (!null? vNN) {
          def vN:CodeNode (unwrap vNN)
          if (((strlen vN.array_type) > 0) || ((strlen vN.key_type) > 0)) {
            return ""
          }
          if ((strlen vN.type_name) > 0) {
            return vN.type_name
          }
        }
      }
    }
    if (((strlen nVal.array_type) > 0) || ((strlen nVal.key_type) > 0)) {
      return ""
    }
    if ((strlen nVal.eval_type_name) > 0) {
      return nVal.eval_type_name
    }
    ; An element read carries no evaluated type of its own, so the element's
    ; class has to come from the collection it was read out of.
    if nVal.expression {
      if ((array_length nVal.children) >= 3) {
        def evFirst:CodeNode (nVal.getFirst())
        if ((evFirst.vref == "itemAt") || (evFirst.vref == "get")) {
          return (this.rustNodeCollectionElemType((nVal.getSecond())))
        }
      }
    }
    return ""
  }

  ; The element class of a collection-typed name, read off the declaration
  ; the path ends in — the last segment of `left.nsp`, or the whole name.
  fn rustNodeCollectionElemType:string (coll:CodeNode) {
    def nspLen:int (array_length coll.nsp)
    if (nspLen > 0) {
      def lastD:RangerAppParamDesc (itemAt coll.nsp (nspLen - 1))
      def lNN@(optional):CodeNode lastD.nameNode
      if (!null? lNN) {
        def lN:CodeNode (unwrap lNN)
        if ((strlen lN.array_type) > 0) {
          return lN.array_type
        }
      }
    }
    if coll.hasParamDesc {
      def cp:RangerAppParamDesc coll.paramDesc
      def cNN@(optional):CodeNode cp.nameNode
      if (!null? cNN) {
        def cN:CodeNode (unwrap cNN)
        if ((strlen cN.array_type) > 0) {
          return cN.array_type
        }
      }
    }
    return ""
  }

  ; The trait the hidden receiver argument is typed with in the method being
  ; written, or "" when it is typed with the container class itself. Mirrors
  ; the choice writeArgsDef makes.
  fn rustSelfRcTraitName:string (ctx:RangerAppWriterContext) {
    def scCls@(optional):RangerAppClassDesc (ctx.getCurrentClass())
    if (null? scCls) {
      return ""
    }
    def scc:RangerAppClassDesc (unwrap scCls)
    if scc.is_extended_by_children {
      return scc.name
    }
    def scM@(optional):RangerAppFunctionDesc (ctx.getCurrentMethod())
    if (null? scM) {
      return ""
    }
    def scF:RangerAppFunctionDesc (this.rustEnclosingMethod((unwrap scM)))
    for scc.extends_classes sccP:string sccPi {
      if (ctx.isDefinedClass(sccP)) {
        def sccPC:RangerAppClassDesc (ctx.findClass(sccP))
        if sccPC.is_extended_by_children {
          if (has sccPC.defined_methods scF.name) {
            return sccPC.name
          }
        }
      }
    }
    return ""
  }

  fn rustTypeIsOwnHandle:boolean (type_name:string ctx:RangerAppWriterContext) {
    def tcOpt@(optional):RangerAppClassDesc (ctx.findClass(type_name))
    if (null? tcOpt) {
      return false
    }
    def tc:RangerAppClassDesc (unwrap tcOpt)
    ; a sealable union is an enum and an unsealable one is Rc<dyn Any>;
    ; neither is a RefCell handle, so both take the wrap like a struct
    if tc.is_union {
      return false
    }
    return (tc.is_extended_by_children)
  }

  ; The type a shared name is declared with: the class inside one
  ; Rc<RefCell<…>>. Wrapping getObjectTypeString unconditionally double
  ; wrapped every class that has subclasses —
  ; Rc<RefCell<Rc<RefCell<dyn XTrait>>>> — and .borrow() on such a name
  ; yields another Rc, so every field read through it was "no field X on
  ; type RefMut<'_, Rc<RefCell<dyn XTrait>>>".
  fn rustSharedTypeString:string (type_name:string ctx:RangerAppWriterContext) {
    if (this.rustTypeIsOwnHandle(type_name ctx)) {
      return (this.getObjectTypeString(type_name ctx))
    }
    return (("Rc<RefCell<" + (this.getObjectTypeString(type_name ctx))) + ">>")
  }

  ; The same handle in its non-owning form. A `@(weak)` name holds a Weak,
  ; is written into with Rc::downgrade and read back with upgrade(), so
  ; declaring it as the Rc form left every such name disagreeing with both
  ; its own stores and its own loads.
  fn rustSharedWeakTypeString:string (type_name:string ctx:RangerAppWriterContext) {
    if (this.rustTypeIsOwnHandle(type_name ctx)) {
      return ((("Weak<RefCell<dyn " + type_name) + "Trait") + ">>")
    }
    return (("Weak<RefCell<" + (this.getObjectTypeString(type_name ctx))) + ">>")
  }

  fn rustIsCollectionTypeString:boolean (type_string:string) {
    if ((strlen type_string) >= 2) {
      if ((charAt type_string 0) == (ccode "[")) {
        return true
      }
    }
    return false
  }

  ; Turn a nested collection type string — "[string]", "[string:[int]]" —
  ; into the Rust Vec / map form. Without this the fallthrough at the end of
  ; getObjectTypeString handed back the Ranger spelling unchanged and the
  ; field came out as `HashMap<String,[string]>`, with `string` an unknown
  ; type.
  fn rustCollectionTypeString:string (type_string:string ctx:RangerAppWriterContext) {
    def n:int (strlen type_string)
    def inner:string (substring type_string 1 (n - 1))
    def il:int (strlen inner)
    def depth:int 0
    def sep:int (0 - 1)
    def i:int 0
    while (i < il) {
      def c:int (charAt inner i)
      if (c == (ccode "[")) {
        depth = depth + 1
      }
      if (c == (ccode "]")) {
        depth = depth - 1
      }
      if ((c == (ccode ":")) && (depth == 0)) {
        sep = i
      }
      i = i + 1
    }
    if (sep >= 0) {
      def kt:string (substring inner 0 sep)
      def vt:string (substring inner (sep + 1) il)
      return ((((("HashMap<" + (this.rustElementTypeString(kt ctx))) + ",") + (this.rustElementTypeString(vt ctx)))) + ">")
    }
    return (("Vec<" + (this.rustElementTypeString(inner ctx))) + ">")
  }

  ; The element of a Rust collection: a shared class is held through its Rc,
  ; a primitive and a nested collection are held by value.
  fn rustElementTypeString:string (type_string:string ctx:RangerAppWriterContext) {
    if (this.rustIsCollectionTypeString(type_string)) {
      return (this.rustCollectionTypeString(type_string ctx))
    }
    if (this.rustClassIsShared(type_string ctx)) {
      return (this.rustSharedTypeString(type_string ctx))
    }
    return (this.getObjectTypeString(type_string ctx))
  }

  fn getObjectTypeString:string (type_string:string ctx:RangerAppWriterContext) {
    if (this.rustIsCollectionTypeString(type_string)) {
      return (this.rustCollectionTypeString(type_string ctx))
    }
    switch type_string {
      case "int" {
        return "i64"
      }
      case "string" {
        return "String"
      }
      case "boolean" {
        return "bool"
      }
      case "double" {
        return "f64"
      }
      case "buffer" {
        return "Vec<u8>"
      }
      case "int_buffer" {
        return "Vec<i64>"
      }
      case "double_buffer" {
        return "Vec<f64>"
      }
    }
    ; Check if this type is a trait type (class is extended by other classes)
    def typeClass@(optional):RangerAppClassDesc (ctx.findClass(type_string))
    if (!null? typeClass) {
      def tc:RangerAppClassDesc (unwrap typeClass)
      ; D-UNION: a union of classes is a Rust enum with one variant per member
      ; (PLAN_SHAPES.md S5). Anything else — the compiler's own `Any`, a union
      ; over primitives — has no Rust type of its own and falls back to the
      ; trait object, which any value can at least be coerced into.
      if tc.is_union {
        if (this.unionIsSealable(tc ctx)) {
          return (this.unionInterfaceName(type_string))
        }
        return "Rc<dyn std::any::Any>"
      }
      if tc.is_extended_by_children {
        return ("Rc<RefCell<dyn " + type_string + "Trait>>")
      }
      ; A systemclass names one type per target. Without this the Ranger name
      ; reached the output and rustc saw an undeclared type: JSONDataObject
      ; instead of the HashMap that JSON.rgr declares for Rust.
      if tc.is_system {
        def sysName@(optional):string (get tc.systemNames "rust")
        if (!null? sysName) {
          return (unwrap sysName)
        }
      }
    }
    return type_string
  }
  fn getTypeString:string (type_string:string) {
    switch type_string {
      case "int" {
        return "i64"
      }
      case "string" {
        return "String"
      }
      case "boolean" {
        return "bool"
      }
      case "double" {
        return "f64"
      }
      case "buffer" {
        return "Vec<u8>"
      }
      case "int_buffer" {
        return "Vec<i64>"
      }
      case "double_buffer" {
        return "Vec<f64>"
      }
    }
    return type_string
  }
  fn writeTypeDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ; a lambda-typed name is a closure trait object, and none of the
    ; Option/Weak/RefCell wrapping below applies to one — it is answered
    ; before any of that runs
    def lt_type:RangerNodeType node.value_type
    if (node.eval_type != RangerNodeType.NoType) {
      lt_type = node.eval_type
    }
    if (lt_type == RangerNodeType.ExpressionType) {
      if (!null? node.expression_value) {
        ; an uninitialized closure FIELD holds None until something is put
        ; in it, so the Option goes around the Box the same as for any other
        ; field of a class type
        def lamOpt:boolean false
        if rust_writing_field_type {
          if (node.hasFlag("optional")) {
            lamOpt = true
          }
        }
        if lamOpt {
          wr.out("Option<" false)
        }
        this.writeRustLambdaType((unwrap node.expression_value) ctx wr)
        if lamOpt {
          wr.out(">" false)
        }
        return
      }
    }
    def is_optional:boolean (node.hasFlag("optional"))
    def is_weak:boolean (node.hasFlag("weak"))
    ; …and `@(weak)` on a RETURN says nothing about the handle handed back:
    ; every caller binds the result to an Rc name, and the bodies return one.
    ; Declaring the Weak form there left the signature disagreeing with both.
    if rust_writing_return_type {
      is_weak = false
    }
    ; `@(weak)` on a COLLECTION is about what the elements own, not the
    ; container: the Vec or the map itself belongs to the field. Wrapping it
    ; in a Weak handed back something with no len, push, get or insert on it
    ; at all, and every use of such a field was an error.
    if is_weak {
      if (((strlen node.array_type) > 0) || ((strlen node.key_type) > 0)) {
        is_weak = false
      }
    }
    def is_self_referential:boolean false
    
    ; Check if this is a self-referential type (field type == current class)
    def uc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
    
    ; Check if current class is trait-related (is a trait parent or extends one)
    def class_is_trait_related:boolean false
    if (!null? uc) {
      def currClass:RangerAppClassDesc (unwrap uc)
      if (node.type_name == currClass.name) {
        is_self_referential = true
      }
      ; Check if class is a trait parent
      if currClass.is_extended_by_children {
        class_is_trait_related = true
      }
      ; Check if class extends a trait parent
      if (class_is_trait_related == false) {
        for currClass.extends_classes extParentName:string epi {
          def extParentClass@(optional):RangerAppClassDesc (ctx.findClass(extParentName))
          if (!null? extParentClass) {
            def epc:RangerAppClassDesc (unwrap extParentClass)
            if epc.is_extended_by_children {
              class_is_trait_related = true
            }
          }
        }
      }
    }
    
    ; Check if the field type is a trait type (will be wrapped in Rc<RefCell<dyn Trait>>)
    def field_type_is_trait:boolean false
    def typeClass@(optional):RangerAppClassDesc (ctx.findClass(node.type_name))
    if (!null? typeClass) {
      def tc:RangerAppClassDesc (unwrap typeClass)
      if tc.is_extended_by_children {
        field_type_is_trait = true
      }
    }
    
    ; Determine if we need to wrap in RefCell for interior mutability
    ; This is needed when: class is trait-related, field is optional, field is NOT a trait type
    def needs_refcell_wrap:boolean ((class_is_trait_related && is_optional) && (field_type_is_trait == false))
    ; Only wrap object types in RefCell (not primitives, arrays, etc.)
    def is_object_type:boolean false
    def v_type_check:RangerNodeType node.value_type
    if ((v_type_check == RangerNodeType.Object) || (v_type_check == RangerNodeType.VRef) || (v_type_check == RangerNodeType.NoType)) {
      v_type_check = (node.typeNameAsType(ctx))
    }
    if (node.eval_type != RangerNodeType.NoType) {
      v_type_check = node.eval_type
    }
    ; Check if it's an object type (not primitive, array, hash, etc.)
    if ((((((((v_type_check != RangerNodeType.Integer) && (v_type_check != RangerNodeType.Double)) && (v_type_check != RangerNodeType.String)) && (v_type_check != RangerNodeType.Boolean)) && (v_type_check != RangerNodeType.Char)) && (v_type_check != RangerNodeType.Array)) && (v_type_check != RangerNodeType.Hash)) && (v_type_check != RangerNodeType.Buffer)) {
      is_object_type = true
    }
    if (is_object_type == false) {
      needs_refcell_wrap = false
    }
    
    ; Handle weak references - uses Weak<RefCell<T>> to break reference cycles
    if is_weak {
      ; a class with subclasses is written as the whole Rc<RefCell<dyn …>>
      ; handle, so letting the switch below fill the hole gave
      ; Weak<RefCell<Rc<RefCell<dyn XTrait>>>> — the weak form of a handle,
      ; not of the object. The trait object goes straight into the Weak.
      if (((strlen node.array_type) == 0) && ((strlen node.key_type) == 0)) {
        if (this.rustTypeIsOwnHandle(node.type_name ctx)) {
          def wkInner:string (("dyn " + node.type_name) + "Trait")
          if is_optional {
            wr.out((("Option<Weak<RefCell<" + wkInner) + ">>>") false)
          } {
            wr.out((("Weak<RefCell<" + wkInner) + ">>") false)
          }
          return
        }
      }
      if is_optional {
        wr.out("Option<Weak<RefCell<" false)
      } {
        wr.out("Weak<RefCell<" false)
      }
    } {
      if is_optional {
        if is_self_referential {
          ; Self-referential optional fields need Box to break infinite recursion
          wr.out("Option<Box<" false)
        } {
          if needs_refcell_wrap {
            ; Wrap in RefCell for interior mutability in trait-related classes
            wr.out("Option<RefCell<" false)
          } {
            wr.out("Option<" false)
          }
        }
      }
    }
    def v_type:RangerNodeType node.value_type
    if ((v_type == RangerNodeType.Object) || (v_type == RangerNodeType.VRef) || (v_type == RangerNodeType.NoType)) {
      v_type = (node.typeNameAsType(ctx))
    }
    if (node.eval_type != RangerNodeType.NoType) {
      v_type = node.eval_type
    }
    switch v_type {
      case RangerNodeType.Enum {
        ; PLAN_RUST_SEMANTIC_IDIOMS F: the enum's own name when every use in the
        ; program is one a Rust enum can carry, i64 otherwise.
        if (this.rustEnumIsNative(node.type_name ctx)) {
          wr.out(node.type_name false)
        } {
          wr.out("i64" false)
        }
      }
      case RangerNodeType.Integer {
        wr.out("i64" false)
      }
      case RangerNodeType.Double {
        wr.out("f64" false)
      }
      case RangerNodeType.String {
        wr.out("String" false)
      }
      case RangerNodeType.Boolean {
        wr.out("bool" false)
      }
      case RangerNodeType.Char {
        wr.out("i64" false)
      }
      case RangerNodeType.CharBuffer {
        wr.out("Vec<u8>" false)
      }
      case RangerNodeType.Buffer {
        wr.out("Vec<u8>" false)
      }
      case RangerNodeType.IntBuffer {
        wr.out("Vec<i64>" false)
      }
      case RangerNodeType.DoubleBuffer {
        wr.out("Vec<f64>" false)
      }
      case RangerNodeType.Hash {
        ; an element of a shared class follows the class (PLAN_RUST_OWNERSHIP 2b)
        def helem:string (this.getObjectTypeString(node.array_type ctx))
        if (this.rustClassIsShared(node.array_type ctx)) {
          helem = (this.rustSharedTypeString(node.array_type ctx))
        }
        wr.out((((("HashMap<" + (this.getObjectTypeString(node.key_type ctx))) + ",") + helem) + ">") false)

      }
      case RangerNodeType.Array {
        def aelem:string (this.getObjectTypeString(node.array_type ctx))
        if (this.rustClassIsShared(node.array_type ctx)) {
          aelem = (this.rustSharedTypeString(node.array_type ctx))
        }
        wr.out((("Vec<" + aelem) + ">") false)
      }
      default {
        if (node.type_name == "void") {
          wr.out("()" false)
          return
        }
        ; Check if this type is a trait type (class is extended by other classes)
        ; If so, use Rc<RefCell<dyn Trait>> for polymorphism with interior mutability
        def typeClass@(optional):RangerAppClassDesc (ctx.findClass(node.type_name))
        if (!null? typeClass) {
          def tc:RangerAppClassDesc (unwrap typeClass)
          if tc.is_extended_by_children {
            wr.out(("Rc<RefCell<dyn " + node.type_name + "Trait>>") false)
          } {
            ; A Ranger `trait` is a MIXIN on this target: its methods are copied
            ; into each class that `does` it, and no type of that name is ever
            ; declared. Writing the trait's name here emitted a Rust type that
            ; does not exist -- `fn show(n : &mut Named)` with no `Named` in the
            ; file, which rustc answers with E0425. A parent class WITH
            ; subclasses is the case just above and does get a real trait
            ; object; a trait does not, so say so instead of writing the name.
            if tc.is_trait {
              ctx.addError(node (("the Rust target writes a `trait` as a mixin, so `" + node.type_name) + "` is not a type it can name. Use a class with subclasses (`Extends(Base)`), which does emit a Rust trait object, or give the parameter a concrete type."))
            }
            wr.out((this.getObjectTypeString(node.type_name ctx)) false)
          }
        } {

; SPDX-License-Identifier: MIT

Import "ForLoopAnalysis.rgr"
Import "EnumAnalysis.rgr"
Import "TraitAnalysis.rgr"

class RangerPythonClassWriter {
  Extends (RangerGenericClassWriter)
  def compiler:LiveCompiler
  def thisName:string "self"
  def wrote_header:boolean false

  ; which Ranger `Enum`s survive as a Python `IntEnum` rather than a bare int.
  ; Same question Rust and C++ ask: compiler/EnumAnalysis.rgr.
  def pyEnums:EnumNativeAnalysis (new EnumNativeAnalysis())
  def python_enums_written:boolean false

  ; which behaviour-only Ranger `trait`s become a typing.Protocol. Same
  ; question every target with interfaces asks: compiler/TraitAnalysis.rgr.
  ; A Protocol is structural, so the classes that carry the mixin copies
  ; satisfy it without naming it -- which is what the Ranger `does` already
  ; means, and what makes the name usable in an annotation.
  def pyTraits:TraitInterfaceAnalysis (new TraitInterfaceAnalysis())
  def python_traits_written:boolean false

  fn writePythonTraitProtocols:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    if python_traits_written {
      return
    }
    python_traits_written = true
    pyTraits.compute(ctx)
    def wroteAny:boolean false
    for (keys pyTraits.ifaceTraits) tn:string tni {
      def tc:RangerAppClassDesc (ctx.findClass(tn))
      if (wroteAny == false) {
        wr.out("from typing import Protocol" true)
        wr.out("" true)
        wroteAny = true
      }
      wr.out(("class " + tn + "(Protocol):") true)
      wr.indent(1)
      def wroteMember:boolean false
      for tc.defined_variants fnVar:string fvi {
        def mVs:RangerAppMethodVariants (get tc.method_variants fnVar)
        for mVs.variants variant:RangerAppFunctionDesc vi {
          wr.out(("def " + variant.compiledName + "(self") false)
          if ((array_length variant.params) > 0) {
            wr.out(", " false)
            this.writeArgsDef(variant ctx wr)
          }
          wr.out(")" false)
          this.pyWriteReturnAnnotation(variant ctx wr)
          wr.out(": ..." true)
          wroteMember = true
        }
      }
      if (wroteMember == false) {
        wr.out("pass" true)
      }
      wr.indent(-1)
      wr.out("" true)
    }
  }

  fn pyEnumIsNative:boolean (enumName:string ctx:RangerAppWriterContext) {
    pyEnums.targetName = "python"
    pyEnums.fallbackType = "int"
    return (pyEnums.isNative(enumName ctx))
  }

  ; `class Color(IntEnum): Red = 0`. IntEnum rather than Enum: the member
  ; still IS its integer, so a value that reaches a place this writer does
  ; not annotate -- a map key, a format string, JSON -- behaves as before.
  fn writePythonNativeEnums:void (ctx:RangerAppWriterContext wr:CodeWriter) {
    if python_enums_written {
      return
    }
    python_enums_written = true
    def enumRoot:RangerAppWriterContext (ctx.getRoot())
    def wroteAny:boolean false
    for (keys enumRoot.definedEnums) pen:string pei {
      if (this.pyEnumIsNative(pen ctx)) {
        def peDef:RangerAppEnum (unwrap (get enumRoot.definedEnums pen))
        if (wroteAny == false) {
          wr.out("from enum import IntEnum" true)
          wr.out("" true)
          wroteAny = true
        }
        wr.out(("class " + pen + "(IntEnum):") true)
        wr.indent(1)
        for (keys peDef.values) pmn:string pmi {
          def pmv:int (unwrap (get peDef.values pmn))
          wr.out(((ctx.transformWord(pmn)) + " = " + (to_string pmv)) true)
        }
        wr.indent(-1)
        wr.out("" true)
      }
    }
  }
  ; can a `for` be the target's own loop over the collection?
  ; Target-neutral question, one place: compiler/ForLoopAnalysis.rgr
  def pyLoops:ForLoopShape (new ForLoopShape())

  ; Python has no multi-statement lambda, so a lambda with a body becomes a
  ; named nested `def` written ABOVE the statement that uses it, and the
  ; statement carries only the name. `pyHoistWriters` is the stack of places
  ; those defs go: one per function body, innermost last, so a lambda inside a
  ; lambda lands inside the enclosing def and still sees its parameters.
  ;
  ; Hoisting to the top of the body rather than to the exact statement is safe
  ; because Python resolves a closure's free variables when the function RUNS,
  ; not where it is defined -- the call is always after the locals it reads.
  def pyHoistWriters@(weak):[CodeWriter]
  def pyLambdaCounter:int 0

  fn emptyBlockFiller:string () {
    return "pass"
  }

  fn adjustType:string (tn:string) {
    if (tn == "this") {
      return "self"
    } 
    ; Python mangles any name that starts with two underscores and is written
    ; INSIDE a class body: `EvalConstPool.__singleton()` in class EvalValue
    ; becomes `EvalConstPool._EvalValue__singleton()`, which does not exist.
    ; The synthetic singleton accessor is renamed on this target so that call
    ; sites and the definition agree.
    if (tn == "__singleton") {
      return "rg_singleton"
    }
    return tn
  }

  fn EncodeString:string (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def encoded_str:string ""
    def str_length:int (strlen node.string_value)
    def ii:int 0
    while (< ii str_length) {
      def cc:int (charAt node.string_value ii)
      switch cc {
        case 8 {
            encoded_str = encoded_str + (strfromcode 92 ) + (strfromcode 98 )  
        }
        case 9 {
            encoded_str = encoded_str + (strfromcode 92 ) + (strfromcode 116 ) 
        }    
        case 10 {
            encoded_str = encoded_str + (strfromcode 92 ) + (strfromcode 110 )
        }    
        case 12 {
            encoded_str = encoded_str + (strfromcode 92 ) + (strfromcode 102 )
        }    
        case 13 {
            encoded_str = encoded_str + (strfromcode 92 ) + (strfromcode 114 )
        }
        case 34 {
            encoded_str = encoded_str + (strfromcode 92 ) + (strfromcode 34 )
        }  
        case 92 {
            encoded_str = encoded_str + (strfromcode 92 ) + (strfromcode 92 )
        }
        ; A character above ASCII is COPIED, not rebuilt from its code.
        ; `charAt` answers the host's own unit -- a UTF-16 code unit, a code
        ; point or a UTF-8 byte -- and `strfromcode` writes a CODE POINT, so
        ; on a byte-hosted compiler every byte of a multi byte character was
        ; encoded a second time: the C++ self-host wrote `a-em-dash-b` into
        ; its JavaScript output as C3 A2 C2 80 C2 94 instead of E2 80 94.
        ; The LLVM writer had the same bug for the same reason. A one unit
        ; `substring` carries whatever the unit is across unchanged, and the
        ; pieces concatenate back into the character on every target -- which
        ; tests/fixtures/string_units.rgr checks as `roundtrip`.
        default {
          encoded_str = (encoded_str + (substring node.string_value ii (ii + 1)))
        }
      }
      ii = ii + 1
    }
    return encoded_str   
  }

  fn WriteScalarValue:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    switch node.value_type {
      case RangerNodeType.Double {
        wr.out(("" + node.double_value) , false)
      }
      case RangerNodeType.String {
        def s:string (this.EncodeString(node ctx wr))
        wr.out((("\"" + s) + "\"") , false)
      }
      case RangerNodeType.Integer {
        wr.out(("" + node.int_value) , false)
      }
      case RangerNodeType.Boolean {
        if node.boolean_value {
          wr.out("True" false)
        } {
          wr.out("False" false)
        }
      }
    }
  }

  fn WriteVRef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (node.vref == "this") {
      wr.out("self" false)
      return
    }

    if (node.eval_type == RangerNodeType.Enum) {
      if( (array_length node.ns) > 1) {
        def rootObjName:string (itemAt node.ns 0)
        def enumName:string (itemAt node.ns 1)
        def e@(optional):RangerAppEnum (ctx.getEnum(rootObjName))
        if (!null? e) {
          ; `Color.Green`, not `1`, when the enum survives as an IntEnum
          if (this.pyEnumIsNative(rootObjName ctx)) {
            wr.out((rootObjName + "." + (ctx.transformWord(enumName))) false)
            return
          }
          wr.out(("" + (unwrap (get e.values enumName))) false)
          return
        }
      }
    }

    if ((array_length node.nsp) > 0) {
      for node.nsp p:RangerAppParamDesc i {
        if (i == 0) {
          def part:string (itemAt node.ns 0)
          if(part == "this") {
            wr.out("self" false)
            continue
          } 
        }        

        if (i > 0) {
          wr.out("." false)
        }
        if (i == 0) {
          if (p.nameNode.hasFlag("optional")) {
          }
          def part:string (itemAt node.ns 0)
          if ((part != "this") && (ctx.isMemberVariable(part))) {
            def uc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
            def currC:RangerAppClassDesc (unwrap uc)
            def up@(optional):RangerAppParamDesc (currC.findVariable(part))
            if (!null? up) {
              if( false == (ctx.isInStatic()) ) {
                wr.out((thisName + ".") false)
              }               
            }
          }
        }
        if ((strlen p.compiledName) > 0) {
          wr.out((this.adjustType(p.compiledName)) false)
        } {
          if ((strlen p.name) > 0) {
            wr.out((this.adjustType(p.name)) false)
          } {
            wr.out((this.adjustType( (itemAt node.ns i))) false)
          }
        }
      }
      return
    }

    if node.hasParamDesc {
      def part:string (itemAt node.ns 0)
      if ((part != "this") && (ctx.isMemberVariable(part))) {
        def uc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
        def currC:RangerAppClassDesc (unwrap uc)
        def up@(optional):RangerAppParamDesc (currC.findVariable(part))
        if (!null? up) {
          if( false == (ctx.isInStatic()) ) {
            wr.out((thisName + ".") false)
          }
        }
      }
      def p:RangerAppParamDesc node.paramDesc
      wr.out(p.compiledName false)
      return
    }

    def b_was_static:boolean false
    for node.ns part:string i {
      if (i > 0) {
        wr.out("." false)
      }
      if (i == 0) {
        if (ctx.hasClass(part)) {
          b_was_static = true
        }
        if ((part != "this") && (ctx.hasCurrentClass())) {
          def uc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
          def currC:RangerAppClassDesc (unwrap uc)
          def up@(optional):RangerAppParamDesc (currC.findVariable(part))
          if (!null? up) {
            if( false == (ctx.isInStatic()) ) {
              wr.out((thisName + ".") false)
            }
          }
        }
      }
      wr.out((this.adjustType(part)) false)
    }
  }

  ; True when a node, or anything under it, calls something. An unused `def`
  ; whose initializer CALLS still has to run -- `def ignored:T (this.work())`
  ; is the language's evaluate-and-discard form -- so commenting it out
  ; silently dropped the call, and in Python left the block it was the only
  ; statement of without a body at all.
  fn pyNodeContainsCall:boolean (node:CodeNode) {
    if node.hasFnCall {
      return true
    }
    if node.has_call {
      return true
    }
    if node.has_lambda_call {
      return true
    }
    for node.children ch:CodeNode ci {
      if (this.pyNodeContainsCall(ch)) {
        return true
      }
    }
    return false
  }

  ; Walk a method body and write `pass` when it produced nothing. Python has
  ; no empty suite: `def onEvent(self):` with no indented line under it is an
  ; IndentationError, and an empty method is the usual way to write the
  ; default of an overridable hook. The test is on what was WRITTEN, so a body
  ; whose only statement the writer dropped counts as empty too.
  fn pyWalkBody:void (body:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def hoist:CodeWriter (wr.fork())
    push pyHoistWriters hoist
    def hoistLineBefore:int hoist.lineNumber
    def lineBefore:int wr.lineNumber
    def colBefore:int (strlen wr.currentLine)
    this.WalkNode(body ctx wr)
    remove_index pyHoistWriters ((array_length pyHoistWriters) - 1)
    if ((wr.lineNumber == lineBefore) && ((strlen wr.currentLine) == colBefore)) {
      ; a body whose only content was hoisted is not empty
      if (hoist.lineNumber == hoistLineBefore) {
        wr.out("pass" true)
      }
    }
  }

  fn writeVarInitDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasParamDesc {
      def nn:CodeNode (itemAt node.children 1)
      def p:RangerAppParamDesc nn.paramDesc
      if ((p.ref_cnt == 0) && (p.is_class_variable == false)) {
        wr.out("# unused:  " false)
      }
      wr.out(("self." + p.compiledName) false)
      if ((array_length node.children) > 2) {
        wr.out(" = " false)
        ctx.setInExpr()
        def value:CodeNode (node.getThird())
        this.WalkNode(value ctx wr)
        ctx.unsetInExpr()
      } {
        ; A field with no value still needs one. Without the None branch the
        ; line read `self.one`, which raises AttributeError the first time the
        ; class is constructed. writeVarDef below does the same for locals.
        if (nn.value_type == RangerNodeType.Array) {
          wr.out(" = []" false)
        } {
          if (nn.value_type == RangerNodeType.Hash) {
            wr.out(" = {}" false)
          } {
            wr.out(" = None" false)
          }
        }
      }
      wr.newline()
    }
  }

  fn writeVarDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasParamDesc {
      def nn:CodeNode (itemAt node.children 1)
      def p:RangerAppParamDesc nn.paramDesc
      def unusedDef:boolean ((p.ref_cnt == 0) && (p.is_class_variable == false))
      def keepsCall:boolean false
      if unusedDef {
        if ((array_length node.children) > 2) {
          if (this.pyNodeContainsCall((node.getThird()))) {
            keepsCall = true
          }
        }
      }
      if (unusedDef && (keepsCall == false)) {
        ; Python has no empty suite, and a commented-out statement is not a
        ; statement: a method whose only line was an unused `def` came out as
        ; `def joo(self, cm):` with nothing under it (IndentationError). `pass`
        ; ahead of the comment is legal wherever a statement is, so it costs
        ; nothing in a body that has other lines.
        wr.out("pass  # unused:  " false)
      }
      if keepsCall {
        ; the underscore is Python's own spelling for a binding nobody reads
        wr.out("_" false)
      }
      wr.out(p.compiledName false)
      if ((array_length node.children) > 2) {
        wr.out(" = " false)
        ctx.setInExpr()
        def value:CodeNode (node.getThird())
        this.WalkNode(value ctx wr)
        ctx.unsetInExpr()
      } {
        if (nn.value_type == RangerNodeType.Array) {
          wr.out(" = []" false)
        } {
          if (nn.value_type == RangerNodeType.Hash) {
            wr.out(" = {}" false)
          } {
            wr.out(" = None" false)
          }
        }
      }
      wr.newline()
    }
  }

  fn CreateMethodCall(node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def obj:CodeNode (node.getFirst())
    def args:CodeNode (node.getSecond())
    ctx.setInExpr()
    this.WalkNode( obj ctx wr)
    ctx.unsetInExpr()
    wr.out('(' false)
    ctx.setInExpr()
    for args.children arg:CodeNode i {
      if (i > 0) {
        wr.out(', ' false)
      }
      this.WalkNode(arg ctx wr)
    }
    ctx.unsetInExpr()
    wr.out(')' false)
  }

  fn CreatePropertyGet(node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def obj:CodeNode (node.getSecond())
    def prop:CodeNode (node.getThird())
    if (this.formatterEnabled(ctx)) {
      this.writeCallReceiver(obj ctx wr)
    } {
      ctx.setInExpr()
      this.WalkNode( obj ctx wr)
      ctx.unsetInExpr()
    }
    ; The property name comes from the resolved descriptor, not from the
    ; source spelling: `def async` is declared as `self._async` on Python and
    ; writing `prop.vref` here spelled it the old way. Every other writer
    ; walks the node, which reads the descriptor list GetProperty attaches.
    wr.out('.' false)
    this.WalkNode(prop ctx wr)
  }
  
  fn CreateLambdaCall:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def fName:CodeNode (itemAt node.children 0)
    def givenArgs:CodeNode (itemAt node.children 1)

    def args:CodeNode
    if( (!null? fName.expression_value) ) {
      def lambdaExpression:CodeNode (unwrap fName.expression_value)
      args = (itemAt lambdaExpression.children 1)
    } {
      def paramOpt@(optional):RangerAppParamDesc (ctx.getVariableDef(fName.vref))
      def param:RangerAppParamDesc (unwrap paramOpt)
      def parameterName:CodeNode (unwrap param.nameNode)
      def lambdaExpression:CodeNode (unwrap parameterName.expression_value)
      args = (itemAt lambdaExpression.children 1)
    }
    ctx.setInExpr()
    this.WalkNode(fName ctx wr)
    wr.out('(' false)

    def lambdaArgs:CodeNode (unwrap args)
    for lambdaArgs.children arg:CodeNode i {
      def n:CodeNode (itemAt givenArgs.children i)
      if (i > 0) {
        wr.out(', ' false)
      }
      if(arg.value_type != RangerNodeType.NoType) {
        this.WalkNode(n ctx wr)
      }        
    }
    ctx.unsetInExpr()
    wr.out(")" false)
    if ((ctx.expressionLevel()) == 0) {
      wr.newline()
    }
  }

  ; The name a node writes in the Python output: the compiled name when the
  ; flow pass gave it one (a shadowing local is renamed `values_1`), the source
  ; name otherwise.
  fn pyEmittedName:string (n:CodeNode) {
    if n.hasParamDesc {
      def pd:RangerAppParamDesc (unwrap n.paramDesc)
      if ((strlen pd.compiledName) > 0) {
        return pd.compiledName
      }
    }
    return n.vref
  }

  ; Collect what a lambda body ASSIGNS and what it DECLARES. Python makes an
  ; assigned name a local of the function it is written in, so a hoisted lambda
  ; that updates a counter of the enclosing scope needs `nonlocal` -- without it
  ; the read raises UnboundLocalError. A nested lambda contributes its own
  ; parameters and defs as declared, so the outer def does not claim them.
  fn pyCollectAssigned:void (node:CodeNode assigned:[string:boolean] declared:[string:boolean]) {
    if node.expression {
      if ((array_length node.children) > 1) {
        def fc:CodeNode (node.getFirst())
        if ((fc.vref == "def") || (fc.vref == "let")) {
          def nn:CodeNode (node.getSecond())
          set declared (this.pyEmittedName(nn)) true
        }
        if (fc.vref == "fn") {
          if ((array_length node.children) > 2) {
            def lArgs:CodeNode (itemAt node.children 1)
            for lArgs.children la:CodeNode lai {
              set declared (this.pyEmittedName(la)) true
            }
          }
        }
        if (fc.vref == "=") {
          def tgt:CodeNode (node.getSecond())
          if ((array_length tgt.ns) < 2) {
            def tn:string (this.pyEmittedName(tgt))
            if ((strlen tn) > 0) {
              set assigned tn true
            }
          }
        }
      }
    }
    for node.children ch:CodeNode ci {
      this.pyCollectAssigned(ch assigned declared)
    }
  }

  fn CreateLambda:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def lambdaCtx (unwrap node.lambda_ctx)
    def fnNode:CodeNode (itemAt node.children 0)
    def args:CodeNode (itemAt node.children 1)
    def body:CodeNode (itemAt node.children 2)

    ; No enclosing body to hoist into (a field initializer, say): keep the
    ; single-expression form, which is all Python allows there anyway.
    if ((array_length pyHoistWriters) == 0) {
      wr.out("lambda " false)
      for args.children arg:CodeNode i {
        if (i > 0) {
          wr.out(", " false)
        }
        this.WalkNode(arg lambdaCtx wr)
      }
      wr.out(": " false)
      lambdaCtx.restartExpressionLevel()
      for body.children item:CodeNode i {
        this.WalkNode(item lambdaCtx wr)
      }
      return
    }

    pyLambdaCounter = pyLambdaCounter + 1
    def fname:string ("__rg_lambda_" + pyLambdaCounter)
    def hoist:CodeWriter (last pyHoistWriters)
    hoist.out(("def " + fname) false)
    hoist.out("(" false)
    for args.children arg:CodeNode i {
      if (i > 0) {
        hoist.out(", " false)
      }
      this.WalkNode(arg lambdaCtx hoist)
    }
    hoist.out("):" true)
    hoist.indent(1)
    def assigned:[string:boolean]
    def declared:[string:boolean]
    for args.children arg2:CodeNode ai {
      set declared (this.pyEmittedName(arg2)) true
    }
    this.pyCollectAssigned(body assigned declared)
    def nonlocals:[string]
    for (keys assigned) anm:string ani {
      if ((has declared anm) == false) {
        push nonlocals anm
      }
    }
    if (has nonlocals) {
      hoist.out(("nonlocal " + (join nonlocals ", ")) true)
    }
    ; the body of this def is where a lambda INSIDE it has to land
    def inner:CodeWriter (hoist.fork())
    push pyHoistWriters inner
    def innerLine:int inner.lineNumber
    def lineBefore:int hoist.lineNumber
    lambdaCtx.restartExpressionLevel()
    for body.children item:CodeNode i {
      this.WalkNode(item lambdaCtx hoist)
    }
    remove_index pyHoistWriters ((array_length pyHoistWriters) - 1)
    if ((hoist.lineNumber == lineBefore) && (inner.lineNumber == innerLine)) {
      hoist.out("pass" true)
    }
    hoist.newline()
    hoist.indent(-1)
    wr.out(fname false)
  } 

  ; The Python target writes no type annotations, so a type name only reaches
  ; the output through a `(typeof N)` template — `isinstance` in the union
  ; `case` is the one that matters. The name there has to be the Python type,
  ; not the Ranger one: `isinstance(item, dict)`, never
  ; `isinstance(item, JSONDataObject)`.
  fn getPythonTypeName:string (node:CodeNode ctx:RangerAppWriterContext) {
    def v_type:RangerNodeType node.value_type
    if (((v_type == RangerNodeType.Object) || (v_type == RangerNodeType.VRef)) || (v_type == RangerNodeType.NoType)) {
      v_type = (node.typeNameAsType(ctx))
    }
    if (node.eval_type != RangerNodeType.NoType) {
      v_type = node.eval_type
    }
    switch v_type {
      case RangerNodeType.Integer {
        return "int"
      }
      case RangerNodeType.Enum {
        def pyEnumName:string (pyEnums.enumNameOf(node ctx))
        if (this.pyEnumIsNative(pyEnumName ctx)) {
          return pyEnumName
        }
        return "int"
      }
      case RangerNodeType.Char {
        return "int"
      }
      case RangerNodeType.Double {
        return "float"
      }
      case RangerNodeType.String {
        return "str"
      }
      case RangerNodeType.Boolean {
        return "bool"
      }
      case RangerNodeType.Array {
        return "list"
      }
      case RangerNodeType.Hash {
        return "dict"
      }
    }
    def tn:string node.type_name
    if (ctx.isDefinedClass(tn)) {
      def cc:RangerAppClassDesc (ctx.findClass(tn))
      if cc.is_system {
        def sysName@(optional):string (get cc.systemNames "python")
        if (!null? sysName) {
          return (unwrap sysName)
        }
      }
    }
    return tn
  }

  fn writeTypeDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    wr.out((this.getPythonTypeName(node ctx)) false)
  }

  ; --- type annotations (PLAN idiomatic Python) -----------------------------
  ; Generated Python used to carry no types at all, so a reader of the output
  ; had less to go on than a reader of the Ranger source. Every signature the
  ; writer can name is annotated now. `from __future__ import annotations` is
  ; written with the header, which makes every annotation a lazy string: a
  ; class named before its `class` statement is then not a NameError, and the
  ; file keeps compiling in the order the writer emits it.
  ;
  ; A type the writer cannot name -- a lambda, a generic parameter, a system
  ; class with no python name -- is left unannotated rather than guessed.
  fn pyTypeNameFor:string (tn:string ctx:RangerAppWriterContext) {
    if ((strlen tn) == 0) {
      return ""
    }
    switch tn {
      case "int" {
        return "int"
      }
      case "char" {
        return "int"
      }
      case "double" {
        return "float"
      }
      case "string" {
        return "str"
      }
      case "boolean" {
        return "bool"
      }
      case "void" {
        return "None"
      }
      case "chararray" {
        return "bytearray"
      }
      case "charbuffer" {
        ; UTF-8 bytes: `str.encode` gives `bytes`, and indexing one gives the
        ; byte as an int, which is what charAt on a charbuffer is declared to
        ; return
        return "bytes"
      }
      case "buffer" {
        return "bytearray"
      }
      case "int_buffer" {
        return "list[int]"
      }
      case "double_buffer" {
        return "list[float]"
      }
    }
    ; a nested collection arrives as its Ranger spelling: "[string]" or
    ; "[string:[int]]"
    if ((strlen tn) >= 2) {
      if ((charAt tn 0) == (ccode "[")) {
        return (this.pyCollectionTypeFor(tn ctx))
      }
    }
    if (ctx.isDefinedClass(tn)) {
      def cc:RangerAppClassDesc (ctx.findClass(tn))
      if cc.is_system {
        def sysName@(optional):string (get cc.systemNames "python")
        if (!null? sysName) {
          return (unwrap sysName)
        }
        return ""
      }
      if cc.is_trait {
        ; a behaviour-only trait is a Protocol above, so the name IS a type
        if (pyTraits.isInterface(tn ctx)) {
          return tn
        }
        return ""
      }
      if cc.is_template {
        return ""
      }
      if cc.is_generic_instance {
        return ""
      }
      return tn
    }
    def eDef@(optional):RangerAppEnum ((ctx.getRoot()).getEnum(tn))
    if (!null? eDef) {
      if (this.pyEnumIsNative(tn ctx)) {
        return tn
      }
      return "int"
    }
    return ""
  }

  fn pyCollectionTypeFor:string (tn:string ctx:RangerAppWriterContext) {
    def n:int (strlen tn)
    def inner:string (substring tn 1 (n - 1))
    def il:int (strlen inner)
    def depth:int 0
    def sep:int (0 - 1)
    def i:int 0
    while (i < il) {
      def c:int (charAt inner i)
      if (c == (ccode "[")) {
        depth = depth + 1
      }
      if (c == (ccode "]")) {
        depth = depth - 1
      }
      if ((c == (ccode ":")) && (depth == 0)) {
        sep = i
      }
      i = i + 1
    }
    if (sep >= 0) {
      def kt:string (this.pyTypeNameFor((substring inner 0 sep) ctx))
      def vt:string (this.pyTypeNameFor((substring inner (sep + 1) il) ctx))
      if (((strlen kt) == 0) || ((strlen vt) == 0)) {
        return "dict"
      }
      return (("dict[" + kt + ", ") + vt + "]")
    }
    def et:string (this.pyTypeNameFor(inner ctx))
    if ((strlen et) == 0) {
      return "list"
    }
    return (("list[" + et) + "]")
  }

  ; The annotation for a declaration node, or "" when the writer cannot name
  ; the type.
  fn pyAnnotationOf:string (node:CodeNode ctx:RangerAppWriterContext) {
    def v_type:RangerNodeType node.value_type
    if (((v_type == RangerNodeType.Object) || (v_type == RangerNodeType.VRef)) || (v_type == RangerNodeType.NoType)) {
      v_type = (node.typeNameAsType(ctx))
    }
    if (node.eval_type != RangerNodeType.NoType) {
      v_type = node.eval_type
    }
    ; a lambda type: Callable would need the full signature, and getting it
    ; wrong is worse than leaving it off
    if (v_type == RangerNodeType.ExpressionType) {
      return ""
    }
    def base:string ""
    if (v_type == RangerNodeType.Array) {
      def at:string node.array_type
      if ((strlen node.eval_array_type) > 0) {
        at = node.eval_array_type
      }
      def et:string (this.pyTypeNameFor(at ctx))
      if ((strlen et) == 0) {
        base = "list"
      } {
        base = (("list[" + et) + "]")
      }
    }
    if (v_type == RangerNodeType.Hash) {
      def kt:string node.key_type
      if ((strlen node.eval_key_type) > 0) {
        kt = node.eval_key_type
      }
      def vt:string node.array_type
      if ((strlen node.eval_array_type) > 0) {
        vt = node.eval_array_type
      }
      def kp:string (this.pyTypeNameFor(kt ctx))
      def vp:string (this.pyTypeNameFor(vt ctx))
      if (((strlen kp) == 0) || ((strlen vp) == 0)) {
        base = "dict"
      } {
        base = (("dict[" + kp + ", ") + vp + "]")
      }
    }
    if ((strlen base) == 0) {
      def tn:string node.type_name
      if ((strlen node.eval_type_name) > 0) {
        tn = node.eval_type_name
      }
      base = (this.pyTypeNameFor(tn ctx))
      if ((strlen base) == 0) {
        switch v_type {
          case RangerNodeType.Integer {
            base = "int"
          }
          case RangerNodeType.Char {
            base = "int"
          }
          case RangerNodeType.Double {
            base = "float"
          }
          case RangerNodeType.String {
            base = "str"
          }
          case RangerNodeType.Boolean {
            base = "bool"
          }
        }
      }
    }
    if ((strlen base) == 0) {
      return ""
    }
    if (node.hasFlag("optional")) {
      if (base == "None") {
        return "None"
      }
      return (("Optional[" + base) + "]")
    }
    return base
  }

  fn writeClassVarDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ; Python doesn't need class variable declarations at class level
    ; They are initialized in __init__
  }

  ; The constructor of a `record` holds a marker parameter for each keyword,
  ; next to the parameter that carries the value. The marker has a name and no
  ; type, so it must not reach the signature: without this filter the
  ; constructor of `record Point { def xpos:int 0 def ypos:int 0 }` comes out
  ; with four parameters, two of them without a type.
  fn writeArgsDef:void (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    def pms (filter (fnDesc.params) {
      if (item.nameNode.hasFlag("keyword")) {
        return false
      }
      return true
    })
    for pms arg:RangerAppParamDesc i {
      if (i > 0) {
        wr.out(", " false)
      }
      wr.out(arg.compiledName false)
      def aNN@(optional):CodeNode arg.nameNode
      if (!null? aNN) {
        def ann:string (this.pyAnnotationOf((unwrap aNN) ctx))
        if ((strlen ann) > 0) {
          wr.out((": " + ann) false)
        }
      }
    }
  }

  ; `-> T` on a signature, written from the function's name node the way every
  ; typed target reads its return type.
  fn pyWriteReturnAnnotation:void (variant:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    def rNN@(optional):CodeNode variant.nameNode
    if (null? rNN) {
      return
    }
    def ann:string (this.pyAnnotationOf((unwrap rNN) ctx))
    if ((strlen ann) > 0) {
      wr.out((" -> " + ann) false)
    }
  }

  fn writeArrayLiteral( node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    wr.out("[" false)
    node.children.forEach({
      if( index > 0 ) {
        wr.out(", " false)
      }
      this.WalkNode( item ctx wr )
    })
    wr.out("]" false)
  }
  
  fn writeFnCall:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasFnCall {
      def fc:CodeNode (node.getFirst())
      this.WriteVRef(fc ctx wr)
      wr.out("(" false)
      def givenArgs:CodeNode (node.getSecond())
      ctx.setInExpr()
      def fnDesc:RangerAppFunctionDesc (unwrap node.fnDesc)
      for fnDesc.params arg:RangerAppParamDesc i {
        if (i > 0) {
          wr.out(", " false)
        }
        if( (array_length givenArgs.children) <= i) {
          def argumentName:CodeNode (unwrap arg.nameNode)
          def defVal@(optional):CodeNode (argumentName.getFlag("default"))
          if (!null? defVal) {
            def fc:CodeNode (defVal.vref_annotation.getFirst())
            this.WalkNode(fc ctx wr)
          } {
            ctx.addError(node "Default argument was missing")
          }
          continue 
        }
        def n:CodeNode (itemAt givenArgs.children i)
        this.WalkNode(n ctx wr)
      }
      ctx.unsetInExpr()
      wr.out(")" false)
      if ((ctx.expressionLevel()) == 0) {
        wr.newline()
      }
    }
  }

  fn writeNewCall:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasNewOper {
      def cl:RangerAppClassDesc (unwrap node.clDesc)
      def fc:CodeNode (node.getSecond())
      wr.out(cl.name false)
      wr.out("(" false)
      def constr:RangerAppFunctionDesc cl.constructor_fn
      def givenArgs:CodeNode (node.getThird())
      if (!null? constr) {
        ; A keyword marker of a record constructor names the field and carries
        ; no value. The signature drops it, so the call drops it as well.
        def written 0
        for constr.params arg:RangerAppParamDesc i {
          if (arg.nameNode.hasFlag("keyword")) {
            continue
          }
          def n:CodeNode (itemAt givenArgs.children i)
          if (written > 0) {
            wr.out(", " false)
          }
          written = written + 1
          this.WalkNode(n ctx wr)
        }
      }
      wr.out(")" false)
    }
  }

  fn CreateCallExpression(node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.has_call {
      def obj:CodeNode (node.getSecond())
      def method:CodeNode (node.getThird())
      def args:CodeNode (itemAt node.children 3)

      ; Python is the one writer that wrapped NO receiver at all, so
      ; `-format=none` has to keep emitting none of them -- the flag means
      ; "what this compiler emitted before", not "what the others emit".
      if (this.formatterEnabled(ctx)) {
        this.writeCallReceiver(obj ctx wr)
      } {
        ctx.setInExpr()
        this.WalkNode( obj ctx wr)
        ctx.unsetInExpr()
      }
      wr.out("." false)
      ; The DECLARATION is renamed when the method's name is a Python builtin
      ; -- `fn str` is defined as `_str` -- but this call site was writing the
      ; original name, so a chained `r.str(...)` called a method that does not
      ; exist. Every other writer reads compiledName here; Python did not.
      def pyMethodName:string method.vref
      def fnDesc:RangerAppFunctionDesc (unwrap node.fnDesc)
      if ((strlen fnDesc.compiledName) > 0) {
        pyMethodName = fnDesc.compiledName
      }
      wr.out(pyMethodName false)
      wr.out("(" false)
      ctx.setInExpr()

      for args.children arg:CodeNode i {
        if (i > 0) {
          wr.out(", " false)
        }
        this.WalkNode(arg ctx wr)
      }
      ctx.unsetInExpr()
      wr.out(")" false)
      if ((ctx.expressionLevel()) == 0) {
        wr.newline()
      }
    }    
  }

  fn writeClass:void (node:CodeNode ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def cl:RangerAppClassDesc node.clDesc
    if (null? cl) {
      return
    }
    def declaredFunction:[string:boolean]
    def wr:CodeWriter orig_wr
    def importFork:CodeWriter (wr.fork())

    if (wrote_header == false) {
      ; `from __future__` has to precede every other statement of the file,
      ; and the import lines are written ahead of this point -- so it goes in
      ; the slice that precedes them. Every annotation is then a lazy string,
      ; and a class named before its own `class` statement is not a NameError.
      def pyHead:CodeWriter (wr.getTag("before_imports"))
      pyHead.out("# -*- coding: utf-8 -*-" true)
      pyHead.out("from __future__ import annotations" true)
      pyHead.out("from typing import Optional" true)
      pyHead.out("" true)
      wr.out("" true)
      ; Where (create_polyfill "...") lands. Without the tag the helper text
      ; is written to a writer nobody reads, and the call to it fails at
      ; runtime with NameError.
      wr.createTag("utilities")
      wr.out("" true)
      wrote_header = true
    }
    this.writePythonNativeEnums(ctx wr)
    this.writePythonTraitProtocols(ctx wr)

    wr.out(("class " + cl.name) false)
    def parentClass:RangerAppClassDesc  
    if ( ( array_length cl.extends_classes ) > 0 ) { 
      wr.out("(" false)
      for cl.extends_classes pName:string i {
        wr.out(pName false)
        parentClass = (ctx.findClass(pName))
      }
      wr.out(")" false)
    }    
    wr.out(":" true)
    wr.indent(1)

    ; A docstring is the first STATEMENT of the block, not a comment above it
    if cl.has_doc {
      def clDocWr:RangerDocCommentWriter (new RangerDocCommentWriter)
      clDocWr.writePyDocForClass((unwrap cl) ctx wr)
    }

    ; The lazily filled slot the singleton accessor below reads. A class
    ; attribute, so it is one per class rather than one per instance.
    if (cl.isSingletonClass()) {
      wr.out("_rg_singleton_instance = None" true)
    }

    ; Constructor (__init__)
    wr.out("def __init__(self" false)
    if cl.has_constructor {
      def constr:RangerAppFunctionDesc (unwrap cl.constructor_fn)
      if ((array_length constr.params) > 0) {
        wr.out(", " false)
        this.writeArgsDef(constr ctx wr)
      }
    }
    wr.out(") -> None:" true)
    wr.indent(1)

    def wroteSuper:boolean false
    if(!null? parentClass) {
      def parent:RangerAppClassDesc (unwrap parentClass)
      wroteSuper = true
      ; Pass parent constructor arguments to super().__init__()
      if (parent.has_constructor) {
        def parentConstr:RangerAppFunctionDesc (unwrap parent.constructor_fn)
        wr.out("super().__init__(" false)
        for parentConstr.params arg:RangerAppParamDesc i {
          if (i > 0) {
            wr.out(", " false)
          }
          wr.out(arg.compiledName false)
        }
        wr.out(")" true)
      } {
        wr.out("super().__init__()" true)
      }
    }

    ; S5 FlatTaggedObject: sealable-union members carry a stable kind tag so
    ; narrowing can test the tag instead of isinstance (PLAN_SHAPES §5).
    ; Single leading underscore — a double underscore would be name-mangled
    ; to _Class__rg_kind and getattr(v, "__rg_kind") would miss it.
    def needsKind:boolean (this.classInSealableUnion((unwrap cl) ctx))
    if needsKind {
      wr.out((("self._rg_kind = \"" + cl.name) + "\"") true)
    }
    def hasContent:boolean needsKind
    ; The super() call above is a body too - without this a subclass with an
    ; empty constructor got both `super().__init__()` and a stray `pass`.
    if wroteSuper {
      hasContent = true
    }
    for cl.variables pvar:RangerAppParamDesc i {
      this.writeVarInitDef(( unwrap pvar.node ) ctx wr)
      hasContent = true
    }
    if cl.has_constructor {
      def constr:RangerAppFunctionDesc cl.constructor_fn
      wr.newline()
      def subCtx:RangerAppWriterContext ( unwrap constr.fnCtx )
      subCtx.is_function = true
      ; A DECLARED constructor is not the same thing as a constructor that
      ; writes something. `Constructor () { }` on a class with no fields and no
      ; parent used to count as content, so __init__ was emitted with nothing
      ; under it and the whole module failed to parse at the NEXT method:
      ;
      ;   def __init__(self):
      ;   def who(self):        <- IndentationError
      ;
      ; Measured the same way pyWalkBody measures a method body.
      def lineBefore:int wr.lineNumber
      def colBefore:int (strlen wr.currentLine)
      this.WalkNode(( unwrap constr.fnBody ) subCtx wr)
      if (wr.lineNumber != lineBefore) {
        hasContent = true
      }
      if ((strlen wr.currentLine) != colBefore) {
        hasContent = true
      }
    }
    if (hasContent == false) {
      wr.out("pass" true)
    }
    wr.newline()
    wr.indent(-1)

    ; The synthetic accessor of a @singleton(true) class. Call sites already
    ; write `ClassName.rg_singleton()` through the ordinary static path (see
    ; adjustType for why the name loses its underscores here); only the
    ; definition was missing. First-call constructor arguments win, which is
    ; what es6, C++, Rust, Go and Kotlin all do.
    if (cl.isSingletonClass()) {
      wr.out("@staticmethod" true)
      wr.out("def rg_singleton(" false)
      def sgWritten:int 0
      if cl.has_constructor {
        def sgc@(optional):RangerAppFunctionDesc cl.constructor_fn
        if (!null? sgc) {
          this.writeArgsDef((unwrap sgc) ctx wr)
          sgWritten = 1
        }
      }
      wr.out("):" true)
      wr.indent(1)
      wr.out((("if " + cl.name) + "._rg_singleton_instance is None:") true)
      wr.indent(1)
      wr.out((((cl.name + "._rg_singleton_instance = ") + cl.name) + "(") false)
      if (sgWritten > 0) {
        def sgc2@(optional):RangerAppFunctionDesc cl.constructor_fn
        if (!null? sgc2) {
          def sgc2F:RangerAppFunctionDesc (unwrap sgc2)
          def fwd:int 0
          for sgc2F.params arg:RangerAppParamDesc i {
            if (arg.nameNode.hasFlag("keyword")) {
              continue
            }
            if (fwd > 0) {
              wr.out(", " false)
            }
            fwd = fwd + 1
            wr.out(arg.compiledName false)
          }
        }
      }
      wr.out(")" true)
      wr.indent(-1)
      wr.out((("return " + cl.name) + "._rg_singleton_instance") true)
      wr.indent(-1)
      wr.newline()
    }

    ; Static methods
    for cl.static_methods variant:RangerAppFunctionDesc i {
      if variant.is_doc_example {
        if ((ctx.hasCompilerFlag("keep-examples")) == false) {
          continue _
        }
      }
      if (variant.nameNode.hasFlag("main")) {
        continue _
      } {
        wr.out("@staticmethod" true)
        wr.out(("def " + variant.compiledName + "(") false)
        this.writeArgsDef(variant ctx wr)
        wr.out(")" false)
        this.pyWriteReturnAnnotation(variant ctx wr)
        wr.out(":" true)
      }
      wr.indent(1)
      if variant.has_doc {
        def sDocWr:RangerDocCommentWriter (new RangerDocCommentWriter)
        sDocWr.writePyDocForMethod(variant ctx wr)
      }
      def subCtx:RangerAppWriterContext ( unwrap variant.fnCtx )
      subCtx.is_function = true
      subCtx.in_static_method = true
      this.pyWalkBody(( unwrap variant.fnBody ) subCtx wr)
      subCtx.in_static_method = false
      wr.newline()
      wr.indent(-1)
    }

    ; Instance methods
    for cl.defined_variants fnVar:string i {
      def mVs:RangerAppMethodVariants (get cl.method_variants fnVar)
      for mVs.variants variant:RangerAppFunctionDesc i {
        if variant.is_doc_example {
          if ((ctx.hasCompilerFlag("keep-examples")) == false) {
            continue
          }
        }
        if(has declaredFunction variant.name) {
          continue
        }
        set declaredFunction variant.name true
        wr.out(("def " + variant.compiledName + "(self") false)
        if ((array_length variant.params) > 0) {
          wr.out(", " false)
          this.writeArgsDef(variant ctx wr)
        }
        wr.out(")" false)
        this.pyWriteReturnAnnotation(variant ctx wr)
        wr.out(":" true)
        wr.indent(1)
        if variant.has_doc {
          def mDocWr:RangerDocCommentWriter (new RangerDocCommentWriter)
          mDocWr.writePyDocForMethod(variant ctx wr)
        }
        def subCtx:RangerAppWriterContext ( unwrap variant.fnCtx )
        subCtx.is_function = true
        subCtx.in_static_method = false
        this.pyWalkBody(( unwrap variant.fnBody ) subCtx wr)
        wr.newline()
        wr.indent(-1)
      }
    }
    wr.indent(-1)
    wr.newline()

    ; Main function at module level
    for cl.static_methods variant:RangerAppFunctionDesc i {
      ctx.disableCurrentClass()
      ctx.in_static_method = true
      def variantName:CodeNode (unwrap variant.nameNode)
      def variantCode:SourceCode (unwrap variantName.code)
      if ((variantName.hasFlag("main")) && (variantCode.filename == (ctx.getRootFile()))) {
        wr.out("# Main entry point" true)
        wr.out("def main():" true)
        wr.indent(1)
        this.pyWalkBody(( unwrap variant.fnBody ) ctx wr)
        wr.indent(-1)
        wr.newline()
        ; The call runs at import time, so everything it reaches has to be
        ; defined by then -- and the operator helper classes (operatorsOf…) are
        ; written after the user classes. Writing the entry point here left
        ; `NameError: name 'operatorsOf' is not defined` for any program that
        ; used a collection operator. file_end is after all of it.
        def theEnd:CodeWriter (wr.getTag("file_end"))
        theEnd.newline()
        theEnd.out("if __name__ == \"__main__\":" true)
        theEnd.indent(1)
        theEnd.out("main()" true)
        theEnd.indent(-1)
      }
      ctx.in_static_method = false
    }
  }

  ; --- the generated `for` (PLAN_CPP_IDIOMS C4, the Python half) --------------
  ; `for i, v in enumerate(xs):` is already Python, and it is the right answer
  ; when the body reads the index. It was emitted whether the body read it or
  ; not, so most loops in the file carried an `i` nobody used -- which is the
  ; one thing about this target that reads as generated rather than written.
  ; When the body neither reads the index nor touches the collection it is
  ; `for v in xs:`. The collection condition is the one every target asks
  ; (ForLoopShape): both forms here walk a live list, so a body that appends
  ; iterates what it appended, and only the index form lets the writer keep
  ; that meaning explicit.
  fn pyWriteOperand:void (arg:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ctx.setInExpr()
    this.WalkNode(arg ctx wr)
    ctx.unsetInExpr()
  }

  fn pyWriteForLoop:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if ((array_length node.children) < 5) {
      return
    }
    def coll:CodeNode (node.getSecond())
    def item:CodeNode (itemAt node.children 2)
    def idx:CodeNode (itemAt node.children 3)
    def body:CodeNode (itemAt node.children 4)

    wr.out("for " false)
    ; canIterate, not bodyReadsIndex alone: both Python forms walk the live
    ; list, so a body that appends grows what it is walking either way -- but
    ; the index form is the one that says so, and every other target draws the
    ; line in the same place. One answer per question beats a per-target one.
    if (pyLoops.canIterate(node)) {
      this.pyWriteOperand(item ctx wr)
      wr.out(" in " false)
      this.pyWriteOperand(coll ctx wr)
      wr.out(":" true)
    } {
      this.pyWriteOperand(idx ctx wr)
      wr.out(", " false)
      this.pyWriteOperand(item ctx wr)
      wr.out(" in enumerate(" false)
      this.pyWriteOperand(coll ctx wr)
      wr.out("):" true)
    }
    wr.indent(1)
    def sCtx:RangerAppWriterContext (ctx.fork())
    sCtx.restartExpressionLevel()
    this.WalkNode(body sCtx wr)
    wr.newline()
    wr.indent(-1)
  }

  ; Nothing else routes a template through this writer, so the only command
  ; that arrives is the one Lang.rgr declares `(custom _)` for it.
  fn CustomOperator:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def fc:CodeNode (node.getFirst())
    def cmd:string fc.vref
    if (cmd == "for") {
      this.pyWriteForLoop(node ctx wr)
    }
  }
}

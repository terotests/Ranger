                }
                wr.out(")));" true)
              }
            } {
              ; Check if this is a non-trait optional object field in a trait-related class
              ; Such fields are wrapped in Option<RefCell<T>>
              def needs_refcell_wrap_assign:boolean false
              if curr_class_is_trait_related {
                ; Check if field type is an object type (not primitive)
                def fieldTypeClassAssign@(optional):RangerAppClassDesc (ctx.findClass(field_type_name))
                if (!null? fieldTypeClassAssign) {
                  needs_refcell_wrap_assign = true
                }
              }
              ; A field of a shared class already holds the Rc — writeStructField
              ; gives it Option<Rc<RefCell<X>>> and never the extra cell — so a
              ; RefCell::new here made the value one cell deeper than the slot.
              if (this.rustClassIsShared(field_type_name ctx)) {
                needs_refcell_wrap_assign = false
              }
              if needs_refcell_wrap_assign {
                ; Optional assignment to RefCell-wrapped field: Some(RefCell::new(value))
                wr.out(" = Some(RefCell::new(" false)
                this.WalkNode(right ctx wr)
                if should_clone_rhs {
                  wr.out(".clone()" false)
                }
                wr.out("));" true)
              } {
                ; Standard optional assignment: wrap with Some() — unless
                ; the right side is ALREADY an Option. `classDesc =
                ; (ctx.getCurrentClass())` calls a method whose return is
                ; `@(weak optional)`, and a Some() around that gives an
                ; Option holding an Option.
                def rhsAlreadyOption:boolean (this.rustExprIsOptional(right ctx))
                ; A field of a shared class holds Option<Rc<RefCell<T>>>, so
                ; a RAW value on the right — `x = (new CodeNode …)` hands
                ; back the bare struct — takes the cell here. A right side
                ; that is already a handle goes in as it is.
                def optAssignRcWrap:boolean false
                if (rhsAlreadyOption == false) {
                  if (this.rustClassIsShared(field_type_name ctx)) {
                    if ((this.rustInitRcState(right ctx)) == 0) {
                      optAssignRcWrap = true
                    }
                  }
                }
                if rhsAlreadyOption {
                  wr.out(" = " false)
                } {
                  wr.out(" = Some(" false)
                }
                if optAssignRcWrap {
                  wr.out("Rc::new(RefCell::new(" false)
                }
                this.WalkNode(right ctx wr)
                if should_clone_rhs {
                  if rhs_str_ref {
                    wr.out(".to_string()" false)
                  } {
                    wr.out(".clone()" false)
                  }
                }
                if optAssignRcWrap {
                  wr.out("))" false)
                }
                if rhsAlreadyOption {

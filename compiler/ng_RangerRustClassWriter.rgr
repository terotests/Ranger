    }
    return (("Weak<RefCell<" + (this.getObjectTypeString(type_name ctx))) + ">>")
  }

  fn rustIsCollectionTypeString:boolean (type_string:string) {
    if ((strlen type_string) >= 2) {
      if ((charAt type_string 0) == (ccode "[")) {
        return true
      }
    }
    return false
  }

  ; Turn a nested collection type string — "[string]", "[string:[int]]" —
  ; into the Rust Vec / map form. Without this the fallthrough at the end of
  ; getObjectTypeString handed back the Ranger spelling unchanged and the
  ; field came out as `HashMap<String,[string]>`, with `string` an unknown
  ; type.
  fn rustCollectionTypeString:string (type_string:string ctx:RangerAppWriterContext) {
    def n:int (strlen type_string)
    def inner:string (substring type_string 1 (n - 1))
    def il:int (strlen inner)
    def depth:int 0
    def sep:int (0 - 1)
    def i:int 0
    while (i < il) {
      def c:int (charAt inner i)
      if (c == (ccode "[")) {
        depth = depth + 1
      }
      if (c == (ccode "]")) {
        depth = depth - 1
      }
      if ((c == (ccode ":")) && (depth == 0)) {
        sep = i
      }
      i = i + 1
    }
    if (sep >= 0) {
      def kt:string (substring inner 0 sep)
      def vt:string (substring inner (sep + 1) il)
      return ((((("HashMap<" + (this.rustElementTypeString(kt ctx))) + ",") + (this.rustElementTypeString(vt ctx)))) + ">")
    }
    return (("Vec<" + (this.rustElementTypeString(inner ctx))) + ">")
  }

  ; The element of a Rust collection: a shared class is held through its Rc,
  ; a primitive and a nested collection are held by value.
  fn rustElementTypeString:string (type_string:string ctx:RangerAppWriterContext) {
    if (this.rustIsCollectionTypeString(type_string)) {
      return (this.rustCollectionTypeString(type_string ctx))
    }
    if (this.rustClassIsShared(type_string ctx)) {
      return (this.rustSharedTypeString(type_string ctx))
    }
    return (this.getObjectTypeString(type_string ctx))
  }

  fn getObjectTypeString:string (type_string:string ctx:RangerAppWriterContext) {
    if (this.rustIsCollectionTypeString(type_string)) {
      return (this.rustCollectionTypeString(type_string ctx))
    }
    switch type_string {
      case "int" {
        return "i64"
      }
      case "string" {
        return "String"
      }
      case "boolean" {
        return "bool"
      }
      case "double" {
        return "f64"
      }
      case "buffer" {
        return "Vec<u8>"
      }
      case "int_buffer" {
        return "Vec<i64>"
      }
      case "double_buffer" {
        return "Vec<f64>"
      }
    }
    ; Check if this type is a trait type (class is extended by other classes)
    def typeClass@(optional):RangerAppClassDesc (ctx.findClass(type_string))
    if (!null? typeClass) {
      def tc:RangerAppClassDesc (unwrap typeClass)
      ; D-UNION: a union of classes is a Rust enum with one variant per member
      ; (PLAN_SHAPES.md S5). Anything else — the compiler's own `Any`, a union
      ; over primitives — has no Rust type of its own and falls back to the
      ; trait object, which any value can at least be coerced into.
      if tc.is_union {
        if (this.unionIsSealable(tc ctx)) {
          return (this.unionInterfaceName(type_string))
        }
        return "Rc<dyn std::any::Any>"
      }
      if tc.is_extended_by_children {
        return ("Rc<RefCell<dyn " + type_string + "Trait>>")
      }
      ; A systemclass names one type per target. Without this the Ranger name
      ; reached the output and rustc saw an undeclared type: JSONDataObject
      ; instead of the HashMap that JSON.rgr declares for Rust.
      if tc.is_system {
        def sysName@(optional):string (get tc.systemNames "rust")
        if (!null? sysName) {
          return (unwrap sysName)
        }
      }
    }
    return type_string
  }
  fn getTypeString:string (type_string:string) {
    switch type_string {
      case "int" {
        return "i64"
      }
      case "string" {
        return "String"
      }
      case "boolean" {
        return "bool"
      }
      case "double" {
        return "f64"
      }
      case "buffer" {
        return "Vec<u8>"
      }
      case "int_buffer" {
        return "Vec<i64>"
      }
      case "double_buffer" {
        return "Vec<f64>"
      }
    }
    return type_string
  }
  fn writeTypeDef:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ; a lambda-typed name is a closure trait object, and none of the
    ; Option/Weak/RefCell wrapping below applies to one — it is answered
    ; before any of that runs
    def lt_type:RangerNodeType node.value_type
    if (node.eval_type != RangerNodeType.NoType) {
      lt_type = node.eval_type
    }
    if (lt_type == RangerNodeType.ExpressionType) {
      if (!null? node.expression_value) {

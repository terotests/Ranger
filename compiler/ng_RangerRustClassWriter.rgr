            }
            def nVal:CodeNode (unwrap n)
        ; a freshly constructed union member takes its cell here
        if (this.rustWriteUnionArg(arg nVal ctx wr)) {
          continue _
        }
            ; a freshly constructed union member takes its cell here
            if (this.rustWriteUnionArg(arg nVal ctx wr)) {
              continue _
            }
            ; Check for mutable or immutable borrow
            def needsMutRef3:boolean false
            if arg.needs_cpp_reference { needsMutRef3 = true }
            if (arg.rust_borrow_type == 2) { needsMutRef3 = true }
            def needsImmutableBorrow3:boolean (arg.rust_borrow_type == 1)


  fn rustTypeIsOwnHandle:boolean (type_name:string ctx:RangerAppWriterContext) {
    def tcOpt@(optional):RangerAppClassDesc (ctx.findClass(type_name))
    if (null? tcOpt) {
      return false
    }
    def tc:RangerAppClassDesc (unwrap tcOpt)
    ; a sealable union is an enum and an unsealable one is Rc<dyn Any>;
    ; neither is a RefCell handle, so both take the wrap like a struct
    if tc.is_union {
      return false
    }
    return (tc.is_extended_by_children)
  }

  ; The type a shared name is declared with: the class inside one
  ; Rc<RefCell<…>>. Wrapping getObjectTypeString unconditionally double
  ; wrapped every class that has subclasses —
  ; Rc<RefCell<Rc<RefCell<dyn XTrait>>>> — and .borrow() on such a name
  ; yields another Rc, so every field read through it was "no field X on
  ; type RefMut<'_, Rc<RefCell<dyn XTrait>>>".
  fn rustSharedTypeString:string (type_name:string ctx:RangerAppWriterContext) {
    if (this.rustTypeIsOwnHandle(type_name ctx)) {
      return (this.getObjectTypeString(type_name ctx))
    }
    return (("Rc<RefCell<" + (this.getObjectTypeString(type_name ctx))) + ">>")
  }


              ; other shared target. Cloning one calls the CLASS's own
              ; `clone` method, which is not Rc::clone at all.
              def selfRefRaw:boolean ((this.rustInitRcState(right ctx)) == 0)
              wr.out(" = Some(" false)
              if selfRefRaw {

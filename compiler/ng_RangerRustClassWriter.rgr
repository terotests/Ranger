        } {
          wr.out((this.getTypeString(node.type_name)) false)
        }
      }
    }
    ; Close wrapper types
    if is_weak {
      if is_optional {
        ; Close Option<Weak<RefCell<T>>>
        wr.out(">>>" false)
      } {
        ; Close Weak<RefCell<T>>
        wr.out(">>" false)
      }
    } {
      if is_optional {
        if is_self_referential {
          wr.out(">>" false)
        } {
          if needs_refcell_wrap {
            ; Close both RefCell and Option: Option<RefCell<T>>
            wr.out(">>" false)
          } {
            wr.out(">" false)
          }
        }
      }
    }
  }
  ; The `.upgrade()` a single-segment read of a weak field needs. Mirrors
  ; the last-segment branch of the nsp walk: an assignment target stores
  ; into the raw field (the store side downgrades) and an `unwrap` writes
  ; its own upgrade, so both stay out of the way. A weak COLLECTION field
  ; is a plain Vec or map — the annotation there is about the elements.
  fn writeRustWeakVRefTail:void (node:CodeNode p:RangerAppParamDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    if (p.is_class_variable == false) {
      return
    }
    if (ctx.in_lhs_of_assignment || rust_in_weak_unwrap) {
      return
    }
    def wvNN@(optional):CodeNode p.nameNode
    if (null? wvNN) {
      return
    }
    def wvN:CodeNode (unwrap wvNN)
    if ((wvN.hasFlag("weak")) == false) {
      return
    }
    if (((strlen wvN.array_type) > 0) || ((strlen wvN.key_type) > 0)) {
      return
    }
    if p.is_optional {
      ; and_then, not map-then-unwrap: a weak reference whose referent is
        ; gone reads as NULL, which is what `@(weak)` means everywhere else.
        ; Unwrapping the upgrade turned a dead reference into a panic — and
        ; the null test right above it is exactly the code asking whether the
        ; referent is still there.
        wr.out(".as_ref().and_then(|__w| __w.upgrade())" false)
    } {
      wr.out(".upgrade().unwrap()" false)
    }
  }

  ; The text a `this` RECEIVER is written as. In a method with no `self` the
  ; only way in is the handle, and the borrow it takes must match what the
  ; callee asks for: a shared one nests with the shared borrows a caller may
  ; already hold, a mutable one does not.
  ; Does the receiver of this call have to be borrowed mutably? The callee's
  ; own answer when the front end resolved it; otherwise, for a `this`
  ; receiver, the method of the current class by name. Defaulting to "yes"
  ; is safe for a struct receiver and wrong for a handle: a mutable borrow
  ; will not nest with the shared ones a caller may already hold.
  ; Do we POSITIVELY know the callee mutates its receiver? Only a resolved
  ; descriptor answers; an unresolved one leaves the shared borrow, which
  ; fails loudly at compile time rather than quietly at run time.

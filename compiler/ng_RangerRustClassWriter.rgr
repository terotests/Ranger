        if (this.rustCellIsCollection(p)) {
          if rust_in_cell_assign {
            return
          }
          if ctx.in_lhs_of_assignment {
            wr.out(".borrow_mut()" false)
          } {
            wr.out(".borrow()" false)
          }
          return
        }
        if ctx.in_lhs_of_assignment {
          return
        }
        if (this.rustCellIsCopy(p)) {
          wr.out(".get()" false)
        } {
          wr.out(((".borrow().clone(); " + cellRdTmp) + " }") false)
        }
        return
      }
      wr.out((this.adjustType(p.compiledName)) false)
      ; A bare name that resolves to a weak FIELD is read here, not in the
      ; nsp walk above — `def non:ClassDesc currentClass` has one segment
      ; and no path desc — so the upgrade has to be written here too, or
      ; the reader gets the Weak where it declared an Rc (E0308).
      def pWeakTail:RangerAppParamDesc (unwrap node.paramDesc)
      this.writeRustWeakVRefTail(node pWeakTail ctx wr)
      return
    }

    def b_was_static:boolean false
    for node.ns part:string i {
      if (i > 0) {
        if ((i == 1) && b_was_static) {
          wr.out("::" false)
        } {
          wr.out("." false)
        }
      }
      if (i == 0) {
        if (ctx.hasClass(part)) {
          b_was_static = true
        }
        if ((part != "this") && (ctx.hasCurrentClass())) {
          def uc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
          def currC:RangerAppClassDesc (unwrap uc)
          def up@(optional):RangerAppParamDesc (currC.findVariable(part))
          if (!null? up) {
            if( false == (ctx.isInStatic()) ) {
              wr.out(((this.rustThisPathPrefix(ctx)) + ".") false)
            }
          }
        }
      }
      wr.out((this.adjustType(part)) false)
    }
  }
  ; A shared class in a return position hands out the Rc
  ; (PLAN_RUST_OWNERSHIP 2b); every other return type is unchanged.
  ; closes a signature: ")" then " -> T", with the arrow dropped for a void
  ; function — `-> ()` is never needed
  fn writeRustFnClose:void (variant:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    wr.out(")" false)
    def fcnn:CodeNode (unwrap variant.nameNode)
    if (((strlen fcnn.array_type) == 0) && ((strlen fcnn.key_type) == 0)) {
      if (fcnn.type_name == "void") {
        return
      }
    }
    wr.out(" -> " false)
    this.writeRustReturnType(variant ctx wr)
  }

  fn writeRustReturnType:void (variant:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    def vnn:CodeNode (unwrap variant.nameNode)
    if (((strlen vnn.array_type) == 0) && ((strlen vnn.key_type) == 0)) {
      if (this.rustClassIsShared(vnn.type_name ctx)) {
        ; NOTE: a `@(weak)` return could hand back the Weak, matching the
        ; local it usually returns, but every CALLER binds the result to an
        ; Rc name — declaring the Weak form here costs more than the returns
        ; it fixes (1630 -> 1915). The upgrade belongs at the `return`, which
        ; is a change to make with the rest of the weak modelling.
        def retSharedT:string (this.rustSharedTypeString(vnn.type_name ctx))
        ; an @(optional) return keeps its Option around the Rc
        if (vnn.hasFlag("optional")) {
          wr.out((("Option<" + retSharedT) + ">") false)
        } {
          wr.out(retSharedT false)
        }
        return
      }
    }
    rust_writing_return_type = true
    this.writeTypeDef(vnn ctx wr)
    rust_writing_return_type = false
  }

  ; Does this expression read through a shared cell (a field path rooted in
  ; an Rc<RefCell> name) or call anything that might? Used to decide whether
  ; an assignment must pre-evaluate its right side.
  ; Does this expression read a FIELD out of `name` — `cc.parent`, not the
  ; bare `cc`? Such a read borrows the cell `name` holds, and a store into
  ; `name` in the same statement would end that borrow while it is still
  ; live (E0506).
  fn rustExprReadsThrough:boolean (node:CodeNode name:string) {
    if ((array_length node.ns) >= 2) {
      if ((itemAt node.ns 0) == name) {
        return true
      }
    }
    for node.children ch:CodeNode i {
      if (this.rustExprReadsThrough(ch name)) {
        return true
      }
    }
    return false
  }

  fn rustRhsReadsSharedCell:boolean (node:CodeNode) {
    if ((array_length node.ns) >= 2) {
      if ((array_length node.nsp) > 0) {
        def rp:RangerAppParamDesc (itemAt node.nsp 0)
        if rp.rust_needs_rc_wrap {
          return true
        }
      }
    }
    if node.hasFnCall {
      return true
    }
    for node.children child:CodeNode i {
      if (this.rustRhsReadsSharedCell(child)) {
        return true
      }
    }
    return false
  }

  ; The parent fields a subclass has to carry in its own layout. Rust has no
  ; inheritance: `struct Cat` gets nothing from `struct Animal`, so a field
  ; the parent declares is simply absent — "no field `name` on type `Cat`".
  ; Every ancestor's variables are collected here, nearest first, skipping any
  ; the class already declares itself (Ranger lets a subclass restate a
  ; parent's field, and it names the same slot, so a second copy would be a
  ; second slot).
  fn rustCollectInheritedVars:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext seen:[string:boolean] into:[RangerAppParamDesc]) {
    for cl.extends_classes pName:string i {
      if (ctx.isDefinedClass(pName)) {
        def pc:RangerAppClassDesc (ctx.findClass(pName))
        for pc.variables pvar:RangerAppParamDesc j {
          if (has seen pvar.name) {
          } {
            set seen pvar.name true
            push into pvar
          }
        }
        this.rustCollectInheritedVars(pc ctx seen into)
      }
    }
  }

  ; The fields of `cl` in layout order: its own, then everything it inherits
  ; and has not restated.
  fn rustAllStructVars:[RangerAppParamDesc] (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    def res:[RangerAppParamDesc]
    def seen:[string:boolean]
    ; The class's own declarations go in first and win. Neither order is
    ; right while a subclass may restate a parent's field with a different
    ; strength: RangerAppParamDesc declares `nameNode` strong and
    ; RangerAppFunctionDesc restates it `@(weak)`, an inherited method body
    ; is emitted into every subclass's impl unchanged (the body of
    ; RangerAppParamDesc::isAllocatedType lands in RangerAppFunctionDesc's
    ; impl and reads `self.nameNode` there), and a trait accessor's
    ; signature comes from the parent while its body reads the subclass's
    ; slot. Letting the parent win fixes those two and breaks more
    ; elsewhere — measured twice, 1708 -> 1879 and 869 -> 1141. The real
    ; repair is to stop restating fields with a different strength.
    for cl.variables pvar:RangerAppParamDesc i {
      set seen pvar.name true
      push res pvar
    }
    this.rustCollectInheritedVars(cl ctx seen res)
    return res
  }

  ; The Rust type of a field, without its name — shared by the struct
  ; declaration and by the trait accessors that hand the field out.
  fn writeStructFieldType:void (p:RangerAppParamDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    rust_writing_field_type = true
    this.writeStructFieldTypeInner(p ctx wr)
    rust_writing_field_type = false
  }

  fn writeStructFieldTypeInner:void (p:RangerAppParamDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    if p.rust_interior_cell {
      def cellNameN:CodeNode (unwrap p.nameNode)
      if (this.rustCellIsCopy(p)) {
        wr.out("Cell<" false)
        this.writeTypeDef(cellNameN ctx wr)
        wr.out(">" false)
        return
      }
      if (this.rustCellIsString(p)) {
        wr.out("RefCell<String>" false)
        return
      }
      if (this.rustCellIsCollection(p)) {
        wr.out("RefCell<" false)
        this.writeTypeDef(cellNameN ctx wr)
        wr.out(">" false)
        return
      }
      wr.out("RefCell<Option<" false)
      wr.out((this.rustSharedTypeString(cellNameN.type_name ctx)) false)
      wr.out(">>" false)
      return
    }
    def nameN:CodeNode (unwrap p.nameNode)
    ; A field of a shared class holds the Rc (PLAN_RUST_OWNERSHIP 2b). A
    ; weak field keeps its Weak form, and a collection wraps its element
    ; inside writeTypeDef instead.
    def shared_field:boolean false
    if p.rust_needs_rc_wrap {
      if (nameN.hasFlag("weak") == false) {
        if (((strlen nameN.array_type) == 0) && ((strlen nameN.key_type) == 0)) {
          shared_field = true
        }
      }
    }
    if shared_field {
      if p.is_optional {
        wr.out((("Option<" + (this.rustSharedTypeString(nameN.type_name ctx))) + ">") false)
      } {
        wr.out((this.rustSharedTypeString(nameN.type_name ctx)) false)
      }
    } {
      if p.rust_static_str {
        ; a never-computed string: a pointer to the literal, Copy, no
        ; allocation on any assignment (rust_static_str)
        wr.out("&'static str" false)
      } {
        this.writeTypeDef(nameN ctx wr)
      }
    }
  }

  ; Is the segment at `idx` of this path read out of a parent-typed
  ; reference? Its owner is the segment before it, and a class that is
  ; extended by children is written as `Rc<RefCell<dyn XTrait>>` — methods
  ; and no fields — so the field has to come from a trait accessor.
  fn rustSegThroughTrait:boolean (node:CodeNode idx:int ctx:RangerAppWriterContext) {
    if (idx < 1) {
      return false
    }
    if ((array_length node.nsp) <= idx) {
      return false
    }
    def owner:RangerAppParamDesc (itemAt node.nsp (idx - 1))
    def ownerNN@(optional):CodeNode owner.nameNode
    if (null? ownerNN) {
      return false
    }
    def onn:CodeNode (unwrap ownerNN)
    ; a collection segment yields its element, so the owner's own class name
    ; is not what the next segment is read out of
    if (((strlen onn.array_type) > 0) || ((strlen onn.key_type) > 0)) {
      return false
    }
    if ((this.rustTypeIsOwnHandle(onn.type_name ctx)) == false) {
      return false
    }
    ; only a FIELD comes from an accessor. A method segment keeps its own
    ; name — routing one through rgf_… produced `x.rgf_getStrength_mut()()`,
    ; an accessor that does not exist called as if it returned a function.
    def ownerCls@(optional):RangerAppClassDesc (ctx.findClass(onn.type_name))
    if (null? ownerCls) {
      return false
    }
    def oc:RangerAppClassDesc (unwrap ownerCls)
    def seg:RangerAppParamDesc (itemAt node.nsp idx)
    def fv@(optional):RangerAppParamDesc (oc.findVariable(seg.name))
    if (null? fv) {
      return false
    }
    return true
  }

  fn writeStructField (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasParamDesc {
      def nn:CodeNode (itemAt node.children 1)
      def p:RangerAppParamDesc (unwrap nn.paramDesc)
      wr.out(((this.adjustType(p.compiledName)) + " : ") false)
      this.writeStructFieldType(p ctx wr)
      wr.out(", " true)
    }
  }

  ; A `dyn Trait` has no fields, and the compiler reads a parent's fields
  ; through parent-typed references everywhere. The trait therefore hands out
  ; each field of the trait-defining class by reference: `rgf_x()` to read,
  ; `rgf_x_mut()` to write or mutate in place. Every implementor carries the
  ; field in its own layout (rustAllStructVars flattens inherited fields
  ; down), so both bodies are the same one line whichever struct implements it.
  fn rustFieldAccessorName:string (p:RangerAppParamDesc) {
    return ("rgf_" + (this.adjustType(p.compiledName)))
  }

  ; Is this field a Copy scalar? Such a field is handed back by value, not by
  ; reference: `&bool` where a `bool` is wanted is a type error at every
  ; single read, and a copy of an i64 is what the reference would have been
  ; dereferenced into anyway.
  ; A plain `string` field. Its read accessor hands back an owned String
  ; rather than a `&String`: a borrowed one reached call sites that add
  ; their own `&` — `map.contains_key(&x.rgf_name())` becomes `&&String`,
  ; which satisfies no Borrow bound — and every reader of a string field in
  ; the compiler wants a value it can keep anyway.
  fn rustFieldIsPlainString:boolean (p:RangerAppParamDesc ctx:RangerAppWriterContext) {
    if p.rust_needs_rc_wrap {
      return false
    }
    if p.is_optional {
      return false
    }
    if p.rust_static_str {
      return false
    }
    def nameN@(optional):CodeNode p.nameNode
    if (null? nameN) {
      return false
    }
    def nn:CodeNode (unwrap nameN)
    if (((strlen nn.array_type) > 0) || ((strlen nn.key_type) > 0)) {
      return false
    }
    def v_type:RangerNodeType nn.value_type
    if ((v_type == RangerNodeType.Object) || (v_type == RangerNodeType.VRef) || (v_type == RangerNodeType.NoType)) {
      v_type = (nn.typeNameAsType(ctx))
    }
    if (nn.eval_type != RangerNodeType.NoType) {
      v_type = nn.eval_type
    }
    return (v_type == RangerNodeType.String)
  }

  fn rustFieldIsCopyScalar:boolean (p:RangerAppParamDesc ctx:RangerAppWriterContext) {
    if p.rust_needs_rc_wrap {
      return false
    }
    if p.is_optional {
      return false
    }
    def nameN@(optional):CodeNode p.nameNode
    if (null? nameN) {
      return false
    }
    def nn:CodeNode (unwrap nameN)
    if (((strlen nn.array_type) > 0) || ((strlen nn.key_type) > 0)) {
      return false
    }
    if p.rust_static_str {
      return true
    }
    def v_type:RangerNodeType nn.value_type
    if ((v_type == RangerNodeType.Object) || (v_type == RangerNodeType.VRef) || (v_type == RangerNodeType.NoType)) {
      v_type = (nn.typeNameAsType(ctx))
    }
    if (nn.eval_type != RangerNodeType.NoType) {
      v_type = nn.eval_type
    }
    if (v_type == RangerNodeType.Integer) {
      return true
    }
    if (v_type == RangerNodeType.Double) {
      return true
    }
    if (v_type == RangerNodeType.Boolean) {
      return true
    }
    if (v_type == RangerNodeType.Char) {
      return true
    }
    if (v_type == RangerNodeType.Enum) {
      return true
    }
    return false
  }

  fn writeTraitFieldAccessorDecls:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    for cl.variables pvar:RangerAppParamDesc i {
      def acc:string (this.rustFieldAccessorName(pvar))
      if ((this.rustFieldIsCopyScalar(pvar ctx)) || (this.rustFieldIsPlainString(pvar ctx))) {
        wr.out((("fn " + acc) + "(&self) -> ") false)
      } {
        wr.out((("fn " + acc) + "(&self) -> &") false)
      }
      this.writeStructFieldType(pvar ctx wr)
      wr.out(";" true)
      wr.out((("fn " + acc) + "_mut(&mut self) -> &mut ") false)
      this.writeStructFieldType(pvar ctx wr)
      wr.out(";" true)
    }
  }

  fn writeTraitFieldAccessorImpls:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    for cl.variables pvar:RangerAppParamDesc i {
      def acc:string (this.rustFieldAccessorName(pvar))
      def fld:string (this.adjustType(pvar.compiledName))
      if (this.rustFieldIsPlainString(pvar ctx)) {
        wr.out((("fn " + acc) + "(&self) -> ") false)
        this.writeStructFieldType(pvar ctx wr)
        wr.out(((" { self." + fld) + ".clone() }") true)
      } {
      if (this.rustFieldIsCopyScalar(pvar ctx)) {
        wr.out((("fn " + acc) + "(&self) -> ") false)
        this.writeStructFieldType(pvar ctx wr)
        wr.out(((" { self." + fld) + " }") true)
      } {
        wr.out((("fn " + acc) + "(&self) -> &") false)
        this.writeStructFieldType(pvar ctx wr)
        wr.out(((" { &self." + fld) + " }") true)
      }
      }
      wr.out((("fn " + acc) + "_mut(&mut self) -> &mut ") false)
      this.writeStructFieldType(pvar ctx wr)
      wr.out(((" { &mut self." + fld) + " }") true)
    }
  }
  fn writeVarDef (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasParamDesc {
      def nn:CodeNode (itemAt node.children 1)
      def p:RangerAppParamDesc nn.paramDesc
      ; a nested self-call ARGUMENT inside a `let` initializer: the
      ; statement-level extraction cannot run inside the initializer, and
      ; two mutable self borrows collide (E0499/E0502) — pull the inner
      ; calls into temporaries first, the arg loops substitute them
      if ((p.ref_cnt > 0) && ((array_length node.children) > 2)) {
        this.rustExtractSelfCallConflicts((node.getThird()) ctx wr)
      }
      ; an unused def whose initializer CALLS something still runs for its
      ; side effects — `def ignored:T (this.doWork(...))` is the language's
      ; evaluate-and-discard form. Commenting it out silently dropped the
      ; call (the for-loop update clause vanished this way). It emits as a
      ; live `let` with an underscore name; only a call-free initializer
      ; stays commented out.
      def unused_def:boolean ((p.ref_cnt == 0) && (p.is_class_variable == false))
      def unused_keeps_call:boolean false
      if unused_def {
        if ((array_length node.children) > 2) {
          if (this.rustNodeContainsCall((node.getThird()))) {
            unused_keeps_call = true
          }
        }
      }
      if (unused_def && (unused_keeps_call == false)) {
        wr.out("// unused:  " false)
      }
      def unused_pfx:string ""
      if unused_keeps_call {
        unused_pfx = "_"
      }
      ; a promoted static-string local (rust_static_str): `&'static str` with
      ; a bare-literal or Copy-read initializer — no allocation, no clone
      if p.rust_static_str {
        def s_mut:string "let "
        if (p.set_cnt > 0) {
          s_mut = "let mut "
        }
        wr.out((((s_mut + unused_pfx) + (this.adjustType(p.compiledName))) + " : &'static str = ") false)
        if ((array_length node.children) > 2) {
          this.rustWriteStaticStrValue((node.getThird()) ctx wr)
        } {
          wr.out("\"\"" false)
        }
        wr.out(";" true)
        return
      }
      def map_or_hash:boolean ((nn.value_type == RangerNodeType.Array) || (nn.value_type == RangerNodeType.Hash))
      ; Buffer type needs mut since buffer_set/buffer_fill/buffer_copy modify in place
      def is_buffer:boolean ((nn.value_type == RangerNodeType.Buffer) || (nn.value_type == RangerNodeType.IntBuffer) || (nn.value_type == RangerNodeType.DoubleBuffer))
      ; In Rust, calling &mut self methods requires the variable to be mut
      ; For now, always use mut for objects and arrays to avoid borrow issues
      def needs_mut:boolean ((((p.set_cnt > 0) || p.is_class_variable) || map_or_hash) || is_buffer)
      def is_object:boolean (nn.value_type == RangerNodeType.Object)
      
      ; Check if this local variable needs Rc<RefCell<T>> wrapping (for weak ref pattern)
      ; This is detected by static analysis when the variable is passed to a method 
      ; whose parameter is assigned to a @(weak) field
      def local_needs_rc_wrap:boolean p.rust_needs_rc_wrap
      ; a local of union type initialized with `new`: the member takes its cell here
      ; D-UNION: `def v:Shape (…)` — the local's TYPE is the enum, and the
      ; initializer is written by rustWriteUnionValue: a member is wrapped in its
      ; variant, a value already of the family passes as a clone.
      def local_is_union_slot:boolean false
      if ((array_length node.children) > 2) {
        def initTargetOpt@(optional):RangerAppClassDesc (ctx.findClass(nn.type_name))
        if (!null? initTargetOpt) {
          def initTarget:RangerAppClassDesc (unwrap initTargetOpt)
          if (this.unionIsSealable(initTarget ctx)) {
            local_is_union_slot = true
          }
        }
      }
      
      if (needs_mut || is_object) {
        wr.out(((("let mut " + unused_pfx) + (this.adjustType(p.compiledName))) + " : ") false)
      } {
        wr.out(((("let " + unused_pfx) + (this.adjustType(p.compiledName))) + " : ") false)
      }
      def nameN:CodeNode (unwrap p.nameNode)
      
      ; Rust: Check if RHS is an optional field - we need to unwrap it and use non-optional type.
      ; An uninitialized member COLLECTION carries is_optional on its desc,
      ; but the Rust field is a plain Vec/HashMap, never Option — treating it
      ; as optional dropped the declared type (`let x :  = …`) and added a
      ; spurious .unwrap() to a field that was never Option.
      def rhs_is_optional_field:boolean false
      if ((array_length node.children) > 2) {
        ; the initializer is usually parenthesised — `def p (h.payload)` —
        ; and the wrapper carries none of the name's own information, so it
        ; is opened before asking whether the read is of an optional field
        def value:CodeNode (this.rustUnwrapParens((node.getThird())))
        if (value.value_type == RangerNodeType.VRef) {
          if ((array_length value.nsp) > 0) {
            def lastIdx:int ((array_length value.nsp) - 1)
            def lastParam:RangerAppParamDesc (itemAt value.nsp lastIdx)
            if lastParam.is_optional {
              rhs_is_optional_field = true
              def lpNN@(optional):CodeNode lastParam.nameNode
              if (!null? lpNN) {
                def lpN:CodeNode (unwrap lpNN)
                if (((strlen lpN.array_type) > 0) || ((strlen lpN.key_type) > 0)) {
                  rhs_is_optional_field = false
                }
              }
            }
          } {
            ; Simple variable reference (no dots) - check paramDesc directly
            if value.hasParamDesc {
              def vp:RangerAppParamDesc value.paramDesc
              if vp.is_optional {
                rhs_is_optional_field = true
                def vpNN@(optional):CodeNode vp.nameNode
                if (!null? vpNN) {
                  def vpN:CodeNode (unwrap vpNN)
                  if (((strlen vpN.array_type) > 0) || ((strlen vpN.key_type) > 0)) {
                    rhs_is_optional_field = false
                  }
                }
              }
            }
          }
        }
      }
      
      ; a `def x@(optional):T (init)` keeps its optionality on the name
      ; node's flag alone — the desc's is_optional stays false when an
      ; initializer is present, so read both
      def eff_optional:boolean p.is_optional
      if (eff_optional == false) {
        if (nameN.hasFlag("optional")) {
          eff_optional = true
        }
      }
      ; Write type - with Rc<RefCell<>> wrapper if needed for weak ref pattern
      if local_needs_rc_wrap {
        ; Variable needs Rc<RefCell<T>> type. An OPTIONAL shared local is
        ; Option<Rc<RefCell<T>>> — the Option outside the cell, the same
        ; shape a field takes — never Rc<RefCell<Option<T>>>. A
        ; non-optional local writes the bare class type: writeTypeDef reads
        ; the node's optional flag, which an initializer that was unwrapped
        ; from an optional field leaks onto the def.
        ; a `@(weak)` LOCAL keeps the Rc: the annotation guards against
        ; reference cycles, and a name that dies with its scope makes none
        def localSharedT:string (this.rustSharedTypeString(nameN.type_name ctx))
        if (eff_optional && (((strlen nameN.array_type) == 0) && ((strlen nameN.key_type) == 0))) {
          wr.out((("Option<" + localSharedT) + ">") false)
        } {
          if ((((strlen nameN.type_name) > 0) && ((strlen nameN.array_type) == 0)) && ((strlen nameN.key_type) == 0)) {
            wr.out(localSharedT false)
          } {
            wr.out("Rc<RefCell<" false)
            this.writeTypeDef(nameN ctx wr)
            wr.out(">>" false)
          }
        }
      } {
        if rhs_is_optional_field {
          ; Write the underlying type without Option wrapper
          def v_type:RangerNodeType nameN.value_type
          if ((v_type == RangerNodeType.Object) || (v_type == RangerNodeType.VRef) || (v_type == RangerNodeType.NoType)) {
            v_type = (nameN.typeNameAsType(ctx))
          }
          if (nameN.eval_type != RangerNodeType.NoType) {
            v_type = nameN.eval_type
          }
          wr.out((this.getTypeString(nameN.type_name)) false)
        } {
          this.writeTypeDef(nameN ctx wr)
        }
      }
      
      if ((array_length node.children) > 2) {
        wr.out(" = " false)

        def value:CodeNode (node.getThird())
        ; An initializer that is already Rc<RefCell<T>> shares the object:
        ; clone the Rc, never wrap a second cell around it — `def b a` is the

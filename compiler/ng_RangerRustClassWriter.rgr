; SPDX-License-Identifier: MIT

; Helper class to hold a list of method names (for call graph)
class MethodCallList {
  def calls:[string]
  
  Constructor () {
    def c:[string]
    calls = c
  }
  
  fn add:void (methodName:string) {
    push calls methodName
  }
}

class RangerRustClassWriter {
  ; True while a method-call receiver is being written: the receiver of a
  ; call must borrow mutably (every method takes &mut self), where a plain
  ; field read borrows shared so that two reads of one cell can overlap.
  def rust_writing_call_receiver:boolean false
  ; the receiver borrow mode for the call being written: false when the
  ; called method takes &self, so WriteVRef borrows shared and an argument
  ; aliasing the receiver cannot panic the RefCell at runtime
  def rust_call_receiver_mut:boolean true
  ; set when a signature has just written `&self`/`&mut self` so that
  ; writeArgsDef knows to lead with a comma — and only then, so an empty
  ; parameter list closes as `(&mut self)` and not `(&mut self, )`
  def rust_receiver_written:boolean false
  ; a trait method signature has no body, and Rust allows no pattern in one:
  ; `mut x : T` there is "patterns aren't allowed in functions without
  ; bodies". The binding mode is the implementor's business anyway.
  def rust_in_trait_decl:boolean false
  ; set while the `unwrap` handler walks its own argument. That handler adds
  ; the upgrade of a weak field itself, so the path writer must not add a
  ; second one for the same read.
  def rust_in_weak_unwrap:boolean false
  ; set while an in-place COLLECTION operator writes its target — push,
  ; clear, remove_index, array_extract. The target is written through, so a
  ; trait accessor on its path hands back `&mut`, but the operator calls a
  ; method on that reference rather than assigning to it: the `*` a real
  ; assignment target needs would be dereferencing the method's own result.
  def rust_lhs_is_receiver:boolean false
  ; set while a function's RETURN type is written. A `@(weak)` return is
  ; still an owned handle — see writeTypeDef.
  def rust_writing_return_type:boolean false
  ; set while the body of a method emitted WITHOUT a receiver is written. Such
  ; a method reaches its own object only through the hidden __self_rc, and it
  ; takes the borrow per statement rather than for the whole call — which is
  ; what lets `def root (this.getRoot())` followed by a write through `root`
  ; run when the root IS this object.
  def rust_receiverless_method:boolean false
  ; set while a call receiver is written and the callee is known to mutate
  def rust_receiver_mut_known:boolean false
  ; the class whose method body is being written. ctx.getCurrentClass() can
  ; answer with something else by the time a call receiver is emitted, and a
  ; `this.m(…)` has to resolve `m` in the class that actually declares it.
  def rust_emit_class_name:string ""
  ; set while a call receiver is written and the callee is known to take &self
  def rust_receiver_shared_known:boolean false
  ; set while a plain-path ARGUMENT is written that the callee takes by
  ; `&mut`. An Rc handle on that path has to borrow mutably: `&mut
  ; sc.borrow().zone` is a `&mut` into a shared borrow.
  def rust_writing_mut_arg:boolean false
  ; set while a call receiver PATH is written whose head is `this` and whose
  ; target is a field held inline: the callee borrows the field, and the
  ; field is part of this struct, so the head takes the mutable borrow
  def rust_path_head_mut:boolean false
  ; set once the receiver-mutability pre-pass has a first answer for every
  ; class, so a later pass may ask what a call through a FIELD does. On the
  ; first pass nothing is settled and every answer would read the
  ; conservative default, which marks the whole program `&mut self`.
  def rust_field_call_mut_ready:boolean false
  ; set while a STRUCT FIELD's type is written. A borrowed closure needs a
  ; lifetime to sit in a struct, and the struct has none; an owned one does
  ; not. A parameter keeps the borrow, which is what call sites pass.
  def rust_writing_field_type:boolean false

  Extends (RangerGenericClassWriter)
  def compiler:LiveCompiler
  def thisName:string "self"
  ; The declared return type of the function being written, when it is a
  ; sealable union: a `return` of one MEMBER of the family has to be wrapped in
  ; its enum variant, exactly as an argument or a field assignment is.
  ; Empty for every other function.
  def rustFnReturnsUnion:string ""
  ; the declared return of the function being written, so a `return` can
  ; ask what shape the caller is expecting
  def rustFnReturnNameNode@(optional):CodeNode
  def fileHeaderWritten:boolean false
  ; writing the TARGET of a cell assignment: the whole collection is being
  ; replaced, so the path names the RefCell itself rather than borrowing it
  def rust_in_cell_assign:boolean false
  ; the local a call receiver was hoisted into, for the hidden __self_rc
  ; argument that follows it: reading the field a second time to build that
  ; argument puts the borrow back that the hoist just took away
  def rust_last_recv_tmp:string ""
  ; computing the family's mutation answer. The inherited-graph walk otherwise
  ; marks every trait method as mutating on principle — which is the blanket
  ; this analysis exists to replace, and feeding it back in makes the answer
  ; "yes" before a single body has been looked at.
  def rust_computing_family_mut:boolean false
  
  ; Rust needs semicolons at end of statements
  fn lineEnding:string () {
    return ";"
  }
  
  ; Escape Rust reserved words by prefixing with r#
  fn adjustType:string (tn:string) {
    switch tn {
      case "type" { return "r#type" }
      case "static" { return "r#static" }
      case "async" { return "r#async" }
      case "await" { return "r#await" }
      case "dyn" { return "r#dyn" }
      case "impl" { return "r#impl" }
      case "trait" { return "r#trait" }
      case "mod" { return "r#mod" }
      case "pub" { return "r#pub" }
      case "use" { return "r#use" }
      case "extern" { return "r#extern" }
      case "crate" { return "r#crate" }
      case "super" { return "r#super" }
      case "where" { return "r#where" }
      case "unsafe" { return "r#unsafe" }
      case "move" { return "r#move" }
      case "ref" { return "r#ref" }
      case "mut" { return "r#mut" }
      case "const" { return "r#const" }
      case "match" { return "r#match" }
      case "as" { return "r#as" }
      case "abstract" { return "r#abstract" }
      case "become" { return "r#become" }
      case "box" { return "r#box" }
      case "do" { return "r#do" }
      case "final" { return "r#final" }
      case "macro" { return "r#macro" }
      case "override" { return "r#override" }
      case "priv" { return "r#priv" }
      case "typeof" { return "r#typeof" }
      case "unsized" { return "r#unsized" }
      case "virtual" { return "r#virtual" }
      case "yield" { return "r#yield" }
      case "try" { return "r#try" }
      case "fn" { return "r#fn" }
      case "let" { return "r#let" }
      case "loop" { return "r#loop" }
      case "if" { return "r#if" }
      case "else" { return "r#else" }
      case "while" { return "r#while" }
      case "for" { return "r#for" }
      case "in" { return "r#in" }
      case "return" { return "r#return" }
      case "break" { return "r#break" }
      case "continue" { return "r#continue" }
      case "struct" { return "r#struct" }
      case "enum" { return "r#enum" }
      ; `self` cannot be a raw identifier — suffix it
      case "self" { return "self_" }
    }
    return tn
  }
  
  fn WriteScalarValue (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    switch node.value_type {
      case RangerNodeType.Double {
        wr.out((("" + node.double_value) + "_f64") false)
      }
      case RangerNodeType.String {
        def s:string (this.EncodeString(node ctx wr))
        wr.out(((("\"" + s) + "\"") + ".to_string()") false)
      }
      case RangerNodeType.Integer {
        wr.out(("" + node.int_value) false)
      }
      case RangerNodeType.Boolean {
        if node.boolean_value {
          wr.out("true" false)
        } {
          wr.out("false" false)
        }
      }
    }
  }
  ; a plain read whose resolved desc is a promoted static string
  ; (rust_static_str): the value is already `&'static str` — Copy, no clone,
  ; and any owned-String sink converts with .to_string() instead
  fn rustStaticStrRead:boolean (node:CodeNode) {
    def v:CodeNode node
    while (v.expression && ((array_length v.children) == 1)) {
      v = (v.getFirst())
    }
    if v.expression {
      return false
    }
    if (v.value_type != RangerNodeType.VRef) {
      return false
    }
    if ((array_length v.nsp) > 0) {
      def lastP:RangerAppParamDesc (itemAt v.nsp ((array_length v.nsp) - 1))
      return lastP.rust_static_str
    }
    if v.hasParamDesc {
      def p:RangerAppParamDesc v.paramDesc
      return p.rust_static_str
    }
    return false
  }

  ; a VALUE flowing into a static-string slot: a literal writes bare — no
  ; .to_string() — and a static read writes its Copy path; anything else
  ; walks normally and a mis-judged flow becomes a type error, never
  ; silent corruption
  fn rustWriteStaticStrValue:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def v:CodeNode node
    while (v.expression && ((array_length v.children) == 1)) {
      v = (v.getFirst())
    }
    if ((v.expression == false) && (v.value_type == RangerNodeType.String)) {
      wr.out((("\"" + (this.EncodeString(v ctx wr))) + "\"") false)
      return
    }
    ctx.setInExpr()
    this.WalkNode(v ctx wr)
    ctx.unsetInExpr()
  }

  ; a string LITERAL argument for a borrowed parameter passes bare: the
  ; parameter is &str, and `&"lit".to_string()` allocates a String just to
  ; borrow it (clippy's unnecessary_to_owned). Call only when the target
  ; parameter is an immutable borrow; writes the literal and returns true,
  ; or writes nothing.
  fn rustTryBareStrLitArg:boolean (nVal:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def v:CodeNode nVal
    while (v.expression && ((array_length v.children) == 1)) {
      v = (v.getFirst())
    }
    if v.expression {
      return false
    }
    if (v.value_type != RangerNodeType.String) {
      return false
    }
    wr.out((("\"" + (this.EncodeString(v ctx wr))) + "\"") false)
    return true
  }

  ; Is this argument a plain NAME read? A string-typed name carries
  ; value_type String, not VRef, so a `nVal.value_type == VRef` test skipped
  ; every string variable and left it moved (or left a &str where a String
  ; was declared). A literal has no vref and stays out.
  fn rustArgIsNameRead:boolean (nVal:CodeNode) {
    def v:CodeNode nVal
    while (v.expression && ((array_length v.children) == 1)) {
      v = (v.getFirst())
    }
    if (v.value_type == RangerNodeType.VRef) {
      return true
    }
    if v.expression {
      return false
    }
    if ((strlen v.vref) > 0) {
      return true
    }
    return ((array_length v.ns) > 0)
  }

  ; a read that yields a SLICE reference rather than an owned Vec — a
  ; borrowed collection parameter, which writeArgsDef spells `&[T]`. An owned
  ; sink converts it with .to_vec(); .clone() would only copy the reference.
  fn rustSliceRefRead:boolean (node:CodeNode) {
    def v:CodeNode node
    while (v.expression && ((array_length v.children) == 1)) {
      v = (v.getFirst())
    }
    if v.expression {
      return false
    }
    if (((array_length v.ns) == 1) && v.hasParamDesc) {
      def p:RangerAppParamDesc v.paramDesc
      if (p.rust_borrow_type == 1) {
        def pNN@(optional):CodeNode p.nameNode
        if (!null? pNN) {
          def pN:CodeNode (unwrap pNN)
          if (((strlen pN.array_type) > 0) && ((strlen pN.key_type) == 0)) {
            def ael:string pN.array_type
            if (((((ael == "int") || (ael == "double")) || (ael == "boolean")) || (ael == "string")) || (ael == "char")) {
              return true
            }
          }
        }
      }
    }
    return false
  }

  ; a read that yields a str REFERENCE rather than an owned String — a
  ; promoted static string, or a borrowed &str string parameter. An owned
  ; sink converts such a read with .to_string(); .clone() would only copy
  ; the reference.
  fn rustStrRefRead:boolean (node:CodeNode) {
    if (this.rustStaticStrRead(node)) {
      return true
    }
    def v:CodeNode node
    while (v.expression && ((array_length v.children) == 1)) {
      v = (v.getFirst())
    }
    if v.expression {
      return false
    }
    if (((v.value_type == RangerNodeType.VRef) && v.hasParamDesc) && ((array_length v.ns) == 1)) {
      def p:RangerAppParamDesc v.paramDesc
      if (p.rust_borrow_type == 1) {
        def pNN@(optional):CodeNode p.nameNode
        if (!null? pNN) {
          def pN:CodeNode (unwrap pNN)
          if ((pN.type_name == "string") && (((strlen pN.array_type) == 0) && ((strlen pN.key_type) == 0))) {
            return true
          }
        }
      }
    }
    return false
  }

  ; Calling a lambda MOVES each argument that is not Copy, and the operator
  ; helpers written in Ranger hand the element to the callback and then keep
  ; using it — `if cb(it, i) { res.push(it.clone()) }` is what `filter`
  ; compiles to. Every non-scalar argument goes in as a clone; for an Rc that
  ; is a refcount bump, and the callback owns what it was given either way.
  ; Is this value a REFERENCE to a handle rather than a handle? `this` in a
  ; method that carries the hidden argument is written `__self_rc`, which is
  ; `&Rc<RefCell<T>>`, and a proven-borrowed parameter is the same shape.
  ; Either one flowing into an owned position takes a clone.
  ; Does the target of this assignment hold an Rc? The last segment of the
  ; path answers — a shared-class name carries rust_needs_rc_wrap, and a
  ; plain struct local of the same class does not.
  fn rustLhsHoldsRc:boolean (left:CodeNode) {
    def nspLen:int (array_length left.nsp)
    if (nspLen > 0) {
      def lastD:RangerAppParamDesc (itemAt left.nsp (nspLen - 1))
      return lastD.rust_needs_rc_wrap
    }
    if left.hasParamDesc {
      def lp:RangerAppParamDesc left.paramDesc
      return lp.rust_needs_rc_wrap
    }
    return false
  }

  fn rustValueIsBorrowedHandle:boolean (node:CodeNode ctx:RangerAppWriterContext) {
    def bv:CodeNode (this.rustUnwrapParens(node))
    if (bv.vref == "this") {
      def bvCls@(optional):RangerAppClassDesc (ctx.getCurrentClass())
      def bvM@(optional):RangerAppFunctionDesc (ctx.getCurrentMethod())
      if ((!null? bvCls) && (!null? bvM)) {
        def bvC:RangerAppClassDesc (unwrap bvCls)
        def bvF:RangerAppFunctionDesc (this.rustEnclosingMethod((unwrap bvM)))
        if (this.rustClassIsShared(bvC.name ctx)) {
          return bvF.rust_needs_self_rc
        }
      }
      return false
    }
    if (bv.value_type != RangerNodeType.VRef) {
      return false
    }
    if ((array_length bv.ns) > 1) {
      return false
    }
    if (bv.hasParamDesc == false) {
      return false
    }
    def bvP:RangerAppParamDesc bv.paramDesc
    return ((bvP.rust_borrow_type == 1) && bvP.rust_needs_rc_wrap)
  }

  fn CreateLambdaCall:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def fName:CodeNode (itemAt node.children 0)
    def args:CodeNode (itemAt node.children 1)
    ctx.setInExpr()
    this.WalkNode(fName ctx wr)
    wr.out("(" false)
    for args.children arg:CodeNode i {
      if (i > 0) {
        wr.out(", " false)
      }
      this.WalkNode(arg ctx wr)
      def lcCloned:boolean false
      if (arg.expression == false) {
        if arg.hasParamDesc {
          def ap:RangerAppParamDesc (unwrap arg.paramDesc)
          if ((this.rustFieldIsCopyScalar(ap ctx)) == false) {
            wr.out(".clone()" false)
            lcCloned = true
          }
        }
      }
      ; a lambda call MOVES its arguments, and `this` has no desc to ask
      if (lcCloned == false) {
        if (this.rustValueIsBorrowedHandle(arg ctx)) {
          wr.out(".clone()" false)
        }
      }
    }
    wr.out(")" false)
    ctx.unsetInExpr()
    if ((ctx.expressionLevel()) == 0) {
      wr.out(";" true)
    }
  }

  ; A Ranger lambda is a Rust closure: `|a, b| { … }`. Without this the
  ; generic writer's JavaScript form reached the output — `(a, b) => { … }`
  ; — and rustc stopped at the arrow before it could look at anything else
  ; in the file. Argument types are left to inference: a closure literal is
  ; always written straight into the call that takes it, so the parameter's
  ; declared FnMut type fixes them.
  fn CreateLambda:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def lambdaCtx (unwrap node.lambda_ctx)
    def args:CodeNode (itemAt node.children 1)
    def body:CodeNode (itemAt node.children 2)
    ; the parameter that receives it is `&mut dyn FnMut(…)`, so the literal
    ; goes in as a mutable borrow. Without it rustc has no expected type to
    ; infer the closure's own parameters from — "type annotations needed" on
    ; every `item`.
    wr.out("&mut |" false)
    for args.children arg:CodeNode i {
      if (i > 0) {
        wr.out(", " false)
      }
      ; the body calls `&mut self` methods on the element as freely as any
      ; other name, so the binding is mutable; an unused `mut` is a warning
      wr.out(("mut " + (this.adjustType(arg.vref))) false)
    }
    wr.out("| {" true)
    wr.indent(1)
    lambdaCtx.restartExpressionLevel()
    for body.children item:CodeNode i {
      this.WalkNode(item lambdaCtx wr)
    }
    wr.newline()
    wr.indent(-1)
    wr.out("}" false)
  }

  ; The type of a name that holds a lambda. Rust has no bare function type,
  ; so the closure trait stands in: FnMut, because a Ranger lambda captures
  ; its enclosing scope by reference and is free to write through it. Left
  ; unwritten, a callback parameter came out as `cb : )` — a parse error at
  ; every operator helper that takes one.
  fn writeRustLambdaType:void (expression_value:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def rv:CodeNode (itemAt expression_value.children 0)
    def sec:CodeNode (itemAt expression_value.children 1)
    if rust_writing_field_type {
      wr.out("Box<dyn FnMut(" false)
    } {
      wr.out("&mut dyn FnMut(" false)
    }
    for sec.children arg:CodeNode i {
      if (i > 0) {
        wr.out(", " false)
      }
      ; the element the loop hands to the callback is the shared handle, so
      ; the signature says so. The body agrees because applySharedClassRcWrap
      ; marks a lambda's parameters too — both sides had to move together.
      if ((((strlen arg.type_name) > 0) && ((strlen arg.array_type) == 0)) && ((strlen arg.key_type) == 0)) {
        if (this.rustClassIsShared(arg.type_name ctx)) {
          ; an `@(optional)` callback parameter keeps its Option around the
          ; handle, the same shape a field or a local takes — the body asks
          ; it `is_some()` and unwraps it
          if (arg.hasFlag("optional")) {
            wr.out((("Option<" + (this.rustSharedTypeString(arg.type_name ctx))) + ">") false)
          } {
            wr.out((this.rustSharedTypeString(arg.type_name ctx)) false)
          }
        } {
          this.writeTypeDef(arg ctx wr)
        }
      } {
        this.writeTypeDef(arg ctx wr)
      }
    }
    wr.out(")" false)
    if ((rv.type_name == "void") || (rv.eval_type_name == "void")) {
    } {
      wr.out(" -> " false)
      ; …and the RETURN of a shared class is the handle too. Without this a
      ; `map` callback that hands back a CodeNode was declared to return the
      ; bare struct while every body returned the Rc.
      def lrShared:boolean false
      if ((((strlen rv.type_name) > 0) && ((strlen rv.array_type) == 0)) && ((strlen rv.key_type) == 0)) {
        lrShared = (this.rustClassIsShared(rv.type_name ctx))
      }
      if lrShared {
        if (rv.hasFlag("optional")) {
          wr.out((("Option<" + (this.rustSharedTypeString(rv.type_name ctx))) + ">") false)
        } {
          wr.out((this.rustSharedTypeString(rv.type_name ctx)) false)
        }
      } {
        this.writeTypeDef(rv ctx wr)
      }
    }
    if rust_writing_field_type {
      wr.out(">" false)
    }
  }

  ; Does getObjectTypeString already hand back the whole shared handle for
  ; this class, rather than the struct that goes inside one? A class that is
  ; extended by children has no struct type a name can hold: it is written
  ; as `Rc<RefCell<dyn XTrait>>`, handle and all. Sites that build the shared
  ; form themselves must ask this first — see rustSharedTypeString.
  ; The trait a value has to be coerced INTO on its way to this target, or ""
  ; when nothing is needed. A subclass handle is Rc<RefCell<Sub>>, and a slot
  ; typed with the trait parent holds Rc<RefCell<dyn ParentTrait>>: the two
  ; are one unsizing coercion apart, and Rust will not do it implicitly
  ; through an Option or a Weak.
  fn rustTraitCoerceName:string (targetType:string value:CodeNode ctx:RangerAppWriterContext) {
    if ((this.rustTypeIsOwnHandle(targetType ctx)) == false) {
      return ""
    }
    def vt:string (this.rustArgValueTypeName(value))
    if ((strlen vt) == 0) {
      return ""
    }
    if (vt == targetType) {
      return ""
    }
    if (this.rustTypeIsOwnHandle(vt ctx)) {
      return ""
    }
    if ((this.rustClassIsShared(vt ctx)) == false) {
      return ""
    }
    return targetType
  }

  ; The class an argument expression evaluates to, as far as the writer can
  ; tell. A named value answers from its own declaration — the evaluated type
  ; of a plain name is not always filled in — and everything else from the
  ; expression's evaluated type. A collection-typed name yields no class
  ; name: the annotation there describes the elements, not the value.
  fn rustArgValueTypeName:string (nVal:CodeNode) {
    if (nVal.value_type == RangerNodeType.VRef) {
      if nVal.hasParamDesc {
        def vP:RangerAppParamDesc nVal.paramDesc
        def vNN@(optional):CodeNode vP.nameNode
        if (!null? vNN) {
          def vN:CodeNode (unwrap vNN)
          if (((strlen vN.array_type) > 0) || ((strlen vN.key_type) > 0)) {
            return ""
          }
          if ((strlen vN.type_name) > 0) {
            return vN.type_name
          }
        }
      }
    }
    if (((strlen nVal.array_type) > 0) || ((strlen nVal.key_type) > 0)) {
      return ""
    }
    if ((strlen nVal.eval_type_name) > 0) {
      return nVal.eval_type_name
    }
    ; An element read carries no evaluated type of its own, so the element's
    ; class has to come from the collection it was read out of.
    if nVal.expression {
      if ((array_length nVal.children) >= 3) {
        def evFirst:CodeNode (nVal.getFirst())
        if ((evFirst.vref == "itemAt") || (evFirst.vref == "get")) {
          return (this.rustNodeCollectionElemType((nVal.getSecond())))
        }
      }
    }
    return ""
  }

  ; The element class of a collection-typed name, read off the declaration
  ; the path ends in — the last segment of `left.nsp`, or the whole name.
  fn rustNodeCollectionElemType:string (coll:CodeNode) {
    def nspLen:int (array_length coll.nsp)
    if (nspLen > 0) {
      def lastD:RangerAppParamDesc (itemAt coll.nsp (nspLen - 1))
      def lNN@(optional):CodeNode lastD.nameNode
      if (!null? lNN) {
        def lN:CodeNode (unwrap lNN)
        if ((strlen lN.array_type) > 0) {
          return lN.array_type
        }
      }
    }
    if coll.hasParamDesc {
      def cp:RangerAppParamDesc coll.paramDesc
      def cNN@(optional):CodeNode cp.nameNode
      if (!null? cNN) {
        def cN:CodeNode (unwrap cNN)
        if ((strlen cN.array_type) > 0) {
          return cN.array_type
        }
      }
    }
    return ""
  }

  ; The trait the hidden receiver argument is typed with in the method being
  ; written, or "" when it is typed with the container class itself. Mirrors
  ; the choice writeArgsDef makes.
  fn rustSelfRcTraitName:string (ctx:RangerAppWriterContext) {
    def scCls@(optional):RangerAppClassDesc (ctx.getCurrentClass())
    if (null? scCls) {
      return ""
    }
    def scc:RangerAppClassDesc (unwrap scCls)
    if scc.is_extended_by_children {

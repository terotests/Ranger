    }
    for cl.extends_classes tiParent:string tiPi {
      def tiPC@(optional):RangerAppClassDesc (ctx.findClass(tiParent))
      if (!null? tiPC) {
        def tiC:RangerAppClassDesc (unwrap tiPC)
        if tiC.is_extended_by_children {
          if (has tiC.defined_methods name) {
            return true
          }
        }
      }
    }
    return false
  }

  ; Does this class's `name` take `&self`? A trait family answers once for
  ; every member: the declaration and all impls share one signature.
  fn rustClassMethodKnownShared:boolean (cls:RangerAppClassDesc name:string ctx:RangerAppWriterContext) {

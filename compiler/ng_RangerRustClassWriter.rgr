              ; choice: a callee whose body never touches `this` is emitted
              ; with no receiver, and `self.m(…)` for one is "an associated
              ; function, not a method".
              def retStatic:boolean false
              def retStaticName:string ""
              if (!null? retVal.fnDesc) {
                def retFnD:RangerAppFunctionDesc (unwrap retVal.fnDesc)
                if retFnD.rust_can_be_static {
                  def retCC@(optional):RangerAppClassDesc retFnD.container_class
                  if (!null? retCC) {
                    def retCCD:RangerAppClassDesc (unwrap retCC)
                    retStatic = true
                    retStaticName = retCCD.name
                  }

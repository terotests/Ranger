    }
    def tcOpt@(optional):RangerAppClassDesc (ctx.findClass(targetTypeName))
    if (null? tcOpt) {
      return false
    }
    def target:RangerAppClassDesc (unwrap tcOpt)
    if ((this.unionIsSealable(target ctx)) == false) {
      return false
    }
    return (this.rustUnionHasMember(target (this.rustDeclaredClassOf(nVal))))
  }

  fn rustWriteUnionArg:boolean (arg:RangerAppParamDesc nVal:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def argNN@(optional):CodeNode arg.nameNode
    if (null? argNN) {
      return false
    }
    if arg.needs_cpp_reference {
      return false
    }

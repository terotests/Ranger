      def kmMD:RangerAppFunctionDesc (unwrap kmM)
      return (kmMD.rust_mut_self == false)
    }
    def kmVs:RangerAppMethodVariants (get cls.method_variants name)
    if ((array_length kmVs.variants) == 0) {
      return false
    }
    for kmVs.variants kmV:RangerAppFunctionDesc kmVi {
      if kmV.rust_mut_self {
        return false
      }
    }
    return true
  }

  ; The class a call receiver PATH lands on — `this.langWriter.m(…)` is a call

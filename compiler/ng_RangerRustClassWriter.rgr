            if ((array_length valueInner.ns) > 1) {
              should_clone_vardef = true
            } {
              ; For simple variable references, clone if ref_cnt > 1 (used elsewhere)
              if valueInner.hasParamDesc {
                def vp:RangerAppParamDesc valueInner.paramDesc
                if (vp.ref_cnt > 1) {
                  should_clone_vardef = true
                }
              }
            }
          }
          ; a borrowed parameter (&Vec<T> / &[T] / &String) read into an
          ; owned local clones — the reference cannot move (E0308)
          if valueInner.hasParamDesc {
            def vpB:RangerAppParamDesc valueInner.paramDesc
            if (vpB.rust_borrow_type > 0) {
              if ((nn.value_type == RangerNodeType.Array) || (nn.value_type == RangerNodeType.Hash)) {
                should_clone_vardef = true

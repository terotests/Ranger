        ; conservative default and borrows mutably where the signature says
        ; &self, which is a run-time panic rather than a compile error
        def mclTraitRel:boolean (mcl.is_extended_by_children || ((array_length mcl.extends_classes) > 0))
        if (mclSpecial == false) {
          def mDirect:[string:boolean]
          def mGraph:[string:MethodCallList]
          this.buildClassMutationGraph(mcl ctx mDirect mGraph)
          this.buildInheritedMutationGraph(mcl ctx mDirect mGraph)
          this.markTraitIfaceMutations(mcl ctx mDirect)
          for mcl.methods mm:RangerAppFunctionDesc mmi {
            def mmB@(optional):CodeNode mm.fnBody
            if (!null? mmB) {
              def mmCtxO@(optional):RangerAppWriterContext mm.fnCtx
              def mmCtx:RangerAppWriterContext ctx
              if (!null? mmCtxO) {
                mmCtx = (unwrap mmCtxO)
              }
              ; the SAME question the emission asks, so a call site and the
              ; signature it calls agree on the borrow — they used to differ

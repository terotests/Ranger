        } {
          if needs_ret_clone {
            ; a str reference (static string / borrowed &str param) returned
            ; as owned String converts; .clone() would return the &str
            if (this.rustStrRefRead(retVal)) {
              wr.out(".to_string()" false)
            } {
              wr.out(".clone()" false)
            }
          }
        }
        ; a SUBCLASS handle returned where the declared return is the trait
        ; parent needs the unsizing coercion — `Rc<RefCell<Sub>>` is not
        ; `Rc<RefCell<dyn ParentTrait>>` until it is cast
        if (retTraitCoerce > 0) {
          if (retTraitCoerce == 2) {
            wr.out(((".map(|__u| __u as Rc<RefCell<dyn " + retTraitName) + "Trait>>)") false)
          } {
            wr.out(((" as Rc<RefCell<dyn " + retTraitName) + "Trait>>") false)
          }
        }
        if node.rust_is_tail_return {
          wr.out("" true)
        } {
          wr.out(";" true)
        }
      } {
        ; a bare `return;` as the last statement says nothing — drop it
        if (node.rust_is_tail_return == false) {
          wr.out("return;" true)
        }
      }
      return
    }

    ; Handle clear for optional objects - need to unwrap before calling clear()
    if (cmd == "clear") {
      def target:CodeNode (node.getSecond())
      def is_optional_target:boolean false
      
      ; Check if target is an optional field
      if target.hasParamDesc {
        def pp:RangerAppParamDesc target.paramDesc
        if pp.is_optional {
          ; Check it's not an array (arrays handled differently)
          def nameN@(optional):CodeNode pp.nameNode
          if (!null? nameN) {
            def nn:CodeNode (unwrap nameN)
            if (nn.value_type != RangerNodeType.Array) {
              is_optional_target = true
            }
          }
        }
      }
      
      if is_optional_target {
        ; For optional objects, unwrap then call clear
        ; Check if the owning class is trait-related (uses Option<RefCell<T>>)
        def clear_needs_borrow_mut:boolean false
        if target.hasParamDesc {
          def clearPp:RangerAppParamDesc target.paramDesc
          def clearOwnerClass@(optional):RangerAppClassDesc clearPp.propertyClass
          ; If propertyClass is null, fall back to current class (self field)
          if (null? clearOwnerClass) {
            if clearPp.is_class_variable {
              clearOwnerClass = (ctx.getCurrentClass())
            }
          }
          if (!null? clearOwnerClass) {
            def clearOwnerC:RangerAppClassDesc (unwrap clearOwnerClass)
            if clearOwnerC.is_extended_by_children {
              clear_needs_borrow_mut = true
            }
            if (clear_needs_borrow_mut == false) {
              for clearOwnerC.extends_classes clearExtParent:string clearEpi {
                def clearExtParentClass@(optional):RangerAppClassDesc (ctx.findClass(clearExtParent))
                if (!null? clearExtParentClass) {
                  def clearEpc:RangerAppClassDesc (unwrap clearExtParentClass)
                  if clearEpc.is_extended_by_children {
                    clear_needs_borrow_mut = true
                  }
                }
              }
            }
          }
        }
        ctx.setInExpr()
        this.WalkNode(target ctx wr)
        if clear_needs_borrow_mut {
          wr.out(".as_ref().unwrap().borrow_mut().clear();" true)
        } {
          wr.out(".as_mut().unwrap().clear();" true)
        }
        ctx.unsetInExpr()
      } {
        ; A Rust Vec clears with .clear(); the target is written through, so
        ; an Rc<RefCell> segment on its path borrows mutably.
        ctx.setInExpr()
        ctx.setInLhs()
        rust_lhs_is_receiver = true
        this.WalkNode(target ctx wr)
        rust_lhs_is_receiver = false
        ctx.unsetInLhs()
        wr.out(".clear();" true)
        ctx.unsetInExpr()
      }
      return
    }

    ; Vec::remove takes &mut self, so an Rc<RefCell> segment on the target's
    ; path has to borrow mutably. The Lang.rgr template writes the same call
    ; but walks the target as a read, which left `node.borrow().children`
    ; where `node.borrow_mut().children` was needed. array_extract is the
    ; same call used for its return value.
    ; indexOf answers -1 when the item is absent, and how it compares
    ; depends on the element. Rc<RefCell<T>> implements PartialEq only when
    ; T does, and the generated structs derive none — but an Rc in a Ranger
    ; array is a handle, and "is this one in there" is an identity question.
    ; Anything else compares by value, through clones so that a reference on
    ; either side collapses.
    if (cmd == "indexOf") {
      def ioArr:CodeNode (node.getSecond())
      def ioItem:CodeNode (node.getThird())
      def ioElem:string ioArr.array_type
      if ((strlen ioElem) == 0) {
        if ioArr.hasParamDesc {
          def ioP:RangerAppParamDesc (unwrap ioArr.paramDesc)
          def ioPNN@(optional):CodeNode ioP.nameNode
          if (!null? ioPNN) {
            def ioPN:CodeNode (unwrap ioPNN)
            ioElem = ioPN.array_type
          }
        }
      }
      ctx.setInExpr()
      wr.out("(" false)
      this.WalkNode(ioArr ctx wr)
      if (this.rustClassIsShared(ioElem ctx)) {
        wr.out(".iter().position( |__r| Rc::ptr_eq(__r, &(" false)
        this.WalkNode(ioItem ctx wr)
        wr.out(")) )" false)
      } {
        wr.out(".iter().position( |__r| __r.clone() == (" false)
        this.WalkNode(ioItem ctx wr)
        wr.out(").clone() )" false)
      }
      wr.out(".map(|__i| __i as i64).unwrap_or(-1))" false)
      ctx.unsetInExpr()
      if ((ctx.expressionLevel()) == 0) {
        wr.out(";" true)
      }
      return
    }

    if ((cmd == "remove_index") || (cmd == "array_extract")) {
      def rmTarget:CodeNode (node.getSecond())
      def rmIndex:CodeNode (node.getThird())
      ctx.setInExpr()
      ctx.setInLhs()
      rust_lhs_is_receiver = true
      this.WalkNode(rmTarget ctx wr)
      rust_lhs_is_receiver = false
      ctx.unsetInLhs()
      wr.out(".remove((" false)
      this.WalkNode(rmIndex ctx wr)
      wr.out(") as usize)" false)
      ctx.unsetInExpr()
      if ((ctx.expressionLevel()) == 0) {
        wr.out(";" true)
      }
      return
    }

    if (cmd == "push") {
      def left:CodeNode (node.getSecond())
      def right:CodeNode (node.getThird())
      
      ; Get the array type to check if it's a string array
      def arr_type:string ""
      if left.hasParamDesc {
        def pp:RangerAppParamDesc left.paramDesc
        arr_type = pp.nameNode.array_type
      }
      
      ; Check if the pushed value might be used after this (needs cloning)
      def needs_clone:boolean false
      if (right.value_type == RangerNodeType.VRef) {
        if right.hasParamDesc {
          def rp:RangerAppParamDesc right.paramDesc
          ; Clone if ref_cnt > 1 (used more than once) or if it's a string/object
          if (rp.ref_cnt > 1) {
            needs_clone = true
          }
          ; Always clone strings since they don't implement Copy
          if (arr_type == "string") {
            needs_clone = true
          }
        }
      }
      
      ; Write the push operation. The target is written through, so an
      ; Rc<RefCell> segment on its path must borrow mutably.
      ctx.setInExpr()
      ctx.setInLhs()
      rust_lhs_is_receiver = true
      this.WalkNode(left ctx wr)
      rust_lhs_is_receiver = false
      ctx.unsetInLhs()
      wr.out(".push(" false)
      ; an element of a shared class is an Rc: wrap a raw value, clone a
      ; wrapped name, take an owned Rc as it is
      if (this.rustClassIsShared(arr_type ctx)) {
        def push_rc_state:int (this.rustInitRcState(right ctx))
        if (push_rc_state == 0) {
          wr.out("Rc::new(RefCell::new(" false)
          this.WalkNode(right ctx wr)
          wr.out("))" false)
        }
        if (push_rc_state == 1) {
          this.WalkNode(right ctx wr)
          wr.out(".clone()" false)
        }
        if (push_rc_state == 2) {
          this.WalkNode(right ctx wr)
          ; …unless it is only a REFERENCE to a handle — the element the Vec
          ; keeps has to be an owned Rc
          if (this.rustValueIsBorrowedHandle(right ctx)) {
            wr.out(".clone()" false)
          }
        }
        ctx.unsetInExpr()
        wr.out(");" true)
        return
      }
      this.WalkNode(right ctx wr)
      
      ; Add .to_string() if pushing to a string array and the value is a string literal
      if (arr_type == "string") {
        if (right.value_type == RangerNodeType.String) {
          wr.out(".to_string()" false)
        }
      }
      ; Clone when needed to avoid move errors — never for a Copy scalar
      if (((arr_type == "int") || (arr_type == "double")) || (arr_type == "boolean")) {
        needs_clone = false
      }
      if needs_clone {
        ; a str-reference value (static string / borrowed &str param) makes
        ; the owned element with .to_string()
        if ((arr_type == "string") && (this.rustStrRefRead(right))) {
          wr.out(".to_string()" false)
        } {
          ; a borrowed slice into an owned Vec element -- pushing `r:[string]`
          ; into `rows:[[string]]`. `.clone()` of a `&[T]` is another `&[T]`,
          ; so the owned element takes `.to_vec()`. Reached whenever the
          ; element type is itself a collection, which is what a generic class
          ; instantiated at an array type produces.
          if (this.rustSliceRefRead(right)) {
            wr.out(".to_vec()" false)
          } {
            wr.out(".clone()" false)
          }
        }
      } {
        if ((arr_type == "string") && (this.rustStrRefRead(right))) {
          wr.out(".to_string()" false)
        }
        ; Add .clone() when pushing objects to arrays (the pushed value may be used later)
        if (right.value_type == RangerNodeType.VRef) {
          if (arr_type != "string") {
            if (arr_type != "int") {
              if (arr_type != "double") {
                if (arr_type != "boolean") {
                  if (this.rustSliceRefRead(right)) {
                    wr.out(".to_vec()" false)
                  } {
                    wr.out(".clone()" false)
                  }
                }
              }
            }
          }
        }
      }
      ctx.unsetInExpr()
      wr.out(");" true)
      return
    }

    ; Handle unwrap for optional types - need to dereference Box for self-referential types
    ; and handle Weak references with upgrade()
    if (cmd == "unwrap") {
      def arg:CodeNode (node.getSecond())
      
      ; Check if the inner type is a self-referential Box
      def needs_deref:boolean false
      def is_self_field:boolean false
      def is_weak_ref:boolean false
      def inner_type:string ""
      
      if arg.hasParamDesc {
        def pp:RangerAppParamDesc arg.paramDesc
        ; Check if this is a class variable (self field)
        is_self_field = pp.is_class_variable
        def nameN@(optional):CodeNode pp.nameNode
        if (!null? nameN) {
          def nn:CodeNode (unwrap nameN)
          inner_type = nn.type_name
          ; Check if this is a weak reference. Only a FIELD holds a Weak; a
          ; `@(weak)` local keeps the Rc, so upgrading one is an upgrade of
          ; something that was never downgraded.
          if (nn.hasFlag("weak")) {
            if pp.is_class_variable {
              is_weak_ref = true
            }
          }
          ; Check if field type equals the class that owns this property (self-referential)
          def oc@(optional):RangerAppClassDesc pp.propertyClass
          if (!null? oc) {
            def ownerClass:RangerAppClassDesc (unwrap oc)
            if (ownerClass.name == inner_type) {
              needs_deref = true
            }
          }
        }
      }
      
      ; an Rc field of a shared class provides its own indirection: no Box
      if (this.rustClassIsShared(inner_type ctx)) {
        needs_deref = false
      }

      ctx.setInExpr()
      
      ; Handle weak references - need to upgrade() to get Rc, then borrow_mut() to access value
      if is_weak_ref {
        ; this handler writes the upgrade itself, so the path writer must
        ; leave the field alone while the argument is walked
        rust_in_weak_unwrap = true
        this.WalkNode(arg ctx wr)
        rust_in_weak_unwrap = false
        ; A weak field of a shared class upgrades to the Rc itself
        ; (PLAN_RUST_OWNERSHIP 2b): the unwrapped value stays
        ; Rc<RefCell<T>>, and use sites borrow it like any shared name.
        if (this.rustClassIsShared(inner_type ctx)) {
          wr.out(".clone().unwrap().upgrade().unwrap()" false)
          ctx.unsetInExpr()
          return
        }
        if is_self_field {
          ; Clone the Option<Weak<...>> first, then upgrade and borrow
          wr.out(".clone().unwrap().upgrade().unwrap().borrow_mut()" false)
        } {
          wr.out(".unwrap().upgrade().unwrap().borrow_mut()" false)
        }
        ctx.unsetInExpr()
        return
      }
      
      if needs_deref {
        wr.out("(*" false)
        this.WalkNode(arg ctx wr)
        ; Clone self fields before unwrap to avoid moving out of self
        if is_self_field {
          wr.out(".clone().unwrap())" false)
        } {
          wr.out(".unwrap())" false)
        }
      } {
        this.WalkNode(arg ctx wr)
        ; Clone self fields before unwrap to avoid moving out of self.
        ; A bare optional LOCAL clones too: unwrap takes the Option by
        ; value, and a name unwrapped inside a loop or reused later is
        ; gone after the move (E0382).
        def unwrap_bare_local:boolean false
        if ((arg.expression == false) && (arg.value_type == RangerNodeType.VRef)) {
          if ((array_length arg.ns) <= 1) {
            unwrap_bare_local = true
          }
        }
        ; an Option of a Copy scalar copies by itself — cloning it is
        ; clippy's clone_on_copy
        if unwrap_bare_local {
          if (inner_type == "int") { unwrap_bare_local = false }
          if (inner_type == "double") { unwrap_bare_local = false }
          if (inner_type == "boolean") { unwrap_bare_local = false }
          if (inner_type == "char") { unwrap_bare_local = false }
          if (TTypeRegistry.isIntAlias(inner_type)) { unwrap_bare_local = false }
          if (TTypeRegistry.isFloatAlias(inner_type)) { unwrap_bare_local = false }
        }
        if (is_self_field || unwrap_bare_local) {
          wr.out(".clone().unwrap()" false)
        } {
          wr.out(".unwrap()" false)
        }
      }
      ctx.unsetInExpr()
      return
    }
  }
}

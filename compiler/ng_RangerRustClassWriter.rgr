    if ((has ksC.method_variants ksName) == false) {
      def ksM@(optional):RangerAppFunctionDesc (ksC.findMethod(ksName))
      if (null? ksM) {
        return false
      }
      def ksMD:RangerAppFunctionDesc (unwrap ksM)
      return (ksMD.rust_mut_self == false)
    }
    def ksVs:RangerAppMethodVariants (get ksC.method_variants ksName)
    if ((array_length ksVs.variants) == 0) {
      return false
    }
    for ksVs.variants ksV:RangerAppFunctionDesc ksVi {
      if ksV.rust_mut_self {
        return false
      }
    }
    return true
  }

  fn rustReceiverKnownMut:boolean (node:CodeNode fc:CodeNode ctx:RangerAppWriterContext) {
    ; the CLASS's descriptor first: node.fnDesc is a third copy the receiver
    ; pre-pass never sees, so it still carries the conservative default
    if ((array_length fc.ns) == 2) {
      if ((itemAt fc.ns 0) == "this") {
        def rkCls@(optional):RangerAppClassDesc
        if ((strlen rust_emit_class_name) > 0) {
          if (ctx.isDefinedClass(rust_emit_class_name)) {
            rkCls = (ctx.findClass(rust_emit_class_name))
          }
        }
        if (null? rkCls) {
          rkCls = (ctx.getCurrentClass())
        }
        if (!null? rkCls) {
          def rkC:RangerAppClassDesc (unwrap rkCls)
          def rkM@(optional):RangerAppFunctionDesc (rkC.findMethod((itemAt fc.ns 1)))
          if (!null? rkM) {

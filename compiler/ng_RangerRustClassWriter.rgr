          ; parameter is `&Rc<RefCell<T>>` and the local declares the Rc
          ; itself. The rc-wrap path writes its own clone, so this only
          ; covers the untyped `def ctx (in_ctx)` shape it never sees.
          if (local_needs_rc_wrap == false) {
            if (thisInit.value_type == RangerNodeType.VRef) {
              if ((array_length thisInit.ns) == 1) {
                if thisInit.hasParamDesc {
                  def biP:RangerAppParamDesc thisInit.paramDesc
                  if ((biP.rust_borrow_type == 1) && biP.rust_needs_rc_wrap) {

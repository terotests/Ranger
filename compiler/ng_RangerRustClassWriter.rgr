    ; expression whose value is a shared class — an element read, a map get,
    ; a call — already evaluates to an owned Rc under the flag
    if (value.hasNewOper == false) {
      if (this.rustClassIsShared(value.eval_type_name ctx)) {
        return 2
      }
    }
    ; a call that returns a shared class already hands out an owned Rc —
    ; but a `new` carries a call node of its own (the constructor) and still
    ; produces the raw struct
    if (value.hasFnCall && (value.hasNewOper == false)) {
      if (!null? value.fnDesc) {
        def cfd:RangerAppFunctionDesc (unwrap value.fnDesc)
        if (!null? cfd.nameNode) {
          def rt:CodeNode (unwrap cfd.nameNode)
          if (((strlen rt.array_type) == 0) && ((strlen rt.key_type) == 0)) {
            if (this.rustClassIsShared(rt.type_name ctx)) {
              return 2
            }
          }
        }
      }
    }
    if ((array_length value.children) >= 2) {
      def first:CodeNode (value.getFirst())
      if (first.vref == "unwrap") {

      rust_writing_call_receiver = false
      rust_call_receiver_mut = true
      rust_receiver_shared_known = false
      rust_path_head_mut = false
      wr.out("(" false)
      def std_wrote_selfrc:boolean (this.writeSelfRcReceiverArg(node fc ctx wr))
      for node.fnDesc.params arg:RangerAppParamDesc i {

      for hdrRoot.definedClasses mcl:RangerAppClassDesc mci {
        def mclSpecial:boolean (((((mcl.is_system || mcl.is_trait) || mcl.is_template) || mcl.is_operator_class) || mcl.is_generic_instance) || mcl.is_union)

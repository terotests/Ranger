        def retTraitCoerce:int 0
        def retTraitName:string ""
        if (!null? rustFnReturnNameNode) {
          def rtNN:CodeNode (unwrap rustFnReturnNameNode)
          if (((strlen rtNN.array_type) == 0) && ((strlen rtNN.key_type) == 0)) {
            if (this.rustTypeIsOwnHandle(rtNN.type_name ctx)) {
              def retValT:string (this.rustArgValueTypeName(retVal))
              if ((strlen retValT) > 0) {

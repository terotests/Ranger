  ; The fields of `cl` in layout order: its own, then everything it inherits
  ; and has not restated.
  fn rustAllStructVars:[RangerAppParamDesc] (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    def res:[RangerAppParamDesc]
    def seen:[string:boolean]
    ; The class's own declarations go in first and win. Neither order is
    ; right while a subclass may restate a parent's field with a different
    ; strength: RangerAppParamDesc declares `nameNode` strong and
    ; RangerAppFunctionDesc restates it `@(weak)`, an inherited method body
    ; is emitted into every subclass's impl unchanged (the body of
    ; RangerAppParamDesc::isAllocatedType lands in RangerAppFunctionDesc's
    ; impl and reads `self.nameNode` there), and a trait accessor's
    ; signature comes from the parent while its body reads the subclass's
    ; slot. Letting the parent win fixes those two and breaks more
    ; elsewhere — measured twice, 1708 -> 1879 and 869 -> 1141. The real
    ; repair is to stop restating fields with a different strength.
    for cl.variables pvar:RangerAppParamDesc i {
      set seen pvar.name true
      push res pvar
    }
    this.rustCollectInheritedVars(cl ctx seen res)
    return res

  ; is the one type all of them share.
  fn rustSelfRcParamType:string (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext) {
    if (null? fnDesc.container_class) {
      return ""
    }
    def scc:RangerAppClassDesc (unwrap fnDesc.container_class)
    def sccName:string scc.name
    if scc.is_extended_by_children {
      return (("dyn " + scc.name) + "Trait")
    }
    for scc.extends_classes sccP:string sccPi {
      if (ctx.isDefinedClass(sccP)) {
        def sccPC:RangerAppClassDesc (ctx.findClass(sccP))
        if sccPC.is_extended_by_children {
          if (has sccPC.defined_methods fnDesc.name) {
            sccName = (("dyn " + sccPC.name) + "Trait")
          }
        }
      }
    }
    return sccName
  }

  ; …and the handle a call site holds is the CONCRETE class wherever the
  ; receiver was declared as one. Rust will not pass `&Rc<RefCell<Child>>`
  ; where `&Rc<RefCell<dyn ParentTrait>>` is declared, so the unsizing goes in
  ; here. An empty answer means the two already agree.
  fn rustSelfRcCoerceTo:string (fc:CodeNode fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext) {
    def want:string (this.rustSelfRcParamType(fnDesc ctx))
    if ((strlen want) < 5) {
      return ""
    }
    if ((substring want 0 4) != "dyn ") {
      return ""
    }
    def nsLen:int (array_length fc.ns)
    if (nsLen < 2) {
      return ""
    }
    ; the class the receiver is declared as: `this` is the enclosing class,
    ; anything else is the desc of the segment the method hangs off
    def rcvType:string ""
    if (((itemAt fc.ns 0) == "this") && (nsLen == 2)) {
      def ccOpt@(optional):RangerAppClassDesc (ctx.getCurrentClass())
      if (null? ccOpt) {
        return ""
      }
      def ccCls:RangerAppClassDesc (unwrap ccOpt)
      rcvType = ccCls.name
    } {
      if ((array_length fc.nsp) < (nsLen - 1)) {
        return ""
      }
      def rcvD:RangerAppParamDesc (itemAt fc.nsp (nsLen - 2))
      def rcvNN@(optional):CodeNode rcvD.nameNode
      if (null? rcvNN) {
        return ""
      }
      def rcvN:CodeNode (unwrap rcvNN)
      if (((strlen rcvN.array_type) > 0) || ((strlen rcvN.key_type) > 0)) {
        return ""
      }
      rcvType = rcvN.type_name
    }
    if ((strlen rcvType) == 0) {
      return ""
    }
    ; a receiver that is ITSELF written as a trait object already has the
    ; declared type — nothing to coerce
    if (this.rustTypeIsOwnHandle(rcvType ctx)) {
      return ""
    }
    if ((this.rustClassIsShared(rcvType ctx)) == false) {
      return ""
    }
    return want
  }

  fn writeSelfRcReceiverArg:boolean (node:CodeNode fc:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (null? node.fnDesc) {
      rust_last_recv_tmp = ""
      return false
    }
    if ((this.rustNeedsSelfRc((unwrap node.fnDesc) ctx)) == false) {
      rust_last_recv_tmp = ""
      return false
    }
    ; the receiver was hoisted a moment ago: the same local IS the handle
    if ((strlen rust_last_recv_tmp) > 0) {
      wr.out(("&" + rust_last_recv_tmp) false)
      rust_last_recv_tmp = ""
      return true
    }
    def nsLen:int (array_length fc.ns)
    if (nsLen < 2) {
      ; the receiver is an expression the writer cannot name, so there is no
      ; Rc to pass; a silent skip would be a rustc error about a missing
      ; argument, so say what to do instead
      ctx.addError(node "This method stores `this`, so its Rust form needs the receiver's Rc. Bind the receiver to a variable first: def recv:T (expr) — then recv.method(...).")
      return false
    }
    def root:string (itemAt fc.ns 0)
    if ((root == "this") && (nsLen == 2)) {
      ; a self-call: the caller holds the Rc, because computeSelfRcNeeds
      ; marked it transitively. From a constructor there is no Rc to hold —
      ; the object is not in its cell yet — so the call cannot be written.
      def cm@(optional):RangerAppFunctionDesc (ctx.getCurrentMethod())
      if (!null? cm) {
        def cmf:RangerAppFunctionDesc (this.rustEnclosingMethod((unwrap cm)))
        if (cmf.rust_needs_self_rc == false) {
          ctx.addError(node "A method that stores `this` cannot be called from here on Rust: the constructor runs before the object is inside its Rc. Call it on the constructed value instead.")
          return false
        }
      }
      def selfCoerce:string (this.rustSelfRcCoerceTo(fc (unwrap node.fnDesc) ctx))
      if ((strlen selfCoerce) > 0) {
        wr.out((("&(__self_rc.clone() as Rc<RefCell<" + selfCoerce) + ">>)") false)
      } {
        wr.out("__self_rc" false)
      }
      return true
    }
    ; build the receiver path: a bare member roots at self, and a strong
    ; optional segment holds Option<Rc<…>> — reach the Rc with
    ; .as_ref().unwrap() so the hidden __self_rc argument is the live Rc
    ; `thisName`, not the literal "self": a constructor body calls its
    ; receiver `me`, and a hidden-argument path that said `self` there
    ; referred to the module keyword in a function with no self parameter.
    def path:string ""
    def segIdx:int 0
    if (root == "this") {
      path = (this.rustThisPathPrefix(ctx))
      segIdx = 1
    }
    while (segIdx < (nsLen - 1)) {
      def segName:string (this.adjustType((itemAt fc.ns segIdx)))
      def haveSegD:boolean false
      def segOptional:boolean false
      def segMember:boolean false
      if ((array_length fc.nsp) > segIdx) {
        def segD:RangerAppParamDesc (itemAt fc.nsp segIdx)
        haveSegD = true
        segMember = segD.is_class_variable
        ; the receiver itself is written through WriteVRef, which prefers the
        ; de-shadowed compiledName (`left` → `left_1`); the hidden-arg path
        ; must follow it or it names a variable that no longer exists (E0425)
        if ((strlen segD.compiledName) > 0) {
          segName = (this.adjustType(segD.compiledName))
        }
        ; a field reached through a parent-typed reference comes from the
        ; trait's accessor here as well — `dyn Trait` has no fields, so the
        ; bare name is "no field `nameNode` on type `dyn …Trait`" (E0609)
        if (this.rustSegThroughTrait(fc segIdx ctx)) {
          segName = ((this.rustFieldAccessorName(segD)) + "()")
        }
        if segD.is_optional {
          def sdNN@(optional):CodeNode segD.nameNode
          def segColl:boolean false
          if (!null? sdNN) {
            def sdN:CodeNode (unwrap sdNN)
            if (((strlen sdN.array_type) > 0) || ((strlen sdN.key_type) > 0)) {
              segColl = true
            }
          }
          if (segColl == false) {
            segOptional = true
          }
        }
      }
      if ((strlen path) == 0) {
        if segMember {
          path = (((this.rustThisPathPrefix(ctx)) + ".") + segName)
        } {
          path = segName
        }
      } {
        path = ((path + ".") + segName)
      }
      if segOptional {
        path = (path + ".as_ref().unwrap()")
      }
      ; a WEAK segment holds a Weak, and the hidden argument has to be a
      ; live Rc — `&self.compiler…parser.as_ref().unwrap()` was a `&&Weak`.
      ; The upgraded Rc is a temporary that lives to the end of the
      ; statement, which is as long as the call it is an argument to.
      if haveSegD {
        def segWkD:RangerAppParamDesc (itemAt fc.nsp segIdx)
        def segWkNN@(optional):CodeNode segWkD.nameNode
        if (!null? segWkNN) {
          def segWkN:CodeNode (unwrap segWkNN)
          if (segWkN.hasFlag("weak")) {
            ; only a FIELD holds a Weak — the same rule the path writer and
            ; the assignment side follow
            if segWkD.is_class_variable {
              if (((strlen segWkN.array_type) == 0) && ((strlen segWkN.key_type) == 0)) {
                path = (path + ".upgrade().unwrap()")
              }
            }
          }
        }
      }
      ; a segment that holds an Rc has to be borrowed before the next field
      ; is read out of it — the handle has no fields of its own. The Ref this
      ; makes lives to the end of the statement, which is exactly as long as
      ; the argument it is being built for.
      if (segIdx < (nsLen - 2)) {
        if haveSegD {
          def segRcD:RangerAppParamDesc (itemAt fc.nsp segIdx)
          if segRcD.rust_needs_rc_wrap {
            def segRcNN@(optional):CodeNode segRcD.nameNode
            if (!null? segRcNN) {
              def segRcN:CodeNode (unwrap segRcNN)
              ; a weak segment borrows too: the `.upgrade().unwrap()` written
              ; above already turned it back into an Rc, and a `@(weak)` local
              ; never held anything else
              if (((strlen segRcN.array_type) == 0) && ((strlen segRcN.key_type) == 0)) {
                path = (path + ".borrow()")
              }
            }
          }
        }
      }
      segIdx = segIdx + 1
    }
    def pathCoerce:string (this.rustSelfRcCoerceTo(fc (unwrap node.fnDesc) ctx))
    if ((strlen pathCoerce) > 0) {
      wr.out((((("&(" + path) + ".clone() as Rc<RefCell<") + pathCoerce) + ">>)") false)
    } {
      wr.out(("&" + path) false)
    }
    return true
  }

  ; the receiver of a method signature; the trailing comma is written by
  ; writeArgsDef, and only when something follows
  fn writeRustReceiver:void (mutSelf:boolean wr:CodeWriter) {
    rust_receiver_written = true
    if mutSelf {
      wr.out("&mut self" false)
    } {
      wr.out("&self" false)
    }
  }

  ; The argument list a trait forwarding body hands on to the inherent
  ; method. It has to mirror writeArgsDef exactly — the same names, the same
  ; skipped keyword parameters, and the hidden __self_rc where the method
  ; takes one — or the forwarding call does not match the thing it calls.
  fn writeTraitForwardArgs:void (variant:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter lead:boolean) {
    def wroteAny:boolean lead
    if (this.rustNeedsSelfRc(variant ctx)) {
      if wroteAny {
        wr.out(", " false)
      }
      wroteAny = true
      wr.out("__self_rc" false)
    }
    for variant.params arg:RangerAppParamDesc pi {
      if (arg.nameNode.hasFlag("keyword")) {
        continue
      }
      if wroteAny {
        wr.out(", " false)
      }
      wroteAny = true
      wr.out((this.adjustType(arg.compiledName)) false)
    }
  }

  fn writeArgsDef (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    def pms (filter (fnDesc.params) {
      if (item.nameNode.hasFlag("keyword")) {
        return false
      }
      return true
    })
    def lead_comma:boolean rust_receiver_written
    rust_receiver_written = false
    def wrote_selfrc:boolean false
    if (this.rustNeedsSelfRc(fnDesc ctx)) {
      if lead_comma {
        wr.out(", " false)
      }
      def sccName:string (this.rustSelfRcParamType(fnDesc ctx))
      wr.out((("__self_rc : &Rc<RefCell<" + sccName) + ">>") false)
      wrote_selfrc = true
    }
    for pms arg:RangerAppParamDesc i {
      if (((i > 0) || wrote_selfrc) || lead_comma) {
        wr.out(", " false)
      }
      def nameN:CodeNode (unwrap arg.nameNode)
      ; In Rust, object parameters that might have fields modified need 'mut'
      def v_type:RangerNodeType nameN.value_type
      if ((v_type == RangerNodeType.Object) || (v_type == RangerNodeType.VRef) || (v_type == RangerNodeType.NoType)) {
        v_type = (nameN.typeNameAsType(ctx))
      }
      def is_object:boolean ((v_type == RangerNodeType.Object) || (v_type == RangerNodeType.Array) || (v_type == RangerNodeType.Hash) || (v_type == RangerNodeType.IntBuffer) || (v_type == RangerNodeType.DoubleBuffer) || (v_type == RangerNodeType.CharBuffer) || (v_type == RangerNodeType.Buffer))
      ; Use compiledName to include any name transformations (e.g. len -> __len)
      def paramName:string (this.adjustType(arg.compiledName))
      def rust_mut_pfx:string "mut "
      if rust_in_trait_decl {
        rust_mut_pfx = ""
      }
      
      ; Check static analysis flags for mutable reference requirement
      ; rust_borrow_type: 0=owned, 1=borrow, 2=mut_borrow
      ; needs_cpp_reference also indicates mutation (same analysis)
      def needsMutRef:boolean false
      if arg.needs_cpp_reference {
        needsMutRef = true
      }
      if (arg.rust_borrow_type == 2) {
        needsMutRef = true
      }
      
      ; Check if parameter is assigned to a weak field - needs Rc<RefCell<T>> type
      ; This is detected by static analysis when we see: this.weakField = param
      if arg.rust_needs_rc_wrap {
        ; A proven-borrowed Rc parameter takes a reference: the callee reads the
        ; handle and never stores it, so every call site passes `&x` instead of
        ; cloning. `.borrow()` / `.borrow_mut()` work the same through it.
        ; a plain class name is the whole shared type on its own — a class
        ; with subclasses already reads as Rc<RefCell<dyn XTrait>>, so
        ; wrapping writeTypeDef here would give it a second cell
        def argIsPlainClass:boolean (((strlen nameN.array_type) == 0) && ((strlen nameN.key_type) == 0))
        if (argIsPlainClass && ((strlen nameN.type_name) == 0)) {
          argIsPlainClass = false
        }
        if (arg.rust_borrow_type == 1) {
          if argIsPlainClass {
            wr.out(((paramName + " : &") + (this.rustSharedTypeString(nameN.type_name ctx))) false)
          } {
            wr.out((paramName + " : &Rc<RefCell<") false)
            this.writeTypeDef(nameN ctx wr)
            wr.out(">>" false)
          }
          continue
        }
        ; Parameter is assigned to weak field - needs Rc<RefCell<T>> type
        if argIsPlainClass {
          ; an @(optional) parameter is Option<…>: the body asks it
          ; `is_none()` and unwraps it, and a caller may have nothing to pass
          if (nameN.hasFlag("optional")) {
            wr.out((((((rust_mut_pfx + paramName) + " : Option<") + (this.rustSharedTypeString(nameN.type_name ctx))) + ">")) false)
          } {
            wr.out((((rust_mut_pfx + paramName) + " : ") + (this.rustSharedTypeString(nameN.type_name ctx))) false)
          }
        } {
          wr.out((rust_mut_pfx + paramName + " : Rc<RefCell<") false)
          this.writeTypeDef(nameN ctx wr)
          wr.out(">>" false)
        }
        continue
      }
      
      ; Check for immutable borrow (rust_borrow_type = 1)
      ; This is for buffer/array/object params that are not mutated
      def needsImmutableBorrow:boolean (arg.rust_borrow_type == 1)
      
      ; Check if parameter is assigned - if so, make it mut
      if needsMutRef {
        ; Parameter is mutated - needs mut
        wr.out((rust_mut_pfx + paramName + " : &mut ") false)
        this.writeTypeDef(nameN ctx wr)
      } {
        if needsImmutableBorrow {
          ; Parameter is borrowed but not mutated - immutable reference.
          ; A borrowed collection or buffer of scalars is a slice: clippy's
          ; ptr_arg — `&Vec<u8>` involves a new object where `&[u8]` will
          ; do, and `&Vec` coerces to `&[T]` at every call site.
          def slice_elem:string ""
          ; a HASH carries its value type in array_type as well, so the
          ; key_type has to be empty for this to be an array — a
          ; `[string:string]` parameter came out as `&[String]` and every
          ; map call on it was a missing method
          if (((strlen nameN.array_type) > 0) && ((strlen nameN.key_type) == 0)) {
            def ael:string nameN.array_type
            if (((((ael == "int") || (ael == "double")) || (ael == "boolean")) || (ael == "string")) || (ael == "char")) {
              slice_elem = (this.getObjectTypeString(ael ctx))
            }
          } {
            if (nameN.type_name == "buffer") {
              slice_elem = "u8"
            }
            if (nameN.type_name == "int_buffer") {
              slice_elem = "i64"
            }
            if (nameN.type_name == "double_buffer") {
              slice_elem = "f64"
            }
          }
          if ((strlen slice_elem) > 0) {
            wr.out((((paramName + " : &[") + slice_elem) + "]") false)
          } {
            ; a borrowed read-only string is &str: every call site coerces
            ; (&String and &'static str alike), no allocation either way
            if (((nameN.type_name == "string") && ((strlen nameN.array_type) == 0)) && ((strlen nameN.key_type) == 0)) {
              wr.out((paramName + " : &str") false)
            } {
              wr.out((paramName + " : &") false)
              this.writeTypeDef(nameN ctx wr)
            }
          }
        } {
          def argOptional:boolean (nameN.hasFlag("optional"))
          if is_object {
            wr.out((rust_mut_pfx + paramName + " : ") false)
          } {
            if (arg.set_cnt > 0) {
              wr.out((rust_mut_pfx + paramName + " : ") false)
            } {
              wr.out((paramName + " : ") false)
            }
          }
          if argOptional {
            wr.out("Option<" false)
          }
          this.writeTypeDef(nameN ctx wr)
          if argOptional {
            wr.out(">" false)
          }
        }
      }
    }
  }

  ; Override CreateCallExpression to handle optional types in Rust
  ; When calling a method on an optional object, we need to unwrap it first
  ; Helper: Check if a node tree contains any self (this) reference
  ; Any function or method call anywhere in the tree. Used to decide
  ; whether an argument can re-enter the object graph while the
  ; receiver's RefCell borrow is held.
  fn rustNodeContainsCall:boolean (node:CodeNode) {
    if node.hasFnCall {
      return true
    }
    if node.has_call {
      return true
    }
    for node.children ch:CodeNode ci {
      if (this.rustNodeContainsCall(ch)) {
        return true
      }
    }
    return false
  }

  fn containsSelfReference:boolean (node:CodeNode) {
    ; Check if this node references a class variable (member of self)
    if node.hasParamDesc {
      def pp:RangerAppParamDesc node.paramDesc
      if pp.is_class_variable {
        return true
      }
    }
    ; Check for method calls - hasFnCall typically uses &mut self
    if node.hasFnCall {
      ; This is a method call - it likely uses &mut self
      return true
    }
    ; Recurse to children
    for node.children child:CodeNode i {
      if (this.containsSelfReference(child)) {
        return true
      }
    }
    return false
  }

  ; Helper: Check if a function body uses 'this' (self) - for Rust static method optimization
  ; Methods that don't reference 'this' or class variables can be emitted as static methods
  ; This avoids E0499 errors when calling such methods with &mut self.field arguments
  ; Does this second segment of a `this.…` path name a METHOD of the current
  ; class rather than one of its fields?
  fn rustThisSegIsMethod:boolean (segName:string ctx:RangerAppWriterContext) {
    def tsCls@(optional):RangerAppClassDesc (ctx.getCurrentClass())
    if (null? tsCls) {
      return false
    }
    def tsC:RangerAppClassDesc (unwrap tsCls)
    def tsVar@(optional):RangerAppParamDesc (tsC.findVariable(segName))
    if (!null? tsVar) {
      return false
    }
    def tsM@(optional):RangerAppFunctionDesc (tsC.findMethod(segName))
    return (!null? tsM)
  }

  ; Does the body need the STRUCT — a field of this object — as opposed to
  ; reaching the object through its handle? A bare `this` is written as the
  ; hidden __self_rc argument, and `this.method(…)` can be called through the
  ; same handle, borrowing for that call and no longer. A field read or write
  ; is what actually needs a receiver.
  ; The receiver question for one method: does it need a `self` parameter?
  ; A method that reaches itself only THROUGH its handle does not — see
  ; fnBodyUsesThisStruct — but only when it actually carries the handle.
  fn rustMethodNeedsReceiver:boolean (fnD:RangerAppFunctionDesc body:CodeNode useCtx:RangerAppWriterContext ctx:RangerAppWriterContext) {
    ; A method the TRAIT declares always keeps its receiver, whatever its body
    ; does. Without one the call site writes `Parent::m(…)`, which is the
    ; parent's own implementation — the override never runs. That is how
    ; `lineEnding` came back as the generic writer's "" instead of the
    ; JavaScript writer's ";", and the difference reached the emitted code.
    def mnrClsO@(optional):RangerAppClassDesc (useCtx.getCurrentClass())
    if (!null? mnrClsO) {
      def mnrCls:RangerAppClassDesc (unwrap mnrClsO)
      def mnrRootO@(optional):RangerAppClassDesc (this.rustTraitRootOf(mnrCls ctx))
      if (!null? mnrRootO) {
        def mnrRoot:RangerAppClassDesc (unwrap mnrRootO)
        if (has mnrRoot.method_variants fnD.name) {
          return true
        }
        if (has mnrRoot.defined_methods fnD.name) {
          return true
        }
      }
    }
    if ((this.fnBodyUsesThis(body useCtx)) == false) {
      return false
    }
    if (this.rustNeedsSelfRc(fnD ctx)) {
      ; …but only when that handle is the CONCRETE class. In a trait family
      ; the hidden argument is typed `dyn XTrait`, and a method the trait
      ; does not declare cannot be called through it.
      if ((strlen (this.rustSelfRcTraitName(useCtx))) == 0) {
        ; …and then ALWAYS. A method that carries its own handle hands it to
        ; something that will reach back through it, and a `&self` receiver is
        ; a borrow of the cell held for the whole call: the caller's borrow is
        ; still live when the callee takes its own. Reaching every field
        ; through the handle instead borrows for one statement at a time.
        return false
      }
    }
    return true
  }

  ; Does this body call a method on `this` that hands back another handle of
  ; the same class? Such a handle may BE this object.
  fn rustBodyGetsOwnClassHandle:boolean (node:CodeNode useCtx:RangerAppWriterContext ctx:RangerAppWriterContext) {
    def ownCls@(optional):RangerAppClassDesc (useCtx.getCurrentClass())
    if (null? ownCls) {
      return false
    }
    def ownC:RangerAppClassDesc (unwrap ownCls)
    return (this.rustBodyGetsClassHandle(node ownC.name ownC))
  }

  fn rustBodyGetsClassHandle:boolean (node:CodeNode clsName:string cl:RangerAppClassDesc) {
    if ((array_length node.ns) == 2) {
      if ((itemAt node.ns 0) == "this") {
        def gm@(optional):RangerAppFunctionDesc (cl.findMethod((itemAt node.ns 1)))
        if (!null? gm) {
          def gmD:RangerAppFunctionDesc (unwrap gm)
          def gmNN@(optional):CodeNode gmD.nameNode
          if (!null? gmNN) {
            def gmN:CodeNode (unwrap gmNN)
            if (((strlen gmN.array_type) == 0) && ((strlen gmN.key_type) == 0)) {
              if (gmN.type_name == clsName) {
                return true
              }
            }
          }
        }
      }
    }
    for node.children ch:CodeNode i {
      if (this.rustBodyGetsClassHandle(ch clsName cl)) {
        return true
      }
    }
    return false
  }

  fn fnBodyUsesThisStruct:boolean (node:CodeNode ctx:RangerAppWriterContext) {
    if (node.vref == "this") {
      return false
    }
    if (has node.ns) {
      if ((array_length node.ns) > 0) {
        def firstPart:string (itemAt node.ns 0)
        if (firstPart == "this") {
          if ((array_length node.ns) == 2) {
            if ((this.rustThisSegIsMethod((itemAt node.ns 1) ctx)) == false) {
              return true
            }
          } {
            return true
          }
        } {
          if (ctx.isMemberVariable(firstPart)) {
            return true
          }
        }
      }
    }
    if ((strlen node.vref) > 0) {
      if (ctx.isMemberVariable(node.vref)) {
        return true
      }
    }
    ; …and a field desc reached through ANOTHER object is not this object's
    ; struct: `root.definedClasses` carries the desc of a class variable, but
    ; the variable being read belongs to `root`. Only a bare name — an
    ; implicit `this.x` — counts.
    if node.hasParamDesc {
      ; exactly one segment: a bare name, which is the implicit `this.x`. An
      ; empty ns means the writer cannot tell what the desc belongs to, and a
      ; dotted vref there names another object's field.
      if ((array_length node.ns) == 1) {
        def pp:RangerAppParamDesc node.paramDesc
        if pp.is_class_variable {
          return true
        }
      }
    }
    for node.children child:CodeNode i {
      if (this.fnBodyUsesThisStruct(child ctx)) {
        return true
      }
    }
    return false
  }

  fn fnBodyUsesThis:boolean (node:CodeNode ctx:RangerAppWriterContext) {
    ; Check if this is a direct 'this' reference
    if (node.vref == "this") {
      return true
    }
    ; Check ns array for 'this' as first element (e.g., this.field)
    if (has node.ns) {
      if ((array_length node.ns) > 0) {
        def firstPart:string (itemAt node.ns 0)
        if (firstPart == "this") {
          return true
        }
        ; Also check if the first part is a class member variable using context
        if (ctx.isMemberVariable(firstPart)) {
          return true
        }
      }
    }
    ; Check if vref is a class member variable
    if ((strlen node.vref) > 0) {
      if (ctx.isMemberVariable(node.vref)) {
        return true
      }
    }
    ; Check if this node references a class variable (member of self)
    if node.hasParamDesc {
      def pp:RangerAppParamDesc node.paramDesc
      if pp.is_class_variable {
        return true
      }
    }
    ; Recurse to children
    for node.children child:CodeNode i {
      if (this.fnBodyUsesThis(child ctx)) {
        return true
      }
    }
    return false
  }

  ; Helper: Check if a node accesses a field of the given variable
  ; Returns true if node is like varName.field or varName.field.subfield
  fn accessesFieldOf:boolean (node:CodeNode varName:string) {
    if ((array_length node.ns) > 0) {
      def firstPart:string (itemAt node.ns 0)
      if (firstPart == varName) {
        ; This accesses varName.something
        if ((array_length node.ns) > 1) {
          return true
        }
      }
    }
    ; Check children recursively
    for node.children child:CodeNode i {
      if (this.accessesFieldOf(child varName)) {
        return true
      }
    }
    return false
  }

  ; Helper: Get root variable name from an argument node
  ; For a simple var reference like "child", returns "child"
  fn getArgRootVar:string (node:CodeNode) {
    ; If node has ns, use first part
    if ((array_length node.ns) > 0) {
      return (itemAt node.ns 0)
    }
    ; If node is a simple vref
    if ((strlen node.vref) > 0) {
      return node.vref
    }
    return ""
  }

  ; Helper: Detect when we have a &mut ref conflict in function call arguments
  ; Returns true if argIdx gets &mut and other args access fields of that same variable
  fn hasMutRefConflict:boolean (node:CodeNode fnDesc:RangerAppFunctionDesc argIdx:int givenArgs:CodeNode) {
    def paramCnt:int (array_length fnDesc.params)
    if (argIdx >= paramCnt) {
      return false
    }
    def param:RangerAppParamDesc (itemAt fnDesc.params argIdx)
    ; Check if this parameter needs &mut
    def needsMut:boolean false
    if param.needs_cpp_reference {
      needsMut = true
    }
    if (param.rust_borrow_type == 2) {
      needsMut = true
    }
    if (needsMut == false) {
      return false
    }
    ; Get the variable name being passed
    def argNode@(optional):CodeNode (itemAt givenArgs.children argIdx)
    if (null? argNode) {
      return false
    }
    def varName:string (this.getArgRootVar((unwrap argNode)))
    if ((strlen varName) == 0) {
      return false
    }
    ; Check if other args access fields of this variable
    for givenArgs.children otherArg:CodeNode otherIdx {
      if (otherIdx != argIdx) {
        if (this.accessesFieldOf(otherArg varName)) {
          return true
        }
      }
    }
    return false
  }

  ; ====== CALL GRAPH ANALYSIS FOR MUTATION DETECTION ======
  ; These functions analyze method bodies to determine if they mutate 'this' (self)
  ; We build a call graph to handle transitive mutations properly
  
  ; Helper: Collect all self-method calls from a node (returns method names)
  fn collectSelfMethodCalls:void (node:CodeNode ctx:RangerAppWriterContext calls:[string]) {
    ; Check for method calls via vref pattern (e.g., "this.method")
    if ((strlen node.vref) > 5) {
      def prefix:string (substring node.vref 0 5)
      if (prefix == "this.") {
        ; Extract method name after "this."
        def methodName:string (substring node.vref 5 (strlen node.vref))
        push calls methodName
      }
    }
    
    ; Check for call expressions
    if node.has_call {
      if ((array_length node.children) >= 3) {
        def callObj:CodeNode (node.getSecond())
        def methodNode:CodeNode (node.getThird())
        if (callObj.vref == "this") {
          push calls methodNode.vref
        }
      }
    }
    
    ; Recurse to children
    for node.children child:CodeNode i {
      this.collectSelfMethodCalls(child ctx calls)
    }
  }
  
  ; `reader.seek(x)` — a method called on a field of THIS object, where the
  ; field holds another object inline. The callee borrows the field, the
  ; field is reached through `self`, and so a callee that takes `&mut self`
  ; makes the method around it `&mut self` too.
  ;
  ; The `has_call` rule further down asks the same question, but only of the
  ; `(call obj method args)` node the front end builds for a call on an
  ; EXPRESSION. An ordinary `reader.seek(x)` is a `hasFnCall` node whose
  ; receiver lives inside the dotted name `reader.seek`, and nothing looked
  ; there — which is what 277 of the 396 rustc errors on the PPTX viewer
  ; were, one bug in 267 different functions.
  fn rustFieldCallMutatesThis:boolean (node:CodeNode ctx:RangerAppWriterContext) {
    if (rust_field_call_mut_ready == false) {
      return false
    }
    if (node.hasFnCall == false) {
      return false
    }
    if ((array_length node.children) < 1) {
      return false
    }
    return (this.rustFieldPathCallMutates((node.getFirst()) ctx))
  }

  ; The same question of a call receiver PATH alone: `reader.seek` or
  ; `this.reader.seek`. The emission asks it too — a path head that is
  ; `this` has to take the mutable borrow when the field it reaches is held
  ; inline and the callee writes to it.
  fn rustFieldPathCallMutates:boolean (fcc:CodeNode ctx:RangerAppWriterContext) {
    def fccLen:int (array_length fcc.ns)
    if (fccLen < 2) {
      return false
    }
    def fccIdx:int 0
    if ((itemAt fcc.ns 0) == "this") {
      fccIdx = 1
    }
    ; the last segment names the method, so a field has to come before it —
    ; `this.method()` is a call on this object, and the call graph has it
    if (fccIdx > (fccLen - 2)) {
      return false
    }
    def fccFld:string (itemAt fcc.ns fccIdx)
    if (fccIdx == 0) {
      if ((ctx.isMemberVariable(fccFld)) == false) {
        return false
      }
    }
    def fccClsO@(optional):RangerAppClassDesc (ctx.getCurrentClass())
    if (null? fccClsO) {
      return false
    }
    def fccCls:RangerAppClassDesc (unwrap fccClsO)
    def fccVarO@(optional):RangerAppParamDesc (fccCls.findVariable(fccFld))
    if (null? fccVarO) {
      return false
    }
    def fccVar:RangerAppParamDesc (unwrap fccVarO)
    ; a cell field is written through its own cell, and an Rc field through
    ; its own RefCell — neither of them borrows this struct mutably
    if fccVar.rust_interior_cell {
      return false
    }
    def fccNNO@(optional):CodeNode fccVar.nameNode
    if (null? fccNNO) {
      return false
    }
    def fccNN:CodeNode (unwrap fccNNO)
    def fccIsColl:boolean (((strlen fccNN.array_type) > 0) || ((strlen fccNN.key_type) > 0))
    if (fccIsColl == false) {
      if fccVar.rust_needs_rc_wrap {
        return false
      }
    }
    ; …and what the callee does with its own object. The receiver's class
    ; answers; for a trait family it answers once for the whole family.
    def fccPathO@(optional):RangerAppClassDesc (this.rustReceiverPathClass(fcc ctx))
    if (null? fccPathO) {
      if (fccIsColl == false) {
        if (ctx.isDefinedClass(fccNN.type_name)) {
          fccPathO = (ctx.findClass(fccNN.type_name))
        }
      }
    }
    if (null? fccPathO) {
      return false
    }
    def fccPath:RangerAppClassDesc (unwrap fccPathO)
    def fccMethod:string (itemAt fcc.ns (fccLen - 1))
    if ((fccPath.hasMethod(fccMethod)) == false) {
      return false
    }
    return ((this.rustClassMethodKnownShared(fccPath fccMethod ctx)) == false)
  }

  ; Is this node a value reached through `self` — `this`, a field of this
  ; object, or a path that starts at one? A reference taken to any of them
  ; is a reference into this struct.
  fn rustNodeIsOwnPath:boolean (nIn:CodeNode ctx:RangerAppWriterContext) {
    def n:CodeNode (this.rustUnwrapParens(nIn))
    def opName:string ""
    def opLen:int (array_length n.ns)
    if (opLen > 0) {
      if ((itemAt n.ns 0) == "this") {
        if (opLen == 1) {
          return true
        }
        opName = (itemAt n.ns 1)
      } {
        opName = (itemAt n.ns 0)
        if ((ctx.isMemberVariable(opName)) == false) {
          return false
        }
      }
    } {
      if (n.vref == "this") {
        return true
      }
      if ((strlen n.vref) == 0) {
        return false
      }
      opName = n.vref
      if ((ctx.isMemberVariable(opName)) == false) {
        return false
      }
    }
    def opClsO@(optional):RangerAppClassDesc (ctx.getCurrentClass())
    if (null? opClsO) {
      return false
    }
    def opCls:RangerAppClassDesc (unwrap opClsO)
    def opVarO@(optional):RangerAppParamDesc (opCls.findVariable(opName))
    if (null? opVarO) {
      return false
    }
    def opVar:RangerAppParamDesc (unwrap opVarO)
    ; a cell field hands out its own `&mut` through borrow_mut()
    if opVar.rust_interior_cell {
      return false
    }
    return true
  }

  ; `Helper.touch(own)` where the callee takes that parameter by `&mut`.
  ; The argument is written `&mut self.own`, which borrows this struct
  ; mutably — so does `this` itself passed the same way, which comes out
  ; `&mut self`. Either makes the method around the call `&mut self`.
  fn rustArgBorrowsThisMutably:boolean (node:CodeNode ctx:RangerAppWriterContext) {
    if (rust_field_call_mut_ready == false) {
      return false
    }
    if (null? node.fnDesc) {
      return false
    }
    if ((array_length node.children) < 2) {
      return false
    }
    def abFd:RangerAppFunctionDesc (unwrap node.fnDesc)
    def abArgs:CodeNode (itemAt node.children 1)
    def abCnt:int (array_length abFd.params)
    for abArgs.children abArg:CodeNode abI {
      if (abI < abCnt) {
        def abP:RangerAppParamDesc (itemAt abFd.params abI)
        def abMut:boolean false
        if abP.needs_cpp_reference {
          abMut = true
        }
        if (abP.rust_borrow_type == 2) {
          abMut = true
        }
        if abMut {
          if (this.rustNodeIsOwnPath(abArg ctx)) {
            return true
          }
        }
      }
    }
    return false
  }

  ; Helper: Check if method body DIRECTLY mutates this (field assignments, optional field access)
  ; Does NOT consider transitive mutations via method calls
  fn fnBodyDirectlyMutatesThis:boolean (node:CodeNode ctx:RangerAppWriterContext) {
    ; Debug: show every node being checked
    
    ; Check ns array for optional field access (requires as_mut())
    if (has node.ns) {
      if ((array_length node.ns) > 0) {
        def firstPart:string (itemAt node.ns 0)
        if (firstPart == "this") {
          ; If there are more parts in ns (like this.field.isSet), check if any field is optional
          if ((array_length node.ns) > 1) {
            def secondPart:string (itemAt node.ns 1)
            ; NOTE: reading an optional field used to count as a mutation
            ; here, on the grounds that the path writer might reach for
            ; as_mut(). It is only a READ, and calling it a mutation made
            ; every such getter `&mut self` — which the call site then took
            ; with borrow_mut(), so any method reaching its own object
            ; through an Rc panicked at run time. A real write is caught by
            ; the assignment and mutating-call rules below.
            if false {
              return true
            }
          }
        }
        ; Also check if first part is a class member that's optional — only a
        ; member: an operator name like `itemAt` also resolves here, and its
        ; weak-typed desc read as "optional access" made every collection
        ; read count as a mutation
        if (ctx.isVarDefined(firstPart)) {
          def vDef:RangerAppParamDesc (ctx.getVariableDef(firstPart))
          if (vDef.is_optional && vDef.is_class_variable) {
            ; an uninitialized member collection carries is_optional on the
            ; desc, but the Rust field is a plain Vec/HashMap, never Option
            def vDefIsColl:boolean false
            def vdNN@(optional):CodeNode vDef.nameNode
            if (!null? vdNN) {
              def vdN:CodeNode (unwrap vdNN)
              if (((strlen vdN.array_type) > 0) || ((strlen vdN.key_type) > 0)) {
                vDefIsColl = true
              }
            }
            if (vDefIsColl == false) {
              ; …same here: a bare read of an optional member is a read
              if false {
                return true
              }
            }
          }
        }
      }
    }
    
    ; Check for assignment to class variables
    if ((array_length node.children) >= 3) {
      def fc:CodeNode (node.getFirst())
      def cmd:string fc.vref
      if (cmd == "=") {
        def left:CodeNode (node.getSecond())
        ; Check if left side is a class variable — a BARE one. `new_ctx.parent
        ; = this` carries the desc of a class variable, but the field being
        ; written belongs to new_ctx; counting it made every factory method
        ; `&mut self`, and a call site then borrowed the cell mutably where
        ; the signature only needed a shared borrow.
        if left.hasParamDesc {
          if ((array_length left.ns) <= 1) {
            def pp:RangerAppParamDesc left.paramDesc
            if pp.is_class_variable {
              ; …but a CELL field is written through its own cell, which is
              ; the whole point of putting it there: the method stays &self
              if (pp.rust_interior_cell == false) {
                return true
              }
            }
          }
        }
        ; Check ns array for 'this' as first element (e.g., this.field = ...)
        if (has left.ns) {
          if ((array_length left.ns) > 0) {
            def firstPart:string (itemAt left.ns 0)
            if ((this.rustNodeIsCellField(left)) == false) {
              if (firstPart == "this") {
                return true
              }
              if (ctx.isMemberVariable(firstPart)) {
                return true
              }
            }
          }
        }
        ; Check if left vref is a class member variable
        if ((strlen left.vref) > 0) {
          if (ctx.isMemberVariable(left.vref)) {
            if ((this.rustNodeIsCellField(left)) == false) {
              return true
            }
          }
        }
      }
    }
    
    ; a mutating method on a field held inline: `reader.seek(x)`
    if (this.rustFieldCallMutatesThis(node ctx)) {
      return true
    }

    ; …or a reference into this struct handed to someone else
    if (this.rustArgBorrowsThisMutably(node ctx)) {
      return true
    }

    ; Check for method calls on member variables (e.g., this.fontManager.loadFont())
    ; This mutates the member variable (requires &mut self) — except a read
    ; operator on a member collection, string or buffer: `itemAt items 0` is
    ; a has_call on `items`, and counting it as a write made every getter
    ; take &mut self
    if node.has_call {
      if ((array_length node.children) >= 3) {
        def callObj:CodeNode (node.getSecond())
        def methodNode:CodeNode (node.getThird())
        def member_call_target:boolean false
        ; Check if callObj is a member variable or starts with 'this.'
        if (has callObj.ns) {
          if ((array_length callObj.ns) > 0) {
            def firstPart:string (itemAt callObj.ns 0)
            if (firstPart == "this") {
              member_call_target = true
            }
            if (ctx.isMemberVariable(firstPart)) {
              member_call_target = true
            }
          }
        }
        ; Also check vref for patterns like "this.member"
        if ((strlen callObj.vref) > 5) {
          def prefix:string (substring callObj.vref 0 5)
          if (prefix == "this.") {
            member_call_target = true
          }
        }
        ; Check if callObj is a member variable directly (e.g., fontManager.loadFont())
        if ((strlen callObj.vref) > 0) {
          if (ctx.isMemberVariable(callObj.vref)) {
            member_call_target = true
          }
        }
        if member_call_target {
          if (this.rustCallTargetIsCollection(callObj)) {
            ; only the mutating collection operators write through self, and
            ; not even those when the collection is behind a cell
            if (this.rustIsMutatingOpName(methodNode.vref)) {
              if ((this.rustNodeIsCellField(callObj)) == false) {
                return true
              }
            }
          } {
            ; a user-class member: any method could mutate it — unless the
            ; field holds an Rc. Then the callee borrows the FIELD's own cell
            ; and never touches this struct, so counting it made every writer
            ; that calls `this.compiler.WalkNode(…)` take `&mut self`, and a
            ; trait signature carries that to every sibling.
            if ((this.rustCallThroughSharedField(callObj ctx)) == false) {
              if ((this.rustNodeIsCellField(callObj)) == false) {
                return true
              }
            }
          }
        }
      }
    }
    
    ; a mutating collection or buffer operation on a member target writes
    ; through self — `push tokens t` never shows up as an `=` node
    if ((array_length node.children) >= 2) {
      def opFc:CodeNode (node.getFirst())
      if (this.rustIsMutatingOpName(opFc.vref)) {
        def opTarget:CodeNode (node.getSecond())
        ; …a member of THIS object. A field's descriptor says "class variable"
        ; whoever owns it, so `set ctx.someMap k v` carried the desc of a
        ; RangerAppWriterContext field and made the method that wrote it
        ; `&mut self` — the same mistake the assignment rule above already
        ; guards against. Only a bare name, or a path rooted at `this`.
        def opIsOwn:boolean false
        def opRoot:string opTarget.vref
        if (has opTarget.ns) {
          if ((array_length opTarget.ns) > 0) {
            opRoot = (itemAt opTarget.ns 0)
          }
        }
        if (opRoot == "this") {
          opIsOwn = true
        }
        if ((array_length opTarget.ns) <= 1) {
          if opTarget.hasParamDesc {
            def opTP:RangerAppParamDesc opTarget.paramDesc
            if opTP.is_class_variable {
              opIsOwn = true
            }
          }
          if (ctx.isMemberVariable(opRoot)) {
            opIsOwn = true
          }
        }
        ; …but a CELL field is mutated through its own cell, so the method
        ; that does it still takes `&self`
        if opIsOwn {
          if ((this.rustNodeIsCellField(opTarget)) == false) {
            return true
          }
        }
      }
    }

    ; Recurse to children
    for node.children child:CodeNode i {
      if (this.fnBodyDirectlyMutatesThis(child ctx)) {
        return true
      }
    }
    return false
  }

  ; is this call receiver a plain collection, string or buffer — a value
  ; whose operators only write through self when the operator itself is a
  ; mutating one? A user-class receiver never qualifies: any of its methods
  ; could mutate it, and a user method may shadow an operator name.
  fn rustCallTargetIsCollection:boolean (callObj:CodeNode) {
    if (callObj.hasParamDesc == false) {
      return false
    }
    def cp:RangerAppParamDesc callObj.paramDesc
    def cpNN@(optional):CodeNode cp.nameNode
    if (null? cpNN) {
      return false
    }
    def cpN:CodeNode (unwrap cpNN)
    if ((strlen cpN.array_type) > 0) {
      return true
    }
    if ((strlen cpN.key_type) > 0) {
      return true
    }
    def tn:string cpN.type_name
    if (tn == "string") { return true }
    if (tn == "buffer") { return true }
    if (tn == "charbuffer") { return true }
    if (tn == "intbuffer") { return true }
    if (tn == "doublebuffer") { return true }
    return false
  }

  ; the operator names whose first operand is written through — the same
  ; list the template engine flags as LHS targets
  fn rustIsMutatingOpName:boolean (n:string) {
    if (n == "buffer_set") { return true }
    if (n == "int_buffer_set") { return true }
    if (n == "double_buffer_set") { return true }
    if (n == "buffer_fill") { return true }
    if (n == "int_buffer_fill") { return true }
    if (n == "double_buffer_fill") { return true }
    if (n == "buffer_copy") { return true }
    if (n == "int_buffer_copy") { return true }
    if (n == "double_buffer_copy") { return true }
    if (n == "push") { return true }
    if (n == "str_append") { return true }
    if (n == "map_clear") { return true }
    if (n == "nullify") { return true }
    if (n == "set") { return true }
    if (n == "put") { return true }
    if (n == "insert") { return true }
    if (n == "clear") { return true }
    if (n == "remove") { return true }
    if (n == "removeIndex") { return true }
    if (n == "removeLast") { return true }
    ; the names Lang.rgr actually gives the in-place array operators —
    ; `remove_index opNs idx` on a member left its method &self
    if (n == "remove_index") { return true }
    if (n == "array_extract") { return true }
    if (n == "set_at") { return true }
    if (n == "pushString") { return true }
    if (n == "removeFirst") { return true }
    if (n == "nullify") { return true }
    return false
  }

  ; Build call graph and mutation info for a class
  ; Returns two maps: methodName -> directlyMutates (boolean), methodName -> MethodCallList
  ; The same walk over the ancestors, for the methods a class inherits. They
  ; are emitted into this class's impl and can be called from its own
  ; methods, so leaving them out of the graph made a caller of an inherited
  ; mutating method look immutable — `&self` calling a `&mut self` method.
  ; A name the class defines itself is already in the maps and wins.
  fn buildInheritedMutationGraph:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext directMutations:[string:boolean] callGraph:[string:MethodCallList]) {
    for cl.extends_classes pName:string pi {
      if (ctx.isDefinedClass(pName)) {
        def pc:RangerAppClassDesc (ctx.findClass(pName))
        for pc.defined_variants fnVar:string i {
          def mVs:RangerAppMethodVariants (get pc.method_variants fnVar)
          for mVs.variants variant:RangerAppFunctionDesc vi {
            ; NOTE: a name already in the map still gets its edges collected
            ; below; only its direct-mutation verdict is left alone.
            def hadDirect:boolean (has directMutations variant.name)
            ; A trait-interface method used to be marked mutating here on
            ; principle. markTraitIfaceMutations now ORs the FAMILY's real
            ; answer into the same map right after this walk, so the blanket
            ; only made every caller of an inherited method `&mut self` for
            ; no reason.
            def inTraitIface:boolean false
            def fnB@(optional):CodeNode variant.fnBody
            if (!null? fnB) {
              def fnCtx@(optional):RangerAppWriterContext variant.fnCtx
              def useCtx:RangerAppWriterContext ctx
              if (!null? fnCtx) {
                useCtx = (unwrap fnCtx)
              }
              def fnBody:CodeNode (unwrap fnB)
              if (hadDirect == false) {
                if inTraitIface {
                  set directMutations variant.name true
                } {
                  set directMutations variant.name (this.fnBodyDirectlyMutatesThis(fnBody useCtx))
                }
              }
              ; UNION, not replace: the family graph is built by walking
              ; every member into the same maps, and the last one written
              ; would otherwise be the only one with edges — `writeClass`
              ; calls `writeTypeDef` in one writer and not in the next
              def callList:MethodCallList (new MethodCallList())
              if (has callGraph variant.name) {
                callList = (unwrap (get callGraph variant.name))
              }
              this.collectSelfMethodCalls(fnBody useCtx callList.calls)
              set callGraph variant.name callList
            } {
              if (hadDirect == false) {
                if inTraitIface {
                  set directMutations variant.name true
                }
              }
            }
          }
        }
        this.buildInheritedMutationGraph(pc ctx directMutations callGraph)
      }
    }
  }

  ; A method of the trait interface is emitted `&mut self` whatever its body
  ; does — the same rule the signature writer applies — so anything that
  ; calls one needs a mutable receiver too. buildInheritedMutationGraph
  ; already says this for methods only the parent declares; a class that
  ; OVERRIDES a trait method had its own (possibly non-mutating) answer
  ; recorded first, and the override is emitted `&mut self` all the same.
  ; A trait method and the inherent method each impl forwards to share one
  ; signature, and the forwarding body is written from the PARENT's variant.
  ; Either side wanting the hidden __self_rc argument therefore commits both
  ; to it, or the forwarding call is an argument off in one direction or the
  ; other. These are the descriptors the writer emits from — cl.methods holds
  ; different ones, which is why aligning through those changed nothing.
  fn alignTraitSelfRcNeeds:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    for cl.extends_classes parentName:string pi {
      if (ctx.isDefinedClass(parentName)) {
        def pc:RangerAppClassDesc (ctx.findClass(parentName))
        if pc.is_extended_by_children {
          for pc.defined_variants pvName:string pvi {
            if (has cl.method_variants pvName) {
              def pMVs:RangerAppMethodVariants (get pc.method_variants pvName)
              def cMVs:RangerAppMethodVariants (get cl.method_variants pvName)
              for pMVs.variants pV:RangerAppFunctionDesc pvj {
                for cMVs.variants cV:RangerAppFunctionDesc cvj {
                  if (pV.rust_needs_self_rc || cV.rust_needs_self_rc) {
                    pV.rust_needs_self_rc = true
                    cV.rust_needs_self_rc = true
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  ; The root of the trait family a class belongs to: itself when it has
  ; children, otherwise the parent that does.
  fn rustTraitRootOf@(optional):RangerAppClassDesc (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    def res@(optional):RangerAppClassDesc
    if cl.is_extended_by_children {
      res = cl
      return res
    }
    for cl.extends_classes trParent:string trPi {
      def trPCO@(optional):RangerAppClassDesc (ctx.findClass(trParent))
      if (!null? trPCO) {
        def trPC:RangerAppClassDesc (unwrap trPCO)
        if trPC.is_extended_by_children {
          res = trPC
        }
      }
    }
    return res
  }

  ; Does this call receiver reach through a field that holds an Rc? Such a
  ; call borrows the field's cell, not this object's struct.
  fn rustCallThroughSharedField:boolean (callObj:CodeNode ctx:RangerAppWriterContext) {
    def sfName:string ""
    if (has callObj.ns) {
      def sfNsLen:int (array_length callObj.ns)
      if (sfNsLen > 0) {
        def sfFirst:string (itemAt callObj.ns 0)
        if (sfFirst == "this") {
          if (sfNsLen > 1) {
            sfName = (itemAt callObj.ns 1)
          }
        } {
          sfName = sfFirst
        }
      }
    }
    if ((strlen sfName) == 0) {
      if ((strlen callObj.vref) > 0) {
        sfName = callObj.vref
      }
    }
    if ((strlen sfName) == 0) {
      return false
    }
    def sfClsO@(optional):RangerAppClassDesc (ctx.getCurrentClass())
    if (null? sfClsO) {
      return false
    }
    def sfCls:RangerAppClassDesc (unwrap sfClsO)
    def sfVarO@(optional):RangerAppParamDesc (sfCls.findVariable(sfName))
    if (null? sfVarO) {
      return false
    }
    def sfVar:RangerAppParamDesc (unwrap sfVarO)
    if (sfVar.rust_needs_rc_wrap == false) {
      return false
    }
    def sfNNO@(optional):CodeNode sfVar.nameNode
    if (null? sfNNO) {
      return false
    }
    def sfNN:CodeNode (unwrap sfNNO)
    ; a collection of shared elements is still a field of this struct
    if ((strlen sfNN.array_type) > 0) {
      return false
    }
    if ((strlen sfNN.key_type) > 0) {
      return false
    }
    return true
  }

  fn rustCollectPathNames:void (node:CodeNode ctx:RangerAppWriterContext) {
    if ((array_length node.ns) > 1) {
      for node.ns pathSeg:string pathSegI {
        if (pathSegI > 0) {
          set ctx.rust_path_field_names pathSeg true
        }
      }
    }
    ; a call RECEIVER is reached through a path too. `fontManager.hasFont(…)`
    ; reads the field before the callee borrows it, and an optional field
    ; kept in a cell cannot answer that read: the `.borrow()` would have to
    ; wrap the whole expression, and the Option handling is already in front
    ; of it. Without this the field came out `RefCell<Option<Rc<…>>>` and
    ; every read said `.as_ref().unwrap()` straight on the cell.
    if node.hasFnCall {
      if ((array_length node.children) > 0) {
        def pathFc:CodeNode (node.getFirst())
        def pathFcLen:int (array_length pathFc.ns)
        if (pathFcLen > 1) {
          def pathRoot:string (itemAt pathFc.ns 0)
          if (pathRoot == "this") {
            if (pathFcLen > 2) {
              set ctx.rust_path_field_names (itemAt pathFc.ns 1) true
            }
          } {
            set ctx.rust_path_field_names pathRoot true
          }
        }
      }
    }
    for node.children pathCh:CodeNode pathChI {
      this.rustCollectPathNames(pathCh ctx)
    }
  }

  fn rustFillPathFieldNames:void (ctx:RangerAppWriterContext) {
    def pathRoot:RangerAppWriterContext (ctx.getRoot())
    if pathRoot.rust_path_names_ready {
      return
    }
    pathRoot.rust_path_names_ready = true
    for pathRoot.definedClassList pathCn:string pathCi {
      def pathC:RangerAppClassDesc (unwrap (get pathRoot.definedClasses pathCn))
      def pathCtorO@(optional):RangerAppFunctionDesc pathC.constructor_fn
      if (!null? pathCtorO) {
        def pathCtor:RangerAppFunctionDesc (unwrap pathCtorO)
        def pathCtorB@(optional):CodeNode pathCtor.fnBody
        if (!null? pathCtorB) {
          this.rustCollectPathNames((unwrap pathCtorB) pathRoot)
        }
      }
      for pathC.defined_variants pathVn:string pathVi {
        def pathVs:RangerAppMethodVariants (get pathC.method_variants pathVn)
        for pathVs.variants pathV:RangerAppFunctionDesc pathVj {
          def pathB@(optional):CodeNode pathV.fnBody
          if (!null? pathB) {
            this.rustCollectPathNames((unwrap pathB) pathRoot)
          }
        }
      }
    }
  }

  ; Can this field live behind a Cell? A scalar only: a collection is mutated
  ; in place through the field, a shared class already has a cell of its own,
  ; and an Option needs the field itself to be reseated.
  fn rustFieldCanBeCell:boolean (p:RangerAppParamDesc ctx:RangerAppWriterContext) {
    if p.rust_static_str {
      return false
    }
    def cellNNO@(optional):CodeNode p.nameNode
    if (null? cellNNO) {
      return false
    }
    def cellNN:CodeNode (unwrap cellNNO)
    ; a COLLECTION field: the Vec or HashMap itself goes in the cell, read
    ; with borrow() and mutated with borrow_mut(). Both are one statement
    ; long, which is what lets the method keep `&self`.
    ; an uninitialised member collection carries is_optional on the desc, but
    ; the Rust field is a plain Vec or HashMap either way
    if ((strlen cellNN.array_type) > 0) {
      return true
    }
    if ((strlen cellNN.key_type) > 0) {
      return true
    }
    ; an OPTIONAL object field is a slot that gets reseated: `Option<T>` inside
    ; a RefCell, read whole and written with replace(). Only where the field is
    ; never reached THROUGH a path — there the read would have to wrap the
    ; whole expression, and the path writer has already put the Option
    ; handling in front of it.
    if p.is_optional {
      if (ctx.isDefinedClass(cellNN.type_name)) {
        this.rustFillPathFieldNames(ctx)
        def pathNameCtx:RangerAppWriterContext (ctx.getRoot())
        if (has pathNameCtx.rust_path_field_names p.name) {
          return false
        }
        return true
      }
      return false
    }
    if p.rust_needs_rc_wrap {
      return false
    }
    ; a field declared without an annotation — `def target_esm false` — has no
    ; type_name at all, so the parsed type answers instead
    def cellT:string cellNN.type_name
    if ((strlen cellT) == 0) {
      def cellVt:RangerNodeType cellNN.value_type
      if (cellNN.eval_type != RangerNodeType.NoType) {
        cellVt = cellNN.eval_type
      }
      if (cellVt == RangerNodeType.Boolean) {
        cellT = "boolean"
      }
      if (cellVt == RangerNodeType.Integer) {
        cellT = "int"
      }
      if (cellVt == RangerNodeType.Double) {
        cellT = "double"
      }
      if (cellVt == RangerNodeType.String) {
        cellT = "string"
      }
    }
    if (cellT == "boolean") {
      return true
    }
    if (cellT == "int") {
      return true
    }
    if (cellT == "double") {
      return true
    }
    ; A string uses a RefCell, and its read is wrapped in a block so the Ref
    ; is dropped before the statement it sits in continues — a bare
    ; `.borrow().clone()` handed to a `&mut self` method is E0502, the very
    ; conflict the cell exists to remove.
    if (cellT == "string") {
      return true
    }
    return false
  }

  ; A Copy scalar goes in a Cell, which never borrows at all. A String has to
  ; use a RefCell, and the borrow lasts one statement.
  ; a String cell owns its value on the way in; every other RefCell takes the
  ; value as it stands
  fn rustCellIsString:boolean (p:RangerAppParamDesc) {
    if p.is_optional {
      return false
    }
    if (this.rustCellIsCollection(p)) {
      return false
    }
    def csNNO@(optional):CodeNode p.nameNode
    if (null? csNNO) {
      return false
    }
    def csNN:CodeNode (unwrap csNNO)
    if ((strlen csNN.type_name) == 0) {
      return (csNN.eval_type == RangerNodeType.String)
    }
    return (csNN.type_name == "string")
  }

  ; a collection cell is borrowed rather than copied out
  fn rustCellIsCollection:boolean (p:RangerAppParamDesc) {
    def clNNO@(optional):CodeNode p.nameNode
    if (null? clNNO) {
      return false
    }
    def clNN:CodeNode (unwrap clNNO)
    if ((strlen clNN.array_type) > 0) {
      return true
    }
    return ((strlen clNN.key_type) > 0)
  }

  fn rustCellIsCopy:boolean (p:RangerAppParamDesc) {
    if p.is_optional {
      return false
    }
    if (this.rustCellIsCollection(p)) {
      return false
    }
    def ciNNO@(optional):CodeNode p.nameNode
    if (null? ciNNO) {
      return true
    }
    def ciNN:CodeNode (unwrap ciNNO)
    if ((strlen ciNN.type_name) == 0) {
      return (ciNN.eval_type != RangerNodeType.String)
    }
    return (ciNN.type_name != "string")
  }

  ; Does this node name a cell field — as a bare name, as `this.f`, or at the
  ; end of a path through another object?
  fn rustCellFieldDesc@(optional):RangerAppParamDesc (node:CodeNode) {
    def cfRes@(optional):RangerAppParamDesc
    def cfNsp:int (array_length node.nsp)
    if (cfNsp > 0) {
      def cfLast:RangerAppParamDesc (itemAt node.nsp (cfNsp - 1))
      if cfLast.rust_interior_cell {
        cfRes = cfLast
      }
      return cfRes
    }
    if (node.hasParamDesc == false) {
      return cfRes
    }
    if ((array_length node.ns) > 2) {
      return cfRes
    }
    if ((array_length node.ns) == 2) {
      if ((itemAt node.ns 0) != "this") {
        return cfRes
      }
    }
    def cfP:RangerAppParamDesc (unwrap node.paramDesc)
    if (cfP.is_class_variable == false) {
      return cfRes
    }
    if cfP.rust_interior_cell {
      cfRes = cfP
    }
    return cfRes
  }

  fn rustNodeIsCellField:boolean (node:CodeNode) {
    def cfD@(optional):RangerAppParamDesc (this.rustCellFieldDesc(node))
    return (!null? cfD)
  }

  ; Every scalar field of a class in a trait family that the trait does not
  ; expose through an accessor. The root's own fields are left alone: their
  ; accessors hand out references, which a cell cannot serve.
  fn rustMarkInteriorCells:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    def cellRootO@(optional):RangerAppClassDesc (this.rustTraitRootOf(cl ctx))
    if (null? cellRootO) {
      return
    }
    def cellRoot:RangerAppClassDesc (unwrap cellRootO)
    for cl.variables cellP:RangerAppParamDesc cellPi {
      def inRoot@(optional):RangerAppParamDesc (cellRoot.findVariable(cellP.name))
      if (!null? inRoot) {
        continue
      }
      if (this.rustFieldCanBeCell(cellP ctx)) {
        cellP.rust_interior_cell = true
      }
    }
  }

  ; One answer per trait method for the whole family, computed once and cached
  ; on the root. A trait method is `&mut self` if ANY implementation of it
  ; mutates its own object — the declaration and every impl share one
  ; signature, so the answer has to be the union. It used to be a blanket
  ; `true`: every method of every writer took `&mut self`, which means every
  ; call through a writer handle takes the cell for the whole call, and the
  ; compiler's writers call back into each other constantly.
  fn rustFillTraitMutations:void (root:RangerAppClassDesc ctx:RangerAppWriterContext) {
    if root.rust_trait_mut_ready {
      return
    }
    root.rust_trait_mut_ready = true
    def family:[RangerAppClassDesc]
    push family root
    for root.child_classes chName:string chI {
      if (ctx.isDefinedClass(chName)) {
        def chC:RangerAppClassDesc (ctx.findClass(chName))
        push family chC
      }
    }
    ; the cells go in FIRST: a write to one is not a mutation of the struct,
    ; and that is exactly what the analysis below is about to measure
    for family cellFam:RangerAppClassDesc cellFamI {
      this.rustMarkInteriorCells(cellFam ctx)
    }
    ; ONE graph for the whole family. Analysing each member on its own gets
    ; the transitive step wrong: `WriteEnum` calls `WriteVRef`, `WriteVRef`
    ; mutates in a SUBCLASS, and the root's own graph cannot see that — so the
    ; root's `WriteEnum` came out `&self` calling a `&mut self`.
    def famDirect:[string:boolean]
    def famGraph:[string:MethodCallList]
    rust_computing_family_mut = true
    for family fam:RangerAppClassDesc famI {
      def memberDirect:[string:boolean]
      this.buildClassMutationGraph(fam ctx memberDirect famGraph)
      this.buildInheritedMutationGraph(fam ctx memberDirect famGraph)
      ; the union of the members' answers: one implementation that mutates
      ; makes the method mutating for every impl of the same signature
      for fam.defined_variants memVar:string memVi {
        if (has memberDirect memVar) {
          def memMut:boolean (unwrap (get memberDirect memVar))
          if memMut {
            set famDirect memVar true
          }
        }
      }
      ; …and the names this member only INHERITS, which is where
      ; buildInheritedMutationGraph put the parent's own answer
      for root.defined_variants inhVar:string inhVi {
        if (has memberDirect inhVar) {
          def inhMut:boolean (unwrap (get memberDirect inhVar))
          if inhMut {
            set famDirect inhVar true
          }
        }
      }
    }
    rust_computing_family_mut = false
    for root.defined_variants famVar:string famVi {
      if (this.methodMutatesThis(famVar famDirect famGraph)) {
        set root.rust_trait_mut famVar true
      }
    }
    ; …and the answer goes onto every descriptor of every family member, both
    ; sets of them. The trait DECLARATION and the call site read different
    ; descriptor sets, and an inherited copy with no body of its own is never
    ; assigned at all — it keeps the conservative default. Left alone they
    ; disagree, and a `&mut self` declaration under a `.borrow()` call site is
    ; a compile error (the other way round is a panic).
    for family fam2:RangerAppClassDesc fam2I {
      ; the name set the trait DECLARATION iterates, so the descriptors the
      ; declaration reads are the ones that get the answer
      for root.defined_variants tmVar:string tmVi {
        if (has fam2.method_variants tmVar) {
          def tmMut:boolean (has root.rust_trait_mut tmVar)
          def tmVs:RangerAppMethodVariants (get fam2.method_variants tmVar)
          for tmVs.variants tmV:RangerAppFunctionDesc tmVj {
            tmV.rust_mut_self = tmMut
          }
          def tmM@(optional):RangerAppFunctionDesc (fam2.findMethod(tmVar))
          if (!null? tmM) {
            def tmMD:RangerAppFunctionDesc (unwrap tmM)
            tmMD.rust_mut_self = tmMut
          }
        }
      }
    }
  }

  fn markTraitIfaceMutations:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext directMutations:[string:boolean]) {
    def rootO@(optional):RangerAppClassDesc (this.rustTraitRootOf(cl ctx))
    if (null? rootO) {
      return
    }
    def root:RangerAppClassDesc (unwrap rootO)
    this.rustFillTraitMutations(root ctx)
    ; every method the TRAIT declares, not just the ones this class restates.
    ; A subclass that merely inherits one still calls it through `this`, and
    ; the caller's own receiver has to account for what the callee does.
    for root.defined_variants fnVar:string i {
      if (has root.rust_trait_mut fnVar) {
        set directMutations fnVar true
      }
    }
  }

  fn buildClassMutationGraph:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext directMutations:[string:boolean] callGraph:[string:MethodCallList]) {
    for cl.defined_variants fnVar:string i {
      def mVs:RangerAppMethodVariants (get cl.method_variants fnVar)
      for mVs.variants variant:RangerAppFunctionDesc i {
        def fnB@(optional):CodeNode variant.fnBody
        if (!null? fnB) {
          def fnCtx@(optional):RangerAppWriterContext variant.fnCtx
          def useCtx:RangerAppWriterContext ctx
          if (!null? fnCtx) {
            useCtx = (unwrap fnCtx)
          }
          def fnBody:CodeNode (unwrap fnB)
          
          ; Check direct mutation
          def directlyMutates:boolean (this.fnBodyDirectlyMutatesThis(fnBody useCtx))
          set directMutations variant.name directlyMutates
          
          ; Collect method calls into a MethodCallList
          def callList:MethodCallList (new MethodCallList())
          if (has callGraph variant.name) {
            callList = (unwrap (get callGraph variant.name))
          }
          this.collectSelfMethodCalls(fnBody useCtx callList.calls)
          set callGraph variant.name callList
        }
      }
    }
  }
  
  ; Check if a method transitively mutates (directly or via called methods)
  ; Uses visited set to prevent infinite recursion on cycles
  fn methodTransitivelyMutates:boolean (methodName:string directMutations:[string:boolean] callGraph:[string:MethodCallList] visited:[string]) {
    ; Check if already visited (cycle detection)
    for visited v:string i {
      if (v == methodName) {
        return false  ; Cycle - assume no mutation from this path
      }
    }
    push visited methodName
    
    ; Check direct mutation. NOTE: the value must land in a plain boolean
    ; before the test — `def dm:boolean (get …)` makes an optional binding,
    ; and `if dm` then tests presence, not the value, so every method in the
    ; map counted as mutating and no method ever took `&self`.
    if (has directMutations methodName) {
      def dmMutates:boolean false
      dmMutates = (unwrap (get directMutations methodName))
      if dmMutates {
        return true
      }
    }
    
    ; Check called methods
    if (has callGraph methodName) {
      def callList:MethodCallList (get callGraph methodName)
      for callList.calls calledMethod:string i {
        if (this.methodTransitivelyMutates(calledMethod directMutations callGraph visited)) {
          return true
        }
      }
    }
    
    return false
  }
  
  ; Main entry: Check if a method mutates this (uses call graph for transitive analysis)
  fn methodMutatesThis:boolean (methodName:string directMutations:[string:boolean] callGraph:[string:MethodCallList]) {
    def visited:[string]
    return (this.methodTransitivelyMutates(methodName directMutations callGraph visited))
  }

  ; Legacy function - kept for compatibility but uses new analysis
  fn fnBodyMutatesThis:boolean (node:CodeNode ctx:RangerAppWriterContext) {
    ; This is a simplified version that doesn't use call graph
    ; Used when we don't have the full class context
    return (this.fnBodyDirectlyMutatesThis(node ctx))
  }

  ; Does `<obj>.<methodName>(…)` land on a method that takes the hidden
  ; __self_rc argument, when the front end left node.fnDesc unresolved?
  ; Resolves through the receiver's evaluated type (the current class for a
  ; `this` receiver).
  fn rustExprCallNeedsSelfRc:boolean (obj:CodeNode methodName:string recvIsThis:boolean ctx:RangerAppWriterContext) {
    def recvT:string obj.eval_type_name
    if (((strlen recvT) == 0) && recvIsThis) {
      def thisCls@(optional):RangerAppClassDesc (ctx.getCurrentClass())
      if (!null? thisCls) {
        def thisC:RangerAppClassDesc (unwrap thisCls)
        recvT = thisC.name
      }
    }
    if ((strlen recvT) == 0) {
      return false
    }
    if ((this.rustClassIsShared(recvT ctx)) == false) {
      return false
    }
    if ((ctx.isDefinedClass(recvT)) == false) {
      return false
    }
    def recvCl:RangerAppClassDesc (ctx.findClass(recvT))
    def recvM@(optional):RangerAppFunctionDesc (recvCl.findMethod(methodName))
    if (null? recvM) {
      return false
    }
    def recvMD:RangerAppFunctionDesc (unwrap recvM)
    return (this.rustNeedsSelfRc(recvMD ctx))
  }

  fn CreateCallExpression(node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.has_call {
      ; a statement-level call is the one place a `let` can still be written
      ; before it, so the conflicting arguments come out here
      if ((ctx.expressionLevel()) == 0) {
        this.rustExtractSelfCallConflicts(node ctx wr)
      }
      def obj:CodeNode (node.getSecond())
      def method:CodeNode (node.getThird())
      def args:CodeNode (itemAt node.children 3)

      ; Check if the object is an optional type (which needs .as_ref().unwrap() or .as_mut().unwrap())
      def obj_is_optional:boolean false
      def obj_is_trait_type:boolean false  ; True if obj's type is Rc<dyn Trait>
      def owning_class_is_trait_related:boolean false ; True if owning class extends a trait or is extended
      if obj.hasParamDesc {
        def pp:RangerAppParamDesc obj.paramDesc
        if pp.is_optional {
          obj_is_optional = true
        }
        ; Check if the object's type is a trait type (parent class that is extended)
        def objNameN@(optional):CodeNode pp.nameNode
        if (!null? objNameN) {
          def objNN:CodeNode (unwrap objNameN)
          def objTypeName:string objNN.type_name
          def objTypeClass@(optional):RangerAppClassDesc (ctx.findClass(objTypeName))
          if (!null? objTypeClass) {
            def otc:RangerAppClassDesc (unwrap objTypeClass)
            if otc.is_extended_by_children {
              obj_is_trait_type = true
            }
          }
        }
        
        ; Check if owning class is trait-related
        def objOwnerClass@(optional):RangerAppClassDesc pp.propertyClass
        if (null? objOwnerClass) {
          if pp.is_class_variable {
            objOwnerClass = (ctx.getCurrentClass())
          }
        }
        if (!null? objOwnerClass) {
          def objOC:RangerAppClassDesc (unwrap objOwnerClass)
          if objOC.is_extended_by_children {
            owning_class_is_trait_related = true
          }
          if (owning_class_is_trait_related == false) {
            for objOC.extends_classes objExtParent:string objEpi {
              def objExtParentClass@(optional):RangerAppClassDesc (ctx.findClass(objExtParent))
              if (!null? objExtParentClass) {
                def objEpc:RangerAppClassDesc (unwrap objExtParentClass)
                if objEpc.is_extended_by_children {
                  owning_class_is_trait_related = true
                }
              }
            }
          }
        }
      }

      ; Check if obj is a class variable (member of self)
      def obj_is_self_member:boolean false
      if obj.hasParamDesc {
        def pp:RangerAppParamDesc obj.paramDesc
        if pp.is_class_variable {
          obj_is_self_member = true
        }
      }

      ; If calling method on self.optionalMember, and args contain self references,
      ; we need to pre-evaluate all arguments to avoid borrow conflicts
      def needs_arg_preevaluation:boolean false
      if (obj_is_optional && obj_is_self_member) {
        ; Check if any argument contains a self reference
        if (this.containsSelfReference(args)) {
          needs_arg_preevaluation = true
        }
      }
      ; A borrowed receiver holds its RefCell borrow WHILE the argument
      ; expressions run (the receiver place evaluates first in Rust): an
      ; argument that calls back into the object graph can hit the same
      ; cell — a runtime `already mutably borrowed` panic. Pre-evaluate
      ; call-carrying arguments to temporaries first.
      if (needs_arg_preevaluation == false) {
        def recvBorrows:boolean obj_is_optional
        if (recvBorrows == false) {
          if obj.hasParamDesc {
            def rbP:RangerAppParamDesc obj.paramDesc
            if rbP.rust_needs_rc_wrap {
              recvBorrows = true
            }
          }
        }
        if (recvBorrows == false) {
          if (obj.hasNewOper == false) {
            if (this.rustClassIsShared(obj.eval_type_name ctx)) {
              recvBorrows = true
            }
          }
        }
        if recvBorrows {
          if (this.rustNodeContainsCall(args)) {
            needs_arg_preevaluation = true
          }
        }
      }
      
      ; DEBUG: Log detection for self member calls
      if obj_is_self_member {
      }

      ; Pre-evaluate all arguments if needed
      ; BUT only do this if we're not inside an expression (can't emit let in expr)
      if (needs_arg_preevaluation && ((ctx.expressionLevel()) == 0)) {
        def pms (filter (args.children) {
          if (item.hasFlag("keyword")) {
            return false
          }
          return true
        })
        
        def tmpVarIdx:int 0
        for pms arg:CodeNode i {
          ; only an argument that can touch the graph needs the
          ; temporary — a bare name or literal stays inline (extracting
          ; it would MOVE the name and break later uses)
          def argNeedsTmp:boolean (this.rustNodeContainsCall(arg))
          if (argNeedsTmp == false) {
            if (this.containsSelfReference(arg)) {
              argNeedsTmp = true
            }
          }
          ; a closure literal stays in the call that takes it, whatever it
          ; contains: hoisted out, it has no expected type to infer from
          if (this.rustNodeIsLambda(arg)) {
            argNeedsTmp = false
          }
          if argNeedsTmp {
            def tmpVarName:string ("__arg_" + (to_string tmpVarIdx))
            tmpVarIdx = tmpVarIdx + 1

            ; Generate: let __arg_N = <arg>;
            wr.out(("let " + tmpVarName + " = ") false)
            ctx.setInExpr()
            this.WalkNode(arg ctx wr)
            ctx.unsetInExpr()
            wr.out(";" true)

            ; Mark the arg node to use this temp var
            arg.rust_use_tmpvar = tmpVarName
          }
        }
      }

      ; A `this` receiver routed through this path — bare or wrapped in
      ; single-child expression nodes — is the borrowed struct: it calls as
      ; `self.m(…)`. Walking it as a value emits `(__self_rc).borrow()`,
      ; a RefCell double-borrow panic at runtime inside a &mut self frame.
      def exprThisRecv:boolean false
      if ((obj.expression == false) && (obj.vref == "this")) {
        exprThisRecv = true
      }
      if (obj.expression && ((array_length obj.children) == 1)) {
        def exprRecvCore:CodeNode (obj.getFirst())
        if ((exprRecvCore.expression == false) && (exprRecvCore.vref == "this")) {
          exprThisRecv = true
        }
        if (exprRecvCore.expression && ((array_length exprRecvCore.children) == 1)) {
          def exprRecvCore2:CodeNode (exprRecvCore.getFirst())
          if ((exprRecvCore2.expression == false) && (exprRecvCore2.vref == "this")) {
            exprThisRecv = true
          }
        }
      }
      ; Does the callee take the hidden __self_rc argument? node.fnDesc when
      ; the front end resolved it; otherwise through the receiver's evaluated
      ; type — an unresolved fnDesc used to skip the hidden argument silently,
      ; so the generated call was one argument short (E0061).
      def exprSelfRcNeeded:boolean false
      if (!null? node.fnDesc) {
        exprSelfRcNeeded = (this.rustNeedsSelfRc((unwrap node.fnDesc) ctx))
      } {
        exprSelfRcNeeded = (this.rustExprCallNeedsSelfRc(obj method.vref exprThisRecv ctx))
      }
      ; An EXPRESSION receiver of a __self_rc method has no name to pass, so
      ; the call is wrapped in a block that binds the receiver first:
      ;   { let __t = EXPR; (__t).borrow_mut().m(&__t, …) }
      def exprSelfRcTmp:string ""

      ; a method whose body never touches `this` was emitted as an
      ; associated fn (no self receiver): the call takes the static
      ; syntax, whatever the receiver expression was (E0599)
      def hc_static:boolean false
      if (!null? node.fnDesc) {
        def stFnD:RangerAppFunctionDesc (unwrap node.fnDesc)
        def stBody@(optional):CodeNode stFnD.fnBody
        if (!null? stBody) {
          def stCtxO@(optional):RangerAppWriterContext stFnD.fnCtx
          def stUseCtx:RangerAppWriterContext ctx
          if (!null? stCtxO) {
            stUseCtx = (unwrap stCtxO)
          }
          if ((this.rustMethodNeedsReceiver(stFnD (unwrap stBody) stUseCtx ctx)) == false) {
            def stCC@(optional):RangerAppClassDesc stFnD.container_class
            if (!null? stCC) {
              def stC:RangerAppClassDesc (unwrap stCC)
              ; an EXPRESSION receiver still has to be named before the
              ; static call can hand its handle over — the receiver emission
              ; below, which usually does that binding, is skipped here
              if exprSelfRcNeeded {
                if obj.expression {
                  exprSelfRcTmp = (ctx.rustGetTempVar())
                  wr.out((("{ let " + exprSelfRcTmp) + " = ") false)
                  ctx.setInExpr()
                  this.WalkNode(obj ctx wr)
                  ctx.unsetInExpr()
                  wr.out((((("; let " + exprSelfRcTmp) + "_r = ") + "") + "") false)
                }
              }
              wr.out(((stC.name + "::") + method.vref) false)
              hc_static = true
            }
          }
        }
      }
      if (hc_static == false) {
      if obj_is_optional {
        ; For optional objects with trait types: Rc<RefCell<dyn Trait>>
        ; Or for optional objects in trait-related classes: Option<RefCell<T>>
        ctx.setInExpr()
        this.WalkNode(obj ctx wr)
        ctx.unsetInExpr()
        if (obj_is_trait_type || owning_class_is_trait_related) {
          ; Trait types use Rc<RefCell<...>> - borrow_mut for interior mutability
          ; Fields in trait-related classes use Option<RefCell<T>>
          wr.out(".as_ref().unwrap().borrow_mut()." false)
        } {
          ; a strong optional field of a shared class holds
          ; Option<Rc<RefCell<T>>>: the unwrap yields the Rc and the call
          ; must go through the cell
          def optRecvShared:boolean false
          if obj.hasParamDesc {
            def orpD:RangerAppParamDesc obj.paramDesc
            def orpNN@(optional):CodeNode orpD.nameNode
            if (!null? orpNN) {
              def orpN:CodeNode (unwrap orpNN)
              if (this.rustClassIsShared(orpN.type_name ctx)) {
                optRecvShared = true
              }
            }
          }
          if optRecvShared {
            ; as_ref: mutation goes through the cell; an as_mut would hold
            ; the field mutably through the call and conflict with a
            ; __self_rc re-borrow of the same field. A &self method
            ; borrows shared, so an aliasing argument cannot panic.
            def orsMut:boolean true
            if (!null? node.fnDesc) {
              def orsFnD:RangerAppFunctionDesc (unwrap node.fnDesc)
              orsMut = orsFnD.rust_mut_self
            }
            if orsMut {
              wr.out(".as_ref().unwrap().borrow_mut()." false)
            } {
              wr.out(".as_ref().unwrap().borrow()." false)
            }
          } {
            wr.out(".as_mut().unwrap()." false)
          }
        }
      } {
        ; Standard case - wrap in parentheses
        if exprThisRecv {
          ; a self-call: the receiver is the already-borrowed struct
          wr.out(((this.rustThisPrefix(ctx)) + ".") false)
        } {
        if (exprSelfRcNeeded && obj.expression) {
          exprSelfRcTmp = (ctx.rustGetTempVar())
          wr.out((("{ let " + exprSelfRcTmp) + " = ") false)
          ctx.setInExpr()
          this.WalkNode(obj ctx wr)
          ctx.unsetInExpr()
          ; the call lands in a binding, not the block tail: a tail
          ; expression keeps its RefMut temporary alive past the drop of
          ; the receiver binding (E0597)
          wr.out((((("; let " + exprSelfRcTmp) + "_r = (") + exprSelfRcTmp) + "") false)
        } {
          wr.out("(" false)
          ctx.setInExpr()
          this.WalkNode(obj ctx wr)
          ctx.unsetInExpr()
        }
        if obj_is_trait_type {
          ; Trait types use Rc<RefCell<...>> - borrow_mut for interior mutability
          wr.out(").borrow_mut()." false)
        } {
          ; an Rc<RefCell<T>> receiver borrows mutably for the call
          def obj_is_rc:boolean false
          if obj.hasParamDesc {
            def orp:RangerAppParamDesc obj.paramDesc
            if orp.rust_needs_rc_wrap {
              def orp_weak:boolean false
              def orpNN@(optional):CodeNode orp.nameNode
              if (!null? orpNN) {
                if ((unwrap orpNN).hasFlag("weak")) {
                  orp_weak = true
                }
              }
              if (orp_weak == false) {
                obj_is_rc = true
              }
            }
          }
          if (obj_is_rc == false) {
            ; an expression receiver — an unwrap, an element read, a call
            ; result — of a shared class hands out the Rc itself; a `new`
            ; is the one shared-class expression that is still a plain value
            if (obj.hasNewOper == false) {
              def objEvalT:string obj.eval_type_name
              if ((strlen objEvalT) == 0) {
                if (!null? node.fnDesc) {
                  def hcFnD:RangerAppFunctionDesc (unwrap node.fnDesc)
                  def hcCC@(optional):RangerAppClassDesc hcFnD.container_class
                  if (!null? hcCC) {
                    def hcC:RangerAppClassDesc (unwrap hcCC)
                    objEvalT = hcC.name
                  }
                }
              }
              if (this.rustClassIsShared(objEvalT ctx)) {
                obj_is_rc = true
              }
            }
          }
          if obj_is_rc {
            def oirMut:boolean true
            if (!null? node.fnDesc) {
              def oirFnD:RangerAppFunctionDesc (unwrap node.fnDesc)
              oirMut = oirFnD.rust_mut_self
            }
            if oirMut {
              wr.out(").borrow_mut()." false)
            } {
              wr.out(").borrow()." false)
            }
          } {
            wr.out(")." false)
          }
        }
        }
      }
      
      wr.out(method.vref false)
      }
      wr.out("(" false)
      ctx.setInExpr()
      ; the hidden Rc argument of a method that stores `this`
      def hc_wrote_selfrc:boolean false
      if ((strlen exprSelfRcTmp) > 0) {
        ; the receiver was bound in the wrapping block; hand its Rc on
        wr.out(("&" + exprSelfRcTmp) false)
        hc_wrote_selfrc = true
      } {
        if exprSelfRcNeeded {
          if exprThisRecv {
            ; self-call: the caller's own hidden argument is the Rc, and it
            ; is already a reference — pass it through bare
            wr.out("__self_rc" false)
            hc_wrote_selfrc = true
          } {
          if (((array_length obj.ns) <= 1) && (obj.expression == false)) {
            wr.out("&" false)
            this.WriteVRef(obj ctx wr)
            hc_wrote_selfrc = true
          } {
            ctx.addError(node "This method stores `this`, so its Rust form needs the receiver's Rc. Bind the receiver to a variable first: def recv:T (expr) — then recv.method(...).")
          }
          }
        }
      }

      def pms (filter (args.children) {
        if (item.hasFlag("keyword")) {
          return false
        }
        return true
      })
      
      ; Get the called function's descriptor if available
      def calledFnDesc@(optional):RangerAppFunctionDesc node.fnDesc
      
      for pms arg:CodeNode i {
        if ((i > 0) || hc_wrote_selfrc) {
          wr.out(", " false)
        }
        ; Check if this arg should use a pre-evaluated temp variable
        if ((strlen arg.rust_use_tmpvar) > 0) {
          wr.out(arg.rust_use_tmpvar false)
          ; Clear the flag after use
          arg.rust_use_tmpvar = ""
        } {
          ; Check if we need to handle borrow type conversion
          def source_is_reference:boolean false
          def target_expects_owned:boolean true  ; Default to expecting owned
          
          ; Check if source argument is a reference parameter
          if (arg.value_type == RangerNodeType.VRef) {
            if arg.hasParamDesc {
              def srcParam:RangerAppParamDesc arg.paramDesc
              if (srcParam.rust_borrow_type > 0) {
                source_is_reference = true
              }
            }
          }
          
          ; Try to get the called function's parameter info
          ; First from node.fnDesc if available
          if (!null? calledFnDesc) {
            def cfn:RangerAppFunctionDesc (unwrap calledFnDesc)
            if (i < (array_length cfn.params)) {
              def targetParam:RangerAppParamDesc (itemAt cfn.params i)
              if (targetParam.rust_borrow_type > 0) {
                target_expects_owned = false
              }
            }
          } {
            ; If node.fnDesc is not available, try to look up the method from obj's type
            if obj.hasParamDesc {
              def objPd:RangerAppParamDesc obj.paramDesc
              if (!null? objPd.nameNode) {
                def objNN:CodeNode (unwrap objPd.nameNode)
                def objTypeName:string objNN.type_name
                def objClass@(optional):RangerAppClassDesc (ctx.findClass(objTypeName))
                if (!null? objClass) {
                  def oc:RangerAppClassDesc (unwrap objClass)
                  def calledMethod@(optional):RangerAppFunctionDesc (oc.findMethod(method.vref))
                  if (!null? calledMethod) {
                    def cm:RangerAppFunctionDesc (unwrap calledMethod)
                    if (i < (array_length cm.params)) {
                      def targetParam2:RangerAppParamDesc (itemAt cm.params i)
                      if (targetParam2.rust_borrow_type > 0) {
                        target_expects_owned = false
                      }
                    }
                  }
                }
              }
            }
          }
          
          ; an immutable-borrow target takes & — unless the source is
          ; already a reference (a borrowed param passed through); a string
          ; literal passes bare (the parameter is &str)
          def borrowedLitDone:boolean false
          if (target_expects_owned == false) {
            borrowedLitDone = (this.rustTryBareStrLitArg(arg ctx wr))
            if (borrowedLitDone == false) {
              if ((this.rustArgIsAlreadyRef(arg)) == false) {
                wr.out("&" false)
              }
            }
          }
          if (borrowedLitDone == false) {
            this.WalkNode(arg ctx wr)
          }

          ; If source is reference and target expects owned, add .clone()
          if (source_is_reference && target_expects_owned) {
            if (this.rustStrRefRead(arg)) {
              wr.out(".to_string()" false)
            } {
              wr.out(".clone()" false)
            }
          } {
            ; a bare non-Copy name handed to an owned parameter MOVES and
            ; breaks any later use of the name — clone, as the standard
            ; call path does (dotted reads clone through WriteVRef already)
            if (target_expects_owned && (this.rustBareArgNeedsClone(arg ctx))) {
              if (this.rustStrRefRead(arg)) {
                wr.out(".to_string()" false)
              } {
                wr.out(".clone()" false)
              }
            }
          }
        }
      }
      ctx.unsetInExpr()
      wr.out(")" false)
      if ((strlen exprSelfRcTmp) > 0) {
        ; closes `{ let __t = EXPR; let __t_r = …` from the receiver emission
        wr.out(((("; " + exprSelfRcTmp) + "_r }") + "") false)
      }
      if ((ctx.expressionLevel()) == 0) {
        wr.out(";" true)
      }
    }
  }

  ; True when an argument is a named local/param — or a dotted field read,
  ; which comes out of a Ref and cannot move (E0507) — whose type moves on
  ; a by-value pass (String, collection, object): the call would consume
  ; the value, so the call site has to clone. Copy scalars, weak refs and
  ; optionals stay untouched.
  fn rustBareArgNeedsClone:boolean (arg:CodeNode ctx:RangerAppWriterContext) {
    if arg.expression {
      return false
    }
    if ((strlen arg.vref) == 0) {
      return false
    }
    if ((array_length arg.children) > 0) {
      return false
    }
    if ((array_length arg.ns) > 1) {
      ; a dotted read: the FINAL segment's desc carries the value's type
      if ((array_length arg.nsp) == 0) {
        return false
      }
      def dLastIdx:int ((array_length arg.nsp) - 1)
      def dLast:RangerAppParamDesc (itemAt arg.nsp dLastIdx)
      if dLast.is_optional {
        return false
      }
      def dNN@(optional):CodeNode dLast.nameNode
      if (null? dNN) {
        return false
      }
      def dN:CodeNode (unwrap dNN)
      if (dN.hasFlag("weak")) {
        return false
      }
      if ((strlen dN.array_type) > 0) {
        return true
      }
      if ((strlen dN.key_type) > 0) {
        return true
      }
      def dtn:string dN.type_name
      if (dtn == "string") {
        return true
      }
      if (dtn == "int") { return false }
      if (dtn == "double") { return false }
      if (dtn == "boolean") { return false }
      if (dtn == "char") { return false }
      if (TTypeRegistry.isIntAlias(dtn)) { return false }
      if (TTypeRegistry.isFloatAlias(dtn)) { return false }
      def dVT:RangerNodeType (dN.typeNameAsType(ctx))
      if (dVT == RangerNodeType.Object) {
        return true
      }
      return false
    }
    if (arg.hasParamDesc == false) {
      return false
    }
    def spD:RangerAppParamDesc arg.paramDesc
    if spD.is_optional {
      return false
    }
    if (spD.rust_borrow_type > 0) {
      return false
    }
    def spNN@(optional):CodeNode spD.nameNode
    if (null? spNN) {
      return false
    }
    def spN:CodeNode (unwrap spNN)
    if (spN.hasFlag("weak")) {
      return false
    }
    if ((strlen spN.array_type) > 0) {
      return true
    }
    if ((strlen spN.key_type) > 0) {
      return true
    }
    def stn:string spN.type_name
    if (stn == "string") {
      return true
    }
    if (stn == "int") { return false }
    if (stn == "double") { return false }
    if (stn == "boolean") { return false }
    if (stn == "char") { return false }
    if (TTypeRegistry.isIntAlias(stn)) { return false }
    if (TTypeRegistry.isFloatAlias(stn)) { return false }
    def spVT:RangerNodeType (spN.typeNameAsType(ctx))
    if (spVT == RangerNodeType.Object) {
      return true
    }
    return false
  }

  ; Override CreateMethodCall for Rust to handle borrow conflicts with optional self members
  ; This is used for is_direct_method_call nodes (e.g., streamBuffer.writeString(...))
  fn CreateMethodCall(node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ; DEBUG: Always print to confirm this is called
    print "DEBUG CreateMethodCall ALWAYS CALLED"
    
    def obj:CodeNode (node.getFirst())
    def args:CodeNode (node.getSecond())
    
    ; DEBUG: Always print to confirm this function is being called
    
    ; Check if the object is an optional class variable (self member)
    def obj_is_optional:boolean false
    def obj_is_self_member:boolean false
    if obj.hasParamDesc {
      def pp:RangerAppParamDesc obj.paramDesc
      obj_is_optional = pp.is_optional
      obj_is_self_member = pp.is_class_variable
    }
    
    ; Also check the object's children - for chained access like obj.method
    ; The object node might contain the target with paramDesc
    if (obj_is_self_member == false) {
      for obj.children child:CodeNode i {
        if child.hasParamDesc {
          def pp:RangerAppParamDesc child.paramDesc
          if pp.is_class_variable {
            obj_is_self_member = true
            if pp.is_optional {
              obj_is_optional = true
            }
          }
        }
      }
    }
    
    ; Check if we need to pre-evaluate arguments to avoid borrow conflicts
    ; When calling a method on a self member, if args contain self references,
    ; we need to pre-evaluate to avoid borrowing self twice
    def needs_arg_preevaluation:boolean false
    if obj_is_self_member {
      if (this.containsSelfReference(args)) {
        needs_arg_preevaluation = true
      }
    }
    
    ; DEBUG
    if obj_is_self_member {
    }
    
    ; Pre-evaluate arguments if needed (only at statement level, not inside expressions)
    if (needs_arg_preevaluation && ((ctx.expressionLevel()) == 0)) {
      def pms (filter (args.children) {
        if (item.hasFlag("keyword")) {
          return false
        }
        return true
      })
      
      def tmpVarIdx:int 0
      for pms arg:CodeNode i {
        ; a closure literal stays in the call that takes it: hoisted out, it
        ; has no expected type to infer its parameters from
        if (this.rustNodeIsLambda(arg)) {
          continue
        }
        def tmpVarName:string ("__arg_" + (to_string tmpVarIdx))
        tmpVarIdx = tmpVarIdx + 1
        
        ; Generate: let __arg_N = <arg>;
        wr.out(("let " + tmpVarName + " = ") false)
        ctx.setInExpr()
        this.WalkNode(arg ctx wr)
        ctx.unsetInExpr()
        wr.out(";" true)
        
        ; Mark the arg to use temp var
        arg.rust_use_tmpvar = tmpVarName
      }
    }
    
    ; Write the actual method call
    ctx.setInExpr()
    this.WalkNode(obj ctx wr)
    ctx.unsetInExpr()
    wr.out("(" false)
    ctx.setInExpr()
    
    def pms (filter (args.children) {
      if (item.hasFlag("keyword")) {
        return false
      }
      return true
    })
    
    for pms arg:CodeNode i {
      if (i > 0) {
        wr.out(", " false)
      }
      ; Check if this arg should use a pre-evaluated temp variable
      if ((strlen arg.rust_use_tmpvar) > 0) {
        wr.out(arg.rust_use_tmpvar false)
        ; Clear the flag after use
        arg.rust_use_tmpvar = ""
      } {
        this.WalkNode(arg ctx wr)
      }
    }
    ctx.unsetInExpr()
    wr.out(")" false)
    if ((ctx.expressionLevel()) == 0) {
      wr.out(";" true)
    }
  }

  ; Check if a node is a self method call (this.method(...))
  fn isSelfMethodCall:boolean (node:CodeNode) {
    if node.hasFnCall {
      def fc:CodeNode (node.getFirst())
      if (has fc.ns) {
        def part:string (itemAt fc.ns 0)
        if (part == "this") {
          return true
        }
      }
    }
    return false
  }

  ; Check if any argument contains a self method call - returns the argument index, -1 if none
  fn findSelfCallInArgs:int (node:CodeNode) {
    if node.hasFnCall {
      def givenArgs:CodeNode (node.getSecond())
      def idx:int 0
      for givenArgs.children arg:CodeNode i {
        if (this.isSelfMethodCall(arg)) {
          return i
        }
        idx = i + 1
      }
    }
    return (-1)
  }

  fn writeFnCall:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    ; a statement-level call is the one place a `let` can still be written
    ; before it, so the arguments that alias each other come out here
    if ((ctx.expressionLevel()) == 0) {
      this.rustExtractSelfCallConflicts(node ctx wr)
    }
    ; DEBUG: Unconditional entry debug
    
    if node.hasFnCall {
      def fc:CodeNode (node.getFirst())
      def part:string (itemAt fc.ns 0)

      ; NOTE: a method whose body never touches `this` is emitted as an
      ; associated function, with no receiver, so calling it as `self.m(…)`
      ; is "an associated function, not a method" -- 12 errors. Writing
      ; `Class::m(args)` here with a plain argument walk costs far more than
      ; it saves (173 -> 424): the ordinary call path applies borrows,
      ; clones and temporaries to each argument, and none of that is
      ; optional. The repair is to reuse that path with a different
      ; receiver, not to write a second one.

      ; DEBUG: Print all method calls to trace huffman.parseDHT
      if ((strlen part) > 0) {
        def methodName:string ""
        if ((array_length fc.ns) >= 2) {
          methodName = (itemAt fc.ns 1)
        }
        if ((methodName == "parseDHT") || (part == "huffman")) {
        }
      }
      
      ; Check if the target is a class variable (self member) and if it's optional
      def target_is_self_member:boolean false
      def target_is_optional:boolean false
      
      ; Check the first part of the namespace path
      if (part == "this") {
        target_is_self_member = true
      } {
        ; Check if it's a class variable
        if (ctx.isMemberVariable(part)) {
          target_is_self_member = true
          ; Check if it's optional
          def uc@(optional):RangerAppClassDesc (ctx.getCurrentClass())
          if (!null? uc) {
            def currC:RangerAppClassDesc (unwrap uc)
            def up@(optional):RangerAppParamDesc (currC.findVariable(part))
            if (!null? up) {
              def p:RangerAppParamDesc (unwrap up)
              if p.is_optional {
                target_is_optional = true
              }
            }
          }
        }
      }
      
      def givenArgs:CodeNode (node.getSecond())
      
      ; If calling method on a self member and args contain self references,
      ; we need to pre-evaluate all arguments to avoid borrow conflicts
      ; e.g., self.huffman.parseDHT(self.data, ...) requires pre-evaluating self.data
      def needs_arg_preevaluation:boolean false

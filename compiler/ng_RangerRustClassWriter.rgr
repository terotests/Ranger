    }
    if ((array_length fc.nsp) < (rpLen - 1)) {
      return rpRes
    }
    def rpD:RangerAppParamDesc (itemAt fc.nsp (rpLen - 2))
    def rpNNO@(optional):CodeNode rpD.nameNode
    if (null? rpNNO) {
      return rpRes
    }
    def rpNN:CodeNode (unwrap rpNNO)
    if (((strlen rpNN.array_type) > 0) || ((strlen rpNN.key_type) > 0)) {
      return rpRes
    }
    if (ctx.isDefinedClass(rpNN.type_name)) {
      rpRes = (ctx.findClass(rpNN.type_name))
    }

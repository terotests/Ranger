              ; resolve and the read looked like a scalar — it is a move of a
              ; non-Copy field out of a borrowed struct. The field's own
              ; declaration answers what the local's does not.
              if ((v_type == RangerNodeType.Object) || (v_type == RangerNodeType.VRef) || (v_type == RangerNodeType.NoType)) {
                def vpNN@(optional):CodeNode vp.nameNode
                if (!null? vpNN) {
                  def vpN:CodeNode (unwrap vpNN)
                  def fld_type:RangerNodeType vpN.value_type
                  if ((fld_type == RangerNodeType.Object) || (fld_type == RangerNodeType.VRef) || (fld_type == RangerNodeType.NoType)) {
                    fld_type = (vpN.typeNameAsType(ctx))
                  }
                  v_type = fld_type

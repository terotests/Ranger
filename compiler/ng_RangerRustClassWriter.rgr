            this.WalkNode(right ctx wr)
            if should_clone_rhs {
              wr.out(".clone()" false)
            }
            wr.out("))));" true)
          } {
            wr.out(" = Rc::downgrade(&Rc::new(RefCell::new(" false)
            this.WalkNode(right ctx wr)
            if should_clone_rhs {
              wr.out(".clone()" false)
            }
            wr.out(")));" true)
          }
        }
        ctx.unsetInExpr()
        return
      }
      
      if is_optional {
        ; a pre-evaluated right side already owns its value (clone
        ; applied at the temporary) — move it in, mirroring the standard
        ; Some(…) branch below
        if preeval_rhs {
          ; …and if that value is already an Option it goes in as it is:
          ; a Some() around it would nest one Option inside another
          if (this.rustExprIsOptional(right ctx)) {
            wr.out(((" = " + preeval_name) + ";") true)
          } {
            wr.out(((" = Some(" + preeval_name) + ");") true)
          }
          ctx.unsetInExpr()
          return
        }
        if rhs_is_optional {
          ; Both sides are optional - just clone the RHS, don't wrap with Some()
          def optCoerce:string (this.rustTraitCoerceName(field_type_name right ctx))
          wr.out(" = " false)
          this.WalkNode(right ctx wr)
          if ((strlen optCoerce) > 0) {
            wr.out(((".clone().map(|__u| __u as Rc<RefCell<dyn " + optCoerce) + "Trait>>);") true)
          } {
            wr.out(".clone();" true)
          }
        } {
          if is_self_ref {
            if (this.rustClassIsShared(field_type_name ctx)) {

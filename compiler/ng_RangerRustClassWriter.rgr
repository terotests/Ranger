    ; node's eval_type_name has already been widened to the union by then
    def newClOpt@(optional):RangerAppClassDesc value.clDesc
    if (null? newClOpt) {
      return false
    }
    def newCl:RangerAppClassDesc (unwrap newClOpt)
    if newCl.is_union {
      return false
    }
    return (this.rustClassIsShared(newCl.name ctx))
  }

  ; Is `memberName` one of this union's members?
  fn rustUnionHasMember:boolean (ucl:RangerAppClassDesc memberName:string) {
    return ((indexOf ucl.is_union_of memberName) >= 0)
  }

  ; The declared class of a value node, as the source named it: a name carries
  ; its desc, a `new` carries the class it constructs. Empty when neither.
  fn rustDeclaredClassOf:string (nVal:CodeNode) {

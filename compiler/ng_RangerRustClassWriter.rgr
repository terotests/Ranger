      ; not of the object. The trait object goes straight into the Weak.
      if (((strlen node.array_type) == 0) && ((strlen node.key_type) == 0)) {
        if (this.rustTypeIsOwnHandle(node.type_name ctx)) {
          def wkInner:string (("dyn " + node.type_name) + "Trait")
          if is_optional {
            wr.out((("Option<Weak<RefCell<" + wkInner) + ">>>") false)
          } {
            wr.out((("Weak<RefCell<" + wkInner) + ">>") false)
          }
          return
        }
      }
      if is_optional {
        wr.out("Option<Weak<RefCell<" false)
      } {
        wr.out("Weak<RefCell<" false)
      }
    } {
      if is_optional {
        if is_self_referential {

  fn rustClassIsShared:boolean (typeName:string ctx:RangerAppWriterContext) {
    if ((strlen typeName) == 0) {
      return false
    }
    if (ctx.hasCompilerFlag("rust-value-classes")) {
      return false
    }
    def typeClass@(optional):RangerAppClassDesc (ctx.findClass(typeName))
    if (null? typeClass) {

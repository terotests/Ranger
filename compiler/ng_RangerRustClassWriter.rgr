              if value_already_rc_wrapped {
                wr.out(".clone()" false)
              } {
                if needs_clone {
                  if (this.rustArgIsNameRead(nVal)) {
                    if (this.rustStrRefRead(nVal)) {
                      wr.out(".to_string()" false)
                    } {
                      if (this.rustSliceRefRead(nVal)) {
                        wr.out(".to_vec()" false)
                      } {

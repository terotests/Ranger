        def retNeedsRcWrap:boolean false
        if (!null? rustFnReturnNameNode) {
          def rfNN:CodeNode (unwrap rustFnReturnNameNode)
          if (((strlen rfNN.array_type) == 0) && ((strlen rfNN.key_type) == 0)) {
            if (rfNN.hasFlag("optional") == false) {

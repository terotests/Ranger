; SPDX-License-Identifier: MIT

; Closed variants on the Rust side: a union is an enum, and a value going into
; or out of one has to be wrapped, unwrapped or matched.

extension RangerRustClassWriter {

  fn rustNewIntoUnion:boolean (value:CodeNode ctx:RangerAppWriterContext) {
    if (value.hasNewOper == false) {
      return false
    }
    ; the CONSTRUCTED class, from the new-expression's own descriptor: the
    ; node's eval_type_name has already been widened to the union by then
    def newClOpt@(optional):RangerAppClassDesc value.clDesc
    if (null? newClOpt) {
      return false
    }
    def newCl:RangerAppClassDesc (unwrap newClOpt)
    if newCl.is_union {
      return false
    }
    return (this.rustClassIsShared(newCl.name ctx))
  }

  fn rustUnionHasMember:boolean (ucl:RangerAppClassDesc memberName:string) {
    return ((indexOf ucl.is_union_of memberName) >= 0)
  }

  fn rustDeclaredClassOf:string (nVal:CodeNode) {
    if nVal.hasNewOper {
      def newClOpt@(optional):RangerAppClassDesc nVal.clDesc
      if (!null? newClOpt) {
        def newCl:RangerAppClassDesc (unwrap newClOpt)
        return newCl.name
      }
    }
    if nVal.hasParamDesc {
      def pd:RangerAppParamDesc nVal.paramDesc
      def pdNN@(optional):CodeNode pd.nameNode
      if (!null? pdNN) {
        def pdNode:CodeNode (unwrap pdNN)
        return pdNode.type_name
      }
    }
    return ""
  }

  fn rustWriteUnionValue:boolean (targetTypeName:string nVal:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if ((strlen targetTypeName) == 0) {
      return false
    }
    def tcOpt@(optional):RangerAppClassDesc (ctx.findClass(targetTypeName))
    if (null? tcOpt) {
      return false
    }
    def target:RangerAppClassDesc (unwrap tcOpt)
    if ((this.unionIsSealable(target ctx)) == false) {
      return false
    }
    def enumName:string (this.unionInterfaceName(targetTypeName))
    def valClass:string (this.rustDeclaredClassOf(nVal))

    if (this.rustUnionHasMember(target valClass)) {
      wr.out(((enumName + "::") + valClass) false)
      wr.out("(" false)
      if nVal.hasNewOper {
        ; a fresh REFERENCE member takes its cell here — it has no local to
        ; borrow one from; a value member is stored as it is
        def memberShared:boolean (this.rustClassIsShared(valClass ctx))
        if memberShared {
          wr.out("Rc::new(RefCell::new(" false)
        }
        ctx.setInExpr()
        wr.suppress_expr_parens = true
        this.WalkNode(nVal ctx wr)
        wr.suppress_expr_parens = false
        ctx.unsetInExpr()
        if memberShared {
          wr.out("))" false)
        }
      } {
        ctx.setInExpr()
        wr.suppress_expr_parens = true
        this.WalkNode(nVal ctx wr)
        wr.suppress_expr_parens = false
        ctx.unsetInExpr()
        wr.out(".clone()" false)
      }
      wr.out(")" false)
      return true
    }

    ; already a value of the family: pass the handle as a clone, so the caller
    ; keeps its own
    ctx.setInExpr()
    wr.suppress_expr_parens = true
    this.WalkNode(nVal ctx wr)
    wr.suppress_expr_parens = false
    ctx.unsetInExpr()
    wr.out(".clone()" false)
    return true
  }

  fn rustUnionReturnOf:string (fnDesc:RangerAppFunctionDesc ctx:RangerAppWriterContext) {
    def nnOpt@(optional):CodeNode fnDesc.nameNode
    if (null? nnOpt) {
      return ""
    }
    def nn:CodeNode (unwrap nnOpt)
    def tn:string nn.type_name
    if ((strlen tn) == 0) {
      return ""
    }
    def clOpt@(optional):RangerAppClassDesc (ctx.findClass(tn))
    if (null? clOpt) {
      return ""
    }
    def cl:RangerAppClassDesc (unwrap clOpt)
    if ((this.unionIsSealable(cl ctx)) == false) {
      return ""
    }
    return tn
  }

  fn rustUnionValueCase:boolean (cl:RangerAppClassDesc ctx:RangerAppWriterContext) {
    if (cl.is_union || cl.is_system) {
      return false
    }
    if (this.rustClassIsShared(cl.name ctx)) {
      return false
    }
    def rootCtx:RangerAppWriterContext (ctx.getRoot())
    for rootCtx.definedClasses ucl:RangerAppClassDesc uci {
      if (this.unionIsSealable(ucl ctx)) {
        if ((indexOf ucl.is_union_of cl.name) >= 0) {
          return true
        }
      }
    }
    return false
  }

  fn rustArgNeedsUnionWrap:boolean (targetTypeName:string nVal:CodeNode ctx:RangerAppWriterContext) {
    if ((strlen targetTypeName) == 0) {
      return false
    }
    def tcOpt@(optional):RangerAppClassDesc (ctx.findClass(targetTypeName))
    if (null? tcOpt) {
      return false
    }
    def target:RangerAppClassDesc (unwrap tcOpt)
    if ((this.unionIsSealable(target ctx)) == false) {
      return false
    }
    return (this.rustUnionHasMember(target (this.rustDeclaredClassOf(nVal))))
  }

  fn rustWriteUnionArg:boolean (arg:RangerAppParamDesc nVal:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def argNN@(optional):CodeNode arg.nameNode
    if (null? argNN) {
      return false
    }
    if arg.needs_cpp_reference {
      return false
    }
    def argNameNode:CodeNode (unwrap argNN)
    ; D-UNION: a BORROWED union parameter (`fn add(v : &union_Value)`) still
    ; needs the member wrapped in its variant -- `p.add(&n)` where n is a case
    ; passes `&Value_Num` where `&union_Value` is expected, which is a type
    ; error. Only a member needs this: a value already of the family borrows
    ; directly, the way it does today, and cloning it to make a temporary to
    ; borrow would be a pointless copy. The wrap produces a temporary, which
    ; lives to the end of the enclosing statement, so the reference is sound.
    if (arg.rust_borrow_type == 1) {
      if ((this.rustArgNeedsUnionWrap(argNameNode.type_name nVal ctx)) == false) {
        return false
      }
      wr.out("&" false)
      return (this.rustWriteUnionValue(argNameNode.type_name nVal ctx wr))
    }
    ; a &mut parameter keeps its own handling: a wrapped temporary could not
    ; carry a mutation back to the caller, so quietly widening there would
    ; lose writes rather than report them
    if (arg.rust_borrow_type != 0) {
      return false
    }
    return (this.rustWriteUnionValue(argNameNode.type_name nVal ctx wr))
  }

}

extension RangerRustClassWriter {

  ; --- a shape `match` as a Rust `match` (PLAN_RUST_SEMANTIC_IDIOMS E) --------
  ; `match` is desugared in FlowShape into one `case` narrowing per arm, spliced
  ; as consecutive siblings, because that is the shape every target can write.
  ; Rust has a real `match`, and the desugar marks the run so this writer can
  ; put it back together: `match_head` opens it, `match_arm` is each arm,
  ; `match_tail` closes it, and `match_total` says the arms cover the whole enum
  ; so no wildcard is needed.
  ;
  ; The narrowings are written one statement at a time, so the opening `match`
  ; and the closing brace are emitted by different calls — which is why the head
  ; and tail marks exist rather than one node holding the arms. The binding and
  ; the forked context are already in place: `case` is declared
  ; `_@(newcontext):void (arg@(union):T item@(define):T code:block)`, so the
  ; generic machinery has declared `item` before any template or custom runs.
  ; `(typeof 1)` on the scrutinee: the template op reads the PARAM DESC's name
  ; node when there is one, and the raw node otherwise. Writing the raw node for
  ; a parameter emits nothing at all, which came out as `::Message_Ping`.
  fn rustWriteScrutineeType:void (scrut:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if scrut.hasParamDesc {
      def sNN@(optional):CodeNode scrut.paramDesc.nameNode
      if (!null? sNN) {
        def sN:CodeNode (unwrap sNN)
        this.writeTypeDef(sN ctx wr)
        return
      }
    }
    this.writeTypeDef(scrut ctx wr)
  }

  fn rustWriteUnionCase:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if ((array_length node.children) < 4) {
      return
    }
    def scrut:CodeNode (node.getSecond())
    def bind:CodeNode (itemAt node.children 2)
    def body:CodeNode (itemAt node.children 3)

    if ((node.hasFlag("match_arm")) == false) {
      ; a `case` written by hand, or a match a target could not prove complete:
      ; the `if let` this always emitted
      wr.out("if let " false)
      this.rustWriteScrutineeType(scrut ctx wr)
      wr.out((("::" + bind.type_name) + "(") false)
      this.WalkNode(bind ctx wr)
      wr.out(") = &" false)
      this.WalkNode(scrut ctx wr)
      wr.out(" { /* union case */" true)
      wr.indent(1)
      this.rustWriteCaseBody(body ctx wr)
      wr.indent(-1)
      wr.out("}" true)
      return
    }

    if (node.hasFlag("match_head")) {
      wr.out("match &" false)
      this.WalkNode(scrut ctx wr)
      wr.out(" {" true)
      wr.indent(1)
    }
    this.rustWriteScrutineeType(scrut ctx wr)
    wr.out((("::" + bind.type_name) + "(") false)
    this.WalkNode(bind ctx wr)
    wr.out(") => {" true)
    wr.indent(1)
    this.rustWriteCaseBody(body ctx wr)
    wr.indent(-1)
    wr.out("}" true)
    if (node.hasFlag("match_tail")) {
      ; an arm set that covers the shape but not the generated enum — a match
      ; over a GROUP — still needs the rest of the enum answered for
      if ((node.hasFlag("match_total")) == false) {
        wr.out("_ => {}" true)
      }
      wr.indent(-1)
      wr.out("}" true)
    }
  }

  fn rustWriteCaseBody:void (body:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def sCtx:RangerAppWriterContext (ctx.fork())
    sCtx.restartExpressionLevel()
    this.WalkNode(body sCtx wr)
  }
}

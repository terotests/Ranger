
class RangerImmutableExtension {

    fn typeDefOf:string (p:RangerAppParamDesc) {
        def nn (p.nameNode)
        if(p.value_type == RangerNodeType.Array) {
            return ("[" + nn.array_type + "]")
        }
        if(p.value_type == RangerNodeType.Hash) {
            return ("[" + nn.key_type+ ":" + nn.array_type + "]")
        }
        if(nn.value_type == RangerNodeType.Array) {
            return ("[" + nn.array_type + "]")
        }
        if(nn.value_type == RangerNodeType.Hash) {
            return ("[" + nn.key_type+ ":" + nn.array_type + "]")
        }
        return nn.type_name
    }

    ; class extension...
    fn createImmutableExtension:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext wr:CodeWriter) {
        def declaredVariable:[string:boolean]        
        ; wr.out("Import \"ImmutableCollections.clj\""  true)
        wr.out("extension " + cl.name + " {" , true)
        wr.indent(1)
        ; for extended classes TODO
        if ( ( array_length cl.extends_classes ) > 0 ) { 
            for cl.extends_classes pName:string i {
                def pC:RangerAppClassDesc (ctx.findClass(pName))
                for pC.variables pvar:RangerAppParamDesc i {
                    set declaredVariable pvar.name true
                    def nn:CodeNode (unwrap pvar.nameNode)
                }
            }
        }

        wr.out("fn __CopySelf:" + cl.name + " () {" , true)
        wr.indent(1)
        ; `(new C)` only works when the class has no constructor, or one that
        ; takes nothing. A record's generated constructor takes every field, and
        ; a hand-written one takes whatever it takes — either way `__CopySelf`
        ; used to emit `(new C)` and fail with "Not enough arguments for class
        ; constructor", pointing at generated code the author never wrote.
        ; `record R@(immutable)` could not be compiled at all.
        ;
        ; Construct through the constructor instead, passing each parameter the
        ; value of the field with the same name. That is exactly right for a
        ; record (buildRecordConstructor names the parameters after the fields)
        ; and right for the usual hand-written constructor; a parameter that
        ; names no field cannot be reconstructed, and says so.
        def ctorArgs@(mutable):string ""
        def ctorArity@(mutable):int 0
        def ctorUnknown@(mutable):string ""
        if (cl.is_record) {
            for cl.variables ivar:RangerAppParamDesc ii {
                if (ctorArity > 0) {
                    ctorArgs = (ctorArgs + " ")
                }
                ctorArgs = ((ctorArgs + "this.") + ivar.compiledName)
                ctorArity = (ctorArity + 1)
            }
        } {
            if (cl.has_constructor) {
                def cfn:RangerAppFunctionDesc (unwrap cl.constructor_fn)
                for cfn.params p:RangerAppParamDesc pi {
                    def matched@(mutable):boolean false
                    for cl.variables ivar:RangerAppParamDesc ii {
                        if (ivar.name == p.name) {
                            matched = true
                        }
                    }
                    if (matched == false) {
                        ctorUnknown = p.name
                    }
                    if (ctorArity > 0) {
                        ctorArgs = (ctorArgs + " ")
                    }
                    ctorArgs = ((ctorArgs + "this.") + p.name)
                    ctorArity = (ctorArity + 1)
                }
            }
        }

        if ((strlen ctorUnknown) > 0) {
            ctx.addError((unwrap cl.nameNode) ((("@(immutable) class " + cl.name) + " has a constructor parameter that names no field (") + ctorUnknown + ") — a copy cannot reconstruct it. Name the parameter after the field, or drop the constructor."))
        }

        if (ctorArity > 0) {
            wr.out(((("def res (new " + cl.name) + "(") + ctorArgs) + "))" , true)
        } {
            wr.out("def res (new " + cl.name + ")" , true)
            for cl.variables ivar:RangerAppParamDesc ii {
                wr.out("res."+ivar.compiledName + " = this." + ivar.compiledName , true)
            }
        }
        wr.out("return res" true)
        wr.indent(-1)
        wr.out("}" true)

        for cl.variables pvar:RangerAppParamDesc i {
            if( has declaredVariable pvar.name ) {
                continue
            }
            def nn:CodeNode (unwrap pvar.nameNode)

            if(true) {
;                print "Immutable type -> " + (this.typeDefOf(pvar))
                wr.out("fn set_" + pvar.name + ":" + cl.name + " (new_value_of_" + pvar.name + ":" + (this.typeDefOf(pvar)) + ") {" , true)
                wr.indent(1)
                wr.out("def res (this.__CopySelf())" , true)
                for cl.variables ivar:RangerAppParamDesc ii {
                    if( ivar == pvar ) {
                        wr.out("res."+pvar.compiledName + " = new_value_of_" + pvar.name , true)
                    } 
                }
                wr.out("return res" true)
                wr.indent(-1)
                wr.out("}" true)

;                print (wr.getCode())
            } {
                ; TODO: use immutable vector / map types instead
            }
        }        
        wr.indent(-1)
        wr.out("}" true)
    }
    
}

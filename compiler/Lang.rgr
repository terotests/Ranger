    commands {

        random        _:double () {
            templates {
                es6 ('Math.random()')
                llvm ( "(random)" )
                swift6 ( "Double.random(in: 0..<1)" )
                python ( "random.random()" (imp "random") )
                swift3 ( "(Double(arc4random()) / Double(UInt32.max))" (imp "Foundation") )
                kotlin ('Math.random()' (imp "java.lang.Math"))
                cpp ( "rg_random_double()" (imp "<random>")
(create_polyfill "
double rg_random_double() {
    static thread_local std::mt19937 _rg{std::random_device{}()};
    static thread_local std::uniform_real_distribution<double> _rd(0.0, 1.0);
    return _rd(_rg);
}
")
                )
                go ( 'rand.Float64()' (imp "math/rand") )
                ; std-only (rustc, no crates): each RandomState::new() draws a fresh
                ; OS-seeded key, so hashing a constant yields a varying 53-bit value.
                rust ( '{ use std::hash::{BuildHasher, Hasher}; let mut h = std::collections::hash_map::RandomState::new().build_hasher(); h.write_u64(0); ((h.finish() >> 11) as f64) / ((1u64 << 53) as f64) }' )
                ; One generator for the process. A fresh `new Random()` per call
                ; is seeded from the clock on .NET Framework and repeats inside
                ; a tick, which is the one bug a random number generator must
                ; not have.
                csharp ( "rg_random.NextDouble()"
(create_polyfill "
static readonly System.Random rg_random = new System.Random();
")
                )
                java7 ( "rg_random.nextDouble()"
(create_polyfill "
static final java.util.Random rg_random = new java.util.Random();
")
                )
                scala ( "scala.util.Random.nextDouble()" )
                php ( "(mt_rand() / mt_getrandmax())" )
                dart ( "rg_random.nextDouble()" (imp "dart:math")
(create_polyfill "
final Random rg_random = Random();
")
                )
            }
        }

        cast _:S  (arg:T target@(noeval):S) {
            templates {
                ranger ("(cast " (e 1) " " (e 2) ":" (typeof 2) " )")
                ts ( (e 1) " as " (typeof 2) )
                kotlin ( (e 1) " as " (typeof 2) )
                dart ( (e 1) " as " (typeof 2) )
                es6 ( (e 1) )
                java7 ( "((" (typeof 2) ")" (e 1) ")" )
                swift3 ( (e 1) " as " (typeof 2) "" )
                swift6 ( (e 1) " as " (typeof 2) "" )
                cpp ( "rg_cast<" (typeof 2) ">(" (e 1) ")"
                    (create_polyfill "
#include <memory>
#include <type_traits>
#include <variant>
// `cast` on the C++ target has two shapes to serve. A closed family is a
// std::variant, so the cast is std::get. A class hierarchy is a shared_ptr, so
// the cast is a pointer cast -- and a `weak` field reads through .lock() first.
// The template picks the one that compiles for the pair it is given; writing
// std::get for both put std::get<shared_ptr<Derived>>(shared_ptr<Base>) in the
// output, which is not a std::get at all.
template <class S> inline auto rg_shared_of_(const S& v, int) -> decltype(v.lock()) { return v.lock(); }
template <class S> inline S rg_shared_of_(const S& v, long) { return v; }
template <class S> inline auto rg_shared_of(const S& v) -> decltype(rg_shared_of_(v, 0)) { return rg_shared_of_(v, 0); }
template <class T, class S, class = void> struct rg_variant_holds : std::false_type {};
template <class T, class S> struct rg_variant_holds<T, S, std::void_t<decltype(std::get<T>(std::declval<const S&>()))>> : std::true_type {};
template <class T, class S> inline T rg_cast(const S& v) {
    if constexpr (rg_variant_holds<T, S>::value) {
        return std::get<T>(v);
    } else if constexpr (std::is_convertible<const S&, T>::value) {
        return (T)v;
    } else if constexpr (std::is_polymorphic<typename std::remove_reference<decltype(*rg_shared_of(v))>::type>::value) {
        return std::dynamic_pointer_cast<typename T::element_type>(rg_shared_of(v));
    } else {
        return std::static_pointer_cast<typename T::element_type>(rg_shared_of(v));
    }
}
")
                )
                ; through interface{} first: a type assertion is only legal on an
                ; INTERFACE, and the argument is often already concrete --
                ; `(cast (unwrap node.fnDesc) to:RangerAppFunctionDesc)` unwraps to a
                ; *RangerAppFunctionDesc and then asserted on it. The conversion is
                ; free and makes the form valid either way.
                go ( "(interface{}(" (e 1) ")).(" (typeof 2) ")" )
                php ( (e 1) )
                ; Python and Rust have no place to write the type: Python is
                ; dynamic, and a Rust struct is not a subtype of another one.
                ; The value passes through, which is what the es6 and the php
                ; entry already did.
                python ( (e 1) )
                rust ( (e 1) )
                csharp ( "((" (typeof 2) ")" (e 1) ")" )
                scala ( (e 1) ".asInstanceOf[" (typeof 2) "]" )
            }
        }        

        random        _:int ( min:int max:int) {
            templates {
                es6 ('Math.floor(Math.random()*(' (e 2) ' - ' (e 1)' + 1) + ' (e 1)')')
                swift6 ( "Int.random(in: " (e 1) " ... " (e 2) ")" )
                python ( "random.randint(" (e 1) ", " (e 2) ")" (imp "random") )
                swift3 ( "(" (e 1) " + Int(arc4random_uniform(UInt32(" (e 2) " - " (e 1) " + 1))))" (imp "Foundation") )
                kotlin ('(Math.floor(Math.random() * (' (e 2) ' - ' (e 1) ' + 1)).toInt() + ' (e 1) ')' (imp "java.lang.Math"))
                csharp ( "rg_random.Next(" (e 1) ", (" (e 2) ") + 1)"
(create_polyfill "
static readonly System.Random rg_random = new System.Random();
")
                )
                java7 ( "(" (e 1) " + rg_random.nextInt((" (e 2) " - " (e 1) ") + 1))"
(create_polyfill "
static final java.util.Random rg_random = new java.util.Random();
")
                )
                scala ( "(" (e 1) " + scala.util.Random.nextInt((" (e 2) " - " (e 1) ") + 1))" )
                php ( "mt_rand(" (e 1) ", " (e 2) ")" )
                dart ( "rg_random.nextInt((" (e 2) ") - (" (e 1) ") + 1) + (" (e 1) ")" (imp "dart:math")
(create_polyfill "
final Random rg_random = Random();
")
                )
            }
        }
        

        if_javascript _:void ( code:block ) @doc('run this code only in JavaScript') {
            templates {
                es6 ( (block 1))
                * ()
            }
        }

        if_go _:void ( code:block ) @doc('run this code only for Golang target') {
            templates {
                go ( (block 1))
                * ()
            }
        }

        if_java _:void ( code:block ) @doc('run this code only for Java target') {
            templates {
                java7 ( (block 1))
                * ()
            }
        }

        if_swift _:void ( code:block ) @doc('run this code only for Swift target') {
            templates {
                swift3 ( (block 1))
                swift6 ( (block 1))
                * ()
            }
        }

        if_php _:void ( code:block ) @doc('run this code only for PHP target') {
            templates {
                php ( (block 1))
                * ()
            }
        }

        if_cpp _:void ( code:block ) @doc('run this code only for C++ target') {
            templates {
                cpp ( (block 1))
                * ()
            }
        }

        if_csharp _:void ( code:block ) @doc('run this code only for C# target') {
            templates {
                csharp ( (block 1))
                * ()
            }
        }

        if_scala _:void ( code:block ) @doc('run this code only for Scala target') {
            templates {
                scala ( (block 1))
                * ()
            }
        }

        if_kotlin _:void ( code:block ) @doc('run this code only for Kotlin target') {
            templates {
                kotlin ( (block 1))
                * ()
            }
        }

        if_python _:void ( code:block ) @doc('run this code only for Python target') {
            templates {
                python ( (block 1))
                * ()
            }
        }

        if_rust _:void ( code:block ) @doc('run this code only for Rust target') {
            templates {
                rust ( (block 1))
                * ()
            }
        }

        if_dart _:void ( code:block ) @doc('run this code only for Dart target') {
            templates {
                dart ( (block 1))
                * ()
            }
        }

        has _:boolean (str:string) @doc('If string value is greater than > 0') {
            templates {
                * @macro(true) ('( (strlen ' (e 1) ') > 0 )')
            }
        }

        ; compiler options...
        has_option _:boolean ( name:string ) {
            templates {
                * @macro(true) ( "((strlen \"" (optional_option 1)  "\" ) > 0)")
            }
            doc "Returns true if compiler setting `name` has been enabled"
        }
        get_option _:string ( name:string ) {
            templates {
                * @macro(true) ( "\"" (optional_option 1)  "\"")
            }
            doc "Returns compiler setting `name`"
        }
        get_required_option _:string ( n:string ) {
            templates {
                * @macro(true) ( "\"" (required_option 1)  "\"")
            }
        }

        sha256 _:string (input:string) {
            templates {
                ranger ( "(sha256 " (e 1) ")")
                es6 ("require('crypto').createHash('sha256').update(" (e 1) ").digest('hex')")
                ; picosha2.h used to be DOWNLOADED at build time, so every C++
                ; program that hashed anything needed network access -- and the
                ; compiler itself hashes, so the C++ build of the compiler could
                ; not be produced offline. This is the same digest, in the
                ; output.
                cpp ( "rg_sha256_hex(" (e 1) ")"
                    (create_polyfill "
#include <string>
#include <vector>
#include <cstdint>
inline std::string rg_sha256_hex(const std::string& input) {
    static const uint32_t K[64] = {
        0x428a2f98u,0x71374491u,0xb5c0fbcfu,0xe9b5dba5u,0x3956c25bu,0x59f111f1u,0x923f82a4u,0xab1c5ed5u,
        0xd807aa98u,0x12835b01u,0x243185beu,0x550c7dc3u,0x72be5d74u,0x80deb1feu,0x9bdc06a7u,0xc19bf174u,
        0xe49b69c1u,0xefbe4786u,0x0fc19dc6u,0x240ca1ccu,0x2de92c6fu,0x4a7484aau,0x5cb0a9dcu,0x76f988dau,
        0x983e5152u,0xa831c66du,0xb00327c8u,0xbf597fc7u,0xc6e00bf3u,0xd5a79147u,0x06ca6351u,0x14292967u,
        0x27b70a85u,0x2e1b2138u,0x4d2c6dfcu,0x53380d13u,0x650a7354u,0x766a0abbu,0x81c2c92eu,0x92722c85u,
        0xa2bfe8a1u,0xa81a664bu,0xc24b8b70u,0xc76c51a3u,0xd192e819u,0xd6990624u,0xf40e3585u,0x106aa070u,
        0x19a4c116u,0x1e376c08u,0x2748774cu,0x34b0bcb5u,0x391c0cb3u,0x4ed8aa4au,0x5b9cca4fu,0x682e6ff3u,
        0x748f82eeu,0x78a5636fu,0x84c87814u,0x8cc70208u,0x90befffau,0xa4506cebu,0xbef9a3f7u,0xc67178f2u };
    uint32_t h[8] = { 0x6a09e667u,0xbb67ae85u,0x3c6ef372u,0xa54ff53au,0x510e527fu,0x9b05688cu,0x1f83d9abu,0x5be0cd19u };
    std::vector<unsigned char> msg(input.begin(), input.end());
    uint64_t bitlen = (uint64_t)msg.size() * 8;
    msg.push_back(0x80);
    while ((msg.size() % 64) != 56) { msg.push_back(0); }
    for (int i = 7; i >= 0; i--) { msg.push_back((unsigned char)((bitlen >> (i * 8)) & 0xff)); }
    for (size_t off = 0; off < msg.size(); off += 64) {
        uint32_t w[64];
        for (int i = 0; i < 16; i++) {
            w[i] = ((uint32_t)msg[off + i * 4] << 24) | ((uint32_t)msg[off + i * 4 + 1] << 16)
                 | ((uint32_t)msg[off + i * 4 + 2] << 8) | ((uint32_t)msg[off + i * 4 + 3]);
        }
        for (int i = 16; i < 64; i++) {
            uint32_t s0 = ((w[i-15] >> 7) | (w[i-15] << 25)) ^ ((w[i-15] >> 18) | (w[i-15] << 14)) ^ (w[i-15] >> 3);
            uint32_t s1 = ((w[i-2] >> 17) | (w[i-2] << 15)) ^ ((w[i-2] >> 19) | (w[i-2] << 13)) ^ (w[i-2] >> 10);
            w[i] = w[i-16] + s0 + w[i-7] + s1;
        }
        uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];
        for (int i = 0; i < 64; i++) {
            uint32_t S1 = ((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7));
            uint32_t ch = (e & f) ^ ((~e) & g);
            uint32_t t1 = hh + S1 + ch + K[i] + w[i];
            uint32_t S0 = ((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10));
            uint32_t mj = (a & b) ^ (a & c) ^ (b & c);
            uint32_t t2 = S0 + mj;
            hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
        }
        h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
    }
    static const char* hexd = \"0123456789abcdef\";
    std::string out;
    for (int i = 0; i < 8; i++) {
        for (int k = 3; k >= 0; k--) {
            unsigned char byte = (unsigned char)((h[i] >> (k * 8)) & 0xff);
            out.push_back(hexd[(byte >> 4) & 15]);
            out.push_back(hexd[byte & 15]);
        }
    }
    return out;
}

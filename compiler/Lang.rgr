                ranger ( "(error_msg   )")
                ; the value recover() returned -- the catch block the `try` writer
                ; emits binds it as `r`. This used to be the empty string, so a Go
                ; build reported "Unexpected compiler error" and nothing else.
                go ( "fmt.Sprintf(\"%v\", r)" (imp "fmt") )
                es6 ( "( e.toString())" )
                php ( "( $e->getMessage())" )
                java7 ( "( e.getMessage())" )
                cpp ( " \"unspecified error\" " )
                ; Dart has no `try` entry of its own and takes the `*` one, which
                ; binds `e`.
                dart ( "e.toString()" )
                ; The name each target binds in its catch clause. See the `try`
                ; operator: python binds `e`, swift binds the implicit `error`.
                python ( "str(e)" )
                kotlin ( "(e.message ?: e.toString())" )
                csharp ( "e.Message" )
                scala ( "e.getMessage" )
                swift3 ( "String(describing: error)" )
                swift6 ( "String(describing: error)" )
                ; Rust has no exceptions and the writer drops the catch block,
                ; so nothing reads this. It still needs a value of the type.
                rust ( "String::new()" )
            }
        }


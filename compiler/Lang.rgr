// Files on the C# target. System.IO says all of this, but each operator needs
// one expression and several need a try/catch, so they are wrapped here.
static class RgFiles {
  static string Join(string path, string name) {
    if (path.Length == 0) { return name; }
    return path + \"/\" + name;
  }
  // The optional this operator returns: null is how C# spells absent, which is
  // what a missing or unreadable file has to answer.
  public static string ReadFile(string path, string name) {
    try {
      return System.IO.File.ReadAllText(Join(path, name), new System.Text.UTF8Encoding(false));
    } catch (System.Exception) {
      return null;
    }
  }
  public static void WriteFile(string path, string name, string data) {
    string full = Join(path, name);
    string dir = System.IO.Path.GetDirectoryName(full);
    if (dir != null && dir.Length > 0) { System.IO.Directory.CreateDirectory(dir); }
    // No BOM: every other target writes plain UTF-8 and the compiler compares
    // its own output byte for byte.
    System.IO.File.WriteAllText(full, data, new System.Text.UTF8Encoding(false));
  }
  public static void CreateDir(string path) {
    try { System.IO.Directory.CreateDirectory(path); } catch (System.Exception) { }
  }
  public static bool DirExists(string path) {
    return System.IO.Directory.Exists(path);
  }
}

        default        cmdDefault:void          (  default_block:block )  {
            templates {
                ranger ( nl "default { " nl I (block 1) i nl "}" )
                scala ( nl "case _ => " nl I (block 1) nl i )
                go ( nl "default: " nl I (block 1) nl i )
                python ( nl "case _:" nl I "pass" nl (block 1) nl i )
                rust ( nl "_ => {" nl I (block 1) nl i "}" nl )
                ; (block 1), not (block 2): `default` takes ONE argument, so the
                ; else branch was written with an empty body -- every `switch`
                ; whose default did the work fell through silently. In the
                ; compiler that is the flow parser's dispatch, where the default
                ; clears a `b_found` that starts true: the Kotlin build declared
                ; the whole tree already handled, analysed nothing, and reported
                ; success while writing the source back out as bare tokens.
                kotlin ( nl "else  -> { " nl I (block 1) nl i "}" )
                java7 ( nl "default: " nl I (java_case 1) nl i )
                * ( nl "default: " nl I (block 1) nl "break;" i )
            }
        }
        



                (create_polyfill "
fun rg_write_file(path: String, name: String, data: String) {
  val full = if (path.isEmpty()) name else (path + \"/\" + name)
  val f = java.io.File(full)
  val parent = f.getParentFile()
  if (parent != null) { parent.mkdirs() }
  f.writeText(data, Charsets.UTF_8)
}

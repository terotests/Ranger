  const List<int> k = <int>[
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2];
  final List<int> h = <int>[
    0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
  const int mask = 0xffffffff;
  int rotr(int x, int n) => ((x >> n) | (x << (32 - n))) & mask;
  final List<int> msg = <int>[];
  for (final int c in input.runes) {
    if (c < 0x80) {
      msg.add(c);
    } else if (c < 0x800) {
      msg.add(0xc0 | (c >> 6));
      msg.add(0x80 | (c & 63));
    } else if (c < 0x10000) {
      msg.add(0xe0 | (c >> 12));
      msg.add(0x80 | ((c >> 6) & 63));
      msg.add(0x80 | (c & 63));
    } else {
      msg.add(0xf0 | (c >> 18));
      msg.add(0x80 | ((c >> 12) & 63));
      msg.add(0x80 | ((c >> 6) & 63));
      msg.add(0x80 | (c & 63));
    }
  }
  final int bitlen = msg.length * 8;
  msg.add(0x80);
  while ((msg.length % 64) != 56) { msg.add(0); }
  for (int i = 7; i >= 0; i--) { msg.add((bitlen >> (i * 8)) & 0xff); }
  final List<int> w = List<int>.filled(64, 0);
  for (int off = 0; off < msg.length; off += 64) {
    for (int i = 0; i < 16; i++) {
      w[i] = (msg[off + i * 4] << 24) | (msg[off + i * 4 + 1] << 16) |
             (msg[off + i * 4 + 2] << 8) | msg[off + i * 4 + 3];
    }
    for (int i = 16; i < 64; i++) {
      final int s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
      final int s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
      w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & mask;
    }
    int a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];
    for (int i = 0; i < 64; i++) {
      final int s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
      final int ch = (e & f) ^ ((~e & mask) & g);
      final int t1 = (hh + s1 + ch + k[i] + w[i]) & mask;
      final int s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
      final int mj = (a & b) ^ (a & c) ^ (b & c);
      final int t2 = (s0 + mj) & mask;
      hh = g; g = f; f = e; e = (d + t1) & mask; d = c; c = b; b = a; a = (t1 + t2) & mask;
    }
    h[0] = (h[0] + a) & mask; h[1] = (h[1] + b) & mask;
    h[2] = (h[2] + c) & mask; h[3] = (h[3] + d) & mask;
    h[4] = (h[4] + e) & mask; h[5] = (h[5] + f) & mask;
    h[6] = (h[6] + g) & mask; h[7] = (h[7] + hh) & mask;
  }
  final StringBuffer out = StringBuffer();
  for (final int v in h) { out.write(v.toRadixString(16).padLeft(8, '0')); }
  return out.toString();
}

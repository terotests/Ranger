func r_path_normalize(p string) string {
  s := strings.Replace(p, string(rune(92)), \"/\", -1)
  absolute := strings.HasPrefix(s, \"/\")
  trailing := len(s) > 1 && strings.HasSuffix(s, \"/\")
  parts := []string{}
  for _, cur := range strings.Split(s, \"/\") {
    if cur == \"..\" {
      if len(parts) > 0 && parts[len(parts)-1] != \"..\" {
        parts = parts[:len(parts)-1]
      } else if !absolute {
        parts = append(parts, cur)
      }
    } else if len(cur) > 0 && cur != \".\" {
      parts = append(parts, cur)
    }
  }
  out := strings.Join(parts, \"/\")
  if absolute {
    out = \"/\" + out
  }
  if len(out) == 0 {
    return \".\"
  }
  if trailing && out != \"/\" {
    out = out + \"/\"
  }
  return out
}
func r_path_dirname(p string) string {
  s := r_path_normalize(p)
  if len(s) > 1 && strings.HasSuffix(s, \"/\") {
    s = s[:len(s)-1]
  }
  pos := strings.LastIndex(s, \"/\")
  if pos < 0 {
    return \".\"
  }
  if pos == 0 {
    return \"/\"
  }
  return s[:pos]
}
// The directory the program was started from, which is where the compiler looks
// for its bundled Lang.rgr and stdops.rgr.
func r_install_directory() string {
  exe, err := os.Executable()
  if err != nil {
    return \".\"
  }
  return r_path_dirname(r_path_normalize(exe))

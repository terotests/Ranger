(create_polyfill '
// Returns the pos-th CODE POINT (as a UTF-8 substring) of str, counting
// code points not bytes. A naive scan restarts from byte 0 every call, so a
// caller that walks a string left to right -- a lexer over its source -- pays
// O(n) per character and O(n^2) over the whole string; a 200 KB source then
// takes tens of seconds. A tiny resume cache keyed on the string identity
// makes that forward walk O(1) amortized: a call for pos >= the last pos on
// the same string continues from the remembered (code-point -> byte) point
// instead of from the start. A backward seek (rare -- lexer backtracking)
// falls back to a full walk and re-primes the cache. The return value is
// identical to the naive scan; only the traversal is cheaper. Single-thread
// safe by construction (the interpreter is single-threaded); thread_local
// keeps it correct if that ever changes.
static inline int r_utf8_lead_len(unsigned char c)
{
    if (c <= 127) return 1;
    if ((c & 0xE0) == 0xC0) return 2;
    if ((c & 0xF0) == 0xE0) return 3;
    if ((c & 0xF8) == 0xF0) return 4;
    return 0; // invalid lead byte
}
std::string r_utf8_char_at(const std::string& str, int pos_i)
{
    if (pos_i < 0) return "";
    unsigned int pos = (unsigned int)pos_i;
    unsigned int ix = (unsigned int)str.length();
    static thread_local const char* c_data = nullptr;
    static thread_local size_t c_len = 0;
    static thread_local unsigned int c_pos = 0, c_byte = 0;
    unsigned int i, q;
    if (c_data == str.data() && c_len == str.length() && pos >= c_pos) {
        i = c_byte; q = c_pos;              // resume the forward walk
    } else {
        i = 0; q = 0;                        // cold, or a backward seek
    }
    for (; i < ix; i++, q++)
    {
        if (q == pos) {
            int char_len = r_utf8_lead_len((unsigned char) str[i]);
            if (char_len == 0) return "";
            c_data = str.data(); c_len = str.length(); c_pos = q; c_byte = i;
            return str.substr(i, char_len);
        }
        int w = r_utf8_lead_len((unsigned char) str[i]);
        if (w == 0) return "";
        i += (w - 1);
    }
    return "";
}

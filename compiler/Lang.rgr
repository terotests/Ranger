(create_polyfill
"
// Map read that never inserts on miss (unlike std::map::operator[]) and does a
// single lookup. Returns a default-constructed value (e.g. null shared_ptr)
// when the key is absent.
//
// A closed family (std::variant) is the one mapped_type with no null state:
// every alternative is a live value, so a default-constructed variant reads
// back as its FIRST alternative and a miss is indistinguishable from a genuine
// value of that case. For those maps the result carries the presence bit in
// r_optional_union; it converts back to the bare union, so a non-optional
// destination behaves exactly as it did before. Every other mapped_type keeps
// the original return type and body.
#include <variant>
// Defined next to the union typedefs when the program has a closed family. It
// is only ever named for a variant-valued map, so a declaration is enough here
// and a program with no shape at all still compiles.
template <class T> class r_optional_union;
template<typename T> struct r_map_result { typedef T type; };
template<typename... A> struct r_map_result<std::variant<A...>> {
    typedef r_optional_union<std::variant<A...>> type;
};
template<typename M, typename K>
typename r_map_result<typename M::mapped_type>::type r_map_get_val( const M & m , const K & key) {
    auto it = m.find(key);
    if ( it != m.end() ) { return it->second; }
    return typename r_map_result<typename M::mapped_type>::type();
}
"
)

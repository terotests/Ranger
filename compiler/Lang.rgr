double r_wall_clock_ms() {
    using namespace std::chrono;
    // std::milli (from <ratio>): libc++ does not put milli in chrono's
    // namespace for unqualified lookup the way libstdc++ often does.
    return duration<double, std::milli>(system_clock::now().time_since_epoch()).count();
}

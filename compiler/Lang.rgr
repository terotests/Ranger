// The same digest the other targets produce, spelled with the framework hash
// rather than a copy of the algorithm.
static class RgHash {
  public static string Sha256Hex(string input) {
    byte[] d;
    using (System.Security.Cryptography.SHA256 h = System.Security.Cryptography.SHA256.Create()) {
      d = h.ComputeHash(new System.Text.UTF8Encoding(false).GetBytes(input));
    }
    System.Text.StringBuilder o = new System.Text.StringBuilder();
    for (int i = 0; i < d.Length; i++) { o.Append(d[i].ToString(\"x2\")); }
    return o.ToString();
  }
}
")

            library _library
            mixin _mixin
            new _new
            on _on
            operator _operator
            part _part
            required _required
            rethrow _rethrow
            return _return
            set _set
            show _show
            static _static
            super _super
            switch _switch
            sync _sync
            this _this
            throw _throw
            try _try
            typedef _typedef
            var _var
            void _void
            while _while
            with _with
            yield _yield
        }
        rust {
            type r#type
            static r#static
            ref r#ref
            union r#union
            bool r#bool
            impl r#impl
        }
        swift3 {
            operator _operator
            static _static
            init _init
            guard _guard
        }
        swift6 {
            operator _operator
            static _static
            init _init
            ; `guard` is a statement keyword; a loop counter named `guard`
            ; must be renamed or the generated file does not parse.
            guard _guard
        }
        ; A name that is a keyword of the target has to be renamed, or the
        ; generated file does not parse. `def double (fn:int (n:int) ...)`
        ; wrote `LambdaSignature1 double = ...` on Java, which is a syntax
        ; error, and the same trap is open on C#, Scala and PHP.
        java7 {

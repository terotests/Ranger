"
func r_write_text_file(pathName string, fileName string, txtData string)  {
    f, e := os.Create(pathName + \"/\" + fileName)
    if e != nil {
        panic(e)
    }
    defer f.Close()

    _ , err := f.WriteString(txtData)
    if err != nil {
        panic(err)
    }
    f.Sync()
}

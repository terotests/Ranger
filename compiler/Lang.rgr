fun rg_sha256_hex(input: String): String {
  val d = java.security.MessageDigest.getInstance(\"SHA-256\").digest(input.toByteArray(Charsets.UTF_8))
  val sb = StringBuilder()
  for (b in d) { sb.append(String.format(\"%02x\", b)) }
  return sb.toString()
}

(create_polyfill "
func rangerStr2IntPrefix(_ s: String) -> Int? {
  var i = s.startIndex
  if i < s.endIndex && s[i] == \"-\" {
    i = s.index(after: i)
  }
  var end = i
  while end < s.endIndex && s[end].isNumber {
    end = s.index(after: end)
  }
  if end == i {
    return nil
  }
  return Int(s[i..<end])
}
")

fun rg_path_normalize(p: String): String {
  val s = p.replace(92.toChar(), '/')
  val absolute = s.startsWith(\"/\")
  val trailing = s.length > 1 && s.endsWith(\"/\")
  val parts = mutableListOf<String>()
  for (cur in s.split(\"/\")) {
    if (cur == \"..\") {
      if (parts.size > 0 && parts[parts.size - 1] != \"..\") {
        parts.removeAt(parts.size - 1)
      } else if (!absolute) {
        parts.add(cur)
      }
    } else if (cur.isNotEmpty() && cur != \".\") {
      parts.add(cur)
    }
  }
  var out = parts.joinToString(\"/\")
  if (absolute) { out = \"/\" + out }
  if (out.isEmpty()) { return \".\" }
  if (trailing && out != \"/\") { out = out + \"/\" }
  return out
}
fun rg_path_dirname(p: String): String {
  var s = rg_path_normalize(p)
  if (s.length > 1 && s.endsWith(\"/\")) { s = s.substring(0, s.length - 1) }
  val pos = s.lastIndexOf('/')
  if (pos < 0) { return \".\" }

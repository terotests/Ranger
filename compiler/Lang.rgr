        ; `replace` changes every occurrence. Half of the templates used to
        ; change only the first one -- JavaScript, Go, C++ and Python -- and the
        ; other half changed them all, so the same program gave two answers.
        ; The compiler itself wants every occurrence: the trigraph escaping of
        ; ng_RangerCppClassWriter.rgr calls `(replace s "??=" ...)` on a whole
        ; generated file.
        replace _:string (str:string oldStr:string newStr:string) {
            templates {
                ranger ( "(replace " (e 1) " " (e 2) " " (e 3) ")")
                es6 ( (e 1) ".split(" (e 2) ").join(" (e 3) ")" )
                java7 ( (e 1) ".replace(" (e 2) ", " (e 3) ")" )
                go ( "strings.Replace(" (e 1) ", " (e 2) ", " (e 3) ", -1)" (imp "strings"))
                php ( "str_replace(" (e 2) ", " (e 3) ", " (e 1) ")" )
                swift3 ( (e 1) ".replacingOccurrences(of: " (e 2) ", with: " (e 3) ")" )
                swift6 ( (e 1) ".replacingOccurrences(of: " (e 2) ", with: " (e 3) ")" )
                csharp ( (e 1) ".Replace(" (e 2) ", " (e 3) ")" )
                scala ( (e 1) ".replace(" (e 2) ", " (e 3) ")" )
                rust ( (e 1) ".replace(" (e 2) ", " (e 3) ")" )
                cpp ( "r_string_replace(" (e 1) ", " (e 2) ", " (e 3) ")"
(create_polyfill
"
std::string r_string_replace(std::string str, const std::string& from, const std::string& to) {
    if (from.empty()) {
        return str;
    }
    size_t pos = 0;
    while ((pos = str.find(from, pos)) != std::string::npos) {
        str.replace(pos, from.length(), to);
        pos += to.length();
    }
    return str;
}
" )
                )
                kotlin ( (e 1) ".replace(" (e 2) ", " (e 3) ")" )
                dart ( (e 1) ".replaceAll(" (e 2) ", " (e 3) ")" )
                python ( (e 1) ".replace(" (e 2) ", " (e 3) ")" )
            }
        }


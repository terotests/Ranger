// `sort` gives a new array and leaves the argument alone, and equal elements
// keep their order -- List<T>.Sort is in place AND unstable, so neither holds.
// OrderBy is documented stable and returns a new sequence.
static class RgSort {
  public static System.Collections.Generic.List<T> Copy<T>(System.Collections.Generic.List<T> v, System.Func<T, T, int> cb) {
    return System.Linq.Enumerable.ToList(
      System.Linq.Enumerable.OrderBy(v, x => x,
        System.Collections.Generic.Comparer<T>.Create((a, b) => cb(a, b))));
  }
}

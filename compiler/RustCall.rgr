          ctx.setInExpr()
          wr.suppress_expr_parens = true
          rust_writing_mut_arg = (this.rustArgIsPlainMutPath(nVal))
          this.WalkNode(nVal ctx wr)
          rust_writing_mut_arg = false
          wr.suppress_expr_parens = false
          ctx.unsetInExpr()
        } {
          ; Check for immutable borrow
          if needsImmutableBorrow {
            ; Parameter takes immutable reference - output & prefix; a
            ; string literal passes bare (the parameter is &str)
            if ((this.rustTryBareStrLitArg(nVal ctx wr)) == false) {
              if ((this.rustArgIsAlreadyRef(nVal)) == false) {
                wr.out("&" false)
              }
              ; a BORROWED shared parameter is `&Rc<RefCell<T>>`, so a raw
              ; value handed to one — `(new CodeWriter)` — takes its cell
              ; here: `&CodeWriter::new()` is a reference to the struct.
              def borrowNeedsRcWrap:boolean false
              if arg.rust_needs_rc_wrap {
                if ((this.rustInitRcState(nVal ctx)) == 0) {
                  borrowNeedsRcWrap = true
                }
              }
              if borrowNeedsRcWrap {
                wr.out("Rc::new(RefCell::new(" false)
              }
              ctx.setInExpr()
              wr.suppress_expr_parens = true
              this.WalkNode(nVal ctx wr)
              wr.suppress_expr_parens = false
              ctx.unsetInExpr()
              if borrowNeedsRcWrap {
                wr.out("))" false)
              }
              ; a SELF FIELD borrowed into a &mut-self call overlaps the
              ; receiver borrow (E0502) — hand a reference to a clone instead.
              ; A static-string field copies its &str out by value: no borrow
              ; survives, and .clone() on a Copy type is clippy's clone_on_copy
              if (is_self_call && (this.containsSelfReference(nVal))) {
                if ((this.rustStaticStrRead(nVal)) == false) {
                  wr.out(".clone()" false)
                }
              }
            }
          } {
          ; Standard case - target expects owned value
          ; Check if the SOURCE is a reference that needs to be cloned to convert to owned
          def source_is_reference:boolean false
          if (nVal.value_type == RangerNodeType.VRef) {
            if nVal.hasParamDesc {
              def srcParam:RangerAppParamDesc nVal.paramDesc
              ; If source parameter has rust_borrow_type > 0, it's a reference
              if (srcParam.rust_borrow_type > 0) {
                source_is_reference = true
              }
            }
          }
          
          ; Standard case - may need clone and/or Rc::new(RefCell::new()) for trait types
          ; But if value is already Rc<RefCell<dyn Trait>>, don't wrap or clone
          if value_is_already_boxed_trait {
            ; Already Rc<RefCell<dyn Trait>>, clone the Rc for shared ownership
            ctx.setInExpr()
            wr.suppress_expr_parens = true
            this.WalkNode(nVal ctx wr)
            wr.suppress_expr_parens = false
            ctx.unsetInExpr()
            wr.out(".clone()" false)
          } {
            ; `this` handed to a parameter of a CONCRETE class, from a method
            ; whose hidden receiver is typed as the trait object: the two are
            ; a downcast apart, and the value is known to be this very class.
            if (nVal.vref == "this") {
              if (arg_is_trait_type == false) {
                def thisDownTrait:string (this.rustSelfRcTraitName(ctx))
                if ((strlen thisDownTrait) > 0) {
                  if (this.rustClassIsShared(argNameN.type_name ctx)) {
                    if (argNameN.type_name != thisDownTrait) {
                      ; …unless the family is RE-ENTRANT, where the hidden
                      ; receiver is ALREADY the concrete class and there is
                      ; nothing to downcast from.
                      ; docs/plans/PLAN_RUST_REENTRANCY.md.
                      def tdClsO@(optional):RangerAppClassDesc (ctx.getCurrentClass())
                      def tdReentrant:boolean false
                      if (!null? tdClsO) {
                        def tdCls:RangerAppClassDesc (unwrap tdClsO)
                        tdReentrant = tdCls.rust_trait_reentrant
                      }
                      if tdReentrant {
                        wr.out("__self_rc.clone()" false)
                        continue _
                      }
                      wr.out((((("rg_downcast::<" + argNameN.type_name) + ", dyn ") + thisDownTrait) + "Trait>(__self_rc)") false)
                      continue _
                    }
                  }
                }
              }
            }
            ; Check if passing `this` to a trait-type parameter - this isn't supported
            ; because we can't create Rc<RefCell<Self>> from &mut self
            def is_passing_this_to_trait:boolean false
            if arg_is_trait_type {
              if (nVal.vref == "this") {
                is_passing_this_to_trait = true
              }
            }
            if is_passing_this_to_trait {
              ; The receiver's own Rc is available as __self_rc wherever the
              ; method uses `this` as a value -- and passing it to a
              ; trait-typed parameter is exactly that use, so
              ; computeSelfRcNeeds has marked the method. The clone coerces
              ; from Rc<RefCell<Concrete>> to Rc<RefCell<dyn XTrait>> at the
              ; argument, which is a coercion site. Without an Rc to hand
              ; over there is still nothing that can be done.
              def thisTraitName:string ""
              def ttNN@(optional):CodeNode arg.nameNode
              if (!null? ttNN) {
                def ttN:CodeNode (unwrap ttNN)
                thisTraitName = ttN.type_name
              }
              def haveSelfRc:boolean false
              def ttM@(optional):RangerAppFunctionDesc (ctx.getCurrentMethod())
              if (!null? ttM) {
                def ttF:RangerAppFunctionDesc (this.rustEnclosingMethod((unwrap ttM)))
                if ttF.rust_needs_self_rc {
                  haveSelfRc = true
                }
              }
              if ((haveSelfRc && ((strlen thisTraitName) > 0))) {
                wr.out((("(__self_rc.clone() as Rc<RefCell<dyn " + thisTraitName) + "Trait>>)") false)
              } {
                wr.out("panic!(\"Cannot pass 'this' to trait-type parameter in Rust. Object must be externally wrapped in Rc<RefCell<...>>\")" false)
              }
            } {
              ; Check if parameter needs Rc<RefCell<T>> wrap (for weak ref pattern)
              def needs_rc_wrap:boolean arg.rust_needs_rc_wrap
              
              ; BUT if the value being passed is already Rc<RefCell<...>> (has rust_needs_rc_wrap), don't double wrap
              def value_already_rc_wrapped:boolean false
              if needs_rc_wrap {
                if (nVal.value_type == RangerNodeType.VRef) {
                  if nVal.hasParamDesc {
                    def valParam:RangerAppParamDesc nVal.paramDesc
                    if valParam.rust_needs_rc_wrap {
                      value_already_rc_wrapped = true
                    }
                  }
                }
                ; an expression that already carries the Rc — an unwrap of a
                ; strong optional field, a call result — must not take a
                ; second cell around it
                if (value_already_rc_wrapped == false) {
                  if ((this.rustInitRcState(nVal ctx)) == 2) {
                    value_already_rc_wrapped = true
                  }
                }
              }
              
              if (arg_is_trait_type && (value_is_shared_subclass == false)) {
                wr.out("Rc::new(RefCell::new(" false)
              } {
                if (value_is_shared_subclass) {
                  wr.out("(" false)
                }
                if (needs_rc_wrap && (value_already_rc_wrapped == false)) {
                  ; Parameter is passed to a method that assigns to weak field
                  ; Wrap the argument in Rc::new(RefCell::new(...))
                  wr.out("Rc::new(RefCell::new(" false)
                }
              }
              ctx.setInExpr()
              wr.suppress_expr_parens = true
              this.WalkNode(nVal ctx wr)
              wr.suppress_expr_parens = false
              ctx.unsetInExpr()
              ; In Rust, values are moved when passed, so clone when passing a variable
              ; This applies to strings and objects (non-primitives)
              def arg_type:RangerNodeType argNameN.value_type
              if ((arg_type == RangerNodeType.Object) || (arg_type == RangerNodeType.VRef) || (arg_type == RangerNodeType.NoType)) {
                arg_type = (argNameN.typeNameAsType(ctx))
              }
              def needs_clone:boolean false
              if (argNameN.type_name == "string") {
                needs_clone = true
              }
              if (arg_type == RangerNodeType.Object) {
                needs_clone = true
              }
              ; In Rust, arrays and hashes need cloning to avoid move errors
              if ((arg_type == RangerNodeType.Array) || (arg_type == RangerNodeType.Hash) || (arg_type == RangerNodeType.IntBuffer) || (arg_type == RangerNodeType.DoubleBuffer) || (arg_type == RangerNodeType.CharBuffer) || (arg_type == RangerNodeType.Buffer)) {
                needs_clone = true
              }
              ; If source is a reference (&T or &mut T) but target expects owned T, must clone
              if source_is_reference {
                needs_clone = true
              }
              ; If value is already Rc<RefCell<...>>, clone it (for shared ownership)
              if value_already_rc_wrapped {
                wr.out(".clone()" false)
              } {
                if needs_clone {
                  if (this.rustArgIsNameRead(nVal)) {
                    if (this.rustStrRefRead(nVal)) {
                      wr.out(".to_string()" false)
                    } {
                      if (this.rustSliceRefRead(nVal)) {
                        wr.out(".to_vec()" false)
                      } {
                        wr.out(".clone()" false)
                      }
                    }
                  }
                }
              }
              ; Close the Rc::new(RefCell::new()) if we opened it
              if (arg_is_trait_type && (value_is_shared_subclass == false)) {
                wr.out("))" false)
              } {
                if (needs_rc_wrap && (value_already_rc_wrapped == false)) {
                  wr.out("))" false)
                }
                ; …or finish the unsizing coercion of a subclass handle
                if value_is_shared_subclass {
                  def subTraitName:string argNameN.type_name
                  wr.out(((".clone() as Rc<RefCell<dyn " + subTraitName) + "Trait>>)") false)
                }
              }
            }
          }
        }
        }
      }
      wr.out(")" false)
      this.closeSelfRcReceiverHoist(rgHoisted wr)
      rgHoisted = false
      if ((ctx.expressionLevel()) == 0) {
        wr.out(";" true)
      }
    }
  }

  fn writeNewCall (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if node.hasNewOper {
      def cl:RangerAppClassDesc (unwrap node.clDesc)
      def fc:CodeNode (node.getSecond())
      wr.out(cl.name false)
      wr.out("::new(" false)
      def constr@(optional):RangerAppFunctionDesc cl.constructor_fn
      def givenArgs:CodeNode (node.getThird())
      if (!null? constr) {
        def c:RangerAppFunctionDesc (unwrap constr)
        ; A keyword marker of a record constructor names the field and carries
        ; no value. The signature drops it, so the call drops it as well.
        def written 0
        for c.params arg:RangerAppParamDesc i {
          def argumentName:CodeNode (unwrap arg.nameNode)
          if (argumentName.hasFlag("keyword")) {
            continue
          }
          def n:CodeNode (itemAt givenArgs.children i)
          if (written > 0) {
            wr.out(", " false)
          }
          written = written + 1
          ; a constructor parameter of a shared class holds the Rc, and a
          ; `new` on the right hands back the bare struct — `(new CodeNode
          ; (new SourceCode "") 0 0)` passed a SourceCode where the field
          ; wants Rc<RefCell<SourceCode>>
          def ctorArgNN:CodeNode (unwrap arg.nameNode)
          def ctorArgWrap:boolean false
          if (((strlen ctorArgNN.array_type) == 0) && ((strlen ctorArgNN.key_type) == 0)) {
            if (this.rustClassIsShared(ctorArgNN.type_name ctx)) {
              if ((this.rustInitRcState(n ctx)) == 0) {
                ctorArgWrap = true
              }
            }
          }
          if ctorArgWrap {
            wr.out("Rc::new(RefCell::new(" false)
          }
          this.WalkNode(n ctx wr)
          if ctorArgWrap {
            wr.out("))" false)
          }
          ; In Rust, values are moved when passed, so clone when passing a variable
          def argNameN:CodeNode (unwrap arg.nameNode)
          def arg_type:RangerNodeType argNameN.value_type
          if ((arg_type == RangerNodeType.Object) || (arg_type == RangerNodeType.VRef) || (arg_type == RangerNodeType.NoType)) {
            arg_type = (argNameN.typeNameAsType(ctx))
          }
          def needs_clone:boolean false
          if (argNameN.type_name == "string") {
            needs_clone = true
          }
          if (arg_type == RangerNodeType.Object) {
            needs_clone = true
          }
          ; In Rust, arrays and hashes need cloning to avoid move errors
          if ((arg_type == RangerNodeType.Array) || (arg_type == RangerNodeType.Hash) || (arg_type == RangerNodeType.IntBuffer) || (arg_type == RangerNodeType.DoubleBuffer) || (arg_type == RangerNodeType.CharBuffer) || (arg_type == RangerNodeType.Buffer)) {
            needs_clone = true
          }
          if needs_clone {
            if (this.rustArgIsNameRead(n)) {
              if (this.rustStrRefRead(n)) {
                wr.out(".to_string()" false)
              } {
                if (this.rustSliceRefRead(n)) {
                  wr.out(".to_vec()" false)
                } {
                  wr.out(".clone()" false)
                }
              }
            }
          }
        }
      }
      wr.out(")" false)
    }
  }

  fn rustHoistFieldReceiver:void (real:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    if (real.hasFnCall == false) {
      return
    }
    def hrFc:CodeNode (real.getFirst())
    if ((strlen hrFc.rust_use_tmpvar) > 0) {
      return
    }
    def hrLen:int (array_length hrFc.ns)
    if (hrLen < 2) {
      return
    }
    if ((array_length hrFc.nsp) < (hrLen - 1)) {
      return
    }
    def hrD:RangerAppParamDesc (itemAt hrFc.nsp (hrLen - 2))
    if (hrD.is_class_variable == false) {
      return
    }
    if (hrD.rust_needs_rc_wrap == false) {
      return
    }
    def hrNNO@(optional):CodeNode hrD.nameNode
    if (null? hrNNO) {
      return
    }
    def hrNN:CodeNode (unwrap hrNNO)
    if (((strlen hrNN.array_type) > 0) || ((strlen hrNN.key_type) > 0)) {
      return
    }
    ; only a one-field reach: `this.a.b.m(…)` would need the whole prefix
    if (hrLen > 3) {
      return
    }
    if (hrLen == 3) {
      if ((itemAt hrFc.ns 0) != "this") {
        return
      }
    }
    def hrTmp:string (ctx.rustGetTempVar())
    wr.out((("let " + hrTmp) + " = ") false)
    wr.out(((this.rustThisPathPrefix(ctx)) + ".") false)
    if ((strlen hrD.compiledName) > 0) {
      wr.out((this.adjustType(hrD.compiledName)) false)
    } {
      wr.out((this.adjustType(hrD.name)) false)
    }
    wr.out(".clone()" false)
    if hrD.is_optional {
      wr.out(".unwrap()" false)
    }
    wr.out(";" true)
    hrFc.rust_use_tmpvar = hrTmp
  }

  fn rustExtractSelfCallConflicts:void (node:CodeNode ctx:RangerAppWriterContext wr:CodeWriter) {
    def real:CodeNode (this.rustUnwrapParens(node))
    this.rustHoistFieldReceiver(real ctx wr)
    ; EVERY call, not only one written `this.m(…)`. A borrow held in an
    ; argument is held for the whole call whoever the receiver is, and
    ; `editor.beginTextEdit(sh.editId)` — a bare member receiver — held a
    ; Ref on `sh` while the callee looked the same shape up by that id and
    ; wrote to it.
    if real.hasFnCall {
      def cArgs:CodeNode (real.getSecond())
      for cArgs.children cA:CodeNode cI {
        def cReal:CodeNode (this.rustUnwrapParens(cA))
        ; …and so does a plain field path READ THROUGH one of this object's
        ; own Rc fields — `this.irModule.ptrType` makes a Ref that lives to
        ; the end of the statement, which is past the point the call takes
        ; its `&mut self` (E0502). Only a bare path, no call: hoisting
        ; anything that merely mentions `this` was measured at 12 -> 88.
        def cNeedsTmp:boolean (this.isSelfMethodCall(cReal))
        def cIsPathRead:boolean false
        if (cNeedsTmp == false) {
          if (cReal.hasFnCall == false) {
            if ((array_length cReal.ns) >= 3) {
              if ((itemAt cReal.ns 0) == "this") {
                if ((array_length cReal.nsp) >= 2) {
                  def cSeg:RangerAppParamDesc (itemAt cReal.nsp 1)
                  if cSeg.rust_needs_rc_wrap {
                    cNeedsTmp = true
                    cIsPathRead = true
                  }
                }
              }
            }
            ; …and a field read through ANY handle, not only one of this
            ; object's: `this.editor.beginTextEdit(sh.editId)` holds a Ref on
            ; `sh` for the whole call, and the callee looks the same shape up
            ; by that id and writes to it. No borrow may be held ACROSS a
            ; call — the callee's reach is not something the caller can see.
            if (cNeedsTmp == false) {
              if ((array_length cReal.ns) >= 2) {
                def cRootRc:boolean false
                if ((array_length cReal.nsp) >= 1) {
                  def cRoot:RangerAppParamDesc (itemAt cReal.nsp 0)
                  if cRoot.rust_needs_rc_wrap {
                    cRootRc = true
                  }
                }
                ; the path descs are filled only where the front end resolved
                ; the whole path; the name itself always answers
                if (cRootRc == false) {
                  def cRootName:string (itemAt cReal.ns 0)
                  if (ctx.isVarDefined(cRootName)) {
                    def cRootD:RangerAppParamDesc (ctx.getVariableDef(cRootName))
                    if cRootD.rust_needs_rc_wrap {
                      cRootRc = true
                    }
                  }
                }
                if cRootRc {
                  cNeedsTmp = true
                  cIsPathRead = true
                }
              }
            }
          }
        }
        ; …and in a RECEIVERLESS method every `this.field` read is a
        ; `__self_rc.borrow()` whose Ref lives to the END OF THE STATEMENT —
        ; past the point the callee takes its own borrow_mut. `def c (this
        ; .addControl(id kind text rowH))` panicked on the first dialog the
        ; page opened. rustc cannot see this one: the borrows are of a
        ; RefCell, not of the struct.
        if (cNeedsTmp == false) {
          if rust_receiverless_method {
            if (cReal.hasFnCall == false) {
              if ((array_length cReal.ns) >= 2) {
                if ((itemAt cReal.ns 0) == "this") {
                  cNeedsTmp = true
                  cIsPathRead = true
                }
              }
              ; a bare member name is the same read, spelled shorter
              if ((array_length cReal.ns) == 1) {
                if cReal.hasParamDesc {
                  def cBareP:RangerAppParamDesc cReal.paramDesc
                  if cBareP.is_class_variable {
                    cNeedsTmp = true
                    cIsPathRead = true
                  }
                }
              }
            }
          }
        }
        ; …but an OUT parameter — one the callee takes by `&mut` — must stay
        ; the PLACE it names. Hoisting `slide.shapes` into a local and
        ; handing `&mut` that pushed every parsed shape into a copy nobody
        ; read again: the deck came back as five empty slides.
        if cNeedsTmp {
          if (this.rustArgIsOutParam(real cI)) {
            cNeedsTmp = false
          }
        }
        if cNeedsTmp {
          this.rustExtractSelfCallConflicts(cReal ctx wr)
          def cTmp:string (ctx.rustGetTempVar())
          ; `let mut`, because the value may go on to a `&mut` parameter —
          ; the crate allows unused_mut, so this costs nothing where it does
          ; not
          wr.out((("let mut " + cTmp) + " = ") false)
          ctx.setInExpr()
          this.WalkNode(cReal ctx wr)
          ctx.unsetInExpr()
          ; a hoisted field READ is still a read out of a Ref: it owns its
          ; value or it moves out of the cell (E0507), and a str reference
          ; becomes the owned String the parameter is declared with
          if cIsPathRead {
            if (this.rustStrRefRead(cReal)) {
              wr.out(".to_string()" false)
            } {
              wr.out(".clone()" false)
            }
          }
          wr.out(";" true)
          cA.rust_use_tmpvar = cTmp
        }
        ; …and an argument that is not a self call but CARRIES one further
        ; down keeps the same conflict: only the nested call moves out, so an
        ; index stays the place it names and nothing is moved out of it.
        def cArgScoped:boolean false
        if (this.rustNodeIsLambda(cA)) {
          cArgScoped = true
        }
        if cA.is_block_node {
          cArgScoped = true
        }
        if cA.has_lambda {
          cArgScoped = true
        }
        if cA.has_lambda_call {
          cArgScoped = true
        }
        if (cNeedsTmp || cArgScoped) {
        } {
          def cNested:[CodeNode]
          this.rustCollectNestedSelfCalls(cReal cNested)
          for cNested nA:CodeNode nI {
            if ((strlen nA.rust_use_tmpvar) == 0) {
              ; the nested call's OWN arguments may carry the same conflict
              this.rustExtractSelfCallConflicts(nA ctx wr)
              def nTmp:string (ctx.rustGetTempVar())
              wr.out((("let mut " + nTmp) + " = ") false)
              ctx.setInExpr()
              this.WalkNode(nA ctx wr)
              ctx.unsetInExpr()
              wr.out(";" true)
              nA.rust_use_tmpvar = nTmp
            }
          }
        }
      }
      ; a self call has no receiver of its own to hoist, and its arguments
      ; are now all accounted for
      if (this.isSelfMethodCall(real)) {
        return
      }
    }
    ; …and a call whose ARGUMENT reads through its own RECEIVER borrows one
    ; cell twice in a single expression — `p.changeStrength(1 1 p.nameNode)`
    ; is `p.borrow_mut().changeStrength(1, 1, p.borrow().…)`, which panics
    ; the moment it runs. The argument goes to a temporary first.
    def rcvName:string ""
    def rcvArgsOpt@(optional):CodeNode
    if real.has_call {
      if ((array_length real.children) >= 4) {
        rcvArgsOpt = (itemAt real.children 3)
        def rcvObj:CodeNode (real.getSecond())
        ; the ROOT of the receiver path is the name the call reads through —
        ; `ch.ctx.m(…)` borrows `ch` for as long as the statement lasts
        if (rcvObj.expression == false) {
          if ((array_length rcvObj.ns) > 0) {
            rcvName = (itemAt rcvObj.ns 0)
          }
        }
      }
    }
    ; the resolved shape: `(fnRef args)` with the receiver at the head of the
    ; reference's path. Tried whenever the shape above produced no argument
    ; list — a node can carry has_call and still be spelled this way, and then
    ; no argument was ever examined.
    if (null? rcvArgsOpt) {
      if real.hasFnCall {
        if ((array_length real.children) >= 2) {
          def rcvFc:CodeNode (real.getFirst())
          if ((array_length rcvFc.ns) >= 2) {
            rcvName = (itemAt rcvFc.ns 0)
          }
          rcvArgsOpt = (real.getSecond())
        }
      }
    }
    if (!null? rcvArgsOpt) {
      def rcvArgs:CodeNode (unwrap rcvArgsOpt)
      ; the names this call hands over WHOLE — the receiver and any argument
      ; that is a bare name. An argument that instead reads a field THROUGH
      ; one of them borrows the same cell a second way, and the Ref it makes
      ; lives to the end of the statement: `f(&item.borrow().name, item)` is
      ; a shared borrow still live when the callee takes a mutable one.
      def aliasNames:[string]
      if ((strlen rcvName) > 0) {
        if (rcvName != "this") {
          push aliasNames rcvName
        }
      }
      for rcvArgs.children aA:CodeNode aI {
        if (aA.expression == false) {
          if ((array_length aA.ns) == 1) {
            def aN:string (itemAt aA.ns 0)
            if (aN != "this") {
              push aliasNames aN
            }
          }
        }
      }
      for rcvArgs.children rA:CodeNode rI {
        ; a closure LITERAL is never hoisted: out of the call it has no
        ; expected type left to infer its parameters from
        if ((strlen rA.rust_use_tmpvar) == 0) {
          def rHoist:boolean false
          if (this.rustNodeIsLambda(rA)) {
            rHoist = false
          } {
          for aliasNames anName:string anI {
            if (rHoist == false) {
              if (this.rustExprReadsThrough(rA anName)) {
                rHoist = true
              }
            }
          }
          }
          if rHoist {
            def rTmp:string (ctx.rustGetTempVar())
            wr.out((("let " + rTmp) + " = ") false)
            ctx.setInExpr()
            this.WalkNode(rA ctx wr)
            ctx.unsetInExpr()
            ; the temporary has to OWN what it holds: the Ref it was read
            ; through is gone by the time the call runs
            if (this.rustStrRefRead(rA)) {
              wr.out(".to_string()" false)
            } {
              if (this.rustArgIsNameRead(rA)) {
                wr.out(".clone()" false)
              }
            }
            wr.out(";" true)
            rA.rust_use_tmpvar = rTmp
          }
        }
      }
    }
    for real.children ch:CodeNode chI {
      ; …but never INTO a closure: its body runs where the closure is called,
      ; and a `let` lifted out of one lands where the closure's parameters do
      ; not exist
      if ((this.rustNodeIsLambda(ch)) == false) {
        this.rustExtractSelfCallConflicts(ch ctx wr)
      }
    }
  }

  fn rustTailBorrowsLocal:boolean (node:CodeNode) {
    if ((array_length node.ns) >= 2) {
      if ((itemAt node.ns 0) != "this") {
        for node.nsp seg:RangerAppParamDesc si {
          if seg.rust_needs_rc_wrap {
            if (seg.is_class_variable == false) {
              return true
            }
          }
        }
      }
    }
    ; …and the dotted form of the same call, `measurer.measureText(…)`,
    ; whose receiver lives inside the name rather than in a node of its own
    if node.hasFnCall {
      if ((array_length node.children) > 0) {
        def tbFc:CodeNode (node.getFirst())
        def tbLen:int (array_length tbFc.ns)
        if (tbLen >= 2) {
          def tbIdx:int 0
          if ((itemAt tbFc.ns 0) == "this") {
            tbIdx = 1
          }
          if (tbIdx <= (tbLen - 2)) {
            if ((array_length tbFc.nsp) > tbIdx) {
              def tbSeg:RangerAppParamDesc (itemAt tbFc.nsp tbIdx)
              if tbSeg.rust_needs_rc_wrap {
                return true
              }
            }
          }
        }
      }
    }
    ; a method call on a local Rc receiver: the borrow_mut() temporary of
    ; the tail expression outlives the local it borrows (E0597)
    if node.has_call {
      def hcObj:CodeNode (node.getSecond())
      if hcObj.hasParamDesc {
        def hcP:RangerAppParamDesc hcObj.paramDesc
        ; …a FIELD too, when it holds an Rc: the receiver is hoisted into a
        ; local of this frame first, and the tail expression's borrow of it
        ; outlives that local
        if hcP.rust_needs_rc_wrap {
          return true
        }
      }
    }
    for node.children ch:CodeNode ci {
      if (this.rustTailBorrowsLocal(ch)) {
        return true
      }
    }
    return false
  }

  fn walkRustFnBody:void (fnB:CodeNode sCtx:RangerAppWriterContext wr:CodeWriter) {
    def bcnt:int (array_length fnB.children)
    if (bcnt > 0) {
      def lastStmt:CodeNode (itemAt fnB.children (bcnt - 1))
      lastStmt.rust_is_tail_return = true
      def lmark:CodeNode (this.rustUnwrapParens(lastStmt))
      lmark.rust_is_tail_return = true
    }
    this.WalkNode(fnB sCtx wr)
  }

  fn rustIsSelfCallNode:boolean (n:CodeNode) {
    if (this.isSelfMethodCall(n)) {
      return true
    }
    if n.has_call {
      if ((array_length n.children) >= 3) {
        def hcObj:CodeNode (n.getSecond())
        if (hcObj.vref == "this") {
          return true
        }
      }
    }
    return false
  }

}

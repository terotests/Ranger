Import "ng_SourceMap.rgr"

class CodeFile {
    def path_name:string ""
    def name:string ""
    def writer@(optional):CodeWriter
    def import_list:[string:string]
    def import_names:[string]
    def fileSystem@(weak):CodeFileSystem
    def sourceMapBuilder@(optional):SourceMapBuilder

    Constructor (filePath:string fileName:string) {
        name = fileName
        path_name = filePath
        writer = (new CodeWriter())
        writer.createTag("imports")
    }

    ; The flag is passed in rather than read back off `fileSystem`: the
    ; caller is the file system itself, and on Rust it is inside its own
    ; cell for the duration of the call that creates this file — reaching
    ; back through the weak reference borrows that cell a second time.
    fn initSourceMapsIfNeeded:void (mapsEnabled:boolean) {
        if (!null? sourceMapBuilder) {
            return
        }
        if (null? fileSystem) {
            return
        }
        if (mapsEnabled == false) {
            return
        }
        sourceMapBuilder = (new SourceMapBuilder ())
        def wr@(optional):CodeWriter writer
        if (!null? wr) {
            ; Bind before calling: a statement starting with a parenthesised
            ; receiver silently swallows the rest of its block (ISSUES.md #65).
            def w:CodeWriter (unwrap wr)
            w.enableSourceMaps((unwrap sourceMapBuilder))
        }
    }

    fn addImport:void (import_name:string) {
        if (false == (has import_list import_name)) {
            set import_list import_name import_name
            push import_names import_name
        }
    }

    fn rewrite (newString:string ) {
        writer.rewrite(newString)
    }
    
    fn testCreateWriter@(strong):CodeWriter () {
        return (new CodeWriter ())
    }

    fn getImports@(weak):[string] () {
        return import_names
    }

    fn getWriter@(weak optional):CodeWriter () {
        writer.ownerFile = this
        return writer
    }

    fn getCode:string () {
        return (writer.getCode())
    }

}

class CodeFileSystem {
    def files:[CodeFile]
    def sourceMapsEnabled:boolean false

    fn enableSourceMaps:void () {
        sourceMapsEnabled = true
    }

    fn shouldWriteSourceMaps:boolean () {
        return sourceMapsEnabled
    }

    fn getFile@(weak):CodeFile (path:string name:string) {
        for files file:CodeFile idx {
            if ( (file.path_name == path) && (file.name == name) ) {
                return file
            }
        }
        def new_file:CodeFile (new CodeFile (path name))
        new_file.fileSystem = this
        new_file.initSourceMapsIfNeeded(sourceMapsEnabled)
        push files new_file
        return new_file
    }

    fn mkdir:void (path:string) {
        def parts:[string] (strsplit path "/")
        def curr_path:string ""
        for parts p:string i {
            curr_path = curr_path + p + "/"
            if (false == (dir_exists curr_path)) {
                create_dir curr_path
            }
        }
    }

    fn isJsOutputFile:boolean (fileName:string) {
        if (endsWith fileName ".js") {
            return true
        }
        if (endsWith fileName ".ts") {
            return true
        }
        return false
    }

    fn saveTo:void (path:string verbose:boolean) {
        print "Saving results to path : " + path         
        for files file:CodeFile idx {
            def file_path:string (path + "/" + file.path_name)
            this.mkdir(file_path)
            if( verbose ) {
                print "Writing to file " + file_path + "/" + file.name
            }
            def file_content:string (file.getCode())
            if ((strlen file_content) > 0) {
                def outName:string (trim file.name)
                def writeSourceMap:boolean false
                if (this.shouldWriteSourceMaps()) {
                    if (this.isJsOutputFile(outName)) {
                        if (!null? file.sourceMapBuilder) {
                            def builder:SourceMapBuilder (unwrap file.sourceMapBuilder)
                            if (builder.hasMappings()) {
                                writeSourceMap = true
                                file_content = file_content + "\n//# sourceMappingURL=" + outName + ".map\n"
                            }
                        }
                    }
                }
                write_file file_path outName file_content
                if (writeSourceMap) {
                    def builder2:SourceMapBuilder (unwrap file.sourceMapBuilder)
                    def mapJson:string (builder2.toJSON(outName))
                    write_file file_path (outName + ".map") mapJson
                    if (verbose) {
                        print "Writing source map " + file_path + "/" + outName + ".map"
                    }
                }
            }
        }
    }
}

class CodeSlice {

    def code:string ""
    def writer@(optional):CodeWriter 

    fn getCode:string () {
        if (null? writer) {
            return code
        }
        return (writer.getCode())
    }

}

class CodeWriter {
    def tagName:string ""
    ; one-shot: the next operator emission is already delimited by the
    ; caller (its own parens, or a call-argument slot), so the expression
    ; walker must not add a pair of its own
    def suppress_expr_parens:boolean false
    ; scoped to the operator currently being emitted: true when its caller
    ; already delimits it, so a custom handler skips its own outer pair
    def current_op_no_parens:boolean false
    ; inside a format!/println! argument slot: a Display value needs no
    ; .to_string() there
    def in_format_args:boolean false
    def codeStr:string ""
    def currentLine:string ""
    def tabStr:string "  "
    def nlStr "\n"
    def lineNumber:int 0
    def columnNumber:int 0
    def indentAmount:int 0

    def compiledTags:[string:boolean]
    def tags:[string:int]
    def slices:[CodeSlice]
    def current_slice@(weak optional):CodeSlice
    def ownerFile@(weak optional):CodeFile
    def forks:[CodeWriter]

    def tagOffset:int 0 
    def parent@(weak):CodeWriter

    def had_nl:boolean true

    def sourceMapsEnabled:boolean false
    def sourceMapBuilder@(optional weak):SourceMapBuilder
    def mappingNodeStack:[CodeNode]
    def mappingNameStack:[string]
    def walkNodeStack:[CodeNode]

    static fn emptyWithFS:CodeWriter () {
        def wr@(temp) (new CodeWriter)
        def file@(temp lives) (new CodeFile ("." "emptyFile.txt"))
        file.writer = wr
        file.fileSystem = (new CodeFileSystem)
        wr.ownerFile = file
        return wr
    }
 
    Constructor() {
        def new_slice:CodeSlice (new CodeSlice ())
        push slices new_slice
        current_slice = new_slice
    }

    fn rewrite (newString:string ) {
        clear slices
        clear forks
        currentLine = ""
        lineNumber = 0
        columnNumber = 0
        def new_slice:CodeSlice (new CodeSlice ())
        push slices new_slice
        new_slice.code = newString
        current_slice = new_slice
    }

    fn enableSourceMaps:void (builder:SourceMapBuilder) {
        sourceMapsEnabled = true
        sourceMapBuilder = builder
    }

    fn getActiveSourceMapBuilder@(weak optional):SourceMapBuilder () {
        if (sourceMapsEnabled && (!null? sourceMapBuilder)) {
            return sourceMapBuilder
        }
        if (!null? parent) {
            return (parent.getActiveSourceMapBuilder())
        }
        return sourceMapBuilder
    }

    fn pushMappingNode:void (node:CodeNode name:string) {
        push mappingNodeStack node
        push mappingNameStack name
    }

    fn popMappingNode:void () {
        if ((array_length mappingNodeStack) > 0) {
            removeLast mappingNodeStack
        }
        if ((array_length mappingNameStack) > 0) {
            removeLast mappingNameStack
        }
    }

    fn getCurrentMappingNode@(weak optional):CodeNode () {
        def emptyNode@(weak optional):CodeNode
        if ((array_length mappingNodeStack) == 0) {
            return emptyNode
        }
        def current@(weak optional):CodeNode (itemAt mappingNodeStack ((array_length mappingNodeStack) - 1))
        return current
    }

    fn getCurrentMappingName:string () {
        if ((array_length mappingNameStack) == 0) {
            return ""
        }
        return (itemAt mappingNameStack ((array_length mappingNameStack) - 1))
    }

    fn pushWalkNode:void (node:CodeNode) {
        push walkNodeStack node
    }

    fn popWalkNode:void () {
        if ((array_length walkNodeStack) > 0) {
            removeLast walkNodeStack
        }
    }

    fn getCurrentWalkNode@(weak optional):CodeNode () {
        def emptyNode@(weak optional):CodeNode
        if ((array_length walkNodeStack) > 0) {
            def current@(weak optional):CodeNode (itemAt walkNodeStack ((array_length walkNodeStack) - 1))
            return current
        }
        if (!null? parent) {
            return (parent.getCurrentWalkNode())
        }
        return emptyNode
    }

    fn recordCurrentMapping:void () {
        def builder@(optional):SourceMapBuilder (this.getActiveSourceMapBuilder())
        if (null? builder) {
            return
        }
        def node@(weak optional):CodeNode (this.getCurrentMappingNode())
        if (null? node) {
            node = (this.getCurrentWalkNode())
        }
        if (null? node) {
            return
        }
        def mapName:string (this.getCurrentMappingName())
        builder.addMappingFromNode(lineNumber columnNumber (unwrap node) mapName)
    }

    fn outMapped:void (str:string node:CodeNode newLine:boolean name:string) {
        this.pushMappingNode(node name)
        this.out(str newLine)
        this.popMappingNode()
    }

    fn getFilesystem:CodeFileSystem () {
        if( null? ownerFile ) {
            if(!null? parent) {
                return (parent.getFilesystem())
            }
            return (new CodeFileSystem())
        }
        def fs:CodeFileSystem ownerFile.fileSystem
        return (unwrap fs)       
    }

    fn getFileWriter:CodeWriter (path:string fileName:string) {
        if( null? ownerFile ) {
            if(!null? parent) {
                return (parent.getFileWriter(path fileName))
            }
            ; functions should be able to raise exceptions too
            ; throw "File writer not defined"
        }
        def fs:CodeFileSystem ownerFile.fileSystem
        def file:CodeFile (fs.getFile(path fileName))
        def wr@(optional):CodeWriter (file.getWriter())
        return (unwrap wr)
    }

    fn getImports@(weak):[string] () {

        def p:CodeWriter this
        while( (null? p.ownerFile) && (!null? p.parent)) {
            p = (unwrap p.parent)
        }

        if (!null? p.ownerFile) {
            def f:CodeFile (unwrap p.ownerFile)
            return f.import_names
        } 
        def nothing:[string]
        return nothing
    }

    fn addImport:void (name:string) {
        if (!null? ownerFile) {
            ownerFile.addImport(name)
        } {
            if (!null? parent) {
                parent.addImport(name)
            }
        }
    }

    fn indent:void (delta:int) {
        indentAmount = indentAmount + delta
        if(indentAmount < 0) {
            indentAmount = 0
        }
    }

    fn addIndent:void () {
        def i:int 0 
        if ( 0 == (strlen currentLine) ) {
            while (i < indentAmount) {
                currentLine = currentLine + tabStr
                i = i + 1
            }
        }
    }

    fn createTag@(weak):CodeWriter (name:string) {
        def new_writer:CodeWriter (new CodeWriter ())
        def new_slice:CodeSlice (new CodeSlice ())
        set tags name (array_length slices)
        push slices new_slice
        new_slice.writer = new_writer
        new_writer.indentAmount = indentAmount
        new_writer.lineNumber = lineNumber
        new_writer.columnNumber = columnNumber
        new_writer.sourceMapsEnabled = sourceMapsEnabled
        new_writer.sourceMapBuilder = sourceMapBuilder

        def new_active_slice:CodeSlice (new CodeSlice ())
        push slices new_active_slice

        current_slice = new_active_slice
        new_writer.parent = this

        return new_writer
    }

    fn getTag@(weak):CodeWriter (name:string) {
        if (has tags name) {
            def idx:int (unwrap (get tags name))
            def slice:CodeSlice (itemAt slices idx)
            return (unwrap slice.writer)
        } {
            if(!null? parent) {
                return (parent.getTag (name))
            }
        }
        return this
    }

    fn hasTag:boolean (name:string) {
        if (has tags name) {
            return true
        } {
            if (!null? parent) {
                return (parent.hasTag(name))
            }
        }
        return false
    }

    fn fork@(weak):CodeWriter () {
        def new_writer:CodeWriter (new CodeWriter ())
        def new_slice:CodeSlice (new CodeSlice ())
        push slices new_slice

        new_slice.writer = new_writer
        new_writer.indentAmount = indentAmount
        new_writer.lineNumber = lineNumber
        new_writer.columnNumber = columnNumber
        new_writer.sourceMapsEnabled = sourceMapsEnabled
        new_writer.sourceMapBuilder = sourceMapBuilder
        new_writer.parent = this

        def new_active_slice:CodeSlice (new CodeSlice ())
        push slices new_active_slice
        current_slice = new_active_slice

        return new_writer
    }

    fn newline:void () {
        if ( (strlen currentLine) > 0) {
            this.out("" true)
        }
    }

    fn line_end:void (str:string) {
        ; `charcode` reads index 0, so an empty argument has to leave early.
        ; JavaScript answers NaN and the comparison below is then always true,
        ; which writes the empty string -- a no-op. Every other target raises on
        ; the read instead, and the C++ build turned that into "Error parsing
        ; function unspecified error" for 106 functions.
        if ( (strlen str) == 0) {
            return
        }
        if ( (strlen currentLine) > 0) {
            if ( (charcode str) != (charAt currentLine ( (strlen currentLine) - 1) ) ) {
                this.out(str false)
            }    
        } 
    }

    fn advanceColumnForString:void (str:string) {
        def i:int 0
        while (i < (strlen str)) {
            ; `charAt` indexes the same units `strlen` counts on every target.
            ; The previous form asked `substring` for one unit and read its
            ; first code: on C++ `substring` counts UTF-8 CHARACTERS while
            ; `strlen` counts BYTES, so a string holding one multi-byte
            ; character ran the index past the end, `substring` gave "" and
            ; reading its first code raised.
            def ch:int (charAt str i)
            if (ch == 10) {
                lineNumber = lineNumber + 1
                columnNumber = 0
            } {
                columnNumber = columnNumber + 1
            }
            i = i + 1
        }
    }

    fn syncColumnFromCurrentLine:void () {
        columnNumber = (strlen currentLine)
    }

    fn writeSlice:void (str:string newLine:boolean) {
        this.addIndent()
        this.syncColumnFromCurrentLine()
        if ((strlen str) > 0) {
            this.recordCurrentMapping()
        }
        currentLine = currentLine + str
        this.advanceColumnForString(str)
        if newLine {
            current_slice.code = current_slice.code + currentLine + nlStr
            currentLine = ""
            lineNumber = lineNumber + 1
            columnNumber = 0
        }
    }

    fn out:void (str:string newLine:boolean) {
        def lines:[string] (strsplit str "\n")
        def rowCnt:int (array_length lines)
        if (rowCnt == 1) {
            this.writeSlice(str newLine)
        } {
            for lines row:string idx {
                this.addIndent()
                if ( idx < (rowCnt - 1) ) {
                    this.writeSlice( (trim row) true)
                } {
                    this.writeSlice( row newLine )
                }
            }
        }   
    }

    fn raw:void (str:string newLine:boolean) {
        def lines:[string] (strsplit str "\n")
        def rowCnt:int (array_length lines)
        if (rowCnt == 1) {
            this.writeSlice(str newLine)
        } {
            for lines row:string idx {
                ; Remove trailing whitespace (including \r) to handle both \n and \r\n line endings
                def cleanRow:string (trim_right row)
                this.addIndent()
                if ( idx < (rowCnt - 1) ) {
                    this.writeSlice( cleanRow true)
                } {
                    this.writeSlice( cleanRow newLine )
                }
            }
        }   
    }

    fn getCode:string () {
        def res:string ""
        for slices slice:CodeSlice idx {
            res = res + (slice.getCode())
        }
        res = res + currentLine
        return res
    }

}

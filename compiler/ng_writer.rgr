; SPDX-License-Identifier: MIT

Import "ng_SourceMap.rgr"

; ---------------------------------------------------------------------------
; PLAN_FORMAT.md S5, phase 3: a long method chain is broken -- every link or
; none of them.
;
; This runs over FINISHED LINES rather than during emission, and that is the
; whole reason it is small. A chain is assembled by CreateCallExpression
; recursing through its receiver, so mid-emission no one holds the whole chain;
; deciding there would mean editing eleven writers and knowing, at each one,
; how much of the line was still to come. A finished line knows its own length,
; its own indentation and every link it holds.
;
; It is also why phase 3 does not wait for phase 2: the decision is made on the
; text, so however the operator path ends up parenthesising `(xs[i]).get()`,
; the breaking rule reads the result rather than the shape that produced it.
;
; The rule is prettier's and Biome's, which arrived at it independently: a
; chain stays on one line while it fits, and once it does not, EVERY link goes
; onto its own line. Never some and not others -- a half-broken chain is the
; one shape that reads worse than either.
; ---------------------------------------------------------------------------
class RangerSourceFormat {

    ; Only real source is touched. package.json, .md and .csproj come through
    ; the same file system and a "line too long" rule means nothing in them.
    static fn defaultWidthFor:int (ext:string) {
        if (ext == "js") { return 80 }
        if (ext == "ts") { return 80 }
        if (ext == "mjs") { return 80 }
        if (ext == "cjs") { return 80 }
        if (ext == "dart") { return 80 }
        if (ext == "cpp") { return 80 }
        if (ext == "hpp") { return 80 }
        if (ext == "h") { return 80 }
        if (ext == "go") { return 100 }
        if (ext == "rs") { return 100 }
        if (ext == "kt") { return 100 }
        if (ext == "cs") { return 100 }
        if (ext == "java") { return 100 }
        if (ext == "scala") { return 100 }
        if (ext == "swift") { return 100 }
        if (ext == "php") { return 100 }
        return 0
    }

    ; Go inserts a semicolon after a line that ends in `)`, so a chain broken
    ; before the dot does not parse there. Go keeps the dot on the line it
    ; came from; every other target here starts the new line with it.
    static fn dotLeadsLine:boolean (ext:string) {
        if (ext == "go") {
            return false
        }
        return true
    }

    static fn isSpaceCode:boolean (c:int) {
        if (c == 32) { return true }
        if (c == 9) { return true }
        return false
    }

    static fn indentOf:string (line:string) {
        def i:int 0
        def n:int (strlen line)
        while (i < n) {
            def c:int (charAt line i)
            def sp:boolean (RangerSourceFormat.isSpaceCode(c))
            if (sp == false) {
                break _
            }
            i = i + 1
        }
        return (substring line 0 i)
    }

    ; A comment is never reformatted. That is the rule every ecosystem
    ; formatter follows, and PLAN_FORMAT.md S1 is about what a doc comment
    ; shows the reader -- breaking one here would be the same mistake from the
    ; other side.
    static fn isCommentOrEmpty:boolean (line:string) {
        def t:string (trim line)
        def n:int (strlen t)
        if (n == 0) {
            return true
        }
        def c0:int (charAt t 0)
        if (c0 == 42) { return true }
        if (c0 == 35) { return true }
        if (c0 == 59) { return true }
        if (n < 2) {
            return false
        }
        def two:string (substring t 0 2)
        if (two == "//") { return true }
        if (two == "/*") { return true }
        return false
    }

    ; Where the code on this line ends and a trailing line comment begins.
    ; Everything after it is left alone: a comment that happens to contain
    ; `).` or a comma is not a chain link or an argument separator, and
    ; splitting inside one would be the same mistake as reformatting it.
    static fn codeEndOf:int (line:string) {
        def n:int (strlen line)
        def i:int 0
        while (i < n) {
            def c:int (charAt line i)
            if ((c == 34) || (c == 39)) {
                def quote:int c
                i = i + 1
                while (i < n) {
                    def qc:int (charAt line i)
                    if (qc == 92) {
                        i = i + 2
                    } {
                        if (qc == quote) {
                            break _
                        }
                        i = i + 1
                    }
                }
                i = i + 1
            } {
                if (c == 47) {
                    if (i < (n - 1)) {
                        def nx:int (charAt line (i + 1))
                        if (nx == 47) {
                            return i
                        }
                    }
                }
                i = i + 1
            }
        }
        return n
    }

    ; Every index at bracket depth 0 where a member access follows a CALL --
    ; `).` or `)->`. Those are the links of a chain. A `.` after a name is not
    ; a link, so `a.b.c()` is one call and stays put. String and character
    ; literals are stepped over whole.
    static fn chainSplits:[int] (line:string) {
        def out:[int]
        def n:int (RangerSourceFormat.codeEndOf(line))
        def depth:int 0
        def i:int 0
        while (i < n) {
            def c:int (charAt line i)
            if ((c == 34) || (c == 39)) {
                def quote:int c
                i = i + 1
                while (i < n) {
                    def qc:int (charAt line i)
                    if (qc == 92) {
                        i = i + 2
                    } {
                        if (qc == quote) {
                            break _
                        }
                        i = i + 1
                    }
                }
                i = i + 1
            } {
                if (((c == 40) || (c == 91)) || (c == 123)) {
                    depth = depth + 1
                    i = i + 1
                } {
                    if (((c == 41) || (c == 93)) || (c == 125)) {
                        depth = depth - 1
                        i = i + 1
                    } {
                        def isLink:boolean false
                        if (depth == 0) {
                            if (i > 0) {
                                def prev:int (charAt line (i - 1))
                                if (prev == 41) {
                                    if (c == 46) {
                                        isLink = true
                                    }
                                    if (c == 45) {
                                        if (i < (n - 1)) {
                                            def nx:int (charAt line (i + 1))
                                            if (nx == 62) {
                                                isLink = true
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if isLink {
                            push out i
                        }
                        i = i + 1
                    }
                }
            }
        }
        return out
    }

    static fn breakChainLine:string (line:string ext:string) {
        def splits:[int] (RangerSourceFormat.chainSplits(line))
        def cnt:int (array_length splits)
        ; "more than two calls": two split points means three calls.
        if (cnt < 2) {
            return line
        }
        def ind:string (RangerSourceFormat.indentOf(line))
        def step:string (ind + "  ")
        def lead:boolean (RangerSourceFormat.dotLeadsLine(ext))
        def res:string ""
        def prev:int 0
        for splits sp:int si {
            def piece:string (substring line prev sp)
            if lead {
                if (si == 0) {
                    res = res + piece
                } {
                    res = res + step + piece
                }
                res = res + "\n"
            } {
                def dotLen:int 1
                def dc:int (charAt line sp)
                if (dc == 45) {
                    dotLen = 2
                }
                def tail:int (sp + dotLen)
                def withDot:string (substring line prev tail)
                if (si == 0) {
                    res = res + withDot
                } {
                    res = res + step + withDot
                }
                res = res + "\n"
            }
            prev = sp
            if (lead == false) {
                def dl:int 1
                def dc2:int (charAt line sp)
                if (dc2 == 45) {
                    dl = 2
                }
                prev = sp + dl
            }
        }
        def last:string (substring line prev (strlen line))
        res = res + step + last
        return res
    }

    ; `if (`, `while (` and their kin open a parenthesis that is not an
    ; argument list. Breaking at "commas" there would be breaking at commas
    ; that are really somebody else's.
    static fn isCallKeyword:boolean (word:string) {
        if (word == "if") { return true }
        if (word == "while") { return true }
        if (word == "for") { return true }
        if (word == "switch") { return true }
        if (word == "catch") { return true }
        if (word == "return") { return true }
        if (word == "guard") { return true }
        if (word == "foreach") { return true }
        if (word == "using") { return true }
        if (word == "lock") { return true }
        if (word == "match") { return true }
        if (word == "when") { return true }
        return false
    }

    static fn isWordCode:boolean (c:int) {
        if ((c >= 97) && (c <= 122)) { return true }
        if ((c >= 65) && (c <= 90)) { return true }
        if ((c >= 48) && (c <= 57)) { return true }
        if (c == 95) { return true }
        return false
    }

    ; The word immediately before position i, skipping spaces.
    static fn wordBefore:string (line:string i:int) {
        def j:int (i - 1)
        while (j >= 0) {
            def c:int (charAt line j)
            def sp:boolean (RangerSourceFormat.isSpaceCode(c))
            if (sp == false) {
                break _
            }
            j = j - 1
        }
        def endPos:int (j + 1)
        while (j >= 0) {
            def c2:int (charAt line j)
            def w:boolean (RangerSourceFormat.isWordCode(c2))
            if (w == false) {
                break _
            }
            j = j - 1
        }
        def startPos:int (j + 1)
        if (startPos >= endPos) {
            return ""
        }
        return (substring line startPos endPos)
    }

    ; The argument list to expand: the FIRST `(` that opens a real call and
    ; holds at least two commas of its own. Returns the open index, or -1.
    static fn argListOpen:int (line:string) {
        def n:int (RangerSourceFormat.codeEndOf(line))
        def i:int 0
        while (i < n) {
            def c:int (charAt line i)
            if ((c == 34) || (c == 39)) {
                def quote:int c
                i = i + 1
                while (i < n) {
                    def qc:int (charAt line i)
                    if (qc == 92) {
                        i = i + 2
                    } {
                        if (qc == quote) {
                            break _
                        }
                        i = i + 1
                    }
                }
                i = i + 1
            } {
                if (c == 40) {
                    def before:string (RangerSourceFormat.wordBefore(line i))
                    def kw:boolean (RangerSourceFormat.isCallKeyword(before))
                    def isCall:boolean false
                    if (i > 0) {
                        def pc:int (charAt line (i - 1))
                        def wordy:boolean (RangerSourceFormat.isWordCode(pc))
                        if (wordy || (pc == 41)) {
                            isCall = true
                        }
                    }
                    if (kw) {
                        isCall = false
                    }
                    if isCall {
                        def commas:int (RangerSourceFormat.topCommaCount(line i n))
                        if (commas >= 2) {
                            return i
                        }
                    }
                    i = i + 1
                } {
                    i = i + 1
                }
            }
        }
        return (0 - 1)
    }

    ; Commas belonging to the group opened at `open`, and nothing nested.
    static fn topCommaCount:int (line:string open:int limit:int) {
        def cnt:int 0
        def depth:int 0
        def i:int open
        while (i < limit) {
            def c:int (charAt line i)
            if ((c == 34) || (c == 39)) {
                def quote:int c
                i = i + 1
                while (i < limit) {
                    def qc:int (charAt line i)
                    if (qc == 92) {
                        i = i + 2
                    } {
                        if (qc == quote) {
                            break _
                        }
                        i = i + 1
                    }
                }
                i = i + 1
            } {
                if (((c == 40) || (c == 91)) || (c == 123)) {
                    depth = depth + 1
                    i = i + 1
                } {
                    if (((c == 41) || (c == 93)) || (c == 125)) {
                        depth = depth - 1
                        if (depth == 0) {
                            return cnt
                        }
                        i = i + 1
                    } {
                        if (depth == 1) {
                            if (c == 44) {
                                cnt = cnt + 1
                            }
                        }
                        i = i + 1
                    }
                }
            }
        }
        return 0
    }

    static fn topCommaAt:[int] (line:string open:int limit:int) {
        def out:[int]
        def depth:int 0
        def i:int open
        while (i < limit) {
            def c:int (charAt line i)
            if ((c == 34) || (c == 39)) {
                def quote:int c
                i = i + 1
                while (i < limit) {
                    def qc:int (charAt line i)
                    if (qc == 92) {
                        i = i + 2
                    } {
                        if (qc == quote) {
                            break _
                        }
                        i = i + 1
                    }
                }
                i = i + 1
            } {
                if (((c == 40) || (c == 91)) || (c == 123)) {
                    depth = depth + 1
                    i = i + 1
                } {
                    if (((c == 41) || (c == 93)) || (c == 125)) {
                        depth = depth - 1
                        if (depth == 0) {
                            push out i
                            return out
                        }
                        i = i + 1
                    } {
                        if (depth == 1) {
                            if (c == 44) {
                                push out i
                            }
                        }
                        i = i + 1
                    }
                }
            }
        }
        return out
    }

    ; One argument per line, closing paren back at the statement's own indent.
    ; That is prettier's, black's and clang-format's shape, and Go needs the
    ; trailing comma or its semicolon insertion rejects the close.
    ; The code on this line, minus a trailing line comment and trailing space.
    static fn codeTailChar:int (line:string) {
        def e:int (RangerSourceFormat.codeEndOf(line))
        def j:int (e - 1)
        while (j >= 0) {
            def c:int (charAt line j)
            def sp:boolean (RangerSourceFormat.isSpaceCode(c))
            if (sp == false) {
                return c
            }
            j = j - 1
        }
        return 0
    }

    static fn breakArgLine:string (line:string ext:string) {
        ; A line whose code ends in `{` is a DECLARATION or a lambda header,
        ; not a call: `void Worker::copyInto( ... ) {`. Expanding its parameter
        ; list is legal in every target here and clang-format does it, but a
        ; signature is the most-read line in a file and the most asserted-on
        ; text in the suite, and reflowing one buys the least. Calls only.
        def tail:int (RangerSourceFormat.codeTailChar(line))
        if (tail == 123) {
            return line
        }
        def open:int (RangerSourceFormat.argListOpen(line))
        if (open < 0) {
            return line
        }
        def limit:int (RangerSourceFormat.codeEndOf(line))
        def marks:[int] (RangerSourceFormat.topCommaAt(line open limit))
        def mcnt:int (array_length marks)
        if (mcnt < 3) {
            return line
        }
        def closeIdx:int (itemAt marks (mcnt - 1))
        def ind:string (RangerSourceFormat.indentOf(line))
        def step:string (ind + "  ")
        def res:string (substring line 0 (open + 1))
        res = res + "\n"
        def prev:int (open + 1)
        def i:int 0
        while (i < (mcnt - 1)) {
            def cm:int (itemAt marks i)
            def arg:string (trim (substring line prev cm))
            res = res + step + arg + ",\n"
            prev = cm + 1
            i = i + 1
        }
        def lastArg:string (trim (substring line prev closeIdx))
        def goLike:boolean false
        if (ext == "go") {
            goLike = true
        }
        if goLike {
            res = res + step + lastArg + ",\n"
        } {
            res = res + step + lastArg + "\n"
        }
        def rest:string (substring line closeIdx (strlen line))
        res = res + ind + rest
        return res
    }

    ; A line whose quote scan ends INSIDE a string is a line this pass cannot
    ; reason about: a multi-line literal, or a stray apostrophe. Its brackets
    ; are not the brackets they appear to be, so nothing is broken there.
    ; No output emitted today reaches this -- the only lines that trip it are
    ; doc comments with an apostrophe in them, which are already skipped --
    ; and it costs one scan to make sure that stays true.
    static fn hasOpenString:boolean (line:string) {
        def n:int (strlen line)
        def i:int 0
        while (i < n) {
            def c:int (charAt line i)
            if ((c == 34) || (c == 39)) {
                def quote:int c
                i = i + 1
                def closed:boolean false
                while (i < n) {
                    def qc:int (charAt line i)
                    if (qc == 92) {
                        i = i + 2
                    } {
                        if (qc == quote) {
                            closed = true
                            break _
                        }
                        i = i + 1
                    }
                }
                if (closed == false) {
                    return true
                }
                i = i + 1
            } {
                if (c == 47) {
                    if (i < (n - 1)) {
                        def nx:int (charAt line (i + 1))
                        if (nx == 47) {
                            return false
                        }
                    }
                }
                i = i + 1
            }
        }
        return false
    }

    static fn formatSource:string (text:string ext:string width:int) {
        def w:int width
        if (w <= 0) {
            w = (RangerSourceFormat.defaultWidthFor(ext))
        }
        if (w <= 0) {
            return text
        }
        def lines:[string] (strsplit text "\n")
        def out:[string]
        for lines line:string li {
            def keep:boolean true
            def len:int (strlen line)
            if (len > w) {
                def skip:boolean (RangerSourceFormat.isCommentOrEmpty(line))
                if (skip == false) {
                    def openStr:boolean (RangerSourceFormat.hasOpenString(line))
                    if openStr {
                        skip = true
                    }
                }
                if (skip == false) {
                    ; Chains first: a chain that fits once broken never needs
                    ; its arguments expanded as well, and expanding both at
                    ; once is how a formatter produces a shape nobody wrote.
                    def broken:string (RangerSourceFormat.breakChainLine(line ext))
                    if (broken == line) {
                        broken = (RangerSourceFormat.breakArgLine(line ext))
                    }
                    push out broken
                    keep = false
                }
            }
            if keep {
                push out line
            }
        }
        return (join out "\n")
    }
}

class CodeFile {
    def path_name:string ""
    def name:string ""
    def writer@(optional):CodeWriter
    def import_list:[string:string]
    def import_names:[string]
    def fileSystem@(weak):CodeFileSystem
    def sourceMapBuilder@(optional):SourceMapBuilder

    Constructor (filePath:string fileName:string) {
        name = fileName
        path_name = filePath
        writer = (new CodeWriter())
        writer.createTag("imports")
    }

    ; The flag is passed in rather than read back off `fileSystem`: the
    ; caller is the file system itself, and on Rust it is inside its own
    ; cell for the duration of the call that creates this file — reaching
    ; back through the weak reference borrows that cell a second time.
    fn initSourceMapsIfNeeded:void (mapsEnabled:boolean) {
        if (!null? sourceMapBuilder) {
            return
        }
        if (null? fileSystem) {
            return
        }
        if (mapsEnabled == false) {
            return
        }
        sourceMapBuilder = (new SourceMapBuilder ())
        def wr@(optional):CodeWriter writer
        if (!null? wr) {
            ; Bind before calling: a statement starting with a parenthesised
            ; receiver silently swallows the rest of its block (ISSUES.md #65).
            def w:CodeWriter (unwrap wr)
            w.enableSourceMaps((unwrap sourceMapBuilder))
        }
    }

    fn addImport:void (import_name:string) {
        if (false == (has import_list import_name)) {
            set import_list import_name import_name
            push import_names import_name
        }
    }

    fn rewrite (newString:string ) {
        writer.rewrite(newString)
    }
    
    fn testCreateWriter@(strong):CodeWriter () {
        return (new CodeWriter ())
    }

    fn getImports@(weak):[string] () {
        return import_names
    }

    fn getWriter@(weak optional):CodeWriter () {
        writer.ownerFile = this
        return writer
    }

    fn getCode:string () {
        return (writer.getCode())
    }

}

class CodeFileSystem {
    def files:[CodeFile]
    def sourceMapsEnabled:boolean false
    ; PLAN_FORMAT.md phase 3. 0 leaves every line as emitted (-format=none);
    ; -1 means "on, at the target's own default width"; a positive number is
    ; an explicit -width=. The compiler sets this before saveTo.
    def formatWidth:int 0

    fn enableSourceMaps:void () {
        sourceMapsEnabled = true
    }

    fn shouldWriteSourceMaps:boolean () {
        return sourceMapsEnabled
    }

    fn getFile@(weak):CodeFile (path:string name:string) {
        for files file:CodeFile idx {
            if ( (file.path_name == path) && (file.name == name) ) {
                return file
            }
        }
        def new_file:CodeFile (new CodeFile (path name))
        new_file.fileSystem = this
        new_file.initSourceMapsIfNeeded(sourceMapsEnabled)
        push files new_file
        return new_file
    }

    fn mkdir:void (path:string) {
        def parts:[string] (strsplit path "/")
        def curr_path:string ""
        for parts p:string i {
            curr_path = curr_path + p + "/"
            if (false == (dir_exists curr_path)) {
                create_dir curr_path
            }
        }
    }

    fn isJsOutputFile:boolean (fileName:string) {
        if (endsWith fileName ".js") {
            return true
        }
        if (endsWith fileName ".ts") {
            return true
        }
        return false
    }

    fn saveTo:void (path:string verbose:boolean) {
        print "Saving results to path : " + path         
        for files file:CodeFile idx {
            def file_path:string (path + "/" + file.path_name)
            this.mkdir(file_path)
            if( verbose ) {
                print "Writing to file " + file_path + "/" + file.name
            }
            def file_content:string (file.getCode())
            if ((strlen file_content) > 0) {
                def outName:string (trim file.name)
                ; Break long chains on the finished text. Keyed on the
                ; extension rather than on the target language, so that
                ; package.json, .md and .csproj -- which reach this same loop
                ; -- are left alone without any plumbing.
                if (formatWidth != 0) {
                    def nameParts:[string] (strsplit outName ".")
                    def partCnt:int (array_length nameParts)
                    if (partCnt > 1) {
                        def fileExt:string (itemAt nameParts (partCnt - 1))
                        def useWidth:int formatWidth
                        if (useWidth < 0) {
                            useWidth = 0
                        }
                        file_content = (RangerSourceFormat.formatSource(file_content fileExt useWidth))
                    }
                }
                def writeSourceMap:boolean false
                if (this.shouldWriteSourceMaps()) {
                    if (this.isJsOutputFile(outName)) {
                        if (!null? file.sourceMapBuilder) {
                            def builder:SourceMapBuilder (unwrap file.sourceMapBuilder)
                            if (builder.hasMappings()) {
                                writeSourceMap = true
                                file_content = file_content + "\n//# sourceMappingURL=" + outName + ".map\n"
                            }
                        }
                    }
                }
                write_file file_path outName file_content
                if (writeSourceMap) {
                    def builder2:SourceMapBuilder (unwrap file.sourceMapBuilder)
                    def mapJson:string (builder2.toJSON(outName))
                    write_file file_path (outName + ".map") mapJson
                    if (verbose) {
                        print "Writing source map " + file_path + "/" + outName + ".map"
                    }
                }
            }
        }
    }
}

class CodeSlice {

    def code:string ""
    def writer@(optional):CodeWriter 

    fn getCode:string () {
        if (null? writer) {
            return code
        }
        return (writer.getCode())
    }

}

class CodeWriter {
    def tagName:string ""
    ; one-shot: the next operator emission is already delimited by the
    ; caller (its own parens, or a call-argument slot), so the expression
    ; walker must not add a pair of its own
    def suppress_expr_parens:boolean false
    ; scoped to the operator currently being emitted: true when its caller
    ; already delimits it, so a custom handler skips its own outer pair
    def current_op_no_parens:boolean false
    ; inside a format!/println! argument slot: a Display value needs no
    ; .to_string() there
    def in_format_args:boolean false
    ; PLAN_FORMAT.md phase 2. The binding power of the operator this expression
    ; is being written INTO, or 0 when that is not an operator at all. An
    ; operand that binds TIGHTER than its parent never needs parentheses in any
    ; target here, which is the whole of the rule; 0 means "unknown", and
    ; unknown keeps the pair.
    def parent_binding:int 0
    def codeStr:string ""
    def currentLine:string ""
    def tabStr:string "  "
    def nlStr "\n"
    def lineNumber:int 0
    def columnNumber:int 0
    def indentAmount:int 0

    def compiledTags:[string:boolean]
    def tags:[string:int]
    def slices:[CodeSlice]
    def current_slice@(weak optional):CodeSlice
    def ownerFile@(weak optional):CodeFile
    def forks:[CodeWriter]

    def tagOffset:int 0 
    def parent@(weak):CodeWriter

    def had_nl:boolean true

    def sourceMapsEnabled:boolean false
    def sourceMapBuilder@(optional weak):SourceMapBuilder
    def mappingNodeStack:[CodeNode]
    def mappingNameStack:[string]
    def walkNodeStack:[CodeNode]

    static fn emptyWithFS:CodeWriter () {
        def wr@(temp) (new CodeWriter)
        def file@(temp lives) (new CodeFile ("." "emptyFile.txt"))
        file.writer = wr
        file.fileSystem = (new CodeFileSystem)
        wr.ownerFile = file
        return wr
    }
 
    Constructor() {
        def new_slice:CodeSlice (new CodeSlice ())
        push slices new_slice
        current_slice = new_slice
    }

    fn rewrite (newString:string ) {
        clear slices
        clear forks
        currentLine = ""
        lineNumber = 0
        columnNumber = 0
        def new_slice:CodeSlice (new CodeSlice ())
        push slices new_slice
        new_slice.code = newString
        current_slice = new_slice
    }

    fn enableSourceMaps:void (builder:SourceMapBuilder) {
        sourceMapsEnabled = true
        sourceMapBuilder = builder
    }

    fn getActiveSourceMapBuilder@(weak optional):SourceMapBuilder () {
        if (sourceMapsEnabled && (!null? sourceMapBuilder)) {
            return sourceMapBuilder
        }
        if (!null? parent) {
            return (parent.getActiveSourceMapBuilder())
        }
        return sourceMapBuilder
    }

    fn pushMappingNode:void (node:CodeNode name:string) {
        push mappingNodeStack node
        push mappingNameStack name
    }

    fn popMappingNode:void () {
        if ((array_length mappingNodeStack) > 0) {
            removeLast mappingNodeStack
        }
        if ((array_length mappingNameStack) > 0) {
            removeLast mappingNameStack
        }
    }

    fn getCurrentMappingNode@(weak optional):CodeNode () {
        def emptyNode@(weak optional):CodeNode
        if ((array_length mappingNodeStack) == 0) {
            return emptyNode
        }
        def current@(weak optional):CodeNode (itemAt mappingNodeStack ((array_length mappingNodeStack) - 1))
        return current
    }

    fn getCurrentMappingName:string () {
        if ((array_length mappingNameStack) == 0) {
            return ""
        }
        return (itemAt mappingNameStack ((array_length mappingNameStack) - 1))
    }

    fn pushWalkNode:void (node:CodeNode) {
        push walkNodeStack node
    }

    fn popWalkNode:void () {
        if ((array_length walkNodeStack) > 0) {
            removeLast walkNodeStack
        }
    }

    fn getCurrentWalkNode@(weak optional):CodeNode () {
        def emptyNode@(weak optional):CodeNode
        if ((array_length walkNodeStack) > 0) {
            def current@(weak optional):CodeNode (itemAt walkNodeStack ((array_length walkNodeStack) - 1))
            return current
        }
        if (!null? parent) {
            return (parent.getCurrentWalkNode())
        }
        return emptyNode
    }

    fn recordCurrentMapping:void () {
        def builder@(optional):SourceMapBuilder (this.getActiveSourceMapBuilder())
        if (null? builder) {
            return
        }
        def node@(weak optional):CodeNode (this.getCurrentMappingNode())
        if (null? node) {
            node = (this.getCurrentWalkNode())
        }
        if (null? node) {
            return
        }
        def mapName:string (this.getCurrentMappingName())
        builder.addMappingFromNode(lineNumber columnNumber (unwrap node) mapName)
    }

    fn outMapped:void (str:string node:CodeNode newLine:boolean name:string) {
        this.pushMappingNode(node name)
        this.out(str newLine)
        this.popMappingNode()
    }

    fn getFilesystem:CodeFileSystem () {
        if( null? ownerFile ) {
            if(!null? parent) {
                return (parent.getFilesystem())
            }
            return (new CodeFileSystem())
        }
        def fs:CodeFileSystem ownerFile.fileSystem
        return (unwrap fs)       
    }

    fn getFileWriter:CodeWriter (path:string fileName:string) {
        if( null? ownerFile ) {
            if(!null? parent) {
                return (parent.getFileWriter(path fileName))
            }
            ; functions should be able to raise exceptions too
            ; throw "File writer not defined"
        }
        def fs:CodeFileSystem ownerFile.fileSystem
        def file:CodeFile (fs.getFile(path fileName))
        def wr@(optional):CodeWriter (file.getWriter())
        return (unwrap wr)
    }

    fn getImports@(weak):[string] () {

        def p:CodeWriter this
        while( (null? p.ownerFile) && (!null? p.parent)) {
            p = (unwrap p.parent)
        }

        if (!null? p.ownerFile) {
            def f:CodeFile (unwrap p.ownerFile)
            return f.import_names
        } 
        def nothing:[string]
        return nothing
    }

    fn addImport:void (name:string) {
        if (!null? ownerFile) {
            ownerFile.addImport(name)
        } {
            if (!null? parent) {
                parent.addImport(name)
            }
        }
    }

    fn indent:void (delta:int) {
        indentAmount = indentAmount + delta
        if(indentAmount < 0) {
            indentAmount = 0
        }
    }

    fn addIndent:void () {
        def i:int 0 
        if ( 0 == (strlen currentLine) ) {
            ; the two reads land in a local first: writing one own field
            ; while reading another in the same statement is a mutable and a
            ; shared borrow of one object at once
            def indentStep:string tabStr
            while (i < indentAmount) {
                def lineSoFar:string currentLine
                currentLine = lineSoFar + indentStep
                i = i + 1
            }
        }
    }

    fn createTag@(weak):CodeWriter (name:string) {
        def new_writer:CodeWriter (new CodeWriter ())
        def new_slice:CodeSlice (new CodeSlice ())
        ; the count first: writing one own field while reading another in the
        ; same statement is a mutable and a shared borrow of one cell in Rust
        def tagIndex:int (array_length slices)
        set tags name tagIndex
        push slices new_slice
        new_slice.writer = new_writer
        new_writer.indentAmount = indentAmount
        new_writer.lineNumber = lineNumber
        new_writer.columnNumber = columnNumber
        new_writer.sourceMapsEnabled = sourceMapsEnabled
        new_writer.sourceMapBuilder = sourceMapBuilder

        def new_active_slice:CodeSlice (new CodeSlice ())
        push slices new_active_slice

        current_slice = new_active_slice
        new_writer.parent = this

        return new_writer
    }

    fn getTag@(weak):CodeWriter (name:string) {
        if (has tags name) {
            def idx:int (unwrap (get tags name))
            def slice:CodeSlice (itemAt slices idx)
            return (unwrap slice.writer)
        } {
            if(!null? parent) {
                return (parent.getTag (name))
            }
        }
        return this
    }

    fn hasTag:boolean (name:string) {
        if (has tags name) {
            return true
        } {
            if (!null? parent) {
                return (parent.hasTag(name))
            }
        }
        return false
    }

    fn fork@(weak):CodeWriter () {
        def new_writer:CodeWriter (new CodeWriter ())
        def new_slice:CodeSlice (new CodeSlice ())
        push slices new_slice

        new_slice.writer = new_writer
        new_writer.indentAmount = indentAmount
        new_writer.lineNumber = lineNumber
        new_writer.columnNumber = columnNumber
        new_writer.sourceMapsEnabled = sourceMapsEnabled
        new_writer.sourceMapBuilder = sourceMapBuilder
        new_writer.parent = this

        def new_active_slice:CodeSlice (new CodeSlice ())
        push slices new_active_slice
        current_slice = new_active_slice

        return new_writer
    }

    fn newline:void () {
        if ( (strlen currentLine) > 0) {
            this.out("" true)
        }
    }

    fn line_end:void (str:string) {
        ; `charcode` reads index 0, so an empty argument has to leave early.
        ; JavaScript answers NaN and the comparison below is then always true,
        ; which writes the empty string -- a no-op. Every other target raises on
        ; the read instead, and the C++ build turned that into "Error parsing
        ; function unspecified error" for 106 functions.
        if ( (strlen str) == 0) {
            return
        }
        if ( (strlen currentLine) > 0) {
            if ( (charcode str) != (charAt currentLine ( (strlen currentLine) - 1) ) ) {
                this.out(str false)
            }    
        } 
    }

    fn advanceColumnForString:void (str:string) {
        def i:int 0
        while (i < (strlen str)) {
            ; `charAt` indexes the same units `strlen` counts on every target.
            ; The previous form asked `substring` for one unit and read its
            ; first code: on C++ `substring` counts UTF-8 CHARACTERS while
            ; `strlen` counts BYTES, so a string holding one multi-byte
            ; character ran the index past the end, `substring` gave "" and
            ; reading its first code raised.
            def ch:int (charAt str i)
            if (ch == 10) {
                lineNumber = lineNumber + 1
                columnNumber = 0
            } {
                columnNumber = columnNumber + 1
            }
            i = i + 1
        }
    }

    fn syncColumnFromCurrentLine:void () {
        def lineLen:int (strlen currentLine)
        columnNumber = lineLen
    }

    fn writeSlice:void (str:string newLine:boolean) {
        this.addIndent()
        this.syncColumnFromCurrentLine()
        if ((strlen str) > 0) {
            this.recordCurrentMapping()
        }
        def lineBefore:string currentLine
        currentLine = lineBefore + str
        this.advanceColumnForString(str)
        if newLine {
            current_slice.code = current_slice.code + currentLine + nlStr
            currentLine = ""
            lineNumber = lineNumber + 1
            columnNumber = 0
        }
    }

    fn out:void (str:string newLine:boolean) {
        def lines:[string] (strsplit str "\n")
        def rowCnt:int (array_length lines)
        if (rowCnt == 1) {
            this.writeSlice(str newLine)
        } {
            for lines row:string idx {
                this.addIndent()
                if ( idx < (rowCnt - 1) ) {
                    this.writeSlice( (trim row) true)
                } {
                    this.writeSlice( row newLine )
                }
            }
        }   
    }

    fn raw:void (str:string newLine:boolean) {
        def lines:[string] (strsplit str "\n")
        def rowCnt:int (array_length lines)
        if (rowCnt == 1) {
            this.writeSlice(str newLine)
        } {
            for lines row:string idx {
                ; Remove trailing whitespace (including \r) to handle both \n and \r\n line endings
                def cleanRow:string (trim_right row)
                this.addIndent()
                if ( idx < (rowCnt - 1) ) {
                    this.writeSlice( cleanRow true)
                } {
                    this.writeSlice( cleanRow newLine )
                }
            }
        }   
    }

    fn getCode:string () {
        def res:string ""
        for slices slice:CodeSlice idx {
            res = res + (slice.getCode())
        }
        res = res + currentLine
        return res
    }

}

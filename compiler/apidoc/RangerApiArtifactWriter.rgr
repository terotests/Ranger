; Writes the standalone artifacts: the ApiIR as JSON, and a portable Markdown
; reference. Everything else -- the per-target doc comments, the package
; manifests -- is a different consumer of the same model.
class RangerApiArtifactWriter {

  fn jsonEscape:string (value:string) {
    def out:string ""
    def i:int 0
    def n:int (strlen value)
    while (i < n) {
      def piece:string (substring value i (i + 1))
      ; ...and the same here: the piece is the thing being matched.
      switch piece {
        case "\"" {
          out = out + "\\\""
        }
        case "\\" {
          out = out + "\\\\"
        }
        case "\n" {
          out = out + "\\n"
        }
        case "\r" {
          out = out + "\\r"
        }
        case "\t" {
          out = out + "\\t"
        }
        default {
          out = out + piece
        }
      }
      i = i + 1
    }
    return out
  }

  fn jsonString:string (value:string) {
    return ("\"" + (this.jsonEscape(value)) + "\"")
  }

  fn jsonBool:string (value:boolean) {
    if value {
      return "true"
    }
    return "false"
  }

  fn jsonStringList:string (items:[string]) {
    def out:string "["
    for items s:string i {
      if (i > 0) {
        out = out + ", "
      }
      out = out + (this.jsonString(s))
    }
    return (out + "]")
  }

  fn docFields:string (doc:RangerDocBlock has:boolean) {
    if (has == false) {
      return ""
    }
    def out:string ""
    out = out + ", \"description\": " + (this.jsonString(doc.description))
    if ((strlen doc.since) > 0) {
      out = out + ", \"since\": " + (this.jsonString(doc.since))
    }
    if ((strlen doc.category) > 0) {
      out = out + ", \"category\": " + (this.jsonString(doc.category))
    }
    if ((strlen doc.platform) > 0) {
      out = out + ", \"platform\": " + (this.jsonString(doc.platform))
    }
    if doc.is_experimental {
      out = out + ", \"experimental\": true"
    }
    if ((array_length doc.see) > 0) {
      out = out + ", \"see\": " + (this.jsonStringList(doc.see))
    }
    if ((array_length doc.throws) > 0) {
      out = out + ", \"throws\": " + (this.jsonStringList(doc.throws))
    }
    if ((array_length doc.examples) > 0) {
      out = out + ", \"examples\": " + (this.jsonStringList(doc.examples))
    }
    if doc.is_deprecated {
      def dep:RangerDocDeprecation (unwrap doc.deprecation)
      out = out + ", \"deprecated\": {\"since\": " + (this.jsonString(dep.since))
      out = out + ", \"use\": " + (this.jsonString(dep.use))
      out = out + ", \"description\": " + (this.jsonString(dep.description)) + "}"
    }
    return out
  }

  fn writeJson:void (model:RangerApiModel ctx:RangerAppWriterContext wr:CodeWriter) {
    wr.out("{" true)
    wr.indent(1)
    wr.out(("\"generator\": \"ranger\"," ) true)
    wr.out(("\"module\": " + (this.jsonString(model.moduleName)) + ",") true)
    wr.out(("\"version\": " + (this.jsonString(model.version)) + ",") true)
    wr.out(("\"description\": " + (this.jsonString(model.description)) + ",") true)
    wr.out(("\"target\": " + (this.jsonString(ctx.targetLangName)) + ",") true)
    wr.out("\"classes\": [" true)
    wr.indent(1)
    def clIdx:int 0
    for model.classes c:RangerApiClass ci {
      if (clIdx > 0) {
        wr.out("," true)
      }
      clIdx = clIdx + 1
      wr.out("{" true)
      wr.indent(1)
      wr.out(("\"name\": " + (this.jsonString(c.name)) + ",") true)
      wr.out(("\"compiledName\": " + (this.jsonString(c.compiledName)) + ",") true)
      wr.out(("\"kind\": " + (this.jsonString(c.kind)) + ",") true)
      if ((strlen c.extendsName) > 0) {
        wr.out(("\"extends\": " + (this.jsonString(c.extendsName)) + ",") true)
      }
      wr.out(("\"public\": " + (this.jsonBool(c.is_public)) + ",") true)
      wr.out(("\"documented\": " + (this.jsonBool(c.has_doc)) + "") false)
      if c.has_doc {
        def cdoc:RangerDocBlock (unwrap c.doc)
        wr.out((this.docFields(cdoc true)) false)
      }
      wr.out("," true)
      wr.out("\"fields\": [" false)
      def fIdx:int 0
      for c.fields f:RangerApiField fi {
        if (fIdx > 0) {
          wr.out(", " false)
        }
        fIdx = fIdx + 1
        wr.out("{" false)
        wr.out(("\"name\": " + (this.jsonString(f.name))) false)
        wr.out((", \"compiledName\": " + (this.jsonString(f.compiledName))) false)
        wr.out((", \"type\": " + (this.jsonString(f.typeName))) false)
        wr.out((", \"static\": " + (this.jsonBool(f.is_static))) false)
        wr.out((", \"public\": " + (this.jsonBool(f.is_public))) false)
        wr.out((", \"documented\": " + (this.jsonBool(f.has_doc))) false)
        if f.has_doc {
          def fdoc:RangerDocBlock (unwrap f.doc)
          wr.out((this.docFields(fdoc true)) false)
        }
        wr.out("}" false)
      }
      wr.out("]," true)
      wr.out("\"methods\": [" true)
      wr.indent(1)
      def mIdx:int 0
      for c.methods m:RangerApiMethod mi {
        if (mIdx > 0) {
          wr.out("," true)
        }
        mIdx = mIdx + 1
        wr.out("{" false)
        wr.out(("\"name\": " + (this.jsonString(m.name))) false)
        wr.out((", \"compiledName\": " + (this.jsonString(m.compiledName))) false)
        wr.out((", \"static\": " + (this.jsonBool(m.is_static))) false)
        wr.out((", \"public\": " + (this.jsonBool(m.is_public))) false)
        wr.out((", \"documented\": " + (this.jsonBool(m.has_doc))) false)
        wr.out((", \"returns\": {\"type\": " + (this.jsonString(m.returnType))) false)
        wr.out((", \"description\": " + (this.jsonString(m.returnDoc)) + "}") false)
        wr.out(", \"params\": [" false)
        def pIdx:int 0
        for m.params p:RangerApiParam pi {
          if (pIdx > 0) {
            wr.out(", " false)
          }
          pIdx = pIdx + 1
          wr.out("{" false)
          wr.out(("\"name\": " + (this.jsonString(p.name))) false)
          wr.out((", \"compiledName\": " + (this.jsonString(p.compiledName))) false)
          wr.out((", \"type\": " + (this.jsonString(p.typeName))) false)
          wr.out((", \"description\": " + (this.jsonString(p.description))) false)
          wr.out("}" false)
        }
        wr.out("]" false)
        if m.has_doc {
          def mdoc:RangerDocBlock (unwrap m.doc)
          wr.out((this.docFields(mdoc true)) false)
        }
        wr.out("}" false)
      }
      wr.out("" true)
      wr.indent(-1)
      wr.out("]" true)
      wr.indent(-1)
      wr.out("}" false)
    }
    wr.out("" true)
    wr.indent(-1)
    wr.out("]" true)
    wr.indent(-1)
    wr.out("}" true)
  }

  fn writeMarkdown:void (model:RangerApiModel ctx:RangerAppWriterContext wr:CodeWriter) {
    def title:string model.moduleName
    if ((strlen title) == 0) {
      title = "API reference"
    }
    wr.out(("# " + title) true)
    if ((strlen model.version) > 0) {
      wr.out("" true)
      wr.out(("Version " + model.version) true)
    }
    if ((strlen model.description) > 0) {
      wr.out("" true)
      wr.out(model.description true)
    }
    for model.classes c:RangerApiClass ci {
      if (c.is_public == false) {
        continue
      }
      wr.out("" true)
      wr.out(("## " + c.name) true)
      if c.has_doc {
        def cdoc:RangerDocBlock (unwrap c.doc)
        if ((strlen cdoc.description) > 0) {
          wr.out("" true)
          wr.out(cdoc.description true)
        }
      }
      def wroteFields:boolean false
      for c.fields f:RangerApiField fi {
        if (f.is_public == false) {
          continue
        }
        if (wroteFields == false) {
          wr.out("" true)
          wr.out("### Fields" true)
          wr.out("" true)
          wr.out("| Name | Type | Description |" true)
          wr.out("| --- | --- | --- |" true)
          wroteFields = true
        }
        def fdesc:string ""
        if f.has_doc {
          def fdoc:RangerDocBlock (unwrap f.doc)
          fdesc = fdoc.description
        }
        wr.out(("| `" + f.name + "` | `" + f.typeName + "` | " + fdesc + " |") true)
      }
      for c.methods m:RangerApiMethod mi {
        if (m.is_public == false) {
          continue
        }
        wr.out("" true)
        def sig:string ("### `" + m.name + "(")
        for m.params p:RangerApiParam pi {
          if (pi > 0) {
            sig = sig + " "
          }
          sig = sig + p.name + ":" + p.typeName
        }
        sig = sig + ")` → `" + m.returnType + "`"
        wr.out(sig true)
        if m.has_doc {
          def mdoc:RangerDocBlock (unwrap m.doc)
          if ((strlen mdoc.description) > 0) {
            wr.out("" true)
            wr.out(mdoc.description true)
          }
          if mdoc.is_deprecated {
            def dep:RangerDocDeprecation (unwrap mdoc.deprecation)
            wr.out("" true)
            wr.out(("**Deprecated** since " + dep.since + ". " + dep.description) true)
          }
          if ((array_length m.params) > 0) {
            wr.out("" true)
            for m.params p:RangerApiParam pi {
              wr.out(("- `" + p.name + "` — " + p.description) true)
            }
          }
          if ((strlen mdoc.returns) > 0) {
            wr.out("" true)
            wr.out(("Returns: " + mdoc.returns) true)
          }
          if ((strlen mdoc.since) > 0) {
            wr.out("" true)
            wr.out(("Since " + mdoc.since) true)
          }
        }
      }
    }
  }

  ; A flat, sorted-by-declaration rendering of the PUBLIC surface only.
  ; Committed and diffed, it turns an API change into a diff hunk.
  fn writeReport:void (model:RangerApiModel wr:CodeWriter) {
    for model.classes c:RangerApiClass ci {
      if (c.is_public == false) {
        continue
      }
      wr.out(c.name true)
      for c.fields f:RangerApiField fi {
        if f.is_public {
          wr.out((c.name + "." + f.name + ": " + f.typeName) true)
        }
      }
      for c.methods m:RangerApiMethod mi {
        if m.is_public {
          def line:string (c.name + "." + m.name + "(")
          for m.params p:RangerApiParam pi {
            if (pi > 0) {
              line = line + ", "
            }
            line = line + p.name + ": " + p.typeName
          }
          line = line + "): " + m.returnType
          if m.has_doc {
            def mdoc:RangerDocBlock (unwrap m.doc)
            if ((strlen mdoc.since) > 0) {
              line = line + "   @since " + mdoc.since
            }
            if mdoc.is_deprecated {
              def dep:RangerDocDeprecation (unwrap mdoc.deprecation)
              line = line + "   @deprecated " + dep.since
            }
          }
          wr.out(line true)
        }
      }
    }
  }

  fn writeAll:void (model:RangerApiModel ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def dirName:string (ctx.getCompilerSetting("apidoc"))
    def formats:string "json,markdown"
    if (ctx.hasCompilerSetting("apiformat")) {
      formats = (ctx.getCompilerSetting("apiformat"))
    }
    def parts:[string] (strsplit formats ",")
    for parts fmt:string i {
      switch fmt {
        case "json" {
          def jw:CodeWriter (orig_wr.getFileWriter(dirName "api.json"))
          this.writeJson(model ctx jw)
        }
        case "markdown" {
          def mw:CodeWriter (orig_wr.getFileWriter(dirName "api.md"))
          this.writeMarkdown(model ctx mw)
        }
        case "report" {
          def rw:CodeWriter (orig_wr.getFileWriter(dirName "api.txt"))
          this.writeReport(model rw)
        }
        default {
        }
      }
    }
  }
}

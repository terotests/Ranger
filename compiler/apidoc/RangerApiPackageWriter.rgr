
; Writes the packaging a target's own ecosystem expects around the generated
; API, so the output is a package rather than a loose source file.
;
; The layout differs per target because the ecosystems disagree: npm wants one
; manifest beside an entry point, NuGet wants a project that turns on the XML
; documentation file the C# compiler produces. Both are driven from the same
; model.
class RangerApiPackageWriter {

  fn settingOr:string (ctx:RangerAppWriterContext key:string fallback:string) {
    if (ctx.hasCompilerSetting(key)) {
      return (ctx.getCompilerSetting(key))
    }
    return fallback
  }

  fn jsonEscape:string (value:string) {
    def w:RangerApiArtifactWriter (new RangerApiArtifactWriter)
    return (w.jsonEscape(value))
  }

  ; --------------------------------------------------------------- npm

  fn writeNpmPackage:void (model:RangerApiModel ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def name:string (this.settingOr(ctx "name" model.moduleName))
    def version:string (this.settingOr(ctx "version" "0.1.0"))
    def descr:string (this.settingOr(ctx "description" model.description))
    def author:string (this.settingOr(ctx "author" ""))
    def license:string (this.settingOr(ctx "license" "UNLICENSED"))
    def mainFile:string (this.settingOr(ctx "o" "output.js"))
    def isTs:boolean (ctx.hasCompilerFlag("typescript"))

    def wr:CodeWriter (orig_wr.getFileWriter("." "package.json"))
    wr.out("{" true)
    wr.indent(1)
    wr.out(("\"name\": \"" + (this.jsonEscape(name)) + "\",") true)
    wr.out(("\"version\": \"" + (this.jsonEscape(version)) + "\",") true)
    wr.out(("\"description\": \"" + (this.jsonEscape(descr)) + "\",") true)
    if ((strlen author) > 0) {
      wr.out(("\"author\": \"" + (this.jsonEscape(author)) + "\",") true)
    }
    wr.out(("\"license\": \"" + (this.jsonEscape(license)) + "\",") true)
    wr.out(("\"main\": \"" + (this.jsonEscape(mainFile)) + "\",") true)
    if isTs {
      def dts:string mainFile
      if (endsWith dts ".ts") {
        dts = (substring dts 0 ((strlen dts) - 3)) + ".d.ts"
      }
      wr.out(("\"types\": \"" + (this.jsonEscape(dts)) + "\",") true)
    }
    if (ctx.hasCompilerFlag("esm")) {
      wr.out("\"type\": \"module\"," true)
    }
    wr.out("\"files\": [" true)
    wr.indent(1)
    wr.out(("\"" + (this.jsonEscape(mainFile)) + "\",") true)
    wr.out("\"README.md\"" true)
    wr.indent(-1)
    wr.out("]," true)
    ; documentation.js reads the JSDoc the compiler wrote; nothing here is
    ; Ranger specific, which is the point.
    wr.out("\"scripts\": {" true)
    wr.indent(1)
    wr.out(("\"docs\": \"documentation build " + (this.jsonEscape(mainFile)) + " -f html -o docs/api\",") true)
    wr.out(("\"docs:md\": \"documentation build " + (this.jsonEscape(mainFile)) + " -f md -o API.md\",") true)
    wr.out(("\"docs:json\": \"documentation build " + (this.jsonEscape(mainFile)) + " -f json -o docs/api.json\",") true)
    wr.out(("\"docs:lint\": \"documentation lint " + (this.jsonEscape(mainFile)) + "\"") true)
    wr.indent(-1)
    wr.out("}," true)
    wr.out("\"devDependencies\": {" true)
    wr.indent(1)
    wr.out("\"documentation\": \"^14.0.3\"" true)
    wr.indent(-1)
    wr.out("}" true)
    wr.indent(-1)
    wr.out("}" true)
  }

  ; ------------------------------------------------------------- NuGet

  fn xmlEscape:string (value:string) {
    def w:RangerDocCommentWriter (new RangerDocCommentWriter)
    return (w.xmlEscape(value))
  }

  fn writeCsProject:void (model:RangerApiModel ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def name:string (this.settingOr(ctx "name" model.moduleName))
    if ((strlen name) == 0) {
      name = "RangerApi"
    }
    def version:string (this.settingOr(ctx "version" "0.1.0"))
    def descr:string (this.settingOr(ctx "description" model.description))
    def author:string (this.settingOr(ctx "author" ""))
    def license:string (this.settingOr(ctx "license" ""))
    def wr:CodeWriter (orig_wr.getFileWriter("." (name + ".csproj")))
    wr.out("<Project Sdk=\"Microsoft.NET.Sdk\">" true)
    wr.indent(1)
    wr.out("<PropertyGroup>" true)
    wr.indent(1)
    wr.out("<TargetFramework>netstandard2.0</TargetFramework>" true)
    wr.out("<LangVersion>latest</LangVersion>" true)
    wr.out(("<PackageId>" + (this.xmlEscape(name)) + "</PackageId>") true)
    wr.out(("<AssemblyName>" + (this.xmlEscape(name)) + "</AssemblyName>") true)
    wr.out(("<RootNamespace>" + (this.xmlEscape(name)) + "</RootNamespace>") true)
    wr.out(("<Version>" + (this.xmlEscape(version)) + "</Version>") true)
    if ((strlen descr) > 0) {
      wr.out(("<Description>" + (this.xmlEscape(descr)) + "</Description>") true)
    }
    if ((strlen author) > 0) {
      wr.out(("<Authors>" + (this.xmlEscape(author)) + "</Authors>") true)
    }
    if ((strlen license) > 0) {
      wr.out(("<PackageLicenseExpression>" + (this.xmlEscape(license)) + "</PackageLicenseExpression>") true)
    }
    ; This is the line the whole C# documentation path depends on: without it
    ; the compiler discards the XML comments and DocFX has nothing to read.
    wr.out("<GenerateDocumentationFile>true</GenerateDocumentationFile>" true)
    wr.out("<PackageReadmeFile>README.md</PackageReadmeFile>" true)
    wr.out("<IncludeSymbols>true</IncludeSymbols>" true)
    wr.out("<SymbolPackageFormat>snupkg</SymbolPackageFormat>" true)
    ; 1591 is "missing XML comment for a publicly visible type or member".
    ; -apistrict is where Ranger reports that, on the Ranger declaration, so
    ; the C# compiler repeating it against generated code is noise.
    wr.out("<NoWarn>$(NoWarn);1591</NoWarn>" true)
    wr.indent(-1)
    wr.out("</PropertyGroup>" true)
    wr.out("<ItemGroup>" true)
    wr.indent(1)
    wr.out("<None Include=\"README.md\" Pack=\"true\" PackagePath=\"\\\" />" true)
    wr.indent(-1)
    wr.out("</ItemGroup>" true)
    wr.indent(-1)
    wr.out("</Project>" true)
  }

  ; DocFX reads the assembly and its XML documentation file, so the project
  ; above is the whole input to the `metadata` stage. The `build` stage needs
  ; more than that, and this is where the config used to stop short: metadata
  ; writes `api/*.yml` and `api/toc.yml` but NEVER an `api/index.md`, so a
  ; content list of `api/**.yml` and `api/index.md` gave DocFX no landing page
  ; to render. It produced `_site/api/*.html`, no `_site/index.html`, exited 0
  ; and printed "0 error(s)" -- a site with no front door, reported as success.
  ; The landing page and the top-level toc are written here so the `build`
  ; stage always has content of its own.
  fn writeDocFxConfig:void (model:RangerApiModel ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def name:string (this.settingOr(ctx "name" model.moduleName))
    if ((strlen name) == 0) {
      name = "RangerApi"
    }
    def wr:CodeWriter (orig_wr.getFileWriter("." "docfx.json"))
    wr.out("{" true)
    wr.indent(1)
    wr.out("\"metadata\": [" true)
    wr.indent(1)
    wr.out("{" true)
    wr.indent(1)
    def projName:string (this.jsonEscape(name))
    wr.out(("\"src\": [ { \"files\": [ \"" + projName + ".csproj\" ] } ],") true)
    wr.out("\"dest\": \"api\"" true)
    wr.indent(-1)
    wr.out("}" true)
    wr.indent(-1)
    wr.out("]," true)
    wr.out("\"build\": {" true)
    wr.indent(1)
    wr.out("\"content\": [" true)
    wr.indent(1)
    wr.out("{ \"files\": [ \"api/**.yml\", \"api/**.md\" ] }," true)
    wr.out("{ \"files\": [ \"index.md\", \"toc.yml\" ] }" true)
    wr.indent(-1)
    wr.out("]," true)
    wr.out("\"dest\": \"_site\"" true)
    wr.indent(-1)
    wr.out("}" true)
    wr.indent(-1)
    wr.out("}" true)
    this.writeDocFxHome(model ctx name orig_wr)
  }

  ; The two files the `build` stage renders into `_site/index.html` and the
  ; site navigation. Without them DocFX has only the generated `api/` yml,
  ; which it renders without ever producing a root page.
  fn writeDocFxHome:void (model:RangerApiModel ctx:RangerAppWriterContext name:string orig_wr:CodeWriter) {
    def descr:string (this.settingOr(ctx "description" model.description))
    def index:CodeWriter (orig_wr.getFileWriter("." "index.md"))
    index.out(("# " + name) true)
    index.out("" true)
    if ((strlen descr) > 0) {
      index.out(descr true)
      index.out("" true)
    }
    index.out("Generated from Ranger declarations. Every member below carries the" true)
    index.out("documentation written on the Ranger source it was compiled from." true)
    index.out("" true)
    index.out("- [API reference](api/)" true)
    def toc:CodeWriter (orig_wr.getFileWriter("." "toc.yml"))
    toc.out("- name: API reference" true)
    toc.out("  href: api/" true)
  }

  ; -------------------------------------------------- Swift / SwiftPM

  ; A module name, not a namespace: Swift has no namespace hierarchy, so a
  ; dotted logical module name collapses into one identifier.
  fn swiftModuleName:string (raw:string) {
    def parts:[string] (strsplit raw ".")
    def out:string ""
    for parts piece:string i {
      out = out + piece
    }
    if ((strlen out) == 0) {
      out = "RangerApi"
    }
    return out
  }

  fn writeSwiftPackage:void (model:RangerApiModel ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def raw:string (this.settingOr(ctx "name" model.moduleName))
    def moduleName:string (this.swiftModuleName(raw))
    def srcFile:string (this.settingOr(ctx "o" "output.swift"))
    def wr:CodeWriter (orig_wr.getFileWriter("." "Package.swift"))
    wr.out("// swift-tools-version:5.7" true)
    wr.out("import PackageDescription" true)
    wr.out("" true)
    wr.out("let package = Package(" true)
    wr.indent(1)
    wr.out(("name: \"" + moduleName + "\",") true)
    wr.out("products: [" true)
    wr.indent(1)
    wr.out((".library(name: \"" + moduleName + "\", targets: [\"" + moduleName + "\"])") true)
    wr.indent(-1)
    wr.out("]," true)
    wr.out("targets: [" true)
    wr.indent(1)
    ; a flat layout: the target is the output directory itself, with the one
    ; generated file named explicitly. The Sources/<Target>/ tree is the
    ; multi-file layout, which is a separate piece of work.
    wr.out(".target(" true)
    wr.indent(1)
    wr.out(("name: \"" + moduleName + "\",") true)
    wr.out("path: \".\"," true)
    wr.out(("sources: [\"" + srcFile + "\"]") true)
    wr.indent(-1)
    wr.out(")" true)
    wr.indent(-1)
    wr.out("]" true)
    wr.indent(-1)
    wr.out(")" true)
  }

  ; The DocC catalog. `## Topics` is the reference organisation, and it is
  ; built from the `category` of each public type -- which is what that entry
  ; is for.
  fn writeDocCCatalog:void (model:RangerApiModel ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def raw:string (this.settingOr(ctx "name" model.moduleName))
    def moduleName:string (this.swiftModuleName(raw))
    def dir:string (moduleName + ".docc")
    def wr:CodeWriter (orig_wr.getFileWriter(dir (moduleName + ".md")))
    wr.out(("# ``" + moduleName + "``") true)
    wr.out("" true)
    if ((strlen model.description) > 0) {
      wr.out(model.description true)
      wr.out("" true)
    }
    wr.out("## Topics" true)

    def categories:[string]
    def seen:[string:boolean]
    for model.classes c:RangerApiClass ci {
      if (c.is_public == false) {
        continue
      }
      def cat:string "Types"
      if c.has_doc {
        def cdoc:RangerDocBlock (unwrap c.doc)
        if ((strlen cdoc.category) > 0) {
          cat = cdoc.category
        }
      }
      if ((has seen cat) == false) {
        set seen cat true
        push categories cat
      }
    }
    for categories cat:string i {
      wr.out("" true)
      wr.out(("### " + cat) true)
      wr.out("" true)
      for model.classes c:RangerApiClass ci {
        if (c.is_public == false) {
          continue
        }
        def ccat:string "Types"
        if c.has_doc {
          def cdoc:RangerDocBlock (unwrap c.doc)
          if ((strlen cdoc.category) > 0) {
            ccat = cdoc.category
          }
        }
        if (ccat == cat) {
          wr.out(("- ``" + c.name + "``") true)
        }
      }
    }
  }

  ; ------------------------------------------------- Kotlin / Gradle + Dokka

  fn writeKotlinGradle:void (model:RangerApiModel ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def raw:string (this.settingOr(ctx "name" model.moduleName))
    def version:string (this.settingOr(ctx "version" "0.1.0"))
    def descr:string (this.settingOr(ctx "description" model.description))
    def srcFile:string (this.settingOr(ctx "o" "output.kt"))
    ; a dotted name is a Maven coordinate: everything before the last dot is
    ; the group, the last segment is the artifact
    def groupId:string ""
    def artifactId:string raw
    def parts:[string] (strsplit raw ".")
    def n:int (array_length parts)
    if (n > 1) {
      artifactId = (itemAt parts (n - 1))
      def gi:int 0
      while (gi < (n - 1)) {
        if (gi > 0) {
          groupId = groupId + "."
        }
        groupId = groupId + (itemAt parts gi)
        gi = gi + 1
      }
    }
    def wr:CodeWriter (orig_wr.getFileWriter("." "build.gradle.kts"))
    wr.out("plugins {" true)
    wr.indent(1)
    wr.out("kotlin(\"jvm\") version \"2.0.21\"" true)
    wr.out("id(\"org.jetbrains.dokka\") version \"1.9.20\"" true)
    wr.out("`maven-publish`" true)
    wr.indent(-1)
    wr.out("}" true)
    wr.out("" true)
    if ((strlen groupId) > 0) {
      wr.out(("group = \"" + groupId + "\"") true)
    }
    wr.out(("version = \"" + version + "\"") true)
    wr.out("" true)
    wr.out("repositories { mavenCentral() }" true)
    wr.out("" true)
    ; deliberately NO jvmToolchain(...): pinning a version the machine does
    ; not have fails the build before it compiles anything, and a generated
    ; file cannot know which JDKs are installed. Add one when the project
    ; needs a specific bytecode level.
    wr.out("" true)
    ; a flat layout: the sources are the output directory itself. The build
    ; script is .kts and is excluded so Gradle does not try to compile it.
    wr.out("sourceSets.main {" true)
    wr.indent(1)
    wr.out("kotlin.setSrcDirs(listOf(\".\"))" true)
    wr.out(("kotlin.include(\"" + srcFile + "\")") true)
    wr.indent(-1)
    wr.out("}" true)
    wr.out("" true)
    wr.out("publishing {" true)
    wr.indent(1)
    wr.out("publications {" true)
    wr.indent(1)
    wr.out("create<MavenPublication>(\"maven\") {" true)
    wr.indent(1)
    wr.out(("artifactId = \"" + artifactId + "\"") true)
    wr.out("from(components[\"java\"])" true)
    if ((strlen descr) > 0) {
      wr.out(("pom { description.set(\"" + descr + "\") }") true)
    }
    wr.indent(-1)
    wr.out("}" true)
    wr.indent(-1)
    wr.out("}" true)
    wr.indent(-1)
    wr.out("}" true)
  }

  ; Dokka reads the KDoc the compiler wrote. This only names the module, which
  ; is the one thing it cannot infer.
  fn writeDokkaModuleDoc:void (model:RangerApiModel ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def raw:string (this.settingOr(ctx "name" model.moduleName))
    def wr:CodeWriter (orig_wr.getFileWriter("." "module.md"))
    wr.out(("# Module " + raw) true)
    wr.out("" true)
    if ((strlen model.description) > 0) {
      wr.out(model.description true)
    }
  }

  ; ------------------------------------------------------- Dart / pub

  ; Dart's only private form is a leading underscore, which renames every call
  ; site. The idiomatic package therefore expresses its API surface as an
  ; EXPORT list: the implementation is a library nobody imports directly, and
  ; the package library re-exports the public names with `show`.
  ;
  ; That list is exactly what ApiIR holds, and it is exactly the kind of list
  ; that rots when a person maintains it. So Ranger writes it.
  fn writeDartBarrel:void (model:RangerApiModel ctx:RangerAppWriterContext orig_wr:CodeWriter node:CodeNode) {
    def pkgName:string (this.settingOr(ctx "name" model.moduleName))
    if ((strlen pkgName) == 0) {
      pkgName = "ranger_api"
    }
    def srcFile:string (this.settingOr(ctx "o" "output.dart"))
    def barrelFile:string (pkgName + ".dart")
    ; the barrel sits one level ABOVE the implementation: dartdoc documents
    ; `lib/` and deliberately skips `lib/src/`, so the split is what makes
    ; `doc { public }` decide what appears in the generated documentation
    def wr:CodeWriter (orig_wr.getFileWriter(".." barrelFile))
    wr.out(("/// " + pkgName) true)
    if ((strlen model.description) > 0) {
      wr.out("///" true)
      wr.out(("/// " + model.description) true)
    }
    wr.out(("library " + pkgName + ";") true)
    wr.out("" true)
    def names:[string]
    for model.classes c:RangerApiClass ci {
      if c.is_public {
        push names c.name
      }
    }
    if ((array_length names) == 0) {
      wr.out(("// no public API: nothing in " + srcFile + " carries `doc { public }`") true)
      return
    }
    wr.out(("export 'src/" + srcFile + "'") false)
    wr.out("" true)
    wr.out("    show" false)
    for names n:string i {
      if (i > 0) {
        wr.out("," false)
      }
      wr.out((" " + n) false)
    }
    wr.out(";" true)
  }

  ; ------------------------------------------------------ Python / pypi

  fn pyModuleName:string (raw:string) {
    def out:string ""
    def i:int 0
    def n:int (strlen raw)
    while (i < n) {
      def ch:string (substring raw i (i + 1))
      if (ch == "-") {
        out = out + "_"
      } {
        if (ch == ".") {
          out = out + "_"
        } {
          out = out + ch
        }
      }
      i = i + 1
    }
    return out
  }

  fn writePyProject:void (model:RangerApiModel ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def name:string (this.settingOr(ctx "name" model.moduleName))
    if ((strlen name) == 0) {
      name = "ranger_api"
    }
    def version:string (this.settingOr(ctx "version" "0.1.0"))
    def descr:string (this.settingOr(ctx "description" model.description))
    def author:string (this.settingOr(ctx "author" ""))
    def license:string (this.settingOr(ctx "license" ""))
    def srcFile:string (this.settingOr(ctx "o" "output.py"))
    def modName:string srcFile
    if (endsWith modName ".py") {
      modName = (substring modName 0 ((strlen modName) - 3))
    }
    def wr:CodeWriter (orig_wr.getFileWriter("." "pyproject.toml"))
    wr.out("[build-system]" true)
    wr.out("requires = [\"setuptools>=61\"]" true)
    wr.out("build-backend = \"setuptools.build_meta\"" true)
    wr.out("" true)
    wr.out("[project]" true)
    wr.out(("name = \"" + name + "\"") true)
    wr.out(("version = \"" + version + "\"") true)
    if ((strlen descr) > 0) {
      wr.out(("description = \"" + descr + "\"") true)
    }
    if ((strlen license) > 0) {
      wr.out(("license = \"" + license + "\"") true)
    }
    if ((strlen author) > 0) {
      wr.out(("authors = [{ name = \"" + author + "\" }]") true)
    }
    wr.out("requires-python = \">=3.9\"" true)
    wr.out("" true)
    wr.out("[tool.setuptools]" true)
    wr.out(("py-modules = [\"" + modName + "\"]") true)
  }

  ; `__all__` is Python's export surface, and the same argument as the Dart
  ; barrel applies: it is derivable, so it should be derived.
  fn writePyAll:void (model:RangerApiModel ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def srcFile:string (this.settingOr(ctx "o" "output.py"))
    def wr:CodeWriter (orig_wr.getFileWriter("." srcFile))
    def names:[string]
    for model.classes c:RangerApiClass ci {
      if c.is_public {
        push names c.name
      }
    }
    wr.out("" true)
    ; PEP 258. Without it a Google-style `Args:` block is rendered as plain
    ; text: pdoc and mkdocstrings read this attribute to know how to parse the
    ; docstrings, and declaring it in the module is what keeps the tooling
    ; free of project-specific configuration.
    wr.out("__docformat__ = \"google\"" true)
    wr.out("" true)
    if ((array_length names) == 0) {
      return
    }
    wr.out("" true)
    wr.out("# The public API surface, from the `doc { public }` declarations." true)
    wr.out("__all__ = [" false)
    for names n:string i {
      if (i > 0) {
        wr.out(", " false)
      }
      wr.out(("\"" + n + "\"") false)
    }
    wr.out("]" true)
  }

  ; --------------------------------------------------------------- README

  fn writeReadme:void (model:RangerApiModel ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def wr:CodeWriter (orig_wr.getFileWriter("." "README.md"))
    def aw:RangerApiArtifactWriter (new RangerApiArtifactWriter)
    aw.writeMarkdown(model ctx wr)
  }

  ; `dart doc` documents the libraries under `lib/` and nothing else -- a flat
  ; directory gives "dartdoc could not find any libraries to document" -- and it
  ; skips `lib/src/`, which is where an idiomatic package keeps what it does not
  ; publish. So the Dart package expects the compiler output in `<pkg>/lib/src`,
  ; the generated package library one level above it, and the manifest two.
  fn writeDartPubspec:void (model:RangerApiModel ctx:RangerAppWriterContext orig_wr:CodeWriter) {
    def pkgName:string (this.settingOr(ctx "name" model.moduleName))
    if ((strlen pkgName) == 0) {
      pkgName = "ranger_api"
    }
    def version:string (this.settingOr(ctx "version" "0.1.0"))
    def descr:string (this.settingOr(ctx "description" model.description))
    def wr:CodeWriter (orig_wr.getFileWriter("../.." "pubspec.yaml"))
    wr.out(("name: " + pkgName) true)
    if ((strlen descr) > 0) {
      wr.out(("description: " + descr) true)
    }
    wr.out(("version: " + version) true)
    wr.out("publish_to: none" true)
    wr.out("" true)
    wr.out("environment:" true)
    wr.out("  sdk: '>=3.0.0 <4.0.0'" true)
  }

  fn writeAll:void (model:RangerApiModel ctx:RangerAppWriterContext orig_wr:CodeWriter node:CodeNode) {
    switch ctx.targetLangName {
      case "es6" {
        this.writeNpmPackage(model ctx orig_wr)
        this.writeReadme(model ctx orig_wr)
      }
      case "csharp" {
        this.writeCsProject(model ctx orig_wr)
        this.writeDocFxConfig(model ctx orig_wr)
        this.writeReadme(model ctx orig_wr)
      }
      case "swift6" {
        this.writeSwiftPackage(model ctx orig_wr)
        this.writeDocCCatalog(model ctx orig_wr)
        this.writeReadme(model ctx orig_wr)
      }
      case "swift3" {
        this.writeSwiftPackage(model ctx orig_wr)
        this.writeDocCCatalog(model ctx orig_wr)
        this.writeReadme(model ctx orig_wr)
      }
      case "kotlin" {
        this.writeKotlinGradle(model ctx orig_wr)
        this.writeDokkaModuleDoc(model ctx orig_wr)
        this.writeReadme(model ctx orig_wr)
      }
      case "dart" {
        this.writeDartBarrel(model ctx orig_wr node)
        this.writeDartPubspec(model ctx orig_wr)
        this.writeReadme(model ctx orig_wr)
      }
      case "python" {
        this.writePyProject(model ctx orig_wr)
        this.writePyAll(model ctx orig_wr)
        this.writeReadme(model ctx orig_wr)
      }
      default {
        this.writeReadme(model ctx orig_wr)
      }
    }
  }
}

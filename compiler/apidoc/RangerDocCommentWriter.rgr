  fn writePyDocForMethod:void (fd:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    if (fd.has_doc == false) {
      return
    }
    def doc:RangerDocBlock (unwrap fd.docBlock)
    def view:RangerDocBlock (doc.viewFor("python"))
    this.loadExamples(view ctx)
    def ps:[RangerApiParam] (this.paramsOf(fd view false))
    ; the Ranger type names have to become Python ones for the Args: block
    for ps p:RangerApiParam i {
      p.typeName = (this.pyTypeName(p.typeName))
    }
    def rn:CodeNode (unwrap fd.nameNode)
    def rt:string (this.pyTypeOf(rn))
    this.writePyDoc(view rt ps wr)
  }


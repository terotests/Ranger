  ; The ReplaceWith argument list comes from the REPLACEMENT's own signature,
  ; looked up in the class that declares it. If there is no such method the
  ; hint is left out rather than guessed.
  fn kotlinReplaceWith:string (cl:RangerAppClassDesc doc:RangerDocBlock) {
    if (doc.is_deprecated == false) {
      return ""
    }
    def dep:RangerDocDeprecation (unwrap doc.deprecation)
    if ((strlen dep.use) == 0) {
      return ""
    }
    def target@(optional):RangerAppFunctionDesc (cl.findMethod(dep.use))
    if (null? target) {
      return ""
    }
    def t:RangerAppFunctionDesc (unwrap target)
    def out:string (dep.use + "(")
    for t.params p:RangerAppParamDesc i {
      if (i > 0) {
        out = out + ", "
      }
      out = out + p.compiledName
    }
    return (out + ")")
  }

  fn writeKotlinDocForMethod:void (cl:RangerAppClassDesc fd:RangerAppFunctionDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    if (fd.has_doc == false) {
      return
    }
    def doc:RangerDocBlock (unwrap fd.docBlock)
    def view:RangerDocBlock (doc.viewFor("kotlin"))
    this.loadExamples(view ctx)
    def ps:[RangerApiParam] (this.paramsOf(fd view false))
    def rn:CodeNode (unwrap fd.nameNode)
    def rt:string (this.kotlinTypeName(rn.type_name))
    this.writeKotlinDoc(view rt ps wr)
    this.writeKotlinAttrs(view (this.kotlinReplaceWith(cl view)) wr)
  }

  fn writeKotlinDocForClass:void (cl:RangerAppClassDesc ctx:RangerAppWriterContext wr:CodeWriter) {
    if (cl.has_doc == false) {

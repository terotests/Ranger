  ; The visibility modifier for a declaration, from its doc block.
  ;
  ; The gate is always the CLASS: a class with no doc block is not opted into
  ; the API model at all and gets `whenLegacy` -- whatever the target wrote
  ; before this feature existed, so no existing program changes. That value is
  ; NOT the same as `whenPublic`: C# wrote `public ` on everything and Swift
  ; and Kotlin wrote nothing, and reusing the public form for the legacy case
  ; silently made every undocumented Swift class part of the module's API.
  ;
  ; `whenPublic` and `whenInternal` also differ per target because the language
  ; defaults do: Swift and C# default to internal, Kotlin defaults to public.
  fn memberVisibility:string (cl:RangerAppClassDesc member:RangerAppParamDesc whenLegacy:string whenPublic:string whenInternal:string) {
    if (cl.has_doc == false) {
      return whenLegacy
    }
    if (member.has_doc == false) {
      return whenInternal
    }
    def md@(optional):RangerDocBlock member.docBlock
    if (null? md) {
      return whenInternal
    }
    def doc:RangerDocBlock (unwrap md)
    if doc.is_public {
      return whenPublic
    }
    return whenInternal
  }

  fn classVisibility:string (cl:RangerAppClassDesc whenLegacy:string whenPublic:string whenInternal:string) {
    if (cl.has_doc == false) {
      return whenLegacy
    }
    def cd@(optional):RangerDocBlock cl.docBlock
    if (null? cd) {
      return whenInternal
    }
    def doc:RangerDocBlock (unwrap cd)
    if doc.is_public {
      return whenPublic
    }
    return whenInternal
  }

  fn writeJsDocForField:void (p:RangerAppParamDesc wr:CodeWriter) {
    this.clearExamples()
    if (p.has_doc == false) {
      return
    }
    def doc:RangerDocBlock (unwrap p.docBlock)
    def view:RangerDocBlock (doc.viewFor("es6"))
    def ps:[RangerApiParam]
    def pn:CodeNode (unwrap p.nameNode)
    ; the type is the compiler's, never the author's: PLAN_API_DOCS.md §3
    this.writeJsDocTyped(view "void" ps (this.jsTypeOf(pn)) wr)
  }

  fn writeCsDocForField:void (p:RangerAppParamDesc wr:CodeWriter) {
    this.clearExamples()
    if (p.has_doc == false) {
      return
    }
    def doc:RangerDocBlock (unwrap p.docBlock)
    def view:RangerDocBlock (doc.viewFor("csharp"))
    def ps:[RangerApiParam]
    this.writeCsDoc(view "void" ps wr)
    this.writeCsAttrs(view wr)
  }
}


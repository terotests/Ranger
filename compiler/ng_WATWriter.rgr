; SPDX-License-Identifier: MIT


Import "ng_LowIR.rgr"

; Low IR -> WebAssembly text (WAT)
; Emits structured if / while (not arbitrary CFG).

class WATWriter {

  ; string-literal global name -> its static byte address in linear memory
  def strAddrs:[string:int]

  ; class name -> its type-descriptor header address in the static data segment
  def typeDescAddrs:[string:int]

  ; hoisted lambda function names, table-index order (position = call_indirect idx)
  def lambdaFuncs:[string]

  fn lambdaFuncIndex:int (name:string) {
    def idx 0
    for this.lambdaFuncs f:string i {
      if (f == name) {
        return idx
      }
      idx = (+ idx 1)
    }
    return 0
  }

  ; A call_indirect signature "t0,t1,…:ret" -> a wasm type name and its decl.
  ; The leading param is always the closure env (i32).
  fn sigTypeName:string (callSig:string) {
    def parts:[string] (strsplit callSig ":")
    def params (itemAt parts 0)
    def ret ""
    if ((array_length parts) > 1) {
      ret = (itemAt parts 1)
    }
    def s:string "sig"
    def ps:[string] (strsplit params ",")
    for ps p:string i {
      if ((strlen p) > 0) {
        s = (s + ("_" + p))
      }
    }
    s = (s + ("__" + ret))
    return s
  }

  fn sigTypeDecl:string (callSig:string) {
    def parts:[string] (strsplit callSig ":")
    def params (itemAt parts 0)
    def ret ""
    if ((array_length parts) > 1) {
      ret = (itemAt parts 1)
    }
    def out:string ("  (type $" + ((this.sigTypeName(callSig)) + " (func"))
    def ps:[string] (strsplit params ",")
    def hasParam false
    for ps p:string i {
      if ((strlen p) > 0) {
        if (hasParam == false) {
          out = (out + " (param")
          hasParam = true
        }
        out = (out + (" " + (this.watType(p))))
      }
    }
    if hasParam {
      out = (out + ")")
    }
    if ((strlen ret) > 0) {
      if (ret != "void") {
        out = (out + (" (result " + ((this.watType(ret)) + ")")))
      }
    }
    out = (out + "))")
    return out
  }

  ; --- string literal data segments --------------------------------------
  ; Layout: [0,16) control, [16, heapEnd) literals, heapEnd.. heap. The heap
  ; base (heapEnd) is written to Mem[4]; ranger_heap.base() reads it. Literals
  ; are null-terminated UTF-8 char* buffers, matching the char* string model.
  fn utf8Encode:[int] (text:string) {
    def bytes:[int]
    def i 0
    def n (strlen text)
    while (< i n) {
      def c (charAt text i)
      if (< c 128) {
        push bytes c
      } {
        if (< c 2048) {
          push bytes (bit_or 192 (bit_shr c 6))
          push bytes (bit_or 128 (bit_and c 63))
        } {
          push bytes (bit_or 224 (bit_shr c 12))
          push bytes (bit_or 128 (bit_and (bit_shr c 6) 63))
          push bytes (bit_or 128 (bit_and c 63))
        }
      }
      i = (+ i 1)
    }
    return bytes
  }

  fn hexDigit:string (d:int) {
    if (< d 10) {
      return ("" + d)
    }
    return (strfromcode (+ 97 (- d 10)))
  }

  fn hexByte:string (b:int) {
    return ("\\" + ((this.hexDigit((bit_and (bit_shr b 4) 15))) + (this.hexDigit((bit_and b 15)))))
  }

  fn dataEscape:string (bytes:[int]) {
    def s ""
    for bytes b:int i {
      s = (s + (this.hexByte(b)))
    }
    return s
  }

  fn leWord:string (v:int) {
    def s ""
    s = (s + (this.hexByte((bit_and v 255))))
    s = (s + (this.hexByte((bit_and (bit_shr v 8) 255))))
    s = (s + (this.hexByte((bit_and (bit_shr v 16) 255))))
    s = (s + (this.hexByte((bit_and (bit_shr v 24) 255))))
    return s
  }

  fn align4:int (a:int) {
    return (bit_and (+ a 3) (bit_xor -1 3))
  }

  ; The owned flag the WAT backend emits for a field. String fields carry their
  ; declared owned flag; OBJECT fields (kind 1) are always owned on WASM — stores
  ; retain a borrowed value / move a fresh one, so the destructor releases each
  ; exactly once (RC handles aliasing; cycles leak but never double-free).
  ; ptr-array fields (kind 2) stay borrow.
  fn fieldOwnedFlag:int (fd:LowIRTypeFieldDesc) {
    if (fd.kind == 1) {
      return 1
    }
    return fd.owned
  }

  ; A type descriptor is worth emitting only if it has at least one owned field
  ; (the destructor walk does nothing otherwise).
  fn descHasOwned:boolean (td:LowIRTypeDesc) {
    for td.fields fd:LowIRTypeFieldDesc i {
      if ((this.fieldOwnedFlag(fd)) == 1) {
        return true
      }
    }
    return false
  }

  fn moduleHasOwnedTypeDescs:boolean (module:LowIRModule) {
    for module.typeDescs td:LowIRTypeDesc i {
      if (this.descHasOwned(td)) {
        return true
      }
    }
    return false
  }

  ; Emit the static data segment: string literals from 16, then type descriptors
  ; (field arrays + 12-byte headers) that recursive object destruction reads.
  ; The heap base (end of all static data, rounded to 16) is written to Mem[4].
  ; Runtime layout — TypeDesc: [ size | fieldCount | fieldsPtr ];
  ; Field(12): [ offset | kind | owned ]   (kind 0=string 1=object 2=ptrarray).
  fn emitStaticData:void (module:LowIRModule wr:CodeWriter) {
    def addr 16
    for module.stringGlobals g:LowIRStringGlobal i {
      def bytes (this.utf8Encode(g.text))
      if g.withNewline {
        push bytes 10
      }
      set this.strAddrs g.name addr
      wr.out(("  (data (i32.const " + (("" + addr) + (") \"" + ((this.dataEscape(bytes)) + "\\00\")")))) true)
      addr = (+ addr (+ (array_length bytes) 1))
    }
    ; type descriptors (4-aligned so the runtime's i32 loads stay aligned)
    for module.typeDescs td:LowIRTypeDesc i {
      if (this.descHasOwned(td)) {
        addr = (this.align4(addr))
        def fieldsPtr addr
        for td.fields fd:LowIRTypeFieldDesc j {
          def fw ""
          fw = (fw + (this.leWord(fd.offset)))
          fw = (fw + (this.leWord(fd.kind)))
          fw = (fw + (this.leWord((this.fieldOwnedFlag(fd)))))
          wr.out(("  (data (i32.const " + (("" + addr) + (") \"" + (fw + "\")")))) true)
          addr = (+ addr 12)
        }
        def hdrPtr addr
        def hw ""
        hw = (hw + (this.leWord(td.size)))
        hw = (hw + (this.leWord((array_length td.fields))))
        hw = (hw + (this.leWord(fieldsPtr)))
        wr.out(("  (data (i32.const " + (("" + addr) + (") \"" + (hw + "\")")))) true)
        set this.typeDescAddrs td.className hdrPtr
        addr = (+ addr 12)
      }
    }
    ; heap base = end of static data, rounded up to 16; stored at Mem[4]
    def base (bit_and (+ addr 15) (bit_xor -1 15))
    wr.out(("  (data (i32.const 4) \"" + ((this.leWord(base)) + "\")")) true)
  }

  fn wasmName:string (llvmName:string) {
    if ((strlen llvmName) == 0) {
      return ""
    }
    def ch (charAt llvmName 0)
    def pct:int (to_int (charcode "%"))
    if (ch == pct) {
      return ("$" + (substring llvmName 1 (strlen llvmName)))
    }
    return ("$" + llvmName)
  }

  ; A GEP result (address of a struct field / memory slot) is the ONLY operand
  ; for which a `load`/`store` op must emit a real i32.load / i32.store. GEP
  ; temps are the only names produced by freshTemp("f"), i.e. "%.f0", "%.f1", ...
  ; so they are exactly the operands whose char 1 is '.' (46) and char 2 is 'f'
  ; (102). Every promoted local is "%<var>_addr" (char 1 is never '.'), so this
  ; test never mistakes a local slot for a memory pointer. Sniffing only char 1
  ; (the historic bug) always saw '.', and sniffing only char 2 would misfire on
  ; a local like "%offset_addr".
  fn isGepTemp:boolean (name:string) {
    if ((strlen name) < 3) {
      return false
    }
    if ((charAt name 1) != 46) {
      return false
    }
    if ((charAt name 2) != 102) {
      return false
    }
    return true
  }

  fn moduleUsesHeap:boolean (module:LowIRModule) {
    return (LowIRUtil.moduleUsesHeap(module))
  }

  ; Map a LowIR type to its wasm value type. Only f64 is a distinct wasm type;
  ; i1 (booleans) and every pointer/int are i32.
  fn watType:string (irType:string) {
    if (irType == "f64") {
      return "f64"
    }
    return "i32"
  }

  ; name -> wasm value type for a function's SSA temps, from each defining
  ; instruction's result type. Used to declare locals with the right type.
  fn localTypeMap:[string:string] (fn:LowIRFunction) {
    def m:[string:string]
    for fn.blocks bb:LowIRBlock i {
      for bb.instrs ins:LowIRInstr j {
        if ((strlen ins.dest) > 0) {
          set m (this.wasmName(ins.dest)) (this.watType(ins.irType))
        }
      }
    }
    return m
  }

  fn localTypeOf:string (m:[string:string] wn:string) {
    if (has m wn) {
      return (unwrap (get m wn))
    }
    return "i32"
  }

  fn writeModule:void (module:LowIRModule wr:CodeWriter) {
    wr.out("(module" true)
    def hasLiterals ((array_length module.stringGlobals) > 0)
    def hasTypeDescs (this.moduleHasOwnedTypeDescs(module))
    def hasStatic (hasLiterals || hasTypeDescs)
    if ((this.moduleUsesHeap(module)) || hasStatic) {
      wr.out("  (memory (export \"memory\") 1)" true)
      wr.out("  (global $heap_ptr (mut i32) (i32.const 0))" true)
    }
    if hasStatic {
      this.emitStaticData(module wr)
    }
    ; lambda call_indirect type signatures, then the function table + elem
    this.lambdaFuncs = module.lambdaTableFuncs
    for module.lambdaSigs sig:string i {
      wr.out((this.sigTypeDecl(sig)) true)
    }
    if ((array_length module.lambdaTableFuncs) > 0) {
      def elem:string "  (table funcref (elem"
      for module.lambdaTableFuncs lf:string i {
        elem = (elem + (" $" + lf))
      }
      elem = (elem + "))")
      wr.out(elem true)
    }
    ; one mutable global per singleton class, holding its lazy instance pointer
    for module.singletonClasses sc:string i {
      wr.out(("  (global $singleton_" + (sc + " (mut i32) (i32.const 0))")) true)
    }
    for module.functions fn:LowIRFunction i {
      this.writeFunction(fn wr fn.exportFn)
    }
    wr.out(")" true)
  }

  fn findBlockIdx:int (fn:LowIRFunction label:string) {
    def cnt (array_length fn.blocks)
    def ii:int 0
    while (ii < cnt) {
      def bb (itemAt fn.blocks ii)
      if (bb.label == label) {
        return ii
      }
      ii = ii + 1
    }
    return -1
  }

  ; A `while` cond header is a br_if that some LATER block branches back to (the
  ; loop back-edge). An `if` header is only ever reached by fall-through, never
  ; by an explicit `br`, and an if/else merge is only branched to from EARLIER
  ; blocks — so scanning strictly after the header for a `br` to it distinguishes
  ; a loop from an if regardless of how complex the loop body is.
  fn isWhileHeader:boolean (fn:LowIRFunction condIdx:int) {
    if (condIdx < 0) {
      return false
    }
    def condBb (itemAt fn.blocks condIdx)
    if (condBb.termKind != "br_if") {
      return false
    }
    def cnt (array_length fn.blocks)
    def ii (+ condIdx 1)
    while (< ii cnt) {
      def b (itemAt fn.blocks ii)
      if (b.termKind == "br") {
        if (b.termTarget == condBb.label) {
          return true
        }
      }
      ii = (+ ii 1)
    }
    return false
  }

  fn collectLocals:[string] (fn:LowIRFunction) {
    def names:[string]
    def seen:[string:string]
    for fn.params p:LowIRParam i {
      set seen p.name "param"
    }
    for fn.blocks bb:LowIRBlock i {
      for bb.instrs ins:LowIRInstr i {
        if ((strlen ins.dest) > 0) {
          def wn (this.wasmName(ins.dest))
          if (has seen wn) {
            continue
          }
          set seen wn "local"
          push names wn
        }
      }
    }
    return names
  }

  fn writeBlockInstrs:void (bb:LowIRBlock wr:CodeWriter) {
    for bb.instrs ins:LowIRInstr i {
      this.writeInstr(ins wr)
    }
  }

  fn writeFunction:void (fn:LowIRFunction wr:CodeWriter doExport:boolean) {
    wr.out("  (func $" false)
    wr.out(fn.name false)
    if doExport {
      wr.out((" (export \"" + fn.name + "\")") false)
    }
    for fn.params p:LowIRParam i {
      wr.out((" (param $" + p.name + " " + (this.watType(p.irType)) + ")") false)
    }
    def voidType:string "void"
    if (fn.returnType != voidType) {
      wr.out((" (result " + (this.watType(fn.returnType)) + ")") false)
    }
    wr.out("" true)

    def ltypes (this.localTypeMap(fn))
    def localNames (this.collectLocals(fn))
    for localNames wn:string i {
      wr.out(("    (local " + wn + " " + (this.localTypeOf(ltypes wn)) + ")") true)
    }

    def visited:[string:boolean]
    def exitLabel (this.emitRegion(fn 0 (array_length fn.blocks) wr visited))
    wr.out("  )" true)
  }

  fn markVisited:void (label:string visited:[string:boolean]) {
    set visited label true
  }

  fn isVisited:boolean (label:string visited:[string:boolean]) {
    return (has visited label)
  }

  ; Emit a structured region: the blocks reachable from startIdx that lie in
  ; [startIdx, boundIdx). The bound is exclusive — a forward control edge to a
  ; block at index >= boundIdx LEAVES this region: its branch is suppressed and
  ; the target label is returned so the enclosing emitter continues there. A
  ; branch to an already-visited earlier block is a loop back-edge (emitted as a
  ; real `br`). Returns "" when the region ended by returning from the function.
  ;
  ; Because the LowIR blocks are laid out in structured order (lowerIf emits
  ; [header][then-region][else-or-merge]; lowerWhile emits [pre][cond][body][exit]),
  ; every if-arm and loop body is a contiguous index range, which is exactly what
  ; the bound expresses. This reconstructs arbitrarily nested if / if-else / while.
  fn emitRegion:string (fn:LowIRFunction startIdx:int boundIdx:int wr:CodeWriter visited:[string:boolean]) {
    def cur startIdx
    while (< cur boundIdx) {
      def bb (itemAt fn.blocks cur)
      if (this.isVisited(bb.label visited)) {
        return bb.label
      }
      def handled false
      if (this.isWhileHeader(fn cur)) {
        def wexit (this.emitWhile(fn cur wr visited))
        if (wexit == "") {
          return ""
        }
        def wi (this.findBlockIdx(fn wexit))
        if (wi >= boundIdx) {
          return wexit
        }
        cur = wi
        handled = true
      }
      if (handled == false) {
        this.markVisited(bb.label visited)
        this.writeBlockInstrs(bb wr)
        if (bb.termKind == "ret") {
          if ((strlen bb.termValue) > 0) {
            this.writeGet(bb.termValue wr)
          }
          wr.out("      return" true)
          return ""
        }
        if (bb.termKind == "br_if") {
          def mexit (this.emitIf(fn cur wr visited))
          if (mexit == "") {
            return ""
          }
          def mi (this.findBlockIdx(fn mexit))
          if (mi >= boundIdx) {
            return mexit
          }
          cur = mi
        }
        if (bb.termKind == "br") {
          def t bb.termTarget
          def ti (this.findBlockIdx(fn t))
          if (ti >= boundIdx) {
            return t
          }
          if (this.isVisited(t visited)) {
            wr.out(("      br $" + t) true)
            return t
          }
          cur = ti
        }
        if (bb.termKind == "") {
          cur = (+ cur 1)
        }
      }
    }
    return ""
  }

  ; Emit a structured `if` (single-sided or if/else) at header block `headerIdx`
  ; (which ends in br_if cond -> then / (else|merge)). Returns the label control
  ; continues at after the if (the merge), or "" if every arm returned.
  ;
  ; The then-region is exactly the blocks in [thenIdx, falseIdx): the header's
  ; false target is where the then-region ends for BOTH single-sided (false ==
  ; merge) and two-sided (false == else) ifs. If the then-region falls through
  ; to a merge OTHER than the false target, an else arm exists in [falseIdx, mergeIdx).
  fn emitIf:string (fn:LowIRFunction headerIdx:int wr:CodeWriter visited:[string:boolean]) {
    def hdr (itemAt fn.blocks headerIdx)
    def thenLabel hdr.termIfTrue
    def falseLabel hdr.termIfFalse
    def thenIdx (this.findBlockIdx(fn thenLabel))
    def falseIdx (this.findBlockIdx(fn falseLabel))

    this.writeGet(hdr.termValue wr)
    wr.out("      (if" true)
    wr.out("        (then" true)
    def thenExit (this.emitRegion(fn thenIdx falseIdx wr visited))
    wr.out("        )" true)

    def isElse false
    if (thenExit != "") {
      if (thenExit != falseLabel) {
        isElse = true
      }
    }
    if (isElse) {
      def mergeIdx (this.findBlockIdx(fn thenExit))
      wr.out("        (else" true)
      this.emitRegion(fn falseIdx mergeIdx wr visited)
      wr.out("        )" true)
      wr.out("      )" true)
      return thenExit
    }
    wr.out("      )" true)
    return falseLabel
  }

  ; Emit a `while` at its cond block `condIdx` (br_if cond -> body / exit). The
  ; body is the contiguous region [bodyIdx, exitIdx); its back-edge `br cond`
  ; (cond is marked visited first) is emitted by emitRegion as the loop branch.
  ; Returns the exit label so the caller continues after the loop.
  fn emitWhile:string (fn:LowIRFunction condIdx:int wr:CodeWriter visited:[string:boolean]) {
    def condBb (itemAt fn.blocks condIdx)
    def bodyIdx (this.findBlockIdx(fn condBb.termIfTrue))
    def exitIdx (this.findBlockIdx(fn condBb.termIfFalse))
    def exitBb (itemAt fn.blocks exitIdx)

    this.markVisited(condBb.label visited)

    wr.out(("    (block $" + exitBb.label) true)
    wr.out(("      (loop $" + condBb.label) true)
    this.writeBlockInstrs(condBb wr)
    this.writeGet(condBb.termValue wr)
    wr.out("        i32.eqz" true)
    wr.out(("        br_if $" + exitBb.label) true)
    this.emitRegion(fn bodyIdx exitIdx wr visited)
    wr.out("      )" true)
    wr.out("    )" true)

    return exitBb.label
  }

  fn writeGet:void (llvmRef:string wr:CodeWriter) {
    wr.out(("      local.get " + (this.wasmName(llvmRef))) true)
  }

  fn writeInstr:void (ins:LowIRInstr wr:CodeWriter) {
    switch ins.op {
      case "const" {
        if (ins.irType == "f64") {
          wr.out(("      f64.const " + ins.arg1) true)
        } {
          wr.out(("      i32.const " + ins.arg1) true)
        }
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "fadd" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      f64.add" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "fsub" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      f64.sub" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "fmul" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      f64.mul" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "fdiv" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      f64.div" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "sitofp" {
        this.writeGet(ins.arg1 wr)
        wr.out("      f64.convert_i32_s" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "fptosi" {
        this.writeGet(ins.arg1 wr)
        wr.out("      i32.trunc_f64_s" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "add" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.add" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "sub" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.sub" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "mul" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.mul" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "sdiv" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.div_s" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "srem" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.rem_s" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "and" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.and" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "or" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.or" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "xor" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.xor" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "shl" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.shl" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "ashr" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.shr_s" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "lshr" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.shr_u" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "heap_alloc" {
        wr.out("      global.get $heap_ptr" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
        wr.out("      global.get $heap_ptr" true)
        this.writeGet(ins.arg1 wr)
        wr.out("      i32.add" true)
        wr.out("      global.set $heap_ptr" true)
      }
      case "ptr_load" {
        this.writeGet(ins.arg1 wr)
        wr.out("      i32.load" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "ptr_store" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.store" true)
      }
      case "ptr_load8" {
        this.writeGet(ins.arg1 wr)
        wr.out("      i32.load8_u" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "ptr_store8" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.store8" true)
      }
      case "mem_size" {
        wr.out("      memory.size" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "mem_grow" {
        this.writeGet(ins.arg1 wr)
        wr.out("      memory.grow" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "global_get" {
        wr.out(("      global.get $" + ins.arg1) true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "global_set" {
        this.writeGet(ins.arg2 wr)
        wr.out(("      global.set $" + ins.arg1) true)
      }
      case "func_ref" {
        wr.out(("      i32.const " + ("" + (this.lambdaFuncIndex(ins.arg1)))) true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "call_indirect" {
        for ins.callArgs a:string j {
          this.writeGet(a wr)
        }
        this.writeGet(ins.arg1 wr)
        wr.out(("      call_indirect (type $" + ((this.sigTypeName(ins.callSig)) + ")")) true)
        if ((strlen ins.dest) > 0) {
          wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
        }
      }
      case "inttoptr_struct" {
        this.writeGet(ins.arg1 wr)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "inttoptr_i8" {
        this.writeGet(ins.arg1 wr)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "ptr_to_int" {
        this.writeGet(ins.arg1 wr)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "zext" {
        this.writeGet(ins.arg1 wr)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "zext_i1" {
        this.writeGet(ins.arg1 wr)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "str_ptr" {
        def addr 0
        if (has this.strAddrs ins.arg1) {
          addr = (unwrap (get this.strAddrs ins.arg1))
        }
        wr.out(("      i32.const " + ("" + addr)) true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "typedesc_ptr" {
        def tdAddr 0
        if (has this.typeDescAddrs ins.arg1) {
          tdAddr = (unwrap (get this.typeDescAddrs ins.arg1))
        }
        wr.out(("      i32.const " + ("" + tdAddr)) true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "icmp" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        if (ins.arg3 == "f64") {
          switch ins.pred {
            case "slt" {
              wr.out("      f64.lt" true)
            }
            case "sgt" {
              wr.out("      f64.gt" true)
            }
            case "sle" {
              wr.out("      f64.le" true)
            }
            case "sge" {
              wr.out("      f64.ge" true)
            }
            case "eq" {
              wr.out("      f64.eq" true)
            }
            case "ne" {
              wr.out("      f64.ne" true)
            }
          }
        } {
          switch ins.pred {
            case "slt" {
              wr.out("      i32.lt_s" true)
            }
            case "sgt" {
              wr.out("      i32.gt_s" true)
            }
            case "sle" {
              wr.out("      i32.le_s" true)
            }
            case "sge" {
              wr.out("      i32.ge_s" true)
            }
            case "eq" {
              wr.out("      i32.eq" true)
            }
            case "ne" {
              wr.out("      i32.ne" true)
            }
          }
        }
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "alloca" {
      }
      case "alloca_struct" {
        def sizeBytes (ins.structSize * 4)
        wr.out("      global.get $heap_ptr" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
        wr.out("      global.get $heap_ptr" true)
        wr.out(("      i32.const " + ("" + sizeBytes)) true)
        wr.out("      i32.add" true)
        wr.out("      global.set $heap_ptr" true)
      }
      case "gep" {
        this.writeGet(ins.arg1 wr)
        if (ins.fieldIndex > 0) {
          wr.out(("      i32.const " + ("" + (ins.fieldIndex * 4))) true)
          wr.out("      i32.add" true)
        }
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "load" {
        this.writeGet(ins.arg1 wr)
        if (this.isGepTemp(ins.arg1)) {
          wr.out("      i32.load" true)
        }
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "store" {
        if (this.isGepTemp(ins.arg2)) {
          this.writeGet(ins.arg2 wr)
          this.writeGet(ins.arg1 wr)
          wr.out("      i32.store" true)
        } {
          this.writeGet(ins.arg1 wr)
          wr.out(("      local.set " + (this.wasmName(ins.arg2))) true)
        }
      }
      case "call" {
        for ins.callArgs a:string j {
          this.writeGet(a wr)
        }
        wr.out(("      call $" + ins.fnName) true)
        if ((strlen ins.dest) > 0) {
          wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
        }
      }
    }
  }
}

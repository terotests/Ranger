
Import "ng_LowIR.rgr"

; Low IR -> WebAssembly text (WAT)
; Emits structured if / while (not arbitrary CFG).

class WATWriter {

  fn wasmName:string (llvmName:string) {
    if ((strlen llvmName) == 0) {
      return ""
    }
    def ch (charAt llvmName 0)
    def pct:int (to_int (charcode "%"))
    if (ch == pct) {
      return ("$" + (substring llvmName 1 (strlen llvmName)))
    }
    return ("$" + llvmName)
  }

  fn moduleUsesHeap:boolean (module:LowIRModule) {
    return (LowIRUtil.moduleUsesHeap(module))
  }

  fn writeModule:void (module:LowIRModule wr:CodeWriter) {
    wr.out("(module" true)
    if (this.moduleUsesHeap(module)) {
      wr.out("  (memory (export \"memory\") 1)" true)
      wr.out("  (global $heap_ptr (mut i32) (i32.const 0))" true)
    }
    for module.functions fn:LowIRFunction i {
      this.writeFunction(fn wr fn.exportFn)
    }
    wr.out(")" true)
  }

  fn findBlockIdx:int (fn:LowIRFunction label:string) {
    def cnt (array_length fn.blocks)
    def ii:int 0
    while (ii < cnt) {
      def bb (itemAt fn.blocks ii)
      if (bb.label == label) {
        return ii
      }
      ii = ii + 1
    }
    return -1
  }

  fn isWhileHeader:boolean (fn:LowIRFunction condIdx:int) {
    if (condIdx < 0) {
      return false
    }
    def condBb (itemAt fn.blocks condIdx)
    if (condBb.termKind != "br_if") {
      return false
    }
    def bodyIdx (this.findBlockIdx(fn condBb.termIfTrue))
    if (bodyIdx < 0) {
      return false
    }
    def bodyBb (itemAt fn.blocks bodyIdx)
    if (bodyBb.termKind != "br") {
      return false
    }
    return (bodyBb.termTarget == condBb.label)
  }

  fn collectLocals:[string] (fn:LowIRFunction) {
    def names:[string]
    def seen:[string:string]
    for fn.params p:LowIRParam i {
      set seen p.name "param"
    }
    for fn.blocks bb:LowIRBlock i {
      for bb.instrs ins:LowIRInstr i {
        if ((strlen ins.dest) > 0) {
          def wn (this.wasmName(ins.dest))
          if (has seen wn) {
            continue
          }
          set seen wn "local"
          push names wn
        }
      }
    }
    return names
  }

  fn writeBlockInstrs:void (bb:LowIRBlock wr:CodeWriter) {
    for bb.instrs ins:LowIRInstr i {
      this.writeInstr(ins wr)
    }
  }

  fn writeFunction:void (fn:LowIRFunction wr:CodeWriter doExport:boolean) {
    wr.out("  (func $" false)
    wr.out(fn.name false)
    if doExport {
      wr.out((" (export \"" + fn.name + "\")") false)
    }
    for fn.params p:LowIRParam i {
      wr.out((" (param $" + p.name + " i32)") false)
    }
    def voidType:string "void"
    if (fn.returnType != voidType) {
      wr.out((" (result i32)") false)
    }
    wr.out("" true)

    def localNames (this.collectLocals(fn))
    for localNames wn:string i {
      wr.out(("    (local " + wn + " i32)") true)
    }

    def visited:[string:boolean]
    def nextIdx (this.emitFromIndex(fn 0 wr visited))
    wr.out("  )" true)
  }

  fn markVisited:void (label:string visited:[string:boolean]) {
    set visited label true
  }

  fn isVisited:boolean (label:string visited:[string:boolean]) {
    return (has visited label)
  }

  fn emitFromIndex:int (fn:LowIRFunction idx:int wr:CodeWriter visited:[string:boolean]) {
    def cnt (array_length fn.blocks)
    if (idx >= cnt) {
      return idx
    }
    def bb (itemAt fn.blocks idx)
    if (this.isVisited(bb.label visited)) {
      return (idx + 1)
    }
    this.markVisited(bb.label visited)
    this.writeBlockInstrs(bb wr)

    switch bb.termKind {
      case "ret" {
        if ((strlen bb.termValue) > 0) {
          this.writeGet(bb.termValue wr)
        }
        wr.out("      return" true)
        return (idx + 1)
      }
      case "br" {
        def condIdx (this.findBlockIdx(fn bb.termTarget))
        if (this.isWhileHeader(fn condIdx)) {
          return (this.emitWhileLoop(fn condIdx wr visited))
        }
        wr.out(("      br $" + bb.termTarget) true)
        return (idx + 1)
      }
      case "br_if" {
        return (this.emitIfThenMerge(fn idx wr visited))
      }
    }
    return (idx + 1)
  }

  fn emitIfThenMerge:int (fn:LowIRFunction idx:int wr:CodeWriter visited:[string:boolean]) {
    def hdr (itemAt fn.blocks idx)
    def thenIdx (this.findBlockIdx(fn hdr.termIfTrue))
    def mergeIdx (this.findBlockIdx(fn hdr.termIfFalse))
    def thenBb (itemAt fn.blocks thenIdx)
    def mergeBb (itemAt fn.blocks mergeIdx)

    this.writeGet(hdr.termValue wr)
    wr.out("      (if" true)
    wr.out("        (then" true)
    this.markVisited(thenBb.label visited)
    this.writeBlockInstrs(thenBb wr)
    if (thenBb.termKind == "ret") {
      if ((strlen thenBb.termValue) > 0) {
        this.writeGet(thenBb.termValue wr)
      }
      wr.out("          return" true)
    } {
      if (thenBb.termKind == "br") {
        if (thenBb.termTarget != mergeBb.label) {
          wr.out(("          br $" + thenBb.termTarget) true)
        }
      }
    }
    wr.out("        )" true)
    wr.out("      )" true)

    if (this.isVisited(mergeBb.label visited) == false) {
      this.markVisited(mergeBb.label visited)
      this.writeBlockInstrs(mergeBb wr)
      if (mergeBb.termKind == "ret") {
        if ((strlen mergeBb.termValue) > 0) {
          this.writeGet(mergeBb.termValue wr)
        }
        wr.out("      return" true)
        return (mergeIdx + 1)
      }
      if (mergeBb.termKind == "br_if") {
        return (this.emitIfThenMerge(fn mergeIdx wr visited))
      }
      if (mergeBb.termKind == "br") {
        def condIdx (this.findBlockIdx(fn mergeBb.termTarget))
        if (this.isWhileHeader(fn condIdx)) {
          return (this.emitWhileLoop(fn condIdx wr visited))
        }
        wr.out(("      br $" + mergeBb.termTarget) true)
      }
    }
    return (mergeIdx + 1)
  }

  fn emitWhileLoop:int (fn:LowIRFunction condIdx:int wr:CodeWriter visited:[string:boolean]) {
    def condBb (itemAt fn.blocks condIdx)
    def bodyIdx (this.findBlockIdx(fn condBb.termIfTrue))
    def exitIdx (this.findBlockIdx(fn condBb.termIfFalse))
    def bodyBb (itemAt fn.blocks bodyIdx)
    def exitBb (itemAt fn.blocks exitIdx)

    this.markVisited(condBb.label visited)
    this.markVisited(bodyBb.label visited)
    this.markVisited(exitBb.label visited)

    wr.out(("    (block $" + exitBb.label) true)
    wr.out(("      (loop $" + condBb.label) true)
    this.writeBlockInstrs(condBb wr)
    this.writeGet(condBb.termValue wr)
    wr.out("        i32.eqz" true)
    wr.out(("        br_if $" + exitBb.label) true)
    this.writeBlockInstrs(bodyBb wr)
    wr.out(("        br $" + condBb.label) true)
    wr.out("      )" true)
    wr.out("    )" true)

    this.writeBlockInstrs(exitBb wr)
    if (exitBb.termKind == "ret") {
      if ((strlen exitBb.termValue) > 0) {
        this.writeGet(exitBb.termValue wr)
      }
      wr.out("      return" true)
    }
    return (exitIdx + 1)
  }

  fn writeGet:void (llvmRef:string wr:CodeWriter) {
    wr.out(("      local.get " + (this.wasmName(llvmRef))) true)
  }

  fn writeInstr:void (ins:LowIRInstr wr:CodeWriter) {
    switch ins.op {
      case "const" {
        wr.out(("      i32.const " + ins.arg1) true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "add" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.add" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "sub" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.sub" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "mul" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.mul" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "sdiv" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.div_s" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "srem" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.rem_s" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "heap_alloc" {
        wr.out("      global.get $heap_ptr" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
        wr.out("      global.get $heap_ptr" true)
        this.writeGet(ins.arg1 wr)
        wr.out("      i32.add" true)
        wr.out("      global.set $heap_ptr" true)
      }
      case "ptr_load" {
        this.writeGet(ins.arg1 wr)
        wr.out("      i32.load" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "ptr_store" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        wr.out("      i32.store" true)
      }
      case "inttoptr_struct" {
        this.writeGet(ins.arg1 wr)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "inttoptr_i8" {
        this.writeGet(ins.arg1 wr)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "zext" {
        this.writeGet(ins.arg1 wr)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "zext_i1" {
        this.writeGet(ins.arg1 wr)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "str_ptr" {
        wr.out(("      i32.const 0") true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "icmp" {
        this.writeGet(ins.arg1 wr)
        this.writeGet(ins.arg2 wr)
        switch ins.pred {
          case "slt" {
            wr.out("      i32.lt_s" true)
          }
          case "sgt" {
            wr.out("      i32.gt_s" true)
          }
          case "sle" {
            wr.out("      i32.le_s" true)
          }
          case "sge" {
            wr.out("      i32.ge_s" true)
          }
          case "eq" {
            wr.out("      i32.eq" true)
          }
          case "ne" {
            wr.out("      i32.ne" true)
          }
        }
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "alloca" {
      }
      case "alloca_struct" {
        def sizeBytes (ins.structSize * 4)
        wr.out("      global.get $heap_ptr" true)
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
        wr.out("      global.get $heap_ptr" true)
        wr.out(("      i32.const " + ("" + sizeBytes)) true)
        wr.out("      i32.add" true)
        wr.out("      global.set $heap_ptr" true)
      }
      case "gep" {
        this.writeGet(ins.arg1 wr)
        if (ins.fieldIndex > 0) {
          wr.out(("      i32.const " + ("" + (ins.fieldIndex * 4))) true)
          wr.out("      i32.add" true)
        }
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "load" {
        this.writeGet(ins.arg1 wr)
        def srcCh (charAt ins.arg1 1)
        if (srcCh == 102) {
          wr.out("      i32.load" true)
        }
        wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
      }
      case "store" {
        def slotCh (charAt ins.arg2 1)
        if (slotCh == 102) {
          this.writeGet(ins.arg2 wr)
          this.writeGet(ins.arg1 wr)
          wr.out("      i32.store" true)
        } {
          this.writeGet(ins.arg1 wr)
          wr.out(("      local.set " + (this.wasmName(ins.arg2))) true)
        }
      }
      case "call" {
        for ins.callArgs a:string j {
          this.writeGet(a wr)
        }
        wr.out(("      call $" + ins.fnName) true)
        if ((strlen ins.dest) > 0) {
          wr.out(("      local.set " + (this.wasmName(ins.dest))) true)
        }
      }
    }
  }
}

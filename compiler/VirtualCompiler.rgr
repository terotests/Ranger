          es6 ( "require('path').dirname(" (e 1) ")" )
          kotlin ( "rg_path_dirname(" (e 1) ")"
          (create_polyfill "
fun rg_path_normalize(p: String): String {
  val s = p.replace(92.toChar(), '/')
  val absolute = s.startsWith(\"/\")
  val trailing = s.length > 1 && s.endsWith(\"/\")
  val parts = mutableListOf<String>()
  for (cur in s.split(\"/\")) {
    if (cur == \"..\") {
      if (parts.size > 0 && parts[parts.size - 1] != \"..\") {
        parts.removeAt(parts.size - 1)
      } else if (!absolute) {
        parts.add(cur)
      }
    } else if (cur.isNotEmpty() && cur != \".\") {
      parts.add(cur)
    }
  }
  var out = parts.joinToString(\"/\")
  if (absolute) { out = \"/\" + out }
  if (out.isEmpty()) { return \".\" }
  if (trailing && out != \"/\") { out = out + \"/\" }
  return out
}
fun rg_path_dirname(p: String): String {
  var s = rg_path_normalize(p)
  if (s.length > 1 && s.endsWith(\"/\")) { s = s.substring(0, s.length - 1) }
  val pos = s.lastIndexOf('/')
  if (pos < 0) { return \".\" }
  if (pos == 0) { return \"/\" }
  return s.substring(0, pos)
}
// The directory the jar was started from, which is where the compiler looks for
// its bundled Lang.rgr and stdops.rgr.
fun rg_install_directory(): String {
  try {
    val loc = object {}.javaClass.protectionDomain.codeSource.location.toURI()
    return rg_path_dirname(rg_path_normalize(java.io.File(loc).absolutePath))
  } catch (e: Exception) {
    return \".\"
  }
}
")
          )
          go ( "r_path_dirname(" (e 1) ")" (imp "strings") (imp "os")
          (polyfill "after_imports" "
func r_path_normalize(p string) string {
  s := strings.Replace(p, string(rune(92)), \"/\", -1)
  absolute := strings.HasPrefix(s, \"/\")
  trailing := len(s) > 1 && strings.HasSuffix(s, \"/\")
  parts := []string{}
  for _, cur := range strings.Split(s, \"/\") {
    if cur == \"..\" {
      if len(parts) > 0 && parts[len(parts)-1] != \"..\" {
        parts = parts[:len(parts)-1]
      } else if !absolute {
        parts = append(parts, cur)
      }
    } else if len(cur) > 0 && cur != \".\" {
      parts = append(parts, cur)
    }
  }
  out := strings.Join(parts, \"/\")
  if absolute {
    out = \"/\" + out
  }
  if len(out) == 0 {
    return \".\"
  }
  if trailing && out != \"/\" {
    out = out + \"/\"
  }
  return out
}
func r_path_dirname(p string) string {
  s := r_path_normalize(p)
  if len(s) > 1 && strings.HasSuffix(s, \"/\") {
    s = s[:len(s)-1]
  }
  pos := strings.LastIndex(s, \"/\")
  if pos < 0 {
    return \".\"
  }
  if pos == 0 {
    return \"/\"
  }
  return s[:pos]
}
// The directory the program was started from, which is where the compiler looks
// for its bundled Lang.rgr and stdops.rgr.
func r_install_directory() string {
  exe, err := os.Executable()
  if err != nil {
    return \".\"
  }
  return r_path_dirname(r_path_normalize(exe))
}
")
          )
          csharp ( "RgPath.Dirname(" (e 1) ")"
          (polyfill "after_imports" "
// Path helpers for the compiler's own file handling. System.IO.Path would do
// most of it, but its behaviour follows the host platform's separator and the
// compiler builds its search path by concatenating onto a normalized string, so
// these follow Node's path.normalize / path.dirname the way the C++, Dart and
// Python entries do.
static class RgPath {
  public static string Normalize(string p) {
    string s = p.Replace((char)92, '/');
    bool absolute = s.StartsWith(\"/\");
    bool trailing = s.Length > 1 && s.EndsWith(\"/\");
    System.Collections.Generic.List<string> parts = new System.Collections.Generic.List<string>();
    foreach (string cur in s.Split('/')) {
      if (cur == \"..\") {
        if (parts.Count > 0 && parts[parts.Count - 1] != \"..\") {
          parts.RemoveAt(parts.Count - 1);
        } else if (absolute == false) {
          parts.Add(cur);
        }
      } else if (cur.Length > 0 && cur != \".\") {
        parts.Add(cur);
      }
    }
    string outp = string.Join(\"/\", parts.ToArray());
    if (absolute) { outp = \"/\" + outp; }
    if (outp.Length == 0) { return \".\"; }
    if (trailing && outp != \"/\") { outp = outp + \"/\"; }
    return outp;
  }
  public static string Dirname(string p) {
    string s = Normalize(p);
    if (s.Length > 1 && s.EndsWith(\"/\")) { s = s.Substring(0, s.Length - 1); }
    int pos = s.LastIndexOf('/');
    if (pos < 0) { return \".\"; }
    if (pos == 0) { return \"/\"; }
    return s.Substring(0, pos);
  }
  // The directory the program was started from, which is where the compiler
  // looks for its bundled Lang.rgr and stdops.rgr.
  public static string InstallDir() {
    string loc = System.Reflection.Assembly.GetEntryAssembly().Location;
    if (loc == null || loc.Length == 0) { return \".\"; }
    return Dirname(Normalize(System.IO.Path.GetFullPath(loc)));
  }
}
")
          )
      }        
  }  
}

operator type:void es6 {
  fn get_compiler_data:JSONDataObject () ('window._Ranger_compiler_environment_')
}

; What `run` hands back to its caller, which then writes the files. Both of
; these have to be owning references: the locals inside `run` are the only other
; holders, so on a target where `weak` is a real weak reference the result was
; already dead when main() read it — the C++ build reported success and wrote no
; file, because `res.fileSystem` had expired.
class CompilerResults {
  def ctx:RangerAppWriterContext
  def fileSystem:CodeFileSystem
  def target_dir ""
  def hasErrors false
  def errorMessage ""
}

class VirtualCompiler {

  def envObj@(weak):InputEnv

  static fn create_env() {

    def env (new InputEnv)
    env.filesystem = (new InputFSFolder)
    env.commandLine = (new CmdParams)

    CreateFile 'Lang.rgr' (unwrap (read_file '.' 'Lang.rgr'))
    CreateFile 'stdlib.rgr' (unwrap (read_file './lib/' 'stdlib.rgr'))
    CreateFile 'stdops.rgr' (unwrap (read_file './lib/' 'stdops.rgr'))
    CreateFile 'Timers.rgr' (unwrap (read_file './lib/' 'Timers.rgr'))
    CreateFile 'DOMLib.rgr' (unwrap (read_file './lib/' 'DOMLib.rgr'))
    CreateFile 'Ajax.rgr' (unwrap (read_file './lib/' 'Ajax.rgr'))
    CreateFile 'Crypto.rgr' (unwrap (read_file './lib/' 'Crypto.rgr'))
    CreateFile 'Engine3D.rgr' (unwrap (read_file './lib/' 'Engine3D.rgr'))
    CreateFile 'Storage.rgr' (unwrap (read_file './lib/' 'Storage.rgr'))
    CreateFile 'JSON.rgr' (unwrap (read_file './lib/' 'JSON.rgr'))
    CreateFile 'hello_world.rgr' `

class tester {
  static fn main () {
    print "Hello World!"
  }
}

    `    
    write_file '.' 'compileEnv.js' ( 'window._Ranger_compiler_environment_ = ' + (to_string (env.toDictionary())))
    
  }

  static fn main() {
     ; print "--> creating the virtual env"
     ; VirtualCompiler.create_env()
  }

  fn getEnvVar:string (name:string) {
      return (env_var (unwrap envObj) name)
  } 

  fn possiblePaths:[string] ( envVarName:string) {
    def res:[string]
    def parts (strsplit envVarName ";")
    push res "./"
    for parts str:string i {
      def s (trim str)
      if( (strlen s) > 0) {
        def dirNames (strsplit s "/")
        removeLast dirNames
        def theDir ((join dirNames "/"))
        push res theDir
      }
    }
    push res (install_directory (unwrap envObj))
    return res
  } 

  fn searchLib:string (paths:[string] libname:string) {
    for paths path:string i {
      if( file_exists (unwrap envObj) path libname ) {
        return path 
      }
    }
    return ""
  }  

  fn fillStr:string (cnt:int) {
    def s ""
    def i cnt
    while ( i > 0) {
      s = s + " "
      i = i - 1
    }
    return s
  }

  ; Detect target language from output file extension
  ; Returns the language string or empty string if not detected
  fn detectLanguageFromExtension:string (filename:string) {
    def lastDot:int (lastIndexOf filename ".")
    if (lastDot < 0) {
      return ""
    }
    def ext:string (substring filename (lastDot + 1) (strlen filename))
    
    ; Map extensions to language targets (use latest versions)
    switch ext {
      case "js" { return "es6" }
      case "ts" { return "es6" }  ; TypeScript still uses es6 target with -typescript flag
      case "go" { return "go" }
      case "py" { return "python" }
      case "rs" { return "rust" }
      case "swift" { return "swift6" }  ; Latest Swift version
      case "java" { return "java7" }
      case "kt" { return "kotlin" }
      case "dart" { return "dart" }
      case "cs" { return "csharp" }
      case "cpp" { return "cpp" }
      case "hpp" { return "cpp" }
      case "php" { return "php" }
      case "scala" { return "scala" }
      case "ll" { return "llvm" }
      default { return "" }
    }
    return ""
  }

  ; Check if file has TypeScript extension
  fn isTypeScriptExtension:boolean (filename:string) {
    def lastDot:int (lastIndexOf filename ".")
    if (lastDot < 0) {
      return false
    }
    def ext:string (substring filename (lastDot + 1) (strlen filename))
    return (ext == "ts")
  }

  fn run@(weak):CompilerResults ( env:InputEnv) {

    def res (new CompilerResults)

    this.envObj = env

    def allowed_languages:[string] ([] "es6" "go" "scala" "java7" "swift3" "swift6" "kotlin" "dart" "cpp" "php" "csharp" "python" "rust" "llvm" )
    def params (unwrap env.commandLine)

    ; Initialize CLI progress (after params is defined)
    def cli:CLIProgress (new CLIProgress())
    
    ; Check for --no-color flag
    if (has params.flags "no-color") {
        cli.setUseColors(false)
    }

    def the_file ""
    def plugins_only false

    def valid_options:[string] ([] _:string
      ('l'  ('Selected language, one of ' + ( join allowed_languages ', ')) 
      'd'  'output directory, default directory is "bin/"'
      'o'  'output file, default is "output.<language>"'
      'classdoc'  'write class documentation .md file'
      'operatordoc'  'write operator documention into .md file'
      'apidoc'  'write the API documentation artifacts into this subdirectory'
      'apiformat'  'which API artifacts to write: json, markdown, report (default json,markdown)'
      'format'  'Output formatting: "ranger" (the default) drops parentheses a target does not need and breaks a long method chain onto one line per call; "none" emits exactly what the writers emit'
      'width'  'Line width the formatter aims at, when -format is not none. Defaults to the target ecosystem\'s own: 80 on JavaScript, Dart and C++, 100 elsewhere'
      'csnamespace'  'C# namespace for the generated types'
      'ktpackage'  'Kotlin package for the generated types'
    ))

    def valid_flags:[string] ([] _:string
      (
      'no-color' 'Disable colored output'
      'deadcode' 'Eliminate functions which are not called by any other functions'
      'dead4main' 'Eliminate functions and classes which are unreachable from the main function'
      'forever' 'Leave the main program into eternal loop (Go, Swift)'
      'allowti' 'Allow type inference at target lang (creates slightly smaller code)'
      'plugins-only' 'ignore built-in language output and use only plugins'
      'plugins' '(node compiler only) run specified npm plugins -plugins="plugin1,plugin2"'
      'strict' 'Strict mode. Do not allow automatic unwrapping of optionals outside of try blocks.'
      'apistrict' 'An undocumented public declaration or parameter is an error, not a warning'
      'apipackage' 'Write the packaging the target ecosystem expects: package.json for npm, .csproj and docfx.json for NuGet'
      'keep-examples' 'Emit the functions named by `example` into the output. They are type checked either way; by default they are left out'
      'docstyle-none' 'Do not write documentation comments into the generated code'
      'strict-ownership' 'Print the inferred ownership of each function parameter (borrowed, moved, shared, owned, unknown)'
      'rust-shared-classes' 'Emit Rc<RefCell<T>> for classes the sharing analysis marks as shared (Rust target; the default since the conformance gate closed — kept for compatibility)'
      'rust-value-classes' 'Every class is a plain value struct on Rust (the pre-ownership object model); disables the shared-class Rc<RefCell<T>> emission'
      'inline-statics' 'Expand trivial static forwarders (a single return of an expression over the parameters) at their call sites instead of emitting a call'
      'native-fast-alloc' 'Rust/C++ targets: emit a thread-local size-class freelist allocator (never returns memory to the OS; single-process benchmark/tool builds)'
      'cpp-single-thread' 'C++ target: reference-count objects WITHOUT atomics (rg_ptr). Same aliasing as std::shared_ptr and no lock-prefixed increment per copy; a pointer copied across threads corrupts the count, so single-threaded builds only'
      'typescript' 'Writes JavaScript code with TypeScript annotations'
      'esm' 'Writes JavaScript code with ESM module syntax'
      'npm' 'Write the package.json to the output directory' 
      'pubspec' 'Write pubspec.yaml for a Dart / Flutter package (requires -name= -version= -description=)'
      'flutter' 'When used with -pubspec, emit a Flutter-oriented pubspec.yaml'
      'nodecli' 'Insert node.js command line header #!/usr/bin/env node to the beginning of the JavaScript file'
      'nodemodule' 'Export the classes as Node.js CommonJS modules'
      'client'  'the code is ment to be run in the client environment'
      'scalafiddle'  'scalafiddle.io compatible output'
      'compiler' 'recompile the compiler'
      'copysrc' 'copy all the source codes into the target directory'
      )
    )

    def parser_pragmas:[string] ([] _:string
      (
        '@noinfix(true)' 'disable operator infix parsing and automatic type definition checking '
      ))

    if( has params.flags "compiler") {
      cli.printHeader()
      print (cli.info("Re-compiling the compiler itself"))
      print ""
      the_file = "ng_Compiler.rgr"
    } {
      if ( (array_length params.values) < 1  ) {
        cli.printHelpHeader()
        
        cli.printSection("Options:")
        def optCnt 0
        while (optCnt < (array_length valid_options) ) {
          def option:string (itemAt valid_options optCnt)
          def optionDesc:string (itemAt valid_options (optCnt+1))
          cli.printOption(option optionDesc)
          optCnt = optCnt + 2
        }
        
        cli.printSection("Flags:")
        def optCnt 0
        while (optCnt < (array_length valid_flags) ) {
          def option (itemAt valid_flags optCnt)
          def optionDesc (itemAt valid_flags (optCnt+1))
          cli.printFlag(option optionDesc)
          optCnt = optCnt + 2
        }
        
        cli.printSection("Pragmas (inside source files):")
        def optCnt 0
        while (optCnt < (array_length parser_pragmas) ) {
          def option (itemAt parser_pragmas optCnt)
          def optionDesc (itemAt parser_pragmas (optCnt+1))
          print "  " + (cli.gray(option)) + " " + optionDesc
          optCnt = optCnt + 2
        }
        print ""
        return res
      }    
      the_file = (itemAt params.values 0)
    }
    ; used file is here, the path of the used file should be the first path
    def root_file the_file

    def root_dir (normalize ((current_directory env) + "/" + (pathname the_file) + '/'))

    def the_lang_file:string "Lang.rgr"         ; (shell_arg 1)
    def the_lang:string "es6"              ; (shell_arg 2)
    def the_target_dir:string  (root_dir + "bin")  ; (shell_arg 3)
    def the_target:string "output"
    def package_name ""
    def comp_attrs:[string:string]

    def outDir (params.getParam("o"))
    if(!null? outDir) {
      the_target = (unwrap outDir)
    } 

    def langLibEnv (env_var env "RANGER_LIB")

    ; Build library search paths - prioritize installation directory for bundled files
    let idir = (install_directory)
    ; First check the binary directory itself and its bundled ./lib directory
    ; Then check ../compiler and ../lib for development setups
    langLibEnv = (normalize idir) + ";" + (normalize (idir + "/lib/")) + ";" + root_dir + ";" + (normalize (idir + "/../compiler/")) + ";" + (normalize (idir + "/../lib/")) + ";" + langLibEnv

    env.setEnv( "RANGER_LIB" langLibEnv  )

    ; Debug: only show ENV in verbose mode
    ; print "ENV: " + (env_var env "RANGER_LIB")

    def theFilePaths (this.possiblePaths( (env_var env "RANGER_LIB")))
    def theFilePath ( this.searchLib(theFilePaths the_file) )
      
    if ( (file_exists env theFilePath the_file) == false) {
      cli.printHeader()
      print (cli.error("File not found: " + the_file))
      print ""
      res.hasErrors = true
      res.errorMessage = "File not found: " + the_file
      return res
    }
    
    def langFilePaths (this.possiblePaths( (this.getEnvVar("RANGER_LIB"))))
    def langFilePath ( this.searchLib(langFilePaths the_lang_file) )
    
    if ( (file_exists env langFilePath the_lang_file) == false) {
      cli.printHeader()
      print (cli.error("Language file not found: " + the_lang_file))
      print ""
      print "  " + (cli.gray("Check RANGER_LIB environment variable or library directory"))
      print "  " + (cli.gray("Download from: https://github.com/terotests/Ranger/blob/master/compiler/Lang.rgr"))
      print ""
      res.hasErrors = true
      res.errorMessage = "Language file not found"
      return res
    }

    def langFileDirs (this.possiblePaths( (this.getEnvVar("RANGER_LIB")) ))

    ; Add the source file's directory to library paths for relative imports
    def sourceFileDir (path_dirname (theFilePath + "/" + the_file))
    push langFileDirs sourceFileDir

    def c:string (read_file env theFilePath the_file)    
    def code:SourceCode (new SourceCode ((unwrap c)))

    code.filename = the_file
    def parser:RangerLispParser (new RangerLispParser (code))
    if( has params.flags "no-op-transform") {
      parser.disableOperators = true
    }
    parser.parse( (has params.flags "no-op-transform") )
    ; A parser error means the AST is truncated: continuing would emit code
    ; that silently omits whatever the parser could not represent. Fail here
    ; rather than write a plausible-looking but incomplete output file.
    if( parser.had_error ) {
      cli.printHeader()
      print (cli.error("Parse error in " + the_file))
      print ""
      res.hasErrors = true
      res.errorMessage = "Parse error in " + the_file
      return res
    }
    def root (unwrap parser.rootNode)

    def flags (keys params.flags)

    for root.children ch:CodeNode ci {

      def inserted_nodes:[CodeNode]

      if( (array_length ch.children) > 2 ) {
        def fc (ch.getFirst())
        if( fc.vref == "flag" ) {
          def fName (ch.getSecond())
          for flags flag_name:string i {
            if( flag_name == fName.vref) {
              def compInfo (ch.getThird())
              def i 0
              def cnt (array_length compInfo.children)
              while( i < (cnt - 1 ) ) {
                def fc (itemAt compInfo.children i)
                def sc (itemAt compInfo.children (i + 1))

                switch fc.vref {
                  case "libpath" {
                    langFileDirs = (this.possiblePaths(sc.string_value))
                  }
                  case "output" {
                    the_target = sc.string_value
                  }
                  case "root-file" {
                    root_file = sc.string_value
                  }
                  case "language" {
                    the_lang = sc.string_value
                  }
                  case "absolute_output_dir" {
                    the_target_dir = sc.string_value
                  }
                  case "relative_output_dir" {
                    the_target_dir = (current_directory env) + "/" + sc.string_value
                  }
                  case "package" {
                    package_name = sc.string_value
                  }
                  case "android_res_dir" {
                    set comp_attrs fc.vref sc.string_value
                  }
                  case "web_res_dir" {
                    set comp_attrs fc.vref sc.string_value
                  }
                  case "Import" {
                    push inserted_nodes (r.expression (r.vref "Import") (r.value sc.string_value))                    
                  }
                  default {
                    if( (strlen sc.string_value) > 0) {
                      set comp_attrs fc.vref sc.string_value                    
                    }
                  }
                }
                ; print " " + fc.vref + " = " + sc.string_value
                i = i + 2
              }
            }


          }
          clear ch.children
          for inserted_nodes new_node@(lives):CodeNode i {
            print " *** Inserting " + (new_node.getCode())
            insert root.children 0 new_node
;            push ch.children new_node
          }
        }
      }
    }

    insert root.children 0 (r.expression (r.vref "Import") (r.value "stdlib.rgr"))
    
    def outDir (params.getParam("o"))
    if(!null? outDir) {
      the_target = (unwrap outDir)
    } 
    set comp_attrs "o" the_target

    def dirParam (params.getParam("d"))
    if(!null? dirParam) {
      the_target_dir = ((current_directory env) + "/"  + (unwrap dirParam))  ; (shell_arg 3)
    } 
    the_target_dir = (normalize the_target_dir)
    set comp_attrs "d" the_target_dir

    def pLang (params.getParam("l"))
    def autoDetectedTypeScript:boolean false
    if(!null? pLang) {
      the_lang = (unwrap pLang)
    } {
      ; Auto-detect language from output file extension if -l not specified
      def detectedLang:string (this.detectLanguageFromExtension(the_target))
      if ((strlen detectedLang) > 0) {
        the_lang = detectedLang
        ; Check if TypeScript output is requested
        if (this.isTypeScriptExtension(the_target)) {
          autoDetectedTypeScript = true
        }
      }
    }

    ; --- context for the compilation ---
    def appCtx@(lives):RangerAppWriterContext (new RangerAppWriterContext()))
    appCtx.env = env
    appCtx.libraryPaths = langFileDirs
    set appCtx.compilerSettings "package" package_name
    if(appCtx.hasCompilerFlag('verbose')) {
      for appCtx.libraryPaths include_path:string i {
        print "include-path : " + include_path
      }
    }

    params.flags.forEach({
      def n index
      set appCtx.compilerFlags n true
      ; print " / flag " + index
    })

    ; Auto-add typescript flag if .ts extension was detected
    if autoDetectedTypeScript {
      set appCtx.compilerFlags "typescript" true
    }

    params.params.forEach({
      def v item
      set comp_attrs index v
    })

    comp_attrs.forEach({
      def n item
      set appCtx.compilerSettings index n
      ; print " / setting " + index
    })

    if ( ( indexOf allowed_languages the_lang) < 0 ) {
      print "Invalid language : " + the_lang
      def s:string ""
      print "allowed languages: " + (join allowed_languages " ")     
      return res
    }

    ; A typo in -format must not silently turn the formatter on: "-format=non"
    ; is not "none", and reading it as "anything that is not none" would leave
    ; the caller believing they had switched it off.
    def fmtOpt@(optional) (params.getParam("format"))
    if (!null? fmtOpt) {
      def fmtName:string (unwrap fmtOpt)
      if ((fmtName != "none") && (fmtName != "ranger")) {
        print "Invalid -format value : " + fmtName
        print "allowed values: none ranger"
        ; `native` is a real step, it is just not a compiler flag: Ranger has
        ; no subprocess primitive, and giving the compiler one would mean
        ; implementing process execution for eleven targets so that a cosmetic
        ; pass could run a program off PATH. It lives outside instead, where
        ; it is also easier to not run.
        if (fmtName == "native") {
          print ""
          print "`native` is a separate step rather than a flag. Compile as usual,"
          print "then run the target's own formatter over the output:"
          print ""
          print "    npm run format:native -- <output directory>"
          print ""
          print "It is optional in every direction: a formatter that is not installed"
          print "is reported and skipped, and one that fails leaves the file exactly"
          print "as Ranger wrote it."
        }
        return res
      }
    }

    ; set the language
    set appCtx.compilerSettings "l" the_lang

    if( the_target == "output") {
      def root_parts (strsplit root_file ".")
      if( (array_length root_parts) == 2) {
        the_target = (itemAt root_parts 0)
      }
    }

    ; Add file extension based on language
    switch the_lang {
      case "es6" {
        ; Check for all JavaScript-related extensions (.js, .ts, .mjs, .cjs)
        def has_js_ext false
        if( endsWith the_target ".js") {
          has_js_ext = true
        }
        if( endsWith the_target ".ts") {
          has_js_ext = true
        }
        if( endsWith the_target ".mjs") {
          has_js_ext = true
        }
        if( endsWith the_target ".cjs") {
          has_js_ext = true
        }
        if( has_js_ext == false) {
          the_target = the_target + ".js"
          if( appCtx.hasCompilerFlag( "typescript") ) {
            the_target = the_target + ".ts"
          }
        }
      }
      case "swift3" {
        if( false == (endsWith the_target ".swift")) {
          the_target = the_target + ".swift"
        }
      }
      case "swift6" {
        if( false == (endsWith the_target ".swift")) {
          the_target = the_target + ".swift"
        }
      }
      case "php" {
        if( false == (endsWith the_target ".php")) {
          the_target = the_target + ".php"
        }
      }
      case "csharp" {
        if( false == (endsWith the_target ".cs")) {
          the_target = the_target + ".cs"
        }
      }
      case "java7" {
        if( false == (endsWith the_target ".java")) {
          the_target = the_target + ".java"
        }
      }
      case "go" {
        if( false == (endsWith the_target ".go")) {
          the_target = the_target + ".go"
        }
      }
      case "scala" {
        if( false == (endsWith the_target ".scala")) {
          the_target = the_target + ".scala"
        }
      }
      case "kotlin" {
        if( false == (endsWith the_target ".kt")) {
          the_target = the_target + ".kt"
        }
      }
      case "dart" {
        if( false == (endsWith the_target ".dart")) {
          the_target = the_target + ".dart"
        }
      }
      case "cpp" {
        if( false == (endsWith the_target ".cpp")) {
          the_target = the_target + ".cpp"
        }
      }
      case "python" {
        if( false == (endsWith the_target ".py")) {
          the_target = the_target + ".py"
        }
      }
      case "rust" {
        if( false == (endsWith the_target ".rs")) {
          the_target = the_target + ".rs"
        }
      }
      case "llvm" {
        if( false == (endsWith the_target ".ll")) {
          the_target = the_target + ".ll"
        }
      }
    }
    set appCtx.compilerSettings "o" the_target

    ; intializations can be divided into two columns if parenthesis are used...
    def lcc (new LiveCompiler())      
    def node (unwrap parser.rootNode)
    def flowParser (new RangerFlowParser ())    
    def fileSystem@(lives) (new CodeFileSystem())
    if (appCtx.hasCompilerFlag("sourcemap")) {
      fileSystem.enableSourceMaps()
    }
    ; PLAN_FORMAT.md phase 3: break long method chains on the finished text.
    ; -1 is "on, at the target's own default width"; -width= overrides it.
    def fmtSetting:string (appCtx.getCompilerSetting("format"))
    if (fmtSetting != "none") {
      fileSystem.formatWidth = (0 - 1)
      def widthOpt@(optional) (params.getParam("width"))
      if (!null? widthOpt) {
        def widthStr:string (unwrap widthOpt)
        def widthOpt2@(optional):int (to_int widthStr)
        if (!null? widthOpt2) {
          def widthNum:int (unwrap widthOpt2)
          if (widthNum > 0) {
            fileSystem.formatWidth = widthNum
          }
        }
      }
    }
    
    def file (fileSystem.getFile("." the_target)) 
    def wr (file.getWriter())
    
    if(appCtx.hasCompilerFlag("copysrc")) {
      ; print "--> copying " + (code.filename)
      def fileWr (wr.getFileWriter("." code.filename))
      fileWr.raw( code.code false)
    }
    appCtx.parser = flowParser
    appCtx.compiler = lcc

    lcc.parser = flowParser

    if_javascript {
      if( appCtx.hasCompilerSetting("plugins")) {
        def val (appCtx.getCompilerSetting("plugins"))
        def list (strsplit val ",")
        list.forEach({
          try {
            def plugin (load_compiler_plugin item)
            def features ( register_plugin plugin )
            if(appCtx.hasCompilerFlag('verbose')) {
              print "Plugin " + item + " registered with features "
              features.forEach({
                print " [x] " + item
              })
            }
            def regPlug (new RangerRegisteredPlugin)
            regPlug.name = item
            regPlug.features = (clone features)
            appCtx.addPlugin(regPlug)
            ; plugin_preprocess plugin root appCtx (unwrap wr)
          } {
            print "Failed to register plugin " + item
          } 
        })
      }
      plugins_only = (appCtx.hasCompilerFlag("plugins-only"))
    }

    ; Print header and compilation info
    cli.printHeader()
    cli.setCompilationInfo(the_file the_target the_lang)
    cli.printCompilationInfo()
    print (cli.divider())
    print ""

    try {

      flowParser.mergeImports(node appCtx (unwrap wr) )
      def lang_str:string (read_file env langFilePath the_lang_file)
      def lang_code:SourceCode (new SourceCode ( (unwrap lang_str)) )
      lang_code.filename = the_lang_file
      def lang_parser:RangerLispParser (new RangerLispParser (lang_code))
      lang_parser.parse(false)
      appCtx.langOperators = (unwrap lang_parser.rootNode)
      flowParser.registerLangSystemClasses( (unwrap lang_parser.rootNode) appCtx (unwrap wr))
      appCtx.setRootFile( root_file )

      def ops (new RangerActiveOperators)
      ops.initFrom( (unwrap lang_parser.rootNode) )
      appCtx.operators = ops
      appCtx.targetLangName = the_lang
      lcc.initWriter( appCtx )

      cli.step(1 "Collecting methods")
      flowParser.CollectMethods (node appCtx (unwrap wr))
      if ( ( array_length appCtx.compilerErrors ) > 0 ) {
        VirtualCompiler.displayCompilerErrorsWithCLI(appCtx cli)
        cli.printFailure((array_length appCtx.compilerErrors))
        res.hasErrors = true
        res.errorMessage = "Errors during method collection phase"
        res.ctx = appCtx
        return res
      }

      flowParser.CreateCTTI( node appCtx (unwrap wr))

      if(appCtx.hasCompilerFlag('rtti')) {
        flowParser.CreateRTTI( node appCtx (unwrap wr))
      }

      if_javascript {
        def ppList (appCtx.findPluginsFor("pre_flow"))
        ppList.forEach({
          try {
            def plugin (load_compiler_plugin item)
            call_plugin plugin "pre_flow" root appCtx (unwrap wr)
          } {
          }
        })
      }
      appCtx.initOpList()
      cli.step(2 "Analyzing code")

      flowParser.StartWalk (node appCtx (unwrap wr))
      flowParser.SolveAsyncFuncs( root appCtx (unwrap wr))

      ; The API model is built here, after the whole program is analysed and
      ; before anything is written: the language writers read docBlock off the
      ; descriptors, and the doc validation has to report with the rest of the
      ; analysis errors rather than after code generation.
      def apiBuilder:RangerApiBuilder (new RangerApiBuilder)
      def apiModel:RangerApiModel (apiBuilder.build(appCtx))

      ; Check for errors after analysis phase
      if ( ( array_length appCtx.compilerErrors ) > 0 ) {
        print ""
        VirtualCompiler.displayCompilerErrorsWithCLI(appCtx cli)
        cli.printFailure((array_length appCtx.compilerErrors))
        res.hasErrors = true
        res.errorMessage = "Errors during code analysis phase"
        res.ctx = appCtx
        return res
      }

      ; Run static analysis for C++ and Rust targets
      if ((appCtx.targetLangName == "cpp") || (appCtx.targetLangName == "rust")) {
        cli.stepWithDetail(3 "Static analysis" ("for " + appCtx.targetLangName))
        def staticAnalyzer:StaticAnalyzer (new StaticAnalyzer())
        staticAnalyzer.ctx = appCtx
        staticAnalyzer.analyzeAll()
        
        ; Check for errors after static analysis
        if ( ( array_length appCtx.compilerErrors ) > 0 ) {
          print ""
          VirtualCompiler.displayCompilerErrorsWithCLI(appCtx cli)
          cli.printFailure((array_length appCtx.compilerErrors))
          res.hasErrors = true
          res.errorMessage = "Errors during static analysis phase"
          res.ctx = appCtx
          return res
        }
      } {
        cli.step(3 "Type checking")
      }

      ; Ownership inference (target-independent escape summary).
      ; -strict-ownership runs it for any target and prints the result. The C++
      ; writer reads the result as well: a `borrowed` object parameter becomes
      ; `const std::shared_ptr<T>&` instead of a copy of the pointer, so the
      ; pass must run for that target with or without the flag. The Rust
      ; writer reads it too: a proven-borrowed object parameter becomes `&T`
      ; (applyOwnershipToRustBorrows, PLAN_RUST_OWNERSHIP step 1).
      def ownStrict:boolean (appCtx.hasCompilerFlag("strict-ownership"))
      if ((ownStrict || (appCtx.targetLangName == "cpp")) || (appCtx.targetLangName == "rust")) {
        def ownAnalyzer:StaticAnalyzer (new StaticAnalyzer())
        ownAnalyzer.ctx = appCtx
        ownAnalyzer.analyzeOwnershipAll(ownStrict)
        if (appCtx.targetLangName == "rust") {
          ownAnalyzer.applyOwnershipToRustBorrows()
          ; never-computed strings become &'static str (rust_static_str)
          ownAnalyzer.analyzeRustStaticStrings()
          ; shared classes as Rc<RefCell<T>> (PLAN_RUST_OWNERSHIP 2b) — the
          ; default; -rust-value-classes restores the plain-struct model
          if ((appCtx.hasCompilerFlag("rust-value-classes")) == false) {
            ownAnalyzer.applySharedClassRcWrap()
            ownAnalyzer.computeSelfRcNeeds()
          }
        }
      }

      cli.step(4 "Generating code")

      if (appCtx.targetLangName == "llvm") {
        def llvmPipeline (new RangerLLVMPipeline())
        llvmPipeline.generateModule(appCtx (unwrap wr))
        res.target_dir = the_target_dir
        res.fileSystem = fileSystem
        res.ctx = appCtx
        cli.printSuccess(the_target)
        return res
      }

      switch appCtx.targetLangName {
        case "java7" {
          if(has comp_attrs "android_res_dir") {
            ; print "--> had android res dir"
            def resDir (unwrap (get comp_attrs "android_res_dir"))
            def resFs:CodeFileSystem (new CodeFileSystem())
            def file:CodeFile (resFs.getFile("." "README.txt"))
            def wr:CodeWriter (unwrap (file.getWriter()))
            def builder (new viewbuilder_Android)
            appCtx.viewClassBody.forEach({
                builder.writeClass( item appCtx wr )
            })
            resFs.saveTo(resDir (appCtx.hasCompilerFlag("show-writes")))          
          }
        }
        case "es6" {
          if(has comp_attrs "web_res_dir") {
            print "--> had web res dir"
            def resDir (unwrap (get comp_attrs "web_res_dir"))
            def resFs:CodeFileSystem (new CodeFileSystem())
            def file:CodeFile (resFs.getFile("." "webviews.html"))
            def wr:CodeWriter (unwrap (file.getWriter()))
            def builder (new viewbuilder_Web)
            builder.CreateViews( appCtx wr)
            resFs.saveTo(resDir (appCtx.hasCompilerFlag("show-writes")))          
          }
        }
      }

        def staticMethods:RangerAppClassDesc
        
        ; Polyfill position tags. Physical slice order below is:
        ;   [before_imports][importFork][forward_declarations][after_imports]
        ;   [contentFork][utilities][file_end]
        ; before_imports  -> ahead of the #include/import lines (e.g. #define guards)
        ; forward_declarations -> right after the imports, before any content, so
        ;   embedded helpers (polyfills) can forward-declare each other and avoid
        ;   "use of undeclared identifier" ordering errors in C++.
        def beforeImports:CodeWriter (wr.createTag("before_imports"))
        def importFork:CodeWriter (wr.fork())
        def forwardDecls:CodeWriter (wr.createTag("forward_declarations"))
        wr.createTag("after_imports")
        def contentFork (wr.fork())
        wr.createTag("utilities")
        def theEnd (wr.createTag("file_end"))
        if (appCtx.hasCompilerFlag("typescript")) {
          if (has appCtx.compilerSettings "processTsHelpers") {
            def __rgrTs:string (unwrap (get appCtx.compilerSettings "processTsHelpers"))
            if ((strlen __rgrTs) > 0) {
              theEnd.raw(__rgrTs false)
              theEnd.newline()
            }
          }
        }

        wr = contentFork

        ; Every doc example is rendered in the target's own syntax before a
        ; single class is written, because the doc comment that quotes one is
        ; usually emitted before the example itself would have been.
        for apiBuilder.exampleFns exFn:RangerAppFunctionDesc exIdx {
          exFn.docExampleText = (lcc.langWriter.renderDocExample(exFn appCtx (unwrap wr)))
        }

        def handledClasses:[string:boolean]

        for appCtx.definedClassList cName:string i {
          if (cName == "RangerStaticMethods") {
            staticMethods = (get appCtx.definedClasses cName)
            continue _
          }
          def cl:RangerAppClassDesc (get appCtx.definedClasses cName)
          if(cl.is_operator_class) {
            continue
          }
          if(cl.is_trait) {
            continue
          }
          if(cl.is_system) {
            continue _
          }
          if(cl.is_generic_instance) {
            continue
          }          
          if(cl.is_system_union) {
            continue _
          }
          if(cl.is_union) {
            continue _
          }          
          if(has handledClasses cName) {
            continue
          }
          set handledClasses cName true

          if( (array_length cl.extends_classes) > 0 ) {
            ; got to walk the extended classes first..
            for cl.extends_classes eClassName:string i {
              if(has handledClasses eClassName) {
                continue
              }
              def parentCl:RangerAppClassDesc (get appCtx.definedClasses eClassName)
              lcc.WalkNode( (unwrap parentCl.classNode ) appCtx (unwrap wr))
              set handledClasses eClassName true      
            }
          }

          lcc.WalkNode( (unwrap cl.classNode ) appCtx (unwrap wr))
          
        }        
        if (!null? staticMethods) {
          lcc.WalkNode( (unwrap staticMethods.classNode) appCtx (unwrap wr))
        }
        for flowParser.collectedIntefaces ifDesc:RangerAppClassDesc i {
            print "should define also interface " + ifDesc.name
            lcc.langWriter.writeInterface( ifDesc appCtx (unwrap wr) )
        }

        for appCtx.definedClassList cName:string i {
          if(has handledClasses cName) {
            continue
          }
          if (cName == "RangerStaticMethods") {
            staticMethods = (get appCtx.definedClasses cName)
            continue _
          }
          def cl:RangerAppClassDesc (get appCtx.definedClasses cName)
          if(cl.is_operator_class) {
            continue 
          }
          if(cl.is_generic_instance) {
            lcc.WalkNode( (unwrap cl.classNode ) appCtx (unwrap wr))
          }
          if(cl.is_trait) {
            continue
          }
          if(cl.is_system) {
            continue _
          }
          if(cl.is_operator_class) {
            continue
          }
          if(cl.is_generic_instance) {
            continue
          }          
          if(cl.is_system_union) {
            continue _
          }
          if(cl.is_union) {
            continue _
          }          
          lcc.WalkNode( (unwrap cl.classNode ) appCtx (unwrap wr))
        }        

        for appCtx.definedClassList cName:string i {
          def cl:RangerAppClassDesc (get appCtx.definedClasses cName)
          if(cl.is_operator_class) {
            lcc.WalkNode( (unwrap cl.classNode ) appCtx (unwrap wr))
          }
        }

        ; Every class is written now, so a target that emits a preamble of
        ; runtime helpers can finally see which of them the program uses. It
        ; runs BEFORE the imports are collected, so a helper it decides to
        ; write may still add the header/crate it needs.
        lcc.langWriter.finalizeFile( appCtx (unwrap wr) )

        ; This should be changed into something like
        ; import R from 'foo/bar'
        def import_list:[string] (wr.getImports ())
        if(appCtx.targetLangName == "go") {
          importFork.out("package main" true)
          importFork.newline()
          importFork.out("import (" true)
          importFork.indent(1)
        }
        def added_import:[string:boolean]
        for import_list codeStr:string i {

          if( has added_import codeStr) {
            continue
          }
          set added_import codeStr true

          switch appCtx.targetLangName {
            case "es6" {
              def parts (strsplit codeStr ".")
              let p0 = (itemAt parts 0)
              if( (array_length parts) > 1) {
                let p1 = (itemAt parts 1)
                importFork.out (('const ' +  p1 + " = require('" + p0 + "')." + p1 +  ";") , true)
              }
              if( (array_length parts) == 1) {
                importFork.out (('const ' +  p0 + " = require('" + p0 + "');") , true)
              }

              ; the Import version
              ; if( (array_length parts) > 1) {
              ;  importFork.out (("import  { " + (itemAt parts 1) + " } from  '" + (itemAt parts 0) + "';") , true)
              ; }
              ; if( (array_length parts) == 1) {
              ;  importFork.out (("import  " + (itemAt parts 0) + " from  '" + (itemAt parts 0) + "';") , true)
              ; }
            }
            case "go" {
              if ( (charAt codeStr 0) == (to_int (charcode "_") ) ) {
                importFork.out (( ' _ \"' + (substring codeStr 1 (strlen codeStr)) + "\"") , true)
              } {
                importFork.out (('\"' + codeStr + '\"') , true)
              }
              
            }
            case "csharp" {
              importFork.out(("using " + codeStr + ";") true)              
            }
            case "rust" {
              importFork.out (( "use " + codeStr + ";") , true)
            }
            case "java7" {
              importFork.out (("import "  + codeStr + ";") , true)
            }
            case "dart" {
              ; Dart imports are quoted library URIs: dart:math, package:foo/bar.dart
              importFork.out (("import '" + codeStr + "';") , true)
            }
            case "cpp" {
              importFork.out (( '#include  ' + codeStr ) , true)
            }
            default {
              importFork.out (('import '  + codeStr ) , true)
            }
          }        
        }				
        if(appCtx.targetLangName == "go") {
          importFork.indent(-1)
          importFork.out(')' true)
        }
        if( appCtx.hasCompilerSetting('classdoc') ) {
          def gen (new RangerDocGenerator)
          gen.createClassDoc( root appCtx (unwrap wr) )
        }
        if( appCtx.hasCompilerSetting('operatordoc') ) {
          def gen (new RangerDocGenerator)
          gen.createOperatorDoc( root appCtx (unwrap wr) )
        }
        if( appCtx.hasCompilerSetting('apidoc') ) {
          def apiGen (new RangerApiArtifactWriter)
          apiGen.writeAll( apiModel appCtx (unwrap wr) )
        }
        if( appCtx.hasCompilerFlag('apipackage') ) {
          def pkgGen (new RangerApiPackageWriter)
          pkgGen.writeAll( apiModel appCtx (unwrap wr) node )
        }
        for apiModel.warnings warnMsg:string warnIdx {
          print (cli.warning(("api docs: " + warnMsg)))
        }
      
        cli.step(5 "Writing output")
        
        VirtualCompiler.displayCompilerErrorsWithCLI(appCtx cli)
        if ( ( array_length appCtx.compilerErrors ) > 0 ) {
          cli.printFailure((array_length appCtx.compilerErrors))
          res.hasErrors = true
          res.errorMessage = "Errors during compilation phase"
        } {
          ; Success - print summary
          def outputPath the_target_dir + "/" + the_target
          cli.printSuccess(outputPath)
        }

        if_javascript {
          def ppList (appCtx.findPluginsFor('postprocess'))
          ppList.forEach({
            try {
              def plugin (load_compiler_plugin item)
              call_plugin plugin "postprocess" root appCtx (unwrap wr)
            } {
            }
          })
        }        
      
        res.target_dir = the_target_dir
        res.fileSystem = fileSystem
        res.ctx = appCtx

    } {
      def err_msg (error_msg)
      print ""
      print (cli.error("Unexpected compiler error"))
      print ""
      print "  " + (cli.gray(err_msg))
      res.hasErrors = true
      res.ctx = appCtx
      ; No `return` from inside a catch block: on Go the catch is a deferred
      ; closure running recover(), so a return there returns from the CLOSURE
      ; and not from run() -- `too many return values, have (*CompilerResults),
      ; want ()`. The nesting below says the same thing without one; all three
      ; paths ended with the same two statements anyway.
      if(lcc.lastProcessedNode) {
        print ""
        print (cli.gray("Error occurred near:"))
        print "  " + (lcc.lastProcessedNode.getLineAsString())
      } {
        if(flowParser.lastProcessedNode) {
          print ""
          print (cli.gray("Error occurred near:"))
          print "  " + (flowParser.lastProcessedNode.getLineAsString())
        }
      }
      res.errorMessage = err_msg
      cli.printFailure(1)
    }
    
    return res


  }

  ; New method with CLI formatting
  static fn displayCompilerErrorsWithCLI:void (appCtx@(weak):RangerAppWriterContext cli:CLIProgress) {
    for appCtx.compilerErrors e:RangerCompilerMessage i {
        def line_index:int (e.node.getLine())
        def col_index:int (e.node.code.getColumn(e.node.sp))
        def filename:string (e.node.getFilename())
        def lineContent:string (e.node.getLineString(line_index))
        
        ; Get previous and next lines for context
        def prevLine:string ""
        def nextLine:string ""
        if (line_index > 0) {
            prevLine = (e.node.getLineString((line_index - 1)))
        }
        nextLine = (e.node.getLineString((line_index + 1)))
        
        cli.printCompilerError(filename (line_index + 1) col_index e.description lineContent prevLine nextLine)
    }        
  }

  ; Legacy method kept for compatibility
  static fn displayCompilerErrors:void (appCtx@(weak):RangerAppWriterContext) {
    def cons:ColorConsole (new ColorConsole())

    for appCtx.compilerErrors e:RangerCompilerMessage i {
        def line_index:int (e.node.getLine ())                      
        cons.out( "gray" ( (e.node.getFilename ()) + " Line: " + (1 + line_index)) ) 
        cons.out( "gray" e.description )
        cons.out( "gray" (e.node.getLineString(line_index)) )
        cons.out( "" ( (e.node.getColStartString()) + "^-------" ) )
    }        
  }

  static fn displayParserErrors:void (appCtx@(weak):RangerAppWriterContext) {
    if ( (array_length appCtx.parserErrors) == 0 ) {
      ; print "no language test errors"
      return
    }
    print "LANGUAGE TEST ERRORS:"
    for appCtx.parserErrors e:RangerCompilerMessage i {
        def line_index:int (e.node.getLine ())                      
        print ( (e.node.getFilename ()) + " Line: " + (1 + line_index))
        print e.description
        print (e.node.getLineString(line_index))
    }        
  }

}

operators {
  normalize cmdArg:string ( arg:string ) {
      templates {
          python ( "rg_path_normalize(" (e 1) ")" (imp "os")
          (create_polyfill "
# Path helpers for the compiler's own file handling. os.path.normpath drops a
# trailing slash and Node's path.normalize keeps it, and the compiler builds its
# library search path by concatenating onto one, so these follow Node.
def rg_path_normalize(p):
    s = p.replace(chr(92), \"/\")
    trailing = len(s) > 1 and s.endswith(\"/\")
    out = os.path.normpath(s).replace(chr(92), \"/\")
    if out == \"\":
        return \".\"
    if trailing and out != \"/\":
        out = out + \"/\"
    return out

def rg_path_dirname(p):
    s = rg_path_normalize(p)
    if len(s) > 1 and s.endswith(\"/\"):
        s = s[:-1]
    pos = s.rfind(\"/\")
    if pos < 0:
        return \".\"
    if pos == 0:
        return \"/\"
    return s[:pos]
")
          )
          dart ( "rg_path_normalize(" (e 1) ")"
          (create_polyfill "
// Path helpers for the compiler's own file handling. package:path would do
// this, but the generated program has to run with a plain `dart run` and no
// pubspec, so these are string operations. The shape follows Node's
// path.normalize / path.dirname, because that is what the JavaScript host of
// the same Ranger source does.
String rg_path_normalize(String p) {
  final String s = p.replaceAll(String.fromCharCode(92), '/');
  final bool absolute = s.startsWith('/');
  final bool trailing = s.length > 1 && s.endsWith('/');
  final List<String> parts = <String>[];
  for (final String cur in s.split('/')) {
    if (cur == '..') {
      if (parts.isNotEmpty && parts[parts.length - 1] != '..') {
        parts.removeLast();
      } else if (absolute == false) {
        parts.add(cur);
      }
    } else if (cur.isNotEmpty && cur != '.') {
      parts.add(cur);
    }
  }
  String out = parts.join('/');
  if (absolute) { out = '/' + out; }
  if (out.isEmpty) { return '.'; }
  if (trailing && out != '/') { out = out + '/'; }
  return out;
}
String rg_path_dirname(String p) {
  String s = rg_path_normalize(p);
  if (s.length > 1 && s.endsWith('/')) { s = s.substring(0, s.length - 1); }
  final int pos = s.lastIndexOf('/');
  if (pos < 0) { return '.'; }
  if (pos == 0) { return '/'; }
  return s.substring(0, pos);
}
")
          )
          cpp ( "rg_path_normalize(" (e 1) ")"
          (create_polyfill "
#include <string>
#include <vector>
// Path helpers for the compiler's own file handling. std::filesystem would do
// this, but the generated program has to build with a plain -std=c++17 line and
// no extra library, so these are string operations. The shape follows Node's
// path.normalize / path.dirname, because that is what the JavaScript host of
// the same Ranger source does.
inline std::string rg_path_normalize(const std::string& p) {
    std::string s;
    for (size_t i = 0; i < p.size(); i++) { s.push_back(p[i] == (char)92 ? '/' : p[i]); }
    bool absolute = (s.size() > 0 && s[0] == '/');
    bool trailing = (s.size() > 1 && s[s.size() - 1] == '/');
    std::vector<std::string> parts;
    std::string cur;
    for (size_t i = 0; i <= s.size(); i++) {
        if (i == s.size() || s[i] == '/') {
            if (cur == \"..\") {
                if (parts.size() > 0 && parts[parts.size() - 1] != \"..\") { parts.pop_back(); }
                else if (absolute == false) { parts.push_back(cur); }
            } else if (cur.size() > 0 && cur != \".\") {
                parts.push_back(cur);
            }
            cur.clear();
        } else { cur.push_back(s[i]); }
    }
    std::string out;
    for (size_t i = 0; i < parts.size(); i++) {
        if (i > 0) { out.push_back('/'); }
        out += parts[i];
    }
    if (absolute) { out = std::string(\"/\") + out; }
    if (out.size() == 0) { return std::string(\".\"); }
    if (trailing && out != \"/\") { out.push_back('/'); }
    return out;
}
inline std::string rg_path_dirname(const std::string& p) {
    std::string s = rg_path_normalize(p);
    if (s.size() > 1 && s[s.size() - 1] == '/') { s.erase(s.size() - 1); }
    size_t pos = s.rfind('/');
    if (pos == std::string::npos) { return std::string(\".\"); }
    if (pos == 0) { return std::string(\"/\"); }
    return s.substr(0, pos);
}
")

; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; OdpParser.rgr — an OpenDocument presentation, read into OdpModel
; ==============================================================================
;
; The shape of the job, and where it differs from `PptxParser`:
;
;     .pptx                              .odp
;     one part per slide                 one content.xml, `draw:page` each
;     theme + master + layout parts      styles.xml: office:styles,
;                                        office:automatic-styles,
;                                        office:master-styles
;     r:id → rels → part                 xlink:href → member
;     EMU integers                       "2.54cm"
;
; So this reader opens exactly two parts and walks them, where the deck reader
; opens one per slide plus a layout and a master for each. That is not a
; simplification of ODF; it is what ODF is.
;
; THE ONE THING WORTH KNOWING BEFORE READING THE CODE. LibreOffice writes the
; DrawingML preset name straight through when it converts a `.pptx`:
;
;     <a:prstGeom prst="roundRect"/>        →   draw:type="ooxml-roundRect"
;
; So a converted deck can be drawn with the 187 preset geometries this
; repository already has, by stripping one prefix. A deck AUTHORED in Impress
; says `draw:type="round-rectangle"` instead, and those are a different, older
; vocabulary — `OdpPresets` maps the common ones and leaves the rest to be
; drawn as their box, which is what `PptxToEvg.drawnAsBox` already does for a
; preset it has no geometry for.
;
; That answers the measurement PLAN_FORMATS.md step 1.3 asked for: the
; GEOMETRY EVALUATOR generalises for converted files and the VOCABULARY does
; not. `draw:enhanced-path` with its own `draw:equation` list is a second
; language for the same idea and is not read here — a shape whose geometry is
; only expressed that way is drawn as its box, visibly and on purpose.
; ==============================================================================

Import "../odf/OdfPackage.rgr"
Import "../xml/XmlCore.rgr"
Import "OdpModel.rgr"
Import "OdpStyles.rgr"

class OdpParser {
    def pkg:OdfPackage (new OdfPackage())
    def styles:OdpStyles (new OdpStyles())
    def opened:boolean false
    ; master page name → the page layout it names, so the slide size can be
    ; found without walking styles.xml twice.
    def masterLayout:[string:string]
    ; page layout name → "widthPt|heightPt"
    def layoutSize:[string:string]
    def masterPageStyle:[string:string]

    Constructor () {
        def a:[string:string]
        masterLayout = a
        def b:[string:string]
        layoutSize = b
        def c:[string:string]
        masterPageStyle = c
    }

    fn open:boolean (fullPath:string) {
        return (pkg.open(fullPath))
    }

    fn openParts:boolean (path:string name:string) {
        return (pkg.openParts(path name))
    }

    fn openBytes:boolean (bytes:buffer name:string) {
        return (pkg.openBytes(bytes name))
    }

    fn close:void () {
        pkg.close()
    }

    ; ------------------------------------------------------------------
    ; XML, with ODF's name policy
    ; ------------------------------------------------------------------

    ; The one place the prefix-keeping mode is turned on, so no caller can
    ; half-apply it. `text:p` and `text:span` hold their own whitespace: a
    ; space between two spans is the space between two words, and dropping it
    ; runs them together — the same bug DrawingML's `<a:t>` has, which is why
    ; `XmlCore` takes the list rather than hard-coding one name.
    fn parsePart@(optional):XmlNode (partName:string) {
        def missing@(optional):XmlNode
        def xml:string (pkg.readXml(partName))
        if ((strlen xml) == 0) {
            return missing
        }
        def parser (new XmlParser())
        parser.keepPrefixes = true
        push parser.spaceElements "text:p"
        push parser.spaceElements "text:span"
        push parser.spaceElements "text:a"
        return (parser.parse(xml))
    }

    ; ------------------------------------------------------------------
    ; The document
    ; ------------------------------------------------------------------

    fn parsePresentation:OdpPresentation () {
        def out (new OdpPresentation())
        out.name = pkg.filename
        def stylesRoot@(optional):XmlNode (this.parsePart("styles.xml"))
        if (!null? stylesRoot) {
            def sr:XmlNode (unwrap stylesRoot)
            styles.collect(sr)
            this.readPageLayouts(sr)
            this.readMasters(sr out)
        }
        def contentRoot@(optional):XmlNode (this.parsePart("content.xml"))
        if (null? contentRoot) {
            return out
        }
        def cr:XmlNode (unwrap contentRoot)
        ; The content's own automatic styles are read AFTER the common ones,
        ; and into the same table: an automatic style names a common one as its
        ; parent, never the other way round.
        styles.collect(cr)
        def body@(optional):XmlNode (cr.find("office:body"))
        if (null? body) {
            return out
        }
        def b:XmlNode (unwrap body)
        def pres@(optional):XmlNode (b.find("office:presentation"))
        if (null? pres) {
            return out
        }
        def p:XmlNode (unwrap pres)
        def pages:[XmlNode] (p.childrenNamed("draw:page"))
        def i:int 0
        while (i < (array_length pages)) {
            def page:OdpPage (this.readPage((itemAt pages i)))
            push out.pages page
            i = (i + 1)
        }
        this.applyPageSize(out)
        return out
    }

    ; `fo:page-width` / `fo:page-height` live on a page layout, which a master
    ; page names. A deck whose masters disagree about the page size is legal
    ; and nobody writes one, so the first slide's master decides and the rest
    ; follow — stated here rather than discovered later.
    fn readPageLayouts:void (root:XmlNode) {
        def autos@(optional):XmlNode (root.find("office:automatic-styles"))
        if (null? autos) {
            return
        }
        def a:XmlNode (unwrap autos)
        def layouts:[XmlNode] (a.childrenNamed("style:page-layout"))
        def i:int 0
        while (i < (array_length layouts)) {
            def layout:XmlNode (itemAt layouts i)
            def name:string (layout.attr("style:name"))
            def props@(optional):XmlNode (layout.firstChild("style:page-layout-properties"))
            if (!null? props) {
                def pr:XmlNode (unwrap props)
                def w:double (OdpUnits.toPt((pr.attr("fo:page-width"))))
                def h:double (OdpUnits.toPt((pr.attr("fo:page-height"))))
                if ((w > 0.0) && (h > 0.0)) {
                    set layoutSize name ((to_string w) + "|" + (to_string h))
                }
            }
            i = (i + 1)
        }
    }

    fn readMasters:void (root:XmlNode out:OdpPresentation) {
        def masterStyles@(optional):XmlNode (root.find("office:master-styles"))
        if (null? masterStyles) {
            return
        }
        def ms:XmlNode (unwrap masterStyles)
        def pages:[XmlNode] (ms.childrenNamed("style:master-page"))
        def i:int 0
        while (i < (array_length pages)) {
            def node:XmlNode (itemAt pages i)
            def name:string (node.attr("style:name"))
            set masterLayout name (node.attr("style:page-layout-name"))
            set masterPageStyle name (node.attr("draw:style-name"))
            def page (new OdpPage())
            page.name = name
            page.background = (this.backgroundFor((node.attr("draw:style-name"))))
            this.readShapesInto(node page.shapes true)
            set out.masters name page
            i = (i + 1)
        }
    }

    fn applyPageSize:void (out:OdpPresentation) {
        if ((array_length out.pages) == 0) {
            return
        }
        def first:OdpPage (itemAt out.pages 0)
        def layout:string ""
        if (has masterLayout first.masterName) {
            layout = (unwrap (get masterLayout first.masterName))
        }
        if ((strlen layout) == 0) {
            return
        }
        if ((has layoutSize layout) == false) {
            return
        }
        def packed:string (unwrap (get layoutSize layout))
        def bar:int (indexOf packed "|")
        if (bar < 0) {
            return
        }
        def w@(optional):double (str2double (substring packed 0 bar))
        def h@(optional):double (str2double (substring packed (bar + 1) (strlen packed)))
        def wv:double (?? w 0.0)
        def hv:double (?? h 0.0)
        if ((wv > 0.0) && (hv > 0.0)) {
            out.widthPt = wv
            out.heightPt = hv
        }
    }

    fn backgroundFor:OdpFill (styleName:string) {
        def props:OdpGraphicProps (styles.resolveGraphic("drawing-page" styleName))
        return (props.fill)
    }

    ; ------------------------------------------------------------------
    ; A slide
    ; ------------------------------------------------------------------

    fn readPage:OdpPage (node:XmlNode) {
        def page (new OdpPage())
        page.name = (node.attr("draw:name"))
        page.masterName = (node.attr("draw:master-page-name"))
        page.background = (this.backgroundFor((node.attr("draw:style-name"))))
        ; A slide that states no background of its own takes the master's,
        ; which is where a converted deck's white comes from.
        if ((page.background.isVisible()) == false) {
            if (has masterPageStyle page.masterName) {
                def masterStyle:string (unwrap (get masterPageStyle page.masterName))
                page.background = (this.backgroundFor(masterStyle))
            }
        }
        this.readShapesInto(node page.shapes false)
        page.notes = (this.readNotes(node))
        return page
    }

    ; Speaker notes are inside the `draw:page`, not in a part of their own —
    ; the one place ODF's single-document shape is simpler than OOXML's.
    fn readNotes:string (node:XmlNode) {
        def notes@(optional):XmlNode (node.firstChild("presentation:notes"))
        if (null? notes) {
            return ""
        }
        def n:XmlNode (unwrap notes)
        def frames:[OdpShape]
        this.readShapesInto(n frames false)
        def out:string ""
        def i:int 0
        while (i < (array_length frames)) {
            def s:OdpShape (itemAt frames i)
            def text:string (s.plainText())
            if ((strlen text) > 0) {
                if ((strlen out) > 0) {
                    out = (out + "\n")
                }
                out = (out + text)
            }
            i = (i + 1)
        }
        return out
    }

    ; The drawing children of a page, a master page or a group, in document
    ; order — which is the z-order the file states and the reading order
    ; PowerPoint's own pane edits. Sorting by position would look tidier and
    ; disagree with every other tool.
    fn readShapesInto:void (node:XmlNode out:[OdpShape] fromMaster:boolean) {
        def i:int 0
        while (i < (array_length node.children)) {
            def child:XmlNode (itemAt node.children i)
            if (child.isText == false) {
                if (OdpParser.isDrawing(child.name)) {
                    def shape@(optional):OdpShape (this.readShape(child fromMaster))
                    if (!null? shape) {
                        push out (unwrap shape)
                    }
                }
            }
            i = (i + 1)
        }
    }

    sfn isDrawing:boolean (name:string) {
        if (name == "draw:frame") {
            return true
        }
        if (name == "draw:custom-shape") {
            return true
        }
        if (name == "draw:rect") {
            return true
        }
        if (name == "draw:ellipse") {
            return true
        }
        if (name == "draw:circle") {
            return true
        }
        if (name == "draw:line") {
            return true
        }
        if (name == "draw:polygon") {
            return true
        }
        if (name == "draw:polyline") {
            return true
        }
        if (name == "draw:path") {
            return true
        }
        if (name == "draw:connector") {
            return true
        }
        if (name == "draw:g") {
            return true
        }
        return false
    }

    fn readShape@(optional):OdpShape (node:XmlNode fromMaster:boolean) {
        def missing@(optional):OdpShape
        def shape (new OdpShape())
        shape.name = (node.attr("draw:name"))
        shape.presentationClass = (node.attr("presentation:class"))
        shape.fromMaster = fromMaster

        ; A master page's placeholders are empty boxes waiting for a slide to
        ; fill them. Drawing them puts "Click to add title" under every real
        ; title, which is what a first draft of this did.
        if fromMaster {
            if ((node.attr("presentation:placeholder")) == "true") {
                return missing
            }
        }
        ; The notes thumbnail is a picture OF the slide. Drawing it on the
        ; slide is a hall of mirrors.
        if (shape.presentationClass == "page") {
            return missing
        }

        shape.x = (OdpUnits.toPt((node.attr("svg:x"))))
        shape.y = (OdpUnits.toPt((node.attr("svg:y"))))
        shape.width = (OdpUnits.toPt((node.attr("svg:width"))))
        shape.height = (OdpUnits.toPt((node.attr("svg:height"))))
        this.applyTransform(shape (node.attr("draw:transform")))

        ; The style family is `presentation` for a placeholder and `graphic`
        ; for everything else, and a shape states whichever applies. Reading
        ; only `draw:style-name` loses every placeholder's fill.
        def styleFamily:string "graphic"
        def styleName:string (node.attr("draw:style-name"))
        def presStyle:string (node.attr("presentation:style-name"))
        if ((strlen presStyle) > 0) {
            styleFamily = "presentation"
            styleName = presStyle
        }
        def props:OdpGraphicProps (styles.resolveGraphic(styleFamily styleName))
        shape.fill = props.fill
        shape.stroke = props.stroke
        shape.verticalAlign = props.verticalAlign
        shape.padLeft = props.padLeft
        shape.padRight = props.padRight
        shape.padTop = props.padTop
        shape.padBottom = props.padBottom

        if (node.name == "draw:g") {
            shape.kind = (OdpShapeKind.group())
            this.readShapesInto(node shape.children fromMaster)
            OdpParser.growToChildren(shape)
            def groupHit@(optional):OdpShape shape
            return groupHit
        }

        if ((node.name == "draw:line") || (node.name == "draw:connector")) {
            shape.kind = (OdpShapeKind.line())
            OdpParser.readLineEnds(shape node)
        } {
            shape.kind = (OdpShapeKind.geometry())
        }

        def image@(optional):XmlNode (node.firstChild("draw:image"))
        if (!null? image) {
            def img:XmlNode (unwrap image)
            def href:string (img.attr("xlink:href"))
            if ((strlen href) > 0) {
                if ((OdfPackage.isExternalHref(href)) == false) {
                    def part:string (OdfPackage.joinHref("content.xml" href))
                    if (pkg.hasPart(part)) {
                        shape.kind = (OdpShapeKind.image())
                        shape.imagePart = part
                        ; The bytes travel with the model, as they do in the
                        ; deck reader, so a host with no file server can turn
                        ; them into a texture. See PptxApp.imagePartsJson.
                        shape.imageBytes = (pkg.readBinary(part))
                    }
                }
            }
        }

        this.readGeometryName(shape node)
        this.readText(shape node styleFamily styleName)

        def hit@(optional):OdpShape shape
        return hit
    }

    ; `draw:type` off the enhanced geometry, with LibreOffice's `ooxml-`
    ; prefix removed. That prefix is the whole reason a converted deck can be
    ; drawn with the DrawingML presets this repository already evaluates.
    fn readGeometryName:void (shape:OdpShape node:XmlNode) {
        def geom@(optional):XmlNode (node.firstChild("draw:enhanced-geometry"))
        if (null? geom) {
            if (node.name == "draw:rect") {
                shape.presetName = "rect"
            }
            if (node.name == "draw:ellipse") {
                shape.presetName = "ellipse"
            }
            if (node.name == "draw:circle") {
                shape.presetName = "ellipse"
            }
            return
        }
        def g:XmlNode (unwrap geom)
        def t:string (g.attr("draw:type"))
        shape.presetName = (OdpParser.presetNameOf(t))
    }

    ; ODF's own shape vocabulary is older than DrawingML's and spells the
    ; common ones differently. Only the names a slide actually uses are mapped;
    ; an unmapped one keeps its ODF spelling, and the painter draws it as its
    ; box — visibly a rectangle where a rectangle is wrong, rather than
    ; silently nothing.
    sfn presetNameOf:string (drawType:string) {
        if ((strlen drawType) == 0) {
            return ""
        }
        if ((indexOf drawType "ooxml-") == 0) {
            return (substring drawType 6 (strlen drawType))
        }
        if (drawType == "rectangle") {
            return "rect"
        }
        if (drawType == "round-rectangle") {
            return "roundRect"
        }
        if (drawType == "ellipse") {
            return "ellipse"
        }
        if (drawType == "circle") {
            return "ellipse"
        }
        if (drawType == "isosceles-triangle") {
            return "triangle"
        }
        if (drawType == "right-triangle") {
            return "rtTriangle"
        }
        if (drawType == "diamond") {
            return "diamond"
        }
        if (drawType == "hexagon") {
            return "hexagon"
        }
        if (drawType == "octagon") {
            return "octagon"
        }
        if (drawType == "pentagon") {
            return "pentagon"
        }
        if (drawType == "star5") {
            return "star5"
        }
        if (drawType == "can") {
            return "can"
        }
        if (drawType == "cube") {
            return "cube"
        }
        if (drawType == "smiley") {
            return "smileyFace"
        }
        if (drawType == "heart") {
            return "heart"
        }
        if (drawType == "sun") {
            return "sun"
        }
        if (drawType == "moon") {
            return "moon"
        }
        if (drawType == "cloud") {
            return "cloud"
        }
        return drawType
    }

    ; `draw:transform` is a list of SVG-flavoured operations. Only `rotate`
    ; and `translate` are honoured, because they are what a slide uses: a
    ; rotated shape carries no `svg:x`/`svg:y` at all and is positioned by the
    ; translate, so ignoring it would stack every rotated shape at the origin.
    fn applyTransform:void (shape:OdpShape transform:string) {
        if ((strlen transform) == 0) {
            return
        }
        def rot:string (OdpParser.transformArg(transform "rotate"))
        if ((strlen rot) > 0) {
            def parsed@(optional):double (str2double (OdpUnits.trimText(rot)))
            def rad:double (?? parsed 0.0)
            shape.rotation = (OdpUnits.radiansToDegrees(rad))
        }
        def trans:string (OdpParser.transformArg(transform "translate"))
        if ((strlen trans) > 0) {
            def parts:[string]
            OdpParser.splitSpaces(trans parts)
            if ((array_length parts) >= 2) {
                shape.x = (OdpUnits.toPt((itemAt parts 0)))
                shape.y = (OdpUnits.toPt((itemAt parts 1)))
            }
        }
    }

    ; The text between the parentheses of one operation, or "".
    sfn transformArg:string (transform:string op:string) {
        def at:int (indexOf transform op)
        if (at < 0) {
            return ""
        }
        def open:int (indexOfFrom transform "(" at)
        if (open < 0) {
            return ""
        }
        def close:int (indexOfFrom transform ")" open)
        if (close < 0) {
            return ""
        }
        return (substring transform (open + 1) close)
    }

    sfn splitSpaces:void (s:string out:[string]) {
        def start:int 0
        def i:int 0
        def len:int (strlen s)
        while (i <= len) {
            def atEnd:boolean (i == len)
            def isSpace:boolean false
            if (atEnd == false) {
                def c:int (charAt s i)
                if ((c == 32) || (c == 9) || (c == 10) || (c == 13) || (c == 44)) {
                    isSpace = true
                }
            }
            if (atEnd || isSpace) {
                if (i > start) {
                    push out (substring s start i)
                }
                start = (i + 1)
            }
            i = (i + 1)
        }
    }

    ; A line states two points rather than a box, and a box of zero height is
    ; a line nobody can see. This turns the pair into the bounding box the
    ; painter wants and keeps the direction in the rotation.
    sfn readLineEnds:void (shape:OdpShape node:XmlNode) {
        def x1:double (OdpUnits.toPt((node.attr("svg:x1"))))
        def y1:double (OdpUnits.toPt((node.attr("svg:y1"))))
        def x2:double (OdpUnits.toPt((node.attr("svg:x2"))))
        def y2:double (OdpUnits.toPt((node.attr("svg:y2"))))
        if (((x1 == 0.0) && (y1 == 0.0)) && ((x2 == 0.0) && (y2 == 0.0))) {
            return
        }
        def left:double x1
        if (x2 < left) {
            left = x2
        }
        def top:double y1
        if (y2 < top) {
            top = y2
        }
        def right:double x1
        if (x2 > right) {
            right = x2
        }
        def bottom:double y1
        if (y2 > bottom) {
            bottom = y2
        }
        shape.x = left
        shape.y = top
        shape.width = (right - left)
        shape.height = (bottom - top)
    }

    ; A group states its own box in a coordinate system of its own, and this
    ; reader does not implement that mapping yet. Taking the union of the
    ; children's boxes gives a group whose children are where the file says
    ; they are, which is the part that matters on screen.
    sfn growToChildren:void (shape:OdpShape) {
        if ((array_length shape.children) == 0) {
            return
        }
        def first:OdpShape (itemAt shape.children 0)
        def left:double first.x
        def top:double first.y
        def right:double (first.x + first.width)
        def bottom:double (first.y + first.height)
        def i:int 1
        while (i < (array_length shape.children)) {
            def c:OdpShape (itemAt shape.children i)
            if (c.x < left) {
                left = c.x
            }
            if (c.y < top) {
                top = c.y
            }
            if ((c.x + c.width) > right) {
                right = (c.x + c.width)
            }
            if ((c.y + c.height) > bottom) {
                bottom = (c.y + c.height)
            }
            i = (i + 1)
        }
        shape.x = left
        shape.y = top
        shape.width = (right - left)
        shape.height = (bottom - top)
    }

    ; ------------------------------------------------------------------
    ; Text
    ; ------------------------------------------------------------------

    ; A `draw:frame` puts its text in a `draw:text-box`; a `draw:custom-shape`
    ; holds the paragraphs directly. Two spellings of one thing, and a reader
    ; that knows only the first draws a converted deck with no text on it at
    ; all — every shape in a LibreOffice conversion is a custom-shape.
    fn readText:void (shape:OdpShape node:XmlNode styleFamily:string styleName:string) {
        def holder:XmlNode node
        def box@(optional):XmlNode (node.firstChild("draw:text-box"))
        if (!null? box) {
            holder = (unwrap box)
        }
        def paras:[XmlNode] (holder.childrenNamed("text:p"))
        def i:int 0
        while (i < (array_length paras)) {
            def para:OdpParagraph (this.readParagraph((itemAt paras i) styleFamily styleName))
            push shape.paragraphs para
            i = (i + 1)
        }
        ; A list is paragraphs with an indent. Reading only `text:p` loses
        ; every bulleted body on every slide that has one.
        def lists:[XmlNode] (holder.childrenNamed("text:list"))
        def li:int 0
        while (li < (array_length lists)) {
            this.readList(shape (itemAt lists li) styleFamily styleName 0)
            li = (li + 1)
        }
    }

    fn readList:void (shape:OdpShape node:XmlNode styleFamily:string styleName:string level:int) {
        def items:[XmlNode] (node.childrenNamed("text:list-item"))
        def i:int 0
        while (i < (array_length items)) {
            def item:XmlNode (itemAt items i)
            def paras:[XmlNode] (item.childrenNamed("text:p"))
            def j:int 0
            while (j < (array_length paras)) {
                def para:OdpParagraph (this.readParagraph((itemAt paras j) styleFamily styleName))
                para.indentLevel = level
                para.bulletChar = "•"
                push shape.paragraphs para
                j = (j + 1)
            }
            def nested:[XmlNode] (item.childrenNamed("text:list"))
            def k:int 0
            while (k < (array_length nested)) {
                this.readList(shape (itemAt nested k) styleFamily styleName (level + 1))
                k = (k + 1)
            }
            i = (i + 1)
        }
    }

    fn readParagraph:OdpParagraph (node:XmlNode styleFamily:string styleName:string) {
        def para (new OdpParagraph())
        def paraStyle:string (node.attr("text:style-name"))
        def props:OdpGraphicProps (styles.resolveGraphic("paragraph" paraStyle))
        para.align = props.align
        para.style = (styles.resolveText(styleFamily styleName paraStyle ""))
        this.readInline(para node styleFamily styleName paraStyle "")
        return para
    }

    ; The inline content of a paragraph, flattened into runs. ODF nests spans;
    ; a nested span inherits the outer one's style, which is what passing the
    ; outer name down carries.
    fn readInline:void (para:OdpParagraph node:XmlNode styleFamily:string styleName:string paraStyle:string runStyle:string) {
        def i:int 0
        while (i < (array_length node.children)) {
            def child:XmlNode (itemAt node.children i)
            if child.isText {
                OdpParser.pushRun(para child.text (styles.resolveText(styleFamily styleName paraStyle runStyle)))
            } {
                def n:string child.name
                if (n == "text:span") {
                    def inner:string (child.attr("text:style-name"))
                    def effective:string runStyle
                    if ((strlen inner) > 0) {
                        effective = inner
                    }
                    this.readInline(para child styleFamily styleName paraStyle effective)
                }
                if (n == "text:a") {
                    this.readInline(para child styleFamily styleName paraStyle runStyle)
                }
                if (n == "text:line-break") {
                    OdpParser.pushRun(para "\n" (styles.resolveText(styleFamily styleName paraStyle runStyle)))
                }
                if (n == "text:tab") {
                    OdpParser.pushRun(para "\t" (styles.resolveText(styleFamily styleName paraStyle runStyle)))
                }
                ; `<text:s text:c="4"/>` is four spaces. ODF collapses runs of
                ; spaces in the markup and states the count here instead, so a
                ; reader that skips this element draws single-spaced text where
                ; the author aligned something by hand.
                if (n == "text:s") {
                    def count:int 1
                    def c:string (child.attr("text:c"))
                    if ((strlen c) > 0) {
                        def parsed@(optional):int (str2int c)
                        count = (?? parsed 1)
                    }
                    def spaces:string ""
                    def k:int 0
                    while (k < count) {
                        spaces = (spaces + " ")
                        k = (k + 1)
                    }
                    OdpParser.pushRun(para spaces (styles.resolveText(styleFamily styleName paraStyle runStyle)))
                }
            }
            i = (i + 1)
        }
    }

    sfn pushRun:void (para:OdpParagraph text:string style:OfficeTextStyle) {
        if ((strlen text) == 0) {
            return
        }
        def run (new OdpRun())
        run.text = text
        run.style = style
        push para.runs run
    }
}

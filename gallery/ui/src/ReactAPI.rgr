; =============================================================================
; ReactAPI — createElement / Fragment / isValidElement (React-shaped)
; =============================================================================
; Signature intent matches React.createElement(type, props, ...children):
;
;   ReactAPI.createElement("div", props, child0, child1, …)
;   ReactAPI.createElement("Text", props, "hello")
;   ReactAPI.Fragment(children)
;
; Children may be RgElement or plain strings (promoted to text nodes).
; Named function components register via ComponentRegistry and are created
; with kind=component so the renderer can expand them.
; =============================================================================

Import "RgElement.rgr"

; A function component: (props, children) → RgElement
; Implemented as a class so Ranger can store instances in a registry.
class RgComponent {
    def name:string ""

    Constructor () {
    }

    fn render:RgElement (props:RgProps children:[RgElement]) {
        return (RgElement.fragment(children))
    }
}

class ComponentRegistry {
    def names:[string]
    def comps:[RgComponent]

    Constructor () {
        def n:[string]
        names = n
        def c:[RgComponent]
        comps = c
    }

    fn register:void (comp:RgComponent) {
        def i:int 0
        while (i < (array_length names)) {
            if ((itemAt names i) == comp.name) {
                set comps i comp
                return
            }
            i = (i + 1)
        }
        push names comp.name
        push comps comp
    }

    fn has:boolean (name:string) {
        def i:int 0
        while (i < (array_length names)) {
            if ((itemAt names i) == name) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn get@(optional):RgComponent (name:string) {
        def i:int 0
        while (i < (array_length names)) {
            if ((itemAt names i) == name) {
                def hit@(optional):RgComponent (itemAt comps i)
                return hit
            }
            i = (i + 1)
        }
        def miss@(optional):RgComponent
        return miss
    }
}

class ReactAPI {
    def registry:ComponentRegistry
    ; Built-in host tag aliases (React / EVG / HTML)
    ; View→div, Text/Label→span, Image→img, Button→button

    Constructor () {
        registry = (new ComponentRegistry())
    }

    fn register:void (comp:RgComponent) {
        registry.register(comp)
    }

    fn isValidElement:boolean (el:RgElement) {
        if (el.typeName == "") {
            if (el.isText()) {
                return true
            }
            return false
        }
        return true
    }

    ; React.createElement(type, props | null, ...children)
    ; props may be empty. Extra string children become text nodes.
    fn createElement:RgElement (typeName:string props:RgProps children:[RgElement]) {
        def p:RgProps props
        if (typeName == "Fragment") {
            return (RgElement.fragment(children))
        }
        if (registry.has(typeName)) {
            return (RgElement.component(typeName p children))
        }
        def tag:string (this.mapHostTag(typeName))
        return (RgElement.host(tag p children))
    }

    ; Convenience: createElement with a single text child
    fn elText:RgElement (typeName:string props:RgProps text:string) {
        def kids:[RgElement]
        push kids (RgElement.textNode(text))
        return (this.createElement(typeName props kids))
    }

    ; Convenience: no children
    fn el:RgElement (typeName:string props:RgProps) {
        def kids:[RgElement]
        return (this.createElement(typeName props kids))
    }

    fn Fragment:RgElement (children:[RgElement]) {
        return (RgElement.fragment(children))
    }

    ; Promote a string to a text element (React does this for string children).
    fn asChild:RgElement (text:string) {
        return (RgElement.textNode(text))
    }

    fn mapHostTag:string (name:string) {
        if (name == "View") {
            return "div"
        }
        if (name == "div") {
            return "div"
        }
        if (name == "Text") {
            return "span"
        }
        if (name == "Label") {
            return "span"
        }
        if (name == "span") {
            return "span"
        }
        if (name == "Image") {
            return "img"
        }
        if (name == "img") {
            return "img"
        }
        if (name == "Button") {
            return "button"
        }
        if (name == "button") {
            return "button"
        }
        if (name == "row") {
            return "div"
        }
        if (name == "column") {
            return "div"
        }
        return name
    }

    ; Build props from parallel name/value arrays (ergonomic from Ranger).
    sfn props:RgProps (names:[string] values:[string]) {
        return (RgProps.fromPairs(names values))
    }

    sfn emptyProps:RgProps () {
        return (new RgProps())
    }
}

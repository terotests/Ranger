; =============================================================================
; Renderer — expand components, then hand a host tree to the EVG bridge
; =============================================================================

Import "RgElement.rgr"
Import "ReactAPI.rgr"
Import "Hooks.rgr"
Import "EVGBridge.rgr"
Import "../../evg/EVGElement.rgr"

class Renderer {
    def api:ReactAPI
    def hooks:HookDispatcher
    def bridge:EVGBridge
    def maxDepth:int 32

    Constructor () {
        api = (new ReactAPI())
        hooks = (new HookDispatcher())
        bridge = (new EVGBridge())
    }

    fn getAPI:ReactAPI () {
        return (unwrap api)
    }

    fn getHooks:HookDispatcher () {
        return (unwrap hooks)
    }

    ; Expand function components (kind=3) until only host/text/fragment remain.
    fn expand:RgElement (el:RgElement) {
        return (this.expandAt(el 0))
    }

    fn expandAt:RgElement (el:RgElement depth:int) {
        if (depth > maxDepth) {
            return (RgElement.textNode("[max component depth]"))
        }
        if (el.isText()) {
            return el
        }
        def elProps:RgProps (unwrap el.props)
        def elKids:[RgElement] el.children
        if (el.isComponent()) {
            def apiRef:ReactAPI (unwrap api)
            def maybe@(optional):RgComponent (apiRef.registry.get(el.typeName))
            if maybe {
                def comp:RgComponent (unwrap maybe)
                def rendered:RgElement (comp.render(elProps elKids))
                return (this.expandAt(rendered (depth + 1)))
            }
            ; Unknown component → host tag with the same name (escape hatch).
            def fallbackKids:[RgElement]
            def i:int 0
            while (i < (el.childCount())) {
                push fallbackKids (this.expandAt((el.childAt(i)) (depth + 1)))
                i = (i + 1)
            }
            return (RgElement.host(el.typeName elProps fallbackKids))
        }
        ; Host or fragment: expand children
        def outKids:[RgElement]
        def j:int 0
        while (j < (el.childCount())) {
            def child:RgElement (el.childAt(j))
            if (child.isFragment()) {
                def k:int 0
                while (k < (child.childCount())) {
                    push outKids (this.expandAt((child.childAt(k)) (depth + 1)))
                    k = (k + 1)
                }
            } {
                push outKids (this.expandAt(child (depth + 1)))
            }
            j = (j + 1)
        }
        if (el.isFragment()) {
            return (RgElement.fragment(outKids))
        }
        return (RgElement.host(el.typeName elProps outKids))
    }

    ; Full path: expand → EVGElement tree (not yet laid out).
    fn renderToEVG:EVGElement (el:RgElement) {
        def h:HookDispatcher (unwrap hooks)
        h.beginRender()
        return (this.expandToEVG(el))
    }

    ; Expand + bridge only — caller already ran hooks.beginRender() (interactive roots).
    fn expandToEVG:EVGElement (el:RgElement) {
        def expanded:RgElement (this.expand(el))
        def b:EVGBridge (unwrap bridge)
        return (b.toEVG(expanded))
    }

    fn beginRender:void () {
        def h:HookDispatcher (unwrap hooks)
        h.beginRender()
    }

    ; Re-render while hooks are dirty (simple loop; host drives frames).
    fn renderToEVGUntilStable:EVGElement (el:RgElement maxPasses:int) {
        def h:HookDispatcher (unwrap hooks)
        def pass:int 0
        def last:EVGElement (new EVGElement())
        while (pass < maxPasses) {
            last = (this.renderToEVG(el))
            if (h.isDirty() == false) {
                return last
            }
            pass = (pass + 1)
        }
        return last
    }
}

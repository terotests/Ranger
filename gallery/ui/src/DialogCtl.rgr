; =============================================================================
; DialogCtl — measured against @radix-ui/react-dialog
; =============================================================================
; Parity contract (see conformance/SPEC.md):
;   closed    only the trigger exists. Overlay, content, title and close are
;             not in the tree at all — Radix unmounts them, and a reader must
;             not find a dialog nobody opened.
;   open      trigger state "open" and STILL a tab stop; overlay no role;
;             content role dialog and modal; the close button takes focus.
;   Escape    closes, and focus returns to the trigger.
;
; This is the first control that owns more than its own subtree: while it is
; open, everything outside it is hidden from the accessibility tree. That part
; is the host's job — a controller cannot know what else is on the page — so it
; only raises `modal` and UiHost masks the rest.
; =============================================================================

Import "UiCtl.rgr"
Import "UiTree.rgr"
Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGA11yTree.rgr"

class DialogCtl extends UiCtl {
    def open:boolean false
    def title:string ""
    def closeLabel:string "Close"
    def triggerEl:EVGElement
    def overlayEl:EVGElement
    def contentEl:EVGElement
    def titleEl:EVGElement
    def closeEl:EVGElement

    Constructor () {
        rootEl = (EVGElement.createDiv())
        triggerEl = (EVGElement.createDiv())
        overlayEl = (EVGElement.createDiv())
        contentEl = (EVGElement.createDiv())
        titleEl = (EVGElement.createDiv())
        closeEl = (EVGElement.createDiv())
    }

    fn triggerTid:string () {
        return (tid + "-trigger")
    }

    fn overlayTid:string () {
        return (tid + "-overlay")
    }

    fn contentTid:string () {
        return (tid + "-content")
    }

    fn titleTid:string () {
        return (tid + "-title")
    }

    fn closeTid:string () {
        return (tid + "-close")
    }

    fn stateWord:string () {
        if open {
            return "open"
        }
        return "closed"
    }

    fn build:void () {
        def word:string (this.stateWord())
        def root:EVGElement (unwrap rootEl)
        root.id = tid
        root.className = "ui-dialog"
        UiTree.clearChildren(root)

        def trig:EVGElement (unwrap triggerEl)
        trig.id = (this.triggerTid())
        trig.className = "ui-dialog-trigger"
        if disabled {
            UiTree.addClass(trig "ui-dialog-trigger-disabled")
        }
        UiTree.setState(trig "ui-dialog-trigger" word)
        UiTree.leafText(trig name)
        root.addChild(trig)

        if (open == false) {
            return
        }

        def overlay:EVGElement (unwrap overlayEl)
        overlay.id = (this.overlayTid())
        overlay.className = "ui-dialog-overlay"
        ; The dim behind the dialog is the page, not the card the dialog was
        ; declared in — and it is out of flow, so opening one no longer pushes
        ; the page down by the height of a backdrop.
        UiTree.backdrop(overlay)
        UiTree.setState(overlay "ui-dialog-overlay" word)
        UiTree.clearChildren(overlay)
        root.addChild(overlay)

        def content:EVGElement (unwrap contentEl)
        content.id = (this.contentTid())
        content.className = "ui-dialog-content"
        ; Centred on the page, which is what `center` means and why a modal
        ; needs no anchor: there is nothing it is "next to".
        UiTree.surface(content "center" "center")
        UiTree.setState(content "ui-dialog-content" word)
        UiTree.clearChildren(content)

        def titleNode:EVGElement (unwrap titleEl)
        titleNode.id = (this.titleTid())
        titleNode.className = "ui-dialog-title"
        UiTree.leafText(titleNode title)
        content.addChild(titleNode)

        def closeNode:EVGElement (unwrap closeEl)
        closeNode.id = (this.closeTid())
        closeNode.className = "ui-dialog-close"
        UiTree.leafText(closeNode closeLabel)
        content.addChild(closeNode)

        root.addChild(content)
    }

    ; Opening moves focus INTO the dialog and closing sends it back to the
    ; trigger; both are returned so the host can move focus without knowing
    ; anything about dialogs.
    fn openAndFocus:string () {
        open = true
        this.build()
        return (this.closeTid())
    }

    fn closeAndRestore:string () {
        open = false
        this.build()
        return (this.triggerTid())
    }

    fn activate:string (target:string) {
        if disabled {
            return ""
        }
        if (target == (this.triggerTid())) {
            if (open == false) {
                return (this.openAndFocus())
            }
            return ""
        }
        if (target == (this.closeTid())) {
            if open {
                return (this.closeAndRestore())
            }
        }
        return ""
    }

    ; Escape closes from anywhere inside, which is what makes a modal escapable
    ; without the pointer.
    fn keyDown:string (target:string key:string) {
        if disabled {
            return ""
        }
        if (key == "Escape") {
            if open {
                return (this.closeAndRestore())
            }
            return ""
        }
        if ((UiCtl.activatesOn(key)) == false) {
            return ""
        }
        if (target == (this.triggerTid())) {
            if (open == false) {
                return (this.openAndFocus())
            }
            return ""
        }
        if (target == (this.closeTid())) {
            if open {
                return (this.closeAndRestore())
            }
        }
        return ""
    }

    fn tids:[string] () {
        def a:[string]
        push a tid
        push a (this.triggerTid())
        push a (this.overlayTid())
        push a (this.contentTid())
        push a (this.titleTid())
        push a (this.closeTid())
        return a
    }

    fn isFocusable:boolean (target:string) {
        if disabled {
            return false
        }
        if (target == (this.triggerTid())) {
            return true
        }
        if (target == (this.closeTid())) {
            return open
        }
        return false
    }

    fn rows:[UiRow] () {
        def out:[UiRow]
        def word:string (this.stateWord())

        def trigRow:UiRow (UiRow.of((this.triggerTid()) (EVGA11yRole.button()) name))
        trigRow.state = word
        ; A trigger that opens a dialog says so, and says WHICH kind: Radix
        ; writes `aria-haspopup="dialog"` here rather than the "menu" a menu
        ; trigger gets. The two are different promises to a reader.
        trigRow.hasPopup = "dialog"
        trigRow.disabled = disabled
        ; Radix's trigger says whether the dialog it owns is showing.
        if open {
            trigRow.expanded = (EVGA11yTri.yes())
        } {
            trigRow.expanded = (EVGA11yTri.no())
        }
        if (disabled == false) {
            trigRow.tabStop = true
            trigRow.focusable = true
        }
        push out trigRow

        if (open == false) {
            return out
        }

        def overlayRow:UiRow (UiRow.of((this.overlayTid()) (EVGA11yRole.none()) ""))
        overlayRow.state = word
        push out overlayRow

        def contentRow:UiRow (UiRow.of((this.contentTid()) (EVGA11yRole.dialog()) ""))
        contentRow.state = word
        contentRow.modal = true
        push out contentRow

        def titleRow:UiRow (UiRow.of((this.titleTid()) (EVGA11yRole.none()) ""))
        titleRow.parentTid = (this.contentTid())
        push out titleRow

        def closeRow:UiRow (UiRow.of((this.closeTid()) (EVGA11yRole.button()) closeLabel))
        closeRow.parentTid = (this.contentTid())
        closeRow.tabStop = true
        closeRow.focusable = true
        push out closeRow

        return out
    }
}

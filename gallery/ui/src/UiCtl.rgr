; =============================================================================
; UiCtl — the controller convention, and the row a controller reports
; =============================================================================
; A controller owns a subtree of the EVG display tree and mutates it in place
; when its state changes. It is not a component in the React sense: nothing
; re-renders it, nothing diffs it, and it keeps its state in its own fields.
; This is the same shape EVGWindow already uses (handle input, then emit
; accessibility nodes) — generalised so a conformance harness can drive it.
;
; `rows()` is the observable surface: one record per test id, in ARIA terms.
; The host fills in `focused` and `visible`, which it alone knows.
; =============================================================================

Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGA11yTree.rgr"
Import "UiTree.rgr"

; Tri-state, spelled as EVGA11yTri: 0 = not applicable, 1 = no, 2 = yes,
; 3 = mixed.
class UiRow {
    def tid:string ""
    ; The row this one hangs under, "" for a control the host parents to the
    ; page. The accessibility tree needs the shape, not just the list.
    def parentTid:string ""
    def role:int 0
    def name:string ""
    ; The `state-<value>` class, reported bare: "on", "off", "open", "closed".
    def state:string ""
    ; What a reader says INSTEAD of the role: "sortable" on a draggable row.
    ; Empty for almost everything, and that is the point — it is the whole
    ; affordance of the few controls that have one, and a reader that is told
    ; "button" learns nothing about being able to move the thing.
    def roleDescription:string ""
    def expanded:int 0
    ; `aria-sort` on a column header: 0 none, 1 ascending, 2 descending.
    ;
    ; Its own field for the same reason `valueNow` has one. Sorting a table
    ; changes which rows are where and NOTHING else about any node — every
    ; header keeps its name, its role and its position — so without this the
    ; one thing the control does is the one thing the trace cannot see. That is
    ; the slider's lesson, repeated.
    def sorted:int 0
    ; `aria-haspopup`, as the DOM spells it: "menu" on a row that opens one,
    ; "" on everything else. The one attribute that separates a submenu's
    ; parent from the item beside it — both are menuitems, both are named, and
    ; a chevron is not something a reader can see. Measured on Radix: the
    ; dropdown's own trigger carries it too, not only the nested rows.
    def hasPopup:string ""
    ; `aria-level` and `aria-setsize`, 0 for a row that has neither.
    ;
    ; Their own fields for the reason `sorted` has one: a tree is a flat list
    ; of identical roles as far as every other field can see, and depth is the
    ; ONLY thing that makes one row a child of another. `posinset` is derived
    ; from the row order and says where among its siblings a row sits; these
    ; two cannot be derived, because the flat list does not know where a level
    ; ends.
    def level:int 0
    def setSize:int 0
    ; `aria-posinset`, the attribute. Not `posinset`, which the host derives
    ; from the row order — for a flat tree the two disagree by design, because
    ; one counts visible rows and the other counts siblings.
    def setPos:int 0
    def pressed:int 0
    def checked:int 0
    def selected:int 0
    def disabled:boolean false
    ; Does this node make everything outside it unreachable? Not compared with
    ; the DOM — Radix masks with aria-hidden rather than aria-modal — but the
    ; EVG mirror needs it to do the masking, and the host needs it to mark the
    ; rest hidden.
    def modal:boolean false
    ; Decoration, kept out of the accessibility tree the way `aria-hidden`
    ; keeps a glyph out of the name of the button around it.
    def hidden:boolean false
    ; Would Tab land here? A composite with roving focus keeps exactly one of
    ; its items true, which is the whole observable difference between roving
    ; focus and a row of ordinary buttons.
    def tabStop:boolean false
    ; CAN focus reach it at all? Every enabled radio item is focusable; only
    ; one of them is a tab stop. A screen reader cares about the first, Tab
    ; about the second, and conflating them loses the arrow-key surface.
    def focusable:boolean false
    ; A number a reader announces: where a slider sits, how far a progress bar
    ; has got. Ranger has no null, so the flags say "this row has one" — and
    ; the difference matters, because an indeterminate progress bar reports a
    ; range with no position in it, which is exactly how a reader knows to say
    ; "busy" instead of "40 percent".
    def hasValueNow:boolean false
    def valueNow:int 0
    def hasRange:boolean false
    def valueMin:int 0
    def valueMax:int 0

    Constructor () {
    }

    sfn of:UiRow (tid:string role:int name:string) {
        def r (new UiRow())
        r.tid = tid
        r.role = role
        r.name = name
        return r
    }
}

; One member of a composite (a radio item, a tab, an accordion section).
class UiItem {
    def value:string ""
    def name:string ""
    def body:string ""
    def disabled:boolean false
    def el:EVGElement
    def contentEl:EVGElement
    ; A row that is itself a menu. Empty for almost every item; when it is not,
    ; the item is a SUB-TRIGGER — a menuitem that opens `kids` beside it — and
    ; `contentEl` above is the surface they hang in. One list rather than a
    ; separate submenu class, so nesting is the same shape at every depth.
    def kids:[UiItem]

    Constructor () {
        el = (EVGElement.createDiv())
        contentEl = (EVGElement.createDiv())
        def empty:[UiItem]
        kids = empty
    }
}

class UiCtl {
    def tid:string ""
    def name:string ""
    def disabled:boolean false
    def rootEl:EVGElement

    Constructor () {
        rootEl = (EVGElement.createDiv())
    }

    ; Build (or rebuild) the owned subtree from current state.
    fn build:void () {
    }

    ; Pointer activation, or Enter/Space while focused.
    fn activate:string (target:string) {
        return ""
    }

    ; A click carrying the two modifiers a multi-select cares about.
    ;
    ; Defaults to the plain activation, so every control that does not have a
    ; selection ignores them — which is all of them but the tree. It is on the
    ; base class rather than reached through a cast because the HOST routes
    ; clicks and has no business knowing which controller is underneath.
    fn activateWith:string (target:string shift:boolean ctrl:boolean) {
        return (this.activate(target))
    }

    ; A key arrived while `target` held focus. Returns the test id that should
    ; hold focus afterwards, or "" to leave focus where it is — which is how a
    ; composite moves focus along with an arrow key without the host needing to
    ; know anything about arrows.
    fn keyDown:string (target:string key:string) {
        if (UiCtl.activatesOn(key)) {
            this.activate(target)
        }
        return ""
    }

    ; Test ids this controller answers for, outermost first.
    fn tids:[string] () {
        def a:[string]
        push a tid
        return a
    }

    ; Is `target` a focusable node of this controller?
    fn isFocusable:boolean (target:string) {
        return false
    }

    ; Focus landed on `target` — a composite records its roving tab stop here.
    fn onFocus:void (target:string) {
    }

    ; --- the pointer, without a button ---------------------------------------
    ; A tooltip and a hover card have no activation at all: the pointer arriving
    ; IS the input. Like activate(), these return the test id focus should land
    ; on, or "" to leave focus where it is.

    fn hover:string (target:string) {
        return ""
    }

    ; The pointer left everything this controller owns. No target, because the
    ; interesting case is the pointer going somewhere else entirely.
    fn unhover:string () {
        return ""
    }

    ; --- the clock -------------------------------------------------------------
    ; Almost nothing needs one. A submenu does: it opens 100ms after the pointer
    ; lands on its parent row, so that dragging down a menu does not flash every
    ; submenu on the way past. The host advances it, which makes the delay an
    ; exact number in a test rather than a race against a real timer.
    ;
    ; Returns the test id focus should land on, like activate() and hover().
    fn tickCtl:string (dtMs:double) {
        return ""
    }

    ; The secondary button. Only a context menu reads it.
    fn contextClick:string (target:string) {
        return ""
    }

    ; --- dragging -------------------------------------------------------------
    ; A slider's real input is the pointer, and a pointer drag is the one thing
    ; a controller cannot resolve on its own: the value under the cursor is a
    ; function of where the TRACK was laid out, and only the host knows that.
    ;
    ; So a controller names the element whose rectangle the drag is measured
    ; against, and the host hands back the position as a fraction of it. "" for
    ; a controller that does not drag, which is all of them but one.
    fn dragBoundsTid:string (target:string) {
        return ""
    }

    ; `frac` is 0 at the left edge of those bounds and 1 at the right, and is
    ; deliberately NOT clamped — dragging past the end is a real gesture, and
    ; what the control does with it is part of the contract.
    fn dragTo:string (frac:double) {
        return ""
    }

    ; --- dragging one thing onto another --------------------------------------
    ; The other kind of drag, and it needs no geometry at all: a sortable asks
    ; "which item is the pointer over", and that is a test id, not a fraction.
    ; The host resolves the id with the same hit test a click uses, so the two
    ; gestures agree about what is under the cursor by construction.

    ; Does this controller drag one thing ONTO another? A host with a real
    ; pointer has to know before the gesture starts, because a press that will
    ; become that kind of drag must not also be a click.
    fn dragsOnto:boolean () {
        return false
    }

    fn press:string (target:string) {
        return ""
    }

    fn dragOver:string (target:string) {
        return ""
    }

    ; --- dragging a thing AROUND ------------------------------------------------
    ; The third gesture, and neither of the two above is it. A slider asks for a
    ; fraction of a track; a sortable asks what it is over; a window asks how far
    ; the pointer has MOVED, in page pixels, because that is what it adds to its
    ; own position. Deltas rather than absolute coordinates so the controller
    ; never has to know where it was picked up.
    fn dragsFreely:boolean () {
        return false
    }

    fn dragBy:string (dx:double dy:double) {
        return ""
    }

    fn release:string () {
        return ""
    }

    ; What this controller last said out loud.
    ;
    ; A live region is not decoration for a drag: pressing an arrow key while
    ; holding an item changes NOTHING else a reader can observe — the item has
    ; not moved yet, and the displacement is a picture. Measured on the
    ; reference: an ArrowDown step whose entire observable effect is the
    ; sentence "Draggable item a was moved over droppable area b."
    fn said:string () {
        return ""
    }

    fn rows:[UiRow] () {
        def a:[UiRow]
        return a
    }

    ; Does this controller own `target`?
    fn owns:boolean (target:string) {
        def ids:[string] (this.tids())
        def i:int 0
        while (i < (array_length ids)) {
            if ((itemAt ids i) == target) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn activatesOn:boolean (key:string) {
        if (key == "Enter") {
            return true
        }
        if (key == " ") {
            return true
        }
        return false
    }

    sfn isNextKey:boolean (key:string) {
        if (key == "ArrowDown") {
            return true
        }
        if (key == "ArrowRight") {
            return true
        }
        return false
    }

    sfn isPrevKey:boolean (key:string) {
        if (key == "ArrowUp") {
            return true
        }
        if (key == "ArrowLeft") {
            return true
        }
        return false
    }

    ; Step through items, skipping disabled ones and wrapping at the ends.
    ; Returns the landing index, or `from` when nothing else can take focus.
    sfn stepIndex:int (items:[UiItem] from:int delta:int) {
        def n:int (array_length items)
        if (n == 0) {
            return from
        }
        def i:int from
        def tries:int 0
        while (tries < n) {
            i = (i + delta)
            if (i < 0) {
                i = (n - 1)
            }
            if (i >= n) {
                i = 0
            }
            def it:UiItem (itemAt items i)
            if (it.disabled == false) {
                return i
            }
            tries = (tries + 1)
        }
        return from
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; UiTree — class-first helpers over the retained EVG element tree
; =============================================================================
; EVG is a display list. Controllers own a subtree of EVGElement and mutate it
; in place; nothing here rebuilds a virtual tree or diffs one.
;
; Styling is class-first: a controller writes CLASS NAMES and lets an
; EVGStyleSheet decide what they look like. Inline attributes stay legal for
; the cases a sheet cannot express — they are written through `inline()`, which
; also calls markInline() so the cascade ranks them above every sheet rule,
; the same contract JSXToEVG and ComponentEngine already use.
;
; Interaction state travels as a `state-<value>` class. That is this system's
; spelling of Radix's `data-state="<value>"`: same role (a hook a theme can
; style and a test can read), spelled the way a class-first engine reads it.
; =============================================================================

Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGA11yTree.rgr"
Import "UiCtl.rgr"

class UiTree {

    Constructor () {
    }

    sfn splitWs:[string] (s:string) {
        def out:[string]
        def cur:string ""
        def i:int 0
        def len:int (strlen s)
        while (i < len) {
            def code:int (charAt s i)
            def isSpace:boolean false
            if (code == 32) {
                isSpace = true
            }
            if (code == 9) {
                isSpace = true
            }
            if (code == 10) {
                isSpace = true
            }
            if isSpace {
                if ((strlen cur) > 0) {
                    push out cur
                    cur = ""
                }
            } {
                cur = cur + (strfromcode code)
            }
            i = (i + 1)
        }
        if ((strlen cur) > 0) {
            push out cur
        }
        return out
    }

    sfn joinWs:string (parts:[string]) {
        def out:string ""
        def i:int 0
        while (i < (array_length parts)) {
            if (i > 0) {
                out = out + " "
            }
            out = out + (itemAt parts i)
            i = (i + 1)
        }
        return out
    }

    sfn beginsWith:boolean (s:string prefix:string) {
        def n:int (strlen prefix)
        if ((strlen s) < n) {
            return false
        }
        def head:string (substring s 0 n)
        return (head == prefix)
    }

    sfn hasClass:boolean (el:EVGElement name:string) {
        def parts:[string] (UiTree.splitWs(el.className))
        def i:int 0
        while (i < (array_length parts)) {
            if ((itemAt parts i) == name) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn addClass:void (el:EVGElement name:string) {
        if (UiTree.hasClass(el name)) {
            return
        }
        if ((strlen el.className) == 0) {
            el.className = name
            return
        }
        el.className = el.className + " " + name
    }

    sfn removeClass:void (el:EVGElement name:string) {
        def parts:[string] (UiTree.splitWs(el.className))
        def keep:[string]
        def i:int 0
        while (i < (array_length parts)) {
            def p:string (itemAt parts i)
            if (p != name) {
                push keep p
            }
            i = (i + 1)
        }
        el.className = (UiTree.joinWs(keep))
    }

    ; `state-<value>`, this system's spelling of Radix `data-state`, plus a
    ; component-scoped twin `<base>-state-<value>`.
    ;
    ; The twin exists because EVGStyleSheet matches ONE class token per
    ; selector — it has no `.ui-toggle.state-on`. Without a scoped class a
    ; theme could only write `.state-on`, which would mean "on" for every
    ; component in the tree at once. The bare `state-*` class stays because it
    ; is what the conformance trace reads.
    sfn setState:void (el:EVGElement base:string value:string) {
        def scopedPrefix:string (base + "-state-")
        def parts:[string] (UiTree.splitWs(el.className))
        def keep:[string]
        def i:int 0
        while (i < (array_length parts)) {
            def p:string (itemAt parts i)
            def drop:boolean false
            if (UiTree.beginsWith(p "state-")) {
                drop = true
            }
            if (UiTree.beginsWith(p scopedPrefix)) {
                drop = true
            }
            if (drop == false) {
                push keep p
            }
            i = (i + 1)
        }
        push keep ("state-" + value)
        push keep (scopedPrefix + value)
        el.className = (UiTree.joinWs(keep))
    }

    sfn stateOf:string (el:EVGElement) {
        def parts:[string] (UiTree.splitWs(el.className))
        def i:int 0
        while (i < (array_length parts)) {
            def p:string (itemAt parts i)
            if (UiTree.beginsWith(p "state-")) {
                return (substring p 6 (strlen p))
            }
            i = (i + 1)
        }
        return ""
    }

    ; An inline attribute: written AND marked, so the cascade puts it above
    ; every stylesheet rule. Never call setAttribute directly from a controller.
    sfn inline:void (el:EVGElement name:string value:string) {
        el.setAttribute(name value)
        el.markInline(name)
    }

    sfn clearChildren:void (el:EVGElement) {
        def empty:[EVGElement]
        el.children = empty
    }

    sfn div:EVGElement (id:string cls:string) {
        def el (EVGElement.createDiv())
        el.id = id
        el.className = cls
        return el
    }

    ; Put the text ON the control instead of in a child span.
    ;
    ; EVG shrink-wraps a TEXT leaf and gives a div the full width of its
    ; parent, so a control built as div+span fills the row whatever its label
    ; says — a strip of tabs then stacks vertically no matter what `direction`
    ; the sheet asks for. Every control whose whole content is its label is
    ; therefore a leaf.
    ; --- overlay surfaces -------------------------------------------------------
    ; A popover's panel, a menu's list, a tooltip's bubble: out of the page's
    ; flow, painted above it, anchored to the thing that opened it — and still
    ; the trigger's SIBLING in the tree, so focus, events, `hidden` and the
    ; accessibility walk all keep working exactly as they did.
    ;
    ; Two calls rather than a base class: a controller says which of its own
    ; elements is the anchor and which is the surface, and the layout engine
    ; does the rest. Nothing here knows what a popover is.

    sfn anchor:void (el:EVGElement) {
        el.isOverlayAnchor = true
    }

    sfn surface:void (el:EVGElement side:string align:string) {
        el.isOverlay = true
        el.overlaySide = side
        el.overlayAlign = align
    }

    ; The page-sized dim behind a modal. `cover` is a side like any other, and
    ; it is sized by the layout pass because a percentage would resolve against
    ; the parent — which for a dialog is whatever part of the page declared it.
    sfn backdrop:void (el:EVGElement) {
        el.isOverlay = true
        el.overlaySide = "cover"
    }

    sfn leafText:void (el:EVGElement text:string) {
        UiTree.clearChildren(el)
        el.textContent = text
        el.elementType = 1
    }

    sfn label:EVGElement (id:string cls:string text:string) {
        def el (EVGElement.createSpan())
        el.id = id
        el.className = cls
        el.textContent = text
        el.elementType = 1
        return el
    }

    ; --- a controller's meaning, written onto its elements ---------------------
    ; A controller says what its nodes MEAN through `rows()`, and UiHost builds
    ; the accessibility tree from those rows. A page that composes controllers
    ; into its own tree and walks THAT tree (`EVGA11yFromTree`, as every demo
    ; and every application does) sees none of it: the elements carry classes
    ; and no roles, so a combobox is a div and its options are divs. Realtrainer
    ; found this first and wrote `adopt` for itself; mfiles was about to write
    ; it again. So it lives here: after `build()`, copy each row onto the
    ; element with its id.
    ;
    ; `build` first, then this — a rebuild replaces the elements the last pass
    ; wrote to, which is why `dress()` does the two in order.

    sfn findById@(optional):EVGElement (el:EVGElement id:string) {
        if (el.id == id) {
            def hit@(optional):EVGElement el
            return hit
        }
        def i:int 0
        while (i < (array_length el.children)) {
            def c:EVGElement (itemAt el.children i)
            def found@(optional):EVGElement (UiTree.findById(c id))
            if found {
                return found
            }
            i = (i + 1)
        }
        def miss@(optional):EVGElement
        return miss
    }

    sfn adoptRows:void (root:EVGElement rows:[UiRow]) {
        def i:int 0
        while (i < (array_length rows)) {
            def row:UiRow (itemAt rows i)
            def found@(optional):EVGElement (UiTree.findById(root row.tid))
            if found {
                def el:EVGElement (unwrap found)
                if (row.role > 0) {
                    el.role = (EVGA11yRole.ariaName(row.role))
                }
                if ((strlen row.name) > 0) {
                    el.a11yLabel = row.name
                }
                el.a11yDescription = row.description
                el.a11yExpanded = row.expanded
                el.a11yChecked = row.checked
                el.a11ySelected = row.selected
                el.a11yPressed = row.pressed
                el.a11ySorted = row.sorted
                el.a11yDisabled = row.disabled
                el.a11yHidden = row.hidden
                el.a11yModal = row.modal
                el.a11yLevel = row.level
                el.a11ySetSize = row.setSize
                el.a11yPosInSet = row.setPos
                el.a11yOrientation = row.orientation
                el.a11yCurrent = row.current
                el.a11yRoleDescription = row.roleDescription
                el.a11yHasPopup = row.hasPopup
                el.a11yRequired = row.required
                el.a11yInvalid = row.invalid
                el.a11yReadOnly = row.readOnly
                el.a11yHasRange = row.hasRange
                el.a11yValueMin = row.valueMin
                el.a11yValueMax = row.valueMax
                el.a11yHasValue = row.hasValueNow
                el.a11yValueNow = row.valueNow
                if row.hasText {
                    el.a11yValue = row.text
                }
                if row.focusable {
                    el.a11yFocusable = true
                }
            }
            i = (i + 1)
        }
    }

    ; Build a controller's subtree and say what it means, in that order.
    sfn dress:void (ctl:UiCtl) {
        ctl.build()
        def root:EVGElement (unwrap ctl.rootEl)
        UiTree.adoptRows(root (ctl.rows()))
    }

    ; Is `id` reachable from `root`? The trace calls this "visible": a node the
    ; display tree no longer carries paints nothing and reaches no screen
    ; reader, which is what a closed Radix Content is too.
    sfn reachable:boolean (root:EVGElement id:string) {
        if (root.id == id) {
            return true
        }
        def i:int 0
        while (i < (array_length root.children)) {
            def c:EVGElement (itemAt root.children i)
            if (UiTree.reachable(c id)) {
                return true
            }
            i = (i + 1)
        }
        return false
    }
}

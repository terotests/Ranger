; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; ToastCtl — measured against @radix-ui/react-toast
; =============================================================================
; A toast is not summoned by the user, so the fixture supplies a button that
; raises it — the same shape the reference host uses, because a component with
; no trigger cannot be driven by a spec at all.
;
; A STACK. The first version of this file held one toast and one flag, and
; both applications that needed toasts — mfiles (four kinds, five-second
; expiry) and realtrainer (a per-toast four-second clock) — built their own
; list beside it. So the reference fixture became a list too, and the
; questions a list raises were measured (toast_stack, toast_escape_stack,
; toast_timer, toast_pause):
;
;   raising again  appends a second toast; the first stays, and they sit in
;                  the viewport in raise order, newest LAST in the DOM. Which
;                  end is visually on top is the stylesheet's business.
;   closing one    leaves the others exactly as they were; focus goes to the
;                  viewport, as it did with one.
;   Escape         takes ONE toast per press, newest first, from anywhere on
;                  the page.
;   a duration     closes a toast on its own, and moves focus nowhere.
;   the pointer    over the viewport holds EVERY toast's clock, not only the
;                  hovered one; leaving lets them run again from where they
;                  were. Focus inside the viewport holds them too.
;
; Parity contract for one toast (see conformance/SPEC.md), unchanged:
;   region    a named landmark wrapping the viewport. It is a separate element
;             from the list inside it, in the reference as well as here, and it
;             is how a reader finds a message that arrived unannounced.
;   viewport  the list. No role, no name, not a tab stop — but it is where
;             focus goes when the toast it holds disappears.
;   closed    only the trigger, the region and the viewport exist.
;   open      a toast root has no role and IS a tab stop, so Tab reaches a
;             message that appeared without being asked for; title and
;             description have no role; the action and close buttons do.
;   raising   does NOT move focus. The trigger keeps it — a toast that stole
;             focus would interrupt whatever the user was doing, which is the
;             opposite of what a toast is for.
;   closing   moves focus to the VIEWPORT, not back to the trigger. Measured,
;             and it is what keeps a keyboard user in the region rather than
;             throwing them back across the page.
;
; `kind` is presentation — mfiles' info / success / warning / error — and
; travels as a class (`ui-toast-item-kind-<kind>`) for a theme to colour. The
; reference has no such thing, so no spec compares it.
;
; The clock is the HOST's (`tickCtl`), as it is for the submenu delay: a
; timer inside the controller would make every gate depend on how fast the
; machine running it happens to be. A spec without a duration measures no
; timer at all, and the reference is driven with an enormous one to match.
; =============================================================================

Import "UiCtl.rgr"
Import "UiTree.rgr"
Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGA11yTree.rgr"

class ToastItem {
    def id:int 0
    def title:string ""
    def body:string ""
    def kind:string ""
    ; Milliseconds left before it closes on its own; ignored when the
    ; controller's duration is 0.
    def remainingMs:double 0.0
    def el:EVGElement
    def titleEl:EVGElement
    def descEl:EVGElement
    def actionEl:EVGElement
    def closeEl:EVGElement

    Constructor () {
        el = (EVGElement.createDiv())
        titleEl = (EVGElement.createDiv())
        descEl = (EVGElement.createDiv())
        actionEl = (EVGElement.createDiv())
        closeEl = (EVGElement.createDiv())
    }
}

class ToastCtl extends UiCtl {
    ; What the trigger raises. A program raising its own toasts calls
    ; `raise()` with its own strings and ignores these.
    def title:string ""
    def bodyText:string ""
    def kind:string ""
    def actionLabel:string "Undo"
    def closeLabel:string "Close"
    ; Milliseconds a toast lives; 0 for ever.
    def duration:double 0.0
    def items:[ToastItem]
    def nextId:int 1
    ; The pointer is over the viewport, or focus is inside it: every clock
    ; stands still. Two flags because the two leave separately.
    def hovering:boolean false
    def focusInside:boolean false
    def triggerEl:EVGElement
    def regionEl:EVGElement
    def viewportEl:EVGElement

    Constructor () {
        rootEl = (EVGElement.createDiv())
        triggerEl = (EVGElement.createDiv())
        regionEl = (EVGElement.createDiv())
        viewportEl = (EVGElement.createDiv())
        def empty:[ToastItem]
        items = empty
    }

    ; --- ids ---------------------------------------------------------------------

    fn triggerTid:string () {
        return (tid + "-trigger")
    }

    fn regionTid:string () {
        return (tid + "-region")
    }

    fn viewportTid:string () {
        return (tid + "-viewport")
    }

    fn itemTid:string (id:int) {
        return ((tid + "-item-") + (to_string id))
    }

    fn titleTid:string (id:int) {
        return ((this.itemTid(id)) + "-title")
    }

    fn descTid:string (id:int) {
        return ((this.itemTid(id)) + "-description")
    }

    fn actionTid:string (id:int) {
        return ((this.itemTid(id)) + "-action")
    }

    fn closeTid:string (id:int) {
        return ((this.itemTid(id)) + "-close")
    }

    ; --- the list -------------------------------------------------------------

    fn count:int () {
        return (array_length items)
    }

    ; Is anything up? The old single-toast `open`, kept as a question.
    fn isOpen:boolean () {
        return ((array_length items) > 0)
    }

    fn indexOfId:int (id:int) {
        def i:int 0
        while (i < (array_length items)) {
            def it:ToastItem (itemAt items i)
            if (it.id == id) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; The toast a target belongs to — its root or any of its parts — or 0.
    fn idOf:int (target:string) {
        def i:int 0
        while (i < (array_length items)) {
            def it:ToastItem (itemAt items i)
            def base:string (this.itemTid(it.id))
            if (target == base) {
                return it.id
            }
            if ((target == (this.titleTid(it.id))) || (target == (this.descTid(it.id)))) {
                return it.id
            }
            if ((target == (this.actionTid(it.id))) || (target == (this.closeTid(it.id)))) {
                return it.id
            }
            i = (i + 1)
        }
        return 0
    }

    fn itemOf:ToastItem (id:int) {
        def i:int (this.indexOfId(id))
        if (i < 0) {
            return (new ToastItem())
        }
        return (itemAt items i)
    }

    ; Put a toast up. Returns its test id. Focus does not move — the caller
    ; keeps whatever it had — which is why this returns the id and not a
    ; focus target.
    fn raise:string (t:string body:string k:string) {
        def it (new ToastItem())
        it.id = nextId
        nextId = (nextId + 1)
        it.title = t
        it.body = body
        it.kind = k
        it.remainingMs = duration
        push items it
        this.build()
        return (this.itemTid(it.id))
    }

    ; Take one down. Returns the viewport's id, which is where focus goes
    ; when a button inside the toast was what did it.
    fn dismiss:string (id:int) {
        def i:int (this.indexOfId(id))
        if (i >= 0) {
            remove_index items i
        }
        this.build()
        return (this.viewportTid())
    }

    ; The newest one down — Escape's rule, measured.
    fn dismissNewest:void () {
        def n:int (array_length items)
        if (n == 0) {
            return
        }
        removeLast items
        this.build()
    }

    fn dismissAll:void () {
        def empty:[ToastItem]
        items = empty
        this.build()
    }

    ; --- the clock ---------------------------------------------------------------

    fn paused:boolean () {
        if hovering {
            return true
        }
        return focusInside
    }

    ; Time passing. Every open toast's clock runs unless the viewport is
    ; hovered or holds focus; one that reaches zero closes and moves focus
    ; nowhere. Returns "" always — a timed-out toast was not focused, because
    ; focus inside the viewport pauses it.
    fn tickCtl:string (dtMs:double) {
        if (duration <= 0.0) {
            return ""
        }
        if (this.paused()) {
            return ""
        }
        def keep:[ToastItem]
        def changed:boolean false
        def i:int 0
        while (i < (array_length items)) {
            def it:ToastItem (itemAt items i)
            it.remainingMs = (it.remainingMs - dtMs)
            if (it.remainingMs > 0.0) {
                push keep it
            } {
                changed = true
            }
            i = (i + 1)
        }
        if changed {
            items = keep
            this.build()
        }
        return ""
    }

    ; --- input ------------------------------------------------------------------

    fn activate:string (target:string) {
        if disabled {
            return ""
        }
        if (target == (this.triggerTid())) {
            def shown:string title
            if ((strlen shown) == 0) {
                shown = name
            }
            this.raise(shown bodyText kind)
            ; Focus stays on the trigger: raising a toast must not interrupt.
            return ""
        }
        def id:int (this.idOf(target))
        if (id == 0) {
            return ""
        }
        if (target == (this.closeTid(id))) {
            return (this.dismiss(id))
        }
        if (target == (this.actionTid(id))) {
            return (this.dismiss(id))
        }
        return ""
    }

    fn keyDown:string (target:string key:string) {
        if disabled {
            return ""
        }
        if (key == "Escape") {
            ; Escape dismisses from anywhere on the page — the reference binds
            ; it to the document, not to the toast — and leaves focus exactly
            ; where it was. ONE per press, the newest first: measured with two
            ; up. Only a button INSIDE the toast hands focus to the viewport,
            ; because that button is the thing that just vanished.
            this.dismissNewest()
            return ""
        }
        if ((UiCtl.activatesOn(key)) == false) {
            return ""
        }
        return (this.activate(target))
    }

    ; Anything of the viewport's under the pointer holds the clocks. The
    ; region is the viewport's wrapper and counts; the trigger does not.
    fn hover:string (target:string) {
        if (target == (this.triggerTid())) {
            hovering = false
            return ""
        }
        if ((target == (this.viewportTid())) || (target == (this.regionTid()))) {
            hovering = true
            return ""
        }
        if ((this.idOf(target)) > 0) {
            hovering = true
            return ""
        }
        hovering = false
        return ""
    }

    fn unhover:string () {
        hovering = false
        return ""
    }

    fn onFocus:void (target:string) {
        if (target == (this.triggerTid())) {
            focusInside = false
            return
        }
        if (target == (this.viewportTid())) {
            focusInside = true
            return
        }
        focusInside = ((this.idOf(target)) > 0)
    }

    fn onBlur:void (target:string) {
        focusInside = false
    }

    ; --- the tree ---------------------------------------------------------------

    fn build:void () {
        def root:EVGElement (unwrap rootEl)
        root.id = tid + "-root"
        root.className = "ui-toast"
        UiTree.clearChildren(root)

        def trig:EVGElement (unwrap triggerEl)
        trig.id = (this.triggerTid())
        trig.className = "ui-toast-trigger"
        if disabled {
            UiTree.addClass(trig "ui-toast-trigger-disabled")
        }
        UiTree.leafText(trig name)
        root.addChild(trig)

        def region:EVGElement (unwrap regionEl)
        region.id = (this.regionTid())
        region.className = "ui-toast-region"
        UiTree.clearChildren(region)

        def viewport:EVGElement (unwrap viewportEl)
        viewport.id = (this.viewportTid())
        viewport.className = "ui-toast-viewport"
        UiTree.clearChildren(viewport)
        region.addChild(viewport)
        root.addChild(region)

        def i:int 0
        while (i < (array_length items)) {
            def it:ToastItem (itemAt items i)
            def toast:EVGElement (unwrap it.el)
            toast.id = (this.itemTid(it.id))
            toast.className = "ui-toast-item"
            if ((strlen it.kind) > 0) {
                UiTree.addClass(toast ("ui-toast-item-kind-" + it.kind))
            }
            UiTree.setState(toast "ui-toast-item" "open")
            UiTree.clearChildren(toast)

            def ttl:EVGElement (unwrap it.titleEl)
            ttl.id = (this.titleTid(it.id))
            ttl.className = "ui-toast-title"
            UiTree.leafText(ttl it.title)
            toast.addChild(ttl)

            def desc:EVGElement (unwrap it.descEl)
            desc.id = (this.descTid(it.id))
            desc.className = "ui-toast-description"
            UiTree.leafText(desc it.body)
            toast.addChild(desc)

            def act:EVGElement (unwrap it.actionEl)
            act.id = (this.actionTid(it.id))
            act.className = "ui-toast-action"
            UiTree.leafText(act actionLabel)
            toast.addChild(act)

            def cls:EVGElement (unwrap it.closeEl)
            cls.id = (this.closeTid(it.id))
            cls.className = "ui-toast-close"
            UiTree.leafText(cls closeLabel)
            toast.addChild(cls)

            viewport.addChild(toast)
            i = (i + 1)
        }
    }

    fn tids:[string] () {
        def a:[string]
        push a tid
        push a (this.triggerTid())
        push a (this.regionTid())
        push a (this.viewportTid())
        def i:int 0
        while (i < (array_length items)) {
            def it:ToastItem (itemAt items i)
            push a (this.itemTid(it.id))
            push a (this.titleTid(it.id))
            push a (this.descTid(it.id))
            push a (this.actionTid(it.id))
            push a (this.closeTid(it.id))
            i = (i + 1)
        }
        return a
    }

    fn isFocusable:boolean (target:string) {
        if disabled {
            return false
        }
        if (target == (this.triggerTid())) {
            return true
        }
        if (target == (this.viewportTid())) {
            return true
        }
        def id:int (this.idOf(target))
        if (id == 0) {
            return false
        }
        if (target == (this.itemTid(id))) {
            return true
        }
        if (target == (this.actionTid(id))) {
            return true
        }
        if (target == (this.closeTid(id))) {
            return true
        }
        return false
    }

    fn rows:[UiRow] () {
        def out:[UiRow]

        def trigRow:UiRow (UiRow.of((this.triggerTid()) (EVGA11yRole.button()) name))
        trigRow.disabled = disabled
        if (disabled == false) {
            trigRow.tabStop = true
            trigRow.focusable = true
        }
        push out trigRow

        ; The landmark. Named, and NOT where focus lands — a reader navigating
        ; by region finds this, and everything a toast raises is inside it.
        def regionRow:UiRow (UiRow.of((this.regionTid()) (EVGA11yRole.region()) "Notifications"))
        push out regionRow

        ; The list. `focusable` is deliberately false even though UiHost can
        ; and does put focus here: this is a PARKING SPOT, where focus is left
        ; when the button holding it disappears, not something a user chose to
        ; go to. Saying otherwise in the accessibility tree would offer a
        ; reader an unnamed, empty node to activate — which is exactly what the
        ; structural lint objected to, and it was right.
        ; A LIST of toasts, and each toast a list item. Radix renders the
        ; viewport as an `<ol>`; this side said nothing, so a reader was told
        ; how many notifications were waiting by no one.
        def viewRow:UiRow (UiRow.of((this.viewportTid()) (EVGA11yRole.list()) ""))
        viewRow.parentTid = (this.regionTid())
        push out viewRow

        def i:int 0
        while (i < (array_length items)) {
            def it:ToastItem (itemAt items i)
            def toastRow:UiRow (UiRow.of((this.itemTid(it.id)) (EVGA11yRole.listItem()) ""))
            toastRow.parentTid = (this.viewportTid())
            toastRow.state = "open"
            toastRow.tabStop = true
            toastRow.focusable = true
            push out toastRow

            def titleRow:UiRow (UiRow.of((this.titleTid(it.id)) (EVGA11yRole.none()) ""))
            titleRow.parentTid = (this.itemTid(it.id))
            push out titleRow

            def descRow:UiRow (UiRow.of((this.descTid(it.id)) (EVGA11yRole.none()) ""))
            descRow.parentTid = (this.itemTid(it.id))
            push out descRow

            def actionRow:UiRow (UiRow.of((this.actionTid(it.id)) (EVGA11yRole.button()) actionLabel))
            actionRow.parentTid = (this.itemTid(it.id))
            actionRow.tabStop = true
            actionRow.focusable = true
            push out actionRow

            def closeRow:UiRow (UiRow.of((this.closeTid(it.id)) (EVGA11yRole.button()) closeLabel))
            closeRow.parentTid = (this.itemTid(it.id))
            closeRow.tabStop = true
            closeRow.focusable = true
            push out closeRow
            i = (i + 1)
        }
        return out
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; SliderCtl — measured against @radix-ui/react-slider
; =============================================================================
; The control that forced the trace to grow. Every field the harness compared
; before this one — role, name, state, expanded, checked, focused, visible —
; is IDENTICAL at every position of a slider, so the first captured oracle
; showed five steps of a slider being dragged from 0 to 100 with not one
; observable difference. `valuenow`, `valuemin` and `valuemax` exist because of
; that run; they are what a reader announces and the only thing that moves.
;
; Parity contract (see conformance/SPEC.md):
;   root      no role, but carries the label — the reference puts aria-label on
;             the root AND on the thumb, so both report the same name.
;   track     no role. range no role. Neither is focusable.
;   thumb     role slider, the tab stop, and where the value lives.
;   keys      Right/Up add a step, Left/Down subtract one, Home goes to the
;             minimum and End to the maximum. Clamped at both ends.
; =============================================================================

Import "UiCtl.rgr"
Import "UiTree.rgr"
Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGA11yTree.rgr"

class SliderCtl extends UiCtl {
    def value:int 50
    def minValue:int 0
    def maxValue:int 100
    def step:int 1
    def trackEl:EVGElement
    def rangeEl:EVGElement
    def thumbEl:EVGElement

    Constructor () {
        rootEl = (EVGElement.createDiv())
        trackEl = (EVGElement.createDiv())
        rangeEl = (EVGElement.createDiv())
        thumbEl = (EVGElement.createDiv())
    }

    fn trackTid:string () {
        return (tid + "-track")
    }

    fn rangeTid:string () {
        return (tid + "-range")
    }

    fn thumbTid:string () {
        return (tid + "-thumb")
    }

    ; Where the thumb sits, 0..100, for the width of the range and the offset
    ; of the thumb. Integer percent: EVG lays out in percentages and a slider
    ; that is one pixel out is not a parity failure.
    fn percent:int () {
        def span:int (maxValue - minValue)
        if (span <= 0) {
            return 0
        }
        def scaled:int ((value - minValue) * 100)
        return (idiv scaled span)
    }

    fn build:void () {
        def root:EVGElement (unwrap rootEl)
        root.id = tid
        root.className = "ui-slider"
        UiTree.clearChildren(root)

        def track:EVGElement (unwrap trackEl)
        track.id = (this.trackTid())
        track.className = "ui-slider-track"
        UiTree.clearChildren(track)

        def range:EVGElement (unwrap rangeEl)
        range.id = (this.rangeTid())
        range.className = "ui-slider-range"
        UiTree.clearChildren(range)
        UiTree.inline(range "width" ((to_string (this.percent())) + "%"))
        track.addChild(range)
        root.addChild(track)

        def thumb:EVGElement (unwrap thumbEl)
        thumb.id = (this.thumbTid())
        thumb.className = "ui-slider-thumb"
        if disabled {
            UiTree.addClass(thumb "ui-slider-thumb-disabled")
        }
        UiTree.clearChildren(thumb)
        ; Where the value IS, on the track. The sheet supplies the negative
        ; margin that centres it and the `top` that lifts it onto the rail; the
        ; controller only knows the position, which is the one thing the sheet
        ; cannot know.
        UiTree.inline(thumb "left" ((to_string (this.percent())) + "%"))
        root.addChild(thumb)
    }

    fn setValue:void (v:int) {
        def next:int v
        if (next < minValue) {
            next = minValue
        }
        if (next > maxValue) {
            next = maxValue
        }
        value = next
        this.build()
    }

    fn keyDown:string (target:string key:string) {
        if disabled {
            return ""
        }
        if (target != (this.thumbTid())) {
            return ""
        }
        if (key == "Home") {
            this.setValue(minValue)
            return ""
        }
        if (key == "End") {
            this.setValue(maxValue)
            return ""
        }
        ; NOT UiCtl.isNextKey/isPrevKey. Those two answer "later in the list"
        ; and "earlier in the list", where ArrowUp means earlier — right for a
        ; menu, wrong for a slider, where Up means MORE. Measured: the harness
        ; caught this on the first run, with the reference at 60 and this at 40.
        if (key == "ArrowRight") {
            this.setValue((value + step))
            return ""
        }
        if (key == "ArrowUp") {
            this.setValue((value + step))
            return ""
        }
        if (key == "ArrowLeft") {
            this.setValue((value - step))
            return ""
        }
        if (key == "ArrowDown") {
            this.setValue((value - step))
            return ""
        }
        return ""
    }

    ; --- the pointer ---------------------------------------------------------
    ; Pressing anywhere on the track jumps the value there and takes focus; a
    ; drag keeps moving it. Both measured against the reference, which needed
    ; a styled slider to measure at all — an unstyled track is 0x0 and there is
    ; nothing to press.

    fn dragBoundsTid:string (target:string) {
        if disabled {
            return ""
        }
        ; Whether the press landed on the rail or on the thumb, the geometry
        ; that decides the value is the TRACK's.
        if (target == (this.trackTid())) {
            return (this.trackTid())
        }
        if (target == (this.thumbTid())) {
            return (this.trackTid())
        }
        if (target == (this.rangeTid())) {
            return (this.trackTid())
        }
        return ""
    }

    ; Snap to the step grid, the way the reference does: a slider with step 10
    ; dragged to 83% of its track reports 80, not 83.
    fn valueAtFraction:int (frac:double) {
        def span:int (maxValue - minValue)
        def raw:double ((to_double minValue) + (frac * (to_double span)))
        if (step <= 0) {
            return (to_int raw)
        }
        def offset:double (raw - (to_double minValue))
        def steps:double (offset / (to_double step))
        ; Round, not truncate: `to_int` drops the fraction, which would snap a
        ; slider dragged to 89% of a 10-step range down to 80. Written out
        ; because a drag past the left end is genuinely negative here, and
        ; adding .5 to that rounds the wrong way.
        def rounded:int 0
        if (steps >= 0.0) {
            rounded = (to_int (steps + 0.5))
        } {
            rounded = (to_int (steps - 0.5))
        }
        return (minValue + (rounded * step))
    }

    fn dragTo:string (frac:double) {
        if disabled {
            return ""
        }
        this.setValue((this.valueAtFraction(frac)))
        ; A press on the rail focuses the thumb, not the rail.
        return (this.thumbTid())
    }

    fn tids:[string] () {
        def a:[string]
        push a tid
        push a (this.trackTid())
        push a (this.rangeTid())
        push a (this.thumbTid())
        return a
    }

    fn isFocusable:boolean (target:string) {
        if disabled {
            return false
        }
        return (target == (this.thumbTid()))
    }

    ; =========================================================================
    ; The ReUI presentation layer
    ; =========================================================================
    ; SPECIFIED from the source and screenshots the user supplied — reui.io is
    ; refused by the egress proxy, so this is the same footing the four shadcn
    ; components were on: a real source, not a guess.
    ;
    ; Everything above this line is MEASURED against @radix-ui/react-slider and
    ; is untouched. What follows is the layer ReUI draws on top, and it lives
    ; in the controller rather than in a demo for one reason: every one of
    ; these is a VALUE-TO-TEXT or VALUE-TO-POSITION function, which is exactly
    ; the kind of thing a gate can check and a picture cannot.
    ;
    ; AND ONE OF THEM IS AN ACCESSIBILITY FIX, not decoration. A rating slider
    ; whose thumb sits at 3 announces "3" to a reader, which is useless — the
    ; screen says "Okay" and the reader hears a bare number. `aria-valuetext`
    ; is what closes that, and the band labels below are what fill it. The same
    ; goes for "5 GB": the unit is on the screen and, without this, nowhere
    ; else.

    ; A suffix on the number: "%", " GB", " months". "" for a bare value.
    def unitSuffix:string ""
    ; Tick marks. `tickStep` is the spacing of the marks themselves and
    ; `skipInterval` is how many of them carry a NUMBER — from ReUI's source,
    ; where every tick draws a mark and `tick % skipInterval !== 0` draws it
    ; shorter and hides its label. Two different rules, and an implementation
    ; that keeps only one of them draws either a bare ruler or a crowded one.
    def tickStep:int 0
    def skipInterval:int 1
    ; Bands, for a slider whose value is a word: "Okay", "Great". Parallel
    ; arrays because a band is an upper bound and a label, and Ranger has no
    ; tuple. Held sorted by the caller's insertion order and read in order.
    def bandUpTo:[int]
    def bandLabel:[string]
    def bandEmoji:[string]

    fn addBand:void (upTo:int label:string emoji:string) {
        push bandUpTo upTo
        push bandLabel label
        push bandEmoji emoji
    }

    ; --- where things sit, as FRACTIONS ------------------------------------
    ;
    ; Fractions, not pixels — the demo multiplies. The same split the event
    ; calendar and the progress bar are under, and what lets one number serve
    ; a 200px track and a 900px one.

    fn fractionOf:double (v:int) {
        def span:int (maxValue - minValue)
        if (span <= 0) {
            return 0.0
        }
        def clamped:int v
        if (clamped < minValue) { clamped = minValue }
        if (clamped > maxValue) { clamped = maxValue }
        return ((to_double (clamped - minValue)) / (to_double span))
    }

    fn thumbFraction:double () {
        return (this.fractionOf(value))
    }

    ; --- ticks --------------------------------------------------------------

    fn tickCount:int () {
        if (tickStep <= 0) {
            return 0
        }
        ; Inclusive of both ends: a 0..12 range stepping by 1 has THIRTEEN
        ; ticks, not twelve. ReUI's own source is `length: max + 1`, and the
        ; off-by-one here is the difference between a ruler that ends on 12 and
        ; one that ends on 11.
        return ((idiv (maxValue - minValue) tickStep) + 1)
    }

    fn tickValue:int (i:int) {
        return (minValue + (i * tickStep))
    }

    ; A MAJOR tick carries a number and a full-height mark; a minor one is a
    ; short mark with its label hidden. From ReUI's source: the test is on the
    ; tick's INDEX, not on its value, so a range starting somewhere other than
    ; zero still labels its own first tick.
    fn tickIsMajor:boolean (i:int) {
        if (skipInterval <= 1) {
            return true
        }
        return ((i % skipInterval) == 0)
    }

    fn tickFraction:double (i:int) {
        return (this.fractionOf((this.tickValue(i))))
    }

    ; --- what the value READS as -------------------------------------------

    ; The number with its unit: "50%", "5 GB". This is what the tooltip bubble
    ; shows and what a reader is told.
    fn formatted:string () {
        return ((to_string value) + unitSuffix)
    }

    ; The band a value falls in, "" when the slider has none. The FIRST band
    ; whose upper bound the value has not passed — so a caller lists them low
    ; to high and the last one catches everything above it.
    fn bandFor:string (v:int) {
        def i:int 0
        while (i < (array_length bandUpTo)) {
            if (v <= (itemAt bandUpTo i)) {
                return (itemAt bandLabel i)
            }
            i = (i + 1)
        }
        if ((array_length bandLabel) > 0) {
            return (itemAt bandLabel ((array_length bandLabel) - 1))
        }
        return ""
    }

    fn emojiFor:string (v:int) {
        def i:int 0
        while (i < (array_length bandUpTo)) {
            if (v <= (itemAt bandUpTo i)) {
                return (itemAt bandEmoji i)
            }
            i = (i + 1)
        }
        if ((array_length bandEmoji) > 0) {
            return (itemAt bandEmoji ((array_length bandEmoji) - 1))
        }
        return ""
    }

    fn currentBand:string () {
        return (this.bandFor(value))
    }

    fn currentEmoji:string () {
        return (this.emojiFor(value))
    }

    ; `aria-valuetext`. The BAND when there is one, because "Okay" is what the
    ; screen says and a reader hearing "3" has been told nothing; the formatted
    ; number otherwise, so a unit is not lost; and "" when the value speaks for
    ; itself, which keeps the attribute absent rather than making it a
    ; duplicate of aria-valuenow.
    fn valueText:string () {
        if ((array_length bandLabel) > 0) {
            return (this.currentBand())
        }
        if ((strlen unitSuffix) > 0) {
            return (this.formatted())
        }
        return ""
    }

    fn rows:[UiRow] () {
        def out:[UiRow]

        ; No role, but named: the label is on the root as well as the thumb.
        def rootRow:UiRow (UiRow.of(tid (EVGA11yRole.none()) name))
        rootRow.disabled = disabled
        push out rootRow

        def trackRow:UiRow (UiRow.of((this.trackTid()) (EVGA11yRole.none()) ""))
        trackRow.parentTid = tid
        push out trackRow

        def rangeRow:UiRow (UiRow.of((this.rangeTid()) (EVGA11yRole.none()) ""))
        rangeRow.parentTid = (this.trackTid())
        push out rangeRow

        ; The thumb does NOT report itself disabled, even when the slider is:
        ; the reference marks only the root and takes the thumb out of the tab
        ; order. Measured, and left as measured — a slider role with no
        ; aria-disabled is arguable, but parity means matching the reference,
        ; and `ui:a11y` is where that argument gets settled if axe minds.
        def thumbRow:UiRow (UiRow.of((this.thumbTid()) (EVGA11yRole.slider()) name))
        thumbRow.parentTid = tid
        ; On the THUMB, which is the node with role="slider" — not on the
        ; track around it. Radix puts it where the value is.
        thumbRow.orientation = "horizontal"
        thumbRow.hasValueNow = true
        thumbRow.valueNow = value
        thumbRow.hasRange = true
        thumbRow.valueMin = minValue
        thumbRow.valueMax = maxValue
        ; What a reader hears INSTEAD of the number, when the number alone is
        ; not the answer. See `valueText` — this is the whole point of the
        ; band labels.
        thumbRow.valueText = (this.valueText())
        if (disabled == false) {
            thumbRow.tabStop = true
            thumbRow.focusable = true
        }
        push out thumbRow

        return out
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; UiHost — mounts controllers, routes input, and reports the behaviour trace
; =============================================================================
; The host owns three things a single controller cannot:
;
;   1. the root of the display tree (so "visible" means "reachable and laid out")
;   2. focus (so a click can move it, and a key can be routed by it)
;   3. the stylesheet (class-first: controllers write classes, the sheet
;      decides what they look like; inline attributes still outrank it)
;
; `traceJson()` is the conformance surface. It reports the same ARIA-shaped
; record the DOM adapter reads off Radix, so two systems that share no code can
; be compared on what a user can actually observe.
; =============================================================================

Import "UiTree.rgr"
Import "UiCtl.rgr"
Import "ToggleCtl.rgr"
Import "CollapsibleCtl.rgr"
Import "CheckboxCtl.rgr"
Import "RadioGroupCtl.rgr"
Import "TabsCtl.rgr"
Import "AccordionCtl.rgr"
Import "PresentationCtl.rgr"
Import "ToolbarCtl.rgr"
Import "DialogCtl.rgr"
Import "AlertDialogCtl.rgr"
Import "PopoverCtl.rgr"
Import "MenuCtl.rgr"
Import "HoverCtl.rgr"
Import "SliderCtl.rgr"
Import "ToastCtl.rgr"
Import "SortableCtl.rgr"
Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGUnit.rgr"
Import "../../evg/EVGLayout.rgr"
Import "../../evg/EVGDisplayList.rgr"
Import "../../evg/EVGStyleSheet.rgr"
Import "../../evg/EVGA11yTree.rgr"
Import "../../evg/EVGHitTest.rgr"

class UiHost {
    def root:EVGElement
    def ctls:[UiCtl]
    def sheet:EVGStyleSheet
    def theme:string ""
    def focusId:string ""
    ; The last laid-out page, kept so a pointer can be turned into a test id.
    def lastPage@(optional):EVGElement
    ; Bumped on every tree so the DOM mirror knows the frame changed — it skips
    ; an update whose generation it has already applied, which is what keeps a
    ; reader's cursor from being rebuilt out from under it.
    def a11yGen:int 0
    ; The page's live region: the last thing any controller said out loud.
    def announcement:string ""
    def pageWidth:double 480.0
    def pageHeight:double 320.0

    Constructor () {
        root = (EVGElement.createDiv())
        def r:EVGElement (unwrap root)
        r.id = "root"
        r.className = "ui-root"
        sheet = (new EVGStyleSheet())
        def empty:[UiCtl]
        ctls = empty
    }

    fn setPageSize:void (w:double h:double) {
        pageWidth = w
        pageHeight = h
    }

    fn setTheme:void (name:string) {
        theme = name
    }

    ; Class-first: the whole look of the tree arrives as CSS text.
    fn addStyleSheet:void (css:string) {
        def s:EVGStyleSheet (unwrap sheet)
        s.parse(css)
    }

    fn styleErrorCount:int () {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getErrorCount())
    }

    fn add:void (c:UiCtl) {
        push ctls c
        def r:EVGElement (unwrap root)
        def el:EVGElement (unwrap c.rootEl)
        r.addChild(el)
    }

    fn addToggle:ToggleCtl (tid:string name:string) {
        def c (new ToggleCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addCollapsible:CollapsibleCtl (tid:string name:string body:string) {
        def c (new CollapsibleCtl())
        c.tid = tid
        c.name = name
        c.triggerTid = (tid + "-trigger")
        c.contentTid = (tid + "-content")
        c.contentText = body
        c.build()
        this.add(c)
        return c
    }

    fn addCheckbox:CheckboxCtl (tid:string name:string) {
        def c (new CheckboxCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addSwitch:SwitchCtl (tid:string name:string) {
        def c (new SwitchCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addRadioGroup:RadioGroupCtl (tid:string name:string) {
        def c (new RadioGroupCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addTabs:TabsCtl (tid:string name:string) {
        def c (new TabsCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addAccordion:AccordionCtl (tid:string name:string) {
        def c (new AccordionCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addToolbar:ToolbarCtl (tid:string name:string) {
        def c (new ToolbarCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addDialog:DialogCtl (tid:string name:string title:string) {
        def c (new DialogCtl())
        c.tid = tid
        c.name = name
        c.title = title
        c.build()
        this.add(c)
        return c
    }

    fn addAlertDialog:AlertDialogCtl (tid:string name:string title:string) {
        def c (new AlertDialogCtl())
        c.tid = tid
        c.name = name
        c.title = title
        c.build()
        this.add(c)
        return c
    }

    fn addPopover:PopoverCtl (tid:string name:string) {
        def c (new PopoverCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addDropdownMenu:MenuCtl (tid:string name:string) {
        def c (new MenuCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addContextMenu:MenuCtl (tid:string name:string) {
        def c (new MenuCtl())
        c.tid = tid
        c.name = name
        c.contextMode = true
        c.build()
        this.add(c)
        return c
    }

    fn addTooltip:TooltipCtl (tid:string name:string) {
        def c (new TooltipCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addHoverCard:HoverCardCtl (tid:string name:string) {
        def c (new HoverCardCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addSlider:SliderCtl (tid:string name:string) {
        def c (new SliderCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addToast:ToastCtl (tid:string name:string) {
        def c (new ToastCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addSortable:SortableCtl (tid:string name:string) {
        def c (new SortableCtl())
        c.tid = tid
        c.name = name
        this.add(c)
        return c
    }

    fn addLabel:LabelCtl (tid:string name:string) {
        def c (new LabelCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addSeparator:SeparatorCtl (tid:string) {
        def c (new SeparatorCtl())
        c.tid = tid
        c.build()
        this.add(c)
        return c
    }

    fn addProgress:ProgressCtl (tid:string name:string) {
        def c (new ProgressCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addAspectRatio:AspectRatioCtl (tid:string name:string) {
        def c (new AspectRatioCtl())
        c.tid = tid
        c.name = name
        c.build()
        this.add(c)
        return c
    }

    fn addAccessibleIcon:AccessibleIconCtl (tid:string name:string glyph:string) {
        def c (new AccessibleIconCtl())
        c.tid = tid
        c.name = name
        c.glyph = glyph
        c.build()
        this.add(c)
        return c
    }

    fn addAvatar:AvatarCtl (tid:string name:string fallback:string) {
        def c (new AvatarCtl())
        c.tid = tid
        c.name = name
        c.fallback = fallback
        c.build()
        this.add(c)
        return c
    }

    fn ctlFor@(optional):UiCtl (target:string) {
        def i:int 0
        while (i < (array_length ctls)) {
            def c:UiCtl (itemAt ctls i)
            if (c.owns(target)) {
                def hit@(optional):UiCtl c
                return hit
            }
            i = (i + 1)
        }
        def miss@(optional):UiCtl
        return miss
    }

    ; A click on a focusable node focuses it and activates it. A click on a
    ; disabled node activates nothing AND takes focus away — which is what a
    ; browser does, and what the Radix oracle records.
    fn click:void (target:string) {
        def maybe@(optional):UiCtl (this.ctlFor(target))
        if maybe {
            def c:UiCtl (unwrap maybe)
            if (c.isFocusable(target)) {
                focusId = target
                c.onFocus(target)
                ; An activation may move focus itself — opening a dialog puts
                ; it on the close button, and the host should not have to know
                ; that a dialog is what happened.
                def next:string (c.activate(target))
                if ((strlen next) > 0) {
                    focusId = next
                }
                return
            }
        }
        focusId = ""
    }

    fn focus:void (target:string) {
        def maybe@(optional):UiCtl (this.ctlFor(target))
        if maybe {
            def c:UiCtl (unwrap maybe)
            if (c.isFocusable(target)) {
                focusId = target
                c.onFocus(target)
            }
        }
    }

    fn blur:void () {
        focusId = ""
    }

    ; The pointer arriving over a node, with no button pressed. A tooltip and a
    ; hover card have no other input, so without this there is nothing to test
    ; them with.
    fn hover:void (target:string) {
        def maybe@(optional):UiCtl (this.ctlFor(target))
        if maybe {
            def c:UiCtl (unwrap maybe)
            def next:string (c.hover(target))
            if ((strlen next) > 0) {
                focusId = next
            }
        }
    }

    ; The pointer left everything. Broadcast, because the controller that has to
    ; react is the one the pointer is no longer over — asking the new target
    ; would never reach it.
    fn unhover:void () {
        def i:int 0
        while (i < (array_length ctls)) {
            def c:UiCtl (itemAt ctls i)
            def next:string (c.unhover())
            if ((strlen next) > 0) {
                focusId = next
            }
            i = (i + 1)
        }
    }

    ; The secondary button. Only a context menu reads it, and it does not focus
    ; what it was pressed on — a context menu's trigger is not focusable.
    fn rightClick:void (target:string) {
        def maybe@(optional):UiCtl (this.ctlFor(target))
        if maybe {
            def c:UiCtl (unwrap maybe)
            def next:string (c.contextClick(target))
            if ((strlen next) > 0) {
                focusId = next
            }
        }
    }

    ; --- dragging -------------------------------------------------------------
    ; The pointer held down and moved. A slider is the reason this exists: its
    ; real input is a drag, and the value under the cursor depends on where the
    ; TRACK ended up, which is a fact about the laid-out tree and so the host's
    ; to answer. The controller names the element to measure against; the host
    ; turns a coordinate into a fraction of it.

    ; The controller currently being dragged, and the element its drag is
    ; measured against. Empty when no button is down.
    def dragTid:string ""
    def dragBounds:string ""

    ; x as a fraction of `boundsTid`'s laid-out width: 0 at its left edge, 1 at
    ; its right. NOT clamped — dragging past the end is a real gesture.
    fn fractionIn:double (boundsTid:string px:double) {
        def r:EVGElement (unwrap root)
        def maybe@(optional):EVGElement (this.findEl(r boundsTid))
        if maybe {
            def el:EVGElement (unwrap maybe)
            if (el.calculatedWidth > 0.0) {
                return ((px - el.calculatedX) / el.calculatedWidth)
            }
        }
        return 0.0
    }

    ; The laid-out rectangle of a test id, as "x,y,w,h", or "" if the display
    ; tree does not carry it. A canvas offers nothing to a query selector, so
    ; anything driving this host from outside — a browser test pressing an item
    ; — has to ask where the item IS.
    fn rectOf:string (target:string) {
        def r:EVGElement (unwrap root)
        def maybe@(optional):EVGElement (this.findEl(r target))
        if maybe {
            def el:EVGElement (unwrap maybe)
            return ((((((to_string (to_int el.calculatedX)) + ",") + (to_string (to_int el.calculatedY))) + ",") + (to_string (to_int el.calculatedWidth))) + ",") + (to_string (to_int el.calculatedHeight))
        }
        return ""
    }

    ; Which element's rectangle a press on `target` would be measured against,
    ; or "" if pressing it is not a drag. Anything driving this host from the
    ; outside — the conformance adapter, the browser playground — asks first, so
    ; both sides of a comparison measure the SAME rectangle. Pressing an 18px
    ; thumb and pressing a 200px rail are the same gesture on the same track,
    ; and a fraction of the thumb would mean nothing.
    fn dragBoundsFor:string (target:string) {
        def maybe@(optional):UiCtl (this.ctlFor(target))
        if maybe {
            def c:UiCtl (unwrap maybe)
            return (c.dragBoundsTid(target))
        }
        return ""
    }

    ; Press on `target` at `frac` across its drag bounds. Nothing here converts
    ; coordinates, so a caller that already has a fraction — from the DOM's own
    ; geometry, say — does not have to invent EVG pixels to express it.
    fn pressTid:void (target:string frac:double) {
        def bounds:string (this.dragBoundsFor(target))
        if ((strlen bounds) == 0) {
            this.click(target)
            return
        }
        dragTid = target
        dragBounds = bounds
        def maybe@(optional):UiCtl (this.ctlFor(target))
        if maybe {
            def c:UiCtl (unwrap maybe)
            def next:string (c.dragTo(frac))
            if ((strlen next) > 0) {
                focusId = next
                c.onFocus(next)
            }
        }
    }

    fn dragFraction:void (frac:double) {
        if ((strlen dragTid) == 0) {
            return
        }
        def maybe@(optional):UiCtl (this.ctlFor(dragTid))
        if maybe {
            def c:UiCtl (unwrap maybe)
            def next:string (c.dragTo(frac))
            if ((strlen next) > 0) {
                focusId = next
            }
        }
    }

    ; The coordinate entry points, for a host that has a real pointer: the
    ; canvas in the playground, and eventually an SDL or browser window.
    fn pressAt:string (px:double py:double) {
        def target:string (this.hitTest(px py))
        def bounds:string (this.dragBoundsFor(target))
        if ((strlen bounds) == 0) {
            this.click(target)
            return target
        }
        this.pressTid(target (this.fractionIn(bounds px)))
        return target
    }

    fn pointerMove:void (px:double py:double) {
        if ((strlen dragBounds) == 0) {
            return
        }
        this.dragFraction((this.fractionIn(dragBounds px)))
    }

    fn pointerUp:void () {
        dragTid = ""
        dragBounds = ""
    }

    ; Focus cannot survive the node it was on going away. A browser drops it to
    ; the document; so does this. Without it, closing a context menu with
    ; Escape would leave focus on a menu item that no longer exists.
    fn settleFocus:void () {
        if ((strlen focusId) == 0) {
            return
        }
        def maybe@(optional):UiCtl (this.ctlFor(focusId))
        if maybe {
            def c:UiCtl (unwrap maybe)
            if (c.isFocusable(focusId)) {
                return
            }
        }
        focusId = ""
    }

    ; Keys go to whatever holds focus, like every real host. A controller that
    ; moves focus itself (arrow keys in a composite) says so by returning the
    ; test id focus should land on.
    fn key:void (name:string) {
        if ((strlen focusId) == 0) {
            return
        }
        def maybe@(optional):UiCtl (this.ctlFor(focusId))
        if maybe {
            def c:UiCtl (unwrap maybe)
            def next:string (c.keyDown(focusId name))
            if ((strlen next) > 0) {
                focusId = next
            }
            this.remember(c)
        }
        this.settleFocus()
    }

    ; Style, then lay out. Inline attributes written through UiTree.inline()
    ; are marked, so this pass cannot overwrite them.
    fn layout:EVGElement () {
        def r:EVGElement (unwrap root)
        def s:EVGStyleSheet (unwrap sheet)
        s.setViewport(pageWidth pageHeight false)
        s.applyTree(r theme)
        def page (EVGElement.createDiv())
        page.id = "page"
        page.width = (EVGUnit.px(pageWidth))
        page.height = (EVGUnit.px(pageHeight))
        page.addChild(r)
        def lay (new EVGLayout())
        lay.setPageSize(pageWidth pageHeight)
        lay.layout(page)
        lastPage = page
        return page
    }

    ; --- pointer -------------------------------------------------------------
    ; A real host has coordinates, not test ids. Hit testing walks the laid-out
    ; display tree deepest-first and takes the LAST child before the first, so
    ; the innermost, latest-painted node wins — a button inside a clickable
    ; card dispatches to the button, the way a browser does.

    fn containsPoint:boolean (el:EVGElement px:double py:double) {
        if (px < el.calculatedX) {
            return false
        }
        if (py < el.calculatedY) {
            return false
        }
        def right:double (el.calculatedX + el.calculatedWidth)
        if (px >= right) {
            return false
        }
        def bottom:double (el.calculatedY + el.calculatedHeight)
        if (py >= bottom) {
            return false
        }
        return true
    }

    fn ownsTid:boolean (candidate:string) {
        if ((strlen candidate) == 0) {
            return false
        }
        def maybe@(optional):UiCtl (this.ctlFor(candidate))
        if maybe {
            return true
        }
        return false
    }

    ; The test id under the pointer, or "" for empty space.
    ;
    ; The scan is PAINT order, backwards — the same list `EVGDisplayList` draws
    ; and `EVGHitTest` builds, so what is clicked is what is seen. Walking the
    ; tree deepest-last-first is nearly the same answer and differs exactly
    ; where it matters: an open menu's panel is drawn above the trigger BESIDE
    ; it, and a tree walk reaches that trigger first. It would take the click
    ; through the panel.
    ;
    ; A modal's backdrop covers the page, so with this order it is what a click
    ; outside the dialog lands on — which is what makes a modal modal, rather
    ; than a thing that merely looks like one.
    fn hitTest:string (px:double py:double) {
        if lastPage {
            def page:EVGElement (unwrap lastPage)
            def hit (new EVGHitTest())
            def order:[EVGElement] (hit.paintOrder(page))
            def i:int ((array_length order) - 1)
            while (i >= 0) {
                def el:EVGElement (itemAt order i)
                ; A label that is not a test id falls through to the control
                ; that owns it, exactly as it did before.
                if (this.ownsTid(el.id)) {
                    if (this.containsPoint(el px py)) {
                        return el.id
                    }
                }
                i = (i - 1)
            }
        }
        return ""
    }

    ; Press at a point: same rules as click(), including the blur that follows
    ; a press on empty space or on a disabled control.
    fn pointerDown:string (px:double py:double) {
        def target:string (this.hitTest(px py))
        this.click(target)
        return target
    }

    ; The display list itself. A native host (SDL, the C++ painter) wants the
    ; commands, not a string it has to parse back.
    fn displayList:EVGDisplayList () {
        def page:EVGElement (this.layout())
        def engineLay (new EVGLayout())
        engineLay.setPageSize(pageWidth pageHeight)
        def dl (new EVGDisplayList())
        def te (engineLay.getTextEngine())
        dl.setTextEngine(te)
        dl.build(page)
        return dl
    }

    fn displayListJson:string () {
        def dl:EVGDisplayList (this.displayList())
        return (dl.toJson())
    }

    ; --- the conformance trace ------------------------------------------------

    ; 0 = not applicable → null, 1 = no, 2 = yes, 3 = mixed. `mixed` is a real
    ; ARIA value, not a third boolean, so it travels as a string.
    sfn triJson:string (v:int) {
        if (v == 1) {
            return "false"
        }
        if (v == 2) {
            return "true"
        }
        if (v == 3) {
            return "\"mixed\""
        }
        return "null"
    }

    ; A number a reader announces, or null when the row does not have one.
    ; "absent" is a real value here: an indeterminate progress bar reports a
    ; range and no position, and a reader says "busy" because of it.
    sfn numJson:string (has:boolean v:int) {
        if has {
            return (to_string v)
        }
        return "null"
    }

    sfn boolJson:string (v:boolean) {
        if v {
            return "true"
        }
        return "false"
    }

    fn allRows:[UiRow] () {
        def out:[UiRow]
        def i:int 0
        while (i < (array_length ctls)) {
            def c:UiCtl (itemAt ctls i)
            def rs:[UiRow] (c.rows())
            def j:int 0
            while (j < (array_length rs)) {
                push out (itemAt rs j)
                j = (j + 1)
            }
            i = (i + 1)
        }
        return out
    }

    ; --- the accessibility tree ----------------------------------------------
    ; The same tree `gallery/evg/gl/evg-a11y.js` mirrors into real DOM over the
    ; canvas, which is how a screen reader — and axe-core — sees an EVG frame at
    ; all. A node the display tree no longer carries is left OUT: hidden content
    ; is not in a browser's accessibility tree either, and putting it in would
    ; hand a reader a panel nobody can reach.

    ; The laid-out element with this id, if the display tree still carries it.
    ; An instance method rather than a static on UiTree: Ranger will not resolve
    ; a static that returns an optional and recurses into itself.
    fn findEl@(optional):EVGElement (el:EVGElement id:string) {
        if (el.id == id) {
            def hit@(optional):EVGElement el
            return hit
        }
        def i:int 0
        while (i < (array_length el.children)) {
            def c:EVGElement (itemAt el.children i)
            def got@(optional):EVGElement (this.findEl(c id))
            if got {
                return got
            }
            i = (i + 1)
        }
        def miss@(optional):EVGElement
        return miss
    }

    fn a11yTree:EVGA11yTree () {
        def page:EVGElement (this.layout())
        def r:EVGElement (unwrap root)
        def t (new EVGA11yTree())
        a11yGen = (a11yGen + 1)
        t.generation = a11yGen
        def rootNode:EVGA11yNode (t.node("root" "" (EVGA11yRole.group())))
        rootNode.name = "Ranger UI"
        def pw:int (to_int pageWidth)
        def ph:int (to_int pageHeight)
        t.place(rootNode 0 0 pw ph)

        def rows:[UiRow] (this.allRows())
        def i:int 0
        while (i < (array_length rows)) {
            def row:UiRow (itemAt rows i)
            def maybe@(optional):EVGElement (this.findEl(r row.tid))
            if maybe {
                def el:EVGElement (unwrap maybe)
                def parent:string "root"
                if ((strlen row.parentTid) > 0) {
                    parent = row.parentTid
                }
                def n:EVGA11yNode (t.node(row.tid parent row.role))
                ; Decoration carries no name. The reference puts aria-label on
                ; a div with no role, where a browser ignores it — so the TRACE
                ; reports it (the attribute is there) and the accessibility
                ; tree does not (nothing announces it). The structural lint
                ; caught the difference; copying it blindly would have handed a
                ; reader a named node with nothing to say about it.
                if (row.role != (EVGA11yRole.none())) {
                    n.name = row.name
                }
                n.roleDescription = row.roleDescription
                n.hasValueNow = row.hasValueNow
                n.valueNow = row.valueNow
                n.hasValueRange = row.hasRange
                n.valueMin = row.valueMin
                n.valueMax = row.valueMax
                n.disabled = row.disabled
                n.focusable = row.focusable
                n.modal = row.modal
                n.checked = row.checked
                n.expanded = row.expanded
                if (row.selected == 2) {
                    n.selected = true
                }
                if row.focusable {
                    n.actActivate = true
                }
                def x:int (to_int el.calculatedX)
                def y:int (to_int el.calculatedY)
                def w:int (to_int el.calculatedWidth)
                def h:int (to_int el.calculatedHeight)
                t.place(n x y w h)
            }
            i = (i + 1)
        }
        t.setFocus(focusId)
        return t
    }

    fn a11yJson:string () {
        def t:EVGA11yTree (this.a11yTree())
        return (t.toJson())
    }

    ; EVGA11yTree's own structural lint: duplicate ids, orphaned parents, a
    ; focusable node with no accessible name or no rectangle, a named node whose
    ; role is decoration. Runs without a browser, so CI gets it.
    fn a11yProblems:[string] () {
        def t:EVGA11yTree (this.a11yTree())
        return (t.lint())
    }

    ; Which row, if any, has taken the page over. "" when nothing is modal.
    fn modalTid:string () {
        def rows:[UiRow] (this.allRows())
        def i:int 0
        while (i < (array_length rows)) {
            def row:UiRow (itemAt rows i)
            if row.modal {
                return row.tid
            }
            i = (i + 1)
        }
        return ""
    }

    ; Is `target` the modal or inside it? Everything else is hidden while a
    ; modal is open — the aria-hidden masking Radix does, which is what a
    ; reader actually observes.
    fn insideModal:boolean (rows:[UiRow] target:string modal:string) {
        def at:string target
        def hops:int 0
        while (hops < 32) {
            if (at == modal) {
                return true
            }
            if ((strlen at) == 0) {
                return false
            }
            def found:boolean false
            def i:int 0
            while (i < (array_length rows)) {
                def row:UiRow (itemAt rows i)
                if (row.tid == at) {
                    at = row.parentTid
                    found = true
                    i = (array_length rows)
                }
                i = (i + 1)
            }
            if (found == false) {
                return false
            }
            hops = (hops + 1)
        }
        return false
    }

    ; JSON string, or null for the empty one. `aria-roledescription` is absent
    ; rather than "" on the DOM side, and an empty string would compare unequal
    ; to null on every node in every spec.
    sfn textOrNull:string (value:string) {
        if ((strlen value) == 0) {
            return "null"
        }
        return (EVGA11yTree.jsonString(value))
    }

    ; 1-based index among the rows that share this one's parent, counting in
    ; the order the rows are emitted — which is display-tree order, the same
    ; order the DOM side reads off the document.
    fn posInSet:int (rows:[UiRow] index:int) {
        def me:UiRow (itemAt rows index)
        def n:int 0
        def i:int 0
        while (i <= index) {
            def other:UiRow (itemAt rows i)
            if (other.parentTid == me.parentTid) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; --- dragging one thing onto another ---------------------------------------
    ; The host does the same thing for both ends of the gesture as it does for a
    ; click: turn a target into a controller. What is under the cursor is the
    ; paint-order hit test, so a drag and a click can never disagree about it.

    ; Will pressing here start a drag onto something else? The playground asks
    ; before it decides whether a press is a click.
    fn dragsOntoFor:boolean (target:string) {
        def maybe@(optional):UiCtl (this.ctlFor(target))
        if maybe {
            def c:UiCtl (unwrap maybe)
            return (c.dragsOnto())
        }
        return false
    }

    fn pressOn:void (target:string) {
        def maybe@(optional):UiCtl (this.ctlFor(target))
        if maybe {
            def c:UiCtl (unwrap maybe)
            def next:string (c.press(target))
            if ((strlen next) > 0) {
                focusId = next
            }
            this.remember(c)
        }
        this.settleFocus()
    }

    fn dragOnto:void (target:string) {
        def maybe@(optional):UiCtl (this.ctlFor(target))
        if maybe {
            def c:UiCtl (unwrap maybe)
            c.dragOver(target)
            this.remember(c)
        }
        this.settleFocus()
    }

    fn releaseDrag:void () {
        def i:int 0
        while (i < (array_length ctls)) {
            def c:UiCtl (itemAt ctls i)
            c.release()
            this.remember(c)
            i = (i + 1)
        }
        this.settleFocus()
    }

    ; The page has ONE live region, so the host owns the last thing said. It is
    ; kept rather than recomputed because that is what a live region does: the
    ; text stays until something replaces it, and a reader that arrives late
    ; still finds it.
    fn remember:void (c:UiCtl) {
        def text:string (c.said())
        if ((strlen text) > 0) {
            announcement = text
        }
    }

    fn announcementText:string () {
        return announcement
    }

    fn traceJson:string () {
        def r:EVGElement (unwrap root)
        def rows:[UiRow] (this.allRows())
        def modal:string (this.modalTid())
        def out:string "{\"nodes\":["
        def i:int 0
        while (i < (array_length rows)) {
            def row:UiRow (itemAt rows i)
            if (i > 0) {
                out = out + ","
            }
            def roleName:string (EVGA11yRole.ariaName(row.role))
            def isFocused:boolean false
            if (row.tid == focusId) {
                isFocused = true
            }
            def isVisible:boolean (UiTree.reachable(r row.tid))
            def isHidden:boolean row.hidden
            if ((strlen modal) > 0) {
                if ((this.insideModal(rows row.tid modal)) == false) {
                    isHidden = true
                }
            }
            out = out + "{\"tid\":" + (EVGA11yTree.jsonString(row.tid))
            out = out + ",\"role\":" + (EVGA11yTree.jsonString(roleName))
            out = out + ",\"name\":" + (EVGA11yTree.jsonString(row.name))
            out = out + ",\"state\":" + (EVGA11yTree.jsonString(row.state))
            out = out + ",\"expanded\":" + (UiHost.triJson(row.expanded))
            out = out + ",\"pressed\":" + (UiHost.triJson(row.pressed))
            out = out + ",\"checked\":" + (UiHost.triJson(row.checked))
            out = out + ",\"selected\":" + (UiHost.triJson(row.selected))
            out = out + ",\"disabled\":" + (UiHost.boolJson(row.disabled))
            out = out + ",\"hidden\":" + (UiHost.boolJson(isHidden))
            out = out + ",\"tabstop\":" + (UiHost.boolJson(row.tabStop))
            out = out + ",\"valuenow\":" + (UiHost.numJson(row.hasValueNow row.valueNow))
            out = out + ",\"valuemin\":" + (UiHost.numJson(row.hasRange row.valueMin))
            out = out + ",\"valuemax\":" + (UiHost.numJson(row.hasRange row.valueMax))
            out = out + ",\"focused\":" + (UiHost.boolJson(isFocused))
            out = out + ",\"visible\":" + (UiHost.boolJson(isVisible))
            out = out + ",\"roledescription\":" + (UiHost.textOrNull(row.roleDescription))
            ; Reported, not compared: the two systems disagree about the parent
            ; of a floating surface on purpose. It is here so `posinset` can be
            ; skipped where they do — see conformance/diff.mjs.
            out = out + ",\"parent\":" + (EVGA11yTree.jsonString(row.parentTid))
            ; Where this row sits among its siblings, 1-based. Derived from the
            ; order the rows come in, not stored: position is a fact about the
            ; tree, and a stored copy is a second truth to keep in step.
            out = out + ",\"posinset\":" + (to_string (this.posInSet(rows i)))
            out = out + "}"
            i = (i + 1)
        }
        return (out + "]}")
    }
}

; Entry point for -nodemodule builds; the adapter drives the classes above.
class UiHostModule {
    sfn main:void () {
        print "gallery/ui host module"
    }
}

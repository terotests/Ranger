; =============================================================================
; Hooks — minimal React-shaped useState / useReducer
; =============================================================================
; Not a Fiber reconciler. One HookDispatcher per renderer root:
;
;   dispatcher.reset()
;   tree = component.render(...)   ; hooks called in order
;   dispatcher.commit()
;
; useState returns the current value via HookState; setters queue an update and
; mark the root dirty so the host can re-render. Same call-order rules as React.
; =============================================================================

class HookState {
    def value:string ""
    def pending:string ""
    def hasPending:boolean false
    def index:int 0

    Constructor () {
    }
}

class HookDispatcher {
    def states:[HookState]
    def cursor:int 0
    def dirty:boolean false
    def renderPass:int 0

    Constructor () {
        def s:[HookState]
        states = s
    }

    ; Start a render pass: apply queued updates first (React order), then
    ; reset the hook cursor so useState walks states in declaration order.
    fn beginRender:void () {
        def i:int 0
        while (i < (array_length states)) {
            def st:HookState (itemAt states i)
            if st.hasPending {
                st.value = st.pending
                st.hasPending = false
            }
            i = (i + 1)
        }
        cursor = 0
        dirty = false
        renderPass = (renderPass + 1)
    }

    fn reset:void () {
        this.beginRender()
    }

    fn commit:void () {
        ; Pending updates are applied in beginRender; kept for API symmetry.
        dirty = false
    }

    fn isDirty:boolean () {
        return dirty
    }

    fn markDirty:void () {
        dirty = true
    }

    ; useState(initial) — string state for the MVP (EVG attrs are strings).
    fn useState:HookState (initial:string) {
        if (cursor >= (array_length states)) {
            def st (new HookState())
            st.value = initial
            st.index = cursor
            push states st
        }
        def cur:HookState (itemAt states cursor)
        cursor = (cursor + 1)
        return cur
    }

    fn setState:void (index:int next:string) {
        if (index < 0) {
            return
        }
        if (index >= (array_length states)) {
            return
        }
        def st:HookState (itemAt states index)
        st.pending = next
        st.hasPending = true
        dirty = true
    }

    ; Functional update: setState(i, fn(prev)->next) approximated by callers
    ; reading HookState.value then calling setState.
    fn useReducer:HookState (initial:string) {
        return (this.useState(initial))
    }

    fn stateCount:int () {
        return (array_length states)
    }

    fn stateAt:HookState (i:int) {
        return (itemAt states i)
    }
}

; =============================================================================
; XmlToRg — EVG XML (SPEC) → RgElement via XmlCore
; =============================================================================
; EVG documents are well-formed XML (`gallery/evg/SPEC.md`). This path lets a
; layout authored as XML become the same virtual tree createElement builds,
; then render through EVGBridge to painters (WebGL / SDL / SoftCanvas / PDF).
; =============================================================================

Import "RgElement.rgr"
Import "../../xml/XmlCore.rgr"

class XmlToRg {

    Constructor () {
    }

    fn parse:RgElement (xml:string) {
        def parser (new XmlParser())
        parser.keepPrefixes = false
        def root@(optional):XmlNode (parser.parse(xml))
        if root {
            return (this.fromNode((unwrap root)))
        }
        return (RgElement.textNode(""))
    }

    fn fromNode:RgElement (node:XmlNode) {
        if node.isText {
            return (RgElement.textNode(node.text))
        }
        def props (new RgProps())
        def ai:int 0
        while (ai < (array_length node.attrs)) {
            def a:XmlAttr (itemAt node.attrs ai)
            props.set(a.name a.value)
            ai = (ai + 1)
        }
        def kids:[RgElement]
        def ci:int 0
        while (ci < (node.childCount())) {
            def child:XmlNode (node.childAt(ci))
            if child.isText {
                if (child.text != "") {
                    push kids (RgElement.textNode(child.text))
                }
            } {
                push kids (this.fromNode(child))
            }
            ci = (ci + 1)
        }
        def tag:string node.name
        if (tag == "") {
            return (RgElement.fragment(kids))
        }
        return (RgElement.host(tag props kids))
    }
}

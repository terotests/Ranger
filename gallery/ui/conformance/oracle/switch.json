  "enter": {
    "before": true,
    "after": false,
    "toggles": true,
    "$comment": "A <button> toggles on Enter because the browser says so, not because the library does. Whether a switch SHOULD is not settled — the ARIA pattern names Space and is silent on Enter — so whichever way this falls, it is a fact about the reference and not a rule."
  },

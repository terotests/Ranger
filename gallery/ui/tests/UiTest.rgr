; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; UiTest — the offline half of the conformance story
; =============================================================================
; The browser half (conformance/compare.mjs) needs Chromium and the Radix
; packages. This half needs nothing, so it is what CI runs on every push: the
; controllers' own behaviour, and the class-first cascade underneath them.
; =============================================================================

Import "../src/UiTree.rgr"
Import "../src/UiCtl.rgr"
Import "../src/ToggleCtl.rgr"
Import "../src/CollapsibleCtl.rgr"
Import "../src/CheckboxCtl.rgr"
Import "../src/RadioGroupCtl.rgr"
Import "../src/TabsCtl.rgr"
Import "../src/AccordionCtl.rgr"
Import "../src/PopoverCtl.rgr"
Import "../src/AlertDialogCtl.rgr"
Import "../src/MenuCtl.rgr"
Import "../src/WindowCtl.rgr"
Import "../src/HoverCtl.rgr"
Import "../src/SliderCtl.rgr"
Import "../src/ToastCtl.rgr"
Import "../src/UiHost.rgr"
Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGA11yTree.rgr"
Import "../../evg/EVGColor.rgr"
Import "../../evg/EVGDisplayList.rgr"

class Check {
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        def good:boolean (got == want)
        if (good == false) {
            print ("       got [" + got + "] want [" + want + "]")
        }
        this.ok(name good)
    }

    fn eqInt:void (name:string got:int want:int) {
        def good:boolean (got == want)
        if (good == false) {
            print ("       got " + (to_string got) + " want " + (to_string want))
        }
        this.ok(name good)
    }
}

class UiTest {

    sfn themeCss:string () {
        def css:string ".ui-toggle { background-color: #e2e8f0 }"
        css = css + " .ui-toggle-state-on { background-color: #2563eb }"
        css = css + " .theme-dark .ui-toggle { background-color: #1e293b }"
        return css
    }

    ; --- the window ------------------------------------------------------------
    ; The ARIA here is Radix's dialog and is measured by the conformance
    ; harness through DialogCtl; what is specified rather than measured is the
    ; MOVING, because nothing in Radix moves a dialog and inventing an oracle
    ; would be inventing the answer. So these state the rules instead:
    ;
    ;   the title bar is the handle, and only when the window is movable;
    ;   a modal is not movable at all;
    ;   enough of the window stays on the page to grab it again;
    ;   the arrow keys move it too, or a keyboard cannot;
    ;   and the caller's content survives every one of those rebuilds, which
    ;   is the whole point of the class.

    sfn testWindow:void (t:Check) {
        print "--- the movable window ---"
        def h (new UiHost())
        def w:WindowCtl (h.addWindow("win" "Open" "Filters" false))
        w.x = 200.0
        w.y = 120.0

        ; Compose something into it — a tree the window knows nothing about.
        ; The body is NAMED too, the way a caller that wants to style it would,
        ; and that is the case this covers: the frame's own class has to survive
        ; being given a neighbour.
        def body:EVGElement (unwrap w.bodyEl)
        body.className = "my-own-body"
        def row (EVGElement.createDiv())
        row.id = "win-custom"
        row.className = "whatever-the-caller-likes"
        body.addChild(row)
        w.build()

        h.click("win-trigger")
        ; Checked after opening, because a closed window builds no frame at all
        ; — which is also why the first version of this check failed.
        ;
        ; The caller composes CHILDREN; the body's own box is the frame's
        ; business. An earlier version set the frame's class only when the
        ; caller had left it empty, so naming the body silently took the
        ; window's padding away — the title sat fourteen pixels in and every
        ; row under it started at the window's border.
        t.ok("the caller's class is kept" (UiTree.hasClass(body "my-own-body")))
        t.ok("and the frame's own class is added beside it"
            (UiTree.hasClass(body "ui-window-body")))
        t.eqStr("it is a dialog" (UiTest.roleOf(h "win-content")) "dialog")
        t.eqStr("focus lands on close" h.focusId "win-close")
        t.ok("the composed child is still there after opening"
            ((UiTest.hasRow(h "win-body")) && ((body.getChildCount()) == 1)))
        t.eqStr("and it is the caller's own element"
            ((body.getChild(0)).id) "win-custom")

        ; Moving.
        t.ok("a movable window drags freely" (w.dragsFreely()))
        h.pressOn("win-titlebar")
        h.dragMoveBy(40.0 25.0)
        t.eqStr("the window went with the pointer"
            (((to_string w.x) + ",") + (to_string w.y)) "240,145")
        h.releaseDrag()
        t.eqStr("and stayed where it was dropped"
            (((to_string w.x) + ",") + (to_string w.y)) "240,145")

        ; The content survived all of that.
        t.ok("the caller's child survived the drag" ((body.getChildCount()) == 1))

        ; A press somewhere else in the window is not a drag.
        h.pressOn("win-close")
        h.dragMoveBy(100.0 100.0)
        t.eqStr("a press off the title bar moves nothing"
            (((to_string w.x) + ",") + (to_string w.y)) "240,145")
        h.releaseDrag()

        ; Keyboard.
        ; Focused by CLICKING the title, which is what a hit test reports and
        ; what the live page therefore hands over — not the bar id a test would
        ; reach for. The first version focused the bar directly and passed while
        ; the real page could not move the window at all.
        h.click("win-title")
        t.eqStr("clicking the title focuses the handle" h.focusId "win-titlebar")
        h.key("ArrowRight")
        t.eqStr("an arrow key moves it too" (to_string w.x) "256")
        h.key("ArrowUp")
        t.eqStr("and on the other axis" (to_string w.y) "129")

        h.key("Escape")
        t.eqStr("escape closes it" h.focusId "win-trigger")
        t.ok("and the window is gone" ((UiTest.hasRow(h "win-content")) == false))
    }

    ; A window dragged off the page is a window nobody can get back, so the
    ; clamp is a behaviour and not a detail. It needs a laid-out window,
    ; because "enough of it" is measured against its width.
    sfn testWindowStaysReachable:void (t:Check) {
        print "--- a window stays reachable ---"
        def h (new UiHost())
        h.setPageSize(900.0 560.0)
        def w:WindowCtl (h.addWindow("win" "Open" "Filters" false))
        w.pageW = 900.0
        w.pageH = 560.0
        def body:EVGElement (unwrap w.bodyEl)
        def filler (EVGElement.createDiv())
        filler.width = (EVGUnit.px(320.0))
        filler.height = (EVGUnit.px(200.0))
        body.addChild(filler)
        w.build()
        h.click("win-trigger")
        h.layout()

        ; Far off to the right.
        h.pressOn("win-titlebar")
        h.dragMoveBy(5000.0 0.0)
        t.ok("it cannot be pushed off the right edge" (w.x <= (900.0 - w.keepOnScreen)))
        ; And far off the bottom.
        h.dragMoveBy(0.0 5000.0)
        t.ok("nor off the bottom" (w.y <= (560.0 - w.keepOnScreen)))
        ; And the top is hard: the handle must stay reachable.
        h.dragMoveBy(0.0 (0.0 - 5000.0))
        t.ok("nor above the top, where the handle would go out of reach" (w.y >= 0.0))
        h.releaseDrag()
    }

    ; The modal half of the same class. Everything the window does with the
    ; pointer, this refuses to do — and it takes the page instead.
    sfn testModalWindow:void (t:Check) {
        print "--- the modal window ---"
        def h (new UiHost())
        def m:WindowCtl (h.addWindow("dlg" "Edit" "Edit profile" true))
        m.description = "Make changes to your profile here."
        m.build()
        h.click("dlg-trigger")
        t.eqStr("it is a dialog too" (UiTest.roleOf(h "dlg-content")) "dialog")
        t.eqStr("and it is the modal one" (h.modalTid()) "dlg-content")
        t.ok("it has a scrim" (UiTest.hasRow(h "dlg-scrim")))
        t.ok("which a reader is not offered"
            ((UiTest.roleOf(h "dlg-scrim")) == "none"))
        t.ok("a modal does not drag" ((m.dragsFreely()) == false))
        t.ok("and its title bar is not a tab stop"
            ((m.isFocusable("dlg-titlebar")) == false))
        h.pressOn("dlg-titlebar")
        h.dragMoveBy(60.0 60.0)
        t.eqStr("so dragging it moves nothing"
            (((to_string m.x) + ",") + (to_string m.y)) "0,0")
        h.releaseDrag()
        h.key("Escape")
        t.eqStr("escape closes it" h.focusId "dlg-trigger")
    }

    sfn main:void () {
        def t (new Check())
        print "=== gallery/ui controller + cascade tests ==="
        UiTest.testClassFirst(t)
        UiTest.testInlineWins(t)
        UiTest.testTheme(t)
        UiTest.testToggle(t)
        UiTest.testCollapsible(t)
        UiTest.testFocusAndKeys(t)
        UiTest.testCheckbox(t)
        UiTest.testSwitch(t)
        UiTest.testRadioGroup(t)
        UiTest.testTabs(t)
        UiTest.testAccordion(t)
        UiTest.testDisabledFade(t)
        UiTest.testBorderShorthand(t)
        UiTest.testOverlays(t)
        UiTest.testHoverSurfaces(t)
        UiTest.testSubmenuClock(t)
        UiTest.testWindow(t)
        UiTest.testWindowStaysReachable(t)
        UiTest.testModalWindow(t)
        UiTest.testSliderAndToast(t)
        UiTest.testA11yTree(t)
        print ""
        print ("passed=" + (to_string t.passed) + " failed=" + (to_string t.failed))
        if (t.failed > 0) {
            print "RESULT FAIL"
        } {
            print "RESULT OK"
        }
    }

    ; A controller writes classes; the sheet decides what they look like.
    sfn testClassFirst:void (t:Check) {
        print "--- class-first cascade ---"
        def h (new UiHost())
        h.addStyleSheet((UiTest.themeCss()))
        t.eqInt("sheet parses cleanly" (h.styleErrorCount()) 0)
        def tog:ToggleCtl (h.addToggle("toggle" "Bold"))
        def el:EVGElement (unwrap tog.rootEl)
        t.ok("has component class" (UiTree.hasClass(el "ui-toggle")))
        t.ok("has bare state class" (UiTree.hasClass(el "state-off")))
        t.ok("has scoped state class" (UiTree.hasClass(el "ui-toggle-state-off")))
        t.eqStr("state reads back" (UiTree.stateOf(el)) "off")
        h.layout()
        def offBg:int (to_int el.backgroundColor.r)
        t.eqInt("off colour from sheet" offBg 226)
        h.click("toggle")
        h.layout()
        t.eqStr("state flipped" (UiTree.stateOf(el)) "on")
        def onBg:int (to_int el.backgroundColor.r)
        t.eqInt("on colour from sheet" onBg 37)
    }

    ; Inline attributes are still allowed, and still win.
    sfn testInlineWins:void (t:Check) {
        print "--- inline outranks the sheet ---"
        def h (new UiHost())
        h.addStyleSheet((UiTest.themeCss()))
        def tog:ToggleCtl (h.addToggle("toggle" "Bold"))
        def el:EVGElement (unwrap tog.rootEl)
        UiTree.inline(el "background-color" "#ff0000")
        t.ok("marked inline" (el.hasInline("background-color")))
        h.layout()
        def bg:int (to_int el.backgroundColor.r)
        t.eqInt("inline red survives the cascade" bg 255)
    }

    sfn testTheme:void (t:Check) {
        print "--- theme scoping ---"
        def h (new UiHost())
        h.addStyleSheet((UiTest.themeCss()))
        h.setTheme("dark")
        def tog:ToggleCtl (h.addToggle("toggle" "Bold"))
        def el:EVGElement (unwrap tog.rootEl)
        h.layout()
        def bg:int (to_int el.backgroundColor.r)
        t.eqInt("dark theme wins" bg 30)
    }

    sfn testToggle:void (t:Check) {
        print "--- toggle ---"
        def h (new UiHost())
        def tog:ToggleCtl (h.addToggle("toggle" "Bold"))
        def dis:ToggleCtl (h.addToggle("toggle-disabled" "Italic"))
        dis.disabled = true
        dis.build()
        t.ok("starts off" (tog.on == false))
        h.click("toggle")
        t.ok("click turns on" tog.on)
        h.click("toggle")
        t.ok("click turns off again" (tog.on == false))
        h.click("toggle-disabled")
        t.ok("disabled never activates" (dis.on == false))
        def rows:[UiRow] (dis.rows())
        def row:UiRow (itemAt rows 0)
        t.ok("disabled is not a tab stop" (row.tabStop == false))
        t.eqInt("off reports aria-pressed=no" row.pressed (EVGA11yTri.no()))
    }

    sfn testCollapsible:void (t:Check) {
        print "--- collapsible ---"
        def h (new UiHost())
        def col:CollapsibleCtl (h.addCollapsible("collapsible" "Details" "Hidden body"))
        def root:EVGElement (unwrap h.root)
        t.ok("closed content leaves the tree" ((UiTree.reachable(root "collapsible-content")) == false))
        t.ok("trigger stays in the tree" (UiTree.reachable(root "collapsible-trigger")))
        h.click("collapsible-trigger")
        t.ok("opens on trigger click" col.open)
        t.ok("open content is in the tree" (UiTree.reachable(root "collapsible-content")))
        def rows:[UiRow] (col.rows())
        def trigRow:UiRow (itemAt rows 1)
        t.eqInt("open reports aria-expanded=yes" trigRow.expanded (EVGA11yTri.yes()))
        def rootRow:UiRow (itemAt rows 0)
        def rootRole:string (EVGA11yRole.ariaName(rootRow.role))
        t.eqStr("root has no ARIA role of its own" rootRole "none")
        h.click("collapsible-trigger")
        t.ok("closes again" (col.open == false))
        t.ok("closed content left the tree again" ((UiTree.reachable(root "collapsible-content")) == false))
    }

    sfn testCheckbox:void (t:Check) {
        print "--- checkbox ---"
        def h (new UiHost())
        def cb:CheckboxCtl (h.addCheckbox("cb" "Accept"))
        def rows0:[UiRow] (cb.rows())
        def r0:UiRow (itemAt rows0 0)
        t.eqStr("starts unchecked" r0.state "unchecked")
        t.eqInt("aria-checked=no" r0.checked (EVGA11yTri.no()))
        h.click("cb")
        def rows1:[UiRow] (cb.rows())
        def r1:UiRow (itemAt rows1 0)
        t.eqStr("click checks" r1.state "checked")
        t.eqInt("aria-checked=yes" r1.checked (EVGA11yTri.yes()))
        ; The third state is an input, never somewhere activation returns to.
        def mixed (new CheckboxCtl())
        mixed.tid = "cbm"
        mixed.name = "Some"
        mixed.checkState = 2
        mixed.build()
        h.add(mixed)
        def rowsm:[UiRow] (mixed.rows())
        def rm:UiRow (itemAt rowsm 0)
        t.eqInt("mixed reports aria-checked=mixed" rm.checked (EVGA11yTri.mixed()))
        h.click("cbm")
        def rowsm2:[UiRow] (mixed.rows())
        def rm2:UiRow (itemAt rowsm2 0)
        t.eqStr("mixed resolves upward to checked" rm2.state "checked")
    }

    sfn testSwitch:void (t:Check) {
        print "--- switch ---"
        def h (new UiHost())
        def sw:SwitchCtl (h.addSwitch("sw" "Wifi"))
        def rows:[UiRow] (sw.rows())
        def row:UiRow (itemAt rows 0)
        def roleName:string (EVGA11yRole.ariaName(row.role))
        t.eqStr("switch has its own role" roleName "switch")
        h.click("sw")
        def rows2:[UiRow] (sw.rows())
        def row2:UiRow (itemAt rows2 0)
        t.eqStr("click checks" row2.state "checked")
    }

    sfn testRadioGroup:void (t:Check) {
        print "--- radio group ---"
        def h (new UiHost())
        def rg:RadioGroupCtl (h.addRadioGroup("rg" "Size"))
        rg.addItem("s" "Small" false)
        rg.addItem("m" "Medium" true)
        rg.addItem("l" "Large" false)
        rg.value = "s"
        rg.build()
        def rows0:[UiRow] (rg.rows())
        def root0:UiRow (itemAt rows0 0)
        def rootRole:string (EVGA11yRole.ariaName(root0.role))
        t.eqStr("root is a radiogroup" rootRole "radiogroup")
        t.ok("root is a tab stop" root0.tabStop)
        def first0:UiRow (itemAt rows0 1)
        t.ok("no roving tab stop before the group is touched" (first0.tabStop == false))
        h.click("rg-s")
        def rows1:[UiRow] (rg.rows())
        def first1:UiRow (itemAt rows1 1)
        t.ok("click gives the item the roving tab stop" first1.tabStop)
        ; ArrowDown skips the disabled middle item.
        h.key("ArrowDown")
        t.eqStr("arrow moves focus past the disabled item" h.focusId "rg-l")
        t.eqStr("arrow does not move the selection" rg.value "s")
        h.key("ArrowDown")
        t.eqStr("arrow wraps at the end" h.focusId "rg-s")
        h.key("ArrowUp")
        t.eqStr("arrow moves backwards, wrapping" h.focusId "rg-l")
    }

    sfn testTabs:void (t:Check) {
        print "--- tabs ---"
        def h (new UiHost())
        def tb:TabsCtl (h.addTabs("tb" "Settings"))
        tb.addItem("a" "Account" "acct" false)
        tb.addItem("x" "Billing" "bill" true)
        tb.addItem("b" "Password" "pwd" false)
        tb.value = "a"
        tb.build()
        def root:EVGElement (unwrap h.root)
        t.ok("active panel is in the tree" (UiTree.reachable(root "tb-panel-a")))
        t.ok("inactive panel is not" ((UiTree.reachable(root "tb-panel-b")) == false))
        h.click("tb-tab-b")
        t.eqStr("click activates the tab" tb.value "b")
        t.ok("panels swapped" (UiTree.reachable(root "tb-panel-b")))
        t.ok("old panel left the tree" ((UiTree.reachable(root "tb-panel-a")) == false))
        ; Unlike a radio group, a tab strip moves the selection with the arrow.
        h.key("ArrowRight")
        t.eqStr("arrow wraps to the first tab" tb.value "a")
        t.eqStr("and takes focus with it" h.focusId "tb-tab-a")
        h.key("ArrowLeft")
        t.eqStr("arrow back skips the disabled tab" tb.value "b")
    }

    sfn testAccordion:void (t:Check) {
        print "--- accordion ---"
        def h (new UiHost())
        def ac:AccordionCtl (h.addAccordion("ac" ""))
        ac.addItem("one" "First" "b1" false)
        ac.addItem("two" "Second" "b2" false)
        ac.build()
        def root:EVGElement (unwrap h.root)
        t.ok("everything starts closed" ((UiTree.reachable(root "ac-one-content")) == false))
        h.click("ac-one-trigger")
        t.eqStr("click opens" ac.openValue "one")
        t.ok("open content is in the tree" (UiTree.reachable(root "ac-one-content")))
        h.click("ac-two-trigger")
        t.eqStr("single mode: the other one closes" ac.openValue "two")
        t.ok("first content left the tree" ((UiTree.reachable(root "ac-one-content")) == false))
        h.click("ac-two-trigger")
        t.eqStr("collapsible: clicking the open one closes it" ac.openValue "")
    }

    ; `opacity` reaching the display list is what makes a disabled control look
    ; disabled. EVGDisplayList ignored the attribute until this module needed
    ; it, so the fade is worth holding down with a test.
    sfn testDisabledFade:void (t:Check) {
        print "--- disabled fades in the display list ---"
        def h (new UiHost())
        def css:string ".ui-toggle { background-color: #2563eb }"
        css = css + " .ui-toggle-disabled { opacity: 0.5 }"
        h.addStyleSheet(css)
        def live:ToggleCtl (h.addToggle("live" "Live"))
        def dead:ToggleCtl (h.addToggle("dead" "Dead"))
        dead.disabled = true
        dead.build()
        def dl:EVGDisplayList (h.displayList())
        def faded:int 0
        def full:int 0
        def i:int 0
        while (i < (array_length dl.cmds)) {
            def c:EVGDrawCmd (itemAt dl.cmds i)
            if (c.a < 0.99) {
                faded = (faded + 1)
            } {
                full = (full + 1)
            }
            i = (i + 1)
        }
        t.ok("the enabled control paints at full strength" (full > 0))
        t.ok("the disabled one is faded" (faded > 0))
        def firstFade:double 1.0
        def j:int 0
        while (j < (array_length dl.cmds)) {
            def c2:EVGDrawCmd (itemAt dl.cmds j)
            if (c2.a < firstFade) {
                firstFade = c2.a
            }
            j = (j + 1)
        }
        def half:boolean ((firstFade > 0.49) && (firstFade < 0.51))
        t.ok("faded exactly by the declared opacity" half)
    }

    ; The `border` shorthand used to be dropped in silence — no stylesheet
    ; error, no border. A theme writes it far more often than the longhands.
    sfn testBorderShorthand:void (t:Check) {
        print "--- border shorthand ---"
        def h (new UiHost())
        h.addStyleSheet(".ui-toggle { border: 2px solid #ff0000 }")
        t.eqInt("sheet parses cleanly" (h.styleErrorCount()) 0)
        def tog:ToggleCtl (h.addToggle("t" "T"))
        def el:EVGElement (unwrap tog.rootEl)
        h.layout()
        def w:int (to_int (el.effectiveBorderWidthPx()))
        t.eqInt("width came from the shorthand" w 2)
        def col:EVGColor (el.effectiveBorderColor())
        def r:int (col.red())
        def g:int (col.green())
        t.eqInt("colour came from the shorthand" r 255)
        t.eqInt("and only the red channel" g 0)
        def dl:EVGDisplayList (h.displayList())
        def strokes:int 0
        def i:int 0
        while (i < (array_length dl.cmds)) {
            def c:EVGDrawCmd (itemAt dl.cmds i)
            if (c.kind == 1) {
                strokes = (strokes + 1)
            }
            i = (i + 1)
        }
        t.ok("and it reaches the display list" (strokes > 0))

        ; `rgb(203, 213, 225)` has spaces in it and is still one token.
        def h2 (new UiHost())
        h2.addStyleSheet(".ui-toggle { border: 2px solid rgb(203, 213, 225) }")
        def tog2:ToggleCtl (h2.addToggle("t" "T"))
        def el2:EVGElement (unwrap tog2.rootEl)
        h2.layout()
        def w2:int (to_int (el2.effectiveBorderWidthPx()))
        t.eqInt("a functional colour does not split the shorthand" w2 2)
        def col2:EVGColor (el2.effectiveBorderColor())
        def b2:int (col2.blue())
        t.eqInt("and its channels survive" b2 225)
    }

    ; The accessibility tree is what a screen reader gets — `evg-a11y.js` mirrors
    ; it into real DOM over the canvas, and conformance/a11y.mjs runs axe-core on
    ; that. This half needs no browser, so CI holds the structure down: every
    ; focusable node named and sized, no orphans, no duplicate ids.
    ; --- the overlay family --------------------------------------------------
    ; Popover, alert dialog and the two menus. What is checked here is what the
    ; browser half proved against the reference, so a regression is caught in
    ; CI rather than on a machine that happens to have Chromium.

    sfn rowFor@(optional):UiRow (h:UiHost target:string) {
        def rows:[UiRow] (h.allRows())
        def i:int 0
        while (i < (array_length rows)) {
            def r:UiRow (itemAt rows i)
            if (r.tid == target) {
                def hit@(optional):UiRow r
                return hit
            }
            i = (i + 1)
        }
        def miss@(optional):UiRow
        return miss
    }

    sfn roleOf:string (h:UiHost target:string) {
        def maybe@(optional):UiRow (UiTest.rowFor(h target))
        if maybe {
            def r:UiRow (unwrap maybe)
            return (EVGA11yRole.ariaName(r.role))
        }
        return "<missing>"
    }

    sfn stateOfRow:string (h:UiHost target:string) {
        def maybe@(optional):UiRow (UiTest.rowFor(h target))
        if maybe {
            def r:UiRow (unwrap maybe)
            return r.state
        }
        return "<missing>"
    }

    sfn hasRow:boolean (h:UiHost target:string) {
        def maybe@(optional):UiRow (UiTest.rowFor(h target))
        if maybe {
            return true
        }
        return false
    }

    sfn testOverlays:void (t:Check) {
        print "--- overlays ---"

        def h (new UiHost())
        def pop:PopoverCtl (h.addPopover("pop" "Open"))
        def out:ToggleCtl (h.addToggle("out" "Outside"))
        t.ok("popover content absent while closed" ((UiTest.hasRow(h "pop-content")) == false))
        h.click("pop-trigger")
        t.eqStr("popover surface is a dialog" (UiTest.roleOf(h "pop-content")) "dialog")
        t.eqStr("focus lands inside, not on the surface" h.focusId "pop-inner")
        ; A popover is not modal: the page behind keeps its rows unhidden.
        def trace:string (h.traceJson())
        t.ok("outside control stays reachable" ((UiTest.hasRow(h "out")) == true))
        h.key("Escape")
        t.eqStr("escape restores focus to the trigger" h.focusId "pop-trigger")
        t.ok("popover content gone again" ((UiTest.hasRow(h "pop-content")) == false))

        def h2 (new UiHost())
        def ad:AlertDialogCtl (h2.addAlertDialog("ad" "Delete" "Sure?"))
        h2.click("ad-trigger")
        t.eqStr("alert dialog is not a plain dialog" (UiTest.roleOf(h2 "ad-content")) "alertdialog")
        t.eqStr("focus lands on cancel" h2.focusId "ad-cancel")
        t.eqStr("modal is the content" (h2.modalTid()) "ad-content")
        h2.click("ad-action")
        t.eqStr("the action closes and restores focus" h2.focusId "ad-trigger")

        def h3 (new UiHost())
        def dm:MenuCtl (h3.addDropdownMenu("dm" "Menu"))
        dm.addItem("a" "Alpha" false)
        dm.addItem("b" "Beta" true)
        dm.addItem("c" "Gamma" false)
        dm.build()
        h3.click("dm-trigger")
        t.eqStr("menu surface" (UiTest.roleOf(h3 "dm-content")) "menu")
        t.eqStr("opening focuses the surface" h3.focusId "dm-content")
        h3.key("ArrowDown")
        t.eqStr("first arrow takes the first item" h3.focusId "dm-item-a")
        h3.key("ArrowDown")
        t.eqStr("arrows skip the disabled item" h3.focusId "dm-item-c")
        h3.key("ArrowDown")
        t.eqStr("and stop at the end rather than wrapping" h3.focusId "dm-item-c")
        h3.key("Escape")
        t.eqStr("escape restores focus to the trigger" h3.focusId "dm-trigger")

        def h4 (new UiHost())
        def cm:MenuCtl (h4.addContextMenu("cm" "Right-click here"))
        cm.addItem("a" "Alpha" false)
        cm.addItem("b" "Beta" false)
        cm.build()
        h4.click("cm-trigger")
        t.ok("a plain click does not open a context menu" ((UiTest.hasRow(h4 "cm-content")) == false))
        h4.rightClick("cm-trigger")
        t.eqStr("the secondary button does" (UiTest.roleOf(h4 "cm-content")) "menu")
        t.eqStr("its trigger has no role" (UiTest.roleOf(h4 "cm-trigger")) "none")
        h4.key("ArrowUp")
        t.eqStr("arrow up from the surface takes the last item" h4.focusId "cm-item-b")
        h4.key("Escape")
        t.eqStr("closing loses focus, because the trigger cannot hold it" h4.focusId "")
    }

    ; --- the submenu's clock --------------------------------------------------
    ; The conformance harness proves WHAT a submenu does; it cannot prove WHEN.
    ; A hover step there settles for 300ms and observes once, firmly past the
    ; delay — deliberately, because a spec that observed at 60ms would be
    ; measuring the machine and would pass and fail on different runs.
    ;
    ; So the delay itself is measured here, where the clock is a number the test
    ; hands over. Radix opens a hovered submenu after 100ms: measured in the
    ; browser at 25ms intervals, closed through 75 and open at 100. Without
    ; these four checks a submenu that opened INSTANTLY passed every conformance
    ; spec — which it did, until they were written.

    sfn testSubmenuClock:void (t:Check) {
        print "--- the submenu clock ---"
        def h (new UiHost())
        def dm:MenuCtl (h.addDropdownMenu("dm" "Menu"))
        dm.addItem("a" "Alpha" false)
        def share:UiItem (dm.addSub("share" "Share" false))
        MenuCtl.addKid(share "mail" "Email Link" false)
        MenuCtl.addKid(share "sms" "Messages" false)
        dm.addItem("c" "Gamma" false)
        dm.build()

        h.click("dm-trigger")
        h.hover("dm-item-share")
        t.ok("the pointer arriving does not open it"
            ((UiTest.hasRow(h "dm-item-share-content")) == false))
        h.tick(50.0)
        t.ok("nor does half the delay"
            ((UiTest.hasRow(h "dm-item-share-content")) == false))
        h.tick(45.0)
        t.ok("nor 95ms of it"
            ((UiTest.hasRow(h "dm-item-share-content")) == false))
        h.tick(10.0)
        t.ok("105ms opens it" (UiTest.hasRow(h "dm-item-share-content")))
        ; Opened by the pointer, focus stays on the row the pointer is on. The
        ; keyboard path is the other way round and is checked below.
        t.eqStr("and focus stays on the row under the pointer" h.focusId "dm-item-share")

        ; Leaving before the delay elapses cancels it outright. Without this a
        ; submenu opens under a pointer that has already moved on.
        def h2 (new UiHost())
        def dm2:MenuCtl (h2.addDropdownMenu("dm" "Menu"))
        dm2.addItem("a" "Alpha" false)
        def share2:UiItem (dm2.addSub("share" "Share" false))
        MenuCtl.addKid(share2 "mail" "Email Link" false)
        dm2.build()
        h2.click("dm-trigger")
        h2.hover("dm-item-share")
        h2.tick(60.0)
        h2.hover("dm-item-a")
        h2.tick(400.0)
        t.ok("moving away before the delay cancels it"
            ((UiTest.hasRow(h2 "dm-item-share-content")) == false))

        ; And the keyboard has no delay at all: you asked for it by name.
        def h3 (new UiHost())
        def dm3:MenuCtl (h3.addDropdownMenu("dm" "Menu"))
        def share3:UiItem (dm3.addSub("share" "Share" false))
        MenuCtl.addKid(share3 "mail" "Email Link" false)
        dm3.build()
        h3.click("dm-trigger")
        h3.key("ArrowDown")
        h3.key("ArrowRight")
        t.ok("ArrowRight opens it with no clock at all"
            (UiTest.hasRow(h3 "dm-item-share-content")))
        t.eqStr("and puts focus on the first item" h3.focusId "dm-item-share-item-mail")
    }

    ; --- tooltip and hover card ----------------------------------------------

    sfn testHoverSurfaces:void (t:Check) {
        print "--- hover surfaces ---"
        def h (new UiHost())
        def tip:TooltipCtl (h.addTooltip("tip" "Hover me"))
        tip.bodyText = "Tip text"
        tip.build()
        t.eqStr("closed to start" (UiTest.stateOfRow(h "tip-trigger")) "closed")
        h.hover("tip-trigger")
        t.eqStr("the pointer opens it" (UiTest.stateOfRow(h "tip-trigger")) "delayed-open")
        t.eqStr("and the content is a tooltip" (UiTest.roleOf(h "tip-content")) "tooltip")
        h.unhover()
        t.eqStr("leaving closes it" (UiTest.stateOfRow(h "tip-trigger")) "closed")
        h.focus("tip-trigger")
        ; Two words, not one: a reader is told HOW the tip was summoned.
        t.eqStr("focus opens it instantly" (UiTest.stateOfRow(h "tip-trigger")) "instant-open")
        h.key("Escape")
        t.eqStr("escape closes it" (UiTest.stateOfRow(h "tip-trigger")) "closed")
        t.eqStr("and leaves focus alone" h.focusId "tip-trigger")

        def h2 (new UiHost())
        def hc:HoverCardCtl (h2.addHoverCard("hc" "Card"))
        hc.bodyText = "Card body"
        hc.build()
        t.eqStr("the trigger is a link" (UiTest.roleOf(h2 "hc-trigger")) "link")
        h2.hover("hc-trigger")
        t.eqStr("hovering opens the card" (UiTest.stateOfRow(h2 "hc-trigger")) "open")
        t.eqStr("the card itself carries no role" (UiTest.roleOf(h2 "hc-content")) "none")
        h2.unhover()
        t.ok("leaving removes it" ((UiTest.hasRow(h2 "hc-content")) == false))
    }

    ; --- slider and toast ----------------------------------------------------

    sfn valueNowOf:int (h:UiHost target:string) {
        def maybe@(optional):UiRow (UiTest.rowFor(h target))
        if maybe {
            def r:UiRow (unwrap maybe)
            return r.valueNow
        }
        return -1
    }

    sfn testSliderAndToast:void (t:Check) {
        print "--- slider and toast ---"
        def h (new UiHost())
        def sl:SliderCtl (h.addSlider("sl" "Volume"))
        sl.value = 50
        sl.step = 10
        sl.build()
        t.eqStr("the thumb is the slider" (UiTest.roleOf(h "sl-thumb")) "slider")
        h.focus("sl-thumb")
        h.key("ArrowRight")
        t.eqInt("right adds a step" (UiTest.valueNowOf(h "sl-thumb")) 60)
        ; Up means MORE on a slider, even though it means "earlier" in a list.
        h.key("ArrowUp")
        t.eqInt("up adds a step too" (UiTest.valueNowOf(h "sl-thumb")) 70)
        h.key("ArrowDown")
        t.eqInt("down subtracts one" (UiTest.valueNowOf(h "sl-thumb")) 60)
        h.key("Home")
        t.eqInt("home goes to the minimum" (UiTest.valueNowOf(h "sl-thumb")) 0)
        h.key("ArrowLeft")
        t.eqInt("and it clamps there" (UiTest.valueNowOf(h "sl-thumb")) 0)
        h.key("End")
        t.eqInt("end goes to the maximum" (UiTest.valueNowOf(h "sl-thumb")) 100)
        h.key("ArrowRight")
        t.eqInt("and clamps there too" (UiTest.valueNowOf(h "sl-thumb")) 100)

        def h2 (new UiHost())
        def ts:ToastCtl (h2.addToast("ts" "Show"))
        ts.title = "Saved"
        ts.build()
        t.eqStr("the region is a named landmark" (UiTest.roleOf(h2 "ts-region")) "region")
        t.ok("nothing is raised yet" ((UiTest.hasRow(h2 "ts")) == false))
        h2.click("ts-trigger")
        t.eqStr("raising it does not steal focus" h2.focusId "ts-trigger")
        t.ok("the toast is there" ((UiTest.hasRow(h2 "ts")) == true))
        h2.click("ts-close")
        t.eqStr("dismissing parks focus on the viewport" h2.focusId "ts-viewport")
        h2.click("ts-trigger")
        h2.key("Escape")
        t.ok("escape dismisses it" ((UiTest.hasRow(h2 "ts")) == false))
        t.eqStr("and leaves focus where it was" h2.focusId "ts-trigger")
    }

    sfn testA11yTree:void (t:Check) {
        print "--- accessibility tree ---"
        def h (new UiHost())
        h.addStyleSheet((UiTest.themeCss()))
        def tog:ToggleCtl (h.addToggle("tog" "Bold"))
        def cb:CheckboxCtl (h.addCheckbox("cb" "Accept"))
        cb.checkState = 2
        cb.build()
        def col:CollapsibleCtl (h.addCollapsible("col" "Details" "Body"))
        def rg:RadioGroupCtl (h.addRadioGroup("rg" "Size"))
        rg.addItem("s" "Small" false)
        rg.addItem("m" "Medium" true)
        rg.value = "s"
        rg.build()
        h.setPageSize(420.0 600.0)

        def problems:[string] (h.a11yProblems())
        def i:int 0
        while (i < (array_length problems)) {
            print ("       lint: " + (itemAt problems i))
            i = (i + 1)
        }
        t.eqInt("tree lints clean" (array_length problems) 0)

        def tree:EVGA11yTree (h.a11yTree())
        t.ok("the root is the page" (tree.rootId == "root"))
        def togNode:EVGA11yNode (tree.find("tog"))
        def togRole:string (EVGA11yRole.ariaName(togNode.role))
        t.eqStr("a toggle is a button" togRole "button")
        t.ok("and it is focusable" togNode.focusable)
        t.ok("and it has a rectangle" (togNode.w > 0))
        def cbNode:EVGA11yNode (tree.find("cb"))
        t.eqInt("a mixed checkbox says mixed" cbNode.checked (EVGA11yTri.mixed()))
        def disabledNode:EVGA11yNode (tree.find("rg-m"))
        t.ok("a disabled item is disabled" disabledNode.disabled)
        t.ok("and not focusable" (disabledNode.focusable == false))
        def trigNode:EVGA11yNode (tree.find("col-trigger"))
        t.eqStr("a trigger hangs under its collapsible" trigNode.parentId "col")
        ; Closed content is out of the tree, exactly as a hidden node is out of
        ; the browser's — a reader must not find a panel nobody can open.
        t.ok("closed content is not in the tree" ((tree.has("col-content")) == false))
        h.click("col-trigger")
        def tree2:EVGA11yTree (h.a11yTree())
        t.ok("open content is" (tree2.has("col-content")))
        t.eqStr("focus is reported" tree2.focusId "col-trigger")
    }

    sfn testFocusAndKeys:void (t:Check) {
        print "--- focus and keys ---"
        def h (new UiHost())
        def tog:ToggleCtl (h.addToggle("toggle" "Bold"))
        def dis:ToggleCtl (h.addToggle("toggle-disabled" "Italic"))
        dis.disabled = true
        dis.build()
        h.click("toggle")
        t.eqStr("click focuses" h.focusId "toggle")
        h.key("Enter")
        t.ok("Enter activates the focused control" (tog.on == false))
        h.key(" ")
        t.ok("Space activates too" tog.on)
        h.key("a")
        t.ok("other keys do nothing" tog.on)
        h.click("toggle-disabled")
        t.eqStr("clicking a disabled control drops focus" h.focusId "")
        h.key("Enter")
        t.ok("keys go nowhere without focus" tog.on)
    }
}

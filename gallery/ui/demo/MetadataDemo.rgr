; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; MetadataDemo — the M-Files metadata card, on the kit
; =============================================================================
; The third form reference, and the first one that is a screen out of a real
; application rather than a component library's example: gallery/mfiles draws
; this card by hand — its own chip field, its own dropdown, its own Yes/No
; pills, its own label column — and this page draws the same card out of
; controllers that were measured against something.
;
;   Name or title *   InputCtl
;   Class             ComboboxCtl, single  — Base UI's combobox
;   Invoice number *  InputCtl
;   Customer *        ComboboxCtl, multiple — the same, with chips
;   Amount            InputCtl (number)
;   Due date          DateFieldCtl        — Chromium's <input type="date">
;   Approved          RadioGroupCtl in toggle mode — Radix's toggle group,
;                     drawn as the two pills the card has
;
; The rows are `UiField`s: label, hint, error, required. That class came out
; of the invoice demo and into ../src for this page, because three forms
; hand-rolling the same four strings is the signal that they are a component.
;
; --- WHAT SAVE DOES -------------------------------------------------------------
;
; The card has a Save and a Discard, and they are the point of a form: a
; field with a required mark and no way to find out what happens when it is
; empty is a picture of a required mark. Save checks the three required
; fields; an empty one gets its error, which becomes the control's
; description (see UiField), and the card's status line says how many. Discard
; puts every field back to what it opened with, chips and all.
;
; --- HOW A PAGE HOSTS A COMBOBOX -----------------------------------------------
;
; The combobox's list is an OVERLAY SURFACE anchored to its box, the same
; mechanism the dropdown demo uses, so the page does not lay it out — the
; layout pass does, below the box and above the rows under it. What the page
; does own is the caret and the selection band inside every text box on it,
; including the two inside the comboboxes: `InputCtl` knows the index, the
; page knows the font, and `caretXAt` turns one into the other with the same
; measurer the painter uses. This is the invoice demo's rule, applied through
; `dressBox` to whichever box asks.
;
; --- ONE HOST, IN MINIATURE -----------------------------------------------------
;
; `press`, `keyWith` and `type` are what UiHost does, written small: find the
; controller that owns the id, focus it, let it act, land wherever it says.
; The one rule worth naming is BLUR: when focus leaves a controller for another
; one, the first hears `onBlur`, which is how a combobox with "ru" typed into
; it goes back to "Rust" when you Tab away — measured, and invisible from
; inside the box.
; =============================================================================

Import "../src/InputCtl.rgr"
Import "../src/ComboboxCtl.rgr"
Import "../src/DateFieldCtl.rgr"
Import "../src/RadioGroupCtl.rgr"
Import "../src/UiField.rgr"
Import "../src/UiCtl.rgr"
Import "../src/UiTree.rgr"
Import "../src/UiText.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGUnit.rgr"
Import "pkg:evg/EVGLayout.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGStyleSheet.rgr"
Import "pkg:evg/EVGTransition.rgr"
Import "pkg:evg/EVGA11yTree.rgr"
Import "pkg:evg/EVGA11yFromTree.rgr"
Import "pkg:evg/EVGHitTest.rgr"
Import "pkg:evg/EVGTextEngine.rgr"

treefactory Md {
    child addChild
    text  textContent

    tag Page    EVGElement (props (className "md-page"))
    tag Card    EVGElement (props (className "md-card"))
    tag Title   EVGElement (props (className "md-title") (elementType 1) (role "heading") (a11yLevel 1))
    tag Sub     EVGElement (props (className "md-sub") (elementType 1))
    tag Actions EVGElement (props (className "md-actions"))
    tag Save    EVGElement (props (className "md-btn md-btn-primary") (elementType 1) (role "button"))
    tag Discard EVGElement (props (className "md-btn") (elementType 1) (role "button"))
    tag Status  EVGElement (props (className "md-status") (elementType 1) (role "status"))
    tag Bad     EVGElement (props (className "md-status md-status-bad") (elementType 1) (role "status"))
    tag Sep     EVGElement (props (className "md-sep"))
    tag Form    EVGElement (props (className "md-form") (role "form") (a11yLabel "Metadata"))
    tag Row     EVGElement (props (className "md-row"))
    ; The label is a ROW of two leaves: the words and the star. The star is
    ; decoration — `aria-required` on the control is the claim.
    tag Label   EVGElement (props (className "md-label"))
    tag LabelTx EVGElement (props (className "md-label-text") (elementType 1))
    tag Star    EVGElement (props (className "md-star") (elementType 1) (a11yHidden true))
    tag Cell    EVGElement (props (className "md-cell"))
    tag Hint    EVGElement (props (className "md-hint") (elementType 1) (a11yHidden true))
    tag Error   EVGElement (props (className "md-hint md-error") (elementType 1) (a11yHidden true))
    tag Band    EVGElement (props (className "md-band") (a11yHidden true))
    tag Auto    EVGElement (props (className "md-auto") (elementType 1))
    tag Note    EVGElement (props (className "md-note") (elementType 1))
}

class MetadataDemo {

    def fields:[UiField]
    def title:InputCtl (new InputCtl())
    def cls:ComboboxCtl (new ComboboxCtl())
    def number:InputCtl (new InputCtl())
    def customer:ComboboxCtl (new ComboboxCtl())
    def amount:InputCtl (new InputCtl())
    def due:DateFieldCtl (new DateFieldCtl())
    def approved:RadioGroupCtl (new RadioGroupCtl())

    def root@(optional):EVGElement
    def sheet@(optional):EVGStyleSheet
    def layout@(optional):EVGLayout
    def transitions:EVGTransition (new EVGTransition())
    def measurer:EVGLayout (new EVGLayout())

    def hovered:string ""
    def pressed:string ""
    def focused:string ""
    ; What the status line says after a Save or a Discard, "" before either.
    def status:string ""
    def statusBad:boolean false
    def saves:int 0

    def pageW:double 760.0
    def pageH:double 720.0
    ; The font the sheet draws every box in, handed to every InputCtl so a
    ; caret measured in one size is not drawn in another — the invoice demo's
    ; four-pixel lesson.
    def boxFont:string "Arial"
    def boxFontSize:double 13.0

    Constructor () {
    }

    ; --- setup ------------------------------------------------------------------

    fn addField:UiField (tid:string label:string hint:string required:boolean) {
        def f:UiField (UiField.of(tid label hint required))
        push fields f
        return f
    }

    fn fieldFor:UiField (tid:string) {
        def i:int 0
        while (i < (array_length fields)) {
            def f:UiField (itemAt fields i)
            if (f.tid == tid) {
                return f
            }
            i = (i + 1)
        }
        return (new UiField())
    }

    fn init:void (css:string) {
        def s (new EVGStyleSheet())
        s.parse(css)
        sheet = s

        this.addField("md-title" "Name or title" "" true)
        this.addField("md-class" "Class" "" false)
        this.addField("md-number" "Invoice number" "" true)
        this.addField("md-customer" "Customer" "Pick one or more. Backspace in the empty box takes the last one." true)
        this.addField("md-amount" "Amount" "" false)
        this.addField("md-due" "Due date" "" false)
        this.addField("md-approved" "Approved" "" false)

        title.tid = "md-title"
        number.tid = "md-number"
        amount.tid = "md-amount"
        amount.kind = "number"

        cls.tid = "md-class"
        cls.addItem("invoice" "Invoice" false)
        cls.addItem("po" "Purchase order" false)
        cls.addItem("contract" "Contract" false)
        cls.addItem("memo" "Memo" false)
        cls.addItem("archived" "Archived (read only)" true)
        cls.placeholder = "Choose a class"

        customer.tid = "md-customer"
        customer.multiple = true
        customer.addItem("estt" "ESTT Corporation" false)
        customer.addItem("fortney" "Fortney Nolte Associates" false)
        customer.addItem("aa" "A&A Consulting" false)
        customer.addItem("dat" "DAT Sports & Entertainment" false)
        customer.addItem("chicago" "City of Chicago" false)
        customer.placeholder = "Search customers"
        customer.emptyText = "No customers found."

        due.tid = "md-due"
        due.name = "Due date"

        approved.tid = "md-approved"
        approved.name = "Approved"
        approved.toggleMode = true
        approved.addItem("yes" "Yes" false)
        approved.addItem("no" "No" false)

        this.reset()
        focused = "md-title"
        root = (this.page())
    }

    ; What the card opened with. Discard comes back here.
    fn reset:void () {
        title.setValue("Invoice #1035 - Fortney Nolte Associates")
        title.caret = (strlen title.value)
        title.anchor = title.caret
        number.setValue("1035")
        number.caret = 4
        number.anchor = 4
        amount.setValue("5320")
        amount.caret = 4
        amount.anchor = 4
        cls.value = "invoice"
        cls.open = false
        cls.settleText()
        def none:[string]
        customer.values = none
        push customer.values "estt"
        customer.open = false
        customer.settleText()
        due.setDate(2024 1 31)
        due.blur()
        approved.value = "no"
        def i:int 0
        while (i < (array_length fields)) {
            def f:UiField (itemAt fields i)
            f.error = ""
            i = (i + 1)
        }
        this.dressAll()
    }

    ; Hand every field's strings to its control, and the font to every box.
    fn dressAll:void () {
        def all:[InputCtl] (this.inputs())
        def i:int 0
        while (i < (array_length all)) {
            def c:InputCtl (itemAt all i)
            c.fontFamily = boxFont
            c.fontSize = boxFontSize
            ; The run's width inside its box, which is what decides when the
            ; text scrolls to keep the caret in view. A standalone box is the
            ; column less its padding; the one inside a combobox shares the
            ; line with chips and a caret, so it is told the least it can be.
            c.boxWidth = 460.0
            if (i >= 3) {
                c.boxWidth = 130.0
            }
            i = (i + 1)
        }
        def fTitle:UiField (this.fieldFor("md-title"))
        fTitle.dressInput(title)
        def fNumber:UiField (this.fieldFor("md-number"))
        fNumber.dressInput(number)
        def fAmount:UiField (this.fieldFor("md-amount"))
        fAmount.dressInput(amount)
        def fClass:UiField (this.fieldFor("md-class"))
        fClass.dressCombobox(cls)
        def fCust:UiField (this.fieldFor("md-customer"))
        fCust.dressCombobox(customer)
        def fDue:UiField (this.fieldFor("md-due"))
        fDue.dress(due)
        def fAppr:UiField (this.fieldFor("md-approved"))
        fAppr.dress(approved)
    }

    ; Every text box on the page, the two inside the comboboxes included.
    fn inputs:[InputCtl] () {
        def a:[InputCtl]
        push a title
        push a number
        push a amount
        def ci:InputCtl (unwrap cls.input)
        push a ci
        def cu:InputCtl (unwrap customer.input)
        push a cu
        return a
    }

    fn ctls:[UiCtl] () {
        def a:[UiCtl]
        push a title
        push a cls
        push a number
        push a customer
        push a amount
        push a due
        push a approved
        return a
    }

    fn engine:EVGTextEngine () {
        return (measurer.getTextEngine())
    }

    ; --- save and discard ----------------------------------------------------------

    fn save:void () {
        def bad:int 0
        def fTitle:UiField (this.fieldFor("md-title"))
        fTitle.error = ""
        if ((strlen title.value) == 0) {
            fTitle.error = "A title is required."
            bad = (bad + 1)
        }
        def fNumber:UiField (this.fieldFor("md-number"))
        fNumber.error = ""
        if ((strlen number.value) == 0) {
            fNumber.error = "An invoice number is required."
            bad = (bad + 1)
        }
        def fCust:UiField (this.fieldFor("md-customer"))
        fCust.error = ""
        if ((array_length customer.values) == 0) {
            fCust.error = "Pick at least one customer."
            bad = (bad + 1)
        }
        this.dressAll()
        if (bad > 0) {
            statusBad = true
            if (bad == 1) {
                status = "1 field needs attention."
            } {
                status = (to_string bad) + " fields need attention."
            }
            return
        }
        saves = (saves + 1)
        statusBad = false
        status = "Saved as version " + (to_string (1 + saves)) + "."
    }

    fn discard:void () {
        this.reset()
        statusBad = false
        status = "Changes discarded."
    }

    ; --- the look --------------------------------------------------------------------

    ; The caret and the band, measured, in whichever text box asks. The
    ; controller built the box with its text and a caret leaf at the END of
    ; the row; this moves the caret to where the index says, draws the band
    ; behind the text, and takes the caret out of a box that has no focus —
    ; two carets on a page is two claims about where typing goes.
    fn dressBox:void (c:InputCtl caretTop:double) {
        def box:EVGElement (unwrap c.rootEl)
        def txt:EVGElement (unwrap c.textEl)
        def car:EVGElement (unwrap c.caretEl)
        def kids:[EVGElement]
        def eng:EVGTextEngine (this.engine())
        def hasFocus:boolean (focused == c.tid)
        if (hasFocus && (c.readOnly == false)) {
            c.ensureCaretVisible(eng)
            if (c.hasSelection()) {
                def s:double (c.caretXAt(eng (c.selStart())))
                def e:double (c.caretXAt(eng (c.selEnd())))
                def band (tree Md (Band (props (id (c.tid + "-band")))))
                band.left = (EVGUnit.px((s - c.scrollX)))
                band.width = (EVGUnit.px((e - s)))
                UiTree.inline(band "top" ((to_string caretTop) + "px"))
                push kids band
            }
        }
        push kids txt
        if (hasFocus && (c.readOnly == false)) {
            def cx:double (c.caretXAt(eng c.caret))
            car.left = (EVGUnit.px((cx - c.scrollX)))
            ; The bar sits at the line's top in a 40px box and in a 28px one,
            ; and only the page knows which box this is.
            UiTree.inline(car "top" ((to_string caretTop) + "px"))
            push kids car
        }
        box.children = kids
    }

    fn labelFor:EVGElement (f:UiField) {
        def lb (tree Md (Label (props (id (f.tid + "-label")))))
        lb.addChild((tree Md (LabelTx f.label)))
        if f.required {
            lb.addChild((tree Md (Star "*")))
        }
        return lb
    }

    ; A row: the label column, then the control and its one line of hint or
    ; error. The two are centred against each other whatever the control's
    ; height — a chip box with two rows of chips is taller than a text box.
    fn row:EVGElement (f:UiField control:EVGElement) {
        def r (tree Md (Row (props (id (f.tid + "-row")))))
        r.addChild((this.labelFor(f)))
        def cell (tree Md (Cell))
        cell.addChild(control)
        if (f.isBad()) {
            cell.addChild((tree Md (Error f.error)))
        } {
            if ((strlen f.hint) > 0) {
                cell.addChild((tree Md (Hint f.hint)))
            }
        }
        r.addChild(cell)
        return r
    }

    fn autoRow:EVGElement (label:string value:string) {
        def r (tree Md (Row))
        def lb (tree Md (Label))
        lb.addChild((tree Md (LabelTx label)))
        r.addChild(lb)
        def cell (tree Md (Cell))
        cell.addChild((tree Md (Auto value)))
        r.addChild(cell)
        return r
    }

    fn inputBox:EVGElement (c:InputCtl) {
        UiTree.dress(c)
        this.dressBox(c 10.0)
        def box:EVGElement (unwrap c.rootEl)
        UiTree.addClass(box "md-input")
        return box
    }

    ; Built, then its rows written onto its elements — `UiTree.dress` — so the
    ; page's own accessibility walk sees a combobox, a listbox and options
    ; where the classes alone would have shown it divs.
    fn comboBox:EVGElement (c:ComboboxCtl) {
        UiTree.dress(c)
        def inner:InputCtl (unwrap c.input)
        this.dressBox(inner 5.0)
        def box:EVGElement (unwrap c.rootEl)
        return box
    }

    fn dateBox:EVGElement () {
        due.build()
        def box:EVGElement (unwrap due.rootEl)
        box.role = "group"
        box.a11yLabel = due.name
        box.a11yRoleDescription = "Date field"
        def i:int 0
        while (i < 3) {
            def seg:EVGElement (itemAt due.segEls i)
            seg.role = "textbox"
            seg.a11yLabel = (due.segName(i))
            seg.a11yRoleDescription = "spinbutton"
            seg.a11yFocusable = true
            seg.a11yValue = (due.shown(i))
            i = (i + 1)
        }
        def k:int 0
        while (k < (box.getChildCount())) {
            def kid:EVGElement (box.getChild(k))
            if (kid.className == "ui-datefield-sep") {
                kid.a11yHidden = true
            }
            k = (k + 1)
        }
        return box
    }

    fn segmented:EVGElement () {
        approved.build()
        def box:EVGElement (unwrap approved.rootEl)
        UiTree.addClass(box "md-segmented")
        box.role = "radiogroup"
        box.a11yLabel = approved.name
        def i:int 0
        while (i < (array_length approved.items)) {
            def it:UiItem (itemAt approved.items i)
            def el:EVGElement (unwrap it.el)
            UiTree.addClass(el "md-pill")
            el.role = "radio"
            el.a11yLabel = it.name
            el.a11yFocusable = true
            if (it.value == approved.value) {
                el.a11yChecked = (EVGA11yTri.yes())
            } {
                el.a11yChecked = (EVGA11yTri.no())
            }
            i = (i + 1)
        }
        return box
    }

    fn page:EVGElement () {
        def page (tree Md (Page))
        def card (tree Md (Card))
        ; The heading is the title field's text, cut to the card with an
        ; ellipsis rather than run off it — `UiText.fit`, measured in the same
        ; engine the painter uses. The a11y name stays the whole title.
        def headTxt:string (UiText.fit((this.engine()) title.value boxFont 20.0 650.0))
        def head (tree Md (Title (props (id "md-heading")) headTxt))
        head.a11yLabel = title.value
        card.addChild(head)
        card.addChild((tree Md (Sub "Document · ID 11 · Version 1")))
        def actions (tree Md (Actions))
        actions.addChild((tree Md (Save (props (id "md-save")) "Save")))
        actions.addChild((tree Md (Discard (props (id "md-discard")) "Discard")))
        if ((strlen status) > 0) {
            if statusBad {
                actions.addChild((tree Md (Bad (props (id "md-status")) status)))
            } {
                actions.addChild((tree Md (Status (props (id "md-status")) status)))
            }
        }
        card.addChild(actions)
        card.addChild((tree Md (Sep)))

        def form (tree Md (Form))
        form.addChild((this.row((this.fieldFor("md-title")) (this.inputBox(title)))))
        form.addChild((this.row((this.fieldFor("md-class")) (this.comboBox(cls)))))
        form.addChild((this.row((this.fieldFor("md-number")) (this.inputBox(number)))))
        form.addChild((this.row((this.fieldFor("md-customer")) (this.comboBox(customer)))))
        form.addChild((this.row((this.fieldFor("md-amount")) (this.inputBox(amount)))))
        form.addChild((this.row((this.fieldFor("md-due")) (this.dateBox()))))
        form.addChild((this.row((this.fieldFor("md-approved")) (this.segmented()))))
        card.addChild(form)

        card.addChild((tree Md (Sep)))
        card.addChild((this.autoRow("Created" "12/1/2023 8:01 AM")))
        card.addChild((this.autoRow("Last modified" "1/9/2024 3:47 PM")))
        page.addChild(card)
        page.addChild((tree Md (Note "Click Customer and type, or press Backspace in its empty box. Class is the same control with one value. Save with an empty required field to see the error take the hint's line.")))
        return page
    }

    ; --- the host, in miniature ---------------------------------------------------

    fn ctlOwning@(optional):UiCtl (target:string) {
        def all:[UiCtl] (this.ctls())
        def i:int 0
        while (i < (array_length all)) {
            def c:UiCtl (itemAt all i)
            if (c.owns(target)) {
                def hit@(optional):UiCtl c
                return hit
            }
            i = (i + 1)
        }
        def miss@(optional):UiCtl
        return miss
    }

    ; Focus is about to go to `target`. The controller that has it hears
    ; onBlur when the move leaves it.
    fn leaveFocus:void (target:string) {
        if ((strlen focused) == 0) {
            return
        }
        def maybe@(optional):UiCtl (this.ctlOwning(focused))
        if maybe {
            def c:UiCtl (unwrap maybe)
            if ((strlen target) > 0) {
                if (c.owns(target)) {
                    return
                }
            }
            c.onBlur(focused)
        }
        if (focused == "md-due") {
            due.blur()
        }
        def i:int (due.segOf(focused))
        if (i >= 0) {
            if ((due.segOf(target)) < 0) {
                due.blur()
            }
        }
    }

    ; A click on the whole box of a text field lands on its text leaf or its
    ; caret; the controller owns those ids and answers for them.
    fn press:boolean (target:string) {
        if (target == "md-save") {
            this.leaveFocus(target)
            focused = target
            this.save()
            this.rebuild()
            return true
        }
        if (target == "md-discard") {
            this.leaveFocus(target)
            focused = target
            this.discard()
            this.rebuild()
            return true
        }
        def maybe@(optional):UiCtl (this.ctlOwning(target))
        if maybe {
            def c:UiCtl (unwrap maybe)
            ; A click inside a text box lands on its text or its caret leaf;
            ; the field itself is what takes focus.
            def landing:string target
            def all:[InputCtl] (this.inputs())
            def i:int 0
            while (i < (array_length all)) {
                def inp:InputCtl (itemAt all i)
                if ((target == (inp.textTid())) || (target == (inp.caretTid()))) {
                    landing = inp.tid
                }
                if (target == (inp.tid + "-band")) {
                    landing = inp.tid
                }
                i = (i + 1)
            }
            if (c.isFocusable(landing)) {
                this.leaveFocus(landing)
                focused = landing
                c.onFocus(landing)
                def next:string (c.activate(landing))
                if ((strlen next) > 0) {
                    focused = next
                }
                if ((c.isFocusable(focused)) == false) {
                    focused = ""
                }
                this.rebuild()
                return true
            }
        }
        this.leaveFocus("")
        focused = ""
        this.rebuild()
        return true
    }

    ; The tab ring, in reading order. One stop per control: the combobox's
    ; input, the date field's month, and the approved pill that is on.
    fn ring:[string] () {
        def a:[string]
        push a "md-title"
        push a (cls.inputTid())
        push a "md-number"
        push a (customer.inputTid())
        push a "md-amount"
        push a (due.segTid(0))
        push a (approved.itemTid(approved.value))
        push a "md-save"
        push a "md-discard"
        return a
    }

    fn tab:boolean (back:boolean) {
        ; Inside the date field a Tab walks the segments first.
        if ((due.segOf(focused)) >= 0) {
            def inner:string (due.tabFrom(focused back))
            if ((strlen inner) > 0) {
                focused = inner
                this.rebuild()
                return true
            }
        }
        def r:[string] (this.ring())
        def n:int (array_length r)
        def at:int (0 - 1)
        def i:int 0
        while (i < n) {
            def stop:string (itemAt r i)
            if (stop == focused) {
                at = i
            }
            ; Focus on a chip or a segment counts as being at that control.
            if (at < 0) {
                def maybe@(optional):UiCtl (this.ctlOwning(stop))
                if maybe {
                    def c:UiCtl (unwrap maybe)
                    if ((strlen focused) > 0) {
                        if ((c.owns(focused)) && (stop != "md-save")) {
                            at = i
                        }
                    }
                }
            }
            i = (i + 1)
        }
        def next:int (at + 1)
        if back {
            next = (at - 1)
        }
        if (next < 0) {
            next = (n - 1)
        }
        if (next >= n) {
            next = 0
        }
        def landing:string (itemAt r next)
        this.leaveFocus(landing)
        focused = landing
        if (landing == (due.segTid(0))) {
            focused = (due.enterFrom(back))
        }
        def maybe@(optional):UiCtl (this.ctlOwning(focused))
        if maybe {
            def c:UiCtl (unwrap maybe)
            c.onFocus(focused)
            ; Tab into a text box selects its contents, as a browser does.
            def all:[InputCtl] (this.inputs())
            def k:int 0
            while (k < (array_length all)) {
                def inp:InputCtl (itemAt all k)
                if (inp.tid == focused) {
                    inp.selectAll()
                }
                k = (k + 1)
            }
        }
        this.rebuild()
        return true
    }

    fn key:boolean (k:string) {
        return (this.keyWith(k false false))
    }

    fn keyWith:boolean (k:string shift:boolean ctrl:boolean) {
        if (k == "Tab") {
            return (this.tab(shift))
        }
        if ((focused == "md-save") || (focused == "md-discard")) {
            if (UiCtl.activatesOn(k)) {
                return (this.press(focused))
            }
            return false
        }
        def maybe@(optional):UiCtl (this.ctlOwning(focused))
        if maybe {
            def c:UiCtl (unwrap maybe)
            ; A printable key with no modifier is typing; everything else is a
            ; key. A control that does not type says so and gets the key.
            if (((strlen k) == 1) && (ctrl == false)) {
                if (c.typeChar(focused k)) {
                    this.rebuild()
                    return true
                }
            }
            def next:string (c.keyDownWith(focused k shift ctrl))
            if ((strlen next) > 0) {
                focused = next
            }
            if ((c.isFocusable(focused)) == false) {
                focused = ""
            }
            this.rebuild()
            return true
        }
        return false
    }

    fn type:boolean (ch:string) {
        return (this.keyWith(ch false false))
    }

    fn setHover:void (id:string) { hovered = id }
    fn setPressed:void (id:string) { pressed = id }
    fn setFocus:void (id:string) { focused = id }

    fn rebuild:void () {
        root = (this.page())
    }

    fn markStates:void (el:EVGElement) {
        el.isHovered = ((strlen hovered) > 0) && (el.id == hovered)
        el.isPressed = ((strlen pressed) > 0) && (el.id == pressed)
        el.isFocused = ((strlen focused) > 0) && (el.id == focused)
        def i:int 0
        while (i < (array_length el.children)) {
            this.markStates((itemAt el.children i))
            i = (i + 1)
        }
    }

    fn laidOut:EVGLayout () {
        def r:EVGElement (unwrap root)
        def s:EVGStyleSheet (unwrap sheet)
        s.setViewport(pageW pageH false)
        this.markStates(r)
        s.applyTree(r "")
        def t:EVGTransition transitions
        t.reconcileTree(r)
        def fresh (new EVGLayout())
        fresh.setPageSize(pageW pageH)
        layout = fresh
        fresh.layout(r)
        return fresh
    }

    fn displayListJson:string () {
        def lay:EVGLayout (this.laidOut())
        def r:EVGElement (unwrap root)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(r)
        return (dl.toJson())
    }

    fn hitId:string (px:double py:double) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def hit (new EVGHitTest())
        return (hit.idAt(r px py))
    }

    fn a11yJson:string (generation:int focusId:string) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Metadata card demo" generation focusId))
        return (t.toJson())
    }

    fn a11yProblems:[string] () {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Metadata card demo" 1 ""))
        return (t.lint())
    }

    fn styleErrorCount:int () {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getErrorCount())
    }

    fn styleErrorAt:string (i:int) {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getError(i))
    }

    fn tick:boolean (dtMs:double) {
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        t.advanceTree(r dtMs)
        return (t.busy(r))
    }

    fn busyNow:boolean () {
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        return (t.busy(r))
    }

    fn heightPx:double () { return pageH }
    fn widthPx:double () { return pageW }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; CalendarDemo — a date field, and the calendar that fills it in
; =============================================================================
; The reference is shadcn's Calendar, which is react-day-picker with a class
; map over it, used exactly as its documentation shows it:
;
;   <Calendar mode="single" selected={date} onSelect={setDate}
;             className="rounded-lg border" />
;
; So the calendar here is always on the page rather than inside a popover —
; that snippet is the always-visible one, and a popover would be answering a
; question nobody asked.
;
; THE STATE IS NOT REBUILT HERE. `CalendarCtl` owns the grid arithmetic, the
; roving tab stop, the eight keys and the toggling selection, and it is
; measured against react-day-picker in `conformance/oracle/calendar_check.mjs`
; — 108 behaviours, plus two recorded divergences. Writing the month
; arithmetic again for a demo would be writing an untested second copy of the
; only part of a calendar that is hard, and a calendar with two date
; arithmetics disagrees with itself one month in twelve.
;
; So this file is the other half: the controller decides what is true, the
; tree literal decides what it looks like.
;
; THE FIELD ABOVE THE GRID is the reason this demo exists rather than a bare
; calendar. A calendar is an INPUT, and an input has to say what it holds: the
; field shows the chosen date, shows a placeholder when there is none, and is
; the thing a form would actually read. Clearing the selection — clicking the
; chosen day again, which is what the reference does — has to be visible
; somewhere, and an empty field is where.
;
; TODAY IS PINNED to the oracle's day. A demo whose picture changes overnight
; cannot be snapshotted, and today is drawn differently from every other day.
; =============================================================================

Import "../src/CalendarCtl.rgr"
Import "../src/UiDate.rgr"
Import "../src/RadioGroupCtl.rgr"
Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGUnit.rgr"
Import "../../evg/EVGLayout.rgr"
Import "../../evg/EVGDisplayList.rgr"
Import "../../evg/EVGStyleSheet.rgr"
Import "../../evg/EVGTransition.rgr"
Import "../../evg/EVGA11yTree.rgr"
Import "../../evg/EVGA11yFromTree.rgr"
Import "../../evg/EVGHitTest.rgr"
Import "../../evg/EVGTextEngine.rgr"

treefactory Cal {
    child addChild
    text  textContent

    tag Page      EVGElement (props (className "cd-page"))
    tag Field     EVGElement (props (className "cd-field"))
    tag FieldLbl  EVGElement (props (className "cd-field-label") (elementType 1))
    tag Box       EVGElement (props (className "cd-box") (role "textbox"))
    tag BoxText   EVGElement (props (className "cd-box-text") (elementType 1))
    tag BoxHint   EVGElement (props (className "cd-box-hint") (elementType 1))
    tag Card      EVGElement (props (className "cd-card"))
    tag Nav       EVGElement (props (className "cd-nav") (role "navigation") (a11yLabel "Navigation bar"))
    tag NavBtn    EVGElement (props (className "cd-navbtn") (role "button"))
    tag NavGlyph  EVGElement (props (className "cd-navglyph") (elementType 1) (a11yHidden true))
    ; The caption keeps `role="status"` — arrowing into another month has to be
    ; announced — but it is no longer a text run: it holds the month and the
    ; year, and its accessible name is still the two of them read together.
    tag Caption   EVGElement (props (className "cd-caption") (role "status"))
    ; The caption is TWO things: a month, and a year you can press. It used to
    ; be one text run — which is why the only way to 2019 was forty-eight
    ; presses of the arrow beside it.
    tag MonthTxt  EVGElement (props (className "cd-monthtxt") (elementType 1))
    tag YearBtn   EVGElement (props (className "cd-yearbtn") (role "button") (a11yHasPopup "listbox"))
    tag YearTxt   EVGElement (props (className "cd-yeartxt") (elementType 1) (a11yHidden true))
    ; The panel, hung off the year as an overlay so it draws OVER the grid
    ; instead of pushing it down: a calendar that changes height when you
    ; reach for a year moves the thing you were about to click.
    tag YearPanel EVGElement (props (className "cd-yearpanel") (isOverlay true) (overlaySide "bottom") (overlayAlign "start") (role "listbox") (a11yLabel "Year"))
    tag YearOpt   EVGElement (props (className "cd-yearopt") (role "option") (a11yFocusable true))
    tag YearOptOn EVGElement (props (className "cd-yearopt cd-yearopt-on") (role "option") (a11yFocusable true))
    tag YearOptTx EVGElement (props (className "cd-yearopttx") (elementType 1) (a11yHidden true))
    ; The chosen year's number gets its own token rather than a descendant
    ; selector: EVGStyleSheet matches ONE token per selector, so
    ; `.cd-yearopt-on .cd-yearopttx` would never have matched anything.
    tag YearOptTxOn EVGElement (props (className "cd-yearopttx cd-yearopttx-on") (elementType 1) (a11yHidden true))
    tag Spacer    EVGElement (props (className "cd-spacer"))
    tag Grid      EVGElement (props (className "cd-grid") (role "grid"))
    tag HeadRow   EVGElement (props (className "cd-headrow"))
    ; The weekday strip is decoration: every day already carries its weekday in
    ; its own label, so a column header would say "Wednesday" twice per cell.
    ; The reference marks its <thead> aria-hidden for the same reason.
    tag Weekday   EVGElement (props (className "cd-weekday") (elementType 1) (a11yHidden true))
    tag Week      EVGElement (props (className "cd-week") (role "row"))
    tag Day       EVGElement (props (className "cd-day") (role "gridcell"))
    tag DayNum    EVGElement (props (className "cd-daynum") (elementType 1) (a11yHidden true))
    ; THE MODE SWITCHER. Asked for as checkboxes; they are RADIOS, because the
    ; three modes are mutually exclusive and a checkbox that unchecks its
    ; neighbour is telling a reader something untrue about itself. They are
    ; drawn as a row of small boxes with a mark on the active one, which is
    ; the picture the request described, and `RadioGroupCtl` — measured — owns
    ; which one is on.
    tag Modes     EVGElement (props (className "cd-modes") (role "radiogroup") (a11yLabel "Selection mode"))
    tag ModeOpt   EVGElement (props (className "cd-modeopt") (role "radio"))
    tag ModeBox   EVGElement (props (className "cd-modebox"))
    tag ModeBoxOn EVGElement (props (className "cd-modebox cd-modebox-on"))
    tag ModeMark  EVGElement (props (className "cd-modemark") (elementType 1) (a11yHidden true))
    tag ModeTx    EVGElement (props (className "cd-modetx") (elementType 1) (a11yHidden true))
    tag Note      EVGElement (props (className "cd-note") (elementType 1))
}

class CalendarDemo {

    def model:CalendarCtl (new CalendarCtl())
    def root@(optional):EVGElement
    def sheet@(optional):EVGStyleSheet
    ; A measurer owning no tree, for sizing the month name to its own text.
    def capMeasurer:EVGLayout (new EVGLayout())
    ; Which mode is on. The group is the measured control; the calendar is
    ; told what it says.
    def modes:RadioGroupCtl (new RadioGroupCtl())
    def transitions:EVGTransition (new EVGTransition())
    def layout@(optional):EVGLayout
    def hovered:string ""
    def pressed:string ""
    def focused:string ""
    def pageW:double 900.0
    def pageH:double 520.0

    Constructor () {
    }

    fn init:void (css:string) {
        def s (new EVGStyleSheet())
        s.parse(css)
        sheet = s

        model.tid = "cal"
        model.name = "Date"
        model.setMonth(2026 5)
        model.setToday(2026 5 14)
        ; The bounds are the HOST's decision. The reference with none given
        ; runs a hundred years back from the current year and stops there, so
        ; out of the box it cannot reach next year at all — recorded in
        ; `calendar.json` as a default not worth copying. A date field for an
        ; invoice wants a decade either side.
        model.startYear = 2016
        model.endYear = 2036
        ; Newest first, so the years near today are the ones you land on.
        model.reverseYears = true

        modes.tid = "cd-modes"
        modes.name = "Selection mode"
        modes.addItem("single" "Single" false)
        modes.addItem("multiple" "Multiple" false)
        modes.addItem("range" "Range" false)
        modes.selectValue("single")
        modes.build()
        model.build()

        root = (this.page())
    }

    ; --- what the field says -------------------------------------------------

    ; "Wednesday, May 20th, 2026" if a day is chosen. The long form rather than
    ; an ISO string because this is the human-facing half; the ISO string is
    ; what `CalendarCtl` addresses cells by, and the two are not the same job.
    fn fieldText:string () {
        if (model.hasSelection == false) {
            return ""
        }
        def p:[int] ([] _:int ( 0 0 0 ))
        UiDate.fromDays(model.selectedDay p)
        return (UiDate.longLabel((itemAt p 0) (itemAt p 1) (itemAt p 2)))
    }

    ; --- the look ------------------------------------------------------------

    ; The classes a day carries. Order matters to the cascade and not to the
    ; meaning: `EVGStyleSheet` matches one token per selector, so a variant is
    ; its own token on the same element rather than a compound rule.
    fn dayClass:string (day:int) {
        def cls:string "cd-day"
        if (model.isOutside(day)) {
            cls = (cls + " cd-day-outside")
        }
        if (model.isDisabledDay(day)) {
            cls = (cls + " cd-day-disabled")
        }
        if model.hasToday {
            if (day == model.todayDay) {
                cls = (cls + " cd-day-today")
            }
        }
        if model.hasSelection {
            if (day == model.selectedDay) {
                cls = (cls + " cd-day-selected")
            }
        }
        ; The two other modes paint from their own state. A chosen day in
        ; multiple mode reads the same as a selected one in single; a range
        ; has ENDS and a band between them, which are different pictures.
        if (model.isChosen(day)) {
            cls = (cls + " cd-day-selected")
        }
        if (model.isRangeEnd(day)) {
            cls = (cls + " cd-day-selected")
        } {
            if (model.isInRange(day)) {
                cls = (cls + " cd-day-inrange")
            }
        }
        return cls
    }

    ; The three mode options.
    fn modeRow:EVGElement () {
        def row (tree Cal (Modes (props (id "cd-modes"))))
        def i:int 0
        def vals:[string] ([] _:string ( "single" "multiple" "range" ))
        def names:[string] ([] _:string ( "Single" "Multiple" "Range" ))
        while (i < 3) {
            def v:string (itemAt vals i)
            def on:boolean (modes.value == v)
            ; A named intermediate: a computed child in text position is read
            ; as a TAG NAME by the tree factory.
            def label:string (itemAt names i)
            def opt (tree Cal
                (ModeOpt (props (id (modes.itemTid(v))) (a11yLabel label))))
            if on {
                opt.a11yChecked = (EVGA11yTri.yes())
                opt.addChild((tree Cal (ModeBoxOn (ModeMark "✓"))))
            } {
                opt.a11yChecked = (EVGA11yTri.no())
                opt.addChild((tree Cal (ModeBox)))
            }
            opt.addChild((tree Cal (ModeTx label)))
            row.addChild(opt)
            i = (i + 1)
        }
        return row
    }

    ; The day NUMBER's classes. It needs its own, because EVGStyleSheet has no
    ; descendant selectors: the number cannot inherit "I am inside a selected
    ; day" from its parent, and a white-on-white or black-on-black day is what
    ; you get for assuming it can.
    fn numClass:string (day:int) {
        def cls:string "cd-daynum"
        if (model.isOutside(day)) {
            cls = (cls + " cd-daynum-outside")
        }
        if model.hasSelection {
            if (day == model.selectedDay) {
                cls = (cls + " cd-daynum-selected")
            }
        }
        ; The other two modes mark days too, and the numeral needs the token
        ; on every path that darkens the cell under it — one missed branch is
        ; a black numeral on a black cell.
        if (model.isChosen(day)) {
            cls = (cls + " cd-daynum-selected")
        }
        if (model.isRangeEnd(day)) {
            cls = (cls + " cd-daynum-selected")
        }
        return cls
    }

    ; "Year, 2026, choose a year". The number is IN the name because the
    ; visible glyphs are hidden from the trace — a button whose accessible name
    ; is "choose a year" tells a reader which control it is and not what it
    ; currently says.
    sfn byId:EVGElement (el:EVGElement want:string) {
        if (el.id == want) {
            return el
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            def kid:EVGElement (CalendarDemo.byId((el.getChild(i)) want))
            if (kid.id == want) {
                return kid
            }
            i = (i + 1)
        }
        return el
    }

    ; The ink width of a caption run, at the size the stylesheet draws it.
    fn captionTextWidth:double (text:string) {
        def eng:EVGTextEngine (capMeasurer.getTextEngine())
        def m:EVGTextMetrics (eng.measureRun(text "system-ui" 14.0))
        return m.width
    }

    sfn px:string (v:double) {
        def scaled:int (to_int (v * 100.0))
        def whole:int (idiv scaled 100)
        def frac:int (scaled - (whole * 100))
        if (frac < 0) {
            frac = (0 - frac)
        }
        def fs:string (to_string frac)
        if (frac < 10) {
            fs = "0" + fs
        }
        return ((to_string whole) + "." + fs + "px")
    }

    fn yearBtnLabel:string () {
        return (("Year, " + (to_string model.viewYear)) + ", choose a year")
    }

    ; One row per year in the bounds. The reference uses a native `<select>`,
    ; which a canvas kit does not have; this is the scrollable panel the
    ; request described, and no measurement is claimed for it. What choosing a
    ; year DOES is measured — see `ui:calendar:check`.
    ; Where the panel is scrolled to. State, not style: a stylesheet has no
    ; business owning where a list is parked, and the same rule already
    ; applies to the dashboard's scroller.
    def yearScroll:double 0.0

    ; One row's pitch and the panel's own height, from the stylesheet in one
    ; place so the open-centred arithmetic and the wheel clamp cannot drift.
    sfn yearRowH:double () {
        return 26.0
    }

    sfn yearPanelH:double () {
        return 200.0
    }

    ; The whole point of the panel: opening it should not leave you eleven
    ; scrolls from the year you are on. Centred on the current year, clamped
    ; to the ends so the first and last years are reachable without an
    ; overscroll that shows nothing.
    fn centreOnCurrentYear:void () {
        def i:double (to_double (model.indexOfYear(model.viewYear)))
        def want:double (((i * (CalendarDemo.yearRowH())) + ((CalendarDemo.yearRowH()) / 2.0)) - ((CalendarDemo.yearPanelH()) / 2.0))
        yearScroll = (this.clampYearScroll(want))
    }

    fn yearContentH:double () {
        return ((to_double (model.yearCount())) * (CalendarDemo.yearRowH()))
    }

    fn clampYearScroll:double (v:double) {
        def max:double ((this.yearContentH()) - (CalendarDemo.yearPanelH()))
        if (max < 0.0) {
            max = 0.0
        }
        if (v < 0.0) {
            return 0.0
        }
        if (v > max) {
            return max
        }
        return v
    }

    ; The wheel. The page hands every demo `scroll(dy)` and takes a `false`
    ; as "not mine, let the page scroll" — so this must not claim the wheel
    ; while the panel is shut.
    fn scrollBy:boolean (dy:double) {
        if (model.yearPanelOpen == false) {
            return false
        }
        def next:double (this.clampYearScroll((yearScroll + dy)))
        if (next == yearScroll) {
            return false
        }
        yearScroll = next
        this.rebuild()
        return true
    }

    fn yearPanel:EVGElement () {
        def panel (tree Cal (YearPanel (props (id (model.yearPanelTid())))))
        panel.scrollTop = yearScroll
        def i:int 0
        while (i < (model.yearCount())) {
            def y:int (model.yearAt(i))
            def label:string (to_string y)
            def opt (tree Cal (YearOpt (props (id (model.yearOptTid(y))) (a11yLabel label))))
            if (y == model.viewYear) {
                opt = (tree Cal (YearOptOn (props (id (model.yearOptTid(y))) (a11yLabel label))))
                opt.a11ySelected = (EVGA11yTri.yes())
                opt.addChild((tree Cal (YearOptTxOn label)))
            } {
                opt.addChild((tree Cal (YearOptTx label)))
            }
            panel.addChild(opt)
            i = (i + 1)
        }
        return panel
    }

    fn page:EVGElement () {
        def page (tree Cal (Page))

        def field (tree Cal (Field (FieldLbl "Date")))
        def chosen:string (this.fieldText())
        def box (tree Cal (Box (props (id "cd-box") (a11yLabel "Date"))))
        if (chosen == "") {
            ; A placeholder is not a value and must not read as one: it is
            ; drawn pale, and the box's accessible name stays "Date" so a
            ; reader is never told the hint is the answer.
            box.addChild((tree Cal (BoxHint "Pick a day")))
        } {
            box.addChild((tree Cal (BoxText chosen)))
        }
        field.addChild(box)
        page.addChild(field)

        def card (tree Cal (Card))
        def nav (tree Cal
            (Nav
                ; A real typographic chevron. This said ASCII was
                ; deliberate, because the atlas supposedly stops at code 126
                ; and a chevron drew as an empty box. That reason was WRONG:
                ; re-measured by rendering the characters, the painter draws
                ; U+2039, U+203A, the euro sign, an a-umlaut and colour emoji
                ; perfectly well. The empty box came from the SOURCE — the
                ; file contained the six characters backslash-u-2039, because
                ; Ranger does not interpret \u escapes and the tool that
                ; wrote the line did not either.
                ;
                ; What IS true, and is the narrower thing: the measurer falls
                ; back to half an em for anything outside 32-126, so a RUN
                ; containing non-ASCII is spaced wrong. One glyph alone in a
                ; centred box is unaffected, which is what this is.
                (NavBtn (props (id "cal-prev") (a11yLabel "Go to the Previous Month"))
                    (NavGlyph "‹"))
                (Caption (props (id "cal-caption"))
                    (MonthTxt (props (id "cal-month")) (UiDate.monthName(model.viewMonth))))
                (NavBtn (props (id "cal-next") (a11yLabel "Go to the Next Month"))
                    (NavGlyph "›"))))
        ; The year goes INSIDE the caption, beside the month. Not after it:
        ; the caption is the live region a reader hears when the month
        ; changes, and a year drawn outside it would leave the announcement
        ; saying "May" with no year in it.
        def cap:EVGElement (CalendarDemo.byId(nav "cal-caption"))
        ; THE MONTH BOX IS AS WIDE AS THE MONTH.
        ;
        ; It was a fixed 96px with `text-align: right`, so "May" — about 27px
        ; of ink — was drawn at the right end of a box that began 69px
        ; earlier. The caption centres its content, and it was centring a box
        ; that was mostly empty on its left: every BOX lined up on the grid's
        ; centre at 163 while the ink people actually see sat near 197.
        ; Reported as the selector not being centred, and it was not.
        ;
        ; Measured rather than guessed, the way the message demo sizes a name
        ; in its typing marker: a month is as wide as its own name, and
        ; September is not May.
        def monthEl:EVGElement (CalendarDemo.byId(cap "cal-month"))
        UiTree.inline(monthEl "width" (CalendarDemo.px((this.captionTextWidth((UiDate.monthName(model.viewMonth)))))))
        ; A named intermediate rather than `(YearTxt (to_string ...))`: a
        ; computed child in text position is read as a TAG NAME by the tree
        ; factory, and the error says `to_string is not a tag of Cal`.
        def yearNum:string (to_string model.viewYear)
        def yearBtn (tree Cal
            (YearBtn (props (id (model.yearTid()))
                (a11yLabel (this.yearBtnLabel())))
                (YearTxt yearNum)))
        yearBtn.a11yExpanded = (EVGA11yTri.no())
        cap.addChild(yearBtn)
        ; The panel is the anchor's SIBLING, not its child. As a child it
        ; placed at the anchor's own origin and drew over the year instead of
        ; under it — the overlay layer positions against the PRECEDING
        ; anchor, which is how the profile demo's select list is built too.
        if model.yearPanelOpen {
            yearBtn.a11yExpanded = (EVGA11yTri.yes())
            yearBtn.isOverlayAnchor = true
            cap.addChild((this.yearPanel()))
        }
        card.addChild(nav)

        def grid (tree Cal
            (Grid (props (id "cal-grid") (a11yLabel (model.monthLabel())))))

        def head (tree Cal (HeadRow))
        def c:int 0
        while (c < 7) {
            head.addChild((tree Cal (Weekday (UiDate.dayAbbr(c)))))
            c = (c + 1)
        }
        grid.addChild(head)

        def start:int (model.gridStart())
        def weeks:int (model.weekCount())
        def r:int 0
        while (r < weeks) {
            def week (tree Cal (Week))
            def i:int 0
            while (i < 7) {
                def day:int ((start + (r * 7)) + i)
                def p:[int] ([] _:int ( 0 0 0 ))
                UiDate.fromDays(day p)
                ; The label is the CONTROLLER's, affixes and all — "Today, "
                ; and ", selected" are how the reference announces state, and
                ; a second opinion about it here would be a second source of
                ; truth for what a reader hears.
                def cell (tree Cal
                    (Day (props (id (model.dayTid(day)))
                                (className (this.dayClass(day)))
                                (a11yLabel (model.dayLabel(day))))
                        (DayNum (props (className (this.numClass(day))))
                                ("" + (itemAt p 2)))))
                week.addChild(cell)
                i = (i + 1)
            }
            grid.addChild(week)
            r = (r + 1)
        }
        card.addChild(grid)
        page.addChild(card)

        def note:string ("Arrow keys move a day, Home and End move within the week, "
            + "PageUp and PageDown move a month. Enter chooses; Enter on the "
            + "chosen day clears it.")
        page.addChild((this.modeRow()))
        page.addChild((tree Cal (Note note)))
        return page
    }

    ; --- events --------------------------------------------------------------

    fn press:boolean (target:string) {
        ; The mode switcher first: the group decides, and the calendar is told
        ; what it decided. Changing mode clears the selection, which is
        ; CalendarCtl's rule — a day chosen in one mode is not a range in
        ; another.
        def i:int 0
        def vals:[string] ([] _:string ( "single" "multiple" "range" ))
        while (i < 3) {
            def v:string (itemAt vals i)
            if (target == (modes.itemTid(v))) {
                modes.selectValue(v)
                model.setMode(v)
                focused = target
                this.rebuild()
                return true
            }
            i = (i + 1)
        }
        def wasOpen:boolean model.yearPanelOpen
        model.activate(target)
        ; Opening the panel parks it on the year you are on. Without this it
        ; opens at the top — which with `reverseYears` is a year twenty out,
        ; and the control that exists to save you scrolling starts by making
        ; you scroll.
        if (model.yearPanelOpen) {
            if (wasOpen == false) {
                this.centreOnCurrentYear()
            }
        }
        focused = target
        this.rebuild()
        return true
    }

    fn key:boolean (k:string) {
        ; A key belongs to the day that has focus. Nothing else on this page
        ; takes one, so an unfocused page arms the resting day rather than
        ; swallowing the press — otherwise the first arrow key does nothing
        ; and the second one works, which reads as a dropped keystroke.
        def target:string focused
        if (target == "") {
            target = (model.dayTid((model.currentFocusDay())))
        }
        def landed:string (model.keyDown(target k))
        if (landed != "") {
            focused = landed
        }
        this.rebuild()
        return true
    }

    fn setHover:void (id:string) {
        hovered = id
    }

    fn setPressed:void (id:string) {
        pressed = id
    }

    fn setFocus:void (id:string) {
        focused = id
    }

    ; A press or a key changes the DATA, so the tree is rebuilt rather than
    ; reconciled. The kept layout survives: a freshly built tree has no element
    ; the sheet has ever written to, so it reports itself layout-dirty on the
    ; first pass and lays out without being asked to — see `laidOut`.
    fn rebuild:void () {
        root = (this.page())
    }

    fn markStates:void (el:EVGElement) {
        el.isHovered = false
        el.isPressed = false
        el.isFocused = false
        if ((strlen el.id) > 0) {
            if (el.id == hovered) {
                el.isHovered = true
            }
            if (el.id == pressed) {
                el.isPressed = true
            }
            if (el.id == focused) {
                el.isFocused = true
            }
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            this.markStates((el.getChild(i)))
            i = (i + 1)
        }
    }

    fn laidOut:EVGLayout () {
        def r:EVGElement (unwrap root)
        def s:EVGStyleSheet (unwrap sheet)
        s.setViewport(pageW pageH false)
        this.markStates(r)
        s.applyTree(r "")
        def t:EVGTransition transitions
        t.reconcileTree(r)
        if layout {
            def lay:EVGLayout (unwrap layout)
            if ((s.layoutClean()) == false) {
                lay.layout(r)
            }
            return lay
        }
        def fresh (new EVGLayout())
        fresh.setPageSize(pageW pageH)
        layout = fresh
        fresh.layout(r)
        return fresh
    }

    fn displayListJson:string () {
        def lay:EVGLayout (this.laidOut())
        def r:EVGElement (unwrap root)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(r)
        return (dl.toJson())
    }

    fn hitId:string (px:double py:double) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def hit (new EVGHitTest())
        return (hit.idAt(r px py))
    }

    fn a11yJson:string (generation:int focusId:string) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Calendar demo" generation focusId))
        return (t.toJson())
    }

    fn a11yProblems:[string] () {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Calendar demo" 1 ""))
        return (t.lint())
    }

    fn styleErrorCount:int () {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getErrorCount())
    }

    fn styleErrorAt:string (i:int) {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getError(i))
    }

    fn tick:boolean (dtMs:double) {
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        t.advanceTree(r dtMs)
        return (t.busy(r))
    }

    fn busyNow:boolean () {
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        return (t.busy(r))
    }

    fn heightPx:double () {
        return pageH
    }
}

; =============================================================================
; MenubarDemo — the Radix menubar example, written with Ranger tree literals
; =============================================================================
; The reference is https://www.radix-ui.com/primitives/docs/components/menubar,
; roughly 200 lines of JSX. This is the same menu as a Ranger tree literal over
; EVG elements: four menus, submenus, checkbox items, a radio group, separators,
; disabled items and right-hand shortcut slots.
;
; It is a structure, not a component library — there is no keyboard handling and
; no focus here. Those belong to a MenubarCtl in gallery/ui/src, which does not
; exist yet; this is what its `build()` would be able to look like.
;
; What the demo settled about the syntax:
;
;   * a tag carries defaults, so the factory says once what a Trigger IS and no
;     call site repeats it. That option exists because writing this without it
;     read badly.
;   * a component is a function. `item`, `checkItem` and `radioItem` are
;     ordinary Ranger functions returning EVGElement, spliced in with `(child …)`.
;   * a loop is an ordinary loop; there is no list form and none was wanted.
;
; And what the OVERLAY work settled: a dropdown is not composed by hand any
; more. `Content` is still the `Menu`'s child — ownership, events and the
; accessibility walk all still follow the tree — but the factory marks it an
; overlay surface, and EVG takes it out of its parent's flow, anchors it to the
; Trigger beside it and paints it above the page. A submenu is a Menu like any
; other, so there is no submenu case anywhere in this file.
; =============================================================================

Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGUnit.rgr"
Import "../../evg/EVGLayout.rgr"
Import "../../evg/EVGDisplayList.rgr"
Import "../../evg/EVGStyleSheet.rgr"

; -----------------------------------------------------------------------------
; The factory. Every tag is an EVGElement — EVG has one element type and the
; tags carry the INTENT, which is what the stylesheet and now the overlay pass
; match on. A different factory over the same tags could build something else.
; -----------------------------------------------------------------------------

treefactory Menubar {
    child addChild
    text  textContent

    tag Bar        EVGElement (props (className "mb-root"))
    tag Menu       EVGElement (props (className "mb-menu"))
    ; A trigger is what its menu's surface hangs off. The surface finds it by
    ; this flag among its own siblings — nothing joins the two by hand.
    tag Trigger    EVGElement (props (className "mb-trigger") (elementType 1) (isOverlayAnchor true))
    ; The surface. Still the Menu's child, and out of the Menu's flow: anchored
    ; under the trigger and painted above the page.
    tag Content    EVGElement (props (className "mb-content") (isOverlay true) (overlaySide "bottom") (overlayAlign "start"))
    ; A submenu opens to the side of the row that owns it.
    tag SubContent EVGElement (props (className "mb-content") (isOverlay true) (overlaySide "right") (overlayAlign "start"))
    tag Row        EVGElement (props (className "mb-item"))
    ; A row that opens a submenu is itself an anchor.
    tag SubRow     EVGElement (props (className "mb-item mb-item-sub") (isOverlayAnchor true))
    tag Label      EVGElement (props (className "mb-label") (elementType 1))
    tag Shortcut   EVGElement (props (className "mb-shortcut") (elementType 1))
    tag Indicator  EVGElement (props (className "mb-indicator") (elementType 1))
    tag Separator  EVGElement (props (className "mb-separator"))
}

class MenubarDemo {

    ; --- components: ordinary functions that return a node ---------------------

    ; "New Tab            ⌘ T"
    sfn item:EVGElement (label:string shortcut:string) {
        return (tree Menubar
            (Row
                (Label label)
                (Shortcut shortcut)))
    }

    ; A disabled row greys its label. The extra class is written here rather
    ; than matched with a descendant selector, because EVGStyleSheet matches one
    ; class token per selector and a compound rule would silently do nothing.
    sfn disabledItem:EVGElement (label:string shortcut:string) {
        return (tree Menubar
            (Row (props (className "mb-item mb-item-disabled"))
                (Label (props (className "mb-label mb-label-disabled")) label)
                (Shortcut shortcut)))
    }

    ; The row a submenu hangs off. It carries the chevron in the same
    ; right-hand slot the shortcuts use, which is why there is no separate
    ; SubTrigger tag.
    sfn subRow:EVGElement (label:string) {
        return (tree Menubar
            (SubRow
                (Label label)
                (Shortcut ">")))
    }

    ; The indicator is always present and always the same width, so the labels
    ; of checked and unchecked items line up. Radix does this with an `inset`
    ; class; here the glyph is simply empty when the item is off.
    sfn checkItem:EVGElement (label:string on:boolean) {
        def glyph:string " "
        if on {
            glyph = "✓"
        }
        return (tree Menubar
            (Row (props (className "mb-item mb-item-inset"))
                (Indicator glyph)
                (Label (props (className "mb-label mb-label-inset")) label)))
    }

    sfn radioItem:EVGElement (label:string on:boolean) {
        def glyph:string " "
        if on {
            glyph = "●"
        }
        return (tree Menubar
            (Row (props (className "mb-item mb-item-inset"))
                (Indicator glyph)
                (Label (props (className "mb-label mb-label-inset")) label)))
    }

    ; --- submenus --------------------------------------------------------------
    ; A submenu is a Menu: an anchor row, and a surface beside it. Its surface
    ; finds that row exactly the way a top-level surface finds its trigger, so
    ; nothing here knows it is nested.

    sfn shareMenu:EVGElement (open:boolean) {
        if (open == false) {
            return (MenubarDemo.subRow("Share"))
        }
        return (tree Menubar
            (Menu (props (id "menu-share"))
                (child (MenubarDemo.subRow("Share")))
                (SubContent (props (id "menu-share-content"))
                    (child (MenubarDemo.item("Email Link" "")))
                    (child (MenubarDemo.item("Messages" "")))
                    (child (MenubarDemo.item("Notes" ""))))))
    }

    sfn findMenu:EVGElement (open:boolean) {
        if (open == false) {
            return (MenubarDemo.subRow("Find"))
        }
        return (tree Menubar
            (Menu (props (id "menu-find"))
                (child (MenubarDemo.subRow("Find")))
                (SubContent (props (id "menu-find-content"))
                    (child (MenubarDemo.item("Search the web…" "")))
                    (Separator)
                    (child (MenubarDemo.item("Find…" "")))
                    (child (MenubarDemo.item("Find Next" "")))
                    (child (MenubarDemo.item("Find Previous" ""))))))
    }

    ; --- the four menus --------------------------------------------------------
    ; Each is a Trigger, plus a Content when it is the open one. A closed menu is
    ; its trigger and nothing else, which is what the reference does too: the
    ; surface is not in the tree at all until the menu opens.

    sfn trigger:EVGElement (label:string open:boolean) {
        if open {
            return (tree Menubar
                (Trigger (props (className "mb-trigger mb-trigger-open")) label))
        }
        return (tree Menubar (Trigger label))
    }

    sfn fileMenu:EVGElement (open:boolean submenu:boolean) {
        if (open == false) {
            return (tree Menubar
                (Menu (props (id "menu-file"))
                    (child (MenubarDemo.trigger("File" false)))))
        }
        return (tree Menubar
            (Menu (props (id "menu-file"))
                (child (MenubarDemo.trigger("File" true)))
                (Content (props (id "menu-file-content"))
                    (child (MenubarDemo.item("New Tab" "⌘ T")))
                    (child (MenubarDemo.item("New Window" "⌘ N")))
                    (child (MenubarDemo.disabledItem("New Incognito Window" "")))
                    (Separator)
                    (child (MenubarDemo.shareMenu(submenu)))
                    (Separator)
                    (child (MenubarDemo.item("Print…" "⌘ P"))))))
    }

    sfn editMenu:EVGElement (open:boolean submenu:boolean) {
        if (open == false) {
            return (tree Menubar
                (Menu (props (id "menu-edit"))
                    (child (MenubarDemo.trigger("Edit" false)))))
        }
        return (tree Menubar
            (Menu (props (id "menu-edit"))
                (child (MenubarDemo.trigger("Edit" true)))
                (Content (props (id "menu-edit-content"))
                    (child (MenubarDemo.item("Undo" "⌘ Z")))
                    (child (MenubarDemo.item("Redo" "⇧ ⌘ Z")))
                    (Separator)
                    (child (MenubarDemo.findMenu(submenu)))
                    (Separator)
                    (child (MenubarDemo.item("Cut" "")))
                    (child (MenubarDemo.item("Copy" "")))
                    (child (MenubarDemo.item("Paste" ""))))))
    }

    ; The View menu is where the reference maps over an array, and the point of
    ; this one is that a loop is an ordinary loop: build the children, then hand
    ; them to the parent.
    sfn viewMenu:EVGElement (open:boolean checked:[string]) {
        if (open == false) {
            return (tree Menubar
                (Menu (props (id "menu-view"))
                    (child (MenubarDemo.trigger("View" false)))))
        }
        def content (tree Menubar (Content (props (id "menu-view-content"))))
        def labels:[string]
        push labels "Always Show Bookmarks Bar"
        push labels "Always Show Full URLs"
        def i:int 0
        while (i < (array_length labels)) {
            def label:string (itemAt labels i)
            def on:boolean false
            def j:int 0
            while (j < (array_length checked)) {
                if ((itemAt checked j) == label) {
                    on = true
                }
                j = (j + 1)
            }
            content.addChild((MenubarDemo.checkItem(label on)))
            i = (i + 1)
        }
        content.addChild((tree Menubar (Separator)))
        content.addChild((MenubarDemo.item("Reload" "⌘ R")))
        content.addChild((MenubarDemo.disabledItem("Force Reload" "⇧ ⌘ R")))
        content.addChild((tree Menubar (Separator)))
        content.addChild((MenubarDemo.item("Toggle Fullscreen" "")))
        content.addChild((tree Menubar (Separator)))
        content.addChild((MenubarDemo.item("Hide Sidebar" "")))
        return (tree Menubar
            (Menu (props (id "menu-view"))
                (child (MenubarDemo.trigger("View" true)))
                (child content)))
    }

    sfn profilesMenu:EVGElement (open:boolean selected:string) {
        if (open == false) {
            return (tree Menubar
                (Menu (props (id "menu-profiles"))
                    (child (MenubarDemo.trigger("Profiles" false)))))
        }
        def content (tree Menubar (Content (props (id "menu-profiles-content"))))
        def names:[string]
        push names "Andy"
        push names "Benoît"
        push names "Luis"
        def i:int 0
        while (i < (array_length names)) {
            def name:string (itemAt names i)
            content.addChild((MenubarDemo.radioItem(name (name == selected))))
            i = (i + 1)
        }
        content.addChild((tree Menubar (Separator)))
        content.addChild((MenubarDemo.item("Edit…" "")))
        content.addChild((tree Menubar (Separator)))
        content.addChild((MenubarDemo.item("Add Profile…" "")))
        return (tree Menubar
            (Menu (props (id "menu-profiles"))
                (child (MenubarDemo.trigger("Profiles" true)))
                (child content)))
    }

    ; --- the whole thing -------------------------------------------------------
    ; One structure, one state. There is no separate "picture" any more: what a
    ; screen shows and what `describe()` prints are the same tree, because the
    ; surfaces place themselves.

    sfn bar:EVGElement (checked:[string] profile:string openMenu:string submenu:boolean) {
        return (tree Menubar
            (Bar (props (id "menubar"))
                (child (MenubarDemo.fileMenu((openMenu == "File") submenu)))
                (child (MenubarDemo.editMenu((openMenu == "Edit") submenu)))
                (child (MenubarDemo.viewMenu((openMenu == "View") checked)))
                (child (MenubarDemo.profilesMenu((openMenu == "Profiles") profile)))))
    }

    sfn page:EVGElement (checked:[string] profile:string openMenu:string submenu:boolean) {
        return (tree Menubar
            (Bar (props (id "page") (className "mb-page"))
                (child (MenubarDemo.bar(checked profile openMenu submenu)))))
    }

    sfn displayListJson:string (css:string checked:[string] profile:string openMenu:string submenu:boolean) {
        def root:EVGElement (MenubarDemo.page(checked profile openMenu submenu))
        def sheet (new EVGStyleSheet())
        sheet.parse(css)
        sheet.setViewport(1240.0 560.0 false)
        sheet.applyTree(root "")
        def lay (new EVGLayout())
        lay.setPageSize(1240.0 560.0)
        lay.layout(root)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(root)
        return (dl.toJson())
    }

    ; Overlay surfaces the layout could not place. An unanchored surface would
    ; otherwise sit in the corner and read as a styling mistake.
    sfn overlayErrors:[string] (css:string checked:[string] profile:string openMenu:string submenu:boolean) {
        def root:EVGElement (MenubarDemo.page(checked profile openMenu submenu))
        def sheet (new EVGStyleSheet())
        sheet.parse(css)
        sheet.setViewport(1240.0 560.0 false)
        sheet.applyTree(root "")
        def lay (new EVGLayout())
        lay.setPageSize(1240.0 560.0)
        lay.layout(root)
        return (lay.getOverlayErrors())
    }

    sfn styleErrors:int (css:string) {
        def sheet (new EVGStyleSheet())
        sheet.parse(css)
        return (sheet.getErrorCount())
    }

    ; A flat description of what was built, so a test can assert on the shape
    ; without a browser.
    sfn describe:string (el:EVGElement depth:int) {
        def pad:string ""
        def i:int 0
        while (i < depth) {
            pad = pad + "  "
            i = (i + 1)
        }
        def line:string (pad + el.className)
        if ((strlen el.textContent) > 0) {
            line = ((line + " ") + el.textContent)
        }
        def out:string (line + "\n")
        def j:int 0
        while (j < (array_length el.children)) {
            out = out + (MenubarDemo.describe((itemAt el.children j) (depth + 1)))
            j = (j + 1)
        }
        return out
    }

    ; A closed menu has no surface in the tree, so one dump cannot show the
    ; checkbox and radio rows at the same time as the File menu. Three dumps,
    ; one per open menu — which is also what a user sees, one at a time.
    sfn main:void () {
        def checked:[string]
        push checked "Always Show Full URLs"
        print "--- File open, with the Share submenu ---"
        print (MenubarDemo.describe((MenubarDemo.page(checked "Luis" "File" true)) 0))
        print "--- View open ---"
        print (MenubarDemo.describe((MenubarDemo.page(checked "Luis" "View" false)) 0))
        print "--- Profiles open ---"
        print (MenubarDemo.describe((MenubarDemo.page(checked "Luis" "Profiles" false)) 0))
    }
}

; =============================================================================
; MenubarDemo — the Radix menubar example, written with Ranger tree literals
; =============================================================================
; The reference is https://www.radix-ui.com/primitives/docs/components/menubar,
; roughly 200 lines of JSX. This is the same menu as a Ranger tree literal over
; EVG elements: four menus, submenus, checkbox items, a radio group, separators,
; disabled items and right-hand shortcut slots.
;
; It is a structure, not a component library — there is no keyboard handling and
; no focus here. Those belong to a MenubarCtl in gallery/ui/src, which does not
; exist yet; this is what its `build()` would be able to look like.
;
; What the demo settled about the syntax:
;
;   * a tag carries defaults, so the factory says once what a Trigger IS and no
;     call site repeats it. That option exists because writing this without it
;     read badly.
;   * a component is a function. `item`, `checkItem` and `radioItem` are
;     ordinary Ranger functions returning EVGElement, spliced in with `(child …)`.
;   * a loop is an ordinary loop; there is no list form and none was wanted.
;
; And what the OVERLAY work settled: a dropdown is not composed by hand any
; more. `Content` is still the `Menu`'s child — ownership, events and the
; accessibility walk all still follow the tree — but the factory marks it an
; overlay surface, and EVG takes it out of its parent's flow, anchors it to the
; Trigger beside it and paints it above the page. A submenu is a Menu like any
; other, so there is no submenu case anywhere in this file.
; =============================================================================

Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGUnit.rgr"
Import "../../evg/EVGLayout.rgr"
Import "../../evg/EVGDisplayList.rgr"
Import "../../evg/EVGStyleSheet.rgr"
Import "../../evg/EVGA11yTree.rgr"
Import "../../evg/EVGA11yFromTree.rgr"
Import "../../evg/EVGHitTest.rgr"
; Not used by the builders below — imported so the page can drive a
; transition over the tree they produce. Hover is a presentational state and
; belongs to the stylesheet; the demo just builds boxes with class names.
Import "../../evg/EVGTransition.rgr"

; -----------------------------------------------------------------------------
; The factory. Every tag is an EVGElement — EVG has one element type and the
; tags carry the INTENT, which is what the stylesheet and now the overlay pass
; match on. A different factory over the same tags could build something else.
; -----------------------------------------------------------------------------

treefactory Menubar {
    child addChild
    text  textContent

    tag Bar        EVGElement (props (className "mb-root"))
    tag Menu       EVGElement (props (className "mb-menu"))
    ; A trigger is what its menu's surface hangs off. The surface finds it by
    ; this flag among its own siblings — nothing joins the two by hand.
    ;
    ; It also carries the ROLE. A canvas hands a screen reader one empty
    ; graphic, so the meaning has to be published beside the picture — and the
    ; only description that cannot drift out of step with the picture is the
    ; one on the element that draws it. `EVGA11yFromTree` walks this same tree.
    tag Trigger    EVGElement (props (className "mb-trigger") (elementType 1) (isOverlayAnchor true) (role "menuitem") (a11yFocusable true))
    ; The surface. Still the Menu's child, and out of the Menu's flow: anchored
    ; under the trigger and painted above the page.
    tag Content    EVGElement (props (className "mb-content") (isOverlay true) (overlaySide "bottom") (overlayAlign "start") (role "menu"))
    ; A submenu opens to the side of the row that owns it.
    tag SubContent EVGElement (props (className "mb-content") (isOverlay true) (overlaySide "right") (overlayAlign "start") (role "menu"))
    tag Row        EVGElement (props (className "mb-item") (role "menuitem") (a11yFocusable true))
    ; A row that opens a submenu is itself an anchor.
    tag SubRow     EVGElement (props (className "mb-item mb-item-sub") (isOverlayAnchor true) (role "menuitem") (a11yFocusable true))
    ; A row that carries a state is a different ARIA role, not a menuitem with
    ; a state on it: a reader announces the two differently.
    tag CheckRow   EVGElement (props (className "mb-item mb-item-inset") (role "menuitemcheckbox") (a11yFocusable true))
    tag RadioRow   EVGElement (props (className "mb-item mb-item-inset") (role "menuitemradio") (a11yFocusable true))
    ; No roles below: these are what the row is NAMED by. `EVGA11yFromTree`
    ; collects the text of the roleless descendants, which is how "New Tab ⌘ T"
    ; arrives as one announcement instead of three nodes.
    tag Label      EVGElement (props (className "mb-label") (elementType 1))
    tag Shortcut   EVGElement (props (className "mb-shortcut") (elementType 1))
    tag Indicator  EVGElement (props (className "mb-indicator") (elementType 1))
    tag Separator  EVGElement (props (className "mb-separator") (role "separator"))
}

class MenubarDemo {

    ; --- components: ordinary functions that return a node ---------------------

    ; "New Tab            ⌘ T"
    ; The id is derived from the label rather than counted, because it is what
    ; a click and a screen reader's cursor both land on: a row that is numbered
    ; changes id when a row above it appears, and the reader loses its place.
    sfn rowId:string (label:string) {
        return ("row-" + label)
    }

    sfn item:EVGElement (label:string shortcut:string) {
        return (tree Menubar
            (Row (props (id (MenubarDemo.rowId(label))))
                (Label label)
                (Shortcut shortcut)))
    }

    ; A disabled row greys its label. The extra class is written here rather
    ; than matched with a descendant selector, because EVGStyleSheet matches one
    ; class token per selector and a compound rule would silently do nothing.
    sfn disabledItem:EVGElement (label:string shortcut:string) {
        return (tree Menubar
            (Row (props (className "mb-item mb-item-disabled") (id (MenubarDemo.rowId(label))) (a11yDisabled true))
                (Label (props (className "mb-label mb-label-disabled")) label)
                (Shortcut shortcut)))
    }

    ; The row a submenu hangs off. It carries the chevron in the same
    ; right-hand slot the shortcuts use, which is why there is no separate
    ; SubTrigger tag.
    ; `open` is the submenu's state, and it is on the ROW rather than on the
    ; surface: aria-expanded belongs to the thing you activate, not to the
    ; thing that appears.
    sfn subRow:EVGElement (label:string open:boolean) {
        def state:int (EVGA11yTri.no())
        if open {
            state = (EVGA11yTri.yes())
        }
        return (tree Menubar
            (SubRow (props (id (MenubarDemo.rowId(label))) (a11yExpanded state))
                (Label label)
                ; Decoration, and marked as such. The chevron says "there is
                ; more this way" to the eye; `aria-expanded` on the row already
                ; says it to a reader, and without `aria-hidden` here the row
                ; announces as "Share greater-than".
                (Shortcut (props (a11yHidden true)) ">")))
    }

    ; The indicator is always present and always the same width, so the labels
    ; of checked and unchecked items line up. Radix does this with an `inset`
    ; class; here the glyph is simply empty when the item is off.
    sfn checkItem:EVGElement (label:string on:boolean) {
        def glyph:string " "
        def state:int (EVGA11yTri.no())
        if on {
            glyph = "✓"
            state = (EVGA11yTri.yes())
        }
        return (tree Menubar
            (CheckRow (props (id (MenubarDemo.rowId(label))) (a11yChecked state))
                (Indicator glyph)
                (Label (props (className "mb-label mb-label-inset")) label)))
    }

    sfn radioItem:EVGElement (label:string on:boolean) {
        def glyph:string " "
        def state:int (EVGA11yTri.no())
        if on {
            glyph = "●"
            state = (EVGA11yTri.yes())
        }
        return (tree Menubar
            (RadioRow (props (id (MenubarDemo.rowId(label))) (a11yChecked state))
                (Indicator glyph)
                (Label (props (className "mb-label mb-label-inset")) label)))
    }

    ; --- submenus --------------------------------------------------------------
    ; A submenu is a Menu: an anchor row, and a surface beside it. Its surface
    ; finds that row exactly the way a top-level surface finds its trigger, so
    ; nothing here knows it is nested.

    sfn shareMenu:EVGElement (open:boolean) {
        if (open == false) {
            return (MenubarDemo.subRow("Share" false))
        }
        return (tree Menubar
            (Menu (props (id "menu-share"))
                (child (MenubarDemo.subRow("Share" true)))
                (SubContent (props (id "menu-share-content") (a11yLabel "Share"))
                    (child (MenubarDemo.item("Email Link" "")))
                    (child (MenubarDemo.item("Messages" "")))
                    (child (MenubarDemo.item("Notes" ""))))))
    }

    sfn findMenu:EVGElement (open:boolean) {
        if (open == false) {
            return (MenubarDemo.subRow("Find" false))
        }
        return (tree Menubar
            (Menu (props (id "menu-find"))
                (child (MenubarDemo.subRow("Find" true)))
                (SubContent (props (id "menu-find-content") (a11yLabel "Find"))
                    (child (MenubarDemo.item("Search the web…" "")))
                    (Separator)
                    (child (MenubarDemo.item("Find…" "")))
                    (child (MenubarDemo.item("Find Next" "")))
                    (child (MenubarDemo.item("Find Previous" ""))))))
    }

    ; --- the four menus --------------------------------------------------------
    ; Each is a Trigger, plus a Content when it is the open one. A closed menu is
    ; its trigger and nothing else, which is what the reference does too: the
    ; surface is not in the tree at all until the menu opens.

    sfn triggerId:string (label:string) {
        return ("trigger-" + label)
    }

    sfn trigger:EVGElement (label:string open:boolean) {
        if open {
            return (tree Menubar
                (Trigger (props (className "mb-trigger mb-trigger-open") (id (MenubarDemo.triggerId(label))) (a11yExpanded (EVGA11yTri.yes()))) label))
        }
        return (tree Menubar
            (Trigger (props (id (MenubarDemo.triggerId(label))) (a11yExpanded (EVGA11yTri.no()))) label))
    }

    sfn fileMenu:EVGElement (open:boolean submenu:boolean) {
        if (open == false) {
            return (tree Menubar
                (Menu (props (id "menu-file"))
                    (child (MenubarDemo.trigger("File" false)))))
        }
        return (tree Menubar
            (Menu (props (id "menu-file"))
                (child (MenubarDemo.trigger("File" true)))
                (Content (props (id "menu-file-content") (a11yLabel "File"))
                    (child (MenubarDemo.item("New Tab" "⌘ T")))
                    (child (MenubarDemo.item("New Window" "⌘ N")))
                    (child (MenubarDemo.disabledItem("New Incognito Window" "")))
                    (Separator)
                    (child (MenubarDemo.shareMenu(submenu)))
                    (Separator)
                    (child (MenubarDemo.item("Print…" "⌘ P"))))))
    }

    sfn editMenu:EVGElement (open:boolean submenu:boolean) {
        if (open == false) {
            return (tree Menubar
                (Menu (props (id "menu-edit"))
                    (child (MenubarDemo.trigger("Edit" false)))))
        }
        return (tree Menubar
            (Menu (props (id "menu-edit"))
                (child (MenubarDemo.trigger("Edit" true)))
                (Content (props (id "menu-edit-content") (a11yLabel "Edit"))
                    (child (MenubarDemo.item("Undo" "⌘ Z")))
                    (child (MenubarDemo.item("Redo" "⇧ ⌘ Z")))
                    (Separator)
                    (child (MenubarDemo.findMenu(submenu)))
                    (Separator)
                    (child (MenubarDemo.item("Cut" "")))
                    (child (MenubarDemo.item("Copy" "")))
                    (child (MenubarDemo.item("Paste" ""))))))
    }

    ; The View menu is where the reference maps over an array, and the point of
    ; this one is that a loop is an ordinary loop: build the children, then hand
    ; them to the parent.
    sfn viewMenu:EVGElement (open:boolean checked:[string]) {
        if (open == false) {
            return (tree Menubar
                (Menu (props (id "menu-view"))
                    (child (MenubarDemo.trigger("View" false)))))
        }
        def content (tree Menubar (Content (props (id "menu-view-content") (a11yLabel "View"))))
        def labels:[string]
        push labels "Always Show Bookmarks Bar"
        push labels "Always Show Full URLs"
        def i:int 0
        while (i < (array_length labels)) {
            def label:string (itemAt labels i)
            def on:boolean false
            def j:int 0
            while (j < (array_length checked)) {
                if ((itemAt checked j) == label) {
                    on = true
                }
                j = (j + 1)
            }
            content.addChild((MenubarDemo.checkItem(label on)))
            i = (i + 1)
        }
        content.addChild((tree Menubar (Separator)))
        content.addChild((MenubarDemo.item("Reload" "⌘ R")))
        content.addChild((MenubarDemo.disabledItem("Force Reload" "⇧ ⌘ R")))
        content.addChild((tree Menubar (Separator)))
        content.addChild((MenubarDemo.item("Toggle Fullscreen" "")))
        content.addChild((tree Menubar (Separator)))
        content.addChild((MenubarDemo.item("Hide Sidebar" "")))
        return (tree Menubar
            (Menu (props (id "menu-view"))
                (child (MenubarDemo.trigger("View" true)))
                (child content)))
    }

    sfn profilesMenu:EVGElement (open:boolean selected:string) {
        if (open == false) {
            return (tree Menubar
                (Menu (props (id "menu-profiles"))
                    (child (MenubarDemo.trigger("Profiles" false)))))
        }
        def content (tree Menubar (Content (props (id "menu-profiles-content") (a11yLabel "Profiles"))))
        def names:[string]
        push names "Andy"
        push names "Benoît"
        push names "Luis"
        def i:int 0
        while (i < (array_length names)) {
            def name:string (itemAt names i)
            content.addChild((MenubarDemo.radioItem(name (name == selected))))
            i = (i + 1)
        }
        content.addChild((tree Menubar (Separator)))
        content.addChild((MenubarDemo.item("Edit…" "")))
        content.addChild((tree Menubar (Separator)))
        content.addChild((MenubarDemo.item("Add Profile…" "")))
        return (tree Menubar
            (Menu (props (id "menu-profiles"))
                (child (MenubarDemo.trigger("Profiles" true)))
                (child content)))
    }

    ; --- the whole thing -------------------------------------------------------
    ; One structure, one state. There is no separate "picture" any more: what a
    ; screen shows and what `describe()` prints are the same tree, because the
    ; surfaces place themselves.

    sfn bar:EVGElement (checked:[string] profile:string openMenu:string submenu:boolean) {
        return (tree Menubar
            (Bar (props (id "menubar") (role "menubar") (a11yLabel "Main"))
                (child (MenubarDemo.fileMenu((openMenu == "File") submenu)))
                (child (MenubarDemo.editMenu((openMenu == "Edit") submenu)))
                (child (MenubarDemo.viewMenu((openMenu == "View") checked)))
                (child (MenubarDemo.profilesMenu((openMenu == "Profiles") profile)))))
    }

    ; `atBottom` pushes the bar to the bottom edge, where the menus have no room
    ; below their triggers and the overlay pass flips them upwards. The demo
    ; does not know that happens: it moves a bar, and the placement follows.
    sfn page:EVGElement (checked:[string] profile:string openMenu:string submenu:boolean atBottom:boolean) {
        def cls:string "mb-page"
        if atBottom {
            cls = "mb-page mb-page-bottom"
        }
        return (tree Menubar
            (Bar (props (id "page") (className cls))
                (child (MenubarDemo.bar(checked profile openMenu submenu)))))
    }

    ; --- one pipeline, four answers -------------------------------------------
    ; Build, style, lay out. The pixels, the hit test and the accessible tree
    ; are then three readings of ONE laid-out tree, which is the only reason
    ; they cannot disagree: a click lands on what was drawn because it is the
    ; same rectangle, and a reader is told about the row that is actually there.

    sfn laidOut:EVGLayout (root:EVGElement css:string) {
        def sheet (new EVGStyleSheet())
        sheet.parse(css)
        sheet.setViewport(1240.0 560.0 false)
        sheet.applyTree(root "")
        def lay (new EVGLayout())
        lay.setPageSize(1240.0 560.0)
        lay.layout(root)
        return lay
    }

    sfn displayListJson:string (css:string checked:[string] profile:string openMenu:string submenu:boolean atBottom:boolean) {
        def root:EVGElement (MenubarDemo.page(checked profile openMenu submenu atBottom))
        def lay:EVGLayout (MenubarDemo.laidOut(root css))
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(root)
        return (dl.toJson())
    }

    ; What is under the pointer: the id of the topmost element there, "" for
    ; empty space. Topmost, not first in the tree — an open panel covers the
    ; trigger beside it, and a click inside the panel belongs to the panel.
    sfn hitId:string (css:string checked:[string] profile:string openMenu:string submenu:boolean atBottom:boolean px:double py:double) {
        def root:EVGElement (MenubarDemo.page(checked profile openMenu submenu atBottom))
        MenubarDemo.laidOut(root css)
        def hit (new EVGHitTest())
        return (hit.idAt(root px py))
    }

    ; The accessible tree, derived from the same elements. Nothing here
    ; describes the menu a second time: the roles are on the tags, the names
    ; are the text that was drawn, and the rectangles are where layout put
    ; them — including the surfaces, which the overlay pass moved.
    sfn a11yJson:string (css:string checked:[string] profile:string openMenu:string submenu:boolean atBottom:boolean generation:int focusId:string) {
        def root:EVGElement (MenubarDemo.page(checked profile openMenu submenu atBottom))
        MenubarDemo.laidOut(root css)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(root "Menubar demo" generation focusId))
        return (t.toJson())
    }

    ; The same tree's structural lint: a focusable row with no name, a
    ; duplicate id, a parent that is not in the tree. Invisible on screen and
    ; total for someone using a reader, so a test asserts on it.
    sfn a11yProblems:[string] (css:string checked:[string] profile:string openMenu:string submenu:boolean atBottom:boolean) {
        def root:EVGElement (MenubarDemo.page(checked profile openMenu submenu atBottom))
        MenubarDemo.laidOut(root css)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(root "Menubar demo" 1 ""))
        return (t.lint())
    }

    ; Overlay surfaces the layout could not place. An unanchored surface would
    ; otherwise sit in the corner and read as a styling mistake.
    sfn overlayErrors:[string] (css:string checked:[string] profile:string openMenu:string submenu:boolean atBottom:boolean) {
        def root:EVGElement (MenubarDemo.page(checked profile openMenu submenu atBottom))
        def lay:EVGLayout (MenubarDemo.laidOut(root css))
        return (lay.getOverlayErrors())
    }

    sfn styleErrors:int (css:string) {
        def sheet (new EVGStyleSheet())
        sheet.parse(css)
        return (sheet.getErrorCount())
    }

    ; A flat description of what was built, so a test can assert on the shape
    ; without a browser.
    sfn describe:string (el:EVGElement depth:int) {
        def pad:string ""
        def i:int 0
        while (i < depth) {
            pad = pad + "  "
            i = (i + 1)
        }
        def line:string (pad + el.className)
        if ((strlen el.textContent) > 0) {
            line = ((line + " ") + el.textContent)
        }
        def out:string (line + "\n")
        def j:int 0
        while (j < (array_length el.children)) {
            out = out + (MenubarDemo.describe((itemAt el.children j) (depth + 1)))
            j = (j + 1)
        }
        return out
    }

    ; A closed menu has no surface in the tree, so one dump cannot show the
    ; checkbox and radio rows at the same time as the File menu. Three dumps,
    ; one per open menu — which is also what a user sees, one at a time.
    sfn main:void () {
        def checked:[string]
        push checked "Always Show Full URLs"
        print "--- File open, with the Share submenu ---"
        print (MenubarDemo.describe((MenubarDemo.page(checked "Luis" "File" true false)) 0))
        print "--- View open ---"
        print (MenubarDemo.describe((MenubarDemo.page(checked "Luis" "View" false false)) 0))
        print "--- Profiles open ---"
        print (MenubarDemo.describe((MenubarDemo.page(checked "Luis" "Profiles" false false)) 0))
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; ControlsDemo — a stepper, a progress bar and a number field, working together
; =============================================================================
; Three components on one page rather than three pages, because the
; INTERACTION is the thing worth showing and three isolated panels cannot show
; it: filling in the number field completes the current step, which advances
; the progress bar and enables Next. A progress bar that never moves is a
; picture of a progress bar, and the same trap the filter bar was under.
;
; All three controllers are measured elsewhere and nothing about them is
; decided again here:
;
;   `StepperCtl`   57 assertions — `stepper_check.mjs`. No reference exists,
;                  so the flow is specified; what was measured is the DECISION
;                  between a tablist and an ordered list with aria-current.
;   `ProgressCtl`  65 assertions — `progress_check.mjs`, against BOTH Radix
;                  and Base UI, which disagree in fourteen places.
;   `NumberCtl`    58 assertions — `numberfield_check.mjs`, against Base UI.
;
; WHAT THE PAGE ADDS. Every one of those gates runs in Node with nothing drawn.
; This file is where the fractions become pixels and where a pointer has to be
; able to reach a thing — and where the three have to agree with each other,
; which no single-component gate can check.
;
; THE STEPPER IS LINEAR HERE, deliberately: it is the mode where the gate
; between steps is visible. In a free stepper every circle is clickable and
; the whole `canGoTo` rule is invisible on screen.
; =============================================================================

Import "../src/StepperCtl.rgr"
Import "../src/NumberCtl.rgr"
Import "../src/PresentationCtl.rgr"
Import "../src/UiTree.rgr"
Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGLayout.rgr"
Import "../../evg/EVGDisplayList.rgr"
Import "../../evg/EVGStyleSheet.rgr"
Import "../../evg/EVGTransition.rgr"
Import "../../evg/EVGA11yTree.rgr"
Import "../../evg/EVGA11yFromTree.rgr"
Import "../../evg/EVGHitTest.rgr"

treefactory Ctl {
    child addChild
    text  textContent

    tag Page      EVGElement (props (className "cx-page"))
    tag Title     EVGElement (props (className "cx-title") (elementType 1))

    ; The stepper strip: a LIST, not a tablist. See StepperCtl's header — a
    ; tab is freely selectable and a step is not, and the capture shows a
    ; tablist wrapping from the last item back to the first.
    tag Strip     EVGElement (props (className "cx-strip") (role "list") (a11yLabel "Checkout steps"))
    tag Step      EVGElement (props (className "cx-step") (role "listitem"))
    tag Dot       EVGElement (props (className "cx-dot"))
    tag DotTxt    EVGElement (props (className "cx-dottxt") (elementType 1) (a11yHidden true))
    tag StepLbl   EVGElement (props (className "cx-steplbl") (elementType 1) (a11yHidden true))
    tag Rail      EVGElement (props (className "cx-rail"))

    ; The progress bar. Its indicator's width is the controller's FRACTION
    ; turned into a percentage here and nowhere else.
    tag Bar       EVGElement (props (className "cx-bar") (role "progressbar"))
    tag BarFill   EVGElement (props (className "cx-barfill"))
    tag BarTxt    EVGElement (props (className "cx-bartxt") (role "status") (elementType 1))

    ; The number field. MEASURED as a TEXT input with a roledescription, not a
    ; spinbutton — see NumberCtl's header.
    tag Panel     EVGElement (props (className "cx-panel"))
    tag PanelLbl  EVGElement (props (className "cx-panellbl") (elementType 1))
    tag NumRow    EVGElement (props (className "cx-numrow"))
    tag NumBtn    EVGElement (props (className "cx-numbtn") (role "button"))
    tag NumBtnTxt EVGElement (props (className "cx-numbtntxt") (elementType 1) (a11yHidden true))
    tag NumBox    EVGElement (props (className "cx-numbox") (role "textbox") (a11yRoleDescription "Number field"))
    tag NumTxt    EVGElement (props (className "cx-numtxt") (elementType 1) (a11yHidden true))
    tag NumHint   EVGElement (props (className "cx-numhint") (elementType 1))

    tag Actions   EVGElement (props (className "cx-actions"))
    tag Btn       EVGElement (props (className "cx-btn") (role "button"))
    tag BtnTxt    EVGElement (props (className "cx-btntxt") (elementType 1) (a11yHidden true))
    tag Note      EVGElement (props (className "cx-note") (elementType 1))
}

class ControlsDemo {
    def stepper:StepperCtl (new StepperCtl())
    def bar:ProgressCtl (new ProgressCtl())
    def num:NumberCtl (new NumberCtl())
    def root@(optional):EVGElement
    def sheet@(optional):EVGStyleSheet
    def transitions:EVGTransition (new EVGTransition())
    def layout@(optional):EVGLayout
    def hovered:string ""
    def pressed:string ""
    def focused:string ""
    def pageW:double 900.0
    def pageH:double 460.0

    fn init:void (css:string) {
        def s (new EVGStyleSheet())
        s.parse(css)
        sheet = s

        stepper.tid = "cx-steps"
        stepper.name = "Checkout steps"
        stepper.linear = true
        stepper.addStep("account" "Account" "")
        stepper.addStep("address" "Address" "")
        stepper.addStep("payment" "Payment" "")
        stepper.addStep("review" "Review" "")

        bar.tid = "cx-bar"
        bar.name = "Checkout progress"
        bar.maxValue = 4.0
        bar.value = 0.0
        bar.build()

        num.tid = "cx-num"
        num.name = "Quantity"
        num.setRange(0.0 99.0)
        num.step = 1.0

        root = (this.page())
    }

    ; --- the link between the three ------------------------------------------
    ;
    ; The whole reason these are on one page. A step counts as done once the
    ; field holds a number, and the bar reads the stepper's own count — not a
    ; second tally kept here, which would be a number that could drift.

    fn syncFromField:void () {
        def s:StepItem (stepper.stepAt(stepper.current))
        s.complete = num.hasValue
        bar.value = (to_double (stepper.completedCount()))
        bar.build()
    }

    ; Each step remembers its own number, so going back shows what was typed
    ; rather than an empty box that reads as lost work.
    def saved:[string]

    fn saveField:void () {
        while ((array_length saved) <= stepper.current) {
            push saved ""
        }
        def out:[string]
        def i:int 0
        while (i < (array_length saved)) {
            if (i == stepper.current) {
                push out num.text
            } {
                push out (itemAt saved i)
            }
            i = (i + 1)
        }
        saved = out
    }

    fn loadField:void () {
        def t:string ""
        if (stepper.current < (array_length saved)) {
            t = (itemAt saved stepper.current)
        }
        num.clearValue()
        num.setText(t)
        num.blur()
    }

    fn moveTo:boolean (i:int) {
        this.saveField()
        def moved:boolean (stepper.goTo(i))
        if moved {
            this.loadField()
            this.syncFromField()
        }
        return moved
    }

    ; --- the look ------------------------------------------------------------

    fn dotClass:string (i:int) {
        return "cx-dot cx-dot-" + (stepper.stateOf(i))
    }

    fn dotTextClass:string (i:int) {
        ; Its own token: no descendant selectors, so the numeral cannot inherit
        ; the fill from the circle around it. A white-on-white "3" is what you
        ; get for assuming it can.
        return "cx-dottxt cx-dottxt-" + (stepper.stateOf(i))
    }

    fn stepLabelClass:string (i:int) {
        return "cx-steplbl cx-steplbl-" + (stepper.stateOf(i))
    }

    fn nextClass:string () {
        if (stepper.canAdvance()) {
            return "cx-btn cx-btn-primary"
        }
        return "cx-btn cx-btn-off"
    }

    ; The LABEL's token, separate from the button's, because there are no
    ; descendant selectors: a dark button with a label that inherits nothing
    ; draws black on black.
    fn nextTextClass:string () {
        if (stepper.canAdvance()) {
            return "cx-btntxt cx-btntxt-primary"
        }
        return "cx-btntxt cx-btntxt-off"
    }

    fn page:EVGElement () {
        def page (tree Ctl (Page))
        page.addChild((tree Ctl (Title "Checkout")))

        ; --- the stepper strip ------------------------------------------------
        def strip (tree Ctl (Strip (props (id "cx-steps"))))
        def n:int (stepper.count())
        def i:int 0
        while (i < n) {
            def st:StepItem (stepper.stepAt(i))
            def state:string (stepper.stateOf(i))
            def item (tree Ctl
                (Step (props (id ("cx-step-" + st.key))
                             (a11yLabel (st.label + ", " + state)))))
            ; MEASURED-adjacent, and the whole shape decision: aria-current
            ; "step", never aria-selected.
            if (i == stepper.current) {
                item.a11yCurrent = "step"
            }
            def mark:string (to_string (i + 1))
            if st.complete {
                ; A tick, not the numeral, once it is done. One glyph alone in
                ; a centred box — the measurer falls back to half an em outside
                ; 32..126 and that spaces a RUN wrongly, which this is not.
                mark = "✓"
            }
            item.addChild((tree Ctl
                (Dot (props (className (this.dotClass(i))))
                    (DotTxt (props (className (this.dotTextClass(i)))) mark))))
            item.addChild((tree Ctl
                (StepLbl (props (className (this.stepLabelClass(i)))) st.label)))
            strip.addChild(item)
            if (i < (n - 1)) {
                strip.addChild((tree Ctl (Rail)))
            }
            i = (i + 1)
        }
        page.addChild(strip)

        ; --- the progress bar --------------------------------------------------
        def track (tree Ctl (Bar (props (id "cx-bar") (a11yLabel "Checkout progress"))))
        ; The controller's FRACTION, become a width here and nowhere else —
        ; the same split the event calendar is under. `percent()` rounds, which
        ; is what both references do and where truncation differs on 3 of 8.
        def fill (tree Ctl (BarFill (props (id "cx-barfill"))))
        UiTree.inline(fill "width" ((to_string (bar.percent())) + "%"))
        track.addChild(fill)
        ; The RANGE always, the POSITION only when there is one. An
        ; indeterminate bar publishes no valuenow and that absence is what
        ; makes a reader say "busy" — measured on both references.
        ; The two FLAGS, not just the numbers. Without them the element path
        ; drops the range and the position entirely — which is not a gap in the
        ; plumbing but the indeterminate contract doing its job: a bar has to
        ; SAY it has a value, because "no position" is the state that makes a
        ; reader announce "busy" instead of a percentage. Found by the gate,
        ; which read the accessible tree and got undefined back.
        track.a11yHasRange = true
        track.a11yValueMin = 0
        track.a11yValueMax = (to_int bar.maxValue)
        track.a11yHasValue = true
        track.a11yValueNow = (to_int bar.value)
        track.a11yValue = (bar.valueText())
        page.addChild(track)
        page.addChild((tree Ctl
            (BarTxt (props (id "cx-bartxt"))
                ((to_string (stepper.completedCount())) + " of " + (to_string n) + " steps done"))))

        ; --- the number field --------------------------------------------------
        def panel (tree Ctl (Panel))
        def cur:StepItem (stepper.stepAt(stepper.current))
        panel.addChild((tree Ctl (PanelLbl ("How many for " + cur.label + "?"))))
        def row (tree Ctl (NumRow))
        def decBtn (tree Ctl
            (NumBtn (props (id "cx-num-dec") (a11yLabel "Decrease"))
                (NumBtnTxt "−")))
        if ((num.canDecrement()) == false) {
            decBtn.a11yDisabled = true
            decBtn.className = "cx-numbtn cx-numbtn-off"
        }
        row.addChild(decBtn)
        def box (tree Ctl
            (NumBox (props (id "cx-num") (a11yLabel "Quantity"))))
        def shown:string num.text
        if ((strlen shown) == 0) {
            shown = "—"
        }
        box.addChild((tree Ctl (NumTxt shown)))
        ; What the field HOLDS, so the trace can see it. An empty box and one
        ; holding "12" are identical in every other field. `a11yValue` is the
        ; element path's name for it — the same property FormDemo puts a text
        ; field's contents in.
        box.a11yValue = num.text
        row.addChild(box)
        def incBtn (tree Ctl
            (NumBtn (props (id "cx-num-inc") (a11yLabel "Increase"))
                (NumBtnTxt "+")))
        if ((num.canIncrement()) == false) {
            incBtn.a11yDisabled = true
            incBtn.className = "cx-numbtn cx-numbtn-off"
        }
        row.addChild(incBtn)
        panel.addChild(row)
        panel.addChild((tree Ctl (NumHint "0 to 99. Shift+Arrow moves by 10 — not PageUp, which does nothing.")))
        page.addChild(panel)

        ; --- back and next -----------------------------------------------------
        def actions (tree Ctl (Actions))
        actions.addChild((tree Ctl
            (Btn (props (id "cx-back") (a11yLabel "Back")) (BtnTxt "Back"))))
        def nextBtn (tree Ctl
            (Btn (props (id "cx-next") (className (this.nextClass())) (a11yLabel "Next"))
                (BtnTxt (props (className (this.nextTextClass()))) "Next")))
        if ((stepper.canAdvance()) == false) {
            nextBtn.a11yDisabled = true
        }
        actions.addChild(nextBtn)
        page.addChild(actions)

        page.addChild((tree Ctl (Note
            "Type a quantity and the step completes, the bar moves and Next lights up. A step you have not reached cannot be clicked.")))
        return page
    }

    ; --- events ----------------------------------------------------------------

    fn press:boolean (target:string) {
        if (target == "") {
            return false
        }
        focused = target
        if (target == "cx-num-inc") {
            ; Focus stays on the FIELD, not on the button. That is what a real
            ; number field does — Base UI's Increment does not steal focus from
            ; the input — and without it the next arrow key finds focus on a
            ; button and does nothing, which reads as a dropped keystroke.
            focused = "cx-num"
            num.increment()
            this.syncFromField()
            this.saveField()
            this.rebuild()
            return true
        }
        if (target == "cx-num-dec") {
            focused = "cx-num"
            num.decrement()
            this.syncFromField()
            this.saveField()
            this.rebuild()
            return true
        }
        if (target == "cx-num") {
            num.focus()
            this.rebuild()
            return true
        }
        if (target == "cx-next") {
            this.saveField()
            if (stepper.next()) {
                this.loadField()
                this.syncFromField()
            }
            this.rebuild()
            return true
        }
        if (target == "cx-back") {
            this.saveField()
            if (stepper.back()) {
                this.loadField()
                this.syncFromField()
            }
            this.rebuild()
            return true
        }
        def i:int 0
        while (i < (stepper.count())) {
            def st:StepItem (stepper.stepAt(i))
            if (target == ("cx-step-" + st.key)) {
                this.moveTo(i)
                this.rebuild()
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; A key belongs to the number field when it has focus, and to the stepper
    ; otherwise. Without the split, arrowing the strip would also nudge the
    ; quantity — the same "one page, two consumers" problem the demo page had
    ; when picking a demo swallowed every key.
    fn key:boolean (k:string) {
        if (focused == "cx-num") {
            if (num.onKey(k false)) {
                this.syncFromField()
                this.saveField()
                this.rebuild()
                return true
            }
            return false
        }
        if (stepper.onKey(k)) {
            this.loadField()
            this.syncFromField()
            this.rebuild()
            return true
        }
        return false
    }

    ; Shift is a separate entry point because the demo host's `key` hook passes
    ; a name and no modifiers — and Shift is where the LARGE STEP lives, which
    ; is the least guessable thing the number field measured.
    fn keyWithShift:boolean (k:string) {
        ; Respects focus exactly as `key` does. It used to not, which made
        ; Shift a back door into the number field from anywhere on the page —
        ; two key paths with two different rules about where a key goes. The
        ; page gate caught it: Shift+ArrowUp moved the field while a plain
        ; ArrowUp right after it did nothing, because the two disagreed about
        ; whether focus was on the field or on the + button beside it.
        if (focused != "cx-num") {
            if (stepper.onKey(k)) {
                this.loadField()
                this.syncFromField()
                this.rebuild()
                return true
            }
            return false
        }
        if (num.onKey(k true)) {
            this.syncFromField()
            this.saveField()
            this.rebuild()
            return true
        }
        return false
    }

    fn typeChar:boolean (c:int) {
        if (focused == "cx-num") {
            num.focus()
            if (num.typeChar(c)) {
                num.blur()
                this.syncFromField()
                this.saveField()
                this.rebuild()
                return true
            }
        }
        return false
    }

    fn setHover:void (id:string) {
        hovered = id
    }

    fn setPressed:void (id:string) {
        pressed = id
    }

    fn setFocus:void (id:string) {
        focused = id
    }

    fn rebuild:void () {
        root = (this.page())
    }

    fn markStates:void (el:EVGElement) {
        el.isHovered = false
        el.isPressed = false
        el.isFocused = false
        if ((strlen el.id) > 0) {
            if (el.id == hovered) {
                el.isHovered = true
            }
            if (el.id == pressed) {
                el.isPressed = true
            }
            if (el.id == focused) {
                el.isFocused = true
            }
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            this.markStates((el.getChild(i)))
            i = (i + 1)
        }
    }

    fn laidOut:EVGLayout () {
        def r:EVGElement (unwrap root)
        def s:EVGStyleSheet (unwrap sheet)
        s.setViewport(pageW pageH false)
        this.markStates(r)
        s.applyTree(r "")
        def t:EVGTransition transitions
        t.reconcileTree(r)
        if layout {
            def lay:EVGLayout (unwrap layout)
            if ((s.layoutClean()) == false) {
                lay.layout(r)
            }
            return lay
        }
        def fresh (new EVGLayout())
        fresh.setPageSize(pageW pageH)
        layout = fresh
        fresh.layout(r)
        return fresh
    }

    fn displayListJson:string () {
        def lay:EVGLayout (this.laidOut())
        def r:EVGElement (unwrap root)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(r)
        return (dl.toJson())
    }

    fn hitId:string (px:double py:double) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def hit (new EVGHitTest())
        return (hit.idAt(r px py))
    }

    fn a11yJson:string (generation:int focusId:string) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Controls demo" generation focusId))
        return (t.toJson())
    }

    fn a11yProblems:[string] () {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "Controls demo" 1 ""))
        return (t.lint())
    }

    fn styleErrorCount:int () {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getErrorCount())
    }

    fn styleErrorAt:string (i:int) {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getError(i))
    }

    fn tick:boolean (dtMs:double) {
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        t.advanceTree(r dtMs)
        return (t.busy(r))
    }

    fn busyNow:boolean () {
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        return (t.busy(r))
    }

    fn heightPx:double () {
        return pageH
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; build_ios.rgr — the dashboard demo, built for Apple hardware, from Ranger.
; ==============================================================================
;
; This program is the point of the exercise. It is written in Ranger, it runs on
; Node, and it builds an iOS, iPadOS or watchOS app by CALLING COMMAND LINE
; PROGRAMS — the Ranger compiler to turn `ui_ios.rgr` into Swift, then xcrun,
; swiftc, plutil, codesign and simctl to turn that Swift into a bundle on a
; simulator. There is no Xcode project anywhere in it, nothing opens the Xcode
; application, and the only thing that has to be installed is the toolchain
; Xcode (or the Command Line Tools) puts on the machine.
;
; It is the same shape as `gallery/ui/android/scripts/build-app.sh`, with one
; difference that is the whole reason it exists: the shell script is a shell
; script, and this is a program in the language the app is written in. It can be
; run DRY — every decision made, every command line printed, nothing executed —
; which is how `lib/apple/apple_test.rgr` checks an Apple build on a machine
; that is not a Mac.
;
;   node tmp/ui-ios/build_ios.js --check          what this machine has
;   node tmp/ui-ios/build_ios.js                  build for the iOS simulator
;   node tmp/ui-ios/build_ios.js --run            ...and put it on one
;   node tmp/ui-ios/build_ios.js --target=watchos-simulator --run
;   node tmp/ui-ios/build_ios.js --dry-run        the plan, and nothing else
;
; ...or `npm run ui:ios`, `npm run ui:ios:run`, `npm run ui:ios:watch`, which
; are the same commands under shorter names.
;
; Run it from the repository root: every path in it is relative to that, the
; same rule the Android scripts follow.
; ==============================================================================

Import "../../../../lib/Shell.rgr"
Import "../../../../lib/apple/AppleAppBuilder.rgr"
Import "../../../../lib/apple/AppleSigning.rgr"

; Which app is being built for Apple hardware.
;
; This driver started as the dashboard's and is now the port mechanism for the
; whole gallery: everything that was specific to one demo -- where its Ranger
; entry point is, what the bundle is called, which hand-written Swift host
; drives it -- is DATA here rather than constants further down, so a second
; port is an entry in this file plus a facade and a view, and not a second copy
; of the build.
class IosApp {

    def key:string ""
    def title:string ""

    ; The Ranger entry point, and where its Swift lands. `generated/` sits
    ; beside the Ranger it came from and is NOT checked in: a stale copy is the
    ; one way a port can silently drift from the demo everything else runs.
    def rangerFile:string ""
    def generatedDir:string ""
    def generatedFile:string ""
    def buildRoot:string ""

    ; The demo's own stylesheet, packaged as a resource -- the same file the
    ; browser page styles the same tree from, copied rather than referenced
    ; because an app bundle is packaged whole.
    def cssFile:string ""

    def appName:string ""
    def displayName:string ""
    def bundleId:string ""
    def hostSources:[string]

    ; A watch build, when the port has one. Empty means this app is phone and
    ; tablet only, and asking for a watch target says so rather than building
    ; something that cannot run.
    def watchSources:[string]
    def watchName:string ""
    def watchDisplayName:string ""
    def watchBundleId:string ""

    Constructor () {
    }

    fn hasWatch:boolean () {
        return ((array_length watchSources) > 0)
    }

    sfn dashboard:IosApp () {
        def a:IosApp (new IosApp)
        a.key = "dashboard"
        a.title = "the dashboard demo"
        a.rangerFile = "gallery/ui/ios/ranger/ui_ios.rgr"
        a.generatedDir = "gallery/ui/ios/generated"
        a.generatedFile = "ui_ios.swift"
        a.buildRoot = "tmp/ui-ios/build"
        a.cssFile = "gallery/ui/demo/dashboard.css"
        a.appName = "RangerDashboard"
        a.displayName = "Ranger Dashboard"
        a.bundleId = "fi.ranger.dashboard"
        push a.hostSources "gallery/ui/ios/ios/DashboardView.swift"
        push a.hostSources "gallery/ui/ios/ios/AppDelegate.swift"
        push a.hostSources "gallery/ui/ios/ios/main.swift"
        push a.watchSources "gallery/ui/ios/watch/WatchApp.swift"
        a.watchName = "RangerDashboardWatch"
        a.watchDisplayName = "Ranger"
        a.watchBundleId = "fi.ranger.dashboard.watch"
        return a
    }

    sfn realtrainer:IosApp () {
        def a:IosApp (new IosApp)
        a.key = "realtrainer"
        a.title = "the RealTrainer demo"
        a.rangerFile = "gallery/realtrainer/ios/ranger/rt_ios.rgr"
        a.generatedDir = "gallery/realtrainer/ios/generated"
        a.generatedFile = "rt_ios.swift"
        a.buildRoot = "tmp/rt-ios/build"
        a.cssFile = "gallery/realtrainer/web/realtrainer.css"
        a.appName = "RangerRealTrainer"
        a.displayName = "RealTrainer"
        a.bundleId = "fi.ranger.realtrainer"
        push a.hostSources "gallery/realtrainer/ios/ios/RealTrainerView.swift"
        push a.hostSources "gallery/realtrainer/ios/ios/AppDelegate.swift"
        push a.hostSources "gallery/realtrainer/ios/ios/main.swift"
        ; No watch build: this page is a 980x760 composition and a watch is not
        ; a window it has an honest answer for.
        return a
    }

    sfn known:[IosApp] () {
        def out:[IosApp]
        push out (IosApp.dashboard())
        push out (IosApp.realtrainer())
        return out
    }

    sfn byKey@(optional):IosApp (key:string) {
        def out@(optional):IosApp
        def apps:[IosApp] (IosApp.known())
        for apps a:IosApp i {
            if (a.key == key) {
                out = a
            }
        }
        return out
    }

    sfn keyList:string () {
        def out:string ""
        def apps:[IosApp] (IosApp.known())
        for apps a:IosApp i {
            if (i > 0) {
                out = (out + ", ")
            }
            out = (out + a.key)
        }
        return out
    }
}

class IosBuildOptions {

    def app:string "dashboard"
    def target:string "ios-simulator"
    def device:string ""
    def identity:string "-"
    def profile:string ""
    def bundleId:string ""
    def doRun:boolean false
    def dryRun:boolean false
    def checkOnly:boolean false
    def release:boolean false
    def skipRanger:boolean false
    ; Reuse the .app that is already there. `--no-ranger` skips only the
    ; Ranger->Swift compile; this skips swiftc as well, which is the 46k lines
    ; that make a re-run slow when nothing but the device changed.
    def skipBuild:boolean false
    ; Keep the launched process attached so its output comes back here. A
    ; device has no console you can otherwise see.
    def console:boolean false
    def verbose:boolean false
    def onlyPhone:boolean false
    def onlyPad:boolean false
    def helpWanted:boolean false
    def bad:string ""

    Constructor () {
    }

    ; `--name=value` and `--flag`, which is the shape every other script in this
    ; repository takes. An unknown option is an ERROR rather than something
    ; ignored: a typo in `--targt=watchos-simulator` that silently builds for
    ; the phone is the kind of thing you only notice on the wrong device.
    sfn parse:IosBuildOptions () {
        def o:IosBuildOptions (new IosBuildOptions)
        def n:int (shell_arg_cnt)
        def i:int 0
        while (i < n) {
            def arg:string (shell_arg i)
            def name:string arg
            def value:string ""
            def eq:int (indexOf arg "=")
            if (eq > 0) {
                name = (substring arg 0 eq)
                value = (substring arg (eq + 1) (strlen arg))
            }
            switch name {
                case "--app" {
                    o.app = value
                }
                case "--target" {
                    o.target = value
                }
                case "--device" {
                    o.device = value
                }
                case "--identity" {
                    o.identity = value
                }
                case "--profile" {
                    o.profile = value
                }
                case "--bundle-id" {
                    o.bundleId = value
                }
                case "--run" {
                    o.doRun = true
                }
                case "--dry-run" {
                    o.dryRun = true
                }
                case "--check" {
                    o.checkOnly = true
                }
                case "--release" {
                    o.release = true
                }
                case "--no-ranger" {
                    o.skipRanger = true
                }
                case "--no-build" {
                    o.skipBuild = true
                    o.skipRanger = true
                }
                case "--console" {
                    o.console = true
                }
                case "--verbose" {
                    o.verbose = true
                }
                case "--phone" {
                    o.onlyPhone = true
                }
                case "--pad" {
                    o.onlyPad = true
                }
                case "--help" {
                    o.helpWanted = true
                }
                case "-h" {
                    o.helpWanted = true
                }
                default {
                    o.bad = arg
                }
            }
            i = i + 1
        }
        return o
    }
}

class IosBuild {

    ; Which app this run is building. Everything that used to be a constant
    ; here -- the Ranger entry point, the bundle id, the Swift host -- is one of
    ; its fields, so this class is the BUILD and `IosApp` is the app.
    def app:IosApp (IosApp.dashboard())

    Constructor () {
    }

    sfn usage:void () {
        print "build a gallery demo for Apple hardware, without Xcode"
        print ""
        print "  --app=KEY        " + (IosApp.keyList()) + "  (default dashboard)"
        print "  --target=KEY     ios-simulator (default), ios-device,"
        print "                   watchos-simulator, watchos-device"
        print "  --run            install and launch afterwards -- on a simulator,"
        print "                   or on the connected device for an ios-device target"
        print "  --device=NAME    which simulator or device: a name substring or an id"
        print "  --console        keep the launched app attached so its output lands here"
        print "  --phone/--pad    build for only one of the two iOS families"
        print "  --identity=NAME  codesigning identity for a device build"
        print "                   (found in the keychain when not given)"
        print "  --profile=PATH   .mobileprovision for a device build"
        print "                   (found on this machine when not given)"
        print "  --bundle-id=ID   override the app's own bundle id"
        print "  --release        compile with -O"
        print "  --no-ranger      reuse the generated Swift instead of remaking it"
        print "  --no-build       reuse the .app that is already built (implies --no-ranger)"
        print "  --dry-run        print every command and run none of them"
        print "  --check          report what this machine can build, and stop"
        print "  --verbose        print each command as it runs"
        print ""
        print "run it from the repository root."
    }

    ; The Ranger compiler, called as a command line program — which is exactly
    ; what this whole exercise is about. RANGER_LIB is how the compiler is told
    ; where the operator library is, and it is read out of the ENVIRONMENT
    ; rather than passed as an argument, which is why `Shell` can set one.
    fn compileRanger:boolean (sh:Shell) {
        print "* ranger      " + app.rangerFile + " -> " + app.generatedDir + "/" + app.generatedFile
        if (sh.dryRun == false) {
            create_dir app.generatedDir
        }
        def compiler:Shell (new Shell)
        compiler.dryRun = sh.dryRun
        compiler.verbose = sh.verbose
        compiler.setEnv("RANGER_LIB" "./compiler/Lang.rgr:./lib/stdops.rgr")
        def argv:[string]
        ; The generated file is 46k lines of Swift from one Ranger tree, and
        ; the default heap is not enough for the analysis that produces it.
        push argv "--max-old-space-size=8192"
        push argv "bin/output.js"
        push argv "-l=swift6"
        push argv app.rangerFile
        push argv "-nodecli"
        push argv ("-d=" + app.generatedDir)
        push argv ("-o=" + app.generatedFile)
        def res:ShellResult (compiler.capture("node" argv))
        for compiler.commands c:string ci {
            push sh.commands c
        }
        ; The compiler answers 0 even when it failed, and says so in its output
        ; instead — so the output is what is read.
        if ((indexOf res.out "Compilation FAILED") >= 0) {
            print "the Ranger compiler could not build " + app.rangerFile + ":"
            print res.out
            return false
        }
        if (res.failed()) {
            print (res.describeFailure())
            return false
        }
        if (sh.dryRun == false) {
            if ((file_exists app.generatedDir app.generatedFile) == false) {
                print "the compiler reported no failure but wrote no " + app.generatedDir + "/" + app.generatedFile
                return false
            }
            if ((this.rejectTopLevelCode(app.generatedDir app.generatedFile)) == false) {
                return false
            }
        }
        return true
    }

    ; The generated Swift is a LIBRARY: it is compiled together with the port's
    ; hand-written `main.swift`, which is where `UIApplicationMain` is called.
    ; A facade that declares a static method named `main` -- with or without
    ; the @(main) annotation -- makes the compiler emit `__main__swift()` as a
    ; TOP-LEVEL statement, and Swift allows those only in a file actually
    ; called main.swift. swiftc says "expressions are not allowed at the top
    ; level" and names a line 19 000 lines into generated code, which is a long
    ; way from the one line of Ranger that caused it.
    ;
    ; It is caught here instead, on any machine, because the whole point of
    ; this port is that everything short of swiftc can be checked without a Mac.
    fn rejectTopLevelCode:boolean (dir:string file:string) {
        def textOpt@(optional):string (read_file dir file)
        if (null? textOpt) {
            return true
        }
        def text:string (unwrap textOpt)
        if ((indexOf text "\n__main__swift()") < 0) {
            return true
        }
        print ""
        print dir + "/" + file + " has a program entry point in it."
        print ""
        print "  " + app.rangerFile + " declares a static method named `main`, so the"
        print "  compiler emitted `__main__swift()` at the top level. This file is a"
        print "  library -- the app's entry point is the hand-written main.swift -- and"
        print "  Swift allows a top-level statement only in a file called main.swift."
        print ""
        print "  Remove the `sfn main` from the facade. A program that drives it belongs"
        print "  in its own file, the way check_*.rgr does."
        return false
    }

    fn makeTarget@(optional):AppleTarget (o:IosBuildOptions tools:AppleToolchain sh:Shell) {
        ; A simulator runs NATIVE code, so a simulator build is for whatever
        ; Mac is running it. Asking the machine is why one build script works
        ; on both Apple Silicon and Intel.
        def arch:string "arm64"
        if (sh.dryRun == false) {
            arch = (tools.hostArch())
        }
        def out@(optional):AppleTarget
        if (o.target == "ios-simulator") {
            out = (AppleTarget.iosSimulator(arch))
        }
        if (o.target == "ios-device") {
            out = (AppleTarget.iosDevice(o.identity))
        }
        if (o.target == "watchos-simulator") {
            out = (AppleTarget.watchSimulator(arch))
        }
        if (o.target == "watchos-device") {
            out = (AppleTarget.watchDevice(o.identity))
        }
        if (!null? out) {
            def t:AppleTarget (unwrap out)
            if o.onlyPhone {
                t.onlyPhone()
            }
            if o.onlyPad {
                t.onlyPad()
            }
        }
        return out
    }

    ; The painter and the surfaces, shared with nothing else on Apple yet and
    ; written to be shared: they are `gallery/evg/apple`, not `gallery/ui/ios`,
    ; because the next port through them is a deck rather than a dashboard.
    fn addSharedSources:void (spec:AppleAppSpec) {
        spec.addSource(app.generatedDir + "/" + app.generatedFile)
        spec.addSource("gallery/evg/apple/Sources/EvgSurface.swift")
        spec.addSource("gallery/evg/apple/Sources/EvgPainter.swift")
        spec.addSource("gallery/evg/apple/Sources/CoreGraphicsEvgSurface.swift")
        spec.addSource("gallery/evg/apple/Sources/RecordingSurface.swift")
    }

    fn makeSpec:AppleAppSpec (o:IosBuildOptions target:AppleTarget) {
        def spec:AppleAppSpec (new AppleAppSpec)
        if (target.isWatch()) {
            spec.name = app.watchName
            spec.displayName = app.watchDisplayName
            spec.bundleId = app.watchBundleId
            this.addSharedSources(spec)
            for app.watchSources src:string i {
                spec.addSource(src)
            }
        } {
            spec.name = app.appName
            spec.displayName = app.displayName
            spec.bundleId = app.bundleId
            this.addSharedSources(spec)
            for app.hostSources src:string i {
                spec.addSource(src)
            }
        }
        if ((strlen o.bundleId) > 0) {
            spec.bundleId = o.bundleId
        }
        ; The demo's own stylesheet, as a resource. The same file the browser
        ; page, the gates and the Android port style the tree from — copied
        ; rather than referenced because an app bundle is packaged whole and a
        ; source tree five directories away is not one.
        spec.addResource(app.cssFile)
        if o.release {
            push spec.swiftFlags "-O"
        }
        spec.provisioningProfile = o.profile
        return spec
    }

    ; A device build needs an identity and a profile. Both are on the machine
    ; already if Xcode has ever built for a device, so both are FOUND rather
    ; than typed -- which is the difference between one command and three flags.
    ; What the caller passed always wins.
    fn resolveSigning:boolean (o:IosBuildOptions spec:AppleAppSpec target:AppleTarget sh:Shell tools:AppleToolchain) {
        if target.isSimulator {
            return true
        }
        if sh.dryRun {
            ; A dry run resolves nothing, but a plan that showed a device build
            ; signed ad hoc would be showing something that cannot work.
            ; Placeholders, obviously placeholders.
            if (target.signIdentity == "-") {
                target.signIdentity = "<development-identity>"
            }
            if ((strlen spec.provisioningProfile) == 0) {
                spec.provisioningProfile = "<found>.mobileprovision"
            }
            return true
        }
        def signing:AppleSigning (new AppleSigning (sh))

        ; The device first, because the profile has to list it -- and because a
        ; phone that is not plugged in should be said BEFORE swiftc spends
        ; minutes on 46k lines, not after.
        def deviceUdid:string ""
        ; devicectl ships inside Xcode.app, not with the Command Line Tools, so
        ; a machine that has only the Tools answers "no devices" to a question
        ; it never got to ask. Saying "plug one in" there sends someone to look
        ; for a cable problem they do not have.
        if o.doRun {
            if ((tools.hasDeviceCtl()) == false) {
                print "xcrun devicectl is not on this machine."
                print ""
                print "It ships inside Xcode.app and is not part of the Command Line Tools, and"
                print "it needs Xcode 15 or later. `npm run ui:ios:check` says what this machine"
                print "has and what to do about it."
                return false
            }
        }
        def picked@(optional):AppleDeviceInfo (tools.pickDevice(o.device))
        if (!null? picked) {
            def dev:AppleDeviceInfo (unwrap picked)
            deviceUdid = dev.identifier
            print "* device      " + (dev.describe())
        } {
            if o.doRun {
                if ((strlen o.device) > 0) {
                    print "no connected device matches \"" + o.device + "\"."
                } {
                    print "no device is connected."
                }
                print ""
                print "The simulator needs no cable, no Apple account and no provisioning"
                print "profile, and it boots itself -- you do not have to open Simulator first:"
                print ""
                print "  npm run ui:ios:run                      an iPhone or iPad simulator"
                print "  npm run ui:ios:run -- --device=\"iPad\"   ...a particular one"
                print "  npm run ui:ios:watch                    an Apple Watch simulator"
                print ""
                print "For a real device: plug it in, unlock it, and trust this computer."
                print "`xcrun devicectl list devices` shows what it can see -- one listed as"
                print "\"available (paired)\" rather than \"connected\" is known and not plugged in."
                print ""
                print "To build for a device without installing, leave --run off."
                return false
            }
            ; No --run: the build is still worth doing, and a profile is
            ; matched on the bundle id alone.
            print "* device      none connected; the profile will be matched on the bundle id only"
        }

        if (target.signIdentity == "-") {
            def ids:[AppleSigningIdentity] (signing.findIdentities())
            if ((array_length ids) == 0) {
                print "no codesigning identity is in the keychain."
                print "Open Xcode once and add your Apple ID (Settings > Accounts), or pass --identity=NAME."
                return false
            }
            def idOpt@(optional):AppleSigningIdentity (AppleSigning.pickIdentity(ids ""))
            if (null? idOpt) {
                print "no usable codesigning identity. `security find-identity -v -p codesigning` lists what there is."
                return false
            }
            def id:AppleSigningIdentity (unwrap idOpt)
            target.signIdentity = id.sha1
            print "* identity    " + (id.describe())
        }

        if ((strlen spec.provisioningProfile) == 0) {
            def workDir:string (app.buildRoot + "/" + target.key)
            def profOpt@(optional):AppleProvisioningProfile (signing.pickProfile(spec.bundleId deviceUdid workDir))
            if (null? profOpt) {
                print "no provisioning profile on this machine covers " + spec.bundleId + " for this device."
                print ""
                print "A profile cannot be CREATED from the command line -- that is a conversation"
                print "with Apple's developer portal, and only `xcodebuild -allowProvisioningUpdates`"
                print "has it, which is the thing this driver exists to avoid. Once:"
                print ""
                print "  open Xcode, make any project with the bundle id " + spec.bundleId + ","
                print "  pick your team, and build it to this device once."
                print ""
                print "After that the profile is on this machine and this finds it. Or pass"
                print "--profile=PATH, or --bundle-id=ID to match a wildcard profile you have."
                return false
            }
            def prof:AppleProvisioningProfile (unwrap profOpt)
            spec.provisioningProfile = prof.path
            print "* profile     " + (prof.describe())
            if ((strlen prof.expires) > 0) {
                print "              expires " + prof.expires
            }
        }
        return true
    }

    sfn m@(main):void () {
        def o:IosBuildOptions (IosBuildOptions.parse())
        if o.helpWanted {
            IosBuild.usage()
            return
        }
        if ((strlen o.bad) > 0) {
            print "unknown option: " + o.bad
            print ""
            IosBuild.usage()
            exit 2
        }

        def b:IosBuild (new IosBuild)
        def appOpt@(optional):IosApp (IosApp.byKey(o.app))
        if (null? appOpt) {
            print "unknown app: " + o.app
            print "one of " + (IosApp.keyList())
            exit 2
        }
        b.app = (unwrap appOpt)

        def sh:Shell (new Shell)
        sh.dryRun = o.dryRun
        sh.verbose = (o.verbose || o.dryRun)
        def tools:AppleToolchain (new AppleToolchain (sh))

        ; Everything below assumes the repository root, and saying so up front
        ; is better than a swiftc error about a file that is right there.
        if (o.dryRun == false) {
            if ((file_exists "." "package.json") == false) {
                print "run this from the repository root — package.json is not here"
                exit 3
            }
        }

        if o.checkOnly {
            print "what this machine can build"
            def lines:[string] ((new AppleAppBuilder (sh tools)).checkEnvironment())
            for lines line:string i {
                print "  " + line
            }
            return
        }

        def targetOpt@(optional):AppleTarget (b.makeTarget(o tools sh))
        if (null? targetOpt) {
            print "unknown target: " + o.target
            print "one of ios-simulator, ios-device, watchos-simulator, watchos-device"
            exit 2
        }
        def target:AppleTarget (unwrap targetOpt)

        ; A port without a watch host says so, rather than building a bundle
        ; whose only Swift is a page that has no window to go in.
        if (target.isWatch()) {
            if ((b.app.hasWatch()) == false) {
                print b.app.title + " has no watch build."
                print "  " + b.app.key + " is a fixed-size page; the watch target is the dashboard's:"
                print "  npm run ui:ios:watch"
                exit 2
            }
        }

        if (o.skipRanger == false) {
            if ((b.compileRanger(sh)) == false) {
                exit 1
            }
        }

        def spec:AppleAppSpec (b.makeSpec(o target))
        def builder:AppleAppBuilder (new AppleAppBuilder (sh tools))
        builder.buildRoot = b.app.buildRoot
        builder.verbose = true

        if ((b.resolveSigning(o spec target sh tools)) == false) {
            exit 1
        }

        if (o.skipBuild == false) {
            def res:AppleBuildResult (builder.build(spec target))
            if (res.ok == false) {
                print ""
                print res.message
                exit 1
            }
        } {
            def appPath:string (builder.bundlePath(spec target))
            if (sh.dryRun == false) {
                if ((dir_exists appPath) == false) {
                    print "--no-build was given and there is nothing built at " + appPath
                    exit 1
                }
            }
            print "* reusing     " + appPath
        }

        if o.doRun {
            if target.isSimulator {
                def ran:AppleBuildResult (builder.runOnSimulator(spec target o.device))
                if (ran.ok == false) {
                    print ""
                    print ran.message
                    exit 1
                }
            } {
                def ran:AppleBuildResult (builder.runOnDevice(spec target o.device o.console))
                if (ran.ok == false) {
                    print ""
                    print ran.message
                    exit 1
                }
            }
        }

        if o.dryRun {
            print ""
            print "--- the plan, which is all a dry run does ---"
            for sh.commands c:string i {
                print "  " + c
            }
        }
    }
}

; ==============================================================================
; ui_android.rgr — UiAndroid
; ==============================================================================
;
; The name the Kotlin host imports, and nothing else. Everything this class
; can do is `UiWindowHost` — see `../../src/UiWindowHost.rgr`, which says why
; the iOS and Android facades are one file now. Android never calls
; `setSafeArea` — an Activity's content view already sits inside the system
; bars — and never `useWatchFit`, so the insets stay zero and the fit stays the
; width fit, which is what this file used to write out.

Import "../../src/UiWindowHost.rgr"

class UiAndroid extends UiWindowHost {
}

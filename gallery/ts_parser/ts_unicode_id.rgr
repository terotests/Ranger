    fn base36Value:int (ch:string) {
        def code:int (charAt ch 0)
        if (code >= 48) { if (code <= 57) { return (code - 48) } }
        if (code >= 97) { if (code <= 122) { return ((code - 97) + 10) } }
        return 0
    }

    ; Decodes "gap.length,gap.length,..." into a flat [lo, hi, ...] table.
    fn decodeRangeTable:[int] (spec:string) {
        def out:[int]
        def prev:int -1
        def i:int 0
        def n:int (strlen spec)
        def cur:int 0
        def delta:int 0
        while (i < n) {
            def ch:string (substring spec i (i + 1))
            if (ch == ".") {
                delta = cur
                cur = 0
            } {
                if (ch == ",") {
                    def s:int ((prev + 1) + delta)
                    def e:int (s + cur)
                    push out s
                    push out e
                    prev = e
                    cur = 0
                    delta = 0
                } {
                    cur = ((cur * 36) + (this.base36Value(ch)))
                }
            }
            i = (i + 1)
        }
        def sLast:int ((prev + 1) + delta)
        def eLast:int (sLast + cur)
        push out sLast
        push out eLast
        return out
    }

    fn inRangeTable:boolean (table:[int] code:int) {
        def total:int (array_length table)
        if (total == 0) { return false }
        def pairCount:double ((to_double total) / 2.0)
        def loP:int 0
        def hiP:int ((floor pairCount) - 1)
        while (loP <= hiP) {
            def midD:double ((to_double (loP + hiP)) / 2.0)
            def midP:int (floor midD)
            def lo:int (itemAt table (midP * 2))
            def hi:int (itemAt table ((midP * 2) + 1))
            if (code < lo) {
                hiP = (midP - 1)
            } {
                if (code > hi) {
                    loP = (midP + 1)
                } {
                    return true
                }
            }
        }
        return false
    }
}

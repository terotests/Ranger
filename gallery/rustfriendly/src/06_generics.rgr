; Study 06 — generics
;
; The Rust I want:
;   struct Stack<T> { items: Vec<T> }
;   impl<T> Stack<T> {
;       fn put(&mut self, item: T) { self.items.push(item); }
;       fn peek(&self) -> Option<&T> { self.items.last() }
;   }
;   fn identity<T>(x: T) -> T { x }
;
; Ranger `@params` expands each instantiation to a concrete class
; (`Stack_int`, `Stack_string`) before codegen. There is no generic
; function, no bounds, and no lifetime on the peek return.

class Stack @params(T) {
    def items:[T]

    fn put:void (item:T) {
        push items item
    }

    fn size:int () {
        return (array_length items)
    }

    fn peek@(optional):T () {
        def found@(optional):T
        def n:int (array_length items)
        if (n == 0) {
            return found
        }
        found = (itemAt items (n - 1))
        return found
    }
}

class GenericsMain {
    sfn main:void () {
        def ints:Stack@(int) (new Stack@(int)())
        ints.put(7)
        ints.put(8)
        print ("int-size " + (to_string (ints.size())))
        def top@(optional):int (ints.peek())
        print ("int-top " + (to_string (?? top 0)))

        def words:Stack@(string) (new Stack@(string)())
        words.put("ada")
        words.put("grace")
        print ("str-size " + (to_string (words.size())))
        def lastWord@(optional):string (words.peek())
        print ("str-top " + (?? lastWord "?"))
    }
}

; Study 10 — optional parameters
;
; The Rust I want:
;   fn shown(maybe: Option<String>) -> String
;   fn shown_i(a: Option<i64>) -> i64
;   fn shown_o(p: Option<Point>) -> i64
;
; This began as an attempt, not a study. `fn shown:string (maybe@(optional):string)`
; is an ordinary Ranger signature, and the writer used to emit
; `fn shown(maybe : Option<Option<String>>)`, which rustc rejects at the body and
; at every call site. It was not about strings: an optional `int` parameter and an
; optional object parameter came out doubly wrapped too. Optional LOCALS and
; optional RETURNS were always right, which is what made it look narrower than it
; was — they never went through the parameter emitter.
;
; `writeTypeDef` already reads the `optional` flag and writes the `Option<…>`;
; the parameter emitter wrapped the result in a second one.

class Point {
    def x:int 0
    def y:int 0
}

class OptionalParams {
    fn shown:string (maybe@(optional):string) {
        if (null? maybe) {
            return "unknown"
        }
        return (unwrap maybe)
    }

    fn shownInt:int (a@(optional):int) {
        if (null? a) {
            return 0
        }
        def r:int (unwrap a)
        return r
    }

    fn shownPoint:int (p@(optional):Point) {
        if (null? p) {
            return 0
        }
        def q:Point (unwrap p)
        return q.x
    }

    sfn main:void () {
        def app:OptionalParams (new OptionalParams())

        def hit@(optional):string
        hit = "ada"
        print ("name " + (app.shown(hit)))

        def miss@(optional):string
        print ("miss " + (app.shown(miss)))

        def n@(optional):int
        n = 41
        print ("int " + (to_string (app.shownInt(n))))

        def p@(optional):Point
        def pt:Point (new Point())
        pt.x = 7
        p = pt
        print ("point " + (to_string (app.shownPoint(p))))
    }
}

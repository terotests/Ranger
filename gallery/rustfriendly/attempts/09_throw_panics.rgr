; Attempt — try / throw / catch on the Rust target
;
; This file is not part of compile.sh. It compiles, rustc accepts it, and
; the binary panics on the negative path because the writer emits the try
; body and drops the catch (docs/site/.../targets/overview.md).
;
; Run:
;   node bin/output.js -l=rust gallery/rustfriendly/attempts/09_throw_panics.rgr \
;     -d=/tmp -o=throw.rs
;   rustc --edition 2021 /tmp/throw.rs -o /tmp/throw && /tmp/throw

class Guard {
    fn mustBePositive@(throws):int (value:int) {
        if (value < 0) {
            throw "negative"
        }
        return value
    }
}

class ThrowMain {
    sfn main:void () {
        def g:Guard (new Guard())
        def caught:string "none"
        try {
            def ok:int (g.mustBePositive(3))
            print ("try_ok " + (to_string ok))
        } {
            caught = (error_msg)
        }
        print ("after_ok " + caught)
        try {
            def bad:int (g.mustBePositive((0 - 1)))
            print ("try_bad " + (to_string bad))
        } {
            caught = (error_msg)
        }
        print ("after_bad " + caught)
    }
}

; ==============================================================================
; GridApp - UIInput → WorkbookModel / DataGrid / selection / single EditView
; ==============================================================================
;
; Same contract as the text editor: platform fills UIInput; app never touches
; SDL/DOM. Loads .xlsx via XlsxLoader into WorkbookModel; DataGrid stays format-
; agnostic.
; ==============================================================================

Import "SpreadsheetModel.rgr"
Import "WorkbookModel.rgr"
Import "GridSelection.rgr"
Import "DataGrid.rgr"
Import "GridView.rgr"
Import "SheetView.rgr"
Import "FormulaEngine.rgr"
Import "xlsx/XlsxLoader.rgr"
Import "xlsx/XlsxWriter.rgr"
Import "DateSerial.rgr"
Import "GridCommands.rgr"
Import "../../game_engine/ui/UIInput.rgr"
Import "../../evg/EVGWindow.rgr"
Import "GridFormat.rgr"
Import "GridChart.rgr"
Import "GridChartView.rgr"
Import "GridClip.rgr"

class GridApp {
    def book:WorkbookModel (new WorkbookModel)
    def model:SpreadsheetModel (new SpreadsheetModel)
    def sheetView:SheetView (new SheetView)
    def engine:FormulaEngine (new FormulaEngine)
    def sel:GridSelection (new GridSelection)
    def grid:DataGrid (new DataGrid)
    def view:GridView (new GridView)
    def W:int 900
    def H:int 560
    ; What the app would like its HOST to do about a file, and nothing more.
    ; Opening a picker is the one thing this class cannot do for itself: it
    ; does not know whether it is in a browser, a window, or on the end of a
    ; socket, and each of those answers differently. So `file.open` and
    ; `file.saveAs` only say what is wanted — "open" or "saveAs" — and whoever
    ; is hosting reads it, does the platform's part, and clears it.
    ; A host that ignores it loses nothing: Ctrl+S still writes beside the
    ; source file, as it always did.
    def fileRequest:string ""
    def statusH:int 22
    def editing:boolean false
    def editBuf:string ""
    def editCaret:int 0
    ; True when the edit started from (or is focused in) the formula bar —
    ; the caret is drawn there rather than only inside the cell.
    def editInFormulaBar:boolean false
    ; While editing a formula (`=…`), a click/drag on the sheet inserts a cell
    ; or range at the caret instead of committing — Excel's point-and-click.
    def formulaPicking:boolean false
    def pickR0:int 0
    def pickC0:int 0
    def pickR1:int 0
    def pickC1:int 0
    ; Byte range in editBuf of the ref last inserted by a pick, so a drag (or
    ; another click with the caret still on it) can replace rather than append.
    def pickTokStart:int -1
    def pickTokEnd:int -1
    def dragging:boolean false
    def resizing:boolean false
    def resizingRows:boolean false
    def resizeCol0:int -1
    def resizeCol1:int -1
    def filling:boolean false
    ; Dragging the selection's edge moves the block. The source is remembered
    ; because the drop has to read it after the pointer has left it.
    def movingRange:boolean false
    def moveR0:int 0
    def moveC0:int 0
    def moveR1:int 0
    def moveC1:int 0
    def moveGrabR:int 0
    def moveGrabC:int 0
    def fillR0:int 0
    def fillC0:int 0
    def fillR1:int 0
    def fillC1:int 0
    def clipboardTsv:string ""
    def clipboardHtml:string ""
    ; The chart flavours, empty unless a chart was the last thing copied.
    ; `clipboardKind` says which — a host that only speaks text can read it and
    ; not bother asking for the rest.
    def clipboardKind:string "cells"
    def clipboardPng:string ""
    def clipboardSvg:string ""
    ; The chart as a Vela document: the specification, the numbers it was made
    ; of, and how it is presented. A host hands this to anything that can draw
    ; Vela — the DOCX editor pastes it and keeps editing it.
    def clipboardChartJson:string ""
    def clipboardName:string ""
    def clipboardNote:string ""
    ; Bumped by every copy. A host polls this to notice that something new is
    ; on the clipboard — a chart is copied by a BUTTON as well as by Ctrl+C,
    ; and a pointer click tells the host nothing on its own.
    def clipboardSeq:int 0
    def clipper:ChartClipboard (new ChartClipboard)
    def clipR0:int 0
    def clipC0:int 0
    def clipRows:int 0
    def clipCols:int 0
    def clipValues:[string]
    def clipFormulas:[string]
    def clipStyles:[CellStyle]
    ; 0 = everything (default), 1 = values only, 2 = formats only,
    ; 3 = values + formulas but no formatting.
    def pasteMode:int 0
    ; Shared EVG dialog layer — the same windows the DOCX / PPTX hosts can use.
    def windows:EVGWindowManager (new EVGWindowManager)
    def pasteDialog:EVGWindow (new EVGWindow)
    ; Charts: the picker, and the description it is editing. The charts
    ; themselves live on the view's ChartLayer, because that is what paints
    ; them; this side only decides what they are.
    def chartDialog:EVGWindow (new EVGWindow)
    ; Find and replace. The strings live here rather than in the dialog so a
    ; search survives closing it, and so the whole thing can be driven without
    ; one — which is how it is tested.
    def findDialog:EVGWindow (new EVGWindow)
    def findQuery:string ""
    def replaceWith:string ""
    def findMatchCase:boolean false
    def findWholeCell:boolean false
    ; Excel's "look in": formulas or values. A cell holding =A1+B1 shows 5 and
    ; contains "A1+B1", and which of those you meant to search is a real
    ; question rather than an implementation detail.
    def findInFormulas:boolean true
    def findAllSheets:boolean false
    def findStatus:string ""
    ; The conditional-formatting rule editor.
    def cfDialog:EVGWindow (new EVGWindow)
    def cfStatus:string ""
    ; The last refusal, so a host can show it and a test can read it.
    def validationError:string ""
    ; The link the user just followed. The app cannot open a browser; it says
    ; what was activated and the host decides.
    def activatedLink:string ""
    ; Dialogs for the two things a cell can carry besides a value.
    def linkDialog:EVGWindow (new EVGWindow)
    def dvDialog:EVGWindow (new EVGWindow)
    def listDialog:EVGWindow (new EVGWindow)
    ; Text / fill colour picker. One dialog, two modes: which format op it
    ; applies when the user confirms.
    def colorDialog:EVGWindow (new EVGWindow)
    def colorDialogOp:string "color"
    def colorPick:string "#C00000"
    def colorRecent:[string]
    ; Live preview while the palette is open: styles before the picker ran,
    ; restored on Cancel / Escape, and committed as one undo on Apply.
    def colorPreviewOn:boolean false
    def colorPreviewCommitted:boolean false
    def colorSnapRows:[int]
    def colorSnapCols:[int]
    def colorSnapStyles:[CellStyle]
    def listValues:[string]
    def dvKind:int 701
    def dvOp:int 721
    def dvV1:string ""
    def dvV2:string ""
    def dvBlank:boolean true
    def dvStatus:string ""
    ; What the editor was last set to. Kept here rather than read back off the
    ; dialog, because adding a rule rebuilds it — and a form that forgets what
    ; you just typed is a form you have to retype.
    def cfTest:int 601
    def cfFill:int 621
    def cfFillHex:string "#FFC7CE"
    def cfV1:string "0"
    def cfV2:string ""
    def pendingChart:GridChart (new GridChart)
    ; The chart the picker is editing, or 0 when it is making a new one.
    def chartEditId:int 0
    def dialogsReady:boolean false
    ; Format painter: armed by Ctrl+Shift+C, applied to the next selection.
    def formatBrush:CellStyle (new CellStyle)
    def formatBrushArmed:boolean false
    def clipCut:boolean false
    def loadError:string ""
    ; Where the last save went, so a host can tell the user — and so a test
    ; can check that it went anywhere at all.
    def savedPath:string ""
    ; Everything the grid can do, by name — see GridCommands. Built once, so a
    ; host can enumerate it before the first frame.
    def commands:GridCommandTable (new GridCommandTable)
    def commandsReady:boolean false
    ; The last custom tool that was run, waiting to be collected. Ranger has no
    ; closures to hand a host, so a registered tool is a mailbox: running it
    ; leaves the id here and the host takes it.
    def pendingCustom:string ""
    def pendingCustomArg:string ""

    Constructor () {
    }

    fn syncActiveModel:void () {
        ; persist scroll on previous sheet
        if ((book.sheetCount()) > 0) {
            ; model may already point at previous
        }
        model = (book.activeSheet())
        sheetView.attach(model)
        grid.bindView(sheetView)
        grid.scrollX = model.scrollXSaved
        grid.scrollY = model.scrollYSaved
        sel.anchor.row = 0
        sel.anchor.col = 0
        sel.active.row = 0
        sel.active.col = 0
        grid.updateVisible(model)
    }

    fn init:void (fontDir:string) {
        view.init(W H fontDir)
        ; The view paints the windows and the charts, so it is given them once
        ; here rather than on every frame — anything that builds a display list
        ; directly (a test, a dump) then sees the same scene the app does.
        view.windows = windows
        this.buildCommands()
        view.commands = commands
        view.toolbar.build()
        grid.toolbarH = (view.toolbar.heightFor(W))
        grid.setBounds(0 0 W (H - statusH))
        this.loadDemo()
    }

    ; Start without touching the file system: the browser build has no fonts to
    ; read and no workbook to open until it has fetched them. Everything else —
    ; the command table, the window layer, the grid's bounds — is the same as
    ; `init` does.
    fn initBare:void () {
        view.initBare(W H)
        view.windows = windows
        this.buildCommands()
        view.commands = commands
        view.toolbar.build()
        grid.toolbarH = (view.toolbar.heightFor(W))
        grid.setBounds(0 0 W (H - statusH))
    }

    ; A face, from bytes. The first one loaded becomes the family the grid
    ; draws with; the rest are the bold and italic cuts it switches to.
    fn addFontBytes:boolean (family:string data:buffer) {
        return (view.ctx.tr.loadFontBytes(family data))
    }

    fn addFaceBytes:boolean (data:buffer) {
        return (view.ctx.tr.addFaceBytes(data))
    }

    fn loadDemo:void () {
        book.clear()
        def sheet:SpreadsheetModel (new SpreadsheetModel)
        sheet.seedDemo()
        book.addSheet(sheet)
        book.sourcePath = ""
        book.setActive(0)
        engine.attach(book)
        engine.rebuildAll()
        this.syncActiveModel()
        loadError = ""
    }

    ; The workbook from bytes: what a browser has after a fetch, and what a
    ; drag-and-dropped file is. Same path as `loadXlsx` past the read.
    fn loadXlsxBytes:boolean (bytes:buffer name:string) {
        return (this.loadXlsxBytesPassword(bytes name ""))
    }

    fn loadXlsxBytesPassword:boolean (bytes:buffer name:string password:string) {
        def loader:XlsxLoader (new XlsxLoader)
        def ok:boolean (loader.loadBytesPassword(bytes book password))
        if ok {
            view.chartLayer.removeAll(windows)
            book.sourcePath = name
            engine = loader.engine
            this.syncActiveModel()
            loadError = ""
            view.status = ("loaded " + name)
            return true
        }
        loadError = loader.lastError
        view.status = loadError
        return false
    }

    fn loadXlsx:boolean (fullPath:string) {
        return (this.loadXlsxPassword(fullPath ""))
    }

    fn loadXlsxPassword:boolean (fullPath:string password:string) {
        def loader:XlsxLoader (new XlsxLoader)
        def ok:boolean (loader.loadPathPassword(fullPath book password))
        if ok {
            ; The charts belonged to the workbook that was open. Left up, they
            ; would go on drawing ranges of a document nobody has any more.
            view.chartLayer.removeAll(windows)
            book.sourcePath = fullPath
            engine = loader.engine
            this.syncActiveModel()
            loadError = ""
            view.status = ("loaded " + fullPath)
            return true
        }
        loadError = loader.lastError
        view.status = loadError
        return false
    }

    ; The host's clock, in the only form the engine cares about. A platform
    ; that has a calendar calls this once at start-up; a test calls it with the
    ; date it wants to reason about.
    fn setToday:void (y:int m:int d:int) {
        engine.todaySerial = (DateSerial.fromYMD(y m d))
    }

    ; --- the command surface ---------------------------------------------------
    fn buildCommands:void () {
        if commandsReady {
            return
        }
        commandsReady = true
        commands.add("file.open" "Open a workbook…" "File" "Ctrl+O")
        commands.add("file.save" "Save as .xlsx" "File" "Ctrl+S")
        commands.add("file.saveAs" "Save a copy as…" "File" "Ctrl+Shift+S")
        commands.add("edit.undo" "Undo" "Edit" "Ctrl+Z")
        commands.add("edit.redo" "Redo" "Edit" "Ctrl+Y")
        commands.add("edit.copy" "Copy" "Edit" "Ctrl+C")
        commands.add("chart.copy" "Copy chart (picture + data)" "Chart" "Ctrl+C")
        commands.add("edit.cut" "Cut" "Edit" "Ctrl+X")
        commands.add("edit.paste" "Paste" "Edit" "Ctrl+V")
        commands.add("edit.pasteSpecial" "Paste special…" "Edit" "Ctrl+Shift+V")
        commands.add("edit.clear" "Clear contents" "Edit" "Delete")
        commands.add("edit.formatPainter" "Copy formatting" "Edit" "Ctrl+Shift+C")
        commands.add("edit.find" "Find and replace…" "Edit" "Ctrl+F")
        commands.add("insert.row.above" "Insert row above" "Insert" "")
        commands.add("insert.row.below" "Insert row below" "Insert" "")
        commands.add("insert.column.left" "Insert column left" "Insert" "")
        commands.add("insert.column.right" "Insert column right" "Insert" "")
        commands.add("insert.chart" "Chart from selection…" "Insert" "Ctrl+M")
        commands.add("insert.link" "Hyperlink…" "Insert" "Ctrl+K")
        commands.add("delete.rows" "Delete rows" "Insert" "")
        commands.add("delete.columns" "Delete columns" "Insert" "")
        commands.add("move.row.up" "Move row up" "Insert" "")
        commands.add("move.row.down" "Move row down" "Insert" "")
        commands.add("move.column.left" "Move column left" "Insert" "")
        commands.add("move.column.right" "Move column right" "Insert" "")
        ; Formatting. The grid could paint every one of these and set none of
        ; them; a toolbar with nothing behind it would have been a picture of a
        ; spreadsheet.
        commands.add("format.bold" "Bold" "Format" "Ctrl+B")
        commands.add("format.italic" "Italic" "Format" "Ctrl+I")
        commands.add("format.underline" "Underline" "Format" "Ctrl+U")
        commands.add("format.strike" "Strikethrough" "Format" "")
        commands.addArg("format.align" "Horizontal alignment" "Format" "")
        commands.addArg("format.valign" "Vertical alignment" "Format" "")
        commands.add("format.wrap" "Wrap text" "Format" "")
        commands.add("format.merge" "Merge or unmerge cells" "Format" "")
        commands.addArg("format.border" "Borders" "Format" "")
        commands.addArg("format.fill" "Fill colour" "Format" "")
        commands.addArg("format.color" "Text colour" "Format" "")
        commands.addArg("format.numfmt" "Number format" "Format" "")
        commands.addArg("format.decimals" "Decimal places" "Format" "")
        commands.add("format.size.up" "Bigger text" "Format" "")
        commands.add("format.size.down" "Smaller text" "Format" "")
        commands.addArg("format.size" "Font size" "Format" "")
        commands.addArg("format.size.pick" "Font size…" "Format" "")
        commands.addArg("format.font" "Font" "Format" "")
        commands.add("format.clear" "Clear formatting" "Format" "")
        commands.add("view.freeze.here" "Freeze panes here" "View" "")
        commands.add("view.freeze.none" "Unfreeze panes" "View" "")
        commands.add("format.autofit.column" "Auto-fit column width" "Format" "")
        commands.add("format.autofit.row" "Auto-fit row height" "Format" "")
        commands.add("format.conditional" "Conditional formatting…" "Format" "Ctrl+L")
        commands.add("data.sort.asc" "Sort ascending" "Data" "")
        commands.add("data.sort.desc" "Sort descending" "Data" "")
        commands.add("data.filter.clear" "Clear filter" "Data" "")
        commands.add("data.validation" "Data validation…" "Data" "Ctrl+E")
        commands.add("select.all" "Select all" "Select" "Ctrl+A")
        commands.add("select.column" "Select column" "Select" "Ctrl+Space")
        commands.add("select.row" "Select row" "Select" "Shift+Space")
        commands.addArg("nav.goto" "Go to cell" "Select" "")
        commands.add("view.sheet.next" "Next sheet" "View" "")
        commands.add("view.sheet.prev" "Previous sheet" "View" "")
    }

    ; A tool the host adds. It appears in the table, and on the status bar, and
    ; running it puts its id in the mailbox rather than doing anything here —
    ; the host is the only thing that knows what its own tool means.
    fn addCustomCommand:void (id:string label:string group:string) {
        this.buildCommands()
        if (commands.has(id)) {
            return
        }
        commands.addCustom(id label group)
    }

    ; Collect the pending custom invocation, if any, and clear it. Returns ""
    ; when nothing is waiting.
    fn takeCustomCommand:string () {
        def id:string pendingCustom
        pendingCustom = ""
        return id
    }

    fn takeCustomArg:string () {
        def a:string pendingCustomArg
        pendingCustomArg = ""
        return a
    }

    ; A1 → move there. Anything unparseable leaves the selection alone.
    fn gotoCell:boolean (ref:string) {
        def rows:[int]
        def cols:[int]
        XlsxWorksheet.parseCellRef(ref rows cols)
        if ((array_length rows) == 0) {
            return false
        }
        def r:int (itemAt rows 0)
        def c:int (itemAt cols 0)
        if (r < 0) {
            return false
        }
        if (c < 0) {
            return false
        }
        this.ensureExtent(r c)
        this.moveActive(r c false)
        return true
    }

    ; Run one command by name. Returns false for a name the table does not
    ; have, so a host can tell a typo from a no-op.
    fn runCommand:boolean (id:string arg:string) {
        this.buildCommands()
        def cmd:GridCommand (commands.find(id))
        if ((strlen cmd.id) == 0) {
            return false
        }
        if cmd.custom {
            pendingCustom = id
            pendingCustomArg = arg
            view.status = ("tool: " + cmd.label)
            return true
        }
        if editing {
            this.commitEdit()
        }
        if (id == "file.open") {
            fileRequest = "open"
            view.status = "open a workbook…"
            return true
        }
        if (id == "file.saveAs") {
            fileRequest = "saveAs"
            view.status = "save a copy as…"
            return true
        }
        if (id == "file.save") {
            return (this.saveXlsxDefault())
        }
        if (id == "edit.undo") {
            this.undoEdit()
            return true
        }
        if (id == "edit.redo") {
            this.redoEdit()
            return true
        }
        ; Everything the toolbar's formatting buttons do. One place, so the
        ; keyboard, the buttons and a host over a socket cannot drift.
        if ((strlen id) > 7) {
            if ((substring id 0 7) == "format.") {
                def handled:boolean (this.runFormatCommand(id arg))
                if handled {
                    return true
                }
            }
        }
        if (id == "view.freeze.here") {
            model.freezeRows = sel.active.row
            model.freezeCols = sel.active.col
            model.version = (model.version + 1)
            grid.updateVisible(model)
            return true
        }
        if (id == "view.freeze.none") {
            model.freezeRows = 0
            model.freezeCols = 0
            model.version = (model.version + 1)
            grid.updateVisible(model)
            return true
        }
        if (id == "edit.copy") {
            this.copySelection()
            return true
        }
        if (id == "chart.copy") {
            def which:int (this.focusedChartId())
            if (which == 0) {
                if ((view.chartLayer.count()) == 1) {
                    def only:ChartPanel (view.chartLayer.panelAt(0))
                    which = only.chart.id
                }
            }
            if (which == 0) {
                clipboardNote = "no chart to copy"
                return false
            }
            return ((this.copyChart(which)) > 0)
        }
        if (id == "edit.cut") {
            this.cutSelection()
            return true
        }
        if (id == "edit.paste") {
            this.pasteClipboard()
            return true
        }
        if (id == "edit.pasteSpecial") {
            this.openPasteSpecial()
            return true
        }
        if (id == "edit.clear") {
            this.clearSelection()
            return true
        }
        if (id == "edit.formatPainter") {
            this.copyFormat()
            return true
        }
        if (id == "edit.find") {
            this.openFindDialog()
            return true
        }
        if (id == "insert.row.above") {
            this.insertRowAboveSelection()
            return true
        }
        if (id == "insert.row.below") {
            this.insertRowBelowSelection()
            return true
        }
        if (id == "insert.column.left") {
            this.insertColumnLeftOfSelection()
            return true
        }
        if (id == "insert.column.right") {
            this.insertColumnRightOfSelection()
            return true
        }
        if (id == "insert.chart") {
            this.openChartDialog(0)
            return true
        }
        if (id == "insert.link") {
            this.openLinkDialog()
            return true
        }
        if (id == "delete.rows") {
            this.deleteSelectedRows()
            return true
        }
        if (id == "delete.columns") {
            this.deleteSelectedColumns()
            return true
        }
        if (id == "move.row.up") {
            this.moveSelectedRow(-1)
            return true
        }
        if (id == "move.row.down") {
            this.moveSelectedRow(1)
            return true
        }
        if (id == "move.column.left") {
            this.moveSelectedColumn(-1)
            return true
        }
        if (id == "move.column.right") {
            this.moveSelectedColumn(1)
            return true
        }
        if (id == "format.autofit.column") {
            this.autoFitColumn(sel.active.col)
            return true
        }
        if (id == "format.autofit.row") {
            this.autoFitRow(sel.active.row)
            return true
        }
        if (id == "format.conditional") {
            cfStatus = ""
            this.openCfDialog()
            return true
        }
        if (id == "data.sort.asc") {
            this.applySort(sel.active.col true)
            return true
        }
        if (id == "data.sort.desc") {
            this.applySort(sel.active.col false)
            return true
        }
        if (id == "data.filter.clear") {
            this.clearFilter()
            return true
        }
        if (id == "data.validation") {
            dvStatus = ""
            this.openValidationDialog()
            return true
        }
        if (id == "select.all") {
            sel.selectAll(model)
            return true
        }
        if (id == "select.column") {
            this.selectColumn(sel.active.col)
            return true
        }
        if (id == "select.row") {
            this.selectRow(sel.active.row)
            return true
        }
        if (id == "nav.goto") {
            return (this.gotoCell(arg))
        }
        if (id == "view.sheet.next") {
            this.setActiveSheet((book.activeIndex + 1))
            return true
        }
        if (id == "view.sheet.prev") {
            this.setActiveSheet((book.activeIndex - 1))
            return true
        }
        return false
    }

    ; --- saving ---------------------------------------------------------------
    ; The workbook, written back out as .xlsx. The loader and the writer share
    ; the model, so what comes back is what was there — see XlsxWriteTest, and
    ; tools/check_export.py for the same file read by openpyxl.
    fn saveXlsx:boolean (dir:string name:string) {
        if editing {
            this.commitEdit()
        }
        def w:XlsxWriter (new XlsxWriter)
        def ok:boolean (w.write(book dir name))
        if ok {
            savedPath = (dir + "/" + name)
            ; Next Save should overwrite this file, not invent a -export copy.
            book.sourcePath = savedPath
            view.status = ("saved " + savedPath)
        } {
            savedPath = ""
            view.status = ("save failed: " + w.lastError)
        }
        return ok
    }

    ; Where Ctrl+S puts it when nobody said: beside the file it came from, with
    ; a name that cannot overwrite it.
    sfn exportDir:string (source:string) {
        def cut:int -1
        def i:int 0
        while (i < (strlen source)) {
            if ((charAt source i) == 47) {
                cut = i
            }
            i = (i + 1)
        }
        if (cut < 0) {
            return "."
        }
        return (substring source 0 cut)
    }

    ; The file part of a path, as written. `exportName` below is a different
    ; question — what to call a copy — and answering both with one function is
    ; how a "save as" ends up writing `sheet-export.xlsx` when the person
    ; typed `sheet.xlsx`.
    sfn baseName:string (source:string) {
        def cut:int -1
        def i:int 0
        while (i < (strlen source)) {
            if ((charAt source i) == 47) {
                cut = i
            }
            i = (i + 1)
        }
        def file:string source
        if (cut >= 0) {
            file = (substring source (cut + 1) (strlen source))
        }
        if ((strlen file) == 0) {
            return "workbook.xlsx"
        }
        return file
    }

    sfn exportName:string (source:string) {
        def cut:int -1
        def i:int 0
        while (i < (strlen source)) {
            if ((charAt source i) == 47) {
                cut = i
            }
            i = (i + 1)
        }
        def file:string source
        if (cut >= 0) {
            file = (substring source (cut + 1) (strlen source))
        }
        if ((strlen file) == 0) {
            return "workbook-export.xlsx"
        }
        def dot:int -1
        def k:int 0
        while (k < (strlen file)) {
            if ((charAt file k) == 46) {
                dot = k
            }
            k = (k + 1)
        }
        if (dot > 0) {
            file = (substring file 0 dot)
        }
        return (file + "-export.xlsx")
    }

    ; Ctrl+S / toolbar Save: overwrite the file we opened. If there is none yet,
    ; ask the host for a path (Save As). Headless `--save` uses
    ; `saveXlsxDefaultSilent` so it never blocks on a dialog.
    fn saveXlsxDefault:boolean () {
        def src:string book.sourcePath
        if ((strlen src) == 0) {
            fileRequest = "saveAs"
            view.status = "save a workbook as…"
            return true
        }
        return (this.saveXlsx((GridApp.exportDir(src)) (GridApp.baseName(src))))
    }

    ; Write without prompting — used by CLI `--save` and tests.
    fn saveXlsxDefaultSilent:boolean () {
        def src:string book.sourcePath
        if ((strlen src) == 0) {
            return (this.saveXlsx("." "workbook-export.xlsx"))
        }
        return (this.saveXlsx((GridApp.exportDir(src)) (GridApp.baseName(src))))
    }

    fn setActiveSheet:void (i:int) {
        if editing {
            this.commitEdit()
        }
        ; save scroll for current sheet
        model.scrollXSaved = grid.scrollX
        model.scrollYSaved = grid.scrollY
        ; skip hidden sheets
        def n:int (book.sheetCount())
        if (i < 0) {
            i = 0
        }
        if (i >= n) {
            i = (n - 1)
        }
        def guard:int 0
        while (guard < n) {
            def cand:SpreadsheetModel (book.sheetAt(i))
            if (cand.sheetHidden == false) {
                break
            }
            i = (i + 1)
            if (i >= n) {
                i = 0
            }
            guard = (guard + 1)
        }
        book.setActive(i)
        this.syncActiveModel()
        view.chartLayer.showSheet(book.activeIndex)
    }

    ; --- column sizing --------------------------------------------------------
    ; Auto-fit: widest painted cell in the column, plus the cell padding. The
    ; scan is capped so a 100k-row sheet stays instant — Excel samples too.
    fn autoFitColumn:void (col:int) {
        if (col < 0) {
            return
        }
        if (col >= model.colCount) {
            return
        }
        def best:int (view.measureText((SpreadsheetModel.colLabel(col))))
        def last:int (model.usedRow())
        if (last > 4999) {
            last = 4999
        }
        def r:int 0
        while (r <= last) {
            def txt:string (model.getDisplay(r col))
            if ((strlen txt) > 0) {
                def w:int (view.measureText(txt))
                if (w > best) {
                    best = w
                }
            }
            r = (r + 1)
        }
        def target:int (best + 16)
        if (target < 32) {
            target = 32
        }
        if (target > 600) {
            target = 600
        }
        this.setColumnWidths(col target)
    }

    ; Set a width on `col`, and on every other selected column when the one
    ; being sized is part of the selection — the way Excel resizes a block.
    fn setColumnWidths:void (col:int width:int) {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def lo:int col
        def hi:int col
        if ((col >= a.col) && (col <= b.col)) {
            if (a.col != b.col) {
                lo = a.col
                hi = b.col
            }
        }
        def c:int lo
        while (c <= hi) {
            model.setColWidth(c width)
            c = (c + 1)
        }
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    ; Double-click on a header edge (or anywhere in a header) auto-fits it.
    fn autoFitAt:boolean (px:int py:int) {
        def edgeCol:int (grid.hitColResize(model px py))
        if (edgeCol >= 0) {
            this.autoFitColumn(edgeCol)
            return true
        }
        if (this.autoFitRowAt(px py)) {
            return true
        }
        def hit:CellPos (grid.hitTest(model px py))
        if ((hit.row == -2) && (hit.col >= 0)) {
            this.autoFitColumn(hit.col)
            return true
        }
        return false
    }

    ; Row height that fits wrapped content — the counterpart of column auto-fit.
    fn autoFitRow:void (row:int) {
        if (row < 0) {
            return
        }
        if (row >= model.rowCount) {
            return
        }
        def best:int model.defaultRowH
        def c:int 0
        def lastCol:int (model.usedCol())
        while (c <= lastCol) {
            def txt:string (model.getDisplay(row c))
            if ((strlen txt) > 0) {
                def st:CellStyle (model.getCellStyle(row c))
                def need:int (view.measureWrappedHeight(txt (model.colWidth(c)) st))
                if (need > best) {
                    best = need
                }
            }
            c = (c + 1)
        }
        if (best > 400) {
            best = 400
        }
        model.setRowHeight(row best)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    ; Grow one row to fit what is now in it — and only grow.
    ;
    ; A spreadsheet makes room when the type gets bigger: put 20pt in a row and
    ; the row becomes 20pt tall, in Excel and in Sheets alike. Shrinking when
    ; the type gets smaller is a separate call (`fitRowToContent`), because a
    ; height the user dragged out should not vanish on an unrelated edit.
    fn growRowToFit:boolean (row:int) {
        return (this.fitRowToContent(row false))
    }

    ; Set the row to the height its contents need. `allowShrink` is true when
    ; the type just got smaller — then taking the room back is the point.
    fn fitRowToContent:boolean (row:int allowShrink:boolean) {
        if (row < 0) {
            return false
        }
        if (row >= model.rowCount) {
            return false
        }
        def want:int model.defaultRowH
        def c:int 0
        def lastCol:int (model.usedCol())
        while (c <= lastCol) {
            def txt:string (model.getDisplay(row c))
            ; A cell counts if it has something in it OR a format of its own:
            ; set an empty cell to 20 point and the row makes room for 20
            ; point, which is what happens when you do it in a spreadsheet.
            def counts:boolean ((strlen txt) > 0)
            if ((model.getCellStyleId(row c)) >= 0) {
                counts = true
            }
            if counts {
                def st:CellStyle (model.getCellStyle(row c))
                def need:int (view.measureWrappedHeight(txt (model.colWidth(c)) st))
                if (need > want) {
                    want = need
                }
            }
            c = (c + 1)
        }
        if (want > 400) {
            want = 400
        }
        def cur:int (model.rowHeight(row))
        if (want == cur) {
            return false
        }
        if (want < cur) {
            if (allowShrink == false) {
                return false
            }
        }
        model.setRowHeight(row want)
        return true
    }

    ; The same over every row the selection touches, plus the caret's own row,
    ; refreshing the view once if anything moved.
    fn growSelectedRowsToFit:void () {
        this.fitSelectedRowsToContent(false)
    }

    fn fitSelectedRowsToContent:void (allowShrink:boolean) {
        def moved:boolean (this.fitRowToContent(sel.active.row allowShrink))
        def i:int 0
        while (i < (sel.rangeCount())) {
            def rg:GridRange (sel.rangeAt(i))
            def r:int rg.r0
            def last:int rg.r1
            while (r <= last) {
                if (this.fitRowToContent(r allowShrink)) {
                    moved = true
                }
                r = (r + 1)
            }
            i = (i + 1)
        }
        if moved {
            sheetView.markDirty()
            sheetView.rebuild()
            grid.updateVisible(model)
        }
    }

    ; Double-click on a row header edge auto-fits its height.
    fn autoFitRowAt:boolean (px:int py:int) {
        def edgeRow:int (grid.hitRowResize(model px py))
        if (edgeRow >= 0) {
            this.autoFitRow(edgeRow)
            return true
        }
        return false
    }

    ; --- column structure -----------------------------------------------------
    ; Insert / delete / move a column. The data move lives in SpreadsheetModel;
    ; what belongs here is repairing every formula in the WORKBOOK that pointed
    ; into the edited sheet — including cross-sheet references naming it — and
    ; rebuilding the dependency graph afterwards.
    fn adjustFormulasForColumns:void (at:int delta:int) {
        this.adjustFormulasFor(true at delta)
    }

    ; Rows and columns repair the same way — the only difference is which
    ; coordinate of a reference moves — so they share one walk.
    fn adjustFormulasForRows:void (at:int delta:int) {
        this.adjustFormulasFor(false at delta)
    }

    fn adjustFormulasFor:void (columns:boolean at:int delta:int) {
        def sheetName:string model.name
        def si:int 0
        def sn:int (book.sheetCount())
        while (si < sn) {
            def sheet:SpreadsheetModel (book.sheetAt(si))
            def sameSheet:boolean (si == book.activeIndex)
            def keys:[string]
            def texts:[string]
            sheet.snapshotFormulas(keys texts)
            def i:int 0
            while (i < (array_length keys)) {
                def key:string (itemAt keys i)
                def expr:string (itemAt texts i)
                ; On another sheet only qualified references naming the edited
                ; sheet move; unprefixed local refs must stay put.
                def rewritten:string ""
                if columns {
                    rewritten = (FormulaParser.adjustColumns(expr sheetName at delta sameSheet))
                } {
                    rewritten = (FormulaParser.adjustRows(expr sheetName at delta sameSheet))
                }
                if ((strlen rewritten) > 0) {
                    if (rewritten != expr) {
                        set sheet.formulas key rewritten
                    }
                }
                i = (i + 1)
            }
            si = (si + 1)
        }
        model.version = (model.version + 1)
    }

    ; Snapshot formulas on every sheet except the active one onto the last
    ; structural undo op — active-sheet formulas are already in savedKeys.
    fn snapshotOtherSheetFormulas:void () {
        def n:int (array_length model.undoStack)
        if (n <= 0) {
            return
        }
        def op:SpreadsheetUndoOp (itemAt model.undoStack (n - 1))
        clear op.otherSheetIdx
        clear op.otherKeys
        clear op.otherTexts
        def si:int 0
        def sn:int (book.sheetCount())
        while (si < sn) {
            if (si != book.activeIndex) {
                def sheet:SpreadsheetModel (book.sheetAt(si))
                def keys:[string]
                def texts:[string]
                sheet.snapshotFormulas(keys texts)
                def i:int 0
                while (i < (array_length keys)) {
                    push op.otherSheetIdx si
                    push op.otherKeys (itemAt keys i)
                    push op.otherTexts (itemAt texts i)
                    i = (i + 1)
                }
            }
            si = (si + 1)
        }
    }

    fn restoreOtherSheetFormulas:void (op:SpreadsheetUndoOp) {
        ; Restore per sheet so wipe+write stays local to that model.
        def sn:int (book.sheetCount())
        def si:int 0
        while (si < sn) {
            if (si != book.activeIndex) {
                def keys:[string]
                def texts:[string]
                def i:int 0
                while (i < (array_length op.otherSheetIdx)) {
                    if ((itemAt op.otherSheetIdx i) == si) {
                        push keys (itemAt op.otherKeys i)
                        push texts (itemAt op.otherTexts i)
                    }
                    i = (i + 1)
                }
                def sheet:SpreadsheetModel (book.sheetAt(si))
                sheet.restoreFormulas(keys texts)
            }
            si = (si + 1)
        }
    }

    ; Redo of a structural op only replays the raw insert/delete/move — formula
    ; text must be shifted again the same way the forward path did.
    fn reapplyStructFormulaAdjust:void (op:SpreadsheetUndoOp) {
        if (op.structKind == 1) {
            this.adjustFormulasForColumns(op.structAt 1)
        }
        if (op.structKind == 2) {
            this.adjustFormulasForColumns(op.structAt -1)
        }
        if (op.structKind == 3) {
            this.adjustFormulasForColumns(op.structAt -1)
            this.adjustFormulasForColumns(op.structTo 1)
        }
        if (op.structKind == 4) {
            this.adjustFormulasForRows(op.structAt 1)
        }
        if (op.structKind == 5) {
            this.adjustFormulasForRows(op.structAt -1)
        }
        if (op.structKind == 6) {
            this.adjustFormulasForRows(op.structAt -1)
            this.adjustFormulasForRows(op.structTo 1)
        }
    }

    fn afterStructuralChange:void () {
        sheetView.markDirty()
        sheetView.rebuild()
        engine.rebuildAll()
        grid.updateVisible(model)
    }

    ; After any cell value/formula mutation: if sort or filter is on, the view
    ; order may have changed and must be rebuilt before paint / hit-test.
    fn afterCellMutation:void () {
        if ((model.sortCol >= 0) || model.filterEnabled) {
            sheetView.markDirty()
            sheetView.rebuild()
        }
        grid.updateVisible(model)
    }

    fn insertColumn:void (at:int) {
        if (at < 0) {
            return
        }
        model.beginTx()
        model.pushStructOp(1 at 0)
        this.snapshotOtherSheetFormulas()
        model.insertColumnRaw(at)
        model.endTx()
        this.adjustFormulasForColumns(at 1)
        this.afterStructuralChange()
    }

    fn deleteColumn:void (at:int) {
        if (at < 0) {
            return
        }
        if (at >= model.colCount) {
            return
        }
        model.beginTx()
        model.pushStructOp(2 at 0)
        this.snapshotOtherSheetFormulas()
        model.deleteColumnRaw(at)
        model.endTx()
        this.adjustFormulasForColumns(at -1)
        this.afterStructuralChange()
    }

    fn moveColumn:void (from:int to:int) {
        if (from == to) {
            return
        }
        if (from < 0) {
            return
        }
        if (from >= model.colCount) {
            return
        }
        if (to < 0) {
            return
        }
        if (to >= model.colCount) {
            return
        }
        model.beginTx()
        model.pushStructOp(3 from to)
        this.snapshotOtherSheetFormulas()
        model.moveColumnRaw(from to)
        model.endTx()
        ; A move is a delete followed by an insert, so refs shift twice.
        this.adjustFormulasForColumns(from -1)
        this.adjustFormulasForColumns(to 1)
        this.afterStructuralChange()
    }

    fn insertColumnLeftOfSelection:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        this.insertColumn(a.col)
    }

    fn insertColumnRightOfSelection:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        this.insertColumn((b.col + 1))
    }

    fn deleteSelectedColumns:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def count:int ((b.col - a.col) + 1)
        def i:int 0
        while (i < count) {
            this.deleteColumn(a.col)
            i = (i + 1)
        }
        sel.anchor.col = a.col
        sel.active.col = a.col
        def p:CellPos (CellPos.create(sel.active.row sel.active.col))
        model.clampPos(p)
        sel.setActive(p.row p.col)
        sel.collapseToActive()
    }

    fn moveSelectedColumn:void (delta:int) {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def from:int a.col
        def to:int (from + delta)
        if (to < 0) {
            return
        }
        if (to >= model.colCount) {
            return
        }
        this.moveColumn(from to)
        sel.anchor.col = to
        sel.active.col = to
    }

    ; --- format painter -------------------------------------------------------
    ; Ctrl+Shift+C picks up the active cell's formatting; the next selection it
    ; is applied to gets it, and the brush disarms — like every office app.
    ; --- row structure --------------------------------------------------------
    ; The column actions, transposed. Same transaction, same workbook-wide
    ; formula repair, same one-step undo.
    fn insertRow:void (at:int) {
        if (at < 0) {
            return
        }
        model.beginTx()
        model.pushStructOp(4 at 0)
        this.snapshotOtherSheetFormulas()
        model.insertRowRaw(at)
        model.endTx()
        this.adjustFormulasForRows(at 1)
        this.afterStructuralChange()
    }

    fn deleteRow:void (at:int) {
        if (at < 0) {
            return
        }
        if (at >= model.rowCount) {
            return
        }
        model.beginTx()
        model.pushStructOp(5 at 0)
        this.snapshotOtherSheetFormulas()
        model.deleteRowRaw(at)
        model.endTx()
        this.adjustFormulasForRows(at -1)
        this.afterStructuralChange()
    }

    fn moveRow:void (from:int to:int) {
        if (from == to) {
            return
        }
        if (from < 0) {
            return
        }
        if (from >= model.rowCount) {
            return
        }
        if (to < 0) {
            return
        }
        if (to >= model.rowCount) {
            return
        }
        model.beginTx()
        model.pushStructOp(6 from to)
        this.snapshotOtherSheetFormulas()
        model.moveRowRaw(from to)
        model.endTx()
        this.adjustFormulasForRows(from -1)
        this.adjustFormulasForRows(to 1)
        this.afterStructuralChange()
    }

    fn insertRowAboveSelection:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        this.insertRow(a.row)
    }

    fn insertRowBelowSelection:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        this.insertRow((b.row + 1))
    }

    fn deleteSelectedRows:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def count:int ((b.row - a.row) + 1)
        def i:int 0
        while (i < count) {
            this.deleteRow(a.row)
            i = (i + 1)
        }
        sel.anchor.row = a.row
        sel.active.row = a.row
        def p:CellPos (CellPos.create(sel.active.row sel.active.col))
        model.clampPos(p)
        sel.setActive(p.row p.col)
        sel.collapseToActive()
    }

    fn moveSelectedRow:void (delta:int) {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def from:int a.row
        def to:int (from + delta)
        if (to < 0) {
            return
        }
        if (to >= model.rowCount) {
            return
        }
        this.moveRow(from to)
        sel.anchor.row = to
        sel.active.row = to
    }

    fn copyFormat:void () {
        def st:CellStyle (model.getCellStyle(sel.active.row sel.active.col))
        formatBrush = (st.copy())
        formatBrushArmed = true
        view.status = "format brush armed"
    }

    fn applyFormatToSelection:void () {
        if (formatBrushArmed == false) {
            return
        }
        model.beginTx()
        def gi:int 0
        while (gi < (sel.rangeCount())) {
            def g:GridRange (sel.rangeAt(gi))
            def r:int g.r0
            while (r <= g.r1) {
                def c:int g.c0
                while (c <= g.c1) {
                    model.applyEditStyled(r c (model.getCell(r c)) (model.getFormula(r c)) formatBrush)
                    c = (c + 1)
                }
                r = (r + 1)
            }
            gi = (gi + 1)
        }
        model.endTx()
        formatBrushArmed = false
        view.status = "format applied"
    }

    fn cancelFormatBrush:void () {
        formatBrushArmed = false
    }

    fn nudgeColumnWidth:void (col:int delta:int) {
        if (col < 0) {
            return
        }
        def w:int ((model.colWidth(col)) + delta)
        if (w < 24) {
            w = 24
        }
        if (w > 600) {
            w = 600
        }
        this.setColumnWidths(col w)
    }

    fn applySort:void (col:int ascending:boolean) {
        model.setSort(col ascending)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    fn applyFilter:void (col:int values:[string]) {
        model.setFilter(col true values)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    fn clearFilter:void () {
        def empty:[string]
        model.setFilter(-1 false empty)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    fn collectUnique:void (col:int out:[string]) {
        clear out
        def seen:[string:boolean]
        def r:int model.freezeRows
        while (r < model.rowCount) {
            def v:string (model.getCell(r col))
            if ((has seen v) == false) {
                set seen v true
                push out v
            }
            r = (r + 1)
        }
    }

    fn openHeaderMenu:void (col:int px:int py:int) {
        view.menuOpen = true
        view.menuKind = 0
        view.menuCol = col
        view.menuRow = -1
        view.menuH = 270
        view.menuX = px
        view.menuY = py
    }

    ; The row header's own menu. Rows have no sort or filter — those belong to
    ; a column — so its first item is the selection a click on the header would
    ; have made, and the rest are the structural actions.
    fn openRowMenu:void (row:int px:int py:int) {
        view.menuOpen = true
        view.menuKind = 1
        view.menuRow = row
        view.menuCol = -1
        view.menuH = 212
        view.menuX = px
        view.menuY = py
    }

    fn closeHeaderMenu:void () {
        view.menuOpen = false
        view.menuCol = -1
        view.menuRow = -1
        view.menuKind = 0
        view.menuH = 270
        view.menuW = 190
    }

    fn menuItemCount:int () {
        if (view.menuKind == 1) {
            return 9
        }
        if (view.menuKind == 2) {
            return (GridApp.fontSizeCount())
        }
        if (view.menuKind == 3) {
            return (GridApp.fontNameCount())
        }
        return 12
    }

    sfn fontSizeCount:int () {
        return 12
    }

    sfn fontSizeAt:string (i:int) {
        if (i == 0) { return "8" }
        if (i == 1) { return "9" }
        if (i == 2) { return "10" }
        if (i == 3) { return "11" }
        if (i == 4) { return "12" }
        if (i == 5) { return "14" }
        if (i == 6) { return "16" }
        if (i == 7) { return "18" }
        if (i == 8) { return "20" }
        if (i == 9) { return "24" }
        if (i == 10) { return "28" }
        if (i == 11) { return "36" }
        return "11"
    }

    sfn fontNameCount:int () {
        return 10
    }

    sfn fontNameAt:string (i:int) {
        if (i == 0) { return "Calibri" }
        if (i == 1) { return "Arial" }
        if (i == 2) { return "Times New Roman" }
        if (i == 3) { return "Georgia" }
        if (i == 4) { return "Courier New" }
        if (i == 5) { return "Open Sans" }
        if (i == 6) { return "Noto Sans" }
        if (i == 7) { return "Helvetica" }
        if (i == 8) { return "Droid Serif" }
        if (i == 9) { return "Josefin Sans" }
        return "Calibri"
    }

    fn openFontSizeMenu:void (px:int py:int) {
        view.menuOpen = true
        view.menuKind = 2
        view.menuCol = -1
        view.menuRow = -1
        view.menuW = 72
        view.menuH = (26 + ((GridApp.fontSizeCount()) * 20) + 4)
        view.menuX = px
        view.menuY = py
    }

    fn openFontNameMenu:void (px:int py:int) {
        view.menuOpen = true
        view.menuKind = 3
        view.menuCol = -1
        view.menuRow = -1
        view.menuW = 160
        view.menuH = (26 + ((GridApp.fontNameCount()) * 20) + 4)
        view.menuX = px
        view.menuY = py
    }

    fn runFontSizeMenu:void (action:int) {
        if (action < 1) {
            return
        }
        def idx:int (action - 1)
        if (idx >= (GridApp.fontSizeCount())) {
            this.closeHeaderMenu()
            return
        }
        def pt:string (GridApp.fontSizeAt(idx))
        this.closeHeaderMenu()
        this.runFormatCommand("format.size" pt)
    }

    fn runFontNameMenu:void (action:int) {
        if (action < 1) {
            return
        }
        def idx:int (action - 1)
        if (idx >= (GridApp.fontNameCount())) {
            this.closeHeaderMenu()
            return
        }
        def name:string (GridApp.fontNameAt(idx))
        this.closeHeaderMenu()
        this.runFormatCommand("format.font" name)
    }

    fn hitHeaderMenu:int (px:int py:int) {
        if (view.menuOpen == false) {
            return -1
        }
        if (px < view.menuX) {
            return -1
        }
        if (py < view.menuY) {
            return -1
        }
        if (px >= (view.menuX + view.menuW)) {
            return -1
        }
        if (py >= (view.menuY + view.menuH)) {
            return -1
        }
        ; Rows are 20px on a 26px title, which is what both menus are painted
        ; at. 0 means "inside the popup but not on an item", which still counts
        ; as a hit — it must not fall through to the sheet.
        def ly:int (py - view.menuY)
        if (ly < 26) {
            return 0
        }
        def idx:int ((idiv (ly - 26) 20) + 1)
        if (idx > (this.menuItemCount())) {
            return 0
        }
        return idx
    }

    fn runHeaderMenu:void (action:int) {
        if (view.menuKind == 1) {
            this.runRowMenu(action)
            return
        }
        if (view.menuKind == 2) {
            this.runFontSizeMenu(action)
            return
        }
        if (view.menuKind == 3) {
            this.runFontNameMenu(action)
            return
        }
        def col:int view.menuCol
        if (action == 1) {
            this.applySort(col true)
        }
        if (action == 2) {
            this.applySort(col false)
        }
        if (action == 3) {
            def vals:[string]
            this.collectUnique(col vals)
            ; keep at most first value for a visible demo filter when many uniques
            if ((array_length vals) > 1) {
                def keep:[string]
                push keep (itemAt vals 0)
                this.applyFilter(col keep)
            } {
                this.applyFilter(col vals)
            }
        }
        if (action == 4) {
            this.clearFilter()
        }
        if (action == 5) {
            this.autoFitColumn(col)
        }
        if (action == 6) {
            this.nudgeColumnWidth(col 20)
        }
        if (action == 7) {
            this.nudgeColumnWidth(col -20)
        }
        if (action == 8) {
            this.insertColumn(col)
        }
        if (action == 9) {
            this.insertColumn((col + 1))
        }
        if (action == 10) {
            this.deleteColumn(col)
        }
        if (action == 11) {
            this.moveColumn(col (col - 1))
        }
        if (action == 12) {
            this.moveColumn(col (col + 1))
        }
        this.closeHeaderMenu()
    }

    fn runRowMenu:void (action:int) {
        def row:int view.menuRow
        if (row < 0) {
            this.closeHeaderMenu()
            return
        }
        if (action == 1) {
            this.selectRow(row)
        }
        if (action == 2) {
            this.autoFitRow(row)
        }
        if (action == 3) {
            model.setRowHeight(row ((model.rowHeight(row)) + 10))
            this.afterStructuralChange()
        }
        if (action == 4) {
            model.setRowHeight(row ((model.rowHeight(row)) - 10))
            this.afterStructuralChange()
        }
        if (action == 5) {
            this.insertRow(row)
        }
        if (action == 6) {
            this.insertRow((row + 1))
        }
        if (action == 7) {
            this.deleteRow(row)
        }
        if (action == 8) {
            this.moveRow(row (row - 1))
        }
        if (action == 9) {
            this.moveRow(row (row + 1))
        }
        this.closeHeaderMenu()
    }

    ; --- dialogs --------------------------------------------------------------
    ; Paste Special, built on the shared EVGWindow layer. Control ids:
    ;   1..4 the mode radios, 10 OK, 11 Cancel.
    fn buildDialogs:void () {
        if dialogsReady {
            return
        }
        pasteDialog.title = "Paste Special"
        pasteDialog.w = 264
        pasteDialog.reset()
        pasteDialog.addLabel("Paste")
        pasteDialog.addRadio(1 "All (values, formulas, formats)" 1 true)
        pasteDialog.addRadio(2 "Values only" 1 false)
        pasteDialog.addRadio(3 "Formats only" 1 false)
        pasteDialog.addRadio(4 "Values and formulas, no formats" 1 false)
        pasteDialog.addSeparator()
        def ids:[int]
        push ids 11
        push ids 10
        def labels:[string]
        push labels "Cancel"
        push labels "Paste"
        pasteDialog.addButtonRow(ids labels 10)
        pasteDialog.finish()
        windows.add(pasteDialog)
        ; The chart picker's contents are rebuilt every time it opens — which
        ; kinds are offered depends on the selection — so only its place in the
        ; stack is settled here.
        chartDialog.w = 300
        chartDialog.title = "Chart"
        windows.add(chartDialog)
        findDialog.w = 380
        findDialog.title = "Find and replace"
        windows.add(findDialog)
        cfDialog.w = 360
        cfDialog.title = "Conditional formatting"
        windows.add(cfDialog)
        linkDialog.w = 360
        linkDialog.title = "Hyperlink"
        windows.add(linkDialog)
        dvDialog.w = 330
        dvDialog.title = "Data validation"
        windows.add(dvDialog)
        listDialog.w = 220
        listDialog.title = "Choose a value"
        windows.add(listDialog)
        colorDialog.w = 340
        colorDialog.title = "Colour"
        windows.add(colorDialog)
        dialogsReady = true
    }

    ; --- colour palette -------------------------------------------------------
    ; The toolbar used to hard-wire one red and one amber. A proper picker is a
    ; modal of swatches: theme row, standard grid, recent colours, and Apply.
    ; Ids: 901.. theme/standard/recent swatches (group 1), 990 No fill,
    ; 991 Cancel, 992 Apply. Op is "color" or "fill".
    sfn paletteTheme:string (i:int) {
        if (i == 0) { return "#000000" }
        if (i == 1) { return "#FFFFFF" }
        if (i == 2) { return "#C00000" }
        if (i == 3) { return "#FFC000" }
        if (i == 4) { return "#FFFF00" }
        if (i == 5) { return "#92D050" }
        if (i == 6) { return "#00B050" }
        if (i == 7) { return "#00B0F0" }
        if (i == 8) { return "#0070C0" }
        if (i == 9) { return "#7030A0" }
        return "#000000"
    }

    sfn paletteThemeCount:int () {
        return 10
    }

    sfn paletteStandard:string (i:int) {
        if (i == 0)  { return "#F2F2F2" }
        if (i == 1)  { return "#D9D9D9" }
        if (i == 2)  { return "#BFBFBF" }
        if (i == 3)  { return "#A6A6A6" }
        if (i == 4)  { return "#7F7F7F" }
        if (i == 5)  { return "#595959" }
        if (i == 6)  { return "#404040" }
        if (i == 7)  { return "#262626" }
        if (i == 8)  { return "#FFC7CE" }
        if (i == 9)  { return "#FF6B6B" }
        if (i == 10) { return "#FF0000" }
        if (i == 11) { return "#C00000" }
        if (i == 12) { return "#8B0000" }
        if (i == 13) { return "#FFE59A" }
        if (i == 14) { return "#FFD966" }
        if (i == 15) { return "#FFC000" }
        if (i == 16) { return "#ED7D31" }
        if (i == 17) { return "#C65911" }
        if (i == 18) { return "#FFF2CC" }
        if (i == 19) { return "#FFFF99" }
        if (i == 20) { return "#FFFF00" }
        if (i == 21) { return "#BF8F00" }
        if (i == 22) { return "#C6EFCE" }
        if (i == 23) { return "#A9D08E" }
        if (i == 24) { return "#70AD47" }
        if (i == 25) { return "#00B050" }
        if (i == 26) { return "#006600" }
        if (i == 27) { return "#BDD7EE" }
        if (i == 28) { return "#9DC3E6" }
        if (i == 29) { return "#5B9BD5" }
        if (i == 30) { return "#0070C0" }
        if (i == 31) { return "#002060" }
        if (i == 32) { return "#E2D5F1" }
        if (i == 33) { return "#C5A6E0" }
        if (i == 34) { return "#9E7CC3" }
        if (i == 35) { return "#7030A0" }
        if (i == 36) { return "#4A1C6B" }
        if (i == 37) { return "#F8CBAD" }
        if (i == 38) { return "#F4B183" }
        if (i == 39) { return "#C55A11" }
        return "#000000"
    }

    sfn paletteStandardCount:int () {
        return 40
    }

    fn rememberColor:void (hex:string) {
        if ((strlen hex) < 4) {
            return
        }
        def next:[string]
        push next hex
        def i:int 0
        while (i < (array_length colorRecent)) {
            def prev:string (itemAt colorRecent i)
            if (prev != hex) {
                if ((array_length next) < 10) {
                    push next prev
                }
            }
            i = (i + 1)
        }
        colorRecent = next
    }

    ; Capture every cell the picker will touch, so Cancel can put them back
    ; and Apply can record one undo from this baseline.
    fn snapshotColorSelection:void () {
        clear colorSnapRows
        clear colorSnapCols
        clear colorSnapStyles
        def gi:int 0
        while (gi < (sel.rangeCount())) {
            def g:GridRange (sel.rangeAt(gi))
            def r:int g.r0
            while (r <= g.r1) {
                def c:int g.c0
                while (c <= g.c1) {
                    push colorSnapRows r
                    push colorSnapCols c
                    push colorSnapStyles ((model.getCellStyle(r c)).copy())
                    c = (c + 1)
                }
                r = (r + 1)
            }
            gi = (gi + 1)
        }
        colorPreviewOn = true
        colorPreviewCommitted = false
    }

    fn restoreColorSnapshot:void () {
        def i:int 0
        while (i < (array_length colorSnapRows)) {
            def r:int (itemAt colorSnapRows i)
            def c:int (itemAt colorSnapCols i)
            def st:CellStyle (itemAt colorSnapStyles i)
            model.setCellStyleResolved(r c st)
            i = (i + 1)
        }
        sheetView.markDirty()
        grid.updateVisible(model)
    }

    ; Paint the chosen colour onto the selection without an undo entry — the
    ; sheet shows it immediately; Apply / Cancel decide whether it sticks.
    fn previewColorOnSheet:void (hex:string) {
        def i:int 0
        while (i < (array_length colorSnapRows)) {
            def r:int (itemAt colorSnapRows i)
            def c:int (itemAt colorSnapCols i)
            def base:CellStyle (itemAt colorSnapStyles i)
            def st:CellStyle (base.copy())
            if (colorDialogOp == "fill") {
                if ((strlen hex) == 0) {
                    st.hasFill = false
                    st.fillRgb = ""
                } {
                    st.hasFill = true
                    st.fillRgb = hex
                }
            } {
                st.textRgb = hex
            }
            model.setCellStyleResolved(r c st)
            i = (i + 1)
        }
        sheetView.markDirty()
        grid.updateVisible(model)
    }

    fn openColorDialog:void (op:string initial:string) {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        colorDialogOp = op
        colorPick = initial
        if ((strlen colorPick) == 0) {
            if (op == "fill") {
                colorPick = "#FFF2CC"
            } {
                colorPick = "#C00000"
            }
        }
        if (op == "fill") {
            colorDialog.title = "Fill colour"
        } {
            colorDialog.title = "Text colour"
        }
        this.snapshotColorSelection()
        colorDialog.w = 340
        colorDialog.reset()
        colorDialog.addLabel("Theme")
        colorDialog.beginColumns(10)
        def matched:boolean false
        def ti:int 0
        while (ti < (GridApp.paletteThemeCount())) {
            def th:string (GridApp.paletteTheme(ti))
            def on:boolean false
            if (matched == false) {
                if (th == colorPick) {
                    on = true
                    matched = true
                }
            }
            colorDialog.addSwatch((901 + ti) th 1 on)
            ti = (ti + 1)
        }
        colorDialog.endColumns()
        colorDialog.addSeparator()
        colorDialog.addLabel("Standard")
        colorDialog.beginColumns(10)
        def si:int 0
        while (si < (GridApp.paletteStandardCount())) {
            def sh:string (GridApp.paletteStandard(si))
            def onS:boolean false
            if (matched == false) {
                if (sh == colorPick) {
                    onS = true
                    matched = true
                }
            }
            colorDialog.addSwatch((911 + si) sh 1 onS)
            si = (si + 1)
        }
        colorDialog.endColumns()
        if ((array_length colorRecent) > 0) {
            colorDialog.addSeparator()
            colorDialog.addLabel("Recent")
            colorDialog.beginColumns(10)
            def ri:int 0
            while (ri < (array_length colorRecent)) {
                def rh:string (itemAt colorRecent ri)
                def onR:boolean false
                if (matched == false) {
                    if (rh == colorPick) {
                        onR = true
                        matched = true
                    }
                }
                colorDialog.addSwatch((960 + ri) rh 1 onR)
                ri = (ri + 1)
            }
            colorDialog.endColumns()
        }
        colorDialog.addSeparator()
        colorDialog.addLabel(("Selected: " + colorPick))
        ; Example cell the picker paints itself — what the sheet will look like.
        colorDialog.addContent(980 44)
        def ids:[int]
        def labels:[string]
        push ids 991
        push labels "Cancel"
        if (op == "fill") {
            push ids 990
            push labels "No fill"
        }
        push ids 992
        push labels "Apply"
        colorDialog.addButtonRow(ids labels 992)
        colorDialog.finish()
        def px:int (grid.x + (idiv (W - colorDialog.w) 2))
        colorDialog.openWithin(px (grid.y + 40) W H)
        windows.raise(colorDialog)
        view.focused = true
        ; Live-preview only when the cell already had a colour (or the user
        ; picks one). Opening with an empty style must not paint a default.
        if ((strlen initial) > 0) {
            this.previewColorOnSheet(colorPick)
        }
        this.syncColorPreviewView()
    }

    fn syncColorPreviewView:void () {
        view.colorPreviewHex = colorPick
        view.colorPreviewIsFill = (colorDialogOp == "fill")
        if colorDialog.visible {
            view.colorPreviewWid = colorDialog.wid
        } {
            view.colorPreviewWid = 0
        }
    }

    fn refreshColorDialogSelection:void () {
        def hex:string (colorDialog.selectedSwatchValue(1))
        if ((strlen hex) > 0) {
            colorPick = hex
        }
        def i:int 0
        def lastLabel:int -1
        while (i < (array_length colorDialog.controls)) {
            def c:EVGControl (itemAt colorDialog.controls i)
            if (c.kind == (EVGControlKind.label())) {
                if ((strlen c.text) >= 10) {
                    if ((substring c.text 0 10) == "Selected: ") {
                        lastLabel = i
                    }
                }
            }
            i = (i + 1)
        }
        if (lastLabel >= 0) {
            def lab:EVGControl (itemAt colorDialog.controls lastLabel)
            lab.text = ("Selected: " + colorPick)
        }
        this.previewColorOnSheet(colorPick)
        this.syncColorPreviewView()
    }

    fn applyColorDialog:void () {
        this.refreshColorDialogSelection()
        def arg:string colorPick
        ; Put the snapshot back, then apply once through the normal format
        ; path so Ctrl+Z undoes the whole pick as a single action.
        this.restoreColorSnapshot()
        if ((strlen arg) > 0) {
            this.rememberColor(arg)
        }
        def done:boolean (GridFormat.apply(model sel colorDialogOp arg))
        if done {
            this.growSelectedRowsToFit()
            sheetView.markDirty()
            grid.updateVisible(model)
            view.status = (colorDialog.title + ": " + arg)
        }
        colorPreviewCommitted = true
        colorPreviewOn = false
        view.colorPreviewWid = 0
        colorDialog.close()
    }

    fn clearFillFromColorDialog:void () {
        colorPick = ""
        this.restoreColorSnapshot()
        def done:boolean (GridFormat.apply(model sel "fill" ""))
        if done {
            sheetView.markDirty()
            grid.updateVisible(model)
            view.status = "Fill cleared"
        }
        colorPreviewCommitted = true
        colorPreviewOn = false
        view.colorPreviewWid = 0
        colorDialog.close()
    }

    fn cancelColorDialog:void () {
        if colorPreviewOn {
            if (colorPreviewCommitted == false) {
                this.restoreColorSnapshot()
            }
        }
        colorPreviewOn = false
        colorPreviewCommitted = false
        view.colorPreviewWid = 0
        colorDialog.close()
    }

    ; --- conditional formatting ----------------------------------------------
    ; Reading the rules a workbook came with was never the hard half; writing
    ; one was, because a rule needs a range, a test, a number and a colour, and
    ; a dialog that can only ask yes-or-no cannot collect them. It can now.
    ; Ids: 601..605 the test, 611/612 the numbers, 621..624 the fill,
    ; 631..633 the buttons.
    sfn cfFillFor:int (choice:int) {
        return choice
    }

    sfn cfColorHex:string (choice:int) {
        if (choice == 622) {
            return "FFE59A"
        }
        if (choice == 623) {
            return "C6EFCE"
        }
        if (choice == 624) {
            return "BDD7EE"
        }
        return "FFC7CE"
    }

    sfn cfOpFor:string (choice:int) {
        if (choice == 602) {
            return "lessThan"
        }
        if (choice == 603) {
            return "equal"
        }
        if (choice == 604) {
            return "between"
        }
        if (choice == 606) {
            return "greaterThanOrEqual"
        }
        if (choice == 607) {
            return "lessThanOrEqual"
        }
        return "greaterThan"
    }

    fn openCfDialog:void () {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        def g:GridRange (sel.liveRange())
        cfDialog.reset()
        cfDialog.labelW = 64
        cfDialog.addLabel(("Rule for " + (SpreadsheetModel.cellLabel(g.r0 g.c0)) + ":" + (SpreadsheetModel.cellLabel(g.r1 g.c1))))
        cfDialog.addSeparator()
        cfDialog.addLabel("Format cells where the value is")
        cfDialog.beginColumns(2)
        cfDialog.addRadio(601 "Greater than" 1 (cfTest == 601))
        cfDialog.addRadio(606 "At least (≥)" 1 (cfTest == 606))
        cfDialog.addRadio(602 "Less than" 1 (cfTest == 602))
        cfDialog.addRadio(607 "At most (≤)" 1 (cfTest == 607))
        cfDialog.addRadio(603 "Equal to" 1 (cfTest == 603))
        cfDialog.addRadio(604 "Between" 1 (cfTest == 604))
        cfDialog.endColumns()
        cfDialog.addRadio(605 "Colour scale over the range" 1 (cfTest == 605))
        cfDialog.addInput(611 "Value" cfV1)
        cfDialog.addInput(612 "and" cfV2)
        cfDialog.addSeparator()
        cfDialog.addLabel("Fill")
        if ((strlen cfFillHex) == 0) {
            cfFillHex = ("#" + (GridApp.cfColorHex(cfFill)))
        }
        ; Ids 621..624 keep the classic four so existing callers and tests
        ; still select by those numbers; the theme row adds the rest.
        cfDialog.beginColumns(10)
        cfDialog.addSwatch(621 "#FFC7CE" 2 (cfFillHex == "#FFC7CE"))
        cfDialog.addSwatch(622 "#FFE59A" 2 (cfFillHex == "#FFE59A"))
        cfDialog.addSwatch(623 "#C6EFCE" 2 (cfFillHex == "#C6EFCE"))
        cfDialog.addSwatch(624 "#BDD7EE" 2 (cfFillHex == "#BDD7EE"))
        def ci:int 0
        while (ci < (GridApp.paletteThemeCount())) {
            def ch:string (GridApp.paletteTheme(ci))
            def already:boolean false
            if (ch == "#FFC7CE") { already = true }
            if (ch == "#FFE59A") { already = true }
            if (ch == "#C6EFCE") { already = true }
            if (ch == "#BDD7EE") { already = true }
            if (already == false) {
                cfDialog.addSwatch((650 + ci) ch 2 (ch == cfFillHex))
            }
            ci = (ci + 1)
        }
        cfDialog.endColumns()
        def note:string cfStatus
        if ((strlen note) == 0) {
            note = ((to_string (model.cfRuleCount())) + " rule(s) on this sheet")
        }
        cfDialog.addLabel(note)
        def ids:[int]
        def labels:[string]
        push ids 631
        push labels "Close"
        push ids 632
        push labels "Clear"
        push ids 634
        push labels "± colours"
        push ids 633
        push labels "Add rule"
        cfDialog.addButtonRow(ids labels 633)
        cfDialog.finish()
        def px:int (grid.x + (idiv (W - cfDialog.w) 2))
        cfDialog.openWithin(px (grid.y + 50) W H)
        windows.raise(cfDialog)
        view.focused = true
    }

    sfn cfNumber:double (text:string) {
        def p@(optional):double (to_double text)
        if p {
            return (unwrap p)
        }
        return 0.0
    }

    ; Read the form into the remembered state, so a rebuild puts it back.
    fn syncCfDialog:void () {
        def t:int (cfDialog.selectedInGroup(1))
        if (t > 0) {
            cfTest = t
        }
        def f:int (cfDialog.selectedInGroup(2))
        if (f > 0) {
            cfFill = f
            def hex:string (cfDialog.selectedSwatchValue(2))
            if ((strlen hex) > 0) {
                cfFillHex = hex
            }
        }
        cfV1 = (cfDialog.inputValue(611))
        cfV2 = (cfDialog.inputValue(612))
    }

    fn addCfRuleFromDialog:void () {
        this.syncCfDialog()
        def g:GridRange (sel.liveRange())
        def rule:CfRule (new CfRule)
        rule.r0 = g.r0
        rule.c0 = g.c0
        rule.r1 = g.r1
        rule.c1 = g.c1
        if (cfTest == 605) {
            rule.kind = 0
        } {
            rule.kind = 1
            rule.op = (GridApp.cfOpFor(cfTest))
            rule.v1 = (GridApp.cfNumber(cfV1))
            rule.v2 = (GridApp.cfNumber(cfV2))
            def fill:string cfFillHex
            if ((strlen fill) == 0) {
                fill = ("#" + (GridApp.cfColorHex(cfFill)))
            }
            if ((charAt fill 0) != 35) {
                fill = ("#" + fill)
            }
            rule.fillRgb = fill
        }
        model.addCfRule(rule)
        cfStatus = ("added — " + (to_string (model.cfRuleCount())) + " rule(s)")
        def keepX:int cfDialog.x
        def keepY:int cfDialog.y
        this.openCfDialog()
        cfDialog.x = keepX
        cfDialog.y = keepY
    }

    fn clearCfRulesFromDialog:void () {
        this.syncCfDialog()
        def g:GridRange (sel.liveRange())
        model.clearCfRulesIn(g.r0 g.c0 g.r1 g.c1)
        cfStatus = ("cleared — " + (to_string (model.cfRuleCount())) + " rule(s) left")
        def keepX:int cfDialog.x
        def keepY:int cfDialog.y
        this.openCfDialog()
        cfDialog.x = keepX
        cfDialog.y = keepY
    }

    ; One click: ≥0 green, <0 red — the usual profit / loss pair.
    fn addCfPosNegFromDialog:void () {
        this.syncCfDialog()
        def g:GridRange (sel.liveRange())
        def pos:CfRule (new CfRule)
        pos.r0 = g.r0
        pos.c0 = g.c0
        pos.r1 = g.r1
        pos.c1 = g.c1
        pos.kind = 1
        pos.op = "greaterThanOrEqual"
        pos.v1 = 0.0
        pos.fillRgb = "#C6EFCE"
        model.addCfRule(pos)
        def neg:CfRule (new CfRule)
        neg.r0 = g.r0
        neg.c0 = g.c0
        neg.r1 = g.r1
        neg.c1 = g.c1
        neg.kind = 1
        neg.op = "lessThan"
        neg.v1 = 0.0
        neg.fillRgb = "#FFC7CE"
        model.addCfRule(neg)
        cfStatus = ("± colours — " + (to_string (model.cfRuleCount())) + " rule(s)")
        def keepX:int cfDialog.x
        def keepY:int cfDialog.y
        this.openCfDialog()
        cfDialog.x = keepX
        cfDialog.y = keepY
    }

    ; --- hyperlinks, notes and validation rules --------------------------------
    ; Three things a cell can carry that are not its value. They share a shape:
    ; each is metadata the file may bring, each is editable here, and none of
    ; them is on the undo stack — undoing a paste must not drop the note that
    ; was pinned to the cell before it.
    ;
    ; Ids: 801/802 the link, 811..813 its buttons; 701..705 the validation kind,
    ; 711/712 its numbers, 721..723 the operator, 731 allow-blank, 741..743 its
    ; buttons; 901+ the list picker's values.
    fn openLinkDialog:void () {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        def r:int sel.active.row
        def c:int sel.active.col
        linkDialog.reset()
        linkDialog.labelW = 60
        linkDialog.addLabel(("Link on " + (SpreadsheetModel.cellLabel(r c))))
        linkDialog.addInput(801 "Address" (model.hyperlinkAt(r c)))
        linkDialog.addInput(802 "Text" (model.getCell(r c)))
        def ids:[int]
        def labels:[string]
        push ids 811
        push labels "Close"
        push ids 812
        push labels "Remove"
        push ids 813
        push labels "Set"
        linkDialog.addButtonRow(ids labels 813)
        linkDialog.finish()
        linkDialog.openWithin((grid.x + (idiv (W - linkDialog.w) 2)) (grid.y + 70) W H)
        windows.raise(linkDialog)
        linkDialog.focusedId = 801
        view.focused = true
    }

    fn applyLinkDialog:void () {
        def r:int sel.active.row
        def c:int sel.active.col
        def target:string (linkDialog.inputValue(801))
        def text:string (linkDialog.inputValue(802))
        model.setHyperlink(r c target)
        if ((strlen text) > 0) {
            if (text != (model.getCell(r c))) {
                model.beginTx()
                model.applyEdit(r c text "")
                model.endTx()
                this.syncTouched()
            }
        }
        linkDialog.close()
    }

    ; Ctrl+click on a linked cell follows it. The app has no browser, so it
    ; records what was activated; the host opens it.
    fn followLink:boolean (row:int col:int) {
        def target:string (model.hyperlinkAt(row col))
        if ((strlen target) == 0) {
            return false
        }
        activatedLink = target
        view.status = ("link: " + target)
        return true
    }

    fn openValidationDialog:void () {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        def g:GridRange (sel.liveRange())
        def existing:DataValidation (model.validationAt(g.r0 g.c0))
        if ((strlen existing.kind) > 0) {
            if (existing.kind == "list") {
                dvKind = 701
            }
            if (existing.kind == "whole") {
                dvKind = 702
            }
            if (existing.kind == "decimal") {
                dvKind = 703
            }
            if (existing.kind == "textLength") {
                dvKind = 704
            }
            dvV1 = existing.f1
            dvV2 = existing.f2
            dvBlank = existing.allowBlank
            if (existing.op == "greaterThan") {
                dvOp = 722
            }
            if (existing.op == "lessThan") {
                dvOp = 723
            }
        }
        dvDialog.reset()
        dvDialog.labelW = 60
        dvDialog.addLabel(("Rule for " + (SpreadsheetModel.cellLabel(g.r0 g.c0)) + ":" + (SpreadsheetModel.cellLabel(g.r1 g.c1))))
        dvDialog.addSeparator()
        dvDialog.addLabel("Allow")
        dvDialog.beginColumns(2)
        dvDialog.addRadio(701 "List" 1 (dvKind == 701))
        dvDialog.addRadio(702 "Whole number" 1 (dvKind == 702))
        dvDialog.addRadio(703 "Decimal" 1 (dvKind == 703))
        dvDialog.addRadio(704 "Text length" 1 (dvKind == 704))
        dvDialog.endColumns()
        dvDialog.addInput(711 "Values" dvV1)
        dvDialog.addInput(712 "Max" dvV2)
        dvDialog.beginColumns(3)
        dvDialog.addRadio(721 "Between" 2 (dvOp == 721))
        dvDialog.addRadio(722 "At least" 2 (dvOp == 722))
        dvDialog.addRadio(723 "At most" 2 (dvOp == 723))
        dvDialog.endColumns()
        dvDialog.addCheckbox(731 "Allow blank" dvBlank)
        def note:string dvStatus
        if ((strlen note) == 0) {
            note = ((to_string (model.validationCount())) + " rule(s) on this sheet")
        }
        dvDialog.addLabel(note)
        def ids:[int]
        def labels:[string]
        push ids 741
        push labels "Close"
        push ids 742
        push labels "Clear"
        push ids 743
        push labels "Add rule"
        dvDialog.addButtonRow(ids labels 743)
        dvDialog.finish()
        dvDialog.openWithin((grid.x + (idiv (W - dvDialog.w) 2)) (grid.y + 50) W H)
        windows.raise(dvDialog)
        view.focused = true
    }

    fn syncValidationDialog:void () {
        def k:int (dvDialog.selectedInGroup(1))
        if (k > 0) {
            dvKind = k
        }
        def o:int (dvDialog.selectedInGroup(2))
        if (o > 0) {
            dvOp = o
        }
        dvV1 = (dvDialog.inputValue(711))
        dvV2 = (dvDialog.inputValue(712))
        dvBlank = (dvDialog.isChecked(731))
    }

    sfn dvKindName:string (choice:int) {
        if (choice == 702) {
            return "whole"
        }
        if (choice == 703) {
            return "decimal"
        }
        if (choice == 704) {
            return "textLength"
        }
        return "list"
    }

    sfn dvOpName:string (choice:int) {
        if (choice == 722) {
            return "greaterThanOrEqual"
        }
        if (choice == 723) {
            return "lessThanOrEqual"
        }
        return "between"
    }

    fn addValidationFromDialog:void () {
        this.syncValidationDialog()
        def g:GridRange (sel.liveRange())
        def v:DataValidation (new DataValidation)
        v.kind = (GridApp.dvKindName(dvKind))
        v.op = (GridApp.dvOpName(dvOp))
        v.r0 = g.r0
        v.c0 = g.c0
        v.r1 = g.r1
        v.c1 = g.c1
        v.f1 = dvV1
        v.f2 = dvV2
        v.allowBlank = dvBlank
        model.addValidation(v)
        dvStatus = ("added — " + (to_string (model.validationCount())) + " rule(s)")
        def kx:int dvDialog.x
        def ky:int dvDialog.y
        this.openValidationDialog()
        dvDialog.x = kx
        dvDialog.y = ky
    }

    fn clearValidationsFromDialog:void () {
        this.syncValidationDialog()
        def g:GridRange (sel.liveRange())
        model.clearValidationsIn(g.r0 g.c0 g.r1 g.c1)
        dvStatus = ("cleared — " + (to_string (model.validationCount())) + " rule(s) left")
        def kx:int dvDialog.x
        def ky:int dvDialog.y
        this.openValidationDialog()
        dvDialog.x = kx
        dvDialog.y = ky
    }

    ; A list rule knows its choices, so the cell offers them rather than making
    ; you remember them. Opened by the arrow in the cell, or by Alt-less Enter
    ; on a list cell — the arrow is what a spreadsheet user looks for.
    fn openListPicker:void (row:int col:int) {
        def rule:DataValidation (model.validationAt(row col))
        if ((rule.isList()) == false) {
            return
        }
        this.buildDialogs()
        listValues = (rule.listValues())
        def current:string (model.getCell(row col))
        listDialog.reset()
        listDialog.addLabel(("Value for " + (SpreadsheetModel.cellLabel(row col))))
        def i:int 0
        while (i < (array_length listValues)) {
            def val:string (itemAt listValues i)
            listDialog.addRadio((901 + i) val 1 (val == current))
            i = (i + 1)
        }
        def ids:[int]
        def labels:[string]
        push ids 891
        push labels "Cancel"
        push ids 892
        push labels "Choose"
        listDialog.addButtonRow(ids labels 892)
        listDialog.finish()
        def cell:GridRect (grid.cellRect(model row col))
        listDialog.openWithin(cell.x (cell.y + cell.h) W H)
        windows.raise(listDialog)
        view.focused = true
    }

    fn applyListPicker:void () {
        def chosen:int (listDialog.selectedInGroup(1))
        if (chosen >= 901) {
            def idx:int (chosen - 901)
            if (idx < (array_length listValues)) {
                def r:int sel.active.row
                def c:int sel.active.col
                model.beginTx()
                model.applyEdit(r c (itemAt listValues idx) "")
                model.endTx()
                this.syncTouched()
            }
        }
        listDialog.close()
    }

    ; --- charts ---------------------------------------------------------------
    ; What a chart made right now would read. A selection of one cell means
    ; "the block I am standing in", which is what Excel assumes too: nobody
    ; charts a single number.
    fn rowHasContent:boolean (r:int c0:int c1:int) {
        def c:int c0
        while (c <= c1) {
            if ((strlen (model.getCell(r c))) > 0) {
                return true
            }
            c = (c + 1)
        }
        return false
    }

    fn selectionChart:void (out:GridChart) {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def r0:int a.row
        def c0:int a.col
        def r1:int b.row
        def c1:int b.col
        if (r0 == r1) {
            if (c0 == c1) {
                while (c0 > 0) {
                    if ((strlen (model.getCell(r0 (c0 - 1)))) == 0) {
                        break
                    }
                    c0 = (c0 - 1)
                }
                while (c1 < (model.colCount - 1)) {
                    if ((strlen (model.getCell(r0 (c1 + 1)))) == 0) {
                        break
                    }
                    c1 = (c1 + 1)
                }
                while (r0 > 0) {
                    if ((this.rowHasContent((r0 - 1) c0 c1)) == false) {
                        break
                    }
                    r0 = (r0 - 1)
                }
                while (r1 < (model.rowCount - 1)) {
                    if ((this.rowHasContent((r1 + 1) c0 c1)) == false) {
                        break
                    }
                    r1 = (r1 + 1)
                }
            }
        }
        out.r0 = r0
        out.c0 = c0
        out.r1 = r1
        out.c1 = c1
        out.sheet = book.activeIndex
        ; Headers are guessed the way a reader would: a top row of words over a
        ; column of numbers is a header, not data.
        def flag:[boolean]
        ChartData.asNumber((model.getCell(r0 c1)) flag)
        def topIsText:boolean true
        if ((array_length flag) > 0) {
            topIsText = ((itemAt flag 0) == false)
        }
        out.useHeaderRow = false
        if (r1 > r0) {
            out.useHeaderRow = topIsText
        }
        ChartData.asNumber((model.getCell(r1 c0)) flag)
        def leftIsText:boolean true
        if ((array_length flag) > 0) {
            leftIsText = ((itemAt flag 0) == false)
        }
        out.useHeaderCol = false
        if (c1 > c0) {
            out.useHeaderCol = leftIsText
        }
    }

    ; Open the picker: on the current selection when `editId` is 0, on an
    ; existing chart otherwise.
    ; Ids: 100+kind for the type, 200+style for the look, 301/302 the header
    ; questions, 303 the legend, 311 the title field, 401..403 the buttons, and
    ; 500 the preview region.
    fn openChartDialog:void (editId:int) {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        chartEditId = editId
        if (editId > 0) {
            def p:ChartPanel (view.chartLayer.panelForChart(editId))
            if (p.chart.id != editId) {
                return
            }
            pendingChart.copyFrom(p.chart)
        } {
            def fresh:GridChart (new GridChart)
            this.selectionChart(fresh)
            pendingChart.copyFrom(fresh)
        }
        def probe:ChartData (new ChartData)
        def has:boolean (probe.extract(model pendingChart))
        if (editId == 0) {
            if has {
                pendingChart.kind = (probe.suggestedKind())
            }
        }
        ; Never open on a choice that cannot be drawn.
        if has {
            if ((probe.suits(pendingChart.kind)) == false) {
                def k2:int (ChartKind.lowest())
                while (k2 <= (ChartKind.highest())) {
                    if (probe.suits(k2)) {
                        pendingChart.kind = k2
                        k2 = ((ChartKind.highest()) + 1)
                    } {
                        k2 = (k2 + 1)
                    }
                }
            }
        }
        this.layoutChartDialog(editId)
        def px:int (grid.x + (idiv (W - chartDialog.w) 2))
        def py:int (grid.y + 26)
        chartDialog.openWithin(px py W H)
        windows.raise(chartDialog)
        view.focused = true
    }

    ; Build the picker's controls. Called again whenever something changes, so
    ; the radio states and the preview stay in step — the panel is cheap to
    ; rebuild and there is then only one description of what it looks like.
    fn layoutChartDialog:void (editId:int) {
        def probe:ChartData (new ChartData)
        def has:boolean (probe.extract(model pendingChart))
        chartDialog.title = "Insert chart"
        if (editId > 0) {
            chartDialog.title = "Chart"
        }
        chartDialog.w = 720
        chartDialog.labelW = 44
        chartDialog.reset()
        ; The preview lives on the right. Bounding the FLOW keeps every radio,
        ; checkbox and field in the left column instead of being laid out
        ; underneath the picture, which is where they went before.
        chartDialog.flowW = 396
        chartDialog.addLabel(("Data: " + (pendingChart.rangeLabel()) + "   —   " + (to_string (probe.catCount())) + " rows x " + (to_string (probe.seriesCount())) + " series"))
        chartDialog.addSeparator()
        chartDialog.addLabel("Chart type")
        ; Twenty types in three columns: a single column would be taller than
        ; the window it has to fit in.
        chartDialog.beginColumns(3)
        def k:int (ChartKind.lowest())
        while (k <= (ChartKind.highest())) {
            def id:int (100 + k)
            chartDialog.addRadio(id (ChartKind.label(k)) 1 (k == pendingChart.kind))
            def c:EVGControl (chartDialog.controlById(id))
            def ok:boolean false
            if has {
                ok = (probe.suits(k))
            }
            c.enabled = ok
            if (ok == false) {
                c.checked = false
            }
            k = (k + 1)
        }
        chartDialog.endColumns()
        chartDialog.addSeparator()
        chartDialog.addLabel("Style")
        chartDialog.beginColumns(3)
        def st:int (ChartStyle.lowest())
        while (st <= (ChartStyle.highest())) {
            chartDialog.addRadio((200 + st) (ChartStyle.label(st)) 2 (st == pendingChart.style))
            st = (st + 1)
        }
        chartDialog.endColumns()
        chartDialog.addSeparator()
        chartDialog.addCheckbox(301 "First row names the series" pendingChart.useHeaderRow)
        chartDialog.addCheckbox(302 "First column labels the rows" pendingChart.useHeaderCol)
        chartDialog.addCheckbox(303 "Show legend" pendingChart.showLegend)
        chartDialog.addInput(311 "Title" pendingChart.title)
        def ids:[int]
        def labels:[string]
        if (editId > 0) {
            push ids 402
            push labels "Delete"
        }
        push ids 401
        push labels "Cancel"
        push ids 403
        if (editId > 0) {
            push labels "Apply"
        } {
            push labels "Create"
        }
        ; The preview sits BESIDE the options rather than under them — the list
        ; is long enough already, and a picture next to the choice that made it
        ; is the point of having one at all.
        def prevX:int 412
        def prevY:int 44
        ; Reserve the preview's own height in the flow BEFORE the buttons are
        ; placed. The button row is right-aligned across the whole panel, so a
        ; row laid out while the flow was still shorter than the preview would
        ; end up drawn on top of it.
        if (chartDialog.cursorY < (prevY + 236)) {
            chartDialog.cursorY = (prevY + 236)
        }
        chartDialog.addButtonRow(ids labels 403)
        chartDialog.finish()
        def prevW:int ((chartDialog.w - prevX) - chartDialog.padX)
        def prevH:int ((chartDialog.h - prevY) - 46)
        chartDialog.addContentAt(500 prevX prevY prevW prevH)
    }

    ; Read the picker's controls back into the pending chart. Runs every frame
    ; the dialog is up, which is what makes the preview live: clicking a radio
    ; changes the chart, and the chart is what the preview draws.
    fn syncChartDialog:void () {
        def chosen:int (chartDialog.selectedInGroup(1))
        if (chosen > 100) {
            pendingChart.kind = (chosen - 100)
        }
        def st:int (chartDialog.selectedInGroup(2))
        if (st > 200) {
            pendingChart.style = (st - 200)
        }
        pendingChart.useHeaderRow = (chartDialog.isChecked(301))
        pendingChart.useHeaderCol = (chartDialog.isChecked(302))
        pendingChart.showLegend = (chartDialog.isChecked(303))
        pendingChart.title = (chartDialog.inputValue(311))
    }

    ; The header checkboxes change which cells are data, which changes which
    ; kinds are possible — so the offered list has to be rebuilt, and a choice
    ; that has just become impossible has to move.
    fn refreshChartDialog:void () {
        def keepX:int chartDialog.x
        def keepY:int chartDialog.y
        def keepFocus:int chartDialog.focusedId
        def probe:ChartData (new ChartData)
        def has:boolean (probe.extract(model pendingChart))
        if has {
            if ((probe.suits(pendingChart.kind)) == false) {
                def k:int (ChartKind.lowest())
                while (k <= (ChartKind.highest())) {
                    if (probe.suits(k)) {
                        pendingChart.kind = k
                        k = ((ChartKind.highest()) + 1)
                    } {
                        k = (k + 1)
                    }
                }
            }
        }
        this.layoutChartDialog(chartEditId)
        chartDialog.x = keepX
        chartDialog.y = keepY
        chartDialog.focusedId = keepFocus
        chartDialog.visible = true
    }

    ; Read the picker back into the chart and put it on the sheet.
    fn applyChartDialog:void () {
        this.syncChartDialog()
        if (chartEditId > 0) {
            view.chartLayer.apply(chartEditId pendingChart)
        } {
            ; New charts cascade, so the second one is not hidden under the
            ; first.
            def step:int ((view.chartLayer.count()) % 5)
            pendingChart.x = ((grid.x + 96) + (step * 26))
            pendingChart.y = ((grid.y + 64) + (step * 22))
            if ((pendingChart.x + pendingChart.w) > W) {
                pendingChart.x = (W - (pendingChart.w + 12))
            }
            if (pendingChart.x < 4) {
                pendingChart.x = 4
            }
            view.chartLayer.add(windows pendingChart)
        }
        chartDialog.close()
        chartEditId = 0
    }

    ; A chart window's own buttons: the close box removes the chart, "Edit…"
    ; brings the picker back, "Copy" puts it on the clipboard. All three are
    ; collected before anything is removed, because removing rewrites the list
    ; being walked.
    fn pollChartWindows:void () {
        def layer:ChartLayer view.chartLayer
        def openEdit:int 0
        def closing:int 0
        def copying:int 0
        def i:int 0
        while (i < (layer.count())) {
            def p:ChartPanel (layer.panelAt(i))
            if (p.win.activated == (ChartLayer.editId())) {
                openEdit = p.chart.id
            }
            if (p.win.activated == (ChartLayer.closeId())) {
                closing = p.chart.id
            }
            if (p.win.activated == (ChartLayer.copyId())) {
                copying = p.chart.id
            }
            i = (i + 1)
        }
        if (copying > 0) {
            this.copyChart(copying)
        }
        if (closing > 0) {
            layer.remove(windows closing)
        }
        if (openEdit > 0) {
            this.openChartDialog(openEdit)
        }
    }

    ; --- the chart on the clipboard -------------------------------------------
    ; Copy a chart in every flavour Excel and Word paste: the bitmap, the same
    ; picture as vector, an HTML fragment carrying the bitmap as a data URI, and
    ; the numbers as TSV. What the host does with them is the host's business —
    ; a browser hands them to `navigator.clipboard`, a desktop shell registers
    ; them as clipboard formats — but the payload is decided here so every host
    ; offers the same thing.
    fn copyChart:int (id:int) {
        def panel:ChartPanel (view.chartLayer.panelForChart(id))
        if (panel.chart.id != id) {
            clipboardNote = "no such chart"
            return 0
        }
        def box:EVGControl (panel.win.contentControl())
        def bw:int box.w
        def bh:int box.h
        if (bw < 120) {
            bw = 320
        }
        if (bh < 90) {
            bh = 220
        }
        def clip:ChartClip (clipper.build(model panel.chart view.ctx.tr bw bh))
        if (clip.ok == false) {
            clipboardNote = clip.note
            return 0
        }
        ; The cell flavours are replaced rather than added to: what was copied
        ; last is what pastes, and a chart and a block of cells are not both on
        ; the clipboard at once.
        clipboardTsv = clip.tsv
        clipboardHtml = clip.html
        clipboardPng = clip.pngBase64
        clipboardSvg = clip.svg
        clipboardChartJson = clip.chartJson
        clipboardName = clip.name
        clipboardKind = "chart"
        clipboardNote = ""
        clipboardSeq = (clipboardSeq + 1)
        clipCut = false
        clear clipValues
        clear clipFormulas
        clear clipStyles
        clipRows = 0
        clipCols = 0
        return clip.w
    }

    ; The chart the keyboard would copy: the topmost chart window, when one is
    ; on top. Ctrl+C over the sheet still copies cells.
    fn focusedChartId:int () {
        def top:EVGWindow (windows.topmost())
        if (top.visible == false) {
            return 0
        }
        def i:int 0
        while (i < (view.chartLayer.count())) {
            def p:ChartPanel (view.chartLayer.panelAt(i))
            if (p.win.wid == top.wid) {
                return p.chart.id
            }
            i = (i + 1)
        }
        return 0
    }

    ; --- formatting -----------------------------------------------------------
    ; `format.*` over the selection. Merge is the odd one: it is a property of
    ; the range rather than of each cell's style, so it goes to the model.
    fn runFormatCommand:boolean (id:string arg:string) {
        if (id == "format.merge") {
            return (this.toggleMerge())
        }
        if (id == "format.size.up") {
            def up:boolean (GridFormat.apply(model sel "size" "1"))
            if up {
                this.fitSelectedRowsToContent(true)
            }
            return up
        }
        if (id == "format.size.down") {
            def down:boolean (GridFormat.apply(model sel "size" "-1"))
            if down {
                this.fitSelectedRowsToContent(true)
            }
            return down
        }
        if (id == "format.size.pick") {
            def stPick:CellStyle (model.getCellStyle(sel.active.row sel.active.col))
            def tip:ToolItem (view.toolbar.at(view.toolbar.hot))
            def mx:int tip.x
            def my:int ((tip.y + tip.h) + 2)
            if (view.toolbar.hot < 0) {
                mx = (grid.x + 120)
                my = ((grid.toolbarY()) + grid.toolbarH)
            }
            this.openFontSizeMenu(mx my)
            view.status = (("Size " + (to_string (to_int stPick.fontSizePt))) + " pt")
            return true
        }
        if (id == "format.size") {
            if ((strlen arg) == 0) {
                return (this.runFormatCommand("format.size.pick" ""))
            }
        }
        if (id == "format.font") {
            if ((strlen arg) == 0) {
                def tipF:ToolItem (view.toolbar.at(view.toolbar.hot))
                def mxF:int tipF.x
                def myF:int ((tipF.y + tipF.h) + 2)
                if (view.toolbar.hot < 0) {
                    mxF = (grid.x + 80)
                    myF = ((grid.toolbarY()) + grid.toolbarH)
                }
                this.openFontNameMenu(mxF myF)
                return true
            }
        }
        ; Empty arg opens the palette; a host that already knows the hex still
        ; applies it directly — same command string either way.
        if (id == "format.color") {
            if ((strlen arg) == 0) {
                def cur:CellStyle (model.getCellStyle(sel.active.row sel.active.col))
                this.openColorDialog("color" cur.textRgb)
                return true
            }
        }
        if (id == "format.fill") {
            if ((strlen arg) == 0) {
                def curF:CellStyle (model.getCellStyle(sel.active.row sel.active.col))
                def start:string curF.fillRgb
                if (curF.hasFill == false) {
                    start = ""
                }
                this.openColorDialog("fill" start)
                return true
            }
        }
        def op:string (substring id 7 (strlen id))
        if ((GridFormat.known(op)) == false) {
            return false
        }
        def done:boolean (GridFormat.apply(model sel op arg))
        if done {
            if (op == "size") {
                this.fitSelectedRowsToContent(true)
            } {
                this.growSelectedRowsToFit()
            }
            sheetView.markDirty()
            grid.updateVisible(model)
        }
        return done
    }

    ; Merge the selection, or take an existing merge apart when the caret is
    ; already inside one — the same button, as every spreadsheet does it.
    fn toggleMerge:boolean () {
        def existing:string (model.mergeAt(sel.active.row sel.active.col))
        if ((strlen existing) > 0) {
            model.removeMerge(sel.active.row sel.active.col)
            model.version = (model.version + 1)
            return true
        }
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        if ((a.row == b.row) && (a.col == b.col)) {
            return false
        }
        model.addMerge(a.row a.col b.row b.col)
        model.version = (model.version + 1)
        return true
    }

    ; --- the toolbar ----------------------------------------------------------
    ; A click on a button runs its command; hovering lights it up and puts its
    ; name in the status bar, which is this app's tooltip.
    fn toolbarHit:int (px:int py:int) {
        if (grid.toolbarH <= 0) {
            return -1
        }
        if (py < (grid.toolbarY())) {
            return -1
        }
        if (py >= ((grid.toolbarY()) + grid.toolbarH)) {
            return -1
        }
        return (view.toolbar.hit(px py))
    }

    fn runToolbarItem:boolean (i:int) {
        def t:ToolItem (view.toolbar.at(i))
        if ((strlen t.command) == 0) {
            return false
        }
        def ok:boolean (this.runCommand(t.command t.arg))
        if ok {
            view.status = t.label
        }
        return ok
    }

    ; Which custom tool button is under the pointer, or -1.
    fn toolButtonHit:int (px:int py:int) {
        def statusTop:int (grid.y + grid.h)
        def by:int (GridView.chartButtonY(statusTop))
        def bh:int (GridView.chartButtonH())
        if (py < by) {
            return -1
        }
        if (py >= (by + bh)) {
            return -1
        }
        def bw:int (GridView.toolButtonW())
        def i:int 0
        while (i < (commands.customCount())) {
            def bx:int (GridView.toolButtonX(W i))
            if (px >= bx) {
                if (px < (bx + bw)) {
                    return i
                }
            }
            i = (i + 1)
        }
        return -1
    }

    ; The status bar's "+ Chart" button.
    fn chartButtonHit:boolean (px:int py:int) {
        def statusTop:int (grid.y + grid.h)
        def bx:int (GridView.chartButtonX(W))
        def by:int (GridView.chartButtonY(statusTop))
        if (px < bx) {
            return false
        }
        if (py < by) {
            return false
        }
        def bw:int (GridView.chartButtonW())
        def bh:int (GridView.chartButtonH())
        if (px >= (bx + bw)) {
            return false
        }
        return (py < (by + bh))
    }

    ; --- find and replace -----------------------------------------------------
    ; What a search sees in a cell: the formula it was written as, or the value
    ; it shows.
    fn searchTextAt:string (m:SpreadsheetModel r:int c:int) {
        if findInFormulas {
            def f:string (m.getFormula(r c))
            if ((strlen f) > 0) {
                return f
            }
        }
        return (m.getCell(r c))
    }

    fn matchesText:boolean (hay:string) {
        if ((strlen findQuery) == 0) {
            return false
        }
        def a:string hay
        def b:string findQuery
        if (findMatchCase == false) {
            a = (FormulaFunctions.lower(a))
            b = (FormulaFunctions.lower(b))
        }
        if findWholeCell {
            return (a == b)
        }
        return (GridApp.indexOfSub(a b) >= 0)
    }

    sfn indexOfSub:int (hay:string needle:string) {
        def n:int (strlen needle)
        def m:int (strlen hay)
        if (n == 0) {
            return -1
        }
        def i:int 0
        while ((i + n) <= m) {
            if ((substring hay i (i + n)) == needle) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; Every occurrence in one string, replaced. Case-insensitively when the
    ; search is: the text that was there decides the case of what is left, so
    ; only the matched span is swapped.
    fn replacedText:string (hay:string) {
        def out:string ""
        def rest:string hay
        def needle:string findQuery
        def n:int (strlen needle)
        if (n == 0) {
            return hay
        }
        def guard:int 0
        while (guard < 4096) {
            def look:string rest
            def find:string needle
            if (findMatchCase == false) {
                look = (FormulaFunctions.lower(look))
                find = (FormulaFunctions.lower(find))
            }
            def at:int (GridApp.indexOfSub(look find))
            if (at < 0) {
                return (out + rest)
            }
            out = ((out + (substring rest 0 at)) + replaceWith)
            rest = (substring rest (at + n) (strlen rest))
            guard = (guard + 1)
        }
        return (out + rest)
    }

    ; The sheets a search covers, in order, starting with the active one.
    fn searchSheetCount:int () {
        if findAllSheets {
            return (book.sheetCount())
        }
        return 1
    }

    fn searchSheetAt:SpreadsheetModel (i:int) {
        if (findAllSheets == false) {
            return model
        }
        def n:int (book.sheetCount())
        def idx:int ((book.activeIndex + i) % n)
        return (book.sheetAt(idx))
    }

    fn searchSheetIndex:int (i:int) {
        if (findAllSheets == false) {
            return book.activeIndex
        }
        def n:int (book.sheetCount())
        return ((book.activeIndex + i) % n)
    }

    ; Walk from just after the active cell to the end, then wrap. Returns true
    ; when the selection landed on a match.
    fn findNext:boolean () {
        if ((strlen findQuery) == 0) {
            findStatus = "nothing to find"
            return false
        }
        def sheets:int (this.searchSheetCount())
        def si:int 0
        while (si < sheets) {
            def sheet:SpreadsheetModel (this.searchSheetAt(si))
            def startR:int 0
            def startC:int 0
            def skipFirst:boolean false
            if (si == 0) {
                startR = sel.active.row
                startC = sel.active.col
                skipFirst = true
            }
            def lastR:int (sheet.usedRow())
            def lastC:int (sheet.usedCol())
            def total:int ((lastR + 1) * (lastC + 1))
            if (total > 0) {
                def begin:int ((startR * (lastC + 1)) + startC)
                if skipFirst {
                    begin = (begin + 1)
                }
                def step:int 0
                while (step < total) {
                    def at:int ((begin + step) % total)
                    def r:int (idiv at (lastC + 1))
                    def c:int (at % (lastC + 1))
                    if (this.matchesText((this.searchTextAt(sheet r c)))) {
                        def target:int (this.searchSheetIndex(si))
                        if (target != book.activeIndex) {
                            this.setActiveSheet(target)
                        }
                        this.moveActive(r c false)
                        findStatus = ("found " + (SpreadsheetModel.cellLabel(r c)))
                        return true
                    }
                    step = (step + 1)
                }
            }
            si = (si + 1)
        }
        findStatus = ("no match for '" + findQuery + "'")
        return false
    }

    ; Replace in the active cell if it matches, then move on — Excel's Replace.
    fn replaceCurrent:boolean () {
        def r:int sel.active.row
        def c:int sel.active.col
        def before:string (this.searchTextAt(model r c))
        if ((this.matchesText(before)) == false) {
            return (this.findNext())
        }
        def after:string (this.replacedText(before))
        model.beginTx()
        this.writeSearchResult(model r c after)
        model.endTx()
        this.syncTouched()
        findStatus = ("replaced in " + (SpreadsheetModel.cellLabel(r c)))
        this.findNext()
        return true
    }

    ; A search hit is written back the way it was read: into the formula when
    ; the formula is what matched, into the value otherwise.
    fn writeSearchResult:void (m:SpreadsheetModel r:int c:int after:string) {
        def wasFormula:boolean false
        if findInFormulas {
            wasFormula = ((strlen (m.getFormula(r c))) > 0)
        }
        if wasFormula {
            m.applyEdit(r c (m.getCell(r c)) after)
        } {
            m.applyEdit(r c after "")
        }
    }

    fn replaceAll:int () {
        if ((strlen findQuery) == 0) {
            findStatus = "nothing to find"
            return 0
        }
        def count:int 0
        def sheets:int (this.searchSheetCount())
        def si:int 0
        model.beginTx()
        while (si < sheets) {
            def sheet:SpreadsheetModel (this.searchSheetAt(si))
            def lastR:int (sheet.usedRow())
            def lastC:int (sheet.usedCol())
            def r:int 0
            while (r <= lastR) {
                def c:int 0
                while (c <= lastC) {
                    def before:string (this.searchTextAt(sheet r c))
                    if (this.matchesText(before)) {
                        this.writeSearchResult(sheet r c (this.replacedText(before)))
                        count = (count + 1)
                    }
                    c = (c + 1)
                }
                r = (r + 1)
            }
            si = (si + 1)
        }
        model.endTx()
        this.syncTouched()
        engine.rebuildAll()
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
        findStatus = ((("replaced " + (to_string count)) + " of '") + findQuery + "'")
        return count
    }

    ; Ids: 501 find, 502 replace, 503..506 the options, 511..514 the buttons.
    fn openFindDialog:void () {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        findDialog.title = "Find and replace"
        findDialog.w = 380
        findDialog.labelW = 92
        findDialog.reset()
        findDialog.addInput(501 "Find" findQuery)
        findDialog.addInput(502 "Replace with" replaceWith)
        findDialog.addSeparator()
        findDialog.beginColumns(2)
        findDialog.addCheckbox(503 "Match case" findMatchCase)
        findDialog.addCheckbox(504 "Entire cell" findWholeCell)
        findDialog.addCheckbox(505 "Search formulas" findInFormulas)
        findDialog.addCheckbox(506 "All sheets" findAllSheets)
        findDialog.endColumns()
        if ((strlen findStatus) > 0) {
            findDialog.addLabel(findStatus)
        }
        def ids:[int]
        def labels:[string]
        push ids 511
        push labels "Close"
        push ids 512
        push labels "Replace all"
        push ids 513
        push labels "Replace"
        push ids 514
        push labels "Find next"
        findDialog.addButtonRow(ids labels 514)
        findDialog.finish()
        def px:int (grid.x + (idiv (W - findDialog.w) 2))
        def py:int (grid.y + 60)
        findDialog.openWithin(px py W H)
        windows.raise(findDialog)
        findDialog.focusedId = 501
        view.focused = true
    }

    ; Read the fields back, then rebuild the dialog so its status line shows
    ; what happened.
    fn syncFindDialog:void () {
        findQuery = (findDialog.inputValue(501))
        replaceWith = (findDialog.inputValue(502))
        findMatchCase = (findDialog.isChecked(503))
        findWholeCell = (findDialog.isChecked(504))
        findInFormulas = (findDialog.isChecked(505))
        findAllSheets = (findDialog.isChecked(506))
    }

    fn refreshFindDialog:void () {
        def keepX:int findDialog.x
        def keepY:int findDialog.y
        def keepFocus:int findDialog.focusedId
        this.openFindDialog()
        findDialog.x = keepX
        findDialog.y = keepY
        findDialog.focusedId = keepFocus
    }

    fn openPasteSpecial:void () {
        this.buildDialogs()
        ; Reflect the current default so the dialog opens on "All".
        pasteDialog.selectRadio(1)
        if (pasteMode == 1) {
            pasteDialog.selectRadio(2)
        }
        if (pasteMode == 2) {
            pasteDialog.selectRadio(3)
        }
        if (pasteMode == 3) {
            pasteDialog.selectRadio(4)
        }
        def px:int (grid.x + (idiv (W - pasteDialog.w) 2))
        def py:int (grid.y + 70)
        pasteDialog.openAt(px py)
        ; A dialog opened over a floating chart has to be in front of it.
        windows.raise(pasteDialog)
        view.focused = true
    }

    ; Route the frame through the window layer, then read what it produced.
    ;
    ; The return value is what the grid uses to decide whether the frame is
    ; still its own, and it is not the same question as "is a window open".
    ; A MODAL dialog owns everything until it closes. A floating chart owns
    ; only the pixels it covers: clicking the sheet beside it must still select
    ; a cell, or a chart would freeze the document it is a view of.
    fn updateDialogs:boolean (input:UIInput) {
        if ((windows.anyVisible()) == false) {
            return false
        }
        def blocking:boolean (windows.anyModalVisible())
        def consumed:boolean (windows.handlePointer(input.pointerX input.pointerY input.pointerPressed input.pointerDown input.pointerReleased))
        def ki:int 0
        def kn:int (input.keyCount())
        while (ki < kn) {
            windows.handleKey((input.keyAt(ki)) (UIKey.escape()) (UIKey.enter()))
            ki = (ki + 1)
        }
        ; While a modal dialog is up the keyboard is its own: typing goes into
        ; whatever field has focus, not into the sheet behind it.
        if blocking {
            if (input.ctrlDown == false) {
                if (input.hasText()) {
                    windows.handleText(input.textInput)
                }
            }
        }
        if (pasteDialog.activated == 10) {
            def chosen:int (pasteDialog.selectedInGroup(1))
            def mode:int 0
            if (chosen == 2) {
                mode = 1
            }
            if (chosen == 3) {
                mode = 2
            }
            if (chosen == 4) {
                mode = 3
            }
            pasteDialog.close()
            def prev:int pasteMode
            pasteMode = mode
            this.pasteClipboard()
            pasteMode = prev
        }
        if (pasteDialog.activated == 11) {
            pasteDialog.close()
        }
        ; The picker is live: whatever its controls say is what the pending
        ; chart is, every frame, and the preview draws the pending chart.
        if chartDialog.visible {
            def beforeHeaders:string ((to_string pendingChart.useHeaderRow) + (to_string pendingChart.useHeaderCol))
            this.syncChartDialog()
            def afterHeaders:string ((to_string pendingChart.useHeaderRow) + (to_string pendingChart.useHeaderCol))
            if (beforeHeaders != afterHeaders) {
                ; Which cells are data just changed, so which charts are
                ; possible changed with it.
                this.refreshChartDialog()
            }
            view.previewChart.copyFrom(pendingChart)
            view.previewChart.id = -1
            view.previewWid = chartDialog.wid
        } {
            view.previewWid = 0
        }
        if (chartDialog.activated == 403) {
            this.applyChartDialog()
        }
        if (chartDialog.activated == 401) {
            chartDialog.close()
            chartEditId = 0
        }
        if (chartDialog.activated == 402) {
            if (chartEditId > 0) {
                view.chartLayer.remove(windows chartEditId)
            }
            chartDialog.close()
            chartEditId = 0
        }
        if (findDialog.activated > 0) {
            this.syncFindDialog()
            if (findDialog.activated == 514) {
                this.findNext()
                this.refreshFindDialog()
            }
            if (findDialog.activated == 513) {
                this.replaceCurrent()
                this.refreshFindDialog()
            }
            if (findDialog.activated == 512) {
                this.replaceAll()
                this.refreshFindDialog()
            }
            if (findDialog.activated == 511) {
                findDialog.close()
            }
        }
        if (cfDialog.activated > 0) {
            if (cfDialog.activated == 633) {
                this.addCfRuleFromDialog()
            }
            if (cfDialog.activated == 634) {
                this.addCfPosNegFromDialog()
            }
            if (cfDialog.activated == 632) {
                this.clearCfRulesFromDialog()
            }
            if (cfDialog.activated == 631) {
                cfDialog.close()
                cfStatus = ""
            }
        }
        if colorDialog.visible {
            if (colorDialog.activated >= 901) {
                if (colorDialog.activated < 990) {
                    this.refreshColorDialogSelection()
                }
            }
            if (colorDialog.activated == 992) {
                this.applyColorDialog()
            }
            if (colorDialog.activated == 991) {
                this.cancelColorDialog()
            }
            if (colorDialog.activated == 990) {
                this.clearFillFromColorDialog()
            }
        } {
            ; Escape / outside close while previewing — put the sheet back.
            if colorPreviewOn {
                if (colorPreviewCommitted == false) {
                    this.restoreColorSnapshot()
                }
                colorPreviewOn = false
                colorPreviewCommitted = false
                view.colorPreviewWid = 0
            }
        }
        if (linkDialog.activated > 0) {
            if (linkDialog.activated == 813) {
                this.applyLinkDialog()
            }
            if (linkDialog.activated == 812) {
                model.clearHyperlink(sel.active.row sel.active.col)
                linkDialog.close()
            }
            if (linkDialog.activated == 811) {
                linkDialog.close()
            }
        }
        if (dvDialog.activated > 0) {
            if (dvDialog.activated == 743) {
                this.addValidationFromDialog()
            }
            if (dvDialog.activated == 742) {
                this.clearValidationsFromDialog()
            }
            if (dvDialog.activated == 741) {
                dvDialog.close()
                dvStatus = ""
            }
        }
        if (listDialog.activated > 0) {
            if (listDialog.activated == 892) {
                this.applyListPicker()
            }
            if (listDialog.activated == 891) {
                listDialog.close()
            }
        }
        this.pollChartWindows()
        ; Dragging and resizing happened inside the window layer; the charts
        ; keep their own geometry so it survives the window being rebuilt.
        view.chartLayer.syncGeometry()
        if blocking {
            return true
        }
        return consumed
    }

    fn resize:void (nw:int nh:int) {
        W = nw
        H = nh
        view.resize(W H)
        grid.setBounds(0 0 W (H - statusH))
        grid.updateVisible(model)
    }

    ; The engine is bound once at load. Per-edit code must NEVER call
    ; engine.attach() — attach clears depsOf / usedBy, which would silently stop
    ; every existing formula from tracking its inputs after the first edit.
    ; Instead: applyEdit → engine.syncCell(...) per cell → one recalcDirty().

    ; Re-register the formulas of every cell an undo / redo restored, then
    ; recalculate once.
    fn syncTouched:void () {
        engine.resetStats()
        def i:int 0
        def n:int (array_length model.touched)
        while (i < n) {
            def p:CellPos (itemAt model.touched i)
            engine.syncCell(book.activeIndex p.row p.col)
            i = (i + 1)
        }
        engine.recalcDirty()
    }

    ; Ctrl+Z / Ctrl+Y: undo or redo one whole action (paste and fill count as
    ; one), re-register the restored formulas, then recalculate.
    fn undoEdit:void () {
        if editing {
            this.cancelEdit()
        }
        model.structDirty = false
        def u:CellPos (model.undo())
        if model.structDirty {
            model.structDirty = false
            ; Op just moved to redoStack — restore cross-sheet formula text.
            def rn:int (array_length model.redoStack)
            if (rn > 0) {
                def op:SpreadsheetUndoOp (itemAt model.redoStack (rn - 1))
                this.restoreOtherSheetFormulas(op)
            }
            this.afterStructuralChange()
            return
        }
        this.syncTouched()
        this.afterCellMutation()
        this.moveActive(u.row u.col false)
    }

    fn redoEdit:void () {
        if editing {
            this.cancelEdit()
        }
        model.structDirty = false
        def r:CellPos (model.redo())
        if model.structDirty {
            model.structDirty = false
            ; Raw geometry replayed; formula text must be shifted again.
            def un:int (array_length model.undoStack)
            if (un > 0) {
                def op:SpreadsheetUndoOp (itemAt model.undoStack (un - 1))
                this.reapplyStructFormulaAdjust(op)
            }
            this.afterStructuralChange()
            return
        }
        this.syncTouched()
        this.afterCellMutation()
        this.moveActive(r.row r.col false)
    }

    fn commitEdit:void () {
        if (editing == false) {
            return
        }
        this.clearFormulaPick()
        def r:int sel.active.row
        def c:int sel.active.col
        ; A validation rule is asked BEFORE the value is written, because a
        ; refusal has to leave the cell as it was — not write and roll back,
        ; which would leave a dependent formula having seen the bad value.
        ; A formula is let through: what it evaluates to is not known yet, and
        ; Excel checks the typed text too.
        def rule:DataValidation (model.validationAt(r c))
        if ((strlen rule.kind) > 0) {
            def typed:string editBuf
            def isFormula:boolean false
            if ((strlen typed) > 0) {
                isFormula = ((charAt typed 0) == 61)
            }
            if (isFormula == false) {
                if ((rule.accepts(typed)) == false) {
                    validationError = ((SpreadsheetModel.cellLabel(r c)) + ": " + (rule.message()))
                    view.status = validationError
                    editing = false
                    editBuf = ""
                    editCaret = 0
                    return
                }
            }
        }
        validationError = ""
        model.beginTx()
        if ((strlen editBuf) > 0) {
            if ((charAt editBuf 0) == 61) {
                def expr:string (substring editBuf 1 (strlen editBuf))
                model.applyEditPlain(r c "" expr)
            } {
                ; A typed date becomes what a spreadsheet stores for one: the
                ; day count, wearing a format that draws it back the way it was
                ; typed. Nothing else in the app has to know about dates.
                def dateOk:[boolean]
                def serial:double (DateSerial.parseDate(editBuf dateOk))
                def isDate:boolean false
                if ((array_length dateOk) > 0) {
                    isDate = (itemAt dateOk 0)
                }
                if isDate {
                    def st:CellStyle ((model.getCellStyle(r c)).copy())
                    st.numFmt = (DateSerial.formatForTyped(editBuf))
                    model.clearRichText(r c)
                    model.applyEditStyled(r c (to_string (to_int serial)) "" st)
                } {
                    ; Plain value overwrites any prior formula — and the pieces
                    ; the old text was drawn in, which new text cannot belong to.
                    model.applyEditPlain(r c editBuf "")
                }
            }
        } {
            model.applyEdit(r c "" "")
        }
        model.endTx()
        engine.resetStats()
        engine.syncCell(book.activeIndex r c)
        engine.recalcDirty()
        ; Wrapped text that now needs a second line needs the room for it.
        this.growRowToFit(r)
        editing = false
        editBuf = ""
        editCaret = 0
        editInFormulaBar = false
        this.afterCellMutation()
    }

    fn cancelEdit:void () {
        this.clearFormulaPick()
        editing = false
        editBuf = ""
        editCaret = 0
        editInFormulaBar = false
    }

    fn clearFormulaPick:void () {
        formulaPicking = false
        pickTokStart = -1
        pickTokEnd = -1
        view.ghostVisible = false
    }

    ; Editing a formula that starts with `=`.
    fn isFormulaEdit:boolean () {
        if (editing == false) {
            return false
        }
        if ((strlen editBuf) == 0) {
            return false
        }
        return ((charAt editBuf 0) == 61)
    }

    ; Close dangling `(` so an in-progress edit like `=SUM(A1:A3` still parses
    ; enough for range highlights.
    sfn balanceFormulaParens:string (src:string) {
        def open:int 0
        def i:int 0
        def n:int (strlen src)
        def inStr:boolean false
        while (i < n) {
            def ch:int (charAt src i)
            if inStr {
                if (ch == 34) {
                    if (((i + 1) < n) && ((charAt src (i + 1)) == 34)) {
                        i = (i + 1)
                    } {
                        inStr = false
                    }
                }
            } {
                if (ch == 34) {
                    inStr = true
                } {
                    if (ch == 40) {
                        open = (open + 1)
                    }
                    if (ch == 41) {
                        if (open > 0) {
                            open = (open - 1)
                        }
                    }
                }
            }
            i = (i + 1)
        }
        def out:string src
        while (open > 0) {
            out = (out + ")")
            open = (open - 1)
        }
        return out
    }

    fn clearFormulaHilites:void () {
        clear view.formulaHiliteR0
        clear view.formulaHiliteC0
        clear view.formulaHiliteR1
        clear view.formulaHiliteC1
    }

    fn pushFormulaHilite:void (r0:int c0:int r1:int c1:int) {
        if ((array_length view.formulaHiliteR0) >= 12) {
            return
        }
        def a:int r0
        def b:int r1
        def c:int c0
        def d:int c1
        if (a > b) {
            def t:int a
            a = b
            b = t
        }
        if (c > d) {
            def t2:int c
            c = d
            d = t2
        }
        if (a < 0) {
            a = 0
        }
        if (c < 0) {
            c = 0
        }
        push view.formulaHiliteR0 a
        push view.formulaHiliteC0 c
        push view.formulaHiliteR1 b
        push view.formulaHiliteC1 d
    }

    ; Walk a formula AST and collect same-sheet cell / range rectangles.
    fn collectFormulaHilites:void (n:FormulaNode) {
        if (n.kind == 3) {
            def skip:boolean false
            if ((strlen n.sheet) > 0) {
                if (n.sheet != model.name) {
                    skip = true
                }
            }
            if (skip == false) {
                this.pushFormulaHilite(n.row n.col n.row n.col)
            }
            return
        }
        if (n.kind == 4) {
            def skip2:boolean false
            if ((strlen n.sheet) > 0) {
                if (n.sheet != model.name) {
                    skip2 = true
                }
            }
            if (skip2 == false) {
                this.pushFormulaHilite(n.row n.col n.row2 n.col2)
            }
            return
        }
        def i:int 0
        def kn:int (array_length n.kids)
        while (i < kn) {
            this.collectFormulaHilites((itemAt n.kids i))
            i = (i + 1)
        }
    }

    ; Excel-style coloured overlays for ranges named in the active formula —
    ; when the selected cell has one, or while that formula is being edited.
    fn refreshFormulaHilites:void () {
        this.clearFormulaHilites()
        def src:string ""
        if editing {
            if (this.isFormulaEdit()) {
                src = editBuf
            } {
                return
            }
        } {
            src = (model.formulaBarText(sel.active.row sel.active.col))
        }
        if ((strlen src) == 0) {
            return
        }
        if ((charAt src 0) != 61) {
            return
        }
        def balanced:string (GridApp.balanceFormulaParens(src))
        def p:FormulaParser (new FormulaParser)
        def ast:FormulaNode (p.parse(balanced))
        if (p.ok == false) {
            return
        }
        this.collectFormulaHilites(ast)
    }

    sfn rangeA1:string (r0:int c0:int r1:int c1:int) {
        def a:int r0
        def b:int r1
        def c:int c0
        def d:int c1
        if (a > b) {
            def t:int a
            a = b
            b = t
        }
        if (c > d) {
            def t2:int c
            c = d
            d = t2
        }
        def left:string (SpreadsheetModel.cellLabel(a c))
        if ((a == b) && (c == d)) {
            return left
        }
        return ((left + ":") + (SpreadsheetModel.cellLabel(b d)))
    }

    fn showPickGhost:void () {
        def a:int pickR0
        def b:int pickR1
        def c:int pickC0
        def d:int pickC1
        if (a > b) {
            def t:int a
            a = b
            b = t
        }
        if (c > d) {
            def t2:int c
            c = d
            d = t2
        }
        view.ghostVisible = true
        view.ghostR0 = a
        view.ghostC0 = c
        view.ghostR1 = b
        view.ghostC1 = d
    }

    ; Write (or replace) the A1 / A1:B2 token for the current pick into editBuf.
    fn applyPickToFormula:void () {
        def label:string (GridApp.rangeA1(pickR0 pickC0 pickR1 pickC1))
        if (pickTokStart < 0) {
            this.insertAtCaret(label)
            pickTokEnd = editCaret
            pickTokStart = (editCaret - (strlen label))
            return
        }
        def n:int (strlen editBuf)
        if (pickTokStart > n) {
            pickTokStart = n
        }
        if (pickTokEnd > n) {
            pickTokEnd = n
        }
        if (pickTokEnd < pickTokStart) {
            pickTokEnd = pickTokStart
        }
        def head:string (substring editBuf 0 pickTokStart)
        def tail:string (substring editBuf pickTokEnd n)
        editBuf = ((head + label) + tail)
        pickTokEnd = (pickTokStart + (strlen label))
        editCaret = pickTokEnd
    }

    fn beginFormulaPickAt:void (row:int col:int) {
        ; A fresh click with the caret still on the last pick replaces it;
        ; otherwise insert at the caret (type a comma first for another arg).
        if (pickTokEnd != editCaret) {
            pickTokStart = -1
            pickTokEnd = -1
        }
        formulaPicking = true
        pickR0 = row
        pickC0 = col
        pickR1 = row
        pickC1 = col
        this.applyPickToFormula()
        this.showPickGhost()
    }

    fn updateFormulaPickAt:void (row:int col:int) {
        pickR1 = row
        pickC1 = col
        this.applyPickToFormula()
        this.showPickGhost()
    }

    fn beginEdit:void (seed:string clearFirst:boolean) {
        this.clearFormulaPick()
        if clearFirst {
            editBuf = seed
            editInFormulaBar = false
        } {
            if (editing == false) {
                editBuf = (model.formulaBarText(sel.active.row sel.active.col))
                editInFormulaBar = false
            }
            if ((strlen seed) > 0) {
                editBuf = (editBuf + seed)
            }
        }
        editing = true
        editCaret = (strlen editBuf)
    }

    fn beginFormulaBarEdit:void () {
        if (editing == false) {
            this.clearFormulaPick()
            editBuf = (model.formulaBarText(sel.active.row sel.active.col))
            editCaret = (strlen editBuf)
        }
        editing = true
        editInFormulaBar = true
        view.focused = true
    }

    ; --- in-cell edit buffer: caret-relative editing --------------------------
    fn clampCaret:void () {
        def n:int (strlen editBuf)
        if (editCaret < 0) {
            editCaret = 0
        }
        if (editCaret > n) {
            editCaret = n
        }
    }

    fn insertAtCaret:void (text:string) {
        this.clampCaret()
        ; Typing (or any non-pick insert) ends the replaceable pick token.
        if (formulaPicking == false) {
            pickTokStart = -1
            pickTokEnd = -1
        }
        def n:int (strlen editBuf)
        def head:string (substring editBuf 0 editCaret)
        def tail:string (substring editBuf editCaret n)
        editBuf = ((head + text) + tail)
        editCaret = (editCaret + (strlen text))
    }

    fn backspaceAtCaret:void () {
        this.clampCaret()
        if (editCaret <= 0) {
            return
        }
        pickTokStart = -1
        pickTokEnd = -1
        def n:int (strlen editBuf)
        def head:string (substring editBuf 0 (editCaret - 1))
        def tail:string (substring editBuf editCaret n)
        editBuf = (head + tail)
        editCaret = (editCaret - 1)
    }

    fn deleteAtCaret:void () {
        this.clampCaret()
        def n:int (strlen editBuf)
        if (editCaret >= n) {
            return
        }
        pickTokStart = -1
        pickTokEnd = -1
        def head:string (substring editBuf 0 editCaret)
        def tail:string (substring editBuf (editCaret + 1) n)
        editBuf = (head + tail)
    }

    fn moveCaret:void (delta:int) {
        editCaret = (editCaret + delta)
        this.clampCaret()
        pickTokStart = -1
        pickTokEnd = -1
    }

    ; --- used range ----------------------------------------------------------
    ; Excel bounds Ctrl+End / End at the last cell that holds data, not at the
    ; declared sheet size. SpreadsheetModel tracks that corner as cells are
    ; written, so this stays O(1) even on the 100k-row fixture.
    fn lastUsedColInRow:int (row:int) {
        def c:int (model.usedCol())
        while (c >= 0) {
            if ((strlen (model.getCell(row c))) > 0) {
                return c
            }
            c = (c - 1)
        }
        return 0
    }

    ; Ctrl+Arrow: jump to the edge of the current data block.
    ;   in data, neighbour filled  → last filled cell of the run
    ;   in data, neighbour empty   → next filled cell, else the sheet edge
    ;   on a blank cell            → next filled cell, else the sheet edge
    fn edgeJump:CellPos (row:int col:int dr:int dc:int) {
        def maxR:int (model.rowCount - 1)
        def maxC:int (model.colCount - 1)
        def r:int row
        def c:int col
        def nr:int (r + dr)
        def nc:int (c + dc)
        if ((nr < 0) || (nr > maxR) || (nc < 0) || (nc > maxC)) {
            return (CellPos.create(r c))
        }
        def hereFilled:boolean ((strlen (model.getCell(r c))) > 0)
        def nextFilled:boolean ((strlen (model.getCell(nr nc))) > 0)
        def runMode:boolean false
        if (hereFilled && nextFilled) {
            runMode = true
        }
        def more:boolean true
        while more {
            def tr:int (r + dr)
            def tc:int (c + dc)
            if ((tr < 0) || (tr > maxR) || (tc < 0) || (tc > maxC)) {
                more = false
            } {
                def filled:boolean ((strlen (model.getCell(tr tc))) > 0)
                if runMode {
                    if filled {
                        r = tr
                        c = tc
                    } {
                        more = false
                    }
                } {
                    r = tr
                    c = tc
                    if filled {
                        more = false
                    }
                }
            }
        }
        return (CellPos.create(r c))
    }

    ; Band selection. The far end is the anchor so the active cell stays at the
    ; top / left of the band — otherwise the next arrow key would resume from
    ; the last row of the sheet.
    fn selectColumn:void (col:int) {
        sel.anchor.row = (model.rowCount - 1)
        sel.anchor.col = col
        sel.active.row = 0
        sel.active.col = col
        grid.ensureCellVisible(model 0 col)
    }

    fn selectRow:void (row:int) {
        sel.anchor.row = row
        sel.anchor.col = (model.colCount - 1)
        sel.active.row = row
        sel.active.col = 0
        grid.ensureCellVisible(model row 0)
    }

    ; Rows a PageUp / PageDown step covers: one viewport minus one row of
    ; overlap, so the cell you were reading stays on screen.
    fn pageRows:int () {
        def n:int ((grid.lastScrollRow - grid.firstScrollRow) + 1)
        if (n < 1) {
            n = 1
        }
        if (n > 1) {
            n = (n - 1)
        }
        return n
    }

    ; Excel's grid has no edge you can walk off: pressing Down on the last row
    ; gives you a new one. A loaded sheet is only as big as its used range, so
    ; grow it as the caret (or a paste) reaches the end. Bounded by Excel's own
    ; limits so a runaway cannot allocate without end.
    fn ensureExtent:void (row:int col:int) {
        def rows:int (row + 1)
        def cols:int (col + 1)
        if (rows > 1048576) {
            rows = 1048576
        }
        if (cols > 16384) {
            cols = 16384
        }
        if ((rows <= model.rowCount) && (cols <= model.colCount)) {
            return
        }
        model.growTo(rows cols)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    fn moveActive:void (row:int col:int extend:boolean) {
        if editing {
            this.commitEdit()
        }
        if (row >= 0) {
            if (col >= 0) {
                this.ensureExtent(row col)
            }
        }
        def p:CellPos (CellPos.create(row col))
        model.clampPos(p)
        sel.setActive(p.row p.col)
        if (extend == false) {
            sel.collapseToActive()
        }
        grid.ensureCellVisible(model p.row p.col)
    }

    fn handleKey:void (key:int input:UIInput) {
        def extend:boolean input.shiftDown
        if editing {
            if (key == (UIKey.enter())) {
                this.commitEdit()
                if extend {
                    this.moveActive((sel.active.row - 1) sel.active.col false)
                } {
                    this.moveActive((sel.active.row + 1) sel.active.col false)
                }
                return
            }
            if (key == (UIKey.tab())) {
                this.commitEdit()
                if extend {
                    this.moveActive(sel.active.row (sel.active.col - 1) false)
                } {
                    this.moveActive(sel.active.row (sel.active.col + 1) false)
                }
                return
            }
            if (key == (UIKey.escape())) {
                this.cancelEdit()
                return
            }
            if (key == (UIKey.backspace())) {
                this.backspaceAtCaret()
                return
            }
            if (key == (UIKey.del())) {
                this.deleteAtCaret()
                return
            }
            if (key == (UIKey.left())) {
                this.moveCaret(-1)
                return
            }
            if (key == (UIKey.right())) {
                this.moveCaret(1)
                return
            }
            if (key == (UIKey.home())) {
                editCaret = 0
                return
            }
            if (key == (UIKey.end())) {
                editCaret = (strlen editBuf)
                return
            }
            return
        }
        def ctrl:boolean input.ctrlDown
        if (key == (UIKey.left())) {
            this.arrowKey(0 -1 ctrl extend)
            return
        }
        if (key == (UIKey.right())) {
            this.arrowKey(0 1 ctrl extend)
            return
        }
        if (key == (UIKey.up())) {
            this.arrowKey(-1 0 ctrl extend)
            return
        }
        if (key == (UIKey.down())) {
            this.arrowKey(1 0 ctrl extend)
            return
        }
        if (key == (UIKey.pageUp())) {
            this.moveActive((sel.active.row - (this.pageRows())) sel.active.col extend)
            return
        }
        if (key == (UIKey.pageDown())) {
            this.moveActive((sel.active.row + (this.pageRows())) sel.active.col extend)
            return
        }
        ; Excel: Enter steps down (Shift+Enter up); F2 opens the cell for edit.
        if (key == (UIKey.enter())) {
            if extend {
                this.moveActive((sel.active.row - 1) sel.active.col false)
            } {
                this.moveActive((sel.active.row + 1) sel.active.col false)
            }
            return
        }
        if (key == (UIKey.f2())) {
            this.beginEdit("" false)
            return
        }
        if (key == (UIKey.tab())) {
            if extend {
                this.moveActive(sel.active.row (sel.active.col - 1) false)
            } {
                this.moveActive(sel.active.row (sel.active.col + 1) false)
            }
            return
        }
        if (key == (UIKey.del())) {
            this.clearSelection()
            return
        }
        if (key == (UIKey.backspace())) {
            this.beginEdit("" true)
            return
        }
        if (key == (UIKey.home())) {
            if ctrl {
                this.moveActive(0 0 extend)
            } {
                this.moveActive(sel.active.row 0 extend)
            }
            return
        }
        if (key == (UIKey.end())) {
            if ctrl {
                this.moveActive((model.usedRow()) (model.usedCol()) extend)
            } {
                this.moveActive(sel.active.row (this.lastUsedColInRow(sel.active.row)) extend)
            }
            return
        }
        if (key == (UIKey.escape())) {
            sel.collapseToActive()
            return
        }
    }

    ; Arrow navigation. Ctrl jumps to the edge of the data block, Shift extends
    ; the selection, Ctrl+Shift does both.
    fn arrowKey:void (dr:int dc:int ctrl:boolean extend:boolean) {
        if ctrl {
            def p:CellPos (this.edgeJump(sel.active.row sel.active.col dr dc))
            this.moveActive(p.row p.col extend)
            return
        }
        this.moveActive((sel.active.row + dr) (sel.active.col + dc) extend)
    }

    sfn htmlEscape:string (v:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen v)
        while (i < n) {
            def c:int (charAt v i)
            if (c == 38) {
                out = (out + "&amp;")
            } {
                if (c == 60) {
                    out = (out + "&lt;")
                } {
                    if (c == 62) {
                        out = (out + "&gt;")
                    } {
                        if (c == 34) {
                            out = (out + "&quot;")
                        } {
                            out = (out + (substring v i (i + 1)))
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; CellStyle colours already carry a leading "#" when they come from
    ; styles.xml; normalize either form to a CSS colour, or "" if unusable.
    sfn cssColor:string (v:string) {
        def s:string v
        if ((strlen s) == 0) {
            return ""
        }
        if ((charAt s 0) == 35) {
            s = (substring s 1 (strlen s))
        }
        if ((strlen s) != 6) {
            return ""
        }
        return ("#" + s)
    }

    ; One <td>, carrying the bits of cell style a word processor can honour.
    fn cellHtml:string (r:int c:int) {
        def st:CellStyle (model.getCellStyle(r c))
        def style:string ""
        if st.hasFill {
            def bg:string (GridApp.cssColor(st.fillRgb))
            if ((strlen bg) > 0) {
                style = (style + "background-color:" + bg + ";")
            }
        }
        def fg:string (GridApp.cssColor(st.textRgb))
        if ((strlen fg) > 0) {
            style = (style + "color:" + fg + ";")
        }
        if st.bold {
            style = (style + "font-weight:bold;")
        }
        if (st.align != "left") {
            style = (style + "text-align:" + st.align + ";")
        }
        def open:string "<td"
        if ((strlen style) > 0) {
            open = (open + " style=\"" + style + "\"")
        }
        open = (open + ">")
        def body:string (GridApp.htmlEscape((model.getCell(r c))))
        if ((strlen body) == 0) {
            body = "&nbsp;"
        }
        return ((open + body) + "</td>")
    }

    ; Excel-style clipboard. Three representations are kept:
    ;   * clipboardTsv     — flat text, what a host would put on the OS clipboard
    ;   * clipboardHtml    — an HTML <table>, the flavour Word/Excel paste as a
    ;     real table (Excel puts the same two flavours on the clipboard)
    ;   * clipValues/Formulas + clipR0/clipC0 — structured block, so paste can
    ;     translate relative refs the way Excel copy/paste does.
    fn copySelection:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        clipR0 = a.row
        clipC0 = a.col
        clipRows = ((b.row - a.row) + 1)
        clipCols = ((b.col - a.col) + 1)
        clipCut = false
        clear clipValues
        clear clipFormulas
        clear clipStyles
        def out:string ""
        def html:string "<table border=\"1\" cellspacing=\"0\" cellpadding=\"4\">"
        def r:int a.row
        while (r <= b.row) {
            if (r > a.row) {
                out = (out + "\n")
            }
            html = (html + "<tr>")
            def c:int a.col
            while (c <= b.col) {
                if (c > a.col) {
                    out = (out + "\t")
                }
                def v:string (model.getCell(r c))
                out = (out + v)
                html = (html + (this.cellHtml(r c)))
                push clipValues v
                push clipFormulas (model.getFormula(r c))
                ; Formatting travels with the cell, so a paste looks like the
                ; source by default — the way every spreadsheet behaves.
                def cst:CellStyle (model.getCellStyle(r c))
                push clipStyles (cst.copy())
                c = (c + 1)
            }
            html = (html + "</tr>")
            r = (r + 1)
        }
        clipboardTsv = out
        clipboardHtml = (html + "</table>")
        clipboardKind = "cells"
        clipboardPng = ""
        clipboardSvg = ""
        clipboardChartJson = ""
        clipboardChartJson = ""
        clipboardName = ""
        clipboardSeq = (clipboardSeq + 1)
    }

    ; Ctrl+X: copy, then clear the source range as one undoable action. A cut
    ; block pastes without ref translation (Excel moves formulas as written).
    ; Formulas elsewhere that pointed at the moved cells are not rewritten.
    fn cutSelection:void () {
        this.copySelection()
        this.clearSelection()
        clipCut = true
    }

    ; Host-supplied clipboard text (OS paste): drops the structured block so the
    ; TSV path is used and no stale formulas leak in.
    fn setClipboardText:void (text:string) {
        clipboardTsv = text
        clipboardHtml = ""
        clipboardKind = "cells"
        clipboardPng = ""
        clipboardSvg = ""
        clipCut = false
        clear clipValues
        clear clipFormulas
        clear clipStyles
        clipRows = 0
        clipCols = 0
    }

    fn pasteClipboard:void () {
        if editing {
            this.commitEdit()
        }
        if ((array_length clipValues) > 0) {
            this.pasteBlock()
            return
        }
        this.pasteTsv()
    }

    ; Structured paste: a copied formula is re-based by the paste offset, so
    ; =A1+B1 copied one row down becomes =A2+B2 (absolute refs stay put).
    fn pasteBlock:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def startR:int a.row
        def startC:int a.col
        def dy:int (startR - clipR0)
        def dx:int (startC - clipC0)
        if clipCut {
            dy = 0
            dx = 0
        }
        this.ensureExtent(((startR + clipRows) - 1) ((startC + clipCols) - 1))
        def maxR:int startR
        def maxC:int startC
        model.beginTx()
        engine.resetStats()
        def idx:int 0
        def ri:int 0
        while (ri < clipRows) {
            def ci:int 0
            while (ci < clipCols) {
                def tr:int (startR + ri)
                def tc:int (startC + ci)
                if ((tr < model.rowCount) && (tc < model.colCount)) {
                    def f:string (itemAt clipFormulas idx)
                    def srcStyle:CellStyle (itemAt clipStyles idx)
                    def newValue:string (itemAt clipValues idx)
                    def newFormula:string ""
                    if ((strlen f) > 0) {
                        def translated:string (FormulaParser.translateFormula(f dx dy))
                        if ((strlen translated) > 0) {
                            newFormula = translated
                            newValue = ""
                        }
                    }
                    ; Paste mode picks which of the three parts land.
                    ;   0 everything (default)  1 values only
                    ;   2 formats only          3 values + formulas, no formats
                    if (pasteMode == 1) {
                        newFormula = ""
                        newValue = (itemAt clipValues idx)
                    }
                    if (pasteMode == 2) {
                        newFormula = (model.getFormula(tr tc))
                        newValue = (model.getCell(tr tc))
                    }
                    def useStyle:CellStyle srcStyle
                    if ((pasteMode == 1) || (pasteMode == 3)) {
                        useStyle = (model.getCellStyle(tr tc))
                    }
                    model.applyEditStyled(tr tc newValue newFormula useStyle)
                    engine.syncCell(book.activeIndex tr tc)
                    if (tr > maxR) {
                        maxR = tr
                    }
                    if (tc > maxC) {
                        maxC = tc
                    }
                }
                idx = (idx + 1)
                ci = (ci + 1)
            }
            ri = (ri + 1)
        }
        model.endTx()
        engine.recalcDirty()
        clipCut = false
        sel.anchor.row = startR
        sel.anchor.col = startC
        sel.active.row = maxR
        sel.active.col = maxC
        this.afterCellMutation()
        grid.ensureCellVisible(model sel.active.row sel.active.col)
    }

    ; Plain-text fallback (external clipboard): values only, no formulas.
    fn pasteTsv:void () {
        if ((strlen clipboardTsv) == 0) {
            return
        }
        def lines:[string] (strsplit clipboardTsv "\n")
        def startR:int sel.active.row
        def startC:int sel.active.col
        def maxR:int startR
        def maxC:int startC
        def firstCols:[string] (strsplit (itemAt lines 0) "\t")
        this.ensureExtent(((startR + (array_length lines)) - 1) ((startC + (array_length firstCols)) - 1))
        model.beginTx()
        engine.resetStats()
        def ri:int 0
        def nLines:int (array_length lines)
        while (ri < nLines) {
            def rowText:string (itemAt lines ri)
            def cols:[string] (strsplit rowText "\t")
            def ci:int 0
            def nCols:int (array_length cols)
            while (ci < nCols) {
                def tr:int (startR + ri)
                def tc:int (startC + ci)
                if ((tr < model.rowCount) && (tc < model.colCount)) {
                    model.applyEdit(tr tc (itemAt cols ci) "")
                    engine.syncCell(book.activeIndex tr tc)
                    if (tr > maxR) {
                        maxR = tr
                    }
                    if (tc > maxC) {
                        maxC = tc
                    }
                }
                ci = (ci + 1)
            }
            ri = (ri + 1)
        }
        model.endTx()
        engine.recalcDirty()
        sel.anchor.row = startR
        sel.anchor.col = startC
        sel.active.row = maxR
        sel.active.col = maxC
        this.afterCellMutation()
        grid.ensureCellVisible(model sel.active.row sel.active.col)
    }

    ; Delete: clear values AND formulas over a range, as one undoable action,
    ; then recalculate everything that depended on those cells.
    fn clearRange:void (r0:int c0:int r1:int c1:int) {
        model.beginTx()
        engine.resetStats()
        def r:int r0
        while (r <= r1) {
            def c:int c0
            while (c <= c1) {
                model.applyEdit(r c "" "")
                engine.syncCell(book.activeIndex r c)
                c = (c + 1)
            }
            r = (r + 1)
        }
        model.endTx()
        engine.recalcDirty()
        this.afterCellMutation()
    }

    ; Everything the selection covers, whatever shape it is in: a Ctrl+click
    ; selection is several rectangles and Delete has to clear all of them, in
    ; one transaction, so it is one Ctrl+Z.
    fn clearSelection:void () {
        model.beginTx()
        def i:int 0
        while (i < (sel.rangeCount())) {
            def g:GridRange (sel.rangeAt(i))
            this.clearRange(g.r0 g.c0 g.r1 g.c1)
            i = (i + 1)
        }
        model.endTx()
        this.afterCellMutation()
    }

    ; FortuneSheet fill handle: tile source rect; translate relative formula refs.
    fn fillFromSource:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def srcH:int ((fillR1 - fillR0) + 1)
        def srcW:int ((fillC1 - fillC0) + 1)
        if (srcH < 1) {
            return
        }
        if (srcW < 1) {
            return
        }
        model.beginTx()
        engine.resetStats()
        def r:int a.row
        while (r <= b.row) {
            def c:int a.col
            while (c <= b.col) {
                def inSrc:boolean false
                if ((r >= fillR0) && (r <= fillR1) && (c >= fillC0) && (c <= fillC1)) {
                    inSrc = true
                }
                if (inSrc == false) {
                    def dr:int (r - fillR0)
                    def dc:int (c - fillC0)
                    def sr:int (fillR0 + (dr - ((to_int (dr / srcH)) * srcH)))
                    def sc:int (fillC0 + (dc - ((to_int (dc / srcW)) * srcW)))
                    def srcF:string (model.getFormula(sr sc))
                    def wrote:boolean false
                    if ((strlen srcF) > 0) {
                        def dx:int (c - sc)
                        def dy:int (r - sr)
                        def translated:string (FormulaParser.translateFormula(srcF dx dy))
                        if ((strlen translated) > 0) {
                            model.applyEdit(r c "" translated)
                            wrote = true
                        }
                    }
                    if (wrote == false) {
                        model.applyEdit(r c (model.getCell(sr sc)) "")
                    }
                    engine.syncCell(book.activeIndex r c)
                }
                c = (c + 1)
            }
            r = (r + 1)
        }
        model.endTx()
        ; Recalc newly registered / dependent formulas once.
        engine.recalcDirty()
        this.afterCellMutation()
    }

    ; Pointer press that is neither a sheet tab nor a header resize: fill
    ; handle, header menu, formula bar, or cell selection.
    ; --- moving a range ------------------------------------------------------
    ; Drag the selection's border and the cells go with it. Excel calls this
    ; drag-and-drop; it is a cut and a paste, which means formulas move AS
    ; WRITTEN — a reference is not re-based, because the cell it names has not
    ; moved just because this one did.
    fn moveBlock:void (r0:int c0:int r1:int c1:int toR:int toC:int) {
        if ((toR == r0) && (toC == c0)) {
            return
        }
        def rows:int ((r1 - r0) + 1)
        def cols:int ((c1 - c0) + 1)
        if (toR < 0) {
            return
        }
        if (toC < 0) {
            return
        }
        ; Read the whole block first: source and target can overlap.
        def vals:[string]
        def fmls:[string]
        def sids:[CellStyle]
        def r:int r0
        while (r <= r1) {
            def c:int c0
            while (c <= c1) {
                push vals (model.getCell(r c))
                push fmls (model.getFormula(r c))
                push sids (model.getCellStyle(r c))
                c = (c + 1)
            }
            r = (r + 1)
        }
        this.ensureExtent(((toR + rows) - 1) ((toC + cols) - 1))
        model.beginTx()
        def cr:int r0
        while (cr <= r1) {
            def cc:int c0
            while (cc <= c1) {
                model.applyEdit(cr cc "" "")
                cc = (cc + 1)
            }
            cr = (cr + 1)
        }
        def i:int 0
        def wr:int 0
        while (wr < rows) {
            def wc:int 0
            while (wc < cols) {
                model.applyEditStyled((toR + wr) (toC + wc) (itemAt vals i) (itemAt fmls i) (itemAt sids i))
                i = (i + 1)
                wc = (wc + 1)
            }
            wr = (wr + 1)
        }
        model.endTx()
        this.syncTouched()
        sel.clearExtra()
        sel.anchor.row = toR
        sel.anchor.col = toC
        sel.active.row = ((toR + rows) - 1)
        sel.active.col = ((toC + cols) - 1)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    ; Where the dragged block would land, given the cell the pointer is over.
    fn moveTargetRow:int (hitRow:int) {
        def dr:int (hitRow - moveGrabR)
        def toR:int (moveR0 + dr)
        if (toR < 0) {
            toR = 0
        }
        return toR
    }

    fn moveTargetCol:int (hitCol:int) {
        def dc:int (hitCol - moveGrabC)
        def toC:int (moveC0 + dc)
        if (toC < 0) {
            toC = 0
        }
        return toC
    }

    fn handlePress:void (input:UIInput) {
        ; The list arrow belongs to the active cell and sits inside it, so it
        ; has to be asked before the cell is.
        if (editing == false) {
            if (model.hasValidation(sel.active.row sel.active.col)) {
                def dvHere:DataValidation (model.validationAt(sel.active.row sel.active.col))
                if (dvHere.isList()) {
                    if (grid.hitListArrow(model sel input.pointerX input.pointerY)) {
                        view.focused = true
                        this.openListPicker(sel.active.row sel.active.col)
                        return
                    }
                }
            }
        }
        def onFill:boolean false
        if (editing == false) {
            onFill = (grid.hitFillHandle(model sel input.pointerX input.pointerY))
        }
        if (editing == false) {
            if (onFill == false) {
                if ((sel.isSingle()) == false) {
                    if (grid.hitSelectionEdge(model sel input.pointerX input.pointerY)) {
                        def start:CellPos (grid.hitTest(model input.pointerX input.pointerY))
                        if ((start.row >= 0) && (start.col >= 0)) {
                            def g:GridRange (sel.liveRange())
                            moveR0 = g.r0
                            moveC0 = g.c0
                            moveR1 = g.r1
                            moveC1 = g.c1
                            moveGrabR = start.row
                            moveGrabC = start.col
                            movingRange = true
                            dragging = false
                            filling = false
                            view.focused = true
                            view.ghostVisible = true
                            view.ghostR0 = moveR0
                            view.ghostC0 = moveC0
                            view.ghostR1 = moveR1
                            view.ghostC1 = moveC1
                            return
                        }
                    }
                }
            }
        }
        if onFill {
            ; FortuneSheet fill-handle drag starts from current selection
            view.focused = true
            def a0:CellPos (new CellPos)
            def b0:CellPos (new CellPos)
            sel.normalized(a0 b0)
            fillR0 = a0.row
            fillC0 = a0.col
            fillR1 = b0.row
            fillC1 = b0.col
            filling = true
            dragging = false
        } {
            def hit:CellPos (grid.hitTest(model input.pointerX input.pointerY))
            def menuHit:int (this.hitHeaderMenu(input.pointerX input.pointerY))
            if (menuHit >= 0) {
                view.focused = true
                if (menuHit >= 1) {
                    this.runHeaderMenu(menuHit)
                }
            } {
                if ((hit.row == -2) && (hit.col >= 0)) {
                    ; Column header → sort/filter popup
                    view.focused = true
                    if editing {
                        this.commitEdit()
                    }
                    this.openHeaderMenu(hit.col input.pointerX (grid.y + grid.formulaBarH + grid.colHeaderH))
                } {
                if ((hit.col == -2) && (hit.row >= 0)) {
                    ; Row header → the row's own popup.
                    view.focused = true
                    if editing {
                        this.commitEdit()
                    }
                    def menuTop:int input.pointerY
                    if ((menuTop + view.menuH) > H) {
                        menuTop = (H - (view.menuH + 6))
                    }
                    if (menuTop < grid.y) {
                        menuTop = grid.y
                    }
                    this.openRowMenu(hit.row (grid.x + grid.rowHeaderW) menuTop)
                } {
                    if view.menuOpen {
                        this.closeHeaderMenu()
                    }
                    if ((hit.row == -3) && (hit.col == -3)) {
                        this.beginFormulaBarEdit()
                    } {
                        if ((hit.row >= 0) && (hit.col >= 0)) {
                            view.focused = true
                            ; While typing a formula, a click on another cell
                            ; inserts A1 / A1:B2 at the caret — it must not
                            ; commit the edit or move the cell being written.
                            if (this.isFormulaEdit()) {
                                if ((hit.row != sel.active.row) || (hit.col != sel.active.col)) {
                                    this.beginFormulaPickAt(hit.row hit.col)
                                    dragging = true
                                    return
                                }
                            }
                            if editing {
                                if ((hit.row != sel.active.row) || (hit.col != sel.active.col)) {
                                    this.commitEdit()
                                }
                            }
                            ; Ctrl+click keeps what is selected and starts
                            ; another rectangle beside it, as Excel does.
                            ; Moving the active cell collapses the selection, so
                            ; the rectangle is lifted out first and handed back
                            ; after.
                            def keeping:boolean false
                            def kept:GridRange (sel.liveRange())
                            if input.ctrlDown {
                                if (input.shiftDown == false) {
                                    ; Ctrl+click on a link follows it rather
                                    ; than starting another rectangle — the
                                    ; link is the more specific gesture.
                                    if (model.hasHyperlink(hit.row hit.col)) {
                                        this.moveActive(hit.row hit.col false)
                                        this.followLink(hit.row hit.col)
                                        return
                                    }
                                    keeping = true
                                }
                            }
                            this.moveActive(hit.row hit.col input.shiftDown)
                            if keeping {
                                sel.keepRange(kept)
                            }
                            dragging = true
                        }
                    }
                }
                }
            }
        }
    }

    ; Pointer drag that is not a resize: fill-handle rubber band or range select.
    fn handleDrag:void (input:UIInput) {
        if formulaPicking {
            def hitP:CellPos (grid.hitTest(model input.pointerX input.pointerY))
            if ((hitP.row >= 0) && (hitP.col >= 0)) {
                this.updateFormulaPickAt(hitP.row hitP.col)
            }
            return
        }
        if movingRange {
            def hitM:CellPos (grid.hitTest(model input.pointerX input.pointerY))
            if ((hitM.row >= 0) && (hitM.col >= 0)) {
                def toR:int (this.moveTargetRow(hitM.row))
                def toC:int (this.moveTargetCol(hitM.col))
                view.ghostVisible = true
                view.ghostR0 = toR
                view.ghostC0 = toC
                view.ghostR1 = ((toR + (moveR1 - moveR0)))
                view.ghostC1 = ((toC + (moveC1 - moveC0)))
            }
            return
        }
        if filling {
            if (input.pointerPressed == false) {
                def hitF:CellPos (grid.hitTest(model input.pointerX input.pointerY))
                if ((hitF.row >= 0) && (hitF.col >= 0)) {
                    sel.anchor.row = fillR0
                    sel.anchor.col = fillC0
                    sel.active.row = hitF.row
                    sel.active.col = hitF.col
                    ; keep source corner as the other end of the range
                    def a1:CellPos (new CellPos)
                    def b1:CellPos (new CellPos)
                    sel.normalized(a1 b1)
                    if (a1.row > fillR0) {
                        a1.row = fillR0
                    }
                    if (a1.col > fillC0) {
                        a1.col = fillC0
                    }
                    if (b1.row < fillR1) {
                        b1.row = fillR1
                    }
                    if (b1.col < fillC1) {
                        b1.col = fillC1
                    }
                    sel.anchor.row = a1.row
                    sel.anchor.col = a1.col
                    sel.active.row = b1.row
                    sel.active.col = b1.col
                }
            }
        } {
            if dragging {
                if (input.pointerPressed == false) {
                    def hit2:CellPos (grid.hitTest(model input.pointerX input.pointerY))
                    if ((hit2.row >= 0) && (hit2.col >= 0)) {
                        this.moveActive(hit2.row hit2.col true)
                    }
                }
            }
        }
    }

    fn update:void (input:UIInput) {
        ; A visible dialog owns the frame.
        if (this.updateDialogs(input)) {
            return
        }
        ; The toolbar lights up under the pointer whether or not a button is
        ; pressed — without that it is a row of shapes rather than something
        ; that looks clickable. The hot label is this app's tooltip.
        view.toolbar.hot = (this.toolbarHit(input.pointerX input.pointerY))
        def tip:string (view.toolbar.hotLabel())
        if ((strlen tip) > 0) {
            view.status = tip
        }
        if input.pointerPressed {
            ; A font / size dropdown owns the click before the toolbar does,
            ; so picking a size does not also re-open the menu.
            if view.menuOpen {
                if ((view.menuKind == 2) || (view.menuKind == 3)) {
                    def menuHit0:int (this.hitHeaderMenu(input.pointerX input.pointerY))
                    if (menuHit0 >= 0) {
                        view.focused = true
                        if (menuHit0 >= 1) {
                            this.runHeaderMenu(menuHit0)
                        }
                        return
                    }
                    this.closeHeaderMenu()
                }
            }
            def hitTool:int (this.toolbarHit(input.pointerX input.pointerY))
            if (hitTool >= 0) {
                view.focused = true
                this.runToolbarItem(hitTool)
                return
            }
            if (this.chartButtonHit(input.pointerX input.pointerY)) {
                this.openChartDialog(0)
                return
            }
            def toolIdx:int (this.toolButtonHit(input.pointerX input.pointerY))
            if (toolIdx >= 0) {
                def tool:GridCommand (commands.customAt(toolIdx))
                view.focused = true
                this.runCommand(tool.id "")
                return
            }
            def tab:int (grid.hitSheetTab((book.sheetCount()) input.pointerX input.pointerY))
            if (tab >= 0) {
                this.setActiveSheet(tab)
                view.focused = true
            } {
                def resizeCol:int (grid.hitColResize(model input.pointerX input.pointerY))
                def resizeRow:int -1
                if (resizeCol < 0) {
                    resizeRow = (grid.hitRowResize(model input.pointerX input.pointerY))
                }
                if (resizeCol >= 0) {
                    if editing {
                        this.commitEdit()
                    }
                    resizing = true
                    grid.resizingCol = resizeCol
                    grid.resizeStartX = input.pointerX
                    grid.resizeStartW = (model.colWidth(resizeCol))
                    view.focused = true
                } {
                    if (resizeRow >= 0) {
                        if editing {
                            this.commitEdit()
                        }
                        resizingRows = true
                        grid.resizingRow = resizeRow
                        grid.resizeStartY = input.pointerY
                        grid.resizeStartH = (model.rowHeight(resizeRow))
                        view.focused = true
                    } {
                        this.handlePress(input)
                    }
                }
            }
        }

        if input.pointerDown {
            if resizing {
                def dx:int (input.pointerX - grid.resizeStartX)
                def w:int (grid.resizeStartW + dx)
                if (w < 24) {
                    w = 24
                }
                ; Dragging one edge of a multi-column selection sizes them all.
                this.setColumnWidths(grid.resizingCol w)
            } {
                if resizingRows {
                    def dy:int (input.pointerY - grid.resizeStartY)
                    model.setRowHeight(grid.resizingRow (grid.resizeStartH + dy))
                    sheetView.markDirty()
                    sheetView.rebuild()
                    grid.updateVisible(model)
                } {
                    this.handleDrag(input)
                }
            }
        }

        if input.pointerReleased {
            if movingRange {
                def hitD:CellPos (grid.hitTest(model input.pointerX input.pointerY))
                if ((hitD.row >= 0) && (hitD.col >= 0)) {
                    this.moveBlock(moveR0 moveC0 moveR1 moveC1 (this.moveTargetRow(hitD.row)) (this.moveTargetCol(hitD.col)))
                }
                movingRange = false
                view.ghostVisible = false
            }
            if formatBrushArmed {
                if (resizing == false) {
                    if (resizingRows == false) {
                        this.applyFormatToSelection()
                    }
                }
            }
            if filling {
                this.fillFromSource()
            }
            filling = false
            dragging = false
            movingRange = false
            if formulaPicking {
                formulaPicking = false
                this.showPickGhost()
            } {
                if ((this.isFormulaEdit()) && (pickTokStart >= 0)) {
                    this.showPickGhost()
                } {
                    view.ghostVisible = false
                }
            }
            resizing = false
            resizingRows = false
            grid.resizingCol = -1
            grid.resizingRow = -1
        }

        ; The wheel. Shift turns it sideways, which is what every spreadsheet
        ; does and what this had no answer for: a column off the right edge
        ; could not be reached with the mouse at all.
        if (input.scrollDelta != 0) {
            if input.shiftDown {
                grid.scrollByCols(model (0 - input.scrollDelta))
            } {
                grid.scrollByRows(model (0 - input.scrollDelta))
            }
        }
        ; …and a trackpad sends sideways notches of its own.
        if (input.scrollDeltaX != 0) {
            grid.scrollByCols(model (0 - input.scrollDeltaX))
        }

        if input.ctrlDown {
            def t:string input.textInput
            def ti:int 0
            def tn:int (strlen t)
            while (ti < tn) {
                def ch:int (charAt t ti)
                if ((ch == 97) || (ch == 65)) {
                    if editing {
                        this.commitEdit()
                    }
                    sel.selectAll(model)
                    grid.ensureCellVisible(model sel.active.row sel.active.col)
                }
                if ((ch == 99) || (ch == 67)) {
                    if editing {
                        this.commitEdit()
                    }
                    if input.shiftDown {
                        this.copyFormat()
                    } {
                        ; A chart window on top is what Ctrl+C means then —
                        ; the same rule Excel uses for a selected chart.
                        def onChart:int (this.focusedChartId())
                        if (onChart > 0) {
                            this.copyChart(onChart)
                        } {
                            this.copySelection()
                        }
                    }
                }
                if ((ch == 120) || (ch == 88)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.cutSelection()
                }
                if ((ch == 118) || (ch == 86)) {
                    if input.shiftDown {
                        this.openPasteSpecial()
                    } {
                        this.pasteClipboard()
                    }
                }
                if ((ch == 102) || (ch == 70)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.openFindDialog()
                }
                if ((ch == 104) || (ch == 72)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.openFindDialog()
                }
                if ((ch == 108) || (ch == 76)) {
                    if editing {
                        this.commitEdit()
                    }
                    cfStatus = ""
                    this.openCfDialog()
                }
                ; Bold, italic, underline — the three every spreadsheet binds,
                ; and which had nothing behind them until the formatting
                ; commands existed.
                if ((ch == 98) || (ch == 66)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.runCommand("format.bold" "")
                }
                if ((ch == 105) || (ch == 73)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.runCommand("format.italic" "")
                }
                if ((ch == 117) || (ch == 85)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.runCommand("format.underline" "")
                }
                if ((ch == 107) || (ch == 75)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.openLinkDialog()
                }
                if ((ch == 101) || (ch == 69)) {
                    if editing {
                        this.commitEdit()
                    }
                    dvStatus = ""
                    this.openValidationDialog()
                }
                if ((ch == 115) || (ch == 83)) {
                    ; Ctrl+S writes beside the file it came from; add Shift and
                    ; the host is asked where to put it instead.
                    if input.shiftDown {
                        this.runCommand("file.saveAs" "")
                    } {
                        this.saveXlsxDefault()
                    }
                }
                if ((ch == 111) || (ch == 79)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.runCommand("file.open" "")
                }
                ; Ctrl+M makes a chart of the selection. Excel's own chart
                ; keys (F11, Alt+F1) are not keys this input layer carries, and
                ; the browser host keeps most of the rest.
                if ((ch == 109) || (ch == 77)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.openChartDialog(0)
                }
                if ((ch == 122) || (ch == 90)) {
                    this.undoEdit()
                }
                if ((ch == 121) || (ch == 89)) {
                    this.redoEdit()
                }
                ; Excel: Ctrl+Space selects the column, Shift+Space the row.
                if (ch == 32) {
                    if editing {
                        this.commitEdit()
                    }
                    if input.shiftDown {
                        sel.selectAll(model)
                    } {
                        this.selectColumn(sel.active.col)
                    }
                }
                ti = (ti + 1)
            }
        } {
            if (input.hasText()) {
                if editing {
                    this.insertAtCaret(input.textInput)
                } {
                    ; Shift+Space selects the whole row rather than typing one.
                    if (input.shiftDown && (input.textInput == " ")) {
                        this.selectRow(sel.active.row)
                    } {
                        this.beginEdit(input.textInput true)
                    }
                }
            }
        }

        def ki:int 0
        def kn:int (input.keyCount())
        while (ki < kn) {
            this.handleKey((input.keyAt(ki)) input)
            ki = (ki + 1)
        }
    }

    fn render:void () {
        ; Keep a toolbar tooltip / save note visible; only fall back to the
        ; version stamp when nothing more useful is showing.
        def tip:string (view.toolbar.hotLabel())
        if ((strlen tip) > 0) {
            view.status = tip
        } {
            if ((strlen view.status) == 0) {
                view.status = ("v" + (to_string model.version))
            }
            if ((charAt view.status 0) == 118) {
                ; "vN…" — refresh the stamp so it tracks the model.
                if ((strlen view.status) < 12) {
                    view.status = ("v" + (to_string model.version))
                }
            }
        }
        view.editCaret = editCaret
        view.editInFormulaBar = editInFormulaBar
        view.windows = windows
        this.refreshFormulaHilites()
        view.render(model sel grid editing editBuf book)
    }

    fn raw:buffer () {
        return (view.raw())
    }

    fn sceneJson:string () {
        def tip2:string (view.toolbar.hotLabel())
        if ((strlen tip2) > 0) {
            view.status = tip2
        } {
            if ((strlen view.status) == 0) {
                view.status = ("v" + (to_string model.version))
            }
        }
        view.editCaret = editCaret
        view.editInFormulaBar = editInFormulaBar
        view.windows = windows
        this.refreshFormulaHilites()
        return (view.sceneJson(model sel grid editing editBuf book))
    }

    fn activeLabel:string () {
        return (SpreadsheetModel.cellLabel(sel.active.row sel.active.col))
    }

    fn activeValue:string () {
        if editing {
            return editBuf
        }
        return (model.getCell(sel.active.row sel.active.col))
    }
}

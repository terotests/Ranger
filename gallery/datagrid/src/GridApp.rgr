; ==============================================================================
; GridApp - UIInput → WorkbookModel / DataGrid / selection / single EditView
; ==============================================================================
;
; Same contract as the text editor: platform fills UIInput; app never touches
; SDL/DOM. Loads .xlsx via XlsxLoader into WorkbookModel; DataGrid stays format-
; agnostic.
; ==============================================================================

Import "SpreadsheetModel.rgr"
Import "WorkbookModel.rgr"
Import "GridSelection.rgr"
Import "DataGrid.rgr"
Import "GridView.rgr"
Import "SheetView.rgr"
Import "FormulaEngine.rgr"
Import "xlsx/XlsxLoader.rgr"
Import "../../game_engine/ui/UIInput.rgr"

class GridApp {
    def book:WorkbookModel (new WorkbookModel)
    def model:SpreadsheetModel (new SpreadsheetModel)
    def sheetView:SheetView (new SheetView)
    def engine:FormulaEngine (new FormulaEngine)
    def sel:GridSelection (new GridSelection)
    def grid:DataGrid (new DataGrid)
    def view:GridView (new GridView)
    def W:int 900
    def H:int 560
    def statusH:int 22
    def editing:boolean false
    def editBuf:string ""
    def editCaret:int 0
    def dragging:boolean false
    def resizing:boolean false
    def resizingRows:boolean false
    def resizeCol0:int -1
    def resizeCol1:int -1
    def filling:boolean false
    def fillR0:int 0
    def fillC0:int 0
    def fillR1:int 0
    def fillC1:int 0
    def clipboardTsv:string ""
    def clipboardHtml:string ""
    def clipR0:int 0
    def clipC0:int 0
    def clipRows:int 0
    def clipCols:int 0
    def clipValues:[string]
    def clipFormulas:[string]
    def clipCut:boolean false
    def loadError:string ""

    Constructor () {
    }

    fn syncActiveModel:void () {
        ; persist scroll on previous sheet
        if ((book.sheetCount()) > 0) {
            ; model may already point at previous
        }
        model = (book.activeSheet())
        sheetView.attach(model)
        grid.bindView(sheetView)
        grid.scrollX = model.scrollXSaved
        grid.scrollY = model.scrollYSaved
        sel.anchor.row = 0
        sel.anchor.col = 0
        sel.active.row = 0
        sel.active.col = 0
        grid.updateVisible(model)
    }

    fn init:void (fontDir:string) {
        view.init(W H fontDir)
        grid.setBounds(0 0 W (H - statusH))
        this.loadDemo()
    }

    fn loadDemo:void () {
        book.clear()
        def sheet:SpreadsheetModel (new SpreadsheetModel)
        sheet.seedDemo()
        book.addSheet(sheet)
        book.sourcePath = ""
        book.setActive(0)
        engine.attach(book)
        engine.rebuildAll()
        this.syncActiveModel()
        loadError = ""
    }

    fn loadXlsx:boolean (fullPath:string) {
        def loader:XlsxLoader (new XlsxLoader)
        def ok:boolean (loader.loadPath(fullPath book))
        if ok {
            book.sourcePath = fullPath
            engine = loader.engine
            this.syncActiveModel()
            loadError = ""
            view.status = ("loaded " + fullPath)
            return true
        }
        loadError = loader.lastError
        view.status = loadError
        return false
    }

    fn setActiveSheet:void (i:int) {
        if editing {
            this.commitEdit()
        }
        ; save scroll for current sheet
        model.scrollXSaved = grid.scrollX
        model.scrollYSaved = grid.scrollY
        ; skip hidden sheets
        def n:int (book.sheetCount())
        if (i < 0) {
            i = 0
        }
        if (i >= n) {
            i = (n - 1)
        }
        def guard:int 0
        while (guard < n) {
            def cand:SpreadsheetModel (book.sheetAt(i))
            if (cand.sheetHidden == false) {
                break
            }
            i = (i + 1)
            if (i >= n) {
                i = 0
            }
            guard = (guard + 1)
        }
        book.setActive(i)
        this.syncActiveModel()
    }

    ; --- column sizing --------------------------------------------------------
    ; Auto-fit: widest painted cell in the column, plus the cell padding. The
    ; scan is capped so a 100k-row sheet stays instant — Excel samples too.
    fn autoFitColumn:void (col:int) {
        if (col < 0) {
            return
        }
        if (col >= model.colCount) {
            return
        }
        def best:int (view.measureText((SpreadsheetModel.colLabel(col))))
        def last:int (model.usedRow())
        if (last > 4999) {
            last = 4999
        }
        def r:int 0
        while (r <= last) {
            def txt:string (model.getDisplay(r col))
            if ((strlen txt) > 0) {
                def w:int (view.measureText(txt))
                if (w > best) {
                    best = w
                }
            }
            r = (r + 1)
        }
        def target:int (best + 16)
        if (target < 32) {
            target = 32
        }
        if (target > 600) {
            target = 600
        }
        this.setColumnWidths(col target)
    }

    ; Set a width on `col`, and on every other selected column when the one
    ; being sized is part of the selection — the way Excel resizes a block.
    fn setColumnWidths:void (col:int width:int) {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def lo:int col
        def hi:int col
        if ((col >= a.col) && (col <= b.col)) {
            if (a.col != b.col) {
                lo = a.col
                hi = b.col
            }
        }
        def c:int lo
        while (c <= hi) {
            model.setColWidth(c width)
            c = (c + 1)
        }
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    ; Double-click on a header edge (or anywhere in a header) auto-fits it.
    fn autoFitAt:boolean (px:int py:int) {
        def edgeCol:int (grid.hitColResize(model px py))
        if (edgeCol >= 0) {
            this.autoFitColumn(edgeCol)
            return true
        }
        def hit:CellPos (grid.hitTest(model px py))
        if ((hit.row == -2) && (hit.col >= 0)) {
            this.autoFitColumn(hit.col)
            return true
        }
        return false
    }

    fn nudgeColumnWidth:void (col:int delta:int) {
        if (col < 0) {
            return
        }
        def w:int ((model.colWidth(col)) + delta)
        if (w < 24) {
            w = 24
        }
        if (w > 600) {
            w = 600
        }
        this.setColumnWidths(col w)
    }

    fn applySort:void (col:int ascending:boolean) {
        model.setSort(col ascending)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    fn applyFilter:void (col:int values:[string]) {
        model.setFilter(col true values)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    fn clearFilter:void () {
        def empty:[string]
        model.setFilter(-1 false empty)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    fn collectUnique:void (col:int out:[string]) {
        clear out
        def r:int model.freezeRows
        while (r < model.rowCount) {
            def v:string (model.getCell(r col))
            def found:boolean false
            def i:int 0
            def n:int (array_length out)
            while (i < n) {
                if ((itemAt out i) == v) {
                    found = true
                }
                i = (i + 1)
            }
            if (found == false) {
                push out v
            }
            r = (r + 1)
        }
    }

    fn openHeaderMenu:void (col:int px:int py:int) {
        view.menuOpen = true
        view.menuCol = col
        view.menuX = px
        view.menuY = py
    }

    fn closeHeaderMenu:void () {
        view.menuOpen = false
        view.menuCol = -1
    }

    fn hitHeaderMenu:int (px:int py:int) {
        if (view.menuOpen == false) {
            return -1
        }
        if (px < view.menuX) {
            return -1
        }
        if (py < view.menuY) {
            return -1
        }
        if (px >= (view.menuX + view.menuW)) {
            return -1
        }
        if (py >= (view.menuY + view.menuH)) {
            return -1
        }
        def ly:int (py - view.menuY)
        if ((ly >= 26) && (ly < 46)) {
            return 1
        }
        if ((ly >= 46) && (ly < 66)) {
            return 2
        }
        if ((ly >= 66) && (ly < 86)) {
            return 3
        }
        if ((ly >= 86) && (ly < 106)) {
            return 4
        }
        if ((ly >= 106) && (ly < 126)) {
            return 5
        }
        if ((ly >= 126) && (ly < 146)) {
            return 6
        }
        if ((ly >= 146) && (ly < 170)) {
            return 7
        }
        return 0
    }

    fn runHeaderMenu:void (action:int) {
        def col:int view.menuCol
        if (action == 1) {
            this.applySort(col true)
        }
        if (action == 2) {
            this.applySort(col false)
        }
        if (action == 3) {
            def vals:[string]
            this.collectUnique(col vals)
            ; keep at most first value for a visible demo filter when many uniques
            if ((array_length vals) > 1) {
                def keep:[string]
                push keep (itemAt vals 0)
                this.applyFilter(col keep)
            } {
                this.applyFilter(col vals)
            }
        }
        if (action == 4) {
            this.clearFilter()
        }
        if (action == 5) {
            this.autoFitColumn(col)
        }
        if (action == 6) {
            this.nudgeColumnWidth(col 20)
        }
        if (action == 7) {
            this.nudgeColumnWidth(col -20)
        }
        this.closeHeaderMenu()
    }

    fn resize:void (nw:int nh:int) {
        W = nw
        H = nh
        view.resize(W H)
        grid.setBounds(0 0 W (H - statusH))
        grid.updateVisible(model)
    }

    ; The engine is bound once at load. Per-edit code must NEVER call
    ; engine.attach() — attach clears depsOf / usedBy, which would silently stop
    ; every existing formula from tracking its inputs after the first edit.
    ; Instead: applyEdit → engine.syncCell(...) per cell → one recalcDirty().

    ; Re-register the formulas of every cell an undo / redo restored, then
    ; recalculate once.
    fn syncTouched:void () {
        engine.resetStats()
        def i:int 0
        def n:int (array_length model.touched)
        while (i < n) {
            def p:CellPos (itemAt model.touched i)
            engine.syncCell(book.activeIndex p.row p.col)
            i = (i + 1)
        }
        engine.recalcDirty()
    }

    ; Ctrl+Z / Ctrl+Y: undo or redo one whole action (paste and fill count as
    ; one), re-register the restored formulas, then recalculate.
    fn undoEdit:void () {
        if editing {
            this.cancelEdit()
        }
        def u:CellPos (model.undo())
        this.syncTouched()
        this.moveActive(u.row u.col false)
    }

    fn redoEdit:void () {
        if editing {
            this.cancelEdit()
        }
        def r:CellPos (model.redo())
        this.syncTouched()
        this.moveActive(r.row r.col false)
    }

    fn commitEdit:void () {
        if (editing == false) {
            return
        }
        def r:int sel.active.row
        def c:int sel.active.col
        model.beginTx()
        if ((strlen editBuf) > 0) {
            if ((charAt editBuf 0) == 61) {
                def expr:string (substring editBuf 1 (strlen editBuf))
                model.applyEdit(r c "" expr)
            } {
                ; Plain value overwrites any prior formula.
                model.applyEdit(r c editBuf "")
            }
        } {
            model.applyEdit(r c "" "")
        }
        model.endTx()
        engine.resetStats()
        engine.syncCell(book.activeIndex r c)
        engine.recalcDirty()
        editing = false
        editBuf = ""
        editCaret = 0
    }

    fn cancelEdit:void () {
        editing = false
        editBuf = ""
        editCaret = 0
    }

    fn beginEdit:void (seed:string clearFirst:boolean) {
        if clearFirst {
            editBuf = seed
        } {
            if (editing == false) {
                editBuf = (model.formulaBarText(sel.active.row sel.active.col))
            }
            if ((strlen seed) > 0) {
                editBuf = (editBuf + seed)
            }
        }
        editing = true
        editCaret = (strlen editBuf)
    }

    ; --- in-cell edit buffer: caret-relative editing --------------------------
    fn clampCaret:void () {
        def n:int (strlen editBuf)
        if (editCaret < 0) {
            editCaret = 0
        }
        if (editCaret > n) {
            editCaret = n
        }
    }

    fn insertAtCaret:void (text:string) {
        this.clampCaret()
        def n:int (strlen editBuf)
        def head:string (substring editBuf 0 editCaret)
        def tail:string (substring editBuf editCaret n)
        editBuf = ((head + text) + tail)
        editCaret = (editCaret + (strlen text))
    }

    fn backspaceAtCaret:void () {
        this.clampCaret()
        if (editCaret <= 0) {
            return
        }
        def n:int (strlen editBuf)
        def head:string (substring editBuf 0 (editCaret - 1))
        def tail:string (substring editBuf editCaret n)
        editBuf = (head + tail)
        editCaret = (editCaret - 1)
    }

    fn deleteAtCaret:void () {
        this.clampCaret()
        def n:int (strlen editBuf)
        if (editCaret >= n) {
            return
        }
        def head:string (substring editBuf 0 editCaret)
        def tail:string (substring editBuf (editCaret + 1) n)
        editBuf = (head + tail)
    }

    fn moveCaret:void (delta:int) {
        editCaret = (editCaret + delta)
        this.clampCaret()
    }

    ; --- used range ----------------------------------------------------------
    ; Excel bounds Ctrl+End / End at the last cell that holds data, not at the
    ; declared sheet size. SpreadsheetModel tracks that corner as cells are
    ; written, so this stays O(1) even on the 100k-row fixture.
    fn lastUsedColInRow:int (row:int) {
        def c:int (model.usedCol())
        while (c >= 0) {
            if ((strlen (model.getCell(row c))) > 0) {
                return c
            }
            c = (c - 1)
        }
        return 0
    }

    ; Ctrl+Arrow: jump to the edge of the current data block.
    ;   in data, neighbour filled  → last filled cell of the run
    ;   in data, neighbour empty   → next filled cell, else the sheet edge
    ;   on a blank cell            → next filled cell, else the sheet edge
    fn edgeJump:CellPos (row:int col:int dr:int dc:int) {
        def maxR:int (model.rowCount - 1)
        def maxC:int (model.colCount - 1)
        def r:int row
        def c:int col
        def nr:int (r + dr)
        def nc:int (c + dc)
        if ((nr < 0) || (nr > maxR) || (nc < 0) || (nc > maxC)) {
            return (CellPos.create(r c))
        }
        def hereFilled:boolean ((strlen (model.getCell(r c))) > 0)
        def nextFilled:boolean ((strlen (model.getCell(nr nc))) > 0)
        def runMode:boolean false
        if (hereFilled && nextFilled) {
            runMode = true
        }
        def more:boolean true
        while more {
            def tr:int (r + dr)
            def tc:int (c + dc)
            if ((tr < 0) || (tr > maxR) || (tc < 0) || (tc > maxC)) {
                more = false
            } {
                def filled:boolean ((strlen (model.getCell(tr tc))) > 0)
                if runMode {
                    if filled {
                        r = tr
                        c = tc
                    } {
                        more = false
                    }
                } {
                    r = tr
                    c = tc
                    if filled {
                        more = false
                    }
                }
            }
        }
        return (CellPos.create(r c))
    }

    ; Band selection. The far end is the anchor so the active cell stays at the
    ; top / left of the band — otherwise the next arrow key would resume from
    ; the last row of the sheet.
    fn selectColumn:void (col:int) {
        sel.anchor.row = (model.rowCount - 1)
        sel.anchor.col = col
        sel.active.row = 0
        sel.active.col = col
        grid.ensureCellVisible(model 0 col)
    }

    fn selectRow:void (row:int) {
        sel.anchor.row = row
        sel.anchor.col = (model.colCount - 1)
        sel.active.row = row
        sel.active.col = 0
        grid.ensureCellVisible(model row 0)
    }

    ; Rows a PageUp / PageDown step covers: one viewport minus one row of
    ; overlap, so the cell you were reading stays on screen.
    fn pageRows:int () {
        def n:int ((grid.lastScrollRow - grid.firstScrollRow) + 1)
        if (n < 1) {
            n = 1
        }
        if (n > 1) {
            n = (n - 1)
        }
        return n
    }

    ; Excel's grid has no edge you can walk off: pressing Down on the last row
    ; gives you a new one. A loaded sheet is only as big as its used range, so
    ; grow it as the caret (or a paste) reaches the end. Bounded by Excel's own
    ; limits so a runaway cannot allocate without end.
    fn ensureExtent:void (row:int col:int) {
        def rows:int (row + 1)
        def cols:int (col + 1)
        if (rows > 1048576) {
            rows = 1048576
        }
        if (cols > 16384) {
            cols = 16384
        }
        if ((rows <= model.rowCount) && (cols <= model.colCount)) {
            return
        }
        model.growTo(rows cols)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    fn moveActive:void (row:int col:int extend:boolean) {
        if editing {
            this.commitEdit()
        }
        if (row >= 0) {
            if (col >= 0) {
                this.ensureExtent(row col)
            }
        }
        def p:CellPos (CellPos.create(row col))
        model.clampPos(p)
        sel.setActive(p.row p.col)
        if (extend == false) {
            sel.collapseToActive()
        }
        grid.ensureCellVisible(model p.row p.col)
    }

    fn handleKey:void (key:int input:UIInput) {
        def extend:boolean input.shiftDown
        if editing {
            if (key == (UIKey.enter())) {
                this.commitEdit()
                if extend {
                    this.moveActive((sel.active.row - 1) sel.active.col false)
                } {
                    this.moveActive((sel.active.row + 1) sel.active.col false)
                }
                return
            }
            if (key == (UIKey.tab())) {
                this.commitEdit()
                if extend {
                    this.moveActive(sel.active.row (sel.active.col - 1) false)
                } {
                    this.moveActive(sel.active.row (sel.active.col + 1) false)
                }
                return
            }
            if (key == (UIKey.escape())) {
                this.cancelEdit()
                return
            }
            if (key == (UIKey.backspace())) {
                this.backspaceAtCaret()
                return
            }
            if (key == (UIKey.del())) {
                this.deleteAtCaret()
                return
            }
            if (key == (UIKey.left())) {
                this.moveCaret(-1)
                return
            }
            if (key == (UIKey.right())) {
                this.moveCaret(1)
                return
            }
            if (key == (UIKey.home())) {
                editCaret = 0
                return
            }
            if (key == (UIKey.end())) {
                editCaret = (strlen editBuf)
                return
            }
            return
        }
        def ctrl:boolean input.ctrlDown
        if (key == (UIKey.left())) {
            this.arrowKey(0 -1 ctrl extend)
            return
        }
        if (key == (UIKey.right())) {
            this.arrowKey(0 1 ctrl extend)
            return
        }
        if (key == (UIKey.up())) {
            this.arrowKey(-1 0 ctrl extend)
            return
        }
        if (key == (UIKey.down())) {
            this.arrowKey(1 0 ctrl extend)
            return
        }
        if (key == (UIKey.pageUp())) {
            this.moveActive((sel.active.row - (this.pageRows())) sel.active.col extend)
            return
        }
        if (key == (UIKey.pageDown())) {
            this.moveActive((sel.active.row + (this.pageRows())) sel.active.col extend)
            return
        }
        ; Excel: Enter steps down (Shift+Enter up); F2 opens the cell for edit.
        if (key == (UIKey.enter())) {
            if extend {
                this.moveActive((sel.active.row - 1) sel.active.col false)
            } {
                this.moveActive((sel.active.row + 1) sel.active.col false)
            }
            return
        }
        if (key == (UIKey.f2())) {
            this.beginEdit("" false)
            return
        }
        if (key == (UIKey.tab())) {
            if extend {
                this.moveActive(sel.active.row (sel.active.col - 1) false)
            } {
                this.moveActive(sel.active.row (sel.active.col + 1) false)
            }
            return
        }
        if (key == (UIKey.del())) {
            this.clearSelection()
            return
        }
        if (key == (UIKey.backspace())) {
            this.beginEdit("" true)
            return
        }
        if (key == (UIKey.home())) {
            if ctrl {
                this.moveActive(0 0 extend)
            } {
                this.moveActive(sel.active.row 0 extend)
            }
            return
        }
        if (key == (UIKey.end())) {
            if ctrl {
                this.moveActive((model.usedRow()) (model.usedCol()) extend)
            } {
                this.moveActive(sel.active.row (this.lastUsedColInRow(sel.active.row)) extend)
            }
            return
        }
        if (key == (UIKey.escape())) {
            sel.collapseToActive()
            return
        }
    }

    ; Arrow navigation. Ctrl jumps to the edge of the data block, Shift extends
    ; the selection, Ctrl+Shift does both.
    fn arrowKey:void (dr:int dc:int ctrl:boolean extend:boolean) {
        if ctrl {
            def p:CellPos (this.edgeJump(sel.active.row sel.active.col dr dc))
            this.moveActive(p.row p.col extend)
            return
        }
        this.moveActive((sel.active.row + dr) (sel.active.col + dc) extend)
    }

    sfn htmlEscape:string (v:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen v)
        while (i < n) {
            def c:int (charAt v i)
            if (c == 38) {
                out = (out + "&amp;")
            } {
                if (c == 60) {
                    out = (out + "&lt;")
                } {
                    if (c == 62) {
                        out = (out + "&gt;")
                    } {
                        if (c == 34) {
                            out = (out + "&quot;")
                        } {
                            out = (out + (strfromcode c))
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; CellStyle colours already carry a leading "#" when they come from
    ; styles.xml; normalize either form to a CSS colour, or "" if unusable.
    sfn cssColor:string (v:string) {
        def s:string v
        if ((strlen s) == 0) {
            return ""
        }
        if ((charAt s 0) == 35) {
            s = (substring s 1 (strlen s))
        }
        if ((strlen s) != 6) {
            return ""
        }
        return ("#" + s)
    }

    ; One <td>, carrying the bits of cell style a word processor can honour.
    fn cellHtml:string (r:int c:int) {
        def st:CellStyle (model.getCellStyle(r c))
        def style:string ""
        if st.hasFill {
            def bg:string (GridApp.cssColor(st.fillRgb))
            if ((strlen bg) > 0) {
                style = (style + "background-color:" + bg + ";")
            }
        }
        def fg:string (GridApp.cssColor(st.textRgb))
        if ((strlen fg) > 0) {
            style = (style + "color:" + fg + ";")
        }
        if st.bold {
            style = (style + "font-weight:bold;")
        }
        if (st.align != "left") {
            style = (style + "text-align:" + st.align + ";")
        }
        def open:string "<td"
        if ((strlen style) > 0) {
            open = (open + " style=\"" + style + "\"")
        }
        open = (open + ">")
        def body:string (GridApp.htmlEscape((model.getCell(r c))))
        if ((strlen body) == 0) {
            body = "&nbsp;"
        }
        return ((open + body) + "</td>")
    }

    ; Excel-style clipboard. Three representations are kept:
    ;   * clipboardTsv     — flat text, what a host would put on the OS clipboard
    ;   * clipboardHtml    — an HTML <table>, the flavour Word/Excel paste as a
    ;     real table (Excel puts the same two flavours on the clipboard)
    ;   * clipValues/Formulas + clipR0/clipC0 — structured block, so paste can
    ;     translate relative refs the way Excel copy/paste does.
    fn copySelection:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        clipR0 = a.row
        clipC0 = a.col
        clipRows = ((b.row - a.row) + 1)
        clipCols = ((b.col - a.col) + 1)
        clipCut = false
        clear clipValues
        clear clipFormulas
        def out:string ""
        def html:string "<table border=\"1\" cellspacing=\"0\" cellpadding=\"4\">"
        def r:int a.row
        while (r <= b.row) {
            if (r > a.row) {
                out = (out + "\n")
            }
            html = (html + "<tr>")
            def c:int a.col
            while (c <= b.col) {
                if (c > a.col) {
                    out = (out + "\t")
                }
                def v:string (model.getCell(r c))
                out = (out + v)
                html = (html + (this.cellHtml(r c)))
                push clipValues v
                push clipFormulas (model.getFormula(r c))
                c = (c + 1)
            }
            html = (html + "</tr>")
            r = (r + 1)
        }
        clipboardTsv = out
        clipboardHtml = (html + "</table>")
    }

    ; Ctrl+X: copy, then clear the source range as one undoable action. A cut
    ; block pastes without ref translation (Excel moves formulas as written).
    ; Formulas elsewhere that pointed at the moved cells are not rewritten.
    fn cutSelection:void () {
        this.copySelection()
        this.clearSelection()
        clipCut = true
    }

    ; Host-supplied clipboard text (OS paste): drops the structured block so the
    ; TSV path is used and no stale formulas leak in.
    fn setClipboardText:void (text:string) {
        clipboardTsv = text
        clipboardHtml = ""
        clipCut = false
        clear clipValues
        clear clipFormulas
        clipRows = 0
        clipCols = 0
    }

    fn pasteClipboard:void () {
        if editing {
            this.commitEdit()
        }
        if ((array_length clipValues) > 0) {
            this.pasteBlock()
            return
        }
        this.pasteTsv()
    }

    ; Structured paste: a copied formula is re-based by the paste offset, so
    ; =A1+B1 copied one row down becomes =A2+B2 (absolute refs stay put).
    fn pasteBlock:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def startR:int a.row
        def startC:int a.col
        def dy:int (startR - clipR0)
        def dx:int (startC - clipC0)
        if clipCut {
            dy = 0
            dx = 0
        }
        this.ensureExtent(((startR + clipRows) - 1) ((startC + clipCols) - 1))
        def maxR:int startR
        def maxC:int startC
        model.beginTx()
        engine.resetStats()
        def idx:int 0
        def ri:int 0
        while (ri < clipRows) {
            def ci:int 0
            while (ci < clipCols) {
                def tr:int (startR + ri)
                def tc:int (startC + ci)
                if ((tr < model.rowCount) && (tc < model.colCount)) {
                    def f:string (itemAt clipFormulas idx)
                    def wrote:boolean false
                    if ((strlen f) > 0) {
                        def translated:string (FormulaParser.translateFormula(f dx dy))
                        if ((strlen translated) > 0) {
                            model.applyEdit(tr tc "" translated)
                            wrote = true
                        }
                    }
                    if (wrote == false) {
                        model.applyEdit(tr tc (itemAt clipValues idx) "")
                    }
                    engine.syncCell(book.activeIndex tr tc)
                    if (tr > maxR) {
                        maxR = tr
                    }
                    if (tc > maxC) {
                        maxC = tc
                    }
                }
                idx = (idx + 1)
                ci = (ci + 1)
            }
            ri = (ri + 1)
        }
        model.endTx()
        engine.recalcDirty()
        clipCut = false
        sel.anchor.row = startR
        sel.anchor.col = startC
        sel.active.row = maxR
        sel.active.col = maxC
        grid.ensureCellVisible(model sel.active.row sel.active.col)
    }

    ; Plain-text fallback (external clipboard): values only, no formulas.
    fn pasteTsv:void () {
        if ((strlen clipboardTsv) == 0) {
            return
        }
        def lines:[string] (strsplit clipboardTsv "\n")
        def startR:int sel.active.row
        def startC:int sel.active.col
        def maxR:int startR
        def maxC:int startC
        def firstCols:[string] (strsplit (itemAt lines 0) "\t")
        this.ensureExtent(((startR + (array_length lines)) - 1) ((startC + (array_length firstCols)) - 1))
        model.beginTx()
        engine.resetStats()
        def ri:int 0
        def nLines:int (array_length lines)
        while (ri < nLines) {
            def rowText:string (itemAt lines ri)
            def cols:[string] (strsplit rowText "\t")
            def ci:int 0
            def nCols:int (array_length cols)
            while (ci < nCols) {
                def tr:int (startR + ri)
                def tc:int (startC + ci)
                if ((tr < model.rowCount) && (tc < model.colCount)) {
                    model.applyEdit(tr tc (itemAt cols ci) "")
                    engine.syncCell(book.activeIndex tr tc)
                    if (tr > maxR) {
                        maxR = tr
                    }
                    if (tc > maxC) {
                        maxC = tc
                    }
                }
                ci = (ci + 1)
            }
            ri = (ri + 1)
        }
        model.endTx()
        engine.recalcDirty()
        sel.anchor.row = startR
        sel.anchor.col = startC
        sel.active.row = maxR
        sel.active.col = maxC
        grid.ensureCellVisible(model sel.active.row sel.active.col)
    }

    ; Delete: clear values AND formulas over a range, as one undoable action,
    ; then recalculate everything that depended on those cells.
    fn clearRange:void (r0:int c0:int r1:int c1:int) {
        model.beginTx()
        engine.resetStats()
        def r:int r0
        while (r <= r1) {
            def c:int c0
            while (c <= c1) {
                model.applyEdit(r c "" "")
                engine.syncCell(book.activeIndex r c)
                c = (c + 1)
            }
            r = (r + 1)
        }
        model.endTx()
        engine.recalcDirty()
    }

    fn clearSelection:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        this.clearRange(a.row a.col b.row b.col)
    }

    ; FortuneSheet fill handle: tile source rect; translate relative formula refs.
    fn fillFromSource:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def srcH:int ((fillR1 - fillR0) + 1)
        def srcW:int ((fillC1 - fillC0) + 1)
        if (srcH < 1) {
            return
        }
        if (srcW < 1) {
            return
        }
        model.beginTx()
        engine.resetStats()
        def r:int a.row
        while (r <= b.row) {
            def c:int a.col
            while (c <= b.col) {
                def inSrc:boolean false
                if ((r >= fillR0) && (r <= fillR1) && (c >= fillC0) && (c <= fillC1)) {
                    inSrc = true
                }
                if (inSrc == false) {
                    def dr:int (r - fillR0)
                    def dc:int (c - fillC0)
                    def sr:int (fillR0 + (dr - ((to_int (dr / srcH)) * srcH)))
                    def sc:int (fillC0 + (dc - ((to_int (dc / srcW)) * srcW)))
                    def srcF:string (model.getFormula(sr sc))
                    def wrote:boolean false
                    if ((strlen srcF) > 0) {
                        def dx:int (c - sc)
                        def dy:int (r - sr)
                        def translated:string (FormulaParser.translateFormula(srcF dx dy))
                        if ((strlen translated) > 0) {
                            model.applyEdit(r c "" translated)
                            wrote = true
                        }
                    }
                    if (wrote == false) {
                        model.applyEdit(r c (model.getCell(sr sc)) "")
                    }
                    engine.syncCell(book.activeIndex r c)
                }
                c = (c + 1)
            }
            r = (r + 1)
        }
        model.endTx()
        ; Recalc newly registered / dependent formulas once.
        engine.recalcDirty()
    }

    ; Pointer press that is neither a sheet tab nor a header resize: fill
    ; handle, header menu, formula bar, or cell selection.
    fn handlePress:void (input:UIInput) {
        def onFill:boolean false
        if (editing == false) {
            onFill = (grid.hitFillHandle(model sel input.pointerX input.pointerY))
        }
        if onFill {
            ; FortuneSheet fill-handle drag starts from current selection
            view.focused = true
            def a0:CellPos (new CellPos)
            def b0:CellPos (new CellPos)
            sel.normalized(a0 b0)
            fillR0 = a0.row
            fillC0 = a0.col
            fillR1 = b0.row
            fillC1 = b0.col
            filling = true
            dragging = false
        } {
            def hit:CellPos (grid.hitTest(model input.pointerX input.pointerY))
            def menuHit:int (this.hitHeaderMenu(input.pointerX input.pointerY))
            if (menuHit >= 0) {
                view.focused = true
                if (menuHit >= 1) {
                    this.runHeaderMenu(menuHit)
                }
            } {
                if ((hit.row == -2) && (hit.col >= 0)) {
                    ; Column header → sort/filter popup
                    view.focused = true
                    if editing {
                        this.commitEdit()
                    }
                    this.openHeaderMenu(hit.col input.pointerX (grid.y + grid.formulaBarH + grid.colHeaderH))
                } {
                    if view.menuOpen {
                        this.closeHeaderMenu()
                    }
                    if ((hit.row == -3) && (hit.col == -3)) {
                        view.focused = true
                        this.beginEdit("" false)
                    } {
                        if ((hit.row >= 0) && (hit.col >= 0)) {
                            view.focused = true
                            if editing {
                                if ((hit.row != sel.active.row) || (hit.col != sel.active.col)) {
                                    this.commitEdit()
                                }
                            }
                            this.moveActive(hit.row hit.col input.shiftDown)
                            dragging = true
                        }
                    }
                }
            }
        }
    }

    ; Pointer drag that is not a resize: fill-handle rubber band or range select.
    fn handleDrag:void (input:UIInput) {
        if filling {
            if (input.pointerPressed == false) {
                def hitF:CellPos (grid.hitTest(model input.pointerX input.pointerY))
                if ((hitF.row >= 0) && (hitF.col >= 0)) {
                    sel.anchor.row = fillR0
                    sel.anchor.col = fillC0
                    sel.active.row = hitF.row
                    sel.active.col = hitF.col
                    ; keep source corner as the other end of the range
                    def a1:CellPos (new CellPos)
                    def b1:CellPos (new CellPos)
                    sel.normalized(a1 b1)
                    if (a1.row > fillR0) {
                        a1.row = fillR0
                    }
                    if (a1.col > fillC0) {
                        a1.col = fillC0
                    }
                    if (b1.row < fillR1) {
                        b1.row = fillR1
                    }
                    if (b1.col < fillC1) {
                        b1.col = fillC1
                    }
                    sel.anchor.row = a1.row
                    sel.anchor.col = a1.col
                    sel.active.row = b1.row
                    sel.active.col = b1.col
                }
            }
        } {
            if dragging {
                if (input.pointerPressed == false) {
                    def hit2:CellPos (grid.hitTest(model input.pointerX input.pointerY))
                    if ((hit2.row >= 0) && (hit2.col >= 0)) {
                        this.moveActive(hit2.row hit2.col true)
                    }
                }
            }
        }
    }

    fn update:void (input:UIInput) {
        if input.pointerPressed {
            def tab:int (grid.hitSheetTab((book.sheetCount()) input.pointerX input.pointerY))
            if (tab >= 0) {
                this.setActiveSheet(tab)
                view.focused = true
            } {
                def resizeCol:int (grid.hitColResize(model input.pointerX input.pointerY))
                def resizeRow:int -1
                if (resizeCol < 0) {
                    resizeRow = (grid.hitRowResize(model input.pointerX input.pointerY))
                }
                if (resizeCol >= 0) {
                    if editing {
                        this.commitEdit()
                    }
                    resizing = true
                    grid.resizingCol = resizeCol
                    grid.resizeStartX = input.pointerX
                    grid.resizeStartW = (model.colWidth(resizeCol))
                    view.focused = true
                } {
                    if (resizeRow >= 0) {
                        if editing {
                            this.commitEdit()
                        }
                        resizingRows = true
                        grid.resizingRow = resizeRow
                        grid.resizeStartY = input.pointerY
                        grid.resizeStartH = (model.rowHeight(resizeRow))
                        view.focused = true
                    } {
                        this.handlePress(input)
                    }
                }
            }
        }

        if input.pointerDown {
            if resizing {
                def dx:int (input.pointerX - grid.resizeStartX)
                def w:int (grid.resizeStartW + dx)
                if (w < 24) {
                    w = 24
                }
                ; Dragging one edge of a multi-column selection sizes them all.
                this.setColumnWidths(grid.resizingCol w)
            } {
                if resizingRows {
                    def dy:int (input.pointerY - grid.resizeStartY)
                    model.setRowHeight(grid.resizingRow (grid.resizeStartH + dy))
                    sheetView.markDirty()
                    sheetView.rebuild()
                    grid.updateVisible(model)
                } {
                    this.handleDrag(input)
                }
            }
        }

        if input.pointerReleased {
            if filling {
                this.fillFromSource()
            }
            filling = false
            dragging = false
            resizing = false
            resizingRows = false
            grid.resizingCol = -1
            grid.resizingRow = -1
        }

        if (input.scrollDelta != 0) {
            grid.scrollByRows(model (0 - input.scrollDelta))
        }

        if input.ctrlDown {
            def t:string input.textInput
            def ti:int 0
            def tn:int (strlen t)
            while (ti < tn) {
                def ch:int (charAt t ti)
                if ((ch == 97) || (ch == 65)) {
                    if editing {
                        this.commitEdit()
                    }
                    sel.selectAll(model)
                    grid.ensureCellVisible(model sel.active.row sel.active.col)
                }
                if ((ch == 99) || (ch == 67)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.copySelection()
                }
                if ((ch == 120) || (ch == 88)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.cutSelection()
                }
                if ((ch == 118) || (ch == 86)) {
                    this.pasteClipboard()
                }
                if ((ch == 122) || (ch == 90)) {
                    this.undoEdit()
                }
                if ((ch == 121) || (ch == 89)) {
                    this.redoEdit()
                }
                ; Excel: Ctrl+Space selects the column, Shift+Space the row.
                if (ch == 32) {
                    if editing {
                        this.commitEdit()
                    }
                    if input.shiftDown {
                        sel.selectAll(model)
                    } {
                        this.selectColumn(sel.active.col)
                    }
                }
                ti = (ti + 1)
            }
        } {
            if (input.hasText()) {
                if editing {
                    this.insertAtCaret(input.textInput)
                } {
                    ; Shift+Space selects the whole row rather than typing one.
                    if (input.shiftDown && (input.textInput == " ")) {
                        this.selectRow(sel.active.row)
                    } {
                        this.beginEdit(input.textInput true)
                    }
                }
            }
        }

        def ki:int 0
        def kn:int (input.keyCount())
        while (ki < kn) {
            this.handleKey((input.keyAt(ki)) input)
            ki = (ki + 1)
        }
    }

    fn render:void () {
        view.status = ("v" + (to_string model.version))
        view.editCaret = editCaret
        view.render(model sel grid editing editBuf book)
    }

    fn raw:buffer () {
        return (view.raw())
    }

    fn sceneJson:string () {
        view.status = ("v" + (to_string model.version))
        view.editCaret = editCaret
        return (view.sceneJson(model sel grid editing editBuf book))
    }

    fn activeLabel:string () {
        return (SpreadsheetModel.cellLabel(sel.active.row sel.active.col))
    }

    fn activeValue:string () {
        if editing {
            return editBuf
        }
        return (model.getCell(sel.active.row sel.active.col))
    }
}

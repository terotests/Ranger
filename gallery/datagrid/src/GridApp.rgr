    ; A tool the host adds. It appears in the table, and on the status bar, and
    ; running it puts its id in the mailbox rather than doing anything here —
    ; the host is the only thing that knows what its own tool means.
    fn addCustomCommand:void (id:string label:string group:string) {
        this.buildCommands()
        if (commands.has(id)) {
            return
        }
        commands.addCustom(id label group)
    }

    ; Collect the pending custom invocation, if any, and clear it. Returns ""
    ; when nothing is waiting.
    fn takeCustomCommand:string () {
        def id:string pendingCustom
        pendingCustom = ""
        return id
    }

    fn takeCustomArg:string () {
        def a:string pendingCustomArg
        pendingCustomArg = ""
        return a
    }

    ; A1 → move there. Anything unparseable leaves the selection alone.
    fn gotoCell:boolean (ref:string) {
        def rows:[int]
        def cols:[int]
        XlsxWorksheet.parseCellRef(ref rows cols)
        if ((array_length rows) == 0) {
            return false
        }
        def r:int (itemAt rows 0)
        def c:int (itemAt cols 0)
        if (r < 0) {
            return false
        }
        if (c < 0) {
            return false
        }
        this.ensureExtent(r c)
        this.moveActive(r c false)
        return true
    }

    ; --- colour theme ---------------------------------------------------------
    ; "default" / "green" / "blue" / "red" — see GridTheme.rgr for what a theme
    ; is allowed to touch (the chrome; never the workbook's own formatting).
    ; Returns false for a name this build does not have, leaving the current
    ; theme alone.
    fn setTheme:boolean (name:string) {
        def ok:boolean (view.theme.apply(name))
        if (ok == false) {
            view.status = ("no such theme: " + name)
            return false
        }
        view.status = ("theme: " + view.theme.name)
        return true
    }

    fn themeName:string () {
        return view.theme.name
    }

    ; Every theme this build knows, space separated — a host's menu, without
    ; the list having to be written down twice.
    fn themeNames:string () {
        return (GridTheme.themeNames())
    }

    ; Run one command by name. Returns false for a name the table does not
    ; have, so a host can tell a typo from a no-op.
    fn runCommand:boolean (id:string arg:string) {
        this.buildCommands()
        def cmd:GridCommand (commands.find(id))
        if ((strlen cmd.id) == 0) {
            return false
        }
        if cmd.custom {
            pendingCustom = id
            pendingCustomArg = arg
            view.status = ("tool: " + cmd.label)
            return true
        }
        if editing {
            this.commitEdit()
        }
        if (id == "file.new") {
            this.newBlankWorkbook()
            return true
        }
        if (id == "file.open") {
            fileRequest = "open"
            view.status = "open a workbook…"
            return true
        }
        if (id == "file.saveAs") {
            fileRequest = "saveAs"
            view.status = "save a copy as…"
            return true
        }
        if (id == "file.save") {
            return (this.saveXlsxDefault())
        }
        if (id == "edit.undo") {
            this.undoEdit()
            return true
        }
        if (id == "edit.redo") {
            this.redoEdit()
            return true
        }
        ; Everything the toolbar's formatting buttons do. One place, so the
        ; keyboard, the buttons and a host over a socket cannot drift.
        if ((strlen id) > 7) {
            if ((substring id 0 7) == "format.") {
                def handled:boolean (this.runFormatCommand(id arg))
                if handled {
                    return true
                }
            }
        }
        if (id == "view.theme") {
            return (this.setTheme(arg))
        }
        if (id == "view.theme.next") {
            def picked:string (view.theme.cycle())
            view.status = ("theme: " + picked)
            return true
        }
        if (id == "view.freeze.here") {
            model.freezeRows = sel.active.row
            model.freezeCols = sel.active.col
            model.version = (model.version + 1)
            grid.updateVisible(model)
            return true
        }
        if (id == "view.freeze.none") {
            model.freezeRows = 0
            model.freezeCols = 0
            model.version = (model.version + 1)
            grid.updateVisible(model)
            return true
        }
        if (id == "edit.copy") {
            this.copySelection()
            return true
        }
        if (id == "chart.copy") {
            def which:int (this.focusedChartId())
            if (which == 0) {
                if ((view.chartLayer.count()) == 1) {
                    def only:ChartPanel (view.chartLayer.panelAt(0))
                    which = only.chart.id
                }
            }
            if (which == 0) {
                clipboardNote = "no chart to copy"
                return false
            }
            return ((this.copyChart(which)) > 0)
        }
        if (id == "edit.cut") {
            this.cutSelection()
            return true
        }
        if (id == "edit.paste") {
            this.pasteClipboard()
            return true
        }
        if (id == "edit.pasteSpecial") {
            this.openPasteSpecial()
            return true
        }
        if (id == "edit.clear") {
            this.clearSelection()
            return true
        }
        if (id == "edit.formatPainter") {
            this.copyFormat()
            return true
        }
        if (id == "edit.find") {
            this.openFindDialog()
            return true
        }
        if (id == "insert.row.above") {
            this.insertRowAboveSelection()
            return true
        }
        if (id == "insert.row.below") {
            this.insertRowBelowSelection()
            return true
        }
        if (id == "insert.column.left") {
            this.insertColumnLeftOfSelection()
            return true
        }
        if (id == "insert.column.right") {
            this.insertColumnRightOfSelection()
            return true
        }
        if (id == "insert.chart") {
            this.openChartDialog(0)
            return true
        }
        if (id == "insert.link") {
            this.openLinkDialog()
            return true
        }
        if (id == "delete.rows") {
            this.deleteSelectedRows()
            return true
        }
        if (id == "delete.columns") {
            this.deleteSelectedColumns()
            return true
        }
        if (id == "move.row.up") {
            this.moveSelectedRow(-1)
            return true
        }
        if (id == "move.row.down") {
            this.moveSelectedRow(1)
            return true
        }
        if (id == "move.column.left") {
            this.moveSelectedColumn(-1)
            return true
        }
        if (id == "move.column.right") {
            this.moveSelectedColumn(1)
            return true
        }
        if (id == "format.autofit.column") {
            this.autoFitColumn(sel.active.col)
            return true
        }
        if (id == "format.autofit.row") {
            this.autoFitRow(sel.active.row)
            return true
        }
        if (id == "format.conditional") {
            cfStatus = ""
            this.openCfDialog()
            return true
        }
        if (id == "data.sort.asc") {
            this.applySort(sel.active.col true)
            return true
        }
        if (id == "data.sort.desc") {
            this.applySort(sel.active.col false)
            return true
        }
        if (id == "data.filter.clear") {
            this.clearFilter()
            return true
        }
        if (id == "data.validation") {
            dvStatus = ""
            this.openValidationDialog()
            return true
        }
        if (id == "select.all") {
            sel.selectAll(model)
            return true
        }
        if (id == "select.column") {
            this.selectColumn(sel.active.col)
            return true
        }
        if (id == "select.row") {
            this.selectRow(sel.active.row)
            return true
        }
        ; --- the sheet tabs ---------------------------------------------------
        if (id == "sheet.add") {
            return (this.addSheet())
        }
        if (id == "sheet.rename") {
            ; No argument opens the window on the sheet you are on; an
            ; argument renames it outright, which is what a host wants.
            if ((strlen arg) == 0) {
                this.openRenameDialog(book.activeIndex)
                return true
            }
            return (this.renameSheetTo(book.activeIndex arg))
        }
        if (id == "sheet.move") {
            def want@(optional):int (to_int arg)
            if (!null? want) {
                return (this.moveSheetTo(book.activeIndex (unwrap want)))
            }
            return false
        }
        if (id == "nav.goto") {
            return (this.gotoCell(arg))
        }
        if ((strlen id) > 7) {
            if ((substring id 0 7) == "script.") {
                return (this.runScriptCommand(id arg))
            }
        }
        if ((strlen id) > 3) {
            if ((substring id 0 3) == "db.") {
                return (this.runDbCommand(id arg))
            }
        }
        if (id == "view.sheet.next") {
            this.setActiveSheet((book.activeIndex + 1))
            return true
        }
        if (id == "view.sheet.prev") {
            this.setActiveSheet((book.activeIndex - 1))
            return true
        }
        return false
    }

    ; --- reports ---------------------------------------------------------------
    ; A script that lives in this workbook, run over this workbook, drawn on
    ; this canvas, exported as this PDF. GridScriptEngine does the work; what
    ; is here is which script, and where the bytes go.
    fn runScriptCommand:boolean (id:string arg:string) {
        if (id == "script.run") {
            return (this.runScriptAt(scriptIndex))
        }
        if (id == "script.open") {
            def at:int (book.scriptIndexOf(arg))
            if (at < 0) {
                view.status = ("no script named '" + arg + "' in this workbook")
                return true
            }
            return (this.runScriptAt(at))
        }
        if (id == "script.next") {
            def n:int (book.scriptCount())
            if (n == 0) {
                view.status = "this workbook carries no scripts"
                return true
            }
            def next:int (scriptIndex + 1)
            if (next >= n) {
                next = 0
            }
            return (this.runScriptAt(next))
        }
        if (id == "script.new") {
            return (this.newScript(arg))
        }
        if (id == "script.close") {
            view.preview.close()
            view.status = "report closed"
            return true
        }
        if (id == "script.page.next") {
            view.preview.nextPage()
            view.status = (view.preview.headline())
            return true
        }
        if (id == "script.page.prev") {
            view.preview.prevPage()
            view.status = (view.preview.headline())
            return true
        }
        if (id == "script.zoom.in") {
            view.preview.zoomBy(1.25)
            return true
        }
        if (id == "script.zoom.out") {
            view.preview.zoomBy(0.8)
            return true
        }
        if (id == "script.zoom.fit") {
            view.preview.zoomFit()
            return true
        }
        if (id == "script.export.pdf") {
            return (this.exportScriptPdf())
        }
        return false
    }

    ; Everything a database sheet can be asked to do. Off a database sheet
    ; they all say the same thing rather than half-working on an .xlsx one.
    fn runDbCommand:boolean (id:string arg:string) {
        ; The SQL box is about the CONNECTION, not about the sheet in front of
        ; the user, so it works from anywhere in the workbook.
        if (id == "db.connection") {
            this.openConnectionDialog()
            return true
        }
        if (id == "db.sql.dialog") {
            this.openSqlDialog()
            return true
        }
        if (id == "db.sql") {
            this.runSqlQuery(arg)
            return true
        }
        if (id == "db.sql.new") {
            this.runSqlAsNewSheet(arg)
            return true
        }
        if ((this.dbSheetActive()) == false) {
            view.status = "this sheet does not come from a database"
            return true
        }
        if (id == "db.refresh") {
            this.refreshDatabaseSheet()
            return true
        }
        if (id == "db.commit") {
            db.commitPending()
            this.refreshDatabaseSheet()
            return true
        }
        if (id == "db.discard") {
            db.discardPending()
            this.refreshDatabaseSheet()
            return true
        }
        if (id == "db.row.delete") {
            db.deleteSheetRow(model sel.active.row)
            this.afterDbReload()
            return true
        }
        if (id == "db.filter") {
            db.filterByColumn(model sel.active.col arg)
            this.afterDbReload()
            return true
        }
        if (id == "db.page.next") {
            db.nextPage(model)
            this.afterDbReload()
            return true
        }
        if (id == "db.page.prev") {
            db.previousPage(model)
            this.afterDbReload()
            return true
        }
        return false
    }

    ; Relative imports inside a script resolve against the workbook's own
    ; folder, so a report can `import { Header } from "./components/Header"`
    ; and mean the folder the .xlsx is in.
    fn scriptBaseDir:string () {
        def src:string book.sourcePath
        if ((strlen src) == 0) {
            return "./"
        }
        def dir:string (GridApp.exportDir(src))
        if ((strlen dir) == 0) {
            return "./"
        }
        return (dir + "/")
    }

    fn currentScript:GridScript () {
        def n:int (book.scriptCount())
        if (n == 0) {
            def none:GridScript (new GridScript)
            return none
        }
        def at:int scriptIndex
        if (at < 0) {
            at = 0
        }
        if (at >= n) {
            at = (n - 1)
        }
        return (book.scriptAt(at))
    }

    fn runScriptAt:boolean (i:int) {
        def n:int (book.scriptCount())
        if (n == 0) {
            view.status = "this workbook carries no scripts — run 'New report script' first"
            return true
        }
        if editing {
            this.commitEdit()
        }
        def at:int i
        if (at < 0) {
            at = 0
        }
        if (at >= n) {
            at = (n - 1)
        }
        scriptIndex = at
        def sc:GridScript (book.scriptAt(at))
        scriptEngine.basePath = (this.scriptBaseDir())
        def result:GridScriptResult (scriptEngine.run(sc book))
        view.preview.show(sc.name result)
        if (result.ok == false) {
            view.status = result.error
            return true
        }
        view.status = (view.preview.headline())
        return true
    }

    ; A starter report for the sheet in front of the user, added to the
    ; workbook so it is saved with it. Running it immediately is the point:
    ; the first thing a new script does is show what it prints.
    fn newScript:boolean (name:string) {
        def nm:string name
        if ((strlen nm) == 0) {
            nm = "report"
        }
        def sheet:string (book.activeName())
        def sc:GridScript (GridScript.create(nm (GridScript.starter(sheet))))
        book.addScript(sc)
        def at:int (book.scriptIndexOf(nm))
        view.status = ("added script '" + nm + "' to the workbook")
        return (this.runScriptAt(at))
    }

    fn pdfFileName:string (scriptName:string) {
        def src:string book.sourcePath
        def base:string (GridApp.baseName(src))
        if ((strlen base) == 0) {
            return (scriptName + ".pdf")
        }
        def dot:int -1
        def i:int 0
        while (i < (strlen base)) {
            if ((charAt base i) == 46) {
                dot = i
            }
            i = (i + 1)
        }
        if (dot > 0) {
            base = (substring base 0 dot)
        }
        return ((base + "-" + scriptName) + ".pdf")
    }

    ; Re-run and render. The export never prints the preview's cached pages:
    ; the sheet may have changed since, and a report that quietly exports last
    ; minute's numbers is worse than one that takes a moment.
    fn exportScriptPdf:boolean () {
        def n:int (book.scriptCount())
        if (n == 0) {
            view.status = "no script to export"
            return true
        }
        def sc:GridScript (this.currentScript())
        scriptEngine.basePath = (this.scriptBaseDir())
        def result:GridScriptResult (scriptEngine.run(sc book))
        view.preview.show(sc.name result)
        if (result.ok == false) {
            view.status = result.error
            return true
        }
        def bytes:buffer (scriptEngine.toPdf(result))
        def size:int (buffer_length bytes)
        if (size == 0) {
            view.status = ("PDF export failed: " + scriptEngine.lastError)
            return true
        }
        pdfBytes = bytes
        pdfName = (this.pdfFileName(sc.name))
        if hostWritesFiles {
            fileRequest = "exportPdf"
            view.status = ("report ready: " + pdfName)
            return true
        }
        def dir:string (GridApp.exportDir(book.sourcePath))
        buffer_write_file dir pdfName bytes
        view.status = ((("wrote " + dir) + "/") + pdfName)
        return true
    }

    ; The bytes a browser host downloads, and what to call the file.
    fn scriptPdfBytes:buffer () {
        return pdfBytes
    }

    fn suggestPdfName:string () {
        if ((strlen pdfName) == 0) {
            return "report.pdf"
        }
        return pdfName
    }

    ; --- the preview owns the keyboard ----------------------------------------
    ; While a report is up, the sheet is behind it: arrow keys must not scroll
    ; something the user cannot see. Clicks outside the preview panel still
    ; reach the toolbar and the sheet tabs, so Save and Open keep working.
    fn updateScriptPreview:boolean (input:UIInput) {
        def consumed:boolean false
        def ki:int 0
        def kn:int (input.keyCount())
        while (ki < kn) {
            def k:int (input.keyAt(ki))
            this.previewKey(k)
            consumed = true
            ki = (ki + 1)
        }
        if (input.hasText()) {
            this.previewText(input.textInput input.ctrlDown)
            consumed = true
        }
        if (input.scrollDelta != 0) {
            if input.ctrlDown {
                if (input.scrollDelta > 0) {
                    view.preview.zoomBy(1.1)
                } {
                    view.preview.zoomBy(0.9)
                }
            } {
                if (input.scrollDelta > 0) {
                    view.preview.prevPage()
                } {
                    view.preview.nextPage()
                }
            }
            view.status = (view.preview.headline())
            consumed = true
        }
        if input.pointerPressed {
            if (this.pointerInPreview(input.pointerX input.pointerY)) {
                return true
            }
            return false
        }
        return consumed
    }

    fn pointerInPreview:boolean (px:int py:int) {
        def top:int (grid.headerTop())
        def bottom:int (grid.y + grid.h)
        if (py < top) {
            return false
        }
        if (py > bottom) {
            return false
        }
        if (px < grid.x) {
            return false
        }
        def right:int (grid.x + grid.w)
        if (px > right) {
            return false
        }
        return true
    }

    fn previewKey:void (key:int) {
        if (key == (UIKey.escape())) {
            view.preview.close()
            view.status = "report closed"
            return
        }
        if (key == (UIKey.pageDown())) {
            view.preview.nextPage()
            view.status = (view.preview.headline())
            return
        }
        if (key == (UIKey.pageUp())) {
            view.preview.prevPage()
            view.status = (view.preview.headline())
            return
        }
        if (key == (UIKey.right())) {
            view.preview.nextPage()
            view.status = (view.preview.headline())
            return
        }
        if (key == (UIKey.left())) {
            view.preview.prevPage()
            view.status = (view.preview.headline())
            return
        }
        if (key == (UIKey.home())) {
            view.preview.setPage(0)
            view.status = (view.preview.headline())
            return
        }
        if (key == (UIKey.end())) {
            def last:int ((view.preview.pageCount()) - 1)
            view.preview.setPage(last)
            view.status = (view.preview.headline())
            return
        }
    }

    fn previewText:void (text:string ctrl:boolean) {
        def i:int 0
        def n:int (strlen text)
        while (i < n) {
            def ch:int (charAt text i)
            if ctrl {
                ; Ctrl+P prints, Ctrl+R re-runs — the two things a preview is
                ; for, on the keys every other application uses for them.
                if ((ch == 112) || (ch == 80)) {
                    this.exportScriptPdf()
                }
                if ((ch == 114) || (ch == 82)) {
                    this.runScriptAt(scriptIndex)
                }
            } {
                if ((ch == 43) || (ch == 61)) {
                    view.preview.zoomBy(1.25)
                }
                if (ch == 45) {
                    view.preview.zoomBy(0.8)
                }
                if (ch == 48) {
                    view.preview.zoomFit()
                }
                if ((ch == 110) || (ch == 78)) {
                    view.preview.nextPage()
                    view.status = (view.preview.headline())
                }
            }
            i = (i + 1)
        }
    }

    ; --- saving ---------------------------------------------------------------
    ; The workbook, written back out as .xlsx. The loader and the writer share
    ; the model, so what comes back is what was there — see XlsxWriteTest, and
    ; tools/check_export.py for the same file read by openpyxl.
    fn saveXlsx:boolean (dir:string name:string) {
        if editing {
            this.commitEdit()
        }
        def w:XlsxWriter (new XlsxWriter)
        def ok:boolean (w.write(book dir name))
        if ok {
            savedPath = (dir + "/" + name)
            ; Next Save should overwrite this file, not invent a -export copy.
            book.sourcePath = savedPath
            view.status = ("saved " + savedPath)
        } {
            savedPath = ""
            view.status = ("save failed: " + w.lastError)
        }
        return ok
    }

    ; The .xlsx as bytes — what a browser download needs when there is no disk.
    fn saveXlsxBytes:buffer () {
        if editing {
            this.commitEdit()
        }
        def w:XlsxWriter (new XlsxWriter)
        def data:buffer (w.writeToBuffer(book))
        if ((strlen w.lastError) > 0) {
            view.status = ("save failed: " + w.lastError)
        }
        return data
    }

    ; A sensible download / Save As filename for the current workbook.
    fn suggestSaveName:string () {
        def n:string (GridApp.baseName(book.sourcePath))
        if ((strlen n) == 0) {
            return "workbook.xlsx"
        }
        return n
    }

    ; Where Ctrl+S puts it when nobody said: beside the file it came from, with
    ; a name that cannot overwrite it.
    sfn exportDir:string (source:string) {
        def cut:int -1
        def i:int 0
        while (i < (strlen source)) {
            if ((charAt source i) == 47) {
                cut = i
            }
            i = (i + 1)
        }
        if (cut < 0) {
            return "."
        }
        return (substring source 0 cut)
    }

    ; The file part of a path, as written. `exportName` below is a different
    ; question — what to call a copy — and answering both with one function is
    ; how a "save as" ends up writing `sheet-export.xlsx` when the person
    ; typed `sheet.xlsx`.
    sfn baseName:string (source:string) {
        def cut:int -1
        def i:int 0
        while (i < (strlen source)) {
            if ((charAt source i) == 47) {
                cut = i
            }
            i = (i + 1)
        }
        def file:string source
        if (cut >= 0) {
            file = (substring source (cut + 1) (strlen source))
        }
        if ((strlen file) == 0) {
            return "workbook.xlsx"
        }
        return file
    }

    sfn exportName:string (source:string) {
        def cut:int -1
        def i:int 0
        while (i < (strlen source)) {
            if ((charAt source i) == 47) {
                cut = i
            }
            i = (i + 1)
        }
        def file:string source
        if (cut >= 0) {
            file = (substring source (cut + 1) (strlen source))
        }
        if ((strlen file) == 0) {
            return "workbook-export.xlsx"
        }
        def dot:int -1
        def k:int 0
        while (k < (strlen file)) {
            if ((charAt file k) == 46) {
                dot = k
            }
            k = (k + 1)
        }
        if (dot > 0) {
            file = (substring file 0 dot)
        }
        return (file + "-export.xlsx")
    }

    ; Ctrl+S / toolbar Save: overwrite the file we opened. If there is none yet,
    ; ask the host for a path (Save As). Headless `--save` uses
    ; `saveXlsxDefaultSilent` so it never blocks on a dialog.
    fn saveXlsxDefault:boolean () {
        def src:string book.sourcePath
        if ((strlen src) == 0) {
            fileRequest = "saveAs"
            view.status = "save a workbook as…"
            return true
        }
        return (this.saveXlsx((GridApp.exportDir(src)) (GridApp.baseName(src))))
    }

    ; Write without prompting — used by CLI `--save` and tests.
    fn saveXlsxDefaultSilent:boolean () {
        def src:string book.sourcePath
        if ((strlen src) == 0) {
            return (this.saveXlsx("." "workbook-export.xlsx"))
        }
        return (this.saveXlsx((GridApp.exportDir(src)) (GridApp.baseName(src))))
    }

    fn setActiveSheet:void (i:int) {
        if editing {
            this.commitEdit()
        }
        ; save scroll for current sheet
        model.scrollXSaved = grid.scrollX
        model.scrollYSaved = grid.scrollY
        ; skip hidden sheets
        def n:int (book.sheetCount())
        if (i < 0) {
            i = 0
        }
        if (i >= n) {
            i = (n - 1)
        }
        def guard:int 0
        while (guard < n) {
            def cand:SpreadsheetModel (book.sheetAt(i))
            if (cand.sheetHidden == false) {
                break
            }
            i = (i + 1)
            if (i >= n) {
                i = 0
            }
            guard = (guard + 1)
        }
        book.setActive(i)
        this.syncActiveModel()
        ; The SQL box follows the sheet. Each sheet remembers the query that
        ; made it, so coming back to one puts that query in the box rather
        ; than whatever was typed last against a sheet it has nothing to do
        ; with - and Update then re-runs the query you are looking at.
        def now:SpreadsheetModel (book.activeSheet())
        if ((strlen now.dbSql) > 0) {
            dbSqlText = now.dbSql
            dbSqlStatus = ""
        }
        view.chartLayer.showSheet(book.activeIndex)
    }


    ; --- the sheet tabs -------------------------------------------------------
    ; The strip could switch sheets and nothing else: a workbook that arrived
    ; with three sheets stayed a workbook with three sheets, in that order,
    ; under those names, forever. The three things a tab strip is for are here
    ; now — a `+` after the last tab, a double click to rename, and a drag to
    ; reorder — and all three go through the command table, so the keyboard and
    ; a host reach them the same way the mouse does.
    ;
    ; Two consequences a caller must not have to remember, and does not:
    ;
    ;   * A rename moves every formula in the workbook that names the sheet.
    ;     `Costs!B4` is TEXT, so renaming the sheet and leaving the formulas
    ;     alone turns each of them into `#NAME?`.
    ;   * Adding or moving a sheet renumbers every index anyone was holding.
    ;     A chart remembers which sheet it belongs to as a NUMBER, and a number
    ;     that is not remapped does not become invalid — it quietly starts
    ;     naming a different sheet, which is worse.
    fn addSheet:boolean () {
        if editing {
            this.commitEdit()
        }
        def fresh:SpreadsheetModel (new SpreadsheetModel)
        fresh.clearSheet()
        fresh.resize(200 26)
        fresh.name = (book.nextSheetName())
        def at:int (book.activeIndex + 1)
        book.insertSheet(at fresh)
        this.remapChartSheets(at 1)
        this.setActiveSheet(at)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
        view.status = ("added " + fresh.name)
        return true
    }

    ; Every chart's sheet number, after `count` sheets were inserted at `at`.
    fn remapChartSheets:void (at:int count:int) {
        def i:int 0
        while (i < (view.chartLayer.count())) {
            def p:ChartPanel (view.chartLayer.panelAt(i))
            if (p.chart.sheet >= at) {
                p.chart.sheet = (p.chart.sheet + count)
            }
            i = (i + 1)
        }
    }

    ; And after a move, which is a permutation rather than a shift.
    fn remapChartMove:void (from:int to:int) {
        def i:int 0
        while (i < (view.chartLayer.count())) {
            def p:ChartPanel (view.chartLayer.panelAt(i))
            p.chart.sheet = (WorkbookModel.remapIndex(p.chart.sheet from to))
            i = (i + 1)
        }
    }

    fn moveSheetTo:boolean (from:int to:int) {
        if ((from < 0) || (from >= (book.sheetCount()))) {
            return false
        }
        def dest:int to
        if (dest < 0) {
            dest = 0
        }
        if (dest >= (book.sheetCount())) {
            dest = ((book.sheetCount()) - 1)
        }
        if (dest == from) {
            return false
        }
        def moved:SpreadsheetModel (book.sheetAt(from))
        def nm:string moved.name
        book.moveSheet(from dest)
        this.remapChartMove(from dest)
        this.syncActiveModel()
        view.chartLayer.showSheet(book.activeIndex)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
        view.status = ("moved " + nm)
        return true
    }

    ; Rename the sheet at `at`, and every formula that named it.
    fn renameSheetTo:boolean (at:int name:string) {
        if ((at < 0) || (at >= (book.sheetCount()))) {
            return false
        }
        if ((book.nameIsValid(at name)) == false) {
            return false
        }
        def sheet:SpreadsheetModel (book.sheetAt(at))
        def was:string sheet.name
        if (was == name) {
            return true
        }
        sheet.name = name
        this.rewriteSheetName(was name)
        this.syncActiveModel()
        engine.rebuildAll()
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
        view.status = (("renamed " + was) + " to " + name)
        return true
    }

    ; Every formula in the workbook, through the parser: the ones that name
    ; the old sheet come back rewritten and the rest come back "", which is
    ; also what an unparseable one gives — either way that cell is left alone.
    fn rewriteSheetName:void (was:string now:string) {
        def si:int 0
        def sn:int (book.sheetCount())
        while (si < sn) {
            def sheet:SpreadsheetModel (book.sheetAt(si))
            def keys:[string]
            def texts:[string]
            sheet.snapshotFormulas(keys texts)
            def i:int 0
            while (i < (array_length keys)) {
                def key:string (itemAt keys i)
                def expr:string (itemAt texts i)
                def rewritten:string (FormulaParser.renameSheet(expr was now))
                if ((strlen rewritten) > 0) {
                    if (rewritten != expr) {
                        set sheet.formulas key rewritten
                    }
                }
                i = (i + 1)
            }
            si = (si + 1)
        }
        model.version = (model.version + 1)
    }

    ; --- the rename window ----------------------------------------------------
    ; Ids: 1201 the name, 1291 Cancel, 1292 Rename.
    fn openRenameDialog:void (at:int) {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        if ((at < 0) || (at >= (book.sheetCount()))) {
            return
        }
        renameIndex = at
        def sh:SpreadsheetModel (book.sheetAt(at))
        renameDialog.reset()
        renameDialog.labelW = 60
        renameDialog.addLabel("Rename the sheet")
        renameDialog.addInput(1201 "Name" sh.name)
        if ((strlen renameStatus) > 0) {
            renameDialog.addLabel(renameStatus)
        }
        def ids:[int]
        def labels:[string]
        push ids 1291
        push labels "Cancel"
        push ids 1292
        push labels "Rename"
        renameDialog.addButtonRow(ids labels 1292)
        renameDialog.finish()
        renameDialog.openWithin((grid.x + (idiv (W - renameDialog.w) 2)) (grid.y + 70) W H)
        windows.raise(renameDialog)
        renameDialog.focusedId = 1201
        view.focused = true
    }

    fn applyRenameDialog:void () {
        def want:string (renameDialog.inputValue(1201))
        if (this.renameSheetTo(renameIndex want)) {
            renameStatus = ""
            renameDialog.close()
            return
        }
        ; Say WHICH rule it broke. "Invalid" on its own is a puzzle, and the
        ; rules are not guessable — 31 characters and six punctuation marks.
        renameStatus = (GridApp.renameProblem(book renameIndex want))
        def keepX:int renameDialog.x
        def keepY:int renameDialog.y
        this.openRenameDialog(renameIndex)
        renameDialog.x = keepX
        renameDialog.y = keepY
    }

    sfn renameProblem:string (book:WorkbookModel at:int name:string) {
        def n:int (strlen name)
        if (n == 0) {
            return "A sheet needs a name."
        }
        if (n > 31) {
            return "At most 31 characters."
        }
        def i:int 0
        while (i < n) {
            def ch:int (charAt name i)
            if ((ch == 58) || (ch == 92) || (ch == 47) || (ch == 63) || (ch == 42) || (ch == 91) || (ch == 93)) {
                return "Not : \\ / ? * [ ] — a reference uses those."
            }
            i = (i + 1)
        }
        if ((charAt name 0) == 39) {
            return "Not a leading apostrophe."
        }
        if ((charAt name (n - 1)) == 39) {
            return "Not a trailing apostrophe."
        }
        return "Another sheet is already called that."
    }

    ; --- column sizing --------------------------------------------------------
    ; Auto-fit: widest painted cell in the column, plus the cell padding. The
    ; scan is capped so a 100k-row sheet stays instant — Excel samples too.
    fn autoFitColumn:void (col:int) {
        if (col < 0) {
            return
        }
        if (col >= model.colCount) {
            return
        }
        def best:int (view.measureText((SpreadsheetModel.colLabel(col))))
        def last:int (model.usedRow())
        if (last > 4999) {
            last = 4999
        }
        def r:int 0
        while (r <= last) {
            def txt:string (model.getDisplay(r col))
            if ((strlen txt) > 0) {
                def w:int (view.measureText(txt))
                if (w > best) {
                    best = w
                }
            }
            r = (r + 1)
        }
        def target:int (best + 16)
        if (target < 32) {
            target = 32
        }
        if (target > 600) {
            target = 600
        }
        this.setColumnWidths(col target)
    }

    ; Set a width on `col`, and on every other selected column when the one
    ; being sized is part of the selection — the way Excel resizes a block.
    fn setColumnWidths:void (col:int width:int) {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def lo:int col
        def hi:int col
        if ((col >= a.col) && (col <= b.col)) {
            if (a.col != b.col) {
                lo = a.col
                hi = b.col
            }
        }
        def c:int lo
        while (c <= hi) {
            model.setColWidth(c width)
            c = (c + 1)
        }
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    ; Double-click on a header edge (or anywhere in a header) auto-fits it.
    fn autoFitAt:boolean (px:int py:int) {
        ; A double click on a sheet tab is how every spreadsheet asks for a
        ; rename, and this is the double-click entry every host already calls.
        def onTab:int (grid.hitSheetTab((book.sheetCount()) px py))
        if (onTab >= 0) {
            renameStatus = ""
            this.openRenameDialog(onTab)
            return true
        }
        def edgeCol:int (grid.hitColResize(model px py))
        if (edgeCol >= 0) {
            this.autoFitColumn(edgeCol)
            return true
        }
        if (this.autoFitRowAt(px py)) {
            return true
        }
        def hit:CellPos (grid.hitTest(model px py))
        if ((hit.row == -2) && (hit.col >= 0)) {
            this.autoFitColumn(hit.col)
            return true
        }
        return false
    }

    fn hitColumnMenuArrow:boolean (col:int px:int py:int) {
        def top:int (grid.headerTop())
        if (py < top) {
            return false
        }
        if (py >= (top + grid.colHeaderH)) {
            return false
        }
        def x0:int (grid.colScreenX(model col))
        def x1:int (x0 + (model.colWidth(col)))
        def aw:int (GridView.colMenuArrowW())
        if (px < (x1 - aw)) {
            return false
        }
        return (px < x1)
    }

    ; Row height that fits wrapped content — the counterpart of column auto-fit.
    fn autoFitRow:void (row:int) {
        if (row < 0) {
            return
        }
        if (row >= model.rowCount) {
            return
        }
        def best:int model.defaultRowH
        def c:int 0
        def lastCol:int (model.usedCol())
        while (c <= lastCol) {
            def txt:string (model.getDisplay(row c))
            if ((strlen txt) > 0) {
                def st:CellStyle (model.getCellStyle(row c))
                def need:int (view.measureWrappedHeight(txt (model.colWidth(c)) st))
                if (need > best) {
                    best = need
                }
            }
            c = (c + 1)
        }
        if (best > 400) {
            best = 400
        }
        model.setRowHeight(row best)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    ; Grow one row to fit what is now in it — and only grow.
    ;
    ; A spreadsheet makes room when the type gets bigger: put 20pt in a row and
    ; the row becomes 20pt tall, in Excel and in Sheets alike. Shrinking when
    ; the type gets smaller is a separate call (`fitRowToContent`), because a
    ; height the user dragged out should not vanish on an unrelated edit.
    fn growRowToFit:boolean (row:int) {
        return (this.fitRowToContent(row false))
    }

    ; Set the row to the height its contents need. `allowShrink` is true when
    ; the type just got smaller — then taking the room back is the point.
    fn fitRowToContent:boolean (row:int allowShrink:boolean) {
        if (row < 0) {
            return false
        }
        if (row >= model.rowCount) {
            return false
        }
        def want:int model.defaultRowH
        def c:int 0
        def lastCol:int (model.usedCol())
        while (c <= lastCol) {
            def txt:string (model.getDisplay(row c))
            ; A cell counts if it has something in it OR a format of its own:
            ; set an empty cell to 20 point and the row makes room for 20
            ; point, which is what happens when you do it in a spreadsheet.
            def counts:boolean ((strlen txt) > 0)
            if ((model.getCellStyleId(row c)) >= 0) {
                counts = true
            }
            if counts {
                def st:CellStyle (model.getCellStyle(row c))
                def need:int (view.measureWrappedHeight(txt (model.colWidth(c)) st))
                if (need > want) {
                    want = need
                }
            }
            c = (c + 1)
        }
        if (want > 400) {
            want = 400
        }
        def cur:int (model.rowHeight(row))
        if (want == cur) {
            return false
        }
        if (want < cur) {
            if (allowShrink == false) {
                return false
            }
        }
        model.setRowHeight(row want)
        return true
    }

    ; The same over every row the selection touches, plus the caret's own row,
    ; refreshing the view once if anything moved.
    fn growSelectedRowsToFit:void () {
        this.fitSelectedRowsToContent(false)
    }

    fn fitSelectedRowsToContent:void (allowShrink:boolean) {
        def moved:boolean (this.fitRowToContent(sel.active.row allowShrink))
        def i:int 0
        while (i < (sel.rangeCount())) {
            def rg:GridRange (sel.rangeAt(i))
            def r:int rg.r0
            def last:int rg.r1
            while (r <= last) {
                if (this.fitRowToContent(r allowShrink)) {
                    moved = true
                }
                r = (r + 1)
            }
            i = (i + 1)
        }
        if moved {
            sheetView.markDirty()
            sheetView.rebuild()
            grid.updateVisible(model)
        }
    }

    ; Double-click on a row header edge auto-fits its height.
    fn autoFitRowAt:boolean (px:int py:int) {
        def edgeRow:int (grid.hitRowResize(model px py))
        if (edgeRow >= 0) {
            this.autoFitRow(edgeRow)
            return true
        }
        return false
    }

    ; --- column structure -----------------------------------------------------
    ; Insert / delete / move a column. The data move lives in SpreadsheetModel;
    ; what belongs here is repairing every formula in the WORKBOOK that pointed
    ; into the edited sheet — including cross-sheet references naming it — and
    ; rebuilding the dependency graph afterwards.
    fn adjustFormulasForColumns:void (at:int delta:int) {
        this.adjustFormulasFor(true at delta)
    }

    ; Rows and columns repair the same way — the only difference is which
    ; coordinate of a reference moves — so they share one walk.
    fn adjustFormulasForRows:void (at:int delta:int) {
        this.adjustFormulasFor(false at delta)
    }

    fn adjustFormulasFor:void (columns:boolean at:int delta:int) {
        def sheetName:string model.name
        def si:int 0
        def sn:int (book.sheetCount())
        while (si < sn) {
            def sheet:SpreadsheetModel (book.sheetAt(si))
            def sameSheet:boolean (si == book.activeIndex)
            def keys:[string]
            def texts:[string]
            sheet.snapshotFormulas(keys texts)
            def i:int 0
            while (i < (array_length keys)) {
                def key:string (itemAt keys i)
                def expr:string (itemAt texts i)
                ; On another sheet only qualified references naming the edited
                ; sheet move; unprefixed local refs must stay put.
                def rewritten:string ""
                if columns {
                    rewritten = (FormulaParser.adjustColumns(expr sheetName at delta sameSheet))
                } {
                    rewritten = (FormulaParser.adjustRows(expr sheetName at delta sameSheet))
                }
                if ((strlen rewritten) > 0) {
                    if (rewritten != expr) {
                        set sheet.formulas key rewritten
                    }
                }
                i = (i + 1)
            }
            si = (si + 1)
        }
        model.version = (model.version + 1)
    }

    ; Snapshot formulas on every sheet except the active one onto the last
    ; structural undo op — active-sheet formulas are already in savedKeys.
    fn snapshotOtherSheetFormulas:void () {
        def n:int (array_length model.undoStack)
        if (n <= 0) {
            return
        }
        def op:SpreadsheetUndoOp (itemAt model.undoStack (n - 1))
        clear op.otherSheetIdx
        clear op.otherKeys
        clear op.otherTexts
        def si:int 0
        def sn:int (book.sheetCount())
        while (si < sn) {
            if (si != book.activeIndex) {
                def sheet:SpreadsheetModel (book.sheetAt(si))
                def keys:[string]
                def texts:[string]
                sheet.snapshotFormulas(keys texts)
                def i:int 0
                while (i < (array_length keys)) {
                    push op.otherSheetIdx si
                    push op.otherKeys (itemAt keys i)
                    push op.otherTexts (itemAt texts i)
                    i = (i + 1)
                }
            }
            si = (si + 1)
        }
    }

    fn restoreOtherSheetFormulas:void (op:SpreadsheetUndoOp) {
        ; Restore per sheet so wipe+write stays local to that model.
        def sn:int (book.sheetCount())
        def si:int 0
        while (si < sn) {
            if (si != book.activeIndex) {
                def keys:[string]
                def texts:[string]
                def i:int 0
                while (i < (array_length op.otherSheetIdx)) {
                    if ((itemAt op.otherSheetIdx i) == si) {
                        push keys (itemAt op.otherKeys i)
                        push texts (itemAt op.otherTexts i)
                    }
                    i = (i + 1)
                }
                def sheet:SpreadsheetModel (book.sheetAt(si))
                sheet.restoreFormulas(keys texts)
            }
            si = (si + 1)
        }
    }

    ; Redo of a structural op only replays the raw insert/delete/move — formula
    ; text must be shifted again the same way the forward path did.
    fn reapplyStructFormulaAdjust:void (op:SpreadsheetUndoOp) {
        if (op.structKind == 1) {
            this.adjustFormulasForColumns(op.structAt 1)
        }
        if (op.structKind == 2) {
            this.adjustFormulasForColumns(op.structAt -1)
        }
        if (op.structKind == 3) {
            this.adjustFormulasForColumns(op.structAt -1)
            this.adjustFormulasForColumns(op.structTo 1)
        }
        if (op.structKind == 4) {
            this.adjustFormulasForRows(op.structAt 1)
        }
        if (op.structKind == 5) {
            this.adjustFormulasForRows(op.structAt -1)
        }
        if (op.structKind == 6) {
            this.adjustFormulasForRows(op.structAt -1)
            this.adjustFormulasForRows(op.structTo 1)
        }
    }

    fn afterStructuralChange:void () {
        sheetView.markDirty()
        sheetView.rebuild()
        engine.rebuildAll()
        grid.updateVisible(model)
    }

    ; After any cell value/formula mutation: if sort or filter is on, the view
    ; order may have changed and must be rebuilt before paint / hit-test.
    fn afterCellMutation:void () {
        if ((model.sortCol >= 0) || model.filterEnabled) {
            sheetView.markDirty()
            sheetView.rebuild()
        }
        grid.updateVisible(model)
    }

    fn insertColumn:void (at:int) {
        if (at < 0) {
            return
        }
        model.beginTx()
        model.pushStructOp(1 at 0)
        this.snapshotOtherSheetFormulas()
        model.insertColumnRaw(at)
        model.endTx()
        this.adjustFormulasForColumns(at 1)
        this.afterStructuralChange()
    }

    fn deleteColumn:void (at:int) {
        if (at < 0) {
            return
        }
        if (at >= model.colCount) {
            return
        }
        model.beginTx()
        model.pushStructOp(2 at 0)
        this.snapshotOtherSheetFormulas()
        model.deleteColumnRaw(at)
        model.endTx()
        this.adjustFormulasForColumns(at -1)
        this.afterStructuralChange()
    }

    fn moveColumn:void (from:int to:int) {
        if (from == to) {
            return
        }
        if (from < 0) {
            return
        }
        if (from >= model.colCount) {
            return
        }
        if (to < 0) {
            return
        }
        if (to >= model.colCount) {
            return
        }
        model.beginTx()
        model.pushStructOp(3 from to)
        this.snapshotOtherSheetFormulas()
        model.moveColumnRaw(from to)
        model.endTx()
        ; A move is a delete followed by an insert, so refs shift twice.
        this.adjustFormulasForColumns(from -1)
        this.adjustFormulasForColumns(to 1)
        this.afterStructuralChange()
    }

    fn insertColumnLeftOfSelection:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        this.insertColumn(a.col)
    }

    fn insertColumnRightOfSelection:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        this.insertColumn((b.col + 1))
    }

    fn deleteSelectedColumns:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def count:int ((b.col - a.col) + 1)
        def i:int 0
        while (i < count) {
            this.deleteColumn(a.col)
            i = (i + 1)
        }
        sel.anchor.col = a.col
        sel.active.col = a.col
        def p:CellPos (CellPos.create(sel.active.row sel.active.col))
        model.clampPos(p)
        sel.setActive(p.row p.col)
        sel.collapseToActive()
    }

    fn moveSelectedColumn:void (delta:int) {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def from:int a.col
        def to:int (from + delta)
        if (to < 0) {
            return
        }
        if (to >= model.colCount) {
            return
        }
        this.moveColumn(from to)
        sel.anchor.col = to
        sel.active.col = to
    }

    ; --- format painter -------------------------------------------------------
    ; Ctrl+Shift+C picks up the active cell's formatting; the next selection it
    ; is applied to gets it, and the brush disarms — like every office app.
    ; --- row structure --------------------------------------------------------
    ; The column actions, transposed. Same transaction, same workbook-wide
    ; formula repair, same one-step undo.
    fn insertRow:void (at:int) {
        if (at < 0) {
            return
        }
        model.beginTx()
        model.pushStructOp(4 at 0)
        this.snapshotOtherSheetFormulas()
        model.insertRowRaw(at)
        model.endTx()
        this.adjustFormulasForRows(at 1)
        this.afterStructuralChange()
    }

    fn deleteRow:void (at:int) {
        if (at < 0) {
            return
        }
        if (at >= model.rowCount) {
            return
        }
        model.beginTx()
        model.pushStructOp(5 at 0)
        this.snapshotOtherSheetFormulas()
        model.deleteRowRaw(at)
        model.endTx()
        this.adjustFormulasForRows(at -1)
        this.afterStructuralChange()
    }

    fn moveRow:void (from:int to:int) {
        if (from == to) {
            return
        }
        if (from < 0) {
            return
        }
        if (from >= model.rowCount) {
            return
        }
        if (to < 0) {
            return
        }
        if (to >= model.rowCount) {
            return
        }
        model.beginTx()
        model.pushStructOp(6 from to)
        this.snapshotOtherSheetFormulas()
        model.moveRowRaw(from to)
        model.endTx()
        this.adjustFormulasForRows(from -1)
        this.adjustFormulasForRows(to 1)
        this.afterStructuralChange()
    }

    fn insertRowAboveSelection:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        this.insertRow(a.row)
    }

    fn insertRowBelowSelection:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        this.insertRow((b.row + 1))
    }

    fn deleteSelectedRows:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def count:int ((b.row - a.row) + 1)
        def i:int 0
        while (i < count) {
            this.deleteRow(a.row)
            i = (i + 1)
        }
        sel.anchor.row = a.row
        sel.active.row = a.row
        def p:CellPos (CellPos.create(sel.active.row sel.active.col))
        model.clampPos(p)
        sel.setActive(p.row p.col)
        sel.collapseToActive()
    }

    fn moveSelectedRow:void (delta:int) {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def from:int a.row
        def to:int (from + delta)
        if (to < 0) {
            return
        }
        if (to >= model.rowCount) {
            return
        }
        this.moveRow(from to)
        sel.anchor.row = to
        sel.active.row = to
    }

    fn copyFormat:void () {
        def st:CellStyle (model.getCellStyle(sel.active.row sel.active.col))
        formatBrush = (st.copy())
        formatBrushArmed = true
        view.status = "format brush armed"
    }

    fn applyFormatToSelection:void () {
        if (formatBrushArmed == false) {
            return
        }
        model.beginTx()
        def gi:int 0
        while (gi < (sel.rangeCount())) {
            def g:GridRange (sel.rangeAt(gi))
            def r:int g.r0
            while (r <= g.r1) {
                def c:int g.c0
                while (c <= g.c1) {
                    model.applyEditStyled(r c (model.getCell(r c)) (model.getFormula(r c)) formatBrush)
                    c = (c + 1)
                }
                r = (r + 1)
            }
            gi = (gi + 1)
        }
        model.endTx()
        formatBrushArmed = false
        view.status = "format applied"
    }

    fn cancelFormatBrush:void () {
        formatBrushArmed = false
    }

    fn nudgeColumnWidth:void (col:int delta:int) {
        if (col < 0) {
            return
        }
        def w:int ((model.colWidth(col)) + delta)
        if (w < 24) {
            w = 24
        }
        if (w > 600) {
            w = 600
        }
        this.setColumnWidths(col w)
    }

    ; Sorting moves the DATA, not just the way it is drawn.
    ;
    ; It used to permute the view's row order and leave the sheet alone. On
    ; screen that looks identical, and everywhere else it is not: the file
    ; saves in the old order, a copied range copies the old order, a chart
    ; plots the old order, and reopening the file undoes a sort that appeared
    ; to have happened. Excel and Sheets both move the rows, and so does this
    ; — in one transaction, so one Ctrl+Z puts it back.
    fn applySort:void (col:int ascending:boolean) {
        if (col < 0) {
            return
        }
        if (col >= model.colCount) {
            return
        }
        if editing {
            this.commitEdit()
        }
        ; …and on a database sheet it moves the rows the ENGINE returns: the
        ; sort is a new query. Reordering the page that happens to be loaded
        ; would order one screen of a million rows and call it sorted. The edit
        ; above is committed first, so what is written back is what was typed.
        if (this.dbSheetActive()) {
            db.sortByColumn(model col ascending)
            this.afterDbReload()
            return
        }
        sheetView.markDirty()
        sheetView.rebuild()
        def order:[int]
        sheetView.sortedOrder(col ascending order)
        def moved:boolean false
        def i:int 0
        while (i < (array_length order)) {
            if ((itemAt order i) != i) {
                moved = true
            }
            i = (i + 1)
        }
        ; Remember which column was sorted so the header still says so, but do
        ; not leave the VIEW sorting on top of data that is now in order.
        model.setSort(-1 ascending)
        model.sortedCol = col
        model.sortedAsc = ascending
        if moved {
            model.beginTx()
            model.pushReorderOp(order)
            this.snapshotOtherSheetFormulas()
            model.reorderRowsRaw(order)
            ; The cells moved; their references have to move with them.
            ; Without this a `=B3+C3+D3` that travelled from row 3 to row 6
            ; still added row 3, so every total in the sheet quietly belonged
            ; to a different row — numbers that are wrong and look fine.
            this.remapFormulasForOrder(order)
            model.endTx()
            this.afterStructuralChange()
        } {
            sheetView.markDirty()
            sheetView.rebuild()
            grid.updateVisible(model)
        }
    }

    ; Every formula in the workbook, after the rows of this sheet were
    ; permuted. `order[i]` is the row that ENDED UP at i, so the map a formula
    ; needs — where did the row that was at `r` go — is its inverse.
    fn remapFormulasForOrder:void (order:[int]) {
        def n:int (array_length order)
        def newRowOf:[int]
        def i:int 0
        while (i < n) {
            push newRowOf i
            i = (i + 1)
        }
        def k:int 0
        while (k < n) {
            def from:int (itemAt order k)
            if (from >= 0) {
                if (from < n) {
                    set_at newRowOf from k
                }
            }
            k = (k + 1)
        }
        def sheetName:string model.name
        def si:int 0
        def sn:int (book.sheetCount())
        while (si < sn) {
            def sheet:SpreadsheetModel (book.sheetAt(si))
            ; On the sheet that moved, a bare `B3` means a row of this sheet
            ; and follows it. On another sheet a bare `B3` is that sheet's own
            ; row and must not; only `Costs!B3` moves.
            def sameSheet:boolean (si == book.activeIndex)
            def keys:[string]
            def texts:[string]
            sheet.snapshotFormulas(keys texts)
            def fi:int 0
            while (fi < (array_length keys)) {
                def key:string (itemAt keys fi)
                def expr:string (itemAt texts fi)
                def rewritten:string (FormulaParser.remapRows(expr sheetName newRowOf sameSheet))
                if ((strlen rewritten) > 0) {
                    if (rewritten != expr) {
                        set sheet.formulas key rewritten
                    }
                }
                fi = (fi + 1)
            }
            si = (si + 1)
        }
        model.version = (model.version + 1)
    }

    fn applyFilter:void (col:int values:[string]) {
        model.setFilter(col true values)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    fn clearFilter:void () {
        if (this.dbSheetActive()) {
            db.clearQueryFilter(model)
            this.afterDbReload()
            return
        }
        def empty:[string]
        model.setFilter(-1 false empty)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    fn collectUnique:void (col:int out:[string]) {
        clear out
        def seen:[string:boolean]
        def r:int model.freezeRows
        while (r < model.rowCount) {
            def v:string (model.getCell(r col))
            if ((has seen v) == false) {
                set seen v true
                push out v
            }
            r = (r + 1)
        }
    }

    fn openHeaderMenu:void (col:int px:int py:int) {
        view.menuOpen = true
        view.menuKind = 0
        view.menuCol = col
        view.menuRow = -1
        view.menuH = 270
        view.menuX = px
        view.menuY = py
    }

    ; The row header's own menu. Rows have no sort or filter — those belong to
    ; a column — so its first item is the selection a click on the header would
    ; have made, and the rest are the structural actions.
    fn openRowMenu:void (row:int px:int py:int) {
        view.menuOpen = true
        view.menuKind = 1
        view.menuRow = row
        view.menuCol = -1
        view.menuH = 212
        view.menuX = px
        view.menuY = py
    }

    fn closeHeaderMenu:void () {
        view.menuOpen = false
        view.menuCol = -1
        view.menuRow = -1
        view.menuKind = 0
        view.menuH = 270
        view.menuW = 190
    }

    fn menuItemCount:int () {
        if (view.menuKind == 1) {
            return 9
        }
        if (view.menuKind == 2) {
            return (GridApp.fontSizeCount())
        }
        if (view.menuKind == 3) {
            return (GridApp.fontNameCount())
        }
        return 12
    }

    sfn fontSizeCount:int () {
        return 12
    }

    sfn fontSizeAt:string (i:int) {
        if (i == 0) { return "8" }
        if (i == 1) { return "9" }
        if (i == 2) { return "10" }
        if (i == 3) { return "11" }
        if (i == 4) { return "12" }
        if (i == 5) { return "14" }
        if (i == 6) { return "16" }
        if (i == 7) { return "18" }
        if (i == 8) { return "20" }
        if (i == 9) { return "24" }
        if (i == 10) { return "28" }
        if (i == 11) { return "36" }
        return "11"
    }

    sfn fontNameCount:int () {
        return 10
    }

    sfn fontNameAt:string (i:int) {
        if (i == 0) { return "Calibri" }
        if (i == 1) { return "Arial" }
        if (i == 2) { return "Times New Roman" }
        if (i == 3) { return "Georgia" }
        if (i == 4) { return "Courier New" }
        if (i == 5) { return "Open Sans" }
        if (i == 6) { return "Noto Sans" }
        if (i == 7) { return "Helvetica" }
        if (i == 8) { return "Droid Serif" }
        if (i == 9) { return "Josefin Sans" }
        return "Calibri"
    }

    fn openFontSizeMenu:void (px:int py:int) {
        view.menuOpen = true
        view.menuKind = 2
        view.menuCol = -1
        view.menuRow = -1
        view.menuW = 72
        view.menuH = (26 + ((GridApp.fontSizeCount()) * 20) + 4)
        view.menuX = px
        view.menuY = py
    }

    fn openFontNameMenu:void (px:int py:int) {
        view.menuOpen = true
        view.menuKind = 3
        view.menuCol = -1
        view.menuRow = -1
        view.menuW = 160
        view.menuH = (26 + ((GridApp.fontNameCount()) * 20) + 4)
        view.menuX = px
        view.menuY = py
    }

    fn runFontSizeMenu:void (action:int) {
        if (action < 1) {
            return
        }
        def idx:int (action - 1)
        if (idx >= (GridApp.fontSizeCount())) {
            this.closeHeaderMenu()
            return
        }
        def pt:string (GridApp.fontSizeAt(idx))
        this.closeHeaderMenu()
        this.runFormatCommand("format.size" pt)
    }

    fn runFontNameMenu:void (action:int) {
        if (action < 1) {
            return
        }
        def idx:int (action - 1)
        if (idx >= (GridApp.fontNameCount())) {
            this.closeHeaderMenu()
            return
        }
        def name:string (GridApp.fontNameAt(idx))
        this.closeHeaderMenu()
        this.runFormatCommand("format.font" name)
    }

    fn hitHeaderMenu:int (px:int py:int) {
        if (view.menuOpen == false) {
            return -1
        }
        if (px < view.menuX) {
            return -1
        }
        if (py < view.menuY) {
            return -1
        }
        if (px >= (view.menuX + view.menuW)) {
            return -1
        }
        if (py >= (view.menuY + view.menuH)) {
            return -1
        }
        ; Rows are 20px on a 26px title, which is what both menus are painted
        ; at. 0 means "inside the popup but not on an item", which still counts
        ; as a hit — it must not fall through to the sheet.
        def ly:int (py - view.menuY)
        if (ly < 26) {
            return 0
        }
        def idx:int ((idiv (ly - 26) 20) + 1)
        if (idx > (this.menuItemCount())) {
            return 0
        }
        return idx
    }

    fn runHeaderMenu:void (action:int) {
        if (view.menuKind == 1) {
            this.runRowMenu(action)
            return
        }
        if (view.menuKind == 2) {
            this.runFontSizeMenu(action)
            return
        }
        if (view.menuKind == 3) {
            this.runFontNameMenu(action)
            return
        }
        def col:int view.menuCol
        if (action == 1) {
            this.applySort(col true)
        }
        if (action == 2) {
            this.applySort(col false)
        }
        if (action == 3) {
            def vals:[string]
            this.collectUnique(col vals)
            ; keep at most first value for a visible demo filter when many uniques
            if ((array_length vals) > 1) {
                def keep:[string]
                push keep (itemAt vals 0)
                this.applyFilter(col keep)
            } {
                this.applyFilter(col vals)
            }
        }
        if (action == 4) {
            this.clearFilter()
        }
        if (action == 5) {
            this.autoFitColumn(col)
        }
        if (action == 6) {
            this.nudgeColumnWidth(col 20)
        }
        if (action == 7) {
            this.nudgeColumnWidth(col -20)
        }
        if (action == 8) {
            this.insertColumn(col)
        }
        if (action == 9) {
            this.insertColumn((col + 1))
        }
        if (action == 10) {
            this.deleteColumn(col)
        }
        if (action == 11) {
            this.moveColumn(col (col - 1))
        }
        if (action == 12) {
            this.moveColumn(col (col + 1))
        }
        this.closeHeaderMenu()
    }

    fn runRowMenu:void (action:int) {
        def row:int view.menuRow
        if (row < 0) {
            this.closeHeaderMenu()
            return
        }
        if (action == 1) {
            this.selectRow(row)
        }
        if (action == 2) {
            this.autoFitRow(row)
        }
        if (action == 3) {
            model.setRowHeight(row ((model.rowHeight(row)) + 10))
            this.afterStructuralChange()
        }
        if (action == 4) {
            model.setRowHeight(row ((model.rowHeight(row)) - 10))
            this.afterStructuralChange()
        }
        if (action == 5) {
            this.insertRow(row)
        }
        if (action == 6) {
            this.insertRow((row + 1))
        }
        if (action == 7) {
            this.deleteRow(row)
        }
        if (action == 8) {
            this.moveRow(row (row - 1))
        }
        if (action == 9) {
            this.moveRow(row (row + 1))
        }
        this.closeHeaderMenu()
    }

    ; --- dialogs --------------------------------------------------------------
    ; Paste Special, built on the shared EVGWindow layer. Control ids:
    ;   1..4 the mode radios, 10 OK, 11 Cancel.
    fn buildDialogs:void () {
        if dialogsReady {
            return
        }
        pasteDialog.title = "Paste Special"
        pasteDialog.w = 264
        pasteDialog.reset()
        pasteDialog.addLabel("Paste")
        pasteDialog.addRadio(1 "All (values, formulas, formats)" 1 true)
        pasteDialog.addRadio(2 "Values only" 1 false)
        pasteDialog.addRadio(3 "Formats only" 1 false)
        pasteDialog.addRadio(4 "Values and formulas, no formats" 1 false)
        pasteDialog.addSeparator()
        def ids:[int]
        push ids 11
        push ids 10
        def labels:[string]
        push labels "Cancel"
        push labels "Paste"
        pasteDialog.addButtonRow(ids labels 10)
        pasteDialog.finish()
        windows.add(pasteDialog)
        ; The chart picker's contents are rebuilt every time it opens — which
        ; kinds are offered depends on the selection — so only its place in the
        ; stack is settled here.
        chartDialog.w = 300
        chartDialog.title = "Chart"
        windows.add(chartDialog)
        findDialog.w = 380
        findDialog.title = "Find and replace"
        windows.add(findDialog)
        cfDialog.w = 360
        cfDialog.title = "Conditional formatting"
        windows.add(cfDialog)
        linkDialog.w = 360
        linkDialog.title = "Hyperlink"
        windows.add(linkDialog)
        dvDialog.w = 330
        dvDialog.title = "Data validation"
        windows.add(dvDialog)
        listDialog.w = 220
        listDialog.title = "Choose a value"
        windows.add(listDialog)
        colorDialog.w = 340
        colorDialog.title = "Colour"
        windows.add(colorDialog)
        borderDialog.w = 300
        borderDialog.title = "Borders"
        windows.add(borderDialog)
        renameDialog.w = 300
        renameDialog.title = "Sheet name"
        windows.add(renameDialog)
        sqlDialog.w = 460
        sqlDialog.title = "SQL query"
        windows.add(sqlDialog)
        connDialog.w = 460
        connDialog.title = "Database connection"
        windows.add(connDialog)
        dialogsReady = true
    }

    ; --- colour palette -------------------------------------------------------
    ; The toolbar used to hard-wire one red and one amber. A proper picker is a
    ; modal of swatches: theme row, standard grid, recent colours, and Apply.
    ; Ids: 901.. theme/standard/recent swatches (group 1), 990 No fill,
    ; 991 Cancel, 992 Apply. Op is "color" or "fill".
    sfn paletteTheme:string (i:int) {
        if (i == 0) { return "#000000" }
        if (i == 1) { return "#FFFFFF" }
        if (i == 2) { return "#C00000" }
        if (i == 3) { return "#FFC000" }
        if (i == 4) { return "#FFFF00" }
        if (i == 5) { return "#92D050" }
        if (i == 6) { return "#00B050" }
        if (i == 7) { return "#00B0F0" }
        if (i == 8) { return "#0070C0" }
        if (i == 9) { return "#7030A0" }
        return "#000000"
    }

    sfn paletteThemeCount:int () {
        return 10
    }

    sfn paletteStandard:string (i:int) {
        if (i == 0)  { return "#F2F2F2" }
        if (i == 1)  { return "#D9D9D9" }
        if (i == 2)  { return "#BFBFBF" }
        if (i == 3)  { return "#A6A6A6" }
        if (i == 4)  { return "#7F7F7F" }
        if (i == 5)  { return "#595959" }
        if (i == 6)  { return "#404040" }
        if (i == 7)  { return "#262626" }
        if (i == 8)  { return "#FFC7CE" }
        if (i == 9)  { return "#FF6B6B" }
        if (i == 10) { return "#FF0000" }
        if (i == 11) { return "#C00000" }
        if (i == 12) { return "#8B0000" }
        if (i == 13) { return "#FFE59A" }
        if (i == 14) { return "#FFD966" }
        if (i == 15) { return "#FFC000" }
        if (i == 16) { return "#ED7D31" }
        if (i == 17) { return "#C65911" }
        if (i == 18) { return "#FFF2CC" }
        if (i == 19) { return "#FFFF99" }
        if (i == 20) { return "#FFFF00" }
        if (i == 21) { return "#BF8F00" }
        if (i == 22) { return "#C6EFCE" }
        if (i == 23) { return "#A9D08E" }
        if (i == 24) { return "#70AD47" }
        if (i == 25) { return "#00B050" }
        if (i == 26) { return "#006600" }
        if (i == 27) { return "#BDD7EE" }
        if (i == 28) { return "#9DC3E6" }
        if (i == 29) { return "#5B9BD5" }
        if (i == 30) { return "#0070C0" }
        if (i == 31) { return "#002060" }
        if (i == 32) { return "#E2D5F1" }
        if (i == 33) { return "#C5A6E0" }
        if (i == 34) { return "#9E7CC3" }
        if (i == 35) { return "#7030A0" }
        if (i == 36) { return "#4A1C6B" }
        if (i == 37) { return "#F8CBAD" }
        if (i == 38) { return "#F4B183" }
        if (i == 39) { return "#C55A11" }
        return "#000000"
    }

    sfn paletteStandardCount:int () {
        return 40
    }

    fn rememberColor:void (hex:string) {
        if ((strlen hex) < 4) {
            return
        }
        def next:[string]
        push next hex
        def i:int 0
        while (i < (array_length colorRecent)) {
            def prev:string (itemAt colorRecent i)
            if (prev != hex) {
                if ((array_length next) < 10) {
                    push next prev
                }
            }
            i = (i + 1)
        }
        colorRecent = next
    }

    ; Capture every cell the picker will touch, so Cancel can put them back
    ; and Apply can record one undo from this baseline.
    fn snapshotColorSelection:void () {
        clear colorSnapRows
        clear colorSnapCols
        clear colorSnapStyles
        def gi:int 0
        while (gi < (sel.rangeCount())) {
            def g:GridRange (sel.rangeAt(gi))
            def r:int g.r0
            while (r <= g.r1) {
                def c:int g.c0
                while (c <= g.c1) {
                    push colorSnapRows r
                    push colorSnapCols c
                    push colorSnapStyles ((model.getCellStyle(r c)).copy())
                    c = (c + 1)
                }
                r = (r + 1)
            }
            gi = (gi + 1)
        }
        colorPreviewOn = true
        colorPreviewCommitted = false
    }

    fn restoreColorSnapshot:void () {
        def i:int 0
        while (i < (array_length colorSnapRows)) {
            def r:int (itemAt colorSnapRows i)
            def c:int (itemAt colorSnapCols i)
            def st:CellStyle (itemAt colorSnapStyles i)
            model.setCellStyleResolved(r c st)
            i = (i + 1)
        }
        sheetView.markDirty()
        grid.updateVisible(model)
    }

    ; Paint the chosen colour onto the selection without an undo entry — the
    ; sheet shows it immediately; Apply / Cancel decide whether it sticks.
    fn previewColorOnSheet:void (hex:string) {
        def i:int 0
        while (i < (array_length colorSnapRows)) {
            def r:int (itemAt colorSnapRows i)
            def c:int (itemAt colorSnapCols i)
            def base:CellStyle (itemAt colorSnapStyles i)
            def st:CellStyle (base.copy())
            if (colorDialogOp == "fill") {
                if ((strlen hex) == 0) {
                    st.hasFill = false
                    st.fillRgb = ""
                } {
                    st.hasFill = true
                    st.fillRgb = hex
                }
            } {
                st.textRgb = hex
            }
            model.setCellStyleResolved(r c st)
            i = (i + 1)
        }
        sheetView.markDirty()
        grid.updateVisible(model)
    }

    fn openColorDialog:void (op:string initial:string) {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        colorDialogOp = op
        colorPick = initial
        if ((strlen colorPick) == 0) {
            if (op == "fill") {
                colorPick = "#FFF2CC"
            } {
                colorPick = "#C00000"
            }
        }
        if (op == "fill") {
            colorDialog.title = "Fill colour"
        } {
            colorDialog.title = "Text colour"
        }
        this.snapshotColorSelection()
        colorDialog.w = 340
        colorDialog.reset()
        colorDialog.addLabel("Theme")
        colorDialog.beginColumns(10)
        def matched:boolean false
        def ti:int 0
        while (ti < (GridApp.paletteThemeCount())) {
            def th:string (GridApp.paletteTheme(ti))
            def on:boolean false
            if (matched == false) {
                if (th == colorPick) {
                    on = true
                    matched = true
                }
            }
            colorDialog.addSwatch((901 + ti) th 1 on)
            ti = (ti + 1)
        }
        colorDialog.endColumns()
        colorDialog.addSeparator()
        colorDialog.addLabel("Standard")
        colorDialog.beginColumns(10)
        def si:int 0
        while (si < (GridApp.paletteStandardCount())) {
            def sh:string (GridApp.paletteStandard(si))
            def onS:boolean false
            if (matched == false) {
                if (sh == colorPick) {
                    onS = true
                    matched = true
                }
            }
            colorDialog.addSwatch((911 + si) sh 1 onS)
            si = (si + 1)
        }
        colorDialog.endColumns()
        if ((array_length colorRecent) > 0) {
            colorDialog.addSeparator()
            colorDialog.addLabel("Recent")
            colorDialog.beginColumns(10)
            def ri:int 0
            while (ri < (array_length colorRecent)) {
                def rh:string (itemAt colorRecent ri)
                def onR:boolean false
                if (matched == false) {
                    if (rh == colorPick) {
                        onR = true
                        matched = true
                    }
                }
                colorDialog.addSwatch((960 + ri) rh 1 onR)
                ri = (ri + 1)
            }
            colorDialog.endColumns()
        }
        colorDialog.addSeparator()
        colorDialog.addLabel(("Selected: " + colorPick))
        ; Example cell the picker paints itself — what the sheet will look like.
        colorDialog.addContent(980 44)
        def ids:[int]
        def labels:[string]
        push ids 991
        push labels "Cancel"
        if (op == "fill") {
            push ids 990
            push labels "No fill"
        }
        push ids 992
        push labels "Apply"
        colorDialog.addButtonRow(ids labels 992)
        colorDialog.finish()
        def px:int (grid.x + (idiv (W - colorDialog.w) 2))
        colorDialog.openWithin(px (grid.y + 40) W H)
        windows.raise(colorDialog)
        view.focused = true
        ; Live-preview only when the cell already had a colour (or the user
        ; picks one). Opening with an empty style must not paint a default.
        if ((strlen initial) > 0) {
            this.previewColorOnSheet(colorPick)
        }
        this.syncColorPreviewView()
    }

    fn syncColorPreviewView:void () {
        view.colorPreviewHex = colorPick
        view.colorPreviewIsFill = (colorDialogOp == "fill")
        if colorDialog.visible {
            view.colorPreviewWid = colorDialog.wid
        } {
            view.colorPreviewWid = 0
        }
    }

    fn refreshColorDialogSelection:void () {
        def hex:string (colorDialog.selectedSwatchValue(1))
        if ((strlen hex) > 0) {
            colorPick = hex
        }
        def i:int 0
        def lastLabel:int -1
        while (i < (array_length colorDialog.controls)) {
            def c:EVGControl (itemAt colorDialog.controls i)
            if (c.kind == (EVGControlKind.label())) {
                if ((strlen c.text) >= 10) {
                    if ((substring c.text 0 10) == "Selected: ") {
                        lastLabel = i
                    }
                }
            }
            i = (i + 1)
        }
        if (lastLabel >= 0) {
            def lab:EVGControl (itemAt colorDialog.controls lastLabel)
            lab.text = ("Selected: " + colorPick)
        }
        this.previewColorOnSheet(colorPick)
        this.syncColorPreviewView()
    }

    fn applyColorDialog:void () {
        this.refreshColorDialogSelection()
        def arg:string colorPick
        ; Put the snapshot back, then apply once through the normal format
        ; path so Ctrl+Z undoes the whole pick as a single action.
        this.restoreColorSnapshot()
        if ((strlen arg) > 0) {
            this.rememberColor(arg)
        }
        def done:boolean (GridFormat.apply(model sel colorDialogOp arg))
        if done {
            this.growSelectedRowsToFit()
            sheetView.markDirty()
            grid.updateVisible(model)
            view.status = (colorDialog.title + ": " + arg)
        }
        colorPreviewCommitted = true
        colorPreviewOn = false
        view.colorPreviewWid = 0
        colorDialog.close()
    }

    fn clearFillFromColorDialog:void () {
        colorPick = ""
        this.restoreColorSnapshot()
        def done:boolean (GridFormat.apply(model sel "fill" ""))
        if done {
            sheetView.markDirty()
            grid.updateVisible(model)
            view.status = "Fill cleared"
        }
        colorPreviewCommitted = true
        colorPreviewOn = false
        view.colorPreviewWid = 0
        colorDialog.close()
    }

    fn cancelColorDialog:void () {
        if colorPreviewOn {
            if (colorPreviewCommitted == false) {
                this.restoreColorSnapshot()
            }
        }
        colorPreviewOn = false
        colorPreviewCommitted = false
        view.colorPreviewWid = 0
        colorDialog.close()
    }

    ; --- the border gallery ---------------------------------------------------
    ; Three toolbar buttons could say "all", "outline" and "none", and that was
    ; the whole vocabulary: no way to put a line under a block without boxing
    ; it, no way to choose a thickness, no way to choose a colour. Everything
    ; Excel offers in Format Cells → Border, and none of it reachable.
    ;
    ; So a window. It opens showing what the caret's cell ALREADY has — that is
    ; what makes unticking an edge a way to remove one — and everything in it
    ; feeds one command string, `format.border spec:…`, so a host driving the
    ; grid can say the same thing without the window.
    ;
    ; Ids: 1001..1006 the edges, 1011..1016 the line, 1030.. the colour
    ; (group 2), 1050 the preview, 1071..1073 the presets, 1091 Cancel,
    ; 1092 Apply.
    sfn borderPaletteCount:int () {
        return 10
    }

    sfn borderPalette:string (i:int) {
        if (i == 0) { return "#000000" }
        if (i == 1) { return "#404040" }
        if (i == 2) { return "#808080" }
        if (i == 3) { return "#BFBFBF" }
        if (i == 4) { return "#C00000" }
        if (i == 5) { return "#ED7D31" }
        if (i == 6) { return "#FFC000" }
        if (i == 7) { return "#70AD47" }
        if (i == 8) { return "#4472C4" }
        if (i == 9) { return "#7030A0" }
        return "#000000"
    }

    sfn borderLineCount:int () {
        return 6
    }

    sfn borderLineStyle:string (i:int) {
        if (i == 0) { return "thin" }
        if (i == 1) { return "medium" }
        if (i == 2) { return "thick" }
        if (i == 3) { return "double" }
        if (i == 4) { return "dashed" }
        if (i == 5) { return "dotted" }
        return "thin"
    }

    sfn borderLineLabel:string (i:int) {
        if (i == 0) { return "Thin" }
        if (i == 1) { return "Medium" }
        if (i == 2) { return "Thick" }
        if (i == 3) { return "Double" }
        if (i == 4) { return "Dashed" }
        if (i == 5) { return "Dotted" }
        return "Thin"
    }

    ; The edges the caret's cell carries, as spec letters. A cell in the middle
    ; of a selection cannot say anything about the block's inside lines, so H
    ; and V are never seeded — they are something you ask for, not something
    ; that is already there.
    fn borderEdgesOfActive:string () {
        def st:CellStyle (model.getCellStyle(sel.active.row sel.active.col))
        def out:string ""
        if (st.borderTop.has()) {
            out = (out + "T")
        }
        if (st.borderBottom.has()) {
            out = (out + "B")
        }
        if (st.borderLeft.has()) {
            out = (out + "L")
        }
        if (st.borderRight.has()) {
            out = (out + "R")
        }
        return out
    }

    ; The line and colour the caret's cell already draws with, so re-opening
    ; the gallery over a red dashed box does not offer to make it thin black.
    fn borderLineOfActive:string () {
        def st:CellStyle (model.getCellStyle(sel.active.row sel.active.col))
        if (st.borderTop.has())    { return st.borderTop.style }
        if (st.borderBottom.has()) { return st.borderBottom.style }
        if (st.borderLeft.has())   { return st.borderLeft.style }
        if (st.borderRight.has())  { return st.borderRight.style }
        return "thin"
    }

    fn borderInkOfActive:string () {
        def st:CellStyle (model.getCellStyle(sel.active.row sel.active.col))
        if (st.borderTop.has())    { return st.borderTop.rgb }
        if (st.borderBottom.has()) { return st.borderBottom.rgb }
        if (st.borderLeft.has())   { return st.borderLeft.rgb }
        if (st.borderRight.has())  { return st.borderRight.rgb }
        return "#000000"
    }

    fn openBorderDialog:void () {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        def edges:string (this.borderEdgesOfActive())
        borderLine = (this.borderLineOfActive())
        borderInk = (this.borderInkOfActive())
        def multi:boolean false
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        if (a.row != b.row) {
            multi = true
        }
        if (a.col != b.col) {
            multi = true
        }
        borderDialog.w = 300
        borderDialog.reset()
        borderDialog.addLabel("Edges")
        borderDialog.beginColumns(2)
        borderDialog.addCheckbox(1001 "Top" (GridApp.hasLetter(edges 84)))
        borderDialog.addCheckbox(1002 "Bottom" (GridApp.hasLetter(edges 66)))
        borderDialog.addCheckbox(1003 "Left" (GridApp.hasLetter(edges 76)))
        borderDialog.addCheckbox(1004 "Right" (GridApp.hasLetter(edges 82)))
        borderDialog.endColumns()
        ; The two inside lines only mean something when there is an inside.
        if multi {
            borderDialog.beginColumns(2)
            borderDialog.addCheckbox(1005 "Inside —" false)
            borderDialog.addCheckbox(1006 "Inside |" false)
            borderDialog.endColumns()
        }
        borderDialog.addSeparator()
        borderDialog.addLabel("Line")
        borderDialog.beginColumns(3)
        def li:int 0
        while (li < (GridApp.borderLineCount())) {
            def styleName:string (GridApp.borderLineStyle(li))
            borderDialog.addRadio((1011 + li) (GridApp.borderLineLabel(li)) 1 (styleName == borderLine))
            li = (li + 1)
        }
        borderDialog.endColumns()
        borderDialog.addSeparator()
        borderDialog.addLabel("Colour")
        borderDialog.beginColumns(10)
        def matched:boolean false
        def ci:int 0
        while (ci < (GridApp.borderPaletteCount())) {
            def hex:string (GridApp.borderPalette(ci))
            def on:boolean false
            if (matched == false) {
                if (hex == borderInk) {
                    on = true
                    matched = true
                }
            }
            borderDialog.addSwatch((1030 + ci) hex 2 on)
            ci = (ci + 1)
        }
        borderDialog.endColumns()
        ; A colour the sheet is already using but the palette does not offer
        ; would otherwise be silently swapped for black on the first Apply.
        if (matched == false) {
            borderDialog.beginColumns(10)
            borderDialog.addSwatch(1029 borderInk 2 true)
            borderDialog.endColumns()
        }
        borderDialog.addSeparator()
        borderDialog.addContent(1050 62)
        def pids:[int]
        def plabels:[string]
        push pids 1071
        push plabels "Box"
        push pids 1072
        push plabels "All"
        push pids 1073
        push plabels "None"
        borderDialog.addButtonRow(pids plabels 0)
        def ids:[int]
        def labels:[string]
        push ids 1091
        push labels "Cancel"
        push ids 1092
        push labels "Apply"
        borderDialog.addButtonRow(ids labels 1092)
        borderDialog.finish()
        def px:int (grid.x + (idiv (W - borderDialog.w) 2))
        borderDialog.openWithin(px (grid.y + 40) W H)
        windows.raise(borderDialog)
        view.focused = true
        this.syncBorderDialog()
    }

    sfn hasLetter:boolean (s:string letter:int) {
        def i:int 0
        while (i < (strlen s)) {
            if ((charAt s i) == letter) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; What the controls currently say, as the spec string the command takes.
    fn borderSpecFromDialog:string () {
        def flags:string ""
        if (borderDialog.isChecked(1001)) {
            flags = (flags + "T")
        }
        if (borderDialog.isChecked(1002)) {
            flags = (flags + "B")
        }
        if (borderDialog.isChecked(1003)) {
            flags = (flags + "L")
        }
        if (borderDialog.isChecked(1004)) {
            flags = (flags + "R")
        }
        if (borderDialog.isChecked(1005)) {
            flags = (flags + "H")
        }
        if (borderDialog.isChecked(1006)) {
            flags = (flags + "V")
        }
        return ("spec:" + flags + ":" + borderLine + ":" + borderInk)
    }

    ; Read the window back every frame, the way the chart picker does, so the
    ; preview is what the controls say and not what they said when it opened.
    fn syncBorderDialog:void () {
        def chosen:int (borderDialog.selectedInGroup(1))
        if (chosen >= 1011) {
            borderLine = (GridApp.borderLineStyle((chosen - 1011)))
        }
        def hex:string (borderDialog.selectedSwatchValue(2))
        if ((strlen hex) > 0) {
            borderInk = hex
        }
        view.borderPreviewSpec = (this.borderSpecFromDialog())
        if borderDialog.visible {
            view.borderPreviewWid = borderDialog.wid
        } {
            view.borderPreviewWid = 0
        }
    }

    ; The presets tick boxes rather than applying anything: what a preset means
    ; is then visible in the preview before it touches the sheet.
    fn presetBorderDialog:void (which:int) {
        def box:boolean (which == 1071)
        def all:boolean (which == 1072)
        borderDialog.setChecked(1001 (box || all))
        borderDialog.setChecked(1002 (box || all))
        borderDialog.setChecked(1003 (box || all))
        borderDialog.setChecked(1004 (box || all))
        borderDialog.setChecked(1005 all)
        borderDialog.setChecked(1006 all)
        this.syncBorderDialog()
    }

    fn applyBorderDialog:void () {
        this.syncBorderDialog()
        def spec:string (this.borderSpecFromDialog())
        def done:boolean (GridFormat.apply(model sel "border" spec))
        if done {
            sheetView.markDirty()
            grid.updateVisible(model)
            view.status = ("Borders: " + (GridFormat.specField(spec 1)))
        }
        view.borderPreviewWid = 0
        borderDialog.close()
    }

    fn cancelBorderDialog:void () {
        view.borderPreviewWid = 0
        borderDialog.close()
    }

    ; --- conditional formatting ----------------------------------------------
    ; Reading the rules a workbook came with was never the hard half; writing
    ; one was, because a rule needs a range, a test, a number and a colour, and
    ; a dialog that can only ask yes-or-no cannot collect them. It can now.
    ; Ids: 601..605 the test, 611/612 the numbers, 621..624 the fill,
    ; 631..633 the buttons.
    sfn cfFillFor:int (choice:int) {
        return choice
    }

    sfn cfColorHex:string (choice:int) {
        if (choice == 622) {
            return "FFE59A"
        }
        if (choice == 623) {
            return "C6EFCE"
        }
        if (choice == 624) {
            return "BDD7EE"
        }
        return "FFC7CE"
    }

    sfn cfOpFor:string (choice:int) {
        if (choice == 602) {
            return "lessThan"
        }
        if (choice == 603) {
            return "equal"
        }
        if (choice == 604) {
            return "between"
        }
        if (choice == 606) {
            return "greaterThanOrEqual"
        }
        if (choice == 607) {
            return "lessThanOrEqual"
        }
        return "greaterThan"
    }

    fn openCfDialog:void () {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        def g:GridRange (sel.liveRange())
        cfDialog.reset()
        cfDialog.labelW = 64
        cfDialog.addLabel(("Rule for " + (SpreadsheetModel.cellLabel(g.r0 g.c0)) + ":" + (SpreadsheetModel.cellLabel(g.r1 g.c1))))
        cfDialog.addSeparator()
        cfDialog.addLabel("Format cells where the value is")
        cfDialog.beginColumns(2)
        cfDialog.addRadio(601 "Greater than" 1 (cfTest == 601))
        cfDialog.addRadio(606 "At least (≥)" 1 (cfTest == 606))
        cfDialog.addRadio(602 "Less than" 1 (cfTest == 602))
        cfDialog.addRadio(607 "At most (≤)" 1 (cfTest == 607))
        cfDialog.addRadio(603 "Equal to" 1 (cfTest == 603))
        cfDialog.addRadio(604 "Between" 1 (cfTest == 604))
        cfDialog.endColumns()
        cfDialog.addRadio(605 "Colour scale over the range" 1 (cfTest == 605))
        cfDialog.addInput(611 "Value" cfV1)
        cfDialog.addInput(612 "and" cfV2)
        cfDialog.addSeparator()
        cfDialog.addLabel("Fill")
        if ((strlen cfFillHex) == 0) {
            cfFillHex = ("#" + (GridApp.cfColorHex(cfFill)))
        }
        ; Ids 621..624 keep the classic four so existing callers and tests
        ; still select by those numbers; the theme row adds the rest.
        cfDialog.beginColumns(10)
        cfDialog.addSwatch(621 "#FFC7CE" 2 (cfFillHex == "#FFC7CE"))
        cfDialog.addSwatch(622 "#FFE59A" 2 (cfFillHex == "#FFE59A"))
        cfDialog.addSwatch(623 "#C6EFCE" 2 (cfFillHex == "#C6EFCE"))
        cfDialog.addSwatch(624 "#BDD7EE" 2 (cfFillHex == "#BDD7EE"))
        def ci:int 0
        while (ci < (GridApp.paletteThemeCount())) {
            def ch:string (GridApp.paletteTheme(ci))
            def already:boolean false
            if (ch == "#FFC7CE") { already = true }
            if (ch == "#FFE59A") { already = true }
            if (ch == "#C6EFCE") { already = true }
            if (ch == "#BDD7EE") { already = true }
            if (already == false) {
                cfDialog.addSwatch((650 + ci) ch 2 (ch == cfFillHex))
            }
            ci = (ci + 1)
        }
        cfDialog.endColumns()
        def note:string cfStatus
        if ((strlen note) == 0) {
            note = ((to_string (model.cfRuleCount())) + " rule(s) on this sheet")
        }
        cfDialog.addLabel(note)
        def ids:[int]
        def labels:[string]
        push ids 631
        push labels "Close"
        push ids 632
        push labels "Clear"
        push ids 634
        push labels "± colours"
        push ids 633
        push labels "Add rule"
        cfDialog.addButtonRow(ids labels 633)
        cfDialog.finish()
        def px:int (grid.x + (idiv (W - cfDialog.w) 2))
        cfDialog.openWithin(px (grid.y + 50) W H)
        windows.raise(cfDialog)
        view.focused = true
    }

    sfn cfNumber:double (text:string) {
        def p@(optional):double (to_double text)
        if p {
            return (unwrap p)
        }
        return 0.0
    }

    ; Read the form into the remembered state, so a rebuild puts it back.
    fn syncCfDialog:void () {
        def t:int (cfDialog.selectedInGroup(1))
        if (t > 0) {
            cfTest = t
        }
        def f:int (cfDialog.selectedInGroup(2))
        if (f > 0) {
            cfFill = f
            def hex:string (cfDialog.selectedSwatchValue(2))
            if ((strlen hex) > 0) {
                cfFillHex = hex
            }
        }
        cfV1 = (cfDialog.inputValue(611))
        cfV2 = (cfDialog.inputValue(612))
    }

    fn addCfRuleFromDialog:void () {
        this.syncCfDialog()
        def g:GridRange (sel.liveRange())
        def rule:CfRule (new CfRule)
        rule.r0 = g.r0
        rule.c0 = g.c0
        rule.r1 = g.r1
        rule.c1 = g.c1
        if (cfTest == 605) {
            rule.kind = 0
        } {
            rule.kind = 1
            rule.op = (GridApp.cfOpFor(cfTest))
            rule.v1 = (GridApp.cfNumber(cfV1))
            rule.v2 = (GridApp.cfNumber(cfV2))
            def fill:string cfFillHex
            if ((strlen fill) == 0) {
                fill = ("#" + (GridApp.cfColorHex(cfFill)))
            }
            if ((charAt fill 0) != 35) {
                fill = ("#" + fill)
            }
            rule.fillRgb = fill
        }
        model.addCfRule(rule)
        cfStatus = ("added — " + (to_string (model.cfRuleCount())) + " rule(s)")
        def keepX:int cfDialog.x
        def keepY:int cfDialog.y
        this.openCfDialog()
        cfDialog.x = keepX
        cfDialog.y = keepY
    }

    fn clearCfRulesFromDialog:void () {
        this.syncCfDialog()
        def g:GridRange (sel.liveRange())
        model.clearCfRulesIn(g.r0 g.c0 g.r1 g.c1)
        cfStatus = ("cleared — " + (to_string (model.cfRuleCount())) + " rule(s) left")
        def keepX:int cfDialog.x
        def keepY:int cfDialog.y
        this.openCfDialog()
        cfDialog.x = keepX
        cfDialog.y = keepY
    }

    ; One click: ≥0 green, <0 red — the usual profit / loss pair.
    fn addCfPosNegFromDialog:void () {
        this.syncCfDialog()
        def g:GridRange (sel.liveRange())
        def pos:CfRule (new CfRule)
        pos.r0 = g.r0
        pos.c0 = g.c0
        pos.r1 = g.r1
        pos.c1 = g.c1
        pos.kind = 1
        pos.op = "greaterThanOrEqual"
        pos.v1 = 0.0
        pos.fillRgb = "#C6EFCE"
        model.addCfRule(pos)
        def neg:CfRule (new CfRule)
        neg.r0 = g.r0
        neg.c0 = g.c0
        neg.r1 = g.r1
        neg.c1 = g.c1
        neg.kind = 1
        neg.op = "lessThan"
        neg.v1 = 0.0
        neg.fillRgb = "#FFC7CE"
        model.addCfRule(neg)
        cfStatus = ("± colours — " + (to_string (model.cfRuleCount())) + " rule(s)")
        def keepX:int cfDialog.x
        def keepY:int cfDialog.y
        this.openCfDialog()
        cfDialog.x = keepX
        cfDialog.y = keepY
    }

    ; --- hyperlinks, notes and validation rules --------------------------------
    ; Three things a cell can carry that are not its value. They share a shape:
    ; each is metadata the file may bring, each is editable here, and none of
    ; them is on the undo stack — undoing a paste must not drop the note that
    ; was pinned to the cell before it.
    ;
    ; Ids: 801/802 the link, 811..813 its buttons; 701..705 the validation kind,
    ; 711/712 its numbers, 721..723 the operator, 731 allow-blank, 741..743 its
    ; buttons; 901+ the list picker's values.
    fn openLinkDialog:void () {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        def r:int sel.active.row
        def c:int sel.active.col
        linkDialog.reset()
        linkDialog.labelW = 60
        linkDialog.addLabel(("Link on " + (SpreadsheetModel.cellLabel(r c))))
        linkDialog.addInput(801 "Address" (model.hyperlinkAt(r c)))
        linkDialog.addInput(802 "Text" (model.getCell(r c)))
        def ids:[int]
        def labels:[string]
        push ids 811
        push labels "Close"
        push ids 812
        push labels "Remove"
        push ids 813
        push labels "Set"
        linkDialog.addButtonRow(ids labels 813)
        linkDialog.finish()
        linkDialog.openWithin((grid.x + (idiv (W - linkDialog.w) 2)) (grid.y + 70) W H)
        windows.raise(linkDialog)
        linkDialog.focusedId = 801
        view.focused = true
    }

    fn applyLinkDialog:void () {
        def r:int sel.active.row
        def c:int sel.active.col
        def target:string (linkDialog.inputValue(801))
        def text:string (linkDialog.inputValue(802))
        model.setHyperlink(r c target)
        if ((strlen text) > 0) {
            if (text != (model.getCell(r c))) {
                model.beginTx()
                model.applyEdit(r c text "")
                model.endTx()
                this.syncTouched()
            }
        }
        linkDialog.close()
    }

    ; Ctrl+click on a linked cell follows it. The app has no browser, so it
    ; records what was activated; the host opens it.
    fn followLink:boolean (row:int col:int) {
        def target:string (model.hyperlinkAt(row col))
        if ((strlen target) == 0) {
            return false
        }
        activatedLink = target
        view.status = ("link: " + target)
        return true
    }

    fn openValidationDialog:void () {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        def g:GridRange (sel.liveRange())
        def existing:DataValidation (model.validationAt(g.r0 g.c0))
        if ((strlen existing.kind) > 0) {
            if (existing.kind == "list") {
                dvKind = 701
            }
            if (existing.kind == "whole") {
                dvKind = 702
            }
            if (existing.kind == "decimal") {
                dvKind = 703
            }
            if (existing.kind == "textLength") {
                dvKind = 704
            }
            dvV1 = existing.f1
            dvV2 = existing.f2
            dvBlank = existing.allowBlank
            if (existing.op == "greaterThan") {
                dvOp = 722
            }
            if (existing.op == "lessThan") {
                dvOp = 723
            }
        }
        dvDialog.reset()
        dvDialog.labelW = 60
        dvDialog.addLabel(("Rule for " + (SpreadsheetModel.cellLabel(g.r0 g.c0)) + ":" + (SpreadsheetModel.cellLabel(g.r1 g.c1))))
        dvDialog.addSeparator()
        dvDialog.addLabel("Allow")
        dvDialog.beginColumns(2)
        dvDialog.addRadio(701 "List" 1 (dvKind == 701))
        dvDialog.addRadio(702 "Whole number" 1 (dvKind == 702))
        dvDialog.addRadio(703 "Decimal" 1 (dvKind == 703))
        dvDialog.addRadio(704 "Text length" 1 (dvKind == 704))
        dvDialog.endColumns()
        dvDialog.addInput(711 "Values" dvV1)
        dvDialog.addInput(712 "Max" dvV2)
        dvDialog.beginColumns(3)
        dvDialog.addRadio(721 "Between" 2 (dvOp == 721))
        dvDialog.addRadio(722 "At least" 2 (dvOp == 722))
        dvDialog.addRadio(723 "At most" 2 (dvOp == 723))
        dvDialog.endColumns()
        dvDialog.addCheckbox(731 "Allow blank" dvBlank)
        def note:string dvStatus
        if ((strlen note) == 0) {
            note = ((to_string (model.validationCount())) + " rule(s) on this sheet")
        }
        dvDialog.addLabel(note)
        def ids:[int]
        def labels:[string]
        push ids 741
        push labels "Close"
        push ids 742
        push labels "Clear"
        push ids 743
        push labels "Add rule"
        dvDialog.addButtonRow(ids labels 743)
        dvDialog.finish()
        dvDialog.openWithin((grid.x + (idiv (W - dvDialog.w) 2)) (grid.y + 50) W H)
        windows.raise(dvDialog)
        view.focused = true
    }

    fn syncValidationDialog:void () {
        def k:int (dvDialog.selectedInGroup(1))
        if (k > 0) {
            dvKind = k
        }
        def o:int (dvDialog.selectedInGroup(2))
        if (o > 0) {
            dvOp = o
        }
        dvV1 = (dvDialog.inputValue(711))
        dvV2 = (dvDialog.inputValue(712))
        dvBlank = (dvDialog.isChecked(731))
    }

    sfn dvKindName:string (choice:int) {
        if (choice == 702) {
            return "whole"
        }
        if (choice == 703) {
            return "decimal"
        }
        if (choice == 704) {
            return "textLength"
        }
        return "list"
    }

    sfn dvOpName:string (choice:int) {
        if (choice == 722) {
            return "greaterThanOrEqual"
        }
        if (choice == 723) {
            return "lessThanOrEqual"
        }
        return "between"
    }

    fn addValidationFromDialog:void () {
        this.syncValidationDialog()
        def g:GridRange (sel.liveRange())
        def v:DataValidation (new DataValidation)
        v.kind = (GridApp.dvKindName(dvKind))
        v.op = (GridApp.dvOpName(dvOp))
        v.r0 = g.r0
        v.c0 = g.c0
        v.r1 = g.r1
        v.c1 = g.c1
        v.f1 = dvV1
        v.f2 = dvV2
        v.allowBlank = dvBlank
        model.addValidation(v)
        dvStatus = ("added — " + (to_string (model.validationCount())) + " rule(s)")
        def kx:int dvDialog.x
        def ky:int dvDialog.y
        this.openValidationDialog()
        dvDialog.x = kx
        dvDialog.y = ky
    }

    fn clearValidationsFromDialog:void () {
        this.syncValidationDialog()
        def g:GridRange (sel.liveRange())
        model.clearValidationsIn(g.r0 g.c0 g.r1 g.c1)
        dvStatus = ("cleared — " + (to_string (model.validationCount())) + " rule(s) left")
        def kx:int dvDialog.x
        def ky:int dvDialog.y
        this.openValidationDialog()
        dvDialog.x = kx
        dvDialog.y = ky
    }

    ; A list rule knows its choices, so the cell offers them rather than making
    ; you remember them. Opened by the arrow in the cell, or by Alt-less Enter
    ; on a list cell — the arrow is what a spreadsheet user looks for.
    fn openListPicker:void (row:int col:int) {
        def rule:DataValidation (model.validationAt(row col))
        if ((rule.isList()) == false) {
            return
        }
        this.buildDialogs()
        listValues = (rule.listValues())
        def current:string (model.getCell(row col))
        listDialog.reset()
        listDialog.addLabel(("Value for " + (SpreadsheetModel.cellLabel(row col))))
        def i:int 0
        while (i < (array_length listValues)) {
            def val:string (itemAt listValues i)
            listDialog.addRadio((901 + i) val 1 (val == current))
            i = (i + 1)
        }
        def ids:[int]
        def labels:[string]
        push ids 891
        push labels "Cancel"
        push ids 892
        push labels "Choose"
        listDialog.addButtonRow(ids labels 892)
        listDialog.finish()
        def cell:GridRect (grid.cellRect(model row col))
        listDialog.openWithin(cell.x (cell.y + cell.h) W H)
        windows.raise(listDialog)
        view.focused = true
    }

    fn applyListPicker:void () {
        def chosen:int (listDialog.selectedInGroup(1))
        if (chosen >= 901) {
            def idx:int (chosen - 901)
            if (idx < (array_length listValues)) {
                def r:int sel.active.row
                def c:int sel.active.col
                model.beginTx()
                model.applyEdit(r c (itemAt listValues idx) "")
                model.endTx()
                this.syncTouched()
            }
        }
        listDialog.close()
    }

    ; --- charts ---------------------------------------------------------------
    ; What a chart made right now would read. A selection of one cell means
    ; "the block I am standing in", which is what Excel assumes too: nobody
    ; charts a single number.
    fn rowHasContent:boolean (r:int c0:int c1:int) {
        def c:int c0
        while (c <= c1) {
            if ((strlen (model.getCell(r c))) > 0) {
                return true
            }
            c = (c + 1)
        }
        return false
    }

    fn selectionChart:void (out:GridChart) {
        clear out.sourceCols
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def r0:int a.row
        def c0:int a.col
        def r1:int b.row
        def c1:int b.col
        if (r0 == r1) {
            if (c0 == c1) {
                while (c0 > 0) {
                    if ((strlen (model.getCell(r0 (c0 - 1)))) == 0) {
                        break
                    }
                    c0 = (c0 - 1)
                }
                while (c1 < (model.colCount - 1)) {
                    if ((strlen (model.getCell(r0 (c1 + 1)))) == 0) {
                        break
                    }
                    c1 = (c1 + 1)
                }
                while (r0 > 0) {
                    if ((this.rowHasContent((r0 - 1) c0 c1)) == false) {
                        break
                    }
                    r0 = (r0 - 1)
                }
                while (r1 < (model.rowCount - 1)) {
                    if ((this.rowHasContent((r1 + 1) c0 c1)) == false) {
                        break
                    }
                    r1 = (r1 + 1)
                }
            }
        }
        ; Ctrl+clicked column headers are disjoint one-column rectangles. Keep
        ; exactly those columns, in click order, instead of charting the gaps.
        if (sel.rangeCount() > 1) {
            def allColumns:boolean true
            def dri:int 0
            def minR:int (model.rowCount - 1)
            def maxR:int 0
            def minC:int (model.colCount - 1)
            def maxC:int 0
            while (dri < (sel.rangeCount())) {
                def dg:GridRange (sel.rangeAt(dri))
                if (dg.c0 != dg.c1) {
                    allColumns = false
                }
                if (dg.r0 < minR) {
                    minR = dg.r0
                }
                if (dg.r1 > maxR) {
                    maxR = dg.r1
                }
                if (dg.c0 < minC) {
                    minC = dg.c0
                }
                if (dg.c1 > maxC) {
                    maxC = dg.c1
                }
                dri = (dri + 1)
            }
            if allColumns {
                dri = 0
                while (dri < (sel.rangeCount())) {
                    def dg2:GridRange (sel.rangeAt(dri))
                    push out.sourceCols dg2.c0
                    dri = (dri + 1)
                }
                r0 = minR
                r1 = maxR
                c0 = minC
                c1 = maxC
            }
        }
        out.r0 = r0
        out.c0 = c0
        out.r1 = r1
        out.c1 = c1
        out.sheet = book.activeIndex
        ; Headers are guessed the way a reader would: a top row of words over a
        ; column of numbers is a header, not data.
        def flag:[boolean]
        def lastSourceCol:int c1
        def firstSourceCol:int c0
        if ((array_length out.sourceCols) > 0) {
            firstSourceCol = (itemAt out.sourceCols 0)
            lastSourceCol = (itemAt out.sourceCols ((array_length out.sourceCols) - 1))
        }
        ChartData.asNumber((model.getCell(r0 lastSourceCol)) flag)
        def topIsText:boolean true
        if ((array_length flag) > 0) {
            topIsText = ((itemAt flag 0) == false)
        }
        out.useHeaderRow = false
        if (r1 > r0) {
            out.useHeaderRow = topIsText
        }
        ChartData.asNumber((model.getCell(r1 firstSourceCol)) flag)
        def leftIsText:boolean true
        if ((array_length flag) > 0) {
            leftIsText = ((itemAt flag 0) == false)
        }
        out.useHeaderCol = false
        if (c1 > c0) {
            out.useHeaderCol = leftIsText
        }
        ; And then the real question: what is this selection a chart OF? The
        ; rectangle reading above is the fallback — a grid of numbers with no
        ; headers still charts — but a TABLE gets read as one: which column is
        ; the category, which are the measures, and whether a repeated category
        ; means the rows should be added up.
        ChartInference.plan(model out)
    }

    ; What the grouping checkbox should say, which depends on what it would
    ; be grouping. "Add up repeated Regions" is a question anyone can answer;
    ; "aggregate" is not.
    fn groupLabel:string () {
        if (pendingChart.catCol < 0) {
            return "Combine repeated rows"
        }
        def name:string ""
        if pendingChart.useHeaderRow {
            name = (model.getCell(pendingChart.r0 pendingChart.catCol))
        }
        if ((strlen name) == 0) {
            return "Combine repeated rows"
        }
        return (("Combine repeated " + name) + " rows")
    }

    ; The functions the picker offers, in the order it offers them. "Don't" is
    ; first because it is the answer to a different question — whether to
    ; combine at all — and putting it beside the others is what makes that one
    ; row rather than a checkbox and a row.
    sfn aggCount:int () {
        return 6
    }

    sfn aggAt:string (i:int) {
        if (i == 0) { return "" }
        if (i == 1) { return "sum" }
        if (i == 2) { return "avg" }
        if (i == 3) { return "min" }
        if (i == 4) { return "max" }
        if (i == 5) { return "count" }
        return "sum"
    }

    ; Open the picker: on the current selection when `editId` is 0, on an
    ; existing chart otherwise.
    ; Ids: 100+kind for the type, 200+style for the look, 301/302 the header
    ; questions, 303 the legend, 311 the title field, 401..403 the buttons, and
    ; 500 the preview region.
    fn openChartDialog:void (editId:int) {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        chartEditId = editId
        if (editId > 0) {
            ; An existing chart's title is whatever it already has; the app
            ; does not get to rewrite it behind the reader.
            chartTitleIsOurs = false
        }
        if (editId > 0) {
            def p:ChartPanel (view.chartLayer.panelForChart(editId))
            if (p.chart.id != editId) {
                return
            }
            pendingChart.copyFrom(p.chart)
        } {
            def fresh:GridChart (new GridChart)
            this.selectionChart(fresh)
            pendingChart.copyFrom(fresh)
            chartTitleIsOurs = true
        }
        def probe:ChartData (new ChartData)
        def has:boolean (probe.extract(model pendingChart))
        if (editId == 0) {
            if has {
                ; A planned chart already chose its type from what the columns
                ; MEAN — a date is a line, two dimensions are a grouped bar.
                ; `suggestedKind` only knows the shape of the numbers, so it
                ; must not overrule it.
                if ((pendingChart.planned()) == false) {
                    pendingChart.kind = (probe.suggestedKind())
                }
            }
        }
        ; Never open on a choice that cannot be drawn.
        if has {
            if ((probe.suits(pendingChart.kind)) == false) {
                def k2:int (ChartKind.lowest())
                while (k2 <= (ChartKind.highest())) {
                    if (probe.suits(k2)) {
                        pendingChart.kind = k2
                        k2 = ((ChartKind.highest()) + 1)
                    } {
                        k2 = (k2 + 1)
                    }
                }
            }
        }
        this.layoutChartDialog(editId)
        def px:int (grid.x + (idiv (W - chartDialog.w) 2))
        def py:int (grid.y + 26)
        chartDialog.openWithin(px py W H)
        windows.raise(chartDialog)
        view.focused = true
    }

    ; Build the picker's controls. Called again whenever something changes, so
    ; the radio states and the preview stay in step — the panel is cheap to
    ; rebuild and there is then only one description of what it looks like.
    fn layoutChartDialog:void (editId:int) {
        def probe:ChartData (new ChartData)
        def has:boolean (probe.extract(model pendingChart))
        chartDialog.title = "Insert chart"
        if (editId > 0) {
            chartDialog.title = "Chart"
        }
        chartDialog.w = 720
        chartDialog.labelW = 44
        chartDialog.reset()
        ; The preview lives on the right. Bounding the FLOW keeps every radio,
        ; checkbox and field in the left column instead of being laid out
        ; underneath the picture, which is where they went before.
        chartDialog.flowW = 396
        chartDialog.addLabel(("Data: " + (pendingChart.rangeLabel()) + "   —   " + (to_string (probe.catCount())) + " rows x " + (to_string (probe.seriesCount())) + " series"))
        chartDialog.addSeparator()
        chartDialog.addLabel("Chart type")
        ; Twenty types in three columns: a single column would be taller than
        ; the window it has to fit in.
        chartDialog.beginColumns(3)
        def k:int (ChartKind.lowest())
        while (k <= (ChartKind.highest())) {
            def id:int (100 + k)
            chartDialog.addRadio(id (ChartKind.label(k)) 1 (k == pendingChart.kind))
            def c:EVGControl (chartDialog.controlById(id))
            def ok:boolean false
            if has {
                ok = (probe.suits(k))
            }
            c.enabled = ok
            if (ok == false) {
                c.checked = false
            }
            k = (k + 1)
        }
        chartDialog.endColumns()
        chartDialog.addSeparator()
        chartDialog.addLabel("Style")
        chartDialog.beginColumns(3)
        def st:int (ChartStyle.lowest())
        while (st <= (ChartStyle.highest())) {
            chartDialog.addRadio((200 + st) (ChartStyle.label(st)) 2 (st == pendingChart.style))
            st = (st + 1)
        }
        chartDialog.endColumns()
        chartDialog.addSeparator()
        chartDialog.addCheckbox(301 "First row names the columns" pendingChart.useHeaderRow)
        ; What the second question IS depends on how the selection was read.
        ; A planned chart already knows which column labels the rows — it says
        ; so in `catCol` — so asking again would be a checkbox that does
        ; nothing. What matters there is how rows that share a category are
        ; COMBINED, and that was being decided silently: a sum for quantities,
        ; an average for rates, and no way to see which had happened or to ask
        ; for the smallest, the largest, or how many.
        if (pendingChart.planned()) {
            chartDialog.addLabel((this.groupLabel()))
            def now:string (pendingChart.effectiveAgg())
            chartDialog.beginColumns(3)
            def ai:int 0
            while (ai < (GridApp.aggCount())) {
                def fn:string (GridApp.aggAt(ai))
                chartDialog.addRadio((320 + ai) (GridChart.aggLabel(fn)) 4 (fn == now))
                ai = (ai + 1)
            }
            chartDialog.endColumns()
        } {
            chartDialog.addCheckbox(302 "First column labels the rows" pendingChart.useHeaderCol)
        }
        chartDialog.addCheckbox(303 "Show legend" pendingChart.showLegend)
        chartDialog.addInput(311 "Title" pendingChart.title)
        def ids:[int]
        def labels:[string]
        if (editId > 0) {
            push ids 402
            push labels "Delete"
        }
        push ids 401
        push labels "Cancel"
        push ids 403
        if (editId > 0) {
            push labels "Apply"
        } {
            push labels "Create"
        }
        ; The preview sits BESIDE the options rather than under them — the list
        ; is long enough already, and a picture next to the choice that made it
        ; is the point of having one at all.
        def prevX:int 412
        def prevY:int 44
        ; Reserve the preview's own height in the flow BEFORE the buttons are
        ; placed. The button row is right-aligned across the whole panel, so a
        ; row laid out while the flow was still shorter than the preview would
        ; end up drawn on top of it.
        if (chartDialog.cursorY < (prevY + 236)) {
            chartDialog.cursorY = (prevY + 236)
        }
        chartDialog.addButtonRow(ids labels 403)
        chartDialog.finish()
        def prevW:int ((chartDialog.w - prevX) - chartDialog.padX)
        def prevH:int ((chartDialog.h - prevY) - 46)
        chartDialog.addContentAt(500 prevX prevY prevW prevH)
    }

    ; Read the picker's controls back into the pending chart. Runs every frame
    ; the dialog is up, which is what makes the preview live: clicking a radio
    ; changes the chart, and the chart is what the preview draws.
    fn syncChartDialog:void () {
        def chosen:int (chartDialog.selectedInGroup(1))
        if (chosen > 100) {
            pendingChart.kind = (chosen - 100)
        }
        def st:int (chartDialog.selectedInGroup(2))
        if (st > 200) {
            pendingChart.style = (st - 200)
        }
        def wantHeader:boolean (chartDialog.isChecked(301))
        if (wantHeader != pendingChart.useHeaderRow) {
            ; The header row decides what every column is CALLED, which decides
            ; which of them is the category and what the chart is titled. So
            ; changing it is not a flag to store — it is a reason to read the
            ; selection again.
            pendingChart.useHeaderRow = wantHeader
            if (pendingChart.planned()) {
                ChartInference.replan(model pendingChart wantHeader)
            }
        }
        if (pendingChart.planned()) {
            def picked:int (chartDialog.selectedInGroup(4))
            if (picked >= 320) {
                def fn:string (GridApp.aggAt((picked - 320)))
                if (fn != (pendingChart.effectiveAgg())) {
                    ; A chart with no measures is counting rows and cannot be
                    ; anything else: there is nothing to take the average of.
                    if ((array_length pendingChart.valueCols) == 0) {
                        pendingChart.agg = "count"
                    } {
                        pendingChart.agg = fn
                    }
                    ; The title said which question was being asked, so it has
                    ; to say the new one — unless the reader typed their own.
                    if (chartTitleIsOurs) {
                        ChartInference.retitle(model pendingChart)
                        chartDialog.setInputValue(311 pendingChart.title)
                    }
                }
            }
        } {
            pendingChart.useHeaderCol = (chartDialog.isChecked(302))
        }
        pendingChart.showLegend = (chartDialog.isChecked(303))
        def typed:string (chartDialog.inputValue(311))
        if (typed != pendingChart.title) {
            ; The box says something the app did not put there.
            chartTitleIsOurs = false
        }
        pendingChart.title = typed
    }

    ; The header checkboxes change which cells are data, which changes which
    ; kinds are possible — so the offered list has to be rebuilt, and a choice
    ; that has just become impossible has to move.
    fn refreshChartDialog:void () {
        def keepX:int chartDialog.x
        def keepY:int chartDialog.y
        def keepFocus:int chartDialog.focusedId
        def probe:ChartData (new ChartData)
        def has:boolean (probe.extract(model pendingChart))
        if has {
            if ((probe.suits(pendingChart.kind)) == false) {
                def k:int (ChartKind.lowest())
                while (k <= (ChartKind.highest())) {
                    if (probe.suits(k)) {
                        pendingChart.kind = k
                        k = ((ChartKind.highest()) + 1)
                    } {
                        k = (k + 1)
                    }
                }
            }
        }
        this.layoutChartDialog(chartEditId)
        chartDialog.x = keepX
        chartDialog.y = keepY
        chartDialog.focusedId = keepFocus
        chartDialog.visible = true
    }

    ; Read the picker back into the chart and put it on the sheet.
    fn applyChartDialog:void () {
        this.syncChartDialog()
        if (chartEditId > 0) {
            view.chartLayer.apply(chartEditId pendingChart)
        } {
            ; New charts cascade, so the second one is not hidden under the
            ; first.
            def step:int ((view.chartLayer.count()) % 5)
            pendingChart.x = ((grid.x + 96) + (step * 26))
            pendingChart.y = ((grid.y + 64) + (step * 22))
            if ((pendingChart.x + pendingChart.w) > W) {
                pendingChart.x = (W - (pendingChart.w + 12))
            }
            if (pendingChart.x < 4) {
                pendingChart.x = 4
            }
            view.chartLayer.add(windows pendingChart)
        }
        chartDialog.close()
        chartEditId = 0
    }

    ; A chart window's own buttons: the close box removes the chart, "Edit…"
    ; brings the picker back, "Copy" puts it on the clipboard. All three are
    ; collected before anything is removed, because removing rewrites the list
    ; being walked.
    fn pollChartWindows:void () {
        def layer:ChartLayer view.chartLayer
        def openEdit:int 0
        def closing:int 0
        def copying:int 0
        def i:int 0
        while (i < (layer.count())) {
            def p:ChartPanel (layer.panelAt(i))
            if (p.win.activated == (ChartLayer.editId())) {
                openEdit = p.chart.id
            }
            if (p.win.activated == (ChartLayer.closeId())) {
                closing = p.chart.id
            }
            if (p.win.activated == (ChartLayer.copyId())) {
                copying = p.chart.id
            }
            i = (i + 1)
        }
        if (copying > 0) {
            this.copyChart(copying)
        }
        if (closing > 0) {
            layer.remove(windows closing)
        }
        if (openEdit > 0) {
            this.openChartDialog(openEdit)
        }
    }

    ; --- the chart on the clipboard -------------------------------------------
    ; Copy a chart in every flavour Excel and Word paste: the bitmap, the same
    ; picture as vector, an HTML fragment carrying the bitmap as a data URI, and
    ; the numbers as TSV. What the host does with them is the host's business —
    ; a browser hands them to `navigator.clipboard`, a desktop shell registers
    ; them as clipboard formats — but the payload is decided here so every host
    ; offers the same thing.
    fn copyChart:int (id:int) {
        def panel:ChartPanel (view.chartLayer.panelForChart(id))
        if (panel.chart.id != id) {
            clipboardNote = "no such chart"
            return 0
        }
        def box:EVGControl (panel.win.contentControl())
        def bw:int box.w
        def bh:int box.h
        if (bw < 120) {
            bw = 320
        }
        if (bh < 90) {
            bh = 220
        }
        def clip:ChartClip (clipper.build(model panel.chart view.ctx.tr bw bh))
        if (clip.ok == false) {
            clipboardNote = clip.note
            return 0
        }
        ; The cell flavours are replaced rather than added to: what was copied
        ; last is what pastes, and a chart and a block of cells are not both on
        ; the clipboard at once.
        clipboardTsv = clip.tsv
        clipboardHtml = clip.html
        clipboardPng = clip.pngBase64
        clipboardSvg = clip.svg
        clipboardChartJson = clip.chartJson
        clipboardName = clip.name
        clipboardKind = "chart"
        clipboardNote = ""
        clipboardSeq = (clipboardSeq + 1)
        clipCut = false
        clear clipValues
        clear clipFormulas
        clear clipStyles
        clipRows = 0
        clipCols = 0
        return clip.w
    }

    ; The chart the keyboard would copy: the topmost chart window, when one is
    ; on top. Ctrl+C over the sheet still copies cells.
    fn focusedChartId:int () {
        def top:EVGWindow (windows.topmost())
        if (top.visible == false) {
            return 0
        }
        def i:int 0
        while (i < (view.chartLayer.count())) {
            def p:ChartPanel (view.chartLayer.panelAt(i))
            if (p.win.wid == top.wid) {
                return p.chart.id
            }
            i = (i + 1)
        }
        return 0
    }

    ; --- formatting -----------------------------------------------------------
    ; `format.*` over the selection. Merge is the odd one: it is a property of
    ; the range rather than of each cell's style, so it goes to the model.
    fn runFormatCommand:boolean (id:string arg:string) {
        if (id == "format.merge") {
            return (this.toggleMerge())
        }
        if (id == "format.size.up") {
            def up:boolean (GridFormat.apply(model sel "size" "1"))
            if up {
                this.fitSelectedRowsToContent(true)
            }
            return up
        }
        if (id == "format.size.down") {
            def down:boolean (GridFormat.apply(model sel "size" "-1"))
            if down {
                this.fitSelectedRowsToContent(true)
            }
            return down
        }
        if (id == "format.size.pick") {
            def stPick:CellStyle (model.getCellStyle(sel.active.row sel.active.col))
            def tip:ToolItem (view.toolbar.at(view.toolbar.hot))
            def mx:int tip.x
            def my:int ((tip.y + tip.h) + 2)
            if (view.toolbar.hot < 0) {
                mx = (grid.x + 120)
                my = ((grid.toolbarY()) + grid.toolbarH)
            }
            this.openFontSizeMenu(mx my)
            view.status = (("Size " + (to_string (to_int stPick.fontSizePt))) + " pt")
            return true
        }
        if (id == "format.size") {
            if ((strlen arg) == 0) {
                return (this.runFormatCommand("format.size.pick" ""))
            }
        }
        if (id == "format.font") {
            if ((strlen arg) == 0) {
                def tipF:ToolItem (view.toolbar.at(view.toolbar.hot))
                def mxF:int tipF.x
                def myF:int ((tipF.y + tipF.h) + 2)
                if (view.toolbar.hot < 0) {
                    mxF = (grid.x + 80)
                    myF = ((grid.toolbarY()) + grid.toolbarH)
                }
                this.openFontNameMenu(mxF myF)
                return true
            }
        }
        ; Empty arg opens the palette; a host that already knows the hex still
        ; applies it directly — same command string either way.
        if (id == "format.color") {
            if ((strlen arg) == 0) {
                def cur:CellStyle (model.getCellStyle(sel.active.row sel.active.col))
                this.openColorDialog("color" cur.textRgb)
                return true
            }
        }
        if (id == "format.border") {
            if ((strlen arg) == 0) {
                this.openBorderDialog()
                return true
            }
        }
        if (id == "format.fill") {
            if ((strlen arg) == 0) {
                def curF:CellStyle (model.getCellStyle(sel.active.row sel.active.col))
                def start:string curF.fillRgb
                if (curF.hasFill == false) {
                    start = ""
                }
                this.openColorDialog("fill" start)
                return true
            }
        }
        def op:string (substring id 7 (strlen id))
        if ((GridFormat.known(op)) == false) {
            return false
        }
        def done:boolean (GridFormat.apply(model sel op arg))
        if done {
            if (op == "size") {
                this.fitSelectedRowsToContent(true)
            } {
                this.growSelectedRowsToFit()
            }
            sheetView.markDirty()
            grid.updateVisible(model)
        }
        return done
    }

    ; Merge the selection, or take an existing merge apart when the caret is
    ; already inside one — the same button, as every spreadsheet does it.
    fn toggleMerge:boolean () {
        def existing:string (model.mergeAt(sel.active.row sel.active.col))
        if ((strlen existing) > 0) {
            model.removeMerge(sel.active.row sel.active.col)
            model.version = (model.version + 1)
            return true
        }
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        if ((a.row == b.row) && (a.col == b.col)) {
            return false
        }
        model.addMerge(a.row a.col b.row b.col)
        model.version = (model.version + 1)
        return true
    }

    ; --- the toolbar ----------------------------------------------------------
    ; A click on a button runs its command; hovering lights it up and puts its
    ; name in the status bar, which is this app's tooltip.
    fn toolbarHit:int (px:int py:int) {
        if (grid.toolbarH <= 0) {
            return -1
        }
        if (py < (grid.toolbarY())) {
            return -1
        }
        if (py >= ((grid.toolbarY()) + grid.toolbarH)) {
            return -1
        }
        return (view.toolbar.hit(px py))
    }

    fn runToolbarItem:boolean (i:int) {
        def t:ToolItem (view.toolbar.at(i))
        if ((strlen t.command) == 0) {
            return false
        }
        def ok:boolean (this.runCommand(t.command t.arg))
        if ok {
            view.status = t.label
        }
        return ok
    }

    ; Which custom tool button is under the pointer, or -1.
    fn toolButtonHit:int (px:int py:int) {
        def statusTop:int (grid.y + grid.h)
        def by:int (GridView.chartButtonY(statusTop))
        def bh:int (GridView.chartButtonH())
        if (py < by) {
            return -1
        }
        if (py >= (by + bh)) {
            return -1
        }
        def bw:int (GridView.toolButtonW())
        def i:int 0
        while (i < (commands.customCount())) {
            def bx:int (GridView.toolButtonX(W i))
            if (px >= bx) {
                if (px < (bx + bw)) {
                    return i
                }
            }
            i = (i + 1)
        }
        return -1
    }

    ; The status bar's "+ Chart" button.
    fn chartButtonHit:boolean (px:int py:int) {
        def statusTop:int (grid.y + grid.h)
        def bx:int (GridView.chartButtonX(W))
        def by:int (GridView.chartButtonY(statusTop))
        if (px < bx) {
            return false
        }
        if (py < by) {
            return false
        }
        def bw:int (GridView.chartButtonW())
        def bh:int (GridView.chartButtonH())
        if (px >= (bx + bw)) {
            return false
        }
        return (py < (by + bh))
    }

    ; --- find and replace -----------------------------------------------------
    ; What a search sees in a cell: the formula it was written as, or the value
    ; it shows.
    fn searchTextAt:string (m:SpreadsheetModel r:int c:int) {
        if findInFormulas {
            def f:string (m.getFormula(r c))
            if ((strlen f) > 0) {
                return f
            }
        }
        return (m.getCell(r c))
    }

    fn matchesText:boolean (hay:string) {
        if ((strlen findQuery) == 0) {
            return false
        }
        def a:string hay
        def b:string findQuery
        if (findMatchCase == false) {
            a = (FormulaFunctions.lower(a))
            b = (FormulaFunctions.lower(b))
        }
        if findWholeCell {
            return (a == b)
        }
        return (GridApp.indexOfSub(a b) >= 0)
    }

    sfn indexOfSub:int (hay:string needle:string) {
        def n:int (strlen needle)
        def m:int (strlen hay)
        if (n == 0) {
            return -1
        }
        def i:int 0
        while ((i + n) <= m) {
            if ((substring hay i (i + n)) == needle) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; Every occurrence in one string, replaced. Case-insensitively when the
    ; search is: the text that was there decides the case of what is left, so
    ; only the matched span is swapped.
    fn replacedText:string (hay:string) {
        def out:string ""
        def rest:string hay
        def needle:string findQuery
        def n:int (strlen needle)
        if (n == 0) {
            return hay
        }
        def guard:int 0
        while (guard < 4096) {
            def look:string rest
            def find:string needle
            if (findMatchCase == false) {
                look = (FormulaFunctions.lower(look))
                find = (FormulaFunctions.lower(find))
            }
            def at:int (GridApp.indexOfSub(look find))
            if (at < 0) {
                return (out + rest)
            }
            out = ((out + (substring rest 0 at)) + replaceWith)
            rest = (substring rest (at + n) (strlen rest))
            guard = (guard + 1)
        }
        return (out + rest)
    }

    ; The sheets a search covers, in order, starting with the active one.
    fn searchSheetCount:int () {
        if findAllSheets {
            return (book.sheetCount())
        }
        return 1
    }

    fn searchSheetAt:SpreadsheetModel (i:int) {
        if (findAllSheets == false) {
            return model
        }
        def n:int (book.sheetCount())
        def idx:int ((book.activeIndex + i) % n)
        return (book.sheetAt(idx))
    }

    fn searchSheetIndex:int (i:int) {
        if (findAllSheets == false) {
            return book.activeIndex
        }
        def n:int (book.sheetCount())
        return ((book.activeIndex + i) % n)
    }

    ; Walk from just after the active cell to the end, then wrap. Returns true
    ; when the selection landed on a match.
    fn findNext:boolean () {
        if ((strlen findQuery) == 0) {
            findStatus = "nothing to find"
            return false
        }
        def sheets:int (this.searchSheetCount())
        def si:int 0
        while (si < sheets) {
            def sheet:SpreadsheetModel (this.searchSheetAt(si))
            def startR:int 0
            def startC:int 0
            def skipFirst:boolean false
            if (si == 0) {
                startR = sel.active.row
                startC = sel.active.col
                skipFirst = true
            }
            def lastR:int (sheet.usedRow())
            def lastC:int (sheet.usedCol())
            def total:int ((lastR + 1) * (lastC + 1))
            if (total > 0) {
                def begin:int ((startR * (lastC + 1)) + startC)
                if skipFirst {
                    begin = (begin + 1)
                }
                def step:int 0
                while (step < total) {
                    def at:int ((begin + step) % total)
                    def r:int (idiv at (lastC + 1))
                    def c:int (at % (lastC + 1))
                    if (this.matchesText((this.searchTextAt(sheet r c)))) {
                        def target:int (this.searchSheetIndex(si))
                        if (target != book.activeIndex) {
                            this.setActiveSheet(target)
                        }
                        this.moveActive(r c false)
                        findStatus = ("found " + (SpreadsheetModel.cellLabel(r c)))
                        return true
                    }
                    step = (step + 1)
                }
            }
            si = (si + 1)
        }
        findStatus = ("no match for '" + findQuery + "'")
        return false
    }

    ; Replace in the active cell if it matches, then move on — Excel's Replace.
    fn replaceCurrent:boolean () {
        def r:int sel.active.row
        def c:int sel.active.col
        def before:string (this.searchTextAt(model r c))
        if ((this.matchesText(before)) == false) {
            return (this.findNext())
        }
        def after:string (this.replacedText(before))
        model.beginTx()
        this.writeSearchResult(model r c after)
        model.endTx()
        this.syncTouched()
        findStatus = ("replaced in " + (SpreadsheetModel.cellLabel(r c)))
        this.findNext()
        return true
    }

    ; A search hit is written back the way it was read: into the formula when
    ; the formula is what matched, into the value otherwise.
    fn writeSearchResult:void (m:SpreadsheetModel r:int c:int after:string) {
        def wasFormula:boolean false
        if findInFormulas {
            wasFormula = ((strlen (m.getFormula(r c))) > 0)
        }
        if wasFormula {
            m.applyEdit(r c (m.getCell(r c)) after)
        } {
            m.applyEdit(r c after "")
        }
    }

    fn replaceAll:int () {
        if ((strlen findQuery) == 0) {
            findStatus = "nothing to find"
            return 0
        }
        def count:int 0
        def sheets:int (this.searchSheetCount())
        def si:int 0
        model.beginTx()
        while (si < sheets) {
            def sheet:SpreadsheetModel (this.searchSheetAt(si))
            def lastR:int (sheet.usedRow())
            def lastC:int (sheet.usedCol())
            def r:int 0
            while (r <= lastR) {
                def c:int 0
                while (c <= lastC) {
                    def before:string (this.searchTextAt(sheet r c))
                    if (this.matchesText(before)) {
                        this.writeSearchResult(sheet r c (this.replacedText(before)))
                        count = (count + 1)
                    }
                    c = (c + 1)
                }
                r = (r + 1)
            }
            si = (si + 1)
        }
        model.endTx()
        this.syncTouched()
        engine.rebuildAll()
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
        findStatus = ((("replaced " + (to_string count)) + " of '") + findQuery + "'")
        return count
    }

    ; Ids: 501 find, 502 replace, 503..506 the options, 511..514 the buttons.
    fn openFindDialog:void () {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        findDialog.title = "Find and replace"
        findDialog.w = 380
        findDialog.labelW = 92
        findDialog.reset()
        findDialog.addInput(501 "Find" findQuery)
        findDialog.addInput(502 "Replace with" replaceWith)
        findDialog.addSeparator()
        findDialog.beginColumns(2)
        findDialog.addCheckbox(503 "Match case" findMatchCase)
        findDialog.addCheckbox(504 "Entire cell" findWholeCell)
        findDialog.addCheckbox(505 "Search formulas" findInFormulas)
        findDialog.addCheckbox(506 "All sheets" findAllSheets)
        findDialog.endColumns()
        if ((strlen findStatus) > 0) {
            findDialog.addLabel(findStatus)
        }
        def ids:[int]
        def labels:[string]
        push ids 511
        push labels "Close"
        push ids 512
        push labels "Replace all"
        push ids 513
        push labels "Replace"
        push ids 514
        push labels "Find next"
        findDialog.addButtonRow(ids labels 514)
        findDialog.finish()
        def px:int (grid.x + (idiv (W - findDialog.w) 2))
        def py:int (grid.y + 60)
        findDialog.openWithin(px py W H)
        windows.raise(findDialog)
        findDialog.focusedId = 501
        view.focused = true
    }

    ; Read the fields back, then rebuild the dialog so its status line shows
    ; what happened.
    fn syncFindDialog:void () {
        findQuery = (findDialog.inputValue(501))
        replaceWith = (findDialog.inputValue(502))
        findMatchCase = (findDialog.isChecked(503))
        findWholeCell = (findDialog.isChecked(504))
        findInFormulas = (findDialog.isChecked(505))
        findAllSheets = (findDialog.isChecked(506))
    }

    fn refreshFindDialog:void () {
        def keepX:int findDialog.x
        def keepY:int findDialog.y
        def keepFocus:int findDialog.focusedId
        this.openFindDialog()
        findDialog.x = keepX
        findDialog.y = keepY
        findDialog.focusedId = keepFocus
    }

    fn openPasteSpecial:void () {
        this.buildDialogs()
        ; Reflect the current default so the dialog opens on "All".
        pasteDialog.selectRadio(1)
        if (pasteMode == 1) {
            pasteDialog.selectRadio(2)
        }
        if (pasteMode == 2) {
            pasteDialog.selectRadio(3)
        }
        if (pasteMode == 3) {
            pasteDialog.selectRadio(4)
        }
        def px:int (grid.x + (idiv (W - pasteDialog.w) 2))
        def py:int (grid.y + 70)
        pasteDialog.openAt(px py)
        ; A dialog opened over a floating chart has to be in front of it.
        windows.raise(pasteDialog)
        view.focused = true
    }

    ; Route the frame through the window layer, then read what it produced.
    ;
    ; The return value is what the grid uses to decide whether the frame is
    ; still its own, and it is not the same question as "is a window open".
    ; A MODAL dialog owns everything until it closes. A floating chart owns
    ; only the pixels it covers: clicking the sheet beside it must still select
    ; a cell, or a chart would freeze the document it is a view of.
    fn updateDialogs:boolean (input:UIInput) {
        if ((windows.anyVisible()) == false) {
            return false
        }
        def blocking:boolean (windows.anyModalVisible())
        def consumed:boolean (windows.handlePointer(input.pointerX input.pointerY input.pointerPressed input.pointerDown input.pointerReleased))
        def ki:int 0
        def kn:int (input.keyCount())
        while (ki < kn) {
            windows.handleKey((input.keyAt(ki)) (UIKey.escape()) (UIKey.enter()))
            ki = (ki + 1)
        }
        ; While a modal dialog is up the keyboard is its own: typing goes into
        ; whatever field has focus, not into the sheet behind it.
        if blocking {
            if (input.ctrlDown == false) {
                if (input.hasText()) {
                    windows.handleText(input.textInput)
                }
            }
        }
        if (pasteDialog.activated == 10) {
            def chosen:int (pasteDialog.selectedInGroup(1))
            def mode:int 0
            if (chosen == 2) {
                mode = 1
            }
            if (chosen == 3) {
                mode = 2
            }
            if (chosen == 4) {
                mode = 3
            }
            pasteDialog.close()
            def prev:int pasteMode
            pasteMode = mode
            this.pasteClipboard()
            pasteMode = prev
        }
        if (pasteDialog.activated == 11) {
            pasteDialog.close()
        }
        ; The picker is live: whatever its controls say is what the pending
        ; chart is, every frame, and the preview draws the pending chart.
        if chartDialog.visible {
            def beforeHeaders:string ((to_string pendingChart.useHeaderRow) + (to_string pendingChart.useHeaderCol))
            this.syncChartDialog()
            def afterHeaders:string ((to_string pendingChart.useHeaderRow) + (to_string pendingChart.useHeaderCol))
            if (beforeHeaders != afterHeaders) {
                ; Which cells are data just changed, so which charts are
                ; possible changed with it.
                this.refreshChartDialog()
            }
            view.previewChart.copyFrom(pendingChart)
            view.previewChart.id = -1
            view.previewWid = chartDialog.wid
        } {
            view.previewWid = 0
        }
        if (chartDialog.activated == 403) {
            this.applyChartDialog()
        }
        if (chartDialog.activated == 401) {
            chartDialog.close()
            chartEditId = 0
        }
        if (chartDialog.activated == 402) {
            if (chartEditId > 0) {
                view.chartLayer.remove(windows chartEditId)
            }
            chartDialog.close()
            chartEditId = 0
        }
        if (findDialog.activated > 0) {
            this.syncFindDialog()
            if (findDialog.activated == 514) {
                this.findNext()
                this.refreshFindDialog()
            }
            if (findDialog.activated == 513) {
                this.replaceCurrent()
                this.refreshFindDialog()
            }
            if (findDialog.activated == 512) {
                this.replaceAll()
                this.refreshFindDialog()
            }
            if (findDialog.activated == 511) {
                findDialog.close()
            }
        }
        if (connDialog.activated > 0) {
            if (connDialog.activated == 733) {
                this.connectFromDialog()
            }
            if (connDialog.activated == 732) {
                this.refreshDatabaseSheet()
                dbConnStatus = db.status
                this.reopenConnectionDialog()
            }
            if (connDialog.activated == 731) {
                connDialog.close()
            }
        }
        if (sqlDialog.activated > 0) {
            if (sqlDialog.activated >= 741) {
                this.useExample((sqlDialog.activated - 741))
            }
            if (sqlDialog.activated == 712) {
                this.runSqlFromDialog()
            }
            if (sqlDialog.activated == 713) {
                this.newSheetFromDialog()
            }
            if (sqlDialog.activated == 711) {
                dbSqlText = (sqlDialog.inputValue(701))
                sqlDialog.close()
            }
        }
        if (cfDialog.activated > 0) {
            if (cfDialog.activated == 633) {
                this.addCfRuleFromDialog()
            }
            if (cfDialog.activated == 634) {
                this.addCfPosNegFromDialog()
            }
            if (cfDialog.activated == 632) {
                this.clearCfRulesFromDialog()
            }
            if (cfDialog.activated == 631) {
                cfDialog.close()
                cfStatus = ""
            }
        }
        if colorDialog.visible {
            if (colorDialog.activated >= 901) {
                if (colorDialog.activated < 990) {
                    this.refreshColorDialogSelection()
                }
            }
            if (colorDialog.activated == 992) {
                this.applyColorDialog()
            }
            if (colorDialog.activated == 991) {
                this.cancelColorDialog()
            }
            if (colorDialog.activated == 990) {
                this.clearFillFromColorDialog()
            }
        } {
            ; Escape / outside close while previewing — put the sheet back.
            if colorPreviewOn {
                if (colorPreviewCommitted == false) {
                    this.restoreColorSnapshot()
                }
                colorPreviewOn = false
                colorPreviewCommitted = false
                view.colorPreviewWid = 0
            }
        }
        if (renameDialog.activated > 0) {
            if (renameDialog.activated == 1292) {
                this.applyRenameDialog()
            }
            if (renameDialog.activated == 1291) {
                renameStatus = ""
                renameDialog.close()
            }
        }
        if borderDialog.visible {
            ; Live, like the chart picker: the preview draws whatever the
            ; controls say, so you can see a medium red box before you own one.
            this.syncBorderDialog()
            if (borderDialog.activated >= 1071) {
                if (borderDialog.activated <= 1073) {
                    this.presetBorderDialog(borderDialog.activated)
                }
            }
            if (borderDialog.activated == 1092) {
                this.applyBorderDialog()
            }
            if (borderDialog.activated == 1091) {
                this.cancelBorderDialog()
            }
        } {
            view.borderPreviewWid = 0
        }
        if (linkDialog.activated > 0) {
            if (linkDialog.activated == 813) {
                this.applyLinkDialog()
            }
            if (linkDialog.activated == 812) {
                model.clearHyperlink(sel.active.row sel.active.col)
                linkDialog.close()
            }
            if (linkDialog.activated == 811) {
                linkDialog.close()
            }
        }
        if (dvDialog.activated > 0) {
            if (dvDialog.activated == 743) {
                this.addValidationFromDialog()
            }
            if (dvDialog.activated == 742) {
                this.clearValidationsFromDialog()
            }
            if (dvDialog.activated == 741) {
                dvDialog.close()
                dvStatus = ""
            }
        }
        if (listDialog.activated > 0) {
            if (listDialog.activated == 892) {
                this.applyListPicker()
            }
            if (listDialog.activated == 891) {
                listDialog.close()
            }
        }
        this.pollChartWindows()
        ; Dragging and resizing happened inside the window layer; the charts
        ; keep their own geometry so it survives the window being rebuilt.
        view.chartLayer.syncGeometry()
        if blocking {
            return true
        }
        return consumed
    }

    fn resize:void (nw:int nh:int) {
        W = nw
        H = nh
        view.resize(W H)
        ; The strip is as many rows as the buttons need AT THIS WIDTH, and the
        ; width is what just changed. Measured once at startup and never again,
        ; the height was right only for the size the window opened at: narrow
        ; it and the buttons that no longer fit wrapped onto a row painted
        ; BELOW the strip, over the formula bar; widen it and a band of empty
        ; chrome sat where a row used to be.
        grid.toolbarH = (view.toolbar.heightFor(W))
        grid.setBounds(0 0 W (H - statusH))
        grid.updateVisible(model)
    }

    ; The engine is bound once at load. Per-edit code must NEVER call
    ; engine.attach() — attach clears depsOf / usedBy, which would silently stop
    ; every existing formula from tracking its inputs after the first edit.
    ; Instead: applyEdit → engine.syncCell(...) per cell → one recalcDirty().

    ; Re-register the formulas of every cell an undo / redo restored, then
    ; recalculate once.
    fn syncTouched:void () {
        engine.resetStats()
        def i:int 0
        def n:int (array_length model.touched)
        while (i < n) {
            def p:CellPos (itemAt model.touched i)
            engine.syncCell(book.activeIndex p.row p.col)
            i = (i + 1)
        }
        engine.recalcDirty()
    }

    ; Ctrl+Z / Ctrl+Y: undo or redo one whole action (paste and fill count as
    ; one), re-register the restored formulas, then recalculate.
    fn undoEdit:void () {
        if editing {
            this.cancelEdit()
        }
        model.structDirty = false
        def u:CellPos (model.undo())
        if model.structDirty {
            model.structDirty = false
            ; Op just moved to redoStack — restore cross-sheet formula text.
            def rn:int (array_length model.redoStack)
            if (rn > 0) {
                def op:SpreadsheetUndoOp (itemAt model.redoStack (rn - 1))
                this.restoreOtherSheetFormulas(op)
            }
            this.afterStructuralChange()
            return
        }
        this.syncTouched()
        this.afterCellMutation()
        this.moveActive(u.row u.col false)
    }

    fn redoEdit:void () {
        if editing {
            this.cancelEdit()
        }
        model.structDirty = false
        def r:CellPos (model.redo())
        if model.structDirty {
            model.structDirty = false
            ; Raw geometry replayed; formula text must be shifted again.
            def un:int (array_length model.undoStack)
            if (un > 0) {
                def op:SpreadsheetUndoOp (itemAt model.undoStack (un - 1))
                this.reapplyStructFormulaAdjust(op)
            }
            this.afterStructuralChange()
            return
        }
        this.syncTouched()
        this.afterCellMutation()
        this.moveActive(r.row r.col false)
    }

    fn commitEdit:void () {
        if (editing == false) {
            return
        }
        this.clearFormulaPick()
        def r:int sel.active.row
        def c:int sel.active.col
        ; A validation rule is asked BEFORE the value is written, because a
        ; refusal has to leave the cell as it was — not write and roll back,
        ; which would leave a dependent formula having seen the bad value.
        ; A formula is let through: what it evaluates to is not known yet, and
        ; Excel checks the typed text too.
        def rule:DataValidation (model.validationAt(r c))
        if ((strlen rule.kind) > 0) {
            def typed:string editBuf
            def isFormula:boolean false
            if ((strlen typed) > 0) {
                isFormula = ((charAt typed 0) == 61)
            }
            if (isFormula == false) {
                if ((rule.accepts(typed)) == false) {
                    validationError = ((SpreadsheetModel.cellLabel(r c)) + ": " + (rule.message()))
                    view.status = validationError
                    editing = false
                    editBuf = ""
                    editCaret = 0
                    return
                }
            }
        }
        validationError = ""
        model.beginTx()
        if ((strlen editBuf) > 0) {
            if ((charAt editBuf 0) == 61) {
                def expr:string (substring editBuf 1 (strlen editBuf))
                model.applyEditPlain(r c "" expr)
            } {
                ; A typed date becomes what a spreadsheet stores for one: the
                ; day count, wearing a format that draws it back the way it was
                ; typed. Nothing else in the app has to know about dates.
                def dateOk:[boolean]
                def serial:double (DateSerial.parseDate(editBuf dateOk))
                def isDate:boolean false
                if ((array_length dateOk) > 0) {
                    isDate = (itemAt dateOk 0)
                }
                if isDate {
                    def st:CellStyle ((model.getCellStyle(r c)).copy())
                    st.numFmt = (DateSerial.formatForTyped(editBuf))
                    model.clearRichText(r c)
                    model.applyEditStyled(r c (to_string (to_int serial)) "" st)
                } {
                    ; Plain value overwrites any prior formula — and the pieces
                    ; the old text was drawn in, which new text cannot belong to.
                    model.applyEditPlain(r c editBuf "")
                }
            }
        } {
            model.applyEdit(r c "" "")
        }
        model.endTx()
        engine.resetStats()
        engine.syncCell(book.activeIndex r c)
        engine.recalcDirty()
        ; Wrapped text that now needs a second line needs the room for it.
        this.growRowToFit(r)
        editSelAnchor = -1
        editing = false
        editBuf = ""
        editCaret = 0
        editInFormulaBar = false
        this.afterCellMutation()
        ; A database sheet gets the last word on its own cells: the edit is
        ; written back, or refused and undone, before anything reads the value
        ; that is now on screen.
        if (this.dbSheetActive()) {
            db.cellEdited(model r c)
            view.status = db.status
            engine.resetStats()
            engine.syncCell(book.activeIndex r c)
            engine.recalcDirty()
            grid.updateVisible(model)
        }
    }

    fn cancelEdit:void () {
        this.clearFormulaPick()
        editing = false
        editBuf = ""
        editCaret = 0
        editInFormulaBar = false
    }

    fn clearFormulaPick:void () {
        formulaPicking = false
        formulaRangeDrag = false
        formulaRangeStartedEdit = false
        pickTokStart = -1
        pickTokEnd = -1
        view.ghostVisible = false
    }

    ; Editing a formula that starts with `=`.
    fn isFormulaEdit:boolean () {
        if (editing == false) {
            return false
        }
        if ((strlen editBuf) == 0) {
            return false
        }
        return ((charAt editBuf 0) == 61)
    }

    ; Close dangling `(` so an in-progress edit like `=SUM(A1:A3` still parses
    ; enough for range highlights.
    sfn balanceFormulaParens:string (src:string) {
        def open:int 0
        def i:int 0
        def n:int (strlen src)
        def inStr:boolean false
        while (i < n) {
            def ch:int (charAt src i)
            if inStr {
                if (ch == 34) {
                    if (((i + 1) < n) && ((charAt src (i + 1)) == 34)) {
                        i = (i + 1)
                    } {
                        inStr = false
                    }
                }
            } {
                if (ch == 34) {
                    inStr = true
                } {
                    if (ch == 40) {
                        open = (open + 1)
                    }
                    if (ch == 41) {
                        if (open > 0) {
                            open = (open - 1)
                        }
                    }
                }
            }
            i = (i + 1)
        }
        def out:string src
        while (open > 0) {
            out = (out + ")")
            open = (open - 1)
        }
        return out
    }

    fn clearFormulaHilites:void () {
        clear view.formulaHiliteR0
        clear view.formulaHiliteC0
        clear view.formulaHiliteR1
        clear view.formulaHiliteC1
    }

    fn pushFormulaHilite:void (r0:int c0:int r1:int c1:int) {
        if ((array_length view.formulaHiliteR0) >= 12) {
            return
        }
        def a:int r0
        def b:int r1
        def c:int c0
        def d:int c1
        if (a > b) {
            def t:int a
            a = b
            b = t
        }
        if (c > d) {
            def t2:int c
            c = d
            d = t2
        }
        if (a < 0) {
            a = 0
        }
        if (c < 0) {
            c = 0
        }
        push view.formulaHiliteR0 a
        push view.formulaHiliteC0 c
        push view.formulaHiliteR1 b
        push view.formulaHiliteC1 d
    }

    ; Walk a formula AST and collect same-sheet cell / range rectangles.
    fn collectFormulaHilites:void (n:FormulaNode) {
        if (n.kind == 3) {
            def skip:boolean false
            if ((strlen n.sheet) > 0) {
                if (n.sheet != model.name) {
                    skip = true
                }
            }
            if (skip == false) {
                this.pushFormulaHilite(n.row n.col n.row n.col)
            }
            return
        }
        if (n.kind == 4) {
            def skip2:boolean false
            if ((strlen n.sheet) > 0) {
                if (n.sheet != model.name) {
                    skip2 = true
                }
            }
            if (skip2 == false) {
                this.pushFormulaHilite(n.row n.col n.row2 n.col2)
            }
            return
        }
        def i:int 0
        def kn:int (array_length n.kids)
        while (i < kn) {
            this.collectFormulaHilites((itemAt n.kids i))
            i = (i + 1)
        }
    }

    ; Excel-style coloured overlays for ranges named in the active formula —
    ; when the selected cell has one, or while that formula is being edited.
    fn refreshFormulaHilites:void () {
        this.clearFormulaHilites()
        def src:string ""
        if editing {
            if (this.isFormulaEdit()) {
                src = editBuf
            } {
                return
            }
        } {
            src = (model.formulaBarText(sel.active.row sel.active.col))
        }
        if ((strlen src) == 0) {
            return
        }
        if ((charAt src 0) != 61) {
            return
        }
        def balanced:string (GridApp.balanceFormulaParens(src))
        def p:FormulaParser (new FormulaParser)
        def ast:FormulaNode (p.parse(balanced))
        if (p.ok == false) {
            return
        }
        this.collectFormulaHilites(ast)
    }

    ; Byte span of the idx-th A1 / A1:B2 token in src, or -1/-1 if missing.
    fn formulaRefSpan:void (src:string idx:int startOut:[int] endOut:[int]) {
        clear startOut
        clear endOut
        def i:int 0
        def n:int (strlen src)
        def seen:int 0
        while (i < n) {
            def refLen:int (GridView.formulaRefLen(src i))
            if (refLen > 0) {
                if (seen == idx) {
                    push startOut i
                    push endOut (i + refLen)
                    return
                }
                seen = (seen + 1)
                i = (i + refLen)
            } {
                i = (i + 1)
            }
        }
        push startOut -1
        push endOut -1
    }

    fn replaceFormulaRefAt:void (idx:int label:string) {
        def src:string editBuf
        def startOut:[int]
        def endOut:[int]
        this.formulaRefSpan(src idx startOut endOut)
        def a:int (itemAt startOut 0)
        def b:int (itemAt endOut 0)
        if (a < 0) {
            return
        }
        def head:string (substring src 0 a)
        def tail:string (substring src b (strlen src))
        editBuf = ((head + label) + tail)
        editCaret = (a + (strlen label))
        pickTokStart = a
        pickTokEnd = editCaret
    }

    ; Ensure we are editing the active cell's formula before rewriting a range.
    fn ensureFormulaEditForRange:void () {
        if (this.isFormulaEdit()) {
            return
        }
        this.clearFormulaPick()
        ; clearFormulaPick resets this flag, so ownership is recorded after it.
        formulaRangeStartedEdit = true
        editBuf = (model.formulaBarText(sel.active.row sel.active.col))
        editing = true
        editInFormulaBar = true
        editCaret = (strlen editBuf)
        view.focused = true
    }

    ; Formula-range manipulation:
    ;   0 BR corner, 1 bottom, 2 right, 3 top, 4 left, 5 horizontal move,
    ;   6 TL corner, 7 TR corner, 8 BL corner; -1 means miss.
    fn hitFormulaRangeHandle:int (px:int py:int) {
        def hn:int (array_length view.formulaHiliteR0)
        def hi:int (hn - 1)
        while (hi >= 0) {
            def hr0:int (itemAt view.formulaHiliteR0 hi)
            def hc0:int (itemAt view.formulaHiliteC0 hi)
            def hr1:int (itemAt view.formulaHiliteR1 hi)
            def hc1:int (itemAt view.formulaHiliteC1 hi)
            def htl:GridRect (grid.cellRect(model hr0 hc0))
            def hbr:GridRect (grid.cellRect(model hr1 hc1))
            def hx:int htl.x
            def hy:int htl.y
            def hw:int ((hbr.x + hbr.w) - htl.x)
            def hh:int ((hbr.y + hbr.h) - htl.y)
            def pad:int 5
            ; Corners win over their adjacent edges.
            if ((px >= ((hx + hw) - pad)) && (px <= ((hx + hw) + pad))) {
                if ((py >= ((hy + hh) - pad)) && (py <= ((hy + hh) + pad))) {
                    formulaRangeIdx = hi
                    return 0
                }
            }
            if ((px >= (hx - pad)) && (px <= (hx + pad))) {
                if ((py >= (hy - pad)) && (py <= (hy + pad))) {
                    formulaRangeIdx = hi
                    return 6
                }
            }
            if ((px >= ((hx + hw) - pad)) && (px <= ((hx + hw) + pad))) {
                if ((py >= (hy - pad)) && (py <= (hy + pad))) {
                    formulaRangeIdx = hi
                    return 7
                }
            }
            if ((px >= (hx - pad)) && (px <= (hx + pad))) {
                if ((py >= ((hy + hh) - pad)) && (py <= ((hy + hh) + pad))) {
                    formulaRangeIdx = hi
                    return 8
                }
            }
            ; Bottom border, including its centre grip.
            if ((px >= (hx - pad)) && (px <= ((hx + hw) + pad))) {
                if ((py >= ((hy + hh) - pad)) && (py <= ((hy + hh) + pad))) {
                    formulaRangeIdx = hi
                    return 1
                }
            }
            ; Right border, including its centre grip.
            if ((px >= ((hx + hw) - pad)) && (px <= ((hx + hw) + pad))) {
                if ((py >= (hy - pad)) && (py <= ((hy + hh) + pad))) {
                    formulaRangeIdx = hi
                    return 2
                }
            }
            ; Top and left resize the starting edge.
            if ((px >= (hx - pad)) && (px <= ((hx + hw) + pad))) {
                if ((py >= (hy - pad)) && (py <= (hy + pad))) {
                    formulaRangeIdx = hi
                    return 3
                }
            }
            if ((px >= (hx - pad)) && (px <= (hx + pad))) {
                if ((py >= (hy - pad)) && (py <= ((hy + hh) + pad))) {
                    formulaRangeIdx = hi
                    return 4
                }
            }
            ; Dragging the tinted interior shifts the whole reference sideways.
            if ((px > (hx + pad)) && (px < ((hx + hw) - pad))) {
                if ((py > (hy + pad)) && (py < ((hy + hh) - pad))) {
                    formulaRangeIdx = hi
                    return 5
                }
            }
            hi = (hi - 1)
        }
        return -1
    }

    fn beginFormulaRangeDrag:void (edge:int grabCol:int) {
        formulaRangeStartedEdit = false
        this.ensureFormulaEditForRange()
        formulaRangeDrag = true
        formulaRangeEdge = edge
        formulaRangeFixR = (itemAt view.formulaHiliteR0 formulaRangeIdx)
        formulaRangeFixC = (itemAt view.formulaHiliteC0 formulaRangeIdx)
        formulaRangeFixR1 = (itemAt view.formulaHiliteR1 formulaRangeIdx)
        formulaRangeFixC1 = (itemAt view.formulaHiliteC1 formulaRangeIdx)
        formulaRangeGrabC = grabCol
        dragging = false
        filling = false
        formulaPicking = false
        view.focused = true
    }

    fn updateFormulaRangeDragAt:void (row:int col:int) {
        if (formulaRangeDrag == false) {
            return
        }
        def r0:int formulaRangeFixR
        def c0:int formulaRangeFixC
        def r1:int formulaRangeFixR1
        def c1:int formulaRangeFixC1
        if (formulaRangeEdge == 0) {
            r1 = row
            c1 = col
        }
        if (formulaRangeEdge == 1) {
            r1 = row
        }
        if (formulaRangeEdge == 2) {
            c1 = col
        }
        if (formulaRangeEdge == 3) {
            r0 = row
        }
        if (formulaRangeEdge == 4) {
            c0 = col
        }
        if (formulaRangeEdge == 5) {
            def dc:int (col - formulaRangeGrabC)
            c0 = (formulaRangeFixC + dc)
            c1 = (formulaRangeFixC1 + dc)
            if (c0 < 0) {
                c1 = (c1 - c0)
                c0 = 0
            }
        }
        if (formulaRangeEdge == 6) {
            r0 = row
            c0 = col
        }
        if (formulaRangeEdge == 7) {
            r0 = row
            c1 = col
        }
        if (formulaRangeEdge == 8) {
            r1 = row
            c0 = col
        }
        if (r1 < r0) {
            def t:int r0
            r0 = r1
            r1 = t
        }
        if (c1 < c0) {
            def t2:int c0
            c0 = c1
            c1 = t2
        }
        def label:string (GridApp.rangeA1(r0 c0 r1 c1))
        this.replaceFormulaRefAt(formulaRangeIdx label)
        this.refreshFormulaHilites()
    }

    sfn rangeA1:string (r0:int c0:int r1:int c1:int) {
        def a:int r0
        def b:int r1
        def c:int c0
        def d:int c1
        if (a > b) {
            def t:int a
            a = b
            b = t
        }
        if (c > d) {
            def t2:int c
            c = d
            d = t2
        }
        def left:string (SpreadsheetModel.cellLabel(a c))
        if ((a == b) && (c == d)) {
            return left
        }
        return ((left + ":") + (SpreadsheetModel.cellLabel(b d)))
    }

    fn showPickGhost:void () {
        def a:int pickR0
        def b:int pickR1
        def c:int pickC0
        def d:int pickC1
        if (a > b) {
            def t:int a
            a = b
            b = t
        }
        if (c > d) {
            def t2:int c
            c = d
            d = t2
        }
        view.ghostVisible = true
        view.ghostR0 = a
        view.ghostC0 = c
        view.ghostR1 = b
        view.ghostC1 = d
    }

    ; Write (or replace) the A1 / A1:B2 token for the current pick into editBuf.
    fn applyPickToFormula:void () {
        def label:string (GridApp.rangeA1(pickR0 pickC0 pickR1 pickC1))
        if (pickTokStart < 0) {
            this.insertAtCaret(label)
            pickTokEnd = editCaret
            pickTokStart = (editCaret - (strlen label))
            return
        }
        def n:int (strlen editBuf)
        if (pickTokStart > n) {
            pickTokStart = n
        }
        if (pickTokEnd > n) {
            pickTokEnd = n
        }
        if (pickTokEnd < pickTokStart) {
            pickTokEnd = pickTokStart
        }
        def head:string (substring editBuf 0 pickTokStart)
        def tail:string (substring editBuf pickTokEnd n)
        editBuf = ((head + label) + tail)
        pickTokEnd = (pickTokStart + (strlen label))
        editCaret = pickTokEnd
    }

    ; Whether a character can be the one BEFORE a reference.
    ;
    ; A reference can begin after `=`, after an opening bracket, after an
    ; argument separator, or after an operator — and nowhere else. In
    ; particular not after a closing bracket, a digit or a letter, because
    ; there is nothing a reference could mean there.
    sfn startsReference:boolean (ch:int) {
        if (ch == 61) {
            return true
        }
        if (ch == 40) {
            return true
        }
        if (ch == 123) {
            return true
        }
        if (ch == 44) {
            return true
        }
        if (ch == 59) {
            return true
        }
        if (ch == 58) {
            return true
        }
        if (ch == 43) {
            return true
        }
        if (ch == 45) {
            return true
        }
        if (ch == 42) {
            return true
        }
        if (ch == 47) {
            return true
        }
        if (ch == 94) {
            return true
        }
        if (ch == 38) {
            return true
        }
        if (ch == 60) {
            return true
        }
        if (ch == 62) {
            return true
        }
        return false
    }

    ; Would a click on a cell insert a reference here?
    ;
    ; Excel calls this "point mode", and it is on only where a reference could
    ; legally begin. Anywhere else a click means what a click means everywhere
    ; else in a spreadsheet: finish this edit and select what was clicked.
    ; Without the distinction, clicking around after `=SUM(F2:F14)` appended
    ; references to a finished formula and produced `=SUM(F2:F14)F19`, which
    ; is not a formula at all — and which the engine then had to reject.
    fn canPickAtCaret:boolean () {
        if ((this.isFormulaEdit()) == false) {
            return false
        }
        this.clampCaret()
        ; A reference just picked stays replaceable: clicking again after
        ; dragging a range out replaces it rather than ending the edit.
        if (pickTokStart >= 0) {
            if (pickTokEnd == editCaret) {
                return true
            }
        }
        def i:int editCaret
        while (i > 0) {
            def ch:int (charAt editBuf (i - 1))
            if (ch == 32) {
                i = (i - 1)
                continue
            }
            return (GridApp.startsReference(ch))
        }
        return false
    }

    fn beginFormulaPickAt:void (row:int col:int) {
        ; A fresh click with the caret still on the last pick replaces it;
        ; otherwise insert at the caret (type a comma first for another arg).
        if (pickTokEnd != editCaret) {
            pickTokStart = -1
            pickTokEnd = -1
        }
        formulaPicking = true
        pickR0 = row
        pickC0 = col
        pickR1 = row
        pickC1 = col
        this.applyPickToFormula()
        this.showPickGhost()
    }

    fn updateFormulaPickAt:void (row:int col:int) {
        pickR1 = row
        pickC1 = col
        this.applyPickToFormula()
        this.showPickGhost()
    }

    fn beginEdit:void (seed:string clearFirst:boolean) {
        editSelAnchor = -1
        this.clearFormulaPick()
        if clearFirst {
            editBuf = seed
            editInFormulaBar = false
        } {
            if (editing == false) {
                editBuf = (model.formulaBarText(sel.active.row sel.active.col))
                editInFormulaBar = false
            }
            if ((strlen seed) > 0) {
                editBuf = (editBuf + seed)
            }
        }
        editing = true
        editCaret = (strlen editBuf)
    }

    fn beginFormulaBarEdit:void () {
        if (editing == false) {
            this.clearFormulaPick()
            editBuf = (model.formulaBarText(sel.active.row sel.active.col))
            editCaret = (strlen editBuf)
        }
        editing = true
        editInFormulaBar = true
        view.focused = true
    }

    ; Place the caret from a pointer x inside the formula field.
    fn caretIndexAtFormulaBarX:int (px:int) {
        def text:string editBuf
        if (editing == false) {
            text = (model.formulaBarText(sel.active.row sel.active.col))
        }
        def local:int (px - view.fbTextX)
        if (local <= 0) {
            return 0
        }
        def n:int (strlen text)
        def best:int n
        def i:int 0
        while (i <= n) {
            def prefix:string (substring text 0 i)
            def w:int (to_int (view.ctx.tr.measureWidth(prefix view.fbFontSize)))
            if (w >= local) {
                ; Pick the closer of i and i-1.
                if (i == 0) {
                    return 0
                }
                def prev:string (substring text 0 (i - 1))
                def pw:int (to_int (view.ctx.tr.measureWidth(prev view.fbFontSize)))
                def d0:int (local - pw)
                def d1:int (w - local)
                if (d0 <= d1) {
                    return (i - 1)
                }
                return i
            }
            best = i
            i = (i + 1)
        }
        return best
    }

    fn beginFormulaBarEditAt:void (px:int) {
        this.beginFormulaBarEdit()
        ; Mirror the formula-bar layout from GridView so a click works even
        ; before the next paint stores fbTextX.
        def addrBoxW:int 64
        def fieldX:int ((grid.x + addrBoxW) + 10)
        view.fbTextX = (fieldX + 6)
        view.fbFontSize = 13.0
        editCaret = (this.caretIndexAtFormulaBarX(px))
        this.clampCaret()
    }

    ; --- in-cell edit buffer: caret-relative editing --------------------------
    fn clampCaret:void () {
        def n:int (strlen editBuf)
        if (editCaret < 0) {
            editCaret = 0
        }
        if (editCaret > n) {
            editCaret = n
        }
    }

    ; --- selected text inside whatever is being edited -----------------------
    ;
    ; The keyboard belongs to somebody. While an edit is open that somebody is
    ; the text field — the formula bar or the cell — and Ctrl+A means "all of
    ; this text", not "all of this sheet". While no edit is open the grid has
    ; it and Ctrl+A means the sheet. That is the whole of the focus question
    ; here, and answering it is what let the fields keep their own shortcuts.
    ;
    ; `editSelAnchor` is where a selection started, or -1 for none; the caret
    ; is the other end, so a selection is the span between them and shift plus
    ; any caret move extends it.
    ; Ctrl+C / Ctrl+X inside a field. The text goes on the same clipboard the
    ; sheet uses, so it can be pasted into a cell, into another field, or out
    ; of the program entirely.
    fn copyTextSelection:void (cut:boolean) {
        def taken:string (this.selectedText())
        if ((strlen taken) == 0) {
            return
        }
        clipboardKind = "text"
        clipboardTsv = taken
        clipboardSeq = (clipboardSeq + 1)
        clipboardPng = ""
        clipboardSvg = ""
        clipboardChartJson = ""
        view.status = "copied"
        if cut {
            this.deleteTextSelection()
            view.status = "cut"
        }
    }

    ; Ctrl+V inside a field: whatever text is on the clipboard, over whatever
    ; is selected. A tab or a newline would end the edit rather than land in
    ; it, so they become spaces.
    fn pasteIntoField:void () {
        def text:string clipboardTsv
        if ((strlen text) == 0) {
            return
        }
        def flat:string ""
        def i:int 0
        while (i < (strlen text)) {
            def ch2:int (charAt text i)
            if ((ch2 == 9) || (ch2 == 10)) {
                flat = (flat + " ")
            } {
                if (ch2 != 13) {
                    flat = (flat + (substring text i (i + 1)))
                }
            }
            i = (i + 1)
        }
        this.insertAtCaret(flat)
    }

    fn hasTextSelection:boolean () {
        if (editing == false) {
            return false
        }
        if (editSelAnchor < 0) {
            return false
        }
        return (editSelAnchor != editCaret)
    }

    fn selectionStart:int () {
        if ((this.hasTextSelection()) == false) {
            return editCaret
        }
        if (editSelAnchor < editCaret) {
            return editSelAnchor
        }
        return editCaret
    }

    fn selectionEnd:int () {
        if ((this.hasTextSelection()) == false) {
            return editCaret
        }
        if (editSelAnchor > editCaret) {
            return editSelAnchor
        }
        return editCaret
    }

    fn selectedText:string () {
        if ((this.hasTextSelection()) == false) {
            return ""
        }
        return (substring editBuf (this.selectionStart()) (this.selectionEnd()))
    }

    fn selectAllText:void () {
        editSelAnchor = 0
        editCaret = (strlen editBuf)
    }

    fn clearTextSelection:void () {
        editSelAnchor = -1
    }

    ; Take the selected text out, leaving the caret where it was. Every insert
    ; and every delete goes through here first, which is what makes typing
    ; over a selection replace it rather than push it along.
    fn deleteTextSelection:boolean () {
        if ((this.hasTextSelection()) == false) {
            return false
        }
        def a:int (this.selectionStart())
        def b:int (this.selectionEnd())
        def head:string (substring editBuf 0 a)
        def tail:string (substring editBuf b (strlen editBuf))
        editBuf = (head + tail)
        editCaret = a
        editSelAnchor = -1
        pickTokStart = -1
        pickTokEnd = -1
        return true
    }

    ; Move the caret, taking the selection with it or dropping it.
    fn caretTo:void (at:int extend:boolean) {
        if extend {
            if (editSelAnchor < 0) {
                editSelAnchor = editCaret
            }
        } {
            editSelAnchor = -1
        }
        editCaret = at
        this.clampCaret()
        pickTokStart = -1
        pickTokEnd = -1
    }

    fn insertAtCaret:void (text:string) {
        this.deleteTextSelection()
        this.clampCaret()
        ; Typing (or any non-pick insert) ends the replaceable pick token.
        if (formulaPicking == false) {
            pickTokStart = -1
            pickTokEnd = -1
        }
        def n:int (strlen editBuf)
        def head:string (substring editBuf 0 editCaret)
        def tail:string (substring editBuf editCaret n)
        editBuf = ((head + text) + tail)
        editCaret = (editCaret + (strlen text))
    }

    fn backspaceAtCaret:void () {
        if (this.deleteTextSelection()) {
            return
        }
        this.clampCaret()
        if (editCaret <= 0) {
            return
        }
        pickTokStart = -1
        pickTokEnd = -1
        def n:int (strlen editBuf)
        def head:string (substring editBuf 0 (editCaret - 1))
        def tail:string (substring editBuf editCaret n)
        editBuf = (head + tail)
        editCaret = (editCaret - 1)
    }

    fn deleteAtCaret:void () {
        if (this.deleteTextSelection()) {
            return
        }
        this.clampCaret()
        def n:int (strlen editBuf)
        if (editCaret >= n) {
            return
        }
        pickTokStart = -1
        pickTokEnd = -1
        def head:string (substring editBuf 0 editCaret)
        def tail:string (substring editBuf (editCaret + 1) n)
        editBuf = (head + tail)
    }

    fn moveCaret:void (delta:int) {
        editCaret = (editCaret + delta)
        this.clampCaret()
        pickTokStart = -1
        pickTokEnd = -1
    }

    ; --- used range ----------------------------------------------------------
    ; Excel bounds Ctrl+End / End at the last cell that holds data, not at the
    ; declared sheet size. SpreadsheetModel tracks that corner as cells are
    ; written, so this stays O(1) even on the 100k-row fixture.
    fn lastUsedColInRow:int (row:int) {
        def c:int (model.usedCol())
        while (c >= 0) {
            if ((strlen (model.getCell(row c))) > 0) {
                return c
            }
            c = (c - 1)
        }
        return 0
    }

    ; Ctrl+Arrow: jump to the edge of the current data block.
    ;   in data, neighbour filled  → last filled cell of the run
    ;   in data, neighbour empty   → next filled cell, else the sheet edge
    ;   on a blank cell            → next filled cell, else the sheet edge
    fn edgeJump:CellPos (row:int col:int dr:int dc:int) {
        def maxR:int (model.rowCount - 1)
        def maxC:int (model.colCount - 1)
        def r:int row
        def c:int col
        def nr:int (r + dr)
        def nc:int (c + dc)
        if ((nr < 0) || (nr > maxR) || (nc < 0) || (nc > maxC)) {
            return (CellPos.create(r c))
        }
        def hereFilled:boolean ((strlen (model.getCell(r c))) > 0)
        def nextFilled:boolean ((strlen (model.getCell(nr nc))) > 0)
        def runMode:boolean false
        if (hereFilled && nextFilled) {
            runMode = true
        }
        def more:boolean true
        while more {
            def tr:int (r + dr)
            def tc:int (c + dc)
            if ((tr < 0) || (tr > maxR) || (tc < 0) || (tc > maxC)) {
                more = false
            } {
                def filled:boolean ((strlen (model.getCell(tr tc))) > 0)
                if runMode {
                    if filled {
                        r = tr
                        c = tc
                    } {
                        more = false
                    }
                } {
                    r = tr
                    c = tc
                    if filled {
                        more = false
                    }
                }
            }
        }
        return (CellPos.create(r c))
    }

    fn lastContentRowInColumn:int (col:int) {
        def r:int (model.rowCount - 1)
        while (r > 0) {
            def hasValue:boolean ((strlen (model.getCell(r col))) > 0)
            if (hasValue == false) {
                hasValue = ((strlen (model.getFormula(r col))) > 0)
            }
            if hasValue {
                return r
            }
            r = (r - 1)
        }
        return 0
    }

    ; Header-click selection stops at the last value instead of selecting a
    ; million empty spreadsheet rows. Ctrl keeps earlier column rectangles.
    fn selectDataColumn:void (col:int additive:boolean) {
        if additive {
            sel.keepCurrent()
        } {
            sel.clearExtra()
        }
        def last:int (this.lastContentRowInColumn(col))
        sel.anchor.row = last
        sel.anchor.col = col
        sel.active.row = 0
        sel.active.col = col
        grid.ensureCellVisible(model 0 col)
        this.refreshFormulaHilites()
    }

    ; Keyboard Ctrl+Space retains Excel's full-column band semantics.
    ; The far end is the anchor so the active cell stays at the top / left.
    fn selectColumn:void (col:int) {
        sel.clearExtra()
        sel.anchor.row = (model.rowCount - 1)
        sel.anchor.col = col
        sel.active.row = 0
        sel.active.col = col
        grid.ensureCellVisible(model 0 col)
    }

    fn selectRow:void (row:int) {
        sel.anchor.row = row
        sel.anchor.col = (model.colCount - 1)
        sel.active.row = row
        sel.active.col = 0
        grid.ensureCellVisible(model row 0)
    }

    ; Rows a PageUp / PageDown step covers: one viewport minus one row of
    ; overlap, so the cell you were reading stays on screen.
    fn pageRows:int () {
        def n:int ((grid.lastScrollRow - grid.firstScrollRow) + 1)
        if (n < 1) {
            n = 1
        }
        if (n > 1) {
            n = (n - 1)
        }
        return n
    }

    ; Excel's grid has no edge you can walk off: pressing Down on the last row
    ; gives you a new one. A loaded sheet is only as big as its used range, so
    ; grow it as the caret (or a paste) reaches the end. Bounded by Excel's own
    ; limits so a runaway cannot allocate without end.
    fn ensureExtent:void (row:int col:int) {
        def rows:int (row + 1)
        def cols:int (col + 1)
        if (rows > 1048576) {
            rows = 1048576
        }
        if (cols > 16384) {
            cols = 16384
        }
        if ((rows <= model.rowCount) && (cols <= model.colCount)) {
            return
        }
        model.growTo(rows cols)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    ; Keep the sheet at least as big as the window can show.
    ;
    ; A sheet comes out of a file only as big as its USED range, so the grid
    ; stopped where the numbers stopped and the space to the right of it
    ; belonged to no cell at all — nothing to click, nothing to select. The
    ; arrow keys hid it, because `ensureExtent` grows the sheet as the caret
    ; walks; so the keyboard could reach places the mouse could not, which is
    ; the shape the report took.
    ;
    ; Excel and Sheets both show a sheet that carries on past its content.
    ; This keeps enough empty rows and columns to cover what is on screen, and
    ; does nothing at all once they are there — which is every frame but the
    ; few after a load, a resize or a scroll. `usedRow` / `usedCol` are about
    ; CONTENT, so nothing here widens what gets saved.
    fn ensureViewportFilled:void () {
        def needW:int (grid.scrollX + (grid.viewportW()))
        def needH:int (grid.scrollY + (grid.viewportH()))
        def haveW:int (grid.geoTotalW(model))
        def haveH:int (grid.geoTotalH(model))
        def cols:int model.colCount
        def rows:int model.rowCount
        if (haveW < needW) {
            def missW:int (needW - haveW)
            def stepW:int model.defaultColW
            if (stepW < 8) {
                stepW = 8
            }
            cols = ((cols + (idiv missW stepW)) + 2)
        }
        if (haveH < needH) {
            def missH:int (needH - haveH)
            def stepH:int model.defaultRowH
            if (stepH < 8) {
                stepH = 8
            }
            rows = ((rows + (idiv missH stepH)) + 2)
        }
        if (cols > 16384) {
            cols = 16384
        }
        if (rows > 1048576) {
            rows = 1048576
        }
        if ((cols == model.colCount) && (rows == model.rowCount)) {
            return
        }
        model.growTo(rows cols)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    fn moveActive:void (row:int col:int extend:boolean) {
        ; The caret going somewhere is a deliberate move; it wins over a coast.
        this.stopFling()
        if editing {
            this.commitEdit()
        }
        if (row >= 0) {
            if (col >= 0) {
                this.ensureExtent(row col)
            }
        }
        def p:CellPos (CellPos.create(row col))
        model.clampPos(p)
        sel.setActive(p.row p.col)
        if (extend == false) {
            sel.collapseToActive()
        }
        grid.ensureCellVisible(model p.row p.col)
        ; Do not leave the previous cell's formula overlay around for one frame.
        ; Its border and its hit target must change atomically with the cell.
        this.refreshFormulaHilites()
    }

    fn handleKey:void (key:int input:UIInput) {
        def extend:boolean input.shiftDown
        if editing {
            if (key == (UIKey.enter())) {
                this.commitEdit()
                if extend {
                    this.moveActive((sel.active.row - 1) sel.active.col false)
                } {
                    this.moveActive((sel.active.row + 1) sel.active.col false)
                }
                return
            }
            if (key == (UIKey.tab())) {
                this.commitEdit()
                if extend {
                    this.moveActive(sel.active.row (sel.active.col - 1) false)
                } {
                    this.moveActive(sel.active.row (sel.active.col + 1) false)
                }
                return
            }
            if (key == (UIKey.escape())) {
                this.cancelEdit()
                return
            }
            if (key == (UIKey.backspace())) {
                this.backspaceAtCaret()
                return
            }
            if (key == (UIKey.del())) {
                this.deleteAtCaret()
                return
            }
            ; Shift with any caret move extends the selection, which is what
            ; every text field on every platform does and what this had no
            ; answer for at all.
            if (key == (UIKey.left())) {
                this.caretTo((editCaret - 1) extend)
                return
            }
            if (key == (UIKey.right())) {
                this.caretTo((editCaret + 1) extend)
                return
            }
            if (key == (UIKey.home())) {
                this.caretTo(0 extend)
                return
            }
            if (key == (UIKey.end())) {
                this.caretTo((strlen editBuf) extend)
                return
            }
            return
        }
        def ctrl:boolean input.ctrlDown
        if (key == (UIKey.left())) {
            this.arrowKey(0 -1 ctrl extend)
            return
        }
        if (key == (UIKey.right())) {
            this.arrowKey(0 1 ctrl extend)
            return
        }
        if (key == (UIKey.up())) {
            this.arrowKey(-1 0 ctrl extend)
            return
        }
        if (key == (UIKey.down())) {
            this.arrowKey(1 0 ctrl extend)
            return
        }
        if (key == (UIKey.pageUp())) {
            this.moveActive((sel.active.row - (this.pageRows())) sel.active.col extend)
            return
        }
        if (key == (UIKey.pageDown())) {
            this.moveActive((sel.active.row + (this.pageRows())) sel.active.col extend)
            return
        }
        ; Excel: Enter steps down (Shift+Enter up); F2 opens the cell for edit.
        if (key == (UIKey.enter())) {
            if extend {
                this.moveActive((sel.active.row - 1) sel.active.col false)
            } {
                this.moveActive((sel.active.row + 1) sel.active.col false)
            }
            return
        }
        if (key == (UIKey.f2())) {
            this.beginEdit("" false)
            return
        }
        if (key == (UIKey.tab())) {
            if extend {
                this.moveActive(sel.active.row (sel.active.col - 1) false)
            } {
                this.moveActive(sel.active.row (sel.active.col + 1) false)
            }
            return
        }
        if (key == (UIKey.del())) {
            this.clearSelection()
            return
        }
        if (key == (UIKey.backspace())) {
            this.beginEdit("" true)
            return
        }
        if (key == (UIKey.home())) {
            if ctrl {
                this.moveActive(0 0 extend)
            } {
                this.moveActive(sel.active.row 0 extend)
            }
            return
        }
        if (key == (UIKey.end())) {
            if ctrl {
                this.moveActive((model.usedRow()) (model.usedCol()) extend)
            } {
                this.moveActive(sel.active.row (this.lastUsedColInRow(sel.active.row)) extend)
            }
            return
        }
        if (key == (UIKey.escape())) {
            sel.collapseToActive()
            return
        }
    }

    ; Arrow navigation. Ctrl jumps to the edge of the data block, Shift extends
    ; the selection, Ctrl+Shift does both.
    fn arrowKey:void (dr:int dc:int ctrl:boolean extend:boolean) {
        if ctrl {
            def p:CellPos (this.edgeJump(sel.active.row sel.active.col dr dc))
            this.moveActive(p.row p.col extend)
            return
        }
        this.moveActive((sel.active.row + dr) (sel.active.col + dc) extend)
    }

    ; Runs, not characters — and a string with nothing to escape is returned
    ; as itself rather than rebuilt one character at a time.
    sfn htmlEscape:string (v:string) {
        def out:string ""
        def i:int 0
        def run:int 0
        def n:int (strlen v)
        while (i < n) {
            def c:int (charAt v i)
            def rep:string ""
            if (c == 38) {
                rep = "&amp;"
            } {
                if (c == 60) {
                    rep = "&lt;"
                } {
                    if (c == 62) {
                        rep = "&gt;"
                    } {
                        if (c == 34) {
                            rep = "&quot;"
                        }
                    }
                }
            }
            if ((strlen rep) > 0) {
                if (i > run) {
                    str_append out (substring v run i)
                }
                str_append out rep
                run = (i + 1)
            }
            i = (i + 1)
        }
        if (run == 0) {
            return v
        }
        if (n > run) {
            str_append out (substring v run n)
        }
        return out
    }

    ; CellStyle colours already carry a leading "#" when they come from
    ; styles.xml; normalize either form to a CSS colour, or "" if unusable.
    sfn cssColor:string (v:string) {
        def s:string v
        if ((strlen s) == 0) {
            return ""
        }
        if ((charAt s 0) == 35) {
            s = (substring s 1 (strlen s))
        }
        if ((strlen s) != 6) {
            return ""
        }
        return ("#" + s)
    }

    ; One <td>, carrying the bits of cell style a word processor can honour.
    fn cellHtml:string (r:int c:int) {
        def st:CellStyle (model.getCellStyle(r c))
        def style:string ""
        if st.hasFill {
            def bg:string (GridApp.cssColor(st.fillRgb))
            if ((strlen bg) > 0) {
                style = (style + "background-color:" + bg + ";")
            }
        }
        def fg:string (GridApp.cssColor(st.textRgb))
        if ((strlen fg) > 0) {
            style = (style + "color:" + fg + ";")
        }
        if st.bold {
            style = (style + "font-weight:bold;")
        }
        if (st.align != "left") {
            style = (style + "text-align:" + st.align + ";")
        }
        def open:string "<td"
        if ((strlen style) > 0) {
            open = (open + " style=\"" + style + "\"")
        }
        open = (open + ">")
        def body:string (GridApp.htmlEscape((model.getCell(r c))))
        if ((strlen body) == 0) {
            body = "&nbsp;"
        }
        return ((open + body) + "</td>")
    }

    ; Excel-style clipboard. Three representations are kept:
    ;   * clipboardTsv     — flat text, what a host would put on the OS clipboard
    ;   * clipboardHtml    — an HTML <table>, the flavour Word/Excel paste as a
    ;     real table (Excel puts the same two flavours on the clipboard)
    ;   * clipValues/Formulas + clipR0/clipC0 — structured block, so paste can
    ;     translate relative refs the way Excel copy/paste does.
    fn copySelection:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        clipR0 = a.row
        clipC0 = a.col
        clipRows = ((b.row - a.row) + 1)
        clipCols = ((b.col - a.col) + 1)
        clipCut = false
        clear clipValues
        clear clipFormulas
        clear clipStyles
        def out:string ""
        def html:string "<table border=\"1\" cellspacing=\"0\" cellpadding=\"4\">"
        def r:int a.row
        while (r <= b.row) {
            if (r > a.row) {
                str_append out "\n"
            }
            str_append html "<tr>"
            def c:int a.col
            while (c <= b.col) {
                if (c > a.col) {
                    str_append out "\t"
                }
                def v:string (model.getCell(r c))
                str_append out v
                str_append html (this.cellHtml(r c))
                push clipValues v
                push clipFormulas (model.getFormula(r c))
                ; Formatting travels with the cell, so a paste looks like the
                ; source by default — the way every spreadsheet behaves.
                def cst:CellStyle (model.getCellStyle(r c))
                push clipStyles (cst.copy())
                c = (c + 1)
            }
            str_append html "</tr>"
            r = (r + 1)
        }
        clipboardTsv = out
        str_append html "</table>"
        clipboardHtml = html
        clipboardKind = "cells"
        clipboardPng = ""
        clipboardSvg = ""
        clipboardChartJson = ""
        clipboardChartJson = ""
        clipboardName = ""
        clipboardSeq = (clipboardSeq + 1)
    }

    ; Ctrl+X: copy, then clear the source range as one undoable action. A cut
    ; block pastes without ref translation (Excel moves formulas as written).
    ; Formulas elsewhere that pointed at the moved cells are not rewritten.
    fn cutSelection:void () {
        this.copySelection()
        this.clearSelection()
        clipCut = true
    }

    ; Host-supplied clipboard text (OS paste): drops the structured block so the
    ; TSV path is used and no stale formulas leak in.
    fn setClipboardText:void (text:string) {
        clipboardTsv = text
        clipboardHtml = ""
        clipboardKind = "cells"
        clipboardPng = ""
        clipboardSvg = ""
        clipCut = false
        clear clipValues
        clear clipFormulas
        clear clipStyles
        clipRows = 0
        clipCols = 0
    }

    fn pasteClipboard:void () {
        if editing {
            this.commitEdit()
        }
        if ((array_length clipValues) > 0) {
            this.pasteBlock()
            return
        }
        this.pasteTsv()
    }

    ; Structured paste: a copied formula is re-based by the paste offset, so
    ; =A1+B1 copied one row down becomes =A2+B2 (absolute refs stay put).
    fn pasteBlock:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def startR:int a.row
        def startC:int a.col
        def dy:int (startR - clipR0)
        def dx:int (startC - clipC0)
        if clipCut {
            dy = 0
            dx = 0
        }
        this.ensureExtent(((startR + clipRows) - 1) ((startC + clipCols) - 1))
        def maxR:int startR
        def maxC:int startC
        model.beginTx()
        engine.resetStats()
        def idx:int 0
        def ri:int 0
        while (ri < clipRows) {
            def ci:int 0
            while (ci < clipCols) {
                def tr:int (startR + ri)
                def tc:int (startC + ci)
                if ((tr < model.rowCount) && (tc < model.colCount)) {
                    def f:string (itemAt clipFormulas idx)
                    def srcStyle:CellStyle (itemAt clipStyles idx)
                    def newValue:string (itemAt clipValues idx)
                    def newFormula:string ""
                    if ((strlen f) > 0) {
                        def translated:string (FormulaParser.translateFormula(f dx dy))
                        if ((strlen translated) > 0) {
                            newFormula = translated
                            newValue = ""
                        }
                    }
                    ; Paste mode picks which of the three parts land.
                    ;   0 everything (default)  1 values only
                    ;   2 formats only          3 values + formulas, no formats
                    if (pasteMode == 1) {
                        newFormula = ""
                        newValue = (itemAt clipValues idx)
                    }
                    if (pasteMode == 2) {
                        newFormula = (model.getFormula(tr tc))
                        newValue = (model.getCell(tr tc))
                    }
                    def useStyle:CellStyle srcStyle
                    if ((pasteMode == 1) || (pasteMode == 3)) {
                        useStyle = (model.getCellStyle(tr tc))
                    }
                    model.applyEditStyled(tr tc newValue newFormula useStyle)
                    engine.syncCell(book.activeIndex tr tc)
                    if (tr > maxR) {
                        maxR = tr
                    }
                    if (tc > maxC) {
                        maxC = tc
                    }
                }
                idx = (idx + 1)
                ci = (ci + 1)
            }
            ri = (ri + 1)
        }
        model.endTx()
        engine.recalcDirty()
        clipCut = false
        sel.anchor.row = startR
        sel.anchor.col = startC
        sel.active.row = maxR
        sel.active.col = maxC
        this.afterCellMutation()
        grid.ensureCellVisible(model sel.active.row sel.active.col)
    }

    ; Plain-text fallback (external clipboard): values only, no formulas.
    fn pasteTsv:void () {
        if ((strlen clipboardTsv) == 0) {
            return
        }
        def lines:[string] (strsplit clipboardTsv "\n")
        def startR:int sel.active.row
        def startC:int sel.active.col
        def maxR:int startR
        def maxC:int startC
        def firstCols:[string] (strsplit (itemAt lines 0) "\t")
        this.ensureExtent(((startR + (array_length lines)) - 1) ((startC + (array_length firstCols)) - 1))
        model.beginTx()
        engine.resetStats()
        def ri:int 0
        def nLines:int (array_length lines)
        while (ri < nLines) {
            def rowText:string (itemAt lines ri)
            def cols:[string] (strsplit rowText "\t")
            def ci:int 0
            def nCols:int (array_length cols)
            while (ci < nCols) {
                def tr:int (startR + ri)
                def tc:int (startC + ci)
                if ((tr < model.rowCount) && (tc < model.colCount)) {
                    model.applyEdit(tr tc (itemAt cols ci) "")
                    engine.syncCell(book.activeIndex tr tc)
                    if (tr > maxR) {
                        maxR = tr
                    }
                    if (tc > maxC) {
                        maxC = tc
                    }
                }
                ci = (ci + 1)
            }
            ri = (ri + 1)
        }
        model.endTx()
        engine.recalcDirty()
        sel.anchor.row = startR
        sel.anchor.col = startC
        sel.active.row = maxR
        sel.active.col = maxC
        this.afterCellMutation()
        grid.ensureCellVisible(model sel.active.row sel.active.col)
    }

    ; Delete: clear values AND formulas over a range, as one undoable action,
    ; then recalculate everything that depended on those cells.
    fn clearRange:void (r0:int c0:int r1:int c1:int) {
        model.beginTx()
        engine.resetStats()
        def r:int r0
        while (r <= r1) {
            def c:int c0
            while (c <= c1) {
                model.applyEdit(r c "" "")
                engine.syncCell(book.activeIndex r c)
                c = (c + 1)
            }
            r = (r + 1)
        }
        model.endTx()
        engine.recalcDirty()
        this.afterCellMutation()
    }

    ; Everything the selection covers, whatever shape it is in: a Ctrl+click
    ; selection is several rectangles and Delete has to clear all of them, in
    ; one transaction, so it is one Ctrl+Z.
    fn clearSelection:void () {
        model.beginTx()
        def i:int 0
        while (i < (sel.rangeCount())) {
            def g:GridRange (sel.rangeAt(i))
            this.clearRange(g.r0 g.c0 g.r1 g.c1)
            i = (i + 1)
        }
        model.endTx()
        this.afterCellMutation()
    }

    ; FortuneSheet fill handle: tile source rect; translate relative formula refs.
    fn fillFromSource:void () {
        def a:CellPos (new CellPos)
        def b:CellPos (new CellPos)
        sel.normalized(a b)
        def srcH:int ((fillR1 - fillR0) + 1)
        def srcW:int ((fillC1 - fillC0) + 1)
        if (srcH < 1) {
            return
        }
        if (srcW < 1) {
            return
        }
        model.beginTx()
        engine.resetStats()
        def r:int a.row
        while (r <= b.row) {
            def c:int a.col
            while (c <= b.col) {
                def inSrc:boolean false
                if ((r >= fillR0) && (r <= fillR1) && (c >= fillC0) && (c <= fillC1)) {
                    inSrc = true
                }
                if (inSrc == false) {
                    def dr:int (r - fillR0)
                    def dc:int (c - fillC0)
                    def sr:int (fillR0 + (dr - ((to_int (dr / srcH)) * srcH)))
                    def sc:int (fillC0 + (dc - ((to_int (dc / srcW)) * srcW)))
                    def srcF:string (model.getFormula(sr sc))
                    def wrote:boolean false
                    if ((strlen srcF) > 0) {
                        def dx:int (c - sc)
                        def dy:int (r - sr)
                        def translated:string (FormulaParser.translateFormula(srcF dx dy))
                        if ((strlen translated) > 0) {
                            model.applyEdit(r c "" translated)
                            wrote = true
                        }
                    }
                    if (wrote == false) {
                        model.applyEdit(r c (model.getCell(sr sc)) "")
                    }
                    engine.syncCell(book.activeIndex r c)
                }
                c = (c + 1)
            }
            r = (r + 1)
        }
        model.endTx()
        ; Recalc newly registered / dependent formulas once.
        engine.recalcDirty()
        this.afterCellMutation()
    }

    ; Pointer press that is neither a sheet tab nor a header resize: fill
    ; handle, header menu, formula bar, or cell selection.
    ; --- moving a range ------------------------------------------------------
    ; Drag the selection's border and the cells go with it. Excel calls this
    ; drag-and-drop; it is a cut and a paste, which means formulas move AS
    ; WRITTEN — a reference is not re-based, because the cell it names has not
    ; moved just because this one did.
    fn moveBlock:void (r0:int c0:int r1:int c1:int toR:int toC:int) {
        if ((toR == r0) && (toC == c0)) {
            return
        }
        def rows:int ((r1 - r0) + 1)
        def cols:int ((c1 - c0) + 1)
        if (toR < 0) {
            return
        }
        if (toC < 0) {
            return
        }
        ; Read the whole block first: source and target can overlap.
        def vals:[string]
        def fmls:[string]
        def sids:[CellStyle]
        def r:int r0
        while (r <= r1) {
            def c:int c0
            while (c <= c1) {
                push vals (model.getCell(r c))
                push fmls (model.getFormula(r c))
                push sids (model.getCellStyle(r c))
                c = (c + 1)
            }
            r = (r + 1)
        }
        this.ensureExtent(((toR + rows) - 1) ((toC + cols) - 1))
        model.beginTx()
        def cr:int r0
        while (cr <= r1) {
            def cc:int c0
            while (cc <= c1) {
                model.applyEdit(cr cc "" "")
                cc = (cc + 1)
            }
            cr = (cr + 1)
        }
        def i:int 0
        def wr:int 0
        while (wr < rows) {
            def wc:int 0
            while (wc < cols) {
                model.applyEditStyled((toR + wr) (toC + wc) (itemAt vals i) (itemAt fmls i) (itemAt sids i))
                i = (i + 1)
                wc = (wc + 1)
            }
            wr = (wr + 1)
        }
        model.endTx()
        this.syncTouched()
        sel.clearExtra()
        sel.anchor.row = toR
        sel.anchor.col = toC
        sel.active.row = ((toR + rows) - 1)
        sel.active.col = ((toC + cols) - 1)
        sheetView.markDirty()
        sheetView.rebuild()
        grid.updateVisible(model)
    }

    ; Where the dragged block would land, given the cell the pointer is over.
    fn moveTargetRow:int (hitRow:int) {
        def dr:int (hitRow - moveGrabR)
        def toR:int (moveR0 + dr)
        if (toR < 0) {
            toR = 0
        }
        return toR
    }

    fn moveTargetCol:int (hitCol:int) {
        def dc:int (hitCol - moveGrabC)
        def toC:int (moveC0 + dc)
        if (toC < 0) {
            toC = 0
        }
        return toC
    }

    fn handlePress:void (input:UIInput) {
        ; A hand on the sheet stops it moving.
        this.stopFling()
        ; Formula-range grips (bottom / right / corner) resize the named span.
        this.refreshFormulaHilites()
        ; A real multi-cell selection's own move border has priority over a
        ; formula reference that happens to overlap it.
        def allowFormulaRange:boolean (sel.isSingle())
        if (this.isFormulaEdit()) {
            allowFormulaRange = true
        }
        if allowFormulaRange {
            def rangeEdge:int (this.hitFormulaRangeHandle(input.pointerX input.pointerY))
            if (rangeEdge >= 0) {
                def rangeHit:CellPos (grid.hitTest(model input.pointerX input.pointerY))
                if ((rangeHit.row >= 0) && (rangeHit.col >= 0)) {
                    this.beginFormulaRangeDrag(rangeEdge rangeHit.col)
                    return
                }
            }
        }
        ; The list arrow belongs to the active cell and sits inside it, so it
        ; has to be asked before the cell is.
        if (editing == false) {
            if (model.hasValidation(sel.active.row sel.active.col)) {
                def dvHere:DataValidation (model.validationAt(sel.active.row sel.active.col))
                if (dvHere.isList()) {
                    if (grid.hitListArrow(model sel input.pointerX input.pointerY)) {
                        view.focused = true
                        this.openListPicker(sel.active.row sel.active.col)
                        return
                    }
                }
            }
        }
        def onFill:boolean false
        if (editing == false) {
            onFill = (grid.hitFillHandle(model sel input.pointerX input.pointerY))
        }
        if (editing == false) {
            if (onFill == false) {
                if ((sel.isSingle()) == false) {
                    if (grid.hitSelectionEdge(model sel input.pointerX input.pointerY)) {
                        def start:CellPos (grid.hitTest(model input.pointerX input.pointerY))
                        if ((start.row >= 0) && (start.col >= 0)) {
                            def g:GridRange (sel.liveRange())
                            moveR0 = g.r0
                            moveC0 = g.c0
                            moveR1 = g.r1
                            moveC1 = g.c1
                            moveGrabR = start.row
                            moveGrabC = start.col
                            movingRange = true
                            dragging = false
                            filling = false
                            view.focused = true
                            view.ghostVisible = true
                            view.ghostR0 = moveR0
                            view.ghostC0 = moveC0
                            view.ghostR1 = moveR1
                            view.ghostC1 = moveC1
                            return
                        }
                    }
                }
            }
        }
        if onFill {
            ; FortuneSheet fill-handle drag starts from current selection
            view.focused = true
            def a0:CellPos (new CellPos)
            def b0:CellPos (new CellPos)
            sel.normalized(a0 b0)
            fillR0 = a0.row
            fillC0 = a0.col
            fillR1 = b0.row
            fillC1 = b0.col
            filling = true
            dragging = false
        } {
            def hit:CellPos (grid.hitTest(model input.pointerX input.pointerY))
            def menuHit:int (this.hitHeaderMenu(input.pointerX input.pointerY))
            if (menuHit >= 0) {
                view.focused = true
                if (menuHit >= 1) {
                    this.runHeaderMenu(menuHit)
                }
            } {
                if ((hit.row == -2) && (hit.col >= 0)) {
                    ; Header click selects populated cells only. Ctrl adds
                    ; another column. The small arrow owns the old menu.
                    view.focused = true
                    if editing {
                        this.commitEdit()
                    }
                    if ((this.hitColumnMenuArrow(hit.col input.pointerX input.pointerY)) || input.shiftDown) {
                        this.openHeaderMenu(hit.col input.pointerX (grid.gridOriginY()))
                    } {
                        this.selectDataColumn(hit.col input.ctrlDown)
                        ; …and a header is also a handle. Armed, not carried:
                        ; the pointer has to travel before a click on a header
                        ; stops meaning "select this column".
                        if (input.ctrlDown == false) {
                            colDragArmed = true
                            colDragFrom = hit.col
                            colDragTo = hit.col
                            colDragStartX = input.pointerX
                        }
                    }
                } {
                if ((hit.col == -2) && (hit.row >= 0)) {
                    ; Row header → the row's own popup.
                    view.focused = true
                    if editing {
                        this.commitEdit()
                    }
                    def menuTop:int input.pointerY
                    if ((menuTop + view.menuH) > H) {
                        menuTop = (H - (view.menuH + 6))
                    }
                    if (menuTop < grid.y) {
                        menuTop = grid.y
                    }
                    this.openRowMenu(hit.row (grid.x + grid.rowHeaderW) menuTop)
                } {
                    if view.menuOpen {
                        this.closeHeaderMenu()
                    }
                    if ((hit.row == -3) && (hit.col == -3)) {
                        this.beginFormulaBarEditAt(input.pointerX)
                    } {
                        if ((hit.row >= 0) && (hit.col >= 0)) {
                            view.focused = true
                            ; While typing a formula, a click on another cell
                            ; inserts A1 / A1:B2 at the caret — it must not
                            ; commit the edit or move the cell being written.
                            if (this.canPickAtCaret()) {
                                if ((hit.row != sel.active.row) || (hit.col != sel.active.col)) {
                                    this.beginFormulaPickAt(hit.row hit.col)
                                    dragging = true
                                    return
                                }
                            }
                            if editing {
                                if ((hit.row != sel.active.row) || (hit.col != sel.active.col)) {
                                    this.commitEdit()
                                }
                            }
                            ; Ctrl+click keeps what is selected and starts
                            ; another rectangle beside it, as Excel does.
                            ; Moving the active cell collapses the selection, so
                            ; the rectangle is lifted out first and handed back
                            ; after.
                            def keeping:boolean false
                            def kept:GridRange (sel.liveRange())
                            if input.ctrlDown {
                                if (input.shiftDown == false) {
                                    ; Ctrl+click on a link follows it rather
                                    ; than starting another rectangle — the
                                    ; link is the more specific gesture.
                                    if (model.hasHyperlink(hit.row hit.col)) {
                                        this.moveActive(hit.row hit.col false)
                                        this.followLink(hit.row hit.col)
                                        return
                                    }
                                    keeping = true
                                }
                            }
                            this.moveActive(hit.row hit.col input.shiftDown)
                            if keeping {
                                sel.keepRange(kept)
                            }
                            dragging = true
                        }
                    }
                }
                }
            }
        }
    }

    ; Pointer drag that is not a resize: fill-handle rubber band or range select.
    ; Where a carried column would land, from the pointer's x. The answer is
    ; an INSERTION POINT, not a column: dragging past the middle of a column
    ; means "after it", which is how every list that can be reordered behaves.
    ; What the pointer is over, as a GridCursor kind.
    ;
    ; The questions are the same ones `handlePress` asks, in the same order, so
    ; the shape the pointer takes and what a click actually does cannot drift
    ; apart. A host calls this every time the pointer moves and sets its own
    ; cursor from the answer; nothing here knows what an SDL cursor or a CSS
    ; cursor is.
    fn cursorAt:int (px:int py:int) {
        ; While something is being carried or dragged, the pointer says so
        ; wherever it happens to be.
        if movingColumn {
            return (GridCursor.grabbing())
        }
        if movingTab {
            return (GridCursor.grabbing())
        }
        if resizing {
            return (GridCursor.resizeX())
        }
        if resizingRows {
            return (GridCursor.resizeY())
        }
        if filling {
            return (GridCursor.crosshair())
        }
        if (view.menuOpen) {
            if ((this.hitHeaderMenu(px py)) >= 0) {
                return (GridCursor.pointing())
            }
        }
        if (this.toolbarHit(px py) >= 0) {
            return (GridCursor.pointing())
        }
        def hit:CellPos (grid.hitTest(model px py))
        ; The formula bar is a text field.
        if ((hit.row == -3) && (hit.col == -3)) {
            return (GridCursor.text())
        }
        ; Header edges resize; the rest of a header is a handle.
        if ((grid.hitColResize(model px py)) >= 0) {
            return (GridCursor.resizeX())
        }
        if ((grid.hitRowResize(model px py)) >= 0) {
            return (GridCursor.resizeY())
        }
        if ((hit.row == -2) && (hit.col >= 0)) {
            if (this.hitColumnMenuArrow(hit.col px py)) {
                return (GridCursor.pointing())
            }
            return (GridCursor.grab())
        }
        if ((hit.col == -2) && (hit.row >= 0)) {
            return (GridCursor.pointing())
        }
        if ((hit.row >= 0) && (hit.col >= 0)) {
            ; The fill handle sits inside the active cell's bottom corner and
            ; means something else entirely, so it is asked first.
            if (editing == false) {
                if (grid.hitFillHandle(model sel px py)) {
                    return (GridCursor.crosshair())
                }
                if (model.hasValidation(sel.active.row sel.active.col)) {
                    def dvC:DataValidation (model.validationAt(sel.active.row sel.active.col))
                    if (dvC.isList()) {
                        if (grid.hitListArrow(model sel px py)) {
                            return (GridCursor.pointing())
                        }
                    }
                }
            }
            ; A link is a link.
            if (model.hasHyperlink(hit.row hit.col)) {
                return (GridCursor.pointing())
            }
            ; The edge of a selection picks the whole block up.
            if (editing == false) {
                if (grid.hitSelectionEdge(model sel px py)) {
                    return (GridCursor.grab())
                }
            }
            ; A cell being edited is text; every other cell is a cell.
            if editing {
                if ((hit.row == sel.active.row) && (hit.col == sel.active.col)) {
                    return (GridCursor.text())
                }
            }
            return (GridCursor.cell())
        }
        return (GridCursor.arrow())
    }

    ; A shove on top of whatever the sheet was already doing.
    ;
    ; Notches that arrive together add up, so a fast flick of the wheel or two
    ; fingers builds real speed while a slow one nudges — which is the whole
    ; difference between a sheet that steps and a sheet that moves. Capped, so
    ; no amount of spinning can throw the view across a hundred thousand rows
    ; in one frame.
    fn addFling:double (current:double push:double) {
        def v:double (current + push)
        ; A shove the other way stops the sheet rather than fighting it.
        if (current > 0.0) {
            if (push < 0.0) {
                v = push
            }
        }
        if (current < 0.0) {
            if (push > 0.0) {
                v = push
            }
        }
        ; A speed, so the cap is per frame: about ten rows, which is as fast
        ; as a sheet can move and still be read on the way past.
        def cap:double 220.0
        if (v > cap) {
            v = cap
        }
        if (v < (0.0 - cap)) {
            v = (0.0 - cap)
        }
        return v
    }

    ; Move by whatever speed is left, then lose some of it.
    ;
    ; 0.88 a frame is about a fifth of a second to half speed at 60Hz: long
    ; enough to feel like the sheet has weight, short enough that it stops
    ; where it was thrown rather than drifting on. Below a pixel a frame it is
    ; not moving any more, and pretending otherwise leaves the grid redrawing
    ; forever.
    fn stepFling:void () {
        if ((flingX == 0.0) && (flingY == 0.0)) {
            return
        }
        ; `fling` is a SPEED, in pixels per frame, and it is not spent by
        ; moving — it decays. Subtracting the distance travelled instead is
        ; the mistake that turns a flick into a single step, because the whole
        ; of it is gone by the end of the frame that received it.
        subX = (subX + flingX)
        subY = (subY + flingY)
        def dx:int (to_int subX)
        def dy:int (to_int subY)
        if ((dx != 0) || (dy != 0)) {
            grid.scrollByPixels(model dx dy)
        }
        ; Whatever did not amount to a whole pixel is carried, so a slow glide
        ; does not quietly round down to standing still.
        subX = (subX - (to_double dx))
        subY = (subY - (to_double dy))
        flingX = (flingX * 0.88)
        flingY = (flingY * 0.88)
        if (flingX < 0.6) {
            if (flingX > -0.6) {
                flingX = 0.0
            }
        }
        if (flingY < 0.6) {
            if (flingY > -0.6) {
                flingY = 0.0
            }
        }
    }

    ; Whether the view is still coasting — a host that only redraws on demand
    ; needs to know to keep asking.
    fn isCoasting:boolean () {
        if (flingX != 0.0) {
            return true
        }
        return (flingY != 0.0)
    }

    ; Any deliberate move stops the coast dead, the way a finger on a phone
    ; stops a flick.
    fn stopFling:void () {
        flingX = 0.0
        flingY = 0.0
        subX = 0.0
        subY = 0.0
    }

    fn colDropTarget:int (px:int) {
        def c:int grid.firstVisibleCol
        while (c <= grid.lastVisibleCol) {
            def mc:int (grid.mapCol(c))
            def x0:int (grid.viewColScreenX(model c))
            def w:int (model.colWidth(mc))
            if (px < (x0 + (idiv w 2))) {
                return mc
            }
            if (px < (x0 + w)) {
                return (mc + 1)
            }
            c = (c + 1)
        }
        return (model.colCount - 1)
    }

    fn handleDrag:void (input:UIInput) {
        ; A tab press becomes a carry the same way a column header press does.
        if tabDragArmed {
            def moved:int (input.pointerX - tabDragStartX)
            if (moved < 0) {
                moved = (0 - moved)
            }
            if (moved > 5) {
                tabDragArmed = false
                movingTab = true
            }
        }
        if movingTab {
            view.tabDragFrom = tabDragFrom
            view.tabDropSlot = (grid.tabDropSlot(input.pointerX))
            return
        }
        ; A header press becomes a carry once the pointer has travelled far
        ; enough that it cannot have been a click.
        if colDragArmed {
            def travelled:int (input.pointerX - colDragStartX)
            if (travelled < 0) {
                travelled = (0 - travelled)
            }
            if (travelled > 5) {
                colDragArmed = false
                movingColumn = true
            }
        }
        if movingColumn {
            colDragTo = (this.colDropTarget(input.pointerX))
            view.colDropAt = colDragTo
            return
        }
        if formulaRangeDrag {
            def hitR:CellPos (grid.hitTest(model input.pointerX input.pointerY))
            if ((hitR.row >= 0) && (hitR.col >= 0)) {
                this.updateFormulaRangeDragAt(hitR.row hitR.col)
            }
            return
        }
        if formulaPicking {
            def hitP:CellPos (grid.hitTest(model input.pointerX input.pointerY))
            if ((hitP.row >= 0) && (hitP.col >= 0)) {
                this.updateFormulaPickAt(hitP.row hitP.col)
            }
            return
        }
        if movingRange {
            def hitM:CellPos (grid.hitTest(model input.pointerX input.pointerY))
            if ((hitM.row >= 0) && (hitM.col >= 0)) {
                def toR:int (this.moveTargetRow(hitM.row))
                def toC:int (this.moveTargetCol(hitM.col))
                view.ghostVisible = true
                view.ghostR0 = toR
                view.ghostC0 = toC
                view.ghostR1 = ((toR + (moveR1 - moveR0)))
                view.ghostC1 = ((toC + (moveC1 - moveC0)))
            }
            return
        }
        if filling {
            if (input.pointerPressed == false) {
                def hitF:CellPos (grid.hitTest(model input.pointerX input.pointerY))
                if ((hitF.row >= 0) && (hitF.col >= 0)) {
                    sel.anchor.row = fillR0
                    sel.anchor.col = fillC0
                    sel.active.row = hitF.row
                    sel.active.col = hitF.col
                    ; keep source corner as the other end of the range
                    def a1:CellPos (new CellPos)
                    def b1:CellPos (new CellPos)
                    sel.normalized(a1 b1)
                    if (a1.row > fillR0) {
                        a1.row = fillR0
                    }
                    if (a1.col > fillC0) {
                        a1.col = fillC0
                    }
                    if (b1.row < fillR1) {
                        b1.row = fillR1
                    }
                    if (b1.col < fillC1) {
                        b1.col = fillC1
                    }
                    sel.anchor.row = a1.row
                    sel.anchor.col = a1.col
                    sel.active.row = b1.row
                    sel.active.col = b1.col
                }
            }
        } {
            if dragging {
                if (input.pointerPressed == false) {
                    def hit2:CellPos (grid.hitTest(model input.pointerX input.pointerY))
                    if ((hit2.row >= 0) && (hit2.col >= 0)) {
                        this.moveActive(hit2.row hit2.col true)
                    }
                }
            }
        }
    }

    fn update:void (input:UIInput) {
        ; The window may be showing more sheet than the sheet has. Cheap when
        ; it is not, which is almost always.
        this.ensureViewportFilled()
        ; A visible dialog owns the frame.
        if (this.updateDialogs(input)) {
            return
        }
        ; …and so does a report preview, for everything except a click on the
        ; chrome around it.
        if view.preview.active {
            if (this.updateScriptPreview(input)) {
                return
            }
        }
        ; The toolbar lights up under the pointer whether or not a button is
        ; pressed — without that it is a row of shapes rather than something
        ; that looks clickable. The hot label is this app's tooltip.
        view.toolbar.hot = (this.toolbarHit(input.pointerX input.pointerY))
        def tip:string (view.toolbar.hotLabel())
        if ((strlen tip) > 0) {
            view.status = tip
        }
        if input.pointerPressed {
            ; Every popup owns clicks inside it and closes on the first click
            ; outside — before toolbar/header/sheet hit tests can consume it.
            if view.menuOpen {
                def menuHit0:int (this.hitHeaderMenu(input.pointerX input.pointerY))
                if (menuHit0 >= 0) {
                    view.focused = true
                    if (menuHit0 >= 1) {
                        this.runHeaderMenu(menuHit0)
                    }
                    return
                }
                this.closeHeaderMenu()
            }
            def hitTool:int (this.toolbarHit(input.pointerX input.pointerY))
            if (hitTool >= 0) {
                view.focused = true
                this.runToolbarItem(hitTool)
                return
            }
            if (this.chartButtonHit(input.pointerX input.pointerY)) {
                this.openChartDialog(0)
                return
            }
            def toolIdx:int (this.toolButtonHit(input.pointerX input.pointerY))
            if (toolIdx >= 0) {
                def tool:GridCommand (commands.customAt(toolIdx))
                view.focused = true
                this.runCommand(tool.id "")
                return
            }
            if (grid.hitSheetPlus(input.pointerX input.pointerY)) {
                view.focused = true
                this.addSheet()
                return
            }
            def tab:int (grid.hitSheetTab((book.sheetCount()) input.pointerX input.pointerY))
            if (tab >= 0) {
                this.setActiveSheet(tab)
                view.focused = true
                ; Armed, not yet carried: a press on a tab is a click until
                ; the pointer has moved far enough that it cannot be one.
                tabDragArmed = true
                tabDragFrom = tab
                tabDragStartX = input.pointerX
            } {
                def resizeCol:int (grid.hitColResize(model input.pointerX input.pointerY))
                def resizeRow:int -1
                if (resizeCol < 0) {
                    resizeRow = (grid.hitRowResize(model input.pointerX input.pointerY))
                }
                if (resizeCol >= 0) {
                    if editing {
                        this.commitEdit()
                    }
                    resizing = true
                    grid.resizingCol = resizeCol
                    grid.resizeStartX = input.pointerX
                    grid.resizeStartW = (model.colWidth(resizeCol))
                    view.focused = true
                } {
                    if (resizeRow >= 0) {
                        if editing {
                            this.commitEdit()
                        }
                        resizingRows = true
                        grid.resizingRow = resizeRow
                        grid.resizeStartY = input.pointerY
                        grid.resizeStartH = (model.rowHeight(resizeRow))
                        view.focused = true
                    } {
                        this.handlePress(input)
                    }
                }
            }
        }

        if input.pointerDown {
            if resizing {
                def dx:int (input.pointerX - grid.resizeStartX)
                def w:int (grid.resizeStartW + dx)
                if (w < 24) {
                    w = 24
                }
                ; Dragging one edge of a multi-column selection sizes them all.
                this.setColumnWidths(grid.resizingCol w)
            } {
                if resizingRows {
                    def dy:int (input.pointerY - grid.resizeStartY)
                    model.setRowHeight(grid.resizingRow (grid.resizeStartH + dy))
                    sheetView.markDirty()
                    sheetView.rebuild()
                    grid.updateVisible(model)
                } {
                    this.handleDrag(input)
                }
            }
        }

        if input.pointerReleased {
            if movingTab {
                movingTab = false
                tabDragArmed = false
                def slot:int view.tabDropSlot
                def lifted:int tabDragFrom
                view.tabDragFrom = -1
                view.tabDropSlot = -1
                tabDragFrom = -1
                if (slot >= 0) {
                    ; An insertion SLOT turns into a destination index the
                    ; same way a column drop does: landing after yourself is
                    ; where you already are.
                    def dest:int (grid.sheetForSlot(slot (book.sheetCount())))
                    if (dest > lifted) {
                        dest = (dest - 1)
                    }
                    this.moveSheetTo(lifted dest)
                }
                return
            }
            tabDragArmed = false
            if movingColumn {
                movingColumn = false
                colDragArmed = false
                view.colDropAt = -1
                def dropAt:int colDragTo
                def lifted:int colDragFrom
                colDragFrom = -1
                colDragTo = -1
                ; An insertion point turns into a destination index: dropping
                ; after itself, or immediately before itself, is where it
                ; already is.
                if (dropAt > lifted) {
                    dropAt = (dropAt - 1)
                }
                if (dropAt != lifted) {
                    this.moveColumn(lifted dropAt)
                    this.selectDataColumn(dropAt false)
                }
                return
            }
            colDragArmed = false
            if formulaRangeDrag {
                def commitRange:boolean formulaRangeStartedEdit
                formulaRangeDrag = false
                formulaRangeStartedEdit = false
                if commitRange {
                    this.commitEdit()
                    this.refreshFormulaHilites()
                }
            }
            if movingRange {
                def hitD:CellPos (grid.hitTest(model input.pointerX input.pointerY))
                if ((hitD.row >= 0) && (hitD.col >= 0)) {
                    this.moveBlock(moveR0 moveC0 moveR1 moveC1 (this.moveTargetRow(hitD.row)) (this.moveTargetCol(hitD.col)))
                }
                movingRange = false
                view.ghostVisible = false
            }
            if formatBrushArmed {
                if (resizing == false) {
                    if (resizingRows == false) {
                        this.applyFormatToSelection()
                    }
                }
            }
            if filling {
                this.fillFromSource()
            }
            filling = false
            dragging = false
            movingRange = false
            if formulaPicking {
                formulaPicking = false
                this.showPickGhost()
            } {
                if ((this.isFormulaEdit()) && (pickTokStart >= 0)) {
                    this.showPickGhost()
                } {
                    view.ghostVisible = false
                }
            }
            resizing = false
            resizingRows = false
            grid.resizingCol = -1
            grid.resizingRow = -1
        }

        ; The wheel. Shift turns it sideways, which is what every spreadsheet
        ; does and what this had no answer for: a column off the right edge
        ; could not be reached with the mouse at all.
        if (input.scrollDelta != 0) {
            def notches:double (to_double (0 - input.scrollDelta))
            if input.shiftDown {
                ; Sideways, so a notch is a COLUMN's worth — a row's height
                ; would be a step so short it did not always reach the next
                ; column at all.
                flingX = (this.addFling(flingX (notches * (to_double model.defaultColW))))
            } {
                flingY = (this.addFling(flingY (notches * (to_double model.defaultRowH))))
            }
        }
        ; …and a trackpad sends sideways notches of its own.
        if (input.scrollDeltaX != 0) {
            def pushX:double ((to_double (0 - input.scrollDeltaX)) * (to_double model.defaultColW))
            flingX = (this.addFling(flingX pushX))
        }
        this.stepFling()

        if input.ctrlDown {
            def t:string input.textInput
            def ti:int 0
            def tn:int (strlen t)
            while (ti < tn) {
                def ch:int (charAt t ti)
                if ((ch == 97) || (ch == 65)) {
                    ; Whoever owns the keyboard. A field that cannot answer
                    ; Ctrl+A is not really a field, and committing the edit to
                    ; select the sheet instead — which is what this did — is
                    ; the opposite of what was asked.
                    if editing {
                        this.selectAllText()
                    } {
                        sel.selectAll(model)
                        grid.ensureCellVisible(model sel.active.row sel.active.col)
                    }
                }
                if ((ch == 99) || (ch == 67)) {
                    ; Text selected inside a field is what Ctrl+C means then.
                    ; Committing the edit and copying CELLS instead — which is
                    ; what this did — throws away the thing that was selected.
                    if (this.hasTextSelection()) {
                        this.copyTextSelection(false)
                        ti = (ti + 1)
                        continue
                    }
                    if editing {
                        this.commitEdit()
                    }
                    if input.shiftDown {
                        this.copyFormat()
                    } {
                        ; A chart window on top is what Ctrl+C means then —
                        ; the same rule Excel uses for a selected chart.
                        def onChart:int (this.focusedChartId())
                        if (onChart > 0) {
                            this.copyChart(onChart)
                        } {
                            this.copySelection()
                        }
                    }
                }
                if ((ch == 120) || (ch == 88)) {
                    if (this.hasTextSelection()) {
                        this.copyTextSelection(true)
                        ti = (ti + 1)
                        continue
                    }
                    if editing {
                        this.commitEdit()
                    }
                    this.cutSelection()
                }
                if ((ch == 118) || (ch == 86)) {
                    ; Into a field, a paste is text — into a sheet it is cells.
                    if editing {
                        this.pasteIntoField()
                        ti = (ti + 1)
                        continue
                    }
                    if input.shiftDown {
                        this.openPasteSpecial()
                    } {
                        this.pasteClipboard()
                    }
                }
                if ((ch == 102) || (ch == 70)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.openFindDialog()
                }
                ; Ctrl+Shift+T steps through the colour themes. Plain Ctrl+T
                ; is left alone: Excel spends it on "format as table".
                if ((ch == 116) || (ch == 84)) {
                    if input.shiftDown {
                        if editing {
                            this.commitEdit()
                        }
                        def picked:string (view.theme.cycle())
                        view.status = ("theme: " + picked)
                    }
                }
                ; Ctrl+D shows what the workbook is connected to.
                if ((ch == 100) || (ch == 68)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.openConnectionDialog()
                }
                ; Ctrl+Q opens the SQL box - the query is the thing you edit
                ; when the sheet is a database sheet.
                if ((ch == 113) || (ch == 81)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.openSqlDialog()
                }
                if ((ch == 104) || (ch == 72)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.openFindDialog()
                }
                if ((ch == 108) || (ch == 76)) {
                    if editing {
                        this.commitEdit()
                    }
                    cfStatus = ""
                    this.openCfDialog()
                }
                ; Bold, italic, underline — the three every spreadsheet binds,
                ; and which had nothing behind them until the formatting
                ; commands existed.
                if ((ch == 98) || (ch == 66)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.runCommand("format.bold" "")
                }
                if ((ch == 105) || (ch == 73)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.runCommand("format.italic" "")
                }
                if ((ch == 117) || (ch == 85)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.runCommand("format.underline" "")
                }
                if ((ch == 107) || (ch == 75)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.openLinkDialog()
                }
                if ((ch == 101) || (ch == 69)) {
                    if editing {
                        this.commitEdit()
                    }
                    dvStatus = ""
                    this.openValidationDialog()
                }
                if ((ch == 115) || (ch == 83)) {
                    ; Ctrl+S writes beside the file it came from; add Shift and
                    ; the host is asked where to put it instead.
                    if input.shiftDown {
                        this.runCommand("file.saveAs" "")
                    } {
                        this.saveXlsxDefault()
                    }
                }
                if ((ch == 110) || (ch == 78)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.runCommand("file.new" "")
                }
                if ((ch == 111) || (ch == 79)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.runCommand("file.open" "")
                }
                ; Ctrl+M makes a chart of the selection. Excel's own chart
                ; keys (F11, Alt+F1) are not keys this input layer carries, and
                ; the browser host keeps most of the rest.
                if ((ch == 109) || (ch == 77)) {
                    if editing {
                        this.commitEdit()
                    }
                    this.openChartDialog(0)
                }
                if ((ch == 122) || (ch == 90)) {
                    this.undoEdit()
                }
                if ((ch == 121) || (ch == 89)) {
                    this.redoEdit()
                }
                ; Excel: Ctrl+Space selects the column, Shift+Space the row.
                if (ch == 32) {
                    if editing {
                        this.commitEdit()
                    }
                    if input.shiftDown {
                        sel.selectAll(model)
                    } {
                        this.selectColumn(sel.active.col)
                    }
                }
                ti = (ti + 1)
            }
        } {
            if (input.hasText()) {
                if editing {
                    this.insertAtCaret(input.textInput)
                } {
                    ; Shift+Space selects the whole row rather than typing one.
                    if (input.shiftDown && (input.textInput == " ")) {
                        this.selectRow(sel.active.row)
                    } {
                        this.beginEdit(input.textInput true)
                    }
                }
            }
        }

        def ki:int 0
        def kn:int (input.keyCount())
        while (ki < kn) {
            this.handleKey((input.keyAt(ki)) input)
            ki = (ki + 1)
        }
    }

    ; The selected span of the field being edited, handed to the view. It is
    ; the app that knows what is selected; the view only draws it.
    fn publishTextSelection:void () {
        view.editSelA = -1
        view.editSelB = -1
        if (this.hasTextSelection()) {
            view.editSelA = (this.selectionStart())
            view.editSelB = (this.selectionEnd())
        }
    }

    fn render:void () {
        this.publishTextSelection()
        ; Keep a toolbar tooltip / save note visible; only fall back to the
        ; version stamp when nothing more useful is showing.
        def tip:string (view.toolbar.hotLabel())
        if ((strlen tip) > 0) {
            view.status = tip
        } {
            if ((strlen view.status) == 0) {
                view.status = ("v" + (to_string model.version))
            }
            if ((charAt view.status 0) == 118) {
                ; "vN…" — refresh the stamp so it tracks the model.
                if ((strlen view.status) < 12) {
                    view.status = ("v" + (to_string model.version))
                }
            }
        }
        view.editCaret = editCaret
        view.editInFormulaBar = editInFormulaBar
        view.windows = windows
        this.refreshFormulaHilites()
        view.render(model sel grid editing editBuf book)
    }

    fn raw:buffer () {
        return (view.raw())
    }

    ; --- the accessibility tree -----------------------------------------------
    ; The same frame, said in the other language: what everything IS, for a
    ; screen reader that cannot look at the pixels. A host asks for this beside
    ; `sceneJson` and turns it into its platform's accessibility tree.
    ;
    ; It reads the geometry the last scene build settled, so ask for the scene
    ; first — the two describe one frame, not two.
    fn a11yTree:EVGA11yTree () {
        return (view.a11yTree(model sel grid editing editBuf book))
    }

    fn a11yJson:string () {
        def t:EVGA11yTree (this.a11yTree())
        return (t.toJson())
    }

    ; The tree as indented text. This is what a golden test diffs: a refactor
    ; that silently drops a name shows up here, and neither a browser nor a
    ; screen reader has to be involved to catch it.
    fn a11yDump:string () {
        def t:EVGA11yTree (this.a11yTree())
        return (t.dump())
    }

    fn sceneJson:string () {
        this.publishTextSelection()
        def tip2:string (view.toolbar.hotLabel())
        if ((strlen tip2) > 0) {
            view.status = tip2
        } {
            if ((strlen view.status) == 0) {
                view.status = ("v" + (to_string model.version))
            }
        }
        view.editCaret = editCaret
        view.editInFormulaBar = editInFormulaBar
        view.windows = windows
        this.refreshFormulaHilites()
        return (view.sceneJson(model sel grid editing editBuf book))
    }

    fn activeLabel:string () {
        return (SpreadsheetModel.cellLabel(sel.active.row sel.active.col))
    }

    fn activeValue:string () {
        if editing {
            return editBuf
        }
        return (model.getCell(sel.active.row sel.active.col))
    }
}

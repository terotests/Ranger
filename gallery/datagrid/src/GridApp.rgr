; ==============================================================================
; GridApp - UIInput → WorkbookModel / DataGrid / selection / single EditView
; ==============================================================================
;
; Same contract as the text editor: platform fills UIInput; app never touches
; SDL/DOM. Loads .xlsx via XlsxLoader into WorkbookModel; DataGrid stays format-
; agnostic.
; ==============================================================================

Import "SpreadsheetModel.rgr"
Import "WorkbookModel.rgr"
Import "GridSelection.rgr"
Import "DataGrid.rgr"
Import "GridView.rgr"
Import "SheetView.rgr"
Import "FormulaEngine.rgr"
Import "xlsx/XlsxLoader.rgr"
Import "xlsx/XlsxWriter.rgr"
Import "DateSerial.rgr"
Import "../../evg/EVGCommands.rgr"
Import "GridCursor.rgr"
Import "../../game_engine/ui/UIInput.rgr"
Import "../../evg/EVGWindow.rgr"
Import "GridFormat.rgr"
Import "GridChart.rgr"
Import "ChartInference.rgr"
Import "GridChartView.rgr"
Import "GridClip.rgr"
Import "script/GridScriptEngine.rgr"
Import "db/GridDbSource.rgr"

class GridApp {
    def book:WorkbookModel (new WorkbookModel)
    def model:SpreadsheetModel (new SpreadsheetModel)
    def sheetView:SheetView (new SheetView)
    def engine:FormulaEngine (new FormulaEngine)
    def sel:GridSelection (new GridSelection)
    def grid:DataGrid (new DataGrid)
    def view:GridView (new GridView)
    def W:int 900
    def H:int 560
    ; What the app would like its HOST to do about a file, and nothing more.
    ; Opening a picker is the one thing this class cannot do for itself: it
    ; does not know whether it is in a browser, a window, or on the end of a
    ; socket, and each of those answers differently. So `file.open` and
    ; `file.saveAs` only say what is wanted — "open" or "saveAs" — and whoever
    ; is hosting reads it, does the platform's part, and clears it.
    ; A host that ignores it loses nothing: Ctrl+S still writes beside the
    ; source file, as it always did.
    def fileRequest:string ""
    ; True when the HOST, not this class, decides where bytes end up — a
    ; browser tab has no directory to write a PDF into, so it asks for the
    ; bytes instead. A desktop host leaves this false and gets a file.
    def hostWritesFiles:boolean false
    ; Reports. A script lives in the workbook (script/GridScript.rgr), reads it
    ; through GridScriptData, and comes back as EVG — which the preview paints
    ; on this same canvas and the exporter writes as PDF. Nothing here is built
    ; until a script is actually run, so a workbook without one pays nothing.
    def scriptEngine:GridScriptEngine (new GridScriptEngine)
    def scriptIndex:int 0
    ; The PDF the last export produced, kept for hosts that hand bytes to a
    ; browser download rather than writing a file themselves.
    def pdfBytes:buffer (buffer_alloc 0)
    def pdfName:string ""
    ; A sheet whose rows are a database query, when the host bound one. Nothing
    ; is loaded and no engine is named until bindDatabase is called, so a build
    ; that never touches a database carries a class it never constructs.
    def db:GridDbSource (new GridDbSource)
    def statusH:int 22
    def editing:boolean false
    def editBuf:string ""
    def editCaret:int 0
    ; True when the edit started from (or is focused in) the formula bar —
    ; the caret is drawn there rather than only inside the cell.
    def editInFormulaBar:boolean false
    ; While editing a formula (`=…`), a click/drag on the sheet inserts a cell
    ; or range at the caret instead of committing — Excel's point-and-click.
    def formulaPicking:boolean false
    def pickR0:int 0
    def pickC0:int 0
    def pickR1:int 0
    def pickC1:int 0
    ; Byte range in editBuf of the ref last inserted by a pick, so a drag (or
    ; another click with the caret still on it) can replace rather than append.
    def pickTokStart:int -1
    def pickTokEnd:int -1
    def dragging:boolean false
    def resizing:boolean false
    def resizingRows:boolean false
    def resizeCol0:int -1
    def resizeCol1:int -1
    def filling:boolean false
    ; Dragging the selection's edge moves the block. The source is remembered
    ; because the drop has to read it after the pointer has left it.
    def movingRange:boolean false
    def moveR0:int 0
    def moveC0:int 0
    def moveR1:int 0
    def moveC1:int 0
    def moveGrabR:int 0
    def moveGrabC:int 0
    ; Dragging a formula-range overlay handle rewrites that A1:B2 in the formula.
    ; Picking a column up by its header and putting it somewhere else.
    ;
    ; `colDragFrom` is the column under the finger; `colDragArmed` says a press
    ; happened but the pointer has not moved far enough yet to mean "carry
    ; this" rather than "select this". `colDragTo` is where it would land.
    def colDragFrom:int -1
    def colDragTo:int -1
    def colDragArmed:boolean false
    def movingColumn:boolean false
    ; How fast the sheet is still moving, in pixels per frame, and what is
    ; left of a flick. A wheel notch is a shove, not a step: a slow one moves
    ; the sheet a little, a fast one carries.
    ; Where a text selection started inside the edit buffer, or -1 for none.
    def editSelAnchor:int -1
    def flingX:double 0.0
    def flingY:double 0.0
    ; What is left over when a frame's travel is not a whole number of pixels.
    def subX:double 0.0
    def subY:double 0.0
    def colDragStartX:int 0
    def formulaRangeDrag:boolean false
    def formulaRangeIdx:int 0
    def formulaRangeEdge:int 0
    def formulaRangeFixR:int 0
    def formulaRangeFixC:int 0
    def formulaRangeFixR1:int 0
    def formulaRangeFixC1:int 0
    def formulaRangeGrabC:int 0
    def formulaRangeStartedEdit:boolean false
    def fillR0:int 0
    def fillC0:int 0
    def fillR1:int 0
    def fillC1:int 0
    def clipboardTsv:string ""
    def clipboardHtml:string ""
    ; The chart flavours, empty unless a chart was the last thing copied.
    ; `clipboardKind` says which — a host that only speaks text can read it and
    ; not bother asking for the rest.
    def clipboardKind:string "cells"
    def clipboardPng:string ""
    def clipboardSvg:string ""
    ; The chart as a Vela document: the specification, the numbers it was made
    ; of, and how it is presented. A host hands this to anything that can draw
    ; Vela — the DOCX editor pastes it and keeps editing it.
    def clipboardChartJson:string ""
    def clipboardName:string ""
    def clipboardNote:string ""
    ; Bumped by every copy. A host polls this to notice that something new is
    ; on the clipboard — a chart is copied by a BUTTON as well as by Ctrl+C,
    ; and a pointer click tells the host nothing on its own.
    def clipboardSeq:int 0
    def clipper:ChartClipboard (new ChartClipboard)
    def clipR0:int 0
    def clipC0:int 0
    def clipRows:int 0
    def clipCols:int 0
    def clipValues:[string]
    def clipFormulas:[string]
    def clipStyles:[CellStyle]
    ; 0 = everything (default), 1 = values only, 2 = formats only,
    ; 3 = values + formulas but no formatting.
    def pasteMode:int 0
    ; Shared EVG dialog layer — the same windows the DOCX / PPTX hosts can use.
    def windows:EVGWindowManager (new EVGWindowManager)
    def pasteDialog:EVGWindow (new EVGWindow)
    ; Charts: the picker, and the description it is editing. The charts
    ; themselves live on the view's ChartLayer, because that is what paints
    ; them; this side only decides what they are.
    def chartDialog:EVGWindow (new EVGWindow)
    ; Find and replace. The strings live here rather than in the dialog so a
    ; search survives closing it, and so the whole thing can be driven without
    ; one — which is how it is tested.
    def findDialog:EVGWindow (new EVGWindow)
    def findQuery:string ""
    def replaceWith:string ""
    def findMatchCase:boolean false
    def findWholeCell:boolean false
    ; Excel's "look in": formulas or values. A cell holding =A1+B1 shows 5 and
    ; contains "A1+B1", and which of those you meant to search is a real
    ; question rather than an implementation detail.
    def findInFormulas:boolean true
    def findAllSheets:boolean false
    def findStatus:string ""
    ; The conditional-formatting rule editor.
    def cfDialog:EVGWindow (new EVGWindow)
    def cfStatus:string ""
    ; The last refusal, so a host can show it and a test can read it.
    def validationError:string ""
    ; The link the user just followed. The app cannot open a browser; it says
    ; what was activated and the host decides.
    def activatedLink:string ""
    ; Dialogs for the two things a cell can carry besides a value.
    def linkDialog:EVGWindow (new EVGWindow)
    def dvDialog:EVGWindow (new EVGWindow)
    def listDialog:EVGWindow (new EVGWindow)
    ; Text / fill colour picker. One dialog, two modes: which format op it
    ; applies when the user confirms.
    def colorDialog:EVGWindow (new EVGWindow)
    ; The SQL box. A database sheet can be described by typing the query that
    ; makes it, which is the only way to reach the parts of SQL a QuerySpec
    ; built in code does not have a button for.
    def sqlDialog:EVGWindow (new EVGWindow)
    def dbSqlText:string ""
    def dbSqlStatus:string ""
    ; The connection window: what this workbook is talking to, and the way to
    ; point it somewhere else. The app cannot open a database itself - naming
    ; an engine is the host's job, the same way opening a file picker is - so
    ; asking for one is a REQUEST the host reads and clears, like fileRequest.
    def connDialog:EVGWindow (new EVGWindow)
    def dbDriver:string ""
    def dbDsn:string ""
    def dbTable:string ""
    def dbRequest:string ""
    def dbRequestDriver:string ""
    def dbRequestDsn:string ""
    def dbRequestTable:string ""
    def dbConnStatus:string ""
    def colorDialogOp:string "color"
    ; The border gallery. Three toolbar words could not say "a medium red line
    ; under this block and nothing else", so the buttons open this instead:
    ; which edges, which line, which colour, with the answer drawn as a
    ; four-cell picture before it is applied to anything.
    def borderDialog:EVGWindow (new EVGWindow)
    def borderLine:string "thin"
    def borderInk:string "#000000"
    ; Renaming a sheet, and which one.
    ; Whether the title in the picker's box is the one the app worked out or
    ; one the reader typed. Changing the question rewrites the first and must
    ; never touch the second.
    def chartTitleIsOurs:boolean true
    def renameDialog:EVGWindow (new EVGWindow)
    def renameIndex:int 0
    def renameStatus:string ""
    ; A tab being carried. `tabDragArmed` is the same idea as `colDragArmed`:
    ; a press on a tab is a click until the pointer has travelled far enough
    ; that it cannot be one.
    def tabDragFrom:int -1
    def tabDragStartX:int 0
    def tabDragArmed:boolean false
    def movingTab:boolean false
    def colorPick:string "#C00000"
    def colorRecent:[string]
    ; Live preview while the palette is open: styles before the picker ran,
    ; restored on Cancel / Escape, and committed as one undo on Apply.
    def colorPreviewOn:boolean false
    def colorPreviewCommitted:boolean false
    def colorSnapRows:[int]
    def colorSnapCols:[int]
    def colorSnapStyles:[CellStyle]
    def listValues:[string]
    def dvKind:int 701
    def dvOp:int 721
    def dvV1:string ""
    def dvV2:string ""
    def dvBlank:boolean true
    def dvStatus:string ""
    ; What the editor was last set to. Kept here rather than read back off the
    ; dialog, because adding a rule rebuilds it — and a form that forgets what
    ; you just typed is a form you have to retype.
    def cfTest:int 601
    def cfFill:int 621
    def cfFillHex:string "#FFC7CE"
    def cfV1:string "0"
    def cfV2:string ""
    def pendingChart:GridChart (new GridChart)
    ; The chart the picker is editing, or 0 when it is making a new one.
    def chartEditId:int 0
    def dialogsReady:boolean false
    ; Format painter: armed by Ctrl+Shift+C, applied to the next selection.
    def formatBrush:CellStyle (new CellStyle)
    def formatBrushArmed:boolean false
    def clipCut:boolean false
    def loadError:string ""
    ; Where the last save went, so a host can tell the user — and so a test
    ; can check that it went anywhere at all.
    def savedPath:string ""
    ; Everything the grid can do, by name — see GridCommands. Built once, so a
    ; host can enumerate it before the first frame.
    def commands:GridCommandTable (new GridCommandTable)
    def commandsReady:boolean false
    ; The last custom tool that was run, waiting to be collected. Ranger has no
    ; closures to hand a host, so a registered tool is a mailbox: running it
    ; leaves the id here and the host takes it.
    def pendingCustom:string ""
    def pendingCustomArg:string ""

    Constructor () {
    }

    fn syncActiveModel:void () {
        ; persist scroll on previous sheet
        if ((book.sheetCount()) > 0) {
            ; model may already point at previous
        }
        model = (book.activeSheet())
        sheetView.attach(model)
        grid.bindView(sheetView)
        grid.scrollX = model.scrollXSaved
        grid.scrollY = model.scrollYSaved
        sel.anchor.row = 0
        sel.anchor.col = 0
        sel.active.row = 0
        sel.active.col = 0
        grid.updateVisible(model)
    }

    fn init:void (fontDir:string) {
        view.init(W H fontDir)
        ; The report engine measures with the same faces the grid draws with.
        ; Two font searches would be two answers to "how wide is this string",
        ; and the preview would stop agreeing with the PDF.
        scriptEngine.fontsDir = fontDir
        ; The view paints the windows and the charts, so it is given them once
        ; here rather than on every frame — anything that builds a display list
        ; directly (a test, a dump) then sees the same scene the app does.
        view.windows = windows
        this.buildCommands()
        view.commands = commands
        view.toolbar.build()
        grid.toolbarH = (view.toolbar.heightFor(W))
        grid.setBounds(0 0 W (H - statusH))
        this.loadDemo()
    }

    ; Start without touching the file system: the browser build has no fonts to
    ; read and no workbook to open until it has fetched them. Everything else —
    ; the command table, the window layer, the grid's bounds — is the same as
    ; `init` does.
    fn initBare:void () {
        view.initBare(W H)
        view.windows = windows
        this.buildCommands()
        view.commands = commands
        view.toolbar.build()
        grid.toolbarH = (view.toolbar.heightFor(W))
        grid.setBounds(0 0 W (H - statusH))
    }

    ; A face, from bytes. The first one loaded becomes the family the grid
    ; draws with; the rest are the bold and italic cuts it switches to.
    fn addFontBytes:boolean (family:string data:buffer) {
        return (view.ctx.tr.loadFontBytes(family data))
    }

    fn addFaceBytes:boolean (data:buffer) {
        return (view.ctx.tr.addFaceBytes(data))
    }

    fn loadDemo:void () {
        book.clear()
        def sheet:SpreadsheetModel (new SpreadsheetModel)
        sheet.seedDemo()
        book.addSheet(sheet)
        book.sourcePath = ""
        book.setActive(0)
        engine.attach(book)
        engine.rebuildAll()
        this.syncActiveModel()
        loadError = ""
    }

    ; A brand-new empty workbook — one blank sheet, no path yet. Save then asks
    ; the host where to put it (Save As).
    fn newBlankWorkbook:void () {
        if editing {
            this.commitEdit()
        }
        view.chartLayer.removeAll(windows)
        book.clear()
        def sheet:SpreadsheetModel (new SpreadsheetModel)
        sheet.seedBlank()
        book.addSheet(sheet)
        book.sourcePath = ""
        book.setActive(0)
        engine.attach(book)
        engine.rebuildAll()
        this.syncActiveModel()
        loadError = ""
        savedPath = ""
        view.status = "new workbook"
    }

    ; The workbook from bytes: what a browser has after a fetch, and what a
    ; drag-and-dropped file is. Same path as `loadXlsx` past the read.
    fn loadXlsxBytes:boolean (bytes:buffer name:string) {
        return (this.loadXlsxBytesPassword(bytes name ""))
    }

    fn loadXlsxBytesPassword:boolean (bytes:buffer name:string password:string) {
        def loader:XlsxLoader (new XlsxLoader)
        def ok:boolean (loader.loadBytesPassword(bytes book password))
        if ok {
            view.chartLayer.removeAll(windows)
            book.sourcePath = name
            engine = loader.engine
            this.syncActiveModel()
            loadError = ""
            view.status = ("loaded " + name)
            return true
        }
        loadError = loader.lastError
        view.status = loadError
        return false
    }

    fn loadXlsx:boolean (fullPath:string) {
        return (this.loadXlsxPassword(fullPath ""))
    }

    fn loadXlsxPassword:boolean (fullPath:string password:string) {
        def loader:XlsxLoader (new XlsxLoader)
        def ok:boolean (loader.loadPathPassword(fullPath book password))
        if ok {
            ; The charts belonged to the workbook that was open. Left up, they
            ; would go on drawing ranges of a document nobody has any more.
            view.chartLayer.removeAll(windows)
            book.sourcePath = fullPath
            engine = loader.engine
            this.syncActiveModel()
            loadError = ""
            view.status = ("loaded " + fullPath)
            return true
        }
        loadError = loader.lastError
        view.status = loadError
        return false
    }

    ; --- database sheets ------------------------------------------------------
    ; A query becomes a sheet. The workbook may hold both kinds at once: an
    ; .xlsx sheet next to a live table, in the same document, with the same
    ; formulas and the same charts over either.
    fn bindDatabase:boolean (dbSession:DBSession querySpec:QuerySpec keys:[string] sheetName:string) {
        if editing {
            this.commitEdit()
        }
        def sheet:SpreadsheetModel (new SpreadsheetModel)
        sheet.name = sheetName
        if ((strlen sheet.name) == 0) {
            sheet.name = querySpec.table
        }
        book.addSheet(sheet)
        def idx:int ((book.sheetCount()) - 1)
        book.setActive(idx)
        db.bindQuery(dbSession querySpec idx)
        if ((array_length keys) > 0) {
            db.setKeys(keys)
        } {
            db.adoptKeysFromTable()
        }
        def ok:boolean (db.loadInto(sheet))
        engine.attach(book)
        engine.rebuildAll()
        this.syncActiveModel()
        view.status = db.status
        return ok
    }

    ; The same, from typed SQL, into a sheet of its own. RangerSQL parses it
    ; and SqlFront plans it into a QuerySpec where it can, so a typed SELECT
    ; gives an ordinary editable database sheet; anything beyond the planner
    ; runs as raw SQL and the sheet says it is read only.
    ;
    ; The query is bound BEFORE the sheet is made: a statement this engine
    ; refuses used to leave an empty tab behind as evidence of the attempt.
    fn bindDatabaseSql:boolean (dbSession:DBSession sql:string sheetName:string) {
        if editing {
            this.commitEdit()
        }
        def idx:int (book.sheetCount())
        def bound:boolean (db.bindSqlQuery(dbSession sql idx))
        if (bound == false) {
            dbSqlStatus = db.status
            view.status = db.status
            return false
        }
        def sheet:SpreadsheetModel (new SpreadsheetModel)
        def base:string sheetName
        def autoName:boolean ((strlen base) == 0)
        if autoName {
            base = db.writeTable
            if ((strlen base) == 0) {
                base = "SQL"
            }
        }
        sheet.name = (book.uniqueName(base))
        book.addSheet(sheet)
        book.setActive(idx)
        return (this.fillSheetFromSql(sheet sql))
    }

    ; The same query into the sheet in front of the user. This is the
    ; difference between working on a question and collecting the answers to
    ; every version of it: iterating on a SELECT used to leave a sheet behind
    ; on every run, and none of them said which query had made it.
    fn updateDatabaseSql:boolean (dbSession:DBSession sql:string) {
        if editing {
            this.commitEdit()
        }
        def idx:int book.activeIndex
        if (idx < 0) {
            dbSqlStatus = "there is no sheet to put the result in"
            view.status = dbSqlStatus
            return false
        }
        if (idx >= (book.sheetCount())) {
            dbSqlStatus = "there is no sheet to put the result in"
            view.status = dbSqlStatus
            return false
        }
        def bound:boolean (db.bindSqlQuery(dbSession sql idx))
        if (bound == false) {
            dbSqlStatus = db.status
            view.status = db.status
            return false
        }
        def sheet:SpreadsheetModel (book.sheetAt(idx))
        return (this.fillSheetFromSql(sheet sql))
    }

    ; What both of them do once the sheet is decided. The sheet is told which
    ; query it holds, so selecting it later brings that query back into the
    ; box.
    fn fillSheetFromSql:boolean (sheet:SpreadsheetModel sql:string) {
        def ok:boolean (db.loadInto(sheet))
        sheet.dbSql = sql
        engine.attach(book)
        engine.rebuildAll()
        this.syncActiveModel()
        dbSqlText = sql
        dbSqlStatus = db.status
        view.status = db.status
        return ok
    }

    ; Run a query against the session this app already has - which is the one
    ; the bound sheet came from. Without one there is nothing to ask.
    ;
    ; It replaces the sheet in front of the user when a query made that sheet,
    ; and makes a new one otherwise: re-running is the common case, and a
    ; sheet per run is how a workbook fills up with tabs nobody asked for.
    ; `runSqlAsNewSheet` is the other button.
    fn runSqlQuery:boolean (sql:string) {
        return (this.runSqlInto(sql (this.sqlSheetActive())))
    }

    fn runSqlAsNewSheet:boolean (sql:string) {
        return (this.runSqlInto(sql false))
    }

    fn runSqlInto:boolean (sql:string inPlace:boolean) {
        if (db.bound == false) {
            dbSqlStatus = "no database is open - start the app with a database sheet"
            view.status = dbSqlStatus
            return false
        }
        def session:DBSession db.session
        def trimmed:string (trim sql)
        if ((strlen trimmed) == 0) {
            dbSqlStatus = "type a query first"
            view.status = dbSqlStatus
            return false
        }
        if inPlace {
            return (this.updateDatabaseSql(session trimmed))
        }
        return (this.bindDatabaseSql(session trimmed ""))
    }

    ; Was the sheet in front of the user made by a query? This is not the same
    ; question as `dbSheetActive`: a table sheet bound from a QuerySpec is a
    ; database sheet too, and Update must not quietly overwrite it with
    ; something typed into the box - so it is the query-made sheets that are
    ; offered for replacement, and the rest have to be asked for by name.
    fn sqlSheetActive:boolean () {
        if ((book.sheetCount()) == 0) {
            return false
        }
        def sheet:SpreadsheetModel (book.activeSheet())
        return ((strlen sheet.dbSql) > 0)
    }

    ; The name of the sheet an Update would replace.
    fn activeSheetName:string () {
        if ((book.sheetCount()) == 0) {
            return ""
        }
        def sheet:SpreadsheetModel (book.activeSheet())
        return sheet.name
    }

    ; What the host connected, so the connection window can say it. The app
    ; only ever holds a DBSession; which driver and which data source produced
    ; it is knowledge the host has.
    fn noteConnection:void (driver:string dsn:string table:string) {
        dbDriver = driver
        dbDsn = dsn
        dbTable = table
        ; The window that asked for this connection is still on screen showing
        ; the OLD one - the host answers after the click, not during it - so it
        ; is rebuilt here rather than left lying about what is connected.
        if connDialog.visible {
            this.reopenConnectionDialog()
        }
    }

    ; --- the connection window --------------------------------------------------
    fn connectionEngine:string () {
        if (db.bound == false) {
            return "not connected"
        }
        return (db.session.engineName())
    }

    fn connectionSource:string () {
        if ((strlen dbDsn) == 0) {
            return ":memory:"
        }
        return dbDsn
    }

    fn connectionTable:string () {
        if ((strlen db.writeTable) > 0) {
            return db.writeTable
        }
        return dbTable
    }

    fn connectionKeys:string () {
        def n:int (array_length db.keyNames)
        if (n == 0) {
            return "none - the sheet is read only"
        }
        def out:string ""
        def i:int 0
        while (i < n) {
            if (i > 0) {
                out = (out + ", ")
            }
            out = (out + (itemAt db.keyNames i))
            i = (i + 1)
        }
        return out
    }

    fn connectionRows:string () {
        def out:string (to_string db.loadedRows)
        if (db.totalRows > db.loadedRows) {
            out = (out + " of " + (to_string db.totalRows))
        }
        return (out + " rows")
    }

    fn openConnectionDialog:void () {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        connDialog.title = "Database connection"
        connDialog.w = 470
        connDialog.labelW = 96
        connDialog.reset()
        def driverValue:string dbDriver
        if ((strlen driverValue) == 0) {
            driverValue = "auto"
        }
        connDialog.addInput(721 "Engine" driverValue)
        connDialog.addInput(722 "Data source" (this.connectionSource()))
        connDialog.addInput(723 "Table" (this.connectionTable()))
        connDialog.addSeparator()
        connDialog.addLabel(("connected: " + (this.connectionEngine())))
        if db.bound {
            connDialog.addLabel(("rows: " + (this.connectionRows())))
            connDialog.addLabel(("key columns: " + (this.connectionKeys())))
            def caps:DBCapabilities (db.session.capabilities())
            connDialog.addLabel(("engine can: " + (caps.describe())))
            def fb:string db.session.lastFallback
            if ((strlen fb) > 0) {
                connDialog.addLabel(("ranger did: " + fb))
            } {
                connDialog.addLabel("ranger did: nothing - the engine took it all")
            }
            if db.readOnly {
                connDialog.addLabel(("read only: " + db.readOnlyReason))
            }
            def err:string (db.session.lastError())
            if ((strlen err) > 0) {
                connDialog.addLabel(("last error: " + err))
            }
        } {
            connDialog.addLabel("no database is open")
        }
        if ((strlen dbConnStatus) > 0) {
            connDialog.addLabel(dbConnStatus)
        }
        def ids:[int]
        def labels:[string]
        push ids 731
        push labels "Close"
        push ids 732
        push labels "Refresh"
        push ids 733
        push labels "Connect"
        connDialog.addButtonRow(ids labels 733)
        connDialog.finish()
        def px:int (grid.x + (idiv (W - connDialog.w) 2))
        def py:int (grid.y + 50)
        connDialog.openWithin(px py W H)
        windows.raise(connDialog)
        connDialog.focusedId = 721
        view.focused = true
    }

    ; Connecting is the host's part. The app writes down what was asked for and
    ; whoever is hosting - the window server, the SDL binary, a test - reads it,
    ; opens the engine and calls bindDatabase. A host that ignores it loses
    ; nothing: the sheet it already has keeps working.
    fn requestConnection:void (driver:string dsn:string table:string) {
        dbRequest = "connect"
        dbRequestDriver = driver
        dbRequestDsn = dsn
        dbRequestTable = table
        dbConnStatus = ("connecting to " + driver + " " + dsn + " …")
        view.status = dbConnStatus
    }

    fn takeDbRequest:string () {
        def r:string dbRequest
        dbRequest = ""
        return r
    }

    fn connectFromDialog:void () {
        def driver:string (trim (connDialog.inputValue(721)))
        def dsn:string (trim (connDialog.inputValue(722)))
        def table:string (trim (connDialog.inputValue(723)))
        if ((strlen table) == 0) {
            dbConnStatus = "name a table to open"
            this.reopenConnectionDialog()
            return
        }
        this.requestConnection(driver dsn table)
        this.reopenConnectionDialog()
    }

    fn reopenConnectionDialog:void () {
        def kx:int connDialog.x
        def ky:int connDialog.y
        this.openConnectionDialog()
        connDialog.x = kx
        connDialog.y = ky
    }

    ; --- the SQL box ----------------------------------------------------------
    ; What is in the database, as one line per table:
    ;
    ;     sales(id*, region, country, month, revenue, units)
    ;
    ; A star marks a key column, because that is the one that decides whether a
    ; sheet built from a query can be edited. Asking the session rather than
    ; remembering it means this is right after a reconnect too.
    fn schemaLines:[string] () {
        def out:[string]
        if (db.bound == false) {
            return out
        }
        def names:[string] (db.session.tableNames())
        def n:int (array_length names)
        def i:int 0
        while (i < n) {
            if (i >= 6) {
                push out ("… and " + (to_string (n - 6)) + " more")
                return out
            }
            def table:string (itemAt names i)
            def cols:[DBColumn] (db.session.tableColumns(table))
            def line:string (table + "(")
            def c:int 0
            def cn:int (array_length cols)
            while (c < cn) {
                if (c > 0) {
                    line = (line + ", ")
                }
                def col:DBColumn (itemAt cols c)
                line = (line + col.name)
                if col.key {
                    line = (line + "*")
                }
                c = (c + 1)
            }
            push out (line + ")")
            i = (i + 1)
        }
        return out
    }

    ; Queries written against THIS database rather than against a manual: the
    ; table, the key, a text column and a number column are picked out of the
    ; schema, so every example runs as it stands.
    fn exampleQueries:[string] () {
        def out:[string]
        if (db.bound == false) {
            return out
        }
        def names:[string] (db.session.tableNames())
        if ((array_length names) == 0) {
            return out
        }
        def table:string (itemAt names 0)
        def cols:[DBColumn] (db.session.tableColumns(table))
        def keyCol:string ""
        def textCol:string ""
        def numCol:string ""
        def i:int 0
        while (i < (array_length cols)) {
            def col:DBColumn (itemAt cols i)
            if col.key {
                if ((strlen keyCol) == 0) {
                    keyCol = col.name
                }
            }
            if (col.kind == 4) {
                if ((strlen textCol) == 0) {
                    textCol = col.name
                }
            }
            if (DBType.isNumeric(col.kind)) {
                if ((strlen numCol) == 0) {
                    if (col.key == false) {
                        numCol = col.name
                    }
                }
            }
            i = (i + 1)
        }
        if ((strlen keyCol) == 0) {
            if ((array_length cols) > 0) {
                def first:DBColumn (itemAt cols 0)
                keyCol = first.name
            }
        }
        push out ("SELECT * FROM " + table + " LIMIT 20")
        if ((strlen numCol) > 0) {
            if ((strlen textCol) > 0) {
                push out ("SELECT " + textCol + ", SUM(" + numCol + ") AS total FROM " + table + " GROUP BY " + textCol + " ORDER BY total DESC")
                push out ("SELECT * FROM " + table + " WHERE " + textCol + " LIKE 'A%'")
            }
            push out ("SELECT * FROM " + table + " ORDER BY " + numCol + " DESC LIMIT 10")
        }
        if ((strlen keyCol) > 0) {
            push out ("SELECT COUNT(*) AS rows FROM " + table)
        }
        return out
    }

    ; Short names for the buttons that fill the box.
    sfn exampleLabel:string (index:int) {
        if (index == 0) {
            return "first 20"
        }
        if (index == 1) {
            return "group"
        }
        if (index == 2) {
            return "filter"
        }
        if (index == 3) {
            return "top 10"
        }
        return "count"
    }

    fn useExample:void (index:int) {
        def examples:[string] (this.exampleQueries())
        if (index < 0) {
            return
        }
        if (index >= (array_length examples)) {
            return
        }
        dbSqlText = (itemAt examples index)
        dbSqlStatus = "example put in the box - Update replaces this sheet, New sheet adds one"
        def kx:int sqlDialog.x
        def ky:int sqlDialog.y
        this.openSqlDialog()
        sqlDialog.x = kx
        sqlDialog.y = ky
    }

    fn openSqlDialog:void () {
        this.buildDialogs()
        if editing {
            this.commitEdit()
        }
        sqlDialog.title = "SQL query"
        sqlDialog.w = 560
        sqlDialog.labelW = 40
        sqlDialog.reset()
        sqlDialog.addInput(701 "SQL" dbSqlText)
        if ((strlen dbSqlStatus) > 0) {
            sqlDialog.addLabel(dbSqlStatus)
        } {
            if (db.bound) {
                sqlDialog.addLabel(("engine: " + (db.session.engineName())))
            } {
                sqlDialog.addLabel("no database is open")
            }
        }
        ; What is in there to query. Without it the box is a prompt with no
        ; manual: the one thing a person needs before writing a SELECT is the
        ; names of the tables and their columns.
        def schema:[string] (this.schemaLines())
        if ((array_length schema) > 0) {
            sqlDialog.addSeparator()
            sqlDialog.addLabel("tables (* is a key column):")
            def si:int 0
            while (si < (array_length schema)) {
                sqlDialog.addLabel(("   " + (itemAt schema si)))
                si = (si + 1)
            }
        }
        def examples:[string] (this.exampleQueries())
        if ((array_length examples) > 0) {
            sqlDialog.addSeparator()
            sqlDialog.addLabel("examples, written for this database - click one:")
            def exIds:[int]
            def exLabels:[string]
            def ei:int 0
            while (ei < (array_length examples)) {
                push exIds (741 + ei)
                push exLabels (GridApp.exampleLabel(ei))
                ei = (ei + 1)
            }
            sqlDialog.addButtonRow(exIds exLabels -1)
        }
        ; Where the result goes. A workbook fills up with tabs when every run
        ; makes a sheet, so the two are separate buttons and the one that
        ; replaces what is already on screen is the default while the sheet in
        ; front of the user is a query's own.
        def onSql:boolean (this.sqlSheetActive())
        sqlDialog.addSeparator()
        if onSql {
            sqlDialog.addLabel(("Update replaces the sheet you are on: " + (this.activeSheetName())))
        } {
            sqlDialog.addLabel("New sheet adds a tab; Update replaces the sheet you are on")
        }
        def ids:[int]
        def labels:[string]
        push ids 711
        push labels "Close"
        push ids 712
        push labels "Update"
        push ids 713
        push labels "New sheet"
        def defaultId:int 713
        if onSql {
            defaultId = 712
        }
        sqlDialog.addButtonRow(ids labels defaultId)
        sqlDialog.finish()
        def px:int (grid.x + (idiv (W - sqlDialog.w) 2))
        def py:int (grid.y + 60)
        sqlDialog.openWithin(px py W H)
        windows.raise(sqlDialog)
        sqlDialog.focusedId = 701
        view.focused = true
    }

    fn runSqlFromDialog:void () {
        this.runSqlFromDialogInto((this.sqlSheetActive()))
    }

    fn newSheetFromDialog:void () {
        this.runSqlFromDialogInto(false)
    }

    fn runSqlFromDialogInto:void (inPlace:boolean) {
        dbSqlText = (sqlDialog.inputValue(701))
        this.runSqlInto(dbSqlText inPlace)
        ; Reopen so the box shows what happened, with the query still in it.
        def kx:int sqlDialog.x
        def ky:int sqlDialog.y
        this.openSqlDialog()
        sqlDialog.x = kx
        sqlDialog.y = ky
    }

    ; Is the sheet in front of the user the database one? Everything below
    ; asks this rather than "is a database bound", because a workbook with a
    ; live sheet in it still has ordinary sheets that must behave ordinarily.
    fn dbSheetActive:boolean () {
        if (db.bound == false) {
            return false
        }
        return (db.sheetIndex == book.activeIndex)
    }

    ; After the sheet's cells were replaced by a new query result.
    fn afterDbReload:void () {
        sheetView.markDirty()
        sheetView.rebuild()
        engine.rebuildAll()
        grid.updateVisible(model)
        view.status = db.status
    }

    fn refreshDatabaseSheet:boolean () {
        if ((this.dbSheetActive()) == false) {
            return false
        }
        def ok:boolean (db.refresh(model))
        this.afterDbReload()
        return ok
    }

    ; The host's clock, in the only form the engine cares about. A platform
    ; that has a calendar calls this once at start-up; a test calls it with the
    ; date it wants to reason about.
    fn setToday:void (y:int m:int d:int) {
        engine.todaySerial = (DateSerial.fromYMD(y m d))
    }


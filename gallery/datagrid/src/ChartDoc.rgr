; ==============================================================================
; ChartDoc.rgr — a chart as a document, not as a picture.
; ==============================================================================
;
; A chart copied out of the grid used to travel as pixels. Pixels are what a
; word processor can PASTE, but they are not something it can EDIT: the numbers,
; the kind, the palette are all gone the moment the bitmap is made.
;
; So a chart also travels as this: one JSON object carrying
;
;   spec    the Vega-Lite specification, data and all — what a RENDERER needs,
;           handed to Vela unchanged, no spreadsheet in sight
;   cells   the little table the chart was made of — what an EDITOR needs, so
;           it can ask for a different kind and get a different chart rather
;           than a differently-labelled one
;   the presentation: kind, style, title, legend, header flags, box size
;
; Both are in there on purpose. A reader that only draws stops at `spec`. A
; reader that edits regenerates `spec` from `cells` after every change through
; the SAME generator the spreadsheet uses (`ChartData.specJson`), which is what
; stops the two from drifting: nothing edits the specification by hand.
;
; The carried table is a tiny SpreadsheetModel — the same class the grid uses —
; because that is what makes "the same generator" literally true rather than
; approximately true.
;
; It rides in the clipboard's HTML flavour as an attribute on the picture:
;
;   <img src="data:image/png;base64,…" data-ranger-chart="{&quot;ranger&quot;:…}">
;
; A program that does not know the attribute pastes the picture and loses
; nothing it ever had. A program that does — the DOCX editor here — pastes a
; chart it can go on editing. HTML-escaped rather than base64 so it stays
; readable to anyone implementing the other end.
; ==============================================================================

Import "GridChart.rgr"
Import "SpreadsheetModel.rgr"
Import "../../vela/src/VlJson.rgr"

class ChartDoc {
    def ok:boolean false
    def note:string ""
    ; The presentation and the range, as a chart the grid would recognise.
    def chart:GridChart (new GridChart)
    ; The numbers, as their own sheet.
    def cells:SpreadsheetModel (new SpreadsheetModel)
    ; The specification as it was carried. Regenerated by `rebuildSpec`.
    def spec:string ""

    Constructor () {
    }

    fn rows:int () {
        return ((chart.r1 - chart.r0) + 1)
    }

    fn cols:int () {
        return ((chart.c1 - chart.c0) + 1)
    }

    ; The specification for this chart at a given size, generated from the
    ; carried cells. Every edit goes through here, so `spec` is never written
    ; by hand and can never disagree with the settings beside it.
    fn rebuildSpec:string (plotW:int plotH:int) {
        def data (new ChartData)
        if ((data.extract(cells chart)) == false) {
            return spec
        }
        spec = (data.specJson(chart plotW plotH))
        return spec
    }

    ; Whether the carried table can still make the kind it says it is — a
    ; document edited down to one series cannot stay a stacked bar.
    fn suits:boolean (kind:int) {
        def data (new ChartData)
        if ((data.extract(cells chart)) == false) {
            return false
        }
        return (data.suits(kind))
    }
}

class ChartDocCodec {
    ; What the `ranger` member says, and the version of the shape below it. A
    ; reader checks both before believing any of it.
    sfn tag:string () {
        return "vela-chart"
    }

    sfn version:int () {
        return 1
    }

    sfn attrName:string () {
        return "data-ranger-chart"
    }

    sfn jsonEsc:string (s:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def ch:int (charAt s i)
            if (ch == 34) {
                out = (out + "\\\"")
            } {
                if (ch == 92) {
                    out = (out + "\\\\")
                } {
                    if (ch == 10) {
                        out = (out + "\\n")
                    } {
                        if (ch == 9) {
                            out = (out + "\\t")
                        } {
                            if (ch == 13) {
                                out = (out + "\\r")
                            } {
                                out = (out + (substring s i (i + 1)))
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    sfn boolJson:string (v:boolean) {
        if v {
            return "true"
        }
        return "false"
    }

    ; The chart's own rectangle of cells, as rows of strings. Values, not
    ; formulas: a chart in a document has no sheet to recalculate against.
    sfn cellsJson:string (model:SpreadsheetModel ch:GridChart) {
        def out:string "["
        def r:int ch.r0
        while (r <= ch.r1) {
            if (r > ch.r0) {
                out = (out + ",")
            }
            out = (out + "[")
            def ci:int 0
            while (ci < (ch.sourceColCount())) {
                if (ci > 0) {
                    out = (out + ",")
                }
                def c:int (ch.sourceColAt(ci))
                out = (out + "\"" + (ChartDocCodec.jsonEsc((model.getCell(r c)))) + "\"")
                ci = (ci + 1)
            }
            out = (out + "]")
            r = (r + 1)
        }
        return (out + "]")
    }

    ; One chart, as the document that describes it.
    sfn encode:string (model:SpreadsheetModel ch:GridChart) {
        def data (new ChartData)
        def spec:string ""
        if (data.extract(model ch)) {
            spec = (data.specJson(ch ch.w ch.h))
        }
        def out:string "{"
        out = (out + "\"ranger\":\"" + (ChartDocCodec.tag()) + "\",")
        out = (out + "\"v\":" + (to_string (ChartDocCodec.version())) + ",")
        out = (out + "\"title\":\"" + (ChartDocCodec.jsonEsc(ch.title)) + "\",")
        out = (out + "\"kind\":" + (to_string ch.kind) + ",")
        out = (out + "\"style\":" + (to_string ch.style) + ",")
        out = (out + "\"legend\":" + (ChartDocCodec.boolJson(ch.showLegend)) + ",")
        out = (out + "\"headerRow\":" + (ChartDocCodec.boolJson(ch.useHeaderRow)) + ",")
        out = (out + "\"headerCol\":" + (ChartDocCodec.boolJson(ch.useHeaderCol)) + ",")
        out = (out + "\"w\":" + (to_string ch.w) + ",")
        out = (out + "\"h\":" + (to_string ch.h) + ",")
        ; Where it came from, for a reader that wants to say so. Nothing here
        ; depends on the range still existing.
        out = (out + "\"source\":\"" + (ChartDocCodec.jsonEsc((ch.rangeLabel()))) + "\",")
        out = (out + "\"cells\":" + (ChartDocCodec.cellsJson(model ch)) + ",")
        if ((strlen spec) > 0) {
            out = (out + "\"spec\":" + spec)
        } {
            out = (out + "\"spec\":null")
        }
        return (out + "}")
    }

    ; …and back. Anything that is not this format returns `ok = false` with a
    ; reason rather than a half-built chart.
    sfn decode:ChartDoc (text:string) {
        def doc (new ChartDoc)
        if ((strlen text) == 0) {
            doc.note = "empty"
            return doc
        }
        def parser (new VlJsonParser())
        def root:VlJson (parser.parse(text))
        if (parser.ok == false) {
            doc.note = "not json"
            return doc
        }
        if ((root.isObject()) == false) {
            doc.note = "not an object"
            return doc
        }
        if ((root.stringOr("ranger" "")) != (ChartDocCodec.tag())) {
            doc.note = "not a vela chart"
            return doc
        }
        def v:int (to_int (root.doubleOr("v" 0.0)))
        if (v > (ChartDocCodec.version())) {
            doc.note = "a newer chart than this build understands"
            return doc
        }
        def rows:VlJson (root.get("cells"))
        if ((rows.isArray()) == false) {
            doc.note = "no cells"
            return doc
        }
        def rowCount:int (rows.count())
        if (rowCount == 0) {
            doc.note = "no rows"
            return doc
        }
        def widest:int 0
        def r:int 0
        while (r < rowCount) {
            def row:VlJson (rows.at(r))
            if (row.isArray()) {
                def n:int (row.count())
                if (n > widest) {
                    widest = n
                }
                def c:int 0
                while (c < n) {
                    def cell:VlJson (row.at(c))
                    doc.cells.setCell(r c (cell.asString()))
                    c = (c + 1)
                }
            }
            r = (r + 1)
        }
        if (widest == 0) {
            doc.note = "no columns"
            return doc
        }
        doc.chart.r0 = 0
        doc.chart.c0 = 0
        doc.chart.r1 = (rowCount - 1)
        doc.chart.c1 = (widest - 1)
        doc.chart.kind = (to_int (root.doubleOr("kind" 1.0)))
        doc.chart.style = (to_int (root.doubleOr("style" 1.0)))
        doc.chart.title = (root.stringOr("title" ""))
        doc.chart.showLegend = (root.boolOr("legend" true))
        doc.chart.useHeaderRow = (root.boolOr("headerRow" true))
        doc.chart.useHeaderCol = (root.boolOr("headerCol" true))
        doc.chart.w = (to_int (root.doubleOr("w" 380.0)))
        doc.chart.h = (to_int (root.doubleOr("h" 260.0)))
        if (doc.chart.kind < (ChartKind.lowest())) {
            doc.chart.kind = (ChartKind.lowest())
        }
        if (doc.chart.kind > (ChartKind.highest())) {
            doc.chart.kind = (ChartKind.highest())
        }
        if (doc.chart.style < (ChartStyle.lowest())) {
            doc.chart.style = (ChartStyle.lowest())
        }
        if (doc.chart.style > (ChartStyle.highest())) {
            doc.chart.style = (ChartStyle.highest())
        }
        def spec:VlJson (root.get("spec"))
        if (spec.isObject()) {
            def writer (new VlJsonWriter)
            doc.spec = (writer.write(spec))
        }
        ; A carried specification is a convenience; the cells are the truth. If
        ; the two ever disagree the cells win, because that is what an edit
        ; will regenerate from.
        if ((strlen doc.spec) == 0) {
            doc.rebuildSpec(doc.chart.w doc.chart.h)
        }
        doc.ok = true
        return doc
    }

    ; --- riding in HTML -------------------------------------------------------
    sfn attrEscape:string (s:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def ch:int (charAt s i)
            if (ch == 38) {
                out = (out + "&amp;")
            } {
                if (ch == 34) {
                    out = (out + "&quot;")
                } {
                    if (ch == 60) {
                        out = (out + "&lt;")
                    } {
                        if (ch == 62) {
                            out = (out + "&gt;")
                        } {
                            out = (out + (substring s i (i + 1)))
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    sfn attrUnescape:string (s:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def ch:int (charAt s i)
            if (ch == 38) {
                def rest:string (substring s i (strlen s))
                if ((strlen rest) >= 6) {
                    if ((substring rest 0 6) == "&quot;") {
                        out = (out + "\"")
                        i = (i + 6)
                        continue
                    }
                }
                if ((strlen rest) >= 5) {
                    if ((substring rest 0 5) == "&amp;") {
                        out = (out + "&")
                        i = (i + 5)
                        continue
                    }
                }
                if ((strlen rest) >= 4) {
                    if ((substring rest 0 4) == "&lt;") {
                        out = (out + "<")
                        i = (i + 4)
                        continue
                    }
                    if ((substring rest 0 4) == "&gt;") {
                        out = (out + ">")
                        i = (i + 4)
                        continue
                    }
                }
            }
            out = (out + (substring s i (i + 1)))
            i = (i + 1)
        }
        return out
    }

    ; The attribute, ready to drop into a tag.
    sfn htmlAttribute:string (json:string) {
        return ((ChartDocCodec.attrName()) + "=\"" + (ChartDocCodec.attrEscape(json)) + "\"")
    }

    ; Pull the document back out of pasted HTML. Deliberately a scan rather
    ; than an XML parse: clipboard HTML carries fragment comments, style
    ; blocks and unquoted attributes, and is not well-formed anything.
    sfn jsonFromHtml:string (html:string) {
        def needle:string ((ChartDocCodec.attrName()) + "=\"")
        def at:int (indexOf html needle)
        if (at < 0) {
            return ""
        }
        def from:int (at + (strlen needle))
        def i:int from
        while (i < (strlen html)) {
            if ((charAt html i) == 34) {
                return (ChartDocCodec.attrUnescape((substring html from i)))
            }
            i = (i + 1)
        }
        return ""
    }

    sfn fromHtml:ChartDoc (html:string) {
        def json:string (ChartDocCodec.jsonFromHtml(html))
        if ((strlen json) == 0) {
            def none (new ChartDoc)
            none.note = "no chart in this html"
            return none
        }
        return (ChartDocCodec.decode(json))
    }
}

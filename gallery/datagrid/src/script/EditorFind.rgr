; ==============================================================================
; EditorFind.rgr — what a find bar finds, without the bar
; ==============================================================================
; The model behind Ctrl+F in ScriptEditor, after VS Code's find widget: the
; query and its three switches (match case, whole word, regular expression),
; an optional range to look in (find in selection), the matches in document
; order and which one is current, and the replacements. No drawing, no keys:
; the editor (or a test) hands it the buffer and reads the answers.
;
;   scan(buf)          every match, in order; `error` says why a pattern
;                      could not be read (the bar shows it instead of a count)
;   indexAtOrAfter     the match a search from a place lands on, wrapping
;   indexBefore        the one before a place, wrapping
;   replaceAllText     the lines from the first match to the last with every
;                      match replaced, so the editor writes them as ONE edit
;                      (one Ctrl+Z, one change for the people editing along)
;
; A match is on one line: a pattern is matched against each line on its own,
; so `^` and `$` are a line's ends. An empty match (`^`, `a*` before a `b`) is
; not a match here: it has nothing to select or replace. Regular expressions
; are VlRegex's (no back-references or look-around), and the replacement is
; written as typed: `$1` is not a group.
; ==============================================================================

Import "../../../text_editor/src/EditorBuffer.rgr"
Import "../../../vela/src/VlRegex.rgr"

class EditorFindMatch {
    def line:int 0
    def start:int 0
    def end:int 0
}

class EditorFind {
    def query:string ""
    def matchCase:boolean false
    def wholeWord:boolean false
    def regex:boolean false
    ; find in selection: only matches wholly inside [scope start, scope end)
    def inScope:boolean false
    def scopeStartLine:int 0
    def scopeStartCol:int 0
    def scopeEndLine:int 0
    def scopeEndCol:int 0
    def matches:[EditorFindMatch]
    ; the match the selection is on, -1 none
    def current:int -1
    ; "" or why the pattern cannot be read
    def error:string ""
    ; a document with more matches than this stops counting (the bar says so)
    def limit:int 9999
    def capped:boolean false
    ; what `matches` was scanned from, so an unchanged buffer is not rescanned
    def scannedVersion:int -1
    def scannedKey:string ""
    def re:VlRegex (new VlRegex())

    fn count:int () {
        return (array_length matches)
    }

    fn at:EditorFindMatch (i:int) {
        return (itemAt matches i)
    }

    fn hasQuery:boolean () {
        return ((strlen query) > 0)
    }

    ; Everything a scan depends on except the text.
    fn key:string () {
        def k:string query
        k = (k + (strfromcode 1) + (? matchCase "c" "-") + (? wholeWord "w" "-") + (? regex "r" "-"))
        if inScope {
            k = (k + (strfromcode 1) + (to_string scopeStartLine) + ":" + (to_string scopeStartCol) + "-" + (to_string scopeEndLine) + ":" + (to_string scopeEndCol))
        }
        return k
    }

    fn setScope:void (aLine:int aCol:int bLine:int bCol:int) {
        inScope = true
        scopeStartLine = aLine
        scopeStartCol = aCol
        scopeEndLine = bLine
        scopeEndCol = bCol
        scannedVersion = -1
    }

    fn clearScope:void () {
        inScope = false
        scannedVersion = -1
    }

    ; A letter, a digit, `_`, or anything past ASCII (ä is a letter of a word).
    sfn wordChar:boolean (c:int) {
        if ((c >= 48) && (c <= 57)) {
            return true
        }
        if ((c >= 65) && (c <= 90)) {
            return true
        }
        if ((c >= 97) && (c <= 122)) {
            return true
        }
        return ((c == 95) || (c > 127))
    }

    sfn isWordAt:boolean (s:string a:int b:int) {
        if ((a > 0) && (EditorFind.wordChar((charAt s (a - 1))))) {
            return false
        }
        if ((b < (strlen s)) && (EditorFind.wordChar((charAt s b)))) {
            return false
        }
        return true
    }

    sfn indexFrom:int (hay:string needle:string from:int) {
        def n:int (strlen hay)
        if (from >= n) {
            return -1
        }
        def start:int from
        if (start < 0) {
            start = 0
        }
        def at:int (indexOf (substring hay start n) needle)
        if (at < 0) {
            return -1
        }
        return (start + at)
    }

    fn inside:boolean (line:int a:int b:int) {
        if (inScope == false) {
            return true
        }
        if ((EditorBuffer.order(line a scopeStartLine scopeStartCol)) < 0) {
            return false
        }
        return ((EditorBuffer.order(line b scopeEndLine scopeEndCol)) <= 0)
    }

    ; The matches in one line, start and end pairs.
    fn lineMatches:[int] (text:string) {
        def out:[int]
        def n:int (strlen text)
        if regex {
            def from:int 0
            while (from <= n) {
                def s:int (re.search(text from))
                if (s < 0) {
                    return out
                }
                def e:int re.lastEnd
                if ((e > s) && ((wholeWord == false) || (EditorFind.isWordAt(text s e)))) {
                    push out s
                    push out e
                    from = e
                } {
                    from = (s + 1)
                }
            }
            return out
        }
        def hay:string text
        def q:string query
        if (matchCase == false) {
            hay = (to_lowercase text)
            q = (to_lowercase query)
        }
        def qn:int (strlen q)
        def at:int (EditorFind.indexFrom(hay q 0))
        while (at >= 0) {
            if ((wholeWord == false) || (EditorFind.isWordAt(hay at (at + qn)))) {
                push out at
                push out (at + qn)
                at = (EditorFind.indexFrom(hay q (at + qn)))
            } {
                at = (EditorFind.indexFrom(hay q (at + 1)))
            }
        }
        return out
    }

    ; Every match in the buffer. Cheap to call on every frame: the scan runs
    ; again only when the text or the query changed.
    fn scan:void (buf:EditorBuffer) {
        def k:string (this.key())
        if ((buf.version == scannedVersion) && (k == scannedKey)) {
            return
        }
        scannedVersion = buf.version
        scannedKey = k
        def none:[EditorFindMatch]
        matches = none
        error = ""
        capped = false
        if ((strlen query) == 0) {
            current = -1
            return
        }
        if regex {
            def flags:string (? matchCase "" "i")
            re.compile(query flags)
            if (re.ok == false) {
                error = re.why
                current = -1
                return
            }
        }
        def lines:int (buf.lineCount())
        def first:int 0
        def last:int (lines - 1)
        if inScope {
            first = scopeStartLine
            if (scopeEndLine < last) {
                last = scopeEndLine
            }
        }
        def li:int first
        while (li <= last) {
            def pairs:[int] (this.lineMatches((buf.lineAt(li))))
            def j:int 0
            while (j < (array_length pairs)) {
                def a:int (itemAt pairs j)
                def b:int (itemAt pairs (j + 1))
                if (this.inside(li a b)) {
                    if ((array_length matches) >= limit) {
                        capped = true
                        return
                    }
                    def m:EditorFindMatch (new EditorFindMatch)
                    m.line = li
                    m.start = a
                    m.end = b
                    push matches m
                }
                j = (j + 2)
            }
            li = (li + 1)
        }
        if (current >= (array_length matches)) {
            current = -1
        }
    }

    ; The first match that starts at or after (line, col), wrapping to the
    ; first one; -1 when there is none.
    fn indexAtOrAfter:int (line:int col:int) {
        def n:int (array_length matches)
        if (n == 0) {
            return -1
        }
        def i:int 0
        while (i < n) {
            def m:EditorFindMatch (itemAt matches i)
            if ((EditorBuffer.order(m.line m.start line col)) >= 0) {
                return i
            }
            i = (i + 1)
        }
        return 0
    }

    ; The last match that starts before (line, col), wrapping to the last one.
    fn indexBefore:int (line:int col:int) {
        def n:int (array_length matches)
        if (n == 0) {
            return -1
        }
        def i:int (n - 1)
        while (i >= 0) {
            def m:EditorFindMatch (itemAt matches i)
            if ((EditorBuffer.order(m.line m.start line col)) < 0) {
                return i
            }
            i = (i - 1)
        }
        return (n - 1)
    }

    ; The match that is exactly [a, b) on the line, -1 for none.
    fn indexOfRange:int (line:int a:int b:int) {
        def i:int 0
        while (i < (array_length matches)) {
            def m:EditorFindMatch (itemAt matches i)
            if (((m.line == line) && (m.start == a)) && (m.end == b)) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; "3 of 17", "No results", "9999+": what the bar shows beside the query
    ; (the words are the host's: `ofWord`, `noneText`).
    fn status:string (ofWord:string noneText:string) {
        if ((strlen error) > 0) {
            return error
        }
        def n:int (array_length matches)
        if (n == 0) {
            return noneText
        }
        def total:string (to_string n)
        if capped {
            total = (total + "+")
        }
        if (current < 0) {
            return ("? " + ofWord + " " + total)
        }
        return ((to_string (current + 1)) + " " + ofWord + " " + total)
    }

    ; The text from the start of the first match's line to the end of the last
    ; match's line with every match replaced by `with`. The editor replaces
    ; lines [firstLine(), lastLine()] whole with it.
    fn replaceAllText:string (buf:EditorBuffer with:string) {
        def n:int (array_length matches)
        if (n == 0) {
            return ""
        }
        def first:EditorFindMatch (itemAt matches 0)
        def lastM:EditorFindMatch (itemAt matches (n - 1))
        def out:string ""
        def i:int 0
        def li:int first.line
        while (li <= lastM.line) {
            def text:string (buf.lineAt(li))
            def col:int 0
            def more:boolean true
            while (more && (i < n)) {
                def m:EditorFindMatch (itemAt matches i)
                if (m.line == li) {
                    out = (out + (substring text col m.start) + with)
                    col = m.end
                    i = (i + 1)
                } {
                    more = false
                }
            }
            out = (out + (substring text col (strlen text)))
            if (li < lastM.line) {
                out = (out + "\n")
            }
            li = (li + 1)
        }
        return out
    }

    fn firstLine:int () {
        def m:EditorFindMatch (itemAt matches 0)
        return m.line
    }

    fn lastLine:int () {
        def m:EditorFindMatch (itemAt matches ((array_length matches) - 1))
        return m.line
    }
}

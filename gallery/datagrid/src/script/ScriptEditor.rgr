; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; ScriptEditor.rgr — a code editor panel, drawn into the grid's display list
; ==============================================================================
;
; The text model is not written here. `gallery/text_editor` already has a
; buffer with undo, a selection with codepoint-aware movement, and a layout
; that measures with a real TTF and hit-tests a click back to a column — so
; this uses those three and adds what a CODE editor needs on top: tokens with
; colours, a gutter with line numbers, a current-line band, and typing that
; keeps its indent.
;
; It paints into the display list it is given, at the rectangle it is given,
; with the TEXT RENDERER IT IS GIVEN — the grid's own. That is what makes it a
; panel rather than an application: no canvas of its own, no font of its own,
; no frame of its own. The same list goes to SoftCanvas on a desktop host and
; to WebGL in a browser, so the editor is on the GPU for free. The right edge
; is a minimap: a scaled picture of the file, like VS Code's, that you scroll
; with a click.
;
; Every token is positioned by `layout.caretPixelX`, the same call the caret
; and the selection use, rather than by adding up token widths as it goes: two
; ways of measuring the same prefix is how a caret ends up half a character
; away from the letter it is supposed to be in front of.
; ==============================================================================

Import "lang/EditorLanguage.rgr"
Import "lang/CodeTokens.rgr"
Import "lang/Completion.rgr"
Import "lang/EditorDiagnostic.rgr"
Import "../../../text_editor/src/EditorBuffer.rgr"
Import "../../../text_editor/src/EditorSelection.rgr"
Import "../../../text_editor/src/EditorLayout.rgr"
Import "../../../text_editor/src/EditorStyle.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGColor.rgr"
Import "pkg:evg/EVGCodepoint.rgr"
Import "../../../game_engine/ui/UIContext.rgr"
Import "../../../game_engine/ui/UIInput.rgr"

class ScriptEditorTheme {
    def bg:EVGColor (EVGColor.rgb(26 27 38))
    def gutterBg:EVGColor (EVGColor.rgb(22 22 30))
    def gutterText:EVGColor (EVGColor.rgb(59 66 97))
    def gutterActive:EVGColor (EVGColor.rgb(115 122 162))
    def currentLine:EVGColor (EVGColor.rgb(31 34 51))
    def selection:EVGColor (EVGColor.rgba(47 75 124 0.75))
    def caret:EVGColor (EVGColor.rgb(122 162 247))
    def border:EVGColor (EVGColor.rgb(41 46 66))
    ; Token colours.
    def plain:EVGColor (EVGColor.rgb(192 202 245))
    def keyword:EVGColor (EVGColor.rgb(187 154 247))
    def builtin:EVGColor (EVGColor.rgb(125 207 255))
    def number:EVGColor (EVGColor.rgb(255 158 100))
    def text:EVGColor (EVGColor.rgb(158 206 106))
    def comment:EVGColor (EVGColor.rgb(86 95 137))
    def punct:EVGColor (EVGColor.rgb(137 221 255))
    def tag:EVGColor (EVGColor.rgb(247 118 142))
    def attr:EVGColor (EVGColor.rgb(224 175 104))
    ; The completion popup.
    def popupBg:EVGColor (EVGColor.rgb(36 40 59))
    def popupEdge:EVGColor (EVGColor.rgb(65 72 104))
    def popupPick:EVGColor (EVGColor.rgb(52 63 102))
    def popupDetail:EVGColor (EVGColor.rgb(118 128 154))
    ; The find bar.
    def findBg:EVGColor (EVGColor.rgb(36 40 59))
    def findEdge:EVGColor (EVGColor.rgb(65 72 104))
    def findInk:EVGColor (EVGColor.rgb(192 202 245))
    def findDim:EVGColor (EVGColor.rgb(118 128 154))
    ; Diagnostics.
    def errorInk:EVGColor (EVGColor.rgb(247 118 142))
    def warningInk:EVGColor (EVGColor.rgb(224 175 104))
    ; The minimap on the right: a darker strip, a slider over the visible
    ; range, and a hairline where the text ends.
    def minimapBg:EVGColor (EVGColor.rgb(22 23 32))
    def minimapSlider:EVGColor (EVGColor.rgba(155 168 210 0.10))
    def minimapEdge:EVGColor (EVGColor.rgb(41 46 66))

    Constructor () {
    }

    fn forSeverity:EVGColor (severity:int) {
        if (severity == (DiagnosticSeverity.error())) {
            return errorInk
        }
        return warningInk
    }

    fn forKind:EVGColor (kind:int) {
        if (kind == (CodeTokenKind.keyword())) {
            return keyword
        }
        if (kind == (CodeTokenKind.builtin())) {
            return builtin
        }
        if (kind == (CodeTokenKind.number())) {
            return number
        }
        if (kind == (CodeTokenKind.text())) {
            return text
        }
        if (kind == (CodeTokenKind.comment())) {
            return comment
        }
        if (kind == (CodeTokenKind.punct())) {
            return punct
        }
        if (kind == (CodeTokenKind.tag())) {
            return tag
        }
        if (kind == (CodeTokenKind.attr())) {
            return attr
        }
        return plain
    }
}

class ScriptEditor {
    def buf:EditorBuffer (new EditorBuffer)
    def sel:EditorSelection (new EditorSelection)
    def layout:EditorLayout (new EditorLayout)
    def theme:ScriptEditorTheme (new ScriptEditorTheme)
    def lines:[CodeTokenLine]
    ; The buffer version the tokens were made from. Re-lexing 200 lines is
    ; cheap, doing it sixty times a second because nothing changed is not.
    def tokenVersion:int -1
    def focused:boolean true
    def fontFamily:string "Open Sans"
    ; Bumped by whoever edits; the owner reads it to know the script is dirty.
    def dirty:boolean false
    ; The language plugin that says what is wrong with this document, and what
    ; it last said. Nothing here knows what a syntax error IS — see
    ; lang/EditorLanguage.rgr.
    def language:EditorLanguage (new EditorLanguage)
    def diagnostics:[EditorDiagnostic]
    ; Two clocks, because there are two passes. The cheap one runs on every
    ; change; the expensive one waits for a pause once it has proved expensive.
    def quickVersion:int -1
    def diagVersion:int -1
    def diagnoseUs:int 0
    ; Over this, the full pass stops running on the keystroke path and waits
    ; for the typing to stop. 8 ms is about half a frame.
    def diagnoseBudgetUs:int 8000
    def idleMs:double 350.0
    def lastEditMs:double 0.0
    ; --- completion -----------------------------------------------------------
    ; The list, whether it is up, which row is picked, and the column the word
    ; being completed starts at — replacing from there is what makes accepting
    ; a suggestion an edit rather than an append.
    def completions:[Completion]
    def completionOpen:boolean false
    def completionIndex:int 0
    def completionStart:int 0
    def completionLine:int 0
    ; How many rows the popup shows at once.
    def completionRows:int 8
    ; Whether typing opens the list by itself. A host that wants Ctrl+Space
    ; only turns this off; nothing else changes.
    def autoComplete:boolean true
    ; True while what is shown came from the cheap pass alone — the status bar
    ; can say so rather than implying the document has been fully checked.
    def quickOnly:boolean false
    ; --- find -----------------------------------------------------------------
    ; Ctrl+F. A one-line bar over the top of the text area: the query, and how
    ; many matches there are. Enter goes to the next one, Shift+Enter to the
    ; one before, Escape puts the keys back. The match is the selection, so it
    ; is highlighted and scrolled to by the code that already does both.
    def findOpen:boolean false
    def findQuery:string ""
    def findOrdinal:int 0
    def findTotal:int 0

    ; --- minimap --------------------------------------------------------------
    ; A scaled picture of the whole file on the right, the same idea as
    ; VS Code's and Monaco's: each token is a coloured speck, the slider is
    ; the viewport, and a click there is a jump. Hidden when the panel is too
    ; narrow to spare the strip.
    def showMinimap:boolean true
    def minimapW:int 96
    def minimapCharW:double 2.0
    def minimapDrag:boolean false

    Constructor () {
    }

    ; A file from disk may have CRLF endings, and a stray \r is a character
    ; the buffer would carry to the end of every line: an extra column the
    ; caret can sit in and a glyph the atlas has no picture for.
    sfn withoutCarriageReturns:string (src:string) {
        def n:int (strlen src)
        def hasCr:boolean false
        def i:int 0
        while (i < n) {
            if ((charAt src i) == 13) {
                hasCr = true
                break
            }
            i = (i + 1)
        }
        if (hasCr == false) {
            return src
        }
        def out:string ""
        def j:int 0
        while (j < n) {
            def ch:int (charAt src j)
            if (ch != 13) {
                str_append out (strfromcode ch)
            }
            j = (j + 1)
        }
        return out
    }

    ; Tabs, likewise: the atlas has no picture for one, so a file indented
    ; with tabs — most C and C++ — drew a row of empty boxes down the left
    ; margin. Expand to the next four-column stop, which is what a tab means
    ; on screen anyway. Tab the key still inserts spaces (indentSelection).
    sfn expandTabs:string (src:string) {
        def n:int (strlen src)
        def hasTab:boolean false
        def i:int 0
        while (i < n) {
            if ((charAt src i) == 9) {
                hasTab = true
                break
            }
            i = (i + 1)
        }
        if (hasTab == false) {
            return src
        }
        def out:string ""
        def col:int 0
        def j:int 0
        while (j < n) {
            def ch:int (charAt src j)
            if (ch == 9) {
                def pad:int (4 - (col % 4))
                def k:int 0
                while (k < pad) {
                    str_append out " "
                    k = (k + 1)
                }
                col = (col + pad)
            } {
                str_append out (strfromcode ch)
                if (ch == 10) {
                    col = 0
                } {
                    col = (col + 1)
                }
            }
            j = (j + 1)
        }
        return out
    }

    fn init:void (source:string) {
        buf.setText((ScriptEditor.expandTabs((ScriptEditor.withoutCarriageReturns(source)))))
        sel.setCaret(0 0)
        sel.collapseToCaret()
        layout.scrollLine = 0
        layout.fontSize = 13.0
        layout.showLineNumbers = true
        tokenVersion = -1
        dirty = false
    }

    fn text:string () {
        return (buf.getText())
    }

    fn setBounds:void (bx:int by:int bw:int bh:int) {
        layout.setBounds(bx by bw bh)
    }

    fn insideRect:boolean (px:int py:int) {
        if (px < layout.x) {
            return false
        }
        if (py < layout.y) {
            return false
        }
        def right:int (layout.x + layout.w)
        if (px >= right) {
            return false
        }
        def bottom:int (layout.y + layout.h)
        return (py < bottom)
    }

    ; --- diagnostics -----------------------------------------------------------
    fn setLanguage:void (lang:EditorLanguage) {
        language = lang
        tokenVersion = -1
        diagVersion = -1
        quickVersion = -1
        diagnoseUs = 0
        clear diagnostics
    }

    ; Re-run the plugin when, and only when, the document changed. The same
    ; rule the tokens follow, for the same reason: a plugin that parses is not
    ; free, and nothing has changed sixty times a second.
    fn ensureDiagnostics:void () {
        ; The cheap pass, on every change. A bracket that has just lost its
        ; partner should be underlined while the finger is still on the key.
        if (quickVersion != buf.version) {
            diagnostics = (language.quickDiagnose(buf.lines))
            quickVersion = buf.version
            quickOnly = true
        }
        if (diagVersion == buf.version) {
            return
        }
        ; The full pass, if it can be afforded. "Afforded" is measured, not
        ; declared: a plugin that answered quickly last time is asked again
        ; immediately, and one that did not waits for a gap in the typing.
        def now:double (wall_clock_ms)
        def idleFor:double (now - lastEditMs)
        def cheap:boolean (diagnoseUs <= diagnoseBudgetUs)
        if (cheap == false) {
            if (idleFor < idleMs) {
                return
            }
        }
        def t0:double (wall_clock_ms)
        diagnostics = (language.diagnose((buf.getText())))
        def t1:double (wall_clock_ms)
        def took:double ((t1 - t0) * 1000.0)
        diagnoseUs = (to_int took)
        diagVersion = buf.version
        quickOnly = false
    }

    fn problemCount:int () {
        this.ensureDiagnostics()
        return (array_length diagnostics)
    }

    fn problemAt:EditorDiagnostic (i:int) {
        return (itemAt diagnostics i)
    }

    ; The first complaint about this line, or a blank one. The status bar shows
    ; it for the line the caret is on, which is how a message stays out of the
    ; way until it is wanted.
    fn problemOnLine:EditorDiagnostic (line:int) {
        this.ensureDiagnostics()
        def i:int 0
        def n:int (array_length diagnostics)
        while (i < n) {
            def d:EditorDiagnostic (itemAt diagnostics i)
            if (d.coversLine(line)) {
                return d
            }
            i = (i + 1)
        }
        def blank:EditorDiagnostic (new EditorDiagnostic)
        blank.line = -1
        return blank
    }

    fn hasProblemOnLine:boolean (line:int) {
        def d:EditorDiagnostic (this.problemOnLine(line))
        return (d.line >= 0)
    }

    ; Caret to the next complaint, wrapping. F8 in every other editor.
    fn goToNextProblem:boolean () {
        this.ensureDiagnostics()
        def n:int (array_length diagnostics)
        if (n == 0) {
            return false
        }
        def here:int sel.caret.line
        def best:int -1
        def i:int 0
        while (i < n) {
            def d:EditorDiagnostic (itemAt diagnostics i)
            if (d.line > here) {
                if (best < 0) {
                    best = i
                }
            }
            i = (i + 1)
        }
        if (best < 0) {
            best = 0
        }
        def target:EditorDiagnostic (itemAt diagnostics best)
        this.moveCaret(target.line target.col false)
        layout.preferCol = sel.caret.col
        layout.ensureCaretVisible(buf sel)
        return true
    }

    ; --- completion -------------------------------------------------------------
    ; Ask the plugin. Nothing here knows what a candidate is or why one sorts
    ; before another — see lang/EditorLanguage.rgr.
    fn openCompletions:boolean () {
        def line:int sel.caret.line
        def col:int sel.caret.col
        completions = (language.complete(buf.lines line col))
        def n:int (array_length completions)
        if (n == 0) {
            completionOpen = false
            return false
        }
        def text:string (buf.lineAt(line))
        completionStart = (EditorLanguage.prefixStart(text col))
        completionLine = line
        completionIndex = 0
        completionOpen = true
        return true
    }

    fn closeCompletions:void () {
        completionOpen = false
        clear completions
    }

    ; After an edit: keep the list up while the word is still being typed, and
    ; take it down the moment the caret leaves the word it belongs to.
    fn refreshCompletions:void () {
        if (completionOpen == false) {
            return
        }
        if (sel.caret.line != completionLine) {
            this.closeCompletions()
            return
        }
        if (sel.caret.col < completionStart) {
            this.closeCompletions()
            return
        }
        this.openCompletions()
    }

    fn completionCount:int () {
        return (array_length completions)
    }

    fn completionAt:Completion (i:int) {
        return (itemAt completions i)
    }

    fn moveCompletion:void (delta:int) {
        def n:int (array_length completions)
        if (n == 0) {
            return
        }
        def next:int (completionIndex + delta)
        while (next < 0) {
            next = (next + n)
        }
        while (next >= n) {
            next = (next - n)
        }
        completionIndex = next
    }

    ; Replace the word being typed with the picked one. Not an insertion: the
    ; three letters that opened the list are part of what is being replaced.
    fn acceptCompletion:boolean () {
        if (completionOpen == false) {
            return false
        }
        def n:int (array_length completions)
        if (n == 0) {
            this.closeCompletions()
            return false
        }
        def pick:Completion (itemAt completions completionIndex)
        def line:int completionLine
        def from:int completionStart
        def to:int sel.caret.col
        this.closeCompletions()
        def p:EditorPos (buf.replaceRange(line from line to pick.insert true))
        this.markEdited(p)
        return true
    }

    ; --- tokens ---------------------------------------------------------------
    fn ensureTokens:void () {
        if (tokenVersion == buf.version) {
            return
        }
        ; Through the plugin: the editor does not know which lexer that is.
        lines = (language.tokenize(buf.lines))
        tokenVersion = buf.version
    }

    fn tokensFor:CodeTokenLine (line:int) {
        if (line < 0) {
            def none:CodeTokenLine (new CodeTokenLine)
            return none
        }
        if (line >= (array_length lines)) {
            def none2:CodeTokenLine (new CodeTokenLine)
            return none2
        }
        return (itemAt lines line)
    }

    ; --- minimap --------------------------------------------------------------
    ; How wide the strip is this frame: the configured width, or nothing when
    ; the panel cannot spare it. Every other measurement reads this, so a
    ; hidden map takes no space and eats no clicks.
    ; --- find ------------------------------------------------------------------

    ; Ctrl+F. Opening with a selection on one line takes that text as the
    ; query, which saves retyping the word you just pointed at.
    fn openFind:boolean () {
        findOpen = true
        this.closeCompletions()
        if ((sel.isCollapsed()) == false) {
            def a:EditorPos (new EditorPos)
            def b:EditorPos (new EditorPos)
            sel.normalized(a b)
            if (a.line == b.line) {
                findQuery = (substring (buf.lineAt(a.line)) a.col b.col)
            }
        }
        this.refreshFindCount()
        return true
    }

    fn closeFind:void () {
        findOpen = false
    }

    fn findActive:boolean () {
        return findOpen
    }

    ; The bar's own text entry. While it is up every keystroke arrives here
    ; first, so a search never edits the document.
    fn findType:void (text:string) {
        findQuery = (findQuery + text)
        this.findFrom(sel.caret.line sel.caret.col false true)
        this.refreshFindCount()
    }

    fn findBackspace:void () {
        def n:int (strlen findQuery)
        if (n > 0) {
            findQuery = (substring findQuery 0 (n - 1))
        }
        this.findFrom(sel.caret.line sel.caret.col false true)
        this.refreshFindCount()
    }

    fn findNext:boolean (back:boolean) {
        if ((strlen findQuery) == 0) {
            return false
        }
        def a:EditorPos (new EditorPos)
        def b:EditorPos (new EditorPos)
        sel.normalized(a b)
        def col:int (a.col + 1)
        if back {
            col = a.col
        }
        def hit:boolean (this.findFrom(a.line col back false))
        this.refreshFindCount()
        return hit
    }

    ; Search from (line, col), wrapping once around the buffer. `atCaret`
    ; restarts at the current match, so typing one more letter keeps the
    ; match under the caret instead of skipping to the next one.
    fn findFrom:boolean (line:int col:int back:boolean atCaret:boolean) {
        def q:string (to_lowercase findQuery)
        if ((strlen q) == 0) {
            return false
        }
        def n:int (buf.lineCount())
        if (n == 0) {
            return false
        }
        def startLine:int line
        def startCol:int col
        if atCaret {
            def a:EditorPos (new EditorPos)
            def b:EditorPos (new EditorPos)
            sel.normalized(a b)
            startLine = a.line
            startCol = a.col
        }
        def i:int 0
        while (i <= n) {
            def li:int startLine
            if back {
                li = (startLine - i)
                while (li < 0) {
                    li = (li + n)
                }
            } {
                li = ((startLine + i) % n)
            }
            def text:string (to_lowercase (buf.lineAt(li)))
            def at:int -1
            if back {
                def limit:int (strlen text)
                if (i == 0) {
                    limit = startCol
                }
                at = (ScriptEditor.lastIndexOfIn(text q limit))
            } {
                def from:int 0
                if (i == 0) {
                    from = startCol
                }
                at = (ScriptEditor.indexOfIn(text q from))
            }
            if (at >= 0) {
                sel.setAnchor(li at)
                sel.setCaret(li (at + (strlen findQuery)))
                layout.preferCol = sel.caret.col
                layout.ensureCaretVisible(buf sel)
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; "3 of 17" needs both numbers, and the ordinal is which of the matches
    ; the selection is sitting on.
    fn refreshFindCount:void () {
        findTotal = 0
        findOrdinal = 0
        def q:string (to_lowercase findQuery)
        if ((strlen q) == 0) {
            return
        }
        def a:EditorPos (new EditorPos)
        def b:EditorPos (new EditorPos)
        sel.normalized(a b)
        def n:int (buf.lineCount())
        def li:int 0
        while (li < n) {
            def text:string (to_lowercase (buf.lineAt(li)))
            def from:int 0
            def at:int (ScriptEditor.indexOfIn(text q from))
            while (at >= 0) {
                findTotal = (findTotal + 1)
                if (li == a.line) {
                    if (at == a.col) {
                        findOrdinal = findTotal
                    }
                }
                from = (at + 1)
                at = (ScriptEditor.indexOfIn(text q from))
            }
            li = (li + 1)
        }
    }

    sfn indexOfIn:int (hay:string needle:string from:int) {
        def n:int (strlen hay)
        def start:int from
        if (start < 0) {
            start = 0
        }
        if (start >= n) {
            return -1
        }
        def at:int (indexOf (substring hay start n) needle)
        if (at < 0) {
            return -1
        }
        return (start + at)
    }

    ; The last match that starts before `limit`.
    sfn lastIndexOfIn:int (hay:string needle:string limit:int) {
        def best:int -1
        def at:int (ScriptEditor.indexOfIn(hay needle 0))
        while (at >= 0) {
            if (at >= limit) {
                return best
            }
            best = at
            at = (ScriptEditor.indexOfIn(hay needle (at + 1)))
        }
        return best
    }

    fn findStatus:string () {
        if ((strlen findQuery) == 0) {
            return "find:  (type to search, Esc to close)"
        }
        if (findTotal == 0) {
            return (("find: " + findQuery) + "   no matches")
        }
        return ((((("find: " + findQuery) + "   ") + (to_string findOrdinal)) + " of ") + (to_string findTotal))
    }

    fn paintFind:void (dl:EVGDisplayList tr:UITextRenderer blink:int) {
        if (findOpen == false) {
            return
        }
        def barH:double ((to_double layout.lineHeight) + 10.0)
        def right:double ((to_double (layout.x + layout.w)) - (to_double (this.minimapWidth())))
        def w:double 320.0
        def maxW:double ((right - (to_double (layout.x + layout.gutterW))) - 8.0)
        if (w > maxW) {
            w = maxW
        }
        if (w < 80.0) {
            return
        }
        def x:double ((right - w) - 8.0)
        def y:double ((to_double layout.y) + 6.0)
        this.pushRect(dl x y w barH theme.findBg)
        def edge:EVGDrawCmd (new EVGDrawCmd)
        edge.kind = 1
        edge.x = x
        edge.y = y
        edge.w = w
        edge.h = barH
        edge.thickness = 1.0
        edge.r = (theme.findEdge.red())
        edge.g = (theme.findEdge.green())
        edge.b = (theme.findEdge.blue())
        edge.a = (theme.findEdge.alpha())
        push dl.cmds edge
        def ink:EVGColor theme.findInk
        if ((strlen findQuery) == 0) {
            ink = theme.findDim
        }
        if ((strlen findQuery) > 0) {
            if (findTotal == 0) {
                ink = theme.errorInk
            }
        }
        def size:double (layout.fontSize * 0.9)
        def label:string (this.findStatus())
        this.pushText(dl tr label (x + 8.0) (y + 5.0) size ink)
        ; A caret after the query, blinking on the editor's own clock. Without
        ; it the bar gives no sign that the keys are going into it — which is
        ; the one thing it has to say while it is up.
        def on:int (blink - ((idiv blink 2) * 2))
        if (on == 0) {
            def head:string (("find: " + findQuery))
            def cx:double ((x + 8.0) + (tr.measureWidth(head size)))
            this.pushRect(dl cx (y + 4.0) 1.5 ((to_double layout.lineHeight) - 2.0) theme.caret)
        }
    }

    fn minimapWidth:int () {
        if (showMinimap == false) {
            return 0
        }
        def need:int ((layout.gutterW + 200) + minimapW)
        if (layout.w < need) {
            return 0
        }
        return minimapW
    }

    fn minimapX:int () {
        def mw:int (this.minimapWidth())
        return ((layout.x + layout.w) - mw)
    }

    fn insideMinimap:boolean (px:int py:int) {
        def mw:int (this.minimapWidth())
        if (mw <= 0) {
            return false
        }
        def left:int (this.minimapX())
        if (px < left) {
            return false
        }
        def right:int (layout.x + layout.w)
        if (px >= right) {
            return false
        }
        if (py < layout.y) {
            return false
        }
        def bottom:int (layout.y + layout.h)
        return (py < bottom)
    }

    ; Pixels of minimap height per source line. Two is the usual size; a
    ; file that would not fit is scaled so the picture still sits in the
    ; strip. Short files stay a compact picture at the top — they are not
    ; stretched to fill the editor.
    fn minimapScale:double () {
        def n:int (buf.lineCount())
        if (n < 1) {
            return 2.0
        }
        def h:double (to_double layout.h)
        if (h < 1.0) {
            return 2.0
        }
        def px:double 2.0
        def need:double ((to_double n) * px)
        if (need > h) {
            px = (h / (to_double n))
        }
        return px
    }

    ; How tall the specks actually are, which is what a pointer on the
    ; strip is measured against. Empty space below a short file is not
    ; part of the picture.
    fn minimapPictureH:double () {
        def n:int (buf.lineCount())
        def px:double (this.minimapScale())
        def h:double ((to_double n) * px)
        def maxH:double (to_double layout.h)
        if (h > maxH) {
            return maxH
        }
        if (h < 1.0) {
            return 1.0
        }
        return h
    }

    fn minimapLineAt:int (py:int) {
        def n:int (buf.lineCount())
        if (n <= 1) {
            return 0
        }
        def px:double (this.minimapScale())
        if (px < 0.0001) {
            return 0
        }
        def local:double ((to_double py) - (to_double layout.y))
        if (local < 0.0) {
            local = 0.0
        }
        def line:int (to_int (local / px))
        def last:int (n - 1)
        if (line > last) {
            line = last
        }
        if (line < 0) {
            line = 0
        }
        return line
    }

    ; The scrollbar square sits on the picture. The pointer's Y as a
    ; fraction of that picture's height is the editor's scroll as a
    ; fraction of how far it can go — empty space below the specks does
    ; not stretch the mapping.
    fn jumpMinimap:void (py:int) {
        def n:int (buf.lineCount())
        def vis:int (layout.visibleLineCount())
        def maxScroll:int (n - vis)
        if (maxScroll < 0) {
            maxScroll = 0
        }
        def picH:double (this.minimapPictureH())
        def local:double ((to_double py) - (to_double layout.y))
        if (local < 0.0) {
            local = 0.0
        }
        if (local > picH) {
            local = picH
        }
        def t:double 0.0
        if (picH > 0.0001) {
            t = (local / picH)
        }
        if (t > 1.0) {
            t = 1.0
        }
        def maxD:double (to_double maxScroll)
        def scrolled:int (to_int ((t * maxD) + 0.5))
        layout.scrollLine = scrolled
        layout.clampScroll(buf)
    }

    ; True when the pointer is on the map and the view was moved. Pointer
    ; down and drag both come through here so a test can drive it without a
    ; text renderer.
    fn tryMinimapPointer:boolean (px:int py:int) {
        if ((this.insideMinimap(px py)) == false) {
            minimapDrag = false
            return false
        }
        minimapDrag = true
        this.jumpMinimap(py)
        return true
    }

    ; --- painting -------------------------------------------------------------
    fn pushRect:void (dl:EVGDisplayList x:double y:double w:double h:double col:EVGColor) {
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 0
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push dl.cmds c
    }

    fn pushClip:void (dl:EVGDisplayList x:double y:double w:double h:double) {
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 4
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        push dl.cmds c
    }

    fn popClip:void (dl:EVGDisplayList) {
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 5
        push dl.cmds c
    }

    fn pushText:void (dl:EVGDisplayList tr:UITextRenderer s:string x:double y:double size:double col:EVGColor) {
        if ((strlen s) == 0) {
            return
        }
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 3
        c.x = x
        c.y = y
        c.w = (tr.measureWidth(s size))
        c.h = (tr.lineHeight(size))
        c.text = s
        c.fontFamily = fontFamily
        c.fontSize = size
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push dl.cmds c
    }

    ; `blink` is a phase, not a frame count: the page derives it from the
    ; clock so a page that only repaints when something changed still blinks.
    fn paint:void (dl:EVGDisplayList tr:UITextRenderer blink:int) {
        layout.syncMetrics(tr)
        layout.clampScroll(buf)
        this.ensureTokens()
        this.ensureDiagnostics()
        def x0:double (to_double layout.x)
        def y0:double (to_double layout.y)
        def w0:double (to_double layout.w)
        def h0:double (to_double layout.h)
        this.pushRect(dl x0 y0 w0 h0 theme.bg)
        this.pushRect(dl x0 y0 (to_double layout.gutterW) h0 theme.gutterBg)
        def mapW:int (this.minimapWidth())
        def clipW:double (w0 - (to_double mapW))
        this.pushClip(dl x0 y0 clipW h0)

        def first:int (layout.firstVisible())
        def last:int (layout.lastVisible(buf))
        def caretLine:int sel.caret.line

        ; The line the caret is on, banded across the text area — the one piece
        ; of chrome that makes a wall of code navigable.
        if (sel.isCollapsed()) {
            if ((caretLine >= first) && (caretLine <= last)) {
                def bandY:double (to_double (layout.caretPixelY(caretLine)))
                def bandX:double (to_double (layout.x + layout.gutterW))
                def bandW:double ((to_double (layout.w - layout.gutterW)) - (to_double mapW))
                this.pushRect(dl bandX bandY bandW (to_double layout.lineHeight) theme.currentLine)
            }
        } {
            this.paintSelection(dl tr first last)
        }

        def li:int first
        while (li <= last) {
            def ty:int (layout.caretPixelY(li))
            def num:string (to_string (li + 1))
            def numSize:double (layout.fontSize * 0.85)
            def nw:int (to_int (tr.measureWidth(num numSize)))
            def nx:int (((layout.x + layout.gutterW) - nw) - 8)
            def numCol:EVGColor theme.gutterText
            if (li == caretLine) {
                numCol = theme.gutterActive
            }
            this.pushText(dl tr num (to_double nx) (to_double (ty + 2)) numSize numCol)
            this.paintLine(dl tr li ty)
            li = (li + 1)
        }

        ; Diagnostics over the text: a squiggle under the span and a mark in
        ; the gutter, so a problem below the fold is still visible as a colour
        ; in the margin.
        this.paintDiagnostics(dl tr first last)

        ; Caret: on for half a second, off for half a second, at 60 fps.
        if focused {
            if ((caretLine >= first) && (caretLine <= last)) {
                def on:int (blink - ((idiv blink 2) * 2))
                if (on == 0) {
                    def cx:int (layout.caretPixelX(tr buf caretLine sel.caret.col))
                    def cy:int (layout.caretPixelY(caretLine))
                    this.pushRect(dl (to_double cx) (to_double cy) 2.0 (to_double layout.lineHeight) theme.caret)
                }
            }
        }
        ; The completion list, over the text and inside the panel's clip: a
        ; popup that could be drawn outside the editor would be drawn over the
        ; status bar the first time someone typed on the last line.
        this.paintCompletions(dl tr)
        this.paintFind(dl tr blink)
        this.popClip(dl)
        this.paintMinimap(dl)
        def edge:EVGDrawCmd (new EVGDrawCmd)
        edge.kind = 1
        edge.x = x0
        edge.y = y0
        edge.w = w0
        edge.h = h0
        edge.thickness = 1.0
        edge.r = (theme.border.red())
        edge.g = (theme.border.green())
        edge.b = (theme.border.blue())
        edge.a = (theme.border.alpha())
        push dl.cmds edge
    }

    fn paintCompletions:void (dl:EVGDisplayList tr:UITextRenderer) {
        if (completionOpen == false) {
            return
        }
        def n:int (array_length completions)
        if (n == 0) {
            return
        }
        def shown:int n
        if (shown > completionRows) {
            shown = completionRows
        }
        ; Scroll the window of rows so the picked one is always in it.
        def first:int 0
        if (completionIndex >= shown) {
            first = ((completionIndex - shown) + 1)
        }
        def rowH:int (layout.lineHeight + 2)
        def widest:double 120.0
        def i:int 0
        while (i < shown) {
            def c:Completion (itemAt completions (first + i))
            def w:double (tr.measureWidth((c.label + "   " + c.detail) layout.fontSize))
            if (w > widest) {
                widest = w
            }
            i = (i + 1)
        }
        def boxW:double (widest + 28.0)
        def boxH:double (to_double (rowH * shown))
        def x:double (to_double (layout.caretPixelX(tr buf completionLine completionStart)))
        def y:double (to_double ((layout.caretPixelY(completionLine)) + layout.lineHeight + 2))
        ; Flip above the caret when there is no room below it.
        def bottom:double (y + boxH)
        def limit:double (to_double (layout.y + layout.h))
        if (bottom > limit) {
            y = ((to_double (layout.caretPixelY(completionLine))) - boxH - 2.0)
        }
        def right:double (x + boxW)
        def mapW:int (this.minimapWidth())
        def edgeX:double (to_double (((layout.x + layout.w) - mapW) - 8))
        if (right > edgeX) {
            x = (edgeX - boxW)
        }
        if (x < (to_double layout.x)) {
            x = (to_double layout.x)
        }
        this.pushRect(dl (x + 2.0) (y + 2.0) boxW boxH (EVGColor.rgba(10 12 20 0.45)))
        this.pushRect(dl x y boxW boxH theme.popupBg)
        def border:EVGDrawCmd (new EVGDrawCmd)
        border.kind = 1
        border.x = x
        border.y = y
        border.w = boxW
        border.h = boxH
        border.thickness = 1.0
        border.r = (theme.popupEdge.red())
        border.g = (theme.popupEdge.green())
        border.b = (theme.popupEdge.blue())
        border.a = (theme.popupEdge.alpha())
        push dl.cmds border
        def r:int 0
        while (r < shown) {
            def idx:int (first + r)
            def c2:Completion (itemAt completions idx)
            def ry:double (y + (to_double (rowH * r)))
            def ink:EVGColor theme.plain
            if (idx == completionIndex) {
                this.pushRect(dl (x + 1.0) ry (boxW - 2.0) (to_double rowH) theme.popupPick)
            }
            if (c2.kind == (CompletionKind.builtin())) {
                ink = theme.builtin
            }
            if (c2.kind == (CompletionKind.keyword())) {
                ink = theme.keyword
            }
            this.pushText(dl tr c2.label (x + 8.0) (ry + 1.0) layout.fontSize ink)
            def labelW:double (tr.measureWidth(c2.label layout.fontSize))
            this.pushText(dl tr c2.detail ((x + 20.0) + labelW) (ry + 1.0) (layout.fontSize * 0.85) theme.popupDetail)
            r = (r + 1)
        }
        ; How many are not shown, said rather than implied by a scrollbar.
        if (n > shown) {
            def more:string ("+" + (to_string (n - shown)) + " more")
            this.pushText(dl tr more (x + 8.0) (y + boxH + 1.0) (layout.fontSize * 0.8) theme.popupDetail)
        }
    }

    ; A wave, drawn as rectangles rather than a font glyph or a path: every
    ; backend this editor runs on can draw a rectangle, and the SDL binary has
    ; no shape library at all.
    fn paintSquiggle:void (dl:EVGDisplayList x0:double y:double x1:double col:EVGColor) {
        def x:double x0
        def step:double 3.0
        def up:boolean true
        while (x < x1) {
            def dy:double 0.0
            if (up == false) {
                dy = 2.0
            }
            def w:double step
            def over:double ((x + w) - x1)
            if (over > 0.0) {
                w = (w - over)
            }
            if (w > 0.5) {
                this.pushRect(dl x (y + dy) w 1.0 col)
            }
            up = (up == false)
            x = (x + step)
        }
    }

    fn paintDiagnostics:void (dl:EVGDisplayList tr:UITextRenderer first:int last:int) {
        def i:int 0
        def n:int (array_length diagnostics)
        while (i < n) {
            def d:EditorDiagnostic (itemAt diagnostics i)
            def col:EVGColor (theme.forSeverity(d.severity))
            def dl0:int d.line
            def dl1:int d.endLine
            def line:int dl0
            while (line <= dl1) {
                if ((line >= first) && (line <= last)) {
                    def text:string (buf.lineAt(line))
                    def len:int (strlen text)
                    def c0:int 0
                    def c1:int len
                    if (line == dl0) {
                        c0 = d.col
                    }
                    if (line == dl1) {
                        c1 = d.endCol
                    }
                    if (c1 > len) {
                        c1 = len
                    }
                    if (c1 <= c0) {
                        ; A zero-width complaint still has to be visible, so it
                        ; underlines the character it points at.
                        c1 = (c0 + 1)
                        if (c1 > len) {
                            c0 = len
                            c1 = (len + 1)
                        }
                    }
                    def x0:int (layout.caretPixelX(tr buf line c0))
                    def x1:int (layout.caretPixelX(tr buf line c1))
                    def wide:double ((to_double x1) - (to_double x0))
                    if (wide < 6.0) {
                        x1 = (x0 + 6)
                    }
                    def yBase:double (to_double ((layout.caretPixelY(line)) + layout.lineHeight - 3))
                    this.paintSquiggle(dl (to_double x0) yBase (to_double x1) col)
                    ; The gutter mark.
                    def gx:double (to_double (layout.x + 4))
                    def gy:double (to_double ((layout.caretPixelY(line)) + 5))
                    this.pushRect(dl gx gy 3.0 (to_double (layout.lineHeight - 10)) col)
                }
                line = (line + 1)
            }
            i = (i + 1)
        }
    }

    fn paintSelection:void (dl:EVGDisplayList tr:UITextRenderer first:int last:int) {
        def a:EditorPos (new EditorPos)
        def b:EditorPos (new EditorPos)
        sel.normalized(a b)
        def line:int a.line
        while (line <= b.line) {
            if ((line >= first) && (line <= last)) {
                def s:string (buf.lineAt(line))
                def len:int (strlen s)
                def c0:int 0
                def c1:int len
                if (line == a.line) {
                    c0 = a.col
                }
                if (line == b.line) {
                    c1 = b.col
                }
                if (c0 < 0) {
                    c0 = 0
                }
                if (c1 > len) {
                    c1 = len
                }
                if (c1 < c0) {
                    c1 = c0
                }
                def x0:int (layout.caretPixelX(tr buf line c0))
                def x1:int (layout.caretPixelX(tr buf line c1))
                if (line < b.line) {
                    ; A selection that continues onto the next line covers the
                    ; newline too, or a block selection looks like ragged bars.
                    x1 = (x1 + 6)
                }
                def rw:int (x1 - x0)
                if (rw < 2) {
                    rw = 2
                }
                def sy:int (layout.caretPixelY(line))
                this.pushRect(dl (to_double x0) (to_double sy) (to_double rw) (to_double layout.lineHeight) theme.selection)
            }
            line = (line + 1)
        }
    }

    fn paintLine:void (dl:EVGDisplayList tr:UITextRenderer line:int ty:int) {
        def s:string (buf.lineAt(line))
        if ((strlen s) == 0) {
            return
        }
        def toks:CodeTokenLine (this.tokensFor(line))
        def n:int (toks.count())
        if (n == 0) {
            def plainX:int (layout.caretPixelX(tr buf line 0))
            this.pushText(dl tr s (to_double plainX) (to_double ty) layout.fontSize theme.plain)
            return
        }
        def i:int 0
        while (i < n) {
            def t:CodeToken (toks.at(i))
            def stop:int (t.start + t.len)
            def part:string (substring s t.start stop)
            def px:int (layout.caretPixelX(tr buf line t.start))
            def col:EVGColor (theme.forKind(t.kind))
            this.pushText(dl tr part (to_double px) (to_double ty) layout.fontSize col)
            i = (i + 1)
        }
    }

    ; How much of a glyph cell a character fills. A minimap letter is a 1×1
    ; sprite: a `.` is almost empty (~3 %), an `I` is a thin stem (~10 %),
    ; an `R` is denser (~20 %). That fraction is the speck's opacity, so the
    ; picture reads as type rather than as solid bars.
    sfn minimapInk:double (ch:int) {
        if ((ch == 32) || (ch == 9)) {
            return 0.0
        }
        if ((ch == 46) || (ch == 44)) {
            return 0.03
        }
        if ((ch == 39) || (ch == 34) || (ch == 96)) {
            return 0.04
        }
        if ((ch == 58) || (ch == 59)) {
            return 0.05
        }
        if ((ch == 45) || (ch == 95) || (ch == 126)) {
            return 0.07
        }
        if ((ch == 124) || (ch == 33) || (ch == 47) || (ch == 92)) {
            return 0.08
        }
        if ((ch == 73) || (ch == 105) || (ch == 108) || (ch == 49)) {
            return 0.10
        }
        if ((ch == 106) || (ch == 116) || (ch == 102) || (ch == 114) || (ch == 74)) {
            return 0.10
        }
        if ((ch == 40) || (ch == 41) || (ch == 91) || (ch == 93)) {
            return 0.10
        }
        if ((ch == 123) || (ch == 125) || (ch == 60) || (ch == 62)) {
            return 0.10
        }
        if ((ch == 35) || (ch == 64) || (ch == 37) || (ch == 38) || (ch == 42)) {
            return 0.22
        }
        if ((ch == 77) || (ch == 87) || (ch == 109) || (ch == 119) || (ch == 56)) {
            return 0.22
        }
        if ((ch >= 65) && (ch <= 90)) {
            return 0.20
        }
        if ((ch >= 97) && (ch <= 122)) {
            return 0.15
        }
        if ((ch >= 48) && (ch <= 57)) {
            return 0.16
        }
        if ((ch > 32) && (ch < 127)) {
            return 0.12
        }
        return 0.15
    }

    ; A token that is only spaces would paint a bar where the file is empty,
    ; which is the opposite of an approximation.
    sfn blankSpan:boolean (s:string from:int len:int) {
        def n:int (strlen s)
        def i:int from
        def stop:int (from + len)
        if (stop > n) {
            stop = n
        }
        if (i >= stop) {
            return true
        }
        while (i < stop) {
            def ch:int (charAt s i)
            if ((ch != 32) && (ch != 9)) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    sfn firstInk:int (s:string) {
        def n:int (strlen s)
        def i:int 0
        while (i < n) {
            def ch:int (charAt s i)
            if ((ch != 32) && (ch != 9)) {
                return i
            }
            i = (i + 1)
        }
        return n
    }

    sfn lastInk:int (s:string) {
        def n:int (strlen s)
        def i:int n
        while (i > 0) {
            def ch:int (charAt s (i - 1))
            if ((ch != 32) && (ch != 9)) {
                return i
            }
            i = (i - 1)
        }
        return 0
    }

    fn paintMinimap:void (dl:EVGDisplayList) {
        def mw:int (this.minimapWidth())
        if (mw <= 0) {
            return
        }
        def x0:double (to_double (this.minimapX()))
        def y0:double (to_double layout.y)
        def w0:double (to_double mw)
        def h0:double (to_double layout.h)
        this.pushRect(dl x0 y0 w0 h0 theme.minimapBg)
        this.pushRect(dl x0 y0 1.0 h0 theme.minimapEdge)
        this.pushClip(dl x0 y0 w0 h0)

        def n:int (buf.lineCount())
        if (n < 1) {
            this.popClip(dl)
            return
        }
        def scale:double (this.minimapScale())
        def caretLine:int sel.caret.line
        def innerX:double (x0 + 3.0)
        def innerW:double (w0 - 8.0)
        if (innerW < 8.0) {
            innerW = 8.0
        }

        ; Selection first, so the tokens sit on top of it the way they do in
        ; the text — a selected region is a wash, not a replacement.
        if ((sel.isCollapsed()) == false) {
            def a:EditorPos (new EditorPos)
            def b:EditorPos (new EditorPos)
            sel.normalized(a b)
            def sy:double (y0 + ((to_double a.line) * scale))
            def sh:double ((to_double ((b.line - a.line) + 1)) * scale)
            if (sh < 2.0) {
                sh = 2.0
            }
            this.pushRect(dl innerX sy innerW sh theme.selection)
        } {
            def cy:double (y0 + ((to_double caretLine) * scale))
            def ch:double scale
            if (ch < 2.0) {
                ch = 2.0
            }
            this.pushRect(dl innerX cy innerW ch theme.currentLine)
        }

        if (scale >= 1.0) {
            def li:int 0
            while (li < n) {
                def ly:double (y0 + ((to_double li) * scale))
                def lh:double scale
                if (lh > 1.6) {
                    lh = (lh - 0.35)
                }
                this.paintMinimapLine(dl li innerX ly innerW lh)
                li = (li + 1)
            }
        } {
            ; Longer than the strip: one source line per pixel row, so the
            ; command count stays a function of the panel's height.
            def row:int 0
            def rows:int layout.h
            while (row < rows) {
                def li2:int (to_int (((to_double row) * (to_double n)) / h0))
                if (li2 >= n) {
                    li2 = (n - 1)
                }
                if (li2 < 0) {
                    li2 = 0
                }
                this.paintMinimapLine(dl li2 innerX (y0 + (to_double row)) innerW 1.0)
                row = (row + 1)
            }
        }

        ; A tick on the right for each diagnostic, so a problem below the
        ; fold is a colour even when the slider is elsewhere.
        def di:int 0
        def dn:int (array_length diagnostics)
        def tickW:double 3.0
        def tickX:double ((x0 + w0) - (tickW + 1.0))
        while (di < dn) {
            def d:EditorDiagnostic (itemAt diagnostics di)
            def tickY:double (y0 + ((to_double d.line) * scale))
            def tickH:double scale
            if (tickH < 2.0) {
                tickH = 2.0
            }
            this.pushRect(dl tickX tickY tickW tickH (theme.forSeverity(d.severity)))
            di = (di + 1)
        }

        ; The slider: the visible window, drawn last so it tints the specks
        ; rather than hiding them.
        def vis:int (layout.visibleLineCount())
        def picH:double (this.minimapPictureH())
        def sliderY:double (y0 + ((to_double layout.scrollLine) * scale))
        def sliderH:double ((to_double vis) * scale)
        def picBottom:double (y0 + picH)
        if (sliderH > picH) {
            sliderH = picH
        }
        if (sliderH < 8.0) {
            sliderH = 8.0
            if (sliderH > picH) {
                sliderH = picH
            }
        }
        def sliderBottom:double (sliderY + sliderH)
        if (sliderBottom > picBottom) {
            sliderH = (picBottom - sliderY)
        }
        if (sliderY < y0) {
            sliderH = (sliderH - (y0 - sliderY))
            sliderY = y0
        }
        if (sliderH > 0.5) {
            this.pushRect(dl x0 sliderY w0 sliderH theme.minimapSlider)
            def sliderEdge:EVGDrawCmd (new EVGDrawCmd)
            sliderEdge.kind = 1
            sliderEdge.x = x0
            sliderEdge.y = sliderY
            sliderEdge.w = w0
            sliderEdge.h = sliderH
            sliderEdge.thickness = 1.0
            sliderEdge.r = (theme.minimapEdge.red())
            sliderEdge.g = (theme.minimapEdge.green())
            sliderEdge.b = (theme.minimapEdge.blue())
            sliderEdge.a = 0.55
            push dl.cmds sliderEdge
        }
        this.popClip(dl)
    }

    fn paintMinimapLine:void (dl:EVGDisplayList line:int x0:double y:double maxW:double h:double) {
        if (h < 0.5) {
            return
        }
        def s:string (buf.lineAt(line))
        if ((strlen s) == 0) {
            return
        }
        def charW:double minimapCharW
        if (charW < 0.75) {
            charW = 0.75
        }
        def limit:double (x0 + maxW)
        def toks:CodeTokenLine (this.tokensFor(line))
        def n:int (toks.count())
        if (n == 0) {
            this.paintMinimapSpan(dl s 0 (strlen s) x0 y h charW limit theme.plain)
            return
        }
        def i:int 0
        while (i < n) {
            def t:CodeToken (toks.at(i))
            def col:EVGColor (theme.forKind(t.kind))
            this.paintMinimapSpan(dl s t.start t.len x0 y h charW limit col)
            i = (i + 1)
        }
    }

    ; One faint rectangle per run of letters that share a colour and a
    ; fill. Neighbouring `l`s stay one command; a `.` next to an `R` does
    ; not, because they do not occupy the cell the same way.
    fn paintMinimapSpan:void (dl:EVGDisplayList s:string from:int len:int x0:double y:double h:double charW:double limit:double ink:EVGColor) {
        def n:int (strlen s)
        def i:int from
        def stop:int (from + len)
        if (stop > n) {
            stop = n
        }
        def runAt:int -1
        def runN:int 0
        def runFill:double 0.0
        while (i < stop) {
            def ch:int (charAt s i)
            def fill:double (ScriptEditor.minimapInk(ch))
            if (fill < 0.001) {
                if (runAt >= 0) {
                    this.paintMinimapDots(dl x0 y h charW limit runAt runN ink runFill)
                    runAt = -1
                    runN = 0
                }
            } {
                if (runAt < 0) {
                    runAt = i
                    runN = 1
                    runFill = fill
                } {
                    if (fill == runFill) {
                        runN = (runN + 1)
                    } {
                        this.paintMinimapDots(dl x0 y h charW limit runAt runN ink runFill)
                        runAt = i
                        runN = 1
                        runFill = fill
                    }
                }
            }
            i = (i + 1)
        }
        if (runAt >= 0) {
            this.paintMinimapDots(dl x0 y h charW limit runAt runN ink runFill)
        }
    }

    fn paintMinimapDots:void (dl:EVGDisplayList x0:double y:double h:double charW:double limit:double col:int len:int ink:EVGColor fill:double) {
        if (len <= 0) {
            return
        }
        if (fill < 0.001) {
            return
        }
        def rx:double (x0 + ((to_double col) * charW))
        if (rx >= limit) {
            return
        }
        def rw:double ((to_double len) * charW)
        if ((rx + rw) > limit) {
            rw = (limit - rx)
        }
        if (rw < 0.5) {
            return
        }
        def r:int (ink.red())
        def g:int (ink.green())
        def b:int (ink.blue())
        def baseA:double (ink.alpha())
        def a:double (baseA * fill)
        def speck:EVGColor (EVGColor.rgba(r g b a))
        this.pushRect(dl rx y rw h speck)
    }

    ; --- editing --------------------------------------------------------------
    fn markEdited:void (p:EditorPos) {
        lastEditMs = (wall_clock_ms)
        sel.setCaret(p.line p.col)
        sel.collapseToCaret()
        layout.preferCol = sel.caret.col
        layout.ensureCaretVisible(buf sel)
        dirty = true
    }

    fn moveCaret:void (line:int col:int extend:boolean) {
        def p:EditorPos (EditorPos.create(line col))
        buf.clampPos(p)
        sel.setCaret(p.line p.col)
        if (extend == false) {
            sel.collapseToCaret()
        }
        layout.ensureCaretVisible(buf sel)
    }

    fn deleteSelection:boolean () {
        if (sel.isCollapsed()) {
            return false
        }
        def a:EditorPos (new EditorPos)
        def b:EditorPos (new EditorPos)
        sel.normalized(a b)
        def p:EditorPos (buf.deleteRange(a.line a.col b.line b.col))
        this.markEdited(p)
        return true
    }

    fn insert:void (s:string) {
        this.deleteSelection()
        def p:EditorPos (buf.insertText(sel.caret.line sel.caret.col s))
        this.markEdited(p)
    }

    ; Enter keeps the indent it found, and opens one more level after a line
    ; that ends in `{`, `(` or `[` — the smallest amount of help that stops a
    ; script from drifting left as it is written.
    fn insertNewline:void () {
        this.deleteSelection()
        def line:string (buf.lineAt(sel.caret.line))
        def indent:string ""
        def i:int 0
        def n:int (strlen line)
        while (i < n) {
            def ch:int (charAt line i)
            if (ch == 32) {
                indent = (indent + " ")
            } {
                if (ch == 9) {
                    indent = (indent + "  ")
                } {
                    break
                }
            }
            i = (i + 1)
        }
        def upto:string (substring line 0 sel.caret.col)
        def trimmed:string (trim upto)
        def tn:int (strlen trimmed)
        if (tn > 0) {
            def lastCh:int (charAt trimmed (tn - 1))
            if ((lastCh == 123) || (lastCh == 40)) {
                indent = (indent + "  ")
            }
            if (lastCh == 91) {
                indent = (indent + "  ")
            }
        }
        def opened:string ("\n" + indent)
        this.insert(opened)
    }

    ; How many leading characters one outdent step removes: a tab, or up to
    ; two spaces — the same unit Tab inserts.
    sfn leadingOutdent:int (line:string) {
        def n:int (strlen line)
        if (n == 0) {
            return 0
        }
        if ((charAt line 0) == 9) {
            return 1
        }
        def i:int 0
        while ((i < 2) && (i < n)) {
            if ((charAt line i) == 32) {
                i = (i + 1)
            } {
                break
            }
        }
        return i
    }

    sfn adjustIndentCol:int (col:int delta:int) {
        def next:int (col + delta)
        if (next < 0) {
            return 0
        }
        return next
    }

    ; Shift every selected line one indent unit. A collapsed caret + Tab still
    ; inserts two spaces at the caret (so Tab in the middle of a word does
    ; what people type); a range is always a block indent, never a replace.
    fn indentSelection:void (outdent:boolean) {
        this.closeCompletions()
        if ((sel.isCollapsed()) && (outdent == false)) {
            this.insert("  ")
            return
        }
        def a:EditorPos (new EditorPos)
        def b:EditorPos (new EditorPos)
        sel.normalized(a b)
        def last:int b.line
        if ((b.col == 0) && (last > a.line)) {
            last = (last - 1)
        }
        this.shiftLines(a.line last outdent)
    }

    fn shiftLines:void (first:int last:int outdent:boolean) {
        if (last < first) {
            return
        }
        def a:EditorPos (new EditorPos)
        def b:EditorPos (new EditorPos)
        sel.normalized(a b)
        def caretAtEnd:boolean ((sel.caret.line == b.line) && (sel.caret.col == b.col))
        def aDelta:int 0
        def bDelta:int 0
        def built:string ""
        def i:int first
        while (i <= last) {
            def line:string (buf.lineAt(i))
            def delta:int 0
            def shifted:string line
            if outdent {
                def n:int (ScriptEditor.leadingOutdent(line))
                shifted = (substring line n (strlen line))
                delta = (0 - n)
            } {
                shifted = ("  " + line)
                delta = 2
            }
            if (i > first) {
                built = (built + "\n")
            }
            built = (built + shifted)
            if (i == a.line) {
                aDelta = delta
            }
            if (i == b.line) {
                bDelta = delta
            }
            i = (i + 1)
        }
        def lastLen:int (strlen (buf.lineAt(last)))
        buf.replaceRange(first 0 last lastLen built true)
        def aCol:int (ScriptEditor.adjustIndentCol(a.col aDelta))
        def bCol:int (ScriptEditor.adjustIndentCol(b.col bDelta))
        if caretAtEnd {
            sel.setAnchor(a.line aCol)
            sel.setCaret(b.line bCol)
        } {
            sel.setAnchor(b.line bCol)
            sel.setCaret(a.line aCol)
        }
        layout.preferCol = sel.caret.col
        layout.ensureCaretVisible(buf sel)
        lastEditMs = (wall_clock_ms)
        dirty = true
    }

    fn backspace:void () {
        if (this.deleteSelection()) {
            this.refreshCompletions()
            return
        }
        def line:int sel.caret.line
        def col:int sel.caret.col
        if (col == 0) {
            if (line == 0) {
                return
            }
            def prevLen:int (strlen (buf.lineAt(line - 1)))
            def p:EditorPos (buf.deleteRange((line - 1) prevLen line 0))
            this.markEdited(p)
            return
        }
        def before:EditorPos (buf.moveCodepoint(line col -1))
        def p2:EditorPos (buf.deleteRange(before.line before.col line col))
        this.markEdited(p2)
        this.refreshCompletions()
    }

    fn deleteForward:void () {
        if (this.deleteSelection()) {
            return
        }
        def line:int sel.caret.line
        def col:int sel.caret.col
        def len:int (strlen (buf.lineAt(line)))
        if (col >= len) {
            if (line >= ((buf.lineCount()) - 1)) {
                return
            }
            def p:EditorPos (buf.deleteRange(line col (line + 1) 0))
            this.markEdited(p)
            return
        }
        def after:EditorPos (buf.moveCodepoint(line col 1))
        def p2:EditorPos (buf.deleteRange(line col after.line after.col))
        this.markEdited(p2)
    }

    fn moveVertical:void (delta:int extend:boolean) {
        def want:int layout.preferCol
        if (want < sel.caret.col) {
            want = sel.caret.col
        }
        def line:int (sel.caret.line + delta)
        if (line < 0) {
            line = 0
        }
        def maxLine:int ((buf.lineCount()) - 1)
        if (line > maxLine) {
            line = maxLine
        }
        def len:int (strlen (buf.lineAt(line)))
        def col:int want
        if (col > len) {
            col = len
        }
        def keep:int want
        this.moveCaret(line col extend)
        layout.preferCol = keep
    }

    ; --- the clipboard's half of the model --------------------------------------
    ; The host owns the system clipboard; what belongs here is the text a
    ; selection stands for, across as many lines as it covers. The browser
    ; page used to let the hidden textarea answer Ctrl+C by itself, which is
    ; right for a selection inside one line and silently WRONG for any other:
    ; the mirror only ever holds the caret's line, so a three-line selection
    ; copied one line and lost the rest without saying so.
    fn selectionText:string () {
        if (sel.isCollapsed()) {
            return ""
        }
        def a:EditorPos (new EditorPos)
        def b:EditorPos (new EditorPos)
        sel.normalized(a b)
        return (buf.textInRange(a.line a.col b.line b.col))
    }

    ; Cut is copy plus this, and the host does them in that order.
    fn cutSelection:string () {
        def text:string (this.selectionText())
        if ((strlen text) == 0) {
            return ""
        }
        this.deleteSelection()
        return text
    }

    fn selectAll:void () {
        sel.selectAll(buf)
        layout.ensureCaretVisible(buf sel)
    }

    fn undo:void () {
        def p:EditorPos (buf.undo())
        this.markEdited(p)
    }

    fn redo:void () {
        def p:EditorPos (buf.redo())
        this.markEdited(p)
    }

    ; --- word and document movement -------------------------------------------
    ; Ctrl+arrow, Ctrl+Home and Ctrl+End are not decoration: they are how a
    ; keyboard-only user crosses a file. Word boundaries come from EditorWord,
    ; the same ones double-click selection uses, so a word means one thing in
    ; this editor rather than two.
    fn wordLeftCol:int (line:int col:int) {
        def s:string (buf.lineAt(line))
        def i:int col
        while (i > 0) {
            def ch:int (charAt s (i - 1))
            if (EditorWord.isWordChar(ch)) {
                break
            }
            i = (i - 1)
        }
        if (i == 0) {
            return 0
        }
        return (EditorWord.wordStart(s (i - 1)))
    }

    fn wordRightCol:int (line:int col:int) {
        def s:string (buf.lineAt(line))
        def n:int (strlen s)
        def i:int col
        while (i < n) {
            def ch:int (charAt s i)
            if (EditorWord.isWordChar(ch)) {
                break
            }
            i = (i + 1)
        }
        if (i >= n) {
            return n
        }
        return (EditorWord.wordEnd(s i))
    }

    fn moveWord:void (dir:int extend:boolean) {
        def line:int sel.caret.line
        def col:int sel.caret.col
        if (dir < 0) {
            if (col == 0) {
                if (line == 0) {
                    return
                }
                def prevLen:int (strlen (buf.lineAt(line - 1)))
                this.moveCaret((line - 1) prevLen extend)
                layout.preferCol = sel.caret.col
                return
            }
            def target:int (this.wordLeftCol(line col))
            if (target >= col) {
                target = (col - 1)
            }
            this.moveCaret(line target extend)
            layout.preferCol = sel.caret.col
            return
        }
        def len:int (strlen (buf.lineAt(line)))
        if (col >= len) {
            if (line >= ((buf.lineCount()) - 1)) {
                return
            }
            this.moveCaret((line + 1) 0 extend)
            layout.preferCol = 0
            return
        }
        def right:int (this.wordRightCol(line col))
        if (right <= col) {
            right = (col + 1)
        }
        this.moveCaret(line right extend)
        layout.preferCol = sel.caret.col
    }

    fn moveDocumentStart:void (extend:boolean) {
        this.moveCaret(0 0 extend)
        layout.preferCol = 0
    }

    fn moveDocumentEnd:void (extend:boolean) {
        def last:int ((buf.lineCount()) - 1)
        def len:int (strlen (buf.lineAt(last)))
        this.moveCaret(last len extend)
        layout.preferCol = len
    }

    ; True when it did the collapsing: an open selection and no Shift.
    fn collapseToEdge:boolean (toEnd:boolean shift:boolean) {
        if shift {
            return false
        }
        if (sel.isCollapsed()) {
            return false
        }
        def a:EditorPos (new EditorPos)
        def b:EditorPos (new EditorPos)
        sel.normalized(a b)
        if toEnd {
            this.moveCaret(b.line b.col false)
        } {
            this.moveCaret(a.line a.col false)
        }
        layout.preferCol = sel.caret.col
        return true
    }

    ; --- input ----------------------------------------------------------------
    fn handleKey:boolean (key:int shift:boolean ctrl:boolean) {
        ; The find bar owns Escape, Enter and Backspace while it is up; the
        ; arrows and the wheel keep working, so you can look around without
        ; losing the query.
        if findOpen {
            if (key == (UIKey.escape())) {
                this.closeFind()
                return true
            }
            if (key == (UIKey.enter())) {
                this.findNext(shift)
                return true
            }
            if (key == (UIKey.backspace())) {
                this.findBackspace()
                return true
            }
        }
        ; While the list is up it owns the keys that mean "which one" — and
        ; only those. Everything else keeps its meaning, which is what makes a
        ; completion list something you can ignore.
        if completionOpen {
            if (key == (UIKey.up())) {
                this.moveCompletion(-1)
                return true
            }
            if (key == (UIKey.down())) {
                this.moveCompletion(1)
                return true
            }
            if (key == (UIKey.enter())) {
                return (this.acceptCompletion())
            }
            if (key == (UIKey.tab())) {
                return (this.acceptCompletion())
            }
            if (key == (UIKey.escape())) {
                this.closeCompletions()
                return true
            }
            if (key == (UIKey.left())) {
                this.closeCompletions()
            }
            if (key == (UIKey.right())) {
                this.closeCompletions()
            }
        }
        if (key == (UIKey.left())) {
            if ctrl {
                this.moveWord(-1 shift)
                return true
            }
            ; A plain arrow with a selection open COLLAPSES it to the edge it
            ; points at — it does not also move a character. That is what every
            ; text field does, and what CodeMirror does; the bench in
            ; web/editor/compare is where the difference showed up.
            if (this.collapseToEdge(false shift)) {
                return true
            }
            def p:EditorPos (buf.moveCodepoint(sel.caret.line sel.caret.col -1))
            this.moveCaret(p.line p.col shift)
            layout.preferCol = sel.caret.col
            return true
        }
        if (key == (UIKey.right())) {
            if ctrl {
                this.moveWord(1 shift)
                return true
            }
            if (this.collapseToEdge(true shift)) {
                return true
            }
            def p2:EditorPos (buf.moveCodepoint(sel.caret.line sel.caret.col 1))
            this.moveCaret(p2.line p2.col shift)
            layout.preferCol = sel.caret.col
            return true
        }
        if (key == (UIKey.up())) {
            this.moveVertical(-1 shift)
            return true
        }
        if (key == (UIKey.down())) {
            this.moveVertical(1 shift)
            return true
        }
        if (key == (UIKey.pageUp())) {
            def step:int (layout.visibleLineCount())
            this.moveVertical((0 - step) shift)
            return true
        }
        if (key == (UIKey.pageDown())) {
            def step2:int (layout.visibleLineCount())
            this.moveVertical(step2 shift)
            return true
        }
        if (key == (UIKey.home())) {
            if ctrl {
                this.moveDocumentStart(shift)
                return true
            }
            this.moveCaret(sel.caret.line 0 shift)
            layout.preferCol = 0
            return true
        }
        if (key == (UIKey.end())) {
            if ctrl {
                this.moveDocumentEnd(shift)
                return true
            }
            def len:int (strlen (buf.lineAt(sel.caret.line)))
            this.moveCaret(sel.caret.line len shift)
            layout.preferCol = len
            return true
        }
        if (key == (UIKey.backspace())) {
            this.backspace()
            return true
        }
        if (key == (UIKey.del())) {
            this.deleteForward()
            return true
        }
        if (key == (UIKey.enter())) {
            this.insertNewline()
            return true
        }
        if (key == (UIKey.tab())) {
            ; A range is a block to indent, not text to replace — the same
            ; rule VS Code and CodeMirror use. A collapsed caret still inserts
            ; two spaces; Shift+Tab outdents the line the caret is on.
            this.indentSelection(shift)
            return true
        }
        return false
    }

    ; Ctrl-chords the editor answers itself. Run and Save belong to the window
    ; around it, which is why they are not here.
    fn handleCtrlChar:boolean (ch:int) {
        if ((ch == 102) || (ch == 70)) {
            return (this.openFind())
        }
        if ((ch == 103) || (ch == 71)) {
            if findOpen {
                return (this.findNext(false))
            }
        }
        if ((ch == 97) || (ch == 65)) {
            this.selectAll()
            return true
        }
        if ((ch == 122) || (ch == 90)) {
            this.undo()
            return true
        }
        if ((ch == 121) || (ch == 89)) {
            this.redo()
            return true
        }
        return false
    }

    fn handleText:boolean (s:string) {
        if ((strlen s) == 0) {
            return false
        }
        if findOpen {
            this.findType(s)
            return true
        }
        this.insert(s)
        ; Two word characters is the point where a guess is worth making. Under
        ; that the list is everything, which is not a suggestion.
        if completionOpen {
            this.refreshCompletions()
        } {
            if (autoComplete) {
                def line:string (buf.lineAt(sel.caret.line))
                def lastCh:int (charAt s ((strlen s) - 1))
                ; A dot is a question on its own — `body.` is asking what a
                ; body has — so it opens the list with no prefix at all.
                if (lastCh == 46) {
                    this.openCompletions()
                } {
                    def prefix:string (EditorLanguage.prefixAt(line sel.caret.col))
                    if ((strlen prefix) >= 2) {
                        this.openCompletions()
                    }
                }
            }
        }
        return true
    }

    ; Ctrl+Space: ask for the list whatever the prefix is.
    fn requestCompletions:boolean () {
        return (this.openCompletions())
    }

    fn pointerDown:void (tr:UITextRenderer px:int py:int extend:boolean) {
        focused = true
        this.closeCompletions()
        if (this.tryMinimapPointer(px py)) {
            return
        }
        def hit:EditorPos (layout.hitTest(tr buf px py))
        this.moveCaret(hit.line hit.col extend)
        layout.preferCol = sel.caret.col
        if (extend == false) {
            sel.setAnchor(hit.line hit.col)
        }
    }

    ; Double click takes the word under the pointer, triple click the line —
    ; the two selections every text surface has, and the ones `EditorWord`
    ; already knows how to find, so a word means the same thing here as it does
    ; to Ctrl+arrow.
    fn selectWordAt:void (tr:UITextRenderer px:int py:int) {
        if (this.tryMinimapPointer(px py)) {
            return
        }
        def hit:EditorPos (layout.hitTest(tr buf px py))
        this.selectWordAtPos(hit.line hit.col)
    }

    ; The same selection without a hit test — hosts that already know the
    ; column, and the tests, use this.
    fn selectWordAtPos:void (line:int col:int) {
        focused = true
        this.closeCompletions()
        def p:EditorPos (EditorPos.create(line col))
        buf.clampPos(p)
        def s:string (buf.lineAt(p.line))
        def from:int (EditorWord.wordStart(s p.col))
        def to:int (EditorWord.wordEnd(s p.col))
        if (from == to) {
            ; Clicked whitespace or punctuation — take the character under
            ; the pointer, which is what a double-click on a gap does.
            if (p.col < (strlen s)) {
                from = p.col
                to = (p.col + 1)
            }
        }
        sel.setAnchor(p.line from)
        sel.setCaret(p.line to)
        layout.preferCol = to
        layout.ensureCaretVisible(buf sel)
    }

    fn selectLineAt:void (tr:UITextRenderer px:int py:int) {
        if (this.tryMinimapPointer(px py)) {
            return
        }
        focused = true
        this.closeCompletions()
        def hit:EditorPos (layout.hitTest(tr buf px py))
        def len:int (strlen (buf.lineAt(hit.line)))
        sel.setAnchor(hit.line 0)
        sel.setCaret(hit.line len)
        layout.preferCol = len
        layout.ensureCaretVisible(buf sel)
    }

    fn pointerDrag:void (tr:UITextRenderer px:int py:int) {
        if minimapDrag {
            this.jumpMinimap(py)
            return
        }
        def hit:EditorPos (layout.hitTest(tr buf px py))
        this.moveCaret(hit.line hit.col true)
    }

    fn scrollBy:void (notches:int) {
        layout.scrollByLines(buf (0 - notches))
    }
}

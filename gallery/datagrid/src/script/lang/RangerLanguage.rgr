; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; RangerLanguage.rgr — the same seam, a different language
; ==============================================================================
;
; This plugin exists to prove the seam is real. It shares no code with the
; JavaScript one, has its own idea of what a comment is (`;` to the end of the
; line), and reports errors JavaScript does not have — because in an
; S-expression language a bracket that never closes is not one error among many,
; it is nearly the whole category.
;
; It is a LINT, not the Ranger compiler. Wiring the compiler in would be the
; honest way to get real type errors, and it is also two megabytes of frontend
; and a second of work per keystroke; when that is wanted it arrives as another
; plugin next to this one — which is the point of there being a registry.
;
; What it does check is the shape of the file and the three mistakes the
; repository's own AGENTS.md says cost the most time.
; ==============================================================================

Import "EditorLanguage.rgr"
Import "EditorDiagnostic.rgr"
Import "RangerTokens.rgr"
Import "Completion.rgr"

class RangerLanguage {
    Extends(EditorLanguage)

    def lexer:RangerTokenizer (new RangerTokenizer)

    Constructor () {
    }

    fn id:string () {
        return "ranger"
    }

    fn tokenize:[CodeTokenLine] (lines:[string]) {
        return (lexer.tokenize(lines))
    }

    fn label:string () {
        return "Ranger"
    }

    fn handlesFile:boolean (name:string) {
        return (EditorLanguage.hasSuffix(name ".rgr"))
    }

    ; Ranger's own: the operators first, because they are what a line is made
    ; of and they are the ones nobody remembers the spelling of.
    fn complete:[Completion] (lines:[string] line:int col:int) {
        def out:[Completion]
        if (line < 0) {
            return out
        }
        if (line >= (array_length lines)) {
            return out
        }
        def text:string (itemAt lines line)
        def prefix:string (EditorLanguage.prefixAt(text col))
        if ((strlen prefix) == 0) {
            return out
        }
        ; `this.` and `Class.` ask about members, and in a language with no
        ; imports to chase, the file itself is the answer: every `fn`, `sfn`
        ; and `def` in it.
        def start:int (EditorLanguage.prefixStart(text col))
        if (start > 0) {
            if ((charAt text (start - 1)) == 46) {
                return (this.membersOfFile(lines prefix))
            }
        }
        def ops:[string] (RangerTokenizer.builtins())
        def i:int 0
        def n:int (array_length ops)
        while (i < n) {
            def name:string (itemAt ops i)
            if (EditorLanguage.matchesPrefix(name prefix)) {
                push out (Completion.create(name "operator" (CompletionKind.builtin()) 0))
            }
            i = (i + 1)
        }
        def kw:[string] (RangerTokenizer.keywords())
        def k:int 0
        def kn:int (array_length kw)
        while (k < kn) {
            def word:string (itemAt kw k)
            if (EditorLanguage.matchesPrefix(word prefix)) {
                push out (Completion.create(word "keyword" (CompletionKind.keyword()) 1))
            }
            k = (k + 1)
        }
        def words:[string] (EditorLanguage.wordsIn(lines prefix 400))
        def w:int 0
        def wn:int (array_length words)
        while (w < wn) {
            def word2:string (itemAt words w)
            if (EditorLanguage.matchesPrefix(word2 prefix)) {
                if ((EditorLanguage.isInList(word2 ops)) == false) {
                    if ((EditorLanguage.isInList(word2 kw)) == false) {
                        push out (Completion.create(word2 "in this file" (CompletionKind.word()) 2))
                    }
                }
            }
            w = (w + 1)
        }
        return out
    }

    ; Declarations, read off the file. A parser would be better and would also
    ; be a second parser; this is what `fn name:` looks like, which is enough
    ; to offer the method you wrote eighty lines ago.
    fn membersOfFile:[Completion] (lines:[string] prefix:string) {
        def out:[Completion]
        def li:int 0
        def n:int (array_length lines)
        while (li < n) {
            def raw:string (itemAt lines li)
            def s:string (trim raw)
            def kind:string ""
            def rest:string ""
            if (this.beginsWith(s "fn ")) {
                kind = "method"
                rest = (substring s 3 (strlen s))
            }
            if (this.beginsWith(s "sfn ")) {
                kind = "static"
                rest = (substring s 4 (strlen s))
            }
            if (this.beginsWith(s "def ")) {
                kind = "field"
                rest = (substring s 4 (strlen s))
            }
            if ((strlen kind) > 0) {
                def name:string (RangerLanguage.nameOf(rest))
                if ((strlen name) > 0) {
                    if (EditorLanguage.matchesPrefix(name prefix)) {
                        push out (Completion.create(name kind (CompletionKind.member()) 0))
                    }
                }
            }
            li = (li + 1)
        }
        return out
    }

    ; `total:int (n:int) {` -> `total`. The name ends at the colon that starts
    ; its type, or at the space before its parameters.
    sfn nameOf:string (s:string) {
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def ch:int (charAt s i)
            def word:boolean false
            if ((ch >= 65) && (ch <= 90)) {
                word = true
            }
            if ((ch >= 97) && (ch <= 122)) {
                word = true
            }
            if ((ch >= 48) && (ch <= 57)) {
                word = true
            }
            if (ch == 95) {
                word = true
            }
            if (word == false) {
                return (substring s 0 i)
            }
            i = (i + 1)
        }
        return s
    }

    fn diagnose:[EditorDiagnostic] (source:string) {
        def lines:[string] (EditorLanguage.linesOf(source))
        return (this.quickDiagnose(lines))
    }

    ; This plugin has one speed: it never parses, so its full answer is already
    ; cheap enough for every keystroke.
    fn quickDiagnose:[EditorDiagnostic] (lines:[string]) {
        def out:[EditorDiagnostic]
        this.brackets(lines out)
        this.gotchas(lines out)
        return out
    }

    ; --- shape -----------------------------------------------------------------
    ; One pass, carrying the two states that outlive a line: none. A Ranger
    ; string does not span lines and a comment ends with the line, so the state
    ; machine is per line and the bracket stack is per file.
    fn brackets:void (lines:[string] out:[EditorDiagnostic]) {
        def stackCh:[int]
        def stackLine:[int]
        def stackCol:[int]
        def li:int 0
        def n:int (array_length lines)
        while (li < n) {
            def s:string (itemAt lines li)
            def len:int (strlen s)
            def i:int 0
            while (i < len) {
                def ch:int (charAt s i)
                if (ch == 59) {
                    ; `;` — comment to the end of the line.
                    break
                }
                if (ch == 34) {
                    def close:int (this.stringEnd(s (i + 1)))
                    if (close < 0) {
                        push out (EditorDiagnostic.span(li i len (DiagnosticSeverity.error()) "string is never closed" "ranger"))
                        break
                    }
                    i = (close + 1)
                    continue
                }
                if (RangerLanguage.isOpen(ch)) {
                    push stackCh ch
                    push stackLine li
                    push stackCol i
                }
                if (RangerLanguage.isClose(ch)) {
                    def depth:int (array_length stackCh)
                    if (depth == 0) {
                        push out (EditorDiagnostic.span(li i (i + 1) (DiagnosticSeverity.error()) ("stray '" + (strfromcode ch) + "' — nothing opened here") "ranger"))
                    } {
                        def openCh:int (itemAt stackCh (depth - 1))
                        def want:int (RangerLanguage.closerFor(openCh))
                        if (want != ch) {
                            def msg:string ((("'" + (strfromcode ch)) + "' closes a '") + (strfromcode openCh) + "' — expected '" + (strfromcode want) + "'")
                            push out (EditorDiagnostic.span(li i (i + 1) (DiagnosticSeverity.error()) msg "ranger"))
                        }
                        removeLast stackCh
                        removeLast stackLine
                        removeLast stackCol
                    }
                }
                i = (i + 1)
            }
            li = (li + 1)
        }
        def rest:int (array_length stackCh)
        if (rest > 0) {
            def openCh2:int (itemAt stackCh (rest - 1))
            def atLine:int (itemAt stackLine (rest - 1))
            def atCol:int (itemAt stackCol (rest - 1))
            push out (EditorDiagnostic.span(atLine atCol (atCol + 1) (DiagnosticSeverity.error()) ("'" + (strfromcode openCh2) + "' is never closed") "ranger"))
        }
    }

    fn stringEnd:int (s:string from:int) {
        def i:int from
        def n:int (strlen s)
        while (i < n) {
            def ch:int (charAt s i)
            if (ch == 92) {
                i = (i + 2)
                continue
            }
            if (ch == 34) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    sfn isOpen:boolean (ch:int) {
        if (ch == 40) {
            return true
        }
        if (ch == 91) {
            return true
        }
        return (ch == 123)
    }

    sfn isClose:boolean (ch:int) {
        if (ch == 41) {
            return true
        }
        if (ch == 93) {
            return true
        }
        return (ch == 125)
    }

    sfn closerFor:int (open:int) {
        if (open == 40) {
            return 41
        }
        if (open == 91) {
            return 93
        }
        return 125
    }

    ; --- the mistakes this repository actually makes ---------------------------
    ; From AGENTS.md, which lists them because they cost hours: a returned call
    ; needs its own parentheses, and a statement may not start with a
    ; parenthesised receiver. Both compile to misleading errors somewhere else,
    ; which is exactly the kind of thing an editor should say early.
    fn gotchas:void (lines:[string] out:[EditorDiagnostic]) {
        def li:int 0
        def n:int (array_length lines)
        while (li < n) {
            def raw:string (itemAt lines li)
            def indent:int (this.indentOf(raw))
            def body:string (substring raw indent (strlen raw))
            if ((this.beginsWith(body "return ")) && ((strlen body) > 7)) {
                def rest:string (substring body 7 (strlen body))
                def first:int (charAt rest 0)
                if (first != 40) {
                    if (this.looksLikeCall(rest)) {
                        def col:int (indent + 7)
                        push out (EditorDiagnostic.span(li col (strlen raw) (DiagnosticSeverity.warning()) "a returned call needs its own parentheses: return (this.f())" "ranger"))
                    }
                }
            }
            if ((strlen body) > 1) {
                def opener:int (charAt body 0)
                if (opener == 40) {
                    ; `(recv.method())` as a STATEMENT. Inside an expression it
                    ; is fine, so only a line that starts with it is flagged.
                    if (this.looksLikeReceiverCall(body)) {
                        push out (EditorDiagnostic.span(li indent (strlen raw) (DiagnosticSeverity.warning()) "a statement may not start with a parenthesised receiver — bind it first" "ranger"))
                    }
                }
            }
            li = (li + 1)
        }
    }

    fn indentOf:int (s:string) {
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def ch:int (charAt s i)
            if ((ch != 32) && (ch != 9)) {
                return i
            }
            i = (i + 1)
        }
        return n
    }

    fn beginsWith:boolean (s:string prefix:string) {
        def n:int (strlen prefix)
        if ((strlen s) < n) {
            return false
        }
        def head:string (substring s 0 n)
        return (head == prefix)
    }

    ; `foo.bar()` or `foo(x)` — an unparenthesised call, rather than a value.
    fn looksLikeCall:boolean (s:string) {
        def sawOpen:boolean false
        def sawClose:boolean false
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def ch:int (charAt s i)
            if (ch == 40) {
                sawOpen = true
            }
            if (ch == 41) {
                if sawOpen {
                    sawClose = true
                }
            }
            ; An operator in the expression means it is arithmetic, not a bare
            ; returned call, and those are legal.
            if (ch == 43) {
                return false
            }
            if (ch == 63) {
                return false
            }
            i = (i + 1)
        }
        if (sawOpen == false) {
            return false
        }
        return sawClose
    }

    ; `(thing.method(` — the receiver form, as opposed to `(op a b)`, which is
    ; every other line in the language.
    fn looksLikeReceiverCall:boolean (s:string) {
        def i:int 1
        def n:int (strlen s)
        def sawDot:boolean false
        while (i < n) {
            def ch:int (charAt s i)
            if (ch == 32) {
                return false
            }
            if (ch == 40) {
                return sawDot
            }
            if (ch == 46) {
                sawDot = true
            }
            i = (i + 1)
        }
        return false
    }
}

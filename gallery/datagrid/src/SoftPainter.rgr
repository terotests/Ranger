; ==============================================================================
; SoftPainter.rgr — an EVG display list, painted onto a SoftCanvas.
; ==============================================================================
;
; This used to live inside GridView, which was fine while the only thing anyone
; painted was the page. Copying a CHART to the clipboard needs the same painting
; at a different size and onto a different surface — 640x400 of chart, with no
; sheet behind it — and a second copy of the loop would be a second chance to
; disagree with the first.
;
; So the loop moved here and takes its surface as an argument. GridView hands it
; the page canvas; the clipboard hands it an off-screen one. Both draw the same
; commands the same way, which is the property that makes "what you copied is
; what you saw" true rather than hoped for.
;
; The kinds are EVG's, unchanged:
;   0 RECT   1 BORDER   2 IMAGE   3 TEXT   4 PUSH_CLIP   5 POP_CLIP
;   6 PATH   7 STROKE
; SoftCanvas has no scissor, so clip commands intersect the draw calls here.
; ==============================================================================

Import "GridImages.rgr"
Import "../../game_engine/framebuffer.rgr"
Import "../../game_engine/ui/UIContext.rgr"
Import "../../evg/EVGColor.rgr"
Import "../../evg/EVGDisplayList.rgr"

; A rectangle and whether anything of it survived the clip. A class rather
; than four out-parameters because an object is a reference on every target
; Ranger compiles to and an array parameter is not.
class ClipBox {
    def x:int 0
    def y:int 0
    def w:int 0
    def h:int 0
    def ok:boolean true

    Constructor () {
    }
}

class SoftPainter {
    ; The surface. `own` is used when this painter made it, which is the
    ; off-screen case; GridView attaches its own and keeps it.
    def own:SoftCanvas (new SoftCanvas)
    def canvas:SoftCanvas (new SoftCanvas)
    def ctx:UIContext (new UIContext)
    ; Pictures the sheet anchored. Empty for a chart, which has none.
    def images:GridImages (new GridImages)
    def clipW:int 0
    def clipH:int 0
    def fontFamily:string "Open Sans"
    ; Nested clip rectangles (x,y,w,h packed as four ints per level).
    def clipStack:[int]

    Constructor () {
    }

    ; Paint onto a surface someone else owns, with their context and pictures.
    fn attach:void (c:SoftCanvas x:UIContext im:GridImages w:int h:int) {
        canvas = c
        ctx = x
        images = im
        clipW = w
        clipH = h
        clear clipStack
    }

    ; Paint onto a surface of this painter's own, sharing the caller's text
    ; renderer — fonts are loaded once per app, not once per copy.
    fn begin:void (w:int h:int tr:UITextRenderer) {
        own.init(w h)
        canvas = own
        ctx = (new UIContext)
        ctx.attach(own)
        ctx.tr = tr
        clipW = w
        clipH = h
        clear clipStack
    }

    fn pushClipRect:void (x:int y:int w:int h:int) {
        def cx:int x
        def cy:int y
        def cw:int w
        def ch:int h
        if ((array_length clipStack) >= 4) {
            def n:int (array_length clipStack)
            def ox:int (itemAt clipStack (n - 4))
            def oy:int (itemAt clipStack (n - 3))
            def ow:int (itemAt clipStack (n - 2))
            def oh:int (itemAt clipStack (n - 1))
            def x1:int cx
            if (ox > x1) {
                x1 = ox
            }
            def y1:int cy
            if (oy > y1) {
                y1 = oy
            }
            def x2:int (cx + cw)
            if ((ox + ow) < x2) {
                x2 = (ox + ow)
            }
            def y2:int (cy + ch)
            if ((oy + oh) < y2) {
                y2 = (oy + oh)
            }
            cx = x1
            cy = y1
            cw = (x2 - x1)
            ch = (y2 - y1)
            if (cw < 0) {
                cw = 0
            }
            if (ch < 0) {
                ch = 0
            }
        }
        push clipStack cx
        push clipStack cy
        push clipStack cw
        push clipStack ch
    }

    fn popClipRect:void () {
        def n:int (array_length clipStack)
        if (n >= 4) {
            removeLast clipStack
            removeLast clipStack
            removeLast clipStack
            removeLast clipStack
        }
    }

    fn hasClip:boolean () {
        return ((array_length clipStack) >= 4)
    }

    fn clipX0:int () {
        def n:int (array_length clipStack)
        return (itemAt clipStack (n - 4))
    }

    fn clipY0:int () {
        def n:int (array_length clipStack)
        return (itemAt clipStack (n - 3))
    }

    fn clipX1:int () {
        def n:int (array_length clipStack)
        return ((itemAt clipStack (n - 4)) + (itemAt clipStack (n - 2)))
    }

    fn clipY1:int () {
        def n:int (array_length clipStack)
        return ((itemAt clipStack (n - 3)) + (itemAt clipStack (n - 1)))
    }

    ; Intersect a rect with the current clip.
    ;
    ; This used to take four one-element arrays and write the answer back into
    ; them, which works on the JavaScript target — where an array is a
    ; reference — and does nothing at all on the C++ one, where `[int]` is a
    ; `std::vector<int>` parameter taken BY VALUE. The caller's rect was never
    ; narrowed, so the native build ignored every clip on every rectangle and
    ; every border it ever drew. Nothing had noticed because nothing was drawn
    ; outside a clip until an active-cell ring was; the render-parity harness
    ; caught it the moment one was.
    ;
    ; An object is a reference on both targets, so the answer comes back as
    ; one.
    fn intersectClip:ClipBox (x:int y:int w:int h:int) {
        def out:ClipBox (new ClipBox)
        out.x = x
        out.y = y
        out.w = w
        out.h = h
        out.ok = true
        if ((this.hasClip()) == false) {
            return out
        }
        def x0:int x
        def y0:int y
        def x1:int (x + w)
        def y1:int (y + h)
        def cx0:int (this.clipX0())
        def cy0:int (this.clipY0())
        def cx1:int (this.clipX1())
        def cy1:int (this.clipY1())
        if (cx0 > x0) {
            x0 = cx0
        }
        if (cy0 > y0) {
            y0 = cy0
        }
        if (cx1 < x1) {
            x1 = cx1
        }
        if (cy1 < y1) {
            y1 = cy1
        }
        if ((x1 <= x0) || (y1 <= y0)) {
            out.ok = false
            return out
        }
        out.x = x0
        out.y = y0
        out.w = (x1 - x0)
        out.h = (y1 - y0)
        return out
    }

    ; One filled rectangle, cut to the clip.
    fn fillClipped:void (x:int y:int w:int h:int col:EVGColor) {
        if (w <= 0) {
            return
        }
        if (h <= 0) {
            return
        }
        def b:ClipBox (this.intersectClip(x y w h))
        if (b.ok == false) {
            return
        }
        ctx.fillRect(b.x b.y b.w b.h col)
    }

    fn textInClip:boolean (x:int y:int size:double) {
        if ((this.hasClip()) == false) {
            return true
        }
        def h:int (to_int (size + 4.0))
        if ((y + h) <= (this.clipY0())) {
            return false
        }
        if (y >= (this.clipY1())) {
            return false
        }
        if (x >= (this.clipX1())) {
            return false
        }
        return true
    }

    fn raw:buffer () {
        return (canvas.raw())
    }

    fn clear:void (col:EVGColor) {
        canvas.clear((col.red()) (col.green()) (col.blue()))
    }

    ; The face a TEXT command asks for. `c.fontFamily` is the resolved base
    ; (Open Sans, Noto Sans, …); weight/slant pick the cut.
    fn applyFaceStyled:void (family:string bold:boolean italic:boolean) {
        def base:string fontFamily
        if ((strlen family) > 0) {
            base = family
        }
        ; `"-BoldItalic"` — no space — is not what FontManager registered the
        ; face as, and the miss falls through to the family's REGULAR cut with
        ; a real unitsPerEm, so the check below passes and bold italic text
        ; drew upright and light. One rule, one place.
        def want:string (UITextRenderer.faceName(base bold italic))
        if (ctx.tr.fontFamily == want) {
            return
        }
        def face:TrueTypeFont (ctx.tr.fm.getFont(want))
        if (face.unitsPerEm > 0) {
            ctx.tr.fontFamily = want
            ctx.tr.applyFace()
            return
        }
        ; Missing bold/italic cut: try the regular of that family.
        if (want != base) {
            def reg:TrueTypeFont (ctx.tr.fm.getFont(base))
            if (reg.unitsPerEm > 0) {
                ctx.tr.fontFamily = base
                ctx.tr.applyFace()
            }
        }
    }

    fn draw:void (dl:EVGDisplayList) {
        clear clipStack
        def i:int 0
        def n:int (dl.count())
        while (i < n) {
            def c:EVGDrawCmd (dl.at(i))
            if (c.kind == 4) {
                this.pushClipRect((to_int c.x) (to_int c.y) (to_int c.w) (to_int c.h))
            }
            if (c.kind == 5) {
                this.popClipRect()
            }
            if (c.kind == 0) {
                def rb:ClipBox (this.intersectClip((to_int c.x) (to_int c.y) (to_int c.w) (to_int c.h)))
                if rb.ok {
                    def col:EVGColor (EVGColor.create((to_double c.r) (to_double c.g) (to_double c.b) c.a))
                    ctx.fillRect(rb.x rb.y rb.w rb.h col)
                }
            }
            if (c.kind == 1) {
                ; A BORDER is an OUTLINE, so narrowing its rectangle to the
                ; clip would move the four lines rather than cut them: a ring
                ; poking one pixel out of the body would be redrawn a pixel
                ; smaller, in the wrong place, with all four sides still
                ; showing. Each side is filled separately instead, and each is
                ; clipped as the rectangle it actually is.
                def th:int (to_int c.thickness)
                if (th < 1) {
                    th = 1
                }
                def bx0:int (to_int c.x)
                def by0:int (to_int c.y)
                def bw0:int (to_int c.w)
                def bh0:int (to_int c.h)
                def col2:EVGColor (EVGColor.create((to_double c.r) (to_double c.g) (to_double c.b) c.a))
                this.fillClipped(bx0 by0 bw0 th col2)
                this.fillClipped(bx0 ((by0 + bh0) - th) bw0 th col2)
                this.fillClipped(bx0 by0 th bh0 col2)
                this.fillClipped(((bx0 + bw0) - th) by0 th bh0 col2)
            }
            if (c.kind == 3) {
                if (this.textInClip((to_int c.x) (to_int c.y) c.fontSize)) {
                    def col3:EVGColor (EVGColor.create((to_double c.r) (to_double c.g) (to_double c.b) c.a))
                    this.applyFaceStyled(c.fontFamily (c.fontWeight == "bold") (c.textAlign == "italic"))
                    if (c.rotate == 0.0) {
                        ; CUT to the clip, not merely tested against it.
                        ; `textInClip` answers "does this string begin inside
                        ; the rectangle", and a label beginning one pixel
                        ; inside its cell used to be drawn in full — across an
                        ; occupied neighbour, over the row numbers, off the
                        ; left edge of the window.
                        if (this.hasClip()) {
                            ctx.textClipped(c.text (to_int c.x) (to_int c.y) c.fontSize col3 (this.clipX0()) (this.clipY0()) (this.clipX1()) (this.clipY1()))
                        } {
                            ctx.text(c.text (to_int c.x) (to_int c.y) c.fontSize col3)
                        }
                    } {
                        ctx.textRotated(c.text (to_int c.x) (to_int c.y) c.fontSize col3 c.rotate)
                    }
                }
            }
            if (c.kind == 2) {
                def entry:DecodedImage (images.cached(c.src))
                if entry.ok {
                    def ix:int (to_int c.x)
                    def iy:int (to_int c.y)
                    def iw:int (to_int c.w)
                    def ih:int (to_int c.h)
                    def destW:int clipW
                    def destH:int clipH
                    if (this.hasClip()) {
                        destW = (this.clipX1())
                        destH = (this.clipY1())
                        if (ix < (this.clipX0())) {
                            ; blitScaled clips to dest origin 0,0 — shift via
                            ; destination bounds only when clip starts at 0.
                        }
                    }
                    images.blitScaled(canvas entry.img ix iy iw ih 0 0 destW destH)
                } {
                    ; A picture that could not be decoded is drawn as its own
                    ; outline with the reason in it, rather than as nothing.
                    def note:EVGColor (EVGColor.rgb(80 92 110))
                    ctx.strokeRect((to_int c.x) (to_int c.y) (to_int c.w) (to_int c.h) 1 note)
                    def why:string entry.note
                    if ((strlen why) == 0) {
                        why = "image"
                    }
                    this.applyFaceStyled("" false false)
                    ctx.text(why ((to_int c.x) + 4) ((to_int c.y) + 4) 11.0 note)
                }
            }
            ; Vector ink: a chart's bars, wedges and grid lines arrive as
            ; flattened rings, exactly as the WebGL backend gets them. Without
            ; these two the browser would show a chart and the PNG would show
            ; an empty box, which is the disagreement the display list exists
            ; to prevent.
            if (c.kind == 6) {
                this.fillRings(c)
            }
            if (c.kind == 7) {
                this.strokeRings(c)
            }
            i = (i + 1)
        }
    }

    ; One ring of a path command, as a flat point list.
    fn ringAt:[double] (c:EVGDrawCmd index:int) {
        def out:[double]
        def start:int 0
        if (index > 0) {
            start = (itemAt c.ringEnds (index - 1))
        }
        def stop:int (itemAt c.ringEnds index)
        def k:int start
        while (k < stop) {
            push out (itemAt c.pts k)
            k = (k + 1)
        }
        return out
    }

    ; Every contour at once, under the even-odd rule.
    ;
    ; This used to fill each ring on its own, which draws an inner contour
    ; SOLID on top of the outer one instead of subtracting it — so a hole is
    ; impossible: a donut is a disc, a ring is a blob, and a glyph cut out of
    ; a face is invisible. `fillPolygonRings` closes each contour on itself
    ; and pairs the crossings across all of them, which is the even-odd rule
    ; and is what makes an inner contour a hole.
    fn fillRings:void (c:EVGDrawCmd) {
        def alpha:int (to_int (c.a * 255.0))
        if (alpha <= 0) {
            return
        }
        ctx.fillPolygonRings(c.pts c.ringEnds c.r c.g c.b alpha)
    }

    ; A stroke becomes a quad per segment — the same expansion the WebGL
    ; backend does, so the two agree on what a one-pixel grid line looks like.
    fn strokeRings:void (c:EVGDrawCmd) {
        def alpha:int (to_int (c.a * 255.0))
        if (alpha <= 0) {
            return
        }
        def half:double (c.thickness / 2.0)
        if (half < 0.375) {
            half = 0.375
        }
        def i:int 0
        while (i < (array_length c.ringEnds)) {
            def ring:[double] (this.ringAt(c i))
            def n:int (array_length ring)
            def k:int 0
            while ((k + 3) < n) {
                def x1:double (itemAt ring k)
                def y1:double (itemAt ring (k + 1))
                def x2:double (itemAt ring (k + 2))
                def y2:double (itemAt ring (k + 3))
                def dx:double (x2 - x1)
                def dy:double (y2 - y1)
                def len:double (sqrt ((dx * dx) + (dy * dy)))
                if (len > 0.0001) {
                    def nx:double (((0.0 - dy) / len) * half)
                    def ny:double ((dx / len) * half)
                    def quad:[double]
                    push quad (x1 + nx)
                    push quad (y1 + ny)
                    push quad (x2 + nx)
                    push quad (y2 + ny)
                    push quad (x2 - nx)
                    push quad (y2 - ny)
                    push quad (x1 - nx)
                    push quad (y1 - ny)
                    ctx.fillPolygon(quad c.r c.g c.b alpha)
                }
                k = (k + 2)
            }
            i = (i + 1)
        }
    }
}

; ==============================================================================
; SheetView - visible/order mapping over SpreadsheetModel (not CSS layout).
; ==============================================================================
;
; Keeps storage indices (model rows/cols) separate from screen rows/cols so
; hidden / filter / sort do not destroy worksheet data. DataGrid virtualizes
; over this view's geometry (prefix sums on visible rows only).
; ==============================================================================

Import "SpreadsheetModel.rgr"

class SheetView {
    def model:SpreadsheetModel
    def rowOrder:[int]
    def colOrder:[int]
    ; Frozen rows, plus an inferred table header while sorting.
    def sortHeadRows:int 0
    def rowOffsets:[int]
    def colOffsets:[int]
    def dirty:boolean true
    ; Sort keys, read once per row (decorate-sort-undecorate) and indexed by
    ; model row. The merge used to ask `getCell` for both sides of every
    ; comparison: a 500k-row sort is ~9.5M comparisons, so ~19M map lookups
    ; to answer questions about 500k distinct values.
    def sortKind:[int]
    def sortNum:[double]
    def sortText:[string]

    Constructor () {
    }

    fn attach:void (m:SpreadsheetModel) {
        model = m
        dirty = true
        this.rebuild()
    }

    fn rebuild:void () {
        clear rowOrder
        clear colOrder
        model.ensureGeometry()
        ; columns: skip hidden
        def c:int 0
        while (c < model.colCount) {
            if (model.isColHidden(c) == false) {
                push colOrder c
            }
            c = (c + 1)
        }
        ; rows: skip hidden + apply filter, then sort
        def rows:[int]
        def r:int 0
        while (r < model.rowCount) {
            if (model.isRowHidden(r) == false) {
                if (this.rowPassesFilter(r)) {
                    push rows r
                }
            }
            r = (r + 1)
        }
        ; What counts as a heading is a fact about the DATA, and it has to be
        ; the same fact here as in `sortedOrder` — the view sort and the sort
        ; that moves the rows disagreeing about where the table starts is how
        ; a header ends up in the middle of one of them.
        sortHeadRows = (this.inferHeaderRows())
        if (model.freezeRows > 0) {
            ; The FIRST frozen row is a heading nearly every time, even on a
            ; sheet where nothing about the data says so — and whatever else
            ; is frozen below it, that top row must not sort into the body.
            ; How DEEP the pane is says nothing: nine frozen rows are not nine
            ; headings, and reading it that way is how a sort came to mark the
            ; column and move nothing at all.
            if (sortHeadRows < 1) {
                sortHeadRows = 1
            }
        }
        if (model.sortCol >= 0) {
            this.sortRows(rows model.sortCol model.sortAsc)
        }
        ; keep freeze header rows first if present
        def fz:int model.freezeRows
        if (fz > 0) {
            def head:[int]
            def body:[int]
            def i:int 0
            def n:int (array_length rows)
            while (i < n) {
                def rr:int (itemAt rows i)
                if (rr < fz) {
                    push head rr
                } {
                    push body rr
                }
                i = (i + 1)
            }
            clear rowOrder
            i = 0
            while (i < (array_length head)) {
                push rowOrder (itemAt head i)
                i = (i + 1)
            }
            i = 0
            while (i < (array_length body)) {
                push rowOrder (itemAt body i)
                i = (i + 1)
            }
        } {
            clear rowOrder
            def j:int 0
            while (j < (array_length rows)) {
                push rowOrder (itemAt rows j)
                j = (j + 1)
            }
        }
        this.rebuildOffsets()
        dirty = false
    }

    fn rowPassesFilter:boolean (row:int) {
        if (model.filterEnabled == false) {
            return true
        }
        if (model.filterCol < 0) {
            return true
        }
        ; header row always visible when freeze includes it
        if (row < model.freezeRows) {
            return true
        }
        def v:string (model.getCell(row model.filterCol))
        def i:int 0
        def n:int (array_length model.filterValues)
        if (n == 0) {
            return true
        }
        while (i < n) {
            if (v == (itemAt model.filterValues i)) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn sortRows:void (rows:[int] col:int asc:boolean) {
        ; Stable merge sort — insertion sort was O(n²) and fought the grid's
        ; 100k-row virtualization story.
        def n:int (array_length rows)
        if (n < 2) {
            return
        }
        this.buildSortKeys(rows col)
        def tmp:[int]
        def i:int 0
        while (i < n) {
            push tmp (itemAt rows i)
            i = (i + 1)
        }
        this.mergeSortRows(rows tmp 0 n col asc)
    }

    ; Read the sort column once per row, before any comparing happens.
    ;
    ; Indexed by model row rather than by position in `rows` so the merge can
    ; look a key up by the row number it is already carrying.
    fn buildSortKeys:void (rows:[int] col:int) {
        clear sortKind
        clear sortNum
        clear sortText
        def n:int (array_length rows)
        def maxRow:int -1
        def i:int 0
        while (i < n) {
            def r:int (itemAt rows i)
            if (r > maxRow) {
                maxRow = r
            }
            i = (i + 1)
        }
        def slot:int 0
        while (slot <= maxRow) {
            push sortKind 0
            push sortNum 0.0
            push sortText ""
            slot = (slot + 1)
        }
        i = 0
        while (i < n) {
            def row:int (itemAt rows i)
            def v:string (model.getCell(row col))
            if ((strlen v) > 0) {
                set_at sortText row v
                def d@(optional):double (to_double v)
                if d {
                    def dv:double (unwrap d)
                    set_at sortKind row 1
                    set_at sortNum row dv
                } {
                    set_at sortKind row 2
                }
            }
            i = (i + 1)
        }
    }

    ; Same ordering as `compareValues`, off the prepared keys.
    fn compareKeys:int (a:int b:int) {
        def ka:int (itemAt sortKind a)
        def kb:int (itemAt sortKind b)
        if (ka == 1) {
            if (kb == 1) {
                def x:double (itemAt sortNum a)
                def y:double (itemAt sortNum b)
                if (x < y) {
                    return -1
                }
                if (x > y) {
                    return 1
                }
                return 0
            }
        }
        def sa:string (itemAt sortText a)
        def sb:string (itemAt sortText b)
        return (this.compareText(sa sb))
    }

    ; The order EVERY row would be in if the sheet were sorted by `col`.
    ;
    ; `rowOrder` is not this: it leaves out whatever is hidden or filtered
    ; away, which is right for drawing and wrong for reordering the data,
    ; where every row has to be named exactly once. Header rows stay where
    ; they are, as they do on screen.
    fn sortedOrder:void (col:int asc:boolean out:[int]) {
        clear out
        ; How many rows stay put — and freezing panes is NOT the answer to
        ; that question. Where the window is pinned is a view decision, taken
        ; for reading; which rows are a heading is a fact about the data. This
        ; used to take the freeze count whole, so a sheet with nine frozen
        ; rows had nine headings and a sort marked the column and moved
        ; nothing at all — which looks exactly like sorting being broken.
        ;
        ; A frozen FIRST row is still worth honouring: it is a heading nearly
        ; every time, including on sheets where nothing about the data says so
        ; (no bold, no fill, text over text). Past the first, freezing says
        ; nothing.
        sortHeadRows = (this.inferHeaderRows())
        if (model.freezeRows > 0) {
            if (sortHeadRows < 1) {
                sortHeadRows = 1
            }
        }
        def all:[int]
        def r:int 0
        while (r < model.rowCount) {
            push all r
            r = (r + 1)
        }
        this.sortRows(all col asc)
        def i:int 0
        while (i < (array_length all)) {
            push out (itemAt all i)
            i = (i + 1)
        }
    }

    ; Keep a styled table heading (or a text heading over numeric data) above
    ; the sorted body even when the sheet did not explicitly freeze row 1.
    fn inferHeaderRows:int () {
        if (model.rowCount < 2) {
            return 0
        }
        def lastCol:int (model.usedCol())
        ; The table does not always start at row 1.
        ;
        ; A sheet is written the way a page is: a title, maybe a blank line,
        ; and then the table. Only asking about row 0 found the TITLE and
        ; called it the header, which left the real header row inside the body
        ; — where a sort drags it into the middle of the data. It stayed put on
        ; the fixture here only because "Category" happens to sort before
        ; "Logistics", which is luck, not behaviour.
        ;
        ; So walk down while the rows are not data: a blank row is not, and a
        ; row with something in ONE column of a table several columns wide is a
        ; title rather than a row. The first row that looks like a heading over
        ; the row beneath it ends the head, and is part of it.
        def head:int 0
        def limit:int 5
        if (limit > (model.rowCount - 1)) {
            limit = (model.rowCount - 1)
        }
        while (head < limit) {
            def filled:int (this.filledCount(head lastCol))
            if (filled == 0) {
                ; A blank line above the table.
                head = (head + 1)
            } {
                if (lastCol > 0) {
                    if (filled == 1) {
                        ; One cell across a wide sheet: a title.
                        head = (head + 1)
                    } {
                        if (this.looksLikeHeading(head lastCol)) {
                            return (head + 1)
                        }
                        return head
                    }
                } {
                    if (this.looksLikeHeading(head lastCol)) {
                        return (head + 1)
                    }
                    return head
                }
            }
        }
        return head
    }

    fn filledCount:int (row:int lastCol:int) {
        def n:int 0
        def c:int 0
        while (c <= lastCol) {
            if ((strlen (model.getCell(row c))) > 0) {
                n = (n + 1)
            }
            c = (c + 1)
        }
        return n
    }

    ; Is this row a heading over the one below it? Styled like one — bold or
    ; filled — or words standing over numbers.
    fn looksLikeHeading:boolean (row:int lastCol:int) {
        if ((row + 1) >= model.rowCount) {
            return false
        }
        def c:int 0
        while (c <= lastCol) {
            def top:string (model.getCell(row c))
            def body:string (model.getCell((row + 1) c))
            if ((strlen top) > 0) {
                def st:CellStyle (model.getCellStyle(row c))
                if (st.bold || st.hasFill) {
                    return true
                }
                if ((strlen body) > 0) {
                    def a@(optional):double (to_double top)
                    def b@(optional):double (to_double body)
                    def topNumeric:boolean false
                    if a {
                        topNumeric = true
                    }
                    if (topNumeric == false) {
                        if b {
                            return true
                        }
                    }
                }
            }
            c = (c + 1)
        }
        return false
    }

    fn mergeSortRows:void (rows:[int] tmp:[int] lo:int hi:int col:int asc:boolean) {
        def n:int (hi - lo)
        if (n < 2) {
            return
        }
        def mid:int (lo + (idiv n 2))
        this.mergeSortRows(rows tmp lo mid col asc)
        this.mergeSortRows(rows tmp mid hi col asc)
        def i:int lo
        def j:int mid
        def k:int lo
        while (k < hi) {
            def takeLeft:boolean false
            if (i >= mid) {
                takeLeft = false
            } {
                if (j >= hi) {
                    takeLeft = true
                } {
                    def left:int (itemAt rows i)
                    def right:int (itemAt rows j)
                    ; Header rows stay ahead of body forever.
                    if (left < sortHeadRows) {
                        takeLeft = true
                    } {
                        if (right < sortHeadRows) {
                            takeLeft = false
                        } {
                            def lk:int (itemAt sortKind left)
                            def rk:int (itemAt sortKind right)
                            ; Empty tail rows belong after data in both orders.
                            if (lk == 0) {
                                if (rk == 0) {
                                    takeLeft = true
                                } {
                                    takeLeft = false
                                }
                            } {
                                if (rk == 0) {
                                    takeLeft = true
                                } {
                                    def cmp:int (this.compareKeys(left right))
                                    if asc {
                                        if (cmp <= 0) {
                                            takeLeft = true
                                        }
                                    } {
                                        if (cmp >= 0) {
                                            takeLeft = true
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if takeLeft {
                set_at tmp k (itemAt rows i)
                i = (i + 1)
            } {
                set_at tmp k (itemAt rows j)
                j = (j + 1)
            }
            k = (k + 1)
        }
        def t:int lo
        while (t < hi) {
            set_at rows t (itemAt tmp t)
            t = (t + 1)
        }
    }

    fn compareValues:int (a:string b:string) {
        def da@(optional):double (to_double a)
        def db@(optional):double (to_double b)
        if da {
            if db {
                def x:double (unwrap da)
                def y:double (unwrap db)
                if (x < y) {
                    return -1
                }
                if (x > y) {
                    return 1
                }
                return 0
            }
        }
        return (this.compareText(a b))
    }

    ; Lexicographic by code units.
    fn compareText:int (a:string b:string) {
        def i:int 0
        def na:int (strlen a)
        def nb:int (strlen b)
        def n:int na
        if (nb < n) {
            n = nb
        }
        while (i < n) {
            def ca:int (charAt a i)
            def cb:int (charAt b i)
            if (ca < cb) {
                return -1
            }
            if (ca > cb) {
                return 1
            }
            i = (i + 1)
        }
        if (na < nb) {
            return -1
        }
        if (na > nb) {
            return 1
        }
        return 0
    }

    fn rebuildOffsets:void () {
        clear rowOffsets
        clear colOffsets
        def acc:int 0
        push rowOffsets 0
        def i:int 0
        def rn:int (array_length rowOrder)
        while (i < rn) {
            def mr:int (itemAt rowOrder i)
            acc = (acc + (model.rowHeight(mr)))
            push rowOffsets acc
            i = (i + 1)
        }
        acc = 0
        push colOffsets 0
        i = 0
        def cn:int (array_length colOrder)
        while (i < cn) {
            def mc:int (itemAt colOrder i)
            acc = (acc + (model.colWidth(mc)))
            push colOffsets acc
            i = (i + 1)
        }
    }

    fn ensure:void () {
        if dirty {
            this.rebuild()
        }
    }

    fn rowCount:int () {
        this.ensure()
        return (array_length rowOrder)
    }

    fn colCount:int () {
        this.ensure()
        return (array_length colOrder)
    }

    fn modelRow:int (viewRow:int) {
        this.ensure()
        if ((viewRow < 0) || (viewRow >= (array_length rowOrder))) {
            return viewRow
        }
        return (itemAt rowOrder viewRow)
    }

    fn modelCol:int (viewCol:int) {
        this.ensure()
        if ((viewCol < 0) || (viewCol >= (array_length colOrder))) {
            return viewCol
        }
        return (itemAt colOrder viewCol)
    }

    fn viewRowOf:int (modelRow:int) {
        this.ensure()
        def i:int 0
        def n:int (array_length rowOrder)
        while (i < n) {
            if ((itemAt rowOrder i) == modelRow) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn viewColOf:int (modelCol:int) {
        this.ensure()
        def i:int 0
        def n:int (array_length colOrder)
        while (i < n) {
            if ((itemAt colOrder i) == modelCol) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn rowToY:int (viewRow:int) {
        this.ensure()
        if (viewRow <= 0) {
            return 0
        }
        def n:int (array_length rowOrder)
        if (viewRow >= n) {
            return (itemAt rowOffsets n)
        }
        return (itemAt rowOffsets viewRow)
    }

    fn colToX:int (viewCol:int) {
        this.ensure()
        if (viewCol <= 0) {
            return 0
        }
        def n:int (array_length colOrder)
        if (viewCol >= n) {
            return (itemAt colOffsets n)
        }
        return (itemAt colOffsets viewCol)
    }

    fn totalHeight:int () {
        this.ensure()
        return (itemAt rowOffsets (array_length rowOrder))
    }

    fn totalWidth:int () {
        this.ensure()
        return (itemAt colOffsets (array_length colOrder))
    }

    fn yToRow:int (y:int) {
        this.ensure()
        if (y <= 0) {
            return 0
        }
        def n:int (array_length rowOrder)
        if (n == 0) {
            return 0
        }
        def total:int (itemAt rowOffsets n)
        if (y >= total) {
            return (n - 1)
        }
        def lo:int 0
        def hi:int (n - 1)
        while (lo < hi) {
            def mid:int (to_int ((lo + hi + 1) / 2))
            if ((itemAt rowOffsets mid) <= y) {
                lo = mid
            } {
                hi = (mid - 1)
            }
        }
        return lo
    }

    fn xToCol:int (x:int) {
        this.ensure()
        if (x <= 0) {
            return 0
        }
        def n:int (array_length colOrder)
        if (n == 0) {
            return 0
        }
        def total:int (itemAt colOffsets n)
        if (x >= total) {
            return (n - 1)
        }
        def lo:int 0
        def hi:int (n - 1)
        while (lo < hi) {
            def mid:int (to_int ((lo + hi + 1) / 2))
            if ((itemAt colOffsets mid) <= x) {
                lo = mid
            } {
                hi = (mid - 1)
            }
        }
        return lo
    }

    fn rowHeight:int (viewRow:int) {
        return (model.rowHeight((this.modelRow(viewRow))))
    }

    fn colWidth:int (viewCol:int) {
        return (model.colWidth((this.modelCol(viewCol))))
    }

    fn markDirty:void () {
        dirty = true
    }
}

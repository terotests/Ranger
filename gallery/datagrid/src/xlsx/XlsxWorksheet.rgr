; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; XlsxWorksheet - parse one worksheet XML into a SpreadsheetModel.
; ==============================================================================
;
; Viewer v1: values, shared/inline strings, booleans, cached formula results,
; column widths, row heights, merge ranges. No formula engine.
; ==============================================================================

Import "../../../ooxml/OpcPackage.rgr"
Import "XmlLite.rgr"
Import "XlsxSharedStrings.rgr"
Import "../SpreadsheetModel.rgr"
Import "../FormulaEngine.rgr"

class XlsxWorksheet {
    ; The sheet's own relationship part, and the comments part it points at.
    ; Both are optional and both are set by the loader before `parse`, because
    ; a hyperlink's target and a note's text live outside the sheet XML.
    def relsXml:string ""
    def commentsXml:string ""

    ; Shared formulas. Excel does not repeat a formula it can derive: it writes
    ; the text once, on the first cell of a run —
    ;   <f t="shared" ref="O10:O17" si="3">SUM(C10:N10)</f>
    ; — and every other cell in that run carries only <f t="shared" si="3"/>.
    ; Reading just the tags that have text left those cells with their cached
    ; number and no formula at all, which is what "the sums stop delegating"
    ; looks like from the outside: the totals were no longer formulas, so
    ; nothing downstream of an edit moved. `si` is the run's id; the run's
    ; anchor is the cell the text was on, and every other member is that
    ; formula translated by its offset from the anchor.
    def sharedText:[string:string]
    def sharedRow:[string:string]
    def sharedCol:[string:string]

    ; Row auto-fit. A file states a row's height only when it is NOT the
    ; automatic one, so a row it says nothing about is as tall as its tallest
    ; text needs — which is why 12pt text sits comfortably in Excel inside a
    ; sheet whose stated default is 12.75pt, and was clipped and overlapping
    ; here.
    ;
    ; The sizes themselves cannot be read while parsing: a cell names a style
    ; by index and the style table is not attached to the sheet until the
    ; whole part has been read. So parsing records only WHERE the content is,
    ; per row, and `autoFitRows` — run by the loader once the styles are in
    ; place — reads the sizes and grows the rows.
    def rowMinCol:[int]
    def rowMaxCol:[int]
    def rowStated:[boolean]
    ; True when any cell carried a style index. Unstyled sheets (common for
    ; large CSV-style exports) can auto-fit from `defaultFontPt` alone — the
    ; per-cell `getCell` walk is what made C++ hang for minutes on 500k rows
    ; while the browser finished in seconds (JS string maps share values;
    ; C++ copies every key lookup).
    def sawCellStyle:boolean false
    ; Scratch for the hot `parseCell` path so we do not allocate two int
    ; vectors per cell just to read A1-style refs.
    def refRow:int 0
    def refCol:int 0

    Constructor () {
    }

    ; rId → Target, out of a sheet's own `.rels` part. The scan is
    ; `OpcPackage`'s, which is the same one the .docx and .pptx readers use;
    ; this file used to have two of its own. The RAW target comes back here
    ; rather than a package path, because a hyperlink's target is a URL and the
    ; caller resolves the rest against the part that named it.
    sfn relTarget:string (rels:string id:string) {
        if ((strlen rels) == 0) {
            return ""
        }
        if ((strlen id) == 0) {
            return ""
        }
        def list:[OpcRelationship] (OpcPackage.parseRelationships(rels))
        def i:int 0
        while (i < (array_length list)) {
            def rel:OpcRelationship (itemAt list i)
            if (rel.id == id) {
                return rel.target
            }
            i = (i + 1)
        }
        return ""
    }

    ; The first relationship of a given type — how the comments part and the
    ; drawing part are found. The suffix has to match the END of the type:
    ; "/drawing" is not "/drawingHF", and a header picture is not a picture on
    ; the sheet.
    sfn relTargetOfType:string (rels:string typeSuffix:string) {
        if ((strlen rels) == 0) {
            return ""
        }
        def list:[OpcRelationship] (OpcPackage.parseRelationships(rels))
        def i:int 0
        while (i < (array_length list)) {
            def rel:OpcRelationship (itemAt list i)
            if (OpcPackage.typeEndsWith(rel.type typeSuffix)) {
                if ((rel.isExternal()) == false) {
                    return rel.target
                }
            }
            i = (i + 1)
        }
        return ""
    }

    ; Notes, out of `xl/comments1.xml`. The author list is skipped: what a
    ; spreadsheet shows in the little box is the text, and our note is one
    ; string rather than a run list.
    fn parseComments:void (model:SpreadsheetModel xml:string) {
        if ((strlen xml) == 0) {
            return
        }
        def p:XmlLite (new XmlLite)
        p.reset(xml)
        while (p.pos < p.len) {
            def t:XmlTag (p.nextTag())
            if (t.valid == false) {
                break
            }
            if ((t.name == "comment") && (t.isEnd == false)) {
                def ref:string (t.attr("ref"))
                def rOut:[int]
                def cOut:[int]
                XlsxWorksheet.parseCellRef(ref rOut cOut)
                def body:string (p.collectTTextUntil("comment"))
                if ((array_length rOut) > 0) {
                    if ((strlen body) > 0) {
                        model.setNote((itemAt rOut 0) (itemAt cOut 0) body)
                    }
                }
            }
        }
    }

    ; The first whitespace-separated token of a reference list. `sqref` may
    ; name several ranges — "A1:A5 C1:C5" — and one rule per first range is
    ; what the model stores.
    sfn firstToken:string (s:string) {
        def n:int (strlen s)
        def i:int 0
        while (i < n) {
            if ((charAt s i) == 32) {
                return (substring s 0 i)
            }
            i = (i + 1)
        }
        return s
    }

    ; A1 / AA17 → 0-based row/col via out arrays (length-1).
    sfn parseCellRef:void (ref:string rowOut:[int] colOut:[int]) {
        def i:int 0
        def n:int (strlen ref)
        def col:int 0
        def sawCol:boolean false
        while (i < n) {
            def ch:int (charAt ref i)
            if ((ch >= 65) && (ch <= 90)) {
                col = ((col * 26) + ((ch - 65) + 1))
                sawCol = true
                i = (i + 1)
            } {
                if ((ch >= 97) && (ch <= 122)) {
                    col = ((col * 26) + ((ch - 97) + 1))
                    sawCol = true
                    i = (i + 1)
                } {
                    break
                }
            }
        }
        if sawCol {
            col = (col - 1)
        }
        def row:int 0
        def sawRow:boolean false
        while (i < n) {
            def ch2:int (charAt ref i)
            if ((ch2 >= 48) && (ch2 <= 57)) {
                row = ((row * 10) + (ch2 - 48))
                sawRow = true
                i = (i + 1)
            } {
                break
            }
        }
        if sawRow {
            row = (row - 1)
        }
        clear rowOut
        clear colOut
        push rowOut row
        push colOut col
    }

    sfn parseMergeRef:void (ref:string r1:[int] c1:[int] r2:[int] c2:[int]) {
        ; A1:D2
        def colon:int -1
        def i:int 0
        def n:int (strlen ref)
        while (i < n) {
            if ((charAt ref i) == 58) {
                colon = i
            }
            i = (i + 1)
        }
        if (colon < 0) {
            XlsxWorksheet.parseCellRef(ref r1 c1)
            clear r2
            clear c2
            push r2 (itemAt r1 0)
            push c2 (itemAt c1 0)
            return
        }
        def a:string (substring ref 0 colon)
        def b:string (substring ref (colon + 1) n)
        XlsxWorksheet.parseCellRef(a r1 c1)
        XlsxWorksheet.parseCellRef(b r2 c2)
    }

    ; Excel column width (character units) → CSS pixels.
    ;
    ; The unit is "how many digits of the default font fit", and the conversion
    ; Excel documents is `round(w * MDW) + padding`, where MDW is the width of
    ; the widest digit — 7 pixels for the 11-point default. This used 8, which
    ; made every column with a stated width about a seventh wider than the one
    ; the file describes; over a sheet it reads as a zoomed-in grid.
    sfn colWidthToPx:int (w:double) {
        def px:int (to_int (((w * 7.0) + 5.0) + 0.5))
        if (px < 16) {
            px = 16
        }
        return px
    }

    ; Row height in points → pixels (96 DPI).
    sfn rowHeightToPx:int (pt:double) {
        def px:int (to_int ((pt * 96.0) / 72.0))
        if (px < 8) {
            px = 8
        }
        return px
    }

    sfn parseDouble:double (s:string) {
        if ((strlen s) == 0) {
            return 0.0
        }
        def parsed@(optional):double (to_double s)
        if parsed {
            return (unwrap parsed)
        }
        return 0.0
    }

    sfn parseInt0:int (s:string) {
        def parsed@(optional):int (to_int s)
        if parsed {
            return (unwrap parsed)
        }
        return 0
    }

    fn applyDimension:void (model:SpreadsheetModel ref:string) {
        if ((strlen ref) == 0) {
            return
        }
        def r1:[int]
        def c1:[int]
        def r2:[int]
        def c2:[int]
        XlsxWorksheet.parseMergeRef(ref r1 c1 r2 c2)
        def rows:int ((itemAt r2 0) + 1)
        def cols:int ((itemAt c2 0) + 1)
        if (rows < 1) {
            rows = 1
        }
        if (cols < 1) {
            cols = 1
        }
        if (rows < model.rowCount) {
            rows = model.rowCount
        }
        if (cols < model.colCount) {
            cols = model.colCount
        }
        model.resize(rows cols)
    }

    fn ensureSize:void (model:SpreadsheetModel row:int col:int) {
        def rows:int model.rowCount
        def cols:int model.colCount
        if ((row + 1) > rows) {
            rows = (row + 1)
        }
        if ((col + 1) > cols) {
            cols = (col + 1)
        }
        if ((rows != model.rowCount) || (cols != model.colCount)) {
            ; growTo, NOT resize: `resize` rebuilds the width and height arrays
            ; from the defaults, and this runs in the middle of parsing — after
            ; <cols> has already said how wide column A is. A file that widens
            ; an early column and then mentions a later one lost the first
            ; width entirely.
            model.growTo(rows cols)
        }
    }

    ; The worksheet children `XlsxWriter.sheetXml` does not write.
    ;
    ; An allowlist rather than "anything unknown": the writer regenerates
    ; `cols`, `mergeCells`, `autoFilter`, `dataValidations`, `hyperlinks` and
    ; `tableParts` from the model, and preserving those too would put each of
    ; them in the file twice. This names what is genuinely unrepresented, and a
    ; name that is not on it is either modelled or deliberately dropped.
    sfn isPreserved:boolean (name:string) {
        if (name == "sheetPr") {
            return true
        }
        if (name == "sheetCalcPr") {
            return true
        }
        if (name == "sheetProtection") {
            return true
        }
        if (name == "protectedRanges") {
            return true
        }
        if (name == "scenarios") {
            return true
        }
        if (name == "phoneticPr") {
            return true
        }
        ; The loader DOES read conditional formatting into `cfRules`, and the
        ; writer does not write it. Preserving the source is what keeps it in
        ; the file until the writer learns to state it.
        if (name == "conditionalFormatting") {
            return true
        }
        if (name == "printOptions") {
            return true
        }
        if (name == "pageMargins") {
            return true
        }
        if (name == "pageSetup") {
            return true
        }
        if (name == "headerFooter") {
            return true
        }
        if (name == "rowBreaks") {
            return true
        }
        if (name == "colBreaks") {
            return true
        }
        if (name == "customProperties") {
            return true
        }
        if (name == "cellWatches") {
            return true
        }
        if (name == "ignoredErrors") {
            return true
        }
        if (name == "smartTags") {
            return true
        }
        ; The two that matter most: the pictures and the comments are in the
        ; package, and these are the only thing that says so.
        if (name == "drawing") {
            return true
        }
        if (name == "drawingHF") {
            return true
        }
        if (name == "legacyDrawing") {
            return true
        }
        if (name == "legacyDrawingHF") {
            return true
        }
        if (name == "picture") {
            return true
        }
        if (name == "oleObjects") {
            return true
        }
        if (name == "controls") {
            return true
        }
        if (name == "webPublishItems") {
            return true
        }
        if (name == "extLst") {
            return true
        }
        return false
    }

    ; The element `t` just opened, whole, as it appears in `xml` — and the
    ; parser left standing just past it.
    ;
    ; A self-closing tag is its own span. Anything else is scanned to its
    ; matching end tag, counting nesting, because `<extLst>` contains an
    ; `<ext>` that may contain another `<extLst>`.
    sfn spanOf:string (p:XmlLite xml:string t:XmlTag) {
        def start:int t.startPos
        if t.selfClose {
            return (substring xml start t.endPos)
        }
        def want:string t.name
        def depth:int 1
        while (p.pos < p.len) {
            def n:XmlTag (p.nextTag())
            if (n.valid == false) {
                return ""
            }
            if (n.name == want) {
                if n.isEnd {
                    depth = (depth - 1)
                    if (depth == 0) {
                        return (substring xml start n.endPos)
                    }
                } {
                    if (n.selfClose == false) {
                        depth = (depth + 1)
                    }
                }
            }
        }
        ; Ran off the end: the file is truncated. Preserving half an element
        ; would produce a package Excel refuses, so preserve none of it.
        return ""
    }

    fn parse:void (xml:string model:SpreadsheetModel sst:XlsxSharedStrings) {
        model.clearSheet()
        ; One parser serves every sheet in the book, and `si` is numbered from
        ; scratch in each of them.
        def noText:[string:string]
        def noRow:[string:string]
        def noCol:[string:string]
        sharedText = noText
        sharedRow = noRow
        sharedCol = noCol
        clear rowMinCol
        clear rowMaxCol
        clear rowStated
        sawCellStyle = false
        if ((strlen xml) == 0) {
            return
        }
        def p:XmlLite (new XmlLite)
        p.reset(xml)
        ; Depth-of-sheetData, so an `<extLst>` inside a cell is never mistaken
        ; for the worksheet's own. Everything captured below is a DIRECT child
        ; of `<worksheet>`; nothing inside `<sheetData>` is.
        def inSheetData:boolean false
        while (p.pos < p.len) {
            def t:XmlTag (p.nextTag())
            if (t.valid == false) {
                break
            }
            if (t.name == "sheetData") {
                inSheetData = (t.isEnd == false)
                if t.selfClose {
                    inSheetData = false
                }
            }
            ; A worksheet child this writer does not generate. Taken whole,
            ; source and all, so it can go back exactly as it came — see
            ; `SheetOpaque`. Without this a saved workbook keeps the pictures
            ; in the package and points at none of them.
            if (inSheetData == false) {
                if (t.isEnd == false) {
                    if (XlsxWorksheet.isPreserved(t.name)) {
                        def src:string (XlsxWorksheet.spanOf(p xml t))
                        if ((strlen src) > 0) {
                            def keep (new SheetOpaque)
                            keep.name = t.name
                            keep.source = src
                            push model.opaque keep
                        }
                        continue
                    }
                }
            }
            ; <sheetFormatPr defaultRowHeight="12.75" defaultColWidth="12.63"/>
            ; — how big a row or column is when the file does not say. Most
            ; columns in a real sheet have no <col> entry at all, so ignoring
            ; this was ignoring most of the sheet's geometry.
            if ((t.name == "sheetFormatPr") && (t.isEnd == false)) {
                def defH:int 0
                def defW:int 0
                if (t.has("defaultRowHeight")) {
                    def hpt:double (XlsxWorksheet.parseDouble((t.attr("defaultRowHeight"))))
                    if (hpt > 0.0) {
                        defH = (XlsxWorksheet.rowHeightToPx(hpt))
                    }
                }
                if (t.has("defaultColWidth")) {
                    def wch:double (XlsxWorksheet.parseDouble((t.attr("defaultColWidth"))))
                    if (wch > 0.0) {
                        defW = (XlsxWorksheet.colWidthToPx(wch))
                    }
                }
                if ((defH > 0) || (defW > 0)) {
                    model.setDefaultGeometry(defH defW)
                }
            }
            if ((t.name == "dimension") && (t.isEnd == false)) {
                this.applyDimension(model (t.attr("ref")))
            }
            if ((t.name == "pane") && (t.isEnd == false)) {
                ; `xSplit` / `ySplit` mean two different things and the `state`
                ; attribute is what says which.
                ;
                ;   state="frozen" / "frozenSplit"  counts of columns and rows
                ;   state="split", or absent        TWIPS — a position on the
                ;                                   page, twentieths of a point
                ;
                ; Read without looking at `state`, a sheet split a third of the
                ; way down reports two thousand frozen rows. Nothing on screen
                ; says so, because a freeze that large is clamped when it is
                ; drawn — but everything that asks the model how many rows are
                ; pinned gets two thousand, and sorting was one of them: every
                ; row it could see was a heading, so a sort marked the column
                ; and moved nothing.
                ;
                ; A split pane is not implemented here, so it is read as no
                ; freeze at all rather than as a freeze in the wrong unit.
                def st:string (t.attr("state"))
                def frozen:boolean false
                if (st == "frozen") {
                    frozen = true
                }
                if (st == "frozenSplit") {
                    frozen = true
                }
                if frozen {
                    def xs:string (t.attr("xSplit"))
                    def ys:string (t.attr("ySplit"))
                    def fc:int 0
                    def fr:int 0
                    if ((strlen xs) > 0) {
                        fc = (XlsxWorksheet.parseInt0(xs))
                    }
                    if ((strlen ys) > 0) {
                        fr = (XlsxWorksheet.parseInt0(ys))
                    }
                    model.setFreeze(fr fc)
                }
            }
            if ((t.name == "col") && (t.isEnd == false)) {
                def minC:int ((XlsxWorksheet.parseInt0((t.attr("min")))) - 1)
                def maxC:int ((XlsxWorksheet.parseInt0((t.attr("max")))) - 1)
                def w:double (XlsxWorksheet.parseDouble((t.attr("width"))))
                def px:int (XlsxWorksheet.colWidthToPx(w))
                if (maxC < minC) {
                    maxC = minC
                }
                this.ensureSize(model 0 maxC)
                def hideCol:boolean false
                if (t.has("hidden")) {
                    def hv:string (t.attr("hidden"))
                    if ((hv == "1") || (hv == "true")) {
                        hideCol = true
                    }
                }
                def c:int minC
                while (c <= maxC) {
                    model.setColWidth(c px)
                    if hideCol {
                        model.setColHidden(c true)
                    }
                    c = (c + 1)
                }
            }
            if ((t.name == "autoFilter") && (t.isEnd == false)) {
                ; record filter range start col for SheetView (basic)
                def ref:string (t.attr("ref"))
                if ((strlen ref) > 0) {
                    def r1:[int]
                    def c1:[int]
                    def r2:[int]
                    def c2:[int]
                    XlsxWorksheet.parseMergeRef(ref r1 c1 r2 c2)
                    model.filterCol = (itemAt c1 0)
                    ; enabled after user applies; presence marks autofilter exists
                    model.filterEnabled = false
                }
            }
            if ((t.name == "row") && (t.isEnd == false) && (t.selfClose == false)) {
                def rAttr:string (t.attr("r"))
                def rowIdx:int 0
                if ((strlen rAttr) > 0) {
                    rowIdx = ((XlsxWorksheet.parseInt0(rAttr)) - 1)
                }
                this.ensureSize(model rowIdx 0)
                if (t.has("ht")) {
                    def ht:double (XlsxWorksheet.parseDouble((t.attr("ht"))))
                    model.setRowHeight(rowIdx (XlsxWorksheet.rowHeightToPx(ht)))
                    this.noteRowStated(rowIdx)
                }
                if (t.has("hidden")) {
                    def rh:string (t.attr("hidden"))
                    if ((rh == "1") || (rh == "true")) {
                        model.setRowHidden(rowIdx true)
                    }
                }
                ; walk children until </row>
                def depth:int 1
                while ((p.pos < p.len) && (depth > 0)) {
                    def ct:XmlTag (p.nextTag())
                    if (ct.valid == false) {
                        break
                    }
                    if (ct.name == "row") {
                        if ct.isEnd {
                            depth = (depth - 1)
                        } {
                            if (ct.selfClose == false) {
                                depth = (depth + 1)
                            }
                        }
                    } {
                        if ((ct.name == "c") && (ct.isEnd == false)) {
                            this.parseCell(p ct model sst rowIdx)
                        }
                    }
                }
            }
            if ((t.name == "dataValidation") && (t.isEnd == false)) {
                def dv:DataValidation (new DataValidation)
                dv.kind = (t.attr("type"))
                def dop:string (t.attr("operator"))
                if ((strlen dop) > 0) {
                    dv.op = dop
                }
                def ab:string (t.attr("allowBlank"))
                if ((ab == "0") || (ab == "false")) {
                    dv.allowBlank = false
                }
                dv.errorTitle = (t.attr("errorTitle"))
                dv.errorText = (t.attr("error"))
                ; `sqref` may name several ranges; the first is taken, which is
                ; what a single rule almost always is.
                def sq:string (t.attr("sqref"))
                def vr1:[int]
                def vc1:[int]
                def vr2:[int]
                def vc2:[int]
                XlsxWorksheet.parseMergeRef((XlsxWorksheet.firstToken(sq)) vr1 vc1 vr2 vc2)
                if ((array_length vr1) > 0) {
                    dv.r0 = (itemAt vr1 0)
                    dv.c0 = (itemAt vc1 0)
                    dv.r1 = (itemAt vr2 0)
                    dv.c1 = (itemAt vc2 0)
                }
                if (t.selfClose == false) {
                    ; formula1 / formula2 are elements rather than attributes.
                    def depthV:int 1
                    while ((p.pos < p.len) && (depthV > 0)) {
                        def vt:XmlTag (p.nextTag())
                        if (vt.valid == false) {
                            break
                        }
                        if (vt.name == "dataValidation") {
                            if vt.isEnd {
                                depthV = (depthV - 1)
                            }
                        }
                        if ((vt.name == "formula1") && (vt.isEnd == false)) {
                            dv.f1 = (p.readTextUntilEnd("formula1"))
                        }
                        if ((vt.name == "formula2") && (vt.isEnd == false)) {
                            dv.f2 = (p.readTextUntilEnd("formula2"))
                        }
                    }
                }
                if ((strlen dv.kind) > 0) {
                    model.addValidation(dv)
                }
            }
            if ((t.name == "hyperlink") && (t.isEnd == false)) {
                def href:string (t.attr("ref"))
                def hr:[int]
                def hc:[int]
                XlsxWorksheet.parseCellRef(href hr hc)
                if ((array_length hr) > 0) {
                    ; An external link is a relationship; an internal one names
                    ; a place in this workbook and has no target at all.
                    def target:string (XlsxWorksheet.relTarget(relsXml (t.attr("r:id"))))
                    if ((strlen target) == 0) {
                        def loc:string (t.attr("location"))
                        if ((strlen loc) > 0) {
                            target = ("#" + loc)
                        }
                    }
                    if ((strlen target) > 0) {
                        model.setHyperlink((itemAt hr 0) (itemAt hc 0) target)
                    }
                }
            }
            if ((t.name == "mergeCell") && (t.isEnd == false)) {
                def mref:string (t.attr("ref"))
                def r1:[int]
                def c1:[int]
                def r2:[int]
                def c2:[int]
                XlsxWorksheet.parseMergeRef(mref r1 c1 r2 c2)
                model.addMerge((itemAt r1 0) (itemAt c1 0) (itemAt r2 0) (itemAt c2 0))
            }
            if ((t.name == "conditionalFormatting") && (t.isEnd == false)) {
                def sq:string (t.attr("sqref"))
                def rr1:[int]
                def cc1:[int]
                def rr2:[int]
                def cc2:[int]
                push rr1 0
                push cc1 0
                push rr2 0
                push cc2 0
                if ((strlen sq) > 0) {
                    ; take first ref token
                    def sp:int 0
                    while (sp < (strlen sq)) {
                        def sch:int (charAt sq sp)
                        if (sch == 32) {
                            break
                        }
                        sp = (sp + 1)
                    }
                    def one:string (substring sq 0 sp)
                    clear rr1
                    clear cc1
                    clear rr2
                    clear cc2
                    XlsxWorksheet.parseMergeRef(one rr1 cc1 rr2 cc2)
                }
                def colorIdx:int 0
                ; scan children for cfRule until </conditionalFormatting>
                def depth:int 1
                while ((p.pos < p.len) && (depth > 0)) {
                    def ct:XmlTag (p.nextTag())
                    if (ct.valid == false) {
                        break
                    }
                    if (ct.name == "conditionalFormatting") {
                        if ct.isEnd {
                            depth = (depth - 1)
                        } {
                            if (ct.selfClose == false) {
                                depth = (depth + 1)
                            }
                        }
                    } {
                        if ((ct.name == "cfRule") && (ct.isEnd == false)) {
                            def typ:string (ct.attr("type"))
                            def rule:CfRule (new CfRule)
                            rule.r0 = (itemAt rr1 0)
                            rule.c0 = (itemAt cc1 0)
                            rule.r1 = (itemAt rr2 0)
                            rule.c1 = (itemAt cc2 0)
                            if (typ == "colorScale") {
                                rule.kind = 0
                                push model.cfRules rule
                                colorIdx = 0
                            }
                            if (typ == "cellIs") {
                                rule.kind = 1
                                rule.op = (ct.attr("operator"))
                                rule.fillRgb = "#C6EFCE"
                                push model.cfRules rule
                            }
                        }
                        if ((ct.name == "color") && (ct.isEnd == false)) {
                            def ncf:int (array_length model.cfRules)
                            if (ncf > 0) {
                                def last:CfRule (itemAt model.cfRules (ncf - 1))
                                if (last.kind == 0) {
                                    def rgb:string (ct.attr("rgb"))
                                    if ((strlen rgb) >= 6) {
                                        if (colorIdx == 0) {
                                            last.color0 = rgb
                                        }
                                        if (colorIdx == 1) {
                                            last.color1 = rgb
                                        }
                                        if (colorIdx == 2) {
                                            last.color2 = rgb
                                        }
                                        colorIdx = (colorIdx + 1)
                                    }
                                }
                            }
                        }
                        if ((ct.name == "formula") && (ct.isEnd == false) && (ct.selfClose == false)) {
                            def ncf2:int (array_length model.cfRules)
                            if (ncf2 > 0) {
                                def last2:CfRule (itemAt model.cfRules (ncf2 - 1))
                                if (last2.kind == 1) {
                                    def ftxt:string (p.readTextUntilEnd("formula"))
                                    def pv@(optional):double (to_double ftxt)
                                    if pv {
                                        if (last2.v1 == 0.0) {
                                            last2.v1 = (unwrap pv)
                                        } {
                                            last2.v2 = (unwrap pv)
                                        }
                                    }
                                }
                            }
                        }
                        if ((ct.name == "dxf") && (ct.isEnd == false)) {
                            ; fill may appear later; default green highlight for cellIs
                            def ncf3:int (array_length model.cfRules)
                            if (ncf3 > 0) {
                                def last3:CfRule (itemAt model.cfRules (ncf3 - 1))
                                if (last3.kind == 1) {
                                    if ((strlen last3.fillRgb) == 0) {
                                        last3.fillRgb = "#C6EFCE"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        clear model.undoStack
        clear model.redoStack
        model.version = (model.version + 1)
    }

    fn noteRowStated:void (row:int) {
        while ((array_length rowStated) <= row) {
            push rowStated false
        }
        set_at rowStated row true
    }

    fn noteRowContent:void (row:int col:int) {
        while ((array_length rowMinCol) <= row) {
            push rowMinCol -1
            push rowMaxCol -1
        }
        def lo:int (itemAt rowMinCol row)
        if ((lo < 0) || (col < lo)) {
            set_at rowMinCol row col
        }
        def hi:int (itemAt rowMaxCol row)
        if (col > hi) {
            set_at rowMaxCol row col
        }
    }

    ; The largest point size among the cells that have something in them, on
    ; one row. Only the span the file actually wrote to is looked at, so a
    ; sheet with a hundred thousand empty columns costs nothing here.
    ;
    ; Uses style ids + `defaultFontPt` rather than `getCellStyle`, which would
    ; allocate a fresh default CellStyle for every unstyled cell.
    fn tallestIn:double (model:SpreadsheetModel row:int) {
        if (row >= (array_length rowMinCol)) {
            return 0.0
        }
        def lo:int (itemAt rowMinCol row)
        if (lo < 0) {
            return 0.0
        }
        def hi:int (itemAt rowMaxCol row)
        if (hi >= model.colCount) {
            hi = (model.colCount - 1)
        }
        def best:double 0.0
        def styleN:int (array_length model.styles)
        def c:int lo
        while (c <= hi) {
            def txt:string (model.getCell(row c))
            if ((strlen txt) > 0) {
                def pt:double model.defaultFontPt
                def sid:int (model.getCellStyleId(row c))
                if ((sid >= 0) && (sid < styleN)) {
                    def st:CellStyle (itemAt model.styles sid)
                    pt = st.fontSizePt
                }
                if (pt > best) {
                    best = pt
                }
            }
            c = (c + 1)
        }
        return best
    }

    ; A1 / AA17 → 0-based row/col into `refRow` / `refCol` (no heap arrays).
    fn parseCellRefFast:void (ref:string) {
        def i:int 0
        def n:int (strlen ref)
        def col:int 0
        def sawCol:boolean false
        while (i < n) {
            def ch:int (charAt ref i)
            if ((ch >= 65) && (ch <= 90)) {
                col = ((col * 26) + ((ch - 65) + 1))
                sawCol = true
                i = (i + 1)
            } {
                if ((ch >= 97) && (ch <= 122)) {
                    col = ((col * 26) + ((ch - 97) + 1))
                    sawCol = true
                    i = (i + 1)
                } {
                    break
                }
            }
        }
        if sawCol {
            col = (col - 1)
        }
        def row:int 0
        def sawRow:boolean false
        while (i < n) {
            def ch2:int (charAt ref i)
            if ((ch2 >= 48) && (ch2 <= 57)) {
                row = ((row * 10) + (ch2 - 48))
                sawRow = true
                i = (i + 1)
            } {
                break
            }
        }
        if sawRow {
            row = (row - 1)
        }
        refRow = row
        refCol = col
    }

    ; Grow every row the file did not size to fit the largest text in it. The
    ; factor is Excel's own: a row is about 1.275 times the point size of its
    ; text, which is exactly how 10pt text yields the familiar 12.75pt row.
    ; Rows only ever grow — a height the file stated is what the author chose,
    ; and clipping is then their decision, not ours.
    fn autoFitRows:void (model:SpreadsheetModel) {
        def i:int 0
        def n:int (array_length rowMinCol)
        ; Unstyled sheet: every content row needs the same height. Do not call
        ; `getCell` millions of times — that dominates native loads of large
        ; workbooks (web profile: setCellRaw + getCell; C++ copies string keys).
        if (sawCellStyle == false) {
            def uniPx:int (CellStyle.rowHeightForPt(model.defaultFontPt))
            while (i < n) {
                if (i >= model.rowCount) {
                    break
                }
                def statedU:boolean false
                if (i < (array_length rowStated)) {
                    statedU = (itemAt rowStated i)
                }
                if (statedU == false) {
                    if ((itemAt rowMinCol i) >= 0) {
                        def haveU:int (model.rowHeight(i))
                        if (uniPx > haveU) {
                            model.setRowHeight(i uniPx)
                        }
                    }
                }
                i = (i + 1)
            }
            return
        }
        while (i < n) {
            if (i >= model.rowCount) {
                break
            }
            def stated:boolean false
            if (i < (array_length rowStated)) {
                stated = (itemAt rowStated i)
            }
            if (stated == false) {
                def pt:double (this.tallestIn(model i))
                if (pt > 0.0) {
                    def px:int (CellStyle.rowHeightForPt(pt))
                    def have:int (model.rowHeight(i))
                    if (px > have) {
                        model.setRowHeight(i px)
                    }
                }
            }
            i = (i + 1)
        }
    }

    ; The formula for a member of shared run `si`, sitting at (row, col).
    ; Returns "" when the run's text has not been seen — Excel writes the
    ; anchor first, but a file that does not gets its cached value rather than
    ; a guess.
    fn sharedAt:string (si:string row:int col:int) {
        if ((has sharedText si) == false) {
            return ""
        }
        def master:string (unwrap (get sharedText si))
        def ar:int (XlsxWorksheet.parseInt0((unwrap (get sharedRow si))))
        def ac:int (XlsxWorksheet.parseInt0((unwrap (get sharedCol si))))
        def dy:int (row - ar)
        def dx:int (col - ac)
        if ((dx == 0) && (dy == 0)) {
            return master
        }
        return (FormulaParser.translateFormula(master dx dy))
    }

    fn parseCell:void (p:XmlLite open:XmlTag model:SpreadsheetModel sst:XlsxSharedStrings fallBackRow:int) {
        def ref:string (open.attr("r"))
        def row:int fallBackRow
        def col:int 0
        if ((strlen ref) > 0) {
            this.parseCellRefFast(ref)
            row = refRow
            col = refCol
        }
        def cellType:string (open.attr("t"))
        def styleAttr:string (open.attr("s"))
        def formula:string ""
        def value:string ""
        def inline:string ""
        def inlineRich@(optional):RichText
        if open.selfClose {
            ; An empty but FORMATTED cell is written self-closing, e.g.
            ; <c r="B3" s="2"/>. Returning here dropped its fill and borders —
            ; which is exactly how a "background colour" row is stored.
            if ((strlen styleAttr) > 0) {
                this.ensureSize(model row col)
                model.setCellStyleId(row col (XlsxWorksheet.parseInt0(styleAttr)))
                sawCellStyle = true
            }
            return
        }
        def depth:int 1
        while ((p.pos < p.len) && (depth > 0)) {
            def t:XmlTag (p.nextTag())
            if (t.valid == false) {
                break
            }
            if (t.name == "c") {
                if t.isEnd {
                    depth = (depth - 1)
                } {
                    if (t.selfClose == false) {
                        depth = (depth + 1)
                    }
                }
            } {
                if ((t.name == "f") && (t.isEnd == false)) {
                    def fkind:string (t.attr("t"))
                    def si:string (t.attr("si"))
                    def body:string ""
                    if (t.selfClose == false) {
                        body = (p.readTextUntilEnd("f"))
                    }
                    if ((strlen body) > 0) {
                        formula = body
                        if (fkind == "shared") {
                            if ((strlen si) > 0) {
                                set sharedText si body
                                set sharedRow si (to_string row)
                                set sharedCol si (to_string col)
                            }
                        }
                    } {
                        ; No text: either a member of a shared run, or a
                        ; formula this reader cannot make sense of. The first
                        ; can be reconstructed; the second keeps its cached
                        ; value, as it did before.
                        if (fkind == "shared") {
                            if ((strlen si) > 0) {
                                formula = (this.sharedAt(si row col))
                            }
                        }
                    }
                }
                if ((t.name == "v") && (t.isEnd == false) && (t.selfClose == false)) {
                    value = (p.readTextUntilEnd("v"))
                }
                if ((t.name == "is") && (t.isEnd == false) && (t.selfClose == false)) {
                    ; An inline string can be written in styled pieces too, so
                    ; it is read the same way a shared one is.
                    inlineRich = (XlsxSharedStrings.parseRuns(p "is"))
                    inline = ((unwrap inlineRich).text())
                }
            }
        }
        this.ensureSize(model row col)
        def display:string ""
        if (cellType == "s") {
            def idx:int (XlsxWorksheet.parseInt0(value))
            display = (sst.at(idx))
            ; Several styles inside one string: keep the pieces, not only what
            ; they spell. Skip the rich-table probe when the SST has none.
            if sst.anyRich {
                def shared:RichText (sst.richAt(idx))
                if (shared.isRich()) {
                    model.setRichText(row col (shared.copy()))
                }
            }
        } {
            if (cellType == "inlineStr") {
                display = inline
                if (!null? inlineRich) {
                    def ir:RichText (unwrap inlineRich)
                    if (ir.isRich()) {
                        model.setRichText(row col ir)
                    }
                }
            } {
                if (cellType == "b") {
                    if ((value == "1") || (value == "true")) {
                        display = "TRUE"
                    } {
                        display = "FALSE"
                    }
                } {
                    if (cellType == "str") {
                        display = value
                    } {
                        display = value
                    }
                }
            }
        }
        model.setCellRaw(row col display)
        if ((strlen formula) > 0) {
            model.setFormula(row col formula)
        }
        if ((strlen styleAttr) > 0) {
            model.setCellStyleId(row col (XlsxWorksheet.parseInt0(styleAttr)))
            sawCellStyle = true
        }
        ; Only a cell with something in it can make a row taller; an empty one
        ; that merely carries a fill should not.
        if ((strlen display) > 0) {
            this.noteRowContent(row col)
        }
    }
}

; ==============================================================================
; XlsxStyles - xl/styles.xml → resolved CellStyle table.
; ==============================================================================
;
; FortuneSheet "Formatting" parity slice: fill, font color/bold, horizontal
; align, number format. Theme colors / indexed palette are approximated.
; ==============================================================================

Import "XmlLite.rgr"
Import "../CellStyle.rgr"

class XlsxStyles {
    def styles:[CellStyle]
    def fontsBold:[boolean]
    def fontsItalic:[boolean]
    def fontsUnderline:[boolean]
    def fontsStrike:[boolean]
    def fontsSize:[double]
    def fontsColor:[string]
    ; One entry per <border> id, four edges each.
    def bTopStyle:[string]
    def bTopRgb:[string]
    def bRightStyle:[string]
    def bRightRgb:[string]
    def bBottomStyle:[string]
    def bBottomRgb:[string]
    def bLeftStyle:[string]
    def bLeftRgb:[string]
    def fillsRgb:[string]
    def fillsHas:[boolean]
    def numFmtMap:[string:string]

    Constructor () {
    }

    fn styleAt:CellStyle (i:int) {
        if (i < 0) {
            return (CellStyle.createDefault())
        }
        if (i >= (array_length styles)) {
            return (CellStyle.createDefault())
        }
        return (itemAt styles i)
    }

    fn count:int () {
        return (array_length styles)
    }

    ; A border with no <color> defaults to black, as Excel does.
    sfn borderColorOr:string (rgb:string) {
        if ((strlen rgb) >= 4) {
            return rgb
        }
        return "#000000"
    }

    sfn builtInNumFmt:string (id:int) {
        if (id == 0) {
            return "General"
        }
        if (id == 1) {
            return "0"
        }
        if (id == 2) {
            return "0.00"
        }
        if (id == 9) {
            return "0%"
        }
        if (id == 10) {
            return "0.00%"
        }
        if (id == 49) {
            return "@"
        }
        if (id == 14) {
            return "mm/dd/yyyy"
        }
        if (id == 15) {
            return "dd.mm.yyyy"
        }
        if (id == 22) {
            return "hh:mm"
        }
        if (id == 164) {
            return "yyyy-mm-dd"
        }
        return "General"
    }

    sfn parseInt0:int (s:string) {
        def parsed@(optional):int (to_int s)
        if parsed {
            return (unwrap parsed)
        }
        return 0
    }

    fn ensureBuiltinNumFmts:void () {
        set numFmtMap "0" "General"
        set numFmtMap "1" "0"
        set numFmtMap "2" "0.00"
        set numFmtMap "9" "0%"
        set numFmtMap "10" "0.00%"
        set numFmtMap "49" "@"
    }

    fn parseColorAttr:string (t:XmlTag) {
        if (t.has("rgb")) {
            def rgb:string (t.attr("rgb"))
            if ((strlen rgb) == 8) {
                return ("#" + (substring rgb 2 8))
            }
            if ((strlen rgb) == 6) {
                return ("#" + rgb)
            }
            return ("#" + rgb)
        }
        return ""
    }

    fn parse:void (xml:string) {
        clear styles
        clear fontsBold
        clear fontsItalic
        clear fontsUnderline
        clear fontsStrike
        clear fontsSize
        clear fontsColor
        clear fillsRgb
        clear fillsHas
        clear bTopStyle
        clear bTopRgb
        clear bRightStyle
        clear bRightRgb
        clear bBottomStyle
        clear bBottomRgb
        clear bLeftStyle
        clear bLeftRgb
        def emptyFmt:[string:string]
        numFmtMap = emptyFmt
        this.ensureBuiltinNumFmts()
        if ((strlen xml) == 0) {
            push styles (CellStyle.createDefault())
            return
        }

        ; Pass 1: numFmts, fonts, fills
        def p:XmlLite (new XmlLite)
        p.reset(xml)
        while (p.pos < p.len) {
            def t:XmlTag (p.nextTag())
            if (t.valid == false) {
                break
            }
            if ((t.name == "numFmt") && (t.isEnd == false)) {
                def id:string (t.attr("numFmtId"))
                def code:string (t.attr("formatCode"))
                if (((strlen id) > 0) && ((strlen code) > 0)) {
                    set numFmtMap id code
                }
            }
            ; `<font/>` — no weight, no size, no colour — is a legal entry and
            ; a common one: it means "the workbook default". Skipping it, as
            ; the self-close guard here used to, did not merely lose one font;
            ; it shifted every font AFTER it down an index, so cells came out
            ; wearing their neighbour's weight and colour. A font element
            ; always takes its place in the list, empty or not.
            if ((t.name == "font") && (t.isEnd == false)) {
                def bold:boolean false
                def italic:boolean false
                def underline:boolean false
                def strike:boolean false
                ; Absent <sz> means the workbook default, which is font 0 —
                ; 10pt Arial in a sheet written by Google, 11pt Calibri in one
                ; written by Excel. Assuming 11 made a 10pt sheet a tenth too
                ; large everywhere the size was left unsaid.
                def sizePt:double 11.0
                if ((array_length fontsSize) > 0) {
                    sizePt = (itemAt fontsSize 0)
                }
                def color:string ""
                def depth:int 1
                if t.selfClose {
                    depth = 0
                }
                while ((p.pos < p.len) && (depth > 0)) {
                    def ft:XmlTag (p.nextTag())
                    if (ft.valid == false) {
                        break
                    }
                    if (ft.name == "font") {
                        if ft.isEnd {
                            depth = (depth - 1)
                        } {
                            if (ft.selfClose == false) {
                                depth = (depth + 1)
                            }
                        }
                    } {
                        if ((ft.name == "b") && (ft.isEnd == false)) {
                            bold = true
                        }
                        if ((ft.name == "i") && (ft.isEnd == false)) {
                            italic = true
                        }
                        if ((ft.name == "u") && (ft.isEnd == false)) {
                            underline = true
                        }
                        if ((ft.name == "strike") && (ft.isEnd == false)) {
                            strike = true
                        }
                        if ((ft.name == "sz") && (ft.isEnd == false)) {
                            def szv:string (ft.attr("val"))
                            if ((strlen szv) > 0) {
                                def szd@(optional):double (to_double szv)
                                if (!null? szd) {
                                    sizePt = (unwrap szd)
                                }
                            }
                        }
                        if ((ft.name == "color") && (ft.isEnd == false)) {
                            color = (this.parseColorAttr(ft))
                        }
                    }
                }
                push fontsBold bold
                push fontsItalic italic
                push fontsUnderline underline
                push fontsStrike strike
                push fontsSize sizePt
                push fontsColor color
            }
            ; <border><left style="thin"><color rgb="FFFF0000"/></left>…</border>
            if ((t.name == "border") && (t.isEnd == false)) {
                def tS:string ""
                def tC:string ""
                def rS:string ""
                def rC:string ""
                def bS:string ""
                def bC:string ""
                def lS:string ""
                def lC:string ""
                if (t.selfClose == false) {
                    def edge:string ""
                    def depthB:int 1
                    while ((p.pos < p.len) && (depthB > 0)) {
                        def bt:XmlTag (p.nextTag())
                        if (bt.valid == false) {
                            break
                        }
                        if (bt.name == "border") {
                            if bt.isEnd {
                                depthB = (depthB - 1)
                            } {
                                if (bt.selfClose == false) {
                                    depthB = (depthB + 1)
                                }
                            }
                        } {
                            def isEdge:boolean false
                            if ((bt.name == "left") || (bt.name == "right")) {
                                isEdge = true
                            }
                            if ((bt.name == "top") || (bt.name == "bottom")) {
                                isEdge = true
                            }
                            if isEdge {
                                if (bt.isEnd == false) {
                                    edge = bt.name
                                    def stv:string (bt.attr("style"))
                                    if (bt.name == "top") {
                                        tS = stv
                                    }
                                    if (bt.name == "right") {
                                        rS = stv
                                    }
                                    if (bt.name == "bottom") {
                                        bS = stv
                                    }
                                    if (bt.name == "left") {
                                        lS = stv
                                    }
                                } {
                                    edge = ""
                                }
                            } {
                                if ((bt.name == "color") && (bt.isEnd == false)) {
                                    def cv:string (this.parseColorAttr(bt))
                                    if (edge == "top") {
                                        tC = cv
                                    }
                                    if (edge == "right") {
                                        rC = cv
                                    }
                                    if (edge == "bottom") {
                                        bC = cv
                                    }
                                    if (edge == "left") {
                                        lC = cv
                                    }
                                }
                            }
                        }
                    }
                }
                push bTopStyle tS
                push bTopRgb tC
                push bRightStyle rS
                push bRightRgb rC
                push bBottomStyle bS
                push bBottomRgb bC
                push bLeftStyle lS
                push bLeftRgb lC
            }
            ; Same reasoning as fonts: an empty <fill/> still holds its index.
            if ((t.name == "fill") && (t.isEnd == false)) {
                def frgb:string ""
                def fhas:boolean false
                def depth2:int 1
                if t.selfClose {
                    depth2 = 0
                }
                while ((p.pos < p.len) && (depth2 > 0)) {
                    def ft2:XmlTag (p.nextTag())
                    if (ft2.valid == false) {
                        break
                    }
                    if (ft2.name == "fill") {
                        if ft2.isEnd {
                            depth2 = (depth2 - 1)
                        } {
                            if (ft2.selfClose == false) {
                                depth2 = (depth2 + 1)
                            }
                        }
                    } {
                        if ((ft2.name == "fgColor") && (ft2.isEnd == false)) {
                            frgb = (this.parseColorAttr(ft2))
                            if ((strlen frgb) > 0) {
                                fhas = true
                            }
                        }
                    }
                }
                push fillsRgb frgb
                push fillsHas fhas
            }
        }

        ; Pass 2: cellXfs / xf only (style index used by cells)
        p.reset(xml)
        def inCellXfs:boolean false
        while (p.pos < p.len) {
            def t2:XmlTag (p.nextTag())
            if (t2.valid == false) {
                break
            }
            if ((t2.name == "cellXfs") && (t2.isEnd == false)) {
                inCellXfs = true
            }
            if ((t2.name == "cellXfs") && t2.isEnd) {
                inCellXfs = false
            }
            if inCellXfs {
                if ((t2.name == "xf") && (t2.isEnd == false)) {
                    def st:CellStyle (new CellStyle)
                    def fontId:int (XlsxStyles.parseInt0((t2.attr("fontId"))))
                    def fillId:int (XlsxStyles.parseInt0((t2.attr("fillId"))))
                    def numId:int (XlsxStyles.parseInt0((t2.attr("numFmtId"))))
                    if ((fontId >= 0) && (fontId < (array_length fontsBold))) {
                        st.bold = (itemAt fontsBold fontId)
                        st.italic = (itemAt fontsItalic fontId)
                        st.underline = (itemAt fontsUnderline fontId)
                        st.strike = (itemAt fontsStrike fontId)
                        st.fontSizePt = (itemAt fontsSize fontId)
                        st.textRgb = (itemAt fontsColor fontId)
                    }
                    def borderId:int (XlsxStyles.parseInt0((t2.attr("borderId"))))
                    if ((borderId >= 0) && (borderId < (array_length bTopStyle))) {
                        st.borderTop.style = (itemAt bTopStyle borderId)
                        st.borderTop.rgb = (XlsxStyles.borderColorOr((itemAt bTopRgb borderId)))
                        st.borderRight.style = (itemAt bRightStyle borderId)
                        st.borderRight.rgb = (XlsxStyles.borderColorOr((itemAt bRightRgb borderId)))
                        st.borderBottom.style = (itemAt bBottomStyle borderId)
                        st.borderBottom.rgb = (XlsxStyles.borderColorOr((itemAt bBottomRgb borderId)))
                        st.borderLeft.style = (itemAt bLeftStyle borderId)
                        st.borderLeft.rgb = (XlsxStyles.borderColorOr((itemAt bLeftRgb borderId)))
                        def any:boolean false
                        if (st.borderTop.has()) {
                            any = true
                        }
                        if (st.borderRight.has()) {
                            any = true
                        }
                        if (st.borderBottom.has()) {
                            any = true
                        }
                        if (st.borderLeft.has()) {
                            any = true
                        }
                        st.hasBorder = any
                    }
                    if ((fillId >= 0) && (fillId < (array_length fillsHas))) {
                        st.hasFill = (itemAt fillsHas fillId)
                        st.fillRgb = (itemAt fillsRgb fillId)
                    }
                    def idKey:string (to_string numId)
                    if (has numFmtMap idKey) {
                        st.numFmt = (unwrap (get numFmtMap idKey))
                    } {
                        st.numFmt = (XlsxStyles.builtInNumFmt(numId))
                    }
                    if (t2.selfClose == false) {
                        def depth3:int 1
                        while ((p.pos < p.len) && (depth3 > 0)) {
                            def at:XmlTag (p.nextTag())
                            if (at.valid == false) {
                                break
                            }
                            if (at.name == "xf") {
                                if at.isEnd {
                                    depth3 = (depth3 - 1)
                                } {
                                    if (at.selfClose == false) {
                                        depth3 = (depth3 + 1)
                                    }
                                }
                            } {
                                if ((at.name == "alignment") && (at.isEnd == false)) {
                                    def h:string (at.attr("horizontal"))
                                    if ((strlen h) > 0) {
                                        st.align = h
                                    }
                                    def vv:string (at.attr("vertical"))
                                    if ((strlen vv) > 0) {
                                        st.valign = vv
                                    }
                                    def wt:string (at.attr("wrapText"))
                                    if ((wt == "1") || (wt == "true")) {
                                        st.wrapText = true
                                    }
                                    def rot:string (at.attr("textRotation"))
                                    if ((strlen rot) > 0) {
                                        st.textRotation = (XlsxStyles.parseInt0(rot))
                                    }
                                }
                            }
                        }
                    }
                    push styles st
                }
            }
        }
        if ((array_length styles) == 0) {
            push styles (CellStyle.createDefault())
        }
    }
}

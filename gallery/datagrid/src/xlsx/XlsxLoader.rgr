; ==============================================================================
; XlsxLoader - book.xlsx → WorkbookModel (sheets → SpreadsheetModel).
; ==============================================================================

Import "XlsxPackage.rgr"
Import "XlsxWorkbook.rgr"
Import "XlsxSharedStrings.rgr"
Import "XlsxWorksheet.rgr"
Import "XlsxDrawing.rgr"
Import "XlsxStyles.rgr"
Import "../WorkbookModel.rgr"
Import "../script/GridScript.rgr"
Import "../CellStyle.rgr"
Import "../FormulaEngine.rgr"

class XlsxLoader {
    def lastError:string ""
    def engine:FormulaEngine (new FormulaEngine)

    Constructor () {
    }

    fn loadPath:boolean (fullPath:string book:WorkbookModel) {
        return (this.loadPathPassword(fullPath book ""))
    }

    fn loadPathPassword:boolean (fullPath:string book:WorkbookModel password:string) {
        lastError = ""
        def pkg:XlsxPackage (new XlsxPackage)
        if ((pkg.openPathPassword(fullPath password)) == false) {
            lastError = pkg.lastError
            if ((strlen lastError) == 0) {
                lastError = ("could not open zip: " + fullPath)
            }
            return false
        }
        def ok:boolean (this.loadPackage(pkg book))
        pkg.close()
        return ok
    }

    ; The same, from bytes. `loadPath` is this with a file read in front of it;
    ; the browser build has no file read and calls straight in here.
    fn loadBytes:boolean (bytes:buffer book:WorkbookModel) {
        return (this.loadBytesPassword(bytes book ""))
    }

    fn loadBytesPassword:boolean (bytes:buffer book:WorkbookModel password:string) {
        lastError = ""
        def pkg:XlsxPackage (new XlsxPackage)
        if ((pkg.openBytesPassword(bytes password)) == false) {
            lastError = pkg.lastError
            if ((strlen lastError) == 0) {
                lastError = "could not open the workbook: not a zip"
            }
            return false
        }
        def ok:boolean (this.loadPackage(pkg book))
        pkg.close()
        return ok
    }

    ; "xl/worksheets/sheet1.xml" → "xl/worksheets/_rels/sheet1.xml.rels".
    sfn relsPathFor:string (partPath:string) {
        def cut:int -1
        def i:int 0
        while (i < (strlen partPath)) {
            if ((charAt partPath i) == 47) {
                cut = i
            }
            i = (i + 1)
        }
        if (cut < 0) {
            return ("_rels/" + partPath + ".rels")
        }
        def dir:string (substring partPath 0 (cut + 1))
        def file:string (substring partPath (cut + 1) (strlen partPath))
        return ((dir + "_rels/") + file + ".rels")
    }

    ; A relationship target is relative to the part that names it. Only the
    ; two forms a spreadsheet actually writes are handled: "../comments1.xml"
    ; and a plain name beside the sheet.
    sfn resolveRelPath:string (partPath:string target:string) {
        if ((strlen target) == 0) {
            return ""
        }
        if ((charAt target 0) == 47) {
            return (substring target 1 (strlen target))
        }
        def cut:int -1
        def i:int 0
        while (i < (strlen partPath)) {
            if ((charAt partPath i) == 47) {
                cut = i
            }
            i = (i + 1)
        }
        def dir:string ""
        if (cut >= 0) {
            dir = (substring partPath 0 (cut + 1))
        }
        def rest:string target
        while ((strlen rest) > 3) {
            if ((substring rest 0 3) == "../") {
                rest = (substring rest 3 (strlen rest))
                ; step one directory up
                def up:int -1
                def k:int 0
                while (k < ((strlen dir) - 1)) {
                    if ((charAt dir k) == 47) {
                        up = k
                    }
                    k = (k + 1)
                }
                if (up >= 0) {
                    dir = (substring dir 0 (up + 1))
                } {
                    dir = ""
                }
            } {
                break
            }
        }
        return (dir + rest)
    }

    fn loadPackage:boolean (pkg:XlsxPackage book:WorkbookModel) {
        book.clear()
        def wb:XlsxWorkbook (new XlsxWorkbook)
        wb.load(pkg)
        if ((wb.sheetCount()) == 0) {
            lastError = "workbook has no sheets"
            return false
        }
        def sst:XlsxSharedStrings (new XlsxSharedStrings)
        if (pkg.hasEntry("xl/sharedStrings.xml")) {
            sst.parse((pkg.entryText("xl/sharedStrings.xml")))
        }
        def sty:XlsxStyles (new XlsxStyles)
        if (pkg.hasEntry("xl/styles.xml")) {
            sty.parse((pkg.entryText("xl/styles.xml")))
        } {
            sty.parse("")
        }
        def parser:XlsxWorksheet (new XlsxWorksheet)
        def firstVisible:int -1
        def i:int 0
        def n:int (wb.sheetCount())
        while (i < n) {
            def info:XlsxSheetInfo (wb.sheetAt(i))
            def sheet:SpreadsheetModel (new SpreadsheetModel)
            sheet.name = info.name
            sheet.sheetHidden = info.hidden
            sheet.quietWrites = true
            def xml:string (pkg.entryText(info.path))
            if ((strlen xml) == 0) {
                lastError = ("missing sheet part: " + info.path)
                return false
            }
            ; A hyperlink's target and a note's text live OUTSIDE the sheet
            ; part: one behind a relationship id, the other in a comments part
            ; the relationships point at. Both are read here and handed to the
            ; parser, so the parser still only walks XML it was given.
            parser.relsXml = (pkg.entryText((XlsxLoader.relsPathFor(info.path))))
            parser.commentsXml = ""
            def commentsRel:string (XlsxWorksheet.relTargetOfType(parser.relsXml "/comments"))
            if ((strlen commentsRel) > 0) {
                parser.commentsXml = (pkg.entryText((XlsxLoader.resolveRelPath(info.path commentsRel))))
            }
            parser.parse(xml sheet sst)
            parser.parseComments(sheet parser.commentsXml)
            ; Pictures are three hops away: the sheet points at a drawing, the
            ; drawing at a relationship, the relationship at the media file.
            def drawingRel:string (XlsxWorksheet.relTargetOfType(parser.relsXml "/drawing"))
            if ((strlen drawingRel) > 0) {
                def drawingPath:string (XlsxLoader.resolveRelPath(info.path drawingRel))
                def drawingXml:string (pkg.entryText(drawingPath))
                if ((strlen drawingXml) > 0) {
                    def drawing:XlsxDrawing (new XlsxDrawing)
                    drawing.parse(drawingXml (pkg.entryText((XlsxLoader.relsPathFor(drawingPath)))))
                    def di:int 0
                    while (di < (array_length drawing.images)) {
                        def pic:SheetImage (itemAt drawing.images di)
                        ; The bytes have to be taken now: the package is closed
                        ; as soon as loading finishes, and a picture decoded on
                        ; first paint would have nothing left to read.
                        pic.bytes = (pkg.entryBytes(pic.src))
                        sheet.addImage(pic)
                        di = (di + 1)
                    }
                }
            }
            sheet.setStylesFrom(sty.styles)
            ; Only now can a row be measured: until the style table is on the
            ; sheet, every cell reports the default size rather than its own.
            parser.autoFitRows(sheet)
            sheet.quietWrites = false
            sheet.version = (sheet.version + 1)
            book.addSheet(sheet)
            if (info.hidden == false) {
                if (firstVisible < 0) {
                    firstVisible = i
                }
            }
            i = (i + 1)
        }
        if (firstVisible < 0) {
            firstVisible = 0
        }
        book.setActive(firstVisible)
        this.loadScripts(pkg book)
        engine.attach(book)
        engine.rebuildAll()
        return true
    }

    ; Scripts ride along in the package under `ranger/`. Nothing here parses
    ; them — the part is read as text and handed to the workbook, so a build
    ; that never opens the script engine still round-trips the script.
    fn loadScripts:void (pkg:XlsxPackage book:WorkbookModel) {
        def names:[string] (pkg.listFiles())
        def i:int 0
        def n:int (array_length names)
        while (i < n) {
            def path:string (itemAt names i)
            if (GridScript.isScriptPart(path)) {
                def src:string (pkg.entryText(path))
                def sc:GridScript (new GridScript)
                sc.name = (GridScript.nameOfPart(path))
                sc.source = src
                sc.part = path
                book.addScript(sc)
            }
            i = (i + 1)
        }
    }
}

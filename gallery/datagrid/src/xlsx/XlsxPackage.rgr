; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; XlsxPackage — what a .xlsx calls its parts, and the one thing a .xlsx has
; that no other OOXML file does.
; ==============================================================================
;
; The container is shared: a .xlsx is an OPC package like a .docx and a .pptx,
; and that layer lives once in `gallery/ooxml/OpcPackage.rgr`. What stays here
; is the two things that are genuinely the spreadsheet's own.
;
; ENCRYPTION. A password-protected workbook is not a ZIP at all — it is an OLE
; compound file with the ZIP inside it — so it has to become a package before
; it can be opened as one. That has its own failure mode ("wrong password")
; that has nothing to do with packaging, so the core never learns what a
; password is: this class decrypts and hands plain ZIP bytes in.
;
; PATHS. Callers open a workbook by full path and expect a `lastError` they can
; show a user, which the container has no opinion about.
;
; Everything else — parts, content types, relationships — is delegated, which
; is also where the spreadsheet GAINS something. It had no relationship layer:
; four callers scanned the `_rels` XML themselves, and the shared path resolver
; said out loud that it handled "only the two forms a spreadsheet actually
; writes". A chart's own relationships write `../../media/image1.png`, which
; was not one of the two.
; ==============================================================================

Import "../../../ooxml/OpcPackage.rgr"
Import "xlsx_office_crypto_ops.rgr"
Import "XlsxOfficeCrypto.rgr"

class XlsxPackage {
    def opc:OpcPackage (new OpcPackage())
    ; The plain ZIP bytes this package was opened from — after decryption, so a
    ; password-protected workbook hands over the same thing an ordinary one
    ; does. A save that preserves the parts nobody modelled has to be able to
    ; read them back after the package is closed, and closing it is what the
    ; loader does the moment it is finished.
    def plainBytes:buffer (buffer_alloc 0)
    def openOk:boolean false
    def pathDir:string "."
    def pathName:string ""
    def lastError:string ""

    Constructor () {
    }

    sfn splitPath:void (fullPath:string dirOut:[string] nameOut:[string]) {
        OpcPackage.splitPath(fullPath dirOut nameOut)
    }

    ; Turn file bytes into a plain ZIP package. Password-protected Office files
    ; arrive as OLE compounds; without a password (or without a decryptor) we
    ; stop here with a clear error instead of hunting for a ZIP EOCD that does
    ; not exist yet.
    fn unwrapBytes:buffer (bytes:buffer password:string) {
        lastError = ""
        if ((XlsxOfficeCrypto.isOleCompound(bytes)) == false) {
            return bytes
        }
        if ((strlen password) == 0) {
            lastError = "password-protected workbook (Office encryption); a password is required"
            return (buffer_alloc 0)
        }
        if ((XlsxOfficeCrypto.canDecrypt()) == false) {
            lastError = "password-protected workbook (Office encryption); decryption is not available on this target"
            return (buffer_alloc 0)
        }
        def plain:buffer (XlsxOfficeCrypto.decrypt(bytes password))
        if ((buffer_length plain) < 22) {
            lastError = "could not decrypt workbook (wrong password, or unsupported encryption)"
            return (buffer_alloc 0)
        }
        return plain
    }

    fn openPath:boolean (fullPath:string) {
        return (this.openPathPassword(fullPath ""))
    }

    fn openPathPassword:boolean (fullPath:string password:string) {
        def dirs:[string]
        def names:[string]
        OpcPackage.splitPath(fullPath dirs names)
        ; Locals (not this.pathDir) — buffer_read_file's ES6 template wraps the
        ; call in an IIFE, so `this` would not be the package instance.
        def dir:string (itemAt dirs 0)
        def name:string (itemAt names 0)
        pathDir = dir
        pathName = name
        def bytes:buffer (buffer_read_file dir name)
        return (this.openBytesPassword(bytes password))
    }

    ; The package from bytes rather than from a path — what a browser has.
    fn openBytes:boolean (bytes:buffer) {
        return (this.openBytesPassword(bytes ""))
    }

    fn openBytesPassword:boolean (bytes:buffer password:string) {
        pathDir = ""
        pathName = "workbook.xlsx"
        def data:buffer (this.unwrapBytes(bytes password))
        if ((strlen lastError) > 0) {
            openOk = false
            return false
        }
        plainBytes = data
        openOk = (opc.openBytes(data pathName))
        if (openOk == false) {
            lastError = "could not open the workbook: not a zip"
        }
        return openOk
    }

    fn close:void () {
        if openOk {
            opc.close()
        }
        openOk = false
    }

    fn listFiles:[string] () {
        return (opc.listParts())
    }

    fn hasEntry:boolean (name:string) {
        return (opc.hasPart(name))
    }

    ; The raw bytes of a part. Text parts go through `entryText`; a PNG does
    ; not survive being decoded as UTF-8, so an image has to come out as bytes.
    fn entryBytes:buffer (name:string) {
        return (opc.readBinary(name))
    }

    fn entryText:string (name:string) {
        return (opc.readXml(name))
    }

    ; ------------------------------------------------------------------
    ; Relationships — new here, and the same ones every other format uses.
    ; ------------------------------------------------------------------

    ; The workbook part named by `_rels/.rels`, rather than assumed to be at
    ; `xl/workbook.xml`.
    fn workbookPart:string () {
        def named:string (opc.mainDocumentPart())
        if ((strlen named) > 0) {
            return named
        }
        return "xl/workbook.xml"
    }

    ; rId on a part → package path. An external target — a hyperlink out to the
    ; web — answers "" here and comes back whole from `relTarget`.
    fn resolveRel:string (part:string relId:string) {
        return (opc.resolveRelationship(part relId))
    }

    fn relTarget:string (part:string relId:string) {
        return (opc.relationshipTarget(part relId))
    }

    fn isExternalRel:boolean (part:string relId:string) {
        return (opc.isExternalRelationship(part relId))
    }

    fn findRelByType:string (part:string typeSuffix:string) {
        return (opc.findRelationshipByType(part typeSuffix))
    }

    fn findRelsByType:[string] (part:string typeSuffix:string) {
        return (opc.findRelationshipsByType(part typeSuffix))
    }

    fn contentTypeFor:string (part:string) {
        return (opc.contentTypeFor(part))
    }

    ; The package underneath, for a caller that needs the container rather than
    ; the workbook's names for things.
    fn opcPackage:OpcPackage () {
        return opc
    }
}

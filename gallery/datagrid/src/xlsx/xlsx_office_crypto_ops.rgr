; ==============================================================================
; xlsx_office_crypto_ops.rgr — unwrap password-protected Office Open XML files.
; ==============================================================================
;
; A modern "Encrypt with Password" workbook is NOT a ZIP. It is an OLE compound
; file (magic D0 CF 11 E0 …) that holds EncryptionInfo + EncryptedPackage. The
; ZIP the rest of the loader expects only appears after Agile decryption.
;
; Node (ES6) uses the vendored office-crypto port of msoffcrypto-tool. Other
; targets return an empty buffer so the caller can report a clear error.
; Call sites use operator form: (xlsx_office_decrypt data password) — no
; parenthesised argument list after the name.
; ==============================================================================

operators {
    xlsx_office_can_decrypt _:boolean (ignored:int) {
        templates {
            es6 ("true")
            cpp ("false")
        }
    }

    xlsx_office_decrypt _:buffer (data:buffer password:string) {
        templates {
            es6 ("(function(data, password){ function asNodeBuffer(buf){ if (typeof Buffer !== 'undefined' && Buffer.isBuffer(buf)) return buf; if (buf instanceof ArrayBuffer) return Buffer.from(buf); if (buf && buf.buffer instanceof ArrayBuffer) return Buffer.from(buf.buffer, buf.byteOffset || 0, buf.byteLength || buf.length || 0); return Buffer.from(buf || []); } function asRangerBuffer(nodeBuf){ var ab = nodeBuf.buffer.slice(nodeBuf.byteOffset, nodeBuf.byteOffset + nodeBuf.byteLength); ab._view = new DataView(ab); return ab; } try { var path = require('path'); var mod = require(path.join(__dirname, '../src/xlsx/vendor/office-crypto.cjs')); var OfficeFile = mod.OfficeFile || (mod.default && mod.default.OfficeFile); if (!OfficeFile) return asRangerBuffer(Buffer.alloc(0)); var file = OfficeFile(asNodeBuffer(data)); file.loadKey({ password: String(password || ''), verifyPassword: true }); var plain = Buffer.from(file.decrypt()); return asRangerBuffer(plain); } catch (e) { return asRangerBuffer(Buffer.alloc(0)); } })(" (e 1) ", " (e 2) ")")
            cpp ("std::vector<uint8_t>()")
        }
    }
}

; ==============================================================================
; XmlLite - tiny OpenXML-oriented XML scanner (not a full DOM).
; ==============================================================================
;
; Enough to walk SpreadsheetML parts: tag names, attributes (incl. r:id), and
; element text. Modeled after gallery/evg/SvgParser's SvgTag/SvgAttr scan, but
; kept independent so DataGrid does not import the SVG IR stack.
; ==============================================================================

class XmlAttr {
    def name:string ""
    def value:string ""

    Constructor () {
    }
}

class XmlTag {
    def name:string ""
    def isEnd:boolean false
    def selfClose:boolean false
    def attrs:[XmlAttr]
    def valid:boolean false
    def startPos:int 0
    def endPos:int 0

    Constructor () {
        def a:[XmlAttr]
        attrs = a
    }

    ; Reset for reuse. Callers must not keep a tag across `nextTag` /
    ; `readTag` — those hand back the same instance.
    fn clearTag:void () {
        name = ""
        isEnd = false
        selfClose = false
        valid = false
        startPos = 0
        endPos = 0
        clear attrs
    }

    fn has:boolean (n:string) {
        def k:int 0
        while (k < (array_length attrs)) {
            def a:XmlAttr (itemAt attrs k)
            if (a.name == n) {
                return true
            }
            k = (k + 1)
        }
        return false
    }

    fn attr:string (n:string) {
        def k:int 0
        while (k < (array_length attrs)) {
            def a:XmlAttr (itemAt attrs k)
            if (a.name == n) {
                return a.value
            }
            k = (k + 1)
        }
        return ""
    }

    ; Prefer local name when prefixed attrs differ (r:id vs id).
    fn attrAny:string (a:string b:string) {
        if (this.has(a)) {
            return (this.attr(a))
        }
        return (this.attr(b))
    }
}

class XmlLite {
    def src:string ""
    def pos:int 0
    def len:int 0
    ; One tag instance for the whole scan. Large sheets create tens of millions
    ; of tags if each `nextTag` allocates; native builds then spend minutes in
    ; the allocator while the JS host finishes in seconds.
    def cur:XmlTag (new XmlTag)
    def attrPool:[XmlAttr]
    def attrPoolN:int 0

    Constructor () {
    }

    fn reset:void (s:string) {
        src = s
        pos = 0
        len = (strlen s)
        attrPoolN = 0
        cur.clearTag()
    }

    fn takeAttr:XmlAttr () {
        if (attrPoolN < (array_length attrPool)) {
            def a:XmlAttr (itemAt attrPool attrPoolN)
            attrPoolN = (attrPoolN + 1)
            a.name = ""
            a.value = ""
            return a
        }
        def fresh:XmlAttr (new XmlAttr)
        push attrPool fresh
        attrPoolN = (attrPoolN + 1)
        return fresh
    }

    ; `&lt;` and friends back into the characters they stand for.
    ;
    ; Everything that is NOT an entity is copied with `substring`, in runs, and
    ; that is the point of the shape below rather than a character at a time.
    ; `(strfromcode (charAt s i))` looks like an identity and is one in
    ; JavaScript, where a string is code units and `charAt` hands one back. In
    ; C++ a string is BYTES: `charAt` gives 0xC3, and `strfromcode` — whose job
    ; is to turn a code POINT into text — dutifully encodes 195 as UTF-8, two
    ; bytes. So every non-ASCII character came out of here encoded twice, and
    ; "Hämeenlinna" was loaded as "HÃ¤meenlinna". `substring` is byte-exact in
    ; both, and copying a run of text is what this loop is doing anyway.
    sfn decodeEntities:string (s:string) {
        def out:string ""
        def n:int (strlen s)
        ; Start of the run that needs no change, and where the scan is.
        def keep:int 0
        def i:int 0
        while (i < n) {
            if ((charAt s i) == 38) {
                def j:int (i + 1)
                while ((j < n) && ((charAt s j) != 59)) {
                    j = (j + 1)
                }
                if (j < n) {
                    def ent:string (substring s (i + 1) j)
                    def rep:string (XmlLite.entityText(ent))
                    if ((strlen rep) > 0) {
                        out = ((out + (substring s keep i)) + rep)
                        i = (j + 1)
                        keep = i
                        continue
                    }
                }
            }
            i = (i + 1)
        }
        return (out + (substring s keep n))
    }

    ; What one entity stands for, or "" when this reader does not know it — in
    ; which case the text is left exactly as the file wrote it, which is the
    ; only honest thing to do with markup nobody here understands.
    sfn entityText:string (ent:string) {
        if (ent == "lt") {
            return "<"
        }
        if (ent == "gt") {
            return ">"
        }
        if (ent == "amp") {
            return "&"
        }
        if (ent == "quot") {
            return "\""
        }
        if (ent == "apos") {
            return "'"
        }
        ; Numeric: &#10; for the line break inside a cell, &#233; for a letter
        ; a writer chose to escape. Here `strfromcode` is doing the job it is
        ; for — a code POINT into text — so it is right in both targets.
        if ((strlen ent) > 1) {
            if ((charAt ent 0) == 35) {
                def cp:int (XmlLite.entityNumber(ent))
                if (cp > 0) {
                    return (strfromcode cp)
                }
            }
        }
        return ""
    }

    ; The number in `#233` or `#xE9`, or 0 if it is not one.
    sfn entityNumber:int (ent:string) {
        def i:int 1
        def base:int 10
        if ((strlen ent) > 2) {
            def c1:int (charAt ent 1)
            if ((c1 == 120) || (c1 == 88)) {
                base = 16
                i = 2
            }
        }
        def value:int 0
        def digits:int 0
        while (i < (strlen ent)) {
            def c:int (charAt ent i)
            def d:int -1
            if ((c >= 48) && (c <= 57)) {
                d = (c - 48)
            }
            if (base == 16) {
                if ((c >= 97) && (c <= 102)) {
                    d = ((c - 97) + 10)
                }
                if ((c >= 65) && (c <= 70)) {
                    d = ((c - 65) + 10)
                }
            }
            if (d < 0) {
                return 0
            }
            value = ((value * base) + d)
            digits = (digits + 1)
            i = (i + 1)
        }
        if (digits == 0) {
            return 0
        }
        if (value > 1114111) {
            return 0
        }
        return value
    }

    fn skipWs:void () {
        while (pos < len) {
            def ch:int (charAt src pos)
            if ((ch == 32) || (ch == 9) || (ch == 10) || (ch == 13)) {
                pos = (pos + 1)
            } {
                return
            }
        }
    }

    fn skipUntil:boolean (c:int) {
        while (pos < len) {
            if ((charAt src pos) == c) {
                return true
            }
            pos = (pos + 1)
        }
        return false
    }

    fn readName:string () {
        def start:int pos
        while (pos < len) {
            def ch:int (charAt src pos)
            ; letter digit _ : - .
            if (((ch >= 65) && (ch <= 90)) || ((ch >= 97) && (ch <= 122)) || ((ch >= 48) && (ch <= 57)) || (ch == 95) || (ch == 58) || (ch == 45) || (ch == 46)) {
                pos = (pos + 1)
            } {
                break
            }
        }
        return (substring src start pos)
    }

    fn localName:string (raw:string) {
        def i:int 0
        def n:int (strlen raw)
        def colon:int -1
        while (i < n) {
            if ((charAt raw i) == 58) {
                colon = i
            }
            i = (i + 1)
        }
        if (colon >= 0) {
            return (substring raw (colon + 1) n)
        }
        return raw
    }

    fn readTag:XmlTag () {
        cur.clearTag()
        attrPoolN = 0
        this.skipWs()
        if (pos >= len) {
            return cur
        }
        if ((charAt src pos) != 60) {
            return cur
        }
        cur.startPos = pos
        pos = (pos + 1)
        if (pos >= len) {
            return cur
        }
        ; comment / PI / doctype — skip
        def peek:int (charAt src pos)
        if ((peek == 33) || (peek == 63)) {
            this.skipUntil(62)
            if (pos < len) {
                pos = (pos + 1)
            }
            return (this.readTag())
        }
        if (peek == 47) {
            cur.isEnd = true
            pos = (pos + 1)
        }
        cur.name = (this.localName((this.readName())))
        this.skipWs()
        while (pos < len) {
            def ch:int (charAt src pos)
            if (ch == 62) {
                pos = (pos + 1)
                cur.endPos = pos
                cur.valid = true
                return cur
            }
            if (ch == 47) {
                pos = (pos + 1)
                this.skipWs()
                if ((pos < len) && ((charAt src pos) == 62)) {
                    pos = (pos + 1)
                    cur.selfClose = true
                    cur.endPos = pos
                    cur.valid = true
                    return cur
                }
            }
            def an:string (this.readName())
            if ((strlen an) == 0) {
                pos = (pos + 1)
            } {
                this.skipWs()
                def av:string ""
                if ((pos < len) && ((charAt src pos) == 61)) {
                    pos = (pos + 1)
                    this.skipWs()
                    if (pos < len) {
                        def q:int (charAt src pos)
                        if ((q == 34) || (q == 39)) {
                            pos = (pos + 1)
                            def vs:int pos
                            while ((pos < len) && ((charAt src pos) != q)) {
                                pos = (pos + 1)
                            }
                            av = (XmlLite.decodeEntities((substring src vs pos)))
                            if (pos < len) {
                                pos = (pos + 1)
                            }
                        }
                    }
                }
                def a:XmlAttr (this.takeAttr())
                a.name = (this.localName(an))
                ; also keep prefixed form for r:id lookups via attrAny
                if (an != a.name) {
                    def a2:XmlAttr (this.takeAttr())
                    a2.name = an
                    a2.value = av
                    push cur.attrs a2
                }
                a.value = av
                push cur.attrs a
                this.skipWs()
            }
        }
        return cur
    }

    ; Advance to next start/end tag; returns invalid at EOF.
    fn nextTag:XmlTag () {
        while (pos < len) {
            if ((charAt src pos) == 60) {
                return (this.readTag())
            }
            pos = (pos + 1)
        }
        cur.clearTag()
        return cur
    }

    ; Text content from current pos until the matching end tag of `name`.
    ; Assumes caller is just after the open tag. Handles simple nesting depth.
    fn readTextUntilEnd:string (name:string) {
        def start:int pos
        def depth:int 1
        while ((pos < len) && (depth > 0)) {
            if ((charAt src pos) != 60) {
                pos = (pos + 1)
            } {
                def save:int pos
                def t:XmlTag (this.readTag())
                if t.valid {
                    if (t.name == name) {
                        if t.isEnd {
                            depth = (depth - 1)
                            if (depth == 0) {
                                def raw:string (substring src start save)
                                return (XmlLite.decodeEntities(raw))
                            }
                        } {
                            if (t.selfClose == false) {
                                depth = (depth + 1)
                            }
                        }
                    }
                } {
                    pos = (save + 1)
                }
            }
        }
        return (XmlLite.decodeEntities((substring src start pos)))
    }

    ; Collect concatenated <t>…</t> text under the current element until endName.
    fn collectTTextUntil:string (endName:string) {
        def out:string ""
        def depth:int 1
        while ((pos < len) && (depth > 0)) {
            def t:XmlTag (this.nextTag())
            if (t.valid == false) {
                break
            }
            if (t.name == endName) {
                if t.isEnd {
                    depth = (depth - 1)
                } {
                    if (t.selfClose == false) {
                        depth = (depth + 1)
                    }
                }
            } {
                if ((t.name == "t") && (t.isEnd == false)) {
                    if t.selfClose {
                        ; empty
                    } {
                        out = (out + (this.readTextUntilEnd("t")))
                    }
                }
            }
        }
        return out
    }
}

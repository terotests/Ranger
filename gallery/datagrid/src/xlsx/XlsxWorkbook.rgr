; ==============================================================================
; XlsxWorkbook - workbook.xml + workbook.xml.rels → sheet name / part paths.
; ==============================================================================

Import "XmlLite.rgr"
Import "XlsxPackage.rgr"

class XlsxSheetInfo {
    def name:string ""
    def rid:string ""
    def path:string ""
    def hidden:boolean false

    Constructor () {
    }
}

class XlsxWorkbook {
    def sheets:[XlsxSheetInfo]
    def rels:[string:string]

    Constructor () {
    }

    fn parseRels:void (xml:string) {
        def empty:[string:string]
        rels = empty
        if ((strlen xml) == 0) {
            return
        }
        def p:XmlLite (new XmlLite)
        p.reset(xml)
        while (p.pos < p.len) {
            def t:XmlTag (p.nextTag())
            if (t.valid == false) {
                break
            }
            if ((t.name == "Relationship") && (t.isEnd == false)) {
                def id:string (t.attr("Id"))
                def target:string (t.attr("Target"))
                if (((strlen id) > 0) && ((strlen target) > 0)) {
                    set rels id target
                }
            }
        }
    }

    fn resolvePath:string (target:string) {
        ; Targets are relative to xl/, or absolute /xl/...
        if ((strlen target) >= 3) {
            if ((substring target 0 3) == "../") {
                return (substring target 3 (strlen target))
            }
        }
        if ((strlen target) >= 1) {
            if ((charAt target 0) == 47) {
                ; absolute part name /xl/worksheets/sheet1.xml → xl/worksheets/...
                return (substring target 1 (strlen target))
            }
        }
        return ("xl/" + target)
    }

    fn parseWorkbook:void (xml:string) {
        clear sheets
        if ((strlen xml) == 0) {
            return
        }
        def p:XmlLite (new XmlLite)
        p.reset(xml)
        while (p.pos < p.len) {
            def t:XmlTag (p.nextTag())
            if (t.valid == false) {
                break
            }
            if ((t.name == "sheet") && (t.isEnd == false)) {
                def info:XlsxSheetInfo (new XlsxSheetInfo)
                info.name = (t.attr("name"))
                info.rid = (t.attrAny("r:id" "id"))
                def st:string (t.attr("state"))
                if (st == "hidden") {
                    info.hidden = true
                }
                if (st == "veryHidden") {
                    info.hidden = true
                }
                if (has rels info.rid) {
                    def target:string (unwrap (get rels info.rid))
                    info.path = (this.resolvePath(target))
                }
                push sheets info
            }
        }
    }

    fn load:void (pkg:XlsxPackage) {
        this.parseRels((pkg.entryText("xl/_rels/workbook.xml.rels")))
        this.parseWorkbook((pkg.entryText("xl/workbook.xml")))
    }

    fn sheetCount:int () {
        return (array_length sheets)
    }

    fn sheetAt:XlsxSheetInfo (i:int) {
        return (itemAt sheets i)
    }
}

; ==============================================================================
; XlsxWorkbook - workbook.xml + workbook.xml.rels → sheet name / part paths.
; ==============================================================================

Import "XmlLite.rgr"
Import "XlsxPackage.rgr"
Import "../../../ooxml/OpcPackage.rgr"

class XlsxSheetInfo {
    def name:string ""
    def rid:string ""
    def path:string ""
    def hidden:boolean false

    Constructor () {
    }
}

class XlsxWorkbook {
    def sheets:[XlsxSheetInfo]
    def rels:[string:string]
    ; The workbook part itself — what sheet targets are resolved against. Read
    ; from the package when it opens rather than assumed.
    def mainPart:string "xl/workbook.xml"

    Constructor () {
    }

    ; The workbook's own relationships: rId → target, exactly as written. The
    ; scan is `OpcPackage`'s, the same one the .docx and .pptx readers use.
    fn parseRels:void (xml:string) {
        def empty:[string:string]
        rels = empty
        if ((strlen xml) == 0) {
            return
        }
        def list:[OpcRelationship] (OpcPackage.parseRelationships(xml))
        def i:int 0
        while (i < (array_length list)) {
            def rel:OpcRelationship (itemAt list i)
            if ((strlen rel.target) > 0) {
                if ((rel.isExternal()) == false) {
                    set rels rel.id rel.target
                }
            }
            i = (i + 1)
        }
    }

    ; A sheet's target is written relative to the WORKBOOK part that names it,
    ; so that is what it is resolved against — rather than against a literal
    ; "xl/" this class used to prepend, which is the same answer only as long
    ; as the workbook is where everyone expects it to be.
    fn resolvePath:string (target:string) {
        return (OpcPackage.joinPartPath(mainPart target))
    }

    fn parseWorkbook:void (xml:string) {
        clear sheets
        if ((strlen xml) == 0) {
            return
        }
        def p:XmlLite (new XmlLite)
        p.reset(xml)
        while (p.pos < p.len) {
            def t:XmlTag (p.nextTag())
            if (t.valid == false) {
                break
            }
            if ((t.name == "sheet") && (t.isEnd == false)) {
                def info:XlsxSheetInfo (new XlsxSheetInfo)
                info.name = (t.attr("name"))
                info.rid = (t.attrAny("r:id" "id"))
                def st:string (t.attr("state"))
                if (st == "hidden") {
                    info.hidden = true
                }
                if (st == "veryHidden") {
                    info.hidden = true
                }
                if (has rels info.rid) {
                    def target:string (unwrap (get rels info.rid))
                    info.path = (this.resolvePath(target))
                }
                push sheets info
            }
        }
    }

    fn load:void (pkg:XlsxPackage) {
        mainPart = (pkg.workbookPart())
        this.parseRels((pkg.entryText((OpcPackage.relsPathFor(mainPart)))))
        this.parseWorkbook((pkg.entryText(mainPart)))
    }

    fn sheetCount:int () {
        return (array_length sheets)
    }

    fn sheetAt:XlsxSheetInfo (i:int) {
        return (itemAt sheets i)
    }
}

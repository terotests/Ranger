; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; XlsxWriter.rgr — a WorkbookModel becomes an .xlsx package.
; ==============================================================================
;
; The loader has always been the whole story: read a workbook, show it, edit it,
; and then have nowhere to put it. This is the other direction, and it is
; deliberately the SAME MODEL both ways — what the loader puts into a
; `SpreadsheetModel` is what this writes back out, so a round trip is a test
; rather than a hope.
;
; Three decisions worth stating.
;
; INLINE STRINGS, NOT A SHARED TABLE. A shared-string table is a size
; optimisation: it pays for itself when the same text repeats, and costs an
; extra part and an extra indirection when it does not. Excel, LibreOffice and
; openpyxl all read `t="inlineStr"` without complaint, and a writer that emits
; it cannot produce the one bug a shared table invites — an index pointing at
; the wrong string.
;
; STYLE INDEX IS THE MODEL'S STYLE INDEX. The model already holds a deduplicated
; `styles` list and stores an index per cell; `cellXfs` is written in exactly
; that order, so `s="7"` on the way out means what `s="7"` meant on the way in.
; The font, fill and border tables are built underneath it, deduplicated by the
; text they generate.
;
; STORED, NOT DEFLATED. `ZipWriter` writes uncompressed entries, which the OPC
; specification allows and every reader accepts. The file is larger; nothing
; else about it differs.
;
; What is NOT written yet, and is therefore not silently lost — it is simply
; absent from the output: cell comments, conditional formatting rules, charts
; and images. Values, formulas, styles, widths, heights, hidden flags, merges,
; freeze panes, hyperlinks and data validations all survive.
; ==============================================================================

Import "../SpreadsheetModel.rgr"
Import "../WorkbookModel.rgr"
Import "../script/GridScript.rgr"
Import "../CellStyle.rgr"
Import "../DataValidation.rgr"
Import "../RichText.rgr"
Import "../../zip/ZipWriter.rgr"
Import "../../../ooxml/OpcPackage.rgr"
Import "../../../pdf_writer/src/core/Utf8.rgr"

class XlsxWriter {
    ; --- save-over ------------------------------------------------------------
    ;
    ; Off by default, and that default is a decision rather than an oversight:
    ; a fresh package is a CLEAN file, and cleaning is sometimes exactly what a
    ; person wants. `writeOver` is the other half — everything the model does
    ; not carry copied through from the package it was read from.
    def overMode:boolean false
    def overPkg:OpcPackage (new OpcPackage())
    ; Parts this save generated, so the copy-through pass knows what NOT to
    ; copy — a part written twice is a package no reader will open.
    def writtenParts:[string:boolean]
    ; The highest relationship id the sheet being written already used in the
    ; source. The writer numbers its own hyperlink and table relationships from
    ; 1; a preserved `<drawing r:id="rId1"/>` names the source's rId1, and two
    ; different things called rId1 is the picture drawn where a table should
    ; be.
    def sheetRelBase:int 0

    def lastError:string ""
    ; Tables are numbered across the WORKBOOK — `xl/tables/table1.xml`,
    ; `table2.xml` — while they are written one sheet at a time, so the part
    ; name, the relationship target and the content-type override all have to
    ; agree about a number the sheet itself does not know. Set once per sheet,
    ; before its parts are written, rather than threaded through four
    ; signatures that have no other use for it.
    def tableBase:int 0
    ; Font / fill / border tables, as the XML fragments they will be written
    ; as. Deduplicating on the fragment is the same thing as deduplicating on
    ; the properties, and it needs no comparison function.
    def fontXml:[string]
    def fillXml:[string]
    def borderXml:[string]
    def fmtCode:[string]
    def fmtId:[int]

    Constructor () {
    }

    ; --- text -----------------------------------------------------------------
    ; UTF-8, encoded here rather than in the zip layer. `ZipWriter.addString`
    ; writes one byte per code unit, which is fine for ASCII and quietly
    ; corrupts everything else — and a spreadsheet full of names is exactly
    ; where "everything else" turns up.
    sfn utf8Length:int (s:string) {
        ; Where a string is already bytes it is already UTF-8, and its length
        ; in bytes is its length. Encoding it a second time would write "ä" as
        ; the four bytes of "Ã¤" into the file.
        if (Utf8.stringIsBytes()) {
            return (strlen s)
        }
        def n:int (strlen s)
        def total:int 0
        def i:int 0
        while (i < n) {
            def c:int (charAt s i)
            if ((c >= 55296) && (c <= 56319)) {
                if ((i + 1) < n) {
                    def lo:int (charAt s (i + 1))
                    if ((lo >= 56320) && (lo <= 57343)) {
                        total = (total + 4)
                        i = (i + 2)
                        continue
                    }
                }
            }
            if (c < 128) {
                total = (total + 1)
            } {
                if (c < 2048) {
                    total = (total + 2)
                } {
                    total = (total + 3)
                }
            }
            i = (i + 1)
        }
        return total
    }

    sfn utf8Buffer:buffer (s:string) {
        if (Utf8.stringIsBytes()) {
            return (buffer_from_string s)
        }
        def size:int (XlsxWriter.utf8Length(s))
        def out:buffer (buffer_alloc size)
        def n:int (strlen s)
        def at:int 0
        def i:int 0
        while (i < n) {
            def c:int (charAt s i)
            def step:int 1
            if ((c >= 55296) && (c <= 56319)) {
                if ((i + 1) < n) {
                    def lo:int (charAt s (i + 1))
                    if ((lo >= 56320) && (lo <= 57343)) {
                        c = ((65536 + ((c - 55296) * 1024)) + (lo - 56320))
                        step = 2
                    }
                }
            }
            if (c < 128) {
                buffer_set out at c
                at = (at + 1)
            } {
                if (c < 2048) {
                    buffer_set out at (192 + (idiv c 64))
                    buffer_set out (at + 1) (128 + (c % 64))
                    at = (at + 2)
                } {
                    if (c < 65536) {
                        buffer_set out at (224 + (idiv c 4096))
                        buffer_set out (at + 1) (128 + ((idiv c 64) % 64))
                        buffer_set out (at + 2) (128 + (c % 64))
                        at = (at + 3)
                    } {
                        buffer_set out at (240 + (idiv c 262144))
                        buffer_set out (at + 1) (128 + ((idiv c 4096) % 64))
                        buffer_set out (at + 2) (128 + ((idiv c 64) % 64))
                        buffer_set out (at + 3) (128 + (c % 64))
                        at = (at + 4)
                    }
                }
            }
            i = (i + step)
        }
        return out
    }

    ; Most cell text has nothing in it that XML minds — a name, a number, a
    ; date — so the loop below copies in RUNS rather than character by
    ; character, and a string with nothing to escape is handed straight back
    ; instead of being rebuilt into an identical copy of itself.
    ;
    ; Copied, not rebuilt: `(strfromcode (charAt s i))` is an identity only
    ; where a string is code units. Where it is bytes, strfromcode encodes
    ; each byte as a character and the file comes out with every accent
    ; doubled — so the untouched stretches move with `substring`.
    sfn esc:string (s:string) {
        def n:int (strlen s)
        def out:string ""
        def run:int 0
        def i:int 0
        while (i < n) {
            def ch:int (charAt s i)
            def rep:string ""
            if (ch == 38) {
                rep = "&amp;"
            } {
                if (ch == 60) {
                    rep = "&lt;"
                } {
                    if (ch == 62) {
                        rep = "&gt;"
                    } {
                        if (ch == 34) {
                            rep = "&quot;"
                        } {
                            if (ch < 32) {
                                if (ch == 10) {
                                    rep = "&#10;"
                                } {
                                    rep = " "
                                }
                            }
                        }
                    }
                }
            }
            if ((strlen rep) > 0) {
                if (i > run) {
                    str_append out (substring s run i)
                }
                str_append out rep
                run = (i + 1)
            }
            i = (i + 1)
        }
        if (run == 0) {
            return s
        }
        if (n > run) {
            str_append out (substring s run n)
        }
        return out
    }

    ; A colour as OOXML writes it: ARGB, eight hex digits. The model keeps CSS
    ; "#rrggbb", which is the same six digits with a different hat on.
    sfn argb:string (css:string) {
        def s:string css
        if ((strlen s) == 0) {
            return ""
        }
        if ((charAt s 0) == 35) {
            s = (substring s 1 (strlen s))
        }
        if ((strlen s) == 8) {
            return s
        }
        if ((strlen s) == 6) {
            return ("FF" + s)
        }
        return ""
    }

    sfn numText:string (v:double) {
        def iv:int (to_int v)
        if ((to_double iv) == v) {
            return (to_string iv)
        }
        return (to_string v)
    }

    ; --- style tables ---------------------------------------------------------
    fn indexOfOrAdd:int (list:[string] item:string) {
        def i:int 0
        while (i < (array_length list)) {
            if ((itemAt list i) == item) {
                return i
            }
            i = (i + 1)
        }
        push list item
        return ((array_length list) - 1)
    }

    fn fontFor:int (st:CellStyle) {
        def x:string "<font>"
        def sz:double st.fontSizePt
        if (sz <= 0.0) {
            sz = 11.0
        }
        str_append x ("<sz val=\"" + (XlsxWriter.numText(sz)) + "\"/>")
        if st.bold {
            str_append x "<b/>"
        }
        if st.italic {
            str_append x "<i/>"
        }
        if st.underline {
            str_append x "<u/>"
        }
        if st.strike {
            str_append x "<strike/>"
        }
        def col:string (XlsxWriter.argb(st.textRgb))
        if ((strlen col) > 0) {
            str_append x ("<color rgb=\"" + col + "\"/>")
        }
        def face:string st.fontName
        if ((strlen face) == 0) {
            face = "Calibri"
        }
        str_append x ("<name val=\"" + face + "\"/></font>")
        return (this.indexOfOrAdd(fontXml x))
    }

    fn fillFor:int (st:CellStyle) {
        if (st.hasFill == false) {
            return 0
        }
        def col:string (XlsxWriter.argb(st.fillRgb))
        if ((strlen col) == 0) {
            return 0
        }
        def x:string ("<fill><patternFill patternType=\"solid\"><fgColor rgb=\"" + col + "\"/><bgColor indexed=\"64\"/></patternFill></fill>")
        return (this.indexOfOrAdd(fillXml x))
    }

    sfn edgeXml:string (name:string b:CellBorder) {
        if ((b.has()) == false) {
            return ("<" + name + "/>")
        }
        def x:string ("<" + name + " style=\"" + b.style + "\">")
        def col:string (XlsxWriter.argb(b.rgb))
        if ((strlen col) > 0) {
            str_append x ("<color rgb=\"" + col + "\"/>")
        }
        return (x + "</" + name + ">")
    }

    fn borderFor:int (st:CellStyle) {
        if (st.hasBorder == false) {
            return 0
        }
        def x:string "<border>"
        str_append x (XlsxWriter.edgeXml("left" st.borderLeft))
        str_append x (XlsxWriter.edgeXml("right" st.borderRight))
        str_append x (XlsxWriter.edgeXml("top" st.borderTop))
        str_append x (XlsxWriter.edgeXml("bottom" st.borderBottom))
        str_append x "<diagonal/></border>"
        return (this.indexOfOrAdd(borderXml x))
    }

    ; Custom number formats start at 164, which is where OOXML says a file's
    ; own codes begin — below that the ids are Excel's built-ins.
    fn numFmtFor:int (st:CellStyle) {
        def code:string st.numFmt
        if ((strlen code) == 0) {
            return 0
        }
        if (code == "General") {
            return 0
        }
        def i:int 0
        while (i < (array_length fmtCode)) {
            if ((itemAt fmtCode i) == code) {
                return (itemAt fmtId i)
            }
            i = (i + 1)
        }
        def id:int (164 + (array_length fmtCode))
        push fmtCode code
        push fmtId id
        return id
    }

    fn stylesXml:string (styles:[CellStyle]) {
        clear fontXml
        clear fillXml
        clear borderXml
        clear fmtCode
        clear fmtId
        ; Fill 0 and fill 1 are reserved: every file has to declare `none` and
        ; `gray125` first, whether or not it uses them.
        push fillXml "<fill><patternFill patternType=\"none\"/></fill>"
        push fillXml "<fill><patternFill patternType=\"gray125\"/></fill>"
        push borderXml "<border><left/><right/><top/><bottom/><diagonal/></border>"

        def xfs:[string]
        ; xf 0 is the Normal style. A cell with no style of its own writes no
        ; `s` attribute at all and lands here; the model's own style indexes
        ; are therefore written one higher, which is also what keeps index 0
        ; from meaning two different things.
        push xfs "<xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\"/>"
        this.fontFor((CellStyle.createDefault()))
        def i:int 0
        while (i < (array_length styles)) {
            def st:CellStyle (itemAt styles i)
            def fid:int (this.fontFor(st))
            def flid:int (this.fillFor(st))
            def bid:int (this.borderFor(st))
            def nid:int (this.numFmtFor(st))
            def xf:string ("<xf numFmtId=\"" + (to_string nid) + "\" fontId=\"" + (to_string fid) + "\" fillId=\"" + (to_string flid) + "\" borderId=\"" + (to_string bid) + "\" xfId=\"0\" applyFont=\"1\" applyFill=\"1\" applyBorder=\"1\" applyNumberFormat=\"1\"")
            def align:string ""
            if (st.align != "left") {
                str_append align (" horizontal=\"" + st.align + "\"")
            }
            if (st.valign != "bottom") {
                str_append align (" vertical=\"" + st.valign + "\"")
            }
            if st.wrapText {
                str_append align " wrapText=\"1\""
            }
            if (st.textRotation != 0) {
                str_append align (" textRotation=\"" + (to_string st.textRotation) + "\"")
            }
            ; Written back out, because it was read in. A property a reader
            ; understands and a writer drops is worse than one neither knows
            ; about: the file changes meaning every time it is saved, and the
            ; author who set the direction sees it quietly undone.
            if (st.readingOrder != 0) {
                str_append align (" readingOrder=\"" + (to_string st.readingOrder) + "\"")
            }
            if ((strlen align) > 0) {
                str_append xf (" applyAlignment=\"1\"><alignment" + align + "/></xf>")
            } {
                str_append xf "/>"
            }
            push xfs xf
            i = (i + 1)
        }
        def out:string "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
        str_append out "<styleSheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\">"
        if ((array_length fmtCode) > 0) {
            str_append out ("<numFmts count=\"" + (to_string (array_length fmtCode)) + "\">")
            def f:int 0
            while (f < (array_length fmtCode)) {
                str_append out ("<numFmt numFmtId=\"" + (to_string (itemAt fmtId f)) + "\" formatCode=\"" + (XlsxWriter.esc((itemAt fmtCode f))) + "\"/>")
                f = (f + 1)
            }
            str_append out "</numFmts>"
        }
        str_append out ("<fonts count=\"" + (to_string (array_length fontXml)) + "\">")
        def a:int 0
        while (a < (array_length fontXml)) {
            str_append out (itemAt fontXml a)
            a = (a + 1)
        }
        str_append out ("</fonts><fills count=\"" + (to_string (array_length fillXml)) + "\">")
        def b:int 0
        while (b < (array_length fillXml)) {
            str_append out (itemAt fillXml b)
            b = (b + 1)
        }
        str_append out ("</fills><borders count=\"" + (to_string (array_length borderXml)) + "\">")
        def c:int 0
        while (c < (array_length borderXml)) {
            str_append out (itemAt borderXml c)
            c = (c + 1)
        }
        str_append out "</borders>"
        str_append out "<cellStyleXfs count=\"1\"><xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\"/></cellStyleXfs>"
        str_append out ("<cellXfs count=\"" + (to_string (array_length xfs)) + "\">")
        def d:int 0
        while (d < (array_length xfs)) {
            str_append out (itemAt xfs d)
            d = (d + 1)
        }
        str_append out "</cellXfs>"
        str_append out "<cellStyles count=\"1\"><cellStyle name=\"Normal\" xfId=\"0\" builtinId=\"0\"/></cellStyles>"
        str_append out "</styleSheet>"
        return out
    }

    ; One <r> per run, with only the properties the run actually overrides —
    ; an empty <rPr> is legal and pointless, so it is left out.
    sfn runsXml:string (rt:RichText) {
        def out:string ""
        def i:int 0
        while (i < (rt.count())) {
            def run:CellRun (itemAt rt.runs i)
            def props:string ""
            ; A run that says it is NOT bold has to say so. Writing nothing
            ; lets the cell's own weight back in on the next open, which is
            ; the same conflation on the way out.
            if run.boldSet {
                if run.bold {
                    str_append props "<b/>"
                } {
                    str_append props "<b val=\"0\"/>"
                }
            }
            if run.italicSet {
                if run.italic {
                    str_append props "<i/>"
                } {
                    str_append props "<i val=\"0\"/>"
                }
            }
            if run.underlineSet {
                if run.underline {
                    str_append props "<u/>"
                } {
                    str_append props "<u val=\"none\"/>"
                }
            }
            if run.strikeSet {
                if run.strike {
                    str_append props "<strike/>"
                } {
                    str_append props "<strike val=\"0\"/>"
                }
            }
            if (run.sizePt > 0.0) {
                str_append props ("<sz val=\"" + (XlsxWriter.numText(run.sizePt)) + "\"/>")
            }
            def col:string (XlsxWriter.argb(run.rgb))
            if ((strlen col) > 0) {
                str_append props ("<color rgb=\"" + col + "\"/>")
            }
            str_append out "<r>"
            if ((strlen props) > 0) {
                str_append out ("<rPr>" + props + "</rPr>")
            }
            str_append out ("<t xml:space=\"preserve\">" + (XlsxWriter.esc(run.text)) + "</t></r>")
            i = (i + 1)
        }
        return out
    }

    ; --- a sheet --------------------------------------------------------------
    sfn cellRef:string (row:int col:int) {
        return ((SpreadsheetModel.colLabel(col)) + (to_string (row + 1)))
    }

    ; Pixels back to Excel's character units — the inverse of what the loader
    ; does, so a width that came from a file goes back out as itself.
    sfn pxToColWidth:double (px:int) {
        return (((to_double px) - 5.0) / 7.0)
    }

    sfn pxToRowPoints:double (px:int) {
        return (((to_double px) * 72.0) / 96.0)
    }

    ; --- preserved worksheet children ----------------------------------------
    ;
    ; SpreadsheetML fixes the order of a worksheet's children, and Excel
    ; refuses a file that gets it wrong — so a preserved element cannot simply
    ; be appended. Each one belongs to one of five points relative to what this
    ; writer emits itself, and within a point they keep the order the source
    ; file had them in, which was already valid.
    ;
    ;   0  before <dimension>                     sheetPr
    ;   1  after </sheetData>, before autoFilter  sheetCalcPr, sheetProtection,
    ;                                             protectedRanges, scenarios
    ;   2  after mergeCells, before dataValidations
    ;                                             phoneticPr, conditionalFormatting
    ;   3  after hyperlinks, before tableParts    printOptions … controls
    ;   4  after tableParts                       extLst
    sfn opaqueSlot:int (name:string) {
        if (name == "sheetPr") {
            return 0
        }
        if (name == "sheetCalcPr") {
            return 1
        }
        if (name == "sheetProtection") {
            return 1
        }
        if (name == "protectedRanges") {
            return 1
        }
        if (name == "scenarios") {
            return 1
        }
        if (name == "phoneticPr") {
            return 2
        }
        if (name == "conditionalFormatting") {
            return 2
        }
        if (name == "extLst") {
            return 4
        }
        return 3
    }

    ; Everything preserved for one slot, in source order. Empty in clean mode:
    ; a fresh package is meant to be fresh.
    fn opaqueXml:string (m:SpreadsheetModel slot:int) {
        if (overMode == false) {
            return ""
        }
        def out:string ""
        def i:int 0
        while (i < (array_length m.opaque)) {
            def o:SheetOpaque (itemAt m.opaque i)
            if ((XlsxWriter.opaqueSlot(o.name)) == slot) {
                str_append out o.source
            }
            i = (i + 1)
        }
        return out
    }

    fn sheetXml:string (m:SpreadsheetModel) {
        def lastR:int (m.usedRow())
        def lastC:int (m.usedCol())
        def out:string "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
        str_append out "<worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
        str_append out (this.opaqueXml(m 0))
        str_append out ("<dimension ref=\"A1:" + (XlsxWriter.cellRef(lastR lastC)) + "\"/>")
        ; The sheet's own defaults. Everything below states only what DIFFERS
        ; from them — a file that repeated the default for every row and column
        ; would be correct and enormous — so leaving them unsaid means a
        ; reader falls back on its own idea of a row, and the sheet comes back
        ; a different shape than it went out.
        def defH:double (XlsxWriter.pxToRowPoints(m.defaultRowH))
        def defW:double (XlsxWriter.pxToColWidth(m.defaultColW))
        str_append out ("<sheetFormatPr defaultRowHeight=\"" + (XlsxWriter.numText(defH)) + "\" defaultColWidth=\"" + (XlsxWriter.numText(defW)) + "\"/>")

        ; Freeze panes, as a pane element on the sheet view.
        str_append out "<sheetViews><sheetView workbookViewId=\"0\">"
        if ((m.freezeRows + m.freezeCols) > 0) {
            def topLeft:string (XlsxWriter.cellRef(m.freezeRows m.freezeCols))
            str_append out "<pane"
            if (m.freezeCols > 0) {
                str_append out (" xSplit=\"" + (to_string m.freezeCols) + "\"")
            }
            if (m.freezeRows > 0) {
                str_append out (" ySplit=\"" + (to_string m.freezeRows) + "\"")
            }
            str_append out (" topLeftCell=\"" + topLeft + "\" activePane=\"bottomRight\" state=\"frozen\"/>")
        }
        str_append out "</sheetView></sheetViews>"

        ; Column widths and hidden flags, one <col> per column that differs
        ; from the default — a file that repeated the default for every column
        ; would be correct and enormous.
        def cols:string ""
        def lastGeomC:int (m.colCount - 1)
        def c:int 0
        while (c <= lastGeomC) {
            def w:int (m.colWidth(c))
            def hidden:boolean (m.isColHidden(c))
            if ((w != m.defaultColW) || hidden) {
                str_append cols ("<col min=\"" + (to_string (c + 1)) + "\" max=\"" + (to_string (c + 1)) + "\" width=\"" + (XlsxWriter.numText((XlsxWriter.pxToColWidth(w)))) + "\" customWidth=\"1\"")
                if hidden {
                    str_append cols " hidden=\"1\""
                }
                str_append cols "/>"
            }
            c = (c + 1)
        }
        if ((strlen cols) > 0) {
            str_append out ("<cols>" + cols + "</cols>")
        }

        str_append out "<sheetData>"
        ; Rows are walked past the used range too: a hidden row or a custom
        ; height below the last value is still part of the sheet.
        def lastGeomR:int (m.rowCount - 1)
        if (lastGeomR < lastR) {
            lastGeomR = lastR
        }
        def r:int 0
        while (r <= lastGeomR) {
            def cells:string ""
            def cc:int 0
            while (cc <= lastC) {
                def raw:string (m.getCell(r cc))
                def formula:string (m.getFormula(r cc))
                ; -1 means the cell has no style of its own, which is not the
                ; same as having style 0.
                def sid:int (m.getCellStyleId(r cc))
                def any:boolean false
                if ((strlen raw) > 0) {
                    any = true
                }
                if ((strlen formula) > 0) {
                    any = true
                }
                if (sid >= 0) {
                    any = true
                }
                if any {
                    def ref:string (XlsxWriter.cellRef(r cc))
                    def tag:string ("<c r=\"" + ref + "\"")
                    if (sid >= 0) {
                        str_append tag (" s=\"" + (to_string (sid + 1)) + "\"")
                    }
                    def numeric:boolean (XlsxNumberFormat.wholeNumber(raw))
                    if ((strlen formula) > 0) {
                        ; A formula cell carries the expression and the cached
                        ; value, which is what lets a reader show something
                        ; before it has an engine.
                        if (numeric == false) {
                            str_append tag " t=\"str\""
                        }
                        str_append tag ("><f>" + (XlsxWriter.esc(formula)) + "</f>")
                        if ((strlen raw) > 0) {
                            str_append tag ("<v>" + (XlsxWriter.esc(raw)) + "</v>")
                        }
                        str_append tag "</c>"
                    } {
                        if ((strlen raw) == 0) {
                            str_append tag "/>"
                        } {
                            if numeric {
                                str_append tag ("><v>" + raw + "</v></c>")
                            } {
                                ; Text drawn in pieces goes out in pieces. An
                                ; inline string can hold runs just as a shared
                                ; one can, so nothing extra has to be written
                                ; to another part of the package.
                                if (m.hasRichText(r cc)) {
                                    str_append tag (" t=\"inlineStr\"><is>" + (XlsxWriter.runsXml((m.richTextAt(r cc)))) + "</is></c>")
                                } {
                                    str_append tag (" t=\"inlineStr\"><is><t xml:space=\"preserve\">" + (XlsxWriter.esc(raw)) + "</t></is></c>")
                                }
                            }
                        }
                    }
                    str_append cells tag
                }
                cc = (cc + 1)
            }
            def rowAttrs:string ""
            def h:int (m.rowHeight(r))
            if (h != m.defaultRowH) {
                str_append rowAttrs (" ht=\"" + (XlsxWriter.numText((XlsxWriter.pxToRowPoints(h)))) + "\" customHeight=\"1\"")
            }
            if (m.isRowHidden(r)) {
                str_append rowAttrs " hidden=\"1\""
            }
            if ((strlen cells) > 0) {
                str_append out ("<row r=\"" + (to_string (r + 1)) + "\"" + rowAttrs + ">" + cells + "</row>")
            } {
                if ((strlen rowAttrs) > 0) {
                    str_append out ("<row r=\"" + (to_string (r + 1)) + "\"" + rowAttrs + "/>")
                }
            }
            r = (r + 1)
        }
        str_append out "</sheetData>"
        str_append out (this.opaqueXml(m 1))

        if ((array_length m.merges) > 0) {
            str_append out ("<mergeCells count=\"" + (to_string (array_length m.merges)) + "\">")
            def mi:int 0
            while (mi < (array_length m.merges)) {
                def parts:[string] (strsplit (itemAt m.merges mi) ",")
                if ((array_length parts) >= 4) {
                    def mr1:int (SpreadsheetModel.parseInt0((itemAt parts 0)))
                    def mc1:int (SpreadsheetModel.parseInt0((itemAt parts 1)))
                    def mr2:int (SpreadsheetModel.parseInt0((itemAt parts 2)))
                    def mc2:int (SpreadsheetModel.parseInt0((itemAt parts 3)))
                    str_append out ("<mergeCell ref=\"" + (XlsxWriter.cellRef(mr1 mc1)) + ":" + (XlsxWriter.cellRef(mr2 mc2)) + "\"/>")
                }
                mi = (mi + 1)
            }
            str_append out "</mergeCells>"
        }
        str_append out (this.opaqueXml(m 2))

        ; Validations come before hyperlinks in the schema's order, and a
        ; reader that checks the order will reject them the other way round.
        if ((m.validationCount()) > 0) {
            str_append out ("<dataValidations count=\"" + (to_string (m.validationCount())) + "\">")
            def vi:int 0
            while (vi < (array_length m.validations)) {
                def v:DataValidation (itemAt m.validations vi)
                str_append out ("<dataValidation type=\"" + v.kind + "\" operator=\"" + v.op + "\"")
                if v.allowBlank {
                    str_append out " allowBlank=\"1\""
                }
                if ((strlen v.errorTitle) > 0) {
                    str_append out (" errorTitle=\"" + (XlsxWriter.esc(v.errorTitle)) + "\"")
                }
                if ((strlen v.errorText) > 0) {
                    str_append out (" error=\"" + (XlsxWriter.esc(v.errorText)) + "\" showErrorMessage=\"1\"")
                }
                str_append out (" sqref=\"" + (XlsxWriter.cellRef(v.r0 v.c0)) + ":" + (XlsxWriter.cellRef(v.r1 v.c1)) + "\">")
                if ((strlen v.f1) > 0) {
                    str_append out ("<formula1>" + (XlsxWriter.esc(v.f1)) + "</formula1>")
                }
                if ((strlen v.f2) > 0) {
                    str_append out ("<formula2>" + (XlsxWriter.esc(v.f2)) + "</formula2>")
                }
                str_append out "</dataValidation>"
                vi = (vi + 1)
            }
            str_append out "</dataValidations>"
        }

        def links:string (this.hyperlinksXml(m))
        if ((strlen links) > 0) {
            str_append out links
        }
        str_append out (this.opaqueXml(m 3))
        ; Tables, last: a `<tableParts>` element points at the table PARTS by
        ; relationship, and the relationships are numbered after the sheet's
        ; hyperlinks, which is why the count of those is asked for here.
        if ((m.tableCount()) > 0) {
            str_append out ("<tableParts count=\"" + (to_string (m.tableCount())) + "\">")
            def relBase:int (XlsxWriter.hyperlinkRelCount(m))
            def ti:int 0
            while (ti < (m.tableCount())) {
                str_append out ("<tablePart r:id=\"rId" + (to_string ((relBase + ti) + 1)) + "\"/>")
                ti = (ti + 1)
            }
            str_append out "</tableParts>"
        }
        str_append out (this.opaqueXml(m 4))
        str_append out "</worksheet>"
        return out
    }

    ; External targets go through the sheet's relationship part; a target that
    ; starts with "#" names a place in this workbook and needs no relationship
    ; at all.
    fn hyperlinksXml:string (m:SpreadsheetModel) {
        def out:string ""
        def rid:int 0
        def i:int 0
        while (i < (array_length m.linkKeys)) {
            def key:string (itemAt m.linkKeys i)
            def target:string ""
            if (has m.links key) {
                target = (unwrap (get m.links key))
            }
            if ((strlen target) > 0) {
                def parts:[string] (strsplit key ",")
                if ((array_length parts) >= 2) {
                    def lr:int (SpreadsheetModel.parseInt0((itemAt parts 0)))
                    def lc:int (SpreadsheetModel.parseInt0((itemAt parts 1)))
                    def ref:string (XlsxWriter.cellRef(lr lc))
                    if ((charAt target 0) == 35) {
                        str_append out ("<hyperlink ref=\"" + ref + "\" location=\"" + (XlsxWriter.esc((substring target 1 (strlen target)))) + "\"/>")
                    } {
                        rid = (rid + 1)
                        str_append out ("<hyperlink ref=\"" + ref + "\" r:id=\"rId" + (to_string rid) + "\"/>")
                    }
                }
            }
            i = (i + 1)
        }
        if ((strlen out) == 0) {
            return ""
        }
        return ("<hyperlinks>" + out + "</hyperlinks>")
    }

    fn sheetRelsXml:string (m:SpreadsheetModel) {
        def body:string ""
        def rid:int 0
        def i:int 0
        while (i < (array_length m.linkKeys)) {
            def key:string (itemAt m.linkKeys i)
            def target:string ""
            if (has m.links key) {
                target = (unwrap (get m.links key))
            }
            if ((strlen target) > 0) {
                if ((charAt target 0) != 35) {
                    rid = (rid + 1)
                    str_append body ("<Relationship Id=\"rId" + (to_string rid) + "\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/hyperlink\" Target=\"" + (XlsxWriter.esc(target)) + "\" TargetMode=\"External\"/>")
                }
            }
            i = (i + 1)
        }
        ; Tables continue the SAME numbering the hyperlinks started: a sheet's
        ; relationships are one list, and `<tablePart r:id="rId3"/>` has to
        ; name the third of them and not the third table.
        def ti:int 0
        while (ti < (m.tableCount())) {
            rid = (rid + 1)
            def num:int ((tableBase + ti) + 1)
            str_append body ("<Relationship Id=\"rId" + (to_string rid) + "\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/table\" Target=\"../tables/table" + (to_string num) + ".xml\"/>")
            ti = (ti + 1)
        }
        if ((strlen body) == 0) {
            return ""
        }
        return ("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">" + body + "</Relationships>")
    }

    ; How many relationships a sheet uses before its tables — which is how
    ; many external hyperlinks it has, since those are written first.
    sfn hyperlinkRelCount:int (m:SpreadsheetModel) {
        def n:int 0
        def i:int 0
        while (i < (array_length m.linkKeys)) {
            def key:string (itemAt m.linkKeys i)
            def target:string ""
            if (has m.links key) {
                target = (unwrap (get m.links key))
            }
            if ((strlen target) > 0) {
                if ((charAt target 0) != 35) {
                    n = (n + 1)
                }
            }
            i = (i + 1)
        }
        return n
    }

    ; One table part. The style is left out on purpose: a table carries a
    ; theme name here that we do not draw, and writing a style we do not honour
    ; would promise Excel a look this program never showed anyone.
    sfn tableXml:string (t:SheetTable num:int) {
        def ref:string ((XlsxWriter.cellRef(t.r0 t.c0)) + ":" + (XlsxWriter.cellRef(t.r1 t.c1)))
        def out:string "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
        str_append out ("<table xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" id=\"" + (to_string num) + "\"")
        str_append out (" name=\"" + (XlsxWriter.esc(t.name)) + "\" displayName=\"" + (XlsxWriter.esc(t.name)) + "\"")
        str_append out (" ref=\"" + ref + "\" headerRowCount=\"" + (to_string t.headerRowCount) + "\"")
        if (t.totalsRowCount > 0) {
            str_append out (" totalsRowCount=\"" + (to_string t.totalsRowCount) + "\"")
        }
        str_append out ">"
        ; The autoFilter a table carries covers its header and data, never its
        ; totals row.
        if (t.headerRowCount > 0) {
            def lastData:int (t.dataR1())
            if (lastData < t.r0) {
                lastData = t.r0
            }
            str_append out ("<autoFilter ref=\"" + (XlsxWriter.cellRef(t.r0 t.c0)) + ":" + (XlsxWriter.cellRef(lastData t.c1)) + "\"/>")
        }
        def cols:int (t.columnCount())
        str_append out ("<tableColumns count=\"" + (to_string cols) + "\">")
        def i:int 0
        while (i < cols) {
            def nm:string (t.columnAt(i))
            if ((strlen nm) == 0) {
                ; A column has to be called something or Excel refuses the
                ; file; "Column1" is what Excel itself names an unnamed one.
                nm = ("Column" + (to_string (i + 1)))
            }
            str_append out ("<tableColumn id=\"" + (to_string (i + 1)) + "\" name=\"" + (XlsxWriter.esc(nm)) + "\"/>")
            i = (i + 1)
        }
        str_append out "</tableColumns></table>"
        return out
    }

    ; --- package --------------------------------------------------------------
    fn contentTypesXml:string (book:WorkbookModel) {
        def out:string "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
        str_append out "<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">"
        str_append out "<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>"
        str_append out "<Default Extension=\"xml\" ContentType=\"application/xml\"/>"
        str_append out "<Override PartName=\"/xl/workbook.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\"/>"
        def i:int 0
        while (i < (book.sheetCount())) {
            str_append out ("<Override PartName=\"/xl/worksheets/sheet" + (to_string (i + 1)) + ".xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\"/>")
            i = (i + 1)
        }
        str_append out "<Override PartName=\"/xl/styles.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml\"/>"
        ; A table part needs its own override — the `xml` default above names
        ; it plain XML, and a reader that believes that finds no table.
        def tn:int 0
        def ti:int 0
        while (ti < (book.sheetCount())) {
            def sh:SpreadsheetModel (book.sheetAt(ti))
            tn = (tn + (sh.tableCount()))
            ti = (ti + 1)
        }
        def t:int 0
        while (t < tn) {
            str_append out ("<Override PartName=\"/xl/tables/table" + (to_string (t + 1)) + ".xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.table+xml\"/>")
            t = (t + 1)
        }
        ; A part whose extension has no content type makes the package invalid,
        ; so the script extensions are declared — and only when a script is
        ; actually there, so an ordinary workbook comes out byte-identical to
        ; what it was before scripts existed.
        def si:int 0
        def sn:int (book.scriptCount())
        def sawTsx:boolean false
        def sawJs:boolean false
        while (si < sn) {
            def sc:GridScript (book.scriptAt(si))
            def ext:string (GridScript.extensionOfPart(sc.part))
            if (ext == ".js") {
                sawJs = true
            } {
                sawTsx = true
            }
            si = (si + 1)
        }
        if sawTsx {
            str_append out "<Default Extension=\"tsx\" ContentType=\"text/plain\"/>"
        }
        if sawJs {
            str_append out "<Default Extension=\"js\" ContentType=\"text/plain\"/>"
        }
        str_append out "</Types>"
        return out
    }

    fn workbookXml:string (book:WorkbookModel) {
        def out:string "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
        str_append out "<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\"><sheets>"
        def i:int 0
        while (i < (book.sheetCount())) {
            def sh:SpreadsheetModel (book.sheetAt(i))
            def nm:string sh.name
            if ((strlen nm) == 0) {
                nm = ("Sheet" + (to_string (i + 1)))
            }
            str_append out ("<sheet name=\"" + (XlsxWriter.esc(nm)) + "\" sheetId=\"" + (to_string (i + 1)) + "\" r:id=\"rId" + (to_string (i + 1)) + "\"")
            if sh.sheetHidden {
                str_append out " state=\"hidden\""
            }
            str_append out "/>"
            i = (i + 1)
        }
        str_append out "</sheets></workbook>"
        return out
    }

    fn workbookRelsXml:string (book:WorkbookModel) {
        def out:string "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
        str_append out "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">"
        def i:int 0
        while (i < (book.sheetCount())) {
            str_append out ("<Relationship Id=\"rId" + (to_string (i + 1)) + "\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"worksheets/sheet" + (to_string (i + 1)) + ".xml\"/>")
            i = (i + 1)
        }
        def styleId:int ((book.sheetCount()) + 1)
        str_append out ("<Relationship Id=\"rId" + (to_string styleId) + "\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles\" Target=\"styles.xml\"/>")
        str_append out "</Relationships>"
        return out
    }


    ; --- writing over the package the workbook came from -----------------------
    ;
    ; The clean write above is a good default and a bad only option. A
    ; spreadsheet carries a great deal this model has never heard of — pivot
    ; tables, macros, comments, the drawings that hold the pictures, the
    ; document properties, the theme — and building a fresh package silently
    ; deletes all of it. Measured on this repository's own fixtures, a plain
    ; save dropped the drawings and both media parts from `images.xlsx`, the
    ; comments part from `annotations.xlsx`, and `docProps` and the theme from
    ; every workbook that had them.
    ;
    ; So: generate what the model owns, copy through everything else, and merge
    ; the three places that name parts — the content types, the package
    ; relationships and the workbook relationships. `SheetOpaque` covers the
    ; fourth: the worksheet's own references to what was copied.
    fn packOver:boolean (book:WorkbookModel pkg:OpcPackage z:ZipWriter) {
        lastError = ""
        if ((book.sheetCount()) == 0) {
            lastError = "workbook has no sheets"
            return false
        }
        overMode = true
        overPkg = pkg
        def fresh:[string:boolean]
        writtenParts = fresh

        ; --- the parts the model owns
        def first:SpreadsheetModel (book.sheetAt(0))
        this.addOver(z "xl/workbook.xml" (this.workbookXml(book)))
        this.addOver(z "xl/styles.xml" (this.stylesXml(first.styles)))
        def i:int 0
        def tableSeen:int 0
        while (i < (book.sheetCount())) {
            def sh:SpreadsheetModel (book.sheetAt(i))
            def path:string (XlsxWriter.sheetPartOf(sh i))
            tableBase = tableSeen
            ; What the source already numbered, so this writer's own hyperlink
            ; and table relationships start above it.
            def relsPath:string (OpcPackage.relsPathFor(path))
            def srcRels:string ""
            if (pkg.hasPart(relsPath)) {
                srcRels = (pkg.readXml(relsPath))
            }
            sheetRelBase = (XlsxWriter.highestRelId(srcRels))
            this.addOver(z path (this.sheetXml(sh)))
            def merged:string (this.mergedSheetRels(sh srcRels))
            if ((strlen merged) > 0) {
                this.addOver(z relsPath merged)
            }
            def ti:int 0
            while (ti < (sh.tableCount())) {
                def t:SheetTable (sh.tableAt(ti))
                def num:int ((tableSeen + ti) + 1)
                this.addOver(z ("xl/tables/table" + (to_string num) + ".xml") (XlsxWriter.tableXml(t num)))
                ti = (ti + 1)
            }
            tableSeen = (tableSeen + (sh.tableCount()))
            i = (i + 1)
        }
        sheetRelBase = 0
        this.packScriptsOver(book z)

        ; --- the three places that name parts
        this.addOver(z "xl/_rels/workbook.xml.rels" (this.mergedWorkbookRels(book pkg)))
        this.addOver(z "_rels/.rels" (this.mergedRootRels(pkg)))
        this.addOver(z "[Content_Types].xml" (this.mergedContentTypes(book pkg)))

        ; --- and everything nobody here understands
        def parts:[string] (pkg.listParts())
        def k:int 0
        while (k < (array_length parts)) {
            def part:string (itemAt parts k)
            def done@(optional):boolean (get writtenParts part)
            if (null? done) {
                ; A worksheet the workbook no longer has — a deleted sheet —
                ; must NOT be copied back in, and neither must its
                ; relationships. Everything else goes through untouched.
                if ((XlsxWriter.isDroppedSheetPart(book part)) == false) {
                    z.addFile(part (pkg.readBinary(part)))
                }
            }
            k = (k + 1)
        }
        overMode = false
        return true
    }

    fn addOver:void (z:ZipWriter name:string text:string) {
        XlsxWriter.addPart(z name text)
        set writtenParts name true
    }

    ; Where a sheet goes back. Its own part if it had one, so the relationship
    ; part beside it still matches; the conventional name if it is new.
    sfn sheetPartOf:string (sh:SpreadsheetModel index:int) {
        if ((strlen sh.partPath) > 0) {
            return sh.partPath
        }
        return ("xl/worksheets/sheet" + ((to_string (index + 1)) + ".xml"))
    }

    ; A worksheet part in the source that no sheet in the workbook claims any
    ; more. Copying it back would resurrect a deleted sheet as an orphan part.
    sfn isDroppedSheetPart:boolean (book:WorkbookModel part:string) {
        if ((indexOf part "xl/worksheets/") != 0) {
            return false
        }
        def target:string part
        def rels:boolean ((indexOf part "xl/worksheets/_rels/") == 0)
        if rels {
            ; `xl/worksheets/_rels/sheet1.xml.rels` belongs to
            ; `xl/worksheets/sheet1.xml`.
            def n:int (strlen part)
            if ((indexOf part ".rels") != (n - 5)) {
                return false
            }
            def base:string (substring part 20 (n - 5))
            target = ("xl/worksheets/" + base)
        }
        def i:int 0
        while (i < (book.sheetCount())) {
            def sh:SpreadsheetModel (book.sheetAt(i))
            if ((XlsxWriter.sheetPartOf(sh i)) == target) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    ; The largest `rIdN` a relationship part uses. Ids are names rather than
    ; numbers in OPC, but every producer writes them that way, and this writer
    ; needs a number it can safely count from — an id it reuses is a picture
    ; drawn where a table should be.
    sfn highestRelId:int (rels:string) {
        def best:int 0
        def n:int (strlen rels)
        def at:int (indexOf rels "Id=\"rId")
        while (at >= 0) {
            def i:int (at + 7)
            def v:int 0
            def any:boolean false
            while (i < n) {
                def ch:int (charAt rels i)
                if (ch < 48) {
                    i = n
                } {
                    if (ch > 57) {
                        i = n
                    } {
                        v = ((v * 10) + (ch - 48))
                        any = true
                        i = (i + 1)
                    }
                }
            }
            if any {
                if (v > best) {
                    best = v
                }
            }
            def rest:string (substring rels (at + 7) n)
            def nxt:int (indexOf rest "Id=\"rId")
            if (nxt < 0) {
                at = -1
            } {
                at = ((at + 7) + nxt)
            }
        }
        return best
    }

    ; The relationships inside a `<Relationships>` document, verbatim, as they
    ; were written. Kept whole rather than re-emitted so a target this code has
    ; no idea about survives with its type and its mode intact.
    sfn relationshipsIn:string (rels:string) {
        def out:string ""
        def n:int (strlen rels)
        def at:int (indexOf rels "<Relationship ")
        while (at >= 0) {
            def close:int at
            def found:int -1
            while (close < n) {
                if ((charAt rels close) == 62) {
                    found = close
                    close = n
                } {
                    close = (close + 1)
                }
            }
            if (found < 0) {
                return out
            }
            str_append out (substring rels at (found + 1))
            def rest:string (substring rels (found + 1) n)
            def nxt:int (indexOf rest "<Relationship ")
            if (nxt < 0) {
                at = -1
            } {
                at = ((found + 1) + nxt)
            }
        }
        return out
    }

    sfn relsDocument:string (body:string) {
        return ("<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">" + (body + "</Relationships>"))
    }

    ; One sheet's relationships: everything the source had, kept exactly, plus
    ; the ones this writer generates for its hyperlinks and tables — numbered
    ; from above the source's highest, which is what `sheetRelBase` is for.
    fn mergedSheetRels:string (m:SpreadsheetModel srcRels:string) {
        def kept:string (XlsxWriter.relationshipsIn(srcRels))
        def mine:string (XlsxWriter.relationshipsIn((this.sheetRelsXml(m))))
        if ((strlen kept) == 0) {
            if ((strlen mine) == 0) {
                return ""
            }
        }
        return (XlsxWriter.relsDocument(kept + mine))
    }

    ; The workbook's relationships. The generated ones name the sheets and the
    ; style table; the source's name the theme, the shared strings, the
    ; calculation chain and whatever else was in there. A source relationship
    ; is kept when the part it names is still going to be in the package.
    fn mergedWorkbookRels:string (book:WorkbookModel pkg:OpcPackage) {
        def out:string ""
        def i:int 0
        while (i < (book.sheetCount())) {
            def sh:SpreadsheetModel (book.sheetAt(i))
            def target:string (XlsxWriter.relTargetFromXl((XlsxWriter.sheetPartOf(sh i))))
            str_append out ("<Relationship Id=\"rId" + (to_string (i + 1)) + "\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"" + (target + "\"/>"))
            i = (i + 1)
        }
        def styleId:int ((book.sheetCount()) + 1)
        str_append out ("<Relationship Id=\"rId" + (to_string styleId) + "\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles\" Target=\"styles.xml\"/>")
        def next:int (styleId + 1)
        def rels:[OpcRelationship] (OpcPackage.parseRelationships((pkg.readXml("xl/_rels/workbook.xml.rels"))))
        def r:int 0
        while (r < (array_length rels)) {
            def rel:OpcRelationship (itemAt rels r)
            if (XlsxWriter.isRegeneratedRel(rel.type)) {
                r = (r + 1)
            } {
                ; Renumbered, because the generated ids above took the low
                ; numbers. Nothing points at a workbook relationship by id
                ; except the workbook part, and this writer regenerates that.
                str_append out ("<Relationship Id=\"rId" + (to_string next) + "\" Type=\"" + rel.type + "\" Target=\"" + rel.target + "\"")
                if (rel.targetMode == "External") {
                    str_append out " TargetMode=\"External\""
                }
                str_append out "/>"
                next = (next + 1)
                r = (r + 1)
            }
        }
        return (XlsxWriter.relsDocument(out))
    }

    ; A relationship type this writer states itself, and therefore must not
    ; copy: keeping the source's worksheet and style links beside the generated
    ; ones would give the workbook two of each.
    sfn isRegeneratedRel:boolean (type:string) {
        if (OpcPackage.typeEndsWith(type "/worksheet")) {
            return true
        }
        if (OpcPackage.typeEndsWith(type "/styles")) {
            return true
        }
        return false
    }

    ; A part path as a workbook relationship states it: relative to `xl/`.
    sfn relTargetFromXl:string (part:string) {
        if ((indexOf part "xl/") == 0) {
            return (substring part 3 (strlen part))
        }
        return ("/" + part)
    }

    ; The package relationships — where `docProps/core.xml` and
    ; `docProps/app.xml` are named, which is the only reason a workbook's
    ; author and title survive a save at all.
    fn mergedRootRels:string (pkg:OpcPackage) {
        def rels:[OpcRelationship] (OpcPackage.parseRelationships((pkg.readXml("_rels/.rels"))))
        if ((array_length rels) == 0) {
            return (XlsxWriter.relsDocument("<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"xl/workbook.xml\"/>"))
        }
        return (XlsxWriter.relsDocument((XlsxWriter.relationshipsIn((pkg.readXml("_rels/.rels"))))))
    }

    ; The content types. The source's document is the base — it already
    ; declares the extensions and the overrides for everything that is being
    ; copied through — and the generated parts are added where the source did
    ; not already name them. A part with no content type makes the package
    ; invalid, and so does a part named twice.
    fn mergedContentTypes:string (book:WorkbookModel pkg:OpcPackage) {
        def src:string (pkg.readXml("[Content_Types].xml"))
        if ((strlen src) == 0) {
            return (this.contentTypesXml(book))
        }
        def endAt:int (indexOf src "</Types>")
        if (endAt < 0) {
            return (this.contentTypesXml(book))
        }
        def head:string (substring src 0 endAt)
        def add:string ""
        def i:int 0
        while (i < (book.sheetCount())) {
            def sh:SpreadsheetModel (book.sheetAt(i))
            def part:string ("/" + (XlsxWriter.sheetPartOf(sh i)))
            if ((XlsxWriter.declaresPart(src part)) == false) {
                str_append add ("<Override PartName=\"" + part + "\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\"/>")
            }
            i = (i + 1)
        }
        def tn:int 0
        def ti:int 0
        while (ti < (book.sheetCount())) {
            def sh2:SpreadsheetModel (book.sheetAt(ti))
            tn = (tn + (sh2.tableCount()))
            ti = (ti + 1)
        }
        def t:int 0
        while (t < tn) {
            def tpart:string ("/xl/tables/table" + ((to_string (t + 1)) + ".xml"))
            if ((XlsxWriter.declaresPart(src tpart)) == false) {
                str_append add ("<Override PartName=\"" + tpart + "\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.table+xml\"/>")
            }
            t = (t + 1)
        }
        ; A script part's extension, same rule as the clean writer: declared
        ; only when a script is actually there.
        def si:int 0
        def sn:int (book.scriptCount())
        def sawTsx:boolean false
        def sawJs:boolean false
        while (si < sn) {
            def sc:GridScript (book.scriptAt(si))
            def ext:string (GridScript.extensionOfPart(sc.part))
            if (ext == ".js") {
                sawJs = true
            } {
                sawTsx = true
            }
            si = (si + 1)
        }
        if sawTsx {
            if ((indexOf src "Extension=\"tsx\"") < 0) {
                str_append add "<Default Extension=\"tsx\" ContentType=\"text/plain\"/>"
            }
        }
        if sawJs {
            if ((indexOf src "Extension=\"js\"") < 0) {
                str_append add "<Default Extension=\"js\" ContentType=\"text/plain\"/>"
            }
        }
        return ((head + add) + "</Types>")
    }

    sfn declaresPart:boolean (types:string part:string) {
        return ((indexOf types ("PartName=\"" + (part + "\""))) >= 0)
    }

    fn packScriptsOver:void (book:WorkbookModel z:ZipWriter) {
        def i:int 0
        def n:int (book.scriptCount())
        while (i < n) {
            def sc:GridScript (book.scriptAt(i))
            def part:string sc.part
            if ((strlen part) == 0) {
                part = (GridScript.partFor(sc.name))
            }
            this.addOver(z part sc.source)
            i = (i + 1)
        }
    }

    sfn addPart:void (z:ZipWriter name:string text:string) {
        z.addFile(name (XlsxWriter.utf8Buffer(text)))
    }

    ; Pack the workbook into an open ZipWriter (parts only; caller finalizes).
    fn packInto:boolean (book:WorkbookModel z:ZipWriter) {
        lastError = ""
        if ((book.sheetCount()) == 0) {
            lastError = "workbook has no sheets"
            return false
        }
        XlsxWriter.addPart(z "[Content_Types].xml" (this.contentTypesXml(book)))
        XlsxWriter.addPart(z "_rels/.rels" "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"xl/workbook.xml\"/></Relationships>")
        XlsxWriter.addPart(z "xl/workbook.xml" (this.workbookXml(book)))
        XlsxWriter.addPart(z "xl/_rels/workbook.xml.rels" (this.workbookRelsXml(book)))
        ; Every sheet shares the first sheet's style table, which is how the
        ; loader builds them: one styles.xml for the package.
        def first:SpreadsheetModel (book.sheetAt(0))
        XlsxWriter.addPart(z "xl/styles.xml" (this.stylesXml(first.styles)))
        def i:int 0
        def tableSeen:int 0
        while (i < (book.sheetCount())) {
            def sh:SpreadsheetModel (book.sheetAt(i))
            ; Which global table numbers this sheet's tables get. Set before
            ; anything that writes one, because the sheet, its relationships
            ; and the part itself all have to name the same file.
            tableBase = tableSeen
            XlsxWriter.addPart(z ("xl/worksheets/sheet" + (to_string (i + 1)) + ".xml") (this.sheetXml(sh)))
            def rels:string (this.sheetRelsXml(sh))
            if ((strlen rels) > 0) {
                XlsxWriter.addPart(z ("xl/worksheets/_rels/sheet" + (to_string (i + 1)) + ".xml.rels") rels)
            }
            def ti:int 0
            while (ti < (sh.tableCount())) {
                def t:SheetTable (sh.tableAt(ti))
                def num:int ((tableSeen + ti) + 1)
                XlsxWriter.addPart(z ("xl/tables/table" + (to_string num) + ".xml") (XlsxWriter.tableXml(t num)))
                ti = (ti + 1)
            }
            tableSeen = (tableSeen + (sh.tableCount()))
            i = (i + 1)
        }
        this.packScripts(book z)
        return true
    }

    ; The scripts the package carried in, written back where they were. A part
    ; that arrived as `ranger/x.js` leaves as `ranger/x.js`; one made in the
    ; editor gets the default `.tsx` name.
    fn packScripts:void (book:WorkbookModel z:ZipWriter) {
        def i:int 0
        def n:int (book.scriptCount())
        while (i < n) {
            def sc:GridScript (book.scriptAt(i))
            def part:string sc.part
            if ((strlen part) == 0) {
                part = (GridScript.partFor(sc.name))
            }
            XlsxWriter.addPart(z part sc.source)
            i = (i + 1)
        }
    }

    ; Write the whole workbook. `dir` and `name` are what ZipWriter's own save
    ; takes: a directory and a file name.
    fn write:boolean (book:WorkbookModel dir:string name:string) {
        def z:ZipWriter (new ZipWriter)
        z.create()
        def ok:boolean (this.packInto(book z))
        if (ok == false) {
            return false
        }
        z.save(dir name)
        return true
    }

    ; --- the two saves --------------------------------------------------------
    ;
    ; `write` builds a fresh package: a CLEAN file, and sometimes that is
    ; exactly what is wanted. `writeOver` preserves what the model does not
    ; carry. Neither is the right answer always, which is why both are here and
    ; the caller says which.
    ;
    ; A workbook with no source — one made in the editor, or one whose host
    ; called `dropSource()` — cannot be written over. That is reported rather
    ; than silently downgraded: a caller that asked to preserve and got a clean
    ; file would have no way to know.
    fn writeOver:boolean (book:WorkbookModel dir:string name:string) {
        lastError = ""
        if ((book.hasSource()) == false) {
            lastError = "this workbook was not read from a file, so there is nothing to write over"
            return false
        }
        def pkg:OpcPackage (new OpcPackage())
        if ((pkg.openBytes(book.sourceBytes "workbook.xlsx")) == false) {
            lastError = "the workbook this was read from cannot be reopened"
            return false
        }
        def z:ZipWriter (new ZipWriter)
        z.create()
        def ok:boolean (this.packOver(book pkg z))
        pkg.close()
        if (ok == false) {
            return false
        }
        z.save(dir name)
        return true
    }

    ; The same, as bytes — what a browser download needs.
    fn writeOverToBuffer:buffer (book:WorkbookModel) {
        lastError = ""
        if ((book.hasSource()) == false) {
            lastError = "this workbook was not read from a file, so there is nothing to write over"
            return (buffer_alloc 0)
        }
        def pkg:OpcPackage (new OpcPackage())
        if ((pkg.openBytes(book.sourceBytes "workbook.xlsx")) == false) {
            lastError = "the workbook this was read from cannot be reopened"
            return (buffer_alloc 0)
        }
        def z:ZipWriter (new ZipWriter)
        z.create()
        def ok:boolean (this.packOver(book pkg z))
        pkg.close()
        if (ok == false) {
            return (buffer_alloc 0)
        }
        return (z.toBuffer())
    }

    ; Same package as `write`, as bytes — for browser download / in-memory hosts.
    fn writeToBuffer:buffer (book:WorkbookModel) {
        def z:ZipWriter (new ZipWriter)
        z.create()
        def ok:boolean (this.packInto(book z))
        if (ok == false) {
            return (buffer_alloc 0)
        }
        return (z.toBuffer())
    }
}

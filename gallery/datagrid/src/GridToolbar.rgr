; ==============================================================================
; GridToolbar.rgr — the buttons, and what each of them means.
; ==============================================================================
;
; The app could do a great deal and showed almost none of it: everything was a
; keyboard shortcut or a command string, which is fine for a host driving the
; grid over a socket and useless for a person looking at it.
;
; This is the strip of buttons, described once. Each entry names a COMMAND —
; the same string the keyboard and a remote host use — so a button cannot do
; something the command surface cannot, and adding a command to the table is
; how a button gets its behaviour. The entry also carries how it should look:
; an icon drawn from primitives (there is no icon font here, and a PNG sprite
; sheet would be a second thing to keep in step with the theme), and whether it
; is a toggle, in which case the view asks the selection whether it is on.
;
; The layout is measured, not assumed: labels are as wide as their text, groups
; are separated, and anything that would not fit is simply not drawn — a
; toolbar that runs off the edge of its own strip is the bug the dialogs had.
; ==============================================================================

Import "SpreadsheetModel.rgr"
Import "GridSelection.rgr"
Import "GridFormat.rgr"

; How a button draws itself. Icons are numbers rather than names so the paint
; switch is a jump table; the label is what a text button shows and what a
; tooltip says for an icon one.
class ToolIcon {
    sfn none:int ()        { return 0 }
    sfn undo:int ()        { return 1 }
    sfn redo:int ()        { return 2 }
    sfn bold:int ()        { return 3 }
    sfn italic:int ()      { return 4 }
    sfn underline:int ()   { return 5 }
    sfn strike:int ()      { return 6 }
    sfn alignLeft:int ()   { return 7 }
    sfn alignCenter:int () { return 8 }
    sfn alignRight:int ()  { return 9 }
    sfn valignTop:int ()   { return 10 }
    sfn valignMid:int ()   { return 11 }
    sfn valignBot:int ()   { return 12 }
    ; `wrap` belongs to the text renderer; this one is `wrapCell`.
    sfn wrapCell:int ()    { return 13 }
    sfn merge:int ()       { return 14 }
    sfn borderAll:int ()   { return 15 }
    sfn borderOut:int ()   { return 16 }
    sfn borderNone:int ()  { return 17 }
    sfn fill:int ()        { return 18 }
    sfn textColor:int ()   { return 19 }
    sfn currency:int ()    { return 20 }
    sfn percent:int ()     { return 21 }
    sfn comma:int ()       { return 22 }
    sfn decMore:int ()     { return 23 }
    sfn decLess:int ()     { return 24 }
    sfn sizeUp:int ()      { return 25 }
    sfn sizeDown:int ()    { return 26 }
    sfn paint:int ()       { return 27 }
    sfn clearFmt:int ()    { return 28 }
    sfn freeze:int ()      { return 29 }
    ; `filter` is taken by the compiler too.
    sfn funnel:int ()      { return 30 }
    sfn sortAsc:int ()     { return 31 }
    sfn sortDesc:int ()    { return 32 }
    sfn insertRow:int ()   { return 33 }
    sfn insertCol:int ()   { return 34 }
    sfn deleteRow:int ()   { return 35 }
    sfn chart:int ()       { return 36 }
    sfn link:int ()        { return 37 }
    sfn comment:int ()     { return 38 }
    ; `find` is a name the compiler keeps for itself, hence `search`.
    sfn search:int ()      { return 39 }
    sfn cond:int ()        { return 40 }
    sfn validate:int ()    { return 41 }
    sfn save:int ()        { return 42 }
    sfn openFile:int ()    { return 43 }
}

class ToolItem {
    ; The command this runs, and the argument it runs it with.
    def command:string ""
    def arg:string ""
    def label:string ""
    def icon:int 0
    ; A toggle draws itself pressed when its style question answers yes. The
    ; question is `toggleOp` / `toggleArg`, asked of the cell the caret is on.
    def toggle:boolean false
    def toggleOp:string ""
    def toggleArg:string ""
    ; Laid-out geometry, filled by `layout`.
    def x:int 0
    def y:int 0
    def w:int 0
    def h:int 0
    ; A separator is drawn as a rule and cannot be clicked.
    def isSeparator:boolean false

    Constructor () {
    }
}

class GridToolbar {
    def items:[ToolItem]
    ; One row is 30 tall; the strip is as many rows as the buttons need at the
    ; width it is given. A spreadsheet has more buttons than a narrow window
    ; has room for, and dropping the last six of them — which is what a single
    ; fixed row does — loses exactly the ones a beginner is looking for.
    def rowH:int 30
    def rows:int 1
    def height:int 32
    def pad:int 5
    def iconW:int 26
    ; Which item the pointer is over, or -1. Only chrome, but it is the
    ; difference between a strip of shapes and something that looks clickable.
    def hot:int -1

    Constructor () {
    }

    fn add:ToolItem (command:string arg:string label:string icon:int) {
        def t (new ToolItem)
        t.command = command
        t.arg = arg
        t.label = label
        t.icon = icon
        push items t
        return t
    }

    fn addToggle:ToolItem (command:string arg:string label:string icon:int op:string opArg:string) {
        def t:ToolItem (this.add(command arg label icon))
        t.toggle = true
        t.toggleOp = op
        t.toggleArg = opArg
        return t
    }

    fn addSeparator:void () {
        def t (new ToolItem)
        t.isSeparator = true
        push items t
    }

    ; The standard set, in the order a spreadsheet puts them. Every entry is a
    ; command the app already answers to.
    fn build:void () {
        clear items
        this.add("file.open" "" "Open a workbook" (ToolIcon.openFile()))
        this.add("file.save" "" "Save" (ToolIcon.save()))
        this.add("file.saveAs" "" "Save As…" (ToolIcon.save()))
        this.add("edit.undo" "" "Undo" (ToolIcon.undo()))
        this.add("edit.redo" "" "Redo" (ToolIcon.redo()))
        this.add("edit.formatPainter" "" "Format painter" (ToolIcon.paint()))
        this.addSeparator()

        this.addToggle("format.bold" "" "Bold" (ToolIcon.bold()) "bold" "")
        this.addToggle("format.italic" "" "Italic" (ToolIcon.italic()) "italic" "")
        this.addToggle("format.underline" "" "Underline" (ToolIcon.underline()) "underline" "")
        this.addToggle("format.strike" "" "Strikethrough" (ToolIcon.strike()) "strike" "")
        this.add("format.size.up" "" "Bigger" (ToolIcon.sizeUp()))
        this.add("format.size.down" "" "Smaller" (ToolIcon.sizeDown()))
        this.add("format.color" "#C00000" "Text colour" (ToolIcon.textColor()))
        this.add("format.fill" "#FFF2CC" "Fill colour" (ToolIcon.fill()))
        this.addSeparator()

        this.addToggle("format.align" "left" "Align left" (ToolIcon.alignLeft()) "align" "left")
        this.addToggle("format.align" "center" "Centre" (ToolIcon.alignCenter()) "align" "center")
        this.addToggle("format.align" "right" "Align right" (ToolIcon.alignRight()) "align" "right")
        this.addToggle("format.valign" "top" "Top" (ToolIcon.valignTop()) "valign" "top")
        this.addToggle("format.valign" "center" "Middle" (ToolIcon.valignMid()) "valign" "center")
        this.addToggle("format.valign" "bottom" "Bottom" (ToolIcon.valignBot()) "valign" "bottom")
        this.addToggle("format.wrap" "" "Wrap text" (ToolIcon.wrapCell()) "wrap" "")
        this.add("format.merge" "" "Merge cells" (ToolIcon.merge()))
        this.addSeparator()

        this.add("format.border" "all" "All borders" (ToolIcon.borderAll()))
        this.add("format.border" "outline" "Outline" (ToolIcon.borderOut()))
        this.add("format.border" "none" "No border" (ToolIcon.borderNone()))
        this.addSeparator()

        this.addToggle("format.numfmt" "currency" "Currency" (ToolIcon.currency()) "numfmt" "currency")
        this.addToggle("format.numfmt" "percent" "Percent" (ToolIcon.percent()) "numfmt" "percent")
        this.addToggle("format.numfmt" "comma" "Thousands" (ToolIcon.comma()) "numfmt" "comma")
        this.add("format.decimals" "more" "More decimals" (ToolIcon.decMore()))
        this.add("format.decimals" "less" "Fewer decimals" (ToolIcon.decLess()))
        this.add("format.clear" "" "Clear formatting" (ToolIcon.clearFmt()))
        this.addSeparator()

        this.add("insert.row.above" "" "Insert row" (ToolIcon.insertRow()))
        this.add("insert.column.left" "" "Insert column" (ToolIcon.insertCol()))
        this.add("delete.rows" "" "Delete rows" (ToolIcon.deleteRow()))
        this.add("data.sort.asc" "" "Sort ascending" (ToolIcon.sortAsc()))
        this.add("data.sort.desc" "" "Sort descending" (ToolIcon.sortDesc()))
        this.add("view.freeze.here" "" "Freeze panes" (ToolIcon.freeze()))
        this.addSeparator()

        this.add("insert.chart" "" "Chart" (ToolIcon.chart()))
        this.add("insert.link" "" "Link" (ToolIcon.link()))
        this.add("edit.find" "" "Find" (ToolIcon.search()))
        this.add("format.conditional" "" "Conditional formatting" (ToolIcon.cond()))
        this.add("data.validation" "" "Data validation" (ToolIcon.validate()))
    }

    ; Place the items across the strip. Anything past the right edge is given
    ; zero width and skipped by both the painter and the hit test, so a narrow
    ; window loses buttons rather than drawing them on top of each other.
    fn layout:void (x0:int y0:int width:int) {
        def right:int ((x0 + width) - pad)
        def cx:int (x0 + pad)
        def row:int 0
        def i:int 0
        while (i < (array_length items)) {
            def t:ToolItem (itemAt items i)
            def w:int iconW
            if t.isSeparator {
                w = 9
            }
            if ((cx + w) > right) {
                ; Wrap. A separator never starts a row — it would be a rule
                ; hanging in space.
                row = (row + 1)
                cx = (x0 + pad)
                if t.isSeparator {
                    t.x = 0
                    t.y = 0
                    t.w = 0
                    t.h = 0
                    i = (i + 1)
                    continue
                }
            }
            t.x = cx
            t.y = ((y0 + (row * rowH)) + 3)
            t.w = w
            t.h = (rowH - 6)
            cx = (cx + w)
            if (t.isSeparator == false) {
                cx = (cx + 2)
            }
            i = (i + 1)
        }
        rows = (row + 1)
        height = (rows * rowH)
    }

    ; How tall the strip has to be at this width — asked once, before the grid
    ; is given its bounds, because everything below it starts underneath.
    fn heightFor:int (width:int) {
        this.layout(0 0 width)
        return height
    }

    fn count:int () {
        return (array_length items)
    }

    fn at:ToolItem (i:int) {
        if (i < 0) {
            return (new ToolItem)
        }
        if (i >= (array_length items)) {
            return (new ToolItem)
        }
        return (itemAt items i)
    }

    ; Which button is under the pointer, or -1.
    fn hit:int (px:int py:int) {
        def i:int 0
        while (i < (array_length items)) {
            def t:ToolItem (itemAt items i)
            if (t.isSeparator == false) {
                if (t.w > 0) {
                    if (px >= t.x) {
                        if (px < (t.x + t.w)) {
                            if (py >= t.y) {
                                if (py < (t.y + t.h)) {
                                    return i
                                }
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return -1
    }

    ; Whether a toggle should be drawn pressed for the current selection.
    fn isPressed:boolean (i:int model:SpreadsheetModel sel:GridSelection) {
        def t:ToolItem (this.at(i))
        if (t.toggle == false) {
            return false
        }
        return (GridFormat.activeIsOn(model sel t.toggleOp t.toggleArg))
    }

    ; The tooltip for whatever is hot, or "".
    fn hotLabel:string () {
        if (hot < 0) {
            return ""
        }
        def t:ToolItem (this.at(hot))
        return t.label
    }
}

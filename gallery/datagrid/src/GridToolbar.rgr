; ==============================================================================
; GridToolbar.rgr — which buttons a spreadsheet has, and what "pressed" means.
; ==============================================================================
;
; The strip itself — adding, measuring, wrapping, hit testing, hover, and the
; three hundred lines that draw the icons — is `gallery/evg/EVGToolbar.rgr` and
; `EVGToolbarView.rgr` now, because Word wanted the same one and a second copy
; is how two toolbars start drifting apart.
;
; What is left here is the only part that is about spreadsheets: WHICH buttons,
; in which order, and what a toggle is asking. Every entry names a COMMAND —
; the same string the keyboard and a remote host use — so a button cannot do
; something the command surface cannot, and adding a command to the table is
; how a button gets its behaviour.
; ==============================================================================

Import "SpreadsheetModel.rgr"
Import "GridSelection.rgr"
Import "GridFormat.rgr"
Import "../../evg/EVGToolbar.rgr"

class GridToolbar extends EVGToolbar {
    ; What the direction switch is showing. The strip needs it to draw the
    ; button pressed; the app owns the decision.
    def uiRtl:boolean false

    Constructor () {
    }

    ; The strip, in named pages.
    ;
    ; Fifty-odd commands in one band is a wall: everything is present and
    ; nothing is findable, and at any window narrower than a desk the last
    ; dozen wrap onto a second row or fall off the end — which are exactly the
    ; ones a beginner is hunting for. The names are the ones an office suite
    ; has taught everybody: Home is what you use on the text in a cell, Insert
    ; puts something new in the sheet, Data is about the numbers, Review is
    ; the tools you reach for once rather than all day.
    ;
    ; The order inside a page is the order it was already in, and the
    ; separators that grouped it are kept — a page is a coarser grouping laid
    ; over the fine one, not a replacement for it.
    fn build:void () {
        clear items
        clear tabs
        this.addTab("Home")
        this.add("file.new" "" "New workbook" (ToolIcon.newFile()))
        this.add("file.open" "" "Open a workbook" (ToolIcon.openFile()))
        ; The handful a beginner reaches for first carry their names. The rest
        ; stay pictures — a band where everything is labelled is as unreadable
        ; as one where nothing is.
        this.addLabeled("file.save" "" "Save" (ToolIcon.save()))
        this.add("file.saveAs" "" "Save As…" (ToolIcon.save()))
        this.addLabeled("file.print" "" "Print" (ToolIcon.printDoc()))
        this.add("edit.undo" "" "Undo" (ToolIcon.undo()))
        this.add("edit.redo" "" "Redo" (ToolIcon.redo()))
        this.add("edit.formatPainter" "" "Format painter" (ToolIcon.paint()))
        this.addSeparator()

        this.addToggle("format.bold" "" "Bold" (ToolIcon.bold()) "bold" "")
        this.addToggle("format.italic" "" "Italic" (ToolIcon.italic()) "italic" "")
        this.addToggle("format.underline" "" "Underline" (ToolIcon.underline()) "underline" "")
        this.addToggle("format.strike" "" "Strikethrough" (ToolIcon.strike()) "strike" "")
        this.addText("format.font" "" "Font" 78)
        this.addText("format.size.pick" "" "Size" 40)
        this.add("format.size.up" "" "Bigger" (ToolIcon.sizeUp()))
        this.add("format.size.down" "" "Smaller" (ToolIcon.sizeDown()))
        this.add("format.color" "" "Text colour" (ToolIcon.textColor()))
        this.add("format.fill" "" "Fill colour" (ToolIcon.fill()))
        this.addSeparator()

        this.addToggle("format.align" "left" "Align left" (ToolIcon.alignLeft()) "align" "left")
        this.addToggle("format.align" "center" "Centre" (ToolIcon.alignCenter()) "align" "center")
        this.addToggle("format.align" "right" "Align right" (ToolIcon.alignRight()) "align" "right")
        this.addToggle("format.valign" "top" "Top" (ToolIcon.valignTop()) "valign" "top")
        this.addToggle("format.valign" "center" "Middle" (ToolIcon.valignMid()) "valign" "center")
        this.addToggle("format.valign" "bottom" "Bottom" (ToolIcon.valignBot()) "valign" "bottom")
        this.addToggle("format.wrap" "" "Wrap text" (ToolIcon.wrapCell()) "wrap" "")
        this.add("format.merge" "" "Merge cells" (ToolIcon.merge()))
        this.addSeparator()

        this.addTab("Format")
        ; Four border commands in one slot. This is what a dropdown is FOR:
        ; the four are one decision, they are rarely made, and spread across
        ; four buttons they take as much of the strip as bold, italic,
        ; underline and strike put together.
        this.addDropdown("Borders" (ToolIcon.borderAll()))
        this.addUnder("format.border" "all" "All borders" (ToolIcon.borderAll()))
        this.addUnder("format.border" "outline" "Outline" (ToolIcon.borderOut()))
        this.addUnder("format.border" "none" "No border" (ToolIcon.borderNone()))
        this.addUnder("format.border" "" "More borders…" (ToolIcon.borderMore()))
        this.addSeparator()

        this.addToggle("format.numfmt" "currency" "Currency" (ToolIcon.currency()) "numfmt" "currency")
        this.addToggle("format.numfmt" "percent" "Percent" (ToolIcon.percent()) "numfmt" "percent")
        this.addToggle("format.numfmt" "comma" "Thousands" (ToolIcon.comma()) "numfmt" "comma")
        this.add("format.decimals" "more" "More decimals" (ToolIcon.decMore()))
        this.add("format.decimals" "less" "Fewer decimals" (ToolIcon.decLess()))
        this.add("format.clear" "" "Clear formatting" (ToolIcon.clearFmt()))
        this.addSeparator()

        this.addTab("Insert")
        this.add("insert.row.above" "" "Insert row" (ToolIcon.insertRow()))
        this.add("insert.column.left" "" "Insert column" (ToolIcon.insertCol()))
        this.add("delete.rows" "" "Delete rows" (ToolIcon.deleteRow()))
        this.add("data.sort.asc" "" "Sort ascending" (ToolIcon.sortAsc()))
        this.add("data.sort.desc" "" "Sort descending" (ToolIcon.sortDesc()))
        this.add("view.freeze.here" "" "Freeze panes" (ToolIcon.freeze()))
        this.addSeparator()

        this.add("insert.chart" "" "Chart" (ToolIcon.chart()))
        this.add("insert.link" "" "Link" (ToolIcon.link()))

        this.addTab("Data")
        this.add("format.conditional" "" "Conditional formatting" (ToolIcon.cond()))
        this.add("data.validation" "" "Data validation" (ToolIcon.validate()))
        this.addSeparator()
        this.add("script.run" "" "Run the report script" (ToolIcon.report()))
        this.add("db.connection" "" "Database connection" (ToolIcon.database()))
        this.add("db.sql.dialog" "" "SQL query" (ToolIcon.sqlBox()))

        this.addTab("Review")
        this.add("edit.find" "" "Find" (ToolIcon.search()))
        this.addSeparator()
        this.add("view.rtl" "" "Right-to-left layout" (ToolIcon.textRtl()))
    }

    fn isPressed:boolean (i:int model:SpreadsheetModel sel:GridSelection) {
        def t:ToolItem (this.at(i))
        if (t.toggle == false) {
            return false
        }
        return (GridFormat.activeIsOn(model sel t.toggleOp t.toggleArg))
    }

    ; What the strip is about to draw, answered once per frame. The shared
    ; component holds the answer on the item; it cannot work it out, because
    ; "is bold on" is a question about a cell and the strip has never heard of
    ; one.
    fn refreshToggles:void (model:SpreadsheetModel sel:GridSelection) {
        def i:int 0
        while (i < (array_length items)) {
            def t:ToolItem (itemAt items i)
            if t.toggle {
                t.pressed = (GridFormat.activeIsOn(model sel t.toggleOp t.toggleArg))
            } {
                t.pressed = false
            }
            if (t.command == "view.rtl") {
                t.pressed = uiRtl
            }
            i = (i + 1)
        }
    }

    ; The two buttons that show a value rather than a picture: the face and
    ; the point size of the cell the caret is on.
    fn refreshLabels:void (model:SpreadsheetModel sel:GridSelection) {
        def st:CellStyle (model.getCellStyle(sel.active.row sel.active.col))
        def i:int 0
        while (i < (array_length items)) {
            def t:ToolItem (itemAt items i)
            if (t.textW > 0) {
                if (t.command == "format.size.pick") {
                    t.label = (to_string (to_int st.fontSizePt))
                }
                if (t.command == "format.font") {
                    def nm:string st.fontName
                    if ((strlen nm) == 0) {
                        nm = "Font"
                    }
                    if ((strlen nm) > 10) {
                        nm = (substring nm 0 10)
                    }
                    t.label = nm
                }
            }
            i = (i + 1)
        }
    }
}

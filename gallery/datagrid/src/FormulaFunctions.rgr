        }
        return (FormulaValue.fromString((FormulaFunctions.lower((v.asDisplay())))))
    }

    sfn fnTrim:FormulaValue (args:[FormulaValue]) {
        def ar:FormulaValue (FormulaFunctions.needArity(args 1))
        def ae:boolean (ar.isError())
        if ae {
            return ar
        }
        def v:FormulaValue (itemAt args 0)
        def ee:boolean (v.isError())
        if ee {
            return v
        }
        def s:string (v.asDisplay())
        def n:int (strlen s)
        def a:int 0
        while (a < n) {
            def ch:int (charAt s a)
            if ((ch == 32) || (ch == 9)) {
                a = (a + 1)
            } {
                break
            }
        }
        def b:int n
        while (b > a) {
            def ch2:int (charAt s (b - 1))
            if ((ch2 == 32) || (ch2 == 9)) {
                b = (b - 1)
            } {
                break
            }
        }
        return (FormulaValue.fromString((substring s a b)))
    }

    sfn fnConcat:FormulaValue (args:[FormulaValue]) {
        def out:string ""
        def i:int 0
        def n:int (array_length args)
        while (i < n) {
            def v:FormulaValue (itemAt args i)
            def ee:boolean (v.isError())
            if ee {
                return v
            }
            out = (out + (v.asDisplay()))
            i = (i + 1)
        }
        return (FormulaValue.fromString(out))
    }

    sfn fnValue:FormulaValue (args:[FormulaValue]) {
        def ar:FormulaValue (FormulaFunctions.needArity(args 1))
        def ae:boolean (ar.isError())
        if ae {
            return ar
        }
        def v:FormulaValue (itemAt args 0)
        def ee:boolean (v.isError())
        if ee {
            return v
        }
        def nums:[double]
        def ok:boolean (v.tryNumber(nums))
        if ok {
            return (FormulaValue.fromNumber((itemAt nums 0)))
        }
        return (FormulaValue.fromError("#VALUE!"))
    }


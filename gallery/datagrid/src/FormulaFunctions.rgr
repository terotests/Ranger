        if (n == "CONCAT") {
            return (FormulaFunctions.fnConcat(args))
        }
        if (n == "CONCATENATE") {
            return (FormulaFunctions.fnConcat(args))
        }
        if (n == "VALUE") {
            return (FormulaFunctions.fnValue(args))
        }
        if (n == "TRUE") {
            return (FormulaValue.fromBool(true))
        }
        if (n == "FALSE") {

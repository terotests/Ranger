        }
        return (FormulaValue.fromNumber((to_double (strlen (v.asDisplay())))))
    }

    sfn fnLeft:FormulaValue (args:[FormulaValue]) {
        def ar:FormulaValue (FormulaFunctions.needArity(args 1))
        def ae:boolean (ar.isError())
        if ae {
            return ar
        }
        def v:FormulaValue (itemAt args 0)
        def ee:boolean (v.isError())
        if ee {
            return v
        }
        def n:int 1
        if ((array_length args) >= 2) {
            def nArg:FormulaValue (itemAt args 1)
            n = (to_int (nArg.asNumber()))
        }
        if (n < 0) {
            return (FormulaValue.fromError("#VALUE!"))
        }
        def s:string (v.asDisplay())
        def L:int (strlen s)
        if (n > L) {
            n = L
        }
        return (FormulaValue.fromString((substring s 0 n)))
    }

    sfn fnRight:FormulaValue (args:[FormulaValue]) {
        def ar:FormulaValue (FormulaFunctions.needArity(args 1))
        def ae:boolean (ar.isError())
        if ae {
            return ar
        }
        def v:FormulaValue (itemAt args 0)
        def ee:boolean (v.isError())
        if ee {
            return v
        }
        def n:int 1
        if ((array_length args) >= 2) {
            def nArg:FormulaValue (itemAt args 1)
            n = (to_int (nArg.asNumber()))
        }
        if (n < 0) {
            return (FormulaValue.fromError("#VALUE!"))
        }
        def s:string (v.asDisplay())
        def L:int (strlen s)
        if (n > L) {
            n = L
        }
        return (FormulaValue.fromString((substring s (L - n) L)))
    }

    sfn fnMid:FormulaValue (args:[FormulaValue]) {
        def ar:FormulaValue (FormulaFunctions.needArity(args 3))
        def ae:boolean (ar.isError())
        if ae {
            return ar
        }
        def v:FormulaValue (itemAt args 0)
        def ee:boolean (v.isError())
        if ee {
            return v
        }
        def startArg:FormulaValue (itemAt args 1)
        def nArg:FormulaValue (itemAt args 2)
        def start:int (to_int (startArg.asNumber()))
        def n:int (to_int (nArg.asNumber()))
        if ((start < 1) || (n < 0)) {
            return (FormulaValue.fromError("#VALUE!"))
        }
        def s:string (v.asDisplay())
        def L:int (strlen s)
        def i0:int (start - 1)
        if (i0 >= L) {
            return (FormulaValue.fromString(""))
        }
        def i1:int (i0 + n)
        if (i1 > L) {
            i1 = L
        }
        return (FormulaValue.fromString((substring s i0 i1)))
    }

    sfn fnUpper:FormulaValue (args:[FormulaValue]) {

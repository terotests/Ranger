; ==============================================================================
; GridView - DataGrid scene → EVGDisplayList → SoftCanvas / WebGL
; ==============================================================================
;
; Only visible cells become draw cmds (batched fills, texts, 1px grid lines).
; Selection is an overlay rect — not a style mutation on each cell.
;
;   GridView.buildDisplayList  →  EVGDisplayList
;        ├─ paintSoftCanvas    →  SoftCanvas (tests / SDL)
;        └─ sceneJson          →  gallery/evg/gl/evg-webgl.js
; ==============================================================================

Import "SpreadsheetModel.rgr"
Import "GridSelection.rgr"
Import "DataGrid.rgr"
Import "CellStyle.rgr"
Import "GridTheme.rgr"
Import "ConditionalFormat.rgr"
Import "../../evg/EVGWindow.rgr"
Import "GridChartView.rgr"
Import "GridImages.rgr"
Import "../../evg/EVGCommands.rgr"
Import "GridToolbar.rgr"
Import "../../evg/EVGToolbarView.rgr"
Import "SoftPainter.rgr"
Import "script/ScriptPreview.rgr"
Import "../../game_engine/framebuffer.rgr"
Import "../../game_engine/ui/UIContext.rgr"
Import "../../evg/EVGColor.rgr"
Import "../../evg/EVGDisplayList.rgr"
Import "../../evg/EVGA11yTree.rgr"
Import "WorkbookModel.rgr"

class GridView {
    def canvas:SoftCanvas (new SoftCanvas)
    def ctx:UIContext (new UIContext)
    ; The display-list → canvas loop, which is shared with the clipboard: a
    ; copied chart is painted by this same code onto an off-screen surface.
    def painter:SoftPainter (new SoftPainter)
    ; A report, when one is open. It is drawn from the script's own display
    ; list — see script/ScriptPreview.rgr — into this one, over the sheet.
    def preview:ScriptPreview (new ScriptPreview)
    def theme:GridTheme (new GridTheme)
    ; The palette revision and the window-manager add count `syncWindowTheme`
    ; last painted the dialogs for.
    def themedRevision:int 0
    def themedWindows:int 0
    def status:string ""
    def editCaret:int 0
    ; When true the blinking caret belongs in the formula bar, not only in the
    ; active cell — clicking the bar focuses editing there.
    def editInFormulaBar:boolean false
    ; Dialogs painted on top of the grid, from the shared EVG window layer.
    def windows:EVGWindowManager (new EVGWindowManager)
    ; The charts floating over the sheet. Painted here rather than by the
    ; window layer, because their content is the document's and the frame is
    ; not.
    def chartLayer:ChartLayer (new ChartLayer)
    ; Where a dragged block would land. Painted as an outline, so the cells it
    ; would cover are still readable underneath it.
    ; The pictures anchored to the sheet, decoded once and drawn where their
    ; anchors land. The host fills the byte source; the view only draws.
    def images:GridImages (new GridImages)
    ; The host's custom tools, drawn as buttons on the status bar. The view
    ; only paints them; what they mean is the host's business.
    def commands:GridCommandTable (new GridCommandTable)
    ; The buttons. The app owns what they do; the view lays them out and paints
    ; them, and the layout lives on the toolbar object so the hit test and the
    ; picture cannot disagree.
    def toolbar:GridToolbar (new GridToolbar)
    ; The shared strip painter. It knows how to draw a toolbar and nothing
    ; about spreadsheets; `paintToolbar` hands it the palette and the items.
    def toolbarView:EVGToolbarView (new EVGToolbarView)
    ; The chart the picker is previewing, and which window to draw it in. Set
    ; by the host every frame the picker is up; zero means nothing to preview.
    def previewChart:GridChart (new GridChart)
    def previewWid:int 0
    ; Colour picker example cell — painted into the dialog's content region.
    def colorPreviewWid:int 0
    def colorPreviewHex:string "#C00000"
    ; The border gallery's preview: which window it belongs to, and the spec
    ; string its controls currently say. Drawn as a four-cell block, because a
    ; block is the only place "inside horizontal" means anything.
    def borderPreviewWid:int 0
    def borderPreviewSpec:string "spec:TBLR:thin:#000000"
    def colorPreviewIsFill:boolean false
    def ghostVisible:boolean false
    def ghostR0:int 0
    def ghostC0:int 0
    def ghostR1:int 0
    def ghostC1:int 0
    ; Coloured rectangles for ranges named in the active formula (Excel-style).
    def formulaHiliteR0:[int]
    def formulaHiliteC0:[int]
    def formulaHiliteR1:[int]
    def formulaHiliteC1:[int]
    ; Last-painted formula-bar field geometry, so a click can place the caret.
    def fbFieldX:int 0
    def fbFieldY:int 0
    def fbFieldW:int 0
    def fbFieldH:int 0
    def fbTextX:int 0
    def fbTextY:int 0
    def fbFontSize:double 13.0
    ; Where the text of the cell being edited was actually drawn, so the caret
    ; can stand on the same line rather than at a guessed offset from the
    ; cell's top corner.
    ; The insertion point a carried column would drop at, or -1.
    def colDropAt:int -1
    ; A tab being carried, and where it would land. -1 for neither.
    def tabDragFrom:int -1
    def tabDropSlot:int -1
    ; The span of selected text inside the field being edited, as character
    ; offsets, or -1 -1 for none. Drawn as a band behind the letters, which is
    ; what a text field looks like everywhere.
    def editSelA:int -1
    def editSelB:int -1
    def editTextX:int 0
    def editTextY:int 0
    def editTextPx:double 13.0
    ; Set during paint for tests/hosts: formula edits always own the bar caret.
    def caretInFormulaBar:boolean false
    def focused:boolean true
    def frame:int 0
    def fontFamily:string "Open Sans"
    def fontSize:double 13.0
    def pageW:int 900
    def pageH:int 560
    def menuOpen:boolean false
    def menuW:int 190
    def menuH:int 270
    def menuCol:int -1
    ; 0 = the column menu, 1 = the row menu. One popup, two menus: they are
    ; the same list of actions read down a different axis.
    def menuKind:int 0
    def menuRow:int -1
    def menuX:int 0
    def menuY:int 0

    Constructor () {
    }

    ; Everything `init` does except read font files, which a browser cannot do.
    ; The faces arrive as bytes afterwards, through `loadFontBytes`.
    fn initBare:void (w:int h:int) {
        pageW = w
        pageH = h
        canvas.init(w h)
        ctx.attach(canvas)
        status = "no fonts yet"
    }

    fn init:void (w:int h:int fontDir:string) {
        pageW = w
        pageH = h
        canvas.init(w h)
        ctx.attach(canvas)
        ctx.tr.addFontDir(fontDir)
        def ok:boolean (ctx.tr.loadFont(fontFamily "Open_Sans/OpenSans-Regular.ttf"))
        ; Only Regular used to be loaded, so every bold / italic cell silently
        ; fell back to it — styles.xml said bold, the grid painted regular.
        ctx.tr.fm.loadFont("Open_Sans/OpenSans-Bold.ttf")
        ctx.tr.fm.loadFont("Open_Sans/OpenSans-Italic.ttf")
        ctx.tr.fm.loadFont("Open_Sans/OpenSans-BoldItalic.ttf")
        ; Extra faces for the font dropdown. Unknown workbook faces still fall
        ; back to Open Sans when the file is missing.
        ctx.tr.fm.loadFont("Noto_Sans/NotoSans-Regular.ttf")
        ctx.tr.fm.loadFont("Noto_Sans/NotoSans-Bold.ttf")
        ctx.tr.fm.loadFont("Noto_Sans/NotoSans-Italic.ttf")
        ctx.tr.fm.loadFont("Noto_Sans/NotoSans-BoldItalic.ttf")
        ctx.tr.fm.loadFont("Helvetica/Helvetica.ttf")
        ctx.tr.fm.loadFont("Droid_Serif/DroidSerif.ttf")
        ctx.tr.fm.loadFont("Droid_Serif/DroidSerif-Bold.ttf")
        ctx.tr.fm.loadFont("Droid_Serif/DroidSerif-Italic.ttf")
        ctx.tr.fm.loadFont("Droid_Serif/DroidSerif-BoldItalic.ttf")
        ctx.tr.fm.loadFont("Josefin_Sans/JosefinSans-Regular.ttf")
        ctx.tr.fm.loadFont("Josefin_Sans/JosefinSans-Bold.ttf")
        ctx.tr.fm.loadFont("Josefin_Sans/JosefinSans-Italic.ttf")
        ctx.tr.fm.loadFont("Josefin_Sans/JosefinSans-BoldItalic.ttf")
        if (ok == false) {
            status = "bitmap-font fallback"
        } {
            status = "ready"
        }
    }

    fn resize:void (w:int h:int) {
        pageW = w
        pageH = h
        canvas.init(w h)
        ctx.attach(canvas)
        ctx.tr.clearCache()
    }

    fn raw:buffer () {
        return (canvas.raw())
    }

    ; The grid draws through the display list's own encoders, the same ones
    ; EVGWindow's controls use. Two copies of "how a rectangle is written into
    ; the list" is one copy too many.
    fn pushRect:void (dl:EVGDisplayList x:double y:double w:double h:double col:EVGColor) {
        dl.addRect(x y w h col)
    }

    fn pushBorder:void (dl:EVGDisplayList x:double y:double w:double h:double thickness:double col:EVGColor) {
        dl.addFrame(x y w h thickness col)
    }

    fn pushText:void (dl:EVGDisplayList text:string x:double y:double size:double col:EVGColor) {
        def w:double (ctx.tr.measureWidth(text size))
        def h:double (ctx.tr.lineHeight(size))
        dl.addText(text x y size col fontFamily false false w h)
    }

    ; Select the raster face. It must go through fontFamily: UITextRenderer
    ; re-applies the face from it on every measure and draw, so setting rt
    ; directly is undone by the next call.
    fn applyFace:void (bold:boolean) {
        this.applyFaceStyled(bold false)
    }

    fn applyFaceStyled:void (bold:boolean italic:boolean) {
        this.applyFaceNamed("" bold italic)
    }

    ; Map a workbook / menu font name onto a face we ship. Excel stand-ins
    ; (Calibri, Arial, …) have no TTF here, so each aliases to a distinct
    ; loaded family — otherwise picking them looks like a no-op.
    sfn faceFamily:string (name:string) {
        def n:string (to_lowercase (trim name))
        if ((strlen n) == 0) {
            return "Open Sans"
        }
        if (n == "open sans") {
            return "Open Sans"
        }
        if (n == "noto sans") {
            return "Noto Sans"
        }
        if ((n == "helvetica") || (n == "helvetica neue")) {
            return "Helvetica"
        }
        if ((n == "droid serif") || (n == "times new roman") || (n == "times") || (n == "georgia") || (n == "serif")) {
            return "Droid Serif"
        }
        if ((n == "josefin sans") || (n == "courier new") || (n == "courier") || (n == "consolas") || (n == "monospace")) {
            return "Josefin Sans"
        }
        if (n == "arial") {
            return "Noto Sans"
        }
        if ((n == "calibri") || (n == "candara") || (n == "segoe ui") || (n == "sans-serif")) {
            return "Open Sans"
        }
        return "Open Sans"
    }

    fn applyFaceNamed:void (name:string bold:boolean italic:boolean) {
        def base:string (GridView.faceFamily(name))
        def want:string base
        if bold {
            want = (base + "-Bold")
            if italic {
                want = (base + "-BoldItalic")
            }
        } {
            if italic {
                want = (base + "-Italic")
            }
        }
        if (ctx.tr.fontFamily == want) {
            return
        }
        def face:TrueTypeFont (ctx.tr.fm.getFont(want))
        if (face.unitsPerEm > 0) {
            ctx.tr.fontFamily = want
            ctx.tr.applyFace()
            return
        }
        ; Missing bold/italic variant: try the regular of that family, then
        ; Open Sans, rather than painting with a stale face.
        def fallback:TrueTypeFont (ctx.tr.fm.getFont(base))
        if (fallback.unitsPerEm > 0) {
            ctx.tr.fontFamily = base
            ctx.tr.applyFace()
            return
        }
        def os:string "Open Sans"
        if bold {
            os = "Open Sans-Bold"
            if italic {
                os = "Open Sans-BoldItalic"
            }
        } {
            if italic {
                os = "Open Sans-Italic"
            }
        }
        def oface:TrueTypeFont (ctx.tr.fm.getFont(os))
        if (oface.unitsPerEm > 0) {
            ctx.tr.fontFamily = os
            ctx.tr.applyFace()
        }
    }

    ; Text with per-cell face / weight / slant. `fontName` is the workbook
    ; name (or ""); painters read `c.fontFamily` (resolved base) so SoftCanvas
    ; and WebGL do not fall back to the view default.
    fn pushStyledText:void (dl:EVGDisplayList text:string x:double y:double size:double col:EVGColor fontName:string bold:boolean italic:boolean) {
        if ((strlen text) == 0) {
            return
        }
        this.applyFaceNamed(fontName bold italic)
        def w:double (ctx.tr.measureWidth(text size))
        def h:double (ctx.tr.lineHeight(size))
        dl.addText(text x y size col (GridView.faceFamily(fontName)) bold italic w h)
    }

    fn pushClip:void (dl:EVGDisplayList x:double y:double w:double h:double) {
        dl.addClip(x y w h)
    }

    fn popClip:void (dl:EVGDisplayList) {
        dl.addClipEnd()
    }

    fn colorOr:EVGColor (hex:string fallback:EVGColor) {
        if ((strlen hex) >= 4) {
            return (EVGColor.parse(hex))
        }
        return fallback
    }

    ; --- cell borders ---------------------------------------------------------
    ; One edge, honouring the OOXML line style: solid, dashed, dotted or double.
    ; Drawn as rects so it works on every EVG backend.
    fn pushEdge:void (dl:EVGDisplayList b:CellBorder x:int y:int len:int horizontal:boolean) {
        if ((b.has()) == false) {
            return
        }
        if (len <= 0) {
            return
        }
        def col:EVGColor (this.colorOr(b.rgb theme.gridLine))
        def w:int (b.width())
        def pat:int (b.pattern())
        if (pat == 3) {
            ; double: two hairlines with a gap
            if horizontal {
                this.pushRect(dl (to_double x) (to_double y) (to_double len) 1.0 col)
                this.pushRect(dl (to_double x) (to_double (y + 2)) (to_double len) 1.0 col)
            } {
                this.pushRect(dl (to_double x) (to_double y) 1.0 (to_double len) col)
                this.pushRect(dl (to_double (x + 2)) (to_double y) 1.0 (to_double len) col)
            }
            return
        }
        if (pat == 0) {
            if horizontal {
                this.pushRect(dl (to_double x) (to_double y) (to_double len) (to_double w) col)
            } {
                this.pushRect(dl (to_double x) (to_double y) (to_double w) (to_double len) col)
            }
            return
        }
        ; dashed / dotted: run of segments
        def on:int 4
        def off:int 3
        if (pat == 2) {
            on = 1
            off = 2
        }
        def at:int 0
        while (at < len) {
            def seg:int on
            if ((at + seg) > len) {
                seg = (len - at)
            }
            if horizontal {
                this.pushRect(dl (to_double (x + at)) (to_double y) (to_double seg) (to_double w) col)
            } {
                this.pushRect(dl (to_double x) (to_double (y + at)) (to_double w) (to_double seg) col)
            }
            at = (at + on + off)
        }
    }

    ; Where the text baseline row starts, honouring vertical alignment.
    ; Where the first line's BOX starts, for text of `lines` lines at `cellPx`.
    ;
    ; The subtlety is bottom alignment, which is Excel's default and which
    ; means the baseline sits just above the cell's floor — not the box. The
    ; box of a webfont is far taller than the letters in it, and almost all of
    ; that surplus is empty space above the capitals; a row is sized for the
    ; type, not for the face. Aligning boxes therefore pushed the letters
    ; through the floor of an ordinary row and the clip cut them off, which is
    ; how a faithfully-loaded sheet still came out looking wrong. Aligning the
    ; baseline puts the ink where the row was designed for it and lets the
    ; empty space fall outside the cell, where there is nothing to see — so
    ; the returned top may sit above `rect.y`, and is meant to.
    fn textTopFor:int (rect:GridRect st:CellStyle lineH:int lines:int cellPx:double) {
        def total:int (lineH * lines)
        if (st.valign == "top") {
            return (rect.y + 3)
        }
        if (st.valign == "center") {
            return (rect.y + (idiv (rect.h - total) 2))
        }
        ; Excel's default is bottom. Room under the baseline is a descender's
        ; worth of the type size — the letters that actually hang, not the
        ; face's full declared descent, which no Latin glyph reaches.
        def asc:double (ctx.tr.ascent(cellPx))
        def drop:double (cellPx * 0.21)
        def baseline:double ((((to_double rect.y) + (to_double rect.h)) - 2.0) - drop)
        def first:double ((baseline - asc) - (to_double (lineH * (lines - 1))))
        return (to_int first)
    }

    fn alignedX:double (rect:GridRect st:CellStyle textW:int) {
        if (st.align == "right") {
            return (to_double ((rect.x + rect.w) - textW - 4))
        }
        if (st.align == "center") {
            return (to_double (rect.x + (to_int ((to_double (rect.w - textW)) / 2.0))))
        }
        return (to_double (rect.x + 4))
    }

    fn paintDecoration:void (dl:EVGDisplayList st:CellStyle tx:double top:int textW:int cellPx:double col:EVGColor) {
        if st.underline {
            this.pushRect(dl tx (to_double (top + (to_int cellPx))) (to_double textW) 1.0 col)
        }
        if st.strike {
            this.pushRect(dl tx (to_double (top + (to_int (cellPx * 0.55)))) (to_double textW) 1.0 col)
        }
    }

    ; wrapText: break to the cell width and paint the lines that fit.
    fn paintWrapped:void (dl:EVGDisplayList txt:string rect:GridRect st:CellStyle cellPx:double col:EVGColor) {
        def avail:int (rect.w - 8)
        if (avail < 12) {
            avail = 12
        }
        def lines:[string] (ctx.tr.wrap(txt cellPx (to_double avail)))
        if ((array_length lines) == 0) {
            push lines txt
        }
        def lineH:int (to_int (ctx.tr.lineHeight(cellPx)))
        if (lineH < 8) {
            lineH = 8
        }
        def top:int (this.textTopFor(rect st lineH (array_length lines) cellPx))
        this.pushClip(dl (to_double rect.x) (to_double rect.y) (to_double rect.w) (to_double rect.h))
        def i:int 0
        while (i < (array_length lines)) {
            def line:string (itemAt lines i)
            def lw:int (to_int (ctx.tr.measureWidth(line cellPx)))
            def lx:double (this.alignedX(rect st lw))
            def ly:int (top + (i * lineH))
            this.pushStyledText(dl line lx (to_double ly) cellPx col st.fontName st.bold st.italic)
            this.paintDecoration(dl st lx ly lw cellPx col)
            i = (i + 1)
        }
        this.popClip(dl)
    }

    ; No wrap: Excel spills into EMPTY neighbours and stops at the first
    ; occupied one. This answers how far it may go in ONE direction, in pixels,
    ; not counting the cell itself.
    ;
    ; The walk starts past the cell's MERGE rather than at the next column.
    ; `rect` for a merged cell already covers every column the merge spans, so
    ; probing from `c + 1` would count those columns a second time and let the
    ; text run that much further than there is room for.
    fn spillRoom:int (model:SpreadsheetModel r:int c:int toRight:boolean) {
        def first:int c
        def last:int c
        def key:string (model.mergeAt(r c))
        if ((strlen key) > 0) {
            def parts:[string] (strsplit key ",")
            if ((array_length parts) >= 4) {
                first = (SpreadsheetModel.parseInt0((itemAt parts 1)))
                last = (SpreadsheetModel.parseInt0((itemAt parts 3)))
            }
        }
        def step:int 1
        def probe:int (last + 1)
        if (toRight == false) {
            step = -1
            probe = (first - 1)
        }
        def total:int 0
        def guard:int 0
        while (guard < 64) {
            if (probe < 0) {
                return total
            }
            if (probe >= model.colCount) {
                return total
            }
            if ((strlen (model.getCell(r probe))) > 0) {
                return total
            }
            ; A hidden column has no room in it to spill through.
            if ((model.isColHidden(probe)) == false) {
                total = (total + (model.colWidth(probe)))
            }
            probe = (probe + step)
            guard = (guard + 1)
        }
        return total
    }

    ; A turned label. The command carries the angle and every backend turns it
    ; about the command's own box centre, so the anchor is the middle of the
    ; text rather than a corner — which is also what makes a 90° header label
    ; sit in its column rather than beside it.
    fn pushRotatedText:void (dl:EVGDisplayList text:string cx:double cy:double size:double col:EVGColor fontName:string bold:boolean italic:boolean degrees:double) {
        if ((strlen text) == 0) {
            return
        }
        this.applyFaceNamed(fontName bold italic)
        def tw:double (ctx.tr.measureWidth(text size))
        def th:double (ctx.tr.lineHeight(size))
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 3
        c.x = (cx - (tw / 2.0))
        c.y = (cy - (th / 2.0))
        c.w = tw
        c.h = th
        c.text = text
        c.fontFamily = (GridView.faceFamily(fontName))
        c.fontSize = size
        c.rotate = degrees
        if bold {
            c.fontWeight = "bold"
        }
        if italic {
            c.textAlign = "italic"
        }
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push dl.cmds c
    }

    ; Vertical text: the letters stay upright and stack downwards, which is a
    ; different thing from a 90° turn and is how Excel's rotation 255 reads.
    fn paintStacked:void (dl:EVGDisplayList rect:GridRect st:CellStyle cellPx:double col:EVGColor txt:string) {
        def lineH:int (to_int (ctx.tr.lineHeight(cellPx)))
        if (lineH < 8) {
            lineH = 8
        }
        def n:int (strlen txt)
        def i:int 0
        def y:int (rect.y + 3)
        while (i < n) {
            if ((y + lineH) > (rect.y + rect.h)) {
                return
            }
            def ch:string (substring txt i (i + 1))
            def cw:int (to_int (ctx.tr.measureWidth(ch cellPx)))
            def x:int ((rect.x + (idiv rect.w 2)) - (idiv cw 2))
            this.pushStyledText(dl ch (to_double x) (to_double y) cellPx col st.fontName st.bold st.italic)
            y = (y + lineH)
            i = (i + 1)
        }
    }

    ; Text drawn in pieces. Each run is laid down at the x the one before it
    ; ended at, in its own face — which is why `styleOver` hands back a whole
    ; CellStyle: a run is painted exactly as a cell is, and only the walk is
    ; new. The whole string is aligned as one, so a centred cell of rich text
    ; is centred rather than each piece being centred separately.
    fn paintRuns:void (dl:EVGDisplayList rect:GridRect base:CellStyle cellPx:double baseCol:EVGColor rt:RichText) {
        def total:int 0
        def i:int 0
        while (i < (rt.count())) {
            def run:CellRun (itemAt rt.runs i)
            def rs:CellStyle (run.styleOver(base))
            def px:double (this.sizeOf(rs cellPx))
            this.applyFaceNamed(rs.fontName rs.bold rs.italic)
            total = (total + (to_int (ctx.tr.measureWidth(run.text px))))
            i = (i + 1)
        }
        def lineH:int (to_int (ctx.tr.lineHeight(cellPx)))
        if (lineH < 8) {
            lineH = 8
        }
        def top:int (this.textTopFor(rect base lineH 1 cellPx))
        def x:double (this.alignedX(rect base total))
        def k:int 0
        while (k < (rt.count())) {
            def run2:CellRun (itemAt rt.runs k)
            def rs2:CellStyle (run2.styleOver(base))
            def px2:double (this.sizeOf(rs2 cellPx))
            def runCol:EVGColor baseCol
            if ((strlen rs2.textRgb) >= 4) {
                runCol = (EVGColor.parse(rs2.textRgb))
            }
            this.applyFaceNamed(rs2.fontName rs2.bold rs2.italic)
            def w:int (to_int (ctx.tr.measureWidth(run2.text px2)))
            ; Runs of different sizes sit on one baseline rather than one top,
            ; which is what makes a smaller suffix look attached to the word
            ; before it instead of floating above it.
            def runTop:int (top + (to_int (ctx.tr.lineHeight(cellPx))) - (to_int (ctx.tr.lineHeight(px2))))
            this.pushStyledText(dl run2.text x (to_double runTop) px2 runCol rs2.fontName rs2.bold rs2.italic)
            this.paintDecoration(dl rs2 x runTop w px2 runCol)
            x = (x + (to_double w))
            k = (k + 1)
        }
    }

    ; A run's point size in pixels, falling back to the cell's.
    fn sizeOf:double (st:CellStyle fallback:double) {
        if (st.fontSizePt > 0.0) {
            def px:double ((st.fontSizePt * 96.0) / 72.0)
            if (px < 6.0) {
                return 6.0
            }
            return px
        }
        return fallback
    }

    fn paintSingleLine:void (dl:EVGDisplayList model:SpreadsheetModel rect:GridRect st:CellStyle cellPx:double col:EVGColor txt:string r:int c:int) {
        if (model.hasRichText(r c)) {
            def rt:RichText (model.richTextAt(r c))
            this.pushClip(dl (to_double rect.x) (to_double rect.y) (to_double rect.w) (to_double rect.h))
            this.paintRuns(dl rect st cellPx col rt)
            this.popClip(dl)
            return
        }
        if (st.isStacked()) {
            this.pushClip(dl (to_double rect.x) (to_double rect.y) (to_double rect.w) (to_double rect.h))
            this.paintStacked(dl rect st cellPx col txt)
            this.popClip(dl)
            return
        }
        def turn:double (st.rotationDegrees())
        if (turn != 0.0) {
            ; A turned label is not allowed to spill: it is clipped to its own
            ; cell, because the room it would need is in two directions at once.
            this.pushClip(dl (to_double rect.x) (to_double rect.y) (to_double rect.w) (to_double rect.h))
            def ccx:double ((to_double rect.x) + ((to_double rect.w) / 2.0))
            def ccy:double ((to_double rect.y) + ((to_double rect.h) / 2.0))
            this.pushRotatedText(dl txt ccx ccy cellPx col st.fontName st.bold st.italic turn)
            this.popClip(dl)
            return
        }
        this.paintFlatLine(dl model rect st cellPx col txt r c)
    }

    fn paintFlatLine:void (dl:EVGDisplayList model:SpreadsheetModel rect:GridRect st:CellStyle cellPx:double col:EVGColor txt:string r:int c:int) {
        def textW:int (to_int (ctx.tr.measureWidth(txt cellPx)))
        def lineH:int (to_int (ctx.tr.lineHeight(cellPx)))
        if (lineH < 8) {
            lineH = 8
        }
        def top:int (this.textTopFor(rect st lineH 1 cellPx))
        def tx:double (this.alignedX(rect st textW))
        ; Room the text may use: its own cell, plus any empty neighbours in the
        ; direction it actually grows — which depends on the alignment, and for
        ; a centred label is BOTH. A centred label used to be given room only
        ; to the right while its text started to the left of its own cell, so
        ; the half that overhung was cut even where the neighbour was empty.
        def clipX:int rect.x
        def clipW:int rect.w
        if ((textW + 8) > rect.w) {
            def wantsLeft:boolean false
            def wantsRight:boolean false
            if (st.align == "right") {
                wantsLeft = true
            } {
                if (st.align == "center") {
                    wantsLeft = true
                    wantsRight = true
                } {
                    wantsRight = true
                }
            }
            if wantsLeft {
                def leftRoom:int (this.spillRoom(model r c false))
                clipX = (clipX - leftRoom)
                clipW = (clipW + leftRoom)
            }
            if wantsRight {
                clipW = (clipW + (this.spillRoom(model r c true)))
            }
        }
        this.pushClip(dl (to_double clipX) (to_double rect.y) (to_double clipW) (to_double rect.h))
        this.pushStyledText(dl txt tx (to_double top) cellPx col st.fontName st.bold st.italic)
        this.paintDecoration(dl st tx top textW cellPx col)
        this.popClip(dl)
    }

    fn paintCellBorders:void (dl:EVGDisplayList st:CellStyle rect:GridRect) {
        if (st.hasBorder == false) {
            return
        }
        this.pushEdge(dl st.borderTop rect.x rect.y rect.w true)
        this.pushEdge(dl st.borderBottom rect.x ((rect.y + rect.h) - (st.borderBottom.width())) rect.w true)
        this.pushEdge(dl st.borderLeft rect.x rect.y rect.h false)
        this.pushEdge(dl st.borderRight ((rect.x + rect.w) - (st.borderRight.width())) rect.y rect.h false)
    }

    fn paintCell:void (dl:EVGDisplayList model:SpreadsheetModel sel:GridSelection grid:DataGrid editing:boolean editBuf:string r:int c:int) {
        if (model.isMergeOrigin(r c) == false) {
            return
        }
        def rect:GridRect (grid.cellRect(model r c))
        if ((rect.x < -50000) || (rect.y < -50000)) {
            return
        }
        def st:CellStyle (model.getCellStyle(r c))
        def cfFill:string (ConditionalFormat.resolveFill(model r c))
        if ((strlen cfFill) > 0) {
            def cfBg:EVGColor (EVGColor.parse(cfFill))
            this.pushRect(dl (to_double rect.x) (to_double rect.y) (to_double rect.w) (to_double rect.h) cfBg)
        } {
            if st.hasFill {
                def bg:EVGColor (this.colorOr(st.fillRgb theme.bg))
                this.pushRect(dl (to_double rect.x) (to_double rect.y) (to_double rect.w) (to_double rect.h) bg)
            }
        }
        if editing {
            if ((r == sel.active.row) && (c == sel.active.col)) {
                this.pushRect(dl (to_double rect.x) (to_double rect.y) (to_double rect.w) (to_double rect.h) theme.editBg)
            }
        }
        def txt:string (model.getDisplay(r c))
        if editing {
            if ((r == sel.active.row) && (c == sel.active.col)) {
                txt = editBuf
            }
        }
        ; A cell that links somewhere says so the way every document does: in
        ; the link colour, underlined. The style's own colour is overridden,
        ; because a link that looks like text is not a link.
        def linked:boolean (model.hasHyperlink(r c))
        if ((strlen txt) > 0) {
            def col:EVGColor theme.cellText
            if ((strlen st.textRgb) >= 4) {
                col = (EVGColor.parse(st.textRgb))
            }
            if linked {
                col = theme.linkText
            }
            ; Cell font size comes from the style (pt → px), bold / italic ride
            ; on the draw command so both backends can honour them.
            def cellPx:double fontSize
            if (st.fontSizePt > 0.0) {
                cellPx = ((st.fontSizePt * 96.0) / 72.0)
            }
            if (cellPx < 6.0) {
                cellPx = 6.0
            }
            this.applyFaceNamed(st.fontName st.bold st.italic)
            def paintStyle:CellStyle st
            if linked {
                paintStyle = (st.copy())
                paintStyle.underline = true
            }
            def formulaEdit:boolean false
            if editing {
                if ((r == sel.active.row) && (c == sel.active.col)) {
                    if ((strlen editBuf) > 0) {
                        if ((charAt editBuf 0) == 61) {
                            formulaEdit = true
                        }
                    }
                }
            }
            if formulaEdit {
                ; A formula being typed is drawn by the syntax painter so its
                ; references keep their colours — but it is still text in a
                ; cell, and it sits where the cell's text sits. `rect.y + 3`
                ; put it four pixels below its own line and the cell's clip
                ; then cut the bottom off every letter.
                def editLineH:int (to_int (ctx.tr.lineHeight(cellPx)))
                if (editLineH < 8) {
                    editLineH = 8
                }
                def editTop:int (this.textTopFor(rect st editLineH 1 cellPx))
                editTextX = (rect.x + 4)
                editTextY = editTop
                editTextPx = cellPx
                if (caretInFormulaBar == false) {
                    this.paintTextSelection(dl txt (rect.x + 4) editTop cellPx editLineH)
                }
                this.paintFormulaBarText(dl txt (rect.x + 4) editTop cellPx)
            } {
                editTextX = (rect.x + 4)
                editTextPx = cellPx
                def plainLineH:int (to_int (ctx.tr.lineHeight(cellPx)))
                if (plainLineH < 8) {
                    plainLineH = 8
                }
                editTextY = (this.textTopFor(rect paintStyle plainLineH 1 cellPx))
                if st.wrapText {
                    this.paintWrapped(dl txt rect paintStyle cellPx col)
                } {
                    this.paintSingleLine(dl model rect paintStyle cellPx col txt r c)
                }
            }
        }
        ; A note is marked rather than shown: the text would cover the numbers
        ; it is about. The corner triangle is the mark every spreadsheet uses.
        if (model.hasNote(r c)) {
            def mk:int 6
            def mx:int ((rect.x + rect.w) - (mk + 1))
            def my:int (rect.y + 1)
            def step:int 0
            while (step < mk) {
                this.pushRect(dl (to_double (mx + step)) (to_double my) (to_double (mk - step)) 1.0 theme.noteMark)
                my = (my + 1)
                step = (step + 1)
            }
        }
    }

    ; The borders a CELL carries, as their own pass.
    ;
    ; They used to be drawn at the end of `paintCell`, which put them under the
    ; body gridlines: the vertical rule sits at `x + w - 1` and the horizontal
    ; one at `y + h - 1`, which is exactly where a cell's right and bottom
    ; borders go. So every bordered cell in every workbook showed its top and
    ; left edge and had the other two painted over in pale grey — which is why
    ; "All borders" on a single cell looked like it had done nothing.
    ;
    ; r0..r1 / c0..c1 are VIEW indices, like `paintCellRange`.
    fn paintBordersRange:void (dl:EVGDisplayList model:SpreadsheetModel grid:DataGrid r0:int r1:int c0:int c1:int) {
        if (r1 < r0) {
            return
        }
        if (c1 < c0) {
            return
        }
        def r:int r0
        while (r <= r1) {
            def c:int c0
            while (c <= c1) {
                def mr:int (grid.mapRow(r))
                def mc:int (grid.mapCol(c))
                if (model.isMergeOrigin(mr mc)) {
                    def st:CellStyle (model.getCellStyle(mr mc))
                    if st.hasBorder {
                        def rect:GridRect (grid.cellRect(model mr mc))
                        if (rect.x > -50000) {
                            if (rect.y > -50000) {
                                this.paintCellBorders(dl st rect)
                            }
                        }
                    }
                }
                c = (c + 1)
            }
            r = (r + 1)
        }
    }

    ; The same four bands `buildDisplayList` paints cells in, for borders.
    fn paintBordersBands:void (dl:EVGDisplayList model:SpreadsheetModel grid:DataGrid fzR:int fzC:int) {
        if (fzR > 0) {
            if (fzC > 0) {
                this.paintBordersRange(dl model grid 0 (fzR - 1) 0 (fzC - 1))
            }
            this.paintBordersRange(dl model grid 0 (fzR - 1) grid.firstScrollCol grid.lastScrollCol)
        }
        if (fzC > 0) {
            this.paintBordersRange(dl model grid grid.firstScrollRow grid.lastScrollRow 0 (fzC - 1))
        }
        this.paintBordersRange(dl model grid grid.firstScrollRow grid.lastScrollRow grid.firstScrollCol grid.lastScrollCol)
    }

    ; r0..r1 / c0..c1 are VIEW indices when grid.hasView.
    fn paintCellRange:void (dl:EVGDisplayList model:SpreadsheetModel sel:GridSelection grid:DataGrid editing:boolean editBuf:string r0:int r1:int c0:int c1:int) {
        if (r1 < r0) {
            return
        }
        if (c1 < c0) {
            return
        }
        def r:int r0
        while (r <= r1) {
            def c:int c0
            while (c <= c1) {
                def mr:int (grid.mapRow(r))
                def mc:int (grid.mapCol(c))
                this.paintCell(dl model sel grid editing editBuf mr mc)
                c = (c + 1)
            }
            r = (r + 1)
        }
    }

    ; Column letter band. Painted once before the body and again after, so any
    ; cell / row-number ink that ignored clip cannot sit on top of the letters.
    sfn colMenuArrowW:int () {
        return 16
    }

    fn paintColHeaders:void (dl:EVGDisplayList model:SpreadsheetModel grid:DataGrid bodyLeft:int headerTop:int vw:int) {
        this.pushRect(dl (to_double bodyLeft) (to_double headerTop) (to_double vw) (to_double grid.colHeaderH) theme.headerBg)
        this.pushClip(dl (to_double bodyLeft) (to_double headerTop) (to_double vw) (to_double grid.colHeaderH))
        def hc:int grid.firstVisibleCol
        while (hc <= grid.lastVisibleCol) {
            def mc:int (grid.mapCol(hc))
            def hx:int (grid.viewColScreenX(model hc))
            def label:string (SpreadsheetModel.colLabel(mc))
            ; A sort moves the data now, so the view is not sorting anything
            ; — but the header still says which column was put in order, and
            ; which way, because that is what the person did.
            if (model.sortedCol == mc) {
                if model.sortedAsc {
                    label = (label + " ^")
                } {
                    label = (label + " v")
                }
            }
            if ((model.filterEnabled) && (model.filterCol == mc)) {
                label = (label + " [#]")
            }
            def cw:int (model.colWidth(mc))
            def aw:int (GridView.colMenuArrowW())
            def lw:int (to_int (ctx.tr.measureWidth(label (fontSize * 0.9))))
            def labelW:int (cw - aw)
            if (labelW < 1) {
                labelW = 1
            }
            def lx:int (hx + (to_int ((to_double (labelW - lw)) / 2.0)))
            this.pushText(dl label (to_double lx) (to_double (headerTop + 4)) (fontSize * 0.9) theme.headerText)
            ; Always-visible dropdown target: clicking the letter selects data,
            ; clicking this arrow opens the existing sort/filter menu.
            def ax:int ((hx + cw) - aw)
            this.pushRect(dl (to_double ax) (to_double headerTop) 1.0 (to_double grid.colHeaderH) theme.gridLine)
            def triY:int (headerTop + (idiv grid.colHeaderH 2))
            def triW:int 7
            def triX:int (ax + (idiv (aw - triW) 2))
            def ti:int 0
            while (ti < 4) {
                this.pushRect(dl (to_double (triX + ti)) (to_double (triY + ti)) (to_double (triW - (ti * 2))) 1.0 theme.headerText)
                ti = (ti + 1)
            }
            this.pushRect(dl (to_double (hx + cw - 1)) (to_double headerTop) 1.0 (to_double grid.colHeaderH) theme.gridLine)
            hc = (hc + 1)
        }
        this.popClip(dl)
    }

    ; The status bar's chart button. Static so the hit test and the paint read
    ; the same rectangle rather than two copies of it.
    sfn chartButtonW:int () {
        return 68
    }

    ; Soft fills / borders cycling through Excel-like formula-ref colours.
    ; Yellow and green lead so a single SUM range reads clearly on white cells.
    sfn formulaHiliteFill:EVGColor (i:int) {
        def k:int (i - ((idiv i 6) * 6))
        if (k == 0) {
            return (EVGColor.rgba(240 190 40 0.38))
        }
        if (k == 1) {
            return (EVGColor.rgba(50 170 90 0.32))
        }
        if (k == 2) {
            return (EVGColor.rgba(90 130 230 0.30))
        }
        if (k == 3) {
            return (EVGColor.rgba(170 80 200 0.28))
        }
        if (k == 4) {
            return (EVGColor.rgba(30 160 160 0.28))
        }
        return (EVGColor.rgba(210 70 90 0.28))
    }

    sfn formulaHiliteEdge:EVGColor (i:int) {
        def k:int (i - ((idiv i 6) * 6))
        if (k == 0) {
            return (EVGColor.rgb(200 150 20))
        }
        if (k == 1) {
            return (EVGColor.rgb(30 140 60))
        }
        if (k == 2) {
            return (EVGColor.rgb(40 100 210))
        }
        if (k == 3) {
            return (EVGColor.rgb(130 50 170))
        }
        if (k == 4) {
            return (EVGColor.rgb(20 140 140))
        }
        return (EVGColor.rgb(180 50 70))
    }

    fn paintFormulaGrip:void (dl:EVGDisplayList x:int y:int hs:int edge:EVGColor) {
        this.pushRect(dl (to_double x) (to_double y) (to_double hs) (to_double hs) (EVGColor.rgb(255 255 255)))
        this.pushBorder(dl (to_double x) (to_double y) (to_double hs) (to_double hs) 1.0 edge)
        this.pushRect(dl (to_double (x + 2)) (to_double (y + 2)) (to_double (hs - 4)) (to_double (hs - 4)) edge)
    }

    sfn chartButtonH:int () {
        return 17
    }

    sfn chartButtonX:int (pageW:int) {
        def bw:int (GridView.chartButtonW())
        return (pageW - (bw + 8))
    }

    ; Custom tool buttons, laid out leftwards from the chart button.
    sfn toolButtonW:int () {
        return 84
    }

    sfn toolButtonX:int (pageW:int index:int) {
        def bw:int (GridView.toolButtonW())
        def base:int (GridView.chartButtonX(pageW))
        return ((base - ((index + 1) * (bw + 6))))
    }

    sfn chartButtonY:int (statusTop:int) {
        return (statusTop + 2)
    }

    ; How many characters of an A1 / $A$1 / A1:B2 token start at `at`, or 0.
    sfn formulaRefLen:int (src:string at:int) {
        def n:int (strlen src)
        if (at >= n) {
            return 0
        }
        def i:int at
        def sawCol:boolean false
        def sawRow:boolean false
        if ((charAt src i) == 36) {
            i = (i + 1)
        }
        while (i < n) {
            def ch:int (charAt src i)
            if (((ch >= 65) && (ch <= 90)) || ((ch >= 97) && (ch <= 122))) {
                sawCol = true
                i = (i + 1)
            } {
                break
            }
        }
        if (i < n) {
            if ((charAt src i) == 36) {
                i = (i + 1)
            }
        }
        while (i < n) {
            def ch2:int (charAt src i)
            if ((ch2 >= 48) && (ch2 <= 57)) {
                sawRow = true
                i = (i + 1)
            } {
                break
            }
        }
        if ((sawCol == false) || (sawRow == false)) {
            return 0
        }
        if (i < n) {
            if ((charAt src i) == 58) {
                def j:int (i + 1)
                def sawCol2:boolean false
                def sawRow2:boolean false
                if (j < n) {
                    if ((charAt src j) == 36) {
                        j = (j + 1)
                    }
                }
                while (j < n) {
                    def ch3:int (charAt src j)
                    if (((ch3 >= 65) && (ch3 <= 90)) || ((ch3 >= 97) && (ch3 <= 122))) {
                        sawCol2 = true
                        j = (j + 1)
                    } {
                        break
                    }
                }
                if (j < n) {
                    if ((charAt src j) == 36) {
                        j = (j + 1)
                    }
                }
                while (j < n) {
                    def ch4:int (charAt src j)
                    if ((ch4 >= 48) && (ch4 <= 57)) {
                        sawRow2 = true
                        j = (j + 1)
                    } {
                        break
                    }
                }
                if sawCol2 {
                    if sawRow2 {
                        i = j
                    }
                }
            }
        }
        return (i - at)
    }

    ; Draw formula-bar text with each A1 / range tinted to match its overlay.
    ; The band behind selected text. Measured, not counted: proportional type
    ; means the fifth character is not five character-widths in.
    fn paintTextSelection:void (dl:EVGDisplayList text:string x:int y:int size:double h:int) {
        if (editSelA < 0) {
            return
        }
        if (editSelB <= editSelA) {
            return
        }
        def n:int (strlen text)
        def a:int editSelA
        def b:int editSelB
        if (a > n) {
            a = n
        }
        if (b > n) {
            b = n
        }
        if (b <= a) {
            return
        }
        this.applyFaceNamed("" false false)
        def x0:int (to_int (ctx.tr.measureWidth((substring text 0 a) size)))
        def x1:int (to_int (ctx.tr.measureWidth((substring text 0 b) size)))
        def w:int (x1 - x0)
        if (w < 1) {
            return
        }
        this.pushRect(dl (to_double (x + x0)) (to_double y) (to_double w) (to_double h) theme.selection)
    }

    fn paintFormulaBarText:void (dl:EVGDisplayList text:string x:int y:int size:double) {
        if ((strlen text) == 0) {
            return
        }
        if ((array_length formulaHiliteR0) == 0) {
            this.pushText(dl text (to_double x) (to_double y) size theme.formulaText)
            return
        }
        def i:int 0
        def n:int (strlen text)
        def hi:int 0
        def xCursor:double (to_double x)
        def plain:string ""
        while (i < n) {
            def refLen:int (GridView.formulaRefLen(text i))
            if (refLen > 0) {
                if ((strlen plain) > 0) {
                    this.pushText(dl plain xCursor (to_double y) size theme.formulaText)
                    xCursor = (xCursor + (ctx.tr.measureWidth(plain size)))
                    plain = ""
                }
                def tok:string (substring text i (i + refLen))
                def col:EVGColor theme.formulaText
                if (hi < (array_length formulaHiliteR0)) {
                    col = (GridView.formulaHiliteEdge(hi))
                    hi = (hi + 1)
                }
                this.pushText(dl tok xCursor (to_double y) size col)
                xCursor = (xCursor + (ctx.tr.measureWidth(tok size)))
                i = (i + refLen)
            } {
                plain = (plain + (substring text i (i + 1)))
                i = (i + 1)
            }
        }
        if ((strlen plain) > 0) {
            this.pushText(dl plain xCursor (to_double y) size theme.formulaText)
        }
    }

    ; A window carries its own EVGWindowTheme and the dialogs are built lazily,
    ; so tinting them once when the theme changes would miss every dialog that
    ; had not been opened yet. Watching the palette's revision AND the manager's
    ; ever-added count catches both, and costs two integer compares a frame.
    fn syncWindowTheme:void () {
        if (themedRevision == theme.revision) {
            if (themedWindows == windows.added) {
                return
            }
        }
        themedRevision = theme.revision
        themedWindows = windows.added
        def n:int (array_length windows.windows)
        def i:int 0
        while (i < n) {
            def wnd:EVGWindow (itemAt windows.windows i)
            theme.tintWindow(wnd.theme)
            i = (i + 1)
        }
    }

    fn buildDisplayList:EVGDisplayList (model:SpreadsheetModel sel:GridSelection grid:DataGrid editing:boolean editBuf:string book:WorkbookModel) {
        grid.updateVisible(model)
        this.syncWindowTheme()
        def dl:EVGDisplayList (new EVGDisplayList)

        this.pushRect(dl 0.0 0.0 (to_double pageW) (to_double pageH) theme.bg)

        ; --- toolbar ---
        if (grid.toolbarH > 0) {
            this.paintToolbar(dl model sel grid)
        }

        ; --- formula bar ---
        ; Grey chrome + white name/formula inputs (Excel-style). The field used
        ; to share formulaBg with the bar, so it read as a static label.
        def fbY:int (grid.formulaBarY())
        this.pushRect(dl (to_double grid.x) (to_double fbY) (to_double grid.w) (to_double grid.formulaBarH) theme.statusBg)
        def addr:string (SpreadsheetModel.cellLabel(sel.active.row sel.active.col))
        def shown:string (model.formulaBarText(sel.active.row sel.active.col))
        if editing {
            shown = editBuf
        }
        def formulaEdit:boolean false
        if editing {
            if ((strlen editBuf) > 0) {
                if ((charAt editBuf 0) == 61) {
                    formulaEdit = true
                }
            }
        }
        caretInFormulaBar = false
        if editing {
            if editInFormulaBar {
                caretInFormulaBar = true
            }
            if formulaEdit {
                caretInFormulaBar = true
            }
        }
        def addrBoxW:int 64
        def addrX:int (grid.x + 4)
        def fieldX:int ((grid.x + addrBoxW) + 10)
        def fieldW:int ((grid.w - addrBoxW) - 18)
        def fieldY:int (fbY + 3)
        def fieldH:int (grid.formulaBarH - 6)
        def nameEdge:EVGColor theme.gridLine
        def fieldEdge:EVGColor (EVGColor.rgb(160 170 185))
        if editing {
            fieldEdge = theme.activeBorder
            if editInFormulaBar {
                nameEdge = theme.activeBorder
            }
        }
        this.pushRect(dl (to_double addrX) (to_double fieldY) (to_double addrBoxW) (to_double fieldH) (EVGColor.rgb(255 255 255)))
        this.pushBorder(dl (to_double addrX) (to_double fieldY) (to_double addrBoxW) (to_double fieldH) 1.0 nameEdge)
        this.pushText(dl addr (to_double (addrX + 6)) (to_double (fieldY + 3)) 12.0 theme.headerText)
        this.pushRect(dl (to_double fieldX) (to_double fieldY) (to_double fieldW) (to_double fieldH) (EVGColor.rgb(255 255 255)))
        this.pushBorder(dl (to_double fieldX) (to_double fieldY) (to_double fieldW) (to_double fieldH) 1.0 fieldEdge)
        fbFieldX = fieldX
        fbFieldY = fieldY
        fbFieldW = fieldW
        fbFieldH = fieldH
        fbTextX = (fieldX + 6)
        fbTextY = (fieldY + 3)
        fbFontSize = 13.0
        if caretInFormulaBar {
            this.paintTextSelection(dl shown (fieldX + 6) (fieldY + 3) 13.0 (fieldH - 6))
        }
        this.paintFormulaBarText(dl shown (fieldX + 6) (fieldY + 3) 13.0)
        ; Formula edits always put the solid caret here, even when editing was
        ; entered from the cell (F2 / typing). There must be only one caret.
        if caretInFormulaBar {
            def upTo:string shown
            def cn:int (strlen shown)
            if (editCaret < cn) {
                def cc:int editCaret
                if (cc < 0) {
                    cc = 0
                }
                upTo = (substring shown 0 cc)
            }
            def ew:int (to_int (ctx.tr.measureWidth(upTo 13.0)))
            ; One pixel of visual gap keeps the caret after, not over, a glyph.
            def caretX:int (((fieldX + 6) + ew) + 1)
            this.pushRect(dl (to_double caretX) (to_double (fieldY + 3)) 2.0 (to_double (fieldH - 6)) theme.activeBorder)
        }
        this.pushBorder(dl (to_double grid.x) (to_double fbY) (to_double grid.w) (to_double grid.formulaBarH) 1.0 theme.gridLine)

        def headerTop:int (grid.headerTop())
        def bodyLeft:int (grid.x + grid.rowHeaderW)
        def bodyTop:int (headerTop + grid.colHeaderH)
        def vw:int (grid.viewportW())
        def vh:int (grid.viewportH())

        ; corner
        this.pushRect(dl (to_double grid.x) (to_double headerTop) (to_double grid.rowHeaderW) (to_double grid.colHeaderH) theme.cornerBg)

        ; column headers (VIEW cols → MODEL labels; ▼ when filter/sort active)
        this.paintColHeaders(dl model grid bodyLeft headerTop vw)

        ; row headers — show MODEL row numbers
        this.pushRect(dl (to_double grid.x) (to_double bodyTop) (to_double grid.rowHeaderW) (to_double vh) theme.headerBg)
        this.pushClip(dl (to_double grid.x) (to_double bodyTop) (to_double grid.rowHeaderW) (to_double vh))
        def hr2:int grid.firstVisibleRow
        while (hr2 <= grid.lastVisibleRow) {
            def mr:int (grid.mapRow(hr2))
            def rr:GridRect (grid.cellRect(model mr 0))
            def num:string (to_string (mr + 1))
            def rh:int (model.rowHeight(mr))
            ; Skip labels fully outside the body band — backends that ignore
            ; clip commands would otherwise paint them over the col headers
            ; or sheet tabs.
            def bandBot:int (bodyTop + vh)
            if ((rr.y + rh) > bodyTop) {
                if (rr.y < bandBot) {
                    def nw:int (to_int (ctx.tr.measureWidth(num (fontSize * 0.85))))
                    def nx:int ((grid.x + grid.rowHeaderW) - nw - 6)
                    this.pushText(dl num (to_double nx) (to_double (rr.y + 3)) (fontSize * 0.85) theme.headerText)
                    this.pushRect(dl (to_double grid.x) (to_double (rr.y + rh - 1)) (to_double grid.rowHeaderW) 1.0 theme.gridLine)
                }
            }
            hr2 = (hr2 + 1)
        }
        this.popClip(dl)

        ; body: backgrounds + text + gridlines (visible cells only)
        this.pushClip(dl (to_double bodyLeft) (to_double bodyTop) (to_double vw) (to_double vh))
        this.pushRect(dl (to_double bodyLeft) (to_double bodyTop) (to_double vw) (to_double vh) theme.bg)

        ; FortuneSheet-style freeze: four bands (corner / frozen rows / frozen cols / scroll)
        ; Ranges are VIEW indices when SheetView is bound.
        def fzR:int (grid.freezeViewRows(model))
        def fzC:int (grid.freezeViewCols(model))
        if (fzR > 0) {
            if (fzC > 0) {
                this.paintCellRange(dl model sel grid editing editBuf 0 (fzR - 1) 0 (fzC - 1))
            }
            this.paintCellRange(dl model sel grid editing editBuf 0 (fzR - 1) grid.firstScrollCol grid.lastScrollCol)
        }
        if (fzC > 0) {
            this.paintCellRange(dl model sel grid editing editBuf grid.firstScrollRow grid.lastScrollRow 0 (fzC - 1))
        }
        this.paintCellRange(dl model sel grid editing editBuf grid.firstScrollRow grid.lastScrollRow grid.firstScrollCol grid.lastScrollCol)

        ; vertical grid lines (scrollable + frozen) — VIEW indices
        def vc:int 0
        def vcLast:int grid.lastScrollCol
        while (vc <= vcLast) {
            def mc2:int (grid.mapCol(vc))
            def vr:GridRect (grid.cellRect(model (grid.mapRow(grid.firstScrollRow)) mc2))
            if (vc < fzC) {
                vr = (grid.cellRect(model (grid.mapRow(0)) mc2))
            }
            def cw2:int (model.colWidth(mc2))
            this.pushRect(dl (to_double (vr.x + cw2 - 1)) (to_double bodyTop) 1.0 (to_double vh) theme.gridLine)
            vc = (vc + 1)
        }
        def vr2:int 0
        def vrLast:int grid.lastScrollRow
        while (vr2 <= vrLast) {
            def mr2:int (grid.mapRow(vr2))
            def rr2:GridRect (grid.cellRect(model mr2 (grid.mapCol(grid.firstScrollCol))))
            if (vr2 < fzR) {
                rr2 = (grid.cellRect(model mr2 (grid.mapCol(0))))
            }
            def rh2:int (model.rowHeight(mr2))
            this.pushRect(dl (to_double bodyLeft) (to_double (rr2.y + rh2 - 1)) (to_double vw) 1.0 theme.gridLine)
            vr2 = (vr2 + 1)
        }

        ; Cell borders go OVER the gridlines they replace.
        this.paintBordersBands(dl model grid fzR fzC)

        ; freeze separators
        if (fzC > 0) {
            def fx:int ((bodyLeft + (grid.geoFrozenW(model))) - 1)
            this.pushRect(dl (to_double fx) (to_double bodyTop) 2.0 (to_double vh) theme.activeBorder)
        }
        if (fzR > 0) {
            def fy:int ((bodyTop + (grid.geoFrozenH(model))) - 1)
            this.pushRect(dl (to_double bodyLeft) (to_double fy) (to_double vw) 2.0 theme.activeBorder)
        }

        ; Pictures sit over the cells and under the selection: they are part of
        ; the document, not of the chrome. Clipped to the body so one anchored
        ; near the edge does not paint over the headers.
        def imgI:int 0
        while (imgI < (model.imageCount())) {
            def si:SheetImage (model.imageAt(imgI))
            def ir:GridRect (GridImages.rectFor(model grid si))
            def visible:boolean true
            if ((ir.x + ir.w) < bodyLeft) {
                visible = false
            }
            if ((ir.y + ir.h) < bodyTop) {
                visible = false
            }
            if (ir.x > (bodyLeft + vw)) {
                visible = false
            }
            if (ir.y > (bodyTop + vh)) {
                visible = false
            }
            if visible {
                ; Decoded on first sight and cached by part name, so scrolling
                ; past a picture costs a blit rather than a PNG decode.
                images.decode(si.src (si.kind()) si.bytes)
                this.pushClip(dl (to_double bodyLeft) (to_double bodyTop) (to_double vw) (to_double vh))
                GridImages.pushImageCmd(dl ir si.src)
                this.popClip(dl)
            }
            imgI = (imgI + 1)
        }

        ; Selection overlay: one cheap rect per rectangle, clipped to the
        ; viewport. A Ctrl+click selection is several rectangles, and each is
        ; painted the same way — there is no per-cell pass.
        def selIdx:int 0
        while (selIdx < (sel.rangeCount())) {
            def g:GridRange (sel.rangeAt(selIdx))
            def live:boolean (selIdx == ((sel.rangeCount()) - 1))
            def skip:boolean false
            if live {
                if (sel.isSingle()) {
                    if ((sel.isDisjoint()) == false) {
                        skip = true
                    }
                }
            }
            if (skip == false) {
                def tl:GridRect (grid.cellRect(model g.r0 g.c0))
                def br:GridRect (grid.cellRect(model g.r1 g.c1))
                def sx:int tl.x
                def sy:int tl.y
                def sw:int ((br.x + br.w) - tl.x)
                def sh:int ((br.y + br.h) - tl.y)
                if (sx < bodyLeft) {
                    sw = (sw - (bodyLeft - sx))
                    sx = bodyLeft
                }
                if (sy < bodyTop) {
                    sh = (sh - (bodyTop - sy))
                    sy = bodyTop
                }
                if ((sx + sw) > (bodyLeft + vw)) {
                    sw = ((bodyLeft + vw) - sx)
                }
                if ((sy + sh) > (bodyTop + vh)) {
                    sh = ((bodyTop + vh) - sy)
                }
                if ((sw > 0) && (sh > 0)) {
                    this.pushRect(dl (to_double sx) (to_double sy) (to_double sw) (to_double sh) theme.selection)
                }
            }
            selIdx = (selIdx + 1)
        }

        ; The active cell's note, shown beside it. A marker alone tells you a
        ; note exists and not what it says; a hover tooltip needs a hover state
        ; this input layer does not have. The selected cell is the one you are
        ; asking about, so that is the one whose note is opened.
        if (model.hasNote(sel.active.row sel.active.col)) {
            def noteText:string (model.noteAt(sel.active.row sel.active.col))
            def nr:GridRect (grid.cellRect(model sel.active.row sel.active.col))
            def boxW:int 210
            def nx:int (nr.x + nr.w + 6)
            if ((nx + boxW) > (bodyLeft + vw)) {
                nx = ((nr.x - boxW) - 6)
            }
            if (nx < bodyLeft) {
                nx = bodyLeft
            }
            def lines:[string] (ctx.tr.wrap(noteText 12.0 (to_double (boxW - 16))))
            def lineH:int (to_int (ctx.tr.lineHeight(12.0)))
            def boxH:int (((array_length lines) * lineH) + 12)
            def ny:int nr.y
            if ((ny + boxH) > (bodyTop + vh)) {
                ny = ((bodyTop + vh) - boxH)
            }
            if (ny < bodyTop) {
                ny = bodyTop
            }
            this.pushRect(dl (to_double nx) (to_double ny) (to_double boxW) (to_double boxH) theme.noteBg)
            this.pushBorder(dl (to_double nx) (to_double ny) (to_double boxW) (to_double boxH) 1.0 theme.noteMark)
            def li:int 0
            while (li < (array_length lines)) {
                this.pushText(dl (itemAt lines li) (to_double (nx + 8)) (to_double ((ny + 6) + (li * lineH))) 12.0 theme.cellText)
                li = (li + 1)
            }
        }

        ; A list-validated active cell offers its choices.
        if (model.hasValidation(sel.active.row sel.active.col)) {
            def dv:DataValidation (model.validationAt(sel.active.row sel.active.col))
            if (dv.isList()) {
                def arr:GridRect (grid.listArrowRect(model sel))
                if (arr.w > 4) {
                    this.pushRect(dl (to_double arr.x) (to_double arr.y) (to_double arr.w) (to_double arr.h) theme.headerBg)
                    this.pushBorder(dl (to_double arr.x) (to_double arr.y) (to_double arr.w) (to_double arr.h) 1.0 theme.gridLine)
                    ; A downward triangle, drawn as narrowing rows.
                    def tw:int (arr.w - 6)
                    def tx:int (arr.x + 3)
                    def ty:int (arr.y + (idiv arr.h 2) - 2)
                    def k:int 0
                    while (k < 4) {
                        if (tw > 0) {
                            this.pushRect(dl (to_double (tx + k)) (to_double (ty + k)) (to_double tw) 1.0 theme.cellText)
                        }
                        tw = (tw - 2)
                        k = (k + 1)
                    }
                }
            }
        }

        ; Formula range highlights: all four edges/corners resize; dragging the
        ; tinted interior moves the whole reference horizontally.
        def hi:int 0
        def hn:int (array_length formulaHiliteR0)
        while (hi < hn) {
            def hr0:int (itemAt formulaHiliteR0 hi)
            def hc0:int (itemAt formulaHiliteC0 hi)
            def hr1:int (itemAt formulaHiliteR1 hi)
            def hc1:int (itemAt formulaHiliteC1 hi)
            def htl:GridRect (grid.cellRect(model hr0 hc0))
            def hbr:GridRect (grid.cellRect(model hr1 hc1))
            def hx:int htl.x
            def hy:int htl.y
            def hw:int ((hbr.x + hbr.w) - htl.x)
            def hh:int ((hbr.y + hbr.h) - htl.y)
            if (hx < bodyLeft) {
                hw = (hw - (bodyLeft - hx))
                hx = bodyLeft
            }
            if (hy < bodyTop) {
                hh = (hh - (bodyTop - hy))
                hy = bodyTop
            }
            if ((hx + hw) > (bodyLeft + vw)) {
                hw = ((bodyLeft + vw) - hx)
            }
            if ((hy + hh) > (bodyTop + vh)) {
                hh = ((bodyTop + vh) - hy)
            }
            if ((hw > 0) && (hh > 0)) {
                def fill:EVGColor (GridView.formulaHiliteFill(hi))
                def edge:EVGColor (GridView.formulaHiliteEdge(hi))
                this.pushRect(dl (to_double hx) (to_double hy) (to_double hw) (to_double hh) fill)
                this.pushBorder(dl (to_double hx) (to_double hy) (to_double hw) (to_double hh) 2.0 edge)
                ; Eight selection-style grips: four edge centres + corners.
                def hs:int 10
                def half:int (idiv hs 2)
                def left:int (hx - half)
                def midX:int ((hx + (idiv hw 2)) - half)
                def right:int ((hx + hw) - half)
                def top:int (hy - half)
                def midY:int ((hy + (idiv hh 2)) - half)
                def bottom:int ((hy + hh) - half)
                this.paintFormulaGrip(dl left top hs edge)
                this.paintFormulaGrip(dl midX top hs edge)
                this.paintFormulaGrip(dl right top hs edge)
                this.paintFormulaGrip(dl left midY hs edge)
                this.paintFormulaGrip(dl right midY hs edge)
                this.paintFormulaGrip(dl left bottom hs edge)
                this.paintFormulaGrip(dl midX bottom hs edge)
                this.paintFormulaGrip(dl right bottom hs edge)
            }
            hi = (hi + 1)
        }

        ; drop target for a dragged range
        if ghostVisible {
            def gtl:GridRect (grid.cellRect(model ghostR0 ghostC0))
            def gbr:GridRect (grid.cellRect(model ghostR1 ghostC1))
            def gx:int gtl.x
            def gy:int gtl.y
            def gw:int ((gbr.x + gbr.w) - gtl.x)
            def gh:int ((gbr.y + gbr.h) - gtl.y)
            if (gw > 0) {
                if (gh > 0) {
                    this.pushBorder(dl (to_double gx) (to_double gy) (to_double gw) (to_double gh) 2.0 theme.activeBorder)
                }
            }
        }

        ; active cell border
        def ar:GridRect (grid.cellRect(model sel.active.row sel.active.col))
        this.pushBorder(dl (to_double ar.x) (to_double ar.y) (to_double ar.w) (to_double ar.h) 2.0 theme.activeBorder)
        ; …and then the cell's OWN borders again, over the ring. The ring is
        ; two pixels of chrome sitting exactly on the cell's boundary, so it
        ; covered all four edges of the cell it marks: applying a border to
        ; the one cell you have selected — which is how anyone tries it —
        ; showed nothing at all until you clicked somewhere else. Drawn again
        ; here, the border is the inner pixel and the ring is the outer one,
        ; and both are visible.
        def ast:CellStyle (model.getCellStyle(sel.active.row sel.active.col))
        if ast.hasBorder {
            this.paintCellBorders(dl ast ar)
        }

        ; FortuneSheet fill handle
        if (editing == false) {
            def fh:GridRect (grid.fillHandleRect(model sel))
            this.pushRect(dl (to_double fh.x) (to_double fh.y) (to_double fh.w) (to_double fh.h) theme.activeBorder)
        }

        ; Plain text can still be edited in-cell. Formula edits have their one
        ; caret in the formula bar, so never draw a second, offset caret here.
        if editing {
            if (caretInFormulaBar == false) {
                if focused {
                    def phase:int (to_int (frame / 30))
                    def on:int (phase - ((to_int (phase / 2)) * 2))
                    if (on == 0) {
                        def upTo:string editBuf
                        def cn:int (strlen editBuf)
                        if (editCaret < cn) {
                            def cc:int editCaret
                            if (cc < 0) {
                                cc = 0
                            }
                            upTo = (substring editBuf 0 cc)
                        }
                        ; Measured in the CELL's type, not the view's default,
                        ; and standing on the line the text was drawn on.
                        this.applyFaceNamed("" false false)
                        def ew:int (to_int (ctx.tr.measureWidth(upTo editTextPx)))
                        def caretH:int (to_int editTextPx)
                        def caretY:int editTextY
                        if (caretY < (ar.y + 1)) {
                            caretY = (ar.y + 1)
                        }
                        if (((caretY + caretH) + 2) > (ar.y + ar.h)) {
                            caretY = (((ar.y + ar.h) - caretH) - 2)
                        }
                        this.pushRect(dl (to_double ((editTextX + ew) + 1)) (to_double caretY) 2.0 (to_double caretH) theme.activeBorder)
                    }
                }
            }
        }

        this.popClip(dl)

        ; Cover any body / row-header ink that spilled into the header band —
        ; SoftCanvas and the GL host still ignore clip commands.
        this.pushRect(dl (to_double grid.x) (to_double headerTop) (to_double grid.rowHeaderW) (to_double grid.colHeaderH) theme.cornerBg)
        this.paintColHeaders(dl model grid bodyLeft headerTop vw)

        ; Where a carried column would land. Excel and every reorderable list
        ; draw the same thing: a line at the insertion point, not a ghost of
        ; the column, because the question is "between which two".
        if (colDropAt >= 0) {
            def dropX:int (grid.colScreenX(model colDropAt))
            if (colDropAt >= model.colCount) {
                dropX = ((grid.colScreenX(model (model.colCount - 1))) + (model.colWidth((model.colCount - 1))))
            }
            if (dropX > grid.x) {
                this.pushRect(dl (to_double (dropX - 1)) (to_double (grid.headerTop())) 3.0 (to_double ((grid.h - grid.toolbarH) - grid.formulaBarH)) theme.activeBorder)
            }
        }

        ; Live guide while dragging a header edge, so the drop position is visible.
        if (grid.resizingCol >= 0) {
            def gx:int ((grid.colScreenX(model grid.resizingCol)) + (model.colWidth(grid.resizingCol)))
            if (gx > grid.x) {
                this.pushRect(dl (to_double (gx - 1)) (to_double (grid.headerTop())) 2.0 (to_double ((grid.h - grid.toolbarH) - grid.formulaBarH)) theme.activeBorder)
            }
        }
        if (grid.resizingRow >= 0) {
            def gy:int ((grid.rowScreenY(model grid.resizingRow)) + (model.rowHeight(grid.resizingRow)))
            if (gy > grid.y) {
                this.pushRect(dl (to_double (grid.x + grid.rowHeaderW)) (to_double (gy - 1)) (to_double (grid.w - grid.rowHeaderW)) 2.0 theme.activeBorder)
            }
        }

        ; sheet tabs
        def tabY:int (grid.sheetTabY())
        this.pushRect(dl (to_double grid.x) (to_double tabY) (to_double grid.w) (to_double grid.sheetTabH) theme.headerBg)
        ; A tab is as wide as its name, between a minimum and a maximum. It used
        ; to be a fixed 88 pixels with the name drawn into it unmeasured, so
        ; anything longer than "Forecast" ran out of its own tab and across the
        ; next one. Past the maximum the name is cut and given an ellipsis —
        ; the whole name is still in the status bar.
        def si:int 0
        def sn:int (book.sheetCount())
        def minTabW:int 64
        def maxTabW:int 190
        def tabPad:int 10
        def tabX:int grid.x
        grid.clearTabLayout()
        this.applyFaceStyled(false false)
        while (si < sn) {
            def sheet:SpreadsheetModel (book.sheetAt(si))
            if sheet.sheetHidden {
                si = (si + 1)
            } {
                def nm:string sheet.name
                if ((strlen nm) == 0) {
                    nm = ("Sheet" + (to_string (si + 1)))
                }
                def shown:string (GridView.fitLabel(ctx.tr nm 12.0 (maxTabW - (tabPad * 2))))
                def textW:int (to_int (ctx.tr.measureWidth(shown 12.0)))
                def tabW:int (textW + (tabPad * 2))
                if (tabW < minTabW) {
                    tabW = minTabW
                }
                if (tabW > maxTabW) {
                    tabW = maxTabW
                }
                ; A tab that would hang off the right edge is not drawn at all
                ; rather than half drawn.
                if ((tabX + tabW) > (grid.x + grid.w)) {
                    si = sn
                } {
                    if (si == book.activeIndex) {
                        this.pushRect(dl (to_double tabX) (to_double tabY) (to_double tabW) (to_double grid.sheetTabH) theme.formulaBg)
                    }
                    ; The tab you are carrying is greyed where it came from,
                    ; the way a dragged column header is: the strip has to
                    ; show that this one has been picked up.
                    if (si == tabDragFrom) {
                        this.pushRect(dl (to_double tabX) (to_double tabY) (to_double tabW) (to_double grid.sheetTabH) theme.selection)
                    }
                    this.pushText(dl shown (to_double (tabX + tabPad)) (to_double (tabY + 5)) 12.0 theme.headerText)
                    this.pushRect(dl (to_double ((tabX + tabW) - 1)) (to_double tabY) 1.0 (to_double grid.sheetTabH) theme.gridLine)
                    grid.addTabLayout(si tabX tabW)
                    tabX = (tabX + tabW)
                    si = (si + 1)
                }
            }
        }
        ; The new-sheet button, after the last tab. Excel's plus, in Excel's
        ; place, doing Excel's thing — a sheet after the one you are on.
        def plusW:int 26
        if ((tabX + plusW) <= (grid.x + grid.w)) {
            grid.setTabPlus(tabX plusW)
            def pcx:int (tabX + (idiv plusW 2))
            def pcy:int (tabY + (idiv grid.sheetTabH 2))
            this.pushRect(dl (to_double (pcx - 5)) (to_double pcy) 11.0 1.0 theme.headerText)
            this.pushRect(dl (to_double pcx) (to_double (pcy - 5)) 1.0 11.0 theme.headerText)
            this.pushRect(dl (to_double ((tabX + plusW) - 1)) (to_double tabY) 1.0 (to_double grid.sheetTabH) theme.gridLine)
        }
        ; Where a carried tab would land.
        if (tabDropSlot >= 0) {
            def dropX:int (grid.tabSlotX(tabDropSlot))
            this.pushRect(dl (to_double (dropX - 1)) (to_double tabY) 2.0 (to_double grid.sheetTabH) theme.activeBorder)
        }
        this.pushBorder(dl (to_double grid.x) (to_double tabY) (to_double grid.w) (to_double grid.sheetTabH) 1.0 theme.gridLine)

        ; outer chrome
        this.pushBorder(dl (to_double grid.x) (to_double grid.y) (to_double grid.w) (to_double grid.h) 1.0 theme.gridLine)

        ; sort/filter header popup — also font size / family dropdowns
        if menuOpen {
            def mw:int menuW
            def mh:int menuH
            this.pushRect(dl (to_double menuX) (to_double menuY) (to_double mw) (to_double mh) theme.formulaBg)
            this.pushBorder(dl (to_double menuX) (to_double menuY) (to_double mw) (to_double mh) 1.0 theme.activeBorder)
            if (menuKind == 2) {
                this.pushText(dl "Size" (to_double (menuX + 8)) (to_double (menuY + 6)) 12.0 theme.headerText)
                def sizeIdx:int 0
                while (sizeIdx < 12) {
                    def sLab:string "8"
                    if (sizeIdx == 0) { sLab = "8" }
                    if (sizeIdx == 1) { sLab = "9" }
                    if (sizeIdx == 2) { sLab = "10" }
                    if (sizeIdx == 3) { sLab = "11" }
                    if (sizeIdx == 4) { sLab = "12" }
                    if (sizeIdx == 5) { sLab = "14" }
                    if (sizeIdx == 6) { sLab = "16" }
                    if (sizeIdx == 7) { sLab = "18" }
                    if (sizeIdx == 8) { sLab = "20" }
                    if (sizeIdx == 9) { sLab = "24" }
                    if (sizeIdx == 10) { sLab = "28" }
                    if (sizeIdx == 11) { sLab = "36" }
                    this.pushText(dl sLab (to_double (menuX + 8)) (to_double ((menuY + 28) + (sizeIdx * 20))) 12.0 theme.cellText)
                    sizeIdx = (sizeIdx + 1)
                }
            } {
            if (menuKind == 3) {
                this.pushText(dl "Font" (to_double (menuX + 8)) (to_double (menuY + 6)) 12.0 theme.headerText)
                def fontIdx:int 0
                while (fontIdx < 10) {
                    def fLab:string "Calibri"
                    if (fontIdx == 0) { fLab = "Calibri" }
                    if (fontIdx == 1) { fLab = "Arial" }
                    if (fontIdx == 2) { fLab = "Times New Roman" }
                    if (fontIdx == 3) { fLab = "Georgia" }
                    if (fontIdx == 4) { fLab = "Courier New" }
                    if (fontIdx == 5) { fLab = "Open Sans" }
                    if (fontIdx == 6) { fLab = "Noto Sans" }
                    if (fontIdx == 7) { fLab = "Helvetica" }
                    if (fontIdx == 8) { fLab = "Droid Serif" }
                    if (fontIdx == 9) { fLab = "Josefin Sans" }
                    this.pushText(dl fLab (to_double (menuX + 8)) (to_double ((menuY + 28) + (fontIdx * 20))) 12.0 theme.cellText)
                    fontIdx = (fontIdx + 1)
                }
            } {
            if (menuKind == 1) {
                def rtitle:string ("Row " + (to_string (menuRow + 1)))
                this.pushText(dl rtitle (to_double (menuX + 8)) (to_double (menuY + 8)) 12.0 theme.headerText)
                this.pushText(dl "1  Select row" (to_double (menuX + 8)) (to_double (menuY + 30)) 12.0 theme.cellText)
                this.pushText(dl "2  Auto-fit height" (to_double (menuX + 8)) (to_double (menuY + 50)) 12.0 theme.cellText)
                this.pushText(dl "3  Taller  (+10)" (to_double (menuX + 8)) (to_double (menuY + 70)) 12.0 theme.cellText)
                this.pushText(dl "4  Shorter  (-10)" (to_double (menuX + 8)) (to_double (menuY + 90)) 12.0 theme.cellText)
                this.pushRect(dl (to_double (menuX + 8)) (to_double (menuY + 108)) (to_double (mw - 16)) 1.0 theme.gridLine)
                this.pushText(dl "5  Insert row above" (to_double (menuX + 8)) (to_double (menuY + 112)) 12.0 theme.cellText)
                this.pushText(dl "6  Insert row below" (to_double (menuX + 8)) (to_double (menuY + 132)) 12.0 theme.cellText)
                this.pushText(dl "7  Delete row" (to_double (menuX + 8)) (to_double (menuY + 152)) 12.0 theme.cellText)
                this.pushText(dl "8  Move up" (to_double (menuX + 8)) (to_double (menuY + 172)) 12.0 theme.cellText)
                this.pushText(dl "9  Move down" (to_double (menuX + 8)) (to_double (menuY + 192)) 12.0 theme.cellText)
            } {
                def title:string ("Column " + (SpreadsheetModel.colLabel(menuCol)))
                this.pushText(dl title (to_double (menuX + 8)) (to_double (menuY + 8)) 12.0 theme.headerText)
                this.pushText(dl "1  Sort ascending" (to_double (menuX + 8)) (to_double (menuY + 30)) 12.0 theme.cellText)
                this.pushText(dl "2  Sort descending" (to_double (menuX + 8)) (to_double (menuY + 50)) 12.0 theme.cellText)
                this.pushText(dl "3  Filter unique values" (to_double (menuX + 8)) (to_double (menuY + 70)) 12.0 theme.cellText)
                this.pushText(dl "4  Clear filter" (to_double (menuX + 8)) (to_double (menuY + 90)) 12.0 theme.cellText)
                this.pushText(dl "5  Auto-fit width" (to_double (menuX + 8)) (to_double (menuY + 110)) 12.0 theme.cellText)
                this.pushText(dl "6  Wider  (+20)" (to_double (menuX + 8)) (to_double (menuY + 130)) 12.0 theme.cellText)
                this.pushText(dl "7  Narrower  (-20)" (to_double (menuX + 8)) (to_double (menuY + 150)) 12.0 theme.cellText)
                this.pushRect(dl (to_double (menuX + 8)) (to_double (menuY + 168)) (to_double (mw - 16)) 1.0 theme.gridLine)
                this.pushText(dl "8  Insert column left" (to_double (menuX + 8)) (to_double (menuY + 172)) 12.0 theme.cellText)
                this.pushText(dl "9  Insert column right" (to_double (menuX + 8)) (to_double (menuY + 192)) 12.0 theme.cellText)
                this.pushText(dl "10  Delete column" (to_double (menuX + 8)) (to_double (menuY + 212)) 12.0 theme.cellText)
                this.pushText(dl "11  Move left" (to_double (menuX + 8)) (to_double (menuY + 232)) 12.0 theme.cellText)
                this.pushText(dl "12  Move right" (to_double (menuX + 8)) (to_double (menuY + 252)) 12.0 theme.cellText)
            }
            }
            }
        }

        ; --- report preview -------------------------------------------------
        ; It takes the sheet's whole area, headers included: a page is a
        ; different thing from a grid and pretending otherwise, by leaving the
        ; column letters visible around it, only confuses which one is being
        ; looked at. The toolbar and the status bar stay, because Save, Open
        ; and the sheet tabs still mean what they meant.
        if preview.active {
            def pvTop:int headerTop
            def pvH:int ((grid.y + grid.h) - headerTop)
            def barH:int 22
            this.pushRect(dl (to_double grid.x) (to_double pvTop) (to_double grid.w) (to_double barH) theme.headerBg)
            this.pushRect(dl (to_double grid.x) (to_double ((pvTop + barH) - 1)) (to_double grid.w) 1.0 theme.gridLine)
            this.pushText(dl (preview.headline()) (to_double (grid.x + 8)) (to_double (pvTop + 4)) 12.0 theme.headerText)
            preview.paintInto(dl grid.x (pvTop + barH) grid.w (pvH - barH))
        }

        ; status bar
        def sy2:int (grid.y + grid.h)
        if (sy2 < pageH) {
            def sh2:int (pageH - sy2)
            this.pushRect(dl 0.0 (to_double sy2) (to_double pageW) (to_double sh2) theme.barBg)
            def src:string book.sourcePath
            if ((strlen src) == 0) {
                src = "(demo)"
            }
            def info:string ("sheet " + (book.activeName()) + "  sel " + (SpreadsheetModel.cellLabel(sel.active.row sel.active.col)) + "  visible " + (to_string grid.firstVisibleRow) + ".." + (to_string grid.lastVisibleRow) + "  rows=" + (to_string model.rowCount) + "  " + src + "  " + status)
            this.pushText(dl info 8.0 (to_double (sy2 + 4)) 12.0 theme.barText)
            ; The one control on the status bar: making a chart out of what is
            ; selected. A shortcut alone would be a feature nobody finds.
            ; The host's own tools sit to the left of the built-in button, in
            ; the order they were registered.
            def toolI:int 0
            while (toolI < (commands.customCount())) {
                def tool:GridCommand (commands.customAt(toolI))
                def tx:int (GridView.toolButtonX(pageW toolI))
                def ty:int (GridView.chartButtonY(sy2))
                def tw:int (GridView.toolButtonW())
                this.pushRect(dl (to_double tx) (to_double ty) (to_double tw) (to_double (GridView.chartButtonH())) theme.barButton)
                this.pushBorder(dl (to_double tx) (to_double ty) (to_double tw) (to_double (GridView.chartButtonH())) 1.0 theme.gridLine)
                this.pushText(dl tool.label (to_double (tx + 6)) (to_double (ty + 1)) 12.0 theme.barText)
                toolI = (toolI + 1)
            }
            def cbx:int (GridView.chartButtonX(pageW))
            def cby:int (GridView.chartButtonY(sy2))
            this.pushRect(dl (to_double cbx) (to_double cby) (to_double (GridView.chartButtonW())) (to_double (GridView.chartButtonH())) theme.barButton)
            this.pushBorder(dl (to_double cbx) (to_double cby) (to_double (GridView.chartButtonW())) (to_double (GridView.chartButtonH())) 1.0 theme.gridLine)
            this.pushText(dl "+ Chart" (to_double (cbx + 10)) (to_double (cby + 1)) 12.0 theme.barText)
        }

        ; Dialogs and floating charts sit above everything, including the
        ; status bar. Each window is painted and then immediately asked for its
        ; content, so a chart's drawing lands inside its own frame and under
        ; whatever is stacked on top of it — a dialog opened over a chart is
        ; not drawn through.
        def wi:int 0
        while (wi < (array_length windows.windows)) {
            def wnd:EVGWindow (itemAt windows.windows wi)
            wnd.paint(dl ctx.tr pageW pageH)
            chartLayer.paintContent(dl model ctx.tr wnd)
            ; And only now the window's own overlay: a chart's tool strip sits
            ; ON the chart, so it has to be drawn after the chart is.
            wnd.paintOverlay(dl ctx.tr)
            ; The picker's own preview, drawn into the region it left for it.
            ; Same renderer, same cache, same everything as a chart on the
            ; sheet — which is the point: what you see is what you will get.
            if (previewWid > 0) {
                if ((wnd.wid == previewWid) && wnd.visible) {
                    if (wnd.hasContent) {
                        def pc:EVGControl (wnd.contentControl())
                        chartLayer.view.paint(dl model previewChart ctx.tr ((wnd.x + pc.x) + 1) ((wnd.y + pc.y) + 1) (pc.w - 2) (pc.h - 2))
                    }
                }
            }
            if (colorPreviewWid > 0) {
                if ((wnd.wid == colorPreviewWid) && wnd.visible) {
                    if wnd.hasContent {
                        this.paintColorPreviewCell(dl wnd)
                    }
                }
            }
            if (borderPreviewWid > 0) {
                if ((wnd.wid == borderPreviewWid) && wnd.visible) {
                    if wnd.hasContent {
                        this.paintBorderPreview(dl wnd)
                    }
                }
            }
            wi = (wi + 1)
        }

        return dl
    }

    ; Mini "AaBbYyZz" cell inside the colour dialog so Selected is a picture,
    ; not only a hex string.
    fn paintColorPreviewCell:void (dl:EVGDisplayList wnd:EVGWindow) {
        def pc:EVGControl (wnd.contentControl())
        def x0:int ((wnd.x + pc.x) + 2)
        def y0:int ((wnd.y + pc.y) + 2)
        def cw:int (pc.w - 4)
        def ch:int (pc.h - 4)
        if (cw < 20) {
            return
        }
        if (ch < 16) {
            return
        }
        def bg:EVGColor (EVGColor.rgb(255 255 255))
        def fg:EVGColor theme.cellText
        if colorPreviewIsFill {
            if ((strlen colorPreviewHex) >= 4) {
                bg = (EVGColor.parse(colorPreviewHex))
            }
        } {
            if ((strlen colorPreviewHex) >= 4) {
                fg = (EVGColor.parse(colorPreviewHex))
            }
        }
        this.pushRect(dl (to_double x0) (to_double y0) (to_double cw) (to_double ch) bg)
        this.pushBorder(dl (to_double x0) (to_double y0) (to_double cw) (to_double ch) 1.0 theme.gridLine)
        this.applyFaceStyled(false false)
        def sample:string "AaBbYyZz"
        def px:double 16.0
        def tw:double (ctx.tr.measureWidth(sample px))
        def tx:double ((to_double x0) + (((to_double cw) - tw) * 0.5))
        def ty:double ((to_double y0) + (((to_double ch) - px) * 0.5))
        this.pushStyledText(dl sample tx ty px fg "" false false)
    }

    ; Four cells in a block, with the spec applied to them exactly as the
    ; sheet would apply it: the same `GridFormat.borderSpecFor` decides which
    ; edge each of the four gets, and the same `paintCellBorders` draws it. A
    ; preview that agrees with the sheet by construction cannot drift from it.
    fn paintBorderPreview:void (dl:EVGDisplayList wnd:EVGWindow) {
        def pc:EVGControl (wnd.contentControl())
        def cw:int (idiv (pc.w - 8) 2)
        def ch:int (idiv (pc.h - 8) 2)
        if (cw < 12) {
            return
        }
        if (ch < 10) {
            return
        }
        def x0:int (((wnd.x + pc.x) + (idiv (pc.w - (cw * 2)) 2)))
        def y0:int (((wnd.y + pc.y) + (idiv (pc.h - (ch * 2)) 2)))
        this.pushRect(dl (to_double x0) (to_double y0) (to_double (cw * 2)) (to_double (ch * 2)) (EVGColor.rgb(255 255 255)))
        ; The pale grid the borders are drawn over, so an unticked edge reads
        ; as "no line here" rather than as a hole.
        this.pushRect(dl (to_double (x0 + cw - 1)) (to_double y0) 1.0 (to_double (ch * 2)) theme.gridLine)
        this.pushRect(dl (to_double x0) (to_double (y0 + ch - 1)) (to_double (cw * 2)) 1.0 theme.gridLine)
        def rr:int 0
        while (rr < 2) {
            def cc:int 0
            while (cc < 2) {
                def st:CellStyle (new CellStyle)
                GridFormat.borderSpecFor(st borderPreviewSpec (rr == 0) (cc == 1) (rr == 1) (cc == 0))
                def rect:GridRect (GridRect.create((x0 + (cc * cw)) (y0 + (rr * ch)) cw ch))
                this.paintCellBorders(dl st rect)
                cc = (cc + 1)
            }
            rr = (rr + 1)
        }
    }

    fn paintSoftCanvas:void (dl:EVGDisplayList) {
        canvas.clear((theme.bg.red()) (theme.bg.green()) (theme.bg.blue()))
        painter.attach(canvas ctx images pageW pageH)
        painter.fontFamily = fontFamily
        painter.draw(dl)
    }

    ; Height the wrapped text needs in a column of `colW`, for row auto-fit.
    fn measureWrappedHeight:int (text:string colW:int st:CellStyle) {
        def cellPx:double fontSize
        if (st.fontSizePt > 0.0) {
            cellPx = ((st.fontSizePt * 96.0) / 72.0)
        }
        if (cellPx < 6.0) {
            cellPx = 6.0
        }
        this.applyFaceStyled(st.bold st.italic)
        ; One line is as tall as the TYPE needs, by Excel's rule — not as tall
        ; as the face's line box, which is a fifth taller than the letters in
        ; it and would grow every row in the sheet on the first edit.
        def one:int (CellStyle.rowHeightForPt(st.fontSizePt))
        if (st.wrapText == false) {
            return one
        }
        def avail:int (colW - 8)
        if (avail < 12) {
            avail = 12
        }
        def lines:[string] (ctx.tr.wrap(text cellPx (to_double avail)))
        def n:int (array_length lines)
        if (n < 1) {
            n = 1
        }
        ; Further lines are spaced by the face, which is what actually decides
        ; whether two lines of text collide.
        def lineH:int (to_int (ctx.tr.lineHeight(cellPx)))
        if (lineH < 8) {
            lineH = 8
        }
        return (one + (lineH * (n - 1)))
    }

    ; A label cut to fit a width, with an ellipsis when it had to be cut. The
    ; cut is measured rather than counted: "WWWW" and "iiii" are not the same
    ; number of pixels.
    sfn fitLabel:string (tr:UITextRenderer text:string size:double maxW:int) {
        ; One implementation, in EVGTextFit, so a dialog's field and a grid's
        ; label cut text the same way.
        return (EVGTextFit.fitLabel(tr text size maxW))
    }

    ; --- the toolbar ----------------------------------------------------------
    ; Icons are drawn from primitives. There is no icon font here and a sprite
    ; sheet would be a second thing to keep in step with the theme, so a button
    ; is a few rectangles and, where a letter says it best, a letter.
    ; The toolbar draws itself. Everything about it that is not "which buttons
    ; a spreadsheet has" lives in gallery/evg — the wrapping, the hit testing,
    ; the hover, and the three hundred lines that draw the icons — so Word and
    ; PowerPoint get the same strip instead of a second one that slowly stops
    ; looking like this one.
    fn paintToolbar:void (dl:EVGDisplayList model:SpreadsheetModel sel:GridSelection grid:DataGrid) {
        toolbar.refreshToggles(model sel)
        toolbar.refreshLabels(model sel)
        toolbarView.attach(ctx fontFamily)
        toolbarView.theme = (GridView.toolbarTheme(theme))
        toolbarView.paint(dl toolbar grid.x (grid.toolbarY()) grid.w grid.toolbarH)
    }

    ; The grid's palette, in the words the shared strip uses.
    sfn toolbarTheme:EVGToolbarTheme (t:GridTheme) {
        def p:EVGToolbarTheme (new EVGToolbarTheme)
        p.bg = t.statusBg
        p.line = t.gridLine
        p.ink = t.cellText
        p.dim = t.statusText
        p.hotBg = t.headerBg
        p.pressedBg = t.selection
        p.accent = t.activeBorder
        p.warn = t.noteMark
        p.tipBg = t.formulaBg
        p.link = t.linkText
        return p
    }

    ; Width the grid would paint this text at, for auto-fit.
    fn measureText:int (text:string) {
        if ((strlen text) == 0) {
            return 0
        }
        return (to_int (ctx.tr.measureWidth(text fontSize)))
    }

    fn render:void (model:SpreadsheetModel sel:GridSelection grid:DataGrid editing:boolean editBuf:string book:WorkbookModel) {
        ctx.frame = frame
        def dl:EVGDisplayList (this.buildDisplayList(model sel grid editing editBuf book))
        this.paintSoftCanvas(dl)
        frame = (frame + 1)
    }

    ; ==========================================================================
    ; What the sheet MEANS — the second list, beside the display list.
    ; ==========================================================================
    ;
    ; `buildDisplayList` says where every rectangle goes; this says what they
    ; are. A screen reader cannot read a WebGL canvas — it asks the platform
    ; for a tree of roles and names — so the app publishes one, and the host
    ; turns it into whatever its platform speaks: a DOM mirror in a browser,
    ; UI Automation / AT-SPI / NSAccessibility natively.
    ;
    ; Nothing here is invented. The names come from the same model the painter
    ; reads, the geometry is the geometry that was painted, and the focus is
    ; `sel.active` — the caret the user is already moving with the arrow keys.
    ;
    ; VIRTUALIZATION is the part to be careful about: a sheet is ten thousand
    ; rows and the tree gets the forty that are on screen. `rowCount` /
    ; `colCount` on the grid node carry the truth about the rest, and
    ; `rowIndex` / `colIndex` say where each emitted cell sits in it, so a
    ; reader can say "row 4,120 of 10,000" without the other 9,960 existing.
    ; Both the header row and the row-number column count as index 1, which is
    ; how an ARIA grid numbers itself.
    fn a11yTree:EVGA11yTree (model:SpreadsheetModel sel:GridSelection grid:DataGrid editing:boolean editBuf:string book:WorkbookModel) {
        grid.updateVisible(model)
        def t:EVGA11yTree (new EVGA11yTree)
        t.generation = frame
        def sheetName:string (book.activeName())
        if ((strlen sheetName) == 0) {
            sheetName = model.name
        }
        def root:EVGA11yNode (t.group("app" "" ("Spreadsheet, " + sheetName)))
        t.place(root 0 0 pageW pageH)

        if (grid.toolbarH > 0) {
            def tby:int (grid.toolbarY())
            toolbar.a11y(t "app" "app" grid.x tby grid.w grid.toolbarH)
        }

        this.a11yFormulaBar(t model sel grid editing editBuf)
        this.a11yGrid(t model sel grid editing editBuf)
        this.a11ySheetTabs(t grid book)

        ; What has just happened, for things with no anchor on screen: a file
        ; opened, a sort applied, a recalculation finished. Polite, because
        ; assertive interrupts whatever is being read and that is for errors.
        def st:EVGA11yNode (t.statusRegion("app/status" "app" status))
        def sy:int (pageH - 22)
        t.place(st 0 sy pageW 22)

        ; Dialogs and panels last, so they are the innermost thing a reader
        ; walks into — and each says whether it is modal.
        windows.a11y(t "app")

        ; Focus belongs to whatever is actually taking the keys. A dialog wins,
        ; because while one is up the sheet is not listening.
        this.a11yFocus(t sel editing)
        return t
    }

    fn a11yFormulaBar:void (t:EVGA11yTree model:SpreadsheetModel sel:GridSelection grid:DataGrid editing:boolean editBuf:string) {
        def fbY:int (grid.formulaBarY())
        def bar:EVGA11yNode (t.group("app/formulabar" "app" "Formula bar"))
        t.place(bar grid.x fbY grid.w grid.formulaBarH)

        def addr:string (SpreadsheetModel.cellLabel(sel.active.row sel.active.col))
        ; The name box is a field in the picture and a field here: typing an
        ; address into it is how you jump without a mouse.
        def nameBox:EVGA11yNode (t.field("app/namebox" "app/formulabar" "Name box" addr))
        def addrX:int (grid.x + 4)
        def fieldY:int (fbY + 3)
        def fieldH:int (grid.formulaBarH - 6)
        t.place(nameBox addrX fieldY 64 fieldH)

        def shown:string (model.formulaBarText(sel.active.row sel.active.col))
        if editing {
            shown = editBuf
        }
        def f:EVGA11yNode (t.field("app/formula" "app/formulabar" "Formula" shown))
        f.caret = editCaret
        ; Geometry the last paint settled — the same rectangle the caret is
        ; drawn in, rather than a second guess at where the field is.
        if (fbFieldW > 0) {
            t.place(f fbFieldX fbFieldY fbFieldW fbFieldH)
        } {
            def fx:int ((grid.x + 64) + 10)
            def fw:int ((grid.w - 64) - 18)
            t.place(f fx fieldY fw fieldH)
        }
    }

    fn a11yGrid:void (t:EVGA11yTree model:SpreadsheetModel sel:GridSelection grid:DataGrid editing:boolean editBuf:string) {
        def headerTop:int (grid.headerTop())
        def bodyLeft:int (grid.x + grid.rowHeaderW)
        def bodyTop:int (headerTop + grid.colHeaderH)
        def vw:int (grid.viewportW())
        def vh:int (grid.viewportH())
        def gridNode:EVGA11yNode (t.node("app/grid" "app" (EVGA11yRole.grid())))
        gridNode.name = "Sheet"
        def totalRows:int (grid.viewRowCount(model))
        def totalCols:int (grid.viewColCount(model))
        gridNode.rowCount = (totalRows + 1)
        gridNode.colCount = (totalCols + 1)
        def gh:int (vh + grid.colHeaderH)
        t.place(gridNode grid.x headerTop (grid.rowHeaderW + vw) gh)

        ; The column letters, as a header row. A reader announces the column a
        ; cell is in from these; without them "1,204" is a number with no
        ; column, which is most of what makes a spreadsheet a spreadsheet.
        def headRow:EVGA11yNode (t.node("app/grid/head" "app/grid" (EVGA11yRole.row())))
        headRow.rowIndex = 1
        t.place(headRow grid.x headerTop (grid.rowHeaderW + vw) grid.colHeaderH)
        def corner:EVGA11yNode (t.node("app/grid/head/corner" "app/grid/head" (EVGA11yRole.columnHeader())))
        corner.name = "Row"
        corner.colIndex = 1
        t.place(corner grid.x headerTop grid.rowHeaderW grid.colHeaderH)
        def hc:int grid.firstVisibleCol
        while (hc <= grid.lastVisibleCol) {
            def mc:int (grid.mapCol(hc))
            def label:string (SpreadsheetModel.colLabel(mc))
            def ch:EVGA11yNode (t.node(("app/grid/head/" + label) "app/grid/head" (EVGA11yRole.columnHeader())))
            ch.name = label
            ch.colIndex = (hc + 2)
            def hx:int (grid.viewColScreenX(model hc))
            def cw:int (model.colWidth(mc))
            t.place(ch hx headerTop cw grid.colHeaderH)
            hc = (hc + 1)
        }

        def vr:int grid.firstVisibleRow
        while (vr <= grid.lastVisibleRow) {
            def mr:int (grid.mapRow(vr))
            def rowNum:string (to_string (mr + 1))
            def rowId:string ("app/grid/row:" + rowNum)
            def rowNode:EVGA11yNode (t.node(rowId "app/grid" (EVGA11yRole.row())))
            rowNode.rowIndex = (vr + 2)
            def ry:int (grid.viewRowScreenY(model vr))
            def rh:int (model.rowHeight(mr))
            t.place(rowNode grid.x ry (grid.rowHeaderW + vw) rh)
            def rhNode:EVGA11yNode (t.node((rowId + "/head") rowId (EVGA11yRole.rowHeader())))
            rhNode.name = rowNum
            rhNode.colIndex = 1
            rhNode.rowIndex = (vr + 2)
            t.place(rhNode grid.x ry grid.rowHeaderW rh)

            def vc:int grid.firstVisibleCol
            while (vc <= grid.lastVisibleCol) {
                def mc2:int (grid.mapCol(vc))
                this.a11yCell(t model sel grid editing editBuf rowId mr mc2 vr vc)
                vc = (vc + 1)
            }
            vr = (vr + 1)
        }
    }

    fn a11yCell:void (t:EVGA11yTree model:SpreadsheetModel sel:GridSelection grid:DataGrid editing:boolean editBuf:string rowId:string mr:int mc:int vr:int vc:int) {
        def addr:string (SpreadsheetModel.cellLabel(mr mc))
        def cell:EVGA11yNode (t.node((rowId + "/" + addr) rowId (EVGA11yRole.cell())))
        cell.name = (model.getDisplay(mr mc))
        cell.rowIndex = (vr + 2)
        cell.colIndex = (vc + 2)
        def rect:GridRect (grid.cellRect(model mr mc))
        t.place(cell rect.x rect.y rect.w rect.h)
        cell.selected = (sel.coversAny(mr mc))

        ; What is behind the number, spoken after it rather than instead of it.
        def extra:string ""
        def formula:string (model.getFormula(mr mc))
        if ((strlen formula) > 0) {
            extra = ("formula " + formula)
        }
        def note:string (model.noteAt(mr mc))
        if ((strlen note) > 0) {
            extra = (EVGA11yTree.addWord(extra ("note: " + note)))
        }
        cell.description = extra

        def isActive:boolean false
        if (mr == sel.active.row) {
            if (mc == sel.active.col) {
                isActive = true
            }
        }
        if isActive {
            ; The caret cell is the one element in the grid that takes the
            ; keyboard — the roving tabindex an ARIA grid is built on. An empty
            ; cell still needs something to say, or moving into it is silence.
            cell.focusable = true
            if ((strlen cell.name) == 0) {
                cell.name = "blank"
            }
            if editing {
                ; While a cell is being edited the value is not in the model
                ; yet, and the thing with the keyboard is a text field. A host
                ; gives this one a real input, which is the only way a browser
                ; hands over an IME, dictation or braille entry.
                def ed:EVGA11yNode (t.field((rowId + "/" + addr + "/edit") (rowId + "/" + addr) ("Editing " + addr) editBuf))
                ed.caret = editCaret
                t.place(ed rect.x rect.y rect.w rect.h)
            }
        }
    }

    fn a11ySheetTabs:void (t:EVGA11yTree grid:DataGrid book:WorkbookModel) {
        ; The tab strip's geometry is what the last paint measured — a tab is as
        ; wide as its name — so a sheet the paint decided not to draw is not
        ; claimed here either.
        def n:int (array_length grid.tabSheets)
        if (n == 0) {
            return
        }
        def tabY:int (grid.sheetTabY())
        def strip:EVGA11yNode (t.node("app/sheets" "app" (EVGA11yRole.tabList())))
        strip.name = "Sheets"
        t.place(strip grid.x tabY grid.w grid.sheetTabH)
        def i:int 0
        while (i < n) {
            def si:int (itemAt grid.tabSheets i)
            def sheet:SpreadsheetModel (book.sheetAt(si))
            def nm:string sheet.name
            if ((strlen nm) == 0) {
                nm = ("Sheet" + (to_string (si + 1)))
            }
            def tab:EVGA11yNode (t.node(("app/sheet:" + (to_string si)) "app/sheets" (EVGA11yRole.tab())))
            tab.name = nm
            tab.focusable = true
            tab.actActivate = true
            tab.posInSet = (i + 1)
            tab.setSize = n
            tab.selected = (si == book.activeIndex)
            t.place(tab (itemAt grid.tabXs i) tabY (itemAt grid.tabWs i) grid.sheetTabH)
            i = (i + 1)
        }
    }

    ; One owner for focus, and this is it. A dialog takes it while one is up;
    ; otherwise it is the cell being edited, the formula bar, or the caret cell
    ; — in that order, because that is the order the keys go.
    fn a11yFocus:void (t:EVGA11yTree sel:GridSelection editing:boolean) {
        if ((strlen t.focusId) > 0) {
            return
        }
        ; A modal is up and no field inside it asked for the keys: focus the
        ; dialog itself. Leaving focus on the sheet behind it would tell a
        ; reader to go on editing cells that are not listening.
        if (windows.anyModalVisible()) {
            def top:EVGWindow (windows.topmost())
            def topId:string (top.a11yId())
            if (t.has(topId)) {
                t.setFocus(topId)
                return
            }
        }
        def addr:string (SpreadsheetModel.cellLabel(sel.active.row sel.active.col))
        def rowNum:string (to_string (sel.active.row + 1))
        def cellId:string ("app/grid/row:" + rowNum + "/" + addr)
        if editing {
            if caretInFormulaBar {
                t.setFocus("app/formula")
                return
            }
            def editId:string (cellId + "/edit")
            if (t.has(editId)) {
                t.setFocus(editId)
                return
            }
        }
        if (t.has(cellId)) {
            t.setFocus(cellId)
            return
        }
        t.setFocus("app")
    }

    fn sceneJson:string (model:SpreadsheetModel sel:GridSelection grid:DataGrid editing:boolean editBuf:string book:WorkbookModel) {
        ctx.frame = frame
        def dl:EVGDisplayList (this.buildDisplayList(model sel grid editing editBuf book))
        frame = (frame + 1)
        def body:string (dl.toJson())
        return ("{\"width\":" + (EVGDisplayList.num((to_double pageW))) + ",\"height\":" + (EVGDisplayList.num((to_double pageH))) + ",\"list\":" + body + "}")
    }
}

; ==============================================================================
; FormulaEngine - AST + dependency graph + incremental recalc.
; ==============================================================================
;
; Function implementations live in FormulaFunctions.rgr (unit-testable).
; This file: parse → deps → topological recalc → FormulaFunctions.invoke.
;
; Operators: + - * / ^ &   = <> < > <= >=
; Refs: A1, $A$1, A$1, $A1, Sheet2!A1, 'My Sheet'!A1, A1:B10
; Errors: #DIV/0! #VALUE! #REF! #NAME? #CYCLE! #NUM!
;
; AST helpers: FormulaParser.translateNode / serializeNode for fill/copy.
; ==============================================================================

Import "SpreadsheetModel.rgr"
Import "WorkbookModel.rgr"
Import "FormulaValue.rgr"
Import "FormulaFunctions.rgr"

; --- AST nodes (flattened: kind + fields) ------------------------------------

class FormulaNode {
    ; 0 num 1 str 2 bool 3 cell 4 range 5 unary 6 binary 7 call 8 err
    ; 9 structured reference — `Table1[[#This Row],[CategoryID]]`
    def kind:int 0
    def num:double 0.0
    def text:string ""
    def flag:boolean false
    def sheet:string ""
    def row:int 0
    def col:int 0
    def row2:int 0
    def col2:int 0
    def absRow:boolean false
    def absCol:boolean false
    def absRow2:boolean false
    def absCol2:boolean false
    def op:string ""
    def fnName:string ""
    def kids:[FormulaNode]
    ; --- structured reference (kind 9) ----------------------------------------
    ; Held as it was WRITTEN and resolved at evaluation time, not at parse
    ; time, for two reasons that both matter.
    ;
    ; The parser does not know the tables — they belong to the workbook — and
    ; `#This Row` does not have an answer until you know which cell is asking.
    ; And a structured reference is not translated when a formula is copied:
    ; that is the entire point of it, since `[#This Row]` re-anchors itself on
    ; whatever row it lands on. Keeping the text means a copy, a save and a
    ; round trip all give back the same reference rather than a rewritten one.
    ;
    ; `tableItem` is the specifier, folded to lower case ("#this row",
    ; "#headers", "#totals", "#data", "#all") or "" for none. `tableCol2` is
    ; set only for a span, `Table1[[Amount]:[Price]]`.
    def tableName:string ""
    def tableItem:string ""
    def tableCol1:string ""
    def tableCol2:string ""
    ; True where the reference was written with the `@` shorthand, so
    ; serializing gives back what the file said rather than the other spelling.
    def tableAtSign:boolean false

    Constructor () {
    }
}

; Where a structured reference lands, once a workbook has been consulted.
; `err` is empty when it landed anywhere at all.
class TableRange {
    def err:string ""
    def sheetIdx:int 0
    def r0:int 0
    def c0:int 0
    def r1:int 0
    def c1:int 0

    Constructor () {
    }
}

; --- tokenizer / parser -------------------------------------------------------

class FormulaParser {
    def src:string ""
    def pos:int 0
    def len:int 0
    def ok:boolean true
    def err:string ""

    Constructor () {
    }

    fn reset:void (s:string) {
        src = s
        pos = 0
        len = (strlen s)
        ok = true
        err = ""
        if (len > 0) {
            if ((charAt src 0) == 61) {
                pos = 1
            }
        }
    }

    fn peek:int () {
        if (pos >= len) {
            return -1
        }
        return (charAt src pos)
    }

    fn next:int () {
        if (pos >= len) {
            return -1
        }
        def ch:int (charAt src pos)
        pos = (pos + 1)
        return ch
    }

    ; The character `next` just consumed, as text.
    ;
    ; Not `(strfromcode (this.next()))`: that pair looks like an identity and
    ; is one in JavaScript, where a string is code units. In C++ a string is
    ; BYTES, so `charAt` hands back 0xC3 and `strfromcode` — whose job is a
    ; code POINT — encodes 195 as two bytes of UTF-8, and every accented
    ; letter inside a quoted formula string would be encoded twice.
    fn lastAsText:string () {
        if (pos < 1) {
            return ""
        }
        return (substring src (pos - 1) pos)
    }

    fn skipWs:void () {
        while (pos < len) {
            def ch:int (charAt src pos)
            if ((ch == 32) || (ch == 9) || (ch == 10) || (ch == 13)) {
                pos = (pos + 1)
            } {
                return
            }
        }
    }

    fn parse:FormulaNode (s:string) {
        this.reset(s)
        def n:FormulaNode (this.parseExpr())
        this.skipWs()
        if (pos < len) {
            ok = false
            err = "#VALUE!"
        }
        if (ok == false) {
            def e:FormulaNode (new FormulaNode)
            e.kind = 8
            e.text = err
            if ((strlen e.text) == 0) {
                e.text = "#VALUE!"
            }
            return e
        }
        return n
    }

    fn parseExpr:FormulaNode () {
        return (this.parseCompare())
    }

    fn parseCompare:FormulaNode () {
        def left:FormulaNode (this.parseConcat())
        this.skipWs()
        while (pos < len) {
            def ch:int (this.peek())
            def op:string ""
            if (ch == 60) {
                this.next()
                if ((this.peek()) == 61) {
                    this.next()
                    op = "<="
                } {
                    if ((this.peek()) == 62) {
                        this.next()
                        op = "<>"
                    } {
                        op = "<"
                    }
                }
            } {
                if (ch == 62) {
                    this.next()
                    if ((this.peek()) == 61) {
                        this.next()
                        op = ">="
                    } {
                        op = ">"
                    }
                } {
                    if (ch == 61) {
                        this.next()
                        op = "="
                    } {
                        break
                    }
                }
            }
            def right:FormulaNode (this.parseConcat())
            def b:FormulaNode (new FormulaNode)
            b.kind = 6
            b.op = op
            push b.kids left
            push b.kids right
            left = b
            this.skipWs()
        }
        return left
    }

    fn parseConcat:FormulaNode () {
        def left:FormulaNode (this.parseAdd())
        this.skipWs()
        while ((this.peek()) == 38) {
            this.next()
            def right:FormulaNode (this.parseAdd())
            def b:FormulaNode (new FormulaNode)
            b.kind = 6
            b.op = "&"
            push b.kids left
            push b.kids right
            left = b
            this.skipWs()
        }
        return left
    }

    fn parseAdd:FormulaNode () {
        def left:FormulaNode (this.parseMul())
        this.skipWs()
        while (true) {
            def ch:int (this.peek())
            if ((ch != 43) && (ch != 45)) {
                break
            }
            this.next()
            def right:FormulaNode (this.parseMul())
            def b:FormulaNode (new FormulaNode)
            b.kind = 6
            if (ch == 43) {
                b.op = "+"
            } {
                b.op = "-"
            }
            push b.kids left
            push b.kids right
            left = b
            this.skipWs()
        }
        return left
    }

    fn parseMul:FormulaNode () {
        def left:FormulaNode (this.parsePow())
        this.skipWs()
        while (true) {
            def ch:int (this.peek())
            if ((ch != 42) && (ch != 47)) {
                break
            }
            this.next()
            def right:FormulaNode (this.parsePow())
            def b:FormulaNode (new FormulaNode)
            b.kind = 6
            if (ch == 42) {
                b.op = "*"
            } {
                b.op = "/"
            }
            push b.kids left
            push b.kids right
            left = b
            this.skipWs()
        }
        return left
    }

    fn parsePow:FormulaNode () {
        def left:FormulaNode (this.parseUnary())
        this.skipWs()
        if ((this.peek()) == 94) {
            this.next()
            def right:FormulaNode (this.parseUnary())
            def b:FormulaNode (new FormulaNode)
            b.kind = 6
            b.op = "^"
            push b.kids left
            push b.kids right
            return b
        }
        return left
    }

    fn parseUnary:FormulaNode () {
        this.skipWs()
        def ch:int (this.peek())
        if ((ch == 43) || (ch == 45)) {
            this.next()
            def kid:FormulaNode (this.parseUnary())
            def u:FormulaNode (new FormulaNode)
            u.kind = 5
            if (ch == 45) {
                u.op = "-"
            } {
                u.op = "+"
            }
            push u.kids kid
            return u
        }
        return (this.parsePrimary())
    }

    fn parsePrimary:FormulaNode () {
        this.skipWs()
        def ch:int (this.peek())
        if (ch < 0) {
            ok = false
            err = "#VALUE!"
            def e:FormulaNode (new FormulaNode)
            e.kind = 8
            e.text = "#VALUE!"
            return e
        }
        ; number
        if (((ch >= 48) && (ch <= 57)) || (ch == 46)) {
            return (this.parseNumber())
        }
        ; string
        if (ch == 34) {
            return (this.parseString())
        }
        ; quoted sheet name: 'My Sheet'!A1
        if (ch == 39) {
            return (this.parseQuotedSheetRef())
        }
        ; paren
        if (ch == 40) {
            this.next()
            def inner:FormulaNode (this.parseExpr())
            this.skipWs()
            if ((this.peek()) == 41) {
                this.next()
            } {
                ok = false
                err = "#VALUE!"
            }
            return inner
        }
        ; name / sheet / cell / function
        if (((ch >= 65) && (ch <= 90)) || ((ch >= 97) && (ch <= 122)) || (ch == 95) || (ch == 36)) {
            return (this.parseNameOrRef())
        }
        ok = false
        err = "#VALUE!"
        def e2:FormulaNode (new FormulaNode)
        e2.kind = 8
        e2.text = "#VALUE!"
        return e2
    }

    fn parseNumber:FormulaNode () {
        def start:int pos
        while (pos < len) {
            def ch:int (charAt src pos)
            if (((ch >= 48) && (ch <= 57)) || (ch == 46)) {
                pos = (pos + 1)
            } {
                break
            }
        }
        def s:string (substring src start pos)
        def n:FormulaNode (new FormulaNode)
        n.kind = 0
        def p@(optional):double (to_double s)
        if p {
            n.num = (unwrap p)
        } {
            ok = false
            err = "#VALUE!"
            n.kind = 8
            n.text = "#VALUE!"
        }
        return n
    }

    fn parseString:FormulaNode () {
        this.next()
        def out:string ""
        while (pos < len) {
            def ch:int (this.next())
            if (ch == 34) {
                if ((this.peek()) == 34) {
                    this.next()
                    out = (out + "\"")
                } {
                    break
                }
            } {
                out = (out + (this.lastAsText()))
            }
        }
        def n:FormulaNode (new FormulaNode)
        n.kind = 1
        n.text = out
        return n
    }

    ; --- structured references ------------------------------------------------
    ; `Table1[Amount]`, `Table1[[#This Row],[CategoryID]]`, `Table1[@Amount]`,
    ; `Table1[[Amount]:[Price]]`, `Table1[#All]`.
    ;
    ; The grammar is small but the bracketing is fiddly: the OUTER brackets
    ; wrap everything, and a reference naming more than one thing wraps each of
    ; them in brackets of their own and separates them with a comma. So
    ; `Table1[Amount]` and `Table1[[Amount]]` are the same reference written
    ; two ways, and both have to read.
    ;
    ; Inside a name, `'` escapes a character that would otherwise be syntax —
    ; a column genuinely called "#Amount" is written `['#Amount]`. Rare, and
    ; cheap to honour.
    fn parseStructured:FormulaNode (tableName:string) {
        def n:FormulaNode (new FormulaNode)
        n.kind = 9
        n.tableName = tableName
        def inner:string (this.readBracketed())
        if (ok == false) {
            def e:FormulaNode (new FormulaNode)
            e.kind = 8
            e.text = "#VALUE!"
            return e
        }
        def parts:[string]
        FormulaParser.splitTopLevel(inner parts)
        def i:int 0
        while (i < (array_length parts)) {
            def raw:string (itemAt parts i)
            def piece:string (FormulaParser.stripOuterBrackets(raw))
            if ((strlen piece) > 0) {
                if ((charAt piece 0) == 64) {
                    ; `@Amount` — the 2010 spelling of "this row, that column".
                    n.tableItem = "#this row"
                    n.tableAtSign = true
                    def rest:string (substring piece 1 (strlen piece))
                    rest = (FormulaParser.stripOuterBrackets(rest))
                    if ((strlen rest) > 0) {
                        n.tableCol1 = (FormulaParser.unescapeColumn(rest))
                    }
                } {
                    if ((charAt piece 0) == 35) {
                        n.tableItem = (to_lowercase piece)
                    } {
                        ; A column, or a span of them: `[Amount]:[Price]`.
                        def cut:int (FormulaParser.topLevelColon(raw))
                        if (cut >= 0) {
                            def a:string (FormulaParser.stripOuterBrackets((substring raw 0 cut)))
                            def b:string (FormulaParser.stripOuterBrackets((substring raw (cut + 1) (strlen raw))))
                            n.tableCol1 = (FormulaParser.unescapeColumn(a))
                            n.tableCol2 = (FormulaParser.unescapeColumn(b))
                        } {
                            n.tableCol1 = (FormulaParser.unescapeColumn(piece))
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return n
    }

    ; From a `[` to its matching `]`, returning what is between them. Nesting
    ; is counted so the outer bracket of `[[#This Row],[Col]]` closes last.
    fn readBracketed:string () {
        if ((this.peek()) != 91) {
            ok = false
            err = "#VALUE!"
            return ""
        }
        this.next()
        def start:int pos
        def depth:int 1
        while (pos < len) {
            def ch:int (charAt src pos)
            if (ch == 39) {
                ; An escape takes the next character with it, whatever it is.
                pos = (pos + 2)
                continue
            }
            if (ch == 91) {
                depth = (depth + 1)
            }
            if (ch == 93) {
                depth = (depth - 1)
                if (depth == 0) {
                    def inner:string (substring src start pos)
                    pos = (pos + 1)
                    return inner
                }
            }
            pos = (pos + 1)
        }
        ok = false
        err = "#VALUE!"
        return ""
    }

    ; Split on commas that are not inside brackets.
    sfn splitTopLevel:void (s:string out:[string]) {
        def depth:int 0
        def start:int 0
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def ch:int (charAt s i)
            if (ch == 39) {
                i = (i + 2)
                continue
            }
            if (ch == 91) {
                depth = (depth + 1)
            }
            if (ch == 93) {
                depth = (depth - 1)
            }
            if ((ch == 44) && (depth == 0)) {
                push out (substring s start i)
                start = (i + 1)
            }
            i = (i + 1)
        }
        push out (substring s start n)
    }

    ; The position of a `:` that is not inside brackets, or -1.
    sfn topLevelColon:int (s:string) {
        def depth:int 0
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def ch:int (charAt s i)
            if (ch == 39) {
                i = (i + 2)
                continue
            }
            if (ch == 91) {
                depth = (depth + 1)
            }
            if (ch == 93) {
                depth = (depth - 1)
            }
            if ((ch == 58) && (depth == 0)) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; `[Amount]` → `Amount`; anything else is handed back untouched. Only one
    ; layer comes off, and only when the brackets wrap the WHOLE piece — in
    ; `[Amount]:[Price]` they do not.
    sfn stripOuterBrackets:string (s:string) {
        def a:int 0
        def b:int (strlen s)
        while (a < b) {
            def ch:int (charAt s a)
            if ((ch == 32) || (ch == 9)) {
                a = (a + 1)
            } {
                break
            }
        }
        while (b > a) {
            def ch2:int (charAt s (b - 1))
            if ((ch2 == 32) || (ch2 == 9)) {
                b = (b - 1)
            } {
                break
            }
        }
        if ((b - a) < 2) {
            return (substring s a b)
        }
        if ((charAt s a) != 91) {
            return (substring s a b)
        }
        ; Only if this `[` is closed by the LAST character.
        def depth:int 0
        def i:int a
        while (i < b) {
            def ch3:int (charAt s i)
            if (ch3 == 39) {
                i = (i + 2)
                continue
            }
            if (ch3 == 91) {
                depth = (depth + 1)
            }
            if (ch3 == 93) {
                depth = (depth - 1)
                if (depth == 0) {
                    if (i == (b - 1)) {
                        return (substring s (a + 1) (b - 1))
                    }
                    return (substring s a b)
                }
            }
            i = (i + 1)
        }
        return (substring s a b)
    }

    ; `'` before a character means the character, not the syntax.
    sfn unescapeColumn:string (s:string) {
        if ((indexOf s "'") < 0) {
            return s
        }
        def out:string ""
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def ch:int (charAt s i)
            if ((ch == 39) && ((i + 1) < n)) {
                str_append out (substring s (i + 1) (i + 2))
                i = (i + 2)
            } {
                str_append out (substring s i (i + 1))
                i = (i + 1)
            }
        }
        return out
    }

    fn parseNameOrRef:FormulaNode () {
        ; Optional Sheet! prefix
        def sheet:string ""
        def start:int pos
        ; read identifier or $A$1
        while (pos < len) {
            def ch:int (charAt src pos)
            if (((ch >= 65) && (ch <= 90)) || ((ch >= 97) && (ch <= 122)) || ((ch >= 48) && (ch <= 57)) || (ch == 36) || (ch == 95) || (ch == 46)) {
                pos = (pos + 1)
            } {
                break
            }
        }
        def ident:string (substring src start pos)
        this.skipWs()
        if ((this.peek()) == 33) {
            ; sheet name
            this.next()
            sheet = ident
            start = pos
            while (pos < len) {
                def ch2:int (charAt src pos)
                if (((ch2 >= 65) && (ch2 <= 90)) || ((ch2 >= 97) && (ch2 <= 122)) || ((ch2 >= 48) && (ch2 <= 57)) || (ch2 == 36)) {
                    pos = (pos + 1)
                } {
                    break
                }
            }
            ident = (substring src start pos)
            this.skipWs()
        }
        ; A structured reference: `Table1[...]`. Checked before the function
        ; call, because a `[` can only ever start one of these, and after the
        ; sheet prefix, because `Sheet1!Table1[...]` is not a thing — a table
        ; name is already workbook-wide.
        if ((this.peek()) == 91) {
            if ((strlen sheet) == 0) {
                return (this.parseStructured(ident))
            }
        }
        ; function call?
        if ((this.peek()) == 40) {
            this.next()
            def call:FormulaNode (new FormulaNode)
            call.kind = 7
            call.fnName = (FormulaParser.upper(ident))
            this.skipWs()
            if ((this.peek()) != 41) {
                while (true) {
                    def arg:FormulaNode (this.parseExpr())
                    push call.kids arg
                    this.skipWs()
                    if ((this.peek()) == 44) {
                        this.next()
                        this.skipWs()
                    } {
                        break
                    }
                }
            }
            if ((this.peek()) == 41) {
                this.next()
            } {
                ok = false
                err = "#VALUE!"
            }
            return call
        }
        ; Boolean literals
        def upIdent:string (FormulaParser.upper(ident))
        if (upIdent == "TRUE") {
            def bt:FormulaNode (new FormulaNode)
            bt.kind = 2
            bt.flag = true
            return bt
        }
        if (upIdent == "FALSE") {
            def bf:FormulaNode (new FormulaNode)
            bf.kind = 2
            bf.flag = false
            return bf
        }
        ; cell or range
        def r1:[int]
        def c1:[int]
        def ar1:[boolean]
        def ac1:[boolean]
        FormulaParser.parseA1(ident r1 c1 ar1 ac1)
        def cell:FormulaNode (new FormulaNode)
        cell.kind = 3
        cell.sheet = sheet
        cell.row = (itemAt r1 0)
        cell.col = (itemAt c1 0)
        cell.absRow = (itemAt ar1 0)
        cell.absCol = (itemAt ac1 0)
        this.skipWs()
        if ((this.peek()) == 58) {
            this.next()
            start = pos
            while (pos < len) {
                def ch3:int (charAt src pos)
                if (((ch3 >= 65) && (ch3 <= 90)) || ((ch3 >= 97) && (ch3 <= 122)) || ((ch3 >= 48) && (ch3 <= 57)) || (ch3 == 36)) {
                    pos = (pos + 1)
                } {
                    break
                }
            }
            def ident2:string (substring src start pos)
            def r2:[int]
            def c2:[int]
            def ar2:[boolean]
            def ac2:[boolean]
            FormulaParser.parseA1(ident2 r2 c2 ar2 ac2)
            cell.kind = 4
            cell.row2 = (itemAt r2 0)
            cell.col2 = (itemAt c2 0)
            cell.absRow2 = (itemAt ar2 0)
            cell.absCol2 = (itemAt ac2 0)
        }
        return cell
    }

    fn parseQuotedSheetRef:FormulaNode () {
        ; leading '
        this.next()
        def sheet:string ""
        while (pos < len) {
            def ch:int (this.next())
            if (ch == 39) {
                if ((this.peek()) == 39) {
                    this.next()
                    sheet = (sheet + "'")
                } {
                    break
                }
            } {
                sheet = (sheet + (this.lastAsText()))
            }
        }
        this.skipWs()
        if ((this.peek()) != 33) {
            ok = false
            err = "#REF!"
            def e:FormulaNode (new FormulaNode)
            e.kind = 8
            e.text = "#REF!"
            return e
        }
        this.next()
        this.skipWs()
        def start:int pos
        while (pos < len) {
            def ch2:int (charAt src pos)
            if (((ch2 >= 65) && (ch2 <= 90)) || ((ch2 >= 97) && (ch2 <= 122)) || ((ch2 >= 48) && (ch2 <= 57)) || (ch2 == 36)) {
                pos = (pos + 1)
            } {
                break
            }
        }
        def ident:string (substring src start pos)
        def r1:[int]
        def c1:[int]
        def ar1:[boolean]
        def ac1:[boolean]
        FormulaParser.parseA1(ident r1 c1 ar1 ac1)
        def cell:FormulaNode (new FormulaNode)
        cell.kind = 3
        cell.sheet = sheet
        cell.row = (itemAt r1 0)
        cell.col = (itemAt c1 0)
        cell.absRow = (itemAt ar1 0)
        cell.absCol = (itemAt ac1 0)
        this.skipWs()
        if ((this.peek()) == 58) {
            this.next()
            start = pos
            while (pos < len) {
                def ch3:int (charAt src pos)
                if (((ch3 >= 65) && (ch3 <= 90)) || ((ch3 >= 97) && (ch3 <= 122)) || ((ch3 >= 48) && (ch3 <= 57)) || (ch3 == 36)) {
                    pos = (pos + 1)
                } {
                    break
                }
            }
            def ident2:string (substring src start pos)
            def r2:[int]
            def c2:[int]
            def ar2:[boolean]
            def ac2:[boolean]
            FormulaParser.parseA1(ident2 r2 c2 ar2 ac2)
            cell.kind = 4
            cell.row2 = (itemAt r2 0)
            cell.col2 = (itemAt c2 0)
            cell.absRow2 = (itemAt ar2 0)
            cell.absCol2 = (itemAt ac2 0)
        }
        return cell
    }

    sfn upper:string (s:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def ch:int (charAt s i)
            if ((ch >= 97) && (ch <= 122)) {
                out = (out + (strfromcode (ch - 32)))
            } {
                ; Copied, not rebuilt — see `lastAsText`.
                out = (out + (substring s i (i + 1)))
            }
            i = (i + 1)
        }
        return out
    }

    ; Parse A1 / $A$1 / A$1 / $A1 into 0-based row/col + absolute flags.
    sfn parseA1:void (ref:string rowOut:[int] colOut:[int] absRowOut:[boolean] absColOut:[boolean]) {
        clear rowOut
        clear colOut
        clear absRowOut
        clear absColOut
        def i:int 0
        def n:int (strlen ref)
        def col:int 0
        def sawCol:boolean false
        def absCol:boolean false
        def absRow:boolean false
        while (i < n) {
            def ch:int (charAt ref i)
            if (ch == 36) {
                def j:int (i + 1)
                if (j < n) {
                    def nch:int (charAt ref j)
                    if (((nch >= 65) && (nch <= 90)) || ((nch >= 97) && (nch <= 122))) {
                        absCol = true
                    } {
                        if ((nch >= 48) && (nch <= 57)) {
                            absRow = true
                        }
                    }
                }
                i = (i + 1)
            } {
                if ((ch >= 65) && (ch <= 90)) {
                    col = ((col * 26) + ((ch - 65) + 1))
                    sawCol = true
                    i = (i + 1)
                } {
                    if ((ch >= 97) && (ch <= 122)) {
                        col = ((col * 26) + ((ch - 97) + 1))
                        sawCol = true
                        i = (i + 1)
                    } {
                        break
                    }
                }
            }
        }
        if sawCol {
            col = (col - 1)
        }
        def row:int 0
        def sawRow:boolean false
        while (i < n) {
            def ch2:int (charAt ref i)
            if (ch2 == 36) {
                absRow = true
                i = (i + 1)
            } {
                if ((ch2 >= 48) && (ch2 <= 57)) {
                    row = ((row * 10) + (ch2 - 48))
                    sawRow = true
                    i = (i + 1)
                } {
                    break
                }
            }
        }
        if sawRow {
            row = (row - 1)
        }
        push rowOut row
        push colOut col
        push absRowOut absRow
        push absColOut absCol
    }

    sfn colLetters:string (col:int) {
        def c:int (col + 1)
        def out:string ""
        while (c > 0) {
            def rem:int ((c - 1) - ((idiv (c - 1) 26) * 26))
            out = ((strfromcode (65 + rem)) + out)
            c = (idiv (c - 1) 26)
        }
        return out
    }

    sfn formatA1:string (row:int col:int absRow:boolean absCol:boolean) {
        def s:string ""
        if absCol {
            s = (s + "$")
        }
        s = (s + (FormulaParser.colLetters(col)))
        if absRow {
            s = (s + "$")
        }
        s = (s + (to_string (row + 1)))
        return s
    }

    sfn needsSheetQuotes:boolean (name:string) {
        def i:int 0
        def n:int (strlen name)
        while (i < n) {
            def ch:int (charAt name i)
            if ((ch == 32) || (ch == 39) || (ch == 33)) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn formatSheetPrefix:string (sheet:string) {
        if ((strlen sheet) == 0) {
            return ""
        }
        def q:boolean (FormulaParser.needsSheetQuotes(sheet))
        if q {
            def esc:string ""
            def i:int 0
            def n:int (strlen sheet)
            while (i < n) {
                def ch:int (charAt sheet i)
                if (ch == 39) {
                    esc = (esc + "''")
                } {
                    esc = (esc + (substring sheet i (i + 1)))
                }
                i = (i + 1)
            }
            return (("'" + esc) + "'!")
        }
        return (sheet + "!")
    }

    ; Shift relative refs by (dx, dy). Absolute flags stay fixed.
    ; Fill and copy: shift the references that are written as positions.
    ;
    ; A structured reference (kind 9) is deliberately NOT among them. It names
    ; a table and a column, and `[#This Row]` re-anchors itself on whatever row
    ; it lands on — shifting it would be shifting a name. That is the whole
    ; reason people write them, and it falls out of this function touching only
    ; kinds 3 and 4.
    sfn translateNode:void (n:FormulaNode dx:int dy:int) {
        if ((n.kind == 3) || (n.kind == 4)) {
            if (n.absRow == false) {
                n.row = (n.row + dy)
            }
            if (n.absCol == false) {
                n.col = (n.col + dx)
            }
            if (n.kind == 4) {
                if (n.absRow2 == false) {
                    n.row2 = (n.row2 + dy)
                }
                if (n.absCol2 == false) {
                    n.col2 = (n.col2 + dx)
                }
            }
        }
        def i:int 0
        def kn:int (array_length n.kids)
        while (i < kn) {
            FormulaParser.translateNode((itemAt n.kids i) dx dy)
            i = (i + 1)
        }
    }

    ; Operator precedence, mirroring the parse ladder below:
    ;   compare < concat < add < mul < pow < unary
    sfn opPrec:int (op:string) {
        if (op == "^") {
            return 5
        }
        if ((op == "*") || (op == "/")) {
            return 4
        }
        if ((op == "+") || (op == "-")) {
            return 3
        }
        if (op == "&") {
            return 2
        }
        return 1
    }

    sfn nodePrec:int (n:FormulaNode) {
        if (n.kind == 6) {
            return (FormulaParser.opPrec(n.op))
        }
        if (n.kind == 5) {
            return 6
        }
        return 100
    }

    ; Adjust references for a column insert / delete on one sheet.
    ;   at    the column the operation happened at
    ;   delta +1 for an insert, -1 for a delete
    ;   sheet "" matches references with no sheet prefix (same sheet)
    ; A reference to a DELETED column cannot be repaired — it becomes #REF!,
    ; exactly as Excel does, rather than silently pointing at the neighbour.
    ; allowUnprefixed: true on the sheet being structurally edited (local
    ; A1 refs move with it). False on other sheets — only SheetName!A1 refs
    ; that name the edited sheet should shift; their local A1 must stay put.
    sfn adjustColsNode:boolean (n:FormulaNode sheetName:string at:int delta:int allowUnprefixed:boolean) {
        def broke:boolean false
        if ((n.kind == 3) || (n.kind == 4)) {
            def applies:boolean false
            if ((strlen n.sheet) == 0) {
                applies = allowUnprefixed
            } {
                if (n.sheet == sheetName) {
                    applies = true
                }
            }
            if applies {
                if (delta < 0) {
                    if (n.kind == 3) {
                        if (n.col == at) {
                            broke = true
                        }
                    } {
                        ; A range collapses only when the whole span goes.
                        if ((n.col == at) && (n.col2 == at)) {
                            broke = true
                        }
                    }
                }
                if (broke == false) {
                    if (n.col >= at) {
                        def nc:int (n.col + delta)
                        if (nc < 0) {
                            nc = 0
                        }
                        n.col = nc
                    }
                    if (n.kind == 4) {
                        if (n.col2 >= at) {
                            def nc2:int (n.col2 + delta)
                            if (nc2 < 0) {
                                nc2 = 0
                            }
                            n.col2 = nc2
                        }
                    }
                }
            }
        }
        def i:int 0
        def kn:int (array_length n.kids)
        while (i < kn) {
            if (FormulaParser.adjustColsNode((itemAt n.kids i) sheetName at delta allowUnprefixed)) {
                broke = true
            }
            i = (i + 1)
        }
        return broke
    }

    ; The column walk, transposed. Same rules: a reference AT a deleted line
    ; breaks, a reference past it shifts, and a range breaks only when its
    ; whole span goes.
    ; --- reordering the rows --------------------------------------------------
    ; Sorting MOVES cells. A formula travels with its row — `reorderRowsRaw`
    ; carries the text along — and its references do not, so `B3+C3+D3` on the
    ; Rent row still added row 3 after Rent moved to row 6. Every total in the
    ; sheet then quietly belonged to a different row, which is worse than a
    ; sort that does nothing: the numbers are wrong and they look fine.
    ;
    ; `newRowOf[old]` is where the row that was at `old` ended up. A reference
    ; to a moved cell follows the cell — absolute as well as relative, because
    ; the cell physically MOVED, which is the cut-and-paste rule rather than
    ; the fill-down one.
    ;
    ; A RANGE is the interesting case. `SUM(B3:B7)` over the whole sorted block
    ; must stay `SUM(B3:B7)`: the block still holds the same rows, only in a
    ; different order, so remapping its ends would shrink it to an arbitrary
    ; sub-range. So a range whose rows map ONTO THEMSELVES is left alone, and
    ; only one that straddles the edge of what moved has its ends remapped.
    sfn remapRowOf:int (newRowOf:[int] row:int) {
        if (row < 0) {
            return row
        }
        if (row >= (array_length newRowOf)) {
            return row
        }
        return (itemAt newRowOf row)
    }

    sfn rangeIsClosed:boolean (newRowOf:[int] r0:int r1:int) {
        if (r1 < r0) {
            return false
        }
        def lo:int -1
        def hi:int -1
        def r:int r0
        while (r <= r1) {
            def m:int (FormulaParser.remapRowOf(newRowOf r))
            if (r == r0) {
                lo = m
                hi = m
            } {
                if (m < lo) {
                    lo = m
                }
                if (m > hi) {
                    hi = m
                }
            }
            r = (r + 1)
        }
        if (lo != r0) {
            return false
        }
        return (hi == r1)
    }

    sfn remapRowsNode:boolean (n:FormulaNode sheetName:string newRowOf:[int] allowUnprefixed:boolean) {
        def touched:boolean false
        if ((n.kind == 3) || (n.kind == 4)) {
            def applies:boolean false
            if ((strlen n.sheet) == 0) {
                applies = allowUnprefixed
            } {
                if ((SheetTable.fold(n.sheet)) == (SheetTable.fold(sheetName))) {
                    applies = true
                }
            }
            if applies {
                if (n.kind == 3) {
                    def nr:int (FormulaParser.remapRowOf(newRowOf n.row))
                    if (nr != n.row) {
                        n.row = nr
                        touched = true
                    }
                } {
                    if ((FormulaParser.rangeIsClosed(newRowOf n.row n.row2)) == false) {
                        def a:int (FormulaParser.remapRowOf(newRowOf n.row))
                        def b:int (FormulaParser.remapRowOf(newRowOf n.row2))
                        if (b < a) {
                            def t:int a
                            a = b
                            b = t
                        }
                        if ((a != n.row) || (b != n.row2)) {
                            n.row = a
                            n.row2 = b
                            touched = true
                        }
                    }
                }
            }
        }
        def i:int 0
        def kn:int (array_length n.kids)
        while (i < kn) {
            if (FormulaParser.remapRowsNode((itemAt n.kids i) sheetName newRowOf allowUnprefixed)) {
                touched = true
            }
            i = (i + 1)
        }
        return touched
    }

    ; The rewritten formula, or "" when it did not need rewriting or could not
    ; be parsed — either way the caller leaves that cell alone.
    sfn remapRows:string (expr:string sheetName:string newRowOf:[int] allowUnprefixed:boolean) {
        def p:FormulaParser (new FormulaParser)
        def ast:FormulaNode (p.parse(expr))
        if (p.ok == false) {
            return ""
        }
        if ((FormulaParser.remapRowsNode(ast sheetName newRowOf allowUnprefixed)) == false) {
            return ""
        }
        return (FormulaParser.serializeNode(ast))
    }

    sfn adjustRowsNode:boolean (n:FormulaNode sheetName:string at:int delta:int allowUnprefixed:boolean) {
        def broke:boolean false
        if ((n.kind == 3) || (n.kind == 4)) {
            def applies:boolean false
            if ((strlen n.sheet) == 0) {
                applies = allowUnprefixed
            } {
                if (n.sheet == sheetName) {
                    applies = true
                }
            }
            if applies {
                if (delta < 0) {
                    if (n.kind == 3) {
                        if (n.row == at) {
                            broke = true
                        }
                    } {
                        if ((n.row == at) && (n.row2 == at)) {
                            broke = true
                        }
                    }
                }
                if (broke == false) {
                    if (n.row >= at) {
                        def nr:int (n.row + delta)
                        if (nr < 0) {
                            nr = 0
                        }
                        n.row = nr
                    }
                    if (n.kind == 4) {
                        if (n.row2 >= at) {
                            def nr2:int (n.row2 + delta)
                            if (nr2 < 0) {
                                nr2 = 0
                            }
                            n.row2 = nr2
                        }
                    }
                }
            }
        }
        def i:int 0
        def kn:int (array_length n.kids)
        while (i < kn) {
            if (FormulaParser.adjustRowsNode((itemAt n.kids i) sheetName at delta allowUnprefixed)) {
                broke = true
            }
            i = (i + 1)
        }
        return broke
    }

    ; --- renaming a sheet -----------------------------------------------------
    ; A cross-sheet reference names its sheet in TEXT — `Costs!B4`, or
    ; `'Q3 Forecast'!B4` when the name needs quoting — so renaming a sheet and
    ; leaving the formulas alone turns every one of them into `#NAME?`. Excel
    ; rewrites them, and so does this: parse, swap the name on every node that
    ; carries it, serialize back. Going through the AST rather than the text is
    ; what keeps `SUM(Costs!B4)` apart from a string literal that happens to
    ; say "Costs!", and what re-quotes a name that has become "Q3 Costs".
    sfn renameSheetNode:boolean (n:FormulaNode was:string now:string) {
        def touched:boolean false
        if ((strlen n.sheet) > 0) {
            if ((SheetTable.fold(n.sheet)) == (SheetTable.fold(was))) {
                n.sheet = now
                touched = true
            }
        }
        def i:int 0
        while (i < (array_length n.kids)) {
            if (FormulaParser.renameSheetNode((itemAt n.kids i) was now)) {
                touched = true
            }
            i = (i + 1)
        }
        return touched
    }

    ; The rewritten formula, or "" when it did not need rewriting or could not
    ; be parsed — either way the caller leaves the cell alone, which is the
    ; right answer for both.
    sfn renameSheet:string (expr:string was:string now:string) {
        def p:FormulaParser (new FormulaParser)
        def ast:FormulaNode (p.parse(expr))
        if (p.ok == false) {
            return ""
        }
        if ((FormulaParser.renameSheetNode(ast was now)) == false) {
            return ""
        }
        return (FormulaParser.serializeNode(ast))
    }

    sfn adjustRows:string (expr:string sheetName:string at:int delta:int allowUnprefixed:boolean) {
        def p:FormulaParser (new FormulaParser)
        def ast:FormulaNode (p.parse(expr))
        if (p.ok == false) {
            return ""
        }
        def broke:boolean (FormulaParser.adjustRowsNode(ast sheetName at delta allowUnprefixed))
        if broke {
            return "#REF!"
        }
        return (FormulaParser.serializeNode(ast))
    }

    ; Returns the rewritten formula, or "#REF!" when a reference was destroyed.
    ; "" means the expression could not be parsed and should be left alone.
    sfn adjustColumns:string (expr:string sheetName:string at:int delta:int allowUnprefixed:boolean) {
        def p:FormulaParser (new FormulaParser)
        def ast:FormulaNode (p.parse(expr))
        if (p.ok == false) {
            return ""
        }
        def broke:boolean (FormulaParser.adjustColsNode(ast sheetName at delta allowUnprefixed))
        if broke {
            return "#REF!"
        }
        return (FormulaParser.serializeNode(ast))
    }

    sfn serializeNode:string (n:FormulaNode) {
        if (n.kind == 8) {
            return n.text
        }
        if (n.kind == 0) {
            def iv:int (to_int n.num)
            if ((to_double iv) == n.num) {
                return (to_string iv)
            }
            return (to_string n.num)
        }
        if (n.kind == 1) {
            return (("\"" + n.text) + "\"")
        }
        if (n.kind == 2) {
            def bf:boolean n.flag
            if bf {
                return "TRUE"
            }
            return "FALSE"
        }
        if ((n.kind == 3) || (n.kind == 4)) {
            def s:string (FormulaParser.formatSheetPrefix(n.sheet))
            s = (s + (FormulaParser.formatA1(n.row n.col n.absRow n.absCol)))
            if (n.kind == 4) {
                s = (s + ":")
                s = (s + (FormulaParser.formatA1(n.row2 n.col2 n.absRow2 n.absCol2)))
            }
            return s
        }
        if (n.kind == 5) {
            def k0:FormulaNode (itemAt n.kids 0)
            def s0:string (FormulaParser.serializeNode(k0))
            if ((FormulaParser.nodePrec(k0)) < 6) {
                s0 = (("(" + s0) + ")")
            }
            return (n.op + s0)
        }
        ; Parenthesize only where precedence (or left-associativity on the right
        ; operand) requires it, so a filled "=A2+B2" stays "=A3+B3".
        if (n.kind == 6) {
            def lk:FormulaNode (itemAt n.kids 0)
            def rk:FormulaNode (itemAt n.kids 1)
            def p:int (FormulaParser.opPrec(n.op))
            def L:string (FormulaParser.serializeNode(lk))
            def R:string (FormulaParser.serializeNode(rk))
            if ((FormulaParser.nodePrec(lk)) < p) {
                L = (("(" + L) + ")")
            }
            if ((FormulaParser.nodePrec(rk)) <= p) {
                R = (("(" + R) + ")")
            }
            return ((L + n.op) + R)
        }
        if (n.kind == 7) {
            def out:string (n.fnName + "(")
            def i:int 0
            def kn:int (array_length n.kids)
            while (i < kn) {
                if (i > 0) {
                    out = (out + ",")
                }
                out = (out + (FormulaParser.serializeNode((itemAt n.kids i))))
                i = (i + 1)
            }
            return (out + ")")
        }
        if (n.kind == 9) {
            return (FormulaParser.serializeTableRef(n))
        }
        return ""
    }

    ; A structured reference, written back the way the file spelled it. Which
    ; spelling that is matters more than it looks: `Table1[@Amount]` and
    ; `Table1[[#This Row],[Amount]]` mean the same thing, Excel 2007 wrote the
    ; second and Excel writes the first, and a round trip that swapped one for
    ; the other would rewrite formulas in a file it was only asked to open.
    sfn serializeTableRef:string (n:FormulaNode) {
        def out:string n.tableName
        str_append out "["
        def hasItem:boolean ((strlen n.tableItem) > 0)
        def hasCol:boolean ((strlen n.tableCol1) > 0)
        def hasSpan:boolean ((strlen n.tableCol2) > 0)
        if (n.tableAtSign && hasCol) {
            str_append out "@"
            str_append out (FormulaParser.escapeColumn(n.tableCol1))
            str_append out "]"
            return out
        }
        def needBrackets:boolean false
        if (hasItem && hasCol) {
            needBrackets = true
        }
        if hasSpan {
            needBrackets = true
        }
        if hasItem {
            if needBrackets {
                str_append out "["
                str_append out (FormulaParser.itemLabel(n.tableItem))
                str_append out "]"
            } {
                str_append out (FormulaParser.itemLabel(n.tableItem))
            }
        }
        if (hasItem && hasCol) {
            str_append out ","
        }
        if hasCol {
            if needBrackets {
                str_append out "["
                str_append out (FormulaParser.escapeColumn(n.tableCol1))
                str_append out "]"
            } {
                str_append out (FormulaParser.escapeColumn(n.tableCol1))
            }
        }
        if hasSpan {
            str_append out ":["
            str_append out (FormulaParser.escapeColumn(n.tableCol2))
            str_append out "]"
        }
        str_append out "]"
        return out
    }

    ; Specifiers are held folded so comparisons are simple, and written back in
    ; the capitalisation Excel uses.
    sfn itemLabel:string (item:string) {
        if (item == "#this row") {
            return "#This Row"
        }
        if (item == "#headers") {
            return "#Headers"
        }
        if (item == "#totals") {
            return "#Totals"
        }
        if (item == "#data") {
            return "#Data"
        }
        if (item == "#all") {
            return "#All"
        }
        return item
    }

    sfn escapeColumn:string (s:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def ch:int (charAt s i)
            if ((ch == 91) || (ch == 93) || (ch == 35) || (ch == 39) || (ch == 64)) {
                str_append out "'"
            }
            str_append out (substring s i (i + 1))
            i = (i + 1)
        }
        return out
    }

    ; Translate a formula string by (dx, dy); returns "" on parse failure.
    sfn translateFormula:string (expr:string dx:int dy:int) {
        def p:FormulaParser (new FormulaParser)
        def ast:FormulaNode (p.parse(expr))
        if (p.ok == false) {
            return ""
        }
        FormulaParser.translateNode(ast dx dy)
        return (FormulaParser.serializeNode(ast))
    }
}

; --- dependency graph + evaluator --------------------------------------------

class FormulaEngine {
    def book:WorkbookModel
    def parser:FormulaParser (new FormulaParser)
    ; forward deps: cellKey → "depKey;depKey;..."
    def depsOf:[string:string]
    ; reverse: cellKey → dependents joined
    def usedBy:[string:string]
    def calcValues:[string:string]
    def calcStatus:[string:string]
    def lastError:string ""
    ; What TODAY() and NOW() answer, as a serial. Zero means the host has not
    ; said, and those two functions then return #N/A rather than inventing a
    ; date — a spreadsheet that quietly disagrees with the calendar is worse
    ; than one that admits it does not know.
    def todaySerial:double 0.0
    ; Instrumentation for workbook-scale recalc demos / benches.
    def dirtyMarked:int 0
    def recalculated:int 0
    ; Which cell is being looked at. Only `[#This Row]` needs it — a structured
    ; reference is the one kind of reference whose meaning depends on where it
    ; is written — and threading two more arguments through every level of a
    ; recursive evaluator to serve one node kind would be paid for by every
    ; other kind. Set at the two entry points that know: `evalOne`, and
    ; `registerFormula` before it collects dependencies.
    def curRow:int 0
    def curCol:int 0

    Constructor () {
    }

    fn resetStats:void () {
        dirtyMarked = 0
        recalculated = 0
    }

    fn attach:void (b:WorkbookModel) {
        book = b
        def empty1:[string:string]
        def empty2:[string:string]
        def empty3:[string:string]
        def empty4:[string:string]
        depsOf = empty1
        usedBy = empty2
        calcValues = empty3
        calcStatus = empty4
        this.resetStats()
    }

    fn cellKey:string (sheetIdx:int row:int col:int) {
        return ((((to_string sheetIdx) + "!") + (to_string row)) + "," + (to_string col))
    }

    fn sheetByName:int (name:string) {
        def i:int 0
        def n:int (book.sheetCount())
        def want:string (FormulaFunctions.upper(name))
        while (i < n) {
            def s:SpreadsheetModel (book.sheetAt(i))
            if ((FormulaFunctions.upper(s.name)) == want) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn rebuildAll:void () {
        def empty1:[string:string]
        def empty2:[string:string]
        def empty3:[string:string]
        def empty4:[string:string]
        depsOf = empty1
        usedBy = empty2
        calcValues = empty3
        calcStatus = empty4
        def si:int 0
        def sn:int (book.sheetCount())
        while (si < sn) {
            def sheet:SpreadsheetModel (book.sheetAt(si))
            def i:int 0
            def n:int (array_length sheet.formulaKeys)
            while (i < n) {
                def k:string (itemAt sheet.formulaKeys i)
                def parts:[string] (strsplit k ",")
                if ((array_length parts) >= 2) {
                    def row:int (SpreadsheetModel.parseInt0((itemAt parts 0)))
                    def col:int (SpreadsheetModel.parseInt0((itemAt parts 1)))
                    this.registerFormula(si row col (sheet.getFormula(row col)))
                }
                i = (i + 1)
            }
            si = (si + 1)
        }
        this.recalcAll()
    }

    fn registerFormula:void (sheetIdx:int row:int col:int expr:string) {
        def key:string (this.cellKey(sheetIdx row col))
        this.pruneDeps(key)
        def ast:FormulaNode (parser.parse(expr))
        def depList:[string]
        ; `[#This Row]` resolves against the cell holding the formula, and
        ; dependencies are worked out here rather than at evaluation time, so
        ; this is the other place that has to say which cell that is.
        curRow = row
        curCol = col
        this.collectDeps(ast sheetIdx depList)
        def joined:string ""
        def i:int 0
        def n:int (array_length depList)
        while (i < n) {
            if (i > 0) {
                joined = (joined + ";")
            }
            joined = (joined + (itemAt depList i))
            i = (i + 1)
        }
        set depsOf key joined
        i = 0
        while (i < n) {
            def d:string (itemAt depList i)
            def cur:string ""
            if (has usedBy d) {
                cur = (unwrap (get usedBy d))
            }
            if ((strlen cur) == 0) {
                set usedBy d key
            } {
                set usedBy d (cur + ";" + key)
            }
            i = (i + 1)
        }
        if parser.ok {
            set calcStatus key "pending"
        } {
            set calcStatus key "unsupported"
        }
    }

    ; Remove key from previous reverse edges before re-registering.
    fn pruneDeps:void (key:string) {
        if (has depsOf key) {
            def old:[string]
            this.splitKeys((unwrap (get depsOf key)) old)
            def i:int 0
            def n:int (array_length old)
            while (i < n) {
                def d:string (itemAt old i)
                if (has usedBy d) {
                    def kept:[string]
                    def kids:[string]
                    this.splitKeys((unwrap (get usedBy d)) kids)
                    def j:int 0
                    def kn:int (array_length kids)
                    while (j < kn) {
                        def k:string (itemAt kids j)
                        if (k != key) {
                            push kept k
                        }
                        j = (j + 1)
                    }
                    def joined:string ""
                    j = 0
                    kn = (array_length kept)
                    while (j < kn) {
                        if (j > 0) {
                            joined = (joined + ";")
                        }
                        joined = (joined + (itemAt kept j))
                        j = (j + 1)
                    }
                    set usedBy d joined
                }
                i = (i + 1)
            }
        }
    }

    fn clearFormula:void (sheetIdx:int row:int col:int) {
        def key:string (this.cellKey(sheetIdx row col))
        this.pruneDeps(key)
        if (has depsOf key) {
            set depsOf key ""
        }
        set calcStatus key "cached"
    }

    fn collectDeps:void (n:FormulaNode sheetIdx:int out:[string]) {
        if (n.kind == 9) {
            ; A structured reference depends on the cells it resolves to, and
            ; nothing else can work out which those are. Without this the
            ; formula computes correctly the first time and then never again:
            ; editing an amount inside the table would leave every
            ; `=SUM(Table1[Amount])` showing what it said before.
            def tr:TableRange (this.resolveTableRef(n))
            if ((strlen tr.err) > 0) {
                return
            }
            def rr:int tr.r0
            while (rr <= tr.r1) {
                def cc:int tr.c0
                while (cc <= tr.c1) {
                    push out (this.cellKey(tr.sheetIdx rr cc))
                    cc = (cc + 1)
                }
                rr = (rr + 1)
            }
            return
        }
        if (n.kind == 3) {
            def si:int sheetIdx
            if ((strlen n.sheet) > 0) {
                si = (this.sheetByName(n.sheet))
                if (si < 0) {
                    return
                }
            }
            push out (this.cellKey(si n.row n.col))
            return
        }
        if (n.kind == 4) {
            def si2:int sheetIdx
            if ((strlen n.sheet) > 0) {
                si2 = (this.sheetByName(n.sheet))
                if (si2 < 0) {
                    return
                }
            }
            def r0:int n.row
            def r1:int n.row2
            def c0:int n.col
            def c1:int n.col2
            if (r0 > r1) {
                def t:int r0
                r0 = r1
                r1 = t
            }
            if (c0 > c1) {
                def t2:int c0
                c0 = c1
                c1 = t2
            }
            def r:int r0
            while (r <= r1) {
                def c:int c0
                while (c <= c1) {
                    push out (this.cellKey(si2 r c))
                    c = (c + 1)
                }
                r = (r + 1)
            }
            return
        }
        def i:int 0
        def kn:int (array_length n.kids)
        while (i < kn) {
            this.collectDeps((itemAt n.kids i) sheetIdx out)
            i = (i + 1)
        }
    }

    fn splitKeys:void (joined:string out:[string]) {
        clear out
        if ((strlen joined) == 0) {
            return
        }
        def cur:string ""
        def i:int 0
        def n:int (strlen joined)
        while (i < n) {
            def ch:int (charAt joined i)
            if (ch == 59) {
                if ((strlen cur) > 0) {
                    push out cur
                }
                cur = ""
            } {
                cur = (cur + (substring joined i (i + 1)))
            }
            i = (i + 1)
        }
        if ((strlen cur) > 0) {
            push out cur
        }
    }

    fn markDirty:void (key:string visited:[string:boolean]) {
        if (has visited key) {
            return
        }
        set visited key true
        set calcStatus key "dirty"
        dirtyMarked = (dirtyMarked + 1)
        if (has usedBy key) {
            def kids:[string]
            this.splitKeys((unwrap (get usedBy key)) kids)
            def i:int 0
            def n:int (array_length kids)
            while (i < n) {
                this.markDirty((itemAt kids i) visited)
                i = (i + 1)
            }
        }
    }

    ; Mark everything that reads this cell dirty, without recalculating yet.
    ; Batch editors (paste / fill / delete range / undo) call this per cell and
    ; then recalcDirty() once, instead of recalculating N times.
    fn markEdited:void (sheetIdx:int row:int col:int) {
        def key:string (this.cellKey(sheetIdx row col))
        def visited:[string:boolean]
        ; Mark dependents dirty (not the edited value cell itself — it is already current).
        if (has usedBy key) {
            def kids:[string]
            this.splitKeys((unwrap (get usedBy key)) kids)
            def i:int 0
            def n:int (array_length kids)
            while (i < n) {
                this.markDirty((itemAt kids i) visited)
                i = (i + 1)
            }
        }
    }

    ; Re-read the cell's formula from the sheet and register or clear it in the
    ; dependency graph. Used after undo/redo and paste, where the model changed
    ; underneath the engine.
    fn syncCell:void (sheetIdx:int row:int col:int) {
        def sheet:SpreadsheetModel (book.sheetAt(sheetIdx))
        def f:string (sheet.getFormula(row col))
        if ((strlen f) > 0) {
            this.registerFormula(sheetIdx row col f)
        } {
            this.clearFormula(sheetIdx row col)
        }
        this.markEdited(sheetIdx row col)
    }

    fn onCellEdited:void (sheetIdx:int row:int col:int) {
        this.resetStats()
        this.markEdited(sheetIdx row col)
        this.recalcDirty()
    }

    ; How many formulas ended up in an error state — a cycle, or an expression
    ; that could not be evaluated. Zero is what a healthy sheet reports, and a
    ; test can say so without knowing which cells they were.
    fn errorCount:int () {
        def n:int 0
        def si:int 0
        while (si < (book.sheetCount())) {
            def sheet:SpreadsheetModel (book.sheetAt(si))
            def keys:[string]
            sheet.collectFormulaKeys(si keys)
            def i:int 0
            while (i < (array_length keys)) {
                def k:string (itemAt keys i)
                if (has calcStatus k) {
                    def st:string (unwrap (get calcStatus k))
                    if (st == "error") {
                        n = (n + 1)
                    }
                }
                i = (i + 1)
            }
            si = (si + 1)
        }
        return n
    }

    fn recalcAll:void () {
        def keys:[string]
        ; gather all formula keys from depsOf — iterate sheets
        def si:int 0
        def sn:int (book.sheetCount())
        while (si < sn) {
            def sheet:SpreadsheetModel (book.sheetAt(si))
            sheet.collectFormulaKeys(si keys)
            si = (si + 1)
        }
        def i:int 0
        def n:int (array_length keys)
        while (i < n) {
            set calcStatus (itemAt keys i) "dirty"
            i = (i + 1)
        }
        this.recalcDirty()
    }

    ; Recalculate everything dirty, dependencies first.
    ;
    ; This used to be a sweep: walk every formula in the workbook, evaluate the
    ; ones whose dependencies were already clean, and repeat — up to SIXTY-FOUR
    ; times, after which whatever was left was declared a cycle. A sweep settles
    ; one link of a chain per pass whenever the chain runs against the order the
    ; sheet is walked in, so a column of four hundred subtotals — each reading
    ; the one below it, which is how a report is usually built — got sixty-four
    ; rows deep and then reported #CYCLE! for the other three hundred and
    ; thirty-six. From the outside that looks exactly like sums that "stop being
    ; delegated after a while".
    ;
    ; So it is a depth-first walk now: to evaluate a cell, evaluate what it
    ; depends on first. Depth costs nothing, the work is proportional to the
    ; dependency graph rather than to (formulas x passes), and a cycle is a cell
    ; that is reached again while it is still being computed — which is what a
    ; cycle actually is, rather than what is left over when patience runs out.
    ;
    ; The walk carries its own stack. Recursion would have been shorter and a
    ; four-hundred-deep sheet is a perfectly ordinary thing to open.
    fn recalcDirty:void () {
        def si:int 0
        def sn:int (book.sheetCount())
        while (si < sn) {
            def sheet:SpreadsheetModel (book.sheetAt(si))
            def keys:[string]
            sheet.collectFormulaKeys(si keys)
            def i:int 0
            def n:int (array_length keys)
            while (i < n) {
                def key:string (itemAt keys i)
                if (this.needsWork(key)) {
                    this.resolveFrom(key)
                }
                i = (i + 1)
            }
            si = (si + 1)
        }
    }

    fn needsWork:boolean (key:string) {
        if (has calcStatus key) {
            def st:string (unwrap (get calcStatus key))
            if (st == "dirty") {
                return true
            }
            if (st == "pending") {
                return true
            }
            return false
        }
        ; A formula nothing has said anything about yet still has to be run.
        return (has depsOf key)
    }

    ; One dependency-first walk from `root`. Everything reachable from it that
    ; is dirty comes out either evaluated or, if it is genuinely part of a
    ; cycle, marked as one.
    fn resolveFrom:void (root:string) {
        def stack:[string]
        def phase:[int]
        push stack root
        push phase 0
        while ((array_length stack) > 0) {
            def top:int ((array_length stack) - 1)
            def key:string (itemAt stack top)
            def ph:int (itemAt phase top)
            if (ph == 0) {
                if ((this.needsWork(key)) == false) {
                    removeLast stack
                    removeLast phase
                    continue
                }
                ; "visiting" means: on the stack right now. Anything that reaches
                ; a visiting cell has closed a loop.
                set calcStatus key "visiting"
                set phase top 1
                if (has depsOf key) {
                    def deps:[string]
                    this.splitKeys((unwrap (get depsOf key)) deps)
                    def i:int 0
                    def n:int (array_length deps)
                    while (i < n) {
                        def d:string (itemAt deps i)
                        def dst:string ""
                        if (has calcStatus d) {
                            dst = (unwrap (get calcStatus d))
                        }
                        if (dst == "visiting") {
                            ; The loop is real: this cell cannot be computed.
                            this.markCycle(key)
                        } {
                            if (this.needsWork(d)) {
                                push stack d
                                push phase 0
                            }
                        }
                        i = (i + 1)
                    }
                }
            } {
                removeLast stack
                removeLast phase
                def st:string ""
                if (has calcStatus key) {
                    st = (unwrap (get calcStatus key))
                }
                ; Still visiting means the dependencies are done and nothing
                ; declared it cyclic, so now it can be evaluated.
                if (st == "visiting") {
                    this.evalOne(key)
                }
            }
        }
    }

    ; A cell in a cycle: say so in the cell as well as in the status, because
    ; the value that is there now was computed from something that no longer
    ; holds.
    fn markCycle:void (key:string) {
        set calcStatus key "error"
        set calcValues key "#CYCLE!"
        this.applyResult(key (FormulaValue.fromError("#CYCLE!")))
    }

    fn depsReady:boolean (key:string) {
        if (has depsOf key) {
            def deps:[string]
            this.splitKeys((unwrap (get depsOf key)) deps)
            def i:int 0
            def n:int (array_length deps)
            while (i < n) {
                def d:string (itemAt deps i)
                if (has calcStatus d) {
                    def st:string (unwrap (get calcStatus d))
                    if ((st == "dirty") || (st == "pending")) {
                        return false
                    }
                }
                i = (i + 1)
            }
        }
        return true
    }

    fn evalOne:void (key:string) {
        def parts:[string] (strsplit key "!")
        if ((array_length parts) < 2) {
            return
        }
        def si:int (SpreadsheetModel.parseInt0((itemAt parts 0)))
        def rc:[string] (strsplit (itemAt parts 1) ",")
        if ((array_length rc) < 2) {
            return
        }
        def row:int (SpreadsheetModel.parseInt0((itemAt rc 0)))
        def col:int (SpreadsheetModel.parseInt0((itemAt rc 1)))
        def sheet:SpreadsheetModel (book.sheetAt(si))
        def expr:string (sheet.getFormula(row col))
        if ((strlen expr) == 0) {
            set calcStatus key "cached"
            return
        }
        def ast:FormulaNode (parser.parse(expr))
        if (parser.ok == false) {
            ; keep cached XLSX value
            set calcStatus key "unsupported"
            return
        }
        curRow = row
        curCol = col
        def v:FormulaValue (this.evalNode(ast si))
        recalculated = (recalculated + 1)
        def _eV:boolean (v.isError())
        if _eV {
            set calcStatus key "error"
            set calcValues key v.err
            this.applyResult(key v)
            return
        }
        set calcStatus key "calculated"
        set calcValues key (v.asRaw())
        this.applyResult(key v)
    }

    fn applyResult:void (key:string v:FormulaValue) {
        def parts:[string] (strsplit key "!")
        def si:int (SpreadsheetModel.parseInt0((itemAt parts 0)))
        def rc:[string] (strsplit (itemAt parts 1) ",")
        def row:int (SpreadsheetModel.parseInt0((itemAt rc 0)))
        def col:int (SpreadsheetModel.parseInt0((itemAt rc 1)))
        def sheet:SpreadsheetModel (book.sheetAt(si))
        ; A formula that came out as a RECTANGLE spills: the top-left lands in
        ; the cell that holds the formula and the rest fills the block below and
        ; to the right of it, which is what a modern spreadsheet does with an
        ; array result. Whatever the last spill covered is cleared first, so a
        ; formula that shrinks does not leave a tail behind.
        sheet.clearSpillFrom(row col)
        if (v.isArray()) {
            if ((v.count()) > 1) {
                this.spillArray(sheet row col v)
                return
            }
            sheet.setCellRaw(row col ((v.single()).asRaw()))
            return
        }
        ; Store raw calculated value; XlsxNumberFormat formats on display.
        sheet.setCellRaw(row col (v.asRaw()))
    }

    ; Lay an array out from its anchor. Cells that already hold something of
    ; their own are not overwritten — the spill stops rather than eating a
    ; value someone typed, and the block that WAS written is remembered so the
    ; next recalculation can take it back.
    fn spillArray:void (sheet:SpreadsheetModel row:int col:int v:FormulaValue) {
        def blocked:boolean false
        def r:int 0
        while (r < v.rows) {
            def c:int 0
            while (c < v.cols) {
                if ((r + c) > 0) {
                    def tr:int (row + r)
                    def tc:int (col + c)
                    if ((strlen (sheet.getFormula(tr tc))) > 0) {
                        blocked = true
                    } {
                        if ((strlen (sheet.getCell(tr tc))) > 0) {
                            if ((sheet.isSpilled(tr tc)) == false) {
                                blocked = true
                            }
                        }
                    }
                }
                c = (c + 1)
            }
            r = (r + 1)
        }
        if blocked {
            sheet.setCellRaw(row col "#SPILL!")
            return
        }
        sheet.setSpill(row col v.rows v.cols)
        def rr:int 0
        while (rr < v.rows) {
            def cc:int 0
            while (cc < v.cols) {
                def item:FormulaValue (v.at(rr cc))
                sheet.setCellRaw((row + rr) (col + cc) (item.asRaw()))
                cc = (cc + 1)
            }
            rr = (rr + 1)
        }
    }

    ; --- structured references --------------------------------------------------
    ; Where `Table1[[#This Row],[CategoryID]]` actually points, given the
    ; workbook and the cell doing the asking.
    ;
    ; The errors are Excel's, and each says something different:
    ;   #NAME?  there is no table by that name
    ;   #REF!   the table has no such column, or no header / totals row to ask
    ;           about
    ;   #VALUE! `[#This Row]` from a row the table does not cover — the
    ;           reference is well formed, it just has nothing to point at here
    fn resolveTableRef:TableRange (n:FormulaNode) {
        def out:TableRange (new TableRange)
        def si:int (book.tableIndexByName(n.tableName))
        if (si < 0) {
            out.err = "#NAME?"
            return out
        }
        def t:SheetTable (book.tableByName(n.tableName))
        out.sheetIdx = si

        ; Columns first: a named column narrows the rectangle sideways, and a
        ; span names both ends of it.
        def c0:int t.c0
        def c1:int t.c1
        if ((strlen n.tableCol1) > 0) {
            def i1:int (t.columnIndex(n.tableCol1))
            if (i1 < 0) {
                out.err = "#REF!"
                return out
            }
            c0 = (t.c0 + i1)
            c1 = c0
            if ((strlen n.tableCol2) > 0) {
                def i2:int (t.columnIndex(n.tableCol2))
                if (i2 < 0) {
                    out.err = "#REF!"
                    return out
                }
                c1 = (t.c0 + i2)
                if (c1 < c0) {
                    def sw:int c0
                    c0 = c1
                    c1 = sw
                }
            }
        }

        ; Then rows, from the item specifier. No specifier means the data.
        def r0:int (t.dataR0())
        def r1:int (t.dataR1())
        def item:string n.tableItem
        if (item == "#all") {
            r0 = t.r0
            r1 = t.r1
        }
        if (item == "#headers") {
            if ((t.hasHeader()) == false) {
                out.err = "#REF!"
                return out
            }
            r0 = t.r0
            r1 = t.r0
        }
        if (item == "#totals") {
            if ((t.hasTotals()) == false) {
                out.err = "#REF!"
                return out
            }
            r0 = t.r1
            r1 = t.r1
        }
        if (item == "#this row") {
            if ((t.containsRow(curRow)) == false) {
                out.err = "#VALUE!"
                return out
            }
            r0 = curRow
            r1 = curRow
        }
        if (r1 < r0) {
            ; A table with a header and no data rows: asking for the data is
            ; asking for nothing, which is an empty reference rather than an
            ; error, so it reads as blank.
            r1 = r0
        }
        out.r0 = r0
        out.c0 = c0
        out.r1 = r1
        out.c1 = c1
        return out
    }

    ; The resolved rectangle as an ordinary cell or range node, so everything
    ; downstream — reading, spilling, array arithmetic — treats a structured
    ; reference exactly as it treats `$A$2:$A$5`, which it is.
    fn tableRefAsNode:FormulaNode (tr:TableRange) {
        def n:FormulaNode (new FormulaNode)
        n.sheet = ""
        n.row = tr.r0
        n.col = tr.c0
        n.row2 = tr.r1
        n.col2 = tr.c1
        n.kind = 4
        if (tr.r0 == tr.r1) {
            if (tr.c0 == tr.c1) {
                n.kind = 3
            }
        }
        return n
    }

    fn evalNode:FormulaValue (n:FormulaNode sheetIdx:int) {
        if (n.kind == 8) {
            return (FormulaValue.fromError(n.text))
        }
        if (n.kind == 0) {
            return (FormulaValue.fromNumber(n.num))
        }
        if (n.kind == 1) {
            return (FormulaValue.fromString(n.text))
        }
        if (n.kind == 2) {
            return (FormulaValue.fromBool(n.flag))
        }
        if (n.kind == 3) {
            return (this.readCell(n.sheet sheetIdx n.row n.col))
        }
        if (n.kind == 4) {
            ; A range IS a value now: a rectangle of them. What it comes to
            ; depends on where it is used — a function that wants a table gets
            ; the rectangle, arithmetic works on it element by element, and a
            ; formula that just wants one number takes the top-left.
            return (this.rangeArray(n sheetIdx))
        }
        if (n.kind == 5) {
            def a:FormulaValue (this.evalNode((itemAt n.kids 0) sheetIdx))
            def _eA:boolean (a.isError())
            if _eA {
                return a
            }
            if (n.op == "-") {
                def ca:FormulaValue (a.coerceNumber())
                def ce:boolean (ca.isError())
                if ce {
                    return ca
                }
                return (FormulaValue.fromNumber((0.0 - ca.num)))
            }
            return a
        }
        if (n.kind == 6) {
            return (this.evalBinary(n sheetIdx))
        }
        if (n.kind == 7) {
            return (this.evalCall(n sheetIdx))
        }
        if (n.kind == 9) {
            def tr:TableRange (this.resolveTableRef(n))
            if ((strlen tr.err) > 0) {
                return (FormulaValue.fromError(tr.err))
            }
            def rn:FormulaNode (this.tableRefAsNode(tr))
            if (rn.kind == 3) {
                return (this.readCell("" tr.sheetIdx rn.row rn.col))
            }
            return (this.rangeArray(rn tr.sheetIdx))
        }
        return (FormulaValue.blank())
    }

    fn readCell:FormulaValue (sheetName:string sheetIdx:int row:int col:int) {
        def si:int sheetIdx
        if ((strlen sheetName) > 0) {
            si = (this.sheetByName(sheetName))
            if (si < 0) {
                return (FormulaValue.fromError("#REF!"))
            }
        }
        if ((si < 0) || (si >= (book.sheetCount()))) {
            return (FormulaValue.fromError("#REF!"))
        }
        def sheet:SpreadsheetModel (book.sheetAt(si))
        if ((row < 0) || (col < 0) || (row >= sheet.rowCount) || (col >= sheet.colCount)) {
            return (FormulaValue.fromError("#REF!"))
        }
        def raw:string (sheet.getCell(row col))
        if ((strlen raw) == 0) {
            return (FormulaValue.blank())
        }
        if (raw == "TRUE") {
            return (FormulaValue.fromBool(true))
        }
        if (raw == "FALSE") {
            return (FormulaValue.fromBool(false))
        }
        if ((charAt raw 0) == 35) {
            return (FormulaValue.fromError(raw))
        }
        def p@(optional):double (to_double raw)
        if p {
            return (FormulaValue.fromNumber((unwrap p)))
        }
        return (FormulaValue.fromString(raw))
    }

    fn evalBinary:FormulaValue (n:FormulaNode sheetIdx:int) {
        def L:FormulaValue (this.evalNode((itemAt n.kids 0) sheetIdx))
        def R:FormulaValue (this.evalNode((itemAt n.kids 1) sheetIdx))
        ; An operand that is a rectangle makes the whole operation a rectangle:
        ; A1:A3*B1:B3 is three products, not one. The result is an array, and
        ; what happens to it then is the caller's business — a plain cell keeps
        ; the top-left, a spilling one lays the lot out.
        if (L.isArray()) {
            return (this.binaryOverArrays(n L R sheetIdx))
        }
        if (R.isArray()) {
            return (this.binaryOverArrays(n L R sheetIdx))
        }
        def _eL:boolean (L.isError())
        if _eL {
            return L
        }
        def _eR:boolean (R.isError())
        if _eR {
            return R
        }
        if (n.op == "&") {
            def _ls:string (L.toText())
            def _rs:string (R.toText())
            return (FormulaValue.fromString((_ls + _rs)))
        }
        if (n.op == "=") {
            return (FormulaValue.fromBool((FormulaValue.valuesEqual(L R))))
        }
        if (n.op == "<>") {
            def eq:boolean (FormulaValue.valuesEqual(L R))
            if eq {
                return (FormulaValue.fromBool(false))
            }
            return (FormulaValue.fromBool(true))
        }
        ; Arithmetic + ordered compare: shared coerceNumber semantics.
        def aV:FormulaValue (L.coerceNumber())
        def ae:boolean (aV.isError())
        if ae {
            return aV
        }
        def bV:FormulaValue (R.coerceNumber())
        def be:boolean (bV.isError())
        if be {
            return bV
        }
        def a:double aV.num
        def b:double bV.num
        if (n.op == "+") {
            return (FormulaValue.fromNumber((a + b)))
        }
        if (n.op == "-") {
            return (FormulaValue.fromNumber((a - b)))
        }
        if (n.op == "*") {
            return (FormulaValue.fromNumber((a * b)))
        }
        if (n.op == "/") {
            if (b == 0.0) {
                return (FormulaValue.fromError("#DIV/0!"))
            }
            return (FormulaValue.fromNumber((a / b)))
        }
        if (n.op == "^") {
            def p:int (to_int b)
            def acc:double 1.0
            def i:int 0
            if (p < 0) {
                return (FormulaValue.fromError("#VALUE!"))
            }
            while (i < p) {
                acc = (acc * a)
                i = (i + 1)
            }
            return (FormulaValue.fromNumber(acc))
        }
        if (n.op == "<") {
            return (FormulaValue.fromBool((a < b)))
        }
        if (n.op == ">") {
            return (FormulaValue.fromBool((a > b)))
        }
        if (n.op == "<=") {
            return (FormulaValue.fromBool((a <= b)))
        }
        if (n.op == ">=") {
            return (FormulaValue.fromBool((a >= b)))
        }
        return (FormulaValue.fromError("#VALUE!"))
    }

    ; Element by element, broadcasting a single value against a rectangle the
    ; way every spreadsheet does: A1:A3*2 multiplies each of the three.
    fn binaryOverArrays:FormulaValue (n:FormulaNode L:FormulaValue R:FormulaValue sheetIdx:int) {
        def rows:int 1
        def cols:int 1
        if (L.isArray()) {
            rows = L.rows
            cols = L.cols
        }
        if (R.isArray()) {
            if (R.rows > rows) {
                rows = R.rows
            }
            if (R.cols > cols) {
                cols = R.cols
            }
        }
        def items:[FormulaValue]
        def r:int 0
        while (r < rows) {
            def c:int 0
            while (c < cols) {
                def lv:FormulaValue L
                if (L.isArray()) {
                    lv = (L.at(r c))
                    if (L.rows == 1) {
                        lv = (L.at(0 c))
                    }
                    if (L.cols == 1) {
                        lv = (L.at(r 0))
                    }
                }
                def rv:FormulaValue R
                if (R.isArray()) {
                    rv = (R.at(r c))
                    if (R.rows == 1) {
                        rv = (R.at(0 c))
                    }
                    if (R.cols == 1) {
                        rv = (R.at(r 0))
                    }
                }
                push items (this.binaryOfValues(n.op lv rv))
                c = (c + 1)
            }
            r = (r + 1)
        }
        return (FormulaValue.fromArray(rows cols items))
    }

    ; One operation on two scalars. Split out of evalBinary so the array walk
    ; can reuse exactly the semantics a plain formula gets.
    fn binaryOfValues:FormulaValue (op:string L:FormulaValue R:FormulaValue) {
        def _eL:boolean (L.isError())
        if _eL {
            return L
        }
        def _eR:boolean (R.isError())
        if _eR {
            return R
        }
        if (op == "&") {
            return (FormulaValue.fromString(((L.toText()) + (R.toText()))))
        }
        if (op == "=") {
            return (FormulaValue.fromBool((FormulaValue.valuesEqual(L R))))
        }
        if (op == "<>") {
            def eq:boolean (FormulaValue.valuesEqual(L R))
            if eq {
                return (FormulaValue.fromBool(false))
            }
            return (FormulaValue.fromBool(true))
        }
        def aV:FormulaValue (L.coerceNumber())
        def ae:boolean (aV.isError())
        if ae {
            return aV
        }
        def bV:FormulaValue (R.coerceNumber())
        def be:boolean (bV.isError())
        if be {
            return bV
        }
        def a:double aV.num
        def b:double bV.num
        if (op == "+") {
            return (FormulaValue.fromNumber((a + b)))
        }
        if (op == "-") {
            return (FormulaValue.fromNumber((a - b)))
        }
        if (op == "*") {
            return (FormulaValue.fromNumber((a * b)))
        }
        if (op == "/") {
            if (b == 0.0) {
                return (FormulaValue.fromError("#DIV/0!"))
            }
            return (FormulaValue.fromNumber((a / b)))
        }
        if (op == "^") {
            def p:int (to_int b)
            if (p < 0) {
                return (FormulaValue.fromError("#VALUE!"))
            }
            def acc:double 1.0
            def i:int 0
            while (i < p) {
                acc = (acc * a)
                i = (i + 1)
            }
            return (FormulaValue.fromNumber(acc))
        }
        if (op == "<") {
            return (FormulaValue.fromBool((a < b)))
        }
        if (op == ">") {
            return (FormulaValue.fromBool((a > b)))
        }
        if (op == "<=") {
            return (FormulaValue.fromBool((a <= b)))
        }
        if (op == ">=") {
            return (FormulaValue.fromBool((a >= b)))
        }
        return (FormulaValue.fromError("#VALUE!"))
    }

    fn evalCall:FormulaValue (n:FormulaNode sheetIdx:int) {
        def name:string n.fnName
        def args:[FormulaValue]
        def i:int 0
        def kn:int (array_length n.kids)
        while (i < kn) {
            def arg:FormulaNode (itemAt n.kids i)
            push args (this.evalNode(arg sheetIdx))
            i = (i + 1)
        }
        ; TODAY and NOW are not pure functions: they read a clock, and this
        ; layer has none. The HOST sets one — `setToday` — which also makes
        ; them testable, since a test can say what today is instead of hoping
        ; the suite does not run over midnight. Unset, they answer #N/A rather
        ; than a made-up date.
        def upper:string (FormulaFunctions.upper(name))
        if (upper == "TODAY") {
            if (todaySerial <= 0.0) {
                return (FormulaValue.fromError("#N/A"))
            }
            return (FormulaValue.fromNumber((to_double (to_int todaySerial))))
        }
        if (upper == "NOW") {
            if (todaySerial <= 0.0) {
                return (FormulaValue.fromError("#N/A"))
            }
            return (FormulaValue.fromNumber(todaySerial))
        }
        ; Unknown names → #NAME? (caller may keep XLSX cached <v>)
        if (FormulaFunctions.isKnown(name) == false) {
            return (FormulaValue.fromError("#NAME?"))
        }
        return (FormulaFunctions.invoke(name args))
    }

    ; A range, read into an array value that remembers its shape. VLOOKUP
    ; reads down a column and across a row; INDEX picks by row and column;
    ; TRANSPOSE turns one into the other. None of that is possible once the
    ; rectangle has been flattened into a list of arguments, which is all the
    ; engine could hand over before.
    fn rangeArray:FormulaValue (n:FormulaNode sheetIdx:int) {
        def si:int sheetIdx
        if ((strlen n.sheet) > 0) {
            si = (this.sheetByName(n.sheet))
            if (si < 0) {
                return (FormulaValue.fromError("#REF!"))
            }
        }
        def r0:int n.row
        def r1:int n.row2
        def c0:int n.col
        def c1:int n.col2
        if (r0 > r1) {
            def t:int r0
            r0 = r1
            r1 = t
        }
        if (c0 > c1) {
            def t2:int c0
            c0 = c1
            c1 = t2
        }
        def items:[FormulaValue]
        def r:int r0
        while (r <= r1) {
            def c:int c0
            while (c <= c1) {
                push items (this.readCell("" si r c))
                c = (c + 1)
            }
            r = (r + 1)
        }
        return (FormulaValue.fromArray(((r1 - r0) + 1) ((c1 - c0) + 1) items))
    }

    ; Expand A1:B2 into individual FormulaValue args for the function library.
    fn expandRangeArgs:void (n:FormulaNode sheetIdx:int args:[FormulaValue]) {
        def si:int sheetIdx
        if ((strlen n.sheet) > 0) {
            si = (this.sheetByName(n.sheet))
            if (si < 0) {
                push args (FormulaValue.fromError("#REF!"))
                return
            }
        }
        def r0:int n.row
        def r1:int n.row2
        def c0:int n.col
        def c1:int n.col2
        if (r0 > r1) {
            def t:int r0
            r0 = r1
            r1 = t
        }
        if (c0 > c1) {
            def t2:int c0
            c0 = c1
            c1 = t2
        }
        def r:int r0
        while (r <= r1) {
            def c:int c0
            while (c <= c1) {
                push args (this.readCell("" si r c))
                c = (c + 1)
            }
            r = (r + 1)
        }
    }
}

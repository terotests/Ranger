; ==============================================================================
; FormulaEngine - small AST + dependency graph + incremental recalc.
; ==============================================================================
;
; Proves: parse → deps → topological recalc → display.
; Not a full Excel function library. Unsupported formulas keep XLSX <v> cache.
;
; Operators: + - * / ^ &   = <> < > <= >=
; Refs: A1, $A$1, Sheet2!A1, A1:B10
; Fns: SUM AVERAGE MIN MAX COUNT COUNTA IF AND OR NOT  (+ ROUND ABS if easy)
; Errors: #DIV/0! #VALUE! #REF! #NAME? #CYCLE!
; ==============================================================================

Import "SpreadsheetModel.rgr"
Import "WorkbookModel.rgr"

; --- value model --------------------------------------------------------------

class FormulaValue {
    ; kind: 0 blank 1 number 2 string 3 bool 4 error
    def kind:int 0
    def num:double 0.0
    def text:string ""
    def flag:boolean false
    def err:string ""

    Constructor () {
    }

    sfn blank:FormulaValue () {
        return (new FormulaValue)
    }

    sfn fromNumber:FormulaValue (v:double) {
        def o:FormulaValue (new FormulaValue)
        o.kind = 1
        o.num = v
        return o
    }

    sfn fromString:FormulaValue (s:string) {
        def o:FormulaValue (new FormulaValue)
        o.kind = 2
        o.text = s
        return o
    }

    sfn fromBool:FormulaValue (b:boolean) {
        def o:FormulaValue (new FormulaValue)
        o.kind = 3
        o.flag = b
        if b {
            o.num = 1.0
            o.text = "TRUE"
        } {
            o.num = 0.0
            o.text = "FALSE"
        }
        return o
    }

    sfn fromError:FormulaValue (e:string) {
        def o:FormulaValue (new FormulaValue)
        o.kind = 4
        o.err = e
        o.text = e
        return o
    }

    fn isError:boolean () {
        return (kind == 4)
    }

    fn isBlank:boolean () {
        return (kind == 0)
    }

    fn asNumber:double () {
        if (kind == 1) {
            return num
        }
        if (kind == 3) {
            if flag {
                return 1.0
            }
            return 0.0
        }
        if (kind == 2) {
            def p@(optional):double (to_double text)
            if p {
                return (unwrap p)
            }
        }
        return 0.0
    }

    fn asDisplay:string () {
        if (kind == 0) {
            return ""
        }
        if (kind == 4) {
            return err
        }
        if (kind == 3) {
            return text
        }
        if (kind == 2) {
            return text
        }
        ; number — trim .0
        def iv:int (to_int num)
        if ((to_double iv) == num) {
            return (to_string iv)
        }
        return (to_string num)
    }
}

; --- AST nodes (flattened: kind + fields) ------------------------------------

class FormulaNode {
    ; 0 num 1 str 2 bool 3 cell 4 range 5 unary 6 binary 7 call 8 err
    def kind:int 0
    def num:double 0.0
    def text:string ""
    def flag:boolean false
    def sheet:string ""
    def row:int 0
    def col:int 0
    def row2:int 0
    def col2:int 0
    def absRow:boolean false
    def absCol:boolean false
    def absRow2:boolean false
    def absCol2:boolean false
    def op:string ""
    def fnName:string ""
    def kids:[FormulaNode]

    Constructor () {
    }
}

; --- tokenizer / parser -------------------------------------------------------

class FormulaParser {
    def src:string ""
    def pos:int 0
    def len:int 0
    def ok:boolean true
    def err:string ""

    Constructor () {
    }

    fn reset:void (s:string) {
        src = s
        pos = 0
        len = (strlen s)
        ok = true
        err = ""
        if (len > 0) {
            if ((charAt src 0) == 61) {
                pos = 1
            }
        }
    }

    fn peek:int () {
        if (pos >= len) {
            return -1
        }
        return (charAt src pos)
    }

    fn next:int () {
        if (pos >= len) {
            return -1
        }
        def ch:int (charAt src pos)
        pos = (pos + 1)
        return ch
    }

    fn skipWs:void () {
        while (pos < len) {
            def ch:int (charAt src pos)
            if ((ch == 32) || (ch == 9) || (ch == 10) || (ch == 13)) {
                pos = (pos + 1)
            } {
                return
            }
        }
    }

    fn parse:FormulaNode (s:string) {
        this.reset(s)
        def n:FormulaNode (this.parseExpr())
        this.skipWs()
        if (pos < len) {
            ok = false
            err = "#VALUE!"
        }
        if (ok == false) {
            def e:FormulaNode (new FormulaNode)
            e.kind = 8
            e.text = err
            if ((strlen e.text) == 0) {
                e.text = "#VALUE!"
            }
            return e
        }
        return n
    }

    fn parseExpr:FormulaNode () {
        return (this.parseCompare())
    }

    fn parseCompare:FormulaNode () {
        def left:FormulaNode (this.parseConcat())
        this.skipWs()
        while (pos < len) {
            def ch:int (this.peek())
            def op:string ""
            if (ch == 60) {
                this.next()
                if ((this.peek()) == 61) {
                    this.next()
                    op = "<="
                } {
                    if ((this.peek()) == 62) {
                        this.next()
                        op = "<>"
                    } {
                        op = "<"
                    }
                }
            } {
                if (ch == 62) {
                    this.next()
                    if ((this.peek()) == 61) {
                        this.next()
                        op = ">="
                    } {
                        op = ">"
                    }
                } {
                    if (ch == 61) {
                        this.next()
                        op = "="
                    } {
                        break
                    }
                }
            }
            def right:FormulaNode (this.parseConcat())
            def b:FormulaNode (new FormulaNode)
            b.kind = 6
            b.op = op
            push b.kids left
            push b.kids right
            left = b
            this.skipWs()
        }
        return left
    }

    fn parseConcat:FormulaNode () {
        def left:FormulaNode (this.parseAdd())
        this.skipWs()
        while ((this.peek()) == 38) {
            this.next()
            def right:FormulaNode (this.parseAdd())
            def b:FormulaNode (new FormulaNode)
            b.kind = 6
            b.op = "&"
            push b.kids left
            push b.kids right
            left = b
            this.skipWs()
        }
        return left
    }

    fn parseAdd:FormulaNode () {
        def left:FormulaNode (this.parseMul())
        this.skipWs()
        while (true) {
            def ch:int (this.peek())
            if ((ch != 43) && (ch != 45)) {
                break
            }
            this.next()
            def right:FormulaNode (this.parseMul())
            def b:FormulaNode (new FormulaNode)
            b.kind = 6
            if (ch == 43) {
                b.op = "+"
            } {
                b.op = "-"
            }
            push b.kids left
            push b.kids right
            left = b
            this.skipWs()
        }
        return left
    }

    fn parseMul:FormulaNode () {
        def left:FormulaNode (this.parsePow())
        this.skipWs()
        while (true) {
            def ch:int (this.peek())
            if ((ch != 42) && (ch != 47)) {
                break
            }
            this.next()
            def right:FormulaNode (this.parsePow())
            def b:FormulaNode (new FormulaNode)
            b.kind = 6
            if (ch == 42) {
                b.op = "*"
            } {
                b.op = "/"
            }
            push b.kids left
            push b.kids right
            left = b
            this.skipWs()
        }
        return left
    }

    fn parsePow:FormulaNode () {
        def left:FormulaNode (this.parseUnary())
        this.skipWs()
        if ((this.peek()) == 94) {
            this.next()
            def right:FormulaNode (this.parseUnary())
            def b:FormulaNode (new FormulaNode)
            b.kind = 6
            b.op = "^"
            push b.kids left
            push b.kids right
            return b
        }
        return left
    }

    fn parseUnary:FormulaNode () {
        this.skipWs()
        def ch:int (this.peek())
        if ((ch == 43) || (ch == 45)) {
            this.next()
            def kid:FormulaNode (this.parseUnary())
            def u:FormulaNode (new FormulaNode)
            u.kind = 5
            if (ch == 45) {
                u.op = "-"
            } {
                u.op = "+"
            }
            push u.kids kid
            return u
        }
        return (this.parsePrimary())
    }

    fn parsePrimary:FormulaNode () {
        this.skipWs()
        def ch:int (this.peek())
        if (ch < 0) {
            ok = false
            err = "#VALUE!"
            def e:FormulaNode (new FormulaNode)
            e.kind = 8
            e.text = "#VALUE!"
            return e
        }
        ; number
        if (((ch >= 48) && (ch <= 57)) || (ch == 46)) {
            return (this.parseNumber())
        }
        ; string
        if (ch == 34) {
            return (this.parseString())
        }
        ; paren
        if (ch == 40) {
            this.next()
            def inner:FormulaNode (this.parseExpr())
            this.skipWs()
            if ((this.peek()) == 41) {
                this.next()
            } {
                ok = false
                err = "#VALUE!"
            }
            return inner
        }
        ; name / sheet / cell / function
        if (((ch >= 65) && (ch <= 90)) || ((ch >= 97) && (ch <= 122)) || (ch == 95) || (ch == 36)) {
            return (this.parseNameOrRef())
        }
        ok = false
        err = "#VALUE!"
        def e2:FormulaNode (new FormulaNode)
        e2.kind = 8
        e2.text = "#VALUE!"
        return e2
    }

    fn parseNumber:FormulaNode () {
        def start:int pos
        while (pos < len) {
            def ch:int (charAt src pos)
            if (((ch >= 48) && (ch <= 57)) || (ch == 46)) {
                pos = (pos + 1)
            } {
                break
            }
        }
        def s:string (substring src start pos)
        def n:FormulaNode (new FormulaNode)
        n.kind = 0
        def p@(optional):double (to_double s)
        if p {
            n.num = (unwrap p)
        } {
            ok = false
            err = "#VALUE!"
            n.kind = 8
            n.text = "#VALUE!"
        }
        return n
    }

    fn parseString:FormulaNode () {
        this.next()
        def out:string ""
        while (pos < len) {
            def ch:int (this.next())
            if (ch == 34) {
                if ((this.peek()) == 34) {
                    this.next()
                    out = (out + "\"")
                } {
                    break
                }
            } {
                out = (out + (strfromcode ch))
            }
        }
        def n:FormulaNode (new FormulaNode)
        n.kind = 1
        n.text = out
        return n
    }

    fn parseNameOrRef:FormulaNode () {
        ; Optional Sheet! prefix
        def sheet:string ""
        def start:int pos
        ; read identifier or $A$1
        while (pos < len) {
            def ch:int (charAt src pos)
            if (((ch >= 65) && (ch <= 90)) || ((ch >= 97) && (ch <= 122)) || ((ch >= 48) && (ch <= 57)) || (ch == 36) || (ch == 95) || (ch == 46)) {
                pos = (pos + 1)
            } {
                break
            }
        }
        def ident:string (substring src start pos)
        this.skipWs()
        if ((this.peek()) == 33) {
            ; sheet name
            this.next()
            sheet = ident
            start = pos
            while (pos < len) {
                def ch2:int (charAt src pos)
                if (((ch2 >= 65) && (ch2 <= 90)) || ((ch2 >= 97) && (ch2 <= 122)) || ((ch2 >= 48) && (ch2 <= 57)) || (ch2 == 36)) {
                    pos = (pos + 1)
                } {
                    break
                }
            }
            ident = (substring src start pos)
            this.skipWs()
        }
        ; function call?
        if ((this.peek()) == 40) {
            this.next()
            def call:FormulaNode (new FormulaNode)
            call.kind = 7
            call.fnName = (FormulaParser.upper(ident))
            this.skipWs()
            if ((this.peek()) != 41) {
                while (true) {
                    def arg:FormulaNode (this.parseExpr())
                    push call.kids arg
                    this.skipWs()
                    if ((this.peek()) == 44) {
                        this.next()
                        this.skipWs()
                    } {
                        break
                    }
                }
            }
            if ((this.peek()) == 41) {
                this.next()
            } {
                ok = false
                err = "#VALUE!"
            }
            return call
        }
        ; cell or range
        def r1:[int]
        def c1:[int]
        FormulaParser.parseA1(ident r1 c1)
        def cell:FormulaNode (new FormulaNode)
        cell.kind = 3
        cell.sheet = sheet
        cell.row = (itemAt r1 0)
        cell.col = (itemAt c1 0)
        this.skipWs()
        if ((this.peek()) == 58) {
            this.next()
            start = pos
            while (pos < len) {
                def ch3:int (charAt src pos)
                if (((ch3 >= 65) && (ch3 <= 90)) || ((ch3 >= 97) && (ch3 <= 122)) || ((ch3 >= 48) && (ch3 <= 57)) || (ch3 == 36)) {
                    pos = (pos + 1)
                } {
                    break
                }
            }
            def ident2:string (substring src start pos)
            def r2:[int]
            def c2:[int]
            FormulaParser.parseA1(ident2 r2 c2)
            cell.kind = 4
            cell.row2 = (itemAt r2 0)
            cell.col2 = (itemAt c2 0)
        }
        return cell
    }

    sfn upper:string (s:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def ch:int (charAt s i)
            if ((ch >= 97) && (ch <= 122)) {
                out = (out + (strfromcode (ch - 32)))
            } {
                out = (out + (strfromcode ch))
            }
            i = (i + 1)
        }
        return out
    }

    ; Parse A1 / $A$1 into 0-based row/col.
    sfn parseA1:void (ref:string rowOut:[int] colOut:[int]) {
        clear rowOut
        clear colOut
        def i:int 0
        def n:int (strlen ref)
        def col:int 0
        def sawCol:boolean false
        while (i < n) {
            def ch:int (charAt ref i)
            if (ch == 36) {
                i = (i + 1)
            } {
                if ((ch >= 65) && (ch <= 90)) {
                    col = ((col * 26) + ((ch - 65) + 1))
                    sawCol = true
                    i = (i + 1)
                } {
                    if ((ch >= 97) && (ch <= 122)) {
                        col = ((col * 26) + ((ch - 97) + 1))
                        sawCol = true
                        i = (i + 1)
                    } {
                        break
                    }
                }
            }
        }
        if sawCol {
            col = (col - 1)
        }
        def row:int 0
        def sawRow:boolean false
        while (i < n) {
            def ch2:int (charAt ref i)
            if (ch2 == 36) {
                i = (i + 1)
            } {
                if ((ch2 >= 48) && (ch2 <= 57)) {
                    row = ((row * 10) + (ch2 - 48))
                    sawRow = true
                    i = (i + 1)
                } {
                    break
                }
            }
        }
        if sawRow {
            row = (row - 1)
        }
        push rowOut row
        push colOut col
    }
}

; --- dependency graph + evaluator --------------------------------------------

class FormulaEngine {
    def book:WorkbookModel
    def parser:FormulaParser (new FormulaParser)
    ; forward deps: cellKey → "depKey;depKey;..."
    def depsOf:[string:string]
    ; reverse: cellKey → dependents joined
    def usedBy:[string:string]
    def calcValues:[string:string]
    def calcStatus:[string:string]
    def lastError:string ""

    Constructor () {
    }

    fn attach:void (b:WorkbookModel) {
        book = b
        def empty1:[string:string]
        def empty2:[string:string]
        def empty3:[string:string]
        def empty4:[string:string]
        depsOf = empty1
        usedBy = empty2
        calcValues = empty3
        calcStatus = empty4
    }

    fn cellKey:string (sheetIdx:int row:int col:int) {
        return ((((to_string sheetIdx) + "!") + (to_string row)) + "," + (to_string col))
    }

    fn sheetByName:int (name:string) {
        def i:int 0
        def n:int (book.sheetCount())
        while (i < n) {
            def s:SpreadsheetModel (book.sheetAt(i))
            if (s.name == name) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn rebuildAll:void () {
        def empty1:[string:string]
        def empty2:[string:string]
        def empty3:[string:string]
        def empty4:[string:string]
        depsOf = empty1
        usedBy = empty2
        calcValues = empty3
        calcStatus = empty4
        def si:int 0
        def sn:int (book.sheetCount())
        while (si < sn) {
            def sheet:SpreadsheetModel (book.sheetAt(si))
            def i:int 0
            def n:int (array_length sheet.formulaKeys)
            while (i < n) {
                def k:string (itemAt sheet.formulaKeys i)
                def parts:[string] (strsplit k ",")
                if ((array_length parts) >= 2) {
                    def row:int (SpreadsheetModel.parseInt0((itemAt parts 0)))
                    def col:int (SpreadsheetModel.parseInt0((itemAt parts 1)))
                    this.registerFormula(si row col (sheet.getFormula(row col)))
                }
                i = (i + 1)
            }
            si = (si + 1)
        }
        this.recalcAll()
    }

    fn registerFormula:void (sheetIdx:int row:int col:int expr:string) {
        def key:string (this.cellKey(sheetIdx row col))
        def ast:FormulaNode (parser.parse(expr))
        def depList:[string]
        this.collectDeps(ast sheetIdx depList)
        def joined:string ""
        def i:int 0
        def n:int (array_length depList)
        while (i < n) {
            if (i > 0) {
                joined = (joined + ";")
            }
            joined = (joined + (itemAt depList i))
            i = (i + 1)
        }
        set depsOf key joined
        i = 0
        while (i < n) {
            def d:string (itemAt depList i)
            def cur:string ""
            if (has usedBy d) {
                cur = (unwrap (get usedBy d))
            }
            if ((strlen cur) == 0) {
                set usedBy d key
            } {
                set usedBy d (cur + ";" + key)
            }
            i = (i + 1)
        }
        if parser.ok {
            set calcStatus key "pending"
        } {
            set calcStatus key "unsupported"
        }
    }

    fn collectDeps:void (n:FormulaNode sheetIdx:int out:[string]) {
        if (n.kind == 3) {
            def si:int sheetIdx
            if ((strlen n.sheet) > 0) {
                si = (this.sheetByName(n.sheet))
                if (si < 0) {
                    return
                }
            }
            push out (this.cellKey(si n.row n.col))
            return
        }
        if (n.kind == 4) {
            def si2:int sheetIdx
            if ((strlen n.sheet) > 0) {
                si2 = (this.sheetByName(n.sheet))
                if (si2 < 0) {
                    return
                }
            }
            def r0:int n.row
            def r1:int n.row2
            def c0:int n.col
            def c1:int n.col2
            if (r0 > r1) {
                def t:int r0
                r0 = r1
                r1 = t
            }
            if (c0 > c1) {
                def t2:int c0
                c0 = c1
                c1 = t2
            }
            def r:int r0
            while (r <= r1) {
                def c:int c0
                while (c <= c1) {
                    push out (this.cellKey(si2 r c))
                    c = (c + 1)
                }
                r = (r + 1)
            }
            return
        }
        def i:int 0
        def kn:int (array_length n.kids)
        while (i < kn) {
            this.collectDeps((itemAt n.kids i) sheetIdx out)
            i = (i + 1)
        }
    }

    fn splitKeys:void (joined:string out:[string]) {
        clear out
        if ((strlen joined) == 0) {
            return
        }
        def cur:string ""
        def i:int 0
        def n:int (strlen joined)
        while (i < n) {
            def ch:int (charAt joined i)
            if (ch == 59) {
                if ((strlen cur) > 0) {
                    push out cur
                }
                cur = ""
            } {
                cur = (cur + (strfromcode ch))
            }
            i = (i + 1)
        }
        if ((strlen cur) > 0) {
            push out cur
        }
    }

    fn markDirty:void (key:string visited:[string:boolean]) {
        if (has visited key) {
            return
        }
        set visited key true
        set calcStatus key "dirty"
        if (has usedBy key) {
            def kids:[string]
            this.splitKeys((unwrap (get usedBy key)) kids)
            def i:int 0
            def n:int (array_length kids)
            while (i < n) {
                this.markDirty((itemAt kids i) visited)
                i = (i + 1)
            }
        }
    }

    fn onCellEdited:void (sheetIdx:int row:int col:int) {
        def key:string (this.cellKey(sheetIdx row col))
        def visited:[string:boolean]
        ; Mark dependents dirty (not the edited value cell itself — it is already current).
        if (has usedBy key) {
            def kids:[string]
            this.splitKeys((unwrap (get usedBy key)) kids)
            def i:int 0
            def n:int (array_length kids)
            while (i < n) {
                this.markDirty((itemAt kids i) visited)
                i = (i + 1)
            }
        }
        this.recalcDirty()
    }

    fn recalcAll:void () {
        def keys:[string]
        ; gather all formula keys from depsOf — iterate sheets
        def si:int 0
        def sn:int (book.sheetCount())
        while (si < sn) {
            def sheet:SpreadsheetModel (book.sheetAt(si))
            sheet.collectFormulaKeys(si keys)
            si = (si + 1)
        }
        def i:int 0
        def n:int (array_length keys)
        while (i < n) {
            set calcStatus (itemAt keys i) "dirty"
            i = (i + 1)
        }
        this.recalcDirty()
    }

    fn recalcDirty:void () {
        ; simple multi-pass: evaluate dirty formulas whose deps are clean; detect cycles
        def guard:int 0
        while (guard < 64) {
            def progressed:boolean false
            def si:int 0
            def sn:int (book.sheetCount())
            while (si < sn) {
                def sheet:SpreadsheetModel (book.sheetAt(si))
                def keys:[string]
                sheet.collectFormulaKeys(si keys)
                def i:int 0
                def n:int (array_length keys)
                while (i < n) {
                    def key:string (itemAt keys i)
                    def st:string "cached"
                    if (has calcStatus key) {
                        st = (unwrap (get calcStatus key))
                    }
                    if ((st == "dirty") || (st == "pending")) {
                        if (this.depsReady(key)) {
                            this.evalOne(key)
                            progressed = true
                        }
                    }
                    i = (i + 1)
                }
                si = (si + 1)
            }
            if (progressed == false) {
                break
            }
            guard = (guard + 1)
        }
        ; remaining dirty → cycle
        def si2:int 0
        def sn2:int (book.sheetCount())
        while (si2 < sn2) {
            def sheet2:SpreadsheetModel (book.sheetAt(si2))
            def keys2:[string]
            sheet2.collectFormulaKeys(si2 keys2)
            def j:int 0
            def m:int (array_length keys2)
            while (j < m) {
                def k2:string (itemAt keys2 j)
                if (has calcStatus k2) {
                    def st2:string (unwrap (get calcStatus k2))
                    if ((st2 == "dirty") || (st2 == "pending")) {
                        set calcStatus k2 "error"
                        set calcValues k2 "#CYCLE!"
                        this.applyResult(k2 (FormulaValue.fromError("#CYCLE!")))
                    }
                }
                j = (j + 1)
            }
            si2 = (si2 + 1)
        }
    }

    fn depsReady:boolean (key:string) {
        if (has depsOf key) {
            def deps:[string]
            this.splitKeys((unwrap (get depsOf key)) deps)
            def i:int 0
            def n:int (array_length deps)
            while (i < n) {
                def d:string (itemAt deps i)
                if (has calcStatus d) {
                    def st:string (unwrap (get calcStatus d))
                    if ((st == "dirty") || (st == "pending")) {
                        return false
                    }
                }
                i = (i + 1)
            }
        }
        return true
    }

    fn evalOne:void (key:string) {
        def parts:[string] (strsplit key "!")
        if ((array_length parts) < 2) {
            return
        }
        def si:int (SpreadsheetModel.parseInt0((itemAt parts 0)))
        def rc:[string] (strsplit (itemAt parts 1) ",")
        if ((array_length rc) < 2) {
            return
        }
        def row:int (SpreadsheetModel.parseInt0((itemAt rc 0)))
        def col:int (SpreadsheetModel.parseInt0((itemAt rc 1)))
        def sheet:SpreadsheetModel (book.sheetAt(si))
        def expr:string (sheet.getFormula(row col))
        if ((strlen expr) == 0) {
            set calcStatus key "cached"
            return
        }
        def ast:FormulaNode (parser.parse(expr))
        if (parser.ok == false) {
            ; keep cached XLSX value
            set calcStatus key "unsupported"
            return
        }
        def v:FormulaValue (this.evalNode(ast si))
        def _eV:boolean (v.isError())
                if _eV {
            set calcStatus key "error"
            set calcValues key v.err
            this.applyResult(key v)
            return
        }
        set calcStatus key "calculated"
        set calcValues key (v.asDisplay())
        this.applyResult(key v)
    }

    fn applyResult:void (key:string v:FormulaValue) {
        def parts:[string] (strsplit key "!")
        def si:int (SpreadsheetModel.parseInt0((itemAt parts 0)))
        def rc:[string] (strsplit (itemAt parts 1) ",")
        def row:int (SpreadsheetModel.parseInt0((itemAt rc 0)))
        def col:int (SpreadsheetModel.parseInt0((itemAt rc 1)))
        def sheet:SpreadsheetModel (book.sheetAt(si))
        sheet.setCellRaw(row col (v.asDisplay()))
    }

    fn evalNode:FormulaValue (n:FormulaNode sheetIdx:int) {
        if (n.kind == 8) {
            return (FormulaValue.fromError(n.text))
        }
        if (n.kind == 0) {
            return (FormulaValue.fromNumber(n.num))
        }
        if (n.kind == 1) {
            return (FormulaValue.fromString(n.text))
        }
        if (n.kind == 2) {
            return (FormulaValue.fromBool(n.flag))
        }
        if (n.kind == 3) {
            return (this.readCell(n.sheet sheetIdx n.row n.col))
        }
        if (n.kind == 4) {
            ; range as value only valid inside functions — treat as #VALUE!
            return (FormulaValue.fromError("#VALUE!"))
        }
        if (n.kind == 5) {
            def a:FormulaValue (this.evalNode((itemAt n.kids 0) sheetIdx))
            def _eA:boolean (a.isError())
            if _eA {
                return a
            }
            if (n.op == "-") {
                return (FormulaValue.fromNumber((0.0 - (a.asNumber()))))
            }
            return a
        }
        if (n.kind == 6) {
            return (this.evalBinary(n sheetIdx))
        }
        if (n.kind == 7) {
            return (this.evalCall(n sheetIdx))
        }
        return (FormulaValue.blank())
    }

    fn readCell:FormulaValue (sheetName:string sheetIdx:int row:int col:int) {
        def si:int sheetIdx
        if ((strlen sheetName) > 0) {
            si = (this.sheetByName(sheetName))
            if (si < 0) {
                return (FormulaValue.fromError("#REF!"))
            }
        }
        if ((si < 0) || (si >= (book.sheetCount()))) {
            return (FormulaValue.fromError("#REF!"))
        }
        def sheet:SpreadsheetModel (book.sheetAt(si))
        if ((row < 0) || (col < 0) || (row >= sheet.rowCount) || (col >= sheet.colCount)) {
            return (FormulaValue.fromError("#REF!"))
        }
        def raw:string (sheet.getCell(row col))
        if ((strlen raw) == 0) {
            return (FormulaValue.blank())
        }
        if (raw == "TRUE") {
            return (FormulaValue.fromBool(true))
        }
        if (raw == "FALSE") {
            return (FormulaValue.fromBool(false))
        }
        if ((charAt raw 0) == 35) {
            return (FormulaValue.fromError(raw))
        }
        def p@(optional):double (to_double raw)
        if p {
            return (FormulaValue.fromNumber((unwrap p)))
        }
        return (FormulaValue.fromString(raw))
    }

    fn evalBinary:FormulaValue (n:FormulaNode sheetIdx:int) {
        def L:FormulaValue (this.evalNode((itemAt n.kids 0) sheetIdx))
        def R:FormulaValue (this.evalNode((itemAt n.kids 1) sheetIdx))
        def _eL:boolean (L.isError())
        if _eL {
            return L
        }
        def _eR:boolean (R.isError())
        if _eR {
            return R
        }
        if (n.op == "&") {
            def _ls:string (L.asDisplay())
            def _rs:string (R.asDisplay())
            return (FormulaValue.fromString((_ls + _rs)))
        }
        def a:double (L.asNumber())
        def b:double (R.asNumber())
        if (n.op == "+") {
            return (FormulaValue.fromNumber((a + b)))
        }
        if (n.op == "-") {
            return (FormulaValue.fromNumber((a - b)))
        }
        if (n.op == "*") {
            return (FormulaValue.fromNumber((a * b)))
        }
        if (n.op == "/") {
            if (b == 0.0) {
                return (FormulaValue.fromError("#DIV/0!"))
            }
            return (FormulaValue.fromNumber((a / b)))
        }
        if (n.op == "^") {
            ; integer power only
            def p:int (to_int b)
            def acc:double 1.0
            def i:int 0
            if (p < 0) {
                return (FormulaValue.fromError("#VALUE!"))
            }
            while (i < p) {
                acc = (acc * a)
                i = (i + 1)
            }
            return (FormulaValue.fromNumber(acc))
        }
        if (n.op == "=") {
            def ls1:string (L.asDisplay())
            def rs1:string (R.asDisplay())
            return (FormulaValue.fromBool((ls1 == rs1)))
        }
        if (n.op == "<>") {
            def ls2:string (L.asDisplay())
            def rs2:string (R.asDisplay())
            return (FormulaValue.fromBool((ls2 != rs2)))
        }
        if (n.op == "<") {
            return (FormulaValue.fromBool((a < b)))
        }
        if (n.op == ">") {
            return (FormulaValue.fromBool((a > b)))
        }
        if (n.op == "<=") {
            return (FormulaValue.fromBool((a <= b)))
        }
        if (n.op == ">=") {
            return (FormulaValue.fromBool((a >= b)))
        }
        return (FormulaValue.fromError("#VALUE!"))
    }

    fn evalCall:FormulaValue (n:FormulaNode sheetIdx:int) {
        def name:string n.fnName
        if ((name == "SUM") || (name == "AVERAGE") || (name == "MIN") || (name == "MAX") || (name == "COUNT") || (name == "COUNTA")) {
            return (this.evalAgg(n sheetIdx))
        }
        if (name == "IF") {
            if ((array_length n.kids) < 2) {
                return (FormulaValue.fromError("#VALUE!"))
            }
            def cond:FormulaValue (this.evalNode((itemAt n.kids 0) sheetIdx))
            def _eC:boolean (cond.isError())
            if _eC {
                return cond
            }
            def truth:boolean false
            if (cond.kind == 3) {
                truth = cond.flag
            } {
                if ((cond.asNumber()) != 0.0) {
                    truth = true
                }
            }
            if truth {
                return (this.evalNode((itemAt n.kids 1) sheetIdx))
            }
            if ((array_length n.kids) >= 3) {
                return (this.evalNode((itemAt n.kids 2) sheetIdx))
            }
            return (FormulaValue.fromBool(false))
        }
        if ((name == "AND") || (name == "OR")) {
            def i:int 0
            def kn:int (array_length n.kids)
            def any:boolean false
            def all:boolean true
            while (i < kn) {
                def v:FormulaValue (this.evalNode((itemAt n.kids i) sheetIdx))
                def _eV:boolean (v.isError())
                if _eV {
                    return v
                }
                def t:boolean false
                if (v.kind == 3) {
                    t = v.flag
                } {
                    if ((v.asNumber()) != 0.0) {
                        t = true
                    }
                }
                if t {
                    any = true
                } {
                    all = false
                }
                i = (i + 1)
            }
            if (name == "AND") {
                return (FormulaValue.fromBool(all))
            }
            return (FormulaValue.fromBool(any))
        }
        if (name == "NOT") {
            if ((array_length n.kids) < 1) {
                return (FormulaValue.fromError("#VALUE!"))
            }
            def v2:FormulaValue (this.evalNode((itemAt n.kids 0) sheetIdx))
            def _eV2:boolean (v2.isError())
            if _eV2 {
                return v2
            }
            def t2:boolean false
            if (v2.kind == 3) {
                t2 = v2.flag
            } {
                if ((v2.asNumber()) != 0.0) {
                    t2 = true
                }
            }
            if t2 {
                return (FormulaValue.fromBool(false))
            }
            return (FormulaValue.fromBool(true))
        }
        if (name == "ABS") {
            def v3:FormulaValue (this.evalNode((itemAt n.kids 0) sheetIdx))
            def _eV3:boolean (v3.isError())
            if _eV3 {
                return v3
            }
            def x:double (v3.asNumber())
            if (x < 0.0) {
                x = (0.0 - x)
            }
            return (FormulaValue.fromNumber(x))
        }
        if (name == "ROUND") {
            def v4:FormulaValue (this.evalNode((itemAt n.kids 0) sheetIdx))
            def _eV4:boolean (v4.isError())
            if _eV4 {
                return v4
            }
            def digits:int 0
            if ((array_length n.kids) >= 2) {
                def vd:FormulaValue (this.evalNode((itemAt n.kids 1) sheetIdx))
                digits = (to_int (vd.asNumber()))
            }
            def scale:double 1.0
            def d:int 0
            while (d < digits) {
                scale = (scale * 10.0)
                d = (d + 1)
            }
            def xx:double (v4.asNumber())
            def rr:double ((to_double (to_int ((xx * scale) + 0.5))) / scale)
            return (FormulaValue.fromNumber(rr))
        }
        if ((name == "CONCAT") || (name == "CONCATENATE")) {
            def out:string ""
            def i2:int 0
            def kn2:int (array_length n.kids)
            while (i2 < kn2) {
                def vv:FormulaValue (this.evalNode((itemAt n.kids i2) sheetIdx))
                def _eVV:boolean (vv.isError())
                if _eVV {
                    return vv
                }
                out = (out + (vv.asDisplay()))
                i2 = (i2 + 1)
            }
            return (FormulaValue.fromString(out))
        }
        return (FormulaValue.fromError("#NAME?"))
    }

    fn evalAgg:FormulaValue (n:FormulaNode sheetIdx:int) {
        def vals:[double]
        def countA:int 0
        def i:int 0
        def kn:int (array_length n.kids)
        while (i < kn) {
            def arg:FormulaNode (itemAt n.kids i)
            if (arg.kind == 4) {
                this.collectRangeNumbers(arg sheetIdx vals countA)
            } {
                def v:FormulaValue (this.evalNode(arg sheetIdx))
                def _eV:boolean (v.isError())
                if _eV {
                    return v
                }
                def _blank:boolean (v.isBlank())
                if (_blank == false) {
                    countA = (countA + 1)
                }
                if ((v.kind == 1) || (v.kind == 3)) {
                    push vals (v.asNumber())
                } {
                    if (v.kind == 2) {
                        def p@(optional):double (to_double v.text)
                        if p {
                            push vals (unwrap p)
                        }
                    }
                }
            }
            i = (i + 1)
        }
        def name:string n.fnName
        if (name == "COUNTA") {
            return (FormulaValue.fromNumber((to_double countA)))
        }
        if (name == "COUNT") {
            return (FormulaValue.fromNumber((to_double (array_length vals))))
        }
        if ((array_length vals) == 0) {
            if (name == "AVERAGE") {
                return (FormulaValue.fromError("#DIV/0!"))
            }
            return (FormulaValue.fromNumber(0.0))
        }
        def sum:double 0.0
        def mn:double (itemAt vals 0)
        def mx:double (itemAt vals 0)
        def j:int 0
        def vn:int (array_length vals)
        while (j < vn) {
            def x:double (itemAt vals j)
            sum = (sum + x)
            if (x < mn) {
                mn = x
            }
            if (x > mx) {
                mx = x
            }
            j = (j + 1)
        }
        if (name == "SUM") {
            return (FormulaValue.fromNumber(sum))
        }
        if (name == "AVERAGE") {
            return (FormulaValue.fromNumber((sum / (to_double vn))))
        }
        if (name == "MIN") {
            return (FormulaValue.fromNumber(mn))
        }
        if (name == "MAX") {
            return (FormulaValue.fromNumber(mx))
        }
        return (FormulaValue.fromError("#NAME?"))
    }

    fn collectRangeNumbers:void (n:FormulaNode sheetIdx:int vals:[double] countA:int) {
        ; countA passed by value — update via return not possible; approximate with vals only for COUNT path
        def si:int sheetIdx
        if ((strlen n.sheet) > 0) {
            si = (this.sheetByName(n.sheet))
            if (si < 0) {
                return
            }
        }
        def r0:int n.row
        def r1:int n.row2
        def c0:int n.col
        def c1:int n.col2
        if (r0 > r1) {
            def t:int r0
            r0 = r1
            r1 = t
        }
        if (c0 > c1) {
            def t2:int c0
            c0 = c1
            c1 = t2
        }
        def r:int r0
        while (r <= r1) {
            def c:int c0
            while (c <= c1) {
                def v:FormulaValue (this.readCell("" si r c))
                def _blank:boolean (v.isBlank())
                if (_blank == false) {
                    ; COUNTA bump skipped (limitation)
                }
                if ((v.kind == 1) || (v.kind == 3)) {
                    push vals (v.asNumber())
                }
                c = (c + 1)
            }
            r = (r + 1)
        }
    }
}

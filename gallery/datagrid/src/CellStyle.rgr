; ==============================================================================
; CellStyle - resolved cell appearance (FortuneSheet "Formatting" subset).
; ==============================================================================
;
; XLSX style index → this struct → EVG fill/text. Number format is applied when
; producing the display string via XlsxNumberFormat.
; ==============================================================================

Import "XlsxNumberFormat.rgr"

; One cell edge from styles.xml <border>. style "" means no border.
; OOXML styles: hair thin medium thick double dashed dotted dashDot
; dashDotDot mediumDashed mediumDashDot mediumDashDotDot slantDashDot.
class CellBorder {
    def style:string ""
    def rgb:string "#000000"

    Constructor () {
    }

    fn has:boolean () {
        return ((strlen style) > 0)
    }

    fn copyFrom:void (o:CellBorder) {
        style = o.style
        rgb = o.rgb
    }

    fn sameAs:boolean (o:CellBorder) {
        if (style != o.style) {
            return false
        }
        return (rgb == o.rgb)
    }

    ; Painted thickness in px.
    fn width:int () {
        if (style == "thick") {
            return 3
        }
        if (style == "double") {
            return 3
        }
        if (style == "medium") {
            return 2
        }
        if (style == "mediumDashed") {
            return 2
        }
        if (style == "mediumDashDot") {
            return 2
        }
        if (style == "mediumDashDotDot") {
            return 2
        }
        return 1
    }

    ; 0 = solid, 1 = dashed, 2 = dotted, 3 = double (two hairlines).
    fn pattern:int () {
        if (style == "double") {
            return 3
        }
        if (style == "dotted") {
            return 2
        }
        if (style == "hair") {
            return 2
        }
        if (style == "dashed") {
            return 1
        }
        if (style == "dashDot") {
            return 1
        }
        if (style == "dashDotDot") {
            return 1
        }
        if (style == "mediumDashed") {
            return 1
        }
        if (style == "mediumDashDot") {
            return 1
        }
        if (style == "mediumDashDotDot") {
            return 1
        }
        if (style == "slantDashDot") {
            return 1
        }
        return 0
    }
}

class CellStyle {
    def fillRgb:string ""
    def textRgb:string ""
    def bold:boolean false
    def italic:boolean false
    def underline:boolean false
    def strike:boolean false
    def fontSizePt:double 11.0
    ; Typeface name as OOXML writes it (`<name val="Calibri"/>`). Empty means
    ; the workbook default; the painter falls back to Open Sans when the face
    ; is not loaded.
    def fontName:string ""
    def align:string "left"
    ; Whether that alignment was STATED.
    ;
    ; Excel's default is `general`, not left: a cell with no `horizontal`
    ; takes its side from its reading order, and a right-to-left one belongs
    ; against the right edge. `align` alone cannot express that — "left" is
    ; both the default and a real value someone may have chosen — so an
    ; Arabic cell that said nothing was indistinguishable from one that asked
    ; for the left margin, and both went left.
    def alignSet:boolean false
    ; `<alignment readingOrder="…">`: 0 or absent is "work it out from the
    ; text", 1 is left to right, 2 is right to left. Excel's own numbering,
    ; kept rather than translated, so the value that was read is the value
    ; that gets written back.
    ;
    ; It is what an author sets on a cell whose text alone would answer
    ; wrongly — a cell of Arabic that opens with a Latin product code, which
    ; reads left to right by the algorithm and right to left by intent.
    def readingOrder:int 0
    def valign:string "bottom"
    def wrapText:boolean false
    ; Excel's textRotation, as OOXML writes it: 0..90 turns the text
    ; anticlockwise, 91..180 means 1..90 clockwise, and 255 is the stacked
    ; "vertical text" that reads downwards one letter at a time. Stored raw so
    ; a round trip keeps what the file said; `rotationDegrees` is what a
    ; painter wants.
    def textRotation:int 0
    def numFmt:string "General"
    def hasFill:boolean false
    def hasBorder:boolean false
    def borderTop:CellBorder (new CellBorder)
    def borderRight:CellBorder (new CellBorder)
    def borderBottom:CellBorder (new CellBorder)
    def borderLeft:CellBorder (new CellBorder)

    Constructor () {
    }

    ; The row height one line of this type needs, in pixels.
    ;
    ; Excel's own rule: the point size times 1.275, taken up to the next whole
    ; pixel. It is what makes 10pt type give the familiar 12.75pt row, and it
    ; is deliberately NOT the face's line box — a webfont declares a box far
    ; taller than its letters and a row sized by that is a fifth too tall.
    ; Loading a file and auto-fitting a row in the app have to agree about
    ; this, so they ask here.
    sfn rowHeightForPt:int (pt:double) {
        def use:double pt
        if (use <= 0.0) {
            use = 11.0
        }
        def pts:double (use * 1.275)
        def px:double ((pts * 96.0) / 72.0)
        return (to_int (px + 0.999))
    }

    sfn createDefault:CellStyle () {
        return (new CellStyle)
    }

    ; The reading order as the three states everything that PAINTS uses:
    ; -1 work it out from the text, 0 left to right, 1 right to left.
    ;
    ; Excel's own numbering is kept in the field rather than translated, so
    ; that the value read out of a file is the value written back into it;
    ; this is the translation, in one place, at the boundary.
    fn textDirection:int () {
        if (readingOrder == 1) {
            return 0
        }
        if (readingOrder == 2) {
            return 1
        }
        return -1
    }

    fn copy:CellStyle () {
        def o:CellStyle (new CellStyle)
        o.fillRgb = fillRgb
        o.textRgb = textRgb
        o.bold = bold
        o.italic = italic
        o.underline = underline
        o.strike = strike
        o.fontSizePt = fontSizePt
        o.fontName = fontName
        o.align = align
        o.alignSet = alignSet
        o.readingOrder = readingOrder
        o.valign = valign
        o.wrapText = wrapText
        o.textRotation = textRotation
        o.numFmt = numFmt
        o.hasFill = hasFill
        o.hasBorder = hasBorder
        o.borderTop.copyFrom(borderTop)
        o.borderRight.copyFrom(borderRight)
        o.borderBottom.copyFrom(borderBottom)
        o.borderLeft.copyFrom(borderLeft)
        return o
    }

    fn sameAs:boolean (o:CellStyle) {
        if (fillRgb != o.fillRgb) {
            return false
        }
        if (textRgb != o.textRgb) {
            return false
        }
        if (bold != o.bold) {
            return false
        }
        if (italic != o.italic) {
            return false
        }
        if (underline != o.underline) {
            return false
        }
        if (strike != o.strike) {
            return false
        }
        if (fontSizePt != o.fontSizePt) {
            return false
        }
        if (fontName != o.fontName) {
            return false
        }
        if (alignSet != o.alignSet) {
            return false
        }
        if (align != o.align) {
            return false
        }
        ; Two cells that differ only in reading order are two styles. Leaving
        ; it out here would fold them into one and the direction of whichever
        ; was interned first would be applied to both.
        if (readingOrder != o.readingOrder) {
            return false
        }
        if (valign != o.valign) {
            return false
        }
        if (wrapText != o.wrapText) {
            return false
        }
        if (textRotation != o.textRotation) {
            return false
        }
        if (numFmt != o.numFmt) {
            return false
        }
        if (hasFill != o.hasFill) {
            return false
        }
        if (hasBorder != o.hasBorder) {
            return false
        }
        if ((borderTop.sameAs(o.borderTop)) == false) {
            return false
        }
        if ((borderRight.sameAs(o.borderRight)) == false) {
            return false
        }
        if ((borderBottom.sameAs(o.borderBottom)) == false) {
            return false
        }
        if ((borderLeft.sameAs(o.borderLeft)) == false) {
            return false
        }
        return true
    }

    ; True when nothing is set — a default style needs no table entry.
    ; What a painter turns the text by: degrees CLOCKWISE, the direction every
    ; EVG backend rotates in. Excel counts anticlockwise up to 90 and then
    ; encodes clockwise as 91..180, so both halves fold onto one signed number.
    ; 255 (stacked) is not a rotation and stays 0.
    fn rotationDegrees:double () {
        if (textRotation == 255) {
            return 0.0
        }
        if (textRotation > 90) {
            if (textRotation <= 180) {
                return (to_double (textRotation - 90))
            }
            return 0.0
        }
        if (textRotation < 0) {
            return 0.0
        }
        return (to_double (0 - textRotation))
    }

    fn isStacked:boolean () {
        return (textRotation == 255)
    }

    fn isPlain:boolean () {
        def d:CellStyle (new CellStyle)
        return (this.sameAs(d))
    }
}

; Tiny number formatter kept as alias for older call sites.
class XlsxFormatter {
    Constructor () {
    }

    sfn format:string (raw:string numFmt:string) {
        return (XlsxNumberFormat.format(raw numFmt))
    }
}

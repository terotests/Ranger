; ==============================================================================
; CellStyle - resolved cell appearance (FortuneSheet "Formatting" subset).
; ==============================================================================
;
; XLSX style index → this struct → EVG fill/text. Number format is applied when
; producing the display string via XlsxNumberFormat.
; ==============================================================================

Import "XlsxNumberFormat.rgr"

; One cell edge from styles.xml <border>. style "" means no border.
; OOXML styles: hair thin medium thick double dashed dotted dashDot
; dashDotDot mediumDashed mediumDashDot mediumDashDotDot slantDashDot.
class CellBorder {
    def style:string ""
    def rgb:string "#000000"

    Constructor () {
    }

    fn has:boolean () {
        return ((strlen style) > 0)
    }

    fn copyFrom:void (o:CellBorder) {
        style = o.style
        rgb = o.rgb
    }

    fn sameAs:boolean (o:CellBorder) {
        if (style != o.style) {
            return false
        }
        return (rgb == o.rgb)
    }

    ; Painted thickness in px.
    fn width:int () {
        if (style == "thick") {
            return 3
        }
        if (style == "double") {
            return 3
        }
        if (style == "medium") {
            return 2
        }
        if (style == "mediumDashed") {
            return 2
        }
        if (style == "mediumDashDot") {
            return 2
        }
        if (style == "mediumDashDotDot") {
            return 2
        }
        return 1
    }

    ; 0 = solid, 1 = dashed, 2 = dotted, 3 = double (two hairlines).
    fn pattern:int () {
        if (style == "double") {
            return 3
        }
        if (style == "dotted") {
            return 2
        }
        if (style == "hair") {
            return 2
        }
        if (style == "dashed") {
            return 1
        }
        if (style == "dashDot") {
            return 1
        }
        if (style == "dashDotDot") {
            return 1
        }
        if (style == "mediumDashed") {
            return 1
        }
        if (style == "mediumDashDot") {
            return 1
        }
        if (style == "mediumDashDotDot") {
            return 1
        }
        if (style == "slantDashDot") {
            return 1
        }
        return 0
    }
}

class CellStyle {
    def fillRgb:string ""
    def textRgb:string ""
    def bold:boolean false
    def italic:boolean false
    def underline:boolean false
    def strike:boolean false
    def fontSizePt:double 11.0
    def align:string "left"
    def valign:string "bottom"
    def wrapText:boolean false
    def numFmt:string "General"
    def hasFill:boolean false
    def hasBorder:boolean false
    def borderTop:CellBorder (new CellBorder)
    def borderRight:CellBorder (new CellBorder)
    def borderBottom:CellBorder (new CellBorder)
    def borderLeft:CellBorder (new CellBorder)

    Constructor () {
    }

    sfn createDefault:CellStyle () {
        return (new CellStyle)
    }

    fn copy:CellStyle () {
        def o:CellStyle (new CellStyle)
        o.fillRgb = fillRgb
        o.textRgb = textRgb
        o.bold = bold
        o.italic = italic
        o.underline = underline
        o.strike = strike
        o.fontSizePt = fontSizePt
        o.align = align
        o.valign = valign
        o.wrapText = wrapText
        o.numFmt = numFmt
        o.hasFill = hasFill
        o.hasBorder = hasBorder
        o.borderTop.copyFrom(borderTop)
        o.borderRight.copyFrom(borderRight)
        o.borderBottom.copyFrom(borderBottom)
        o.borderLeft.copyFrom(borderLeft)
        return o
    }

    fn sameAs:boolean (o:CellStyle) {
        if (fillRgb != o.fillRgb) {
            return false
        }
        if (textRgb != o.textRgb) {
            return false
        }
        if (bold != o.bold) {
            return false
        }
        if (italic != o.italic) {
            return false
        }
        if (underline != o.underline) {
            return false
        }
        if (strike != o.strike) {
            return false
        }
        if (fontSizePt != o.fontSizePt) {
            return false
        }
        if (align != o.align) {
            return false
        }
        if (valign != o.valign) {
            return false
        }
        if (wrapText != o.wrapText) {
            return false
        }
        if (numFmt != o.numFmt) {
            return false
        }
        if (hasFill != o.hasFill) {
            return false
        }
        if (hasBorder != o.hasBorder) {
            return false
        }
        if ((borderTop.sameAs(o.borderTop)) == false) {
            return false
        }
        if ((borderRight.sameAs(o.borderRight)) == false) {
            return false
        }
        if ((borderBottom.sameAs(o.borderBottom)) == false) {
            return false
        }
        if ((borderLeft.sameAs(o.borderLeft)) == false) {
            return false
        }
        return true
    }

    ; True when nothing is set — a default style needs no table entry.
    fn isPlain:boolean () {
        def d:CellStyle (new CellStyle)
        return (this.sameAs(d))
    }
}

; Tiny number formatter kept as alias for older call sites.
class XlsxFormatter {
    Constructor () {
    }

    sfn format:string (raw:string numFmt:string) {
        return (XlsxNumberFormat.format(raw numFmt))
    }
}

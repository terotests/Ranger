; ==============================================================================
; grid_demo - headless scripted session for the EVG DataGrid prototype.
; ==============================================================================

Import "GridApp.rgr"
Import "../../pdf_writer/src/raster/PNGEncoder.rgr"
Import "../../pdf_writer/src/raster/RasterBuffer.rgr"

class GridDemo {
    sfn click:void (app:GridApp input:UIInput px:int py:int) {
        input.newFrame()
        input.setPointerPos(px py)
        input.setPointerDown(true)
        app.update(input)
        input.newFrame()
        input.setPointerPos(px py)
        input.setPointerDown(false)
        app.update(input)
    }

    sfn typeText:void (app:GridApp input:UIInput s:string) {
        input.newFrame()
        input.pushText(s)
        app.update(input)
    }

    sfn key:void (app:GridApp input:UIInput k:int) {
        input.newFrame()
        input.pushKey(k)
        app.update(input)
    }

    sfn snapshot:void (app:GridApp dir:string file:string) {
        def rb:RasterBuffer (new RasterBuffer)
        rb.width = app.W
        rb.height = app.H
        rb.pixels = (app.raw())
        def png:PNGEncoder (new PNGEncoder)
        png.encode(rb dir file)
    }

    sfn main:void () {
        def app:GridApp (new GridApp)
        app.init("gallery/pdf_writer/assets/fonts")
        def input:UIInput (new UIInput)

        app.render()
        GridDemo.snapshot(app "gallery/datagrid" "grid_1_start.png")

        ; Edit B2
        def ox:int (app.grid.gridOriginX())
        def oy:int (app.grid.gridOriginY())
        def cw0:int (app.model.colWidth(0))
        def rh0:int (app.model.rowHeight(0))
        def bx:int (ox + cw0 + 20)
        def by:int (oy + rh0 + 8)
        GridDemo.click(app input bx by)
        GridDemo.typeText(app input "42")
        GridDemo.key(app input (UIKey.enter()))

        ; Select a range with shift+arrows
        GridDemo.key(app input (UIKey.right()))
        def i:int 0
        while (i < 2) {
            input.newFrame()
            input.setModifiers(true false)
            input.pushKey((UIKey.down()))
            app.update(input)
            i = (i + 1)
        }
        input.newFrame()
        input.setModifiers(false false)
        app.update(input)

        app.render()
        GridDemo.snapshot(app "gallery/datagrid" "grid_2_edit.png")

        ; Scroll down into sparse area
        input.newFrame()
        input.addScroll(-40)
        app.update(input)
        app.render()
        GridDemo.snapshot(app "gallery/datagrid" "grid_3_scroll.png")

        print ("active = " + (app.activeLabel()) + " value=" + (app.activeValue()))
        print ("visible rows " + (to_string app.grid.firstVisibleRow) + ".." + (to_string app.grid.lastVisibleRow))
        print "wrote grid_1_start.png grid_2_edit.png grid_3_scroll.png"
    }
}

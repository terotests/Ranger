; ==============================================================================
; FormulaValue - typed spreadsheet values for the formula stack.
; ==============================================================================
;
; Shared by FormulaFunctions (pure library) and FormulaEngine (workbook eval).
; kind: 0 blank | 1 number | 2 string | 3 bool | 4 error
; ==============================================================================

class FormulaValue {
    def kind:int 0
    def num:double 0.0
    def text:string ""
    def flag:boolean false
    def err:string ""

    Constructor () {
    }

    sfn blank:FormulaValue () {
        return (new FormulaValue)
    }

    sfn fromNumber:FormulaValue (v:double) {
        def o:FormulaValue (new FormulaValue)
        o.kind = 1
        o.num = v
        return o
    }

    sfn fromString:FormulaValue (s:string) {
        def o:FormulaValue (new FormulaValue)
        o.kind = 2
        o.text = s
        return o
    }

    sfn fromBool:FormulaValue (b:boolean) {
        def o:FormulaValue (new FormulaValue)
        o.kind = 3
        o.flag = b
        if b {
            o.num = 1.0
            o.text = "TRUE"
        } {
            o.num = 0.0
            o.text = "FALSE"
        }
        return o
    }

    sfn fromError:FormulaValue (e:string) {
        def o:FormulaValue (new FormulaValue)
        o.kind = 4
        o.err = e
        o.text = e
        return o
    }

    fn isError:boolean () {
        return (kind == 4)
    }

    fn isBlank:boolean () {
        return (kind == 0)
    }

    fn isTrue:boolean () {
        if (kind == 3) {
            return flag
        }
        if (kind == 1) {
            return (num != 0.0)
        }
        if (kind == 2) {
            if ((strlen text) == 0) {
                return false
            }
            return true
        }
        return false
    }

    fn asNumber:double () {
        if (kind == 1) {
            return num
        }
        if (kind == 3) {
            if flag {
                return 1.0
            }
            return 0.0
        }
        if (kind == 2) {
            def p@(optional):double (to_double text)
            if p {
                return (unwrap p)
            }
        }
        return 0.0
    }

    fn tryNumber:boolean (out:[double]) {
        clear out
        if (kind == 1) {
            push out num
            return true
        }
        if (kind == 3) {
            if flag {
                push out 1.0
            } {
                push out 0.0
            }
            return true
        }
        if (kind == 2) {
            def p@(optional):double (to_double text)
            if p {
                push out (unwrap p)
                return true
            }
        }
        return false
    }

    fn asDisplay:string () {
        if (kind == 0) {
            return ""
        }
        if (kind == 4) {
            return err
        }
        if (kind == 3) {
            return text
        }
        if (kind == 2) {
            return text
        }
        def iv:int (to_int num)
        if ((to_double iv) == num) {
            return (to_string iv)
        }
        return (to_string num)
    }
}

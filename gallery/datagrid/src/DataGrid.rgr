; ==============================================================================
; DataGrid - specialized layout engine (virtualization + hit-test).
; ==============================================================================
;
; NOT CSS Grid / EVGGrid. Owns scroll offsets and computes which rows/cols are
; visible for the current viewport. Only those cells are handed to EVG.
;
;   scrollX / scrollY  (content pixels)
;   viewport           (layout.w × layout.h minus headers / formula bar)
;   visible rows/cols  → GridView batched display list
; ==============================================================================

Import "SpreadsheetModel.rgr"
Import "GridSelection.rgr"
Import "SheetView.rgr"

class GridRect {
    def x:int 0
    def y:int 0
    def w:int 0
    def h:int 0

    Constructor () {
    }

    sfn create:GridRect (x:int y:int w:int h:int) {
        def r:GridRect (new GridRect)
        r.x = x
        r.y = y
        r.w = w
        r.h = h
        return r
    }
}

class DataGrid {
    def x:int 0
    def y:int 0
    def w:int 720
    def h:int 440
    ; The toolbar strip above the formula bar. Zero when a host does not want
    ; one — a printed page or an oracle dump has no use for buttons — so the
    ; geometry below is written in terms of it rather than around it.
    def toolbarH:int 0
    def formulaBarH:int 32
    def colHeaderH:int 24
    def rowHeaderW:int 48
    def sheetTabH:int 26
    def scrollX:int 0
    def scrollY:int 0
    def firstVisibleRow:int 0
    def lastVisibleRow:int 0
    def firstVisibleCol:int 0
    def lastVisibleCol:int 0
    def firstScrollRow:int 0
    def lastScrollRow:int 0
    def firstScrollCol:int 0
    def lastScrollCol:int 0
    def resizingCol:int -1
    def resizeStartX:int 0
    def resizeStartW:int 0
    ; Half-width of the header edge grab zone. 3px was hard to land on with a
    ; real mouse; Excel's is about this wide.
    def grabPx:int 4
    def resizingRow:int -1
    def resizeStartY:int 0
    def resizeStartH:int 0
    def sheetView:SheetView
    def hasView:boolean false

    Constructor () {
    }

    fn bindView:void (sv:SheetView) {
        sheetView = sv
        hasView = true
    }

    fn viewRowCount:int (model:SpreadsheetModel) {
        if hasView {
            return (sheetView.rowCount())
        }
        return model.rowCount
    }

    fn viewColCount:int (model:SpreadsheetModel) {
        if hasView {
            return (sheetView.colCount())
        }
        return model.colCount
    }

    fn mapRow:int (viewOrModelRow:int) {
        if hasView {
            return (sheetView.modelRow(viewOrModelRow))
        }
        return viewOrModelRow
    }

    fn mapCol:int (viewOrModelCol:int) {
        if hasView {
            return (sheetView.modelCol(viewOrModelCol))
        }
        return viewOrModelCol
    }

    fn geoRowToY:int (model:SpreadsheetModel row:int) {
        if hasView {
            def vr:int (sheetView.viewRowOf(row))
            if (vr < 0) {
                return -100000
            }
            return (sheetView.rowToY(vr))
        }
        return (model.rowToY(row))
    }

    fn geoColToX:int (model:SpreadsheetModel col:int) {
        if hasView {
            def vc:int (sheetView.viewColOf(col))
            if (vc < 0) {
                return -100000
            }
            return (sheetView.colToX(vc))
        }
        return (model.colToX(col))
    }

    fn geoTotalH:int (model:SpreadsheetModel) {
        if hasView {
            return (sheetView.totalHeight())
        }
        return (model.totalHeight())
    }

    fn geoTotalW:int (model:SpreadsheetModel) {
        if hasView {
            return (sheetView.totalWidth())
        }
        return (model.totalWidth())
    }

    fn geoFrozenH:int (model:SpreadsheetModel) {
        if hasView {
            def fz:int model.freezeRows
            if (fz <= 0) {
                return 0
            }
            ; freeze headers are the leading view rows with modelRow < freezeRows
            def n:int 0
            def i:int 0
            def rc:int (sheetView.rowCount())
            while (i < rc) {
                def mr:int (sheetView.modelRow(i))
                if (mr < fz) {
                    n = (n + 1)
                } {
                    break
                }
                i = (i + 1)
            }
            return (sheetView.rowToY(n))
        }
        return (model.frozenHeight())
    }

    fn geoFrozenW:int (model:SpreadsheetModel) {
        if hasView {
            def fz:int model.freezeCols
            if (fz <= 0) {
                return 0
            }
            def n:int 0
            def i:int 0
            def cc:int (sheetView.colCount())
            while (i < cc) {
                def mc:int (sheetView.modelCol(i))
                if (mc < fz) {
                    n = (n + 1)
                } {
                    break
                }
                i = (i + 1)
            }
            return (sheetView.colToX(n))
        }
        return (model.frozenWidth())
    }

    fn geoYToRow:int (model:SpreadsheetModel y:int) {
        if hasView {
            return (sheetView.yToRow(y))
        }
        return (model.yToRow(y))
    }

    fn geoXToCol:int (model:SpreadsheetModel x:int) {
        if hasView {
            return (sheetView.xToCol(x))
        }
        return (model.xToCol(x))
    }

    fn freezeViewRows:int (model:SpreadsheetModel) {
        if hasView {
            def fz:int model.freezeRows
            def n:int 0
            def i:int 0
            def rc:int (sheetView.rowCount())
            while (i < rc) {
                if ((sheetView.modelRow(i)) < fz) {
                    n = (n + 1)
                } {
                    break
                }
                i = (i + 1)
            }
            return n
        }
        return model.freezeRows
    }

    fn freezeViewCols:int (model:SpreadsheetModel) {
        if hasView {
            def fz:int model.freezeCols
            def n:int 0
            def i:int 0
            def cc:int (sheetView.colCount())
            while (i < cc) {
                if ((sheetView.modelCol(i)) < fz) {
                    n = (n + 1)
                } {
                    break
                }
                i = (i + 1)
            }
            return n
        }
        return model.freezeCols
    }

    fn setBounds:void (bx:int by:int bw:int bh:int) {
        x = bx
        y = by
        w = bw
        h = bh
    }

    fn gridOriginX:int () {
        return (x + rowHeaderW)
    }

    fn toolbarY:int () {
        return y
    }

    fn formulaBarY:int () {
        return (y + toolbarH)
    }

    ; Top of the column header strip — where the sheet proper begins.
    fn headerTop:int () {
        return ((y + toolbarH) + formulaBarH)
    }

    fn gridOriginY:int () {
        return (((y + toolbarH) + formulaBarH) + colHeaderH)
    }

    fn viewportW:int () {
        def vw:int (w - rowHeaderW)
        if (vw < 1) {
            return 1
        }
        return vw
    }

    fn viewportH:int () {
        def vh:int ((((h - toolbarH) - formulaBarH) - colHeaderH) - sheetTabH)
        if (vh < 1) {
            return 1
        }
        return vh
    }

    fn sheetTabY:int () {
        return ((y + h) - sheetTabH)
    }

    fn scrollAreaW:int (model:SpreadsheetModel) {
        def aw:int ((this.viewportW()) - (this.geoFrozenW(model)))
        if (aw < 1) {
            return 1
        }
        return aw
    }

    fn scrollAreaH:int (model:SpreadsheetModel) {
        def ah:int ((this.viewportH()) - (this.geoFrozenH(model)))
        if (ah < 1) {
            return 1
        }
        return ah
    }

    fn clampScroll:void (model:SpreadsheetModel) {
        model.ensureGeometry()
        if hasView {
            sheetView.ensure()
        }
        def fzW:int (this.geoFrozenW(model))
        def fzH:int (this.geoFrozenH(model))
        def maxX:int (((this.geoTotalW(model)) - fzW) - (this.scrollAreaW(model)))
        def maxY:int (((this.geoTotalH(model)) - fzH) - (this.scrollAreaH(model)))
        if (maxX < 0) {
            maxX = 0
        }
        if (maxY < 0) {
            maxY = 0
        }
        if (scrollX < 0) {
            scrollX = 0
        }
        if (scrollY < 0) {
            scrollY = 0
        }
        if (scrollX > maxX) {
            scrollX = maxX
        }
        if (scrollY > maxY) {
            scrollY = maxY
        }
    }

    ; Recompute visible scrollable span. Indices are VIEW rows/cols when hasView.
    fn updateVisible:void (model:SpreadsheetModel) {
        this.clampScroll(model)
        def fzR:int (this.freezeViewRows(model))
        def fzC:int (this.freezeViewCols(model))
        def vrc:int (this.viewRowCount(model))
        def vcc:int (this.viewColCount(model))
        def baseY:int 0
        if hasView {
            baseY = (sheetView.rowToY(fzR))
        } {
            baseY = (model.rowToY(fzR))
        }
        def baseX:int 0
        if hasView {
            baseX = (sheetView.colToX(fzC))
        } {
            baseX = (model.colToX(fzC))
        }
        firstScrollRow = fzR
        if (fzR < vrc) {
            firstScrollRow = (this.geoYToRow(model (baseY + scrollY)))
            if (firstScrollRow < fzR) {
                firstScrollRow = fzR
            }
        }
        def bottomY:int (((baseY + scrollY) + (this.scrollAreaH(model))) - 1)
        lastScrollRow = (this.geoYToRow(model bottomY))
        if (lastScrollRow < firstScrollRow) {
            lastScrollRow = firstScrollRow
        }
        if (lastScrollRow >= vrc) {
            lastScrollRow = (vrc - 1)
        }
        firstScrollCol = fzC
        if (fzC < vcc) {
            firstScrollCol = (this.geoXToCol(model (baseX + scrollX)))
            if (firstScrollCol < fzC) {
                firstScrollCol = fzC
            }
        }
        def rightX:int (((baseX + scrollX) + (this.scrollAreaW(model))) - 1)
        lastScrollCol = (this.geoXToCol(model rightX))
        if (lastScrollCol < firstScrollCol) {
            lastScrollCol = firstScrollCol
        }
        if (lastScrollCol >= vcc) {
            lastScrollCol = (vcc - 1)
        }
        firstVisibleRow = 0
        if (fzR == 0) {
            firstVisibleRow = firstScrollRow
        }
        lastVisibleRow = lastScrollRow
        firstVisibleCol = 0
        if (fzC == 0) {
            firstVisibleCol = firstScrollCol
        }
        lastVisibleCol = lastScrollCol
    }

    fn scrollByPixels:void (model:SpreadsheetModel dx:int dy:int) {
        scrollX = (scrollX + dx)
        scrollY = (scrollY + dy)
        this.updateVisible(model)
    }

    fn scrollByRows:void (model:SpreadsheetModel delta:int) {
        def step:int model.defaultRowH
        this.scrollByPixels(model 0 (delta * step))
    }

    ; Sideways, a column at a time. Without this there was no way to reach a
    ; column that had scrolled off the right edge except by walking the caret
    ; there — the wheel only ever moved rows.
    fn scrollByCols:void (model:SpreadsheetModel delta:int) {
        def step:int model.defaultColW
        if (step < 8) {
            step = 8
        }
        this.scrollByPixels(model (delta * step) 0)
    }

    ; Screen X for a MODEL column (maps through SheetView when bound).
    fn colScreenX:int (model:SpreadsheetModel col:int) {
        def ox:int (this.gridOriginX())
        def fzC:int (this.freezeViewCols(model))
        def x0:int (this.geoColToX(model col))
        def vc:int col
        if hasView {
            vc = (sheetView.viewColOf(col))
            if (vc < 0) {
                return -100000
            }
        }
        if (vc < fzC) {
            return (ox + x0)
        }
        def base:int 0
        if hasView {
            base = (sheetView.colToX(fzC))
        } {
            base = (model.colToX(fzC))
        }
        return (((ox + (this.geoFrozenW(model))) + (x0 - base)) - scrollX)
    }

    fn rowScreenY:int (model:SpreadsheetModel row:int) {
        def oy:int (this.gridOriginY())
        def fzR:int (this.freezeViewRows(model))
        def y0:int (this.geoRowToY(model row))
        def vr:int row
        if hasView {
            vr = (sheetView.viewRowOf(row))
            if (vr < 0) {
                return -100000
            }
        }
        if (vr < fzR) {
            return (oy + y0)
        }
        def base:int 0
        if hasView {
            base = (sheetView.rowToY(fzR))
        } {
            base = (model.rowToY(fzR))
        }
        return (((oy + (this.geoFrozenH(model))) + (y0 - base)) - scrollY)
    }

    ; Screen position helpers for VIEW indices (headers / scroll bands).
    fn viewColScreenX:int (model:SpreadsheetModel viewCol:int) {
        return (this.colScreenX(model (this.mapCol(viewCol))))
    }

    fn viewRowScreenY:int (model:SpreadsheetModel viewRow:int) {
        return (this.rowScreenY(model (this.mapRow(viewRow))))
    }

    ; Visible width of a merge spanning model columns c1..c2. Does not require
    ; c2+1 to be in the view (hidden/filtered columns return sentinel from
    ; geoColToX and would make width negative / collapse the merge).
    fn mergeVisibleWidth:int (model:SpreadsheetModel c1:int c2:int) {
        def w:int 0
        def c:int c1
        while (c <= c2) {
            if hasView {
                if ((sheetView.viewColOf(c)) >= 0) {
                    w = (w + (model.colWidth(c)))
                }
            } {
                w = (w + (model.colWidth(c)))
            }
            c = (c + 1)
        }
        return w
    }

    fn mergeVisibleHeight:int (model:SpreadsheetModel r1:int r2:int) {
        def h:int 0
        def r:int r1
        while (r <= r2) {
            if hasView {
                if ((sheetView.viewRowOf(r)) >= 0) {
                    h = (h + (model.rowHeight(r)))
                }
            } {
                h = (h + (model.rowHeight(r)))
            }
            r = (r + 1)
        }
        return h
    }

    ; Screen-space rect of a MODEL cell (may be partially off-viewport).
    fn cellRect:GridRect (model:SpreadsheetModel row:int col:int) {
        def cx:int (this.colScreenX(model col))
        def cy:int (this.rowScreenY(model row))
        def cw:int (model.colWidth(col))
        def ch:int (model.rowHeight(row))
        def m:string (model.mergeAt(row col))
        if ((strlen m) > 0) {
            def parts:[string] (strsplit m ",")
            def r1:int (SpreadsheetModel.parseInt0((itemAt parts 0)))
            def c1:int (SpreadsheetModel.parseInt0((itemAt parts 1)))
            def r2:int (SpreadsheetModel.parseInt0((itemAt parts 2)))
            def c2:int (SpreadsheetModel.parseInt0((itemAt parts 3)))
            if ((row == r1) && (col == c1)) {
                cx = (this.colScreenX(model c1))
                cy = (this.rowScreenY(model r1))
                cw = (this.mergeVisibleWidth(model c1 c2))
                ch = (this.mergeVisibleHeight(model r1 r2))
                if (cw < 1) {
                    cw = (model.colWidth(c1))
                }
                if (ch < 1) {
                    ch = (model.rowHeight(r1))
                }
            }
        }
        return (GridRect.create(cx cy cw ch))
    }

    ; Active-cell fill handle (FortuneSheet fill handle), 8×8 at bottom-right.
    fn fillHandleRect:GridRect (model:SpreadsheetModel sel:GridSelection) {
        def ar:GridRect (this.cellRect(model sel.active.row sel.active.col))
        return (GridRect.create(((ar.x + ar.w) - 4) ((ar.y + ar.h) - 4) 8 8))
    }

    fn hitFillHandle:boolean (model:SpreadsheetModel sel:GridSelection px:int py:int) {
        def fr:GridRect (this.fillHandleRect(model sel))
        if (px < fr.x) {
            return false
        }
        if (py < fr.y) {
            return false
        }
        if (px >= (fr.x + fr.w)) {
            return false
        }
        if (py >= (fr.y + fr.h)) {
            return false
        }
        return true
    }

    ; The dropdown arrow a list-validated ACTIVE cell shows, on its right edge.
    ; Only the active cell has one, as Excel does: an arrow in every cell of a
    ; validated column would be a wall of arrows.
    fn listArrowRect:GridRect (model:SpreadsheetModel sel:GridSelection) {
        def ar:GridRect (this.cellRect(model sel.active.row sel.active.col))
        def side:int 14
        if (ar.h < side) {
            side = ar.h
        }
        return (GridRect.create(((ar.x + ar.w) - (side + 1)) (ar.y + (idiv (ar.h - side) 2)) side side))
    }

    fn hitListArrow:boolean (model:SpreadsheetModel sel:GridSelection px:int py:int) {
        def r:GridRect (this.listArrowRect(model sel))
        if (px < r.x) {
            return false
        }
        if (py < r.y) {
            return false
        }
        if (px >= (r.x + r.w)) {
            return false
        }
        return (py < (r.y + r.h))
    }

    ; The pixel box of the selection's live rectangle, or a box off screen when
    ; it is not visible.
    fn selectionRect:GridRect (model:SpreadsheetModel sel:GridSelection) {
        def g:GridRange (sel.liveRange())
        def tl:GridRect (this.cellRect(model g.r0 g.c0))
        def br:GridRect (this.cellRect(model g.r1 g.c1))
        return (GridRect.create(tl.x tl.y ((br.x + br.w) - tl.x) ((br.y + br.h) - tl.y)))
    }

    ; Is the pointer on the SELECTION'S EDGE — the band a drag-move grabs? A
    ; four-pixel ring just inside the border, minus the fill handle's corner,
    ; which has its own gesture and wins.
    fn hitSelectionEdge:boolean (model:SpreadsheetModel sel:GridSelection px:int py:int) {
        if (this.hitFillHandle(model sel px py)) {
            return false
        }
        def r:GridRect (this.selectionRect(model sel))
        if (r.w <= 0) {
            return false
        }
        if (r.h <= 0) {
            return false
        }
        def band:int 4
        if (px < (r.x - band)) {
            return false
        }
        if (py < (r.y - band)) {
            return false
        }
        if (px > ((r.x + r.w) + band)) {
            return false
        }
        if (py > ((r.y + r.h) + band)) {
            return false
        }
        ; Inside the ring means inside the selection but not near an edge.
        def innerX:boolean ((px > (r.x + band)) && (px < ((r.x + r.w) - band)))
        def innerY:boolean ((py > (r.y + band)) && (py < ((r.y + r.h) - band)))
        if (innerX && innerY) {
            return false
        }
        return true
    }

    ; Where the sheet tabs were last painted: one entry per VISIBLE tab, in the
    ; order they were drawn. The view fills these because only the view can
    ; measure a name, and a tab is as wide as its name — a hit test that
    ; assumed a fixed slot would pick the wrong sheet the moment one of them
    ; was called "Q3 Forecast (draft)".
    def tabXs:[int]
    def tabWs:[int]
    def tabSheets:[int]

    fn clearTabLayout:void () {
        clear tabXs
        clear tabWs
        clear tabSheets
    }

    fn addTabLayout:void (sheetIndex:int tx:int tw:int) {
        push tabXs tx
        push tabWs tw
        push tabSheets sheetIndex
    }

    ; Sheet tab index under pointer, or -1.
    fn hitSheetTab:int (sheetCount:int px:int py:int) {
        def ty:int (this.sheetTabY())
        if (py < ty) {
            return -1
        }
        if (py >= (y + h)) {
            return -1
        }
        if (px < x) {
            return -1
        }
        if (px >= (x + w)) {
            return -1
        }
        if ((array_length tabXs) > 0) {
            def i:int 0
            while (i < (array_length tabXs)) {
                def tx:int (itemAt tabXs i)
                def tw:int (itemAt tabWs i)
                if (px >= tx) {
                    if (px < (tx + tw)) {
                        return (itemAt tabSheets i)
                    }
                }
                i = (i + 1)
            }
            return -1
        }
        ; Nothing painted yet: fall back to the fixed slots the view uses as
        ; its minimum, so a hit test before the first frame still lands.
        def tabW:int 88
        def k:int (to_int ((to_double (px - x)) / (to_double tabW)))
        if (k < 0) {
            return -1
        }
        if (k >= sheetCount) {
            return -1
        }
        return k
    }

    fn ensureCellVisible:void (model:SpreadsheetModel row:int col:int) {
        def p:CellPos (CellPos.create(row col))
        model.clampPos(p)
        ; Scroll in VIEW coordinates when SheetView is bound — a sorted/filtered
        ; model-row 500 may be the first body row on screen.
        if hasView {
            def vr:int (sheetView.viewRowOf(p.row))
            def vc:int (sheetView.viewColOf(p.col))
            def fzR:int (this.freezeViewRows(model))
            def fzC:int (this.freezeViewCols(model))
            if (vr >= 0) {
                if (vr < fzR) {
                } {
                    def baseY:int (sheetView.rowToY(fzR))
                    def y0:int ((sheetView.rowToY(vr)) - baseY)
                    def y1:int (y0 + (sheetView.rowHeight(vr)))
                    def sh:int (this.scrollAreaH(model))
                    if (y0 < scrollY) {
                        scrollY = y0
                    }
                    if (y1 > (scrollY + sh)) {
                        scrollY = (y1 - sh)
                    }
                }
            }
            if (vc >= 0) {
                if (vc < fzC) {
                } {
                    def baseX:int (sheetView.colToX(fzC))
                    def x0:int ((sheetView.colToX(vc)) - baseX)
                    def x1:int (x0 + (sheetView.colWidth(vc)))
                    def sw:int (this.scrollAreaW(model))
                    if (x0 < scrollX) {
                        scrollX = x0
                    }
                    if (x1 > (scrollX + sw)) {
                        scrollX = (x1 - sw)
                    }
                }
            }
            this.updateVisible(model)
            return
        }
        if (p.row < model.freezeRows) {
            ; frozen rows always visible
        } {
            def baseY2:int (model.rowToY(model.freezeRows))
            def y0b:int ((model.rowToY(p.row)) - baseY2)
            def y1b:int (y0b + (model.rowHeight(p.row)))
            def sh2:int (this.scrollAreaH(model))
            if (y0b < scrollY) {
                scrollY = y0b
            }
            if (y1b > (scrollY + sh2)) {
                scrollY = (y1b - sh2)
            }
        }
        if (p.col < model.freezeCols) {
        } {
            def baseX2:int (model.colToX(model.freezeCols))
            def x0b:int ((model.colToX(p.col)) - baseX2)
            def x1b:int (x0b + (model.colWidth(p.col)))
            def sw2:int (this.scrollAreaW(model))
            if (x0b < scrollX) {
                scrollX = x0b
            }
            if (x1b > (scrollX + sw2)) {
                scrollX = (x1b - sw2)
            }
        }
        this.updateVisible(model)
    }

    ; Map pointer in body to content coordinates with freeze.
    fn hitTest:CellPos (model:SpreadsheetModel px:int py:int) {
        def miss:CellPos (CellPos.create(-1 -1))
        if (px < x) {
            return miss
        }
        if (py < y) {
            return miss
        }
        if (px >= (x + w)) {
            return miss
        }
        if (py >= (y + h)) {
            return miss
        }
        if (py < (this.headerTop())) {
            ; Toolbar lives above the formula bar — a miss on a tool button
            ; must not start an edit. Only the formula bar itself does.
            if (py < (this.formulaBarY())) {
                return miss
            }
            return (CellPos.create(-3 -3))
        }
        def headerTop:int (this.headerTop())
        def bodyLeft:int (x + rowHeaderW)
        def bodyTop:int (headerTop + colHeaderH)
        if ((px < bodyLeft) && (py < bodyTop)) {
            return (CellPos.create(-4 -4))
        }
        def fzW:int (this.geoFrozenW(model))
        def fzH:int (this.geoFrozenH(model))
        def fzR:int (this.freezeViewRows(model))
        def fzC:int (this.freezeViewCols(model))
        if (py < bodyTop) {
            def localX:int (px - bodyLeft)
            def contentX:int localX
            if (localX >= fzW) {
                def baseX:int 0
                if hasView {
                    baseX = (sheetView.colToX(fzC))
                } {
                    baseX = (model.colToX(fzC))
                }
                contentX = ((baseX + (localX - fzW)) + scrollX)
            }
            def vcol:int (this.geoXToCol(model contentX))
            def mcol:int (this.mapCol(vcol))
            return (CellPos.create(-2 mcol))
        }
        if (px < bodyLeft) {
            def localY:int (py - bodyTop)
            def contentY:int localY
            if (localY >= fzH) {
                def baseY:int 0
                if hasView {
                    baseY = (sheetView.rowToY(fzR))
                } {
                    baseY = (model.rowToY(fzR))
                }
                contentY = ((baseY + (localY - fzH)) + scrollY)
            }
            def vrow:int (this.geoYToRow(model contentY))
            def mrow:int (this.mapRow(vrow))
            return (CellPos.create(mrow -2))
        }
        def lx:int (px - bodyLeft)
        def ly:int (py - bodyTop)
        def cx:int lx
        def cy:int ly
        if (lx >= fzW) {
            def baseX2:int 0
            if hasView {
                baseX2 = (sheetView.colToX(fzC))
            } {
                baseX2 = (model.colToX(fzC))
            }
            cx = ((baseX2 + (lx - fzW)) + scrollX)
        }
        if (ly >= fzH) {
            def baseY2:int 0
            if hasView {
                baseY2 = (sheetView.rowToY(fzR))
            } {
                baseY2 = (model.rowToY(fzR))
            }
            cy = ((baseY2 + (ly - fzH)) + scrollY)
        }
        def vr:int (this.geoYToRow(model cy))
        def vc:int (this.geoXToCol(model cx))
        def r:int (this.mapRow(vr))
        def c:int (this.mapCol(vc))
        def p:CellPos (CellPos.create(r c))
        model.clampPos(p)
        ; Merged area → origin (FortuneSheet / Excel selection behaviour)
        def mk:string (model.mergeAt(p.row p.col))
        if ((strlen mk) > 0) {
            def parts:[string] (strsplit mk ",")
            if ((array_length parts) >= 2) {
                p.row = (SpreadsheetModel.parseInt0((itemAt parts 0)))
                p.col = (SpreadsheetModel.parseInt0((itemAt parts 1)))
            }
        }
        return p
    }

    ; Row resize hit: near bottom edge of a row header. Iterates VIEW
    ; rows so sort / filter order does not shift the grab zone.
    fn hitRowResize:int (model:SpreadsheetModel px:int py:int) {
        def headerTop:int (this.headerTop())
        def bodyLeft:int (x + rowHeaderW)
        def bodyTop:int (headerTop + colHeaderH)
        if (px < x) {
            return -1
        }
        if (px >= bodyLeft) {
            return -1
        }
        if (py < bodyTop) {
            return -1
        }
        if (py >= (y + h)) {
            return -1
        }
        this.updateVisible(model)
        def vr:int 0
        def last:int lastScrollRow
        while (vr <= last) {
            def r:int (this.mapRow(vr))
            def top:int (this.rowScreenY(model r))
            def edge:int ((top + (model.rowHeight(r))) - 1)
            def d:int (py - edge)
            if (d < 0) {
                d = (0 - d)
            }
            if (d <= grabPx) {
                return r
            }
            vr = (vr + 1)
        }
        return -1
    }

    ; Column resize hit: near right edge of a column header.
    fn hitColResize:int (model:SpreadsheetModel px:int py:int) {
        def headerTop:int (this.headerTop())
        def bodyLeft:int (x + rowHeaderW)
        def bodyTop:int (headerTop + colHeaderH)
        if (py < headerTop) {
            return -1
        }
        if (py >= bodyTop) {
            return -1
        }
        if (px < bodyLeft) {
            return -1
        }
        this.updateVisible(model)
        def c:int 0
        def last:int lastScrollCol
        while (c <= last) {
            def edge:int (((this.colScreenX(model c)) + (model.colWidth(c))) - 1)
            def d:int (px - edge)
            if (d < 0) {
                d = (0 - d)
            }
            if (d <= grabPx) {
                return c
            }
            c = (c + 1)
        }
        return -1
    }
}

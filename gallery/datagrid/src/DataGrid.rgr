; ==============================================================================
; DataGrid - specialized layout engine (virtualization + hit-test).
; ==============================================================================
;
; NOT CSS Grid / EVGGrid. Owns scroll offsets and computes which rows/cols are
; visible for the current viewport. Only those cells are handed to EVG.
;
;   scrollX / scrollY  (content pixels)
;   viewport           (layout.w × layout.h minus headers / formula bar)
;   visible rows/cols  → GridView batched display list
; ==============================================================================

Import "SpreadsheetModel.rgr"
Import "GridSelection.rgr"

class GridRect {
    def x:int 0
    def y:int 0
    def w:int 0
    def h:int 0

    Constructor () {
    }

    sfn create:GridRect (x:int y:int w:int h:int) {
        def r:GridRect (new GridRect)
        r.x = x
        r.y = y
        r.w = w
        r.h = h
        return r
    }
}

class DataGrid {
    def x:int 0
    def y:int 0
    def w:int 720
    def h:int 440
    def formulaBarH:int 28
    def colHeaderH:int 24
    def rowHeaderW:int 48
    def sheetTabH:int 26
    def scrollX:int 0
    def scrollY:int 0
    def firstVisibleRow:int 0
    def lastVisibleRow:int 0
    def firstVisibleCol:int 0
    def lastVisibleCol:int 0
    def firstScrollRow:int 0
    def lastScrollRow:int 0
    def firstScrollCol:int 0
    def lastScrollCol:int 0
    def resizingCol:int -1
    def resizeStartX:int 0
    def resizeStartW:int 0

    Constructor () {
    }

    fn setBounds:void (bx:int by:int bw:int bh:int) {
        x = bx
        y = by
        w = bw
        h = bh
    }

    fn gridOriginX:int () {
        return (x + rowHeaderW)
    }

    fn gridOriginY:int () {
        return (y + formulaBarH + colHeaderH)
    }

    fn viewportW:int () {
        def vw:int (w - rowHeaderW)
        if (vw < 1) {
            return 1
        }
        return vw
    }

    fn viewportH:int () {
        def vh:int (h - formulaBarH - colHeaderH - sheetTabH)
        if (vh < 1) {
            return 1
        }
        return vh
    }

    fn sheetTabY:int () {
        return ((y + h) - sheetTabH)
    }

    fn scrollAreaW:int (model:SpreadsheetModel) {
        def aw:int ((this.viewportW()) - (model.frozenWidth()))
        if (aw < 1) {
            return 1
        }
        return aw
    }

    fn scrollAreaH:int (model:SpreadsheetModel) {
        def ah:int ((this.viewportH()) - (model.frozenHeight()))
        if (ah < 1) {
            return 1
        }
        return ah
    }

    fn clampScroll:void (model:SpreadsheetModel) {
        model.ensureGeometry()
        def fzW:int (model.frozenWidth())
        def fzH:int (model.frozenHeight())
        def maxX:int (((model.totalWidth()) - fzW) - (this.scrollAreaW(model)))
        def maxY:int (((model.totalHeight()) - fzH) - (this.scrollAreaH(model)))
        if (maxX < 0) {
            maxX = 0
        }
        if (maxY < 0) {
            maxY = 0
        }
        if (scrollX < 0) {
            scrollX = 0
        }
        if (scrollY < 0) {
            scrollY = 0
        }
        if (scrollX > maxX) {
            scrollX = maxX
        }
        if (scrollY > maxY) {
            scrollY = maxY
        }
    }

    ; Recompute visible scrollable span (FortuneSheet freeze = fixed bands).
    fn updateVisible:void (model:SpreadsheetModel) {
        this.clampScroll(model)
        def fzR:int model.freezeRows
        def fzC:int model.freezeCols
        def baseY:int (model.rowToY(fzR))
        def baseX:int (model.colToX(fzC))
        firstScrollRow = fzR
        if (fzR < model.rowCount) {
            firstScrollRow = (model.yToRow((baseY + scrollY)))
            if (firstScrollRow < fzR) {
                firstScrollRow = fzR
            }
        }
        def bottomY:int (((baseY + scrollY) + (this.scrollAreaH(model))) - 1)
        lastScrollRow = (model.yToRow(bottomY))
        if (lastScrollRow < firstScrollRow) {
            lastScrollRow = firstScrollRow
        }
        if (lastScrollRow >= model.rowCount) {
            lastScrollRow = (model.rowCount - 1)
        }
        firstScrollCol = fzC
        if (fzC < model.colCount) {
            firstScrollCol = (model.xToCol((baseX + scrollX)))
            if (firstScrollCol < fzC) {
                firstScrollCol = fzC
            }
        }
        def rightX:int (((baseX + scrollX) + (this.scrollAreaW(model))) - 1)
        lastScrollCol = (model.xToCol(rightX))
        if (lastScrollCol < firstScrollCol) {
            lastScrollCol = firstScrollCol
        }
        if (lastScrollCol >= model.colCount) {
            lastScrollCol = (model.colCount - 1)
        }
        ; Status / simple loops: union of frozen + scrollable
        firstVisibleRow = 0
        if (fzR == 0) {
            firstVisibleRow = firstScrollRow
        }
        lastVisibleRow = lastScrollRow
        firstVisibleCol = 0
        if (fzC == 0) {
            firstVisibleCol = firstScrollCol
        }
        lastVisibleCol = lastScrollCol
    }

    fn scrollByPixels:void (model:SpreadsheetModel dx:int dy:int) {
        scrollX = (scrollX + dx)
        scrollY = (scrollY + dy)
        this.updateVisible(model)
    }

    fn scrollByRows:void (model:SpreadsheetModel delta:int) {
        def step:int model.defaultRowH
        this.scrollByPixels(model 0 (delta * step))
    }

    ; Screen X for a column, honouring freeze (FortuneSheet frozen columns).
    fn colScreenX:int (model:SpreadsheetModel col:int) {
        def ox:int (this.gridOriginX())
        def fzC:int model.freezeCols
        def x0:int (model.colToX(col))
        if (col < fzC) {
            return (ox + x0)
        }
        def base:int (model.colToX(fzC))
        return (((ox + (model.frozenWidth())) + (x0 - base)) - scrollX)
    }

    fn rowScreenY:int (model:SpreadsheetModel row:int) {
        def oy:int (this.gridOriginY())
        def fzR:int model.freezeRows
        def y0:int (model.rowToY(row))
        if (row < fzR) {
            return (oy + y0)
        }
        def base:int (model.rowToY(fzR))
        return (((oy + (model.frozenHeight())) + (y0 - base)) - scrollY)
    }

    ; Screen-space rect of a cell (may be partially off-viewport).
    fn cellRect:GridRect (model:SpreadsheetModel row:int col:int) {
        def cx:int (this.colScreenX(model col))
        def cy:int (this.rowScreenY(model row))
        def cw:int (model.colWidth(col))
        def ch:int (model.rowHeight(row))
        def m:string (model.mergeAt(row col))
        if ((strlen m) > 0) {
            def parts:[string] (strsplit m ",")
            def r1:int (SpreadsheetModel.parseInt0((itemAt parts 0)))
            def c1:int (SpreadsheetModel.parseInt0((itemAt parts 1)))
            def r2:int (SpreadsheetModel.parseInt0((itemAt parts 2)))
            def c2:int (SpreadsheetModel.parseInt0((itemAt parts 3)))
            if ((row == r1) && (col == c1)) {
                cx = (this.colScreenX(model c1))
                cy = (this.rowScreenY(model r1))
                def x2:int (this.colScreenX(model (c2 + 1)))
                ; if c2+1 is past freeze boundary, width from geometry
                cw = ((model.colToX((c2 + 1))) - (model.colToX(c1)))
                ch = ((model.rowToY((r2 + 1))) - (model.rowToY(r1)))
                if (x2 > 0) {
                    ; keep cw from offsets for merges spanning freeze
                }
            }
        }
        return (GridRect.create(cx cy cw ch))
    }

    ; Active-cell fill handle (FortuneSheet fill handle), 8×8 at bottom-right.
    fn fillHandleRect:GridRect (model:SpreadsheetModel sel:GridSelection) {
        def ar:GridRect (this.cellRect(model sel.active.row sel.active.col))
        return (GridRect.create(((ar.x + ar.w) - 4) ((ar.y + ar.h) - 4) 8 8))
    }

    fn hitFillHandle:boolean (model:SpreadsheetModel sel:GridSelection px:int py:int) {
        def fr:GridRect (this.fillHandleRect(model sel))
        if (px < fr.x) {
            return false
        }
        if (py < fr.y) {
            return false
        }
        if (px >= (fr.x + fr.w)) {
            return false
        }
        if (py >= (fr.y + fr.h)) {
            return false
        }
        return true
    }

    ; Sheet tab index under pointer, or -1.
    fn hitSheetTab:int (sheetCount:int px:int py:int) {
        def ty:int (this.sheetTabY())
        if (py < ty) {
            return -1
        }
        if (py >= (y + h)) {
            return -1
        }
        if (px < x) {
            return -1
        }
        if (px >= (x + w)) {
            return -1
        }
        def tabW:int 88
        def i:int (to_int ((to_double (px - x)) / (to_double tabW)))
        if (i < 0) {
            return -1
        }
        if (i >= sheetCount) {
            return -1
        }
        return i
    }

    fn ensureCellVisible:void (model:SpreadsheetModel row:int col:int) {
        def p:CellPos (CellPos.create(row col))
        model.clampPos(p)
        if (p.row < model.freezeRows) {
            ; frozen rows always visible
        } {
            def baseY:int (model.rowToY(model.freezeRows))
            def y0:int ((model.rowToY(p.row)) - baseY)
            def y1:int (y0 + (model.rowHeight(p.row)))
            def sh:int (this.scrollAreaH(model))
            if (y0 < scrollY) {
                scrollY = y0
            }
            if (y1 > (scrollY + sh)) {
                scrollY = (y1 - sh)
            }
        }
        if (p.col < model.freezeCols) {
        } {
            def baseX:int (model.colToX(model.freezeCols))
            def x0:int ((model.colToX(p.col)) - baseX)
            def x1:int (x0 + (model.colWidth(p.col)))
            def sw:int (this.scrollAreaW(model))
            if (x0 < scrollX) {
                scrollX = x0
            }
            if (x1 > (scrollX + sw)) {
                scrollX = (x1 - sw)
            }
        }
        this.updateVisible(model)
    }

    ; Map pointer in body to content coordinates with freeze.
    fn hitTest:CellPos (model:SpreadsheetModel px:int py:int) {
        def miss:CellPos (CellPos.create(-1 -1))
        if (px < x) {
            return miss
        }
        if (py < y) {
            return miss
        }
        if (px >= (x + w)) {
            return miss
        }
        if (py >= (y + h)) {
            return miss
        }
        if (py < (y + formulaBarH)) {
            return (CellPos.create(-3 -3))
        }
        def headerTop:int (y + formulaBarH)
        def bodyLeft:int (x + rowHeaderW)
        def bodyTop:int (headerTop + colHeaderH)
        if ((px < bodyLeft) && (py < bodyTop)) {
            return (CellPos.create(-4 -4))
        }
        def fzW:int (model.frozenWidth())
        def fzH:int (model.frozenHeight())
        def fzR:int model.freezeRows
        def fzC:int model.freezeCols
        if (py < bodyTop) {
            def localX:int (px - bodyLeft)
            def contentX:int localX
            if (localX >= fzW) {
                def baseX:int (model.colToX(fzC))
                contentX = ((baseX + (localX - fzW)) + scrollX)
            }
            def col:int (model.xToCol(contentX))
            return (CellPos.create(-2 col))
        }
        if (px < bodyLeft) {
            def localY:int (py - bodyTop)
            def contentY:int localY
            if (localY >= fzH) {
                def baseY:int (model.rowToY(fzR))
                contentY = ((baseY + (localY - fzH)) + scrollY)
            }
            def row:int (model.yToRow(contentY))
            return (CellPos.create(row -2))
        }
        def lx:int (px - bodyLeft)
        def ly:int (py - bodyTop)
        def cx:int lx
        def cy:int ly
        if (lx >= fzW) {
            def baseX2:int (model.colToX(fzC))
            cx = ((baseX2 + (lx - fzW)) + scrollX)
        }
        if (ly >= fzH) {
            def baseY2:int (model.rowToY(fzR))
            cy = ((baseY2 + (ly - fzH)) + scrollY)
        }
        def r:int (model.yToRow(cy))
        def c:int (model.xToCol(cx))
        def p:CellPos (CellPos.create(r c))
        model.clampPos(p)
        return p
    }

    ; Column resize hit: near right edge of a column header (±3px).
    fn hitColResize:int (model:SpreadsheetModel px:int py:int) {
        def headerTop:int (y + formulaBarH)
        def bodyLeft:int (x + rowHeaderW)
        def bodyTop:int (headerTop + colHeaderH)
        if (py < headerTop) {
            return -1
        }
        if (py >= bodyTop) {
            return -1
        }
        if (px < bodyLeft) {
            return -1
        }
        this.updateVisible(model)
        def c:int 0
        def last:int lastScrollCol
        while (c <= last) {
            def edge:int (((this.colScreenX(model c)) + (model.colWidth(c))) - 1)
            def d:int (px - edge)
            if (d < 0) {
                d = (0 - d)
            }
            if (d <= 3) {
                return c
            }
            c = (c + 1)
        }
        return -1
    }
}

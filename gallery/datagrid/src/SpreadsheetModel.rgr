; ==============================================================================
; SpreadsheetModel - sparse cell store + row/column geometry for DataGrid.
; ==============================================================================
;
; EVG paints cells; EVG is NOT the spreadsheet model. Geometry (row heights,
; column widths, prefix offsets) lives here so DataGrid can virtualize without
; CSS grid / one View per cell.
;
; Cell values are sparse by row, then by int column. Empty cells are absent —
; a 100k×26 sheet costs almost nothing until cells are written.
; ==============================================================================

Import "CellStyle.rgr"
Import "DataValidation.rgr"
Import "RichText.rgr"
Import "SheetImage.rgr"
Import "SheetTable.rgr"
Import "XlsxNumberFormat.rgr"

; Conditional formatting rule (parsed from xlsx cfRule).
class CfRule {
    ; 0 colorScale | 1 cellIs
    def kind:int 0
    def r0:int 0
    def c0:int 0
    def r1:int 0
    def c1:int 0
    def op:string ""
    def v1:double 0.0
    def v2:double 0.0
    def fillRgb:string ""
    def color0:string "F8696B"
    def color1:string "FFEB84"
    def color2:string "63BE7B"

    Constructor () {
    }
}

class CellPos {
    def row:int 0
    def col:int 0

    Constructor () {
    }

    sfn create:CellPos (row:int col:int) {
        def p:CellPos (new CellPos)
        p.row = row
        p.col = col
        return p
    }

    fn copyFrom:void (other:CellPos) {
        row = other.row
        col = other.col
    }

    fn equals:boolean (other:CellPos) {
        if (row != other.row) {
            return false
        }
        return (col == other.col)
    }
}

; One tracked cell edit. Both the display value and the formula text are
; captured so undo of "=A1+B1" restores the formula, not just the number.
; Ops sharing a non-zero txId undo/redo together (paste, fill, delete range).
class SpreadsheetUndoOp {
    def row:int 0
    def col:int 0
    def before:string ""
    def after:string ""
    def beforeF:string ""
    def afterF:string ""
    def beforeStyle:int -1
    def afterStyle:int -1
    def touchStyle:boolean false
    ; Structural op: 0 none, 1 insert column, 2 delete column, 3 move column,
    ; 4 insert row, 5 delete row, 6 move row, 7 reorder every row (a sort).
    ; Rows and columns share the
    ; snapshot fields below: what they hold is "the line that was lifted out",
    ; and which direction it ran is what `structKind` says.
    def structKind:int 0
    def structAt:int 0
    def structTo:int 0
    def colValues:[string]
    def colFormulas:[string]
    def colStyles:[int]
    def colWidthSaved:int 0
    ; The permutation a sort applied: `structOrder[i]` is the row that ended
    ; up at i. Undo runs its inverse.
    def structOrder:[int]
    ; Every formula in the sheet before the op. A reference into a deleted
    ; column becomes #REF!, which no amount of re-shifting can undo, so the
    ; original text is the only way back.
    def savedKeys:[string]
    def savedTexts:[string]
    ; Formulas on OTHER workbook sheets that named this sheet (qualified
    ; refs). GridApp fills these before adjustFormulasFor; undo restores them
    ; because SpreadsheetModel only owns the active sheet's snapshot above.
    def otherSheetIdx:[int]
    def otherKeys:[string]
    def otherTexts:[string]
    def txId:int 0

    Constructor () {
    }

    fn copyFrom:void (o:SpreadsheetUndoOp) {
        row = o.row
        col = o.col
        before = o.before
        after = o.after
        beforeF = o.beforeF
        afterF = o.afterF
        beforeStyle = o.beforeStyle
        afterStyle = o.afterStyle
        touchStyle = o.touchStyle
        ; The structural payload has to come too — an op that loses structKind
        ; on its way to the redo stack is replayed as a plain cell edit.
        structKind = o.structKind
        structAt = o.structAt
        structTo = o.structTo
        colWidthSaved = o.colWidthSaved
        clear structOrder
        def so:int 0
        while (so < (array_length o.structOrder)) {
            push structOrder (itemAt o.structOrder so)
            so = (so + 1)
        }
        clear colValues
        clear colFormulas
        clear colStyles
        clear savedKeys
        clear savedTexts
        clear otherSheetIdx
        clear otherKeys
        clear otherTexts
        def i:int 0
        while (i < (array_length o.colValues)) {
            push colValues (itemAt o.colValues i)
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length o.colFormulas)) {
            push colFormulas (itemAt o.colFormulas j)
            j = (j + 1)
        }
        def k:int 0
        while (k < (array_length o.colStyles)) {
            push colStyles (itemAt o.colStyles k)
            k = (k + 1)
        }
        def m:int 0
        while (m < (array_length o.savedKeys)) {
            push savedKeys (itemAt o.savedKeys m)
            m = (m + 1)
        }
        def n:int 0
        while (n < (array_length o.savedTexts)) {
            push savedTexts (itemAt o.savedTexts n)
            n = (n + 1)
        }
        def oi:int 0
        while (oi < (array_length o.otherSheetIdx)) {
            push otherSheetIdx (itemAt o.otherSheetIdx oi)
            oi = (oi + 1)
        }
        def ok:int 0
        while (ok < (array_length o.otherKeys)) {
            push otherKeys (itemAt o.otherKeys ok)
            ok = (ok + 1)
        }
        def ot:int 0
        while (ot < (array_length o.otherTexts)) {
            push otherTexts (itemAt o.otherTexts ot)
            ot = (ot + 1)
        }
        txId = o.txId
    }
}

class SpreadsheetModel {
    def name:string ""
    ; The query this sheet was built from, if it was built from one. A sheet
    ; remembers its own SQL because the box that runs queries is one box and
    ; the workbook holds many sheets: without this, coming back to a sheet
    ; and asking "what is this one?" has no answer, and every re-run had to
    ; make yet another sheet rather than refresh the one being looked at.
    def dbSql:string ""
    def rowCount:int 1000
    def colCount:int 26
    ; Excel's own defaults, in CSS pixels: a row is 15 points and a column is
    ; 8.43 characters of the default font. This used to be 22 and 100 — a grid
    ; half again as wide per column as the one the same file opens as in Excel
    ; or Sheets, which reads as everything being zoomed in, and text that is
    ; the right size looking too big for the sheet around it.
    def defaultRowH:int 20
    def defaultColW:int 64
    ; What a cell with no style of its own is set in. A workbook states this
    ; once and every unstyled cell wears it: Arial 10 in a sheet written by
    ; Google, Calibri 11 in one written by Excel. Assuming 11 drew a 10pt
    ; sheet a tenth too large, and — since a row is as tall as the type in it
    ; — a tenth too tall as well.
    def defaultFontPt:double 11.0
    def freezeRows:int 0
    def freezeCols:int 0
    ; Cell values, sparse by row then column. Was a flat `"row,col"` string map:
    ; that is fine in JS (shared string keys) and catastrophic in C++ (a new
    ; std::string key per cell — minutes to insert 4M entries). Row maps keyed
    ; by int column avoid the string churn; `set_at` writes the row map back
    ; because C++ `itemAt` returns a copy.
    def cellRows:[[int:string]]
    def formulas:[string:string]
    def formulaKeys:[string]
    def cellStyleIds:[string:int]
    def styles:[CellStyle]
    def merges:[string]
    def rowHeights:[int]
    def colWidths:[int]
    def rowOffsets:[int]
    def colOffsets:[int]
    def rowHidden:[boolean]
    def colHidden:[boolean]
    def rowSuppressed:[boolean]
    def filterCol:int -1
    def filterValues:[string]
    def filterEnabled:boolean false
    def sortCol:int -1
    def sortAsc:boolean true
    def cfRules:[CfRule]
    ; Cell annotations that are not the cell's value: a link to somewhere, a
    ; note about it, and a rule about what may be typed into it. All three are
    ; keyed the same way as a cell, and all three are METADATA — they survive
    ; an edit of the value and are not on the undo stack, which is also why
    ; they are not in `cells`.
    def validations:[DataValidation]
    ; Where an array formula's result was laid out. The anchor's key maps to
    ; "rows,cols"; every cell it covers maps back to the anchor, so a paint or
    ; an edit can ask "is this mine?" without searching.
    def spillSize:[string:string]
    def spillOwner:[string:string]
    def spillKeys:[string]
    ; Cells whose text is drawn in pieces. Keyed like everything else, and kept
    ; beside the value rather than inside it — see RichText.
    ; Pictures floating over this sheet, in the order the drawing listed them.
    def images:[SheetImage]
    ; Tables (ListObjects) on this sheet. A table's NAME is workbook-wide, so
    ; the lookup that formulas use lives on WorkbookModel; this is only where
    ; the ones belonging to this sheet are kept.
    def tables:[SheetTable]
    def richCells:[string:RichText]
    def richKeys:[string]
    def links:[string:string]
    def linkKeys:[string]
    def notes:[string:string]
    def noteKeys:[string]
    def sheetHidden:boolean false
    def scrollXSaved:int 0
    def scrollYSaved:int 0
    def rowGeomDirty:boolean true
    def colGeomDirty:boolean true
    def undoStack:[SpreadsheetUndoOp]
    def redoStack:[SpreadsheetUndoOp]
    def touched:[CellPos]
    ; Set when an undo / redo replayed a structural op, so the caller knows to
    ; rebuild the formula engine rather than sync a few cells.
    def structDirty:boolean false
    def usedMaxRow:int 0
    def usedMaxCol:int 0
    def txCounter:int 0
    def txDepth:int 0
    def curTx:int 0
    def maxUndo:int 200
    def version:int 0
    ; When true, `setCellRaw` / style / height writers skip bumping `version`
    ; on every cell. Xlsx load writes millions of cells; a version stamp per
    ; write was free on the JS heap and expensive as native store traffic.
    def quietWrites:boolean false

    Constructor () {
    }

    fn clearSheet:void () {
        def emptyRows:[[int:string]]
        def emptyFormulas:[string:string]
        def emptyStyleIds:[string:int]
        cellRows = emptyRows
        formulas = emptyFormulas
        cellStyleIds = emptyStyleIds
        clear formulaKeys
        clear styles
        clear merges
        clear cfRules
        clear rowHeights
        clear colWidths
        clear rowOffsets
        clear colOffsets
        clear rowHidden
        clear colHidden
        clear rowSuppressed
        clear filterValues
        clear tables
        clear undoStack
        clear redoStack
        freezeRows = 0
        freezeCols = 0
        filterCol = -1
        filterEnabled = false
        sortCol = -1
        sortAsc = true
        sheetHidden = false
        usedMaxRow = 0
        usedMaxCol = 0
        rowCount = 1
        colCount = 1
        rowGeomDirty = true
        colGeomDirty = true
        version = (version + 1)
        this.ensureGeometry()
    }

    fn cellKey:string (row:int col:int) {
        return ((to_string row) + "," + (to_string col))
    }

    fn ensureCellRow:void (row:int) {
        while ((array_length cellRows) <= row) {
            def blank:[int:string]
            push cellRows blank
        }
    }

    ; A1, B17, AA3 — 0-based row/col in, Excel-style label out.
    sfn colLabel:string (col:int) {
        def c:int col
        def out:string ""
        while (c >= 0) {
            def rem:int (c - ((to_int (c / 26)) * 26))
            out = ((strfromcode (65 + rem)) + out)
            c = ((to_int (c / 26)) - 1)
        }
        return out
    }

    sfn cellLabel:string (row:int col:int) {
        return ((SpreadsheetModel.colLabel(col)) + (to_string (row + 1)))
    }

    ; Allocate per-row / per-column size arrays when missing. Does NOT rebuild
    ; prefix-sum offsets — `autoFitRows` (and any bulk height pass) calls
    ; `rowHeight` / `setRowHeight` once per row, and rebuilding offsets on
    ; every call is O(rows²). Paint paths still go through `ensureGeometry`.
    fn ensureSizeArrays:void () {
        if ((array_length rowHeights) != rowCount) {
            clear rowHeights
            clear rowHidden
            def i:int 0
            while (i < rowCount) {
                push rowHeights defaultRowH
                push rowHidden false
                i = (i + 1)
            }
            rowGeomDirty = true
        }
        if ((array_length colWidths) != colCount) {
            clear colWidths
            clear colHidden
            def j:int 0
            while (j < colCount) {
                push colWidths defaultColW
                push colHidden false
                j = (j + 1)
            }
            colGeomDirty = true
        }
        if ((array_length rowHidden) != rowCount) {
            clear rowHidden
            clear rowSuppressed
            def hi:int 0
            while (hi < rowCount) {
                push rowHidden false
                push rowSuppressed false
                hi = (hi + 1)
            }
        }
        if ((array_length colHidden) != colCount) {
            clear colHidden
            def hj:int 0
            while (hj < colCount) {
                push colHidden false
                hj = (hj + 1)
            }
        }
    }

    fn ensureGeometry:void () {
        this.ensureSizeArrays()
        if rowGeomDirty {
            clear rowOffsets
            def acc:int 0
            push rowOffsets 0
            def r:int 0
            while (r < rowCount) {
                def rh:int (itemAt rowHeights r)
                if ((r < (array_length rowHidden)) && (itemAt rowHidden r)) {
                    rh = 0
                }
                if ((r < (array_length rowSuppressed)) && (itemAt rowSuppressed r)) {
                    rh = 0
                }
                acc = (acc + rh)
                push rowOffsets acc
                r = (r + 1)
            }
            rowGeomDirty = false
        }
        if colGeomDirty {
            clear colOffsets
            def acc2:int 0
            push colOffsets 0
            def c:int 0
            while (c < colCount) {
                def cw:int (itemAt colWidths c)
                if ((c < (array_length colHidden)) && (itemAt colHidden c)) {
                    cw = 0
                }
                acc2 = (acc2 + cw)
                push colOffsets acc2
                c = (c + 1)
            }
            colGeomDirty = false
        }
    }

    ; Grow the sheet without touching what is already there. resize() clears
    ; rowHeights / colWidths, so it must never be used to extend a loaded
    ; workbook — that would throw away every column width from styles.xml.
    ; --- column structure -----------------------------------------------------
    ; Insert / delete / move operate on the used rectangle only, so a sheet that
    ; declares 100k rows does not pay for its empty ones. Cells, formulas, style
    ; ids, widths, hidden flags and merges all move together — anything left
    ; behind would show up as a value with someone else's formatting.
    fn moveCellRaw:void (fromRow:int fromCol:int toRow:int toCol:int) {
        def v:string (this.getCell(fromRow fromCol))
        this.setCellRaw(toRow toCol v)
        this.setCellRaw(fromRow fromCol "")
        def src:string (this.cellKey(fromRow fromCol))
        def dst:string (this.cellKey(toRow toCol))
        def f:string ""
        if (has formulas src) {
            f = (unwrap (get formulas src))
        }
        this.setFormulaText(toRow toCol f)
        if (has formulas src) {
            set formulas src ""
        }
        def sid:int -1
        if (has cellStyleIds src) {
            sid = (unwrap (get cellStyleIds src))
        }
        set cellStyleIds dst sid
        set cellStyleIds src -1
    }

    fn clearCellAt:void (row:int col:int) {
        this.setCellRaw(row col "")
        def k:string (this.cellKey(row col))
        if (has formulas k) {
            set formulas k ""
        }
        set cellStyleIds k -1
    }

    ; Column contents, top to bottom over the used rows — the payload a delete
    ; has to keep so undo can put the column back.
    fn snapshotFormulas:void (outKeys:[string] outTexts:[string]) {
        clear outKeys
        clear outTexts
        def i:int 0
        while (i < (array_length formulaKeys)) {
            def k:string (itemAt formulaKeys i)
            if (has formulas k) {
                def t:string (unwrap (get formulas k))
                if ((strlen t) > 0) {
                    push outKeys k
                    push outTexts t
                }
            }
            i = (i + 1)
        }
    }

    fn restoreFormulas:void (keys:[string] texts:[string]) {
        ; Wipe what is there now, then lay the snapshot back down.
        def i:int 0
        while (i < (array_length formulaKeys)) {
            def k:string (itemAt formulaKeys i)
            if (has formulas k) {
                set formulas k ""
            }
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length keys)) {
            def key:string (itemAt keys j)
            if ((has formulas key) == false) {
                push formulaKeys key
            }
            set formulas key (itemAt texts j)
            j = (j + 1)
        }
        version = (version + 1)
    }

    fn snapshotColumn:void (col:int outValues:[string] outFormulas:[string] outStyles:[int]) {
        clear outValues
        clear outFormulas
        clear outStyles
        def last:int (this.usedRow())
        def r:int 0
        while (r <= last) {
            push outValues (this.getCell(r col))
            push outFormulas (this.getFormula(r col))
            push outStyles (this.getCellStyleId(r col))
            r = (r + 1)
        }
    }

    fn restoreColumn:void (col:int values:[string] formulas:[string] styles:[int]) {
        def n:int (array_length values)
        def r:int 0
        while (r < n) {
            this.setCellRaw(r col (itemAt values r))
            this.setFormulaText(r col (itemAt formulas r))
            def k:string (this.cellKey(r col))
            set cellStyleIds k (itemAt styles r)
            r = (r + 1)
        }
    }

    fn remapMergesForColumn:void (at:int delta:int) {
        def kept:[string]
        def i:int 0
        while (i < (array_length merges)) {
            def m:string (itemAt merges i)
            def parts:[string] (strsplit m ",")
            if ((array_length parts) >= 4) {
                def r1:int (SpreadsheetModel.parseInt0((itemAt parts 0)))
                def c1:int (SpreadsheetModel.parseInt0((itemAt parts 1)))
                def r2:int (SpreadsheetModel.parseInt0((itemAt parts 2)))
                def c2:int (SpreadsheetModel.parseInt0((itemAt parts 3)))
                def drop:boolean false
                if (delta < 0) {
                    if ((c1 == at) && (c2 == at)) {
                        drop = true
                    }
                }
                if (c1 >= at) {
                    c1 = (c1 + delta)
                }
                if (c2 >= at) {
                    c2 = (c2 + delta)
                }
                if (c2 < c1) {
                    drop = true
                }
                if (drop == false) {
                    push kept ((((to_string r1) + ",") + (to_string c1) + ",") + (to_string r2) + "," + (to_string c2))
                }
            }
            i = (i + 1)
        }
        clear merges
        def j:int 0
        while (j < (array_length kept)) {
            push merges (itemAt kept j)
            j = (j + 1)
        }
    }

    fn insertColumnRaw:void (at:int) {
        if (at < 0) {
            return
        }
        if (at > colCount) {
            return
        }
        def lastR:int (this.usedRow())
        def lastC:int (this.usedCol())
        ; Right to left, so a destination is never read afterwards.
        def c:int lastC
        while (c >= at) {
            def r:int 0
            while (r <= lastR) {
                this.moveCellRaw(r c r (c + 1))
                r = (r + 1)
            }
            c = (c - 1)
        }
        def r2:int 0
        while (r2 <= lastR) {
            this.clearCellAt(r2 at)
            r2 = (r2 + 1)
        }
        ; Geometry arrays must end up exactly colCount long, or ensureGeometry
        ; decides they are stale and resets every width to the default.
        if (at < (array_length colWidths)) {
            insert colWidths at defaultColW
        } {
            push colWidths defaultColW
        }
        if (at < (array_length colHidden)) {
            insert colHidden at false
        } {
            push colHidden false
        }
        colCount = (colCount + 1)
        if (usedMaxCol >= at) {
            usedMaxCol = (usedMaxCol + 1)
        }
        this.remapMergesForColumn(at 1)
        colGeomDirty = true
        this.ensureGeometry()
        version = (version + 1)
    }

    fn deleteColumnRaw:void (at:int) {
        if (at < 0) {
            return
        }
        if (at >= colCount) {
            return
        }
        if (colCount <= 1) {
            return
        }
        def lastR:int (this.usedRow())
        def lastC:int (this.usedCol())
        def c:int at
        while (c < lastC) {
            def r:int 0
            while (r <= lastR) {
                this.moveCellRaw(r (c + 1) r c)
                r = (r + 1)
            }
            c = (c + 1)
        }
        ; Only the column the shift vacated gets cleared. Deleting a column
        ; BEYOND the used range shifts nothing, and clearing lastC there would
        ; wipe live data instead.
        if (at <= lastC) {
            def r3:int 0
            while (r3 <= lastR) {
                this.clearCellAt(r3 lastC)
                r3 = (r3 + 1)
            }
        }
        if (at < (array_length colWidths)) {
            remove_index colWidths at
        }
        if (at < (array_length colHidden)) {
            remove_index colHidden at
        }
        colCount = (colCount - 1)
        if (usedMaxCol >= at) {
            if (usedMaxCol > 0) {
                usedMaxCol = (usedMaxCol - 1)
            }
        }
        this.remapMergesForColumn(at -1)
        colGeomDirty = true
        this.ensureGeometry()
        version = (version + 1)
    }

    ; Reorder: lift a column out and drop it at `to` (index in the sheet AFTER
    ; the lift, the way a drag reads).
    fn moveColumnRaw:void (from:int to:int) {
        if (from == to) {
            return
        }
        if (from < 0) {
            return
        }
        if (from >= colCount) {
            return
        }
        if (to < 0) {
            return
        }
        if (to >= colCount) {
            return
        }
        def vals:[string]
        def fmls:[string]
        def sids:[int]
        this.snapshotColumn(from vals fmls sids)
        def width:int (this.colWidth(from))
        def hidden:boolean (this.isColHidden(from))
        this.deleteColumnRaw(from)
        this.insertColumnRaw(to)
        this.restoreColumn(to vals fmls sids)
        if (to < (array_length colWidths)) {
            set_at colWidths to width
        }
        if (to < (array_length colHidden)) {
            set_at colHidden to hidden
        }
        colGeomDirty = true
        this.ensureGeometry()
        version = (version + 1)
    }

    fn snapshotRow:void (row:int outValues:[string] outFormulas:[string] outStyles:[int]) {
        clear outValues
        clear outFormulas
        clear outStyles
        def last:int (this.usedCol())
        def c:int 0
        while (c <= last) {
            push outValues (this.getCell(row c))
            push outFormulas (this.getFormula(row c))
            push outStyles (this.getCellStyleId(row c))
            c = (c + 1)
        }
    }

    fn restoreRow:void (row:int values:[string] formulas:[string] styles:[int]) {
        def n:int (array_length values)
        def c:int 0
        while (c < n) {
            this.setCellRaw(row c (itemAt values c))
            this.setFormulaText(row c (itemAt formulas c))
            def k:string (this.cellKey(row c))
            set cellStyleIds k (itemAt styles c)
            c = (c + 1)
        }
    }

    fn remapMergesForRow:void (at:int delta:int) {
        def kept:[string]
        def i:int 0
        while (i < (array_length merges)) {
            def m:string (itemAt merges i)
            def parts:[string] (strsplit m ",")
            if ((array_length parts) >= 4) {
                def r1:int (SpreadsheetModel.parseInt0((itemAt parts 0)))
                def c1:int (SpreadsheetModel.parseInt0((itemAt parts 1)))
                def r2:int (SpreadsheetModel.parseInt0((itemAt parts 2)))
                def c2:int (SpreadsheetModel.parseInt0((itemAt parts 3)))
                def drop:boolean false
                if (delta < 0) {
                    if ((r1 == at) && (r2 == at)) {
                        drop = true
                    }
                }
                if (r1 >= at) {
                    r1 = (r1 + delta)
                }
                if (r2 >= at) {
                    r2 = (r2 + delta)
                }
                if (r2 < r1) {
                    drop = true
                }
                if (drop == false) {
                    push kept ((((to_string r1) + ",") + (to_string c1) + ",") + (to_string r2) + "," + (to_string c2))
                }
            }
            i = (i + 1)
        }
        clear merges
        def j:int 0
        while (j < (array_length kept)) {
            push merges (itemAt kept j)
            j = (j + 1)
        }
    }

    ; The column ops, transposed. Every remark on those applies here for the
    ; same reason: bottom to top so a destination is never read afterwards,
    ; geometry spliced BEFORE the count changes so `ensureGeometry` does not
    ; decide the arrays are stale and reset every height, and the vacated line
    ; cleared only when the shift actually reached it.
    fn insertRowRaw:void (at:int) {
        if (at < 0) {
            return
        }
        if (at > rowCount) {
            return
        }
        def lastR:int (this.usedRow())
        def lastC:int (this.usedCol())
        def r:int lastR
        while (r >= at) {
            def c:int 0
            while (c <= lastC) {
                this.moveCellRaw(r c (r + 1) c)
                c = (c + 1)
            }
            r = (r - 1)
        }
        def c2:int 0
        while (c2 <= lastC) {
            this.clearCellAt(at c2)
            c2 = (c2 + 1)
        }
        if (at < (array_length rowHeights)) {
            insert rowHeights at defaultRowH
        } {
            push rowHeights defaultRowH
        }
        if (at < (array_length rowHidden)) {
            insert rowHidden at false
        } {
            push rowHidden false
        }
        rowCount = (rowCount + 1)
        if (usedMaxRow >= at) {
            usedMaxRow = (usedMaxRow + 1)
        }
        this.remapMergesForRow(at 1)
        rowGeomDirty = true
        this.ensureGeometry()
        version = (version + 1)
    }

    fn deleteRowRaw:void (at:int) {
        if (at < 0) {
            return
        }
        if (at >= rowCount) {
            return
        }
        if (rowCount <= 1) {
            return
        }
        def lastR:int (this.usedRow())
        def lastC:int (this.usedCol())
        def r:int at
        while (r < lastR) {
            def c:int 0
            while (c <= lastC) {
                this.moveCellRaw((r + 1) c r c)
                c = (c + 1)
            }
            r = (r + 1)
        }
        if (at <= lastR) {
            def c3:int 0
            while (c3 <= lastC) {
                this.clearCellAt(lastR c3)
                c3 = (c3 + 1)
            }
        }
        if (at < (array_length rowHeights)) {
            remove_index rowHeights at
        }
        if (at < (array_length rowHidden)) {
            remove_index rowHidden at
        }
        rowCount = (rowCount - 1)
        if (usedMaxRow >= at) {
            if (usedMaxRow > 0) {
                usedMaxRow = (usedMaxRow - 1)
            }
        }
        this.remapMergesForRow(at -1)
        rowGeomDirty = true
        this.ensureGeometry()
        version = (version + 1)
    }

    fn moveRowRaw:void (from:int to:int) {
        if (from == to) {
            return
        }
        if (from < 0) {
            return
        }
        if (from >= rowCount) {
            return
        }
        if (to < 0) {
            return
        }
        if (to >= rowCount) {
            return
        }
        def vals:[string]
        def fmls:[string]
        def sids:[int]
        this.snapshotRow(from vals fmls sids)
        def height:int (this.rowHeight(from))
        def hidden:boolean (this.isRowHidden(from))
        this.deleteRowRaw(from)
        this.insertRowRaw(to)
        this.restoreRow(to vals fmls sids)
        if (to < (array_length rowHeights)) {
            set_at rowHeights to height
        }
        if (to < (array_length rowHidden)) {
            set_at rowHidden to hidden
        }
        rowGeomDirty = true
        this.ensureGeometry()
        version = (version + 1)
    }

    ; Put the rows in a new order, in one pass.
    ;
    ; `order[i]` is the row that should end up AT i, and every row is named
    ; exactly once. Everything a row owns travels with it: its values, its
    ; formulas, the styles of its cells, its height and whether it is hidden.
    ;
    ; Every row is read out before any is written back, because a permutation
    ; applied in place overwrites rows that have not been read yet. Doing this
    ; with repeated single moves would be correct and quadratic, and a sheet is
    ; sorted often enough for that to be the difference between instant and
    ; noticeable.
    fn reorderRowsRaw:void (order:[int]) {
        def n:int (array_length order)
        if (n < 2) {
            return
        }
        def width:int ((this.usedCol()) + 1)
        def vals:[string]
        def fmls:[string]
        def sids:[int]
        def heights:[int]
        def hiddens:[boolean]
        def i:int 0
        while (i < n) {
            def from:int (itemAt order i)
            if (from < 0) {
                from = 0
            }
            if (from >= rowCount) {
                from = (rowCount - 1)
            }
            def rowVals:[string]
            def rowFmls:[string]
            def rowSids:[int]
            this.snapshotRow(from rowVals rowFmls rowSids)
            def k:int 0
            while (k < width) {
                if (k < (array_length rowVals)) {
                    push vals (itemAt rowVals k)
                    push fmls (itemAt rowFmls k)
                    push sids (itemAt rowSids k)
                } {
                    push vals ""
                    push fmls ""
                    push sids -1
                }
                k = (k + 1)
            }
            push heights (this.rowHeight(from))
            push hiddens (this.isRowHidden(from))
            i = (i + 1)
        }
        def j:int 0
        while (j < n) {
            def putVals:[string]
            def putFmls:[string]
            def putSids:[int]
            def base:int (j * width)
            def c:int 0
            while (c < width) {
                push putVals (itemAt vals (base + c))
                push putFmls (itemAt fmls (base + c))
                push putSids (itemAt sids (base + c))
                c = (c + 1)
            }
            this.restoreRow(j putVals putFmls putSids)
            if (j < (array_length rowHeights)) {
                set_at rowHeights j (itemAt heights j)
            }
            if (j < (array_length rowHidden)) {
                set_at rowHidden j (itemAt hiddens j)
            }
            j = (j + 1)
        }
        rowGeomDirty = true
        this.ensureGeometry()
        version = (version + 1)
    }

    fn growTo:void (rows:int cols:int) {
        def changed:boolean false
        if (rows > rowCount) {
            def sameLen:boolean ((array_length rowHeights) == rowCount)
            def suppLen:boolean ((array_length rowSuppressed) == rowCount)
            if sameLen {
                def r:int rowCount
                while (r < rows) {
                    push rowHeights defaultRowH
                    push rowHidden false
                    if suppLen {
                        push rowSuppressed false
                    }
                    r = (r + 1)
                }
            }
            rowCount = rows
            rowGeomDirty = true
            changed = true
        }
        if (cols > colCount) {
            def sameCols:boolean ((array_length colWidths) == colCount)
            if sameCols {
                def c:int colCount
                while (c < cols) {
                    push colWidths defaultColW
                    push colHidden false
                    c = (c + 1)
                }
            }
            colCount = cols
            colGeomDirty = true
            changed = true
        }
        if changed {
            version = (version + 1)
            this.ensureGeometry()
        }
    }

    fn resize:void (rows:int cols:int) {
        if (rows < 1) {
            rows = 1
        }
        if (cols < 1) {
            cols = 1
        }
        rowCount = rows
        colCount = cols
        clear rowHeights
        clear colWidths
        rowGeomDirty = true
        colGeomDirty = true
        this.ensureGeometry()
        version = (version + 1)
    }

    fn getCell:string (row:int col:int) {
        if (row < 0) {
            return ""
        }
        if (row >= (array_length cellRows)) {
            return ""
        }
        def m:[int:string] (itemAt cellRows row)
        if (has m col) {
            return (unwrap (get m col))
        }
        return ""
    }

    fn setCellStyleId:void (row:int col:int styleId:int) {
        def k:string (this.cellKey(row col))
        set cellStyleIds k styleId
    }

    fn getCellStyleId:int (row:int col:int) {
        def k:string (this.cellKey(row col))
        if (has cellStyleIds k) {
            return (unwrap (get cellStyleIds k))
        }
        return -1
    }

    ; Index of an equal style in this sheet's table, adding it when new. Paste
    ; carries a resolved CellStyle rather than an index, so it survives a hop
    ; between sheets (each sheet holds its own copy of the style table).
    fn styleIdFor:int (st:CellStyle) {
        if (st.isPlain()) {
            return -1
        }
        def i:int 0
        def n:int (array_length styles)
        while (i < n) {
            def cand:CellStyle (itemAt styles i)
            if (cand.sameAs(st)) {
                return i
            }
            i = (i + 1)
        }
        push styles (st.copy())
        return ((array_length styles) - 1)
    }

    fn setCellStyleResolved:void (row:int col:int st:CellStyle) {
        def id:int (this.styleIdFor(st))
        def k:string (this.cellKey(row col))
        set cellStyleIds k id
        version = (version + 1)
    }

    fn getCellStyle:CellStyle (row:int col:int) {
        def k:string (this.cellKey(row col))
        if (has cellStyleIds k) {
            def sid:int (unwrap (get cellStyleIds k))
            if ((sid >= 0) && (sid < (array_length styles))) {
                return (itemAt styles sid)
            }
        }
        def plain:CellStyle (CellStyle.createDefault())
        plain.fontSizePt = defaultFontPt
        return plain
    }

    ; FortuneSheet-style display value: raw cell + number format engine.
    fn getDisplay:string (row:int col:int) {
        def raw:string (this.getCell(row col))
        def st:CellStyle (this.getCellStyle(row col))
        return (XlsxNumberFormat.format(raw st.numFmt))
    }

    ; --- images ---------------------------------------------------------------
    fn addImage:void (img:SheetImage) {
        push images img
        version = (version + 1)
    }

    fn imageCount:int () {
        return (array_length images)
    }

    ; --- tables ---------------------------------------------------------------
    fn addTable:void (t:SheetTable) {
        push tables t
        version = (version + 1)
    }

    fn tableCount:int () {
        return (array_length tables)
    }

    fn tableAt:SheetTable (i:int) {
        if (i < 0) {
            return (new SheetTable)
        }
        if (i >= (array_length tables)) {
            return (new SheetTable)
        }
        return (itemAt tables i)
    }

    fn clearTables:void () {
        clear tables
    }

    fn imageAt:SheetImage (i:int) {
        if (i < 0) {
            return (new SheetImage)
        }
        if (i >= (array_length images)) {
            return (new SheetImage)
        }
        return (itemAt images i)
    }

    ; --- rich text ------------------------------------------------------------
    ; Setting runs also sets the cell's value to what they spell, so a formula
    ; reading the cell and a paste copying it see the plain string.
    fn setRichText:void (row:int col:int rt:RichText) {
        def k:string (this.cellKey(row col))
        if ((has richCells k) == false) {
            push richKeys k
        }
        set richCells k rt
        version = (version + 1)
    }

    fn richTextAt:RichText (row:int col:int) {
        def k:string (this.cellKey(row col))
        if (has richCells k) {
            return (unwrap (get richCells k))
        }
        return (new RichText)
    }

    fn hasRichText:boolean (row:int col:int) {
        def rt:RichText (this.richTextAt(row col))
        return (rt.isRich())
    }

    fn clearRichText:void (row:int col:int) {
        def k:string (this.cellKey(row col))
        if (has richCells k) {
            set richCells k (new RichText)
        }
    }

    fn richCount:int () {
        def n:int 0
        def i:int 0
        while (i < (array_length richKeys)) {
            def k:string (itemAt richKeys i)
            if (has richCells k) {
                def rt:RichText (unwrap (get richCells k))
                if (rt.isRich()) {
                    n = (n + 1)
                }
            }
            i = (i + 1)
        }
        return n
    }

    ; --- spilled array results ------------------------------------------------
    fn setSpill:void (row:int col:int rows:int cols:int) {
        def k:string (this.cellKey(row col))
        if ((has spillSize k) == false) {
            push spillKeys k
        }
        set spillSize k ((to_string rows) + "," + (to_string cols))
        def r:int 0
        while (r < rows) {
            def c:int 0
            while (c < cols) {
                def ck:string (this.cellKey((row + r) (col + c)))
                if ((has spillOwner ck) == false) {
                    push spillKeys ck
                }
                set spillOwner ck k
                c = (c + 1)
            }
            r = (r + 1)
        }
    }

    fn isSpilled:boolean (row:int col:int) {
        def k:string (this.cellKey(row col))
        if (has spillOwner k) {
            return ((strlen (unwrap (get spillOwner k))) > 0)
        }
        return false
    }

    ; The anchor a spilled cell belongs to, or "" — what an editor asks before
    ; letting someone type into a cell a formula is filling.
    fn spillAnchor:string (row:int col:int) {
        def k:string (this.cellKey(row col))
        if (has spillOwner k) {
            return (unwrap (get spillOwner k))
        }
        return ""
    }

    ; Take back everything the anchor at (row, col) last laid out.
    fn clearSpillFrom:void (row:int col:int) {
        def k:string (this.cellKey(row col))
        if ((has spillSize k) == false) {
            return
        }
        def dims:string (unwrap (get spillSize k))
        if ((strlen dims) == 0) {
            return
        }
        def parts:[string] (strsplit dims ",")
        if ((array_length parts) < 2) {
            return
        }
        def rows:int (SpreadsheetModel.parseInt0((itemAt parts 0)))
        def cols:int (SpreadsheetModel.parseInt0((itemAt parts 1)))
        def r:int 0
        while (r < rows) {
            def c:int 0
            while (c < cols) {
                def ck:string (this.cellKey((row + r) (col + c)))
                if (has spillOwner ck) {
                    set spillOwner ck ""
                }
                if ((r + c) > 0) {
                    this.setCellRaw((row + r) (col + c) "")
                }
                c = (c + 1)
            }
            r = (r + 1)
        }
        set spillSize k ""
    }

    ; --- hyperlinks -----------------------------------------------------------
    fn setHyperlink:void (row:int col:int target:string) {
        def k:string (this.cellKey(row col))
        if ((strlen target) == 0) {
            this.clearHyperlink(row col)
            return
        }
        if ((has links k) == false) {
            push linkKeys k
        }
        set links k target
        version = (version + 1)
    }

    fn hyperlinkAt:string (row:int col:int) {
        def k:string (this.cellKey(row col))
        if (has links k) {
            return (unwrap (get links k))
        }
        return ""
    }

    fn hasHyperlink:boolean (row:int col:int) {
        return ((strlen (this.hyperlinkAt(row col))) > 0)
    }

    fn clearHyperlink:void (row:int col:int) {
        def k:string (this.cellKey(row col))
        if (has links k) {
            set links k ""
        }
        version = (version + 1)
    }

    fn hyperlinkCount:int () {
        def n:int 0
        def i:int 0
        while (i < (array_length linkKeys)) {
            def k:string (itemAt linkKeys i)
            if (has links k) {
                if ((strlen (unwrap (get links k))) > 0) {
                    n = (n + 1)
                }
            }
            i = (i + 1)
        }
        return n
    }

    ; --- notes ----------------------------------------------------------------
    fn setNote:void (row:int col:int text:string) {
        def k:string (this.cellKey(row col))
        if ((strlen text) == 0) {
            this.clearNote(row col)
            return
        }
        if ((has notes k) == false) {
            push noteKeys k
        }
        set notes k text
        version = (version + 1)
    }

    fn noteAt:string (row:int col:int) {
        def k:string (this.cellKey(row col))
        if (has notes k) {
            return (unwrap (get notes k))
        }
        return ""
    }

    fn hasNote:boolean (row:int col:int) {
        return ((strlen (this.noteAt(row col))) > 0)
    }

    fn clearNote:void (row:int col:int) {
        def k:string (this.cellKey(row col))
        if (has notes k) {
            set notes k ""
        }
        version = (version + 1)
    }

    fn noteCount:int () {
        def n:int 0
        def i:int 0
        while (i < (array_length noteKeys)) {
            def k:string (itemAt noteKeys i)
            if (has notes k) {
                if ((strlen (unwrap (get notes k))) > 0) {
                    n = (n + 1)
                }
            }
            i = (i + 1)
        }
        return n
    }

    ; --- data validation ------------------------------------------------------
    ; Rules are attached to ranges, so the last one that covers a cell wins —
    ; the same order Excel resolves overlapping rules in.
    fn addValidation:void (v:DataValidation) {
        push validations v
        version = (version + 1)
    }

    fn validationAt:DataValidation (row:int col:int) {
        def i:int ((array_length validations) - 1)
        while (i >= 0) {
            def v:DataValidation (itemAt validations i)
            if (v.covers(row col)) {
                return v
            }
            i = (i - 1)
        }
        return (new DataValidation)
    }

    fn hasValidation:boolean (row:int col:int) {
        def v:DataValidation (this.validationAt(row col))
        return ((strlen v.kind) > 0)
    }

    fn validationCount:int () {
        return (array_length validations)
    }

    fn clearValidationsIn:void (r0:int c0:int r1:int c1:int) {
        def keep:[DataValidation]
        def i:int 0
        while (i < (array_length validations)) {
            def v:DataValidation (itemAt validations i)
            def inside:boolean true
            if (v.r0 < r0) {
                inside = false
            }
            if (v.c0 < c0) {
                inside = false
            }
            if (v.r0 > r1) {
                inside = false
            }
            if (v.c0 > c1) {
                inside = false
            }
            if (inside == false) {
                push keep v
            }
            i = (i + 1)
        }
        clear validations
        def k:int 0
        while (k < (array_length keep)) {
            push validations (itemAt keep k)
            k = (k + 1)
        }
        version = (version + 1)
    }

    ; --- conditional formatting rules -----------------------------------------
    ; Rules are sheet metadata rather than cell contents, so they live beside
    ; the cells and not on the undo stack: undoing a paste must not silently
    ; drop a rule the paste never touched.
    fn addCfRule:void (rule:CfRule) {
        push cfRules rule
        version = (version + 1)
    }

    fn cfRuleCount:int () {
        return (array_length cfRules)
    }

    ; Drop every rule whose range starts inside the given rectangle — what
    ; "clear the rules on this selection" means.
    fn clearCfRulesIn:void (r0:int c0:int r1:int c1:int) {
        def keep:[CfRule]
        def i:int 0
        while (i < (array_length cfRules)) {
            def rule:CfRule (itemAt cfRules i)
            def inside:boolean true
            if (rule.r0 < r0) {
                inside = false
            }
            if (rule.c0 < c0) {
                inside = false
            }
            if (rule.r0 > r1) {
                inside = false
            }
            if (rule.c0 > c1) {
                inside = false
            }
            if (inside == false) {
                push keep rule
            }
            i = (i + 1)
        }
        clear cfRules
        def k:int 0
        while (k < (array_length keep)) {
            push cfRules (itemAt keep k)
            k = (k + 1)
        }
        version = (version + 1)
    }

    fn setStylesFrom:void (list:[CellStyle]) {
        clear styles
        ; The first entry is the workbook's own default format, which is what
        ; a cell naming no style is drawn in.
        if ((array_length list) > 0) {
            def base:CellStyle (itemAt list 0)
            if (base.fontSizePt > 0.0) {
                defaultFontPt = base.fontSizePt
            }
        }
        def i:int 0
        def n:int (array_length list)
        while (i < n) {
            push styles (itemAt list i)
            i = (i + 1)
        }
    }

    fn setFreeze:void (rows:int cols:int) {
        if (rows < 0) {
            rows = 0
        }
        if (cols < 0) {
            cols = 0
        }
        freezeRows = rows
        freezeCols = cols
        version = (version + 1)
    }

    fn frozenHeight:int () {
        this.ensureGeometry()
        if (freezeRows <= 0) {
            return 0
        }
        if (freezeRows >= rowCount) {
            return (this.totalHeight())
        }
        return (this.rowToY(freezeRows))
    }

    fn frozenWidth:int () {
        this.ensureGeometry()
        if (freezeCols <= 0) {
            return 0
        }
        if (freezeCols >= colCount) {
            return (this.totalWidth())
        }
        return (this.colToX(freezeCols))
    }

    fn getFormula:string (row:int col:int) {
        def k:string (this.cellKey(row col))
        if (has formulas k) {
            return (unwrap (get formulas k))
        }
        return ""
    }

    fn setFormula:void (row:int col:int formula:string) {
        def k:string (this.cellKey(row col))
        if (has formulas k) {
        } {
            push formulaKeys k
        }
        set formulas k formula
    }

    fn clearFormula:void (row:int col:int) {
        def k:string (this.cellKey(row col))
        if (has formulas k) {
            set formulas k ""
        }
    }

    ; setFormula that never creates a key for an empty formula.
    fn setFormulaText:void (row:int col:int formula:string) {
        def k:string (this.cellKey(row col))
        if (has formulas k) {
            set formulas k formula
            return
        }
        if ((strlen formula) == 0) {
            return
        }
        push formulaKeys k
        set formulas k formula
    }

    fn hasFormula:boolean (row:int col:int) {
        def k:string (this.cellKey(row col))
        if (has formulas k) {
            def f:string (unwrap (get formulas k))
            if ((strlen f) > 0) {
                return true
            }
        }
        return false
    }

    ; Cleared cells keep a "" entry in `formulas`; skip them so the recalc
    ; scan does not grow with every deleted formula.
    fn collectFormulaKeys:void (sheetIdx:int out:[string]) {
        def i:int 0
        def n:int (array_length formulaKeys)
        while (i < n) {
            def k:string (itemAt formulaKeys i)
            def f:string ""
            if (has formulas k) {
                f = (unwrap (get formulas k))
            }
            if ((strlen f) > 0) {
                push out (((to_string sheetIdx) + "!") + k)
            }
            i = (i + 1)
        }
    }

    fn setRowHidden:void (row:int hidden:boolean) {
        this.ensureGeometry()
        if ((row < 0) || (row >= rowCount)) {
            return
        }
        set_at rowHidden row hidden
        rowGeomDirty = true
        version = (version + 1)
    }

    fn setColHidden:void (col:int hidden:boolean) {
        this.ensureGeometry()
        if ((col < 0) || (col >= colCount)) {
            return
        }
        set_at colHidden col hidden
        colGeomDirty = true
        version = (version + 1)
    }

    fn isRowHidden:boolean (row:int) {
        this.ensureGeometry()
        if ((row < 0) || (row >= (array_length rowHidden))) {
            return false
        }
        return (itemAt rowHidden row)
    }

    fn isColHidden:boolean (col:int) {
        this.ensureGeometry()
        if ((col < 0) || (col >= (array_length colHidden))) {
            return false
        }
        return (itemAt colHidden col)
    }

    fn setFilter:void (col:int enabled:boolean values:[string]) {
        filterCol = col
        filterEnabled = enabled
        clear filterValues
        def i:int 0
        def n:int (array_length values)
        while (i < n) {
            push filterValues (itemAt values i)
            i = (i + 1)
        }
        this.ensureGeometry()
        if ((array_length rowSuppressed) != rowCount) {
            clear rowSuppressed
            def hi:int 0
            while (hi < rowCount) {
                push rowSuppressed false
                hi = (hi + 1)
            }
        }
        def r:int 0
        while (r < rowCount) {
            def suppress:boolean false
            if enabled {
                if (r >= freezeRows) {
                    def v:string (this.getCell(r col))
                    def ok:boolean false
                    def j:int 0
                    while (j < n) {
                        if (v == (itemAt filterValues j)) {
                            ok = true
                        }
                        j = (j + 1)
                    }
                    if (n == 0) {
                        ok = true
                    }
                    if (ok == false) {
                        suppress = true
                    }
                }
            }
            set_at rowSuppressed r suppress
            r = (r + 1)
        }
        rowGeomDirty = true
        version = (version + 1)
    }

    ; Which column the data was last sorted by, and which way. This is a
    ; record of what happened, not an instruction to the view: the rows are
    ; really in this order now, so the view sorts nothing. It is what the
    ; header's little arrow is drawn from.
    def sortedCol:int -1
    def sortedAsc:boolean true

    fn setSort:void (col:int ascending:boolean) {
        sortCol = col
        sortAsc = ascending
        version = (version + 1)
    }

    ; Formula bar text: "=SUM(...)" when present, else display value.
    fn formulaBarText:string (row:int col:int) {
        def f:string (this.getFormula(row col))
        if ((strlen f) > 0) {
            if ((charAt f 0) == 61) {
                return f
            }
            return ("=" + f)
        }
        return (this.getDisplay(row col))
    }

    fn addMerge:void (r1:int c1:int r2:int c2:int) {
        if (r2 < r1) {
            def t:int r1
            r1 = r2
            r2 = t
        }
        if (c2 < c1) {
            def t2:int c1
            c1 = c2
            c2 = t2
        }
        def key:string ((((to_string r1) + ",") + (to_string c1) + ",") + (to_string r2) + "," + (to_string c2))
        push merges key
    }

    ; Take apart the merge that contains this cell, if any. The same button
    ; that made it undoes it, which is how every spreadsheet behaves.
    fn removeMerge:boolean (row:int col:int) {
        def key:string (this.mergeAt(row col))
        if ((strlen key) == 0) {
            return false
        }
        def kept:[string]
        def i:int 0
        while (i < (array_length merges)) {
            def m:string (itemAt merges i)
            if (m != key) {
                push kept m
            }
            i = (i + 1)
        }
        clear merges
        def j:int 0
        while (j < (array_length kept)) {
            push merges (itemAt kept j)
            j = (j + 1)
        }
        version = (version + 1)
        return true
    }

    ; Returns merge key containing (row,col), or "".
    fn mergeAt:string (row:int col:int) {
        def i:int 0
        def n:int (array_length merges)
        while (i < n) {
            def m:string (itemAt merges i)
            def parts:[string] (strsplit m ",")
            if ((array_length parts) >= 4) {
                def r1:int (SpreadsheetModel.parseInt0((itemAt parts 0)))
                def c1:int (SpreadsheetModel.parseInt0((itemAt parts 1)))
                def r2:int (SpreadsheetModel.parseInt0((itemAt parts 2)))
                def c2:int (SpreadsheetModel.parseInt0((itemAt parts 3)))
                if ((row >= r1) && (row <= r2) && (col >= c1) && (col <= c2)) {
                    return m
                }
            }
            i = (i + 1)
        }
        return ""
    }

    fn isMergeOrigin:boolean (row:int col:int) {
        def m:string (this.mergeAt(row col))
        if ((strlen m) == 0) {
            return true
        }
        def parts:[string] (strsplit m ",")
        def r1:int (SpreadsheetModel.parseInt0((itemAt parts 0)))
        def c1:int (SpreadsheetModel.parseInt0((itemAt parts 1)))
        if (row != r1) {
            return false
        }
        return (col == c1)
    }

    sfn parseInt0:int (s:string) {
        def parsed@(optional):int (to_int s)
        if parsed {
            return (unwrap parsed)
        }
        return 0
    }

    fn setCellRaw:void (row:int col:int value:string) {
        if (row < 0) {
            return
        }
        if (col < 0) {
            return
        }
        this.ensureCellRow(row)
        def m:[int:string] (itemAt cellRows row)
        set m col value
        set_at cellRows row m
        ; Used range, for Ctrl+End. Like Excel it only grows: clearing cells
        ; does not shrink it, and it stays O(1) instead of rescanning a sheet
        ; that may declare 100k rows.
        if ((strlen value) > 0) {
            if (row > usedMaxRow) {
                usedMaxRow = row
            }
            if (col > usedMaxCol) {
                usedMaxCol = col
            }
        }
        if (quietWrites == false) {
            version = (version + 1)
        }
    }

    ; Bottom-right of the used range, clamped to the sheet.
    fn usedRow:int () {
        def r:int usedMaxRow
        if (r >= rowCount) {
            r = (rowCount - 1)
        }
        if (r < 0) {
            r = 0
        }
        return r
    }

    fn usedCol:int () {
        def c:int usedMaxCol
        if (c >= colCount) {
            c = (colCount - 1)
        }
        if (c < 0) {
            c = 0
        }
        return c
    }

    ; --- transactions -------------------------------------------------------
    ; Ops recorded between beginTx / endTx undo as one Excel-style action.
    ; Nesting is counted so a paste inside a larger op stays one transaction.
    fn beginTx:void () {
        if (txDepth == 0) {
            txCounter = (txCounter + 1)
            curTx = txCounter
        }
        txDepth = (txDepth + 1)
    }

    fn endTx:void () {
        if (txDepth > 0) {
            txDepth = (txDepth - 1)
        }
        if (txDepth == 0) {
            curTx = 0
            this.trimUndo()
        }
    }

    ; Drop oldest history over the cap, whole transactions at a time, so a
    ; surviving op can never be half of an action.
    fn trimUndo:void () {
        while ((array_length undoStack) > maxUndo) {
            def first:SpreadsheetUndoOp (itemAt undoStack 0)
            def tx:int first.txId
            remove_index undoStack 0
            if (tx > 0) {
                def more:boolean true
                while more {
                    if ((array_length undoStack) == 0) {
                        more = false
                    } {
                        def nx:SpreadsheetUndoOp (itemAt undoStack 0)
                        if (nx.txId == tx) {
                            remove_index undoStack 0
                        } {
                            more = false
                        }
                    }
                }
            }
        }
    }

    fn pushUndoOp:void (row:int col:int before:string after:string beforeF:string afterF:string) {
        def op:SpreadsheetUndoOp (new SpreadsheetUndoOp)
        op.row = row
        op.col = col
        op.before = before
        op.after = after
        op.beforeF = beforeF
        op.afterF = afterF
        op.txId = curTx
        push undoStack op
        ; Never trim mid-transaction: that would split one action in half.
        if (txDepth == 0) {
            this.trimUndo()
        }
        clear redoStack
    }

    ; Tracked edit of value + formula together. formula "" means "no formula",
    ; so a plain value overwrites any prior formula (Excel behaviour).
    fn applyEdit:void (row:int col:int value:string formula:string) {
        def before:string (this.getCell(row col))
        def beforeF:string (this.getFormula(row col))
        if ((before == value) && (beforeF == formula)) {
            return
        }
        this.pushUndoOp(row col before value beforeF formula)
        this.setCellRaw(row col value)
        this.setFormulaText(row col formula)
    }

    ; Value + formula + formatting in ONE undo op — what a paste writes.
    fn applyEditStyled:void (row:int col:int value:string formula:string st:CellStyle) {
        def before:string (this.getCell(row col))
        def beforeF:string (this.getFormula(row col))
        def beforeSid:int (this.getCellStyleId(row col))
        def afterSid:int (this.styleIdFor(st))
        if ((before == value) && (beforeF == formula) && (beforeSid == afterSid)) {
            return
        }
        this.pushUndoOp(row col before value beforeF formula)
        def n:int (array_length undoStack)
        if (n > 0) {
            def op:SpreadsheetUndoOp (itemAt undoStack (n - 1))
            op.beforeStyle = beforeSid
            op.afterStyle = afterSid
            op.touchStyle = true
        }
        this.setCellRaw(row col value)
        this.setFormulaText(row col formula)
        def k:string (this.cellKey(row col))
        set cellStyleIds k afterSid
    }

    fn setCell:void (row:int col:int value:string) {
        this.applyEdit(row col value "")
    }

    ; Retyping a cell drops the pieces its text was drawn in — a spreadsheet
    ; does the same, because there is no answer to which run new text belongs
    ; to.
    fn applyEditPlain:void (row:int col:int value:string formula:string) {
        this.clearRichText(row col)
        this.applyEdit(row col value formula)
    }

    ; Record a structural column op so it can be undone as one action.
    ; A sort, as one undoable step. The order is kept whole rather than as a
    ; sequence of moves: a sort is one action to the person who asked for it,
    ; and one Ctrl+Z has to put the sheet back the way it was.
    fn pushReorderOp:void (order:[int]) {
        def op:SpreadsheetUndoOp (new SpreadsheetUndoOp)
        op.structKind = 7
        op.txId = curTx
        def i:int 0
        while (i < (array_length order)) {
            push op.structOrder (itemAt order i)
            i = (i + 1)
        }
        this.snapshotFormulas(op.savedKeys op.savedTexts)
        push undoStack op
        if (txDepth == 0) {
            this.trimUndo()
        }
        clear redoStack
    }

    fn pushStructOp:void (kind:int at:int to:int) {
        def op:SpreadsheetUndoOp (new SpreadsheetUndoOp)
        op.structKind = kind
        op.structAt = at
        op.structTo = to
        op.txId = curTx
        if (kind < 4) {
            op.colWidthSaved = (this.colWidth(at))
        } {
            op.colWidthSaved = (this.rowHeight(at))
        }
        if (kind == 2) {
            this.snapshotColumn(at op.colValues op.colFormulas op.colStyles)
        }
        if (kind == 5) {
            this.snapshotRow(at op.colValues op.colFormulas op.colStyles)
        }
        this.snapshotFormulas(op.savedKeys op.savedTexts)
        push undoStack op
        if (txDepth == 0) {
            this.trimUndo()
        }
        clear redoStack
    }

    fn applyStructOp:void (op:SpreadsheetUndoOp toAfter:boolean) {
        if toAfter {
            if (op.structKind == 1) {
                this.insertColumnRaw(op.structAt)
            }
            if (op.structKind == 2) {
                this.deleteColumnRaw(op.structAt)
            }
            if (op.structKind == 3) {
                this.moveColumnRaw(op.structAt op.structTo)
            }
            if (op.structKind == 4) {
                this.insertRowRaw(op.structAt)
            }
            if (op.structKind == 5) {
                this.deleteRowRaw(op.structAt)
            }
            if (op.structKind == 6) {
                this.moveRowRaw(op.structAt op.structTo)
            }
            if (op.structKind == 7) {
                this.reorderRowsRaw(op.structOrder)
            }
            return
        }
        if (op.structKind == 1) {
            this.deleteColumnRaw(op.structAt)
        }
        if (op.structKind == 2) {
            this.insertColumnRaw(op.structAt)
            this.restoreColumn(op.structAt op.colValues op.colFormulas op.colStyles)
            this.setColWidth(op.structAt op.colWidthSaved)
        }
        if (op.structKind == 3) {
            this.moveColumnRaw(op.structTo op.structAt)
        }
        if (op.structKind == 4) {
            this.deleteRowRaw(op.structAt)
        }
        if (op.structKind == 5) {
            this.insertRowRaw(op.structAt)
            this.restoreRow(op.structAt op.colValues op.colFormulas op.colStyles)
            this.setRowHeight(op.structAt op.colWidthSaved)
        }
        if (op.structKind == 6) {
            this.moveRowRaw(op.structTo op.structAt)
        }
        if (op.structKind == 7) {
            ; The inverse permutation: whatever went to i came from
            ; structOrder[i], so to put it back, row structOrder[i] takes i.
            def inv:[int]
            def zn:int (array_length op.structOrder)
            def z:int 0
            while (z < zn) {
                push inv 0
                z = (z + 1)
            }
            z = 0
            while (z < zn) {
                def came:int (itemAt op.structOrder z)
                if (came >= 0) {
                    if (came < zn) {
                        set_at inv came z
                    }
                }
                z = (z + 1)
            }
            this.reorderRowsRaw(inv)
        }
        ; Formula text is restored wholesale — see savedKeys.
        this.restoreFormulas(op.savedKeys op.savedTexts)
    }

    fn applyOp:void (op:SpreadsheetUndoOp toAfter:boolean) {
        if (op.structKind != 0) {
            this.applyStructOp(op toAfter)
            structDirty = true
            return
        }
        if toAfter {
            this.setCellRaw(op.row op.col op.after)
            this.setFormulaText(op.row op.col op.afterF)
        } {
            this.setCellRaw(op.row op.col op.before)
            this.setFormulaText(op.row op.col op.beforeF)
        }
        if op.touchStyle {
            def sid:int op.beforeStyle
            if toAfter {
                sid = op.afterStyle
            }
            def k:string (this.cellKey(op.row op.col))
            set cellStyleIds k sid
        }
        push touched (CellPos.create(op.row op.col))
    }

    ; Undo the whole last transaction (or the single last op). Cells restored
    ; are reported in `touched` so the caller can resync the formula engine.
    fn undo:CellPos () {
        clear touched
        def n:int (array_length undoStack)
        if (n <= 0) {
            return (CellPos.create(0 0))
        }
        def top:SpreadsheetUndoOp (itemAt undoStack (n - 1))
        def tx:int top.txId
        def lastRow:int top.row
        def lastCol:int top.col
        def more:boolean true
        while more {
            def cnt:int (array_length undoStack)
            if (cnt <= 0) {
                more = false
            } {
                def op:SpreadsheetUndoOp (itemAt undoStack (cnt - 1))
                def take:boolean false
                if (cnt == n) {
                    take = true
                } {
                    if (tx > 0) {
                        if (op.txId == tx) {
                            take = true
                        }
                    }
                }
                if take {
                    removeLast undoStack
                    this.applyOp(op false)
                    lastRow = op.row
                    lastCol = op.col
                    def keep:SpreadsheetUndoOp (new SpreadsheetUndoOp)
                    keep.copyFrom(op)
                    push redoStack keep
                } {
                    more = false
                }
            }
        }
        return (CellPos.create(lastRow lastCol))
    }

    fn redo:CellPos () {
        clear touched
        def n:int (array_length redoStack)
        if (n <= 0) {
            return (CellPos.create(0 0))
        }
        def top:SpreadsheetUndoOp (itemAt redoStack (n - 1))
        def tx:int top.txId
        def lastRow:int top.row
        def lastCol:int top.col
        def more:boolean true
        while more {
            def cnt:int (array_length redoStack)
            if (cnt <= 0) {
                more = false
            } {
                def op:SpreadsheetUndoOp (itemAt redoStack (cnt - 1))
                def take:boolean false
                if (cnt == n) {
                    take = true
                } {
                    if (tx > 0) {
                        if (op.txId == tx) {
                            take = true
                        }
                    }
                }
                if take {
                    removeLast redoStack
                    this.applyOp(op true)
                    lastRow = op.row
                    lastCol = op.col
                    def keep:SpreadsheetUndoOp (new SpreadsheetUndoOp)
                    keep.copyFrom(op)
                    push undoStack keep
                } {
                    more = false
                }
            }
        }
        return (CellPos.create(lastRow lastCol))
    }

    fn rowHeight:int (row:int) {
        this.ensureSizeArrays()
        if (row < 0) {
            return defaultRowH
        }
        if (row >= rowCount) {
            return defaultRowH
        }
        return (itemAt rowHeights row)
    }

    fn colWidth:int (col:int) {
        this.ensureSizeArrays()
        if (col < 0) {
            return defaultColW
        }
        if (col >= colCount) {
            return defaultColW
        }
        return (itemAt colWidths col)
    }

    ; The default row height and column width the FILE states, in pixels, as
    ; opposed to the ones this program would have chosen. A sheet designed at
    ; 12.75pt rows and 12.63-character columns, drawn at 20px and 64px, is a
    ; fifth taller and a third narrower than it was meant to be — enough that
    ; labels run into the cell beside them and numbers sit off their line.
    ;
    ; Rows and columns that already carry the OLD default follow it to the new
    ; one; anything the file gave an explicit size keeps it. Pass 0 for either
    ; to leave that one alone.
    fn setDefaultGeometry:void (rowH:int colW:int) {
        def oldRow:int defaultRowH
        def oldCol:int defaultColW
        if (rowH > 0) {
            defaultRowH = rowH
        }
        if (colW > 0) {
            defaultColW = colW
        }
        def i:int 0
        while (i < (array_length rowHeights)) {
            if ((itemAt rowHeights i) == oldRow) {
                set_at rowHeights i defaultRowH
            }
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length colWidths)) {
            if ((itemAt colWidths j) == oldCol) {
                set_at colWidths j defaultColW
            }
            j = (j + 1)
        }
        rowGeomDirty = true
        colGeomDirty = true
    }

    fn setRowHeight:void (row:int h:int) {
        this.ensureSizeArrays()
        if (row < 0) {
            return
        }
        if (row >= rowCount) {
            return
        }
        if (h < 8) {
            h = 8
        }
        if (h > 400) {
            h = 400
        }
        set_at rowHeights row h
        rowGeomDirty = true
        if (quietWrites == false) {
            version = (version + 1)
        }
    }

    fn setColWidth:void (col:int w:int) {
        this.ensureSizeArrays()
        if (col < 0) {
            return
        }
        if (col >= colCount) {
            return
        }
        if (w < 24) {
            w = 24
        }
        if (w > 600) {
            w = 600
        }
        set_at colWidths col w
        colGeomDirty = true
        version = (version + 1)
    }

    ; Content-space Y of the top edge of `row` (prefix sum).
    fn rowToY:int (row:int) {
        this.ensureGeometry()
        if (row <= 0) {
            return 0
        }
        if (row >= rowCount) {
            return (itemAt rowOffsets rowCount)
        }
        return (itemAt rowOffsets row)
    }

    fn colToX:int (col:int) {
        this.ensureGeometry()
        if (col <= 0) {
            return 0
        }
        if (col >= colCount) {
            return (itemAt colOffsets colCount)
        }
        return (itemAt colOffsets col)
    }

    fn totalHeight:int () {
        this.ensureGeometry()
        return (itemAt rowOffsets rowCount)
    }

    fn totalWidth:int () {
        this.ensureGeometry()
        return (itemAt colOffsets colCount)
    }

    ; Binary search on prefix offsets: content Y → row index.
    fn yToRow:int (y:int) {
        this.ensureGeometry()
        if (y <= 0) {
            return 0
        }
        def total:int (itemAt rowOffsets rowCount)
        if (y >= total) {
            return (rowCount - 1)
        }
        def lo:int 0
        def hi:int (rowCount - 1)
        while (lo < hi) {
            def mid:int (to_int ((lo + hi + 1) / 2))
            if ((itemAt rowOffsets mid) <= y) {
                lo = mid
            } {
                hi = (mid - 1)
            }
        }
        return lo
    }

    fn xToCol:int (x:int) {
        this.ensureGeometry()
        if (x <= 0) {
            return 0
        }
        def total:int (itemAt colOffsets colCount)
        if (x >= total) {
            return (colCount - 1)
        }
        def lo:int 0
        def hi:int (colCount - 1)
        while (lo < hi) {
            def mid:int (to_int ((lo + hi + 1) / 2))
            if ((itemAt colOffsets mid) <= x) {
                lo = mid
            } {
                hi = (mid - 1)
            }
        }
        return lo
    }

    fn clampPos:void (p:CellPos) {
        if (p.row < 0) {
            p.row = 0
        }
        if (p.col < 0) {
            p.col = 0
        }
        if (p.row >= rowCount) {
            p.row = (rowCount - 1)
        }
        if (p.col >= colCount) {
            p.col = (colCount - 1)
        }
    }

    ; Seed an empty sheet: named Sheet1, sized like a new workbook, no sample data.
    fn seedBlank:void () {
        this.clearSheet()
        this.name = "Sheet1"
        this.resize(1000 26)
        clear undoStack
        clear redoStack
    }

    ; Seed a demo sheet: headers + a few sample rows. Sparse — rest stay empty.
    fn seedDemo:void () {
        this.clearSheet()
        this.name = "Demo"
        this.resize(1000 26)
        this.setCellRaw(0 0 "Product")
        this.setCellRaw(0 1 "Qty")
        this.setCellRaw(0 2 "Price")
        this.setCellRaw(0 3 "Total")
        this.setCellRaw(1 0 "Widget")
        this.setCellRaw(1 1 "12")
        this.setCellRaw(1 2 "4.50")
        this.setCellRaw(1 3 "54.00")
        this.setCellRaw(2 0 "Gadget")
        this.setCellRaw(2 1 "3")
        this.setCellRaw(2 2 "19.90")
        this.setCellRaw(2 3 "59.70")
        this.setCellRaw(3 0 "Doohickey")
        this.setCellRaw(3 1 "100")
        this.setCellRaw(3 2 "0.25")
        this.setCellRaw(3 3 "25.00")
        this.setCellRaw(5 0 "Ranger EVG DataGrid")
        this.setCellRaw(5 1 "virtualized")
        this.setCellRaw(5 2 "batched")
        this.setCellRaw(6 0 "Type to replace, F2 to edit, Enter/Tab to step.")
        this.setColWidth(0 160)
        this.setColWidth(3 110)
        this.setRowHeight(0 28)
        clear undoStack
        clear redoStack
    }

    ; Fill many cells for scroll benches without storing empty rows.
    fn seedBench:void (rows:int cols:int fillEvery:int) {
        this.resize(rows cols)
        def r:int 0
        while (r < rows) {
            if ((r - ((to_int (r / fillEvery)) * fillEvery)) == 0) {
                def c:int 0
                while (c < cols) {
                    this.setCellRaw(r c (("R" + (to_string r)) + "C" + (to_string c)))
                    c = (c + 1)
                }
            }
            r = (r + 1)
        }
        clear undoStack
        clear redoStack
    }
}

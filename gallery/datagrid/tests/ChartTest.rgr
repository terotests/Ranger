; ==============================================================================
; ChartTest.rgr — charts made from a selection: data, specification, drawing.
; ==============================================================================
;
; The chart layer has three seams worth testing without a screen:
;
;   1. the RANGE READ   — what a rectangle of cells turns into
;   2. the SPECIFICATION — what Vega-Lite is asked for, and which kinds suit
;   3. the DRAWING      — that a chart produces EVG commands, and that the
;                         cache stops it producing them twice
;
; Everything below is integer and string comparison; nothing renders pixels.
; ==============================================================================

Import "../src/GridChart.rgr"
Import "../src/GridChartView.rgr"
Import "../src/GridApp.rgr"
Import "../../game_engine/lpc/src/png_decoder.rgr"

class ChartTest {
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    fn check:void (name:string got:string want:string) {
        if (got == want) {
            passed = (passed + 1)
            print (("  PASS " + name) + " (got '" + got + "')")
        } {
            failed = (failed + 1)
            print (((("  FAIL " + name) + " (got '") + got) + "' want '" + want + "')")
        }
    }

    fn checkInt:void (name:string got:int want:int) {
        this.check(name (to_string got) (to_string want))
    }

    fn checkTrue:void (name:string got:boolean) {
        this.check(name (to_string got) "true")
    }

    fn checkFalse:void (name:string got:boolean) {
        this.check(name (to_string got) "false")
    }

    sfn hasSub:boolean (hay:string needle:string) {
        def n:int (strlen needle)
        def m:int (strlen hay)
        if (n == 0) {
            return true
        }
        def i:int 0
        while ((i + n) <= m) {
            if ((substring hay i (i + n)) == needle) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; A small sales sheet: a header row, a label column, two series.
    sfn salesModel:SpreadsheetModel () {
        def m (new SpreadsheetModel)
        m.setCell(0 0 "Month")
        m.setCell(0 1 "North")
        m.setCell(0 2 "South")
        m.setCell(1 0 "Jan")
        m.setCell(1 1 "120")
        m.setCell(1 2 "80")
        m.setCell(2 0 "Feb")
        m.setCell(2 1 "150")
        m.setCell(2 2 "95")
        m.setCell(3 0 "Mar")
        m.setCell(3 1 "90")
        m.setCell(3 2 "130")
        return m
    }

    sfn chartOver:GridChart (r0:int c0:int r1:int c1:int) {
        def ch (new GridChart)
        ch.id = 1
        ch.r0 = r0
        ch.c0 = c0
        ch.r1 = r1
        ch.c1 = c1
        return ch
    }

    ; Six rows and three value columns: enough for every kind the picker
    ; offers, including the ones that want a third column for a bubble's size
    ; or a box plot's spread.
    sfn wideModel:SpreadsheetModel () {
        def m (new SpreadsheetModel)
        m.setCell(0 0 "Month")
        m.setCell(0 1 "North")
        m.setCell(0 2 "South")
        m.setCell(0 3 "East")
        def names:[string]
        push names "Jan"
        push names "Feb"
        push names "Mar"
        push names "Apr"
        push names "May"
        push names "Jun"
        def a:[string]
        push a "120"
        push a "150"
        push a "90"
        push a "175"
        push a "140"
        push a "165"
        def b:[string]
        push b "80"
        push b "95"
        push b "130"
        push b "110"
        push b "125"
        push b "85"
        def c:[string]
        push c "20"
        push c "45"
        push c "31"
        push c "52"
        push c "38"
        push c "27"
        def i:int 0
        while (i < (array_length names)) {
            m.setCell((i + 1) 0 (itemAt names i))
            m.setCell((i + 1) 1 (itemAt a i))
            m.setCell((i + 1) 2 (itemAt b i))
            m.setCell((i + 1) 3 (itemAt c i))
            i = (i + 1)
        }
        return m
    }

    ; The PNG signature, as bytes. A test that checked the base64 started with
    ; "iVBOR" would pass on a truncated file.
    sfn isPng:boolean (b:buffer) {
        if ((buffer_length b) < 24) {
            return false
        }
        if ((buffer_get b 0) != 137) {
            return false
        }
        if ((buffer_get b 1) != 80) {
            return false
        }
        if ((buffer_get b 2) != 78) {
            return false
        }
        return ((buffer_get b 3) == 71)
    }

    ; IHDR carries the size big-endian at byte 16.
    sfn beInt:int (b:buffer at:int) {
        def v:int (buffer_get b at)
        v = ((v * 256) + (buffer_get b (at + 1)))
        v = ((v * 256) + (buffer_get b (at + 2)))
        return ((v * 256) + (buffer_get b (at + 3)))
    }

    sfn pngWidth:int (b:buffer) {
        if ((buffer_length b) < 24) {
            return 0
        }
        return (ChartTest.beInt(b 16))
    }

    sfn pngHeight:int (b:buffer) {
        if ((buffer_length b) < 24) {
            return 0
        }
        return (ChartTest.beInt(b 20))
    }

    ; How many pixels of a decoded image differ from the RGBA surface it came
    ; from. Alpha is not compared: the PNG is written opaque.
    sfn pixelDiff:int (img:ImageBuffer src:buffer) {
        def n:int (img.width * img.height)
        def bad:int 0
        def i:int 0
        while (i < n) {
            def off:int (i * 4)
            if ((buffer_get img.pixels off) != (buffer_get src off)) {
                bad = (bad + 1)
            } {
                if ((buffer_get img.pixels (off + 1)) != (buffer_get src (off + 1))) {
                    bad = (bad + 1)
                } {
                    if ((buffer_get img.pixels (off + 2)) != (buffer_get src (off + 2))) {
                        bad = (bad + 1)
                    }
                }
            }
            i = (i + 1)
        }
        return bad
    }

    ; base64 is four characters per three bytes, padded up.
    sfn base64Len:int (bytes:int) {
        def groups:int (idiv (bytes + 2) 3)
        return (groups * 4)
    }

    ; Pixels that are not the white the chart was cleared to. A blank surface
    ; encodes to a perfectly valid PNG of nothing, which is the failure a
    ; header check cannot see.
    sfn inkCount:int (px:buffer) {
        def n:int (buffer_length px)
        def marked:int 0
        def i:int 0
        while ((i + 3) < n) {
            def r:int (buffer_get px i)
            def g:int (buffer_get px (i + 1))
            def b:int (buffer_get px (i + 2))
            if (((r < 250) || (g < 250)) || (b < 250)) {
                marked = (marked + 1)
            }
            i = (i + 4)
        }
        return marked
    }

    ; How much drawn GEOMETRY a display list carries — the filled rings and
    ; strokes a chart is made of, as opposed to the boxes and text a window is.
    sfn geometryIn:int (dl:EVGDisplayList) {
        def n:int 0
        def i:int 0
        while (i < (array_length dl.cmds)) {
            def c:EVGDrawCmd (itemAt dl.cmds i)
            if (c.kind == 6) {
                n = (n + 1)
            }
            if (c.kind == 7) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; The text a failed render leaves in the display list, or "" when the
    ; chart drew. Checking for the apology is how a test tells a picture from
    ; a polite message about not having one.
    sfn complaint:string (dl:EVGDisplayList) {
        def i:int 0
        while (i < (array_length dl.cmds)) {
            def c:EVGDrawCmd (itemAt dl.cmds i)
            if (c.kind == 3) {
                if (ChartTest.hasSub(c.text "could not")) {
                    return c.text
                }
                if (ChartTest.hasSub(c.text "did not parse")) {
                    return c.text
                }
            }
            i = (i + 1)
        }
        return ""
    }

    fn run:void () {
        print "== chart data =="
        def m:SpreadsheetModel (ChartTest.salesModel())
        def ch:GridChart (ChartTest.chartOver(0 0 3 2))
        def data (new ChartData)
        this.checkTrue("range has numbers" (data.extract(m ch)))
        this.checkInt("three categories" (data.catCount()) 3)
        this.checkInt("two series" (data.seriesCount()) 2)
        this.checkInt("six points" data.points 6)
        this.check("series named by the header" (itemAt data.series 0) "North")
        this.check("categories from the label column" (itemAt data.cats 1) "Feb")
        this.checkFalse("month names are not numeric" data.catNumeric)

        print "== which charts suit it =="
        this.checkTrue("column suits" (data.suits((ChartKind.column()))))
        this.checkTrue("stacked suits two series" (data.suits((ChartKind.stacked()))))
        this.checkTrue("line suits three rows" (data.suits((ChartKind.line()))))
        this.checkFalse("pie does not suit two series" (data.suits((ChartKind.pie()))))
        ; A scatter plots one numeric COLUMN against another, so two value
        ; columns are what it needs — not a numeric category.
        this.checkTrue("scatter suits two value columns" (data.suits((ChartKind.scatter()))))
        this.checkFalse("bubble wants a third for the size" (data.suits((ChartKind.bubble()))))
        this.checkTrue("heatmap suits a grid" (data.suits((ChartKind.heatmap()))))
        this.checkTrue("100% stacked suits two series" (data.suits((ChartKind.normalized()))))
        this.checkInt("suggests a column" (data.suggestedKind()) (ChartKind.column()))

        def one:GridChart (ChartTest.chartOver(0 0 3 1))
        def dataOne (new ChartData)
        dataOne.extract(m one)
        this.checkInt("one series" (dataOne.seriesCount()) 1)
        this.checkTrue("pie suits one series" (dataOne.suits((ChartKind.pie()))))
        this.checkFalse("stacked needs two series" (dataOne.suits((ChartKind.stacked()))))

        print "== numeric categories =="
        def nm (new SpreadsheetModel)
        nm.setCell(0 0 "x")
        nm.setCell(0 1 "y")
        nm.setCell(1 0 "1")
        nm.setCell(1 1 "10")
        nm.setCell(2 0 "2")
        nm.setCell(2 1 "40")
        nm.setCell(3 0 "3")
        nm.setCell(3 1 "25")
        def nch:GridChart (ChartTest.chartOver(0 0 3 1))
        def ndata (new ChartData)
        ndata.extract(nm nch)
        this.checkTrue("numeric first column" ndata.catNumeric)
        this.checkFalse("one value column cannot be a scatter" (ndata.suits((ChartKind.scatter()))))
        this.checkTrue("but it can be a line" (ndata.suits((ChartKind.line()))))
        this.checkInt("suggests a line" (ndata.suggestedKind()) (ChartKind.line()))

        print "== the specification =="
        def spec:string (data.specJson(ch 300 200))
        this.checkTrue("asks for a bar mark" (ChartTest.hasSub(spec "\"mark\":\"bar\"")))
        this.checkTrue("groups the two series" (ChartTest.hasSub(spec "\"xOffset\"")))
        this.checkTrue("carries the data rows" (ChartTest.hasSub(spec "{\"cat\":\"Jan\",\"series\":\"North\",\"value\":120}")))
        this.checkTrue("sized as asked" (ChartTest.hasSub(spec "\"width\":300")))
        ch.kind = (ChartKind.pie())
        def pieSpec:string (dataOne.specJson(ch 300 200))
        this.checkTrue("pie is an arc" (ChartTest.hasSub(pieSpec "\"mark\":\"arc\"")))
        this.checkTrue("pie has a theta" (ChartTest.hasSub(pieSpec "\"theta\"")))
        this.checkFalse("pie carries only the first series" (ChartTest.hasSub(pieSpec "South")))
        ch.kind = (ChartKind.donut())
        this.checkTrue("donut has a hole" (ChartTest.hasSub((dataOne.specJson(ch 300 200)) "innerRadius")))
        ch.style = (ChartStyle.slate())
        this.checkTrue("dark style paints a dark page" (ChartTest.hasSub((dataOne.specJson(ch 300 200)) "\"background\":\"#242a33\"")))
        ch.kind = (ChartKind.column())
        ch.style = (ChartStyle.vela())

        print "== what counts as a number =="
        this.checkTrue("plain integer" (ChartData.looksNumeric("120")))
        this.checkTrue("decimal" (ChartData.looksNumeric("-3.5")))
        this.checkTrue("exponent" (ChartData.looksNumeric("1.2e3")))
        this.checkFalse("a date is not a number" (ChartData.looksNumeric("2024-01-01")))
        this.checkFalse("a percentage is not a number" (ChartData.looksNumeric("14.00%")))
        this.checkFalse("money is not a number" (ChartData.looksNumeric("$49.00")))
        this.checkFalse("two dots" (ChartData.looksNumeric("1.2.3")))
        this.checkFalse("empty" (ChartData.looksNumeric("")))

        print "== numbers survive the round trip =="
        this.check("whole" (ChartData.num(120.0)) "120")
        this.check("fraction" (ChartData.num(1.5)) "1.500")
        this.check("negative" (ChartData.num(-2.25)) "-2.250")

        print "== drawing =="
        def tr (new UITextRenderer)
        tr.addFontDir("gallery/pdf_writer/assets/fonts")
        tr.loadFont("Open Sans" "Open_Sans/OpenSans-Regular.ttf")
        def cv (new GridChartView)
        def dl (new EVGDisplayList)
        cv.paint(dl m ch tr 0 0 360 240)
        this.checkTrue("a column chart draws something" ((array_length dl.cmds) > 20))
        this.checkInt("compiled once" cv.compiles 1)
        def dl2 (new EVGDisplayList)
        cv.paint(dl2 m ch tr 0 0 360 240)
        this.checkInt("second paint came from the cache" cv.compiles 1)
        this.checkTrue("and drew the same amount" ((array_length dl2.cmds) == (array_length dl.cmds)))
        m.setCell(1 1 "999")
        def dl3 (new EVGDisplayList)
        cv.paint(dl3 m ch tr 0 0 360 240)
        this.checkInt("an edit recompiles" cv.compiles 2)

        ; EVERY kind the picker offers, drawn. Each is given the widest range
        ; it suits — three value columns for a bubble, one for a pie — and has
        ; to produce a picture rather than the apology text a failed render
        ; leaves behind. A kind nothing suits is a kind the picker offers and
        ; cannot draw, which is the failure this catches.
        def wide:SpreadsheetModel (ChartTest.wideModel())
        def k:int (ChartKind.lowest())
        while (k <= (ChartKind.highest())) {
            def cols:int 3
            def fits:boolean false
            while ((cols >= 1) && (fits == false)) {
                def probe (new ChartData)
                def pc:GridChart (ChartTest.chartOver(0 0 6 cols))
                if (probe.extract(wide pc)) {
                    if (probe.suits(k)) {
                        fits = true
                    }
                }
                if (fits == false) {
                    cols = (cols - 1)
                }
            }
            this.checkTrue(((ChartKind.label(k)) + " suits some range") fits)
            if fits {
                def kc:GridChart (ChartTest.chartOver(0 0 6 cols))
                kc.id = (100 + k)
                kc.kind = k
                def kdl (new EVGDisplayList)
                def kview (new GridChartView)
                kview.paint(kdl wide kc tr 0 0 360 240)
                this.checkTrue(((ChartKind.label(k)) + " draws") ((array_length kdl.cmds) > 10))
                this.check(((ChartKind.label(k)) + " drew without complaint") (ChartTest.complaint(kdl)) "")
            }
            k = (k + 1)
        }

        ; A style is not a label: two styles of the same chart have to produce
        ; DIFFERENT pictures. Mono turns the grid off, so it draws strictly
        ; fewer strokes — and when the config block stopped reaching Vega
        ; (compiled with `compile` rather than `compileSpec`) these were equal.
        def styled:GridChart (ChartTest.chartOver(0 0 6 2))
        styled.id = 300
        styled.kind = (ChartKind.column())
        styled.style = (ChartStyle.vela())
        def sdl (new EVGDisplayList)
        def sview (new GridChartView)
        sview.paint(sdl wide styled tr 0 0 360 240)
        def styled2:GridChart (ChartTest.chartOver(0 0 6 2))
        styled2.id = 301
        styled2.kind = (ChartKind.column())
        styled2.style = (ChartStyle.mono())
        def sdl2 (new EVGDisplayList)
        def sview2 (new GridChartView)
        sview2.paint(sdl2 wide styled2 tr 0 0 360 240)
        this.checkTrue("a style changes the picture" ((array_length sdl2.cmds) < (array_length sdl.cmds)))

        ; Categories keep the order the sheet put them in rather than being
        ; sorted alphabetically — Jan, Feb, Mar, not Feb, Jan, Mar.
        def orderData (new ChartData)
        orderData.extract(wide (ChartTest.chartOver(0 0 6 2)))
        def orderSpec:string (orderData.specJson((ChartTest.chartOver(0 0 6 2)) 300 200))
        this.checkTrue("the spec pins the category order" (ChartTest.hasSub(orderSpec "\"sort\":null")))
        this.check("first category is the first row" (itemAt orderData.cats 0) "Jan")

        def pieChart:GridChart (ChartTest.chartOver(0 0 3 1))
        pieChart.id = 200
        pieChart.kind = (ChartKind.pie())
        def pdl (new EVGDisplayList)
        def pview (new GridChartView)
        pview.paint(pdl m pieChart tr 0 0 300 240)
        this.checkTrue("pie draws" ((array_length pdl.cmds) > 5))

        print "== an empty range says so =="
        def blank (new SpreadsheetModel)
        blank.setCell(0 0 "a")
        blank.setCell(1 0 "b")
        def bc:GridChart (ChartTest.chartOver(0 0 1 0))
        def bdl (new EVGDisplayList)
        def bview (new GridChartView)
        bview.paint(bdl blank bc tr 0 0 200 120)
        def note:string ""
        def bi:int 0
        while (bi < (array_length bdl.cmds)) {
            def bcmd:EVGDrawCmd (itemAt bdl.cmds bi)
            if (bcmd.kind == 3) {
                note = bcmd.text
            }
            bi = (bi + 1)
        }
        this.checkTrue("says which range has no numbers" (ChartTest.hasSub(note "A1:A2")))

        print "== through the app: pick, place, drag, edit, close =="
        def app (new GridApp)
        app.init("gallery/pdf_writer/assets/fonts")
        ; Well clear of the demo sheet's own data, so the block the picker
        ; finds is the one this test wrote.
        app.model.growTo(70 4)
        app.model.setCell(60 0 "Quarter")
        app.model.setCell(60 1 "Widgets")
        app.model.setCell(60 2 "Gadgets")
        app.model.setCell(61 0 "Q1")
        app.model.setCell(61 1 "120")
        app.model.setCell(61 2 "80")
        app.model.setCell(62 0 "Q2")
        app.model.setCell(62 1 "150")
        app.model.setCell(62 2 "95")
        app.model.setCell(63 0 "Q3")
        app.model.setCell(63 1 "90")
        app.model.setCell(63 2 "130")

        ; One cell selected: the picker charts the block around it, as Excel
        ; does, rather than the single number.
        app.sel.anchor.row = 62
        app.sel.anchor.col = 1
        app.sel.active.row = 62
        app.sel.active.col = 1
        app.openChartDialog(0)
        this.checkTrue("picker opened" app.chartDialog.visible)
        this.check("found the block around the cell" (app.pendingChart.rangeLabel()) "A61:C64")
        this.checkTrue("header row guessed" app.pendingChart.useHeaderRow)
        this.checkTrue("header column guessed" app.pendingChart.useHeaderCol)
        def pieCtl:EVGControl (app.chartDialog.controlById(100 + (ChartKind.pie())))
        this.checkFalse("pie offered but disabled" pieCtl.enabled)
        def colCtl:EVGControl (app.chartDialog.controlById(100 + (ChartKind.column())))
        this.checkTrue("column offered" colCtl.enabled)

        ; --- the live preview -------------------------------------------------
        ; The picker draws the chart it is describing, in the region it left
        ; for it, and updates as the parameters change — no closing, no
        ; creating, no undo. What proves it is that the preview follows the
        ; radios: the view's preview chart is the pending one, frame by frame.
        def prev (new UIInput)
        prev.newFrame()
        app.update(prev)
        this.checkInt("the preview is aimed at the picker" app.view.previewWid app.chartDialog.wid)
        this.checkTrue("the picker left a region for it" app.chartDialog.hasContent)
        def region:EVGControl (app.chartDialog.contentControl())
        this.checkTrue("the region has room" ((region.w > 200) && (region.h > 140)))
        this.checkTrue("and stays inside the panel" (((region.x + region.w) <= app.chartDialog.w) && ((region.y + region.h) <= app.chartDialog.h)))

        app.chartDialog.selectRadio(100 + (ChartKind.area()))
        prev.newFrame()
        app.update(prev)
        this.checkInt("changing the type changes the preview" app.view.previewChart.kind (ChartKind.area()))
        app.chartDialog.selectRadio(200 + (ChartStyle.ocean()))
        prev.newFrame()
        app.update(prev)
        this.checkInt("and so does changing the style" app.view.previewChart.style (ChartStyle.ocean()))
        app.chartDialog.setInputValue(311 "Live one")
        prev.newFrame()
        app.update(prev)
        this.check("the title is previewed too" app.view.previewChart.title "Live one")
        this.checkInt("nothing has been created yet" (app.view.chartLayer.count()) 0)
        ; It is drawn where the region is, not where a chart window would be.
        def pdl2:EVGDisplayList (app.view.buildDisplayList(app.model app.sel app.grid app.editing app.editBuf app.book))
        this.checkTrue("the preview reaches the frame" ((ChartTest.geometryIn(pdl2)) > 4))

        ; Unchecking a header box changes what the data IS, so the offered
        ; kinds are rebuilt — and the preview follows that too.
        def headerCtl:EVGControl (app.chartDialog.controlById(301))
        headerCtl.checked = false
        prev.newFrame()
        app.update(prev)
        this.checkFalse("the header box took" app.pendingChart.useHeaderRow)
        this.checkTrue("the picker still has its preview region" app.chartDialog.hasContent)

        app.chartDialog.selectRadio(301)
        prev.newFrame()
        app.update(prev)
        app.chartDialog.setInputValue(311 "")
        app.chartDialog.selectRadio(100 + (ChartKind.line()))
        app.chartDialog.selectRadio(200 + (ChartStyle.mono()))
        app.applyChartDialog()
        this.checkInt("closing the picker stops the preview" app.view.previewWid app.chartDialog.wid)
        def after (new UIInput)
        after.newFrame()
        app.update(after)
        this.checkInt("the preview is switched off" app.view.previewWid 0)
        this.checkInt("one chart on the sheet" (app.view.chartLayer.count()) 1)
        this.checkFalse("picker closed" app.chartDialog.visible)
        def panel:ChartPanel (app.view.chartLayer.panelAt(0))
        this.checkInt("the chosen kind stuck" panel.chart.kind (ChartKind.line()))
        this.checkInt("the chosen style stuck" panel.chart.style (ChartStyle.mono()))
        this.checkTrue("its window is up" panel.win.visible)
        def cap:string panel.win.title
        this.checkTrue("captioned by what it is" (ChartTest.hasSub(cap "A61:C64")))

        ; The chart draws into the frame the window left for it.
        def appDl:EVGDisplayList (app.view.buildDisplayList(app.model app.sel app.grid app.editing app.editBuf app.book))
        def inside:int 0
        def di:int 0
        while (di < (array_length appDl.cmds)) {
            def dc:EVGDrawCmd (itemAt appDl.cmds di)
            if (dc.kind == 6) {
                inside = (inside + 1)
            }
            if (dc.kind == 7) {
                inside = (inside + 1)
            }
            di = (di + 1)
        }
        this.checkTrue("the sheet's own frame carries chart geometry" (inside > 4))

        ; Drag the title bar: the window moves and the chart remembers.
        def input (new UIInput)
        def startX:int panel.win.x
        def startY:int panel.win.y
        input.newFrame()
        input.setPointerPos((startX + 40) (startY + 8))
        input.setPointerDown(true)
        app.update(input)
        input.newFrame()
        input.setPointerPos((startX + 90) (startY + 38))
        input.setPointerDown(true)
        app.update(input)
        input.newFrame()
        input.setPointerPos((startX + 90) (startY + 38))
        input.setPointerDown(false)
        app.update(input)
        this.checkInt("window followed the drag" panel.win.x (startX + 50))
        this.checkInt("and the chart followed the window" panel.chart.y (startY + 30))

        ; A click on the sheet beside a floating chart still selects a cell:
        ; a sticky panel is not modal.
        def cellX:int (app.grid.x + 60)
        def cellY:int ((app.grid.gridOriginY()) + 4)
        input.newFrame()
        input.setPointerPos(cellX cellY)
        input.setPointerDown(true)
        app.update(input)
        input.newFrame()
        input.setPointerPos(cellX cellY)
        input.setPointerDown(false)
        app.update(input)
        this.checkInt("the grid still takes clicks" app.sel.active.row 0)

        ; Reopen the editor from the window's own button.
        def editBtn:EVGControl (panel.win.controlById((ChartLayer.editId())))
        def bx:int ((panel.win.x + editBtn.x) + 8)
        def by:int ((panel.win.y + editBtn.y) + 8)
        input.newFrame()
        input.setPointerPos(bx by)
        input.setPointerDown(true)
        app.update(input)
        input.newFrame()
        input.setPointerPos(bx by)
        input.setPointerDown(false)
        app.update(input)
        this.checkTrue("editing reopened" app.chartDialog.visible)
        this.checkInt("on that chart" app.chartEditId panel.chart.id)
        this.check("titled as an edit" app.chartDialog.title "Chart")
        def keptX:int panel.chart.x
        app.chartDialog.selectRadio(100 + (ChartKind.area()))
        app.applyChartDialog()
        this.checkInt("still one chart" (app.view.chartLayer.count()) 1)
        def edited:ChartPanel (app.view.chartLayer.panelAt(0))
        this.checkInt("kind changed" edited.chart.kind (ChartKind.area()))
        this.checkInt("place kept" edited.chart.x keptX)

        ; Drag the grip: the window grows, the chart's box grows with it, and
        ; the button stays where a button belongs.
        def gpanel:ChartPanel (app.view.chartLayer.panelAt(0))
        def gwin:EVGWindow gpanel.win
        def gside:int (gwin.boxSide())
        def gx:int (((gwin.x + gwin.w) - gside) + 4)
        def gy:int (((gwin.y + gwin.h) - gside) + 4)
        def beforeW:int gwin.w
        def beforeContentW:int (gwin.contentW())
        def btn:EVGControl (gwin.controlById((ChartLayer.editId())))
        def btnRight:int (btn.x + btn.w)
        input.newFrame()
        input.setPointerPos(gx gy)
        input.setPointerDown(true)
        app.update(input)
        input.newFrame()
        input.setPointerPos((gx + 60) (gy + 40))
        input.setPointerDown(true)
        app.update(input)
        input.newFrame()
        input.setPointerPos((gx + 60) (gy + 40))
        input.setPointerDown(false)
        app.update(input)
        this.checkInt("the grip resized the window" gwin.w (beforeW + 60))
        this.checkInt("the content took the width" (gwin.contentW()) (beforeContentW + 60))
        def btn2:EVGControl (gwin.controlById((ChartLayer.editId())))
        this.checkInt("the button stayed on the right edge" (btn2.x + btn2.w) (btnRight + 60))
        def resized:ChartPanel (app.view.chartLayer.panelAt(0))
        this.checkInt("and the chart remembers its new size" resized.chart.w gwin.w)

        ; The close box takes the chart away.
        def lastPanel:ChartPanel (app.view.chartLayer.panelAt(0))
        def win:EVGWindow lastPanel.win
        def side:int (win.boxSide())
        def clx:int (((win.x + win.w) - (side + 8)) + 4)
        def cly:int ((win.y + (idiv (win.titleH - side) 2)) + 4)
        input.newFrame()
        input.setPointerPos(clx cly)
        input.setPointerDown(true)
        app.update(input)
        input.newFrame()
        input.setPointerPos(clx cly)
        input.setPointerDown(false)
        app.update(input)
        this.checkInt("closing removed the chart" (app.view.chartLayer.count()) 0)

        print "== two charts: stacking, and the sheet they belong to =="
        def app2 (new GridApp)
        app2.init("gallery/pdf_writer/assets/fonts")
        def loaded:boolean (app2.loadXlsx("gallery/datagrid/fixtures/business-workbook.xlsx"))
        this.checkTrue("fixture loaded" loaded)
        app2.setActiveSheet(0)
        app2.sel.anchor.row = 0
        app2.sel.anchor.col = 3
        app2.sel.active.row = 6
        app2.sel.active.col = 5
        app2.openChartDialog(0)
        app2.applyChartDialog()
        app2.openChartDialog(0)
        app2.applyChartDialog()
        this.checkInt("two charts" (app2.view.chartLayer.count()) 2)
        def one:ChartPanel (app2.view.chartLayer.panelAt(0))
        def two:ChartPanel (app2.view.chartLayer.panelAt(1))
        ; Overlap them, then click the one underneath.
        one.win.x = 100
        one.win.y = 100
        two.win.x = 120
        two.win.y = 110
        def topBefore:EVGWindow (app2.windows.topmost())
        this.checkInt("the newer chart is on top" topBefore.wid two.win.wid)
        def input2 (new UIInput)
        input2.newFrame()
        input2.setPointerPos(104 106)
        input2.setPointerDown(true)
        app2.update(input2)
        input2.newFrame()
        input2.setPointerPos(104 106)
        input2.setPointerDown(false)
        app2.update(input2)
        def topAfter:EVGWindow (app2.windows.topmost())
        this.checkInt("clicking the one underneath raises it" topAfter.wid one.win.wid)

        app2.setActiveSheet(1)
        this.checkFalse("another sheet hides the charts" one.win.visible)
        app2.setActiveSheet(0)
        this.checkTrue("coming back shows them again" one.win.visible)

        ; A modal dialog still wins over the charts, whatever the stacking.
        app2.openChartDialog(0)
        def topModal:EVGWindow (app2.windows.topmost())
        this.checkTrue("the picker is above every chart" topModal.modal)
        app2.chartDialog.close()

        ; Ctrl+M opens the picker, and the status bar button does the same.
        input.newFrame()
        input.setModifiers(false true)
        input.pushText("m")
        app.update(input)
        this.checkTrue("Ctrl+M opens the picker" app.chartDialog.visible)
        app.chartDialog.close()
        input.newFrame()
        input.setModifiers(false false)
        def statusTop:int (app.grid.y + app.grid.h)
        def sbx:int ((GridView.chartButtonX(app.W)) + 6)
        def sby:int ((GridView.chartButtonY(statusTop)) + 6)
        this.checkTrue("the status button is where it is painted" (app.chartButtonHit(sbx sby)))
        input.newFrame()
        input.setPointerPos(sbx sby)
        input.setPointerDown(true)
        app.update(input)
        this.checkTrue("clicking it opens the picker" app.chartDialog.visible)
        app.chartDialog.close()

        print "== the clipboard: what Excel and Word are handed =="
        def clipApp (new GridApp)
        clipApp.init("gallery/pdf_writer/assets/fonts")
        clipApp.model.growTo(8 4)
        clipApp.model.setCell(0 0 "Month")
        clipApp.model.setCell(0 1 "North")
        clipApp.model.setCell(1 0 "Jan")
        clipApp.model.setCell(1 1 "120")
        clipApp.model.setCell(2 0 "Feb")
        clipApp.model.setCell(2 1 "150")
        clipApp.model.setCell(3 0 "Mar")
        clipApp.model.setCell(3 1 "90")
        clipApp.sheetView.markDirty()
        clipApp.sheetView.rebuild()
        clipApp.grid.updateVisible(clipApp.model)
        clipApp.sel.anchor.row = 0
        clipApp.sel.anchor.col = 0
        clipApp.sel.active.row = 3
        clipApp.sel.active.col = 1
        clipApp.openChartDialog(0)
        clipApp.chartDialog.selectRadio(100 + (ChartKind.column()))
        clipApp.chartDialog.setInputValue(311 "Sales Q1 (units)")
        clipApp.applyChartDialog()
        this.checkInt("a chart to copy" (clipApp.view.chartLayer.count()) 1)
        def cpanel:ChartPanel (clipApp.view.chartLayer.panelAt(0))
        def copied:int (clipApp.copyChart(cpanel.chart.id))
        this.checkTrue("the copy produced a bitmap" (copied > 0))
        this.check("the clipboard says what it holds" clipApp.clipboardKind "chart")
        this.check("nothing went wrong" clipApp.clipboardNote "")

        ; text/plain — the numbers, so a paste into cells is useful.
        this.checkTrue("the text flavour carries the range" (ChartTest.hasSub(clipApp.clipboardTsv "Jan\t120")))
        this.checkTrue("including its header" (ChartTest.hasSub(clipApp.clipboardTsv "Month\tNorth")))

        ; text/html — the flavour Word and Excel reach for first.
        this.checkTrue("the html flavour is an image" (ChartTest.hasSub(clipApp.clipboardHtml "<img ")))
        this.checkTrue("carried inline, not by reference" (ChartTest.hasSub(clipApp.clipboardHtml "src=\"data:image/png;base64,")))
        this.checkTrue("with the chart's own name on it" (ChartTest.hasSub(clipApp.clipboardHtml "Sales Q1 (units)")))
        this.checkFalse("and no external URL to go missing" (ChartTest.hasSub(clipApp.clipboardHtml "http")))

        ; image/png — a real PNG, checked as bytes rather than as a string that
        ; starts with the right letters.
        def clipDirect:ChartClip (clipApp.clipper.build(clipApp.model cpanel.chart clipApp.view.ctx.tr 320 220))
        this.checkTrue("the png flavour has bytes" ((buffer_length clipDirect.png) > 1000))
        this.checkTrue("and they are a PNG" (ChartTest.isPng(clipDirect.png)))
        this.checkInt("whose header says how big it is" (ChartTest.pngWidth(clipDirect.png)) clipDirect.w)
        this.checkInt("and how tall" (ChartTest.pngHeight(clipDirect.png)) clipDirect.h)
        ; Drawn larger than the window it lives in: a 320-pixel chart dropped
        ; into a Word page is a thumbnail.
        this.checkTrue("bigger than the on-screen box" (clipDirect.w > 320))
        this.checkInt("the base64 is exactly those bytes" (strlen clipDirect.pngBase64) (ChartTest.base64Len((buffer_length clipDirect.png))))
        ; …and the bitmap is a picture rather than a blank rectangle: the
        ; surface it was encoded from has ink on it.
        this.checkTrue("there is ink on it" ((ChartTest.inkCount((clipApp.clipper.painter.raw()))) > 2000))

        ; image/svg+xml — the same render as vector, not traced from the bitmap.
        this.checkTrue("the svg flavour is a document" (ChartTest.hasSub(clipDirect.svg "<svg ")))
        this.checkTrue("and closes" (ChartTest.hasSub(clipDirect.svg "</svg>")))
        this.checkTrue("with the bars in it" (ChartTest.hasSub(clipDirect.svg "<path")))
        this.checkTrue("and the axis labels" (ChartTest.hasSub(clipDirect.svg "Jan")))

        this.check("named after the chart" clipDirect.name "Sales-Q1-units")

        ; The compressed PNG read back by this repository's own decoder, pixel
        ; for pixel against the surface it was encoded from. The writer emits
        ; real deflate now rather than stored blocks, and "it looks right in a
        ; viewer" is not a test of that.
        def dec (new PNGDecoder)
        def back:ImageBuffer (dec.decodeBytes(clipDirect.png))
        this.checkInt("the png decodes to the same width" back.width clipDirect.w)
        this.checkInt("and the same height" back.height clipDirect.h)
        this.checkInt("with every pixel intact" (ChartTest.pixelDiff(back (clipApp.clipper.painter.raw()))) 0)

        ; Ctrl+C over a chart copies the chart; over the sheet it still copies
        ; cells, and copying cells clears the chart flavours.
        def chartOnTop:int (clipApp.focusedChartId())
        this.checkInt("the chart window is what Ctrl+C means" chartOnTop cpanel.chart.id)
        clipApp.copySelection()
        this.check("copying cells goes back to cells" clipApp.clipboardKind "cells")
        this.check("and drops the picture" clipApp.clipboardPng "")
        this.checkTrue("the command surface offers the chart copy" (clipApp.commands.has("chart.copy")))
        this.checkTrue("and running it copies one" (clipApp.runCommand("chart.copy" "")))
        this.check("which is a chart again" clipApp.clipboardKind "chart")

        ; A chart of nothing says so instead of putting an empty picture on the
        ; clipboard.
        def emptyChart:GridChart (ChartTest.chartOver(40 0 42 0))
        emptyChart.id = 900
        def emptyClip:ChartClip (clipApp.clipper.build(clipApp.model emptyChart clipApp.view.ctx.tr 300 200))
        this.checkFalse("an empty range does not copy" emptyClip.ok)
        this.checkTrue("and says why" ((strlen emptyClip.note) > 0))

        print ""
        print (("passed=" + (to_string passed)) + " failed=" + (to_string failed))
        if (failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }

    sfn main:void () {
        def t (new ChartTest)
        t.run()
    }
}

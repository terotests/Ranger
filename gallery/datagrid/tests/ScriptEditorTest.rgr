; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; ScriptEditorTest — the lexer says what a run of characters is, and the
; editor does what a key press means.
; ==============================================================================
;
; Both halves are checked without a screen: the lexer hands back spans, and the
; editor hands back text. What a colour LOOKS like is not testable here and is
; not the part that breaks — what breaks is a lexer that loses its state across
; a line, and an edit that puts the caret in the wrong place.
; ==============================================================================

Import "../src/script/JsTokens.rgr"
Import "../src/script/ScriptEditor.rgr"
Import "../src/script/lang/JsLanguage.rgr"
Import "../src/script/lang/RangerLanguage.rgr"
Import "../src/script/lang/CLikeLanguage.rgr"

class Checker {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        this.ok((name + " (got '" + got + "' want '" + want + "')") (got == want))
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }
}

class ScriptEditorTest {

    ; The kind the lexer gave the token starting at `at`, or -1.
    sfn kindAt:int (line:CodeTokenLine at:int) {
        def i:int 0
        def n:int (line.count())
        while (i < n) {
            def t:CodeToken (line.at(i))
            if (t.start == at) {
                return t.kind
            }
            i = (i + 1)
        }
        return -1
    }

    sfn textOf:string (src:string line:CodeTokenLine index:int) {
        def t:CodeToken (line.at(index))
        def stop:int (t.start + t.len)
        return (substring src t.start stop)
    }

    sfn main:void () {
        def c:Checker (new Checker)

        print "== the lexer =="
        def lx:JsTokenizer (new JsTokenizer)
        def src:string "const rows = sheetRows('Sales'); // read the sheet"
        def line:CodeTokenLine (lx.tokenizeLine(src))
        c.eqInt("const is a keyword" (ScriptEditorTest.kindAt(line 0)) (CodeTokenKind.keyword()))
        c.eqInt("rows is an identifier" (ScriptEditorTest.kindAt(line 6)) (CodeTokenKind.ident()))
        c.eqInt("sheetRows is a builtin" (ScriptEditorTest.kindAt(line 13)) (CodeTokenKind.builtin()))
        c.eqInt("'Sales' is text" (ScriptEditorTest.kindAt(line 23)) (CodeTokenKind.text()))
        c.eqInt("the comment runs to the end" (ScriptEditorTest.kindAt(line 33)) (CodeTokenKind.comment()))

        def numLine:CodeTokenLine (lx.tokenizeLine("let x = 12.5 + 0x1f;"))
        c.eqInt("a number is a number" (ScriptEditorTest.kindAt(numLine 8)) (CodeTokenKind.number()))
        c.eqInt("so is a hex one" (ScriptEditorTest.kindAt(numLine 15)) (CodeTokenKind.number()))

        print "== JSX, without a parser =="
        def jsx:CodeTokenLine (lx.tokenizeLine("  <Label width='90px' fontWeight={w}>{v}</Label>"))
        c.eqInt("an opening tag" (ScriptEditorTest.kindAt(jsx 2)) (CodeTokenKind.tag()))
        c.eqInt("width is an attribute" (ScriptEditorTest.kindAt(jsx 9)) (CodeTokenKind.attr()))
        c.eqInt("fontWeight too" (ScriptEditorTest.kindAt(jsx 22)) (CodeTokenKind.attr()))
        def cmp:CodeTokenLine (lx.tokenizeLine("if (i < rows.length) { }"))
        c.eqInt("but a comparison is punctuation" (ScriptEditorTest.kindAt(cmp 6)) (CodeTokenKind.punct()))
        def eq:CodeTokenLine (lx.tokenizeLine("if (a == b) { }"))
        c.eqInt("and == is not an attribute" (ScriptEditorTest.kindAt(eq 4)) (CodeTokenKind.ident()))

        print "== state that outlives a line =="
        def lines:[string] ([] _:string ( "a = 1; /* opens" "still inside" "closes */ b = 2;" ))
        def out:[CodeTokenLine] (lx.tokenize(lines))
        c.eqInt("three lines in, three out" (array_length out) 3)
        def l1:CodeTokenLine (itemAt out 1)
        c.eqInt("the whole middle line is comment" (l1.count()) 1)
        c.eqInt("and it knows it" (ScriptEditorTest.kindAt(l1 0)) (CodeTokenKind.comment()))
        def l2:CodeTokenLine (itemAt out 2)
        c.eqInt("code resumes after the close" (ScriptEditorTest.kindAt(l2 10)) (CodeTokenKind.ident()))

        print "== the editor =="
        def ed:ScriptEditor (new ScriptEditor)
        ed.init("function render() {\n  return 1;\n}\n")
        c.eqInt("lines counted" (ed.buf.lineCount()) 4)
        c.ok("nothing typed yet" (ed.dirty == false))

        ; Type at the end of the first line: Enter keeps the indent, and opens
        ; one more level after a `{`.
        ed.moveCaret(0 19 false)
        ed.insertNewline()
        c.eqStr("a new line, indented" (ed.buf.lineAt(1)) "  ")
        ed.handleText("const x = 1;")
        c.eqStr("typed after the indent" (ed.buf.lineAt(1)) "  const x = 1;")
        c.ok("and the script is dirty now" ed.dirty)

        ed.backspace()
        c.eqStr("backspace takes one" (ed.buf.lineAt(1)) "  const x = 1")
        ed.undo()
        c.ok("undo puts it back" ((ed.buf.lineAt(1)) == "  const x = 1;"))

        ; Typed over a selection: one undo puts the selection back whole.
        ed.moveCaret(1 8 false)
        ed.moveCaret(1 9 true)
        ed.insert("total")
        c.eqStr("typed over the selection" (ed.buf.lineAt(1)) "  const total = 1;")
        ed.undo()
        c.eqStr("one undo puts the word back" (ed.buf.lineAt(1)) "  const x = 1;")
        ed.redo()
        c.eqStr("and redo types it again" (ed.buf.lineAt(1)) "  const total = 1;")
        ed.undo()

        ed.selectAll()
        c.ok("select all reaches the end" ((ed.sel.isCollapsed()) == false))
        ed.insert("x")
        c.eqInt("and typing replaces everything" (ed.buf.lineCount()) 1)
        c.eqStr("with what was typed" (ed.text()) "x")

        print "== the keyboard can cross the file =="
        def kb:ScriptEditor (new ScriptEditor)
        kb.init("const alpha = 1;\nfunction beta() {\n  return gamma;\n}\n")
        kb.moveCaret(0 0 false)
        kb.handleKey((UIKey.right()) false true)
        c.eqInt("ctrl+right lands after the first word" kb.sel.caret.col 5)
        kb.handleKey((UIKey.right()) false true)
        c.eqInt("and after the second" kb.sel.caret.col 11)
        kb.handleKey((UIKey.left()) false true)
        c.eqInt("ctrl+left goes back to its start" kb.sel.caret.col 6)
        kb.handleKey((UIKey.end()) false false)
        c.eqInt("end is the end of the line" kb.sel.caret.col 16)
        kb.handleKey((UIKey.end()) false true)
        c.eqInt("ctrl+end is the last line" kb.sel.caret.line 4)
        kb.handleKey((UIKey.home()) false true)
        c.eqInt("ctrl+home is the first" kb.sel.caret.line 0)
        c.eqInt("at column zero" kb.sel.caret.col 0)
        kb.handleKey((UIKey.down()) true false)
        c.ok("shift+down selects" ((kb.sel.isCollapsed()) == false))
        kb.handleKey((UIKey.right()) false false)
        c.ok("a plain right collapses the selection" (kb.sel.isCollapsed()))
        c.eqInt("to its far edge, without moving on" kb.sel.caret.line 1)
        c.eqInt("and to that edge's column" kb.sel.caret.col 0)
        kb.handleKey((UIKey.down()) true false)
        kb.handleKey((UIKey.left()) false false)
        c.eqInt("a plain left collapses to the near edge" kb.sel.caret.line 1)
        kb.handleKey((UIKey.end()) true true)
        c.ok("shift+ctrl+end selects to the end" (kb.sel.caret.line == 4))
        c.ok("and the selection is still open" ((kb.sel.isCollapsed()) == false))

        print "== tokens follow the text =="
        ; With a language plugin installed. Without one the editor draws plain
        ; text on purpose — an unknown file should not be coloured as if it
        ; were understood.
        ed.setLanguage((new JsLanguage))
        ed.init("const a = 1;")
        ed.ensureTokens()
        def first:CodeTokenLine (ed.tokensFor(0))
        c.eqInt("lexed on demand" (ScriptEditorTest.kindAt(first 0)) (CodeTokenKind.keyword()))
        def v1:int ed.tokenVersion
        ed.ensureTokens()
        c.eqInt("and not re-lexed for nothing" ed.tokenVersion v1)
        ed.moveCaret(0 12 false)
        ed.handleText(" // note")
        ed.ensureTokens()
        c.ok("re-lexed after an edit" (ed.tokenVersion != v1))
        def again:CodeTokenLine (ed.tokensFor(0))
        c.eqInt("and the comment is there" (ScriptEditorTest.kindAt(again 13)) (CodeTokenKind.comment()))

        print "== a language plugin says what is wrong =="
        def js:JsLanguage (new JsLanguage)
        c.eqStr("it knows its name" (js.id()) "javascript")
        c.ok("and which files are its own" (js.handlesFile("report.tsx")))
        c.ok("but not another language's" ((js.handlesFile("thing.rgr")) == false))

        def clean:[EditorDiagnostic] (js.diagnose("function render() {\n  return 1;\n}\n"))
        c.eqInt("a good document has no problems" (array_length clean) 0)
        c.ok("and it was really parsed, not skipped" js.parsedLastRun)

        def unclosed:[EditorDiagnostic] (js.diagnose("function render() {\n  return 1;\n"))
        c.eqInt("an unclosed brace is one problem" (array_length unclosed) 1)
        def ub:EditorDiagnostic (itemAt unclosed 0)
        c.eqInt("reported where it was OPENED" ub.line 0)
        c.eqInt("at its column" ub.col 18)
        c.eqInt("as an error" ub.severity (DiagnosticSeverity.error()))
        c.eqStr("by the plugin that found it" ub.source "javascript")

        def stray:[EditorDiagnostic] (js.diagnose("const a = 1;\n}\n"))
        c.ok("a stray closer is caught too" ((array_length stray) > 0))
        def sd:EditorDiagnostic (itemAt stray 0)
        c.eqInt("on its own line" sd.line 1)

        ; A document that is structurally fine but does not parse: the second
        ; pass, the real parser, the one ComponentEngine will use.
        def bad:[EditorDiagnostic] (js.diagnose("const = 1;\n"))
        c.ok("the parser catches what the lexer cannot" ((array_length bad) > 0))
        def pd:EditorDiagnostic (itemAt bad 0)
        c.eqInt("with a line" pd.line 0)
        c.ok("and something to say" ((strlen pd.message) > 4))

        print "== and another plugin, for another language =="
        def rg:RangerLanguage (new RangerLanguage)
        c.eqStr("its own name" (rg.id()) "ranger")
        c.ok("its own files" (rg.handlesFile("Thing.rgr")))
        def rgClean:[EditorDiagnostic] (rg.diagnose("class A {\n    fn f:int () {\n        return (this.g())\n    }\n}\n"))
        c.eqInt("clean Ranger is clean" (array_length rgClean) 0)
        def rgOpen:[EditorDiagnostic] (rg.diagnose("class A {\n    fn f:int () {\n        return (1 + 2\n    }\n"))
        c.ok("an unclosed paren is a problem" ((array_length rgOpen) > 0))
        def rgWarn:[EditorDiagnostic] (rg.diagnose("class A {\n    fn f:int () {\n        return this.g()\n    }\n}\n"))
        c.eqInt("a returned bare call is a warning" (array_length rgWarn) 1)
        def rw:EditorDiagnostic (itemAt rgWarn 0)
        c.eqInt("on the return line" rw.line 2)
        c.eqInt("as a warning, not an error" rw.severity (DiagnosticSeverity.warning()))
        def rgRecv:[EditorDiagnostic] (rg.diagnose("class A {\n    fn f:void () {\n        (this.g()).x()\n    }\n}\n"))
        c.ok("so is a statement starting with a receiver" ((array_length rgRecv) > 0))

        print "== the registry picks by file name =="
        def reg:LanguageRegistry (new LanguageRegistry)
        reg.add(js)
        reg.add(rg)
        def pick1:EditorLanguage (reg.forFile("summary.tsx"))
        c.eqStr("a .tsx goes to the javascript plugin" (pick1.id()) "javascript")
        def pick2:EditorLanguage (reg.forFile("GridApp.rgr"))
        c.eqStr("a .rgr goes to the ranger one" (pick2.id()) "ranger")
        def pick3:EditorLanguage (reg.forFile("notes.txt"))
        c.eqStr("and an unknown file complains about nothing" (pick3.id()) "text")
        def byId:EditorLanguage (reg.byId("ranger"))
        c.eqStr("plugins can be found by id" (byId.id()) "ranger")

        print "== the editor shows them, and forgets them when fixed =="
        def ed2:ScriptEditor (new ScriptEditor)
        ed2.setLanguage(js)
        ed2.init("function render() {\n  return 1;\n")
        c.eqInt("one problem to start with" (ed2.problemCount()) 1)
        c.ok("the line knows it has one" (ed2.hasProblemOnLine(0)))
        c.ok("another line does not" ((ed2.hasProblemOnLine(1)) == false))
        ed2.moveCaret(1 11 false)
        ed2.handleText("}")
        c.eqInt("and closing it clears the complaint" (ed2.problemCount()) 0)
        ed2.moveCaret(0 0 false)
        ed2.handleText("{")
        c.ok("breaking it again brings one back" ((ed2.problemCount()) > 0))
        c.ok("and the caret can be sent to it" (ed2.goToNextProblem()))

        print "== the plugin suggests what could be typed =="
        def cLines:[string] ([] _:string ( "const total = 1;" "function render() {" "  she" "}" ))
        def sugg:[Completion] (js.complete(cLines 2 5))
        c.ok(("something to suggest (" + (to_string (array_length sugg)) + ")") ((array_length sugg) >= 4))
        def first:Completion (itemAt sugg 0)
        c.eqStr("the workbook API comes first" first.label "sheetNames")
        c.eqStr("and says where it is from" first.detail "workbook API")
        c.eqInt("as an api completion" first.kind (CompletionKind.builtin()))

        ; A word only this document knows.
        def docLines:[string] ([] _:string ( "const grandTotal = 1;" "gran" ))
        def own:[Completion] (js.complete(docLines 1 4))
        c.ok("words from the file are offered too" ((array_length own) > 0))
        def ownFirst:Completion (itemAt own 0)
        c.eqStr("with the name that was typed once" ownFirst.label "grandTotal")
        c.eqStr("and where it came from" ownFirst.detail "in this file")

        def none:[Completion] (js.complete(cLines 3 1))
        c.eqInt("no prefix, no list" (array_length none) 0)

        def rgLines:[string] ([] _:string ( "class A {" "    fn f:void () {" "        arr" "    }" "}" ))
        def rgSugg:[Completion] (rg.complete(rgLines 2 11))
        c.ok("the other plugin has its own vocabulary" ((array_length rgSugg) > 0))
        def rgFirst:Completion (itemAt rgSugg 0)
        c.eqStr("Ranger's operators" rgFirst.label "array_length")
        c.eqStr("named as such" rgFirst.detail "operator")

        print "== a dot asks what the thing can do =="
        def arrLines:[string] ([] _:string ( "function page(rows) {" "  const body = [];" "  body." "}" ))
        def arrM:[Completion] (js.complete(arrLines 2 7))
        c.ok(("an array has members (" + (to_string (array_length arrM)) + ")") ((array_length arrM) > 10))
        def hasPush:boolean false
        def hasSplit:boolean false
        def mi:int 0
        while (mi < (array_length arrM)) {
            def m:Completion (itemAt arrM mi)
            if (m.label == "push") {
                hasPush = true
                c.eqStr("and they say what they belong to" m.detail "array")
            }
            if (m.label == "split") {
                hasSplit = true
            }
            mi = (mi + 1)
        }
        c.ok("push is offered on an array" hasPush)
        c.ok("and split is not" (hasSplit == false))

        def strLines:[string] ([] _:string ( "const name = 'Sales';" "name.to" ))
        def strM:[Completion] (js.complete(strLines 1 7))
        c.ok("a string literal types itself" ((array_length strM) > 0))
        def sm:Completion (itemAt strM 0)
        c.eqStr("with string members" sm.detail "string")
        c.ok("filtered by what was typed" ((sm.label == "toLowerCase") || (sm.label == "toUpperCase") || (sm.label == "toString")))

        ; The workbook API's own result types.
        def apiLines:[string] ([] _:string ( "const rows = sheetRows('Sales');" "rows." ))
        def apiM:[Completion] (js.complete(apiLines 1 5))
        def apiFirstKind:string ""
        if ((array_length apiM) > 0) {
            def a0:Completion (itemAt apiM 0)
            apiFirstKind = a0.detail
        }
        c.eqStr("sheetRows() is known to return rows" apiFirstKind "array")

        def cellLines:[string] ([] _:string ( "const n = usedRows('Sales');" "n.to" ))
        def cellM:[Completion] (js.complete(cellLines 1 4))
        c.ok("a number has few members" ((array_length cellM) > 0))
        def nm:Completion (itemAt cellM 0)
        c.eqStr("and knows it is one" nm.detail "number")

        def objLines:[string] ([] _:string ( "const style = { width: 10, colour: 'red' };" "style." ))
        def objM:[Completion] (js.complete(objLines 1 6))
        c.ok("an object literal offers its own keys" ((array_length objM) >= 2))
        def k0:Completion (itemAt objM 0)
        c.eqStr("the first one" k0.label "width")
        c.eqStr("named as its own" k0.detail "own property")

        def anyLines:[string] ([] _:string ( "function f(thing) {" "  thing." "}" ))
        def anyM:[Completion] (js.complete(anyLines 1 8))
        c.ok("an unknown receiver still offers something" ((array_length anyM) > 10))
        def a1:Completion (itemAt anyM 0)
        c.eqStr("and says it is guessing" a1.detail "any")

        print "== and Ranger answers `this.` from the file =="
        def rgFile:[string] ([] _:string ( "class Report {" "    def rows:[string]" "    fn total:int () {" "        return (this.co" "    }" "    fn countOf:int (n:int) {" "        return n" "    }" "}" ))
        def rgM:[Completion] (rg.complete(rgFile 3 23))
        c.ok("its own methods are offered" ((array_length rgM) > 0))
        def rm:Completion (itemAt rgM 0)
        c.eqStr("by name" rm.label "countOf")
        c.eqStr("and by what they are" rm.detail "method")

        print "== and the editor can take one =="
        def ed3:ScriptEditor (new ScriptEditor)
        ed3.setLanguage(js)
        ed3.init("function render() {\n  \n}\n")
        ed3.moveCaret(1 2 false)
        ed3.handleText("s")
        c.ok("one letter is not a suggestion" (ed3.completionOpen == false))
        ed3.handleText("h")
        c.ok("two letters open the list" ed3.completionOpen)
        c.ok("with candidates in it" ((ed3.completionCount()) > 0))
        ed3.handleKey((UIKey.down()) false false)
        c.eqInt("the arrow picks the next one" ed3.completionIndex 1)
        ed3.handleKey((UIKey.up()) false false)
        c.eqInt("and back" ed3.completionIndex 0)
        def picked:Completion (ed3.completionAt(0))
        ed3.handleKey((UIKey.enter()) false false)
        c.ok("Enter accepted it" (ed3.completionOpen == false))
        def after:string (ed3.buf.lineAt(1))
        c.eqStr("replacing what was typed, not appending to it" after ("  " + picked.label))

        ed3.handleText("(")
        c.ok("a non-word character closes the list" (ed3.completionOpen == false))
        ; …and a dot opens it again, with no prefix at all.
        ed3.moveCaret(1 (strlen (ed3.buf.lineAt(1))) false)
        ed3.handleText(".")
        c.ok("a dot opens the member list on its own" ed3.completionOpen)
        ed3.moveCaret(1 4 false)
        ed3.requestCompletions()
        c.ok("Ctrl+Space opens it whatever the prefix" ed3.completionOpen)
        ed3.handleKey((UIKey.escape()) false false)
        c.ok("Escape closes it" (ed3.completionOpen == false))

        print "== the clipboard's half of the model =="
        def cb:ScriptEditor (new ScriptEditor)
        cb.setLanguage(js)
        cb.init("alpha beta\nsecond line\nthird\n")
        cb.moveCaret(0 0 false)
        cb.moveCaret(0 5 true)
        c.eqStr("one line copies its span" (cb.selectionText()) "alpha")
        cb.moveCaret(0 0 false)
        cb.moveCaret(1 6 true)
        c.eqStr("and a selection across lines keeps the newline" (cb.selectionText()) "alpha beta\nsecond")
        def cut:string (cb.cutSelection())
        c.eqStr("cut hands back what it removed" cut "alpha beta\nsecond")
        c.eqStr("and the document is shorter" (cb.buf.lineAt(0)) " line")

        print "== a double-click takes a word, Tab indents a range =="
        def wx:ScriptEditor (new ScriptEditor)
        wx.init("const alpha = 1;\nnext line\n")
        wx.selectWordAtPos(0 8)
        c.eqStr("double-click takes the word under it" (wx.selectionText()) "alpha")
        wx.selectWordAtPos(0 0)
        c.eqStr("and the first word too" (wx.selectionText()) "const")
        wx.selectWordAtPos(0 5)
        c.eqStr("a gap takes the character under it" (wx.selectionText()) " ")

        def tb:ScriptEditor (new ScriptEditor)
        tb.init("alpha\nbeta\n")
        tb.moveCaret(0 0 false)
        tb.handleKey((UIKey.tab()) false false)
        c.eqStr("tab at the caret still inserts spaces" (tb.buf.lineAt(0)) "  alpha")

        def rg:ScriptEditor (new ScriptEditor)
        rg.init("alpha\nbeta\n")
        rg.moveCaret(0 1 false)
        rg.moveCaret(0 4 true)
        c.eqStr("a partial span is selected" (rg.selectionText()) "lph")
        rg.handleKey((UIKey.tab()) false false)
        c.eqStr("tab over it indents the line" (rg.buf.lineAt(0)) "  alpha")
        c.eqStr("without destroying the span" (rg.selectionText()) "lph")
        c.eqStr("the other line is untouched" (rg.buf.lineAt(1)) "beta")
        rg.handleKey((UIKey.tab()) true false)
        c.eqStr("shift+tab takes the indent back" (rg.buf.lineAt(0)) "alpha")
        c.eqStr("and the span is still there" (rg.selectionText()) "lph")

        def blk:ScriptEditor (new ScriptEditor)
        blk.init("alpha\nbeta\ngamma\n")
        blk.moveCaret(0 0 false)
        blk.moveCaret(2 0 true)
        blk.handleKey((UIKey.tab()) false false)
        c.eqStr("a block indent shifts the first line" (blk.buf.lineAt(0)) "  alpha")
        c.eqStr("and the second" (blk.buf.lineAt(1)) "  beta")
        c.eqStr("but not the line the range only touched at column 0" (blk.buf.lineAt(2)) "gamma")
        blk.handleKey((UIKey.tab()) false false)
        c.eqStr("a second tab indents again" (blk.buf.lineAt(0)) "    alpha")
        blk.handleKey((UIKey.tab()) true false)
        blk.handleKey((UIKey.tab()) true false)
        c.eqStr("two outdents restore the line" (blk.buf.lineAt(0)) "alpha")
        c.eqStr("and keep the text" (blk.buf.lineAt(1)) "beta")
        blk.undo()
        c.eqStr("undo is one indent step" (blk.buf.lineAt(0)) "  alpha")

        print "== the minimap is a map of the file =="
        def mm:ScriptEditor (new ScriptEditor)
        def built:string ""
        def mi:int 0
        while (mi < 80) {
            built = (built + "const line" + (to_string mi) + " = " + (to_string mi) + ";\n")
            mi = (mi + 1)
        }
        mm.init(built)
        mm.setBounds(0 0 640 400)
        c.eqInt("eighty lines plus the trailing empty" (mm.buf.lineCount()) 81)
        c.ok("the right strip is the map" (mm.insideMinimap(600 40)))
        c.ok("the text is not" ((mm.insideMinimap(120 40)) == false))
        c.eqInt("it reserves a strip" (mm.minimapWidth()) mm.minimapW)
        mm.setBounds(0 0 280 400)
        c.eqInt("a narrow panel hides it" (mm.minimapWidth()) 0)
        c.ok("and a click there is just a click" ((mm.insideMinimap(250 40)) == false))
        mm.setBounds(0 0 640 400)
        c.eqInt("the top of the map is line 0" (mm.minimapLineAt(0)) 0)
        def bot:int (mm.minimapLineAt(399))
        c.ok("the bottom is near the end of the file" (bot > 40))
        def caretWas:int mm.sel.caret.line
        c.eqInt("starts unscrolled" mm.layout.scrollLine 0)
        def picH:double (mm.minimapPictureH())
        c.ok("the picture is shorter than the editor" (picH < 400.0))
        def halfY:int (to_int (picH / 2.0))
        c.ok("a click on the picture is consumed" (mm.tryMinimapPointer(600 halfY)))
        def halfAt:int mm.layout.scrollLine
        c.ok("halfway down the picture is partway through the file" (halfAt > 10))
        c.eqInt("without moving the caret" mm.sel.caret.line caretWas)
        mm.tryMinimapPointer(600 0)
        c.eqInt("the top of the picture is the start of the file" mm.layout.scrollLine 0)
        def picY:int (to_int picH)
        mm.tryMinimapPointer(600 picY)
        def endAt:int mm.layout.scrollLine
        c.ok("the bottom of the picture is the end of the scroll" (endAt > halfAt))
        mm.tryMinimapPointer(600 40)
        def higher:int mm.layout.scrollLine
        mm.tryMinimapPointer(600 120)
        def lower:int mm.layout.scrollLine
        c.ok("further down the picture is further in the file" (lower > higher))
        mm.showMinimap = false
        c.eqInt("it can be turned off" (mm.minimapWidth()) 0)
        mm.showMinimap = true

        print "== a minimap letter is a faint cell, not a bar =="
        def dotInk:double (ScriptEditor.minimapInk(46))
        def iInk:double (ScriptEditor.minimapInk(73))
        def rInk:double (ScriptEditor.minimapInk(82))
        c.ok("a dot is almost empty" ((dotInk > 0.01) && (dotInk < 0.05)))
        c.ok("an I is a thin stem" ((iInk > 0.08) && (iInk < 0.13)))
        c.ok("an R fills more of the cell" ((rInk > 0.18) && (rInk < 0.23)))
        c.ok("and more than an I" (rInk > iInk))
        c.ok("a space is no speck" ((ScriptEditor.minimapInk(32)) < 0.001))

        print "== a tab is four columns of space, not an empty box =="
        def tabs:ScriptEditor (new ScriptEditor)
        tabs.init("class A {\n\tint x;\n\t\tint y;\n}\nab\tc\n")
        c.eqStr("one tab indents to four" (tabs.buf.lineAt(1)) "    int x;")
        c.eqStr("two tabs to eight" (tabs.buf.lineAt(2)) "        int y;")
        c.eqStr("a tab mid-line goes to the next stop" (tabs.buf.lineAt(4)) "ab  c")
        c.ok("no tab survives" ((indexOf (tabs.text()) "\t") < 0))

        print "== Ctrl+F finds, wraps, and counts =="
        def fd:ScriptEditor (new ScriptEditor)
        fd.init("alpha beta\ngamma alpha\ndelta\nAlpha again\n")
        c.ok("Ctrl+F opens the bar" (fd.handleCtrlChar(102)))
        c.ok("and it is up" (fd.findActive()))
        fd.handleText("alpha")
        c.eqStr("the keys go to the query, not the document" (fd.text()) "alpha beta\ngamma alpha\ndelta\nAlpha again\n")
        c.eqInt("three matches, case-insensitive" fd.findTotal 3)
        c.eqInt("the first is on line 0" fd.sel.caret.line 0)
        c.eqInt("and it is selected" fd.sel.caret.col 5)
        c.eqInt("showing 1 of 3" fd.findOrdinal 1)
        fd.findNext(false)
        c.eqInt("next is on line 1" fd.sel.caret.line 1)
        c.eqInt("2 of 3" fd.findOrdinal 2)
        fd.findNext(false)
        c.eqInt("then line 3" fd.sel.caret.line 3)
        fd.findNext(false)
        c.eqInt("and it wraps to the top" fd.sel.caret.line 0)
        fd.findNext(true)
        c.eqInt("backwards wraps too" fd.sel.caret.line 3)
        fd.handleKey((UIKey.backspace()) false false)
        c.eqStr("backspace edits the query" fd.findQuery "alph")
        c.eqStr("still not the document" (fd.buf.lineAt(0)) "alpha beta")
        fd.handleKey((UIKey.escape()) false false)
        c.ok("Escape closes it" ((fd.findActive()) == false))
        fd.handleText("z")
        c.eqStr("and the keys go back to the document, over the match" (fd.buf.lineAt(3)) "za again")

        print "== horizontal scroll"
        def hs:ScriptEditor (new ScriptEditor)
        hs.init("fn f:void () {\n    return (\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\")\n}\n")
        hs.showMinimap = false
        hs.setBounds(0 0 240 400)
        hs.contentWPx = 800
        hs.contentWVersion = hs.buf.version
        c.eqInt("starts at the left" hs.layout.scrollX 0)
        c.ok("a long line needs a bar" ((hs.maxScrollX()) > 0))
        hs.scrollByX(120)
        c.eqInt("a sideways wheel moves the text" hs.layout.scrollX 120)
        hs.scrollByX(-40)
        c.eqInt("and back" hs.layout.scrollX 80)
        hs.scrollByX(-1000)
        c.eqInt("not past the left edge" hs.layout.scrollX 0)
        hs.scrollByX(10000)
        c.eqInt("nor past the end of the line" hs.layout.scrollX (hs.maxScrollX()))
        c.ok("the thumb sits on a track" ((hs.hScrollH()) == 10))
        hs.moveCaret(1 0 false)
        hs.handleKey((UIKey.end()) false false)
        c.ok("End walks to the end of the line" (hs.sel.caret.col > 20))

        print "== font size"
        def fz:ScriptEditor (new ScriptEditor)
        c.ok("starts at the default size" (fz.layout.fontSize == 13.0))
        c.ok("a step up changes it" (fz.zoomBy(1)))
        c.ok("to 14" (fz.layout.fontSize == 14.0))
        fz.zoomBy(2)
        c.ok("two steps more is 16" (fz.layout.fontSize == 16.0))
        fz.init("a new text")
        c.ok("loading a text keeps the size" (fz.layout.fontSize == 16.0))
        fz.zoomBy(100)
        c.ok("not over the largest size" (fz.layout.fontSize == fz.maxFontSize))
        c.ok("a step at the limit changes nothing" ((fz.zoomBy(1)) == false))
        fz.zoomBy(-100)
        c.ok("nor under the smallest" (fz.layout.fontSize == fz.minFontSize))
        c.ok("0 goes back to the default" (fz.zoomBy(0)))
        c.ok("which is 13" (fz.layout.fontSize == 13.0))
        fz.setFontSize(15.4)
        c.ok("a size is whole pixels" (fz.layout.fontSize == 15.0))


        print "== a colleague's edits and carets"
        def co:ScriptEditor (new ScriptEditor)
        co.init("# Title\n\nSome text\n")
        co.moveCaret(2 4 false)
        co.applyRemoteAt(0 0 "intro\n")
        c.eqStr("their line is in" (co.text()) "intro\n# Title\n\nSome text\n")
        c.eqInt("my caret moved down with my text" co.sel.caret.line 3)
        c.eqInt("and kept its column" co.sel.caret.col 4)
        co.insert("X")
        c.eqStr("I type where I was" (co.text()) "intro\n# Title\n\nSomeX text\n")
        co.applyRemoteAt(co.caretOffset() 0 "yy")
        c.eqInt("their insert at my caret: mine stays before it" (co.caretOffset()) 20)
        co.undo()
        c.eqStr("my undo takes my X only" (co.text()) "intro\n# Title\n\nSomeyy text\n")
        co.selectAll()
        c.eqInt("anchor offset" (co.anchorOffset()) 0)
        co.addPeer("Anonymous Zebra" 234 88 12 3 0)
        c.eqInt("a peer" (array_length co.peers) 1)
        def pz:EditorPeer (itemAt co.peers 0)
        c.eqInt("peer caret column" pz.col 3)
        def tr0:UITextRenderer (new UITextRenderer)
        def dl0:EVGDisplayList (new EVGDisplayList)
        co.setBounds(0 0 600 300)
        co.paint(dl0 tr0 0)
        def flags:int 0
        for dl0.cmds cmd:EVGDrawCmd k {
            if (cmd.text == "Anonymous Zebra") {
                flags = (flags + 1)
            }
        }
        c.eqInt("the peer's name is painted" flags 1)
        co.clearPeers()
        c.eqInt("peers cleared" (array_length co.peers) 0)

        print "== read only: look, select, copy, find; never change =="
        def ro:ScriptEditor (new ScriptEditor)
        ro.setLanguage(js)
        ro.init("alpha beta\ngamma\n")
        ro.moveCaret(1 5 false)
        ro.insert("!")
        ro.setReadOnly(true)
        def roText:string (ro.text())
        c.eqStr("starts with the edit made before" roText "alpha beta\ngamma!\n")
        c.ok("typing is refused" ((ro.handleText("x")) == false))
        ro.insert("pasted")
        c.ok("a paste is ignored" ((ro.text()) == roText))
        ro.backspace()
        ro.deleteForward()
        ro.insertNewline()
        ro.indentSelection(false)
        ro.indentSelection(true)
        c.ok("backspace, delete, Enter and indent do nothing" ((ro.text()) == roText))
        c.ok("the backspace key is handed back" ((ro.handleKey((UIKey.backspace()) false false)) == false))
        c.ok("so is delete" ((ro.handleKey((UIKey.del()) false false)) == false))
        c.ok("and Enter" ((ro.handleKey((UIKey.enter()) false false)) == false))
        c.ok("and Tab, so focus can leave" ((ro.handleKey((UIKey.tab()) false false)) == false))
        ro.undo()
        c.ok("undo does not take back the earlier edit" ((ro.text()) == roText))
        c.ok("nor does Ctrl+Z" ((ro.handleCtrlChar(122)) == false))
        ro.redo()
        c.ok("and redo changes nothing" ((ro.text()) == roText))
        c.ok("Ctrl+Space opens nothing" ((ro.requestCompletions()) == false))
        c.ok("no completion list" (ro.completionOpen == false))
        ro.moveCaret(0 0 false)
        ro.handleKey((UIKey.right()) false false)
        c.eqInt("the caret still moves" ro.sel.caret.col 1)
        ro.handleKey((UIKey.right()) true true)
        c.eqStr("and selects" (ro.selectionText()) "lpha")
        c.eqStr("cut is not a cut" (ro.cutSelection()) "")
        c.ok("and leaves the text" ((ro.text()) == roText))
        c.eqStr("but the selection still copies" (ro.selectionText()) "lpha")
        ro.selectAll()
        c.ok("select all works" ((ro.sel.isCollapsed()) == false))
        ro.handleText("z")
        c.ok("typing over a selection is still nothing" ((ro.text()) == roText))
        c.ok("Ctrl+F still finds" (ro.handleCtrlChar(102)))
        ro.handleText("gam")
        c.eqStr("the keys go to the query" ro.findQuery "gam")
        c.eqInt("and the match is found" ro.sel.caret.line 1)
        ro.handleKey((UIKey.escape()) false false)
        c.ok("zoom still works" (ro.zoomBy(1)))
        c.ok("the document is not dirty from anything above" ((ro.text()) == roText))
        ro.setReadOnly(false)
        ro.moveCaret(0 0 false)
        ro.handleText("Q")
        c.eqStr("and editing comes back when the flag goes" (ro.buf.lineAt(0)) "Qalpha beta")

        print "== line numbers the host chooses =="
        def ln:ScriptEditor (new ScriptEditor)
        ln.init("a\nb\n...\nc\nd\n")
        c.eqStr("by default row 0 is line 1" (ln.lineLabel(0)) "1")
        c.eqStr("and row 4 is line 5" (ln.lineLabel(4)) "5")
        c.eqStr("with no second column" (ln.oldLineLabel(0)) "")
        def lnTr:UITextRenderer (new UITextRenderer)
        ln.setBounds(0 0 600 300)
        ln.syncLayout(lnTr)
        def defaultGutter:int ln.layout.gutterW
        ln.syncLayout(lnTr)
        c.eqInt("the default gutter does not grow on its own" ln.layout.gutterW defaultGutter)
        ln.setLineNumbers(([] _:int ( 11 12 0 50 51 )))
        c.eqStr("row 0 says 11" (ln.lineLabel(0)) "11")
        c.eqStr("the gap row says nothing" (ln.lineLabel(2)) "")
        c.eqStr("and the row after it is 50" (ln.lineLabel(3)) "50")
        c.eqStr("a row past the array has no number" (ln.lineLabel(5)) "")
        ln.syncLayout(lnTr)
        c.eqInt("two digits fit the default gutter" ln.layout.gutterW defaultGutter)
        ln.setLineNumbers(([] _:int ( 123456 123457 0 123500 123501 )))
        ln.syncLayout(lnTr)
        def sixW:int (to_int ((lnTr.measureWidth("000000" (ln.layout.fontSize * 0.85))) + 0.999))
        c.eqInt("the column is as wide as six digits" ln.numColW sixW)
        c.ok("six digits widen the gutter" (ln.layout.gutterW > defaultGutter))
        c.eqInt("to fit them and the margins" ln.layout.gutterW ((14 + sixW) + 8))
        def oneCol:int ln.layout.gutterW
        ln.setOldLineNumbers(([] _:int ( 9999999 0 0 1 2 )))
        ln.syncLayout(lnTr)
        c.eqStr("the old column has its own labels" (ln.oldLineLabel(0)) "9999999")
        c.eqStr("and blanks" (ln.oldLineLabel(1)) "")
        c.ok("a second column widens it again" (ln.layout.gutterW > oneCol))
        c.eqInt("by the widest old number and a gap" ln.layout.gutterW ((((14 + sixW) + 8) + ln.oldNumColW) + 10))
        def lnDl:EVGDisplayList (new EVGDisplayList)
        ln.paint(lnDl lnTr 1)
        def newX:double -1.0
        def oldX:double -1.0
        def zeroPainted:boolean false
        for lnDl.cmds cmd:EVGDrawCmd k {
            if (cmd.kind == 3) {
                if (cmd.text == "123456") {
                    newX = cmd.x
                }
                if (cmd.text == "9999999") {
                    oldX = cmd.x
                }
                if (cmd.text == "0") {
                    zeroPainted = true
                }
                if (cmd.text == "3") {
                    zeroPainted = true
                }
            }
        }
        c.ok("the host's number is painted" (newX >= 0.0))
        c.ok("the old number is painted to its left" ((oldX >= 0.0) && (oldX < newX)))
        c.ok("a gap row paints no number, and 1..N is gone" (zeroPainted == false))
        c.ok("the text starts after the gutter" ((ln.layout.contentX()) > (ln.layout.x + ln.layout.gutterW)))
        ln.init("x\ny\n")
        c.eqStr("init goes back to 1..N" (ln.lineLabel(1)) "2")
        c.eqStr("and drops the old column" (ln.oldLineLabel(0)) "")
        ln.syncLayout(lnTr)
        c.eqInt("and the default gutter" ln.layout.gutterW defaultGutter)

        print "== bands and dots the host puts on rows =="
        def bd:ScriptEditor (new ScriptEditor)
        bd.init("one\ntwo\nthree\nfour\n")
        bd.setLineMarks(([] _:int ( 0 1 0 2 )))
        def hi:EVGColor (EVGColor.rgba(250 200 10 0.25))
        def pin:EVGColor (EVGColor.rgb(20 180 240))
        def none:EVGColor (ScriptEditor.noColor())
        bd.setLineBands(([] _:EVGColor ( none hi hi none )))
        bd.setGutterDots(([] _:EVGColor ( none none pin none )))
        c.ok("row 1 has a band" (bd.hasLineBand(1)))
        c.ok("row 0 has none" ((bd.hasLineBand(0)) == false))
        c.ok("row 2 has a dot" (bd.hasGutterDot(2)))
        c.ok("a row past the array has neither" (((bd.hasLineBand(9)) || (bd.hasGutterDot(9))) == false))
        def bdTr:UITextRenderer (new UITextRenderer)
        bd.setBounds(0 0 600 300)
        bd.syncLayout(bdTr)
        bd.syncLayout(bdTr)
        def bdDl:EVGDisplayList (new EVGDisplayList)
        bd.paint(bdDl bdTr 1)
        def bands:int 0
        def dots:int 0
        def diffBands:int 0
        for bdDl.cmds cmd:EVGDrawCmd k {
            if (cmd.kind == 0) {
                if ((cmd.r == 250) && ((cmd.g == 200) && (cmd.b == 10))) {
                    bands = (bands + 1)
                }
                if ((cmd.r == 20) && ((cmd.g == 180) && (cmd.radius > 0.0))) {
                    dots = (dots + 1)
                }
                if ((cmd.r == 34) && ((cmd.g == 197) && (cmd.b == 94))) {
                    diffBands = (diffBands + 1)
                }
            }
        }
        c.eqInt("two rows banded" bands 2)
        c.eqInt("one dot" dots 1)
        c.ok("and the diff marks are still there" (diffBands > 0))
        def dotY:int ((bd.layout.caretPixelY(2)) + 3)
        c.eqInt("the dot's lane hit-tests to its row" (bd.gutterDotRowAt((bd.layout.x + 18) dotY)) 2)
        def oneY:int ((bd.layout.caretPixelY(1)) + 3)
        c.eqInt("a row without a dot is no hit" (bd.gutterDotRowAt((bd.layout.x + 18) oneY)) -1)
        c.eqInt("nor is the text" (bd.gutterDotRowAt(300 dotY)) -1)
        bd.init("again\n")
        c.ok("init clears the bands" ((bd.hasLineBand(1)) == false))
        c.ok("and the dots" ((bd.hasGutterDot(2)) == false))

        print "== C-like languages from a table =="
        def cpp:CLikeLanguage (CLikeLanguage.cpp())
        c.eqStr("C++ knows its name" (cpp.id()) "cpp")
        c.ok("a .hpp is C++" (cpp.handlesFile("vec.hpp")))
        c.ok("so is an upper-case .CPP" (cpp.handlesFile("MAIN.CPP")))
        c.ok("an .inl too" (cpp.handlesFile("a.inl")))
        c.ok("but not a .js" ((cpp.handlesFile("a.js")) == false))
        def inc:CodeTokenLine (cpp.tokenizeLine("#include <vector>"))
        c.eqInt("#include is a keyword" (ScriptEditorTest.kindAt(inc 0)) (CodeTokenKind.keyword()))
        c.eqInt("the header is a string" (ScriptEditorTest.kindAt(inc 9)) (CodeTokenKind.text()))
        def csrc:string "int main() { return 0x1F; } // done"
        def cl:CodeTokenLine (cpp.tokenizeLine(csrc))
        c.eqInt("int is a type" (ScriptEditorTest.kindAt(cl 0)) (CodeTokenKind.builtin()))
        c.eqInt("main is a name" (ScriptEditorTest.kindAt(cl 4)) (CodeTokenKind.ident()))
        c.eqInt("return is a keyword" (ScriptEditorTest.kindAt(cl 13)) (CodeTokenKind.keyword()))
        c.eqInt("0x1F is a number" (ScriptEditorTest.kindAt(cl 20)) (CodeTokenKind.number()))
        c.eqInt("// runs to the end" (ScriptEditorTest.kindAt(cl 28)) (CodeTokenKind.comment()))
        def strSrc:string "auto s = \"a\\\"b\"; char q = 'x';"
        def sl:CodeTokenLine (cpp.tokenizeLine(strSrc))
        def strTok:int 0
        while (strTok < (sl.count())) {
            def tk:CodeToken (sl.at(strTok))
            if (tk.start == 9) {
                break
            }
            strTok = (strTok + 1)
        }
        c.eqInt("a string is text" (ScriptEditorTest.kindAt(sl 9)) (CodeTokenKind.text()))
        c.eqStr("and an escaped quote does not end it" (ScriptEditorTest.textOf(strSrc sl strTok)) "\"a\\\"b\"")
        c.eqInt("a char is text too" (ScriptEditorTest.kindAt(sl 26)) (CodeTokenKind.text()))
        def block:[CodeTokenLine] (cpp.tokenize(([] _:string ( "int a; /* opens" "still a comment" "*/ int b;" ))))
        def b1:CodeTokenLine (itemAt block 1)
        c.eqInt("a block comment carries over a line" (ScriptEditorTest.kindAt(b1 0)) (CodeTokenKind.comment()))
        def b2:CodeTokenLine (itemAt block 2)
        c.eqInt("and ends where it closes" (ScriptEditorTest.kindAt(b2 0)) (CodeTokenKind.comment()))
        c.eqInt("with code after it" (ScriptEditorTest.kindAt(b2 3)) (CodeTokenKind.builtin()))
        c.eqInt("colouring only: nothing to diagnose" (array_length (cpp.diagnose("int main( {"))) 0)

        def sqlLang:CLikeLanguage (CLikeLanguage.sql())
        c.ok("a .sql file is SQL" (sqlLang.handlesFile("001_init.sql")))
        def q:string "SELECT count(*) from Users where name = 'it''s' -- note"
        def ql:CodeTokenLine (sqlLang.tokenizeLine(q))
        c.eqInt("SELECT is a keyword" (ScriptEditorTest.kindAt(ql 0)) (CodeTokenKind.keyword()))
        c.eqInt("count is a builtin" (ScriptEditorTest.kindAt(ql 7)) (CodeTokenKind.builtin()))
        c.eqInt("lower-case from is a keyword too" (ScriptEditorTest.kindAt(ql 16)) (CodeTokenKind.keyword()))
        c.eqInt("Users is a name" (ScriptEditorTest.kindAt(ql 21)) (CodeTokenKind.ident()))
        c.eqInt("so is mixed-case Where" (ScriptEditorTest.kindAt((sqlLang.tokenizeLine("Where x")) 0)) (CodeTokenKind.keyword()))
        c.eqInt("a quoted value is text" (ScriptEditorTest.kindAt(ql 40)) (CodeTokenKind.text()))
        c.eqInt("-- is a comment" (ScriptEditorTest.kindAt(ql 48)) (CodeTokenKind.comment()))

        def fbs:CLikeLanguage (CLikeLanguage.flatbuffers())
        c.ok("a .fbs is a FlatBuffers schema" (fbs.handlesFile("monster.fbs")))
        def fl:CodeTokenLine (fbs.tokenizeLine("table Monster { hp:short = 100; name:string; } // hero"))
        c.eqInt("table is a keyword" (ScriptEditorTest.kindAt(fl 0)) (CodeTokenKind.keyword()))
        c.eqInt("Monster is a name" (ScriptEditorTest.kindAt(fl 6)) (CodeTokenKind.ident()))
        c.eqInt("short is a type" (ScriptEditorTest.kindAt(fl 19)) (CodeTokenKind.builtin()))
        c.eqInt("100 is a number" (ScriptEditorTest.kindAt(fl 27)) (CodeTokenKind.number()))
        c.eqInt("string is a type" (ScriptEditorTest.kindAt(fl 37)) (CodeTokenKind.builtin()))
        c.eqInt("and the comment is one" (ScriptEditorTest.kindAt(fl 47)) (CodeTokenKind.comment()))
        def rt:CodeTokenLine (fbs.tokenizeLine("root_type Monster;"))
        c.eqInt("root_type is a keyword" (ScriptEditorTest.kindAt(rt 0)) (CodeTokenKind.keyword()))

        def py:CLikeLanguage (CLikeLanguage.python())
        def pyl:[CodeTokenLine] (py.tokenize(([] _:string ( "def f(x):  # note" "    \"\"\"doc" "    still doc\"\"\" ; return x" ))))
        def py0:CodeTokenLine (itemAt pyl 0)
        c.eqInt("Python: def is a keyword" (ScriptEditorTest.kindAt(py0 0)) (CodeTokenKind.keyword()))
        c.eqInt("and # is a comment" (ScriptEditorTest.kindAt(py0 11)) (CodeTokenKind.comment()))
        def py2:CodeTokenLine (itemAt pyl 2)
        c.eqInt("a docstring carries over a line" (ScriptEditorTest.kindAt(py2 0)) (CodeTokenKind.text()))
        c.eqInt("and code resumes after it" (ScriptEditorTest.kindAt(py2 19)) (CodeTokenKind.keyword()))

        def rs:CLikeLanguage (CLikeLanguage.rust())
        def rl:CodeTokenLine (rs.tokenizeLine("fn f<'a>(s: &'a str) -> char { 'x' }"))
        c.eqInt("Rust: a lifetime is not a string" (ScriptEditorTest.kindAt(rl 5)) (CodeTokenKind.attr()))
        c.eqInt("str is a type" (ScriptEditorTest.kindAt(rl 16)) (CodeTokenKind.builtin()))
        c.eqInt("but 'x' is a char" (ScriptEditorTest.kindAt(rl 31)) (CodeTokenKind.text()))

        def sh:CLikeLanguage (CLikeLanguage.shell())
        def shl:CodeTokenLine (sh.tokenizeLine("echo ${#list[@]} # count"))
        c.eqInt("shell: a # inside ${} is not a comment" (ScriptEditorTest.kindAt(shl 7)) (CodeTokenKind.punct()))
        c.eqInt("but one after a space is" (ScriptEditorTest.kindAt(shl 17)) (CodeTokenKind.comment()))

        def creg:LanguageRegistry (new LanguageRegistry)
        creg.add(js)
        CLikeLanguage.addAllTo(creg)
        def pc:EditorLanguage (creg.forFile("engine.cc"))
        c.eqStr("the registry finds C++" (pc.id()) "cpp")
        def pq:EditorLanguage (creg.forFile("q.SQL"))
        c.eqStr("and SQL, whatever the case" (pq.id()) "sql")
        def pf:EditorLanguage (creg.forFile("schema/monster.fbs"))
        c.eqStr("and FlatBuffers" (pf.id()) "flatbuffers")
        def pp:EditorLanguage (creg.forFile("api.proto"))
        c.eqStr("and protobuf" (pp.id()) "protobuf")
        def pg:EditorLanguage (creg.forFile("main.go"))
        c.eqStr("and Go" (pg.id()) "go")
        def pk:EditorLanguage (creg.forFile("App.kt"))
        c.eqStr("and Kotlin" (pk.id()) "kotlin")
        def pcs:EditorLanguage (creg.forFile("App.cs"))
        c.eqStr("and C#" (pcs.id()) "csharp")
        def pj:EditorLanguage (creg.forFile("App.java"))
        c.eqStr("and Java" (pj.id()) "java")
        def pt:EditorLanguage (creg.forFile("app.tsx"))
        c.eqStr("and still JavaScript for a .tsx" (pt.id()) "javascript")

        def ce:ScriptEditor (new ScriptEditor)
        ce.setLanguage((CLikeLanguage.cpp()))
        ce.init("// header\nint x = 1;\n")
        ce.ensureTokens()
        def ce1:CodeTokenLine (ce.tokensFor(1))
        c.eqInt("and the editor paints with it" (ScriptEditorTest.kindAt(ce1 0)) (CodeTokenKind.builtin()))
        c.eqInt("with no problems reported" (ce.problemCount()) 0)

        print ""
        print ("passed " + (to_string c.passed) + ", failed " + (to_string c.failed))
        if (c.failed > 0) {
            print "FAILED"
            return
        }
        print "OK"
    }
}

; ==============================================================================
; GridEditTest - editing semantics for the DataGrid workbook editor.
;
; Covers what the viewer tests do not: formula-aware undo/redo, transactional
; (one Ctrl+Z per action) paste / fill / delete, Excel-style copy that carries
; formulas, cut, caret editing inside the cell buffer, and row resize.
; ==============================================================================

Import "../src/GridApp.rgr"

class EditChecker {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        this.ok((name + " (got '" + got + "' want '" + want + "')") (got == want))
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }
}

class GridEditTest {
    ; Every control has to be INSIDE its own panel. This is the invariant a
    ; fixed 92-pixel button row broke: four buttons in a 340-wide dialog were
    ; laid out from the right edge until the first one landed at x = -66,
    ; hanging off the panel and over the sheet behind it. Checking the geometry
    ; rather than the picture is what makes that a test.
    sfn firstEscapee:string (wnd:EVGWindow) {
        def i:int 0
        while (i < (array_length wnd.controls)) {
            def c:EVGControl (itemAt wnd.controls i)
            def why:string ""
            if (c.x < 0) {
                why = "x < 0"
            }
            if (c.y < 0) {
                why = "y < 0"
            }
            if ((c.x + c.w) > wnd.w) {
                why = "runs past the right edge"
            }
            if ((c.y + c.h) > wnd.h) {
                why = "runs past the bottom"
            }
            if ((strlen why) > 0) {
                return ((("'" + c.text) + "' ") + why + " (x=" + (to_string c.x) + " w=" + (to_string c.w) + " y=" + (to_string c.y) + " h=" + (to_string c.h) + " panel " + (to_string wnd.w) + "x" + (to_string wnd.h) + ")")
            }
            i = (i + 1)
        }
        return ""
    }

    ; Where a given run of text landed, out of a built display list. Reading
    ; the picture back is the only way to check that two cells sit on the same
    ; line without re-deriving the layout in the test.
    ; The LAST one: the text being edited appears twice, once in the formula
    ; bar at the top of the window and once in the cell, and it is the cell
    ; that is in question here.
    sfn textY:int (dl:EVGDisplayList text:string) {
        def found:int -1
        def i:int 0
        while (i < (dl.count())) {
            def cmd:EVGDrawCmd (dl.at(i))
            if (cmd.kind == 3) {
                if (cmd.text == text) {
                    found = (to_int cmd.y)
                }
            }
            i = (i + 1)
        }
        return found
    }

    sfn select:void (app:GridApp r:int c:int) {
        app.sel.anchor.row = r
        app.sel.anchor.col = c
        app.sel.active.row = r
        app.sel.active.col = c
    }

    sfn selectRange:void (app:GridApp r0:int c0:int r1:int c1:int) {
        app.sel.anchor.row = r0
        app.sel.anchor.col = c0
        app.sel.active.row = r1
        app.sel.active.col = c1
    }

    ; One key press through the real UIInput path, with modifiers.
    sfn pressKey:void (app:GridApp input:UIInput key:int shift:boolean ctrl:boolean) {
        input.newFrame()
        input.setModifiers(shift ctrl)
        input.pushKey(key)
        app.update(input)
        input.newFrame()
        input.setModifiers(false false)
    }

    sfn hasSub:boolean (hay:string needle:string) {
        def n:int (strlen hay)
        def m:int (strlen needle)
        if (m == 0) {
            return true
        }
        def i:int 0
        while (i <= (n - m)) {
            if ((substring hay i (i + m)) == needle) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn countOf:int (hay:string needle:string) {
        def n:int (strlen hay)
        def m:int (strlen needle)
        if (m == 0) {
            return 0
        }
        def count:int 0
        def i:int 0
        while (i <= (n - m)) {
            if ((substring hay i (i + m)) == needle) {
                count = (count + 1)
                i = (i + m)
            } {
                i = (i + 1)
            }
        }
        return count
    }

    sfn beginsWith:boolean (hay:string prefix:string) {
        def m:int (strlen prefix)
        if ((strlen hay) < m) {
            return false
        }
        return ((substring hay 0 m) == prefix)
    }

    sfn finishesWith:boolean (hay:string suffix:string) {
        def n:int (strlen hay)
        def m:int (strlen suffix)
        if (n < m) {
            return false
        }
        return ((substring hay (n - m) n) == suffix)
    }

    sfn typeInto:void (app:GridApp r:int c:int text:string) {
        GridEditTest.select(app r c)
        app.beginEdit(text true)
        app.commitEdit()
    }

    sfn main:void () {
        def c:EditChecker (new EditChecker)
        def app:GridApp (new GridApp)
        app.init("gallery/pdf_writer/assets/fonts")

        print "== formula edit keeps working after the first edit =="
        GridEditTest.typeInto(app 20 0 "10")
        GridEditTest.typeInto(app 20 1 "=A21*2")
        c.eqStr("B21 formula" (app.model.getFormula(20 1)) "A21*2")
        c.eqStr("B21 value" (app.model.getCell(20 1)) "20")
        ; The dependency graph must survive an edit: re-attaching the engine per
        ; edit used to wipe usedBy, so this second edit silently stopped
        ; propagating to B21.
        GridEditTest.typeInto(app 20 0 "30")
        c.eqStr("B21 recalculated" (app.model.getCell(20 1)) "60")

        print "== undo / redo restores the formula, not just the value =="
        GridEditTest.typeInto(app 20 1 "99")
        c.eqStr("B21 overwritten" (app.model.getCell(20 1)) "99")
        c.ok("formula gone" ((app.model.hasFormula(20 1)) == false))
        app.undoEdit()
        c.eqStr("undo brings formula back" (app.model.getFormula(20 1)) "A21*2")
        c.eqStr("undo recalculates" (app.model.getCell(20 1)) "60")
        app.redoEdit()
        c.eqStr("redo re-applies value" (app.model.getCell(20 1)) "99")
        c.ok("redo drops formula" ((app.model.hasFormula(20 1)) == false))
        app.undoEdit()
        c.eqStr("undo again" (app.model.getFormula(20 1)) "A21*2")

        print "== delete clears the formula and recalculates dependents =="
        GridEditTest.typeInto(app 22 0 "4")
        GridEditTest.typeInto(app 22 1 "=A23+1")
        c.eqStr("B23 value" (app.model.getCell(22 1)) "5")
        GridEditTest.select(app 22 1)
        app.clearSelection()
        c.ok("B23 formula cleared" ((app.model.hasFormula(22 1)) == false))
        c.eqStr("B23 value cleared" (app.model.getCell(22 1)) "")
        app.undoEdit()
        c.eqStr("delete undone" (app.model.getFormula(22 1)) "A23+1")
        c.eqStr("delete undo recalcs" (app.model.getCell(22 1)) "5")

        print "== copy / paste translates relative refs =="
        GridEditTest.typeInto(app 29 0 "5")
        GridEditTest.typeInto(app 30 0 "7")
        GridEditTest.typeInto(app 29 1 "=A30*3")
        c.eqStr("B30 value" (app.model.getCell(29 1)) "15")
        GridEditTest.select(app 29 1)
        app.copySelection()
        GridEditTest.select(app 30 1)
        app.pasteClipboard()
        c.eqStr("pasted formula translated" (app.model.getFormula(30 1)) "A31*3")
        c.eqStr("pasted formula value" (app.model.getCell(30 1)) "21")

        print "== paste is one undoable action =="
        GridEditTest.typeInto(app 35 0 "a")
        GridEditTest.typeInto(app 35 1 "b")
        GridEditTest.typeInto(app 36 0 "c")
        GridEditTest.typeInto(app 36 1 "d")
        GridEditTest.selectRange(app 35 0 36 1)
        app.copySelection()
        c.eqInt("clip rows" app.clipRows 2)
        c.eqInt("clip cols" app.clipCols 2)
        GridEditTest.select(app 40 0)
        app.pasteClipboard()
        c.eqStr("paste A41" (app.model.getCell(40 0)) "a")
        c.eqStr("paste B42" (app.model.getCell(41 1)) "d")
        app.undoEdit()
        c.eqStr("one undo clears A41" (app.model.getCell(40 0)) "")
        c.eqStr("one undo clears B41" (app.model.getCell(40 1)) "")
        c.eqStr("one undo clears A42" (app.model.getCell(41 0)) "")
        c.eqStr("one undo clears B42" (app.model.getCell(41 1)) "")
        app.redoEdit()
        c.eqStr("one redo restores A41" (app.model.getCell(40 0)) "a")
        c.eqStr("one redo restores B42" (app.model.getCell(41 1)) "d")

        print "== cut =="
        GridEditTest.selectRange(app 35 0 36 1)
        app.cutSelection()
        c.ok("cut kept clipboard" ((strlen app.clipboardTsv) > 0))
        c.eqStr("cut cleared A36" (app.model.getCell(35 0)) "")
        c.eqStr("cut cleared B37" (app.model.getCell(36 1)) "")
        app.undoEdit()
        c.eqStr("cut undone A36" (app.model.getCell(35 0)) "a")
        c.eqStr("cut undone B37" (app.model.getCell(36 1)) "d")

        print "== cut moves formulas without translating refs =="
        GridEditTest.typeInto(app 55 0 "6")
        GridEditTest.typeInto(app 55 1 "=A56*2")
        c.eqStr("B56 value" (app.model.getCell(55 1)) "12")
        GridEditTest.select(app 55 1)
        app.cutSelection()
        GridEditTest.select(app 56 1)
        app.pasteClipboard()
        c.eqStr("cut keeps refs" (app.model.getFormula(56 1)) "A56*2")
        c.eqStr("cut paste value" (app.model.getCell(56 1)) "12")

        print "== fill is one undoable action =="
        GridEditTest.typeInto(app 45 0 "1")
        GridEditTest.typeInto(app 45 1 "=A46+1")
        GridEditTest.selectRange(app 45 1 47 1)
        app.fillR0 = 45
        app.fillC0 = 1
        app.fillR1 = 45
        app.fillC1 = 1
        app.fillFromSource()
        c.eqStr("fill B47 formula" (app.model.getFormula(46 1)) "A47+1")
        c.eqStr("fill B48 formula" (app.model.getFormula(47 1)) "A48+1")
        app.undoEdit()
        c.ok("one undo clears B47" ((app.model.hasFormula(46 1)) == false))
        c.ok("one undo clears B48" ((app.model.hasFormula(47 1)) == false))

        print "== caret editing inside the cell buffer =="
        GridEditTest.select(app 50 0)
        app.beginEdit("hello" true)
        c.eqInt("caret at end" app.editCaret 5)
        app.moveCaret(-2)
        c.eqInt("caret moved" app.editCaret 3)
        app.insertAtCaret("X")
        c.eqStr("insert mid" app.editBuf "helXlo")
        c.eqInt("caret after insert" app.editCaret 4)
        app.backspaceAtCaret()
        c.eqStr("backspace mid" app.editBuf "hello")
        c.eqInt("caret after backspace" app.editCaret 3)
        app.deleteAtCaret()
        c.eqStr("delete forward" app.editBuf "helo")
        c.eqInt("caret stays" app.editCaret 3)
        app.moveCaret(-99)
        c.eqInt("caret clamps low" app.editCaret 0)
        app.moveCaret(99)
        c.eqInt("caret clamps high" app.editCaret 4)
        app.cancelEdit()

        print "== formula bar is an editable field =="
        ; The bar used to look like a static label: clicking it did start an
        ; edit, but nothing on the chrome said so, and a miss on the toolbar
        ; could also land in the same hit. The bar alone starts a bar edit.
        def fbApp:GridApp (new GridApp)
        fbApp.init("gallery/pdf_writer/assets/fonts")
        fbApp.model.setCellRaw(0 0 "10")
        fbApp.model.setFormula(1 0 "A1*2")
        fbApp.engine.rebuildAll()
        GridEditTest.select(fbApp 1 0)
        c.eqStr("bar shows the formula" (fbApp.model.formulaBarText(1 0)) "=A1*2")
        def fbY:int (fbApp.grid.formulaBarY())
        def fbHit:CellPos (fbApp.grid.hitTest(fbApp.model (fbApp.grid.x + 80) (fbY + 10)))
        c.eqInt("formula bar hit row sentinel" fbHit.row -3)
        c.eqInt("formula bar hit col sentinel" fbHit.col -3)
        def toolMiss:CellPos (fbApp.grid.hitTest(fbApp.model (fbApp.grid.x + 80) (fbApp.grid.y + 4)))
        c.eqInt("toolbar chrome is not a formula-bar hit" toolMiss.row -1)
        def fbIn (new UIInput)
        fbIn.newFrame()
        ; Click near the end of the formula field so the caret lands after the
        ; existing text (click-to-position), then append.
        fbIn.setPointerPos((fbApp.grid.x + 280) (fbY + 10))
        fbIn.setPointerDown(true)
        fbApp.update(fbIn)
        c.ok("clicking the bar starts editing" fbApp.editing)
        c.ok("and focuses the bar" fbApp.editInFormulaBar)
        c.eqStr("with the formula in the buffer" fbApp.editBuf "=A1*2")
        fbApp.editCaret = (strlen fbApp.editBuf)
        fbApp.insertAtCaret("+1")
        c.eqStr("typing goes into the bar buffer" fbApp.editBuf "=A1*2+1")
        fbApp.commitEdit()
        c.eqStr("commit writes the formula" (fbApp.model.getFormula(1 0)) "A1*2+1")
        c.eqStr("and recalculates" (fbApp.model.getDisplay(1 0)) "21")
        c.ok("bar focus clears after commit" (fbApp.editInFormulaBar == false))

        print "== point-and-click a range into a formula =="
        def pk:GridApp (new GridApp)
        pk.init("gallery/pdf_writer/assets/fonts")
        pk.model.clearSheet()
        pk.model.resize(10 6)
        pk.model.setCellRaw(0 0 "10")
        pk.model.setCellRaw(1 0 "20")
        pk.model.setCellRaw(2 0 "30")
        pk.sheetView.markDirty()
        pk.sheetView.rebuild()
        pk.engine.rebuildAll()
        GridEditTest.select(pk 4 1)
        pk.beginEdit("=SUM(" true)
        c.ok("editing a formula" (pk.isFormulaEdit()))
        def a1:GridRect (pk.grid.cellRect(pk.model 0 0))
        def a3:GridRect (pk.grid.cellRect(pk.model 2 0))
        def pki:UIInput (new UIInput)
        pki.newFrame()
        pki.setPointerPos((a1.x + 4) (a1.y + 4))
        pki.setPointerDown(true)
        pk.update(pki)
        c.eqStr("click inserts A1" pk.editBuf "=SUM(A1")
        c.ok("still editing the original cell" pk.editing)
        c.eqInt("edit cell unchanged" pk.sel.active.row 4)
        c.eqInt("edit col unchanged" pk.sel.active.col 1)
        pki.newFrame()
        pki.setPointerPos((a3.x + 4) (a3.y + 4))
        pki.setPointerDown(true)
        pk.update(pki)
        c.eqStr("drag extends to A1:A3" pk.editBuf "=SUM(A1:A3")
        c.ok("ghost shows the pick" pk.view.ghostVisible)
        pki.newFrame()
        pki.setPointerPos((a3.x + 4) (a3.y + 4))
        pki.setPointerDown(false)
        pk.update(pki)
        c.eqStr("release keeps the range" pk.editBuf "=SUM(A1:A3")
        pk.insertAtCaret(")")
        pk.refreshFormulaHilites()
        c.eqInt("edit hilite count" (array_length pk.view.formulaHiliteR0) 1)
        c.eqInt("edit hilite r0" (itemAt pk.view.formulaHiliteR0 0) 0)
        c.eqInt("edit hilite c0" (itemAt pk.view.formulaHiliteC0 0) 0)
        c.eqInt("edit hilite r1" (itemAt pk.view.formulaHiliteR1 0) 2)
        c.eqInt("edit hilite c1" (itemAt pk.view.formulaHiliteC1 0) 0)
        pk.commitEdit()
        c.eqStr("committed formula" (pk.model.getFormula(4 1)) "SUM(A1:A3)")
        c.eqStr("and the sum" (pk.model.getCell(4 1)) "60")
        GridEditTest.select(pk 4 1)
        pk.refreshFormulaHilites()
        c.eqInt("select hilite count" (array_length pk.view.formulaHiliteR0) 1)
        c.eqInt("select hilite r0" (itemAt pk.view.formulaHiliteR0 0) 0)
        c.eqInt("select hilite r1" (itemAt pk.view.formulaHiliteR1 0) 2)
        pk.model.setFormula(5 1 "A1+C2")
        pk.sheetView.markDirty()
        pk.sheetView.rebuild()
        pk.engine.rebuildAll()
        GridEditTest.select(pk 5 1)
        pk.refreshFormulaHilites()
        c.eqInt("two single-cell hilites" (array_length pk.view.formulaHiliteR0) 2)
        c.eqInt("first ref row" (itemAt pk.view.formulaHiliteR0 0) 0)
        c.eqInt("first ref col" (itemAt pk.view.formulaHiliteC0 0) 0)
        c.eqInt("second ref row" (itemAt pk.view.formulaHiliteR0 1) 1)
        c.eqInt("second ref col" (itemAt pk.view.formulaHiliteC0 1) 2)
        GridEditTest.select(pk 0 0)
        pk.refreshFormulaHilites()
        c.eqInt("plain cell clears hilites" (array_length pk.view.formulaHiliteR0) 0)
        pk.beginEdit("=SUM(A1:A3" true)
        pk.refreshFormulaHilites()
        c.eqInt("unclosed paren still hilites" (array_length pk.view.formulaHiliteR0) 1)
        pk.cancelEdit()
        ; Stronger overlays + formula-bar chrome must show up in the scene the
        ; host paints — a faint fill was easy to miss on white cells.
        GridEditTest.select(pk 4 1)
        pk.beginEdit("=SUM(A1:A3)" true)
        def hiliteScene:string (pk.sceneJson())
        c.ok("scene carries a yellow formula fill" (GridEditTest.hasSub(hiliteScene "0.38")))
        c.ok("and a formula-range border" (GridEditTest.hasSub(hiliteScene "\"t\":2.00")))
        pk.cancelEdit()

        print "== formula bar caret click + range resize =="
        def fb2:GridApp (new GridApp)
        fb2.init("gallery/pdf_writer/assets/fonts")
        fb2.model.clearSheet()
        fb2.model.resize(12 6)
        fb2.model.setCellRaw(0 0 "1")
        fb2.model.setCellRaw(1 0 "2")
        fb2.model.setCellRaw(2 0 "3")
        fb2.model.setCellRaw(3 0 "4")
        fb2.model.setFormula(5 1 "SUM(A1:A3)")
        fb2.sheetView.markDirty()
        fb2.sheetView.rebuild()
        fb2.engine.rebuildAll()
        GridEditTest.select(fb2 4 1)
        fb2.refreshFormulaHilites()
        c.eqInt("blank cell has no stale range" (array_length fb2.view.formulaHiliteR0) 0)
        fb2.moveActive(5 1 false)
        c.eqInt("moving onto formula shows range immediately" (array_length fb2.view.formulaHiliteR0) 1)
        GridEditTest.select(fb2 5 1)
        fb2.refreshFormulaHilites()
        c.eqInt("selected formula shows range" (array_length fb2.view.formulaHiliteR0) 1)
        c.eqInt("range ends at A3" (itemAt fb2.view.formulaHiliteR1 0) 2)
        ; Click the formula field near the start of the text → caret not at end.
        fb2.render()
        def fbx:int (fb2.view.fbTextX + 12)
        def fby:int (fb2.view.fbFieldY + 6)
        def fbi:UIInput (new UIInput)
        fbi.newFrame()
        fbi.setPointerPos(fbx fby)
        fbi.setPointerDown(true)
        fb2.update(fbi)
        c.ok("bar edit started" fb2.editing)
        c.ok("bar owns the caret" fb2.editInFormulaBar)
        c.ok("caret not forced to end" (fb2.editCaret < (strlen fb2.editBuf)))
        fb2.sceneJson()
        c.ok("explicit bar edit paints caret in bar" fb2.view.caretInFormulaBar)
        fbi.newFrame()
        fbi.setPointerDown(false)
        fb2.update(fbi)
        fbi.newFrame()
        fbi.pushKey((UIKey.right()))
        fb2.update(fbi)
        def afterRight:int fb2.editCaret
        fbi.newFrame()
        fbi.pushKey((UIKey.left()))
        fb2.update(fbi)
        c.eqInt("left undoes right" fb2.editCaret (afterRight - 1))
        ; Drag the bottom handle of A1:A3 down to A4.
        fb2.cancelEdit()
        GridEditTest.select(fb2 5 1)
        fb2.refreshFormulaHilites()
        def htl:GridRect (fb2.grid.cellRect(fb2.model 0 0))
        def hbr:GridRect (fb2.grid.cellRect(fb2.model 2 0))
        def hx:int htl.x
        def hy:int htl.y
        def hw:int ((hbr.x + hbr.w) - htl.x)
        def hh:int ((hbr.y + hbr.h) - htl.y)
        def hs:int 10
        def gripX:int ((hx + (idiv hw 2)))
        def gripY:int (hy + hh)
        c.eqInt("whole bottom border is a resize target" (fb2.hitFormulaRangeHandle((hx + 10) gripY)) 1)
        def a4:GridRect (fb2.grid.cellRect(fb2.model 3 0))
        fbi.newFrame()
        fbi.setPointerPos(gripX gripY)
        fbi.setPointerDown(true)
        fb2.update(fbi)
        c.ok("range drag starts an edit" fb2.editing)
        c.ok("and is dragging the formula range" fb2.formulaRangeDrag)
        fbi.newFrame()
        fbi.setPointerPos((a4.x + 4) (a4.y + 4))
        fbi.setPointerDown(true)
        fb2.update(fbi)
        c.ok("buffer grew to A1:A4" (GridEditTest.hasSub(fb2.editBuf "A1:A4")))
        fbi.newFrame()
        fbi.setPointerDown(false)
        fb2.update(fbi)
        c.ok("release ends the range drag" (fb2.formulaRangeDrag == false))
        c.ok("range drag commits when it opened editing" (fb2.editing == false))
        c.eqStr("release writes SUM(A1:A4)" (fb2.model.getFormula(5 1)) "SUM(A1:A4)")
        ; Entering formula edit from the cell still paints its only caret in
        ; the top formula editor, not offset over the cell text.
        fb2.beginEdit("" false)
        fb2.editCaret = 5
        fb2.editInFormulaBar = false
        fb2.sceneJson()
        c.ok("cell-started formula edit paints caret in bar" fb2.view.caretInFormulaBar)
        fb2.cancelEdit()

        print "== formula range all-side resize + horizontal move =="
        def frg:GridApp (new GridApp)
        frg.init("gallery/pdf_writer/assets/fonts")
        frg.model.clearSheet()
        frg.model.resize(12 8)
        frg.model.setFormula(6 5 "SUM(B2:C4)")
        frg.sheetView.markDirty()
        frg.sheetView.rebuild()
        frg.engine.rebuildAll()
        GridEditTest.select(frg 6 5)
        frg.refreshFormulaHilites()
        def b2:GridRect (frg.grid.cellRect(frg.model 1 1))
        def c4:GridRect (frg.grid.cellRect(frg.model 3 2))
        def rangeLeft:int b2.x
        def rangeTop:int b2.y
        def rangeRight:int (c4.x + c4.w)
        def rangeBottom:int (c4.y + c4.h)
        c.eqInt("top border resizes" (frg.hitFormulaRangeHandle((rangeLeft + 20) rangeTop)) 3)
        c.eqInt("left border resizes" (frg.hitFormulaRangeHandle(rangeLeft (rangeTop + 20))) 4)
        c.eqInt("range interior moves horizontally" (frg.hitFormulaRangeHandle((rangeLeft + 20) (rangeTop + 20))) 5)
        frg.formulaRangeIdx = 0
        frg.beginFormulaRangeDrag(3 1)
        frg.updateFormulaRangeDragAt(0 1)
        c.ok("top drag expands to B1" (GridEditTest.hasSub(frg.editBuf "B1:C4")))
        frg.commitEdit()
        frg.model.setFormula(6 5 "SUM(B2:C4)")
        frg.refreshFormulaHilites()
        frg.formulaRangeIdx = 0
        frg.beginFormulaRangeDrag(4 1)
        frg.updateFormulaRangeDragAt(1 0)
        c.ok("left drag expands to A2" (GridEditTest.hasSub(frg.editBuf "A2:C4")))
        frg.commitEdit()
        frg.model.setFormula(6 5 "SUM(B2:C4)")
        frg.refreshFormulaHilites()
        frg.formulaRangeIdx = 0
        frg.beginFormulaRangeDrag(5 1)
        frg.updateFormulaRangeDragAt(1 3)
        c.ok("horizontal move preserves size" (GridEditTest.hasSub(frg.editBuf "D2:E4")))
        frg.commitEdit()
        c.eqStr("horizontal move writes formula" (frg.model.getFormula(6 5)) "SUM(D2:E4)")

        print "== column headers select only populated cells =="
        def cols:GridApp (new GridApp)
        cols.init("gallery/pdf_writer/assets/fonts")
        cols.model.clearSheet()
        cols.model.resize(20 5)
        cols.model.setCellRaw(0 0 "Category")
        cols.model.setCellRaw(1 0 "Q1")
        cols.model.setCellRaw(2 0 "Q2")
        cols.model.setCellRaw(3 0 "Q3")
        cols.model.setCellRaw(0 2 "Revenue")
        cols.model.setCellRaw(1 2 "10")
        cols.model.setCellRaw(2 2 "20")
        cols.model.setCellRaw(3 2 "30")
        cols.sheetView.markDirty()
        cols.sheetView.rebuild()
        cols.grid.updateVisible(cols.model)
        def chi:UIInput (new UIInput)
        def ah:GridRect (cols.grid.cellRect(cols.model 0 0))
        def ch:GridRect (cols.grid.cellRect(cols.model 0 2))
        def headerY:int ((cols.grid.headerTop()) + 5)
        chi.newFrame()
        chi.setPointerPos((ah.x + 10) headerY)
        chi.setPointerDown(true)
        cols.update(chi)
        c.eqInt("header click selects one column" (cols.sel.rangeCount()) 1)
        def ag:GridRange (cols.sel.liveRange())
        c.eqInt("column selection starts at header row" ag.r0 0)
        c.eqInt("column selection stops at last value" ag.r1 3)
        chi.newFrame()
        chi.setPointerDown(false)
        cols.update(chi)
        chi.newFrame()
        chi.setModifiers(false true)
        chi.setPointerPos((ch.x + 10) headerY)
        chi.setPointerDown(true)
        cols.update(chi)
        c.eqInt("Ctrl+header keeps both columns" (cols.sel.rangeCount()) 2)
        def keptCol:GridRange (cols.sel.rangeAt(0))
        def liveCol:GridRange (cols.sel.rangeAt(1))
        c.eqInt("first selected column is A" keptCol.c0 0)
        c.eqInt("second selected column is C" liveCol.c0 2)
        c.eqInt("second also stops at its data" liveCol.r1 3)
        chi.newFrame()
        chi.setPointerDown(false)
        cols.update(chi)
        def bh:GridRect (cols.grid.cellRect(cols.model 0 1))
        chi.newFrame()
        chi.setModifiers(false false)
        chi.setPointerPos(((bh.x + bh.w) - 7) headerY)
        chi.setPointerDown(true)
        cols.update(chi)
        c.ok("column arrow opens the menu" cols.view.menuOpen)
        c.eqInt("arrow menu belongs to B" cols.view.menuCol 1)
        c.eqInt("opening menu keeps column selection" (cols.sel.rangeCount()) 2)

        print "== caret keys through UIInput =="
        def input:UIInput (new UIInput)
        GridEditTest.select(app 51 0)
        input.newFrame()
        input.pushText("abc")
        app.update(input)
        c.eqStr("typed" app.editBuf "abc")
        c.eqInt("caret 3" app.editCaret 3)
        input.newFrame()
        input.pushKey((UIKey.left()))
        app.update(input)
        c.eqInt("left key" app.editCaret 2)
        input.newFrame()
        input.pushText("Z")
        app.update(input)
        c.eqStr("insert via key path" app.editBuf "abZc")
        input.newFrame()
        input.pushKey((UIKey.home()))
        app.update(input)
        c.eqInt("home key" app.editCaret 0)
        input.newFrame()
        input.pushKey((UIKey.del()))
        app.update(input)
        c.eqStr("forward delete" app.editBuf "bZc")
        input.newFrame()
        input.pushKey((UIKey.end()))
        app.update(input)
        c.eqInt("end key" app.editCaret 3)
        input.newFrame()
        input.pushKey((UIKey.escape()))
        app.update(input)
        c.ok("escape cancels" (app.editing == false))
        c.eqStr("cell untouched" (app.model.getCell(51 0)) "")

        print "== row resize by dragging the row header edge =="
        ; Earlier edits scrolled the viewport; bring row 0 back on screen.
        app.moveActive(0 0 false)
        def beforeH:int (app.model.rowHeight(0))
        def oy:int (app.grid.gridOriginY())
        def edgeY:int (((oy + beforeH) - 1))
        def headerX:int (app.grid.x + 8)
        c.eqInt("row resize hit" (app.grid.hitRowResize(app.model headerX edgeY)) 0)
        input.newFrame()
        input.setPointerPos(headerX edgeY)
        input.setPointerDown(true)
        app.update(input)
        input.newFrame()
        input.setPointerPos(headerX (edgeY + 24))
        input.setPointerDown(true)
        app.update(input)
        input.newFrame()
        input.setPointerPos(headerX (edgeY + 24))
        input.setPointerDown(false)
        app.update(input)
        c.ok("row taller" ((app.model.rowHeight(0)) > beforeH))

        print "== Ctrl+Arrow jumps to the data edge =="
        ; Fresh sheet so the demo seed does not interfere with the block scan.
        def nav:GridApp (new GridApp)
        nav.init("gallery/pdf_writer/assets/fonts")
        nav.model.clearSheet()
        nav.model.resize(60 12)
        def bi:int 2
        while (bi <= 6) {
            nav.model.setCellRaw(bi 1 "x")
            nav.model.setCellRaw(bi 2 "y")
            bi = (bi + 1)
        }
        nav.model.setCellRaw(20 1 "far")
        def input2:UIInput (new UIInput)
        GridEditTest.select(nav 2 1)
        ; inside a run → last filled cell of the run
        GridEditTest.pressKey(nav input2 (UIKey.down()) false true)
        c.eqInt("ctrl down to block end" nav.sel.active.row 6)
        ; on the last filled cell, next is blank → next filled cell below
        GridEditTest.pressKey(nav input2 (UIKey.down()) false true)
        c.eqInt("ctrl down to next block" nav.sel.active.row 20)
        ; nothing below → sheet edge
        GridEditTest.pressKey(nav input2 (UIKey.down()) false true)
        c.eqInt("ctrl down to sheet edge" nav.sel.active.row 59)
        GridEditTest.pressKey(nav input2 (UIKey.up()) false true)
        c.eqInt("ctrl up back to data" nav.sel.active.row 20)
        GridEditTest.select(nav 2 1)
        GridEditTest.pressKey(nav input2 (UIKey.right()) false true)
        c.eqInt("ctrl right to run end" nav.sel.active.col 2)

        print "== Ctrl+Shift+Arrow extends to the data edge =="
        GridEditTest.select(nav 2 1)
        GridEditTest.pressKey(nav input2 (UIKey.down()) true true)
        c.eqInt("extended active" nav.sel.active.row 6)
        c.eqInt("anchor held" nav.sel.anchor.row 2)
        c.ok("range selected" (nav.sel.isSingle() == false))
        nav.copySelection()
        c.eqInt("copied rows" nav.clipRows 5)
        c.eqStr("copied tsv" nav.clipboardTsv "x\nx\nx\nx\nx")

        print "== PageDown / PageUp =="
        GridEditTest.select(nav 0 0)
        nav.grid.scrollY = 0
        nav.grid.updateVisible(nav.model)
        def page:int (nav.pageRows())
        c.ok("page span > 1" (page > 1))
        GridEditTest.pressKey(nav input2 (UIKey.pageDown()) false false)
        c.eqInt("page down" nav.sel.active.row page)
        GridEditTest.pressKey(nav input2 (UIKey.pageUp()) false false)
        c.eqInt("page up" nav.sel.active.row 0)
        GridEditTest.pressKey(nav input2 (UIKey.pageDown()) true false)
        c.ok("shift page extends" (nav.sel.isSingle() == false))
        c.eqInt("shift page anchor" nav.sel.anchor.row 0)

        print "== Ctrl+Home / Ctrl+End / Home / End =="
        GridEditTest.select(nav 12 5)
        GridEditTest.pressKey(nav input2 (UIKey.home()) false false)
        c.eqInt("home to col 0" nav.sel.active.col 0)
        c.eqInt("home keeps row" nav.sel.active.row 12)
        GridEditTest.pressKey(nav input2 (UIKey.home()) false true)
        c.eqInt("ctrl home row" nav.sel.active.row 0)
        c.eqInt("ctrl home col" nav.sel.active.col 0)
        GridEditTest.pressKey(nav input2 (UIKey.end()) false true)
        c.eqInt("ctrl end row" nav.sel.active.row 20)
        c.eqInt("ctrl end col" nav.sel.active.col 2)
        GridEditTest.select(nav 2 0)
        GridEditTest.pressKey(nav input2 (UIKey.end()) false false)
        c.eqInt("end to last used col in row" nav.sel.active.col 2)

        print "== Enter / Shift+Enter / Tab / Shift+Tab step between cells =="
        GridEditTest.select(nav 4 4)
        GridEditTest.pressKey(nav input2 (UIKey.enter()) false false)
        c.eqInt("enter steps down" nav.sel.active.row 5)
        GridEditTest.pressKey(nav input2 (UIKey.enter()) true false)
        c.eqInt("shift enter steps up" nav.sel.active.row 4)
        GridEditTest.pressKey(nav input2 (UIKey.tab()) false false)
        c.eqInt("tab steps right" nav.sel.active.col 5)
        GridEditTest.pressKey(nav input2 (UIKey.tab()) true false)
        c.eqInt("shift tab steps left" nav.sel.active.col 4)
        c.ok("stepping does not edit" (nav.editing == false))

        print "== F2 opens the cell for edit =="
        nav.model.setCellRaw(4 4 "keep")
        GridEditTest.select(nav 4 4)
        GridEditTest.pressKey(nav input2 (UIKey.f2()) false false)
        c.ok("f2 editing" nav.editing)
        c.eqStr("f2 keeps content" nav.editBuf "keep")
        c.eqInt("f2 caret at end" nav.editCaret 4)
        input2.newFrame()
        input2.pushKey((UIKey.escape()))
        nav.update(input2)

        print "== Ctrl+Space column, Shift+Space row =="
        GridEditTest.select(nav 3 2)
        input2.newFrame()
        input2.setModifiers(false true)
        input2.pushText(" ")
        nav.update(input2)
        input2.newFrame()
        input2.setModifiers(false false)
        c.ok("column covers first row" (nav.sel.contains(0 2)))
        c.ok("column covers last row" (nav.sel.contains((nav.model.rowCount - 1) 2)))
        c.ok("column excludes other cols" ((nav.sel.contains(0 3)) == false))
        c.eqInt("column active at top" nav.sel.active.row 0)
        c.eqInt("column pinned" nav.sel.active.col 2)
        GridEditTest.select(nav 3 2)
        input2.newFrame()
        input2.setModifiers(true false)
        input2.pushText(" ")
        nav.update(input2)
        input2.newFrame()
        input2.setModifiers(false false)
        c.ok("row covers first col" (nav.sel.contains(3 0)))
        c.ok("row covers last col" (nav.sel.contains(3 (nav.model.colCount - 1))))
        c.ok("row excludes other rows" ((nav.sel.contains(4 0)) == false))
        c.eqInt("row active at left" nav.sel.active.col 0)
        c.eqInt("row pinned" nav.sel.active.row 3)
        c.ok("shift+space did not type" (nav.editing == false))

        print "== Ctrl+C over a multi-cell selection =="
        GridEditTest.selectRange(nav 2 1 3 2)
        input2.newFrame()
        input2.setModifiers(false true)
        input2.pushText("c")
        nav.update(input2)
        input2.newFrame()
        input2.setModifiers(false false)
        nav.update(input2)
        c.eqStr("tsv block" nav.clipboardTsv "x\ty\nx\ty")

        print "== copy also produces an HTML table for Word =="
        nav.model.setCellRaw(30 0 "Region")
        nav.model.setCellRaw(30 1 "Q1 <b>")
        nav.model.setCellRaw(31 0 "North & South")
        nav.model.setCellRaw(31 1 "120")
        GridEditTest.selectRange(nav 30 0 31 1)
        nav.copySelection()
        c.ok("html non-empty" ((strlen nav.clipboardHtml) > 0))
        c.ok("html opens a table" (GridEditTest.beginsWith(nav.clipboardHtml "<table")))
        c.ok("html closes the table" (GridEditTest.finishesWith(nav.clipboardHtml "</table>")))
        c.eqInt("html rows" (GridEditTest.countOf(nav.clipboardHtml "<tr>")) 2)
        c.eqInt("html cells" (GridEditTest.countOf(nav.clipboardHtml "<td")) 4)
        c.ok("html escapes &" (GridEditTest.hasSub(nav.clipboardHtml "North &amp; South")))
        c.ok("html escapes <" (GridEditTest.hasSub(nav.clipboardHtml "Q1 &lt;b&gt;")))
        c.ok("tsv still plain" (GridEditTest.hasSub(nav.clipboardTsv "North & South")))
        ; styles.xml colours arrive as "#RRGGBB"; the CSS must not double the #.
        c.ok("no doubled hash" ((GridEditTest.hasSub(nav.clipboardHtml "##")) == false))
        c.eqStr("hash form kept" (GridApp.cssColor("#1F4E79")) "#1F4E79")
        c.eqStr("bare form gets hash" (GridApp.cssColor("1F4E79")) "#1F4E79")
        c.eqStr("junk colour dropped" (GridApp.cssColor("red")) "")
        ; A host-supplied clipboard has no table flavour to offer.
        nav.setClipboardText("a\tb")
        c.eqStr("external clears html" nav.clipboardHtml "")

        print "== the grid grows as the caret walks off the end =="
        def grow:GridApp (new GridApp)
        grow.init("gallery/pdf_writer/assets/fonts")
        grow.model.clearSheet()
        grow.model.resize(6 4)
        grow.model.setColWidth(0 137)
        grow.model.setRowHeight(0 33)
        grow.sheetView.markDirty()
        grow.sheetView.rebuild()
        c.eqInt("starts small" grow.model.rowCount 6)
        GridEditTest.select(grow 5 3)
        def growInput:UIInput (new UIInput)
        GridEditTest.pressKey(grow growInput (UIKey.down()) false false)
        c.eqInt("down past the last row moves" grow.sel.active.row 6)
        ; At least that big. A frame also keeps the sheet covering the window,
        ; so the exact number is the window's business, not this test's.
        c.ok("and the sheet grew" (grow.model.rowCount >= 7))
        GridEditTest.pressKey(grow growInput (UIKey.right()) false false)
        c.eqInt("right past the last column moves" grow.sel.active.col 4)
        c.ok("and the sheet grew" (grow.model.colCount >= 5))
        ; growTo must never wipe sizes the way resize() does.
        c.eqInt("column width kept" (grow.model.colWidth(0)) 137)
        c.eqInt("row height kept" (grow.model.rowHeight(0)) 33)
        ; A brand new cell is editable like any other.
        grow.beginEdit("new cell" true)
        grow.commitEdit()
        c.eqStr("typed into the new cell" (grow.model.getCell(6 4)) "new cell")
        ; growTo only ever grows.
        def keptRows:int grow.model.rowCount
        def keptCols:int grow.model.colCount
        grow.model.growTo(2 2)
        c.eqInt("growTo never shrinks rows" grow.model.rowCount keptRows)
        c.eqInt("growTo never shrinks cols" grow.model.colCount keptCols)
        c.ok("still renders" ((strlen (grow.sceneJson())) > 50))

        print "== paste can land outside the current extent =="
        def pasteGrow:GridApp (new GridApp)
        pasteGrow.init("gallery/pdf_writer/assets/fonts")
        pasteGrow.model.clearSheet()
        pasteGrow.model.resize(4 3)
        pasteGrow.setClipboardText("a\tb\nc\td")
        GridEditTest.select(pasteGrow 3 2)
        pasteGrow.pasteClipboard()
        c.ok("sheet grew for the paste" (pasteGrow.model.rowCount >= 5))
        c.ok("columns grew too" (pasteGrow.model.colCount >= 4))
        c.eqStr("first pasted cell" (pasteGrow.model.getCell(3 2)) "a")
        c.eqStr("cell past the old edge" (pasteGrow.model.getCell(4 3)) "d")

        print "== column resize: auto-fit, block resize, menu =="
        def rz:GridApp (new GridApp)
        rz.init("gallery/pdf_writer/assets/fonts")
        rz.model.clearSheet()
        rz.model.resize(10 6)
        rz.model.setCellRaw(0 0 "x")
        rz.model.setCellRaw(1 0 "a much longer piece of text in this column")
        rz.model.setCellRaw(2 0 "mid")
        rz.sheetView.markDirty()
        rz.sheetView.rebuild()
        def narrow:int 40
        rz.model.setColWidth(0 narrow)
        GridEditTest.select(rz 0 0)
        rz.autoFitColumn(0)
        def fitted:int (rz.model.colWidth(0))
        c.ok("auto-fit widened the column" (fitted > narrow))
        c.ok("auto-fit covers the longest cell" (fitted > (rz.view.measureText("a much longer piece of text in this column"))))
        c.ok("auto-fit stays sane" (fitted <= 600))
        ; An empty column falls back to a usable minimum, not zero.
        rz.autoFitColumn(5)
        c.ok("empty column keeps a minimum width" ((rz.model.colWidth(5)) >= 32))

        print "== resizing one of several selected columns sizes them all =="
        rz.model.setColWidth(1 100)
        rz.model.setColWidth(2 100)
        rz.model.setColWidth(3 100)
        GridEditTest.selectRange(rz 0 1 0 3)
        rz.setColumnWidths(2 155)
        c.eqInt("dragged column" (rz.model.colWidth(2)) 155)
        c.eqInt("its neighbour in the selection" (rz.model.colWidth(1)) 155)
        c.eqInt("and the other one" (rz.model.colWidth(3)) 155)
        c.eqInt("a column outside the selection is untouched" (rz.model.colWidth(4)) rz.model.defaultColW)
        ; Sizing a column outside the selection only affects that one.
        GridEditTest.selectRange(rz 0 1 0 3)
        rz.setColumnWidths(4 77)
        c.eqInt("outside column sized alone" (rz.model.colWidth(4)) 77)
        c.eqInt("selection untouched" (rz.model.colWidth(1)) 155)

        print "== header menu width actions =="
        rz.model.setColWidth(0 100)
        rz.sel.anchor.col = 0
        rz.sel.active.col = 0
        rz.openHeaderMenu(0 10 10)
        rz.runHeaderMenu(6)
        c.eqInt("menu widened" (rz.model.colWidth(0)) 120)
        rz.openHeaderMenu(0 10 10)
        rz.runHeaderMenu(7)
        c.eqInt("menu narrowed" (rz.model.colWidth(0)) 100)
        rz.openHeaderMenu(0 10 10)
        rz.runHeaderMenu(5)
        c.ok("menu auto-fit" ((rz.model.colWidth(0)) != 100))
        c.ok("menu closes after an action" (rz.view.menuOpen == false))
        rz.openHeaderMenu(0 100 100)
        def outsideMenu:UIInput (new UIInput)
        outsideMenu.newFrame()
        outsideMenu.setPointerPos(500 400)
        outsideMenu.setPointerDown(true)
        rz.update(outsideMenu)
        c.ok("outside click closes column menu" (rz.view.menuOpen == false))
        ; Width never collapses to nothing.
        def sh:int 0
        while (sh < 20) {
            rz.nudgeColumnWidth(0 -20)
            sh = (sh + 1)
        }
        c.ok("narrowing has a floor" ((rz.model.colWidth(0)) >= 24))

        print "== sorting a column reorders complete rows =="
        def sortApp:GridApp (new GridApp)
        sortApp.init("gallery/pdf_writer/assets/fonts")
        sortApp.model.clearSheet()
        sortApp.model.resize(7 4)
        sortApp.model.setCellRaw(0 0 "Name")
        sortApp.model.setCellRaw(0 1 "Value")
        sortApp.model.setCellRaw(0 2 "Note")
        sortApp.model.setCellRaw(1 0 "C")
        sortApp.model.setCellRaw(1 1 "30")
        sortApp.model.setCellRaw(1 2 "third")
        sortApp.model.setCellRaw(2 0 "A")
        sortApp.model.setCellRaw(2 1 "10")
        sortApp.model.setCellRaw(2 2 "first")
        sortApp.model.setCellRaw(3 0 "B")
        sortApp.model.setCellRaw(3 1 "20")
        sortApp.model.setCellRaw(3 2 "second")
        sortApp.sheetView.markDirty()
        sortApp.sheetView.rebuild()
        sortApp.openHeaderMenu(1 100 100)
        sortApp.runHeaderMenu(1)
        ; A sort moves the DATA, so the sheet itself is in order afterwards
        ; and the view is not permuting anything. That is the whole point:
        ; what gets saved, copied and charted is what is on screen.
        c.eqStr("the heading stays put" (sortApp.model.getCell(0 0)) "Name"
        )
        c.eqStr("smallest value first" (sortApp.model.getCell(1 1)) "10"
        )
        c.eqStr("its name came with it" (sortApp.model.getCell(1 0)) "A"
        )
        c.eqStr("and every other column of that row" (sortApp.model.getCell(1 2)) "first"
        )
        c.eqStr("then the middle one" (sortApp.model.getCell(2 1)) "20"
        )
        c.eqStr("then the largest" (sortApp.model.getCell(3 1)) "30"
        )
        c.eqStr("blank rows stay after the data" (sortApp.model.getCell(4 1)) ""
        )
        c.eqInt("and the view has nothing left to reorder" (itemAt sortApp.sheetView.rowOrder 1) 1)
        c.eqInt("the header still says which column" sortApp.model.sortedCol 1)
        c.ok("and which way" sortApp.model.sortedAsc)
        ; One Ctrl+Z is one sort.
        sortApp.undoEdit()
        c.eqStr("undo puts the rows back" (sortApp.model.getCell(1 1)) "30"
        )
        c.eqStr("all of them" (sortApp.model.getCell(3 1)) "20"
        )
        sortApp.redoEdit()
        c.eqStr("redo sorts again" (sortApp.model.getCell(1 1)) "10"
        )
        sortApp.applySort(1 false)
        c.eqStr("descending puts the largest first" (sortApp.model.getCell(1 1)) "30"
        )
        c.eqStr("with its row intact" (sortApp.model.getCell(1 2)) "third"
        )
        c.ok("and the header says so" (sortApp.model.sortedAsc == false))

        print "== double-click a header auto-fits =="
        def dz:GridApp (new GridApp)
        dz.init("gallery/pdf_writer/assets/fonts")
        dz.model.clearSheet()
        dz.model.resize(6 4)
        dz.model.setCellRaw(0 0 "a very wide heading value here")
        dz.sheetView.markDirty()
        dz.sheetView.rebuild()
        dz.model.setColWidth(0 45)
        dz.grid.updateVisible(dz.model)
        def hdrY:int ((dz.grid.headerTop()) + 8)
        def hdrX:int ((dz.grid.gridOriginX()) + 10)
        c.ok("double-click on the header hits" (dz.autoFitAt(hdrX hdrY)))
        c.ok("and widened it" ((dz.model.colWidth(0)) > 45))
        c.ok("double-click off the header does nothing" ((dz.autoFitAt(2 2)) == false))
        ; Also on the edge itself.
        dz.model.setColWidth(0 45)
        dz.grid.updateVisible(dz.model)
        def edge2:int (((dz.grid.gridOriginX()) + (dz.model.colToX(0)) + 45) - 1)
        c.ok("double-click on the edge hits" (dz.autoFitAt(edge2 hdrY)))
        c.ok("edge auto-fit widened it" ((dz.model.colWidth(0)) > 45))
        c.ok("still renders" ((strlen (dz.sceneJson())) > 50))

        print "== copy / paste keeps formatting by default =="
        def fmtApp:GridApp (new GridApp)
        fmtApp.init("gallery/pdf_writer/assets/fonts")
        c.ok("load styles-showcase" (fmtApp.loadXlsx("gallery/datagrid/fixtures/styles-showcase.xlsx")))
        def fm:SpreadsheetModel fmtApp.model
        ; B3 is an empty cell carrying only a fill; B5 carries a thin red box.
        def srcFill:CellStyle (fm.getCellStyle(2 1))
        c.ok("source has a fill" srcFill.hasFill)
        GridEditTest.select(fmtApp 2 1)
        fmtApp.copySelection()
        GridEditTest.select(fmtApp 25 1)
        fmtApp.pasteClipboard()
        def gotFill:CellStyle (fm.getCellStyle(25 1))
        c.ok("pasted cell has the fill" gotFill.hasFill)
        c.eqStr("same fill colour" gotFill.fillRgb srcFill.fillRgb)
        ; Borders travel too.
        def srcBorder:CellStyle (fm.getCellStyle(4 1))
        c.ok("source has a border" srcBorder.hasBorder)
        GridEditTest.select(fmtApp 4 1)
        fmtApp.copySelection()
        GridEditTest.select(fmtApp 26 1)
        fmtApp.pasteClipboard()
        def gotBorder:CellStyle (fm.getCellStyle(26 1))
        c.ok("pasted cell has the border" gotBorder.hasBorder)
        c.eqStr("same edge style" gotBorder.borderTop.style srcBorder.borderTop.style)
        c.eqStr("same edge colour" gotBorder.borderTop.rgb srcBorder.borderTop.rgb)
        c.eqStr("value came too" (fm.getCell(26 1)) (fm.getCell(4 1)))
        ; Font attributes and number format ride along.
        def srcBold:CellStyle (fm.getCellStyle(14 1))
        c.ok("source is bold" srcBold.bold)
        GridEditTest.select(fmtApp 14 1)
        fmtApp.copySelection()
        GridEditTest.select(fmtApp 27 1)
        fmtApp.pasteClipboard()
        def gotBold:CellStyle (fm.getCellStyle(27 1))
        c.ok("pasted cell is bold" gotBold.bold)
        def srcMoney:CellStyle (fm.getCellStyle(18 3))
        GridEditTest.select(fmtApp 18 3)
        fmtApp.copySelection()
        GridEditTest.select(fmtApp 28 3)
        fmtApp.pasteClipboard()
        def gotMoney:CellStyle (fm.getCellStyle(28 3))
        c.eqStr("number format travels" gotMoney.numFmt srcMoney.numFmt)
        c.eqStr("and renders the same" (fm.getDisplay(28 3)) (fm.getDisplay(18 3)))

        print "== one undo restores the previous formatting =="
        def beforeStyleId:int (fm.getCellStyleId(29 1))
        GridEditTest.select(fmtApp 4 1)
        fmtApp.copySelection()
        GridEditTest.select(fmtApp 29 1)
        fmtApp.pasteClipboard()
        c.ok("formatting applied" ((fm.getCellStyle(29 1)).hasBorder))
        fmtApp.undoEdit()
        c.eqInt("style id restored by undo" (fm.getCellStyleId(29 1)) beforeStyleId)
        c.ok("no border after undo" (((fm.getCellStyle(29 1)).hasBorder) == false))
        fmtApp.redoEdit()
        c.ok("redo puts it back" ((fm.getCellStyle(29 1)).hasBorder))

        print "== paste modes =="
        ; values only: no formatting, no formula
        GridEditTest.select(fmtApp 4 1)
        fmtApp.copySelection()
        GridEditTest.select(fmtApp 30 1)
        fmtApp.pasteMode = 1
        fmtApp.pasteClipboard()
        fmtApp.pasteMode = 0
        c.eqStr("values-only pasted the value" (fm.getCell(30 1)) (fm.getCell(4 1)))
        c.ok("values-only kept no border" (((fm.getCellStyle(30 1)).hasBorder) == false))
        ; formats only: styling lands, the existing value stays
        fmtApp.model.setCellRaw(31 1 "keep me")
        GridEditTest.select(fmtApp 4 1)
        fmtApp.copySelection()
        GridEditTest.select(fmtApp 31 1)
        fmtApp.pasteMode = 2
        fmtApp.pasteClipboard()
        fmtApp.pasteMode = 0
        c.eqStr("formats-only kept the value" (fm.getCell(31 1)) "keep me")
        c.ok("formats-only applied the border" ((fm.getCellStyle(31 1)).hasBorder))
        ; no-formatting: value and formula land, styling does not
        GridEditTest.select(fmtApp 4 1)
        fmtApp.copySelection()
        GridEditTest.select(fmtApp 32 1)
        fmtApp.pasteMode = 3
        fmtApp.pasteClipboard()
        fmtApp.pasteMode = 0
        c.eqStr("no-format pasted the value" (fm.getCell(32 1)) (fm.getCell(4 1)))
        c.ok("no-format kept no border" (((fm.getCellStyle(32 1)).hasBorder) == false))
        ; an external TSV paste has no styles to carry
        fmtApp.setClipboardText("plain")
        GridEditTest.select(fmtApp 33 1)
        fmtApp.pasteClipboard()
        c.eqStr("external paste lands" (fm.getCell(33 1)) "plain")
        c.ok("external paste has no formatting" (((fm.getCellStyle(33 1)).hasBorder) == false))

        print "== Paste Special dialog (shared EVG window layer) =="
        def dApp:GridApp (new GridApp)
        dApp.init("gallery/pdf_writer/assets/fonts")
        dApp.loadXlsx("gallery/datagrid/fixtures/styles-showcase.xlsx")
        def dm:SpreadsheetModel dApp.model
        c.ok("no dialog at rest" ((dApp.windows.anyVisible()) == false))
        GridEditTest.select(dApp 4 1)
        dApp.copySelection()
        GridEditTest.select(dApp 35 1)
        dApp.openPasteSpecial()
        c.ok("dialog opened" dApp.pasteDialog.visible)
        c.ok("manager sees it" (dApp.windows.anyVisible()))
        c.eqInt("defaults to All" (dApp.pasteDialog.selectedInGroup(1)) 1)
        ; A modal dialog swallows clicks that land on the grid behind it.
        def dInput:UIInput (new UIInput)
        dInput.newFrame()
        dInput.setPointerPos(5 300)
        dInput.setPointerDown(true)
        dApp.update(dInput)
        c.eqInt("grid selection untouched while modal" dApp.sel.active.row 35)
        dInput.newFrame()
        dInput.setPointerDown(false)
        dApp.update(dInput)
        ; Pick "Formats only" and press Paste.
        def rFormats:EVGControl (dApp.pasteDialog.controlById(3))
        def clickX:int ((dApp.pasteDialog.x + rFormats.x) + 4)
        def clickY:int ((dApp.pasteDialog.y + rFormats.y) + 4)
        dInput.newFrame()
        dInput.setPointerPos(clickX clickY)
        dInput.setPointerDown(true)
        dApp.update(dInput)
        c.eqInt("radio selected" (dApp.pasteDialog.selectedInGroup(1)) 3)
        dInput.newFrame()
        dInput.setPointerDown(false)
        dApp.update(dInput)
        dm.setCellRaw(35 1 "existing")
        def okBtn:EVGControl (dApp.pasteDialog.controlById(10))
        def okX:int ((dApp.pasteDialog.x + okBtn.x) + 10)
        def okY:int ((dApp.pasteDialog.y + okBtn.y) + 10)
        dInput.newFrame()
        dInput.setPointerPos(okX okY)
        dInput.setPointerDown(true)
        dApp.update(dInput)
        c.ok("dialog closed after Paste" (dApp.pasteDialog.visible == false))
        c.eqStr("formats-only kept the value" (dm.getCell(35 1)) "existing")
        c.ok("and applied the border" ((dm.getCellStyle(35 1)).hasBorder))
        c.eqInt("paste mode restored to default" dApp.pasteMode 0)
        ; Escape closes without pasting.
        GridEditTest.select(dApp 36 1)
        dApp.openPasteSpecial()
        c.ok("reopened" dApp.pasteDialog.visible)
        dInput.newFrame()
        dInput.setPointerDown(false)
        dInput.pushKey((UIKey.escape()))
        dApp.update(dInput)
        c.ok("escape closed it" (dApp.pasteDialog.visible == false))
        c.eqStr("nothing pasted" (dm.getCell(36 1)) "")
        ; The dialog reaches the scene, so every backend can draw it.
        dApp.openPasteSpecial()
        def withDialog:string (dApp.sceneJson())
        c.ok("dialog paints into the display list" (GridEditTest.hasSub(withDialog "Paste Special")))
        dApp.pasteDialog.close()
        def withoutDialog:string (dApp.sceneJson())
        c.ok("and disappears when closed" ((GridEditTest.hasSub(withoutDialog "Paste Special")) == false))

        print "== EVGWindow basics =="
        def wnd:EVGWindow (new EVGWindow)
        wnd.title = "Test"
        wnd.w = 200
        wnd.reset()
        wnd.addLabel("Pick one")
        wnd.addRadio(1 "One" 1 true)
        wnd.addRadio(2 "Two" 1 false)
        wnd.addCheckbox(5 "Also this" false)
        def wIds:[int]
        push wIds 9
        def wLabels:[string]
        push wLabels "Go"
        wnd.addButtonRow(wIds wLabels 9)
        wnd.finish()
        c.ok("sized to content" (wnd.h > 80))
        wnd.openAt(40 40)
        c.ok("point inside" (wnd.containsPoint(60 60)))
        c.ok("point outside" ((wnd.containsPoint(5 5)) == false))
        c.ok("title bar hit" (wnd.onTitleBar(60 45)))
        ; Radios are exclusive.
        wnd.selectRadio(2)
        c.eqInt("second radio wins" (wnd.selectedInGroup(1)) 2)
        c.ok("first cleared" ((wnd.isChecked(1)) == false))
        ; Checkbox toggles independently.
        def cb:EVGControl (wnd.controlById(5))
        def cbX:int ((wnd.x + cb.x) + 4)
        def cbY:int ((wnd.y + cb.y) + 4)
        wnd.handlePointer(cbX cbY true true false)
        c.ok("checkbox toggled on" (wnd.isChecked(5)))
        wnd.handlePointer(cbX cbY true true false)
        c.ok("checkbox toggled off" ((wnd.isChecked(5)) == false))
        ; Enter fires the default button.
        c.ok("enter fires default" (wnd.handleKey(2 4 2)))
        c.eqInt("default activated" wnd.activated 9)

        print "== colour palette swatches =="
        def pal:EVGWindow (new EVGWindow)
        pal.title = "Palette"
        pal.w = 300
        pal.reset()
        pal.beginColumns(5)
        pal.addSwatch(101 "#FF0000" 1 true)
        pal.addSwatch(102 "#00FF00" 1 false)
        pal.addSwatch(103 "#0000FF" 1 false)
        pal.endColumns()
        def pIds:[int]
        push pIds 110
        def pLabels:[string]
        push pLabels "Apply"
        pal.addButtonRow(pIds pLabels 110)
        pal.finish()
        pal.openAt(20 20)
        c.eqStr("first swatch is the choice" (pal.selectedSwatchValue(1)) "#FF0000")
        def sw:EVGControl (pal.controlById(102))
        def sx:int ((pal.x + sw.x) + 2)
        def sy:int ((pal.y + sw.y) + 2)
        pal.handlePointer(sx sy true true false)
        c.eqInt("click selects the green chip" (pal.selectedInGroup(1)) 102)
        c.eqStr("and reports its hex" (pal.selectedSwatchValue(1)) "#00FF00")
        c.eqInt("swatch click activates" pal.activated 102)
        ; Dragging the title bar moves the window.
        def ox:int wnd.x
        wnd.handlePointer((wnd.x + 30) (wnd.y + 8) true true false)
        wnd.handlePointer((wnd.x + 60) (wnd.y + 8) false true false)
        c.ok("window moved" (wnd.x != ox))
        wnd.handlePointer(wnd.x wnd.y false false true)
        ; A modal window swallows outside clicks; a non-modal one does not.
        c.ok("modal swallows outside" (wnd.handlePointer(2 2 true true false)))
        wnd.modal = false
        c.ok("non-modal lets it through" ((wnd.handlePointer(2 2 true true false)) == false))
        wnd.close()
        c.ok("closed window ignores input" ((wnd.handlePointer(60 60 true true false)) == false))

        print "== wrap, vertical align, overflow and truncation =="
        def wApp:GridApp (new GridApp)
        wApp.init("gallery/pdf_writer/assets/fonts")
        c.ok("load showcase" (wApp.loadXlsx("gallery/datagrid/fixtures/styles-showcase.xlsx")))
        def wm:SpreadsheetModel wApp.model
        def wrapSt:CellStyle (wm.getCellStyle(20 1))
        c.ok("wrapText parsed" wrapSt.wrapText)
        c.eqStr("vertical top parsed" ((wm.getCellStyle(20 2)).valign) "top")
        c.eqStr("vertical center parsed" ((wm.getCellStyle(20 3)).valign) "center")
        c.ok("a plain cell does not wrap" (((wm.getCellStyle(18 1)).wrapText) == false))
        ; Wrapped text needs more height in a narrower column.
        def longText:string (wm.getCell(20 1))
        def hNarrow:int (wApp.view.measureWrappedHeight(longText 90 wrapSt))
        def hWide:int (wApp.view.measureWrappedHeight(longText 400 wrapSt))
        c.ok("narrower column is taller" (hNarrow > hWide))
        def plainSt:CellStyle (wm.getCellStyle(18 1))
        def hNoWrap:int (wApp.view.measureWrappedHeight(longText 90 plainSt))
        c.ok("without wrap it stays one line" (hNoWrap < hNarrow))
        ; Row auto-fit grows the row to fit the wrapped lines.
        def beforeH:int (wm.rowHeight(20))
        wApp.autoFitRow(20)
        def afterH:int (wm.rowHeight(20))
        c.ok("auto-fit grew the row" (afterH > beforeH))
        c.ok("auto-fit stays sane" (afterH <= 400))
        ; A row of short text does not balloon.
        wApp.autoFitRow(18)
        c.ok("short row stays short" ((wm.rowHeight(18)) < afterH))

        print "-- overflow only over EMPTY neighbours --"
        def spillRect:GridRect (wApp.grid.cellRect(wm 22 1))
        def roomEmpty:int (wApp.view.spillWidth(wm spillRect 22 1 true))
        c.ok("spills past its own width" (roomEmpty > spillRect.w))
        ; C25 is occupied, so B25 must stop at its own edge.
        def blockRect:GridRect (wApp.grid.cellRect(wm 24 1))
        def roomBlocked:int (wApp.view.spillWidth(wm blockRect 24 1 true))
        c.eqInt("blocked by an occupied neighbour" roomBlocked blockRect.w)
        c.ok("occupied neighbour really has content" ((strlen (wm.getCell(24 2))) > 0))
        ; Filling the neighbour stops the spill.
        wm.setCellRaw(22 2 "now taken")
        def roomAfter:int (wApp.view.spillWidth(wm spillRect 22 1 true))
        c.eqInt("spill stops once the neighbour fills" roomAfter spillRect.w)
        c.ok("still renders" ((strlen (wApp.sceneJson())) > 500))

        print "== format painter =="
        def fpApp:GridApp (new GridApp)
        fpApp.init("gallery/pdf_writer/assets/fonts")
        fpApp.loadXlsx("gallery/datagrid/fixtures/styles-showcase.xlsx")
        def fpm:SpreadsheetModel fpApp.model
        c.ok("brush starts disarmed" (fpApp.formatBrushArmed == false))
        ; Pick up the thin red box from B5.
        GridEditTest.select(fpApp 4 1)
        fpApp.copyFormat()
        c.ok("brush armed" fpApp.formatBrushArmed)
        c.ok("brush holds the border" fpApp.formatBrush.hasBorder)
        ; Apply it to a range that already has values.
        fpm.setCellRaw(40 1 "keep one")
        fpm.setCellRaw(40 2 "keep two")
        GridEditTest.selectRange(fpApp 40 1 40 2)
        fpApp.applyFormatToSelection()
        c.ok("first cell styled" ((fpm.getCellStyle(40 1)).hasBorder))
        c.ok("second cell styled" ((fpm.getCellStyle(40 2)).hasBorder))
        c.eqStr("values untouched" (fpm.getCell(40 1)) "keep one")
        c.eqStr("second value untouched" (fpm.getCell(40 2)) "keep two")
        c.ok("brush disarms after use" (fpApp.formatBrushArmed == false))
        ; One undo puts the whole range back.
        fpApp.undoEdit()
        c.ok("undo removed the styling" (((fpm.getCellStyle(40 1)).hasBorder) == false))
        c.ok("undo removed it from both" (((fpm.getCellStyle(40 2)).hasBorder) == false))
        c.eqStr("and kept the values" (fpm.getCell(40 1)) "keep one")
        ; A disarmed brush does nothing.
        GridEditTest.selectRange(fpApp 41 1 41 2)
        fpApp.applyFormatToSelection()
        c.ok("disarmed brush is inert" (((fpm.getCellStyle(41 1)).hasBorder) == false))
        fpApp.copyFormat()
        fpApp.cancelFormatBrush()
        c.ok("brush can be cancelled" (fpApp.formatBrushArmed == false))

        print "== insert / delete / move columns =="
        def colApp:GridApp (new GridApp)
        colApp.init("gallery/pdf_writer/assets/fonts")
        colApp.model.clearSheet()
        colApp.model.name = "Cols"
        colApp.model.resize(6 5)
        colApp.model.setCellRaw(0 0 "A")
        colApp.model.setCellRaw(0 1 "B")
        colApp.model.setCellRaw(0 2 "C")
        colApp.model.setCellRaw(0 3 "D")
        colApp.model.setColWidth(1 133)
        def styled:CellStyle (new CellStyle)
        styled.hasFill = true
        styled.fillRgb = "#123456"
        colApp.model.setCellStyleResolved(0 2 styled)
        colApp.sheetView.markDirty()
        colApp.sheetView.rebuild()
        colApp.engine.rebuildAll()

        print "-- insert --"
        colApp.insertColumn(1)
        c.eqInt("colCount grew" colApp.model.colCount 6)
        c.eqStr("A stayed" (colApp.model.getCell(0 0)) "A")
        c.eqStr("new column is empty" (colApp.model.getCell(0 1)) "")
        c.eqStr("B moved right" (colApp.model.getCell(0 2)) "B")
        c.eqStr("C moved right" (colApp.model.getCell(0 3)) "C")
        c.eqInt("width followed the column" (colApp.model.colWidth(2)) 133)
        c.ok("style followed the column" ((colApp.model.getCellStyle(0 3)).hasFill))
        c.ok("inserted column has no style" (((colApp.model.getCellStyle(0 1)).hasFill) == false))

        print "-- undo the insert --"
        colApp.undoEdit()
        c.eqInt("colCount back" colApp.model.colCount 5)
        c.eqStr("B back in place" (colApp.model.getCell(0 1)) "B")
        c.eqInt("width back" (colApp.model.colWidth(1)) 133)
        colApp.redoEdit()
        c.eqStr("redo moved B again" (colApp.model.getCell(0 2)) "B")
        colApp.undoEdit()

        print "-- delete --"
        colApp.deleteColumn(1)
        c.eqInt("colCount shrank" colApp.model.colCount 4)
        c.eqStr("A stayed" (colApp.model.getCell(0 0)) "A")
        c.eqStr("C shifted left" (colApp.model.getCell(0 1)) "C")
        c.eqStr("D shifted left" (colApp.model.getCell(0 2)) "D")
        colApp.undoEdit()
        c.eqInt("delete undone" colApp.model.colCount 5)
        c.eqStr("B restored" (colApp.model.getCell(0 1)) "B")
        c.eqInt("its width restored" (colApp.model.colWidth(1)) 133)

        print "-- move --"
        colApp.moveColumn(0 2)
        c.eqStr("A moved to index 2" (colApp.model.getCell(0 2)) "A")
        c.eqStr("B shifted left" (colApp.model.getCell(0 0)) "B")
        c.eqStr("C shifted left" (colApp.model.getCell(0 1)) "C")
        c.eqStr("D untouched" (colApp.model.getCell(0 3)) "D")
        colApp.undoEdit()
        c.eqStr("move undone" (colApp.model.getCell(0 0)) "A")
        c.eqStr("and B is back" (colApp.model.getCell(0 1)) "B")

        print "== formulas follow the columns =="
        def fApp:GridApp (new GridApp)
        fApp.init("gallery/pdf_writer/assets/fonts")
        fApp.model.clearSheet()
        fApp.model.name = "Calc"
        fApp.model.resize(6 6)
        fApp.model.setCellRaw(0 0 "2")
        fApp.model.setCellRaw(0 1 "3")
        fApp.model.setFormula(0 3 "A1+B1")
        fApp.model.setFormula(1 3 "SUM(A1:B1)")
        fApp.model.setFormula(2 3 "$A$1*10")
        fApp.sheetView.markDirty()
        fApp.sheetView.rebuild()
        fApp.engine.rebuildAll()
        c.eqStr("baseline sum" (fApp.model.getCell(0 3)) "5")
        ; Insert before B: refs at or past it shift right.
        fApp.insertColumn(1)
        c.eqStr("relative ref shifted" (fApp.model.getFormula(0 4)) "A1+C1")
        c.eqStr("range end shifted" (fApp.model.getFormula(1 4)) "SUM(A1:C1)")
        c.eqStr("absolute ref before the insert is untouched" (fApp.model.getFormula(2 4)) "$A$1*10")
        c.eqStr("value still right" (fApp.model.getCell(0 4)) "5")
        fApp.undoEdit()
        c.eqStr("undo restored the formula text" (fApp.model.getFormula(0 3)) "A1+B1")
        c.eqStr("and it still calculates" (fApp.model.getCell(0 3)) "5")

        print "-- deleting a referenced column gives #REF! --"
        fApp.deleteColumn(1)
        c.eqStr("reference into the deleted column breaks" (fApp.model.getFormula(0 2)) "#REF!")
        ; One undo brings the original formula back — a #REF! cannot be
        ; re-derived by shifting, so the text itself has to be restored.
        fApp.undoEdit()
        c.eqStr("undo restores the broken formula" (fApp.model.getFormula(0 3)) "A1+B1")
        c.eqStr("and its value" (fApp.model.getCell(0 3)) "5")
        ; Deleting an UNreferenced column just shifts the rest.
        fApp.deleteColumn(4)
        c.eqStr("unrelated delete keeps the formula" (fApp.model.getFormula(0 3)) "A1+B1")
        fApp.undoEdit()

        print "== merges follow the columns =="
        def mApp:GridApp (new GridApp)
        mApp.init("gallery/pdf_writer/assets/fonts")
        mApp.model.clearSheet()
        mApp.model.resize(6 6)
        mApp.model.addMerge(0 2 0 3)
        mApp.sheetView.markDirty()
        mApp.sheetView.rebuild()
        mApp.engine.rebuildAll()
        c.ok("merge is at C1:D1" ((strlen (mApp.model.mergeAt(0 2))) > 0))
        mApp.insertColumn(0)
        c.ok("merge shifted right" ((strlen (mApp.model.mergeAt(0 3))) > 0))
        c.ok("and left its old place" ((strlen (mApp.model.mergeAt(0 2))) == 0))
        mApp.undoEdit()
        c.ok("merge shifted back" ((strlen (mApp.model.mergeAt(0 2))) > 0))

        print "== selection helpers and menu actions =="
        def sApp2:GridApp (new GridApp)
        sApp2.init("gallery/pdf_writer/assets/fonts")
        sApp2.model.clearSheet()
        sApp2.model.resize(4 5)
        sApp2.model.setCellRaw(0 0 "one")
        sApp2.model.setCellRaw(0 1 "two")
        sApp2.model.setCellRaw(0 2 "three")
        sApp2.sheetView.markDirty()
        sApp2.sheetView.rebuild()
        sApp2.engine.rebuildAll()
        GridEditTest.select(sApp2 0 1)
        sApp2.insertColumnLeftOfSelection()
        c.eqStr("insert left pushed two right" (sApp2.model.getCell(0 2)) "two")
        sApp2.undoEdit()
        GridEditTest.select(sApp2 0 1)
        sApp2.insertColumnRightOfSelection()
        c.eqStr("insert right kept two in place" (sApp2.model.getCell(0 1)) "two")
        c.eqStr("and pushed three right" (sApp2.model.getCell(0 3)) "three")
        sApp2.undoEdit()
        ; Deleting a multi-column selection removes them all.
        GridEditTest.selectRange(sApp2 0 0 0 1)
        sApp2.deleteSelectedColumns()
        c.eqStr("both columns gone" (sApp2.model.getCell(0 0)) "three")
        sApp2.undoEdit()
        sApp2.undoEdit()
        c.eqStr("both undos restored them" (sApp2.model.getCell(0 0)) "one")
        ; Move via the selection helper follows the selection.
        GridEditTest.select(sApp2 0 0)
        sApp2.moveSelectedColumn(1)
        c.eqStr("moved right" (sApp2.model.getCell(0 1)) "one")
        c.eqInt("selection followed" sApp2.sel.active.col 1)
        sApp2.undoEdit()
        ; Menu actions 8..12 map to the same operations.
        sApp2.openHeaderMenu(1 10 10)
        sApp2.runHeaderMenu(8)
        c.eqStr("menu insert left" (sApp2.model.getCell(0 2)) "two")
        sApp2.undoEdit()
        sApp2.openHeaderMenu(1 10 10)
        sApp2.runHeaderMenu(10)
        c.eqStr("menu delete" (sApp2.model.getCell(0 1)) "three")
        sApp2.undoEdit()
        c.eqStr("menu delete undone" (sApp2.model.getCell(0 1)) "two")
        c.ok("still renders" ((strlen (sApp2.sceneJson())) > 500))

        print "== row structure: insert / delete / move =="
        def rowApp:GridApp (new GridApp)
        rowApp.init("gallery/pdf_writer/assets/fonts")
        rowApp.model.clearSheet()
        rowApp.model.resize(5 4)
        rowApp.model.setCellRaw(0 0 "one")
        rowApp.model.setCellRaw(1 0 "two")
        rowApp.model.setCellRaw(2 0 "three")
        rowApp.model.setCellRaw(3 0 "four")
        rowApp.model.setRowHeight(1 41)
        rowApp.sheetView.markDirty()
        rowApp.sheetView.rebuild()
        rowApp.engine.rebuildAll()

        print "-- insert --"
        rowApp.insertRow(1)
        c.eqInt("rowCount grew" rowApp.model.rowCount 6)
        c.eqStr("one stayed" (rowApp.model.getCell(0 0)) "one")
        c.eqStr("the new row is empty" (rowApp.model.getCell(1 0)) "")
        c.eqStr("two moved down" (rowApp.model.getCell(2 0)) "two")
        c.eqStr("three moved down" (rowApp.model.getCell(3 0)) "three")
        c.eqInt("the height moved with the row" (rowApp.model.rowHeight(2)) 41)
        c.eqInt("the new row is the default height" (rowApp.model.rowHeight(1)) rowApp.model.defaultRowH)
        rowApp.undoEdit()
        c.eqInt("rowCount back" rowApp.model.rowCount 5)
        c.eqStr("two back in place" (rowApp.model.getCell(1 0)) "two")
        c.eqInt("height back" (rowApp.model.rowHeight(1)) 41)
        rowApp.redoEdit()
        c.eqStr("redo moved two again" (rowApp.model.getCell(2 0)) "two")
        rowApp.undoEdit()

        print "-- delete --"
        rowApp.deleteRow(1)
        c.eqInt("rowCount shrank" rowApp.model.rowCount 4)
        c.eqStr("one stayed" (rowApp.model.getCell(0 0)) "one")
        c.eqStr("three shifted up" (rowApp.model.getCell(1 0)) "three")
        c.eqStr("four shifted up" (rowApp.model.getCell(2 0)) "four")
        rowApp.undoEdit()
        c.eqInt("delete undone" rowApp.model.rowCount 5)
        c.eqStr("two restored" (rowApp.model.getCell(1 0)) "two")
        c.eqInt("its height restored" (rowApp.model.rowHeight(1)) 41)

        print "-- delete past the used range keeps the data --"
        rowApp.deleteRow(4)
        c.eqStr("four still there" (rowApp.model.getCell(3 0)) "four")
        rowApp.undoEdit()

        print "-- move --"
        rowApp.moveRow(0 2)
        c.eqStr("one moved to index 2" (rowApp.model.getCell(2 0)) "one")
        c.eqStr("two shifted up" (rowApp.model.getCell(0 0)) "two")
        c.eqStr("three shifted up" (rowApp.model.getCell(1 0)) "three")
        c.eqStr("four untouched" (rowApp.model.getCell(3 0)) "four")
        rowApp.undoEdit()
        c.eqStr("move undone" (rowApp.model.getCell(0 0)) "one")
        c.eqStr("and two is back" (rowApp.model.getCell(1 0)) "two")

        print "== formulas follow the rows =="
        def frApp:GridApp (new GridApp)
        frApp.init("gallery/pdf_writer/assets/fonts")
        frApp.model.clearSheet()
        frApp.model.name = "Calc"
        frApp.model.resize(8 6)
        frApp.model.setCellRaw(0 0 "2")
        frApp.model.setCellRaw(1 0 "3")
        frApp.model.setFormula(3 0 "A1+A2")
        frApp.model.setFormula(3 1 "SUM(A1:A2)")
        frApp.model.setFormula(3 2 "$A$1*10")
        frApp.sheetView.markDirty()
        frApp.sheetView.rebuild()
        frApp.engine.rebuildAll()
        c.eqStr("baseline sum" (frApp.model.getCell(3 0)) "5")
        frApp.insertRow(1)
        c.eqStr("relative ref shifted down" (frApp.model.getFormula(4 0)) "A1+A3")
        c.eqStr("range end shifted" (frApp.model.getFormula(4 1)) "SUM(A1:A3)")
        c.eqStr("absolute ref above the insert is untouched" (frApp.model.getFormula(4 2)) "$A$1*10")
        c.eqStr("value still right" (frApp.model.getCell(4 0)) "5")
        frApp.undoEdit()
        c.eqStr("undo restored the formula text" (frApp.model.getFormula(3 0)) "A1+A2")
        c.eqStr("and it still calculates" (frApp.model.getCell(3 0)) "5")

        print "-- deleting a referenced row gives #REF! --"
        frApp.deleteRow(1)
        c.eqStr("reference into the deleted row breaks" (frApp.model.getFormula(2 0)) "#REF!")
        frApp.undoEdit()
        c.eqStr("undo restores the broken formula" (frApp.model.getFormula(3 0)) "A1+A2")
        c.eqStr("and its value" (frApp.model.getCell(3 0)) "5")

        print "== merges follow the rows =="
        def mrApp:GridApp (new GridApp)
        mrApp.init("gallery/pdf_writer/assets/fonts")
        mrApp.model.clearSheet()
        mrApp.model.resize(6 6)
        mrApp.model.addMerge(2 0 3 0)
        mrApp.sheetView.markDirty()
        mrApp.sheetView.rebuild()
        mrApp.engine.rebuildAll()
        c.ok("merge is at A3:A4" ((strlen (mrApp.model.mergeAt(2 0))) > 0))
        mrApp.insertRow(0)
        c.ok("merge shifted down" ((strlen (mrApp.model.mergeAt(3 0))) > 0))
        c.ok("and left its old place" ((strlen (mrApp.model.mergeAt(2 0))) == 0))
        mrApp.undoEdit()
        c.ok("merge shifted back" ((strlen (mrApp.model.mergeAt(2 0))) > 0))

        print "== row selection helpers and the row menu =="
        def rsApp:GridApp (new GridApp)
        rsApp.init("gallery/pdf_writer/assets/fonts")
        rsApp.model.clearSheet()
        rsApp.model.resize(5 4)
        rsApp.model.setCellRaw(0 0 "one")
        rsApp.model.setCellRaw(1 0 "two")
        rsApp.model.setCellRaw(2 0 "three")
        rsApp.sheetView.markDirty()
        rsApp.sheetView.rebuild()
        rsApp.engine.rebuildAll()
        GridEditTest.select(rsApp 1 0)
        rsApp.insertRowAboveSelection()
        c.eqStr("insert above pushed two down" (rsApp.model.getCell(2 0)) "two")
        rsApp.undoEdit()
        GridEditTest.select(rsApp 1 0)
        rsApp.insertRowBelowSelection()
        c.eqStr("insert below kept two in place" (rsApp.model.getCell(1 0)) "two")
        c.eqStr("and pushed three down" (rsApp.model.getCell(3 0)) "three")
        rsApp.undoEdit()
        GridEditTest.selectRange(rsApp 0 0 1 0)
        rsApp.deleteSelectedRows()
        c.eqStr("both rows gone" (rsApp.model.getCell(0 0)) "three")
        rsApp.undoEdit()
        rsApp.undoEdit()
        c.eqStr("both undos restored them" (rsApp.model.getCell(0 0)) "one")
        GridEditTest.select(rsApp 0 0)
        rsApp.moveSelectedRow(1)
        c.eqStr("moved down" (rsApp.model.getCell(1 0)) "one")
        c.eqInt("selection followed" rsApp.sel.active.row 1)
        rsApp.undoEdit()
        ; The row menu maps to the same operations, and its hit test knows it
        ; is nine items long rather than twelve.
        rsApp.openRowMenu(1 10 10)
        c.eqInt("row menu item 1" (rsApp.hitHeaderMenu(20 (10 + 26))) 1)
        c.eqInt("row menu item 5" (rsApp.hitHeaderMenu(20 (10 + 26 + (4 * 20)))) 5)
        c.eqInt("row menu item 9" (rsApp.hitHeaderMenu(20 (10 + 26 + (8 * 20)))) 9)
        c.eqInt("nothing past the last item" (rsApp.hitHeaderMenu(20 (10 + 26 + (9 * 20)))) 0)
        rsApp.runHeaderMenu(5)
        c.eqStr("menu insert above" (rsApp.model.getCell(2 0)) "two")
        rsApp.undoEdit()
        rsApp.openRowMenu(1 10 10)
        rsApp.runHeaderMenu(7)
        c.eqStr("menu delete" (rsApp.model.getCell(1 0)) "three")
        rsApp.undoEdit()
        c.eqStr("menu delete undone" (rsApp.model.getCell(1 0)) "two")
        rsApp.openRowMenu(1 10 10)
        rsApp.runHeaderMenu(1)
        c.eqInt("menu select row spans to the last column" rsApp.sel.anchor.col (rsApp.model.colCount - 1))
        c.eqInt("and its active cell is column A" rsApp.sel.active.col 0)
        c.ok("row menu closed after acting" (rsApp.view.menuOpen == false))
        c.ok("still renders with the row menu" ((strlen (rsApp.sceneJson())) > 500))

        print "== find and replace =="
        def fr:GridApp (new GridApp)
        fr.init("gallery/pdf_writer/assets/fonts")
        fr.model.clearSheet()
        fr.model.name = "Calc"
        fr.model.resize(6 4)
        fr.model.setCellRaw(0 0 "alpha")
        fr.model.setCellRaw(1 0 "Alpha beta")
        fr.model.setCellRaw(2 0 "gamma")
        fr.model.setCellRaw(3 0 "2")
        fr.model.setCellRaw(3 1 "3")
        fr.model.setFormula(4 0 "A4+B4")
        fr.sheetView.markDirty()
        fr.sheetView.rebuild()
        fr.engine.rebuildAll()

        GridEditTest.select(fr 0 0)
        fr.findQuery = "alpha"
        fr.findMatchCase = false
        c.ok("finds the next one, not the one it is on" (fr.findNext()))
        c.eqInt("landed on row 1" fr.sel.active.row 1)
        c.ok("wraps around" (fr.findNext()))
        c.eqInt("back to row 0" fr.sel.active.row 0)

        fr.findMatchCase = true
        GridEditTest.select(fr 2 0)
        c.ok("case-sensitive still finds the exact one" (fr.findNext()))
        c.eqInt("which is row 0" fr.sel.active.row 0)
        fr.findQuery = "ALPHA"
        c.ok("and misses the wrong case" ((fr.findNext()) == false))
        c.ok("saying so" (GridEditTest.hasSub(fr.findStatus "no match")))
        fr.findMatchCase = false

        fr.findWholeCell = true
        fr.findQuery = "alpha"
        GridEditTest.select(fr 2 0)
        c.ok("entire-cell match finds the cell that is only that" (fr.findNext()))
        c.eqInt("row 0, not the one that merely contains it" fr.sel.active.row 0)
        fr.findWholeCell = false

        print "-- replace --"
        fr.findQuery = "alpha"
        fr.replaceWith = "omega"
        GridEditTest.select(fr 0 0)
        fr.replaceCurrent()
        c.eqStr("the cell it was on changed" (fr.model.getCell(0 0)) "omega")
        c.eqStr("the other one has not yet" (fr.model.getCell(1 0)) "Alpha beta")
        c.eqInt("and it moved to that one" fr.sel.active.row 1)
        fr.undoEdit()
        c.eqStr("one undo puts it back" (fr.model.getCell(0 0)) "alpha")

        def n:int (fr.replaceAll())
        c.eqInt("replace all found both" n 2)
        c.eqStr("first replaced" (fr.model.getCell(0 0)) "omega")
        c.eqStr("second replaced, keeping the rest of the text" (fr.model.getCell(1 0)) "omega beta")
        fr.undoEdit()
        c.eqStr("and the whole batch is one undo" (fr.model.getCell(0 0)) "alpha")
        c.eqStr("for every cell in it" (fr.model.getCell(1 0)) "Alpha beta")

        print "-- searching formulas rather than values --"
        c.eqStr("the formula cell shows its value" (fr.model.getCell(4 0)) "5")
        fr.findInFormulas = true
        fr.findQuery = "A4"
        fr.replaceWith = "A4"
        GridEditTest.select(fr 0 0)
        c.ok("a formula is searchable" (fr.findNext()))
        c.eqInt("found in the formula row" fr.sel.active.row 4)
        fr.findQuery = "B4"
        fr.replaceWith = "B4*2"
        fr.replaceAll()
        c.eqStr("the formula text was rewritten" (fr.model.getFormula(4 0)) "A4+B4*2")
        c.eqStr("and it recalculated" (fr.model.getCell(4 0)) "8")
        fr.undoEdit()
        c.eqStr("undone" (fr.model.getFormula(4 0)) "A4+B4")
        c.eqStr("and recalculated back" (fr.model.getCell(4 0)) "5")

        print "-- the dialog, typed into --"
        def fd:GridApp (new GridApp)
        fd.init("gallery/pdf_writer/assets/fonts")
        fd.model.clearSheet()
        fd.model.resize(4 3)
        fd.model.setCellRaw(0 0 "needle")
        fd.model.setCellRaw(2 0 "needle")
        fd.sheetView.markDirty()
        fd.sheetView.rebuild()
        fd.engine.rebuildAll()
        def fdi:UIInput (new UIInput)
        fdi.newFrame()
        fdi.setModifiers(false true)
        fdi.pushText("f")
        fd.update(fdi)
        c.ok("Ctrl+F opens the dialog" fd.findDialog.visible)
        c.eqInt("with the find field focused" fd.findDialog.focusedId 501)
        fdi.newFrame()
        fdi.setModifiers(false false)
        fdi.pushText("need")
        fd.update(fdi)
        c.eqStr("typing lands in the field" (fd.findDialog.inputValue(501)) "need")
        c.eqStr("and not in a cell" (fd.model.getCell(0 1)) "")
        fdi.newFrame()
        fdi.pushKey((UIKey.backspace()))
        fd.update(fdi)
        c.eqStr("backspace edits the field" (fd.findDialog.inputValue(501)) "nee")
        fdi.newFrame()
        fdi.pushKey((UIKey.tab()))
        fd.update(fdi)
        c.eqInt("tab moves to the replace field" fd.findDialog.focusedId 502)
        fdi.newFrame()
        fdi.pushText("pin")
        fd.update(fdi)
        c.eqStr("which takes the typing now" (fd.findDialog.inputValue(502)) "pin")
        ; Press "Replace all" by hand.
        def raBtn:EVGControl (fd.findDialog.controlById(512))
        def rax:int ((fd.findDialog.x + raBtn.x) + 8)
        def ray:int ((fd.findDialog.y + raBtn.y) + 8)
        fdi.newFrame()
        fdi.setPointerPos(rax ray)
        fdi.setPointerDown(true)
        fd.update(fdi)
        fdi.newFrame()
        fdi.setPointerPos(rax ray)
        fdi.setPointerDown(false)
        fd.update(fdi)
        c.eqStr("the button replaced through the dialog" (fd.model.getCell(0 0)) "pindle")
        c.eqStr("everywhere" (fd.model.getCell(2 0)) "pindle")
        c.ok("and the dialog says what it did" (GridEditTest.hasSub(fd.findStatus "replaced 2")))
        c.ok("still renders with the dialog up" ((strlen (fd.sceneJson())) > 500))

        print "== disjoint selection =="
        def ms:GridApp (new GridApp)
        ms.init("gallery/pdf_writer/assets/fonts")
        ms.model.clearSheet()
        ms.model.resize(8 6)
        def mr:int 0
        while (mr < 6) {
            def mc:int 0
            while (mc < 4) {
                ms.model.setCellRaw(mr mc ((to_string mr) + "," + (to_string mc)))
                mc = (mc + 1)
            }
            mr = (mr + 1)
        }
        ms.sheetView.markDirty()
        ms.sheetView.rebuild()
        ms.engine.rebuildAll()

        GridEditTest.selectRange(ms 0 0 1 1)
        c.eqInt("one rectangle to start" (ms.sel.rangeCount()) 1)
        c.eqInt("four cells" (ms.sel.selectedCount()) 4)
        ms.sel.keepCurrent()
        GridEditTest.selectRange(ms 3 2 4 3)
        c.eqInt("two rectangles now" (ms.sel.rangeCount()) 2)
        c.eqInt("eight cells" (ms.sel.selectedCount()) 8)
        c.ok("the first is still covered" (ms.sel.coversAny(0 0)))
        c.ok("and the second" (ms.sel.coversAny(4 3)))
        c.ok("but not the gap between them" ((ms.sel.coversAny(2 2)) == false))
        c.ok("it knows it is disjoint" (ms.sel.isDisjoint()))
        def liveG:GridRange (ms.sel.liveRange())
        c.eqInt("the live rectangle is the newest" liveG.r0 3)

        ; Delete clears every rectangle, in one transaction.
        ms.clearSelection()
        c.eqStr("first rectangle cleared" (ms.model.getCell(0 0)) "")
        c.eqStr("second rectangle cleared" (ms.model.getCell(4 3)) "")
        c.eqStr("the gap untouched" (ms.model.getCell(2 2)) "2,2")
        ms.undoEdit()
        c.eqStr("one undo restores both" (ms.model.getCell(0 0)) "0,0")
        c.eqStr("really both" (ms.model.getCell(4 3)) "4,3")

        ; Ctrl+click through the real input path adds a rectangle.
        def msi:UIInput (new UIInput)
        GridEditTest.select(ms 0 0)
        c.eqInt("collapsed back to one" (ms.sel.rangeCount()) 1)
        def cellRect:GridRect (ms.grid.cellRect(ms.model 3 1))
        msi.newFrame()
        msi.setModifiers(false true)
        msi.setPointerPos((cellRect.x + 4) (cellRect.y + 4))
        msi.setPointerDown(true)
        ms.update(msi)
        msi.newFrame()
        msi.setModifiers(false false)
        msi.setPointerPos((cellRect.x + 4) (cellRect.y + 4))
        msi.setPointerDown(false)
        ms.update(msi)
        c.eqInt("ctrl+click kept the old rectangle" (ms.sel.rangeCount()) 2)
        c.eqInt("and moved the active cell" ms.sel.active.row 3)
        c.ok("the scene still builds" ((strlen (ms.sceneJson())) > 500))
        ms.sel.collapseToActive()
        c.eqInt("collapsing drops the extras" (ms.sel.rangeCount()) 1)

        print "== dragging a range to move it =="
        def dm:GridApp (new GridApp)
        dm.init("gallery/pdf_writer/assets/fonts")
        dm.model.clearSheet()
        dm.model.resize(10 6)
        dm.model.setCellRaw(0 0 "a")
        dm.model.setCellRaw(0 1 "b")
        dm.model.setCellRaw(1 0 "c")
        dm.model.setFormula(1 1 "A1")
        dm.sheetView.markDirty()
        dm.sheetView.rebuild()
        dm.engine.rebuildAll()
        GridEditTest.selectRange(dm 0 0 1 1)

        def edgeRect:GridRect (dm.grid.selectionRect(dm.model dm.sel))
        c.ok("the selection has a box" (edgeRect.w > 0))
        c.ok("its edge is grabbable" (dm.grid.hitSelectionEdge(dm.model dm.sel (edgeRect.x + 2) (edgeRect.y + 2))))
        c.ok("its middle is not" ((dm.grid.hitSelectionEdge(dm.model dm.sel (edgeRect.x + (idiv edgeRect.w 2)) (edgeRect.y + (idiv edgeRect.h 2)))) == false))

        def dmi:UIInput (new UIInput)
        def dstRect:GridRect (dm.grid.cellRect(dm.model 4 2))
        dmi.newFrame()
        dmi.setPointerPos((edgeRect.x + 2) (edgeRect.y + 2))
        dmi.setPointerDown(true)
        dm.update(dmi)
        c.ok("the drag started" dm.movingRange)
        dmi.newFrame()
        dmi.setPointerPos((dstRect.x + 4) (dstRect.y + 4))
        dmi.setPointerDown(true)
        dm.update(dmi)
        c.ok("a drop target is shown" dm.view.ghostVisible)
        c.eqInt("at the dragged-to row" dm.view.ghostR0 4)
        dmi.newFrame()
        dmi.setPointerPos((dstRect.x + 4) (dstRect.y + 4))
        dmi.setPointerDown(false)
        dm.update(dmi)
        c.eqStr("the block moved" (dm.model.getCell(4 2)) "a")
        c.eqStr("all of it" (dm.model.getCell(5 2)) "c")
        c.eqStr("the source is empty" (dm.model.getCell(0 0)) "")
        c.eqStr("a moved formula is not re-based" (dm.model.getFormula(5 3)) "A1")
        c.eqInt("the selection followed" dm.sel.anchor.row 4)
        c.ok("and the ghost is gone" (dm.view.ghostVisible == false))
        dm.undoEdit()
        c.eqStr("one undo puts the block back" (dm.model.getCell(0 0)) "a")
        c.eqStr("and empties the target" (dm.model.getCell(4 2)) "")

        print "== conditional formatting rules, written rather than only read =="
        def cf:GridApp (new GridApp)
        cf.init("gallery/pdf_writer/assets/fonts")
        cf.model.clearSheet()
        cf.model.resize(6 4)
        cf.model.setCellRaw(0 0 "10")
        cf.model.setCellRaw(1 0 "80")
        cf.model.setCellRaw(2 0 "50")
        cf.sheetView.markDirty()
        cf.sheetView.rebuild()
        cf.engine.rebuildAll()
        c.eqInt("no rules to begin with" (cf.model.cfRuleCount()) 0)
        c.eqStr("so nothing is filled" (ConditionalFormat.resolveFill(cf.model 1 0)) "")

        GridEditTest.selectRange(cf 0 0 2 0)
        cf.openCfDialog()
        c.ok("the editor opened" cf.cfDialog.visible)
        cf.cfDialog.selectRadio(601)
        cf.cfDialog.setInputValue(611 "60")
        cf.cfDialog.selectRadio(623)
        cf.addCfRuleFromDialog()
        c.eqInt("a rule was added" (cf.model.cfRuleCount()) 1)
        c.eqStr("the cell over the threshold is filled" (ConditionalFormat.resolveFill(cf.model 1 0)) "#C6EFCE")
        c.eqStr("the ones under it are not" (ConditionalFormat.resolveFill(cf.model 0 0)) "")
        c.ok("the dialog stays open for the next rule" cf.cfDialog.visible)
        c.ok("and says what it did" (GridEditTest.hasSub(cf.cfStatus "added")))

        cf.cfDialog.selectRadio(602)
        cf.cfDialog.setInputValue(611 "20")
        cf.cfDialog.selectRadio(621)
        cf.addCfRuleFromDialog()
        c.eqInt("two rules" (cf.model.cfRuleCount()) 2)
        c.eqStr("the low cell picked up the second" (ConditionalFormat.resolveFill(cf.model 0 0)) "#FFC7CE")
        c.eqStr("the high one kept the first" (ConditionalFormat.resolveFill(cf.model 1 0)) "#C6EFCE")
        c.eqStr("the middle one matches neither" (ConditionalFormat.resolveFill(cf.model 2 0)) "")

        cf.clearCfRulesFromDialog()
        c.eqInt("clearing the selection's rules removes both" (cf.model.cfRuleCount()) 0)
        c.eqStr("and the fill with them" (ConditionalFormat.resolveFill(cf.model 1 0)) "")

        ; Between, and a colour scale, through the same dialog.
        cf.cfDialog.selectRadio(604)
        cf.cfDialog.setInputValue(611 "40")
        cf.cfDialog.setInputValue(612 "60")
        cf.cfDialog.selectRadio(624)
        cf.addCfRuleFromDialog()
        c.eqStr("between catches the middle value" (ConditionalFormat.resolveFill(cf.model 2 0)) "#BDD7EE")
        c.eqStr("and not the ends" (ConditionalFormat.resolveFill(cf.model 1 0)) "")
        cf.clearCfRulesFromDialog()
        cf.cfDialog.selectRadio(605)
        cf.addCfRuleFromDialog()
        c.eqInt("a colour scale is a rule too" (cf.model.cfRuleCount()) 1)
        c.ok("and it paints the range" ((strlen (ConditionalFormat.resolveFill(cf.model 1 0))) > 0))
        c.ok("scene builds with the editor up" ((strlen (cf.sceneJson())) > 500))

        cf.clearCfRulesFromDialog()
        cf.model.setCellRaw(0 0 "5")
        cf.model.setCellRaw(1 0 "-3")
        cf.model.setCellRaw(2 0 "0")
        cf.sheetView.markDirty()
        cf.sheetView.rebuild()
        cf.engine.rebuildAll()
        GridEditTest.selectRange(cf 0 0 2 0)
        cf.openCfDialog()
        cf.addCfPosNegFromDialog()
        c.eqInt("± colours adds two rules" (cf.model.cfRuleCount()) 2)
        c.eqStr("positive is green" (ConditionalFormat.resolveFill(cf.model 0 0)) "#C6EFCE")
        c.eqStr("negative is red" (ConditionalFormat.resolveFill(cf.model 1 0)) "#FFC7CE")
        c.eqStr("zero counts as positive" (ConditionalFormat.resolveFill(cf.model 2 0)) "#C6EFCE")
        cf.clearCfRulesFromDialog()
        cf.cfDialog.selectRadio(606)
        cf.cfDialog.setInputValue(611 "0")
        cf.cfDialog.selectRadio(623)
        cf.addCfRuleFromDialog()
        c.eqStr("at least 0 greens zero" (ConditionalFormat.resolveFill(cf.model 2 0)) "#C6EFCE")

        print "== the toolbar, and the formatting behind it =="
        def tb:GridApp (new GridApp)
        tb.init("gallery/pdf_writer/assets/fonts")
        def bar:GridToolbar tb.view.toolbar
        c.ok("there are buttons" ((bar.count()) > 20))

        ; Every button names a command the app actually answers to. A typo in
        ; a command string would otherwise be a button that quietly does
        ; nothing, which is the worst kind of button.
        def unknown:string ""
        def bi:int 0
        while (bi < (bar.count())) {
            def it:ToolItem (bar.at(bi))
            if (it.isSeparator == false) {
                if ((tb.commands.has(it.command)) == false) {
                    unknown = it.command
                }
                if ((strlen it.label) == 0) {
                    unknown = ("unlabelled " + it.command)
                }
            }
            bi = (bi + 1)
        }
        c.eqStr("every button names a real command" unknown ""
        )

        ; …and the buttons stay inside their own strip.
        bar.layout(0 0 900)
        def escaped:int 0
        def bj:int 0
        while (bj < (bar.count())) {
            def it2:ToolItem (bar.at(bj))
            if (it2.w > 0) {
                if (((it2.x + it2.w) > 900) || (it2.x < 0)) {
                    escaped = (escaped + 1)
                }
                if ((it2.y + it2.h) > bar.height) {
                    escaped = (escaped + 1)
                }
            }
            bj = (bj + 1)
        }
        c.eqInt("nothing hangs off the strip" escaped 0)
        ; A narrow window wraps rather than dropping the last buttons.
        def tallness:int (bar.heightFor(420))
        c.ok("a narrow strip grows instead of losing buttons" (tallness > 30))
        def visible:int 0
        def bk:int 0
        while (bk < (bar.count())) {
            def it3:ToolItem (bar.at(bk))
            if (it3.w > 0) {
                visible = (visible + 1)
            }
            bk = (bk + 1)
        }
        c.ok("all of them are still laid out" (visible > 30))
        bar.layout(0 0 900)

        print "== clicking a button formats the selection =="
        GridEditTest.selectRange(tb 1 0 2 1)
        def boldIdx:int -1
        def bx:int 0
        while (bx < (bar.count())) {
            def cand:ToolItem (bar.at(bx))
            if (cand.command == "format.bold") {
                boldIdx = bx
            }
            bx = (bx + 1)
        }
        c.ok("there is a Bold button" (boldIdx >= 0))
        c.ok("it runs" (tb.runToolbarItem(boldIdx)))
        def stA:CellStyle (tb.model.getCellStyle(1 0))
        def stB:CellStyle (tb.model.getCellStyle(2 1))
        c.ok("the whole selection went bold" (stA.bold && stB.bold))
        c.ok("and the button knows it" (bar.isPressed(boldIdx tb.model tb.sel)))
        c.ok("clicking again takes it off" (tb.runToolbarItem(boldIdx)))
        def stC:CellStyle (tb.model.getCellStyle(1 0))
        c.ok("bold is gone" (stC.bold == false))
        c.ok("and one undo puts it back" true)
        tb.undoEdit()
        def stD:CellStyle (tb.model.getCellStyle(1 0))
        c.ok("undo restored the bold" stD.bold)

        print "== the sheet is at least as big as the window shows =="
        ; A sheet comes out of a file only as big as its used range, so the
        ; grid stopped where the numbers stopped and the space beside it
        ; belonged to no cell — nothing to click. The arrow keys hid it,
        ; because they grow the sheet as the caret walks: the keyboard could
        ; reach cells the mouse could not.
        def vp:GridApp (new GridApp)
        vp.init("gallery/pdf_writer/assets/fonts")
        vp.model.resize(3 2)
        vp.model.setCell(0 0 "a")
        vp.sheetView.markDirty()
        vp.sheetView.rebuild()
        vp.grid.updateVisible(vp.model)
        c.eqInt("a small sheet starts small" vp.model.colCount 2)
        def vpIn:UIInput (new UIInput)
        vpIn.newFrame()
        vp.update(vpIn)
        c.ok("one frame fills the window across" (vp.model.colCount > 2))
        c.ok("and down" (vp.model.rowCount > 3))
        def wideX:int ((vp.grid.x + vp.grid.rowHeaderW) + 600)
        def bodyY:int (((vp.grid.headerTop()) + vp.grid.colHeaderH) + 30)
        def far:CellPos (vp.grid.hitTest(vp.model wideX bodyY))
        c.ok("so a click well past the content lands on a cell" (far.col > 1))
        c.ok("a real one, not the last one clamped" (far.row >= 0))
        ; …and the cells it made are empty, so nothing was invented: what a
        ; save writes follows the CONTENT, and there is none out here.
        c.eqStr("the new cells are empty" (vp.model.getCell(0 5)) ""
        )
        c.eqStr("all of them" (vp.model.getCell(20 7)) ""
        )

        print "== a formula being typed sits on the cell's own line =="
        ; The syntax painter draws a formula so its references keep their
        ; colours, and it used to place the text at a fixed offset from the
        ; cell's top corner — four pixels below the line every other cell in
        ; the row is on, with the bottom of every letter cut off by the clip.
        def al:GridApp (new GridApp)
        al.init("gallery/pdf_writer/assets/fonts")
        al.model.growTo(8 3)
        al.model.setCell(2 1 "102")
        al.model.setCell(4 1 "104")
        al.sheetView.markDirty()
        al.sheetView.rebuild()
        al.grid.updateVisible(al.model)
        GridEditTest.select(al 3 1)
        al.beginEdit("=SUM(" true)
        al.view.status = ""
        al.view.editCaret = al.editCaret
        al.view.windows = al.windows
        def alDl:EVGDisplayList (al.view.buildDisplayList(al.model al.sel al.grid al.editing al.editBuf al.book))
        def yAbove:int (GridEditTest.textY(alDl "102"))
        def yEdit:int (GridEditTest.textY(alDl "=SUM("))
        def yBelow:int (GridEditTest.textY(alDl "104"))
        c.ok("the row above was found" (yAbove > 0))
        c.ok("the row below too" (yBelow > 0))
        ; One row apart above and below; the edited one exactly between them.
        def step:int (idiv (yBelow - yAbove) 2)
        c.eqInt("the formula is on its own row's line" yEdit (yAbove + step))

        print "== a click only points where a reference could go =="
        ; Excel calls this point mode. After a closing bracket there is nothing
        ; a reference could mean, so a click there means what a click means
        ; everywhere else: finish this edit and select what was clicked.
        ; Without the distinction, clicking around after =SUM(F2:F14) appended
        ; to it and produced =SUM(F2:F14)F19.
        def pm:GridApp (new GridApp)
        pm.init("gallery/pdf_writer/assets/fonts")
        pm.model.growTo(24 6)
        def pmr:int 0
        while (pmr < 15) {
            pm.model.setCellRaw(pmr 5 (to_string (pmr + 1)))
            pmr = (pmr + 1)
        }
        pm.sheetView.markDirty()
        pm.sheetView.rebuild()
        pm.engine.rebuildAll()
        pm.grid.updateVisible(pm.model)
        GridEditTest.select(pm 17 1)
        pm.beginEdit("=SUM(" true)
        c.ok("after an opening bracket a click points" (pm.canPickAtCaret()))
        def pmIn:UIInput (new UIInput)
        def f2:GridRect (pm.grid.cellRect(pm.model 1 5))
        pmIn.newFrame()
        pmIn.setPointerPos((f2.x + 4) (f2.y + 4))
        pmIn.setPointerDown(true)
        pm.update(pmIn)
        def f14:GridRect (pm.grid.cellRect(pm.model 13 5))
        pmIn.newFrame()
        pmIn.setPointerPos((f14.x + 4) (f14.y + 4))
        pmIn.setPointerDown(true)
        pm.update(pmIn)
        pmIn.newFrame()
        pmIn.setPointerPos((f14.x + 4) (f14.y + 4))
        pmIn.setPointerDown(false)
        pm.update(pmIn)
        c.eqStr("dragging picks the range" pm.editBuf "=SUM(F2:F14"
        )
        pm.insertAtCaret(")")
        c.ok("after the closing bracket it does not point" ((pm.canPickAtCaret()) == false))
        def f19:GridRect (pm.grid.cellRect(pm.model 18 5))
        pmIn.newFrame()
        pmIn.setPointerPos((f19.x + 4) (f19.y + 4))
        pmIn.setPointerDown(true)
        pm.update(pmIn)
        pmIn.newFrame()
        pmIn.setPointerPos((f19.x + 4) (f19.y + 4))
        pmIn.setPointerDown(false)
        pm.update(pmIn)
        c.ok("the click finished the edit instead" (pm.editing == false))
        c.eqStr("with the formula it had" (pm.model.getFormula(17 1)) "SUM(F2:F14)"
        )
        c.eqStr("and the right answer" (pm.model.getCell(17 1)) "104"
        )
        c.eqInt("and selected what was clicked" pm.sel.active.row 18)
        c.eqInt("in its column" pm.sel.active.col 5)
        ; The operators a reference CAN follow.
        c.ok("after an equals" (GridApp.startsReference(61)))
        c.ok("after a comma" (GridApp.startsReference(44)))
        c.ok("after a plus" (GridApp.startsReference(43)))
        c.ok("but not after a bracket that closes" ((GridApp.startsReference(41)) == false))
        c.ok("nor after a digit" ((GridApp.startsReference(53)) == false))
        c.ok("nor after a letter" ((GridApp.startsReference(65)) == false))

        print "== the rest of the formatting commands =="
        GridEditTest.selectRange(tb 4 0 4 2)
        c.ok("centre" (tb.runCommand("format.align" "center")))
        def alignSt:CellStyle (tb.model.getCellStyle(4 1))
        c.eqStr("alignment took" alignSt.align "center"
        )
        c.ok("middle" (tb.runCommand("format.valign" "center")))
        def vSt:CellStyle (tb.model.getCellStyle(4 1))
        c.eqStr("vertical alignment took" vSt.valign "center"
        )
        c.ok("currency" (tb.runCommand("format.numfmt" "currency")))
        def numSt:CellStyle (tb.model.getCellStyle(4 1))
        c.eqStr("number format took" numSt.numFmt "$#,##0.00"
        )
        c.ok("one more decimal" (tb.runCommand("format.decimals" "more")))
        def decSt:CellStyle (tb.model.getCellStyle(4 1))
        c.eqStr("the format grew a place" decSt.numFmt "$#,##0.000"
        )
        c.ok("one fewer" (tb.runCommand("format.decimals" "less")))
        def dec2:CellStyle (tb.model.getCellStyle(4 1))
        c.eqStr("and lost it again" dec2.numFmt "$#,##0.00"
        )
        c.ok("borders" (tb.runCommand("format.border" "all")))
        def bSt:CellStyle (tb.model.getCellStyle(4 1))
        c.ok("a border was set" bSt.hasBorder)
        print "-- the row makes room when the type grows --"
        ; A spreadsheet grows the row when the type in it gets bigger; Sheets
        ; and Excel both do, and text that no longer fits its row is text that
        ; climbs into the row above.
        def rowBefore:int (tb.model.rowHeight(4))
        c.ok("bigger" (tb.runCommand("format.size.up" "")))
        def sizeSt:CellStyle (tb.model.getCellStyle(4 1))
        c.ok("the text grew" (sizeSt.fontSizePt > 11.0))
        def bigTimes:int 0
        while (bigTimes < 6) {
            tb.runCommand("format.size.up" "")
            bigTimes = (bigTimes + 1)
        }
        def rowBig:int (tb.model.rowHeight(4))
        c.ok("and the row grew with it" (rowBig > rowBefore))
        def bigSt:CellStyle (tb.model.getCellStyle(4 1))
        c.ok("enough for the line" (rowBig >= (CellStyle.rowHeightForPt(bigSt.fontSizePt))))
        ; Shrinking the type takes the room back to what the line needs —
        ; that is what A− is for. A height the user dragged out is still
        ; theirs until they change the type or auto-fit the row.
        def smallTimes:int 0
        while (smallTimes < 7) {
            tb.runCommand("format.size.down" "")
            smallTimes = (smallTimes + 1)
        }
        def rowSmall:int (tb.model.rowHeight(4))
        c.ok("smaller type shrinks the row again" (rowSmall < rowBig))
        def smallSt:CellStyle (tb.model.getCellStyle(4 1))
        c.ok("and fits the smaller type" (rowSmall >= (CellStyle.rowHeightForPt(smallSt.fontSizePt))))
        c.ok("size dropdown opens" (tb.runCommand("format.size.pick" "")))
        c.ok("the size menu is up" tb.view.menuOpen)
        c.eqInt("as a size picker" tb.view.menuKind 2)
        tb.runFontSizeMenu(5)
        c.ok("picking a size closes it" (tb.view.menuOpen == false))
        def picked:CellStyle (tb.model.getCellStyle(4 1))
        c.ok("12 pt from the menu" (picked.fontSizePt == 12.0))
        c.ok("font dropdown opens" (tb.runCommand("format.font" "")))
        c.eqInt("as a font picker" tb.view.menuKind 3)
        tb.runFontNameMenu(7)
        def named:CellStyle (tb.model.getCellStyle(4 1))
        c.eqStr("Noto Sans from the menu" named.fontName "Noto Sans")
        c.ok("and a direct font arg still works" (tb.runCommand("format.font" "Helvetica")))
        def helv:CellStyle (tb.model.getCellStyle(4 1))
        c.eqStr("Helvetica applied" helv.fontName "Helvetica")
        ; The paint path used to wipe the named face back to Open Sans on every
        ; TEXT command. The scene must carry the resolved face the cell asked for.
        tb.model.setCellRaw(4 1 "FontProbe")
        def fontScene:string (tb.sceneJson())
        c.ok("scene paints Helvetica" (GridEditTest.hasSub(fontScene "\"font\":\"Helvetica\"")))
        c.ok("and the probe text" (GridEditTest.hasSub(fontScene "FontProbe")))
        ; Hover tip: the toolbar's hot label is what the tooltip paints.
        tb.view.toolbar.layout(tb.grid.x (tb.grid.toolbarY()) tb.grid.w)
        def tipIdx:int -1
        def ti:int 0
        while (ti < (tb.view.toolbar.count())) {
            def it:ToolItem (tb.view.toolbar.at(ti))
            if (it.command == "format.bold") {
                tipIdx = ti
            }
            ti = (ti + 1)
        }
        c.ok("bold is on the bar" (tipIdx >= 0))
        tb.view.toolbar.hot = tipIdx
        c.eqStr("tooltip names the command" (tb.view.toolbar.hotLabel()) "Bold")
        tb.view.toolbar.hot = -1
        tb.model.setRowHeight(4 rowBefore)
        c.ok("fill" (tb.runCommand("format.fill" "#FFF2CC")))
        def fillSt:CellStyle (tb.model.getCellStyle(4 1))
        c.ok("the fill took" fillSt.hasFill)
        c.ok("clearing" (tb.runCommand("format.clear" "")))
        def clearSt:CellStyle (tb.model.getCellStyle(4 1))
        c.ok("everything is plain again" ((clearSt.hasFill == false) && (clearSt.align == "left")))

        print "== colour palette modal from the toolbar =="
        GridEditTest.select(tb 4 1)
        c.ok("text colour with no arg opens the picker" (tb.runCommand("format.color" "")))
        c.ok("the colour dialog is up" tb.colorDialog.visible)
        c.eqStr("it is editing text colour" tb.colorDialogOp "color")
        def colorScene:string (tb.sceneJson())
        c.ok("scene names the dialog" (GridEditTest.hasSub(colorScene "Text colour")))
        c.ok("the dialog keeps a preview slot" tb.colorDialog.hasContent)
        tb.colorDialog.selectRadio(903)
        tb.refreshColorDialogSelection()
        def liveSt:CellStyle (tb.model.getCellStyle(4 1))
        c.eqStr("picking a swatch paints the sheet immediately" liveSt.textRgb "#C00000")
        c.eqStr("and the example cell tracks it" tb.view.colorPreviewHex "#C00000")
        tb.cancelColorDialog()
        c.ok("cancel closes it" (tb.colorDialog.visible == false))
        def reverted:CellStyle (tb.model.getCellStyle(4 1))
        c.eqStr("cancel puts the cell back" reverted.textRgb "")

        c.ok("text colour opens again" (tb.runCommand("format.color" "")))
        tb.colorDialog.selectRadio(903)
        tb.applyColorDialog()
        c.ok("apply closes it" (tb.colorDialog.visible == false))
        def colSt:CellStyle (tb.model.getCellStyle(4 1))
        c.eqStr("and paints the active cell" colSt.textRgb "#C00000")
        c.ok("recent colours remember the choice" ((array_length tb.colorRecent) > 0))
        c.eqStr("the first recent is what was applied" (itemAt tb.colorRecent 0) "#C00000")

        c.ok("fill with no arg opens the fill picker" (tb.runCommand("format.fill" "")))
        c.ok("fill dialog visible" tb.colorDialog.visible)
        c.eqStr("mode is fill" tb.colorDialogOp "fill")
        tb.colorDialog.selectRadio(929)
        tb.refreshColorDialogSelection()
        def liveFill:CellStyle (tb.model.getCellStyle(4 1))
        c.ok("fill preview is live" liveFill.hasFill)
        c.eqStr("amber fill on the sheet while picking" liveFill.fillRgb "#FFF2CC")
        tb.applyColorDialog()
        def fillPick:CellStyle (tb.model.getCellStyle(4 1))
        c.ok("fill from the palette" fillPick.hasFill)
        c.eqStr("amber fill applied" fillPick.fillRgb "#FFF2CC")
        c.ok("empty fill arg still applies a hex directly" (tb.runCommand("format.fill" "#BDD7EE")))
        def fillDirect:CellStyle (tb.model.getCellStyle(4 1))
        c.eqStr("direct hex bypasses the modal" fillDirect.fillRgb "#BDD7EE")
        c.ok("clearing after palette" (tb.runCommand("format.clear" "")))
        def clearSt2:CellStyle (tb.model.getCellStyle(4 1))
        c.ok("plain again after palette tests" (clearSt2.hasFill == false))

        print "== opening and saving: what the app asks its host for =="
        ; The app cannot open a file picker — it does not know whether it is in
        ; a browser, a window, or on the end of a socket. So it says what it
        ; wants and the host answers. Everything below the picker is the same
        ; code either way, which is why it can be checked here.
        c.eqStr("nothing is wanted to begin with" tb.fileRequest ""
        )
        ; New stays inside the app: a blank sheet, no path, no host dialog.
        tb.model.setCellRaw(0 0 "keep me")
        c.ok("New clears the sheet" (tb.runCommand("file.new" "")))
        c.eqStr("New does not ask the host" tb.fileRequest ""
        )
        c.eqStr("New has no path yet" tb.book.sourcePath ""
        )
        c.eqStr("New sheet is blank" (tb.model.getCell(0 0)) ""
        )
        c.eqStr("New sheet is called Sheet1" tb.model.name "Sheet1"
        )
        c.eqStr("suggested Save As name" (tb.suggestSaveName()) "workbook.xlsx"
        )
        def blankBytes:buffer (tb.saveXlsxBytes())
        c.ok("blank book packs to .xlsx bytes" ((buffer_length blankBytes) > 100)
        )
        ; Save with no path asks Save As — that is how a new file gets written.
        c.ok("Save on a new book asks where" (tb.runCommand("file.save" "")))
        c.eqStr("Save becomes Save As" tb.fileRequest "saveAs"
        )
        tb.fileRequest = ""
        c.ok("Open asks" (tb.runCommand("file.open" "")))
        c.eqStr("and says what for" tb.fileRequest "open"
        )
        tb.fileRequest = ""
        c.ok("Save a copy asks too" (tb.runCommand("file.saveAs" "")))
        c.eqStr("with its own answer" tb.fileRequest "saveAs"
        )
        tb.fileRequest = ""
        ; Ctrl+N, through the keyboard rather than the button.
        def nk (new UIInput)
        nk.newFrame()
        nk.setModifiers(false true)
        nk.pushText("n")
        tb.update(nk)
        c.eqStr("Ctrl+N makes a blank book" tb.book.sourcePath ""
        )
        c.eqStr("Ctrl+N does not ask the host" tb.fileRequest ""
        )
        ; Ctrl+O, through the keyboard rather than the button.
        def ok (new UIInput)
        ok.newFrame()
        ok.setModifiers(false true)
        ok.pushText("o")
        tb.update(ok)
        c.eqStr("Ctrl+O asks to open" tb.fileRequest "open"
        )
        tb.fileRequest = ""
        ; Ctrl+S still writes beside the source; Ctrl+Shift+S asks instead.
        def sh (new UIInput)
        sh.newFrame()
        sh.setModifiers(true true)
        sh.pushText("s")
        tb.update(sh)
        c.eqStr("Ctrl+Shift+S asks where to put a copy" tb.fileRequest "saveAs"
        )
        tb.fileRequest = ""

        print "-- and the path a chosen target splits into --"
        ; A "save as" writes what the person typed, not a name with `-export`
        ; bolted on — that is a different question with a different answer.
        c.eqStr("the folder" (GridApp.exportDir("/Users/tero/Docs/Kassa 2011.xlsx")) "/Users/tero/Docs"
        )
        c.eqStr("the file, as written" (GridApp.baseName("/Users/tero/Docs/Kassa 2011.xlsx")) "Kassa 2011.xlsx"
        )
        c.eqStr("a bare name is its own file" (GridApp.baseName("book.xlsx")) "book.xlsx"
        )
        c.eqStr("and a folder is still where it goes" (GridApp.exportDir("book.xlsx")) "."
        )
        c.eqStr("a copy is named apart from its source" (GridApp.exportName("/tmp/Kassa.xlsx")) "Kassa-export.xlsx"
        )

        print "== merge and freeze from the toolbar =="
        GridEditTest.selectRange(tb 8 0 8 2)
        c.ok("merge" (tb.runCommand("format.merge" "")))
        c.ok("the range is merged" ((strlen (tb.model.mergeAt(8 1))) > 0))
        c.ok("and the same button unmerges" (tb.runCommand("format.merge" "")))
        c.ok("it is gone" ((strlen (tb.model.mergeAt(8 1))) == 0))
        GridEditTest.select(tb 3 2)
        c.ok("freeze here" (tb.runCommand("view.freeze.here" "")))
        c.eqInt("rows frozen" tb.model.freezeRows 3)
        c.eqInt("columns frozen" tb.model.freezeCols 2)
        c.ok("and unfreeze" (tb.runCommand("view.freeze.none" "")))
        c.eqInt("no rows frozen" tb.model.freezeRows 0)

        ; Ctrl+B, through the keyboard rather than the button.
        def kb (new UIInput)
        GridEditTest.select(tb 6 1)
        kb.newFrame()
        kb.setModifiers(false true)
        kb.pushText("b")
        tb.update(kb)
        def kbSt:CellStyle (tb.model.getCellStyle(6 1))
        c.ok("Ctrl+B bolds the cell" kbSt.bold)
        kb.newFrame()
        kb.setModifiers(false true)
        kb.pushText("i")
        tb.update(kb)
        def kbSt2:CellStyle (tb.model.getCellStyle(6 1))
        c.ok("Ctrl+I italicises it" kbSt2.italic)

        print "== the grid is the size Excel says it is =="
        ; A column width in a file is measured in CHARACTERS of the default
        ; font, and the conversion is round(w x 7) + 5 — seven being the width
        ; of the widest digit at eleven points. This used a factor of eight, so
        ; every column came out a seventh wider than the file asked for, and a
        ; sheet with no widths at all used 100-pixel columns against Excel's
        ; 64. Nothing was wrong with the text; there was just half a column too
        ; much grid around it.
        c.eqInt("Excel's default column width" (XlsxWorksheet.colWidthToPx(8.43)) 64)
        c.eqInt("ten characters" (XlsxWorksheet.colWidthToPx(10.0)) 75)
        c.eqInt("a row of fifteen points" (XlsxWorksheet.rowHeightToPx(15.0)) 20)
        def metrics:SpreadsheetModel (new SpreadsheetModel)
        c.eqInt("a sheet with no widths of its own" metrics.defaultColW 64)
        c.eqInt("…and no heights" metrics.defaultRowH 20)

        print "== a sheet name stays inside its tab =="
        def tabApp:GridApp (new GridApp)
        tabApp.init("gallery/pdf_writer/assets/fonts")
        def tabSheet:SpreadsheetModel (tabApp.model)
        tabSheet.name = "Consolidated Forecast (draft) 2026"
        tabApp.render()
        def tabDl:EVGDisplayList (tabApp.view.buildDisplayList(tabApp.model tabApp.sel tabApp.grid tabApp.editing tabApp.editBuf tabApp.book))
        c.ok("the tab layout was recorded" ((array_length tabApp.grid.tabXs) > 0))
        def tabW0:int (itemAt tabApp.grid.tabWs 0)
        def tabX0:int (itemAt tabApp.grid.tabXs 0)
        ; The label painted inside the first tab — the band is bounded on both
        ; sides so the status bar underneath is not mistaken for it.
        def bandTop:double (to_double (tabApp.grid.sheetTabY()))
        def bandBottom:double (to_double ((tabApp.grid.sheetTabY()) + tabApp.grid.sheetTabH))
        def longest:int 0
        def ti:int 0
        while (ti < (array_length tabDl.cmds)) {
            def tc:EVGDrawCmd (itemAt tabDl.cmds ti)
            if (tc.kind == 3) {
                if (tc.y >= bandTop) {
                    if (tc.y < bandBottom) {
                        if (tc.x >= (to_double tabX0)) {
                            if (tc.x < (to_double (tabX0 + tabW0))) {
                                def right:int (to_int (tc.x + tc.w))
                                if (right > longest) {
                                    longest = right
                                }
                            }
                        }
                    }
                }
            }
            ti = (ti + 1)
        }
        c.ok("the tab has a label in it" (longest > tabX0))
        c.ok("the name was cut to fit" (longest <= (tabX0 + tabW0)))
        c.ok("and the tab is no wider than the strip allows" (tabW0 <= 190))
        ; A short name gets a snug tab rather than a fixed slot.
        def shortSheet:GridApp (new GridApp)
        shortSheet.init("gallery/pdf_writer/assets/fonts")
        shortSheet.model.name = "Q1"
        shortSheet.render()
        c.ok("a short name gets a short tab" ((itemAt shortSheet.grid.tabWs 0) < 190))
        ; …and clicking it still finds the right sheet.
        def hitX:int ((itemAt shortSheet.grid.tabXs 0) + 4)
        def hitY:int ((shortSheet.grid.sheetTabY()) + 6)
        c.eqInt("clicking a tab lands on its sheet" (shortSheet.grid.hitSheetTab((shortSheet.book.sheetCount()) hitX hitY)) 0)

        print "== the wheel can reach a column off the right edge =="
        def scrollApp:GridApp (new GridApp)
        scrollApp.init("gallery/pdf_writer/assets/fonts")
        scrollApp.model.growTo(40 60)
        scrollApp.grid.updateVisible(scrollApp.model)
        def firstBefore:int scrollApp.grid.firstVisibleCol
        def lastBefore:int scrollApp.grid.lastVisibleCol
        def wheel (new UIInput)
        wheel.newFrame()
        wheel.setModifiers(true false)
        wheel.addScroll(-3)
        scrollApp.update(wheel)
        c.ok("shift and the wheel move sideways" (scrollApp.grid.firstVisibleCol > firstBefore))
        c.ok("which brings new columns into view" (scrollApp.grid.lastVisibleCol > lastBefore))
        def sideways (new UIInput)
        sideways.newFrame()
        sideways.addScrollX(-2)
        def firstMid:int scrollApp.grid.firstVisibleCol
        scrollApp.update(sideways)
        c.ok("a trackpad's own sideways notches do too" (scrollApp.grid.firstVisibleCol > firstMid))
        def back (new UIInput)
        back.newFrame()
        back.addScrollX(20)
        scrollApp.update(back)
        c.eqInt("and it comes back to the first column" scrollApp.grid.firstVisibleCol 0)

        print "== vertical wheel follows UIInput (+up / -down) =="
        def vScroll:GridApp (new GridApp)
        vScroll.init("gallery/pdf_writer/assets/fonts")
        vScroll.model.growTo(80 8)
        vScroll.grid.updateVisible(vScroll.model)
        def y0:int vScroll.grid.scrollY
        def down (new UIInput)
        down.newFrame()
        down.addScroll(-3)
        vScroll.update(down)
        c.ok("wheel down increases scrollY" (vScroll.grid.scrollY > y0))
        def midY:int vScroll.grid.scrollY
        def up (new UIInput)
        up.newFrame()
        up.addScroll(3)
        vScroll.update(up)
        c.ok("wheel up decreases scrollY" (vScroll.grid.scrollY < midY))

        print "== every dialog keeps its controls inside itself =="
        def dlg:GridApp (new GridApp)
        dlg.init("gallery/pdf_writer/assets/fonts")
        dlg.findQuery = "Widget"
        dlg.replaceWith = "Gizmo"
        dlg.findStatus = "found C2"
        GridEditTest.selectRange(dlg 0 0 3 2)

        dlg.openFindDialog()
        c.eqStr("find and replace" (GridEditTest.firstEscapee(dlg.findDialog)) "")
        dlg.findDialog.close()
        dlg.openPasteSpecial()
        c.eqStr("paste special" (GridEditTest.firstEscapee(dlg.pasteDialog)) "")
        dlg.pasteDialog.close()
        dlg.openChartDialog(0)
        c.eqStr("chart picker" (GridEditTest.firstEscapee(dlg.chartDialog)) "")
        dlg.chartDialog.close()
        dlg.openCfDialog()
        c.eqStr("conditional formatting" (GridEditTest.firstEscapee(dlg.cfDialog)) "")
        dlg.cfDialog.close()
        dlg.openValidationDialog()
        c.eqStr("data validation" (GridEditTest.firstEscapee(dlg.dvDialog)) "")
        dlg.dvDialog.close()
        dlg.openLinkDialog()
        c.eqStr("hyperlink" (GridEditTest.firstEscapee(dlg.linkDialog)) "")
        dlg.linkDialog.close()
        dlg.openColorDialog("color" "#C00000")
        c.eqStr("colour palette" (GridEditTest.firstEscapee(dlg.colorDialog)) "")
        dlg.colorDialog.close()

        ; A narrow panel is the case that broke: the row has to shrink, and
        ; then wrap, rather than run off the edge.
        def narrow:EVGWindow (new EVGWindow)
        narrow.w = 200
        narrow.reset()
        narrow.addLabel("four buttons in a narrow panel")
        def nIds:[int]
        def nLabels:[string]
        push nIds 1
        push nLabels "Close"
        push nIds 2
        push nLabels "Replace all"
        push nIds 3
        push nLabels "Replace"
        push nIds 4
        push nLabels "Find next"
        narrow.addButtonRow(nIds nLabels 4)
        narrow.finish()
        c.eqStr("a narrow row stays inside" (GridEditTest.firstEscapee(narrow)) "")
        def firstBtn:EVGControl (narrow.controlById(1))
        def lastBtn:EVGControl (narrow.controlById(4))
        c.ok("it wrapped onto two rows" (lastBtn.y > firstBtn.y))
        c.ok("the default button is on the last row, at the right" (((lastBtn.x + lastBtn.w) + narrow.padX) >= narrow.w))

        ; And an absurdly narrow one still produces something drawable.
        def tiny:EVGWindow (new EVGWindow)
        tiny.w = 90
        tiny.reset()
        def tIds:[int]
        def tLabels:[string]
        push tIds 1
        push tLabels "Cancel"
        push tIds 2
        push tLabels "OK"
        tiny.addButtonRow(tIds tLabels 2)
        tiny.finish()
        c.eqStr("even a tiny panel keeps them in" (GridEditTest.firstEscapee(tiny)) "")

        print "== the command surface =="
        def api:GridApp (new GridApp)
        api.init("gallery/pdf_writer/assets/fonts")
        api.model.clearSheet()
        api.model.resize(12 6)
        api.model.setCellRaw(0 0 "one")
        api.model.setCellRaw(1 0 "two")
        api.model.setCellRaw(2 0 "three")
        api.sheetView.markDirty()
        api.sheetView.rebuild()
        api.engine.rebuildAll()

        c.ok("the table is not empty" ((api.commands.count()) > 20))
        c.ok("and can be looked up by name" (api.commands.has("edit.copy")))
        c.ok("an unknown name is not in it" ((api.commands.has("edit.nonsense")) == false))
        def copyCmd:GridCommand (api.commands.find("edit.copy"))
        c.eqStr("commands describe themselves" copyCmd.label "Copy")
        c.eqStr("and say where they belong" copyCmd.group "Edit")
        c.eqStr("and which key already runs them" copyCmd.key "Ctrl+C")
        def gotoCmd:GridCommand (api.commands.find("nav.goto"))
        c.ok("a command that needs an argument says so" gotoCmd.takesArg)
        c.ok("the table serialises for a host over a socket" (GridEditTest.hasSub((api.commands.toJson()) "\"id\":\"edit.copy\"")))

        print "-- running them by name --"
        c.ok("an unknown command is refused" ((api.runCommand("edit.nonsense" "")) == false))
        c.ok("goto moves the selection" (api.runCommand("nav.goto" "B7")))
        c.eqInt("to that row" api.sel.active.row 6)
        c.eqInt("and column" api.sel.active.col 1)
        GridEditTest.select(api 0 0)
        c.ok("insert row runs" (api.runCommand("insert.row.below" "")))
        c.eqStr("and did what it says" (api.model.getCell(2 0)) "two")
        c.ok("undo runs" (api.runCommand("edit.undo" "")))
        c.eqStr("and undid it" (api.model.getCell(1 0)) "two")
        GridEditTest.selectRange(api 0 0 2 0)
        c.ok("copy runs" (api.runCommand("edit.copy" "")))
        c.ok("putting something on the clipboard" ((strlen api.clipboardTsv) > 0))
        c.ok("a dialog command opens its dialog" (api.runCommand("edit.find" "")))
        c.ok("which is up" api.findDialog.visible)
        api.findDialog.close()

        print "-- a host's own tool --"
        api.addCustomCommand("acme.report" "Report" "Tools")
        c.ok("it joins the table" (api.commands.has("acme.report")))
        c.eqInt("and is counted as custom" (api.commands.customCount()) 1)
        def tool:GridCommand (api.commands.customAt(0))
        c.eqStr("with the host's label" tool.label "Report")
        c.ok("running it succeeds" (api.runCommand("acme.report" "q3")))
        c.eqStr("the app did not invent a meaning for it" (api.takeCustomCommand()) "acme.report")
        c.eqStr("and kept the argument" (api.takeCustomArg()) "q3")
        c.eqStr("the mailbox is empty once collected" (api.takeCustomCommand()) "")
        c.ok("registering the same id twice is a no-op" ((api.commands.customCount()) == 1))
        api.addCustomCommand("acme.report" "Report" "Tools")
        c.eqInt("still one" (api.commands.customCount()) 1)

        ; The tool is reachable with the pointer, not only by name.
        def ti:UIInput (new UIInput)
        def bx:int ((GridView.toolButtonX(api.W 0)) + 8)
        def by:int ((GridView.chartButtonY((api.grid.y + api.grid.h))) + 6)
        c.eqInt("the button is where it is painted" (api.toolButtonHit(bx by)) 0)
        ti.newFrame()
        ti.setPointerPos(bx by)
        ti.setPointerDown(true)
        api.update(ti)
        c.eqStr("clicking it posts the same id" (api.takeCustomCommand()) "acme.report")
        c.ok("and the grid still renders with a tool on the bar" ((strlen (api.sceneJson())) > 500))

        print ("passed=" + (to_string c.passed) + " failed=" + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }
}

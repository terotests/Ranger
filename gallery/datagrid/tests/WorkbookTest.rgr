; ==============================================================================
; WorkbookTest - number formats, formulas, sort/filter, hidden, multi-sheet.
; ==============================================================================

Import "../src/GridApp.rgr"
Import "../src/XlsxNumberFormat.rgr"
Import "../src/FormulaEngine.rgr"
Import "../src/SheetView.rgr"
Import "../src/ConditionalFormat.rgr"
Import "../src/xlsx/XlsxLoader.rgr"

class Checker {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        this.ok((name + " (got '" + got + "' want '" + want + "')") (got == want))
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }
}

class WorkbookTest {
    sfn main:void () {
        def c:Checker (new Checker)

        print "== number format engine =="
        c.eqStr("int" (XlsxNumberFormat.format("42" "0")) "42")
        c.eqStr("dec" (XlsxNumberFormat.format("4.5" "0.00")) "4.50")
        c.eqStr("pct" (XlsxNumberFormat.format("0.25" "0%")) "25%")
        c.eqStr("pct2" (XlsxNumberFormat.format("0.256" "0.00%")) "25.60%")
        c.eqStr("usd" (XlsxNumberFormat.format("1999.5" "$#,##0.00")) "$1,999.50")
        c.eqStr("sci" (XlsxNumberFormat.format("12345" "0.00E+00")) "1.23E+04")
        c.eqStr("neg sec" (XlsxNumberFormat.format("-3" "#,##0.00;-#,##0.00;-")) "-3.00")
        c.eqStr("zero sec" (XlsxNumberFormat.format("0" "#,##0.00;-#,##0.00;-")) "-")
        c.eqStr("text" (XlsxNumberFormat.format("hi" "@")) "hi")

        print "== formula engine =="
        def book:WorkbookModel (new WorkbookModel)
        def s:SpreadsheetModel (new SpreadsheetModel)
        s.name = "Calc"
        s.resize(20 10)
        s.setCellRaw(0 0 "10")
        s.setCellRaw(1 0 "20")
        s.setFormula(0 1 "A1+A2")
        s.setFormula(0 2 "B1*2")
        s.setFormula(0 3 "SUM(A1:A2)")
        s.setFormula(0 4 "IF(A1>5,1,0)")
        book.addSheet(s)
        def eng:FormulaEngine (new FormulaEngine)
        eng.attach(book)
        eng.rebuildAll()
        c.eqStr("B1" (s.getCell(0 1)) "30")
        c.eqStr("C1" (s.getCell(0 2)) "60")
        c.eqStr("D1 SUM" (s.getCell(0 3)) "30")
        c.eqStr("E1 IF" (s.getCell(0 4)) "1")
        s.setCellRaw(0 0 "11")
        eng.onCellEdited(0 0 0)
        c.eqStr("recalc B1" (s.getCell(0 1)) "31")
        c.eqStr("recalc C1" (s.getCell(0 2)) "62")

        print "== cycle detection =="
        def s2:SpreadsheetModel (new SpreadsheetModel)
        s2.name = "Cyc"
        s2.resize(5 5)
        s2.setFormula(0 0 "B1")
        s2.setFormula(0 1 "A1")
        def book2:WorkbookModel (new WorkbookModel)
        book2.addSheet(s2)
        def eng2:FormulaEngine (new FormulaEngine)
        eng2.attach(book2)
        eng2.rebuildAll()
        c.ok("cycle error" (((s2.getCell(0 0)) == "#CYCLE!") || ((s2.getCell(0 1)) == "#CYCLE!")))

        print "== hidden rows/cols =="
        def m:SpreadsheetModel (new SpreadsheetModel)
        m.resize(10 5)
        def h0:int (m.totalHeight())
        m.setRowHidden(3 true)
        m.ensureGeometry()
        c.ok("hidden shrinks height" ((m.totalHeight()) < h0))
        def w0:int (m.totalWidth())
        m.setColHidden(2 true)
        m.ensureGeometry()
        c.ok("hidden shrinks width" ((m.totalWidth()) < w0))

        print "== filter =="
        m.setCellRaw(0 0 "H")
        m.setCellRaw(1 0 "A")
        m.setCellRaw(2 0 "B")
        m.setCellRaw(3 0 "A")
        m.setFreeze(1 0)
        def vals:[string]
        push vals "A"
        m.setFilter(0 true vals)
        m.ensureGeometry()
        def y2:int (m.rowToY(2))
        def y3:int (m.rowToY(3))
        c.ok("filter suppressed B row height" ((y3 - y2) == 0))

        print "== sheet view sort =="
        def sv:SheetView (new SheetView)
        def ms:SpreadsheetModel (new SpreadsheetModel)
        ms.resize(4 2)
        ms.setCellRaw(0 0 "h")
        ms.setCellRaw(1 0 "3")
        ms.setCellRaw(2 0 "1")
        ms.setCellRaw(3 0 "2")
        ms.setFreeze(1 0)
        ms.setSort(0 true)
        sv.attach(ms)
        c.eqInt("sorted first body" (sv.modelRow(1)) 2)
        c.eqInt("header stays" (sv.modelRow(0)) 0)

        print "== formats.xlsx =="
        def loader:XlsxLoader (new XlsxLoader)
        def bookF:WorkbookModel (new WorkbookModel)
        def okF:boolean (loader.loadPath("gallery/datagrid/fixtures/formats.xlsx" bookF))
        c.ok("formats load" okF)

        print "== formulas.xlsx =="
        def bookFm:WorkbookModel (new WorkbookModel)
        def okFm:boolean (loader.loadPath("gallery/datagrid/fixtures/formulas.xlsx" bookFm))
        c.ok("formulas load" okFm)
        if okFm {
            def calc:SpreadsheetModel (bookFm.sheetAt(0))
            c.eqStr("xlsx B1" (calc.getCell(0 1)) "30")
            c.eqStr("xlsx C1" (calc.getCell(0 2)) "60")
            c.eqStr("xlsx cross" (calc.getCell(0 7)) "21")
        }

        print "== business-workbook.xlsx =="
        def bookB:WorkbookModel (new WorkbookModel)
        def okB:boolean (loader.loadPath("gallery/datagrid/fixtures/business-workbook.xlsx" bookB))
        c.ok("business load" okB)
        if okB {
            c.ok("sheets >= 4" ((bookB.sheetCount()) >= 4))
            def sales:SpreadsheetModel (bookB.sheetAt(0))
            c.eqStr("Sales name" sales.name "Sales")
            c.eqInt("freeze" sales.freezeRows 1)
            c.ok("many rows" (sales.rowCount >= 200))
            def costs:SpreadsheetModel (bookB.sheetAt(1))
            c.ok("helper col hidden" (costs.isColHidden(4)))
        }

        print "== merged.xlsx =="
        def bookM:WorkbookModel (new WorkbookModel)
        def okM:boolean (loader.loadPath("gallery/datagrid/fixtures/merged.xlsx" bookM))
        c.ok("merged load" okM)
        if okM {
            def mg:SpreadsheetModel (bookM.activeSheet())
            c.ok("has merges" ((array_length mg.merges) >= 3))
            c.ok("A1 origin" (mg.isMergeOrigin(0 0)))
            c.ok("B1 not origin" (mg.isMergeOrigin(0 1) == false))
        }

        print "== GridApp business render =="
        def app:GridApp (new GridApp)
        app.init("gallery/pdf_writer/assets/fonts")
        def loaded:boolean (app.loadXlsx("gallery/datagrid/fixtures/business-workbook.xlsx"))
        c.ok("app business" loaded)
        app.render()
        c.ok("framebuffer" ((buffer_length (app.raw())) > 1000))
        app.applySort(1 true)
        c.ok("sort applied" (app.model.sortedCol == 1))
        def fvals:[string]
        push fvals "North"
        app.applyFilter(1 fvals)
        c.ok("filter on" app.model.filterEnabled)
        c.ok("sheetview bound" app.grid.hasView)
        def vr0:int (app.sheetView.modelRow(1))
        c.ok("view row mapped" (vr0 >= 0))
        app.openHeaderMenu(1 100 50)
        c.ok("menu open" app.view.menuOpen)
        app.closeHeaderMenu()

        print "== structural undo/redo restores cross-sheet formulas =="
        def xb:GridApp (new GridApp)
        xb.init("gallery/pdf_writer/assets/fonts")
        xb.book.clear()
        def s1:SpreadsheetModel (new SpreadsheetModel)
        s1.name = "Sheet1"
        s1.resize(5 5)
        s1.setCellRaw(0 0 "10")
        s1.setCellRaw(0 1 "20")
        s1.setFormula(0 2 "B1")
        def s2:SpreadsheetModel (new SpreadsheetModel)
        s2.name = "Sheet2"
        s2.resize(5 5)
        s2.setFormula(0 0 "Sheet1!B1")
        s2.setFormula(0 1 "A1*2")
        xb.book.addSheet(s1)
        xb.book.addSheet(s2)
        xb.book.setActive(0)
        xb.engine.attach(xb.book)
        xb.syncActiveModel()
        xb.engine.rebuildAll()
        c.eqStr("same-sheet baseline" (s1.getFormula(0 2)) "B1")
        c.eqStr("cross-sheet baseline" (s2.getFormula(0 0)) "Sheet1!B1")
        c.eqStr("Sheet2 local baseline" (s2.getFormula(0 1)) "A1*2")
        xb.insertColumn(0)
        c.eqStr("same-sheet shifted" (s1.getFormula(0 3)) "C1")
        c.eqStr("cross-sheet shifted" (s2.getFormula(0 0)) "Sheet1!C1")
        c.eqStr("Sheet2 local untouched" (s2.getFormula(0 1)) "A1*2")
        xb.undoEdit()
        c.eqStr("undo same-sheet" (s1.getFormula(0 2)) "B1")
        c.eqStr("undo cross-sheet" (s2.getFormula(0 0)) "Sheet1!B1")
        c.eqStr("undo keeps Sheet2 local" (s2.getFormula(0 1)) "A1*2")
        xb.redoEdit()
        c.eqStr("redo same-sheet" (s1.getFormula(0 3)) "C1")
        c.eqStr("redo cross-sheet" (s2.getFormula(0 0)) "Sheet1!C1")
        c.eqStr("redo keeps Sheet2 local" (s2.getFormula(0 1)) "A1*2")

        print "== sort/filter view refreshes after edit =="
        def sf:GridApp (new GridApp)
        sf.init("gallery/pdf_writer/assets/fonts")
        sf.model.clearSheet()
        sf.model.resize(4 2)
        sf.model.setCellRaw(0 0 "H")
        sf.model.setCellRaw(1 0 "3")
        sf.model.setCellRaw(2 0 "1")
        sf.model.setCellRaw(3 0 "2")
        sf.model.setFreeze(1 0)
        sf.sheetView.markDirty()
        sf.sheetView.rebuild()
        sf.engine.rebuildAll()
        sf.applySort(0 true)
        ; The DATA is in order now — the view is not permuting anything, which
        ; is why what gets saved matches what is on screen.
        c.eqStr("sorted body first" (sf.model.getCell(1 0)) "1"
        )
        c.eqStr("sorted body second" (sf.model.getCell(2 0)) "2"
        )
        c.eqStr("sorted body third" (sf.model.getCell(3 0)) "3"
        )
        c.eqStr("the frozen heading stayed on top" (sf.model.getCell(0 0)) "H"
        )
        ; Editing after a sort writes where it looks like it should.
        sf.sel.setActive(1 0)
        sf.beginEdit("0" true)
        sf.commitEdit()
        c.eqStr("model value updated" (sf.model.getCell(1 0)) "0")
        ; Filter: only "North" — changing it to South must drop the row.
        sf.clearFilter()
        sf.model.setSort(-1 true)
        sf.model.setCellRaw(1 0 "North")
        sf.model.setCellRaw(2 0 "South")
        sf.model.setCellRaw(3 0 "North")
        def keepN:[string]
        push keepN "North"
        sf.applyFilter(0 keepN)
        def beforeCnt:int (sf.sheetView.rowCount())
        c.ok("filter shows North rows" (beforeCnt == 3))
        sf.sel.setActive(1 0)
        sf.beginEdit("South" true)
        sf.commitEdit()
        c.ok("edited row left the filter view" ((sf.sheetView.viewRowOf(1)) < 0))
        c.eqInt("view shrunk" (sf.sheetView.rowCount()) 2)

        print "== ensureCellVisible uses view coordinates =="
        def ev:GridApp (new GridApp)
        ev.init("gallery/pdf_writer/assets/fonts")
        ev.model.clearSheet()
        ev.model.resize(20 3)
        ev.model.setFreeze(1 0)
        def ri:int 1
        while (ri < 20) {
            ev.model.setCellRaw(ri 0 (to_string (20 - ri)))
            ri = (ri + 1)
        }
        ev.sheetView.markDirty()
        ev.sheetView.rebuild()
        ev.applySort(0 true)
        ; The row that held 1 is the first body row now — really, in the data.
        c.eqStr("smallest first after the sort" (ev.model.getCell(1 0)) "1"
        )
        ev.grid.scrollY = 500
        ev.grid.ensureCellVisible(ev.model 1 0)
        c.ok("scrolled to view top not model-row Y" (ev.grid.scrollY < 50))

        print "== merge width ignores hidden columns =="
        def mg:GridApp (new GridApp)
        mg.init("gallery/pdf_writer/assets/fonts")
        mg.model.clearSheet()
        mg.model.resize(3 5)
        mg.model.setColWidth(0 40)
        mg.model.setColWidth(1 50)
        mg.model.setColWidth(2 60)
        mg.model.setColWidth(3 70)
        mg.model.addMerge(0 0 0 2)
        mg.model.setColHidden(3 true)
        mg.sheetView.markDirty()
        mg.sheetView.rebuild()
        def rect:GridRect (mg.grid.cellRect(mg.model 0 0))
        c.eqInt("merge spans visible A:C" rect.w 150)

        ; Summary CF color scale
        def si:int 0
        while (si < (app.book.sheetCount())) {
            def sh:SpreadsheetModel (app.book.sheetAt(si))
            if (sh.name == "Summary") {
                app.setActiveSheet(si)
            }
            si = (si + 1)
        }
        c.ok("cf rules present" ((array_length app.model.cfRules) >= 1))
        def fill:string (ConditionalFormat.resolveFill(app.model 2 2))
        c.ok("cf fill non-empty" ((strlen fill) > 0))

        print "== adding, renaming and reordering sheets =="
        ; The operations a tab strip needs, tested before there is a tab strip:
        ; they are facts about the workbook, and two of them have consequences
        ; a caller must not be left to remember.
        def wb:WorkbookModel (new WorkbookModel)
        def mk:int 0
        while (mk < 3) {
            def sh:SpreadsheetModel (new SpreadsheetModel)
            sh.name = ("S" + (to_string (mk + 1)))
            wb.addSheet(sh)
            mk = (mk + 1)
        }
        c.eqInt("three sheets" (wb.sheetCount()) 3)
        c.eqInt("found by name" (wb.indexOfName("S2")) 1)
        c.eqInt("without caring about case" (wb.indexOfName("s2")) 1)
        c.eqInt("a name nobody has" (wb.indexOfName("S9")) -1)
        c.eqStr("the next free SheetN" (wb.nextSheetName()) "Sheet4")
        c.eqStr("a free name is itself" (wb.uniqueName("Report")) "Report")
        c.eqStr("a taken one counts up" (wb.uniqueName("S2")) "S22")

        print "-- inserting --"
        wb.setActive(1)
        def added:SpreadsheetModel (new SpreadsheetModel)
        added.name = "New"
        wb.insertSheet(1 added)
        c.eqInt("four sheets" (wb.sheetCount()) 4)
        def at1:SpreadsheetModel (wb.sheetAt(1))
        c.eqStr("it landed where it was asked to" at1.name "New")
        def at2:SpreadsheetModel (wb.sheetAt(2))
        c.eqStr("and pushed the rest along" at2.name "S2")
        ; A sheet inserted at or before the active one must not change which
        ; sheet you are looking at.
        c.eqInt("the sheet you were on is still the one you are on" wb.activeIndex 2)
        def tail:SpreadsheetModel (new SpreadsheetModel)
        tail.name = "Last"
        wb.insertSheet(99 tail)
        def atLast:SpreadsheetModel (wb.sheetAt(4))
        c.eqStr("an index past the end appends" atLast.name "Last")
        c.eqInt("and leaves the active sheet alone" wb.activeIndex 2)

        print "-- reordering --"
        ; S1 New S2 S3 Last, looking at S2.
        wb.moveSheet(0 3)
        def m0:SpreadsheetModel (wb.sheetAt(0))
        def m3:SpreadsheetModel (wb.sheetAt(3))
        c.eqStr("the tab moved to where it was dropped" m3.name "S1")
        c.eqStr("and everything closed up behind it" m0.name "New")
        c.eqInt("the active sheet followed itself" wb.activeIndex 1)
        def stillS2:SpreadsheetModel (wb.activeSheet())
        c.eqStr("by identity, not by number" stillS2.name "S2")
        wb.moveSheet(3 0)
        def back0:SpreadsheetModel (wb.sheetAt(0))
        c.eqStr("and back again" back0.name "S1")
        c.eqInt("the active number moved with it" wb.activeIndex 2)

        print "-- the remap on its own --"
        ; Moving right: everything between shifts down one.
        c.eqInt("the moved one lands on its target" (WorkbookModel.remapIndex(0 0 3)) 3)
        c.eqInt("one it passed" (WorkbookModel.remapIndex(1 0 3)) 0)
        c.eqInt("the last one it passed" (WorkbookModel.remapIndex(3 0 3)) 2)
        c.eqInt("one beyond it" (WorkbookModel.remapIndex(4 0 3)) 4)
        ; Moving left: everything between shifts up one.
        c.eqInt("moved left" (WorkbookModel.remapIndex(3 3 0)) 0)
        c.eqInt("one it passed" (WorkbookModel.remapIndex(0 3 0)) 1)
        c.eqInt("one before the target" (WorkbookModel.remapIndex(4 3 1)) 4)
        c.eqInt("a move to itself changes nothing" (WorkbookModel.remapIndex(2 2 2)) 2)
        wb.moveSheet(0 0)
        c.eqInt("and moveSheet agrees" (wb.sheetCount()) 5)

        print "-- names a formula has to be able to write --"
        c.ok("an ordinary name" (wb.nameIsValid(0 "Report")))
        c.ok("its own name is still its own" (wb.nameIsValid(0 "S1")))
        c.ok("but not another sheet's" ((wb.nameIsValid(0 "S2")) == false))
        c.ok("nor another sheet's in another case" ((wb.nameIsValid(0 "s2")) == false))
        c.ok("not empty" ((wb.nameIsValid(0 "")) == false))
        c.ok("not longer than 31" ((wb.nameIsValid(0 "12345678901234567890123456789012")) == false))
        c.ok("exactly 31 is fine" (wb.nameIsValid(0 "1234567890123456789012345678901")))
        c.ok("no colon" ((wb.nameIsValid(0 "A:B")) == false))
        c.ok("no slash" ((wb.nameIsValid(0 "A/B")) == false))
        c.ok("no backslash" ((wb.nameIsValid(0 "A\\B")) == false))
        c.ok("no question mark" ((wb.nameIsValid(0 "A?B")) == false))
        c.ok("no asterisk" ((wb.nameIsValid(0 "A*B")) == false))
        c.ok("no brackets" ((wb.nameIsValid(0 "A[B]")) == false))
        ; A quoted reference is written 'My Sheet'!A1, so a name that starts or
        ; ends with an apostrophe cannot be written at all.
        c.ok("no leading apostrophe" ((wb.nameIsValid(0 "'A")) == false))
        c.ok("no trailing apostrophe" ((wb.nameIsValid(0 "A'")) == false))
        c.ok("but one in the middle is fine" (wb.nameIsValid(0 "Ada's")))
        c.ok("and a space is fine" (wb.nameIsValid(0 "My Sheet")))

        print ("passed=" + (to_string c.passed) + " failed=" + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }
}

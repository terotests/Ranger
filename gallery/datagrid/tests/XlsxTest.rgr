; ==============================================================================
; XlsxTest - validation for .xlsx → SpreadsheetModel / DataGrid viewer.
; ==============================================================================

Import "../src/GridApp.rgr"
Import "../src/XlsxNumberFormat.rgr"
Import "../src/xlsx/XlsxLoader.rgr"
Import "../src/xlsx/XlsxWorksheet.rgr"
Import "../src/CellStyle.rgr"

class Checker {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        this.ok((name + " (got '" + got + "' want '" + want + "')") (got == want))
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }
}

class XlsxTest {
    sfn hasSub:boolean (hay:string needle:string) {
        def n:int (strlen needle)
        def m:int (strlen hay)
        if (n == 0) {
            return true
        }
        def i:int 0
        while ((i + n) <= m) {
            if ((substring hay i (i + n)) == needle) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn main:void () {
        def c:Checker (new Checker)

        print "== cell ref parse =="
        def r:[int]
        def col:[int]
        XlsxWorksheet.parseCellRef("A1" r col)
        c.eqInt("A1 row" (itemAt r 0) 0)
        c.eqInt("A1 col" (itemAt col 0) 0)
        XlsxWorksheet.parseCellRef("D6" r col)
        c.eqInt("D6 row" (itemAt r 0) 5)
        c.eqInt("D6 col" (itemAt col 0) 3)
        XlsxWorksheet.parseCellRef("AA17" r col)
        c.eqInt("AA17 row" (itemAt r 0) 16)
        c.eqInt("AA17 col" (itemAt col 0) 26)

        print "== load sales.xlsx =="
        def book:WorkbookModel (new WorkbookModel)
        def loader:XlsxLoader (new XlsxLoader)
        def ok:boolean (loader.loadPath("gallery/datagrid/fixtures/sales.xlsx" book))
        c.ok("load ok" ok)
        c.eqInt("sheet count" (book.sheetCount()) 2)
        def s0:SpreadsheetModel (book.sheetAt(0))
        def s1:SpreadsheetModel (book.sheetAt(1))
        c.eqStr("sheet0 name" s0.name "Sales")
        c.eqStr("sheet1 name" s1.name "Summary")

        def sales:SpreadsheetModel s0
        c.eqStr("A1 merge title" (sales.getCell(0 0)) "Quarterly Sales")
        c.eqStr("A2 Product" (sales.getCell(1 0)) "Product")
        c.eqStr("A3 Widget" (sales.getCell(2 0)) "Widget")
        c.eqStr("B3 qty" (sales.getCell(2 1)) "12")
        c.eqStr("D3 cached" (sales.getCell(2 3)) "54")
        c.eqStr("D3 formula" (sales.getFormula(2 3)) "B3*C3")
        c.eqStr("formula bar D3" (sales.formulaBarText(2 3)) "=B3*C3")
        c.eqStr("D6 sum" (sales.getCell(5 3)) "138.7")
        c.eqStr("A6 inline" (sales.getCell(5 0)) "Grand total")
        c.ok("has merge" ((array_length sales.merges) >= 1))
        c.ok("A1 is merge origin" (sales.isMergeOrigin(0 0)))
        c.ok("B1 not origin" (sales.isMergeOrigin(0 1) == false))
        def cw0:int (sales.colWidth(0))
        def rh0:int (sales.rowHeight(0))
        c.ok("col A wider" (cw0 > sales.defaultColW))
        c.ok("row1 taller" (rh0 > sales.defaultRowH))

        print "== styles + freeze (FortuneSheet M3) =="
        c.eqInt("freeze rows" sales.freezeRows 2)
        c.eqInt("freeze cols" sales.freezeCols 1)
        c.ok("styles table" ((array_length sales.styles) >= 4))
        def stA1:CellStyle (sales.getCellStyle(0 0))
        c.ok("A1 has fill" stA1.hasFill)
        c.eqStr("A1 align" stA1.align "center")
        c.ok("A1 bold" stA1.bold)
        c.eqStr("C3 display 0.00" (sales.getDisplay(2 2)) "4.50")
        c.eqStr("C5 display %" (sales.getDisplay(4 2)) "25%")
        c.eqStr("C3 raw" (sales.getCell(2 2)) "4.5")

        def summary:SpreadsheetModel s1
        c.eqStr("Summary A1" (summary.getCell(0 0)) "Lines")
        c.eqStr("Summary B1" (summary.getCell(0 1)) "3")
        c.eqStr("bool TRUE" (summary.getCell(2 0)) "TRUE")

        print "== sparse500.xlsx =="
        def book2:WorkbookModel (new WorkbookModel)
        def ok2:boolean (loader.loadPath("gallery/datagrid/fixtures/sparse500.xlsx" book2))
        c.ok("sparse load" ok2)
        def sp:SpreadsheetModel (book2.activeSheet())
        c.ok("sparse rows >= 500" (sp.rowCount >= 500))
        c.eqStr("marker 25" (sp.getCell(24 1)) "marker-25")
        c.eqStr("marker 500" (sp.getCell(499 1)) "marker-500")

        print "== GridApp load + render =="
        def app:GridApp (new GridApp)
        app.init("gallery/pdf_writer/assets/fonts")
        def loaded:boolean (app.loadXlsx("gallery/datagrid/fixtures/sales.xlsx"))
        c.ok("app loadXlsx" loaded)
        c.eqStr("active sheet" (app.book.activeName()) "Sales")
        c.eqStr("app A1" (app.model.getCell(0 0)) "Quarterly Sales")
        app.setActiveSheet(1)
        c.eqStr("switched" (app.book.activeName()) "Summary")
        app.setActiveSheet(0)
        app.render()
        def raw:buffer (app.raw())
        c.ok("framebuffer" ((buffer_length raw) > 1000))
        def scene:string (app.sceneJson())
        c.ok("sceneJson" ((strlen scene) > 50))

        print "== styles-showcase: borders, fonts, formats =="
        def sApp:GridApp (new GridApp)
        sApp.init("gallery/pdf_writer/assets/fonts")
        c.ok("load styles-showcase" (sApp.loadXlsx("gallery/datagrid/fixtures/styles-showcase.xlsx")))
        def sm:SpreadsheetModel sApp.model
        ; An empty cell that only carries a style must keep its fill —
        ; Excel writes those self-closing, and they used to be dropped.
        def bg:CellStyle (sm.getCellStyle(2 1))
        c.ok("empty styled cell keeps its fill" bg.hasFill)
        c.eqStr("fill colour" bg.fillRgb "#1A73E8")
        c.eqStr("blank cell has no text" (sm.getCell(2 1)) "")

        print "-- border line styles --"
        def thin:CellStyle (sm.getCellStyle(4 1))
        c.ok("thin has a border" thin.hasBorder)
        c.eqStr("thin style" thin.borderTop.style "thin")
        c.eqStr("thin colour" thin.borderTop.rgb "#EA4335")
        c.eqInt("thin width" (thin.borderTop.width()) 1)
        c.eqInt("thin is solid" (thin.borderTop.pattern()) 0)
        def medium:CellStyle (sm.getCellStyle(4 2))
        c.eqInt("medium width" (medium.borderTop.width()) 2)
        def thick:CellStyle (sm.getCellStyle(4 3))
        c.eqInt("thick width" (thick.borderTop.width()) 3)
        def dbl:CellStyle (sm.getCellStyle(6 1))
        c.eqInt("double pattern" (dbl.borderTop.pattern()) 3)
        def dashed:CellStyle (sm.getCellStyle(6 2))
        c.eqInt("dashed pattern" (dashed.borderTop.pattern()) 1)
        c.eqStr("dashed colour" dashed.borderTop.rgb "#1A73E8")
        def dotted:CellStyle (sm.getCellStyle(6 3))
        c.eqInt("dotted pattern" (dotted.borderTop.pattern()) 2)

        print "-- per-edge independence --"
        def onlyBottom:CellStyle (sm.getCellStyle(10 1))
        c.ok("bottom set" (onlyBottom.borderBottom.has()))
        c.ok("top not set" ((onlyBottom.borderTop.has()) == false))
        c.ok("left not set" ((onlyBottom.borderLeft.has()) == false))
        c.ok("right not set" ((onlyBottom.borderRight.has()) == false))
        def onlyLeft:CellStyle (sm.getCellStyle(10 2))
        c.ok("left set" (onlyLeft.borderLeft.has()))
        c.ok("bottom not set" ((onlyLeft.borderBottom.has()) == false))
        def onlyTop:CellStyle (sm.getCellStyle(10 3))
        c.ok("top set" (onlyTop.borderTop.has()))
        c.eqStr("top style" onlyTop.borderTop.style "dashed")
        ; A border element with no <color> defaults to black.
        def defColor:CellStyle (sm.getCellStyle(12 1))
        c.eqStr("no colour means black" defColor.borderTop.rgb "#000000")
        ; A plain cell has no border at all.
        def plain:CellStyle (sm.getCellStyle(1 0))
        c.ok("plain cell has no border" (plain.hasBorder == false))

        print "-- font attributes --"
        def fb:CellStyle (sm.getCellStyle(14 1))
        c.ok("bold parsed" fb.bold)
        def fi:CellStyle (sm.getCellStyle(14 2))
        c.ok("italic parsed" fi.italic)
        c.ok("italic is not bold" (fi.bold == false))
        def fu:CellStyle (sm.getCellStyle(14 3))
        c.ok("underline parsed" fu.underline)
        def fs:CellStyle (sm.getCellStyle(15 1))
        c.ok("strike parsed" fs.strike)
        def fbig:CellStyle (sm.getCellStyle(15 2))
        c.ok("18pt parsed" (fbig.fontSizePt > 17.0))
        def fsmall:CellStyle (sm.getCellStyle(15 3))
        c.ok("8pt parsed" (fsmall.fontSizePt < 9.0))
        def fcol:CellStyle (sm.getCellStyle(16 1))
        c.eqStr("font colour" fcol.textRgb "#4285F4")

        print "-- number formats with quoted literals --"
        ; "$"#,##0.00 must show a $, not a quoted one.
        c.eqStr("currency literal unquoted" (sm.getDisplay(18 3)) "$1,234.50")
        c.eqStr("two decimals" (sm.getDisplay(18 1)) "0.25")
        c.eqStr("percent" (sm.getDisplay(18 2)) "25%")
        c.eqStr("suffix literal" (XlsxNumberFormat.format("12" "0\" kg\"")) "12 kg")
        c.eqStr("escaped char" (XlsxNumberFormat.format("5" "0\\x")) "5x")
        c.eqStr("colour tag dropped" (XlsxNumberFormat.format("7" "[Red]0")) "7")
        ; A ';' inside a literal must not split the sections.
        c.eqStr("semicolon inside a literal" (XlsxNumberFormat.format("3" "0\";\"")) "3;")

        print "-- the faces actually differ --"
        ; Only the Regular face used to be loaded, so bold silently painted
        ; regular. Measuring through each face must now give different widths.
        sApp.view.applyFaceStyled(false false)
        def wReg:int (sApp.view.measureText("Sample"))
        sApp.view.applyFaceStyled(true false)
        def wBold:int (sApp.view.measureText("Sample"))
        sApp.view.applyFaceStyled(false true)
        def wItal:int (sApp.view.measureText("Sample"))
        c.ok("bold is wider than regular" (wBold > wReg))
        c.ok("italic differs from regular" (wItal != wReg))
        sApp.view.applyFaceStyled(false false)
        c.ok("renders the showcase" ((strlen (sApp.sceneJson())) > 500))

        print "== text rotation =="
        def rotApp:GridApp (new GridApp)
        rotApp.init("gallery/pdf_writer/assets/fonts")
        def rotOk:boolean (rotApp.loadXlsx("gallery/datagrid/fixtures/styles-showcase.xlsx"))
        c.ok("styles showcase loaded" rotOk)
        if rotOk {
            def s45:CellStyle (rotApp.model.getCellStyle(26 1))
            c.eqInt("45 up read from the file" s45.textRotation 45)
            c.eqStr("which is 45 degrees anticlockwise" (to_string (s45.rotationDegrees())) "-45")
            def s90:CellStyle (rotApp.model.getCellStyle(26 2))
            c.eqInt("90 up read" s90.textRotation 90)
            def sDown:CellStyle (rotApp.model.getCellStyle(26 3))
            c.eqInt("135 read" sDown.textRotation 135)
            c.eqStr("which is 45 degrees clockwise" (to_string (sDown.rotationDegrees())) "45")
            def sStack:CellStyle (rotApp.model.getCellStyle(27 1))
            c.ok("255 is stacked, not turned" (sStack.isStacked()))
            c.eqStr("and so has no angle" (to_string (sStack.rotationDegrees())) "0")
            ; The scene has to carry the angle, or only this test knows about
            ; it. Scroll the turned cells into view first — the display list is
            ; virtualized, so what is off screen is genuinely not in it.
            rotApp.moveActive(27 1 false)
            def scene:string (rotApp.sceneJson())
            c.ok("a rotated run reaches the display list" (XlsxTest.hasSub(scene "\"rot\":-45")))
            c.ok("and the clockwise one too" (XlsxTest.hasSub(scene "\"rot\":45")))
        }

        print ("passed=" + (to_string c.passed) + " failed=" + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }
}

; ==============================================================================
; XlsxTest - validation for .xlsx → SpreadsheetModel / DataGrid viewer.
; ==============================================================================

Import "../src/GridApp.rgr"
Import "../src/XlsxNumberFormat.rgr"
Import "../src/xlsx/XlsxLoader.rgr"
Import "../src/xlsx/XlsxWorksheet.rgr"
Import "../src/CellStyle.rgr"
Import "../../office/drawing/OfficeColor.rgr"
Import "../../pdf_writer/src/core/Utf8.rgr"

class Checker {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        this.ok((name + " (got '" + got + "' want '" + want + "')") (got == want))
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }
}

class XlsxTest {
    sfn hasSub:boolean (hay:string needle:string) {
        def n:int (strlen needle)
        def m:int (strlen hay)
        if (n == 0) {
            return true
        }
        def i:int 0
        while ((i + n) <= m) {
            if ((substring hay i (i + n)) == needle) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn main:void () {
        def c:Checker (new Checker)

        print "== cell ref parse =="
        def r:[int]
        def col:[int]
        XlsxWorksheet.parseCellRef("A1" r col)
        c.eqInt("A1 row" (itemAt r 0) 0)
        c.eqInt("A1 col" (itemAt col 0) 0)
        XlsxWorksheet.parseCellRef("D6" r col)
        c.eqInt("D6 row" (itemAt r 0) 5)
        c.eqInt("D6 col" (itemAt col 0) 3)
        XlsxWorksheet.parseCellRef("AA17" r col)
        c.eqInt("AA17 row" (itemAt r 0) 16)
        c.eqInt("AA17 col" (itemAt col 0) 26)

        print "== load sales.xlsx =="
        def book:WorkbookModel (new WorkbookModel)
        def loader:XlsxLoader (new XlsxLoader)
        def ok:boolean (loader.loadPath("gallery/datagrid/fixtures/sales.xlsx" book))
        c.ok("load ok" ok)
        c.eqInt("sheet count" (book.sheetCount()) 2)
        def s0:SpreadsheetModel (book.sheetAt(0))
        def s1:SpreadsheetModel (book.sheetAt(1))
        c.eqStr("sheet0 name" s0.name "Sales")
        c.eqStr("sheet1 name" s1.name "Summary")

        def sales:SpreadsheetModel s0
        c.eqStr("A1 merge title" (sales.getCell(0 0)) "Quarterly Sales")
        c.eqStr("A2 Product" (sales.getCell(1 0)) "Product")
        c.eqStr("A3 Widget" (sales.getCell(2 0)) "Widget")
        c.eqStr("B3 qty" (sales.getCell(2 1)) "12")
        c.eqStr("D3 cached" (sales.getCell(2 3)) "54")
        c.eqStr("D3 formula" (sales.getFormula(2 3)) "B3*C3")
        c.eqStr("formula bar D3" (sales.formulaBarText(2 3)) "=B3*C3")
        c.eqStr("D6 sum" (sales.getCell(5 3)) "138.7")
        c.eqStr("A6 inline" (sales.getCell(5 0)) "Grand total")
        c.ok("has merge" ((array_length sales.merges) >= 1))
        c.ok("A1 is merge origin" (sales.isMergeOrigin(0 0)))
        c.ok("B1 not origin" (sales.isMergeOrigin(0 1) == false))
        def cw0:int (sales.colWidth(0))
        def rh0:int (sales.rowHeight(0))
        c.ok("col A wider" (cw0 > sales.defaultColW))
        c.ok("row1 taller" (rh0 > sales.defaultRowH))

        print "== styles + freeze (FortuneSheet M3) =="
        c.eqInt("freeze rows" sales.freezeRows 2)
        c.eqInt("freeze cols" sales.freezeCols 1)
        c.ok("styles table" ((array_length sales.styles) >= 4))
        def stA1:CellStyle (sales.getCellStyle(0 0))
        c.ok("A1 has fill" stA1.hasFill)
        c.eqStr("A1 align" stA1.align "center")
        c.ok("A1 bold" stA1.bold)
        c.eqStr("C3 display 0.00" (sales.getDisplay(2 2)) "4.50")
        c.eqStr("C5 display %" (sales.getDisplay(4 2)) "25%")
        c.eqStr("C3 raw" (sales.getCell(2 2)) "4.5")

        def summary:SpreadsheetModel s1
        c.eqStr("Summary A1" (summary.getCell(0 0)) "Lines")
        c.eqStr("Summary B1" (summary.getCell(0 1)) "3")
        c.eqStr("bool TRUE" (summary.getCell(2 0)) "TRUE")

        print "== sparse500.xlsx =="
        def book2:WorkbookModel (new WorkbookModel)
        def ok2:boolean (loader.loadPath("gallery/datagrid/fixtures/sparse500.xlsx" book2))
        c.ok("sparse load" ok2)
        def sp:SpreadsheetModel (book2.activeSheet())
        c.ok("sparse rows >= 500" (sp.rowCount >= 500))
        c.eqStr("marker 25" (sp.getCell(24 1)) "marker-25")
        c.eqStr("marker 500" (sp.getCell(499 1)) "marker-500")

        print "== GridApp load + render =="
        def app:GridApp (new GridApp)
        app.init("gallery/pdf_writer/assets/fonts")
        def loaded:boolean (app.loadXlsx("gallery/datagrid/fixtures/sales.xlsx"))
        c.ok("app loadXlsx" loaded)
        c.eqStr("active sheet" (app.book.activeName()) "Sales")
        c.eqStr("app A1" (app.model.getCell(0 0)) "Quarterly Sales")
        app.setActiveSheet(1)
        c.eqStr("switched" (app.book.activeName()) "Summary")
        app.setActiveSheet(0)
        app.render()
        def raw:buffer (app.raw())
        c.ok("framebuffer" ((buffer_length raw) > 1000))
        def scene:string (app.sceneJson())
        c.ok("sceneJson" ((strlen scene) > 50))

        print "== styles-showcase: borders, fonts, formats =="
        def sApp:GridApp (new GridApp)
        sApp.init("gallery/pdf_writer/assets/fonts")
        c.ok("load styles-showcase" (sApp.loadXlsx("gallery/datagrid/fixtures/styles-showcase.xlsx")))
        def sm:SpreadsheetModel sApp.model
        ; An empty cell that only carries a style must keep its fill —
        ; Excel writes those self-closing, and they used to be dropped.
        def bg:CellStyle (sm.getCellStyle(2 1))
        c.ok("empty styled cell keeps its fill" bg.hasFill)
        c.eqStr("fill colour" bg.fillRgb "#1A73E8")
        c.eqStr("blank cell has no text" (sm.getCell(2 1)) "")

        print "-- border line styles --"
        def thin:CellStyle (sm.getCellStyle(4 1))
        c.ok("thin has a border" thin.hasBorder)
        c.eqStr("thin style" thin.borderTop.style "thin")
        c.eqStr("thin colour" thin.borderTop.rgb "#EA4335")
        c.eqInt("thin width" (thin.borderTop.width()) 1)
        c.eqInt("thin is solid" (thin.borderTop.pattern()) 0)
        def medium:CellStyle (sm.getCellStyle(4 2))
        c.eqInt("medium width" (medium.borderTop.width()) 2)
        def thick:CellStyle (sm.getCellStyle(4 3))
        c.eqInt("thick width" (thick.borderTop.width()) 3)
        def dbl:CellStyle (sm.getCellStyle(6 1))
        c.eqInt("double pattern" (dbl.borderTop.pattern()) 3)
        def dashed:CellStyle (sm.getCellStyle(6 2))
        c.eqInt("dashed pattern" (dashed.borderTop.pattern()) 1)
        c.eqStr("dashed colour" dashed.borderTop.rgb "#1A73E8")
        def dotted:CellStyle (sm.getCellStyle(6 3))
        c.eqInt("dotted pattern" (dotted.borderTop.pattern()) 2)

        print "-- per-edge independence --"
        def onlyBottom:CellStyle (sm.getCellStyle(10 1))
        c.ok("bottom set" (onlyBottom.borderBottom.has()))
        c.ok("top not set" ((onlyBottom.borderTop.has()) == false))
        c.ok("left not set" ((onlyBottom.borderLeft.has()) == false))
        c.ok("right not set" ((onlyBottom.borderRight.has()) == false))
        def onlyLeft:CellStyle (sm.getCellStyle(10 2))
        c.ok("left set" (onlyLeft.borderLeft.has()))
        c.ok("bottom not set" ((onlyLeft.borderBottom.has()) == false))
        def onlyTop:CellStyle (sm.getCellStyle(10 3))
        c.ok("top set" (onlyTop.borderTop.has()))
        c.eqStr("top style" onlyTop.borderTop.style "dashed")
        ; A border element with no <color> defaults to black.
        def defColor:CellStyle (sm.getCellStyle(12 1))
        c.eqStr("no colour means black" defColor.borderTop.rgb "#000000")
        ; A plain cell has no border at all.
        def plain:CellStyle (sm.getCellStyle(1 0))
        c.ok("plain cell has no border" (plain.hasBorder == false))

        print "-- font attributes --"
        def fb:CellStyle (sm.getCellStyle(14 1))
        c.ok("bold parsed" fb.bold)
        def fi:CellStyle (sm.getCellStyle(14 2))
        c.ok("italic parsed" fi.italic)
        c.ok("italic is not bold" (fi.bold == false))
        def fu:CellStyle (sm.getCellStyle(14 3))
        c.ok("underline parsed" fu.underline)
        def fs:CellStyle (sm.getCellStyle(15 1))
        c.ok("strike parsed" fs.strike)
        def fbig:CellStyle (sm.getCellStyle(15 2))
        c.ok("18pt parsed" (fbig.fontSizePt > 17.0))
        def fsmall:CellStyle (sm.getCellStyle(15 3))
        c.ok("8pt parsed" (fsmall.fontSizePt < 9.0))
        def fcol:CellStyle (sm.getCellStyle(16 1))
        c.eqStr("font colour" fcol.textRgb "#4285F4")

        print "-- number formats with quoted literals --"
        ; "$"#,##0.00 must show a $, not a quoted one.
        c.eqStr("currency literal unquoted" (sm.getDisplay(18 3)) "$1,234.50")
        c.eqStr("two decimals" (sm.getDisplay(18 1)) "0.25")
        c.eqStr("percent" (sm.getDisplay(18 2)) "25%")
        c.eqStr("suffix literal" (XlsxNumberFormat.format("12" "0\" kg\"")) "12 kg")
        c.eqStr("escaped char" (XlsxNumberFormat.format("5" "0\\x")) "5x")
        c.eqStr("colour tag dropped" (XlsxNumberFormat.format("7" "[Red]0")) "7")
        ; A ';' inside a literal must not split the sections.
        c.eqStr("semicolon inside a literal" (XlsxNumberFormat.format("3" "0\";\"")) "3;")

        print "-- the faces actually differ --"
        ; Only the Regular face used to be loaded, so bold silently painted
        ; regular. Measuring through each face must now give different widths.
        sApp.view.applyFaceStyled(false false)
        def wReg:int (sApp.view.measureText("Sample"))
        sApp.view.applyFaceStyled(true false)
        def wBold:int (sApp.view.measureText("Sample"))
        sApp.view.applyFaceStyled(false true)
        def wItal:int (sApp.view.measureText("Sample"))
        c.ok("bold is wider than regular" (wBold > wReg))
        c.ok("italic differs from regular" (wItal != wReg))
        sApp.view.applyFaceStyled(false false)
        c.ok("renders the showcase" ((strlen (sApp.sceneJson())) > 500))

        print "== text rotation =="
        def rotApp:GridApp (new GridApp)
        rotApp.init("gallery/pdf_writer/assets/fonts")
        def rotOk:boolean (rotApp.loadXlsx("gallery/datagrid/fixtures/styles-showcase.xlsx"))
        c.ok("styles showcase loaded" rotOk)
        if rotOk {
            def s45:CellStyle (rotApp.model.getCellStyle(26 1))
            c.eqInt("45 up read from the file" s45.textRotation 45)
            c.eqStr("which is 45 degrees anticlockwise" (to_string (s45.rotationDegrees())) "-45")
            def s90:CellStyle (rotApp.model.getCellStyle(26 2))
            c.eqInt("90 up read" s90.textRotation 90)
            def sDown:CellStyle (rotApp.model.getCellStyle(26 3))
            c.eqInt("135 read" sDown.textRotation 135)
            c.eqStr("which is 45 degrees clockwise" (to_string (sDown.rotationDegrees())) "45")
            def sStack:CellStyle (rotApp.model.getCellStyle(27 1))
            c.ok("255 is stacked, not turned" (sStack.isStacked()))
            c.eqStr("and so has no angle" (to_string (sStack.rotationDegrees())) "0")
            ; The scene has to carry the angle, or only this test knows about
            ; it. Scroll the turned cells into view first — the display list is
            ; virtualized, so what is off screen is genuinely not in it.
            rotApp.moveActive(27 1 false)
            def scene:string (rotApp.sceneJson())
            c.ok("a rotated run reaches the display list" (XlsxTest.hasSub(scene "\"rot\":-45")))
            c.ok("and the clockwise one too" (XlsxTest.hasSub(scene "\"rot\":45")))
        }

        print "== hyperlinks, notes and validation, read from the file =="
        def anApp:GridApp (new GridApp)
        anApp.init("gallery/pdf_writer/assets/fonts")
        def anOk:boolean (anApp.loadXlsx("gallery/datagrid/fixtures/annotations.xlsx"))
        c.ok("annotations fixture loaded" anOk)
        if anOk {
            c.eqStr("external link resolved through the relationship" (anApp.model.hyperlinkAt(0 0)) "https://example.com/report")
            c.eqStr("internal link kept as a location" (anApp.model.hyperlinkAt(0 1)) "#Lists!A1")
            c.eqStr("a cell with no link has none" (anApp.model.hyperlinkAt(2 2)) "")
            c.eqInt("two links" (anApp.model.hyperlinkCount()) 2)

            c.eqStr("a note read out of the comments part" (anApp.model.noteAt(0 2)) "Reviewer: check this number")
            c.eqStr("and the second one" (anApp.model.noteAt(2 1)) "Must stay under a hundred")
            c.eqInt("two notes" (anApp.model.noteCount()) 2)

            c.eqInt("two validation rules" (anApp.model.validationCount()) 2)
            def listRule:DataValidation (anApp.model.validationAt(2 0))
            c.eqStr("A3 has the list rule" listRule.kind "list")
            def choices:[string] (listRule.listValues())
            c.eqInt("four choices" (array_length choices) 4)
            c.eqStr("unquoted" (itemAt choices 0) "north")
            c.eqStr("and split" (itemAt choices 3) "west")
            c.ok("a listed value is accepted" (listRule.accepts("south")))
            c.ok("an unlisted one is not" ((listRule.accepts("middle")) == false))

            def numRule:DataValidation (anApp.model.validationAt(2 1))
            c.eqStr("B3 has the whole-number rule" numRule.kind "whole")
            c.eqStr("with the file's own message" (numRule.message()) "Enter 1 to 100")
            c.ok("50 is fine" (numRule.accepts("50")))
            c.ok("200 is not" ((numRule.accepts("200")) == false))
            c.ok("nor is 2.5" ((numRule.accepts("2.5")) == false))
            c.ok("nor is text" ((numRule.accepts("lots")) == false))

            print "-- and enforced when typing --"
            anApp.moveActive(2 1 false)
            anApp.beginEdit("200" true)
            anApp.commitEdit()
            c.eqStr("the refused value was not written" (anApp.model.getCell(2 1)) "42")
            c.ok("and the refusal says why" (XlsxTest.hasSub(anApp.validationError "Enter 1 to 100")))
            anApp.beginEdit("55" true)
            anApp.commitEdit()
            c.eqStr("an allowed value goes in" (anApp.model.getCell(2 1)) "55")
            c.eqStr("with no complaint" anApp.validationError "")

            print "-- the list picker --"
            anApp.moveActive(2 0 false)
            anApp.openListPicker(2 0)
            c.ok("the picker opened" anApp.listDialog.visible)
            c.eqInt("offering every choice" (array_length anApp.listValues) 4)
            anApp.listDialog.selectRadio(902)
            anApp.applyListPicker()
            c.eqStr("choosing writes the value" (anApp.model.getCell(2 0)) "south")
            c.ok("and closes" (anApp.listDialog.visible == false))

            print "-- following a link --"
            c.ok("following reports the target" (anApp.followLink(0 0)))
            c.eqStr("which the host can open" anApp.activatedLink "https://example.com/report")
            c.ok("a cell with no link is not followed" ((anApp.followLink(1 1)) == false))

            print "-- link and note painting --"
            anApp.moveActive(0 0 false)
            def anScene:string (anApp.sceneJson())
            c.ok("the scene still builds" ((strlen anScene) > 500))
        }

        print "== rich text: several styles inside one cell =="
        def rtApp:GridApp (new GridApp)
        rtApp.init("gallery/pdf_writer/assets/fonts")
        def rtOk:boolean (rtApp.loadXlsx("gallery/datagrid/fixtures/annotations.xlsx"))
        c.ok("fixture loaded" rtOk)
        if rtOk {
            c.eqStr("the cell's value is what the runs spell" (rtApp.model.getCell(4 0)) "Total: 1234 kg")
            c.ok("and it knows it is rich" (rtApp.model.hasRichText(4 0)))
            def rt:RichText (rtApp.model.richTextAt(4 0))
            c.eqInt("three runs" (rt.count()) 3)
            def r0:CellRun (itemAt rt.runs 0)
            c.eqStr("the first says Total" r0.text "Total: ")
            c.ok("in bold" r0.bold)
            c.eqStr("and in red" r0.rgb "#CC0000")
            def r1:CellRun (itemAt rt.runs 1)
            c.eqStr("the second is the number" r1.text "1234")
            c.ok("with nothing of its own" ((r1.isStyled()) == false))
            def r2:CellRun (itemAt rt.runs 2)
            c.eqStr("the third is the unit" r2.text " kg")
            c.ok("in italic" r2.italic)
            c.eqStr("and smaller" (to_string (to_int r2.sizePt)) "8")

            ; --- what a run said, versus what it did not say ---------------
            ;
            ; `<b val="0"/>` and no `<b>` at all are different documents. The
            ; first takes a word out of a bold cell; the second lets the cell
            ; decide. `CellRun` carried only the value, and `styleOver` tested
            ; it as `if bold { st.bold = true }` — the same for both — so a run
            ; that un-bolded itself drew bold, and a save wrote nothing where
            ; it had said something.
            c.ok("the plain middle run states nothing about its weight"
                ((r1.boldSet == false) && (r1.italicSet == false)))
            c.ok("while the bold one states it" r0.boldSet)
            c.ok("and the italic one states its slant" r2.italicSet)

            def offP:XmlLite (new XmlLite)
            offP.reset("<si><r><rPr><b val=\"0\"/><i val=\"0\"/></rPr><t>quiet</t></r><r><t>silent</t></r></si>")
            offP.nextTag()
            def offRt:RichText (XlsxSharedStrings.parseRuns(offP "si"))
            c.eqInt("two runs came back" (offRt.count()) 2)
            if ((offRt.count()) == 2) {
                def offRun:CellRun (itemAt offRt.runs 0)
                def quietRun:CellRun (itemAt offRt.runs 1)
                c.ok("a run that says b=0 stated its weight" offRun.boldSet)
                c.ok("and the weight is off" (offRun.bold == false))
                c.ok("a run with no rPr stated nothing" ((quietRun.boldSet == false) && (quietRun.italicSet == false)))
                ; The bug itself: over a BOLD cell, one draws bold and the
                ; other does not.
                def boldCell:CellStyle (new CellStyle)
                boldCell.bold = true
                boldCell.italic = true
                def overOff:CellStyle (offRun.styleOver(boldCell))
                def overQuiet:CellStyle (quietRun.styleOver(boldCell))
                c.ok("the run that said no is NOT bold over a bold cell" (overOff.bold == false))
                c.ok("nor italic" (overOff.italic == false))
                c.ok("while the silent one inherits the cell's bold" overQuiet.bold)
                c.ok("and its italic" overQuiet.italic)
                ; And a run that says "not bold" is asking for something the
                ; cell would not give it, so the string is rich text.
                c.ok("saying no counts as styling" (offRun.isStyled()))
                c.ok("saying nothing does not" ((quietRun.isStyled()) == false))
            }

            c.ok("an inline string carries runs too" (rtApp.model.hasRichText(4 1)))
            c.eqStr("spelling what it should" (rtApp.model.getCell(4 1)) "inline runs")
            c.ok("a plain cell is not rich" ((rtApp.model.hasRichText(0 0)) == false))
            c.eqInt("two rich cells on the sheet" (rtApp.model.richCount()) 2)

            ; The paint has to actually use them: a bold run means a bold
            ; command in the display list for that cell's text.
            rtApp.moveActive(4 0 false)
            def rtScene:string (rtApp.sceneJson())
            c.ok("the scene carries a bold run" (XlsxTest.hasSub(rtScene "\"text\":\"Total: \",\"font\":\"Open Sans\",\"size\":14.67,\"weight\":\"bold\"")))
            c.ok("and the plain piece beside it" (XlsxTest.hasSub(rtScene "\"text\":\"1234\"")))

            ; Retyping the cell drops the pieces, because new text cannot
            ; belong to the old ones.
            ; A5 sits inside the list rule, so the replacement has to be one
            ; of its values — which is the rule doing its job, not a problem.
            rtApp.beginEdit("east" true)
            rtApp.commitEdit()
            c.eqStr("the new text is there" (rtApp.model.getCell(4 0)) "east")
            c.ok("and the runs are gone" ((rtApp.model.hasRichText(4 0)) == false))
        }

        print "== images, three hops from the sheet =="
        def imApp:GridApp (new GridApp)
        imApp.init("gallery/pdf_writer/assets/fonts")
        def imOk:boolean (imApp.loadXlsx("gallery/datagrid/fixtures/images.xlsx"))
        c.ok("images fixture loaded" imOk)
        if imOk {
            c.eqInt("two pictures" (imApp.model.imageCount()) 2)
            def one:SheetImage (imApp.model.imageAt(0))
            c.eqStr("the media part was resolved through two relationships" one.src "xl/media/image1.png")
            c.eqStr("and named" one.name "Stretched")
            c.eqInt("anchored at column B" one.fromCol 1)
            c.eqInt("row 3" one.fromRow 2)
            c.eqInt("offset inside the cell, in pixels not EMUs" one.offX 2)
            c.eqInt("and vertically" one.offY 3)
            c.ok("it stretches to a second cell" one.stretched)
            c.eqInt("which is column D" one.toCol 3)
            c.ok("its bytes came out of the package" ((buffer_length one.bytes) > 0))
            c.eqStr("and it knows what kind they are" (one.kind()) "png")

            def two:SheetImage (imApp.model.imageAt(1))
            c.eqStr("the second picture" two.src "xl/media/image2.png")
            c.ok("is pinned rather than stretched" (two.stretched == false))
            c.eqInt("with its own width in pixels" two.widthPx 64)
            c.eqInt("and height" two.heightPx 48)

            print "-- geometry follows the cells --"
            def r1:GridRect (GridImages.rectFor(imApp.model imApp.grid one))
            def beforeW:int r1.w
            imApp.model.setColWidth(1 ((imApp.model.colWidth(1)) + 60))
            imApp.sheetView.markDirty()
            imApp.sheetView.rebuild()
            imApp.grid.updateVisible(imApp.model)
            def r2:GridRect (GridImages.rectFor(imApp.model imApp.grid one))
            c.ok("widening a column it spans widens the picture" (r2.w > beforeW))
            def p1:GridRect (GridImages.rectFor(imApp.model imApp.grid two))
            c.eqInt("a pinned picture keeps its size" p1.w 64)

            print "-- decoding --"
            def scene:string (imApp.sceneJson())
            c.ok("the scene names the part so a browser can fetch it" (XlsxTest.hasSub(scene "xl/media/image1.png")))
            def dec:DecodedImage (imApp.view.images.cached("xl/media/image1.png"))
            c.ok("the PNG decoded" dec.ok)
            c.eqInt("to its real width" dec.img.width 16)
            c.eqInt("and height" dec.img.height 12)
            def decodesAfterFirst:int imApp.view.images.decodes
            imApp.sceneJson()
            c.eqInt("a second paint decodes nothing again" imApp.view.images.decodes decodesAfterFirst)
            c.ok("and it renders" ((strlen scene) > 500))
        }

        print "== what other programs leave out: shared formulas, an empty font, the sheet's own defaults =="
        def shLoader:XlsxLoader (new XlsxLoader)
        def shBook:WorkbookModel (new WorkbookModel)
        def shOk:boolean (shLoader.loadPath("gallery/datagrid/fixtures/shared-formulas.xlsx" shBook))
        c.ok("shared-formulas.xlsx loaded" shOk)
        if shOk {
            def sh:SpreadsheetModel (shBook.sheetAt(0))

            print "-- a run of cells written once --"
            ; E1 carries the text; E2..E4 carry only the run's id, and have to
            ; be reconstructed by translating E1's formula down the column.
            c.eqStr("the anchor keeps its own formula" (sh.getFormula(0 4)) "SUM(B1:D1)")
            c.eqStr("the next member is that formula, moved" (sh.getFormula(1 4)) "SUM(B2:D2)")
            c.eqStr("and the last" (sh.getFormula(3 4)) "SUM(B4:D4)")
            c.eqStr("which computes" (sh.getCell(1 4)) "60")
            c.eqStr("and the total over them" (sh.getCell(5 4)) "6666")

            print "-- so an edit still travels --"
            ; The point of all this: a member of a shared run is a FORMULA, not
            ; the number the file happened to cache. Change an input and the
            ; row total and the grand total both have to move.
            sh.setCellRaw(1 1 "1000")
            shLoader.engine.onCellEdited(0 1 1)
            c.eqStr("the row total followed the input" (sh.getCell(1 4)) "1050")
            c.eqStr("and the grand total followed the row" (sh.getCell(5 4)) "7656")

            print "-- an empty <font/> still holds its index --"
            ; The file's font 1 is <font/>. Drop it and font 2 — bold, dark red
            ; — is read as font 3, which is 12pt and neither.
            def a1:CellStyle (sh.getCellStyle(0 0))
            c.ok("the label is bold" a1.bold)
            c.eqStr("in the colour the file names" a1.textRgb "#C00000")
            c.ok("at the size it names" ((a1.fontSizePt > 9.9) && (a1.fontSizePt < 10.1)))

            print "-- the sheet's own defaults --"
            ; 12.75pt rows and 12.63-character columns, stated once in
            ; <sheetFormatPr> and true of every row and column the file does
            ; not mention.
            c.eqInt("default row height, in pixels" sh.defaultRowH 17)
            c.eqInt("default column width" sh.defaultColW 93)
            c.eqInt("a column the file sizes keeps its own width" (sh.colWidth(0)) 145)
            c.eqInt("a column it does not, takes the default" (sh.colWidth(1)) 93)
            c.eqInt("and a row of ordinary type is the default height" (sh.rowHeight(0)) 17)

            print "-- a row grows to fit type it cannot hold --"
            ; Row 8 carries 12pt in a sheet whose rows are 12.75pt. The file
            ; states no height for it because Excel would compute one; so do we,
            ; by the same rule, or the letters are clipped.
            c.ok("the 12pt row is taller than the default" ((sh.rowHeight(7)) > 17))
            c.eqInt("by Excel's own measure" (sh.rowHeight(7)) 21)
        }

        print "== password-protected OLE workbook (crypto2016.xlsx) =="
        ; Not a ZIP until decrypted. Without a password the loader must say so
        ; rather than "Could not find End of Central Directory record".
        def cryptoLoader:XlsxLoader (new XlsxLoader)
        def cryptoBook:WorkbookModel (new WorkbookModel)
        def cryptoNoPw:boolean (cryptoLoader.loadPath("gallery/datagrid/fixtures/crypto2016.xlsx" cryptoBook))
        c.ok("encrypted file refuses without a password" (cryptoNoPw == false))
        c.ok("and names the reason" (XlsxTest.hasSub(cryptoLoader.lastError "password-protected")))
        def cryptoOk:boolean (cryptoLoader.loadPathPassword("gallery/datagrid/fixtures/crypto2016.xlsx" cryptoBook "AZE"))
        c.ok("opens with the sample password" cryptoOk)
        if cryptoOk {
            c.ok("has at least one sheet" ((cryptoBook.sheetCount()) >= 1))
            def cSheet:SpreadsheetModel (cryptoBook.sheetAt(0))
            c.eqStr("sheet name" cSheet.name "Feuil1")
            ; Column C from row 5 holds 1, 2, 3 in the published sample.
            c.eqStr("C5" (cSheet.getCell(4 2)) "1")
            c.eqStr("C6" (cSheet.getCell(5 2)) "2")
            c.eqStr("C7" (cSheet.getCell(6 2)) "3")
        }
        def cryptoBad:boolean (cryptoLoader.loadPathPassword("gallery/datagrid/fixtures/crypto2016.xlsx" cryptoBook "not-the-password"))
        c.ok("wrong password is refused" (cryptoBad == false))
        c.ok("with a decrypt error" (XlsxTest.hasSub(cryptoLoader.lastError "decrypt")))

        print "== large buffer_to_string (no stack blow on >200KB) =="
        ; ES6 used to call String.fromCharCode.apply on the whole Uint8Array.
        ; That throws Maximum call stack size exceeded around 200KB — which is
        ; smaller than real xlsx parts (sharedStrings / sheet XML).
        def bigN:int 300000
        def bigRaw:buffer (buffer_alloc bigN)
        def bi:int 0
        while (bi < bigN) {
            buffer_set bigRaw bi 65
            bi = (bi + 1)
        }
        def bigText:string (Utf8.decode((buffer_to_string bigRaw)))
        c.eqInt("300KB decode length" (strlen bigText) bigN)
        c.ok("300KB decode is ASCII A" ((charAt bigText 0) == 65))

        ; --- colours a workbook names without spelling them out ----------------
        ;
        ; A `<color>` says which colour one of four ways and only one of them is
        ; a hex string. The reader read that one and dropped the rest — so a
        ; workbook coloured the way Excel colours things by default, from the
        ; theme palette, came out with no colours at all. `xl/theme/theme1.xml`
        ; was in the package the whole time, unread.
        print "== a colour named by theme, tint or index =="
        def thApp:GridApp (new GridApp)
        thApp.init("gallery/pdf_writer/assets/fonts")
        def thOk:boolean (thApp.loadXlsx("gallery/datagrid/fixtures/theme-colors.xlsx"))
        c.ok("the theme fixture loaded" thOk)
        if thOk {
            def m:SpreadsheetModel (thApp.model)
            def accent:string ((m.getCellStyle(0 0)).textRgb)
            c.eqStr("theme=4 is the first accent, out of the theme part" accent "#4472C4")

            ; Excel's tint scales HLS luminance, so a lighter accent is still
            ; BLUE. Scaling RGB channels instead — DrawingML's tint, the other
            ; function with the same name — would wash the hue out.
            def lighter:string ((m.getCellStyle(1 0)).textRgb)
            def darker:string ((m.getCellStyle(2 0)).textRgb)
            c.ok("a tinted colour is not the flat one" ((lighter != accent) && (darker != accent)))
            c.ok("lighter really is lighter"
                ((XlsxTest.chanOf(lighter 0)) > (XlsxTest.chanOf(accent 0))))
            c.ok("darker really is darker"
                ((XlsxTest.chanOf(darker 4)) < (XlsxTest.chanOf(accent 4))))
            c.ok("and both are still blue"
                (((XlsxTest.chanOf(lighter 4)) > (XlsxTest.chanOf(lighter 0)))
                    && ((XlsxTest.chanOf(darker 4)) > (XlsxTest.chanOf(darker 0)))))

            ; The swap. Excel's theme INDICES are not the theme file's order:
            ; 0 is the light background and 1 the dark text. A reader that maps
            ; them in file order paints white on white.
            def t0:string ((m.getCellStyle(3 0)).textRgb)
            def t1:string ((m.getCellStyle(4 0)).textRgb)
            c.eqStr("theme=0 is the LIGHT one" t0 "#FDFDFD")
            c.eqStr("and theme=1 the DARK one" t1 "#1A1A1A")

            ; A system colour has no value of its own; the file carries the one
            ; it had when it was written, which is the only answer available.
            c.ok("a sysClr slot was read from its lastClr" ((strlen t0) == 7))

            def idx:string ((m.getCellStyle(5 0)).textRgb)
            c.eqStr("indexed=10 is the legacy palette's red" idx "#FF0000")

            ; And a FILL named the same ways, not just a font.
            def fill:string ((m.getCellStyle(6 0)).fillRgb)
            c.eqStr("a fill can be a theme colour too" fill "#70AD47")
            def fillTint:string ((m.getCellStyle(7 0)).fillRgb)
            c.ok("and can carry a tint" ((fillTint != fill) && ((strlen fillTint) == 7)))
        }

        print ("passed=" + (to_string c.passed) + " failed=" + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }

    ; One channel of a "#RRGGBB" as a number, so a test can say "lighter" and
    ; "still blue" rather than pinning an exact byte the maths may round
    ; either way.
    sfn chanOf:int (css:string at:int) {
        if ((strlen css) != 7) {
            return -1
        }
        return (OfficeColorMath.byteAt((substring css 1 7) at))
    }
}

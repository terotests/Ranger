; ==============================================================================
; GridDbTest - the spreadsheet editing a database, on every engine there is.
; ==============================================================================
;
; The claim being tested is not "the grid can show a query". It is that a cell
; edited in the sheet reaches the database, that a value the database will not
; take never stays on screen, that sorting re-runs the query rather than
; sorting the page, and that all of this is the same program whether the rows
; came from RangerDB, SQLite or DuckDB.
; ==============================================================================

Import "../src/GridApp.rgr"
Import "../../rangerdb/src/RangerDB.rgr"
Import "../../rangerdb/src/HostSql.rgr"

class GridDbCheck {
    def passed:int 0
    def failed:int 0
    def engine:string ""

    Constructor () {
    }

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL [" + engine + "] " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        def good:boolean (got == want)
        if (good == false) {
            print ("       got [" + got + "] want [" + want + "]")
        }
        this.ok(name good)
    }

    fn eqInt:void (name:string got:int want:int) {
        def good:boolean (got == want)
        if (good == false) {
            print ("       got " + (to_string got) + " want " + (to_string want))
        }
        this.ok(name good)
    }
}

class GridDbTest {
    sfn tableName:string () {
        return "sales"
    }

    sfn seed:void (session:DBSession) {
        def cols:[DBColumn]
        push cols (DBColumn.createKey("id" 2))
        push cols (DBColumn.create("country" 4))
        push cols (DBColumn.create("revenue" 3))
        push cols (DBColumn.create("units" 2))
        session.createTable((GridDbTest.tableName()) cols)
        GridDbTest.addRow(session 1 "Finland" 1240000.0 120)
        GridDbTest.addRow(session 2 "Sweden" 980000.0 95)
        GridDbTest.addRow(session 3 "Norway" 610000.0 60)
        GridDbTest.addRow(session 4 "Germany" 1750000.0 210)
    }

    sfn addRow:void (session:DBSession id:int country:string revenue:double units:int) {
        def m:DBMutation (DBMutation.makeInsert((GridDbTest.tableName())))
        m.withValue("id" (DBValue.fromInt(id)))
        m.withValue("country" (DBValue.fromString(country)))
        m.withValue("revenue" (DBValue.fromDouble(revenue)))
        m.withValue("units" (DBValue.fromInt(units)))
        session.mutate(m)
    }

    sfn mentions:boolean (hay:string needle:string) {
        def hl:int (strlen hay)
        def nl:int (strlen needle)
        if (nl == 0) {
            return true
        }
        if (hl < nl) {
            return false
        }
        def limit:int (hl - nl)
        def i:int 0
        while (i <= limit) {
            if ((substring hay i (i + nl)) == needle) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; Which toolbar entry runs a command, or -1.
    sfn toolIndexFor:int (app:GridApp command:string) {
        def n:int (app.view.toolbar.count())
        def i:int 0
        while (i < n) {
            def t:ToolItem (app.view.toolbar.at(i))
            if (t.command == command) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; Which page of the strip owns an item. A tab owns a RANGE of the item
    ; list rather than a list of its own, so this is a range test rather than
    ; a lookup.
    sfn tabOwning:int (app:GridApp index:int) {
        def bar:EVGToolbar app.view.toolbar
        def n:int (bar.tabCount())
        def i:int 0
        while (i < n) {
            def t:ToolTab (bar.tabAt(i))
            if (index >= t.first) {
                def end:int (t.first + t.count)
                if (index < end) {
                    return i
                }
            }
            i = (i + 1)
        }
        return -1
    }

    sfn clickAt:void (app:GridApp input:UIInput px:int py:int) {
        input.newFrame()
        input.setPointerPos(px py)
        input.setPointerDown(true)
        app.update(input)
        input.newFrame()
        input.setPointerPos(px py)
        input.setPointerDown(false)
        app.update(input)
    }

    sfn focusCell:void (app:GridApp r:int c:int) {
        app.sel.anchor.row = r
        app.sel.anchor.col = c
        app.sel.active.row = r
        app.sel.active.col = c
    }

    sfn typeInto:void (app:GridApp r:int c:int text:string) {
        GridDbTest.focusCell(app r c)
        app.beginEdit(text true)
        app.commitEdit()
    }

    ; What the database holds for one row, whatever the sheet says.
    sfn storedText:string (session:DBSession id:int column:string) {
        def q:QuerySpec (QuerySpec.forTable((GridDbTest.tableName())))
        q.whereIs("id" 0 (DBValue.fromInt(id)))
        def chunk:DataChunk (session.query(q))
        if (chunk.rowCount == 0) {
            return "<missing>"
        }
        def ci:int (chunk.columnIndex(column))
        if (ci < 0) {
            return "<no column>"
        }
        return (chunk.stringAt(0 ci))
    }

    sfn runSuite:void (session:DBSession check:GridDbCheck) {
        check.engine = (session.engineName())
        print ("== grid over " + check.engine + " ==")
        GridDbTest.seed(session)

        def app:GridApp (new GridApp)
        app.init("gallery/pdf_writer/assets/fonts")

        def spec:QuerySpec (QuerySpec.forTable((GridDbTest.tableName())))
        spec.orderBy("id" true)
        def keys:[string]
        push keys "id"
        def bound:boolean (app.bindDatabase(session spec keys "DB sales"))
        check.ok("query became a sheet" bound)
        check.eqInt("sheet is the active one" app.book.activeIndex 1)
        check.eqStr("header row" (app.model.getCell(0 1)) "country")
        check.eqStr("first row" (app.model.getCell(1 1)) "Finland")
        check.eqStr("numbers are values, not text" (app.model.getCell(1 3)) "120")
        check.eqInt("rows loaded" app.db.loadedRows 4)
        check.ok("the sheet is writable" (app.db.readOnly == false))

        ; --- an edit reaches the database ------------------------------------
        GridDbTest.typeInto(app 2 1 "Sverige")
        check.eqStr("edit is on the sheet" (app.model.getCell(2 1)) "Sverige")
        check.eqStr("edit is in the database" (GridDbTest.storedText(session 2 "country")) "Sverige")

        GridDbTest.typeInto(app 2 3 "97")
        check.eqStr("numeric edit stored" (GridDbTest.storedText(session 2 "units")) "97")

        ; --- a value the column cannot hold never stays -----------------------
        GridDbTest.typeInto(app 2 3 "ninety seven")
        check.eqStr("refused edit is undone on the sheet" (app.model.getCell(2 3)) "97")
        check.eqStr("refused edit never reached the database" (GridDbTest.storedText(session 2 "units")) "97")
        check.ok("and it said why" ((strlen app.db.status) > 0))

        ; --- a formula over database columns ----------------------------------
        GridDbTest.typeInto(app 1 5 "=SUM(C2:C5)")
        check.eqStr("formula over a database column" (app.model.getCell(1 5)) "4580000")

        ; --- sorting re-runs the query ----------------------------------------
        app.applySort(2 false)
        check.eqStr("sorted by revenue, highest first" (app.model.getCell(1 1)) "Germany")
        check.eqInt("sort is one ORDER BY, not two" (array_length app.db.spec.sorts) 1)

        ; --- filtering re-runs the query --------------------------------------
        GridDbTest.focusCell(app 1 1)
        app.runCommand("db.filter" "land")
        check.eqInt("filtered rows" app.db.loadedRows 1)
        check.eqInt("filtered total" app.db.totalRows 1)
        check.eqStr("the row that matched" (app.model.getCell(1 1)) "Finland")
        app.runCommand("db.filter" "")
        check.eqInt("filter cleared" app.db.loadedRows 4)

        ; --- delete a row from the sheet --------------------------------------
        GridDbTest.focusCell(app 1 0)
        app.runCommand("db.row.delete" "")
        check.eqInt("row count after delete" app.db.loadedRows 3)
        def first:string (app.model.getCell(1 1))
        check.ok("the deleted row is gone from the sheet" (first != "Germany"))

        ; --- the blank last row inserts ---------------------------------------
        def newRow:int (app.db.loadedRows + 1)
        GridDbTest.typeInto(app newRow 1 "Denmark")
        check.eqInt("no key yet, so nothing was inserted" app.db.loadedRows 3)
        GridDbTest.typeInto(app newRow 0 "9")
        check.eqInt("filling the key inserts the row" app.db.loadedRows 4)
        check.eqStr("the inserted row is in the database" (GridDbTest.storedText(session 9 "country")) "Denmark")

        ; --- a chart over database rows ---------------------------------------
        ; A database sheet is an ordinary sheet, so the chart code that has
        ; never heard of a database plots it. Country labels down the first
        ; column, revenue across - the same extraction an .xlsx range gets.
        def ch:GridChart (new GridChart)
        ch.id = 1
        ch.r0 = 0
        ch.c0 = 1
        ch.r1 = app.db.loadedRows
        ch.c1 = 2
        def data:ChartData (new ChartData)
        check.ok("chart data comes out of the database sheet" (data.extract(app.model ch)))
        check.eqInt("one revenue series" (data.seriesCount()) 1)
        check.eqInt("one category per row" (data.catCount()) app.db.loadedRows)
        check.eqStr("series named by the query column" (itemAt data.series 0) "revenue")

        ; --- the toolbar buttons ------------------------------------------------
        ; A shortcut is not a discoverable feature, and in a browser Ctrl+D is
        ; the bookmark. Both windows have a button, and the button is clicked
        ; here the way a pointer clicks it.
        ; Choosing the page the button is on happens below, next to the click
        ; it enables — `tabOwning` finds it rather than this naming the page,
        ; which is the same fix arrived at from two directions and is better
        ; done once.
        def dbButton:int (GridDbTest.toolIndexFor(app "db.connection"))
        check.ok("there is a database button on the toolbar" (dbButton >= 0))
        def sqlButton:int (GridDbTest.toolIndexFor(app "db.sql.dialog"))
        check.ok("and one for the SQL box" (sqlButton >= 0))
        if (dbButton >= 0) {
            ; The database button lives on the strip's Data page, and a page
            ; that is not showing is deliberately not laid out — that is what
            ; keeps a click from landing on a button nobody can see. So the
            ; page is selected first, the way a reader selects it, and the
            ; strip lays itself out again on the next frame.
            def owning:int (GridDbTest.tabOwning(app dbButton))
            check.ok("the database button is on a page of the strip" (owning >= 0))
            check.ok("its page can be selected" (app.view.toolbar.selectTab(owning)))
            app.render()
            def item:ToolItem (app.view.toolbar.at(dbButton))
            check.ok("the button was laid out" (item.w > 0))
            def hit:int (app.toolbarHit((item.x + (idiv item.w 2)) (item.y + (idiv item.h 2))))
            check.eqInt("the pointer hits it" hit dbButton)
            def input:UIInput (new UIInput)
            GridDbTest.clickAt(app input (item.x + (idiv item.w 2)) (item.y + (idiv item.h 2)))
            check.ok("clicking it opens the connection window" app.connDialog.visible)
            app.connDialog.close()
        }

        ; --- the connection window ---------------------------------------------
        ; What the workbook is talking to, in one place: engine, data source,
        ; table, keys, and what the engine could do for itself.
        app.noteConnection((session.engineName()) ":memory:" (GridDbTest.tableName()))
        app.runCommand("db.connection" "")
        check.ok("the connection window opens" app.connDialog.visible)
        check.eqStr("it names the engine" (app.connectionEngine()) (session.engineName()))
        check.eqStr("and the table" (app.connectionTable()) (GridDbTest.tableName()))
        check.eqStr("and the key columns" (app.connectionKeys()) "id")
        def caps:DBCapabilities (session.capabilities())
        check.ok("and what the engine can do" ((strlen (caps.describe())) > 0))
        def engineField:EVGControl (app.connDialog.controlById(721))
        check.eqStr("the engine is in the field" engineField.value (session.engineName()))
        def sourceField:EVGControl (app.connDialog.controlById(722))
        check.eqStr("the data source is in the field" sourceField.value ":memory:")

        ; Connecting is the host's part: the app writes down what was asked for.
        def tableField:EVGControl (app.connDialog.controlById(723))
        tableField.value = "other_table"
        app.connectFromDialog()
        check.eqStr("a connect request is left for the host" (app.takeDbRequest()) "connect")
        check.eqStr("with the table that was asked for" app.dbRequestTable "other_table")
        check.eqStr("and it is taken only once" (app.takeDbRequest()) "")
        app.connDialog.close()

        ; --- the SQL box knows the database ------------------------------------
        ; A prompt with no manual is not much help: the box lists the tables it
        ; can be asked about, and offers queries written against them.
        app.runCommand("db.sql.dialog" "")
        check.ok("the SQL box opens from the command" app.sqlDialog.visible)
        def schema:[string] (app.schemaLines())
        check.ok("it knows about at least one table" ((array_length schema) > 0))
        def firstLine:string ""
        if ((array_length schema) > 0) {
            firstLine = (itemAt schema 0)
        }
        check.ok("the table is named" (GridDbTest.mentions(firstLine (GridDbTest.tableName()))))
        check.ok("its columns are listed" (GridDbTest.mentions(firstLine "country")))
        check.ok("and the key column is marked" (GridDbTest.mentions(firstLine "id*")))

        def examples:[string] (app.exampleQueries())
        check.ok("there are examples" ((array_length examples) > 0))
        def bad:int 0
        def ei:int 0
        while (ei < (array_length examples)) {
            def q:string (itemAt examples ei)
            if ((GridDbTest.mentions(q (GridDbTest.tableName()))) == false) {
                bad = (bad + 1)
            }
            def parsed:SqlParseResult (Sql.parse(q))
            if ((parsed.okResult()) == false) {
                bad = (bad + 1)
                print ("       unparsable example: " + q)
            }
            ei = (ei + 1)
        }
        check.eqInt("every example is about this database and parses" bad 0)

        ; Clicking one puts it in the box, and it runs from there.
        app.useExample(0)
        def field:EVGControl (app.sqlDialog.controlById(701))
        check.eqStr("the example is in the box" field.value (itemAt examples 0))
        app.runSqlFromDialog()
        check.ok("and running it produced rows" (app.db.loadedRows > 0))
        app.sqlDialog.close()

        ; --- a sheet from typed SQL -------------------------------------------
        ; The query box: RangerSQL parses what was typed and SqlFront plans it
        ; into the same QuerySpec a sheet built in code uses, so a typed SELECT
        ; is an ordinary editable database sheet.
        def typed:string ("SELECT id, country, revenue FROM " + (GridDbTest.tableName()) + " WHERE revenue > 900000 ORDER BY revenue DESC")
        app.dbSqlText = typed
        app.openSqlDialog()
        check.ok("the SQL box opens" app.sqlDialog.visible)
        app.runSqlFromDialog()
        check.ok("the typed query became a sheet" (app.db.loadedRows > 0))
        check.ok("planned into a QuerySpec, not run as raw text" ((app.db.isRawSql()) == false))
        check.eqStr("header comes from the query" (app.model.getCell(0 1)) "country")
        check.eqInt("only the selected columns" (array_length app.db.columns) 3)
        check.eqInt("only the rows the WHERE kept" app.db.loadedRows 2)
        check.eqStr("ordered by the query" (app.model.getCell(1 1)) "Finland")
        check.ok("and it is writable, because the key came with it" (app.db.readOnly == false))

        ; An edit on a SQL sheet goes back to the table the query named.
        GridDbTest.typeInto(app 1 1 "Suomi")
        check.eqStr("an edit on a SQL sheet reaches the database" (GridDbTest.storedText(session 1 "country")) "Suomi")

        ; The command surface does the same thing, which is how a host drives it.
        app.runCommand("db.sql" ("SELECT id, country FROM " + (GridDbTest.tableName()) + " ORDER BY id"))
        check.eqInt("db.sql runs a query" (array_length app.db.columns) 2)
        check.ok("and it is still a database sheet" (app.dbSheetActive()))

        ; --- one question, one sheet ------------------------------------------
        ; Iterating on a query used to leave a tab behind on every run. The box
        ; has two buttons now: Update replaces the sheet the query made, and
        ; New sheet is the one that adds a tab.
        def sheetsBefore:int (app.book.sheetCount())
        def onSheet:string (app.book.activeName())
        app.dbSqlText = ("SELECT id, country FROM " + (GridDbTest.tableName()) + " ORDER BY id LIMIT 5")
        app.openSqlDialog()
        check.ok("the box knows this sheet came from a query" (app.sqlSheetActive()))
        app.runSqlFromDialog()
        check.eqInt("Update re-runs into the sheet it is on" (app.book.sheetCount()) sheetsBefore)
        check.eqStr("and stays on that sheet" (app.book.activeName()) onSheet)
        check.ok("with the new result in it" (app.db.loadedRows > 0))
        check.eqInt("and the columns the new query asked for" (array_length app.db.columns) 2)

        ; New sheet is the other button, and the tab is named after the table
        ; the query is about rather than "SQL", "SQL2", "SQL3".
        app.dbSqlText = ("SELECT id, revenue, units FROM " + (GridDbTest.tableName()) + " LIMIT 3")
        app.openSqlDialog()
        app.newSheetFromDialog()
        check.eqInt("New sheet adds one" (app.book.sheetCount()) (sheetsBefore + 1))
        check.ok("named after the table it queries" (GridDbTest.mentions((app.book.activeName()) (GridDbTest.tableName()))))
        check.eqInt("and holds its own result" (array_length app.db.columns) 3)
        def madeSheet:string (app.book.activeName())
        def madeIndex:int app.book.activeIndex

        ; A sheet remembers the query that made it, so selecting one brings
        ; that query back into the box instead of whatever was typed last.
        def firstSql:string ((app.book.sheetAt((madeIndex - 1))).dbSql)
        check.ok("the earlier sheet kept its own query" ((strlen firstSql) > 0))
        app.setActiveSheet((madeIndex - 1))
        check.eqStr("selecting it puts that query in the box" app.dbSqlText firstSql)
        app.setActiveSheet(madeIndex)
        check.ok("and the other sheet brings back the other query" (GridDbTest.mentions(app.dbSqlText "units")))
        app.sqlDialog.close()

        ; The command surface has both too.
        app.runCommand("db.sql.new" ("SELECT id FROM " + (GridDbTest.tableName()) + " LIMIT 2"))
        check.eqInt("db.sql.new adds a sheet" (app.book.sheetCount()) (sheetsBefore + 2))
        app.runCommand("db.sql" ("SELECT id FROM " + (GridDbTest.tableName()) + " LIMIT 4"))
        check.eqInt("db.sql re-runs into the sheet a query made" (app.book.sheetCount()) (sheetsBefore + 2))
        check.eqInt("with the columns the new query asked for" (array_length app.db.columns) 1)

        ; Beyond the planner: an expression in the projection. A host engine
        ; runs the text; RangerDB says what was in the way instead.
        def beyond:string ("SELECT id * 2 AS twice FROM " + (GridDbTest.tableName()))
        def beyondOk:boolean (app.bindDatabaseSql(session beyond "SQL beyond"))
        if (check.engine == "rangerdb") {
            check.ok("rangerdb refuses what it cannot plan" (beyondOk == false))
            check.ok("and names what was in the way" ((strlen app.db.status) > 0))
        } {
            check.ok("a host engine runs it as raw SQL" beyondOk)
            check.ok("and the sheet says it is read only" app.db.readOnly)
            check.eqStr("the computed column is there" (app.model.getCell(0 0)) "twice")
        }

        ; --- an aggregate is read only ----------------------------------------
        def agg:QuerySpec (QuerySpec.forTable((GridDbTest.tableName())))
        agg.groupOn("country")
        agg.aggregate(1 "revenue" "total")
        agg.orderBy("country" true)
        def noKeys:[string]
        app.bindDatabase(session agg noKeys "DB totals")
        check.ok("aggregate sheet is read only" app.db.readOnly)
        def beforeAgg:string (app.model.getCell(1 1))
        GridDbTest.typeInto(app 1 1 "999")
        check.eqStr("an aggregate cell cannot be edited" (app.model.getCell(1 1)) beforeAgg)
    }

    sfn runHost:int (driver:string check:GridDbCheck) {
        if ((HostSqlBackend.isAvailable(driver)) == false) {
            print ("== grid over " + driver + ": not installed, skipped ==")
            return 0
        }
        def backend:HostSqlBackend (HostSqlBackend.forDriver(driver))
        def session:DBSession (DBSession.over(backend))
        if ((session.openDb(":memory:")) == false) {
            print ("== grid over " + driver + ": could not open ==")
            return 0
        }
        GridDbTest.runSuite(session check)
        session.closeDb()
        return 1
    }

    sfn main:void () {
        def check:GridDbCheck (new GridDbCheck)
        def backend:RangerDbBackend (new RangerDbBackend)
        def session:DBSession (DBSession.over(backend))
        session.openDb(":memory:")
        GridDbTest.runSuite(session check)
        def engines:int 1
        engines = (engines + (GridDbTest.runHost("sqlite" check)))
        engines = (engines + (GridDbTest.runHost("duckdb" check)))
        print ("engines=" + (to_string engines) + " passed=" + (to_string check.passed) + " failed=" + (to_string check.failed))
        if (check.failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }
}

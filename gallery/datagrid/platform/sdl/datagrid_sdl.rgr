; ==============================================================================
; datagrid_sdl — macOS / desktop SDL2 + OpenGL host for the EVG DataGrid.
; ==============================================================================
;
; Same GridApp / UIInput contract as the WebGL host: this file only opens a
; window, maps SDL events into UIInput, and draws the EVG display list with
; OpenGL (evg_gl_native — same seam as gallery/evg/gl/evg-webgl.js). SoftCanvas
; is used only to rasterize text runs into an atlas, not as the page framebuffer.
;
; Excel open/save is on disk already (`loadXlsx` / `saveXlsx` / Ctrl+S).
;
; Usage (after build.sh):
;   ./tmp/datagrid-sdl/datagrid_sdl [workbook.xlsx] [frames]
;   ./tmp/datagrid-sdl/datagrid_sdl gallery/datagrid/fixtures/business-workbook.xlsx
;   SDL_VIDEODRIVER=dummy ./tmp/datagrid-sdl/datagrid_sdl … 30   # headless smoke
;
; Optional second arg = frame count then exit (smoke / CI). Absent = run until
; the window is closed.
; ==============================================================================

Import "../../src/GridApp.rgr"
Import "gfx_datagrid_sdl.rgr"
Import "EvgGlPainter.rgr"

class DataGridSdl {
    def app:GridApp (new GridApp)
    def input:UIInput (new UIInput)
    def glPainter:EvgGlPainter (new EvgGlPainter)
    def pw:int 1100
    def ph:int 700
    def frames:int 0
    def hasWindow:boolean false
    def xlsxPath:string ""
    def fontDir:string "gallery/pdf_writer/assets/fonts"
    def saveOnExit:boolean false
    def wantQuit:boolean false
    ; --a11y: print the accessibility tree once, after the first frame. The
    ; same tree the platform bridge publishes and the browser page mirrors, so
    ; "does the native build produce it too" is a question with an answer that
    ; needs neither a screen reader nor a window.
    def dumpA11y:boolean false
    ; The tree as JSON, rebuilt a few times a second rather than sixty. Building
    ; it costs about 1.3 ms — measured, `bench/a11y_bench.rgr` — three quarters
    ; of which is the JSON, and a screen reader has no use for sixty versions of
    ; a sheet that changed once. The cached string is still handed over every
    ; frame, because the bridge needs to hear about a window that MOVED, and a
    ; move does not change the tree by a byte.
    def a11yJson:string ""
    def a11yTick:int 0

    fn openWindow:void () {
        def ok:int (dgfx_open "Ranger DataGrid (SDL2 / OpenGL)" pw ph)
        if (ok == 1) {
            hasWindow = true
            dgfx_install_menus
            dgfx_a11y_attach
        } {
            print "dgfx_open failed (no display?) — SoftCanvas fallback for smoke"
        }
    }

    fn loadWorkbook:boolean (path:string) {
        if ((strlen path) == 0) {
            app.loadDemo()
            xlsxPath = ""
            return true
        }
        def ok:boolean (app.loadXlsx(path))
        if ok {
            xlsxPath = path
            print ("loaded " + path)
        } {
            print ("load failed: " + app.loadError)
        }
        return ok
    }

    ; Follow the window. `dgfx_open` asks for a size and the system gives
    ; whatever it gives; after that the user can drag the corner. Everything —
    ; layout, hit testing, the projection — is in window points, so this is the
    ; one number that has to be right.
    fn syncWindowSize:void () {
        def ww:int (dgfx_window_width)
        def wh:int (dgfx_window_height)
        if (ww < 320) {
            return
        }
        if (wh < 240) {
            return
        }
        if ((ww == pw) && (wh == ph)) {
            return
        }
        pw = ww
        ph = wh
        app.resize(pw ph)
    }

    ; Map one SDL frame into UIInput and tick the app.
    fn pumpInput:void () {
        dgfx_poll
        input.newFrame()
        ; The window may have been resized — or opened at a size other than
        ; the one asked for, which is normal. The page is laid out in WINDOW
        ; POINTS, so this is also what makes the pointer and the picture agree.
        this.syncWindowSize()
        ; SDL reports the pointer in window points, the same space the page is
        ; laid out in, so there is nothing to convert. Dividing it by the
        ; drawable ratio — which is 2 on a Retina screen — put every click
        ; half way to the top left corner of the window, which is a couple of
        ; hundred pixels out by the middle of a spreadsheet.
        def mx:int (dgfx_mouse_x)
        def my:int (dgfx_mouse_y)
        def btn:int (dgfx_mouse_buttons)
        def down:boolean false
        if ((bit_and btn 1) != 0) {
            down = true
        }
        input.setPointerPos(mx my)
        input.setPointerDown(down)
        def wy:int (dgfx_wheel)
        if (wy != 0) {
            ; SDL wheel Y (after FLIPPED normalize) is opposite the UIInput
            ; convention (+up / -down) that GridApp and the web host share —
            ; X already matches, so only invert vertical here.
            input.addScroll((0 - wy))
        }
        def wx:int (dgfx_wheel_x)
        if (wx != 0) {
            input.addScrollX(wx)
        }
        def shift:boolean (dgfx_shift_down)
        def ctrl:boolean (dgfx_ctrl_down)
        input.setModifiers(shift ctrl)
        def text:string (dgfx_take_text)
        if ((strlen text) > 0) {
            input.pushText(text)
        }
        def k:int (dgfx_pop_key)
        while (k != 0) {
            input.pushKey(k)
            k = (dgfx_pop_key)
        }
        app.update(input)
        ; What the pointer is over, said out loud. Every edge you can drag and
        ; every field you can type in should say so before you press it.
        dgfx_set_cursor (app.cursorAt(mx my))
        this.serveFileRequest()
        this.serveMenuAction()
    }

    ; The app cannot open a picker — it does not know what it is running in —
    ; so it says what it wants and this answers. `file.open` / Ctrl+O and
    ; `file.saveAs` / Ctrl+Shift+S both come through here.
    fn serveFileRequest:void () {
        def want:string app.fileRequest
        if ((strlen want) == 0) {
            return
        }
        app.fileRequest = ""
        if (want == "open") {
            def path:string (dgfx_pick_open_file "Open a workbook")
            if ((strlen path) == 0) {
                app.view.status = "open cancelled"
                return
            }
            if (this.loadWorkbook(path)) {
                app.resize(pw ph)
            }
            return
        }
        if (want == "saveAs") {
            ; Suggest what it is already called, not a name with a suffix
            ; bolted on: the person is about to choose one.
            def suggest:string (GridApp.baseName(xlsxPath))
            if ((strlen suggest) == 0) {
                suggest = (GridApp.baseName(app.book.sourcePath))
            }
            if ((strlen suggest) == 0) {
                suggest = "workbook.xlsx"
            }
            def target:string (dgfx_pick_save_file "Save the workbook as" suggest)
            if ((strlen target) == 0) {
                app.view.status = "save cancelled"
                return
            }
            def saved:boolean (app.saveXlsx((GridApp.exportDir(target)) (GridApp.baseName(target))))
            if saved {
                xlsxPath = app.savedPath
            }
            return
        }
    }

    ; --- what the window MEANS -------------------------------------------------
    ; An OpenGL window has no accessible children: VoiceOver asks the platform
    ; for a tree of roles and names and finds an empty rectangle where a
    ; spreadsheet is. So the app publishes the tree it already builds for the
    ; browser (`GridApp.a11yJson()`) and `dgfx_a11y.mm` turns each node into an
    ; NSAccessibilityElement. One tree, two hosts; only the last step differs.
    ;
    ; Nothing is built when nothing is listening — `dgfx_a11y_active` is
    ; VoiceOver's own state — because a few hundred nodes and their JSON every
    ; frame is not free.
    fn serveA11y:void () {
        def on:boolean (dgfx_a11y_active)
        if on {
            a11yTick = (a11yTick + 1)
            def stale:boolean (a11yTick >= 4)
            if ((strlen a11yJson) == 0) {
                stale = true
            }
            if stale {
                a11yTick = 0
                a11yJson = (app.a11yJson())
            }
            dgfx_a11y_publish a11yJson
        }
        ; …and what it pressed. A point, not a command: the app's own hit
        ; testing decides what is there, exactly as it does for the mouse, so
        ; there is no second table of what each thing does to keep in step.
        def press:string (dgfx_a11y_take_press)
        while ((strlen press) > 0) {
            def parts:[string] (strsplit press ",")
            if ((array_length parts) == 2) {
                def px@(optional):int (to_int (itemAt parts 0))
                def py@(optional):int (to_int (itemAt parts 1))
                if (!null? px) {
                    if (!null? py) {
                        this.pressAt((unwrap px) (unwrap py))
                    }
                }
            }
            press = (dgfx_a11y_take_press)
        }
    }

    ; A press and a release at one point, through the same UIInput the mouse
    ; uses. Two frames, because a click that never lifts leaves the app dragging.
    fn pressAt:void (px:int py:int) {
        input.newFrame()
        input.setPointerPos(px py)
        input.setPointerDown(true)
        app.update(input)
        input.newFrame()
        input.setPointerPos(px py)
        input.setPointerDown(false)
        app.update(input)
        this.serveFileRequest()
    }

    ; File menu / toolbar requests that need the OS.
    fn serveMenuAction:void () {
        def a:int (dgfx_pop_menu_action)
        while (a != 0) {
            if (a == 1) {
                app.runCommand("file.open" "")
                this.serveFileRequest()
            }
            if (a == 2) {
                app.runCommand("file.save" "")
                this.serveFileRequest()
            }
            if (a == 3) {
                app.runCommand("file.saveAs" "")
                this.serveFileRequest()
            }
            if (a == 4) {
                wantQuit = true
            }
            if (a == 5) {
                app.runCommand("file.new" "")
                xlsxPath = ""
            }
            a = (dgfx_pop_menu_action)
        }
    }

    ; WebGL-style path: display list → OpenGL (not a SoftCanvas blit).
    fn draw:void () {
        ; Keep save/open feedback visible — the old version ticker wiped it
        ; every frame, which made Save look like a no-op.
        def st:string app.view.status
        def keep:boolean false
        if ((strlen st) >= 5) {
            def head:string (substring st 0 5)
            if (head == "saved") {
                keep = true
            }
            if (head == "save ") {
                keep = true
            }
            if (head == "open ") {
                keep = true
            }
            if (head == "loade") {
                keep = true
            }
        }
        if (keep == false) {
            if ((strlen app.savedPath) > 0) {
                app.view.status = ("v" + (to_string app.model.version) + " · " + app.savedPath)
            } {
                app.view.status = ("v" + (to_string app.model.version))
            }
        }
        app.view.editCaret = app.editCaret
        app.view.windows = app.windows
        def dl:EVGDisplayList (app.view.buildDisplayList(app.model app.sel app.grid app.editing app.editBuf app.book))
        if hasWindow {
            glPainter.draw(dl pw ph app.view.ctx.tr app.view.images)
        } {
            ; Headless / no GL: still exercise the app via SoftCanvas.
            app.view.paintSoftCanvas(dl)
        }
    }

    fn run:void (maxFrames:int) {
        app.W = pw
        app.H = ph
        app.init(fontDir)
        if ((strlen xlsxPath) > 0) {
            def ok:boolean (this.loadWorkbook(xlsxPath))
            if (ok == false) {
                app.loadDemo()
            }
        } {
            app.loadDemo()
        }
        this.openWindow()
        def running:boolean true
        while (running) {
            this.pumpInput()
            this.draw()
            frames = (frames + 1)
            this.serveA11y()
            if dumpA11y {
                if (frames == 1) {
                    print "---A11Y_TREE---"
                    print (app.a11yDump())
                    print "---END---"
                }
            }
            def sc:boolean (dgfx_should_close)
            if sc {
                running = false
            }
            if wantQuit {
                running = false
            }
            if (maxFrames > 0) {
                if (frames >= maxFrames) {
                    running = false
                }
            }
        }
        if saveOnExit {
            def saved:boolean (app.saveXlsxDefaultSilent())
            if saved {
                print ("saved " + app.savedPath)
            } {
                print ("save failed")
            }
        }
        if hasWindow {
            dgfx_a11y_reset
            dgfx_close
        }
    }

    ; Parse CLI: optional .xlsx path, optional frame count, optional --save.
    sfn main:void () {
        def host:DataGridSdl (new DataGridSdl)
        def maxFrames:int 0
        def i:int 0
        def n:int (shell_arg_cnt)
        while (i < n) {
            def a:string (shell_arg i)
            if (a == "--save") {
                host.saveOnExit = true
            } {
              if (a == "--a11y") {
                host.dumpA11y = true
              } {
                if (a == "--demo") {
                    host.xlsxPath = ""
                } {
                    def last:int ((strlen a) - 1)
                    def isNum:boolean true
                    def ci:int 0
                    if ((strlen a) == 0) {
                        isNum = false
                    }
                    while (ci < (strlen a)) {
                        def ch:int (charAt a ci)
                        if ((ch < 48) || (ch > 57)) {
                            isNum = false
                        }
                        ci = (ci + 1)
                    }
                    if isNum {
                        def parsed@(optional):int (to_int a)
                        if (!null? parsed) {
                            maxFrames = (unwrap parsed)
                        }
                    } {
                        host.xlsxPath = a
                    }
                }
              }
            }
            i = (i + 1)
        }
        if ((strlen host.xlsxPath) == 0) {
            if (maxFrames == 0) {
                ; Interactive default: the showcase workbook.
                host.xlsxPath = "gallery/datagrid/fixtures/business-workbook.xlsx"
            }
        }
        host.run(maxFrames)
        print ("datagrid-sdl done: frames=" + (to_string host.frames))
    }
}

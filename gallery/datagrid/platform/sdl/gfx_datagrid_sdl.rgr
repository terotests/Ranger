; ==============================================================================
; gfx_datagrid_sdl — SDL2 + OpenGL present + UI input for the DataGrid host.
; ==============================================================================
;
; Thin platform boundary for gallery/datagrid/platform/sdl/. SoftCanvas paints
; the spreadsheet on the CPU; each frame the RGBA buffer is uploaded as an
; OpenGL texture and drawn as a full-window quad.
;
; Operators are prefixed dgfx_* so this file never collides with the game
; engine's gfx_* shim if both are ever linked in one binary.
;
; The C++ shim is emitted once via (polyfill "after_imports" …) nested in the
; first operator's cpp template — same pattern as gallery/game_engine/gfx_sdl.rgr.
; ==============================================================================

operators {

    ; True once the window received a quit / close request.
    ; Carries the after_imports polyfill (must live inside a cpp template).
    dgfx_should_close _:boolean () {
        templates {
            cpp ( "(dgfx_should_close() != 0)"
                  (imp "<SDL2/SDL.h>") (imp "<cstdint>") (imp "<string>")
                  (imp "<cstdio>") (imp "<cstdlib>") (imp "<cstring>")
                  (imp "<vector>")
(polyfill "after_imports" "
#if defined(__APPLE__)
#include <OpenGL/gl3.h>
#elif defined(__arm__) || defined(__aarch64__)
#include <GLES2/gl2.h>
#else
#define GL_GLEXT_PROTOTYPES 1
#include <GL/gl.h>
#include <GL/glext.h>
#endif
// Declarations for gallery/datagrid/platform/sdl/evg_gl_native.cpp (linked separately).
extern \"C\" {
int evggl_init(void);
void evggl_begin(int pageW, int pageH, int drawW, int drawH);
void evggl_set_atlas(const uint8_t* rgba, int w, int h);
void evggl_rect(float x, float y, float w, float h, float r, float g, float b, float a, float radius);
void evggl_border(float x, float y, float w, float h, float thickness, float r, float g, float b, float a, float radius);
void evggl_text(float x, float y, float w, float h, float u0, float v0, float u1, float v1, float r, float g, float b, float a, float rotDeg);
void evggl_image(float x, float y, float w, float h, const uint8_t* rgba, int tw, int th, float radius);
void evggl_tris_doubles(const double* xy, int nFloats, float r, float g, float b, float a);
void evggl_flush(void);
}

// Native File menu (dgfx_menu.mm / dgfx_menu_stub.cpp).
extern \"C\" {
void dgfx_install_menus(void);
int dgfx_pop_menu_action(void);
}

static SDL_Window* g_dgfx_win = nullptr;
static SDL_GLContext g_dgfx_glctx = nullptr;
static int g_dgfx_should_close_flag = 0;
static int g_dgfx_fb_w = 0;
static int g_dgfx_fb_h = 0;

static int g_dgfx_mouse_x = 0;
static int g_dgfx_mouse_y = 0;
static int g_dgfx_mouse_btn = 0;
static int g_dgfx_wheel_y = 0;
static int g_dgfx_wheel_x = 0;

static GLuint g_dgfx_program = 0;
static GLint g_dgfx_pos_attr = -1;
static GLint g_dgfx_uv_attr = -1;
static GLint g_dgfx_tex_uniform = -1;
static GLuint g_dgfx_vbo = 0;
static GLuint g_dgfx_vao = 0;
static GLuint g_dgfx_tex = 0;
static int g_dgfx_tex_w = 0;
static int g_dgfx_tex_h = 0;

enum {
    DGFX_KEY_NONE = 0,
    DGFX_KEY_BACKSPACE = 1,
    DGFX_KEY_ENTER = 2,
    DGFX_KEY_TAB = 3,
    DGFX_KEY_ESCAPE = 4,
    DGFX_KEY_LEFT = 5,
    DGFX_KEY_RIGHT = 6,
    DGFX_KEY_UP = 7,
    DGFX_KEY_DOWN = 8,
    DGFX_KEY_DEL = 9,
    DGFX_KEY_HOME = 10,
    DGFX_KEY_END = 11,
    DGFX_KEY_PAGEUP = 12,
    DGFX_KEY_PAGEDOWN = 13,
    DGFX_KEY_F2 = 14
};

static std::vector<int> g_dgfx_keys;
static std::string g_dgfx_text;

static GLuint dgfx_compile(GLenum type, const char* src) {
    GLuint s = glCreateShader(type);
    glShaderSource(s, 1, &src, nullptr);
    glCompileShader(s);
    GLint ok = GL_FALSE;
    glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
    if (ok != GL_TRUE) {
        char log[512];
        GLsizei len = 0;
        glGetShaderInfoLog(s, (GLsizei) sizeof(log), &len, log);
        SDL_Log(\"[dgfx] shader compile failed: %.*s\", (int) len, log);
        glDeleteShader(s);
        return 0;
    }
    return s;
}

static int dgfx_gl_init() {
    if (g_dgfx_program != 0) { return 1; }
#if (defined(__arm__) || defined(__aarch64__)) && !defined(__APPLE__)
    // OpenGL ES 2.0 (no #version / attribute / varying).
    const char* vs =
        \"attribute vec2 aPos;\\n\"
        \"attribute vec2 aUv;\\n\"
        \"varying vec2 vUv;\\n\"
        \"void main() { gl_Position = vec4(aPos, 0.0, 1.0); vUv = aUv; }\\n\";
    const char* fs =
        \"precision mediump float;\\n\"
        \"varying vec2 vUv;\\n\"
        \"uniform sampler2D uTex;\\n\"
        \"void main() { gl_FragColor = texture2D(uTex, vUv); }\\n\";
    GLuint vsId = dgfx_compile(GL_VERTEX_SHADER, vs);
    GLuint fsId = dgfx_compile(GL_FRAGMENT_SHADER, fs);
#else
    // Prefer GLSL 150: dgfx_open requests a 3.2 core context (required on
    // modern macOS). #version 120 + attribute/varying is rejected there with
    // \"version '120' is not supported\" / \"attribute: syntax error\".
    const char* vs150 =
        \"#version 150\\n\"
        \"in vec2 aPos;\\n\"
        \"in vec2 aUv;\\n\"
        \"out vec2 vUv;\\n\"
        \"void main() { gl_Position = vec4(aPos, 0.0, 1.0); vUv = aUv; }\\n\";
    const char* fs150 =
        \"#version 150\\n\"
        \"in vec2 vUv;\\n\"
        \"uniform sampler2D uTex;\\n\"
        \"out vec4 outColor;\\n\"
        \"void main() { outColor = texture(uTex, vUv); }\\n\";
    GLuint vsId = dgfx_compile(GL_VERTEX_SHADER, vs150);
    GLuint fsId = dgfx_compile(GL_FRAGMENT_SHADER, fs150);
    if (vsId == 0 || fsId == 0) {
        if (vsId) glDeleteShader(vsId);
        if (fsId) glDeleteShader(fsId);
        // GL 2.1 compatibility fallback (Linux without core).
        const char* vs120 =
            \"#version 120\\n\"
            \"attribute vec2 aPos;\\n\"
            \"attribute vec2 aUv;\\n\"
            \"varying vec2 vUv;\\n\"
            \"void main() { gl_Position = vec4(aPos, 0.0, 1.0); vUv = aUv; }\\n\";
        const char* fs120 =
            \"#version 120\\n\"
            \"varying vec2 vUv;\\n\"
            \"uniform sampler2D uTex;\\n\"
            \"void main() { gl_FragColor = texture2D(uTex, vUv); }\\n\";
        vsId = dgfx_compile(GL_VERTEX_SHADER, vs120);
        fsId = dgfx_compile(GL_FRAGMENT_SHADER, fs120);
    }
#endif
    if (vsId == 0 || fsId == 0) {
        if (vsId) glDeleteShader(vsId);
        if (fsId) glDeleteShader(fsId);
        return 0;
    }
    g_dgfx_program = glCreateProgram();
    glAttachShader(g_dgfx_program, vsId);
    glAttachShader(g_dgfx_program, fsId);
    glLinkProgram(g_dgfx_program);
    glDeleteShader(vsId);
    glDeleteShader(fsId);
    GLint linked = GL_FALSE;
    glGetProgramiv(g_dgfx_program, GL_LINK_STATUS, &linked);
    if (linked != GL_TRUE) {
        SDL_Log(\"[dgfx] program link failed\");
        glDeleteProgram(g_dgfx_program);
        g_dgfx_program = 0;
        return 0;
    }
    g_dgfx_pos_attr = glGetAttribLocation(g_dgfx_program, \"aPos\");
    g_dgfx_uv_attr = glGetAttribLocation(g_dgfx_program, \"aUv\");
    g_dgfx_tex_uniform = glGetUniformLocation(g_dgfx_program, \"uTex\");
#if !((defined(__arm__) || defined(__aarch64__)) && !defined(__APPLE__))
    // Core profile requires a bound VAO before vertex attrib setup / draw.
    glGenVertexArrays(1, &g_dgfx_vao);
    glBindVertexArray(g_dgfx_vao);
#endif
    glGenBuffers(1, &g_dgfx_vbo);
    glGenTextures(1, &g_dgfx_tex);
    glEnable(GL_BLEND);
    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
#if !((defined(__arm__) || defined(__aarch64__)) && !defined(__APPLE__))
    glBindVertexArray(0);
#endif
    return 1;
}

static int dgfx_map_key(SDL_Keycode k) {
    switch (k) {
        case SDLK_BACKSPACE: return DGFX_KEY_BACKSPACE;
        case SDLK_RETURN: case SDLK_KP_ENTER: return DGFX_KEY_ENTER;
        case SDLK_TAB: return DGFX_KEY_TAB;
        case SDLK_ESCAPE: return DGFX_KEY_ESCAPE;
        case SDLK_LEFT: return DGFX_KEY_LEFT;
        case SDLK_RIGHT: return DGFX_KEY_RIGHT;
        case SDLK_UP: return DGFX_KEY_UP;
        case SDLK_DOWN: return DGFX_KEY_DOWN;
        case SDLK_DELETE: return DGFX_KEY_DEL;
        case SDLK_HOME: return DGFX_KEY_HOME;
        case SDLK_END: return DGFX_KEY_END;
        case SDLK_PAGEUP: return DGFX_KEY_PAGEUP;
        case SDLK_PAGEDOWN: return DGFX_KEY_PAGEDOWN;
        case SDLK_F2: return DGFX_KEY_F2;
        default: return DGFX_KEY_NONE;
    }
}

static void dgfx_pump() {
    SDL_Event ev;
    while (SDL_PollEvent(&ev)) {
        if (ev.type == SDL_QUIT) { g_dgfx_should_close_flag = 1; }
        if (ev.type == SDL_MOUSEMOTION) {
            g_dgfx_mouse_x = ev.motion.x;
            g_dgfx_mouse_y = ev.motion.y;
        }
        if (ev.type == SDL_MOUSEBUTTONDOWN) {
            g_dgfx_mouse_x = ev.button.x;
            g_dgfx_mouse_y = ev.button.y;
            if (ev.button.button == SDL_BUTTON_LEFT) { g_dgfx_mouse_btn |= 1; }
            if (ev.button.button == SDL_BUTTON_RIGHT) { g_dgfx_mouse_btn |= 2; }
            if (ev.button.button == SDL_BUTTON_MIDDLE) { g_dgfx_mouse_btn |= 4; }
        }
        if (ev.type == SDL_MOUSEBUTTONUP) {
            if (ev.button.button == SDL_BUTTON_LEFT) { g_dgfx_mouse_btn &= ~1; }
            if (ev.button.button == SDL_BUTTON_RIGHT) { g_dgfx_mouse_btn &= ~2; }
            if (ev.button.button == SDL_BUTTON_MIDDLE) { g_dgfx_mouse_btn &= ~4; }
        }
        if (ev.type == SDL_MOUSEWHEEL) {
            int wy = ev.wheel.y;
            int wx = ev.wheel.x;
            if (ev.wheel.direction == SDL_MOUSEWHEEL_FLIPPED) {
                wy = -wy;
                wx = -wx;
            }
            g_dgfx_wheel_y += wy;
            g_dgfx_wheel_x += wx;
        }
        // Auto-repeat included, deliberately. `ev.key.repeat` is set on the
        // events the OS generates while a key is held down, and dropping them
        // meant holding an arrow moved the selection exactly once — while the
        // same build repeated ordinary TYPING, because SDL_TEXTINPUT below is
        // sent for repeats too. Both browser hosts have always passed repeats
        // through, so this was the native build disagreeing with the other
        // two about a key nobody had let go of.
        //
        // The delay before the first repeat and the rate after it are the
        // OS's, which is the whole point: they are a preference the user set
        // once, in one place, for every program on the machine.
        if (ev.type == SDL_KEYDOWN) {
            int mapped = dgfx_map_key(ev.key.keysym.sym);
            if (mapped != DGFX_KEY_NONE) {
                g_dgfx_keys.push_back(mapped);
            }
            SDL_Keymod mod = (SDL_Keymod) ev.key.keysym.mod;
            if ((mod & (KMOD_CTRL | KMOD_GUI)) != 0) {
                SDL_Keycode sym = ev.key.keysym.sym;
                if (sym >= SDLK_a && sym <= SDLK_z) {
                    char ch = (char) ('a' + (sym - SDLK_a));
                    g_dgfx_text.push_back(ch);
                }
            }
        }
        if (ev.type == SDL_TEXTINPUT) {
            g_dgfx_text += ev.text.text;
        }
    }
}

static int dgfx_open(const std::string& title, int w, int h) {
    if (SDL_Init(SDL_INIT_VIDEO) != 0) {
        SDL_Log(\"[dgfx] SDL_Init failed: %s\", SDL_GetError());
        return 0;
    }
    // OpenGL 3.2+ core: same shader model as WebGL 2 / evg-webgl.js.
    SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE);
    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 2);
    SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
    SDL_GL_SetAttribute(SDL_GL_STENCIL_SIZE, 8);
    g_dgfx_win = SDL_CreateWindow(title.c_str(),
        SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, w, h,
        SDL_WINDOW_OPENGL | SDL_WINDOW_SHOWN | SDL_WINDOW_RESIZABLE | SDL_WINDOW_ALLOW_HIGHDPI);
    if (g_dgfx_win == nullptr) {
        SDL_Log(\"[dgfx] CreateWindow failed: %s\", SDL_GetError());
        return 0;
    }
    g_dgfx_glctx = SDL_GL_CreateContext(g_dgfx_win);
    if (g_dgfx_glctx == nullptr) {
        SDL_Log(\"[dgfx] GL 3.2 core failed (%s) — trying GL 2.1\", SDL_GetError());
        SDL_GL_ResetAttributes();
        SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 2);
        SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 1);
        SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
        g_dgfx_glctx = SDL_GL_CreateContext(g_dgfx_win);
        if (g_dgfx_glctx == nullptr) {
            SDL_Log(\"[dgfx] GL context failed: %s\", SDL_GetError());
            SDL_DestroyWindow(g_dgfx_win);
            g_dgfx_win = nullptr;
            return 0;
        }
    }
    SDL_GL_SetSwapInterval(1);
    SDL_StartTextInput();
    g_dgfx_fb_w = w;
    g_dgfx_fb_h = h;
    // Prefer the EVG→GL path (evg_gl_native). SoftCanvas blit remains as dgfx_present.
    if (!evggl_init()) {
        SDL_Log(\"[dgfx] evggl_init failed — SoftCanvas blit still available\");
    }
    if (!dgfx_gl_init()) {
        // Blit shaders optional when EVG GL works.
    }
    return 1;
}

static int dgfx_drawable_width() {
    if (g_dgfx_win == nullptr) { return g_dgfx_fb_w; }
    int w = 0, h = 0;
    SDL_GL_GetDrawableSize(g_dgfx_win, &w, &h);
    return w;
}
static int dgfx_drawable_height() {
    if (g_dgfx_win == nullptr) { return g_dgfx_fb_h; }
    int w = 0, h = 0;
    SDL_GL_GetDrawableSize(g_dgfx_win, &w, &h);
    return h;
}
// --- the pointer's shape ------------------------------------------------------
//
// One system cursor per kind, made on demand and kept. SDL owns them; setting
// the same one twice is free, and the app calls this every frame.
static SDL_Cursor* g_dgfx_cursors[16] = { nullptr };
static int g_dgfx_cursor_kind = -1;

static SDL_SystemCursor dgfx_system_cursor(int kind) {
    if (kind == 1) { return SDL_SYSTEM_CURSOR_CROSSHAIR; }
    if (kind == 2) { return SDL_SYSTEM_CURSOR_SIZEWE; }
    if (kind == 3) { return SDL_SYSTEM_CURSOR_SIZENS; }
    if (kind == 4) { return SDL_SYSTEM_CURSOR_IBEAM; }
    if (kind == 5) { return SDL_SYSTEM_CURSOR_HAND; }
    if (kind == 6) { return SDL_SYSTEM_CURSOR_SIZEALL; }
    if (kind == 7) { return SDL_SYSTEM_CURSOR_CROSSHAIR; }
    if (kind == 8) { return SDL_SYSTEM_CURSOR_HAND; }
    return SDL_SYSTEM_CURSOR_ARROW;
}

static void dgfx_set_cursor(int kind) {
    if (kind < 0) { kind = 0; }
    if (kind > 15) { kind = 0; }
    if (kind == g_dgfx_cursor_kind) { return; }
    if (g_dgfx_cursors[kind] == nullptr) {
        g_dgfx_cursors[kind] = SDL_CreateSystemCursor(dgfx_system_cursor(kind));
    }
    if (g_dgfx_cursors[kind] != nullptr) {
        SDL_SetCursor(g_dgfx_cursors[kind]);
        g_dgfx_cursor_kind = kind;
    }
}

// --- native file dialogs -----------------------------------------------------
//
// A file picker is the one thing a portable app cannot draw for itself: the
// list of places a person keeps their documents belongs to the system, and so
// do the permissions to read them. Rather than link a toolkit for one dialog,
// this asks the system the way a shell script would — `osascript` on macOS,
// `zenity` or `kdialog` on Linux — and reads back a path. Nothing extra is
// installed for it; if none of them answer, the picker returns nothing and the
// app carries on with the workbook it already has.
//
// No backslash escapes anywhere below: this whole block lives inside a Ranger
// string, so a character that needs escaping is written as its code instead.
static std::string dgfx_run_capture(const std::string& cmd) {
    FILE* pipe = popen(cmd.c_str(), \"r\");
    if (pipe == nullptr) { return std::string(); }
    std::string out;
    char buf[512];
    while (fgets(buf, (int)sizeof(buf), pipe) != nullptr) { out += buf; }
    int rc = pclose(pipe);
    if (rc != 0) { return std::string(); }
    while (!out.empty() && (out.back() == 10 || out.back() == 13)) { out.pop_back(); }
    return out;
}

static bool dgfx_have(const char* tool) {
    std::string probe = std::string(\"command -v \") + tool + \" >/dev/null 2>&1\";
    return system(probe.c_str()) == 0;
}

// Wrap in single quotes so the shell reads the text as one word. A quote of
// its own is dropped rather than escaped — a file name containing one is not
// worth a second quoting scheme, and dropping it can only fail to find a file,
// never run something else.
static std::string dgfx_shell_quote(const std::string& in) {
    std::string out;
    out += (char)39;
    for (size_t i = 0; i < in.size(); i++) {
        if (in[i] == (char)39) { continue; }
        out += in[i];
    }
    out += (char)39;
    return out;
}

// The same idea one level in: a literal inside the AppleScript that the shell
// quoting above then wraps. A quote or a backslash in the text is dropped.
static std::string dgfx_as_string(const std::string& in) {
    std::string out;
    out += (char)34;
    for (size_t i = 0; i < in.size(); i++) {
        if (in[i] == (char)34) { continue; }
        if (in[i] == (char)92) { continue; }
        out += in[i];
    }
    out += (char)34;
    return out;
}

static std::string dgfx_pick_open_file(const std::string& title) {
#if defined(__APPLE__)
    // AppleScript of type wants UTIs (or classic type codes), not bare
    // extensions — a literal xlsx type matches nothing and greys workbooks out.
    std::string script = std::string(\"POSIX path of (choose file with prompt \")
        + dgfx_as_string(title)
        + \" of type {\"
        + dgfx_as_string(\"org.openxmlformats.spreadsheetml.sheet\")
        + \", \"
        + dgfx_as_string(\"com.microsoft.excel.xlsx\")
        + \"})\";
    return dgfx_run_capture(\"osascript -e \" + dgfx_shell_quote(script) + \" 2>/dev/null\");
#else
    if (dgfx_have(\"zenity\")) {
        return dgfx_run_capture(std::string(\"zenity --file-selection --title=\")
            + dgfx_shell_quote(title)
            + \" --file-filter=\" + dgfx_shell_quote(\"Workbooks | *.xlsx\")
            + \" --file-filter=\" + dgfx_shell_quote(\"All files | *\")
            + \" 2>/dev/null\");
    }
    if (dgfx_have(\"kdialog\")) {
        return dgfx_run_capture(std::string(\"kdialog --getopenfilename . \")
            + dgfx_shell_quote(\"*.xlsx|Workbooks\")
            + \" --title \" + dgfx_shell_quote(title) + \" 2>/dev/null\");
    }
    return std::string();
#endif
}

static std::string dgfx_pick_save_file(const std::string& title, const std::string& suggested) {
#if defined(__APPLE__)
    std::string script = std::string(\"POSIX path of (choose file name with prompt \")
        + dgfx_as_string(title)
        + \" default name \" + dgfx_as_string(suggested) + \")\";
    return dgfx_run_capture(\"osascript -e \" + dgfx_shell_quote(script) + \" 2>/dev/null\");
#else
    if (dgfx_have(\"zenity\")) {
        return dgfx_run_capture(std::string(\"zenity --file-selection --save --confirm-overwrite --title=\")
            + dgfx_shell_quote(title)
            + \" --filename=\" + dgfx_shell_quote(suggested) + \" 2>/dev/null\");
    }
    if (dgfx_have(\"kdialog\")) {
        return dgfx_run_capture(std::string(\"kdialog --getsavefilename \")
            + dgfx_shell_quote(suggested) + \" \" + dgfx_shell_quote(\"*.xlsx|Workbooks\")
            + \" --title \" + dgfx_shell_quote(title) + \" 2>/dev/null\");
    }
    return std::string();
#endif
}

// The window's size in POINTS — the space SDL reports the pointer in, and the
// space the page is laid out in. It has to be ASKED for, every time: the size
// the window was created with is only a request, and the user can drag the
// corner afterwards. (g_dgfx_fb_* is not it — the old blit path overwrites
// those with the DRAWABLE size, which on a Retina screen is twice as large.)
static int dgfx_window_width() {
    if (g_dgfx_win == nullptr) { return g_dgfx_fb_w; }
    int w = 0, h = 0;
    SDL_GetWindowSize(g_dgfx_win, &w, &h);
    return w;
}
static int dgfx_window_height() {
    if (g_dgfx_win == nullptr) { return g_dgfx_fb_h; }
    int w = 0, h = 0;
    SDL_GetWindowSize(g_dgfx_win, &w, &h);
    return h;
}

static void dgfx_present(const uint8_t* pixels, int w, int h) {
    if (g_dgfx_win == nullptr || g_dgfx_glctx == nullptr || pixels == nullptr) { return; }
    if (g_dgfx_program == 0) { return; }
    SDL_GL_MakeCurrent(g_dgfx_win, g_dgfx_glctx);
    int drawW = w;
    int drawH = h;
    SDL_GL_GetDrawableSize(g_dgfx_win, &drawW, &drawH);
    g_dgfx_fb_w = drawW;
    g_dgfx_fb_h = drawH;
    glViewport(0, 0, drawW, drawH);
    glClearColor(0.92f, 0.93f, 0.95f, 1.f);
    glClear(GL_COLOR_BUFFER_BIT);

    glBindTexture(GL_TEXTURE_2D, g_dgfx_tex);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
    if (g_dgfx_tex_w == w && g_dgfx_tex_h == h) {
        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
    } else {
        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
        g_dgfx_tex_w = w;
        g_dgfx_tex_h = h;
    }

    const float verts[24] = {
        -1.f, -1.f, 0.f, 1.f,
         1.f, -1.f, 1.f, 1.f,
         1.f,  1.f, 1.f, 0.f,
        -1.f, -1.f, 0.f, 1.f,
         1.f,  1.f, 1.f, 0.f,
        -1.f,  1.f, 0.f, 0.f
    };
    glUseProgram(g_dgfx_program);
#if !((defined(__arm__) || defined(__aarch64__)) && !defined(__APPLE__))
    if (g_dgfx_vao != 0) { glBindVertexArray(g_dgfx_vao); }
#endif
    glActiveTexture(GL_TEXTURE0);
    glBindTexture(GL_TEXTURE_2D, g_dgfx_tex);
    glUniform1i(g_dgfx_tex_uniform, 0);
    glBindBuffer(GL_ARRAY_BUFFER, g_dgfx_vbo);
    glBufferData(GL_ARRAY_BUFFER, sizeof(verts), verts, GL_STREAM_DRAW);
    glEnableVertexAttribArray((GLuint) g_dgfx_pos_attr);
    glVertexAttribPointer((GLuint) g_dgfx_pos_attr, 2, GL_FLOAT, GL_FALSE, 4 * (GLsizei) sizeof(float), (void*) 0);
    glEnableVertexAttribArray((GLuint) g_dgfx_uv_attr);
    glVertexAttribPointer((GLuint) g_dgfx_uv_attr, 2, GL_FLOAT, GL_FALSE, 4 * (GLsizei) sizeof(float), (void*) (2 * sizeof(float)));
    glDrawArrays(GL_TRIANGLES, 0, 6);
#if !((defined(__arm__) || defined(__aarch64__)) && !defined(__APPLE__))
    if (g_dgfx_vao != 0) { glBindVertexArray(0); }
#endif
    SDL_GL_SwapWindow(g_dgfx_win);
}

static void dgfx_poll() {
    g_dgfx_keys.clear();
    g_dgfx_text.clear();
    dgfx_pump();
}

static int dgfx_should_close() { return g_dgfx_should_close_flag; }

static int dgfx_shift_down() {
    SDL_Keymod m = SDL_GetModState();
    return ((m & (KMOD_SHIFT)) != 0) ? 1 : 0;
}

static int dgfx_ctrl_down() {
    SDL_Keymod m = SDL_GetModState();
    return ((m & (KMOD_CTRL | KMOD_GUI)) != 0) ? 1 : 0;
}

static int dgfx_pop_key() {
    if (g_dgfx_keys.empty()) { return DGFX_KEY_NONE; }
    int k = g_dgfx_keys.front();
    g_dgfx_keys.erase(g_dgfx_keys.begin());
    return k;
}

static std::string dgfx_take_text() {
    std::string t = g_dgfx_text;
    g_dgfx_text.clear();
    return t;
}

static void dgfx_close() {
    if (g_dgfx_tex) { glDeleteTextures(1, &g_dgfx_tex); g_dgfx_tex = 0; }
    if (g_dgfx_vbo) { glDeleteBuffers(1, &g_dgfx_vbo); g_dgfx_vbo = 0; }
#if !((defined(__arm__) || defined(__aarch64__)) && !defined(__APPLE__))
    if (g_dgfx_vao) { glDeleteVertexArrays(1, &g_dgfx_vao); g_dgfx_vao = 0; }
#endif
    if (g_dgfx_program) { glDeleteProgram(g_dgfx_program); g_dgfx_program = 0; }
    if (g_dgfx_glctx) { SDL_GL_DeleteContext(g_dgfx_glctx); g_dgfx_glctx = nullptr; }
    if (g_dgfx_win) { SDL_DestroyWindow(g_dgfx_win); g_dgfx_win = nullptr; }
    SDL_Quit();
}

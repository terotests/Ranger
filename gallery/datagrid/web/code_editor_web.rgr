; ==============================================================================
; code_editor_web — the code editor page, as one class a browser can hold
; ==============================================================================
;
;   INPUT   browser event → CodeEditorWeb → UIInput → CodeEditorPage
;   RENDER  CodeEditorPage.sceneJson() → EVGDisplayList → evg-webgl.js
;
; The same seam the DataGrid's own page uses, and the same one the SDL binary
; draws through — see platform/sdl/code_editor_sdl.rgr. Nothing in this file
; knows anything about editing: it turns events into UIInput, and hands back
; the scene.
; ==============================================================================

Import "../src/script/CodeEditorPage.rgr"
Import "../../game_engine/ui/UIInput.rgr"

class CodeEditorWeb {
    def page:CodeEditorPage (new CodeEditorPage)
    def input:UIInput (new UIInput)

    Constructor () {
    }

    fn start:void (w:int h:int) {
        page.initBare(w h)
    }

    fn addFont:boolean (family:string data:buffer) {
        return (page.addFont(family data))
    }

    fn addFace:boolean (data:buffer) {
        return (page.addFace(data))
    }

    fn resize:void (w:int h:int) {
        page.resize(w h)
    }

    fn pointer:void (x:int y:int down:boolean shift:boolean ctrl:boolean) {
        input.newFrame()
        input.setModifiers(shift ctrl)
        input.setPointerPos(x y)
        input.setPointerDown(down)
        page.update(input)
    }

    ; Double and triple click. The host counts the clicks — the browser is the
    ; only thing that knows what "double" means on this platform.
    fn selectWord:void (x:int y:int) {
        page.selectWordAt(x y)
    }

    fn selectLine:void (x:int y:int) {
        page.selectLineAt(x y)
    }

    fn wheel:void (x:int y:int delta:int) {
        input.newFrame()
        input.setPointerPos(x y)
        input.addScroll(delta)
        page.update(input)
    }

    fn text:void (s:string shift:boolean ctrl:boolean) {
        input.newFrame()
        input.setModifiers(shift ctrl)
        input.pushText(s)
        page.update(input)
    }

    fn key:void (name:string shift:boolean ctrl:boolean) {
        def code:int (CodeEditorWeb.keyByName(name))
        if (code == 0) {
            return
        }
        input.newFrame()
        input.setModifiers(shift ctrl)
        input.pushKey(code)
        page.update(input)
    }

    ; The browser's key names as UIKey's numbers — kept here rather than in the
    ; page so a second host does not have to invent the same table.
    sfn keyByName:int (name:string) {
        if (name == "backspace") { return (UIKey.backspace()) }
        if (name == "enter")     { return (UIKey.enter()) }
        if (name == "tab")       { return (UIKey.tab()) }
        if (name == "escape")    { return (UIKey.escape()) }
        if (name == "left")      { return (UIKey.left()) }
        if (name == "right")     { return (UIKey.right()) }
        if (name == "up")        { return (UIKey.up()) }
        if (name == "down")      { return (UIKey.down()) }
        if (name == "delete")    { return (UIKey.del()) }
        if (name == "home")      { return (UIKey.home()) }
        if (name == "end")       { return (UIKey.end()) }
        if (name == "pageUp")    { return (UIKey.pageUp()) }
        if (name == "pageDown")  { return (UIKey.pageDown()) }
        return 0
    }

    ; A frame with no input in it: the caret blinks, so the page still has to
    ; be able to ask for the picture again.
    fn tick:void () {
        input.newFrame()
        page.update(input)
    }

    ; What the picture depends on, cheaply. The page asks this every animation
    ; frame and only builds a scene when it has changed.
    fn revision:string () {
        return (page.revision())
    }

    fn scene:string () {
        return (page.sceneJson())
    }

    fn status:string () {
        return page.status
    }

    fn documentName:string () {
        return page.docName
    }

    fn documentText:string () {
        return (page.text())
    }

    fn setDocument:void (src:string) {
        page.setText(src)
    }

    ; A file the host fetched: the text, and what to call it in the header.
    fn setDocumentNamed:void (name:string src:string) {
        ; Named first, THEN loaded: the name is what picks the language plugin,
        ; and a document diagnosed as JavaScript because it arrived before its
        ; own name is a .rgr file full of imaginary errors.
        page.setNamedText(name src)
        page.status = ("opened " + name + " · " + (page.languageId()))
    }

    fn languageId:string () {
        return (page.languageId())
    }

    fn problemCount:int () {
        return (page.editor.problemCount())
    }

    ; How long the last full check took, and whether what is shown is the fast
    ; pass alone — the two numbers that say whether a language plugin is
    ; affordable on this document.
    fn diagnoseMicros:int () {
        return page.editor.diagnoseUs
    }

    fn fastPassOnly:boolean () {
        return page.editor.quickOnly
    }

    ; The problems, flattened for a host that wants to list them: one line per
    ; diagnostic, "line|col|severity|source|message".
    fn problemLines:[string] () {
        def out:[string]
        def n:int (page.editor.problemCount())
        def i:int 0
        while (i < n) {
            def d:EditorDiagnostic (page.editor.problemAt(i))
            def row:string ((to_string d.line) + "|" + (to_string d.col) + "|" + (to_string d.severity) + "|" + d.source + "|" + d.message)
            push out row
            i = (i + 1)
        }
        return out
    }

    fn nextSample:void () {
        page.nextSample()
    }

    ; --- what an accessible host needs to mirror -------------------------------
    ; A canvas cannot be read by a screen reader, so the page keeps a hidden
    ; <textarea> holding the CURRENT LINE with the caret in the right column —
    ; the technique Monaco and CodeMirror 5 use. These are what it mirrors.
    fn caretLine:int () {
        return page.editor.sel.caret.line
    }

    fn caretCol:int () {
        return page.editor.sel.caret.col
    }

    fn anchorLine:int () {
        return page.editor.sel.anchor.line
    }

    fn anchorCol:int () {
        return page.editor.sel.anchor.col
    }

    fn hasSelection:boolean () {
        def collapsed:boolean (page.editor.sel.isCollapsed())
        return (collapsed == false)
    }

    fn lineText:string (i:int) {
        if (i < 0) {
            return ""
        }
        if (i >= (page.editor.buf.lineCount())) {
            return ""
        }
        return (page.editor.buf.lineAt(i))
    }

    fn currentLine:string () {
        return (this.lineText((this.caretLine())))
    }

    ; --- the clipboard ---------------------------------------------------------
    ; Answered from the MODEL rather than from the mirrored line, because a
    ; selection is not required to stay on one line and the mirror is.
    ; --- the completion list, for the host's accessible mirror -----------------
    fn completionOpen:boolean () {
        return page.editor.completionOpen
    }

    fn completionCount:int () {
        return (page.editor.completionCount())
    }

    fn completionIndex:int () {
        return page.editor.completionIndex
    }

    fn completionLabel:string (i:int) {
        if (i < 0) {
            return ""
        }
        if (i >= (page.editor.completionCount())) {
            return ""
        }
        def c:Completion (page.editor.completionAt(i))
        return c.label
    }

    fn completionDetail:string (i:int) {
        if (i < 0) {
            return ""
        }
        if (i >= (page.editor.completionCount())) {
            return ""
        }
        def c:Completion (page.editor.completionAt(i))
        return c.detail
    }

    fn selectionText:string () {
        return (page.editor.selectionText())
    }

    fn cutSelection:string () {
        return (page.editor.cutSelection())
    }

    ; How long the last full re-lex took, in microseconds — the number the
    ; compare bench needs to say WHERE an insert's cost went.
    fn lexMicros:int () {
        return page.lexUs
    }

    fn width:int () {
        return page.W
    }

    fn height:int () {
        return page.H
    }

    fn lineCount:int () {
        return (page.editor.buf.lineCount())
    }

    fn tokenCount:int () {
        return (page.tokenCount())
    }
}

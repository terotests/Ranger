; ==============================================================================
; font_metrics_test.rgr — the print-correctness gate for text
; ==============================================================================
; PLAN_CSS_LAYOUT_AND_FONTS.md §12.1/§12.2. These are golden values: they lock
; the advance widths that come out of the real TTF files, so a change to font
; loading, the measurer or the shaping path shows up as a failing number rather
; than as a photo book that reflows in print.
;
; Unlike evg_test (which runs against a stub measurer), this suite needs the
; actual font files under gallery/pdf_writer/assets/fonts.
;
;   bash gallery/pdf_writer/test/run_fonts.sh
; ==============================================================================

Import "../src/fonts/FontManager.rgr"
Import "../src/fonts/EVGFontSetup.rgr"
Import "../src/fonts/TTFSubset.rgr"
Import "../../evg/EVGTextEngine.rgr"
Import "../../evg/EVGTextMeasurer.rgr"
Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGLayout.rgr"
Import "../../game_engine/v2/tests/harness/RgTest.rgr"

class FontMetricsTest {

    sfn m@(main):void () {
        def test (new FontMetricsTest())
        def t:RgTest (RgTest.forSuite("pdf_writer/font_metrics"))

        def setup (new EVGFontSetup())
        setup.init("./gallery/pdf_writer/" "")
        def fm:FontManager (setup.getManager())

        t.ok("font files were found" ((fm.getFontCount()) > 0))
        if ((fm.getFontCount()) == 0) {
            print "  Cannot run metric goldens without font files."
            t.summary()
            return
        }

        test.testFaceAvailability(t fm)
        test.testAdvanceWidths(t fm)
        test.testBoldIsARealFace(t fm)
        test.testVerticalMetrics(t fm)
        test.testWrapAgreement(t fm)
        test.testLayoutMatchesMeasurer(t fm)
        test.testRasterWrapMatchesLayout(t fm)
        test.testKerning(t fm)
        test.testBoldIsMeasured(t fm)
        test.testEmojiFallback(t fm)
        test.testSubset(t fm)
        test.testShaping(t fm)
        t.summary()
    }

    ; font-weight has to reach the MEASUREMENT, not just the paint.
    ;
    ; The renderers pick a bold cut by appending "-Bold" to the family when
    ; they draw; layout measured the plain family. A bold heading was therefore
    ; measured in the regular face and drawn in the wider bold one, so it
    ; wrapped a line later than the box it had been given.
    ;
    ; Chromium lays "A Mysterious Discovery" out at 18px as 196.0156 regular
    ; and 209.25 bold; EVG used to report the first for BOTH. The goldens below
    ; are EVG's own values, which sit 0.011px under the browser's because
    ; Chromium rounds each advance — browser agreement itself is enforced to
    ; 0.05px by browser_parity_test, which has bold faces of its own.
    fn testBoldIsMeasured:void (t:RgTest fm:FontManager) {
        def text:string "A Mysterious Discovery"
        def regular:double (fm.measureText(text "Noto Sans" 18.0))
        def bold:double (fm.measureText(text "Noto Sans-Bold" 18.0))
        t.near("the regular face measures as the browser does" regular 196.0048828125)
        t.near("the bold face measures as the browser does" bold 209.2412109375)
        t.ok("bold is wider than regular" (bold > regular))

        ; And an element carrying font-weight resolves to that face, which is
        ; what puts the two in agreement.
        def plain (new EVGElement())
        plain.setAttribute("font-family" "Noto Sans")
        t.eqStr("an unweighted element uses the family" (plain.effectiveFontFamily()) "Noto Sans")

        def heading (new EVGElement())
        heading.setAttribute("font-family" "Noto Sans")
        heading.setAttribute("font-weight" "bold")
        t.eqStr("a bold element resolves to the bold face" (heading.effectiveFontFamily()) "Noto Sans-Bold")

        ; Layout measures through the same resolver, so the shrink-wrapped box
        ; of a bold label is the bold width.
        heading.textContent = text
        heading.setAttribute("font-size" "18px")
        def page (new EVGElement())
        page.setAttribute("width" "400px")
        page.setAttribute("height" "200px")
        page.addChild(heading)
        def lay (new EVGLayout())
        lay.setMeasurer((new TTFTextMeasurer(fm)))
        lay.layout(page)
        t.near("a bold label shrink-wraps to the bold width" heading.calculatedWidth 209.2412109375)
    }

    ; Kerning, read from GPOS pair adjustments (or the legacy `kern` table on a
    ; face with no GPOS at all).
    fn testKerning:void (t:RgTest fm:FontManager) {
        def cinzel:TrueTypeFont (fm.getFont("Cinzel"))
        def openSans:TrueTypeFont (fm.getFont("Open Sans"))
        def noto:TrueTypeFont (fm.getFont("Noto Sans"))

        t.ok("Cinzel declares kerning" cinzel.hasKerning)
        t.ok("Noto Sans declares kerning" noto.hasKerning)

        ; Open Sans has a GPOS table with no `kern` feature AND 18694 legacy
        ; kern pairs. OpenType says GPOS wins outright, and a browser agrees:
        ; it renders Open Sans unkerned. Falling back to the legacy table made
        ; EVG kern a run Chromium leaves alone.
        t.no("Open Sans does not kern, despite a legacy kern table" openSans.hasKerning)
        t.ok("...and it really does carry one" (((openSans.findTable("kern")).offset) > 0))
        t.ok("...alongside a GPOS table" (((openSans.findTable("GPOS")).offset) > 0))

        ; A pair that kerns, and one that does not.
        def hiKern:int (cinzel.kernUnits(72 101))
        t.ok("Cinzel kerns \"He\" tighter" (hiKern < 0))
        t.eqInt("a pair with no adjustment is zero" (cinzel.kernUnits(72 72)) 0)
        t.eqInt("a face that does not kern returns zero" (openSans.kernUnits(72 101)) 0)

        ; Points scale linearly with size, like every other advance.
        def at16:double (cinzel.kernPoints(72 101 16.0))
        def at32:double (cinzel.kernPoints(72 101 32.0))
        t.near("kerning scales with font size" (at32 / 2.0) at16)
        t.ok("kerning is negative for a tightening pair" (at16 < 0.0))

        ; measureText is the sum of the advances plus the kerning, which is
        ; what makes the measured box match the painted ink.
        def text:string "Helsinki, 2024"
        def advances:double 0.0
        def kerns:double 0.0
        def i:int 0
        while (i < (strlen text)) {
            advances = (advances + (cinzel.getCharWidthPoints((charAt text i) 30.0)))
            if (i > 0) {
                kerns = (kerns + (cinzel.kernPoints((charAt text (i - 1)) (charAt text i) 30.0)))
            }
            i = (i + 1)
        }
        t.ok("this fixture actually kerns" (kerns < 0.0))
        t.near("measureText = advances + kerning" (cinzel.measureText(text 30.0)) (advances + kerns))

        ; The value the plan recorded as the worst unkerned error.
        t.near("Cinzel 'Helsinki, 2024' @30 matches the browser" (cinzel.measureText(text 30.0)) 212.61)
    }

    ; getFont() always returns something, so hasFont is what tells a caller
    ; whether the face it asked for is the face it will get.
    fn testFaceAvailability:void (t:RgTest fm:FontManager) {
        t.ok("Open Sans is loaded" (fm.hasFont("Open Sans")))
        t.ok("Cinzel is loaded" (fm.hasFont("Cinzel")))
        t.ok("Noto Sans is loaded" (fm.hasFont("Noto Sans")))
        t.no("an unknown family is reported missing" (fm.hasFont("No Such Family")))

        def m (new TTFTextMeasurer(fm))
        t.ok("TTF measurer declares itself accurate" (m.isFontAccurate()))
        t.ok("TTF measurer sees a loaded face" (m.hasFace("Cinzel")))
        t.no("TTF measurer reports a missing face" (m.hasFace("No Such Family")))

        def heuristic (new SimpleTextMeasurer())
        t.no("heuristic measurer admits it is not font accurate" (heuristic.isFontAccurate()))
    }

    ; Golden advance widths. If these move, glyph metrics or the measurement
    ; path changed and every laid-out page moves with them.
    ;
    ; These now include kerning, so they are what a browser shows rather than
    ; the bare sum of hmtx advances. Open Sans is unchanged: it has a GPOS
    ; table with no `kern` feature, so it does not kern — and its legacy `kern`
    ; table is correctly ignored, exactly as a browser ignores it.
    fn testAdvanceWidths:void (t:RgTest fm:FontManager) {
        t.near("Open Sans 'Hamburgefonstiv' @16" (fm.measureText("Hamburgefonstiv" "Open Sans" 16.0)) 129.734375)
        t.near("Open Sans 'Helsinki, 2024' @30" (fm.measureText("Helsinki, 2024" "Open Sans" 30.0)) 193.9599609375)
        ; Cinzel kerns: 154.464 unkerned, 153.184 as Chromium lays it out.
        t.near("Cinzel 'Hamburgefonstiv' @16" (fm.measureText("Hamburgefonstiv" "Cinzel" 16.0)) 153.184)
        ; Cross-checked against Chromium laying out the same string in the same
        ; file (see font_parity.js): the browser reports 192.69 too.
        t.near("Noto Sans 'Helsinki, 2024' @30" (fm.measureText("Helsinki, 2024" "Noto Sans" 30.0)) 192.685546875)
        ; Exactly double the 16px width — advances scale with the em, so a
        ; rounding change anywhere in the path breaks this first.
        t.near("width scales linearly with size" (fm.measureText("Hamburgefonstiv" "Open Sans" 32.0)) 259.46875)
        t.near("empty string measures zero" (fm.measureText("" "Open Sans" 16.0)) 0.0)
    }

    ; §4.1 rule 6: bold must resolve to a loaded bold face, not a widened
    ; regular one. If the two measured the same, layout would be reserving
    ; regular-width boxes for bold text.
    fn testBoldIsARealFace:void (t:RgTest fm:FontManager) {
        def regular:double (fm.measureText("Hamburgefonstiv" "Open Sans" 16.0))
        def bold:double (fm.measureText("Open Sans-Bold" "Open Sans-Bold" 16.0))
        t.ok("a bold face is loaded" (fm.hasFont("Open Sans-Bold")))
        def boldSame:double (fm.measureText("Hamburgefonstiv" "Open Sans-Bold" 16.0))
        t.ok("bold is wider than regular" (boldSame > regular))
        t.near("Open Sans Bold 'Hamburgefonstiv' @16" boldSame 139.515625)
    }

    ; Line height / ascent / descent come from the font's own tables, not a
    ; 1.2 multiplier, so vertical space matches the face being painted.
    fn testVerticalMetrics:void (t:RgTest fm:FontManager) {
        def lh:double (fm.getLineHeight("Open Sans" 16.0))
        def asc:double (fm.getAscender("Open Sans" 16.0))
        def desc:double (fm.getDescender("Open Sans" 16.0))
        t.ok("line height is positive" (lh > 0.0))
        t.ok("line height is not the 1.2 default" ((lh > 19.3) || (lh < 19.1)))
        t.ok("ascender is positive" (asc > 0.0))
        t.ok("ascent plus descent fits inside the line" ((asc + desc) <= (lh + 0.001)))
    }

    ; The wrap the engine produces is the wrap paint uses, because there is only
    ; one implementation now. This pins the actual break positions.
    fn testWrapAgreement:void (t:RgTest fm:FontManager) {
        def measurer (new TTFTextMeasurer(fm))
        def eng (new EVGTextEngine())
        eng.setMeasurer(measurer)

        def para:string "Twelve days along the shoreline, from the first thaw to midsummer light."
        def lines:[EVGTextLine] (eng.breakLines(para "Open Sans" 13.0 200.0))
        t.eqInt("paragraph wraps to the expected line count" (array_length lines) 3)

        ; Every produced line must actually fit the box it was wrapped into.
        def i:int 0
        def allFit:boolean true
        while (i < (array_length lines)) {
            def ln:EVGTextLine (itemAt lines i)
            if (ln.width > 200.0) {
                allFit = false
            }
            i = (i + 1)
        }
        t.ok("no wrapped line overflows its width" allFit)

        ; lineCount is the same computation layout uses for height.
        t.eqInt("lineCount matches breakLines" (eng.lineCount(para "Open Sans" 13.0 200.0)) 3)

        ; A narrower box must not produce fewer lines.
        t.ok("narrower box wraps at least as much"
            ((eng.lineCount(para "Open Sans" 13.0 120.0)) >= 3))

        ; No warnings for a loaded family, even in strict mode.
        eng.setStrict(true)
        eng.breakLines(para "Open Sans" 13.0 200.0)
        t.no("loaded family is not fatal under strict fonts" eng.hadFatal)
    }

    ; The raster target paints glyph outlines from the same TTFs, so it has to
    ; break lines where layout broke them. Both the PNG tool and the preview
    ; server used to draw the whole textContent as ONE line while the layout
    ; above them had reserved several — the caption simply ran out of its box.
    ; They now call this engine, so pinning it here pins them.
    fn testRasterWrapMatchesLayout:void (t:RgTest fm:FontManager) {
        def measurer (new TTFTextMeasurer(fm))
        def eng (new EVGTextEngine())
        eng.setMeasurer(measurer)

        def para:string "Twelve days along the shoreline, from the first thaw to the midsummer light over Kaivopuisto."

        ; What layout reserves height for...
        def lay (new EVGLayout())
        lay.setMeasurer(measurer)
        def root (new EVGElement())
        root.width = (EVGUnit.px(400.0))
        root.height = (EVGUnit.px(200.0))
        def label (new EVGElement())
        label.textContent = para
        label.fontFamily = "Cinzel"
        label.fontSize = (EVGUnit.px(14.0))
        label.width = (EVGUnit.px(300.0))
        root.addChild(label)
        lay.layout(root)

        ; ...must be the number of lines the raster will paint.
        def lines:[EVGTextLine] (eng.breakLines(para "Cinzel" 14.0 300.0))
        def painted:int (array_length lines)
        t.ok("the caption actually wraps" (painted > 1))

        def lineStep:double (14.0 * 1.2)
        def reserved:double (lineStep * (to_double painted))
        t.near("layout reserved exactly the painted lines" label.calculatedHeight reserved)

        ; And every painted line fits the box, so nothing runs off the edge.
        def i:int 0
        def allFit:boolean true
        while (i < painted) {
            def ln:EVGTextLine (itemAt lines i)
            if (ln.width > 300.0) {
                allFit = false
            }
            i = (i + 1)
        }
        t.ok("no painted line overflows the box" allFit)

        ; The face matters: the raster used to paint everything in Open Sans
        ; whatever the document asked for, which would wrap differently.
        def otherFace:[EVGTextLine] (eng.breakLines(para "Open Sans" 14.0 300.0))
        def otherFirst:EVGTextLine (itemAt otherFace 0)
        def cinzelFirst:EVGTextLine (itemAt lines 0)
        def differs:boolean false
        if ((array_length otherFace) != painted) {
            differs = true
        }
        if (otherFirst.text != cinzelFirst.text) {
            differs = true
        }
        t.ok("a different face is a different wrap" differs)
    }

    ; End to end: the width layout assigns to a shrink-wrapped label is the
    ; width the measurer reports for that string in that face.
    fn testLayoutMatchesMeasurer:void (t:RgTest fm:FontManager) {
        def measurer (new TTFTextMeasurer(fm))
        def lay (new EVGLayout())
        lay.setMeasurer(measurer)

        def root (new EVGElement())
        root.width = (EVGUnit.px(500.0))
        root.height = (EVGUnit.px(200.0))

        def label (new EVGElement())
        label.textContent = "Helsinki, 2024"
        label.fontFamily = "Cinzel"
        label.fontSize = (EVGUnit.px(30.0))
        root.addChild(label)

        lay.layout(root)

        def expected:double (fm.measureText("Helsinki, 2024" "Cinzel" 30.0))
        t.near("laid-out label width equals the measured advance" label.calculatedWidth expected)
        t.ok("and it is not the heuristic width" ((label.calculatedWidth - (14.0 * 30.0 * 0.55)) != 0.0))
    }

    ; Emoji reach the page at all.
    ;
    ; A text face has no emoji and an emoji face has no letters, so a run that
    ; mixes them cannot be measured or drawn from one file. Before the fallback
    ; existed, "Ready" plus a party popper measured as if the emoji were a
    ; .notdef box and painted as nothing, and the PDF encoder called it
    ; unencodable — because
    ; WinAnsi is one byte wide and U+1F389 does not fit in one byte at any
    ; price. This locks the pieces that make it work.
    fn testEmojiFallback:void (t:RgTest fm:FontManager) {
        def grin:int 128512          ; U+1F600
        def party:int 127881         ; U+1F389

        ; The face has to be loaded by default, or nothing below can happen.
        def emoji:TrueTypeFont (fm.getFont("Noto Emoji"))
        t.ok("the emoji face is loaded" (emoji.isLoaded()))

        ; Reaching an astral codepoint at all needs cmap format 12: format 4
        ; is 16-bit and cannot address past the BMP.
        t.eqInt("the emoji face is read through a format 12 cmap" emoji.cmapFormat 12)
        t.ok("and U+1F600 resolves to a real glyph" ((emoji.getGlyphIndex(grin)) > 0))

        ; The text face does NOT have it — which is the whole reason a fallback
        ; is needed, and worth asserting so this test cannot pass vacuously.
        def sans:TrueTypeFont (fm.getFont("Noto Sans"))
        t.ok("the text face does not" ((sans.getGlyphIndex(grin)) == 0))

        ; The lookup picks the face that has the glyph...
        def picked:TrueTypeFont (fm.faceForCodepoint("Noto Sans" party))
        t.eqStr("the fallback lookup finds the emoji face" picked.fontFamily "Noto Emoji")
        def forA:TrueTypeFont (fm.faceForCodepoint("Noto Sans" 65))
        t.eqStr("a letter still comes from the text face" forA.fontFamily "Noto Sans")

        ; ...and reports nothing when no loaded face has the codepoint. This
        ; used to answer with a blank TrueTypeFont that LOOKED loaded, because
        ; unitsPerEm is born 1000 — so an uncovered character was drawn as
        ; .notdef out of a font that had never been opened.
        def none:TrueTypeFont (fm.fallbackFace(1000000))
        t.ok("an uncovered codepoint has no fallback face" ((none.isLoaded()) == false))

        ; Measurement crosses the boundary: one emoji, not two half-glyphs.
        ; Built from the codepoint rather than written literally, so the test
        ; cannot be broken by the source file's own encoding.
        def grinStr:string (EVGCodepoint.toStr(grin))
        def mixed:double (fm.measureText(("a" + grinStr + "b") "Noto Sans" 20.0))
        def plain:double (fm.measureText("ab" "Noto Sans" 20.0))
        def oneEmoji:double (emoji.measureText(grinStr 20.0))
        t.near("a mixed run measures as its parts" mixed (plain + oneEmoji))
        t.ok("and the emoji contributes a real advance" (oneEmoji > 0.0))
    }


    ; The embedded font carries the glyphs the page used, not the face.
    ;
    ; 858 KB for one 🎉 was more than the rest of the PDF put together. The
    ; subset keeps glyph IDS — a dense renumbering would invalidate every
    ; string already written, since Identity-H puts glyph ids in the content
    ; stream — so the saving comes from `glyf` and from dropping every table a
    ; CIDFontType2 never consults.
    fn testSubset:void (t:RgTest fm:FontManager) {
        def emoji:TrueTypeFont (fm.getFont("Noto Emoji"))
        if ((emoji.isLoaded()) == false) {
            t.ok("emoji face present for the subset test" false)
            return
        }
        def wanted:[int]
        push wanted (emoji.getGlyphIndex(128512))
        def sub:buffer (TTFSubset.build(emoji wanted))
        def subLen:int (buffer_length sub)
        def fullLen:int (buffer_length (emoji.getFontData()))

        t.ok("the subset is not empty" (subLen > 0))
        t.ok("and is a small fraction of the face" (subLen < (to_int (fullLen / 20))))

        ; A valid sfnt: version 1.0 and the six tables a CIDFontType2 needs.
        def v0:int (buffer_get sub 0)
        def v1:int (buffer_get sub 1)
        def v2:int (buffer_get sub 2)
        def v3:int (buffer_get sub 3)
        t.ok("it starts with sfnt version 1.0"
             ((((v0 == 0) && (v1 == 1)) && (v2 == 0)) && (v3 == 0)))
        def numTables:int (((buffer_get sub 4) * 256) + (buffer_get sub 5))
        t.eqInt("with the six tables a CIDFontType2 needs" numTables 6)

        ; numGlyphs must still reach the glyph that was asked for, because the
        ; PDF names glyphs by their ORIGINAL id.
        def wantGid:int (itemAt wanted 0)
        def maxpNum:int (this.tableNumGlyphs(sub))
        t.ok("and numGlyphs still covers the requested glyph id" (maxpNum > wantGid))

        ; A face nothing asked for still subsets — to .notdef alone, not to
        ; nothing, so a reader always has a glyph 0 to fall back on.
        def none:[int]
        def bare:buffer (TTFSubset.build(emoji none))
        t.ok("an empty request still produces a font" ((buffer_length bare) > 0))
    }

    ; numGlyphs out of the subset's own maxp, found through its table directory.
    fn tableNumGlyphs:int (sub:buffer) {
        def n:int (((buffer_get sub 4) * 256) + (buffer_get sub 5))
        def i:int 0
        while (i < n) {
            def rec:int (12 + (i * 16))
            def tag:string ""
            def c:int 0
            while (c < 4) {
                tag = tag + (strfromcode (buffer_get sub (rec + c)))
                c = (c + 1)
            }
            if (tag == "maxp") {
                def off:int 0
                def b:int 0
                while (b < 4) {
                    off = ((off * 256) + (buffer_get sub ((rec + 8) + b)))
                    b = (b + 1)
                }
                return (((buffer_get sub (off + 4)) * 256) + (buffer_get sub (off + 5)))
            }
            i = (i + 1)
        }
        return 0
    }


    ; A sequence becomes the glyph it is supposed to be.
    ;
    ; Without GSUB ligature substitution, 👨‍👩‍👧 is three people and two
    ; invisible joiners, 👍🏽 is a thumb followed by a colour swatch, and 🇫🇮 is
    ; two letters in boxes. The face has one glyph for each of them; the
    ; shaper is what finds it.
    fn testShaping:void (t:RgTest fm:FontManager) {
        def emoji:TrueTypeFont (fm.getFont("Noto Emoji"))
        if ((emoji.isLoaded()) == false) {
            t.ok("emoji face present for the shaping test" false)
            return
        }
        t.ok("the emoji face carries ligature lookups" emoji.hasShaping)

        ; U+1F468 U+200D U+1F469 U+200D U+1F467
        def family:[int]
        push family 128104
        push family 8205
        push family 128105
        push family 8205
        push family 128103
        def famRun:TTFShapedRun (emoji.shape(family))
        t.eqInt("a joined family shapes to one glyph" (famRun.count()) 1)
        t.eqInt("and that glyph stands for all five codepoints"
                ((itemAt famRun.clusterEnd 0) - (itemAt famRun.clusterStart 0)) 5)

        ; U+1F1EB U+1F1EE
        def flag:[int]
        push flag 127467
        push flag 127470
        t.eqInt("a flag shapes to one glyph" ((emoji.shape(flag)).count()) 1)

        ; U+0031 U+FE0F U+20E3 — and the selector must not block the match.
        def keycap:[int]
        push keycap 49
        push keycap 65039
        push keycap 8419
        def keyRun:TTFShapedRun (emoji.shape(keycap))
        t.eqInt("a keycap shapes to one glyph" (keyRun.count()) 1)
        t.eqInt("with the variation selector inside its cluster"
                ((itemAt keyRun.clusterEnd 0) - (itemAt keyRun.clusterStart 0)) 3)

        ; The keycap's BASE is a digit, which the text face has. Choosing a
        ; face per codepoint therefore kept the "1" in the text face and sent
        ; only the tail to the emoji face, and the ligature never saw all
        ; three parts.
        def picked:TrueTypeFont (fm.faceForCluster("Noto Sans" keycap 0 3))
        t.eqStr("a keycap is drawn entirely from the emoji face"
                picked.fontFamily "Noto Emoji")
        def one:[int]
        push one 49
        def digit:TrueTypeFont (fm.faceForCluster("Noto Sans" one 0 1))
        t.eqStr("but a bare digit still comes from the text face"
                digit.fontFamily "Noto Sans")

        ; Width follows: one glyph, one advance. Measured through the manager
        ; — the path layout actually uses — against the face's own shaped
        ; measurement.
        def famStr:string ""
        def i:int 0
        while (i < (array_length family)) {
            famStr = famStr + (EVGCodepoint.toStr((itemAt family i)))
            i = (i + 1)
        }
        def viaManager:double (fm.measureText(famStr "Noto Sans" 20.0))
        def viaFace:double (emoji.measureShapedText(famStr 20.0))
        t.near("a family measures as the one glyph it becomes" viaManager viaFace)
        t.ok("and that is far less than its parts would be"
             (viaManager < (viaFace * 2.0)))
    }

}

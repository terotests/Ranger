Import "RasterBuffer.rgr"
Import "RasterCompositing.rgr"
Import "../../../evg/VectorStroke.rgr"

; ==============================================================================
; VectorRasterizer.rgr — one anti-aliased scanline fill, for every filled shape
; ==============================================================================
; PLAN_VECTOR_IR.md §3 and Stage 2.
;
; This code is not new. It was already in RasterText, where it rasterized
; TrueType glyph outlines: an edge list carrying winding direction, a scanline
; fill sampling a 4x4 subpixel grid, a non-zero winding test. Nothing about the
; fill stage was ever font-specific — only the INPUT was, being TrueType
; contours of on- and off-curve points.
;
; So the raster side of vector support is mostly this extraction rather than a
; new algorithm. Three things come out of it:
;
;   - <Path> can be filled in PNG output at all, which it could not before
;   - glyph rendering and path rendering cannot drift apart, because there is
;     one implementation to drift
;   - the WASM UI's fillPolygon gains anti-aliasing and hole support by calling
;     the same code instead of its own crossing count
;
; The one genuinely new capability is the even-odd fill rule, which glyphs never
; needed (TrueType is defined as non-zero) and SVG requires.
; ==============================================================================

; ------------------------------------------------------------------------------
; VectorEdge — one line segment of a closed contour, prepared for scanline use.
;
; Coordinates arrive in device space, Y increasing downward, already flipped by
; whoever produced them. `dir` records which way the edge crosses a scanline,
; which is what makes the non-zero rule possible; the even-odd rule ignores it.
; ------------------------------------------------------------------------------
class VectorEdge {
    def x1:double 0.0
    def y1:double 0.0
    def x2:double 0.0
    def y2:double 0.0
    def minY:double 0.0
    def maxY:double 0.0
    def xAtMinY:double 0.0  ; X coordinate at minY
    def dxdy:double 0.0     ; dx/dy slope for interpolation
    def dir:int 0           ; +1 going down the screen, -1 going up

    fn init:void (px1:double py1:double px2:double py2:double) {
        x1 = px1
        y1 = py1
        x2 = px2
        y2 = py2

        if (y1 < y2) {
            minY = y1
            maxY = y2
            xAtMinY = x1
            dir = 1
        } {
            minY = y2
            maxY = y1
            xAtMinY = x2
            dir = (0 - 1)
        }

        def dy:double (maxY - minY)
        if (dy > 0.0001) {
            if (y1 < y2) {
                dxdy = (x2 - x1) / dy
            } {
                dxdy = (x1 - x2) / dy
            }
        } {
            dxdy = 0.0
        }
    }

    ; X where this edge crosses the given scanline.
    fn getX:double (y:double) {
        return (xAtMinY + (dxdy * (y - minY)))
    }
}

; ------------------------------------------------------------------------------
; VectorRasterizer — accumulate contours, then fill them in one pass.
;
; Contours are accumulated rather than filled one at a time on purpose: a shape
; with holes only comes out right when every ring is present in the same fill,
; because whether a pixel is inside is a question about the whole shape, not
; about any one ring.
; ------------------------------------------------------------------------------
class VectorRasterizer {
    def edges:[VectorEdge]
    def compositor:RasterCompositor (new RasterCompositor())

    ; Optional rectangular clip, in device pixels. See setClipRect.
    def hasClip:boolean false
    def clipX0:int 0
    def clipY0:int 0
    def clipX1:int 0
    def clipY1:int 0

    ; Optional affine transform, applied as points arrive. See setTransform.
    def hasTransform:boolean false
    def ta:double 1.0
    def tb:double 0.0
    def tc:double 0.0
    def td:double 1.0
    def te:double 0.0
    def tf:double 0.0

    Constructor () {
        def e:[VectorEdge]
        edges = e
    }

    ; Fill rules. Non-zero counts the signed crossings and is what TrueType and
    ; SVG's default use; even-odd counts them unsigned and is what SVG's
    ; fill-rule="evenodd" selects. They differ exactly where a shape overlaps
    ; itself or nests inside itself.
    sfn nonZero:int () {
        return 0
    }

    sfn evenOdd:int () {
        return 1
    }

    fn reset:void () {
        def e:[VectorEdge]
        edges = e
    }

    fn edgeCount:int () {
        return (array_length edges)
    }

    ; An affine transform applied to every point on the way in, in SVG
    ; matrix(a b c d e f) order.
    ;
    ; Putting it here rather than at each call site is what makes rotation work
    ; for glyphs and paths alike: RasterText feeds its contours through addEdge
    ; exactly as a path does, so a rotated axis label and a rotated shape go
    ; through one implementation.
    ;
    ; Note for future use: `addStroke` computes its perpendiculars BEFORE the
    ; transform, so a rotation gives the right stroke width (rotation preserves
    ; length) but a non-uniform scale would skew it. Scale paths through the
    ; flattening matrix instead, where the stroke width is scaled to match.
    fn setTransform:void (a:double b:double c:double d:double e:double f:double) {
        ta = a
        tb = b
        tc = c
        td = d
        te = e
        tf = f
        hasTransform = true
    }

    fn clearTransform:void () {
        hasTransform = false
    }

    ; Confine the fill to a rectangle, inclusive of its far edge.
    ;
    ; A chart's series has to stop at the edge of the plot area rather than
    ; running out into the margin, and the raster target had no clipping at
    ; all. Rectangular is what `overflow: hidden` and a plot area need; an
    ; arbitrary clip path would mean a second coverage test per sample, which
    ; is a different and much more expensive thing.
    fn setClipRect:void (x0:int y0:int x1:int y1:int) {
        clipX0 = x0
        clipY0 = y0
        clipX1 = x1
        clipY1 = y1
        hasClip = true
    }

    fn clearClip:void () {
        hasClip = false
    }

    fn addEdge:void (rawX1:double rawY1:double rawX2:double rawY2:double) {
        def px1:double rawX1
        def py1:double rawY1
        def px2:double rawX2
        def py2:double rawY2
        if hasTransform {
            px1 = (((ta * rawX1) + (tc * rawY1)) + te)
            py1 = (((tb * rawX1) + (td * rawY1)) + tf)
            px2 = (((ta * rawX2) + (tc * rawY2)) + te)
            py2 = (((tb * rawX2) + (td * rawY2)) + tf)
        }

        ; A horizontal edge can never cross a scanline, so it contributes
        ; nothing and only costs time in the inner loop. Tested AFTER the
        ; transform, because a rotation is exactly what turns a horizontal edge
        ; into one that matters.
        def dy:double (py2 - py1)
        if (dy < 0.0) {
            dy = (0.0 - dy)
        }
        if (dy < 0.0001) {
            return
        }
        def edge (new VectorEdge())
        edge.init(px1 py1 px2 py2)
        push edges edge
    }

    ; Add one closed ring, given as a flat [x0 y0 x1 y1 ...] list. The ring is
    ; closed implicitly: a fill is defined only for closed contours, so an open
    ; one is closed rather than refused.
    fn addRing:void (pts:[double]) {
        def m:int (array_length pts)
        def n:int (idiv m 2)
        if (n < 2) {
            return
        }
        def k:int 0
        while (k < n) {
            def nextIdx:int (k + 1)
            if (nextIdx >= n) {
                nextIdx = 0
            }
            def ax:double (itemAt pts (k * 2))
            def ay:double (itemAt pts ((k * 2) + 1))
            def bx:double (itemAt pts (nextIdx * 2))
            def by:double (itemAt pts ((nextIdx * 2) + 1))
            this.addEdge(ax ay bx by)
            k = (k + 1)
        }
    }

    ; Add a stroke along a ring, as fillable geometry.
    ;
    ; PLAN_VECTOR_IR.md Stage 2 is explicit that this is the approximation, not
    ; the real thing: proper stroking builds offset curves with mitre/bevel
    ; joins and caps, which is a genuine algorithm rather than the extraction
    ; the fill side turned out to be. What this does instead is emit one quad
    ; per flattened segment plus a disc at each joint, and let the non-zero rule
    ; merge the overlaps — every quad is wound the same way, so overlapping
    ; regions accumulate winding and stay filled rather than cancelling.
    ;
    ; That gives round joins and butt caps, and is indistinguishable from a real
    ; stroke at icon weights. It is visibly an approximation for very thick
    ; strokes with sharp corners, where a mitre would come to a point.
    ;
    ; PDF and HTML stroke natively, so only the raster target uses this.
    fn addStroke:void (pts:[double] width:double closed:boolean) {
        def m:int (array_length pts)
        def n:int (idiv m 2)
        if (n < 2) {
            return
        }
        def hw:double (width / 2.0)
        if (hw <= 0.0) {
            return
        }

        def segCount:int (n - 1)
        if closed {
            segCount = n
        }

        def k:int 0
        while (k < segCount) {
            def nextIdx:int (k + 1)
            if (nextIdx >= n) {
                nextIdx = 0
            }
            def ax:double (itemAt pts (k * 2))
            def ay:double (itemAt pts ((k * 2) + 1))
            def bx:double (itemAt pts (nextIdx * 2))
            def by:double (itemAt pts ((nextIdx * 2) + 1))

            def dx:double (bx - ax)
            def dy:double (by - ay)
            def dlen:double (sqrt ((dx * dx) + (dy * dy)))
            if (dlen > 0.000001) {
                ; Perpendicular of unit length, scaled to half the stroke
                ; width. Derived from the segment direction, so the quad comes
                ; out with the same orientation whichever way the segment runs.
                def px:double (((0.0 - dy) / dlen) * hw)
                def py:double ((dx / dlen) * hw)

                def quad:[double]
                push quad (ax + px)
                push quad (ay + py)
                push quad (bx + px)
                push quad (by + py)
                push quad (bx - px)
                push quad (by - py)
                push quad (ax - px)
                push quad (ay - py)
                this.addRing(quad)
            }
            k = (k + 1)
        }

        ; A disc at every joint fills the wedge two quads leave open on the
        ; outside of a turn.
        def firstJoint:int 1
        def lastJoint:int (n - 1)
        if closed {
            firstJoint = 0
            lastJoint = n
        }
        def j:int firstJoint
        while (j < lastJoint) {
            def jx:double (itemAt pts (j * 2))
            def jy:double (itemAt pts ((j * 2) + 1))
            this.addDisc(jx jy hw)
            j = (j + 1)
        }
    }

    ; Add a dashed stroke along a ring.
    ;
    ; PDF has a dash operator and SVG has an attribute, so only the raster
    ; target has to do this itself — and here it is geometry, not state: walk
    ; the flattened polyline, cut it into the on and off runs the pattern asks
    ; for, and stroke the on runs. Dashes are what make a gridline read as a
    ; gridline rather than as another series.
    ;
    ; `dashes` alternates on, off, on, off. An odd-length pattern repeats to
    ; make it even, exactly as SVG specifies, so "4" means 4 on and 4 off.
    fn addDashedStroke:void (pts:[double] width:double closed:boolean dashes:[double] dashOffset:double) {
        def dn:int (array_length dashes)
        if (dn == 0) {
            this.addStroke(pts width closed)
            return
        }

        ; A pattern that is all zeroes would never advance. Treat it as solid
        ; rather than looping forever looking for a length that never arrives.
        def total:double 0.0
        def di:int 0
        while (di < dn) {
            def dv:double (itemAt dashes di)
            if (dv > 0.0) {
                total = (total + dv)
            }
            di = (di + 1)
        }
        if (total <= 0.0) {
            this.addStroke(pts width closed)
            return
        }

        def m:int (array_length pts)
        def n:int (idiv m 2)
        if (n < 2) {
            return
        }
        def segCount:int (n - 1)
        if closed {
            segCount = n
        }

        ; Walk the pattern with a cursor. `idx` is the position in the pattern
        ; and `remaining` how much of that entry is left; both survive across
        ; segment boundaries, so a dash spans a corner instead of restarting
        ; at every vertex.
        def idx:int 0
        def on:boolean true
        def remaining:double (itemAt dashes 0)
        if (remaining < 0.0) {
            remaining = 0.0
        }

        ; stroke-dashoffset shifts the pattern along the path, which is how a
        ; caller lines dashes up across separate gridlines.
        def skip:double dashOffset
        if (skip < 0.0) {
            skip = 0.0
        }
        while (skip > 0.0) {
            if (skip < remaining) {
                remaining = (remaining - skip)
                skip = 0.0
            } {
                skip = (skip - remaining)
                idx = (idx + 1)
                def wrapped:int idx
                if (wrapped >= dn) {
                    wrapped = (wrapped - ((idiv wrapped dn) * dn))
                    idx = wrapped
                }
                on = (on == false)
                remaining = (itemAt dashes idx)
                if (remaining < 0.0) {
                    remaining = 0.0
                }
            }
        }

        ; The run being accumulated, emitted whenever the pattern turns off.
        def run:[double]
        def runOpen:boolean false

        def k:int 0
        while (k < segCount) {
            def nextIdx:int (k + 1)
            if (nextIdx >= n) {
                nextIdx = 0
            }
            def ax:double (itemAt pts (k * 2))
            def ay:double (itemAt pts ((k * 2) + 1))
            def bx:double (itemAt pts (nextIdx * 2))
            def by:double (itemAt pts ((nextIdx * 2) + 1))

            def dx:double (bx - ax)
            def dy:double (by - ay)
            def segLen:double (sqrt ((dx * dx) + (dy * dy)))

            if (segLen > 0.000001) {
                def travelled:double 0.0
                while (travelled < segLen) {
                    def left:double (segLen - travelled)
                    def step:double remaining
                    if (step > left) {
                        step = left
                    }
                    ; A zero-length pattern entry would not advance; step past
                    ; it so the cursor keeps moving.
                    if (step <= 0.0) {
                        step = 0.0
                    }

                    def t0:double (travelled / segLen)
                    def t1:double ((travelled + step) / segLen)
                    def x0:double (ax + (dx * t0))
                    def y0:double (ay + (dy * t0))
                    def x1:double (ax + (dx * t1))
                    def y1:double (ay + (dy * t1))

                    if on {
                        if (runOpen == false) {
                            def fresh:[double]
                            run = fresh
                            push run x0
                            push run y0
                            runOpen = true
                        }
                        push run x1
                        push run y1
                    }

                    travelled = (travelled + step)
                    remaining = (remaining - step)

                    if (remaining <= 0.0000001) {
                        ; The pattern entry ran out: emit the run if one was
                        ; open, and move to the next entry.
                        if on {
                            if runOpen {
                                this.addStroke(run width false)
                                runOpen = false
                            }
                        }
                        idx = (idx + 1)
                        if (idx >= dn) {
                            idx = 0
                        }
                        on = (on == false)
                        remaining = (itemAt dashes idx)
                        if (remaining < 0.0) {
                            remaining = 0.0
                        }
                        if (remaining == 0.0) {
                            ; Skip a zero entry outright rather than spinning
                            ; on it.
                            idx = (idx + 1)
                            if (idx >= dn) {
                                idx = 0
                            }
                            on = (on == false)
                            remaining = (itemAt dashes idx)
                            if (remaining <= 0.0) {
                                remaining = total
                            }
                        }
                    }
                }
            }
            k = (k + 1)
        }

        if runOpen {
            this.addStroke(run width false)
        }
    }

    ; A small regular polygon standing in for a circle. Eight sides is enough
    ; at stroke widths: the error is under 4% of the radius, well below one
    ; pixel for anything an icon uses.
    fn addDisc:void (cx:double cy:double radius:double) {
        if (radius <= 0.0) {
            return
        }
        def sides:int 8
        def pts:[double]
        def k:int 0
        while (k < sides) {
            def ang:double (((2.0 * (M_PI)) * (to_double k)) / (to_double sides))
            push pts (cx + (radius * (cos ang)))
            push pts (cy + (radius * (sin ang)))
            k = (k + 1)
        }
        this.addRing(pts)
    }

    ; Fill everything accumulated so far.
    ;
    ; Coverage comes from a 4x4 grid of sample points per pixel. Sixteen
    ; samples give 17 distinct alpha levels, which is enough that edges read as
    ; smooth at text sizes — the standard this inherited from glyph rendering,
    ; and the reason path fills now match glyph fills exactly.
    ;
    ; What each sample needs to know is how many edges lie to its left, and
    ; the obvious way to find out is to ask every edge — which is what this did
    ; at first, and it is quadratic in disguise: a row of isotype icons is one
    ; path 1,900 edges long spanning 1,400 pixels, and asking all of them at
    ; every one of 16 samples per pixel is 1.3 billion tests for a single row.
    ; A whole chart took ten seconds, on the page's own thread.
    ;
    ; The count is a running total, though, not an independent question per
    ; sample: sample points march left to right, so an edge crossing a scanline
    ; changes the tally for every sample to its right and no others. Recording
    ; that change once, at the first sample it reaches, and summing along the
    ; row gives the same numbers for one pass over the edges instead of one per
    ; sample.
    ;
    ; That still walked every edge on every scanline, which is the same problem
    ; a size smaller: a scatter plot's symbol layer is one path of a third of a
    ; million edges, and only a handful of them reach any given row. So the
    ; edges are bucketed by the row they start in — a counting sort, one pass —
    ; and a working set is carried down the image, taking in each row's new
    ; edges and dropping the ones that have ended. A scanline then looks at the
    ; edges that actually cross it and no others.
    ;
    ; Nothing about the coverage or the blending changes — the same pixels get
    ; the same alpha, which the raster tests check shape by shape — so this is
    ; the same picture, drawn several thousand times faster on the shapes that
    ; were slow.
    fn fillAA:void (buf:RasterBuffer r:int g:int b:int a:int rule:int) {
        def numEdges:int (array_length edges)
        if (numEdges == 0) {
            return
        }

        def minY:double 99999.0
        def maxY:double (0.0 - 99999.0)
        def minX:double 99999.0
        def maxX:double (0.0 - 99999.0)
        def i:int 0
        while (i < numEdges) {
            def e:VectorEdge (itemAt edges i)
            if (e.minY < minY) {
                minY = e.minY
            }
            if (e.maxY > maxY) {
                maxY = e.maxY
            }
            if (e.x1 < minX) {
                minX = e.x1
            }
            if (e.x2 < minX) {
                minX = e.x2
            }
            if (e.x1 > maxX) {
                maxX = e.x1
            }
            if (e.x2 > maxX) {
                maxX = e.x2
            }
            i = i + 1
        }

        ; Clamp to the buffer with a one pixel margin, so a shape that reaches
        ; the very edge still gets its partial coverage.
        def startY:int ((to_int minY) - 1)
        def endY:int ((to_int maxY) + 1)
        def startX:int ((to_int minX) - 1)
        def endX:int ((to_int maxX) + 1)
        if (startY < 0) {
            startY = 0
        }
        if (endY >= buf.height) {
            endY = buf.height - 1
        }
        if (startX < 0) {
            startX = 0
        }
        if (endX >= buf.width) {
            endX = buf.width - 1
        }

        ; The clip narrows the scanned range, so clipped-away pixels cost
        ; nothing rather than being sampled and thrown away.
        if hasClip {
            if (startX < clipX0) {
                startX = clipX0
            }
            if (endX > clipX1) {
                endX = clipX1
            }
            if (startY < clipY0) {
                startY = clipY0
            }
            if (endY > clipY1) {
                endY = clipY1
            }
        }

        def subStep:double 0.25
        def subOffset:double 0.125
        def samplesPerPixel:double 16.0

        def spanW:int ((endX - startX) + 1)
        if (spanW < 1) {
            return
        }
        ; Sample columns across the whole row, four to a pixel. Sample `s`
        ; stands at startX + 0.125 + 0.25s, so the mapping back to a pixel is
        ; simply s / 4.
        def sampleCount:int (spanW * 4)
        def startXd:double (to_double startX)

        ; The tallies, held as differences: what an edge crossing adds at the
        ; first sample it reaches. Summed left to right they give the winding
        ; number and the crossing count a sample would have counted for itself.
        def windDelta:[int]
        def crossDelta:[int]
        def s:int 0
        while (s < sampleCount) {
            push windDelta 0
            push crossDelta 0
            s = (s + 1)
        }
        ; Which columns a scanline actually touched, so the next one clears
        ; only those instead of walking the whole row.
        def touched:[int]

        ; Coverage for one pixel row, accumulated over its four scanlines.
        def cover:[int]
        def px:int 0
        while (px < spanW) {
            push cover 0
            px = (px + 1)
        }

        ; ---- edges bucketed by the row they start in ------------------------
        ; A counting sort: how many edges begin in each row, then where each
        ; row's run starts, then the edge indices themselves in one flat list.
        ; An edge that begins below the last row drawn is dropped here and is
        ; never looked at again.
        def rowCount:int ((endY - startY) + 1)
        def startYd:double (to_double startY)
        def rowStart:[int]
        def rr:int 0
        while (rr <= rowCount) {
            push rowStart 0
            rr = (rr + 1)
        }
        i = 0
        while (i < numEdges) {
            def eb:VectorEdge (itemAt edges i)
            def firstRow:int 0
            if (eb.minY > startYd) {
                firstRow = ((to_int eb.minY) - startY)
            }
            if (firstRow < rowCount) {
                set_at rowStart (firstRow + 1) ((itemAt rowStart (firstRow + 1)) + 1)
            }
            i = i + 1
        }
        rr = 1
        while (rr <= rowCount) {
            set_at rowStart rr ((itemAt rowStart rr) + (itemAt rowStart (rr - 1)))
            rr = (rr + 1)
        }
        def fill:[int]
        rr = 0
        while (rr <= rowCount) {
            push fill (itemAt rowStart rr)
            rr = (rr + 1)
        }
        def ordered:[int]
        def placed:int (itemAt rowStart rowCount)
        i = 0
        while (i < placed) {
            push ordered 0
            i = (i + 1)
        }
        i = 0
        while (i < numEdges) {
            def eo:VectorEdge (itemAt edges i)
            def startRow:int 0
            if (eo.minY > startYd) {
                startRow = ((to_int eo.minY) - startY)
            }
            if (startRow < rowCount) {
                set_at ordered (itemAt fill startRow) i
                set_at fill startRow ((itemAt fill startRow) + 1)
            }
            i = i + 1
        }

        ; The working set: the edges that reach the row being drawn. It is
        ; carried down the image rather than rebuilt, so each edge is taken in
        ; once and dropped once however tall the shape is.
        def active:[int]
        def activeCount:int 0

        def scanY:int startY
        while (scanY <= endY) {
            px = 0
            while (px < spanW) {
                set_at cover px 0
                px = (px + 1)
            }

            ; Edges that begin here join the working set …
            def rowIdx:int (scanY - startY)
            def q:int (itemAt rowStart rowIdx)
            def qEnd:int (itemAt rowStart (rowIdx + 1))
            while (q < qEnd) {
                if (activeCount < (array_length active)) {
                    set_at active activeCount (itemAt ordered q)
                } {
                    push active (itemAt ordered q)
                }
                activeCount = (activeCount + 1)
                q = (q + 1)
            }
            ; … and edges that ended above this row's first sample leave it.
            def rowTop:double ((to_double scanY) + 0.125)
            def keep:int 0
            def scan:int 0
            while (scan < activeCount) {
                def ei:int (itemAt active scan)
                def ea:VectorEdge (itemAt edges ei)
                if (ea.maxY > rowTop) {
                    set_at active keep ei
                    keep = (keep + 1)
                }
                scan = (scan + 1)
            }
            activeCount = keep

            def sy:int 0
            while (sy < 4) {
                ; The half-step offset keeps samples off exact vertex
                ; coordinates, where a crossing could otherwise be counted
                ; twice or not at all.
                def sampleY:double ((to_double scanY) + subOffset + ((to_double sy) * subStep))

                clear touched
                i = 0
                while (i < activeCount) {
                    def e:VectorEdge (itemAt edges (itemAt active i))
                    ; Half-open in Y so a vertex shared by two edges is
                    ; counted once.
                    if ((sampleY >= e.minY) && (sampleY < e.maxY)) {
                        def edgeX:double (e.getX(sampleY))
                        ; The first sample column strictly to the right of the
                        ; crossing. Everything from there on counts it, which
                        ; is exactly the `edgeX < sampleX` test written once.
                        def slot:int 0
                        def rel:double (((edgeX - startXd) - subOffset))
                        if (rel >= 0.0) {
                            slot = ((to_int (rel / subStep)) + 1)
                        }
                        if (slot < sampleCount) {
                            set_at windDelta slot ((itemAt windDelta slot) + e.dir)
                            set_at crossDelta slot ((itemAt crossDelta slot) + 1)
                            push touched slot
                        }
                    }
                    i = i + 1
                }

                def winding:int 0
                def crossings:int 0
                s = 0
                px = 0
                while (px < spanW) {
                    def cov:int (itemAt cover px)
                    def sx:int 0
                    while (sx < 4) {
                        winding = (winding + (itemAt windDelta s))
                        crossings = (crossings + (itemAt crossDelta s))
                        def inside:boolean false
                        if (rule == 1) {
                            ; even-odd
                            if (((idiv crossings 2) * 2) != crossings) {
                                inside = true
                            }
                        } {
                            ; non-zero
                            if (winding != 0) {
                                inside = true
                            }
                        }
                        if inside {
                            cov = (cov + 1)
                        }
                        s = (s + 1)
                        sx = (sx + 1)
                    }
                    set_at cover px cov
                    px = (px + 1)
                }

                for touched slot:int ti {
                    set_at windDelta slot 0
                    set_at crossDelta slot 0
                }
                sy = sy + 1
            }

            px = 0
            while (px < spanW) {
                def coverage:int (itemAt cover px)
                if (coverage > 0) {
                    def coverageAlpha:int (to_int (((to_double coverage) / samplesPerPixel) * (to_double a)))
                    compositor.blendSourceOver(buf (startX + px) scanY r g b coverageAlpha)
                }
                px = (px + 1)
            }
            scanY = scanY + 1
        }
    }
}

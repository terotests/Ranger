; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; EvalValue - Runtime value type for expression evaluation
; =============================================================================
; Represents values that can be evaluated: numbers, strings, booleans, 
; null, arrays, objects, functions, and EVG elements.

Import "../../../evg/EVGElement.rgr"
Import "../../../ts_parser/ts_parser_simple.rgr"

; Value types
; 0 = null
; 1 = number
; 2 = string
; 3 = boolean
; 4 = array
; 5 = object
; 6 = function
; 7 = evgElement (for JSX elements as props)
; 8 = undefined (distinct from null for typeof / optional globals)
; 9 = Map  (ordered; keys in arrayValue, values in mapVals, matched by index)
; 10 = Set (ordered unique elements in arrayValue)

class EvalValue {
    def valueType:int 0         ; Type tag
    def numberValue:double 0.0
    def stringValue:string ""
    def boolValue:boolean false
    def arrayValue:[EvalValue]
    def mapVals:[EvalValue]     ; parallel to arrayValue for valueType 9 (Map)
    def objectMap:[string:EvalValue]
    def functionName:string ""
    def functionBody:string ""  ; For parsed functions
    ; For a bound method reference (obj.method held as a value): the receiver the
    ; method is called on. null for plain functions/closures.
    def boundThis@(optional):EvalValue
    ; Captured defining scope for a function/arrow value (lexical closures). Held
    ; by integer id into ComponentEngine.closureScopes to avoid a type cycle
    ; (EvalContext lives in ComponentEngine, which imports this file). -1 = none.
    def closureId:int (0 - 1)
    def functionNode@(optional):TSNode  ; For function AST nodes
    def evgElement@(optional):EVGElement  ; For JSX elements passed as props
    
    ; Constructors
    ; null / undefined / true / false are immutable (never mutated in place — the
    ; mutating ops setMember/setIndexAt/push only act on objects/arrays), so they
    ; are returned as shared singletons instead of allocating a new value every
    ; time. This removes the single largest source of interpreter allocations.
    sfn null:EvalValue () {
        def pool:EvalConstPool (EvalConstPool.__singleton())
        return pool.nullValue
    }

    ; Allocating variants used to seed the shared constant pool.
    sfn rawNull:EvalValue () {
        def v:EvalValue (new EvalValue())
        v.valueType = 0
        return v
    }

    sfn rawUndefined:EvalValue () {
        def v:EvalValue (new EvalValue())
        v.valueType = 8
        return v
    }

    sfn rawBoolean:EvalValue (b:boolean) {
        def v:EvalValue (new EvalValue())
        v.valueType = 3
        v.boolValue = b
        return v
    }
    
    sfn number:EvalValue (n:double) {
        def v:EvalValue (new EvalValue())
        v.valueType = 1
        v.numberValue = n
        return v
    }
    
    sfn fromInt:EvalValue (n:int) {
        def v:EvalValue (new EvalValue())
        v.valueType = 1
        v.numberValue = (to_double n)
        return v
    }
    
    sfn string:EvalValue (s:string) {
        def v:EvalValue (new EvalValue())
        v.valueType = 2
        v.stringValue = s
        return v
    }
    
    sfn boolean:EvalValue (b:boolean) {
        def pool:EvalConstPool (EvalConstPool.__singleton())
        if b {
            return pool.trueValue
        }
        return pool.falseValue
    }
    
    sfn array:EvalValue (items:[EvalValue]) {
        def v:EvalValue (new EvalValue())
        v.valueType = 4
        v.arrayValue = items
        return v
    }
    
    ; Empty Map (valueType 9): keys in arrayValue, values in mapVals by index.
    sfn mapEmpty:EvalValue () {
        def v:EvalValue (new EvalValue())
        v.valueType = 9
        return v
    }

    ; Empty Set (valueType 10): unique elements in arrayValue (insertion order).
    sfn setEmpty:EvalValue () {
        def v:EvalValue (new EvalValue())
        v.valueType = 10
        return v
    }

    sfn object:EvalValue (keys:[string] values:[EvalValue]) {
        def v:EvalValue (new EvalValue())
        v.valueType = 5
        def i:int 0
        while (i < (array_length keys)) {
            if (i < (array_length values)) {
                set v.objectMap (itemAt keys i) (itemAt values i)
            }
            i = (i + 1)
        }
        return v
    }
    
    sfn function:EvalValue (fnNode:TSNode) {
        def v:EvalValue (new EvalValue())
        v.valueType = 6
        v.functionNode = fnNode
        v.functionName = fnNode.name
        return v
    }

    ; A method captured as a value (obj.method): the function node plus the
    ; receiver `this` it is bound to. Invoked like any function value.
    sfn boundMethod:EvalValue (fnNode:TSNode thisVal:EvalValue) {
        def v:EvalValue (new EvalValue())
        v.valueType = 6
        v.functionNode = fnNode
        v.functionName = fnNode.name
        v.boundThis = thisVal
        return v
    }
    
    sfn element:EvalValue (el:EVGElement) {
        def v:EvalValue (new EvalValue())
        v.valueType = 7
        v.evgElement = el
        return v
    }

    sfn undefined:EvalValue () {
        def pool:EvalConstPool (EvalConstPool.__singleton())
        return pool.undefinedValue
    }
    
    ; Type checks
    fn isNull:boolean () {
        return (valueType == 0)
    }
    
    fn isNumber:boolean () {
        return (valueType == 1)
    }
    
    fn isString:boolean () {
        return (valueType == 2)
    }
    
    fn isBoolean:boolean () {
        return (valueType == 3)
    }
    
    fn isArray:boolean () {
        return (valueType == 4)
    }
    
    fn isObject:boolean () {
        return (valueType == 5)
    }
    
    fn isFunction:boolean () {
        return (valueType == 6)
    }
    
    fn isElement:boolean () {
        return (valueType == 7)
    }

    fn isUndefined:boolean () {
        return (valueType == 8)
    }
    
    ; Type coercion
    fn toNumber:double () {
        if (valueType == 1) {
            return numberValue
        }
        if (valueType == 2) {
            ; Try to parse string as number
            def parsed@(optional):double (to_double stringValue)
            return (unwrap parsed)
        }
        if (valueType == 3) {
            if boolValue {
                return 1.0
            }
            return 0.0
        }
        return 0.0
    }
    
    fn toString:string () {
        if (valueType == 0) {
            return "null"
        }
        if (valueType == 8) {
            return "undefined"
        }
        if (valueType == 1) {
            ; Format number - remove trailing zeros
            def s:string (to_string numberValue)
            ; Check if it's a whole number
            def intVal:int (to_int numberValue)
            if ((to_double intVal) == numberValue) {
                return (to_string intVal)
            }
            return s
        }
        if (valueType == 2) {
            return stringValue
        }
        if (valueType == 3) {
            if boolValue {
                return "true"
            }
            return "false"
        }
        if (valueType == 4) {
            def result:string "["
            def i:int 0
            while (i < (array_length arrayValue)) {
                if (i > 0) {
                    result = result + ", "
                }
                def item:EvalValue (itemAt arrayValue i)
                def itemStr:string (item.toString())
                result = result + itemStr
                i = i + 1
            }
            return result + "]"
        }
        if (valueType == 5) {
            def result:string "{"
            def keyList:[string] (keys objectMap)
            def i:int 0
            for keyList kk:string idx {
                if (i > 0) {
                    result = result + ", "
                }
                def val:EvalValue (unwrap (get objectMap kk))
                def valStr:string (val.toString())
                result = result + kk + ": " + valStr
                i = i + 1
            }
            return result + "}"
        }
        if (valueType == 6) {
            return "[Function: " + functionName + "]"
        }
        if (valueType == 7) {
            if evgElement {
                def el:EVGElement (unwrap evgElement)
                return "[EVGElement: " + el.tagName + "]"
            }
            return "[EVGElement: null]"
        }
        return "undefined"
    }
    
    fn toBool:boolean () {
        if (valueType == 0) {
            return false
        }
        if (valueType == 8) {
            return false
        }
        if (valueType == 1) {
            return (numberValue != 0.0)
        }
        if (valueType == 2) {
            return ((strlen stringValue) > 0)
        }
        if (valueType == 3) {
            return boolValue
        }
        if (valueType == 4) {
            return true ; Arrays are always truthy
        }
        if (valueType == 5) {
            return true ; Objects are always truthy
        }
        if (valueType == 6) {
            return true ; Functions are always truthy
        }
        if (valueType == 7) {
            return true ; Elements are always truthy
        }
        return false
    }
    
    ; Object member access
    fn getMember:EvalValue (key:string) {
        if (valueType == 5) {
            if (has objectMap key) {
                return (unwrap (get objectMap key))
            }
        }
        ; Array length property
        if (valueType == 4) {
            if (key == "length") {
                return (EvalValue.fromInt((array_length arrayValue)))
            }
        }
        ; String length property
        if (valueType == 2) {
            if (key == "length") {
                return (EvalValue.fromInt((strlen stringValue)))
            }
        }
        return (EvalValue.null())
    }
    
    ; Set or replace an object property (mutates in place).
    fn setMember:void (key:string value:EvalValue) {
        if (valueType != 5) {
            return
        }
        set objectMap key value
    }

    ; Remove an object property (mutates in place), rebuilding the map without it.
    fn removeMember:void (key:string) {
        if (valueType != 5) {
            return
        }
        if (has objectMap key) {
            def rebuilt:[string:EvalValue]
            def ks:[string] (keys objectMap)
            for ks kk:string idx {
                if (kk != key) {
                    set rebuilt kk (unwrap (get objectMap kk))
                }
            }
            objectMap = rebuilt
        }
    }
    
    ; Set an array element by index (extends with null when needed).
    fn setIndexAt:void (index:int value:EvalValue) {
        if (valueType != 4) {
            return
        }
        while (index >= (array_length arrayValue)) {
            push arrayValue (EvalValue.null())
        }
        set arrayValue index value
    }

    ; Append to the backing array in place; returns the new length (Array#push).
    fn arrPush:int (value:EvalValue) {
        if (valueType != 4) {
            return 0
        }
        push arrayValue value
        return (array_length arrayValue)
    }

    ; Replace the backing array items in place (keeps the same EvalValue instance
    ; so existing references see the mutation — used by pop/shift/reverse/sort/…).
    fn arrSetItems:void (items:[EvalValue]) {
        valueType = 4
        arrayValue = items
    }

    ; ---- Map (valueType 9) helpers: keys in arrayValue, values in mapVals ----
    fn mapIndexOfKey:int (key:EvalValue) {
        def i:int 0
        while (i < (array_length arrayValue)) {
            if ((key.equals((itemAt arrayValue i)))) {
                return i
            }
            i = (i + 1)
        }
        return (0 - 1)
    }
    fn mapSet:void (key:EvalValue value:EvalValue) {
        def idx:int (this.mapIndexOfKey(key))
        if (idx >= 0) {
            set mapVals idx value
        } {
            push arrayValue key
            push mapVals value
        }
    }
    fn mapGet:EvalValue (key:EvalValue) {
        def idx:int (this.mapIndexOfKey(key))
        if (idx >= 0) {
            return (itemAt mapVals idx)
        }
        return (EvalValue.undefined())
    }
    fn mapHas:boolean (key:EvalValue) {
        return ((this.mapIndexOfKey(key)) >= 0)
    }
    fn mapDelete:boolean (key:EvalValue) {
        def idx:int (this.mapIndexOfKey(key))
        if (idx < 0) {
            return false
        }
        def nk:[EvalValue]
        def nv:[EvalValue]
        def i:int 0
        while (i < (array_length arrayValue)) {
            if (i != idx) {
                push nk (itemAt arrayValue i)
                push nv (itemAt mapVals i)
            }
            i = (i + 1)
        }
        arrayValue = nk
        mapVals = nv
        return true
    }

    ; ---- Set (valueType 10) helpers: unique elements in arrayValue ----
    fn setAdd:void (value:EvalValue) {
        def i:int 0
        while (i < (array_length arrayValue)) {
            if ((value.equals((itemAt arrayValue i)))) {
                return
            }
            i = (i + 1)
        }
        push arrayValue value
    }
    fn setHas:boolean (value:EvalValue) {
        def i:int 0
        while (i < (array_length arrayValue)) {
            if ((value.equals((itemAt arrayValue i)))) {
                return true
            }
            i = (i + 1)
        }
        return false
    }
    fn setDelete:boolean (value:EvalValue) {
        def idx:int (0 - 1)
        def i:int 0
        while (i < (array_length arrayValue)) {
            if ((value.equals((itemAt arrayValue i)))) {
                idx = i
            }
            i = (i + 1)
        }
        if (idx < 0) {
            return false
        }
        def nk:[EvalValue]
        def j:int 0
        while (j < (array_length arrayValue)) {
            if (j != idx) {
                push nk (itemAt arrayValue j)
            }
            j = (j + 1)
        }
        arrayValue = nk
        return true
    }
    fn collClear:void () {
        def empty:[EvalValue]
        arrayValue = empty
        def emptyV:[EvalValue]
        mapVals = emptyV
    }
    fn isMap:boolean () {
        return (valueType == 9)
    }
    fn isSet:boolean () {
        return (valueType == 10)
    }
    
    ; Array index access
    fn getIndex:EvalValue (index:int) {
        if (valueType == 4) {
            if ((index >= 0) && (index < (array_length arrayValue))) {
                return (itemAt arrayValue index)
            }
        }
        ; String character access
        if (valueType == 2) {
            if ((index >= 0) && (index < (strlen stringValue))) {
                def charStr:string (substring stringValue index (index + 1))
                return (EvalValue.string(charStr))
            }
        }
        return (EvalValue.null())
    }
    
    ; Equality check
    fn equals:boolean (other:EvalValue) {
        if (valueType != other.valueType) {
            return false
        }
        if (valueType == 0) {
            return true
        }
        if (valueType == 8) {
            return (other.valueType == 8)
        }
        if (valueType == 1) {
            return (numberValue == other.numberValue)
        }
        if (valueType == 2) {
            return (stringValue == other.stringValue)
        }
        if (valueType == 3) {
            return (boolValue == other.boolValue)
        }
        ; Arrays and objects - reference equality for now
        return false
    }
}

; Shared immutable constant values (null / undefined / true / false). These are
; never mutated in place, so a single instance of each is reused for the whole
; program instead of allocating on every EvalValue.null()/boolean()/undefined().
class EvalConstPool @singleton(true) {
    def nullValue:EvalValue (EvalValue.rawNull())
    def undefinedValue:EvalValue (EvalValue.rawUndefined())
    def trueValue:EvalValue (EvalValue.rawBoolean(true))
    def falseValue:EvalValue (EvalValue.rawBoolean(false))
}

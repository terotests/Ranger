Import "../../../evg/EVGCodepoint.rgr"
; FontManager.rgr - Manage loaded fonts and provide text measurement
;
; Usage:
;   def fm (new FontManager())
;   fm.setFontsDirectory("./Fonts")
;   fm.loadFont("Open_Sans/OpenSans-Regular.ttf")
;   def width:double (fm.measureText("Hello" "Open Sans" 14.0))

Import "TrueTypeFont.rgr"
Import "../../../evg/EVGTextMeasurer.rgr"
Import "../../../evg/EVGGrapheme.rgr"

class FontManager {
    def fonts:[TrueTypeFont]
    def fontNames:[string]
    def fontsDirectory:string "./Fonts"
    def fontsDirectories:[string]  ; Multiple search directories
    ; The directory a face was actually loaded from. Several candidates are
    ; tried, and anything that needs to point at the font FILES — the HTML
    ; renderer's @font-face rules, for one — has to know which one won rather
    ; than guess a path of its own.
    def resolvedDirectory:string ""
    def defaultFont:TrueTypeFont (new TrueTypeFont())
    def hasDefaultFont:boolean false
    
    Constructor () {
        def f:[TrueTypeFont]
        fonts = f
        def n:[string]
        fontNames = n
        def fd:[string]
        fontsDirectories = fd
    }
    
    fn setFontsDirectory:void (path:string) {
        fontsDirectory = path
    }
    
    ; Returns the number of fonts that have been successfully loaded
    fn getFontCount:int () {
        return (array_length fonts)
    }
    
    ; Add a directory to search for fonts
    fn addFontsDirectory:void (path:string) {
        push fontsDirectories path
    }
    
    ; Set multiple directories from semicolon-separated string
    ; Example: "./Fonts;./assets/fonts;/usr/share/fonts"
    fn setFontsDirectories:void (paths:string) {
        ; Split by semicolon
        def start:int 0
        def i:int 0
        def len:int (strlen paths)
        while (i <= len) {
            def ch:string ""
            if (i < len) {
                ch = (substring paths i (i + 1))
            }
            if ((ch == ";") || (i == len)) {
                if (i > start) {
                    def part:string (substring paths start i)
                    push fontsDirectories part
                    print ("FontManager: Added fonts directory: " + part)
                }
                start = i + 1
            }
            i = i + 1
        }
        ; Set first as primary
        if ((array_length fontsDirectories) > 0) {
            fontsDirectory = (itemAt fontsDirectories 0)
        }
    }
    
    ; Register a face from bytes the host supplies. Same bookkeeping as
    ; loadFont — the first face loaded becomes the default — so a manager
    ; filled this way behaves exactly like one that read a directory.
    fn addFontBuffer:boolean (name:string data:buffer) {
        def font (new TrueTypeFont())
        if ((font.loadFromBuffer(name data)) == false) {
            return false
        }
        push fonts font
        push fontNames font.fontFamily
        if (hasDefaultFont == false) {
            defaultFont = font
            hasDefaultFont = true
        }
        return true
    }

    fn loadFont:boolean (relativePath:string) {
        ; Try each directory in order
        def i:int 0
        while (i < (array_length fontsDirectories)) {
            def dir:string (itemAt fontsDirectories i)
            def fullPath:string (dir + "/" + relativePath)
            def font (new TrueTypeFont())
            if ((font.loadFromFile(fullPath)) == true) {
                push fonts font
                push fontNames font.fontFamily
                if ((strlen resolvedDirectory) == 0) {
                    resolvedDirectory = dir
                }
                if (hasDefaultFont == false) {
                    defaultFont = font
                    hasDefaultFont = true
                }
                print ("FontManager: Loaded font '" + font.fontFamily + "' (" + font.fontStyle + ") from " + fullPath)
                return true
            }
            i = i + 1
        }
        ; Fallback to single fontsDirectory for backward compatibility
        ; Check if fontsDirectory ends with "/" to avoid double slash
        def separator:string "/"
        def dirLen:int (strlen fontsDirectory)
        if (dirLen > 0) {
            def lastChar:string (substring fontsDirectory (dirLen - 1) dirLen)
            if (lastChar == "/") {
                separator = ""
            }
        }
        def fullPath:string (fontsDirectory + separator + relativePath)
        print ("FontManager: Trying to load font from: " + fullPath)
        def font (new TrueTypeFont())
        
        if ((font.loadFromFile(fullPath)) == false) {
            print ("FontManager: Failed to load font: " + relativePath + " (full path: " + fullPath + ")")
            return false
        }
        
        push fonts font
        push fontNames font.fontFamily
        
        ; First loaded font becomes default
        if (hasDefaultFont == false) {
            defaultFont = font
            hasDefaultFont = true
        }
        
        print ("FontManager: Loaded font '" + font.fontFamily + "' (" + font.fontStyle + ")")
        return true
    }
    
    ; A face from bytes rather than from a path. The browser build has no file
    ; system: it fetches the .ttf and hands the ArrayBuffer straight in, and
    ; everything past the read is the same code the file path runs.
    fn loadFontBuffer:boolean (name:string data:buffer) {
        def font (new TrueTypeFont())
        if ((font.loadFromBuffer(name data)) == false) {
            return false
        }
        push fonts font
        push fontNames font.fontFamily
        if (hasDefaultFont == false) {
            defaultFont = font
            hasDefaultFont = true
        }
        return true
    }

    fn loadFontFamily:void (familyDir:string) {
        ; Load common variants from a font family directory
        ; e.g., loadFontFamily("Open_Sans") loads Regular, Bold, Italic, BoldItalic
        this.loadFont(familyDir + "/" + familyDir + "-Regular.ttf")
        ; Try common naming patterns
        ; OpenSans-Regular.ttf, Roboto-Regular.ttf, etc.
    }
    
    fn getFont:TrueTypeFont (fontFamily:string) {
        ; Find font by family name
        ; Support formats: "Cinzel", "Cinzel/Cinzel-Bold", "Cinzel-Bold"
        
        ; First, check if fontFamily contains "/" - this indicates path format like "Cinzel/Cinzel-Bold"
        def slashIdx:int (indexOf fontFamily "/")
        def searchFamily:string fontFamily
        def searchStyle:string ""
        
        if (slashIdx >= 0) {
            ; Extract family and style from path format "Family/Family-Style"
            searchFamily = (substring fontFamily 0 slashIdx)
            def afterSlash:string (substring fontFamily (slashIdx + 1) (strlen fontFamily))
            ; Find the dash in "Cinzel-Bold" to get "Bold"
            def dashIdx:int (indexOf afterSlash "-")
            if (dashIdx >= 0) {
                searchStyle = (substring afterSlash (dashIdx + 1) (strlen afterSlash))
            }
        } {
            ; Check for dash format like "Cinzel-Bold"
            def dashIdx:int (indexOf fontFamily "-")
            if (dashIdx >= 0) {
                searchFamily = (substring fontFamily 0 dashIdx)
                searchStyle = (substring fontFamily (dashIdx + 1) (strlen fontFamily))
            }
        }
        
        ; Exact match on both family and style
        def i:int 0
        while (i < (array_length fonts)) {
            def f:TrueTypeFont (itemAt fonts i)
            if (f.fontFamily == searchFamily) {
                if ((strlen searchStyle) > 0) {
                    ; Check if style matches
                    if (f.fontStyle == searchStyle) {
                        return f
                    }
                } {
                    ; No style specified, return first match
                    return f
                }
            }
            i = i + 1
        }
        
        ; Try case-insensitive style match
        i = 0
        while (i < (array_length fonts)) {
            def f:TrueTypeFont (itemAt fonts i)
            if (f.fontFamily == searchFamily) {
                if ((strlen searchStyle) > 0) {
                    ; Check if style contains the search term (case-insensitive would be better but use contains)
                    if ((indexOf f.fontStyle searchStyle) >= 0) {
                        return f
                    }
                }
            }
            i = i + 1
        }
        
        ; Fallback: try original exact match
        i = 0
        while (i < (array_length fonts)) {
            def f:TrueTypeFont (itemAt fonts i)
            if (f.fontFamily == fontFamily) {
                return f
            }
            i = i + 1
        }
        
        ; Try partial match on original fontFamily
        i = 0
        while (i < (array_length fonts)) {
            def f:TrueTypeFont (itemAt fonts i)
            ; Check if fontFamily contains the search term
            if ((indexOf f.fontFamily fontFamily) >= 0) {
                return f
            }
            i = i + 1
        }
        
        ; Return default font (may be empty if no fonts loaded)
        return defaultFont
    }
    
    ; Is there a loaded face for this family? getFont() always returns
    ; something — it walks a chain of looser matches and finally hands back
    ; defaultFont — so callers cannot tell a real hit from a substitution.
    ; This reports the substitution, which is what print correctness needs.
    fn hasFont:boolean (fontFamily:string) {
        if ((array_length fonts) == 0) {
            return false
        }
        def font:TrueTypeFont (this.getFont(fontFamily))
        if (font.unitsPerEm == 0) {
            return false
        }
        ; An exact family match, with or without a style suffix.
        def slashIdx:int (indexOf fontFamily "/")
        def searchFamily:string fontFamily
        if (slashIdx >= 0) {
            searchFamily = (substring fontFamily 0 slashIdx)
        } {
            def dashIdx:int (indexOf fontFamily "-")
            if (dashIdx >= 0) {
                searchFamily = (substring fontFamily 0 dashIdx)
            }
        }
        return ((font.fontFamily == searchFamily) || (font.fontFamily == fontFamily))
    }

    ; The face that actually has a glyph for this codepoint.
    ;
    ; A text face carries no emoji and an emoji face carries no letters, so a
    ; run mixing them cannot be measured or drawn from one file. The primary
    ; family wins whenever it has the glyph; only what it lacks is looked for
    ; elsewhere, so this costs nothing on ordinary text.
    fn faceForCodepoint:TrueTypeFont (fontFamily:string cp:int) {
        def primary:TrueTypeFont (this.getFont(fontFamily))
        if (primary.isLoaded()) {
            if ((primary.getGlyphIndex(cp)) > 0) {
                return primary
            }
        }
        def i:int 0
        while (i < (array_length fonts)) {
            def f:TrueTypeFont (itemAt fonts i)
            if (f.isLoaded()) {
                if ((f.getGlyphIndex(cp)) > 0) {
                    return f
                }
            }
            i = (i + 1)
        }
        return primary
    }

    ; Any loaded face that has this codepoint, without a family to start from.
    ;
    ; The rasterizer holds one face at a time and knows the glyph is missing
    ; before it knows what to do about it, so it asks this rather than
    ; re-deriving the family name it was set up with. Returns a face with
    ; unitsPerEm == 0 when nothing loaded has the glyph, which the caller must
    ; check — drawing .notdef from the primary is better than drawing nothing.
    fn fallbackFace:TrueTypeFont (cp:int) {
        def i:int 0
        while (i < (array_length fonts)) {
            def f:TrueTypeFont (itemAt fonts i)
            if (f.isLoaded()) {
                if ((f.getGlyphIndex(cp)) > 0) {
                    return f
                }
            }
            i = (i + 1)
        }
        def none (new TrueTypeFont())
        return none
    }

    ; Can this face draw every codepoint of a cluster?
    ;
    ; Variation selectors and the joiner are skipped: they are instructions,
    ; not characters, the shaper drops them before any glyph is looked up, and
    ; a face that ligates the sequence perfectly well may still not list them.
    sfn coversCluster:boolean (f:TrueTypeFont cps:[int] start:int end:int) {
        def i:int start
        while (i < end) {
            def cp:int (itemAt cps i)
            def skip:boolean (EVGGrapheme.isZWJ(cp))
            if ((cp >= 65024) && (cp <= 65039)) {
                skip = true
            }
            if (skip == false) {
                if ((f.getGlyphIndex(cp)) == 0) {
                    return false
                }
            }
            i = (i + 1)
        }
        return true
    }

    ; The face that should draw a whole grapheme cluster.
    ;
    ; Choosing per CODEPOINT is what broke 1️⃣: the "1" is in the text face and
    ; the keycap is not, so the cluster was split across two faces and the
    ; ligature that turns the three of them into one glyph never had all three
    ; in front of it. A cluster of more than one codepoint therefore asks for a
    ; face that has ALL of them, primary first; only a cluster nobody covers
    ; falls back to matching on its base character alone.
    fn faceForClusterFrom:TrueTypeFont (primary:TrueTypeFont cps:[int] start:int end:int) {
        def base:int (itemAt cps start)
        if ((end - start) <= 1) {
            if (primary.isLoaded()) {
                if ((primary.getGlyphIndex(base)) > 0) {
                    return primary
                }
            }
            return (this.fallbackFace(base))
        }

        if (primary.isLoaded()) {
            if (FontManager.coversCluster(primary cps start end)) {
                return primary
            }
        }
        def i:int 0
        while (i < (array_length fonts)) {
            def f:TrueTypeFont (itemAt fonts i)
            if (f.isLoaded()) {
                if (FontManager.coversCluster(f cps start end)) {
                    return f
                }
            }
            i = (i + 1)
        }
        ; Nothing has the whole cluster. Fall back on the base character, so
        ; at least the thing the cluster is ABOUT gets drawn.
        if (primary.isLoaded()) {
            if ((primary.getGlyphIndex(base)) > 0) {
                return primary
            }
        }
        return (this.fallbackFace(base))
    }

    fn faceForCluster:TrueTypeFont (fontFamily:string cps:[int] start:int end:int) {
        return (this.faceForClusterFrom((this.getFont(fontFamily)) cps start end))
    }

    ; True when the codepoint is drawn from some face other than the primary.
    fn needsFallback:boolean (fontFamily:string cp:int) {
        def primary:TrueTypeFont (this.getFont(fontFamily))
        if ((primary.isLoaded()) == false) {
            return false
        }
        return ((primary.getGlyphIndex(cp)) == 0)
    }

    fn measureText:double (text:string fontFamily:string fontSize:double) {
        def font:TrueTypeFont (this.getFont(fontFamily))
        if ((font.isLoaded()) == false) {
            ; No real metrics at all — the caller is on the estimate path.
            return ((to_double (strlen text)) * fontSize * 0.5)
        }

        ; Measured per GRAPHEME CLUSTER so a run can cross faces and a
        ; sequence is charged the width of the one glyph it becomes.
        ;
        ; A cluster the primary face draws is measured exactly the way it
        ; always was — per codepoint, with kerning — because that is also how
        ; it is painted, and the two must not part company. Only a cluster
        ; handed to a fallback face goes through the shaper, which is the only
        ; path where a sequence collapses to a single glyph.
        def cps:[int] (EVGCodepoint.toArray(text))
        def n:int (array_length cps)
        def width:double 0.0
        def i:int 0
        def prev:int 0
        def prevWasPrimary:boolean false
        def first:boolean true
        while (i < n) {
            def end:int (EVGGrapheme.clusterEnd(cps i))
            def face:TrueTypeFont (this.faceForClusterFrom(font cps i end))
            def isPrimary:boolean (face.fontPath == font.fontPath)

            if isPrimary {
                def c:int i
                while (c < end) {
                    def cp:int (itemAt cps c)
                    width = (width + (face.getCharWidthPoints(cp fontSize)))
                    if (first == false) {
                        if prevWasPrimary {
                            width = (width + (face.kernPoints(prev cp fontSize)))
                        }
                    }
                    prev = cp
                    prevWasPrimary = true
                    first = false
                    c = (c + 1)
                }
            } {
                width = (width + (face.measureShapedRange(cps i end fontSize)))
                prev = (itemAt cps i)
                prevWasPrimary = false
                first = false
            }
            i = end
        }
        return width
    }
    
    fn getLineHeight:double (fontFamily:string fontSize:double) {
        def font:TrueTypeFont (this.getFont(fontFamily))
        if (font.unitsPerEm > 0) {
            return (font.getLineHeight(fontSize))
        }
        return (fontSize * 1.2)
    }
    
    fn getAscender:double (fontFamily:string fontSize:double) {
        def font:TrueTypeFont (this.getFont(fontFamily))
        if (font.unitsPerEm > 0) {
            return (font.getAscender(fontSize))
        }
        return (fontSize * 0.8)
    }
    
    fn getDescender:double (fontFamily:string fontSize:double) {
        def font:TrueTypeFont (this.getFont(fontFamily))
        if (font.unitsPerEm > 0) {
            return (font.getDescender(fontSize))
        }
        return (fontSize * -0.2)
    }
    
    fn getFontData:buffer (fontFamily:string) {
        def font:TrueTypeFont (this.getFont(fontFamily))
        return (font.getFontData())
    }
    
    fn getPostScriptName:string (fontFamily:string) {
        def font:TrueTypeFont (this.getFont(fontFamily))
        return (font.getPostScriptName())
    }
    
    fn printLoadedFonts:void () {
        print ("FontManager: " + (to_string (array_length fonts)) + " fonts loaded:")
        def i:int 0
        while (i < (array_length fonts)) {
            def f:TrueTypeFont (itemAt fonts i)
            print ("  - " + f.fontFamily + " (" + f.fontStyle + ")")
            i = i + 1
        }
    }
}

; Text measurer that uses FontManager for accurate measurements
class TTFTextMeasurer {
    Extends(EVGTextMeasurer)
    
    def fontManager:FontManager
    
    Constructor (fm:FontManager) {
        fontManager = fm
    }

    ; This measurer reads advance widths out of the same TTF the paint side
    ; embeds, so it may drive print layout.
    fn isFontAccurate:boolean () {
        return true
    }

    fn hasFace:boolean (fontFamily:string) {
        return (fontManager.hasFont(fontFamily))
    }
    
    fn measureText:EVGTextMetrics (text:string fontFamily:string fontSize:double) {
        def width:double (fontManager.measureText(text fontFamily fontSize))
        def lineHeight:double (fontManager.getLineHeight(fontFamily fontSize))
        def ascent:double (fontManager.getAscender(fontFamily fontSize))
        def descent:double (fontManager.getDescender(fontFamily fontSize))
        
        def metrics (new EVGTextMetrics())
        metrics.width = width
        metrics.height = lineHeight
        metrics.ascent = ascent
        metrics.descent = descent
        metrics.lineHeight = lineHeight
        return metrics
    }
    
    fn measureTextWidth:double (text:string fontFamily:string fontSize:double) {
        return (fontManager.measureText(text fontFamily fontSize))
    }
    
    fn getLineHeight:double (fontFamily:string fontSize:double) {
        return (fontManager.getLineHeight(fontFamily fontSize))
    }
    
    fn measureChar:double (ch:int fontFamily:string fontSize:double) {
        def font:TrueTypeFont (fontManager.getFont(fontFamily))
        if (font.unitsPerEm > 0) {
            return (font.getCharWidthPoints(ch fontSize))
        }
        ; Fallback
        return (fontSize * 0.5)
    }
}

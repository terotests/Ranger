; SPDX-License-Identifier: AGPL-3.0-or-later

Import "../../../evg/EVGCodepoint.rgr"
; TrueTypeFont.rgr - Parse TrueType font files for metrics and embedding
;
; TrueType file structure:
; - Offset Table (header)
; - Table Directory (list of tables)
; - Tables: head, hhea, hmtx, cmap, maxp, name, OS/2, post, glyf, loca, etc.
;
; For text measurement we need:
; - cmap: character to glyph mapping
; - hmtx: horizontal metrics (advance widths)
; - hhea: horizontal header (ascender, descender)
; - head: font header (units per em)

Import "../core/Buffer.rgr"
Import "../../../evg/EVGGrapheme.rgr"

class TTFTableRecord {
    def tag:string ""
    def checksum:int 0
    def offset:int 0
    def length:int 0
}

class TTFGlyphMetrics {
    def advanceWidth:int 0
    def leftSideBearing:int 0
}

; What a shaping pass produced: the glyphs to draw, and which codepoints of
; the input each one came from.
;
; The cluster range is not bookkeeping — it is the only way back to text. A
; ZWJ family is one glyph made from five codepoints, and the PDF's /ToUnicode
; entry for that glyph has to name all five or the emoji cannot be copied out
; of the page as what it was.
class TTFShapedRun {
    def glyphs:[int]
    ; Half-open [start, end) into the codepoint array that was shaped.
    def clusterStart:[int]
    def clusterEnd:[int]

    Constructor () {
    }

    fn count:int () {
        return (array_length glyphs)
    }
}

class TrueTypeFont {
    def fontData:buffer (buffer_alloc 0)
    def fontPath:string ""
    def fontFamily:string ""
    def fontStyle:string "Regular"
    
    ; Offset table
    def sfntVersion:int 0
    def numTables:int 0
    def searchRange:int 0
    def entrySelector:int 0
    def rangeShift:int 0
    
    ; Table directory
    def tables:[TTFTableRecord]
    
    ; head table
    def unitsPerEm:int 1000
    def xMin:int 0
    def yMin:int 0
    def xMax:int 0
    def yMax:int 0
    def indexToLocFormat:int 0
    
    ; hhea table
    def ascender:int 0
    def descender:int 0
    def lineGap:int 0
    def numberOfHMetrics:int 0
    
    ; maxp table
    def numGlyphs:int 0
    
    ; cmap table - character to glyph mapping
    def cmapFormat:int 0
    def cmapOffset:int 0
    
    ; hmtx table - glyph widths
    def glyphWidths:[int]
    def defaultWidth:int 500
    
    ; Character to width cache (ASCII 0-255)
    def charWidths:[int]
    def charWidthsLoaded:boolean false

    ; ---- Kerning -----------------------------------------------------------
    ; Absolute file offsets of the GPOS pair-adjustment subtables reachable
    ; from the `kern` feature. Walked per pair rather than expanded into a
    ; table: a class-based subtable is a few hundred bytes and expands to tens
    ; of thousands of pairs, almost none of which a given page uses.
    def kernSubtables:[int]
    ; Which lookup each subtable came from. Subtables WITHIN a lookup are tried
    ; in order and the first match wins; separate lookups each get to apply.
    ; Summing every subtable double-counted any pair listed in more than one,
    ; which made Noto Sans measure narrower than a browser shows it.
    def kernSubtableLookups:[int]
    ; Did the last pairAdvance find the pair at all? A matched pair may still
    ; carry a zero adjustment, so the return value cannot say.
    def pairMatched:boolean false
    ; Legacy `kern` table, format 0. Some older faces carry this instead of
    ; GPOS; a few carry both, in which case GPOS wins as OpenType requires.
    ; ---- Shaping -----------------------------------------------------------
    ; GSUB LookupType 4 (ligature substitution) subtables reachable from the
    ; features that compose characters: `ccmp`, plus `liga`/`rlig` for faces
    ; that file the same thing differently.
    ;
    ; This is what turns a sequence into a glyph. Without it 👨‍👩‍👧 is five
    ; codepoints and comes out as three people and two invisible joiners, and
    ; 👍🏽 is a thumb followed by a colour swatch.
    def ligatureSubtables:[int]
    def hasShaping:boolean false

    def legacyKernOffset:int 0
    def legacyKernPairs:int 0
    def hasKerning:boolean false
    
    Constructor () {
        def t:[TTFTableRecord]
        tables = t
        def gw:[int]
        glyphWidths = gw
        def cw:[int]
        charWidths = cw
        def ks:[int]
        kernSubtables = ks
        def ksl:[int]
        kernSubtableLookups = ksl
        def ls:[int]
        ligatureSubtables = ls
    }
    
    ; The same font, handed in as bytes rather than found on disk. A browser
    ; has no file system and every face it draws with arrived over the network,
    ; so the only thing the loader can be given there is the bytes themselves.
    ; Everything below the read is shared, which is the point: a font parsed
    ; this way is the same font, not a second implementation of one.
    fn loadFromBuffer:boolean (name:string data:buffer) {
        fontPath = name
        fontData = data
        if ((buffer_length fontData) == 0) {
            return false
        }
        if ((this.parseOffsetTable()) == false) {
            return false
        }
        if ((this.parseTableDirectory()) == false) {
            return false
        }
        this.parseHeadTable()
        this.parseHheaTable()
        this.parseMaxpTable()
        this.parseCmapTable()
        this.parseHmtxTable()
        this.parseNameTable()
        this.parseKerning()
        this.parseGsubLigatures()
        this.buildCharWidthCache()
        return true
    }

    fn loadFromFile:boolean (path:string) {
        fontPath = path
        ; Split path into directory and filename for buffer_read_file
        def lastSlash:int -1
        def i:int 0
        while (i < (strlen path)) {
            def ch:int (charAt path i)
            if ((ch == 47) || (ch == 92)) {
                lastSlash = i
            }
            i = i + 1
        }
        
        def dirPath:string "."
        def fileName:string path
        if (lastSlash >= 0) {
            dirPath = (substring path 0 lastSlash)
            fileName = (substring path (lastSlash + 1) (strlen path))
        }
        
        ; Check if file exists before trying to load
        if ((file_exists dirPath fileName) == false) {
            return false
        }
        
        fontData = (buffer_read_file dirPath fileName)
        if ((buffer_length fontData) == 0) {
            print ("TrueTypeFont: Failed to load " + path)
            return false
        }
        
        ; Parse the font
        if ((this.parseOffsetTable()) == false) {
            return false
        }
        if ((this.parseTableDirectory()) == false) {
            return false
        }
        
        ; Parse required tables
        this.parseHeadTable()
        this.parseHheaTable()
        this.parseMaxpTable()
        this.parseCmapTable()
        this.parseHmtxTable()
        this.parseNameTable()
        this.parseKerning()
        this.parseGsubLigatures()
        
        ; Build character width cache
        this.buildCharWidthCache()
        
        return true
    }
    
    fn parseOffsetTable:boolean () {
        if ((buffer_length fontData) < 12) {
            return false
        }
        
        sfntVersion = (this.readUInt32(0))
        numTables = (this.readUInt16(4))
        searchRange = (this.readUInt16(6))
        entrySelector = (this.readUInt16(8))
        rangeShift = (this.readUInt16(10))
        
        return true
    }
    
    fn parseTableDirectory:boolean () {
        def offset:int 12
        def i:int 0
        
        while (i < numTables) {
            def record (new TTFTableRecord())
            record.tag = (this.readTag(offset))
            record.checksum = (this.readUInt32(offset + 4))
            record.offset = (this.readUInt32(offset + 8))
            record.length = (this.readUInt32(offset + 12))
            push tables record
            offset = offset + 16
            i = i + 1
        }
        
        return true
    }
    
    fn findTable:TTFTableRecord (tag:string) {
        def i:int 0
        while (i < (array_length tables)) {
            def t:TTFTableRecord (itemAt tables i)
            if (t.tag == tag) {
                return t
            }
            i = i + 1
        }
        ; Return empty record if not found
        def empty (new TTFTableRecord())
        return empty
    }
    
    fn parseHeadTable:void () {
        def table:TTFTableRecord (this.findTable("head"))
        if (table.offset == 0) {
            return
        }
        
        def off:int table.offset
        ; Skip version, fontRevision, checksumAdjustment, magicNumber, flags
        unitsPerEm = (this.readUInt16(off + 18))
        ; Skip created, modified dates (16 bytes)
        xMin = (this.readInt16(off + 36))
        yMin = (this.readInt16(off + 38))
        xMax = (this.readInt16(off + 40))
        yMax = (this.readInt16(off + 42))
        ; Skip macStyle, lowestRecPPEM, fontDirectionHint
        indexToLocFormat = (this.readInt16(off + 50))
    }
    
    fn parseHheaTable:void () {
        def table:TTFTableRecord (this.findTable("hhea"))
        if (table.offset == 0) {
            return
        }
        
        def off:int table.offset
        ; Skip version (4 bytes)
        ascender = (this.readInt16(off + 4))
        descender = (this.readInt16(off + 6))
        lineGap = (this.readInt16(off + 8))
        ; Skip advanceWidthMax, minLeftSideBearing, minRightSideBearing, xMaxExtent
        ; Skip caretSlopeRise, caretSlopeRun, caretOffset, reserved (8 bytes)
        ; Skip metricDataFormat
        numberOfHMetrics = (this.readUInt16(off + 34))
    }
    
    fn parseMaxpTable:void () {
        def table:TTFTableRecord (this.findTable("maxp"))
        if (table.offset == 0) {
            return
        }
        
        def off:int table.offset
        ; Skip version (4 bytes)
        numGlyphs = (this.readUInt16(off + 4))
    }
    
    fn parseCmapTable:void () {
        def table:TTFTableRecord (this.findTable("cmap"))
        if (table.offset == 0) {
            return
        }
        
        def off:int table.offset
        ; Skip version (2 bytes)
        def numSubtables:int (this.readUInt16(off + 2))
        
        ; Look for Unicode BMP table (platformID=3, encodingID=1 for Windows Unicode BMP)
        ; or platformID=0 for Unicode
        def i:int 0
        def subtableOffset:int 0
        def wideFound:boolean false
        
        while (i < numSubtables) {
            def recordOff:int (off + 4 + (i * 8))
            def platformID:int (this.readUInt16(recordOff))
            def encodingID:int (this.readUInt16(recordOff + 2))
            def subOff:int (this.readUInt32(recordOff + 4))
            
            ; A format-4 subtable is BMP-only: it cannot map anything above
            ; U+FFFF, so a face selected through it can never reach an emoji
            ; however correct the rest of the pipeline is. Prefer the UCS-4
            ; subtables — Windows (3,10) or Unicode (0,4) — which carry format
            ; 12, and keep the BMP ones as the fallback for older faces.
            def fmt:int (this.readUInt16(off + subOff))
            def wideCandidate:boolean false
            if ((platformID == 3) && (encodingID == 10)) {
                wideCandidate = true
            }
            if ((platformID == 0) && (encodingID == 4)) {
                wideCandidate = true
            }
            if ((platformID == 0) && (encodingID == 6)) {
                wideCandidate = true
            }
            if (wideCandidate && (fmt == 12)) {
                subtableOffset = subOff
                wideFound = true
            }
            if (wideFound == false) {
                if ((platformID == 3) && (encodingID == 1)) {
                    subtableOffset = subOff
                }
                if ((platformID == 0) && (subtableOffset == 0)) {
                    subtableOffset = subOff
                }
            }
            
            i = i + 1
        }
        
        if (subtableOffset > 0) {
            cmapOffset = off + subtableOffset
            cmapFormat = (this.readUInt16(cmapOffset))
        }
    }
    
    fn parseHmtxTable:void () {
        def table:TTFTableRecord (this.findTable("hmtx"))
        if (table.offset == 0) {
            return
        }
        
        def off:int table.offset
        
        ; Read all advance widths
        def i:int 0
        while (i < numberOfHMetrics) {
            def advanceWidth:int (this.readUInt16(off + (i * 4)))
            push glyphWidths advanceWidth
            i = i + 1
        }
        
        ; Remaining glyphs use the last advance width
        if (numberOfHMetrics > 0) {
            defaultWidth = (itemAt glyphWidths (numberOfHMetrics - 1))
        }
    }
    
    fn parseNameTable:void () {
        def table:TTFTableRecord (this.findTable("name"))
        if (table.offset == 0) {
            return
        }
        
        def off:int table.offset
        ; Skip format (2 bytes)
        def count:int (this.readUInt16(off + 2))
        def stringOffset:int (this.readUInt16(off + 4))
        
        ; Look for font family name (nameID = 1) and subfamily (nameID = 2)
        def i:int 0
        while (i < count) {
            def recordOff:int (off + 6 + (i * 12))
            def platformID:int (this.readUInt16(recordOff))
            def encodingID:int (this.readUInt16(recordOff + 2))
            def languageID:int (this.readUInt16(recordOff + 4))
            def nameID:int (this.readUInt16(recordOff + 6))
            def length:int (this.readUInt16(recordOff + 8))
            def strOffset:int (this.readUInt16(recordOff + 10))
            
            ; Get font family (nameID = 1) - prefer Windows platform (3)
            if ((nameID == 1) && (platformID == 3)) {
                def strOff:int (off + stringOffset + strOffset)
                fontFamily = (this.readUnicodeString(strOff length))
            }
            if ((nameID == 1) && (platformID == 1) && ((strlen fontFamily) == 0)) {
                def strOff:int (off + stringOffset + strOffset)
                fontFamily = (this.readAsciiString(strOff length))
            }
            
            ; Get font style (nameID = 2)
            if ((nameID == 2) && (platformID == 3)) {
                def strOff:int (off + stringOffset + strOffset)
                fontStyle = (this.readUnicodeString(strOff length))
            }
            if ((nameID == 2) && (platformID == 1) && ((strlen fontStyle) == 0)) {
                def strOff:int (off + stringOffset + strOffset)
                fontStyle = (this.readAsciiString(strOff length))
            }
            
            i = i + 1
        }
    }
    
    ; Is this a real, parsed face?
    ;
    ; NOT `unitsPerEm > 0`: that field is born 1000 and only a face that
    ; parsed and read a broken `head` ever drops it to zero, so an untouched
    ; TrueTypeFont — the "nothing found" answer from a lookup — passes that
    ; test and is then used as if it were a font. It is what made a missing
    ; glyph come out as .notdef drawn from a fallback that was never loaded.
    fn isLoaded:boolean () {
        if (numGlyphs <= 0) {
            return false
        }
        return (cmapOffset > 0)
    }

    fn getGlyphIndex:int (charCode:int) {
        ; Get glyph index for a character code using cmap
        if (cmapOffset == 0) {
            return 0
        }
        
        ; Format 12: the only one that reaches past the BMP.
        if (cmapFormat == 12) {
            return (this.getGlyphIndexFormat12(charCode))
        }
        
        ; Format 4: Segment mapping to delta values (most common for Unicode BMP)
        if (cmapFormat == 4) {
            return (this.getGlyphIndexFormat4(charCode))
        }
        
        ; Format 0: Byte encoding table (simple, limited to 256 chars)
        if (cmapFormat == 0) {
            if ((charCode >= 0) && (charCode < 256)) {
                return (this.readUInt8(cmapOffset + 6 + charCode))
            }
        }
        
        ; Format 6: Trimmed table mapping
        if (cmapFormat == 6) {
            def firstCode:int (this.readUInt16(cmapOffset + 6))
            def entryCount:int (this.readUInt16(cmapOffset + 8))
            if ((charCode >= firstCode) && (charCode < (firstCode + entryCount))) {
                return (this.readUInt16(cmapOffset + 10 + ((charCode - firstCode) * 2)))
            }
        }
        
        return 0  ; .notdef glyph
    }
    
    ; Format 12: sorted groups of (startCharCode, endCharCode, startGlyphID),
    ; 12 bytes each. This is the only cmap kind that reaches past the BMP, so
    ; it is what an emoji lookup actually goes through.
    fn getGlyphIndexFormat12:int (charCode:int) {
        def off:int cmapOffset
        def nGroups:int (this.readUInt32(off + 12))
        def lo:int 0
        def hi:int (nGroups - 1)
        while (lo <= hi) {
            def mid:int (to_int ((lo + hi) / 2))
            def g:int (off + 16 + (mid * 12))
            def startChar:int (this.readUInt32(g))
            def endChar:int (this.readUInt32(g + 4))
            if (charCode < startChar) {
                hi = (mid - 1)
            } {
                if (charCode > endChar) {
                    lo = (mid + 1)
                } {
                    def startGlyph:int (this.readUInt32(g + 8))
                    return (startGlyph + (charCode - startChar))
                }
            }
        }
        return 0
    }

    fn getGlyphIndexFormat4:int (charCode:int) {
        ; Format 4 is segment-based mapping
        def off:int cmapOffset
        ; Skip format, length (4 bytes)
        def segCountX2:int (this.readUInt16(off + 6))
        def segCountD:double ((to_double segCountX2) / 2.0)
        def segCount:int (to_int segCountD)
        
        ; Arrays start after header (14 bytes)
        def endCodesOff:int (off + 14)
        def startCodesOff:int (endCodesOff + segCountX2 + 2)  ; +2 for reservedPad
        def idDeltaOff:int (startCodesOff + segCountX2)
        def idRangeOffsetOff:int (idDeltaOff + segCountX2)
        
        ; Binary search for segment (or linear for simplicity)
        def i:int 0
        while (i < segCount) {
            def endCode:int (this.readUInt16(endCodesOff + (i * 2)))
            def startCode:int (this.readUInt16(startCodesOff + (i * 2)))
            
            if ((charCode >= startCode) && (charCode <= endCode)) {
                def idDelta:int (this.readInt16(idDeltaOff + (i * 2)))
                def idRangeOffset:int (this.readUInt16(idRangeOffsetOff + (i * 2)))
                
                if (idRangeOffset == 0) {
                    ; Simple delta
                    return ((charCode + idDelta) % 65536)
                } {
                    ; Use glyph ID array
                    def glyphIdOff:int (idRangeOffsetOff + (i * 2) + idRangeOffset + ((charCode - startCode) * 2))
                    def glyphId:int (this.readUInt16(glyphIdOff))
                    if (glyphId != 0) {
                        return ((glyphId + idDelta) % 65536)
                    }
                }
            }
            i = i + 1
        }
        
        return 0
    }
    
    fn getGlyphWidth:int (glyphIndex:int) {
        if (glyphIndex < (array_length glyphWidths)) {
            return (itemAt glyphWidths glyphIndex)
        }
        return defaultWidth
    }
    
    fn buildCharWidthCache:void () {
        ; Pre-compute widths for ASCII characters (0-255)
        def i:int 0
        while (i < 256) {
            def glyphIdx:int (this.getGlyphIndex(i))
            def width:int (this.getGlyphWidth(glyphIdx))
            push charWidths width
            i = i + 1
        }
        charWidthsLoaded = true
    }
    
    fn getCharWidth:int (charCode:int) {
        ; Get width for a character in font units. The (charCode >= 0) guard is
        ; essential: charAt can yield a NEGATIVE value for bytes >= 0x80 (a signed
        ; char, e.g. UTF-8 lead byte 0xC3 -> -61), which passes "< 256" and would
        ; index the 256-entry cache out of range (std::out_of_range on the native
        ; build). Negative / >=256 codes fall through to the cmap glyph lookup.
        if (charWidthsLoaded && (charCode >= 0) && (charCode < 256)) {
            return (itemAt charWidths charCode)
        }
        def glyphIdx:int (this.getGlyphIndex(charCode))
        return (this.getGlyphWidth(glyphIdx))
    }
    
    fn getCharWidthPoints:double (charCode:int fontSize:double) {
        ; Get character width in points
        def fontUnits:int (this.getCharWidth(charCode))
        return ((to_double fontUnits) * fontSize / (to_double unitsPerEm))
    }
    
    fn measureText:double (text:string fontSize:double) {
        ; Measure text width in points, including the kerning the face asks
        ; for. Without it every run came out slightly wide — and the error is
        ; not a rounding artefact: it shifts the whole line for centred and
        ; right-aligned text, and display faces kern hardest.
        ; Stepped by CODEPOINT. Iterating UTF-16 units charged an emoji two
        ; .notdef advances instead of one glyph, so "a😀b" measured 47.53px
        ; where it should have measured about 25.
        def width:double 0.0
        def len:int (strlen text)
        def i:int 0
        def prev:int 0
        def first:boolean true
        
        while (i < len) {
            def ch:int (EVGCodepoint.codeAt(text i))
            def step:int (EVGCodepoint.unitsAt(text i))
            width = width + (this.getCharWidthPoints(ch fontSize))
            if (first == false) {
                width = (width + (this.kernPoints(prev ch fontSize)))
            }
            prev = ch
            first = false
            i = (i + step)
        }
        
        return width
    }
    
    fn getAscender:double (fontSize:double) {
        return ((to_double ascender) * fontSize / (to_double unitsPerEm))
    }
    
    fn getDescender:double (fontSize:double) {
        return ((to_double descender) * fontSize / (to_double unitsPerEm))
    }
    
    fn getLineHeight:double (fontSize:double) {
        def asc:double (this.getAscender(fontSize))
        def desc:double (this.getDescender(fontSize))
        def gap:double ((to_double lineGap) * fontSize / (to_double unitsPerEm))
        return (asc - desc + gap)
    }
    
    ; Get font data for PDF embedding (subset or full)
    fn getFontData:buffer () {
        return fontData
    }

    ; --- the font, with the tables a PDF cannot use taken out ---------------------
    ;
    ; A .ttf carries a great deal that only a layout engine wants. PDF 32000
    ; asks a `/FontFile2` for `glyf`, `head`, `hhea`, `hmtx`, `loca` and
    ; `maxp`, plus `cvt `, `fpgm` and `prep` when the glyphs are hinted, and
    ; `cmap` for a non-symbolic font. Everything else is the producer's
    ; business, and by the time a PDF is written the producer has already done
    ; its work: the kerning is baked into the text positions this writer emits,
    ; so `kern` describes adjustments nobody will apply again.
    ;
    ; It is worth being exact about the size of that, because it is not a
    ; rounding: in Open Sans Regular, `kern` is 112,182 bytes of a 217,360-byte
    ; file. More than half of every embedded copy was a table the reader would
    ; never open. With `post`, `DSIG`, `name`, `GSUB`, `GPOS`, `GDEF`, `OS/2`
    ; and `gasp` beside it, 60% of the file goes.
    ;
    ; The kept tables are copied BYTE FOR BYTE, so their checksums stay true
    ; and no glyph is touched. `head.checkSumAdjustment` covers the whole file
    ; and will no longer match, which is the one thing a subsetter cannot avoid
    ; without recomputing it; every reader treats it as advisory.
    sfn keepsInPdf:boolean (tag:string) {
        if (tag == "glyf") { return true }
        if (tag == "head") { return true }
        if (tag == "hhea") { return true }
        if (tag == "hmtx") { return true }
        if (tag == "loca") { return true }
        if (tag == "maxp") { return true }
        if (tag == "cvt ") { return true }
        if (tag == "fpgm") { return true }
        if (tag == "prep") { return true }
        if (tag == "cmap") { return true }
        ; PDF does not need these three, and they are kept anyway.
        ;
        ; A `/FontFile2` is read by the PDF reader's own parser, but an
        ; embedded font does not always stop there — a reader that hands the
        ; program to the system's font machinery, or a tool that extracts it,
        ; meets a STRICTER parser. Chromium runs every face through the
        ; OpenType Sanitiser, which refuses a font with no `name`, `OS/2` or
        ; `post`, and refusing is what it did to the first version of this:
        ; structurally perfect, every offset in range, every checksum intact,
        ; and rejected.
        ;
        ; They cost 11,346 bytes in Open Sans against the 112,182 that `kern`
        ; alone was costing, so this is not the trade it looks like. It also
        ; means the stripped font can be handed to a real font engine and
        ; checked, which is worth more than the bytes.
        if (tag == "name") { return true }
        if (tag == "OS/2") { return true }
        if (tag == "post") { return true }
        return false
    }

    ; --- the glyphs a PDF will ask for, and no others -----------------------------
    ;
    ; After the unused TABLES go, `glyf` is what is left: 77,748 bytes of the
    ; 98,516 that Open Sans Regular still weighed. Almost none of it is
    ; reachable. The font dictionary this writer emits declares
    ; `/FirstChar 32 /LastChar 255 /Encoding /WinAnsiEncoding`, so a reader can
    ; ask for 224 codepoints and not one more — 192 glyphs in this face, 18,766
    ; bytes. The other 746 glyphs are Cyrillic, Greek, and every accented form
    ; the document did not use.
    ;
    ; The technique is glyph BLANKING rather than renumbering: the kept glyphs
    ; stay at their own glyph ids and the rest become zero-length entries in
    ; `loca`. Nothing has to be remapped — `cmap` still points where it pointed,
    ; `hmtx` still lists a width per glyph id, and the `/Widths` array in the
    ; PDF is untouched. A subsetter that renumbers has to rewrite all three and
    ; get every one of them right; this one cannot put a glyph in the wrong
    ; place because it never moves one.
    ;
    ; Composite glyphs are the catch. A composite is drawn from other glyphs by
    ; id — "é" is "e" plus an acute — so keeping one and blanking its parts
    ; draws nothing. The keep set is closed over components before anything is
    ; written.
    fn keepSet:[boolean] () {
        def keep:[boolean]
        def i:int 0
        while (i < numGlyphs) {
            push keep false
            i = (i + 1)
        }
        ; Glyph 0 is `.notdef` and is what a reader draws for anything missing.
        if (numGlyphs > 0) {
            set_at keep 0 true
        }
        def c:int 32
        while (c < 256) {
            def cp:int (TrueTypeFont.winAnsiToUnicode(c))
            def g:int (this.getGlyphIndex(cp))
            if ((g > 0) && (g < numGlyphs)) {
                set_at keep g true
            }
            c = (c + 1)
        }
        ; Close over composites. A component can itself be composite, so this
        ; runs until nothing new is added rather than once.
        def again:boolean true
        while again {
            again = false
            def gi:int 0
            while (gi < numGlyphs) {
                if (itemAt keep gi) {
                    def added:boolean (this.addComponents(gi keep))
                    if added {
                        again = true
                    }
                }
                gi = (gi + 1)
            }
        }
        return keep
    }

    ; What a WinAnsi byte actually MEANS.
    ;
    ; The font dictionary this writer emits says `/Encoding /WinAnsiEncoding`,
    ; and WinAnsi is Latin-1 everywhere except 0x80..0x9F, where Latin-1 has
    ; control characters and Windows put the typography: the euro sign, the
    ; en and em dashes, the curly quotes, the ellipsis, the bullet, the
    ; trademark. Treating the byte as a codepoint asks the font's `cmap` for a
    ; control character, gets nothing, and drops exactly those glyphs.
    ;
    ; That is not hypothetical. The first version of this subset did treat the
    ; byte as a codepoint, and a glyph-by-glyph pixel comparison against the
    ; unmodified font came back identical for every character tested but one:
    ; the euro sign, which was simply not there. An em dash in a title would
    ; have printed as a blank.
    sfn winAnsiToUnicode:int (b:int) {
        if ((b < 128) || (b > 159)) {
            return b
        }
        def map:[int] (
            [] _:int (
                8364 129 8218 402 8222 8230 8224 8225
                710 8240 352 8249 338 141 381 143
                144 8216 8217 8220 8221 8226 8211 8212
                732 8482 353 8250 339 157 382 376
            )
        )
        return (itemAt map (b - 128))
    }

    ; Marks this glyph's components, and says whether any were new.
    fn addComponents:boolean (gid:int keep:[boolean]) {
        def glyf:TTFTableRecord (this.findTable("glyf"))
        def start:int (this.glyphStart(gid))
        def end:int (this.glyphEnd(gid))
        if ((end - start) < 10) {
            return false
        }
        def at:int (glyf.offset + start)
        def contours:int (this.readInt16(at))
        if (contours >= 0) {
            return false
        }
        def added:boolean false
        def p:int (at + 10)
        def more:boolean true
        while (more) {
            def flags:int (this.readUInt16(p))
            def comp:int (this.readUInt16(p + 2))
            if ((comp >= 0) && (comp < numGlyphs)) {
                if ((itemAt keep comp) == false) {
                    set_at keep comp true
                    added = true
                }
            }
            p = (p + 4)
            ; ARG_1_AND_2_ARE_WORDS
            if ((bit_and flags 1) != 0) {
                p = (p + 4)
            } {
                p = (p + 2)
            }
            ; WE_HAVE_A_SCALE / X_AND_Y_SCALE / TWO_BY_TWO
            if ((bit_and flags 8) != 0) {
                p = (p + 2)
            }
            if ((bit_and flags 64) != 0) {
                p = (p + 4)
            }
            if ((bit_and flags 128) != 0) {
                p = (p + 8)
            }
            ; MORE_COMPONENTS
            more = ((bit_and flags 32) != 0)
            if (p >= (glyf.offset + end)) {
                more = false
            }
        }
        return added
    }

    fn glyphStart:int (gid:int) {
        return (this.locaAt(gid))
    }

    fn glyphEnd:int (gid:int) {
        return (this.locaAt(gid + 1))
    }

    ; `loca` is offsets into `glyf`, held as 16-bit halves or 32-bit words
    ; depending on `head.indexToLocFormat`. The short form stores offset/2,
    ; which is why every glyph in such a font begins on an even byte.
    fn locaAt:int (i:int) {
        def loca:TTFTableRecord (this.findTable("loca"))
        if (indexToLocFormat == 0) {
            return ((this.readUInt16(loca.offset + (i * 2))) * 2)
        }
        return (this.readUInt32(loca.offset + (i * 4)))
    }

    ; The subset `glyf`, and the `loca` that indexes it. Kept glyphs keep their
    ; ids and their bytes; the rest become zero-length. Every glyph is padded
    ; to an even offset because the short `loca` form stores offset/2 and
    ; cannot express an odd one.
    fn buildGlyf:[int] () {
        def keep:[boolean] (this.keepSet())
        def total:int 0
        def g:int 0
        while (g < numGlyphs) {
            if (itemAt keep g) {
                def len:int ((this.glyphEnd(g)) - (this.glyphStart(g)))
                if (len > 0) {
                    total = (total + len)
                    while ((total % 2) != 0) {
                        total = (total + 1)
                    }
                }
            }
            g = (g + 1)
        }
        def out:[int]
        push out total
        def gi:int 0
        while (gi < numGlyphs) {
            def k:int 0
            if (itemAt keep gi) {
                k = 1
            }
            push out k
            gi = (gi + 1)
        }
        return out
    }

    fn pdfFontData:buffer () {
        def kept:[TTFTableRecord]
        def i:int 0
        while (i < (array_length tables)) {
            def t:TTFTableRecord (itemAt tables i)
            if (TrueTypeFont.keepsInPdf(t.tag)) {
                push kept t
            }
            i = (i + 1)
        }
        if ((array_length kept) == 0) {
            return fontData
        }
        ; A table directory is sorted by tag, and a reader is entitled to
        ; binary-search it. The records are already in tag order in a
        ; well-formed font, but a font is not always well formed.
        def n:int (array_length kept)
        def a:int 0
        while (a < n) {
            def b:int (a + 1)
            while (b < n) {
                def x:TTFTableRecord (itemAt kept a)
                def y:TTFTableRecord (itemAt kept b)
                if (TrueTypeFont.tagLess(y.tag x.tag)) {
                    set_at kept a y
                    set_at kept b x
                }
                b = (b + 1)
            }
            a = (a + 1)
        }

        ; The subset glyph table, and which glyphs it holds.
        def plan:[int] (this.buildGlyf())
        def newGlyfLen:int (itemAt plan 0)

        ; What each kept table will WEIGH in the output. Only `glyf` changes
        ; size — `loca` keeps one entry per glyph whether the glyph is there or
        ; not, which is exactly why blanking needs no renumbering.
        def lengths:[int]
        def li:int 0
        while (li < n) {
            def rl:TTFTableRecord (itemAt kept li)
            if (rl.tag == "glyf") {
                push lengths newGlyfLen
            } {
                push lengths rl.length
            }
            li = (li + 1)
        }

        def headerLen:int (12 + (16 * n))
        def offsets:[int]
        def at:int headerLen
        def k:int 0
        while (k < n) {
            push offsets at
            at = (at + (itemAt lengths k))
            while ((at % 4) != 0) {
                at = (at + 1)
            }
            k = (k + 1)
        }
        def total:int at

        def out:buffer (buffer_alloc total)
        ; sfnt version 1.0 for TrueType outlines.
        TrueTypeFont.put32(out 0 65536)
        TrueTypeFont.put16(out 4 n)
        ; searchRange / entrySelector / rangeShift: the binary-search hints.
        def pow2:int 1
        def log2:int 0
        while ((pow2 * 2) <= n) {
            pow2 = (pow2 * 2)
            log2 = (log2 + 1)
        }
        TrueTypeFont.put16(out 6 (pow2 * 16))
        TrueTypeFont.put16(out 8 log2)
        TrueTypeFont.put16(out 10 ((n * 16) - (pow2 * 16)))

        def d:int 0
        while (d < n) {
            def rec:TTFTableRecord (itemAt kept d)
            def dst:int (itemAt offsets d)
            def len:int (itemAt lengths d)
            if (rec.tag == "glyf") {
                this.writeGlyf(out dst plan)
            } {
                if (rec.tag == "loca") {
                    this.writeLoca(out dst plan)
                } {
                    def src:int rec.offset
                    def c:int 0
                    while (c < rec.length) {
                        buffer_set out (dst + c) (buffer_get fontData (src + c))
                        c = (c + 1)
                    }
                }
            }
            d = (d + 1)
        }

        ; The directory last, because `glyf` and `loca` are rebuilt and their
        ; checksums have to be computed over what was actually written. The
        ; others are copied byte for byte, so recomputing them costs a pass and
        ; removes a way to be subtly wrong.
        def e:int 0
        while (e < n) {
            def r2:TTFTableRecord (itemAt kept e)
            def base:int (12 + (16 * e))
            def ti:int 0
            while (ti < 4) {
                def ch:int 32
                if (ti < (strlen r2.tag)) {
                    ch = (charAt r2.tag ti)
                }
                buffer_set out (base + ti) ch
                ti = (ti + 1)
            }
            def off2:int (itemAt offsets e)
            def len2:int (itemAt lengths e)
            TrueTypeFont.put32(out (base + 4) (TrueTypeFont.tableSum(out off2 len2)))
            TrueTypeFont.put32(out (base + 8) off2)
            TrueTypeFont.put32(out (base + 12) len2)
            e = (e + 1)
        }
        return out
    }

    ; A table's checksum: the big-endian 32-bit words of it, added up with the
    ; overflow thrown away, over a length rounded up to four bytes.
    sfn tableSum:int (b:buffer at:int len:int) {
        def sum:int 0
        def i:int 0
        while (i < len) {
            def w:int 0
            def j:int 0
            while (j < 4) {
                def byte:int 0
                if ((i + j) < len) {
                    byte = (buffer_get b (at + i + j))
                }
                w = ((w * 256) + byte)
                j = (j + 1)
            }
            sum = (bit_and (sum + w) 4294967295)
            i = (i + 4)
        }
        return sum
    }

    ; `plan` is [totalGlyfBytes, keep0, keep1, …] — see `buildGlyf`.
    fn writeGlyf:void (out:buffer dst:int plan:[int]) {
        def w:int dst
        def g:int 0
        while (g < numGlyphs) {
            if ((itemAt plan (g + 1)) == 1) {
                def from:int (this.glyphStart(g))
                def to:int (this.glyphEnd(g))
                def len:int (to - from)
                if (len > 0) {
                    def glyf:TTFTableRecord (this.findTable("glyf"))
                    def c:int 0
                    while (c < len) {
                        buffer_set out (w + c) (buffer_get fontData (glyf.offset + from + c))
                        c = (c + 1)
                    }
                    w = (w + len)
                    while (((w - dst) % 2) != 0) {
                        buffer_set out w 0
                        w = (w + 1)
                    }
                }
            }
            g = (g + 1)
        }
    }

    fn writeLoca:void (out:buffer dst:int plan:[int]) {
        def at:int 0
        def g:int 0
        while (g < numGlyphs) {
            TrueTypeFont.putLoca(out dst g at indexToLocFormat)
            if ((itemAt plan (g + 1)) == 1) {
                def len:int ((this.glyphEnd(g)) - (this.glyphStart(g)))
                if (len > 0) {
                    at = (at + len)
                    while ((at % 2) != 0) {
                        at = (at + 1)
                    }
                }
            }
            g = (g + 1)
        }
        TrueTypeFont.putLoca(out dst numGlyphs at indexToLocFormat)
    }

    sfn putLoca:void (out:buffer dst:int i:int value:int format:int) {
        if (format == 0) {
            TrueTypeFont.put16(out (dst + (i * 2)) (to_int (value / 2)))
        } {
            TrueTypeFont.put32(out (dst + (i * 4)) value)
        }
    }

    sfn tagLess:boolean (a:string b:string) {
        def i:int 0
        while (i < 4) {
            def ca:int 32
            def cb:int 32
            if (i < (strlen a)) {
                ca = (charAt a i)
            }
            if (i < (strlen b)) {
                cb = (charAt b i)
            }
            if (ca != cb) {
                return (ca < cb)
            }
            i = (i + 1)
        }
        return false
    }

    sfn put16:void (b:buffer at:int v:int) {
        buffer_set b at (bit_and (bit_shr v 8) 255)
        buffer_set b (at + 1) (bit_and v 255)
    }

    sfn put32:void (b:buffer at:int v:int) {
        buffer_set b at (bit_and (bit_shr v 24) 255)
        buffer_set b (at + 1) (bit_and (bit_shr v 16) 255)
        buffer_set b (at + 2) (bit_and (bit_shr v 8) 255)
        buffer_set b (at + 3) (bit_and v 255)
    }
    
    ; Get PostScript name for PDF
    fn getPostScriptName:string () {
        ; Usually fontFamily with spaces removed
        def name:string fontFamily
        ; Simple space removal
        def result:string ""
        def i:int 0
        while (i < (strlen name)) {
            def ch:int (charAt name i)
            if (ch != 32) {
                result = result + (strfromcode ch)
            }
            i = i + 1
        }
        if ((strlen result) == 0) {
            return "CustomFont"
        }
        return result
    }
    
    ; ============ Binary reading helpers ============
    
    fn readUInt8:int (offset:int) {
        return (buffer_get fontData offset)
    }
    
    ; ==========================================================================
    ; Kerning
    ; ==========================================================================
    ; EVG summed raw hmtx advances and never kerned, so every run came out
    ; slightly wide — measurably so for display faces, and visibly so for
    ; centred or right-aligned text, where the error shifts the whole line.
    ;
    ; Modern faces put kerning in GPOS as a `kern` feature over pair-adjustment
    ; lookups; older ones use the legacy `kern` table. Both are read here.

    fn parseKerning:void () {
        def gpos:TTFTableRecord (this.findTable("GPOS"))
        if (gpos.offset > 0) {
            ; A face with GPOS is positioned by GPOS alone. If it declares no
            ; `kern` feature there, it does not kern — even when it also ships
            ; a legacy `kern` table, which several do for old software.
            ;
            ; Open Sans is exactly that font: GPOS with no kern feature, plus
            ; 18694 legacy pairs. Falling back to those made EVG kern a run the
            ; browser leaves alone, which the parity snapshot caught at once.
            this.parseGposKernFeature(gpos.offset)
            if ((array_length kernSubtables) > 0) {
                hasKerning = true
            }
            return
        }
        def kt:TTFTableRecord (this.findTable("kern"))
        if (kt.offset > 0) {
            this.parseLegacyKern(kt.offset)
        }
    }

    ; Collect every pair-adjustment subtable the `kern` feature points at.
    fn parseGposKernFeature:void (gposOff:int) {
        def featureListOff:int (gposOff + (this.readUInt16(gposOff + 6)))
        def lookupListOff:int (gposOff + (this.readUInt16(gposOff + 8)))

        def featureCount:int (this.readUInt16(featureListOff))
        def lookupCount:int (this.readUInt16(lookupListOff))

        def f:int 0
        while (f < featureCount) {
            def recOff:int (featureListOff + 2 + (f * 6))
            def tag:string (this.readTag(recOff))
            if (tag == "kern") {
                def featOff:int (featureListOff + (this.readUInt16(recOff + 4)))
                def idxCount:int (this.readUInt16(featOff + 2))
                def li:int 0
                while (li < idxCount) {
                    def lookupIndex:int (this.readUInt16(featOff + 4 + (li * 2)))
                    if (lookupIndex < lookupCount) {
                        def lookupOff:int (lookupListOff + (this.readUInt16(lookupListOff + 2 + (lookupIndex * 2))))
                        this.collectPairLookup(lookupOff lookupIndex)
                    }
                    li = (li + 1)
                }
            }
            f = (f + 1)
        }
    }

    ; LookupType 2 is pair adjustment. Type 9 is an Extension wrapper, which a
    ; large face uses to reach past the 64K offset limit — unwrap it or the
    ; kerning of exactly the fonts that need it most is invisible.
    fn collectPairLookup:void (lookupOff:int lookupIndex:int) {
        def lookupType:int (this.readUInt16(lookupOff))
        def subCount:int (this.readUInt16(lookupOff + 4))
        def i:int 0
        while (i < subCount) {
            def subOff:int (lookupOff + (this.readUInt16(lookupOff + 6 + (i * 2))))
            if (lookupType == 2) {
                push kernSubtables subOff
                push kernSubtableLookups lookupIndex
            }
            if (lookupType == 9) {
                def extType:int (this.readUInt16(subOff + 2))
                if (extType == 2) {
                    push kernSubtables (subOff + (this.readUInt32(subOff + 4)))
                    push kernSubtableLookups lookupIndex
                }
            }
            i = (i + 1)
        }
    }

    ; ---- Shaping ----------------------------------------------------------
    ;
    ; Collect the GSUB ligature subtables that turn a sequence of codepoints
    ; into one glyph. Only LookupType 4, and only from the composing features:
    ; that is what emoji sequences are filed under, and it keeps this from
    ; quietly applying discretionary Latin ligatures nobody asked for.
    fn parseGsubLigatures:void () {
        def table:TTFTableRecord (this.findTable("GSUB"))
        if (table.offset == 0) {
            return
        }
        def gsubOff:int table.offset
        def featureListOff:int (gsubOff + (this.readUInt16(gsubOff + 6)))
        def lookupListOff:int (gsubOff + (this.readUInt16(gsubOff + 8)))
        def featureCount:int (this.readUInt16(featureListOff))
        def lookupCount:int (this.readUInt16(lookupListOff))

        def f:int 0
        while (f < featureCount) {
            def recOff:int (featureListOff + 2 + (f * 6))
            def tag:string (this.readTag(recOff))
            def wanted:boolean false
            if (tag == "ccmp") {
                wanted = true
            }
            if (tag == "liga") {
                wanted = true
            }
            if (tag == "rlig") {
                wanted = true
            }
            if wanted {
                def featOff:int (featureListOff + (this.readUInt16(recOff + 4)))
                def idxCount:int (this.readUInt16(featOff + 2))
                def li:int 0
                while (li < idxCount) {
                    def lookupIndex:int (this.readUInt16(featOff + 4 + (li * 2)))
                    if (lookupIndex < lookupCount) {
                        def lookupOff:int (lookupListOff + (this.readUInt16(lookupListOff + 2 + (lookupIndex * 2))))
                        this.collectLigatureLookup(lookupOff)
                    }
                    li = (li + 1)
                }
            }
            f = (f + 1)
        }
        if ((array_length ligatureSubtables) > 0) {
            hasShaping = true
        }
    }

    ; LookupType 4 is ligature substitution. Type 7 is an Extension wrapper,
    ; used by any face large enough to run out of 16-bit offsets — which an
    ; emoji face certainly is, so unwrapping it is not an edge case here.
    fn collectLigatureLookup:void (lookupOff:int) {
        def lookupType:int (this.readUInt16(lookupOff))
        def subCount:int (this.readUInt16(lookupOff + 4))
        def i:int 0
        while (i < subCount) {
            def subOff:int (lookupOff + (this.readUInt16(lookupOff + 6 + (i * 2))))
            if (lookupType == 4) {
                push ligatureSubtables subOff
            }
            if (lookupType == 7) {
                def extType:int (this.readUInt16(subOff + 2))
                if (extType == 4) {
                    push ligatureSubtables (subOff + (this.readUInt32(subOff + 4)))
                }
            }
            i = (i + 1)
        }
    }

    ; Is this codepoint a variation selector — VS15 (text) or VS16 (emoji)?
    ;
    ; They carry no glyph and exist only to pick a presentation. Left in the
    ; stream they break every ligature they sit inside: the rainbow flag is
    ; U+1F3F3 U+FE0F U+200D U+1F308, and the ligature is filed WITHOUT the
    ; selector, so a shaper that keeps it matches nothing and draws a white
    ; flag next to a rainbow.
    sfn isVariationSelector:boolean (cp:int) {
        if (cp == 65038) {
            return true
        }
        return (cp == 65039)
    }

    ; The longest ligature starting at `start`, or 0 when there is none.
    ; `matchedLength` is left in `ligatureMatched` because Ranger has no
    ; multiple return; a caller reads it immediately after.
    def ligatureMatched:int 0

    fn ligatureAt:int (gids:[int] start:int) {
        ligatureMatched = 0
        def best:int 0
        def bestLen:int 0
        def first:int (itemAt gids start)
        def remaining:int ((array_length gids) - start)

        def s:int 0
        while (s < (array_length ligatureSubtables)) {
            def sub:int (itemAt ligatureSubtables s)
            def cov:int (sub + (this.readUInt16(sub + 2)))
            def ci:int (this.coverageIndex(cov first))
            if (ci >= 0) {
                def setCount:int (this.readUInt16(sub + 4))
                if (ci < setCount) {
                    def setOff:int (sub + (this.readUInt16(sub + 6 + (ci * 2))))
                    def ligCount:int (this.readUInt16(setOff))
                    def l:int 0
                    while (l < ligCount) {
                        def lig:int (setOff + (this.readUInt16(setOff + 2 + (l * 2))))
                        def ligGlyph:int (this.readUInt16(lig))
                        def compCount:int (this.readUInt16(lig + 2))
                        if (compCount <= remaining) {
                            def ok:boolean true
                            def c:int 1
                            while (c < compCount) {
                                if ((this.readUInt16(lig + 2 + (c * 2))) != (itemAt gids (start + c))) {
                                    ok = false
                                    c = compCount
                                } {
                                    c = (c + 1)
                                }
                            }
                            if ok {
                                if (compCount > bestLen) {
                                    best = ligGlyph
                                    bestLen = compCount
                                }
                            }
                        }
                        l = (l + 1)
                    }
                }
            }
            s = (s + 1)
        }
        ligatureMatched = bestLen
        return best
    }

    ; Codepoints in, glyphs out, with each glyph remembering which codepoints
    ; it came from.
    ;
    ; Two passes and no more: drop the variation selectors, then repeatedly
    ; take the longest ligature. That is not a general OpenType shaper — it
    ; runs no contextual lookups and does no reordering — but it is exactly
    ; what emoji sequences need, and it is applied only to a run already known
    ; to belong to one face, so it can never disturb ordinary text.
    fn shape:TTFShapedRun (cps:[int]) {
        def run (new TTFShapedRun())

        ; Filtered codepoints, and where each came from in the input.
        def kept:[int]
        def keptIndex:[int]
        def i:int 0
        while (i < (array_length cps)) {
            def cp:int (itemAt cps i)
            if ((TrueTypeFont.isVariationSelector(cp)) == false) {
                push kept cp
                push keptIndex i
            }
            i = (i + 1)
        }

        def gids:[int]
        def k:int 0
        while (k < (array_length kept)) {
            push gids (this.getGlyphIndex((itemAt kept k)))
            k = (k + 1)
        }

        def n:int (array_length gids)
        def p:int 0
        while (p < n) {
            def glyph:int (itemAt gids p)
            def consumed:int 1
            if hasShaping {
                def lig:int (this.ligatureAt(gids p))
                if (ligatureMatched > 1) {
                    glyph = lig
                    consumed = ligatureMatched
                }
            }
            push run.glyphs glyph
            ; The cluster runs to the start of the NEXT kept codepoint, so a
            ; variation selector swallowed by the filter still belongs to the
            ; cluster it was written inside.
            push run.clusterStart (itemAt keptIndex p)
            def endIdx:int (array_length cps)
            if ((p + consumed) < n) {
                endIdx = (itemAt keptIndex (p + consumed))
            }
            push run.clusterEnd endIdx
            p = (p + consumed)
        }
        return run
    }

    ; Same, straight from a string.
    fn shapeString:TTFShapedRun (text:string) {
        return (this.shape((EVGCodepoint.toArray(text))))
    }

    ; Shape one slice of a codepoint array — a single grapheme cluster, in
    ; practice, so a ligature can never reach across the boundary the cluster
    ; rules drew.
    fn shapeRange:TTFShapedRun (cps:[int] start:int end:int) {
        def slice:[int]
        def i:int start
        while (i < end) {
            push slice (itemAt cps i)
            i = (i + 1)
        }
        return (this.shape(slice))
    }

    ; The width of a whole string as this face will SHAPE it, cluster by
    ; cluster — the same walk the encoder does, so what a segment measures and
    ; what it draws cannot part company.
    ;
    ; Measuring an emoji segment through the ordinary per-codepoint path
    ; charged a joined family five advances and drew one, which pushed
    ; everything after it on the line to the right.
    fn measureShapedText:double (text:string fontSize:double) {
        def cps:[int] (EVGCodepoint.toArray(text))
        def n:int (array_length cps)
        def total:double 0.0
        def i:int 0
        while (i < n) {
            def end:int (EVGGrapheme.clusterEnd(cps i))
            total = (total + (this.measureShapedRange(cps i end fontSize)))
            i = end
        }
        return total
    }

    fn measureShapedRange:double (cps:[int] start:int end:int fontSize:double) {
        def run:TTFShapedRun (this.shapeRange(cps start end))
        def scale:double (fontSize / (to_double unitsPerEm))
        def total:double 0.0
        def i:int 0
        while (i < (array_length run.glyphs)) {
            total = (total + ((to_double (this.getGlyphWidth((itemAt run.glyphs i)))) * scale))
            i = (i + 1)
        }
        return total
    }

    ; The advance of a shaped run, in points. One glyph per cluster means a
    ; five-codepoint family is charged one width, not five.
    fn measureShaped:double (text:string fontSize:double) {
        def run:TTFShapedRun (this.shapeString(text))
        def scale:double (fontSize / (to_double unitsPerEm))
        def total:double 0.0
        def i:int 0
        while (i < (array_length run.glyphs)) {
            total = (total + ((to_double (this.getGlyphWidth((itemAt run.glyphs i)))) * scale))
            i = (i + 1)
        }
        return total
    }

    fn parseLegacyKern:void (kernOff:int) {
        def nTables:int (this.readUInt16(kernOff + 2))
        if (nTables < 1) {
            return
        }
        ; Only the first horizontal format-0 subtable is used, which is what
        ; every face that still ships this table actually has.
        def sub:int (kernOff + 4)
        def coverage:int (this.readUInt16(sub + 4))
        def format:int (to_int (coverage / 256))
        def horizontal:boolean ((coverage % 2) == 1)
        if ((format == 0) && horizontal) {
            legacyKernPairs = (this.readUInt16(sub + 6))
            legacyKernOffset = (sub + 14)
            if (legacyKernPairs > 0) {
                hasKerning = true
            }
        }
    }

    ; Kerning between two glyphs, in font units. 0 when the pair does not kern.
    fn kernAdvance:int (leftGlyph:int rightGlyph:int) {
        if (hasKerning == false) {
            return 0
        }
        if (legacyKernOffset > 0) {
            return (this.legacyKernAdvance(leftGlyph rightGlyph))
        }
        def total:int 0
        ; -1 is "no lookup satisfied yet"; a real lookup index is >= 0.
        def satisfied:int (0 - 1)
        def i:int 0
        while (i < (array_length kernSubtables)) {
            def lk:int (itemAt kernSubtableLookups i)
            if (lk != satisfied) {
                def adj:int (this.pairAdvance((itemAt kernSubtables i) leftGlyph rightGlyph))
                if pairMatched {
                    total = (total + adj)
                    satisfied = lk
                }
            }
            i = (i + 1)
        }
        return total
    }

    fn pairAdvance:int (st:int leftGlyph:int rightGlyph:int) {
        pairMatched = false
        def posFormat:int (this.readUInt16(st))
        def coverageOff:int (st + (this.readUInt16(st + 2)))
        def valueFormat1:int (this.readUInt16(st + 4))
        def valueFormat2:int (this.readUInt16(st + 6))

        ; Coverage gates which glyphs may start a pair, in both formats.
        def covIndex:int (this.coverageIndex(coverageOff leftGlyph))
        if (covIndex < 0) {
            return 0
        }

        def v1Size:int (this.valueRecordSize(valueFormat1))
        def v2Size:int (this.valueRecordSize(valueFormat2))

        if (posFormat == 1) {
            def pairSetOff:int (st + (this.readUInt16(st + 10 + (covIndex * 2))))
            def pairCount:int (this.readUInt16(pairSetOff))
            def recSize:int ((2 + v1Size) + v2Size)
            ; PairValueRecords are sorted by glyph id.
            def lo:int 0
            def hi:int (pairCount - 1)
            while (lo <= hi) {
                def mid:int (to_int ((lo + hi) / 2))
                def recOff:int ((pairSetOff + 2) + (mid * recSize))
                def second:int (this.readUInt16(recOff))
                if (second == rightGlyph) {
                    pairMatched = true
                    return (this.valueXAdvance((recOff + 2) valueFormat1))
                }
                if (second < rightGlyph) {
                    lo = (mid + 1)
                } {
                    hi = (mid - 1)
                }
            }
            return 0
        }

        if (posFormat == 2) {
            def classDef1:int (st + (this.readUInt16(st + 8)))
            def classDef2:int (st + (this.readUInt16(st + 10)))
            def class2Count:int (this.readUInt16(st + 14))
            def c1:int (this.glyphClass(classDef1 leftGlyph))
            def c2:int (this.glyphClass(classDef2 rightGlyph))
            def recSize:int (v1Size + v2Size)
            def recOff:int ((st + 16) + (((c1 * class2Count) + c2) * recSize))
            ; A class-based subtable covers every pair whose left glyph is in
            ; its coverage — class 0 is the catch-all — so reaching here is a
            ; match even when the adjustment is zero.
            pairMatched = true
            return (this.valueXAdvance(recOff valueFormat1))
        }

        return 0
    }

    ; A ValueRecord holds one int16 per set bit of its format.
    fn valueRecordSize:int (format:int) {
        def size:int 0
        def bit:int 0
        while (bit < 8) {
            def mask:int (this.powTwo(bit))
            if ((this.hasBit(format mask)) ) {
                size = (size + 2)
            }
            bit = (bit + 1)
        }
        return size
    }

    ; X_ADVANCE is 0x0004, the third field. Its offset is two bytes for each of
    ; X_PLACEMENT and Y_PLACEMENT that happens to be present.
    fn valueXAdvance:int (recOff:int format:int) {
        if ((this.hasBit(format 4)) == false) {
            return 0
        }
        def off:int recOff
        if (this.hasBit(format 1)) {
            off = (off + 2)
        }
        if (this.hasBit(format 2)) {
            off = (off + 2)
        }
        return (this.readInt16(off))
    }

    fn powTwo:int (n:int) {
        def v:int 1
        def i:int 0
        while (i < n) {
            v = (v * 2)
            i = (i + 1)
        }
        return v
    }

    fn hasBit:boolean (value:int mask:int) {
        return (((to_int (value / mask)) % 2) == 1)
    }

    ; Position of a glyph within a Coverage table, or -1 if absent.
    fn coverageIndex:int (cov:int glyph:int) {
        def format:int (this.readUInt16(cov))
        if (format == 1) {
            def count:int (this.readUInt16(cov + 2))
            def lo:int 0
            def hi:int (count - 1)
            while (lo <= hi) {
                def mid:int (to_int ((lo + hi) / 2))
                def g:int (this.readUInt16(cov + 4 + (mid * 2)))
                if (g == glyph) {
                    return mid
                }
                if (g < glyph) {
                    lo = (mid + 1)
                } {
                    hi = (mid - 1)
                }
            }
            return (0 - 1)
        }
        if (format == 2) {
            def rangeCount:int (this.readUInt16(cov + 2))
            def lo2:int 0
            def hi2:int (rangeCount - 1)
            while (lo2 <= hi2) {
                def mid2:int (to_int ((lo2 + hi2) / 2))
                def rec:int (cov + 4 + (mid2 * 6))
                def start:int (this.readUInt16(rec))
                def end:int (this.readUInt16(rec + 2))
                if (glyph < start) {
                    hi2 = (mid2 - 1)
                } {
                    if (glyph > end) {
                        lo2 = (mid2 + 1)
                    } {
                        return ((this.readUInt16(rec + 4)) + (glyph - start))
                    }
                }
            }
            return (0 - 1)
        }
        return (0 - 1)
    }

    ; Class of a glyph in a ClassDef table. Anything not listed is class 0.
    fn glyphClass:int (cd:int glyph:int) {
        def format:int (this.readUInt16(cd))
        if (format == 1) {
            def startGlyph:int (this.readUInt16(cd + 2))
            def count:int (this.readUInt16(cd + 4))
            if (glyph < startGlyph) {
                return 0
            }
            if (glyph >= (startGlyph + count)) {
                return 0
            }
            return (this.readUInt16(cd + 6 + ((glyph - startGlyph) * 2)))
        }
        if (format == 2) {
            def rangeCount:int (this.readUInt16(cd + 2))
            def lo:int 0
            def hi:int (rangeCount - 1)
            while (lo <= hi) {
                def mid:int (to_int ((lo + hi) / 2))
                def rec:int (cd + 4 + (mid * 6))
                def start:int (this.readUInt16(rec))
                def end:int (this.readUInt16(rec + 2))
                if (glyph < start) {
                    hi = (mid - 1)
                } {
                    if (glyph > end) {
                        lo = (mid + 1)
                    } {
                        return (this.readUInt16(rec + 4))
                    }
                }
            }
            return 0
        }
        return 0
    }

    fn legacyKernAdvance:int (leftGlyph:int rightGlyph:int) {
        def lo:int 0
        def hi:int (legacyKernPairs - 1)
        while (lo <= hi) {
            def mid:int (to_int ((lo + hi) / 2))
            def rec:int (legacyKernOffset + (mid * 6))
            def l:int (this.readUInt16(rec))
            def r:int (this.readUInt16(rec + 2))
            if (l == leftGlyph) {
                if (r == rightGlyph) {
                    return (this.readInt16(rec + 4))
                }
            }
            ; Pairs are sorted by the combined (left, right) key.
            def key:int ((l * 65536) + r)
            def want:int ((leftGlyph * 65536) + rightGlyph)
            if (key < want) {
                lo = (mid + 1)
            } {
                hi = (mid - 1)
            }
        }
        return 0
    }

    ; Kerning between two characters, in font units.
    fn kernUnits:int (leftChar:int rightChar:int) {
        if (hasKerning == false) {
            return 0
        }
        def lg:int (this.getGlyphIndex(leftChar))
        def rg:int (this.getGlyphIndex(rightChar))
        if ((lg == 0) || (rg == 0)) {
            return 0
        }
        return (this.kernAdvance(lg rg))
    }

    ; Kerning between two characters, in points.
    fn kernPoints:double (leftChar:int rightChar:int fontSize:double) {
        if (hasKerning == false) {
            return 0.0
        }
        def lg:int (this.getGlyphIndex(leftChar))
        def rg:int (this.getGlyphIndex(rightChar))
        if ((lg == 0) || (rg == 0)) {
            return 0.0
        }
        def units:int (this.kernAdvance(lg rg))
        if (units == 0) {
            return 0.0
        }
        return (((to_double units) * fontSize) / (to_double unitsPerEm))
    }

    fn readUInt16:int (offset:int) {
        ; Big-endian
        def b1:int (buffer_get fontData offset)
        def b2:int (buffer_get fontData (offset + 1))
        return ((b1 * 256) + b2)
    }
    
    fn readInt16:int (offset:int) {
        def val:int (this.readUInt16(offset))
        if (val >= 32768) {
            return (val - 65536)
        }
        return val
    }
    
    fn readUInt32:int (offset:int) {
        ; Big-endian
        def b1:int (buffer_get fontData offset)
        def b2:int (buffer_get fontData (offset + 1))
        def b3:int (buffer_get fontData (offset + 2))
        def b4:int (buffer_get fontData (offset + 3))
        def result:int (((((b1 * 256) + b2) * 256) + b3) * 256 + b4)
        return result
    }
    
    fn readTag:string (offset:int) {
        def result:string ""
        def i:int 0
        while (i < 4) {
            def ch:int (buffer_get fontData (offset + i))
            result = result + (strfromcode ch)
            i = i + 1
        }
        return result
    }
    
    fn readAsciiString:string (offset:int length:int) {
        def result:string ""
        def i:int 0
        while (i < length) {
            def ch:int (buffer_get fontData (offset + i))
            if (ch > 0) {
                result = result + (strfromcode ch)
            }
            i = i + 1
        }
        return result
    }
    
    fn readUnicodeString:string (offset:int length:int) {
        ; UTF-16BE string
        def result:string ""
        def i:int 0
        while (i < length) {
            def ch:int (this.readUInt16(offset + i))
            if ((ch > 0) && (ch < 128)) {
                result = result + (strfromcode ch)
            }
            i = i + 2
        }
        return result
    }
    
    ; Debug: print font info
    fn printInfo:void () {
        print ("Font: " + fontFamily + " " + fontStyle)
        print ("  Units per EM: " + (to_string unitsPerEm))
        print ("  Ascender: " + (to_string ascender))
        print ("  Descender: " + (to_string descender))
        print ("  Line gap: " + (to_string lineGap))
        print ("  Num glyphs: " + (to_string numGlyphs))
        print ("  Num hMetrics: " + (to_string numberOfHMetrics))
        print ("  Tables: " + (to_string (array_length tables)))
    }
}

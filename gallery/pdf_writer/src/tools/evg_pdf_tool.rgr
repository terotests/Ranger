; evg_pdf_tool.rgr - CLI tool for TSX to PDF conversion
;
; Usage: evg_pdf_tool.exe input.tsx output.pdf
;
; Compile: npm run evgpdf:compile
; Run: npm run evgpdf:run

Import "../jsx/JSXToEVG.rgr"
Import "../core/EVGPDFRenderer.rgr"
Import "../core/EVGStyleLoader.rgr"
Import "../fonts/FontManager.rgr"
Import "../fonts/EVGFontSetup.rgr"
Import "../../../evg/EVGTextEngine.rgr"
Import "../core/Buffer.rgr"
Import "../../../evg/EVGElement.rgr"

class EVGPDFTool {
    def inputFile:string ""
    def outputFile:string ""
    def pageWidth:double 595.0
    def pageHeight:double 842.0
    def fontsDir:string "./gallery/pdf_writer/Fonts"
    def debug:boolean false
    def styles:EVGStyleLoader
    def fontManager:FontManager (new FontManager()) (new FontManager())
    def fontSetup:EVGFontSetup (new EVGFontSetup())
    def fontsOverride:string ""
    def strictFonts:boolean false
    def bleed:double 0.0
    ; Print finishing. Off by default: an ordinary PDF stays exactly the file
    ; it was, and a claim to be a print file is something you ask for.
    def colorMode:string "rgb"
    def pdfxProfile:string ""
    def intentId:string "FOGRA39"
    def intentInfo:string "Coated FOGRA39 (ISO 12647-2:2004)"
    def docTitle:string ""
    def docAuthor:string ""
    ; Refuse to write a file that claims a conformance it does not have.
    def strictPrint:boolean false
    
    Constructor () {
        def sl (new EVGStyleLoader())
        styles = sl
    }

    sfn m@(main):void () {
        def tool (new EVGPDFTool())
        tool.run()
    }
    
    fn run:void () {
        def argCount:int (shell_arg_cnt)
        
        if (argCount < 2) {
            this.printUsage()
            return
        }
        
        ; Parse arguments
        inputFile = (shell_arg 0)
        outputFile = (shell_arg 1)
        
        ; Parse optional arguments
        def i 2
        while (i < argCount) {
            def arg:string (shell_arg i)
            
            if (arg == "-w") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    def wArg:string (shell_arg i)
                    def wVal@(optional):double (to_double wArg)
                    if wVal {
                        pageWidth = (unwrap wVal)
                    }
                }
            }
            
            if (arg == "-h") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    def hArg:string (shell_arg i)
                    def hVal@(optional):double (to_double hArg)
                    if hVal {
                        pageHeight = (unwrap hVal)
                    }
                }
            }
            
            if (arg == "-bleed") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    def bArg:string (shell_arg i)
                    def bVal@(optional):double (to_double bArg)
                    if bVal {
                        bleed = (unwrap bVal)
                    }
                }
            }

            if (arg == "-colors") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    colorMode = (shell_arg i)
                }
            }

            if (arg == "-pdfx") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    pdfxProfile = (shell_arg i)
                }
            }

            if (arg == "-intent") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    intentId = (shell_arg i)
                }
            }

            if (arg == "-intent-info") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    intentInfo = (shell_arg i)
                }
            }

            if (arg == "-title") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    docTitle = (shell_arg i)
                }
            }

            if (arg == "-author") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    docAuthor = (shell_arg i)
                }
            }

            if (arg == "-fonts") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    fontsOverride = (shell_arg i)
                }
            }

            if (arg == "-strict-print") {
                strictPrint = true
            }

            if (arg == "-strict-fonts") {
                strictFonts = true
            }

            if (arg == "-css") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    styles.addFile((shell_arg i))
                }
            }

            if (arg == "-theme") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    styles.setTheme((shell_arg i))
                }
            }

            if (arg == "-debug") {
                debug = true
            }
            
            i = i + 1
        }
        
        print ("EVG PDF Tool")
        print ("Input:  " + inputFile)
        print ("Output: " + outputFile)
        print ("Page:   " + (to_string pageWidth) + " x " + (to_string pageHeight) + " points")
        
        this.convert()
    }
    
    ; Font directories depend on where the document lives, so this runs from
    ; convert() once the input path is known — not at startup against the
    ; process working directory, which is what silently found nothing before.
    fn initFonts:void (inputDir:string) {
        print ""
        print "Loading fonts..."
        fontSetup.init(inputDir fontsOverride)
        fontManager = (fontSetup.getManager())
        fontSetup.report(debug)
    }
    
    fn printUsage:void () {
        print "EVG PDF Tool - Convert TSX files to PDF"
        print ""
        print "Usage: evg_pdf_tool input.tsx output.pdf"
        print ""
        print "Options:"
        print "  -w WIDTH   Page width in points (default: 595 = A4)"
        print "  -h HEIGHT  Page height in points (default: 842 = A4)"
        print "  -css FILE  Apply a CSS subset stylesheet (repeatable)"
        print "  -theme T   Theme name selecting .theme-T rules"
        print "  -bleed PT  Print bleed in points on every side (adds TrimBox)"
        print "  -colors M  rgb (default) or cmyk - converts fills, strokes and text"
        print "  -pdfx V    X-4 or X-1a - identifies the file, adds the output intent"
        print "  -intent ID Printing condition, e.g. FOGRA39 or 'CGATS TR 001'"
        print "  -title S   Document title, for the info dictionary and the XMP"
        print "  -author S  Document author"
        print "  -strict-print  Fail rather than write a file that claims PDF/X it does not meet"
        print "  -fonts DIR Directory to search for font families"
        print "  -strict-fonts  Fail instead of measuring with guessed widths"
        print "  -debug     Enable debug output"
        print ""
        print "Example:"
        print "  evg_pdf_tool sample.tsx output.pdf"
        print "  evg_pdf_tool sample.tsx output.pdf -w 612 -h 792"
    }
    
    fn convert:void () {
        ; Extract directory and filename from input path
        def inputDir:string ""
        def inputFileName:string inputFile
        
        def lastSlash:int (lastIndexOf inputFile "/")
        def lastBackslash:int (lastIndexOf inputFile "\\")
        def lastSep:int lastSlash
        if (lastBackslash > lastSep) {
            lastSep = lastBackslash
        }
        
        if (lastSep >= 0) {
            inputDir = (substring inputFile 0 (lastSep + 1))
            inputFileName = (substring inputFile (lastSep + 1) (strlen inputFile))
        } {
            inputDir = "./"
        }
        
        ; Fonts first: the measurer that layout uses has to be the real one
        ; before anything is measured.
        this.initFonts(inputDir)

        ; Parse TSX file
        print ""
        print "Parsing TSX file..."
        
        def converter (new JSXToEVG())
        converter.pageWidth = pageWidth
        converter.pageHeight = pageHeight
        
        def root:EVGElement (converter.parseFile(inputDir inputFileName))
        
        if (root.tagName == "") {
            print "Error: Failed to parse TSX file or no JSX content found"
            return
        }
        
        print ("Found root element: <" + root.tagName + ">")
        print ("Children: " + (to_string (root.getChildCount())))

        ; Resolve stylesheet rules onto the tree BEFORE layout, so layout and
        ; every renderer see one set of computed properties. Inline attributes
        ; recorded during parsing are left untouched.
        def usedTheme:string (styles.applyTo(root))
        styles.report(usedTheme)
        
        if debug {
            this.printTree(root 0)
        }
        
        ; Render to PDF
        print ""
        print "Rendering to PDF..."
        
        def renderer (new EVGPDFRenderer())
        renderer.init(renderer)  ; Pass self for Rust Rc pattern
        renderer.setPageSize(pageWidth pageHeight)
        renderer.setFontManager(fontManager)
        renderer.setBaseDir(inputDir)
        if debug {
            renderer.setDebug(true)
        }
        
        ; Use TTF text measurer for accurate measurements
        def ttfMeasurer (new TTFTextMeasurer(fontManager))
        renderer.setMeasurer(ttfMeasurer)
        renderer.setStrictFonts(strictFonts)
        renderer.setBleed(bleed)
        renderer.setColorMode(colorMode)
        renderer.setPdfxProfile(pdfxProfile)
        renderer.setOutputIntent(intentId intentInfo)
        renderer.setDocumentInfo(docTitle docAuthor)
        if ((strlen pdfxProfile) > 0) {
            print (("  Print finishing: PDF/" + pdfxProfile) + ", " + colorMode + ", intent " + intentId)
        }
        
        def pdfData:buffer (renderer.render(root))

        ; What the print finishing did, and what it could not do. A file that
        ; claims PDF/X it does not meet is worse than one that claims nothing.
        def finishing:string (renderer.finishingReport())
        if ((strlen finishing) > 0) {
            print finishing
        }
        def issues:int (renderer.conformanceIssues())
        if (issues > 0) {
            if strictPrint {
                print "FAILED: -strict-print, and this file would not pass a PDF/X check."
                ; A non-zero status, so a build script stops here rather than
                ; carrying on and reporting success for the rest of the job.
                exit 2
            }
        }

        ; Surface anything the text engine could not measure honestly. A page
        ; that silently fell back to guessed widths looks fine on screen and
        ; reflows in print, so it is reported every run and is fatal under
        ; -strict-fonts.
        ; Layout could not honour everything the page asked for — an
        ; unsupported grid track function, a named grid line, an area that does
        ; not exist. These used to go only to the debug log, so a grid that
        ; came out with the wrong number of columns gave no clue why.
        def lay:EVGLayout (renderer.getLayout())
        def li:int 0
        while (li < (lay.warningCount())) {
            print ("Layout warning: " + (lay.warningAt(li)))
            li = (li + 1)
        }

        def engine:EVGTextEngine (renderer.getTextEngine())
        def wi:int 0
        while (wi < (engine.warningCount())) {
            print ("Font warning: " + (engine.warningAt(wi)))
            wi = (wi + 1)
        }
        if (engine.hadFatal) {
            print "Error: -strict-fonts was requested and text could not be measured from the declared faces."
            return
        }

        ; Characters WinAnsi cannot encode were painted as "?" but measured as
        ; the real glyph, so the reserved width is wrong too. Report rather than
        ; ship a page with silently missing letters.
        def gi:int 0
        while (gi < (renderer.unsupportedGlyphCount())) {
            print ("Encoding warning: " + (renderer.unsupportedGlyphReport(gi))
                + " is outside WinAnsi and was written as '?'")
            gi = (gi + 1)
        }
        if ((renderer.unsupportedGlyphCount()) > 0) {
            print ("  " + (to_string (renderer.unsupportedGlyphCount()))
                + " character(s) could not be encoded. Use characters within WinAnsi,")
            print "  or extend the PDF font path to an embedded subset with a /ToUnicode cmap."
            if strictFonts {
                print "Error: -strict-fonts was requested and some characters cannot be encoded."
                return
            }
        }

        
        ; Write output file
        print ""
        print ("Writing PDF to: " + outputFile)
        
        def outputDir:string ""
        def outputFileName:string outputFile
        
        lastSlash = (lastIndexOf outputFile "/")
        lastBackslash = (lastIndexOf outputFile "\\")
        lastSep = lastSlash
        if (lastBackslash > lastSep) {
            lastSep = lastBackslash
        }
        
        if (lastSep >= 0) {
            outputDir = (substring outputFile 0 (lastSep + 1))
            outputFileName = (substring outputFile (lastSep + 1) (strlen outputFile))
        } {
            outputDir = "./"
        }
        
        buffer_write_file outputDir outputFileName pdfData
        
        print ""
        print ("Done! PDF written: " + (to_string (buffer_length pdfData)) + " bytes")
    }
    
    fn printTree:void (el:EVGElement indent:int) {
        def spaces:string ""
        def i 0
        while (i < indent) {
            spaces = spaces + "  "
            i = i + 1
        }
        
        def info:string (spaces + "<" + el.tagName)
        if ((strlen el.id) > 0) {
            info = info + " id=\"" + el.id + "\""
        }
        if ((strlen el.textContent) > 0) {
            info = info + " text=\"" + el.textContent + "\""
        }
        info = info + "> pos=(" + (to_string el.calculatedX) + "," + (to_string el.calculatedY) + ") size=" + (to_string el.calculatedWidth) + "x" + (to_string el.calculatedHeight)
        print info
        
        def j 0
        def childCount:int (el.getChildCount())
        while (j < childCount) {
            def child:EVGElement (el.getChild(j))
            this.printTree(child (indent + 1))
            j = j + 1
        }
    }
}

; evg_html_tool.rgr - CLI tool for TSX to HTML conversion
;
; Usage: evg_html_tool.exe input.tsx output.html
;
; This tool converts TSX files to HTML for quick preview in browsers.
; It uses the same JSXToEVG parser as the PDF tool, but renders to HTML/CSS.
;
; Compile: npm run evghtml:compile
; Run: npm run evghtml:run

Import "../jsx/JSXToEVG.rgr"
Import "../core/EVGHTMLRenderer.rgr"
Import "../core/EVGStyleLoader.rgr"
Import "../fonts/FontManager.rgr"
Import "../fonts/EVGFontSetup.rgr"
Import "../../../evg/EVGElement.rgr"
Import "../../../evg/EVGGrapheme.rgr"

class EVGHTMLTool {
    def inputFile:string ""
    def outputFile:string ""
    def pageWidth:double 595.0
    def pageHeight:double 842.0
    def debug:boolean false
    def styles:EVGStyleLoader
    ; The HTML preview measures with the same TTF faces the PDF embeds.
    ; Without this the preview laid out with heuristic widths, so a page could
    ; look right in the browser and still print wrong.
    def fontSetup:EVGFontSetup (new EVGFontSetup())
    def fontsOverride:string ""
    def strictFonts:boolean false
    def embedAssets:boolean false
    def title:string "EVG Preview"
    
    Constructor () {
        def sl (new EVGStyleLoader())
        styles = sl
    }

    sfn m@(main):void () {
        def tool (new EVGHTMLTool())
        tool.run()
    }
    
    fn run:void () {
        def argCount:int (shell_arg_cnt)
        
        if (argCount < 2) {
            this.printUsage()
            return
        }
        
        ; Parse arguments
        inputFile = (shell_arg 0)
        outputFile = (shell_arg 1)
        
        ; Parse optional arguments
        def i 2
        while (i < argCount) {
            def arg:string (shell_arg i)
            
            if (arg == "-w") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    def wArg:string (shell_arg i)
                    def wVal@(optional):double (to_double wArg)
                    if wVal {
                        pageWidth = (unwrap wVal)
                    }
                }
            }
            
            if (arg == "-h") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    def hArg:string (shell_arg i)
                    def hVal@(optional):double (to_double hArg)
                    if hVal {
                        pageHeight = (unwrap hVal)
                    }
                }
            }
            
            if (arg == "-title") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    title = (shell_arg i)
                }
            }
            
            if (arg == "-fonts") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    fontsOverride = (shell_arg i)
                }
            }

            if (arg == "-strict-fonts") {
                strictFonts = true
            }

            if (arg == "-css") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    styles.addFile((shell_arg i))
                }
            }

            if (arg == "-theme") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    styles.setTheme((shell_arg i))
                }
            }

            if (arg == "-debug") {
                debug = true
            }
            
            if (arg == "-embed") {
                embedAssets = true
            }
            
            i = i + 1
        }
        
        print ("EVG HTML Tool")
        print ("Input:  " + inputFile)
        print ("Output: " + outputFile)
        print ("Page:   " + (to_string pageWidth) + " x " + (to_string pageHeight) + " points")
        
        this.convert()
    }
    
    fn printUsage:void () {
        print "EVG HTML Tool - Convert TSX files to HTML"
        print ""
        print "Usage: evg_html_tool input.tsx output.html"
        print ""
        print "Options:"
        print "  -w WIDTH   Page width in points (default: 595 = A4)"
        print "  -h HEIGHT  Page height in points (default: 842 = A4)"
        print "  -title T   HTML page title"
        print "  -css FILE  Apply a CSS subset stylesheet (repeatable)"
        print "  -theme T   Theme name selecting .theme-T rules"
        print "  -fonts DIR Directory to search for font families"
        print "  -strict-fonts  Fail instead of measuring with guessed widths"
        print "  -debug     Enable debug output"
        print "  -embed     Embed images as base64 data URLs"
        print ""
        print "Example:"
        print "  evg_html_tool sample.tsx output.html"
        print "  evg_html_tool sample.tsx output.html -w 612 -h 792"
    }
    
    fn convert:void () {
        ; Extract directory and filename from input path
        def inputDir:string ""
        def inputFileName:string inputFile
        
        def lastSlash:int (lastIndexOf inputFile "/")
        def lastBackslash:int (lastIndexOf inputFile "\\")
        def lastSep:int lastSlash
        if (lastBackslash > lastSep) {
            lastSep = lastBackslash
        }
        
        if (lastSep >= 0) {
            inputDir = (substring inputFile 0 (lastSep + 1))
            inputFileName = (substring inputFile (lastSep + 1) (strlen inputFile))
        } {
            inputDir = "./"
        }
        
        ; Fonts first, so layout measures with the real faces.
        print ""
        print "Loading fonts..."
        fontSetup.init(inputDir fontsOverride)
        fontSetup.report(debug)

        ; Parse TSX file
        print ""
        print "Parsing TSX file..."
        
        def converter (new JSXToEVG())
        converter.pageWidth = pageWidth
        converter.pageHeight = pageHeight
        
        def root:EVGElement (converter.parseFile(inputDir inputFileName))
        
        if (root.tagName == "") {
            print "Error: Failed to parse TSX file or no JSX content found"
            return
        }
        
        print ("Found root element: <" + root.tagName + ">")
        print ("Children: " + (to_string (root.getChildCount())))

        ; Resolve stylesheet rules onto the tree BEFORE layout, so layout and
        ; every renderer see one set of computed properties. Inline attributes
        ; recorded during parsing are left untouched.
        def usedTheme:string (styles.applyTo(root))
        styles.report(usedTheme)
        
        if debug {
            this.printTree(root 0)
        }
        
        ; Render to HTML
        print ""
        print "Rendering to HTML..."
        
        def renderer (new EVGHTMLRenderer())
        renderer.setPageSize(pageWidth pageHeight)
        renderer.setTitle(title)
        renderer.setBaseDir(inputDir)
        ; Point @font-face at the directory the faces were actually loaded
        ; from. This used to be guessed as inputDir + "../assets/fonts/", which
        ; is only right for documents that sit in gallery/pdf_writer/examples;
        ; anywhere else it wrote a path that does not exist — and, when the
        ; input path was absolute, one that only exists on the build machine.
        ; The browser then loaded no face at all, fell back to a system font
        ; with different metrics, and wrapped text where EVG had not, so
        ; absolutely-positioned boxes landed on top of headings.
        def fontsRoot:string (fontSetup.fontsRoot())
        if ((strlen fontsRoot) > 0) {
            renderer.setFontBasePath(fontsRoot)
        } {
            renderer.setFontBasePath(inputDir + "../assets/fonts/")
        }

        ; Hand over the file each face was actually opened from, so @font-face
        ; points at the same TTF the layout was measured with instead of a
        ; hand-maintained guess.
        def fmForFaces:FontManager (fontSetup.getManager())
        def fi:int 0
        while (fi < (array_length fmForFaces.fonts)) {
            def face:TrueTypeFont (itemAt fmForFaces.fonts fi)
            renderer.addFontFile(face.fontFamily face.fontPath)
            fi = (fi + 1)
        }

        ; If any text in the document needs a face the declared one does not
        ; have — an emoji, in practice — name it so the browser resolves the
        ; same file EVG measured with instead of substituting its own. Only
        ; when the document actually needs it: the face is embedded base64 and
        ; would otherwise bloat every page that has no emoji on it.
        ; The renderer needs the faces too, so an emoji run can be found and
        ; wrapped in its own colour when `emoji-color` asks for one.
        renderer.setFontManager(fmForFaces)
        def fbFamily:string (this.findFallbackFamily(root fmForFaces))
        if ((strlen fbFamily) > 0) {
            renderer.setFallbackFamily(fbFamily)
            print ("Fallback face: " + fbFamily)
        }

        ; Same faces as the PDF path: measurement now comes from the TTF files
        ; rather than fontSize * 0.55.
        def ttfMeasurer (new TTFTextMeasurer((fontSetup.getManager())))
        renderer.setMeasurer(ttfMeasurer)
        renderer.setStrictFonts(strictFonts)
        if debug {
            renderer.setDebug(true)
        }
        if embedAssets {
            renderer.setEmbedAssets(true)
        }
        
        def htmlContent:string (renderer.render(root))

        ; Surface anything the text engine could not measure honestly. A page
        ; that silently fell back to guessed widths looks fine on screen and
        ; reflows in print, so it is reported every run and is fatal under
        ; -strict-fonts.
        ; Layout could not honour everything the page asked for — an
        ; unsupported grid track function, a named grid line, an area that does
        ; not exist. These used to go only to the debug log, so a grid that
        ; came out with the wrong number of columns gave no clue why.
        def lay:EVGLayout (renderer.getLayout())
        def li:int 0
        while (li < (lay.warningCount())) {
            print ("Layout warning: " + (lay.warningAt(li)))
            li = (li + 1)
        }

        def engine:EVGTextEngine (renderer.getTextEngine())
        def wi:int 0
        while (wi < (engine.warningCount())) {
            print ("Font warning: " + (engine.warningAt(wi)))
            wi = (wi + 1)
        }
        if (engine.hadFatal) {
            print "Error: -strict-fonts was requested and text could not be measured from the declared faces."
            return
        }

        
        ; Write output file
        print ""
        print ("Writing HTML to: " + outputFile)
        
        def outputDir:string ""
        def outputFileName:string outputFile
        
        lastSlash = (lastIndexOf outputFile "/")
        lastBackslash = (lastIndexOf outputFile "\\")
        lastSep = lastSlash
        if (lastBackslash > lastSep) {
            lastSep = lastBackslash
        }
        
        if (lastSep >= 0) {
            outputDir = (substring outputFile 0 (lastSep + 1))
            outputFileName = (substring outputFile (lastSep + 1) (strlen outputFile))
        } {
            outputDir = "./"
        }
        
        ; Write the HTML file
        (write_file outputDir outputFileName htmlContent)
        
        print ""
        print "Done!"
        print ("Output: " + outputFile)
        print ("File size: " + (to_string (strlen htmlContent)) + " bytes")
    }
    
    fn printTree:void (element:EVGElement depth:int) {
        def indent:string ""
        def i 0
        while (i < depth) {
            indent = indent + "  "
            i = i + 1
        }
        
        def info:string (indent + "<" + element.tagName)
        
        if (element.id != "") {
            info = info + " id=\"" + element.id + "\""
        }
        
        if element.width.isSet {
            info = info + " width=\"" + (element.width.toString()) + "\""
        }
        
        if element.height.isSet {
            info = info + " height=\"" + (element.height.toString()) + "\""
        }
        
        if element.backgroundColor.isSet {
            info = info + " backgroundColor=\"" + (element.backgroundColor.toCSSString()) + "\""
        }
        
        info = info + ">"
        
        if (element.textContent != "") {
            info = info + " \"" + element.textContent + "\""
        }
        
        print info
        
        ; Print children
        for element.children child:EVGElement i {
            this.printTree(child (depth + 1))
        }
    }

    ; The first face needed for a codepoint the declared face cannot draw, or
    ; "" when every character in the document is covered.
    fn findFallbackFamily:string (el:EVGElement fm:FontManager) {
        if ((strlen el.textContent) > 0) {
            def fam:string (el.effectiveFontFamily())
            def primary:TrueTypeFont (fm.getFont(fam))
            if (primary.isLoaded()) {
                ; By cluster, not by codepoint: a keycap begins with a digit
                ; the text face has, so a per-codepoint check would say the
                ; document needs nothing and the browser would be left to
                ; substitute its own emoji font — with advances that are not
                ; the ones EVG measured with.
                def cps:[int] (EVGCodepoint.toArray(el.textContent))
                def i:int 0
                while (i < (array_length cps)) {
                    def end:int (EVGGrapheme.clusterEnd(cps i))
                    def face:TrueTypeFont (fm.faceForClusterFrom(primary cps i end))
                    if (face.isLoaded()) {
                        if ((face.fontPath == primary.fontPath) == false) {
                            return face.fontFamily
                        }
                    }
                    i = end
                }
            }
        }
        def j:int 0
        while (j < (el.getChildCount())) {
            def kid:EVGElement (el.getChild(j))
            def found:string (this.findFallbackFamily(kid fm))
            if ((strlen found) > 0) {
                return found
            }
            j = (j + 1)
        }
        return ""
    }

}

; evg_png_tool.rgr - CLI tool for TSX to PNG conversion
;
; Usage: evg_png_tool input.tsx output.png
;
; This tool converts TSX files to PNG images using the software rasterizer.
; It uses the same JSXToEVG parser as the HTML and PDF tools.

Import "../jsx/JSXToEVG.rgr"
Import "../raster/EVGRasterRenderer.rgr"
Import "../raster/RasterText.rgr"
Import "../raster/PNGEncoder.rgr"
Import "../raster/VectorRasterizer.rgr"
Import "../../../evg/SVGPathParser.rgr"
Import "../../../evg/VectorViewBox.rgr"
Import "../../../evg/VectorStroke.rgr"
Import "../../../evg/EVGElement.rgr"
Import "../../../evg/EVGLayout.rgr"
Import "../fonts/TrueTypeFont.rgr"
Import "../fonts/FontManager.rgr"
Import "../fonts/EVGFontSetup.rgr"
Import "../../../evg/EVGTextEngine.rgr"
Import "../core/EVGStyleLoader.rgr"
Import "../jpeg/JPEGDecoder.rgr"
Import "../jpeg/ProgressiveJPEGDecoder.rgr"

class EVGPNGTool {
    def inputFile:string ""
    def outputFile:string ""
    def pageWidth:double 595.0
    def pageHeight:double 842.0
    def scale:double 1.0
    def debug:boolean false
    
    def renderer:EVGRasterRenderer
    def textRenderer:RasterText
    def fontManager:FontManager
    def layout:EVGLayout
    def baseDir:string ""
    ; The raster target had no stylesheet path at all, so the same TSX rendered
    ; with -css produced a themed PDF and an unthemed image.
    def styles:EVGStyleLoader
    def imageCache:[ImageBuffer]
    def imageCacheKeys:[string]
    
    sfn m@(main):void () {
        def tool (new EVGPNGTool())
        tool.run()
    }
    
    fn run:void () {
        def sl (new EVGStyleLoader())
        styles = sl
        def argCount:int (shell_arg_cnt)
        
        if (argCount < 2) {
            this.printUsage()
            return
        }
        
        ; Parse arguments
        inputFile = (shell_arg 0)
        outputFile = (shell_arg 1)
        
        ; Parse optional arguments
        def i 2
        while (i < argCount) {
            def arg:string (shell_arg i)
            
            if (arg == "-w") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    def wArg:string (shell_arg i)
                    def wVal@(optional):double (to_double wArg)
                    if wVal {
                        pageWidth = (unwrap wVal)
                    }
                }
            }
            
            if (arg == "-h") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    def hArg:string (shell_arg i)
                    def hVal@(optional):double (to_double hArg)
                    if hVal {
                        pageHeight = (unwrap hVal)
                    }
                }
            }
            
            if (arg == "-scale") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    def sArg:string (shell_arg i)
                    def sVal@(optional):double (to_double sArg)
                    if sVal {
                        scale = (unwrap sVal)
                    }
                }
            }
            
            if (arg == "-css") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    styles.addFile((shell_arg i))
                }
            }

            if (arg == "-theme") {
                if ((i + 1) < argCount) {
                    i = i + 1
                    styles.setTheme((shell_arg i))
                }
            }

            if (arg == "-debug") {
                debug = true
            }
            
            i = i + 1
        }
        
        print ("EVG PNG Tool")
        print ("Input:  " + inputFile)
        print ("Output: " + outputFile)
        print ("Page:   " + (to_string pageWidth) + " x " + (to_string pageHeight) + " points")
        print ("Scale:  " + (to_string scale))
        
        this.convert()
    }
    
    fn printUsage:void () {
        print "EVG PNG Tool - Convert TSX files to PNG"
        print ""
        print "Usage: evg_png_tool input.tsx output.png"
        print ""
        print "Options:"
        print "  -w WIDTH   Page width in points (default: 595 = A4)"
        print "  -h HEIGHT  Page height in points (default: 842 = A4)"
        print "  -scale S   Scale factor (default: 1.0)"
        print "  -debug     Enable debug output"
        print ""
        print "Example:"
        print "  evg_png_tool sample.tsx output.png"
        print "  evg_png_tool sample.tsx output.png -w 800 -h 600 -scale 2"
    }
    
    fn convert:void () {
        ; Extract directory and filename from input path
        def inputDir:string ""
        def inputFileName:string inputFile
        
        def lastSlash:int (lastIndexOf inputFile "/")
        def lastBackslash:int (lastIndexOf inputFile "\\")
        def lastSep:int lastSlash
        if (lastBackslash > lastSep) {
            lastSep = lastBackslash
        }
        
        if (lastSep >= 0) {
            inputDir = (substring inputFile 0 (lastSep + 1))
            inputFileName = (substring inputFile (lastSep + 1) (strlen inputFile))
        } {
            inputDir = "./"
        }
        
        baseDir = inputDir
        
        ; Parse TSX file
        print ""
        print "Parsing TSX file..."
        
        def converter (new JSXToEVG())
        converter.pageWidth = pageWidth
        converter.pageHeight = pageHeight
        
        def root:EVGElement (converter.parseFile(inputDir inputFileName))
        
        if (root.tagName == "") {
            print "Error: Failed to parse TSX file or no JSX content found"
            return
        }
        
        ; Stylesheets are applied to the parsed tree before layout, exactly as
        ; the PDF and HTML tools do, so one -css/-theme pair drives every
        ; target the same way.
        def usedTheme:string (styles.applyTo(root))
        if (styles.hasFiles()) {
            styles.report(usedTheme)
        }

        print ("Found root element: <" + root.tagName + ">")
        print ("Children: " + (to_string (root.getChildCount())))
        
        ; Initialize renderer
        print ""
        print "Initializing raster renderer..."
        
        def pixelWidth:int (to_int (pageWidth * scale))
        def pixelHeight:int (to_int (pageHeight * scale))
        
        print ("Raster size: " + (to_string pixelWidth) + " x " + (to_string pixelHeight) + " pixels")
        
        renderer = (new EVGRasterRenderer())
        renderer.init(pixelWidth pixelHeight)
        renderer.clear(245 245 245 255)  ; Light gray background (#f5f5f5)
        
        ; Verify buffer was cleared - check first few pixels
        def testBuf:RasterBuffer (renderer.getBuffer())
        def p0:int (buffer_get testBuf.pixels 0)
        def p1:int (buffer_get testBuf.pixels 1)
        def p2:int (buffer_get testBuf.pixels 2)
        def p3:int (buffer_get testBuf.pixels 3)
        print ("Buffer created - first pixel RGBA: " + (to_string p0) + "," + (to_string p1) + "," + (to_string p2) + "," + (to_string p3))
        
        ; Initialize font manager through the shared setup, so the raster
        ; target resolves the same faces as PDF and HTML.
        def fontSetup (new EVGFontSetup())
        fontSetup.init(inputDir "")
        def fm:FontManager (fontSetup.getManager())
        fontManager = fm
        fontSetup.report(false)
        
        ; Initialize text renderer
        textRenderer = (new RasterText())
        ; So a codepoint the declared face lacks — an emoji, most often — is
        ; drawn from a face that has it instead of coming out as an empty box.
        textRenderer.setFallbackManager(fm)
        def defaultFont:TrueTypeFont (fontManager.getFont("Open Sans"))
        if (defaultFont.unitsPerEm > 0) {
            textRenderer.setFont(defaultFont)
        }
        
        ; Run layout to calculate element positions and sizes
        print ""
        print "Running layout engine..."
        
        layout = (new EVGLayout())
        ; The raster path paints glyph outlines from these TTFs, so layout has
        ; to measure with them too — it used to run on the heuristic measurer,
        ; which made the raster target size boxes it then painted differently.
        def ttfMeasurer (new TTFTextMeasurer(fm))
        layout.setMeasurer(ttfMeasurer)
        layout.setPageSize(pageWidth pageHeight)
        layout.debug = true
        layout.layout(root)

        ; Anything layout could not honour — an unsupported grid track
        ; function, a named grid line, an area that does not exist. The raster
        ; target reported none of this before, so a grid that came out wrong
        ; here looked like a raster bug rather than a rejected declaration.
        def lwi:int 0
        while (lwi < (layout.warningCount())) {
            print ("Layout warning: " + (layout.warningAt(lwi)))
            lwi = (lwi + 1)
        }

        ; The same for text the engine could not measure from the declared
        ; face; a guessed advance reflows between this target and the PDF.
        def tEngine:EVGTextEngine (layout.getTextEngine())
        def twi:int 0
        while (twi < (tEngine.warningCount())) {
            print ("Font warning: " + (tEngine.warningAt(twi)))
            twi = (twi + 1)
        }

        print ("Root calculated: x=" + (to_string root.calculatedX) + " y=" + (to_string root.calculatedY) + " w=" + (to_string root.calculatedWidth) + " h=" + (to_string root.calculatedHeight))
        
        ; Check buffer before render
        def beforeRender:RasterBuffer (renderer.getBuffer())
        def br0:int (buffer_get beforeRender.pixels 0)
        print ("Before renderElement - first pixel R: " + (to_string br0))
        
        ; Render the element tree
        print ""
        print "Rendering to raster buffer..."
        
        this.renderElement(root 0.0 0.0)
        
        ; Check buffer after render
        def afterRender:RasterBuffer (renderer.getBuffer())
        def ar0:int (buffer_get afterRender.pixels 0)
        print ("After renderElement - first pixel R: " + (to_string ar0))
        
        ; Save as PNG
        print ""
        print "Saving PNG..."
        
        ; Extract output directory and filename
        def outputDir:string ""
        def outputFileName:string outputFile
        
        lastSlash = (lastIndexOf outputFile "/")
        lastBackslash = (lastIndexOf outputFile "\\")
        lastSep = lastSlash
        if (lastBackslash > lastSep) {
            lastSep = lastBackslash
        }
        
        if (lastSep >= 0) {
            outputDir = (substring outputFile 0 (lastSep + 1))
            outputFileName = (substring outputFile (lastSep + 1) (strlen outputFile))
        } {
            outputDir = "./"
        }
        
        ; Check pixel values before encoding
        def finalBuf:RasterBuffer (renderer.getBuffer())
        def fp0:int (buffer_get finalBuf.pixels 0)
        def fp1:int (buffer_get finalBuf.pixels 1)
        def fp2:int (buffer_get finalBuf.pixels 2)
        def fp3:int (buffer_get finalBuf.pixels 3)
        print ("Before PNG encode - first pixel RGBA: " + (to_string fp0) + "," + (to_string fp1) + "," + (to_string fp2) + "," + (to_string fp3))
        print ("  Buffer size: " + (to_string finalBuf.width) + "x" + (to_string finalBuf.height))
        
        def pngEncoder:PNGEncoder (new PNGEncoder())
        pngEncoder.encode((renderer.getBuffer()) outputDir outputFileName)
        
        print ""
        print "Done!"
        print ("Output: " + outputFile)
    }
    
    ; Render an EVG element recursively
    fn renderElement:void (el:EVGElement offsetX:double offsetY:double) {
        ; Layout engine provides absolute positions, so ignore offsets
        def x:double (el.calculatedX * scale)
        def y:double (el.calculatedY * scale)
        def w:double (el.calculatedWidth * scale)
        def h:double (el.calculatedHeight * scale)
        
        ; Handle padding - with null checks
        def padTop:double 0.0
        def padRight:double 0.0
        def padBottom:double 0.0
        def padLeft:double 0.0
        
        if el.paddingTop {
            if el.paddingTop.isSet {
                padTop = el.paddingTop.pixels * scale
            }
        }
        if el.paddingRight {
            if el.paddingRight.isSet {
                padRight = el.paddingRight.pixels * scale
            }
        }
        if el.paddingBottom {
            if el.paddingBottom.isSet {
                padBottom = el.paddingBottom.pixels * scale
            }
        }
        if el.paddingLeft {
            if el.paddingLeft.isSet {
                padLeft = el.paddingLeft.pixels * scale
            }
        }
        
        ; Get border radius
        ; border-radius lives on the BOX. EVGElement carried a field of the same
        ; name that setAttribute never wrote, and this was the only code
        ; reading it — so every rounded corner came out square in the raster
        ; while the PDF, which reads the box, rounded them correctly.
        def radius:int 0
        if el.box.borderRadius {
            if el.box.borderRadius.isSet {
                radius = (to_int (el.box.borderRadiusPx * scale))
            }
        }
        
        if debug {
            print ("Render: " + el.tagName + " at (" + (to_string x) + ", " + (to_string y) + ") size " + (to_string w) + "x" + (to_string h))
        }
        
        ; Always print for now to debug
        print ("  Render: " + el.tagName + " bg=" + (to_string el.backgroundColor.isSet) + " grad=" + el.backgroundGradient + " x=" + (to_string (to_int x)) + " y=" + (to_string (to_int y)) + " w=" + (to_string (to_int w)) + " h=" + (to_string (to_int h)))
        
        ; Render shadow first (if any)
        if el.shadowColor {
            if el.shadowColor.isSet {
                def shadowR:int (el.shadowColor.red())
                def shadowG:int (el.shadowColor.green())
                def shadowB:int (el.shadowColor.blue())
                def shadowA:int (to_int ((el.shadowColor.alpha()) * 255.0))
                def blurRadius:int 0
                def shadowOffX:int 0
                def shadowOffY:int 0
                
                if el.shadowRadius {
                    if el.shadowRadius.isSet {
                        blurRadius = (to_int (el.shadowRadius.pixels * scale))
                    }
                }
                if el.shadowOffsetX {
                    if el.shadowOffsetX.isSet {
                        shadowOffX = (to_int (el.shadowOffsetX.pixels * scale))
                    }
                }
                if el.shadowOffsetY {
                    if el.shadowOffsetY.isSet {
                        shadowOffY = (to_int (el.shadowOffsetY.pixels * scale))
                    }
                }
                
                if (w > 0.0) {
                    if (h > 0.0) {
                        renderer.renderShadowOnly(
                            (to_int x) (to_int y) (to_int w) (to_int h) radius
                            shadowR shadowG shadowB shadowA
                            blurRadius shadowOffX shadowOffY
                        )
                    }
                }
            }
        }
        
        ; Render background (gradient or solid color)
        if (el.backgroundGradient != "") {
            this.renderGradient(el x y w h radius)
        } {
            if el.backgroundColor.isSet {
                def bgR:int (el.backgroundColor.red())
                def bgG:int (el.backgroundColor.green())
                def bgB:int (el.backgroundColor.blue())
                def bgA:int (to_int ((el.backgroundColor.alpha()) * 255.0))
                
                print ("    fillRect color: " + (to_string bgR) + "," + (to_string bgG) + "," + (to_string bgB) + "," + (to_string bgA))
                
                if (w > 0.0) {
                    if (h > 0.0) {
                        if (radius > 0) {
                            renderer.fillRoundedRect((to_int x) (to_int y) (to_int w) (to_int h) radius bgR bgG bgB bgA)
                        } {
                            renderer.fillRect((to_int x) (to_int y) (to_int w) (to_int h) bgR bgG bgB bgA)
                        }
                    }
                }
            }
        }
        
        ; Render border.
        ;
        ; Through the element's accessor: this read the element-level fields,
        ; which only the camelCase style-object path writes, so a border
        ; declared in CSS printed in the PDF and was missing from the image.
        def bwPx:double (el.effectiveBorderWidthPx())
        if (bwPx > 0.0) {
            def ebc:EVGColor (el.effectiveBorderColor())
            if (w > 0.0) {
                if (h > 0.0) {
                    def br:int (ebc.red())
                    def bg:int (ebc.green())
                    def bb:int (ebc.blue())
                    def ba:int (to_int ((ebc.alpha()) * 255.0))
                    ; The primitives draw a ONE PIXEL outline, so a 3px
                    ; border came out hairline here while the PDF and the GPU
                    ; backend drew it at its declared width. Nesting the
                    ; outline inwards gives the band its thickness — and the
                    ; radius has to shrink with it, or the corners of the
                    ; inner rings bulge outside the outer one.
                    def bwInt:int (to_int (bwPx * scale))
                    if (bwInt < 1) {
                        bwInt = 1
                    }
                    def ring:int 0
                    while (ring < bwInt) {
                        def rx:int (to_int (x + (to_double ring)))
                        def ry:int (to_int (y + (to_double ring)))
                        def rw:int (to_int (w - (to_double (ring * 2))))
                        def rh:int (to_int (h - (to_double (ring * 2))))
                        if (rw > 0) {
                            if (rh > 0) {
                                def rr:int (radius - ring)
                                if (rr < 0) {
                                    rr = 0
                                }
                                if (rr > 0) {
                                    renderer.drawRoundedRect(rx ry rw rh rr br bg bb ba)
                                } {
                                    renderer.drawRect(rx ry rw rh br bg bb ba)
                                }
                            }
                        }
                        ring = (ring + 1)
                    }
                }
            }
        }
        
        ; Photographs. The raster target used to skip images entirely — a
        ; photo book rendered to PNG came out with the text and none of the
        ; pictures, silently.
        if ((strlen el.src) > 0) {
            this.renderImage(el x y w h)
        }

        ; Vector paths. PLAN_VECTOR_IR.md Stage 2 / TODO_EVG "PNG 0.9": the
        ; raster target had no path support at all, so a <Path> that appeared
        ; in PDF and HTML was simply missing from the PNG.
        if (el.tagName == "path") {
            this.renderPath(el x y w h)
        }

        ; Render text content (for Label elements)
        if (el.textContent != "") {
            this.renderText(el x y w h padLeft padTop padRight)
        }
        
        ; Render children - they have their own absolute calculated positions
        for el.children child:EVGElement i {
            this.renderElement(child 0.0 0.0)
        }
    }
    
    ; --------------------------------------------------------------------------
    ; Vector paths
    ; --------------------------------------------------------------------------
    ; The same three steps as the PDF renderer, and deliberately the same
    ; sources for each: SVGPathParser for the geometry, VectorViewBox for where
    ; it lands, VectorRasterizer for the fill. Anywhere this file made its own
    ; decision instead, PNG would drift from PDF and HTML again.
    ; The rotation an element asks for, about its own centre, in device space.
    ;
    ; Applies to what goes through the shared rasterizer — text and paths —
    ; which is what a chart needs for an axis label. Rectangular backgrounds
    ; still come from RasterPrimitives and are NOT rotated; rotating those
    ; means routing them through VectorShapes as paths, which is the follow-up
    ; recorded in the plan.
    fn rotationMatrix:Matrix2D (el:EVGElement x:double y:double w:double h:double) {
        if (el.rotate == 0.0) {
            return (Matrix2D.identity())
        }
        def PI:double (M_PI)
        def rad:double ((el.rotate / 180.0) * PI)
        def cs:double (cos rad)
        def sn:double (sin rad)
        ; y grows downward here, so this is clockwise on screen — the same
        ; direction CSS rotate() turns and the same one the PDF renderer emits.
        def ccx:double (x + (w / 2.0))
        def ccy:double (y + (h / 2.0))
        def ex:double ((ccx - (cs * ccx)) + (sn * ccy))
        def fy:double ((ccy - (sn * ccx)) - (cs * ccy))
        return (Matrix2D.create(cs sn (0.0 - sn) cs ex fy))
    }

    fn renderPath:void (el:EVGElement x:double y:double w:double h:double) {
        def pathData:string el.svgPath
        if ((strlen pathData) == 0) {
            return
        }

        def parser (new SVGPathParser())
        parser.parse(pathData)

        ; A malformed path still draws what it can, per SVG 1.1 §8.3 — but it
        ; says so, rather than looking like art that stops there.
        if (parser.hasErrors()) {
            print ("  Path: " + (parser.errorSummary()))
        }

        def b:PathBounds (parser.getBounds())
        def vb:ViewBoxRect (VectorViewBox.effectiveViewBox(el.viewBox b.minX b.minY b.width b.height))
        def m:Matrix2D (VectorViewBox.resolve(vb w h "xMidYMid meet"))

        ; Curve subdivision is chosen from the size the path is actually drawn
        ; at, so a big shape does not show facets and a small one does not pay
        ; for detail no pixel can show.
        def span:double w
        if (h > span) {
            span = h
        }
        def steps:int (to_int (span / 6.0))
        if (steps < 4) {
            steps = 4
        }
        if (steps > 48) {
            steps = 48
        }

        ; The transform includes the element's position, so the rings come out
        ; already in device space.
        ; viewBox transform, then the element's position, then any rotation —
        ; applied in that order so the rotation turns the shape where it sits
        ; rather than swinging it away from its box.
        def placed:Matrix2D (Matrix2D.create(m.a m.b m.c m.d (m.e + x) (m.f + y)))
        def rot:Matrix2D (this.rotationMatrix(el x y w h))
        def full:Matrix2D (rot.multiply(placed))
        def rings:[PathRing] (parser.flattenRings(steps full.a full.b full.c full.d full.e full.f))

        def buf:RasterBuffer (renderer.getBuffer())

        def fillColor:EVGColor el.fillColor
        if (fillColor.isSet == false) {
            fillColor = el.backgroundColor
        }

        if fillColor.isSet {
            ; Every ring in ONE fill: that is what makes a counter a hole
            ; instead of a second solid blob.
            def raster (new VectorRasterizer())
            def k:int 0
            while (k < (array_length rings)) {
                def ring:PathRing (itemAt rings k)
                raster.addRing(ring.pts)
                k = (k + 1)
            }

            def rule:int (VectorRasterizer.nonZero())
            if (el.fillRule == "evenodd") {
                rule = (VectorRasterizer.evenOdd())
            }

            def alpha:int (to_int (fillColor.a * 255.0))
            if (alpha > 255) {
                alpha = 255
            }
            raster.fillAA(buf (fillColor.red()) (fillColor.green()) (fillColor.blue()) alpha rule)
        }

        ; Stroke. Approximated as fillable geometry — see
        ; VectorRasterizer.addStroke. Without this an icon drawn as an outline
        ; (fill: none, stroke: ...) is simply invisible in the raster target
        ; while appearing in PDF and HTML, which is the same class of silent
        ; divergence this plan exists to remove.
        if el.strokeColor.isSet {
            if (el.strokeWidth > 0.0) {
                ; stroke-width is in user units, so it scales with the viewBox
                ; transform exactly like the geometry does.
                def scale:double m.a
                if (scale < 0.0) {
                    scale = (0.0 - scale)
                }
                def deviceWidth:double (el.strokeWidth * scale)

                def stroker (new VectorRasterizer())
                def closed:boolean (this.pathIsClosed(parser))
                ; Dash lengths are in user units like the stroke width, so they
                ; scale with the viewBox transform too — a dashed gridline keeps
                ; its rhythm when the chart is drawn larger.
                def rawDashes:[double] (VectorStroke.parseDashes(el.strokeDashArray))
                def dashes:[double] (VectorStroke.scaleDashes(rawDashes scale))
                def dashOffset:double (el.strokeDashOffset * scale)
                def sk:int 0
                while (sk < (array_length rings)) {
                    def sring:PathRing (itemAt rings sk)
                    if ((array_length dashes) > 0) {
                        stroker.addDashedStroke(sring.pts deviceWidth closed dashes dashOffset)
                    } {
                        stroker.addStroke(sring.pts deviceWidth closed)
                    }
                    sk = (sk + 1)
                }

                def sAlpha:int (to_int (el.strokeColor.a * 255.0))
                if (sAlpha > 255) {
                    sAlpha = 255
                }
                ; Always non-zero: the quads and joint discs overlap, and
                ; even-odd would punch holes where they do.
                def sRule:int (VectorRasterizer.nonZero())
                stroker.fillAA(buf (el.strokeColor.red()) (el.strokeColor.green()) (el.strokeColor.blue()) sAlpha sRule)
            }
        }
    }

    ; Whether the path's subpaths were closed with Z. A stroke follows the
    ; closing segment only if the author asked for it — an open polyline drawn
    ; with a phantom closing edge is a very visible wrong answer.
    fn pathIsClosed:boolean (parser:SVGPathParser) {
        def cmds:[PathCommand] (parser.getCommands())
        def k:int 0
        while (k < (array_length cmds)) {
            def c:PathCommand (itemAt cmds k)
            if (c.type == "Z") {
                return true
            }
            k = (k + 1)
        }
        return false
    }

    fn renderGradient:void (el:EVGElement x:double y:double w:double h:double radius:int) {
        ; Use the pre-parsed gradient from EVGElement
        def grad:EVGGradient el.gradient
        
        if (grad.isSet == false) {
            ; Fallback: no valid gradient parsed
            return
        }
        
        ; Get start and end colors
        def startColor:EVGColor (grad.getStartColor())
        def endColor:EVGColor (grad.getEndColor())
        
        def r1:int (startColor.red())
        def g1:int (startColor.green())
        def b1:int (startColor.blue())
        def r2:int (endColor.red())
        def g2:int (endColor.green())
        def b2:int (endColor.blue())
        
        if grad.isLinear {
            def angle:double grad.angle
            
            if (radius > 0) {
                renderer.renderLinearGradientRoundedRect(
                    (to_int x) (to_int y) (to_int w) (to_int h) radius angle
                    r1 g1 b1 r2 g2 b2
                )
            } {
                renderer.renderLinearGradientRect(
                    (to_int x) (to_int y) (to_int w) (to_int h) angle
                    r1 g1 b1 r2 g2 b2
                )
            }
        } {
            ; Radial gradient
            renderer.renderRadialGradientRoundedRect(
                (to_int x) (to_int y) (to_int w) (to_int h) radius
                r1 g1 b1 r2 g2 b2
            )
        }
    }
    
    ; Draw a photo into its box.
    ;
    ; `object-fit: cover` is the default a photo book wants: fill the box and
    ; crop the overflow rather than squash the picture. `fill` stretches.
    ; Sampling is nearest-neighbour, which is honest for a layout preview —
    ; the PDF path embeds the original file and the printer resamples it.
    fn renderImage:void (el:EVGElement x:double y:double w:double h:double) {
        def dstW:int (to_int w)
        def dstH:int (to_int h)
        if ((dstW < 1) || (dstH < 1)) {
            return
        }

        def img:ImageBuffer (this.loadImage(el.src))
        if ((img.width < 1) || (img.height < 1)) {
            print ("Image warning: could not read " + el.src)
            return
        }

        ; Map each destination pixel back into the source.
        def srcW:double (to_double img.width)
        def srcH:double (to_double img.height)
        def scaleX:double ((to_double dstW) / srcW)
        def scaleY:double ((to_double dstH) / srcH)
        def useScale:double scaleX
        if (el.objectFit == "fill") {
            useScale = 0.0
        } {
            ; cover: the larger scale, so neither axis is left short.
            if (scaleY > scaleX) {
                useScale = scaleY
            }
        }

        def buf:RasterBuffer (renderer.getBuffer())
        def ox:int (to_int x)
        def oy:int (to_int y)
        def dy:int 0
        while (dy < dstH) {
            def py:int (oy + dy)
            if ((py >= 0) && (py < buf.height)) {
                def dx:int 0
                while (dx < dstW) {
                    def px:int (ox + dx)
                    if ((px >= 0) && (px < buf.width)) {
                        def sx:int 0
                        def sy:int 0
                        if (useScale > 0.0) {
                            ; Centre the crop on both axes.
                            def coverW:double (srcW * useScale)
                            def coverH:double (srcH * useScale)
                            def offX:double (((to_double dstW) - coverW) / 2.0)
                            def offY:double (((to_double dstH) - coverH) / 2.0)
                            sx = (to_int (((to_double dx) - offX) / useScale))
                            sy = (to_int (((to_double dy) - offY) / useScale))
                        } {
                            sx = (to_int (((to_double dx) * srcW) / (to_double dstW)))
                            sy = (to_int (((to_double dy) * srcH) / (to_double dstH)))
                        }
                        if (sx < 0) {
                            sx = 0
                        }
                        if (sy < 0) {
                            sy = 0
                        }
                        if (sx >= img.width) {
                            sx = (img.width - 1)
                        }
                        if (sy >= img.height) {
                            sy = (img.height - 1)
                        }
                        def c:Color (img.getPixel(sx sy))
                        buf.setPixel(px py c.r c.g c.b 255)
                    }
                    dx = (dx + 1)
                }
            }
            dy = (dy + 1)
        }
    }

    ; Decode once per distinct source; a spread repeats the same file.
    fn loadImage:ImageBuffer (src:string) {
        def i:int 0
        while (i < (array_length imageCacheKeys)) {
            if ((itemAt imageCacheKeys i) == src) {
                return (itemAt imageCache i)
            }
            i = (i + 1)
        }

        def path:string (baseDir + src)
        def slash:int (0 - 1)
        def j:int 0
        while (j < (strlen path)) {
            if ((charAt path j) == 47) {
                slash = j
            }
            j = (j + 1)
        }
        def dir:string "."
        def name:string path
        if (slash >= 0) {
            dir = (substring path 0 slash)
            name = (substring path (slash + 1) (strlen path))
        }

        ; A progressive JPEG needs the other decoder. Baseline is by far the
        ; common case, but "some of the photos are simply missing" is a poor
        ; way to find out which kind you have.
        def img:ImageBuffer (this.decodeAnyJpeg(dir name))
        push imageCacheKeys src
        push imageCache img
        return img
    }

    ; Pick the decoder from the SOF marker, the way jpeg_scaler does.
    fn decodeAnyJpeg:ImageBuffer (dir:string name:string) {
        def data:buffer (buffer_read_file dir name)
        def dataLen:int (buffer_length data)
        def isProgressive:boolean false
        def i:int 0
        while (i < (dataLen - 1)) {
            if ((buffer_get data i) == 255) {
                def marker:int (buffer_get data (i + 1))
                if (marker == 194) {
                    ; SOF2
                    isProgressive = true
                    i = dataLen
                }
                if (marker == 192) {
                    ; SOF0
                    isProgressive = false
                    i = dataLen
                }
            }
            i = (i + 1)
        }
        if isProgressive {
            def pdec (new ProgressiveJPEGDecoder())
            return (pdec.decode(dir name))
        }
        def dec (new JPEGDecoder())
        return (dec.decode(dir name))
    }

    fn renderText:void (el:EVGElement x:double y:double w:double h:double padLeft:double padTop:double padRight:double) {
        ; A rotated label is the reason the rasterizer takes a transform at
        ; all: the glyph contours go through the same addEdge a path does, so
        ; the label turns by exactly the code that turns a shape.
        def rotating:boolean ((el.rotate == 0.0) == false)
        if rotating {
            def rm:Matrix2D (this.rotationMatrix(el x y w h))
            textRenderer.setTransform(rm.a rm.b rm.c rm.d rm.e rm.f)
        }

        ; Get text color
        def textR:int 0
        def textG:int 0
        def textB:int 0
        def textA:int 255
        if el.color.isSet {
            textR = (el.color.red())
            textG = (el.color.green())
            textB = (el.color.blue())
            textA = (to_int ((el.color.alpha()) * 255.0))
        }
        
        ; Get font size
        def fontSize:double 14.0 * scale
        if el.fontSize {
            if el.fontSize.isSet {
                fontSize = el.fontSize.pixels * scale
            }
        }
        if (fontSize < 1.0) {
            fontSize = 14.0 * scale
        }
        
        ; Paint with the element's OWN face. This used to ask for "Open Sans"
        ; whatever the document said, so a page set in Cinzel was measured in
        ; Cinzel and painted in Open Sans — measure and paint disagreeing on the
        ; raster target in exactly the way §4.1 rule 1 forbids.
        def faceName:string (el.effectiveFontFamily())
        if ((strlen faceName) == 0) {
            faceName = "Open Sans"
        }
        def face:TrueTypeFont (fontManager.getFont(faceName))
        if (face.unitsPerEm > 0) {
            textRenderer.setFont(face)
        }
        
        ; Render text shadow if set
        def hasShadow:boolean false
        if el.shadowColor {
            if el.shadowColor.isSet {
                hasShadow = true
            }
        }
        
        ; Break the text exactly where layout did. Without this the raster
        ; painted one long line while layout had reserved N lines of height, so
        ; a wrapped caption ran straight out of its box.
        def unscaledFont:double (fontSize / scale)
        def availW:double (((w - padLeft) - padRight) / scale)
        def engine:EVGTextEngine (layout.getTextEngine())
        def lines:[EVGTextLine] (engine.breakLines(el.textContent faceName unscaledFont availW))

        def lineHeightFactor:double el.lineHeight
        if (lineHeightFactor <= 0.0) {
            lineHeightFactor = 1.2
        }
        def lineStep:double (fontSize * lineHeightFactor)

        def li:int 0
        while (li < (array_length lines)) {
            def ln:EVGTextLine (itemAt lines li)
            def lineY:double ((y + padTop) + (lineStep * (to_double li)))
            this.renderTextLine(el ln.text (x + padLeft) lineY fontSize textR textG textB textA hasShadow)
            li = (li + 1)
        }

        ; Leave the rasterizer as it was found: the transform is per element,
        ; and a label that forgot to clear it would rotate everything drawn
        ; after it.
        if rotating {
            textRenderer.clearTransform()
        }
    }

    ; One already-broken line of text, with the element's shadow if it has one.
    fn renderTextLine:void (el:EVGElement text:string x:double y:double fontSize:double textR:int textG:int textB:int textA:int hasShadow:boolean) {
        ; Glyphs borrowed from a fallback face may be filled with their own
        ; colour: the face is monochrome outlines, so it takes whatever it is
        ; given, and `emoji-color` is how a caption asks for one that differs
        ; from the sentence it sits in.
        def ec:EVGColor (el.effectiveEmojiColor())
        textRenderer.setFallbackColor((ec.red()) (ec.green()) (ec.blue()))
        if hasShadow {
            def shadowR:int (el.shadowColor.red())
            def shadowG:int (el.shadowColor.green())
            def shadowB:int (el.shadowColor.blue())
            def shadowA:int (to_int ((el.shadowColor.alpha()) * 255.0))
            def blurRadius:int 0
            def shadowOffX:double 0.0
            def shadowOffY:double 0.0
            
            if el.shadowRadius {
                if el.shadowRadius.isSet {
                    blurRadius = (to_int (el.shadowRadius.pixels * scale))
                }
            }
            if el.shadowOffsetX {
                if el.shadowOffsetX.isSet {
                    shadowOffX = el.shadowOffsetX.pixels * scale
                }
            }
            if el.shadowOffsetY {
                if el.shadowOffsetY.isSet {
                    shadowOffY = el.shadowOffsetY.pixels * scale
                }
            }
            
            textRenderer.renderTextWithShadow(
                (renderer.getBuffer())
                text
                x y
                fontSize
                textR textG textB textA
                shadowR shadowG shadowB shadowA
                shadowOffX shadowOffY
                blurRadius
            )
        } {
            ; Render text without shadow
            textRenderer.renderText(
                (renderer.getBuffer())
                text
                x y
                fontSize
                textR textG textB textA
            )
        }
    }
}

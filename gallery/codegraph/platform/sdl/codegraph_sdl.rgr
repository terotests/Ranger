; ============================================================================
; codegraph_sdl — CodeGraph in a desktop window, SDL2 + OpenGL.
; ============================================================================
;
;   SDL event → CodeGraphApp (UiHost chrome | FlowEditor canvas)
;   display() → EVGDisplayList → EvgGlPainter → OpenGL
;
; A Ranger file is analysed through UAST after VirtualCompiler has walked
; it. C++ / TypeScript trees go through UastCpp / UastTs. Desktop Open uses
; the real disk (`CodeGraphBuilder.fromAny`) so ranger.json, `Import "pkg:…"`,
; and a folder of .hpp/.cpp files all work. In-tab examples still fill a VFS.
;
; Usage (after build.sh):
;   ./tmp/codegraph-sdl/codegraph_sdl
;   ./tmp/codegraph-sdl/codegraph_sdl gallery/codegraph/fixtures/calls.rgr
;   ./tmp/codegraph-sdl/codegraph_sdl gallery/uast/fixtures/cpp/zip_writer.hpp
;   ./tmp/codegraph-sdl/codegraph_sdl https://github.com/org/repo.git
;   SDL_VIDEODRIVER=dummy ./tmp/codegraph-sdl/codegraph_sdl --frames 20
; ============================================================================

Import "../../src/CodeGraphApp.rgr"
Import "pkg:evg/EVGTextMeasurer.rgr"
Import "../../../datagrid/platform/sdl/gfx_datagrid_sdl.rgr"
Import "../../../datagrid/platform/sdl/EvgGlPainter.rgr"

class CodeGraphSdl {
    def app:CodeGraphApp (new CodeGraphApp)
    def painter:EvgGlPainter (new EvgGlPainter)
    def tr:UITextRenderer (new UITextRenderer)
    def images:GridImages (new GridImages)

    def cssPath:string "gallery/codegraph/web"
    def cssName:string "codegraph.css"
    def fontDir:string "gallery/pdf_writer/assets/fonts"
    def openPathArg:string ""

    def pw:int 1280
    def ph:int 800
    def frames:int 0
    def hasWindow:boolean false
    def wantQuit:boolean false
    def prevDown:boolean false
    def prevX:int 0
    def prevY:int 0
    def lastMs:double 0.0

    Constructor () {
    }

    fn isRgr:boolean (name:string) {
        def n:int (strlen name)
        if (n < 4) {
            return false
        }
        return ((substring name (n - 4) n) == ".rgr")
    }

    fn skipCompiler:boolean (name:string) {
        if ((this.isRgr(name)) == false) {
            return true
        }
        if (name == "Lang.rgr") {
            return true
        }
        if ((indexOf name "test_") == 0) {
            return true
        }
        if ((indexOf name "issue_") == 0) {
            return true
        }
        if (name == "feature_tests.rgr") {
            return true
        }
        if ((indexOf name "_backup.") >= 0) {
            return true
        }
        return false
    }

    fn lastSlash:int (s:string) {
        def i:int 0
        def cut:int -1
        while (i < (strlen s)) {
            if ((charAt s i) == (ccode "/")) {
                cut = i
            }
            i = (i + 1)
        }
        return cut
    }

    fn dirOf:string (path:string) {
        def cut:int (this.lastSlash(path))
        if (cut < 0) {
            return "."
        }
        if (cut == 0) {
            return "/"
        }
        return (substring path 0 cut)
    }

    fn baseOf:string (path:string) {
        def cut:int (this.lastSlash(path))
        if (cut < 0) {
            return path
        }
        return (substring path (cut + 1) (strlen path))
    }

    fn loadText:string (dir:string name:string) {
        def t@(optional):string (read_file dir name)
        if (null? t) {
            return ""
        }
        return (unwrap t)
    }

    fn loadVfs:void () {
        def lang:string (this.loadText("compiler" "Lang.rgr"))
        if ((strlen lang) > 0) {
            app.setRootFile("Lang.rgr" lang)
        }
        def libNames:[string] (list_dir_files "lib")
        def li:int 0
        while (li < (array_length libNames)) {
            def ln:string (itemAt libNames li)
            if (this.isRgr(ln)) {
                if (ln != "shell_test.rgr") {
                    def data:string (this.loadText("lib" ln))
                    if ((strlen data) > 0) {
                        app.setLibFile(ln data)
                    }
                }
            }
            li = (li + 1)
        }
        def compNames:[string] (list_dir_files "compiler")
        def ci:int 0
        while (ci < (array_length compNames)) {
            def cn:string (itemAt compNames ci)
            if ((this.skipCompiler(cn)) == false) {
                def cdata:string (this.loadText("compiler" cn))
                if ((strlen cdata) > 0) {
                    app.setCompilerFile(cn cdata)
                }
            }
            ci = (ci + 1)
        }
        app.setExampleFile("calls.rgr" (this.loadText("gallery/codegraph/fixtures" "calls.rgr")))
        app.setExampleFile("animals.rgr" (this.loadText("gallery/codegraph/fixtures" "animals.rgr")))
        app.loadGalleryTree()
        print ("  VFS lang=" + (to_string (app.hasCompiler())) + " compiler=" + (to_string (app.hasCompilerTree())) + " gallery=" + (to_string (app.hasGalleryTree())))
    }

    fn openRangerPath:boolean (path:string) {
        if ((strlen path) == 0) {
            return false
        }
        if (CodeGraphBuilder.isGitUrl(path)) {
            print ("  clone " + path)
            app.status = ("cloning " + path + "…")
            app.refreshChrome()
            def dest:string (dgfx_clone_git path)
            if ((strlen dest) == 0) {
                ; The clone needs `git` on PATH; without it gallery/pkg's own
                ; Git client is looked for above the working directory. Say
                ; which of the two is missing rather than only that it failed.
                app.status = (("could not clone " + path) + " — install git, or run from the Ranger checkout")
                app.refreshChrome()
                print ("  " + app.status)
                return false
            }
            print ("  cloned " + dest)
            path = dest
        }
        print ("  open " + path)
        def ok:boolean (app.openDiskPath(path))
        print ("  " + (app.statusText()))
        return ok
    }

    fn pickAndOpen:void () {
        def path:string (dgfx_pick_open_any "Open a Ranger, C++, or TypeScript file")
        if ((strlen path) == 0) {
            return
        }
        this.openRangerPath(path)
    }

    fn pickGitUrl:void () {
        def url:string (dgfx_prompt_text "Git URL" "HTTPS Git repository to analyse")
        if ((strlen url) == 0) {
            return
        }
        this.openRangerPath(url)
    }

    ; Diff: two git revisions around whatever is open. "HEAD~1..HEAD" is
    ; the last commit; "HEAD~1" alone compares it with the working tree.
    fn pickDiff:void () {
        def spec:string (dgfx_prompt_text "Diff" "base..head, base (vs working tree), or a pull request # / URL — or pick commits in the rail")
        if ((strlen spec) == 0) {
            return
        }
        print ("  diff " + spec)
        app.analyzeGitDiff(spec)
        print ("  " + (app.statusText()))
    }

    fn startApp:boolean () {
        def css:string (this.loadText(cssPath cssName))
        if ((strlen css) == 0) {
            print ("  missing " + cssPath + "/" + cssName)
            return false
        }
        app.start((to_double pw) (to_double ph) css)
        app.codeTr = tr
        app.enableGit()
        this.loadVfs()
        if ((strlen openPathArg) > 0) {
            this.openRangerPath(openPathArg)
        }
        return true
    }

    fn openWindow:void () {
        def ok:int (dgfx_open "CodeGraph — Ranger call graph" pw ph)
        if (ok == 1) {
            hasWindow = true
            dgfx_install_menus
        } {
            print "  dgfx_open failed (no display?) — running headless"
        }
    }

    fn syncWindowSize:void () {
        def ww:int (dgfx_window_width)
        def wh:int (dgfx_window_height)
        if (ww < 240) {
            return
        }
        if (wh < 240) {
            return
        }
        if (ww == pw) {
            if (wh == ph) {
                return
            }
        }
        pw = ww
        ph = wh
        app.setPageSize((to_double pw) (to_double ph))
    }

    fn pumpInput:void () {
        dgfx_poll
        this.syncWindowSize()
        def menu:int (dgfx_pop_menu_action)
        if (menu == 1) {
            this.pickAndOpen()
        }
        if (menu == 4) {
            wantQuit = true
        }
        def mx:int (dgfx_mouse_x)
        def my:int (dgfx_mouse_y)
        def btn:int (dgfx_mouse_buttons)
        def down:boolean false
        if ((bit_and btn 1) != 0) {
            down = true
        }
        def shift:boolean (dgfx_shift_down)
        def ctrl:boolean (dgfx_ctrl_down)
        def px:double (to_double mx)
        def py:double (to_double my)
        if down {
            if (prevDown == false) {
                app.pointerDown(px py shift ctrl)
                if (app.consumeOpenFile()) {
                    this.pickAndOpen()
                }
                if (app.consumeOpenGitUrl()) {
                    this.pickGitUrl()
                }
                if (app.consumeOpenDiff()) {
                    this.pickDiff()
                }
            } {
                app.pointerMove(px py shift ctrl)
            }
        } {
            if prevDown {
                app.pointerUp(px py shift ctrl)
                if (app.consumeOpenFile()) {
                    this.pickAndOpen()
                }
                if (app.consumeOpenGitUrl()) {
                    this.pickGitUrl()
                }
                if (app.consumeOpenDiff()) {
                    this.pickDiff()
                }
            }
        }
        dgfx_set_cursor (app.cursorAt(px py))
        prevX = mx
        prevY = my
        prevDown = down
        def wx:double (dgfx_wheel_x_precise)
        def wy:double (dgfx_wheel_precise)
        if ((wx != 0.0) || (wy != 0.0)) {
            ; Same axis as the browser host's WheelEvent.deltaY, which is
            ; what FlowEditor and the class list already speak. dgfx un-flips
            ; SDL_MOUSEWHEEL_FLIPPED (macOS natural scrolling) back to NORMAL:
            ; positive Y is away from the user. WheelEvent uses the same
            ; words for +deltaY — "away from the user" / scroll down — so a
            ; two-finger swipe that drags the content with the fingers in
            ; the tab does the same here. Inverting Y made the SDL window
            ; run the opposite way of the web host.
            ;
            ; Trackpad preciseY carries speed; a wheel notch is ~1.0 and
            ; becomes a 100 px line delta.
            def lineMode:boolean (CodeGraphSdl.wheelIsLine(wx wy))
            def scale:double 40.0
            if lineMode {
                scale = 100.0
            }
            def dx:double (wx * scale)
            def dy:double (wy * scale)
            if (app.inCanvas(px py)) {
                app.wheelGesture((app.localX(px)) (app.localY(py)) dx dy ctrl lineMode)
            } {
                app.wheel(px py dy)
            }
        }
        def text:string (dgfx_take_text)
        if ((strlen text) > 0) {
            ; SDL sends Ctrl+letter as text with the modifier still held —
            ; that is the only way Ctrl+F reaches the source pane's find bar.
            app.typeTextWith(text ctrl)
            def clip:string (app.consumeClipboardText())
            if ((strlen clip) > 0) {
                dgfx_set_clipboard_text clip
            }
        }
        def k:int (dgfx_pop_key)
        while (k != 0) {
            this.handleKey(k shift ctrl)
            k = (dgfx_pop_key)
        }
    }

    sfn wheelIsLine:boolean (dx:double dy:double) {
        if ((fabs dx) > 0.0001) {
            return false
        }
        def whole:double (to_double (to_int dy))
        if ((fabs (dy - whole)) > 0.0001) {
            return false
        }
        if ((fabs dy) < 0.99) {
            return false
        }
        return true
    }

    fn handleKey:void (k:int shift:boolean ctrl:boolean) {
        if (k == 4) {
            if (this.sampleSelOpen()) {
                app.keyWith("Escape" false false)
                return
            }
            ; Escape closes the find bar before it closes the window.
            if ((strlen (app.findStatus())) > 0) {
                app.keyWith("Escape" shift ctrl)
                return
            }
            wantQuit = true
            return
        }
        if (k == 2) {
            app.keyWith("Enter" shift ctrl)
            return
        }
        if (k == 1) {
            app.keyWith("Backspace" shift ctrl)
            return
        }
        if (k == 5) {
            app.keyWith("ArrowLeft" shift ctrl)
            return
        }
        if (k == 6) {
            app.keyWith("ArrowRight" shift ctrl)
            return
        }
        if (k == 9) {
            app.keyWith("Delete" shift ctrl)
            return
        }
        if (k == 10) {
            app.keyWith("Home" shift ctrl)
            return
        }
        if (k == 11) {
            app.keyWith("End" shift ctrl)
            return
        }
    }

    fn sampleSelOpen:boolean () {
        return app.sampleSel.open
    }

    fn drawFrame:void () {
        def now:double (wall_clock_ms)
        def dt:double 16.0
        if (lastMs > 0.0) {
            dt = (now - lastMs)
        }
        lastMs = now
        app.tick(dt)
        def dl:EVGDisplayList (app.display())
        if hasWindow {
            painter.draw(dl pw ph tr images)
        }
        frames = (frames + 1)
    }

    fn run:int (maxFrames:int) {
        painter.fontFamily = "Noto Sans"
        if ((this.startApp()) == false) {
            return 1
        }
        this.openWindow()
        def running:boolean true
        while (running) {
            this.pumpInput()
            this.drawFrame()
            if (dgfx_should_close) {
                running = false
            }
            if wantQuit {
                running = false
            }
            if (maxFrames > 0) {
                if (frames >= maxFrames) {
                    running = false
                }
            }
            if hasWindow {
                dgfx_delay 16
            }
        }
        if hasWindow {
            dgfx_close
        }
        print ("  " + (app.statusText()) + " · " + (app.stats()) + " · frames=" + (to_string frames))
        return 0
    }

    sfn openFaces:UITextRenderer (fontDir:string) {
        def tr (new UITextRenderer)
        tr.addFontDir(fontDir)
        def family:string "Noto Sans"
        def dir:string "Noto_Sans"
        def reg:buffer (buffer_read_file (fontDir + "/" + dir) "NotoSans-Regular.ttf")
        if ((buffer_length reg) == 0) {
            print ("  missing face in " + fontDir)
            return tr
        }
        tr.loadFontBytes(family reg)
        CodeGraphSdl.relabel(tr family "Regular")
        def bld:buffer (buffer_read_file (fontDir + "/" + dir) "NotoSans-Bold.ttf")
        if ((buffer_length bld) > 0) {
            tr.addFaceBytes(bld)
            CodeGraphSdl.relabel(tr family "Bold")
        }
        tr.fontFamily = family
        tr.applyFace()
        EVGDefaultMeasurer.install(tr.measurer)
        return tr
    }

    sfn relabel:void (tr:UITextRenderer family:string style:string) {
        def n:int (array_length tr.fm.fonts)
        if (n == 0) {
            return
        }
        def f:TrueTypeFont (itemAt tr.fm.fonts (n - 1))
        f.fontFamily = family
        f.fontStyle = style
    }

    sfn isNumber:boolean (a:string) {
        if ((strlen a) == 0) {
            return false
        }
        def i:int 0
        while (i < (strlen a)) {
            def ch:int (charAt a i)
            if (ch < 48) {
                return false
            }
            if (ch > 57) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    sfn beforeX:int (text:string fallback:int) {
        def n:int (strlen text)
        def i:int 0
        while (i < n) {
            if ((substring text i (i + 1)) == "x") {
                def a:string (substring text 0 i)
                if (CodeGraphSdl.isNumber(a)) {
                    return (?? (str2int a) fallback)
                }
                return fallback
            }
            i = (i + 1)
        }
        return fallback
    }

    sfn afterX:int (text:string fallback:int) {
        def n:int (strlen text)
        def i:int 0
        while (i < n) {
            if ((substring text i (i + 1)) == "x") {
                def a:string (substring text (i + 1) n)
                if (CodeGraphSdl.isNumber(a)) {
                    return (?? (str2int a) fallback)
                }
                return fallback
            }
            i = (i + 1)
        }
        return fallback
    }

    sfn main:void () {
        print "== CodeGraph — SDL2 / OpenGL =="
        def fontDir:string "gallery/pdf_writer/assets/fonts"
        def maxFrames:int 0
        def w:int 1280
        def h:int 800
        def path:string ""
        def i:int 0
        def n:int (shell_arg_cnt)
        while (i < n) {
            def a:string (shell_arg i)
            if (a == "--frames") {
                i = (i + 1)
                def fa:string (shell_arg i)
                maxFrames = (?? (str2int fa) 0)
            } {
                if (a == "--size") {
                    i = (i + 1)
                    def s:string (shell_arg i)
                    w = (CodeGraphSdl.beforeX(s w))
                    h = (CodeGraphSdl.afterX(s h))
                } {
                    if (a == "--fonts") {
                        i = (i + 1)
                        fontDir = (shell_arg i)
                    } {
                        if ((indexOf a "--") != 0) {
                            path = a
                        }
                    }
                }
            }
            i = (i + 1)
        }
        def tr:UITextRenderer (CodeGraphSdl.openFaces(fontDir))
        def host (new CodeGraphSdl)
        host.tr = tr
        host.pw = w
        host.ph = h
        host.fontDir = fontDir
        host.openPathArg = path
        def code:int (host.run(maxFrames))
        if (code != 0) {
            exit 1
        }
    }
}

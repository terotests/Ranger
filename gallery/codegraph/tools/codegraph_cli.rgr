; ============================================================================
; codegraph_cli.rgr — analyse a .rgr file and print / draw its call graph.
; ============================================================================
;
;   npm run codegraph:analyze -- gallery/codegraph/fixtures/calls.rgr
;   npm run codegraph:analyze -- gallery/uast/fixtures/cpp
;   npm run codegraph:analyze -- tests/fixtures/pkg/app
;   npm run codegraph:analyze -- compiler/ng_RangerAppClassDesc.rgr --max=24
;   npm run codegraph:analyze -- https://github.com/org/repo.git
;
; A compiler fragment (ng_RangerAppClassDesc.rgr and its siblings) has no
; Import of the types it names. VirtualCompiler already loads those classes
; for itself, through ng_RangerFlowParser; compiling the fragment as a
; program does not. This CLI compiles that parser unit and filters to the
; file you named.
; ============================================================================

Import "../src/CodeGraphBuilder.rgr"
Import "../src/CodeGraphFlow.rgr"
Import "../src/CodeGraphGit.rgr"
Import "../../rangerflow/export/FlowExport.rgr"

class CodeGraphCli {
    sfn main:void () {
        if ((shell_arg_cnt) < 1) {
            print "usage: codegraph_cli <file.rgr|dir|ranger.json|file.hpp> [--max=N] [--filter=substr] [--page=id] [--diff=base..head] [--pr=N|url]"
            return
        }
        def file:string (shell_arg 0)
        def maxNodes:int 24
        def filter:string ""
        def pageId:string "overview:0"
        def diffSpec:string ""
        def i:int 1
        while (i < (shell_arg_cnt)) {
            def a:string (shell_arg i)
            if ((indexOf a "--max=") == 0) {
                def raw:string (substring a 6 (strlen a))
                maxNodes = (?? (str2int raw) 24)
            }
            if ((indexOf a "--filter=") == 0) {
                filter = (substring a 9 (strlen a))
            }
            if ((indexOf a "--page=") == 0) {
                pageId = (substring a 7 (strlen a))
            }
            if ((indexOf a "--diff=") == 0) {
                diffSpec = (substring a 7 (strlen a))
            }
            if ((indexOf a "--pr=") == 0) {
                diffSpec = (substring a 5 (strlen a))
            }
            i = (i + 1)
        }
        if ((strlen diffSpec) > 0) {
            CodeGraphCli.runDiff(file diffSpec maxNodes pageId)
            return
        }
        def model:CodeGraph (new CodeGraph)
        if (CodeGraphCli.isCompilerFragment(file)) {
            def base:string (CodeGraphCli.baseName(file))
            def entry:string "compiler/ng_RangerFlowParser.rgr"
            if ((strlen filter) == 0) {
                filter = base
            }
            print ((file + " is a compiler fragment — types live in sibling files."))
            print (("compiling " + entry) + " and keeping classes from " + filter)
            model = (CodeGraphBuilder.keepFromFile(entry filter))
            model.title = file
        } {
            print ("analysing " + file)
            model = (CodeGraphBuilder.fromAny(file))
        }
        if ((indexOf model.title " FAIL ") >= 0) {
            print ("compilation failed: " + model.title)
            if (CodeGraphCli.isCompilerFragment(file)) {
                print "a compiler fragment is not a standalone program; this CLI compiles compiler/ng_RangerFlowParser.rgr for those files"
            }
            exit 1
        }
        if ((model.classCount()) == 0) {
            print ("no classes in " + file)
            exit 1
        }
        print (("  classes " + (to_string (model.classCount()))) + ", methods " + (to_string (model.methodCount())))
        def session:CodeGraphSession (CodeGraphSession.of(model maxNodes))
        if (pageId != "overview:0") {
            session.goTo(pageId)
        }
        print ("  page    " + session.pageId)
        CodeGraphCli.draw(session)
    }

    ; --diff=base..head: both revisions of `file` through git worktrees,
    ; the change per class and member on the console, and the diff
    ; summary page as SVG.
    sfn runDiff:void (file:string spec:string maxNodes:int pageId:string) {
        print ((("comparing " + spec) + " around ") + file)
        def git (new CodeGraphGit)
        def session:CodeGraphSession (new CodeGraphSession)
        if (CodeGraphGit.isPullRequestSpec(spec)) {
            session = (git.diffPullRequest(file spec maxNodes))
        } {
            session = (git.diffSession(file spec maxNodes))
        }
        if ((session.model.classCount()) == 0) {
            print ("diff failed: " + git.lastError)
            exit 1
        }
        def d:CodeGraphDiff session.diff
        print ("  " + d.label + ": " + (d.describe()))
        print (("  files   " + (to_string (array_length git.changedFiles))) + " changed in git, " + (to_string (array_length d.changedFiles)) + " with classes")
        def i:int 0
        while (i < (array_length d.summary)) {
            def name:string (itemAt d.summary i)
            def st:string (d.statusOfClass(name))
            print (("  " + (CodeGraphCli.mark(st))) + " " + name)
            if (st == "changed") {
                CodeGraphCli.printMembers(session.model d name)
            }
            i = (i + 1)
        }
        if (pageId != "overview:0") {
            session.goTo(pageId)
        }
        print ("  page    " + session.pageId)
        CodeGraphCli.draw(session)
    }

    sfn printMembers:void (m:CodeGraph d:CodeGraphDiff name:string) {
        def c:CodeClass (m.classByName(name))
        def fi:int 0
        while (fi < (array_length c.fields)) {
            def f:CodeField (itemAt c.fields fi)
            def fs:string (d.statusOfField(name f.name))
            if ((strlen fs) > 0) {
                print ((("      " + (CodeGraphCli.mark(fs))) + " ") + f.name + ":" + f.fieldType)
            }
            fi = (fi + 1)
        }
        def mi:int 0
        while (mi < (array_length c.methodIds)) {
            def mid:string (itemAt c.methodIds mi)
            def ms:string (d.statusOfMethod(mid))
            if ((strlen ms) > 0) {
                def meth:CodeMethod (m.methodById(mid))
                print ((("      " + (CodeGraphCli.mark(ms))) + " ") + (meth.signature()))
            }
            mi = (mi + 1)
        }
    }

    sfn mark:string (status:string) {
        if (status == "added") {
            return "+"
        }
        if (status == "removed") {
            return "-"
        }
        if (status == "changed") {
            return "~"
        }
        return " "
    }

    sfn draw:void (session:CodeGraphSession) {
        print ("  " + session.status)
        def g:FlowGraph (session.graph())
        print (("  drawn   " + (to_string (g.nodeCount()))) + " nodes, " + (to_string (g.edgeCount())) + " edges")
        def v:FlowView (FlowView.of(g))
        v.notation = "uml"
        def ex (new FlowExport)
        ex.mode = "fit"
        ex.padding = 24.0
        if ((dir_exists "gallery/codegraph/out") == false) {
            create_dir "gallery/codegraph/out"
        }
        ex.writeSvg(v "gallery/codegraph/out/codegraph.svg")
        ex.writeEvgJson(v "gallery/codegraph/out/codegraph.evg.json")
        print "  wrote   gallery/codegraph/out/codegraph.svg"
        print "  wrote   gallery/codegraph/out/codegraph.evg.json"
    }

    sfn baseName:string (file:string) {
        def parts:[string] (strsplit file "/")
        def n:int (array_length parts)
        if (n == 0) {
            return file
        }
        return (itemAt parts (n - 1))
    }

    sfn isCompleteCompilerProgram:boolean (file:string) {
        def b:string (CodeGraphCli.baseName(file))
        if (b == "ng_Compiler.rgr") {
            return true
        }
        if (b == "VirtualCompiler.rgr") {
            return true
        }
        if (b == "ng_RangerFlowParser.rgr") {
            return true
        }
        if (b == "ng_LiveCompiler.rgr") {
            return true
        }
        return false
    }

    sfn isCompilerFragment:boolean (file:string) {
        if ((indexOf file "compiler/") < 0) {
            return false
        }
        if (CodeGraphCli.isCompleteCompilerProgram(file)) {
            return false
        }
        return true
    }
}

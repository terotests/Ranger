; ============================================================================
; CodeGraphBuilderTest.rgr — the compiler's call graph, as a CodeGraph.
; ============================================================================
;
; Runs VirtualCompiler over fixtures/calls.rgr and a few gallery libraries
; (css, zip, evg) so the explorer's extra examples stay honest.
;
;   npm run codegraph:builder
; ============================================================================

Import "../src/CodeGraphBuilder.rgr"
Import "../src/CodeGraphPages.rgr"
Import "../src/CodeGraphGit.rgr"
Import "../src/CodeGraphFlow.rgr"

class CodeGraphBuilderTest {
    sfn main:void () {
        def env:InputEnv (new InputEnv())
        env.use_real = true
        env.setEnv("RANGER_LIB" "./compiler/;./lib/;./compiler")
        def params:CmdParams (new CmdParams())
        push params.values "gallery/codegraph/fixtures/calls.rgr"
        set params.params "l" "es6"
        set params.params "o" "codegraph_builder_ignored.js"
        set params.flags "no-color" true
        env.commandLine = params
        def vc:VirtualCompiler (new VirtualCompiler())
        def res:CompilerResults (vc.run(env))
        if res.hasErrors {
            print ("compilation failed: " + res.errorMessage)
            exit 1
        }
        def ctx@(optional):RangerAppWriterContext res.ctx
        if (null? ctx) {
            print "no compiler context"
            exit 1
        }
        def appCtx:RangerAppWriterContext (unwrap ctx)
        def b (new CodeGraphBuilder)
        b.fileFilter = "calls.rgr"
        def g:CodeGraph (b.fromContext(appCtx))
        def failed:int 0
        if ((g.hasClass("Order")) == false) {
            print "  FAIL Order class missing"
            failed = (failed + 1)
        }
        if ((g.hasClass("LineItem")) == false) {
            print "  FAIL LineItem class missing"
            failed = (failed + 1)
        }
        if ((g.hasMethod("Order.total")) == false) {
            print "  FAIL Order.total missing"
            failed = (failed + 1)
        }
        if ((g.hasMethod("LineItem.lineTotal")) == false) {
            print "  FAIL LineItem.lineTotal missing"
            failed = (failed + 1)
        }
        if (g.hasMethod("Order.total")) {
            def m:CodeMethod (g.methodById("Order.total"))
            def found:boolean false
            def i:int 0
            while (i < (array_length m.calls)) {
                if ((itemAt m.calls i) == "LineItem.lineTotal") {
                    found = true
                }
                i = (i + 1)
            }
            if (found == false) {
                print "  FAIL Order.total does not call LineItem.lineTotal"
                print ("    calls: " + (join m.calls ", "))
                failed = (failed + 1)
            }
            def usesItem:boolean false
            def u:int 0
            while (u < (array_length m.uses)) {
                if ((itemAt m.uses u) == "LineItem") {
                    usesItem = true
                }
                u = (u + 1)
            }
            if (usesItem == false) {
                print "  FAIL Order.total does not record LineItem as a used type"
                print ("    uses: " + (join m.uses ", "))
                failed = (failed + 1)
            }
        }
        if (g.hasClass("Order")) {
            def oc:CodeClass (g.classByName("Order"))
            if ((indexOf oc.fileName "calls.rgr") < 0) {
                print ("  FAIL Order.fileName " + oc.fileName)
                failed = (failed + 1)
            }
            if (oc.startLine < 1) {
                print ("  FAIL Order.startLine " + (to_string oc.startLine))
                failed = (failed + 1)
            }
            ; The compiler read calls.rgr; the graph carries what it read, so
            ; the viewer never has to find that path on disk a second time.
            def src:string (g.sourceOf(oc.fileName))
            if ((indexOf src "class Order") < 0) {
                print ("  FAIL calls.rgr source not carried (" + (to_string (strlen src)) + " chars)")
                failed = (failed + 1)
            }
        }
        if (g.hasMethod("Order.total")) {
            def tot:CodeMethod (g.methodById("Order.total"))
            if (tot.startLine < 1) {
                print ("  FAIL Order.total.startLine " + (to_string tot.startLine))
                failed = (failed + 1)
            }
        }
        def pages:CodeGraphPages (CodeGraphPages.of(g 24))
        def overview:CodePage (pages.pageOf("overview:0"))
        if ((overview.itemCount()) > 24) {
            print "  FAIL overview exceeded the cap"
            failed = (failed + 1)
        }
        print (("classes " + (to_string (g.classCount()))) + ", methods " + (to_string (g.methodCount())))
        failed = (failed + (CodeGraphBuilderTest.checkLib("gallery/css/CssCore.rgr" "CssSheet" "EVGColor")))
        failed = (failed + (CodeGraphBuilderTest.checkLib("gallery/zip/zip_tool.rgr" "ZipReader" "Inflate")))
        failed = (failed + (CodeGraphBuilderTest.checkLib("gallery/evg/EVGElement.rgr" "EVGElement" "EVGBox")))
        failed = (failed + (CodeGraphBuilderTest.checkDataGrid()))
        failed = (failed + (CodeGraphBuilderTest.checkPkg()))
        failed = (failed + (CodeGraphBuilderTest.checkOpenRgrFile()))
        failed = (failed + (CodeGraphBuilderTest.checkOpenTs()))
        failed = (failed + (CodeGraphBuilderTest.checkOpenCpp()))
        failed = (failed + (CodeGraphBuilderTest.checkOpenCppWalk()))
        failed = (failed + (CodeGraphBuilderTest.checkOpenCppLib()))
        failed = (failed + (CodeGraphBuilderTest.checkFixtureDiff()))
        failed = (failed + (CodeGraphBuilderTest.checkGitDiff()))
        if (failed > 0) {
            print (("failed " + (to_string failed)))
            exit 1
        }
        print "passed builder walk"
    }

    ; Compile a gallery library and require two classes on the graph.
    sfn checkLib:int (path:string a:string b:string) {
        print ("== " + path)
        def g:CodeGraph (CodeGraphBuilder.fromFile(path))
        if ((indexOf g.title " FAIL ") >= 0) {
            print ("  FAIL " + g.title)
            return 1
        }
        def n:int 0
        if ((g.hasClass(a)) == false) {
            print (("  FAIL " + a) + " missing from " + path)
            n = (n + 1)
        }
        if ((g.hasClass(b)) == false) {
            print (("  FAIL " + b) + " missing from " + path)
            n = (n + 1)
        }
        print (("  classes " + (to_string (g.classCount()))) + ", methods " + (to_string (g.methodCount())))
        return n
    }

    ; Open DataGrid must keep imported classes (SheetView.model, not an empty
    ; type stub). The explorer leaves fileFilter empty for the same reason.
    sfn checkDataGrid:int () {
        print "== gallery/datagrid/src/DataGrid.rgr"
        def n:int 0
        def g:CodeGraph (CodeGraphBuilder.fromFile("gallery/datagrid/src/DataGrid.rgr"))
        if ((indexOf g.title " FAIL ") >= 0) {
            print ("  FAIL " + g.title)
            return 1
        }
        if ((g.hasClass("DataGrid")) == false) {
            print "  FAIL DataGrid missing"
            n = (n + 1)
        }
        if ((g.hasClass("SheetView")) == false) {
            print "  FAIL SheetView missing from DataGrid Import closure"
            n = (n + 1)
        }
        if ((g.hasClass("SpreadsheetModel")) == false) {
            print "  FAIL SpreadsheetModel missing from DataGrid Import closure"
            n = (n + 1)
        }
        if (g.hasClass("SheetView")) {
            def sv:CodeClass (g.classByName("SheetView"))
            def foundModel:boolean false
            def fi:int 0
            while (fi < (array_length sv.fields)) {
                def f:CodeField (itemAt sv.fields fi)
                if (f.name == "model") {
                    foundModel = true
                    if (f.fieldType != "SpreadsheetModel") {
                        print ("  FAIL SheetView.model type " + f.fieldType)
                        n = (n + 1)
                    }
                }
                fi = (fi + 1)
            }
            if (foundModel == false) {
                print "  FAIL SheetView.model field missing"
                n = (n + 1)
            }
        }
        print (("  classes " + (to_string (g.classCount()))) + ", methods " + (to_string (g.methodCount())))
        return n
    }

    ; ranger.json + Import "pkg:util" must keep Greeter (the package) and
    ; LocalMark (a ./ relative file) on the same graph as PkgApp.
    sfn checkPkg:int () {
        print "== tests/fixtures/pkg/app (pkg: + ranger.json)"
        def n:int 0
        if (CodeGraphBuilder.isGitUrl("https://github.com/terotests/Ranger.git") == false) {
            print "  FAIL https Git URL not recognised"
            n = (n + 1)
        }
        if (CodeGraphBuilder.isGitUrl("git@github.com:terotests/Ranger.git") == false) {
            print "  FAIL git@ URL not recognised"
            n = (n + 1)
        }
        if (CodeGraphBuilder.isGitUrl("tests/fixtures/pkg/app/App.rgr")) {
            print "  FAIL local path treated as Git URL"
            n = (n + 1)
        }
        def g:CodeGraph (CodeGraphBuilder.fromPath("tests/fixtures/pkg/app"))
        if ((indexOf g.title " FAIL ") >= 0) {
            print ("  FAIL " + g.title)
            return (n + 1)
        }
        if ((g.hasClass("PkgApp")) == false) {
            print "  FAIL PkgApp missing"
            n = (n + 1)
        }
        if ((g.hasClass("Greeter")) == false) {
            print "  FAIL Greeter missing from pkg:util"
            n = (n + 1)
        }
        if ((g.hasClass("LocalMark")) == false) {
            print "  FAIL LocalMark missing from ./Local.rgr"
            n = (n + 1)
        }
        def viaJson:CodeGraph (CodeGraphBuilder.fromPath("tests/fixtures/pkg/app/ranger.json"))
        if ((indexOf viaJson.title " FAIL ") >= 0) {
            print ("  FAIL ranger.json " + viaJson.title)
            n = (n + 1)
        } {
            if ((viaJson.hasClass("Greeter")) == false) {
                print "  FAIL ranger.json path missed Greeter"
                n = (n + 1)
            }
        }
        def viaRgr:CodeGraph (CodeGraphBuilder.fromPath("tests/fixtures/pkg/app/App.rgr"))
        if ((indexOf viaRgr.title " FAIL ") >= 0) {
            print ("  FAIL App.rgr " + viaRgr.title)
            n = (n + 1)
        } {
            if ((viaRgr.hasClass("Greeter")) == false) {
                print "  FAIL App.rgr fromPath missed pkg:util Greeter"
                n = (n + 1)
            }
        }
        print (("  classes " + (to_string (g.classCount()))) + ", methods " + (to_string (g.methodCount())))
        return n
    }

    ; Opening a .rgr must not demand ranger.json. dir_exists(file) is true
    ; on the native SDL target, which used to send calls.rgr through fromDir.
    sfn checkOpenRgrFile:int () {
        print "== fromPath gallery/codegraph/fixtures/calls.rgr (no ranger.json)"
        def n:int 0
        def g:CodeGraph (CodeGraphBuilder.fromPath("gallery/codegraph/fixtures/calls.rgr"))
        if ((indexOf g.title " FAIL ") >= 0) {
            print ("  FAIL " + g.title)
            return 1
        }
        if ((indexOf g.title "no ranger.json") >= 0) {
            print "  FAIL a .rgr file required ranger.json"
            n = (n + 1)
        }
        if ((g.hasClass("Order")) == false) {
            print "  FAIL Order missing from calls.rgr"
            n = (n + 1)
        }
        if ((g.hasClass("LineItem")) == false) {
            print "  FAIL LineItem missing from calls.rgr"
            n = (n + 1)
        }
        print (("  classes " + (to_string (g.classCount()))) + ", methods " + (to_string (g.methodCount())))
        return n
    }

    sfn checkOpenTs:int () {
        print "== fromAny gallery/uast/fixtures (TypeScript)"
        def n:int 0
        def g:CodeGraph (CodeGraphBuilder.fromAny("gallery/uast/fixtures"))
        if ((indexOf g.title " FAIL ") >= 0) {
            print ("  FAIL " + g.title)
            return 1
        }
        if ((g.hasClass("ZipWriter")) == false) {
            print "  FAIL ZipWriter missing from TypeScript fixtures"
            n = (n + 1)
        }
        if ((g.hasClass("CRC32")) == false) {
            print "  FAIL CRC32 missing from TypeScript fixtures"
            n = (n + 1)
        }
        print (("  classes " + (to_string (g.classCount()))) + ", methods " + (to_string (g.methodCount())))
        return n
    }

    sfn checkOpenCpp:int () {
        print "== fromAny gallery/uast/fixtures/cpp (C++)"
        def n:int 0
        def fileG:CodeGraph (CodeGraphBuilder.fromAny("gallery/uast/fixtures/cpp/zip_writer.hpp"))
        if ((indexOf fileG.title " FAIL ") >= 0) {
            print ("  FAIL " + fileG.title)
            return 1
        }
        if ((fileG.hasClass("ZipWriter")) == false) {
            print "  FAIL ZipWriter missing from zip_writer.hpp"
            n = (n + 1)
        }
        if ((fileG.hasClass("CRC32")) == false) {
            print "  FAIL CRC32 missing from zip_writer.hpp"
            n = (n + 1)
        }
        if (fileG.hasClass("ZipWriter")) {
            def zw:CodeClass (fileG.classByName("ZipWriter"))
            if (zw.startLine != 16) {
                print ("  FAIL ZipWriter.startLine " + (to_string zw.startLine))
                n = (n + 1)
            }
            if ((indexOf zw.fileName "zip_writer.hpp") < 0) {
                print ("  FAIL ZipWriter.fileName " + zw.fileName)
                n = (n + 1)
            }
        }
        if (fileG.hasMethod("ZipWriter.addFile")) {
            def add:CodeMethod (fileG.methodById("ZipWriter.addFile"))
            if (add.startLine != 23) {
                print ("  FAIL ZipWriter.addFile.startLine " + (to_string add.startLine))
                n = (n + 1)
            }
        }
        print (("  file classes " + (to_string (fileG.classCount()))) + ", methods " + (to_string (fileG.methodCount())))
        def dirG:CodeGraph (CodeGraphBuilder.fromAny("gallery/uast/fixtures/cpp"))
        if ((indexOf dirG.title " FAIL ") >= 0) {
            print ("  FAIL dir " + dirG.title)
            return (n + 1)
        }
        if ((dirG.hasClass("ZipWriter")) == false) {
            print "  FAIL ZipWriter missing from C++ fixtures dir"
            n = (n + 1)
        }
        if ((dirG.hasClass("Child")) == false) {
            print "  FAIL Child missing from C++ fixtures dir"
            n = (n + 1)
        }
        print (("  dir classes " + (to_string (dirG.classCount()))) + ", methods " + (to_string (dirG.methodCount())))
        return n
    }

    ; What a C++ library looked like on the chart before the frontend knew
    ; about export macros and out-of-line members: an empty `LibDocument`
    ; next to boxes called `LibDocument::Accept`, each holding a `render()`.
    sfn checkOpenCppLib:int () {
        print "== fromAny gallery/uast/fixtures/cpp_lib (export macro, .cpp members)"
        def n:int 0
        def g:CodeGraph (CodeGraphBuilder.fromAny("gallery/uast/fixtures/cpp_lib"))
        if ((indexOf g.title " FAIL ") >= 0) {
            print ("  FAIL " + g.title)
            return 1
        }
        if ((g.hasClass("LibDocument")) == false) {
            print "  FAIL LibDocument missing"
            n = (n + 1)
        }
        if (g.hasClass("LIB_API")) {
            print "  FAIL the export macro became a class"
            n = (n + 1)
        }
        if (g.hasClass("LibDocument::Accept")) {
            print "  FAIL the out-of-line definition became a class"
            n = (n + 1)
        }
        if (g.hasClass("LibDocument")) {
            def doc:CodeClass (g.classByName("LibDocument"))
            def text:string (g.sourceOf(doc.fileName))
            if ((indexOf text "class LIB_API LibDocument") < 0) {
                print ("  FAIL lib.h source not carried (" + (to_string (strlen text)) + " chars)")
                n = (n + 1)
            }
            if ((indexOf doc.fileName "lib.h") < 0) {
                print ("  FAIL LibDocument.fileName " + doc.fileName)
                n = (n + 1)
            }
            if ((doc.extendsName) != "LibNode") {
                print ("  FAIL LibDocument extends " + doc.extendsName)
                n = (n + 1)
            }
            if ((CodeGraphBuilderTest.hasMethodNamed(g doc "Accept")) == false) {
                print "  FAIL LibDocument.Accept missing"
                n = (n + 1)
            }
            if ((CodeGraphBuilderTest.hasMethodNamed(g doc "Depth")) == false) {
                print "  FAIL LibDocument.Depth missing"
                n = (n + 1)
            }
            if (CodeGraphBuilderTest.hasMethodNamed(g doc "render")) {
                print "  FAIL LibDocument has a React render()"
                n = (n + 1)
            }
            if ((array_length doc.methodIds) != 2) {
                print ("  FAIL LibDocument methods " + (to_string (array_length doc.methodIds)))
                n = (n + 1)
            }
        }
        if (g.hasClass("LibNode")) {
            def node:CodeClass (g.classByName("LibNode"))
            if ((CodeGraphBuilderTest.hasMethodNamed(g node "Print")) == false) {
                print "  FAIL LibNode.Print missing"
                n = (n + 1)
            }
            def printer:boolean false
            def i:int 0
            while (i < (array_length node.methodIds)) {
                def m:CodeMethod (g.methodById((itemAt node.methodIds i)))
                def u:int 0
                while (u < (array_length m.uses)) {
                    if ((itemAt m.uses u) == "LibPrinter") {
                        printer = true
                    }
                    u = (u + 1)
                }
                i = (i + 1)
            }
            if (printer == false) {
                print "  FAIL LibNode does not use LibPrinter"
                n = (n + 1)
            }
        }
        print (("  classes " + (to_string (g.classCount()))) + ", methods " + (to_string (g.methodCount())))
        return n
    }

    sfn hasMethodNamed:boolean (g:CodeGraph c:CodeClass name:string) {
        def i:int 0
        while (i < (array_length c.methodIds)) {
            def m:CodeMethod (g.methodById((itemAt c.methodIds i)))
            if (m.name == name) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; calls.rgr against calls_v2.rgr, both through VirtualCompiler: the
    ; statuses the fixture's comment promises, and the merged graph that
    ; still knows the class the change removed.
    sfn checkFixtureDiff:int () {
        print "== diff fixtures/calls.rgr → fixtures/calls_v2.rgr"
        def n:int 0
        def base:CodeGraph (CodeGraphBuilder.fromFile("gallery/codegraph/fixtures/calls.rgr"))
        def head:CodeGraph (CodeGraphBuilder.fromFile("gallery/codegraph/fixtures/calls_v2.rgr"))
        if ((indexOf base.title " FAIL ") >= 0) {
            print ("  FAIL " + base.title)
            return 1
        }
        if ((indexOf head.title " FAIL ") >= 0) {
            print ("  FAIL " + head.title)
            return 1
        }
        CodeGraphGit.renameFile(base "gallery/codegraph/fixtures/calls.rgr" "gallery/codegraph/fixtures/calls_v2.rgr")
        def d:CodeGraphDiff (CodeGraphDiff.compare(base head))
        print ("  " + (d.describe()))
        n = (n + (CodeGraphBuilderTest.expectStatus("Receipt" (d.statusOfClass("Receipt")) "added")))
        n = (n + (CodeGraphBuilderTest.expectStatus("CodeGraphFixtureMain" (d.statusOfClass("CodeGraphFixtureMain")) "removed")))
        n = (n + (CodeGraphBuilderTest.expectStatus("LineItem" (d.statusOfClass("LineItem")) "changed")))
        n = (n + (CodeGraphBuilderTest.expectStatus("Order" (d.statusOfClass("Order")) "changed")))
        n = (n + (CodeGraphBuilderTest.expectStatus("Checkout" (d.statusOfClass("Checkout")) "changed")))
        n = (n + (CodeGraphBuilderTest.expectStatus("LineItem.price" (d.statusOfField("LineItem" "price")) "added")))
        n = (n + (CodeGraphBuilderTest.expectStatus("LineItem.qty" (d.statusOfField("LineItem" "qty")) "")))
        n = (n + (CodeGraphBuilderTest.expectStatus("LineItem.lineTotal (body)" (d.statusOfMethod("LineItem.lineTotal")) "changed")))
        n = (n + (CodeGraphBuilderTest.expectStatus("Order.discount" (d.statusOfField("Order" "discount")) "added")))
        n = (n + (CodeGraphBuilderTest.expectStatus("Order.count" (d.statusOfMethod("Order.count")) "added")))
        n = (n + (CodeGraphBuilderTest.expectStatus("Order.total (body)" (d.statusOfMethod("Order.total")) "changed")))
        n = (n + (CodeGraphBuilderTest.expectStatus("Order.addItem untouched" (d.statusOfMethod("Order.addItem")) "")))
        n = (n + (CodeGraphBuilderTest.expectStatus("Checkout.pay (returns Receipt)" (d.statusOfMethod("Checkout.pay")) "changed")))
        n = (n + (CodeGraphBuilderTest.expectStatus("CodeGraphFixtureMain.main" (d.statusOfMethod("CodeGraphFixtureMain.main")) "removed")))
        def m:CodeGraph (d.merged())
        if ((m.hasClass("CodeGraphFixtureMain")) == false) {
            print "  FAIL merged graph dropped CodeGraphFixtureMain"
            n = (n + 1)
        }
        ; The removed main() still points at Checkout, so Checkout's page
        ; shows it as a (red) rose box: the reverse "uses" link.
        def session:CodeGraphSession (CodeGraphSession.ofDiff(base head "fixture" 24))
        session.goTo("class:Checkout")
        def g:FlowGraph (session.graph())
        if ((g.hasNode("CodeGraphFixtureMain")) == false) {
            print "  FAIL Checkout page has no CodeGraphFixtureMain backref"
            n = (n + 1)
        }
        def ld:LineDiffResult (d.fileDiffOf("gallery/codegraph/fixtures/calls_v2.rgr"))
        if ((ld.changed()) == false) {
            print "  FAIL no line diff for the fixture"
            n = (n + 1)
        }
        print (("  lines   +" + (to_string ld.added)) + " −" + (to_string ld.removed))
        return n
    }

    sfn expectStatus:int (what:string got:string want:string) {
        if (got == want) {
            return 0
        }
        print ((((("  FAIL " + what) + ": got '") + got) + "' want '") + want + "'")
        return 1
    }

    ; A throwaway repository with the two fixtures as two commits, diffed
    ; through git worktrees: HEAD~1..HEAD and HEAD~1 against the working
    ; tree. Skipped without git on PATH.
    sfn checkGitDiff:int () {
        print "== git diff HEAD~1..HEAD in a temp repository"
        if ((CodeGraphGit.isInstalled()) == false) {
            print "  skip: no git on PATH"
            return 0
        }
        def sh (new Shell)
        def repo:string "gallery/codegraph/out/gitdiff-repo"
        def rmArgs:[string]
        push rmArgs "-rf"
        push rmArgs repo
        sh.capture("rm" rmArgs)
        create_dir repo
        def v1@(optional):string (read_file "gallery/codegraph/fixtures" "calls.rgr")
        def v2@(optional):string (read_file "gallery/codegraph/fixtures" "calls_v2.rgr")
        if ((null? v1) || (null? v2)) {
            print "  FAIL fixtures unreadable"
            return 1
        }
        sh.cwd = repo
        if ((CodeGraphBuilderTest.git(sh "init" "-q" "" "")) == false) {
            print "  FAIL git init"
            return 1
        }
        CodeGraphBuilderTest.git(sh "config" "user.email" "codegraph@test" "")
        CodeGraphBuilderTest.git(sh "config" "user.name" "codegraph" "")
        write_file repo "app.rgr" (unwrap v1)
        CodeGraphBuilderTest.git(sh "add" "app.rgr" "" "")
        CodeGraphBuilderTest.git(sh "commit" "-q" "-m" "v1")
        write_file repo "app.rgr" (unwrap v2)
        CodeGraphBuilderTest.git(sh "add" "app.rgr" "" "")
        CodeGraphBuilderTest.git(sh "commit" "-q" "-m" "v2")
        def n:int 0
        def git (new CodeGraphGit)
        def s:CodeGraphSession (git.diffSession((repo + "/app.rgr") "HEAD~1..HEAD" 24))
        if ((s.model.classCount()) == 0) {
            print ("  FAIL " + git.lastError)
            return 1
        }
        print ("  " + s.diff.label + ": " + (s.diff.describe()))
        n = (n + (CodeGraphBuilderTest.expectStatus("git: Receipt" (s.diff.statusOfClass("Receipt")) "added")))
        n = (n + (CodeGraphBuilderTest.expectStatus("git: CodeGraphFixtureMain" (s.diff.statusOfClass("CodeGraphFixtureMain")) "removed")))
        n = (n + (CodeGraphBuilderTest.expectStatus("git: Order.total" (s.diff.statusOfMethod("Order.total")) "changed")))
        if ((array_length git.changedFiles) != 1) {
            print ("  FAIL git diff --name-only listed " + (to_string (array_length git.changedFiles)) + " files")
            n = (n + 1)
        }
        if (s.pageId != "diff:0") {
            print ("  FAIL git diff session opened on " + s.pageId)
            n = (n + 1)
        }
        if (dir_exists (repo + "/.git/codegraph-diff")) {
            def leftovers:[string] (list_dir_files (repo + "/.git/codegraph-diff"))
            if ((array_length leftovers) > 0) {
                print "  FAIL a worktree was left behind under .git/codegraph-diff"
                n = (n + 1)
            }
        }
        if (git.lastHead != (git.fullSha(repo "HEAD"))) {
            print "  FAIL lastHead is not HEAD"
            n = (n + 1)
        }
        ; The working tree, edited but not committed, against HEAD.
        write_file repo "app.rgr" (unwrap v1)
        def w:CodeGraphSession (git.diffSession((repo + "/app.rgr") "HEAD" 24))
        if ((w.model.classCount()) == 0) {
            print ("  FAIL working tree: " + git.lastError)
            return (n + 1)
        }
        n = (n + (CodeGraphBuilderTest.expectStatus("worktree: CodeGraphFixtureMain back" (w.diff.statusOfClass("CodeGraphFixtureMain")) "added")))
        n = (n + (CodeGraphBuilderTest.expectStatus("worktree: Receipt gone" (w.diff.statusOfClass("Receipt")) "removed")))
        if ((strlen git.lastHead) != 0) {
            print "  FAIL lastHead of a working-tree diff is not empty"
            n = (n + 1)
        }
        write_file repo "app.rgr" (unwrap v2)

        ; The log, as a picker sees it.
        print "== git log as commit choices"
        def log:[GitCommitInfo] (git.commits(repo 10))
        if ((array_length log) != 2) {
            print ("  FAIL commits() listed " + (to_string (array_length log)))
            n = (n + 1)
        } {
            def top:GitCommitInfo (itemAt log 0)
            if (top.subject != "v2") {
                print ("  FAIL newest commit first: " + top.subject)
                n = (n + 1)
            }
            if ((strlen top.sha) != 40) {
                print ("  FAIL full sha: " + top.sha)
                n = (n + 1)
            }
            if ((indexOf (top.label()) top.short) != 0) {
                print ("  FAIL label starts with the short sha: " + (top.label()))
                n = (n + 1)
            }
        }

        ; A pull request: a bare origin whose master is v1 and whose
        ; refs/pull/1/head is v2 — what GitHub serves for PR #1.
        print "== pull request #1 from a bare origin"
        n = (n + (CodeGraphBuilderTest.checkPullSpecs()))
        def origin:string "gallery/codegraph/out/gitdiff-origin"
        def rmO:[string]
        push rmO "-rf"
        push rmO origin
        sh.cwd = ""
        sh.capture("rm" rmO)
        def bare (new Shell)
        def initArgs:[string]
        push initArgs "init"
        push initArgs "-q"
        push initArgs "--bare"
        push initArgs origin
        if ((bare.capture("git" initArgs)).failed()) {
            print "  FAIL git init --bare"
            return (n + 1)
        }
        sh.cwd = repo
        CodeGraphBuilderTest.git(sh "remote" "add" "origin" "../gitdiff-origin")
        CodeGraphBuilderTest.git(sh "push" "-q" "origin" "HEAD~1:refs/heads/master")
        CodeGraphBuilderTest.git(sh "push" "-q" "origin" "HEAD:refs/pull/1/head")
        CodeGraphBuilderTest.git(sh "fetch" "-q" "origin" "")
        CodeGraphBuilderTest.git(sh "remote" "set-head" "origin" "master")
        def pr:CodeGraphSession (git.diffPullRequest((repo + "/app.rgr") "#1" 24))
        if ((pr.model.classCount()) == 0) {
            print ("  FAIL " + git.lastError)
            return (n + 1)
        }
        print ("  " + pr.diff.label + ": " + (pr.diff.describe()))
        if ((indexOf pr.diff.label "PR #1") != 0) {
            print ("  FAIL PR label: " + pr.diff.label)
            n = (n + 1)
        }
        n = (n + (CodeGraphBuilderTest.expectStatus("PR: Receipt" (pr.diff.statusOfClass("Receipt")) "added")))
        n = (n + (CodeGraphBuilderTest.expectStatus("PR: CodeGraphFixtureMain" (pr.diff.statusOfClass("CodeGraphFixtureMain")) "removed")))
        n = (n + (CodeGraphBuilderTest.expectStatus("PR: Order.total" (pr.diff.statusOfMethod("Order.total")) "changed")))
        if (git.prBase != (git.fullSha(repo "HEAD~1"))) {
            print "  FAIL PR base is not the merge base (v1)"
            n = (n + 1)
        }
        if (git.prHead != (git.fullSha(repo "HEAD"))) {
            print "  FAIL PR head is not v2"
            n = (n + 1)
        }
        ; The URL spelling resolves the same PR.
        def prUrl:CodeGraphSession (git.diffPullRequest((repo + "/app.rgr") "https://github.com/terotests/Ranger/pull/1/files" 24))
        if ((prUrl.model.classCount()) == 0) {
            print ("  FAIL PR by URL: " + git.lastError)
            n = (n + 1)
        }
        def missing:CodeGraphSession (git.diffPullRequest((repo + "/app.rgr") "999" 24))
        if ((missing.model.classCount()) != 0) {
            print "  FAIL PR 999 should not resolve"
            n = (n + 1)
        }
        if ((indexOf git.lastError "999") < 0) {
            print ("  FAIL PR 999 error names it: " + git.lastError)
            n = (n + 1)
        }
        return n
    }

    sfn checkPullSpecs:int () {
        def n:int 0
        n = (n + (CodeGraphBuilderTest.expectStatus("number of #12" (CodeGraphGit.pullNumberOf("#12")) "12")))
        n = (n + (CodeGraphBuilderTest.expectStatus("number of 7" (CodeGraphGit.pullNumberOf("7")) "7")))
        n = (n + (CodeGraphBuilderTest.expectStatus("number of a PR URL" (CodeGraphGit.pullNumberOf("https://github.com/o/r/pull/123/files?diff=split")) "123")))
        n = (n + (CodeGraphBuilderTest.expectStatus("number of a GitLab MR URL" (CodeGraphGit.pullNumberOf("https://gitlab.com/g/p/-/merge_requests/5")) "5")))
        n = (n + (CodeGraphBuilderTest.expectStatus("slug of a PR URL" (CodeGraphGit.slugOfUrl("https://github.com/o/r/pull/123")) "o/r")))
        n = (n + (CodeGraphBuilderTest.expectStatus("slug of a GitLab MR URL" (CodeGraphGit.slugOfUrl("https://gitlab.com/g/p/-/merge_requests/5")) "g/p")))
        n = (n + (CodeGraphBuilderTest.expectStatus("slug of a number" (CodeGraphGit.slugOfUrl("12")) "")))
        if (CodeGraphGit.isPullRequestSpec("HEAD~1..HEAD")) {
            print "  FAIL a..b is not a PR"
            n = (n + 1)
        }
        if (CodeGraphGit.isPullRequestSpec("HEAD~1")) {
            print "  FAIL HEAD~1 is not a PR"
            n = (n + 1)
        }
        if ((CodeGraphGit.isPullRequestSpec("42")) == false) {
            print "  FAIL 42 is a PR"
            n = (n + 1)
        }
        if ((CodeGraphGit.isPullRequestSpec("https://github.com/o/r/pull/42")) == false) {
            print "  FAIL a PR URL is a PR"
            n = (n + 1)
        }
        return n
    }

    sfn git:boolean (sh:Shell a:string b:string c:string d:string) {
        def argv:[string]
        push argv a
        if ((strlen b) > 0) {
            push argv b
        }
        if ((strlen c) > 0) {
            push argv c
        }
        if ((strlen d) > 0) {
            push argv d
        }
        def res:ShellResult (sh.capture("git" argv))
        return (res.ok())
    }

    ; Autotools INSTALL next to include/ used to make list_dir_files throw.
    sfn checkOpenCppWalk:int () {
        print "== fromAny gallery/uast/fixtures/cpp_walk (INSTALL file)"
        def n:int 0
        def g:CodeGraph (CodeGraphBuilder.fromAny("gallery/uast/fixtures/cpp_walk"))
        if ((indexOf g.title " FAIL ") >= 0) {
            print ("  FAIL " + g.title)
            return 1
        }
        if ((g.hasClass("WalkBox")) == false) {
            print "  FAIL WalkBox missing from cpp_walk"
            n = (n + 1)
        }
        print (("  classes " + (to_string (g.classCount()))) + ", methods " + (to_string (g.methodCount())))
        return n
    }
}

; ============================================================================
; CodeGraphAppTest.rgr — Full EVG chrome around the shop fixture.
; ============================================================================
;
; Does not wait on a live VirtualCompiler analyse. The builder suite still
; walks fixtures/calls.rgr; this checks the EVG shell: layout, display list,
; Native Open gives an absolute path, so `Import "../../docx_viewer/src/X.rgr"`
; has to collapse `..` without dropping the leading `/`. `./foo.rgr` and
; `script/Bar.rgr` are rewritten to basenames because the VFS has no subdirs.
; Import prep still misses some names; InputFileResolver is the host callback
; mergeImports consults when the memory tree does not have the file.
;
;   npm run codegraph:app
; ============================================================================

Import "../src/CodeGraphApp.rgr"

class CodeGraphAppTest {
    sfn main:void () {
        def failed:int 0
        def css@(optional):string (read_file "gallery/codegraph/web" "codegraph.css")
        if (null? css) {
            print "  FAIL missing gallery/codegraph/web/codegraph.css"
            exit 1
        }
        def app (new CodeGraphApp)
        app.start(1200.0 800.0 (unwrap css))
        if ((app.pageId()) != "uml:0") {
            print ("  FAIL start page " + (app.pageId()))
            failed = (failed + 1)
        }
        def dl:EVGDisplayList (app.display())
        if ((array_length dl.cmds) < 20) {
            print ("  FAIL display list too small: " + (to_string (array_length dl.cmds)))
            failed = (failed + 1)
        }
        if (app.canvasW < 100.0) {
            print ("  FAIL canvas width " + (to_string app.canvasW))
            failed = (failed + 1)
        }
        if ((app.splitCount()) != 3) {
            print ("  FAIL split panels " + (to_string (app.splitCount())))
            failed = (failed + 1)
        } {
            def railSize:double (app.splitSizeAt(0))
            app.split.resizeBy(0 8.0)
            app.dressSplit()
            if ((app.splitSizeAt(0)) <= railSize) {
                print ("  FAIL split.resizeBy did not grow the rail")
                failed = (failed + 1)
            }
            def afterSplit:EVGDisplayList (app.display())
            def srcHit:string (app.hitId((app.canvasX + app.canvasW + 2.0) (app.canvasY + 20.0)))
            if ((app.isSplitSep(srcHit)) == false) {
                if ((indexOf srcHit "cg-split-sep") < 0) {
                    print ("  FAIL graph|source separator hit " + srcHit)
                    failed = (failed + 1)
                }
            }
        }
        app.revealAt("gallery/codegraph/fixtures/calls.rgr" 14)
        def shown:string (app.codeView.text())
        if ((indexOf shown "class Order") < 0) {
            print "  FAIL revealAt calls.rgr did not load Order"
            failed = (failed + 1)
        }
        if (app.codeView.sel.caret.line != 14) {
            print ("  FAIL revealAt caret line " + (to_string app.codeView.sel.caret.line))
            failed = (failed + 1)
        }
        def deep:string ""
        def di:int 0
        while (di < 80) {
            deep = (deep + (("fn m" + (to_string di)) + ":void () {\n"))
            deep = (deep + "    return\n")
            deep = (deep + "}\n")
            di = (di + 1)
        }
        app.setUserFile("Deep.rgr" deep)
        app.revealAt("Deep.rgr" 90)
        def jumpDl:EVGDisplayList (app.display())
        if (app.codeView.sel.caret.line != 90) {
            print ("  FAIL deep caret line " + (to_string app.codeView.sel.caret.line))
            failed = (failed + 1)
        }
        def firstVis:int (app.codeView.layout.firstVisible())
        if (firstVis > 90) {
            print ("  FAIL method line is above the source pane, first=" + (to_string firstVis))
            failed = (failed + 1)
        }
        if (firstVis < 85) {
            print ("  FAIL method body is not at the top after select, first=" + (to_string firstVis))
            failed = (failed + 1)
        }
        def lastVis:int (app.codeView.layout.lastVisible(app.codeView.buf))
        if (lastVis <= 90) {
            print ("  FAIL method body is below the fold, last=" + (to_string lastVis))
            failed = (failed + 1)
        }
        if ((app.press("cg-class-filter-text")) == false) {
            print "  FAIL press search placeholder"
            failed = (failed + 1)
        }
        if ((app.focusedField()) != "cg-class-filter") {
            print ("  FAIL search click focused " + (app.focusedField()))
            failed = (failed + 1)
        }
        if ((app.typeText("x")) == false) {
            print "  FAIL type into search after clicking the placeholder"
            failed = (failed + 1)
        }
        app.setClassFilter("")
        if ((app.press("cg-sample-value")) == false) {
            print "  FAIL press example value label"
            failed = (failed + 1)
        }
        if (app.sampleSel.open == false) {
            print "  FAIL example select did not open"
            failed = (failed + 1)
        }
        app.sampleSel.closeList()
        if (app.graph.hasNode("Order")) {
            if (app.editor.view.viewport.zoom < 0.99) {
                print ("  FAIL UML zoom is " + (to_string app.editor.view.viewport.zoom))
                failed = (failed + 1)
            }
        } {
            print "  FAIL shop UML has no Order"
            failed = (failed + 1)
        }
        if (app.editor.view.showControls == false) {
            print "  FAIL the floating zoom bar is off"
            failed = (failed + 1)
        }
        def z0:double app.editor.view.viewport.zoom
        def plusX:double ((app.editor.view.controlToolLeft(2)) + ((app.editor.view.controlToolWidth(2)) * 0.5))
        def plusY:double ((app.editor.view.controlToolTop()) + 14.0)
        app.pointerDown((app.canvasX + plusX) (app.canvasY + plusY) false false)
        app.pointerUp((app.canvasX + plusX) (app.canvasY + plusY) false false)
        if (app.editor.view.viewport.zoom <= z0) {
            print ("  FAIL floating + did not zoom (still " + (to_string app.editor.view.viewport.zoom) + ")")
            failed = (failed + 1)
        }
        app.fitView()
        def hit:string (app.hitId(20.0 20.0))
        if ((strlen hit) == 0) {
            print "  FAIL header hit test empty"
            failed = (failed + 1)
        }
        if ((app.openClass("Order")) == false) {
            print "  FAIL openClass Order"
            failed = (failed + 1)
        }
        if ((app.pageId()) != "class:Order") {
            print ("  FAIL after openClass " + (app.pageId()))
            failed = (failed + 1)
        }
        def names:string (app.classList())
        if ((indexOf names "Order") < 0) {
            print "  FAIL class list missing Order"
            failed = (failed + 1)
        }
        def addrAt:int (indexOf names "Address")
        def orderAt:int (indexOf names "Order")
        if (addrAt < 0) {
            print "  FAIL class list missing Address"
            failed = (failed + 1)
        }
        if (orderAt < addrAt) {
            print "  FAIL class list is not alphabetical"
            failed = (failed + 1)
        }
        if ((app.press("cg-class-filter")) == false) {
            print "  FAIL focus class search"
            failed = (failed + 1)
        }
        if ((app.typeText("ord")) == false) {
            print "  FAIL type into class search"
            failed = (failed + 1)
        }
        def filtered:string (app.classList())
        if ((indexOf filtered "Order") < 0) {
            print "  FAIL search missed Order"
            failed = (failed + 1)
        }
        if ((indexOf filtered "Address") >= 0) {
            print "  FAIL search still lists Address"
            failed = (failed + 1)
        }
        app.setClassFilter("")
        if ((app.loadSample("many")) == false) {
            print "  FAIL loadSample many"
            failed = (failed + 1)
        }
        def ignoreDl:EVGDisplayList (app.display())
        if ((app.classScrollEl.maxScrollTop()) <= 0.0) {
            print "  FAIL class list has no scrollbar room"
            failed = (failed + 1)
        }
        if (app.classScrollEl.overflow != "auto") {
            print ("  FAIL class list overflow " + app.classScrollEl.overflow)
            failed = (failed + 1)
        }
        ; +deltaY is the browser / SDL NORMAL axis: away from the user,
        ; content follows a finger moving up. The SDL host used to negate it.
        def top0:double app.classScrollEl.scrollTop
        app.wheel(20.0 400.0 80.0)
        def scrolledDl:EVGDisplayList (app.display())
        if (app.classScrollEl.scrollTop <= top0) {
            print ("  FAIL class list +deltaY did not scroll down, top=" + (to_string app.classScrollEl.scrollTop))
            failed = (failed + 1)
        }
        def thumbs:string (scrolledDl.thumbsJson())
        if ((indexOf thumbs "\"w\":") < 0) {
            print ("  FAIL class list has no scrollbar thumb " + thumbs)
            failed = (failed + 1)
        }
        def vy0:double app.editor.view.viewport.y
        app.wheelGesture(40.0 40.0 0.0 24.0 false false)
        if (app.editor.view.viewport.y >= vy0) {
            print ("  FAIL canvas +deltaY did not pan with the fingers, y=" + (to_string app.editor.view.viewport.y))
            failed = (failed + 1)
        }
        app.loadSample("shop")

        ; The `code` button puts the source pane away and gives its width to
        ; the chart, and gives it back on the next press.
        def srcShare:double (app.splitSizeAt(2))
        if ((app.setSourceVisible(false)) == false) {
            print "  FAIL hiding the source pane did nothing"
            failed = (failed + 1)
        }
        if ((app.splitSizeAt(2)) > 0.01) {
            print ("  FAIL source pane still " + (to_string (app.splitSizeAt(2))) + "%")
            failed = (failed + 1)
        }
        if (app.sourceVisible()) {
            print "  FAIL source pane reports itself visible while hidden"
            failed = (failed + 1)
        }
        app.setSourceVisible(true)
        if (((app.splitSizeAt(2)) - srcShare) > 0.01) {
            print ("  FAIL source pane came back at " + (to_string (app.splitSizeAt(2))) + "%")
            failed = (failed + 1)
        }
        if (((app.splitSizeAt(2)) - srcShare) < -0.01) {
            print ("  FAIL source pane came back at " + (to_string (app.splitSizeAt(2))) + "%")
            failed = (failed + 1)
        }

        ; Ctrl+F is the source pane's find bar, not a class filter.
        app.openClass("Order")
        if ((app.typeTextWith("f" true)) == false) {
            print "  FAIL Ctrl+F did not open the find bar"
            failed = (failed + 1)
        }
        if ((strlen (app.findStatus())) == 0) {
            print "  FAIL no find status while the bar is up"
            failed = (failed + 1)
        }
        app.typeTextWith("x" false)
        if ((indexOf (app.findStatus()) "x") < 0) {
            print ("  FAIL typing did not reach the query: " + (app.findStatus()))
            failed = (failed + 1)
        }
        app.keyWith("Escape" false false)
        if ((strlen (app.findStatus())) > 0) {
            print "  FAIL Escape left the find bar up"
            failed = (failed + 1)
        }

        ; A click on a method row reads it in the source pane; it does not
        ; leave the class for a page about that one method. Double-click does.
        app.openClass("Order")
        if (app.graph.hasNode("Order")) {
            def on:FlowNode (app.graph.nodeById("Order"))
            def rowY:double 0.0
            def rowMid:string ""
            def probe:double (on.y + on.headerHeight)
            while (probe < (on.y + on.height)) {
                def r:int (app.editor.rowAtPoint(on probe))
                if (r >= 0) {
                    def cand:string (app.session.pages.methodIdAtRow("Order" r))
                    if ((strlen cand) > 0) {
                        if ((strlen rowMid) == 0) {
                            rowMid = cand
                            rowY = probe
                        }
                    }
                }
                probe = (probe + 2.0)
            }
            if ((strlen rowMid) == 0) {
                print "  FAIL no method row on the Order box"
                failed = (failed + 1)
            } {
                def sx:double (app.editor.view.viewport.toScreenX((on.centerX())))
                def sy:double (app.editor.view.viewport.toScreenY(rowY))
                app.graphDown((app.canvasX + sx) (app.canvasY + sy) false false)
                app.graphUp((app.canvasX + sx) (app.canvasY + sy) false false)
                if ((app.pageId()) != "class:Order") {
                    print ("  FAIL a method row click left the class page: " + (app.pageId()))
                    failed = (failed + 1)
                }
                ; And the second click on the same row still drills in.
                app.graphDown((app.canvasX + sx) (app.canvasY + sy) false false)
                app.graphUp((app.canvasX + sx) (app.canvasY + sy) false false)
                if ((app.pageId()) != ("method:" + rowMid)) {
                    print ("  FAIL a method row double-click went to " + (app.pageId()))
                    failed = (failed + 1)
                }
                app.openClass("Order")
            }
        }

        ; A class name double-clicked in the source opens that class.
        app.goOverview()
        if ((app.openWord("LineItem*")) == false) {
            print "  FAIL openWord LineItem*"
            failed = (failed + 1)
        }
        if ((app.pageId()) != "class:LineItem") {
            print ("  FAIL openWord went to " + (app.pageId()))
            failed = (failed + 1)
        }
        if (app.openWord("notAClassName")) {
            print "  FAIL openWord took a word that is not a class"
            failed = (failed + 1)
        }

        app.loadSample("shop")
        def nav:string (app.selfTest())
        if ((indexOf nav "PASS") != 0) {
            print ("  FAIL selfTest " + nav)
            failed = (failed + 1)
        } {
            print ("  " + nav)
        }

        def rw:string (app.rewriteRelativeImports("Import \"../evg/EVGColor.rgr\"\nImport \"Foo.rgr\"\n"))
        if ((indexOf rw "Import \"EVGColor.rgr\"") < 0) {
            print ("  FAIL rewrite missed ../evg: " + rw)
            failed = (failed + 1)
        }
        if ((indexOf rw "Import \"../evg/EVGColor.rgr\"") >= 0) {
            print "  FAIL rewrite left ../evg path"
            failed = (failed + 1)
        }
        if ((indexOf rw "Import \"Foo.rgr\"") < 0) {
            print "  FAIL rewrite dropped a same-dir Import"
            failed = (failed + 1)
        }
        def rw2:string (app.rewriteRelativeImports("Import \"./rgba_fast_blit.rgr\"\nImport \"script/ScriptPreview.rgr\"\nImport \"SheetTable.rgr\"\n"))
        if ((indexOf rw2 "Import \"rgba_fast_blit.rgr\"") < 0) {
            print ("  FAIL rewrite missed ./rgba: " + rw2)
            failed = (failed + 1)
        }
        if ((indexOf rw2 "Import \"./rgba_fast_blit.rgr\"") >= 0) {
            print "  FAIL rewrite left ./rgba path"
            failed = (failed + 1)
        }
        if ((indexOf rw2 "Import \"ScriptPreview.rgr\"") < 0) {
            print ("  FAIL rewrite missed script/: " + rw2)
            failed = (failed + 1)
        }
        if ((indexOf rw2 "Import \"script/ScriptPreview.rgr\"") >= 0) {
            print "  FAIL rewrite left script/ path"
            failed = (failed + 1)
        }
        if ((indexOf rw2 "Import \"SheetTable.rgr\"") < 0) {
            print "  FAIL rewrite dropped a bare Import"
            failed = (failed + 1)
        }
        if ((app.collapsePath("gallery/css/../evg/EVGColor.rgr")) != "gallery/evg/EVGColor.rgr") {
            print ("  FAIL collapsePath " + (app.collapsePath("gallery/css/../evg/EVGColor.rgr")))
            failed = (failed + 1)
        }
        def mdRel:string (app.joinPath("gallery/markdown/src" "../../docx_viewer/src/RichDocument.rgr"))
        if (mdRel != "gallery/docx_viewer/src/RichDocument.rgr") {
            print ("  FAIL joinPath ../.. relative " + mdRel)
            failed = (failed + 1)
        }
        def mdAbs:string (app.joinPath("/Users/x/Ranger/gallery/markdown/src" "../../docx_viewer/src/RichDocument.rgr"))
        if (mdAbs != "/Users/x/Ranger/gallery/docx_viewer/src/RichDocument.rgr") {
            print ("  FAIL joinPath ../.. absolute " + mdAbs)
            failed = (failed + 1)
        }

        def disk (new CodeGraphApp)
        disk.start(800.0 600.0 (unwrap css))
        if ((disk.ingestDiskTree("gallery/css/CssCore.rgr")) == false) {
            print "  FAIL ingestDiskTree CssCore.rgr"
            failed = (failed + 1)
        } {
            if ((disk.hasUserFile("CssCore.rgr")) == false) {
                print "  FAIL ingest missed CssCore.rgr"
                failed = (failed + 1)
            }
            if ((disk.hasUserFile("EVGColor.rgr")) == false) {
                print "  FAIL ingest missed EVGColor.rgr from ../evg"
                failed = (failed + 1)
            }
            if ((disk.hasUserFile("EVGUnit.rgr")) == false) {
                print "  FAIL ingest missed EVGUnit.rgr from ../evg"
                failed = (failed + 1)
            }
            def cssSrc:string (disk.userFileText("CssCore.rgr"))
            if ((indexOf cssSrc "Import \"../evg/EVGColor.rgr\"") >= 0) {
                print "  FAIL ingested CssCore still has ../evg Import"
                failed = (failed + 1)
            }
            if ((indexOf cssSrc "Import \"EVGColor.rgr\"") < 0) {
                print "  FAIL ingested CssCore missing rewritten EVGColor Import"
                failed = (failed + 1)
            }
            print ("  ingest CssCore → " + (to_string (disk.userFileCount())) + " user files")
        }

        def md (new CodeGraphApp)
        md.start(800.0 600.0 (unwrap css))
        if ((md.ingestDiskTree("gallery/markdown/src/MdToDocx.rgr")) == false) {
            print "  FAIL ingestDiskTree MdToDocx.rgr"
            failed = (failed + 1)
        } {
            if ((md.hasUserFile("RichDocument.rgr")) == false) {
                print "  FAIL ingest missed RichDocument.rgr from ../../docx_viewer"
                failed = (failed + 1)
            }
            if ((md.hasUserFile("Vfs.rgr")) == false) {
                print "  FAIL ingest missed Vfs.rgr from ../../vfs"
                failed = (failed + 1)
            }
            def mdSrc:string (md.userFileText("MdToDocx.rgr"))
            if ((indexOf mdSrc "Import \"RichDocument.rgr\"") < 0) {
                print "  FAIL ingested MdToDocx missing rewritten RichDocument Import"
                failed = (failed + 1)
            }
            print ("  ingest MdToDocx → " + (to_string (md.userFileCount())) + " user files")
        }

        def absApp (new CodeGraphApp)
        absApp.start(800.0 600.0 (unwrap css))
        def absPath:string ((current_directory) + "/gallery/markdown/src/MdToDocx.rgr")
        if ((absApp.ingestDiskTree(absPath)) == false) {
            print ("  FAIL ingestDiskTree absolute MdToDocx " + absPath)
            failed = (failed + 1)
        } {
            if ((absApp.hasUserFile("RichDocument.rgr")) == false) {
                print "  FAIL absolute ingest missed RichDocument.rgr"
                failed = (failed + 1)
            }
            if ((absApp.hasUserFile("Vfs.rgr")) == false) {
                print "  FAIL absolute ingest missed Vfs.rgr"
                failed = (failed + 1)
            }
            print ("  ingest abs MdToDocx → " + (to_string (absApp.userFileCount())) + " user files")
        }

        def deck (new CodeGraphApp)
        deck.start(800.0 600.0 (unwrap css))
        def absDeck:string ((current_directory) + "/gallery/markdown/src/MdDeckSync.rgr")
        if ((deck.ingestDiskTree(absDeck)) == false) {
            print "  FAIL ingestDiskTree absolute MdDeckSync.rgr"
            failed = (failed + 1)
        } {
            if ((deck.hasUserFile("PptxModel.rgr")) == false) {
                print "  FAIL absolute ingest missed PptxModel.rgr"
                failed = (failed + 1)
            }
            print ("  ingest abs MdDeckSync → " + (to_string (deck.userFileCount())) + " user files")
        }

        def fb (new CodeGraphApp)
        fb.start(800.0 600.0 (unwrap css))
        if ((fb.ingestDiskTree("gallery/game_engine/framebuffer.rgr")) == false) {
            print "  FAIL ingestDiskTree framebuffer.rgr"
            failed = (failed + 1)
        } {
            if ((fb.hasUserFile("rgba_fast_blit.rgr")) == false) {
                print "  FAIL ingest missed rgba_fast_blit.rgr from ./"
                failed = (failed + 1)
            }
            def fbSrc:string (fb.userFileText("framebuffer.rgr"))
            if ((indexOf fbSrc "Import \"./rgba_fast_blit.rgr\"") >= 0) {
                print "  FAIL ingested framebuffer still has ./ Import"
                failed = (failed + 1)
            }
            if ((indexOf fbSrc "Import \"rgba_fast_blit.rgr\"") < 0) {
                print "  FAIL ingested framebuffer missing rewritten rgba Import"
                failed = (failed + 1)
            }
            print ("  ingest framebuffer → " + (to_string (fb.userFileCount())) + " user files")
        }

        def wb (new CodeGraphApp)
        wb.start(800.0 600.0 (unwrap css))
        if ((wb.ingestDiskTree("gallery/datagrid/src/WorkbookModel.rgr")) == false) {
            print "  FAIL ingestDiskTree WorkbookModel.rgr"
            failed = (failed + 1)
        } {
            if ((wb.hasUserFile("GridScript.rgr")) == false) {
                print "  FAIL ingest missed GridScript.rgr from script/"
                failed = (failed + 1)
            }
            def wbSrc:string (wb.userFileText("WorkbookModel.rgr"))
            if ((indexOf wbSrc "Import \"script/GridScript.rgr\"") >= 0) {
                print "  FAIL ingested WorkbookModel still has script/ Import"
                failed = (failed + 1)
            }
            if ((indexOf wbSrc "Import \"GridScript.rgr\"") < 0) {
                print "  FAIL ingested WorkbookModel missing rewritten GridScript Import"
                failed = (failed + 1)
            }
            print ("  ingest WorkbookModel → " + (to_string (wb.userFileCount())) + " user files")
        }

        def vl (new CodeGraphApp)
        vl.start(800.0 600.0 (unwrap css))
        if ((vl.ingestDiskTree("gallery/vela/src/VlEvgList.rgr")) == false) {
            print "  FAIL ingestDiskTree VlEvgList.rgr"
            failed = (failed + 1)
        } {
            if ((vl.hasUserFile("VlCommand.rgr")) == false) {
                print "  FAIL ingest missed VlCommand.rgr"
                failed = (failed + 1)
            }
            if ((vl.hasUserFile("VlShape.rgr")) == false) {
                print "  FAIL ingest missed VlShape.rgr"
                failed = (failed + 1)
            }
            if ((vl.hasUserFile("PathBuilder.rgr")) == false) {
                print "  FAIL ingest missed PathBuilder.rgr from ../../evg"
                failed = (failed + 1)
            }
            if ((vl.hasUserFile("SVGPathParser.rgr")) == false) {
                print "  FAIL ingest missed SVGPathParser.rgr from ../../evg"
                failed = (failed + 1)
            }
            if ((vl.hasUserFile("EVGDisplayList.rgr")) == false) {
                print "  FAIL ingest missed EVGDisplayList.rgr from ../../evg"
                failed = (failed + 1)
            }
            if ((vl.hasUserFile("EVGColor.rgr")) == false) {
                print "  FAIL ingest missed EVGColor.rgr from ../../evg"
                failed = (failed + 1)
            }
            if ((vl.hasUserFile("UITextRenderer.rgr")) == false) {
                print "  FAIL ingest missed UITextRenderer.rgr from ../../game_engine/ui"
                failed = (failed + 1)
            }
            def vlSrc:string (vl.userFileText("VlEvgList.rgr"))
            if ((indexOf vlSrc "Import \"../../evg/PathBuilder.rgr\"") >= 0) {
                print "  FAIL ingested VlEvgList still has ../../evg Import"
                failed = (failed + 1)
            }
            if ((indexOf vlSrc "Import \"PathBuilder.rgr\"") < 0) {
                print "  FAIL ingested VlEvgList missing rewritten PathBuilder Import"
                failed = (failed + 1)
            }
            if ((indexOf vlSrc "Import \"UITextRenderer.rgr\"") < 0) {
                print "  FAIL ingested VlEvgList missing rewritten UITextRenderer Import"
                failed = (failed + 1)
            }
            print ("  ingest VlEvgList → " + (to_string (vl.userFileCount())) + " user files")
        }

        def env (new InputEnv)
        env.use_real = false
        env.filesystem = (new InputFSFolder)
        def hostRes (new InputFileResolver)
        hostRes.addHostDir("gallery/datagrid/src")
        env.setResolver(hostRes)
        if ((file_exists env "/" "SheetView.rgr") == false) {
            print "  FAIL resolver missed SheetView.rgr from host dir"
            failed = (failed + 1)
        } {
            def svBody@(optional):string (read_file env "/" "SheetView.rgr")
            if (null? svBody) {
                print "  FAIL resolver read SheetView.rgr empty"
                failed = (failed + 1)
            } {
                def svText:string (unwrap svBody)
                if ((indexOf svText "class SheetView") < 0) {
                    print "  FAIL resolver SheetView contents"
                    failed = (failed + 1)
                }
                if ((indexOf svText "def model:SpreadsheetModel") < 0) {
                    print "  FAIL resolver missed SheetView.model"
                    failed = (failed + 1)
                }
            }
        }
        if ((file_exists env "/" "../../office/editor/OfficeHistory.rgr") == false) {
            print "  FAIL resolver missed relative OfficeHistory.rgr"
            failed = (failed + 1)
        }

        def envMap (new InputEnv)
        envMap.use_real = false
        envMap.filesystem = (new InputFSFolder)
        def mapRes (new InputFileResolver)
        mapRes.putFile("SheetView.rgr" "class SheetView {\n    def model:SpreadsheetModel\n}\n")
        envMap.setResolver(mapRes)
        if ((file_exists envMap "/gallery/css/" "SheetView.rgr") == false) {
            print "  FAIL resolver missed basename on a library subpath"
            failed = (failed + 1)
        }

        def dg (new CodeGraphApp)
        dg.start(800.0 600.0 (unwrap css))
        if ((dg.ingestDiskTree("gallery/datagrid/src/DataGrid.rgr")) == false) {
            print "  FAIL ingestDiskTree DataGrid.rgr"
            failed = (failed + 1)
        } {
            if ((dg.hasUserFile("SheetView.rgr")) == false) {
                print "  FAIL ingest missed SheetView.rgr"
                failed = (failed + 1)
            }
            if ((dg.hasUserFile("SpreadsheetModel.rgr")) == false) {
                print "  FAIL ingest missed SpreadsheetModel.rgr"
                failed = (failed + 1)
            }
            if ((dg.hasUserFile("OfficeHistory.rgr")) == false) {
                print "  FAIL ingest missed OfficeHistory.rgr from ../../office"
                failed = (failed + 1)
            }
            print ("  ingest DataGrid → " + (to_string (dg.userFileCount())) + " user files")
        }

        failed = (failed + (CodeGraphAppTest.checkDiffMode((unwrap css))))

        if (failed > 0) {
            print ("CodeGraphAppTest FAILED " + (to_string failed))
            exit 1
        }
        print "CodeGraphAppTest ok"
    }

    ; Two hand-built graphs with a source file, opened as a diff: the
    ; explorer lands on the summary, the source pane shows the merged
    ; text with its marks, and Diff / overview go where a diff wants.
    sfn checkDiffMode:int (css:string) {
        print "== diff mode in the explorer"
        def n:int 0
        def before:CodeGraph (new CodeGraph)
        before.title = "v1"
        def b:CodeClass (before.addClass("Cart"))
        b.fileName = "cart.rgr"
        def bm:CodeMethod (before.addMethod("Cart" "total"))
        bm.fileName = "cart.rgr"
        bm.startLine = 1
        def bo:CodeMethod (before.addMethod("Cart" "old"))
        bo.fileName = "cart.rgr"
        bo.startLine = 4
        before.addSource("cart.rgr" "class Cart {\n    fn total:int () {\n        return 1\n    }\n    fn old:void () {\n    }\n}")
        def after:CodeGraph (new CodeGraph)
        after.title = "v2"
        def a:CodeClass (after.addClass("Cart"))
        a.fileName = "cart.rgr"
        def am:CodeMethod (after.addMethod("Cart" "total"))
        am.fileName = "cart.rgr"
        am.startLine = 1
        after.addSource("cart.rgr" "class Cart {\n    fn total:int () {\n        return 2\n    }\n}")
        def app (new CodeGraphApp)
        app.start(1200.0 800.0 css)
        if ((app.applyDiffSession((CodeGraphSession.ofDiff(before after "v1 → v2" 24)) "cart")) == false) {
            print "  FAIL applyDiffSession"
            return 1
        }
        if ((app.pageId()) != "diff:0") {
            print ("  FAIL diff opened on " + (app.pageId()))
            n = (n + 1)
        }
        if ((app.diffActive()) == false) {
            print "  FAIL diffActive"
            n = (n + 1)
        }
        if ((indexOf (app.diffSummary()) "1 changed") < 0) {
            print ("  FAIL diff summary: " + (app.diffSummary()))
            n = (n + 1)
        }
        if ((indexOf (app.statusText()) "v1 → v2") < 0) {
            print ("  FAIL status names the sides: " + (app.statusText()))
            n = (n + 1)
        }
        ; The removed method's row sits in the merged text, on a red row.
        app.revealMethod("Cart.old")
        def marks:int (app.codeView.markCount(2))
        if (marks < 2) {
            print ("  FAIL merged source has " + (to_string marks) + " removed lines, want 2")
            n = (n + 1)
        }
        if ((app.codeView.markCount(1)) != 1) {
            print ("  FAIL merged source added lines " + (to_string (app.codeView.markCount(1))))
            n = (n + 1)
        }
        if ((app.codeView.lineMark(app.codeView.sel.caret.line)) != 2) {
            print ("  FAIL caret is not on the removed method (line " + (to_string app.codeView.sel.caret.line) + ")")
            n = (n + 1)
        }
        app.revealMethod("Cart.total")
        if (app.codeView.sel.caret.line != 1) {
            print ("  FAIL caret on total(): line " + (to_string app.codeView.sel.caret.line))
            n = (n + 1)
        }
        app.openClass("Cart")
        if ((app.pageId()) != "class:Cart") {
            print ("  FAIL openClass " + (app.pageId()))
            n = (n + 1)
        }
        app.goOverview()
        if ((app.pageId()) != "diff:0") {
            print ("  FAIL overview with a diff open went to " + (app.pageId()))
            n = (n + 1)
        }
        app.runToolbar("diff")
        if ((app.consumeOpenDiff()) == false) {
            print "  FAIL Diff button did not ask the host"
            n = (n + 1)
        }
        if (app.consumeOpenDiff()) {
            print "  FAIL Diff request not consumed"
            n = (n + 1)
        }
        ; Without an opened path there is nothing to run git around.
        def fresh (new CodeGraphApp)
        fresh.start(800.0 600.0 css)
        if (fresh.analyzeGitDiff("HEAD~1..HEAD")) {
            print "  FAIL analyzeGitDiff with nothing open"
            n = (n + 1)
        }
        if ((indexOf (fresh.statusText()) "desktop") < 0) {
            print ("  FAIL a host without git is told so: " + (fresh.statusText()))
            n = (n + 1)
        }
        print ("  " + (app.statusText()))
        n = (n + (CodeGraphAppTest.checkCommitPickers(css)))
        return n
    }

    ; The COMMITS rail: empty until a checkout is open, then the log as
    ; two selects (base, head) and a pull request field. Picking runs the
    ; diff; here, with git off, that is the status line saying so.
    sfn checkCommitPickers:int (css:string) {
        print "== commit pickers"
        def n:int 0
        def app (new CodeGraphApp)
        app.start(1200.0 800.0 css)
        if ((array_length app.baseSel.items) != 1) {
            print ("  FAIL base select before any checkout has " + (to_string (array_length app.baseSel.items)) + " items")
            n = (n + 1)
        }
        def first:UiItem (itemAt app.baseSel.items 0)
        if (first.disabled == false) {
            print "  FAIL the placeholder item is not disabled"
            n = (n + 1)
        }
        def log:[GitCommitInfo]
        def c1 (new GitCommitInfo)
        c1.sha = "1111111111111111111111111111111111111111"
        c1.short = "1111111"
        c1.subject = "second"
        push log c1
        def c2 (new GitCommitInfo)
        c2.sha = "2222222222222222222222222222222222222222"
        c2.short = "2222222"
        c2.subject = "first"
        push log c2
        app.setCommitList(log)
        if ((array_length app.baseSel.items) != 3) {
            print ("  FAIL base select has " + (to_string (array_length app.baseSel.items)) + " items, want placeholder + 2")
            n = (n + 1)
        }
        if ((array_length app.headSel.items) != 3) {
            print ("  FAIL head select has " + (to_string (array_length app.headSel.items)) + " items, want working tree + 2")
            n = (n + 1)
        }
        if ((strlen (app.selectedSpec())) != 0) {
            print "  FAIL nothing picked, yet a spec"
            n = (n + 1)
        }
        app.baseSel.value = c2.sha
        if ((app.selectedSpec()) != c2.sha) {
            print ("  FAIL base only → working tree spec: " + (app.selectedSpec()))
            n = (n + 1)
        }
        app.headSel.value = c1.sha
        if ((app.selectedSpec()) != ((c2.sha + "..") + c1.sha)) {
            print ("  FAIL base..head spec: " + (app.selectedSpec()))
            n = (n + 1)
        }
        ; Picking through the UI: open the base list, click a commit.
        app.baseSel.value = ""
        app.headSel.value = ""
        app.press((app.baseSel.triggerTid()))
        app.press((app.baseSel.itemTid(c2.sha)))
        if (app.baseSel.value != c2.sha) {
            print ("  FAIL clicking a commit did not pick it: '" + app.baseSel.value + "'")
            n = (n + 1)
        }
        if ((indexOf (app.statusText()) "desktop") < 0) {
            print ("  FAIL the pick ran the diff (git off → told so): " + (app.statusText()))
            n = (n + 1)
        }
        ; The pull request field takes a number and Enter.
        app.ui.focus(app.prField.tid)
        app.typeText("#")
        app.typeText("1")
        app.typeText("2")
        if (app.prField.value != "#12") {
            print ("  FAIL typed into the PR field: '" + app.prField.value + "'")
            n = (n + 1)
        }
        app.keyWith("Enter" false false)
        if ((indexOf (app.statusText()) "desktop") < 0) {
            print ("  FAIL Enter in the PR field ran the diff: " + (app.statusText()))
            n = (n + 1)
        }
        if ((app.hasField("cg-pr")) == false) {
            print "  FAIL cg-pr is a typing field"
            n = (n + 1)
        }
        app.showComparedCommits(c2.sha c1.sha)
        if ((app.baseSel.value != c2.sha) || (app.headSel.value != c1.sha)) {
            print "  FAIL showComparedCommits did not point the selects"
            n = (n + 1)
        }
        app.showComparedCommits(c2.sha "")
        if ((strlen app.headSel.value) != 0) {
            print "  FAIL working-tree head should clear the head select"
            n = (n + 1)
        }
        return n
    }
}

; ============================================================================
; CodeGraphBuilder.rgr — compiler / disk / ranger.json → CodeGraph.
; ============================================================================
;
; The semantic walk lives in gallery/uast (`UastRanger` + shared pipeline).
; This file compiles a Ranger program (VirtualCompiler still owns `pkg:`
; imports via ranger.json / vendor / cache), then projects the UAST
; CodeModel into the IR the pager draws. Open a `.rgr` file, a directory
; with ranger.json, a C++ header/source (or a tree of them), or that
; manifest itself — imported packages stay on the graph the same way
; DataGrid → SheetView does.
; ============================================================================

Import "CodeGraphModel.rgr"
; LiveCompiler pulls every language writer. That is most of the generated
; C++ in the SDL binary; CodeGraph only needs a parse/walk for `.rgr` Open.
Import "../../../compiler/VirtualCompiler.rgr"
Import "../../uast/src/UastRanger.rgr"
Import "../../uast/src/UastCodeGraph.rgr"
Import "../../uast/src/UastTs.rgr"
Import "../../uast/src/UastCpp.rgr"

class CodeGraphBuilder {
    ; When set, only classes whose source path contains this string are kept.
    ; Empty keeps every normal class the frontend collected (still skipping
    ; Lang.rgr / stdops). Open / analyzeSource leave this empty so imported
    ; classes (DataGrid → SheetView, pkg:util → Greeter) stay on the graph.
    def fileFilter:string ""

    Constructor () {
    }

    fn fromContext:CodeGraph (ctx:RangerAppWriterContext) {
        def a (new UastRanger)
        a.fileFilter = fileFilter
        def model:UastCodeModel (a.fromContext(ctx))
        def g:CodeGraph (UastToCodeGraph.project(model))
        if ((strlen g.title) == 0) {
            g.title = "Ranger"
        }
        return g
    }

    ; Compile a Ranger file from the real disk and copy its call graph.
    ; Used by the builder suite to walk gallery libraries (css, evg, zip).
    sfn fromFile:CodeGraph (path:string) {
        return (CodeGraphBuilder.keepFromFile(path ""))
    }

    ; A directory, ranger.json, or a `.rgr` entry. Git URLs are cloned by
    ; the CLI wrapper (`tools/codegraph_open.mjs`), not here — this only
    ; reads what is already on disk, including `pkg:` path/vendor/cache.
    ;
    ; A `.rgr` file does not need ranger.json — packages are optional.
    ; `dir_exists` on several targets is "path exists" (a file counts), so
    ; we must not treat `calls.rgr` as a project directory.
    sfn fromPath:CodeGraph (path:string) {
        def p:string (CodeGraphBuilder.slashPath(path))
        if (CodeGraphBuilder.isGitUrl(p)) {
            def empty (new CodeGraph)
            empty.title = (p + " FAIL clone a Git URL with codegraph_open first")
            return empty
        }
        def base:string (CodeGraphBuilder.fileBaseName(p))
        if (base == "ranger.json") {
            return (CodeGraphBuilder.fromDir((CodeGraphBuilder.fileDirName(p))))
        }
        if (CodeGraphBuilder.isRgr(base)) {
            return (CodeGraphBuilder.fromFile(p))
        }
        return (CodeGraphBuilder.fromDir(p))
    }

    ; Hosts (SDL, CLI) use this: Ranger when there is a .rgr / ranger.json,
    ; C++ when the path is a .h/.hpp/.cc/.cpp (or a tree of those and no
    ; TypeScript), otherwise the TypeScript UAST frontend. Git URLs must
    ; be cloned first.
    sfn fromAny:CodeGraph (path:string) {
        def p:string (CodeGraphBuilder.slashPath(path))
        if (CodeGraphBuilder.isGitUrl(p)) {
            def empty (new CodeGraph)
            empty.title = (p + " FAIL clone a Git URL first")
            return empty
        }
        def base:string (CodeGraphBuilder.fileBaseName(p))
        if (base == "ranger.json") {
            return (CodeGraphBuilder.fromDir((CodeGraphBuilder.fileDirName(p))))
        }
        if (CodeGraphBuilder.isRgr(base)) {
            return (CodeGraphBuilder.fromFile(p))
        }
        if (UastTs.isTsSource(base)) {
            return (CodeGraphBuilder.fromTs(p))
        }
        if (UastCpp.isCppFile(base)) {
            return (CodeGraphBuilder.fromCpp(p))
        }
        def man:string (CodeGraphBuilder.readDisk(p "ranger.json"))
        if ((strlen man) > 0) {
            return (CodeGraphBuilder.fromDir(p))
        }
        if (UastCpp.looksLikeCpp(p)) {
            return (CodeGraphBuilder.fromCpp(p))
        }
        return (CodeGraphBuilder.fromTs(p))
    }

    sfn fromTs:CodeGraph (path:string) {
        def model:UastCodeModel (UastTs.fromPath(path))
        def g:CodeGraph (UastToCodeGraph.project(model))
        g.title = path
        if ((strlen model.title) > 0) {
            g.title = model.title
        }
        if ((g.classCount()) == 0) {
            def empty (new CodeGraph)
            empty.title = (path + " FAIL no classes")
            return empty
        }
        return g
    }

    sfn fromCpp:CodeGraph (path:string) {
        def model:UastCodeModel (UastCpp.fromPath(path))
        def g:CodeGraph (UastToCodeGraph.project(model))
        g.title = path
        if ((strlen model.title) > 0) {
            g.title = model.title
        }
        if ((g.classCount()) == 0) {
            def empty (new CodeGraph)
            empty.title = (path + " FAIL no classes")
            return empty
        }
        return g
    }

    sfn isRgr:boolean (name:string) {
        def n:int (strlen name)
        if (n < 4) {
            return false
        }
        return ((substring name (n - 4) n) == ".rgr")
    }

    sfn fromDir:CodeGraph (dir:string) {
        def empty (new CodeGraph)
        empty.title = dir
        def man:string (CodeGraphBuilder.readDisk(dir "ranger.json"))
        if ((strlen man) == 0) {
            empty.title = (dir + " FAIL no ranger.json")
            return empty
        }
        def entry:string (CodeGraphBuilder.jsonStrField(man "entry"))
        if ((strlen entry) == 0) {
            empty.title = (dir + " FAIL ranger.json has no entry")
            return empty
        }
        def file:string (CodeGraphBuilder.joinPath(dir entry))
        return (CodeGraphBuilder.fromFile(file))
    }

    sfn isGitUrl:boolean (path:string) {
        if ((indexOf path "https://") == 0) {
            return true
        }
        if ((indexOf path "http://") == 0) {
            return true
        }
        if ((indexOf path "git://") == 0) {
            return true
        }
        if ((indexOf path "git@") == 0) {
            return true
        }
        return false
    }

    sfn slashPath:string (path:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen path)
        while (i < n) {
            def ch:int (charAt path i)
            if (ch == 92) {
                out = (out + "/")
            } {
                out = (out + (substring path i (i + 1)))
            }
            i = (i + 1)
        }
        return out
    }

    sfn slashIn:int (s:string) {
        def i:int 0
        def cut:int (0 - 1)
        while (i < (strlen s)) {
            if ((charAt s i) == 47) {
                cut = i
            }
            i = (i + 1)
        }
        return cut
    }

    sfn fileBaseName:string (path:string) {
        def p:string (CodeGraphBuilder.slashPath(path))
        def cut:int (CodeGraphBuilder.slashIn(p))
        if (cut < 0) {
            return p
        }
        return (substring p (cut + 1) (strlen p))
    }

    sfn fileDirName:string (path:string) {
        def p:string (CodeGraphBuilder.slashPath(path))
        def cut:int (CodeGraphBuilder.slashIn(p))
        if (cut < 0) {
            return "."
        }
        if (cut == 0) {
            return "/"
        }
        return (substring p 0 cut)
    }

    sfn joinPath:string (dir:string spec:string) {
        def s:string (CodeGraphBuilder.slashPath(spec))
        if ((strlen s) == 0) {
            return (CodeGraphBuilder.slashPath(dir))
        }
        if ((indexOf s "/") == 0) {
            return s
        }
        if ((strlen dir) == 0) {
            return s
        }
        if (dir == ".") {
            return s
        }
        return ((dir + "/") + s)
    }

    sfn readDisk:string (dir:string name:string) {
        def t@(optional):string (read_file dir name)
        if (null? t) {
            return ""
        }
        return (unwrap t)
    }

    ; Tiny "key": "value" reader so this file does not Import PkgImport.rgr
    ; (the compiler already loads that via a different path).
    sfn jsonStrField:string (src:string key:string) {
        def needle:string (("\"" + key) + "\"")
        def hit:int (indexOf src needle)
        if (hit < 0) {
            return ""
        }
        def i:int (hit + (strlen needle))
        def n:int (strlen src)
        while (i < n) {
            def ch:int (charAt src i)
            if ((ch == 32) || (ch == 9) || (ch == 10) || (ch == 13) || (ch == 58)) {
                i = (i + 1)
            } {
                if (ch == 34) {
                    def j:int (i + 1)
                    while (j < n) {
                        if ((charAt src j) == 34) {
                            return (substring src (i + 1) j)
                        }
                        j = (j + 1)
                    }
                    return ""
                }
                return ""
            }
        }
        return ""
    }

    sfn keepFromFile:CodeGraph (path:string filter:string) {
        def empty (new CodeGraph)
        empty.title = path
        def env:InputEnv (new InputEnv)
        env.use_real = true
        env.setEnv("RANGER_LIB" "./compiler/;./lib/;./compiler")
        def params:CmdParams (new CmdParams)
        push params.values path
        set params.params "l" "es6"
        set params.params "o" "codegraph_gallery_ignored.js"
        set params.flags "no-color" true
        env.commandLine = params
        def vc:VirtualCompiler (new VirtualCompiler)
        def res:CompilerResults (vc.run(env))
        if res.hasErrors {
            empty.title = ((path + " FAIL ") + res.errorMessage)
            return empty
        }
        def ctx@(optional):RangerAppWriterContext res.ctx
        if (null? ctx) {
            empty.title = (path + " FAIL no context")
            return empty
        }
        def appCtx:RangerAppWriterContext (unwrap ctx)
        if ((array_length appCtx.compilerErrors) > 0) {
            def err:RangerCompilerMessage (itemAt appCtx.compilerErrors 0)
            empty.title = ((path + " FAIL ") + err.description)
            return empty
        }
        def b (new CodeGraphBuilder)
        b.fileFilter = filter
        def g:CodeGraph (b.fromContext(appCtx))
        g.title = path
        return g
    }
}

; ============================================================================
; CodeGraphPages.rgr — one chart of 20–30 boxes, not the whole program.
; ============================================================================
;
; Drawing a thousand-node call graph is slow and unreadable. Each page is a
; window: an overview of the busiest classes, one class and the types that
; point at it, or one method with its callers, callees and the types it uses.
; Anything
; that does not fit becomes a pager arrow on the edge — click it, get the
; next window. The IR stays whole; only the window is a FlowGraph.
; ============================================================================

Import "CodeGraphModel.rgr"
Import "CodeGraphDiff.rgr"

class CodePageItem {
    def id:string ""
    def label:string ""
    def itemKind:string ""
    def dataKind:string ""
    def dataRef:string ""
    def extra:string ""
    def fill:string ""
    def stroke:string ""

    Constructor () {
    }

    sfn create:CodePageItem (id:string label:string itemKind:string) {
        def it (new CodePageItem)
        it.id = id
        it.label = label
        it.itemKind = itemKind
        it.dataKind = itemKind
        it.dataRef = id
        return it
    }
}

class CodePageLink {
    def fromId:string ""
    def toId:string ""
    def label:string ""
    def dashed:boolean false
    ; "" call-graph, "inherit", "assoc" (a field whose type is another class)
    def kind:string ""
    def fieldName:string ""

    Constructor () {
    }

    sfn create:CodePageLink (fromId:string toId:string) {
        def e (new CodePageLink)
        e.fromId = fromId
        e.toId = toId
        return e
    }
}

class CodePage {
    def id:string ""
    def title:string ""
    def kind:string ""
    def items:[CodePageItem]
    def links:[CodePageLink]

    Constructor () {
    }

    fn itemCount:int () {
        return (array_length items)
    }

    fn addItem:CodePageItem (it:CodePageItem) {
        push items it
        return it
    }

    fn addLink:void (fromId:string toId:string) {
        if (fromId == toId) {
            return
        }
        def i:int 0
        while (i < (array_length links)) {
            def e:CodePageLink (itemAt links i)
            if (e.fromId == fromId) {
                if (e.toId == toId) {
                    return
                }
            }
            i = (i + 1)
        }
        push links (CodePageLink.create(fromId toId))
    }

    fn addDashed:void (fromId:string toId:string label:string) {
        def e:CodePageLink (CodePageLink.create(fromId toId))
        e.dashed = true
        e.label = label
        push links e
    }

    fn addInherit:void (fromId:string toId:string) {
        def e:CodePageLink (CodePageLink.create(fromId toId))
        e.kind = "inherit"
        push links e
    }

    ; A dashed "uses" edge that leaves from a method row (`Main.main`),
    ; the way an association leaves from a field row. One per method.
    fn addUses:void (fromId:string toId:string methodName:string) {
        if (fromId == toId) {
            return
        }
        def i:int 0
        while (i < (array_length links)) {
            def e:CodePageLink (itemAt links i)
            if (e.fromId == fromId) {
                if (e.toId == toId) {
                    if (e.kind == "uses") {
                        if (e.fieldName == methodName) {
                            return
                        }
                    }
                }
            }
            i = (i + 1)
        }
        def n:CodePageLink (CodePageLink.create(fromId toId))
        n.kind = "uses"
        n.dashed = true
        n.label = "uses"
        n.fieldName = methodName
        push links n
    }

    fn addAssoc:void (fromId:string toId:string fieldName:string) {
        if (fromId == toId) {
            return
        }
        def i:int 0
        while (i < (array_length links)) {
            def e:CodePageLink (itemAt links i)
            if (e.fromId == fromId) {
                if (e.toId == toId) {
                    if (e.fieldName == fieldName) {
                        return
                    }
                }
            }
            i = (i + 1)
        }
        def n:CodePageLink (CodePageLink.create(fromId toId))
        n.kind = "assoc"
        n.fieldName = fieldName
        push links n
    }
}

class CodeGraphPages {
    def model:CodeGraph (new CodeGraph)
    ; 20–30 is the band that still lays out quickly and still reads. 24
    ; leaves room for a couple of pager arrows on a typical overview.
    def maxNodes:int 24
    ; When active, boxes and rows take the colour of what the change did
    ; to them, and there is a `diff:N` page listing only the classes it
    ; touched. Inactive, every status is "" and nothing here changes.
    def diff:CodeGraphDiff (new CodeGraphDiff)

    Constructor () {
    }

    sfn of:CodeGraphPages (g:CodeGraph maxNodes:int) {
        def p (new CodeGraphPages)
        p.model = g
        if (maxNodes < 8) {
            p.maxNodes = 8
        } {
            if (maxNodes > 40) {
                p.maxNodes = 40
            } {
                p.maxNodes = maxNodes
            }
        }
        return p
    }

    fn overviewId:string (index:int) {
        return ("overview:" + (to_string index))
    }

    fn classPageId:string (name:string) {
        return ("class:" + name)
    }

    fn methodPageId:string (methodId:string) {
        return ("method:" + methodId)
    }

    fn umlPageId:string (index:int) {
        return ("uml:" + (to_string index))
    }

    fn usedByPageId:string (name:string index:int) {
        return (("usedby:" + name) + ":" + (to_string index))
    }

    fn diffPageId:string (index:int) {
        return ("diff:" + (to_string index))
    }

    ; Where "← back" on a class page goes: the diff summary while one is
    ; open, the UML catalogue otherwise.
    fn homePageId:string () {
        if diff.active {
            return (this.diffPageId(0))
        }
        return (this.umlPageId(0))
    }

    fn homeLabel:string () {
        if diff.active {
            return "← diff"
        }
        return "← UML"
    }

    ; The colours a status paints with: a box border, a box or row fill.
    sfn diffStroke:string (status:string) {
        if (status == "added") {
            return "#15803d"
        }
        if (status == "removed") {
            return "#b91c1c"
        }
        if (status == "changed") {
            return "#b45309"
        }
        return ""
    }

    sfn diffFill:string (status:string) {
        if (status == "added") {
            return "#dcfce7"
        }
        if (status == "removed") {
            return "#fee2e2"
        }
        if (status == "changed") {
            return "#fef3c7"
        }
        return ""
    }

    ; The box behind the rows: a shade lighter than the row tint, because
    ; every other row is painted with the alternate fill and the rest show
    ; the box through — with the row colour on the box, an untouched row
    ; of a changed class read as changed.
    sfn diffBoxFill:string (status:string) {
        if (status == "added") {
            return "#f0fdf4"
        }
        if (status == "removed") {
            return "#fef2f2"
        }
        if (status == "changed") {
            return "#fffdf5"
        }
        return ""
    }

    ; Paint a class box by its status; an untouched class keeps what the
    ; page gave it. Removed classes are drawn muted so the eye lands on
    ; what is still in the program.
    fn colourByDiff:void (it:CodePageItem name:string) {
        if (diff.active == false) {
            return
        }
        def st:string (diff.statusOfClass(name))
        def stroke:string (CodeGraphPages.diffStroke(st))
        if ((strlen stroke) > 0) {
            it.stroke = stroke
            it.fill = (CodeGraphPages.diffBoxFill(st))
        }
    }

    fn pageOf:CodePage (pageId:string) {
        if ((strlen pageId) == 0) {
            return (this.pageOf(this.overviewId(0)))
        }
        if ((indexOf pageId "overview:") == 0) {
            def idx:int (this.intAfter(pageId "overview:"))
            return (this.buildOverview(idx))
        }
        if ((indexOf pageId "uml:") == 0) {
            def uidx:int (this.intAfter(pageId "uml:"))
            return (this.buildUml(uidx))
        }
        if ((indexOf pageId "usedby:") == 0) {
            return (this.buildUsedBy((this.usedByName(pageId)) (this.usedByIndex(pageId))))
        }
        if ((indexOf pageId "diff:") == 0) {
            def didx:int (this.intAfter(pageId "diff:"))
            return (this.buildDiff(didx))
        }
        if ((indexOf pageId "class:") == 0) {
            def cname:string (substring pageId 6 (strlen pageId))
            return (this.buildClass(cname))
        }
        if ((indexOf pageId "method:") == 0) {
            def mid:string (substring pageId 7 (strlen pageId))
            return (this.buildMethod(mid))
        }
        return (this.buildOverview(0))
    }

    ; usedby:CodeNode:0 → the class in the middle, then the page index.
    fn usedByName:string (pageId:string) {
        def rest:string (substring pageId 7 (strlen pageId))
        def cut:int (this.lastColonAt(rest))
        if (cut < 1) {
            return rest
        }
        return (substring rest 0 cut)
    }

    fn usedByIndex:int (pageId:string) {
        def rest:string (substring pageId 7 (strlen pageId))
        def cut:int (this.lastColonAt(rest))
        if (cut < 0) {
            return 0
        }
        return (?? (str2int (substring rest (cut + 1) (strlen rest))) 0)
    }

    fn lastColonAt:int (s:string) {
        def i:int ((strlen s) - 1)
        while (i >= 0) {
            if ((charAt s i) == (ccode ":")) {
                return i
            }
            i = (i - 1)
        }
        return -1
    }

    fn intAfter:int (s:string prefix:string) {
        def rest:string (substring s (strlen prefix) (strlen s))
        return (?? (str2int rest) 0)
    }

    fn buildOverview:CodePage (index:int) {
        def names:[string] (model.classNamesByDegree())
        def page (new CodePage)
        page.kind = "overview"
        page.id = (this.overviewId(index))
        def total:int (array_length names)
        ; One slot for the UML door, one for a possible next-page arrow,
        ; one for a previous-page arrow when we are not on the first page.
        def reserved:int 2
        if (index > 0) {
            reserved = (reserved + 1)
        }
        def sliceSize:int (maxNodes - reserved)
        if (sliceSize < 4) {
            sliceSize = 4
        }
        def start:int (index * sliceSize)
        if (start < 0) {
            start = 0
        }
        if (start >= total) {
            start = 0
            index = 0
            page.id = (this.overviewId(0))
        }
        def hasPrev:boolean (start > 0)
        def last:int (start + sliceSize)
        if (last > total) {
            last = total
        }
        def hasNext:boolean (last < total)
        page.title = (((model.title + " · classes ") + (to_string (start + 1))) + "–" + (to_string last) + " of " + (to_string total))
        if hasPrev {
            def prevIdx:int (index - 1)
            if (prevIdx < 0) {
                prevIdx = 0
            }
            page.addItem((this.pagerItem("pager-prev" ("← previous classes") (this.overviewId(prevIdx)))))
        }
        def i:int start
        while (i < last) {
            def name:string (itemAt names i)
            def c:CodeClass (model.classByName(name))
            def it:CodePageItem (CodePageItem.create(name name "class"))
            it.extra = (((to_string (c.methodCount())) + " methods"))
            it.fill = "#dbeafe"
            it.stroke = "#1d4ed8"
            page.addItem(it)
            if ((strlen c.extendsName) > 0) {
                def parent:string c.extendsName
                if (this.nameInRange(names parent start last)) {
                    page.addInherit(name parent)
                }
            }
            i = (i + 1)
        }
        if hasNext {
            page.addItem((this.pagerItem("pager-next" ("→ more classes (" + (to_string (total - last)) + ")") (this.overviewId((index + 1))))))
        }
        ; A door into the UML view of the same slice, so the two notations
        ; share the paging rather than dumping every class on one chart.
        def umlDoor:CodePageItem (this.pagerItem("pager-uml" "UML view →" (this.umlPageId(index))))
        umlDoor.fill = "#ede9fe"
        umlDoor.stroke = "#6d28d9"
        page.addItem(umlDoor)
        return page
    }

    fn buildUml:CodePage (index:int) {
        def names:[string] (model.classNamesByDegree())
        def page (new CodePage)
        page.kind = "uml"
        page.id = (this.umlPageId(index))
        def budget:int (maxNodes - 1)
        if (budget < 4) {
            budget = 4
        }
        def total:int (array_length names)
        def start:int (index * budget)
        if (start >= total) {
            start = 0
            index = 0
            page.id = (this.umlPageId(0))
        }
        def last:int (start + budget)
        if (last > total) {
            last = total
        }
        page.title = (((model.title + " · UML ") + (to_string (start + 1))) + "–" + (to_string last))
        def i:int start
        while (i < last) {
            def name:string (itemAt names i)
            def c:CodeClass (model.classByName(name))
            def it:CodePageItem (CodePageItem.create(name name "umlclass"))
            it.dataKind = "class"
            it.dataRef = name
            it.extra = c.stereotype
            it.fill = "#eff6ff"
            it.stroke = "#1e3a8a"
            this.colourByDiff(it name)
            page.addItem(it)
            if ((strlen c.extendsName) > 0) {
                def parent:string c.extendsName
                if (this.nameInRange(names parent start last)) {
                    page.addInherit(name parent)
                }
            }
            i = (i + 1)
        }
        this.addFieldLinks(page names start last)
        if (last < total) {
            page.addItem((this.pagerItem("pager-next" ("→ more UML (" + (to_string (total - last)) + ")") (this.umlPageId((index + 1))))))
        }
        if (start > 0) {
            def prev:int (index - 1)
            if (prev < 0) {
                prev = 0
            }
            page.addItem((this.pagerItem("pager-prev" "← previous UML" (this.umlPageId(prev)))))
        }
        return page
    }

    ; The classes a change touched, as UML boxes: changed ones amber,
    ; added ones green, removed ones red, with the field links and
    ; inheritance between them. Paged like the catalogue when a commit
    ; touched more classes than fit.
    fn buildDiff:CodePage (index:int) {
        def names:[string] diff.summary
        def page (new CodePage)
        page.kind = "diff"
        page.id = (this.diffPageId(index))
        def budget:int (maxNodes - 2)
        if (budget < 4) {
            budget = 4
        }
        def total:int (array_length names)
        def start:int (index * budget)
        if (start >= total) {
            start = 0
            index = 0
            page.id = (this.diffPageId(0))
        }
        def last:int (start + budget)
        if (last > total) {
            last = total
        }
        def head:string (model.title + " · diff")
        if ((strlen diff.label) > 0) {
            head = (model.title + " · " + diff.label)
        }
        if (total == 0) {
            page.title = (head + " · " + (diff.describe()))
            page.addItem((this.backItem("pager-back" "← UML" (this.umlPageId(0)))))
            return page
        }
        page.title = (head + " · " + (diff.describe()))
        def i:int start
        while (i < last) {
            def name:string (itemAt names i)
            if (model.hasClass(name)) {
                def c:CodeClass (model.classByName(name))
                def it:CodePageItem (CodePageItem.create(name name "umlclass"))
                it.dataKind = "class"
                it.dataRef = name
                it.extra = c.stereotype
                it.fill = "#eff6ff"
                it.stroke = "#1e3a8a"
                this.colourByDiff(it name)
                page.addItem(it)
                if ((strlen c.extendsName) > 0) {
                    def parent:string c.extendsName
                    if (this.nameInRange(names parent start last)) {
                        page.addInherit(name parent)
                    }
                }
            }
            i = (i + 1)
        }
        this.addFieldLinks(page names start last)
        if (last < total) {
            page.addItem((this.pagerItem("pager-next" ("→ more changes (" + (to_string (total - last)) + ")") (this.diffPageId((index + 1))))))
        }
        if (start > 0) {
            def prev:int (index - 1)
            if (prev < 0) {
                prev = 0
            }
            page.addItem((this.pagerItem("pager-prev" "← previous changes" (this.diffPageId(prev)))))
        }
        page.addItem((this.backItem("pager-uml" "UML →" (this.umlPageId(0)))))
        return page
    }

    fn buildClass:CodePage (name:string) {
        def page (new CodePage)
        page.kind = "class"
        page.id = (this.classPageId(name))
        if ((model.hasClass(name)) == false) {
            page.title = (name + " (unknown)")
            page.addItem((this.backItem("pager-back" "← overview" (this.overviewId(0)))))
            return page
        }
        def c:CodeClass (model.classByName(name))
        page.title = (name + " · " + (to_string (c.methodCount())) + " methods")
        if diff.active {
            def st:string (diff.statusOfClass(name))
            if ((strlen st) > 0) {
                page.title = (page.title + " · " + st)
            }
        }
        page.addItem((this.backItem("pager-back" (this.homeLabel()) (this.homePageId()))))
        ; Classes whose fields are typed as this one sit above it, so the
        ; arrows run down into the box the reader already has on screen.
        this.addIncomingUsers(page name)
        def self:CodePageItem (CodePageItem.create(name name "umlclass"))
        self.dataKind = "class"
        self.dataRef = name
        self.fill = "#dbeafe"
        self.stroke = "#1d4ed8"
        this.colourByDiff(self name)
        page.addItem(self)
        if ((strlen c.extendsName) > 0) {
            def pName:string c.extendsName
            if ((this.pageHasId(page pName)) == false) {
                def parent:CodePageItem (CodePageItem.create(pName pName "umlclass"))
                parent.dataKind = "class"
                parent.dataRef = pName
                parent.fill = "#e0e7ff"
                parent.stroke = "#3730a3"
                parent.extra = "extends"
                page.addItem(parent)
            }
            if (this.pageHasId(page pName)) {
                page.addInherit(name pName)
            }
        }
        ; Field types that name another class — Order.customer → Customer.
        def fi:int 0
        while (fi < (array_length c.fields)) {
            def f:CodeField (itemAt c.fields fi)
            def tName:string (CodeGraphPages.classNameOfType(f.fieldType))
            if ((strlen tName) > 0) {
                if (tName != name) {
                    if ((this.pageHasId(page tName)) == false) {
                        if ((page.itemCount()) < (maxNodes - 1)) {
                            def tItem:CodePageItem (CodePageItem.create(tName tName "umlclass"))
                            tItem.dataKind = "class"
                            tItem.dataRef = tName
                            tItem.fill = "#eff6ff"
                            tItem.stroke = "#1e3a8a"
                            this.colourByDiff(tItem tName)
                            page.addItem(tItem)
                        }
                    }
                    if (this.pageHasId(page tName)) {
                        page.addAssoc(name tName f.name)
                    }
                }
            }
            fi = (fi + 1)
        }
        ; Methods already live in the UML body. Do not add a leftover-methods
        ; hexagon — that was a door onto the stadiums that are gone.
        def mids:[string] (c.methodIds)
        ; Types the methods of this class mention, if there is still room.
        def used:[string]
        def ui:int 0
        while (ui < (array_length mids)) {
            def um:CodeMethod (model.methodById((itemAt mids ui)))
            def ti:int 0
            while (ti < (array_length um.uses)) {
                def tn:string (itemAt um.uses ti)
                if (tn != name) {
                    def already:boolean false
                    def a:int 0
                    while (a < (array_length used)) {
                        if ((itemAt used a) == tn) {
                            already = true
                        }
                        a = (a + 1)
                    }
                    if (already == false) {
                        push used tn
                    }
                }
                ti = (ti + 1)
            }
            ui = (ui + 1)
        }
        def ti2:int 0
        while (ti2 < (array_length used)) {
            if ((page.itemCount()) >= (maxNodes - 1)) {
                def rest:int ((array_length used) - ti2)
                page.addItem((this.pagerItem("pager-types" ("→ " + (to_string rest) + " more types") (this.classPageId(name)))))
                ti2 = (array_length used)
            } {
                def tn2:string (itemAt used ti2)
                def alreadyOn:boolean (this.pageHasId(page tn2))
                if (alreadyOn == false) {
                    def tItem:CodePageItem (CodePageItem.create(tn2 tn2 "type"))
                    tItem.dataKind = "class"
                    tItem.dataRef = tn2
                    tItem.fill = "#fef3c7"
                    tItem.stroke = "#b45309"
                    this.colourByDiff(tItem tn2)
                    page.addItem(tItem)
                    page.addDashed(name tn2 "uses")
                }
                ti2 = (ti2 + 1)
            }
        }
        return page
    }

    ; How many referring classes fit above the focus before the chart
    ; stops being a class page and becomes a catalogue.
    fn incomingCap:int () {
        def cap:int (idiv maxNodes 3)
        if (cap > 8) {
            cap = 8
        }
        if (cap < 2) {
            cap = 2
        }
        return cap
    }

    ; Classes that have a field whose type is `target`, source order.
    fn fieldUsersOf:[string] (target:string) {
        def names:[string]
        def i:int 0
        while (i < (model.classCount())) {
            def c:CodeClass (model.classAt(i))
            if (c.name != target) {
                def hit:boolean false
                def fi:int 0
                while (fi < (array_length c.fields)) {
                    def f:CodeField (itemAt c.fields fi)
                    def tName:string (CodeGraphPages.classNameOfType(f.fieldType))
                    if (tName == target) {
                        hit = true
                    }
                    fi = (fi + 1)
                }
                if hit {
                    push names c.name
                }
            }
            i = (i + 1)
        }
        return names
    }

    ; Classes with a method that mentions `target` (`new Checkout`, a
    ; parameter, a call into it), source order. A class page lists the
    ; types its methods use; this is that arrow read backwards, so
    ; Checkout knows that CodeGraphFixtureMain.main is what reaches it.
    fn methodUsersOf:[string] (target:string) {
        def names:[string]
        def i:int 0
        while (i < (model.classCount())) {
            def c:CodeClass (model.classAt(i))
            if (c.name != target) {
                if ((array_length (this.usingMethodsOf(c target))) > 0) {
                    push names c.name
                }
            }
            i = (i + 1)
        }
        return names
    }

    ; The methods of `c` that use `target` or call one of its methods.
    fn usingMethodsOf:[string] (c:CodeClass target:string) {
        def ids:[string]
        def mi:int 0
        while (mi < (array_length c.methodIds)) {
            def mid:string (itemAt c.methodIds mi)
            def m:CodeMethod (model.methodById(mid))
            def hit:boolean false
            def ui:int 0
            while (ui < (array_length m.uses)) {
                if ((itemAt m.uses ui) == target) {
                    hit = true
                }
                ui = (ui + 1)
            }
            def ci:int 0
            while (ci < (array_length m.calls)) {
                def callee:CodeMethod (model.methodById((itemAt m.calls ci)))
                if (callee.className == target) {
                    hit = true
                }
                ci = (ci + 1)
            }
            if hit {
                push ids mid
            }
            mi = (mi + 1)
        }
        return ids
    }

    ; Everything that points at `target`: field users first (an association
    ; is the stronger claim), then classes whose methods reach it.
    fn usersOf:[string] (target:string) {
        def names:[string] (this.fieldUsersOf(target))
        def more:[string] (this.methodUsersOf(target))
        def i:int 0
        while (i < (array_length more)) {
            def n:string (itemAt more i)
            def seen:boolean false
            def k:int 0
            while (k < (array_length names)) {
                if ((itemAt names k) == n) {
                    seen = true
                }
                k = (k + 1)
            }
            if (seen == false) {
                push names n
            }
            i = (i + 1)
        }
        return names
    }

    fn addBackref:void (page:CodePage userName:string target:string) {
        if ((this.pageHasId(page userName)) == false) {
            def it:CodePageItem (CodePageItem.create(userName userName "backref"))
            it.dataKind = "class"
            it.dataRef = userName
            it.extra = target
            it.fill = "#fdf2f8"
            it.stroke = "#9d174d"
            this.colourByDiff(it userName)
            page.addItem(it)
        }
        if (model.hasClass(userName)) {
            def c:CodeClass (model.classByName(userName))
            def fi:int 0
            while (fi < (array_length c.fields)) {
                def f:CodeField (itemAt c.fields fi)
                def tName:string (CodeGraphPages.classNameOfType(f.fieldType))
                if (tName == target) {
                    page.addAssoc(userName target f.name)
                }
                fi = (fi + 1)
            }
            def using:[string] (this.usingMethodsOf(c target))
            def ui:int 0
            while (ui < (array_length using)) {
                def um:CodeMethod (model.methodById((itemAt using ui)))
                page.addUses(userName target um.name)
                ui = (ui + 1)
            }
        }
    }

    fn addIncomingUsers:void (page:CodePage name:string) {
        def users:[string] (this.usersOf(name))
        def userCap:int (this.incomingCap())
        def shown:int 0
        def i:int 0
        while (i < (array_length users)) {
            if (shown >= userCap) {
                i = (array_length users)
            } {
                if ((page.itemCount()) >= (maxNodes - 4)) {
                    i = (array_length users)
                } {
                    this.addBackref(page (itemAt users i) name)
                    shown = (shown + 1)
                    i = (i + 1)
                }
            }
        }
        def leftover:int ((array_length users) - shown)
        if (leftover > 0) {
            page.addItem((this.pagerItem("pager-users" ("← " + (to_string leftover) + " more users") (this.usedByPageId(name 0)))))
        }
    }

    fn buildUsedBy:CodePage (name:string index:int) {
        def page (new CodePage)
        page.kind = "usedby"
        page.id = (this.usedByPageId(name index))
        if ((model.hasClass(name)) == false) {
            page.title = (name + " (unknown)")
            page.addItem((this.backItem("pager-back" "← overview" (this.overviewId(0)))))
            return page
        }
        def users:[string] (this.usersOf(name))
        def total:int (array_length users)
        def reserved:int 3
        if (index > 0) {
            reserved = (reserved + 1)
        }
        def sliceSize:int (maxNodes - reserved)
        if (sliceSize < 4) {
            sliceSize = 4
        }
        def start:int (index * sliceSize)
        if (start < 0) {
            start = 0
        }
        if (start >= total) {
            start = 0
            index = 0
            page.id = (this.usedByPageId(name 0))
        }
        def last:int (start + sliceSize)
        if (last > total) {
            last = total
        }
        def hasPrev:boolean (start > 0)
        def hasNext:boolean (last < total)
        def fromLabel:string "0"
        if (last > 0) {
            fromLabel = (to_string (start + 1))
        }
        page.title = (((name + " · used by ") + fromLabel) + "–" + (to_string last) + " of " + (to_string total))
        page.addItem((this.backItem("pager-back" ("← " + name) (this.classPageId(name)))))
        if hasPrev {
            def prevIdx:int (index - 1)
            if (prevIdx < 0) {
                prevIdx = 0
            }
            page.addItem((this.pagerItem("pager-prev" "← previous users" (this.usedByPageId(name prevIdx)))))
        }
        def self:CodePageItem (CodePageItem.create(name name "umlclass"))
        self.dataKind = "class"
        self.dataRef = name
        self.fill = "#dbeafe"
        self.stroke = "#1d4ed8"
        page.addItem(self)
        def i:int start
        while (i < last) {
            this.addBackref(page (itemAt users i) name)
            i = (i + 1)
        }
        if hasNext {
            page.addItem((this.pagerItem("pager-next" ("→ " + (to_string (total - last)) + " more users") (this.usedByPageId(name (index + 1))))))
        }
        return page
    }

    fn buildMethod:CodePage (methodId:string) {
        def page (new CodePage)
        page.kind = "method"
        page.id = (this.methodPageId(methodId))
        if ((model.hasMethod(methodId)) == false) {
            page.title = (methodId + " (unknown)")
            page.addItem((this.backItem("pager-back" "← overview" (this.overviewId(0)))))
            return page
        }
        def m:CodeMethod (model.methodById(methodId))
        page.title = (m.className + "." + (m.signature()))
        page.addItem((this.backItem("pager-back" ("← " + m.className) (this.classPageId(m.className)))))
        def self:CodePageItem (CodePageItem.create(methodId (m.signature()) "method"))
        self.fill = "#bbf7d0"
        self.stroke = "#166534"
        page.addItem(self)
        def owner:CodePageItem (CodePageItem.create(m.className m.className "class"))
        owner.fill = "#dbeafe"
        owner.stroke = "#1d4ed8"
        page.addItem(owner)
        page.addLink(m.className methodId)
        def budget:int (maxNodes - (page.itemCount()))
        def half:int (idiv budget 3)
        if (half < 2) {
            half = 2
        }
        this.addMethodList(page m.calledBy half "pager-callers" "← " " more callers" methodId true)
        this.addMethodList(page m.calls half "pager-callees" "→ " " more callees" methodId false)
        this.addTypeList(page m.uses half methodId)
        return page
    }

    fn addMethodList:void (page:CodePage ids:[string] limit:int pagerId:string prefix:string suffix:string focusId:string incoming:boolean) {
        def shown:int 0
        def i:int 0
        while (i < (array_length ids)) {
            if (shown >= limit) {
                i = (array_length ids)
            } {
                if ((page.itemCount()) >= (maxNodes - 1)) {
                    i = (array_length ids)
                } {
                    def mid:string (itemAt ids i)
                    def alreadyM:boolean (this.pageHasId(page mid))
                    if (alreadyM == false) {
                        if (model.hasMethod(mid)) {
                            def om:CodeMethod (model.methodById(mid))
                            def it:CodePageItem (CodePageItem.create(mid (om.className + "." + om.name) "method"))
                            it.fill = "#dcfce7"
                            it.stroke = "#15803d"
                            page.addItem(it)
                            if incoming {
                                page.addLink(mid focusId)
                            } {
                                page.addLink(focusId mid)
                            }
                            shown = (shown + 1)
                        }
                    }
                    i = (i + 1)
                }
            }
        }
        def leftover:int ((array_length ids) - shown)
        if (leftover > 0) {
            def nextId:string focusId
            if (shown < (array_length ids)) {
                nextId = (itemAt ids shown)
            }
            page.addItem((this.pagerItem(pagerId ((prefix + (to_string leftover)) + suffix) (this.methodPageId(nextId)))))
        }
    }

    fn addTypeList:void (page:CodePage names:[string] limit:int focusId:string) {
        def shown:int 0
        def i:int 0
        while (i < (array_length names)) {
            if (shown >= limit) {
                i = (array_length names)
            } {
                if ((page.itemCount()) >= maxNodes) {
                    i = (array_length names)
                } {
                    def tn:string (itemAt names i)
                    def alreadyT:boolean (this.pageHasId(page tn))
                    if (alreadyT == false) {
                        def it:CodePageItem (CodePageItem.create(tn tn "type"))
                        it.dataKind = "class"
                        it.dataRef = tn
                        it.fill = "#fef3c7"
                        it.stroke = "#b45309"
                        page.addItem(it)
                        page.addDashed(focusId tn "uses")
                        shown = (shown + 1)
                    }
                    i = (i + 1)
                }
            }
        }
        def leftover:int ((array_length names) - shown)
        if (leftover > 0) {
            page.addItem((this.pagerItem("pager-types" ("→ " + (to_string leftover) + " more types") (this.methodPageId(focusId)))))
        }
    }

    fn addFieldLinks:void (page:CodePage names:[string] start:int last:int) {
        def i:int start
        while (i < last) {
            def name:string (itemAt names i)
            if (model.hasClass(name)) {
                def c:CodeClass (model.classByName(name))
                def fi:int 0
                while (fi < (array_length c.fields)) {
                    def f:CodeField (itemAt c.fields fi)
                    def tName:string (CodeGraphPages.classNameOfType(f.fieldType))
                    if ((strlen tName) > 0) {
                        if (tName != name) {
                            if (this.nameInRange(names tName start last)) {
                                page.addAssoc(name tName f.name)
                            }
                        }
                    }
                    fi = (fi + 1)
                }
            }
            i = (i + 1)
        }
    }

    ; How many attributes / operations the UML box lists before "+ N more".
    sfn umlAttrCap:int () {
        return 8
    }

    sfn umlMethodCap:int () {
        return 8
    }

    sfn umlCatalogueAttrCap:int () {
        return 4
    }

    sfn umlCatalogueMethodCap:int () {
        return 3
    }

    sfn umlAttrRowCount:int (c:CodeClass compact:boolean) {
        def cap:int (CodeGraphPages.umlAttrCap())
        if compact {
            cap = (CodeGraphPages.umlCatalogueAttrCap())
        }
        def n:int (array_length c.fields)
        def shown:int n
        if (shown > cap) {
            shown = cap
        }
        if (n > shown) {
            return (shown + 1)
        }
        return shown
    }

    ; Compartment row → method id. Attributes (and the "+ N more" field row)
    ; occupy the first rows, in the same order asUml writes them. -1 / a field
    ; row / the leftover operation row are not methods.
    fn methodIdAtRow:string (className:string row:int) {
        if (row < 0) {
            return ""
        }
        if ((model.hasClass(className)) == false) {
            return ""
        }
        def c:CodeClass (model.classByName(className))
        def attrRows:int (CodeGraphPages.umlAttrRowCount(c false))
        if (row < attrRows) {
            return ""
        }
        def mi:int (row - attrRows)
        def cap:int (CodeGraphPages.umlMethodCap())
        if (mi >= cap) {
            return ""
        }
        if (mi >= (array_length c.methodIds)) {
            return ""
        }
        return (itemAt c.methodIds mi)
    }

    ; Compartment row → "fields" / "methods" when it is the "+ N more" row
    ; of that compartment, "" otherwise. That row stands for the members
    ; the cap folded away; a click on it lists them all.
    fn moreRowKind:string (className:string row:int) {
        if (row < 0) {
            return ""
        }
        if ((model.hasClass(className)) == false) {
            return ""
        }
        def c:CodeClass (model.classByName(className))
        def attrRows:int (CodeGraphPages.umlAttrRowCount(c false))
        if ((array_length c.fields) > (CodeGraphPages.umlAttrCap())) {
            if (row == (attrRows - 1)) {
                return "fields"
            }
        }
        if ((array_length c.methodIds) > (CodeGraphPages.umlMethodCap())) {
            if (row == (attrRows + (CodeGraphPages.umlMethodCap()))) {
                return "methods"
            }
        }
        return ""
    }

    ; Compartment row → field name. Same attribute rows as `methodIdAtRow`.
    ; A leftover "+ N more" row, a method row, or a miss is empty.
    fn fieldNameAtRow:string (className:string row:int) {
        if (row < 0) {
            return ""
        }
        if ((model.hasClass(className)) == false) {
            return ""
        }
        def c:CodeClass (model.classByName(className))
        def attrRows:int (CodeGraphPages.umlAttrRowCount(c false))
        if (row >= attrRows) {
            return ""
        }
        if (row >= (array_length c.fields)) {
            return ""
        }
        def f:CodeField (itemAt c.fields row)
        return f.name
    }

    ; "Customer" or "[LineItem]" → the class name, or empty for a primitive.
    sfn classNameOfType:string (fieldType:string) {
        def t:string fieldType
        def n:int (strlen t)
        if (n >= 3) {
            if ((charAt t 0) == (ccode "[")) {
                if ((charAt t (n - 1)) == (ccode "]")) {
                    t = (substring t 1 (n - 1))
                    n = (strlen t)
                }
            }
        }
        if (n == 0) {
            return ""
        }
        if (t == "string") { return "" }
        if (t == "int") { return "" }
        if (t == "double") { return "" }
        if (t == "boolean") { return "" }
        if (t == "void") { return "" }
        if (t == "char") { return "" }
        if (t == "charbuffer") { return "" }
        if (t == "buffer") { return "" }
        if (t == "any") { return "" }
        if (t == "enum") { return "" }
        return t
    }

    fn pagerItem:CodePageItem (id:string label:string target:string) {
        def it:CodePageItem (CodePageItem.create(id label "pager"))
        it.dataKind = "page"
        it.dataRef = target
        it.fill = "#f3f4f6"
        it.stroke = "#4b5563"
        return it
    }

    fn backItem:CodePageItem (id:string label:string target:string) {
        def it:CodePageItem (this.pagerItem(id label target))
        it.itemKind = "back"
        it.fill = "#ede9fe"
        it.stroke = "#6d28d9"
        return it
    }

    fn pageHasId:boolean (page:CodePage id:string) {
        def i:int 0
        while (i < (array_length page.items)) {
            def it:CodePageItem (itemAt page.items i)
            if (it.id == id) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn nameInRange:boolean (names:[string] name:string start:int last:int) {
        def i:int start
        while (i < last) {
            if ((itemAt names i) == name) {
                return true
            }
            i = (i + 1)
        }
        return false
    }
}

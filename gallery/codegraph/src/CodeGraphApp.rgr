; ============================================================================
; CodeGraphApp — Full EVG explorer: gallery/ui chrome + RangerFlow canvas.
; ============================================================================
;
; The same IR and pager the HTML page uses. The chrome is EVG, so one
; display list is what a browser, an SDL2 window and a native host all
; paint. The body is a ResizeCtl group: class rail | UML canvas | source.
; Clicking a class, field or method opens that file in ScriptEditor and
; scrolls so the declaration is near the top of the pane — the method
; body is visible immediately, not one line below the fold.
;
;   host event → CodeGraphApp (UiHost chrome | FlowEditor | ScriptEditor)
;   display()  → EVGDisplayList → WebGL / EvgGlPainter
;
; Desktop Open uses CodeGraphBuilder.fromPath (real disk, ranger.json, pkg:).
; In-tab examples still compile through the VFS.
; ============================================================================

Import "../../evg/EvgApp.rgr"
Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGUnit.rgr"
Import "../../evg/EVGDisplayList.rgr"
Import "../../ui/src/UiHost.rgr"
Import "../../ui/src/ResizeCtl.rgr"
Import "../../rangerflow/core/FlowEditor.rgr"
Import "../../rangerflow/core/FlowEvents.rgr"
Import "../../datagrid/src/script/ScriptEditor.rgr"
Import "../../datagrid/src/GridCursor.rgr"
Import "../../datagrid/src/script/lang/EditorLanguage.rgr"
Import "../../datagrid/src/script/lang/RangerLanguage.rgr"
Import "../../datagrid/src/script/lang/JsLanguage.rgr"
Import "../../game_engine/ui/UITextRenderer.rgr"
Import "CodeGraphSample.rgr"
Import "CodeGraphFlow.rgr"
Import "CodeGraphBuilder.rgr"
Import "CodeGraphGit.rgr"
Import "CodeGraphMembers.rgr"

class CodeGraphApp extends EvgApp {
    def session:CodeGraphSession (new CodeGraphSession)
    def graph:FlowGraph (new FlowGraph)
    def editor:FlowEditor (new FlowEditor)
    def input:FlowInput (new FlowInput)
    def ui:UiHost (new UiHost)

    def pageW:double 1200.0
    def pageH:double 800.0
    def railW:double 260.0
    def headerH:double 52.0
    def footerH:double 28.0
    def canvasX:double 260.0
    def canvasY:double 52.0
    def canvasW:double 940.0
    def canvasH:double 720.0
    def viewW:double 940.0
    def viewH:double 720.0
    def sourceX:double 0.0
    def sourceY:double 52.0
    def sourceW:double 360.0
    def sourceH:double 720.0
    def splitW:double 1200.0
    def split:ResizeCtl (new ResizeCtl)
    def splitDrag:boolean false
    ; Where the separators are on screen, filled during the frame's layout.
    ; The pointer's shape is asked for on every mouse move, and re-laying the
    ; page out to answer that would be a second layout per frame.
    def sepX0:[double]
    def sepX1:[double]
    def splitDragI:int 0
    def splitAt:double 0.0
    def graphDrag:boolean false
    def sourceDrag:boolean false
    def codeView:ScriptEditor (new ScriptEditor)
    def languages:LanguageRegistry (new LanguageRegistry)
    def codeTr:UITextRenderer (new UITextRenderer)
    def sourcePath:string ""
    def lastOpenPath:string ""
    def sourceJump:boolean false

    def sampleName:string "shop"
    def umlOn:boolean false
    def status:string ""
    def chromeReady:boolean false
    def wantOpenFile:boolean false
    def wantOpenGitUrl:boolean false
    ; Diff pressed: the host asks for two revisions and calls analyzeGitDiff.
    def wantOpenDiff:boolean false
    ; The source pane shows a merged diff view (removed lines in place);
    ; remembered so a switch in or out of a diff re-inits the buffer.
    def sourceDiffShown:boolean false
    ; A menu pick the app could not serve from what it holds: the gallery
    ; pack, an example file or the C++ fixture is fetched by the host. The
    ; web page drains this after every pointer event and loads the sources,
    ; then picks the same item again.
    def pendingSample:string ""
    def lastClickMs:double 0.0
    def lastClickX:double 0.0
    def lastClickY:double 0.0
    def clockMs:double 0.0
    def shiftOn:boolean false
    def ctrlOn:boolean false

    def headerEl:EVGElement (EVGElement.createDiv())
    def bodyEl:EVGElement (EVGElement.createDiv())
    def railEl:EVGElement (EVGElement.createDiv())
    def canvasEl:EVGElement (EVGElement.createDiv())
    def sourceEl:EVGElement (EVGElement.createDiv())
    def footerEl:EVGElement (EVGElement.createDiv())
    def brand:LabelCtl (new LabelCtl)
    def crumbLbl:LabelCtl (new LabelCtl)
    def statusLbl:LabelCtl (new LabelCtl)
    def capExample:LabelCtl (new LabelCtl)
    def capClasses:LabelCtl (new LabelCtl)
    def bar:ToolbarCtl (new ToolbarCtl)
    def sampleSel:SelectCtl (new SelectCtl)
    ; COMMITS: two picks from the opened repository's own log, and a
    ; field for a pull request. Filled by loadCommits once a checkout is
    ; open; empty (one disabled item) until then.
    def capCommits:LabelCtl (new LabelCtl)
    def baseSel:SelectCtl (new SelectCtl)
    def headSel:SelectCtl (new SelectCtl)
    def prField:InputCtl (new InputCtl)
    ; Every member of one class, in a drawer opened from a "+ N more" row.
    def members:MemberDrawer (new MemberDrawer)
    ; Ctrl+C in the source pane leaves the selection here; the host puts it
    ; on the clipboard (the tab through navigator.clipboard, SDL through
    ; SDL_SetClipboardText) and drains it.
    def clipboardText:string ""
    def commitList:[GitCommitInfo]
    def gitRoot:string ""
    ; Only a host with git on PATH (desktop, CLI) turns this on; the tab
    ; has no processes, and says so instead of trying.
    def gitEnabled:boolean false
    def classSearch:InputCtl (new InputCtl)
    def classTree:TreeCtl (new TreeCtl)
    def classScrollEl:EVGElement (EVGElement.createDiv())
    ; A layout that lays nothing out: it exists to hand over the text engine
    ; the caret is measured with, which is a fact about a string and a font
    ; and needs no page.
    def caretMeasurer:EVGLayout (new EVGLayout)
    ; The one menu item that stands for "the file you opened", so the example
    ; select still has something to show its name.
    def openedItem:string ""
    ; The source pane's share while it is put away, so pressing `code` again
    ; gives back the width it had rather than a default.
    def sourceHidden:boolean false
    def sourceShare:double 30.0
    def sourceFloor:double 12.0
    def umlToggle:ToggleCtl (new ToggleCtl)

    def rootFiles:[string:string]
    def libFiles:[string:string]
    def compilerFiles:[string:string]
    def galleryFiles:[string:string]
    def exampleFiles:[string:string]
    def userFiles:[string:string]
    def vfsHostDirs:[string]

    Constructor () {
    }

    fn start:void (w:double h:double css:string) {
        pageW = w
        pageH = h
        if ((strlen css) > 0) {
            ui.addStyleSheet(css)
        }
        ; The class list is `overflow: auto`. EVG paints the bar only when
        ; the display list is asked to; state 1 keeps the track up so the
        ; sheet's `scrollbar-color` is visible, not overlay-hidden-until-scroll.
        ui.showScrollbars = true
        ui.scrollbarState = 1
        this.installLanguages()
        codeView.init("; Select a class, field or method to open its source.")
        codeView.showMinimap = true
        this.buildChrome()
        this.setPageSize(w h)
        this.loadSample("shop")
    }

    fn installLanguages:void () {
        def rangerLang (new RangerLanguage)
        languages.add(rangerLang)
        def jsLang (new JsLanguage)
        languages.add(jsLang)
    }

    fn init:void (w:double h:double) {
        this.start(w h "")
    }

    fn widthPx:double () {
        return pageW
    }

    fn heightPx:double () {
        return pageH
    }

    fn setPageSize:void (w:double h:double) {
        if (w < 320.0) {
            w = 320.0
        }
        if (h < 240.0) {
            h = 240.0
        }
        pageW = w
        pageH = h
        headerH = 52.0
        footerH = 28.0
        canvasH = ((h - headerH) - footerH)
        if (canvasH < 160.0) {
            canvasH = 160.0
        }
        canvasY = headerH
        sourceY = headerH
        sourceH = canvasH
        splitW = w
        this.estimatePaneSizes()
        ui.setPageSize(w h)
        this.applyChromeSizes()
        editor.setSize(viewW viewH)
        codeView.setBounds((to_int sourceX) (to_int sourceY) (to_int sourceW) (to_int sourceH))
    }

    fn estimatePaneSizes:void () {
        def bodyH:double canvasH
        def railPct:double 22.0
        def graphPct:double 48.0
        def srcPct:double 30.0
        if ((array_length split.panels) >= 3) {
            def rp:UiPanel (itemAt split.panels 0)
            def gp:UiPanel (itemAt split.panels 1)
            def sp:UiPanel (itemAt split.panels 2)
            railPct = rp.size
            graphPct = gp.size
            srcPct = sp.size
        }
        railW = ((pageW * railPct) / 100.0)
        canvasW = ((pageW * graphPct) / 100.0)
        sourceW = ((pageW * srcPct) / 100.0)
        if (canvasW < 120.0) {
            canvasW = 120.0
        }
        if (sourceW < 80.0) {
            sourceW = 80.0
        }
        canvasX = railW
        sourceX = (railW + canvasW)
        viewW = canvasW
        viewH = bodyH
    }

    fn applyChromeSizes:void () {
        if (chromeReady == false) {
            return
        }
        def root@(optional):EVGElement ui.root
        if (null? root) {
            return
        }
        this.sizeBox((unwrap root) pageW pageH)
        this.sizeBox(headerEl pageW headerH)
        this.sizeBox(bodyEl pageW canvasH)
        this.sizeBox(footerEl pageW footerH)
        this.sizeBox((unwrap split.rootEl) pageW canvasH)
        this.sizeHeight(railEl canvasH)
        this.sizeHeight(canvasEl canvasH)
        this.sizeHeight(sourceEl canvasH)
        this.dressSplit()
    }

    fn sizeBox:void (el:EVGElement w:double h:double) {
        el.setAttribute("width" ((to_string (to_int w)) + "px"))
        el.setAttribute("height" ((to_string (to_int h)) + "px"))
    }

    fn sizeHeight:void (el:EVGElement h:double) {
        el.setAttribute("height" ((to_string (to_int h)) + "px"))
    }

    fn mount:void (parent:EVGElement c:UiCtl) {
        push ui.ctls c
        def el:EVGElement (unwrap c.rootEl)
        parent.addChild(el)
    }

    fn buildChrome:void () {
        def rootOpt@(optional):EVGElement ui.root
        if (null? rootOpt) {
            return
        }
        def root:EVGElement (unwrap rootOpt)
        root.id = "root"
        root.className = "cg-root"
        UiTree.clearChildren(root)

        headerEl.id = "cg-header"
        headerEl.className = "cg-header"
        bodyEl.id = "cg-body"
        bodyEl.className = "cg-body"
        railEl.id = "cg-rail"
        railEl.className = "cg-rail"
        canvasEl.id = "cg-canvas"
        canvasEl.className = "cg-canvas"
        sourceEl.id = "cg-source"
        sourceEl.className = "cg-source"
        footerEl.id = "cg-footer"
        footerEl.className = "cg-footer"

        brand.tid = "cg-brand"
        brand.name = "CodeGraph"
        brand.build()
        this.mount(headerEl brand)

        bar.tid = "cg-bar"
        bar.name = "explorer"
        bar.addItem("open" "Open" false)
        bar.addItem("giturl" "Git URL" false)
        bar.addItem("diff" "Diff" false)
        bar.addItem("back" "←" true)
        bar.addItem("fwd" "→" true)
        bar.addItem("overview" "overview" false)
        bar.addItem("fit" "fit" false)
        bar.addItem("zoom" "zoom" false)
        bar.addItem("analyze" "Analyze" false)
        ; Nothing could put the source pane away, and the separator is six
        ; pixels wide — on the desktop that is a target you have to aim at.
        ; A button says what it does and hits every time.
        bar.addItem("code" "code" false)
        bar.build()
        this.mount(headerEl bar)

        umlToggle.tid = "cg-uml"
        umlToggle.name = "UML"
        umlToggle.build()
        this.mount(headerEl umlToggle)

        capExample.tid = "cg-cap-example"
        capExample.name = "EXAMPLE"
        capExample.build()
        def capExEl:EVGElement (unwrap capExample.rootEl)
        capExEl.className = "cg-cap"
        this.mount(railEl capExample)

        sampleSel.tid = "cg-sample"
        sampleSel.name = "example program"
        sampleSel.addItem("calls.rgr" "calls.rgr — Order / LineItem" false)
        sampleSel.addItem("animals.rgr" "animals.rgr — Farm / Animal" false)
        sampleSel.addItem("css" "css — CssCore" false)
        sampleSel.addItem("evg" "evg — EVGElement" false)
        sampleSel.addItem("zip" "zip — ZipReader" false)
        sampleSel.addItem("cpp" "cpp — ZipWriter" false)
        sampleSel.addItem("diff-calls" "calls.rgr → calls_v2.rgr (diff)" false)
        ; VirtualCompiler is already in the binary because Open on a `.rgr`
        ; file compiles through CodeGraphBuilder. A menu item that walks
        ; `VirtualCompiler.rgr` does not add those C++ lines — it just
        ; dumps the whole compiler as a paged graph. Use Open for that.
        sampleSel.addItem("shop" "Shop fixture (no compiler)" false)
        sampleSel.addItem("many" "40 classes (paging)" false)
        sampleSel.value = "shop"
        sampleSel.build()
        this.mount(railEl sampleSel)

        capCommits.tid = "cg-cap-commits"
        capCommits.name = "COMMITS"
        capCommits.build()
        def capCoEl:EVGElement (unwrap capCommits.rootEl)
        capCoEl.className = "cg-cap"
        this.mount(railEl capCommits)

        baseSel.tid = "cg-base"
        baseSel.name = "base commit"
        headSel.tid = "cg-head"
        headSel.name = "head commit"
        this.fillCommitSelects()
        this.mount(railEl baseSel)
        this.mount(railEl headSel)

        prField.tid = "cg-pr"
        prField.name = "Pull request"
        prField.kind = "text"
        prField.placeholder = "Pull request # or URL, Enter"
        prField.fontSize = 13.0
        prField.build()
        this.mount(railEl prField)
        def prEl:EVGElement (unwrap prField.rootEl)
        UiTree.addClass(prEl "cg-class-search")

        capClasses.tid = "cg-cap-classes"
        capClasses.name = "CLASSES"
        capClasses.build()
        def capClEl:EVGElement (unwrap capClasses.rootEl)
        capClEl.className = "cg-cap"
        this.mount(railEl capClasses)

        classSearch.tid = "cg-class-filter"
        classSearch.name = "Filter classes"
        classSearch.kind = "search"
        classSearch.placeholder = "Search classes"
        this.dressClassSearch()
        this.mount(railEl classSearch)

        classScrollEl.id = "cg-class-scroll"
        classScrollEl.className = "cg-class-scroll"
        railEl.addChild(classScrollEl)

        classTree.tid = "cg-classes"
        classTree.name = "classes"
        classTree.rootValue = "root"
        classTree.selectable = true
        classTree.addNode("root" "classes")
        classTree.build()
        this.mount(classScrollEl classTree)

        ; The path of what is open used to sit in the header, between the
        ; brand and the buttons, and it grew with the path: a temp checkout
        ; pushed Open, Git URL and the rest off to the right, and they moved
        ; every time a different file was opened. Toolbar buttons that will
        ; not hold still are worse than a path you have to look down for, so
        ; the path reads along the footer in grey and the buttons keep their
        ; place. The footer has room for more of them later.
        crumbLbl.tid = "cg-crumb"
        crumbLbl.name = "loading…"
        crumbLbl.build()
        def crumbEl:EVGElement (unwrap crumbLbl.rootEl)
        crumbEl.className = "cg-crumb"
        this.mount(footerEl crumbLbl)

        statusLbl.tid = "cg-status"
        statusLbl.name = "ready"
        statusLbl.build()
        def stEl:EVGElement (unwrap statusLbl.rootEl)
        stEl.className = "cg-status"
        this.mount(footerEl statusLbl)

        root.addChild(headerEl)
        root.addChild(bodyEl)
        root.addChild(footerEl)
        members.drawer.build()
        this.mount(root members.drawer)
        this.buildSplit()
        chromeReady = true
        this.applyChromeSizes()
    }

    fn buildSplit:void () {
        split.tid = "cg-split"
        split.orientation = "horizontal"
        split.rebuildOnResize = false
        if ((array_length split.panels) == 0) {
            def railP:UiPanel (split.addPanel("rail" 22.0))
            railP.minSize = 12.0
            def graphP:UiPanel (split.addPanel("graph" 48.0))
            graphP.minSize = 20.0
            def srcP:UiPanel (split.addPanel("source" 30.0))
            srcP.minSize = 12.0
            push ui.ctls split
        }
        split.build()
        def splitRoot:EVGElement (unwrap split.rootEl)
        splitRoot.className = "ui-resizable cg-split"
        bodyEl.addChild(splitRoot)
        this.mountSplitPanes()
        this.dressSplit()
    }

    fn mountSplitPanes:void () {
        def splitRoot:EVGElement (unwrap split.rootEl)
        def railBody@(optional):EVGElement (ui.findEl(splitRoot ((split.panelTid("rail")) + "-body")))
        def graphBody@(optional):EVGElement (ui.findEl(splitRoot ((split.panelTid("graph")) + "-body")))
        def srcBody@(optional):EVGElement (ui.findEl(splitRoot ((split.panelTid("source")) + "-body")))
        if railBody {
            def rb:EVGElement (unwrap railBody)
            rb.className = "ui-resizable-body cg-rail-body"
            rb.addChild(railEl)
        }
        if graphBody {
            def gb:EVGElement (unwrap graphBody)
            gb.className = "ui-resizable-body cg-graph-body"
            gb.addChild(canvasEl)
        }
        if srcBody {
            def sb:EVGElement (unwrap srcBody)
            sb.className = "ui-resizable-body cg-source-body"
            sb.addChild(sourceEl)
        }
    }

    fn dressSplit:void () {
        def splitRoot:EVGElement (unwrap split.rootEl)
        this.sizeBox(splitRoot pageW canvasH)
        splitRoot.flexDirection = "row"
        splitRoot.alignItems = "stretch"
        def i:int 0
        while (i < (array_length split.panels)) {
            def p:UiPanel (itemAt split.panels i)
            def pel@(optional):EVGElement (ui.findEl(splitRoot (split.panelTid(p.value))))
            if pel {
                def panel:EVGElement (unwrap pel)
                this.giveShare(panel i)
                this.sizeHeight(panel canvasH)
                panel.alignItems = "stretch"
                def body@(optional):EVGElement (ui.findEl(panel ((split.panelTid(p.value)) + "-body")))
                if body {
                    this.sizeHeight((unwrap body) canvasH)
                }
            }
            if (i > 0) {
                def sep@(optional):EVGElement (ui.findEl(splitRoot (split.sepTid(i - 1))))
                if sep {
                    def s:EVGElement (unwrap sep)
                    s.flexShrink = 0.0
                    s.markInline("flex-shrink")
                    s.cursor = "col-resize"
                    this.sizeBox(s 10.0 canvasH)
                }
            }
            i = (i + 1)
        }
    }

    fn giveShare:void (el:EVGElement i:int) {
        def p:UiPanel (itemAt split.panels i)
        el.flex = p.size
        el.flexShrink = 1.0
        el.flexBasis = (EVGUnit.px(0.0))
        el.markInline("flex-grow")
        el.markInline("flex-shrink")
        el.markInline("flex-basis")
    }

    fn splitCount:int () {
        return (array_length split.panels)
    }

    fn splitSizeAt:double (i:int) {
        if (i < 0) {
            return 0.0
        }
        if (i >= (array_length split.panels)) {
            return 0.0
        }
        def p:UiPanel (itemAt split.panels i)
        return p.size
    }

    fn refreshChrome:void () {
        if (chromeReady == false) {
            return
        }
        crumbLbl.name = (this.crumb())
        crumbLbl.build()
        def crumbEl:EVGElement (unwrap crumbLbl.rootEl)
        crumbEl.className = "cg-crumb"
        statusLbl.name = status
        statusLbl.build()
        def stEl:EVGElement (unwrap statusLbl.rootEl)
        stEl.className = "cg-status"
        umlToggle.on = umlOn
        umlToggle.build()
        this.syncSampleSelect()
        this.syncToolbar()
        this.refreshClasses()
    }

    ; Open and Git URL put a path in `sampleName`, and a path is not one of
    ; the menu's items — so the trigger drew an empty label and the box
    ; collapsed to a sliver. What is open is always an item, even when it is
    ; a file: named by its basename, kept at the top, replaced on the next
    ; Open rather than piling up.
    fn syncSampleSelect:void () {
        if ((sampleSel.indexOfValue(sampleName)) < 0) {
            def label:string (this.fileBaseName((this.slashPath(sampleName))))
            if ((strlen label) == 0) {
                label = sampleName
            }
            this.setOpenedItem(sampleName label)
        }
        sampleSel.value = sampleName
        sampleSel.build()
    }

    ; A menu item whose analysis went through Open's path (the C++ fixture,
    ; the diff example) left an "opened · file" item behind and the select
    ; on it. The menu item is what was picked; put it back.
    fn settleSample:void (name:string) {
        sampleName = name
        if ((strlen openedItem) > 0) {
            def kept:[UiItem]
            def i:int 0
            while (i < (array_length sampleSel.items)) {
                def it:UiItem (itemAt sampleSel.items i)
                if (it.value != openedItem) {
                    push kept it
                }
                i = (i + 1)
            }
            sampleSel.items = kept
            openedItem = ""
        }
        this.syncSampleSelect()
        this.syncToolbar()
    }

    fn setOpenedItem:void (value:string label:string) {
        def fresh (new UiItem)
        fresh.value = value
        fresh.name = ("opened · " + label)
        def all:[UiItem]
        push all fresh
        def i:int 0
        while (i < (array_length sampleSel.items)) {
            def it:UiItem (itemAt sampleSel.items i)
            def drop:boolean false
            if (it.value == value) {
                drop = true
            }
            if (it.value == openedItem) {
                drop = true
            }
            if (drop == false) {
                push all it
            }
            i = (i + 1)
        }
        sampleSel.items = all
        openedItem = value
    }

    fn syncToolbar:void () {
        def i:int 0
        while (i < (array_length bar.items)) {
            def it:UiItem (itemAt bar.items i)
            if (it.value == "back") {
                it.disabled = ((this.canBack()) == false)
            }
            if (it.value == "fwd") {
                it.disabled = ((this.canForward()) == false)
            }
            if (it.value == "zoom") {
                it.disabled = ((this.hasSelection()) == false)
            }
            if (it.value == "code") {
                it.name = "code"
                if sourceHidden {
                    it.name = "code ▸"
                }
            }
            i = (i + 1)
        }
        bar.build()
    }

    fn refreshClasses:void () {
        def names:[string] (this.listedClassNames())
        def none:[UiTreeNode]
        classTree.nodes = none
        def rootNode:UiTreeNode (classTree.addNode("root" "classes"))
        def i:int 0
        while (i < (array_length names)) {
            def n:string (itemAt names i)
            classTree.addNode(n n)
            TreeCtl.addKid(rootNode n)
            i = (i + 1)
        }
        def current:string ""
        if ((indexOf session.pageId "class:") == 0) {
            current = (substring session.pageId 6 (strlen session.pageId))
        }
        if ((strlen current) > 0) {
            classTree.selectOnly(current)
            classTree.activeValue = current
        } {
            classTree.clearSelection()
            classTree.activeValue = ""
        }
        classTree.build()
        if ((strlen current) > 0) {
            def ni:int (classTree.nodeAt(current))
            if (ni >= 0) {
                def node:UiTreeNode (itemAt classTree.nodes ni)
                def el:EVGElement (unwrap node.el)
                UiTree.addClass(el "cg-class-current")
            }
        }
    }

    ; --- VirtualCompiler VFS ------------------------------------------------

    fn setRootFile:void (name:string data:string) {
        set rootFiles name data
    }

    fn setLibFile:void (name:string data:string) {
        set libFiles name data
    }

    fn setCompilerFile:void (name:string data:string) {
        set compilerFiles name data
    }

    fn setGalleryFile:void (path:string data:string) {
        set galleryFiles path (this.rewriteRelativeImports(data))
    }

    fn setExampleFile:void (name:string data:string) {
        set exampleFiles name data
    }

    fn hasExampleFile:boolean (name:string) {
        return (has exampleFiles name)
    }

    fn consumePendingSample:string () {
        def want:string pendingSample
        pendingSample = ""
        return want
    }

    ; The example file behind a menu item, when it is not a `.rgr` that
    ; compiles through the VFS: the C++ fixture, or a TypeScript file.
    sfn exampleFileFor:string (name:string) {
        if (name == "cpp") {
            return "zip_writer.hpp"
        }
        return name
    }

    ; Analyse a file the host handed over as text, by its extension:
    ; Ranger through VirtualCompiler, C++ and TypeScript through their
    ; UAST frontends. `.rgr` still needs the compiler libraries.
    fn analyzeText:boolean (source:string filename:string) {
        if (this.isRgr(filename)) {
            return (this.analyzeSource(source filename))
        }
        lastOpenPath = filename
        def g:CodeGraph (CodeGraphBuilder.fromSource(source filename))
        if ((indexOf g.title " FAIL ") >= 0) {
            status = g.title
            this.refreshChrome()
            return false
        }
        if ((g.classCount()) == 0) {
            status = ("no classes in " + filename)
            this.refreshChrome()
            return false
        }
        def name:string (this.fileBaseName(filename))
        if ((strlen name) == 0) {
            name = filename
        }
        return (this.applyGraph(g name))
    }

    fn setUserFile:void (name:string data:string) {
        set userFiles name (this.rewriteRelativeImports(data))
    }

    fn clearUserFiles:void () {
        def empty:[string:string]
        userFiles = empty
        def noDirs:[string]
        vfsHostDirs = noDirs
    }

    fn hasUserFile:boolean (name:string) {
        return (has userFiles name)
    }

    fn userFileText:string (name:string) {
        if (has userFiles name) {
            return (unwrap (get userFiles name))
        }
        return ""
    }

    fn userFileCount:int () {
        def names:[string] (keys userFiles)
        return (array_length names)
    }

    fn isRgr:boolean (name:string) {
        def n:int (strlen name)
        if (n < 4) {
            return false
        }
        return ((substring name (n - 4) n) == ".rgr")
    }

    fn slashPath:string (path:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen path)
        while (i < n) {
            def ch:int (charAt path i)
            if (ch == 92) {
                out = (out + "/")
            } {
                out = (out + (substring path i (i + 1)))
            }
            i = (i + 1)
        }
        return out
    }

    fn fileBaseName:string (path:string) {
        def p:string (this.slashPath(path))
        def cut:int (this.slashIn(p))
        if (cut < 0) {
            return p
        }
        return (substring p (cut + 1) (strlen p))
    }

    fn fileDirName:string (path:string) {
        def p:string (this.slashPath(path))
        def cut:int (this.slashIn(p))
        if (cut < 0) {
            return "."
        }
        if (cut == 0) {
            return "/"
        }
        return (substring p 0 cut)
    }

    fn isAbsPath:boolean (path:string) {
        def p:string (this.slashPath(path))
        if ((strlen p) == 0) {
            return false
        }
        if ((indexOf p "/") == 0) {
            return true
        }
        return false
    }

    fn collapsePath:string (path:string) {
        def raw:string (this.slashPath(path))
        def abs:boolean (this.isAbsPath(raw))
        def parts:[string] (strsplit raw "/")
        def out:[string]
        def i:int 0
        while (i < (array_length parts)) {
            def p:string (itemAt parts i)
            if ((strlen p) == 0) {
            } {
                if (p == ".") {
                } {
                    if (p == "..") {
                        if ((array_length out) > 0) {
                            removeLast out
                        } {
                            if (abs == false) {
                                push out p
                            }
                        }
                    } {
                        push out p
                    }
                }
            }
            i = (i + 1)
        }
        def joined:string (join out "/")
        if abs {
            return ("/" + joined)
        }
        return joined
    }

    fn joinPath:string (dir:string spec:string) {
        def s:string (this.slashPath(spec))
        if ((strlen s) == 0) {
            return (this.collapsePath(dir))
        }
        if ((indexOf s "/") == 0) {
            return (this.collapsePath(s))
        }
        if ((strlen dir) == 0) {
            return (this.collapsePath(s))
        }
        if (dir == ".") {
            return (this.collapsePath(s))
        }
        return (this.collapsePath((dir + "/") + s))
    }

    fn skipWs:int (s:string i:int) {
        def n:int (strlen s)
        while (i < n) {
            def ch:int (charAt s i)
            if ((ch == 32) || (ch == 9) || (ch == 10) || (ch == 13)) {
                i = (i + 1)
            } {
                return i
            }
        }
        return i
    }

    fn importAt:boolean (src:string at:int) {
        if (at == 0) {
            return true
        }
        def ch:int (charAt src (at - 1))
        if ((ch == 10) || (ch == 13) || (ch == 32) || (ch == 9)) {
            return true
        }
        return false
    }

    fn collectImportSpecs:[string] (src:string) {
        def specs:[string]
        def remain:string src
        while ((strlen remain) > 0) {
            def hit:int (indexOf remain "Import")
            if (hit < 0) {
                return specs
            }
            def after:string (substring remain (hit + 6) (strlen remain))
            if (this.importAt(remain hit)) {
                def j:int (this.skipWs(after 0))
                if (j < (strlen after)) {
                    if ((charAt after j) == 34) {
                        def rest:string (substring after (j + 1) (strlen after))
                        def q:int (indexOf rest "\"")
                        if (q > 0) {
                            push specs (substring rest 0 q)
                            remain = (substring rest (q + 1) (strlen rest))
                        } {
                            remain = after
                        }
                    } {
                        remain = after
                    }
                } {
                    remain = after
                }
            } {
                remain = after
            }
        }
        return specs
    }

    fn vfsImportSpec:string (spec:string) {
        if ((this.slashIn(spec)) >= 0) {
            return (this.fileBaseName(spec))
        }
        return spec
    }

    fn rewriteRelativeImports:string (src:string) {
        def out:string ""
        def remain:string src
        while ((strlen remain) > 0) {
            def hit:int (indexOf remain "Import")
            if (hit < 0) {
                return (out + remain)
            }
            out = (out + (substring remain 0 (hit + 6)))
            def after:string (substring remain (hit + 6) (strlen remain))
            if ((this.importAt(remain hit)) == false) {
                remain = after
            } {
                def j:int (this.skipWs(after 0))
                out = (out + (substring after 0 j))
                if (j >= (strlen after)) {
                    remain = ""
                } {
                    if ((charAt after j) != 34) {
                        remain = (substring after j (strlen after))
                    } {
                        def rest:string (substring after (j + 1) (strlen after))
                        def q:int (indexOf rest "\"")
                        if (q < 0) {
                            remain = (substring after j (strlen after))
                        } {
                            def spec:string (substring rest 0 q)
                            out = (out + "\"")
                            out = (out + (this.vfsImportSpec(spec)))
                            out = (out + "\"")
                            remain = (substring rest (q + 1) (strlen rest))
                        }
                    }
                }
            }
        }
        return out
    }

    fn skipEnvImport:boolean (spec:string) {
        def base:string (this.fileBaseName(spec))
        if ((this.isRgr(base)) == false) {
            return true
        }
        if (base == "Lang.rgr") {
            return true
        }
        if ((indexOf spec "compiler/") == 0) {
            return true
        }
        if ((indexOf spec "/compiler/") >= 0) {
            return true
        }
        if ((indexOf spec "lib/") == 0) {
            return true
        }
        if ((indexOf spec "/lib/") >= 0) {
            return true
        }
        if (has compilerFiles base) {
            return true
        }
        if (has libFiles base) {
            return true
        }
        return false
    }

    fn readDisk:string (dir:string name:string) {
        def t@(optional):string (read_file dir name)
        if (null? t) {
            return ""
        }
        return (unwrap t)
    }

    fn rememberHostDir:void (dir:string) {
        if ((strlen dir) == 0) {
            return
        }
        if (dir == ".") {
            return
        }
        def i:int 0
        while (i < (array_length vfsHostDirs)) {
            if ((itemAt vfsHostDirs i) == dir) {
                return
            }
            i = (i + 1)
        }
        push vfsHostDirs dir
    }

    fn ingestDiskFile:boolean (dir:string name:string) {
        if ((this.isRgr(name)) == false) {
            return false
        }
        if (has userFiles name) {
            return true
        }
        if (this.skipEnvImport(name)) {
            return true
        }
        def data:string (this.readDisk(dir name))
        if ((strlen data) == 0) {
            return false
        }
        this.rememberHostDir(dir)
        def specs:[string] (this.collectImportSpecs(data))
        this.setUserFile(name data)
        def i:int 0
        while (i < (array_length specs)) {
            def spec:string (itemAt specs i)
            if ((this.skipEnvImport(spec)) == false) {
                def full:string (this.joinPath(dir spec))
                if ((indexOf full "..") != 0) {
                    this.ingestDiskFile((this.fileDirName(full)) (this.fileBaseName(full)))
                }
            }
            i = (i + 1)
        }
        return true
    }

    fn ingestDiskTree:boolean (path:string) {
        def dir:string (this.fileDirName(path))
        def name:string (this.fileBaseName(path))
        return (this.ingestDiskFile(dir name))
    }

    fn galleryRelOk:boolean (rel:string) {
        if ((indexOf rel "css/") == 0) {
            return true
        }
        if ((indexOf rel "evg/") == 0) {
            return true
        }
        if ((indexOf rel "zip/") == 0) {
            return true
        }
        return false
    }

    fn ingestGalleryFile:void (rel:string) {
        if (has galleryFiles rel) {
            return
        }
        if ((this.galleryRelOk(rel)) == false) {
            return
        }
        if ((this.slashIn((this.fileDirName(rel)))) >= 0) {
            return
        }
        def dir:string ("gallery/" + (this.fileDirName(rel)))
        def name:string (this.fileBaseName(rel))
        def data:string (this.readDisk(dir name))
        if ((strlen data) == 0) {
            return
        }
        def specs:[string] (this.collectImportSpecs(data))
        this.setGalleryFile(rel data)
        def i:int 0
        while (i < (array_length specs)) {
            def spec:string (itemAt specs i)
            if ((this.skipEnvImport(spec)) == false) {
                def next:string (this.joinPath((this.fileDirName(rel)) spec))
                if ((indexOf next "..") != 0) {
                    this.ingestGalleryFile(next)
                }
            }
            i = (i + 1)
        }
    }

    fn loadGalleryTree:void () {
        this.ingestGalleryFile("css/CssCore.rgr")
        this.ingestGalleryFile("evg/EVGElement.rgr")
        this.ingestGalleryFile("zip/zip_tool.rgr")
    }

    fn galleryFileByBase:string (base:string) {
        def names:[string] (keys galleryFiles)
        def i:int 0
        while (i < (array_length names)) {
            def rel:string (itemAt names i)
            if ((this.fileBaseName(rel)) == base) {
                return (unwrap (get galleryFiles rel))
            }
            i = (i + 1)
        }
        return ""
    }

    fn fillMissingUserImports:void () {
        def queue:[string] (keys userFiles)
        def i:int 0
        while (i < (array_length queue)) {
            def name:string (itemAt queue i)
            def src:string (unwrap (get userFiles name))
            def specs:[string] (this.collectImportSpecs(src))
            def s:int 0
            while (s < (array_length specs)) {
                def spec:string (itemAt specs s)
                def base:string (this.fileBaseName(spec))
                if ((this.skipEnvImport(spec)) == false) {
                    if ((has userFiles base) == false) {
                        def gal:string (this.galleryFileByBase(base))
                        if ((strlen gal) > 0) {
                            this.setUserFile(base gal)
                            push queue base
                        }
                    }
                }
                s = (s + 1)
            }
            i = (i + 1)
        }
    }

    fn openDiskPath:boolean (path:string) {
        this.clearUserFiles()
        lastOpenPath = path
        def g:CodeGraph (CodeGraphBuilder.fromAny(path))
        if ((indexOf g.title " FAIL ") >= 0) {
            status = g.title
            this.refreshChrome()
            return false
        }
        if ((g.classCount()) == 0) {
            status = ("no classes in " + path)
            this.refreshChrome()
            return false
        }
        def name:string (this.fileBaseName(path))
        if ((strlen name) == 0) {
            name = path
        }
        def shown:boolean (this.applyGraph(g name))
        this.loadCommits()
        return shown
    }

    fn hasCompiler:boolean () {
        return (has rootFiles "Lang.rgr")
    }

    fn hasCompilerTree:boolean () {
        return (has compilerFiles "VirtualCompiler.rgr")
    }

    fn hasGalleryTree:boolean () {
        return (has galleryFiles "css/CssCore.rgr")
    }

    fn loadSample:boolean (name:string) {
        def model:CodeGraph (new CodeGraph)
        if (name == "many") {
            model = (CodeGraphSample.manyClasses(40))
            sampleName = "many"
        } {
            model = (CodeGraphSample.shop())
            sampleName = "shop"
        }
        umlOn = true
        session = (CodeGraphSession.of(model 24))
        session.openInitial(session.pages.umlPageId(0))
        return (this.showPage())
    }

    fn applyGraph:boolean (g:CodeGraph name:string) {
        sampleName = name
        umlOn = true
        session = (CodeGraphSession.of(g 24))
        session.openInitial(session.pages.umlPageId(0))
        return (this.showPage())
    }

    fn analyzeSource:boolean (source:string filename:string) {
        ; Keep every class the compile collected. Filtering to `filename` dropped
        ; imported types (DataGrid → an empty SheetView box) even when VC had
        ; already resolved the Import. Lang.rgr / stdops / stdlib stay skipped.
        lastOpenPath = filename
        return (this.runAnalyze(source filename ""))
    }

    fn analyzeCompiler:boolean () {
        if ((this.hasCompilerTree()) == false) {
            status = "compiler sources not loaded"
            this.refreshChrome()
            return false
        }
        def ok:boolean (this.runAnalyze("" "VirtualCompiler.rgr" ""))
        if ok {
            sampleName = "compiler"
        }
        return ok
    }

    fn analyzeGallery:boolean (libName:string) {
        if ((this.hasGalleryTree()) == false) {
            status = "gallery sources not loaded"
            this.refreshChrome()
            return false
        }
        def entry:string ""
        if (libName == "css") {
            entry = "CssCore.rgr"
        }
        if (libName == "evg") {
            entry = "EVGElement.rgr"
        }
        if (libName == "zip") {
            entry = "zip_tool.rgr"
        }
        if ((strlen entry) == 0) {
            status = ("unknown gallery lib " + libName)
            this.refreshChrome()
            return false
        }
        def ok:boolean (this.runAnalyze("" entry ""))
        if ok {
            sampleName = libName
            def home:string (this.galleryHomeClass(libName))
            if ((strlen home) > 0) {
                if (session.model.hasClass(home)) {
                    session.openInitial(session.pages.classPageId(home))
                    return (this.showPage())
                }
            }
        }
        return ok
    }

    fn galleryHomeClass:string (libName:string) {
        if (libName == "css") {
            return "CssSheet"
        }
        if (libName == "evg") {
            return "EVGElement"
        }
        if (libName == "zip") {
            return "ZipReader"
        }
        return ""
    }

    fn pickSample:boolean (name:string) {
        if ((name == "shop") || (name == "many")) {
            return (this.loadSample(name))
        }
        if ((name == "css") || (name == "evg") || (name == "zip")) {
            if ((this.hasGalleryTree()) == false) {
                return (this.askHostFor(name))
            }
            return (this.analyzeGallery(name))
        }
        if (name == "cpp") {
            def hpp:string "zip_writer.hpp"
            if (has exampleFiles hpp) {
                def ok:boolean (this.analyzeText((unwrap (get exampleFiles hpp)) hpp))
                if ok {
                    this.settleSample("cpp")
                }
                return ok
            }
            def diskHpp:string "gallery/uast/fixtures/cpp/zip_writer.hpp"
            ; Bound first: `strlen` straight on an async call's result is
            ; emitted as `await f().length` in the browser bundle.
            def hppText:string (this.readDisk("gallery/uast/fixtures/cpp" "zip_writer.hpp"))
            if ((strlen hppText) == 0) {
                return (this.askHostFor(name))
            }
            def okDisk:boolean (this.openDiskPath(diskHpp))
            if okDisk {
                this.settleSample("cpp")
            }
            return okDisk
        }
        if (name == "compiler") {
            if ((this.hasCompilerTree()) == false) {
                return (this.askHostFor(name))
            }
            return (this.analyzeCompiler())
        }
        if (name == "diff-calls") {
            if ((has exampleFiles "calls.rgr") == false) {
                return (this.askHostFor(name))
            }
            if ((has exampleFiles "calls_v2.rgr") == false) {
                return (this.askHostFor(name))
            }
            def okDiff:boolean (this.diffSources((unwrap (get exampleFiles "calls.rgr")) "calls.rgr" (unwrap (get exampleFiles "calls_v2.rgr")) "calls_v2.rgr"))
            if okDiff {
                this.settleSample("diff-calls")
            }
            return okDiff
        }
        if (has exampleFiles name) {
            return (this.analyzeText((unwrap (get exampleFiles name)) name))
        }
        if (has userFiles name) {
            return (this.analyzeSource((unwrap (get userFiles name)) name))
        }
        ; An example the page ships but has not fetched yet (`animals.rgr`
        ; before the first pick of it).
        if ((name == "calls.rgr") || (name == "animals.rgr")) {
            return (this.askHostFor(name))
        }
        ; The "opened ·" item: a path on the real disk, which is what Open
        ; and Git URL leave behind. Picking it again re-reads it.
        if (name == openedItem) {
            return (this.openDiskPath(name))
        }
        status = ("no source for " + name)
        this.refreshChrome()
        return false
    }

    ; The sources for `name` are not in the VFS. Leave the request for the
    ; host and say so on the status line; a host without one (the desktop
    ; loads everything up front) sees the message and nothing else.
    fn askHostFor:boolean (name:string) {
        pendingSample = name
        status = ("loading " + name + "…")
        this.refreshChrome()
        return false
    }

    fn runAnalyze:boolean (source:string filename:string filter:string) {
        def g:CodeGraph (this.compileGraph(source filename filter))
        if ((indexOf g.title " FAIL ") >= 0) {
            status = (substring g.title ((indexOf g.title " FAIL ") + 6) (strlen g.title))
            this.refreshChrome()
            return false
        }
        return (this.applyGraph(g g.title))
    }

    ; Compile `source` (or the VFS entry `filename` when source is empty)
    ; and walk it into a graph. A failure comes back as an empty graph
    ; titled "<file> FAIL <reason>", the same shape CodeGraphBuilder uses.
    fn compileGraph:CodeGraph (source:string filename:string filter:string) {
        def bad (new CodeGraph)
        if ((this.hasCompiler()) == false) {
            bad.title = (filename + " FAIL compiler libraries not loaded")
            return bad
        }
        def fname:string filename
        if ((strlen fname) == 0) {
            fname = "example.rgr"
        }
        bad.title = (fname + " FAIL compile failed")
        if ((strlen source) == 0) {
            if ((strlen filter) > 0) {
                bad.title = (fname + " FAIL no source")
                return bad
            }
        }
        status = ("compiling " + fname + "…")
        def env:InputEnv (new InputEnv)
        env.use_real = false
        def fs:InputFSFolder (new InputFSFolder)
        fs.name = ""
        env.filesystem = fs
        env.setEnv("RANGER_LIB" "/;/lib/;/compiler/;/gallery/css/;/gallery/evg/;/gallery/zip/")
        def params:CmdParams (new CmdParams)
        push params.values fname
        set params.params "l" "es6"
        set params.params "o" "ignored.js"
        set params.flags "no-color" true
        env.commandLine = params
        def rootNames:[string] (keys rootFiles)
        def ri:int 0
        while (ri < (array_length rootNames)) {
            def rn:string (itemAt rootNames ri)
            create_file fs rn (unwrap (get rootFiles rn))
            ri = (ri + 1)
        }
        if ((strlen source) > 0) {
            create_file fs fname (this.rewriteRelativeImports(source))
        }
        this.installUserTree(fs)
        def libF@(optional):InputFSFolder (create_folder fs "lib")
        if (null? libF) {
            bad.title = (fname + " FAIL could not create lib folder")
            return bad
        }
        def libDir:InputFSFolder (unwrap libF)
        def libNames:[string] (keys libFiles)
        def li:int 0
        while (li < (array_length libNames)) {
            def ln:string (itemAt libNames li)
            create_file libDir ln (unwrap (get libFiles ln))
            li = (li + 1)
        }
        this.installCompilerTree(fs)
        this.installGalleryTree(fs)
        env.setResolver((this.makeVfsResolver()))
        def vc:VirtualCompiler (new VirtualCompiler)
        def res:CompilerResults (vc.run(env))
        def errText:string (this.compilerErrorText(res))
        if res.hasErrors {
            bad.title = (fname + " FAIL " + errText)
            return bad
        }
        def ctx@(optional):RangerAppWriterContext res.ctx
        if (null? ctx) {
            bad.title = (fname + " FAIL no compiler context")
            return bad
        }
        def appCtx:RangerAppWriterContext (unwrap ctx)
        if ((array_length appCtx.compilerErrors) > 0) {
            bad.title = (fname + " FAIL " + errText)
            return bad
        }
        def b (new CodeGraphBuilder)
        b.fileFilter = filter
        def g:CodeGraph (b.fromContext(appCtx))
        g.title = fname
        if ((g.classCount()) == 0) {
            bad.title = (fname + " FAIL no classes in compiled source")
            return bad
        }
        return g
    }

    ; --- diff ----------------------------------------------------------------

    ; Two versions of one program, both handed over as text — the browser
    ; page's diff example, or two uploads. Each is compiled through the
    ; VFS like Analyze; the result opens on the diff summary.
    fn diffSources:boolean (baseText:string baseName:string headText:string headName:string) {
        def base:CodeGraph (this.compileGraph(baseText baseName ""))
        if ((indexOf base.title " FAIL ") >= 0) {
            status = (substring base.title ((indexOf base.title " FAIL ") + 6) (strlen base.title))
            this.refreshChrome()
            return false
        }
        def head:CodeGraph (this.compileGraph(headText headName ""))
        if ((indexOf head.title " FAIL ") >= 0) {
            status = (substring head.title ((indexOf head.title " FAIL ") + 6) (strlen head.title))
            this.refreshChrome()
            return false
        }
        ; Both compiles named their entry differently; the diff matches
        ; classes by name and files by path, so the head file's name is
        ; the one the base side's classes have to carry.
        CodeGraphGit.renameFile(base baseName headName)
        lastOpenPath = headName
        return (this.applyDiffSession((CodeGraphSession.ofDiff(base head ((baseName + " → ") + headName) 24)) headName))
    }

    ; `spec` is what git takes: "a1b2c3d..HEAD", "v1..v2", or "HEAD~1"
    ; for that commit against the working tree. The entry is whatever
    ; Open or Git URL opened last.
    fn analyzeGitDiff:boolean (spec:string) {
        if (gitEnabled == false) {
            status = "git diff runs in the desktop app or the CLI: npm run codegraph:analyze -- <path> --diff=base..head, or --pr=N"
            this.refreshChrome()
            return false
        }
        if ((strlen lastOpenPath) == 0) {
            status = "open a file, a directory or a Git URL first, then pick commits or a pull request"
            this.refreshChrome()
            return false
        }
        if ((strlen spec) == 0) {
            status = "diff needs two revisions: base..head, base for the working tree, or a pull request # / URL"
            this.refreshChrome()
            return false
        }
        status = (("comparing " + spec) + "…")
        this.refreshChrome()
        def git (new CodeGraphGit)
        def s:CodeGraphSession (new CodeGraphSession)
        if (CodeGraphGit.isPullRequestSpec(spec)) {
            s = (git.diffPullRequest(lastOpenPath spec 24))
        } {
            s = (git.diffSession(lastOpenPath spec 24))
        }
        if ((s.model.classCount()) == 0) {
            status = git.lastError
            if ((strlen status) == 0) {
                status = s.status
            }
            this.refreshChrome()
            return false
        }
        def ok:boolean (this.applyDiffSession(s sampleName))
        if ok {
            status = ((status + " · ") + (to_string (array_length git.changedFiles)) + " files in git diff")
            if ((array_length commitList) == 0) {
                this.loadCommits()
            }
            this.showComparedCommits(git.lastBase git.lastHead)
            this.refreshChrome()
        }
        return ok
    }

    fn applyDiffSession:boolean (s:CodeGraphSession name:string) {
        sampleName = name
        umlOn = true
        session = s
        sourcePath = ""
        def shown:boolean (this.showPage())
        status = ((session.diff.label + ": ") + (session.diff.describe()))
        this.refreshChrome()
        return shown
    }

    fn fillResolverMap:void (r:InputFileResolver src:[string:string]) {
        def names:[string] (keys src)
        def i:int 0
        while (i < (array_length names)) {
            def n:string (itemAt names i)
            r.putFile(n (unwrap (get src n)))
            i = (i + 1)
        }
    }

    ; Import prep looks up a literal filename in libraryPaths. Anything the
    ; flatten-into-VFS walk missed is still reachable if the host kept the
    ; original directories — mergeImports then asks this resolver.
    fn makeVfsResolver:InputFileResolver () {
        def r (new InputFileResolver)
        this.fillResolverMap(r rootFiles)
        this.fillResolverMap(r libFiles)
        this.fillResolverMap(r compilerFiles)
        this.fillResolverMap(r userFiles)
        this.fillResolverMap(r galleryFiles)
        def i:int 0
        while (i < (array_length vfsHostDirs)) {
            r.addHostDir((itemAt vfsHostDirs i))
            i = (i + 1)
        }
        return r
    }

    fn installUserTree:void (fs:InputFSFolder) {
        def names:[string] (keys userFiles)
        def i:int 0
        while (i < (array_length names)) {
            def n:string (itemAt names i)
            create_file fs n (unwrap (get userFiles n))
            i = (i + 1)
        }
    }

    fn installCompilerTree:void (fs:InputFSFolder) {
        def names:[string] (keys compilerFiles)
        if ((array_length names) == 0) {
            return
        }
        def compF@(optional):InputFSFolder (create_folder fs "compiler")
        if (null? compF) {
            return
        }
        def compDir:InputFSFolder (unwrap compF)
        def i:int 0
        while (i < (array_length names)) {
            def n:string (itemAt names i)
            create_file compDir n (unwrap (get compilerFiles n))
            i = (i + 1)
        }
    }

    fn installGalleryTree:void (fs:InputFSFolder) {
        def names:[string] (keys galleryFiles)
        if ((array_length names) == 0) {
            return
        }
        def galF@(optional):InputFSFolder (create_folder fs "gallery")
        if (null? galF) {
            return
        }
        def gallery:InputFSFolder (unwrap galF)
        def i:int 0
        while (i < (array_length names)) {
            def rel:string (itemAt names i)
            def cut:int (this.slashIn(rel))
            if (cut > 0) {
                def dirName:string (substring rel 0 cut)
                def fileName:string (substring rel (cut + 1) (strlen rel))
                def subF@(optional):InputFSFolder (create_folder gallery dirName)
                if ((null? subF) == false) {
                    def sub:InputFSFolder (unwrap subF)
                    create_file sub fileName (unwrap (get galleryFiles rel))
                }
            }
            i = (i + 1)
        }
    }

    fn slashIn:int (s:string) {
        def i:int 0
        def cut:int -1
        while (i < (strlen s)) {
            if ((charAt s i) == (ccode "/")) {
                cut = i
            }
            i = (i + 1)
        }
        return cut
    }

    fn compilerErrorText:string (res:CompilerResults) {
        def ctx@(optional):RangerAppWriterContext res.ctx
        if ((null? ctx) == false) {
            def appCtx:RangerAppWriterContext (unwrap ctx)
            if ((array_length appCtx.compilerErrors) > 0) {
                def err:RangerCompilerMessage (itemAt appCtx.compilerErrors 0)
                if ((strlen err.description) > 0) {
                    return err.description
                }
            }
        }
        if ((strlen res.errorMessage) > 0) {
            return res.errorMessage
        }
        return "compile failed"
    }

    ; --- graph page ---------------------------------------------------------

    fn showPage:boolean () {
        graph = (session.graph())
        editor = (FlowEditor.of(graph))
        editor.setSize(viewW viewH)
        editor.view.notation = "uml"
        editor.view.showMinimap = false
        ; The floating − % + Fit bar is RangerFlow's own chrome, the same pill
        ; Rafi and Rave sit over the board. Node tools stay off: this canvas
        ; opens a class, it does not connect or delete boxes.
        editor.view.showControls = true
        editor.view.showNodeTools = false
        editor.fitView()
        if (session.selectsOnly()) {
            editor.ensureMinZoom(1.0)
        }
        this.framePageFocus()
        status = session.status
        this.refreshChrome()
        this.revealPageSource()
        return true
    }

    fn framePageFocus:void () {
        def id:string session.pageId
        def focus:string ""
        if ((indexOf id "class:") == 0) {
            focus = (substring id 6 (strlen id))
        }
        if ((indexOf id "method:") == 0) {
            focus = (substring id 7 (strlen id))
        }
        if ((strlen focus) == 0) {
            return
        }
        if ((graph.hasNode(focus)) == false) {
            return
        }
        graph.clearSelection()
        def n:FlowNode (graph.nodeById(focus))
        n.selected = true
        if ((editor.selectedTitlePx()) < 10.0) {
            this.zoomToSelected()
        }
    }

    fn dressClassSearch:void () {
        ; The measurement and the drawing have to agree about the font, or the
        ; caret lands beside the letter it is supposed to be in front of.
        ; 13px is what `.ui-input-text` says in codegraph.css.
        classSearch.fontSize = 13.0
        classSearch.build()
        this.markClassSearch()
    }

    fn markClassSearch:void () {
        def searchEl:EVGElement (unwrap classSearch.rootEl)
        UiTree.addClass(searchEl "cg-class-search")
        this.placeSearchCaret()
        this.placeFieldCaret(prField)
    }

    ; `InputCtl.build()` makes the caret element but cannot place it: where a
    ; caret sits is a measurement of the text in front of it, and a control
    ; has no measurer. The page owns that — gallery/ui's form demos do the
    ; same — and without it the bar stayed pinned to the left edge of the
    ; field however far into the word you had typed or arrowed.
    fn placeSearchCaret:void () {
        this.placeFieldCaret(classSearch)
    }

    fn placeFieldCaret:void (field:InputCtl) {
        def car:EVGElement (unwrap field.caretEl)
        if (ui.focusId != field.tid) {
            ; Two carets on a page is two claims about where typing goes.
            car.width = (EVGUnit.px(0.0))
            car.markInline("width")
            return
        }
        car.width = (EVGUnit.px(1.0))
        car.markInline("width")
        def eng:EVGTextEngine (caretMeasurer.getTextEngine())
        def cx:double (field.caretXAt(eng field.caret))
        car.left = (EVGUnit.px((cx - field.scrollX)))
        car.markInline("left")
    }

    fn setClassFilter:void (q:string) {
        classSearch.value = q
        classSearch.caret = (strlen q)
        classSearch.anchor = (strlen q)
        this.dressClassSearch()
        this.refreshClasses()
    }

    fn listedClassNames:[string] () {
        def raw:[string] (session.model.classNames())
        def sorted:[string] (this.sortClassNames(raw))
        def q:string (to_lowercase classSearch.value)
        if ((strlen q) == 0) {
            return sorted
        }
        def out:[string]
        def i:int 0
        while (i < (array_length sorted)) {
            def n:string (itemAt sorted i)
            if ((indexOf (to_lowercase n) q) >= 0) {
                push out n
            }
            i = (i + 1)
        }
        return out
    }

    fn sortClassNames:[string] (names:[string]) {
        def out:[string]
        def i:int 0
        while (i < (array_length names)) {
            push out (itemAt names i)
            i = (i + 1)
        }
        def n:int (array_length out)
        def a:int 0
        while (a < n) {
            def b:int (a + 1)
            while (b < n) {
                def x:string (itemAt out a)
                def y:string (itemAt out b)
                if (this.classNameBefore(y x)) {
                    set_at out a y
                    set_at out b x
                }
                b = (b + 1)
            }
            a = (a + 1)
        }
        return out
    }

    ; Ranger's `<` is for numbers. Alphabetical order is a loop over the two
    ; strings, case-folded so SheetView sits with sheetView.
    fn classNameBefore:boolean (a:string b:string) {
        def la:string (to_lowercase a)
        def lb:string (to_lowercase b)
        def n:int (strlen la)
        if ((strlen lb) < n) {
            n = (strlen lb)
        }
        def i:int 0
        while (i < n) {
            def ca:int (charAt la i)
            def cb:int (charAt lb i)
            if (ca < cb) {
                return true
            }
            if (ca > cb) {
                return false
            }
            i = (i + 1)
        }
        return ((strlen la) < (strlen lb))
    }

    fn classList:string () {
        def names:[string] (this.listedClassNames())
        return (join names "\n")
    }

    fn titleText:string () {
        return session.model.title
    }

    fn pageId:string () {
        return session.pageId
    }

    fn pageTitle:string () {
        def p:CodePage (session.currentPage())
        return p.title
    }

    fn crumb:string () {
        def p:CodePage (session.currentPage())
        def where:string ((p.kind + " / ") + p.title)
        return ((CodeGraphApp.elide(session.model.title 96) + "  ·  ") + where)
    }

    ; A clone lands in a temp directory whose name is longer than the window.
    ; Keep the head and the tail — the tail is the part that says which file.
    sfn elide:string (text:string maxLen:int) {
        def n:int (strlen text)
        if (n <= maxLen) {
            return text
        }
        def tail:int (idiv (maxLen * 2) 3)
        def head:int ((maxLen - tail) - 1)
        if (head < 1) {
            head = 1
        }
        return (((substring text 0 head) + "…") + (substring text (n - tail) n))
    }

    fn statusText:string () {
        return status
    }

    fn sampleId:string () {
        return sampleName
    }

    fn umlView:boolean () {
        return umlOn
    }

    fn canBack:boolean () {
        return (session.canBack())
    }

    fn canForward:boolean () {
        return (session.canForward())
    }

    fn openClass:boolean (name:string) {
        if ((session.model.hasClass(name)) == false) {
            return false
        }
        if (session.goTo(session.pages.classPageId(name))) {
            return (this.showPage())
        }
        return false
    }

    fn openMethod:boolean (id:string) {
        if ((session.model.hasMethod(id)) == false) {
            return false
        }
        if (session.goTo(session.pages.methodPageId(id))) {
            return (this.showPage())
        }
        return false
    }

    fn goOverview:boolean () {
        def next:string (session.pages.overviewId(0))
        if umlOn {
            next = (session.pages.umlPageId(0))
        }
        if (session.diff.active) {
            next = (session.pages.diffPageId(0))
        }
        if (session.goTo(next)) {
            return (this.showPage())
        }
        return false
    }

    fn setUml:boolean (on:boolean) {
        if (on == umlOn) {
            return false
        }
        umlOn = on
        def next:string (session.pages.overviewId(0))
        if umlOn {
            next = (session.pages.umlPageId(0))
        }
        session.goTo(next)
        return (this.showPage())
    }

    fn goBack:boolean () {
        if (session.goBack()) {
            return (this.showPage())
        }
        return false
    }

    fn goForward:boolean () {
        if (session.goForward()) {
            return (this.showPage())
        }
        return false
    }

    fn fitView:void () {
        editor.fitView()
    }

    fn zoomToSelected:boolean () {
        return (editor.zoomToSelected(0.3))
    }

    fn hasSelection:boolean () {
        return ((strlen (editor.selectedNodeId())) > 0)
    }

    fn selectedId:string () {
        return (editor.selectedNodeId())
    }

    fn viewGesture:boolean () {
        return (editor.viewGesture())
    }

    fn sceneName:string () {
        return session.pageId
    }

    ; --- source pane --------------------------------------------------------

    fn inSource:boolean (px:double py:double) {
        if (px < sourceX) {
            return false
        }
        if (py < sourceY) {
            return false
        }
        if (px >= (sourceX + sourceW)) {
            return false
        }
        if (py >= (sourceY + sourceH)) {
            return false
        }
        return true
    }

    fn isSplitSep:boolean (id:string) {
        if ((split.sepIndex(id)) >= 0) {
            return true
        }
        return false
    }

    fn revealPageSource:void () {
        def id:string session.pageId
        if ((indexOf id "class:") == 0) {
            def name:string (substring id 6 (strlen id))
            this.revealClass(name)
            return
        }
        if ((indexOf id "method:") == 0) {
            def mid:string (substring id 7 (strlen id))
            this.revealMethod(mid)
            return
        }
    }

    fn revealClass:void (name:string) {
        if ((session.model.hasClass(name)) == false) {
            this.revealAt("" 0)
            return
        }
        def c:CodeClass (session.model.classByName(name))
        this.revealAtSide(c.fileName c.startLine ((session.diff.statusOfClass(name)) == "removed"))
    }

    fn revealMethod:void (mid:string) {
        if ((session.model.hasMethod(mid)) == false) {
            this.revealAt("" 0)
            return
        }
        def m:CodeMethod (session.model.methodById(mid))
        this.revealAtSide(m.fileName m.startLine ((session.diff.statusOfMethod(mid)) == "removed"))
    }

    fn revealField:void (className:string fieldName:string) {
        if ((session.model.hasClass(className)) == false) {
            return
        }
        def c:CodeClass (session.model.classByName(className))
        def i:int 0
        while (i < (array_length c.fields)) {
            def f:CodeField (itemAt c.fields i)
            if (f.name == fieldName) {
                def path:string f.fileName
                if ((strlen path) == 0) {
                    path = c.fileName
                }
                this.revealAtSide(path f.startLine ((session.diff.statusOfField(className fieldName)) == "removed"))
                return
            }
            i = (i + 1)
        }
        this.revealClass(className)
    }

    fn revealHit:void (lx:double ly:double) {
        def fx:double (editor.flowX(lx))
        def fy:double (editor.flowY(ly))
        def ni:int (graph.nodeAtPoint(fx fy))
        if (ni < 0) {
            return
        }
        def n:FlowNode (graph.nodeAt(ni))
        def classBox:boolean false
        if (n.dataKind == "umlclass") {
            classBox = true
        }
        if (n.dataKind == "class") {
            classBox = true
        }
        if classBox {
            def row:int (editor.rowAtPoint(n fy))
            if ((strlen (session.pages.moreRowKind(n.id row))) > 0) {
                this.showMembers(n.id)
                return
            }
            def fname:string (session.pages.fieldNameAtRow(n.id row))
            def mid:string (session.pages.methodIdAtRow(n.id row))
            if ((strlen mid) > 0) {
                this.revealMethod(mid)
                return
            }
            if ((strlen fname) > 0) {
                this.revealField(n.id fname)
                return
            }
            def ref:string n.dataRef
            if ((strlen ref) == 0) {
                ref = n.id
            }
            this.revealClass(ref)
            return
        }
        if (session.model.hasMethod(n.id)) {
            this.revealMethod(n.id)
            return
        }
        if (session.model.hasClass(n.id)) {
            this.revealClass(n.id)
        }
    }

    fn revealAt:void (fileName:string startLine:int) {
        this.revealAtSide(fileName startLine false)
    }

    ; With a diff open, a file the change touched is shown merged: the
    ; new text with the removed lines still in place, added lines green
    ; and removed ones red. `old` says the line is counted on the old
    ; side (a removed member), so it lands on its red rows.
    fn revealAtSide:void (fileName:string startLine:int old:boolean) {
        def src:string (this.sourceTextOf(fileName))
        if ((strlen src) == 0) {
            src = (this.missingSourceNote(fileName))
        }
        def line:int (this.bufferLine(fileName startLine))
        def marks:[int]
        def inDiff:boolean false
        if (session.diff.active) {
            if (session.diff.hasFileDiff(fileName)) {
                def ld:LineDiffResult (session.diff.fileDiffOf(fileName))
                src = (ld.mergedText())
                marks = (ld.marks())
                inDiff = true
                if old {
                    line = (ld.rowOfOldLine(line))
                } {
                    line = (ld.rowOfNewLine(line))
                }
            }
        }
        if ((sourcePath != fileName) || (sourceDiffShown != inDiff)) {
            sourcePath = fileName
            sourceDiffShown = inDiff
            codeView.init(src)
            def lang:EditorLanguage (languages.forFile(fileName))
            codeView.setLanguage(lang)
            codeView.setLineMarks(marks)
        }
        codeView.moveCaret(line 0 false)
        ; `ensureCaretVisible` pins the caret on the last row, so the
        ; method body would sit one line below the fold. Jump on the next
        ; paint, after `setBounds` has the real pane height, with a couple
        ; of lines of context so the declaration is near the top.
        sourceJump = true
    }

    fn applySourceJump:void () {
        if (sourceJump == false) {
            return
        }
        sourceJump = false
        codeView.layout.syncMetrics(codeTr)
        def line:int codeView.sel.caret.line
        def top:int (line - 2)
        if (top < 0) {
            top = 0
        }
        codeView.layout.jumpToLine(codeView.buf top)
    }

    fn bufferLine:int (fileName:string startLine:int) {
        def n:int startLine
        if (this.isRgr(fileName)) {
            if (n < 0) {
                n = 0
            }
            return n
        }
        if (n > 0) {
            n = (n - 1)
        }
        if (n < 0) {
            n = 0
        }
        return n
    }

    fn missingSourceNote:string (fileName:string) {
        def out:string "; No source to show for this class."
        if ((strlen fileName) > 0) {
            out = (("; No source found for " + fileName) + ".")
        }
        out = (out + "\n; Shop is a fixture — open a .rgr, .ts or .cpp file to see code here.")
        return out
    }

    fn sourceTextOf:string (path:string) {
        if ((strlen path) == 0) {
            return ""
        }
        def p:string (this.slashPath(path))
        def base:string (this.fileBaseName(p))
        ; What the analyser read is the truth. A class from an import names
        ; its file the way the import wrote it (`../../vela/src/VlJson.rgr`);
        ; no amount of re-rooting finds that on disk from here.
        def carried:string (session.model.sourceOf(p))
        if ((strlen carried) > 0) {
            return carried
        }
        if (has userFiles p) {
            return (unwrap (get userFiles p))
        }
        if (has userFiles base) {
            return (unwrap (get userFiles base))
        }
        if (has exampleFiles base) {
            return (unwrap (get exampleFiles base))
        }
        if (has galleryFiles p) {
            return (unwrap (get galleryFiles p))
        }
        def dir:string (this.fileDirName(p))
        def disk:string (this.readDisk(dir base))
        if ((strlen disk) > 0) {
            return disk
        }
        if ((strlen lastOpenPath) > 0) {
            def openDir:string (this.fileDirName(lastOpenPath))
            def beside:string (this.readDisk(openDir base))
            if ((strlen beside) > 0) {
                return beside
            }
            if ((this.fileBaseName(lastOpenPath)) == base) {
                def opened:string (this.readDisk(openDir base))
                if ((strlen opened) > 0) {
                    return opened
                }
            }
        }
        return (this.readDisk("." base))
    }

    ; --- canvas pointer (page coordinates) ----------------------------------

    fn inCanvas:boolean (px:double py:double) {
        if (px < canvasX) {
            return false
        }
        if (py < canvasY) {
            return false
        }
        if (px >= (canvasX + canvasW)) {
            return false
        }
        if (py >= (canvasY + canvasH)) {
            return false
        }
        return true
    }

    fn localX:double (px:double) {
        return (px - canvasX)
    }

    fn localY:double (py:double) {
        return (py - canvasY)
    }

    fn graphDown:void (px:double py:double shift:boolean ctrl:boolean) {
        shiftOn = shift
        ctrlOn = ctrl
        input.x = (this.localX(px))
        input.y = (this.localY(py))
        input.shift = shift
        input.ctrl = ctrl
        input.secondary = false
        editor.pointerDown(input)
    }

    fn graphMove:void (px:double py:double shift:boolean ctrl:boolean) {
        input.x = (this.localX(px))
        input.y = (this.localY(py))
        input.shift = shift
        input.ctrl = ctrl
        editor.pointerMove(input)
    }

    fn graphUp:void (px:double py:double shift:boolean ctrl:boolean) {
        input.x = (this.localX(px))
        input.y = (this.localY(py))
        input.shift = shift
        input.ctrl = ctrl
        editor.pointerUp(input)
        if (editor.onGraphChanged) {
            editor.onGraphChanged = false
            CodeGraphFlow.repairRoutes(graph)
        }
        def lx:double input.x
        def ly:double input.y
        def dbl:boolean false
        def dt:double (clockMs - lastClickMs)
        if (dt < 400.0) {
            def dx:double (lx - lastClickX)
            def dy:double (ly - lastClickY)
            if (((dx * dx) + (dy * dy)) < 36.0) {
                dbl = true
            }
        }
        lastClickMs = clockMs
        lastClickX = lx
        lastClickY = ly
        if dbl {
            this.openAt(lx ly)
            editor.clicks.clear()
            this.refreshChrome()
            this.revealPageSource()
            return
        }
        def n:int (editor.clicks.count())
        def i:int 0
        def moved:boolean false
        while (i < n) {
            def ev:FlowHitEvent (editor.clicks.at(i))
            if (session.handleClick(ev)) {
                moved = true
            }
            i = (i + 1)
        }
        if moved {
            this.showPage()
        } {
            this.revealHit(lx ly)
            this.refreshChrome()
        }
        editor.clicks.clear()
    }

    fn graphWheel:void (px:double py:double delta:double) {
        input.x = (this.localX(px))
        input.y = (this.localY(py))
        editor.wheel(input delta)
    }

    fn wheelGesture:void (x:double y:double dx:double dy:double pinch:boolean lineMode:boolean) {
        editor.wheelGesture(x y dx dy pinch lineMode)
    }

    fn pointerDown:void (x:double y:double shift:boolean ctrl:boolean) {
        graphDrag = false
        sourceDrag = false
        splitDrag = false
        def id:string (this.hitId(x y))
        ; The drawer is out of the flow and in front, but not modal: a press
        ; on it is its own, anything beside it goes where it always went.
        if (members.drawer.owns(id)) {
            this.press(id)
            return
        }
        if (this.isSplitSep(id)) {
            splitDrag = true
            splitDragI = (split.sepIndex(id))
            splitAt = x
            ui.click(id)
            return
        }
        if (this.inSource(x y)) {
            sourceDrag = true
            codeView.focused = true
            codeView.pointerDown(codeTr (to_int x) (to_int y) shift)
            return
        }
        if (this.inCanvas(x y)) {
            graphDrag = true
            this.graphDown(x y shift ctrl)
            return
        }
        this.press(id)
    }

    fn pointerMove:void (x:double y:double shift:boolean ctrl:boolean) {
        if splitDrag {
            def dx:double (x - splitAt)
            if (dx == 0.0) {
                return
            }
            splitAt = x
            def w:double splitW
            if (w < 1.0) {
                w = pageW
            }
            if (w < 1.0) {
                w = 1.0
            }
            split.resizeBy(splitDragI ((dx * 100.0) / w))
            this.dressSplit()
            this.estimatePaneSizes()
            return
        }
        if sourceDrag {
            codeView.pointerDrag(codeTr (to_int x) (to_int y))
            return
        }
        if graphDrag {
            this.graphMove(x y shift ctrl)
            return
        }
        if (this.inCanvas(x y)) {
            this.graphMove(x y shift ctrl)
        }
    }

    fn pointerUp:void (x:double y:double shift:boolean ctrl:boolean) {
        if splitDrag {
            splitDrag = false
            this.dressSplit()
            return
        }
        if sourceDrag {
            sourceDrag = false
            this.sourceClick(x y)
            return
        }
        if graphDrag {
            graphDrag = false
            this.graphUp(x y shift ctrl)
            return
        }
        if (this.inCanvas(x y)) {
            this.graphUp(x y shift ctrl)
        }
    }

    ; A double-click in the source takes the word under the pointer, and if
    ; the graph has a class by that name the chart goes there. Reading a file
    ; and wanting to see what a type is made of is the same question the rail
    ; answers; this is the same answer, without leaving the line you are on.
    fn sourceClick:void (x:double y:double) {
        def dt:double (clockMs - lastClickMs)
        def dx:double (x - lastClickX)
        def dy:double (y - lastClickY)
        def dbl:boolean false
        if (dt < 400.0) {
            if (((dx * dx) + (dy * dy)) < 36.0) {
                dbl = true
            }
        }
        lastClickMs = clockMs
        lastClickX = x
        lastClickY = y
        if (dbl == false) {
            return
        }
        codeView.selectWordAt(codeTr (to_int x) (to_int y))
        def word:string (codeView.selectionText())
        if ((this.openWord(word)) == false) {
            return
        }
        this.refreshChrome()
    }

    ; The word as written, then without a leading `*`/`&` and a trailing `*`,
    ; which is how a C++ file spells a type in a declaration.
    fn openWord:boolean (word:string) {
        def name:string (CodeGraphApp.trimWord(word))
        if ((strlen name) == 0) {
            return false
        }
        if ((session.model.hasClass(name)) == false) {
            return false
        }
        if ((this.pageId()) == ("class:" + name)) {
            return false
        }
        return (this.openClass(name))
    }

    sfn trimWord:string (word:string) {
        def s:string word
        while ((strlen s) > 0) {
            def last:int (charAt s ((strlen s) - 1))
            if ((last == 42) || ((last == 38) || ((last == 32) || ((last == 9) || ((last == 58) || (last == 59)))))) {
                s = (substring s 0 ((strlen s) - 1))
            } {
                break
            }
        }
        while ((strlen s) > 0) {
            def first:int (charAt s 0)
            if ((first == 42) || ((first == 38) || ((first == 32) || ((first == 9) || (first == 58))))) {
                s = (substring s 1 (strlen s))
            } {
                break
            }
        }
        return s
    }

    fn wheel:void (x:double y:double delta:double) {
        if (members.isOpen()) {
            if (members.drawer.owns((this.hitId(x y)))) {
                members.drawer.scrollBy(delta)
                return
            }
        }
        if (this.inCanvas(x y)) {
            this.graphWheel(x y delta)
            return
        }
        if (this.inSource(x y)) {
            def notches:int 1
            if (delta < 0.0) {
                notches = -1
            }
            def lines:int (to_int (delta / 20.0))
            if (lines == 0) {
                lines = notches
            }
            codeView.scrollBy((0 - lines))
            return
        }
        this.scrollClassList(delta)
    }

    fn scrollClassList:void (delta:double) {
        def top:double (classScrollEl.scrollTop + delta)
        if (top < 0.0) {
            top = 0.0
        }
        def max:double (classScrollEl.maxScrollTop())
        if (top > max) {
            top = max
        }
        classScrollEl.scrollTop = top
    }

    fn methodAt:string (nodeId:string flowY:double) {
        if ((graph.hasNode(nodeId)) == false) {
            return ""
        }
        def n:FlowNode (graph.nodeById(nodeId))
        def row:int (editor.rowAtPoint(n flowY))
        return (session.pages.methodIdAtRow(nodeId row))
    }

    fn openAt:boolean (x:double y:double) {
        def fx:double (editor.flowX(x))
        def fy:double (editor.flowY(y))
        def ni:int (graph.nodeAtPoint(fx fy))
        if (ni < 0) {
            return false
        }
        def n:FlowNode (graph.nodeAt(ni))
        def kind:string n.dataKind
        def classBox:boolean false
        if (kind == "umlclass") { classBox = true }
        if (kind == "class") { classBox = true }
        if classBox {
            if ((indexOf session.pageId "class:") == 0) {
                def mid:string (this.methodAt(n.id fy))
                if ((strlen mid) > 0) {
                    if (session.goTo(session.pages.methodPageId(mid))) {
                        return (this.showPage())
                    }
                }
            }
            def ref:string n.dataRef
            if ((strlen ref) == 0) {
                ref = n.id
            }
            if (session.goTo(session.pages.classPageId(ref))) {
                return (this.showPage())
            }
            return false
        }
        def ev (new FlowHitEvent)
        ev.kind = "node"
        ev.id = n.id
        ev.dataKind = n.dataKind
        ev.dataRef = n.dataRef
        if (session.handleClick(ev)) {
            return (this.showPage())
        }
        return false
    }

    ; --- EvgApp -------------------------------------------------------------

    fn hitId:string (px:double py:double) {
        ui.layout()
        this.syncPaneRects()
        def tid:string (ui.hitTest(px py))
        if ((strlen tid) > 0) {
            return tid
        }
        if (this.inCanvas(px py)) {
            return "cg-canvas"
        }
        if (this.inSource(px py)) {
            return "cg-source"
        }
        return ""
    }

    fn syncPaneRects:void () {
        def page@(optional):EVGElement ui.lastPage
        if page {
            def hit@(optional):EVGElement (ui.findEl((unwrap page) "cg-canvas"))
            if hit {
                def box:EVGElement (unwrap hit)
                canvasX = box.calculatedX
                canvasY = box.calculatedY
                canvasW = box.calculatedWidth
                canvasH = box.calculatedHeight
                if (canvasW < 8.0) {
                    canvasW = viewW
                }
                if (canvasH < 8.0) {
                    canvasH = viewH
                }
                viewW = canvasW
                viewH = canvasH
                editor.setSize(viewW viewH)
            }
            def srcHit@(optional):EVGElement (ui.findEl((unwrap page) "cg-source"))
            if srcHit {
                def sbox:EVGElement (unwrap srcHit)
                sourceX = sbox.calculatedX
                sourceY = sbox.calculatedY
                sourceW = sbox.calculatedWidth
                sourceH = sbox.calculatedHeight
                if (sourceW < 8.0) {
                    sourceW = 120.0
                }
                if (sourceH < 8.0) {
                    sourceH = canvasH
                }
            }
            def splitHit@(optional):EVGElement (ui.findEl((unwrap page) "cg-split"))
            if splitHit {
                def gbox:EVGElement (unwrap splitHit)
                splitW = gbox.calculatedWidth
                if (splitW < 1.0) {
                    splitW = pageW
                }
                clear sepX0
                clear sepX1
                def si:int 0
                while (si < ((array_length split.panels) - 1)) {
                    def sepEl@(optional):EVGElement (ui.findEl(gbox (split.sepTid(si))))
                    if sepEl {
                        def sb:EVGElement (unwrap sepEl)
                        push sepX0 sb.calculatedX
                        push sepX1 (sb.calculatedX + sb.calculatedWidth)
                    }
                    si = (si + 1)
                }
            }
        }
    }

    ; The pointer's shape, as a GridCursor kind, for a host that has a real
    ; cursor to set. A separator you can drag has to LOOK like one: the
    ; element carries `cursor: col-resize`, but a canvas host paints the page
    ; rather than laying it out in a browser, so nothing acted on that.
    fn cursorAt:int (px:double py:double) {
        if splitDrag {
            return (GridCursor.resizeX())
        }
        if (py >= canvasY) {
            if (py < (canvasY + canvasH)) {
                def i:int 0
                while (i < (array_length sepX0)) {
                    def x0:double ((itemAt sepX0 i) - 2.0)
                    def x1:double ((itemAt sepX1 i) + 2.0)
                    if ((px >= x0) && (px <= x1)) {
                        return (GridCursor.resizeX())
                    }
                    i = (i + 1)
                }
            }
        }
        if (this.inSource(px py)) {
            return (GridCursor.text())
        }
        return (GridCursor.arrow())
    }

    fn press:boolean (id:string) {
        if (id == "cg-canvas") {
            return false
        }
        if (id == "cg-source") {
            return false
        }
        if (this.isSplitSep(id)) {
            return false
        }
        if ((strlen id) == 0) {
            return false
        }
        def oldSample:string sampleSel.value
        def oldClass:string classTree.activeValue
        def oldBase:string baseSel.value
        def oldHead:string headSel.value
        ui.click(id)
        def pickedMember:string (members.consumePicked())
        if ((strlen pickedMember) > 0) {
            ; The drawer stays: the reader is walking the list.
            this.revealMember(pickedMember)
            return true
        }
        if ((baseSel.value != oldBase) || (headSel.value != oldHead)) {
            this.compareSelected()
        }
        if ((indexOf id "cg-bar-") == 0) {
            this.runToolbar(bar.rovingValue)
        }
        if (id == "cg-uml") {
            this.setUml(umlToggle.on)
        }
        if (sampleSel.value != oldSample) {
            this.pickSample(sampleSel.value)
        }
        if (classTree.activeValue != oldClass) {
            if ((strlen classTree.activeValue) > 0) {
                if (classTree.activeValue != "root") {
                    this.openClass(classTree.activeValue)
                }
            }
        }
        return true
    }

    fn runToolbar:void (op:string) {
        if (op == "open") {
            wantOpenFile = true
            return
        }
        if (op == "giturl") {
            wantOpenGitUrl = true
            return
        }
        if (op == "diff") {
            wantOpenDiff = true
            return
        }
        if (op == "back") {
            this.goBack()
            return
        }
        if (op == "fwd") {
            this.goForward()
            return
        }
        if (op == "overview") {
            this.goOverview()
            return
        }
        if (op == "fit") {
            this.fitView()
            return
        }
        if (op == "zoom") {
            this.zoomToSelected()
            this.refreshChrome()
            return
        }
        if (op == "analyze") {
            this.pickSample(sampleName)
            return
        }
        if (op == "code") {
            this.setSourceVisible(sourceHidden)
            return
        }
    }

    ; Give the source pane's share to the graph, and hand it back on the next
    ; press. `resizeBy` cascades into the panels after the separator, so the
    ; floor has to come off first — `minSize` is what stops a DRAG from
    ; swallowing a pane, and this is not a drag.
    fn setSourceVisible:boolean (on:boolean) {
        if ((array_length split.panels) < 3) {
            return false
        }
        def src:UiPanel (itemAt split.panels 2)
        if on {
            if (sourceHidden == false) {
                return false
            }
            src.minSize = sourceFloor
            split.resizeBy(1 (0.0 - sourceShare))
            sourceHidden = false
        } {
            if sourceHidden {
                return false
            }
            sourceShare = src.size
            sourceFloor = src.minSize
            src.minSize = 0.0
            split.resizeBy(1 sourceShare)
            sourceHidden = true
        }
        this.dressSplit()
        this.estimatePaneSizes()
        this.applyChromeSizes()
        this.syncToolbar()
        return true
    }

    fn sourceVisible:boolean () {
        return (sourceHidden == false)
    }

    fn consumeOpenFile:boolean () {
        if wantOpenFile {
            wantOpenFile = false
            return true
        }
        return false
    }

    fn consumeOpenGitUrl:boolean () {
        if wantOpenGitUrl {
            wantOpenGitUrl = false
            return true
        }
        return false
    }

    ; --- commits from the opened repository --------------------------------

    fn enableGit:void () {
        gitEnabled = true
    }

    fn setCommitList:void (list:[GitCommitInfo]) {
        commitList = list
        this.fillCommitSelects()
    }

    fn commitCount:int () {
        return (array_length commitList)
    }

    ; Read the log of the repository around what was opened last. Nothing
    ; happens in a host without git, or before anything is open.
    fn loadCommits:void () {
        if (gitEnabled == false) {
            return
        }
        if ((strlen lastOpenPath) == 0) {
            return
        }
        def git (new CodeGraphGit)
        gitRoot = (git.repoRootOf(lastOpenPath))
        def fresh:[GitCommitInfo]
        if ((strlen gitRoot) > 0) {
            fresh = (git.commits(gitRoot 40))
        }
        this.setCommitList(fresh)
    }

    fn fillCommitSelects:void () {
        def keepBase:string baseSel.value
        def keepHead:string headSel.value
        def noneB:[UiItem]
        baseSel.items = noneB
        def noneH:[UiItem]
        headSel.items = noneH
        if ((array_length commitList) == 0) {
            baseSel.addItem("" "(open a git checkout)" true)
            headSel.addItem("" "working tree" true)
        } {
            baseSel.addItem("" "pick a base commit…" false)
            headSel.addItem("" "working tree" false)
            def i:int 0
            while (i < (array_length commitList)) {
                def c:GitCommitInfo (itemAt commitList i)
                baseSel.addItem(c.sha (c.label()) false)
                headSel.addItem(c.sha (c.label()) false)
                i = (i + 1)
            }
        }
        baseSel.value = ""
        if ((baseSel.indexOfValue(keepBase)) >= 0) {
            baseSel.value = keepBase
        }
        headSel.value = ""
        if ((headSel.indexOfValue(keepHead)) >= 0) {
            headSel.value = keepHead
        }
        baseSel.build()
        headSel.build()
    }

    ; The two picks as a git spec — "base" alone is the working tree.
    fn selectedSpec:string () {
        def base:string baseSel.value
        if ((strlen base) == 0) {
            return ""
        }
        def head:string headSel.value
        if ((strlen head) == 0) {
            return base
        }
        return ((base + "..") + head)
    }

    fn compareSelected:boolean () {
        def spec:string (this.selectedSpec())
        if ((strlen spec) == 0) {
            status = "pick a base commit; the head is the working tree unless you pick one"
            this.refreshChrome()
            return false
        }
        return (this.analyzeGitDiff(spec))
    }

    ; After a diff, point the two selects at the commits it compared.
    fn showComparedCommits:void (baseSha:string headSha:string) {
        if ((baseSel.indexOfValue(baseSha)) >= 0) {
            baseSel.value = baseSha
        }
        if ((headSel.indexOfValue(headSha)) >= 0) {
            headSel.value = headSha
        } {
            headSel.value = ""
        }
        baseSel.build()
        headSel.build()
    }

    ; --- every member of a class ---------------------------------------------

    ; The list behind a "+ N more" row: all fields, then all methods, each
    ; with its diff status and reason when a diff is open.
    fn showMembers:boolean (name:string) {
        if ((session.model.hasClass(name)) == false) {
            return false
        }
        def c:CodeClass (session.model.classByName(name))
        def d:CodeGraphDiff session.diff
        def list:[MemberEntry]
        def added:int 0
        def removed:int 0
        def changed:int 0
        def fi:int 0
        while (fi < (array_length c.fields)) {
            def f:CodeField (itemAt c.fields fi)
            def fe (new MemberEntry)
            fe.key = ((name + ".") + f.name)
            fe.kind = "field"
            fe.name = f.name
            fe.detail = f.fieldType
            fe.status = (d.statusOfField(name f.name))
            fe.note = (d.noteOf(fe.key))
            push list fe
            fi = (fi + 1)
        }
        def mi:int 0
        while (mi < (array_length c.methodIds)) {
            def mid:string (itemAt c.methodIds mi)
            def m:CodeMethod (session.model.methodById(mid))
            def me (new MemberEntry)
            me.key = mid
            me.kind = "method"
            me.name = ((m.name + "(") + m.params + ")")
            me.detail = m.returns
            me.status = (d.statusOfMethod(mid))
            me.note = (d.noteOf(mid))
            push list me
            mi = (mi + 1)
        }
        def li:int 0
        while (li < (array_length list)) {
            def e:MemberEntry (itemAt list li)
            if (e.status == "added") { added = (added + 1) }
            if (e.status == "removed") { removed = (removed + 1) }
            if (e.status == "changed") { changed = (changed + 1) }
            li = (li + 1)
        }
        def parts:[string]
        if (changed > 0) { push parts ((to_string changed) + " changed") }
        if (added > 0) { push parts ((to_string added) + " added") }
        if (removed > 0) { push parts ((to_string removed) + " removed") }
        ; Below the header, the height of the body, in from the left edge.
        members.drawer.top = canvasY
        members.drawer.panelHeight = canvasH
        members.drawer.pageWidth = pageW
        members.showFor(name list (join parts ", "))
        ui.focus((members.drawer.closeTid()))
        return true
    }

    ; The drawer already in place, for a deep link or a host that does
    ; not tick: nothing to slide in from.
    fn showMembersSettled:boolean (name:string) {
        def ok:boolean (this.showMembers(name))
        if ok {
            members.drawer.progress = 1.0
            members.drawer.place()
        }
        return ok
    }

    ; A pick from the drawer: "Class.field" or a method id.
    fn revealMember:void (key:string) {
        if (session.model.hasMethod(key)) {
            this.revealMethod(key)
            return
        }
        def dot:int (indexOf key ".")
        if (dot > 0) {
            def cls:string (substring key 0 dot)
            def fld:string (substring key (dot + 1) (strlen key))
            this.revealField(cls fld)
        }
    }

    fn consumeOpenDiff:boolean () {
        if wantOpenDiff {
            wantOpenDiff = false
            return true
        }
        return false
    }

    fn diffActive:boolean () {
        return session.diff.active
    }

    fn diffSummary:string () {
        if (session.diff.active == false) {
            return ""
        }
        return (session.diff.describe())
    }

    fn tick:boolean (dtMs:double) {
        clockMs = (clockMs + dtMs)
        def busy:boolean (ui.tick(dtMs))
        if (members.drawer.animating()) {
            return true
        }
        return busy
    }

    fn keyWith:boolean (k:string shift:boolean ctrl:boolean) {
        if (k == "Escape") {
            if (members.isOpen()) {
                members.close()
                return true
            }
            if sampleSel.open {
                sampleSel.closeList()
                return true
            }
        }
        ; Ctrl+F puts a find bar over the source. While it is up those three
        ; keys are the bar's — everything else keeps its meaning, so the
        ; chrome still answers the arrows and the wheel.
        if (codeView.findActive()) {
            if (k == "Escape") {
                codeView.closeFind()
                return true
            }
            if (k == "Enter") {
                codeView.findNext(shift)
                return true
            }
            if (k == "Backspace") {
                codeView.findBackspace()
                return true
            }
        }
        if (ui.focusId == prField.tid) {
            if (k == "Enter") {
                this.analyzeGitDiff(prField.value)
                return true
            }
        }
        def before:string classSearch.value
        ui.keyWith(k shift ctrl)
        this.dressSplit()
        this.markClassSearch()
        if (classSearch.value != before) {
            this.refreshClasses()
        }
        return true
    }

    fn typeText:boolean (text:string) {
        return (this.typeTextWith(text false))
    }

    ; A host that knows whether Ctrl was held calls this one. SDL delivers
    ; Ctrl+letter as text with the modifier still down, which is how Ctrl+F
    ; gets here at all.
    fn typeTextWith:boolean (text:string ctrl:boolean) {
        if ((strlen text) == 0) {
            return false
        }
        if ctrl {
            def ch:int (charAt text 0)
            if ((ch == 99) || (ch == 67)) {
                clipboardText = (codeView.selectionText())
                return ((strlen clipboardText) > 0)
            }
            return (codeView.handleCtrlChar(ch))
        }
        if (codeView.findActive()) {
            return (codeView.handleText(text))
        }
        def before:string classSearch.value
        ui.type(text)
        this.markClassSearch()
        if (classSearch.value != before) {
            this.refreshClasses()
            return true
        }
        return ((strlen ui.focusId) > 0)
    }

    fn consumeClipboardText:string () {
        def t:string clipboardText
        clipboardText = ""
        return t
    }

    ; The face the source pane measures and draws with, from the bytes of
    ; a TrueType file. Without one the renderer measures every character
    ; at a bitmap font's fixed step, which is wider than the face the tab
    ; draws — the gaps between the tokens grew along the line. The SDL host
    ; opens its faces from disk instead and never calls this.
    fn loadCodeFont:boolean (family:string data:buffer) {
        def ok:boolean (codeTr.loadFontBytes(family data))
        if ok {
            codeView.fontFamily = family
            codeView.layout.syncMetrics(codeTr)
        }
        return ok
    }

    ; What the find bar has selected, so a host can say so.
    fn findStatus:string () {
        if ((codeView.findActive()) == false) {
            return ""
        }
        return (codeView.findStatus())
    }

    fn focusedField:string () {
        return ui.focusId
    }

    fn hasField:boolean (tid:string) {
        if (tid == "cg-class-filter") {
            return true
        }
        return (tid == "cg-pr")
    }

    ; The chrome, with the chart painted inside the canvas element and the
    ; source pane inside its element — registered with `paintAt` before the
    ; page is built, so both sit where those elements are in the paint
    ; order. Appending them after the page put them over every overlay: the
    ; member popup was drawn, then the chart was drawn over it.
    fn display:EVGDisplayList () {
        def page:EVGElement (ui.layout())
        this.syncPaneRects()
        def sc:FlowScene (editor.view.build())
        def graphDl:EVGDisplayList (sc.toDisplayList())
        graphDl.offsetBy(canvasX canvasY)
        def canvasDl (new EVGDisplayList)
        canvasDl.addClip(canvasX canvasY canvasW canvasH)
        canvasDl.appendFrom(graphDl)
        canvasDl.addClipEnd()
        codeView.setBounds((to_int sourceX) (to_int sourceY) (to_int sourceW) (to_int sourceH))
        this.applySourceJump()
        def blink:int (to_int (clockMs / 500.0))
        def sourceDl (new EVGDisplayList)
        codeView.paint(sourceDl codeTr blink)
        def engineLay (new EVGLayout)
        engineLay.setPageSize(ui.pageWidth ui.pageHeight)
        def dl (new EVGDisplayList)
        def te (engineLay.getTextEngine())
        dl.setTextEngine(te)
        dl.setScrollbars(ui.showScrollbars)
        dl.setScrollbarState(ui.scrollbarState)
        dl.paintAt("cg-canvas" canvasDl)
        dl.paintAt("cg-source" sourceDl)
        dl.build(page)
        return dl
    }

    fn stats:string () {
        def v:FlowView editor.view
        def out:string ("nodes=" + (to_string (graph.nodeCount())))
        out = (out + " edges=" + (to_string (graph.edgeCount())))
        out = (out + " drawn=" + (to_string v.drawnNodes))
        out = (out + " page=" + session.pageId)
        return out
    }

    fn svg:string () {
        def sc:FlowScene (editor.view.buildForExport(24.0))
        return (sc.toSvg())
    }

    fn frameJson:string () {
        return (editor.frameJson())
    }

    fn frameView:string () {
        return (editor.viewFrameJson())
    }

    fn frameScene:string () {
        return (editor.frameJson())
    }

    fn frameGrid:string () {
        return (editor.gridFrameJson())
    }

    fn sceneJson:string () {
        return (editor.sceneJson())
    }

    ; `?selftest=1` — click Order, land on its page, go back.
    fn selfTest:string () {
        if ((graph.nodeCount()) == 0) {
            return "FAIL no nodes"
        }
        this.loadSample("shop")
        editor.fitView()
        if (session.pageId != "uml:0") {
            return ("FAIL shop did not open UML (on " + session.pageId + ")")
        }
        if ((graph.hasNode("Order")) == false) {
            return "FAIL shop UML has no Order"
        }
        def n:FlowNode (graph.nodeById("Order"))
        def sx:double (editor.view.viewport.toScreenX((n.centerX())))
        def sy:double (editor.view.viewport.toScreenY((n.centerY())))
        this.graphDown((canvasX + sx) (canvasY + sy) false false)
        this.graphUp((canvasX + sx) (canvasY + sy) false false)
        if (session.pageId != "uml:0") {
            return ("FAIL click Order left UML (on " + session.pageId + ")")
        }
        if ((this.hasSelection()) == false) {
            return "FAIL click Order did not select it"
        }
        editor.view.viewport.zoom = 0.05
        if ((this.zoomToSelected()) == false) {
            return "FAIL zoom to selected"
        }
        def title0:double (n.headerHeight * editor.view.viewport.zoom)
        if (n.headerHeight > 1.0) {
            if (title0 < 9.5) {
                return ("FAIL zoomed Order title is only " + (to_string title0) + " px")
            }
        }
        def shown:double ((n.width * editor.view.viewport.zoom) / editor.view.width)
        if (shown >= 0.29) {
            return ("FAIL zoomed Order still fills " + (to_string shown) + " of the view")
        }
        def sx2:double (editor.view.viewport.toScreenX((n.centerX())))
        def sy2:double (editor.view.viewport.toScreenY((n.centerY())))
        if ((this.openAt(sx2 sy2)) == false) {
            return "FAIL double-click Order"
        }
        if (session.pageId != "class:Order") {
            return ("FAIL openAt Order stayed on " + session.pageId)
        }
        if ((graph.nodeCount()) < 3) {
            return "FAIL Order page too small"
        }
        if (graph.hasNode("Order.checkout")) {
            return "FAIL Order page still draws method stadiums"
        }
        if ((this.goBack()) == false) {
            return "FAIL back from Order"
        }
        if (session.pageId != "uml:0") {
            return ("FAIL back stayed on " + session.pageId)
        }
        if ((this.openClass("LineItem")) == false) {
            return "FAIL rail openClass LineItem"
        }
        if (session.pageId != "class:LineItem") {
            return ("FAIL rail stayed on " + session.pageId)
        }
        if ((graph.hasNode("Order")) == false) {
            return "FAIL LineItem page has no Order user"
        }
        if ((graph.hasNode("Cart")) == false) {
            return "FAIL LineItem page has no Cart user"
        }
        if ((graph.hasPort("Order.items:r")) == false) {
            return "FAIL LineItem page missing Order.items port"
        }
        if ((graph.hasPort("Cart.lines:r")) == false) {
            return "FAIL LineItem page missing Cart.lines port"
        }
        def orderOnLine:FlowNode (graph.nodeById("Order"))
        def oLineY:double (editor.view.viewport.toScreenY((orderOnLine.centerY())))
        if (oLineY < 0.0) {
            return "FAIL Order user panned off the LineItem page"
        }
        if (oLineY > viewH) {
            return "FAIL Order user panned off the LineItem page"
        }
        if ((this.openClass("Customer")) == false) {
            return "FAIL rail openClass Customer"
        }
        if (session.pageId != "class:Customer") {
            return ("FAIL Customer stayed on " + session.pageId)
        }
        if ((graph.hasNode("Order")) == false) {
            return "FAIL Customer page has no Order user"
        }
        if ((graph.hasPort("Order.customer:r")) == false) {
            return "FAIL Customer page missing Order.customer port"
        }
        def orderOnCust:FlowNode (graph.nodeById("Order"))
        def oCustY:double (editor.view.viewport.toScreenY((orderOnCust.centerY())))
        if (oCustY < 0.0) {
            return "FAIL Order user panned off the Customer page"
        }
        if (oCustY > viewH) {
            return "FAIL Order user panned off the Customer page"
        }
        return ("PASS nav ok; " + (this.stats()))
    }
}

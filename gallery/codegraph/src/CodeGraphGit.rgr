; ============================================================================
; CodeGraphGit.rgr — two commits of a repository, as two CodeGraphs.
; ============================================================================
;
; The comparison itself is CodeGraphDiff; this is the part that asks git.
; A revision that is not the working tree is checked out as a detached
; worktree under `.git/codegraph-diff/`, analysed by the same CodeGraphBuilder
; path Open uses, and removed again. The whole program is compiled on each
; side — VirtualCompiler resolves types across files, so a method cannot be
; typed on its own — but the *diff* is scoped: `git diff --name-only`
; names the files the commit touched, CodeGraphDiff compares members of
; those files line by line, and every other class is carried over as
; unchanged without a second look.
;
;   spec   "a1b2c3d..HEAD"   two commits
;          "HEAD~1"          that commit against the working tree
;          "v1..v2"          tags, branches — anything rev-parse takes
;
; Needs `git` on PATH: the desktop app, the CLI. The browser page has no
; git; it diffs two files it was handed instead.
; ============================================================================

Import "CodeGraphBuilder.rgr"
Import "CodeGraphFlow.rgr"
Import "../../../lib/Shell.rgr"

class CodeGraphGit {
    def sh:Shell (new Shell)
    ; Why the last call answered an empty graph, for the status line.
    def lastError:string ""
    ; The files `git diff --name-only` listed, for the status line.
    def changedFiles:[string]

    Constructor () {
    }

    sfn isInstalled:boolean () {
        def s (new Shell)
        return (s.isInstalled("git"))
    }

    ; The repository root that contains `path` (a file or a directory), or
    ; "" when it is not inside one.
    fn repoRootOf:string (path:string) {
        def dir:string (CodeGraphBuilder.fileDirName(path))
        if ((strlen dir) == 0) {
            dir = "."
        }
        if ((CodeGraphGit.isFilePath(path)) == false) {
            dir = path
        }
        def argv:[string]
        push argv "-C"
        push argv dir
        push argv "rev-parse"
        push argv "--show-toplevel"
        return (sh.text("git" argv))
    }

    ; `path` relative to the repository root — what the same file is
    ; called inside a worktree of another commit.
    fn relativeTo:string (root:string path:string) {
        def dir:string (CodeGraphBuilder.fileDirName(path))
        def base:string (CodeGraphBuilder.fileBaseName(path))
        if ((CodeGraphGit.isFilePath(path)) == false) {
            dir = path
            base = ""
        }
        if ((strlen dir) == 0) {
            dir = "."
        }
        def argv:[string]
        push argv "-C"
        push argv dir
        push argv "rev-parse"
        push argv "--show-prefix"
        def prefix:string (sh.text("git" argv))
        if ((strlen prefix) > 0) {
            if ((charAt prefix ((strlen prefix) - 1)) != 47) {
                prefix = (prefix + "/")
            }
        }
        return (prefix + base)
    }

    ; `dir_exists` answers "exists" for a file on some targets, so a path
    ; is a file when its last segment has an extension.
    sfn isFilePath:boolean (path:string) {
        def base:string (CodeGraphBuilder.fileBaseName(path))
        return ((indexOf base ".") > 0)
    }

    fn resolve:string (root:string rev:string) {
        def argv:[string]
        push argv "-C"
        push argv root
        push argv "rev-parse"
        push argv "--verify"
        push argv "--short"
        push argv (rev + "^{commit}")
        return (sh.text("git" argv))
    }

    ; "a..b" → a and b; "a" → a and "" (the working tree).
    sfn baseOf:string (spec:string) {
        def at:int (indexOf spec "..")
        if (at < 0) {
            return spec
        }
        return (substring spec 0 at)
    }

    sfn headOf:string (spec:string) {
        def at:int (indexOf spec "..")
        if (at < 0) {
            return ""
        }
        return (substring spec (at + 2) (strlen spec))
    }

    fn listChanged:[string] (root:string base:string head:string) {
        def argv:[string]
        push argv "-C"
        push argv root
        push argv "diff"
        push argv "--name-only"
        push argv base
        if ((strlen head) > 0) {
            push argv head
        }
        def res:ShellResult (sh.capture("git" argv))
        def out:[string]
        if (res.failed()) {
            return out
        }
        def lines:[string] (res.outLines())
        def i:int 0
        while (i < (array_length lines)) {
            def l:string (itemAt lines i)
            if ((strlen l) > 0) {
                push out l
            }
            i = (i + 1)
        }
        return out
    }

    ; The last N commits, "sha subject" per line, for a picker or a hint.
    fn recentCommits:[string] (root:string n:int) {
        def argv:[string]
        push argv "-C"
        push argv root
        push argv "log"
        push argv "--format=%h %s"
        push argv ("-n" + (to_string n))
        def res:ShellResult (sh.capture("git" argv))
        if (res.failed()) {
            def none:[string]
            return none
        }
        return (res.outLines())
    }

    fn worktreeDir:string (root:string sha:string) {
        return (((root + "/.git/codegraph-diff/") + sha))
    }

    fn addWorktree:boolean (root:string sha:string dir:string) {
        def argv:[string]
        push argv "-C"
        push argv root
        push argv "worktree"
        push argv "add"
        push argv "--detach"
        push argv "--force"
        push argv dir
        push argv sha
        def res:ShellResult (sh.capture("git" argv))
        if (res.failed()) {
            lastError = (res.describeFailure())
            return false
        }
        return true
    }

    fn removeWorktree:void (root:string dir:string) {
        def argv:[string]
        push argv "-C"
        push argv root
        push argv "worktree"
        push argv "remove"
        push argv "--force"
        push argv dir
        sh.capture("git" argv)
    }

    ; The graph of `entry` (a file, a directory, a ranger.json) as it was
    ; at `rev`; "" is the working tree as it is now.
    fn graphAt:CodeGraph (root:string entry:string rev:string) {
        if ((strlen rev) == 0) {
            return (CodeGraphBuilder.fromAny(entry))
        }
        def sha:string (this.resolve(root rev))
        if ((strlen sha) == 0) {
            def bad (new CodeGraph)
            bad.title = (entry + " FAIL unknown revision " + rev)
            lastError = ("unknown revision " + rev)
            return bad
        }
        def dir:string (this.worktreeDir(root sha))
        if ((this.addWorktree(root sha dir)) == false) {
            def bad2 (new CodeGraph)
            bad2.title = (entry + " FAIL " + lastError)
            return bad2
        }
        def rel:string (this.relativeTo(root entry))
        def inside:string (dir + "/" + rel)
        if ((strlen rel) == 0) {
            inside = dir
        }
        def g:CodeGraph (CodeGraphBuilder.fromAny(inside))
        this.removeWorktree(root dir)
        ; Class and method paths name the worktree; give them the names the
        ; working tree uses so the two sides line up file by file.
        CodeGraphGit.rebase(g (dir + "/") (root + "/"))
        return g
    }

    ; Replace the `from` prefix on every path the graph carries.
    sfn rebase:void (g:CodeGraph from:string to:string) {
        def i:int 0
        while (i < (g.classCount())) {
            def c:CodeClass (g.classAt(i))
            c.fileName = (CodeGraphGit.swapPrefix(c.fileName from to))
            def fi:int 0
            while (fi < (array_length c.fields)) {
                def f:CodeField (itemAt c.fields fi)
                f.fileName = (CodeGraphGit.swapPrefix(f.fileName from to))
                fi = (fi + 1)
            }
            i = (i + 1)
        }
        def mi:int 0
        while (mi < (g.methodCount())) {
            def m:CodeMethod (g.methodAt(mi))
            m.fileName = (CodeGraphGit.swapPrefix(m.fileName from to))
            mi = (mi + 1)
        }
        def paths:[string] (keys g.sources)
        def fresh:[string:string]
        def freshBase:[string:string]
        def pi:int 0
        while (pi < (array_length paths)) {
            def p:string (itemAt paths pi)
            def text:string (unwrap (get g.sources p))
            def np:string (CodeGraphGit.swapPrefix(p from to))
            set fresh np text
            def b:string (CodeGraph.baseNameOf(np))
            if ((has freshBase b) == false) {
                set freshBase b text
            }
            pi = (pi + 1)
        }
        g.sources = fresh
        g.sourceBase = freshBase
        g.title = (CodeGraphGit.swapPrefix(g.title from to))
    }

    ; One file under another name on both sides — `calls.rgr` compiled as
    ; the base of `calls_v2.rgr`. Every path whose basename is `from`
    ; (or that is exactly `from`) takes the basename of `to`.
    sfn renameFile:void (g:CodeGraph from:string to:string) {
        def fromBase:string (CodeGraph.baseNameOf(from))
        def toBase:string (CodeGraph.baseNameOf(to))
        def i:int 0
        while (i < (g.classCount())) {
            def c:CodeClass (g.classAt(i))
            c.fileName = (CodeGraphGit.swapBase(c.fileName from fromBase toBase))
            def fi:int 0
            while (fi < (array_length c.fields)) {
                def f:CodeField (itemAt c.fields fi)
                f.fileName = (CodeGraphGit.swapBase(f.fileName from fromBase toBase))
                fi = (fi + 1)
            }
            i = (i + 1)
        }
        def mi:int 0
        while (mi < (g.methodCount())) {
            def m:CodeMethod (g.methodAt(mi))
            m.fileName = (CodeGraphGit.swapBase(m.fileName from fromBase toBase))
            mi = (mi + 1)
        }
        def paths:[string] (keys g.sources)
        def fresh:[string:string]
        def freshBase:[string:string]
        def pi:int 0
        while (pi < (array_length paths)) {
            def p:string (itemAt paths pi)
            def text:string (unwrap (get g.sources p))
            def np:string (CodeGraphGit.swapBase(p from fromBase toBase))
            set fresh np text
            def b:string (CodeGraph.baseNameOf(np))
            if ((has freshBase b) == false) {
                set freshBase b text
            }
            pi = (pi + 1)
        }
        g.sources = fresh
        g.sourceBase = freshBase
        if (g.title == from) {
            g.title = to
        }
    }

    sfn swapBase:string (s:string from:string fromBase:string toBase:string) {
        if ((strlen s) == 0) {
            return s
        }
        if (s == from) {
            return toBase
        }
        if ((CodeGraph.baseNameOf(s)) == fromBase) {
            def cut:int ((strlen s) - (strlen fromBase))
            return ((substring s 0 cut) + toBase)
        }
        return s
    }

    sfn swapPrefix:string (s:string from:string to:string) {
        if ((strlen from) == 0) {
            return s
        }
        if ((indexOf s from) == 0) {
            return (to + (substring s (strlen from) (strlen s)))
        }
        return s
    }

    ; Both sides of `spec` around `entry`, compared. An empty graph with a
    ; " FAIL " title comes back when git or the compile said no; the
    ; session's status carries the reason.
    fn diffSession:CodeGraphSession (entry:string spec:string maxNodes:int) {
        lastError = ""
        def root:string (this.repoRootOf(entry))
        def failed:CodeGraphSession (CodeGraphSession.of((new CodeGraph) maxNodes))
        if ((strlen root) == 0) {
            lastError = (entry + " is not inside a git repository")
            failed.status = lastError
            return failed
        }
        def baseRev:string (CodeGraphGit.baseOf(spec))
        def headRev:string (CodeGraphGit.headOf(spec))
        if ((strlen baseRev) == 0) {
            lastError = "no revision to compare against (base..head, or base for the working tree)"
            failed.status = lastError
            return failed
        }
        changedFiles = (this.listChanged(root baseRev headRev))
        def head:CodeGraph (this.graphAt(root entry headRev))
        if ((indexOf head.title " FAIL ") >= 0) {
            lastError = head.title
            failed.status = lastError
            return failed
        }
        def base:CodeGraph (this.graphAt(root entry baseRev))
        if ((indexOf base.title " FAIL ") >= 0) {
            lastError = base.title
            failed.status = lastError
            return failed
        }
        def label:string ((this.resolve(root baseRev)) + " → ")
        if ((strlen headRev) > 0) {
            label = (label + (this.resolve(root headRev)))
        } {
            label = (label + "working tree")
        }
        def s:CodeGraphSession (CodeGraphSession.ofDiff(base head label maxNodes))
        s.model.title = head.title
        return s
    }
}

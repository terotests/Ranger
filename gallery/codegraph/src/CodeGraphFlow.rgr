; ============================================================================
; CodeGraphFlow.rgr — a page of the call graph, as a RangerFlow drawing.
; ============================================================================
;
; The window CodeGraphPages picked becomes a FlowGraph: class boxes, method
; stadiums, type parallelograms, and pager arrows on the edge. Click events
; on those nodes are how the reader moves — the session below is the host
; that drains FlowEditor.clicks and swaps the graph.
; ============================================================================

Import "CodeGraphPages.rgr"
Import "../../rangerflow/core/GraphModel.rgr"
Import "../../rangerflow/core/FlowEvents.rgr"
Import "../../rangerflow/core/FlowShapes.rgr"
Import "../../rangerflow/domains/uml/UMLModel.rgr"
Import "../../rangerflow/layout/LayeredLayout.rgr"
Import "../../rangerflow/layout/EdgeLanes.rgr"
Import "../../rangerflow/layout/OrthoRouter.rgr"
Import "../../rangerflow/layout/EdgeFacing.rgr"

class CodeGraphFlow {
    Constructor () {
    }

    sfn build:FlowGraph (model:CodeGraph page:CodePage) {
        return (CodeGraphFlow.buildWithDiff(model page (new CodeGraphDiff)))
    }

    ; The same drawing, with each member row tinted by what the change did
    ; to it — green added, red removed, amber changed — when `diff` is
    ; active. An inactive diff answers "" for everything and paints nothing.
    sfn buildWithDiff:FlowGraph (model:CodeGraph page:CodePage diff:CodeGraphDiff) {
        def g (new FlowGraph)
        def uml (new UMLToGraph)
        def i:int 0
        while (i < (array_length page.items)) {
            def it:CodePageItem (itemAt page.items i)
            ; A UML catalogue of twenty fat classes is unreadably small after
            ; fitView. Compact compartments there; a class page keeps more.
            def compact:boolean (page.kind == "uml")
            def n:FlowNode (CodeGraphFlow.itemNode(model uml it compact diff))
            g.addNode(n)
            i = (i + 1)
        }
        g.reindex()
        def k:int 0
        while (k < (array_length page.links)) {
            def link:CodePageLink (itemAt page.links k)
            if (g.hasNode(link.fromId)) {
                if (g.hasNode(link.toId)) {
                    def e:FlowEdge (g.connect(link.fromId link.toId))
                    e.edgeType = "smoothstep"
                    e.label = link.label
                    e.cssClass = "codegraph"
                    if (link.kind == "inherit") {
                        e.markerEnd = "triangle"
                    } {
                        e.markerEnd = "arrowclosed"
                    }
                    if (link.kind == "assoc") {
                        if ((strlen link.fieldName) > 0) {
                            e.sourcePort = (((link.fromId + ".") + link.fieldName) + ":r")
                        }
                    }
                    if link.dashed {
                        e.dash = 6.0
                    }
                }
            }
            k = (k + 1)
        }
        g.reindex()
        CodeGraphFlow.layout(g page.kind)
        return g
    }

    sfn itemNode:FlowNode (model:CodeGraph uml:UMLToGraph it:CodePageItem compact:boolean diff:CodeGraphDiff) {
        if (it.itemKind == "umlclass") {
            if (model.hasClass(it.id)) {
                def c:CodeClass (model.classByName(it.id))
                def u:UMLClass (CodeGraphFlow.asUml(c model compact diff))
                def n:FlowNode (uml.classNode(u))
                n.dataKind = it.dataKind
                n.dataRef = it.dataRef
                n.cssClass = "codegraph class"
                n.tooltip = (CodeGraphFlow.classHover(c))
                if ((strlen it.fill) > 0) {
                    n.bgColor = it.fill
                }
                if ((strlen it.stroke) > 0) {
                    n.borderColor = it.stroke
                }
                return n
            }
        }
        if (it.itemKind == "backref") {
            if (model.hasClass(it.id)) {
                def bc:CodeClass (model.classByName(it.id))
                def bu:UMLClass (CodeGraphFlow.asBackref(bc model it.extra))
                CodeGraphFlow.tintMembers(bu bc model diff)
                def bn:FlowNode (uml.classNode(bu))
                bn.dataKind = it.dataKind
                bn.dataRef = it.dataRef
                bn.cssClass = "codegraph class"
                bn.tooltip = (((bc.name + " refers to ") + it.extra) + " — click to open")
                if ((strlen it.fill) > 0) {
                    bn.bgColor = it.fill
                }
                if ((strlen it.stroke) > 0) {
                    bn.borderColor = it.stroke
                }
                return bn
            }
        }
        def n2:FlowNode (FlowNode.create(it.id it.label 0.0 0.0))
        n2.dataKind = it.dataKind
        n2.dataRef = it.dataRef
        n2.cssClass = ("codegraph " + it.itemKind)
        n2.tooltip = it.extra
        n2.textColor = "#0f172a"
        if ((strlen it.fill) > 0) {
            n2.bgColor = it.fill
        }
        if ((strlen it.stroke) > 0) {
            n2.borderColor = it.stroke
        }
        if (it.itemKind == "class") {
            n2.shape = (FlowShape.rect())
            n2.width = 170.0
            n2.height = 48.0
            if ((strlen it.extra) > 0) {
                n2.tooltip = it.extra
            }
        }
        if (it.itemKind == "method") {
            n2.shape = (FlowShape.stadium())
            n2.width = 210.0
            n2.height = 40.0
        }
        if (it.itemKind == "type") {
            n2.shape = (FlowShape.parallelogram())
            n2.width = 150.0
            n2.height = 40.0
        }
        if (it.itemKind == "pager") {
            n2.shape = (FlowShape.hexagon())
            n2.width = 160.0
            n2.height = 44.0
            n2.tooltip = "open the next chart"
        }
        if (it.itemKind == "back") {
            n2.shape = (FlowShape.hexagon())
            n2.width = 150.0
            n2.height = 40.0
            n2.tooltip = "go back"
        }
        return n2
    }

    ; Compact box: only the fields whose type is the class on screen.
    ; The rose box above a class: only the rows that point at `target` —
    ; the fields typed as it and the methods that mention or call it.
    sfn asBackref:UMLClass (c:CodeClass model:CodeGraph target:string) {
        def u:UMLClass (UMLClass.create(c.name))
        def fi:int 0
        while (fi < (array_length c.fields)) {
            def f:CodeField (itemAt c.fields fi)
            def typeName:string (CodeGraphPages.classNameOfType(f.fieldType))
            if (typeName == target) {
                def mem:UMLMember (u.attribute("-" f.name f.fieldType))
                mem.wantPort = true
                mem.tooltip = (CodeGraphFlow.fieldHover(c f))
            }
            fi = (fi + 1)
        }
        def mi:int 0
        while (mi < (array_length c.methodIds)) {
            def m:CodeMethod (model.methodById((itemAt c.methodIds mi)))
            if (CodeGraphFlow.methodReaches(m model target)) {
                ; No row port: a "uses" edge leaves the box, not the row.
                ; Two rose boxes above one class each get their own line
                ; down into it; from side ports they crossed and stacked.
                def op:UMLMember (u.operation("+" m.name m.params m.returns))
                op.wantPort = false
                op.tooltip = (CodeGraphFlow.methodHover(m))
            }
            mi = (mi + 1)
        }
        return u
    }

    sfn methodReaches:boolean (m:CodeMethod model:CodeGraph target:string) {
        def ui:int 0
        while (ui < (array_length m.uses)) {
            if ((itemAt m.uses ui) == target) {
                return true
            }
            ui = (ui + 1)
        }
        def ci:int 0
        while (ci < (array_length m.calls)) {
            def callee:CodeMethod (model.methodById((itemAt m.calls ci)))
            if (callee.className == target) {
                return true
            }
            ci = (ci + 1)
        }
        return false
    }

    ; Colour the rows of `u` by the diff status of the member each one
    ; stands for. A removed member gets the minus badge in place of its
    ; visibility, so it reads as struck even in a monochrome export.
    sfn tintMembers:void (u:UMLClass c:CodeClass model:CodeGraph diff:CodeGraphDiff) {
        if (diff.active == false) {
            return
        }
        def ai:int 0
        while (ai < (array_length u.attributes)) {
            def a:UMLMember (itemAt u.attributes ai)
            def fkey:string ((c.name + ".") + a.name)
            CodeGraphFlow.tintMember(a (diff.statusOfField(c.name a.name)) (diff.noteOf(fkey)))
            ai = (ai + 1)
        }
        def oi:int 0
        while (oi < (array_length u.operations)) {
            def o:UMLMember (itemAt u.operations oi)
            def mid:string (CodeGraphFlow.methodIdNamed(c model o.name))
            if ((strlen mid) > 0) {
                CodeGraphFlow.tintMember(o (diff.statusOfMethod(mid)) (diff.noteOf(mid)))
            }
            oi = (oi + 1)
        }
    }

    ; The row keeps its ink — a coloured name on a coloured band read
    ; badly — and says what happened with a mark at its right edge and a
    ; tooltip: + added, − removed, Δ changed, with the reason on hover.
    sfn tintMember:void (m:UMLMember status:string note:string) {
        def fill:string (CodeGraphPages.diffFill(status))
        if ((strlen fill) == 0) {
            return
        }
        m.tint = fill
        m.trailing = (CodeGraphFlow.diffMark(status))
        def noteTip:string (CodeGraphFlow.diffTooltip(status note))
        if ((strlen noteTip) > 0) {
            if ((strlen m.tooltip) > 0) {
                m.tooltip = ((noteTip + "\n\n") + m.tooltip)
            } {
                m.tooltip = noteTip
            }
        }
    }

    ; A "+ N more" row over members a diff touched: tinted by the strongest
    ; status among them (changed over added over removed), marked, and a
    ; tooltip with the counts. Every such row invites the click that lists
    ; the members, diff or not.
    sfn markFold:void (m:UMLMember hidden:[string] diff:CodeGraphDiff) {
        m.tooltip = "Click to list every member of this class"
        if (diff.active == false) {
            return
        }
        def added:int 0
        def removed:int 0
        def changed:int 0
        def i:int 0
        while (i < (array_length hidden)) {
            def st:string (itemAt hidden i)
            if (st == "added") { added = (added + 1) }
            if (st == "removed") { removed = (removed + 1) }
            if (st == "changed") { changed = (changed + 1) }
            i = (i + 1)
        }
        if (((added + removed) + changed) == 0) {
            return
        }
        def top:string "removed"
        if (added > 0) { top = "added" }
        if (changed > 0) { top = "changed" }
        m.tint = (CodeGraphPages.diffFill(top))
        m.trailing = (CodeGraphFlow.diffMark(top))
        def parts:[string]
        if (changed > 0) { push parts ((to_string changed) + " changed") }
        if (added > 0) { push parts ((to_string added) + " added") }
        if (removed > 0) { push parts ((to_string removed) + " removed") }
        m.tooltip = (("Among the folded members: " + (join parts ", ")) + " — click to list them all")
    }

    sfn diffMark:string (status:string) {
        if (status == "added") {
            return "+"
        }
        if (status == "removed") {
            return "−"
        }
        if (status == "changed") {
            return "Δ"
        }
        return ""
    }

    sfn diffTooltip:string (status:string note:string) {
        if (status == "added") {
            return "Added in this change"
        }
        if (status == "removed") {
            return "Removed in this change — drawn from the old side"
        }
        if (status == "changed") {
            if ((strlen note) > 0) {
                return ("Changed in this change: " + note)
            }
            return "Changed in this change"
        }
        return ""
    }

    sfn methodIdNamed:string (c:CodeClass model:CodeGraph name:string) {
        def i:int 0
        while (i < (array_length c.methodIds)) {
            def id:string (itemAt c.methodIds i)
            def m:CodeMethod (model.methodById(id))
            if (m.name == name) {
                return id
            }
            i = (i + 1)
        }
        return ""
    }

    sfn asUml:UMLClass (c:CodeClass model:CodeGraph compact:boolean diff:CodeGraphDiff) {
        def u:UMLClass (UMLClass.create(c.name))
        u.stereotype = c.stereotype
        def attrCap:int (CodeGraphPages.umlAttrCap())
        def opCap:int (CodeGraphPages.umlMethodCap())
        if compact {
            attrCap = (CodeGraphPages.umlCatalogueAttrCap())
            opCap = (CodeGraphPages.umlCatalogueMethodCap())
        }
        ; Association fields first so Order.customer still has a row port
        ; when the rest of a fat class is folded into "+ N more".
        def assoc:[CodeField]
        def rest:[CodeField]
        def fi:int 0
        while (fi < (array_length c.fields)) {
            def f:CodeField (itemAt c.fields fi)
            def typeName:string (CodeGraphPages.classNameOfType(f.fieldType))
            def isAssoc:boolean false
            if ((strlen typeName) > 0) {
                if (model.hasClass(typeName)) {
                    isAssoc = true
                }
            }
            if isAssoc {
                push assoc f
            } {
                push rest f
            }
            fi = (fi + 1)
        }
        def shown:int 0
        shown = (CodeGraphFlow.addUmlFields(u model assoc shown attrCap))
        shown = (CodeGraphFlow.addUmlFields(u model rest shown attrCap))
        def leftover:int ((array_length c.fields) - shown)
        if (leftover > 0) {
            def moreA:UMLMember (u.attribute("" ("+" + (to_string leftover) + " more") ""))
            moreA.wantPort = false
            ; The fields the cap folded away, in the order they were listed.
            def hiddenF:[string]
            def hi:int shown
            def ordered:[CodeField]
            def oi:int 0
            while (oi < (array_length assoc)) {
                push ordered (itemAt assoc oi)
                oi = (oi + 1)
            }
            def oi2:int 0
            while (oi2 < (array_length rest)) {
                push ordered (itemAt rest oi2)
                oi2 = (oi2 + 1)
            }
            while (hi < (array_length ordered)) {
                def hf:CodeField (itemAt ordered hi)
                push hiddenF (diff.statusOfField(c.name hf.name))
                hi = (hi + 1)
            }
            CodeGraphFlow.markFold(moreA hiddenF diff)
        }
        def mi:int 0
        def opsShown:int 0
        while (mi < (array_length c.methodIds)) {
            if (opsShown >= opCap) {
                def more:UMLMember (u.operation("+" ("+" + (to_string ((array_length c.methodIds) - opCap)) + " more") "" ""))
                more.wantPort = false
                def hiddenM:[string]
                def hm:int opCap
                while (hm < (array_length c.methodIds)) {
                    push hiddenM (diff.statusOfMethod((itemAt c.methodIds hm)))
                    hm = (hm + 1)
                }
                CodeGraphFlow.markFold(more hiddenM diff)
                mi = (array_length c.methodIds)
            } {
                def m:CodeMethod (model.methodById((itemAt c.methodIds mi)))
                def vis:string "+"
                if m.isStatic {
                    vis = "+"
                }
                def op:UMLMember (u.operation(vis m.name m.params m.returns))
                op.wantPort = false
                op.tooltip = (CodeGraphFlow.methodHover(m))
                opsShown = (opsShown + 1)
                mi = (mi + 1)
            }
        }
        CodeGraphFlow.tintMembers(u c model diff)
        return u
    }

    sfn addUmlFields:int (u:UMLClass model:CodeGraph fields:[CodeField] shown:int cap:int) {
        def i:int 0
        def n:int shown
        while (i < (array_length fields)) {
            if (n >= cap) {
                return n
            }
            def f:CodeField (itemAt fields i)
            def mem:UMLMember (u.attribute("-" f.name f.fieldType))
            mem.tooltip = (CodeGraphFlow.fieldHoverName(u.name f))
            def typeName:string (CodeGraphPages.classNameOfType(f.fieldType))
            if ((strlen typeName) == 0) {
                mem.wantPort = false
            } {
                if ((model.hasClass(typeName)) == false) {
                    mem.wantPort = false
                }
            }
            n = (n + 1)
            i = (i + 1)
        }
        return n
    }

    sfn layout:void (g:FlowGraph kind:string) {
        if ((g.nodeCount()) == 0) {
            return
        }
        ; An overview is a catalogue: no edges, one Sugiyama rank, a strip
        ; so wide that fitView shrinks the type below the size the renderer
        ; will draw. A grid keeps the words readable.
        if (kind == "overview") {
            CodeGraphFlow.packGrid(g)
            return
        }
        if ((g.edgeCount()) == 0) {
            CodeGraphFlow.packGrid(g)
            return
        }
        def lay:LayeredLayout (LayeredLayout.of(g))
        ; UML class diagrams read left-to-right (a field points at its type).
        ; The diff summary is the same kind of catalogue.
        if ((kind == "uml") || (kind == "diff")) {
            lay.direction = "LR"
            lay.layerGap = 120.0
        } {
            lay.direction = "TB"
            lay.layerGap = 90.0
        }
        lay.nodeGap = 36.0
        lay.run()
        ; Pick the field-port side, then the class-box side, BEFORE the
        ; router writes corners. A port flipped after routing leaves the
        ; stored path on the old handle, which is how a line misses its box.
        CodeGraphFlow.faceFieldPorts(g)
        EdgeFacing.repairAll(g)
        EdgeLanes.assign(g)
        lay.routeLongEdges()
        EdgeLanes.assign(g)
        OrthoRouter.repairAll(g)
    }

    ; Row ports are named Class.field:l / :r. After the boxes have positions,
    ; pick the side that faces the other class so the line leaves the field
    ; instead of crossing the box.
    sfn faceFieldPorts:void (g:FlowGraph) {
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            def sp:string e.sourcePort
            if ((strlen sp) > 2) {
                def cut:int ((strlen sp) - 2)
                def tail:string (substring sp cut (strlen sp))
                def isSide:boolean false
                if (tail == ":l") { isSide = true }
                if (tail == ":r") { isSide = true }
                if isSide {
                    def base:string (substring sp 0 cut)
                    def leftId:string (base + ":l")
                    def rightId:string (base + ":r")
                    if (g.hasPort(leftId)) {
                        if (g.hasPort(rightId)) {
                            if (g.hasNode(e.source)) {
                                if (g.hasNode(e.target)) {
                                    def s:FlowNode (g.nodeById(e.source))
                                    def t:FlowNode (g.nodeById(e.target))
                                    if ((t.centerX()) >= (s.centerX())) {
                                        e.sourcePort = rightId
                                    } {
                                        e.sourcePort = leftId
                                    }
                                }
                            }
                        }
                    }
                }
            }
            k = (k + 1)
        }
    }

    ; After a drag: pick the facing port, then drop stored corridors on the
    ; edges that touch the moved boxes so the next paint leaves the live
    ; handles. Do not run OrthoRouter here — its visibility grid
    ; (`markPassable`) is a Dijkstra over every box's sides, and a compiler
    ; UML page with tall classes freezes the tab for seconds. Initial layout
    ; still routes; a moved box keeps a cheap stepped line.
    sfn repairRoutes:void (g:FlowGraph) {
        CodeGraphFlow.faceFieldPorts(g)
        EdgeFacing.repairAll(g)
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            if (e.pinnedRoute == false) {
                def touched:boolean false
                if (g.hasNode(e.source)) {
                    def a:FlowNode (g.nodeById(e.source))
                    if a.selected { touched = true }
                }
                if (g.hasNode(e.target)) {
                    def b:FlowNode (g.nodeById(e.target))
                    if b.selected { touched = true }
                }
                if touched {
                    clear e.waypoints
                    e.hasLaneX = false
                    e.hasLaneY = false
                }
            }
            k = (k + 1)
        }
    }

    sfn packGrid:void (g:FlowGraph) {
        def n:int (g.nodeCount())
        if (n == 0) {
            return
        }
        def cols:int 4
        if (n <= 8) {
            cols = 3
        }
        if (n <= 3) {
            cols = n
        }
        def gapX:double 40.0
        def gapY:double 32.0
        def i:int 0
        while (i < n) {
            def node:FlowNode (g.nodeAt(i))
            def col:int (i % cols)
            def row:int (idiv i cols)
            def cw:double (node.width + gapX)
            def rh:double (node.height + gapY)
            node.x = ((to_double col) * cw)
            node.y = ((to_double row) * rh)
            i = (i + 1)
        }
        g.reindex()
    }

    ; A VS Code-style hover card: kind + signature, then the declaration's
    ; documentation when the analyser found one, then a click hint.
    sfn classHover:string (c:CodeClass) {
        def kind:string "class"
        if (c.stereotype == "interface") {
            kind = "interface"
        }
        if (c.stereotype == "type") {
            kind = "type"
        }
        if (c.stereotype == "enumeration") {
            kind = "enum"
        }
        if (c.stereotype == "component") {
            kind = "component"
        }
        if (c.stereotype == "record") {
            kind = "record"
        }
        return (CodeGraphFlow.hoverCard(kind c.name "" c.comment c.fileName c.startLine "Click a method row to read it · double-click to open"))
    }

    sfn methodHover:string (m:CodeMethod) {
        def sig:string (m.className + "." + m.name + "(" + m.params + ")")
        if ((strlen m.returns) > 0) {
            sig = ((sig + ": ") + m.returns)
        }
        def kind:string "method"
        if m.isStatic {
            kind = "static method"
        }
        return (CodeGraphFlow.hoverCard(kind sig "" m.comment m.fileName m.startLine "Click to read the source"))
    }

    sfn fieldHover:string (owner:CodeClass f:CodeField) {
        return (CodeGraphFlow.fieldHoverName(owner.name f))
    }

    sfn fieldHoverName:string (owner:string f:CodeField) {
        def sig:string ((owner + ".") + f.name)
        if ((strlen f.fieldType) > 0) {
            sig = ((sig + ": ") + f.fieldType)
        }
        return (CodeGraphFlow.hoverCard("property" sig "" f.comment f.fileName f.startLine "Click to read the source"))
    }

    sfn hoverCard:string (kind:string signature:string extra:string comment:string fileName:string startLine:int hint:string) {
        def lines:[string]
        push lines (("(" + kind + ") ") + signature)
        if ((strlen extra) > 0) {
            push lines extra
        }
        def doc:string (CodeGraphFlow.cleanDoc(comment))
        if ((strlen doc) > 0) {
            push lines ""
            push lines doc
        }
        def loc:string (CodeGraphFlow.whereHint(fileName startLine))
        if ((strlen loc) > 0) {
            push lines ""
            push lines loc
        }
        if ((strlen hint) > 0) {
            if ((strlen loc) == 0) {
                push lines ""
            }
            if ((strlen loc) > 0) {
                def last:int ((array_length lines) - 1)
                set lines last ((loc + "  ·  ") + hint)
            } {
                push lines hint
            }
        }
        return (join lines "\n")
    }

    ; Drop leading decoration and cap a novel so the card stays a card.
    sfn cleanDoc:string (raw:string) {
        if ((strlen raw) == 0) {
            return ""
        }
        def s:string raw
        while ((strlen s) > 0) {
            def ch:int (charAt s 0)
            if ((ch == 32) || (ch == 9) || (ch == 10) || (ch == 13) || (ch == 42)) {
                s = (substring s 1 (strlen s))
            } {
                break
            }
        }
        def n:int (strlen s)
        while (n > 0) {
            def ch2:int (charAt s (n - 1))
            if ((ch2 == 32) || (ch2 == 9) || (ch2 == 10) || (ch2 == 13)) {
                n = (n - 1)
            } {
                break
            }
        }
        if (n < (strlen s)) {
            s = (substring s 0 n)
        }
        if ((strlen s) > 720) {
            s = ((substring s 0 717) + "...")
        }
        return s
    }

    sfn whereHint:string (fileName:string startLine:int) {
        if ((strlen fileName) == 0) {
            return ""
        }
        def base:string (CodeGraph.baseNameOf(fileName))
        if (startLine <= 0) {
            return base
        }
        return ((base + ":") + (to_string startLine))
    }
}

; The thing a host holds: the whole IR, the current window, and a history
; stack so a click that drilled in can be undone.
class CodeGraphSession {
    def model:CodeGraph (new CodeGraph)
    def diff:CodeGraphDiff (new CodeGraphDiff)
    def pages:CodeGraphPages (new CodeGraphPages)
    def pageId:string "overview:0"
    def history:[string]
    def historyAt:int 0
    def status:string ""

    Constructor () {
    }

    sfn of:CodeGraphSession (g:CodeGraph maxNodes:int) {
        def s (new CodeGraphSession)
        s.model = g
        s.pages = (CodeGraphPages.of(g maxNodes))
        s.pageId = (s.pages.overviewId(0))
        push s.history s.pageId
        s.historyAt = 0
        s.status = (s.describe())
        return s
    }

    fn openInitial:void (id:string) {
        if ((strlen id) == 0) {
            return
        }
        pageId = id
        def fresh:[string]
        push fresh id
        history = fresh
        historyAt = 0
        status = (this.describe())
    }

    fn currentPage:CodePage () {
        return (pages.pageOf(pageId))
    }

    fn graph:FlowGraph () {
        return (CodeGraphFlow.buildWithDiff(model (this.currentPage()) diff))
    }

    ; Compare `base` against `head` and show the result: the session's
    ; model becomes the merged graph (both sides), the pager colours by
    ; status, and the first page is the diff summary.
    sfn ofDiff:CodeGraphSession (base:CodeGraph head:CodeGraph label:string maxNodes:int) {
        def d:CodeGraphDiff (CodeGraphDiff.compare(base head))
        d.label = label
        def s:CodeGraphSession (CodeGraphSession.of((d.merged()) maxNodes))
        s.diff = d
        s.pages.diff = d
        s.openInitial(s.pages.diffPageId(0))
        return s
    }

    fn describe:string () {
        def p:CodePage (this.currentPage())
        def head:string ((((p.title + " · ") + (to_string (p.itemCount()))) + " boxes (max ") + (to_string pages.maxNodes))
        if (p.kind == "class") {
            return (head + ") — click a method row to read it here, double-click to open it")
        }
        if (p.kind == "uml") {
            return (head + ") — click a UML class to select it, Zoom to selected to read it, double-click to open")
        }
        if (p.kind == "diff") {
            return (head + ") — green added, red removed, amber changed; double-click a class to see which members")
        }
        return (head + ") — click a box to open it")
    }

    fn goTo:boolean (nextId:string) {
        if ((strlen nextId) == 0) {
            return false
        }
        if (nextId == pageId) {
            return false
        }
        ; Drop the forward tail, the way a browser does when you click
        ; after going back.
        while ((array_length history) > (historyAt + 1)) {
            removeLast history
        }
        push history nextId
        historyAt = ((array_length history) - 1)
        pageId = nextId
        status = (this.describe())
        return true
    }

    fn goBack:boolean () {
        if (historyAt <= 0) {
            return false
        }
        historyAt = (historyAt - 1)
        pageId = (itemAt history historyAt)
        status = (this.describe())
        return true
    }

    fn goForward:boolean () {
        if (historyAt >= ((array_length history) - 1)) {
            return false
        }
        historyAt = (historyAt + 1)
        pageId = (itemAt history historyAt)
        status = (this.describe())
        return true
    }

    fn canBack:boolean () {
        return (historyAt > 0)
    }

    fn canForward:boolean () {
        return (historyAt < ((array_length history) - 1))
    }

    ; A catalogue page — the UML overview and the diff summary — selects a
    ; class on click and opens it on double-click, so Zoom to selected has
    ; something to zoom to.
    fn selectsOnly:boolean () {
        if ((indexOf pageId "uml:") == 0) {
            return true
        }
        if ((indexOf pageId "diff:") == 0) {
            return true
        }
        return false
    }

    ; True when the click changed the page — the host should rebuild the
    ; FlowGraph. Background clicks and unknown kinds leave the drawing.
    fn handleClick:boolean (ev:FlowHitEvent) {
        if (ev.kind != "node") {
            return false
        }
        if (ev.dataKind == "page") {
            return (this.goTo(ev.dataRef))
        }
        if (ev.dataKind == "method") {
            return (this.goTo(pages.methodPageId(ev.dataRef)))
        }
        ; On a UML page a class box is selected, not opened — Zoom to selected
        ; needs something still on the drawing. Double-click (openAt) drills.
        ; Overview name-boxes and related classes on a class page still open.
        def classBox:boolean false
        if (ev.dataKind == "class") { classBox = true }
        if (ev.dataKind == "umlclass") { classBox = true }
        if classBox {
            if (this.selectsOnly()) {
                return false
            }
            def ref:string ev.dataRef
            if ((strlen ref) == 0) {
                ref = ev.id
            }
            return (this.goTo(pages.classPageId(ref)))
        }
        ; A node whose domain forgot to set dataKind still has an id that
        ; might be a class or a method.
        if (model.hasClass(ev.id)) {
            if (this.selectsOnly()) {
                return false
            }
            return (this.goTo(pages.classPageId(ev.id)))
        }
        if (model.hasMethod(ev.id)) {
            return (this.goTo(pages.methodPageId(ev.id)))
        }
        return false
    }
}

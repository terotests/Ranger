; FlowWrap: a long top-to-bottom flow cut into columns.
;   npm run rangerflow:wrap:test
Import "../domains/mermaid/MermaidRender.rgr"
Import "../layout/FlowWrap.rgr"

class FlowWrapTest {
    def fails:int 0
    def passes:int 0

    fn ok:void (cond:boolean what:string) {
        if cond {
            passes = (passes + 1)
        } {
            fails = (fails + 1)
            print ("FAIL " + what)
        }
    }

    sfn chain:string () {
        return ("flowchart TB\n"
            + "  A[Uusi projekti] --> B{Kuka tietää?}\n  B -->|Minä ehkä| C[Avaa README]\n  B -->|Ei kukaan| C\n"
            + "  C --> D{README ajan tasalla?}\n  D -->|Ei| E[git log]\n  D -->|Kyllä| F[Kokeillaan ajaa]\n"
            + "  E --> F\n  F --> G{Käynnistyykö?}\n  G -->|Kyllä| H[Miksi tämä toimii?]\n  G -->|Ei| I[Katso erroria]\n"
            + "  I --> J[Google / AI]\n  J --> K[Ahaa]\n  K --> F\n  H --> L[Pieni muutos]\n"
            + "  L --> M{Toimiiko vielä?}\n  M -->|Kyllä| N[LGTM]\n  M -->|Ei| I\n  N --> O[Ymmärrys 34 %]\n")
    }

    sfn graphOf:FlowGraph (text:string) {
        def d:MermaidDrawing (MermaidRender.draw(text (FlowStyle.named("default"))))
        return d.graph
    }

    sfn width:double (g:FlowGraph) {
        def x0:double 1000000.0
        def x1:double -1000000.0
        def i:int 0
        while (i < (g.nodeCount())) {
            def n:FlowNode (g.nodeAt(i))
            if (n.x < x0) { x0 = n.x }
            if ((n.x + n.width) > x1) { x1 = (n.x + n.width) }
            i = (i + 1)
        }
        return (x1 - x0)
    }

    sfn height:double (g:FlowGraph) {
        def y0:double 1000000.0
        def y1:double -1000000.0
        def i:int 0
        while (i < (g.nodeCount())) {
            def n:FlowNode (g.nodeAt(i))
            if (n.y < y0) { y0 = n.y }
            if ((n.y + n.height) > y1) { y1 = (n.y + n.height) }
            i = (i + 1)
        }
        return (y1 - y0)
    }

    ; how far a ratio is from a target, either way round
    sfn off:double (r:double target:double) {
        def q:double (r / target)
        if (q < 1.0) {
            q = (1.0 / q)
        }
        return q
    }

    sfn overlaps:int (g:FlowGraph) {
        def c:int 0
        def i:int 0
        while (i < (g.nodeCount())) {
            def a:FlowNode (g.nodeAt(i))
            def j:int (i + 1)
            while (j < (g.nodeCount())) {
                def b:FlowNode (g.nodeAt(j))
                def sepX:boolean (((a.x + a.width) <= b.x) || ((b.x + b.width) <= a.x))
                def sepY:boolean (((a.y + a.height) <= b.y) || ((b.y + b.height) <= a.y))
                if ((! sepX) && (! sepY)) {
                    c = (c + 1)
                }
                j = (j + 1)
            }
            i = (i + 1)
        }
        return c
    }

    fn run:void () {
        def g:FlowGraph (FlowWrapTest.graphOf((FlowWrapTest.chain())))
        def w0:double (FlowWrapTest.width(g))
        def h0:double (FlowWrapTest.height(g))
        this.ok((h0 > (w0 * 2.0)) "the chain is laid out tall")
        def wrap (new FlowWrap())
        def did:boolean (wrap.apply(g 1.5 6))
        this.ok(did "a tall chain in a wide space is wrapped")
        this.ok((wrap.columns >= 2) ("into columns: " + (to_string wrap.columns)))
        def w1:double (FlowWrapTest.width(g))
        def h1:double (FlowWrapTest.height(g))
        def before:double (FlowWrapTest.off((w0 / h0) 1.5))
        def after:double (FlowWrapTest.off((w1 / h1) 1.5))
        this.ok((after < before) ("nearer the space's shape: " + (to_string w1) + "x" + (to_string h1)))
        this.ok(((FlowWrapTest.overlaps(g)) == 0) "no two boxes overlap")
        def routed:int 0
        def e:int 0
        while (e < (g.edgeCount())) {
            def ed:FlowEdge (g.edgeAt(e))
            if (((array_length ed.waypoints) >= 4) && (ed.sourceHandle >= 0)) {
                routed = (routed + 1)
            }
            e = (e + 1)
        }
        this.ok((routed == (g.edgeCount())) "every edge is routed again")
        ; the scene still draws, with every node and edge tagged
        def sc:FlowScene (MermaidRender.sceneWrapped((FlowWrapTest.chain()) "default" 0.0 20.0 1.5))
        this.ok(((sc.worldW / sc.worldH) > 0.5) ("the wrapped scene is a block: " + (to_string sc.worldW) + "x" + (to_string sc.worldH)))

        ; a narrow space keeps one column
        def g2:FlowGraph (FlowWrapTest.graphOf((FlowWrapTest.chain())))
        def narrow (new FlowWrap())
        this.ok((! (narrow.apply(g2 0.3 6))) "a narrow space keeps one column")
        ; a short flow is left alone
        def g3:FlowGraph (FlowWrapTest.graphOf("flowchart TB\n  A --> B\n  B --> C\n"))
        def short (new FlowWrap())
        this.ok((! (short.apply(g3 1.5 6))) "a short flow is not cut")
        ; groups are left alone
        def g4:FlowGraph (FlowWrapTest.graphOf("flowchart TB\n  subgraph S\n  A --> B\n  end\n  B --> C\n  C --> D\n  D --> E\n  E --> F\n  F --> G\n  G --> H\n"))
        def grouped (new FlowWrap())
        this.ok((! (grouped.apply(g4 1.5 6))) "a flow with a group is not cut")
    }

    sfn main:void () {
        def t (new FlowWrapTest())
        t.run()
        print ((to_string t.passes) + " passed, " + (to_string t.fails) + " failed")
    }
}

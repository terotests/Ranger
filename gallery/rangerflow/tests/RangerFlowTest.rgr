    ; --------------------------------------------------- no stuck modes -----
    ; The bug this exists for: the element tool's `+` switched `connectOnClick`
    ; on and nothing ever switched it off, so after one use every click started
    ; a connection and the editor could not be used for anything else again.
    ; That is not a bug about connecting — it is a bug about a mode with no way
    ; out, and the only defence is to enumerate the ways in and check every one
    ; of them can be left.
    ;
    ; So: get into each mode, then apply the two universal escapes — a press
    ; and release on empty canvas, and the Escape key — and assert the editor
    ; is idle afterwards. A mode added later that forgets to clean up fails
    ; here rather than in somebody's hands.
    sfn testNoStuckModes:void (c:Checker) {
        c.section("no mode is left on for ever")
        def names:[string]
        push names "pan"
        push names "drag a node"
        push names "box select"
        push names "drag from a handle"
        push names "resize"
        push names "type in a label"
        push names "click a handle"
        push names "the + tool"
        push names "move an edge end"
        push names "the context menu"
        push names "a pinch"
        push names "connect mode from the toolbar"

        def i:int 0
        while (i < (array_length names)) {
            def what:string (itemAt names i)
            ; Escape first, then the same run again with a click on empty
            ; canvas — both have to work, and a mode that only one of them
            ; clears is a mode that traps a reader who reached for the other.
            def viaEscape:FlowEditor (RangerFlowTest.enterMode(i))
            c.ok((what + ": the mode is actually on")  ((viaEscape.idle()) == false))
            viaEscape.keyDown("Escape" false false)
            c.ok((what + ": Escape gets out") (viaEscape.idle()))

            def viaClick:FlowEditor (RangerFlowTest.enterMode(i))
            def away (new FlowInput)
            away.x = 940.0
            away.y = 560.0
            viaClick.pointerUp(away)
            viaClick.pointerDown(away)
            viaClick.pointerUp(away)
            c.ok((what + ": a click on the canvas gets out") (viaClick.idle()))
            i = (i + 1)
        }
    }

    ; One editor, driven into mode `which` and left there.
    sfn enterMode:FlowEditor (which:int) {
        def g:FlowGraph (RangerFlowTest.twoTables())
        def step:FlowNode (g.node("step" "Vaihe" 60.0 400.0))
        step.width = 160.0
        step.height = 60.0
        step.resizable = true
        step.addSideHandles()
        step.syncFromModel()
        g.reindex()
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(1000.0 700.0)
        ed.view.showControls = false
        ed.view.showMinimap = false
        def onNodeX:double (ed.view.sx((step.centerX())))
        def onNodeY:double (ed.view.sy((step.centerY())))
        def emptyX:double 940.0
        def emptyY:double 560.0
        def inp (new FlowInput)

        if (which == 0) {
            inp.x = emptyX
            inp.y = emptyY
            ed.pointerDown(inp)
            inp.x = (emptyX - 60.0)
            ed.pointerMove(inp)
            return ed
        }
        if (which == 1) {
            inp.x = onNodeX
            inp.y = onNodeY
            ed.pointerDown(inp)
            inp.x = (onNodeX + 40.0)
            ed.pointerMove(inp)
            return ed
        }
        if (which == 2) {
            inp.x = emptyX
            inp.y = emptyY
            inp.shift = true
            ed.pointerDown(inp)
            inp.x = (emptyX - 120.0)
            inp.y = (emptyY - 90.0)
            ed.pointerMove(inp)
            return ed
        }
        if (which == 3) {
            def p:FlowPort (itemAt step.ports 1)
            inp.x = (ed.view.sx((step.portX(p))))
            inp.y = (ed.view.sy((step.portY(p))))
            ed.pointerDown(inp)
            inp.x = (inp.x + 60.0)
            ed.pointerMove(inp)
            return ed
        }
        if (which == 4) {
            step.selected = true
            inp.x = (ed.view.sx((step.x + step.width)))
            inp.y = (ed.view.sy((step.y + step.height)))
            ed.pointerDown(inp)
            inp.x = (inp.x + 30.0)
            ed.pointerMove(inp)
            return ed
        }
        if (which == 5) {
            ed.beginEdit("node:step")
            ed.typeText("x")
            return ed
        }
        if (which == 6) {
            ; A press and release on a handle without moving: a CLICK, which
            ; arms the connection and leaves the line following the pointer.
            def p2:FlowPort (itemAt step.ports 1)
            inp.x = (ed.view.sx((step.portX(p2))))
            inp.y = (ed.view.sy((step.portY(p2))))
            ed.pointerDown(inp)
            ed.pointerUp(inp)
            return ed
        }
        if (which == 7) {
            step.selected = true
            ed.pressTool("connect")
            return ed
        }
        if (which == 8) {
            def e:FlowEdge (g.edgeAt(0))
            e.selected = true
            inp.x = (ed.view.sx((g.endpointX(e false))))
            inp.y = (ed.view.sy((g.endpointY(e false))))
            ed.pointerDown(inp)
            inp.x = (inp.x + 40.0)
            ed.pointerMove(inp)
            return ed
        }
        if (which == 9) {
            ed.openMenuAt(onNodeX onNodeY)
            return ed
        }
        if (which == 10) {
            ed.pinchBegin(300.0 300.0 400.0 300.0)
            ed.pinchTo(280.0 300.0 420.0 300.0)
            return ed
        }
        ; The toolbar's own connect toggle, which is sticky ON PURPOSE — but
        ; still has to be something Escape and a click can get out of.
        ed.connectOnClick = true
        inp.x = onNodeX
        inp.y = onNodeY
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        return ed
    }

    ; -------------------------------------------- clicking a handle ---------
    sfn testPortClickConnect:void (c:Checker) {
        c.section("click a handle to connect")
        def g:FlowGraph (RangerFlowTest.twoTables())
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(1000.0 700.0)
        def customers:FlowNode (g.nodeById("customers"))
        def orders:FlowNode (g.nodeById("orders"))
        def from:FlowPort (g.portRef("customers.email:r"))
        def to:FlowPort (g.portRef("orders.id:l"))
        def edges0:int (g.edgeCount())

        ; A press and release with no movement is a click: it arms rather than
        ; cancelling, which is the whole of what was asked for.
        def inp (new FlowInput)
        inp.x = (ed.view.sx((customers.portX(from))))
        inp.y = (ed.view.sy((customers.portY(from))))
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        c.ok("a click on a handle arms a connection" (ed.pending()))
        c.ok("and the line is drawn from it" ed.view.connecting)
        c.eqStr("from that handle" ed.view.connectFrom "customers.email:r")

        ; Over nothing: no target, and the preview says so.
        def over (new FlowInput)
        over.x = 900.0
        over.y = 620.0
        ed.pointerMove(over)
        c.ok("over bare canvas there is no target" (ed.view.connectValid == false))

        ; Over a handle it could land on: the preview says THAT.
        over.x = (ed.view.sx((orders.portX(to))))
        over.y = (ed.view.sy((orders.portY(to))))
        ed.pointerMove(over)
        c.ok("over a valid handle there is one" ed.view.connectValid)
        def sc:FlowScene (ed.view.build())
        c.ok("and the preview line is on the surface" ((RangerFlowTest.countTag(sc "chrome")) > 0))

        ; The second click lands it.
        ed.pointerDown(over)
        ed.pointerUp(over)
        c.eqInt("the second click makes the edge" (g.edgeCount()) (edges0 + 1))
        c.ok("and the mode is off again" ((ed.pending()) == false))
        c.ok("with nothing left running" (ed.idle()))
        def made:FlowEdge (g.edgeAt((g.edgeCount()) - 1))
        c.eqStr("joined at the handle it started from" made.sourcePort "customers.email:r")
        c.eqStr("to the one it was dropped on" made.targetPort "orders.id:l")
        ; The sides come from the handles, so the edge is not routed out of
        ; the node's default face and left looking detached.
        c.eqInt("leaving by the source handle's own side" made.sourceHandle from.side)
        c.eqInt("and arriving at the target's" made.targetHandle to.side)

        ; Armed and then clicked somewhere useless: cancelled, nothing made.
        ; A handle that already has a line on it is still a place to start a
        ; NEW connection from — the end of the existing line is only grabbable
        ; once that edge is selected.
        def n1:int (g.edgeCount())
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        c.ok("armed again, from a handle already in use" (ed.pending()))
        ; Genuinely empty canvas. The bottom-right corner is the minimap,
        ; which is chrome and answers a press of its own.
        def nowhere (new FlowInput)
        nowhere.x = 900.0
        nowhere.y = 200.0
        ed.pointerDown(nowhere)
        ed.pointerUp(nowhere)
        c.eqInt("a click on nothing makes no edge" (g.edgeCount()) n1)
        c.ok("and cancels the connection" ((ed.pending()) == false))

        ; The minimap is a place to GO, not a thing to drag. Until it was hit
        ; tested, a press meant for it fell through to the pane and panned the
        ; canvas — which drags the content, so the view moved the opposite way
        ; to the one the reader pushed.
        def onMap (new FlowInput)
        onMap.x = ((ed.view.width - 60.0))
        onMap.y = ((ed.view.height - 60.0))
        c.ok("the bottom-right corner is the minimap" (ed.view.minimapAt(onMap.x onMap.y)))
        def beforeX:double ed.view.viewport.x
        def beforeY:double ed.view.viewport.y
        ed.pointerDown(onMap)
        c.eqInt("and a press on it steers rather than pans" ed.mode 9)
        def steeredY:double ed.view.viewport.y
        ed.pointerUp(onMap)
        c.ok("the view moved" (((fabs (steeredY - beforeY)) + (fabs (ed.view.viewport.x - beforeX))) > 0.5))
        ; What the press means, said in the coordinates it is about: the flow
        ; point in the middle of the screen. A point higher on the map has to
        ; put a HIGHER part of the diagram there. Panning moved it the other
        ; way, and that is what "mirrored" looked like.
        def midY:double (ed.view.height * 0.5)
        def sawY:double (ed.view.viewport.toFlowY(midY))
        def higher (new FlowInput)
        higher.x = onMap.x
        higher.y = (onMap.y - 40.0)
        ed.pointerDown(higher)
        def sawHigher:double (ed.view.viewport.toFlowY(midY))
        ed.pointerUp(higher)
        c.ok("and a point higher on the map centres a higher part of the diagram" (sawHigher < sawY))
        def midX:double (ed.view.width * 0.5)
        def sawX:double (ed.view.viewport.toFlowX(midX))
        def righter (new FlowInput)
        righter.x = (onMap.x + 40.0)
        righter.y = higher.y
        ed.pointerDown(righter)
        def sawRight:double (ed.view.viewport.toFlowX(midX))
        ed.pointerUp(righter)
        c.ok("and a point further right, a part further right" (sawRight > sawX))
        c.ok("leaving the editor idle" (ed.idle()))

        ; Dragging from a handle still works exactly as it did.
        def dragInp (new FlowInput)
        dragInp.x = (ed.view.sx((customers.portX(from))))
        dragInp.y = (ed.view.sy((customers.portY(from))))
        ed.pointerDown(dragInp)
        dragInp.x = (ed.view.sx((orders.portX(to))))
        dragInp.y = (ed.view.sy((orders.portY(to))))
        ed.pointerMove(dragInp)
        ed.pointerUp(dragInp)
        c.ok("a drag is not armed afterwards" ((ed.pending()) == false))
        c.ok("and the editor is idle" (ed.idle()))
    }

    sfn hasSub:boolean (hay:string needle:string) {
        def n:int (strlen hay)
        def m:int (strlen needle)
        if (m == 0) { return true }
        if (m > n) { return false }
        def i:int 0
        while (i <= (n - m)) {
            if ((substring hay i (i + m)) == needle) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn countTag:int (sc:FlowScene tag:string) {
        def n:int 0
        def i:int 0
        while (i < (sc.count())) {
            def it:SceneItem (sc.at(i))
            if (it.tag == tag) { n = (n + 1) }
            i = (i + 1)
        }
        return n
    }

    sfn countPrefix:int (sc:FlowScene prefix:string) {
        def n:int 0
        def m:int (strlen prefix)
        def i:int 0
        while (i < (sc.count())) {
            def it:SceneItem (sc.at(i))
            if ((strlen it.tag) >= m) {
                if ((substring it.tag 0 m) == prefix) {
                    n = (n + 1)
                }
            }
            i = (i + 1)
        }
        return n
    }

    ; ------------------------------------------- the grip on an edge's end ---
    ; The reconnect gesture is older than the grip that shows it, and being
    ; invisible it may as well not have existed: an end nobody can see is an
    ; end nobody takes hold of. On a plain flowchart there is a second half to
    ; it — no node there has handles of its own until something asks for them,
    ; and an end that is not on a handle used to be an end that could not move.
    sfn testEdgeEndGrips:void (c:Checker) {
        c.section("the grip on a selected edge's end")
        def g (new FlowGraph)
        def a:FlowNode (g.node("a" "A" 0.0 0.0))
        def b:FlowNode (g.node("b" "B" 400.0 0.0))
        def d:FlowNode (g.node("d" "D" 400.0 300.0))
        a.width = 150.0
        a.height = 50.0
        b.width = 150.0
        b.height = 50.0
        d.width = 150.0
        d.height = 50.0
        def e:FlowEdge (g.connect("a" "b"))
        e.edgeType = "smoothstep"
        g.reindex()
        c.eqStr("a flowchart edge has no handle of its own" e.targetPort "")
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(1000.0 700.0)

        def before:FlowScene (ed.view.build())
        c.eqInt("an unselected edge draws no grips" (RangerFlowTest.countPrefix(before "edgeend:")) 0)
        e.selected = true
        def after:FlowScene (ed.view.build())
        c.eqInt("a selected one draws one on each end" (RangerFlowTest.countPrefix(after "edgeend:")) 2)

        def inp (new FlowInput)
        inp.x = (ed.view.sx((g.endpointX(e false))))
        inp.y = (ed.view.sy((g.endpointY(e false))))
        c.ok("and the grip is where the hit test says it is" ((ed.edgeEndAt(inp.x inp.y)) >= 0))
        ed.pointerDown(inp)
        c.eqInt("pressing on it starts a reconnect" ed.mode 8)
        c.ok("of the target end" (ed.reconnectAtSource == false))
        def during:FlowScene (ed.view.build())
        c.eqInt("the grips give way to the preview line" (RangerFlowTest.countPrefix(during "edgeend:")) 0)

        inp.x = (ed.view.sx((d.x + (d.width * 0.5))))
        inp.y = (ed.view.sy((d.y + (d.height * 0.5))))
        ed.pointerMove(inp)
        c.ok("another box is a place it can go" ed.view.connectValid)
        ed.pointerUp(inp)
        c.eqStr("the end moved to that box" e.target "d")
        c.ok("landing on one of its handles" ((strlen e.targetPort) > 0))
        c.eqInt("and no second edge was made" (g.edgeCount()) 1)
        c.ok("nothing left running" (ed.idle()))

        c.ok("the move is undoable" (ed.undo.undo(g)))
        c.eqStr("undo puts the end back on the box it came from" e.target "b")
        c.eqStr("with no handle it never had" e.targetPort "")
        c.ok("redo is offered" (ed.undo.redo(g)))
        c.eqStr("and moves it again" e.target "d")

        ; An end may not be dropped on the box the other end is on.
        def back (new FlowInput)
        back.x = (ed.view.sx((g.endpointX(e false))))
        back.y = (ed.view.sy((g.endpointY(e false))))
        ed.pointerDown(back)
        back.x = (ed.view.sx((a.x + (a.width * 0.5))))
        back.y = (ed.view.sy((a.y + (a.height * 0.5))))
        ed.pointerMove(back)
        c.ok("its own other end is not a target" (ed.view.connectValid == false))
        ed.pointerUp(back)
        c.eqStr("so nothing moved" e.target "d")
    }

    ; ------------------------------------------------ moving an edge end ----
    sfn testReconnect:void (c:Checker) {
        c.section("moving an edge's end to another socket")
        def g:FlowGraph (RangerFlowTest.twoTables())
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(1000.0 700.0)
        def customers:FlowNode (g.nodeById("customers"))
        def e:FlowEdge (g.edgeAt(0))
        c.eqStr("it starts on the primary key" e.targetPort "customers.id:r")

        ; An end is only grabbable on a SELECTED edge — otherwise a click on a
        ; handle that already has a line on it could never start a second
        ; connection, because the end and the handle are the same point.
        def unselected (new FlowInput)
        unselected.x = (ed.view.sx((g.endpointX(e false))))
        unselected.y = (ed.view.sy((g.endpointY(e false))))
        ed.pointerDown(unselected)
        c.ok("an unselected edge's end is not grabbed" (ed.mode != 8))
        ed.keyDown("Escape" false false)
        e.selected = true

        ; Grab the target end and drop it on the other column's handle.
        def endX:double (g.endpointX(e false))
        def endY:double (g.endpointY(e false))
        def inp (new FlowInput)
        inp.x = (ed.view.sx(endX))
        inp.y = (ed.view.sy(endY))
        ed.pointerDown(inp)
        c.eqInt("grabbing the end starts a reconnect" ed.mode 8)
        c.ok("and it is the target end" (ed.reconnectAtSource == false))

        def other:FlowPort (g.portRef("customers.email:r"))
        inp.x = (ed.view.sx((customers.portX(other))))
        inp.y = (ed.view.sy((customers.portY(other))))
        ed.pointerMove(inp)
        c.ok("the other column is a valid place to put it" ed.view.connectValid)
        ed.pointerUp(inp)
        c.eqStr("the end moved" e.targetPort "customers.email:r")
        c.eqInt("and no second edge was made" (g.edgeCount()) 1)
        c.ok("nothing left running" (ed.idle()))
        ed.undo.undo(g)
        c.eqStr("one undo puts it back" e.targetPort "customers.id:r")
        ed.undo.redo(g)
        c.eqStr("and redo moves it again" e.targetPort "customers.email:r")
        ed.undo.undo(g)

        ; Dropped on nothing: the end goes back where it was, rather than the
        ; edge being deleted or left hanging in the air.
        inp.x = (ed.view.sx((g.endpointX(e false))))
        inp.y = (ed.view.sy((g.endpointY(e false))))
        ed.pointerDown(inp)
        inp.x = 900.0
        inp.y = 640.0
        ed.pointerMove(inp)
        ed.pointerUp(inp)
        c.eqStr("dropped on nothing, the end stays put" e.targetPort "customers.id:r")
        c.eqInt("and the edge survives" (g.edgeCount()) 1)
        c.ok("idle again" (ed.idle()))

        ; An end may not be dropped on its own other end.
        def selfInp (new FlowInput)
        selfInp.x = (ed.view.sx((g.endpointX(e false))))
        selfInp.y = (ed.view.sy((g.endpointY(e false))))
        ed.pointerDown(selfInp)
        selfInp.x = (ed.view.sx((g.endpointX(e true))))
        selfInp.y = (ed.view.sy((g.endpointY(e true))))
        ed.pointerMove(selfInp)
        c.ok("its own other end is not a target" (ed.view.connectValid == false))
        ed.pointerUp(selfInp)
        c.eqStr("so nothing moved" e.targetPort "customers.id:r")

        ; Grabbing the MIDDLE of a line is still a segment drag, not a
        ; reconnect — the two would fight over every click otherwise.
        def midInp (new FlowInput)
        def path:EdgePath (EdgeRouter.route(g e))
        midInp.x = (ed.view.sx((path.midX())))
        midInp.y = (ed.view.sy((path.midY())))
        ed.pointerDown(midInp)
        c.ok("the middle of a line is not an end" (ed.mode != 8))
        ed.keyDown("Escape" false false)
        c.ok("idle" (ed.idle()))
    }

    ; ------------------------------------------------------ wheel gestures ---
    sfn testWheelGesture:void (c:Checker) {
        c.section("wheel, trackpad and pinch")
        ; The classification first, because everything else follows from it.
        c.ok("a wheel notch is not a pan" ((FlowEditor.wheelIsPan(0.0 100.0 false)) == false))
        c.ok("nor is a notch the other way" ((FlowEditor.wheelIsPan(0.0 -100.0 false)) == false))
        c.ok("nor three lines of one" ((FlowEditor.wheelIsPan(0.0 3.0 true)) == false))
        c.ok("anything sideways is a trackpad" (FlowEditor.wheelIsPan(12.0 4.0 false)))
        c.ok("so is a fractional delta" (FlowEditor.wheelIsPan(0.0 41.5 false)))
        c.ok("and so is a small one" (FlowEditor.wheelIsPan(0.0 12.0 false)))

        def g (new FlowGraph)
        g.node("a" "A" 0.0 0.0)
        g.reindex()
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(800.0 600.0)
        ed.view.viewport.zoom = 1.0
        ed.view.viewport.x = 0.0
        ed.view.viewport.y = 0.0

        ; A wheel notch zooms, and the point under the pointer holds still.
        def held:double (ed.flowX(400.0))
        ed.wheelGesture(400.0 300.0 0.0 -100.0 false false)
        c.ok("a wheel notch up zooms in" (ed.view.viewport.zoom > 1.0))
        c.near("about the pointer" (ed.flowX(400.0)) held 0.0001)
        ed.wheelGesture(400.0 300.0 0.0 100.0 false false)
        c.near("and back down again" ed.view.viewport.zoom 1.0 0.0001)

        ; Two fingers scrolling PANS. It used to zoom, by the sign of deltaY —
        ; and that sign flips with the platform's "natural scrolling" setting,
        ; so the same gesture zoomed in for one reader and out for another and
        ; there was no way to tell which from here.
        def zoomBefore:double ed.view.viewport.zoom
        def panBefore:double ed.view.viewport.y
        ed.wheelGesture(400.0 300.0 0.0 -12.0 false false)
        c.near("a trackpad scroll does not zoom" ed.view.viewport.zoom zoomBefore 0.0001)
        c.near("it pans, with the fingers" ed.view.viewport.y (panBefore + 12.0) 0.0001)
        ed.wheelGesture(400.0 300.0 8.0 0.0 false false)
        c.near("sideways too" ed.view.viewport.x -8.0 0.0001)

        ; A pinch zooms whichever way the fingers went, because the platform
        ; marks it as a pinch rather than leaving us to infer it.
        ed.view.viewport.zoom = 1.0
        def heldY:double (ed.flowY(300.0))
        ed.wheelGesture(400.0 300.0 0.0 -20.0 true false)
        c.ok("pinching open zooms in" (ed.view.viewport.zoom > 1.0))
        c.near("about the point between the fingers" (ed.flowY(300.0)) heldY 0.0001)
        def opened:double ed.view.viewport.zoom
        ed.wheelGesture(400.0 300.0 0.0 20.0 true false)
        c.ok("pinching shut zooms out" (ed.view.viewport.zoom < opened))
        ; Small deltas, so the approximation to e^x has to be close.
        ed.view.viewport.zoom = 1.0
        ed.wheelGesture(400.0 300.0 0.0 -10.0 true false)
        c.near("ten pixels of pinch is about ten per cent" ed.view.viewport.zoom 1.105 0.01)
    }

    ; ------------------------------------------------- columns on a table ---
    ; A schema you can look at and not change is a picture of a schema. Column
    ; NAMES have been editable since in-place editing landed — which is enough
    ; to fix a typo and no help at all when a table is missing a column.
    sfn testColumns:void (c:Checker) {
        c.section("adding and dropping columns")
        def g:FlowGraph (RangerFlowTest.twoTables())
        def customers:FlowNode (g.nodeById("customers"))
        def orders:FlowNode (g.nodeById("orders"))
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(1200.0 800.0)
        def rows0:int (customers.rowTotal())
        def h0:double customers.height
        def ports0:int (array_length customers.ports)

        ; --- add ---------------------------------------------------------
        def at:int (ed.addRow("customers" -1))
        c.eqInt("the new column is at the end" at rows0)
        c.eqInt("the table has one more" (customers.rowTotal()) (rows0 + 1))
        c.ok("and got taller for it" (customers.height > h0))
        ; A column is a row PLUS the two ports opposite it, one per side, or
        ; there is nothing on the table to connect a foreign key to.
        c.eqInt("two more ports" (array_length customers.ports) (ports0 + 2))
        def fresh:FlowRow (FlowUndo.rowOf(customers at))
        c.eqStr("named from the placeholder" fresh.text "uusi_sarake")
        c.ok("with a port of its own" ((strlen fresh.portId) > 0))
        def pr:int (customers.portIndex((fresh.portId + ":r")))
        c.ok("the right-hand one exists" (pr >= 0))
        def prp:FlowPort (itemAt customers.ports pr)
        c.near("and sits opposite the row" (customers.portY(prp)) (customers.y + (customers.rowCenterY(0 at))) 0.001)

        ; The table has to be wide enough for what is now in it. A column
        ; added to a box sized once, by whoever built it, would otherwise run
        ; out of its own edge.
        def wide:double customers.width
        def long:FlowRow (FlowUndo.rowOf(customers at))
        long.text = "asiakkaan_laskutusosoitteen_postinumero"
        ed.fitToRows(customers)
        c.ok("the table widened for a long column name" (customers.width > wide))

        ; --- one undo takes it back --------------------------------------
        ed.undo.undo(g)
        c.eqInt("undo drops the column" (customers.rowTotal()) rows0)
        c.eqInt("and its ports with it" (array_length customers.ports) ports0)
        ed.undo.redo(g)
        c.eqInt("redo puts it back" (customers.rowTotal()) (rows0 + 1))
        ed.undo.undo(g)

        ; --- insert in the middle ------------------------------------------
        def mid:int (ed.addRow("customers" 0))
        c.eqInt("after row 0 means row 1" mid 1)
        def first:FlowRow (FlowUndo.rowOf(customers 0))
        c.eqStr("and row 0 is untouched" first.text "id")
        ed.undo.undo(g)

        ; --- drop, and take the foreign keys with it -----------------------
        ; `orders.customer_id` points at `customers.id`. Dropping the column
        ; the arrow lands on has to take the arrow too — an edge pointing at a
        ; port that is gone is drawn from the middle of the table, which looks
        ; like a bug and is one.
        def edges0:int (g.edgeCount())
        c.eqInt("the schema starts with one relation" edges0 1)
        c.ok("dropping the primary key works" (ed.removeRow("customers" 0)))
        c.eqInt("the column is gone" (customers.rowTotal()) (rows0 - 1))
        c.eqInt("and so is the relation to it" (g.edgeCount()) 0)
        ; …and one undo brings both back.
        ed.undo.undo(g)
        c.eqInt("undo restores the column" (customers.rowTotal()) rows0)
        c.eqInt("and the relation" (g.edgeCount()) 1)
        def restored:FlowRow (FlowUndo.rowOf(customers 0))
        c.eqStr("the same column, not a copy of it" restored.text "id")
        def again:int (customers.portIndex("customers.id:r"))
        c.ok("with its port back" (again >= 0))

        ; --- the type is editable too, not only the name --------------------
        ; Two pieces of text in one row, edited for different reasons. Which
        ; one you get is which one you pointed at.
        def rowY:double (customers.y + (customers.rowCenterY(0 1)))
        def nameX:double (customers.x + 40.0)
        def typeX:double ((customers.x + customers.width) - 30.0)
        c.eqStr("pointing at the left of a row edits the name" (ed.textAt((ed.view.sx(nameX)) (ed.view.sy(rowY)))) "row:customers:1")
        c.eqStr("pointing at the right of it edits the type" (ed.textAt((ed.view.sx(typeX)) (ed.view.sy(rowY)))) "row:customers:1:type")
        def email:FlowRow (FlowUndo.rowOf(customers 1))
        c.eqStr("the type reads back through the tag" (FlowUndo.readText(g "row:customers:1:type")) email.detail)
        ed.beginEdit("row:customers:1:type")
        c.ok("editing it starts from what it says" (ed.editText == email.detail))
        ed.setEditText("TEXT" 4)
        ed.commitEdit()
        c.eqStr("and writes only the type" email.detail "TEXT")
        c.eqStr("leaving the name alone" email.text "email")
        ed.undo.undo(g)
        c.eqStr("one undo takes the type back" email.detail "VARCHAR")

        ; --- a step is not a table -----------------------------------------
        def plain:FlowNode (g.node("step" "Vaihe" 900.0 0.0))
        g.reindex()
        c.eqInt("a node with no compartments has no column to add" (ed.addRow("step" -1)) -1)
        c.ok("and none to drop" ((ed.removeRow("step" 0)) == false))
    }

    ; `customers` and `orders`, joined by one foreign key. Two tables is the
    ; smallest schema in which dropping a column can strand a relation.
    sfn twoTables:FlowGraph () {
        def g (new FlowGraph)
        def customers:FlowNode (FlowNode.create("customers" "customers" 0.0 0.0))
        customers.width = 220.0
        def sec:FlowSection (customers.addSection(""))
        def id:FlowRow (FlowRow.create("pk" "id" "INTEGER" ""))
        id.portId = "customers.id"
        id.emphasis = 1
        sec.addRow(id)
        def email:FlowRow (FlowRow.create("" "email" "VARCHAR" ""))
        email.portId = "customers.email"
        sec.addRow(email)
        customers.layoutCompartments()
        g.addNode(customers)

        def orders:FlowNode (FlowNode.create("orders" "orders" 500.0 0.0))
        orders.width = 220.0
        def sec2:FlowSection (orders.addSection(""))
        def oid:FlowRow (FlowRow.create("pk" "id" "INTEGER" ""))
        oid.portId = "orders.id"
        sec2.addRow(oid)
        def fk:FlowRow (FlowRow.create("fk" "customer_id" "INTEGER" "FK"))
        fk.portId = "orders.customer_id"
        sec2.addRow(fk)
        orders.layoutCompartments()
        g.addNode(orders)

        def e:FlowEdge (FlowEdge.create("fk1" "orders" "customers"))
        e.sourcePort = "orders.customer_id:l"
        e.targetPort = "customers.id:r"
        e.edgeType = "smoothstep"
        g.addEdge(e)
        g.reindex()
        return g
    }

    ; ------------------------------------------------------------ rotation --
    ; Every piece of geometry on a node already went through four functions —
    ; the outline, the hit test, the port position, the handle position — so
    ; rotation is done there and nowhere else. These check that all four spun,
    ; because three out of four is a node you can see turned and cannot click.
    sfn testRotation:void (c:Checker) {
        c.section("rotation")
        def g (new FlowGraph)
        def n:FlowNode (g.node("a" "A" 100.0 100.0))
        n.width = 200.0
        n.height = 80.0
        n.addSideHandles()
        n.syncFromModel()
        g.reindex()
        def cx:double (n.centerX())
        def cy:double (n.centerY())
        c.ok("upright by default" ((n.spun()) == false))
        c.ok("the right-hand edge is inside" (n.holdsPoint((cx + 95.0) cy)))
        c.ok("and 95 below it is not" ((n.holdsPoint(cx (cy + 95.0))) == false))

        n.rotation = 90.0
        c.ok("turned" (n.spun()))
        ; The box was 200 by 80. A quarter turn makes it 80 by 200 about the
        ; same centre.
        def ring:[double] (n.outline())
        c.near("width after a quarter turn" (RangerFlowTest.span(ring true)) 80.0 0.001)
        c.near("height after a quarter turn" (RangerFlowTest.span(ring false)) 200.0 0.001)
        c.near("centre held" (RangerFlowTest.middle(ring true)) cx 0.001)
        c.ok("what was inside sideways is now outside" ((n.holdsPoint((cx + 95.0) cy)) == false))
        c.ok("and what was outside below is now inside" (n.holdsPoint(cx (cy + 95.0))))
        ; The right-hand handle went round to the bottom.
        c.near("the right handle is now below the centre" (n.handleY(1)) (cy + 100.0) 0.001)
        c.near("…and level with it across" (n.handleX(1)) cx 0.001)

        ; Any angle, not just the right ones: the ring's own corners have to
        ; be exactly where trigonometry puts them.
        n.rotation = 30.0
        def ring2:[double] (n.outline())
        def x0:double (itemAt ring2 0)
        def y0:double (itemAt ring2 1)
        def rad:double (0.5235987755982988)
        def ox:double (100.0 - cx)
        def oy:double (100.0 - cy)
        c.near("a corner at 30°, across" x0 (cx + ((ox * (cos rad)) - (oy * (sin rad)))) 0.001)
        c.near("a corner at 30°, down" y0 (cy + ((ox * (sin rad)) + (oy * (cos rad)))) 0.001)

        ; And it is an editor operation with an undo behind it.
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(800.0 600.0)
        n.rotation = 0.0
        n.selected = true
        c.eqInt("one node turned" (ed.rotateSelected(90.0)) 1)
        c.near("turned by ninety" n.rotation 90.0 0.001)
        ed.undo.undo(g)
        c.near("and undone" n.rotation 0.0 0.001)
        ed.undo.redo(g)
        c.near("and redone" n.rotation 90.0 0.001)
    }

    sfn span:double (pts:[double] wantX:boolean) {
        def lo:double 0.0
        def hi:double 0.0
        def first:boolean true
        def i:int 0
        while (i < (array_length pts)) {
            def v:double (itemAt pts i)
            if (wantX == false) {
                v = (itemAt pts (i + 1))
            }
            if first {
                lo = v
                hi = v
                first = false
            } {
                if (v < lo) { lo = v }
                if (v > hi) { hi = v }
            }
            i = (i + 2)
        }
        return (hi - lo)
    }

    sfn middle:double (pts:[double] wantX:boolean) {
        def lo:double 0.0
        def hi:double 0.0
        def first:boolean true
        def i:int 0
        while (i < (array_length pts)) {
            def v:double (itemAt pts i)
            if (wantX == false) {
                v = (itemAt pts (i + 1))
            }
            if first {
                lo = v
                hi = v
                first = false
            } {
                if (v < lo) { lo = v }
                if (v > hi) { hi = v }
            }
            i = (i + 2)
        }
        return ((lo + hi) * 0.5)
    }

    ; --------------------------------------------------------- annotations --
    sfn testAnnotations:void (c:Checker) {
        c.section("annotations")
        def g (new FlowGraph)
        def n:FlowNode (g.node("a" "Tarkista tilaus" 0.0 0.0))
        n.width = 200.0
        n.height = 80.0
        def m:FlowNode (g.node("b" "Lähetä" 0.0 240.0))
        m.width = 200.0
        m.height = 80.0
        def e:FlowEdge (g.connect("a" "b"))
        e.edgeType = "smoothstep"
        g.reindex()
        c.eqInt("a node starts with none" (n.annotationCount()) 0)
        def top:FlowAnnotation (n.addAnnotation("3" 0.1 0.15))
        top.bold = true
        n.addAnnotation("2 min" 0.85 0.85)
        e.addAnnotation("SLA 24 h" 0.5 -14.0)
        c.eqInt("two on the node" (n.annotationCount()) 2)
        c.eqInt("one on the edge" (e.annotationCount()) 1)
        def second:FlowAnnotation (n.annotationAt(1))
        c.eqStr("in the order they were added" second.text "2 min")

        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(900.0 700.0)
        ed.view.showControls = false
        ed.view.showMinimap = false
        def sc:FlowScene (ed.view.build())
        c.ok("the label is still drawn" ((RangerFlowTest.findText(sc "Tarkista tilaus")) >= 0))
        def hi:int (RangerFlowTest.findText(sc "3"))
        def lo:int (RangerFlowTest.findText(sc "2 min"))
        c.ok("the first annotation is drawn" (hi >= 0))
        c.ok("and the second" (lo >= 0))
        c.ok("the edge's too" ((RangerFlowTest.findText(sc "SLA 24 h")) >= 0))
        def hiItem:SceneItem (sc.at(hi))
        def loItem:SceneItem (sc.at(lo))
        c.ok("pinned where they were put, down the page" (hiItem.y < loItem.y))
        c.ok("and across it" (hiItem.x < loItem.x))
    }

    sfn findText:int (sc:FlowScene text:string) {
        def i:int 0
        while (i < (sc.count())) {
            def it:SceneItem (sc.at(i))
            if (it.kind == 1) {
                if (it.text == text) {
                    return i
                }
            }
            i = (i + 1)
        }
        return -1
    }

    ; ------------------------------------------------- menu and tooltip -----
    sfn testMenuAndTooltip:void (c:Checker) {
        c.section("context menu and tooltips")
        def g (new FlowGraph)
        def n:FlowNode (g.node("a" "Vaihe" 0.0 0.0))
        n.width = 180.0
        n.height = 70.0
        n.tooltip = "Tämä vaihe tarkistaa luottotiedot"
        g.node("b" "Toinen" 400.0 0.0)
        g.reindex()
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(900.0 700.0)
        ed.view.showControls = false
        ed.view.showMinimap = false

        def inp (new FlowInput)
        inp.x = (ed.view.sx(90.0))
        inp.y = (ed.view.sy(35.0))
        ed.pointerMove(inp)
        c.eqStr("resting on a node says what it has to say" ed.view.tooltipText "Tämä vaihe tarkistaa luottotiedot")
        inp.x = (ed.view.sx(700.0))
        inp.y = (ed.view.sy(600.0))
        ed.pointerMove(inp)
        c.eqStr("and nothing over bare canvas" ed.view.tooltipText "")

        ; Right-click on the node.
        def rc (new FlowInput)
        rc.x = (ed.view.sx(90.0))
        rc.y = (ed.view.sy(35.0))
        rc.secondary = true
        ed.pointerDown(rc)
        c.ok("the menu opened" (ed.menuOpen()))
        c.ok("on the node it was pointed at" (ed.view.menu.target == "node:a"))
        c.ok("and selected it" n.selected)
        c.ok("it offers a delete" ((RangerFlowTest.menuRow(ed.view "Poista")) >= 0))
        c.ok("the surface menu is a different menu" true)

        ; Picking the row does the thing.
        def row:int (RangerFlowTest.menuRow(ed.view "Käännä 90°"))
        c.ok("and a rotate" (row >= 0))
        def pick (new FlowInput)
        pick.x = ((ed.view.menuX()) + 20.0)
        pick.y = (((ed.view.menuY()) + (ed.view.menuRowTop(row))) + 8.0)
        ed.pointerDown(pick)
        c.near("picking it turned the node" n.rotation 90.0 0.001)
        c.ok("and closed the menu" ((ed.menuOpen()) == false))

        ; A press away from an open menu dismisses it and does nothing else.
        ed.openMenuAt(300.0 300.0)
        c.ok("the surface has its own menu" ((RangerFlowTest.menuRow(ed.view "Valitse kaikki")) >= 0))
        def away (new FlowInput)
        away.x = 30.0
        away.y = 620.0
        ed.pointerDown(away)
        c.ok("clicking away closes it" ((ed.menuOpen()) == false))
    }

    sfn menuRow:int (v:FlowView label:string) {
        def i:int 0
        while (i < (v.menu.count())) {
            def it:FlowMenuItem (v.menu.at(i))
            if (it.label == label) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; ---------------------------------------------------------------- pinch --
    sfn testPinch:void (c:Checker) {
        c.section("pinch to zoom")
        def g (new FlowGraph)
        g.node("a" "A" 0.0 0.0)
        g.reindex()
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(800.0 600.0)
        ed.view.viewport.zoom = 1.0
        ed.view.viewport.x = 0.0
        ed.view.viewport.y = 0.0
        def heldX:double (ed.flowX(400.0))
        def heldY:double (ed.flowY(300.0))
        ed.pinchBegin(340.0 300.0 460.0 300.0)
        ed.pinchTo(280.0 300.0 520.0 300.0)
        c.near("twice the span, twice the zoom" ed.view.viewport.zoom 2.0 0.0001)
        c.near("what was between the fingers stayed there, across" (ed.flowX(400.0)) heldX 0.0001)
        c.near("…and down" (ed.flowY(300.0)) heldY 0.0001)
        ; The fingers may travel while they spread.
        ed.pinchTo(380.0 340.0 620.0 340.0)
        c.near("it follows them across" (ed.flowX(500.0)) heldX 0.0001)
        c.near("and down" (ed.flowY(340.0)) heldY 0.0001)
        ; Closing past the floor clamps rather than inverting.
        ed.pinchTo(499.0 340.0 501.0 340.0)
        c.ok("a pinch shut clamps at minZoom" (ed.view.viewport.zoom >= ed.view.viewport.minZoom))
        ed.pinchEnd()
        c.ok("and the gesture ends" (ed.pinching == false))
    }

    ; ------------------------------------------------------------ traversal --
    sfn testTraversal:void (c:Checker) {
        c.section("walking the graph")
        def g (new FlowGraph)
        g.node("a" "A" 0.0 0.0)
        g.node("b" "B" 0.0 100.0)
        g.node("c" "C" 200.0 100.0)
        g.node("d" "D" 100.0 200.0)
        g.node("e" "E" 500.0 500.0)
        g.connect("a" "b")
        g.connect("a" "c")
        g.connect("b" "d")
        g.connect("c" "d")
        g.reindex()
        def a:FlowNode (g.nodeById("a"))
        def b:FlowNode (g.nodeById("b"))
        def d:FlowNode (g.nodeById("d"))
        def e:FlowNode (g.nodeById("e"))
        c.eqInt("a has two ways out" (array_length (g.successors(a.index))) 2)
        c.eqInt("and nothing into it" (array_length (g.predecessors(a.index))) 0)
        c.eqInt("d has two ways in" (array_length (g.predecessors(d.index))) 2)
        c.eqInt("and nothing out" (array_length (g.successors(d.index))) 0)
        c.eqInt("its neighbours are those two" (array_length (g.neighbours(d.index))) 2)
        def down:[int] (g.bfsFrom(a.index true false))
        c.eqInt("everything downstream of a" (array_length down) 4)
        c.eqInt("starting with a itself" (itemAt down 0) a.index)
        ; Breadth first takes both children before either grandchild; depth
        ; first takes the first child's child before the second child.
        c.eqInt("breadth first reaches c second or third" (itemAt down 1) b.index)
        c.eqInt("…and d last" (itemAt down 3) d.index)
        def deep:[int] (g.dfsFrom(a.index true false))
        c.eqInt("depth first goes down before across" (itemAt deep 1) b.index)
        c.eqInt("…so d comes before c" (itemAt deep 2) d.index)
        c.eqInt("e is alone in its component" (array_length (g.componentOf(e.index))) 1)
        c.eqInt("and the rest are together in theirs" (array_length (g.componentOf(a.index))) 4)
        ; A node reached twice is listed once.
        def both:[int] (g.bfsFrom(d.index false true))
        c.eqInt("everything that can reach d" (array_length both) 4)
    }

    ; -------------------------------------------------- the other routers ----
    sfn testExtraRouters:void (c:Checker) {
        c.section("curve, metro and one-side routers")
        ; A curve passes THROUGH the vertices it was given. A bezier handed
        ; the same points would sail past them, which is why the two are
        ; different families rather than a flag.
        def pts:[double]
        push pts 0.0
        push pts 0.0
        push pts 100.0
        push pts 80.0
        push pts 220.0
        push pts 40.0
        push pts 320.0
        push pts 140.0
        def curved:EdgePath (EdgeRouter.curveThrough(pts 1.0))
        def flat:[double] (curved.flatten(24))
        c.ok("through the second vertex" (RangerFlowTest.passesNear(flat 100.0 80.0 1.0)))
        c.ok("through the third" (RangerFlowTest.passesNear(flat 220.0 40.0 1.0)))
        c.ok("and it is a curve, not a polyline" (RangerFlowTest.hasCubic(curved)))

        ; A metro line is the orthogonal route with the corners cut, so it has
        ; diagonals in it and the route it was cut from does not.
        def stepped:EdgePath (EdgeRouter.step(0.0 0.0 2 300.0 200.0 0 20.0))
        def metro:EdgePath (EdgeRouter.metro(0.0 0.0 2 300.0 200.0 0 20.0 14.0))
        c.eqInt("no diagonals in the stepped route" (RangerFlowTest.diagonals((stepped.flatten(2)))) 0)
        c.ok("but there are in the metro one" ((RangerFlowTest.diagonals((metro.flatten(2)))) > 0)) 
        ; The chamfer may never eat a leg: both routes still start and end in
        ; the same place.
        def sf:[double] (stepped.flatten(2))
        def mf:[double] (metro.flatten(2))
        c.near("same start" (itemAt mf 0) (itemAt sf 0) 0.001)
        c.near("same end" (itemAt mf ((array_length mf) - 1)) (itemAt sf ((array_length sf) - 1)) 0.001)

        ; One side: out, along, and back, all on one face, clear of both ends.
        def one:[double] (EdgeRouter.oneSidePoints(70.0 25.0 70.0 265.0 1 30.0))
        c.eqInt("four corners" (idiv (array_length one) 2) 4)
        c.near("the run is at one x" (itemAt one 2) (itemAt one 4) 0.001)
        c.ok("clear of both ends" ((itemAt one 2) > 70.0))
        c.eqInt("the default face for a run to the right" (EdgeRouter.oneSideDefault(0.0 0.0 1 400.0 10.0 3)) 1)
        c.eqInt("and for one straight down" (EdgeRouter.oneSideDefault(0.0 0.0 2 10.0 400.0 0)) 2)
    }

    sfn passesNear:boolean (flat:[double] px:double py:double tol:double) {
        def i:int 0
        while (i < (array_length flat)) {
            def dx:double ((itemAt flat i) - px)
            def dy:double ((itemAt flat (i + 1)) - py)
            if ((sqrt ((dx * dx) + (dy * dy))) <= tol) {
                return true
            }
            i = (i + 2)
        }
        return false
    }

    sfn hasCubic:boolean (p:EdgePath) {
        def i:int 0
        while (i < (p.segCount())) {
            def seg:EdgeSeg (itemAt p.segs i)
            if (seg.kind == 2) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn diagonals:int (flat:[double]) {
        def hits:int 0
        def i:int 0
        while (i < ((array_length flat) - 3)) {
            def dx:double (fabs ((itemAt flat (i + 2)) - (itemAt flat i)))
            def dy:double (fabs ((itemAt flat (i + 3)) - (itemAt flat (i + 1))))
            if (dx > 0.1) {
                if (dy > 0.1) {
                    hits = (hits + 1)
                }
            }
            i = (i + 2)
        }
        return hits
    }

    ; ------------------------------------------------------------ viewport --
    sfn testViewport:void (c:Checker) {
        c.section("viewport")
        def vp (new FlowViewport)
        vp.x = 40.0
        vp.y = -20.0
        vp.zoom = 2.0
        c.near("toScreenX" (vp.toScreenX(10.0)) 60.0 0.001)
        c.near("toFlowX round trip" (vp.toFlowX((vp.toScreenX(37.5)))) 37.5 0.0001)
        ; Zooming about a point must leave the flow coordinate under it fixed.
        def beforeX:double (vp.toFlowX(300.0))
        def beforeY:double (vp.toFlowY(200.0))
        vp.zoomAt(300.0 200.0 1.35)
        c.near("zoom anchor x" (vp.toFlowX(300.0)) beforeX 0.0001)
        c.near("zoom anchor y" (vp.toFlowY(200.0)) beforeY 0.0001)
        vp.minZoom = 0.5
        vp.maxZoom = 1.5
        vp.zoomAt(0.0 0.0 100.0)
        c.near("zoom clamped" vp.zoom 1.5 0.0001)
        def r:FlowRect (FlowRect.create(0.0 0.0 200.0 100.0))
        def vp2 (new FlowViewport)
        vp2.fitRect(r 800.0 400.0 0.1)
        c.near("fitView centres x" (vp2.toScreenX(100.0)) 400.0 0.001)
        c.near("fitView centres y" (vp2.toScreenY(50.0)) 200.0 0.001)
        ; React Flow's own answer for these inputs, from `getViewportForBounds`
        ; — padding 0.1 means the content gets 1.1x its size, not 80% of the
        ; viewport, so the zoom is 3.64 and not 3.2. The parity harness
        ; measures the whole matrix; this pins the one case by hand so the
        ; convention cannot drift when the harness is not run.
        c.near("fitView matches getViewportForBounds" vp2.zoom 3.64 0.000001)
        c.near("fitView x matches" vp2.x 36.0 0.000001)
        c.near("fitView y matches" vp2.y 18.0 0.000001)
        def touching:FlowRect (FlowRect.create(0.0 0.0 100.0 100.0))
        def apart:FlowRect (FlowRect.create(100.0 0.0 100.0 100.0))
        c.near("touching rectangles share no area" (touching.overlapArea(apart)) 0.0 0.000001)
        def over:FlowRect (FlowRect.create(50.0 50.0 100.0 100.0))
        c.near("overlap area" (touching.overlapArea(over)) 2500.0 0.000001)
    }

    ; --------------------------------------------------------------- graph --
    sfn testGraph:void (c:Checker) {
        c.section("graph")
        def g (new FlowGraph)
        g.node("a" "A" 0.0 0.0)
        g.node("b" "B" 300.0 0.0)
        g.node("c" "C" 600.0 0.0)
        g.connect("a" "b")
        g.connect("b" "c")
        c.eqInt("nodes" (g.nodeCount()) 3)
        c.eqInt("edges" (g.edgeCount()) 2)
        c.eqInt("index of b" (g.indexOfNode("b")) 1)
        ; Removing a node takes its edges with it.
        g.removeNode("b")
        c.eqInt("nodes after remove" (g.nodeCount()) 2)
        c.eqInt("edges after remove" (g.edgeCount()) 0)
        c.eqInt("reindexed c" (g.indexOfNode("c")) 1)
        def r:FlowRect (g.bounds())
        c.near("bounds width" r.w 750.0 0.001)
        def hit:int (g.nodeAtPoint(10.0 10.0))
        c.eqInt("hit test" hit 0)
        c.eqInt("miss" (g.nodeAtPoint(-50.0 -50.0)) -1)
    }

    ; -------------------------------------------------------- compartments --
    sfn testCompartments:void (c:Checker) {
        c.section("compartments and ports")
        def n:FlowNode (FlowNode.create("t" "customers" 0.0 0.0))
        n.headerHeight = 30.0
        n.rowHeight = 20.0
        def sec:FlowSection (n.addSection(""))
        def r0:FlowRow (FlowRow.create("pk" "id" "INTEGER" ""))
        r0.portId = "customers.id"
        sec.addRow(r0)
        def r1:FlowRow (FlowRow.create("" "email" "VARCHAR" ""))
        r1.portId = "customers.email"
        sec.addRow(r1)
        n.layoutCompartments()
        c.near("height from content" n.height 70.0 0.001)
        c.near("row 0 centre" (n.rowCenterY(0 0)) 40.0 0.001)
        c.near("row 1 centre" (n.rowCenterY(0 1)) 60.0 0.001)
        c.eqInt("ports created" (array_length n.ports) 4)
        def pi:int (n.portIndex("customers.email:r"))
        c.ok("right port exists" (pi >= 0))
        def p:FlowPort (itemAt n.ports pi)
        c.near("port sits on the row" (n.portY(p)) 60.0 0.001)
        c.near("right port on right edge" (n.portX(p)) n.width 0.001)

        def g (new FlowGraph)
        g.addNode(n)
        def other:FlowNode (FlowNode.create("o" "orders" 400.0 0.0))
        def sec2:FlowSection (other.addSection(""))
        def r2:FlowRow (FlowRow.create("fk" "customer_id" "INTEGER" "FK"))
        r2.portId = "orders.customer_id"
        sec2.addRow(r2)
        other.layoutCompartments()
        g.addNode(other)
        g.reindex()
        c.ok("port owner resolves" ((g.portOwner("orders.customer_id:l")) == 1))
        c.ok("can connect" (g.canConnect("orders.customer_id:l" "customers.id:r")))
        c.ok("no self connect" ((g.canConnect("customers.id:r" "customers.id:r")) == false))
        def e:FlowEdge (FlowEdge.create("e1" "o" "t"))
        e.sourcePort = "orders.customer_id:l"
        e.targetPort = "customers.id:r"
        g.addEdge(e)
        c.ok("duplicate refused" ((g.canConnect("orders.customer_id:l" "customers.id:r")) == false))
        c.near("endpoint x is the port" (g.endpointX(e true)) 400.0 0.001)
        c.eqInt("endpoint side" (g.edgeSide(e true)) 3)
        ; A connection limit is enforced by the core, not by a callback.
        def lim:FlowPort (g.portRef("customers.id:r"))
        lim.connectionLimit = 1
        c.ok("limit reached" ((g.canConnect("orders.customer_id:r" "customers.id:r")) == false))
    }

    ; ---------------------------------------------------------- edge paths --
    sfn testEdgeRouter:void (c:Checker) {
        c.section("edge router")
        ; React Flow's getBezierPath: the control offset is half the distance
        ; when the target is ahead of the source.
        def p:EdgePath (EdgeRouter.bezier(150.0 20.0 1 400.0 220.0 3 0.25))
        c.eqStr("bezier d" (p.svgPath()) "M 150.00 20.00 C 275.00 20.00 275.00 220.00 400.00 220.00")
        ; …and grows with the square root when it is behind.
        def back:double (EdgeRouter.controlOffset(-100.0 0.25))
        c.near("control offset behind" back 62.5 0.001)
        c.near("control offset ahead" (EdgeRouter.controlOffset(100.0 0.25)) 50.0 0.001)
        p.flatten(16)
        c.eqInt("flattened points" (p.pointCount()) 17)
        c.ok("length is sane" ((p.totalLength()) > 300.0))
        c.near("distance to itself" (p.distanceTo((p.midX()) (p.midY()))) 0.0 0.001)
        c.ok("distance to far point" ((p.distanceTo(0.0 1000.0)) > 500.0))

        def st:EdgePath (EdgeRouter.step(0.0 0.0 1 200.0 100.0 3 20.0))
        st.flatten(1)
        c.ok("step is orthogonal" (RangerFlowTest.allAxisAligned(st)))

        ; A corner that does not turn must not be rounded.
        def ss:EdgePath (EdgeRouter.smoothStep(150.0 20.0 1 400.0 220.0 3 20.0 8.0))
        def d:string (ss.svgPath())
        c.eqInt("smoothstep quads" (RangerFlowTest.countOf(d "Q")) 2)
        def angle:double (ss.angleAtEnd())
        c.near("arrives horizontally" angle 0.0 0.001)
    }

    sfn allAxisAligned:boolean (p:EdgePath) {
        def n:int (p.pointCount())
        def i:int 1
        while (i < n) {
            def dx:double (fabs ((p.px(i)) - (p.px((i - 1)))))
            def dy:double (fabs ((p.py(i)) - (p.py((i - 1)))))
            if (dx > 0.01) {
                if (dy > 0.01) {
                    return false
                }
            }
            i = (i + 1)
        }
        return true
    }

    sfn countOf:int (s:string sub:string) {
        def n:int 0
        def i:int 0
        while (i < (strlen s)) {
            def ch:string (substring s i (i + 1))
            if (ch == sub) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; ---------------------------------------------------------- decoration --
    sfn testDecoration:void (c:Checker) {
        c.section("edge decoration")
        c.eqStr("crowfoot many" (EdgeDecoration.markerFor("crowfoot" "*" false)) "many")
        c.eqStr("crowfoot one" (EdgeDecoration.markerFor("crowfoot" "1" false)) "one-one")
        c.eqStr("crowfoot optional one" (EdgeDecoration.markerFor("crowfoot" "1" true)) "zero-one")
        c.eqStr("uml ignores cardinality" (EdgeDecoration.markerFor("uml" "*" false)) "arrow")
        c.eqStr("plain ignores cardinality" (EdgeDecoration.markerFor("plain" "*" false)) "arrowclosed")
        def many:EdgeDecoration (EdgeDecoration.build("many" 100.0 100.0 0.0 10.0))
        c.eqInt("fork plus stem" (many.shapeCount()) 2)
        def arrow:EdgeDecoration (EdgeDecoration.build("arrowclosed" 100.0 100.0 0.0 10.0))
        def sh:DecoShape (arrow.shapeAt(0))
        c.ok("closed arrow is filled" sh.filled)
        c.eqInt("triangle has 3 points" (array_length sh.pts) 6)
        c.eqInt("none draws nothing" ((EdgeDecoration.build("none" 0.0 0.0 0.0 8.0)).shapeCount()) 0)
    }

    ; ---------------------------------------------------------------- force --
    sfn testForce:void (c:Checker) {
        c.section("force layout")
        ; d3's LCG, so jitter is reproducible on every target.
        def rnd (new FlowRandom)
        c.near("d3 lcg first value" (rnd.next()) 0.23645552527159452 0.000000001)
        def second:double (rnd.next())
        c.ok("lcg stays in range" (second >= 0.0))
        c.ok("lcg stays in range 2" (second < 1.0))

        def g:FlowGraph (RangerFlowTest.star(12))
        def sim:FlowSimulation (FlowSimulation.reactFlowExample(g -1000.0 150.0))
        def ticks:int (sim.run(600))
        c.eqInt("d3 alpha schedule settles at 300" ticks 300)
        c.ok("alpha below min" (sim.alpha < sim.alphaMin))
        def hub:FlowNode (g.nodeById("n0"))
        def leaf:FlowNode (g.nodeById("n1"))
        def d:double (RangerFlowTest.dist(hub leaf))
        ; The spring wants 150; charge and the axis pull settle it near there.
        c.ok(("hub-leaf near link distance (got " + (to_string d) + ")") (d > 100.0))
        c.ok("hub-leaf not collapsed" (d < 260.0))
        def l2:FlowNode (g.nodeById("n2"))
        c.ok("leaves repel each other" ((RangerFlowTest.dist(leaf l2)) > 40.0))

        ; Same input, same output — twice, which is what makes it testable.
        def g2:FlowGraph (RangerFlowTest.star(12))
        def sim2:FlowSimulation (FlowSimulation.reactFlowExample(g2 -1000.0 150.0))
        sim2.run(600)
        def a:FlowNode (g2.nodeById("n1"))
        c.near("deterministic x" a.simX leaf.simX 0.000001)
        c.near("deterministic y" a.simY leaf.simY 0.000001)

        ; A pinned node does not move — the drag behaviour of the example.
        def g3:FlowGraph (RangerFlowTest.star(8))
        def sim3:FlowSimulation (FlowSimulation.reactFlowExample(g3 -1000.0 150.0))
        def pinned:FlowNode (g3.nodeById("n3"))
        pinned.pin(500.0 -400.0)
        sim3.run(300)
        c.near("pinned x" pinned.simX 500.0 0.000001)
        c.near("pinned y" pinned.simY -400.0 0.000001)

        ; Collision keeps boxes apart.
        def g4 (new FlowGraph)
        def i:int 0
        while (i < 6) {
            def nd:FlowNode (g4.node(("c" + (to_string i)) "x" 0.0 0.0))
            nd.width = 100.0
            nd.height = 40.0
            i = (i + 1)
        }
        def sim4:FlowSimulation (FlowSimulation.of(g4))
        sim4.chargeEnabled = false
        sim4.linkEnabled = false
        sim4.collideEnabled = true
        sim4.run(300)
        def worst:double (RangerFlowTest.closestPair(g4))
        c.ok(("collide separates (closest " + (to_string worst) + ")") (worst > 40.0))
    }

    sfn star:FlowGraph (n:int) {
        def g (new FlowGraph)
        def i:int 0
        while (i < n) {
            def nd:FlowNode (g.node(("n" + (to_string i)) ("N" + (to_string i)) 0.0 0.0))
            nd.width = 110.0
            nd.height = 40.0
            i = (i + 1)
        }
        def k:int 1
        while (k < n) {
            g.connect("n0" ("n" + (to_string k)))
            k = (k + 1)
        }
        return g
    }

    sfn dist:double (a:FlowNode b:FlowNode) {
        def dx:double (a.simX - b.simX)
        def dy:double (a.simY - b.simY)
        return (sqrt ((dx * dx) + (dy * dy)))
    }

    sfn closestPair:double (g:FlowGraph) {
        def best:double 1000000.0
        def i:int 0
        while (i < (g.nodeCount())) {
            def k:int (i + 1)
            while (k < (g.nodeCount())) {
                def d:double (RangerFlowTest.dist((g.nodeAt(i)) (g.nodeAt(k))))
                if (d < best) {
                    best = d
                }
                k = (k + 1)
            }
            i = (i + 1)
        }
        return best
    }

    ; ------------------------------------------------------------- layered --
    sfn testLayered:void (c:Checker) {
        c.section("layered layout")
        def g (new FlowGraph)
        g.node("users" "users" 0.0 0.0)
        g.node("orders" "orders" 0.0 0.0)
        g.node("profiles" "profiles" 0.0 0.0)
        g.node("items" "order_items" 0.0 0.0)
        g.node("products" "products" 0.0 0.0)
        g.connect("users" "orders")
        g.connect("users" "profiles")
        g.connect("orders" "items")
        g.connect("products" "items")
        def l:LayeredLayout (LayeredLayout.of(g))
        l.direction = "LR"
        l.run()
        c.eqInt("layers" (l.layerCount()) 3)
        c.eqInt("users at 0" (itemAt l.layerOf (g.indexOfNode("users"))) 0)
        c.eqInt("orders at 1" (itemAt l.layerOf (g.indexOfNode("orders"))) 1)
        c.eqInt("items at 2" (itemAt l.layerOf (g.indexOfNode("items"))) 2)
        def users:FlowNode (g.nodeById("users"))
        def items:FlowNode (g.nodeById("items"))
        c.ok("LR runs left to right" (items.x > users.x))
        c.eqInt("source side faces right" users.sourcePosition 1)

        ; A cycle must not hang the layer assignment.
        def cyc (new FlowGraph)
        cyc.node("a" "a" 0.0 0.0)
        cyc.node("b" "b" 0.0 0.0)
        cyc.node("c" "c" 0.0 0.0)
        cyc.connect("a" "b")
        cyc.connect("b" "c")
        cyc.connect("c" "a")
        def l2:LayeredLayout (LayeredLayout.of(cyc))
        l2.run()
        c.ok("cycle broken" ((l2.layerCount()) >= 2))
        c.ok("cycle terminated" ((l2.layerCount()) <= 3))
    }

    ; ---------------------------------------------------------- edge lanes --
    sfn testEdgeLanes:void (c:Checker) {
        c.section("edge lanes")
        ; Two foreign keys pointing at one primary key share a port, so they
        ; arrive at the same point and their approach runs are the same line
        ; drawn twice. The fan-out is what separates them.
        def g (new FlowGraph)
        def target:FlowNode (FlowNode.create("t" "customers" 600.0 200.0))
        target.rowHeight = 20.0
        def sec:FlowSection (target.addSection(""))
        def row:FlowRow (FlowRow.create("pk" "id" "INTEGER" ""))
        row.portId = "t.id"
        sec.addRow(row)
        target.layoutCompartments()
        g.addNode(target)
        def a:FlowNode (FlowNode.create("a" "orders" 0.0 100.0))
        def b:FlowNode (FlowNode.create("b" "payments" 0.0 400.0))
        g.addNode(a)
        g.addNode(b)
        g.reindex()
        def e1:FlowEdge (FlowEdge.create("e1" "a" "t"))
        e1.edgeType = "smoothstep"
        e1.targetPort = "t.id:l"
        g.addEdge(e1)
        def e2:FlowEdge (FlowEdge.create("e2" "b" "t"))
        e2.edgeType = "smoothstep"
        e2.targetPort = "t.id:l"
        g.addEdge(e2)
        def sameBefore:double (fabs ((g.endpointY(e1 false)) - (g.endpointY(e2 false))))
        c.near("two edges share one port" sameBefore 0.0 0.000001)
        EdgeLanes.assign(g)
        def apartAfter:double (fabs ((g.endpointY(e1 false)) - (g.endpointY(e2 false))))
        c.ok(("the fan separates them (got " + (to_string apartAfter) + ")") (apartAfter > 2.0))
        ; …but never further than the row they belong to, because the point of
        ; a field-level port is that the edge meets THAT column.
        c.ok("and keeps them inside the row" (apartAfter <= target.rowHeight))
        ; The one further down arrives lower: the fan does not cross itself.
        c.ok("the fan is ordered" ((g.endpointY(e2 false)) > (g.endpointY(e1 false))))

        ; Two trunks crossing one corridor get separate tracks.
        def g2 (new FlowGraph)
        def l1:FlowNode (g2.node("l1" "l1" 0.0 0.0))
        def l2:FlowNode (g2.node("l2" "l2" 0.0 200.0))
        def r1:FlowNode (g2.node("r1" "r1" 500.0 300.0))
        def r2:FlowNode (g2.node("r2" "r2" 500.0 500.0))
        def x1:FlowEdge (g2.connect("l1" "r1"))
        x1.edgeType = "smoothstep"
        def x2:FlowEdge (g2.connect("l2" "r2"))
        x2.edgeType = "smoothstep"
        EdgeLanes.assign(g2)
        def bothLanes:boolean false
        if x1.hasLaneX {
            if x2.hasLaneX { bothLanes = true }
        }
        c.ok("both trunks were given a track" bothLanes)
        def apart:double (fabs (x1.laneX - x2.laneX))
        c.ok(("the tracks are apart (got " + (to_string apart) + ")") (apart > 1.0))

        ; A bezier has nowhere to put a track, and must not be bent by one.
        def g3 (new FlowGraph)
        g3.node("p" "p" 0.0 0.0)
        g3.node("q" "q" 400.0 300.0)
        def curve:FlowEdge (g3.connect("p" "q"))
        curve.edgeType = "default"
        def before:EdgePath (EdgeRouter.route(g3 curve))
        def dBefore:string (before.svgPath())
        EdgeLanes.assign(g3)
        def after:EdgePath (EdgeRouter.route(g3 curve))
        c.eqStr("a bezier is left alone" (after.svgPath()) dBefore)

        ; …and the whole point, measured: nothing drawn on top of anything.
        def sqlOpt:string (?? (read_file "." "gallery/rangerflow/fixtures/ecommerce.sql") "")
        def schema:DatabaseSchema (SqlSchemaReader.parse(sqlOpt))
        def s2g (new SchemaToGraph)
        def gg:FlowGraph (s2g.build(schema))
        def lay:LayeredLayout (LayeredLayout.of(gg))
        lay.direction = "LR"
        lay.layerGap = 150.0
        lay.nodeGap = 40.0
        lay.run()
        SchemaToGraph.faceEdges(gg)
        def overlapBefore:int (EdgeOverlap.pairs(gg 2.0))
        c.ok(("the schema starts with overlaps (got " + (to_string overlapBefore) + ")") (overlapBefore > 0))
        EdgeLanes.assign(gg)
        def routed:int (lay.routeLongEdges())
        c.ok(("long edges were routed round the nodes (got " + (to_string routed) + ")") (routed > 0))
        def overlapAfter:int (EdgeOverlap.pairs(gg 2.0))
        c.eqInt("and ends with none" overlapAfter 0)
        ; A routed edge carries its corners, and they start and end on its own
        ; endpoints — a route that began somewhere else would draw a line from
        ; nowhere.
        def sample:FlowEdge (RangerFlowTest.firstRouted(gg))
        if ((array_length sample.waypoints) >= 4) {
            c.near("the route starts at the source port" (itemAt sample.waypoints 0) (gg.endpointX(sample true)) 0.001)
            def lastAt:int ((array_length sample.waypoints) - 2)
            c.near("and ends at the target port" (itemAt sample.waypoints lastAt) (gg.endpointX(sample false)) 0.001)
        }
    }

    ; The point of the dummy chains, on a graph built to need them: a→d spans
    ; four layers, and b and c stand in the way of the straight line.
    sfn testLongEdgeRouting:void (c:Checker) {
        c.section("long edge routing")
        def g (new FlowGraph)
        def a:FlowNode (g.node("a" "a" 0.0 0.0))
        def b:FlowNode (g.node("b" "b" 0.0 0.0))
        def cc:FlowNode (g.node("c" "c" 0.0 0.0))
        def d:FlowNode (g.node("d" "d" 0.0 0.0))
        def i:int 0
        while (i < 4) {
            def nd:FlowNode (g.nodeAt(i))
            nd.width = 140.0
            nd.height = 60.0
            i = (i + 1)
        }
        def e1:FlowEdge (g.connect("a" "b"))
        def e2:FlowEdge (g.connect("b" "c"))
        def e3:FlowEdge (g.connect("c" "d"))
        def long:FlowEdge (g.connect("a" "d"))
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            e.edgeType = "smoothstep"
            k = (k + 1)
        }
        ; First without the chains, which is what a plain layered layout does:
        ; the long edge is ordered against nothing, given no room, and drawn
        ; straight through b and c.
        def plain:LayeredLayout (LayeredLayout.of(g))
        plain.direction = "LR"
        plain.useDummies = false
        plain.run()
        c.eqInt("four layers" (plain.layerCount()) 4)
        def before:int (EdgeOverlap.nodeCrossings(g))
        c.ok(("without dummies the long edge cuts through what is in the way (got " + (to_string before) + ")") (before > 0))

        ; Then with them. The dummies take room in their layers, so the nodes
        ; move aside — the obstacle is gone before the routing runs, which is
        ; the whole of Sugiyama's trick — and the corners follow the lane they
        ; held open.
        EdgeLanes.reset(g)
        def lay:LayeredLayout (LayeredLayout.of(g))
        lay.direction = "LR"
        lay.run()
        ; The dummies move the nodes aside, but an edge that has not been told
        ; about its chain still turns at the midpoint and runs along its own
        ; row — placement is half the job and the routing is the other half.
        def afterPlacement:int (EdgeOverlap.nodeCrossings(g))
        def routed:int (lay.routeLongEdges())
        c.eqInt("one edge needed routing" routed 1)
        c.ok("and it carries its corners" ((array_length long.waypoints) >= 6))
        def after:int (EdgeOverlap.nodeCrossings(g))
        c.eqInt("and the routed edge goes round instead" after 0)
        c.ok(("routing is what clears it (" + (to_string before) + " → " + (to_string afterPlacement) + " → " + (to_string after) + ")") (after < afterPlacement))

        ; A short edge is left to the ordinary router.
        c.eqInt("adjacent-layer edges are not routed" (array_length e1.waypoints) 0)
    }

    ; The complaint this pass exists for: drag a node into the middle of
    ; somebody else's route and the line is drawn straight through it. The
    ; layered layout cannot help — it routed against a picture that no longer
    ; One router that sees every edge. A fan of three out of one side, a box
    ; standing in the corridor, and a label on every line: the rules in
    ; PLAN_READABLE_ROUTING each have a number, and this holds them.
    sfn testReadableRouter:void (c:Checker) {
        def g (new FlowGraph)
        def hub:FlowNode (g.node("hub" "hub" 0.0 400.0))
        def top:FlowNode (g.node("top" "top" 500.0 0.0))
        def mid:FlowNode (g.node("mid" "mid" 500.0 200.0))
        def low:FlowNode (g.node("low" "low" 500.0 410.0))
        def wall:FlowNode (g.node("wall" "in the way" 250.0 380.0))
        hub.width = 140.0
        hub.height = 80.0
        top.width = 140.0
        top.height = 60.0
        mid.width = 140.0
        mid.height = 60.0
        low.width = 140.0
        low.height = 60.0
        wall.width = 60.0
        wall.height = 100.0
        def e1:FlowEdge (g.connect("hub" "top"))
        def e2:FlowEdge (g.connect("hub" "mid"))
        def e3:FlowEdge (g.connect("hub" "low"))
        def e4:FlowEdge (g.connect("low" "hub"))
        e1.edgeType = "smoothstep"
        e2.edgeType = "smoothstep"
        e3.edgeType = "smoothstep"
        e4.edgeType = "smoothstep"
        e1.label = "UP"
        e2.label = "STRAIGHT ON"
        e3.label = "DOWN"
        e4.label = "BACK AGAIN"
        e4.sourceHandle = 2
        e4.targetHandle = 2
        g.reindex()
        c.section("readable router")

        def rr (new ReadableRouter)
        def routed:int (rr.route(g))
        c.eqInt("every edge was routed" routed 4)
        c.eqInt("nothing is drawn through the box in the corridor" (EdgeOverlap.nodeCrossings(g)) 0)
        c.eqInt("no route turns inside another box's clearance" (ReadableRouter.haloTurns(g rr.nodeClearance)) 0)
        c.eqInt("no two unrelated lines share a corridor" (ReadableRouter.parallelClose(g rr.minParallelGap)) 0)
        c.eqInt("every line leaves and arrives square to its side" (OrientedPorts.faults(g)) 0)
        c.eqInt("no crossing sits at another edge's bend" (ReadableRouter.crossingsAtBend(g rr.junctionRadius)) 0)

        ; Three edges out of one side, two of them heading up: two sockets,
        ; and two stubs of different lengths, so the lanes are distinct from
        ; the first pixel rather than converging two pixels out.
        def sx1:double (itemAt e1.waypoints 2)
        def sx2:double (itemAt e2.waypoints 2)
        c.ok("sibling sockets heading the same way turn at different distances" ((fabs (sx1 - sx2)) >= (rr.fanOutStep - 0.5)))
        c.ok("the one nearer that way turns first" (sx1 < sx2))
        c.ok("no socket is shared" (e1.portNudgeSource != e3.portNudgeSource))

        ; Labels: beside their own edge, on nothing, with no other line through.
        rr.placeLabels(g)
        rr.finish(g)
        c.eqInt("no label has another edge's line through it" (ReadableRouter.labelHits(g)) 0)
        def k:int 0
        def onABox:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            def p:EdgePath (EdgeRouter.route(g e))
            p.flatten(12)
            def w:double (ReadableRouter.labelBoxWidth(e.label))
            def h:double (ReadableRouter.labelBoxHeight(e.label))
            def box:FlowRect (FlowRect.create((((p.midX()) + e.labelDX) - (w * 0.5)) (((p.midY()) + e.labelDY) - (h * 0.5)) w h))
            def n:int 0
            while (n < (g.nodeCount())) {
                def nd:FlowNode (g.nodeAt(n))
                if (box.overlaps((nd.rect()))) {
                    onABox = (onABox + 1)
                }
                n = (n + 1)
            }
            k = (k + 1)
        }
        c.eqInt("no label sits on a box" onABox 0)

        ; The same graph twice is the same drawing.
        def before:[double] (OrthoRouter.copyOf(e3.waypoints))
        def rr2 (new ReadableRouter)
        rr2.route(g)
        rr2.placeLabels(g)
        rr2.finish(g)
        def same:boolean ((array_length before) == (array_length e3.waypoints))
        def i:int 0
        while (i < (array_length before)) {
            if (i < (array_length e3.waypoints)) {
                if ((fabs ((itemAt before i) - (itemAt e3.waypoints i))) > 0.01) {
                    same = false
                }
            }
            i = (i + 1)
        }
        c.ok("routing is deterministic" same)

        ; The half-way point of a path is half way by LENGTH, not the middle
        ; entry of a list whose size depends on how finely it was flattened.
        def p3:EdgePath (EdgeRouter.route(g e3))
        p3.flatten(4)
        def coarseX:double (p3.midX())
        def coarseY:double (p3.midY())
        p3.flatten(24)
        c.near("a label's anchor does not move with the flattening (x)" (p3.midX()) coarseX 1.5)
        c.near("a label's anchor does not move with the flattening (y)" (p3.midY()) coarseY 1.5)
    }

    ; exists — so the grid router repairs what is broken and leaves the rest.
    sfn testObstacleRepair:void (c:Checker) {
        def g (new FlowGraph)
        def a:FlowNode (g.node("a" "a" 0.0 0.0))
        def b:FlowNode (g.node("b" "b" 600.0 0.0))
        def blocker:FlowNode (g.node("blocker" "in the way" 0.0 400.0))
        a.width = 140.0
        a.height = 60.0
        b.width = 140.0
        b.height = 60.0
        blocker.width = 160.0
        blocker.height = 60.0
        def e:FlowEdge (g.connect("a" "b"))
        e.edgeType = "smoothstep"
        g.reindex()
        c.section("obstacle repair")
        c.eqInt("a clear run crosses nothing" (EdgeOverlap.nodeCrossings(g)) 0)

        ; Drag the third node onto the line.
        blocker.x = 280.0
        blocker.y = 0.0
        blocker.syncFromModel()
        def broken:int (EdgeOverlap.nodeCrossings(g))
        c.ok(("dropping a node on the route breaks it (got " + (to_string broken) + ")") (broken > 0))

        def fixed:int (OrthoRouter.repairAll(g))
        c.eqInt("one edge was repaired" fixed 1)
        c.eqInt("and nothing is drawn through a node any more" (EdgeOverlap.nodeCrossings(g)) 0)
        c.ok("the repair left corners behind" ((array_length e.waypoints) >= 6))

        ; A route that is already clear is left exactly as it was — the repair
        ; pass must not rewrite the whole diagram to fix one line.
        def before:int (array_length e.waypoints)
        def again:int (OrthoRouter.repairAll(g))
        c.eqInt("a second pass finds nothing to do" again 0)
        c.eqInt("and changes nothing" (array_length e.waypoints) before)

        ; A long obstacle is a detour, not a wall: the router should go round
        ; it rather than give up, and the route should be visibly longer than
        ; the straight line it replaced.
        def g2 (new FlowGraph)
        def s:FlowNode (g2.node("s" "s" 0.0 0.0))
        def t:FlowNode (g2.node("t" "t" 400.0 0.0))
        s.width = 100.0
        s.height = 60.0
        t.width = 100.0
        t.height = 60.0
        def wall:FlowNode (g2.node("wall" "wall" 150.0 -400.0))
        wall.width = 100.0
        wall.height = 800.0
        def e2:FlowEdge (g2.connect("s" "t"))
        e2.edgeType = "smoothstep"
        g2.reindex()
        def detoured:int (OrthoRouter.repairAll(g2))
        c.eqInt("a long obstacle is gone round, not given up on" detoured 1)
        c.eqInt("and the route is clear" (EdgeOverlap.nodeCrossings(g2)) 0)
        def p2:EdgePath (EdgeRouter.route(g2 e2))
        p2.flatten(2)
        c.ok(("the detour is long (got " + (to_string (p2.totalLength())) + ")") ((p2.totalLength()) > 700.0))

        ; Enclosed on all four sides there is genuinely nowhere to go, and the
        ; edge is left exactly as it was rather than mangled into something.
        def g3 (new FlowGraph)
        def inner:FlowNode (g3.node("inner" "inner" 0.0 0.0))
        inner.width = 80.0
        inner.height = 40.0
        def far:FlowNode (g3.node("far" "far" 900.0 0.0))
        far.width = 80.0
        far.height = 40.0
        def top:FlowNode (g3.node("top" "" -200.0 -200.0))
        top.width = 500.0
        top.height = 100.0
        def bottom:FlowNode (g3.node("bottom" "" -200.0 120.0))
        bottom.width = 500.0
        bottom.height = 100.0
        def left:FlowNode (g3.node("left" "" -200.0 -200.0))
        left.width = 100.0
        left.height = 420.0
        def right:FlowNode (g3.node("right" "" 220.0 -200.0))
        right.width = 100.0
        right.height = 420.0
        def e3:FlowEdge (g3.connect("inner" "far"))
        e3.edgeType = "smoothstep"
        g3.reindex()
        def hopeless:int (OrthoRouter.repairAll(g3))
        c.eqInt("an enclosed edge is left alone rather than mangled" hopeless 0)
        c.eqInt("with no waypoints invented" (array_length e3.waypoints) 0)
    }

    ; A route the router produced is a suggestion, not a verdict: the reader
    ; can take hold of any interior segment and slide it across. What must
    ; survive that is orthogonality (a segment moves across itself, never
    ; along), the endpoints (the edge still meets its ports), and undo.
    sfn testSegmentDrag:void (c:Checker) {
        c.section("dragging an edge segment")
        def g (new FlowGraph)
        def a:FlowNode (g.node("a" "A" 0.0 0.0))
        def b:FlowNode (g.node("b" "B" 420.0 220.0))
        a.width = 150.0
        a.height = 50.0
        b.width = 150.0
        b.height = 50.0
        def e:FlowEdge (g.connect("a" "b"))
        e.edgeType = "smoothstep"
        g.reindex()
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(1200.0 800.0)
        ed.view.showControls = false
        ed.view.showMinimap = false

        def corners:[double] (EdgeRouter.cornersFor(g e))
        def n:int (idiv (array_length corners) 2)
        c.ok(("a step route has interior corners (got " + (to_string n) + ")") (n >= 4))
        def startX:double (itemAt corners 0)
        def startY:double (itemAt corners 1)
        def endX:double (itemAt corners ((n - 1) * 2))
        def endYAt:int (((n - 1) * 2) + 1)
        def endY:double (itemAt corners endYAt)
        def ax:double (itemAt corners 2)
        def ay:double (itemAt corners 3)
        def bx:double (itemAt corners 4)
        def by:double (itemAt corners 5)
        def mx:double ((ax + bx) * 0.5)
        def my:double ((ay + by) * 0.5)
        def vertical:boolean ((fabs (bx - ax)) < (fabs (by - ay)))
        c.ok("the interior segment is grabbable in its middle" ((ed.segmentAt(mx my)) >= 0))
        c.eqInt("but the empty pane next to it is not" (ed.segmentAt((mx + 60.0) (my + 60.0))) -1)

        ; A click that does not move must leave the route to the router.
        def inp (new FlowInput)
        inp.x = mx
        inp.y = my
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        c.ok("a click selects the edge" e.selected)
        c.eqInt("and invents no corners of its own" (array_length e.waypoints) 0)
        c.ok("and leaves it routed automatically" (e.pinnedRoute == false))

        ; Now the same grab, but moved.
        inp.x = mx
        inp.y = my
        ed.pointerDown(inp)
        c.eqInt("pressing on a segment starts a segment drag" ed.mode 6)
        inp.x = (mx + 45.0)
        inp.y = (my + 45.0)
        ed.pointerMove(inp)
        ed.pointerUp(inp)
        c.eqInt("and releasing ends it" ed.mode 0)
        c.ok("the edge now carries its own corners" ((array_length e.waypoints) >= 8))
        c.ok("and refuses to be re-routed over" e.pinnedRoute)

        def held:[double] e.waypoints
        def hn:int (idiv (array_length held) 2)
        def hax:double (itemAt held 2)
        def hay:double (itemAt held 3)
        def hbx:double (itemAt held 4)
        def hbyAt:int 5
        def hby:double (itemAt held hbyAt)
        if vertical {
            c.near("a vertical run follows the pointer sideways" hax (mx + 45.0) 0.001)
            c.near("both of its ends, so it stays vertical" hbx (mx + 45.0) 0.001)
            c.near("and it does not slide along itself" hay ay 0.001)
            c.near("at either end" hby by 0.001)
        } {
            c.near("a horizontal run follows the pointer up and down" hay (my + 45.0) 0.001)
            c.near("both of its ends, so it stays horizontal" hby (my + 45.0) 0.001)
            c.near("and it does not slide along itself" hax ax 0.001)
            c.near("at either end" hbx bx 0.001)
        }
        def lastX:double (itemAt held ((hn - 1) * 2))
        def lastYAt:int (((hn - 1) * 2) + 1)
        def lastY:double (itemAt held lastYAt)
        c.near("the edge still leaves its source port" (itemAt held 0) startX 0.001)
        c.near("at the same height" (itemAt held 1) startY 0.001)
        c.near("and still meets its target port" lastX endX 0.001)
        c.near("at the same height" lastY endY 0.001)

        ; Every corner pair is still axis-aligned: nothing went diagonal.
        def diagonals:int 0
        def i:int 0
        while (i < (hn - 1)) {
            def px:double (itemAt held (i * 2))
            def pyAt:int ((i * 2) + 1)
            def py:double (itemAt held pyAt)
            def qx:double (itemAt held ((i + 1) * 2))
            def qyAt:int (((i + 1) * 2) + 1)
            def qy:double (itemAt held qyAt)
            def offX:double (fabs (qx - px))
            def offY:double (fabs (qy - py))
            if (offX > 0.001) {
                if (offY > 0.001) {
                    diagonals = (diagonals + 1)
                }
            }
            i = (i + 1)
        }
        c.eqInt("and the route is still orthogonal end to end" diagonals 0)

        ; Undo puts the routing back in the router's hands; redo takes it away
        ; again. An edge with no corners of its own must not stay pinned, or it
        ; would sit out every future repair pass.
        c.ok("the drag is undoable" (ed.undo.undo(g)))
        c.eqInt("undo drops the hand-placed corners" (array_length e.waypoints) 0)
        c.ok("and hands the edge back to the router" (e.pinnedRoute == false))
        c.ok("redo is offered" (ed.undo.redo(g)))
        c.ok("and puts the corners back" ((array_length e.waypoints) >= 8))
        c.ok("pinned again" e.pinnedRoute)

        ; A pinned route is exactly what the drawing uses — not a hint the
        ; router is free to overrule.
        def path:EdgePath (EdgeRouter.route(g e))
        path.flatten(1)
        c.ok("the drawn path follows the corners the pointer left" ((path.totalLength()) > 0.0))
        def repaired:int (OrthoRouter.repairAll(g))
        c.eqInt("and a repair pass keeps its hands off it" repaired 0)
        c.ok("leaving the corners as dragged" ((array_length e.waypoints) >= 8))

        ; The first and last runs touch a port, so they cannot simply slide —
        ; sliding one would take the end off the column it points at. They are
        ; still on offer, because on a route that leaves a node downwards and
        ; turns once they are the ONLY vertical runs, and refusing them left
        ; such an edge movable up and down but never left and right. Grabbing
        ; one splits it: a stub stays on the port, and the rest travels.
        def sx0:double (startX + (((itemAt corners 2) - startX) * 0.75))
        def sy0:double (startY + (((itemAt corners 3) - startY) * 0.75))
        def g2 (new FlowGraph)
        def a2:FlowNode (g2.node("a" "A" 0.0 0.0))
        def b2:FlowNode (g2.node("b" "B" 420.0 220.0))
        a2.width = 150.0
        a2.height = 50.0
        b2.width = 150.0
        b2.height = 50.0
        def e2:FlowEdge (g2.connect("a" "b"))
        e2.edgeType = "smoothstep"
        g2.reindex()
        def ed2:FlowEditor (FlowEditor.of(g2))
        ed2.setSize(1200.0 800.0)
        def stub:int (ed2.segmentAt(sx0 sy0))
        c.ok("the run that leaves the port is grabbable too" (stub >= 0))
        c.eqInt("and it is the first run of the route" (stub % 1000) 0)

        def endX2:double (g2.endpointX(e2 true))
        def endY2:double (g2.endpointY(e2 true))
        def farX2:double (g2.endpointX(e2 false))
        def farY2:double (g2.endpointY(e2 false))
        def inp2 (new FlowInput)
        inp2.x = sx0
        inp2.y = sy0
        ed2.pointerDown(inp2)
        c.eqInt("pressing on it starts a segment drag" ed2.mode 6)
        inp2.x = (sx0 + 40.0)
        inp2.y = (sy0 + 40.0)
        ed2.pointerMove(inp2)
        ed2.pointerUp(inp2)
        def held2:[double] e2.waypoints
        def h2n:int (idiv (array_length held2) 2)
        c.ok("the split gives the route corners of its own" (h2n >= 5))
        ; The split put a stub corner in, so the run that travelled is the
        ; THIRD point of the route and the one after it.
        def moved2:double (itemAt held2 5)
        if (ed2.segVertical) {
            moved2 = (itemAt held2 4)
        }
        def wanted2:double (sy0 + 40.0)
        if (ed2.segVertical) {
            wanted2 = (sx0 + 40.0)
        }
        c.near("and the run followed the pointer across itself" moved2 wanted2 0.001)
        c.near("the end stayed on its port" (itemAt held2 0) endX2 0.001)
        c.near("at the same height" (itemAt held2 1) endY2 0.001)
        def lastX2:double (itemAt held2 ((h2n - 1) * 2))
        def lastY2At:int (((h2n - 1) * 2) + 1)
        def lastY2:double (itemAt held2 lastY2At)
        c.near("and the far end never moved" lastX2 farX2 0.001)
        c.near("at all" lastY2 farY2 0.001)
        def diag2:int 0
        def j:int 0
        while (j < (h2n - 1)) {
            def jx:double (itemAt held2 (j * 2))
            def jyAt:int ((j * 2) + 1)
            def jy:double (itemAt held2 jyAt)
            def kx:double (itemAt held2 ((j + 1) * 2))
            def kyAt:int (((j + 1) * 2) + 1)
            def ky:double (itemAt held2 kyAt)
            def offX2:double (fabs (kx - jx))
            def offY2:double (fabs (ky - jy))
            if (offX2 > 0.001) {
                if (offY2 > 0.001) {
                    diag2 = (diag2 + 1)
                }
            }
            j = (j + 1)
        }
        c.eqInt("the split route is orthogonal end to end" diag2 0)
        c.ok("and it is undoable like any other reroute" (ed2.undo.undo(g2)))
        c.eqInt("which hands the edge back to the router" (array_length e2.waypoints) 0)

        ; The last few pixels belong to the end grip: a press there means
        ; "take this end somewhere else", not "bend the line".
        def nearEnd:int (ed2.segmentAt(endX2 endY2))
        c.eqInt("the very end of the line is not a segment grab" nearEnd -1)

        ; A bezier has no segments to slide: its shape is a function of its
        ; ends, so offering a handle in the middle would be a lie.
        e2.edgeType = "bezier"
        c.eqInt("and a curve offers no segments at all" (ed2.segmentAt(mx my)) -1)
    }

    ; Three edges converging on one table from a row above. Each one goes
    ; down, across, and down again, and the order the three tracks are laid out
    ; in decides whether they cross: the edge that reaches furthest has to turn
    ; LAST, or its long run passes through a neighbour that is still coming
    ; down. Ordering by span — the obvious guess — gets this exactly backwards.
    sfn testLaneOrdering:void (c:Checker) {
        c.section("the order of the tracks in a corridor")
        def g (new FlowGraph)
        def a:FlowNode (g.node("a" "A" 0.0 0.0))
        def b:FlowNode (g.node("b" "B" 300.0 0.0))
        def d:FlowNode (g.node("d" "D" 600.0 0.0))
        def t:FlowNode (g.node("t" "T" 800.0 400.0))
        a.width = 200.0
        a.height = 90.0
        b.width = 200.0
        b.height = 90.0
        d.width = 200.0
        d.height = 90.0
        t.width = 260.0
        t.height = 90.0
        def e0:FlowEdge (g.connect("a" "t"))
        def e1:FlowEdge (g.connect("b" "t"))
        def e2:FlowEdge (g.connect("d" "t"))
        e0.edgeType = "smoothstep"
        e1.edgeType = "smoothstep"
        e2.edgeType = "smoothstep"
        a.sourcePosition = 2
        b.sourcePosition = 2
        d.sourcePosition = 2
        t.targetPosition = 0
        g.reindex()
        EdgeLanes.assign(g)
        c.eqInt("three edges converging on one table do not cross each other" (EdgeOverlap.edgeCrossings(g)) 0)
        c.eqInt("nor are any two of them drawn as one line" (EdgeOverlap.pairs(g 2.0)) 0)

        ; The one that reaches furthest turns last — that is the whole rule,
        ; and it is the opposite of the order the spans are in.
        c.ok("every track got a lane" (e0.hasLaneY && (e1.hasLaneY && e2.hasLaneY)))
        c.ok(("A reaches furthest, so it turns below B (A " + (to_string e0.laneY) + " vs B " + (to_string e1.laneY) + ")") (e0.laneY > e1.laneY))
        c.ok("and below D as well" (e0.laneY > e2.laneY))
    }

    ; "When you drag a box the lines don't always go round the other boxes."
    ; The answer to that is not one screenshot: it is every node dropped
    ; everywhere, re-routed the way the browser re-routes on pointer-up, and a
    ; count of the drops that leave a line drawn through a table. The demo runs
    ; the same sweep at a finer step over the real fixtures
    ; (`npm run rangerflow:drag`); this is the small version that guards it.
    sfn testDragSweep:void (c:Checker) {
        c.section("dragging a node past the routes")
        def g (new FlowGraph)
        def cols:int 0
        while (cols < 3) {
            def rows:int 0
            while (rows < 2) {
                def id:string (("n" + (to_string cols)) + (to_string rows))
                def n:FlowNode (g.node(id id ((to_double cols) * 260.0) ((to_double rows) * 200.0)))
                n.width = 150.0
                n.height = 90.0
                rows = (rows + 1)
            }
            cols = (cols + 1)
        }
        def e0:FlowEdge (g.connect("n00" "n20"))
        def e1:FlowEdge (g.connect("n01" "n21"))
        def e2:FlowEdge (g.connect("n00" "n21"))
        e0.edgeType = "smoothstep"
        e1.edgeType = "smoothstep"
        e2.edgeType = "smoothstep"
        g.reindex()
        EdgeLanes.assign(g)
        OrthoRouter.repairAll(g)

        def mover:FlowNode (g.nodeById("n10"))
        def homeX:double mover.x
        def homeY:double mover.y
        def drops:int 0
        def dirty:int 0
        def gy:double -150.0
        while (gy < 360.0) {
            def gx:double -150.0
            while (gx < 660.0) {
                mover.x = gx
                mover.y = gy
                mover.syncFromModel()
                if ((RangerFlowTest.clearOfOthers(g "n10")) == false) {
                    gx = (gx + 70.0)
                    continue
                }
                EdgeLanes.reset(g)
                EdgeLanes.assign(g)
                OrthoRouter.repairAll(g)
                drops = (drops + 1)
                if ((EdgeOverlap.nodeCrossings(g)) > 0) {
                    dirty = (dirty + 1)
                }
                gx = (gx + 45.0)
            }
            gy = (gy + 45.0)
        }
        mover.x = homeX
        mover.y = homeY
        mover.syncFromModel()
        c.ok(("the sweep actually dropped the node somewhere (got " + (to_string drops) + ")") (drops > 60))
        c.eqInt(("no drop leaves a line drawn through a box (got " + (to_string dirty) + " of " + (to_string drops) + ")") dirty 0)
    }

    sfn clearOfOthers:boolean (g:FlowGraph id:string) {
        def me:FlowNode (g.nodeById(id))
        def a:FlowRect (me.rect())
        def k:int 0
        while (k < (g.nodeCount())) {
            def other:FlowNode (g.nodeAt(k))
            if (other.id != id) {
                def b:FlowRect (other.rect())
                if ((a.overlapArea(b)) > 0.0) {
                    return false
                }
            }
            k = (k + 1)
        }
        return true
    }

    sfn firstRouted:FlowEdge (g:FlowGraph) {
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            if ((array_length e.waypoints) >= 4) {
                return e
            }
            k = (k + 1)
        }
        return (new FlowEdge)
    }

    ; --------------------------------------------------------------- shapes --
    ; A diamond is a decision and a rectangle is a step, and the difference has
    ; to survive all the way to the pointer: the corner beside a diamond looks
    ; like empty canvas, so it has to behave like empty canvas.
    sfn testShapes:void (c:Checker) {
        c.section("node shapes")
        def ring:[double] (FlowShapes.outline("diamond" 0.0 0.0 100.0 60.0))
        c.eqInt("a diamond is four points" (idiv (array_length ring) 2) 4)
        c.ok("its middle is inside" (FlowShapes.holds(ring 50.0 30.0)))
        c.ok("its top-left corner is not" ((FlowShapes.holds(ring 4.0 4.0)) == false))
        c.ok("nor its bottom-right" ((FlowShapes.holds(ring 96.0 56.0)) == false))
        c.ok("but the point just inside the left vertex is" (FlowShapes.holds(ring 3.0 30.0)))

        ; Every shape has to enclose its own centre and stay inside the box it
        ; was given — a shape that leaks past its bounds would be drawn over
        ; its neighbours and culled at the wrong moment.
        def names:[string]
        push names "rect"
        push names "stadium"
        push names "diamond"
        push names "parallelogram"
        push names "trapezoid"
        push names "hexagon"
        push names "cylinder"
        push names "document"
        push names "ellipse"
        push names "circle"
        def leaks:int 0
        def hollow:int 0
        def i:int 0
        while (i < (array_length names)) {
            def name:string (itemAt names i)
            def pts:[double] (FlowShapes.outline(name 10.0 20.0 140.0 80.0))
            if ((idiv (array_length pts) 2) < 3) {
                hollow = (hollow + 1)
            }
            if ((FlowShapes.holds(pts 80.0 60.0)) == false) {
                hollow = (hollow + 1)
            }
            def k:int 0
            while (k < (idiv (array_length pts) 2)) {
                def px:double (itemAt pts (k * 2))
                def pyAt:int ((k * 2) + 1)
                def py:double (itemAt pts pyAt)
                if (px < 9.99)  { leaks = (leaks + 1) }
                if (px > 150.01) { leaks = (leaks + 1) }
                if (py < 19.99) { leaks = (leaks + 1) }
                if (py > 100.01) { leaks = (leaks + 1) }
                k = (k + 1)
            }
            i = (i + 1)
        }
        c.eqInt("no shape leaves its own bounding box" leaks 0)
        c.eqInt("and every one of them encloses its centre" hollow 0)

        ; The handles have to land ON the shape. A parallelogram's left side
        ; leans, so the middle of that side is not the left edge of the box.
        def slant:double (FlowShapes.slantOf(140.0 80.0))
        c.near("a parallelogram's left handle follows the lean" (FlowShapes.anchorX("parallelogram" 10.0 20.0 140.0 80.0 3)) (10.0 + (slant * 0.5)) 0.001)
        c.near("a rectangle's does not" (FlowShapes.anchorX("rect" 10.0 20.0 140.0 80.0 3)) 10.0 0.001)
        c.near("a diamond's left handle is its vertex" (FlowShapes.anchorX("diamond" 10.0 20.0 140.0 80.0 3)) 10.0 0.001)
        c.near("and that vertex is at the middle height" (FlowShapes.anchorY("diamond" 10.0 20.0 140.0 80.0 3)) 60.0 0.001)
        def wave:double (FlowShapes.waveDepth(80.0))
        c.near("a document's bottom handle sits on the paper, not below it" (FlowShapes.anchorY("document" 10.0 20.0 140.0 80.0 2)) (100.0 - wave) 0.001)

        ; …and the editor has to agree with the drawing.
        def g (new FlowGraph)
        def d:FlowNode (g.node("d" "Ehto?" 0.0 0.0))
        d.width = 120.0
        d.height = 80.0
        d.shape = (FlowShape.diamond())
        g.reindex()
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(800.0 600.0)
        ed.view.showControls = false
        ed.view.showMinimap = false
        def inp (new FlowInput)
        inp.x = 6.0
        inp.y = 6.0
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        c.ok("clicking the corner beside a diamond selects nothing" (d.selected == false))
        inp.x = 60.0
        inp.y = 40.0
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        c.ok("clicking its middle selects it" d.selected)
    }

    ; ------------------------------------------------------------ flowchart --
    sfn testFlowchart:void (c:Checker) {
        c.section("ATK flowchart")
        def f (new Flowchart)
        f.start("alku" "Alku")
        f.step("lue" "Lue tilaus" (FlowKind.io()))
        f.step("ehto" "Luotto ok?" (FlowKind.decision()))
        f.step("ok" "Varaa" (FlowKind.process()))
        f.step("ei" "Hylkää" (FlowKind.manual()))
        f.step("rekisteri" "Asiakasrekisteri" (FlowKind.database()))
        f.step("loppu" "Loppu" (FlowKind.terminator()))
        f.link("alku" "lue")
        f.link("lue" "ehto")
        f.link("rekisteri" "ehto")
        f.branch("ehto" "ok" "kyllä")
        f.branch("ehto" "ei" "ei")
        f.link("ok" "loppu")
        f.link("ei" "loppu")
        def g:FlowGraph (f.build())
        c.eqInt("every step became a node" (g.nodeCount()) 7)
        c.eqInt("and every link an edge" (g.edgeCount()) 7)
        def ehto:FlowNode (g.nodeById("ehto"))
        c.eqStr("a decision is a diamond" ehto.shape "diamond")
        def lue:FlowNode (g.nodeById("lue"))
        c.eqStr("input is a parallelogram" lue.shape "parallelogram")
        def reg:FlowNode (g.nodeById("rekisteri"))
        c.eqStr("stored data is a drum" reg.shape "cylinder")
        def alku:FlowNode (g.nodeById("alku"))
        c.eqStr("a terminator is a stadium" alku.shape "stadium")
        ; The branch labels are the whole of what makes a decision readable.
        def labelled:int 0
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            if ((strlen e.label) > 0) {
                labelled = (labelled + 1)
            }
            k = (k + 1)
        }
        c.eqInt("both ways out of the decision are labelled" labelled 2)

        def lay:LayeredLayout (LayeredLayout.of(g))
        lay.direction = "TB"
        lay.layerGap = 70.0
        lay.nodeGap = 46.0
        lay.run()
        Flowchart.faceEdges(g)
        EdgeLanes.assign(g)
        lay.routeLongEdges()
        EdgeLanes.assign(g)
        OrthoRouter.repairAll(g)
        c.eqInt("nothing is drawn through a step" (EdgeOverlap.nodeCrossings(g)) 0)
        c.eqInt("and no two links are drawn as one line" (EdgeOverlap.pairs(g 2.0)) 0)
        ; A decision is above what it branches to, which is the one thing a
        ; reader relies on when the labels are too small to read.
        def okNode:FlowNode (g.nodeById("ok"))
        c.ok("the decision sits above the branch it leads to" ((ehto.centerY()) < (okNode.centerY())))
    }

    ; -------------------------------------------------------------- mermaid --
    ; The reader, asserted against the diagram somebody would actually paste
    ; in: every shape, every link, both label forms, a subgraph, a class and a
    ; comment.
    sfn testMermaid:void (c:Checker) {
        c.section("Mermaid reader")
        def src:string "%% a comment\n"
        src = (src + "flowchart TD\n")
        src = (src + "    A([Start]) --> B[/Read/]\n")
        src = (src + "    B --> C{Ok?}\n")
        src = (src + "    C -->|yes| D[[Invoice]]\n")
        src = (src + "    C -- no --> E[\\Reject\\]\n")
        src = (src + "    D --> F[(Orders)] ; F -.-> G((Done))\n")
        src = (src + "    E ==> G\n")
        src = (src + "    H{{Prepare}} --o I>Report]\n")
        def d:MermaidDiagram (MermaidReader.parse(src))
        c.eqStr("the header gives the direction" d.direction "TD")
        c.eqInt("every node named is a node" (d.nodeCount()) 9)
        c.eqInt("and every link a link" (d.linkCount()) 8)

        def g:FlowGraph (d.build())
        def a:FlowNode (g.nodeById("A"))
        c.eqStr("([]) is a stadium" a.shape "stadium")
        c.eqStr("and the label is what was in the brackets" a.label "Start")
        def b:FlowNode (g.nodeById("B"))
        c.eqStr("[//] is a parallelogram" b.shape "parallelogram")
        def cc:FlowNode (g.nodeById("C"))
        c.eqStr("{} is a diamond" cc.shape "diamond")
        def dd:FlowNode (g.nodeById("D"))
        c.eqStr("[[]] is a subroutine box" dd.shape "predefined")
        def ee:FlowNode (g.nodeById("E"))
        c.eqStr("[\\] is a polygon, mirrored" ee.shape "polygon")
        def ff:FlowNode (g.nodeById("F"))
        c.eqStr("[()] is a drum" ff.shape "cylinder")
        def gg:FlowNode (g.nodeById("G"))
        c.eqStr("(()) is a circle" gg.shape "circle")
        c.near("and a circle is round" gg.width gg.height 0.001)
        def hh:FlowNode (g.nodeById("H"))
        c.eqStr("{{}} is a hexagon" hh.shape "hexagon")
        def ii:FlowNode (g.nodeById("I"))
        c.eqStr(">] is the notched box" ii.shape "receivesignal")

        ; The links: both label forms, and the four strokes.
        def yes:FlowEdge (RangerFlowTest.edgeBetween(g "C" "D"))
        c.eqStr("|text| labels the link" yes.label "yes")
        def no:FlowEdge (RangerFlowTest.edgeBetween(g "C" "E"))
        c.eqStr("-- text --> labels it too" no.label "no")
        def dotted:FlowEdge (RangerFlowTest.edgeBetween(g "F" "G"))
        c.ok("-.-> is drawn dashed" (dotted.dash > 0.0))
        def thick:FlowEdge (RangerFlowTest.edgeBetween(g "E" "G"))
        c.ok("==> is drawn thick" (thick.strokeWidth > 1.0))
        def circle:FlowEdge (RangerFlowTest.edgeBetween(g "H" "I"))
        c.eqStr("--o ends in a circle" circle.markerEnd "circle")
        def plain:FlowEdge (RangerFlowTest.edgeBetween(g "A" "B"))
        c.eqStr("--> ends in an arrow" plain.markerEnd "arrowclosed")
    }

    sfn edgeBetween:FlowEdge (g:FlowGraph source:string target:string) {
        def i:int 0
        while (i < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(i))
            if (e.source == source) {
                if (e.target == target) {
                    return e
                }
            }
            i = (i + 1)
        }
        return (new FlowEdge)
    }

    ; The rest of the dialect, and what the layout does with it.
    sfn testMermaidLayout:void (c:Checker) {
        c.section("Mermaid layout, subgraphs and styles")
        ; Chains, fan-out, the open and bidirectional links, and a `---`
        ; front matter title.
        def src:string "---\ntitle: A chart\n---\nflowchart LR\n"
        src = (src + "    A --> B --> C\n")
        src = (src + "    D & E --> F\n")
        src = (src + "    G --- H\n")
        src = (src + "    I <--> J\n")
        def d:MermaidDiagram (MermaidReader.parse(src))
        c.eqStr("the front matter carries the title" d.title "A chart")
        c.eqStr("and the header the direction" d.direction "LR")
        c.eqInt("a chain is two links, a fan-out two more" (d.linkCount()) 6)
        def g:FlowGraph (MermaidFlow.build(d))
        def open:FlowEdge (RangerFlowTest.edgeBetween(g "G" "H"))
        c.eqStr("--- has no arrow at all" open.markerEnd "")
        def both:FlowEdge (RangerFlowTest.edgeBetween(g "I" "J"))
        c.eqStr("<--> has one at each end" both.markerStart "arrowclosed")
        ; Left to right means left to right.
        def a:FlowNode (g.nodeById("A"))
        def b:FlowNode (g.nodeById("B"))
        c.ok("LR puts the target to the right" ((a.centerX()) < (b.centerX())))

        ; Bottom to top is the same layout, read the other way.
        def up:MermaidDiagram (MermaidReader.parse("flowchart BT\n  A --> B\n  B --> C\n"))
        def ug:FlowGraph (MermaidFlow.build(up))
        def ua:FlowNode (ug.nodeById("A"))
        def uc:FlowNode (ug.nodeById("C"))
        c.ok("BT puts the target above the source" ((uc.centerY()) < (ua.centerY())))

        ; A subgraph becomes a frame behind its members, and the members carry
        ; its id — which is what makes dragging the group work.
        def sub:string "flowchart TD\n"
        sub = (sub + "    A --> B\n")
        sub = (sub + "    subgraph pay [Payments]\n")
        sub = (sub + "        B --> C\n")
        sub = (sub + "        C --> D\n")
        sub = (sub + "    end\n")
        sub = (sub + "    D --> E\n")
        sub = (sub + "    classDef warn fill:#fee,stroke:#c66\n")
        sub = (sub + "    class E warn\n")
        sub = (sub + "    style A fill:#eef\n")
        def sd:MermaidDiagram (MermaidReader.parse(sub))
        c.eqInt("the block is one subgraph" (sd.subgraphCount()) 1)
        def sg:MermaidSubgraph (sd.subgraphAt(0))
        c.eqStr("named as it was written" sg.title "Payments")
        ; B is named before the block AND inside it, and Mermaid puts it in the
        ; block: a subgraph is the only statement about where a node lives, so
        ; it beats an earlier mention that said nothing about that. Measured
        ; against Mermaid's own parser — see docs/MERMAID_PARITY.md.
        c.eqInt("a node mentioned inside the block belongs to it" (sg.memberCount()) 3)
        def sgraph:FlowGraph (MermaidFlow.build(sd))
        def frame:FlowNode (sgraph.nodeById("sg-pay"))
        c.eqStr("the subgraph is drawn as a group" frame.nodeType "group")
        def cNode:FlowNode (sgraph.nodeById("C"))
        c.eqStr("and its members belong to it" cNode.parentId "sg-pay")
        ; Painted first is painted behind, which is the whole point of a frame.
        def first:FlowNode (sgraph.nodeAt(0))
        c.eqStr("the frame is behind the nodes it holds" first.id "sg-pay")
        ; The frame holds what it says it holds.
        def dNode:FlowNode (sgraph.nodeById("D"))
        def right:double (frame.x + frame.width)
        def bottom:double (frame.y + frame.height)
        c.ok("the frame encloses its members" ((cNode.x > frame.x) && (dNode.x < right)))
        c.ok("top and bottom too" ((cNode.y > frame.y) && (dNode.y < bottom)))
        ; classDef / class / style.
        def eNode:FlowNode (sgraph.nodeById("E"))
        c.eqStr("a class sets the fill" eNode.bgColor "#fee")
        c.eqStr("and the stroke" eNode.borderColor "#c66")
        def aNode:FlowNode (sgraph.nodeById("A"))
        c.eqStr("style names one node" aNode.bgColor "#eef")

        ; And the whole of the demo diagram still routes cleanly.
        def demoSrc:string (?? (read_file "." "gallery/rangerflow/fixtures/order_flow.mmd") "")
        if ((strlen demoSrc) > 0) {
            def demo:MermaidDiagram (MermaidReader.parse(demoSrc))
            c.eqStr("the demo diagram has its title" demo.title "Tilauksen käsittely")
            def dg:FlowGraph (MermaidFlow.build(demo))
            c.eqInt("nothing is drawn through a step" (EdgeOverlap.nodeCrossings(dg)) 0)
            c.eqInt("and no two links are drawn as one line" (EdgeOverlap.pairs(dg 2.0)) 0)
        }
    }

    ; ------------------------------------------------- the examples' dialect --
    ; What `fixtures/mermaid/` turned up. Every assertion here is one Mermaid's
    ; own parser makes about the same text — see `docs/MERMAID_PARITY.md`, which
    ; is regenerated by asking it rather than by writing answers down. This is
    ; the offline half: it runs in the suite, with no registry and no oracle.
    sfn testMermaidExamples:void (c:Checker) {
        c.section("Mermaid, as its examples are written")

        ; An id may hold a dash or a dot; a link may not be mistaken for one.
        def ids:MermaidDiagram (MermaidReader.parse("flowchart LR\n  node-1[One] --> node.2[Two]\n  node.2-->node_3\n"))
        c.eqInt("a kebab-case id is one node, not three" (ids.nodeCount()) 3)
        def idg:FlowGraph (ids.build())
        c.ok("and it keeps its name" (idg.hasNode("node-1")))
        c.ok("dots too" (idg.hasNode("node.2")))
        c.eqInt("with the links between them" (idg.edgeCount()) 2)

        ; Mermaid 11's `@{ … }` node: the shapes with no bracket spelling.
        def at:MermaidDiagram (MermaidReader.parse("flowchart TD\n  A@{ shape: rounded, label: \"New syntax\" }\n  B@{ shape: lean-r }\n  A --> B\n"))
        def atg:FlowGraph (at.build())
        def aNode:FlowNode (atg.nodeById("A"))
        c.eqStr("`label:` names the node" aNode.label "New syntax")
        c.near("and `shape: rounded` rounds it" aNode.borderRadius 14.0 0.001)
        def bNode:FlowNode (atg.nodeById("B"))
        c.eqStr("`shape: lean-r` is the parallelogram" bNode.shape "parallelogram")

        ; An edge with a name is not a node between two nodes.
        def named:MermaidDiagram (MermaidReader.parse("flowchart LR\n  A e1@--> B\n  e1@{ animate: true }\n"))
        c.eqInt("an edge id makes no node of its own" (named.nodeCount()) 2)
        def ng:FlowGraph (named.build())
        def e0:FlowEdge (ng.edgeAt(0))
        c.eqStr("the edge is called what the diagram called it" e0.id "e1")
        c.ok("and what it was told, it does" e0.animated)

        ; A markdown string is a label with formatting in it.
        def md:MermaidDiagram (MermaidReader.parse("flowchart LR\n  A[\"`**Bold** text`\"] --> B\n"))
        def mdg:FlowGraph (md.build())
        def mdA:FlowNode (mdg.nodeById("A"))
        c.eqStr("the backticks are not part of the label" mdA.label "**Bold** text")

        ; `<br/>` is a line the author asked for, and the layout can take one.
        def br:MermaidDiagram (MermaidReader.parse("flowchart TD\n  A[\"Two<br/>lines\"]\n"))
        def brg:FlowGraph (br.build())
        def brA:FlowNode (brg.nodeById("A"))
        c.eqInt("a break arrives as a newline" (strlen brA.label) 9)
        c.ok("and the box is given the second line" (brA.height > 60.0))

        ; A subgraph with a title and no id is named the way Mermaid names it.
        def sg:MermaidDiagram (MermaidReader.parse("flowchart TD\n  subgraph \"A title\"\n    a --> b\n  end\n"))
        c.eqInt("the block is one subgraph" (sg.subgraphCount()) 1)
        def sg0:MermaidSubgraph (sg.subgraphAt(0))
        c.eqStr("titled as written" sg0.title "A title")
        c.eqStr("and named as Mermaid names it" sg0.id "subGraph0")

        ; Everything else Mermaid draws: recognised, and read as nothing.
        def seq:MermaidDiagram (MermaidReader.parse("sequenceDiagram\n    Alice->>John: Hello\n    John-->>Alice: Hi\n"))
        c.eqStr("a sequence diagram is named" seq.diagramKind "sequence")
        c.eqInt("and not read as a flowchart" (seq.nodeCount()) 0)
        def gantt:MermaidDiagram (MermaidReader.parse("gantt\n  title A\n  section S\n  task :a1, 2014-01-01, 30d\n"))
        c.eqStr("a gantt chart too" gantt.diagramKind "gantt")
        c.eqInt("with nothing invented from it" (gantt.nodeCount()) 0)
        def state:MermaidDiagram (MermaidReader.parse("stateDiagram-v2\n  [*] --> Still\n  Still --> [*]\n"))
        c.eqStr("a version suffix is part of the name, not of the type" state.diagramKind "state")
        ; …and the one that IS the flowchart, under its other renderer.
        def elk:MermaidDiagram (MermaidReader.parse("flowchart-elk TD\n  A --> B\n"))
        c.eqStr("`flowchart-elk` is a flowchart" elk.diagramKind "flowchart")
        c.eqInt("and is read as one" (elk.nodeCount()) 2)

        ; A label may hold what looks like syntax, and a statement may end in a
        ; semicolon — the old `graph` style, which most examples still use.
        def hard:MermaidDiagram (MermaidReader.parse("graph TD;\n  A[\"a --> b, piped | text\"] --> B;\n  B --> C{\"Is it {tricky}?\"};\n"))
        c.eqInt("a label full of syntax is still one label" (hard.nodeCount()) 3)
        def hg:FlowGraph (hard.build())
        def hA:FlowNode (hg.nodeById("A"))
        c.eqStr("and it says what it says" hA.label "a --> b, piped | text")
        c.eqInt("the semicolons separate statements" (hg.edgeCount()) 2)
    }

    ; ------------------------------------------------ Mermaid class diagrams --
    ; The other Mermaid diagram RangerFlow can draw, because it already had the
    ; model for it: `domains/uml`, with the compartment node, the hollow
    ; triangle and the filled diamond.
    sfn testMermaidClassDiagram:void (c:Checker) {
        c.section("Mermaid class diagrams")
        def src:string "classDiagram\n"
        src = (src + "    Animal <|-- Duck\n")
        src = (src + "    Animal : +int age\n")
        src = (src + "    class Duck {\n")
        src = (src + "        <<interface>>\n")
        src = (src + "        +String beakColor\n")
        src = (src + "        list wings$\n")
        src = (src + "        +swim(depth) bool\n")
        src = (src + "        +quack()*\n")
        src = (src + "    }\n")
        src = (src + "    Flock \"1\" *-- \"0..*\" Duck : holds\n")
        src = (src + "    Duck ..|> Swimmer\n")
        src = (src + "    Duck ..> Water\n")
        def d:MermaidClassDiagram (MermaidClassReader.parse(src))
        c.eqInt("every class named is a class" (d.classCount()) 5)
        c.eqInt("and every relation a relation" (d.relationCount()) 4)

        def duck:UMLClass (d.ensureClass("Duck"))
        c.eqStr("an annotation is the stereotype" duck.stereotype "interface")
        c.eqInt("the attributes are counted apart from the operations" (array_length duck.attributes) 2)
        c.eqInt("…and the operations apart from the attributes" (array_length duck.operations) 2)
        def beak:UMLMember (itemAt duck.attributes 0)
        c.eqStr("Mermaid writes an attribute type first" beak.memberType "String")
        c.eqStr("and its name second" beak.name "beakColor")
        c.eqStr("with the visibility it was given" beak.visibility "+")
        def wings:UMLMember (itemAt duck.attributes 1)
        c.ok("a trailing $ is what static looks like" wings.isStatic)
        c.eqStr("and the name comes back without it" wings.name "wings")
        def swim:UMLMember (itemAt duck.operations 0)
        c.eqStr("an operation keeps its parameters" swim.parameters "depth")
        c.eqStr("and its return type" swim.memberType "bool")
        def quack:UMLMember (itemAt duck.operations 1)
        c.ok("a trailing * is what abstract looks like" quack.isAbstract)

        ; `Animal : +int age` — the same member, written on one line.
        def animal:UMLClass (d.ensureClass("Animal"))
        c.eqInt("the one-line form adds a member too" (array_length animal.attributes) 1)

        ; The ornament belongs to the end the syntax names, and the class named
        ; first is the one it is named at.
        def inherit:UMLRelation (itemAt d.uml.relations 0)
        c.eqStr("<|-- is inheritance" inherit.kind "inheritance")
        c.eqStr("read from the supertype" inherit.fromClass "Animal")
        c.ok("with the triangle at the supertype's end" inherit.markAtSource)
        def holds:UMLRelation (itemAt d.uml.relations 1)
        c.eqStr("*-- is composition" holds.kind "composition")
        c.eqStr("its label survives the colon" holds.label "holds")
        c.eqStr("and the cardinalities their quotes" holds.fromMultiplicity "1")
        c.eqStr("both of them" holds.toMultiplicity "0..*")
        def realize:UMLRelation (itemAt d.uml.relations 2)
        c.eqStr("..|> is a realization" realize.kind "implementation")
        c.ok("drawn dashed" (realize.dashed()))
        c.ok("with the triangle at the far end" (realize.markAtSource == false))
        def depend:UMLRelation (itemAt d.uml.relations 3)
        c.eqStr("..> is a dependency" depend.kind "dependency")

        ; And the whole thing draws: compartment nodes, laid out and routed.
        def g:FlowGraph (MermaidClassFlow.render(src))
        c.eqInt("every class became a node" (g.nodeCount()) 5)
        c.eqInt("and every relation an edge" (g.edgeCount()) 4)
        def dNode:FlowNode (g.nodeById("Duck"))
        c.eqStr("a class is a compartment node" dNode.nodeType "umlclass")
        c.ok("with its members in rows" ((dNode.sectionCount()) >= 2))
        def e0:FlowEdge (g.edgeAt(0))
        c.eqStr("the triangle is drawn at the end the model asked for" e0.markerStart "triangle")
        c.eqStr("and nothing at the other" e0.markerEnd "")
        c.eqInt("nothing is drawn through a class" (EdgeOverlap.nodeCrossings(g)) 0)

        ; The file the whole thing came from.
        def real:string (?? (read_file "." "gallery/rangerflow/fixtures/class_django.mmd") "")
        if ((strlen real) > 0) {
            def rd:MermaidClassDiagram (MermaidClassReader.parse(real))
            c.eqStr("front matter titles a class diagram too" rd.title "Django Watson Class Diagram")
            c.eqInt("ten classes, five of them named only by a relation" (rd.classCount()) 10)
            c.eqInt("and six relations" (rd.relationCount()) 6)
            def engine:UMLClass (rd.ensureClass("SearchEngine"))
            c.eqInt("a Python class with four fields" (array_length engine.attributes) 4)
            def statics:int 0
            def i:int 0
            while (i < (array_length engine.operations)) {
                def m:UMLMember (itemAt engine.operations i)
                if m.isStatic {
                    statics = (statics + 1)
                }
                i = (i + 1)
            }
            c.eqInt("one of its methods is static" statics 1)
            def rg:FlowGraph (MermaidClassFlow.render(real))
            c.eqInt("and it draws" (EdgeOverlap.nodeCrossings(rg)) 0)
        }
    }

    ; --------------------------------------------------- Mermaid ER diagrams --
    ; The third one, and the one this library was built for: an entity is a
    ; table, an attribute is a column, and the crow's foot goes at the many end.
    sfn testMermaidErDiagram:void (c:Checker) {
        c.section("Mermaid ER diagrams")
        def src:string "erDiagram\n"
        src = (src + "    CUSTOMER ||--o{ ORDER : places\n")
        src = (src + "    ORDER ||--|{ LINE-ITEM : contains\n")
        src = (src + "    CUSTOMER }|..|{ ADDRESS : uses\n")
        src = (src + "    CUSTOMER {\n")
        src = (src + "        string name\n")
        src = (src + "        string custNumber PK\n")
        src = (src + "        int score UK \"how good they are\"\n")
        src = (src + "    }\n")
        src = (src + "    ORDER {\n")
        src = (src + "        int orderNumber PK,FK\n")
        src = (src + "        string note\n")
        src = (src + "    }\n")
        def d:MermaidErDiagram (MermaidErReader.parse(src))
        c.eqInt("every entity named is an entity" (d.entityCount()) 4)
        c.eqInt("and every line a relationship" (d.relationCount()) 3)

        def cust:DBTable (d.ensureEntity("CUSTOMER"))
        c.eqInt("an attribute block is a list of columns" (array_length cust.columns) 3)
        def custNumber:SchemaColumn (itemAt cust.columns 1)
        c.eqStr("Mermaid writes the type first" custNumber.dataType "string")
        c.eqStr("and the name second" custNumber.name "custNumber")
        c.ok("PK is a primary key" custNumber.isPrimaryKey)
        def score:SchemaColumn (itemAt cust.columns 2)
        c.ok("UK is a unique one" score.isUnique)
        c.eqStr("and the quoted tail is the comment" score.comment "how good they are")
        def order:DBTable (d.ensureEntity("ORDER"))
        def orderNumber:SchemaColumn (itemAt order.columns 0)
        c.ok("`PK,FK` is both" (orderNumber.isPrimaryKey && orderNumber.isForeignKey))

        ; The cardinality is the pair of characters against the line, and the
        ; end it is written at is the end it describes.
        def places:MermaidErRelation (itemAt d.relations 0)
        c.eqStr("|| is exactly one" places.fromCardinality "1")
        c.eqStr("o{ is zero or more" places.toCardinality "0..*")
        c.eqStr("and the label survives the colon" places.label "places")
        def contains:MermaidErRelation (itemAt d.relations 1)
        c.eqStr("|{ is one or more" contains.toCardinality "1..*")
        c.eqStr("an entity may be written with a dash in it" contains.toEntity "LINE-ITEM")
        def uses:MermaidErRelation (itemAt d.relations 2)
        c.eqStr("}| is one or more, read from the other side" uses.fromCardinality "1..*")
        c.ok("and `..` is the non-identifying line" (uses.identifying == false))

        ; …and it draws, with the notation the schema editor already had.
        def g:FlowGraph (MermaidErFlow.render(src))
        c.eqInt("every entity became a node" (g.nodeCount()) 4)
        c.eqInt("and every relationship an edge" (g.edgeCount()) 3)
        def custNode:FlowNode (g.nodeById("CUSTOMER"))
        c.eqStr("an entity is a table" custNode.nodeType "table")
        c.ok("with its attributes in rows" ((custNode.sectionCount()) >= 1))
        def e0:FlowEdge (g.edgeAt(0))
        c.eqStr("the cardinality is carried, not the arrowhead" e0.sourceCardinality "1")
        c.eqStr("at both ends" e0.targetCardinality "0..*")
        c.eqStr("and no marker is set: the notation decides" e0.markerEnd "")
        def e2:FlowEdge (g.edgeAt(2))
        c.ok("a non-identifying relationship is drawn dashed" (e2.dash > 0.0))
        c.eqInt("nothing is drawn through an entity" (EdgeOverlap.nodeCrossings(g)) 0)

        ; The file Mermaid's own documentation is written from.
        def real:string (?? (read_file "." "gallery/rangerflow/fixtures/er_orders.mmd") "")
        if ((strlen real) > 0) {
            def rd:MermaidErDiagram (MermaidErReader.parse(real))
            c.eqStr("front matter titles an ER diagram too" rd.title "Order fulfilment")
            c.eqInt("six entities" (rd.entityCount()) 6)
            c.eqInt("and seven relationships" (rd.relationCount()) 7)
            def rg:FlowGraph (MermaidErFlow.render(real))
            c.eqInt("and it draws" (EdgeOverlap.nodeCrossings(rg)) 0)
        }

        ; The flowchart reader still refuses it, which is what keeps a diagram
        ; from being read by the wrong one.
        def asFlow:MermaidDiagram (MermaidReader.parse(src))
        c.eqStr("an ER diagram is named" asFlow.diagramKind "er")
        c.eqInt("and read as no flowchart at all" (asFlow.nodeCount()) 0)
        c.ok("but it is one this library draws" (MermaidReader.draws("er")))
        c.ok("as is a sequence diagram" (MermaidReader.draws("sequence")))
    }

    ; ------------------------------------------------ Mermaid state diagrams --
    ; A state machine and a UML activity diagram are the same picture with two
    ; vocabularies over it, so this one needed a reader and nothing else.
    sfn testMermaidStateDiagram:void (c:Checker) {
        c.section("Mermaid state diagrams")
        def src:string "stateDiagram-v2\n"
        src = (src + "    [*] --> Still\n")
        src = (src + "    Still --> [*]\n")
        src = (src + "    Still --> Moving : go\n")
        src = (src + "    state \"Rolling along\" as Moving\n")
        src = (src + "    Moving : the wheels are turning\n")
        src = (src + "    state pick <<choice>>\n")
        src = (src + "    Moving --> pick\n")
        src = (src + "    state Repair {\n")
        src = (src + "        [*] --> Diagnose\n")
        src = (src + "        Diagnose --> [*]\n")
        src = (src + "    }\n")
        src = (src + "    pick --> Repair : broken\n")
        def d:MermaidStateDiagram (MermaidStateReader.parse(src))
        ; Still, Moving, pick, Diagnose, and a start and an end in each of the
        ; two scopes.
        c.eqInt("every state named is a state" (d.stateCount()) 8)
        c.eqInt("and every arrow a transition" (d.transitionCount()) 7)
        c.eqInt("the block is one composite state" (d.groupCount()) 1)

        def moving:ActivityNode (d.ensureState("Moving"))
        c.ok("`as` renames a state" ((indexOf moving.label "Rolling along") == 0))
        c.ok("and a colon adds a line under the name" ((indexOf moving.label "the wheels are turning") > 0))
        def pick:ActivityNode (d.ensureState("pick"))
        c.eqStr("<<choice>> is a decision" pick.kind "decision")

        ; `[*]` is a start where it is written first and an end where it is
        ; written second — one of each per scope.
        def first:ActivityFlow (itemAt d.activity.flows 0)
        def start:ActivityNode (d.ensureState(first.source))
        c.eqStr("the first `[*]` is where the machine starts" start.kind "initial")
        def second:ActivityFlow (itemAt d.activity.flows 1)
        def end:ActivityNode (d.ensureState(second.target))
        c.eqStr("and the second is where it stops" end.kind "final")
        def labelled:ActivityFlow (itemAt d.activity.flows 2)
        c.eqStr("a transition carries its label as written, unbracketed" labelled.label "go")

        ; A transition to a composite state enters it at its own start, and
        ; the box is not also a state of its own.
        c.eqInt("the composite is a box rather than a box AND a state" (d.indexOfState("Repair")) -1)
        def last:ActivityFlow (itemAt d.activity.flows 6)
        def entered:ActivityNode (d.ensureState(last.target))
        c.eqStr("so entering it means entering what it starts at" entered.kind "initial")

        def g:FlowGraph (MermaidStateFlow.render(src))
        def frame:FlowNode (g.nodeById("sg-Repair"))
        c.eqStr("the composite is drawn as a group" frame.nodeType "group")
        def firstNode:FlowNode (g.nodeAt(0))
        c.eqStr("behind the states it holds" firstNode.id "sg-Repair")
        def diag:FlowNode (g.nodeById("Diagnose"))
        c.eqStr("which they belong to" diag.parentId "sg-Repair")
        c.eqInt("nothing is drawn through a state" (EdgeOverlap.nodeCrossings(g)) 0)

        ; The file it was written from.
        def real:string (?? (read_file "." "gallery/rangerflow/fixtures/state_traffic.mmd") "")
        if ((strlen real) > 0) {
            def rd:MermaidStateDiagram (MermaidStateReader.parse(real))
            c.eqStr("front matter titles a state diagram too" rd.title "A parcel, as a state machine")
            def rg:FlowGraph (MermaidStateFlow.render(real))
            c.eqInt("and it draws" (EdgeOverlap.nodeCrossings(rg)) 0)
        }
        c.ok("a state diagram is one this library draws" (MermaidReader.draws("state")))
    }

    ; ------------------------------------------------------- route quality --
    ; Known diagrams, measured. Each bound here was a picture that looked
    ; wrong first: the return arrow drawn round the outside two pixels from
    ; the exit line, the long edge arriving along the top of the box with its
    ; arrow pointing sideways, two arrivals at one side drawn on one line.
    sfn testRouteQuality:void (c:Checker) {
        c.section("Route quality on known diagrams")
        ; Mermaid's own first state example.
        def src:string "stateDiagram-v2\n"
        src = (src + "    [*] --> Still\n")
        src = (src + "    Still --> [*]\n")
        src = (src + "    Still --> Moving\n")
        src = (src + "    Moving --> Still\n")
        src = (src + "    Moving --> Crash\n")
        src = (src + "    Crash --> [*]\n")
        def g:FlowGraph (MermaidStateFlow.render(src))
        c.eqInt("nothing is drawn through a state" (EdgeOverlap.nodeCrossings(g)) 0)
        c.eqInt("no two lines lie on each other or cross" (EdgeOverlap.pairs(g 2.0)) 0)
        def back:FlowEdge (RouteQuality.edgeBetween(g "Moving" "Still"))
        c.eqInt("the return leaves by the top" (g.edgeSide(back true)) 0)
        c.eqInt("and arrives at the bottom above it" (g.edgeSide(back false)) 2)
        def backLen:double (RouteQuality.lengthOf(g back))
        c.ok(("and is short, because the two are neighbours (got " + (to_string backLen) + ")") (backLen < 120.0))
        def fwd:FlowEdge (RouteQuality.edgeBetween(g "Still" "Moving"))
        def slotGap:double (fabs ((g.endpointX(fwd true)) - (g.endpointX(back false))))
        c.ok(("the two directions have slots of their own (got " + (to_string slotGap) + ")") (slotGap >= 8.0))
        def sq:double (RouteQuality.leastSquare(g))
        c.ok(("every line meets its box at 45° or better (got " + (to_string sq) + ")") (sq >= 0.7071))
        def gap:double (RouteQuality.closestParallel(g))
        c.ok(("no two lines run side by side closer than 8 (got " + (to_string gap) + ")") (gap >= 8.0))
        def longE:FlowEdge (RouteQuality.edgeBetween(g "Still" "state0-end"))
        c.ok("the edge past two states carries a route" ((array_length longE.waypoints) >= 6))
        def arrive:double (RouteQuality.squareness(g longE false))
        c.ok(("that arrives straight down into the end (got " + (to_string arrive) + ")") (arrive > 0.99))
        c.eqInt("and every route ends where its port is" (RouteQuality.looseEnds(g)) 0)
        ; The two boxes stand in one column, so the two lines between them
        ; can be straight: the fan puts each slot opposite the slot the same
        ; edge has at the other end.
        c.eqInt("a line that can be straight is straight — down" (RouteQuality.bends(g fwd)) 0)
        c.eqInt("a line that can be straight is straight — and back up" (RouteQuality.bends(g back)) 0)
        def turns:int (RouteQuality.totalBends(g))
        c.ok(("the whole picture turns few corners (got " + (to_string turns) + ")") (turns <= 6))
        ; The chain past two states of different widths used to jog four
        ; pixels between their lanes; a wobble that small is drawn straight.
        c.ok(("the routed edge runs down one lane (got " + (to_string (RouteQuality.bends(g longE))) + " bends)") ((RouteQuality.bends(g longE)) <= 4))

        ; What makes the picture read big when it is fitted to a page: the
        ; boxes are the size of the words in them, the type in them is larger
        ; than the theme's, and the gaps are what the corridors need. The
        ; column comes out a quarter shorter than with even boxes and gaps.
        def still:FlowNode (g.nodeById("Still"))
        c.ok(("a state is its name with room round it (got " + (to_string still.width) + " wide)") (still.width < 90.0))
        c.near("set larger than the theme's face" still.fontScale (15.0 / 13.0) 0.001)
        def column:FlowRect (g.bounds())
        c.ok(("and the column closed its gaps (got " + (to_string column.h) + " tall)") (column.h < 420.0))

        ; The same machine across the page.
        def across:string ("stateDiagram-v2\n    direction LR\n" + (substring src 15 (strlen src)))
        def lg:FlowGraph (MermaidStateFlow.render(across))
        c.eqInt("across the page: nothing through a state" (EdgeOverlap.nodeCrossings(lg)) 0)
        c.eqInt("across the page: no line on another" (EdgeOverlap.pairs(lg 2.0)) 0)
        def lback:FlowEdge (RouteQuality.edgeBetween(lg "Moving" "Still"))
        c.eqInt("across the page: the return leaves by the left" (lg.edgeSide(lback true)) 3)
        c.eqInt("and arrives at the right of the state before it" (lg.edgeSide(lback false)) 1)
        def lsq:double (RouteQuality.leastSquare(lg))
        c.ok(("across the page: every line meets its box square (got " + (to_string lsq) + ")") (lsq >= 0.7071))
        def lgap:double (RouteQuality.closestParallel(lg))
        c.ok(("across the page: no two lines closer than 8 (got " + (to_string lgap) + ")") (lgap >= 8.0))
        c.eqInt("across the page: every route ends at its port" (RouteQuality.looseEnds(lg)) 0)
        ; Five boxes in a row are a strip, and a strip fitted to a page is
        ; drawn small. The layout closes its gaps as far as the corridors
        ; allow: from 120 to what the busiest corridor needs.
        def strip:FlowRect (lg.bounds())
        c.ok(("across the page: the strip closed its gaps (got " + (to_string strip.w) + " wide)") (strip.w < 780.0))
        c.ok("but not so far that two lines share a corridor" ((EdgeOverlap.pairs(lg 2.0)) == 0))

        ; A busier one: a pair of transitions each way, two ways back to the
        ; start, and a transition to itself.
        def busy:string "stateDiagram-v2\n"
        busy = (busy + "    [*] --> Idle\n")
        busy = (busy + "    Idle --> Idle : tick\n")
        busy = (busy + "    Idle --> Running : start\n")
        busy = (busy + "    Running --> Paused : pause\n")
        busy = (busy + "    Paused --> Running : resume\n")
        busy = (busy + "    Running --> Idle : stop\n")
        busy = (busy + "    Paused --> Idle : stop\n")
        busy = (busy + "    Running --> Done : finish\n")
        busy = (busy + "    Done --> [*]\n")
        def bg:FlowGraph (MermaidStateFlow.render(busy))
        c.eqInt("busy: nothing through a state" (EdgeOverlap.nodeCrossings(bg)) 0)
        c.eqInt("busy: no line on another" (EdgeOverlap.pairs(bg 2.0)) 0)
        def bsq:double (RouteQuality.leastSquare(bg))
        c.ok(("busy: every line meets its box square (got " + (to_string bsq) + ")") (bsq >= 0.7071))
        def bgap:double (RouteQuality.closestParallel(bg))
        c.ok(("busy: no two lines closer than 8 (got " + (to_string bgap) + ")") (bgap >= 8.0))
        c.eqInt("busy: every route ends at its port" (RouteQuality.looseEnds(bg)) 0)
        ; Two `stop`s into Idle from below: one a neighbour, one routed past
        ; Running. They used to arrive on one line, the routed one drawn to
        ; where its port was before the fan moved it.
        def stop1:FlowEdge (RouteQuality.edgeBetween(bg "Running" "Idle"))
        def stop2:FlowEdge (RouteQuality.edgeBetween(bg "Paused" "Idle"))
        c.eqInt("busy: a neighbour's return goes straight up" (bg.edgeSide(stop1 true)) 0)
        c.ok("busy: the far return was routed" ((array_length stop2.waypoints) >= 6))
        def stops:double (fabs ((bg.endpointX(stop1 false)) - (bg.endpointX(stop2 false))))
        c.ok(("busy: two arrivals at one side get slots of their own (got " + (to_string stops) + ")") (stops >= 8.0))
        def start:FlowEdge (RouteQuality.edgeBetween(bg "Idle" "Running"))
        c.eqInt("busy: `start` goes straight down" (RouteQuality.bends(bg start)) 0)
        c.eqInt("busy: and its `stop` straight back up beside it" (RouteQuality.bends(bg stop1)) 0)
        def resume:FlowEdge (RouteQuality.edgeBetween(bg "Paused" "Running"))
        def pause:FlowEdge (RouteQuality.edgeBetween(bg "Running" "Paused"))
        ; Down on one track and back up on the other: the one that goes
        ; further across turns later, or the two cross twice in the corridor.
        c.eqInt("busy: `pause` and `resume` do not cross each other" (RouteQuality.crossingsBetween(bg pause resume)) 0)
        def resumeLen:double (RouteQuality.lengthOf(bg resume))
        c.ok(("busy: a return to a neighbour does not go round the house (got " + (to_string resumeLen) + ")") (resumeLen < 260.0))

        ; The flowchart reader draws the same picture and is held to the same
        ; numbers.
        def fsrc:string "flowchart TD\n"
        fsrc = (fsrc + "  S((start)) --> Still\n")
        fsrc = (fsrc + "  Still --> E(((end)))\n")
        fsrc = (fsrc + "  Still --> Moving\n")
        fsrc = (fsrc + "  Moving --> Still\n")
        fsrc = (fsrc + "  Moving --> Crash\n")
        fsrc = (fsrc + "  Crash --> E\n")
        def fd:MermaidDiagram (MermaidReader.parse(fsrc))
        def fg:FlowGraph (MermaidFlow.build(fd))
        c.eqInt("flowchart: nothing through a node" (EdgeOverlap.nodeCrossings(fg)) 0)
        c.eqInt("flowchart: no line on another" (EdgeOverlap.pairs(fg 2.0)) 0)
        def fsq:double (RouteQuality.leastSquare(fg))
        c.ok(("flowchart: every line meets its box square (got " + (to_string fsq) + ")") (fsq >= 0.7071))
        def fgap:double (RouteQuality.closestParallel(fg))
        c.ok(("flowchart: no two lines closer than 8 (got " + (to_string fgap) + ")") (fgap >= 8.0))
        def fback:FlowEdge (RouteQuality.edgeBetween(fg "Moving" "Still"))
        def fbackLen:double (RouteQuality.lengthOf(fg fback))
        c.ok(("flowchart: the return is short (got " + (to_string fbackLen) + ")") (fbackLen < 120.0))
        def flong:FlowEdge (RouteQuality.edgeBetween(fg "Still" "E"))
        def farrive:double (RouteQuality.squareness(fg flong false))
        c.ok(("flowchart: the long edge arrives straight in (got " + (to_string farrive) + ")") (farrive > 0.99))
        c.eqInt("flowchart: every route ends at its port" (RouteQuality.looseEnds(fg)) 0)

        ; Closing the gaps, on its own: a chain of six boxes down the page is
        ; four times taller than it is wide, so the gaps go to their floor —
        ; and no further, because the floor is what a corridor with one edge
        ; in it needs. Off, the gaps are as asked.
        def chain (new FlowGraph)
        def b:int 0
        while (b < 6) {
            def nd:FlowNode (chain.node(("b" + (to_string b)) ("box " + (to_string b)) 0.0 0.0))
            nd.width = 120.0
            nd.height = 50.0
            if (b > 0) {
                chain.connect(("b" + (to_string (b - 1))) ("b" + (to_string b)))
            }
            b = (b + 1)
        }
        def asked:LayeredLayout (LayeredLayout.of(chain))
        asked.direction = "TB"
        asked.layerGap = 76.0
        asked.run()
        def tall:double (asked.extentAlong())
        c.near("with the gaps as asked, six boxes and five gaps" tall 680.0 0.5)
        def squared:LayeredLayout (LayeredLayout.of(chain))
        squared.direction = "TB"
        squared.layerGap = 76.0
        squared.squareUp = true
        squared.run()
        def shorter:double (squared.extentAlong())
        c.near("squared up, the gaps close to the floor" squared.layerGap 56.0 0.001)
        c.near("and the column is that much shorter" shorter 580.0 0.5)
        def b1:FlowNode (chain.nodeById("b1"))
        def b2:FlowNode (chain.nodeById("b2"))
        c.near("with every box placed on the new gap" (b2.y - b1.y) 106.0 0.5)
        ; A gap a busy corridor needs is not closed. Two more boxes beside
        ; the fourth, both fed from the third, put two edges in that corridor
        ; that have to turn — the one straight down still turns nowhere —
        ; and the gap keeps a track for each.
        def side:int 0
        while (side < 2) {
            def extra:FlowNode (chain.node(("s" + (to_string side)) "beside" 0.0 0.0))
            extra.width = 120.0
            extra.height = 50.0
            chain.connect("b2" ("s" + (to_string side)))
            side = (side + 1)
        }
        def busyLay:LayeredLayout (LayeredLayout.of(chain))
        busyLay.direction = "TB"
        busyLay.layerGap = 76.0
        busyLay.squareUp = true
        busyLay.run()
        c.near("a corridor with two edges that turn keeps a track for each" busyLay.layerGap 70.0 0.001)
    }

    ; ------------------------------------------- the other dialects, measured --
    ; The same numbers on the diagrams that broke when the state machine was
    ; fixed — or rather, that had been broken all along and were only
    ; noticed once there was a number to notice them by.
    sfn testOtherDialectsQuality:void (c:Checker) {
        c.section("Route quality on the other dialects")
        def style:FlowStyle (FlowStyle.named("default"))

        ; Three subclasses of one 28px class standing beside a 400px one:
        ; the corridor's walls are pulled in past the tall class, so the
        ; three tracks run under it instead of through it and on each other,
        ; and the one subclass that stands under its parent gets a straight
        ; line — its single slot slid to sit under the parent's.
        def cls:string "classDiagram\n"
        cls = (cls + "    class Exception\n")
        cls = (cls + "    class Engine {\n")
        def row:int 0
        while (row < 18) {
            cls = (cls + "        +method" + (to_string row) + "()\n")
            row = (row + 1)
        }
        cls = (cls + "    }\n")
        cls = (cls + "    Exception <|-- AdapterError\n")
        cls = (cls + "    Exception <|-- EngineError\n")
        cls = (cls + "    Exception <|-- ContextError\n")
        cls = (cls + "    Engine --> AdapterError\n")
        def cd:MermaidDrawing (MermaidRender.draw(cls style))
        c.ok("the class diagram draws" cd.ok)
        def cg:FlowGraph cd.graph
        c.eqInt("class: nothing drawn through a class" (EdgeOverlap.nodeCrossings(cg)) 0)
        c.eqInt("class: no two lines on each other" (EdgeOverlap.pairs(cg 2.0)) 0)
        def csq:double (RouteQuality.leastSquare(cg))
        c.ok(("class: every line meets its box square (got " + (to_string csq) + ")") (csq >= 0.7071))
        c.eqInt("class: every route ends at its port" (RouteQuality.looseEnds(cg)) 0)

        ; Mermaid's own subgraph example: three groups, one of them spanning
        ; the whole page. Laid out in bands, no frame overlaps another and
        ; no node stands inside a frame that is not its own.
        def sub:string "flowchart TB\n"
        sub = (sub + "    c1-->a2\n")
        sub = (sub + "    subgraph one\n        a1-->a2\n    end\n")
        sub = (sub + "    subgraph two\n        b1-->b2\n    end\n")
        sub = (sub + "    subgraph three\n        c1-->c2\n    end\n")
        sub = (sub + "    one --> two\n    three --> two\n    two --> c2\n")
        def sd:MermaidDrawing (MermaidRender.draw(sub style))
        def sg:FlowGraph sd.graph
        c.eqInt("subgraphs: nothing drawn through a node" (EdgeOverlap.nodeCrossings(sg)) 0)
        c.eqInt("subgraphs: no two lines on each other" (EdgeOverlap.pairs(sg 2.0)) 0)
        c.eqInt("subgraphs: no frame overlaps another" (RangerFlowTest.frameOverlaps(sg)) 0)
        c.eqInt("subgraphs: no node stands in a frame that is not its own" (RangerFlowTest.strangersInFrames(sg)) 0)
        def ssq:double (RouteQuality.leastSquare(sg))
        c.ok(("subgraphs: every line meets its box square (got " + (to_string ssq) + ")") (ssq >= 0.7071))

        ; One group in the middle of a flow, with a node the layout set down
        ; half inside its frame. The node is moved clear; the flow stays a
        ; flow rather than being banded into two columns.
        def flow:string "flowchart TD\n"
        flow = (flow + "    a --> b{ok?}\n")
        flow = (flow + "    b -->|yes| c[Reserve]\n")
        flow = (flow + "    b -->|no| r[Reject]\n")
        flow = (flow + "    subgraph bill [Billing]\n        c --> d[Invoice]\n        d --> e[Send]\n    end\n")
        flow = (flow + "    e --> z((done))\n    r --> z\n")
        def fd:MermaidDrawing (MermaidRender.draw(flow style))
        def fg:FlowGraph fd.graph
        c.eqInt("a stranger is moved out of the frame" (RangerFlowTest.strangersInFrames(fg)) 0)
        c.eqInt("and the flow is not banded for it" (RangerFlowTest.frameOverlaps(fg)) 0)
        def bx:FlowNode (fg.nodeById("b"))
        def cx:FlowNode (fg.nodeById("c"))
        c.ok("the flow still runs down the page" ((cx.centerY()) > (bx.centerY())))

        ; Mermaid's ER relationships name no column, so three of them out of
        ; one entity have the whole side to spread on, not one row.
        def er:string "erDiagram\n"
        er = (er + "    CUSTOMER {\n        int id\n        string name\n        string email\n        string sector\n    }\n")
        er = (er + "    CUSTOMER ||--o{ ORDER : places\n")
        er = (er + "    CUSTOMER ||--|| ADDRESS : has\n")
        er = (er + "    CUSTOMER ||--o{ INVOICE : pays\n")
        def ed:MermaidDrawing (MermaidRender.draw(er style))
        def eg:FlowGraph ed.graph
        def slots:[double]
        def k:int 0
        while (k < (eg.edgeCount())) {
            def e:FlowEdge (eg.edgeAt(k))
            if (e.source == "CUSTOMER") {
                push slots (eg.endpointY(e true))
            }
            k = (k + 1)
        }
        c.eqInt("er: three relationships leave the customer" (array_length slots) 3)
        def least:double 1000.0
        def i:int 0
        while (i < (array_length slots)) {
            def j:int (i + 1)
            while (j < (array_length slots)) {
                def d:double (fabs ((itemAt slots i) - (itemAt slots j)))
                if (d < least) { least = d }
                j = (j + 1)
            }
            i = (i + 1)
        }
        c.ok(("er: each from a slot of its own (got " + (to_string least) + " apart)") (least >= 8.0))

        ; A flowchart's `E --> E` is a loop off the side, not a line drawn
        ; from the bottom of the box to the top of it.
        def loop:string "graph TD;\n    A --> B;\n    E --> E;\n"
        def ld:MermaidDrawing (MermaidRender.draw(loop style))
        def lg:FlowGraph ld.graph
        def self:FlowEdge (RouteQuality.edgeBetween(lg "E" "E"))
        c.eqInt("a self-loop leaves by the side" (lg.edgeSide(self true)) 1)
        c.eqInt("and comes back to the same side" (lg.edgeSide(self false)) 1)
        c.eqInt("and nothing is drawn through E" (EdgeOverlap.nodeCrossings(lg)) 0)
    }

    ; How many pairs of frames, neither inside the other, overlap.
    sfn frameOverlaps:int (g:FlowGraph) {
        def hits:int 0
        def a:int 0
        while (a < (g.nodeCount())) {
            def fa:FlowNode (g.nodeAt(a))
            if (fa.nodeType == "group") {
                def b:int (a + 1)
                while (b < (g.nodeCount())) {
                    def fb:FlowNode (g.nodeAt(b))
                    if (fb.nodeType == "group") {
                        if (fa.parentId != fb.id) {
                            if (fb.parentId != fa.id) {
                                def ra:FlowRect (fa.rect())
                                def rb:FlowRect (fb.rect())
                                if (ra.overlaps(rb)) {
                                    hits = (hits + 1)
                                }
                            }
                        }
                    }
                    b = (b + 1)
                }
            }
            a = (a + 1)
        }
        return hits
    }

    ; How many nodes have their middle inside a frame they do not belong to.
    sfn strangersInFrames:int (g:FlowGraph) {
        def hits:int 0
        def i:int 0
        while (i < (g.nodeCount())) {
            def n:FlowNode (g.nodeAt(i))
            if (n.nodeType != "group") {
                def f:int 0
                while (f < (g.nodeCount())) {
                    def frame:FlowNode (g.nodeAt(f))
                    if (frame.nodeType == "group") {
                        if ((RangerFlowTest.belongsTo(g n frame.id)) == false) {
                            def r:FlowRect (frame.rect())
                            def cx:double (n.centerX())
                            def cy:double (n.centerY())
                            if (cx > r.x) {
                                if (cx < (r.x + r.w)) {
                                    if (cy > r.y) {
                                        if (cy < (r.y + r.h)) {
                                            hits = (hits + 1)
                                        }
                                    }
                                }
                            }
                        }
                    }
                    f = (f + 1)
                }
            }
            i = (i + 1)
        }
        return hits
    }

    sfn belongsTo:boolean (g:FlowGraph n:FlowNode frameId:string) {
        def cur:string n.parentId
        def guard:int 0
        while (guard < 32) {
            if ((strlen cur) == 0) {
                return false
            }
            if (cur == frameId) {
                return true
            }
            if ((g.hasNode(cur)) == false) {
                return false
            }
            def p:FlowNode (g.nodeById(cur))
            cur = p.parentId
            guard = (guard + 1)
        }
        return false
    }

    ; ---------------------------------------------------- Mermaid mind maps --
    ; The one with no arrows in it: indentation is the syntax, and the tree
    ; layout has balanced a mind map either side of its root since it was
    ; written.
    sfn testMermaidMindMap:void (c:Checker) {
        c.section("Mermaid mind maps")
        def src:string "mindmap\n"
        src = (src + "  root((the middle))\n")
        src = (src + "    Origins\n")
        src = (src + "      Long history\n")
        src = (src + "      ::icon(fa fa-book)\n")
        src = (src + "      Popularisation\n")
        src = (src + "        Tony Buzan\n")
        src = (src + "    Research\n")
        src = (src + "      On effectiveness<br/>and features\n")
        src = (src + "    Tools[in brackets]\n")
        src = (src + "      Pen and paper\n")
        def d:MermaidMindMap (MermaidMindMapReader.parse(src))
        c.eqInt("every line is a node" (d.nodeCount()) 9)
        c.eqStr("the first one is the root" (d.rootId()) "root")

        def root:MermaidMindNode (itemAt d.nodes 0)
        c.eqStr("`(( ))` is a circle" root.shape "circle")
        c.eqStr("with the label from between the brackets" root.label "the middle")
        def origins:MermaidMindNode (itemAt d.nodes 1)
        c.eqInt("indentation is the hierarchy" origins.depth 1)
        c.eqStr("so the root is its parent" origins.parent "root")
        def buzan:MermaidMindNode (itemAt d.nodes 4)
        c.eqInt("four levels in" buzan.depth 3)
        c.eqStr("under the line above it" buzan.parent "Popularisation")
        def research:MermaidMindNode (itemAt d.nodes 5)
        c.eqStr("and a line indented back out is a sibling of what it lines up with" research.parent "root")
        def wrapped:MermaidMindNode (itemAt d.nodes 6)
        c.ok("`<br/>` is a line the author asked for" ((indexOf wrapped.label (strfromcode 10)) > 0))
        def tools:MermaidMindNode (itemAt d.nodes 7)
        c.eqStr("`[]` is a square" tools.shape "square")
        c.eqStr("named by what is before the bracket" tools.id "Tools")
        c.eqStr("and labelled by what is inside it" tools.label "in brackets")

        ; …and it draws, laid out by the mind map layout rather than a layered
        ; one: a mind map read top to bottom is a tree with the point missed.
        def g:FlowGraph (MermaidMindMapFlow.render(src))
        c.eqInt("every node became a node" (g.nodeCount()) 9)
        c.eqInt("and every line but the root's a branch" (g.edgeCount()) 8)
        def rootNode:FlowNode (g.nodeById("root"))
        def left:int 0
        def right:int 0
        def i:int 0
        while (i < (g.nodeCount())) {
            def n:FlowNode (g.nodeAt(i))
            if ((n.centerX()) < (rootNode.centerX())) {
                left = (left + 1)
            }
            if ((n.centerX()) > (rootNode.centerX())) {
                right = (right + 1)
            }
            i = (i + 1)
        }
        c.ok("the branches are balanced either side of the root" ((left > 0) && (right > 0)))
        c.eqInt("nothing is drawn through a node" (EdgeOverlap.nodeCrossings(g)) 0)
        c.ok("a mind map is one this library draws" (MermaidReader.draws("mindmap")))
    }

    ; ------------------------------------------- Mermaid requirement diagrams --
    ; A requirement diagram is a class diagram whose boxes are requirements, so
    ; it is read into the same UML model with the fields as rows.
    sfn testMermaidRequirements:void (c:Checker) {
        c.section("Mermaid requirement diagrams")
        def src:string "requirementDiagram\n"
        src = (src + "requirement top {\n")
        src = (src + "    id: 1\n")
        src = (src + "    text: the system shall work.\n")
        src = (src + "    risk: high\n")
        src = (src + "    verifymethod: test\n")
        src = (src + "}\n")
        src = (src + "functionalRequirement sub {\n")
        src = (src + "    id: 1.1\n")
        src = (src + "    risk: low\n")
        src = (src + "}\n")
        src = (src + "element impl {\n")
        src = (src + "    type: simulation\n")
        src = (src + "}\n")
        src = (src + "impl - satisfies -> sub\n")
        src = (src + "top - contains -> sub\n")
        src = (src + "sub <- copies - impl\n")
        def d:MermaidRequirementDiagram (MermaidRequirementReader.parse(src))
        c.eqInt("every declaration is a box" (d.boxCount()) 3)
        c.eqInt("and every arrow a trace" (d.relationCount()) 3)

        def top:UMLClass (d.ensureBox("top"))
        c.eqStr("the keyword is the stereotype" top.stereotype "requirement")
        c.eqInt("and the braces hold its fields" (array_length top.attributes) 4)
        def text:UMLMember (itemAt top.attributes 1)
        c.eqStr("a field keeps its name" text.name "text")
        c.eqStr("and everything after the colon, full stop included" text.memberType "the system shall work.")
        def sub:UMLClass (d.ensureBox("sub"))
        c.eqStr("each requirement type is its own stereotype" sub.stereotype "functionalRequirement")
        def impl:UMLClass (d.ensureBox("impl"))
        c.eqStr("and an element says so" impl.stereotype "element")

        def satisfies:UMLRelation (itemAt d.uml.relations 0)
        c.eqStr("a trace is a dependency" satisfies.kind "dependency")
        c.eqStr("with the relationship's name on it" satisfies.label "«satisfies»")
        c.ok("drawn dashed" (satisfies.dashed()))
        def copies:UMLRelation (itemAt d.uml.relations 2)
        c.ok("`<-` points the other way" copies.markAtSource)

        def g:FlowGraph (MermaidRequirementFlow.render(src))
        c.eqInt("every box became a node" (g.nodeCount()) 3)
        c.eqInt("and every trace an edge" (g.edgeCount()) 3)
        def topNode:FlowNode (g.nodeById("top"))
        c.ok("with the fields in rows" ((topNode.sectionCount()) >= 1))
        c.eqInt("nothing is drawn through a box" (EdgeOverlap.nodeCrossings(g)) 0)
        c.ok("a requirement diagram is one this library draws" (MermaidReader.draws("requirement")))
    }

    ; --------------------------------------------------- Mermaid C4 diagrams --
    ; C4 is a naming convention over a very ordinary picture: labelled boxes,
    ; boundaries around groups of them, and arrows with a protocol on them.
    sfn testMermaidC4:void (c:Checker) {
        c.section("Mermaid C4 diagrams")
        def src:string "C4Context\n"
        src = (src + "    title Internet banking\n")
        src = (src + "    Enterprise_Boundary(b0, \"The bank\") {\n")
        src = (src + "        Person(customer, \"A customer\", \"Has accounts\")\n")
        src = (src + "        System(banking, \"Internet banking\", \"Shows accounts\")\n")
        src = (src + "        System_Boundary(b1, \"Back office\") {\n")
        src = (src + "            SystemDb(core, \"Mainframe\", \"Holds the accounts\")\n")
        src = (src + "        }\n")
        src = (src + "    }\n")
        src = (src + "    System_Ext(mail, \"E-mail\", \"Sends the letters\")\n")
        src = (src + "    BiRel(customer, banking, \"Uses\")\n")
        src = (src + "    Rel(banking, core, \"Reads\", \"Sync\")\n")
        src = (src + "    UpdateElementStyle(customer, $fontColor=\"red\")\n")
        def d:MermaidC4Diagram (MermaidC4Reader.parse(src))
        c.eqStr("the title is the line that says so" d.title "Internet banking")
        c.eqInt("every element is a box" (d.boxCount()) 4)
        c.eqInt("every Rel is a relation" (d.relationCount()) 2)
        c.eqInt("and every boundary a frame" (d.groupCount()) 2)

        def person:UMLClass (d.ensureBox("customer"))
        c.eqStr("a Person says it is one" person.stereotype "person")
        def caption:UMLMember (itemAt person.attributes 0)
        c.eqStr("the label is the first row" caption.name "A customer")
        def note:UMLMember (itemAt person.attributes 1)
        c.eqStr("and the description the second" note.name "Has accounts")
        def ext:UMLClass (d.ensureBox("mail"))
        c.eqStr("`_Ext` says the system is somebody else's" ext.stereotype "system, external")
        def db:UMLClass (d.ensureBox("core"))
        c.eqStr("and `Db` that it holds the data" db.stereotype "system, database")

        def uses:UMLRelation (itemAt d.uml.relations 1)
        c.eqStr("the technology rides in brackets after the label" uses.label "Reads [Sync]")

        def g:FlowGraph (MermaidC4Flow.render(src))
        def frame:FlowNode (g.nodeById("sg-b0"))
        c.eqStr("a boundary is drawn as a group" frame.nodeType "group")
        def inner:FlowNode (g.nodeById("core"))
        c.eqStr("and the inner boundary holds what is inside it" inner.parentId "sg-b1")
        def first:FlowEdge (g.edgeAt(0))
        c.eqStr("a BiRel has an arrow at both ends" first.markerStart "arrow")
        def second:FlowEdge (g.edgeAt(1))
        c.eqStr("and a Rel at one" second.markerStart "")
        c.eqInt("nothing is drawn through a box" (EdgeOverlap.nodeCrossings(g)) 0)
        c.ok("a C4 diagram is one this library draws" (MermaidReader.draws("c4")))
    }

    ; ------------------------------------- the two Mermaid diagrams that are
    ; PLACED rather than laid out: a timeline runs along its axis in the order
    ; it was written, and a journey's height is the score. Handing either to a
    ; layered layout would throw away the only quantity the diagram has.
    sfn testMermaidPlaced:void (c:Checker) {
        c.section("Mermaid timelines and journeys")
        def tl:string "timeline\n"
        tl = (tl + "    title A short history\n")
        tl = (tl + "    section The nineties\n")
        tl = (tl + "        1991 : The first web page\n")
        tl = (tl + "        1995 : JavaScript : PHP\n")
        tl = (tl + "    section Since\n")
        tl = (tl + "        2017 : WebAssembly\n")
        def t:MermaidTimeline (MermaidTimelineReader.parse(tl))
        c.eqStr("the title is the line that says so" t.title "A short history")
        c.eqInt("a period per line" (t.periodCount()) 3)
        c.eqInt("and an event per colon after it" (t.eventCount()) 4)
        c.eqInt("with the sections counted" (t.sectionCount()) 2)
        def p:MermaidTimelinePeriod (itemAt t.periods 1)
        c.eqStr("the period is what comes first" p.label "1995")
        c.eqInt("and the rest are its events" (p.eventCount()) 2)
        c.eqStr("under the section they were written in" p.section "The nineties")

        def tg:FlowGraph (MermaidTimelineFlow.render(tl))
        ; 3 periods + 4 events + 2 section frames.
        c.eqInt("every period and event is a node" (tg.nodeCount()) 9)
        def a:FlowNode (tg.nodeById("period0"))
        def b:FlowNode (tg.nodeById("period1"))
        c.ok("the periods run along the axis in the order written" (a.x < b.x))
        def frame:FlowNode (tg.nodeAt(0))
        c.eqStr("and a section is a frame behind them" frame.nodeType "group")
        ; A section you can pick up has to bring its periods: a frame that
        ; slides off its own contents is a box that means nothing. The frames
        ; are sent to the back as they are made, so which one is node 0 is the
        ; paint order — the section is named instead.
        c.eqStr("a period belongs to the section it was written under" a.parentId "sg-section0")
        def ev:FlowNode (tg.nodeById("event0"))
        c.eqStr("and so does the event under it" ev.parentId "sg-section0")
        def late:FlowNode (tg.nodeById("period2"))
        c.eqStr("a period in the next section belongs to that one" late.parentId "sg-section1")

        def jn:string "journey\n"
        jn = (jn + "    title My working day\n")
        jn = (jn + "    section Go to work\n")
        jn = (jn + "      Make tea: 5: Me\n")
        jn = (jn + "      Do work: 1: Me, Cat\n")
        def j:MermaidJourney (MermaidJourneyReader.parse(jn))
        c.eqInt("a task per line" (j.taskCount()) 2)
        def task:MermaidJourneyTask (itemAt j.tasks 1)
        c.eqStr("the name is what comes before the first colon" task.name "Do work")
        c.eqInt("the score is the number after it" task.score 1)
        c.eqStr("and the actors are the rest" task.actors "Me, Cat")

        def jg:FlowGraph (MermaidJourneyFlow.render(jn))
        def high:FlowNode (jg.nodeById("task0"))
        def low:FlowNode (jg.nodeById("task1"))
        c.ok("a five sits above a one, which is the whole point" (high.y < low.y))
        c.ok("and the day runs left to right" (high.x < low.x))
        def jframe:FlowNode (jg.nodeById("sg-section0"))
        c.eqStr("a journey's section is a frame too" jframe.nodeType "group")
        c.eqStr("and its tasks move with it" high.parentId "sg-section0")
        c.ok("both are diagrams this library draws" ((MermaidReader.draws("timeline")) && (MermaidReader.draws("journey"))))
    }

    ; ------------------------------------------------------ Mermaid Gantt --
    ; The axis is the diagram: a chart that spaced its bars evenly instead of
    ; by date would be a list with rounded corners. So the reader does the
    ; arithmetic, and these are the sums.
    sfn testMermaidGantt:void (c:Checker) {
        c.section("Mermaid Gantt charts")
        def src:string "gantt\n"
        src = (src + "    title A release\n")
        src = (src + "    dateFormat YYYY-MM-DD\n")
        src = (src + "    section Build\n")
        src = (src + "        Write it   :a1, 2024-01-01, 10d\n")
        src = (src + "        Test it    :after a1, 5d\n")
        src = (src + "        Sign off   :crit, done, 2024-01-20, 2d\n")
        src = (src + "    section Ship\n")
        src = (src + "        Release    :milestone, m1, 2024-02-01, 0d\n")
        src = (src + "        Watch it   :1w\n")
        def d:MermaidGantt (MermaidGanttReader.parse(src))
        c.eqStr("the title is the line that says so" d.title "A release")
        c.eqInt("a task per line" (d.taskCount()) 5)
        c.eqInt("and the sections counted" (d.sectionCount()) 2)

        def write:MermaidGanttTask (itemAt d.tasks 0)
        c.eqStr("the name is what comes before the colon" write.name "Write it")
        c.eqStr("the id is the token that is neither a date nor a duration" write.id "a1")
        c.eqInt("`10d` is ten days" write.days 10)
        ; 2024-01-01 is 19723 days after the epoch, by the civil calendar.
        c.eqInt("a date is a day number" write.startDay 19723)
        def test:MermaidGanttTask (itemAt d.tasks 1)
        c.eqStr("`after a1` names what it waits for" test.after "a1")
        c.eqInt("and starts where that one finished" test.startDay 19733)
        def signoff:MermaidGanttTask (itemAt d.tasks 2)
        c.ok("the tags are kept for a stylesheet to match" ((indexOf signoff.tags "crit") > 0))
        def release:MermaidGanttTask (itemAt d.tasks 3)
        c.ok("a milestone says so" release.milestone)
        c.eqInt("and lasts no time at all" release.days 0)
        def watch:MermaidGanttTask (itemAt d.tasks 4)
        c.eqInt("`1w` is seven days" watch.days 7)
        c.eqInt("and a task with no start follows the one before it" watch.startDay (release.endDay()))

        def g:FlowGraph (MermaidGanttFlow.render(src))
        def bar1:FlowNode (g.nodeById("a1"))
        def bar2:FlowNode (g.nodeById("task1"))
        c.ok("the bars are placed by date, not by order" (bar1.x < bar2.x))
        c.ok("and their width is how long they take" (bar1.width > 0.0))
        def milestone:FlowNode (g.nodeById("m1"))
        c.eqStr("a milestone is drawn as the diamond it is" milestone.shape "diamond")
        ; `after a1` is arithmetic on the start date and nothing else. Mermaid
        ; draws no dependency arrow, and an arrow drawn here would be a claim
        ; about the plan that the plan does not make.
        c.eqInt("a Gantt chart has no edges at all" (g.edgeCount()) 0)
        c.eqInt("and `after` shows as the date it produced" (test.startDay) 19733)
        ; The axis is the diagram: a chart that spaced its bars evenly would be
        ; a list with rounded corners, and one with no dates on it is a chart
        ; you cannot read a date off.
        def tick:FlowNode (g.nodeById("gtick-0"))
        c.ok("the axis is labelled with dates" ((indexOf tick.label "-") > 0))
        c.eqStr("read back out of the day numbers the reader made" (MermaidGanttFlow.dateText(19723)) "2024-01-01")
        c.eqStr("and the last day of a leap February is not the first of March" (MermaidGanttFlow.dateText(19782)) "2024-02-29")
        c.ok("with a rule down the chart at every one" (g.hasNode("gline-0")))
        ; Two sections whose dates overlap have overlapping bounding boxes, so
        ; a band per box draws one on top of the other and loses the label
        ; underneath. A band is a run of consecutive rows instead.
        def b0:FlowNode (g.nodeById("gband-0"))
        def b1:FlowNode (g.nodeById("gband-1"))
        c.ok("each section is a band of its own" ((b0.y + b0.height) <= (b1.y + 0.001)))
        c.ok("and every band keeps its name" (g.hasNode("gband-1-name")))
        c.ok("the bars are filled, not outlined" ((strlen bar1.bgColor) > 0))
        c.ok("a Gantt chart is one this library draws" (MermaidReader.draws("gantt")))
    }

    ; --------------------------------------------- Mermaid sequence -------
    ; A sequence diagram is the one Mermaid type where both axes are content:
    ; who, across, and when, down. So the assertions are about ORDER and about
    ; the two things a reader would otherwise have to take on trust — that the
    ; arrow means what the token said, and that the bar covers what was active.
    ; The activity diagram, which is the only PlantUML diagram whose shape is
    ; decided by nesting rather than by anything written on a line.
    sfn testPlantUmlActivity:void (c:Checker) {
        c.section("PlantUML — activity diagrams")
        def src:string "@startuml\n"
        src = (src + "start\n")
        src = (src + ":read order;\n")
        src = (src + "partition reserve {\n")
        src = (src + ":hold stock;\n")
        src = (src + ":write ledger;\n")
        src = (src + "}\n")
        src = (src + "if (credit ok?) then\n")
        src = (src + "-> yes;\n")
        src = (src + ":charge;\n")
        src = (src + "else\n")
        src = (src + "-> no;\n")
        src = (src + ":decline;\n")
        src = (src + "endif\n")
        src = (src + ":notify;\n")
        src = (src + "stop\n")
        src = (src + "@enduml\n")

        def d:PlantUmlActivity (PlantUmlActivityReader.parse(src))
        c.eqStr("the sniff reads it as an activity diagram" (PlantUmlReader.kindOf(src)) "activity")
        ; start, six actions, the diamond, stop.
        c.eqInt("a node per statement that draws one" (d.nodeCount()) 9)
        c.eqInt("one partition" (d.groupCount()) 1)
        c.eqInt("and nothing was left unclosed" d.unbalanced 0)

        def part:PlantUmlActivityGroup (itemAt d.groups 0)
        c.eqStr("the partition keeps its name" part.name "reserve")
        c.eqInt("and the two actions written inside it" (part.memberCount()) 2)

        ; The shape of the thing: both branches of the `if` have to reach the
        ; statement after `endif`, or the diagram says the flow stops there.
        def after:string (RangerFlowTest.flowTargetOf(d "charge"))
        c.eqStr("the `then` branch carries on past the endif" after "notify")
        def other:string (RangerFlowTest.flowTargetOf(d "decline"))
        c.eqStr("and so does the `else` branch" other "notify")
        c.eqInt("a flow per step, and two out of the diamond" (d.flowCount()) 9)

        ; `-> label;` labels the flow that comes after it.
        def yes:string (RangerFlowTest.guardBetween(d "credit ok?" "charge"))
        c.eqStr("`-> yes;` lands on the branch it precedes" yes "yes")
        def no:string (RangerFlowTest.guardBetween(d "credit ok?" "decline"))
        c.eqStr("and `-> no;` on the other one" no "no")

        ; An `if` with no `else` leaves the condition itself open: false walks
        ; straight past it.
        def bare:string "@startuml\nstart\nif (busy?) then\n:wait;\nendif\n:go;\nstop\n@enduml\n"
        def bd:PlantUmlActivity (PlantUmlActivityReader.parse(bare))
        def fromDiamond:int (RangerFlowTest.flowsFrom(bd "busy?"))
        c.eqInt("an `if` with no `else` still has two ways out" fromDiamond 2)

        ; An action may run over as many lines as it likes and ends at its `;`
        ; — and a stray second `;` is a typo, not a second statement.
        def wrapped:string "@startuml\nstart\n:one line\nand another;;\nstop\n@enduml\n"
        def wd:PlantUmlActivity (PlantUmlActivityReader.parse(wrapped))
        c.eqInt("a wrapped action is one action" (wd.nodeCount()) 3)
        def act:ActivityNode (itemAt wd.act.nodes 1)
        c.eqStr("and its lines are joined" act.label "one line and another")

        ; fork/join and the loops, which are the other two shapes of nesting.
        def forked:string "@startuml\nstart\nfork\n:a;\nfork again\n:b;\nend fork\nstop\n@enduml\n"
        def fd:PlantUmlActivity (PlantUmlActivityReader.parse(forked))
        c.eqInt("a fork adds the bar and the join" (fd.nodeCount()) 6)
        def looped:string "@startuml\nstart\nwhile (more?) is (yes)\n:step;\nendwhile (no)\n:done;\nstop\n@enduml\n"
        def ld:PlantUmlActivity (PlantUmlActivityReader.parse(looped))
        def back:string (RangerFlowTest.flowTargetOf(ld "step"))
        c.eqStr("a `while` body goes back to its condition" back "more?")
        def repeated:string "@startuml\nstart\nrepeat\n:step;\nrepeat while (again?) is (yes)\n:done;\nstop\n@enduml\n"
        def rd:PlantUmlActivity (PlantUmlActivityReader.parse(repeated))
        def loop:string (RangerFlowTest.flowTargetOf(rd "again?"))
        c.eqStr("a `repeat` tests at the bottom and goes back to the top" loop "")

        ; And the drawing, which is the activity domain's.
        def g:FlowGraph (PlantUmlActivityReader.render(src))
        c.eqInt("a node per step, plus the partition's frame" (g.nodeCount()) 10)
        c.ok("the partition is drawn as a frame" (g.hasNode("__part_reserve")))
    }

    ; The label of the node an action flows into. Ids are generated, so the
    ; test asks by the words on the box.
    sfn flowTargetOf:string (d:PlantUmlActivity label:string) {
        def from:string (RangerFlowTest.activityIdOf(d label))
        if ((strlen from) == 0) {
            return ""
        }
        def i:int 0
        while (i < (array_length d.act.flows)) {
            def f:ActivityFlow (itemAt d.act.flows i)
            i = (i + 1)
            if (f.source == from) {
                return (RangerFlowTest.activityLabelOf(d f.target))
            }
        }
        return ""
    }

    sfn flowsFrom:int (d:PlantUmlActivity label:string) {
        def from:string (RangerFlowTest.activityIdOf(d label))
        def n:int 0
        def i:int 0
        while (i < (array_length d.act.flows)) {
            def f:ActivityFlow (itemAt d.act.flows i)
            i = (i + 1)
            if (f.source == from) {
                n = (n + 1)
            }
        }
        return n
    }

    sfn guardBetween:string (d:PlantUmlActivity fromLabel:string toLabel:string) {
        def from:string (RangerFlowTest.activityIdOf(d fromLabel))
        def to:string (RangerFlowTest.activityIdOf(d toLabel))
        def i:int 0
        while (i < (array_length d.act.flows)) {
            def f:ActivityFlow (itemAt d.act.flows i)
            i = (i + 1)
            if (f.source == from) {
                if (f.target == to) {
                    return f.guard
                }
            }
        }
        return ""
    }

    sfn activityIdOf:string (d:PlantUmlActivity label:string) {
        def i:int 0
        while (i < (array_length d.act.nodes)) {
            def n:ActivityNode (itemAt d.act.nodes i)
            i = (i + 1)
            if (n.label == label) {
                return n.id
            }
        }
        return ""
    }

    sfn activityLabelOf:string (d:PlantUmlActivity id:string) {
        def i:int 0
        while (i < (array_length d.act.nodes)) {
            def n:ActivityNode (itemAt d.act.nodes i)
            i = (i + 1)
            if (n.id == id) {
                return n.label
            }
        }
        return ""
    }

    ; The entity family: class, object, component, deployment, use case and
    ; ArchiMate — one grammar, six diagram types.
    ;
    ; The expected entity ids, cluster names and link endpoints below are what
    ; PlantUML 1.2025.4 reports for `fixtures/plantuml/02_class.puml` and
    ; `03_component.puml`, read off the `class="entity"`, `class="cluster"` and
    ; `class="link"` groups its own renderer writes into the SVG.
    sfn testPlantUmlEntities:void (c:Checker) {
        c.section("PlantUML — entities, links and packages")
        def src:string "@startuml\n"
        src = (src + "package \"orders\" {\n")
        src = (src + "abstract class Order {\n")
        src = (src + "+id: int\n")
        src = (src + "#placedAt: Date\n")
        src = (src + "{abstract} +total(): Money\n")
        src = (src + "}\n")
        src = (src + "class StandardOrder\n")
        src = (src + "class OrderLine\n")
        src = (src + "}\n")
        src = (src + "package \"billing\" {\n")
        src = (src + "interface Payable\n")
        src = (src + "class Invoice {\n")
        src = (src + "{static} +next(): string\n")
        src = (src + "}\n")
        src = (src + "}\n")
        src = (src + "class Customer\n")
        src = (src + "Order <|-- StandardOrder\n")
        src = (src + "Order *-- \"1..*\" OrderLine : contains\n")
        src = (src + "Customer \"1\" o-- \"many\" Order : places\n")
        src = (src + "Order ..|> Payable\n")
        src = (src + "Invoice ..> Order : bills\n")
        src = (src + "@enduml\n")

        def d:PlantUmlEntityModel (PlantUmlEntityReader.parse(src))
        c.eqStr("the sniff reads it as a class diagram" d.kind "class")
        c.eqInt("an entity per declaration" (d.entityCount()) 6)
        c.eqInt("a package per `package`" (d.groupCount()) 2)
        c.eqInt("and the members inside them" (d.memberCount()) 4)
        c.eqInt("a link per relation" (d.linkCount()) 5)

        def order:PlantUmlEntity (d.entityById("Order"))
        c.eqStr("`abstract class X` is a class, not an entity called class" order.keyword "abstract")
        c.eqStr("declared inside the package it was written in" order.parent "orders")
        c.eqInt("with its three members" (order.memberCount()) 3)
        def m0:PlantUmlMember (itemAt order.members 0)
        c.eqStr("a leading `+` is the visibility, not the name" m0.visibility "+")
        c.eqStr("the name is what follows it" m0.text "id")
        c.eqStr("and the type goes in its own column" m0.detail "int")
        def m2:PlantUmlMember (itemAt order.members 2)
        c.ok("`{abstract}` is read off the member" m2.isAbstract)
        c.ok("and parentheses make it an operation" m2.isOperation)
        def inv:PlantUmlEntity (d.entityById("Invoice"))
        def im:PlantUmlMember (itemAt inv.members 0)
        c.ok("`{static}` likewise" im.isStatic)

        def cust:PlantUmlEntity (d.entityById("Customer"))
        c.eqStr("a class declared outside every package belongs to none" cust.parent "")

        ; The ornaments. UML puts each on the end that OWNS the relationship,
        ; and an inheritance drawn the other way round says the opposite of
        ; what the author wrote.
        def inh:PlantUmlLink (itemAt d.links 0)
        c.eqStr("`<|--` is inheritance" inh.kind "inheritance")
        c.ok("with the triangle on the supertype, which is named first" inh.markAtSource)
        def comp:PlantUmlLink (itemAt d.links 1)
        c.eqStr("`*--` is composition" comp.kind "composition")
        c.eqStr("the multiplicity beside the end it was written against" comp.targetCard "1..*")
        c.eqStr("and the label after the colon" comp.label "contains")
        def agg:PlantUmlLink (itemAt d.links 2)
        c.eqStr("`o--` is aggregation" agg.kind "aggregation")
        c.eqStr("its near multiplicity read too" agg.sourceCard "1")
        c.eqStr("and its far one" agg.targetCard "many")
        def impl:PlantUmlLink (itemAt d.links 3)
        c.eqStr("`..|>` is realisation, because the line is dotted" impl.kind "implementation")
        c.ok("and it is drawn dashed" impl.dashed)
        def dep:PlantUmlLink (itemAt d.links 4)
        c.eqStr("a dotted line with a plain head is a dependency" dep.kind "dependency")

        ; The drawing: a frame per package, and no frame around a class that
        ; belongs to no package.
        def g:FlowGraph (PlantUmlEntityReader.render(src))
        c.eqInt("a node per entity, plus a frame per package" (g.nodeCount()) 8)
        c.ok("the package is drawn as a frame" (g.hasNode("__frame_orders")))
        c.ok("and so is the other one" (g.hasNode("__frame_billing")))
        def fr:FlowNode (g.nodeById("__frame_orders"))
        def loose:FlowNode (g.nodeById("Customer"))
        def frRight:double (fr.x + fr.width)
        def looseRight:double (loose.x + loose.width)
        def outsideLeft:boolean (looseRight <= fr.x)
        def outsideRight:boolean (loose.x >= frRight)
        def outside:boolean outsideLeft
        if outsideRight {
            outside = true
        }
        c.ok("a class in no package stands outside every frame" outside)

        ; A package that slides off its own contents is a box that means
        ; nothing, so the frame adopts what it was drawn around: the editor
        ; drags every node whose ancestor is selected.
        def inside:FlowNode (g.nodeById("Order"))
        c.eqStr("a class declared in a package is parented to its frame" inside.parentId "__frame_orders")
        c.eqStr("and one declared outside every package is parented to none" loose.parentId "")

        ; `FlowEditor.beginDrag` takes every node whose ancestor is selected,
        ; and `insideSelected` is the walk that decides it. With the package
        ; picked up, its classes answer yes and a class outside it does not.
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(1200.0 800.0)
        fr.selected = true
        c.ok("with the package selected, a class in it is dragged too" (ed.insideSelected(inside)))
        c.ok("and one outside it is left where it is" ((ed.insideSelected(loose)) == false))
        fr.selected = false

        ; --- and the description family, which is the same reader ---
        def csrc:string "@startuml\n"
        csrc = (csrc + "actor Customer\n")
        csrc = (csrc + "package \"edge\" {\n")
        csrc = (csrc + "[Storefront] as SF\n")
        csrc = (csrc + "}\n")
        csrc = (csrc + "node \"cluster\" {\n")
        csrc = (csrc + "[Order API] as API\n")
        csrc = (csrc + "queue \"events\" as Q\n")
        csrc = (csrc + "}\n")
        csrc = (csrc + "database \"Postgres\" as DB\n")
        csrc = (csrc + "Customer --> SF\n")
        csrc = (csrc + "SF --> API\n")
        csrc = (csrc + "API --> Q\n")
        csrc = (csrc + "API --> DB\n")
        csrc = (csrc + "@enduml\n")

        def cd:PlantUmlEntityModel (PlantUmlEntityReader.parse(csrc))
        c.eqStr("a bracket makes it a description diagram" cd.kind "description")
        c.eqInt("five entities, none of them invented" (cd.entityCount()) 5)
        c.eqInt("two containers" (cd.groupCount()) 2)
        c.eqInt("four links" (cd.linkCount()) 4)
        def sf:PlantUmlEntity (cd.entityById("SF"))
        c.eqStr("`[Storefront] as SF` puts the bracket half in the label" sf.name "Storefront")
        c.eqStr("and the alias in the id" sf.id "SF")
        c.eqStr("the bracket is the keyword when none is written" sf.keyword "component")
        c.eqStr("declared inside the package it was written in" sf.parent "edge")
        def q:PlantUmlEntity (cd.entityById("Q"))
        c.eqStr("`queue \"events\" as Q` reads the same way round" q.name "events")
        c.eqStr("a `node { }` holds entities rather than members" q.parent "cluster")

        ; The shapes, which are the only place the six diagram types differ.
        c.eqStr("a use case is an ellipse" (PlantUmlEntityReader.shapeFor("usecase")) "ellipse")
        c.eqStr("a database is a cylinder" (PlantUmlEntityReader.shapeFor("database")) "cylinder")
        c.eqStr("a component is a framed rectangle" (PlantUmlEntityReader.shapeFor("component")) "predefined")
        c.eqStr("an actor is a stadium" (PlantUmlEntityReader.shapeFor("actor")) "stadium")

        ; `left to right direction` turns the page on its side.
        def lrsrc:string "@startuml\nleft to right direction\nactor U\nU --> (Buy)\n@enduml\n"
        def lr:PlantUmlEntityModel (PlantUmlEntityReader.parse(lrsrc))
        c.eqStr("`left to right direction` is obeyed" lr.direction "LR")
        def uc:PlantUmlEntity (lr.entityById("Buy"))
        c.eqStr("a parenthesised name is a use case" uc.keyword "usecase")

        ; The link scanner, one token at a time.
        c.eqStr("`<|--` is inheritance" (PlantUmlEntityReader.kindOf("<|--")) "inheritance")
        c.eqStr("`<|..` is realisation" (PlantUmlEntityReader.kindOf("<|..")) "implementation")
        c.eqStr("`*--` is composition" (PlantUmlEntityReader.kindOf("*--")) "composition")
        c.eqStr("`--o` is aggregation" (PlantUmlEntityReader.kindOf("--o")) "aggregation")
        c.eqStr("`..>` is a dependency" (PlantUmlEntityReader.kindOf("..>")) "dependency")
        c.eqStr("`--` on its own is an association" (PlantUmlEntityReader.kindOf("--")) "association")
        c.eqInt("a hyphen inside a name is not a link" (PlantUmlEntityReader.linkAt("order-service")) -1)
        c.eqStr("a direction hint is read past, not tripped over" (PlantUmlEntityReader.linkToken("A -up-> B" 2)) "-up->")
        c.eqStr("and so is a colour" (PlantUmlEntityReader.linkToken("A -[#red]-> B" 2)) "-[#red]->")
    }

    ; ------------------------------------------------------------ PlantUML --
    ; What an `@startuml` body turns out to be.
    ;
    ; The expected answers are not opinions: each was asked of PlantUML
    ; 1.2025.4 as a two-line file and read off the `data-diagram-type` its own
    ; renderer writes into the SVG. See docs/PLAN_PLANTUML.md §3.
    ; ----------------------------------------------------------- Graphviz ---
    ; The grammar, in the places it is easy to get wrong. Every expectation
    ; here was checked against Graphviz itself first — the standing version is
    ; `docs/GRAPHVIZ_PARITY.md`, regenerated from the same corpus.
    sfn testDotGrammar:void (c:Checker) {
        c.section("Graphviz DOT — the grammar")

        def src:string "strict digraph stack {\n"
        src = (src + "  rankdir = LR;\n")
        src = (src + "  subgraph cluster_core {\n")
        src = (src + "    label = \"core\";\n")
        src = (src + "    Web [shape=box];\n")
        src = (src + "    API;\n")
        src = (src + "  }\n")
        src = (src + "  DB [shape=cylinder, label=\"Postgres\"];\n")
        src = (src + "  Web -> API [label=\"http\"];\n")
        src = (src + "  API -> DB;\n")
        src = (src + "  API -> DB;\n")
        src = (src + "}\n")

        def d:DotGraph (DotReader.parse(src))
        c.ok("it reads" d.ok)
        c.eqStr("the graph keeps its name" d.name "stack")
        c.ok("a digraph is directed" d.directed)
        c.ok("`strict` is remembered" d.strict)
        c.eqStr("`rankdir=LR` is the layout direction" (d.direction()) "LR")
        c.eqInt("a node per name, in order" (d.nodeCount()) 3)
        c.eqInt("`strict` collapses the repeated edge" (d.edgeCount()) 2)
        c.eqInt("one subgraph" (d.subgraphCount()) 1)
        c.eqInt("and it is a cluster" (d.clusterCount()) 1)
        def core:DotSubgraph (itemAt d.subgraphs 0)
        c.eqInt("with the two nodes declared inside it" (core.memberCount()) 2)
        c.eqStr("its label is its own attribute" (?? (get core.attrs "label") "") "core")
        def db:DotNode (d.nodeById("DB"))
        c.eqStr("a quoted label keeps its spaces" (db.attr("label")) "Postgres")

        ; An edge chain is one statement and several edges, and the attribute
        ; list at the end belongs to all of them.
        def chain:string "digraph { a -> b -> c [color=red] }"
        def cd:DotGraph (DotReader.parse(chain))
        c.eqInt("a chain is one edge per arrow" (cd.edgeCount()) 2)
        def first:DotEdge (itemAt cd.edges 0)
        def second:DotEdge (itemAt cd.edges 1)
        c.eqStr("the chain's attributes reach the first edge" (first.attr("color")) "red")
        c.eqStr("…and the last" (second.attr("color")) "red")

        ; A subgraph at either end of an edge connects every node in it.
        def cross:string "digraph { {a b} -> {c d} }"
        def xd:DotGraph (DotReader.parse(cross))
        c.eqInt("subgraph to subgraph is every pair" (xd.edgeCount()) 4)

        ; An undirected graph has its own operator, and `strict` there has no
        ; ends to tell apart.
        def un:string "strict graph { a -- b; b -- a }"
        def ud:DotGraph (DotReader.parse(un))
        c.ok("a graph is undirected" (ud.directed == false))
        c.eqInt("and an undirected pair is the same pair either way round" (ud.edgeCount()) 1)

        ; The quoting rules: concatenation, escapes, and a continued line.
        def q:string "digraph { n [label=\"a\" + \"b\"]; m [label=\"x \\\ny\"] }"
        def qd:DotGraph (DotReader.parse(q))
        def n1:DotNode (qd.nodeById("n"))
        c.eqStr("`+` concatenates two quoted strings" (n1.attr("label")) "ab")
        def m1:DotNode (qd.nodeById("m"))
        c.eqStr("a backslash before a newline continues the line" (m1.attr("label")) "x y")

        ; Comments, in all three spellings, and a `#` line marker.
        def cm:string "# a line marker\ndigraph { // one\n /* two */ a -> b }"
        def cmd:DotGraph (DotReader.parse(cm))
        c.ok("comments and line markers are skipped" cmd.ok)
        c.eqInt("and leave the graph they surround alone" (cmd.edgeCount()) 1)

        ; Ports and compass points, which is the one ambiguity in the grammar:
        ; one field that reads as a compass point IS one.
        def pt:string "digraph { a:p:e -> b:w }"
        def ptd:DotGraph (DotReader.parse(pt))
        def pe:DotEdge (itemAt ptd.edges 0)
        c.eqStr("`a:p:e` is a port and a compass point" pe.tailPort "p")
        c.eqStr("…with the compass read as one" pe.tailCompass "e")
        c.eqStr("`b:w` on its own is a compass point, not a port" pe.headPort "")
        c.eqStr("…which is where the edge lands" pe.headCompass "w")
    }

    ; `node [...]` reaches forward, not back, and not into a sibling subgraph.
    ; Graphviz resolves it exactly so, which is the answer `-Tjson0` prints and
    ; the parity harness compares against.
    sfn testDotDefaults:void (c:Checker) {
        c.section("Graphviz DOT — attribute defaults are scoped and ordered")
        def src:string "digraph {\n"
        src = (src + "  node [shape=box, style=filled];\n")
        src = (src + "  a;\n")
        src = (src + "  node [shape=circle];\n")
        src = (src + "  b;\n")
        src = (src + "  subgraph s { node [color=red]; c }\n")
        src = (src + "  d;\n")
        src = (src + "}\n")
        def d:DotGraph (DotReader.parse(src))
        def a:DotNode (d.nodeById("a"))
        def b:DotNode (d.nodeById("b"))
        def cc:DotNode (d.nodeById("c"))
        def dd:DotNode (d.nodeById("d"))
        c.eqStr("a node keeps the default in force when it was declared" (a.attr("shape")) "box")
        c.eqStr("a later default does not reach back for it" (b.attr("shape")) "circle")
        c.eqStr("a default set earlier is still in force" (b.attr("style")) "filled")
        c.eqStr("a subgraph inherits what is outside it" (cc.attr("shape")) "circle")
        c.eqStr("and adds its own" (cc.attr("color")) "red")
        c.eqStr("which does not escape it" (dd.attr("color")) "")

        ; The repeated attribute list, which is in the grammar and which one of
        ; the two pure-JS DOT parsers measured in GRAPHVIZ_BENCH.md refuses.
        def two:string "digraph { a [color=red] [shape=box]; a -> b [weight=4][minlen=2] }"
        def td:DotGraph (DotReader.parse(two))
        def ta:DotNode (td.nodeById("a"))
        c.eqStr("two attribute lists in a row, first" (ta.attr("color")) "red")
        c.eqStr("…and second" (ta.attr("shape")) "box")
        def te:DotEdge (itemAt td.edges 0)
        c.eqStr("the same on an edge" (te.attr("weight")) "4")
        c.eqStr("…and its neighbour" (te.attr("minlen")) "2")
    }

    ; A file Graphviz refuses must be refused here too. A reader that reads one
    ; happily has invented syntax, and that is the failure a reader of somebody
    ; else's file cannot see.
    sfn testDotRefusals:void (c:Checker) {
        c.section("Graphviz DOT — what must be refused")
        def dangling:DotGraph (DotReader.parse("digraph { a -> }"))
        c.ok("a dangling edge is refused" (dangling.ok == false))
        def wrongOp:DotGraph (DotReader.parse("digraph { a -- b }"))
        c.ok("`--` in a digraph is refused" (wrongOp.ok == false))
        def wrongOp2:DotGraph (DotReader.parse("graph { a -> b }"))
        c.ok("`->` in a graph is refused" (wrongOp2.ok == false))
        def unclosed:DotGraph (DotReader.parse("digraph { a -> b"))
        c.ok("an unclosed graph is refused" (unclosed.ok == false))
        ; The published grammar has no bare `subgraph name`; two of the four
        ; DOT parsers benchmarked in GRAPHVIZ_BENCH.md accept it anyway.
        def ref:DotGraph (DotReader.parse("digraph { subgraph s { a } subgraph s -> b }"))
        c.ok("a bare subgraph reference is refused" (ref.ok == false))
        def notDot:DotGraph (DotReader.parse("flowchart TD\n a --> b"))
        c.ok("a Mermaid flowchart is not a DOT graph" (notDot.ok == false))
        c.ok("and a refusal says which line" (dangling.errorLine > 0))
    }

    ; And the drawing: shapes, clusters as frames, and the default that is not
    ; a rectangle.
    sfn testDotFlow:void (c:Checker) {
        c.section("Graphviz DOT — the drawing")
        def src:string "digraph {\n"
        src = (src + "  subgraph cluster_a { label=\"A\"; x; y }\n")
        src = (src + "  z [shape=diamond];\n")
        src = (src + "  x -> y;\n")
        src = (src + "  y -> z;\n")
        src = (src + "}\n")
        def d:DotGraph (DotReader.parse(src))
        def style (new FlowStyle)
        def g:FlowGraph (DotFlow.build(d style))
        c.eqInt("a node per node, plus a frame for the cluster" (g.nodeCount()) 4)
        c.eqInt("an edge per edge" (g.edgeCount()) 2)
        def x:FlowNode (g.nodeById("x"))
        c.eqStr("Graphviz's default node is an ellipse, not a box" x.shape "ellipse")
        def z:FlowNode (g.nodeById("z"))
        c.eqStr("and a shape it names is the shape drawn" z.shape "diamond")
        def frame:FlowNode (g.nodeById("__cluster_cluster_a"))
        c.eqStr("the frame is a group" frame.nodeType "group")
        c.eqStr("and carries the cluster's label" frame.label "A")
        def inside:boolean true
        if ((z.x + z.width) <= frame.x) {
            inside = false
        }
        if (z.x >= (frame.x + frame.width)) {
            inside = false
        }
        if ((z.y + z.height) <= frame.y) {
            inside = false
        }
        if (z.y >= (frame.y + frame.height)) {
            inside = false
        }
        c.ok("a node in no cluster stands outside the frame" (inside == false))
    }

    ; A record label is a box language, an HTML label is a table, and both are
    ; trees of cells with ports an edge can aim at.
    sfn testDotRecords:void (c:Checker) {
        c.section("Graphviz DOT — record and HTML labels")

        ; `rankdir=TB` runs the top level across the page; every brace flips it.
        def rec:DotRecordLabel (DotRecordLabel.parse("<id> id | <cust> customer | <total> total" true))
        c.ok("a record label reads" rec.ok)
        c.eqInt("a field per `|`" (rec.cellCount()) 3)
        c.eqInt("and a port per `<name>`" (array_length (rec.ported())) 3)
        def cells:[DotCell] (rec.leaves())
        def first:DotCell (itemAt cells 0)
        c.eqStr("the port is the name in the angle brackets" first.port "id")
        c.eqStr("and the text is what is left, trimmed" first.text "id")

        def nested:DotRecordLabel (DotRecordLabel.parse("a | { b | c } | d" true))
        c.eqInt("a brace is one field made of several" (nested.cellCount()) 4)
        c.ok("the top level runs across the page" nested.root.across)
        def middle:DotCell (itemAt nested.root.kids 1)
        c.ok("and a brace flips the axis" (middle.across == false))

        ; Measured bottom-up, placed top-down into whatever the layout gave.
        nested.measure()
        c.ok("a measured record has a size" (nested.root.w > 0.0))
        nested.place(10.0 20.0 300.0 60.0)
        def leaves:[DotCell] (nested.leaves())
        def a:DotCell (itemAt leaves 0)
        c.near("the first cell starts where the record does" a.x 10.0 0.001)
        def last:DotCell (itemAt leaves 3)
        def right:double (last.x + last.w)
        c.near("and the last one ends where it ends" right 310.0 0.001)
        def bc:DotCell (itemAt leaves 1)
        def cc:DotCell (itemAt leaves 2)
        c.ok("the cells inside a brace are stacked, not side by side" (cc.y > bc.y))

        ; The escapes a record label has of its own.
        def esc:DotRecordLabel (DotRecordLabel.parse("a \\| b | c" true))
        c.eqInt("an escaped bar is text, not a separator" (esc.cellCount()) 2)

        ; And the other language, which means the same thing.
        def html:string "<TABLE><TR><TD PORT=\"l\">left</TD><TD>right</TD></TR><TR><TD><B>below</B></TD></TR></TABLE>"
        c.ok("a table is recognised as one" (DotHtmlLabel.isTable(html)))
        def tab:DotRecordLabel (DotHtmlLabel.parse(html))
        c.eqInt("a cell per TD" (tab.cellCount()) 3)
        c.eqInt("a port per PORT attribute" (array_length (tab.ported())) 1)
        def tcells:[DotCell] (tab.leaves())
        def t0:DotCell (itemAt tcells 0)
        c.eqStr("the port is read out of the tag" t0.port "l")
        def t2:DotCell (itemAt tcells 2)
        c.eqStr("and the markup inside a cell is taken out of its text" t2.text "below")
        c.ok("rows are stacked" (tab.root.across == false))

        ; A label that is HTML but not a table is a label with its tags gone.
        c.ok("markup that is not a table is not one" ((DotHtmlLabel.isTable("<B>bold</B>")) == false))

        ; --- and the drawing: cells, ports, and an edge that lands on one ---
        def src:string "digraph {\n"
        src = (src + "  rankdir = LR;\n")
        src = (src + "  order [shape=record, label=\"<id> id | <cust> customer\"];\n")
        src = (src + "  customer [shape=record, label=\"<id> id | name\"];\n")
        src = (src + "  order:cust:e -> customer:id:w;\n")
        src = (src + "}\n")
        def d:DotGraph (DotReader.parse(src))
        c.ok("the graph reads" d.ok)
        def style (new FlowStyle)
        def g:FlowGraph (DotFlow.build(d style))
        c.eqInt("two records are two nodes and four cells" (g.nodeCount()) 6)
        def cell0:FlowNode (g.nodeById("order::1"))
        c.eqStr("a cell is drawn with the field's text" cell0.label "customer")
        c.eqStr("and belongs to the record, so a drag takes it along" cell0.parentId "order")
        def e:FlowEdge (g.edgeAt(0))
        c.eqStr("the edge leaves the field it named" e.sourcePort "order:cust@1")
        c.eqStr("and arrives at the one it named" e.targetPort "customer:id@3")
        ; `:e` is the right-hand side, `:w` the left, and the endpoint is
        ; opposite the CELL rather than the middle of the node.
        def sy:double (g.endpointY(e true))
        def owner:FlowNode (g.nodeById("order"))
        def cellNode:FlowNode (g.nodeById("order::1"))
        def mid:double (cellNode.y + (cellNode.height * 0.5))
        c.near("the line leaves opposite its own cell" sy mid 0.6)
        def sx:double (g.endpointX(e true))
        c.near("on the side the compass named" sx (owner.x + owner.width) 0.6)
    }

    ; The colour table is generated by asking Graphviz; this is the check that
    ; the generated file is present and says what it measured.
    sfn testDotColors:void (c:Checker) {
        c.section("Graphviz DOT — the colours, as Graphviz reported them")
        def p (new DotPalette)
        c.eqStr("a name out of the X11 table" (p.resolve("cornflowerblue")) "#6495ed")
        c.eqStr("a numbered shade" (p.resolve("red3")) "#cd0000")
        c.eqStr("one of the hundred and one greys" (p.resolve("gray37")) "#5e5e5e")
        c.eqStr("a name in capitals is the same name" (p.resolve("SteelBlue")) "#4682b4")
        c.eqStr("six hex digits pass through" (p.resolve("#ffcc00")) "#ffcc00")
        c.eqStr("three are the short form of six" (p.resolve("#fc0")) "#ffcc00")
        c.eqStr("an alpha channel nothing can paint is dropped" (p.resolve("#ffcc0080")) "#ffcc00")
        c.eqStr("a scheme prefix names the same colour" (p.resolve("/x11/palegreen")) "#98fb98")
        c.eqStr("a gradient is drawn in its first colour" (p.resolve("yellow:blue")) "#ffff00")
        c.eqStr("a weighted gradient too" (p.resolve("yellow;0.3:blue")) "#ffff00")
        c.eqStr("a name Graphviz does not know is left to the theme" (p.resolve("notacolour")) "")
        ; Hue, saturation and value, which Graphviz computes rather than looks
        ; up — and so does this.
        c.eqStr("black by hsv" (p.resolve("0 0 0")) "#000000")
        c.eqStr("white by hsv" (p.resolve("0 0 1")) "#ffffff")
        c.eqStr("red by hsv" (p.resolve("0 1 1")) "#ff0000")
        c.eqStr("and a comma is a separator like a space" (p.resolve("0,1,1")) "#ff0000")
        c.ok("the table is the measured one, not a handful" ((p.names.count()) > 600))
    }

    ; `layout=` is not decoration: it says which kind of drawing this is. And
    ; `pos="x,y!"` says where a node goes, in a coordinate system whose y axis
    ; points the other way from a screen's.
    sfn testDotEngines:void (c:Checker) {
        c.section("Graphviz DOT — the layout attribute")

        ; A force drawing: no ranks, so no two nodes share an x or a y the way
        ; a layered one puts a whole row on the same line.
        def fsrc:string "graph {\n"
        fsrc = (fsrc + "  layout = neato;\n")
        fsrc = (fsrc + "  a -- b; b -- c; c -- a; c -- d; d -- a;\n")
        fsrc = (fsrc + "}\n")
        def fd:DotGraph (DotReader.parse(fsrc))
        def style (new FlowStyle)
        def fg:FlowGraph (DotFlow.build(fd style))
        c.eqInt("every node is placed" (fg.nodeCount()) 4)
        def spread:FlowRect (fg.bounds())
        c.ok("a force layout spreads in both directions" (spread.w > 0.0))
        c.ok("…both of them" (spread.h > 0.0))
        def anyEdge:FlowEdge (fg.edgeAt(0))
        c.eqStr("and its lines are straight, not orthogonal" anyEdge.edgeType "straight")

        ; `pos="x,y!"` pins. DOT's y axis points up, a screen's points down, so
        ; a node the file put higher has the smaller y here.
        def psrc:string "graph {\n"
        psrc = (psrc + "  layout = neato;\n")
        psrc = (psrc + "  a [pos=\"0,0!\"];\n")
        psrc = (psrc + "  b [pos=\"200,100!\"];\n")
        psrc = (psrc + "  a -- b;\n")
        psrc = (psrc + "}\n")
        def pd:DotGraph (DotReader.parse(psrc))
        def pg:FlowGraph (DotFlow.build(pd style))
        def pa:FlowNode (pg.nodeById("a"))
        def pb:FlowNode (pg.nodeById("b"))
        ; `pos` names the node's centre, which is not the corner the renderer
        ; places it by.
        c.near("a pinned node stays where the file put it" (pa.centerX()) 0.0 0.001)
        c.near("…in x" (pb.centerX()) 200.0 0.001)
        c.near("and y is flipped, because DOT counts upwards" (pb.centerY()) -100.0 0.001)
        c.ok("a pinned node is pinned for the simulation too" pa.hasFx)

        ; `twopi` is a root with rings around it.
        def rsrc:string "digraph {\n"
        rsrc = (rsrc + "  layout = twopi;\n")
        rsrc = (rsrc + "  root = keskus;\n")
        rsrc = (rsrc + "  keskus -> a; keskus -> b; keskus -> c;\n")
        rsrc = (rsrc + "  a -> a1; b -> b1;\n")
        rsrc = (rsrc + "}\n")
        def rd:DotGraph (DotReader.parse(rsrc))
        def rg:FlowGraph (DotFlow.build(rd style))
        c.eqInt("a node per node" (rg.nodeCount()) 6)
        def centre:FlowNode (rg.nodeById("keskus"))
        def leaf:FlowNode (rg.nodeById("a1"))
        def dc:double ((fabs centre.x) + (fabs centre.y))
        def dl:double ((fabs (leaf.x - centre.x)) + (fabs (leaf.y - centre.y)))
        c.ok("and the leaves are further out than the root" (dl > 0.0))

        ; An engine RangerFlow has nothing for is the layered one rather than
        ; nothing at all.
        def osrc:DotGraph (DotReader.parse("digraph { layout = osage; a -> b }"))
        def og:FlowGraph (DotFlow.build(osrc style))
        c.eqInt("an engine with no counterpart still draws" (og.nodeCount()) 2)

        ; `nodesep` and `ranksep` are inches — seventy-two points to one.
        def gsrc:DotGraph (DotReader.parse("digraph { ranksep=2.0; a -> b }"))
        def gg:FlowGraph (DotFlow.build(gsrc style))
        def ga:FlowNode (gg.nodeById("a"))
        def gb:FlowNode (gg.nodeById("b"))
        c.ok("a ranksep in inches is points on the page" ((gb.y - ga.y) > 140.0))

        ; --- and the rest of what a style attribute says ---
        def ssrc:string "digraph {\n"
        ssrc = (ssrc + "  a [style=\"filled,rounded\", penwidth=3, fontsize=21];\n")
        ssrc = (ssrc + "  b [style=bold];\n")
        ssrc = (ssrc + "  a -> b [penwidth=4];\n")
        ssrc = (ssrc + "}\n")
        def sd:DotGraph (DotReader.parse(ssrc))
        def sg:FlowGraph (DotFlow.build(sd style))
        def sa:FlowNode (sg.nodeById("a"))
        def sb:FlowNode (sg.nodeById("b"))
        c.near("`penwidth` is the border weight" sa.borderWidth 3.0 0.001)
        c.near("`style=bold` is a border weight too" sb.borderWidth 2.0 0.001)
        c.near("`fontsize` is a ratio against the theme's own" sa.fontScale 1.5 0.001)
        c.ok("`rounded` rounds the corners" (sa.borderRadius > 0.0))
        c.near("and a node that did not ask for it gets Graphviz's square ones" sb.borderRadius 0.0 0.001)
        def se:FlowEdge (sg.edgeAt(0))
        c.near("an edge has a pen too" se.strokeWidth 4.0 0.001)

        ; `COLSPAN` is spent as a share of the row rather than by merging.
        def span:DotRecordLabel (DotHtmlLabel.parse("<TABLE><TR><TD>a</TD><TD>b</TD></TR><TR><TD COLSPAN=\"2\">wide</TD></TR></TABLE>"))
        def wide:DotCell (itemAt (span.leaves()) 2)
        c.eqInt("the span is read off the tag" wide.span 2)
        span.measure()
        c.ok("and a spanning cell asks for more of the row" (wide.w > 60.0))
    }

    sfn testPlantUmlKinds:void (c:Checker) {
        c.section("PlantUML — which diagram is this")

        def bare:string "@startuml\nA --> B\n@enduml\n"
        c.eqStr("a bare arrow is a message, as PlantUML reads it" (PlantUmlReader.kindOf(bare)) "sequence")

        def assoc:string "@startuml\nA -- B\n@enduml\n"
        c.eqStr("a line with no head on it is an association" (PlantUmlReader.kindOf(assoc)) "class")

        def comp:string "@startuml\n[Web] --> [API]\n@enduml\n"
        c.eqStr("a bracket is a component" (PlantUmlReader.kindOf(comp)) "description")

        def uc:string "@startuml\nactor User\nUser --> (Buy)\n@enduml\n"
        c.eqStr("`actor` alone does not make it a sequence diagram" (PlantUmlReader.kindOf(uc)) "description")

        def cls:string "@startuml\nA -> B: x\nclass C\n@enduml\n"
        c.eqStr("one `class` outweighs a message" (PlantUmlReader.kindOf(cls)) "class")

        def st:string "@startuml\n[*] --> Idle\nIdle --> Busy : go\n@enduml\n"
        c.eqStr("`[*]` belongs to nothing but a state machine" (PlantUmlReader.kindOf(st)) "state")

        def act:string "@startuml\nstart\n:read order;\nstop\n@enduml\n"
        c.eqStr("`start` and a `:action;` are an activity" (PlantUmlReader.kindOf(act)) "activity")

        def seq:string "@startuml\nparticipant A\nA -> B: x\n@enduml\n"
        c.eqStr("and a declared participant settles it" (PlantUmlReader.kindOf(seq)) "sequence")

        ; The `@start` words that commit a file before a line is read.
        c.eqStr("`@startmindmap` needs no sniffing" (PlantUmlReader.openerKind("@startmindmap")) "mindmap")
        c.eqStr("nor does `@startgantt`" (PlantUmlReader.openerKind("@startgantt")) "gantt")
        c.eqStr("`@startsalt` and `@startwire` are the same diagram" (PlantUmlReader.openerKind("@startwire")) "salt")
        c.eqStr("`@startuml` commits to nothing" (PlantUmlReader.openerKind("@startuml")) "")
        ; Recognised and refused, rather than read as entities: a ditaa block
        ; parsed as a component diagram is a page of invented boxes.
        c.eqStr("ditaa is named so it cannot fall through" (PlantUmlReader.openerKind("@startditaa")) "ditaa")
        c.ok("and it is not one this reader draws" ((PlantUmlReader.draws("ditaa")) == false))
        c.ok("the sequence diagram is" (PlantUmlReader.draws("sequence")))

        ; Comments, in both spellings, and the preprocessor.
        def cmt:string "@startuml\n' a whole line\nA -> B: x /' and a tail '/\n!include foo.puml\n@enduml\n"
        def doc:PlantUmlSource (PlantUmlReader.read(cmt))
        c.eqInt("a `'` line and a `/' … '/` tail leave one statement" (doc.lineCount()) 1)
        c.eqInt("and the `!include` is counted where it was dropped" (doc.directiveCount()) 1)

        def multi:string "@startuml\nA -> B: one\n@enduml\n@startuml\nC -> D: two\n@enduml\n"
        def first:PlantUmlSource (PlantUmlReader.read(multi))
        c.eqInt("a file with two diagrams in it gives up the first" (first.lineCount()) 1)

        def titled:string "@startuml\ntitle **Order** checkout\nA -> B: x\n@enduml\n"
        def td:PlantUmlSource (PlantUmlReader.read(titled))
        c.eqStr("the title is taken, and its Creole markers are not drawn" td.title "Order checkout")
    }

    sfn testPlantUmlSequence:void (c:Checker) {
        c.section("PlantUML sequence diagrams")
        def src:string "@startuml\n"
        src = (src + "title Checkout\n")
        src = (src + "autonumber\n")
        src = (src + "actor \"The Customer\" as Cust\n")
        src = (src + "box Shop\n")
        src = (src + "participant Web\n")
        src = (src + "participant API as \"Order API\"\n")
        src = (src + "end box\n")
        src = (src + "database Bank\n")
        src = (src + "Cust -> Web: place order\n")
        src = (src + "Web ->> API ++ : POST /orders\n")
        src = (src + "API -> API: validate\n")
        src = (src + "API -->> Web -- : 201\n")
        src = (src + "note over Web, API: nothing is paid yet\n")
        src = (src + "loop until settled\n")
        src = (src + "Web -[#red]> Bank: authorise\n")
        src = (src + "alt accepted\n")
        src = (src + "Bank --> Web: approved\n")
        src = (src + "else declined\n")
        src = (src + "Bank ->x Web: no\n")
        src = (src + "end\n")
        src = (src + "end\n")
        src = (src + "destroy Bank\n")
        src = (src + "Web <- Cust: receipt\n")
        src = (src + "@enduml\n")

        def d:SeqDiagram (PlantUmlSequenceReader.parse(src))
        c.eqStr("the title comes off the `title` line" d.title "Checkout")
        c.eqInt("a participant per declaration, in the order declared" (d.actorCount()) 4)
        def cust:SeqActor (itemAt d.actors 0)
        c.eqStr("`\"name\" as id` puts the quoted half in the label" cust.name "The Customer")
        c.eqStr("and the bare half in the id" cust.id "Cust")
        c.ok("`actor` is remembered as one" cust.isActor)
        def api:SeqActor (itemAt d.actors 2)
        c.eqStr("`id as \"name\"` is the same declaration written backwards" api.name "Order API")
        c.eqStr("with the id still the bare half" api.id "API")
        c.eqStr("a participant declared inside a box knows which" api.box "Shop")
        def bank:SeqActor (itemAt d.actors 3)
        c.eqStr("one declared after `end box` does not" bank.box "")
        c.eqInt("the box is counted once" (d.boxCount()) 1)
        c.ok("`autonumber` numbers the messages" d.autonumber)

        c.eqInt("every arrow is a message" (d.messageCount()) 8)
        c.eqInt("and the note is not one" (d.noteCount()) 1)
        c.eqInt("`loop` and `alt` are the two blocks" (d.blockCount()) 2)

        def first:SeqStep (itemAt d.steps 0)
        c.eqStr("the sender is what stands before the arrow" first.source "Cust")
        c.eqStr("the receiver what stands after it" first.target "Web")
        c.eqStr("and the text what follows the colon" first.text "place order")
        c.eqInt("numbering starts at one" first.number 1)
        c.eqStr("`->` carries a filled head" first.head "arrowclosed")
        c.eqStr("and a single dash is not a reply" first.stroke "solid")

        def second:SeqStep (itemAt d.steps 1)
        c.ok("`++` after the arrow activates the receiver" second.activates)
        c.eqStr("`->>` is the open head" second.head "arrow")
        def selfCall:SeqStep (itemAt d.steps 2)
        c.eqStr("a participant may send to itself" selfCall.source selfCall.target)
        def reply:SeqStep (itemAt d.steps 3)
        c.eqStr("two dashes make it a reply" reply.stroke "dotted")
        c.ok("and `--` after it deactivates the sender" reply.deactivates)

        def note:SeqStep (itemAt d.steps 4)
        c.eqStr("`over A, B` spans from the first name" note.source "Web")
        c.eqStr("to the last one named" note.target "API")
        c.eqStr("and it is placed over rather than beside" note.placement "over")

        ; A backwards arrow is the same message written the other way round,
        ; and a diagram that drew it as it was typed would reverse the story.
        def backwards:SeqStep (itemAt d.steps ((d.stepCount()) - 1))
        c.eqStr("`A <- B` sends from B" backwards.source "Cust")
        c.eqStr("to A" backwards.target "Web")

        ; The tokens, one at a time, because a diagram that draws `->x` as a
        ; plain arrow is telling the reader the message arrived.
        c.eqStr("`->x` is a cross" (PlantUmlSequenceReader.headOf("->x")) "cross")
        c.eqStr("`->>` is the open head" (PlantUmlSequenceReader.headOf("->>")) "arrow")
        c.eqStr("`->` is the filled one" (PlantUmlSequenceReader.headOf("->")) "arrowclosed")
        c.eqStr("`-->` is dotted" (PlantUmlSequenceReader.strokeOf("-->")) "dotted")
        c.eqStr("`->` is not" (PlantUmlSequenceReader.strokeOf("->")) "solid")
        c.eqStr("the colour comes out of the arrow" (PlantUmlSequenceReader.dropColour("A -[#red]> B")) "A -> B")
        c.eqInt("a name with a dash in it is not an arrow" (PlantUmlSequenceReader.arrowAt("order-service is here")) -1)

        ; `return` replies to whoever called, and to nobody when nobody did.
        def rsrc:string "@startuml\nA -> B ++ : ask\nreturn answer\n@enduml\n"
        def rd:SeqDiagram (PlantUmlSequenceReader.parse(rsrc))
        c.eqInt("`return` is a message of its own" (rd.messageCount()) 2)
        def ret:SeqStep (itemAt rd.steps 1)
        c.eqStr("sent back by the one that was called" ret.source "B")
        c.eqStr("to the one that called it" ret.target "A")
        c.eqStr("dotted, because a reply is" ret.stroke "dotted")
        c.ok("and it closes the activation it replies out of" ret.deactivates)

        ; The multi-line note, which runs until `end note`.
        def nsrc:string "@startuml\nA -> B: x\nnote right of B\nfirst line\nsecond line\nend note\n@enduml\n"
        def nd:SeqDiagram (PlantUmlSequenceReader.parse(nsrc))
        c.eqInt("a note may run over several lines" (nd.noteCount()) 1)
        def nstep:SeqStep (itemAt nd.steps 1)
        c.eqStr("and keeps the breaks the author typed" nstep.text "first line\nsecond line")
        c.eqStr("beside the participant it was pinned to" nstep.source "B")
        c.eqStr("on the side it was put" nstep.placement "right")

        ; And the drawing, which is the shared one in core/.
        def g:FlowGraph (PlantUmlSequenceReader.render(src))
        def wl:FlowNode (g.nodeById("ll-Web"))
        def al:FlowNode (g.nodeById("ll-API"))
        c.ok("the columns are in declaration order, left to right" (wl.x < al.x))
        def head:FlowNode (g.nodeById("Cust"))
        c.eqStr("the participant box is drawn from the alias" head.label "The Customer")
        c.eqInt("an arrow per message" (g.edgeCount()) 8)
    }

    sfn testMermaidSequence:void (c:Checker) {
        c.section("Mermaid sequence diagrams")
        def src:string "sequenceDiagram\n"
        src = (src + "    autonumber\n")
        src = (src + "    actor Cust as Customer\n")
        src = (src + "    box Shop\n")
        src = (src + "        participant Web\n")
        src = (src + "        participant API as Order API\n")
        src = (src + "    end\n")
        src = (src + "    participant Bank\n")
        src = (src + "    Cust->>Web: place order\n")
        src = (src + "    Web->>+API: POST /orders\n")
        src = (src + "    API->>API: validate\n")
        src = (src + "    API-->>-Web: 201\n")
        src = (src + "    Note over Web,API: nothing is paid yet\n")
        src = (src + "    loop until settled\n")
        src = (src + "        Web-)Bank: authorise\n")
        src = (src + "    alt accepted\n")
        src = (src + "        Bank-->>Web: approved\n")
        src = (src + "    else declined\n")
        src = (src + "        Bank--xWeb: no\n")
        src = (src + "    end\n")
        src = (src + "    end\n")
        src = (src + "    destroy Bank\n")
        src = (src + "    Web->>Cust: receipt\n")

        def d:SeqDiagram (MermaidSequenceReader.parse(src))
        c.eqInt("a participant per declaration, in the order declared" (d.actorCount()) 4)
        def cust:SeqActor (itemAt d.actors 0)
        c.eqStr("`as` renames without renumbering" cust.name "Customer")
        c.ok("and `actor` is remembered as one" cust.isActor)
        def api:SeqActor (itemAt d.actors 2)
        c.eqStr("a participant declared inside a box knows which" api.box "Shop")
        def bank:SeqActor (itemAt d.actors 3)
        c.eqStr("one declared outside it does not" bank.box "")
        c.eqInt("the box is counted once" (d.boxCount()) 1)
        c.ok("`autonumber` numbers the messages" d.autonumber)

        c.eqInt("every arrow is a message" (d.messageCount()) 8)
        c.eqInt("and the note is not one" (d.noteCount()) 1)
        c.eqInt("`loop` and `alt` are the two blocks" (d.blockCount()) 2)

        def first:SeqStep (itemAt d.steps 0)
        c.eqStr("the sender is what stands before the arrow" first.source "Cust")
        c.eqStr("the receiver what stands after it" first.target "Web")
        c.eqStr("and the text what follows the colon" first.text "place order")
        c.eqInt("numbering starts at one" first.number 1)
        c.eqStr("`->>` is a line with a head on it" first.head "arrowclosed")
        c.eqStr("and a single dash is not a reply" first.stroke "solid")

        def second:SeqStep (itemAt d.steps 1)
        c.ok("`+` after the arrow activates the receiver" second.activates)
        def selfCall:SeqStep (itemAt d.steps 2)
        c.eqStr("a participant may send to itself" selfCall.source selfCall.target)
        def reply:SeqStep (itemAt d.steps 3)
        c.eqStr("`-->>` is the dotted one" reply.stroke "dotted")
        c.ok("and `-` after it deactivates the sender" reply.deactivates)

        def note:SeqStep (itemAt d.steps 4)
        c.eqStr("`over A,B` spans from the first name to the last" note.source "Web")
        c.eqStr("to the last one named" note.target "API")
        c.eqStr("and it is placed over rather than beside" note.placement "over")

        ; The tokens, one at a time, because a diagram that draws `--x` as a
        ; plain arrow is telling the reader the message arrived.
        c.eqStr("`-)` is an open head" (MermaidSequenceReader.headOf("-)")) "arrow")
        c.eqStr("`--x` is a cross" (MermaidSequenceReader.headOf("--x")) "cross")
        c.eqStr("`->` has no head at all" (MermaidSequenceReader.headOf("->")) "")
        c.eqStr("`<<-->>` is dotted" (MermaidSequenceReader.strokeOf("<<-->>")) "dotted")
        c.eqInt("a name with a dash in it is not an arrow" (MermaidSequenceReader.arrowAt("order-service is here")) -1)

        def g:FlowGraph (MermaidSequenceReader.render(src))
        def wl:FlowNode (g.nodeById("ll-Web"))
        def al:FlowNode (g.nodeById("ll-API"))
        c.ok("the columns are in declaration order, left to right" (wl.x < al.x))
        def head:FlowNode (g.nodeById("Cust"))
        c.eqStr("the participant box is drawn from the alias" head.label "Customer")
        c.eqInt("an arrow per message" (g.edgeCount()) 8)

        def m1:FlowEdge (g.edgeAt(1))
        c.eqInt("a message is pinned to its own row — nothing may re-route it" (array_length m1.waypoints) 4)
        def dy:double ((itemAt m1.waypoints 1) - (itemAt m1.waypoints 3))
        c.ok("and the row is level: a sequence arrow is horizontal" ((fabs dy) < 0.001))
        def bar:FlowNode (g.nodeById("act0"))
        c.ok("an activation is a bar on the lifeline, not a box" (bar.width < 16.0))
        c.ok("and it is as long as the participant was busy" (bar.height > 20.0))
        def cross:FlowNode (g.nodeById("destroy0"))
        c.eqStr("`destroy` ends the lifeline with the cross Mermaid draws" cross.shape "polygon")
        def bankLife:FlowNode (g.nodeById("ll-Bank"))
        def custLife:FlowNode (g.nodeById("ll-Cust"))
        c.ok("a destroyed lifeline stops short of the others" (bankLife.height < custLife.height))
        c.ok("a sequence diagram is one this library draws" (MermaidReader.draws("sequence")))
    }

    ; --------------------------------------------- Mermaid git graph ------
    ; A git graph carries its own layout: the order is the history. So what
    ; there is to get wrong is the ancestry — which commit came from which —
    ; and that is what these check.
    sfn testMermaidGit:void (c:Checker) {
        c.section("Mermaid git graphs")
        def src:string "gitGraph\n"
        src = (src + "    commit id: \"init\"\n")
        src = (src + "    commit id: \"readme\" tag: \"v0.1\"\n")
        src = (src + "    branch develop order: 2\n")
        src = (src + "    checkout develop\n")
        src = (src + "    commit id: \"parser\"\n")
        src = (src + "    commit id: \"oops\" type: REVERSE\n")
        src = (src + "    checkout main\n")
        src = (src + "    merge develop id: \"m1\" tag: \"v1.0\"\n")
        src = (src + "    cherry-pick id: \"parser\"\n")

        def d:MermaidGit (MermaidGitReader.parse(src))
        c.eqInt("`main` is a branch nobody had to declare" (d.branchCount()) 2)
        c.eqInt("a commit per statement that makes one" (d.commitCount()) 6)
        c.eqInt("and the merge is counted as what it is" (d.mergeCount()) 1)

        def init:MermaidGitCommit (itemAt d.commits 0)
        c.eqStr("the first commit is on the default branch" init.branch "main")
        c.eqStr("and comes from nothing" init.parent "")
        def readme:MermaidGitCommit (itemAt d.commits 1)
        c.eqStr("the next one follows it" readme.parent "init")
        c.eqStr("`tag:` is read off the same line" readme.tag "v0.1")

        def parser:MermaidGitCommit (itemAt d.commits 2)
        c.eqStr("a branch is cut where its parent stood" parser.parent "readme")
        c.eqStr("and its commits belong to it" parser.branch "develop")
        def oops:MermaidGitCommit (itemAt d.commits 3)
        c.eqStr("`type:` names the kind" oops.kind "REVERSE")

        def merge:MermaidGitCommit (itemAt d.commits 4)
        c.eqStr("a merge is on the branch that was checked out" merge.branch "main")
        c.eqStr("its first parent is that branch's head" merge.parent "readme")
        c.eqStr("and its second is the head of the branch merged in" merge.otherParent "oops")
        def pick:MermaidGitCommit (itemAt d.commits 5)
        c.eqStr("a cherry-pick's `id:` names what was picked" pick.otherParent "parser")
        c.eqStr("not the commit it makes" pick.kind "CHERRY_PICK")

        def g:FlowGraph (MermaidGitFlow.render(src))
        def a:FlowNode (g.nodeById("init"))
        def b:FlowNode (g.nodeById("readme"))
        c.ok("commits run along the axis in the order they happened" (a.x < b.x))
        def p:FlowNode (g.nodeById("parser"))
        c.ok("and a branch gets a row of its own" (p.y > a.y))
        def m:FlowNode (g.nodeById("m1"))
        c.eqStr("a merge is two rings, not one" m.shape "finalnode")
        c.eqStr("a reversed commit is struck through" ((g.nodeById("oops")).shape) "polygon")
        c.eqInt("an edge per parent — two for the merge and two for the pick" (g.edgeCount()) 7)
        c.ok("a git graph is one this library draws" (MermaidReader.draws("git")))
    }

    ; --------------------------------------------- Mermaid kanban ---------
    ; A board has two nouns and no verbs: columns, cards, and "this one is in
    ; that one". The whole of the reading is indentation and brackets.
    sfn testMermaidKanban:void (c:Checker) {
        c.section("Mermaid kanban boards")
        def src:string "kanban\n"
        src = (src + "  Todo\n")
        src = (src + "    [Read the grammar]\n")
        src = (src + "    docs[Write the documentation]\n")
        src = (src + "  doing[In progress]\n")
        src = (src + "    render[Draw it]@{ ticket: RF-2038, assigned: 'tero', priority: 'Very High' }\n")
        src = (src + "  done[Done]\n")

        def d:MermaidKanban (MermaidKanbanReader.parse(src))
        c.eqInt("a line at the outer level is a column" (d.columnCount()) 3)
        c.eqInt("and one inside it is a card" (d.cardCount()) 3)
        def todo:MermaidKanbanColumn (itemAt d.columns 0)
        c.eqStr("a column with no brackets is its own label" todo.label "Todo")
        def doing:MermaidKanbanColumn (itemAt d.columns 1)
        c.eqStr("`id[Label]` names the column" doing.id "doing")
        c.eqStr("and labels it" doing.label "In progress")
        def empty:MermaidKanbanColumn (itemAt d.columns 2)
        c.eqInt("an empty column is still a column" (d.cardsIn(empty.id)) 0)
        c.eqInt("cards belong to the column above them" (d.cardsIn("doing")) 1)

        def first:MermaidKanbanCard (itemAt d.cards 0)
        c.eqStr("a card with no id gets one" first.label "Read the grammar")
        c.ok("" ((strlen first.id) > 0))
        def meta:MermaidKanbanCard (itemAt d.cards 2)
        c.eqStr("`ticket:` is read out of the metadata block" meta.ticket "RF-2038")
        c.eqStr("and single quotes are quotes" meta.assigned "tero")
        c.eqStr("as is the priority" meta.priority "Very High")
        c.eqStr("which is written under the card rather than dropped" (meta.meta()) "RF-2038  ·  tero  ·  Very High")

        def g:FlowGraph (MermaidKanbanFlow.render(src))
        c.eqInt("a board has no edges at all" (g.edgeCount()) 0)
        def col:FlowNode (g.nodeById("sg-doing"))
        c.eqStr("a column is the frame a sub-flow already is" col.nodeType "group")
        def card:FlowNode (g.nodeById("render"))
        c.ok("and its cards sit inside it" (card.x > col.x))
        def col3:FlowNode (g.nodeById("sg-done"))
        c.ok("every column reaches the bottom of the tallest" ((fabs (col3.height - col.height)) < 0.001))
        c.ok("a kanban board is one this library draws" (MermaidReader.draws("kanban")))
    }

    ; --------------------------------------------- Mermaid quadrant -------
    ; The numbers place the dots. The one conversion this chart needs is that
    ; y counts UP in the source and DOWN on the page, and getting it wrong
    ; puts every dot in the wrong quadrant while the picture still looks fine.
    sfn testMermaidQuadrant:void (c:Checker) {
        c.section("Mermaid quadrant charts")
        def src:string "quadrantChart\n"
        src = (src + "    title Reach and engagement\n")
        src = (src + "    x-axis Low Reach --> High Reach\n")
        src = (src + "    y-axis Low Engagement --> High Engagement\n")
        src = (src + "    quadrant-1 We should expand\n")
        src = (src + "    quadrant-2 Need to promote\n")
        src = (src + "    quadrant-3 Re-evaluate\n")
        src = (src + "    quadrant-4 May be improved\n")
        src = (src + "    classDef urgent fill: #b91c1c, stroke: #7f1d1d\n")
        src = (src + "    Campaign A: [0.3, 0.6]\n")
        src = (src + "    Campaign B: [0.45, 0.23]\n")
        src = (src + "    Campaign C:::urgent: [0.57, 0.69] radius: 10\n")
        src = (src + "    Campaign D: [0.78, 0.34] color: #00ff00\n")

        def d:MermaidQuadrant (MermaidQuadrantReader.parse(src))
        c.eqStr("the title is the line that says so" d.title "Reach and engagement")
        c.eqStr("an axis has two ends and `-->` between them" d.xLeft "Low Reach")
        c.eqStr("both of them" d.xRight "High Reach")
        c.eqStr("and the y axis reads from the bottom up" d.yBottom "Low Engagement")
        c.eqStr("with the far end last" d.yTop "High Engagement")
        c.eqStr("quadrant 1 is the top right, the way mathematics numbers them" d.q1 "We should expand")
        c.eqStr("and 3 the bottom left" d.q3 "Re-evaluate")
        c.eqInt("a point per line that has a pair in brackets" (d.pointCount()) 4)
        c.eqInt("and a class per classDef" (d.classCount()) 1)

        def a:MermaidQuadrantPoint (itemAt d.points 0)
        c.eqStr("the label is what stands before the colon" a.label "Campaign A")
        c.ok("the first number is how far along" ((fabs (a.x - 0.3)) < 0.0001))
        c.ok("and the second how far up" ((fabs (a.y - 0.6)) < 0.0001))
        def cc:MermaidQuadrantPoint (itemAt d.points 2)
        c.eqStr("`:::name` names a class rather than part of the label" cc.cssClass "urgent")
        c.eqStr("which does not end up in the label either" cc.label "Campaign C")
        c.ok("`radius:` sizes the dot" ((fabs (cc.radius - 10.0)) < 0.0001))
        def dd:MermaidQuadrantPoint (itemAt d.points 3)
        c.eqStr("`color:` is read off the same line" dd.color "#00ff00")

        def g:FlowGraph (MermaidQuadrantFlow.render(src))
        def pa:FlowNode (g.nodeById(a.id))
        def b:MermaidQuadrantPoint (itemAt d.points 1)
        def pb:FlowNode (g.nodeById(b.id))
        c.ok("y counts up in the source and down on the page" (pa.y < pb.y))
        c.ok("and x counts the same way in both" (pa.x < pb.x))
        def pc:FlowNode (g.nodeById(cc.id))
        c.eqStr("a classDef paints the dot it was given to" pc.bgColor "#b91c1c")
        def pd:FlowNode (g.nodeById(dd.id))
        c.eqStr("and a colour on the point itself wins over the sheet" pd.bgColor "#00ff00")
        c.eqInt("the four corners are four frames, and there are no edges" (g.edgeCount()) 0)
        c.ok("a quadrant chart is one this library draws" (MermaidReader.draws("quadrant")))
    }

    ; --------------------------------------------- Mermaid pie ------------
    ; A pie chart has no nodes and no edges: a list of numbers and one rule.
    ; So what these check is the arithmetic and the geometry — that the shares
    ; add up, and that a wedge is a wedge rather than a box.
    sfn testMermaidPie:void (c:Checker) {
        c.section("Mermaid pie charts")
        def src:string "pie showData\n"
        src = (src + "    title Key elements in Product X\n")
        src = (src + "    \"Calcium\" : 42.96\n")
        src = (src + "    \"Potassium\" : 50.05\n")
        src = (src + "    \"Magnesium\" : 10.01\n")
        src = (src + "    \"Iron\" :  5\n")

        def d:MermaidPie (MermaidPieReader.parse(src))
        c.ok("`showData` is read off the header line" d.showData)
        c.eqStr("as is the title on the line after it" d.title "Key elements in Product X")
        c.eqInt("a slice per line" (d.sliceCount()) 4)
        def first:MermaidPieSlice (itemAt d.slices 0)
        c.eqStr("the quotes are not part of the name" first.label "Calcium")
        c.ok("and the number is the number" ((fabs (first.value - 42.96)) < 0.0001))
        c.ok("the total is what they add up to" ((fabs ((d.total()) - 108.02)) < 0.0001))

        ; Built from the model that was just read, so the shares the builder
        ; works out land on the slices these assertions can see.
        def bare (new FlowStyle)
        def g:FlowGraph (MermaidPieFlow.build(d bare))
        c.eqInt("a wedge and a legend row per slice" (g.nodeCount()) 12)
        c.eqInt("and nothing joins anything" (g.edgeCount()) 0)
        def w0:FlowNode (g.nodeById(first.id))
        c.eqStr("a wedge is given as a polygon, because the library has no wedge" w0.shape "polygon")
        c.ok("with an arc's worth of points on it" ((array_length w0.shapePoints) > 20))
        def shares:double 0.0
        def i:int 0
        while (i < (d.sliceCount())) {
            def s:MermaidPieSlice (itemAt d.slices i)
            shares = (shares + s.share)
            i = (i + 1)
        }
        c.ok("and the shares are shares: they come to one" ((fabs (shares - 1.0)) < 0.0001))
        def big:MermaidPieSlice (itemAt d.slices 1)
        def w1:FlowNode (g.nodeById(big.id))
        c.ok("the biggest slice takes the most room" (w1.width > w0.width))
        c.eqStr("46.3% of a circle needs no decimals it has not got" (MermaidPieFlow.numberText(5.0)) "5")
        c.eqStr("and one that does keeps them" (MermaidPieFlow.numberText(42.96)) "42.96")
        c.ok("a pie chart is one this library draws" (MermaidReader.draws("pie")))
    }

    ; --------------------------------------------- Mermaid xychart --------
    ; The first diagram here with a SCALE in it. Every other one places things
    ; by counting; this one places them by measuring, so the assertions are
    ; about the measuring — and about the default range, because a bar chart
    ; whose axis starts just under the smallest bar is a lie with a legend.
    sfn testMermaidXyChart:void (c:Checker) {
        c.section("Mermaid xy charts")
        def src:string "xychart-beta\n"
        src = (src + "    title \"Sales revenue\"\n")
        src = (src + "    x-axis [jan, feb, mar, apr]\n")
        src = (src + "    y-axis \"Revenue (in $)\" 4000 --> 12000\n")
        src = (src + "    bar [5000, 6000, 7500, 8200]\n")
        src = (src + "    line [5000, 6000, 7500, 8200]\n")

        def d:MermaidXyChart (MermaidXyReader.parse(src))
        c.eqStr("the title loses its quotes" d.title "Sales revenue")
        c.eqInt("a category per name in the brackets" (d.categoryCount()) 4)
        c.eqStr("the y axis keeps its own title" d.yTitle "Revenue (in $)")
        c.ok("and its range is the one that was given" d.yGiven)
        c.ok("the bottom of it as written" ((fabs ((d.low()) - 4000.0)) < 0.0001))
        c.ok("both ends of it" ((fabs ((d.high()) - 12000.0)) < 0.0001))
        c.eqInt("a series per bar and line statement" (d.seriesCount()) 2)
        def bars:MermaidXySeries (itemAt d.series 0)
        c.eqStr("read in the order they were written" bars.kind "bar")
        c.eqInt("with a reading per number" (bars.count()) 4)

        ; Where no range was given the axis starts at zero, which is Mermaid's
        ; default and the only one that does not exaggerate.
        def plain:string "xychart-beta\n    bar [90, 95, 100]\n"
        def pd:MermaidXyChart (MermaidXyReader.parse(plain))
        c.ok("with no range given the axis starts at zero" ((fabs (pd.low())) < 0.0001))
        c.ok("and stops at the biggest reading" ((fabs ((pd.high()) - 100.0)) < 0.0001))
        c.eqInt("and the readings decide how wide the chart is" (pd.slots()) 3)

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidXyFlow.build(d bare))
        def b0:FlowNode (g.nodeById("bar0-0"))
        def b3:FlowNode (g.nodeById("bar0-3"))
        c.ok("bars run along the axis in order" (b0.x < b3.x))
        c.ok("a bigger number is a taller bar" (b3.height > b0.height))
        ; 5000 of the way from 4000 to 12000 is one eighth; 8200 is 21/40.
        def ratio:double (b3.height / b0.height)
        c.ok("and taller by exactly as much as it is bigger" ((fabs (ratio - 4.2)) < 0.02))
        def dot:FlowNode (g.nodeById("dot1-0"))
        c.eqStr("a line series is a dot at every reading" dot.shape "circle")
        c.eqInt("with an edge between one dot and the next" (g.edgeCount()) 3)
        c.ok("an xychart is one this library draws" (MermaidReader.draws("xychart")))
    }

    ; --------------------------------------------- Mermaid Sankey ---------
    ; A graph whose edges have a WIDTH, and the width is a number somebody
    ; measured. So these check the arithmetic — the columns, the flow through
    ; each node, and that a ribbon twice the value is twice as thick.
    sfn testMermaidSankey:void (c:Checker) {
        c.section("Mermaid Sankey diagrams")
        def src:string "sankey-beta\n"
        src = (src + "\n")
        src = (src + "Agricultural 'waste',Bio-conversion,100\n")
        src = (src + "Bio-conversion,Losses,25\n")
        src = (src + "Bio-conversion,Solid,50\n")
        src = (src + "Bio-conversion,Gas,25\n")
        src = (src + "\"Imports, net\",Bio-conversion,20\n")

        def d:MermaidSankey (MermaidSankeyReader.parse(src))
        c.eqInt("a node per name, once" (d.nodeCount()) 6)
        c.eqInt("a flow per row" (d.linkCount()) 5)
        def waste:MermaidSankeyNode (itemAt d.nodes 0)
        c.eqStr("a quote inside a field is an apostrophe, not a quoted string" waste.name "Agricultural 'waste'")
        def imports:MermaidSankeyNode (itemAt d.nodes 5)
        c.eqStr("but a field that opens with one is quoted, comma and all" imports.name "Imports, net")
        def bio:MermaidSankeyNode (itemAt d.nodes 1)
        c.ok("what goes in is added up" ((fabs (bio.inflow - 120.0)) < 0.0001))
        c.ok("and so is what comes out" ((fabs (bio.outflow - 100.0)) < 0.0001))
        c.ok("a node is as tall as the larger of the two" ((fabs ((bio.flow()) - 120.0)) < 0.0001))
        c.eqInt("nothing flows into the first column" waste.depth 0)
        c.eqInt("and each node sits one past whatever feeds it" bio.depth 1)
        c.eqInt("three columns in all" (d.depthCount()) 3)

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidSankeyFlow.build(d bare))
        def barA:FlowNode (g.nodeById(waste.id))
        def barB:FlowNode (g.nodeById(bio.id))
        c.ok("columns run left to right" (barA.x < barB.x))
        def losses:MermaidSankeyNode (itemAt d.nodes 2)
        def solid:MermaidSankeyNode (itemAt d.nodes 3)
        def barL:FlowNode (g.nodeById(losses.id))
        def barS:FlowNode (g.nodeById(solid.id))
        def ratio:double (barS.height / barL.height)
        c.ok("and twice the quantity is twice the height" ((fabs (ratio - 2.0)) < 0.02))
        def ribbon:FlowNode (g.nodeById("rb0"))
        c.eqStr("a ribbon is a polygon: the library has no ribbon" ribbon.shape "polygon")
        c.ok("sampled along a curve rather than drawn as a wedge" ((array_length ribbon.shapePoints) > 40))
        def l0:MermaidSankeyLink (itemAt d.links 0)
        def l1:MermaidSankeyLink (itemAt d.links 1)
        c.ok("and as thick as the number on its own row" ((fabs ((l0.thickness / l1.thickness) - 4.0)) < 0.02))
        c.eqInt("nothing is an edge: a Sankey's lines are its shapes" (g.edgeCount()) 0)
        c.ok("a Sankey diagram is one this library draws" (MermaidReader.draws("sankey")))
    }

    ; --------------------------------------------- Mermaid block ----------
    ; The one diagram that says where its boxes go. `columns 3` and a list is
    ; arithmetic, so the one thing this reader must not do is improve on it —
    ; and that is what these assertions are: the grid came out as written.
    sfn testMermaidBlock:void (c:Checker) {
        c.section("Mermaid block diagrams")
        def src:string "block-beta\n"
        src = (src + "  columns 3\n")
        src = (src + "  a[\"A label\"] b:2\n")
        src = (src + "  block:inner\n")
        src = (src + "    columns 2\n")
        src = (src + "    d e\n")
        src = (src + "  end\n")
        src = (src + "  f((\"round\")) space g{\"choice\"}\n")
        src = (src + "  a --> f\n")
        src = (src + "  b -- \"why\" --> g\n")
        src = (src + "  style a fill:#f9f\n")
        src = (src + "  classDef hot fill:#f00\n")
        src = (src + "  class g hot\n")

        def d:MermaidBlockDiagram (MermaidBlockReader.parse(src))
        c.eqInt("a block per token, the container included and a space not" (d.blockCount()) 7)
        c.eqInt("an arrow per arrow line" (d.linkCount()) 2)
        def a:MermaidBlockItem (itemAt d.root.children 0)
        c.eqStr("the bracket holds the label" a.label "A label")
        c.eqStr("and the name is what stands before it" a.id "a")
        def b:MermaidBlockItem (itemAt d.root.children 1)
        c.eqInt("`:2` is how many columns it takes" b.span 2)
        def inner:MermaidBlockItem (itemAt d.root.children 2)
        c.ok("`block:` opens a container" inner.isGroup)
        c.eqInt("with children of its own" (inner.childCount()) 2)
        c.eqInt("and columns of its own" inner.columns 2)
        def f:MermaidBlockItem (itemAt d.root.children 3)
        c.eqStr("`((…))` is a circle, as in a flowchart" f.shape "circle")
        def space:MermaidBlockItem (itemAt d.root.children 4)
        c.ok("`space` is a hole in the grid" space.isSpace)
        def g2:MermaidBlockItem (itemAt d.root.children 5)
        c.eqStr("`{…}` is the decision diamond" g2.shape "rhombus")
        c.eqStr("`style` names a colour for one block" a.fill "#f9f")
        c.eqStr("and `class` hands one out by name" g2.cssClass "hot")
        def link:MermaidBlockLink (itemAt d.links 1)
        c.eqStr("an arrow reads from its ends" link.source "b")
        c.eqStr("both of them" link.target "g")
        c.eqStr("and carries whatever was written between the dashes" link.label "why")

        def bare (new FlowStyle)
        def graph:FlowGraph (MermaidBlockFlow.build(d bare))
        def na:FlowNode (graph.nodeById("a"))
        def nb:FlowNode (graph.nodeById("b"))
        c.ok("blocks fill a row left to right" (na.x < nb.x))
        c.ok("and a span of two is twice as wide, plus the gap between them" ((nb.width - (na.width * 2.0)) > 10.0))
        def frame:FlowNode (graph.nodeById("sg-inner"))
        c.ok("a container starts on the row after the one it follows" (frame.y > na.y))
        def nd:FlowNode (graph.nodeById("d"))
        c.ok("and holds its children inside itself" (nd.x >= frame.x))
        c.ok("below its title band" (nd.y > frame.y))
        def ng:FlowNode (graph.nodeById("g"))
        c.eqStr("a class written in the diagram beats the stylesheet" ng.bgColor "#f00")
        c.eqStr("as does a style written on the block" (na.bgColor) "#f9f")
        c.eqInt("arrows are edges like anywhere else" (graph.edgeCount()) 2)
        c.ok("a block diagram is one this library draws" (MermaidReader.draws("block")))
    }

    ; --------------------------------------------- Mermaid architecture ---
    ; The sides in the connections ARE the layout: `db:L -- R:server` puts the
    ; server to the left of the database. A layout engine asked to place these
    ; would draw a perfectly good picture of a different arrangement, so the
    ; assertions are about the arrangement.
    sfn testMermaidArchitecture:void (c:Checker) {
        c.section("Mermaid architecture diagrams")
        def src:string "architecture-beta\n"
        src = (src + "    group api(cloud)[API]\n")
        src = (src + "    service db(database)[Database] in api\n")
        src = (src + "    service disk1(disk)[Storage] in api\n")
        src = (src + "    service server(server)[Server] in api\n")
        src = (src + "    junction j1 in api\n")
        src = (src + "    db:L -- R:server\n")
        src = (src + "    disk1:T -- B:server\n")
        src = (src + "    server:B --> T:j1\n")

        def d:MermaidArchitecture (MermaidArchReader.parse(src))
        c.eqInt("a group is a node too" (d.groupCount()) 1)
        c.eqInt("and the services are the rest" (d.serviceCount()) 4)
        c.eqInt("a connection per line with sides on it" (d.edgeCount()) 3)
        def db:MermaidArchNode (itemAt d.nodes 1)
        c.eqStr("the icon is what stands in the brackets" db.icon "database")
        c.eqStr("the label what stands in the square ones" db.label "Database")
        c.eqStr("and `in` names the group it belongs to" db.parent "api")
        def junction:MermaidArchNode (itemAt d.nodes 4)
        c.ok("a junction is a place where lines meet" junction.isJunction)
        c.eqStr("and has nothing written in it" junction.label "")
        def e0:MermaidArchEdge (itemAt d.edges 0)
        c.eqStr("each end of a connection carries its own side" e0.sourceSide "L")
        c.eqStr("both of them" e0.targetSide "R")
        c.ok("a plain `--` has no arrowhead" (e0.targetArrow == false))
        def e2:MermaidArchEdge (itemAt d.edges 2)
        c.ok("and `-->` has one at the far end" e2.targetArrow)
        c.ok("but not at the near one" (e2.sourceArrow == false))

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidArchFlow.build(d bare))
        def nDb:FlowNode (g.nodeById("db"))
        def nServer:FlowNode (g.nodeById("server"))
        c.ok("`db:L` puts the server to the LEFT of the database" (nServer.x < nDb.x))
        def nDisk:FlowNode (g.nodeById("disk1"))
        c.ok("and `disk1:T` puts the disk BELOW the server it points up at" (nDisk.y > nServer.y))
        c.eqStr("a database is drawn as the cylinder it is anywhere else" nDb.shape "cylinder")
        def frame:FlowNode (g.nodeById("sg-api"))
        c.ok("the group is drawn around whatever turned out to be inside it" (frame.x <= nServer.x))
        c.ok("on both sides" ((frame.x + frame.width) >= (nDb.x + nDb.width)))
        c.eqInt("a connection per edge" (g.edgeCount()) 3)
        c.ok("an architecture diagram is one this library draws" (MermaidReader.draws("architecture")))
    }

    ; --------------------------------------------- Mermaid swimlane -------
    ; `swimlane-beta` has no grammar of its own: Mermaid's own source says it
    ; reuses the flowchart parser wholesale and swaps the layout. So the one
    ; thing to get wrong is the KEYWORD — the chunk Mermaid ships is called
    ; `swimlanes` and the header is `swimlane-beta`, singular — and after
    ; that, which lane each step lands in.
    sfn testMermaidSwimlane:void (c:Checker) {
        c.section("Mermaid swimlane diagrams")
        def src:string "swimlane-beta\n"
        src = (src + "    subgraph Customer\n")
        src = (src + "        order[Place order] --> pay[Pay]\n")
        src = (src + "    end\n")
        src = (src + "    subgraph Warehouse\n")
        src = (src + "        pick[Pick] --> pack[Pack]\n")
        src = (src + "    end\n")
        src = (src + "    pay --> pick\n")
        src = (src + "    pack --> done[Done]\n")

        def d:MermaidDiagram (MermaidReader.parse(src))
        c.eqStr("the header names the diagram" d.diagramKind "swimlane")
        c.eqInt("and the body is read, because a swimlane IS a flowchart" (d.nodeCount()) 5)
        c.eqInt("with the subgraphs kept as the lanes" (d.subgraphCount()) 2)
        c.eqInt("and the links between them" (d.linkCount()) 4)
        c.eqStr("the plural is the chunk's name, not the keyword" (MermaidReader.otherDiagram("swimlane-beta")) "swimlane")

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidSwimlaneFlow.build(d bare))
        def order:FlowNode (g.nodeById("order"))
        def pick:FlowNode (g.nodeById("pick"))
        def done:FlowNode (g.nodeById("done"))
        c.ok("a step is in the lane that owns it" (pick.y > order.y))
        c.ok("and a step nobody claimed gets a lane at the bottom" (done.y > pick.y))
        def pay:FlowNode (g.nodeById("pay"))
        c.ok("the process runs across the page, not down it" (pay.x > order.x))
        c.ok("each step past the one that leads to it" (pick.x > pay.x))
        def lane0:FlowNode (g.nodeById("sg-lane0"))
        c.eqStr("the lane is a band with the subgraph's name on it" lane0.label "Customer")
        def spare:FlowNode (g.nodeById("sg-lane2"))
        c.ok("and there is one more band than there are subgraphs" (spare.y > lane0.y))
        c.eqInt("every link survives the relayout" (g.edgeCount()) 4)
        c.ok("a swimlane diagram is one this library draws" (MermaidReader.draws("swimlane")))
    }

    ; --------------------------------------------- Mermaid Cynefin --------
    ; Five domains, always in the same places, because the places are the
    ; argument. So there is nothing to lay out and everything to get right
    ; about which domain a thing was written under.
    sfn testMermaidCynefin:void (c:Checker) {
        c.section("Mermaid Cynefin frameworks")
        def src:string "cynefin-beta\n"
        src = (src + "    title Where the work is\n")
        src = (src + "    complex\n")
        src = (src + "        \"new market\"\n")
        src = (src + "        \"the rewrite\"\n")
        src = (src + "    complicated \"migration\"\n")
        src = (src + "    clear \"payroll\"\n")
        src = (src + "    chaotic \"the outage\"\n")
        src = (src + "    confusion \"the backlog\"\n")
        src = (src + "    complex --> complicated : \"understood\"\n")
        src = (src + "    clear --> clear : \"nowhere\"\n")

        def d:MermaidCynefin (MermaidCynefinReader.parse(src))
        c.eqStr("the title is the line that says so" d.title "Where the work is")
        c.eqInt("an item per quoted string" (d.itemCount()) 6)
        c.eqInt("indented under the name and on the same line both count" (d.itemsIn("complex")) 2)
        c.eqInt("one written beside its name is one item" (d.itemsIn("complicated")) 1)
        c.eqInt("the fifth domain is a domain like the others" (d.itemsIn("confusion")) 1)
        c.eqInt("a move between two domains" (d.moveCount()) 1)
        c.ok("and a move to the domain it is already in is not one" ((d.moveCount()) == 1))
        def m:MermaidCynefinMove (itemAt d.moves 0)
        c.eqStr("which reads from its ends" m.from "complex")
        c.eqStr("both of them" m.to "complicated")
        c.eqStr("and carries what was written after the colon" m.label "understood")
        c.ok("`complex` is one of the five" (MermaidCynefin.isDomain("complex")))
        c.ok("and `simple` is not — the framework renamed it years ago" ((MermaidCynefin.isDomain("simple")) == false))

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidCynefinFlow.build(d bare))
        def complex:FlowNode (g.nodeById("sg-complex"))
        def complicated:FlowNode (g.nodeById("sg-complicated"))
        def chaotic:FlowNode (g.nodeById("sg-chaotic"))
        def clear:FlowNode (g.nodeById("sg-clear"))
        c.ok("complicated is to the right of complex" (complicated.x > complex.x))
        c.ok("chaotic is below it" (chaotic.y > complex.y))
        c.ok("and clear is opposite" (clear.x > chaotic.x))
        def centre:FlowNode (g.nodeById("sg-confusion"))
        c.ok("confusion is in the middle" (centre.x > complex.x))
        c.ok("of all four of them" (centre.x < complicated.x))
        c.ok("and smaller than the domains it sits between" (centre.width < complex.width))
        def first:MermaidCynefinItem (itemAt d.items 0)
        def item:FlowNode (g.nodeById(first.id))
        c.ok("an item is drawn inside its own domain" (item.x >= complex.x))
        ; The middle domain's items go INSIDE it. Dropped below the centre
        ; they land on the domain beneath and read as belonging to it, which
        ; is the opposite of what `confusion` means.
        def muddle:MermaidCynefinItem (itemAt d.items 5)
        def muddleCard:FlowNode (g.nodeById(muddle.id))
        c.eqStr("the last item is the one in the middle" muddle.domain "confusion")
        c.ok("and its card is inside the middle box, not under it" (muddleCard.y >= centre.y))
        c.ok("top and bottom both" ((muddleCard.y + muddleCard.height) <= (centre.y + centre.height)))
        ; The quadrants touch, so an arrow between their EDGES has no length.
        ; A move is drawn between the two domains' middles instead.
        def move:FlowEdge (g.edgeAt(0))
        c.eqInt("a move is pinned to a route of its own" (array_length move.waypoints) 4)
        def x0:double (itemAt move.waypoints 0)
        def x1:double (itemAt move.waypoints 2)
        c.ok("which crosses the boundary rather than running along it" ((fabs (x1 - x0)) > 40.0))
        c.eqInt("a move is an arrow between two domains" (g.edgeCount()) 1)
        c.ok("a Cynefin framework is one this library draws" (MermaidReader.draws("cynefin")))
    }

    ; --------------------------------------------- Mermaid Ishikawa -------
    ; A cause-and-effect tree with one strong convention about how it is
    ; drawn: the effect at the head, the causes off the spine, alternating
    ; above and below. The reading is indentation and nothing else, which is
    ; the whole of Mermaid's grammar for it.
    sfn testMermaidIshikawa:void (c:Checker) {
        c.section("Mermaid fishbone diagrams")
        def src:string "ishikawa-beta\n"
        src = (src + "  Late delivery\n")
        src = (src + "    Machine\n")
        src = (src + "      Old truck\n")
        src = (src + "      No spare parts\n")
        src = (src + "    Method\n")
        src = (src + "      No route plan\n")
        src = (src + "        Nobody asked the driver\n")
        src = (src + "    Material\n")
        src = (src + "    People\n")

        def d:MermaidIshikawa (MermaidIshikawaReader.parse(src))
        c.eqStr("the first line is the effect — the head of the fish" d.problem "Late delivery")
        c.eqInt("the lines under it are the categories" (d.categoryCount()) 4)
        c.eqInt("and everything below those is a cause, as deep as it goes" (d.causeCount()) 4)
        def machine:MermaidIshikawaNode (itemAt d.root.children 0)
        c.eqStr("read in the order they were written" machine.text "Machine")
        c.eqInt("with their own causes under them" (machine.childCount()) 2)
        def method:MermaidIshikawaNode (itemAt d.root.children 1)
        def plan:MermaidIshikawaNode (itemAt method.children 0)
        c.eqInt("a cause may have a cause of its own" (plan.childCount()) 1)
        def deeper:MermaidIshikawaNode (itemAt plan.children 0)
        c.eqStr("as deep as the indentation goes" deeper.text "Nobody asked the driver")
        def empty:MermaidIshikawaNode (itemAt d.root.children 2)
        c.eqInt("a category with nothing under it is still a category" (empty.childCount()) 0)

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidIshikawaFlow.build(d bare))
        def head:FlowNode (g.nodeById("head"))
        def spine:FlowNode (g.nodeById("spine"))
        c.eqStr("the effect is drawn as the head it is" head.label "Late delivery")
        c.ok("at the far end of the spine" (head.x >= (spine.x + spine.width - 1.0)))
        def cat0:FlowNode (g.nodeById(machine.id))
        def cat1:FlowNode (g.nodeById(method.id))
        c.ok("the first category is above the spine" (cat0.y < spine.y))
        c.ok("and the second below it, so a long list still fits" (cat1.y > spine.y))
        def cat2:MermaidIshikawaNode (itemAt d.root.children 2)
        def cat2Node:FlowNode (g.nodeById(cat2.id))
        c.ok("the third is above again, and further along" (cat2Node.x > cat0.x))
        c.ok("on the same side as the first" (cat2Node.y < spine.y))
        def firstCause:MermaidIshikawaNode (itemAt machine.children 0)
        def cause:FlowNode (g.nodeById(firstCause.id))
        c.ok("a cause is further from the spine than what it causes" (cause.y < cat0.y))
        c.eqInt("a bone per category and per cause, the deep one included" (g.edgeCount()) 8)
        c.ok("a fishbone is one this library draws" (MermaidReader.draws("ishikawa")))
    }

    ; --------------------------------------------- Mermaid Venn -----------
    ; Two facts and one picture: how big each set is, and how much of it is
    ; also in another one. So the assertions are about the sizes — a Venn
    ; diagram whose circles are all the same has thrown away half of what it
    ; was given — and about the circles actually overlapping.
    sfn testMermaidVenn:void (c:Checker) {
        c.section("Mermaid Venn diagrams")
        def src:string "venn-beta\n"
        src = (src + "    title What people brought\n")
        src = (src + "    set A [\"Apples\"]: 40\n")
        src = (src + "    set B [\"Bananas\"]: 10\n")
        src = (src + "    union A,B [\"Both\"]: 5\n")

        def d:MermaidVenn (MermaidVennReader.parse(src))
        c.eqStr("the title is the line that says so" d.title "What people brought")
        c.eqInt("a subset per `set` and per `union`" (d.subsetCount()) 3)
        c.eqInt("but only the plain ones are sets" (d.setCount()) 2)
        c.eqInt("and the rest are overlaps" (d.unionCount()) 1)
        def a:MermaidVennSet (itemAt d.subsets 0)
        c.eqStr("the brackets hold the label" a.label "Apples")
        c.eqStr("and the name is what stands before them" a.id "A")
        c.ok("the number after the colon is the size" ((fabs (a.size - 40.0)) < 0.0001))
        c.eqInt("a plain set has one member" (a.memberCount()) 1)
        def both:MermaidVennSet (itemAt d.subsets 2)
        c.ok("a union has more than one" (both.isUnion()))
        c.eqInt("named on the same line, comma separated" (both.memberCount()) 2)
        c.eqStr("which is how it knows which circles it lies between" (itemAt both.members 1) "B")

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidVennFlow.build(d bare))
        def ca:FlowNode (g.nodeById("set-A"))
        def cb:FlowNode (g.nodeById("set-B"))
        c.eqStr("a set is drawn as the circle it is" ca.shape "circle")
        c.ok("a bigger set is a bigger circle" (ca.width > cb.width))
        ; Four times the size is twice the width: the circles are sized by
        ; AREA, because that is what a reader compares.
        def ratio:double (ca.width / cb.width)
        c.ok("and bigger by area, not by radius" ((fabs (ratio - 2.0)) < 0.05))
        def gap:double (fabs ((cb.centerX()) - (ca.centerX())))
        def reach:double ((ca.width + cb.width) * 0.5)
        c.ok("two circles are placed so that they OVERLAP" (gap < reach))
        c.ok("which is the one thing a Venn diagram exists to say" (gap > 0.0))
        c.eqInt("a Venn diagram has no edges at all" (g.edgeCount()) 0)
        ; A round outline is a polygon in the tessellating backends and a real
        ; curve in the ones that draw a path, and the polygon's density
        ; follows the radius: a fixed segment count is right for a 40px node
        ; and visibly faceted on a 300px one.
        def small:int (FlowShapes.segmentsFor(18.0 18.0))
        def large:int (FlowShapes.segmentsFor(200.0 200.0))
        c.ok("a small circle needs few pieces" (small <= 20))
        c.ok("and a large one needs many more" (large > (small * 2)))
        def arc:string (FlowShapes.arcPath("circle" 0.0 0.0 100.0 100.0))
        c.ok("a circle also carries an exact curve for the vector backends" ((strlen arc) > 0))
        c.ok("built of the four cubic arcs every drawing library uses" ((MermaidReader.replaceAll(arc "C" "")) != arc))
        c.eqStr("and a shape with no curve in it carries none" (FlowShapes.arcPath("hexagon" 0.0 0.0 10.0 10.0)) "")
        c.ok("a Venn diagram is one this library draws" (MermaidReader.draws("venn")))
    }

    ; --------------------------------------------- Mermaid Wardley --------
    ; A value chain drawn against evolution: up the page is how visible a
    ; thing is, across it is how evolved. Both are numbers the author wrote,
    ; so the assertions are about reading them and about the one conversion
    ; the map needs — visible is UP, and the page counts down.
    sfn testMermaidWardley:void (c:Checker) {
        c.section("Mermaid Wardley maps")
        def src:string "wardley-beta\n"
        src = (src + "    title Tea shop\n")
        src = (src + "    anchor Business [0.95, 0.63]\n")
        src = (src + "    component Cup of Tea [0.79, 0.61]\n")
        src = (src + "    component Kettle [0.43, 0.35]\n")
        src = (src + "    Business->Cup of Tea\n")
        src = (src + "    Cup of Tea->Kettle\n")
        src = (src + "    evolve Kettle 0.62\n")

        def d:MermaidWardley (MermaidWardleyReader.parse(src))
        c.eqStr("the title is the line that says so" d.title "Tea shop")
        c.eqInt("a node per placed thing" (d.nodeCount()) 3)
        c.eqInt("and a link per arrow" (d.linkCount()) 2)
        def anchor:MermaidWardleyNode (itemAt d.nodes 0)
        c.eqStr("an anchor is not a component" anchor.kind "anchor")
        c.ok("the first number is how visible it is" ((fabs (anchor.visibility - 0.95)) < 0.0001))
        c.ok("and the second how evolved" ((fabs (anchor.evolution - 0.63)) < 0.0001))
        def cup:MermaidWardleyNode (itemAt d.nodes 1)
        c.eqStr("a name may have spaces in it: the bracket ends it, not the space" cup.id "Cup of Tea")
        def kettle:MermaidWardleyNode (itemAt d.nodes 2)
        c.ok("`evolve` says a thing is moving" kettle.evolving)
        c.ok("and where to" ((fabs (kettle.evolveTo - 0.62)) < 0.0001))
        def link:MermaidWardleyLink (itemAt d.links 0)
        c.eqStr("a link reads from its ends, spaces and all" link.target "Cup of Tea")

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidWardleyFlow.build(d bare))
        def nAnchor:FlowNode (g.nodeById("Business"))
        def nKettle:FlowNode (g.nodeById("Kettle"))
        c.ok("visible is UP, and the page counts down" (nAnchor.y < nKettle.y))
        def nCup:FlowNode (g.nodeById("Cup of Tea"))
        c.ok("more evolved is further right" (nCup.x > nKettle.x))
        def ghost:FlowNode (g.nodeById("evolved-Kettle"))
        c.ok("a thing that is evolving gets a ghost where it is going" (ghost.x > nKettle.x))
        c.ok("at the same height, because only evolution changes" ((fabs (ghost.y - nKettle.y)) < 0.001))
        c.eqInt("an edge per link, and one more for the move" (g.edgeCount()) 3)
        def stage:FlowNode (g.nodeById("stage0"))
        c.eqStr("the four stages are written along the bottom" stage.label "Genesis")
        c.ok("a Wardley map is one this library draws" (MermaidReader.draws("wardley")))
    }

    ; --------------------------------------------- Mermaid railroad -------
    ; Mermaid ships FOUR headers for one picture. They disagree about how to
    ; spell a choice and agree about everything else, so the test is that all
    ; four arrive at the same tree — and that the headers are the ones Mermaid
    ; actually detects, which are not the names of the chunks it ships.
    sfn testMermaidRailroad:void (c:Checker) {
        c.section("Mermaid railroad diagrams")
        c.eqStr("the EBNF header is `railroad-ebnf-beta`" (MermaidReader.otherDiagram("railroad-ebnf-beta")) "ebnf")
        c.eqStr("the ABNF one `railroad-abnf-beta`" (MermaidReader.otherDiagram("railroad-abnf-beta")) "abnf")
        c.eqStr("the PEG one `railroad-peg-beta`" (MermaidReader.otherDiagram("railroad-peg-beta")) "peg")
        c.eqStr("and the plain one `railroad-beta`" (MermaidReader.otherDiagram("railroad-beta")) "railroad")
        c.ok("all four are one picture" (MermaidReader.isRailroad("peg")))

        ; The same grammar in three notations. `word` is one or more letters
        ; and a letter is an a or a b, however it is written down.
        def ebnf:MermaidRailroad (MermaidRailroadReader.parse("railroad-ebnf-beta\n  word = letter , { letter } ;\n  letter = \"a\" | \"b\" ;\n"))
        def abnf:MermaidRailroad (MermaidRailroadReader.parse("railroad-abnf-beta\n  word = 1*letter;\n  letter = \"a\" / \"b\";\n"))
        def peg:MermaidRailroad (MermaidRailroadReader.parse("railroad-peg-beta\n  word <- letter+;\n  letter <- 'a' / 'b';\n"))
        c.eqStr("the notation is read off the header" ebnf.notation "ebnf")
        c.eqStr("in each of the four" abnf.notation "abnf")
        c.eqStr("and the fourth" peg.notation "peg")
        c.eqInt("a rule per statement, in every notation" (ebnf.ruleCount()) 2)
        c.eqInt("however it is spelled" (abnf.ruleCount()) 2)
        c.eqInt("and in the third" (peg.ruleCount()) 2)

        def eLetter:MermaidRailRule (ebnf.ruleNamed("letter"))
        def aLetter:MermaidRailRule (abnf.ruleNamed("letter"))
        def pLetter:MermaidRailRule (peg.ruleNamed("letter"))
        def eBody:MermaidRailNode eLetter.body
        def aBody:MermaidRailNode aLetter.body
        def pBody:MermaidRailNode pLetter.body
        c.eqStr("`|` in EBNF is a choice" eBody.kind "choice")
        c.eqStr("and so is `/` in ABNF" aBody.kind "choice")
        c.eqStr("and in PEG" pBody.kind "choice")
        c.eqInt("of two terminals" (eBody.childCount()) 2)
        def term:MermaidRailNode (itemAt eBody.children 0)
        c.eqStr("with the quotes off them" term.text "a")
        c.eqStr("and drawn as what the input contains" term.kind "terminal")

        def aWord:MermaidRailRule (abnf.ruleNamed("word"))
        def pWord:MermaidRailRule (peg.ruleNamed("word"))
        def aw:MermaidRailNode aWord.body
        def pw2:MermaidRailNode pWord.body
        c.eqStr("`1*x` in ABNF is a repetition" aw.kind "repetition")
        c.eqInt("of one or more" aw.minTimes 1)
        c.eqStr("and so is `x+` in PEG" pw2.kind "repetition")
        c.eqInt("one or more there too" pw2.minTimes 1)
        def eWord:MermaidRailRule (ebnf.ruleNamed("word"))
        def ew:MermaidRailNode eWord.body
        c.eqStr("EBNF says the same thing as a sequence with a `{ }` in it" ew.kind "sequence")
        def tail:MermaidRailNode (itemAt ew.children 1)
        c.eqStr("whose second half is the repeat" tail.kind "repetition")
        c.eqInt("and `{ }` is NONE or more" tail.minTimes 0)

        ; The fourth notation writes the tree out in full.
        def plain:MermaidRailroad (MermaidRailroadReader.parse("railroad-beta\n  word = optional(zeroOrMore(special('any')));\n"))
        def pw:MermaidRailRule (plain.ruleNamed("word"))
        def pwBody:MermaidRailNode pw.body
        c.eqStr("`optional(…)` is an optional" pwBody.kind "optional")
        def rep:MermaidRailNode (itemAt pwBody.children 0)
        c.eqStr("`zeroOrMore(…)` a repetition" rep.kind "repetition")
        def sp:MermaidRailNode (itemAt rep.children 0)
        c.eqStr("and `special('x')` the third kind of leaf" sp.kind "special")
        c.eqStr("with its own words in it" sp.text "any")

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidRailroadFlow.build(ebnf bare))
        c.eqInt("a railroad's lines are drawn, not routed" (g.edgeCount()) 0)
        def name:FlowNode (g.nodeById("rule-word"))
        c.eqStr("every rule is named at its left" name.label "word")
        def other:FlowNode (g.nodeById("rule-letter"))
        c.ok("and the rules stack down the page" (other.y > name.y))
        c.ok("a railroad diagram is one this library draws" (MermaidReader.draws("ebnf")))

        ; `info` is the smallest diagram Mermaid has: the whole source is the
        ; word, and what it renders is what rendered it. This is not Mermaid
        ; and does not know Mermaid's version, so it says what it IS — a
        ; version number invented on the spot would be printed in a box and
        ; believed.
        def info:MermaidInfo (MermaidInfoReader.parse("info\n"))
        c.ok("`info` is a question, and it was asked" info.asked)
        c.ok("the answer names the thing that drew it" ((indexOf info.text "RangerFlow") >= 0))
        def ig:FlowGraph (MermaidInfoFlow.build(info bare))
        c.eqInt("and is one card" (ig.nodeCount()) 1)
        def notInfo:MermaidInfo (MermaidInfoReader.parse("flowchart TD\n  a --> b\n"))
        c.ok("a diagram that never asked gets no answer" (notInfo.asked == false))
        c.ok("`info` is one this library draws" (MermaidReader.draws("info")))
    }

    ; --------------------------------------------- Mermaid class notes ----
    ; A note is prose ABOUT the program rather than part of it, which is what
    ; decides both of the questions here: it is not given to the layout, and
    ; the line breaks in it are the author's rather than the wrapper's.
    sfn testMermaidClassNotes:void (c:Checker) {
        c.section("Mermaid class diagram notes")
        def src:string "classDiagram\n"
        src = (src + "note \"From Duck till Zebra\"\n")
        src = (src + "Animal <|-- Duck\n")
        src = (src + "note for Duck \"can fly<br>can swim<br>can dive<br>can help in debugging\"\n")

        def d:MermaidClassDiagram (MermaidClassReader.parse(src))
        c.eqInt("both notes are read" (d.noteCount()) 2)
        def loose:MermaidClassNote (itemAt d.notes 0)
        c.eqStr("a bare note is the words in the quotes" loose.text "From Duck till Zebra")
        c.ok("and belongs to no class" ((loose.pinned()) == false))
        def pinned:MermaidClassNote (itemAt d.notes 1)
        c.eqStr("`note for Duck` names the class" pinned.target "Duck")
        c.ok("and is pinned to it" (pinned.pinned()))
        c.eqInt("`<br>` is a line the author asked for" (FlowText.hardLines(pinned.text)) 4)
        c.eqInt("a note is not a class" (d.classCount()) 2)

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidClassFlow.build(d bare))
        def n0:FlowNode (g.nodeById("note-0"))
        def n1:FlowNode (g.nodeById("note-1"))
        c.eqStr("a note is drawn with the folded corner" n1.shape "note")
        c.eqStr("and carries its own words" n0.label "From Duck till Zebra")
        def duck:FlowNode (g.nodeById("Duck"))
        c.ok("a pinned note stands beside its class" (n1.x < duck.x))
        c.ok("and level with it" ((fabs ((n1.centerY()) - (duck.centerY()))) < 1.0))
        c.ok("and does not overlap it" (((n1.x + n1.width) < duck.x)))
        c.ok("it is tall enough for every line the author wrote" (n1.height > 80.0))
        def leader:FlowEdge (RangerFlowTest.edgeNamed(g "noteline-1"))
        c.ok("the leader is dashed" (leader.dash > 0.0))
        c.eqStr("with nothing on the end of it" leader.markerEnd "")
        c.ok("and goes where it was put, not where a router would send it" leader.pinnedRoute)
        c.eqInt("a note with no class gets no leader" (g.edgeCount()) 2)
        ; Three lines is the cap for text that WRAPPED. Text broken by hand is
        ; not wrapped text, and merging two of its lines rewrites the sentence.
        def view:FlowView (FlowView.of(g))
        def hard:int (view.linesForText(200.0 12.0 "a\nb\nc\nd\ne"))
        c.eqInt("five hand-written lines are five lines" hard 5)
        def soft:int (view.linesForText(200.0 12.0 "one long sentence with no breaks in it"))
        c.eqInt("and text with none of them still caps at three" soft 3)
    }

    ; --------------------------------------------- Mermaid radar ----------
    ; The second diagram here with a SCALE in it, and it carries the xychart's
    ; obligation: a reading of 85 has to be exactly as far out along its spoke
    ; as 85 is between the middle and the rim.
    sfn testMermaidRadar:void (c:Checker) {
        c.section("Mermaid radar charts")
        def src:string "radar-beta\n"
        src = (src + "  title Grades\n")
        src = (src + "  axis m[\"Math\"], s[\"Science\"]\n")
        src = (src + "  axis e[\"English\"], h[\"History\"]\n")
        src = (src + "  curve a[\"Alice\"]{100, 50, 0, 50}\n")
        src = (src + "  curve b[\"Bob\"]{h: 100, m: 0}\n")
        src = (src + "  max 100\n")
        src = (src + "  min 0\n")
        src = (src + "  ticks 4\n")
        src = (src + "  graticule polygon\n")

        def d:MermaidRadar (MermaidRadarReader.parse(src))
        c.eqStr("the title is the line that says so" d.title "Grades")
        c.eqInt("every `axis` line adds to the same set of spokes" (d.axisCount()) 4)
        def ax:MermaidRadarAxis (itemAt d.axes 1)
        c.eqStr("the name is what stands before the bracket" ax.id "s")
        c.eqStr("and the label is what is inside it" ax.label "Science")
        c.eqInt("a curve per `curve`" (d.curveCount()) 2)
        def alice:MermaidRadarCurve (itemAt d.curves 0)
        c.eqInt("a plain list is one reading per spoke, in order" (alice.count()) 4)
        c.ok("and lands on the spokes in that order" ((fabs ((itemAt alice.values 0) - 100.0)) < 0.001))
        ; `h: 100` says which spoke it belongs on, which is the only safe way
        ; to write a curve that skips an axis.
        def bob:MermaidRadarCurve (itemAt d.curves 1)
        c.ok("a named reading goes to the axis it names" ((fabs ((itemAt bob.values 3) - 100.0)) < 0.001))
        c.ok("and an axis nobody named reads as nothing" ((fabs (itemAt bob.values 1)) < 0.001))
        c.eqInt("`ticks` is how many rings" d.ticks 4)
        c.eqStr("`graticule` is which shape they are" d.graticule "polygon")
        c.ok("`showLegend` is on unless it is turned off" d.showLegend)
        c.ok("the scale is what `min` and `max` said" ((fabs ((d.high()) - 100.0)) < 0.001))

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidRadarFlow.build(d bare))
        c.eqInt("a radar has no edges: every line on it is a shape" (g.edgeCount()) 0)
        def r:double (MermaidRadarFlow.radius())
        ; The scale. Alice reads 100 on Math and 0 on English, so her point on
        ; the first spoke is ON the rim and her point on the third is dead
        ; centre — anything else and the chart is a lie about the numbers.
        def full:FlowNode (g.nodeById("dot-0-0"))
        def none:FlowNode (g.nodeById("dot-0-2"))
        def cx:double r
        def cy:double r
        c.ok("a reading at the top of the scale sits on the rim" ((fabs (((full.centerY()) - cy) + r)) < 1.0))
        c.ok("and one at the bottom sits in the middle" ((fabs ((none.centerY()) - cy)) < 1.0))
        c.ok("the first axis is at twelve o'clock" ((fabs ((full.centerX()) - cx)) < 1.0))
        ; The rings and spokes are lines, and a line here is a thin polygon:
        ; the display list fills what it draws, so an unfilled ring would be a
        ; ring painted in the paper's colour and lost on any other paper.
        def ring:FlowNode (g.nodeById("ring-4-0"))
        c.eqStr("a graticule ring is drawn, not routed" ring.shape "polygon")
        c.ok("as a thin quadrilateral" ((array_length ring.shapePoints) == 8))
        c.ok("with no stroke of its own" ((fabs ring.borderWidth) < 0.001))
        c.ok("a polygon graticule has a corner on every spoke" ((g.hasNode("ring-4-3")) && ((g.hasNode("ring-4-4")) == false)))
        c.ok("and a spoke for every axis" (g.hasNode("spoke-3")))
        c.ok("each axis is named beside its spoke" (g.hasNode("axis-3")))
        def key:FlowNode (g.nodeById("key-1"))
        c.eqStr("and each curve gets a swatch in that curve's colour" key.bgColor (MermaidRadarFlow.colorAt(1)))
        c.ok("a radar chart is one this library draws" (MermaidReader.draws("radar")))
    }

    ; --------------------------------------------- Mermaid treemap --------
    ; A treemap says two things at once, and the second one is the one that can
    ; be got wrong quietly: the AREA is the number. So the assertions are about
    ; area — twice the number is twice the box — and about the indentation,
    ; which is the whole of the syntax.
    sfn testMermaidTreemap:void (c:Checker) {
        c.section("Mermaid treemaps")
        def src:string "treemap-beta\n"
        src = (src + "title Where it went\n")
        src = (src + "\"Big\"\n")
        src = (src + "    \"One\": 40\n")
        src = (src + "    \"Two\": 20\n")
        src = (src + "\"Small\": 30 :::warm\n")

        def d:MermaidTreemap (MermaidTreemapReader.parse(src))
        c.eqStr("the title is the line that says so" d.title "Where it went")
        c.eqInt("a box per line" (d.nodeCount()) 4)
        c.eqInt("and the indentation says which are at the top" (d.rootCount()) 2)
        def big:MermaidTreemapNode (itemAt d.nodes 0)
        c.eqStr("a name in quotes is the name without them" big.label "Big")
        c.ok("a branch was given no number of its own" (big.hasValue == false))
        c.ok("and is worth what is under it" ((fabs (big.total - 60.0)) < 0.001))
        def one:MermaidTreemapNode (itemAt d.nodes 1)
        c.eqInt("a line indented further is a child of the one above" one.parent 0)
        c.ok("and carries the number it was given" ((fabs (one.total - 40.0)) < 0.001))
        def small:MermaidTreemapNode (itemAt d.nodes 3)
        c.eqInt("a line indented back out is not" small.parent -1)
        c.eqStr("`:::` puts a class on a box" small.cssClass "warm")
        c.ok("without eating the number in front of it" ((fabs (small.total - 30.0)) < 0.001))
        c.ok("the total is the sum of the roots" ((fabs ((d.total()) - 90.0)) < 0.001))

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidTreemapFlow.build(d bare))
        c.eqInt("a treemap has no edges: the nesting is the relation" (g.edgeCount()) 0)
        def bOne:FlowNode (g.nodeById(one.id))
        def two:MermaidTreemapNode (itemAt d.nodes 2)
        def bTwo:FlowNode (g.nodeById(two.id))
        ; Twice the number is twice the AREA, not twice the width: a treemap
        ; that scaled one side would be a bar chart drawn as squares.
        def areaOne:double (bOne.width * bOne.height)
        def areaTwo:double (bTwo.width * bTwo.height)
        c.ok("twice the number is twice the area" ((fabs ((areaOne / areaTwo) - 2.0)) < 0.25))
        def branch:FlowNode (g.nodeById(big.id))
        c.ok("a child is drawn inside its parent" (bOne.x > branch.x))
        c.ok("and within its walls" (((bOne.x + bOne.width)) <= ((branch.x + branch.width) + 0.001)))
        c.ok("a branch writes its name in a strip at the top" (g.hasNode((big.id + "-name"))))
        c.ok("and a leaf writes its number with its name" ((indexOf bOne.label "40") > 0))
        c.eqStr("a leaf is coloured by the branch it belongs to" bOne.bgColor (MermaidTreemapFlow.colorAt(0)))
        def far:FlowNode (g.nodeById(small.id))
        c.eqStr("and a different branch is a different colour" far.bgColor (MermaidTreemapFlow.colorAt(1)))
        c.eqStr("`treemap-beta` is the same word" (MermaidReader.otherDiagram("treemap-beta")) "treemap")
        c.ok("a treemap is one this library draws" (MermaidReader.draws("treemap")))
    }

    ; --------------------------------------------- Mermaid tree view ------
    ; The same hierarchy the treemap draws by area, drawn as an outline. The
    ; order is the order it was written and nothing sorts it, so what the
    ; assertions are about is the three annotations — which are cut off the end
    ; of a line in an order that is not arbitrary.
    sfn testMermaidTreeView:void (c:Checker) {
        c.section("Mermaid tree views")
        def src:string "treeView-beta\n"
        src = (src + "title RangerFlow\n")
        src = (src + "core\n")
        src = (src + "    FlowView.rgr ## the view and its text fitting\n")
        src = (src + "    GraphModel.rgr icon(fa:file) ::: warm ## nodes and edges\n")
        src = (src + "tests\n")

        def d:MermaidTreeView (MermaidTreeViewReader.parse(src))
        c.eqStr("the title is the line that says so" d.title "RangerFlow")
        c.eqInt("a row per line" (d.nodeCount()) 4)
        c.eqInt("and the indentation says which are at the top" (d.rootCount()) 2)
        def one:MermaidTreeViewNode (itemAt d.nodes 1)
        c.eqInt("a line indented further is a child of the one above" one.parent 0)
        c.eqStr("`##` is a description written beside the row" one.description "the view and its text fitting")
        c.eqStr("and is not part of the name" one.label "FlowView.rgr")
        ; The description runs to the end of the line, so it is cut off FIRST
        ; or it swallows the other two annotations whole.
        def two:MermaidTreeViewNode (itemAt d.nodes 2)
        c.eqStr("three annotations on one row still leave the name" two.label "GraphModel.rgr")
        c.eqStr("`icon(…)` names an icon" two.icon "fa:file")
        c.eqStr("`:::` puts a class on the row" two.cssClass "warm")
        c.eqStr("and the description is still the description" two.description "nodes and edges")
        def last:MermaidTreeViewNode (itemAt d.nodes 3)
        c.eqInt("a line indented back out is a root again" last.parent -1)
        c.eqInt("three levels deep is a depth of two" (d.maxDepth()) 1)

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidTreeViewFlow.build(d bare))
        c.eqInt("a tree view has no edges: the rules are drawn, not routed" (g.edgeCount()) 0)
        def core:MermaidTreeViewNode (itemAt d.nodes 0)
        def rCore:FlowNode (g.nodeById(core.id))
        def rOne:FlowNode (g.nodeById(one.id))
        c.ok("a child is indented under its parent" (rOne.x > rCore.x))
        c.ok("and stands on the row below it" (rOne.y > rCore.y))
        def rLast:FlowNode (g.nodeById(last.id))
        c.ok("a root is back at the margin" ((fabs (rLast.x - rCore.x)) < 0.001))
        c.ok("every row is marked" (g.hasNode((one.id + "-mark"))))
        c.ok("and a description is written beside it" (g.hasNode((one.id + "-note"))))
        ; Mermaid resolves `icon(fa:file)` against an icon pack and there is
        ; none here. The name is kept where it can be read rather than turned
        ; into a picture this library would be guessing at.
        def rTwo:FlowNode (g.nodeById(two.id))
        c.eqStr("an icon nobody can draw is still an icon somebody asked for" rTwo.tooltip "icon(fa:file)")
        c.ok("the elbows are drawn as rules" (g.hasNode("tvline-0")))
        ; `otherDiagram` is asked the keyword in lower case, the way the
        ; statement reader hands it over — Mermaid's own detector is
        ; case-sensitive about the header and this reader is not.
        c.eqStr("`treeView-beta` is a word this reader knows" (MermaidReader.otherDiagram("treeview-beta")) "treeview")
        def d2:MermaidDiagram (MermaidReader.parse("treeView-beta\n  a\n"))
        c.eqStr("as it is written, capital V and all" d2.diagramKind "treeview")
        c.ok("a tree view is one this library draws" (MermaidReader.draws("treeview")))
    }

    ; --------------------------------------------- Mermaid event model ----
    ; Time across the page, kind down it. The lane a frame lands in is decided
    ; by the word the author used and is not a choice: an event drawn in the
    ; command lane is a different diagram. So that is what the assertions are
    ; about, along with the nine spellings Mermaid gives five kinds.
    sfn testMermaidEventModel:void (c:Checker) {
        c.section("Mermaid event models")
        def src:string "eventmodeling\n"
        src = (src + "entity Order\n")
        src = (src + "tf 1 ui OrderScreen\n")
        src = (src + "tf 2 command PlaceOrder ->> 1\n")
        src = (src + "tf 3 evt OrderPlaced ->> 2\n")
        src = (src + "tf 4 readmodel OpenOrders ->> 3 [[OrderJson]]\n")
        src = (src + "rf 5 ui Again ->> 4\n")
        src = (src + "gwt 2\n")
        src = (src + "given evt OrderPlaced\n")
        src = (src + "when cmd PlaceOrder\n")
        src = (src + "then evt OrderPlaced\n")

        def d:MermaidEventModel (MermaidEventModelReader.parse(src))
        c.eqInt("a frame per `tf` and per `rf`" (d.frameCount()) 5)
        c.eqInt("and a declaration per `entity`" (d.declaredCount()) 1)
        def f1:MermaidEmFrame (itemAt d.frames 0)
        c.eqStr("the number is the frame's name" f1.name "1")
        c.eqStr("and what follows the kind is the entity" f1.entity "OrderScreen")
        ; Nine spellings, five kinds: the lane is chosen by the kind, so the
        ; spellings have to collapse before anything is placed.
        def f2:MermaidEmFrame (itemAt d.frames 1)
        c.eqStr("`command` and `cmd` are one kind" f2.kind "cmd")
        def f4:MermaidEmFrame (itemAt d.frames 3)
        c.eqStr("so are `readmodel` and `rmo`" f4.kind "rmo")
        c.eqStr("`[[…]]` points at a declared data block" f4.dataRef "OrderJson")
        c.eqInt("`->>` says which frame this one follows" (array_length f2.sources) 1)
        c.eqStr("by that frame's number" (itemAt f2.sources 0) "1")
        def f5:MermaidEmFrame (itemAt d.frames 4)
        c.ok("`rf` is a frame where the story starts again" f5.reset)
        c.eqInt("the lanes are Mermaid's three" (MermaidEventModel.laneOf("ui")) 0)
        c.eqInt("a command shares its lane with a read model" (MermaidEventModel.laneOf("cmd")) (MermaidEventModel.laneOf("rmo")))
        c.ok("and an event has one of its own" ((MermaidEventModel.laneOf("evt")) != (MermaidEventModel.laneOf("cmd"))))
        c.eqInt("a `gwt` per block" (d.gwtCount()) 1)
        def gw:MermaidEmGwt (itemAt d.gwts 0)
        c.eqStr("hung on the frame it names" gw.frame "2")
        c.eqInt("with its givens" (array_length gw.givens) 1)
        c.eqInt("its whens" (array_length gw.whens) 1)
        c.eqInt("and its thens" (array_length gw.thens) 1)

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidEventModelFlow.build(d bare))
        def screen:FlowNode (g.nodeById("frame-1"))
        def place:FlowNode (g.nodeById("frame-2"))
        def placed:FlowNode (g.nodeById("frame-3"))
        c.ok("the frames run left to right in the order written" (place.x > screen.x))
        c.ok("a command stands below the screen that raised it" (place.y > screen.y))
        c.ok("and an event below the command" (placed.y > place.y))
        c.eqStr("a command is drawn in the colour event modelling gives it" place.bgColor (MermaidEventModelFlow.fillFor("cmd")))
        c.ok("all three lanes are drawn, whether or not anything is in them" ((g.hasNode("lane-0")) && (g.hasNode("lane-2"))))
        c.ok("each with its name beside it" (g.hasNode("lane-1-name")))
        c.eqInt("an arrow per `->>`, and none besides" (g.edgeCount()) 4)
        c.ok("a reset frame is marked with a rule" (g.hasNode("reset-5")))
        c.ok("a data reference is written under its box" (g.hasNode("frame-4-data")))
        c.ok("and the given/when/then goes below the lanes" (g.hasNode("gwt-0")))
        ; Mermaid's own grammar rejects `title` in an event model, and a reader
        ; that accepted one would take a file Mermaid will not take.
        def titled:MermaidEventModel (MermaidEventModelReader.parse("eventmodeling\ntitle Nope\ntf 1 ui A\n"))
        c.eqInt("a title is not part of this diagram" (titled.frameCount()) 1)
        c.ok("an event model is one this library draws" (MermaidReader.draws("eventmodeling")))
    }

    ; The edge with a given id. `FlowGraph` indexes nodes by name and edges by
    ; nothing, because an edge is normally reached from the node it leaves.
    sfn edgeNamed:FlowEdge (g:FlowGraph id:string) {
        def i:int 0
        while (i < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(i))
            if (e.id == id) {
                return e
            }
            i = (i + 1)
        }
        return (new FlowEdge)
    }

    ; --------------------------------------------- Mermaid packet ---------
    ; A packet diagram is arithmetic on bit numbers, and the arithmetic that
    ; matters is the WRAP: a field of 64 bits on a 32-bit ruler is two boxes
    ; on two rows, not one box twice as wide as the diagram.
    sfn testMermaidPacket:void (c:Checker) {
        c.section("Mermaid packet diagrams")
        def src:string "---\n"
        src = (src + "title: \"TCP Packet\"\n")
        src = (src + "---\n")
        src = (src + "packet\n")
        src = (src + "0-15: \"Source Port\"\n")
        src = (src + "16-31: \"Destination Port\"\n")
        src = (src + "32-63: \"Sequence Number\"\n")
        src = (src + "64: \"URG\"\n")
        src = (src + "+7: \"Flags\"\n")
        src = (src + "192-255: \"Data\"\n")

        def d:MermaidPacket (MermaidPacketReader.parse(src))
        c.eqStr("the title comes out of the front matter" d.title "TCP Packet")
        c.eqInt("one field per line" (d.fieldCount()) 6)
        def f0:MermaidPacketField (itemAt d.fields 0)
        c.eqInt("`0-15` starts at nought" f0.start 0)
        c.eqInt("and ends at fifteen" f0.endBit 15)
        c.eqInt("which is sixteen bits, not fifteen" (f0.bits()) 16)
        def one:MermaidPacketField (itemAt d.fields 3)
        c.eqInt("a bare number is one bit wide" (one.bits()) 1)
        def plus:MermaidPacketField (itemAt d.fields 4)
        c.eqInt("`+7` starts where the last field stopped" plus.start 65)
        c.eqInt("and is seven bits long" (plus.bits()) 7)
        c.eqInt("the ruler is 32 bits wide unless told otherwise" d.bitsPerRow 32)
        c.eqInt("256 bits is eight rows of it" (d.rowCount()) 8)

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidPacketFlow.build(d bare))
        c.eqInt("a packet diagram has no edges" (g.edgeCount()) 0)
        def first:FlowNode (g.nodeById("fld-0-0"))
        c.eqStr("a field is a box with its name in it" first.label "Source Port")
        def second:FlowNode (g.nodeById("fld-16-0"))
        c.ok("the next field is to its right" (second.x > first.x))
        c.ok("on the same row" ((fabs (second.y - first.y)) < 0.001))
        def third:FlowNode (g.nodeById("fld-32-0"))
        c.ok("and bit 32 has wrapped onto the next one" (third.y > first.y))
        c.ok("starting back at the left margin" ((fabs (third.x - first.x)) < 0.001))
        ; The wrap. `192-255` is 64 bits on a 32-bit ruler, so it is two boxes.
        def wideA:FlowNode (g.nodeById("fld-192-0"))
        def wideB:FlowNode (g.nodeById("fld-192-1"))
        c.ok("a field longer than the ruler is drawn twice" (wideB.y > wideA.y))
        c.eqStr("with its name in both halves" wideB.label "Data")
        c.ok("and neither half is wider than the ruler" (wideA.width <= ((to_double d.bitsPerRow) * (MermaidPacketFlow.bitWidthFor(d)))))
        ; The bit numbers are the diagram: without them it is a row of words.
        def tick:FlowNode (g.nodeById("fld-0-0-a"))
        c.eqStr("each box says which bit it starts at" tick.label "0")
        def tickEnd:FlowNode (g.nodeById("fld-0-0-b"))
        c.eqStr("and which one it ends at" tickEnd.label "15")
        c.ok("the numbers sit above the box, not in it" (tick.y < first.y))
        c.ok("a one-bit field says its number once" ((g.hasNode("fld-64-0-b")) == false))
        ; A ruler scaled to the wide fields draws `URG` as an ellipsis.
        def flags:string "packet\n0: \"URG\"\n1-31: \"Rest\"\n"
        def fd:MermaidPacket (MermaidPacketReader.parse(flags))
        def wide:double (MermaidPacketFlow.bitWidthFor(fd))
        c.ok("a one-bit field with a word in it widens the ruler" (wide > 27.0))
        def plain:MermaidPacket (MermaidPacketReader.parse("packet\n0-31: \"A\"\n"))
        c.ok("and one without leaves it alone" ((fabs ((MermaidPacketFlow.bitWidthFor(plain)) - 27.0)) < 0.001))
        c.eqStr("`packet-beta` is the same word" (MermaidReader.otherDiagram("packet-beta")) "packet")
        c.ok("a packet diagram is one this library draws" (MermaidReader.draws("packet")))
    }

    ; --------------------------------------------- a link to a subgraph ---
    ; `C --> O` where `subgraph O` exists means the GROUP. Mermaid keeps `O`
    ; as a vertex all the same — the clustering is a drawing decision, not a
    ; parsing one — so the model has to say what Mermaid's says and only the
    ; drawing may differ. Both halves are checked here, because doing it to
    ; the model instead deleted vertices Mermaid keeps.
    sfn testMermaidSubgraphEnds:void (c:Checker) {
        c.section("Mermaid links that name a subgraph")
        def src:string "flowchart TB\n"
        src = (src + "  C[\"Compiler\"]\n")
        src = (src + "  subgraph O[\"Office\"]\n")
        src = (src + "    W[\"Word\"]\n")
        src = (src + "    E[\"Excel\"]\n")
        src = (src + "  end\n")
        src = (src + "  EVG[\"EVG\"]\n")
        src = (src + "  C --> O\n")
        src = (src + "  O --> EVG\n")

        def d:MermaidDiagram (MermaidReader.parse(src))
        ; The model is Mermaid's: `O` is a vertex and the links name it.
        c.eqInt("the subgraph id stays a vertex, as it is in Mermaid" (d.nodeCount()) 5)
        c.ok("under its own name" ((d.indexOfStep("O")) >= 0))
        def first:FlowLink (itemAt d.chart.links 0)
        c.eqStr("and the link still names it" first.target "O")
        c.eqInt("one link per arrow written" (d.linkCount()) 2)

        def bare (new FlowStyle)
        def g:FlowGraph (MermaidFlow.styled(d bare))
        ; The drawing is Mermaid's too: no box called O, and the arrows go to
        ; the frame. Until this was fixed the layout got an extra box named
        ; after the group and the arrows went to that instead.
        c.ok("no box is drawn for the group's own id" ((g.hasNode("O")) == false))
        c.ok("the frame is there to point at" (g.hasNode("sg-O")))
        def toFrame:int 0
        def fromFrame:int 0
        def hidden:int 0
        def i:int 0
        while (i < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(i))
            if e.hidden {
                hidden = (hidden + 1)
            } {
                if (e.target == "sg-O") { toFrame = (toFrame + 1) }
                if (e.source == "sg-O") { fromFrame = (fromFrame + 1) }
            }
            i = (i + 1)
        }
        c.eqInt("one arrow arrives at the frame, not one per member" toFrame 1)
        c.eqInt("and one leaves it" fromFrame 1)
        ; The layout ranks by longest path and has no idea what a group is, so
        ; an arrow into ONE member would rank that member below its siblings
        ; and the group would come apart. The stand-ins are what stop that.
        c.ok("with a stand-in per remaining member, hidden" (hidden > 0))
        def w:FlowNode (g.nodeById("W"))
        def e2:FlowNode (g.nodeById("E"))
        c.ok("so the members stay on one rank" ((fabs (w.y - e2.y)) < 1.0))
        def cc:FlowNode (g.nodeById("C"))
        def frame:FlowNode (g.nodeById("sg-O"))
        c.ok("and the group sits below what points at it" (frame.y > cc.y))
        def evg:FlowNode (g.nodeById("EVG"))
        c.ok("and above what it points at" (evg.y > frame.y))
    }

    ; --------------------------------------------- a click is not an edit --
    ; The page re-fans the lanes and re-routes whatever a gesture put in the
    ; way — and it has to know which gestures those were. `onGraphChanged` is
    ; that answer, and it is the difference between a diagram that sits still
    ; while you read it and one that rearranges itself when you click a box.
    sfn testClickChangesNothing:void (c:Checker) {
        c.section("a click is not an edit")
        def g (new FlowGraph)
        def a:FlowNode (FlowNode.create("a" "One" 40.0 40.0))
        a.width = 120.0
        a.height = 50.0
        g.addNode(a)
        def b:FlowNode (FlowNode.create("b" "Two" 40.0 240.0))
        b.width = 120.0
        b.height = 50.0
        g.addNode(b)
        g.addEdge((FlowEdge.create("e" "a" "b")))
        g.reindex()
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(800.0 600.0)

        def input (new FlowInput)
        def sx:double (ed.view.viewport.toScreenX((a.centerX())))
        def sy:double (ed.view.viewport.toScreenY((a.centerY())))
        input.x = sx
        input.y = sy
        ed.pointerDown(input)
        ed.pointerUp(input)
        c.ok("clicking a node selects it" a.selected)
        c.ok("and reports no change to the graph" (ed.onGraphChanged == false))

        ; The same gesture with a move in the middle of it is an edit.
        ed.pointerDown(input)
        input.x = (sx + 60.0)
        input.y = (sy + 40.0)
        ed.pointerMove(input)
        ed.pointerUp(input)
        c.ok("dragging one does report a change" ed.onGraphChanged)
    }

    ; ---------------------------------------------------------- stylesheets --
    ; The look, as CSS. EVG's own engine does the parsing and the cascade; what
    ; is asserted here is the vocabulary — which property means which field —
    ; and that a node can be reached by everything it is: its type, its shape,
    ; its id and whatever the domain called it.
    sfn testStyleSheet:void (c:Checker) {
        c.section("stylesheets")
        def g (new FlowGraph)
        def a:FlowNode (FlowNode.create("a" "Start" 0.0 0.0))
        a.nodeType = "step"
        a.shape = "stadium"
        a.cssClass = "terminator"
        g.addNode(a)
        def b:FlowNode (FlowNode.create("b" "Ok?" 0.0 120.0))
        b.nodeType = "step"
        b.shape = "diamond"
        b.cssClass = "decision warn"
        g.addNode(b)
        def e:FlowEdge (FlowEdge.create("e1" "a" "b"))
        e.cssClass = "link dotted"
        g.addEdge(e)
        g.reindex()

        def css:string "@vars { --ink: #101010; --paper: #fdfdfd }\n"
        css = (css + ".node { fill: #ffffff; stroke: #cccccc; color: var(--ink); border-width: 2px }\n")
        css = (css + ".decision { fill: #fff6e5 }\n")
        css = (css + ".shape-stadium { border-radius: 22px }\n")
        css = (css + ".id-b { accent-color: #ff0000 }\n")
        css = (css + ".edge { stroke: #445566; stroke-width: 1.5px; marker-end: none }\n")
        css = (css + ".dotted { stroke-dasharray: 4px }\n")
        css = (css + ".canvas { background: var(--paper); edge-color: #445566; background-variant: lines }\n")
        css = (css + ".theme-dark .node { fill: #1b202a; color: #e6e9ef }\n")
        def st:FlowStyle (FlowStyle.parse(css))
        c.eqInt("the sheet parsed with nothing left over" (st.errorCount()) 0)
        c.eqInt("every rule was kept" (st.ruleCount()) 8)

        def wrote:int (st.applyTo(g))
        c.ok("and it wrote something" (wrote > 0))
        c.eqStr("a class from the domain paints the box" b.bgColor "#fff6e5")
        c.eqStr("`.node` reaches a node with no classes of its own" a.bgColor "#ffffff")
        c.eqStr("a var() is resolved before it arrives" a.textColor "#101010")
        c.near("a length loses its unit" a.borderWidth 2.0 0.001)
        c.near("the shape is a selector" a.borderRadius 22.0 0.001)
        c.eqStr("and so is the id" b.accentColor "#ff0000")
        c.eqStr("an edge is styled by the same sheet" e.strokeColor "#445566")
        c.near("its width in the same units" e.strokeWidth 1.5 0.001)
        c.near("and `stroke-dasharray` is the dash" e.dash 4.0 0.001)
        c.eqStr("`none` means the model's empty rather than the word" e.markerEnd "")

        ; The canvas: the values a renderer reads before it draws anything.
        def theme (new FlowTheme)
        def themed:int (st.applyToTheme(theme))
        c.ok("the canvas rule reached the theme" (themed > 0))
        c.eqStr("the paper is the sheet's" theme.background "#fdfdfd")
        c.eqInt("and so is the grid" theme.backgroundVariant 2)

        ; A theme-scoped rule beats an unscoped one, whatever the source order.
        st.setTheme("dark")
        st.applyTo(g)
        c.eqStr("a theme-scoped rule wins" a.bgColor "#1b202a")
        c.eqStr("...for every property it names" a.textColor "#e6e9ef")
        ; The engine has exactly one precedence rule — theme-scoped beats
        ; unscoped — and it is not specificity: `.theme-dark .node` wins over
        ; `.decision` even though the second names the more particular thing.
        ; That is why the looks that ship here vary a `@vars` block instead of
        ; restating the rules under a theme.
        c.eqStr("a theme-scoped rule beats an unscoped one, specific or not" b.bgColor "#1b202a")

        ; The looks that ship with it.
        c.ok("the built-in names are known" (FlowStyles.knows("forest")))
        c.ok("...including print" (FlowStyles.knows("print")))
        c.ok("and an invented one is not" ((FlowStyles.knows("neon")) == false))
        def dark:FlowStyle (FlowStyle.named("dark"))
        c.eqInt("the built-in sheet parses cleanly" (dark.errorCount()) 0)
        def dt (new FlowTheme)
        dark.applyToTheme(dt)
        c.eqStr("and its canvas is dark" dt.background "#12151c")
    }

    ; A Mermaid diagram in a look it did not choose — and the one rule that
    ; decides what the diagram still gets to say for itself.
    sfn testMermaidStyled:void (c:Checker) {
        c.section("Mermaid, restyled")
        def src:string "%%{init: {'theme':'forest'}}%%\n"
        src = (src + "flowchart TD\n")
        src = (src + "    A([Start]) --> B{Ok?}\n")
        src = (src + "    B --> C[Reject]\n")
        src = (src + "    classDef stop fill:#fee,stroke:#c66\n")
        src = (src + "    class C stop\n")
        def d:MermaidDiagram (MermaidReader.parse(src))
        c.eqStr("an init directive names a theme" d.themeName "forest")

        ; The classes a sheet matches a Mermaid node by.
        def plain:FlowGraph (d.build())
        def bNode:FlowNode (plain.nodeById("B"))
        c.ok("a node wears its kind" ((indexOf bNode.cssClass "decision") >= 0))
        c.ok("and the Mermaid shape it was written as" ((indexOf bNode.cssClass "rhombus") >= 0))
        def cNode:FlowNode (plain.nodeById("C"))
        c.ok("and every classDef it was given" ((indexOf cNode.cssClass "stop") >= 0))

        ; A sheet under the diagram: it paints what the diagram did not.
        def sheet:FlowStyle (FlowStyle.parse(".node { fill: #101010 } .decision { fill: #202020 }"))
        def g:FlowGraph (MermaidFlow.styled(d sheet))
        def sB:FlowNode (g.nodeById("B"))
        c.eqStr("the sheet paints a node the diagram said nothing about" sB.bgColor "#202020")
        def sC:FlowNode (g.nodeById("C"))
        c.eqStr("and a classDef still beats it" sC.bgColor "#fee")
        c.eqStr("a dark fill from a classDef gets readable text" sC.textColor "#1f2430")

        ; ...unless the caller says the sheet wins.
        def strong:FlowStyle (FlowStyle.parse(".node { fill: #101010 } .decision { fill: #202020 }"))
        strong.strong = true
        def g2:FlowGraph (MermaidFlow.styled(d strong))
        def s2C:FlowNode (g2.nodeById("C"))
        c.eqStr("with the sheet last, the sheet wins" s2C.bgColor "#101010")

        ; A subgraph frame is made after the layout, and still gets the look.
        def sub:string "flowchart TD\n  subgraph one [One]\n    A --> B\n  end\n"
        def sd:MermaidDiagram (MermaidReader.parse(sub))
        def frameSheet:FlowStyle (FlowStyle.parse(".frame { fill: #001122; stroke: #334455 }"))
        def fg:FlowGraph (MermaidFlow.styled(sd frameSheet))
        def frame:FlowNode (fg.nodeById("sg-one"))
        c.eqStr("the frame is styled too" frame.bgColor "#001122")
        c.eqStr("border and all" frame.borderColor "#334455")
    }

    ; ------------------------------------------------------ business charts --
    sfn testBusinessCharts:void (c:Checker) {
        c.section("org chart and swimlanes")
        def o (new OrgChart)
        o.unitColor("Johto" "#eef2ff")
        o.person("a" "Aino" "toimitusjohtaja" "Johto" "")
        o.person("b" "Markus" "teknologiajohtaja" "Johto" "a")
        o.person("d" "Sanna" "kehityspäällikkö" "Tuotanto" "b")
        def dotted:OrgPerson (o.person("e" "Elina" "analyytikko" "Talous" "d"))
        dotted.dotted = true
        def og:FlowGraph (o.build())
        c.eqInt("everyone is a node" (og.nodeCount()) 4)
        c.eqInt("and every reporting line an edge" (og.edgeCount()) 3)
        def boss:FlowNode (og.nodeById("a"))
        c.eqStr("a person's unit colours the box" boss.bgColor "#eef2ff")
        c.eqInt("and the role goes in a compartment" (boss.totalRowCount()) 1)
        def dashCount:int 0
        def k:int 0
        while (k < (og.edgeCount())) {
            def e:FlowEdge (og.edgeAt(k))
            if (e.dash > 0.0) {
                dashCount = (dashCount + 1)
            }
            k = (k + 1)
        }
        c.eqInt("a matrix report is dashed and the rest are not" dashCount 1)

        ; --- swimlanes ---
        def p (new SwimlaneProcess)
        p.lane("asiakas" "Asiakas")
        p.lane("myynti" "Myynti")
        p.step("tilaa" "Tilaa" "asiakas" (FlowShape.stadium()))
        p.step("ota" "Vastaanota" "myynti" (FlowShape.rect()))
        p.step("ehto" "Ok?" "myynti" (FlowShape.diamond()))
        p.step("valmis" "Valmis" "asiakas" (FlowShape.stadium()))
        p.link("tilaa" "ota")
        p.link("ota" "ehto")
        p.link("ehto" "valmis")
        def pg:FlowGraph (p.build())
        c.eqInt("two lanes and four steps" (pg.nodeCount()) 6)
        def lane0:FlowNode (pg.nodeById("asiakas"))
        c.eqStr("a lane is a group node" lane0.nodeType "group")
        def tilaa:FlowNode (pg.nodeById("tilaa"))
        c.eqStr("and a step in it says so" tilaa.parentId "asiakas")
        ; The columns come from the links, so a step that waits for another
        ; stands to the right of it whatever order they were declared in.
        def ota:FlowNode (pg.nodeById("ota"))
        def ehto2:FlowNode (pg.nodeById("ehto"))
        c.ok("a step stands right of the one it waits for" ((ota.centerX()) > (tilaa.centerX())))
        c.ok("and so does the one after that" ((ehto2.centerX()) > (ota.centerX())))
        ; And the rows are the lanes, not something a layout chose.
        def valmis:FlowNode (pg.nodeById("valmis"))
        c.near("two steps in one lane share its row" (tilaa.centerY()) (valmis.centerY()) 0.001)
        c.ok("and a step in the next lane does not" ((ota.centerY()) > (tilaa.centerY())))
        c.ok("every step is inside its own lane" (RangerFlowTest.stepsAreInLanes(pg)))

        ; Dragging a lane takes its steps with it. That is the whole reason a
        ; lane is a node rather than a rectangle painted on the background.
        def ed:FlowEditor (FlowEditor.of(pg))
        ed.setSize(1400.0 800.0)
        ed.view.showControls = false
        ed.view.showMinimap = false
        def beforeX:double tilaa.x
        def beforeY:double tilaa.y
        def otaBeforeX:double ota.x
        lane0.selected = true
        ed.beginDrag()
        ed.mode = 2
        def inp (new FlowInput)
        inp.x = 0.0
        inp.y = 0.0
        ed.pressX = 0.0
        ed.pressY = 0.0
        ed.lastX = 0.0
        ed.lastY = 0.0
        inp.x = 60.0
        inp.y = 25.0
        ed.pointerMove(inp)
        ed.pointerUp(inp)
        c.near("the lane's step came with it, across" tilaa.x (beforeX + 60.0) 0.001)
        c.near("and down" tilaa.y (beforeY + 25.0) 0.001)
        c.near("a step in another lane stayed where it was" ota.x otaBeforeX 0.001)
    }

    sfn stepsAreInLanes:boolean (g:FlowGraph) {
        def i:int 0
        while (i < (g.nodeCount())) {
            def n:FlowNode (g.nodeAt(i))
            if ((strlen n.parentId) > 0) {
                if (g.hasNode(n.parentId)) {
                    def lane:FlowNode (g.nodeById(n.parentId))
                    if (n.y < lane.y) { return false }
                    if ((n.y + n.height) > (lane.y + lane.height)) { return false }
                    if (n.x < lane.x) { return false }
                    if ((n.x + n.width) > (lane.x + lane.width)) { return false }
                }
            }
            i = (i + 1)
        }
        return true
    }

    ; ------------------------------------------------------------ authoring --
    ; What the toolbar does, driven the way the toolbar drives it.
    sfn testAuthoring:void (c:Checker) {
        c.section("adding nodes and connections")
        def g (new FlowGraph)
        def seed:FlowNode (g.node("seed" "Alku" 0.0 0.0))
        seed.width = 140.0
        seed.height = 50.0
        g.reindex()
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(900.0 600.0)
        ed.view.showControls = false
        ed.view.showMinimap = false

        def a:FlowNode (ed.addNode("Vaihe" (FlowShape.rect()) 300.0 200.0))
        c.eqInt("the palette added a node" (g.nodeCount()) 2)
        c.eqStr("with the shape that was asked for" a.shape "rect")
        c.near("centred on the point it was dropped at" (a.centerX()) 300.0 0.001)
        c.near("in both axes" (a.centerY()) 200.0 0.001)
        c.ok("and selected, so the name field has something to edit" a.selected)
        c.eqStr("which is what selectedNodeId reports" (ed.selectedNodeId()) a.id)

        def b:FlowNode (ed.addNode("Ehto?" (FlowShape.diamond()) 300.0 400.0))
        c.eqInt("a second one gets its own id" (g.nodeCount()) 3)
        c.ok("with a different id from the first" (b.id != a.id))
        c.ok("adding replaces the selection rather than adding to it" (a.selected == false))

        c.ok("rename writes to the selected node" (ed.renameSelected("Nimetty")))
        c.eqStr("and it took" b.label "Nimetty")

        c.ok("two nodes can be joined" (ed.connectNodes(a.id b.id)))
        c.eqInt("which makes one edge" (g.edgeCount()) 1)
        c.ok("the same pair twice does not" ((ed.connectNodes(a.id b.id)) == false))
        c.ok("nor does a node to itself" ((ed.connectNodes(a.id a.id)) == false))
        c.eqInt("so there is still one edge" (g.edgeCount()) 1)

        ; Undo, one step per action, in the order they were done.
        c.ok("the connection undoes" (ed.undo.undo(g)))
        c.eqInt("leaving no edge" (g.edgeCount()) 0)
        c.ok("then the second node" (ed.undo.undo(g)))
        c.eqInt("leaving two nodes" (g.nodeCount()) 2)
        c.ok("then the first" (ed.undo.undo(g)))
        c.eqInt("back to what we started with" (g.nodeCount()) 1)
        c.ok("and redo puts it back" (ed.undo.redo(g)))
        c.eqInt("one node at a time" (g.nodeCount()) 2)
    }

    ; ------------------------------------------------------ tree layouts -----
    sfn testTreeLayouts:void (c:Checker) {
        c.section("radial and mind map")
        def g (new FlowGraph)
        def root:FlowNode (g.node("r" "root" 0.0 0.0))
        root.width = 140.0
        root.height = 50.0
        def b:int 0
        while (b < 3) {
            def bid:string ("b" + (to_string b))
            def bn:FlowNode (g.node(bid bid 0.0 0.0))
            bn.width = 130.0
            bn.height = 44.0
            g.connect("r" bid)
            def l:int 0
            while (l < 2) {
                def lid:string ((bid + "-") + (to_string l))
                def ln:FlowNode (g.node(lid lid 0.0 0.0))
                ln.width = 120.0
                ln.height = 40.0
                g.connect(bid lid)
                l = (l + 1)
            }
            b = (b + 1)
        }
        g.reindex()

        ; The tree is FOUND, not declared: a graph has edges, not parents.
        def t:FlowTree (FlowTree.of(g ""))
        c.eqInt("the root is the node nothing points at" t.root (g.indexOfNode("r")))
        c.eqInt("every node is reached" (array_length t.order) (g.nodeCount()))
        c.eqInt("a branch is one step from the root" (itemAt t.depth (g.indexOfNode("b0"))) 1)
        c.eqInt("and a leaf is two" (itemAt t.depth (g.indexOfNode("b0-0"))) 2)
        c.eqInt("the root has three children" (t.childCount(t.root)) 3)

        def rad:RadialLayout (RadialLayout.of(g))
        rad.rootId = "r"
        c.eqInt("the radial layout places everything but the root" (rad.run()) 9)
        c.near("with the root at the centre" (root.centerX()) 0.0 0.001)
        c.near("in both axes" (root.centerY()) 0.0 0.001)
        def near:FlowNode (g.nodeById("b0"))
        def far:FlowNode (g.nodeById("b0-0"))
        def dNear:double (RangerFlowTest.distBetween(near root))
        def dFar:double (RangerFlowTest.distBetween(far root))
        c.ok(("each generation is on a wider ring (" + (to_string dNear) + " then " + (to_string dFar) + ")") (dFar > dNear))
        c.eqInt("and no box is drawn over another" (RangerFlowTest.overlapCount(g)) 0)

        ; …and the same graph as a mind map.
        def mind:MindMapLayout (MindMapLayout.of(g))
        mind.rootId = "r"
        c.eqInt("the mind map places everything but the root" (mind.run()) 9)
        def left:int 0
        def right:int 0
        def i:int 0
        while (i < (g.nodeCount())) {
            def n:FlowNode (g.nodeAt(i))
            if (n.id != "r") {
                if ((n.centerX()) > 0.0) { right = (right + 1) }
                if ((n.centerX()) < 0.0) { left = (left + 1) }
            }
            i = (i + 1)
        }
        c.ok(("both sides of the root are used (" + (to_string left) + " left, " + (to_string right) + " right)") (left > 0))
        c.ok("and neither is empty" (right > 0))
        c.eqInt("no box is drawn over another here either" (RangerFlowTest.overlapCount(g)) 0)
        ; A child is always further out than its parent, which is the one thing
        ; that makes a mind map readable outwards.
        def wrongWay:int 0
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            def pa:FlowNode (g.nodeAt(e.sourceIndex))
            def ch:FlowNode (g.nodeAt(e.targetIndex))
            if ((fabs (ch.centerX())) <= (fabs (pa.centerX()))) {
                wrongWay = (wrongWay + 1)
            }
            k = (k + 1)
        }
        c.eqInt("every child is further from the middle than its parent" wrongWay 0)
    }

    sfn distBetween:double (a:FlowNode b:FlowNode) {
        def dx:double ((a.centerX()) - (b.centerX()))
        def dy:double ((a.centerY()) - (b.centerY()))
        return (sqrt ((dx * dx) + (dy * dy)))
    }

    sfn overlapCount:int (g:FlowGraph) {
        def n:int 0
        def i:int 0
        while (i < (g.nodeCount())) {
            def a:FlowNode (g.nodeAt(i))
            def ra:FlowRect (a.rect())
            def j:int (i + 1)
            while (j < (g.nodeCount())) {
                def b:FlowNode (g.nodeAt(j))
                def rb:FlowRect (b.rect())
                if ((ra.overlapArea(rb)) > 0.0) {
                    n = (n + 1)
                }
                j = (j + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; ------------------------------------------------------- line jumps ------
    ; Two lines meeting at a point are ambiguous about whether they join. A hop
    ; says they do not — JointJS's `jumpover`, Syncfusion's connector bridging.
    sfn testLineJumps:void (c:Checker) {
        c.section("line jumps")
        def line:[double]
        push line 0.0
        push line 50.0
        push line 200.0
        push line 50.0
        def cross:[double]
        push cross 100.0
        push cross 0.0
        push cross 100.0
        push cross 100.0
        def hopped:[double] (EdgeRouter.bridgePolyline(line cross 6.0))
        def n:int (idiv (array_length hopped) 2)
        c.ok(("the hop adds points (got " + (to_string n) + ")") (n > 2))
        c.near("the line still starts where it did" (itemAt hopped 0) 0.0 0.001)
        c.near("and ends where it did" (itemAt hopped ((n - 1) * 2)) 200.0 0.001)
        ; The bulge is at the crossing, and it is a real bulge.
        def away:double 0.0
        def atX:double 0.0
        def i:int 0
        while (i < n) {
            def yAt:int ((i * 2) + 1)
            def off:double (fabs ((itemAt hopped yAt) - 50.0))
            if (off > away) {
                away = off
                atX = (itemAt hopped (i * 2))
            }
            i = (i + 1)
        }
        c.ok(("the hop leaves the line (got " + (to_string away) + ")") (away > 4.0))
        c.near("right where the other line crosses" atX 100.0 8.0)

        ; The hop has to be walked the way the LINE is going. This is the
        ; assertion the first version did not have, and the bug it did not
        ; catch: the arc was swept from π to 0, so the points came back
        ; entry-point, then a half-circle running BACKWARDS to the entry
        ; point, then the exit. Every check above still passed — the bulge was
        ; there, in the right place, the right size — and what was drawn was a
        ; bow tie. A shape is not proved by its extremes.
        def backwards:int 0
        def j:int 1
        while (j < n) {
            def prevX:double (itemAt hopped ((j - 1) * 2))
            def hereX:double (itemAt hopped (j * 2))
            if (hereX < (prevX - 0.001)) {
                backwards = (backwards + 1)
            }
            j = (j + 1)
        }
        c.eqInt("and every point of it advances along the line" backwards 0)
        ; …and the bulge is all on ONE side. A half-circle that crossed the
        ; line would also advance monotonically and would still be wrong.
        def aboveN:int 0
        def belowN:int 0
        def k2:int 0
        while (k2 < n) {
            def yy:double (itemAt hopped ((k2 * 2) + 1))
            if (yy < 49.999) { aboveN = (aboveN + 1) }
            if (yy > 50.001) { belowN = (belowN + 1) }
            k2 = (k2 + 1)
        }
        c.ok("the hop stays on one side of the line" ((aboveN == 0) || (belowN == 0)))

        ; The hop reaches SVG and PDF as a real half-circle rather than as a
        ; sixteen-sided approximation of one. The polyline is still what the
        ; GPU draws — a display list has no arcs — so the two have to agree
        ; about where the hop starts and ends, and they do because one pass
        ; produced both.
        def marks:[double]
        def hopped2:[double] (EdgeRouter.bridgeInto(line cross 6.0 marks))
        c.eqInt("one hop, one mark of five numbers" (array_length marks) 5)
        def d:string (FlowScene.bridgedPath(hopped2 marks))
        c.ok("the path carries an arc command" ((RangerFlowTest.hasSub(d " A ")) ))
        ; The arc ends where the polyline's hop ends.
        def exitX:double (itemAt marks 2)
        def exitY:double (itemAt marks 3)
        c.ok("and the arc lands on the polyline's exit" (RangerFlowTest.hasSub(d ((EVGDisplayList.num(exitX)) + " " + (EVGDisplayList.num(exitY))))))
        c.near("the radius is the one asked for" (itemAt marks 4) 6.0 0.001)
        ; No crossings, no marks, and the path is a plain polyline.
        def noMarks:[double]
        def plainD:string (FlowScene.bridgedPath(line noMarks))
        c.ok("a line with no hops has no arc in it" ((RangerFlowTest.hasSub(plainD " A ")) == false))

        ; A line with nothing to cross is left exactly as it was.
        def alone:[double]
        def none:[double] (EdgeRouter.bridgePolyline(line alone 6.0))
        c.eqInt("a line that crosses nothing is untouched" (idiv (array_length none) 2) 2)

        ; Two crossings, two hops.
        def twoCross:[double]
        push twoCross 60.0
        push twoCross 0.0
        push twoCross 60.0
        push twoCross 100.0
        push twoCross 140.0
        push twoCross 0.0
        push twoCross 140.0
        push twoCross 100.0
        def twice:[double] (EdgeRouter.bridgePolyline(line twoCross 6.0))
        def bumps:int 0
        def k:int 1
        while (k < (idiv (array_length twice) 2)) {
            def prevAt:int (((k - 1) * 2) + 1)
            def curAt:int ((k * 2) + 1)
            def wasOn:boolean ((fabs ((itemAt twice prevAt) - 50.0)) < 0.001)
            def isOff:boolean ((fabs ((itemAt twice curAt) - 50.0)) > 0.001)
            if wasOn {
                if isOff {
                    bumps = (bumps + 1)
                }
            }
            k = (k + 1)
        }
        c.eqInt("two crossings make two hops" bumps 2)
    }

    ; ------------------------------------------------------ serialization ----
    sfn testSerialization:void (c:Checker) {
        c.section("saving and opening a diagram")
        def g (new FlowGraph)
        def t:FlowNode (g.node("customers" "customers" 40.0 80.0))
        t.width = 210.0
        t.shape = (FlowShape.rect())
        def sec:FlowSection (t.addSection(""))
        def row:FlowRow (FlowRow.create("pk" "id" "INTEGER" "PK"))
        row.portId = "customers.id"
        row.emphasis = 1
        sec.addRow(row)
        def added:FlowRow (FlowRow.create("" "kanta_asiakas" "BOOLEAN" ""))
        added.portId = "customers.col1"
        sec.addRow(added)
        t.layoutCompartments()
        def d:FlowNode (g.node("check" "Luotto ok?" 400.0 80.0))
        d.width = 160.0
        d.height = 90.0
        d.shape = (FlowShape.diamond())
        def e:FlowEdge (g.connect("customers" "check"))
        e.edgeType = "smoothstep"
        e.label = "kyllä"
        g.reindex()

        def json:string (FlowGraphJson.toJson(g))
        def back:FlowGraph (FlowGraphJson.fromJson(json))
        c.eqInt("every node comes back" (back.nodeCount()) 2)
        c.eqInt("and every edge" (back.edgeCount()) 1)
        def bt:FlowNode (back.nodeById("customers"))
        c.eqStr("with its label" bt.label "customers")
        c.near("its position" bt.x 40.0 0.001)
        c.near("and its size" bt.width 210.0 0.001)
        c.eqInt("its compartments" (bt.totalRowCount()) 2)
        def brow:FlowRow (FlowUndo.rowOf(bt 0))
        c.eqStr("row and all" brow.text "id")
        c.eqStr("with the port the row owns" brow.portId "customers.id")
        ; Emphasis is why a primary key reads as one at a glance, and it was
        ; not being written — the same silent loss the missing edge label was.
        c.eqInt("and its emphasis" brow.emphasis 1)
        ; A column added in the editor has to survive being saved, or adding
        ; one is a change you cannot keep.
        def bnew:FlowRow (FlowUndo.rowOf(bt 1))
        c.eqStr("a column added by hand comes back too" bnew.text "kanta_asiakas")
        c.eqStr("with its type" bnew.detail "BOOLEAN")
        c.ok("and a port to connect to" ((bt.portIndex("customers.col1:r")) >= 0))
        def bd:FlowNode (back.nodeById("check"))
        c.eqStr("a shape survives being saved" bd.shape "diamond")
        def be:FlowEdge (back.edgeAt(0))
        c.eqStr("and so does an edge's label" be.label "kyllä")
        c.eqStr("from" be.source "customers")
        c.eqStr("to" be.target "check")

        ; Nonsense in gives an empty graph rather than a crash.
        def junk:FlowGraph (FlowGraphJson.fromJson("not json at all"))
        c.eqInt("junk reads as an empty diagram" (junk.nodeCount()) 0)
    }

    ; ------------------------------------------------------- data binding ----
    ; The shape every diagram library means by it: a flat array of records,
    ; each naming its own parent.
    sfn testDataBinding:void (c:Checker) {
        c.section("data binding")
        def src:string "[{\"id\":\"1\",\"parentId\":\"\",\"name\":\"Aino\"},{\"id\":\"2\",\"parentId\":\"1\",\"name\":\"Markus\"},{\"id\":\"3\",\"parentId\":\"1\",\"name\":\"Riikka\"},{\"id\":\"4\",\"parentId\":\"2\",\"name\":\"Sanna\"}]"
        def g:FlowGraph (FlowGraphJson.fromDataSource(src "id" "parentId" "name"))
        c.eqInt("a record becomes a node" (g.nodeCount()) 4)
        c.eqInt("and a parent becomes an edge" (g.edgeCount()) 3)
        def n2:FlowNode (g.nodeById("2"))
        c.eqStr("the label comes from the field that was named" n2.label "Markus")
        c.eqInt("and the node is connectable" (array_length n2.ports) 4)
        ; The root has no parent, so it has no incoming edge.
        def incoming:int 0
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            if (e.target == "1") { incoming = (incoming + 1) }
            k = (k + 1)
        }
        c.eqInt("the record with no parent has nothing pointing at it" incoming 0)
        ; …and it lays out like any other graph.
        def mind:MindMapLayout (MindMapLayout.of(g))
        c.eqInt("a bound graph lays out" (mind.run()) 3)
    }

    ; ---------------------------------------------------- text fitting -------    ; ---------------------------------------------------- text fitting -------
    ; Wrap, then shrink, then cut. A label that does not fit has three answers
    ; and they are tried in that order, because an ellipsis is an admission and
    ; the other two are not.
    sfn testTextFitting:void (c:Checker) {
        c.section("wrapping and autofit")
        def g (new FlowGraph)
        def v:FlowView (FlowView.of(g))
        v.width = 1200.0
        v.height = 800.0

        ; Fits as it is: one line, full size, nothing lost.
        def easy:FlowTextLayout (v.layoutText("Alku" 13.0 200.0 60.0 2))
        c.eqInt("a short label is one line" (easy.lineCount()) 1)
        c.near("at the size it was asked for" easy.size 13.0 0.001)
        c.ok("and nothing is cut" (easy.truncated == false))
        c.eqStr("with the text unchanged" (easy.lineAt(0)) "Alku")

        ; Too wide for one line, room for two: wrapped, still full size.
        def wide:double (v.textWidth("Tarkista asiakkaan luottotiedot" 13.0))
        def two:FlowTextLayout (v.layoutText("Tarkista asiakkaan luottotiedot" 13.0 (wide * 0.7) 60.0 2))
        c.eqInt("a long label wraps rather than shrinking" (two.lineCount()) 2)
        c.near("and keeps its size" two.size 13.0 0.001)
        c.ok("with nothing cut" (two.truncated == false))
        c.eqStr("the words are all still there" (two.joined()) "Tarkista asiakkaan luottotiedot")
        c.ok("and it breaks at a space" ((two.lineAt(0)) == "Tarkista asiakkaan"))

        ; Room for one line only: shrink instead of cutting.
        def one:FlowTextLayout (v.layoutText("Tarkista asiakkaan luottotiedot" 13.0 (wide * 0.85) 0.0 1))
        c.eqInt("with one line to work in it stays on one" (one.lineCount()) 1)
        c.ok(("and the size comes down (got " + (to_string one.size) + ")") (one.size < 13.0))
        c.ok("rather than the text being cut" (one.truncated == false))
        c.ok("but never below the floor" (one.size >= (13.0 * (FlowText.minScale()))))

        ; Not even the floor is enough: now, and only now, an ellipsis.
        def tight:FlowTextLayout (v.layoutText("Tarkista asiakkaan luottotiedot" 13.0 40.0 0.0 1))
        c.ok("a hopeless box does cut the text" tight.truncated)
        c.near("at the smallest size allowed" tight.size (13.0 * (FlowText.minScale())) 0.001)
        c.ok("and says so with an ellipsis" (RangerFlowTest.endsWithStr((tight.lineAt(0)) "…")))

        ; Two lines of room, and a height that only fits one, is one.
        def short:FlowTextLayout (v.layoutText("Tarkista asiakkaan luottotiedot" 13.0 (wide * 0.7) 16.0 2))
        c.eqInt("a box one line tall gets one line" (short.lineCount()) 1)

        ; The caret needs to know which line a character is on, and where in
        ; it. That is the whole reason the layout carries source positions.
        def src:string "Tarkista asiakkaan luottotiedot"
        def line0:int (two.lineOfIndex(3))
        c.eqInt("an index in the first word is on the first line" line0 0)
        def line1:int (two.lineOfIndex((strlen src)))
        c.eqInt("and the end of the text is on the last" line1 ((two.lineCount()) - 1))
        def off:int (two.offsetInLine((strlen src) line1))
        c.eqInt("at the end of that line" off (strlen (two.lineAt(line1))))

        ; Double spaces survive, because the caret counts them.
        def spaced:FlowTextLayout (v.layoutText("kaksi  väliä" 13.0 400.0 0.0 1))
        c.eqStr("the text is drawn exactly as typed" (spaced.lineAt(0)) "kaksi  väliä")
    }

    ; -------------------------------------------------------- editing text --
    ; Double-click, type, commit — and one undo for the whole thing.
    sfn testInPlaceEditing:void (c:Checker) {
        c.section("editing a label in place")
        def g (new FlowGraph)
        def t:FlowNode (g.node("t" "customers" 0.0 0.0))
        t.width = 200.0
        t.headerHeight = 26.0
        t.rowHeight = 20.0
        def sec:FlowSection (t.addSection(""))
        def r0:FlowRow (FlowRow.create("pk" "id" "INTEGER" ""))
        sec.addRow(r0)
        def r1:FlowRow (FlowRow.create("" "email" "VARCHAR" ""))
        sec.addRow(r1)
        t.layoutCompartments()
        def step:FlowNode (g.node("s" "Vaihe" 400.0 0.0))
        step.width = 150.0
        step.height = 60.0
        step.shape = (FlowShape.rect())
        def e:FlowEdge (g.connect("t" "s"))
        e.edgeType = "smoothstep"
        e.label = "kyllä"
        g.reindex()
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(1200.0 700.0)
        ed.view.showControls = false
        ed.view.showMinimap = false

        ; What is under the pointer decides what gets edited: the header of a
        ; table names the table, a row names a column.
        def headY:double (ed.view.viewport.toScreenY((t.y + 10.0)))
        def headX:double (ed.view.viewport.toScreenX((t.x + 40.0)))
        c.eqStr("the header names the table" (ed.textAt(headX headY)) "node:t")
        def rowCy:double (t.rowCenterY(0 0))
        def rowY:double (ed.view.viewport.toScreenY((t.y + rowCy)))
        c.eqStr("and the first row names a column" (ed.textAt(headX rowY)) "row:t:0")
        def row1Cy:double (t.rowCenterY(0 1))
        def row1Y:double (ed.view.viewport.toScreenY((t.y + row1Cy)))
        c.eqStr("the second row is the second row" (ed.textAt(headX row1Y)) "row:t:1")
        def stepX:double (ed.view.viewport.toScreenX((step.centerX())))
        def stepY:double (ed.view.viewport.toScreenY((step.centerY())))
        c.eqStr("a shape with no rows names itself" (ed.textAt(stepX stepY)) "node:s")

        ; Typing goes to a buffer, not to the model.
        def inp (new FlowInput)
        inp.x = headX
        inp.y = rowY
        c.ok("double-click starts an edit" (ed.doubleClick(inp)))
        c.ok("the editor says it is editing" (ed.editing()))
        c.eqInt("in text mode" ed.mode 7)
        c.eqStr("with the row's own text in the buffer" ed.editText "id")
        c.eqInt("and the caret at the end of it" ed.editCaret 2)
        ed.typeText("_no")
        c.eqStr("typing appends" ed.editText "id_no")
        c.eqStr("but the model is untouched until commit" r0.text "id")
        c.ok("and the view draws the buffer for that row" ((ed.view.textFor("row:t:0" "id")) == "id_no"))
        c.eqStr("while every other label is still the model's" (ed.view.textFor("row:t:1" "email")) "email")

        c.ok("commit writes it" (ed.commitEdit()))
        c.eqStr("to the row" r0.text "id_no")
        c.ok("and the edit is over" ((ed.editing()) == false))
        c.eqInt("back to idle" ed.mode 0)
        c.ok("one undo takes the whole thing back" (ed.undo.undo(g)))
        c.eqStr("every keystroke of it" r0.text "id")
        c.ok("and redo puts it back" (ed.undo.redo(g)))
        c.eqStr("as it was typed" r0.text "id_no")

        ; Escape leaves the model alone, however much was typed.
        def undoDepth:int (array_length ed.undo.past)
        ed.beginEdit("node:t")
        c.eqStr("the buffer starts from the table's name" ed.editText "customers"
        )
        ed.typeText("XYZ")
        ed.cancelEdit()
        c.eqStr("escape writes nothing" t.label "customers"
        )
        c.eqInt("and puts nothing on the undo stack" (array_length ed.undo.past) undoDepth)

        ; Backspace, delete and the caret keys, for a host with no text field
        ; of its own — the SDL window, and this test.
        ed.beginEdit("node:s")
        ed.caretToEnd()
        ed.backspace()
        c.eqStr("backspace removes the character before the caret" ed.editText "Vaih"
        )
        ed.caretToStart()
        ed.deleteForward()
        c.eqStr("delete removes the one after it" ed.editText "aih")
        ed.moveCaret(2)
        ed.typeText("!")
        c.eqStr("and the caret puts new text where it is" ed.editText "ai!h")
        c.eqInt("moving it along as it goes" ed.editCaret 3)
        ed.cancelEdit()

        ; An edge's label is editable the same way.
        def ex:double (ed.view.viewport.toScreenX(((t.centerX()) + (step.centerX())) * 0.5))
        c.ok("an edge label can be edited by name" (ed.beginEdit("edge:" + e.id)))
        c.eqStr("starting from what the edge says" ed.editText "kyllä")
        ed.typeText("!")
        ed.commitEdit()
        c.eqStr("and the edge takes it" e.label "kyllä!")

        ; Pressing somewhere else finishes the edit rather than losing it.
        ed.beginEdit("node:s")
        ed.typeText("Z")
        inp.x = headX
        inp.y = rowY
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        c.eqStr("a press elsewhere commits what was typed" step.label "VaiheZ")

        ; While typing, the keyboard belongs to the text: Delete is a
        ; character, not the selected node.
        def before:int (g.nodeCount())
        step.selected = true
        ed.beginEdit("node:s")
        ed.caretToEnd()
        c.ok("Delete is handled by the edit" (ed.keyDown("Delete" false false)))
        c.eqInt("and deletes no node" (g.nodeCount()) before)
        c.ok("Escape ends the edit" (ed.keyDown("Escape" false false)))
        c.ok("which is over" ((ed.editing()) == false))
    }

    ; A node with nothing to grab is a node you cannot connect.    ; A node with nothing to grab is a node you cannot connect. Tables carry a
    ; port per row and need no others; a shape has no rows at all, so it gets
    ; the four side handles React Flow gives a node that declares none — and
    ; they have to sit ON the outline, or an arrow ends in the air beside a
    ; diamond.
    sfn testSideHandles:void (c:Checker) {
        c.section("handles on a shape")
        def g (new FlowGraph)
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(900.0 600.0)
        ed.view.showControls = false
        ed.view.showMinimap = false
        def n:FlowNode (ed.addNode("Ehto?" (FlowShape.diamond()) 300.0 200.0))
        c.eqInt("a node from the palette has four handles" (array_length n.ports) 4)
        def sides:int 0
        def k:int 0
        while (k < (array_length n.ports)) {
            def p:FlowPort (itemAt n.ports k)
            if (p.centred) {
                sides = (sides + 1)
            }
            k = (k + 1)
        }
        c.eqInt("every one of them is a side handle" sides 4)

        ; On the outline, not on the bounding box.
        def left:FlowPort (itemAt n.ports 3)
        c.eqInt("the fourth is the left one" left.side 3)
        c.near("and it sits at the diamond's left point" (n.portY(left)) (n.centerY()) 0.001)
        c.near("which is the middle of the box's left edge" (n.portX(left)) n.x 0.001)

        ; A parallelogram's sides lean, so its handles have to lean with them.
        def io:FlowNode (ed.addNode("Syöte" (FlowShape.parallelogram()) 300.0 400.0))
        def ioLeft:FlowPort (itemAt io.ports 3)
        c.ok("a parallelogram's left handle is inside its bounding box" ((io.portX(ioLeft)) > io.x))
        c.ok("but still on its left-hand side" ((io.portX(ioLeft)) < (io.x + (io.width * 0.5))))

        ; And the handles are what the pointer finds, so a drag from one starts
        ; a connection the way dragging a table's field port does.
        def inp (new FlowInput)
        def hx:double (ed.view.viewport.toScreenX((n.portX(left))))
        def hy:double (ed.view.viewport.toScreenY((n.portY(left))))
        c.eqStr("the pointer finds the handle" (ed.portAt(hx hy)) left.id)
        ed.pointerDown(inp)
        inp.x = hx
        inp.y = hy
        ed.pointerDown(inp)
        c.eqInt("pressing on it starts a connection" ed.mode 4)
        def ioLeftPort:FlowPort (itemAt io.ports 3)
        def tx:double (ed.view.viewport.toScreenX((io.portX(ioLeftPort))))
        def ty:double (ed.view.viewport.toScreenY((io.portY(ioLeftPort))))
        inp.x = tx
        inp.y = ty
        ed.pointerMove(inp)
        ed.pointerUp(inp)
        c.eqInt("and releasing on another handle makes an edge" (g.edgeCount()) 1)
        def e:FlowEdge (g.edgeAt(0))
        c.eqStr("anchored at the handle it started from" e.sourcePort left.id)
        c.eqStr("and at the one it ended on" e.targetPort ioLeftPort.id)

        ; A table already has a port per row; it must not grow four more.
        def t:FlowNode (g.node("t" "customers" 0.0 0.0))
        def sec:FlowSection (t.addSection(""))
        def row:FlowRow (FlowRow.create("pk" "id" "INTEGER" ""))
        row.portId = "t.id"
        sec.addRow(row)
        t.layoutCompartments()
        t.placeRowPorts()
        def before:int (array_length t.ports)
        t.addSideHandles()
        c.eqInt("a node with ports of its own is left alone" (array_length t.ports) before)

        ; A long name grows the box rather than being cut off in it.
        def wide:FlowNode (ed.addNode("Tarkista asiakkaan luottotiedot" (FlowShape.rect()) 600.0 200.0))
        c.ok(("a long name widens the node (got " + (to_string wide.width) + ")") (wide.width > 200.0))
        def w0:double wide.width
        ed.graph.clearSelection()
        wide.selected = true
        ed.renameSelected("Ok")
        c.near("and renaming it shorter does not shrink it back" wide.width w0 0.001)
        ed.renameSelected("Muodosta lasku ja lähetä se asiakkaalle sähköpostilla")
        c.ok("but a longer name grows it again" (wide.width > w0))
    }

    ; React Flow's `connectOnClick`: click the source, click the target.
    sfn testConnectOnClick:void (c:Checker) {
        c.section("click to connect")
        def g (new FlowGraph)
        def a:FlowNode (g.node("a" "A" 0.0 0.0))
        def b:FlowNode (g.node("b" "B" 300.0 0.0))
        a.width = 150.0
        a.height = 50.0
        b.width = 150.0
        b.height = 50.0
        g.reindex()
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(900.0 600.0)
        ed.view.showControls = false
        ed.view.showMinimap = false
        def inp (new FlowInput)

        ; Off by default: a click is a selection, and dragging still drags.
        inp.x = 40.0
        inp.y = 20.0
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        c.eqInt("with the mode off a click makes no edge" (g.edgeCount()) 0)
        c.ok("it selects instead" a.selected)

        ed.connectOnClick = true
        g.clearSelection()
        inp.x = 40.0
        inp.y = 20.0
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        c.eqInt("the first click makes nothing yet" (g.edgeCount()) 0)
        c.eqStr("but it remembers the source" ed.clickConnectFrom a.id)
        c.ok("and shows which node that is" a.selected)
        inp.x = 340.0
        inp.y = 20.0
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        c.eqInt("the second click joins them" (g.edgeCount()) 1)
        def e:FlowEdge (g.edgeAt(0))
        c.eqStr("from the node clicked first" e.source a.id)
        c.eqStr("to the node clicked second" e.target b.id)
        c.eqStr("and the mode is ready for the next pair" ed.clickConnectFrom "")

        ; A click on the pane cancels a half-made connection rather than
        ; leaving it waiting for a node nobody is going to click.
        inp.x = 40.0
        inp.y = 20.0
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        c.eqStr("a source is picked" ed.clickConnectFrom a.id)
        inp.x = 700.0
        inp.y = 400.0
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        c.eqStr("clicking the pane forgets it" ed.clickConnectFrom "")
        c.eqInt("and makes no edge" (g.edgeCount()) 1)
    }

    ; -------------------------------------------------------------- editor --    ; -------------------------------------------------------------- editor --
    sfn testEditor:void (c:Checker) {
        c.section("editor")
        def g (new FlowGraph)
        def a:FlowNode (g.node("a" "A" 0.0 0.0))
        def b:FlowNode (g.node("b" "B" 300.0 0.0))
        a.width = 150.0
        a.height = 50.0
        b.width = 150.0
        b.height = 50.0
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(1000.0 600.0)
        ed.view.showControls = false
        ed.view.showMinimap = false
        def inp (new FlowInput)

        ; click a node → select it
        inp.x = 20.0
        inp.y = 20.0
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        c.ok("click selects" a.selected)
        c.eqInt("one selected" (g.selectedNodeCount()) 1)

        ; shift-click the other → both
        inp.x = 320.0
        inp.y = 20.0
        inp.shift = true
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        c.eqInt("shift adds to selection" (g.selectedNodeCount()) 2)
        inp.shift = false

        ; drag moves every selected node, and one undo puts them all back
        inp.x = 20.0
        inp.y = 20.0
        ed.pointerDown(inp)
        inp.x = 80.0
        inp.y = 60.0
        ed.pointerMove(inp)
        ed.pointerUp(inp)
        c.near("dragged a" a.x 60.0 0.001)
        c.near("dragged b" b.x 360.0 0.001)
        ed.keyDown("z" false true)
        c.near("undo a" a.x 0.0 0.001)
        c.near("undo b" b.x 300.0 0.001)
        ed.keyDown("z" true true)
        c.near("redo a" a.x 60.0 0.001)

        ; snap to grid
        ed.snapToGrid = true
        ed.snapSize = 25.0
        inp.x = 80.0
        inp.y = 60.0
        ed.pointerDown(inp)
        inp.x = 87.0
        inp.y = 60.0
        ed.pointerMove(inp)
        ed.pointerUp(inp)
        c.near("snapped x" a.x 75.0 0.001)
        ed.snapToGrid = false

        ; pane click clears, box select takes both back
        g.clearSelection()
        inp.x = 600.0
        inp.y = 400.0
        inp.shift = true
        ed.pointerDown(inp)
        inp.x = -50.0
        inp.y = -50.0
        ed.pointerMove(inp)
        ed.pointerUp(inp)
        inp.shift = false
        c.eqInt("box select" (g.selectedNodeCount()) 2)

        ; select all, delete, undo
        ed.keyDown("a" false true)
        c.eqInt("ctrl+a" (g.selectedNodeCount()) 2)
        ed.keyDown("Delete" false false)
        c.eqInt("deleted" (g.nodeCount()) 0)
        ed.keyDown("z" false true)
        c.eqInt("undo delete" (g.nodeCount()) 2)

        ; wheel zooms about the cursor
        def before:double (ed.view.viewport.toFlowX(400.0))
        inp.x = 400.0
        inp.y = 300.0
        ed.wheel(inp -1.0)
        c.ok("wheel zoomed in" (ed.view.viewport.zoom > 1.0))
        c.near("wheel anchored" (ed.view.viewport.toFlowX(400.0)) before 0.0001)

        ; pan
        def px:double ed.view.viewport.x
        ed.view.viewport.zoom = 1.0
        inp.x = 700.0
        inp.y = 500.0
        ed.pointerDown(inp)
        inp.x = 750.0
        inp.y = 520.0
        ed.pointerMove(inp)
        ed.pointerUp(inp)
        c.ok("panned" ((fabs (ed.view.viewport.x - px)) > 10.0))
    }

    ; --------------------------------------------------------------- scene --
    sfn testScene:void (c:Checker) {
        c.section("scene backends")
        def g (new FlowGraph)
        def n:FlowNode (g.node("t" "customers" 0.0 0.0))
        def sec:FlowSection (n.addSection(""))
        def r0:FlowRow (FlowRow.create("pk" "id" "INTEGER" ""))
        r0.portId = "t.id"
        sec.addRow(r0)
        n.layoutCompartments()
        def n2:FlowNode (g.node("o" "orders" 400.0 60.0))
        def sec2:FlowSection (n2.addSection(""))
        def r1:FlowRow (FlowRow.create("fk" "t_id" "INTEGER" "FK"))
        r1.portId = "o.t_id"
        sec2.addRow(r1)
        n2.layoutCompartments()
        g.reindex()
        def e:FlowEdge (FlowEdge.create("e" "o" "t"))
        e.sourcePort = "o.t_id:l"
        e.targetPort = "t.id:r"
        e.sourceCardinality = "*"
        e.targetCardinality = "1"
        g.addEdge(e)

        def v:FlowView (FlowView.of(g))
        v.width = 800.0
        v.height = 500.0
        v.showBackground = false
        v.showMinimap = false
        v.showControls = false
        def sc:FlowScene (v.build())
        c.ok("scene has items" ((sc.count()) > 8))
        c.eqInt("both nodes drawn" v.drawnNodes 2)
        c.eqInt("edge drawn" v.drawnEdges 1)

        def dl:EVGDisplayList (sc.toDisplayList())
        c.ok("display list is not empty" ((dl.count()) > 0))
        c.ok("display list has text" (RangerFlowTest.hasKind(dl 3)))
        c.ok("display list has a stroke" (RangerFlowTest.hasKind(dl 7)))
        def json:string (dl.toJson())
        c.ok("json opens" ((substring json 0 8) == "{\"cmds\":"))

        def root:EVGElement (sc.toEvgTree())
        c.eqInt("tree mirrors the scene" (root.getChildCount()) (sc.drawableCount()))
        c.ok("clips are display-list only" ((sc.count()) > (sc.drawableCount())))
        def svg:string (sc.toSvg())
        c.ok("svg opens" ((substring svg 0 4) == "<svg"))
        c.ok("svg closes" ((RangerFlowTest.endsWithStr(svg "</svg>\n"))))
        c.ok("svg has the table name" ((indexOf svg "customers") > 0))

        ; Culling: with the viewport moved far away nothing is drawn.
        v.viewport.x = -100000.0
        v.build()
        c.eqInt("all culled" v.drawnNodes 0)
        c.eqInt("culled counted" v.culledNodes 2)
    }

    sfn hasKind:boolean (dl:EVGDisplayList kind:int) {
        def i:int 0
        while (i < (dl.count())) {
            def cmd:EVGDrawCmd (dl.at(i))
            if (cmd.kind == kind) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn endsWithStr:boolean (s:string suffix:string) {
        def n:int (strlen s)
        def m:int (strlen suffix)
        if (m > n) {
            return false
        }
        return ((substring s (n - m) n) == suffix)
    }

    ; ----------------------------------------------------------------- SQL --
    sfn testSql:void (c:Checker) {
        c.section("SQL schema reader")
        def sqlOpt:string (?? (read_file "." "gallery/rangerflow/fixtures/ecommerce.sql") "")
        c.ok("fixture readable" ((strlen sqlOpt) > 0))
        def schema:DatabaseSchema (SqlSchemaReader.parse(sqlOpt))
        c.eqInt("tables" (schema.tableCount()) 9)
        c.eqInt("foreign keys" (array_length schema.foreignKeys) 10)

        def customers:DBTable (schema.tableByName("customers"))
        c.eqInt("customer columns" (array_length customers.columns) 6)
        def pk:[string] (customers.primaryKeyColumns())
        c.eqInt("single primary key" (array_length pk) 1)
        def emailIdx:int (customers.columnIndex("email"))
        def email:SchemaColumn (itemAt customers.columns emailIdx)
        c.ok("UNIQUE(email) recognised" email.isUnique)
        def countryIdx:int (customers.columnIndex("country_id"))
        def country:SchemaColumn (itemAt customers.columns countryIdx)
        c.ok("inline REFERENCES makes a foreign key" country.isForeignKey)
        c.ok("nullable foreign key" country.nullable)

        ; composite primary key
        def pcs:DBTable (schema.tableByName("product_categories"))
        def pcpk:[string] (pcs.primaryKeyColumns())
        c.eqInt("composite key" (array_length pcpk) 2)

        ; self reference
        def selfRefs:int 0
        def i:int 0
        while (i < (array_length schema.foreignKeys)) {
            def fk:DBForeignKey (itemAt schema.foreignKeys i)
            if (fk.fromTable == fk.toTable) {
                selfRefs = (selfRefs + 1)
            }
            i = (i + 1)
        }
        c.eqInt("self references" selfRefs 2)

        ; types survive their parentheses
        def nameIdx:int (customers.columnIndex("name"))
        def nameCol:SchemaColumn (itemAt customers.columns nameIdx)
        c.eqStr("type with length" nameCol.dataType "VARCHAR(120)")

        ; indexes, including the one declared separately
        def orders:DBTable (schema.tableByName("orders"))
        c.eqInt("index picked up" (array_length orders.indexes) 1)
        def products:DBTable (schema.tableByName("products"))
        c.eqInt("check constraint" (array_length products.constraints) 1)

        ; cardinality inference: unique FK column → one-to-one
        def payments:DBTable (schema.tableByName("payments"))
        def orderIdx:int (payments.columnIndex("order_id"))
        def orderCol:SchemaColumn (itemAt payments.columns orderIdx)
        c.ok("unique foreign key column" orderCol.isUnique)
        def oneToOne:boolean false
        def manyToOne:boolean false
        def k:int 0
        while (k < (array_length schema.foreignKeys)) {
            def fk2:DBForeignKey (itemAt schema.foreignKeys k)
            def card:string (schema.cardinalityOf(fk2))
            if (fk2.fromTable == "payments") {
                if (card == "1") { oneToOne = true }
            }
            if (fk2.fromTable == "order_items") {
                if (card == "*") { manyToOne = true }
            }
            k = (k + 1)
        }
        c.ok("payments→orders is one-to-one" oneToOne)
        c.ok("order_items→orders is many-to-one" manyToOne)

        ; …and the graph that comes out of it
        def s2g (new SchemaToGraph)
        def g:FlowGraph (s2g.build(schema))
        c.eqInt("one node per table" (g.nodeCount()) 9)
        c.eqInt("one edge per foreign key" (g.edgeCount()) 10)
        def cust:FlowNode (g.nodeById("customers"))
        c.ok("table node has rows" ((cust.totalRowCount()) >= 6))
        c.ok("row ports exist" ((g.hasPort("customers.id:r"))))
        def anyEdge:FlowEdge (g.edgeAt(0))
        c.ok("edge attaches to a port" ((strlen anyEdge.sourcePort) > 0))
        c.eqStr("referenced end is one" anyEdge.targetCardinality "1")
    }

    ; ----------------------------------------------------------------- UML --
    sfn testUml:void (c:Checker) {
        c.section("UML")
        def d (new UMLDiagram)
        def shape:UMLClass (d.umlClass("Shape"))
        shape.stereotype = "abstract"
        shape.attribute("#" "origin" "Point")
        shape.operation("+" "area" "" "double")
        def rect:UMLClass (d.umlClass("Rectangle"))
        rect.attribute("-" "width" "double")
        d.relate("Rectangle" "Shape" "inheritance")
        def u2g (new UMLToGraph)
        def g:FlowGraph (u2g.build(d))
        c.eqInt("classes" (g.nodeCount()) 2)
        c.eqInt("relations" (g.edgeCount()) 1)
        def n:FlowNode (g.nodeById("Shape"))
        c.eqInt("two compartments" (n.sectionCount()) 2)
        c.eqStr("stereotype in the header" n.label "«abstract» Shape")
        def e:FlowEdge (g.edgeAt(0))
        c.eqStr("inheritance is a hollow triangle" e.markerEnd "triangle")
        def rel:UMLRelation (UMLRelation.create("A" "B" "composition"))
        c.eqStr("composition is a filled diamond" (rel.targetMarker()) "diamond-filled")
        c.ok("implementation is dashed" ((UMLRelation.create("A" "B" "implementation")).dashed()))
    }

    ; -------------------------------------------------------------- export --
    sfn testExport:void (c:Checker) {
        c.section("export")
        def g (new FlowGraph)
        def n:FlowNode (g.node("t" "customers" 0.0 0.0))
        def sec:FlowSection (n.addSection(""))
        def r0:FlowRow (FlowRow.create("pk" "id" "INTEGER" ""))
        sec.addRow(r0)
        n.layoutCompartments()
        g.node("o" "orders" 320.0 40.0)
        g.connect("o" "t")
        def v:FlowView (FlowView.of(g))
        def ex (new FlowExport)
        ex.loadFonts("gallery/pdf_writer/assets/fonts")
        c.ok("fonts loaded" ex.fontsLoaded)
        def pdf:buffer (ex.toPdf(v))
        def len:int (buffer_length pdf)
        c.ok("pdf has bytes" (len > 1000))
        def head:string (RangerFlowTest.headOf(pdf 5))
        c.eqStr("pdf header" head "%PDF-")
        def svg:string (ex.toSvg(v))
        c.ok("svg mentions the table" ((indexOf svg "customers") > 0))
        def json:string (ex.toSceneJson(v))
        c.ok("scene json has a width" ((indexOf json "\"width\"") >= 0))
        def gj:string (FlowGraphJson.toJson(g))
        c.ok("graph json round trip has the node" ((indexOf gj "\"customers\"") > 0))
        c.ok("graph json has the edge" ((indexOf gj "\"edges\"") > 0))
    }

    sfn headOf:string (b:buffer n:int) {
        def out:string ""
        def i:int 0
        while (i < n) {
            def code:int (buffer_get b i)
            out = (out + (strfromcode code))
            i = (i + 1)
        }
        return out
    }
}

; ============================================================================
; MermaidParityDump.rgr — what RangerFlow's reader made of Mermaid's examples.
; ============================================================================
;
;   npm run rangerflow:mermaid:parity
;   → gallery/rangerflow/harness/out/rangerflow_mermaid.json
;
; The corpus is `fixtures/mermaid/`, and the files to read are handed in as
; arguments rather than discovered here: Ranger has no directory listing, and a
; list written into this file is a list that goes stale the day somebody adds
; an example. `tools/mermaid-parity.mjs` globs the directory, runs this, runs
; Mermaid's own parser over the same files, and compares the two answers.
;
; Nothing is laid out and nothing is drawn. What is dumped is what the READER
; understood — the nodes with their shapes, the edges with their arrowheads and
; strokes, the subgraphs with their members — because that is the half that can
; disagree with Mermaid. Geometry is RangerFlow's own business and Mermaid has
; no opinion about it.
; ============================================================================

Import "../domains/mermaid/MermaidReader.rgr"

class MermaidParityDump {
    sfn main:void () {
        def out:string "{\n \"diagrams\": [\n"
        def count:int (shell_arg_cnt)
        def written:int 0
        def i:int 0
        while (i < count) {
            def path:string (shell_arg i)
            if ((MermaidParityDump.isDiagram(path))) {
                if (written > 0) {
                    out = (out + ",\n")
                }
                out = (out + (MermaidParityDump.dumpOne(path)))
                written = (written + 1)
            }
            i = (i + 1)
        }
        out = (out + "\n ]\n}\n")
        write_file "." "gallery/rangerflow/harness/out/rangerflow_mermaid.json" out
        print ("  rangerflow reader: " + (to_string written) + " diagrams → gallery/rangerflow/harness/out/rangerflow_mermaid.json")
    }

    sfn isDiagram:boolean (path:string) {
        def n:int (strlen path)
        if (n < 5) {
            return false
        }
        return ((substring path (n - 4) n) == ".mmd")
    }

    sfn dumpOne:string (path:string) {
        def src:string (?? (read_file "." path) "")
        def d:MermaidDiagram (MermaidReader.parse(src))
        def g:FlowGraph (d.build())
        def out:string "  {\n"
        out = ((out + "   \"file\": \"") + (MermaidParityDump.baseName(path)) + "\",\n")
        out = ((out + "   \"kind\": \"") + d.diagramKind + "\",\n")
        out = ((out + "   \"direction\": \"") + d.direction + "\",\n")
        out = (out + "   \"nodes\": [")
        def i:int 0
        while (i < (array_length d.chart.steps)) {
            def st:FlowStep (itemAt d.chart.steps i)
            if (i > 0) {
                out = (out + ", ")
            }
            out = (out + "{\"id\": \"" + (MermaidParityDump.esc(st.id)) + "\"")
            out = (out + ", \"label\": \"" + (MermaidParityDump.esc(st.label)) + "\"")
            out = (out + ", \"shape\": \"" + (d.shapeOf(st.id)) + "\"")
            out = (out + ", \"classes\": [" + (MermaidParityDump.classesOf(d st.id)) + "]}")
            i = (i + 1)
        }
        out = (out + "],\n")
        out = (out + "   \"edges\": [")
        def k:int 0
        while (k < (array_length d.chart.links)) {
            def l:FlowLink (itemAt d.chart.links k)
            if (k > 0) {
                out = (out + ", ")
            }
            out = (out + "{\"source\": \"" + (MermaidParityDump.esc(l.source)) + "\"")
            out = (out + ", \"target\": \"" + (MermaidParityDump.esc(l.target)) + "\"")
            out = (out + ", \"label\": \"" + (MermaidParityDump.esc(l.label)) + "\"")
            def kind:string ""
            def head:string ""
            def tail:string ""
            if (k < (array_length d.linkKinds)) {
                kind = (itemAt d.linkKinds k)
                head = (itemAt d.linkHeads k)
                tail = (itemAt d.linkTails k)
            }
            out = (out + ", \"stroke\": \"" + kind + "\"")
            out = (out + ", \"head\": \"" + head + "\"")
            out = (out + ", \"tail\": \"" + tail + "\"}")
            k = (k + 1)
        }
        out = (out + "],\n")
        out = (out + "   \"subgraphs\": [")
        def s:int 0
        while (s < (array_length d.subgraphs)) {
            def sg:MermaidSubgraph (itemAt d.subgraphs s)
            if (s > 0) {
                out = (out + ", ")
            }
            out = (out + "{\"id\": \"" + (MermaidParityDump.esc(sg.id)) + "\"")
            out = (out + ", \"title\": \"" + (MermaidParityDump.esc(sg.title)) + "\"")
            out = (out + ", \"nodes\": [")
            def m:int 0
            def listed:int 0
            while (m < (array_length sg.members)) {
                def id:string (itemAt sg.members m)
                ; An outer subgraph holds the FRAME of a nested one; Mermaid
                ; lists the nested subgraph's own id, so the frame is reported
                ; under the name the diagram gave it.
                def shown:string (MermaidParityDump.memberName(d id))
                if ((strlen shown) > 0) {
                    if (listed > 0) {
                        out = (out + ", ")
                    }
                    out = (out + "\"" + (MermaidParityDump.esc(shown)) + "\"")
                    listed = (listed + 1)
                }
                m = (m + 1)
            }
            out = (out + "]}")
            s = (s + 1)
        }
        out = (out + "]\n  }")
        return out
    }

    ; A member is either a node or the frame of a nested subgraph. The frame
    ; is reported as that subgraph's id, which is the name Mermaid uses for it.
    sfn memberName:string (d:MermaidDiagram id:string) {
        def i:int 0
        while (i < (array_length d.subgraphs)) {
            def sg:MermaidSubgraph (itemAt d.subgraphs i)
            def frame:string (MermaidDiagram.frameIdOf(sg.id))
            if (frame == id) {
                return sg.id
            }
            i = (i + 1)
        }
        if ((d.indexOfStep(id)) >= 0) {
            return id
        }
        return ""
    }

    sfn classesOf:string (d:MermaidDiagram id:string) {
        def out:string ""
        def i:int 0
        def listed:int 0
        while (i < (array_length d.classTargets)) {
            if ((itemAt d.classTargets i) == id) {
                if (listed > 0) {
                    out = (out + ", ")
                }
                out = (out + "\"" + (itemAt d.classNames i) + "\"")
                listed = (listed + 1)
            }
            i = (i + 1)
        }
        return out
    }

    sfn baseName:string (path:string) {
        def cut:int -1
        def i:int 0
        while (i < (strlen path)) {
            if ((charAt path i) == 47) {
                cut = i
            }
            i = (i + 1)
        }
        return (substring path (cut + 1) (strlen path))
    }

    ; Enough of JSON's escaping for labels: a quote, a backslash, and the
    ; control characters a Mermaid label can legally contain.
    sfn esc:string (text:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen text)) {
            def c:int (charAt text i)
            if (c == 34) {
                out = (out + (strfromcode 92) + (strfromcode 34))
            } {
                if (c == 92) {
                    out = (out + (strfromcode 92) + (strfromcode 92))
                } {
                    if (c == 10) {
                        out = (out + (strfromcode 92) + "n")
                    } {
                        if (c == 9) {
                            out = (out + (strfromcode 92) + "t")
                        } {
                            out = (out + (strfromcode c))
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }
}

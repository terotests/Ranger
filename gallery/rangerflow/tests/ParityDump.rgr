; ============================================================================
; ParityDump.rgr — RangerFlow's answers to the questions React Flow was asked.
; ============================================================================
;
; Two halves, and they are different kinds of evidence:
;
;   CASES   the same geometry the oracles computed — edge paths, viewport
;           algebra, bounds, overlap — dumped as numbers for `tools/parity.mjs`
;           to compare against `@xyflow/system` with a tolerance.
;
;   PROBES  one executable check per React Flow *behaviour*, each driving the
;           real FlowEditor through pointerDown / pointerMove / pointerUp. A
;           capability cannot be claimed in the scorecard without one, and a
;           probe that fails turns the row red rather than quietly staying
;           green — which is the difference between a measurement and a wish.
;
;   node gallery/rangerflow/bin/ParityDump.js
;   → gallery/rangerflow/harness/out/rangerflow.json
;
; The case ids are built by the same rules the oracle uses. They are not shared
; through a file, so they can drift; `tools/parity.mjs` compares the two id sets
; and fails loudly when they do.
; ============================================================================

Import "../core/FlowEditor.rgr"
Import "../core/EdgeRouter.rgr"
Import "../layout/ForceLayout.rgr"
Import "../layout/EdgeLanes.rgr"
Import "../layout/OrthoRouter.rgr"
Import "../layout/TreeLayouts.rgr"
Import "../export/FlowExport.rgr"

class ParityOut {
    def parts:[string]

    Constructor () {
    }

    fn add:void (s:string) {
        push parts s
    }

    fn joined:string () {
        def out:string ""
        def i:int 0
        while (i < (array_length parts)) {
            if (i > 0) {
                out = (out + ",\n")
            }
            out = (out + (itemAt parts i))
            i = (i + 1)
        }
        return out
    }

    fn count:int () {
        return (array_length parts)
    }
}

class ParityDump {
    def cases:ParityOut (new ParityOut)
    def probes:ParityOut (new ParityOut)
    def frames:ParityOut (new ParityOut)
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    sfn main:void () {
        def d (new ParityDump)
        d.dumpPaths()
        d.dumpViewport()
        d.dumpBounds()
        d.dumpForce()
        d.probeAll()
        def json:string ("{\n\"source\": \"RangerFlow\",\n\"cases\": [\n")
        def body:string (d.cases.joined())
        def rest:string ("\n],\n\"force\": {\n" + (d.frames.joined()) + "\n},\n\"probes\": [\n" + (d.probes.joined()) + "\n]\n}\n")
        write_file "." "gallery/rangerflow/harness/out/rangerflow.json" (json + body + rest)
        print ("  " + (to_string (d.cases.count())) + " values, " + (to_string (d.probes.count())) + " probes (" + (to_string d.passed) + " ok, " + (to_string d.failed) + " failing)")
        print "  → gallery/rangerflow/harness/out/rangerflow.json"
        if (d.failed > 0) {
            exit 1
        }
    }

    ; ---------------------------------------------------------------- cases --
    ; The same source point and the same five target offsets the oracle uses:
    ; ahead, behind, above, a near-overlap, and straight down.
    sfn offsetX:double (i:int) {
        if (i == 0) { return 250.0 }
        if (i == 1) { return -250.0 }
        if (i == 2) { return 250.0 }
        if (i == 3) { return -40.0 }
        return 0.0
    }

    sfn offsetY:double (i:int) {
        if (i == 0) { return 200.0 }
        if (i == 1) { return 200.0 }
        if (i == 2) { return -200.0 }
        if (i == 3) { return 20.0 }
        return 300.0
    }

    sfn kindName:string (k:int) {
        if (k == 0) { return "bezier" }
        if (k == 1) { return "straight" }
        if (k == 2) { return "step" }
        return "smoothstep"
    }

    ; React Flow calls its default edge "bezier"; RangerFlow calls it "default".
    sfn routerKind:string (k:int) {
        if (k == 0) { return "default" }
        if (k == 1) { return "straight" }
        if (k == 2) { return "step" }
        return "smoothstep"
    }

    fn dumpPaths:void () {
        def sx:double 150.0
        def sy:double 120.0
        def k:int 0
        while (k < 4) {
            def s:int 0
            while (s < 4) {
                def t:int 0
                while (t < 4) {
                    def i:int 0
                    while (i < 5) {
                        def tx:double (sx + (ParityDump.offsetX(i)))
                        def ty:double (sy + (ParityDump.offsetY(i)))
                        def p:EdgePath (EdgeRouter.routeBetween(sx sy s tx ty t (ParityDump.routerKind(k))))
                        p.flatten(24)
                        def id:string ("path:" + (ParityDump.kindName(k)) + ":" + (to_string s) + ":" + (to_string t) + ":" + (to_string i))
                        def row:string ("{\"id\": \"" + id + "\", \"kind\": \"path\", \"d\": \"" + (p.svgPath()) + "\"")
                        row = (row + ", \"labelX\": " + (ParityDump.num((p.midX()))))
                        row = (row + ", \"labelY\": " + (ParityDump.num((p.midY()))) + "}")
                        cases.add(row)
                        i = (i + 1)
                    }
                    t = (t + 1)
                }
                s = (s + 1)
            }
            k = (k + 1)
        }
    }

    sfn transformX:double (i:int) {
        if (i == 0) { return 0.0 }
        if (i == 1) { return 40.0 }
        if (i == 2) { return -315.5 }
        return 1200.0
    }

    sfn transformY:double (i:int) {
        if (i == 0) { return 0.0 }
        if (i == 1) { return -20.0 }
        if (i == 2) { return 88.25 }
        return 900.0
    }

    sfn transformZoom:double (i:int) {
        if (i == 0) { return 1.0 }
        if (i == 1) { return 2.0 }
        if (i == 2) { return 0.4375 }
        return 0.1
    }

    sfn pointX:double (i:int) {
        if (i == 0) { return 0.0 }
        if (i == 1) { return 100.0 }
        if (i == 2) { return -250.5 }
        return 1919.0
    }

    sfn pointY:double (i:int) {
        if (i == 0) { return 0.0 }
        if (i == 1) { return 50.0 }
        if (i == 2) { return 725.25 }
        return 1079.0
    }

    fn dumpViewport:void () {
        def ti:int 0
        while (ti < 4) {
            def vp (new FlowViewport)
            vp.x = (ParityDump.transformX(ti))
            vp.y = (ParityDump.transformY(ti))
            vp.zoom = (ParityDump.transformZoom(ti))
            def pi:int 0
            while (pi < 4) {
                def px:double (ParityDump.pointX(pi))
                def py:double (ParityDump.pointY(pi))
                def idA:string ("vp:toflow:" + (to_string ti) + ":" + (to_string pi))
                cases.add(("{\"id\": \"" + idA + "\", \"kind\": \"point\", \"x\": " + (ParityDump.num((vp.toFlowX(px)))) + ", \"y\": " + (ParityDump.num((vp.toFlowY(py)))) + "}"))
                def idB:string ("vp:toscreen:" + (to_string ti) + ":" + (to_string pi))
                cases.add(("{\"id\": \"" + idB + "\", \"kind\": \"point\", \"x\": " + (ParityDump.num((vp.toScreenX(px)))) + ", \"y\": " + (ParityDump.num((vp.toScreenY(py)))) + "}"))
                pi = (pi + 1)
            }
            ti = (ti + 1)
        }
        this.dumpFit()
    }

    sfn boundsX:double (i:int) {
        if (i == 0) { return 0.0 }
        if (i == 1) { return -400.0 }
        if (i == 2) { return 120.5 }
        return 0.0
    }

    sfn boundsY:double (i:int) {
        if (i == 0) { return 0.0 }
        if (i == 1) { return -250.0 }
        if (i == 2) { return -37.25 }
        return 0.0
    }

    sfn boundsW:double (i:int) {
        if (i == 0) { return 200.0 }
        if (i == 1) { return 1600.0 }
        if (i == 2) { return 55.0 }
        return 8000.0
    }

    sfn boundsH:double (i:int) {
        if (i == 0) { return 100.0 }
        if (i == 1) { return 900.0 }
        if (i == 2) { return 800.0 }
        return 40.0
    }

    sfn sizeW:double (i:int) {
        if (i == 0) { return 800.0 }
        if (i == 1) { return 1440.0 }
        return 320.0
    }

    sfn sizeH:double (i:int) {
        if (i == 0) { return 400.0 }
        if (i == 1) { return 900.0 }
        return 240.0
    }

    sfn padValue:double (i:int) {
        if (i == 0) { return 0.0 }
        if (i == 1) { return 0.1 }
        return 0.25
    }

    fn dumpFit:void () {
        def bi:int 0
        while (bi < 4) {
            def si:int 0
            while (si < 3) {
                def pi:int 0
                while (pi < 3) {
                    def r:FlowRect (FlowRect.create((ParityDump.boundsX(bi)) (ParityDump.boundsY(bi)) (ParityDump.boundsW(bi)) (ParityDump.boundsH(bi))))
                    def vp (new FlowViewport)
                    vp.minZoom = 0.1
                    vp.maxZoom = 4.0
                    vp.fitRect(r (ParityDump.sizeW(si)) (ParityDump.sizeH(si)) (ParityDump.padValue(pi)))
                    def id:string ("vp:fit:" + (to_string bi) + ":" + (to_string si) + ":" + (to_string pi))
                    def row:string ("{\"id\": \"" + id + "\", \"kind\": \"viewport\", \"x\": " + (ParityDump.num(vp.x)))
                    row = (row + ", \"y\": " + (ParityDump.num(vp.y)) + ", \"zoom\": " + (ParityDump.num(vp.zoom)) + "}")
                    cases.add(row)
                    pi = (pi + 1)
                }
                si = (si + 1)
            }
            bi = (bi + 1)
        }
    }

    fn dumpBounds:void () {
        ; The same two node sets the oracle measures with getNodesBounds.
        def g0 (new FlowGraph)
        def a0:FlowNode (g0.node("a" "a" 0.0 0.0))
        a0.width = 150.0
        a0.height = 40.0
        def b0:FlowNode (g0.node("b" "b" 300.0 120.0))
        b0.width = 150.0
        b0.height = 40.0
        this.dumpRect("bounds:0" (g0.bounds()))

        def g1 (new FlowGraph)
        def a1:FlowNode (g1.node("a" "a" -80.5 220.25))
        a1.width = 220.0
        a1.height = 96.0
        def b1:FlowNode (g1.node("b" "b" 640.0 -410.0))
        b1.width = 80.0
        b1.height = 300.0
        def c1:FlowNode (g1.node("c" "c" 90.0 90.0))
        c1.width = 10.0
        c1.height = 10.0
        this.dumpRect("bounds:1" (g1.bounds()))

        ; Rectangle-selection overlap, which React Flow measures as an area.
        this.dumpOverlap("overlap:0" 0.0 0.0 100.0 100.0 50.0 50.0 100.0 100.0)
        this.dumpOverlap("overlap:1" 0.0 0.0 100.0 100.0 100.0 0.0 100.0 100.0)
        this.dumpOverlap("overlap:2" 0.0 0.0 100.0 100.0 120.0 0.0 100.0 100.0)
        this.dumpOverlap("overlap:3" 0.0 0.0 100.0 100.0 10.0 10.0 10.0 10.0)
        this.dumpOverlap("overlap:4" 0.0 0.0 10.5 10.5 5.25 5.25 10.0 10.0)
    }

    fn dumpRect:void (id:string r:FlowRect) {
        def row:string ("{\"id\": \"" + id + "\", \"kind\": \"rect\", \"x\": " + (ParityDump.num(r.x)))
        row = (row + ", \"y\": " + (ParityDump.num(r.y)) + ", \"width\": " + (ParityDump.num(r.w)))
        row = (row + ", \"height\": " + (ParityDump.num(r.h)) + "}")
        cases.add(row)
    }

    fn dumpOverlap:void (id:string ax:double ay:double aw:double ah:double bx:double by:double bw:double bh:double) {
        def a:FlowRect (FlowRect.create(ax ay aw ah))
        def b:FlowRect (FlowRect.create(bx by bw bh))
        def area:double (a.overlapArea(b))
        cases.add(("{\"id\": \"" + id + "\", \"kind\": \"scalar\", \"value\": " + (ParityDump.num(area)) + "}"))
    }

    ; Six decimals: the comparison is numeric with a tolerance, so what matters
    ; is not losing precision on the way out. Two would have hidden a
    ; sub-pixel disagreement that a zoomed-in editor makes visible.
    sfn num:string (v:double) {
        def neg:boolean (v < 0.0)
        def av:double v
        if neg {
            av = (0.0 - v)
        }
        def scaled:double ((av * 1000000.0) + 0.5)
        def whole:int (to_int (scaled / 1000000.0))
        def rem:int ((to_int scaled) - (whole * 1000000))
        def fs:string (to_string rem)
        while ((strlen fs) < 6) {
            fs = ("0" + fs)
        }
        def out:string ((to_string whole) + "." + fs)
        if neg {
            out = ("-" + out)
        }
        return out
    }

    ; ----------------------------------------------------------- force ------
    ; The same 30-node graph the d3 oracle builds — a ternary tree with three
    ; cross links, which is the shape React Flow's force-layout example ships
    ; with — under the example's own parameters, sampled at the same ticks.
    fn dumpForce:void () {
        def g (new FlowGraph)
        def i:int 0
        while (i < 30) {
            g.node(("n" + (to_string i)) "" 0.0 0.0)
            i = (i + 1)
        }
        def k:int 1
        while (k < 30) {
            def parent:int (idiv (k - 1) 3)
            g.connect(("n" + (to_string parent)) ("n" + (to_string k)))
            k = (k + 1)
        }
        g.connect("n5" "n17")
        g.connect("n8" "n23")
        g.connect("n11" "n26")
        def sim:FlowSimulation (FlowSimulation.reactFlowExample(g -1000.0 150.0))
        this.dumpFrame(g "t0")
        sim.tickTimes(1)
        this.dumpFrame(g "t1")
        sim.tickTimes(9)
        this.dumpFrame(g "t10")
        sim.tickTimes(40)
        this.dumpFrame(g "t50")
        sim.tickTimes(250)
        this.dumpFrame(g "t300")
    }

    fn dumpFrame:void (g:FlowGraph key:string) {
        def row:string ("\"" + key + "\": [")
        def i:int 0
        while (i < (g.nodeCount())) {
            def n:FlowNode (g.nodeAt(i))
            if (i > 0) {
                row = (row + ", ")
            }
            row = (row + "{\"id\": \"" + n.id + "\", \"x\": " + (ParityDump.num(n.simX)) + ", \"y\": " + (ParityDump.num(n.simY)) + "}")
            i = (i + 1)
        }
        frames.add((row + "]"))
    }

    ; --------------------------------------------------------------- probes --
    fn probe:void (id:string ok:boolean note:string) {
        def flag:string "false"
        if ok {
            flag = "true"
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  PROBE FAIL " + id + " — " + note)
        }
        probes.add(("{\"id\": \"" + id + "\", \"ok\": " + flag + ", \"note\": \"" + note + "\"}"))
    }

    sfn dist:double (a:FlowNode b:FlowNode) {
        def dx:double ((a.centerX()) - (b.centerX()))
        def dy:double ((a.centerY()) - (b.centerY()))
        return (sqrt ((dx * dx) + (dy * dy)))
    }

    sfn near:boolean (a:double b:double tol:double) {
        def d:double (fabs (a - b))
        return (d <= tol)
    }

    fn twoNodeEditor:FlowEditor () {
        def g (new FlowGraph)
        def a:FlowNode (g.node("a" "A" 0.0 0.0))
        a.width = 150.0
        a.height = 50.0
        a.resizable = true
        def b:FlowNode (g.node("b" "B" 300.0 0.0))
        b.width = 150.0
        b.height = 50.0
        def pa:FlowPort (FlowPort.create("a.out" "a" 1 25.0))
        a.addPort(pa)
        def pb:FlowPort (FlowPort.create("b.in" "b" 3 25.0))
        b.addPort(pb)
        g.reindex()
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(1000.0 600.0)
        ed.view.showControls = false
        ed.view.showMinimap = false
        return ed
    }

    fn probeAll:void () {
        this.probeRivals()
        this.probeAuthoring()
        this.probeViewportBehaviour()
        this.probeSelection()
        this.probeDragging()
        this.probeConnecting()
        this.probeResizeAndSnap()
        this.probeEdgesAndChrome()
    }

    ; Capabilities the OTHER two libraries document about themselves — JointJS
    ; in its README and its `routers/`, `connectors/` and `linkTools/`
    ; directories, Syncfusion in its published Key features and its shape
    ; enumerations. Same rule as everywhere else: a row is only `done` if a
    ; probe here drove the real editor and passed.
    fn probeRivals:void () {
        ; --- link tools: vertices and segments (JointJS linkTools) ----------
        ; Offset, so the route actually has a corner to grab: two boxes at the
        ; same height are joined by a straight line and there is nothing in the
        ; middle of it to drag.
        def lg (new FlowGraph)
        def la:FlowNode (lg.node("a" "A" 0.0 0.0))
        def lb:FlowNode (lg.node("b" "B" 420.0 220.0))
        la.width = 150.0
        la.height = 50.0
        lb.width = 150.0
        lb.height = 50.0
        def e:FlowEdge (lg.connect("a" "b"))
        e.edgeType = "smoothstep"
        lg.reindex()
        def ed:FlowEditor (FlowEditor.of(lg))
        ed.setSize(1200.0 800.0)
        ed.view.showControls = false
        ed.view.showMinimap = false
        def corners:[double] (EdgeRouter.cornersFor(lg e))
        def n:int (idiv (array_length corners) 2)
        def moved:boolean false
        if (n >= 4) {
            def mx:double (((itemAt corners 2) + (itemAt corners 4)) * 0.5)
            def myA:int 3
            def myB:int 5
            def my:double (((itemAt corners myA) + (itemAt corners myB)) * 0.5)
            def sx:double (ed.view.viewport.toScreenX(mx))
            def sy:double (ed.view.viewport.toScreenY(my))
            def inp (new FlowInput)
            inp.x = sx
            inp.y = sy
            ed.pointerDown(inp)
            inp.x = (sx + 30.0)
            inp.y = (sy + 30.0)
            ed.pointerMove(inp)
            ed.pointerUp(inp)
            moved = ((array_length e.waypoints) >= 4)
        }
        this.probe("linkSegments" moved "an edge segment can be dragged to a new place")

        ; --- the four routers/connectors both libraries name ----------------
        def kinds:[string]
        push kinds "default"
        push kinds "straight"
        push kinds "step"
        push kinds "smoothstep"
        def allDrawn:boolean true
        def k:int 0
        while (k < (array_length kinds)) {
            e.edgeType = (itemAt kinds k)
            clear e.waypoints
            def p:EdgePath (EdgeRouter.route(ed.graph e))
            p.flatten(2)
            if ((p.pointCount()) < 2) {
                allDrawn = false
            }
            k = (k + 1)
        }
        this.probe("connectorKinds" allDrawn "bezier, straight, step and smoothstep all produce a path")

        ; --- obstacle-avoiding orthogonal routing (JointJS `manhattan`) -----
        def g2 (new FlowGraph)
        def s:FlowNode (g2.node("s" "s" 0.0 0.0))
        def t:FlowNode (g2.node("t" "t" 600.0 0.0))
        s.width = 120.0
        s.height = 60.0
        t.width = 120.0
        t.height = 60.0
        def wall:FlowNode (g2.node("wall" "wall" 300.0 -30.0))
        wall.width = 120.0
        wall.height = 120.0
        def e2:FlowEdge (g2.connect("s" "t"))
        e2.edgeType = "smoothstep"
        g2.reindex()
        def broke:int (EdgeOverlap.nodeCrossings(g2))
        def fixed:int (OrthoRouter.repairAll(g2))
        def clear2:boolean ((EdgeOverlap.nodeCrossings(g2)) == 0)
        def routed:boolean false
        if (broke > 0) {
            if (fixed > 0) {
                routed = clear2
            }
        }
        this.probe("obstacleRouting" routed "a connector goes round a node standing in its way")

        ; --- shapes (both libraries publish a list) -------------------------
        def shapes:[string]
        push shapes "rect"
        push shapes "ellipse"
        push shapes "circle"
        push shapes "diamond"
        push shapes "hexagon"
        push shapes "parallelogram"
        push shapes "trapezoid"
        push shapes "cylinder"
        push shapes "document"
        push shapes "stadium"
        push shapes "note"
        push shapes "predefined"
        push shapes "triangle"
        push shapes "triangledown"
        push shapes "righttriangle"
        push shapes "pentagon"
        push shapes "pentagondown"
        push shapes "heptagon"
        push shapes "octagon"
        push shapes "decagon"
        push shapes "plus"
        push shapes "star"
        def allShapes:boolean true
        def si:int 0
        while (si < (array_length shapes)) {
            def name:string (itemAt shapes si)
            def ring:[double] (FlowShapes.outline(name 0.0 0.0 100.0 60.0))
            if ((idiv (array_length ring) 2) < 3) {
                if ((FlowShapes.isDecorated(name)) == false) {
                    if ((FlowShapes.isPlain(name)) == false) {
                        allShapes = false
                    }
                }
            }
            ; The point the label is drawn at has to be INSIDE the shape. The
            ; centre of the box is not that point for a triangle, and a label
            ; half outside its own shape is the failure this catches.
            def lx:double (FlowShapes.labelCX(name 0.0 0.0 100.0 60.0))
            def ly:double (FlowShapes.labelCY(name 0.0 0.0 100.0 60.0))
            if ((FlowShapes.holdsShape(name 0.0 0.0 100.0 60.0 lx ly)) == false) {
                allShapes = false
            }
            si = (si + 1)
        }
        this.probe("shapeLibrary" allShapes "every named shape has an outline, and its label sits inside it")

        ; --- an outline the caller supplies (Polygon) -----------------------
        def gp (new FlowGraph)
        def poly:FlowNode (gp.node("p" "poly" 0.0 0.0))
        poly.width = 120.0
        poly.height = 80.0
        poly.shape = (FlowShape.polygon())
        push poly.shapePoints 0.5
        push poly.shapePoints 0.0
        push poly.shapePoints 1.0
        push poly.shapePoints 0.4
        push poly.shapePoints 0.8
        push poly.shapePoints 1.0
        push poly.shapePoints 0.2
        push poly.shapePoints 1.0
        push poly.shapePoints 0.0
        push poly.shapePoints 0.4
        gp.reindex()
        def ring:[double] (poly.outline())
        def custom:boolean ((idiv (array_length ring) 2) == 5)
        if ((poly.holdsPoint(60.0 40.0)) == false) { custom = false }
        if (poly.holdsPoint(2.0 78.0)) { custom = false }
        this.probe("customPolygon" custom "a node can be given its own outline, and the pointer respects it")

        ; --- line jumps where two links cross -------------------------------
        def line:[double]
        push line 0.0
        push line 50.0
        push line 200.0
        push line 50.0
        def cross:[double]
        push cross 100.0
        push cross 0.0
        push cross 100.0
        push cross 100.0
        def hopped:[double] (EdgeRouter.bridgePolyline(line cross 5.0))
        def bridged:boolean ((idiv (array_length hopped) 2) > 2)
        ; The hop has to leave the line it is on: a "bridge" of collinear
        ; points is no bridge at all.
        def away:double 0.0
        def hi:int 0
        while (hi < (idiv (array_length hopped) 2)) {
            def hyAt:int ((hi * 2) + 1)
            def off:double (fabs ((itemAt hopped hyAt) - 50.0))
            if (off > away) { away = off }
            hi = (hi + 1)
        }
        if (away < 3.0) { bridged = false }
        ; …and it has to come back: the ends are where they were.
        def lastAt:int ((array_length hopped) - 2)
        if ((fabs ((itemAt hopped lastAt) - 200.0)) > 0.001) { bridged = false }
        this.probe("lineJumps" bridged "a line hops over one it crosses, and comes back")

        ; --- radial and mind map layouts ------------------------------------
        def gt (new FlowGraph)
        def rootN:FlowNode (gt.node("root" "root" 0.0 0.0))
        rootN.width = 120.0
        rootN.height = 50.0
        def bi:int 0
        while (bi < 4) {
            def bid:string ("b" + (to_string bi))
            def bn:FlowNode (gt.node(bid bid 0.0 0.0))
            bn.width = 110.0
            bn.height = 44.0
            gt.connect("root" bid)
            def li:int 0
            while (li < 3) {
                def lid:string ((bid + "l") + (to_string li))
                def ln:FlowNode (gt.node(lid lid 0.0 0.0))
                ln.width = 100.0
                ln.height = 40.0
                gt.connect(bid lid)
                li = (li + 1)
            }
            bi = (bi + 1)
        }
        gt.reindex()
        def rad:RadialLayout (RadialLayout.of(gt))
        rad.rootId = "root"
        def radMoved:int (rad.run())
        def radOk:boolean (radMoved == 16)
        def rootAt:FlowNode (gt.nodeById("root"))
        if ((fabs (rootAt.centerX())) > 0.001) { radOk = false }
        ; Every ring is further out than the one inside it, which is the whole
        ; claim a radial layout makes.
        def r1:FlowNode (gt.nodeById("b0"))
        def r2:FlowNode (gt.nodeById("b0l0"))
        def d1:double (ParityDump.dist(r1 rootAt))
        def d2:double (ParityDump.dist(r2 rootAt))
        if (d2 <= d1) { radOk = false }
        if ((EdgeOverlap.nodeCrossings(gt)) > 0) { radOk = false }
        this.probe("radialLayout" radOk "a radial tree puts the root in the middle and each generation on its own ring")

        def mind:MindMapLayout (MindMapLayout.of(gt))
        mind.rootId = "root"
        def mindMoved:int (mind.run())
        def left:int 0
        def right:int 0
        def mroot:FlowNode (gt.nodeById("root"))
        def mi:int 0
        while (mi < (gt.nodeCount())) {
            def mn:FlowNode (gt.nodeAt(mi))
            if (mn.id != "root") {
                if ((mn.centerX()) > (mroot.centerX())) { right = (right + 1) }
                if ((mn.centerX()) < (mroot.centerX())) { left = (left + 1) }
            }
            mi = (mi + 1)
        }
        def mindOk:boolean (mindMoved == 16)
        if (left < 4) { mindOk = false }
        if (right < 4) { mindOk = false }
        if ((EdgeOverlap.pairs(gt 2.0)) > 0) { mindOk = false }
        this.probe("mindMap" mindOk "a mind map balances its branches either side of the root")

        ; --- labels on both nodes and links (JointJS annotations) -----------
        def g3 (new FlowGraph)
        def na:FlowNode (g3.node("a" "A" 0.0 0.0))
        def nb:FlowNode (g3.node("b" "B" 300.0 0.0))
        na.width = 120.0
        na.height = 50.0
        nb.width = 120.0
        nb.height = 50.0
        def e3:FlowEdge (g3.connect("a" "b"))
        e3.label = "labelled"
        g3.reindex()
        def v3:FlowView (FlowView.of(g3))
        v3.width = 800.0
        v3.height = 600.0
        v3.showControls = false
        v3.showMinimap = false
        def sc3:FlowScene (v3.build())
        def sawNode:boolean false
        def sawEdge:boolean false
        def q:int 0
        while (q < (sc3.count())) {
            def it:SceneItem (sc3.at(q))
            if (it.kind == 1) {
                if (it.text == "A") { sawNode = true }
                if (it.text == "labelled") { sawEdge = true }
            }
            q = (q + 1)
        }
        def both:boolean sawNode
        if (sawEdge == false) { both = false }
        this.probe("annotations" both "a node and a link both carry a label that is drawn")

        ; --- wrapping and autofit (JointJS TextBlock, Syncfusion TextWrap) --
        def wide:double (v3.textWidth("Tarkista asiakkaan luottotiedot" 13.0))
        def wrapped:FlowTextLayout (v3.layoutText("Tarkista asiakkaan luottotiedot" 13.0 (wide * 0.7) 60.0 2))
        def shrunk:FlowTextLayout (v3.layoutText("Tarkista asiakkaan luottotiedot" 13.0 (wide * 0.85) 0.0 1))
        def fitted:boolean ((wrapped.lineCount()) == 2)
        if ((shrunk.size) >= 13.0) { fitted = false }
        if (shrunk.truncated) { fitted = false }
        this.probe("textWrap" fitted "a long label wraps, and shrinks rather than being cut")

        ; --- in-place editing (both libraries have it) ----------------------
        def ed4:FlowEditor (this.twoNodeEditor())
        def a4:FlowNode (ed4.graph.nodeById("a"))
        def was:string a4.label
        def started:boolean (ed4.beginEdit("node:a"))
        ed4.caretToEnd()
        ed4.typeText("!")
        def clean:boolean (a4.label == was)
        ed4.commitEdit()
        def wrote:boolean (a4.label == (was + "!"))
        def undone:boolean (ed4.undo.undo(ed4.graph))
        def back:boolean (a4.label == was)
        def editOk:boolean started
        if (clean == false) { editOk = false }
        if (wrote == false) { editOk = false }
        if (undone == false) { editOk = false }
        if (back == false) { editOk = false }
        this.probe("inPlaceEdit" editOk "a label is typed in place and one undo takes it back")


        ; --- hierarchical / embedded elements -------------------------------
        def ed5:FlowEditor (this.twoNodeEditor())
        def frame:FlowNode (ed5.graph.nodeById("a"))
        frame.nodeType = "group"
        frame.width = 400.0
        frame.height = 300.0
        def child:FlowNode (ed5.graph.nodeById("b"))
        child.parentId = "a"
        child.x = 60.0
        child.y = 60.0
        child.syncFromModel()
        def before5:double child.x
        frame.selected = true
        ed5.beginDrag()
        ed5.mode = 2
        ed5.pressX = 0.0
        ed5.pressY = 0.0
        ed5.lastX = 0.0
        ed5.lastY = 0.0
        def inp5 (new FlowInput)
        inp5.x = 50.0
        inp5.y = 0.0
        ed5.pointerMove(inp5)
        ed5.pointerUp(inp5)
        this.probe("embedding" (ParityDump.near((child.x - before5) 50.0 0.001)) "a container carries the elements embedded in it")

        ; --- serialization: a diagram you can save AND open -----------------
        def json:string (FlowGraphJson.toJson(g3))
        def reread:FlowGraph (FlowGraphJson.fromJson(json))
        def round:boolean ((reread.nodeCount()) == (g3.nodeCount()))
        if ((reread.edgeCount()) != (g3.edgeCount())) { round = false }
        if (round) {
            def ra:FlowNode (reread.nodeById("a"))
            if (ra.label != "A") { round = false }
            if ((fabs (ra.width - 120.0)) > 0.001) { round = false }
            def re:FlowEdge (reread.edgeAt(0))
            if (re.label != "labelled") { round = false }
        }
        this.probe("serialization" round "a diagram survives a round trip through JSON, labels and all")

        ; --- data binding from a flat id/parentId array ---------------------
        def src:string "[{\"id\":\"1\",\"parentId\":\"\",\"name\":\"Aino\"},{\"id\":\"2\",\"parentId\":\"1\",\"name\":\"Markus\"},{\"id\":\"3\",\"parentId\":\"1\",\"name\":\"Riikka\"},{\"id\":\"4\",\"parentId\":\"2\",\"name\":\"Sanna\"}]"
        def bound:FlowGraph (FlowGraphJson.fromDataSource(src "id" "parentId" "name"))
        def dataOk:boolean ((bound.nodeCount()) == 4)
        if ((bound.edgeCount()) != 3) { dataOk = false }
        if (dataOk) {
            def bn:FlowNode (bound.nodeById("2"))
            if (bn.label != "Markus") { dataOk = false }
        }
        this.probe("dataBinding" dataOk "a graph is built from a flat array of records naming their own parents")

        ; --- rulers ----------------------------------------------------------
        def gr (new FlowGraph)
        def rn:FlowNode (gr.node("a" "A" 0.0 0.0))
        rn.width = 120.0
        rn.height = 50.0
        gr.reindex()
        def vr:FlowView (FlowView.of(gr))
        vr.width = 800.0
        vr.height = 600.0
        vr.showControls = false
        vr.showMinimap = false
        vr.showRulers = true
        def scr:FlowScene (vr.build())
        def ticks:int 0
        def numbers:int 0
        def ri2:int 0
        while (ri2 < (scr.count())) {
            def it2:SceneItem (scr.at(ri2))
            if (it2.tag == "chrome") {
                if (it2.kind == 0) { ticks = (ticks + 1) }
                if (it2.kind == 1) { numbers = (numbers + 1) }
            }
            ri2 = (ri2 + 1)
        }
        def rulerOk:boolean (ticks > 8)
        if (numbers < 4) { rulerOk = false }
        this.probe("rulers" rulerOk "the surface carries a scale in flow units, with numbered ticks")

        ; --- graph API: elements at a point, how connected a node is --------
        def hit:int (g3.nodeAtPoint(60.0 25.0))
        def degs:[int] (g3.degrees())
        def api:boolean (hit >= 0)
        if ((array_length degs) != (g3.nodeCount())) { api = false }
        if ((itemAt degs 0) != 1) { api = false }
        this.probe("graphApi" api "the graph answers what is at a point and how connected each node is")
    }

    ; What a toolbar does. React Flow documents `connectOnClick` and
    ; `node.parentId`, so both are rows in the scorecard and both have to be
    ; driven through the real editor to claim them.
    fn probeAuthoring:void () {
        def ed:FlowEditor (this.twoNodeEditor())
        def inp (new FlowInput)
        ed.connectOnClick = true
        inp.x = 40.0
        inp.y = 20.0
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        inp.x = 340.0
        inp.y = 20.0
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        def made:boolean ((ed.graph.edgeCount()) == 1)
        this.probe("connectOnClick" made "clicking two nodes in turn joins them")

        ; Sub-flows: a child moves with its parent and keeps its own position.
        def ed2:FlowEditor (this.twoNodeEditor())
        def frame:FlowNode (ed2.graph.nodeById("a"))
        frame.nodeType = "group"
        frame.width = 400.0
        frame.height = 300.0
        def child:FlowNode (ed2.graph.nodeById("b"))
        child.parentId = "a"
        child.x = 60.0
        child.y = 60.0
        child.syncFromModel()
        def before:double child.x
        frame.selected = true
        ed2.beginDrag()
        ed2.mode = 2
        ed2.pressX = 0.0
        ed2.pressY = 0.0
        ed2.lastX = 0.0
        ed2.lastY = 0.0
        def inp2 (new FlowInput)
        inp2.x = 70.0
        inp2.y = 0.0
        ed2.pointerMove(inp2)
        ed2.pointerUp(inp2)
        def carried:boolean (ParityDump.near((child.x - before) 70.0 0.001))
        this.probe("subFlowDrag" carried "dragging a parent carries its children")

        ; The palette: one call, one node, one undo step.
        def ed3:FlowEditor (this.twoNodeEditor())
        def n0:int (ed3.graph.nodeCount())
        def added:FlowNode (ed3.addNode("New" "diamond" 200.0 200.0))
        def grew:boolean ((ed3.graph.nodeCount()) == (n0 + 1))
        def shaped:boolean (added.shape == "diamond")
        def undone:boolean (ed3.undo.undo(ed3.graph))
        def gone:boolean ((ed3.graph.nodeCount()) == n0)
        def all:boolean grew
        if (shaped == false) { all = false }
        if (undone == false) { all = false }
        if (gone == false) { all = false }
        this.probe("addNode" all "a node can be added, shaped, and taken back")
    }

    fn probeViewportBehaviour:void () {
        def ed:FlowEditor (this.twoNodeEditor())
        def inp (new FlowInput)
        ; pan: drag on empty pane
        def px:double ed.view.viewport.x
        inp.x = 700.0
        inp.y = 500.0
        ed.pointerDown(inp)
        inp.x = 760.0
        inp.y = 530.0
        ed.pointerMove(inp)
        ed.pointerUp(inp)
        this.probe("pan" (ParityDump.near((ed.view.viewport.x - px) 60.0 0.001)) "drag on the pane translates the viewport")

        ; zoom at cursor: the flow point under the pointer must not move
        def before:double (ed.view.viewport.toFlowX(400.0))
        def beforeY:double (ed.view.viewport.toFlowY(300.0))
        inp.x = 400.0
        inp.y = 300.0
        ed.wheel(inp -1.0)
        def okX:boolean (ParityDump.near((ed.view.viewport.toFlowX(400.0)) before 0.0001))
        def okY:boolean (ParityDump.near((ed.view.viewport.toFlowY(300.0)) beforeY 0.0001))
        def zoomed:boolean (ed.view.viewport.zoom > 1.0)
        def all:boolean false
        if okX {
            if okY {
                if zoomed { all = true }
            }
        }
        this.probe("zoomAtCursor" all "the flow point under the pointer is invariant")

        ; zoom limits
        ed.view.viewport.minZoom = 0.5
        ed.view.viewport.maxZoom = 1.5
        def i:int 0
        while (i < 40) {
            ed.wheel(inp -1.0)
            i = (i + 1)
        }
        def hi:boolean (ParityDump.near(ed.view.viewport.zoom 1.5 0.000001))
        def k:int 0
        while (k < 80) {
            ed.wheel(inp 1.0)
            k = (k + 1)
        }
        def lo:boolean (ParityDump.near(ed.view.viewport.zoom 0.5 0.000001))
        def clamped:boolean false
        if hi {
            if lo { clamped = true }
        }
        this.probe("zoomLimits" clamped "minZoom / maxZoom clamp the wheel")

        ; fitView centres the graph
        def ed2:FlowEditor (this.twoNodeEditor())
        ed2.fitView()
        def r:FlowRect (ed2.graph.bounds())
        def cx:double (ed2.view.viewport.toScreenX((r.centerX())))
        def cy:double (ed2.view.viewport.toScreenY((r.centerY())))
        def centred:boolean false
        if (ParityDump.near(cx 500.0 0.001)) {
            if (ParityDump.near(cy 300.0 0.001)) { centred = true }
        }
        this.probe("fitView" centred "fitView centres the graph in the viewport")

        ; the controls panel
        def ed3:FlowEditor (this.twoNodeEditor())
        ed3.view.showControls = true
        def z0:double ed3.view.viewport.zoom
        def btn (new FlowInput)
        btn.x = 26.0
        btn.y = ((600.0 - 112.0) + 14.0)
        ed3.pointerDown(btn)
        ed3.pointerUp(btn)
        this.probe("controlsZoomIn" (ed3.view.viewport.zoom > z0) "the + button zooms in")
        btn.y = ((600.0 - 112.0) + 70.0)
        ed3.pointerDown(btn)
        ed3.pointerUp(btn)
        def r3:FlowRect (ed3.graph.bounds())
        def fx:double (ed3.view.viewport.toScreenX((r3.centerX())))
        this.probe("controlsFit" (ParityDump.near(fx 500.0 0.001)) "the fit button frames the graph")
    }

    fn probeSelection:void () {
        def ed:FlowEditor (this.twoNodeEditor())
        def a:FlowNode (ed.graph.nodeById("a"))
        def b:FlowNode (ed.graph.nodeById("b"))
        def inp (new FlowInput)
        inp.x = 20.0
        inp.y = 20.0
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        this.probe("clickSelect" a.selected "clicking a node selects it")

        inp.x = 320.0
        inp.shift = true
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        this.probe("shiftAddSelect" ((ed.graph.selectedNodeCount()) == 2) "shift-click adds to the selection")
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        this.probe("shiftRemoveSelect" ((ed.graph.selectedNodeCount()) == 1) "shift-click again removes it")
        inp.shift = false

        ed.graph.clearSelection()
        inp.x = 600.0
        inp.y = 400.0
        inp.shift = true
        ed.pointerDown(inp)
        inp.x = -60.0
        inp.y = -60.0
        ed.pointerMove(inp)
        ed.pointerUp(inp)
        inp.shift = false
        this.probe("boxSelect" ((ed.graph.selectedNodeCount()) == 2) "shift-drag on the pane selects a rectangle")

        ed.graph.clearSelection()
        ed.keyDown("a" false true)
        this.probe("selectAll" ((ed.graph.selectedNodeCount()) == 2) "Ctrl+A selects every node")

        ed.keyDown("Escape" false false)
        this.probe("escapeClears" ((ed.graph.selectedNodeCount()) == 0) "Escape clears the selection")

        ; deleting takes the attached edges with it
        def ed2:FlowEditor (this.twoNodeEditor())
        ed2.graph.connect("a" "b")
        def n2:FlowNode (ed2.graph.nodeById("a"))
        n2.selected = true
        ed2.keyDown("Delete" false false)
        def gone:boolean false
        if ((ed2.graph.nodeCount()) == 1) {
            if ((ed2.graph.edgeCount()) == 0) { gone = true }
        }
        this.probe("deleteSelection" ((ed2.graph.nodeCount()) == 1) "Delete removes the selected nodes")
        this.probe("deleteTakesEdges" gone "…and the edges attached to them")
        ed2.keyDown("z" false true)
        def back:boolean false
        if ((ed2.graph.nodeCount()) == 2) {
            if ((ed2.graph.edgeCount()) == 1) { back = true }
        }
        this.probe("undoDelete" back "undo restores the node and its edges")

        ; per-node flags
        def ed3:FlowEditor (this.twoNodeEditor())
        def a3:FlowNode (ed3.graph.nodeById("a"))
        a3.selectable = false
        def inp3 (new FlowInput)
        inp3.x = 20.0
        inp3.y = 20.0
        ed3.pointerDown(inp3)
        ed3.pointerUp(inp3)
        this.probe("perNodeSelectable" (a3.selected == false) "selectable:false is respected")
        def b3:FlowNode (ed3.graph.nodeById("b"))
        b3.hidden = true
        this.probe("hiddenNodes" ((ed3.graph.nodeAtPoint(320.0 20.0)) < 0) "a hidden node is not hit-tested")
    }

    fn probeDragging:void () {
        def ed:FlowEditor (this.twoNodeEditor())
        def a:FlowNode (ed.graph.nodeById("a"))
        def b:FlowNode (ed.graph.nodeById("b"))
        def inp (new FlowInput)
        inp.x = 20.0
        inp.y = 20.0
        ed.pointerDown(inp)
        inp.x = 80.0
        inp.y = 60.0
        ed.pointerMove(inp)
        ed.pointerUp(inp)
        this.probe("dragNode" (ParityDump.near(a.x 60.0 0.001)) "a node follows the pointer")

        ed.keyDown("a" false true)
        inp.x = 80.0
        inp.y = 60.0
        ed.pointerDown(inp)
        inp.x = 100.0
        inp.y = 60.0
        ed.pointerMove(inp)
        ed.pointerUp(inp)
        def both:boolean false
        if (ParityDump.near(a.x 80.0 0.001)) {
            if (ParityDump.near(b.x 320.0 0.001)) { both = true }
        }
        this.probe("dragMultiple" both "every selected node moves together")

        ed.keyDown("z" false true)
        def undone:boolean false
        if (ParityDump.near(a.x 60.0 0.001)) {
            if (ParityDump.near(b.x 300.0 0.001)) { undone = true }
        }
        this.probe("undoMove" undone "one undo puts the whole group back")
        ed.keyDown("z" true true)
        this.probe("redoMove" (ParityDump.near(a.x 80.0 0.001)) "redo moves it forward again")

        def ed4:FlowEditor (this.twoNodeEditor())
        def a4:FlowNode (ed4.graph.nodeById("a"))
        a4.draggable = false
        def i4 (new FlowInput)
        i4.x = 20.0
        i4.y = 20.0
        ed4.pointerDown(i4)
        i4.x = 90.0
        ed4.pointerMove(i4)
        ed4.pointerUp(i4)
        this.probe("perNodeDraggable" (ParityDump.near(a4.x 0.0 0.001)) "draggable:false is respected")
    }

    fn probeConnecting:void () {
        def ed:FlowEditor (this.twoNodeEditor())
        def inp (new FlowInput)
        ; from a's right-hand port to b's left-hand port
        inp.x = 150.0
        inp.y = 25.0
        ed.pointerDown(inp)
        def started:boolean ed.view.connecting
        inp.x = 300.0
        ed.pointerMove(inp)
        ed.pointerUp(inp)
        this.probe("connectPorts" ((ed.graph.edgeCount()) == 1) "dragging port to port makes an edge")
        this.probe("connectPreview" started "the drag shows a live connection line")

        this.probe("connectValidationDuplicate" ((ed.graph.canConnect("a.out" "b.in")) == false) "the same pair cannot be connected twice")
        this.probe("connectValidationSelf" ((ed.graph.canConnect("a.out" "a.out")) == false) "a port cannot connect to itself")

        def limited:FlowPort (ed.graph.portRef("b.in"))
        limited.connectionLimit = 1
        this.probe("connectionLimit" ((ed.graph.canConnect("a.out" "b.in")) == false) "a handle honours its connection limit")

        def role:FlowPort (ed.graph.portRef("a.out"))
        role.role = "target"
        this.probe("portRoles" ((ed.graph.canConnect("a.out" "b.in")) == false) "a target-only handle refuses to be a source")

        def ed2:FlowEditor (this.twoNodeEditor())
        def a2:FlowNode (ed2.graph.nodeById("a"))
        def extra:FlowPort (FlowPort.create("a.out2" "a" 2 75.0))
        a2.addPort(extra)
        ed2.graph.reindex()
        def two:boolean false
        if (ed2.graph.hasPort("a.out")) {
            if (ed2.graph.hasPort("a.out2")) { two = true }
        }
        this.probe("multipleHandles" two "a node carries any number of handles, on any side")
    }

    fn probeResizeAndSnap:void () {
        def ed:FlowEditor (this.twoNodeEditor())
        def a:FlowNode (ed.graph.nodeById("a"))
        a.selected = true
        def inp (new FlowInput)
        inp.x = 150.0
        inp.y = 50.0
        ed.pointerDown(inp)
        inp.x = 240.0
        inp.y = 130.0
        ed.pointerMove(inp)
        ed.pointerUp(inp)
        def resized:boolean false
        if (ParityDump.near(a.width 240.0 0.001)) {
            if (ParityDump.near(a.height 130.0 0.001)) { resized = true }
        }
        this.probe("resizeNode" resized "the corner grip resizes a selected node")

        a.minWidth = 200.0
        a.minHeight = 100.0
        inp.x = 240.0
        inp.y = 130.0
        ed.pointerDown(inp)
        inp.x = 20.0
        inp.y = 20.0
        ed.pointerMove(inp)
        ed.pointerUp(inp)
        def floored:boolean false
        if (ParityDump.near(a.width 200.0 0.001)) {
            if (ParityDump.near(a.height 100.0 0.001)) { floored = true }
        }
        this.probe("resizeMinSize" floored "a node cannot be resized below its minimum")

        def ed2:FlowEditor (this.twoNodeEditor())
        ed2.snapToGrid = true
        ed2.snapSize = 25.0
        def b2:FlowNode (ed2.graph.nodeById("a"))
        def i2 (new FlowInput)
        i2.x = 20.0
        i2.y = 20.0
        ed2.pointerDown(i2)
        i2.x = 27.0
        i2.y = 33.0
        ed2.pointerMove(i2)
        ed2.pointerUp(i2)
        def snapped:boolean false
        if (ParityDump.near(b2.x 0.0 0.001)) {
            if (ParityDump.near(b2.y 25.0 0.001)) { snapped = true }
        }
        this.probe("snapPosition" snapped "a dragged node lands on the grid")

        def c2:FlowNode (ed2.graph.nodeById("b"))
        c2.selected = true
        c2.resizable = true
        def i3 (new FlowInput)
        i3.x = (ed2.view.viewport.toScreenX(450.0))
        i3.y = (ed2.view.viewport.toScreenY(50.0))
        ed2.pointerDown(i3)
        i3.x = (ed2.view.viewport.toScreenX(457.0))
        i3.y = (ed2.view.viewport.toScreenY(69.0))
        ed2.pointerMove(i3)
        ed2.pointerUp(i3)
        this.probe("snapSize" (ParityDump.near(c2.width 150.0 0.001)) "a resized node lands on the grid too")
    }

    fn probeEdgesAndChrome:void () {
        def ed:FlowEditor (this.twoNodeEditor())
        def e:FlowEdge (ed.graph.connect("a" "b"))
        e.edgeType = "straight"
        ; a click near the middle of the edge, in screen space
        def mx:double (ed.view.viewport.toScreenX(225.0))
        def my:double (ed.view.viewport.toScreenY(25.0))
        def inp (new FlowInput)
        inp.x = mx
        inp.y = my
        ed.pointerDown(inp)
        ed.pointerUp(inp)
        this.probe("edgeSelect" e.selected "clicking near an edge selects it")

        ; the four edge types all produce a path with length
        def kinds:[string] ([] _:string ( "default" "straight" "step" "smoothstep" ))
        def allOk:boolean true
        def i:int 0
        while (i < 4) {
            def p:EdgePath (EdgeRouter.routeBetween(0.0 0.0 1 300.0 200.0 3 (itemAt kinds i)))
            p.flatten(16)
            if ((p.totalLength()) < 100.0) {
                allOk = false
            }
            i = (i + 1)
        }
        this.probe("edgeTypes" allOk "bezier, straight, step and smoothstep all route")

        e.label = "1..*"
        def sc:FlowScene (ed.view.build())
        this.probe("edgeLabels" (ParityDump.hasText(sc "1..*")) "an edge label is drawn on the path")

        def deco:EdgeDecoration (EdgeDecoration.build("arrowclosed" 100.0 100.0 0.0 9.0))
        this.probe("markers" ((deco.shapeCount()) > 0) "edge markers are drawn at the ends")

        ; background variants
        def variants:boolean true
        def v:int 0
        while (v < 4) {
            ed.view.theme.backgroundVariant = v
            def scv:FlowScene (ed.view.build())
            if (v == 0) {
                ; nothing but the base fill and the graph itself
                if ((scv.count()) < 1) { variants = false }
            } {
                if ((scv.count()) < 10) { variants = false }
            }
            v = (v + 1)
        }
        ed.view.theme.backgroundVariant = 1
        this.probe("backgroundVariants" variants "dots, lines, cross and none")

        ; minimap and culling
        ed.view.showMinimap = true
        def scm:FlowScene (ed.view.build())
        this.probe("minimap" ((ParityDump.countTag(scm "chrome")) > 2) "the minimap draws the graph and the viewport")
        ed.view.showMinimap = false

        ed.view.viewport.x = -100000.0
        ed.view.build()
        def culled:boolean false
        if (ed.view.drawnNodes == 0) {
            if (ed.view.culledNodes == 2) { culled = true }
        }
        this.probe("culling" culled "off-screen nodes are dropped while building")

        ; themes
        def dark:FlowTheme (FlowTheme.dark())
        def light:FlowTheme (FlowTheme.light())
        this.probe("darkTheme" (dark.background != light.background) "a dark theme, read by the renderer and the exporters alike")
    }

    sfn hasText:boolean (sc:FlowScene text:string) {
        def i:int 0
        while (i < (sc.count())) {
            def it:SceneItem (sc.at(i))
            if (it.kind == 1) {
                if (it.text == text) {
                    return true
                }
            }
            i = (i + 1)
        }
        return false
    }

    sfn countTag:int (sc:FlowScene tag:string) {
        def n:int 0
        def i:int 0
        while (i < (sc.count())) {
            def it:SceneItem (sc.at(i))
            if (it.tag == tag) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }
}

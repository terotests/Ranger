# The style keywords, on the objects that accept them.
plain: { style: { opacity: 0.7; stroke: "#2a6"; fill: "#eef"; stroke-width: 3; stroke-dash: 4; border-radius: 8 } }
text_style: { style: { font-size: 28; font-color: "#906"; bold: true; italic: true; underline: true; text-transform: uppercase } }
patterned: { style.fill-pattern: dots }
shadowed: { style.shadow: true }
stacked: { style.multiple: true }
doubled: { style.double-border: true }
boxy: { shape: square; style.3d: true }
mono: { style.font: mono }
x -> y: { style: { animated: true; stroke-width: 2; stroke-dash: 5 } }

# Icons, tooltips and links — the three things a shape carries beyond text.
server: {
  icon: https://icons.terrastruct.com/essentials/112-server.svg
  tooltip: the one that pages you
  link: https://example.com/runbook
}
disk: { shape: cylinder; icon: https://icons.terrastruct.com/essentials/117-hard-drive.svg }
server -> disk: writes { tooltip: fsync every 200ms }

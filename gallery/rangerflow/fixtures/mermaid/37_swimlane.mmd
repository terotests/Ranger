%% `swimlane-beta` is a flowchart with a lane layout: Mermaid reuses the
%% flowchart parser wholesale and swaps the layout engine.
swimlane-beta
    subgraph Customer
        order[Place order] --> pay[Pay]
    end
    subgraph Warehouse
        pick[Pick the goods] --> pack[Pack]
    end
    subgraph Courier
        ship[Ship] --> deliver[Deliver]
    end
    pay --> pick
    pack --> ship
    deliver --> done[Done]

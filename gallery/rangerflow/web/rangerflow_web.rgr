; ============================================================================
; rangerflow_web.rgr — the editor, with no host process.
; ============================================================================
;
;   browser event → RangerFlowWeb → FlowEditor          (in this tab)
;   FlowEditor.sceneJson() → EVGDisplayList → evg-webgl.js   (in this tab)
;
; Ranger compiles to JavaScript, so the app simply *is* in the page. There is
; no server in the middle and no scene fetched sixty times a second from a
; process on the same machine: the editor runs in the tab, hands the WebGL
; renderer a display list, and the only thing fetched is what a browser cannot
; make for itself — the font faces and a `.sql` file to open.
;
; This class is a facade and nothing else. Every decision it might be tempted
; to make lives one layer down, where the tests can reach it.
; ============================================================================

Import "../core/FlowEditor.rgr"
Import "../domains/erd/SqlSchemaReader.rgr"
Import "../domains/erd/SchemaToGraph.rgr"
Import "../domains/uml/UMLModel.rgr"
Import "../domains/uml/UMLActivity.rgr"
Import "../domains/flowchart/Flowchart.rgr"
Import "../domains/mermaid/MermaidReader.rgr"
Import "../domains/mermaid/MermaidClassReader.rgr"
Import "../domains/mermaid/MermaidErReader.rgr"
Import "../domains/mermaid/MermaidStateReader.rgr"
Import "../domains/mermaid/MermaidMindMapReader.rgr"
Import "../domains/mermaid/MermaidRequirementReader.rgr"
Import "../domains/mermaid/MermaidC4Reader.rgr"
Import "../domains/mermaid/MermaidTimelineReader.rgr"
Import "../domains/mermaid/MermaidJourneyReader.rgr"
Import "../domains/mermaid/MermaidGanttReader.rgr"
Import "../domains/mermaid/MermaidSequenceReader.rgr"
Import "../domains/mermaid/MermaidGitReader.rgr"
Import "../domains/mermaid/MermaidKanbanReader.rgr"
Import "../domains/mermaid/MermaidQuadrantReader.rgr"
Import "../domains/mermaid/MermaidPieReader.rgr"
Import "../domains/mermaid/MermaidXyReader.rgr"
Import "../domains/mermaid/MermaidSankeyReader.rgr"
Import "../domains/mermaid/MermaidBlockReader.rgr"
Import "../domains/mermaid/MermaidArchReader.rgr"
Import "../domains/mermaid/MermaidSwimlaneReader.rgr"
Import "../domains/business/BusinessCharts.rgr"
Import "../layout/TreeLayouts.rgr"
Import "../export/FlowExport.rgr"
Import "../layout/LayeredLayout.rgr"
Import "../layout/ForceLayout.rgr"
Import "../layout/EdgeLanes.rgr"
Import "../layout/OrthoRouter.rgr"

class RangerFlowWeb {
    def graph:FlowGraph (new FlowGraph)
    def editor:FlowEditor (new FlowEditor)
    def sim:FlowSimulation (new FlowSimulation)
    def simRunning:boolean false
    def input:FlowInput (new FlowInput)
    def status:string ""
    def layoutName:string "layered"
    ; Kept here because `loadSql` builds a new editor, and an editor that
    ; forgot the canvas size culls everything and draws nothing.
    def viewW:double 1200.0
    def viewH:double 800.0
    ; The fetched fixture, kept so the scenario picker can return to it.
    def fixtureSql:string ""
    ; The last Mermaid source rendered, and the look it was rendered in. Kept
    ; so changing the look is a re-render rather than a re-type.
    def mermaidText:string ""
    def mermaidStyle:string "default"
    ; Whether the viewer has taken the wheel. Until then a running simulation
    ; is allowed to reframe itself; after that it must not move under them.
    def userMoved:boolean false

    Constructor () {
    }

    fn init:void (w:double h:double) {
        editor = (FlowEditor.of(graph))
        this.resize(w h)
    }

    fn resize:void (w:double h:double) {
        viewW = w
        viewH = h
        editor.setSize(w h)
    }

    ; --------------------------------------------------------------- input --
    fn pointerDown:void (x:double y:double shift:boolean ctrl:boolean) {
        input.x = x
        input.y = y
        input.shift = shift
        input.ctrl = ctrl
        input.secondary = false
        userMoved = true
        editor.pointerDown(input)
        if simRunning {
            editor.pinWhileDragging = true
            sim.alpha = 0.35
        }
    }

    fn pointerMove:void (x:double y:double shift:boolean ctrl:boolean) {
        input.x = x
        input.y = y
        input.shift = shift
        input.ctrl = ctrl
        editor.pointerMove(input)
    }

    fn pointerUp:void (x:double y:double shift:boolean ctrl:boolean) {
        input.x = x
        input.y = y
        input.shift = shift
        input.ctrl = ctrl
        editor.pointerUp(input)
        ; Lanes and routes are only valid for the positions they were computed
        ; from, so a drag or a new connection invalidates both. The layout's
        ; routes are not recomputed — once a node has been moved by hand the
        ; layering it was routed against is no longer what is on screen.
        ;
        ; ONLY when something actually moved. This used to run on every pointer
        ; up, so a click that selected a node — or missed everything — threw
        ; away the routes the diagram was laid out with and drew them again
        ; from scratch, and the picture rearranged itself under a reader who
        ; had touched nothing. The editor already knows the difference: it sets
        ; `onGraphChanged` when a gesture moved, connected or deleted
        ; something, and a plain click does not.
        if (editor.onGraphChanged) {
            editor.onGraphChanged = false
            if (simRunning == false) {
                EdgeLanes.reset(graph)
                EdgeLanes.assign(graph)
                ; Whatever the drag put in somebody's way, routed round. Only
                ; the broken edges are touched, so this costs a Dijkstra or two
                ; rather than a rewrite of the diagram.
                OrthoRouter.repairAll(graph)
            }
        }
    }

    ; The right-hand button, or a long press. It goes through the same
    ; pointerDown as everything else — the editor decides what the menu says
    ; and what a row does; the page only reports which button it was.
    fn contextDown:void (x:double y:double) {
        input.x = x
        input.y = y
        input.shift = false
        input.ctrl = false
        input.secondary = true
        userMoved = true
        editor.pointerDown(input)
    }

    fn menuOpen:boolean () {
        return (editor.menuOpen())
    }

    fn closeMenu:void () {
        editor.closeMenu()
    }

    ; --- two fingers ---------------------------------------------------------
    fn pinchBegin:void (x1:double y1:double x2:double y2:double) {
        userMoved = true
        editor.pinchBegin(x1 y1 x2 y2)
    }

    fn pinchTo:void (x1:double y1:double x2:double y2:double) {
        userMoved = true
        editor.pinchTo(x1 y1 x2 y2)
    }

    fn pinchEnd:void () {
        editor.pinchEnd()
    }

    ; --- columns on a table ---------------------------------------------------
    ; A schema you can look at and not change is a picture of a schema. Both
    ; of these put the caret where the reader is going to type next, because a
    ; column called `uusi_sarake` that you then have to hunt for is a column
    ; nobody renames.
    fn addRow:int () {
        def at:int (editor.addRowToSelected())
        if (at >= 0) { userMoved = true }
        return at
    }

    fn removeRow:boolean () {
        def ok:boolean (editor.removeRowFromSelected())
        if ok { userMoved = true }
        return ok
    }

    ; How many columns the selected table has — what a button greys itself out
    ; on, and what a test asserts.
    fn selectedRowCount:int () {
        def n:FlowNode (editor.selectedNode())
        if ((strlen n.id) == 0) {
            return -1
        }
        if ((n.sectionCount()) == 0) {
            return -1
        }
        return (n.rowTotal())
    }

    ; --- what the toolbar can now ask for ------------------------------------
    fn rotateSelected:int () {
        def n:int (editor.rotateSelected(90.0))
        if (n > 0) { userMoved = true }
        return n
    }

    fn duplicateSelection:int () {
        def n:int (editor.duplicateSelection())
        if (n > 0) { userMoved = true }
        return n
    }

    ; Mark a node — a search hit, a table a query touches. "" clears it.
    fn setHighlight:boolean (id:string kind:string) {
        if ((graph.hasNode(id)) == false) {
            return false
        }
        def n:FlowNode (graph.nodeById(id))
        n.highlight = kind
        return true
    }

    fn clearHighlights:void () {
        def i:int 0
        while (i < (graph.nodeCount())) {
            def n:FlowNode (graph.nodeAt(i))
            n.highlight = ""
            i = (i + 1)
        }
    }

    ; What the pointer should look like where it is. The segment handles are
    ; invisible, so the cursor is the only thing that says they are there.
    fn cursorAt:string (x:double y:double) {
        if (editor.mode == 6) {
            if editor.segVertical {
                return "ew-resize"
            }
            return "ns-resize"
        }
        if (editor.mode != 0) {
            return ""
        }
        def hit:int (editor.segmentAt(x y))
        if (hit < 0) {
            return ""
        }
        if (editor.segmentIsVertical(hit)) {
            return "ew-resize"
        }
        return "ns-resize"
    }

    ; The browser hands over the three facts it has and the editor decides
    ; what the gesture was — see FlowEditor.wheelGesture. Passing the raw
    ; numbers rather than a pre-digested "zoom by this much" is what makes the
    ; classification testable without a browser.
    fn wheelGesture:void (x:double y:double dx:double dy:double pinch:boolean lineMode:boolean) {
        userMoved = true
        editor.wheelGesture(x y dx dy pinch lineMode)
    }

    fn wheel:void (x:double y:double delta:double) {
        input.x = x
        input.y = y
        userMoved = true
        editor.wheel(input delta)
    }

    ; Is a connection waiting for its far end? The page uses it for the cursor
    ; and to keep the connect button lit.
    fn pendingConnect:boolean () {
        return (editor.pending())
    }

    fn cancelPending:void () {
        editor.cancelPending()
    }

    fn keyDown:boolean (key:string shift:boolean ctrl:boolean) {
        return (editor.keyDown(key shift ctrl))
    }

    fn fitView:void () {
        editor.fitView()
    }

    ; ------------------------------------------------------------ scenarios --
    ; The demos the page can show, by name. Each one builds a graph and picks
    ; the layout and notation that suit it — a schema wants layered and crow's
    ; foot, a class diagram wants top-to-bottom and UML, a force graph wants
    ; neither. `?scenario=uml` in the URL picks one, and so does the dropdown.
    fn loadScenario:boolean (name:string) {
        if (name == "uml") {
            return (this.loadUml())
        }
        if (name == "force") {
            return (this.loadForceDemo())
        }
        if (name == "flow") {
            return (this.loadFlowchart())
        }
        if (name == "atk") {
            return (this.loadAtkChart())
        }
        if (name == "mermaid") {
            def sample:string (RangerFlowWeb.sampleMermaid())
            return (this.loadMermaidStyled(sample mermaidStyle))
        }
        if (name == "org") {
            return (this.loadOrgChart())
        }
        if (name == "process") {
            return (this.loadProcess())
        }
        if (name == "mindmap") {
            return (this.loadMindMap())
        }
        if (name == "radial") {
            return (this.loadRadial())
        }
        if (name == "activity") {
            return (this.loadActivity())
        }
        return (this.loadSqlFixture())
    }

    fn loadSqlFixture:boolean () {
        if ((strlen fixtureSql) == 0) {
            status = "the schema fixture has not been fetched yet"
            return false
        }
        return (this.loadSql(fixtureSql))
    }

    ; The page fetches ecommerce.sql once and hands it over; keeping it lets
    ; the scenario dropdown come back to it without a second round trip.
    fn setFixtureSql:void (sql:string) {
        fixtureSql = sql
    }

    fn adopt:void (g:FlowGraph) {
        userMoved = false
        graph = g
        editor = (FlowEditor.of(graph))
        editor.setSize(viewW viewH)
    }

    fn loadUml:boolean () {
        def d (new UMLDiagram)
        def shape:UMLClass (d.umlClass("Shape"))
        shape.stereotype = "abstract"
        shape.attribute("#" "origin" "Point")
        shape.operation("+" "area" "" "double")
        shape.operation("+" "draw" "ctx: Canvas" "void")
        def rect:UMLClass (d.umlClass("Rectangle"))
        rect.attribute("-" "width" "double")
        rect.attribute("-" "height" "double")
        rect.operation("+" "area" "" "double")
        def circle:UMLClass (d.umlClass("Circle"))
        circle.attribute("-" "radius" "double")
        circle.operation("+" "area" "" "double")
        def poly:UMLClass (d.umlClass("Polygon"))
        poly.attribute("-" "points" "[Point]")
        poly.operation("+" "area" "" "double")
        def canvas:UMLClass (d.umlClass("Canvas"))
        canvas.attribute("-" "shapes" "[Shape]")
        canvas.operation("+" "add" "s: Shape" "void")
        canvas.operation("+" "render" "" "void")
        def point:UMLClass (d.umlClass("Point"))
        point.stereotype = "record"
        point.attribute("+" "x" "double")
        point.attribute("+" "y" "double")
        d.relate("Rectangle" "Shape" "inheritance")
        d.relate("Circle" "Shape" "inheritance")
        d.relate("Polygon" "Shape" "inheritance")
        def owns:UMLRelation (d.relate("Canvas" "Shape" "composition"))
        owns.toMultiplicity = "0..*"
        d.relate("Shape" "Point" "aggregation")
        def u2g (new UMLToGraph)
        def g:FlowGraph (u2g.build(d))
        this.adopt(g)
        editor.view.notation = "uml"
        layoutName = "layered"
        def lay:LayeredLayout (LayeredLayout.of(graph))
        lay.direction = "TB"
        lay.layerGap = 110.0
        lay.nodeGap = 40.0
        lay.run()
        EdgeLanes.assign(graph)
        lay.routeLongEdges()
        ; A second lane pass, now that the chained routes exist: the first one
        ; could not see them, so a track and a chain could end up drawn four
        ; pixels apart. This one treats the chains as lines to keep clear of.
        EdgeLanes.assign(graph)
        OrthoRouter.repairAll(graph)
        simRunning = false
        editor.pinWhileDragging = false
        status = ((to_string (g.nodeCount())) + " classes, " + (to_string (g.edgeCount())) + " relations — drag a line from the middle to route it by hand")
        return true
    }

    ; React Flow's force-layout example, which is where this library started:
    ; a tree with a few cross links under d3-force, running live, and a node
    ; you drag is pinned while you hold it.
    fn loadForceDemo:boolean () {
        def g (new FlowGraph)
        def i:int 0
        while (i < 30) {
            def n:FlowNode (g.node(("n" + (to_string i)) ("node " + (to_string i)) 0.0 0.0))
            n.width = 110.0
            n.height = 40.0
            i = (i + 1)
        }
        def k:int 1
        while (k < 30) {
            def parent:int (idiv (k - 1) 3)
            def e:FlowEdge (g.connect(("n" + (to_string parent)) ("n" + (to_string k))))
            e.edgeType = "default"
            e.markerEnd = ""
            k = (k + 1)
        }
        def x1:FlowEdge (g.connect("n5" "n17"))
        x1.edgeType = "default"
        x1.markerEnd = ""
        def x2:FlowEdge (g.connect("n8" "n23"))
        x2.edgeType = "default"
        x2.markerEnd = ""
        def x3:FlowEdge (g.connect("n11" "n26"))
        x3.edgeType = "default"
        x3.markerEnd = ""
        this.adopt(g)
        editor.view.notation = "plain"
        layoutName = "force"
        sim = (FlowSimulation.reactFlowExample(graph -1000.0 150.0))
        sim.collideEnabled = true
        simRunning = true
        editor.pinWhileDragging = true
        status = "d3-force, 30 nodes — drag one and it pins while you hold it"
        return true
    }

    ; A plain flowchart, because a graph editor should not need a domain to be
    ; useful — and because it is the one scenario with no compartments in it.
    fn loadFlowchart:boolean () {
        def g (new FlowGraph)
        def start:FlowNode (g.node("start" "Pull request opened" 0.0 0.0))
        start.nodeType = "input"
        start.width = 190.0
        start.height = 46.0
        def lint:FlowNode (g.node("lint" "Lint" 0.0 0.0))
        lint.width = 150.0
        lint.height = 44.0
        def test:FlowNode (g.node("test" "Unit tests" 0.0 0.0))
        test.width = 150.0
        test.height = 44.0
        def parity:FlowNode (g.node("parity" "Parity meter" 0.0 0.0))
        parity.width = 150.0
        parity.height = 44.0
        def review:FlowNode (g.node("review" "Review" 0.0 0.0))
        review.width = 150.0
        review.height = 44.0
        def merge:FlowNode (g.node("merge" "Merge" 0.0 0.0))
        merge.nodeType = "output"
        merge.width = 150.0
        merge.height = 44.0
        def fix:FlowNode (g.node("fix" "Push a fix" 0.0 0.0))
        fix.width = 150.0
        fix.height = 44.0
        g.connect("start" "lint")
        g.connect("start" "test")
        g.connect("start" "parity")
        g.connect("lint" "review")
        g.connect("test" "review")
        g.connect("parity" "review")
        g.connect("review" "merge")
        def back:FlowEdge (g.connect("review" "fix"))
        back.label = "changes requested"
        back.edgeType = "smoothstep"
        def again:FlowEdge (g.connect("fix" "start"))
        again.edgeType = "smoothstep"
        this.adopt(g)
        editor.view.notation = "plain"
        layoutName = "layered"
        def lay:LayeredLayout (LayeredLayout.of(graph))
        lay.direction = "LR"
        lay.layerGap = 90.0
        lay.nodeGap = 26.0
        lay.run()
        EdgeLanes.assign(graph)
        lay.routeLongEdges()
        ; A second lane pass, now that the chained routes exist: the first one
        ; could not see them, so a track and a chain could end up drawn four
        ; pixels apart. This one treats the chains as lines to keep clear of.
        EdgeLanes.assign(graph)
        OrthoRouter.repairAll(graph)
        simRunning = false
        editor.pinWhileDragging = false
        status = "a flowchart — drag a line from the middle to route it by hand"
        return true
    }

    ; ------------------------------------------------------- tree layouts ---
    ; A mind map and a radial tree from the SAME graph, which is the point: a
    ; layout is a way of reading a hierarchy, not a kind of diagram. The graph
    ; is built the way a real one would be — a flat array of records naming
    ; their own parents, which is what a REST call gives you.
    fn treeSource:string () {
        return "[{\"id\":\"rf\",\"parent\":\"\",\"name\":\"RangerFlow\"},{\"id\":\"core\",\"parent\":\"rf\",\"name\":\"Core\"},{\"id\":\"model\",\"parent\":\"core\",\"name\":\"Graph model\"},{\"id\":\"shapes\",\"parent\":\"core\",\"name\":\"Shapes\"},{\"id\":\"text\",\"parent\":\"core\",\"name\":\"Text fitting\"},{\"id\":\"lay\",\"parent\":\"rf\",\"name\":\"Layout\"},{\"id\":\"layered\",\"parent\":\"lay\",\"name\":\"Layered\"},{\"id\":\"force\",\"parent\":\"lay\",\"name\":\"Force\"},{\"id\":\"radial\",\"parent\":\"lay\",\"name\":\"Radial\"},{\"id\":\"mind\",\"parent\":\"lay\",\"name\":\"Mind map\"},{\"id\":\"route\",\"parent\":\"rf\",\"name\":\"Routing\"},{\"id\":\"lanes\",\"parent\":\"route\",\"name\":\"Lanes\"},{\"id\":\"ortho\",\"parent\":\"route\",\"name\":\"Grid router\"},{\"id\":\"jump\",\"parent\":\"route\",\"name\":\"Line jumps\"},{\"id\":\"out\",\"parent\":\"rf\",\"name\":\"Output\"},{\"id\":\"gl\",\"parent\":\"out\",\"name\":\"WebGL\"},{\"id\":\"pdf\",\"parent\":\"out\",\"name\":\"PDF\"},{\"id\":\"svg\",\"parent\":\"out\",\"name\":\"SVG\"}]"
    }

    fn loadMindMap:boolean () {
        def g:FlowGraph (FlowGraphJson.fromDataSource((this.treeSource()) "id" "parent" "name"))
        this.adopt(g)
        editor.view.notation = "plain"
        layoutName = "none"
        def m:MindMapLayout (MindMapLayout.of(graph))
        m.rootId = "rf"
        m.run()
        simRunning = false
        editor.pinWhileDragging = false
        status = ((to_string (g.nodeCount())) + " solmua — mind map, haarat tasapainossa juuren molemmin puolin")
        return true
    }

    fn loadRadial:boolean () {
        def g:FlowGraph (FlowGraphJson.fromDataSource((this.treeSource()) "id" "parent" "name"))
        this.adopt(g)
        editor.view.notation = "plain"
        layoutName = "none"
        def r:RadialLayout (RadialLayout.of(graph))
        r.rootId = "rf"
        r.run()
        simRunning = false
        editor.pinWhileDragging = false
        status = ((to_string (g.nodeCount())) + " solmua — säteittäinen puu, sukupolvi per kehä")
        return true
    }

    fn setRulers:void (on:boolean) {
        editor.view.showRulers = on
    }

    fn setBridges:void (on:boolean) {
        editor.view.bridgeEdges = on
    }

    ; ------------------------------------------------- business and ATK ----
    ; The ATK chart in the shapes it is supposed to be in — a stadium for the
    ; start, a diamond for the decision, a drum for the register, a page with a
    ; wavy foot for the printed invoice. The shape is the sentence; the label
    ; only says which one.
    fn loadAtkChart:boolean () {
        def c (new Flowchart)
        c.start("alku" "Alku")
        c.step("tilaus" "Lue tilaus" (FlowKind.io()))
        c.step("asiakas" "Asiakasrekisteri" (FlowKind.database()))
        c.step("tarkista" "Tarkista luottotiedot" (FlowKind.process()))
        c.step("luotto" "Luotto kunnossa?" (FlowKind.decision()))
        c.step("varasto" "Varaa tuotteet" (FlowKind.process()))
        c.step("saldo" "Riittääkö saldo?" (FlowKind.decision()))
        c.step("jalki" "Merkitse jälkitoimitukseen" (FlowKind.process()))
        c.step("laskuta" "Muodosta lasku" (FlowKind.predefined()))
        c.step("lasku" "Lasku asiakkaalle" (FlowKind.document()))
        c.step("hylkaa" "Ilmoita hylkäys" (FlowKind.manual()))
        c.step("loppu" "Loppu" (FlowKind.terminator()))
        c.link("alku" "tilaus")
        c.link("tilaus" "tarkista")
        c.link("asiakas" "tarkista")
        c.link("tarkista" "luotto")
        c.branch("luotto" "varasto" "kyllä")
        c.branch("luotto" "hylkaa" "ei")
        c.link("varasto" "saldo")
        c.branch("saldo" "laskuta" "kyllä")
        c.branch("saldo" "jalki" "ei")
        c.link("jalki" "laskuta")
        c.link("laskuta" "lasku")
        c.link("lasku" "loppu")
        c.link("hylkaa" "loppu")
        def g:FlowGraph (c.build())
        this.adopt(g)
        editor.view.notation = "plain"
        layoutName = "layered"
        def lay:LayeredLayout (LayeredLayout.of(graph))
        lay.direction = "TB"
        lay.layerGap = 70.0
        lay.nodeGap = 46.0
        lay.run()
        Flowchart.faceEdges(graph)
        EdgeLanes.assign(graph)
        lay.routeLongEdges()
        EdgeLanes.assign(graph)
        OrthoRouter.repairAll(graph)
        simRunning = false
        editor.pinWhileDragging = false
        status = ((to_string (g.nodeCount())) + " vaihetta, " + (to_string (g.edgeCount())) + " yhteyttä — ATK-kaavio ISO 5807:n muodoilla")
        return true
    }

    ; ------------------------------------------------------------ mermaid ----
    ; Text somebody wrote in a README, on the screen and draggable. This is
    ; the whole of the browser side of it: the reader does the parsing, the
    ; pipeline does the layout, and the editor does not know where the graph
    ; came from.
    fn loadMermaid:boolean (text:string) {
        return (this.loadMermaidStyled(text mermaidStyle))
    }

    ; The same source in another look. A stylesheet cannot change what the
    ; diagram says, so this re-reads and re-lays-out rather than trying to
    ; repaint in place — at these sizes it is a few milliseconds, and the
    ; alternative is a second code path that can disagree with the first.
    fn setMermaidStyle:boolean (name:string) {
        mermaidStyle = name
        if ((strlen mermaidText) == 0) {
            return false
        }
        return (this.loadMermaidStyled(mermaidText name))
    }

    fn loadMermaidStyled:boolean (text:string styleName:string) {
        def d:MermaidDiagram (MermaidReader.parse(text))
        ; A diagram that names its own theme gets it, unless the reader has
        ; picked one from the dropdown.
        def want:string styleName
        if ((strlen want) == 0) {
            want = "default"
        }
        if (want == "default") {
            if ((strlen d.themeName) > 0) {
                if (FlowStyles.knows(d.themeName)) {
                    want = d.themeName
                }
            }
        }
        ; A class diagram is the other one RangerFlow can draw: it has the UML
        ; model already, so the text goes to the class reader instead.
        if (d.diagramKind == "class") {
            return (this.loadMermaidClass(text styleName want))
        }
        if (d.diagramKind == "er") {
            return (this.loadMermaidEr(text styleName want))
        }
        if (d.diagramKind == "state") {
            return (this.loadMermaidState(text styleName want))
        }
        if (d.diagramKind == "mindmap") {
            return (this.loadMermaidMindMap(text styleName want))
        }
        if (d.diagramKind == "requirement") {
            return (this.loadMermaidRequirement(text styleName want))
        }
        if (d.diagramKind == "c4") {
            return (this.loadMermaidC4(text styleName want))
        }
        if (d.diagramKind == "timeline") {
            return (this.loadMermaidTimeline(text styleName want))
        }
        if (d.diagramKind == "journey") {
            return (this.loadMermaidJourney(text styleName want))
        }
        if (d.diagramKind == "gantt") {
            return (this.loadMermaidGantt(text styleName want))
        }
        if (d.diagramKind == "sequence") {
            return (this.loadMermaidSequence(text styleName want))
        }
        if (d.diagramKind == "git") {
            return (this.loadMermaidGit(text styleName want))
        }
        if (d.diagramKind == "kanban") {
            return (this.loadMermaidKanban(text styleName want))
        }
        if (d.diagramKind == "quadrant") {
            return (this.loadMermaidQuadrant(text styleName want))
        }
        if (d.diagramKind == "pie") {
            return (this.loadMermaidPie(text styleName want))
        }
        if (d.diagramKind == "xychart") {
            return (this.loadMermaidXy(text styleName want))
        }
        if (d.diagramKind == "sankey") {
            return (this.loadMermaidSankey(text styleName want))
        }
        if (d.diagramKind == "block") {
            return (this.loadMermaidBlock(text styleName want))
        }
        if (d.diagramKind == "architecture") {
            return (this.loadMermaidArch(text styleName want))
        }
        if (d.diagramKind == "swimlane") {
            return (this.loadMermaidSwimlane(text styleName want))
        }
        if ((d.nodeCount()) == 0) {
            status = "no nodes in that Mermaid source"
            if ((strlen d.diagramKind) > 0) {
                status = ("a " + d.diagramKind + " diagram — this reads flowcharts and class diagrams")
            }
            return false
        }
        mermaidText = text
        mermaidStyle = styleName
        def style:FlowStyle (FlowStyle.named(want))
        def g:FlowGraph (MermaidFlow.styled(d style))
        this.adopt(g)
        editor.view.notation = "plain"
        layoutName = "layered"
        simRunning = false
        editor.pinWhileDragging = false
        ; The paper as well as the boxes: a dark look on white paper is two
        ; looks at once.
        style.applyToTheme(editor.view.theme)
        if (want == "dark") {
            editor.view.theme.name = "dark"
        } {
            editor.view.theme.name = "light"
        }
        def what:string d.title
        if ((strlen what) == 0) {
            what = ("Mermaid " + d.direction)
        }
        status = ((to_string (d.nodeCount())) + " nodes, " + (to_string (d.linkCount())) + " links — " + what + ", " + want)
        return true
    }

    ; `classDiagram`, drawn with the compartment node the schema editor uses:
    ; the same boxes, the same rows, the hollow triangle at the supertype and
    ; the filled diamond at the whole.
    fn loadMermaidClass:boolean (text:string styleName:string want:string) {
        def cd:MermaidClassDiagram (MermaidClassReader.parse(text))
        if ((cd.classCount()) == 0) {
            status = "no classes in that class diagram"
            return false
        }
        mermaidText = text
        mermaidStyle = styleName
        def style:FlowStyle (FlowStyle.named(want))
        def g:FlowGraph (MermaidClassFlow.build(cd style))
        this.adopt(g)
        ; UML notation, because that is what it is.
        editor.view.notation = "uml"
        layoutName = "layered"
        simRunning = false
        editor.pinWhileDragging = false
        style.applyToTheme(editor.view.theme)
        if (want == "dark") {
            editor.view.theme.name = "dark"
        } {
            editor.view.theme.name = "light"
        }
        def what:string cd.title
        if ((strlen what) == 0) {
            what = "Mermaid class diagram"
        }
        status = ((to_string (cd.classCount())) + " classes, " + (to_string (cd.relationCount())) + " relations — " + what + ", " + want)
        return true
    }


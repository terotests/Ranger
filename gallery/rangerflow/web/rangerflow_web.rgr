        layoutName = "none"
        simRunning = false
        editor.pinWhileDragging = false
        style.applyToTheme(editor.view.theme)
        if (want == "dark") {
            editor.view.theme.name = "dark"
        } {
            editor.view.theme.name = "light"
        }
        def what:string md.title
        if ((strlen what) == 0) {
            what = "Mermaid mind map"
        }
        status = ((to_string (md.nodeCount())) + " nodes — " + what + ", " + want)
        return true

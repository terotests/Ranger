        def what:string ed.title
        if ((strlen what) == 0) {
            what = "Mermaid ER diagram"
        }
        status = ((to_string (ed.entityCount())) + " entities, " + (to_string (ed.relationCount())) + " relationships — " + what + ", " + want)
        return true

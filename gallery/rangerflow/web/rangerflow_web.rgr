    ; A swimlane diagram: the flowchart reader, and then every step put in
    ; the lane that owns it.
    fn loadMermaidSwimlane:boolean (text:string styleName:string want:string) {
        def sd:MermaidDiagram (MermaidReader.parse(text))
        if ((sd.nodeCount()) == 0) {
            status = "no steps in that swimlane diagram"

    ; `info` asks what drew it, and gets an answer about this rather than a
    ; version number invented on the spot.
    fn loadMermaidInfo:boolean (text:string styleName:string want:string) {
        def id:MermaidInfo (MermaidInfoReader.parse(text))
        def style:FlowStyle (FlowStyle.named(want))
        def g:FlowGraph (MermaidInfoFlow.build(id style))
        if ((g.nodeCount()) == 0) {
            status = "that is not an info diagram"
            return false
        }
        sourceText = text
        sourceStyle = styleName
        this.adoptPlaced(g style want)
        status = (id.text + ", " + want)
        return true
    }

    ; What the placed diagrams share: the graph as it was built, with no
    ; layout over the top of it.
    fn adoptPlaced:void (g:FlowGraph style:FlowStyle want:string) {
        this.adopt(g)
        editor.view.notation = "plain"
        layoutName = "none"
        simRunning = false
        editor.pinWhileDragging = false
        style.applyToTheme(editor.view.theme)
        if (want == "dark") {
            editor.view.theme.name = "dark"
        } {
            editor.view.theme.name = "light"
        }
    }

    ; ------------------------------------------------------------ examples --
    ; The example dropdown, for whichever format the scenario chose.
    ;
    ; One string rather than a list, because this is read across the JS bridge
    ; and a string survives it without a wrapper on either side: entries are
    ; separated by `|`, and an entry's id from its label by a tab.
    sfn sampleList:string (format:string) {
        if (format == "plantuml") {
            ; The class diagram opens the panel rather than the sequence one:
            ; a sequence diagram is PLACED — who across, when down — so its
            ; parts are not draggable, and a demo whose first move is to drag
            ; something should open on something that moves.
            def p:string "class\tclass diagram"
            p = (p + "|sequence\tsequence diagram")
            p = (p + "|activity\tactivity diagram")
            p = (p + "|component\tcomponent diagram")
            p = (p + "|usecase\tuse case diagram")
            p = (p + "|deployment\tdeployment diagram")
            p = (p + "|object\tobject diagram")
            return p
        }
        if (format == "graphviz") {
            def d:string "pipeline\tpipeline with clusters"
            d = (d + "|shapes\tthe shape gallery")
            d = (d + "|undirected\tan undirected graph")
            d = (d + "|defaults\tscoped attribute defaults")
            return d
        }
        def m:string "flowchart\tflowchart"
        m = (m + "|sequence\tsequence diagram")
        m = (m + "|class\tclass diagram")
        m = (m + "|state\tstate diagram")
        m = (m + "|er\tER diagram")
        m = (m + "|mindmap\tmind map")
        m = (m + "|gantt\tGantt chart")
        m = (m + "|pie\tpie chart")
        return m
    }

    sfn sampleText:string (format:string name:string) {
        if (format == "plantuml") {
            return (RangerFlowWeb.plantUmlSample(name))
        }
        if (format == "graphviz") {
            return (RangerFlowWeb.dotSample(name))
        }
        return (RangerFlowWeb.mermaidSample(name))
    }

    ; ---------------------------------------------------------- DOT samples --
    ; Four files, each one a thing a DOT reader can be wrong about: clusters
    ; and the band they are drawn as, the shape vocabulary, the undirected
    ; grammar with its own edge operator, and the scoped defaults that are the
    ; subtlest part of the language.
    sfn dotSample:string (name:string) {
        if (name == "shapes") {
            def a:string "digraph shapes {\n"
            a = (a + "  rankdir = LR;\n")
            a = (a + "  node [style=filled, fillcolor=white, color=steelblue];\n")
            a = (a + "  alku   [shape=circle,        label=\"alku\"];\n")
            a = (a + "  syote  [shape=parallelogram, label=\"syöte\"];\n")
            a = (a + "  tyo    [shape=box,           label=\"työvaihe\"];\n")
            a = (a + "  ehto   [shape=diamond,       label=\"ehto?\"];\n")
            a = (a + "  levy   [shape=cylinder,      label=\"tietokanta\"];\n")
            a = (a + "  huom   [shape=note,          label=\"muistio\"];\n")
            a = (a + "  loppu  [shape=doublecircle,  label=\"loppu\"];\n")
            a = (a + "  alku -> syote -> tyo -> ehto;\n")
            a = (a + "  ehto -> levy [label=\"kyllä\"];\n")
            a = (a + "  ehto -> huom [label=\"ei\", style=dashed];\n")
            a = (a + "  levy -> loppu;\n")
            a = (a + "  huom -> loppu;\n")
            a = (a + "}\n")
            return a
        }
        if (name == "undirected") {
            def b:string "graph tiimi {\n"
            b = (b + "  layout = neato;\n")
            b = (b + "  node [shape=ellipse, style=filled, fillcolor=lightyellow];\n")
            b = (b + "  Aino -- Bertta;\n")
            b = (b + "  Aino -- Cecil;\n")
            b = (b + "  Bertta -- Cecil [label=\"pari\"];\n")
            b = (b + "  Cecil -- Daniel;\n")
            b = (b + "  Daniel -- Aino [style=dotted];\n")
            b = (b + "}\n")
            return b
        }
        if (name == "defaults") {
            def c:string "// `node [...]` reaches forward, not back, and not into\n"
            c = (c + "// a sibling subgraph. Graphviz resolves it exactly so, and\n")
            c = (c + "// GRAPHVIZ_PARITY.md is where the two answers are compared.\n")
            c = (c + "digraph oletukset {\n")
            c = (c + "  node [shape=box, style=filled, fillcolor=white];\n")
            c = (c + "  eka;\n")
            c = (c + "  node [shape=ellipse];\n")
            c = (c + "  toka;\n")
            c = (c + "  subgraph cluster_sisa {\n")
            c = (c + "    label = \"oma väri\";\n")
            c = (c + "    node [fillcolor=lightblue];\n")
            c = (c + "    kolmas;\n")
            c = (c + "    neljas;\n")
            c = (c + "  }\n")
            c = (c + "  viides;\n")
            c = (c + "  eka -> toka -> kolmas -> neljas -> viides;\n")
            c = (c + "}\n")
            return c
        }
        return (RangerFlowWeb.sampleDot())
    }

    ; What `?scenario=graphviz` opens with.
    sfn sampleDot:string () {
        def t:string "digraph tilaus {\n"
        t = (t + "  label = \"Tilauksen käsittely\";\n")
        t = (t + "  rankdir = TB;\n")
        t = (t + "  node [shape=box, style=filled, fillcolor=white, color=steelblue];\n")
        t = (t + "  edge [color=steelblue];\n")
        t = (t + "\n")
        t = (t + "  alku      [shape=circle, label=\"alku\"];\n")
        t = (t + "  tilaus    [shape=parallelogram, label=\"lue tilaus\"];\n")
        t = (t + "  tarkista  [label=\"tarkista\\nluottotiedot\"];\n")
        t = (t + "  rekisteri [shape=cylinder, label=\"asiakasrekisteri\", fillcolor=lightyellow];\n")
        t = (t + "  luotto    [shape=diamond, label=\"luotto\\nkunnossa?\"];\n")
        t = (t + "  hylkaa    [label=\"ilmoita hylkäys\", fillcolor=salmon, color=tomato];\n")
        t = (t + "\n")
        t = (t + "  subgraph cluster_laskutus {\n")
        t = (t + "    label = \"Laskutus\";\n")
        t = (t + "    color = seagreen;\n")
        t = (t + "    varasto [label=\"varaa tuotteet\"];\n")
        t = (t + "    saldo   [shape=diamond, label=\"riittääkö\\nsaldo?\"];\n")
        t = (t + "    jalki   [label=\"merkitse\\njälkitoimitukseen\"];\n")
        t = (t + "    laskuta [shape=note, label=\"muodosta lasku\"];\n")
        t = (t + "    varasto -> saldo;\n")
        t = (t + "    saldo -> laskuta [label=\"kyllä\"];\n")
        t = (t + "    saldo -> jalki [label=\"ei\"];\n")
        t = (t + "    jalki -> laskuta;\n")
        t = (t + "  }\n")
        t = (t + "\n")
        t = (t + "  loppu [shape=doublecircle, label=\"loppu\", fillcolor=lightblue];\n")
        t = (t + "  alku -> tilaus -> tarkista -> luotto;\n")
        t = (t + "  rekisteri -> tarkista [style=dashed, dir=none];\n")
        t = (t + "  luotto -> varasto [label=\"kyllä\"];\n")
        t = (t + "  luotto -> hylkaa [label=\"ei\"];\n")
        t = (t + "  laskuta -> loppu;\n")
        t = (t + "  hylkaa -> loppu;\n")
        t = (t + "}\n")
        return t
    }

    sfn mermaidSample:string (name:string) {
        if (name == "sequence") {
            def t:string "sequenceDiagram\n"
            t = (t + "    autonumber\n")
            t = (t + "    actor Asiakas\n")
            t = (t + "    participant Kauppa\n")
            t = (t + "    participant Pankki\n")
            t = (t + "    Asiakas->>Kauppa: tee tilaus\n")
            t = (t + "    Kauppa->>+Pankki: varmenna maksu\n")
            t = (t + "    Pankki-->>-Kauppa: hyväksytty\n")
            t = (t + "    Note over Kauppa,Pankki: mitään ei ole vielä veloitettu\n")
            t = (t + "    Kauppa->>Asiakas: vahvistus\n")
            return t
        }
        if (name == "class") {
            def t2:string "classDiagram\n"
            t2 = (t2 + "    class Tilaus {\n")
            t2 = (t2 + "        +int id\n")
            t2 = (t2 + "        +Date luotu\n")
            t2 = (t2 + "        +summa() float\n")
            t2 = (t2 + "    }\n")
            t2 = (t2 + "    class Rivi {\n")
            t2 = (t2 + "        +string tuote\n")
            t2 = (t2 + "        +int kpl\n")
            t2 = (t2 + "    }\n")
            t2 = (t2 + "    class Asiakas\n")
            t2 = (t2 + "    Asiakas \"1\" --> \"*\" Tilaus : tekee\n")
            t2 = (t2 + "    Tilaus *-- Rivi\n")
            return t2
        }
        if (name == "state") {
            def t3:string "stateDiagram-v2\n"
            t3 = (t3 + "    [*] --> Vapaa\n")
            t3 = (t3 + "    Vapaa --> Varattu : varaa\n")
            t3 = (t3 + "    Varattu --> Maksettu : maksa\n")
            t3 = (t3 + "    Varattu --> Vapaa : peruuta\n")
            t3 = (t3 + "    Maksettu --> [*]\n")
            return t3
        }
        if (name == "er") {
            def t4:string "erDiagram\n"
            t4 = (t4 + "    ASIAKAS ||--o{ TILAUS : tekee\n")
            t4 = (t4 + "    TILAUS ||--|{ RIVI : sisaltaa\n")
            t4 = (t4 + "    TUOTE ||--o{ RIVI : esiintyy\n")
            t4 = (t4 + "    ASIAKAS {\n")
            t4 = (t4 + "        int id\n")
            t4 = (t4 + "        string nimi\n")
            t4 = (t4 + "    }\n")
            return t4
        }
        if (name == "mindmap") {
            def t5:string "mindmap\n"
            t5 = (t5 + "  root((RangerFlow))\n")
            t5 = (t5 + "    lukijat\n")
            t5 = (t5 + "      Mermaid\n")
            t5 = (t5 + "      PlantUML\n")
            t5 = (t5 + "    piirto\n")
            t5 = (t5 + "      WebGL\n")
            t5 = (t5 + "      SVG\n")
            t5 = (t5 + "      PDF\n")
            return t5
        }
        if (name == "gantt") {
            def t6:string "gantt\n"
            t6 = (t6 + "    title Julkaisu\n")
            t6 = (t6 + "    dateFormat YYYY-MM-DD\n")
            t6 = (t6 + "    section Suunnittelu\n")
            t6 = (t6 + "    Luonnos      :a1, 2026-01-05, 5d\n")
            t6 = (t6 + "    Katselmointi :a2, after a1, 3d\n")
            t6 = (t6 + "    section Toteutus\n")
            t6 = (t6 + "    Lukija       :b1, after a2, 10d\n")
            t6 = (t6 + "    Testit       :b2, after b1, 4d\n")
            return t6
        }
        if (name == "pie") {
            def t7:string "pie showData\n"
            t7 = (t7 + "    title Mihin aika menee\n")
            t7 = (t7 + "    \"Lukija\" : 45\n")
            t7 = (t7 + "    \"Asettelu\" : 30\n")
            t7 = (t7 + "    \"Piirto\" : 15\n")
            t7 = (t7 + "    \"Muu\" : 10\n")
            return t7
        }
        return (RangerFlowWeb.sampleMermaid())
    }

    sfn plantUmlSample:string (name:string) {
        if (name == "class") {
            def t:string "@startuml\n"
            t = (t + "package \"tilaukset\" {\n")
            t = (t + "  abstract class Tilaus {\n")
            t = (t + "    +id: int\n")
            t = (t + "    #luotu: Date\n")
            t = (t + "    {abstract} +summa(): Raha\n")
            t = (t + "  }\n")
            t = (t + "  class Verkkotilaus\n")
            t = (t + "  class Rivi {\n")
            t = (t + "    +tuote: string\n")
            t = (t + "    +kpl: int\n")
            t = (t + "  }\n")
            t = (t + "}\n")
            t = (t + "package \"laskutus\" {\n")
            t = (t + "  interface Maksettava {\n")
            t = (t + "    +veloita(summa: Raha): Kuitti\n")
            t = (t + "  }\n")
            t = (t + "}\n")
            t = (t + "class Asiakas\n")
            t = (t + "Tilaus <|-- Verkkotilaus\n")
            t = (t + "Tilaus *-- \"1..*\" Rivi : sisältää\n")
            t = (t + "Asiakas \"1\" o-- \"monta\" Tilaus : tekee\n")
            t = (t + "Tilaus ..|> Maksettava\n")
            return t
        }
        if (name == "component") {
            def t2:string "@startuml\n"
            t2 = (t2 + "actor Asiakas\n")
            t2 = (t2 + "package \"reuna\" {\n")
            t2 = (t2 + "  [Verkkokauppa] as SF\n")
            t2 = (t2 + "  [Ylläpito] as AC\n")
            t2 = (t2 + "}\n")
            t2 = (t2 + "node \"klusteri\" {\n")
            t2 = (t2 + "  [Tilaus-API] as API\n")
            t2 = (t2 + "  [Toimitus] as FUL\n")
            t2 = (t2 + "  queue \"tapahtumat\" as Q\n")
            t2 = (t2 + "}\n")
            t2 = (t2 + "database \"Postgres\" as DB\n")
            t2 = (t2 + "cloud \"Maksunvälittäjä\" as PG\n")
            t2 = (t2 + "Asiakas --> SF\n")
            t2 = (t2 + "SF --> API\n")
            t2 = (t2 + "AC --> API\n")
            t2 = (t2 + "API --> DB\n")
            t2 = (t2 + "API --> Q\n")
            t2 = (t2 + "Q --> FUL\n")
            t2 = (t2 + "API --> PG : varmenna\n")
            return t2
        }
        if (name == "usecase") {
            def t3:string "@startuml\n"
            t3 = (t3 + "left to right direction\n")
            t3 = (t3 + "actor Ostaja\n")
            t3 = (t3 + "actor \"Varasto\" as WH\n")
            t3 = (t3 + "rectangle \"Verkkokauppa\" {\n")
            t3 = (t3 + "  (Selaa tuotteita) as UC1\n")
            t3 = (t3 + "  (Tee tilaus) as UC2\n")
            t3 = (t3 + "  (Seuraa toimitusta) as UC3\n")
            t3 = (t3 + "  (Kerää ja pakkaa) as UC4\n")
            t3 = (t3 + "}\n")
            t3 = (t3 + "Ostaja --> UC1\n")
            t3 = (t3 + "Ostaja --> UC2\n")
            t3 = (t3 + "Ostaja --> UC3\n")
            t3 = (t3 + "WH --> UC4\n")
            t3 = (t3 + "UC2 ..> UC1 : laajentaa\n")
            return t3
        }
        if (name == "deployment") {
            def t4:string "@startuml\n"
            t4 = (t4 + "node \"sovelluspalvelin\" {\n")
            t4 = (t4 + "  artifact \"kauppa.war\" as WAR\n")
            t4 = (t4 + "  component [Ajoympäristö] as RT\n")
            t4 = (t4 + "}\n")
            t4 = (t4 + "node \"tietokantapalvelin\" {\n")
            t4 = (t4 + "  database \"tilaukset\" as ODB\n")
            t4 = (t4 + "}\n")
            t4 = (t4 + "folder \"varmuuskopiot\" {\n")
            t4 = (t4 + "  file \"yo.dump\" as DUMP\n")
            t4 = (t4 + "}\n")
            t4 = (t4 + "WAR --> RT\n")
            t4 = (t4 + "RT --> ODB\n")
            t4 = (t4 + "ODB ..> DUMP : vedostetaan\n")
            return t4
        }
        if (name == "sequence") {
            return (RangerFlowWeb.plantUmlSequenceSample())
        }
        if (name == "activity") {
            return (RangerFlowWeb.plantUmlActivitySample())
        }
        if (name == "object") {
            def t5:string "@startuml\n"
            t5 = (t5 + "object tilaus1 {\n")
            t5 = (t5 + "  id = 4711\n")
            t5 = (t5 + "  summa = 89.90\n")
            t5 = (t5 + "}\n")
            t5 = (t5 + "object asiakas1 {\n")
            t5 = (t5 + "  nimi = \"Aino\"\n")
            t5 = (t5 + "}\n")
            t5 = (t5 + "object rivi1\n")
            t5 = (t5 + "asiakas1 --> tilaus1 : teki\n")
            t5 = (t5 + "tilaus1 *-- rivi1\n")
            return t5
        }
        return (RangerFlowWeb.samplePlantUml())
    }

    ; What `?scenario=plantuml` opens with — the first entry of the gallery, so
    ; the textarea and the drawing agree before anybody touches anything.
    sfn samplePlantUml:string () {
        return (RangerFlowWeb.plantUmlSample("class"))
    }

    ; An activity diagram with everything nested in it: a partition, a
    ; condition with a label on each way out, and actions that run over two
    ; lines because somebody wrote them that way.
    sfn plantUmlActivitySample:string () {
        def t:string "@startuml\n"
        t = (t + "start\n")
        t = (t + ":Vastaanota tilaus;\n")
        t = (t + ":Lue tilausrivit\n")
        t = (t + "ja tarkista saldot;\n")
        t = (t + "partition varaus {\n")
        t = (t + ":Varaa tuotteet;\n")
        t = (t + ":Päivitä saldot;\n")
        t = (t + "}\n")
        t = (t + "if (luotto kunnossa?) then\n")
        t = (t + "-> kyllä;\n")
        t = (t + ":Veloita maksu;\n")
        t = (t + ":Muodosta lasku;\n")
        t = (t + "else\n")
        t = (t + "-> ei;\n")
        t = (t + ":Ilmoita hylkäys;\n")
        t = (t + "endif\n")
        t = (t + "while (rivejä jäljellä?) is (kyllä)\n")
        t = (t + ":Kerää rivi;\n")
        t = (t + "endwhile (ei)\n")
        t = (t + "fork\n")
        t = (t + ":Lähetä vahvistus;\n")
        t = (t + "fork again\n")
        t = (t + ":Kirjaa tapahtuma;\n")
        t = (t + "end fork\n")
        t = (t + ":Toimita tilaus;\n")
        t = (t + "stop\n")
        t = (t + "@enduml\n")
        return t
    }

    ; The diagram the request that started this work was written in.
    sfn plantUmlSequenceSample:string () {
        def t:string "@startuml\n"
        t = (t + "title Tilauksen kulku\n")
        t = (t + "autonumber\n")
        t = (t + "actor \"Asiakas\" as C\n")
        t = (t + "participant \"Verkkokauppa\" as SF\n")
        t = (t + "participant \"Tilaus-API\" as API\n")
        t = (t + "database \"Postgres\" as DB\n")
        t = (t + "participant \"Maksunvälittäjä\" as PG\n")
        t = (t + "C -> SF: tee tilaus\n")
        t = (t + "activate SF\n")
        t = (t + "SF -> API: POST /orders\n")
        t = (t + "activate API\n")
        t = (t + "API -> DB: INSERT tilaus\n")
        t = (t + "DB --> API: tilauksen id\n")
        t = (t + "alt luotto kunnossa\n")
        t = (t + "    API -> PG: varmenna\n")
        t = (t + "    PG --> API: hyväksytty\n")
        t = (t + "    API -> DB: UPDATE tila = maksettu\n")
        t = (t + "else hylätty\n")
        t = (t + "    API -> PG: varmenna\n")
        t = (t + "    PG --> API: hylätty\n")
        t = (t + "    note right of API\n")
        t = (t + "        Tilaus jää,\n")
        t = (t + "        varaus ei.\n")
        t = (t + "    end note\n")
        t = (t + "end\n")
        t = (t + "API --> SF: 201 Created\n")
        t = (t + "deactivate API\n")
        t = (t + "SF --> C: vahvistus\n")
        t = (t + "deactivate SF\n")
        t = (t + "@enduml\n")
        return t
    }

    ; The sample the dropdown shows, and the text the editing panel opens with.
    sfn sampleMermaid:string () {
        def t:string "flowchart TD\n"
        t = (t + "    start([Uusi tilaus]) --> lue[/Lue rivit/]\n")
        t = (t + "    lue --> tarkista{Luotto kunnossa?}\n")
        t = (t + "    tarkista -->|kyllä| varaa[Varaa tuotteet]\n")
        t = (t + "    tarkista -->|ei| hylkaa[\\Ilmoita hylkäys\\]\n")
        t = (t + "    subgraph laskutus [Laskutus]\n")
        t = (t + "        varaa --> lasku[[Muodosta lasku]]\n")
        t = (t + "        lasku --> posti[/Lasku asiakkaalle/]\n")
        t = (t + "    end\n")
        t = (t + "    rekisteri[(Asiakasrekisteri)] -.-> tarkista\n")
        t = (t + "    posti --> loppu(((Valmis)))\n")
        t = (t + "    hylkaa --> loppu\n")
        t = (t + "    classDef stop fill:#fee,stroke:#c66\n")
        t = (t + "    class hylkaa stop\n")
        return t
    }

    ; A UML activity diagram: the other UML, the one that is a flowchart. Its
    ; whole point here is the vocabulary — an action is a rounded box, a fork
    ; is a bar, a signal sent is a box with a point on it and a signal
    ; received is one with a bite out of it — so the demo uses every shape it
    ; has rather than a tidy subset.
    fn loadActivity:boolean () {
        def a (new ActivityDiagram)
        a.node("alku" "" (ActivityKind.initial()))
        a.action("vastaanota" "Vastaanota tilaus")
        a.node("haara" "" (ActivityKind.fork()))
        a.action("luotto" "Tarkista luottotiedot")
        a.action("varasto" "Varaa tuotteet")
        a.node("yhdista" "" (ActivityKind.joining()))
        a.node("kelpaa" "Kelpaako?" (ActivityKind.decision()))
        a.node("lasku" "Lähetä lasku" (ActivityKind.send()))
        a.node("odota" "Odota maksua" (ActivityKind.waiting()))
        a.node("kuittaus" "Maksukuittaus" (ActivityKind.receive()))
        a.action("toimita" "Toimita tilaus")
        a.node("loppu" "" (ActivityKind.final()))
        a.flow("alku" "vastaanota")
        a.flow("vastaanota" "haara")
        a.flow("haara" "luotto")
        a.flow("haara" "varasto")
        a.flow("luotto" "yhdista")
        a.flow("varasto" "yhdista")
        a.flow("yhdista" "kelpaa")
        a.guarded("kelpaa" "lasku" "kyllä")
        a.guarded("kelpaa" "loppu" "ei")
        a.flow("lasku" "odota")
        a.flow("odota" "kuittaus")
        a.flow("kuittaus" "toimita")
        a.flow("toimita" "loppu")
        def g:FlowGraph (a.build())
        this.adopt(g)
        editor.view.notation = "plain"
        layoutName = "layered"
        def lay:LayeredLayout (LayeredLayout.of(graph))
        lay.direction = "TB"
        lay.layerGap = 66.0
        lay.nodeGap = 40.0
        lay.run()
        ActivityDiagram.faceEdges(graph)
        EdgeLanes.assign(graph)
        lay.routeLongEdges()
        EdgeLanes.assign(graph)
        OrthoRouter.repairAll(graph)
        simRunning = false
        editor.pinWhileDragging = false
        status = ((to_string (g.nodeCount())) + " solmua — UML-aktiviteettikaavio: haarautuminen, signaalit ja ajastin")
        return true
    }

    fn loadOrgChart:boolean () {
        def o (new OrgChart)
        o.unitColor("Johto" "#eef2ff")
        o.unitColor("Tuotanto" "#eefaf1")
        o.unitColor("Myynti" "#fff5e9")
        o.unitColor("Talous" "#f7effb")
        o.person("tj" "Aino Virtanen" "toimitusjohtaja" "Johto" "")
        o.person("cto" "Markus Laine" "teknologiajohtaja" "Johto" "tj")
        o.person("cfo" "Riikka Salo" "talousjohtaja" "Talous" "tj")
        o.person("myynti" "Pekka Nieminen" "myyntijohtaja" "Myynti" "tj")
        o.person("kehitys" "Sanna Koskinen" "kehityspäällikkö" "Tuotanto" "cto")
        o.person("yllapito" "Otto Mäkelä" "ylläpitopäällikkö" "Tuotanto" "cto")
        o.person("kirjanpito" "Liisa Aho" "kirjanpitäjä" "Talous" "cfo")
        o.person("avain" "Tuomas Heikkinen" "avainasiakaspäällikkö" "Myynti" "myynti")
        def matrix:OrgPerson (o.person("analyytikko" "Elina Rantala" "data-analyytikko" "Talous" "kehitys"))
        matrix.dotted = true
        def g:FlowGraph (o.build())
        this.adopt(g)
        editor.view.notation = "plain"
        layoutName = "layered"
        def lay:LayeredLayout (LayeredLayout.of(graph))
        lay.direction = "TB"
        lay.layerGap = 70.0
        lay.nodeGap = 34.0
        lay.run()
        EdgeLanes.assign(graph)
        lay.routeLongEdges()
        EdgeLanes.assign(graph)
        OrthoRouter.repairAll(graph)
        simRunning = false
        editor.pinWhileDragging = false
        status = ((to_string (g.nodeCount())) + " henkilöä — katkoviiva on matriisiraportointi")
        return true
    }

    ; The lanes are placed by the domain rather than by a layout, because who
    ; does the work is not something an algorithm may decide. Dragging a lane
    ; takes its steps with it — that is what `parentId` buys.
    fn loadProcess:boolean () {
        def p (new SwimlaneProcess)
        p.lane("asiakas" "Asiakas")
        p.lane("myynti" "Myynti")
        p.lane("varasto" "Varasto")
        p.lane("talous" "Talous")
        p.step("tilaa" "Tekee tilauksen" "asiakas" (FlowShape.stadium()))
        p.step("vastaanota" "Vastaanota tilaus" "myynti" (FlowShape.rect()))
        p.step("luotto" "Luotto ok?" "myynti" (FlowShape.diamond()))
        p.step("kerays" "Kerää tuotteet" "varasto" (FlowShape.rect()))
        p.step("toimitus" "Lähetä toimitus" "varasto" (FlowShape.rect()))
        p.step("laskuta" "Laskuta" "talous" (FlowShape.rect()))
        p.step("suoritus" "Kirjaa suoritus" "talous" (FlowShape.rect()))
        p.step("saapuu" "Vastaanottaa tavaran" "asiakas" (FlowShape.stadium()))
        p.link("tilaa" "vastaanota")
        p.link("vastaanota" "luotto")
        p.branch("luotto" "kerays" "kyllä")
        p.link("kerays" "toimitus")
        p.link("toimitus" "laskuta")
        p.link("laskuta" "suoritus")
        p.link("toimitus" "saapuu")
        def g:FlowGraph (p.build())
        this.adopt(g)
        editor.view.notation = "plain"
        layoutName = "none"
        EdgeLanes.assign(graph)
        OrthoRouter.repairAll(graph)
        simRunning = false
        editor.pinWhileDragging = false
        status = ((to_string (array_length p.laneIds)) + " uimarataa — raahaa rataa, niin sen vaiheet tulevat mukana")
        return true
    }

    ; ------------------------------------------------------- text editing ---
    ; The page owns a real, invisible <input> and mirrors it here on every
    ; keystroke: that is the only way a dead key, an ä, or a phone's keyboard
    ; produces the right characters on a canvas. The editor still owns the
    ; model, so the desktop host and the tests type through `keyDown` instead
    ; and get the same result.
    fn beginEditAt:boolean (x:double y:double) {
        return (editor.beginEditAt(x y))
    }

    fn editing:boolean () {
        return (editor.editing())
    }

    fn editValue:string () {
        return editor.editText
    }

    fn editCaret:int () {
        return editor.editCaret
    }

    fn setEditText:void (text:string caret:int) {
        editor.setEditText(text caret)
    }

    fn commitEdit:boolean () {
        def ok:boolean (editor.commitEdit())
        if ok {
            this.reroute()
        }
        return ok
    }

    fn cancelEdit:void () {
        editor.cancelEdit()
    }

    ; ---------------------------------------------------------- authoring ---
    ; What the toolbar calls. Every one of them is one undo step, and every one
    ; re-routes afterwards, because a new box in the middle of a corridor is
    ; exactly the case the repair pass exists for.
    fn addNode:string (label:string shape:string) {
        def n:FlowNode (editor.addNodeAtCentre(label shape))
        this.reroute()
        return n.id
    }

    fn addNodeAt:string (label:string shape:string sx:double sy:double) {
        def fx:double (editor.flowX(sx))
        def fy:double (editor.flowY(sy))
        def n:FlowNode (editor.addNode(label shape fx fy))
        this.reroute()
        return n.id
    }

    fn setConnectMode:void (on:boolean) {
        editor.connectOnClick = on
        editor.clickConnectFrom = ""
        if on {
            status = "yhdistä: klikkaa lähde, sitten kohde"
        } {
            status = "valinta"
        }
    }

    fn connectMode:boolean () {
        return editor.connectOnClick
    }

    fn connect:boolean (sourceId:string targetId:string) {
        def ok:boolean (editor.connectNodes(sourceId targetId))
        if ok {
            this.reroute()
        }
        return ok
    }

    fn deleteSelection:boolean () {
        def ok:boolean (editor.deleteSelection())
        if ok {
            this.reroute()
        }
        return ok
    }

    fn undo:boolean () {
        def ok:boolean (editor.undo.undo(graph))
        if ok {
            this.reroute()
        }
        return ok
    }

    fn redo:boolean () {
        def ok:boolean (editor.undo.redo(graph))
        if ok {
            this.reroute()
        }
        return ok
    }

    fn selectedLabel:string () {
        def n:FlowNode (editor.selectedNode())
        return n.label
    }

    fn selectedId:string () {
        return (editor.selectedNodeId())
    }

    fn renameSelected:boolean (label:string) {
        return (editor.renameSelected(label))
    }

    fn setSelectedShape:boolean (shape:string) {
        def ok:boolean (editor.setSelectedShape(shape))
        if ok {
            this.reroute()
        }
        return ok
    }

    ; The same two passes pointer-up runs, so an edited diagram is routed the
    ; way a dragged one is and there is only one answer to "why is that line
    ; there".
    fn reroute:void () {
        if simRunning {
            return
        }
        EdgeLanes.reset(graph)
        EdgeLanes.assign(graph)
        OrthoRouter.repairAll(graph)
    }

    ; ------------------------------------------------------------- content --
    ; The page fetches the .sql and hands over the text; nothing here opens a
    ; file, which is what makes the bundle loadable in a browser at all.
    fn loadSql:boolean (sql:string) {
        def schema:DatabaseSchema (SqlSchemaReader.parse(sql))
        if ((schema.tableCount()) == 0) {
            status = "no CREATE TABLE statements found"
            return false
        }
        def s2g (new SchemaToGraph)
        userMoved = false
        graph = (s2g.build(schema))
        editor = (FlowEditor.of(graph))
        editor.setSize(viewW viewH)
        this.applyLayout()
        status = ((to_string (schema.tableCount())) + " tables, " + (to_string (array_length schema.foreignKeys)) + " relationships — drag a line from the middle to route it by hand")
        return true
    }

    fn applyLayout:void () {
        if (layoutName == "force") {
            sim = (FlowSimulation.of(graph))
            sim.chargeStrength = -1400.0
            sim.linkDistance = 220.0
            sim.linkStrengthFixed = 0.06
            sim.xEnabled = true
            sim.yEnabled = true
            sim.collideEnabled = true
            sim.pullPositions()
            simRunning = true
            editor.pinWhileDragging = true
            return
        }
        simRunning = false
        editor.pinWhileDragging = false
        ; "none" means the positions came from the domain and are part of what
        ; the diagram says — a swimlane's rows are who does the work, and a
        ; layout free to move a box between them is free to reassign it.
        if (layoutName == "none") {
            this.reroute()
            return
        }
        def lay:LayeredLayout (LayeredLayout.of(graph))
        lay.direction = "LR"
        lay.layerGap = 160.0
        lay.nodeGap = 40.0
        lay.run()
        SchemaToGraph.faceEdges(graph)
        EdgeLanes.assign(graph)
        lay.routeLongEdges()
        ; A second lane pass, now that the chained routes exist: the first one
        ; could not see them, so a track and a chain could end up drawn four
        ; pixels apart. This one treats the chains as lines to keep clear of.
        EdgeLanes.assign(graph)
        OrthoRouter.repairAll(graph)
    }

    fn setLayout:void (name:string) {
        layoutName = name
        this.applyLayout()
    }

    fn setNotation:void (name:string) {
        editor.view.notation = name
    }

    fn setTheme:void (name:string) {
        if (name == "dark") {
            editor.view.theme = (FlowTheme.dark())
        } {
            editor.view.theme = (FlowTheme.light())
        }
    }

    fn setBackgroundVariant:void (v:int) {
        editor.view.theme.backgroundVariant = v
    }

    fn setSnap:void (on:boolean) {
        editor.snapToGrid = on
    }

    fn setEdgeType:void (kind:string) {
        def k:int 0
        while (k < (graph.edgeCount())) {
            def e:FlowEdge (graph.edgeAt(k))
            e.edgeType = kind
            k = (k + 1)
        }
    }

    ; ---------------------------------------------------------------- frame --
    ; One tick of the simulation per frame when it is running, then the scene.
    fn frame:string () {
        if simRunning {
            if ((sim.isSettled()) == false) {
                sim.tick()
                SchemaToGraph.faceEdges(graph)
                ; A force layout starts as a dot at the origin and grows to
                ; several thousand units across. Fitting once at load and never
                ; again left the demo at 4x zoom looking at the inside of one
                ; node, so it follows the graph while it settles — and stops
                ; the moment the viewer touches anything, because a viewport
                ; that moves under your hand is worse than a bad first frame.
                if (userMoved == false) {
                    editor.fitView()
                }
            }
        }
        return (editor.sceneJson())
    }

    fn sceneJson:string () {
        return (editor.sceneJson())
    }

    fn svg:string () {
        def sc:FlowScene (editor.view.buildForExport(24.0))
        return (sc.toSvg())
    }

    ; What the page prints in its status bar, and what the smoke test reads
    ; back out of the DOM to prove the editor actually did something.
    fn stats:string () {
        def v:FlowView editor.view
        def out:string ("nodes=" + (to_string (graph.nodeCount())))
        out = (out + " edges=" + (to_string (graph.edgeCount())))
        out = (out + " drawn=" + (to_string v.drawnNodes))
        out = (out + " culled=" + (to_string v.culledNodes))
        out = (out + " selected=" + (to_string (graph.selectedNodeCount())))
        out = (out + " zoom=" + (EVGDisplayList.num(v.viewport.zoom)))
        out = (out + " sim=" + (to_string simRunning))
        if simRunning {
            out = (out + " alpha=" + (EVGDisplayList.num(sim.alpha)))
        }
        return out
    }

    fn statusText:string () {
        return status
    }

    ; A scripted session the page can run with `?selftest=1`: select a table,
    ; drag it, box-select everything, undo. There is no browser-driver library
    ; here, so the page tests itself and writes the result where headless
    ; Chrome's --dump-dom can be read back.
    fn selfTest:string () {
        if ((graph.nodeCount()) == 0) {
            return "FAIL no nodes"
        }
        def report:string ""
        ; A running simulation moves the graph between the steps, so the test
        ; would be measuring the layout rather than the editor. Paused for the
        ; duration and put back afterwards.
        def wasRunning:boolean simRunning
        simRunning = false
        editor.fitView()
        def first:FlowNode (graph.nodeAt(0))
        def sx:double (editor.view.viewport.toScreenX((first.centerX())))
        def sy:double (editor.view.viewport.toScreenY((first.centerY())))
        ; Which node is actually under that point — with overlapping nodes the
        ; topmost one wins, and asserting on node 0 would be asserting on the
        ; paint order rather than on the click.
        def fx:double (editor.view.viewport.toFlowX(sx))
        def fy:double (editor.view.viewport.toFlowY(sy))
        def hit:int (graph.nodeAtPoint(fx fy))
        if (hit < 0) {
            simRunning = wasRunning
            return "FAIL nothing under the pointer after fitView"
        }
        def n:FlowNode (graph.nodeAt(hit))
        this.pointerDown(sx sy false false)
        this.pointerUp(sx sy false false)
        if (n.selected == false) {
            simRunning = wasRunning
            return "FAIL click did not select"
        }
        report = (report + "select ok; ")
        def beforeX:double n.x
        this.pointerDown(sx sy false false)
        this.pointerMove((sx + 40.0) (sy + 25.0) false false)
        this.pointerUp((sx + 40.0) (sy + 25.0) false false)
        if (n.x <= beforeX) {
            simRunning = wasRunning
            return "FAIL drag did not move the node"
        }
        report = (report + "drag ok; ")
        this.keyDown("z" false true)
        def back:double (fabs (n.x - beforeX))
        if (back > 0.001) {
            simRunning = wasRunning
            return "FAIL undo did not restore"
        }
        report = (report + "undo ok; ")
        this.keyDown("a" false true)
        if ((graph.selectedNodeCount()) != (graph.nodeCount())) {
            simRunning = wasRunning
            return "FAIL select all"
        }
        report = (report + "select-all ok; ")
        graph.clearSelection()

        ; Live rendering, on the two scenarios that have a source to type in.
        ; `sourceText` is empty for every other one, which is what decides it —
        ; the test does not need to be told which scenario it is running in.
        if ((strlen sourceText) > 0) {
            def keepSrc:string sourceText
            def keepLook:string sourceStyle
            def before:int (graph.nodeCount())
            def zoomWas:double editor.view.viewport.zoom
            def panWas:double editor.view.viewport.x
            ; Half-typed is not a diagram. Every reader refuses an empty one
            ; rather than adopting it, so the drawing on screen has to survive.
            def blanked:boolean (this.liveRender("" keepLook))
            if blanked {
                simRunning = wasRunning
                return "FAIL an empty source rendered as a diagram"
            }
            if ((graph.nodeCount()) != before) {
                simRunning = wasRunning
                return "FAIL an unreadable source threw the drawing away"
            }
            ; And a good one redraws without moving the camera.
            def again:boolean (this.liveRender(keepSrc keepLook))
            if (again == false) {
                simRunning = wasRunning
                return "FAIL the source that just drew would not draw again"
            }
            def zoomDrift:double (fabs (editor.view.viewport.zoom - zoomWas))
            def panDrift:double (fabs (editor.view.viewport.x - panWas))
            if (zoomDrift > 0.0001) {
                simRunning = wasRunning
                return "FAIL a live render moved the zoom"
            }
            if (panDrift > 0.0001) {
                simRunning = wasRunning
                return "FAIL a live render moved the view"
            }
            report = (report + "live ok; ")
            graph.clearSelection()
        }

        ; The toolbar, driven the way the buttons drive it. A palette that
        ; adds a node nobody can find, or a connect mode that makes no edge, is
        ; a toolbar that looks like it works — so the test adds two boxes, joins
        ; them, renames one, and takes it all back again.
        def nodes0:int (graph.nodeCount())
        def edges0:int (graph.edgeCount())
        def idA:string (this.addNode("Testi A" (FlowShape.diamond())))
        def idB:string (this.addNode("Testi B" (FlowShape.cylinder())))
        if ((graph.nodeCount()) != (nodes0 + 2)) {
            simRunning = wasRunning
            return "FAIL the palette did not add two nodes"
        }
        if ((this.connect(idA idB)) == false) {
            simRunning = wasRunning
            return "FAIL connect made no edge"
        }
        if ((graph.edgeCount()) != (edges0 + 1)) {
            simRunning = wasRunning
            return "FAIL the new edge is not in the graph"
        }
        def added:FlowNode (graph.nodeById(idB))
        ; The palette selects what it just added, which is what makes the name
        ; field work without a second click.
        if ((this.selectedId()) != idB) {
            simRunning = wasRunning
            return "FAIL the new node is not selected"
        }
        this.renameSelected("Nimetty")
        if (added.label != "Nimetty") {
            simRunning = wasRunning
            return "FAIL rename"
        }
        ; Three undos: the edge, then each node.
        this.undo()
        this.undo()
        this.undo()
        if ((graph.nodeCount()) != nodes0) {
            simRunning = wasRunning
            return "FAIL undo left the added nodes behind"
        }
        if ((graph.edgeCount()) != edges0) {
            simRunning = wasRunning
            return "FAIL undo left the added edge behind"
        }
        report = (report + "toolbar ok; ")
        graph.clearSelection()

        ; Columns, on whichever scenario has a table in it. A schema you can
        ; look at and not change is a picture of a schema, so the test adds a
        ; column, checks the table grew, and takes it back — and skips itself
        ; on the diagrams that have no compartments to put a column in.
        n.selected = true
        def rows0:int (this.selectedRowCount())
        if (rows0 >= 0) {
            def at:int (this.addRow())
            if (at < 0) {
                simRunning = wasRunning
                return "FAIL adding a column did nothing"
            }
            if ((this.selectedRowCount()) != (rows0 + 1)) {
                simRunning = wasRunning
                return "FAIL the table did not grow a column"
            }
            ; The caret lands in the new column's name, so the reader types
            ; over the placeholder instead of hunting for it.
            if ((this.editing()) == false) {
                simRunning = wasRunning
                return "FAIL the new column has no caret in it"
            }
            this.setEditText("asiakas_id" 10)
            this.commitEdit()
            def newTag:string ((("row:" + n.id) + ":") + (to_string at))
            if ((FlowUndo.readText(graph newTag)) != "asiakas_id") {
                simRunning = wasRunning
                return "FAIL the new column kept the placeholder name"
            }
            ; Two undos: the name, then the column itself.
            this.undo()
            this.undo()
            if ((this.selectedRowCount()) != rows0) {
                simRunning = wasRunning
                return "FAIL undo left the column behind"
            }
            report = (report + "columns ok; ")
        } {
            report = (report + "columns n/a; ")
        }
        graph.clearSelection()

        ; Connecting, both ways in, and the thing that actually went wrong:
        ; the element tool's `+` used to switch a sticky mode on and leave it
        ; on for ever, so after one use the editor could not be used for
        ; anything else. The check that matters is not "did it connect" — it
        ; is "is the editor usable afterwards".
        def cn:FlowNode (graph.nodeAt(hit))
        graph.clearSelection()
        cn.selected = true
        def edges1:int (graph.edgeCount())
        editor.armPendingFromNode(cn.id true)
        if ((editor.pending()) == false) {
            simRunning = wasRunning
            return "FAIL the + tool armed nothing"
        }
        if (editor.view.connecting == false) {
            simRunning = wasRunning
            return "FAIL an armed connection draws no line"
        }
        ; Clicking bare canvas cancels it and leaves nothing running.
        this.pointerDown(6.0 (editor.view.height - 6.0) false false)
        this.pointerUp(6.0 (editor.view.height - 6.0) false false)
        if (editor.pending()) {
            simRunning = wasRunning
            return "FAIL a click on the canvas did not cancel the connection"
        }
        if ((editor.idle()) == false) {
            simRunning = wasRunning
            return "FAIL something is still running after a cancel"
        }
        if ((graph.edgeCount()) != edges1) {
            simRunning = wasRunning
            return "FAIL a cancelled connection still made an edge"
        }
        ; And Escape gets out of it too, from every mode there is.
        editor.armPendingFromNode(cn.id true)
        this.keyDown("Escape" false false)
        if ((editor.idle()) == false) {
            simRunning = wasRunning
            return "FAIL Escape left a mode on"
        }
        report = (report + "connect ok; ")
        graph.clearSelection()

        ; Typing into a label, the way a double-click starts it. What is under
        ; the pointer depends on the diagram — a table's row here, a step's
        ; name there — so the test asks the editor which piece of text it
        ; caught rather than assuming. A caret you cannot see and text that
        ; does not come back is the failure worth catching.
        if ((this.beginEditAt(sx sy)) == false) {
            simRunning = wasRunning
            return "FAIL double-click started no edit"
        }
        def target:string editor.editTarget
        def wasCalled:string (FlowUndo.readText(graph target))
        if ((editor.editText) != wasCalled) {
            simRunning = wasRunning
            return "FAIL the buffer did not start from the text it is editing"
        }
        editor.caretToEnd()
        editor.typeText(" X")
        if ((FlowUndo.readText(graph target)) != wasCalled) {
            simRunning = wasRunning
            return "FAIL typing wrote to the model before commit"
        }
        this.commitEdit()
        if ((FlowUndo.readText(graph target)) != (wasCalled + " X")) {
            simRunning = wasRunning
            return "FAIL commit did not write the typed text"
        }
        this.undo()
        if ((FlowUndo.readText(graph target)) != wasCalled) {
            simRunning = wasRunning
            return "FAIL one undo did not take the whole edit back"
        }
        ; …and Escape leaves the model alone.
        this.beginEditAt(sx sy)
        editor.typeText("zzz")
        this.cancelEdit()
        if ((FlowUndo.readText(graph target)) != wasCalled) {
            simRunning = wasRunning
            return "FAIL escape wrote the buffer anyway"
        }
        report = (report + "edit ok; ")
        def json:string (editor.sceneJson())
        if ((strlen json) < 100) {
            simRunning = wasRunning
            return "FAIL empty scene"
        }
        report = (report + "scene " + (to_string (strlen json)) + " bytes; ")
        simRunning = wasRunning
        return ("PASS " + report + (this.stats()))
    }
}

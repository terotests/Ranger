; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; rangerflow_demo.rgr — the whole stack, from a .sql file to a PDF.
; ============================================================================
;
;   npm run rangerflow:demo                 the e-commerce schema, every output
;   npm run rangerflow:demo -- --uml        the UML class diagram instead
;   npm run rangerflow:demo -- --force      the React Flow force-layout parity
;   npm run rangerflow:demo -- --bench 500  layout + scene timings at a size
;   npm run rangerflow:demo -- --flowchart  an ATK flowchart in ISO 5807 shapes
;   npm run rangerflow:demo -- --mermaid    a Mermaid flowchart, read from a file
;   npm run rangerflow:demo -- --mermaid --style=print       …in another look
;   npm run rangerflow:demo -- --mermaid --style=print --restyle  …and the sheet
;                                           wins over the diagram's own classDef
;                                           (default | forest | dark | neutral
;                                            | print, or a path to a .css file)
;   npm run rangerflow:demo -- --org        an organisation chart
;   npm run rangerflow:demo -- --process    a swimlane process
;   npm run rangerflow:demo -- --drag       drop every node everywhere, count
;                                           the routes left crossing a box
;
; It writes into gallery/rangerflow/out/ and prints what it did, so a run is
; both the demo and a smoke test of every backend at once.
; ============================================================================

Import "../export/FlowExport.rgr"
Import "../core/FlowEditor.rgr"
Import "../domains/erd/SqlSchemaReader.rgr"
Import "../domains/erd/SchemaToGraph.rgr"
Import "../domains/uml/UMLModel.rgr"
Import "../domains/flowchart/Flowchart.rgr"
Import "../domains/mermaid/MermaidReader.rgr"
Import "../domains/mermaid/MermaidClassReader.rgr"
Import "../domains/mermaid/MermaidErReader.rgr"
Import "../domains/mermaid/MermaidStateReader.rgr"
Import "../domains/mermaid/MermaidMindMapReader.rgr"
Import "../domains/mermaid/MermaidRequirementReader.rgr"
Import "../domains/mermaid/MermaidC4Reader.rgr"
Import "../domains/mermaid/MermaidTimelineReader.rgr"
Import "../domains/mermaid/MermaidJourneyReader.rgr"
Import "../domains/mermaid/MermaidGanttReader.rgr"
Import "../domains/mermaid/MermaidSequenceReader.rgr"
Import "../domains/mermaid/MermaidGitReader.rgr"
Import "../domains/mermaid/MermaidKanbanReader.rgr"
Import "../domains/mermaid/MermaidQuadrantReader.rgr"
Import "../domains/mermaid/MermaidPieReader.rgr"
Import "../core/FlowStyleSheet.rgr"
Import "../domains/business/BusinessCharts.rgr"
Import "../layout/LayeredLayout.rgr"
Import "../layout/EdgeLanes.rgr"
Import "../layout/OrthoRouter.rgr"
Import "../layout/ForceLayout.rgr"

class RangerFlowDemo {
    def outDir:string "gallery/rangerflow/out"
    def fontsDir:string "gallery/pdf_writer/assets/fonts"

    Constructor () {
    }

    sfn main:void () {
        def d (new RangerFlowDemo)
        def mode:string "erd"
        def benchSize:int 0
        def mermaidPath:string "gallery/rangerflow/fixtures/order_flow.mmd"
        def styleName:string ""
        def restyle:boolean false
        def argCount:int (shell_arg_cnt)
        def i:int 0
        while (i < argCount) {
            def a:string (shell_arg i)
            if (a == "--uml")   { mode = "uml" }
            if (a == "--erd")   { mode = "erd" }
            if (a == "--force") { mode = "force" }
            if (a == "--drag")  { mode = "drag" }
            if (a == "--flowchart") { mode = "flowchart" }
            if (a == "--mermaid") {
                mode = "mermaid"
                if ((i + 1) < argCount) {
                    def given:string (shell_arg (i + 1))
                    if ((charAt given 0) != 45) {
                        mermaidPath = given
                    }
                }
            }
            if (a == "--org")       { mode = "org" }
            if (a == "--process")   { mode = "process" }
            if ((RangerFlowDemo.optionOf(a "--style=")) != "") {
                styleName = (RangerFlowDemo.optionOf(a "--style="))
            }
            if (a == "--restyle") { restyle = true }
            if (a == "--bench") {
                mode = "bench"
                if ((i + 1) < argCount) {
                    def raw:string (shell_arg (i + 1))
                    benchSize = (?? (str2int raw) 0)
                }
            }
            i = (i + 1)
        }
        if (mode == "uml")   { d.runUml() }
        if (mode == "erd")   { d.runErd() }
        if (mode == "force") { d.runForce() }
        if (mode == "bench") { d.runBench(benchSize) }
        if (mode == "drag")  { d.runDrag() }
        if (mode == "flowchart") { d.runFlowchart() }
        if (mode == "mermaid")   { d.runMermaid(mermaidPath styleName restyle) }
        if (mode == "org")       { d.runOrg() }
        if (mode == "process")   { d.runProcess() }
    }

    ; --------------------------------------------------------------- ERD ----
    fn runErd:void () {
        print "== RangerFlow: database schema =="
        def sqlOpt:string (?? (read_file "." "gallery/rangerflow/fixtures/ecommerce.sql") "")
        if ((strlen sqlOpt) == 0) {
            print "could not read gallery/rangerflow/fixtures/ecommerce.sql"
            return
        }
        def schema:DatabaseSchema (SqlSchemaReader.parse(sqlOpt))
        print ("  tables " + (to_string (schema.tableCount())) + ", foreign keys " + (to_string (array_length schema.foreignKeys)))
        def s2g (new SchemaToGraph)
        def g:FlowGraph (s2g.build(schema))
        def lay:LayeredLayout (LayeredLayout.of(g))
        lay.direction = "LR"
        lay.layerGap = 150.0
        lay.nodeGap = 40.0
        lay.run()
        SchemaToGraph.faceEdges(g)
        print ("  graph  " + (to_string (g.nodeCount())) + " nodes, " + (to_string (g.edgeCount())) + " edges, " + (to_string (lay.layerCount())) + " layers")
        this.routeEdges(g lay)
        def v:FlowView (FlowView.of(g))
        v.notation = "crowfoot"
        this.writeAll(v g "rangerflow-erd" "RangerFlow — e-commerce schema")
    }

    ; --------------------------------------------------------------- UML ----
    fn umlDiagram:UMLDiagram () {
        def d (new UMLDiagram)
        def shape:UMLClass (d.umlClass("Shape"))
        shape.stereotype = "abstract"
        shape.attribute("#" "origin" "Point")
        shape.operation("+" "area" "" "double")
        shape.operation("+" "draw" "ctx: Canvas" "void")
        def rect:UMLClass (d.umlClass("Rectangle"))
        rect.attribute("-" "width" "double")
        rect.attribute("-" "height" "double")
        rect.operation("+" "area" "" "double")
        def circle:UMLClass (d.umlClass("Circle"))
        circle.attribute("-" "radius" "double")
        circle.operation("+" "area" "" "double")
        def poly:UMLClass (d.umlClass("Polygon"))
        poly.attribute("-" "points" "[Point]")
        poly.operation("+" "area" "" "double")
        def canvas:UMLClass (d.umlClass("Canvas"))
        canvas.attribute("-" "shapes" "[Shape]")
        canvas.operation("+" "add" "s: Shape" "void")
        canvas.operation("+" "render" "" "void")
        def point:UMLClass (d.umlClass("Point"))
        point.stereotype = "record"
        point.attribute("+" "x" "double")
        point.attribute("+" "y" "double")
        d.relate("Rectangle" "Shape" "inheritance")
        d.relate("Circle" "Shape" "inheritance")
        d.relate("Polygon" "Shape" "inheritance")
        def owns:UMLRelation (d.relate("Canvas" "Shape" "composition"))
        owns.toMultiplicity = "0..*"
        d.relate("Shape" "Point" "aggregation")
        return d
    }

    fn runUml:void () {
        print "== RangerFlow: UML class diagram =="
        def d:UMLDiagram (this.umlDiagram())
        def u2g (new UMLToGraph)
        def g:FlowGraph (u2g.build(d))
        def lay:LayeredLayout (LayeredLayout.of(g))
        lay.direction = "TB"
        lay.layerGap = 110.0
        lay.run()
        print ("  graph  " + (to_string (g.nodeCount())) + " classes, " + (to_string (g.edgeCount())) + " relations")
        this.routeEdges(g lay)
        def v:FlowView (FlowView.of(g))
        v.notation = "uml"
        this.writeAll(v g "rangerflow-uml" "RangerFlow — UML class diagram")
    }

    ; ------------------------------------------------- force-layout parity ---
    ; The benchmark the library started from: React Flow's force-layout
    ; example is d3-force with charge -1000, link distance 150 and a weak pull
    ; to the origin on both axes. Same numbers here, same 300 ticks to settle.
    fn runForce:void () {
        print "== RangerFlow: force layout (React Flow example parity) =="
        def g (new FlowGraph)
        def i:int 0
        while (i < 30) {
            def n:FlowNode (g.node(("n" + (to_string i)) ("node " + (to_string i)) 0.0 0.0))
            n.width = 110.0
            n.height = 40.0
            i = (i + 1)
        }
        ; A tree plus a few cross links — the shape the example ships with.
        def k:int 1
        while (k < 30) {
            def parent:int (idiv (k - 1) 3)
            g.connect(("n" + (to_string parent)) ("n" + (to_string k)))
            k = (k + 1)
        }
        g.connect("n5" "n17")
        g.connect("n8" "n23")
        g.connect("n11" "n26")
        def sim:FlowSimulation (FlowSimulation.reactFlowExample(g -1000.0 150.0))
        sim.collideEnabled = true
        def before:double (wall_clock_ms)
        def ticks:int (sim.run(600))
        def after:double (wall_clock_ms)
        print ("  settled in " + (to_string ticks) + " ticks, alpha " + (to_string sim.alpha) + ", " + (to_string (to_int (after - before))) + " ms")
        def r:FlowRect (g.bounds())
        print ("  bounds " + (to_string (to_int r.w)) + " x " + (to_string (to_int r.h)))
        def v:FlowView (FlowView.of(g))
        v.notation = "plain"
        this.writeAll(v g "rangerflow-force" "RangerFlow — force layout")
    }

    ; ------------------------------------------------------------- bench ----
    fn runBench:void (size:int) {
        def n:int size
        if (n <= 0) {
            n = 500
        }
        print ("== RangerFlow: benchmark, " + (to_string n) + " nodes ==")
        def g (new FlowGraph)
        def i:int 0
        while (i < n) {
            def nd:FlowNode (g.node(("n" + (to_string i)) ("node " + (to_string i)) 0.0 0.0))
            nd.width = 140.0
            nd.height = 44.0
            i = (i + 1)
        }
        def k:int 1
        while (k < n) {
            def parent:int (idiv k 2)
            g.connect(("n" + (to_string parent)) ("n" + (to_string k)))
            if ((k % 7) == 0) {
                def other:int (idiv k 3)
                g.connect(("n" + (to_string other)) ("n" + (to_string k)))
            }
            k = (k + 1)
        }
        print ("  " + (to_string (g.nodeCount())) + " nodes, " + (to_string (g.edgeCount())) + " edges")

        def t0:double (wall_clock_ms)
        def sim:FlowSimulation (FlowSimulation.of(g))
        sim.chargeStrength = -400.0
        sim.linkDistance = 120.0
        sim.xEnabled = true
        sim.yEnabled = true
        sim.initialize()
        def ticks:int (sim.run(300))
        def t1:double (wall_clock_ms)
        print ("  force layout  " + (to_string (to_int (t1 - t0))) + " ms (" + (to_string ticks) + " ticks)")

        def t2:double (wall_clock_ms)
        def lay:LayeredLayout (LayeredLayout.of(g))
        lay.run()
        def t3:double (wall_clock_ms)
        print ("  layered layout " + (to_string (to_int (t3 - t2))) + " ms (" + (to_string (lay.layerCount())) + " layers)")

        def v:FlowView (FlowView.of(g))
        v.width = 1600.0
        v.height = 900.0
        def r:FlowRect (g.bounds())
        v.viewport.fitRect(r 1600.0 900.0 0.05)
        def t4:double (wall_clock_ms)
        def sc:FlowScene (v.build())
        def t5:double (wall_clock_ms)
        print ("  scene (fit)    " + (to_string (to_int (t5 - t4))) + " ms, " + (to_string (sc.count())) + " items, " + (to_string v.drawnNodes) + " drawn / " + (to_string v.culledNodes) + " culled")

        ; Zoomed in, which is where culling earns its keep.
        v.viewport.zoom = 1.0
        v.viewport.x = 0.0
        v.viewport.y = 0.0
        def t6:double (wall_clock_ms)
        def sc2:FlowScene (v.build())
        def t7:double (wall_clock_ms)
        print ("  scene (1:1)    " + (to_string (to_int (t7 - t6))) + " ms, " + (to_string (sc2.count())) + " items, " + (to_string v.drawnNodes) + " drawn / " + (to_string v.culledNodes) + " culled")

        def t8:double (wall_clock_ms)
        def json:string (sc2.sceneJson(1600.0 900.0))
        def t9:double (wall_clock_ms)
        print ("  display list   " + (to_string (to_int (t9 - t8))) + " ms, " + (to_string (strlen json)) + " bytes of JSON")

        ; A drag is a scene rebuild per frame; this is the latency budget.
        def ed:FlowEditor (FlowEditor.of(g))
        ed.setSize(1600.0 900.0)
        def inp (new FlowInput)
        def first:FlowNode (g.nodeAt(0))
        inp.x = (ed.view.viewport.toScreenX((first.centerX())))
        inp.y = (ed.view.viewport.toScreenY((first.centerY())))
        def t10:double (wall_clock_ms)
        ed.pointerDown(inp)
        def f:int 0
        while (f < 60) {
            inp.x = (inp.x + 1.0)
            ed.pointerMove(inp)
            ed.build()
            f = (f + 1)
        }
        ed.pointerUp(inp)
        def t11:double (wall_clock_ms)
        def per:double ((t11 - t10) / 60.0)
        print ("  drag 60 frames " + (to_string (to_int (t11 - t10))) + " ms (" + (to_string per) + " ms/frame)")
    }

    ; Channel routing, with the number that says whether it worked. Two edge
    ; segments drawn within two pixels of each other and overlapping along
    ; their shared axis are two edges that read as one line, and counting them
    ; is the difference between "looks tidier" and a claim.
    fn routeEdges:void (g:FlowGraph lay:LayeredLayout) {
        ; Two tolerances, because they answer different questions. At 2 px the
        ; segments are drawn on top of each other; at 8 they are close enough
        ; that at a normal zoom you cannot tell which line is which, which is
        ; the complaint this pass exists to answer.
        def exact0:int (EdgeOverlap.pairs(g 2.0))
        def near0:int (EdgeOverlap.pairs(g 8.0))
        def cross0:int (EdgeOverlap.nodeCrossings(g))
        def xx0:int (EdgeOverlap.edgeCrossings(g))
        def moved:int (EdgeLanes.assign(g))
        ; The chains, cashed in: a long edge is drawn through the lane its
        ; dummies held open. This runs after the fan so the corners start where
        ; the edge actually starts.
        def routed:int (lay.routeLongEdges())
        ; A second lane pass, now that the chained routes exist: the first one
        ; could not see them, so a track and a chain could end up drawn four
        ; pixels apart. This one treats the chains as lines to keep clear of.
        EdgeLanes.assign(g)
        ; …and then the repair pass, for whatever is still drawn through
        ; something the layout did not know about.
        def repaired:int (OrthoRouter.repairAll(g))
        def exact1:int (EdgeOverlap.pairs(g 2.0))
        def near1:int (EdgeOverlap.pairs(g 8.0))
        def cross1:int (EdgeOverlap.nodeCrossings(g))
        def xx1:int (EdgeOverlap.edgeCrossings(g))
        print ("  routing " + (to_string moved) + " endpoints and tracks moved, " + (to_string routed) + " long edges chained, " + (to_string repaired) + " repaired by the grid router")
        print ("          overlapping segment pairs: on top of each other " + (to_string exact0) + " → " + (to_string exact1) + ", within 8 px " + (to_string near0) + " → " + (to_string near1))
        print ("          edges drawn through an unrelated node: " + (to_string cross0) + " → " + (to_string cross1))
        print ("          edges crossing each other: " + (to_string xx0) + " → " + (to_string xx1))
    }

    ; -------------------------------------------------------- flowchart ----
    ; The chart every ATK course starts with, in the shapes it is supposed to
    ; be in. Nothing here knows about drawing: `FlowKind.shapeFor` is the whole
    ; of the translation from "this is a decision" to "this is a diamond".
    fn flowchartModel:Flowchart () {
        def c (new Flowchart)
        c.title = "Tilauksen käsittely"
        c.start("alku" "Alku")
        c.step("tilaus" "Lue tilaus" (FlowKind.io()))
        c.step("asiakas" "Asiakasrekisteri" (FlowKind.database()))
        c.step("tarkista" "Tarkista luottotiedot" (FlowKind.process()))
        c.step("luotto" "Luotto kunnossa?" (FlowKind.decision()))
        c.step("varasto" "Varaa tuotteet" (FlowKind.process()))
        c.step("saldo" "Riittääkö saldo?" (FlowKind.decision()))
        c.step("jalkitoimitus" "Merkitse jälkitoimitukseen" (FlowKind.process()))
        c.step("laskuta" "Muodosta lasku" (FlowKind.predefined()))
        c.step("lasku" "Lasku asiakkaalle" (FlowKind.document()))
        c.step("hylkaa" "Ilmoita hylkäys" (FlowKind.manual()))
        c.step("loppu" "Loppu" (FlowKind.terminator()))
        c.link("alku" "tilaus")
        c.link("tilaus" "tarkista")
        c.link("asiakas" "tarkista")
        c.link("tarkista" "luotto")
        c.branch("luotto" "varasto" "kyllä")
        c.branch("luotto" "hylkaa" "ei")
        c.link("varasto" "saldo")
        c.branch("saldo" "laskuta" "kyllä")
        c.branch("saldo" "jalkitoimitus" "ei")
        c.link("jalkitoimitus" "laskuta")
        c.link("laskuta" "lasku")
        c.link("lasku" "loppu")
        c.link("hylkaa" "loppu")
        return c
    }

    fn runFlowchart:void () {
        print "== RangerFlow: ATK-kaavio =="
        def c:Flowchart (this.flowchartModel())
        def g:FlowGraph (c.build())
        def lay:LayeredLayout (LayeredLayout.of(g))
        lay.direction = "TB"
        lay.layerGap = 70.0
        lay.nodeGap = 46.0
        lay.run()
        Flowchart.faceEdges(g)
        print ("  graph  " + (to_string (g.nodeCount())) + " steps, " + (to_string (g.edgeCount())) + " links")
        this.routeEdges(g lay)
        def v:FlowView (FlowView.of(g))
        v.notation = "plain"
        this.writeAll(v g "rangerflow-flowchart" "RangerFlow — ATK-kaavio")
    }

    ; ----------------------------------------------------------- mermaid ----
    ; The same pipeline again, with the model read from a file somebody wrote
    ; in a README instead of built by hand. Everything after the first two
    ; lines is what the ERD, the UML diagram and the ATK chart already do.
    ; `--style=print` and friends. The value rather than the flag, and "" when
    ; this argument is a different flag altogether.
    sfn optionOf:string (arg:string prefix:string) {
        def len:int (strlen prefix)
        if ((strlen arg) <= len) {
            return ""
        }
        if ((substring arg 0 len) != prefix) {
            return ""
        }
        return (substring arg len (strlen arg))
    }

    ; A look by name, a look by file, or the one the diagram asked for itself.
    fn styleFor:FlowStyle (name:string diagram:MermaidDiagram) {
        def want:string name
        if ((strlen want) == 0) {
            want = diagram.themeName
        }
        if ((strlen want) == 0) {
            want = "default"
        }
        if (FlowStyles.knows(want)) {
            print ("  style  " + want + " (built in)")
            return (FlowStyle.named(want))
        }
        def css:string (?? (read_file "." want) "")
        if ((strlen css) == 0) {
            print ("  style  could not read " + want + " — using the default look")
            return (FlowStyle.named("default"))
        }
        def s:FlowStyle (FlowStyle.parse(css))
        print ("  style  " + want + ", " + (to_string (s.ruleCount())) + " rules")
        def e:int 0
        while (e < (s.errorCount())) {
            print ("         ! " + (s.errorAt(e)))
            e = (e + 1)
        }
        return s
    }

    fn runMermaid:void (path:string styleName:string restyle:boolean) {
        print "== RangerFlow: Mermaid =="
        def srcOpt:string (?? (read_file "." path) "")
        if ((strlen srcOpt) == 0) {
            print ("could not read " + path)
            return
        }
        def d:MermaidDiagram (MermaidReader.parse(srcOpt))
        print ("  read   " + path)
        ; Mermaid draws a dozen kinds of diagram and this reads two of them.
        ; Saying which beats writing an empty page.
        if (d.diagramKind == "class") {
            this.runMermaidClass(srcOpt styleName)
            return
        }
        if (d.diagramKind == "er") {
            this.runMermaidEr(srcOpt styleName)
            return
        }
        if (d.diagramKind == "state") {
            this.runMermaidState(srcOpt styleName)
            return
        }
        if (d.diagramKind == "mindmap") {
            this.runMermaidMindMap(srcOpt styleName)
            return
        }
        if (d.diagramKind == "requirement") {
            this.runMermaidRequirement(srcOpt styleName)
            return
        }
        if (d.diagramKind == "c4") {
            this.runMermaidC4(srcOpt styleName)
            return
        }
        if (d.diagramKind == "timeline") {
            this.runMermaidTimeline(srcOpt styleName)
            return
        }
        if (d.diagramKind == "journey") {
            this.runMermaidJourney(srcOpt styleName)
            return
        }
        if (d.diagramKind == "gantt") {
            this.runMermaidGantt(srcOpt styleName)
            return
        }
        if (d.diagramKind == "sequence") {
            this.runMermaidSequence(srcOpt styleName)
            return
        }
        if (d.diagramKind == "git") {
            this.runMermaidGit(srcOpt styleName)
            return
        }
        if (d.diagramKind == "kanban") {
            this.runMermaidKanban(srcOpt styleName)
            return
        }
        if (d.diagramKind == "quadrant") {
            this.runMermaidQuadrant(srcOpt styleName)
            return
        }
        if (d.diagramKind == "pie") {
            this.runMermaidPie(srcOpt styleName)
            return
        }
        if ((strlen d.diagramKind) > 0) {
            if (d.diagramKind != "flowchart") {
                print ("  this is a " + d.diagramKind + " diagram — this reads flowcharts and class diagrams")
                return
            }
        }
        if ((d.nodeCount()) == 0) {
            print "  no nodes in that file — is it a flowchart?"
            return
        }
        print ("  model  " + (to_string (d.nodeCount())) + " nodes, " + (to_string (d.linkCount())) + " links, " + (to_string (d.subgraphCount())) + " subgraphs, direction " + d.direction)
        def style:FlowStyle (this.styleFor(styleName d))
        ; `--restyle`: the sheet after the diagram's own `classDef`, not before.
        style.strong = restyle
        def g:FlowGraph (MermaidFlow.styled(d style))
        print ("  graph  " + (to_string (g.nodeCount())) + " nodes (frames included), " + (to_string (g.edgeCount())) + " edges, " + (to_string style.written) + " styled properties")
        print ("         edges drawn through an unrelated node: " + (to_string (EdgeOverlap.nodeCrossings(g))))
        print ("         edges crossing each other: " + (to_string (EdgeOverlap.edgeCrossings(g))))
        def v:FlowView (FlowView.of(g))
        v.notation = "plain"
        ; The canvas too — the paper, the grid and the edge defaults are as
        ; much a part of a look as the fills are.
        style.applyToTheme(v.theme)
        def title:string d.title
        if ((strlen title) == 0) {
            title = "RangerFlow — Mermaid"
        }
        this.writeAll(v g "rangerflow-mermaid" title)
    }

    ; A Mermaid class diagram, drawn with the UML model RangerFlow already
    ; had: the same compartment node the schema editor uses, with the rows
    ; being members rather than columns.
    fn runMermaidClass:void (src:string styleName:string) {
        def cd:MermaidClassDiagram (MermaidClassReader.parse(src))
        if ((cd.classCount()) == 0) {
            print "  no classes in that class diagram"
            return
        }
        def style:FlowStyle (this.styleForClass(styleName cd))
        def g:FlowGraph (MermaidClassFlow.build(cd style))
        print ("  model  " + (to_string (cd.classCount())) + " classes, " + (to_string (cd.relationCount())) + " relations, direction " + cd.direction)
        print ("  graph  " + (to_string (g.nodeCount())) + " nodes, " + (to_string (g.edgeCount())) + " edges")
        print ("         edges drawn through an unrelated node: " + (to_string (EdgeOverlap.nodeCrossings(g))))
        print ("         edges crossing each other: " + (to_string (EdgeOverlap.edgeCrossings(g))))
        def v:FlowView (FlowView.of(g))
        v.notation = "uml"
        style.applyToTheme(v.theme)
        def title:string cd.title
        if ((strlen title) == 0) {
            title = "RangerFlow — Mermaid class diagram"
        }
        this.writeAll(v g "rangerflow-mermaid-class" title)
    }

    fn styleForClass:FlowStyle (name:string cd:MermaidClassDiagram) {
        return (this.styleByName(name))
    }

    ; A look by name or by file, for the diagrams that carry no theme of their
    ; own.
    fn styleByName:FlowStyle (name:string) {
        def want:string name
        if ((strlen want) == 0) {
            want = "default"
        }
        if (FlowStyles.knows(want)) {
            print ("  style  " + want + " (built in)")
            return (FlowStyle.named(want))
        }
        def css:string (?? (read_file "." want) "")
        if ((strlen css) == 0) {
            print ("  style  could not read " + want + " — using the default look")
            return (FlowStyle.named("default"))
        }
        print ("  style  " + want)
        return (FlowStyle.parse(css))
    }


; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; EdgeLanes.rgr — give every edge its own track through the corridor.
; ============================================================================
;
; An orthogonal router turns each edge at the midpoint between its two ends.
; That is the right answer for one edge and the wrong one for nine, because
; nine edges crossing the same gap all pick the same midpoint and their long
; perpendicular runs land on top of each other:
;
;   before                              after
;   ────┐                               ────┐
;   ────┤  ← four edges, one line       ───┐│
;   ────┤                               ──┐││
;   ────┘                               ─┐│││
;
; The fix is the standard one in orthogonal graph drawing — **channel routing**,
; or lane assignment: the gap between two columns of nodes is a corridor, the
; corridor holds a number of parallel tracks, and each edge crossing it gets a
; track of its own. yEd, ELK's orthogonal router and dbdiagram all do a version
; of this.
;
; The algorithm here is the small honest one:
;
;   1. Each edge's trunk is the perpendicular run between its two gapped
;      endpoints, and its default position is the midpoint — what the router
;      would have used.
;   2. Two trunks CONFLICT when they would be drawn within `spacing` of each
;      other AND their spans overlap, because only then can they be confused
;      for one line.
;   3. Conflict is transitive in practice — a stack of four is one problem, not
;      three — so the conflict graph's connected components are found with
;      union-find, and each component is one corridor.
;   4. Within a corridor the edges are ordered by the midpoint of their span
;      and then, because that guess is often wrong, by a transpose pass: two
;      neighbouring tracks swap whenever swapping costs fewer crossings. The
;      rule it discovers is that the edge reaching furthest has to turn LAST,
;      or its long run passes through a neighbour still on its way in.
;   5. The spread is clamped to the corridor's own width, so a track can never
;      be pushed back through the node it came from. When the edges do not fit
;      at full spacing, the spacing shrinks rather than the geometry breaking.
;   6. Routes somebody else already placed — a long edge drawn down the lane
;      its dummies held open, or one the reader dragged into place — join the
;      corridors as lines to keep clear of. They are never moved.
;
; What this does NOT do is route around obstacles: a track is still a straight
; run. `LayeredLayout`'s dummy chains keep the corridors clear of the nodes the
; layout placed, and `OrthoRouter` repairs whatever is left after that.
; ============================================================================

Import "../core/GraphModel.rgr"
Import "../core/EdgeRouter.rgr"

class EdgeLanes {
    ; How far apart two tracks have to be to read as two lines.
    def spacing:double 14.0
    ; Kept clear of the corridor's walls so a track never touches a node.
    def margin:double 10.0
    ; The offset the router leaves the node by, which is where a trunk starts.
    def stubOffset:double 20.0
    ; How far apart two slots on one side are kept. Not less than `spacing`,
    ; or two straight lines the fan lined up would be found too close by the
    ; corridor pass and bent apart again.
    def fanGap:double 16.0

    Constructor () {
    }

    sfn assign:int (g:FlowGraph) {
        def el (new EdgeLanes)
        return (el.apply(g))
    }

    ; Returns the number of edges that were moved off their default track.
    fn apply:int (g:FlowGraph) {
        def n:int (g.edgeCount())
        if (n < 2) {
            return 0
        }
        ; Ports first: an edge cannot be given its own track if it has not
        ; first been given its own place to arrive.
        def fanned:int (this.fanOutPorts(g))
        ; --- 1. each edge's trunk: axis, default position, span -------------
        def vertical:[boolean]
        def pos:[double]
        def lo:[double]
        def hi:[double]
        def wallA:[double]
        def wallB:[double]
        ; Where the trunk starts and where it ends, in travel order rather than
        ; sorted order. Which end is which is what decides whether two tracks
        ; can be swapped to save a crossing.
        def entry:[double]
        def exit:[double]
        def active:[boolean]
        ; An edge whose corners somebody else already placed — a long edge
        ; drawn down the corridor its dummies held open, or a route the reader
        ; dragged into place — cannot be given a track. But it is still a line
        ; on the diagram, and a track laid four pixels from it reads as one
        ; line drawn twice. So it joins the corridor as something to keep clear
        ; of rather than something to move.
        def frozen:[boolean]
        def k:int 0
        while (k < n) {
            def e:FlowEdge (g.edgeAt(k))
            push vertical true
            push pos 0.0
            push lo 0.0
            push hi 0.0
            push wallA 0.0
            push wallB 0.0
            push entry 0.0
            push exit 0.0
            push active false
            push frozen false
            if (this.trunkOf(g e k vertical pos lo hi wallA wallB entry exit)) {
                set_at active k true
            }
            k = (k + 1)
        }
        ; Entries past the edge count are not edges at all — they are the
        ; straight runs of routes that are already drawn. They take part in
        ; every conflict and never move.
        def f:int 0
        while (f < n) {
            if ((itemAt active f) == false) {
                def fe:FlowEdge (g.edgeAt(f))
                this.pushFixedTrunks(fe vertical pos lo hi wallA wallB entry exit active frozen)
            }
            f = (f + 1)
        }
        def total:int (array_length active)
        def origPos:[double]
        def o:int 0
        while (o < total) {
            push origPos (itemAt pos o)
            o = (o + 1)
        }

        ; Spreading one corridor can push a track on top of an edge that was
        ; not in it — two corridors twenty pixels apart become one corridor
        ; and one stray line four pixels from it. So conflicts are found again
        ; against where the tracks actually ended up, and again, until a round
        ; moves nothing. It settles in two or three rounds on real diagrams;
        ; the cap is there so a pathological one cannot spin.
        def round:int 0
        def working:boolean true
        while (round < 6) {
            if working {
                working = (this.settleRound(g n vertical pos lo hi wallA wallB entry exit active frozen))
                round = (round + 1)
            } {
                round = 6
            }
        }

        ; The last word belongs to the lines that are already drawn: a corridor
        ; that spread itself in the final round must still not sit on one.
        this.avoidFixed(g n vertical pos lo hi wallA wallB active frozen)

        def moved:int 0
        def m:int 0
        while (m < n) {
            if (itemAt active m) {
                if ((itemAt frozen m) == false) {
                    if ((fabs ((itemAt pos m) - (itemAt origPos m))) > 0.001) {
                        moved = (moved + 1)
                    }
                }
            }
            m = (m + 1)
        }
        return (moved + fanned)
    }

    ; One pass of "group the tracks that would be drawn on top of each other,
    ; then space each group out". True if anything moved.
    fn settleRound:boolean (g:FlowGraph n:int vertical:[boolean] pos:[double] lo:[double] hi:[double] wallA:[double] wallB:[double] entry:[double] exit:[double] active:[boolean] frozen:[boolean]) {
        ; --- 2/3. conflicts, and the corridors they form ---------------------
        def parent:[int]
        def i:int 0
        while (i < n) {
            push parent i
            i = (i + 1)
        }
        def a:int 0
        while (a < n) {
            if (this.movable(active frozen a)) {
                def b:int (a + 1)
                while (b < n) {
                    if (this.movable(active frozen b)) {
                        if ((itemAt vertical a) == (itemAt vertical b)) {
                            def dx:double (fabs ((itemAt pos a) - (itemAt pos b)))
                            if (dx < spacing) {
                                if (EdgeLanes.spansOverlap((itemAt lo a) (itemAt hi a) (itemAt lo b) (itemAt hi b))) {
                                    EdgeLanes.unite(parent a b)
                                }
                            }
                        }
                    }
                    b = (b + 1)
                }
            }
            a = (a + 1)
        }

        ; --- 4/5. order each corridor and spread it --------------------------
        def moved:int 0
        def seen:[boolean]
        def s:int 0
        while (s < n) {
            push seen false
            s = (s + 1)
        }
        def r:int 0
        while (r < n) {
            def keep:boolean false
            if (this.movable(active frozen r)) {
                if ((itemAt seen r) == false) {
                    if ((EdgeLanes.findRoot(parent r)) == r) {
                        keep = true
                    }
                }
            }
            if keep {
                def members:[int]
                def m:int 0
                while (m < n) {
                    if (this.movable(active frozen m)) {
                        if ((EdgeLanes.findRoot(parent m)) == r) {
                            push members m
                            set_at seen m true
                        }
                    }
                    m = (m + 1)
                }
                moved = (moved + (this.spread(g members vertical pos lo hi wallA wallB entry exit)))
            }
            r = (r + 1)
        }
        ; …and then, whatever the corridors decided, get out of the way of the
        ; lines that were already drawn.
        moved = (moved + (this.avoidFixed(g n vertical pos lo hi wallA wallB active frozen)))
        return (moved > 0)
    }

    fn movable:boolean (active:[boolean] frozen:[boolean] i:int) {
        if ((itemAt active i) == false) {
            return false
        }
        return ((itemAt frozen i) == false)
    }

    ; A track that ends up within `spacing` of a line somebody else already
    ; drew is moved to the nearer side of it, as far as the corridor's own
    ; walls allow. Nothing is moved for a line it does not run alongside.
    fn avoidFixed:int (g:FlowGraph n:int vertical:[boolean] pos:[double] lo:[double] hi:[double] wallA:[double] wallB:[double] active:[boolean] frozen:[boolean]) {
        def moved:int 0
        def m:int 0
        while (m < n) {
            if (this.movable(active frozen m)) {
                def at:double (itemAt pos m)
                def f:int n
                while (f < (array_length active)) {
                    if (itemAt frozen f) {
                        if ((itemAt vertical f) == (itemAt vertical m)) {
                            if (EdgeLanes.spansOverlap((itemAt lo m) (itemAt hi m) (itemAt lo f) (itemAt hi f))) {
                                def fp:double (itemAt pos f)
                                if ((fabs (at - fp)) < spacing) {
                                    def up:double (fp + spacing)
                                    def down:double (fp - spacing)
                                    def want:double up
                                    if ((fabs (down - at)) < (fabs (up - at))) {
                                        want = down
                                    }
                                    def low:double ((EdgeLanes.lower((itemAt wallA m) (itemAt wallB m))) + margin)
                                    def high:double ((EdgeLanes.upper((itemAt wallA m) (itemAt wallB m))) - margin)
                                    if (want < low) {
                                        want = up
                                    }
                                    if (want > high) {
                                        want = down
                                    }
                                    if (want >= low) {
                                        if (want <= high) {
                                            at = want
                                        }
                                    }
                                }
                            }
                        }
                    }
                    f = (f + 1)
                }
                if ((fabs (at - (itemAt pos m))) > 0.001) {
                    def e:FlowEdge (g.edgeAt(m))
                    if (itemAt vertical m) {
                        e.laneX = at
                        e.hasLaneX = true
                    } {
                        e.laneY = at
                        e.hasLaneY = true
                    }
                    set_at pos m at
                    moved = (moved + 1)
                }
            }
            m = (m + 1)
        }
        return moved
    }

    ; --------------------------------------------------------- port fan-out --
    ; Several foreign keys pointing at one primary key share a port, so they
    ; arrive at the same point and their last horizontal run is the same line
    ; drawn three times. Spread the arrivals across the row that owns the port,
    ; ordered by where each edge comes from so the fan does not cross itself.
    ;
    ; The spread stays inside the row — the point of a field-level port is that
    ; the edge visibly meets THAT column, and an arrival nudged into the
    ; neighbouring row would be a lie about the schema.
    fn fanOutPorts:int (g:FlowGraph) {
        def keys0:[string]
        def edgeIdx:[int]
        def atSource:[boolean]
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            e.portNudgeSource = 0.0
            e.portNudgeTarget = 0.0
            if (e.hidden == false) {
                if (e.sourceIndex >= 0) {
                    if (e.targetIndex >= 0) {
                        push keys0 (EdgeLanes.endKey(g e true))
                        push edgeIdx k
                        push atSource true
                        push keys0 (EdgeLanes.endKey(g e false))
                        push edgeIdx k
                        push atSource false
                    }
                }
            }
            k = (k + 1)
        }
        def total:int (array_length keys0)
        def moved:int 0
        ; Two passes. A slot is chosen by where the edge's far end is, and
        ; the far end is itself a slot being chosen: the first pass sees the
        ; far ends at their handles' centres, the second sees them where the
        ; first pass put them — which is what lines up a slot at one node
        ; with the slot the same edge got at the other, and makes a line
        ; that could be straight straight.
        def pass:int 0
        while (pass < 2) {
            moved = 0
            def done:[boolean]
            def d:int 0
            while (d < total) {
                push done false
                d = (d + 1)
            }
            def i:int 0
            while (i < total) {
                if ((itemAt done i) == false) {
                    def key:string (itemAt keys0 i)
                    def group:[int]
                    def keys:[double]
                    def j:int i
                    while (j < total) {
                        if ((itemAt keys0 j) == key) {
                            set_at done j true
                            push group j
                            ; Ordered by where the far end of the edge is, so
                            ; the fan opens towards the things it connects to
                            ; and its own strands do not cross.
                            def e2:FlowEdge (g.edgeAt((itemAt edgeIdx j)))
                            def far:boolean ((itemAt atSource j) == false)
                            def side:int (g.edgeSide(e2 (itemAt atSource j)))
                            def along:double (g.endpointY(e2 far))
                            if (EdgeLanes.alongX(side)) {
                                along = (g.endpointX(e2 far))
                            }
                            push keys along
                        }
                        j = (j + 1)
                    }
                    def count:int (array_length group)
                    if (count > 1) {
                        EdgeLanes.sortByKey(group keys)
                        moved = (moved + (this.placeFan(g group keys edgeIdx atSource)))
                    } {
                        ; One edge on this side is still a slot with a wish:
                        ; an arrow that leaves a box's middle for a box
                        ; standing a little to one side turns twice for
                        ; nothing, when leaving from nearer that side would
                        ; have made it straight. Only a box has a side to
                        ; slide along; a diamond's or a circle's border is
                        ; where the bounding box is only at the middle.
                        if (this.boxSide(g group edgeIdx atSource)) {
                            moved = (moved + (this.placeFan(g group keys edgeIdx atSource)))
                        }
                    }
                }
                i = (i + 1)
            }
            pass = (pass + 1)
        }
        this.slideRoutedEnds(g)
        return moved
    }

    ; Whether the side these slots are on is a box's flat side, with no
    ; named port on it.
    fn boxSide:boolean (g:FlowGraph group:[int] edgeIdx:[int] atSource:[boolean]) {
        def slot:int (itemAt group 0)
        def e:FlowEdge (g.edgeAt((itemAt edgeIdx slot)))
        def here:boolean (itemAt atSource slot)
        def portId:string e.targetPort
        if here {
            portId = e.sourcePort
        }
        if (g.hasPort(portId)) {
            return false
        }
        def owner:FlowNode (EdgeLanes.ownerOf(g e here))
        def side:int (g.edgeSide(e here))
        ; A table's or a class's left and right are its rows' ports; its
        ; top and bottom are as flat as any box's.
        if ((owner.sectionCount()) > 0) {
            return (EdgeLanes.alongX(side))
        }
        return ((EdgeLanes.sideShare(owner.shape)) >= 0.6)
    }

    ; How much of a top or bottom side the slots may use. A box's edge is
    ; straight nearly to its corners, so a box sized to its text still has
    ; room for three slots; a diamond or a circle has its border where the
    ; bounding box is only at the middle, and a slot far out would meet air.
    sfn sideShare:double (shape:string) {
        if (shape == "rect") { return 0.7 }
        if (shape == "action") { return 0.7 }
        if (shape == "roundrect") { return 0.7 }
        if (shape == "subroutine") { return 0.7 }
        if (shape == "stadium") { return 0.6 }
        return 0.5
    }

    ; One side's slots. Each edge would like to leave exactly opposite where
    ; it is going, so that the line between the two is straight; two that
    ; want the same place are pushed apart to `fanGap`, the group is moved
    ; back as a whole to sit as near its wishes as it can, and it is kept
    ; inside the room the side has. When the room is too small for the gap,
    ; the slots are spread evenly across it instead — closer than they should
    ; be, but each still its own.
    ;
    ; How much room there is depends on which side it is on: a row's height
    ; down a left or right edge, and a share of the node's width across a
    ; top or bottom one. The spread stays inside the row, because the point
    ; of a field-level port is that the edge visibly meets THAT column and
    ; an arrival nudged into the next row would misstate the schema.
    fn placeFan:int (g:FlowGraph group:[int] keys:[double] edgeIdx:[int] atSource:[boolean]) {
        def count:int (array_length group)
        def firstSlot:int (itemAt group 0)
        def anyEdge:FlowEdge (g.edgeAt((itemAt edgeIdx firstSlot)))
        def side0:int (g.edgeSide(anyEdge (itemAt atSource firstSlot)))
        def owner:FlowNode (EdgeLanes.ownerOf(g anyEdge (itemAt atSource firstSlot)))
        def room:double (owner.width * (EdgeLanes.sideShare(owner.shape)))
        if ((EdgeLanes.alongX(side0)) == false) {
            room = (owner.height * (EdgeLanes.sideShare(owner.shape)))
            ; A named port is a row: the fan stays inside it. An edge that
            ; joins the box itself — Mermaid's ER relationships name no
            ; column — has the whole side, and three of them squeezed into
            ; one row's height were three crow's feet drawn on each other.
            def anyPort:string anyEdge.targetPort
            if (itemAt atSource firstSlot) {
                anyPort = anyEdge.sourcePort
            }
            if (g.hasPort(anyPort)) {
                room = (owner.rowHeight - 6.0)
            }
        }
        if (room < 4.0) {
            room = 4.0
        }
        def half:double (room * 0.5)
        ; Where the side's own handle is, so a wish can be a nudge from it.
        def centre:double 0.0
        def wish:[double]
        def at:[double]
        def t:int 0
        while (t < count) {
            def slot:int (itemAt group t)
            def e:FlowEdge (g.edgeAt((itemAt edgeIdx slot)))
            def here:boolean (itemAt atSource slot)
            def own:double (g.endpointY(e here))
            def nudge:double e.portNudgeTarget
            if here {
                nudge = e.portNudgeSource
            }
            if (EdgeLanes.alongX(side0)) {
                own = (g.endpointX(e here))
            }
            centre = (own - nudge)
            def w:double ((itemAt keys t) - centre)
            if (w < (0.0 - half)) { w = (0.0 - half) }
            if (w > half) { w = half }
            push wish w
            push at w
            t = (t + 1)
        }
        ; Push apart, then slide the whole group back towards its wishes.
        def f:int 1
        while (f < count) {
            def least:double ((itemAt at (f - 1)) + fanGap)
            if ((itemAt at f) < least) {
                set_at at f least
            }
            f = (f + 1)
        }
        def drift:double 0.0
        def m:int 0
        while (m < count) {
            drift = (drift + ((itemAt at m) - (itemAt wish m)))
            m = (m + 1)
        }
        drift = (drift / (to_double count))
        def lowest:double ((itemAt at 0) - drift)
        def highest:double ((itemAt at (count - 1)) - drift)
        def shift:double (0.0 - drift)
        if (lowest < (0.0 - half)) {
            shift = (shift + ((0.0 - half) - lowest))
            highest = (highest + ((0.0 - half) - lowest))
        }
        if (highest > half) {
            shift = (shift + (half - highest))
        }
        def fits:boolean (((itemAt at 0) + shift) >= ((0.0 - half) - 0.01))
        def s:int 0
        while (s < count) {
            def slot2:int (itemAt group s)
            def e3:FlowEdge (g.edgeAt((itemAt edgeIdx slot2)))
            def nudge2:double ((itemAt at s) + shift)
            if (fits == false) {
                def gap:double (room / (to_double count))
                def spread:double ((gap * (to_double (count - 1))) * 0.5)
                nudge2 = ((gap * (to_double s)) - spread)
            }
            if (itemAt atSource slot2) {
                e3.portNudgeSource = nudge2
            } {
                e3.portNudgeTarget = nudge2
            }
            s = (s + 1)
        }
        return count
    }

    ; An edge that already carries a route — the layered layout's corridor
    ; chain, or the grid router's way round something — was drawn from where
    ; its ends were at the time, and the fan has just moved them. Until this
    ; the route stayed where it was and the slot went unused: two chained
    ; edges into one side both kept the centre they were drawn to, one on
    ; top of the other, with the fan insisting they were fifteen pixels
    ; apart. The route is kept and its ends follow it: the first leg leaves a
    ; port straight and the last arrives straight, so sliding the end and the
    ; corner it turns at along the port's side keeps every corner square.
    fn slideRoutedEnds:void (g:FlowGraph) {
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            if (e.pinnedRoute == false) {
                if ((array_length e.waypoints) >= 6) {
                    this.slideEnd(g e true)
                    this.slideEnd(g e false)
                }
            }
            k = (k + 1)
        }
    }

    fn slideEnd:void (g:FlowGraph e:FlowEdge atSource:boolean) {
        def n:int (idiv (array_length e.waypoints) 2)
        def side:int (g.edgeSide(e atSource))
        ; The coordinate the slot runs along: x on a top or bottom port, y on
        ; a left or right one. The other one is the leg's own direction.
        def axis:int 1
        if (EdgeLanes.alongX(side)) {
            axis = 0
        }
        def want:double (g.endpointY(e atSource))
        if (axis == 0) {
            want = (g.endpointX(e atSource))
        }
        def first:int 0
        def step:int 1
        if (atSource == false) {
            first = (n - 1)
            step = -1
        }
        def have:double (itemAt e.waypoints ((first * 2) + axis))
        def d:double (want - have)
        if ((fabs d) < 0.01) {
            return
        }
        ; The run out of the port: every corner that shares the port's own
        ; coordinate, up to the one where the route turns. A route whose very
        ; first leg is not straight out of the port was placed by something
        ; with its own reasons, and is left alone.
        def second:int (first + step)
        if ((fabs ((itemAt e.waypoints ((second * 2) + axis)) - have)) > 0.01) {
            return
        }
        def p:int first
        while (p >= 0) {
            if (p < n) {
                def at:int ((p * 2) + axis)
                if ((fabs ((itemAt e.waypoints at) - have)) < 0.01) {
                    set_at e.waypoints at ((itemAt e.waypoints at) + d)
                    p = (p + step)
                } {
                    p = -1
                }
            } {
                p = -1
            }
        }
    }

    ; ------------------------------------------------------------ labels --
    ; Two labels drawn on top of each other read as one word. Lines the fan
    ; has just lined up side by side — `start` down and `stop` back up
    ; sixteen pixels from it — have their midpoints at the same height, and
    ; their labels, centred on those midpoints, on each other. Where two
    ; labels' boxes overlap they are slid apart along their own lines, one
    ; back and one forward, until they clear. The label stays on its line;
    ; only where along it changes.
    sfn staggerLabels:int (g:FlowGraph) {
        def moved:int 0
        def round:int 0
        while (round < 3) {
            def any:boolean false
            def a:int 0
            while (a < (g.edgeCount())) {
                def ea:FlowEdge (g.edgeAt(a))
                if (EdgeLanes.hasLabel(ea)) {
                    def b:int (a + 1)
                    while (b < (g.edgeCount())) {
                        def eb:FlowEdge (g.edgeAt(b))
                        if (EdgeLanes.hasLabel(eb)) {
                            if (EdgeLanes.partLabels(g ea eb)) {
                                any = true
                                moved = (moved + 1)
                            }
                        }
                        b = (b + 1)
                    }
                }
                a = (a + 1)
            }
            if any {
                round = (round + 1)
            } {
                round = 3
            }
        }
        return moved
    }

    sfn hasLabel:boolean (e:FlowEdge) {
        if e.hidden {
            return false
        }
        return ((strlen e.label) > 0)
    }

    ; The box a label takes, near enough: the theme's 11px face.
    sfn labelWidth:double (e:FlowEdge) {
        return (((to_double (strlen e.label)) * 6.6) + 12.0)
    }

    ; Whether an edge is, on the whole, going up or down the page.
    sfn runsVertical:boolean (g:FlowGraph e:FlowEdge) {
        def dx:double (fabs ((g.endpointX(e false)) - (g.endpointX(e true))))
        def dy:double (fabs ((g.endpointY(e false)) - (g.endpointY(e true))))
        return (dy >= dx)
    }

    sfn partLabels:boolean (g:FlowGraph a:FlowEdge b:FlowEdge) {
        def pa:EdgePath (EdgeRouter.route(g a))
        def pb:EdgePath (EdgeRouter.route(g b))
        pa.flatten(4)
        pb.flatten(4)
        def ax:double ((pa.midX()) + a.labelDX)
        def ay:double ((pa.midY()) + a.labelDY)
        def bx:double ((pb.midX()) + b.labelDX)
        def by:double ((pb.midY()) + b.labelDY)
        def height:double 18.0
        def overX:double ((((EdgeLanes.labelWidth(a)) + (EdgeLanes.labelWidth(b))) * 0.5) - (fabs (ax - bx)))
        def overY:double (height - (fabs (ay - by)))
        if (overX <= 0.0) {
            return false
        }
        if (overY <= 0.0) {
            return false
        }
        ; Each slides along its own line, away from the other. Two lines
        ; running the same way part by the overlap between them; on a line
        ; running the other way the slide clears the box in one move.
        if (EdgeLanes.runsVertical(g a)) {
            def stepA:double ((overY * 0.5) + 2.0)
            if (ay > by) {
                a.labelDY = (a.labelDY + stepA)
            } {
                a.labelDY = (a.labelDY - stepA)
            }
        } {
            def stepAx:double ((overX * 0.5) + 2.0)
            if (ax > bx) {
                a.labelDX = (a.labelDX + stepAx)
            } {
                a.labelDX = (a.labelDX - stepAx)
            }
        }
        if (EdgeLanes.runsVertical(g b)) {
            def stepB:double ((overY * 0.5) + 2.0)
            if (by >= ay) {
                b.labelDY = (b.labelDY + stepB)
            } {
                b.labelDY = (b.labelDY - stepB)
            }
        } {
            def stepBx:double ((overX * 0.5) + 2.0)
            if (bx >= ax) {
                b.labelDX = (b.labelDX + stepBx)
            } {
                b.labelDX = (b.labelDX - stepBx)
            }
        }
        return true
    }

    ; ------------------------------------------------------------- trunks --
    ; The perpendicular run an edge makes between its two gapped endpoints —
    ; only edges whose handles face each other have one, which is the case the
    ; corridors are made of. Everything else keeps the router's own corner.
    fn trunkOf:boolean (g:FlowGraph e:FlowEdge idx:int vertical:[boolean] pos:[double] lo:[double] hi:[double] wallA:[double] wallB:[double] entry:[double] exit:[double]) {
        if (e.hidden) {
            return false
        }
        if (e.sourceIndex < 0) {
            return false
        }
        if (e.targetIndex < 0) {
            return false
        }
        ; An edge that was routed, or placed by hand, already knows where it
        ; is going.
        if ((array_length e.waypoints) >= 4) {
            return false
        }
        if e.pinnedRoute {
            return false
        }
        def kind:string e.edgeType
        def routed:boolean false
        if (kind == "step") { routed = true }
        if (kind == "smoothstep") { routed = true }
        if (kind == "orthogonal") { routed = true }
        if (routed == false) {
            return false
        }
        def s1:int (g.edgeSide(e true))
        def s2:int (g.edgeSide(e false))
        def horizA:boolean ((EdgeLanes.alongX(s1)) == false)
        def horizB:boolean ((EdgeLanes.alongX(s2)) == false)
        ; Only the opposite-facing case has a trunk; a single corner has none.
        if (horizA != horizB) {
            return false
        }
        ; The walls are kept in travel order — `wallA` is the side the edge
        ; comes in from, `wallB` the side it goes out to — because which way
        ; an edge crosses the corridor decides which of its stubs a
        ; neighbouring track runs past. Everything that wants the corridor
        ; as a range takes the lower and upper of the two.
        def x1:double (g.endpointX(e true))
        def y1:double (g.endpointY(e true))
        def x2:double (g.endpointX(e false))
        def y2:double (g.endpointY(e false))
        def sgx:double (x1 + ((FlowPosition.normalX(s1)) * stubOffset))
        def sgy:double (y1 + ((FlowPosition.normalY(s1)) * stubOffset))
        def tgx:double (x2 + ((FlowPosition.normalX(s2)) * stubOffset))
        def tgy:double (y2 + ((FlowPosition.normalY(s2)) * stubOffset))
        if horizA {
            ; horizontal handles → the trunk is a VERTICAL run at some x
            def spanLo:double (EdgeLanes.lower(sgy tgy))
            def spanHi:double (EdgeLanes.upper(sgy tgy))
            def walls:[double] (this.clearWalls(g e true spanLo spanHi sgx tgx))
            set_at vertical idx true
            set_at pos idx (((itemAt walls 0) + (itemAt walls 1)) * 0.5)
            set_at lo idx spanLo
            set_at hi idx spanHi
            set_at wallA idx (itemAt walls 0)
            set_at wallB idx (itemAt walls 1)
            set_at entry idx sgy
            set_at exit idx tgy
            return true
        }
        def spanLo2:double (EdgeLanes.lower(sgx tgx))
        def spanHi2:double (EdgeLanes.upper(sgx tgx))
        def walls2:[double] (this.clearWalls(g e false spanLo2 spanHi2 sgy tgy))
        set_at vertical idx false
        set_at pos idx (((itemAt walls2 0) + (itemAt walls2 1)) * 0.5)
        set_at lo idx spanLo2
        set_at hi idx spanHi2
        set_at wallA idx (itemAt walls2 0)
        set_at wallB idx (itemAt walls2 1)
        set_at entry idx sgx
        set_at exit idx tgx
        return true
    }

    ; The corridor's walls, pulled in past whatever stands in it. The walls
    ; start at the two stubs, and between two layers of even boxes that is
    ; the corridor. Between a 28px class and the 400px one beside it, it is
    ; not: an edge leaving the short one's bottom has its midpoint level
    ; with the middle of the tall one, and a track put there runs straight
    ; through it — after which the grid router draws a route of its own,
    ; alone, on the same line as the next edge's route of its own. So every
    ; node the trunk would run across narrows the walls to the free band on
    ; the midpoint's side of it, or the wider band when the node covers the
    ; midpoint. Returned in travel order: the source's wall first.
    fn clearWalls:[double] (g:FlowGraph e:FlowEdge verticalTrunk:boolean spanLo:double spanHi:double fromWall:double toWall:double) {
        def low:double (EdgeLanes.lower(fromWall toWall))
        def high:double (EdgeLanes.upper(fromWall toWall))
        def i:int 0
        while (i < (g.nodeCount())) {
            def keep:boolean true
            if (i == e.sourceIndex) { keep = false }
            if (i == e.targetIndex) { keep = false }
            if keep {
                def n:FlowNode (g.nodeAt(i))
                if ((EdgeOverlap.blocks(n)) == false) { keep = false }
                if keep {
                    ; Along the trunk: the node's extent across the corridor.
                    ; Across it: the node's extent along the corridor.
                    def a0:double n.y
                    def a1:double (n.y + n.height)
                    def c0:double n.x
                    def c1:double (n.x + n.width)
                    if verticalTrunk {
                        a0 = n.x
                        a1 = (n.x + n.width)
                        c0 = n.y
                        c1 = (n.y + n.height)
                    }
                    def across:boolean true
                    if (c1 <= (spanLo - margin)) { across = false }
                    if (c0 >= (spanHi + margin)) { across = false }
                    if across {
                        if (a1 > low) {
                            if (a0 < high) {
                                def mid:double ((low + high) * 0.5)
                                def belowRoom:double ((a0 - margin) - low)
                                def aboveRoom:double (high - (a1 + margin))
                                def takeBelow:boolean (mid < a0)
                                if (mid >= a0) {
                                    if (mid <= a1) {
                                        takeBelow = (belowRoom >= aboveRoom)
                                    }
                                }
                                if takeBelow {
                                    high = (a0 - margin)
                                } {
                                    low = (a1 + margin)
                                }
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
        def out:[double]
        if (high <= low) {
            ; Nothing clear: leave the walls as the stubs had them, and let
            ; the grid router have the edge.
            push out fromWall
            push out toWall
            return out
        }
        if (fromWall <= toWall) {
            push out low
            push out high
        } {
            push out high
            push out low
        }
        return out
    }

    ; Order by the middle of the span and lay the tracks out around the
    ; corridor's centre. Ordering by span rather than by index is what keeps
    ; the tracks themselves from crossing: an edge heading further down gets a
    ; track further along.
    fn spread:int (g:FlowGraph members:[int] vertical:[boolean] pos:[double] lo:[double] hi:[double] wallA:[double] wallB:[double] entry:[double] exit:[double]) {
        def count:int (array_length members)
        if (count < 2) {
            return 0
        }
        def order:[int]
        def keys:[double]
        def i:int 0
        while (i < count) {
            def m:int (itemAt members i)
            push order m
            push keys (((itemAt lo m) + (itemAt hi m)) * 0.5)
            i = (i + 1)
        }
        EdgeLanes.sortByKey(order keys)
        ; Span order is a starting guess, and on its own it is often the wrong
        ; one: two edges that both turn towards the same table cross unless the
        ; one that reaches further turns later. So walk the neighbours and swap
        ; whenever swapping costs fewer crossings. It is the transpose pass a
        ; layered layout already uses on its layers, applied to the tracks in a
        ; corridor rather than to the nodes in a row.
        def pass:int 0
        while (pass < count) {
            def swapped:boolean false
            def q:int 0
            while (q < (count - 1)) {
                def u:int (itemAt order q)
                def v:int (itemAt order (q + 1))
                def asIs:int (EdgeLanes.crossCost(u v lo hi wallA wallB entry exit))
                def flipped:int (EdgeLanes.crossCost(v u lo hi wallA wallB entry exit))
                if (flipped < asIs) {
                    set_at order q v
                    set_at order (q + 1) u
                    swapped = true
                }
                q = (q + 1)
            }
            if swapped {
                pass = (pass + 1)
            } {
                pass = count
            }
        }

        ; The corridor is only as wide as the narrowest edge in it allows.
        def centre:double 0.0
        def widest:double 1000000.0
        def j:int 0
        while (j < count) {
            def m2:int (itemAt order j)
            centre = (centre + (itemAt pos m2))
            def room:double ((fabs ((itemAt wallB m2) - (itemAt wallA m2))) - (margin * 2.0))
            if (room < widest) {
                widest = room
            }
            j = (j + 1)
        }
        centre = (centre / (to_double count))
        def gap:double spacing
        def span:double (gap * (to_double (count - 1)))
        if (span > widest) {
            if (widest <= 0.0) {
                return 0
            }
            gap = (widest / (to_double (count - 1)))
        }
        def half:double ((gap * (to_double (count - 1))) * 0.5)
        def moved:int 0
        def t:int 0
        while (t < count) {
            def m3:int (itemAt order t)
            def at:double ((centre - half) + (gap * (to_double t)))
            def e:FlowEdge (g.edgeAt(m3))
            if (itemAt vertical m3) {
                e.laneX = at
                e.hasLaneX = true
            } {
                e.laneY = at
                e.hasLaneY = true
            }
            def delta:double (fabs (at - (itemAt pos m3)))
            if (delta > 0.001) {
                moved = (moved + 1)
            }
            ; The next round looks for conflicts against where the tracks are
            ; now, not where they started.
            set_at pos m3 at
            t = (t + 1)
        }
        return moved
    }

    ; What it costs to put track `u` on the near side of track `v`.
    ;
    ; Each edge crosses the corridor by two stubs: one from the wall it comes
    ; in by to its track, one from its track to the wall it goes out by. With
    ; u nearer, u's track lies between the near wall and v's track, so the
    ; stub v has on the NEAR wall runs past u's track — a crossing exactly
    ; when that stub lands inside u's span. And v's track lies between u's
    ; track and the far wall, so the stub u has on the FAR wall runs past
    ; v's — a crossing when it lands inside v's span. The other two stubs
    ; cannot meet anything. Which stub is on which wall depends on which
    ; way the edge is going: two edges crossing the corridor opposite ways
    ; — `pause` down and `resume` back up — have their near stubs at
    ; opposite ends, and a cost that assumed they both went the same way
    ; found the two orders equal and left them crossing twice.
    sfn crossCost:int (u:int v:int lo:[double] hi:[double] wallA:[double] wallB:[double] entry:[double] exit:[double]) {
        def cost:int 0
        def nearOfV:double (itemAt exit v)
        if ((itemAt wallA v) < (itemAt wallB v)) {
            nearOfV = (itemAt entry v)
        }
        def farOfU:double (itemAt entry u)
        if ((itemAt wallA u) < (itemAt wallB u)) {
            farOfU = (itemAt exit u)
        }
        if (EdgeLanes.strictlyInside(nearOfV (itemAt lo u) (itemAt hi u))) {
            cost = (cost + 1)
        }
        if (EdgeLanes.strictlyInside(farOfU (itemAt lo v) (itemAt hi v))) {
            cost = (cost + 1)
        }
        return cost
    }

    sfn strictlyInside:boolean (v:double a:double b:double) {
        if (v <= (a + 0.001)) {
            return false
        }
        return (v < (b - 0.001))
    }

    ; Every straight run of an edge somebody else already routed, long enough
    ; to read as a line rather than a corner. These are appended past the edge
    ; count: they are obstacles in the corridors, not candidates for a track.
    fn pushFixedTrunks:void (e:FlowEdge vertical:[boolean] pos:[double] lo:[double] hi:[double] wallA:[double] wallB:[double] entry:[double] exit:[double] active:[boolean] frozen:[boolean]) {
        if e.hidden {
            return
        }
        def n:int (idiv (array_length e.waypoints) 2)
        if (n < 2) {
            return
        }
        def i:int 1
        while (i < n) {
            def ax:double (itemAt e.waypoints ((i - 1) * 2))
            def ayAt:int (((i - 1) * 2) + 1)
            def ay:double (itemAt e.waypoints ayAt)
            def bx:double (itemAt e.waypoints (i * 2))
            def byAt:int ((i * 2) + 1)
            def by:double (itemAt e.waypoints byAt)
            def dx:double (fabs (bx - ax))
            def dy:double (fabs (by - ay))
            if (dy > dx) {
                if (dy >= spacing) {
                    push vertical true
                    push pos ax
                    push lo (EdgeLanes.lower(ay by))
                    push hi (EdgeLanes.upper(ay by))
                    push wallA ax
                    push wallB ax
                    push entry ay
                    push exit by
                    push active true
                    push frozen true
                }
            } {
                if (dx >= spacing) {
                    push vertical false
                    push pos ay
                    push lo (EdgeLanes.lower(ax bx))
                    push hi (EdgeLanes.upper(ax bx))
                    push wallA ay
                    push wallB ay
                    push entry ax
                    push exit bx
                    push active true
                    push frozen true
                }
            }
            i = (i + 1)
        }
    }

    ; Forget every assignment — the lanes are only valid for the positions they
    ; were computed from, so a drag or a relayout has to start clean.
    ; The lanes only, with the routes left alone.
    ;
    ; `assign` skips an edge that already has a lane, so the fan computed
    ; before a router rewrote half the routes is the only fan there will ever
    ; be — and a second `assign` is a no-op that hides it. This is what a
    ; pipeline calls to fan the edges again against the routes as they now
    ; are. The full `reset` below throws the routes away as well, which is
    ; right after a DRAG (the layout those routes came from is no longer what
    ; is on screen) and wrong after a repair (the routes are the repair).
    sfn resetLanes:void (g:FlowGraph) {
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            if (e.pinnedRoute == false) {
                e.hasLaneX = false
                e.hasLaneY = false
                e.portNudgeSource = 0.0
                e.portNudgeTarget = 0.0
            }
            k = (k + 1)
        }
    }

    sfn reset:void (g:FlowGraph) {
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            if e.pinnedRoute {
                k = (k + 1)
                continue
            }
            e.hasLaneX = false
            e.hasLaneY = false
            e.portNudgeSource = 0.0
            e.portNudgeTarget = 0.0
            ; Waypoints go too. They were computed from a layout, and once a
            ; node has been dragged by hand that layout is no longer what is on
            ; screen — a route round an obstacle that has moved is worse than
            ; no route at all.
            clear e.waypoints
            k = (k + 1)
        }
    }

    ; What two edges have to share before they are the same arrival: a named
    ; port, or — when there is none — the node side they both land on. The
    ; second case is what a plain flowchart or a UML diagram is made of, where
    ; three edges meet one node's top handle at literally one point.
    sfn endKey:string (g:FlowGraph e:FlowEdge atSource:boolean) {
        def portId:string e.targetPort
        def nodeId:string e.target
        if atSource {
            portId = e.sourcePort
            nodeId = e.source
        }
        if (g.hasPort(portId)) {
            return ("port:" + portId)
        }
        def side:int (g.edgeSide(e atSource))
        return ("node:" + nodeId + ":" + (to_string side))
    }

    sfn ownerOf:FlowNode (g:FlowGraph e:FlowEdge atSource:boolean) {
        def portId:string e.targetPort
        def nodeId:string e.target
        if atSource {
            portId = e.sourcePort
            nodeId = e.source
        }
        if (g.hasPort(portId)) {
            def p:FlowPort (g.portRef(portId))
            return (g.nodeById(p.nodeId))
        }
        return (g.nodeById(nodeId))
    }

    sfn alongX:boolean (side:int) {
        if (side == 0) { return true }
        if (side == 2) { return true }
        return false
    }

    ; ------------------------------------------------------------- helpers --
    sfn lower:double (a:double b:double) {
        if (a < b) { return a }
        return b
    }

    sfn upper:double (a:double b:double) {
        if (a > b) { return a }
        return b
    }

    sfn spansOverlap:boolean (aLo:double aHi:double bLo:double bHi:double) {
        if (aHi < bLo) { return false }
        if (bHi < aLo) { return false }
        return true
    }

    sfn findRoot:int (parent:[int] i:int) {
        def r:int i
        def guard:int 0
        while (guard < 100000) {
            def p:int (itemAt parent r)
            if (p == r) {
                return r
            }
            r = p
            guard = (guard + 1)
        }
        return r
    }

    sfn unite:void (parent:[int] a:int b:int) {
        def ra:int (EdgeLanes.findRoot(parent a))
        def rb:int (EdgeLanes.findRoot(parent b))
        if (ra == rb) {
            return
        }
        if (ra < rb) {
            set_at parent rb ra
        } {
            set_at parent ra rb
        }
    }

    ; Insertion sort, stable, on two parallel arrays.
    sfn sortByKey:void (order:[int] keys:[double]) {
        def n:int (array_length order)
        def i:int 1
        while (i < n) {
            def kv:double (itemAt keys i)
            def mv:int (itemAt order i)
            def j:int (i - 1)
            def at:int 0
            def settled:boolean false
            while (j >= 0) {
                if (settled == false) {
                    if ((itemAt keys j) > kv) {
                        set_at keys (j + 1) (itemAt keys j)
                        set_at order (j + 1) (itemAt order j)
                        j = (j - 1)
                    } {
                        at = (j + 1)
                        settled = true
                        j = -1
                    }
                }
            }
            if (settled == false) {
                at = 0
            }
            set_at keys at kv
            set_at order at mv
            i = (i + 1)
        }
    }
}

; ---------------------------------------------------------------------------
; Measuring it
; ---------------------------------------------------------------------------
; "The lines are easier to follow" is not a number, and a routing change that
; cannot be measured is a routing change nobody can defend. This counts the
; pairs of edge segments that are parallel, within `tol` of each other, and
; overlapping along their shared axis — that is exactly the situation where two
; edges read as one line.
class EdgeOverlap {
    ; How many times two edges cross each other. Overlap counts lines drawn
    ; ON each other; this counts lines drawn THROUGH each other, which is the
    ; other half of "the routing looks wrong" and the one a layered layout is
    ; supposed to minimise.
    ;
    ; A crossing close to either edge's own end does not count: several edges
    ; arriving at one table are supposed to converge there, and the fan that
    ; spreads them across a row necessarily has them meet.
    sfn edgeCrossings:int (g:FlowGraph) {
        def segX1:[double]
        def segY1:[double]
        def segX2:[double]
        def segY2:[double]
        def owner:[int]
        def endX:[double]
        def endY:[double]
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            if (e.hidden == false) {
                if (e.sourceIndex >= 0) {
                    if (e.targetIndex >= 0) {
                        def p:EdgePath (EdgeRouter.route(g e))
                        p.flatten(2)
                        def n:int (p.pointCount())
                        def i:int 1
                        while (i < n) {
                            push segX1 (p.px((i - 1)))
                            push segY1 (p.py((i - 1)))
                            push segX2 (p.px(i))
                            push segY2 (p.py(i))
                            push owner k
                            i = (i + 1)
                        }
                        if (n > 0) {
                            push endX (p.px(0))
                            push endY (p.py(0))
                            push endX (p.px((n - 1)))
                            push endY (p.py((n - 1)))
                        }
                    }
                }
            }
            k = (k + 1)
        }
        def near:double 26.0
        def total:int 0
        def m:int (array_length owner)
        def a:int 0
        while (a < m) {
            def b:int (a + 1)
            while (b < m) {
                if ((itemAt owner a) != (itemAt owner b)) {
                    def hit:[double] (EdgeOverlap.crossingOf((itemAt segX1 a) (itemAt segY1 a) (itemAt segX2 a) (itemAt segY2 a) (itemAt segX1 b) (itemAt segY1 b) (itemAt segX2 b) (itemAt segY2 b)))
                    if ((array_length hit) == 2) {
                        if ((EdgeOverlap.nearAnyEnd(endX endY (itemAt hit 0) (itemAt hit 1) near)) == false) {
                            total = (total + 1)
                        }
                    }
                }
                b = (b + 1)
            }
            a = (a + 1)
        }
        return total
    }

    sfn nearAnyEnd:boolean (endX:[double] endY:[double] px:double py:double near:double) {
        def i:int 0
        while (i < (array_length endX)) {
            def dx:double ((itemAt endX i) - px)
            def dy:double ((itemAt endY i) - py)
            if (((dx * dx) + (dy * dy)) < (near * near)) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; Where two segments properly cross, or an empty list. Touching at an
    ; endpoint is not a crossing, so the straddle test is strict on both sides.
    sfn crossingOf:[double] (ax:double ay:double bx:double by:double cx:double cy:double dx:double dy:double) {
        def out:[double]
        def d1:double (EdgeOverlap.cross3(cx cy dx dy ax ay))
        def d2:double (EdgeOverlap.cross3(cx cy dx dy bx by))
        def d3:double (EdgeOverlap.cross3(ax ay bx by cx cy))
        def d4:double (EdgeOverlap.cross3(ax ay bx by dx dy))
        def eps:double 0.001
        if ((d1 * d2) >= (0.0 - eps)) {
            return out
        }
        if ((d3 * d4) >= (0.0 - eps)) {
            return out
        }
        def denom:double (d1 - d2)
        if ((fabs denom) < 0.000001) {
            return out
        }
        def t:double (d1 / denom)
        push out (ax + ((bx - ax) * t))
        push out (ay + ((by - ay) * t))
        return out
    }

    sfn cross3:double (ax:double ay:double bx:double by:double px:double py:double) {
        return (((bx - ax) * (py - ay)) - ((by - ay) * (px - ax)))
    }

    sfn pairs:int (g:FlowGraph tol:double) {
        def segX1:[double]
        def segY1:[double]
        def segX2:[double]
        def segY2:[double]
        def owner:[int]
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            if (e.hidden == false) {
                if (e.sourceIndex >= 0) {
                    if (e.targetIndex >= 0) {
                        def p:EdgePath (EdgeRouter.route(g e))
                        p.flatten(1)
                        def n:int (p.pointCount())
                        def i:int 1
                        while (i < n) {
                            push segX1 (p.px((i - 1)))
                            push segY1 (p.py((i - 1)))
                            push segX2 (p.px(i))
                            push segY2 (p.py(i))
                            push owner k
                            i = (i + 1)
                        }
                    }
                }
            }
            k = (k + 1)
        }
        def total:int 0
        def m:int (array_length owner)
        def a:int 0
        while (a < m) {
            def b:int (a + 1)
            while (b < m) {
                if ((itemAt owner a) != (itemAt owner b)) {
                    if (EdgeOverlap.pairOverlaps(segX1 segY1 segX2 segY2 a b tol)) {
                        total = (total + 1)
                    }
                }
                b = (b + 1)
            }
            a = (a + 1)
        }
        return total
    }

    ; How many times an edge is drawn straight through a node it has nothing
    ; to do with. This is the number "routes around obstacles" means, and it is
    ; the one the dummy-node chains exist to bring down — the overlap count
    ; above says nothing about it.
    sfn nodeCrossings:int (g:FlowGraph) {
        def total:int 0
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            if (e.hidden == false) {
                if (e.sourceIndex >= 0) {
                    if (e.targetIndex >= 0) {
                        def p:EdgePath (EdgeRouter.route(g e))
                        p.flatten(4)
                        def i:int 0
                        while (i < (g.nodeCount())) {
                            def skip:boolean false
                            if (i == e.sourceIndex) { skip = true }
                            if (i == e.targetIndex) { skip = true }
                            if (skip == false) {
                                def nd:FlowNode (g.nodeAt(i))
                                if (EdgeOverlap.blocks(nd)) {
                                    if (EdgeOverlap.pathEntersRect(p nd)) {
                                        total = (total + 1)
                                    }
                                }
                            }
                            i = (i + 1)
                        }
                    }
                }
            }
            k = (k + 1)
        }
        return total
    }

    ; Segment against rectangle, properly. Sampling the flattened points was
    ; the obvious thing and it was wrong: flattening subdivides CURVES, so a
    ; straight run from one side of the diagram to the other is two points and
    ; neither of them is inside the box it goes through. The metric reported
    ; zero crossings for an edge drawn straight across two nodes.
    ; "Through the box", not "touching it". A route squeezed down a narrow
    ; corridor ends up drawn along a border, and a border is where the box
    ; stops — the same half-pixel the router's own clearance test allows, so
    ; the router and this meter agree on what counts as a crossing.
    ; A frame — a swimlane, a sub-flow box — is the paper the diagram is drawn
    ; on. Lines cross it because that is what it is for, and counting those
    ; would drown the count that matters in noise.
    sfn blocks:boolean (nd:FlowNode) {
        if nd.hidden {
            return false
        }
        return (nd.nodeType != "group")
    }

    sfn pathEntersRect:boolean (p:EdgePath nd:FlowNode) {
        def full:FlowRect (nd.rect())
        def eps:double 0.5
        def r:FlowRect (FlowRect.create((full.x + eps) (full.y + eps) (full.w - (eps * 2.0)) (full.h - (eps * 2.0))))
        def n:int (p.pointCount())
        def i:int 1
        while (i < n) {
            if (EdgeOverlap.segmentHitsRect((p.px((i - 1))) (p.py((i - 1))) (p.px(i)) (p.py(i)) r)) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; Liang-Barsky: clip the segment against the box's four slabs and see
    ; whether any of it survives.
    sfn segmentHitsRect:boolean (x1:double y1:double x2:double y2:double r:FlowRect) {
        def dx:double (x2 - x1)
        def dy:double (y2 - y1)
        def t0:double 0.0
        def t1:double 1.0
        def i:int 0
        while (i < 4) {
            def pv:double 0.0
            def qv:double 0.0
            if (i == 0) {
                pv = (0.0 - dx)
                qv = (x1 - r.x)
            }
            if (i == 1) {
                pv = dx
                qv = ((r.x + r.w) - x1)
            }
            if (i == 2) {
                pv = (0.0 - dy)
                qv = (y1 - r.y)
            }
            if (i == 3) {
                pv = dy
                qv = ((r.y + r.h) - y1)
            }
            if ((fabs pv) < 0.000001) {
                ; parallel to this slab: outside it means outside the box
                if (qv < 0.0) {
                    return false
                }
            } {
                def t:double (qv / pv)
                if (pv < 0.0) {
                    if (t > t1) {
                        return false
                    }
                    if (t > t0) {
                        t0 = t
                    }
                } {
                    if (t < t0) {
                        return false
                    }
                    if (t < t1) {
                        t1 = t
                    }
                }
            }
            i = (i + 1)
        }
        return (t0 < t1)
    }

    sfn pairOverlaps:boolean (x1:[double] y1:[double] x2:[double] y2:[double] a:int b:int tol:double) {
        def ax1:double (itemAt x1 a)
        def ay1:double (itemAt y1 a)
        def ax2:double (itemAt x2 a)
        def ay2:double (itemAt y2 a)
        def bx1:double (itemAt x1 b)
        def by1:double (itemAt y1 b)
        def bx2:double (itemAt x2 b)
        def by2:double (itemAt y2 b)
        def aVert:boolean ((fabs (ax2 - ax1)) < 0.5)
        def bVert:boolean ((fabs (bx2 - bx1)) < 0.5)
        def aHoriz:boolean ((fabs (ay2 - ay1)) < 0.5)
        def bHoriz:boolean ((fabs (by2 - by1)) < 0.5)
        if aVert {
            if bVert {
                if ((fabs (ax1 - bx1)) <= tol) {
                    return (EdgeLanes.spansOverlap((EdgeLanes.lower(ay1 ay2)) (EdgeLanes.upper(ay1 ay2)) (EdgeLanes.lower(by1 by2)) (EdgeLanes.upper(by1 by2))))
                }
            }
        }
        if aHoriz {
            if bHoriz {
                if ((fabs (ay1 - by1)) <= tol) {
                    return (EdgeLanes.spansOverlap((EdgeLanes.lower(ax1 ax2)) (EdgeLanes.upper(ax1 ax2)) (EdgeLanes.lower(bx1 bx2)) (EdgeLanes.upper(bx1 bx2))))
                }
            }
        }
        return false
    }
}

; ============================================================================
; LayeredLayout.rgr — a Sugiyama-style layered layout.
; ============================================================================
;
; A force layout is the right answer for an unknown graph and the wrong one for
; a database schema: nobody wants their tables arranged by simulated annealing.
; A schema has direction — a foreign key points from the dependent table to the
; one it depends on — and a layered layout is what makes that direction visible:
;
;        users
;          │
;     ┌────┴────┐
;     ↓         ↓
;   orders   profiles
;     │
;     ↓
; order_items
;
; This is the classic four-phase pipeline, in its honest small form:
;
;   1. break cycles          a DFS; back edges are reversed for layout only
;   2. assign layers         longest path from a source
;   3. order within layers   barycentre sweeps, which is the crossing reduction
;   4. assign coordinates    pack each layer, centre it on its neighbours
;
; No dummy-node chains for long edges yet, so an edge that spans four layers
; runs straight rather than being routed around what is in the way. That is the
; first thing to add here, and it is called out rather than hidden.
; ============================================================================

Import "../core/GraphModel.rgr"

class LayeredLayout {
    def graph:FlowGraph (new FlowGraph)
    ; "TB" top-to-bottom, "LR" left-to-right (the schema default).
    def direction:string "LR"
    def layerGap:double 120.0
    def nodeGap:double 32.0
    def sweeps:int 6
    def originX:double 0.0
    def originY:double 0.0

    ; per node
    def layerOf:[int]
    def orderOf:[int]
    ; adjacency, after cycle breaking
    def outHead:[int]
    def outNext:[int]
    def outTo:[int]
    def inHead:[int]
    def inNext:[int]
    def inFrom:[int]

    Constructor () {
    }

    sfn of:LayeredLayout (g:FlowGraph) {
        def l (new LayeredLayout)
        l.graph = g
        return l
    }

    fn run:void () {
        graph.reindex()
        this.buildAdjacency()
        this.assignLayers()
        this.orderLayers()
        this.assignCoordinates()
    }

    ; A pair of intrusive linked lists rather than arrays of arrays: one
    ; allocation per edge instead of one per node, and it compiles the same on
    ; every target.
    fn buildAdjacency:void () {
        clear outHead
        clear outNext
        clear outTo
        clear inHead
        clear inNext
        clear inFrom
        def n:int (graph.nodeCount())
        def i:int 0
        while (i < n) {
            push outHead -1
            push inHead -1
            i = (i + 1)
        }
        def reversed:[boolean] (this.findBackEdges())
        def k:int 0
        while (k < (graph.edgeCount())) {
            def e:FlowEdge (graph.edgeAt(k))
            if (e.sourceIndex >= 0) {
                if (e.targetIndex >= 0) {
                    def from:int e.sourceIndex
                    def to:int e.targetIndex
                    if (itemAt reversed k) {
                        from = e.targetIndex
                        to = e.sourceIndex
                    }
                    if (from != to) {
                        push outTo to
                        push outNext (itemAt outHead from)
                        set_at outHead from ((array_length outTo) - 1)
                        push inFrom from
                        push inNext (itemAt inHead to)
                        set_at inHead to ((array_length inFrom) - 1)
                    }
                }
            }
            k = (k + 1)
        }
    }

    ; Depth-first search over the raw edges; an edge back to a node still on
    ; the stack is a cycle edge, and layering cannot proceed with it forwards.
    fn findBackEdges:[boolean] () {
        def out:[boolean]
        def m:int (graph.edgeCount())
        def i:int 0
        while (i < m) {
            push out false
            i = (i + 1)
        }
        def n:int (graph.nodeCount())
        def state:[int]
        def j:int 0
        while (j < n) {
            push state 0
            j = (j + 1)
        }
        def s:int 0
        while (s < n) {
            if ((itemAt state s) == 0) {
                this.dfsMark(s state out)
            }
            s = (s + 1)
        }
        return out
    }

    fn dfsMark:void (v:int state:[int] out:[boolean]) {
        set_at state v 1
        def k:int 0
        while (k < (graph.edgeCount())) {
            def e:FlowEdge (graph.edgeAt(k))
            if (e.sourceIndex == v) {
                def t:int e.targetIndex
                if (t >= 0) {
                    def st:int (itemAt state t)
                    if (st == 1) {
                        set_at out k true
                    }
                    if (st == 0) {
                        this.dfsMark(t state out)
                    }
                }
            }
            k = (k + 1)
        }
        set_at state v 2
    }

    ; Longest path from a source. Iterating to a fixed point rather than a
    ; topological sort: the graph is already acyclic here, and the loop count
    ; is bounded by the node count, which is what makes it terminate on the
    ; graphs a schema produces.
    fn assignLayers:void () {
        clear layerOf
        def n:int (graph.nodeCount())
        def i:int 0
        while (i < n) {
            push layerOf 0
            i = (i + 1)
        }
        def changed:boolean true
        def guard:int 0
        while (changed) {
            changed = false
            guard = (guard + 1)
            if (guard > (n + 2)) {
                return
            }
            def v:int 0
            while (v < n) {
                def cur:int (itemAt layerOf v)
                def at:int (itemAt outHead v)
                while (at >= 0) {
                    def to:int (itemAt outTo at)
                    def want:int (cur + 1)
                    if ((itemAt layerOf to) < want) {
                        set_at layerOf to want
                        changed = true
                    }
                    at = (itemAt outNext at)
                }
                v = (v + 1)
            }
        }
    }

    fn layerCount:int () {
        def m:int 0
        def i:int 0
        while (i < (array_length layerOf)) {
            def l:int (itemAt layerOf i)
            if (l > m) {
                m = l
            }
            i = (i + 1)
        }
        return (m + 1)
    }

    ; Barycentre ordering: sort each layer by the mean position of the nodes it
    ; is joined to in the layer before (then after, alternating). It is the
    ; cheapest crossing reduction that actually works, and it is what dagre and
    ; Graphviz both start from.
    fn orderLayers:void () {
        clear orderOf
        def n:int (graph.nodeCount())
        def counters:[int]
        def lc:int (this.layerCount())
        def i:int 0
        while (i < lc) {
            push counters 0
            i = (i + 1)
        }
        def v:int 0
        while (v < n) {
            def l:int (itemAt layerOf v)
            push orderOf (itemAt counters l)
            set_at counters l ((itemAt counters l) + 1)
            v = (v + 1)
        }
        def sweep:int 0
        while (sweep < sweeps) {
            def down:boolean true
            if ((sweep % 2) == 1) {
                down = false
            }
            def l2:int 0
            while (l2 < lc) {
                this.sortLayer(l2 down)
                l2 = (l2 + 1)
            }
            sweep = (sweep + 1)
        }
    }

    fn sortLayer:void (layer:int useIncoming:boolean) {
        def members:[int]
        def keys:[double]
        def v:int 0
        while (v < (graph.nodeCount())) {
            if ((itemAt layerOf v) == layer) {
                push members v
                push keys (this.barycentre(v useIncoming))
                v = (v + 1)
                continue
            }
            v = (v + 1)
        }
        def n:int (array_length members)
        ; Insertion sort: a layer is small, and a stable sort keeps nodes with
        ; no neighbours where the previous sweep left them.
        def i:int 1
        while (i < n) {
            def kv:double (itemAt keys i)
            def mv:int (itemAt members i)
            def j:int (i - 1)
            def at:int 0
            def settled:boolean false
            while (j >= 0) {
                if (settled == false) {
                    if ((itemAt keys j) > kv) {
                        set_at keys (j + 1) (itemAt keys j)
                        set_at members (j + 1) (itemAt members j)
                        j = (j - 1)
                    } {
                        ; The insertion point, NOT a signal to keep looping:
                        ; setting `j = -1` here to break lost it, every element
                        ; was inserted at 0, and two nodes in one layer came out
                        ; with the same order — so one of them was never placed
                        ; and drew on top of another table.
                        at = (j + 1)
                        settled = true
                        j = -1
                    }
                }
            }
            if (settled == false) {
                at = 0
            }
            set_at keys at kv
            set_at members at mv
            i = (i + 1)
        }
        def k:int 0
        while (k < n) {
            set_at orderOf (itemAt members k) k
            k = (k + 1)
        }
    }

    fn barycentre:double (v:int useIncoming:boolean) {
        def total:double 0.0
        def count:int 0
        def at:int -1
        if useIncoming {
            at = (itemAt inHead v)
        } {
            at = (itemAt outHead v)
        }
        while (at >= 0) {
            def other:int 0
            if useIncoming {
                other = (itemAt inFrom at)
                at = (itemAt inNext at)
            } {
                other = (itemAt outTo at)
                at = (itemAt outNext at)
            }
            total = (total + (to_double (itemAt orderOf other)))
            count = (count + 1)
        }
        if (count == 0) {
            return (to_double (itemAt orderOf v))
        }
        return (total / (to_double count))
    }

    ; Pack each layer along the cross axis, then centre the layers on each
    ; other so the widest one does not push everything to one side.
    fn assignCoordinates:void () {
        def lc:int (this.layerCount())
        def n:int (graph.nodeCount())
        def layerExtent:[double]
        def i:int 0
        while (i < lc) {
            push layerExtent 0.0
            i = (i + 1)
        }
        ; how deep each layer is on the main axis, and how long on the cross one
        def layerDepth:[double]
        def d:int 0
        while (d < lc) {
            push layerDepth 0.0
            d = (d + 1)
        }
        def v:int 0
        while (v < n) {
            def nd:FlowNode (graph.nodeAt(v))
            def l:int (itemAt layerOf v)
            def cross:double nd.height
            def main:double nd.width
            if (direction == "TB") {
                cross = nd.width
                main = nd.height
            }
            def sofar:double (itemAt layerExtent l)
            if (sofar > 0.0) {
                sofar = (sofar + nodeGap)
            }
            set_at layerExtent l (sofar + cross)
            if (main > (itemAt layerDepth l)) {
                set_at layerDepth l main
            }
            v = (v + 1)
        }
        def widest:double 0.0
        def w:int 0
        while (w < lc) {
            def ex:double (itemAt layerExtent w)
            if (ex > widest) {
                widest = ex
            }
            w = (w + 1)
        }
        ; running offset per layer, filled in order
        def cursor:[double]
        def c:int 0
        while (c < lc) {
            def ex2:double (itemAt layerExtent c)
            push cursor ((widest - ex2) * 0.5)
            c = (c + 1)
        }
        def mainOffset:[double]
        def acc:double 0.0
        def m:int 0
        while (m < lc) {
            push mainOffset acc
            acc = ((acc + (itemAt layerDepth m)) + layerGap)
            m = (m + 1)
        }
        ; Place in (layer, order) sequence so the packing follows the ordering.
        ; Bucketed by layer rather than "search every node for the one whose
        ; rank is `slot`": that was three nested loops over the node list, and
        ; a 500-table schema spent more time deciding the order to place in
        ; than it did on the whole force simulation.
        def sequence:[int] (this.placementOrder(lc))
        def slot:int 0
        while (slot < n) {
            def target:int (itemAt sequence slot)
            if (target >= 0) {
                def nd2:FlowNode (graph.nodeAt(target))
                def l2:int (itemAt layerOf target)
                def cross2:double nd2.height
                if (direction == "TB") {
                    cross2 = nd2.width
                }
                def at:double (itemAt cursor l2)
                set_at cursor l2 ((at + cross2) + nodeGap)
                def mainAt:double (itemAt mainOffset l2)
                if (direction == "TB") {
                    nd2.x = (originX + at)
                    nd2.y = (originY + mainAt)
                } {
                    nd2.x = (originX + mainAt)
                    nd2.y = (originY + at)
                }
                nd2.syncFromModel()
                nd2.placed = true
            }
            slot = (slot + 1)
        }
        this.faceNeighbours()
    }

    ; A stable global sequence: layer first, order within the layer second.
    ; One counting pass and one placement pass, both linear.
    fn placementOrder:[int] (lc:int) {
        def n:int (graph.nodeCount())
        def counts:[int]
        def i:int 0
        while (i < lc) {
            push counts 0
            i = (i + 1)
        }
        def v:int 0
        while (v < n) {
            def l:int (itemAt layerOf v)
            set_at counts l ((itemAt counts l) + 1)
            v = (v + 1)
        }
        def base:[int]
        def acc:int 0
        def k:int 0
        while (k < lc) {
            push base acc
            acc = (acc + (itemAt counts k))
            k = (k + 1)
        }
        def out:[int]
        def j:int 0
        while (j < n) {
            push out -1
            j = (j + 1)
        }
        def u:int 0
        while (u < n) {
            def lu:int (itemAt layerOf u)
            def slot:int ((itemAt base lu) + (itemAt orderOf u))
            if (slot < 0) {
                slot = 0
            }
            ; A duplicate order would silently drop a node from the layout, and
            ; a table that is never placed is a table drawn on top of another
            ; one. Take the next free slot instead of losing it.
            while (slot < n) {
                if ((itemAt out slot) < 0) {
                    break
                }
                slot = (slot + 1)
            }
            if (slot < n) {
                set_at out slot u
            }
            u = (u + 1)
        }
        return out
    }

    ; Point each node's default handles the way the layout runs, so an edge
    ; leaves the side that faces where it is going.
    fn faceNeighbours:void () {
        def i:int 0
        while (i < (graph.nodeCount())) {
            def n:FlowNode (graph.nodeAt(i))
            if (direction == "TB") {
                n.sourcePosition = 2
                n.targetPosition = 0
            } {
                n.sourcePosition = 1
                n.targetPosition = 3
            }
            i = (i + 1)
        }
    }
}

; ============================================================================
; EdgeRouter.rgr — where an edge goes, and how it is decorated when it lands.
; ============================================================================
;
; Two things live here, deliberately apart:
;
;   ROUTING      source point + side → target point + side → a path
;   DECORATION   what is drawn at the ends of that path
;
; They are separate because a foreign key is one relationship and three
; pictures: crow's foot, UML multiplicity, or a plain arrow. Splitting the
; semantics from the ornament means a diagram can switch notation without the
; model changing a byte — which is exactly what a schema viewer is asked to do.
;
; The path is built once and consumed three ways: as an SVG `d` string for the
; EVG element tree (and from there PDF and HTML), as a flattened polyline for
; the GPU and for hit testing, and as a length/mid-point for placing a label.
; One construction, so the PDF and the editor cannot draw different lines.
;
; The curve maths is React Flow's, function for function: `getBezierPath`'s
; control-point offset (including the `sqrt` fallback when the target is behind
; the source), and an orthogonal router with rounded corners in the shape of
; `getSmoothStepPath`.
; ============================================================================

Import "GraphModel.rgr"

; One segment of a path. `kind`: 0 move, 1 line, 2 cubic, 3 quadratic.
class EdgeSeg {
    def kind:int 0
    def x:double 0.0
    def y:double 0.0
    def c1x:double 0.0
    def c1y:double 0.0
    def c2x:double 0.0
    def c2y:double 0.0

    Constructor () {
    }
}

class EdgePath {
    def segs:[EdgeSeg]
    ; Filled by `flatten`, and by everything that needs a point rather than a
    ; curve: hit testing, GPU strokes, arrow angles.
    def flat:[double]
    def flatSteps:int 0

    Constructor () {
    }

    fn moveTo:void (x:double y:double) {
        def s (new EdgeSeg)
        s.kind = 0
        s.x = x
        s.y = y
        push segs s
    }

    fn lineTo:void (x:double y:double) {
        def s (new EdgeSeg)
        s.kind = 1
        s.x = x
        s.y = y
        push segs s
    }

    fn curveTo:void (c1x:double c1y:double c2x:double c2y:double x:double y:double) {
        def s (new EdgeSeg)
        s.kind = 2
        s.c1x = c1x
        s.c1y = c1y
        s.c2x = c2x
        s.c2y = c2y
        s.x = x
        s.y = y
        push segs s
    }

    fn quadTo:void (cx:double cy:double x:double y:double) {
        def s (new EdgeSeg)
        s.kind = 3
        s.c1x = cx
        s.c1y = cy
        s.x = x
        s.y = y
        push segs s
    }

    fn segCount:int () {
        return (array_length segs)
    }

    ; The `d` attribute an EVG `<path>` takes — the export path.
    fn svgPath:string () {
        def out:string ""
        def i:int 0
        while (i < (array_length segs)) {
            def s:EdgeSeg (itemAt segs i)
            if (i > 0) {
                out = (out + " ")
            }
            if (s.kind == 0) {
                out = (out + "M " + (EdgePath.n(s.x)) + " " + (EdgePath.n(s.y)))
            }
            if (s.kind == 1) {
                out = (out + "L " + (EdgePath.n(s.x)) + " " + (EdgePath.n(s.y)))
            }
            if (s.kind == 2) {
                out = (out + "C " + (EdgePath.n(s.c1x)) + " " + (EdgePath.n(s.c1y)))
                out = (out + " " + (EdgePath.n(s.c2x)) + " " + (EdgePath.n(s.c2y)))
                out = (out + " " + (EdgePath.n(s.x)) + " " + (EdgePath.n(s.y)))
            }
            if (s.kind == 3) {
                out = (out + "Q " + (EdgePath.n(s.c1x)) + " " + (EdgePath.n(s.c1y)))
                out = (out + " " + (EdgePath.n(s.x)) + " " + (EdgePath.n(s.y)))
            }
            i = (i + 1)
        }
        return out
    }

    ; Two decimals is plenty for a diagram and keeps an exported path readable.
    sfn n:string (v:double) {
        def neg:boolean (v < 0.0)
        def av:double v
        if neg {
            av = (0.0 - v)
        }
        def scaled:int (to_int ((av * 100.0) + 0.5))
        def whole:int (idiv scaled 100)
        def frac:int (scaled - (whole * 100))
        def fs:string (to_string frac)
        if (frac < 10) {
            fs = ("0" + fs)
        }
        def out:string ((to_string whole) + "." + fs)
        if neg {
            if (scaled > 0) {
                out = ("-" + out)
            }
        }
        return out
    }

    ; Flatten to a polyline. `steps` is the subdivision of each curve; the
    ; renderer picks it from the zoom, so a line drawn at 4x is not a decagon.
    fn flatten:[double] (steps:int) {
        clear flat
        flatSteps = steps
        def cx:double 0.0
        def cy:double 0.0
        def i:int 0
        while (i < (array_length segs)) {
            def s:EdgeSeg (itemAt segs i)
            if (s.kind == 0) {
                push flat s.x
                push flat s.y
                cx = s.x
                cy = s.y
            }
            if (s.kind == 1) {
                push flat s.x
                push flat s.y
                cx = s.x
                cy = s.y
            }
            if (s.kind == 2) {
                def k:int 1
                while (k <= steps) {
                    def t:double ((to_double k) / (to_double steps))
                    def mt:double (1.0 - t)
                    def a:double ((mt * mt) * mt)
                    def b:double (((3.0 * mt) * mt) * t)
                    def c:double (((3.0 * mt) * t) * t)
                    def d:double ((t * t) * t)
                    def px:double ((((a * cx) + (b * s.c1x)) + (c * s.c2x)) + (d * s.x))
                    def py:double ((((a * cy) + (b * s.c1y)) + (c * s.c2y)) + (d * s.y))
                    push flat px
                    push flat py
                    k = (k + 1)
                }
                cx = s.x
                cy = s.y
            }
            if (s.kind == 3) {
                def k2:int 1
                while (k2 <= steps) {
                    def t2:double ((to_double k2) / (to_double steps))
                    def mt2:double (1.0 - t2)
                    def a2:double (mt2 * mt2)
                    def b2:double ((2.0 * mt2) * t2)
                    def c2:double (t2 * t2)
                    def px2:double (((a2 * cx) + (b2 * s.c1x)) + (c2 * s.x))
                    def py2:double (((a2 * cy) + (b2 * s.c1y)) + (c2 * s.y))
                    push flat px2
                    push flat py2
                    k2 = (k2 + 1)
                }
                cx = s.x
                cy = s.y
            }
            i = (i + 1)
        }
        return flat
    }

    fn pointCount:int () {
        return (idiv (array_length flat) 2)
    }

    fn px:double (i:int) {
        return (itemAt flat (i * 2))
    }

    fn py:double (i:int) {
        def at:int ((i * 2) + 1)
        return (itemAt flat at)
    }

    fn totalLength:double () {
        def total:double 0.0
        def n:int (this.pointCount())
        def i:int 1
        while (i < n) {
            def dx:double ((this.px(i)) - (this.px((i - 1))))
            def dy:double ((this.py(i)) - (this.py((i - 1))))
            total = (total + (sqrt ((dx * dx) + (dy * dy))))
            i = (i + 1)
        }
        return total
    }

    ; The point half way along, where an edge label goes.
    fn midX:double () {
        def n:int (this.pointCount())
        if (n == 0) {
            return 0.0
        }
        def half:int (idiv n 2)
        return (this.px(half))
    }

    fn midY:double () {
        def n:int (this.pointCount())
        if (n == 0) {
            return 0.0
        }
        def half:int (idiv n 2)
        return (this.py(half))
    }

    ; Distance from a point to the polyline — edge hit testing, which React
    ; Flow gets from the browser's `pointer-events` on a fat invisible stroke
    ; and a renderer without a DOM has to compute.
    fn distanceTo:double (qx:double qy:double) {
        def best:double 1000000000.0
        def n:int (this.pointCount())
        if (n == 0) {
            return best
        }
        def i:int 1
        while (i < n) {
            def x1:double (this.px((i - 1)))
            def y1:double (this.py((i - 1)))
            def x2:double (this.px(i))
            def y2:double (this.py(i))
            def dx:double (x2 - x1)
            def dy:double (y2 - y1)
            def len2:double ((dx * dx) + (dy * dy))
            def t:double 0.0
            if (len2 > 0.0) {
                t = ((((qx - x1) * dx) + ((qy - y1) * dy)) / len2)
                if (t < 0.0) { t = 0.0 }
                if (t > 1.0) { t = 1.0 }
            }
            def cxp:double (x1 + (dx * t))
            def cyp:double (y1 + (dy * t))
            def ex:double (qx - cxp)
            def ey:double (qy - cyp)
            def d:double (sqrt ((ex * ex) + (ey * ey)))
            if (d < best) {
                best = d
            }
            i = (i + 1)
        }
        return best
    }

    ; The direction the path arrives from, in degrees, for orienting a marker.
    fn endAngle:boolean () {
        return true
    }

    fn angleAtEnd:double () {
        def n:int (this.pointCount())
        if (n < 2) {
            return 0.0
        }
        def dx:double ((this.px((n - 1))) - (this.px((n - 2))))
        def dy:double ((this.py((n - 1))) - (this.py((n - 2))))
        return (atan2 dy dx)
    }

    fn angleAtStart:double () {
        def n:int (this.pointCount())
        if (n < 2) {
            return 0.0
        }
        def dx:double ((this.px(0)) - (this.px(1)))
        def dy:double ((this.py(0)) - (this.py(1)))
        return (atan2 dy dx)
    }
}

; ---------------------------------------------------------------------------
; Router
; ---------------------------------------------------------------------------
class EdgeRouter {
    ; React Flow's `calculateControlOffset`. The `sqrt` branch is what stops an
    ; edge that goes backwards from folding into a hairpin: the control point
    ; grows with the square root of the overlap, not linearly with it.
    sfn controlOffset:double (distance:double curvature:double) {
        if (distance >= 0.0) {
            return (0.5 * distance)
        }
        def d:double (0.0 - distance)
        def r:double (sqrt d)
        return (((curvature * 25.0) * r))
    }

    sfn controlX:double (side:int x1:double y1:double x2:double y2:double c:double) {
        if (side == 3) {
            def off:double (EdgeRouter.controlOffset((x1 - x2) c))
            return (x1 - off)
        }
        if (side == 1) {
            def off2:double (EdgeRouter.controlOffset((x2 - x1) c))
            return (x1 + off2)
        }
        return x1
    }

    sfn controlY:double (side:int x1:double y1:double x2:double y2:double c:double) {
        if (side == 0) {
            def off:double (EdgeRouter.controlOffset((y1 - y2) c))
            return (y1 - off)
        }
        if (side == 2) {
            def off2:double (EdgeRouter.controlOffset((y2 - y1) c))
            return (y1 + off2)
        }
        return y1
    }

    sfn bezier:EdgePath (x1:double y1:double s1:int x2:double y2:double s2:int curvature:double) {
        def p (new EdgePath)
        def c1x:double (EdgeRouter.controlX(s1 x1 y1 x2 y2 curvature))
        def c1y:double (EdgeRouter.controlY(s1 x1 y1 x2 y2 curvature))
        def c2x:double (EdgeRouter.controlX(s2 x2 y2 x1 y1 curvature))
        def c2y:double (EdgeRouter.controlY(s2 x2 y2 x1 y1 curvature))
        p.moveTo(x1 y1)
        p.curveTo(c1x c1y c2x c2y x2 y2)
        return p
    }

    sfn straight:EdgePath (x1:double y1:double x2:double y2:double) {
        def p (new EdgePath)
        p.moveTo(x1 y1)
        p.lineTo(x2 y2)
        return p
    }

    ; The orthogonal corner list. This is a faithful port of React Flow's
    ; `getPoints`, function for function, because the parity harness compares
    ; against `getSmoothStepPath` itself and an "in the shape of" version scored
    ; 187/320: the two agreed whenever the handles faced each other and diverged
    ; by up to 311 px whenever they did not. The rules that matter are the ones
    ; that are not obvious —
    ;
    ;   * the split is chosen by whether the source leaves ALONG the direction
    ;     of travel or against it, which is what stops an edge doubling back
    ;     across its own node;
    ;   * two handles on the same side that are closer than the offset get a
    ;     gap offset, or the added corner lands on top of the gapped endpoint;
    ;   * mixed positions (Right → Bottom) flip which corner is used, from the
    ;     sign of the perpendicular difference.
    ;
    ; `stepPosition` is where along the run the perpendicular leg goes: 0.5 is
    ; React Flow's default and the only value the router uses today.
    sfn stepPoints:[double] (x1:double y1:double s1:int x2:double y2:double s2:int offset:double) {
        return (EdgeRouter.stepPointsAt(x1 y1 s1 x2 y2 s2 offset false 0.0 false 0.0))
    }

    ; The same, with the turn placed explicitly. React Flow's
    ; `getSmoothStepPath` takes a `center` for exactly this reason, and it is
    ; what lets `EdgeLanes` give each edge crossing a corridor its own track
    ; instead of nine edges all turning at the same midpoint.
    sfn stepPointsAt:[double] (x1:double y1:double s1:int x2:double y2:double s2:int offset:double hasCx:boolean cx:double hasCy:boolean cy:double) {
        def sdx:double (FlowPosition.normalX(s1))
        def sdy:double (FlowPosition.normalY(s1))
        def tdx:double (FlowPosition.normalX(s2))
        def tdy:double (FlowPosition.normalY(s2))
        def sgx:double (x1 + (sdx * offset))
        def sgy:double (y1 + (sdy * offset))
        def tgx:double (x2 + (tdx * offset))
        def tgy:double (y2 + (tdy * offset))
        def stepPosition:double 0.5

        ; getDirection: horizontal handles decide on x, vertical ones on y.
        def horizontal:boolean false
        if (s1 == 1) { horizontal = true }
        if (s1 == 3) { horizontal = true }
        def currDir:double -1.0
        if horizontal {
            if (sgx < tgx) { currDir = 1.0 }
        } {
            if (sgy < tgy) { currDir = 1.0 }
        }
        def sourceDirA:double sdy
        def targetDirA:double tdy
        if horizontal {
            sourceDirA = sdx
            targetDirA = tdx
        }

        def px0:double 0.0
        def py0:double 0.0
        def px1:double 0.0
        def py1:double 0.0
        def pointCount:int 1
        def sourceGapOffX:double 0.0
        def sourceGapOffY:double 0.0
        def targetGapOffX:double 0.0
        def targetGapOffY:double 0.0

        if ((sourceDirA * targetDirA) == -1.0) {
            ; --- opposite handles: one perpendicular leg between them --------
            def centerX:double ((sgx + tgx) * 0.5)
            def centerY:double ((sgy + tgy) * 0.5)
            if horizontal {
                centerX = (sgx + ((tgx - sgx) * stepPosition))
            } {
                centerY = (sgy + ((tgy - sgy) * stepPosition))
            }
            if hasCx {
                centerX = cx
            }
            if hasCy {
                centerY = cy
            }
            def useVerticalSplit:boolean false
            if (sourceDirA == currDir) {
                if horizontal { useVerticalSplit = true }
            } {
                if (horizontal == false) { useVerticalSplit = true }
            }
            if useVerticalSplit {
                px0 = centerX
                py0 = sgy
                px1 = centerX
                py1 = tgy
            } {
                px0 = sgx
                py0 = centerY
                px1 = tgx
                py1 = centerY
            }
            pointCount = 2
        } {
            ; --- same or mixed handles: a single corner ----------------------
            ; sourceTarget takes x from the source and y from the target;
            ; targetSource is the other one.
            def takeSourceTarget:boolean true
            if horizontal {
                if (sdx == currDir) { takeSourceTarget = false }
            } {
                if (sdy != currDir) { takeSourceTarget = false }
            }
            if (s1 == s2) {
                def diff:double (fabs (y1 - y2))
                if horizontal {
                    diff = (fabs (x1 - x2))
                }
                if (diff <= offset) {
                    def gapOffset:double (offset - diff)
                    def limit:double (offset - 1.0)
                    if (limit < gapOffset) { gapOffset = limit }
                    if (sourceDirA == currDir) {
                        if horizontal {
                            def sign:double 1.0
                            if (sgx > x1) { sign = -1.0 }
                            sourceGapOffX = (sign * gapOffset)
                        } {
                            def signY:double 1.0
                            if (sgy > y1) { signY = -1.0 }
                            sourceGapOffY = (signY * gapOffset)
                        }
                    } {
                        if horizontal {
                            def tsign:double 1.0
                            if (tgx > x2) { tsign = -1.0 }
                            targetGapOffX = (tsign * gapOffset)
                        } {
                            def tsignY:double 1.0
                            if (tgy > y2) { tsignY = -1.0 }
                            targetGapOffY = (tsignY * gapOffset)
                        }
                    }
                }
            }
            if (s1 != s2) {
                ; Mixed positions (Right -> Bottom and friends): which corner
                ; reads better depends on the sign of the perpendicular gap.
                def targetDirOpp:double tdy
                if (horizontal == false) { targetDirOpp = tdx }
                def isSameDir:boolean (sourceDirA == targetDirOpp)
                def sourceOppo:double sgy
                def targetOppo:double tgy
                if (horizontal == false) {
                    sourceOppo = sgx
                    targetOppo = tgx
                }
                def gt:boolean (sourceOppo > targetOppo)
                def lt:boolean (sourceOppo < targetOppo)
                def flip:boolean false
                if (sourceDirA == 1.0) {
                    if (isSameDir == false) {
                        if gt { flip = true }
                    } {
                        if lt { flip = true }
                    }
                } {
                    if (isSameDir == false) {
                        if lt { flip = true }
                    } {
                        if gt { flip = true }
                    }
                }
                if flip {
                    takeSourceTarget = horizontal
                }
            }
            if takeSourceTarget {
                px0 = sgx
                py0 = tgy
            } {
                px0 = tgx
                py0 = sgy
            }
            pointCount = 1
        }

        def gsx:double (sgx + sourceGapOffX)
        def gsy:double (sgy + sourceGapOffY)
        def gtx:double (tgx + targetGapOffX)
        def gty:double (tgy + targetGapOffY)

        def pts:[double]
        push pts x1
        push pts y1
        ; The gapped endpoints are only added when they differ from the corner
        ; they lead to; a duplicate point there confuses the bend that follows.
        def sameStart:boolean false
        if (gsx == px0) {
            if (gsy == py0) { sameStart = true }
        }
        if (sameStart == false) {
            push pts gsx
            push pts gsy
        }
        push pts px0
        push pts py0
        if (pointCount == 2) {
            push pts px1
            push pts py1
        }
        def lastX:double px0
        def lastY:double py0
        if (pointCount == 2) {
            lastX = px1
            lastY = py1
        }
        def sameEnd:boolean false
        if (gtx == lastX) {
            if (gty == lastY) { sameEnd = true }
        }
        if (sameEnd == false) {
            push pts gtx
            push pts gty
        }
        push pts x2
        push pts y2
        return (EdgeRouter.dedupe(pts))
    }

    ; Consecutive identical corners make a zero-length segment, which turns
    ; into a NaN normal in the stroke tessellator and a missing edge on the GPU.
    ; React Flow can leave them in — its `getBend` degenerates harmlessly — but
    ; a GPU backend cannot.
    sfn dedupe:[double] (pts:[double]) {
        def out:[double]
        def n:int (idiv (array_length pts) 2)
        def i:int 0
        while (i < n) {
            def x:double (itemAt pts (i * 2))
            def yat:int ((i * 2) + 1)
            def y:double (itemAt pts yat)
            def keep:boolean true
            if ((array_length out) >= 2) {
                def lx:double (itemAt out ((array_length out) - 2))
                def ly:double (itemAt out ((array_length out) - 1))
                def dx:double (x - lx)
                def dy:double (y - ly)
                def adx:double (fabs dx)
                def ady:double (fabs dy)
                if (adx < 0.01) {
                    if (ady < 0.01) {
                        keep = false
                    }
                }
            }
            if keep {
                push out x
                push out y
            }
            i = (i + 1)
        }
        return out
    }

    ; Where React Flow puts the label on a stepped edge: the middle of the
    ; perpendicular leg when the handles face each other, and the middle of the
    ; longest segment otherwise.
    sfn stepLabelX:double (x1:double y1:double s1:int x2:double y2:double s2:int offset:double) {
        def pts:[double] (EdgeRouter.stepPoints(x1 y1 s1 x2 y2 s2 offset))
        return (EdgeRouter.labelOf(pts x1 y1 s1 x2 y2 s2 offset true))
    }

    sfn stepLabelY:double (x1:double y1:double s1:int x2:double y2:double s2:int offset:double) {
        def pts:[double] (EdgeRouter.stepPoints(x1 y1 s1 x2 y2 s2 offset))
        return (EdgeRouter.labelOf(pts x1 y1 s1 x2 y2 s2 offset false))
    }

    sfn labelOf:double (pts:[double] x1:double y1:double s1:int x2:double y2:double s2:int offset:double wantX:boolean) {
        def sdx:double (FlowPosition.normalX(s1))
        def sdy:double (FlowPosition.normalY(s1))
        def tdx:double (FlowPosition.normalX(s2))
        def tdy:double (FlowPosition.normalY(s2))
        def sgx:double (x1 + (sdx * offset))
        def sgy:double (y1 + (sdy * offset))
        def tgx:double (x2 + (tdx * offset))
        def tgy:double (y2 + (tdy * offset))
        def horizontal:boolean false
        if (s1 == 1) { horizontal = true }
        if (s1 == 3) { horizontal = true }
        def sourceDirA:double sdy
        def targetDirA:double tdy
        if horizontal {
            sourceDirA = sdx
            targetDirA = tdx
        }
        if ((sourceDirA * targetDirA) == -1.0) {
            if wantX {
                if horizontal {
                    return (sgx + ((tgx - sgx) * 0.5))
                }
                return ((sgx + tgx) * 0.5)
            }
            if horizontal {
                return ((sgy + tgy) * 0.5)
            }
            return (sgy + ((tgy - sgy) * 0.5))
        }
        ; The single corner is the second-to-last interior point; React Flow
        ; measures both spans from it and labels the longer one.
        def n:int (idiv (array_length pts) 2)
        if (n < 3) {
            if wantX {
                return ((x1 + x2) * 0.5)
            }
            return ((y1 + y2) * 0.5)
        }
        def cornerX:double 0.0
        def cornerY:double 0.0
        def i:int 1
        while (i < (n - 1)) {
            def cx:double (itemAt pts (i * 2))
            def cyAt:int ((i * 2) + 1)
            def cy:double (itemAt pts cyAt)
            def isGapS:boolean false
            if (cx == sgx) {
                if (cy == sgy) { isGapS = true }
            }
            def isGapT:boolean false
            if (cx == tgx) {
                if (cy == tgy) { isGapT = true }
            }
            if (isGapS == false) {
                if (isGapT == false) {
                    cornerX = cx
                    cornerY = cy
                    i = n
                }
            }
            i = (i + 1)
        }
        def maxX:double (fabs (sgx - cornerX))
        def altX:double (fabs (tgx - cornerX))
        if (altX > maxX) { maxX = altX }
        def maxY:double (fabs (sgy - cornerY))
        def altY:double (fabs (tgy - cornerY))
        if (altY > maxY) { maxY = altY }
        if (maxX >= maxY) {
            if wantX {
                return ((sgx + tgx) * 0.5)
            }
            return cornerY
        }
        if wantX {
            return cornerX
        }
        return ((sgy + tgy) * 0.5)
    }

    sfn step:EdgePath (x1:double y1:double s1:int x2:double y2:double s2:int offset:double) {
        return (EdgeRouter.stepAt(x1 y1 s1 x2 y2 s2 offset false 0.0 false 0.0))
    }

    sfn stepAt:EdgePath (x1:double y1:double s1:int x2:double y2:double s2:int offset:double hasCx:boolean cx:double hasCy:boolean cy:double) {
        def pts:[double] (EdgeRouter.stepPointsAt(x1 y1 s1 x2 y2 s2 offset hasCx cx hasCy cy))
        def p (new EdgePath)
        def n:int (idiv (array_length pts) 2)
        def i:int 0
        while (i < n) {
            def x:double (itemAt pts (i * 2))
            def yat:int ((i * 2) + 1)
            def y:double (itemAt pts yat)
            if (i == 0) {
                p.moveTo(x y)
            } {
                p.lineTo(x y)
            }
            i = (i + 1)
        }
        return p
    }

    ; The same corners, with each turn replaced by a quadratic — React Flow's
    ; `getBend`, whose radius shrinks when the two legs are too short for it.
    sfn smoothStep:EdgePath (x1:double y1:double s1:int x2:double y2:double s2:int offset:double radius:double) {
        return (EdgeRouter.smoothStepAt(x1 y1 s1 x2 y2 s2 offset radius false 0.0 false 0.0))
    }

    sfn smoothStepAt:EdgePath (x1:double y1:double s1:int x2:double y2:double s2:int offset:double radius:double hasCx:boolean cx:double hasCy:boolean cy:double) {
        def pts:[double] (EdgeRouter.stepPointsAt(x1 y1 s1 x2 y2 s2 offset hasCx cx hasCy cy))
        return (EdgeRouter.bendPath(pts radius))
    }

    ; Consecutive duplicate corners, dropped. Every producer of a corner list
    ; needs this and each of them used to carry its own copy.
    sfn dropCollinear:[double] (pts:[double]) {
        def out:[double]
        def n:int (idiv (array_length pts) 2)
        def i:int 0
        while (i < n) {
            def x:double (itemAt pts (i * 2))
            def yat:int ((i * 2) + 1)
            def y:double (itemAt pts yat)
            def keep:boolean true
            if ((array_length out) >= 2) {
                def lx:double (itemAt out ((array_length out) - 2))
                def ly:double (itemAt out ((array_length out) - 1))
                if ((fabs (x - lx)) < 0.01) {
                    if ((fabs (y - ly)) < 0.01) {
                        keep = false
                    }
                }
            }
            if keep {
                push out x
                push out y
            }
            i = (i + 1)
        }
        return out
    }

    ; Collapse a straight run of corners into its two ends. A stepped route
    ; often emits the port stub and the run that follows it as two separate
    ; segments even though they point the same way, and a reader who grabs
    ; "the middle segment" of such a pair would be grabbing half of a straight
    ; line — sliding it across would leave the other half behind, diagonally.
    ; Corners that turn are kept exactly; only the ones that do not are lost.
    sfn mergeRuns:[double] (pts:[double]) {
        def compact:[double] (EdgeRouter.dropCollinear(pts))
        def out:[double]
        def n:int (idiv (array_length compact) 2)
        if (n < 3) {
            return compact
        }
        push out (itemAt compact 0)
        push out (itemAt compact 1)
        def i:int 1
        while (i < (n - 1)) {
            def px:double (itemAt out ((array_length out) - 2))
            def py:double (itemAt out ((array_length out) - 1))
            def cx:double (itemAt compact (i * 2))
            def cyAt:int ((i * 2) + 1)
            def cy:double (itemAt compact cyAt)
            def nx:double (itemAt compact ((i + 1) * 2))
            def nyAt:int (((i + 1) * 2) + 1)
            def ny:double (itemAt compact nyAt)
            def turns:boolean true
            if ((fabs (cx - px)) < 0.01) {
                if ((fabs (nx - cx)) < 0.01) {
                    turns = false
                }
            }
            if ((fabs (cy - py)) < 0.01) {
                if ((fabs (ny - cy)) < 0.01) {
                    turns = false
                }
            }
            if turns {
                push out cx
                push out cy
            }
            i = (i + 1)
        }
        push out (itemAt compact ((n - 1) * 2))
        def lastAt:int (((n - 1) * 2) + 1)
        push out (itemAt compact lastAt)
        return out
    }

    ; A corner list, turned into a path with the turns rounded. React Flow's
    ; `getBend`, and the one place it lives: the stepped router, the corridor
    ; router and the layered layout's routed edges all hand their corners here
    ; rather than each rounding them slightly differently.
    sfn bendPath:EdgePath (pts:[double] radius:double) {
        def p (new EdgePath)
        def n:int (idiv (array_length pts) 2)
        if (n < 2) {
            return p
        }
        def i:int 0
        while (i < n) {
            def x:double (itemAt pts (i * 2))
            def yat:int ((i * 2) + 1)
            def y:double (itemAt pts yat)
            if (i == 0) {
                p.moveTo(x y)
                i = (i + 1)
                continue
            }
            if (i == (n - 1)) {
                p.lineTo(x y)
                i = (i + 1)
                continue
            }
            def prevX:double (itemAt pts ((i - 1) * 2))
            def prevYat:int (((i - 1) * 2) + 1)
            def prevY:double (itemAt pts prevYat)
            def nextX:double (itemAt pts ((i + 1) * 2))
            def nextYat:int (((i + 1) * 2) + 1)
            def nextY:double (itemAt pts nextYat)
            def r:double radius
            def d1:double (EdgeRouter.dist(prevX prevY x y))
            def d2:double (EdgeRouter.dist(x y nextX nextY))
            ; A corner that does not turn is not a corner: rounding a collinear
            ; point put a curve in the middle of a straight run and left a
            ; visible kink where the two halves met.
            def cross:double (((x - prevX) * (nextY - y)) - ((y - prevY) * (nextX - x)))
            def acr:double (fabs cross)
            if (acr < 0.01) {
                p.lineTo(x y)
                i = (i + 1)
                continue
            }
            def half1:double (d1 * 0.5)
            def half2:double (d2 * 0.5)
            if (half1 < r) { r = half1 }
            if (half2 < r) { r = half2 }
            if (r < 0.5) {
                p.lineTo(x y)
                i = (i + 1)
                continue
            }
            def inX:double (x + (((prevX - x) / d1) * r))
            def inY:double (y + (((prevY - y) / d1) * r))
            def outX:double (x + (((nextX - x) / d2) * r))
            def outY:double (y + (((nextY - y) / d2) * r))
            p.lineTo(inX inY)
            p.quadTo(x y outX outY)
            i = (i + 1)
        }
        return p
    }

    sfn dist:double (x1:double y1:double x2:double y2:double) {
        def dx:double (x2 - x1)
        def dy:double (y2 - y1)
        def d:double (sqrt ((dx * dx) + (dy * dy)))
        if (d < 0.0001) {
            return 0.0001
        }
        return d
    }

    ; The one entry point the view and the exporters call.
    sfn route:EdgePath (g:FlowGraph e:FlowEdge) {
        ; Waypoints win over everything. An edge the layered layout routed has
        ; already been told where to go — around the nodes standing in its way
        ; — and recomputing a route here would throw that away.
        if ((array_length e.waypoints) >= 4) {
            return (EdgeRouter.bendPath(e.waypoints 5.0))
        }
        def x1:double (g.endpointX(e true))
        def y1:double (g.endpointY(e true))
        def x2:double (g.endpointX(e false))
        def y2:double (g.endpointY(e false))
        def s1:int (g.edgeSide(e true))
        def s2:int (g.edgeSide(e false))
        if e.hasLaneX {
            return (EdgeRouter.routeOn(x1 y1 s1 x2 y2 s2 e.edgeType true e.laneX false 0.0))
        }
        if e.hasLaneY {
            return (EdgeRouter.routeOn(x1 y1 s1 x2 y2 s2 e.edgeType false 0.0 true e.laneY))
        }
        return (EdgeRouter.routeBetween(x1 y1 s1 x2 y2 s2 e.edgeType))
    }

    ; The corners an edge is drawn through, as a flat list — its waypoints
    ; when something routed it, and the ones the stepped router would use
    ; otherwise. Dragging a segment needs corners rather than a rounded path:
    ; you cannot move a bend you cannot name.
    sfn cornersFor:[double] (g:FlowGraph e:FlowEdge) {
        def out:[double]
        if ((array_length e.waypoints) >= 4) {
            def w:int 0
            while (w < (array_length e.waypoints)) {
                push out (itemAt e.waypoints w)
                w = (w + 1)
            }
            return (EdgeRouter.mergeRuns(out))
        }
        def kind:string e.edgeType
        def stepped:boolean false
        if (kind == "step") { stepped = true }
        if (kind == "smoothstep") { stepped = true }
        if (kind == "orthogonal") { stepped = true }
        if (stepped == false) {
            return out
        }
        def x1:double (g.endpointX(e true))
        def y1:double (g.endpointY(e true))
        def x2:double (g.endpointX(e false))
        def y2:double (g.endpointY(e false))
        def s1:int (g.edgeSide(e true))
        def s2:int (g.edgeSide(e false))
        def raw:[double] (EdgeRouter.stepPointsAt(x1 y1 s1 x2 y2 s2 20.0 e.hasLaneX e.laneX e.hasLaneY e.laneY))
        return (EdgeRouter.mergeRuns(raw))
    }

    ; Only the stepped families have a turn to place; a bezier or a straight
    ; line has nowhere to put a track, so the lane is ignored rather than
    ; quietly bending the curve.
    sfn routeOn:EdgePath (x1:double y1:double s1:int x2:double y2:double s2:int kind:string hasCx:boolean cx:double hasCy:boolean cy:double) {
        if (kind == "step") {
            return (EdgeRouter.stepAt(x1 y1 s1 x2 y2 s2 20.0 hasCx cx hasCy cy))
        }
        if (kind == "smoothstep") {
            return (EdgeRouter.smoothStepAt(x1 y1 s1 x2 y2 s2 20.0 5.0 hasCx cx hasCy cy))
        }
        if (kind == "orthogonal") {
            return (EdgeRouter.smoothStepAt(x1 y1 s1 x2 y2 s2 24.0 6.0 hasCx cx hasCy cy))
        }
        return (EdgeRouter.routeBetween(x1 y1 s1 x2 y2 s2 kind))
    }

    sfn routeBetween:EdgePath (x1:double y1:double s1:int x2:double y2:double s2:int kind:string) {
        if (kind == "straight") {
            return (EdgeRouter.straight(x1 y1 x2 y2))
        }
        if (kind == "step") {
            return (EdgeRouter.step(x1 y1 s1 x2 y2 s2 20.0))
        }
        if (kind == "smoothstep") {
            ; React Flow's defaults: offset 20, borderRadius 5. They are not
            ; taste — the parity harness compares against getSmoothStepPath,
            ; and a radius of 8 put every rounded corner 3 px out.
            return (EdgeRouter.smoothStep(x1 y1 s1 x2 y2 s2 20.0 5.0))
        }
        if (kind == "orthogonal") {
            return (EdgeRouter.smoothStep(x1 y1 s1 x2 y2 s2 24.0 6.0))
        }
        if (kind == "simplebezier") {
            return (EdgeRouter.bezier(x1 y1 s1 x2 y2 s2 0.15))
        }
        return (EdgeRouter.bezier(x1 y1 s1 x2 y2 s2 0.25))
    }

    ; Which sides two boxes should face each other with, when nobody said.
    ; A schema diagram lays tables out left to right and top to bottom, and an
    ; edge that leaves the wrong side crosses its own node to get anywhere.
    sfn preferredSides:int (ax:double ay:double aw:double ah:double bx:double by:double bw:double bh:double) {
        def acx:double (ax + (aw * 0.5))
        def acy:double (ay + (ah * 0.5))
        def bcx:double (bx + (bw * 0.5))
        def bcy:double (by + (bh * 0.5))
        def dx:double (bcx - acx)
        def dy:double (bcy - acy)
        def adx:double (fabs dx)
        def ady:double (fabs dy)
        if (adx >= ady) {
            if (dx >= 0.0) {
                return 1
            }
            return 3
        }
        if (dy >= 0.0) {
            return 2
        }
        return 0
    }

    sfn oppositeSide:int (side:int) {
        if (side == 0) { return 2 }
        if (side == 1) { return 3 }
        if (side == 2) { return 0 }
        return 1
    }
}

; ---------------------------------------------------------------------------
; Decoration
; ---------------------------------------------------------------------------
; What is drawn where an edge meets a node. The model says "one customer has
; many orders"; this says whether that reads as a crow's foot, as `1` and `*`,
; or as a plain arrow head. Nothing above this line knows the difference.
;
; Everything is built in a local frame: `fwd` runs along the edge toward the
; endpoint, `side` is perpendicular. `place` maps that to flow space, so one
; description serves an edge arriving from any direction.
class DecoShape {
    def filled:boolean false
    def closed:boolean false
    def pts:[double]

    Constructor () {
    }
}

class EdgeDecoration {
    def shapes:[DecoShape]

    Constructor () {
    }

    fn shapeCount:int () {
        return (array_length shapes)
    }

    fn shapeAt:DecoShape (i:int) {
        return (itemAt shapes i)
    }

    ; kind: "" | "none" | "arrow" | "arrowclosed" | "circle"
    ;       | "one" | "many" | "zero-one" | "one-one" | "zero-many" | "one-many"
    ;       | "diamond" | "diamond-filled" | "triangle"
    ;
    ; The crow's-foot family reads outward from the node: the marks nearest the
    ; node are the minimum (a bar for one, a circle for zero) and the fork
    ; further out is the "many".
    sfn build:EdgeDecoration (kind:string x:double y:double angle:double size:double) {
        def d (new EdgeDecoration)
        if ((strlen kind) == 0) {
            return d
        }
        if (kind == "none") {
            return d
        }
        def ux:double (cos angle)
        def uy:double (sin angle)
        if (kind == "arrow") {
            def s (new DecoShape)
            EdgeDecoration.put(s x y ux uy (0.0 - size) size)
            EdgeDecoration.put(s x y ux uy 0.0 0.0)
            def back:double (0.0 - size)
            def negs:double (0.0 - size)
            EdgeDecoration.put(s x y ux uy back negs)
            push d.shapes s
            return d
        }
        if (kind == "arrowclosed") {
            def s2 (new DecoShape)
            s2.filled = true
            s2.closed = true
            def b2:double (0.0 - size)
            def h2:double (size * 0.6)
            def nh2:double (0.0 - h2)
            EdgeDecoration.put(s2 x y ux uy 0.0 0.0)
            EdgeDecoration.put(s2 x y ux uy b2 h2)
            EdgeDecoration.put(s2 x y ux uy b2 nh2)
            push d.shapes s2
            return d
        }
        if (kind == "circle") {
            def sc (new DecoShape)
            sc.filled = true
            sc.closed = true
            EdgeDecoration.circle(sc x y (size * 0.45) 12)
            push d.shapes sc
            return d
        }
        if (kind == "triangle") {
            def st (new DecoShape)
            st.closed = true
            def bt:double (0.0 - (size * 1.3))
            def ht:double (size * 0.8)
            def nht:double (0.0 - ht)
            EdgeDecoration.put(st x y ux uy 0.0 0.0)
            EdgeDecoration.put(st x y ux uy bt ht)
            EdgeDecoration.put(st x y ux uy bt nht)
            push d.shapes st
            return d
        }
        if (kind == "diamond") {
            def sd (new DecoShape)
            sd.closed = true
            EdgeDecoration.diamond(sd x y ux uy size false)
            push d.shapes sd
            return d
        }
        if (kind == "diamond-filled") {
            def sf (new DecoShape)
            sf.closed = true
            sf.filled = true
            EdgeDecoration.diamond(sf x y ux uy size true)
            push d.shapes sf
            return d
        }
        ; --- crow's foot ------------------------------------------------------
        def wantsMany:boolean false
        def wantsOne:boolean false
        def wantsZero:boolean false
        if (kind == "many")      { wantsMany = true }
        if (kind == "zero-many") { wantsMany = true }
        if (kind == "one-many")  { wantsMany = true }
        if (kind == "one")       { wantsOne = true }
        if (kind == "one-one")   { wantsOne = true }
        if (kind == "one-many")  { wantsOne = true }
        if (kind == "zero-one")  { wantsZero = true }
        if (kind == "zero-many") { wantsZero = true }
        def span:double (size * 0.75)
        def nspan:double (0.0 - span)
        if wantsMany {
            def fork (new DecoShape)
            def tip:double 0.0
            def back:double (0.0 - size)
            EdgeDecoration.put(fork x y ux uy back span)
            EdgeDecoration.put(fork x y ux uy tip 0.0)
            EdgeDecoration.put(fork x y ux uy back nspan)
            push d.shapes fork
            def stem (new DecoShape)
            EdgeDecoration.put(stem x y ux uy back 0.0)
            EdgeDecoration.put(stem x y ux uy tip 0.0)
            push d.shapes stem
        }
        ; The minimum marker sits behind the fork when there is one.
        def barAt:double (0.0 - size)
        if (wantsMany == false) {
            barAt = (0.0 - (size * 0.4))
        } {
            barAt = (0.0 - (size * 1.7))
        }
        if wantsOne {
            def bar (new DecoShape)
            EdgeDecoration.put(bar x y ux uy barAt span)
            EdgeDecoration.put(bar x y ux uy barAt nspan)
            push d.shapes bar
        }
        if (kind == "one-one") {
            def bar2 (new DecoShape)
            def second:double (barAt - (size * 0.55))
            EdgeDecoration.put(bar2 x y ux uy second span)
            EdgeDecoration.put(bar2 x y ux uy second nspan)
            push d.shapes bar2
        }
        if wantsZero {
            def circ (new DecoShape)
            circ.closed = true
            def cAt:double (barAt - (size * 0.6))
            def cxp:double (x + (ux * cAt))
            def cyp:double (y + (uy * cAt))
            EdgeDecoration.circle(circ cxp cyp (size * 0.4) 12)
            push d.shapes circ
        }
        return d
    }

    ; Local (fwd, side) → flow space. `fwd` is negative going back up the edge.
    sfn put:void (s:DecoShape x:double y:double ux:double uy:double fwd:double side:double) {
        def nx:double (0.0 - uy)
        def ny:double ux
        push s.pts ((x + (ux * fwd)) + (nx * side))
        push s.pts ((y + (uy * fwd)) + (ny * side))
    }

    sfn circle:void (s:DecoShape cx:double cy:double r:double steps:int) {
        def pi:double (M_PI)
        def i:int 0
        while (i < steps) {
            def t:double (((2.0 * pi) * (to_double i)) / (to_double steps))
            push s.pts (cx + (r * (cos t)))
            push s.pts (cy + (r * (sin t)))
            i = (i + 1)
        }
    }

    sfn diamond:void (s:DecoShape x:double y:double ux:double uy:double size:double filled:boolean) {
        def len:double (size * 1.6)
        def halfW:double (size * 0.55)
        def nhalf:double (0.0 - halfW)
        def mid:double (0.0 - (len * 0.5))
        EdgeDecoration.put(s x y ux uy 0.0 0.0)
        EdgeDecoration.put(s x y ux uy mid halfW)
        def back:double (0.0 - len)
        EdgeDecoration.put(s x y ux uy back 0.0)
        EdgeDecoration.put(s x y ux uy mid nhalf)
    }

    ; The notation layer: a relationship's cardinality, as the marker name the
    ; chosen notation would draw for it. "crowfoot" | "uml" | "plain".
    ;   cardinality: "1" | "0..1" | "*" | "1..*" | "0..*" | ""
    sfn markerFor:string (notation:string cardinality:string optional:boolean) {
        if (notation == "plain") {
            return "arrowclosed"
        }
        if (notation == "uml") {
            return "arrow"
        }
        ; crow's foot
        if (cardinality == "1") {
            if optional {
                return "zero-one"
            }
            return "one-one"
        }
        if (cardinality == "0..1") {
            return "zero-one"
        }
        if (cardinality == "*") {
            return "many"
        }
        if (cardinality == "0..*") {
            return "zero-many"
        }
        if (cardinality == "1..*") {
            return "one-many"
        }
        if ((strlen cardinality) == 0) {
            return ""
        }
        return "many"
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; FlowShapes.rgr — what a node is, as an outline.
; ============================================================================
;
; A schema table and a UML class are both rectangles, so the model got away
; with never saying what a node looked like. A flowchart cannot: the shape IS
; the meaning. A diamond is a decision, a parallelogram is input or output, a
; cylinder is stored data, and drawing one of them as a rectangle does not make
; a plainer diagram — it makes a wrong one.
;
;   ┌──────────┐   ╭──────────╮      ◇          ╱────────╱     ╭─ ─ ─ ─╮
;   │ process  │   │ start    │    decision    ╱  data  ╱      │  note │
;   └──────────┘   ╰──────────╯      ◇        ╱────────╱       ╰─ ─ ─ ─╯
;
; Everything here is one function: a rectangle and a shape name in, a ring of
; points out. That is deliberate. The points are used for
;
;   * drawing — `FlowScene.polygon`, which every backend already handles, so a
;     hexagon reaches the PDF, the SVG and the GPU by the road the rectangles
;     took and needs no per-backend case;
;   * hit testing — the editor asks whether the pointer is inside the RING, not
;     inside the bounding box, so the corner of a diamond is empty canvas the
;     way it looks like it should be;
;   * port placement — the anchor for a side is where that side's outline
;     crosses the node's middle, which for every shape here is a point on the
;     shape rather than a point in the air beside it.
;
; Curves are approximated by segments rather than emitted as arcs. The display
; list has polygons and polylines and no beziers, and a rounded end drawn as
; sixteen segments is indistinguishable at any zoom a reader uses — where a
; second code path that only some backends implemented would be a rounded end
; in the browser and a hexagon in the PDF.
; ============================================================================

class FlowShape {
    ; The names are the model's, so a domain says `shape = FlowShape.decision()`
    ; and never a bare string that a typo can silently turn into a rectangle.
    sfn rect:string ()          { return "rect" }
    sfn stadium:string ()       { return "stadium" }
    sfn diamond:string ()       { return "diamond" }
    sfn parallelogram:string () { return "parallelogram" }
    sfn trapezoid:string ()     { return "trapezoid" }
    sfn hexagon:string ()       { return "hexagon" }
    sfn cylinder:string ()      { return "cylinder" }
    sfn document:string ()      { return "document" }
    sfn ellipse:string ()       { return "ellipse" }
    sfn circle:string ()        { return "circle" }
    sfn note:string ()          { return "note" }
    sfn triangle:string ()      { return "triangle" }
    sfn rightTriangle:string () { return "righttriangle" }
    sfn pentagon:string ()      { return "pentagon" }
    sfn heptagon:string ()      { return "heptagon" }
    sfn octagon:string ()       { return "octagon" }
    sfn decagon:string ()       { return "decagon" }
    sfn plus:string ()          { return "plus" }
    sfn star:string ()          { return "star" }
    ; An outline the caller supplies, as unit coordinates in 0..1 scaled to the
    ; node's box — Syncfusion's `Polygon`, JointJS's `standard.Polygon`.
    sfn polygon:string ()       { return "polygon" }
    sfn triangleDown:string ()  { return "triangledown" }
    sfn pentagonDown:string ()  { return "pentagondown" }
    ; A rectangle with a bar down each side: "this step is defined elsewhere".
    sfn predefined:string ()    { return "predefined" }

    ; ------------------------------------------------ the rest of ISO 5807 ---
    ; The nine the first pass left out. They are rarer than a process box and
    ; a decision diamond, but "rarer" is not "optional": a chart that draws a
    ; magnetic tape as a rectangle has thrown away the one thing the reader
    ; was going to read first.
    sfn paperTape:string ()      { return "papertape" }
    sfn directData:string ()     { return "directdata" }
    sfn sequentialData:string () { return "sequentialdata" }
    ; ISO draws sequential-access storage and magnetic tape the same way, and
    ; so does everyone else; the two names are kept apart because a chart that
    ; says which one it means is easier to read back.
    sfn sequentialAccess:string () { return "sequentialaccess" }
    sfn sort:string ()           { return "sort" }
    sfn multiDocument:string ()  { return "multidocument" }
    sfn collate:string ()        { return "collate" }
    sfn orJunction:string ()     { return "or" }
    sfn internalStorage:string () { return "internalstorage" }

    ; --------------------------------------------------- UML activity set ----
    ; An activity diagram is a different vocabulary from a class diagram: an
    ; action is a rounded box, a fork is a bar, a signal is a box with one end
    ; pushed out or pulled in, and the diagram starts and ends on filled
    ; circles rather than on words.
    sfn action:string ()         { return "action" }
    sfn structuredNode:string () { return "structurednode" }
    sfn initialNode:string ()    { return "initialnode" }
    sfn finalNode:string ()      { return "finalnode" }
    sfn forkNode:string ()       { return "forknode" }
    sfn sendSignal:string ()     { return "sendsignal" }
    sfn receiveSignal:string ()  { return "receivesignal" }
    sfn acceptEvent:string ()    { return "acceptevent" }
    sfn timeEvent:string ()      { return "timeevent" }
}

class FlowShapes {
    ; True when the shape is anything other than a plain rectangle, which is
    ; the one case the renderer can hand straight to the rounded-rect
    ; primitive instead of building a ring.
    sfn isPlain:boolean (shape:string) {
        if ((strlen shape) == 0) {
            return true
        }
        if (shape == "rect") {
            return true
        }
        return false
    }

    ; A shape whose body is a rectangle but which is drawn with something extra
    ; on top of it — the side bars of a predefined process, the folded corner of
    ; a note. Those keep the rectangle's fill and clip, so the renderer treats
    ; them as rectangles and adds the ornament afterwards.
    sfn isDecorated:boolean (shape:string) {
        if (shape == "predefined") { return true }
        if (shape == "note") { return true }
        if (shape == "internalstorage") { return true }
        if (shape == "action") { return true }
        if (shape == "structurednode") { return true }
        if (shape == "forknode") { return true }
        return false
    }

    ; The corner radius a shape wants, or -1 for "whatever the theme says".
    ; A UML action is a rectangle with corners round enough that nobody has to
    ; be told it is not a class box.
    sfn radiusFor:double (shape:string w:double h:double) {
        if (shape == "action") {
            def rad:double (h * 0.32)
            if (rad > 18.0) { rad = 18.0 }
            return rad
        }
        if (shape == "structurednode") { return 10.0 }
        if (shape == "forknode") { return 1.0 }
        return -1.0
    }

    ; ------------------------------------------------------------ ornament ---
    ; Some shapes are an outline plus one or more lines drawn ON it — the bar
    ; across a sort diamond, the cross in an OR junction, the corner rules of
    ; internal storage. They are not part of the silhouette (a hit test must
    ; not care about them, and neither must the fill), so they are asked for
    ; separately and drawn as strokes afterwards.
    sfn ornamentCount:int (shape:string) {
        if (shape == "sort") { return 1 }
        if (shape == "or") { return 2 }
        if (shape == "internalstorage") { return 2 }
        if (shape == "multidocument") { return 2 }
        if (shape == "finalnode") { return 1 }
        if (shape == "directdata") { return 1 }
        if (shape == "cylinder") { return 1 }
        return 0
    }

    ; Whether ornament `i` is a closed ring (drawn as a loop) or an open line.
    sfn ornamentClosed:boolean (shape:string i:int) {
        if (shape == "finalnode") { return true }
        return false
    }

    sfn ornamentAt:[double] (shape:string x:double y:double w:double h:double i:int) {
        def pts:[double]
        def r:double (x + w)
        def b:double (y + h)
        def cx:double (x + (w * 0.5))
        def cy:double (y + (h * 0.5))
        if (shape == "cylinder") {
            return (FlowShapes.drumLid(x y w h))
        }
        if (shape == "sort") {
            ; The bar across the middle: the line that says a diamond here is
            ; a sort rather than a decision.
            push pts x
            push pts cy
            push pts r
            push pts cy
            return pts
        }
        if (shape == "or") {
            def rad:double (w * 0.5)
            if ((h * 0.5) < rad) { rad = (h * 0.5) }
            if (i == 0) {
                push pts (cx - rad)
                push pts cy
                push pts (cx + rad)
                push pts cy
                return pts
            }
            push pts cx
            push pts (cy - rad)
            push pts cx
            push pts (cy + rad)
            return pts
        }
        if (shape == "internalstorage") {
            def inset:double (FlowShapes.storageInset(w h))
            if (i == 0) {
                push pts (x + inset)
                push pts y
                push pts (x + inset)
                push pts b
                return pts
            }
            push pts x
            push pts (y + inset)
            push pts r
            push pts (y + inset)
            return pts
        }
        if (shape == "multidocument") {
            ; The two sheets behind the front one, each showing a top edge and
            ; a right edge and nothing else — which is all you ever see of a
            ; page in a stack.
            def d:double (FlowShapes.stackOffset(w h))
            def step:double ((to_double (i + 1)) * d)
            def fw:double (w - (d * 2.0))
            push pts (x + step)
            push pts (b - (d * 2.0))
            push pts (x + step)
            push pts (y + ((d * 2.0) - step))
            push pts ((x + step) + fw)
            push pts (y + ((d * 2.0) - step))
            push pts ((x + step) + fw)
            push pts (b - (d * 2.0))
            return pts
        }
        if (shape == "finalnode") {
            def rad3:double (w * 0.5)
            if ((h * 0.5) < rad3) { rad3 = (h * 0.5) }
            FlowShapes.ellipseInto(pts cx cy (rad3 * 0.58) (rad3 * 0.58) 20)
            return pts
        }
        if (shape == "directdata") {
            ; The near end of the drum, drawn as a line across the body — the
            ; same trick the upright cylinder's lid uses, turned on its side.
            def rx:double (FlowShapes.drumRadius(w))
            FlowShapes.ellipseArcInto(pts (x + rx) cy rx (h * 0.5) (0.0 - 90.0) 90.0 14)
            return pts
        }
        return pts
    }

    sfn storageInset:double (w:double h:double) {
        def s:double (h * 0.22)
        def cap:double (w * 0.22)
        if (s > cap) { s = cap }
        if (s > 16.0) { s = 16.0 }
        if (s < 5.0) { s = 5.0 }
        return s
    }

    sfn stackOffset:double (w:double h:double) {
        def d:double (h * 0.1)
        def cap:double (w * 0.08)
        if (d > cap) { d = cap }
        if (d > 10.0) { d = 10.0 }
        if (d < 3.0) { d = 3.0 }
        return d
    }

    ; The outline, with a caller-supplied ring for "polygon". The unit points
    ; are 0..1 across the box, so the same shape scales with the node instead
    ; of being redefined every time it is resized.
    sfn outlineCustom:[double] (shape:string x:double y:double w:double h:double unit:[double]) {
        if (shape == "polygon") {
            def out:[double]
            def n:int (idiv (array_length unit) 2)
            if (n < 3) {
                return (FlowShapes.outline("rect" x y w h))
            }
            def i:int 0
            while (i < n) {
                def ux:double (itemAt unit (i * 2))
                def uyAt:int ((i * 2) + 1)
                def uy:double (itemAt unit uyAt)
                push out (x + (w * ux))
                push out (y + (h * uy))
                i = (i + 1)
            }
            return out
        }
        return (FlowShapes.outline(shape x y w h))
    }

    ; The outline, as x0 y0 x1 y1 … in the order a pen would draw it.
    sfn outline:[double] (shape:string x:double y:double w:double h:double) {
        def pts:[double]
        def r:double (x + w)
        def b:double (y + h)
        def cx:double (x + (w * 0.5))
        def cy:double (y + (h * 0.5))
        if (shape == "diamond") {
            push pts cx
            push pts y
            push pts r
            push pts cy
            push pts cx
            push pts b
            push pts x
            push pts cy
            return pts
        }
        if (shape == "parallelogram") {
            ; The slant is a fraction of the height, not of the width, so a
            ; long "read the customer file" box does not turn into a wedge.
            def slant:double (FlowShapes.slantOf(w h))
            push pts (x + slant)
            push pts y
            push pts r
            push pts y
            push pts (r - slant)
            push pts b
            push pts x
            push pts b
            return pts
        }
        if (shape == "trapezoid") {
            def slant:double (FlowShapes.slantOf(w h))
            push pts (x + slant)
            push pts y
            push pts (r - slant)
            push pts y
            push pts r
            push pts b
            push pts x
            push pts b
            return pts
        }
        if (shape == "triangle") {
            push pts cx
            push pts y
            push pts r
            push pts b
            push pts x
            push pts b
            return pts
        }
        if (shape == "triangledown") {
            push pts x
            push pts y
            push pts r
            push pts y
            push pts cx
            push pts b
            return pts
        }
        if (shape == "pentagondown") {
            ; The off-page connector: a box with a point at the bottom.
            def notch:double (h * 0.28)
            push pts x
            push pts y
            push pts r
            push pts y
            push pts r
            push pts (b - notch)
            push pts cx
            push pts b
            push pts x
            push pts (b - notch)
            return pts
        }
        if (shape == "righttriangle") {
            push pts x
            push pts y
            push pts r
            push pts b
            push pts x
            push pts b
            return pts
        }
        if (shape == "plus") {
            ; A cross whose arms are a third of the box, which is the
            ; proportion that still reads as a plus at a small size.
            def aw:double (w * 0.33)
            def ah:double (h * 0.33)
            def lx:double (x + ((w - aw) * 0.5))
            def rx:double (lx + aw)
            def ty:double (y + ((h - ah) * 0.5))
            def by:double (ty + ah)
            push pts lx
            push pts y
            push pts rx
            push pts y
            push pts rx
            push pts ty
            push pts r
            push pts ty
            push pts r
            push pts by
            push pts rx
            push pts by
            push pts rx
            push pts b
            push pts lx
            push pts b
            push pts lx
            push pts by
            push pts x
            push pts by
            push pts x
            push pts ty
            push pts lx
            push pts ty
            return pts
        }
        if (shape == "star") {
            ; Five points, the inner radius at the ratio that makes a star
            ; rather than a pentagon with dents.
            FlowShapes.starInto(pts cx cy (w * 0.5) (h * 0.5) 5 0.42)
            return pts
        }
        if (shape == "pentagon") {
            FlowShapes.regularInto(pts cx cy (w * 0.5) (h * 0.5) 5)
            return pts
        }
        if (shape == "heptagon") {
            FlowShapes.regularInto(pts cx cy (w * 0.5) (h * 0.5) 7)
            return pts
        }
        if (shape == "octagon") {
            FlowShapes.regularInto(pts cx cy (w * 0.5) (h * 0.5) 8)
            return pts
        }
        if (shape == "decagon") {
            FlowShapes.regularInto(pts cx cy (w * 0.5) (h * 0.5) 10)
            return pts
        }
        if (shape == "hexagon") {
            def slant:double (FlowShapes.slantOf(w h))
            push pts (x + slant)
            push pts y
            push pts (r - slant)
            push pts y
            push pts r
            push pts cy
            push pts (r - slant)
            push pts b
            push pts (x + slant)
            push pts b
            push pts x
            push pts cy
            return pts
        }
        if (shape == "stadium") {
            def rad:double (h * 0.5)
            if (rad > (w * 0.5)) {
                rad = (w * 0.5)
            }
            FlowShapes.arcInto(pts (r - rad) (y + rad) rad (0.0 - 90.0) 90.0 8)
            FlowShapes.arcInto(pts (x + rad) (y + rad) rad 90.0 270.0 8)
            return pts
        }
        if (shape == "ellipse") {
            FlowShapes.ellipseInto(pts cx cy (w * 0.5) (h * 0.5) 28)
            return pts
        }
        if (shape == "circle") {
            def rad2:double (w * 0.5)
            if ((h * 0.5) < rad2) {
                rad2 = (h * 0.5)
            }
            FlowShapes.ellipseInto(pts cx cy rad2 rad2 24)
            return pts
        }
        if (shape == "cylinder") {
            ; A drum seen from the side: the top ellipse's near half is drawn
            ; separately by the renderer, because it is a line across the body
            ; rather than part of the silhouette.
            def ry:double (FlowShapes.drumRadius(h))
            FlowShapes.halfEllipseInto(pts cx (y + ry) (w * 0.5) ry true 14)
            FlowShapes.halfEllipseInto(pts cx (b - ry) (w * 0.5) ry false 14)
            return pts
        }
        if (shape == "collate") {
            ; Two triangles meeting point to point. The ring touches itself in
            ; the middle and does not cross itself, so the even-odd hit test
            ; reads both halves as inside and the waist as outside.
            push pts x
            push pts y
            push pts r
            push pts y
            push pts cx
            push pts cy
            push pts r
            push pts b
            push pts x
            push pts b
            push pts cx
            push pts cy
            return pts
        }
        if (shape == "timeevent") {
            ; The same hourglass. UML draws a time event as one, and a chart
            ; that used a different glyph for it would be a chart with a shape
            ; nobody could look up.
            return (FlowShapes.outline("collate" x y w h))
        }
        if (shape == "sort") {
            ; The diamond; the bar across it is an ornament.
            return (FlowShapes.outline("diamond" x y w h))
        }
        if (shape == "or") {
            return (FlowShapes.outline("circle" x y w h))
        }
        if (shape == "initialnode") {
            return (FlowShapes.outline("circle" x y w h))
        }
        if (shape == "finalnode") {
            return (FlowShapes.outline("circle" x y w h))
        }
        if (shape == "sendsignal") {
            ; A box with one end pushed out to a point: something leaves here.
            def tip:double (FlowShapes.signalTip(w h))
            push pts x
            push pts y
            push pts (r - tip)
            push pts y
            push pts r
            push pts cy
            push pts (r - tip)
            push pts b
            push pts x
            push pts b
            return pts
        }
        if (shape == "receivesignal") {
            ; The same box with the end pulled IN: something arrives here. The
            ; two are mirror images on purpose — a reader who knows one knows
            ; the other.
            def tip2:double (FlowShapes.signalTip(w h))
            push pts x
            push pts y
            push pts r
            push pts y
            push pts r
            push pts b
            push pts x
            push pts b
            push pts (x + tip2)
            push pts cy
            return pts
        }
        if (shape == "acceptevent") {
            return (FlowShapes.outline("receivesignal" x y w h))
        }
        if (shape == "papertape") {
            ; Punched tape: a wave along the top and another along the bottom,
            ; running the same way, so the strip looks like it carries on off
            ; both ends.
            def wv:double (FlowShapes.waveDepth(h))
            def steps2:int 12
            def i2:int 0
            while (i2 <= steps2) {
                def t2:double ((to_double i2) / (to_double steps2))
                push pts (x + (w * t2))
                push pts ((y + wv) - (wv * (sin (t2 * 6.283185307179586))))
                i2 = (i2 + 1)
            }
            def j2:int steps2
            while (j2 >= 0) {
                def t3:double ((to_double j2) / (to_double steps2))
                push pts (x + (w * t3))
                push pts ((b - wv) - (wv * (sin (t3 * 6.283185307179586))))
                j2 = (j2 - 1)
            }
            return pts
        }
        if (shape == "directdata") {
            ; A drum lying down: disc storage, as against the tape reel that
            ; stands up. Flat along the top and bottom, round at both ends.
            def rx2:double (FlowShapes.drumRadius(w))
            def ry2:double (h * 0.5)
            FlowShapes.ellipseArcInto(pts (r - rx2) cy rx2 ry2 (0.0 - 90.0) 90.0 14)
            FlowShapes.ellipseArcInto(pts (x + rx2) cy rx2 ry2 90.0 270.0 14)
            return pts
        }
        if (shape == "sequentialdata") {
            ; The tape reel: a circle with the corner of the box left in, so
            ; the disc has somewhere to sit.
            def rad2b:double (w * 0.5)
            if ((h * 0.5) < rad2b) { rad2b = (h * 0.5) }
            ; Three quarters of a circle, from the bottom round to the right,
            ; and then the square corner that the reel sits on. Going the
            ; other way round would put the corner between two copies of the
            ; bottom point and leave a spike of no area.
            def steps3:int 22
            def k3:int 0
            while (k3 <= steps3) {
                def a3:double (1.5707963267948966 + (((to_double k3) / (to_double steps3)) * 4.71238898038469))
                push pts (cx + (rad2b * (cos a3)))
                push pts (cy + (rad2b * (sin a3)))
                k3 = (k3 + 1)
            }
            push pts (cx + rad2b)
            push pts (cy + rad2b)
            return pts
        }
        if (shape == "sequentialaccess") {
            return (FlowShapes.outline("sequentialdata" x y w h))
        }
        if (shape == "multidocument") {
            ; The front sheet is the silhouette; the ones behind it are drawn
            ; as ornaments, because a stack of pages is exactly one page you
            ; can see and two you can see the corners of.
            def d4:double (FlowShapes.stackOffset(w h))
            return (FlowShapes.outline("document" x (y + (d4 * 2.0)) (w - (d4 * 2.0)) (h - (d4 * 2.0))))
        }
        if (shape == "document") {
            ; The wave along the bottom, which is the whole of what makes a
            ; document a document.
            def wave:double (FlowShapes.waveDepth(h))
            push pts x
            push pts y
            push pts r
            push pts y
            push pts r
            push pts (b - wave)
            def steps:int 12
            def i:int steps
            while (i >= 0) {
                def t:double ((to_double i) / (to_double steps))
                def px:double (x + (w * t))
                ; One full period, so the edge leaves flat on the right, dips,
                ; rises, and comes back flat on the left.
                def py:double ((b - wave) + (wave * (sin (t * 6.283185307179586))))
                push pts px
                push pts py
                i = (i - 1)
            }
            return pts
        }
        ; Everything else is the rectangle, including "rect", "note" and
        ; "predefined" — the last two are a rectangle plus an ornament.
        push pts x
        push pts y
        push pts r
        push pts y
        push pts r
        push pts b
        push pts x
        push pts b
        return pts
    }

    ; How far a slanted side leans. Bounded so a short wide box keeps its
    ; slant and a tall narrow one does not fold in on itself.
    sfn slantOf:double (w:double h:double) {
        def s:double (h * 0.34)
        def cap:double (w * 0.3)
        if (s > cap) {
            s = cap
        }
        if (s < 4.0) {
            s = 4.0
        }
        return s
    }

    ; How far the point of a signal shape sticks out, or bites in.
    sfn signalTip:double (w:double h:double) {
        def t:double (w * 0.2)
        def cap:double (h * 0.5)
        if (t > cap) { t = cap }
        if (t < 6.0) { t = 6.0 }
        return t
    }

    sfn drumRadius:double (h:double) {
        def ry:double (h * 0.14)
        if (ry > 16.0) {
            ry = 16.0
        }
        if (ry < 4.0) {
            ry = 4.0
        }
        return ry
    }

    sfn waveDepth:double (h:double) {
        def d:double (h * 0.09)
        if (d > 12.0) {
            d = 12.0
        }
        if (d < 3.0) {
            d = 3.0
        }
        return d
    }

    ; The line across a cylinder's body: the near half of the top ellipse.
    sfn drumLid:[double] (x:double y:double w:double h:double) {
        def pts:[double]
        def ry:double (FlowShapes.drumRadius(h))
        FlowShapes.halfEllipseInto(pts (x + (w * 0.5)) (y + ry) (w * 0.5) ry false 14)
        return pts
    }

    ; --------------------------------------------------------------- arcs ----
    ; Angles in degrees, clockwise on a screen where y grows downwards.
    sfn arcInto:void (pts:[double] cx:double cy:double rad:double from:double to:double steps:int) {
        def i:int 0
        while (i <= steps) {
            def t:double ((to_double i) / (to_double steps))
            def a:double ((from + ((to - from) * t)) * 0.017453292519943295)
            push pts (cx + (rad * (cos a)))
            push pts (cy + (rad * (sin a)))
            i = (i + 1)
        }
    }

    ; The same, with a radius per axis. A drum lying down has a short round
    ; end and a tall one, and forcing it through the circular `arcInto` would
    ; make the caps balloon out of the box.
    sfn ellipseArcInto:void (pts:[double] cx:double cy:double rx:double ry:double from:double to:double steps:int) {
        def i:int 0
        while (i <= steps) {
            def t:double ((to_double i) / (to_double steps))
            def a:double ((from + ((to - from) * t)) * 0.017453292519943295)
            push pts (cx + (rx * (cos a)))
            push pts (cy + (ry * (sin a)))
            i = (i + 1)
        }
    }

    ; An n-sided polygon inscribed in the box, first vertex at the top. The
    ; radii are the box's own, so a pentagon in a wide box is a wide pentagon
    ; rather than a circle's worth of unused space.
    sfn regularInto:void (pts:[double] cx:double cy:double rx:double ry:double sides:int) {
        def step:double (6.283185307179586 / (to_double sides))
        def start:double -1.5707963267948966
        def i:int 0
        while (i < sides) {
            def a:double (start + ((to_double i) * step))
            push pts (cx + (rx * (cos a)))
            push pts (cy + (ry * (sin a)))
            i = (i + 1)
        }
    }

    ; A star: `points` outer vertices with an inner vertex between each pair,
    ; at `inner` of the radius.
    sfn starInto:void (pts:[double] cx:double cy:double rx:double ry:double points:int inner:double) {
        def total:int (points * 2)
        def step:double (6.283185307179586 / (to_double total))
        def start:double -1.5707963267948966
        def i:int 0
        while (i < total) {
            def a:double (start + ((to_double i) * step))
            def fx:double rx
            def fy:double ry
            if ((i % 2) == 1) {
                fx = (rx * inner)
                fy = (ry * inner)
            }
            push pts (cx + (fx * (cos a)))
            push pts (cy + (fy * (sin a)))
            i = (i + 1)
        }
    }

    sfn ellipseInto:void (pts:[double] cx:double cy:double rx:double ry:double steps:int) {
        def i:int 0
        while (i < steps) {
            def a:double (((to_double i) / (to_double steps)) * 6.283185307179586)
            push pts (cx + (rx * (cos a)))
            push pts (cy + (ry * (sin a)))
            i = (i + 1)
        }
    }

    ; `upper` picks the half above the centre line; the other half is the one
    ; below it. Both are walked left to right so the two stack into a drum.
    sfn halfEllipseInto:void (pts:[double] cx:double cy:double rx:double ry:double upper:boolean steps:int) {
        def sign:double 1.0
        if upper {
            sign = -1.0
        }
        def i:int 0
        while (i <= steps) {
            def t:double ((to_double i) / (to_double steps))
            def a:double (t * 3.141592653589793)
            def px:double (cx - (rx * (cos a)))
            def py:double (cy + (sign * (ry * (sin a))))
            if upper {
                px = (cx + (rx * (cos a)))
            }
            push pts px
            push pts py
            i = (i + 1)
        }
    }

    ; ---------------------------------------------------------- hit testing --
    ; The even-odd ray cast, which is the whole of point-in-polygon and works
    ; for every ring here because none of them is self-intersecting.
    sfn holds:boolean (pts:[double] px:double py:double) {
        def n:int (idiv (array_length pts) 2)
        if (n < 3) {
            return false
        }
        def inside:boolean false
        def j:int (n - 1)
        def i:int 0
        while (i < n) {
            def xi:double (itemAt pts (i * 2))
            def yiAt:int ((i * 2) + 1)
            def yi:double (itemAt pts yiAt)
            def xj:double (itemAt pts (j * 2))
            def yjAt:int ((j * 2) + 1)
            def yj:double (itemAt pts yjAt)
            def straddles:boolean false
            if (yi > py) {
                if (yj <= py) { straddles = true }
            }
            if (yj > py) {
                if (yi <= py) { straddles = true }
            }
            if straddles {
                def dy:double (yj - yi)
                if ((fabs dy) > 0.000001) {
                    def cut:double (xi + (((py - yi) / dy) * (xj - xi)))
                    if (px < cut) {
                        if inside { inside = false } { inside = true }
                    }
                }
            }
            j = i
            i = (i + 1)
        }
        return inside
    }

    sfn holdsShape:boolean (shape:string x:double y:double w:double h:double px:double py:double) {
        if (FlowShapes.isPlain(shape)) {
            return (FlowShapes.inBox(x y w h px py))
        }
        if (FlowShapes.isDecorated(shape)) {
            return (FlowShapes.inBox(x y w h px py))
        }
        def ring:[double] (FlowShapes.outline(shape x y w h))
        return (FlowShapes.holds(ring px py))
    }

    sfn inBox:boolean (x:double y:double w:double h:double px:double py:double) {
        if (px < x) { return false }
        if (py < y) { return false }
        if (px > (x + w)) { return false }
        if (py > (y + h)) { return false }
        return true
    }

    ; ------------------------------------------------------------- labels ---
    ; Where the text goes. For most shapes that is the middle of the box, but
    ; a triangle's middle is half outside it — the centre of a right triangle
    ; sits exactly on the hypotenuse — so the ones that taper get their text
    ; where the room is.
    sfn labelCX:double (shape:string x:double y:double w:double h:double) {
        if (shape == "righttriangle") {
            return (x + (w * 0.36))
        }
        if (shape == "multidocument") {
            def d:double (FlowShapes.stackOffset(w h))
            return (x + ((w - (d * 2.0)) * 0.5))
        }
        return (x + (w * 0.5))
    }

    sfn labelCY:double (shape:string x:double y:double w:double h:double) {
        if (shape == "triangle") {
            return (y + (h * 0.66))
        }
        if (shape == "triangledown") {
            return (y + (h * 0.36))
        }
        if (shape == "righttriangle") {
            return (y + (h * 0.72))
        }
        if (shape == "pentagondown") {
            return (y + (h * 0.42))
        }
        if (shape == "multidocument") {
            def d:double (FlowShapes.stackOffset(w h))
            return ((y + (d * 2.0)) + ((h - (d * 2.0)) * 0.5))
        }
        ; The middle of an hourglass is its waist — the one point of the box
        ; that is outside the shape. The text goes in the lower bowl, which is
        ; where a collate symbol is labelled anyway.
        if (shape == "collate")   { return (y + (h * 0.76)) }
        if (shape == "timeevent") { return (y + (h * 0.76)) }
        return (y + (h * 0.5))
    }

    ; How wide the text may be where it is put. A taper leaves less room the
    ; further from the wide end you go.
    sfn labelRoom:double (shape:string w:double h:double) {
        if (shape == "triangle")       { return (w * 0.58) }
        if (shape == "triangledown")   { return (w * 0.58) }
        if (shape == "righttriangle")  { return (w * 0.5) }
        if (shape == "diamond")        { return (w * 0.62) }
        if (shape == "star")           { return (w * 0.5) }
        if (shape == "plus")           { return (w * 0.33) }
        if (shape == "pentagon")       { return (w * 0.72) }
        if (shape == "heptagon")       { return (w * 0.8) }
        if (shape == "octagon")        { return (w * 0.82) }
        if (shape == "decagon")        { return (w * 0.86) }
        if (shape == "circle")         { return (w * 0.72) }
        if (shape == "ellipse")        { return (w * 0.78) }
        if (shape == "or")             { return (w * 0.4) }
        if (shape == "sequentialdata") { return (w * 0.7) }
        if (shape == "sequentialaccess") { return (w * 0.7) }
        if (shape == "collate")        { return (w * 0.42) }
        if (shape == "timeevent")      { return (w * 0.42) }
        if (shape == "sort")           { return (w * 0.5) }
        if (shape == "sendsignal")     { return (w * 0.68) }
        if (shape == "receivesignal")  { return (w * 0.68) }
        if (shape == "acceptevent")    { return (w * 0.68) }
        if (shape == "papertape")      { return (w - 16.0) }
        if (shape == "directdata")     { return (w * 0.72) }
        if (shape == "multidocument")  { return (w * 0.78) }
        return (w - 16.0)
    }

    ; --------------------------------------------------------------- ports ---
    ; Where a handle on `side` sits. For a rectangle it is the middle of that
    ; edge; for a diamond it is the vertex; for a slanted shape it is where the
    ; outline crosses the node's own middle. In every case it is a point ON the
    ; shape, which is what stops an arrow ending in mid-air beside a diamond.
    sfn anchorX:double (shape:string x:double y:double w:double h:double side:int) {
        if (side == 0) { return (x + (w * 0.5)) }
        if (side == 2) { return (x + (w * 0.5)) }
        def lean:double 0.0
        if (shape == "parallelogram") {
            lean = ((FlowShapes.slantOf(w h)) * 0.5)
        }
        if (shape == "trapezoid") {
            lean = ((FlowShapes.slantOf(w h)) * 0.5)
        }
        ; The point of a send signal IS the right-hand anchor, and the notch
        ; of a receive signal is where the left-hand one has to sit: an arrow
        ; that stopped at the bounding box would end inside the bite.
        if (shape == "receivesignal") {
            if (side == 3) { return (x + (FlowShapes.signalTip(w h))) }
        }
        if (shape == "acceptevent") {
            if (side == 3) { return (x + (FlowShapes.signalTip(w h))) }
        }
        if (side == 1) { return ((x + w) - lean) }
        return (x + lean)
    }

    sfn anchorY:double (shape:string x:double y:double w:double h:double side:int) {
        if (side == 1) { return (y + (h * 0.5)) }
        if (side == 3) { return (y + (h * 0.5)) }
        if (side == 0) { return y }
        ; A document's bottom edge is a wave, and the wave crosses the middle
        ; of the box at its own baseline — an arrow that stopped at the
        ; bounding box would end below the paper.
        if (shape == "document") {
            def wave:double (FlowShapes.waveDepth(h))
            return ((y + h) - wave)
        }
        return (y + h)
    }
}

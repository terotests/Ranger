; ============================================================================
; UMLModel.rgr — the second domain, and the proof the first one was general.
; ============================================================================
;
; A UML class is a compartment node with different words in it:
;
;   ┌─────────────────────────┐        ┌─────────────────────────┐
;   │ customers               │        │ Customer                │
;   ├─────────────────────────┤        ├─────────────────────────┤
;   │ PK id        INTEGER    │        │ -  id      : int        │
;   │    email     VARCHAR    │        │ -  email   : string     │
;   ├─────────────────────────┤        ├─────────────────────────┤
;   │ UNIQUE(email)           │        │ +  save()  : void       │
;   └─────────────────────────┘        └─────────────────────────┘
;
; Same primitive, same layout, same ports, same router — only the mapping
; differs, and it is forty lines. That is the whole argument for keeping the
; core free of tables.
; ============================================================================

Import "../../core/GraphModel.rgr"
Import "../../../evg/EVGTextMeasurer.rgr"

class UMLMember {
    ; "+" public, "-" private, "#" protected, "~" package
    def visibility:string "+"
    def name:string ""
    def memberType:string ""
    def isStatic:boolean false
    def isAbstract:boolean false
    ; attribute or operation
    def isOperation:boolean false
    def parameters:string ""

    Constructor () {
    }

    sfn attribute:UMLMember (visibility:string name:string memberType:string) {
        def m (new UMLMember)
        m.visibility = visibility
        m.name = name
        m.memberType = memberType
        return m
    }

    sfn operation:UMLMember (visibility:string name:string parameters:string returns:string) {
        def m (new UMLMember)
        m.visibility = visibility
        m.name = name
        m.parameters = parameters
        m.memberType = returns
        m.isOperation = true
        return m
    }

    fn signature:string () {
        if isOperation {
            return (name + "(" + parameters + ")")
        }
        return name
    }
}

class UMLClass {
    def name:string ""
    ; "" | "interface" | "abstract" | "enumeration" | "record"
    def stereotype:string ""
    def attributes:[UMLMember]
    def operations:[UMLMember]

    Constructor () {
    }

    sfn create:UMLClass (name:string) {
        def c (new UMLClass)
        c.name = name
        return c
    }

    fn attribute:UMLMember (visibility:string name:string memberType:string) {
        def m:UMLMember (UMLMember.attribute(visibility name memberType))
        push attributes m
        return m
    }

    fn operation:UMLMember (visibility:string name:string parameters:string returns:string) {
        def m:UMLMember (UMLMember.operation(visibility name parameters returns))
        push operations m
        return m
    }
}

; kind: "association" | "inheritance" | "implementation" | "composition"
;     | "aggregation" | "dependency"
class UMLRelation {
    def fromClass:string ""
    def toClass:string ""
    def kind:string "association"
    def label:string ""
    def fromMultiplicity:string ""
    def toMultiplicity:string ""

    Constructor () {
    }

    sfn create:UMLRelation (fromClass:string toClass:string kind:string) {
        def r (new UMLRelation)
        r.fromClass = fromClass
        r.toClass = toClass
        r.kind = kind
        return r
    }

    ; The marker at the *target* end. UML puts the ornament on the end that
    ; owns the relationship: the hollow triangle points at the supertype, the
    ; diamond sits on the whole rather than the part.
    fn targetMarker:string () {
        if (kind == "inheritance")   { return "triangle" }
        if (kind == "implementation"){ return "triangle" }
        if (kind == "composition")   { return "diamond-filled" }
        if (kind == "aggregation")   { return "diamond" }
        if (kind == "dependency")    { return "arrow" }
        return ""
    }

    fn dashed:boolean () {
        if (kind == "implementation") { return true }
        if (kind == "dependency")     { return true }
        return false
    }
}

class UMLDiagram {
    def name:string ""
    def classes:[UMLClass]
    def relations:[UMLRelation]

    Constructor () {
    }

    fn addClass:UMLClass (c:UMLClass) {
        push classes c
        return c
    }

    fn umlClass:UMLClass (name:string) {
        def c:UMLClass (UMLClass.create(name))
        return (this.addClass(c))
    }

    fn relate:UMLRelation (fromClass:string toClass:string kind:string) {
        def r:UMLRelation (UMLRelation.create(fromClass toClass kind))
        push relations r
        return r
    }
}

class UMLToGraph {
    def measurer:EVGTextMeasurer (new EVGTextMeasurer)
    def fontFamily:string "Noto Sans"
    def rowFontSize:double 11.0
    def headerFontSize:double 13.0
    def minWidth:double 160.0
    def maxWidth:double 340.0

    Constructor () {
    }

    fn textWidth:double (t:string size:double) {
        def w:double 0.0
        def i:int 0
        while (i < (strlen t)) {
            def c:int (charAt t i)
            w = (w + (measurer.measureChar(c fontFamily size)))
            i = (i + 1)
        }
        ; Same generosity FlowView measures with: a node sized from a shorter
        ; estimate than the renderer uses is a node its own text runs out of.
        return (w * 1.08)
    }

    fn build:FlowGraph (d:UMLDiagram) {
        def g (new FlowGraph)
        def i:int 0
        while (i < (array_length d.classes)) {
            def c:UMLClass (itemAt d.classes i)
            def n:FlowNode (this.classNode(c))
            g.addNode(n)
            i = (i + 1)
        }
        g.reindex()
        def k:int 0
        while (k < (array_length d.relations)) {
            def r:UMLRelation (itemAt d.relations k)
            if (g.hasNode(r.fromClass)) {
                if (g.hasNode(r.toClass)) {
                    def e:FlowEdge (FlowEdge.create(("r" + (to_string k)) r.fromClass r.toClass))
                    e.edgeType = "smoothstep"
                    e.label = r.label
                    e.markerEnd = (r.targetMarker())
                    e.markerStart = ""
                    e.sourceCardinality = ""
                    e.targetCardinality = ""
                    if (r.dashed()) {
                        e.dash = 6.0
                    }
                    if ((strlen r.toMultiplicity) > 0) {
                        e.label = (r.toMultiplicity + " " + r.label)
                    }
                    g.addEdge(e)
                }
            }
            k = (k + 1)
        }
        g.reindex()
        return g
    }

    fn classNode:FlowNode (c:UMLClass) {
        def label:string c.name
        if ((strlen c.stereotype) > 0) {
            label = ("«" + c.stereotype + "» " + c.name)
        }
        def n:FlowNode (FlowNode.create(c.name label 0.0 0.0))
        n.nodeType = "umlclass"
        n.headerHeight = 28.0
        n.rowHeight = 18.0
        n.resizable = true
        def widest:double (this.textWidth(label headerFontSize))
        def attrs:FlowSection (n.addSection(""))
        def i:int 0
        while (i < (array_length c.attributes)) {
            def m:UMLMember (itemAt c.attributes i)
            def row:FlowRow (this.memberRow(c m))
            attrs.addRow(row)
            def w:double (this.rowWidth(row))
            if (w > widest) { widest = w }
            i = (i + 1)
        }
        if ((array_length c.operations) > 0) {
            def ops:FlowSection (n.addSection(""))
            def k:int 0
            while (k < (array_length c.operations)) {
                def m2:UMLMember (itemAt c.operations k)
                def row2:FlowRow (this.memberRow(c m2))
                ops.addRow(row2)
                def w2:double (this.rowWidth(row2))
                if (w2 > widest) { widest = w2 }
                k = (k + 1)
            }
        }
        def total:double (widest + 20.0)
        if (total < minWidth) { total = minWidth }
        if (total > maxWidth) { total = maxWidth }
        n.width = total
        n.layoutCompartments()
        return n
    }

    fn memberRow:FlowRow (c:UMLClass m:UMLMember) {
        def detail:string ""
        if ((strlen m.memberType) > 0) {
            detail = (": " + m.memberType)
        }
        def row:FlowRow (FlowRow.create(m.visibility (m.signature()) detail ""))
        row.portId = (c.name + "." + m.name)
        if m.isStatic {
            row.emphasis = 1
        }
        if m.isAbstract {
            row.emphasis = 2
        }
        return row
    }

    fn rowWidth:double (r:FlowRow) {
        def w:double 18.0
        w = (w + (this.textWidth(r.text rowFontSize)))
        if ((strlen r.detail) > 0) {
            w = ((w + 12.0) + (this.textWidth(r.detail rowFontSize)))
        }
        return w
    }
}

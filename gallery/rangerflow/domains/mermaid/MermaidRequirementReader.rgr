; ============================================================================
; MermaidRequirementReader.rgr — a SysML requirement diagram, into UML.
; ============================================================================
;
; A requirement diagram is a class diagram whose boxes are requirements: a
; stereotype at the top, a handful of named values under it, and dashed
; arrows between them saying which requirement satisfies, verifies or traces
; which. `domains/uml` draws all of that already.
;
;   requirementDiagram
;       requirement top { id: 1  text: the system shall work  risk: high }
;       element impl { type: simulation }
;       impl - satisfies -> top
;
;   ┌──────────────────────────┐
;   │   «requirement» top      │
;   ├──────────────────────────┤
;   │ id            1          │
;   │ text          the system…│
;   │ risk          high       │
;   └──────────────────────────┘
;              ▲
;              ┆ «satisfies»
;   ┌──────────┴───────────────┐
;   │   «element» impl         │
;   └──────────────────────────┘
;
; **What it reads.** All six requirement types and `element`, the `id`, `text`,
; `risk`, `verifymethod`, `type` and `docref` fields inside the braces — in
; Mermaid's `key: value` form, one per line — and every relationship it has
; (`contains`, `copies`, `derives`, `satisfies`, `verifies`, `refines`,
; `traces`) in both directions, `A - satisfies -> B` and `B <- satisfies - A`.
;
; The arrow is dashed and the relationship's name rides on it in guillemets,
; which is how SysML draws it and what tells one kind of line from another
; when there are five of them on a page.
; ============================================================================

Import "MermaidReader.rgr"
Import "../uml/UMLModel.rgr"

class MermaidRequirementDiagram {
    def title:string ""
    def direction:string "TB"
    def themeName:string ""
    def uml:UMLDiagram (new UMLDiagram)

    Constructor () {
    }

    fn boxCount:int () {
        return (array_length uml.classes)
    }

    fn relationCount:int () {
        return (array_length uml.relations)
    }

    fn indexOfBox:int (name:string) {
        def i:int 0
        while (i < (array_length uml.classes)) {
            def c:UMLClass (itemAt uml.classes i)
            if (c.name == name) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn ensureBox:UMLClass (name:string) {
        def at:int (this.indexOfBox(name))
        if (at >= 0) {
            return (itemAt uml.classes at)
        }
        return (uml.umlClass(name))
    }

    fn layerDirection:string () {
        if (direction == "LR") { return "LR" }
        if (direction == "RL") { return "LR" }
        return "TB"
    }
}

class MermaidRequirementReader {
    def doc:MermaidRequirementDiagram (new MermaidRequirementDiagram)
    def openBox:string ""

    Constructor () {
    }

    sfn parse:MermaidRequirementDiagram (src:string) {
        def r (new MermaidRequirementReader)
        return (r.read(src))
    }

    fn read:MermaidRequirementDiagram (src:string) {
        def lines:[string] (strsplit src "\n")
        def inFront:boolean false
        def frontDone:boolean false
        def i:int 0
        while (i < (array_length lines)) {
            def raw:string (trim (itemAt lines i))
            i = (i + 1)
            if (raw == "---") {
                if (frontDone == false) {
                    if inFront {
                        inFront = false
                        frontDone = true
                    } {
                        inFront = true
                    }
                    continue
                }
            }
            if inFront {
                def cut:int (indexOf raw ":")
                if (cut > 0) {
                    def key:string (trim (substring raw 0 cut))
                    if ((MermaidReader.lower(key)) == "title") {
                        def rest:string (trim (substring raw (cut + 1) (strlen raw)))
                        doc.title = (MermaidReader.unquote(rest))
                    }
                }
                continue
            }
            def line:string (trim (this.stripComment(raw)))
            if ((strlen line) == 0) {
                continue
            }
            this.statement(line)
        }
        return doc
    }

    fn stripComment:string (line:string) {
        def len:int (strlen line)
        def i:int 0
        while (i < len) {
            def c:int (charAt line i)
            if (c == 37) {
                if ((i + 1) < len) {
                    if ((charAt line (i + 1)) == 37) {
                        return (substring line 0 i)
                    }
                }
            }
            i = (i + 1)
        }
        return line
    }

    fn statement:void (st:string) {
        if ((strlen openBox) > 0) {
            if (MermaidReader.beginsWith(st "}")) {
                openBox = ""
                return
            }
            this.readField(openBox st)
            return
        }
        def word:string (MermaidReader.firstWord(st))
        def kw:string (MermaidReader.lower(word))
        def rest:string (trim (substring st (strlen word) (strlen st)))
        if (kw == "requirementdiagram") { return }
        if (kw == "direction") {
            def dir:string (MermaidReader.upper((MermaidReader.firstWord(rest))))
            if (dir == "LR") { doc.direction = "LR" }
            if (dir == "RL") { doc.direction = "LR" }
            return
        }
        if (kw == "style")    { return }
        if (kw == "classdef") { return }
        if (kw == "class")    { return }
        if (kw == "click")    { return }
        if (st == "}")        { return }
        def kind:string (MermaidRequirementReader.kindOf(kw))
        if ((strlen kind) > 0) {
            this.readBox(kind rest)
            return
        }
        this.readRelation(st)
    }

    ; The six requirement types plus `element`, as Mermaid spells them.
    sfn kindOf:string (kw:string) {
        if (kw == "requirement")            { return "requirement" }
        if (kw == "functionalrequirement")  { return "functionalRequirement" }
        if (kw == "interfacerequirement")   { return "interfaceRequirement" }
        if (kw == "performancerequirement") { return "performanceRequirement" }
        if (kw == "physicalrequirement")    { return "physicalRequirement" }
        if (kw == "designconstraint")       { return "designConstraint" }
        if (kw == "element")                { return "element" }
        return ""
    }

    fn readBox:void (kind:string rest:string) {
        def text:string (trim rest)
        def opens:boolean false
        def brace:int (indexOf text "{")
        if (brace >= 0) {
            opens = true
            text = (trim (substring text 0 brace))
        }
        def name:string (MermaidReader.unquote((trim text)))
        if ((strlen name) == 0) {
            return
        }
        def c:UMLClass (doc.ensureBox(name))
        c.stereotype = kind
        if opens {
            openBox = name
        }
    }

    ; `id: 1`, `text: the system shall work`, `risk: high`. The value is
    ; whatever follows the colon, quotes stripped: a requirement's text is a
    ; sentence and sentences have commas in them.
    fn readField:void (owner:string text:string) {
        def body:string (trim text)
        if ((strlen body) == 0) {
            return
        }
        def cut:int (indexOf body ":")
        if (cut <= 0) {
            return
        }
        def key:string (trim (substring body 0 cut))
        def value:string (MermaidReader.unquote((trim (substring body (cut + 1) (strlen body)))))
        def c:UMLClass (doc.ensureBox(owner))
        ; A field is an attribute whose "type" is its value — the compartment
        ; node draws the name on the left and the type on the right, which is
        ; exactly the two columns a requirement's fields want.
        def m:UMLMember (c.attribute("" key value))
    }

    ; `impl - satisfies -> top`, and `top <- satisfies - impl`, which is the
    ; same sentence read from the other end.
    fn readRelation:boolean (st:string) {
        def arrow:int (indexOf st "->")
        def back:int (indexOf st "<-")
        if (arrow < 0) {
            if (back < 0) {
                return false
            }
        }
        def dash:int (indexOf st "-")
        if (dash < 0) {
            return false
        }
        def reversed:boolean false
        if (back >= 0) {
            if (arrow < 0) {
                reversed = true
            } {
                reversed = (back < arrow)
            }
        }
        ; Whatever the direction, the shape is `A <sep> word <sep> B`.
        def firstSep:int (MermaidRequirementReader.sepAt(st 0))
        if (firstSep < 0) {
            return false
        }
        def firstEnd:int (MermaidRequirementReader.sepEnd(st firstSep))
        def secondSep:int (MermaidRequirementReader.sepAt(st firstEnd))
        if (secondSep < 0) {
            return false
        }
        def secondEnd:int (MermaidRequirementReader.sepEnd(st secondSep))
        def left:string (trim (substring st 0 firstSep))
        def word:string (trim (substring st firstEnd secondSep))
        def right:string (trim (substring st secondEnd (strlen st)))
        if ((strlen left) == 0) {
            return false
        }
        if ((strlen right) == 0) {
            return false
        }
        if ((strlen word) == 0) {
            return false
        }
        doc.ensureBox(left)
        doc.ensureBox(right)
        ; A SysML relationship is a dependency: a dashed line with the name of
        ; the relationship on it.
        def from:string left
        def to:string right
        def r:UMLRelation (doc.uml.relate(from to "dependency"))
        r.label = ("«" + (MermaidReader.lower(word)) + "»")
        if reversed {
            ; `A <- satisfies - B` points at A, and the arrow is drawn where
            ; the syntax put it.
            r.markAtSource = true
        }
        return true
    }

    ; Where the `-`, `->` or `<-` that separates the parts begins.
    sfn sepAt:int (text:string from:int) {
        def i:int from
        while (i < (strlen text)) {
            def c:int (charAt text i)
            if (c == 45) {
                return i
            }
            if (c == 60) {
                if ((i + 1) < (strlen text)) {
                    if ((charAt text (i + 1)) == 45) {
                        return i
                    }
                }
            }
            i = (i + 1)
        }
        return -1
    }

    sfn sepEnd:int (text:string from:int) {
        def i:int from
        while (i < (strlen text)) {
            def c:int (charAt text i)
            if (c == 45) {
                i = (i + 1)
                continue
            }
            if (c == 60) {
                i = (i + 1)
                continue
            }
            if (c == 62) {
                i = (i + 1)
                continue
            }
            break
        }
        return i
    }
}

; ---------------------------------------------------------------------------
; The pipeline
; ---------------------------------------------------------------------------
class MermaidRequirementFlow {
    sfn parse:MermaidRequirementDiagram (src:string) {
        return (MermaidRequirementReader.parse(src))
    }

    sfn render:FlowGraph (src:string) {
        def d:MermaidRequirementDiagram (MermaidRequirementReader.parse(src))
        def bare (new FlowStyle)
        return (MermaidRequirementFlow.build(d bare))
    }

    sfn build:FlowGraph (d:MermaidRequirementDiagram style:FlowStyle) {
        def u2g (new UMLToGraph)
        def g:FlowGraph (u2g.build(d.uml))
        def i:int 0
        while (i < (g.nodeCount())) {
            def n:FlowNode (g.nodeAt(i))
            n.cssClass = "mermaid requirement"
            i = (i + 1)
        }
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            e.cssClass = "link trace"
            k = (k + 1)
        }
        def wrote:int (style.applyTo(g))
        def lay:LayeredLayout (LayeredLayout.of(g))
        lay.direction = (d.layerDirection())
        lay.layerGap = 110.0
        lay.nodeGap = 40.0
        lay.run()
        def moved:int (EdgeLanes.assign(g))
        def routed:int (lay.routeLongEdges())
        EdgeLanes.resetLanes(g)
        def refanned:int (EdgeLanes.assign(g))
        def repaired:int (OrthoRouter.repairAll(g))
        return g
    }
}

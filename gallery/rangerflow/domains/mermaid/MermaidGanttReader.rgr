; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MermaidGanttReader.rgr — a Gantt chart, placed on a real time axis.
; ============================================================================
;
; A Gantt chart is a bar per task on a shared time axis, and the axis is the
; diagram: a chart that spaced its bars evenly instead of by date would be a
; list with rounded corners. So this reader does arithmetic — it turns each
; date into a day number, works out what follows what, and places the bars.
;
;   gantt
;       title A release
;       dateFormat YYYY-MM-DD
;       section Build
;           Write it    :a1, 2024-01-01, 10d
;           Test it     :after a1, 5d
;
;   │ Build ─────────────────────────────────────
;   │  ┌────────── Write it ──────────┐
;   │                                 ┌─ Test it ─┐
;   └────────────────────────────────────────────► days
;
; **What it reads.** `title`, `section`, and a task line — `name : tags, id,
; start, duration` — where the start is a date, `after <id>`, or nothing (which
; means "when the one before it finished"), and the duration is `Nd`, `Nw`,
; `Nh` or an end date. `done`, `active`, `crit` and `milestone` become classes
; a stylesheet can match, and a milestone is drawn as the diamond it is.
;
; **What it needs.** Dates as `YYYY-MM-DD`, which is `dateFormat`'s default and
; what nearly every chart in the wild is written in. A chart in another format
; is read with its bars in the order written and the dates it could not parse
; treated as "follows the one before" — legible, and not a lie about when.
; ============================================================================

Import "MermaidReader.rgr"
Import "../../core/FlowStyleSheet.rgr"
Import "../../layout/EdgeLanes.rgr"

class MermaidGanttTask {
    def id:string ""
    def name:string ""
    def section:string ""
    ; Day numbers, counted from the civil calendar rather than from a string.
    def startDay:int 0
    def days:int 1
    def milestone:boolean false
    def tags:string ""
    ; What it was told to start after, when it was told that way.
    def after:string ""
    def hasStart:boolean false

    Constructor () {
    }

    fn endDay:int () {
        return (startDay + days)
    }
}

class MermaidGantt {
    def title:string ""
    def themeName:string ""
    def dateFormat:string "YYYY-MM-DD"
    def tasks:[MermaidGanttTask]
    def sections:[string]

    Constructor () {
    }

    fn taskCount:int () {
        return (array_length tasks)
    }

    fn sectionCount:int () {
        return (array_length sections)
    }

    fn indexOfTask:int (id:string) {
        def i:int 0
        while (i < (array_length tasks)) {
            def t:MermaidGanttTask (itemAt tasks i)
            if (t.id == id) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn firstDay:int () {
        def out:int 0
        def seen:boolean false
        def i:int 0
        while (i < (array_length tasks)) {
            def t:MermaidGanttTask (itemAt tasks i)
            if (seen == false) {
                out = t.startDay
                seen = true
            }
            if (t.startDay < out) {
                out = t.startDay
            }
            i = (i + 1)
        }
        return out
    }

    fn lastDay:int () {
        def out:int 0
        def i:int 0
        while (i < (array_length tasks)) {
            def t:MermaidGanttTask (itemAt tasks i)
            def e:int (t.endDay())
            if (e > out) {
                out = e
            }
            i = (i + 1)
        }
        return out
    }
}

class MermaidGanttReader {
    def doc:MermaidGantt (new MermaidGantt)
    def section:string ""
    def seq:int 0
    ; Where the last task ended, so a task with no start can follow it.
    def cursor:int 0
    def cursorSet:boolean false

    Constructor () {
    }

    sfn parse:MermaidGantt (src:string) {
        def r (new MermaidGanttReader)
        return (r.read(src))
    }

    fn read:MermaidGantt (src:string) {
        def lines:[string] (strsplit src "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def raw:string (trim (itemAt lines i))
            i = (i + 1)
            def line:string (trim (MermaidGanttReader.stripComment(raw)))
            if ((strlen line) == 0) {
                continue
            }
            this.statement(line)
        }
        return doc
    }

    sfn stripComment:string (line:string) {
        def len:int (strlen line)
        def i:int 0
        while (i < len) {
            def c:int (charAt line i)
            if (c == 37) {
                if ((i + 1) < len) {
                    if ((charAt line (i + 1)) == 37) {
                        return (substring line 0 i)
                    }
                }
            }
            i = (i + 1)
        }
        return line
    }

    fn statement:void (st:string) {
        def word:string (MermaidReader.firstWord(st))
        def kw:string (MermaidReader.lower(word))
        def rest:string (trim (substring st (strlen word) (strlen st)))
        if (kw == "gantt")       { return }
        if (kw == "axisformat")  { return }
        if (kw == "excludes")    { return }
        if (kw == "includes")    { return }
        if (kw == "todaymarker") { return }
        if (kw == "tickinterval") { return }
        if (kw == "weekday")     { return }
        if (kw == "acctitle")    { return }
        if (kw == "accdescr")    { return }
        if (kw == "dateformat") {
            doc.dateFormat = (trim rest)
            return
        }
        if (kw == "title") {
            doc.title = (MermaidReader.cleanLabel(rest))
            return
        }
        if (kw == "section") {
            section = (MermaidReader.cleanLabel(rest))
            push doc.sections section
            return
        }
        this.readTask(st)
    }

    ; `Write it :crit, a1, 2024-01-01, 10d` — the name, then whatever of the
    ; four the author felt like writing.
    fn readTask:void (st:string) {
        def colon:int (indexOf st ":")
        if (colon < 0) {
            return
        }
        def name:string (MermaidReader.cleanLabel((substring st 0 colon)))
        def rest:string (trim (substring st (colon + 1) (strlen st)))
        def parts:[string] (strsplit rest ",")
        def t (new MermaidGanttTask)
        t.name = name
        t.section = section
        t.id = ("task" + (to_string seq))
        seq = (seq + 1)
        def startText:string ""
        def durationText:string ""
        def i:int 0
        while (i < (array_length parts)) {
            def piece:string (trim (itemAt parts i))
            if ((strlen piece) == 0) {
                i = (i + 1)
                continue
            }
            def low:string (MermaidReader.lower(piece))
            if (low == "done") {
                t.tags = (t.tags + " done")
                i = (i + 1)
                continue
            }
            if (low == "active") {
                t.tags = (t.tags + " active")
                i = (i + 1)
                continue
            }
            if (low == "crit") {
                t.tags = (t.tags + " crit")
                i = (i + 1)
                continue
            }
            if (low == "milestone") {
                t.milestone = true
                t.tags = (t.tags + " milestone")
                i = (i + 1)
                continue
            }
            if (MermaidReader.beginsWith(low "after ")) {
                t.after = (trim (substring piece 6 (strlen piece)))
                i = (i + 1)
                continue
            }
            if ((MermaidGanttReader.isDate(piece))) {
                if ((strlen startText) == 0) {
                    startText = piece
                } {
                    durationText = piece
                }
                i = (i + 1)
                continue
            }
            if ((MermaidGanttReader.isDuration(piece))) {
                durationText = piece
                i = (i + 1)
                continue
            }
            ; Anything left over and not yet used is the task's id.
            if ((strlen t.id) > 0) {
                if ((MermaidGanttReader.looksLikeId(piece))) {
                    t.id = piece
                }
            }
            i = (i + 1)
        }
        ; Where it starts.
        if ((strlen startText) > 0) {
            t.startDay = (MermaidGanttReader.dayOf(startText))
            t.hasStart = true
        } {
            if ((strlen t.after) > 0) {
                def at:int (doc.indexOfTask(t.after))
                if (at >= 0) {
                    def other:MermaidGanttTask (itemAt doc.tasks at)
                    t.startDay = (other.endDay())
                    t.hasStart = true
                }
            }
        }
        if (t.hasStart == false) {
            if cursorSet {
                t.startDay = cursor
            }
        }
        ; How long it lasts.
        if ((strlen durationText) > 0) {
            if ((MermaidGanttReader.isDate(durationText))) {
                def endDay:int (MermaidGanttReader.dayOf(durationText))
                def span:int (endDay - t.startDay)
                if (span > 0) {
                    t.days = span
                }
            } {
                t.days = (MermaidGanttReader.daysOf(durationText))
            }
        }
        if t.milestone {
            t.days = 0
        }
        push doc.tasks t
        cursor = (t.endDay())
        cursorSet = true
    }

    ; ------------------------------------------------------------- values --
    sfn isDate:boolean (text:string) {
        if ((strlen text) < 8) {
            return false
        }
        def digits:int 0
        def dashes:int 0
        def i:int 0
        while (i < (strlen text)) {
            def c:int (charAt text i)
            if (c == 45) {
                dashes = (dashes + 1)
            } {
                if (c >= 48) {
                    if (c <= 57) {
                        digits = (digits + 1)
                    } {
                        return false
                    }
                } {
                    return false
                }
            }
            i = (i + 1)
        }
        if (dashes != 2) {
            return false
        }
        return (digits >= 6)
    }

    sfn isDuration:boolean (text:string) {
        def n:int (strlen text)
        if (n < 2) {
            return false
        }
        def unit:int (charAt text (n - 1))
        def ok:boolean false
        if (unit == 100) { ok = true }
        if (unit == 119) { ok = true }
        if (unit == 104) { ok = true }
        if (unit == 109) { ok = true }
        if (unit == 121) { ok = true }
        if (ok == false) {
            return false
        }
        def i:int 0
        while (i < (n - 1)) {
            def c:int (charAt text i)
            if (c < 48) {
                return false
            }
            if (c > 57) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    sfn looksLikeId:boolean (text:string) {
        def i:int 0
        while (i < (strlen text)) {
            def c:int (charAt text i)
            def ok:boolean (MermaidReader.isIdentCode(c))
            if (c == 45) { ok = true }
            if (ok == false) {
                return false
            }
            i = (i + 1)
        }
        return ((strlen text) > 0)
    }

    ; `30d`, `2w`, `8h`. Hours and minutes round up to a day: a Gantt chart's
    ; axis is days, and a bar of nought days wide is a bar nobody can see.
    sfn daysOf:int (text:string) {
        def n:int (strlen text)
        def unit:int (charAt text (n - 1))
        def numberText:string (substring text 0 (n - 1))
        def value@(optional):int (str2int numberText)
        def amount:int 1
        if (!null? value) {
            amount = (unwrap value)
        }
        if (unit == 119) {
            return (amount * 7)
        }
        if (unit == 121) {
            return (amount * 365)
        }
        if (unit == 104) {
            return 1
        }
        if (unit == 109) {
            return 1
        }
        return amount
    }

    ; The day number of an ISO date, by the civil-calendar formula: it is the
    ; only way to know that the 1st of March is one day after the 28th of
    ; February in a year that has no 29th.
    sfn dayOf:int (iso:string) {
        def parts:[string] (strsplit iso "-")
        if ((array_length parts) < 3) {
            return 0
        }
        def y:int (MermaidGanttReader.intOf((itemAt parts 0)))
        def m:int (MermaidGanttReader.intOf((itemAt parts 1)))
        def d:int (MermaidGanttReader.intOf((itemAt parts 2)))
        return (MermaidGanttReader.daysFromCivil(y m d))
    }

    sfn intOf:int (text:string) {
        def v@(optional):int (str2int (trim text))
        if (null? v) {
            return 0
        }
        return (unwrap v)
    }

    ; Howard Hinnant's `days_from_civil`, which is the shortest correct answer
    ; to "how many days is that date from the epoch" and has no calendar table
    ; in it.
    sfn daysFromCivil:int (y:int m:int d:int) {
        def year:int y
        if (m <= 2) {
            year = (year - 1)
        }
        def era:int (idiv year 400)
        if (year < 0) {
            era = (idiv (year - 399) 400)
        }
        def yoe:int (year - (era * 400))
        def mp:int (m + 9)
        if (m > 2) {
            mp = (m - 3)
        }
        def doy:int ((idiv (((153 * mp) + 2)) 5) + (d - 1))
        def doe:int ((((yoe * 365) + (idiv yoe 4)) - (idiv yoe 100)) + doy)
        return (((era * 146097) + doe) - 719468)
    }
}

; ---------------------------------------------------------------------------
; The pipeline
; ---------------------------------------------------------------------------
class MermaidGanttFlow {
    sfn parse:MermaidGantt (src:string) {
        return (MermaidGanttReader.parse(src))
    }

    sfn render:FlowGraph (src:string) {
        def d:MermaidGantt (MermaidGanttReader.parse(src))
        def bare (new FlowStyle)
        return (MermaidGanttFlow.build(d bare))
    }

    ; --------------------------------------------------------------------
    ; The chart. A Gantt is three things in one picture and the bars are only
    ; one of them: without the DATE AXIS a reader cannot say when anything
    ; happens, and without the SECTION BANDS they cannot say whose work it is.
    ;
    ;      │            2014-01-01   2014-01-15   2014-01-29
    ;      ├────────────┬────────────┬────────────┬──────────
    ;  Section  ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
    ;                                 ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓
    ;  Another        ▓▓▓▓▓▓▓▓▓
    ;
    ; The bands are cut from the task ORDER rather than fitted around the
    ; bounding box of each section's bars: two sections whose dates overlap
    ; have overlapping boxes, so a frame per box draws one band on top of
    ; another and loses the label underneath. A band is a run of consecutive
    ; rows, which is what a section is.
    ; --------------------------------------------------------------------
    sfn build:FlowGraph (d:MermaidGantt style:FlowStyle) {
        def g (new FlowGraph)
        if ((array_length d.tasks) == 0) {
            return g
        }
        def first:int (d.firstDay())
        def last:int (d.lastDay())
        def span:int (last - first)
        if (span < 1) {
            span = 1
        }
        ; Scaled to a page rather than to a fixed pixels-per-day: a two-year
        ; plan and a two-week one both have to be readable.
        def width:double 1100.0
        def perDay:double (width / (to_double span))
        if (perDay > 40.0) {
            perDay = 40.0
        }
        if (perDay < 1.2) {
            perDay = 1.2
        }
        def gutter:double (MermaidGanttFlow.gutterFor(d))
        def rowPitch:double 30.0
        def barH:double 22.0
        def pad:double 7.0
        def plotW:double ((to_double span) * perDay)
        def top:double 0.0
        if ((strlen d.title) > 0) {
            MermaidGanttFlow.label(g "gantt-title" d.title gutter 0.0 plotW 30.0 "mermaid gantt title axislabel")
            top = 40.0
        }
        ; The axis, above the bands. Its labels are dates because the bars are
        ; placed by date: a tick reading "12" would be a number the chart does
        ; not otherwise mention.
        def step:int (MermaidGanttFlow.tickStep(perDay))
        def axisY:double top
        def bodyTop:double (top + 26.0)
        def bodyH:double (MermaidGanttFlow.bodyHeight(d rowPitch pad))
        ; Counted from the first day rather than from a round multiple of the
        ; step: rounding leaves the left edge of the chart unlabelled, and the
        ; date the first task begins is the one a reader looks for first.
        def tick:int first
        def ti:int 0
        while (tick <= last) {
            def tx:double (gutter + ((to_double (tick - first)) * perDay))
            ; The rule first, so it goes under the bars — the bands are sent
            ; to the back after this and the bars are drawn over both.
            def rule:FlowNode (FlowNode.create(("gline-" + (to_string ti)) "" tx bodyTop))
            rule.nodeType = "gridline"
            rule.shape = "rect"
            rule.width = 1.0
            rule.height = bodyH
            rule.connectable = false
            rule.draggable = false
            rule.cssClass = "mermaid gantt gridline"
            rule.bgColor = "#d8dce8"
            rule.borderColor = "#d8dce8"
            rule.syncFromModel()
            g.addNode(rule)
            MermaidGanttFlow.label(g ("gtick-" + (to_string ti)) (MermaidGanttFlow.dateText(tick)) (tx - 44.0) axisY 88.0 22.0 "mermaid gantt tick axislabel")
            tick = (tick + step)
            ti = (ti + 1)
        }
        ; The bands, then the bars on them. One band per RUN of rows in the
        ; same section — see the note above.
        def rowY:double (bodyTop + pad)
        def bandTop:double bodyTop
        def bandName:string ""
        def bandRows:int 0
        def bands:int 0
        def i:int 0
        while (i < (array_length d.tasks)) {
            def t:MermaidGanttTask (itemAt d.tasks i)
            if (i == 0) {
                bandName = t.section
            }
            if (t.section != bandName) {
                MermaidGanttFlow.band(g bands bandName gutter bandTop plotW (((to_double bandRows) * rowPitch) + (pad * 2.0)))
                bands = (bands + 1)
                bandTop = (bandTop + (((to_double bandRows) * rowPitch) + (pad * 2.0)))
                rowY = (bandTop + pad)
                bandName = t.section
                bandRows = 0
            }
            MermaidGanttFlow.bar(g t gutter first perDay rowY rowPitch barH)
            rowY = (rowY + rowPitch)
            bandRows = (bandRows + 1)
            i = (i + 1)
        }
        if (bandRows > 0) {
            MermaidGanttFlow.band(g bands bandName gutter bandTop plotW (((to_double bandRows) * rowPitch) + (pad * 2.0)))
            bands = (bands + 1)
        }
        g.reindex()
        def wrote:int (style.applyTo(g))
        ; A band is scenery, and scenery goes behind everything. `sendToBack`
        ; moves to index 0, so the LAST one called ends up deepest — which is
        ; why the bands go back after the rules and not before them.
        def b:int 0
        while (b < bands) {
            g.sendToBack(("gband-" + (to_string b)))
            b = (b + 1)
        }
        MermaidGanttFlow.repaint(g d)
        return g
    }

    ; A section band: the strip behind a run of rows, with the section's name
    ; in the gutter beside it. Mermaid alternates two fills, and so does this —
    ; the boundary between two sections is a change of colour and nothing else.
    sfn band:void (g:FlowGraph index:int name:string gutter:double y:double w:double h:double) {
        def id:string ("gband-" + (to_string index))
        def n:FlowNode (FlowNode.create(id "" gutter y))
        n.nodeType = "group"
        n.shape = "rect"
        n.width = w
        n.height = h
        n.connectable = false
        n.draggable = false
        n.cssClass = ("mermaid gantt band " + (MermaidGanttFlow.bandClass(index)))
        n.bgColor = (MermaidGanttFlow.bandColor(index))
        n.borderColor = (MermaidGanttFlow.bandColor(index))
        n.syncFromModel()
        g.addNode(n)
        if ((strlen name) == 0) {
            return
        }
        MermaidGanttFlow.label(g (id + "-name") name 0.0 ((y + (h * 0.5)) - 13.0) (gutter - 12.0) 26.0 "mermaid gantt sectionname axislabel")
    }

    ; One task. The bar is exactly as long as the task is, which is the whole
    ; claim a Gantt chart makes — a minimum width would be a lie about a short
    ; task — so a bar too narrow for its name gets the name beside it instead.
    sfn bar:void (g:FlowGraph t:MermaidGanttTask gutter:double first:int perDay:double y:double rowPitch:double barH:double) {
        def x:double (gutter + ((to_double (t.startDay - first)) * perDay))
        def w:double ((to_double t.days) * perDay)
        if (w < 3.0) {
            w = 3.0
        }
        def cy:double (y + ((rowPitch - barH) * 0.5))
        def n:FlowNode (FlowNode.create(t.id t.name x cy))
        n.nodeType = "step"
        n.shape = "rect"
        n.borderRadius = 3.0
        n.width = w
        n.height = barH
        n.connectable = false
        n.cssClass = ("mermaid gantt bar" + t.tags)
        if t.milestone {
            n.shape = "diamond"
            n.label = ""
            n.width = barH
            n.height = barH
            n.x = (x - (barH * 0.5))
            n.cssClass = "mermaid gantt milestone"
        }
        n.syncFromModel()
        g.addNode(n)
        ; The name outside the bar, where the bar is too short to hold it. The
        ; estimate is the one the other readers size boxes with; there is no
        ; font measurer this side of the view.
        def need:double (((to_double (strlen t.name)) * 6.6) + 16.0)
        if (need > n.width) {
            n.label = ""
            n.syncFromModel()
            MermaidGanttFlow.label(g (t.id + "-name") t.name ((n.x + n.width) + 8.0) cy (need + 8.0) barH "mermaid gantt barname axislabel")
        }
    }

    sfn label:void (g:FlowGraph id:string text:string x:double y:double w:double h:double cls:string) {
        if ((strlen text) == 0) {
            return
        }
        def n:FlowNode (FlowNode.create(id text x y))
        n.nodeType = "axislabel"
        n.shape = "rect"
        n.width = w
        n.height = h
        n.connectable = false
        n.draggable = false
        n.cssClass = cls
        n.syncFromModel()
        g.addNode(n)
    }

    ; The fills. A bar drawn as an outline on a pale band is a bar you have to
    ; look for; `done`, `active` and `crit` are the states Mermaid gives a
    ; colour, and a stylesheet may say otherwise by matching them.
    sfn repaint:void (g:FlowGraph d:MermaidGantt) {
        def i:int 0
        while (i < (array_length d.tasks)) {
            def t:MermaidGanttTask (itemAt d.tasks i)
            if (g.hasNode(t.id)) {
                def n:FlowNode (g.nodeById(t.id))
                if (MermaidGanttFlow.isDefaultFill(n.bgColor)) {
                    n.bgColor = (MermaidGanttFlow.fillFor(t))
                    n.borderColor = (MermaidGanttFlow.inkFor(t))
                    n.syncFromModel()
                }
            }
            i = (i + 1)
        }
    }

    ; True while nothing has painted it on purpose. A stylesheet that set a
    ; colour has said what it wants and is not overruled here.
    sfn isDefaultFill:boolean (fill:string) {
        if ((strlen fill) == 0)  { return true }
        if (fill == "#ffffff")   { return true }
        return false
    }

    sfn fillFor:string (t:MermaidGanttTask) {
        if t.milestone { return "#d8a13c" }
        if ((MermaidGanttFlow.tagged(t "crit")))   { return "#e08585" }
        if ((MermaidGanttFlow.tagged(t "active"))) { return "#7fb2e2" }
        if ((MermaidGanttFlow.tagged(t "done")))   { return "#cbd0dc" }
        return "#a3b1dd"
    }

    sfn inkFor:string (t:MermaidGanttTask) {
        if t.milestone { return "#9a7020" }
        if ((MermaidGanttFlow.tagged(t "crit")))   { return "#b45050" }
        if ((MermaidGanttFlow.tagged(t "active"))) { return "#4a7fb0" }
        if ((MermaidGanttFlow.tagged(t "done")))   { return "#9aa0af" }
        return "#6d7cb5"
    }

    sfn tagged:boolean (t:MermaidGanttTask word:string) {
        return ((MermaidGanttFlow.indexOfText(t.tags word)) >= 0)
    }

    sfn indexOfText:int (text:string needle:string) {
        def n:int (strlen needle)
        def m:int (strlen text)
        if (n == 0) {
            return -1
        }
        def i:int 0
        while ((i + n) <= m) {
            def k:int 0
            def hit:boolean true
            while (k < n) {
                if ((charAt text (i + k)) != (charAt needle k)) {
                    hit = false
                    k = n
                }
                k = (k + 1)
            }
            if hit {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    sfn bandClass:string (index:int) {
        return ("band-" + (to_string (index % 2)))
    }

    sfn bandColor:string (index:int) {
        if ((index % 2) == 0) {
            return "#eef1f8"
        }
        return "#e3e8f3"
    }

    ; The gutter is as wide as the widest section name, because a name cut in
    ; half is a section nobody can tell from the one below it.
    sfn gutterFor:double (d:MermaidGantt) {
        def w:double 90.0
        def i:int 0
        while (i < (array_length d.tasks)) {
            def t:MermaidGanttTask (itemAt d.tasks i)
            def need:double (((to_double (strlen t.section)) * 7.0) + 30.0)
            if (need > w) {
                w = need
            }
            i = (i + 1)
        }
        if (w > 220.0) {
            w = 220.0
        }
        return w
    }

    sfn bodyHeight:double (d:MermaidGantt rowPitch:double pad:double) {
        def rows:double (to_double (array_length d.tasks))
        def bands:double (to_double (MermaidGanttFlow.bandCount(d)))
        return ((rows * rowPitch) + (bands * (pad * 2.0)))
    }

    sfn bandCount:int (d:MermaidGantt) {
        def n:int 0
        def name:string ""
        def i:int 0
        while (i < (array_length d.tasks)) {
            def t:MermaidGanttTask (itemAt d.tasks i)
            if (i == 0) {
                name = t.section
                n = 1
            } {
                if (t.section != name) {
                    n = (n + 1)
                    name = t.section
                }
            }
            i = (i + 1)
        }
        return n
    }

    ; How many days between ticks. Chosen so the labels stand about a hundred
    ; pixels apart whatever the span: ticks closer than their own labels are a
    ; grey smear, and ticks a page apart are not an axis.
    sfn tickStep:int (perDay:double) {
        def steps:[int]
        push steps 1
        push steps 2
        push steps 5
        push steps 7
        push steps 14
        push steps 30
        push steps 60
        push steps 90
        push steps 180
        push steps 365
        def i:int 0
        while (i < (array_length steps)) {
            def s:int (itemAt steps i)
            if (((to_double s) * perDay) >= 100.0) {
                return s
            }
            i = (i + 1)
        }
        return 730
    }

    ; A day number back into the date it is. Howard Hinnant's civil_from_days,
    ; which is the inverse of the `daysFromCivil` the reader turns dates with —
    ; the same arithmetic in the other direction rather than a second calendar.
    sfn dateText:string (day:int) {
        def z:int (day + 719468)
        def era:int (idiv z 146097)
        if (z < 0) {
            era = (idiv (z - 146096) 146097)
        }
        def doe:int (z - (era * 146097))
        def yoe:int (idiv ((((doe - (idiv doe 1460)) + (idiv doe 36524)) - (idiv doe 146096))) 365)
        def y:int (yoe + (era * 400))
        def doy:int (doe - (((365 * yoe) + (idiv yoe 4)) - (idiv yoe 100)))
        def mp:int (idiv (((5 * doy) + 2)) 153)
        def d:int ((doy - (idiv (((153 * mp) + 2)) 5)) + 1)
        def m:int (mp + 3)
        if (mp >= 10) {
            m = (mp - 9)
        }
        if (m <= 2) {
            y = (y + 1)
        }
        return (((to_string y) + "-") + (MermaidGanttFlow.pad2(m)) + "-" + (MermaidGanttFlow.pad2(d)))
    }

    sfn pad2:string (v:int) {
        if (v < 10) {
            return ("0" + (to_string v))
        }
        return (to_string v)
    }
}

; ============================================================================
; MermaidClassReader.rgr — a Mermaid class diagram, into the UML model.
; ============================================================================
;
; The flowchart reader beside this one refuses every other kind of diagram,
; and for a good reason: a sequence diagram read as a flowchart is a page of
; invented boxes. A CLASS diagram is the one exception worth making, because
; RangerFlow already has the model it describes — `domains/uml`, with the
; compartment node the ERD editor is built on, the hollow triangle, the filled
; diamond and the dashed realization.
;
;   classDiagram
;       Animal <|-- Duck
;       class Duck {
;           +String beakColor
;           +swim() bool
;       }
;
;   ┌──────────────┐
;   │   Animal     │        ← the supertype, and the end the triangle sits on
;   ├──────────────┤
;   └──────┬───────┘
;          △
;          │
;   ┌──────┴───────┐
;   │    Duck      │
;   ├──────────────┤
;   │ + beakColor  │
;   ├──────────────┤
;   │ + swim()     │
;   └──────────────┘
;
; So this file is a translation and not a renderer: text in, `UMLDiagram` out,
; and after that it is `UMLToGraph` and the same layout, router and backends
; every other domain uses.
;
; **What it reads.** `class X { … }` blocks and the `X : +member` one-line
; form; visibility (`+ - # ~`), the `$` static and `*` abstract classifiers,
; attribute `type name` and operation `name(params) returnType`; `<<interface>>`
; and `<<abstract>>` annotations; every relation Mermaid draws — `<|--` `--|>`
; `*--` `--*` `o--` `--o` `-->` `<--` `..>` `..|>` `--` `..` — with the
; ornament on the end the syntax names, cardinalities in quotes on either
; side, and a `: label` after.
;
; **What it drops.** `note`, `namespace` (the classes inside are read, the
; grouping is not), `style`, `cssClass`, `click`, `callback` and `link`: a
; class diagram is a picture of a program, and a hyperlink is not part of one.
; ============================================================================

Import "MermaidReader.rgr"
Import "../uml/UMLModel.rgr"

class MermaidClassDiagram {
    def title:string ""
    ; "TB" or "LR", as written. Mermaid's default for a class diagram is
    ; top-to-bottom, and so is this.
    def direction:string "TB"
    def uml:UMLDiagram (new UMLDiagram)
    ; What `%%{init: {'theme':'forest'}}%%` asked for, if anything.
    def themeName:string ""

    Constructor () {
    }

    fn classCount:int () {
        return (array_length uml.classes)
    }

    fn relationCount:int () {
        return (array_length uml.relations)
    }

    ; A class exists from the first time it is named, whether that is in a
    ; `class` block or halfway along a relation.
    fn ensureClass:UMLClass (name:string) {
        def i:int 0
        while (i < (array_length uml.classes)) {
            def c:UMLClass (itemAt uml.classes i)
            if (c.name == name) {
                return c
            }
            i = (i + 1)
        }
        return (uml.umlClass(name))
    }

    fn hasClass:boolean (name:string) {
        def i:int 0
        while (i < (array_length uml.classes)) {
            def c:UMLClass (itemAt uml.classes i)
            if (c.name == name) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn layerDirection:string () {
        if (direction == "LR") { return "LR" }
        if (direction == "RL") { return "LR" }
        return "TB"
    }
}

class MermaidClassReader {
    def doc:MermaidClassDiagram (new MermaidClassDiagram)
    ; The class whose `{ … }` block is being read, or "" between blocks.
    def openClass:string ""

    Constructor () {
    }

    sfn parse:MermaidClassDiagram (src:string) {
        def r (new MermaidClassReader)
        return (r.read(src))
    }

    fn read:MermaidClassDiagram (src:string) {
        def lines:[string] (strsplit src "\n")
        def inFront:boolean false
        def frontDone:boolean false
        def i:int 0
        while (i < (array_length lines)) {
            def raw:string (trim (itemAt lines i))
            i = (i + 1)
            if (raw == "---") {
                if (frontDone == false) {
                    if inFront {
                        inFront = false
                        frontDone = true
                    } {
                        inFront = true
                    }
                    continue
                }
            }
            if inFront {
                def cut:int (indexOf raw ":")
                if (cut > 0) {
                    def key:string (trim (substring raw 0 cut))
                    if ((MermaidReader.lower(key)) == "title") {
                        def rest:string (trim (substring raw (cut + 1) (strlen raw)))
                        doc.title = (MermaidReader.unquote(rest))
                    }
                }
                continue
            }
            def line:string (trim (this.stripComment(raw)))
            if ((strlen line) == 0) {
                continue
            }
            this.statement(line)
        }
        return doc
    }

    fn stripComment:string (line:string) {
        def len:int (strlen line)
        def q:boolean false
        def i:int 0
        while (i < len) {
            def c:int (charAt line i)
            if (c == 34) {
                if q { q = false } { q = true }
            }
            if (q == false) {
                if (c == 37) {
                    if ((i + 1) < len) {
                        if ((charAt line (i + 1)) == 37) {
                            return (substring line 0 i)
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return line
    }

    ; ---------------------------------------------------------- statements --
    fn statement:void (st:string) {
        ; Inside a `class X { … }` block every line is a member of X, until the
        ; brace that closes it.
        if ((strlen openClass) > 0) {
            if ((MermaidReader.beginsWith(st "}")) ) {
                openClass = ""
                return
            }
            this.readMember(openClass st)
            return
        }
        def word:string (MermaidReader.firstWord(st))
        def kw:string (MermaidReader.lower(word))
        def rest:string (trim (substring st (strlen word) (strlen st)))
        if (kw == "classdiagram")    { return }
        if (kw == "classdiagram-v2") { return }
        if (kw == "direction") {
            def dir:string (MermaidReader.upper((MermaidReader.firstWord(rest))))
            if (dir == "TB") { doc.direction = "TB" }
            if (dir == "TD") { doc.direction = "TB" }
            if (dir == "LR") { doc.direction = "LR" }
            if (dir == "RL") { doc.direction = "RL" }
            if (dir == "BT") { doc.direction = "TB" }
            return
        }
        ; Read and dropped — see the header.
        if (kw == "note")      { return }
        if (kw == "namespace") { return }
        if (kw == "style")     { return }
        if (kw == "cssclass")  { return }
        if (kw == "click")     { return }
        if (kw == "callback")  { return }
        if (kw == "link")      { return }
        if (kw == "accTitle")  { return }
        if (kw == "accDescr")  { return }
        if (st == "}")         { return }
        if (st == "{")         { return }
        if (kw == "class") {
            this.readClass(rest)
            return
        }
        ; `<<interface>> Shape`, the annotation written outside the block.
        if (MermaidReader.beginsWith(st "<<")) {
            def close:int (indexOf st ">>")
            if (close > 0) {
                def note:string (trim (substring st 2 close))
                def target:string (trim (substring st (close + 2) (strlen st)))
                if ((strlen target) > 0) {
                    def c:UMLClass (doc.ensureClass(target))
                    c.stereotype = note
                }
            }
            return
        }
        ; A relation, or a member written as `Class : +member`.
        if (this.readRelation(st)) {
            return
        }
        def colon:int (indexOf st ":")
        if (colon > 0) {
            def owner:string (trim (substring st 0 colon))
            def member:string (trim (substring st (colon + 1) (strlen st)))
            if ((MermaidClassReader.isName(owner))) {
                this.readMember(owner member)
                return
            }
        }
        ; A bare name declares a class, which is what `class X` does too.
        if (MermaidClassReader.isName(st)) {
            doc.ensureClass(st)
        }
    }

    ; `class Duck`, `class Duck {`, `class Duck["A label"]`.
    fn readClass:void (rest:string) {
        def name:string (trim rest)
        def opens:boolean false
        def brace:int (indexOf name "{")
        if (brace >= 0) {
            opens = true
            name = (trim (substring name 0 brace))
        }
        def label:int (indexOf name "[")
        if (label > 0) {
            name = (trim (substring name 0 label))
        }
        def tilde:int (indexOf name "~")
        if (tilde > 0) {
            ; `class Square~Shape~` — a generic. The parameter is dropped and
            ; the name kept, because a box called `Square~Shape~` is a box
            ; nobody asked for.
            name = (trim (substring name 0 tilde))
        }
        if ((strlen name) == 0) {
            return
        }
        doc.ensureClass(name)
        if opens {
            openClass = name
        }
    }

    ; ------------------------------------------------------------- members --
    ; `+String beakColor`, `+swim() bool`, `list _created_engines$`,
    ; `search(text, models) Queryset`.
    fn readMember:void (owner:string text:string) {
        def body:string (trim text)
        if ((strlen body) == 0) {
            return
        }
        if (body == "}") {
            return
        }
        def c:UMLClass (doc.ensureClass(owner))
        ; An annotation inside the block is the class's stereotype.
        if (MermaidReader.beginsWith(body "<<")) {
            def close:int (indexOf body ">>")
            if (close > 0) {
                c.stereotype = (trim (substring body 2 close))
            }
            return
        }
        def visibility:string ""
        def first:int (charAt body 0)
        if (MermaidClassReader.isVisibility(first)) {
            visibility = (strfromcode first)
            body = (trim (substring body 1 (strlen body)))
        }
        def open:int (indexOf body "(")
        if (open >= 0) {
            this.addOperation(c visibility body open)
            return
        }
        this.addAttribute(c visibility body)
    }

    fn addOperation:void (c:UMLClass visibility:string body:string open:int) {
        def name:string (trim (substring body 0 open))
        def close:int (MermaidClassReader.matchParen(body open))
        if (close < 0) {
            close = (strlen body)
        }
        def params:string (trim (substring body (open + 1) close))
        def tail:string ""
        if ((close + 1) <= (strlen body)) {
            tail = (trim (substring body (close + 1) (strlen body)))
        }
        def isStatic:boolean false
        def isAbstract:boolean false
        ; `$` static and `*` abstract sit right after the parentheses.
        while ((strlen tail) > 0) {
            def c0:int (charAt tail 0)
            if (c0 == 36) {
                isStatic = true
                tail = (trim (substring tail 1 (strlen tail)))
                continue
            }
            if (c0 == 42) {
                isAbstract = true
                tail = (trim (substring tail 1 (strlen tail)))
                continue
            }
            break
        }
        def vis:string visibility
        if ((strlen vis) == 0) {
            vis = "+"
        }
        def m:UMLMember (c.operation(vis name params tail))
        m.isStatic = isStatic
        m.isAbstract = isAbstract
    }

    fn addAttribute:void (c:UMLClass visibility:string body:string) {
        def text:string body
        def isStatic:boolean false
        def isAbstract:boolean false
        def last:int ((strlen text) - 1)
        while (last >= 0) {
            def cl:int (charAt text last)
            if (cl == 36) {
                isStatic = true
                text = (trim (substring text 0 last))
                last = ((strlen text) - 1)
                continue
            }
            if (cl == 42) {
                isAbstract = true
                text = (trim (substring text 0 last))
                last = ((strlen text) - 1)
                continue
            }
            break
        }
        ; Mermaid writes an attribute as `type name`, with the type first and
        ; often absent. A generic — `List~int~ items` — keeps its parameter,
        ; because that is the type and there is room for it in the row.
        def cut:int (MermaidClassReader.lastSpace(text))
        def memberType:string ""
        def name:string text
        if (cut > 0) {
            memberType = (trim (substring text 0 cut))
            name = (trim (substring text (cut + 1) (strlen text)))
        }
        if ((strlen name) == 0) {
            return
        }
        def vis:string visibility
        if ((strlen vis) == 0) {
            vis = "+"
        }
        def m:UMLMember (c.attribute(vis name memberType))
        m.isStatic = isStatic
        m.isAbstract = isAbstract
    }

    ; ----------------------------------------------------------- relations --
    ; `Animal <|-- Duck`, `Order "1" *-- "0..*" Line : contains`.
    ;
    ; Every relation has `--` or `..` in the middle of it, and everything else
    ; hangs off that: the ornaments are the characters either side of the line,
    ; and the ornament belongs to the end it is written next to. That is the
    ; whole grammar, and it is why the class named FIRST is the one the
    ; triangle points at.
    fn readRelation:boolean (st:string) {
        def body:string st
        def label:string ""
        ; `: label`, which is not the `Class : member` form because that one
        ; has no line in it.
        def dashes:int (MermaidClassReader.findLine(body))
        if (dashes < 0) {
            return false
        }
        def colon:int (MermaidClassReader.findTop(body 58 (dashes + 1)))
        if (colon > 0) {
            label = (trim (substring body (colon + 1) (strlen body)))
            body = (trim (substring body 0 colon))
        }
        def lineStart:int dashes
        def dotted:boolean ((charAt body lineStart) == 46)
        def lineEnd:int lineStart
        while (lineEnd < (strlen body)) {
            def c:int (charAt body lineEnd)
            if (c == 45) {
                lineEnd = (lineEnd + 1)
                continue
            }
            if (c == 46) {
                lineEnd = (lineEnd + 1)
                continue
            }
            break
        }
        def left:string (trim (substring body 0 lineStart))
        def right:string (trim (substring body lineEnd (strlen body)))

        ; The ornament written on the left sits at the END of the left side.
        def leftMark:string ""
        while ((strlen left) > 0) {
            def tailAt:int ((strlen left) - 1)
            def cc:int (charAt left tailAt)
            if (MermaidClassReader.isOrnamentCode(cc)) {
                leftMark = ((strfromcode cc) + leftMark)
                left = (trim (substring left 0 tailAt))
            } {
                break
            }
        }
        def rightMark:string ""
        while ((strlen right) > 0) {
            def rc:int (charAt right 0)
            if (MermaidClassReader.isOrnamentCode(rc)) {
                rightMark = (rightMark + (strfromcode rc))
                right = (trim (substring right 1 (strlen right)))
            } {
                break
            }
        }
        ; A cardinality is a quoted string beside the class it belongs to.
        def fromCard:string ""
        def toCard:string ""
        def leftQuote:int (MermaidClassReader.trailingQuote(left))
        if (leftQuote >= 0) {
            fromCard = (MermaidReader.unquote((substring left leftQuote (strlen left))))
            left = (trim (substring left 0 leftQuote))
        }
        if (MermaidReader.beginsWith(right "\"")) {
            ; The next quote, found by looking rather than by asking
            ; `closeIn`: that one steps OVER quoted text, which is the right
            ; thing everywhere except when the thing being closed is a quote.
            def close:int (MermaidClassReader.quoteEnd(right 1))
            if (close > 0) {
                toCard = (trim (substring right 1 close))
                right = (trim (substring right (close + 1) (strlen right)))
            }
        }
        if ((MermaidClassReader.isName(left)) == false) {
            return false
        }
        if ((MermaidClassReader.isName(right)) == false) {
            return false
        }
        doc.ensureClass(left)
        doc.ensureClass(right)
        def kind:string (MermaidClassReader.kindOf(leftMark rightMark dotted))
        def r:UMLRelation (doc.uml.relate(left right kind))
        r.label = label
        r.fromMultiplicity = fromCard
        r.toMultiplicity = toCard
        ; The ornament goes where it was written. The class named first is the
        ; supertype, the whole, the one being pointed at — and Mermaid draws it
        ; above, which is what an edge from it to the other one lays out as.
        if ((strlen leftMark) > 0) {
            r.markAtSource = true
        }
        return true
    }

    ; The relation kinds, by the ornament and whether the line is dotted.
    sfn kindOf:string (leftMark:string rightMark:string dotted:boolean) {
        def mark:string leftMark
        if ((strlen mark) == 0) {
            mark = rightMark
        }
        if ((indexOf mark "|") >= 0) {
            if dotted {
                return "implementation"
            }
            return "inheritance"
        }
        if ((indexOf mark "*") >= 0) { return "composition" }
        if ((indexOf mark "o") >= 0) { return "aggregation" }
        if ((indexOf mark ">") >= 0) {
            if dotted {
                return "dependency"
            }
            return "association"
        }
        if ((indexOf mark "<") >= 0) {
            if dotted {
                return "dependency"
            }
            return "association"
        }
        if dotted {
            return "dependency"
        }
        return "link"
    }

    ; ------------------------------------------------------------ scanning --
    ; Where the line of the relation starts: the first `--` or `..` outside a
    ; quoted cardinality.
    sfn findLine:int (text:string) {
        def n:int (strlen text)
        def q:boolean false
        def i:int 0
        while (i < (n - 1)) {
            def c:int (charAt text i)
            if (c == 34) {
                if q { q = false } { q = true }
            }
            if (q == false) {
                def nx:int (charAt text (i + 1))
                if (c == 45) {
                    if (nx == 45) { return i }
                }
                if (c == 46) {
                    if (nx == 46) { return i }
                }
            }
            i = (i + 1)
        }
        return -1
    }

    sfn findTop:int (text:string code:int from:int) {
        def q:boolean false
        def i:int from
        while (i < (strlen text)) {
            def c:int (charAt text i)
            if (c == 34) {
                if q { q = false } { q = true }
            }
            if (q == false) {
                if (c == code) {
                    return i
                }
            }
            i = (i + 1)
        }
        return -1
    }

    sfn quoteEnd:int (text:string from:int) {
        def i:int from
        while (i < (strlen text)) {
            if ((charAt text i) == 34) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; Where a trailing `"1"` begins, or -1 when the text does not end in one.
    sfn trailingQuote:int (text:string) {
        def n:int (strlen text)
        if (n < 2) {
            return -1
        }
        if ((charAt text (n - 1)) != 34) {
            return -1
        }
        def i:int (n - 2)
        while (i >= 0) {
            if ((charAt text i) == 34) {
                return i
            }
            i = (i - 1)
        }
        return -1
    }

    sfn isOrnamentCode:boolean (c:int) {
        if (c == 60)  { return true }
        if (c == 62)  { return true }
        if (c == 124) { return true }
        if (c == 42)  { return true }
        if (c == 111) { return true }
        if (c == 120) { return true }
        if (c == 41)  { return true }
        if (c == 40)  { return true }
        return false
    }

    sfn isVisibility:boolean (c:int) {
        if (c == 43)  { return true }
        if (c == 45)  { return true }
        if (c == 35)  { return true }
        if (c == 126) { return true }
        return false
    }

    ; A class name, and nothing else: no spaces, no punctuation a relation
    ; would have used. Generic parameters are kept off the name.
    sfn isName:boolean (text:string) {
        def t:string (trim text)
        if ((strlen t) == 0) {
            return false
        }
        def i:int 0
        while (i < (strlen t)) {
            def c:int (charAt t i)
            def ok:boolean (MermaidReader.isIdentCode(c))
            if (c == 45) { ok = true }
            if (c == 46) { ok = true }
            if (c == 126) { ok = true }
            if (ok == false) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    sfn lastSpace:int (text:string) {
        def at:int -1
        def i:int 0
        def depth:int 0
        while (i < (strlen text)) {
            def c:int (charAt text i)
            if (c == 40) { depth = (depth + 1) }
            if (c == 41) { depth = (depth - 1) }
            if (depth == 0) {
                if (MermaidReader.isSpaceCode(c)) {
                    at = i
                }
            }
            i = (i + 1)
        }
        return at
    }

    sfn matchParen:int (text:string open:int) {
        def depth:int 0
        def i:int open
        while (i < (strlen text)) {
            def c:int (charAt text i)
            if (c == 40) { depth = (depth + 1) }
            if (c == 41) {
                depth = (depth - 1)
                if (depth == 0) {
                    return i
                }
            }
            i = (i + 1)
        }
        return -1
    }
}

; ---------------------------------------------------------------------------
; The pipeline
; ---------------------------------------------------------------------------
; Text in, a laid-out and routed class diagram out — the same six steps the
; flowchart side takes, over the UML model rather than the flowchart one.
class MermaidClassFlow {
    sfn parse:MermaidClassDiagram (src:string) {
        return (MermaidClassReader.parse(src))
    }

    sfn render:FlowGraph (src:string) {
        def d:MermaidClassDiagram (MermaidClassReader.parse(src))
        def bare (new FlowStyle)
        return (MermaidClassFlow.build(d bare))
    }

    sfn build:FlowGraph (d:MermaidClassDiagram style:FlowStyle) {
        def u2g (new UMLToGraph)
        def g:FlowGraph (u2g.build(d.uml))
        ; What a stylesheet matches these by. A class box is a compartment
        ; node, so it answers to the same `.node` a step does, plus the words
        ; this diagram is written in.
        def i:int 0
        while (i < (g.nodeCount())) {
            def n:FlowNode (g.nodeAt(i))
            n.cssClass = "mermaid umlclass"
            i = (i + 1)
        }
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            e.cssClass = "link relation"
            k = (k + 1)
        }
        def wrote:int (style.applyTo(g))
        def lay:LayeredLayout (LayeredLayout.of(g))
        lay.direction = (d.layerDirection())
        lay.layerGap = 110.0
        lay.nodeGap = 40.0
        if ((d.layerDirection()) == "LR") {
            lay.layerGap = 150.0
        }
        lay.run()
        def moved:int (EdgeLanes.assign(g))
        def routed:int (lay.routeLongEdges())
        ; The fan again, against the routes the chains actually left — see the
        ; note on `EdgeLanes.resetLanes`.
        EdgeLanes.resetLanes(g)
        def refanned:int (EdgeLanes.assign(g))
        def repaired:int (OrthoRouter.repairAll(g))
        return g
    }
}

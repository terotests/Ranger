; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MermaidSequenceReader.rgr — a sequence diagram, drawn on a clock.
; ============================================================================
;
; Every other diagram in this directory is a graph: boxes, and lines between
; the boxes, and a layout that decides where the boxes go. A sequence diagram
; is not one. It has two axes and both of them mean something — WHO across the
; page and WHEN down it — and a layout that moved a message up to shorten a
; line would be rewriting the story.
;
;      ┌───────┐        ┌───────┐        ┌────────┐
;      │ Alice │        │  Bob  │        │ Carol  │     ← the participants
;      └───┬───┘        └───┬───┘        └────┬───┘
;          │  hello         │                 │
;          │───────────────>│                 │        ← a message, and the
;          │                ▓ ask             │          shaded bar is Bob
;          │                ▓────────────────>│          doing something
;          │                ▓<- - - - - - - - │        ← dotted: a reply
;          │<- - - - - - - -▓                 │
;          │                │                 │
;
; So this one is PLACED, like the journey and the Gantt chart next door: the
; participants get columns in the order they were declared, and the statements
; get rows in the order they were written. Nothing here asks the layout engine
; anything, because there is nothing left for it to decide.
;
; **What it reads.** Participants (`participant`/`actor`, `as` aliases, `box`
; groups, `create`/`destroy`), every arrow Mermaid has (`->` `-->` `->>`
; `-->>` `<<->>` `<<-->>` `-x` `--x` `-)` `--)`), activation — both the
; explicit `activate`/`deactivate` and the `+`/`-` shorthand on an arrow —
; notes (`left of`, `right of`, `over A,B`), `autonumber`, and the block
; statements: `loop`, `alt`/`else`, `opt`, `par`/`and`, `critical`/`option`,
; `break` and `rect`.
;
; The one thing it does not do is guess. `links`, `properties` and the styling
; directives are read and dropped rather than half-drawn, because a box with
; an invented picture in it is worse than a box without one.
; ============================================================================

Import "MermaidReader.rgr"
Import "../../core/FlowStyleSheet.rgr"
Import "../../core/SeqDiagram.rgr"

class MermaidSequenceReader {
    def doc:SeqDiagram (new SeqDiagram)
    ; The `box` currently open, and the nesting of everything that ends with
    ; `end` — a `box` and a `loop` both close with the same word, so the only
    ; way to know which one an `end` belongs to is to have kept count.
    def openBox:string ""
    def openKinds:[string]
    def autoNext:int 1
    def autoStep:int 1

    Constructor () {
    }

    sfn parse:SeqDiagram (src:string) {
        def r (new MermaidSequenceReader)
        return (r.read(src))
    }

    ; Text in, a drawing out — the whole path in one call, for a caller with
    ; no opinion about the style. The drawing itself is `SeqDiagramFlow` in
    ; `core/`, shared with every other format that has a sequence diagram.
    sfn render:FlowGraph (src:string) {
        def d:SeqDiagram (MermaidSequenceReader.parse(src))
        def bare (new FlowStyle)
        return (SeqDiagramFlow.build(d bare))
    }

    fn read:SeqDiagram (src:string) {
        def lines:[string] (strsplit src "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def raw:string (trim (itemAt lines i))
            i = (i + 1)
            def line:string (trim (MermaidSequenceReader.stripComment(raw)))
            if ((strlen line) == 0) {
                continue
            }
            this.statement(line)
        }
        return doc
    }

    sfn stripComment:string (line:string) {
        def len:int (strlen line)
        def i:int 0
        while (i < len) {
            def c:int (charAt line i)
            if (c == 37) {
                if ((i + 1) < len) {
                    if ((charAt line (i + 1)) == 37) {
                        return (substring line 0 i)
                    }
                }
            }
            i = (i + 1)
        }
        return line
    }

    fn statement:void (st:string) {
        def word:string (MermaidReader.firstWord(st))
        def kw:string (MermaidReader.lower(word))
        def rest:string (trim (substring st (strlen word) (strlen st)))
        if (kw == "sequencediagram") { return }
        if (MermaidReader.beginsWith(kw "acctitle")) { return }
        if (MermaidReader.beginsWith(kw "accdescr")) { return }
        if (kw == "links")      { return }
        if (kw == "link")       { return }
        if (kw == "properties") { return }
        if (kw == "title") {
            doc.title = (MermaidReader.cleanLabel(rest))
            return
        }
        if (kw == "autonumber") {
            this.autonumber(rest)
            return
        }
        if (kw == "participant") {
            def pi:int (this.declare(rest false -1))
            return
        }
        if (kw == "actor") {
            def ai:int (this.declare(rest true -1))
            return
        }
        if (kw == "create") {
            this.createStatement(rest)
            return
        }
        if (kw == "destroy") {
            def who:string (this.actorId(rest))
            def d (new SeqStep)
            d.kind = "destroy"
            d.target = who
            push doc.steps d
            def di:int (doc.indexOfActor(who))
            if (di >= 0) {
                def a:SeqActor (itemAt doc.actors di)
                a.destroyed = true
            }
            return
        }
        if (kw == "activate") {
            this.activation("activate" rest)
            return
        }
        if (kw == "deactivate") {
            this.activation("deactivate" rest)
            return
        }
        if (kw == "note") {
            this.note(rest)
            return
        }
        if (kw == "box") {
            openBox = (MermaidSequenceReader.boxLabel(rest))
            push doc.boxes openBox
            push openKinds "box"
            return
        }
        if (kw == "end") {
            this.closeBlock()
            return
        }
        if (MermaidSequenceReader.isBlockWord(kw)) {
            def b (new SeqStep)
            b.kind = "blockstart"
            b.blockKind = kw
            b.text = (MermaidReader.cleanLabel(rest))
            if (kw == "rect") {
                ; `rect rgb(0,255,0)` — the argument is a colour, not a name,
                ; and a box labelled "rgb(0,255,0)" says nothing to a reader.
                b.text = ""
            }
            push doc.steps b
            push openKinds "block"
            return
        }
        if (MermaidSequenceReader.isDividerWord(kw)) {
            def v (new SeqStep)
            v.kind = "divider"
            v.blockKind = kw
            v.text = (MermaidReader.cleanLabel(rest))
            push doc.steps v
            return
        }
        this.message(st)
    }

    fn closeBlock:void () {
        def n:int (array_length openKinds)
        if (n == 0) {
            return
        }
        def what:string (itemAt openKinds (n - 1))
        def kept:[string]
        def i:int 0
        while (i < (n - 1)) {
            push kept (itemAt openKinds i)
            i = (i + 1)
        }
        openKinds = kept
        if (what == "box") {
            openBox = ""
            return
        }
        def e (new SeqStep)
        e.kind = "blockend"
        push doc.steps e
    }

    sfn isBlockWord:boolean (kw:string) {
        if (kw == "loop")     { return true }
        if (kw == "alt")      { return true }
        if (kw == "opt")      { return true }
        if (kw == "par")      { return true }
        if (kw == "critical") { return true }
        if (kw == "break")    { return true }
        if (kw == "rect")     { return true }
        return false
    }

    sfn isDividerWord:boolean (kw:string) {
        if (kw == "else")   { return true }
        if (kw == "and")    { return true }
        if (kw == "option") { return true }
        return false
    }

    ; `box Aqua Buyers` — the colour is optional and comes first, so a leading
    ; colour word is dropped and what is left is the name.
    sfn boxLabel:string (rest:string) {
        def t:string (trim rest)
        def w:string (MermaidReader.firstWord(t))
        def lw:string (MermaidReader.lower(w))
        def drop:boolean false
        if (lw == "transparent") { drop = true }
        if (MermaidReader.beginsWith(lw "rgb(")) { drop = true }
        if (MermaidReader.beginsWith(lw "rgba(")) { drop = true }
        if (MermaidReader.beginsWith(lw "#")) { drop = true }
        if drop {
            return (MermaidReader.cleanLabel((trim (substring t (strlen w) (strlen t)))))
        }
        return (MermaidReader.cleanLabel(t))
    }

    fn autonumber:void (rest:string) {
        def t:string (trim rest)
        if ((MermaidReader.lower(t)) == "off") {
            doc.autonumber = false
            return
        }
        doc.autonumber = true
        if ((strlen t) == 0) {
            return
        }
        def parts:[string] (strsplit t " ")
        def got:int 0
        def i:int 0
        while (i < (array_length parts)) {
            def p:string (trim (itemAt parts i))
            i = (i + 1)
            if ((strlen p) == 0) {
                continue
            }
            def v@(optional):int (str2int p)
            if (null? v) {
                continue
            }
            if (got == 0) {
                autoNext = (unwrap v)
            }
            if (got == 1) {
                autoStep = (unwrap v)
            }
            got = (got + 1)
        }
    }

    fn createStatement:void (rest:string) {
        def w:string (MermaidReader.firstWord(rest))
        def lw:string (MermaidReader.lower(w))
        def tail:string (trim (substring rest (strlen w) (strlen rest)))
        if (lw == "participant") {
            def pi:int (this.declare(tail false (array_length doc.steps)))
            return
        }
        if (lw == "actor") {
            def ai:int (this.declare(tail true (array_length doc.steps)))
            return
        }
        def oi:int (this.declare(rest false (array_length doc.steps)))
    }

    fn activation:void (kind:string rest:string) {
        def who:string (this.actorId(rest))
        if ((strlen who) == 0) {
            return
        }
        def s (new SeqStep)
        s.kind = kind
        s.target = who
        push doc.steps s
    }

    ; `participant A as Alice`, `actor Bob`, `participant "Bob the Builder"`.
    fn declare:int (rest:string isActor:boolean createdAt:int) {
        def t:string (trim rest)
        if ((strlen t) == 0) {
            return -1
        }
        def id:string t
        def name:string ""
        def at:int (MermaidSequenceReader.asWordAt(t))
        if (at >= 0) {
            id = (trim (substring t 0 at))
            name = (MermaidReader.cleanLabel((trim (substring t (at + 4) (strlen t)))))
        }
        id = (MermaidReader.unquote((trim id)))
        if ((strlen name) == 0) {
            name = id
        }
        def idx:int (this.ensure(id))
        def a:SeqActor (itemAt doc.actors idx)
        a.name = name
        a.isActor = isActor
        a.box = openBox
        if (createdAt >= 0) {
            a.createdAt = createdAt
        }
        return idx
    }

    ; Where the word `as` stands on its own in `A as Alice`. A participant
    ; called `Gas` is not an alias, so the word has to be bounded by spaces on
    ; both sides rather than merely present.
    sfn asWordAt:int (t:string) {
        def n:int (strlen t)
        def i:int 1
        while ((i + 3) <= n) {
            if ((charAt t i) == 32) {
                def a:int (charAt t (i + 1))
                def b:int (charAt t (i + 2))
                def isAs:boolean false
                if (a == 97) {
                    if (b == 115) { isAs = true }
                }
                if (a == 65) {
                    if (b == 83) { isAs = true }
                }
                if isAs {
                    if ((i + 3) < n) {
                        if ((charAt t (i + 3)) == 32) {
                            return i
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return -1
    }

    fn ensure:int (id:string) {
        def clean:string (MermaidReader.unquote((trim id)))
        if ((strlen clean) == 0) {
            return -1
        }
        def at:int (doc.indexOfActor(clean))
        if (at >= 0) {
            return at
        }
        def a (new SeqActor)
        a.id = clean
        a.name = clean
        a.box = openBox
        push doc.actors a
        return (doc.indexOfActor(clean))
    }

    ; The first word of a statement that names one participant, with any
    ; trailing punctuation off it: `activate Bob`, `destroy Carol:`.
    fn actorId:string (rest:string) {
        def t:string (trim rest)
        def w:string (MermaidReader.firstWord(t))
        def clean:string (MermaidReader.unquote((trim w)))
        def n:int (strlen clean)
        if (n > 0) {
            if ((charAt clean (n - 1)) == 58) {
                clean = (substring clean 0 (n - 1))
            }
        }
        return clean
    }

    ; `Note right of Alice: text`, `Note over Alice,Bob: text`.
    fn note:void (rest:string) {
        def t:string (trim rest)
        def w:string (MermaidReader.firstWord(t))
        def place:string (MermaidReader.lower(w))
        def after:string (trim (substring t (strlen w) (strlen t)))
        if (place == "right") {
            def w2:string (MermaidReader.firstWord(after))
            after = (trim (substring after (strlen w2) (strlen after)))
        }
        if (place == "left") {
            def w3:string (MermaidReader.firstWord(after))
            after = (trim (substring after (strlen w3) (strlen after)))
        }
        if (place == "over") {
            place = "over"
        } {
            if (place == "right") {
                place = "right"
            } {
                if (place == "left") {
                    place = "left"
                } {
                    ; Not a placement at all — `Note: something`. Mermaid does
                    ; not accept it, and neither does this.
                    return
                }
            }
        }
        def colon:int (MermaidSequenceReader.charIndex(after 58))
        if (colon < 0) {
            return
        }
        def who:string (trim (substring after 0 colon))
        def text:string (MermaidReader.cleanLabel((substring after (colon + 1) (strlen after))))
        def names:[string] (strsplit who ",")
        if ((array_length names) == 0) {
            return
        }
        def s (new SeqStep)
        s.kind = "note"
        s.placement = place
        s.text = text
        def firstIdx:int (this.ensure((itemAt names 0)))
        if (firstIdx < 0) {
            return
        }
        def fa:SeqActor (itemAt doc.actors firstIdx)
        s.source = fa.id
        s.target = fa.id
        if ((array_length names) > 1) {
            def lastIdx:int (this.ensure((itemAt names ((array_length names) - 1))))
            if (lastIdx >= 0) {
                def la:SeqActor (itemAt doc.actors lastIdx)
                s.target = la.id
            }
        }
        push doc.steps s
    }

    ; `Alice ->>+ Bob: Hello`. Everything before the arrow is the sender,
    ; everything between the arrow and the colon is the receiver, and the
    ; `+`/`-` between them is the activation shorthand.
    fn message:void (st:string) {
        def at:int (MermaidSequenceReader.arrowAt(st))
        if (at < 0) {
            return
        }
        def tok:string (MermaidSequenceReader.arrowToken(st at))
        def left:string (trim (substring st 0 at))
        def j:int (at + (strlen tok))
        def activates:boolean false
        def deactivates:boolean false
        if (j < (strlen st)) {
            def c:int (charAt st j)
            if (c == 43) {
                activates = true
                j = (j + 1)
            }
            if (c == 45) {
                deactivates = true
                j = (j + 1)
            }
        }
        def right:string (trim (substring st j (strlen st)))
        def colon:int (MermaidSequenceReader.charIndex(right 58))
        def to:string right
        def text:string ""
        if (colon >= 0) {
            to = (trim (substring right 0 colon))
            text = (MermaidReader.cleanLabel((substring right (colon + 1) (strlen right))))
        }
        def si:int (this.ensure(left))
        def ti:int (this.ensure(to))
        if (si < 0) { return }
        if (ti < 0) { return }
        def sa:SeqActor (itemAt doc.actors si)
        def ta:SeqActor (itemAt doc.actors ti)
        def m (new SeqStep)
        m.kind = "message"
        m.source = sa.id
        m.target = ta.id
        m.text = text
        m.stroke = (MermaidSequenceReader.strokeOf(tok))
        m.head = (MermaidSequenceReader.headOf(tok))
        m.bidirectional = (MermaidReader.beginsWith(tok "<<"))
        m.activates = activates
        m.deactivates = deactivates
        if doc.autonumber {
            m.number = autoNext
            autoNext = (autoNext + autoStep)
        }
        push doc.steps m
    }

    sfn charIndex:int (t:string c:int) {
        def i:int 0
        while (i < (strlen t)) {
            if ((charAt t i) == c) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; Where the arrow starts, or -1 when the line is not a message. The scan
    ; is left to right and longest-token-first at each position, so a
    ; participant called `order-service` is not read as an arrow: `-s` is not
    ; one of the ten tokens Mermaid has.
    sfn arrowAt:int (st:string) {
        def n:int (strlen st)
        def i:int 0
        while (i < n) {
            def tok:string (MermaidSequenceReader.arrowToken(st i))
            if ((strlen tok) > 0) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    sfn arrowToken:string (st:string i:int) {
        if (MermaidSequenceReader.matches(st i "<<-->>")) { return "<<-->>" }
        if (MermaidSequenceReader.matches(st i "<<->>"))  { return "<<->>" }
        if (MermaidSequenceReader.matches(st i "-->>"))   { return "-->>" }
        if (MermaidSequenceReader.matches(st i "-->"))    { return "-->" }
        if (MermaidSequenceReader.matches(st i "--x"))    { return "--x" }
        if (MermaidSequenceReader.matches(st i "--)"))    { return "--)" }
        if (MermaidSequenceReader.matches(st i "->>"))    { return "->>" }
        if (MermaidSequenceReader.matches(st i "->"))     { return "->" }
        if (MermaidSequenceReader.matches(st i "-x"))     { return "-x" }
        if (MermaidSequenceReader.matches(st i "-)"))     { return "-)" }
        return ""
    }

    sfn matches:boolean (st:string i:int tok:string) {
        def n:int (strlen tok)
        if ((i + n) > (strlen st)) {
            return false
        }
        def k:int 0
        while (k < n) {
            if ((charAt st (i + k)) != (charAt tok k)) {
                return false
            }
            k = (k + 1)
        }
        return true
    }

    ; A doubled dash is Mermaid's "this did not happen, it came back".
    sfn strokeOf:string (tok:string) {
        if (MermaidSequenceReader.hasDoubleDash(tok)) {
            return "dotted"
        }
        return "solid"
    }

    sfn hasDoubleDash:boolean (tok:string) {
        def i:int 0
        while ((i + 1) < (strlen tok)) {
            if ((charAt tok i) == 45) {
                if ((charAt tok (i + 1)) == 45) {
                    return true
                }
            }
            i = (i + 1)
        }
        return false
    }

    sfn headOf:string (tok:string) {
        def n:int (strlen tok)
        def endc:int (charAt tok (n - 1))
        ; `-x`: it never arrived.
        if (endc == 120) {
            return "cross"
        }
        ; `-)`: it was sent and nobody waited — an open head, not a filled one.
        if (endc == 41) {
            return "arrow"
        }
        if (endc == 62) {
            ; `->` has one chevron and no head at all; `->>` has two and does.
            if (n >= 2) {
                if ((charAt tok (n - 2)) == 62) {
                    return "arrowclosed"
                }
            }
            return ""
        }
        return ""
    }
}

; ============================================================================
; MermaidMindMapReader.rgr — a Mermaid mind map, into the tree layout.
; ============================================================================
;
; The fifth Mermaid diagram, and the one with no arrows in it at all: a mind
; map is a tree, written as indentation, and `MindMapLayout` has balanced one
; either side of its root since the tree-layout pass.
;
;   mindmap
;     root((RangerFlow))
;       Domains
;         ERD
;         UML
;       Backends
;         WebGL
;         PDF
;
; **Indentation is the syntax**, which makes this the one reader here with no
; relations to parse: a line indented further than the one above it is its
; child, and a line indented less closes as many parents as it needs to. Tabs
; count as the spaces they stand for; a line indented BETWEEN two levels
; belongs to the nearer one, which is what Mermaid does and the only rule that
; does not throw away a diagram over a stray space.
;
; **Shapes.** `[]` square, `()` rounded, `(())` circle, `))((` bang, `)(` cloud,
; `{{}}` hexagon — and the default, which is a rounded box. `::icon(...)` is
; read and dropped (there is no icon font here); `:::class` becomes a class a
; stylesheet can match, the same as everywhere else.
; ============================================================================

Import "MermaidReader.rgr"
Import "../../layout/TreeLayouts.rgr"

class MermaidMindNode {
    def id:string ""
    def label:string ""
    def parent:string ""
    def depth:int 0
    ; "square" | "round" | "circle" | "bang" | "cloud" | "hexagon" | "default"
    def shape:string "default"
    def cssClass:string ""

    Constructor () {
    }
}

class MermaidMindMap {
    def title:string ""
    def themeName:string ""
    def nodes:[MermaidMindNode]

    Constructor () {
    }

    fn nodeCount:int () {
        return (array_length nodes)
    }

    fn rootId:string () {
        if ((array_length nodes) == 0) {
            return ""
        }
        def first:MermaidMindNode (itemAt nodes 0)
        return first.id
    }

    fn indexOfNode:int (id:string) {
        def i:int 0
        while (i < (array_length nodes)) {
            def n:MermaidMindNode (itemAt nodes i)
            if (n.id == id) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }
}

class MermaidMindMapReader {
    def doc:MermaidMindMap (new MermaidMindMap)
    ; The open ancestors, as (indent, id) pairs: a line indented less than the
    ; last one closes every level it is not inside any more.
    def indents:[int]
    def owners:[string]
    def seq:int 0

    Constructor () {
    }

    sfn parse:MermaidMindMap (src:string) {
        def r (new MermaidMindMapReader)
        return (r.read(src))
    }

    fn read:MermaidMindMap (src:string) {
        def lines:[string] (strsplit src "\n")
        def started:boolean false
        def inFront:boolean false
        def frontDone:boolean false
        def i:int 0
        while (i < (array_length lines)) {
            def raw:string (itemAt lines i)
            i = (i + 1)
            def trimmed:string (trim raw)
            if (trimmed == "---") {
                if (frontDone == false) {
                    if inFront {
                        inFront = false
                        frontDone = true
                    } {
                        inFront = true
                    }
                    continue
                }
            }
            if inFront {
                def cut:int (indexOf trimmed ":")
                if (cut > 0) {
                    def key:string (trim (substring trimmed 0 cut))
                    if ((MermaidReader.lower(key)) == "title") {
                        def rest:string (trim (substring trimmed (cut + 1) (strlen trimmed)))
                        doc.title = (MermaidReader.unquote(rest))
                    }
                }
                continue
            }
            def line:string (this.stripComment(raw))
            def body:string (trim line)
            if ((strlen body) == 0) {
                continue
            }
            if (started == false) {
                if ((MermaidReader.lower((MermaidReader.firstWord(body)))) == "mindmap") {
                    started = true
                    continue
                }
                continue
            }
            ; `::icon(fa fa-book)` decorates the line above it, and there is no
            ; icon font here to draw it with.
            if (MermaidReader.beginsWith(body "::icon")) {
                continue
            }
            this.entry((MermaidMindMapReader.indentOf(line)) body)
        }
        return doc
    }

    fn stripComment:string (line:string) {
        def len:int (strlen line)
        def i:int 0
        while (i < len) {
            def c:int (charAt line i)
            if (c == 37) {
                if ((i + 1) < len) {
                    if ((charAt line (i + 1)) == 37) {
                        return (substring line 0 i)
                    }
                }
            }
            i = (i + 1)
        }
        return line
    }

    ; One line of the outline: how far in it is, and what it says.
    fn entry:void (indent:int body:string) {
        ; Close every level this line is no longer inside. `<=` rather than
        ; `<`: a line at the same indent is a sibling, not a child.
        while ((array_length indents) > 0) {
            def top:int (last indents)
            if (indent > top) {
                break
            }
            removeLast indents
            removeLast owners
        }
        def parent:string ""
        if ((array_length owners) > 0) {
            parent = (last owners)
        }
        def n (new MermaidMindNode)
        n.parent = parent
        n.depth = (array_length owners)
        this.readShape(n body)
        if ((strlen n.id) == 0) {
            return
        }
        ; A node named twice in one outline is two nodes: a mind map is a tree
        ; and "Uses" can hang off two different branches.
        if ((doc.indexOfNode(n.id)) >= 0) {
            n.id = ((n.id + "-") + (to_string seq))
            seq = (seq + 1)
        }
        push doc.nodes n
        push indents indent
        push owners n.id
    }

    ; `id[label]`, `id((label))`, `label`, and the four shapes in between.
    fn readShape:void (n:MermaidMindNode body:string) {
        def text:string (trim body)
        ; `:::class` first: it is the one suffix that is not part of a shape.
        def cls:int (indexOf text ":::")
        if (cls > 0) {
            n.cssClass = (trim (substring text (cls + 3) (strlen text)))
            text = (trim (substring text 0 cls))
        }
        def open:int (MermaidMindMapReader.shapeOpen(text))
        if (open < 0) {
            ; No brackets: the whole line is the label, and its id with it.
            n.id = text
            n.label = (MermaidReader.cleanLabel(text))
            n.shape = "default"
            return
        }
        def id:string (trim (substring text 0 open))
        def rest:string (substring text open (strlen text))
        def shape:string "default"
        def openLen:int 1
        def closer:string ""
        if (MermaidReader.beginsWith(rest "((")) {
            shape = "circle"
            openLen = 2
            closer = "))"
        }
        if ((strlen closer) == 0) {
            if (MermaidReader.beginsWith(rest "))")) {
                shape = "bang"
                openLen = 2
                closer = "(("
            }
        }
        if ((strlen closer) == 0) {
            if (MermaidReader.beginsWith(rest "{{")) {
                shape = "hexagon"
                openLen = 2
                closer = "}}"
            }
        }
        if ((strlen closer) == 0) {
            if (MermaidReader.beginsWith(rest "[")) {
                shape = "square"
                closer = "]"
            }
        }
        if ((strlen closer) == 0) {
            if (MermaidReader.beginsWith(rest ")")) {
                shape = "cloud"
                closer = "("
            }
        }
        if ((strlen closer) == 0) {
            if (MermaidReader.beginsWith(rest "(")) {
                shape = "round"
                closer = ")"
            }
        }
        if ((strlen closer) == 0) {
            n.id = text
            n.label = (MermaidReader.cleanLabel(text))
            return
        }
        def close:int (MermaidReader.closeIn(rest openLen closer))
        if (close < 0) {
            n.id = text
            n.label = (MermaidReader.cleanLabel(text))
            return
        }
        def label:string (MermaidReader.cleanLabel((substring rest openLen close)))
        n.shape = shape
        n.label = label
        n.id = id
        if ((strlen n.id) == 0) {
            n.id = label
        }
    }

    ; Where the shape's bracket starts, or -1 when the line is a plain label.
    ; A bracket inside a label — `A [not a shape` — never closes, and the
    ; caller falls back to the whole line.
    sfn shapeOpen:int (text:string) {
        def i:int 0
        while (i < (strlen text)) {
            def c:int (charAt text i)
            if (c == 91) { return i }
            if (c == 40) { return i }
            if (c == 41) { return i }
            if (c == 123) { return i }
            i = (i + 1)
        }
        return -1
    }

    ; How far in a line is, with a tab counting as the spaces it stands for.
    sfn indentOf:int (line:string) {
        def n:int 0
        def i:int 0
        while (i < (strlen line)) {
            def c:int (charAt line i)
            if (c == 32) {
                n = (n + 1)
                i = (i + 1)
                continue
            }
            if (c == 9) {
                n = (n + 4)
                i = (i + 1)
                continue
            }
            break
        }
        return n
    }
}

; ---------------------------------------------------------------------------
; The pipeline
; ---------------------------------------------------------------------------
class MermaidMindMapFlow {
    sfn parse:MermaidMindMap (src:string) {
        return (MermaidMindMapReader.parse(src))
    }

    sfn render:FlowGraph (src:string) {
        def d:MermaidMindMap (MermaidMindMapReader.parse(src))
        def bare (new FlowStyle)
        return (MermaidMindMapFlow.build(d bare))
    }

    sfn build:FlowGraph (d:MermaidMindMap style:FlowStyle) {
        def g (new FlowGraph)
        def i:int 0
        while (i < (array_length d.nodes)) {
            def m:MermaidMindNode (itemAt d.nodes i)
            def n:FlowNode (FlowNode.create(m.id m.label 0.0 0.0))
            n.nodeType = "step"
            n.shape = (MermaidMindMapFlow.shapeOf(m.shape))
            def classes:string ("mermaid mind " + m.shape)
            if ((strlen m.cssClass) > 0) {
                classes = ((classes + " ") + m.cssClass)
            }
            n.cssClass = classes
            ; Sized from the text, the way every other domain here does it.
            def chars:int (strlen m.label)
            def want:double (((to_double chars) * 7.6) + 34.0)
            if (want < 96.0) { want = 96.0 }
            if (want > 240.0) { want = 240.0 }
            def h:double 44.0
            if (m.depth == 0) {
                h = 56.0
            }
            if (m.shape == "circle") {
                if (want < h) { want = h }
                h = want
            }
            n.width = want
            n.height = h
            if (m.shape == "default") {
                n.borderRadius = 14.0
            }
            if (m.shape == "round") {
                n.borderRadius = 14.0
            }
            n.addSideHandles()
            n.syncFromModel()
            g.addNode(n)
            i = (i + 1)
        }
        g.reindex()
        def k:int 0
        while (k < (array_length d.nodes)) {
            def m2:MermaidMindNode (itemAt d.nodes k)
            if ((strlen m2.parent) > 0) {
                if (g.hasNode(m2.parent)) {
                    def e:FlowEdge (FlowEdge.create("" m2.parent m2.id))
                    e.edgeType = "smoothstep"
                    ; A mind map's lines are branches rather than arrows: the
                    ; direction is the tree's, and it is already drawn by the
                    ; picture being a tree.
                    e.markerEnd = ""
                    e.cssClass = "link branch"
                    g.addEdge(e)
                }
            }
            k = (k + 1)
        }
        g.reindex()
        def wrote:int (style.applyTo(g))
        def m:MindMapLayout (MindMapLayout.of(g))
        m.rootId = (d.rootId())
        m.run()
        MindMapLayout.faceEdges(g m.centreX)
        def moved:int (EdgeLanes.assign(g))
        def repaired:int (OrthoRouter.repairAll(g))
        return g
    }

    sfn shapeOf:string (shape:string) {
        if (shape == "square")  { return "rect" }
        if (shape == "circle")  { return "circle" }
        if (shape == "hexagon") { return "hexagon" }
        ; A bang is a starburst and a cloud is a cloud; the shape library has
        ; the first and not the second, so a cloud is drawn as the rounded box
        ; it is closest to rather than as a shape it is not.
        if (shape == "bang")    { return "star" }
        return "rect"
    }
}

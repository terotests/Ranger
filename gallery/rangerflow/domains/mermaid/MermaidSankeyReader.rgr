; ============================================================================
; MermaidSankeyReader.rgr — where it all went, and how much of it.
; ============================================================================
;
; A Sankey diagram is a graph whose edges have a WIDTH, and the width is the
; whole point: it is how much went that way. Everything else follows from it —
; a node is as tall as the quantity through it, a column is as tall as the
; quantities in it, and nothing may be moved to make a line shorter, because
; a line's thickness is a number somebody measured.
;
;   Agriculture ▓▓▓▓▓▓▓▓▓╲
;                         ╲▓▓▓▓▓▓▓▓ Bio-conversion ▓▓▓▓▓╲
;   Solar       ▓▓▓╲                                     ╲▓▓▓ Losses
;                   ╲▓▓▓▓ Electricity ▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓╱
;
; The ribbons are polygons this file works out: a band from where it leaves
; the source to where it arrives at the target, sampled along a smooth curve
; so that it is a ribbon rather than a wedge. `shapePoints` takes a custom
; outline, so a Sankey is drawn by the same renderer as everything else.
;
; **What it reads.** The whole language: three CSV columns, `source,target,
; value`, with quoted fields where a name has a comma or a quote in it. That
; is all Mermaid's sankey has, which makes this the shortest reader here and
; the one that does the most arithmetic.
; ============================================================================

Import "MermaidReader.rgr"
Import "../../core/FlowStyleSheet.rgr"

class MermaidSankeyLink {
    def source:string ""
    def target:string ""
    def value:double 0.0
    ; Filled in by the builder: where the ribbon leaves and where it arrives.
    def fromY:double 0.0
    def toY:double 0.0
    def thickness:double 0.0

    Constructor () {
    }
}

class MermaidSankeyNode {
    def name:string ""
    def id:string ""
    def depth:int 0
    def inflow:double 0.0
    def outflow:double 0.0
    ; Filled in by the builder.
    def x:double 0.0
    def y:double 0.0
    def height:double 0.0
    def outUsed:double 0.0
    def inUsed:double 0.0

    Constructor () {
    }

    ; A node passes as much as goes into it or as much as comes out, whichever
    ; is larger: a source has no inflow and a sink no outflow, and both still
    ; have to be as tall as what they carry.
    fn flow:double () {
        if (inflow > outflow) {
            return inflow
        }
        return outflow
    }
}

class MermaidSankey {
    def title:string ""
    def nodes:[MermaidSankeyNode]
    def links:[MermaidSankeyLink]

    Constructor () {
    }

    fn nodeCount:int () {
        return (array_length nodes)
    }

    fn linkCount:int () {
        return (array_length links)
    }

    fn indexOf:int (name:string) {
        def i:int 0
        while (i < (array_length nodes)) {
            def n:MermaidSankeyNode (itemAt nodes i)
            if (n.name == name) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn total:double () {
        def sum:double 0.0
        def i:int 0
        while (i < (array_length links)) {
            def l:MermaidSankeyLink (itemAt links i)
            sum = (sum + l.value)
            i = (i + 1)
        }
        return sum
    }

    fn depthCount:int () {
        def m:int 0
        def i:int 0
        while (i < (array_length nodes)) {
            def n:MermaidSankeyNode (itemAt nodes i)
            if (n.depth > m) {
                m = n.depth
            }
            i = (i + 1)
        }
        return (m + 1)
    }
}

class MermaidSankeyReader {
    def doc:MermaidSankey (new MermaidSankey)
    def seq:int 0

    Constructor () {
    }

    sfn parse:MermaidSankey (src:string) {
        def r (new MermaidSankeyReader)
        return (r.read(src))
    }

    fn read:MermaidSankey (src:string) {
        def lines:[string] (strsplit src "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def raw:string (trim (itemAt lines i))
            i = (i + 1)
            if ((strlen raw) == 0) {
                continue
            }
            def word:string (MermaidReader.lower((MermaidReader.firstWord(raw))))
            if (MermaidReader.beginsWith(word "sankey")) {
                continue
            }
            if (MermaidReader.beginsWith(word "acctitle")) { continue }
            if (MermaidReader.beginsWith(word "accdescr")) { continue }
            if (MermaidReader.beginsWith(raw "%%")) {
                continue
            }
            this.row(raw)
        }
        this.rank()
        return doc
    }

    ; Three CSV fields. Mermaid's sankey is the only diagram it has whose
    ; whole grammar is a file format, so the parsing is a CSV split and
    ; nothing else.
    fn row:void (line:string) {
        def cells:[string] (MermaidSankeyReader.csv(line))
        if ((array_length cells) < 3) {
            return
        }
        def from:string (trim (itemAt cells 0))
        def to:string (trim (itemAt cells 1))
        if ((strlen from) == 0) { return }
        if ((strlen to) == 0) { return }
        def v@(optional):double (str2double (trim (itemAt cells 2)))
        if (null? v) {
            return
        }
        def amount:double (unwrap v)
        def l (new MermaidSankeyLink)
        l.source = from
        l.target = to
        l.value = amount
        push doc.links l
        def a:MermaidSankeyNode (this.ensure(from))
        a.outflow = (a.outflow + amount)
        def b:MermaidSankeyNode (this.ensure(to))
        b.inflow = (b.inflow + amount)
    }

    fn ensure:MermaidSankeyNode (name:string) {
        def at:int (doc.indexOf(name))
        if (at >= 0) {
            return (itemAt doc.nodes at)
        }
        def n (new MermaidSankeyNode)
        n.name = name
        n.id = ("sn" + (to_string seq))
        seq = (seq + 1)
        push doc.nodes n
        return n
    }

    ; How far down the chain each node is: nothing that flows into it, and it
    ; is at the start; otherwise one further than whatever feeds it. Repeated
    ; until it settles, and capped, because a Sankey with a loop in it is a
    ; Sankey somebody wrote wrong and it still has to draw.
    fn rank:void () {
        def rounds:int 0
        def changed:boolean true
        while changed {
            changed = false
            rounds = (rounds + 1)
            if (rounds > 64) {
                return
            }
            def i:int 0
            while (i < (array_length doc.links)) {
                def l:MermaidSankeyLink (itemAt doc.links i)
                def si:int (doc.indexOf(l.source))
                def ti:int (doc.indexOf(l.target))
                if (si >= 0) {
                    if (ti >= 0) {
                        def a:MermaidSankeyNode (itemAt doc.nodes si)
                        def b:MermaidSankeyNode (itemAt doc.nodes ti)
                        if (b.depth <= a.depth) {
                            b.depth = (a.depth + 1)
                            changed = true
                        }
                    }
                }
                i = (i + 1)
            }
        }
    }

    ; A CSV row with quoted fields. Mermaid allows both quote characters and
    ; doubles one to escape it, which is the spreadsheet convention.
    sfn csv:[string] (line:string) {
        def out:[string]
        def cur:string ""
        def n:int (strlen line)
        def i:int 0
        def quote:int 0
        while (i < n) {
            def c:int (charAt line i)
            if (quote == 0) {
                if (c == 44) {
                    push out cur
                    cur = ""
                    i = (i + 1)
                    continue
                }
                ; A quote only opens a field at its START. `Agricultural
                ; 'waste'` is one name with an apostrophe in it, not a quoted
                ; string, and Mermaid reads it that way too.
                if ((strlen cur) == 0) {
                    if (c == 34) {
                        quote = 34
                        i = (i + 1)
                        continue
                    }
                    if (c == 39) {
                        quote = 39
                        i = (i + 1)
                        continue
                    }
                }
                cur = (cur + (strfromcode c))
                i = (i + 1)
                continue
            }
            if (c == quote) {
                if ((i + 1) < n) {
                    if ((charAt line (i + 1)) == quote) {
                        cur = (cur + (strfromcode c))
                        i = (i + 2)
                        continue
                    }
                }
                quote = 0
                i = (i + 1)
                continue
            }
            cur = (cur + (strfromcode c))
            i = (i + 1)
        }
        push out cur
        return out
    }
}

; ---------------------------------------------------------------------------
; The pipeline
; ---------------------------------------------------------------------------
class MermaidSankeyFlow {
    sfn parse:MermaidSankey (src:string) {
        return (MermaidSankeyReader.parse(src))
    }

    sfn render:FlowGraph (src:string) {
        def d:MermaidSankey (MermaidSankeyReader.parse(src))
        def bare (new FlowStyle)
        return (MermaidSankeyFlow.build(d bare))
    }

    sfn build:FlowGraph (d:MermaidSankey style:FlowStyle) {
        def g (new FlowGraph)
        if ((d.linkCount()) == 0) {
            return g
        }
        def columns:int (d.depthCount())
        def plotH:double 620.0
        def colGap:double 230.0
        def barW:double 22.0
        def nodeGap:double 14.0
        ; The scale: the busiest column decides it, because every column has to
        ; fit on the same page and they all have to be measured the same way.
        def busiest:double (MermaidSankeyFlow.busiestColumn(d columns))
        if (busiest <= 0.0) {
            return g
        }
        def maxNodes:int (MermaidSankeyFlow.mostNodes(d columns))
        def room:double (plotH - ((to_double (maxNodes - 1)) * nodeGap))
        if (room < 60.0) {
            room = 60.0
        }
        def scale:double (room / busiest)
        def col:int 0
        while (col < columns) {
            def y:double 0.0
            def i:int 0
            while (i < (array_length d.nodes)) {
                def n:MermaidSankeyNode (itemAt d.nodes i)
                if (n.depth == col) {
                    n.x = ((to_double col) * colGap)
                    n.y = y
                    n.height = ((n.flow()) * scale)
                    if (n.height < 3.0) {
                        n.height = 3.0
                    }
                    n.outUsed = 0.0
                    n.inUsed = 0.0
                    y = ((y + n.height) + nodeGap)
                }
                i = (i + 1)
            }
            col = (col + 1)
        }
        ; The ribbons first, so the bars are drawn on top of where they land.
        def k:int 0
        while (k < (array_length d.links)) {
            def l:MermaidSankeyLink (itemAt d.links k)
            def si:int (d.indexOf(l.source))
            def ti:int (d.indexOf(l.target))
            if (si >= 0) {
                if (ti >= 0) {
                    def a:MermaidSankeyNode (itemAt d.nodes si)
                    def b:MermaidSankeyNode (itemAt d.nodes ti)
                    l.thickness = (l.value * scale)
                    if (l.thickness < 1.0) {
                        l.thickness = 1.0
                    }
                    l.fromY = (a.y + a.outUsed)
                    l.toY = (b.y + b.inUsed)
                    a.outUsed = (a.outUsed + l.thickness)
                    b.inUsed = (b.inUsed + l.thickness)
                    def ribbon:FlowNode (MermaidSankeyFlow.ribbon(l (a.x + barW) b.x si k))
                    g.addNode(ribbon)
                }
            }
            k = (k + 1)
        }
        def m:int 0
        while (m < (array_length d.nodes)) {
            def n2:MermaidSankeyNode (itemAt d.nodes m)
            def bar:FlowNode (FlowNode.create(n2.id "" n2.x n2.y))
            bar.nodeType = "flownode"
            bar.shape = "rect"
            bar.width = barW
            bar.height = n2.height
            bar.borderRadius = 2.0
            bar.connectable = false
            bar.cssClass = ("mermaid flownode " + (MermaidSankeyFlow.tint(m)))
            bar.bgColor = (MermaidSankeyFlow.colorAt(m))
            bar.borderColor = (MermaidSankeyFlow.colorAt(m))
            ; The name goes beside the bar, on the side with room: at the far
            ; right of the chart there is nothing to the right of it.
            def onRight:boolean true
            if (n2.depth == (columns - 1)) {
                onRight = false
            }
            ; The box is sized to the name, so that centring the text in it
            ; puts the name BESIDE the bar rather than a fixed distance from
            ; it: a short name centred in a wide box floats out on its own.
            def label:FlowAnnotation (bar.addAnnotation(n2.name 0.5 0.5))
            label.fontSize = 12.0
            def room:double (((to_double (strlen n2.name)) * 6.8) + 16.0)
            label.width = room
            def reach:double (1.0 + (((room * 0.5) + 8.0) / barW))
            if onRight {
                label.offsetX = reach
            } {
                label.offsetX = (0.0 - (reach - 1.0))
            }
            bar.syncFromModel()
            g.addNode(bar)
            m = (m + 1)
        }
        g.reindex()
        def wrote:int (style.applyTo(g))
        def r:int 0
        while (r < (array_length d.links)) {
            def link:MermaidSankeyLink (itemAt d.links r)
            def owner:int (d.indexOf(link.source))
            if (owner < 0) {
                owner = 0
            }
            MermaidSankeyFlow.repaint(g ("rb" + (to_string r)) (MermaidSankeyFlow.paleAt(owner)))
            r = (r + 1)
        }
        def b2:int 0
        while (b2 < (array_length d.nodes)) {
            def n3:MermaidSankeyNode (itemAt d.nodes b2)
            MermaidSankeyFlow.repaint(g n3.id (MermaidSankeyFlow.colorAt(b2)))
            b2 = (b2 + 1)
        }
        return g
    }

    sfn repaint:void (g:FlowGraph id:string color:string) {
        if ((g.hasNode(id)) == false) {
            return
        }
        def n:FlowNode (g.nodeById(id))
        n.bgColor = color
        n.borderColor = color
        n.syncFromModel()
    }

    ; A ribbon: the band from where it leaves to where it arrives, sampled
    ; along a smooth curve so it reads as a flow rather than as a wedge.
    sfn ribbon:FlowNode (l:MermaidSankeyLink x0:double x1:double colorIndex:int index:int) {
        def xs:[double]
        def ys:[double]
        def steps:int 16
        def i:int 0
        while (i <= steps) {
            def t:double ((to_double i) / (to_double steps))
            def e:double (MermaidSankeyFlow.ease(t))
            push xs (x0 + ((x1 - x0) * t))
            push ys (l.fromY + ((l.toY - l.fromY) * e))
            i = (i + 1)
        }
        def k:int steps
        while (k >= 0) {
            def t2:double ((to_double k) / (to_double steps))
            def e2:double (MermaidSankeyFlow.ease(t2))
            push xs (x0 + ((x1 - x0) * t2))
            push ys ((l.fromY + ((l.toY - l.fromY) * e2)) + l.thickness)
            k = (k - 1)
        }
        def minX:double (itemAt xs 0)
        def maxX:double minX
        def minY:double (itemAt ys 0)
        def maxY:double minY
        def p:int 0
        while (p < (array_length xs)) {
            def x:double (itemAt xs p)
            def y:double (itemAt ys p)
            if (x < minX) { minX = x }
            if (x > maxX) { maxX = x }
            if (y < minY) { minY = y }
            if (y > maxY) { maxY = y }
            p = (p + 1)
        }
        def w:double (maxX - minX)
        def h:double (maxY - minY)
        if (w < 1.0) { w = 1.0 }
        if (h < 1.0) { h = 1.0 }
        def n:FlowNode (FlowNode.create(("rb" + (to_string index)) "" minX minY))
        ; A `group`, so that it is painted before the bars rather than over
        ; them: the ribbons are the paper this diagram is written on.
        n.nodeType = "group"
        n.shape = "polygon"
        n.width = w
        n.height = h
        n.connectable = false
        n.draggable = false
        n.cssClass = ("mermaid ribbon " + (MermaidSankeyFlow.tint(colorIndex)))
        n.bgColor = (MermaidSankeyFlow.paleAt(colorIndex))
        n.borderColor = (MermaidSankeyFlow.paleAt(colorIndex))
        clear n.shapePoints
        def q:int 0
        while (q < (array_length xs)) {
            push n.shapePoints (((itemAt xs q) - minX) / w)
            push n.shapePoints (((itemAt ys q) - minY) / h)
            q = (q + 1)
        }
        n.syncFromModel()
        return n
    }

    ; Smoothstep: flat where it leaves and flat where it arrives, so the
    ; ribbon meets both bars square on.
    sfn ease:double (t:double) {
        return ((t * t) * (3.0 - (2.0 * t)))
    }

    sfn busiestColumn:double (d:MermaidSankey columns:int) {
        def best:double 0.0
        def col:int 0
        while (col < columns) {
            def sum:double 0.0
            def i:int 0
            while (i < (array_length d.nodes)) {
                def n:MermaidSankeyNode (itemAt d.nodes i)
                if (n.depth == col) {
                    sum = (sum + (n.flow()))
                }
                i = (i + 1)
            }
            if (sum > best) {
                best = sum
            }
            col = (col + 1)
        }
        return best
    }

    sfn mostNodes:int (d:MermaidSankey columns:int) {
        def best:int 1
        def col:int 0
        while (col < columns) {
            def n:int 0
            def i:int 0
            while (i < (array_length d.nodes)) {
                def node:MermaidSankeyNode (itemAt d.nodes i)
                if (node.depth == col) {
                    n = (n + 1)
                }
                i = (i + 1)
            }
            if (n > best) {
                best = n
            }
            col = (col + 1)
        }
        return best
    }

    sfn tint:string (index:int) {
        return ("flow-" + (to_string (index % 10)))
    }

    sfn colorAt:string (index:int) {
        def i:int (index % 10)
        if (i == 0) { return "#4c78a8" }
        if (i == 1) { return "#f58518" }
        if (i == 2) { return "#54a24b" }
        if (i == 3) { return "#e45756" }
        if (i == 4) { return "#72b7b2" }
        if (i == 5) { return "#b279a2" }
        if (i == 6) { return "#eeca3b" }
        if (i == 7) { return "#9d755d" }
        if (i == 8) { return "#ff9da6" }
        return "#79706e"
    }

    ; The same ten, mixed most of the way to white. Ribbons overlap and there
    ; is no opacity in the display list, so the pale one is the transparency.
    sfn paleAt:string (index:int) {
        def i:int (index % 10)
        if (i == 0) { return "#c6d3e4" }
        if (i == 1) { return "#fbdcbe" }
        if (i == 2) { return "#cbe4c6" }
        if (i == 3) { return "#f7c9c9" }
        if (i == 4) { return "#d6ebea" }
        if (i == 5) { return "#e4d3e0" }
        if (i == 6) { return "#f9eec4" }
        if (i == 7) { return "#e2d5cc" }
        if (i == 8) { return "#ffe2e5" }
        return "#d6d3d2"
    }
}

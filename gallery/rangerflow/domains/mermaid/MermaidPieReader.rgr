; ============================================================================
; MermaidPieReader.rgr — the one diagram that is arithmetic all the way down.
; ============================================================================
;
; A pie chart has no nodes and no edges. It has a list of numbers and one
; rule: each one gets the share of a circle that it is of their total. So
; there is nothing here to lay out, and nothing to route — only wedges, and
; each wedge is a polygon this file works out.
;
;        ╭───────────╮
;      ╭─┤    42%    ├─╮        "Calcium"   : 42.96
;    ╭─┤ ╰─────┬─────╯ ├─╮      "Potassium" : 50.05
;    │ │       │       │ │      "Magnesium" : 10.01
;    │ │  50%  │  10%  │ │
;    ╰─┤       │       ├─╯
;      ╰───────┴───────╯
;
; The shape library has no wedge, so the wedges are given as polygons: a fan
; of points along the arc, the centre, and back. That is what `shapePoints`
; is for — a custom outline in unit coordinates — and it means a pie is drawn
; by the same renderer as everything else rather than by a special case.
;
; **What it reads.** `pie`, `showData`, `title`, and the `"Label" : number`
; lines. The legend is drawn beside the circle rather than inside it, because
; a chart with eleven slices has no room for eleven words in the middle.
; ============================================================================

Import "MermaidReader.rgr"
Import "../../core/FlowStyleSheet.rgr"

class MermaidPieSlice {
    def id:string ""
    def label:string ""
    def value:double 0.0
    ; Filled in by the builder: the share of the circle, 0..1.
    def share:double 0.0

    Constructor () {
    }
}

class MermaidPie {
    def title:string ""
    ; `pie showData` — write the number beside the name in the legend.
    def showData:boolean false
    def slices:[MermaidPieSlice]

    Constructor () {
    }

    fn sliceCount:int () {
        return (array_length slices)
    }

    fn total:double () {
        def sum:double 0.0
        def i:int 0
        while (i < (array_length slices)) {
            def s:MermaidPieSlice (itemAt slices i)
            sum = (sum + s.value)
            i = (i + 1)
        }
        return sum
    }
}

class MermaidPieReader {
    def doc:MermaidPie (new MermaidPie)
    def seq:int 0

    Constructor () {
    }

    sfn parse:MermaidPie (src:string) {
        def r (new MermaidPieReader)
        return (r.read(src))
    }

    fn read:MermaidPie (src:string) {
        def lines:[string] (strsplit src "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def raw:string (trim (itemAt lines i))
            i = (i + 1)
            def line:string (trim (MermaidPieReader.stripComment(raw)))
            if ((strlen line) == 0) {
                continue
            }
            this.statement(line)
        }
        return doc
    }

    sfn stripComment:string (line:string) {
        def len:int (strlen line)
        def i:int 0
        while (i < len) {
            def c:int (charAt line i)
            if (c == 37) {
                if ((i + 1) < len) {
                    if ((charAt line (i + 1)) == 37) {
                        return (substring line 0 i)
                    }
                }
            }
            i = (i + 1)
        }
        return line
    }

    fn statement:void (st:string) {
        def word:string (MermaidReader.firstWord(st))
        def kw:string (MermaidReader.lower(word))
        def rest:string (trim (substring st (strlen word) (strlen st)))
        if (kw == "pie") {
            ; `pie showData` and `pie title Something` are both one line.
            def next:string (MermaidReader.lower((MermaidReader.firstWord(rest))))
            if (next == "showdata") {
                doc.showData = true
                def after:string (trim (substring rest (strlen next) (strlen rest)))
                if ((strlen after) > 0) {
                    this.statement(after)
                }
            } {
                if ((strlen rest) > 0) {
                    this.statement(rest)
                }
            }
            return
        }
        if (kw == "showdata") {
            doc.showData = true
            return
        }
        if (MermaidReader.beginsWith(kw "acctitle")) { return }
        if (MermaidReader.beginsWith(kw "accdescr")) { return }
        if (kw == "title") {
            doc.title = (MermaidReader.cleanLabel(rest))
            return
        }
        this.slice(st)
    }

    ; `"Calcium" : 42.96` — and the quotes are not optional in Mermaid, but a
    ; line without them is unambiguous and there is no reason to refuse it.
    fn slice:void (st:string) {
        def colon:int (MermaidPieReader.lastColon(st))
        if (colon < 0) {
            return
        }
        def name:string (MermaidReader.cleanLabel((trim (substring st 0 colon))))
        if ((strlen name) == 0) {
            return
        }
        def numberText:string (trim (substring st (colon + 1) (strlen st)))
        def v@(optional):double (str2double numberText)
        if (null? v) {
            return
        }
        def s (new MermaidPieSlice)
        s.id = ("slice" + (to_string seq))
        seq = (seq + 1)
        s.label = name
        s.value = (unwrap v)
        push doc.slices s
    }

    ; The colon that separates the name from the number is the LAST one: a
    ; slice called "Tuesday: the good one" has one of its own.
    sfn lastColon:int (st:string) {
        def at:int -1
        def i:int 0
        while (i < (strlen st)) {
            if ((charAt st i) == 58) {
                at = i
            }
            i = (i + 1)
        }
        return at
    }
}

; ---------------------------------------------------------------------------
; The pipeline
; ---------------------------------------------------------------------------
class MermaidPieFlow {
    sfn parse:MermaidPie (src:string) {
        return (MermaidPieReader.parse(src))
    }

    sfn render:FlowGraph (src:string) {
        def d:MermaidPie (MermaidPieReader.parse(src))
        def bare (new FlowStyle)
        return (MermaidPieFlow.build(d bare))
    }

    sfn build:FlowGraph (d:MermaidPie style:FlowStyle) {
        def g (new FlowGraph)
        def total:double (d.total())
        if (total <= 0.0) {
            return g
        }
        def r:double 230.0
        def cx:double r
        def cy:double r
        def turn:double 6.283185307179586
        def quarter:double 1.5707963267948966
        def at:double (0.0 - quarter)
        def i:int 0
        while (i < (array_length d.slices)) {
            def s:MermaidPieSlice (itemAt d.slices i)
            s.share = (s.value / total)
            def sweep:double (s.share * turn)
            def n:FlowNode (MermaidPieFlow.wedge(s cx cy r at (at + sweep) i))
            g.addNode(n)
            at = (at + sweep)
            i = (i + 1)
        }
        ; The legend, beside the circle. A pie with eleven slices has no room
        ; for eleven words in the middle of it, and a chart nobody can read
        ; the labels of is a coloured disc.
        def legendX:double ((r * 2.0) + 46.0)
        def k:int 0
        while (k < (array_length d.slices)) {
            def s2:MermaidPieSlice (itemAt d.slices k)
            def y:double (30.0 + ((to_double k) * 30.0))
            def swatch:FlowNode (FlowNode.create(("key-" + s2.id) "" legendX y))
            swatch.nodeType = "swatch"
            swatch.shape = "rect"
            swatch.width = 18.0
            swatch.height = 18.0
            swatch.borderRadius = 3.0
            swatch.connectable = false
            swatch.cssClass = ("mermaid swatch " + (MermaidPieFlow.sliceClass(k)))
            swatch.bgColor = (MermaidPieFlow.colorAt(k))
            swatch.borderColor = "#1f2430"
            swatch.syncFromModel()
            g.addNode(swatch)
            def text:string s2.label
            if d.showData {
                text = ((s2.label + "   ") + (MermaidPieFlow.numberText(s2.value)))
            }
            text = ((text + "   ") + (MermaidPieFlow.percentText(s2.share)))
            ; The box is sized to the words in it. A legend of fixed width
            ; centres short names in the middle of nothing, and a column of
            ; text that starts in a different place on every row is a column
            ; nobody can read down.
            def keyWidth:double (((to_double (strlen text)) * 7.0) + 24.0)
            if (keyWidth < 90.0) { keyWidth = 90.0 }
            def name:FlowNode (FlowNode.create(("name-" + s2.id) text (legendX + 26.0) (y - 5.0)))
            name.nodeType = "legend"
            name.shape = "rect"
            name.width = keyWidth
            name.height = 28.0
            name.connectable = false
            name.draggable = false
            name.cssClass = "mermaid legend axislabel"
            name.syncFromModel()
            g.addNode(name)
            k = (k + 1)
        }
        g.reindex()
        def wrote:int (style.applyTo(g))
        ; The slice colours are the chart. A sheet may replace them by
        ; matching `.slice-3`, but the default palette is not the theme's one
        ; fill repeated eleven times.
        def c:int 0
        while (c < (array_length d.slices)) {
            def s3:MermaidPieSlice (itemAt d.slices c)
            MermaidPieFlow.paint(g s3.id c)
            MermaidPieFlow.paint(g ("key-" + s3.id) c)
            c = (c + 1)
        }
        return g
    }

    sfn paint:void (g:FlowGraph id:string index:int) {
        if ((g.hasNode(id)) == false) {
            return
        }
        def n:FlowNode (g.nodeById(id))
        if ((strlen n.bgColor) == 0) {
            n.bgColor = (MermaidPieFlow.colorAt(index))
        }
        if (n.bgColor == "#ffffff") {
            n.bgColor = (MermaidPieFlow.colorAt(index))
        }
        n.syncFromModel()
    }

    ; One wedge, as the polygon the shape library has no name for: the centre,
    ; a fan of points along the arc, and back. The points are worked out in
    ; page coordinates and then divided by the box they turned out to need,
    ; because `shapePoints` is a unit outline.
    sfn wedge:FlowNode (s:MermaidPieSlice cx:double cy:double r:double a0:double a1:double index:int) {
        def xs:[double]
        def ys:[double]
        push xs cx
        push ys cy
        ; One point every four degrees or so, and never fewer than two: a
        ; wedge of half a percent still has to have an outside edge.
        def steps:int (MermaidPieFlow.stepsFor(a1 - a0))
        def k:int 0
        while (k <= steps) {
            def t:double ((to_double k) / (to_double steps))
            def a:double (a0 + ((a1 - a0) * t))
            push xs (cx + (r * (cos a)))
            push ys (cy + (r * (sin a)))
            k = (k + 1)
        }
        def minX:double (itemAt xs 0)
        def maxX:double minX
        def minY:double (itemAt ys 0)
        def maxY:double minY
        def i:int 0
        while (i < (array_length xs)) {
            def x:double (itemAt xs i)
            def y:double (itemAt ys i)
            if (x < minX) { minX = x }
            if (x > maxX) { maxX = x }
            if (y < minY) { minY = y }
            if (y > maxY) { maxY = y }
            i = (i + 1)
        }
        def w:double (maxX - minX)
        def h:double (maxY - minY)
        if (w < 1.0) { w = 1.0 }
        if (h < 1.0) { h = 1.0 }
        def n:FlowNode (FlowNode.create(s.id "" minX minY))
        n.nodeType = "slice"
        n.shape = "polygon"
        n.width = w
        n.height = h
        n.connectable = false
        n.draggable = false
        n.cssClass = ("mermaid slice " + (MermaidPieFlow.sliceClass(index)))
        n.bgColor = (MermaidPieFlow.colorAt(index))
        n.borderColor = "#ffffff"
        clear n.shapePoints
        def p:int 0
        while (p < (array_length xs)) {
            push n.shapePoints (((itemAt xs p) - minX) / w)
            push n.shapePoints (((itemAt ys p) - minY) / h)
            p = (p + 1)
        }
        n.syncFromModel()
        return n
    }

    sfn stepsFor:int (sweep:double) {
        def perStep:double 0.07
        def n:int 2
        def acc:double perStep
        while (acc < sweep) {
            n = (n + 1)
            acc = (acc + perStep)
        }
        return n
    }

    sfn sliceClass:string (index:int) {
        return ("slice-" + (to_string (index % 12)))
    }

    ; Twelve colours that stay apart from each other on a screen and on paper.
    ; A stylesheet that disagrees can say so by matching `.slice-3`.
    sfn colorAt:string (index:int) {
        def i:int (index % 12)
        if (i == 0)  { return "#4c78a8" }
        if (i == 1)  { return "#f58518" }
        if (i == 2)  { return "#54a24b" }
        if (i == 3)  { return "#e45756" }
        if (i == 4)  { return "#72b7b2" }
        if (i == 5)  { return "#b279a2" }
        if (i == 6)  { return "#eeca3b" }
        if (i == 7)  { return "#9d755d" }
        if (i == 8)  { return "#bab0ac" }
        if (i == 9)  { return "#ff9da6" }
        if (i == 10) { return "#79706e" }
        return "#8c6d31"
    }

    ; A number as a reader would write it: no decimals where there are none.
    sfn numberText:string (v:double) {
        def whole:int (to_int v)
        def back:double (to_double whole)
        if ((fabs (v - back)) < 0.0005) {
            return (to_string whole)
        }
        def hundredths:int (to_int ((v * 100.0) + 0.5))
        def a:int (idiv hundredths 100)
        def b:int (hundredths - (a * 100))
        def frac:string (to_string b)
        if (b < 10) {
            frac = ("0" + frac)
        }
        return ((to_string a) + "." + frac)
    }

    sfn percentText:string (share:double) {
        def tenths:int (to_int ((share * 1000.0) + 0.5))
        def a:int (idiv tenths 10)
        def b:int (tenths - (a * 10))
        return ((("(" + (to_string a)) + "." + (to_string b)) + "%)")
    }
}

; ============================================================================
; MermaidIshikawaReader.rgr — a fishbone, which is a tree drawn sideways.
; ============================================================================
;
; An Ishikawa diagram is a cause-and-effect tree with one strong convention
; about how it is drawn: the effect is the head of the fish, the spine runs
; back from it, and the causes come off the spine at an angle, alternating
; above and below so that a long list still fits on a page.
;
;      Machine            Method
;         ╲                  ╲
;      Old truck          No plan
;           ╲                 ╲          ┌──────────────┐
;   ─────────╳─────────────────╳─────────┤ Late delivery│
;           ╱                 ╱          └──────────────┘
;      No spares          Rushed
;         ╱                  ╱
;      Material           People
;
; **What it reads.** Indentation, and nothing else — which is the whole of
; Mermaid's grammar for it. The first line is the effect; the lines under it
; are the categories; the lines under those are the causes, as deep as they
; go.
; ============================================================================

Import "MermaidReader.rgr"
Import "../../core/FlowStyleSheet.rgr"

class MermaidIshikawaNode {
    def id:string ""
    def text:string ""
    def depth:int 0
    def children:[MermaidIshikawaNode]

    Constructor () {
    }

    fn childCount:int () {
        return (array_length children)
    }
}

class MermaidIshikawa {
    def problem:string ""
    def root:MermaidIshikawaNode (new MermaidIshikawaNode)

    Constructor () {
    }

    fn categoryCount:int () {
        return (array_length root.children)
    }

    ; The causes, which are everything below a category — the categories
    ; themselves are not causes of anything, they are the headings.
    fn causeCount:int () {
        return ((MermaidIshikawa.countBelow(root)) - (array_length root.children))
    }

    sfn countBelow:int (n:MermaidIshikawaNode) {
        def total:int 0
        def i:int 0
        while (i < (array_length n.children)) {
            def c:MermaidIshikawaNode (itemAt n.children i)
            total = ((total + 1) + (MermaidIshikawa.countBelow(c)))
            i = (i + 1)
        }
        return total
    }
}

class MermaidIshikawaReader {
    def doc:MermaidIshikawa (new MermaidIshikawa)
    ; The chain of open parents, one per indentation level.
    def stack:[MermaidIshikawaNode]
    def levels:[int]
    def seq:int 0
    def started:boolean false

    Constructor () {
    }

    sfn parse:MermaidIshikawa (src:string) {
        def r (new MermaidIshikawaReader)
        return (r.read(src))
    }

    fn read:MermaidIshikawa (src:string) {
        doc.root.id = "fish"
        def lines:[string] (strsplit src "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def raw:string (MermaidIshikawaReader.stripComment((itemAt lines i)))
            i = (i + 1)
            def body:string (trim raw)
            if ((strlen body) == 0) {
                continue
            }
            def word:string (MermaidReader.lower((MermaidReader.firstWord(body))))
            if (MermaidReader.beginsWith(word "ishikawa")) { continue }
            if (MermaidReader.beginsWith(word "fishbone")) { continue }
            if (MermaidReader.beginsWith(word "acctitle")) { continue }
            if (MermaidReader.beginsWith(word "accdescr")) { continue }
            def indent:int (MermaidIshikawaReader.indentOf(raw))
            if (started == false) {
                ; The first line is the effect — the head of the fish. Mermaid
                ; takes it as the root of the tree, `title` and all, so this
                ; does too rather than inventing a keyword it does not have.
                doc.problem = (MermaidReader.cleanLabel(body))
                doc.root.text = doc.problem
                started = true
                clear stack
                clear levels
                push stack doc.root
                push levels indent
                continue
            }
            this.place(body indent)
        }
        return doc
    }

    sfn stripComment:string (line:string) {
        def len:int (strlen line)
        def i:int 0
        while (i < len) {
            def c:int (charAt line i)
            if (c == 37) {
                if ((i + 1) < len) {
                    if ((charAt line (i + 1)) == 37) {
                        return (substring line 0 i)
                    }
                }
            }
            i = (i + 1)
        }
        return line
    }

    sfn indentOf:int (line:string) {
        def n:int 0
        def i:int 0
        while (i < (strlen line)) {
            def c:int (charAt line i)
            if (c == 32) { n = (n + 1) } {
                if (c == 9) { n = (n + 2) } {
                    return n
                }
            }
            i = (i + 1)
        }
        return n
    }

    fn place:void (body:string indent:int) {
        ; Close every level indented as far as this one or further: a line at
        ; the same depth is a sibling, not a child.
        while ((array_length levels) > 1) {
            def top:int (itemAt levels ((array_length levels) - 1))
            if (indent > top) {
                break
            }
            this.pop()
        }
        def parent:MermaidIshikawaNode (itemAt stack ((array_length stack) - 1))
        def n (new MermaidIshikawaNode)
        n.id = ("bone" + (to_string seq))
        seq = (seq + 1)
        n.text = (MermaidReader.cleanLabel(body))
        n.depth = (array_length stack)
        push parent.children n
        push stack n
        push levels indent
    }

    fn pop:void () {
        def keptNodes:[MermaidIshikawaNode]
        def keptLevels:[int]
        def i:int 0
        while (i < ((array_length stack) - 1)) {
            push keptNodes (itemAt stack i)
            push keptLevels (itemAt levels i)
            i = (i + 1)
        }
        stack = keptNodes
        levels = keptLevels
    }
}

; ---------------------------------------------------------------------------
; The pipeline
; ---------------------------------------------------------------------------
class MermaidIshikawaFlow {
    sfn parse:MermaidIshikawa (src:string) {
        return (MermaidIshikawaReader.parse(src))
    }

    sfn render:FlowGraph (src:string) {
        def d:MermaidIshikawa (MermaidIshikawaReader.parse(src))
        def bare (new FlowStyle)
        return (MermaidIshikawaFlow.build(d bare))
    }

    sfn build:FlowGraph (d:MermaidIshikawa style:FlowStyle) {
        def g (new FlowGraph)
        def cats:int (d.categoryCount())
        if (cats == 0) {
            return g
        }
        def ribGap:double 250.0
        def leftPad:double 90.0
        def spineY:double 0.0
        def pairs:int (MermaidIshikawaFlow.pairsOf(cats))
        def spineLen:double (leftPad + ((to_double (pairs + 1)) * ribGap))
        ; The spine, drawn as the rule it is rather than as an edge: it has to
        ; run the width of the diagram whatever is or is not joined to it.
        def spine:FlowNode (FlowNode.create("spine" "" 0.0 (spineY - 2.0)))
        spine.nodeType = "spine"
        spine.shape = "rect"
        spine.width = spineLen
        spine.height = 4.0
        spine.borderRadius = 0.0
        spine.connectable = false
        spine.draggable = false
        spine.cssClass = "mermaid spine"
        spine.bgColor = "#7b8494"
        spine.borderColor = "#7b8494"
        spine.syncFromModel()
        g.addNode(spine)
        ; The head: the effect, which is the only thing everybody agrees is
        ; the point of the diagram.
        def headW:double 230.0
        def headH:double 76.0
        def head:FlowNode (FlowNode.create("head" d.problem spineLen (spineY - (headH * 0.5))))
        head.nodeType = "terminator"
        head.shape = "stadium"
        head.width = headW
        head.height = headH
        head.connectable = false
        head.cssClass = "mermaid effect"
        head.addSideHandles()
        head.syncFromModel()
        g.addNode(head)
        def i:int 0
        while (i < cats) {
            def cat:MermaidIshikawaNode (itemAt d.root.children i)
            def above:boolean ((i % 2) == 0)
            def column:int (idiv i 2)
            def x:double (leftPad + ((to_double column) * ribGap))
            def dir:double 1.0
            if above {
                dir = -1.0
            }
            def y:double (spineY + (dir * 150.0))
            def node:FlowNode (FlowNode.create(cat.id cat.text x (y - 24.0)))
            node.nodeType = "step"
            node.shape = "rect"
            node.borderRadius = 6.0
            node.width = 180.0
            node.height = 48.0
            node.connectable = false
            node.cssClass = "mermaid category"
            node.addSideHandles()
            node.syncFromModel()
            g.addNode(node)
            ; Where its bone meets the spine. A joint rather than an edge to
            ; the head, because every rib meets the spine at its own place.
            def jointX:double (x + 150.0)
            def joint:FlowNode (FlowNode.create(("joint" + (to_string i)) "" jointX (spineY - 3.0)))
            joint.nodeType = "joint"
            joint.shape = "circle"
            joint.width = 6.0
            joint.height = 6.0
            joint.connectable = false
            joint.draggable = false
            joint.cssClass = "mermaid joint"
            joint.bgColor = "#7b8494"
            joint.borderColor = "#7b8494"
            joint.syncFromModel()
            g.addNode(joint)
            MermaidIshikawaFlow.causes(g cat x y dir 1)
            i = (i + 1)
        }
        g.reindex()
        def k:int 0
        while (k < cats) {
            def cat2:MermaidIshikawaNode (itemAt d.root.children k)
            MermaidIshikawaFlow.bone(g cat2.id ("joint" + (to_string k)))
            MermaidIshikawaFlow.tie(g cat2)
            k = (k + 1)
        }
        g.reindex()
        def wrote:int (style.applyTo(g))
        def moved:boolean (g.sendToBack("spine"))
        return g
    }

    sfn pairsOf:int (cats:int) {
        def n:int (idiv cats 2)
        if ((cats % 2) != 0) {
            n = (n + 1)
        }
        return n
    }

    ; The causes under a category, stepping further out and further back the
    ; deeper they go — which is how a fishbone shows a cause of a cause.
    sfn causes:void (g:FlowGraph parent:MermaidIshikawaNode x:double y:double dir:double depth:int) {
        def i:int 0
        while (i < (array_length parent.children)) {
            def c:MermaidIshikawaNode (itemAt parent.children i)
            def cy:double (y + (dir * (60.0 + ((to_double i) * 46.0))))
            def cx:double (x - (34.0 * (to_double depth)))
            def n:FlowNode (FlowNode.create(c.id c.text cx (cy - 18.0)))
            n.nodeType = "note"
            n.shape = "rect"
            n.borderRadius = 5.0
            n.width = 168.0
            n.height = 36.0
            n.connectable = false
            n.cssClass = "mermaid cause"
            n.addSideHandles()
            n.syncFromModel()
            g.addNode(n)
            MermaidIshikawaFlow.causes(g c cx cy dir (depth + 1))
            i = (i + 1)
        }
    }

    ; Every cause is tied to whatever it is a cause OF.
    sfn tie:void (g:FlowGraph parent:MermaidIshikawaNode) {
        def i:int 0
        while (i < (array_length parent.children)) {
            def c:MermaidIshikawaNode (itemAt parent.children i)
            MermaidIshikawaFlow.bone(g c.id parent.id)
            MermaidIshikawaFlow.tie(g c)
            i = (i + 1)
        }
    }

    sfn bone:void (g:FlowGraph from:string to:string) {
        if ((g.hasNode(from)) == false) {
            return
        }
        if ((g.hasNode(to)) == false) {
            return
        }
        def e:FlowEdge (FlowEdge.create("" from to))
        e.edgeType = "straight"
        e.markerEnd = ""
        e.cssClass = "link bone"
        g.addEdge(e)
    }
}

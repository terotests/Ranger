; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MermaidRadarReader.rgr — several things measured on the same set of scales.
; ============================================================================
;
; A radar chart is a bar chart bent into a circle: one spoke per axis, one
; closed line per subject, and the shape of that line is the comparison. It is
; the second diagram in this directory with a SCALE in it, and it has the same
; obligation the xychart has — a reading of 85 has to be exactly as far out
; along its spoke as 85 is between the middle and the rim, or the picture is a
; lie about the numbers.
;
;                Math
;                 ╱│╲
;           Art ╱  │  ╲ Science
;             ╱ ╭──┼──╮ ╲
;            │  │  ●  │  │
;             ╲ ╰──┼──╯ ╱
;      Geography ╲ │ ╱ English
;                 ╲│╱
;               History
;
; **What it reads.** `axis a["Math"], b["Science"]` — as many `axis` lines as
; you like, each holding as many entries — and `curve alice["Alice"]{85, 90,
; 80}`, whose readings are either a plain list in axis order or `name: value`
; pairs that say which axis each one belongs to. `max`, `min`, `ticks`,
; `graticule circle|polygon` and `showLegend true|false` are the options
; Mermaid gives it, and `title` is the title.
;
; **How it is drawn.** Everything here is a line rather than a shape: the
; graticule rings, the spokes and the curves themselves are thin quadrilaterals
; given as `shapePoints`. A radar with three filled curves on it is three
; opaque blobs, the last one drawn winning — the answer everywhere else is
; transparency, and there is none in the display list — so the curves are drawn
; as outlines with a dot at every reading, which is the one form where the
; third subject is as legible as the first.
; ============================================================================

Import "MermaidReader.rgr"
Import "../../core/FlowStyleSheet.rgr"

class MermaidRadarAxis {
    def id:string ""
    def label:string ""

    Constructor () {
    }
}

class MermaidRadarCurve {
    def id:string ""
    def label:string ""
    ; One reading per axis, in axis order. A curve that named its axes is
    ; unpacked into this on the way in, so the renderer has one shape to draw.
    def values:[double]

    Constructor () {
    }

    fn count:int () {
        return (array_length values)
    }
}

class MermaidRadar {
    def title:string ""
    def axes:[MermaidRadarAxis]
    def curves:[MermaidRadarCurve]
    ; Mermaid's own defaults.
    def ticks:int 5
    def graticule:string "circle"
    def showLegend:boolean true
    def minValue:double 0.0
    def maxValue:double 0.0
    def minGiven:boolean false
    def maxGiven:boolean false

    Constructor () {
    }

    fn axisCount:int () {
        return (array_length axes)
    }

    fn curveCount:int () {
        return (array_length curves)
    }

    fn indexOfAxis:int (name:string) {
        def i:int 0
        while (i < (array_length axes)) {
            def a:MermaidRadarAxis (itemAt axes i)
            if (a.id == name) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; The bottom of the scale. Zero unless the author said otherwise or the
    ; data goes below it: a radar whose middle is 80 makes a five per cent
    ; difference look like the whole of the subject.
    fn low:double () {
        if minGiven {
            return minValue
        }
        def out:double 0.0
        def i:int 0
        while (i < (array_length curves)) {
            def c:MermaidRadarCurve (itemAt curves i)
            def k:int 0
            while (k < (array_length c.values)) {
                def v:double (itemAt c.values k)
                if (v < out) {
                    out = v
                }
                k = (k + 1)
            }
            i = (i + 1)
        }
        return out
    }

    fn high:double () {
        if maxGiven {
            return maxValue
        }
        def out:double (this.low())
        def seen:boolean false
        def i:int 0
        while (i < (array_length curves)) {
            def c:MermaidRadarCurve (itemAt curves i)
            def k:int 0
            while (k < (array_length c.values)) {
                def v:double (itemAt c.values k)
                if (seen == false) {
                    out = v
                    seen = true
                }
                if (v > out) {
                    out = v
                }
                k = (k + 1)
            }
            i = (i + 1)
        }
        if (out <= (this.low())) {
            out = ((this.low()) + 1.0)
        }
        return out
    }
}

class MermaidRadarReader {
    def doc:MermaidRadar (new MermaidRadar)

    Constructor () {
    }

    sfn parse:MermaidRadar (src:string) {
        def r (new MermaidRadarReader)
        return (r.read(src))
    }

    fn read:MermaidRadar (src:string) {
        def lines:[string] (strsplit src "\n")
        def inFront:boolean false
        def frontDone:boolean false
        def i:int 0
        while (i < (array_length lines)) {
            def raw:string (trim (itemAt lines i))
            i = (i + 1)
            if (raw == "---") {
                if (frontDone == false) {
                    if inFront {
                        inFront = false
                        frontDone = true
                    } {
                        inFront = true
                    }
                    continue
                }
            }
            if inFront {
                def cut:int (indexOf raw ":")
                if (cut > 0) {
                    def key:string (trim (substring raw 0 cut))
                    def lowKey:string (MermaidReader.lower(key))
                    if (lowKey == "title") {
                        def val:string (trim (substring raw (cut + 1) (strlen raw)))
                        doc.title = (MermaidReader.unquote(val))
                    }
                }
                continue
            }
            def line:string (trim (MermaidRadarReader.stripComment(raw)))
            if ((strlen line) == 0) {
                continue
            }
            this.statement(line)
        }
        this.settle()
        return doc
    }

    sfn stripComment:string (line:string) {
        def len:int (strlen line)
        def q:boolean false
        def i:int 0
        while (i < len) {
            def c:int (charAt line i)
            if (c == 34) {
                if q { q = false } { q = true }
            }
            if (q == false) {
                if (c == 37) {
                    if ((i + 1) < len) {
                        def d:int (charAt line (i + 1))
                        if (d == 37) {
                            return (substring line 0 i)
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return line
    }

    fn statement:void (st:string) {
        def word:string (MermaidReader.firstWord(st))
        def kw:string (MermaidReader.lower((MermaidReader.upToPunct(word))))
        def rest:string (trim (substring st (strlen word) (strlen st)))
        if (kw == "radar-beta") {
            if ((strlen rest) > 0) {
                this.statement(rest)
            }
            return
        }
        if (kw == "radar") {
            if ((strlen rest) > 0) {
                this.statement(rest)
            }
            return
        }
        if (MermaidReader.beginsWith(kw "acctitle")) { return }
        if (MermaidReader.beginsWith(kw "accdescr")) { return }
        if (kw == "title") {
            doc.title = (MermaidReader.cleanLabel(rest))
            return
        }
        if (kw == "axis") {
            this.readAxes(rest)
            return
        }
        if (kw == "curve") {
            this.readCurve(rest)
            return
        }
        if (kw == "max") {
            doc.maxValue = (MermaidRadarReader.numberOf(rest 0.0))
            doc.maxGiven = true
            return
        }
        if (kw == "min") {
            doc.minValue = (MermaidRadarReader.numberOf(rest 0.0))
            doc.minGiven = true
            return
        }
        if (kw == "ticks") {
            def t:int (to_int (MermaidRadarReader.numberOf(rest 5.0)))
            if (t > 0) {
                doc.ticks = t
            }
            return
        }
        if (kw == "graticule") {
            def g:string (MermaidReader.lower((MermaidReader.firstWord(rest))))
            if (g == "polygon") { doc.graticule = "polygon" }
            if (g == "circle")  { doc.graticule = "circle" }
            return
        }
        if (kw == "showlegend") {
            def v:string (MermaidReader.lower((MermaidReader.firstWord(rest))))
            doc.showLegend = true
            if (v == "false") {
                doc.showLegend = false
            }
            return
        }
    }

    ; `axis a["Math"], b["Science"], c` — one line, any number of entries. The
    ; brackets are optional and so is the name inside them: an axis with no
    ; label is labelled with its own name, because a spoke with nothing written
    ; on it is a direction rather than a measurement.
    fn readAxes:void (rest:string) {
        def parts:[string] (MermaidReader.splitTop(rest 44))
        def i:int 0
        while (i < (array_length parts)) {
            def piece:string (trim (itemAt parts i))
            i = (i + 1)
            if ((strlen piece) == 0) {
                continue
            }
            def a (new MermaidRadarAxis)
            a.id = (MermaidRadarReader.nameOf(piece))
            a.label = (MermaidRadarReader.labelOf(piece))
            if ((strlen a.label) == 0) {
                a.label = a.id
            }
            if ((strlen a.id) == 0) {
                continue
            }
            push doc.axes a
        }
    }

    ; `curve alice["Alice"]{85, 90, 80}`, with the readings either in axis
    ; order or written as `axisName: value`.
    fn readCurve:void (rest:string) {
        def open:int (MermaidRadarReader.charIndex(rest 123))
        if (open < 0) {
            return
        }
        def close:int (MermaidRadarReader.lastIndex(rest 125))
        if (close < open) {
            close = (strlen rest)
        }
        def head:string (trim (substring rest 0 open))
        def body:string (trim (substring rest (open + 1) close))
        def c (new MermaidRadarCurve)
        c.id = (MermaidRadarReader.nameOf(head))
        c.label = (MermaidRadarReader.labelOf(head))
        if ((strlen c.label) == 0) {
            c.label = c.id
        }
        def slots:int (array_length doc.axes)
        def k:int 0
        while (k < slots) {
            push c.values 0.0
            k = (k + 1)
        }
        def parts:[string] (MermaidReader.splitTop(body 44))
        def at:int 0
        def i:int 0
        while (i < (array_length parts)) {
            def piece:string (trim (itemAt parts i))
            i = (i + 1)
            if ((strlen piece) == 0) {
                continue
            }
            def colon:int (indexOf piece ":")
            if (colon > 0) {
                ; `math: 85` says which spoke it belongs on, which is the only
                ; safe way to write a curve that skips an axis.
                def who:string (MermaidReader.unquote((trim (substring piece 0 colon))))
                def val:string (trim (substring piece (colon + 1) (strlen piece)))
                def slot:int (doc.indexOfAxis(who))
                if (slot >= 0) {
                    set c.values slot (MermaidRadarReader.numberOf(val 0.0))
                }
                continue
            }
            if (at < slots) {
                set c.values at (MermaidRadarReader.numberOf(piece 0.0))
            }
            at = (at + 1)
        }
        push doc.curves c
    }

    ; A curve written before the axes it names would have been given a row of
    ; zeroes, so the readings are squared up once the whole file has been read.
    fn settle:void () {
        def slots:int (array_length doc.axes)
        def i:int 0
        while (i < (array_length doc.curves)) {
            def c:MermaidRadarCurve (itemAt doc.curves i)
            while ((array_length c.values) < slots) {
                push c.values 0.0
            }
            i = (i + 1)
        }
    }

    ; The part before the bracket: `alice["Alice"]` → `alice`.
    sfn nameOf:string (piece:string) {
        def open:int (MermaidRadarReader.charIndex(piece 91))
        if (open < 0) {
            return (MermaidReader.unquote((trim piece)))
        }
        return (MermaidReader.unquote((trim (substring piece 0 open))))
    }

    sfn labelOf:string (piece:string) {
        def open:int (MermaidRadarReader.charIndex(piece 91))
        if (open < 0) {
            return ""
        }
        def close:int (MermaidRadarReader.lastIndex(piece 93))
        if (close <= open) {
            close = (strlen piece)
        }
        return (MermaidReader.cleanLabel((trim (substring piece (open + 1) close))))
    }

    sfn numberOf:double (text:string fallback:double) {
        def t:string (MermaidReader.unquote((trim text)))
        if ((strlen t) == 0) {
            return fallback
        }
        def v@(optional):double (str2double t)
        if (null? v) {
            return fallback
        }
        return (unwrap v)
    }

    sfn charIndex:int (t:string c:int) {
        def i:int 0
        while (i < (strlen t)) {
            if ((charAt t i) == c) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    sfn lastIndex:int (t:string c:int) {
        def out:int -1
        def i:int 0
        while (i < (strlen t)) {
            if ((charAt t i) == c) {
                out = i
            }
            i = (i + 1)
        }
        return out
    }
}

; ============================================================================
; MermaidRadarFlow — the web, drawn.
; ============================================================================
class MermaidRadarFlow {
    Constructor () {
    }

    sfn radius:double () {
        return 220.0
    }

    sfn build:FlowGraph (d:MermaidRadar style:FlowStyle) {
        def g (new FlowGraph)
        def axes:int (d.axisCount())
        if (axes < 3) {
            ; Two spokes are a line and one is a stick. Mermaid draws them all
            ; the same; there is nothing to compare on either.
            if (axes == 0) {
                return g
            }
        }
        def r:double (MermaidRadarFlow.radius())
        def cx:double r
        def cy:double r
        if ((strlen d.title) > 0) {
            ; Clear of the topmost axis label, which sits a ring's width and a
            ; line outside the rim: a title written at the same height as the
            ; first axis name is a title nobody can see.
            MermaidRadarFlow.label(g "radar-title" d.title (cx - r) (0.0 - (r * 0.34)) (r * 2.0) 30.0 "mermaid radar title axislabel")
        }
        ; The graticule, then the spokes, then the curves: the order they are
        ; added is the order they are drawn, and a ring over a curve is a ring
        ; that rubs a reading out.
        def t:int 1
        while (t <= d.ticks) {
            def rr:double ((r * (to_double t)) / (to_double d.ticks))
            MermaidRadarFlow.ring(g ("ring-" + (to_string t)) cx cy rr axes d.graticule)
            t = (t + 1)
        }
        MermaidRadarFlow.spokes(g cx cy r axes)
        MermaidRadarFlow.axisLabels(g d cx cy r)
        def low:double (d.low())
        def high:double (d.high())
        def c:int 0
        while (c < (array_length d.curves)) {
            def cu:MermaidRadarCurve (itemAt d.curves c)
            MermaidRadarFlow.curve(g cu c cx cy r axes low high)
            c = (c + 1)
        }
        if d.showLegend {
            MermaidRadarFlow.legend(g d cx cy r)
        }
        g.reindex()
        def wrote:int (style.applyTo(g))
        ; The colours after the sheet, not before it. A curve is told apart
        ; from the next one by its colour and by nothing else, so the theme's
        ; one node fill applied over the top would draw two subjects as one
        ; drawn twice. A sheet that means it can still say so by matching
        ; `.curve-1`, which is why these are classes as well as fills.
        MermaidRadarFlow.repaint(g d)
        return g
    }

    sfn repaint:void (g:FlowGraph d:MermaidRadar) {
        def rings:int d.ticks
        def t:int 1
        while (t <= rings) {
            MermaidRadarFlow.tint(g ("ring-" + (to_string t)) 48 "#d3d8e6")
            t = (t + 1)
        }
        def a:int 0
        while (a < (d.axisCount())) {
            MermaidRadarFlow.paint(g ("spoke-" + (to_string a)) "#c2c8da")
            a = (a + 1)
        }
        def c:int 0
        while (c < (array_length d.curves)) {
            def ink:string (MermaidRadarFlow.colorAt(c))
            MermaidRadarFlow.tint(g ("curve-" + (to_string c)) (d.axisCount()) ink)
            def p:int 0
            while (p < (d.axisCount())) {
                MermaidRadarFlow.paint(g ((("dot-" + (to_string c)) + "-") + (to_string p)) ink)
                p = (p + 1)
            }
            MermaidRadarFlow.paint(g ("key-" + (to_string c)) ink)
            c = (c + 1)
        }
    }

    ; A run of `id-0`, `id-1`, … — the segments one line was cut into.
    sfn tint:void (g:FlowGraph prefix:string count:int color:string) {
        def i:int 0
        while (i < count) {
            MermaidRadarFlow.paint(g ((prefix + "-") + (to_string i)) color)
            i = (i + 1)
        }
    }

    sfn paint:void (g:FlowGraph id:string color:string) {
        if ((g.hasNode(id)) == false) {
            return
        }
        def n:FlowNode (g.nodeById(id))
        n.bgColor = color
        n.borderColor = color
        n.syncFromModel()
    }

    ; One graticule ring. A polygon one has a corner on every spoke; a circular
    ; one is the same code with enough corners that the corners stop showing.
    sfn ring:void (g:FlowGraph id:string cx:double cy:double r:double axes:int shape:string) {
        def n:int axes
        if (shape == "circle") {
            n = 48
        }
        if (n < 3) {
            n = 3
        }
        def i:int 0
        while (i < n) {
            def a0:double (MermaidRadarFlow.angleAt(i n))
            def a1:double (MermaidRadarFlow.angleAt((i + 1) n))
            MermaidRadarFlow.line(g ((id + "-") + (to_string i)) (cx + (r * (cos a0))) (cy + (r * (sin a0))) (cx + (r * (cos a1))) (cy + (r * (sin a1))) 1.0 "#d3d8e6" "mermaid radar graticule")
            i = (i + 1)
        }
    }

    sfn spokes:void (g:FlowGraph cx:double cy:double r:double axes:int) {
        def i:int 0
        while (i < axes) {
            def ang:double (MermaidRadarFlow.angleAt(i axes))
            MermaidRadarFlow.line(g ("spoke-" + (to_string i)) cx cy (cx + (r * (cos ang))) (cy + (r * (sin ang))) 1.0 "#c2c8da" "mermaid radar spoke")
            i = (i + 1)
        }
    }

    sfn axisLabels:void (g:FlowGraph d:MermaidRadar cx:double cy:double r:double) {
        def axes:int (d.axisCount())
        def i:int 0
        while (i < axes) {
            def a:MermaidRadarAxis (itemAt d.axes i)
            def ang:double (MermaidRadarFlow.angleAt(i axes))
            def out:double (r + 30.0)
            def x:double (cx + (out * (cos ang)))
            def y:double (cy + (out * (sin ang)))
            def w:double (((to_double (strlen a.label)) * 7.0) + 20.0)
            if (w < 60.0) { w = 60.0 }
            MermaidRadarFlow.label(g ("axis-" + (to_string i)) a.label (x - (w * 0.5)) (y - 13.0) w 26.0 "mermaid radar axislabel")
            i = (i + 1)
        }
    }

    ; One subject: a closed line through its readings, with a dot on each so a
    ; reading can be found rather than estimated from the corner of a shape.
    sfn curve:void (g:FlowGraph c:MermaidRadarCurve index:int cx:double cy:double r:double axes:int low:double high:double) {
        def ink:string (MermaidRadarFlow.colorAt(index))
        def xs:[double]
        def ys:[double]
        def i:int 0
        while (i < axes) {
            def v:double 0.0
            if (i < (array_length c.values)) {
                v = (itemAt c.values i)
            }
            def frac:double ((v - low) / (high - low))
            if (frac < 0.0) { frac = 0.0 }
            if (frac > 1.0) { frac = 1.0 }
            def ang:double (MermaidRadarFlow.angleAt(i axes))
            push xs (cx + ((r * frac) * (cos ang)))
            push ys (cy + ((r * frac) * (sin ang)))
            i = (i + 1)
        }
        def n:int (array_length xs)
        def k:int 0
        while (k < n) {
            def j:int ((k + 1) % n)
            def id:string (((("curve-" + (to_string index)) + "-") + (to_string k)))
            MermaidRadarFlow.line(g id (itemAt xs k) (itemAt ys k) (itemAt xs j) (itemAt ys j) 2.4 ink ("mermaid radar curve " + (MermaidRadarFlow.curveClass(index))))
            k = (k + 1)
        }
        def p:int 0
        while (p < n) {
            def dot:FlowNode (FlowNode.create(((("dot-" + (to_string index)) + "-") + (to_string p)) "" ((itemAt xs p) - 4.0) ((itemAt ys p) - 4.0)))
            dot.nodeType = "point"
            dot.shape = "circle"
            dot.width = 8.0
            dot.height = 8.0
            dot.connectable = false
            dot.draggable = false
            dot.borderWidth = 0.0
            dot.bgColor = ink
            dot.borderColor = ink
            dot.cssClass = ("mermaid radar point " + (MermaidRadarFlow.curveClass(index)))
            dot.syncFromModel()
            g.addNode(dot)
            p = (p + 1)
        }
    }

    sfn legend:void (g:FlowGraph d:MermaidRadar cx:double cy:double r:double) {
        def x:double (cx + r + 90.0)
        def i:int 0
        while (i < (array_length d.curves)) {
            def c:MermaidRadarCurve (itemAt d.curves i)
            def y:double ((cy - r) + ((to_double i) * 28.0))
            def swatch:FlowNode (FlowNode.create(("key-" + (to_string i)) "" x (y + 4.0)))
            swatch.nodeType = "swatch"
            swatch.shape = "rect"
            swatch.width = 16.0
            swatch.height = 16.0
            swatch.borderRadius = 3.0
            swatch.connectable = false
            swatch.draggable = false
            swatch.bgColor = (MermaidRadarFlow.colorAt(i))
            swatch.borderColor = (MermaidRadarFlow.colorAt(i))
            swatch.cssClass = ("mermaid radar swatch " + (MermaidRadarFlow.curveClass(i)))
            swatch.syncFromModel()
            g.addNode(swatch)
            def w:double (((to_double (strlen c.label)) * 7.0) + 24.0)
            if (w < 90.0) { w = 90.0 }
            MermaidRadarFlow.label(g ("keyname-" + (to_string i)) c.label (x + 24.0) y w 26.0 "mermaid radar legend axislabel")
            i = (i + 1)
        }
    }

    ; A line, as the only thing the display list will draw without filling it:
    ; a very thin quadrilateral, given as `shapePoints` and stroked with
    ; nothing. Every rule on this chart is one of these, which is why a radar
    ; needs no shape the library did not already have.
    sfn line:void (g:FlowGraph id:string x1:double y1:double x2:double y2:double thick:double color:string cls:string) {
        def dx:double (x2 - x1)
        def dy:double (y2 - y1)
        def len:double (sqrt ((dx * dx) + (dy * dy)))
        if (len < 0.0001) {
            return
        }
        def nx:double (((0.0 - dy) / len) * (thick * 0.5))
        def ny:double ((dx / len) * (thick * 0.5))
        def xs:[double]
        def ys:[double]
        push xs (x1 + nx)
        push ys (y1 + ny)
        push xs (x2 + nx)
        push ys (y2 + ny)
        push xs (x2 - nx)
        push ys (y2 - ny)
        push xs (x1 - nx)
        push ys (y1 - ny)
        def minX:double (itemAt xs 0)
        def maxX:double minX
        def minY:double (itemAt ys 0)
        def maxY:double minY
        def i:int 1
        while (i < 4) {
            def x:double (itemAt xs i)
            def y:double (itemAt ys i)
            if (x < minX) { minX = x }
            if (x > maxX) { maxX = x }
            if (y < minY) { minY = y }
            if (y > maxY) { maxY = y }
            i = (i + 1)
        }
        def w:double (maxX - minX)
        def h:double (maxY - minY)
        if (w < 0.6) { w = 0.6 }
        if (h < 0.6) { h = 0.6 }
        def n:FlowNode (FlowNode.create(id "" minX minY))
        n.nodeType = "rule"
        n.shape = "polygon"
        n.width = w
        n.height = h
        n.connectable = false
        n.draggable = false
        n.borderWidth = 0.0
        n.bgColor = color
        n.borderColor = color
        n.cssClass = cls
        clear n.shapePoints
        def p:int 0
        while (p < 4) {
            push n.shapePoints (((itemAt xs p) - minX) / w)
            push n.shapePoints (((itemAt ys p) - minY) / h)
            p = (p + 1)
        }
        n.syncFromModel()
        g.addNode(n)
    }

    sfn label:void (g:FlowGraph id:string text:string x:double y:double w:double h:double cls:string) {
        if ((strlen text) == 0) {
            return
        }
        def n:FlowNode (FlowNode.create(id text x y))
        n.nodeType = "axislabel"
        n.shape = "rect"
        n.width = w
        n.height = h
        n.connectable = false
        n.draggable = false
        n.cssClass = cls
        n.syncFromModel()
        g.addNode(n)
    }

    ; Twelve o'clock, then clockwise: a radar read any other way puts the first
    ; axis somewhere the reader has to look for.
    sfn angleAt:double (i:int n:int) {
        def turn:double 6.283185307179586
        def quarter:double 1.5707963267948966
        return ((0.0 - quarter) + ((turn * (to_double i)) / (to_double n)))
    }

    sfn curveClass:string (index:int) {
        return ("curve-" + (to_string (index % 12)))
    }

    sfn colorAt:string (index:int) {
        def i:int (index % 12)
        if (i == 0)  { return "#4c78a8" }
        if (i == 1)  { return "#f58518" }
        if (i == 2)  { return "#54a24b" }
        if (i == 3)  { return "#e45756" }
        if (i == 4)  { return "#72b7b2" }
        if (i == 5)  { return "#b279a2" }
        if (i == 6)  { return "#eeca3b" }
        if (i == 7)  { return "#9d755d" }
        if (i == 8)  { return "#bab0ac" }
        if (i == 9)  { return "#ff9da6" }
        if (i == 10) { return "#79706e" }
        return "#8c6d31"
    }
}

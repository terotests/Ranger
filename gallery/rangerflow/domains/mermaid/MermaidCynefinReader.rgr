; ============================================================================
; MermaidCynefinReader.rgr — five domains, and which one a thing is in.
; ============================================================================
;
; The Cynefin framework has exactly five domains and they are always in the
; same places, because the places are the argument: `complex` is next to
; `complicated` because the difference between them is the point, and
; `confusion` is in the middle because that is where you are when you do not
; know which of the other four you are in.
;
;   ┌──────────────┬──────────────┐
;   │   complex    │ complicated  │
;   │              │   ┌──────┐   │
;   ├──────────────┤   │confu-│   ├─  the fifth one is in the middle,
;   │   chaotic    │   │ sion │   │   and it overlaps all four
;   │              │   └──────┘   │
;   └──────────────┴──────────────┘
;
; So there is nothing to lay out. The reader's whole job is to put each item
; in the domain it was written under, and to draw the arrows between domains
; that say something moved.
;
; **What it reads.** `title`, the five domain names with their quoted items —
; on the same line or indented under the name — and `from --> to : "label"`.
; ============================================================================

Import "MermaidReader.rgr"
Import "../../core/FlowStyleSheet.rgr"

class MermaidCynefinItem {
    def id:string ""
    def label:string ""
    def domain:string ""

    Constructor () {
    }
}

class MermaidCynefinMove {
    def from:string ""
    def to:string ""
    def label:string ""

    Constructor () {
    }
}

class MermaidCynefin {
    def title:string ""
    def items:[MermaidCynefinItem]
    def moves:[MermaidCynefinMove]

    Constructor () {
    }

    fn itemCount:int () {
        return (array_length items)
    }

    fn moveCount:int () {
        return (array_length moves)
    }

    fn itemsIn:int (domain:string) {
        def n:int 0
        def i:int 0
        while (i < (array_length items)) {
            def it:MermaidCynefinItem (itemAt items i)
            if (it.domain == domain) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; The five, in the order the framework names them. A sixth would be a
    ; different framework.
    sfn domains:[string] () {
        def out:[string]
        push out "complex"
        push out "complicated"
        push out "chaotic"
        push out "clear"
        push out "confusion"
        return out
    }

    sfn isDomain:boolean (word:string) {
        if (word == "complex")     { return true }
        if (word == "complicated") { return true }
        if (word == "chaotic")     { return true }
        if (word == "clear")       { return true }
        if (word == "confusion")   { return true }
        return false
    }
}

class MermaidCynefinReader {
    def doc:MermaidCynefin (new MermaidCynefin)
    def current:string ""
    def seq:int 0

    Constructor () {
    }

    sfn parse:MermaidCynefin (src:string) {
        def r (new MermaidCynefinReader)
        return (r.read(src))
    }

    fn read:MermaidCynefin (src:string) {
        def lines:[string] (strsplit src "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def raw:string (trim (itemAt lines i))
            i = (i + 1)
            def line:string (trim (MermaidCynefinReader.stripComment(raw)))
            if ((strlen line) == 0) {
                continue
            }
            this.statement(line)
        }
        return doc
    }

    sfn stripComment:string (line:string) {
        def len:int (strlen line)
        def i:int 0
        while (i < len) {
            def c:int (charAt line i)
            if (c == 37) {
                if ((i + 1) < len) {
                    if ((charAt line (i + 1)) == 37) {
                        return (substring line 0 i)
                    }
                }
            }
            i = (i + 1)
        }
        return line
    }

    fn statement:void (st:string) {
        def word:string (MermaidReader.firstWord(st))
        def kw:string (MermaidReader.lower(word))
        def rest:string (trim (substring st (strlen word) (strlen st)))
        if (MermaidReader.beginsWith(kw "cynefin")) { return }
        if (MermaidReader.beginsWith(kw "acctitle")) { return }
        if (MermaidReader.beginsWith(kw "accdescr")) { return }
        if (kw == "title") {
            doc.title = (MermaidReader.cleanLabel(rest))
            return
        }
        ; `complex --> clear : "label"` — a move between two domains.
        def arrow:int (MermaidCynefinReader.indexOfText(st "-->"))
        if (arrow > 0) {
            def from:string (MermaidReader.lower((trim (substring st 0 arrow))))
            def tail:string (trim (substring st (arrow + 3) (strlen st)))
            def colon:int (MermaidCynefinReader.charIndex(tail 58))
            def to:string tail
            def label:string ""
            if (colon >= 0) {
                to = (trim (substring tail 0 colon))
                label = (MermaidReader.cleanLabel((substring tail (colon + 1) (strlen tail))))
            }
            to = (MermaidReader.lower((trim to)))
            if (MermaidCynefin.isDomain(from)) {
                if (MermaidCynefin.isDomain(to)) {
                    if (from != to) {
                        def m (new MermaidCynefinMove)
                        m.from = from
                        m.to = to
                        m.label = label
                        push doc.moves m
                    }
                }
            }
            return
        }
        if (MermaidCynefin.isDomain(kw)) {
            current = kw
            ; The items may follow the name on the same line, or be indented
            ; under it. Both are Mermaid, so both are read.
            this.items(rest)
            return
        }
        this.items(st)
    }

    ; Every quoted string on a line is one item.
    fn items:void (rest:string) {
        if ((strlen current) == 0) {
            return
        }
        def t:string (trim rest)
        def n:int (strlen t)
        def i:int 0
        while (i < n) {
            def c:int (charAt t i)
            if (c == 34) {
                def close:int (i + 1)
                while (close < n) {
                    if ((charAt t close) == 34) {
                        break
                    }
                    close = (close + 1)
                }
                this.add((substring t (i + 1) close))
                i = (close + 1)
                continue
            }
            if (c == 39) {
                def close2:int (i + 1)
                while (close2 < n) {
                    if ((charAt t close2) == 39) {
                        break
                    }
                    close2 = (close2 + 1)
                }
                this.add((substring t (i + 1) close2))
                i = (close2 + 1)
                continue
            }
            i = (i + 1)
        }
    }

    fn add:void (text:string) {
        def label:string (MermaidReader.cleanLabel(text))
        if ((strlen label) == 0) {
            return
        }
        def it (new MermaidCynefinItem)
        it.id = ("cy" + (to_string seq))
        seq = (seq + 1)
        it.label = label
        it.domain = current
        push doc.items it
    }

    sfn charIndex:int (t:string c:int) {
        def i:int 0
        while (i < (strlen t)) {
            if ((charAt t i) == c) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    sfn indexOfText:int (text:string needle:string) {
        def n:int (strlen needle)
        def m:int (strlen text)
        if (n == 0) {
            return -1
        }
        def i:int 0
        while ((i + n) <= m) {
            def k:int 0
            def hit:boolean true
            while (k < n) {
                if ((charAt text (i + k)) != (charAt needle k)) {
                    hit = false
                    break
                }
                k = (k + 1)
            }
            if hit {
                return i
            }
            i = (i + 1)
        }
        return -1
    }
}

; ---------------------------------------------------------------------------
; The pipeline
; ---------------------------------------------------------------------------
class MermaidCynefinFlow {
    sfn parse:MermaidCynefin (src:string) {
        return (MermaidCynefinReader.parse(src))
    }

    sfn render:FlowGraph (src:string) {
        def d:MermaidCynefin (MermaidCynefinReader.parse(src))
        def bare (new FlowStyle)
        return (MermaidCynefinFlow.build(d bare))
    }

    sfn build:FlowGraph (d:MermaidCynefin style:FlowStyle) {
        def g (new FlowGraph)
        def half:double 340.0
        ; `sendToBack` moves a node to the front of the list, so the LAST one
        ; sent ends up deepest. The middle domain has to be drawn OVER the
        ; four it sits between, so it is sent back first.
        def backs:[string]
        push backs "sg-confusion"
        ; The four quadrants, where the framework puts them and nowhere else.
        MermaidCynefinFlow.quadrant(g backs "complex" 0.0 0.0 half)
        MermaidCynefinFlow.quadrant(g backs "complicated" half 0.0 half)
        MermaidCynefinFlow.quadrant(g backs "chaotic" 0.0 half half)
        MermaidCynefinFlow.quadrant(g backs "clear" half half half)
        ; And the fifth in the middle, over all four of them.
        def mid:double (half * 0.46)
        def centre:FlowNode (FlowNode.create("sg-confusion" "confusion" (half - (mid * 0.5)) (half - (mid * 0.5))))
        centre.nodeType = "group"
        centre.width = mid
        centre.height = mid
        centre.connectable = false
        centre.draggable = false
        centre.cssClass = "mermaid domain confusion"
        centre.bgColor = "#eef2f8"
        centre.borderColor = "#b9c0cc"
        centre.syncFromModel()
        g.addNode(centre)
        def names:[string] (MermaidCynefin.domains())
        def s:int 0
        while (s < (array_length names)) {
            def name:string (itemAt names s)
            def rect:FlowRect (MermaidCynefinFlow.areaOf(name half mid))
            def count:int (d.itemsIn(name))
            def slot:int 0
            def i:int 0
            while (i < (array_length d.items)) {
                def it:MermaidCynefinItem (itemAt d.items i)
                if (it.domain == name) {
                    def w:double (rect.w - 36.0)
                    def h:double 34.0
                    def top:double ((rect.y + 46.0) + ((to_double slot) * (h + 10.0)))
                    def card:FlowNode (FlowNode.create(it.id it.label (rect.x + 18.0) top))
                    card.nodeType = "step"
                    card.shape = "rect"
                    card.borderRadius = 6.0
                    card.width = w
                    card.height = h
                    card.connectable = false
                    card.cssClass = ("mermaid item " + name)
                    card.syncFromModel()
                    g.addNode(card)
                    slot = (slot + 1)
                }
                i = (i + 1)
            }
            s = (s + 1)
        }
        g.reindex()
        def m:int 0
        while (m < (array_length d.moves)) {
            def mv:MermaidCynefinMove (itemAt d.moves m)
            def from:string ("sg-" + mv.from)
            def to:string ("sg-" + mv.to)
            if (g.hasNode(from)) {
                if (g.hasNode(to)) {
                    def e:FlowEdge (FlowEdge.create("" from to))
                    e.edgeType = "smoothstep"
                    e.markerEnd = "arrowclosed"
                    e.label = mv.label
                    e.cssClass = "link move"
                    g.addEdge(e)
                }
            }
            m = (m + 1)
        }
        g.reindex()
        def wrote:int (style.applyTo(g))
        def b:int 0
        while (b < (array_length backs)) {
            def moved:boolean (g.sendToBack((itemAt backs b)))
            b = (b + 1)
        }
        return g
    }

    sfn quadrant:void (g:FlowGraph backs:[string] name:string x:double y:double side:double) {
        def n:FlowNode (FlowNode.create(("sg-" + name) name x y))
        n.nodeType = "group"
        n.width = side
        n.height = side
        n.connectable = false
        n.draggable = false
        n.cssClass = ("mermaid domain " + name)
        n.bgColor = "#f6f7fb"
        n.borderColor = "#c9cede"
        n.addSideHandles()
        n.syncFromModel()
        g.addNode(n)
        push backs ("sg-" + name)
    }

    ; Where each domain's items go. The middle one is small, so its items sit
    ; under it rather than in it.
    sfn areaOf:FlowRect (name:string half:double mid:double) {
        def r (new FlowRect)
        r.valid = true
        r.w = half
        r.h = half
        if (name == "complex") {
            r.x = 0.0
            r.y = 0.0
        }
        if (name == "complicated") {
            r.x = half
            r.y = 0.0
        }
        if (name == "chaotic") {
            r.x = 0.0
            r.y = half
        }
        if (name == "clear") {
            r.x = half
            r.y = half
        }
        if (name == "confusion") {
            r.x = (half - (mid * 0.5))
            r.y = ((half + (mid * 0.5)) + 12.0)
            r.w = mid
            r.h = mid
        }
        return r
    }
}

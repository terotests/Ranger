; ============================================================================
; MermaidTimelineReader.rgr — a Mermaid timeline, placed rather than laid out.
; ============================================================================
;
; A timeline is the one diagram here whose picture is decided by the reader
; rather than by a layout: the periods run along an axis in the order they
; were written, and the events hang under the period they belong to. There is
; nothing for a layered layout to work out — putting 2004 before 2002 because
; it has fewer edges would be a bug, not an optimisation.
;
;   timeline
;       title The web
;       section The nineties
;           1991 : The first web page
;           1995 : JavaScript : PHP
;
;   ┌ The nineties ───────────────────────────┐
;   │   ┌──────┐            ┌──────┐          │
;   │   │ 1991 │            │ 1995 │          │
;   │   └──┬───┘            └──┬───┘          │
;   │  ┌───┴────────────┐  ┌───┴──────┐       │
;   │  │ The first web… │  │JavaScript│       │
;   │  └────────────────┘  ├──────────┤       │
;   │                      │   PHP    │       │
;   └─────────────────────────────────────────┘
;
; **What it reads.** `title`, `section`, and a period line — `2004 : one : two`
; — where everything after the first colon is an event of its own. Sections
; become the frames a sub-flow already has.
; ============================================================================

Import "MermaidReader.rgr"
Import "../../core/FlowStyleSheet.rgr"
Import "../../layout/EdgeLanes.rgr"

class MermaidTimelineEvent {
    def id:string ""
    def text:string ""

    Constructor () {
    }
}

class MermaidTimelinePeriod {
    def id:string ""
    def label:string ""
    def section:string ""
    def events:[MermaidTimelineEvent]

    Constructor () {
    }

    fn eventCount:int () {
        return (array_length events)
    }
}

class MermaidTimeline {
    def title:string ""
    def themeName:string ""
    def periods:[MermaidTimelinePeriod]
    def sections:[string]

    Constructor () {
    }

    fn periodCount:int () {
        return (array_length periods)
    }

    fn sectionCount:int () {
        return (array_length sections)
    }

    fn eventCount:int () {
        def n:int 0
        def i:int 0
        while (i < (array_length periods)) {
            def p:MermaidTimelinePeriod (itemAt periods i)
            n = (n + (array_length p.events))
            i = (i + 1)
        }
        return n
    }
}

class MermaidTimelineReader {
    def doc:MermaidTimeline (new MermaidTimeline)
    def section:string ""
    ; Periods and events are numbered apart, so `period2` is the third period
    ; rather than whatever came third overall.
    def periodSeq:int 0
    def eventSeq:int 0

    Constructor () {
    }

    sfn parse:MermaidTimeline (src:string) {
        def r (new MermaidTimelineReader)
        return (r.read(src))
    }

    fn read:MermaidTimeline (src:string) {
        def lines:[string] (strsplit src "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def raw:string (trim (itemAt lines i))
            i = (i + 1)
            def line:string (trim (MermaidTimelineReader.stripComment(raw)))
            if ((strlen line) == 0) {
                continue
            }
            this.statement(line)
        }
        return doc
    }

    sfn stripComment:string (line:string) {
        def len:int (strlen line)
        def i:int 0
        while (i < len) {
            def c:int (charAt line i)
            if (c == 37) {
                if ((i + 1) < len) {
                    if ((charAt line (i + 1)) == 37) {
                        return (substring line 0 i)
                    }
                }
            }
            i = (i + 1)
        }
        return line
    }

    fn statement:void (st:string) {
        def word:string (MermaidReader.firstWord(st))
        def kw:string (MermaidReader.lower(word))
        def rest:string (trim (substring st (strlen word) (strlen st)))
        if (kw == "timeline") {
            return
        }
        if (kw == "title") {
            doc.title = (MermaidReader.cleanLabel(rest))
            return
        }
        if (kw == "section") {
            section = (MermaidReader.cleanLabel(rest))
            push doc.sections section
            return
        }
        if (kw == "acctitle") { return }
        if (kw == "accdescr") { return }
        ; `2004 : LinkedIn : Facebook` — the period, and then an event per
        ; colon. A line with no colon is a period on its own.
        def parts:[string] (strsplit st ":")
        def p (new MermaidTimelinePeriod)
        p.label = (MermaidReader.cleanLabel((itemAt parts 0)))
        if ((strlen p.label) == 0) {
            return
        }
        p.id = ("period" + (to_string periodSeq))
        periodSeq = (periodSeq + 1)
        p.section = section
        def k:int 1
        while (k < (array_length parts)) {
            def text:string (MermaidReader.cleanLabel((itemAt parts k)))
            if ((strlen text) > 0) {
                def e (new MermaidTimelineEvent)
                e.id = ("event" + (to_string eventSeq))
                eventSeq = (eventSeq + 1)
                e.text = text
                push p.events e
            }
            k = (k + 1)
        }
        push doc.periods p
    }
}

; ---------------------------------------------------------------------------
; The pipeline
; ---------------------------------------------------------------------------
; Placed rather than laid out — see the header.
class MermaidTimelineFlow {
    sfn parse:MermaidTimeline (src:string) {
        return (MermaidTimelineReader.parse(src))
    }

    sfn render:FlowGraph (src:string) {
        def d:MermaidTimeline (MermaidTimelineReader.parse(src))
        def bare (new FlowStyle)
        return (MermaidTimelineFlow.build(d bare))
    }

    sfn build:FlowGraph (d:MermaidTimeline style:FlowStyle) {
        def g (new FlowGraph)
        def colWidth:double 190.0
        def colGap:double 26.0
        def periodH:double 46.0
        def eventH:double 54.0
        def rowGap:double 16.0
        def topPad:double 40.0
        def x:double 0.0
        def i:int 0
        while (i < (array_length d.periods)) {
            def p:MermaidTimelinePeriod (itemAt d.periods i)
            def n:FlowNode (FlowNode.create(p.id p.label x topPad))
            n.nodeType = "step"
            n.shape = "rect"
            n.borderRadius = 14.0
            n.width = colWidth
            n.height = periodH
            n.cssClass = "mermaid period"
            n.addSideHandles()
            n.syncFromModel()
            g.addNode(n)
            def y:double ((topPad + periodH) + 34.0)
            def k:int 0
            while (k < (array_length p.events)) {
                def e:MermaidTimelineEvent (itemAt p.events k)
                def en:FlowNode (FlowNode.create(e.id e.text x y))
                en.nodeType = "step"
                en.shape = "rect"
                en.borderRadius = 8.0
                en.width = colWidth
                en.height = eventH
                en.cssClass = "mermaid event"
                en.addSideHandles()
                en.syncFromModel()
                g.addNode(en)
                y = ((y + eventH) + rowGap)
                k = (k + 1)
            }
            x = ((x + colWidth) + colGap)
            i = (i + 1)
        }
        g.reindex()
        ; The lines: a period holds its events, and one period follows the
        ; next. Neither is an arrow — a timeline's direction is the axis.
        def pi:int 0
        while (pi < (array_length d.periods)) {
            def p2:MermaidTimelinePeriod (itemAt d.periods pi)
            def k2:int 0
            while (k2 < (array_length p2.events)) {
                def e2:MermaidTimelineEvent (itemAt p2.events k2)
                def edge:FlowEdge (FlowEdge.create("" p2.id e2.id))
                edge.edgeType = "smoothstep"
                edge.markerEnd = ""
                edge.cssClass = "link holds"
                edge.sourceHandle = 2
                edge.targetHandle = 0
                g.addEdge(edge)
                k2 = (k2 + 1)
            }
            if ((pi + 1) < (array_length d.periods)) {
                def next:MermaidTimelinePeriod (itemAt d.periods (pi + 1))
                def axis:FlowEdge (FlowEdge.create("" p2.id next.id))
                axis.edgeType = "straight"
                axis.markerEnd = "arrow"
                axis.cssClass = "link axis"
                axis.sourceHandle = 1
                axis.targetHandle = 3
                g.addEdge(axis)
            }
            pi = (pi + 1)
        }
        g.reindex()
        def wrote:int (style.applyTo(g))
        def frames:int (MermaidTimelineFlow.frameSections(d g style))
        def moved:int (EdgeLanes.assign(g))
        return g
    }

    ; A section is a frame over the columns that belong to it.
    sfn frameSections:int (d:MermaidTimeline g:FlowGraph style:FlowStyle) {
        def made:int 0
        def s:int 0
        while (s < (array_length d.sections)) {
            def name:string (itemAt d.sections s)
            def r (new FlowRect)
            def i:int 0
            while (i < (array_length d.periods)) {
                def p:MermaidTimelinePeriod (itemAt d.periods i)
                if (p.section == name) {
                    MermaidTimelineFlow.growTo(r g p.id)
                    def k:int 0
                    while (k < (array_length p.events)) {
                        def e:MermaidTimelineEvent (itemAt p.events k)
                        MermaidTimelineFlow.growTo(r g e.id)
                        k = (k + 1)
                    }
                }
                i = (i + 1)
            }
            if r.valid {
                def pad:double 18.0
                def head:double 26.0
                def frameId:string ("sg-section" + (to_string s))
                def frame:FlowNode (FlowNode.create(frameId name (r.x - pad) ((r.y - pad) - head)))
                frame.nodeType = "group"
                frame.width = (r.w + (pad * 2.0))
                def hh:double ((r.h + (pad * 2.0)) + head)
                frame.height = hh
                frame.connectable = false
                frame.cssClass = "mermaid section"
                frame.bgColor = "#f6f7fb"
                frame.borderColor = "#c9cede"
                frame.syncFromModel()
                g.addNode(frame)
                style.styleNode(frame)
                g.sendToBack(frameId)
                made = (made + 1)
            }
            s = (s + 1)
        }
        return made
    }

    sfn growTo:void (r:FlowRect g:FlowGraph id:string) {
        if ((g.hasNode(id)) == false) {
            return
        }
        def n:FlowNode (g.nodeById(id))
        def right:double (n.x + n.width)
        def bottom:double (n.y + n.height)
        if (r.valid == false) {
            r.x = n.x
            r.y = n.y
            r.w = n.width
            r.h = n.height
            r.valid = true
            return
        }
        if (n.x < r.x) {
            def dw:double (r.x - n.x)
            r.x = n.x
            r.w = (r.w + dw)
        }
        if (n.y < r.y) {
            def dh:double (r.y - n.y)
            r.y = n.y
            r.h = (r.h + dh)
        }
        def rr:double (r.x + r.w)
        if (right > rr) {
            r.w = (right - r.x)
        }
        def rb:double (r.y + r.h)
        if (bottom > rb) {
            r.h = (bottom - r.y)
        }
    }
}

; ============================================================================
; MermaidArchReader.rgr — services, and which side of what they sit on.
; ============================================================================
;
; `architecture-beta` writes its connections with a SIDE on each end:
;
;     db:L -- R:server
;
; — the database's left port, joined to the server's right port. That is not
; decoration. It says where the two things are relative to one another, and
; it is the only placement information the diagram has, so this reader uses
; it as the layout: the first service goes down, and every other one is
; placed on the side its own connection asked for.
;
;   ┌────────── API ──────────┐
;   │   ┌────┐      ┌──────┐  │      server:R -- L:db  puts the server
;   │   │ srv│──────│  db  │  │      to the LEFT of the database, because
;   │   └─┬──┘      └──────┘  │      that is the side the author used.
;   │   ┌─┴──┐                │
;   │   │disk│                │
;   │   └────┘                │
;   └─────────────────────────┘
;
; A layout engine asked to place these would produce a perfectly good picture
; of a different arrangement. So there is no layout engine here.
;
; **What it reads.** `group`, `service` and `junction` with their icons,
; labels and `in` parent; the four connection arrows (`--`, `-->`, `<--`,
; `<-->`) with a side on each end; and `{group}` on an endpoint, which joins
; a group rather than the service inside it.
; ============================================================================

Import "MermaidReader.rgr"
Import "../../core/FlowStyleSheet.rgr"

class MermaidArchNode {
    def id:string ""
    def label:string ""
    def icon:string ""
    def parent:string ""
    def isGroup:boolean false
    def isJunction:boolean false
    ; Where it ended up, in cells rather than pixels.
    def col:int 0
    def row:int 0
    def placed:boolean false

    Constructor () {
    }
}

class MermaidArchEdge {
    def source:string ""
    def target:string ""
    ; "L" | "R" | "T" | "B"
    def sourceSide:string "R"
    def targetSide:string "L"
    def sourceArrow:boolean false
    def targetArrow:boolean false
    ; `a{group}:T` joins the group rather than the service.
    def sourceGroup:boolean false
    def targetGroup:boolean false

    Constructor () {
    }
}

class MermaidArchitecture {
    def title:string ""
    def nodes:[MermaidArchNode]
    def edges:[MermaidArchEdge]

    Constructor () {
    }

    fn nodeCount:int () {
        return (array_length nodes)
    }

    fn edgeCount:int () {
        return (array_length edges)
    }

    fn groupCount:int () {
        def n:int 0
        def i:int 0
        while (i < (array_length nodes)) {
            def x:MermaidArchNode (itemAt nodes i)
            if x.isGroup {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    fn serviceCount:int () {
        return ((array_length nodes) - (this.groupCount()))
    }

    fn indexOf:int (id:string) {
        def i:int 0
        while (i < (array_length nodes)) {
            def x:MermaidArchNode (itemAt nodes i)
            if (x.id == id) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }
}

class MermaidArchReader {
    def doc:MermaidArchitecture (new MermaidArchitecture)

    Constructor () {
    }

    sfn parse:MermaidArchitecture (src:string) {
        def r (new MermaidArchReader)
        return (r.read(src))
    }

    fn read:MermaidArchitecture (src:string) {
        def lines:[string] (strsplit src "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def raw:string (trim (itemAt lines i))
            i = (i + 1)
            def line:string (trim (MermaidArchReader.stripComment(raw)))
            if ((strlen line) == 0) {
                continue
            }
            this.statement(line)
        }
        return doc
    }

    sfn stripComment:string (line:string) {
        def len:int (strlen line)
        def i:int 0
        while (i < len) {
            def c:int (charAt line i)
            if (c == 37) {
                if ((i + 1) < len) {
                    if ((charAt line (i + 1)) == 37) {
                        return (substring line 0 i)
                    }
                }
            }
            i = (i + 1)
        }
        return line
    }

    fn statement:void (st:string) {
        def word:string (MermaidReader.firstWord(st))
        def kw:string (MermaidReader.lower(word))
        def rest:string (trim (substring st (strlen word) (strlen st)))
        if (MermaidReader.beginsWith(kw "architecture")) { return }
        if (MermaidReader.beginsWith(kw "acctitle")) { return }
        if (MermaidReader.beginsWith(kw "accdescr")) { return }
        if (kw == "title") {
            doc.title = (MermaidReader.cleanLabel(rest))
            return
        }
        if (kw == "group") {
            this.declare(rest true false)
            return
        }
        if (kw == "service") {
            this.declare(rest false false)
            return
        }
        if (kw == "junction") {
            this.declare(rest false true)
            return
        }
        this.edge(st)
    }

    ; `api(cloud)[API] in parent` — the name, the icon, the label, the parent.
    fn declare:void (rest:string isGroup:boolean isJunction:boolean) {
        def t:string (trim rest)
        if ((strlen t) == 0) {
            return
        }
        def n (new MermaidArchNode)
        n.isGroup = isGroup
        n.isJunction = isJunction
        def head:string t
        def inAt:int (MermaidArchReader.inWordAt(t))
        if (inAt >= 0) {
            head = (trim (substring t 0 inAt))
            n.parent = (MermaidReader.firstWord((trim (substring t (inAt + 4) (strlen t)))))
        }
        def paren:int (MermaidArchReader.charIndex(head 40))
        def bracket:int (MermaidArchReader.charIndex(head 91))
        def cut:int (strlen head)
        if (paren >= 0) {
            cut = paren
        }
        if (bracket >= 0) {
            if (bracket < cut) {
                cut = bracket
            }
        }
        n.id = (trim (substring head 0 cut))
        if ((strlen n.id) == 0) {
            return
        }
        if (paren >= 0) {
            def close:int (MermaidArchReader.charIndex(head 41))
            if (close > paren) {
                n.icon = (MermaidReader.lower((trim (substring head (paren + 1) close))))
            }
        }
        if (bracket >= 0) {
            def closeB:int (MermaidArchReader.lastIndex(head 93))
            if (closeB > bracket) {
                n.label = (MermaidReader.cleanLabel((substring head (bracket + 1) closeB)))
            }
        }
        if ((strlen n.label) == 0) {
            n.label = n.id
        }
        if isJunction {
            n.label = ""
        }
        push doc.nodes n
    }

    ; The word `in`, standing alone. A service called `install` is not one.
    sfn inWordAt:int (t:string) {
        def n:int (strlen t)
        def i:int 1
        while ((i + 3) <= n) {
            if ((charAt t i) == 32) {
                def a:int (charAt t (i + 1))
                def b:int (charAt t (i + 2))
                def isIn:boolean false
                if (a == 105) {
                    if (b == 110) { isIn = true }
                }
                if (a == 73) {
                    if (b == 78) { isIn = true }
                }
                if isIn {
                    if ((i + 3) < n) {
                        if ((charAt t (i + 3)) == 32) {
                            return i
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return -1
    }

    ; `db:L -- R:server`, `a:R --> L:b`, `a{group}:T <--> B:b`.
    fn edge:void (st:string) {
        def at:int (MermaidArchReader.dashesAt(st))
        if (at < 0) {
            return
        }
        def n:int (strlen st)
        def stop:int at
        while (stop < n) {
            if ((charAt st stop) == 45) {
                stop = (stop + 1)
            } {
                break
            }
        }
        def left:string (trim (substring st 0 at))
        def right:string (trim (substring st stop n))
        def e (new MermaidArchEdge)
        ; A `<` before the dashes and a `>` after them are the two arrowheads.
        if (at > 0) {
            if ((charAt st (at - 1)) == 60) {
                e.sourceArrow = true
                left = (trim (substring st 0 (at - 1)))
            }
        }
        if (stop < n) {
            if ((charAt st stop) == 62) {
                e.targetArrow = true
                right = (trim (substring st (stop + 1) n))
            }
        }
        ; The left end is `id:SIDE`, the right end `SIDE:id`.
        def lc:int (MermaidArchReader.lastIndex(left 58))
        def rc:int (MermaidArchReader.charIndex(right 58))
        if (lc < 0) { return }
        if (rc < 0) { return }
        def sourceName:string (trim (substring left 0 lc))
        e.sourceSide = (MermaidReader.upper((trim (substring left (lc + 1) (strlen left)))))
        e.targetSide = (MermaidReader.upper((trim (substring right 0 rc))))
        def targetName:string (trim (substring right (rc + 1) (strlen right)))
        def sg:int (MermaidArchReader.charIndex(sourceName 123))
        if (sg > 0) {
            e.sourceGroup = true
            sourceName = (trim (substring sourceName 0 sg))
        }
        def tg:int (MermaidArchReader.charIndex(targetName 123))
        if (tg > 0) {
            e.targetGroup = true
            targetName = (trim (substring targetName 0 tg))
        }
        e.source = sourceName
        e.target = targetName
        if ((strlen e.source) == 0) { return }
        if ((strlen e.target) == 0) { return }
        push doc.edges e
    }

    ; Where the run of dashes starts, ignoring a leading `<`.
    sfn dashesAt:int (st:string) {
        def n:int (strlen st)
        def i:int 0
        while ((i + 1) < n) {
            if ((charAt st i) == 45) {
                if ((charAt st (i + 1)) == 45) {
                    return i
                }
            }
            i = (i + 1)
        }
        return -1
    }

    sfn charIndex:int (t:string c:int) {
        def i:int 0
        while (i < (strlen t)) {
            if ((charAt t i) == c) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    sfn lastIndex:int (t:string c:int) {
        def at:int -1
        def i:int 0
        while (i < (strlen t)) {
            if ((charAt t i) == c) {
                at = i
            }
            i = (i + 1)
        }
        return at
    }
}

; ---------------------------------------------------------------------------
; The pipeline
; ---------------------------------------------------------------------------
class MermaidArchFlow {
    sfn parse:MermaidArchitecture (src:string) {
        return (MermaidArchReader.parse(src))
    }

    sfn render:FlowGraph (src:string) {
        def d:MermaidArchitecture (MermaidArchReader.parse(src))
        def bare (new FlowStyle)
        return (MermaidArchFlow.build(d bare))
    }

    sfn build:FlowGraph (d:MermaidArchitecture style:FlowStyle) {
        def g (new FlowGraph)
        if ((d.nodeCount()) == 0) {
            return g
        }
        MermaidArchFlow.placeAll(d)
        def cellW:double 190.0
        def cellH:double 120.0
        def minCol:int 0
        def minRow:int 0
        def first:boolean true
        def i:int 0
        while (i < (array_length d.nodes)) {
            def n:MermaidArchNode (itemAt d.nodes i)
            if (n.isGroup == false) {
                if first {
                    minCol = n.col
                    minRow = n.row
                    first = false
                } {
                    if (n.col < minCol) { minCol = n.col }
                    if (n.row < minRow) { minRow = n.row }
                }
            }
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length d.nodes)) {
            def s:MermaidArchNode (itemAt d.nodes k)
            if (s.isGroup == false) {
                def x:double ((to_double (s.col - minCol)) * cellW)
                def y:double ((to_double (s.row - minRow)) * cellH)
                def node:FlowNode (MermaidArchFlow.serviceNode(s x y))
                g.addNode(node)
            }
            k = (k + 1)
        }
        g.reindex()
        ; The groups, drawn around what turned out to be inside them.
        def backs:[string]
        def gi:int 0
        while (gi < (array_length d.nodes)) {
            def grp:MermaidArchNode (itemAt d.nodes gi)
            if grp.isGroup {
                MermaidArchFlow.frame(g d grp backs)
            }
            gi = (gi + 1)
        }
        g.reindex()
        def e:int 0
        while (e < (array_length d.edges)) {
            def ed:MermaidArchEdge (itemAt d.edges e)
            def from:string ed.source
            def to:string ed.target
            if ed.sourceGroup { from = ("sg-" + from) }
            if ed.targetGroup { to = ("sg-" + to) }
            if (g.hasNode(from)) {
                if (g.hasNode(to)) {
                    def link:FlowEdge (FlowEdge.create("" from to))
                    link.edgeType = "smoothstep"
                    link.markerEnd = ""
                    link.markerStart = ""
                    if ed.targetArrow { link.markerEnd = "arrowclosed" }
                    if ed.sourceArrow { link.markerStart = "arrowclosed" }
                    link.sourceHandle = (MermaidArchFlow.handleOf(ed.sourceSide))
                    link.targetHandle = (MermaidArchFlow.handleOf(ed.targetSide))
                    link.cssClass = "link service"
                    g.addEdge(link)
                }
            }
            e = (e + 1)
        }
        g.reindex()
        def wrote:int (style.applyTo(g))
        def b:int 0
        while (b < (array_length backs)) {
            def moved:boolean (g.sendToBack((itemAt backs b)))
            b = (b + 1)
        }
        return g
    }

    ; The layout, such as it is: the sides the author wrote. The first service
    ; goes at the origin and every other one is placed where its connection
    ; asked for it — `db:L -- R:server` puts the server to the LEFT of the
    ; database, because that is the side the author used.
    sfn placeAll:void (d:MermaidArchitecture) {
        def rounds:int 0
        def progress:boolean true
        while progress {
            progress = false
            rounds = (rounds + 1)
            if (rounds > 32) {
                break
            }
            def e:int 0
            while (e < (array_length d.edges)) {
                def ed:MermaidArchEdge (itemAt d.edges e)
                def si:int (d.indexOf(ed.source))
                def ti:int (d.indexOf(ed.target))
                if (si >= 0) {
                    if (ti >= 0) {
                        def a:MermaidArchNode (itemAt d.nodes si)
                        def b:MermaidArchNode (itemAt d.nodes ti)
                        if (a.isGroup == false) {
                            if (b.isGroup == false) {
                                if a.placed {
                                    if (b.placed == false) {
                                        MermaidArchFlow.put(d b (a.col + (MermaidArchFlow.dx(ed.sourceSide))) (a.row + (MermaidArchFlow.dy(ed.sourceSide))))
                                        progress = true
                                    }
                                } {
                                    if b.placed {
                                        MermaidArchFlow.put(d a (b.col + (MermaidArchFlow.dx(ed.targetSide))) (b.row + (MermaidArchFlow.dy(ed.targetSide))))
                                        progress = true
                                    }
                                }
                            }
                        }
                    }
                }
                e = (e + 1)
            }
            ; Nothing was joined to anything already down: start a new island.
            if (progress == false) {
                def i:int 0
                while (i < (array_length d.nodes)) {
                    def n:MermaidArchNode (itemAt d.nodes i)
                    if (n.isGroup == false) {
                        if (n.placed == false) {
                            MermaidArchFlow.put(d n 0 (MermaidArchFlow.freeRow(d)))
                            progress = true
                            break
                        }
                    }
                    i = (i + 1)
                }
            }
        }
    }

    ; A cell is taken by at most one service; where the side asked for one
    ; that is already occupied, the next free cell along keeps it near.
    sfn put:void (d:MermaidArchitecture n:MermaidArchNode col:int row:int) {
        def c:int col
        def r:int row
        def tries:int 0
        while (MermaidArchFlow.taken(d c r)) {
            tries = (tries + 1)
            if (tries > 64) {
                break
            }
            c = (c + 1)
        }
        n.col = c
        n.row = r
        n.placed = true
    }

    sfn taken:boolean (d:MermaidArchitecture col:int row:int) {
        def i:int 0
        while (i < (array_length d.nodes)) {
            def n:MermaidArchNode (itemAt d.nodes i)
            if n.placed {
                if (n.isGroup == false) {
                    if (n.col == col) {
                        if (n.row == row) {
                            return true
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return false
    }

    sfn freeRow:int (d:MermaidArchitecture) {
        def r:int 0
        def any:boolean false
        def i:int 0
        while (i < (array_length d.nodes)) {
            def n:MermaidArchNode (itemAt d.nodes i)
            if n.placed {
                if (any == false) {
                    r = n.row
                    any = true
                } {
                    if (n.row > r) { r = n.row }
                }
            }
            i = (i + 1)
        }
        if (any == false) {
            return 0
        }
        return (r + 2)
    }

    sfn dx:int (side:string) {
        if (side == "L") { return -1 }
        if (side == "R") { return 1 }
        return 0
    }

    sfn dy:int (side:string) {
        if (side == "T") { return -1 }
        if (side == "B") { return 1 }
        return 0
    }

    ; Which handle a side is: the model numbers them clockwise from the top.
    sfn handleOf:int (side:string) {
        if (side == "T") { return 0 }
        if (side == "R") { return 1 }
        if (side == "B") { return 2 }
        if (side == "L") { return 3 }
        return -1
    }

    sfn serviceNode:FlowNode (s:MermaidArchNode x:double y:double) {
        def n:FlowNode (FlowNode.create(s.id s.label x y))
        n.nodeType = "service"
        n.shape = (MermaidArchFlow.shapeFor(s.icon))
        n.width = 140.0
        n.height = 66.0
        n.borderRadius = 8.0
        n.cssClass = ("mermaid service " + (MermaidArchFlow.iconClass(s.icon)))
        if s.isJunction {
            ; A junction is a place where lines meet and nothing happens.
            n.shape = "circle"
            n.width = 20.0
            n.height = 20.0
            n.nodeType = "junction"
            n.cssClass = "mermaid junction"
            n.x = (x + 60.0)
            n.y = (y + 23.0)
        }
        n.addSideHandles()
        n.syncFromModel()
        return n
    }

    ; Mermaid draws an icon from an icon pack; the shape library has outlines
    ; instead. A database is a cylinder wherever it is drawn, and a disk is
    ; the same drum on its side — so the four icons Mermaid ships with a
    ; meaning get the outline that means it, and the rest get a box.
    sfn shapeFor:string (icon:string) {
        if (icon == "database") { return "cylinder" }
        if (icon == "disk")     { return "directdata" }
        if (icon == "server")   { return "predefined" }
        if (icon == "cloud")    { return "ellipse" }
        if (icon == "internet") { return "circle" }
        return "rect"
    }

    sfn iconClass:string (icon:string) {
        if ((strlen icon) == 0) {
            return ""
        }
        return ("icon-" + icon)
    }

    sfn frame:void (g:FlowGraph d:MermaidArchitecture grp:MermaidArchNode backs:[string]) {
        def r (new FlowRect)
        def i:int 0
        while (i < (array_length d.nodes)) {
            def n:MermaidArchNode (itemAt d.nodes i)
            if (n.parent == grp.id) {
                if (g.hasNode(n.id)) {
                    def node:FlowNode (g.nodeById(n.id))
                    MermaidArchFlow.growTo(r node)
                }
            }
            i = (i + 1)
        }
        if (r.valid == false) {
            return
        }
        def pad:double 24.0
        def head:double 30.0
        def id:string ("sg-" + grp.id)
        def frameNode:FlowNode (FlowNode.create(id grp.label (r.x - pad) ((r.y - pad) - head)))
        frameNode.nodeType = "group"
        frameNode.width = (r.w + (pad * 2.0))
        frameNode.height = ((r.h + (pad * 2.0)) + head)
        frameNode.connectable = false
        frameNode.draggable = false
        frameNode.cssClass = ("mermaid archgroup " + (MermaidArchFlow.iconClass(grp.icon)))
        frameNode.bgColor = "#f6f7fb"
        frameNode.borderColor = "#c9cede"
        frameNode.addSideHandles()
        frameNode.syncFromModel()
        g.addNode(frameNode)
        push backs id
    }

    sfn growTo:void (r:FlowRect n:FlowNode) {
        def right:double (n.x + n.width)
        def bottom:double (n.y + n.height)
        if (r.valid == false) {
            r.x = n.x
            r.y = n.y
            r.w = n.width
            r.h = n.height
            r.valid = true
            return
        }
        if (n.x < r.x) {
            def dw:double (r.x - n.x)
            r.x = n.x
            r.w = (r.w + dw)
        }
        if (n.y < r.y) {
            def dh:double (r.y - n.y)
            r.y = n.y
            r.h = (r.h + dh)
        }
        def rr:double (r.x + r.w)
        if (right > rr) {
            r.w = (right - r.x)
        }
        def rb:double (r.y + r.h)
        if (bottom > rb) {
            r.h = (bottom - r.y)
        }
    }
}

; ============================================================================
; MermaidQuadrantReader.rgr — two axes, four corners, and a scatter of dots.
; ============================================================================
;
; A quadrant chart is a scatter plot that has been told what its corners MEAN.
; The numbers do the placing — `[0.3, 0.6]` is three tenths along and six
; tenths up, and nothing may move it — and the four labels turn a cloud of
; dots into an argument about what to do next.
;
;   High engagement ┌──────────────┬──────────────┐
;                   │ Need to      │  ● C         │
;                   │ promote      │  We should   │
;                   │              │  expand      │
;                   ├──────────────┼──────────────┤
;                   │  ● B         │              │
;                   │ Re-evaluate  │  May be      │
;                   │              │  improved    │
;   Low engagement  └──────────────┴──────────────┘
;                    Low reach       High reach
;
; **What it reads.** `title`, `x-axis`/`y-axis` with their two ends,
; `quadrant-1` … `quadrant-4`, and a point line — `Campaign A: [0.3, 0.6]` —
; with `radius:`, `color:` and `stroke-color:` after it, plus `:::class` and
; `classDef`, which is how Mermaid lets a sheet colour the same chart twice.
; ============================================================================

Import "MermaidReader.rgr"
Import "../../core/FlowStyleSheet.rgr"

class MermaidQuadrantPoint {
    def id:string ""
    def label:string ""
    ; Both in 0..1, which is the only coordinate system this chart has.
    def x:double 0.5
    def y:double 0.5
    def radius:double 5.0
    def color:string ""
    def strokeColor:string ""
    def cssClass:string ""

    Constructor () {
    }
}

class MermaidQuadrantClass {
    def name:string ""
    def fill:string ""
    def stroke:string ""

    Constructor () {
    }
}

class MermaidQuadrant {
    def title:string ""
    ; The ends of each axis, as they are written: left→right and bottom→top.
    def xLeft:string ""
    def xRight:string ""
    def yBottom:string ""
    def yTop:string ""
    ; Mermaid numbers them the way mathematics does: 1 is top right and they
    ; go anticlockwise.
    def q1:string ""
    def q2:string ""
    def q3:string ""
    def q4:string ""
    def points:[MermaidQuadrantPoint]
    def classes:[MermaidQuadrantClass]

    Constructor () {
    }

    fn pointCount:int () {
        return (array_length points)
    }

    fn classCount:int () {
        return (array_length classes)
    }

    fn classNamed:MermaidQuadrantClass (name:string) {
        def i:int 0
        while (i < (array_length classes)) {
            def c:MermaidQuadrantClass (itemAt classes i)
            if (c.name == name) {
                return c
            }
            i = (i + 1)
        }
        return (new MermaidQuadrantClass)
    }
}

class MermaidQuadrantReader {
    def doc:MermaidQuadrant (new MermaidQuadrant)
    def seq:int 0

    Constructor () {
    }

    sfn parse:MermaidQuadrant (src:string) {
        def r (new MermaidQuadrantReader)
        return (r.read(src))
    }

    fn read:MermaidQuadrant (src:string) {
        def lines:[string] (strsplit src "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def raw:string (trim (itemAt lines i))
            i = (i + 1)
            def line:string (trim (MermaidQuadrantReader.stripComment(raw)))
            if ((strlen line) == 0) {
                continue
            }
            this.statement(line)
        }
        return doc
    }

    sfn stripComment:string (line:string) {
        def len:int (strlen line)
        def i:int 0
        while (i < len) {
            def c:int (charAt line i)
            if (c == 37) {
                if ((i + 1) < len) {
                    if ((charAt line (i + 1)) == 37) {
                        return (substring line 0 i)
                    }
                }
            }
            i = (i + 1)
        }
        return line
    }

    fn statement:void (st:string) {
        def word:string (MermaidReader.firstWord(st))
        def kw:string (MermaidReader.lower(word))
        def rest:string (trim (substring st (strlen word) (strlen st)))
        if (kw == "quadrantchart") { return }
        if (MermaidReader.beginsWith(kw "acctitle")) { return }
        if (MermaidReader.beginsWith(kw "accdescr")) { return }
        if (kw == "title") {
            doc.title = (MermaidReader.cleanLabel(rest))
            return
        }
        if (kw == "x-axis") {
            def ends:[string] (MermaidQuadrantReader.axisEnds(rest))
            doc.xLeft = (itemAt ends 0)
            doc.xRight = (itemAt ends 1)
            return
        }
        if (kw == "y-axis") {
            def ends2:[string] (MermaidQuadrantReader.axisEnds(rest))
            doc.yBottom = (itemAt ends2 0)
            doc.yTop = (itemAt ends2 1)
            return
        }
        if (kw == "quadrant-1") {
            doc.q1 = (MermaidReader.cleanLabel(rest))
            return
        }
        if (kw == "quadrant-2") {
            doc.q2 = (MermaidReader.cleanLabel(rest))
            return
        }
        if (kw == "quadrant-3") {
            doc.q3 = (MermaidReader.cleanLabel(rest))
            return
        }
        if (kw == "quadrant-4") {
            doc.q4 = (MermaidReader.cleanLabel(rest))
            return
        }
        if (kw == "classdef") {
            this.classDef(rest)
            return
        }
        this.point(st)
    }

    ; `Low Reach --> High Reach`, or one end on its own.
    sfn axisEnds:[string] (rest:string) {
        def out:[string]
        def t:string (trim rest)
        def at:int (MermaidQuadrantReader.indexOfText(t "-->"))
        if (at < 0) {
            push out (MermaidReader.cleanLabel(t))
            push out ""
            return out
        }
        push out (MermaidReader.cleanLabel((trim (substring t 0 at))))
        push out (MermaidReader.cleanLabel((trim (substring t (at + 3) (strlen t)))))
        return out
    }

    fn classDef:void (rest:string) {
        def t:string (trim rest)
        def name:string (MermaidReader.firstWord(t))
        if ((strlen name) == 0) {
            return
        }
        def props:string (trim (substring t (strlen name) (strlen t)))
        def c (new MermaidQuadrantClass)
        c.name = name
        c.fill = (MermaidQuadrantReader.prop(props "fill"))
        c.stroke = (MermaidQuadrantReader.prop(props "stroke"))
        push doc.classes c
    }

    ; `fill: #ff0000, stroke: #000` — one property out of a comma list.
    sfn prop:string (props:string name:string) {
        def parts:[string] (strsplit props ",")
        def i:int 0
        while (i < (array_length parts)) {
            def p:string (trim (itemAt parts i))
            i = (i + 1)
            def colon:int (MermaidQuadrantReader.charIndex(p 58))
            if (colon < 0) {
                continue
            }
            def key:string (MermaidReader.lower((trim (substring p 0 colon))))
            if (key == name) {
                return (trim (substring p (colon + 1) (strlen p)))
            }
        }
        return ""
    }

    ; `Campaign A: [0.3, 0.6] radius: 10, color: #ff0000`
    fn point:void (st:string) {
        def open:int (MermaidQuadrantReader.charIndex(st 91))
        if (open < 0) {
            return
        }
        def close:int (MermaidQuadrantReader.charIndex(st 93))
        if (close < open) {
            return
        }
        def head:string (trim (substring st 0 open))
        def n:int (strlen head)
        if (n > 0) {
            if ((charAt head (n - 1)) == 58) {
                head = (trim (substring head 0 (n - 1)))
            }
        }
        def p (new MermaidQuadrantPoint)
        def marker:int (MermaidQuadrantReader.indexOfText(head ":::"))
        if (marker >= 0) {
            p.cssClass = (trim (substring head (marker + 3) (strlen head)))
            head = (trim (substring head 0 marker))
        }
        p.label = (MermaidReader.cleanLabel(head))
        if ((strlen p.label) == 0) {
            return
        }
        p.id = ("q" + (to_string seq))
        seq = (seq + 1)
        def inside:string (substring st (open + 1) close)
        def nums:[string] (strsplit inside ",")
        if ((array_length nums) < 2) {
            return
        }
        p.x = (MermaidQuadrantReader.numberOf((itemAt nums 0) 0.5))
        p.y = (MermaidQuadrantReader.numberOf((itemAt nums 1) 0.5))
        def tail:string (trim (substring st (close + 1) (strlen st)))
        if ((strlen tail) > 0) {
            def r:string (MermaidQuadrantReader.prop(tail "radius"))
            if ((strlen r) > 0) {
                p.radius = (MermaidQuadrantReader.numberOf(r 5.0))
            }
            p.color = (MermaidQuadrantReader.prop(tail "color"))
            p.strokeColor = (MermaidQuadrantReader.prop(tail "stroke-color"))
        }
        ; `color:` matches `stroke-color:` too if the search is careless, so
        ; the more specific one wins where both were found.
        if (p.color == p.strokeColor) {
            p.color = ""
        }
        push doc.points p
    }

    sfn numberOf:double (text:string fallback:double) {
        def t:string (trim text)
        if ((strlen t) == 0) {
            return fallback
        }
        def v@(optional):double (str2double t)
        if (null? v) {
            return fallback
        }
        return (unwrap v)
    }

    sfn charIndex:int (t:string c:int) {
        def i:int 0
        while (i < (strlen t)) {
            if ((charAt t i) == c) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    sfn indexOfText:int (text:string needle:string) {
        def n:int (strlen needle)
        def m:int (strlen text)
        if (n == 0) {
            return -1
        }
        def i:int 0
        while ((i + n) <= m) {
            def k:int 0
            def hit:boolean true
            while (k < n) {
                if ((charAt text (i + k)) != (charAt needle k)) {
                    hit = false
                    break
                }
                k = (k + 1)
            }
            if hit {
                return i
            }
            i = (i + 1)
        }
        return -1
    }
}

; ---------------------------------------------------------------------------
; The pipeline
; ---------------------------------------------------------------------------
class MermaidQuadrantFlow {
    sfn parse:MermaidQuadrant (src:string) {
        return (MermaidQuadrantReader.parse(src))
    }

    sfn render:FlowGraph (src:string) {
        def d:MermaidQuadrant (MermaidQuadrantReader.parse(src))
        def bare (new FlowStyle)
        return (MermaidQuadrantFlow.build(d bare))
    }

    sfn build:FlowGraph (d:MermaidQuadrant style:FlowStyle) {
        def g (new FlowGraph)
        def side:double 640.0
        def half:double (side * 0.5)
        def backs:[string]
        ; The four corners, as the frames they are. Mermaid numbers them the
        ; way mathematics does, so 1 is top right and they go anticlockwise.
        MermaidQuadrantFlow.quadrant(g backs "q1" d.q1 half 0.0 half)
        MermaidQuadrantFlow.quadrant(g backs "q2" d.q2 0.0 0.0 half)
        MermaidQuadrantFlow.quadrant(g backs "q3" d.q3 0.0 half half)
        MermaidQuadrantFlow.quadrant(g backs "q4" d.q4 half half half)
        ; The axis names, outside the square: down the left and along the
        ; bottom, each one where its end of the axis is.
        MermaidQuadrantFlow.axisLabel(g "ax-left" d.xLeft 0.0 (side + 14.0) half)
        MermaidQuadrantFlow.axisLabel(g "ax-right" d.xRight half (side + 14.0) half)
        MermaidQuadrantFlow.axisLabel(g "ay-bottom" d.yBottom (0.0 - 190.0) (side - 40.0) 176.0)
        MermaidQuadrantFlow.axisLabel(g "ay-top" d.yTop (0.0 - 190.0) 8.0 176.0)
        def i:int 0
        while (i < (array_length d.points)) {
            def p:MermaidQuadrantPoint (itemAt d.points i)
            def r:double p.radius
            if (r < 4.0) { r = 4.0 }
            if (r > 26.0) { r = 26.0 }
            ; y counts UP in the source and DOWN on the page, which is the one
            ; conversion this chart needs and the one nobody notices missing
            ; until every dot is in the wrong quadrant.
            def cx:double (p.x * side)
            def cy:double ((1.0 - p.y) * side)
            def n:FlowNode (FlowNode.create(p.id "" (cx - r) (cy - r)))
            n.nodeType = "point"
            n.shape = "circle"
            n.width = (r * 2.0)
            n.height = (r * 2.0)
            n.connectable = false
            n.cssClass = ("mermaid point")
            if ((strlen p.cssClass) > 0) {
                n.cssClass = (("mermaid point " + p.cssClass))
            }
            n.bgColor = "#2563eb"
            n.borderColor = "#1f2430"
            def cls:MermaidQuadrantClass (d.classNamed(p.cssClass))
            if ((strlen cls.fill) > 0)   { n.bgColor = cls.fill }
            if ((strlen cls.stroke) > 0) { n.borderColor = cls.stroke }
            if ((strlen p.color) > 0)       { n.bgColor = p.color }
            if ((strlen p.strokeColor) > 0) { n.borderColor = p.strokeColor }
            def beside:FlowAnnotation (n.addAnnotation(p.label 0.5 1.9))
            beside.fontSize = 11.0
            beside.width = 150.0
            n.syncFromModel()
            g.addNode(n)
            i = (i + 1)
        }
        g.reindex()
        def wrote:int (style.applyTo(g))
        ; A colour written on the point itself wins over the sheet: `color:
        ; #ff0000` in the source is the author saying THIS one is different,
        ; and a stylesheet that painted over it would be answering a question
        ; nobody asked.
        def c:int 0
        while (c < (array_length d.points)) {
            def pt:MermaidQuadrantPoint (itemAt d.points c)
            if (g.hasNode(pt.id)) {
                def node:FlowNode (g.nodeById(pt.id))
                def cls2:MermaidQuadrantClass (d.classNamed(pt.cssClass))
                if ((strlen cls2.fill) > 0)   { node.bgColor = cls2.fill }
                if ((strlen cls2.stroke) > 0) { node.borderColor = cls2.stroke }
                if ((strlen pt.color) > 0)       { node.bgColor = pt.color }
                if ((strlen pt.strokeColor) > 0) { node.borderColor = pt.strokeColor }
                node.syncFromModel()
            }
            c = (c + 1)
        }
        ; The dots are the content; the quadrants are the paper they are on.
        def b:int 0
        while (b < (array_length backs)) {
            def moved:boolean (g.sendToBack((itemAt backs b)))
            b = (b + 1)
        }
        return g
    }

    sfn quadrant:void (g:FlowGraph backs:[string] id:string label:string x:double y:double side:double) {
        def n:FlowNode (FlowNode.create(("sg-" + id) label x y))
        n.nodeType = "group"
        n.width = side
        n.height = side
        n.connectable = false
        n.draggable = false
        n.cssClass = ("mermaid quadrant " + id)
        n.bgColor = "#f6f7fb"
        n.borderColor = "#c9cede"
        n.syncFromModel()
        g.addNode(n)
        push backs ("sg-" + id)
    }

    sfn axisLabel:void (g:FlowGraph id:string label:string x:double y:double w:double) {
        if ((strlen label) == 0) {
            return
        }
        def n:FlowNode (FlowNode.create(id label x y))
        n.nodeType = "axislabel"
        n.shape = "rect"
        n.width = w
        n.height = 28.0
        n.connectable = false
        n.draggable = false
        n.cssClass = "mermaid axislabel"
        n.syncFromModel()
        g.addNode(n)
    }
}

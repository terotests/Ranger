; ============================================================================
; MermaidVennReader.rgr — circles, and what is in more than one of them.
; ============================================================================
;
; A Venn diagram is two facts and one picture: how big each set is, and how
; much of it is also in another one. The picture is circles that overlap, and
; the overlap is where the second fact goes.
;
;        ╭───────────╮   ╭───────────╮
;      ╭─┤  Apples   ├───┤  Bananas  ├─╮
;      │ │    30     │ 10│    20     │ │
;      ╰─┤           ├───┤           ├─╯
;        ╰───────────╯   ╰───────────╯
;
; The circles are sized by their own numbers — a set of 30 is bigger than a
; set of 20, because a Venn diagram whose circles are all the same size has
; thrown away half of what it was given.
;
; **What it reads.** `title`, `set A ["label"]: 30`, and
; `union A,B ["label"]: 10`. The brackets and the number are both optional,
; which is how Mermaid writes it too.
; ============================================================================

Import "MermaidReader.rgr"
Import "../../core/FlowStyleSheet.rgr"

class MermaidVennSet {
    def id:string ""
    def label:string ""
    def size:double 1.0
    ; The members of a union, in the order they were written. One name for a
    ; plain set, two or more for an overlap.
    def members:[string]

    Constructor () {
    }

    fn memberCount:int () {
        return (array_length members)
    }

    fn isUnion:boolean () {
        return ((array_length members) > 1)
    }
}

class MermaidVenn {
    def title:string ""
    def subsets:[MermaidVennSet]

    Constructor () {
    }

    fn subsetCount:int () {
        return (array_length subsets)
    }

    fn setCount:int () {
        def n:int 0
        def i:int 0
        while (i < (array_length subsets)) {
            def s:MermaidVennSet (itemAt subsets i)
            if ((s.isUnion()) == false) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    fn unionCount:int () {
        return ((array_length subsets) - (this.setCount()))
    }

    fn indexOfSet:int (id:string) {
        def n:int 0
        def i:int 0
        while (i < (array_length subsets)) {
            def s:MermaidVennSet (itemAt subsets i)
            if ((s.isUnion()) == false) {
                if (s.id == id) {
                    return n
                }
                n = (n + 1)
            }
            i = (i + 1)
        }
        return -1
    }

    fn plainAt:MermaidVennSet (index:int) {
        def n:int 0
        def i:int 0
        while (i < (array_length subsets)) {
            def s:MermaidVennSet (itemAt subsets i)
            if ((s.isUnion()) == false) {
                if (n == index) {
                    return s
                }
                n = (n + 1)
            }
            i = (i + 1)
        }
        return (new MermaidVennSet)
    }

    fn biggest:double () {
        def m:double 1.0
        def i:int 0
        while (i < (array_length subsets)) {
            def s:MermaidVennSet (itemAt subsets i)
            if ((s.isUnion()) == false) {
                if (s.size > m) {
                    m = s.size
                }
            }
            i = (i + 1)
        }
        return m
    }
}

class MermaidVennReader {
    def doc:MermaidVenn (new MermaidVenn)

    Constructor () {
    }

    sfn parse:MermaidVenn (src:string) {
        def r (new MermaidVennReader)
        return (r.read(src))
    }

    fn read:MermaidVenn (src:string) {
        def lines:[string] (strsplit src "\n")
        def i:int 0
        while (i < (array_length lines)) {
            def raw:string (trim (itemAt lines i))
            i = (i + 1)
            def line:string (trim (MermaidVennReader.stripComment(raw)))
            if ((strlen line) == 0) {
                continue
            }
            this.statement(line)
        }
        return doc
    }

    sfn stripComment:string (line:string) {
        def len:int (strlen line)
        def i:int 0
        while (i < len) {
            def c:int (charAt line i)
            if (c == 37) {
                if ((i + 1) < len) {
                    if ((charAt line (i + 1)) == 37) {
                        return (substring line 0 i)
                    }
                }
            }
            i = (i + 1)
        }
        return line
    }

    fn statement:void (st:string) {
        def word:string (MermaidReader.firstWord(st))
        def kw:string (MermaidReader.lower(word))
        def rest:string (trim (substring st (strlen word) (strlen st)))
        if (MermaidReader.beginsWith(kw "venn")) { return }
        if (MermaidReader.beginsWith(kw "acctitle")) { return }
        if (MermaidReader.beginsWith(kw "accdescr")) { return }
        if (kw == "title") {
            doc.title = (MermaidReader.cleanLabel(rest))
            return
        }
        if (kw == "set") {
            this.subset(rest)
            return
        }
        if (kw == "union") {
            this.subset(rest)
            return
        }
        ; `text` and `style` say things about a set that this drawing has no
        ; room for. Read and dropped rather than half-drawn.
    }

    ; `A ["Apples"]: 30`, `A,B ["Both"]: 10`, or either half on its own.
    fn subset:void (rest:string) {
        def t:string (trim rest)
        if ((strlen t) == 0) {
            return
        }
        def s (new MermaidVennSet)
        def names:string t
        def bracket:int (MermaidVennReader.charIndex(t 91))
        def colon:int (MermaidVennReader.lastIndex(t 58))
        if (colon >= 0) {
            def numberText:string (trim (substring t (colon + 1) (strlen t)))
            def v@(optional):double (str2double numberText)
            if (!null? v) {
                s.size = (unwrap v)
            }
            names = (trim (substring t 0 colon))
        }
        def b2:int (MermaidVennReader.charIndex(names 91))
        if (b2 >= 0) {
            def close:int (MermaidVennReader.lastIndex(names 93))
            if (close > b2) {
                s.label = (MermaidReader.cleanLabel((substring names (b2 + 1) close)))
            }
            names = (trim (substring names 0 b2))
        }
        def parts:[string] (strsplit names ",")
        def i:int 0
        while (i < (array_length parts)) {
            def name:string (MermaidReader.unquote((trim (itemAt parts i))))
            i = (i + 1)
            if ((strlen name) == 0) {
                continue
            }
            push s.members name
        }
        if ((array_length s.members) == 0) {
            return
        }
        s.id = (itemAt s.members 0)
        if ((s.isUnion())) {
            s.id = names
        }
        if ((strlen s.label) == 0) {
            s.label = s.id
        }
        push doc.subsets s
    }

    sfn charIndex:int (t:string c:int) {
        def i:int 0
        while (i < (strlen t)) {
            if ((charAt t i) == c) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    sfn lastIndex:int (t:string c:int) {
        def at:int -1
        def i:int 0
        while (i < (strlen t)) {
            if ((charAt t i) == c) {
                at = i
            }
            i = (i + 1)
        }
        return at
    }
}

; ---------------------------------------------------------------------------
; The pipeline
; ---------------------------------------------------------------------------
class MermaidVennFlow {
    sfn parse:MermaidVenn (src:string) {
        return (MermaidVennReader.parse(src))
    }

    sfn render:FlowGraph (src:string) {
        def d:MermaidVenn (MermaidVennReader.parse(src))
        def bare (new FlowStyle)
        return (MermaidVennFlow.build(d bare))
    }

    sfn build:FlowGraph (d:MermaidVenn style:FlowStyle) {
        def g (new FlowGraph)
        def n:int (d.setCount())
        if (n == 0) {
            return g
        }
        def biggest:double (d.biggest())
        ; Every label is collected and hung on the LAST circle at the end.
        ; An annotation is painted with the node that owns it, so a label on
        ; the first circle is painted over by the second — which in a diagram
        ; whose whole subject is circles overlapping is every label that
        ; matters.
        def labelX:[double]
        def labelY:[double]
        def labelText:[string]
        def labelBold:[int]
        def cx:[double]
        def cy:[double]
        def rr:[double]
        ; The circles are sized by their own numbers, and by AREA rather than
        ; by radius: a set twice as big is twice the ink, which is the thing
        ; a reader compares.
        def i:int 0
        while (i < n) {
            def s:MermaidVennSet (d.plainAt(i))
            def share:double (s.size / biggest)
            if (share <= 0.0) {
                share = 0.05
            }
            def r:double (160.0 * (sqrt share))
            if (r < 70.0) {
                r = 70.0
            }
            push rr r
            push cx 0.0
            push cy 0.0
            i = (i + 1)
        }
        MermaidVennFlow.arrange(cx cy rr n)
        def k:int 0
        while (k < n) {
            def s2:MermaidVennSet (d.plainAt(k))
            def r2:double (itemAt rr k)
            def id:string ("set-" + s2.id)
            def circle:FlowNode (FlowNode.create(id "" ((itemAt cx k) - r2) ((itemAt cy k) - r2)))
            ; NOT a `group`: a frame is painted as a rounded lane whatever
            ; shape it was given, and a Venn diagram of rounded rectangles is
            ; not a Venn diagram. The circles go in first instead, and
            ; everything added after them is drawn on top.
            circle.nodeType = "vennset"
            circle.shape = "circle"
            circle.width = (r2 * 2.0)
            circle.height = (r2 * 2.0)
            circle.connectable = false
            circle.draggable = false
            circle.cssClass = ("mermaid vennset " + (MermaidVennFlow.tint(k)))
            circle.bgColor = (MermaidVennFlow.paleAt(k))
            circle.borderColor = (MermaidVennFlow.colorAt(k))
            circle.syncFromModel()
            g.addNode(circle)
            ; The name goes at the circle's own outer edge — outward along
            ; the line from the middle of the drawing — because the middle is
            ; where every overlap is and no name can be read there.
            def ox:double (itemAt cx k)
            def oy:double (itemAt cy k)
            def len:double (sqrt ((ox * ox) + (oy * oy)))
            def ux:double 0.0
            def uy:double -1.0
            if (len > 0.001) {
                ux = (ox / len)
                uy = (oy / len)
            }
            push labelX (ox + (ux * (r2 * 0.66)))
            push labelY (oy + (uy * (r2 * 0.66)))
            push labelText (MermaidVennFlow.caption(s2))
            push labelBold 1
            k = (k + 1)
        }
        ; The overlaps: written where the circles they name actually meet.
        def u:int 0
        while (u < (array_length d.subsets)) {
            def s3:MermaidVennSet (itemAt d.subsets u)
            if (s3.isUnion()) {
                def sx:double 0.0
                def sy:double 0.0
                def found:int 0
                def m:int 0
                while (m < (array_length s3.members)) {
                    def at:int (d.indexOfSet((itemAt s3.members m)))
                    if (at >= 0) {
                        sx = (sx + (itemAt cx at))
                        sy = (sy + (itemAt cy at))
                        found = (found + 1)
                    }
                    m = (m + 1)
                }
                if (found > 0) {
                    ; The middle of the circles it names is where the overlap
                    ; is. A pair's midpoint is pushed further out than a
                    ; triple's centroid, or the two labels land on each other
                    ; in the one place they both describe.
                    def spread:double 1.0
                    if (found == 2) {
                        spread = 1.5
                    }
                    def mx:double ((sx / (to_double found)) * spread)
                    def my:double ((sy / (to_double found)) * spread)
                    push labelX mx
                    push labelY my
                    push labelText (MermaidVennFlow.caption(s3))
                    push labelBold 0
                }
            }
            u = (u + 1)
        }
        def hostId:string ("set-" + ((d.plainAt(n - 1)).id))
        if (g.hasNode(hostId)) {
            def host:FlowNode (g.nodeById(hostId))
            def hr:double (itemAt rr (n - 1))
            def hx:double ((itemAt cx (n - 1)) - hr)
            def hy:double ((itemAt cy (n - 1)) - hr)
            def t:int 0
            while (t < (array_length labelText)) {
                def a:FlowAnnotation (host.addAnnotation((itemAt labelText t) (MermaidVennFlow.rel((itemAt labelX t) hx hr)) (MermaidVennFlow.rel((itemAt labelY t) hy hr))))
                a.width = 200.0
                a.fontSize = 12.0
                if ((itemAt labelBold t) == 1) {
                    a.fontSize = 13.0
                    a.bold = true
                }
                t = (t + 1)
            }
            host.syncFromModel()
        }
        g.reindex()
        def wrote:int (style.applyTo(g))
        def p:int 0
        while (p < n) {
            def s4:MermaidVennSet (d.plainAt(p))
            def id2:string ("set-" + s4.id)
            if (g.hasNode(id2)) {
                def node:FlowNode (g.nodeById(id2))
                node.bgColor = (MermaidVennFlow.paleAt(p))
                node.borderColor = (MermaidVennFlow.colorAt(p))
                node.syncFromModel()
            }
            p = (p + 1)
        }
        return g
    }

    ; A page coordinate as a fraction of a circle's own box, which is what an
    ; annotation offset is measured in.
    sfn rel:double (v:double origin:double r:double) {
        return ((v - origin) / (r * 2.0))
    }

    ; The name, and the number if there was one worth writing.
    sfn caption:string (s:MermaidVennSet) {
        def size:string (MermaidVennFlow.numberText(s.size))
        if (s.size <= 0.0) {
            return s.label
        }
        return ((s.label + "  ") + size)
    }

    ; Where the circles go. Two sit side by side and overlap; three make a
    ; triangle; more go round a ring. In every case they are placed to
    ; OVERLAP, because a Venn diagram whose circles miss each other has drawn
    ; the one thing it exists to deny.
    sfn arrange:void (cx:[double] cy:[double] rr:[double] n:int) {
        if (n == 1) {
            return
        }
        def avg:double 0.0
        def i:int 0
        while (i < n) {
            avg = (avg + (itemAt rr i))
            i = (i + 1)
        }
        avg = (avg / (to_double n))
        if (n == 2) {
            def d2:double (((itemAt rr 0) + (itemAt rr 1)) * 0.62)
            set_at cx 0 (0.0 - (d2 * 0.5))
            set_at cx 1 (d2 * 0.5)
            return
        }
        ; Three or more: on a ring whose radius leaves each pair overlapping.
        def ring:double (avg * 0.72)
        if (n > 3) {
            ring = (avg * 1.0)
        }
        def turn:double 6.283185307179586
        def k:int 0
        while (k < n) {
            def a:double (((0.0 - 1.5707963267948966)) + ((turn * (to_double k)) / (to_double n)))
            set_at cx k (ring * (cos a))
            set_at cy k (ring * (sin a))
            k = (k + 1)
        }
    }

    sfn tint:string (index:int) {
        return ("vset-" + (to_string (index % 6)))
    }

    sfn colorAt:string (index:int) {
        def i:int (index % 6)
        if (i == 0) { return "#4c78a8" }
        if (i == 1) { return "#f58518" }
        if (i == 2) { return "#54a24b" }
        if (i == 3) { return "#e45756" }
        if (i == 4) { return "#72b7b2" }
        return "#b279a2"
    }

    ; Pale, because circles overlap and there is no opacity in the display
    ; list: the pale one IS the transparency.
    sfn paleAt:string (index:int) {
        def i:int (index % 6)
        if (i == 0) { return "#dbe4ef" }
        if (i == 1) { return "#fce7d2" }
        if (i == 2) { return "#dcecd8" }
        if (i == 3) { return "#fadada" }
        if (i == 4) { return "#e0f0ef" }
        return "#ecdfe9"
    }

    sfn numberText:string (v:double) {
        def whole:int (to_int v)
        def back:double (to_double whole)
        if ((fabs (v - back)) < 0.005) {
            return (to_string whole)
        }
        def tenths:int (to_int ((v * 10.0) + 0.5))
        def a:int (idiv tenths 10)
        def b:int (tenths - (a * 10))
        return (((to_string a) + ".") + (to_string b))
    }
}

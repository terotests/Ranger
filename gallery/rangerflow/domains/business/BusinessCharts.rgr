; ============================================================================
; BusinessCharts.rgr — the two diagrams a business actually draws.
; ============================================================================
;
; An organisation chart and a process with swimlanes. They look unrelated and
; they are the same graph twice: boxes, edges, and a layered layout. What is
; new here is the **lane** — a frame that owns the steps inside it, so that
; "who does this" is read off the row a box is in rather than from a label
; nobody reads.
;
;   ┌ Asiakas ─────────────────────────────────────────────────┐
;   │  ╭──────╮      ╱───────╱                                 │
;   │  │ alku │ ───► ╱ tilaus╱ ──┐                             │
;   └──╰──────╯──────────────────┼─────────────────────────────┘
;   ┌ Myynti ────────────────────┼─────────────────────────────┐
;   │                        ┌───▼────┐        ◇               │
;   │                        │ tarkista│ ────► luotto?         │
;   └────────────────────────└────────┘───────────────────────-┘
;
; A lane is a node with `nodeType = "group"`, and the steps in it carry its id
; in `parentId`. That is React Flow's sub-flow model, and it buys the one
; behaviour that makes lanes worth having: drag the lane and its contents come
; with it, because `FlowEditor.beginDrag` takes a selected node's descendants
; as well as the node. It is not a coordinate space — a child's position stays
; absolute — which is the simplification, and it is the right one here: a
; swimlane is a region a step is *in*, not a canvas it is drawn on.
;
; The org chart needs none of that and is the smaller half of the file: a tree,
; laid out by the same layered layout, with the department colouring a business
; reader looks for first.
; ============================================================================

Import "../../core/GraphModel.rgr"
Import "../../core/FlowShapes.rgr"

; --------------------------------------------------------------- org chart --
class OrgPerson {
    def id:string ""
    def name:string ""
    def role:string ""
    def unit:string ""
    def reportsTo:string ""
    ; A dotted line: the matrix report every organisation has and no
    ; organisation chart admits to.
    def dotted:boolean false

    Constructor () {
    }
}

class OrgChart {
    def title:string ""
    def people:[OrgPerson]
    def unitColors:[string]
    def unitNames:[string]

    Constructor () {
    }

    fn person:OrgPerson (id:string name:string role:string unit:string reportsTo:string) {
        def p (new OrgPerson)
        p.id = id
        p.name = name
        p.role = role
        p.unit = unit
        p.reportsTo = reportsTo
        push people p
        return p
    }

    fn unitColor:void (unit:string color:string) {
        push unitNames unit
        push unitColors color
        return
    }

    fn colorFor:string (unit:string) {
        def i:int 0
        while (i < (array_length unitNames)) {
            if ((itemAt unitNames i) == unit) {
                return (itemAt unitColors i)
            }
            i = (i + 1)
        }
        return ""
    }

    fn build:FlowGraph () {
        def g (new FlowGraph)
        def i:int 0
        while (i < (array_length people)) {
            def p:OrgPerson (itemAt people i)
            def n:FlowNode (FlowNode.create(p.id p.name 0.0 0.0))
            n.nodeType = "person"
            n.width = 190.0
            n.height = 62.0
            n.bgColor = (this.colorFor(p.unit))
            n.sourcePosition = 2
            n.targetPosition = 0
            ; Name in the header, role and unit as the one row under it: the
            ; compartment node the ERD uses, with two fewer compartments.
            n.headerHeight = 30.0
            n.rowHeight = 30.0
            def sec:FlowSection (n.addSection(""))
            def detail:string p.unit
            def row:FlowRow (FlowRow.create("" p.role detail ""))
            sec.addRow(row)
            n.layoutCompartments()
            n.height = 60.0
            n.syncFromModel()
            g.addNode(n)
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length people)) {
            def p2:OrgPerson (itemAt people k)
            if ((strlen p2.reportsTo) > 0) {
                if (g.hasNode(p2.reportsTo)) {
                    def e:FlowEdge (FlowEdge.create("" p2.reportsTo p2.id))
                    e.edgeType = "smoothstep"
                    e.markerEnd = ""
                    e.sourceHandle = 2
                    e.targetHandle = 0
                    if p2.dotted {
                        e.dash = 5.0
                    }
                    g.addEdge(e)
                }
            }
            k = (k + 1)
        }
        g.reindex()
        return g
    }
}

; ---------------------------------------------------------------- process ---
class LaneStep {
    def id:string ""
    def label:string ""
    def lane:string ""
    def shape:string "rect"
    def fill:string ""

    Constructor () {
    }
}

class LaneLink {
    def source:string ""
    def target:string ""
    def label:string ""

    Constructor () {
    }
}

class SwimlaneProcess {
    def title:string ""
    def laneIds:[string]
    def laneNames:[string]
    def steps:[LaneStep]
    def links:[LaneLink]

    ; Geometry. The lanes are stacked top to bottom and the steps run left to
    ; right inside them, which is the way every process diagram since the
    ; 1920s has been drawn.
    def laneHeight:double 150.0
    def laneGap:double 12.0
    def stepGap:double 70.0
    def leftPad:double 60.0
    def laneWidth:double 0.0

    Constructor () {
    }

    fn lane:void (id:string name:string) {
        push laneIds id
        push laneNames name
        return
    }

    fn step:LaneStep (id:string label:string lane:string shape:string) {
        def s (new LaneStep)
        s.id = id
        s.label = label
        s.lane = lane
        s.shape = shape
        push steps s
        return s
    }

    fn link:LaneLink (source:string target:string) {
        def l (new LaneLink)
        l.source = source
        l.target = target
        push links l
        return l
    }

    fn branch:LaneLink (source:string target:string label:string) {
        def l:LaneLink (this.link(source target))
        l.label = label
        return l
    }

    fn laneIndex:int (id:string) {
        def i:int 0
        while (i < (array_length laneIds)) {
            if ((itemAt laneIds i) == id) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; The steps are placed here rather than by the layered layout: a process
    ; with lanes has its rows decided by WHO does the work, and a layout free
    ; to move a box between rows would be free to reassign the work.
    ;
    ; The column is the step's distance from the start, counted along the
    ; links, so a step that waits for two others stands to the right of both.
    fn build:FlowGraph () {
        def g (new FlowGraph)
        def columns:[int]
        def widths:[double]
        def i:int 0
        while (i < (array_length steps)) {
            push columns 0
            def s0:LaneStep (itemAt steps i)
            push widths (this.widthOf(s0))
            i = (i + 1)
        }
        ; Longest path from the start, relaxed until it stops changing. The
        ; cap is the step count, which is the most a longest path can be.
        def pass:int 0
        while (pass < (array_length steps)) {
            def changed:boolean false
            def k:int 0
            while (k < (array_length links)) {
                def l:LaneLink (itemAt links k)
                def a:int (this.stepIndex(l.source))
                def b:int (this.stepIndex(l.target))
                if (a >= 0) {
                    if (b >= 0) {
                        def want:int ((itemAt columns a) + 1)
                        if (want > (itemAt columns b)) {
                            set_at columns b want
                            changed = true
                        }
                    }
                }
                k = (k + 1)
            }
            if changed {
                pass = (pass + 1)
            } {
                pass = (array_length steps)
            }
        }
        ; Column x positions: each column is as wide as its widest step, so a
        ; long label pushes the rest of the diagram right instead of over.
        def colCount:int 0
        def c:int 0
        while (c < (array_length columns)) {
            if (((itemAt columns c) + 1) > colCount) {
                colCount = ((itemAt columns c) + 1)
            }
            c = (c + 1)
        }
        def colX:[double]
        def colW:[double]
        def z:int 0
        while (z < colCount) {
            push colX 0.0
            push colW 120.0
            z = (z + 1)
        }
        def m:int 0
        while (m < (array_length steps)) {
            def col:int (itemAt columns m)
            if ((itemAt widths m) > (itemAt colW col)) {
                set_at colW col (itemAt widths m)
            }
            m = (m + 1)
        }
        def cursor:double leftPad
        def q:int 0
        while (q < colCount) {
            set_at colX q cursor
            cursor = ((cursor + (itemAt colW q)) + stepGap)
            q = (q + 1)
        }
        laneWidth = ((cursor - stepGap) + leftPad)

        ; Lanes first, so a click inside one finds the step and not the lane:
        ; `nodeAtPoint` walks the list backwards and takes the first hit.
        def li:int 0
        while (li < (array_length laneIds)) {
            def frame:FlowNode (FlowNode.create((itemAt laneIds li) (itemAt laneNames li) 0.0 ((to_double li) * (laneHeight + laneGap))))
            frame.nodeType = "group"
            frame.width = laneWidth
            frame.height = laneHeight
            frame.connectable = false
            frame.bgColor = (SwimlaneProcess.laneFill(li))
            frame.syncFromModel()
            g.addNode(frame)
            li = (li + 1)
        }
        def si:int 0
        while (si < (array_length steps)) {
            def s:LaneStep (itemAt steps si)
            def lane:int (this.laneIndex(s.lane))
            if (lane < 0) {
                lane = 0
            }
            def n:FlowNode (FlowNode.create(s.id s.label 0.0 0.0))
            n.nodeType = "step"
            n.shape = s.shape
            n.parentId = (itemAt laneIds lane)
            n.width = (itemAt widths si)
            n.height = 58.0
            if (s.shape == "diamond") {
                n.height = 78.0
            }
            n.bgColor = s.fill
            n.sourcePosition = 1
            n.targetPosition = 3
            def col2:int (itemAt columns si)
            n.x = ((itemAt colX col2) + (((itemAt colW col2) - n.width) * 0.5))
            n.y = (((to_double lane) * (laneHeight + laneGap)) + ((laneHeight - n.height) * 0.5))
            n.syncFromModel()
            g.addNode(n)
            si = (si + 1)
        }
        def e:int 0
        while (e < (array_length links)) {
            def l2:LaneLink (itemAt links e)
            if (g.hasNode(l2.source)) {
                if (g.hasNode(l2.target)) {
                    def edge:FlowEdge (FlowEdge.create("" l2.source l2.target))
                    edge.edgeType = "smoothstep"
                    edge.markerEnd = "arrowclosed"
                    edge.label = l2.label
                    g.addEdge(edge)
                }
            }
            e = (e + 1)
        }
        g.reindex()
        SwimlaneProcess.faceEdges(g)
        return g
    }

    fn stepIndex:int (id:string) {
        def i:int 0
        while (i < (array_length steps)) {
            def s:LaneStep (itemAt steps i)
            if (s.id == id) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    fn widthOf:double (s:LaneStep) {
        def w:double (((to_double (strlen s.label)) * 7.6) + 30.0)
        if (s.shape == "diamond") {
            w = (w * 1.35)
        }
        if (w < 110.0) { w = 110.0 }
        if (w > 220.0) { w = 220.0 }
        return w
    }

    ; Five bands, alternating, pale enough to read black text on.
    sfn laneFill:string (index:int) {
        def i:int (index % 4)
        if (i == 0) { return "#f7f9fc" }
        if (i == 1) { return "#f4f7f3" }
        if (i == 2) { return "#faf7f2" }
        return "#f6f4fa"
    }

    ; A process runs left to right, and a handover between lanes runs down or
    ; up. Facing the edges by where the two boxes actually are keeps a handover
    ; from being drawn back through the lane it came from.
    sfn faceEdges:void (g:FlowGraph) {
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            if (e.sourceIndex >= 0) {
                if (e.targetIndex >= 0) {
                    def a:FlowNode (g.nodeAt(e.sourceIndex))
                    def b:FlowNode (g.nodeAt(e.targetIndex))
                    def dx:double ((b.centerX()) - (a.centerX()))
                    def dy:double ((b.centerY()) - (a.centerY()))
                    if ((fabs dx) >= (fabs dy)) {
                        if (dx >= 0.0) {
                            e.sourceHandle = 1
                            e.targetHandle = 3
                        } {
                            e.sourceHandle = 3
                            e.targetHandle = 1
                        }
                    } {
                        if (dy >= 0.0) {
                            e.sourceHandle = 2
                            e.targetHandle = 0
                        } {
                            e.sourceHandle = 0
                            e.targetHandle = 2
                        }
                    }
                }
            }
            k = (k + 1)
        }
    }
}

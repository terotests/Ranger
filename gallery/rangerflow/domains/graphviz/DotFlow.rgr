; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; DotFlow.rgr — a DOT graph, drawn by the pipeline that already exists.
; ============================================================================
;
; `DotReader` produces a model of what the file said. This turns that into a
; `FlowGraph`, and from there nothing knows Graphviz exists: `LayeredLayout`
; ranks it, a router draws the edges and the four backends render them — the
; same road a Mermaid flowchart and a PlantUML component diagram take.
;
; Three things are worth knowing about the translation:
;
; **Graphviz's default node is an ellipse**, not a box. A DOT file that says
; nothing about shapes is a page of ellipses in Graphviz, and a page of
; rectangles here would be a different drawing of the same text.
;
; **`rankdir` is the layout's direction.** `TB` and `LR` land on the layered
; layout's own two; `BT` and `RL` are the same axis read backwards and land on
; the axis they belong to rather than on nothing.
;
; **A cluster is a band, not a bounding box.** This is the lesson the PlantUML
; packages taught: a frame drawn around wherever the layout happened to leave
; the members will swallow a node that belongs to no cluster, and a cluster
; that claims a node it never declared is a drawing that says something false.
; Each root cluster gets a column and keeps it in every layer.
;
; What is NOT drawn yet, and is listed rather than hidden: `record` and
; HTML-like labels (they land as their text), ports and compass points (read
; into the model, not yet aimed at), and every attribute outside the list in
; `DotStyle` below. `docs/GRAPHVIZ_PARITY.md` is where the gap is counted.
; ============================================================================

Import "DotReader.rgr"
Import "DotColors.rgr"
Import "DotRecordLabel.rgr"
Import "../../core/GraphModel.rgr"
Import "../../core/FlowStyleSheet.rgr"
Import "../../layout/LayeredLayout.rgr"
Import "../../layout/EdgeLanes.rgr"
Import "../../layout/OrthoRouter.rgr"
Import "../../layout/ReadableRouter.rgr"
Import "../flowchart/Flowchart.rgr"

; ---------------------------------------------------------------------------
; The colours
; ---------------------------------------------------------------------------
; Every name comes from `DotColors.rgr`, which is generated by asking Graphviz
; what it painted with — 666 of them, none of them typed here. This is the
; rest of what a DOT file may write where a colour is expected, which the table
; cannot answer on its own.
class DotPalette {
    def names:DotColors (new DotColors)

    Constructor () {
    }

    ; `#rrggbb` and `#rgb` pass through, `#rrggbbaa` loses the alpha nothing
    ; downstream can paint with, `h s v` is computed, `/x11/red` is `red`, a
    ; colour list or a gradient is its first stop, and a name is the table's.
    ; A name the table does not know comes back empty: a reader that does not
    ; know a colour leaves it to the theme rather than inventing a shade.
    fn resolve:string (raw:string) {
        def t:string (trim raw)
        if ((strlen t) == 0) {
            return ""
        }
        ; `red:blue` is a two-stop gradient and `red;0.5:blue` a weighted one.
        ; RangerFlow paints one colour, so it paints the first.
        def cut:int (DotPalette.findCode(t 58))
        if (cut > 0) {
            if ((charAt t 0) != 47) {
                def head:string (substring t 0 cut)
                def semi:int (DotPalette.findCode(head 59))
                if (semi > 0) {
                    head = (substring head 0 semi)
                }
                return (this.resolve(head))
            }
        }
        ; `/x11/red`, `/svg/red`, and the bare `x11/red` a scheme attribute
        ; leaves behind. The scheme is dropped: the names this table has are
        ; the ones Graphviz answered for.
        def slash:int (DotPalette.lastCode(t 47))
        if (slash >= 0) {
            def tail:string (substring t (slash + 1) (strlen t))
            if ((strlen tail) == 0) {
                return ""
            }
            return (this.resolve(tail))
        }
        if ((charAt t 0) == 35) {
            return (DotPalette.hexOf(t))
        }
        if (DotPalette.looksNumeric(t)) {
            return (DotPalette.fromHsv(t))
        }
        return (names.hex((DotChars.lower(t))))
    }

    sfn findCode:int (t:string code:int) {
        def i:int 0
        while (i < (strlen t)) {
            if ((charAt t i) == code) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    sfn lastCode:int (t:string code:int) {
        def at:int -1
        def i:int 0
        while (i < (strlen t)) {
            if ((charAt t i) == code) {
                at = i
            }
            i = (i + 1)
        }
        return at
    }

    ; `#rgb` is the three-digit form every browser takes, `#rrggbbaa` carries an
    ; alpha the scene has nowhere to put.
    sfn hexOf:string (t:string) {
        def body:string (substring t 1 (strlen t))
        def n:int (strlen body)
        if (n == 3) {
            def out:string "#"
            def i:int 0
            while (i < 3) {
                def c:string (substring body i (i + 1))
                out = ((out + c) + c)
                i = (i + 1)
            }
            return out
        }
        if (n >= 6) {
            return ("#" + (substring body 0 6))
        }
        return ""
    }

    ; `0.482 0.714 0.878` — three numbers, hue, saturation and value, each
    ; between zero and one. Graphviz takes them separated by spaces or commas.
    sfn looksNumeric:boolean (t:string) {
        def seen:int 0
        def i:int 0
        while (i < (strlen t)) {
            def c:int (charAt t i)
            if (DotChars.isDigit(c)) {
                seen = (seen + 1)
            } {
                if (c != 46) {
                    if (c != 32) {
                        if (c != 44) {
                            if (c != 9) {
                                return false
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return (seen > 0)
    }

    sfn fromHsv:string (t:string) {
        def cleaned:string ""
        def i:int 0
        while (i < (strlen t)) {
            def c:int (charAt t i)
            i = (i + 1)
            if (c == 44) {
                cleaned = (cleaned + " ")
                continue
            }
            if (c == 9) {
                cleaned = (cleaned + " ")
                continue
            }
            cleaned = (cleaned + (strfromcode c))
        }
        def parts:[string] (strsplit cleaned " ")
        def nums:[double]
        def k:int 0
        while (k < (array_length parts)) {
            def piece:string (trim (itemAt parts k))
            k = (k + 1)
            if ((strlen piece) == 0) {
                continue
            }
            push nums (?? (str2double piece) 0.0)
        }
        if ((array_length nums) < 3) {
            return ""
        }
        def h:double (itemAt nums 0)
        def sat:double (itemAt nums 1)
        def val:double (itemAt nums 2)
        def sector:double (h * 6.0)
        def region:int (to_int sector)
        def f:double (sector - (to_double region))
        def p:double (val * (1.0 - sat))
        def q:double (val * (1.0 - (sat * f)))
        def tt:double (val * (1.0 - (sat * (1.0 - f))))
        def r:double val
        def g2:double tt
        def b:double p
        if (region == 1) {
            r = q
            g2 = val
            b = p
        }
        if (region == 2) {
            r = p
            g2 = val
            b = tt
        }
        if (region == 3) {
            r = p
            g2 = q
            b = val
        }
        if (region == 4) {
            r = tt
            g2 = p
            b = val
        }
        if (region >= 5) {
            r = val
            g2 = p
            b = q
        }
        def out:string "#"
        out = (out + (DotPalette.byte(r)))
        out = (out + (DotPalette.byte(g2)))
        out = (out + (DotPalette.byte(b)))
        return out
    }

    sfn byte:string (v:double) {
        def scaled:double (v * 255.0)
        if (scaled < 0.0) {
            scaled = 0.0
        }
        if (scaled > 255.0) {
            scaled = 255.0
        }
        def n:int (to_int (scaled + 0.5))
        def hi:int (idiv n 16)
        def lo:int (n % 16)
        return ((DotPalette.nibble(hi)) + (DotPalette.nibble(lo)))
    }

    sfn nibble:string (n:int) {
        if (n < 10) {
            return (to_string n)
        }
        return (strfromcode (87 + n))
    }
}

; ---------------------------------------------------------------------------
; The attributes that draw
; ---------------------------------------------------------------------------
class DotStyle {
    ; Graphviz has sixty-one shapes and RangerFlow draws forty-one; most of the
    ; rest are one polygon with a different number of sides, and the ones that
    ; have no counterpart land on the nearest outline rather than on a
    ; rectangle that says nothing. `shape=record` is a language of its own and
    ; is listed in the header above as not yet drawn.
    sfn shapeFor:string (name:string) {
        def w:string (DotChars.lower(name))
        if (w == "")             { return "ellipse" }
        if (w == "ellipse")      { return "ellipse" }
        if (w == "oval")         { return "ellipse" }
        if (w == "box")          { return "rect" }
        if (w == "rect")         { return "rect" }
        if (w == "rectangle")    { return "rect" }
        if (w == "square")       { return "rect" }
        if (w == "box3d")        { return "rect" }
        if (w == "plaintext")    { return "rect" }
        if (w == "plain")        { return "rect" }
        if (w == "none")         { return "rect" }
        if (w == "record")       { return "rect" }
        if (w == "mrecord")      { return "rect" }
        if (w == "underline")    { return "rect" }
        if (w == "circle")       { return "circle" }
        if (w == "doublecircle") { return "circle" }
        if (w == "point")        { return "circle" }
        if (w == "egg")          { return "ellipse" }
        if (w == "diamond")      { return "diamond" }
        if (w == "mdiamond")     { return "diamond" }
        if (w == "msquare")      { return "rect" }
        if (w == "mcircle")      { return "circle" }
        if (w == "triangle")     { return "triangle" }
        if (w == "invtriangle")  { return "triangledown" }
        if (w == "trapezium")    { return "trapezoid" }
        if (w == "invtrapezium") { return "trapezoid" }
        if (w == "parallelogram") { return "parallelogram" }
        if (w == "house")        { return "pentagon" }
        if (w == "invhouse")     { return "pentagondown" }
        if (w == "pentagon")     { return "pentagon" }
        if (w == "hexagon")      { return "hexagon" }
        if (w == "septagon")     { return "heptagon" }
        if (w == "octagon")      { return "octagon" }
        if (w == "doubleoctagon") { return "octagon" }
        if (w == "tripleoctagon") { return "octagon" }
        if (w == "decagon")      { return "decagon" }
        if (w == "cylinder")     { return "cylinder" }
        if (w == "note")         { return "note" }
        if (w == "tab")          { return "note" }
        if (w == "folder")       { return "note" }
        if (w == "component")    { return "rect" }
        if (w == "star")         { return "star" }
        if (w == "star6")        { return "star" }
        if (w == "stadium")      { return "stadium" }
        if (w == "rarrow")       { return "parallelogram" }
        if (w == "larrow")       { return "parallelogram" }
        return "rect"
    }

    ; `style` is a list: `filled,rounded,dashed`. One word at a time, because a
    ; reader that tests the whole string against "dashed" misses every diagram
    ; that also asked for something else.
    sfn styleHas:boolean (style:string word:string) {
        def w:string (DotChars.lower(style))
        def parts:[string] (strsplit w ",")
        def i:int 0
        while (i < (array_length parts)) {
            def p:string (trim (itemAt parts i))
            if (p == word) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; `\N` is the node's own name, `\n` `\l` `\r` are line breaks with an
    ; alignment this renderer does not have, and `\G` is the graph's name.
    ; Everything else a backslash introduces is left alone.
    sfn label:string (raw:string nodeName:string graphName:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen raw)) {
            def c:int (charAt raw i)
            if (c == 92) {
                if ((i + 1) < (strlen raw)) {
                    def n:int (charAt raw (i + 1))
                    if (n == 78) {
                        out = (out + nodeName)
                        i = (i + 2)
                        continue
                    }
                    if (n == 71) {
                        out = (out + graphName)
                        i = (i + 2)
                        continue
                    }
                    if (n == 110) {
                        out = (out + "\n")
                        i = (i + 2)
                        continue
                    }
                    if (n == 108) {
                        out = (out + "\n")
                        i = (i + 2)
                        continue
                    }
                    if (n == 114) {
                        out = (out + "\n")
                        i = (i + 2)
                        continue
                    }
                }
            }
            out = (out + (strfromcode c))
            i = (i + 1)
        }
        return out
    }

    ; An HTML-like label, until the phase that reads it properly: the text
    ; between the tags, so a table label reads as its words rather than as its
    ; markup. Cells are separated the way the rows read.
    sfn stripTags:string (raw:string) {
        def out:string ""
        def depth:int 0
        def i:int 0
        while (i < (strlen raw)) {
            def c:int (charAt raw i)
            i = (i + 1)
            if (c == 60) {
                depth = (depth + 1)
                continue
            }
            if (c == 62) {
                if (depth > 0) {
                    depth = (depth - 1)
                    out = (out + " ")
                }
                continue
            }
            if (depth == 0) {
                out = (out + (strfromcode c))
            }
        }
        return (DotStyle.squeeze(out))
    }

    sfn squeeze:string (raw:string) {
        def out:string ""
        def space:boolean true
        def i:int 0
        while (i < (strlen raw)) {
            def c:int (charAt raw i)
            i = (i + 1)
            if (DotChars.isSpace(c)) {
                if (space == false) {
                    out = (out + " ")
                }
                space = true
                continue
            }
            space = false
            out = (out + (strfromcode c))
        }
        return (trim out)
    }
}

; ---------------------------------------------------------------------------
; The drawing
; ---------------------------------------------------------------------------
class DotFlow {
    def g:FlowGraph (new FlowGraph)
    def doc:DotGraph (new DotGraph)
    def style:FlowStyle (new FlowStyle)
    def chart:Flowchart (new Flowchart)
    def palette:DotPalette (new DotPalette)
    ; The records, kept beside the node ids they belong to: a `shape=record`
    ; label and an HTML table are both a tree of cells with ports in it, and
    ; both are laid out once the layout has said how big the node really is.
    def records:[DotRecordLabel]
    def recordOf:[string]

    Constructor () {
    }

    sfn build:FlowGraph (d:DotGraph style:FlowStyle) {
        def f (new DotFlow)
        f.doc = d
        f.style = style
        return (f.run())
    }

    sfn render:FlowGraph (src:string) {
        def d:DotGraph (DotReader.parse(src))
        def s (new FlowStyle)
        return (DotFlow.build(d s))
    }

    fn run:FlowGraph () {
        this.nodes()
        g.reindex()
        this.edges()
        g.reindex()
        ; The sheet says what a node looks like; the file still says what THIS
        ; node looks like. `--restyle` turns that round, which is the order the
        ; Mermaid reader uses for a `classDef` and the same promise: somebody
        ; who wrote `fillcolor=salmon` expects to see it.
        if (style.strong) {
            this.paint()
            def last:int (style.applyTo(g))
        } {
            def first:int (style.applyTo(g))
            this.paint()
        }
        def lay:LayeredLayout (LayeredLayout.of(g))
        lay.direction = (doc.direction())
        lay.layerGap = 110.0
        lay.nodeGap = 40.0
        if ((doc.direction()) == "LR") {
            lay.layerGap = 150.0
        }
        lay.run()
        def banded:int (this.bandLayout(lay))
        ; A record's cells are placed into the box the layout gave the node,
        ; and the ports go on before anything is routed — a router that cannot
        ; see a port cannot aim at it.
        this.recordCells()
        this.aimEdges()
        g.reindex()
        ; The routing, and which router gets to do it is decided by whether it
        ; worked rather than by a guess about the graph.
        ;
        ; `ReadableRouter` is the one that can see every other edge: it charges
        ; a route for crossings, for sharing a corridor and for turning inside
        ; somebody else's clearance, and on a diagram of this size it is
        ; visibly better — the same drawing came out with its parallel lines 65
        ; px apart instead of 16, and without the detours that make a reader
        ; follow a line with a finger. But it can FAIL: on a dense graph its
        ; grid has no corridor left and an edge it gives up on is drawn
        ; straight through whatever is in the way, which is worse than any
        ; detour. Measured on `fixtures/graphviz/14_big_flat.gv`, 200 nodes and
        ; 199 edges: 80 of them abandoned.
        ;
        ; So it is asked first and checked afterwards, and the pass stack —
        ; lanes, long-edge chains, orthogonal repair — takes over whole when it
        ; left anything unrouted. Half a diagram from each would be worse than
        ; either.
        def rr (new ReadableRouter)
        def drawn:int (rr.route(g))
        rr.placeLabels(g)
        rr.finish(g)
        if (rr.unrouted > 0) {
            EdgeLanes.reset(g)
            def moved:int (EdgeLanes.assign(g))
            def routed:int (lay.routeLongEdges())
            EdgeLanes.resetLanes(g)
            def refanned:int (EdgeLanes.assign(g))
            def repaired:int (OrthoRouter.repairAll(g))
        }
        this.frames()
        g.reindex()
        return g
    }

    ; ------------------------------------------------------------- nodes ----
    fn nodes:void () {
        def i:int 0
        while (i < (array_length doc.nodes)) {
            def dn:DotNode (itemAt doc.nodes i)
            i = (i + 1)
            def n:FlowNode (this.nodeFor(dn))
            g.addNode(n)
        }
    }

    fn nodeFor:FlowNode (dn:DotNode) {
        def raw:string (dn.attr("label"))
        def rec:DotRecordLabel (this.recordFor(dn raw))
        if ((array_length rec.root.kids) >= 0) {
            if (this.isRecord(dn raw)) {
                return (this.recordNode(dn rec))
            }
        }
        def text:string dn.id
        if ((strlen raw) > 0) {
            text = (DotStyle.label(raw dn.id doc.name))
            if (DotFlow.looksLikeMarkup(raw)) {
                text = (DotStyle.stripTags(raw))
            }
        }
        def shape:string (DotStyle.shapeFor((dn.attr("shape"))))
        def s:FlowStep (chart.step(dn.id text "process"))
        def n:FlowNode (chart.stepNode(s))
        n.shape = shape
        n.nodeType = "step"
        ; An ellipse loses the corners a rectangle uses for its text, and a
        ; circle has to be square before it is round.
        if (shape == "ellipse") {
            n.width = (n.width + 26.0)
            n.height = (n.height + 8.0)
        }
        if (shape == "circle") {
            DotFlow.squareOff(n)
        }
        if (shape == "diamond") {
            n.width = (n.width + 30.0)
            n.height = (n.height + 16.0)
        }
        n.tooltip = (dn.attr("tooltip"))
        n.cssClass = ("graphviz node shape-" + shape)
        n.syncFromModel()
        return n
    }

    ; ------------------------------------------------------------ colour ----
    ; What the file itself asked for. Kept apart from `nodeFor` so it can run
    ; before or after the stylesheet — see `run`.
    fn paint:void () {
        def i:int 0
        while (i < (array_length doc.nodes)) {
            def dn:DotNode (itemAt doc.nodes i)
            i = (i + 1)
            if ((g.hasNode(dn.id)) == false) {
                continue
            }
            def n:FlowNode (g.nodeById(dn.id))
            def fill:string (palette.resolve((dn.attr("fillcolor"))))
            def line:string (palette.resolve((dn.attr("color"))))
            ; `style=filled` with no `fillcolor` fills with `color`, which is
            ; the one place in DOT where the outline colour paints the inside.
            if (DotStyle.styleHas((dn.attr("style")) "filled")) {
                if ((strlen fill) == 0) {
                    fill = line
                }
            }
            if ((strlen fill) > 0) {
                n.bgColor = fill
            }
            if ((strlen line) > 0) {
                n.borderColor = line
            }
            def fontColor:string (palette.resolve((dn.attr("fontcolor"))))
            if ((strlen fontColor) > 0) {
                n.textColor = fontColor
            }
            n.syncFromModel()
        }
        ; The graph's edges carry the model's index in their id — `dot7` is
        ; `doc.edges[7]` — because an edge cannot be found by its ends when a
        ; DOT file is free to draw the same pair twice.
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            k = (k + 1)
            def at:int (DotFlow.indexOfEdgeId(e.id))
            if (at < 0) {
                continue
            }
            if (at >= (array_length doc.edges)) {
                continue
            }
            def de:DotEdge (itemAt doc.edges at)
            def stroke:string (palette.resolve((de.attr("color"))))
            if ((strlen stroke) > 0) {
                e.strokeColor = stroke
            }
        }
    }

    sfn indexOfEdgeId:int (id:string) {
        if ((strlen id) < 4) {
            return -1
        }
        if ((substring id 0 3) != "dot") {
            return -1
        }
        def digits:string (substring id 3 (strlen id))
        return (?? (str2int digits) -1)
    }

    ; ----------------------------------------------------------- records ----
    ; A node whose label is a box language rather than a string: `shape=record`
    ; and `shape=Mrecord`, and an HTML label that turns out to be a table. An
    ; HTML label that is only markup — `<B>bold</B>` — is a label, not a table,
    ; and goes the ordinary way with its tags taken out.
    fn isRecord:boolean (dn:DotNode raw:string) {
        if ((strlen raw) == 0) {
            return false
        }
        if (DotHtmlLabel.isTable(raw)) {
            return true
        }
        def shape:string (DotChars.lower((dn.attr("shape"))))
        if (shape == "record") {
            return true
        }
        if (shape == "mrecord") {
            return true
        }
        return false
    }

    fn recordFor:DotRecordLabel (dn:DotNode raw:string) {
        if (DotHtmlLabel.isTable(raw)) {
            return (DotHtmlLabel.parse(raw))
        }
        ; The top level runs across the page under `rankdir=TB` and down it
        ; under `LR`, and every `{ }` inside flips it again.
        def across:boolean ((doc.direction()) == "TB")
        return (DotRecordLabel.parse(raw across))
    }

    fn recordNode:FlowNode (dn:DotNode rec:DotRecordLabel) {
        rec.measure()
        def n:FlowNode (FlowNode.create(dn.id "" 0.0 0.0))
        n.nodeType = "step"
        n.shape = "rect"
        n.width = rec.root.w
        n.height = rec.root.h
        n.cssClass = "graphviz node record"
        n.tooltip = (dn.attr("tooltip"))
        n.syncFromModel()
        push records rec
        push recordOf dn.id
        return n
    }

    fn recordAt:int (id:string) {
        def i:int 0
        while (i < (array_length recordOf)) {
            if ((itemAt recordOf i) == id) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    ; Once the layout has said where the record is and how big, the cells are
    ; placed inside it and drawn as children of it. Children rather than paint:
    ; `FlowEditor` moves everything whose ancestor is selected, so a record
    ; dragged across the page takes its own cells with it.
    fn recordCells:void () {
        def i:int 0
        while (i < (array_length records)) {
            def rec:DotRecordLabel (itemAt records i)
            def id:string (itemAt recordOf i)
            i = (i + 1)
            if ((g.hasNode(id)) == false) {
                continue
            }
            def n:FlowNode (g.nodeById(id))
            rec.place(n.x n.y n.width n.height)
            def cells:[DotCell] (rec.leaves())
            def k:int 0
            while (k < (array_length cells)) {
                def c:DotCell (itemAt cells k)
                def at:int k
                k = (k + 1)
                def cell:FlowNode (FlowNode.create(((id + "::") + (to_string at)) c.text c.x c.y))
                cell.width = c.w
                cell.height = c.h
                cell.nodeType = "step"
                cell.shape = "rect"
                cell.parentId = id
                cell.connectable = false
                cell.draggable = false
                cell.selectable = false
                cell.borderRadius = 0.0
                cell.cssClass = "graphviz record cell"
                cell.bgColor = n.bgColor
                cell.textColor = n.textColor
                cell.borderColor = n.borderColor
                cell.syncFromModel()
                g.addNode(cell)
            }
        }
        g.reindex()
    }

    ; ------------------------------------------------------------- aiming ----
    ; `order:cust:e -> customer:id:w` says which cell an edge leaves and which
    ; it arrives at, and which side of it. Graphviz decides the side from where
    ; the other end is when the file does not say, and so does this — which is
    ; why it runs after the layout rather than with the reader.
    fn aimEdges:void () {
        def k:int 0
        while (k < (g.edgeCount())) {
            def e:FlowEdge (g.edgeAt(k))
            def at:int (DotFlow.indexOfEdgeId(e.id))
            k = (k + 1)
            if (at < 0) {
                continue
            }
            if (at >= (array_length doc.edges)) {
                continue
            }
            def de:DotEdge (itemAt doc.edges at)
            e.sourcePort = (this.aim(e de true))
            e.targetPort = (this.aim(e de false))
        }
    }

    ; One end of one edge. Returns the port id to attach to, or "" when there
    ; is no cell of that name — an unknown port is the node itself, which is
    ; what Graphviz does with one too.
    fn aim:string (e:FlowEdge de:DotEdge atSource:boolean) {
        def nodeId:string e.target
        def portName:string de.headPort
        def compass:string de.headCompass
        def otherId:string e.source
        if atSource {
            nodeId = e.source
            portName = de.tailPort
            compass = de.tailCompass
            otherId = e.target
        }
        if ((g.hasNode(nodeId)) == false) {
            return ""
        }
        def side:int (DotFlow.sideOfCompass(compass))
        def ri:int (this.recordAt(nodeId))
        if (ri < 0) {
            ; No record: a compass point is still a side to arrive by, which is
            ; the whole of what it means on a plain node.
            if (side >= 0) {
                if atSource {
                    e.sourceHandle = side
                } {
                    e.targetHandle = side
                }
            }
            return ""
        }
        def rec:DotRecordLabel (itemAt records ri)
        def cell:DotCell (DotFlow.cellNamed(rec portName))
        if ((strlen cell.port) == 0) {
            if (side >= 0) {
                if atSource {
                    e.sourceHandle = side
                } {
                    e.targetHandle = side
                }
            }
            return ""
        }
        if (side < 0) {
            side = (this.sideTowards(cell otherId))
        }
        return (this.ensurePort(nodeId cell side))
    }

    ; Which side of the cell faces the other end of the edge. The dominant axis
    ; wins: a cell two hundred pixels below and ten to the left is reached from
    ; underneath, not from the side.
    fn sideTowards:int (c:DotCell otherId:string) {
        if ((g.hasNode(otherId)) == false) {
            return 2
        }
        def o:FlowNode (g.nodeById(otherId))
        def ox:double (o.x + (o.width * 0.5))
        def oy:double (o.y + (o.height * 0.5))
        def cx:double (c.x + (c.w * 0.5))
        def cy:double (c.y + (c.h * 0.5))
        def dx:double (ox - cx)
        def dy:double (oy - cy)
        if ((fabs dx) > (fabs dy)) {
            if (dx > 0.0) {
                return 1
            }
            return 3
        }
        if (dy > 0.0) {
            return 2
        }
        return 0
    }

    ; One port per cell per side, made when an edge first asks for it. A field
    ; reached from the left and from below is two attachment points, and a
    ; `FlowPort` is one side.
    fn ensurePort:string (nodeId:string c:DotCell side:int) {
        def id:string ((((nodeId + ":") + c.port) + "@") + (to_string side))
        if (g.hasPort(id)) {
            return id
        }
        def n:FlowNode (g.nodeById(nodeId))
        def offset:double ((c.x + (c.w * 0.5)) - n.x)
        if (side == 1) {
            offset = ((c.y + (c.h * 0.5)) - n.y)
        }
        if (side == 3) {
            offset = ((c.y + (c.h * 0.5)) - n.y)
        }
        def p:FlowPort (FlowPort.create(id nodeId side offset))
        p.label = c.port
        push n.ports p
        g.reindex()
        return id
    }

    sfn cellNamed:DotCell (rec:DotRecordLabel name:string) {
        def empty (new DotCell)
        if ((strlen name) == 0) {
            return empty
        }
        def all:[DotCell] (rec.ported())
        def i:int 0
        while (i < (array_length all)) {
            def c:DotCell (itemAt all i)
            i = (i + 1)
            if (c.port == name) {
                return c
            }
        }
        return empty
    }

    ; A compass point is a side of the box: `n` the top, `e` the right. The
    ; corners and `c` and `_` have no side of their own, and are left to the
    ; router to decide, which is what Graphviz's `_` means anyway.
    sfn sideOfCompass:int (compass:string) {
        def w:string (DotChars.lower(compass))
        if (w == "n") { return 0 }
        if (w == "e") { return 1 }
        if (w == "s") { return 2 }
        if (w == "w") { return 3 }
        if (w == "ne") { return 1 }
        if (w == "se") { return 1 }
        if (w == "nw") { return 3 }
        if (w == "sw") { return 3 }
        return -1
    }

    sfn looksLikeMarkup:boolean (raw:string) {
        def i:int 0
        while (i < (strlen raw)) {
            if ((charAt raw i) == 60) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn squareOff:void (n:FlowNode) {
        def side:double n.width
        if (side < n.height) {
            side = n.height
        }
        if (side < 64.0) {
            side = 64.0
        }
        n.width = side
        n.height = side
    }

    ; ------------------------------------------------------------- edges ----
    fn edges:void () {
        def i:int 0
        while (i < (array_length doc.edges)) {
            def de:DotEdge (itemAt doc.edges i)
            def idx:int i
            i = (i + 1)
            if ((g.hasNode(de.tail)) == false) {
                continue
            }
            if ((g.hasNode(de.head)) == false) {
                continue
            }
            ; `dot7`, not `e7`: `FlowGraph` names an edge nobody named `e<n>`,
            ; so an edge the editor adds later would collide with one of ours
            ; and the undo would take back the wrong one. The web page's self
            ; test is what found that.
            def e:FlowEdge (FlowEdge.create(("dot" + (to_string idx)) de.tail de.head))
            e.edgeType = "smoothstep"
            def raw:string (de.attr("label"))
            if ((strlen raw) > 0) {
                e.label = (DotStyle.label(raw "" doc.name))
            }
            def st:string (de.attr("style"))
            if (DotStyle.styleHas(st "dashed")) {
                e.dash = 6.0
            }
            if (DotStyle.styleHas(st "dotted")) {
                e.dash = 2.0
            }
            if (DotStyle.styleHas(st "invis")) {
                e.hidden = true
            }
            ; An undirected graph has no arrowheads, and `dir` or
            ; `arrowhead=none` takes them off a directed one.
            e.markerEnd = "arrowclosed"
            if (doc.directed == false) {
                e.markerEnd = ""
            }
            def dir:string (DotChars.lower((de.attr("dir"))))
            if (dir == "none") {
                e.markerEnd = ""
            }
            if (dir == "back") {
                e.markerEnd = ""
                e.markerStart = "arrowclosed"
            }
            if (dir == "both") {
                e.markerStart = "arrowclosed"
            }
            if ((DotChars.lower((de.attr("arrowhead")))) == "none") {
                e.markerEnd = ""
            }
            e.cssClass = "graphviz edge"
            ; Where an edge lands is decided in `aimEdges`, once the layout has
            ; said where everything is: a port name is a cell of a record, and
            ; a record has no cells until its node has a size.
            g.addEdge(e)
        }
    }

    ; ----------------------------------------------------------- packing ----
    ; Each root cluster gets a column of its own and keeps it in every layer,
    ; so a frame cannot reach outside it and cannot swallow a node that belongs
    ; to nobody. The mechanism is the one the PlantUML packages needed, for the
    ; same reason: the layered layout does not know that six of its nodes
    ; belong together.
    fn bandLayout:int (lay:LayeredLayout) {
        if ((doc.clusterCount()) == 0) {
            return 0
        }
        def bands:[string] (this.bandOrder())
        if ((array_length bands) < 2) {
            return 0
        }
        def horiz:boolean ((doc.direction()) == "LR")
        def maxLayer:int -1
        def i:int 0
        while (i < (array_length lay.layerOf)) {
            def lv:int (itemAt lay.layerOf i)
            if (lv > maxLayer) {
                maxLayer = lv
            }
            i = (i + 1)
        }
        def gap:double 26.0
        def bandGap:double 64.0
        def widths:[double]
        def b:int 0
        while (b < (array_length bands)) {
            def key:string (itemAt bands b)
            b = (b + 1)
            def widest:double 0.0
            def layer:int 0
            while (layer <= maxLayer) {
                def run:double 0.0
                def count:int 0
                def k:int 0
                while (k < (g.nodeCount())) {
                    def n:FlowNode (g.nodeAt(k))
                    def idx:int k
                    k = (k + 1)
                    if (idx >= (array_length lay.layerOf)) {
                        continue
                    }
                    if ((itemAt lay.layerOf idx) != layer) {
                        continue
                    }
                    def mine:string (this.rootClusterOf(n.id))
                    if (mine != key) {
                        continue
                    }
                    def size:double n.width
                    if horiz {
                        size = n.height
                    }
                    run = (run + size)
                    count = (count + 1)
                }
                if (count > 1) {
                    def extra:double (to_double (count - 1))
                    run = (run + (extra * gap))
                }
                if (run > widest) {
                    widest = run
                }
                layer = (layer + 1)
            }
            push widths widest
        }
        ; Where each band starts, in the across-the-layers direction.
        def starts:[double]
        def cursor:double 0.0
        def w:int 0
        while (w < (array_length widths)) {
            push starts cursor
            cursor = ((cursor + (itemAt widths w)) + bandGap)
            w = (w + 1)
        }
        ; And now place every layer's nodes inside their own band.
        def placed:int 0
        def layer2:int 0
        while (layer2 <= maxLayer) {
            def bi:int 0
            while (bi < (array_length bands)) {
                def key2:string (itemAt bands bi)
                def at:double (itemAt starts bi)
                bi = (bi + 1)
                def k2:int 0
                while (k2 < (g.nodeCount())) {
                    def n2:FlowNode (g.nodeAt(k2))
                    def idx2:int k2
                    k2 = (k2 + 1)
                    if (idx2 >= (array_length lay.layerOf)) {
                        continue
                    }
                    if ((itemAt lay.layerOf idx2) != layer2) {
                        continue
                    }
                    def mine2:string (this.rootClusterOf(n2.id))
                    if (mine2 != key2) {
                        continue
                    }
                    if horiz {
                        n2.y = at
                        at = ((at + n2.height) + gap)
                    } {
                        n2.x = at
                        at = ((at + n2.width) + gap)
                    }
                    n2.syncFromModel()
                    placed = (placed + 1)
                }
            }
            layer2 = (layer2 + 1)
        }
        return placed
    }

    ; The bands, in the order the file declared them, with the nodes that
    ; belong to no cluster as a band of their own.
    fn bandOrder:[string] () {
        def out:[string]
        def seenLoose:boolean false
        def i:int 0
        while (i < (g.nodeCount())) {
            def n:FlowNode (g.nodeAt(i))
            i = (i + 1)
            def key:string (this.rootClusterOf(n.id))
            if ((strlen key) == 0) {
                if (seenLoose == false) {
                    push out ""
                    seenLoose = true
                }
                continue
            }
            if ((DotReader.listHas(out key)) == false) {
                push out key
            }
        }
        return out
    }

    ; The outermost cluster a node belongs to, or "" for a node that belongs to
    ; none. A subgraph that is not a cluster is not a band: `{ rank=same; a; b }`
    ; groups the ranking, not the page.
    fn rootClusterOf:string (id:string) {
        def best:string ""
        def bestDepth:int 999
        def i:int 0
        while (i < (array_length doc.subgraphs)) {
            def s:DotSubgraph (itemAt doc.subgraphs i)
            i = (i + 1)
            if (s.isCluster == false) {
                continue
            }
            if ((DotReader.listHas(s.members id)) == false) {
                continue
            }
            if (s.depth < bestDepth) {
                bestDepth = s.depth
                best = s.id
            }
        }
        return best
    }

    ; ------------------------------------------------------------ frames ----
    fn frames:void () {
        def deepest:int 0
        def i:int 0
        while (i < (array_length doc.subgraphs)) {
            def s:DotSubgraph (itemAt doc.subgraphs i)
            if s.isCluster {
                if (s.depth > deepest) {
                    deepest = s.depth
                }
            }
            i = (i + 1)
        }
        def level:int deepest
        while (level >= 0) {
            def k:int 0
            while (k < (array_length doc.subgraphs)) {
                def s2:DotSubgraph (itemAt doc.subgraphs k)
                k = (k + 1)
                if (s2.isCluster == false) {
                    continue
                }
                if (s2.depth != level) {
                    continue
                }
                def made:boolean (this.frameOne(s2))
            }
            level = (level - 1)
        }
    }

    fn frameOne:boolean (s:DotSubgraph) {
        def pad:double 20.0
        def head:double 24.0
        def r (new FlowRect)
        def i:int 0
        while (i < (array_length s.members)) {
            def mid:string (itemAt s.members i)
            i = (i + 1)
            if ((g.hasNode(mid)) == false) {
                continue
            }
            def n:FlowNode (g.nodeById(mid))
            def right:double (n.x + n.width)
            def bottom:double (n.y + n.height)
            if (r.valid == false) {
                r.x = n.x
                r.y = n.y
                r.w = n.width
                r.h = n.height
                r.valid = true
                continue
            }
            if (n.x < r.x) {
                def dw:double (r.x - n.x)
                r.x = n.x
                r.w = (r.w + dw)
            }
            if (n.y < r.y) {
                def dh:double (r.y - n.y)
                r.y = n.y
                r.h = (r.h + dh)
            }
            def rr:double (r.x + r.w)
            if (right > rr) {
                r.w = (right - r.x)
            }
            def rb:double (r.y + r.h)
            if (bottom > rb) {
                r.h = (bottom - r.y)
            }
        }
        if (r.valid == false) {
            return false
        }
        def title:string (?? (get s.attrs "label") "")
        def frame:FlowNode (FlowNode.create(("__cluster_" + s.id) title (r.x - pad) ((r.y - pad) - head)))
        frame.nodeType = "group"
        frame.width = (r.w + (pad * 2.0))
        frame.height = ((r.h + (pad * 2.0)) + head)
        frame.connectable = false
        frame.cssClass = "graphviz cluster"
        def line:string (palette.resolve((?? (get s.attrs "color") "")))
        if ((strlen line) > 0) {
            frame.borderColor = line
        }
        def fill:string (palette.resolve((?? (get s.attrs "bgcolor") "")))
        if ((strlen fill) > 0) {
            frame.bgColor = fill
        }
        frame.syncFromModel()
        g.addNode(frame)
        def sent:boolean (g.sendToBack(("__cluster_" + s.id)))
        return true
    }
}

# Compiled output of the Ranger sources here. Regenerate with:
#   npm run rangerflow:test / rangerflow:demo / rangerflow:web
bin/
# Exported diagrams from `npm run rangerflow:demo` — several megabytes of PDF
# that say nothing a re-run would not.
out/

# The README shows this one; it is regenerated by `npm run rangerflow:artifacts`.
!artifacts/
!artifacts/**

# The parity harness installs React Flow and d3-force to ask them questions,
# and writes their answers here. An oracle you cannot regenerate is a number
# you have to trust, so neither is committed.
harness/node_modules/
harness/out/

# PlantUML, fetched on demand so the oracle can be asked what its own examples
# mean. It is GPL, it is run as a subprocess and never linked, and 22 MB of jar
# is not this repository's to carry.
harness/vendor/

; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; EVGFocus — the keyboard, for a renderer that has none
; =============================================================================
; A drawn UI has no tab stops. The browser gives them to a page of elements for
; free; a canvas is one element, and everything inside it is a rectangle the
; GPU painted. So every EVG app so far has either had no keyboard at all or
; hand-written one for the single widget that needed it — which is why the
; arrows do nothing on a screen full of buttons.
;
; This is that, once, for every renderer: the elements that say they are
; focusable, in an order, with a rule for what an arrow key means.
;
;   Tab / Shift+Tab     the next and previous in TREE ORDER, wrapping. That is
;                       the order the page was written in, which is the order
;                       the a11y mirror publishes and the order a browser
;                       would use.
;
;   the four arrows     SPATIAL. Tree order is wrong for a grid: the thing
;                       under a button is not the thing after it. So an arrow
;                       looks at the boxes — where the focus is now, and which
;                       focusable box lies in that direction — and takes the
;                       nearest one, measured along the direction moved and
;                       penalised for drifting sideways.
;
;   Home / End          the first and the last.
;
; AND A MODAL TRAPS IT. A dialog that has to be closed must not be a dialog
; the keyboard can walk out of — Tab past its last button and the ring is on
; the page behind it, over controls the person cannot see the point of and
; cannot get back from except by walking all the way round.
;
; The trap is not something a host remembers to switch on. It is already in
; the tree: a dialog says `a11yModal`, which is `aria-modal` and what the
; accessibility mirror reads to hide the page behind it, so the keyboard reads
; the same declaration. While one is up, the walk starts at that dialog and
; the page under it does not exist as far as the keys are concerned — and when
; it closes, the tree stops saying so and the whole page comes back.
;
; The INNERMOST one, which here means the last in tree order: overlays are
; appended, so a review sheet opened over an add sheet is the one after it,
; and it is the one that traps.
;
; A focusable element is one that says `a11yFocusable` and is not
; `a11yDisabled` or `a11yHidden`, and has a box with area. A control with no
; id cannot be focused, because an id is what the host presses.
;
; NOTHING HERE DRAWS. `EVGDisplayList.setFocus` puts a ring around whatever id
; this settles on, so a renderer gets the ring for the same reason it gets a
; border: it is in the list.
;
; The spatial rule, stated once because it is the whole design:
;
;     A candidate counts only if its CENTRE is past the current box's edge in
;     the direction moved. Its cost is the distance along that direction plus
;     twice the overlap-free gap across it. So a button directly below wins
;     over one further down, and one directly below wins over one beside it —
;     which is what "down" means to a person looking at the screen.
; =============================================================================

Import "EVGElement.rgr"

class EVGFocus {
    ; The focusable ids, in tree order, and their boxes.
    def ids:[string]
    def xs:[double]
    def ys:[double]
    def ws:[double]
    def hs:[double]
    ; WHICH SCROLL CONTAINER EACH ONE IS IN, as a number handed out by the
    ; walk, and -1 for the ones in none. A number rather than an id because a
    ; scroll container does not need an id — nothing presses it — and two
    ; focusables are in the same list when the walk gave them the same one.
    def owners:[int]
    def scrollerSeq@(mutable):int 0
    ; What has the focus, or "" for nothing.
    def focusId@(mutable):string ""
    ; WHETHER TO DRAW IT. The focus moves on a click as well as on a key —
    ; otherwise Tab after a click carries on from somewhere else on the screen
    ; — but a ring round every button somebody points at is not what a focus
    ; ring is for. The rule is the browsers': shown when a key put it there,
    ; not when the pointer did. `ringId` is what a renderer asks.
    def ringVisible@(mutable):boolean false
    ; The dialog the walk is confined to, when the tree declares one.
    def trapEl@(mutable+optional):EVGElement
    def trapped@(mutable):boolean false

    ; --- bringing the focus into view ------------------------------------------
    ;
    ; The scroll containers `reveal` moved, for a caller that has to tell its
    ; own layout about it. `EVGElement.scrollTop` is APPLICATION state — the
    ; comment on it says so — and an app that keeps a scrollbar, a fling or a
    ; retained layer has bookkeeping to do when it changes. This class does
    ; the geometry and hands back what it touched; it does not pretend to know
    ; what the app keeps.
    def moved:[EVGElement]
    ; How far `reveal` has already pushed the focused element up and left in
    ; this pass. The boxes hold where things are NOW — a layout applies a
    ; scroll to the subtree rather than leaving the display list to subtract
    ; it, which is what `appliedScrollTop` records — so a container scrolled
    ; on the way out has moved the element, and the container outside it must
    ; be told against the position the element WILL have and not the one it
    ; had. Without this a field two containers deep is brought into the inner
    ; one and left under the fold of the outer.
    def shiftX@(mutable):double 0.0
    def shiftY@(mutable):double 0.0

    Constructor () {
    }

    ; --- what can be focused ---------------------------------------------------

    fn scan:void (root:EVGElement) {
        clear ids
        clear xs
        clear ys
        clear ws
        clear hs
        clear owners
        scrollerSeq = 0
        trapped = false
        def none@(optional):EVGElement
        trapEl = none
        this.findModal(root)
        if trapped {
            this.walk((unwrap trapEl))
            return
        }
        this.walk(root)
    }

    ; The last modal in tree order that is on the screen — see the note at the
    ; top. Pre-order and overwriting, so a dialog nested inside another wins
    ; over the one holding it, and a later sibling wins over an earlier one.
    fn findModal:void (el:EVGElement) {
        if el.a11yHidden {
            return
        }
        if (el.display == "none") {
            return
        }
        if el.a11yModal {
            trapEl = el
            trapped = true
        }
        def i:int 0
        def n:int (el.getChildCount())
        while (i < n) {
            this.findModal((el.getChild(i)))
            i = (i + 1)
        }
    }

    ; The id of the dialog the keys are trapped in, or "" when they are not.
    ; A dialog with no id still traps — the walk is confined to the element,
    ; not to its name — so this answers "" for one, which is why a caller that
    ; wants to know IF there is a trap asks `isTrapped`.
    fn trapId:string () {
        if (trapped == false) {
            return ""
        }
        def el:EVGElement (unwrap trapEl)
        return el.id
    }

    fn isTrapped:boolean () {
        return trapped
    }

    fn walk:void (el:EVGElement) {
        this.walkIn(el (0 - 1))
    }

    ; `inside` is the scroll container this element hangs under, or -1. An
    ; element that is ITSELF a scroll container belongs to the one outside it
    ; — a list is not inside itself — so the number is handed to the children
    ; and not to the element that made it.
    fn walkIn:void (el:EVGElement inside:int) {
        if el.a11yHidden {
            return
        }
        if (el.display == "none") {
            return
        }
        ; PAY WHAT THE SUBTREE IS OWED FIRST. A scroll moves the rows near the
        ; viewport for real and leaves the far ones a debt — `EVGElement`'s
        ; note on `shiftDx` says why, and that every walk into a subtree has to
        ; settle a node before it reads its children. The display list, the hit
        ; test and the accessibility walk all do; this one, the fourth reader
        ; of the same tree, did not, so every focusable more than a few
        ; container-heights from the viewport was scanned at the coordinates it
        ; had BEFORE the page scrolled. An arrow then measured against a box
        ; nobody could see, and answered with a control somewhere else
        ; entirely.
        el.settleShift()
        def mine@(mutable):int inside
        if (el.clipsContent()) {
            scrollerSeq = (scrollerSeq + 1)
            mine = scrollerSeq
        }
        if (EVGFocus.takes(el)) {
            push ids el.id
            push xs el.calculatedX
            push ys el.calculatedY
            push ws el.calculatedWidth
            push hs el.calculatedHeight
            push owners inside
        }
        def i:int 0
        def n:int (el.getChildCount())
        while (i < n) {
            this.walkIn((el.getChild(i)) mine)
            i = (i + 1)
        }
    }

    ; An element with no id cannot be focused: the host acts on ids, and a
    ; focus nobody can press is a focus that goes nowhere.
    sfn takes:boolean (el:EVGElement) {
        if (el.a11yFocusable == false) {
            return false
        }
        if el.a11yDisabled {
            return false
        }
        if ((strlen el.id) == 0) {
            return false
        }
        if (el.calculatedWidth <= 0.0) {
            return false
        }
        return (el.calculatedHeight > 0.0)
    }

    fn count:int () {
        return (array_length ids)
    }

    fn idAt:string (i:int) {
        if (i < 0) {
            return ""
        }
        if (i >= (array_length ids)) {
            return ""
        }
        return (itemAt ids i)
    }

    fn indexOfId:int (id:string) {
        def i:int 0
        def n:int (array_length ids)
        while (i < n) {
            if ((itemAt ids i) == id) {
                return i
            }
            i = (i + 1)
        }
        return (0 - 1)
    }

    ; --- moving ----------------------------------------------------------------

    ; Tree order, wrapping. With nothing focused, Tab starts at the first and
    ; Shift+Tab at the last — the same as a browser entering a page from
    ; either end.
    fn step:string (back:boolean) {
        def n:int (array_length ids)
        if (n == 0) {
            return ""
        }
        def at:int (this.indexOfId(focusId))
        if (at < 0) {
            if back {
                return (this.idAt((n - 1)))
            }
            return (this.idAt(0))
        }
        def next@(mutable):int (at + 1)
        if back {
            next = (at - 1)
        }
        if (next >= n) {
            next = 0
        }
        if (next < 0) {
            next = (n - 1)
        }
        return (this.idAt(next))
    }

    ; The spatial rule stated at the top. `dx`/`dy` is the direction: one of
    ; (0,-1) (0,1) (-1,0) (1,0).
    fn towards:string (dx:double dy:double) {
        def n:int (array_length ids)
        if (n == 0) {
            return ""
        }
        def at:int (this.indexOfId(focusId))
        if (at < 0) {
            ; Nowhere yet: an arrow enters at the first, like Tab.
            return (this.idAt(0))
        }
        ; THE LIST YOU ARE IN COMES FIRST, and only then everything else.
        ;
        ; Distance is measured on the screen, and a scroll container puts the
        ; rest of its own list OFF the screen — so the next card in the stack
        ; is hundreds of pixels away while a fixed bottom bar is a few. Down
        ; from a card then lands on the bar, and down from the bar comes back
        ; to the stack: the ring ping-pongs instead of walking the list.
        ;
        ; Whatever parks a card against the bottom edge of its container makes
        ; that certain rather than likely — `reveal` does it every time — but
        ; the arrangement is what is wrong, and a finger that stops a list in
        ; the same place finds the same thing.
        ;
        ; So a candidate in the same container wins over one outside it, at any
        ; distance, and the wider search runs only when that container has
        ; nothing left in the direction asked for. Down from the LAST card
        ; still reaches the bar, which is what a person expects; down from the
        ; first card reaches the second, which is what they expect more.
        def mine@(mutable):int (0 - 1)
        if (at < (array_length owners)) {
            mine = (itemAt owners at)
        }
        if (mine >= 0) {
            def near:string (this.bestToward(dx dy at mine))
            if ((strlen near) > 0) {
                return near
            }
        }
        return (this.bestToward(dx dy at (0 - 2)))
    }

    ; The scoring itself. `only` is a container number to stay inside, or -2
    ; for "anywhere".
    fn bestToward:string (dx:double dy:double at:int only:int) {
        def n:int (array_length ids)
        def cx:double ((itemAt xs at) + ((itemAt ws at) / 2.0))
        def cy:double ((itemAt ys at) + ((itemAt hs at) / 2.0))
        def best@(mutable):string ""
        def bestCost@(mutable):double 0.0
        def i:int 0
        while (i < n) {
            def skip@(mutable):boolean (i == at)
            if (only != (0 - 2)) {
                if ((itemAt owners i) != only) {
                    skip = true
                }
            }
            if (skip == false) {
                def ox:double ((itemAt xs i) + ((itemAt ws i) / 2.0))
                def oy:double ((itemAt ys i) + ((itemAt hs i) / 2.0))
                def along:double (((ox - cx) * dx) + ((oy - cy) * dy))
                ; Strictly past the centre in the direction moved. Half a
                ; pixel, so a row of buttons whose centres are one rounding
                ; apart does not count as "below" itself.
                if (along > 0.5) {
                    ; Across is the other axis, which for (0,±1) is x and for
                    ; (±1,0) is y.
                    def across@(mutable):double ((ox - cx) * dy)
                    if (dy == 0.0) {
                        across = (oy - cy)
                    } {
                        across = (ox - cx)
                    }
                    if (across < 0.0) {
                        across = (0.0 - across)
                    }
                    def cost:double (along + (across * 2.0))
                    if ((strlen best) == 0) {
                        best = (itemAt ids i)
                        bestCost = cost
                    } {
                        if (cost < bestCost) {
                            best = (itemAt ids i)
                            bestCost = cost
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return best
    }

    ; --- the key ---------------------------------------------------------------

    ; One key against a tree. Answers the id the focus moved to, or "" when
    ; the key is not one of these or there is nowhere to go — a host that gets
    ; "" must let the key through, because refusing a key you did nothing with
    ; is how a page stops scrolling.
    ;
    ; `scan` runs here so a caller never has to remember to: the tree it is
    ; given is the tree as it is now, and a focus that survived a rebuild is
    ; found by id rather than by position.
    fn key:string (root:EVGElement k:string shift:boolean) {
        this.scan(root)
        def to@(mutable):string ""
        if (k == "Tab") {
            to = (this.step(shift))
        }
        if (k == "ArrowDown") {
            to = (this.towards(0.0 1.0))
        }
        if (k == "ArrowUp") {
            to = (this.towards(0.0 (0.0 - 1.0)))
        }
        if (k == "ArrowRight") {
            to = (this.towards(1.0 0.0))
        }
        if (k == "ArrowLeft") {
            to = (this.towards((0.0 - 1.0) 0.0))
        }
        if (k == "Home") {
            to = (this.idAt(0))
        }
        if (k == "End") {
            to = (this.idAt(((array_length ids) - 1)))
        }
        if ((strlen to) == 0) {
            return ""
        }
        focusId = to
        ringVisible = true
        return to
    }

    ; Put the focus somewhere by hand — a press, or a screen that opens with
    ; something already chosen. An id nothing focusable carries is refused
    ; rather than remembered, so the ring cannot point at nothing.
    fn place:boolean (root:EVGElement id:string) {
        if ((strlen id) == 0) {
            focusId = ""
            ringVisible = false
            return true
        }
        this.scan(root)
        if ((this.indexOfId(id)) < 0) {
            return false
        }
        focusId = id
        ringVisible = true
        return true
    }

    ; The same, from a POINTER: the focus moves so the keys carry on from what
    ; was just clicked, and nothing is drawn, because the person can see where
    ; they clicked.
    fn pointAt:boolean (root:EVGElement id:string) {
        if ((this.place(root id)) == false) {
            return false
        }
        ringVisible = false
        return true
    }

    ; SHOW IT AGAIN. A press is the pointer's by default — `pointAt` puts the
    ; ring away — and a press the KEYBOARD made is not: Enter on a focused
    ; button activates it and leaves the ring where it was, in every browser
    ; there is. The caller that knows a key did it says so with this.
    fn show:void () {
        if ((strlen focusId) > 0) {
            ringVisible = true
        }
    }

    ; Where to draw the ring, or "" for nowhere.
    fn ringId:string () {
        if (ringVisible == false) {
            return ""
        }
        return focusId
    }

    fn clear:void () {
        focusId = ""
        ringVisible = false
    }

    ; The focus after a rebuild: it is kept if the id is still focusable, and
    ; dropped if it is not — a ring around an element that has gone is worse
    ; than no ring.
    fn settle:void (root:EVGElement) {
        if ((strlen focusId) == 0) {
            return
        }
        this.scan(root)
        if ((this.indexOfId(focusId)) < 0) {
            focusId = ""
            ringVisible = false
        }
    }

    ; --- reveal ----------------------------------------------------------------

    ; SCROLL THE FOCUS INTO VIEW, the thing `element.focus()` does in a browser
    ; and nothing here did: Tab down a settings page and the ring walked off the
    ; bottom of the screen, because moving the focus and moving the page were
    ; never connected. Every box needed to notice was already here — `scan`
    ; records the rect of each focusable and `EVGElement` answers
    ; `clipsContent`, `clientHeight` and `maxScrollTop` — and nobody ever
    ; compared them.
    ;
    ; A KEY, NOT A CLICK. `key` calls this and `pointAt` does not, which is what
    ; a browser does and the reason it is not folded into `place`: someone who
    ; just clicked a control can see it, and a page that jumps under a click has
    ; moved what they were aiming at.
    ;
    ; Runs on the scan that is already there, so the tree handed in must be the
    ; tree that was scanned. Answers whether anything moved.
    fn reveal:boolean (root:EVGElement) {
        clear moved
        shiftX = 0.0
        shiftY = 0.0
        if ((strlen focusId) == 0) {
            return false
        }
        def at:int (this.indexOfId(focusId))
        if (at < 0) {
            return false
        }
        this.revealWalk(root focusId (itemAt xs at) (itemAt ys at) (itemAt ws at) (itemAt hs at))
        return ((array_length moved) > 0)
    }

    ; Post-order, because the answer is on the way OUT: the walk down finds the
    ; element and every `clipsContent` ancestor is then met innermost first,
    ; which is the order they have to be scrolled in for `shiftY` to mean
    ; anything.
    ;
    ; It walks rather than following parent links because there are none —
    ; `EVGElement.addChild` deliberately keeps no back-reference, since
    ; assigning `this` to a shared_ptr field forces `enable_shared_from_this`
    ; and broke the native build.
    fn revealWalk:boolean (el:EVGElement id:string x:double y:double w:double h:double) {
        if (el.id == id) {
            return true
        }
        if (el.a11yHidden) {
            return false
        }
        if (el.display == "none") {
            return false
        }
        ; The same debt as `walkIn` pays, for the same reason: `bring` reads a
        ; container's own box, and a container far from the viewport is owed a
        ; scroll too.
        el.settleShift()
        def i:int 0
        def n:int (el.getChildCount())
        while (i < n) {
            if (this.revealWalk((el.getChild(i)) id x y w h)) {
                if (el.clipsContent()) {
                    this.bring(el x y w h)
                }
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; One container, one rectangle. `nearest` in the DOM's language: a box
    ; already inside the band is left alone, one above it is brought to the top
    ; edge and one below to the bottom, and a box TALLER than the band is
    ; aligned to its top — the first test wins, so the second cannot undo it.
    ; Aligning a too-tall box to the bottom would show its end and hide the
    ; label that says what it is.
    fn bring:void (c:EVGElement x:double y:double w:double h:double) {
        def b:double c.box.borderWidthPx

        def top:double (c.calculatedY + b)
        def bottom:double (top + (c.clientHeight()))
        def ey:double (y - shiftY)
        def needY@(mutable):double 0.0
        if (ey < top) {
            needY = (ey - top)
        } {
            if ((ey + h) > bottom) {
                needY = ((ey + h) - bottom)
            }
        }
        if (needY != 0.0) {
            def wantY:double (EVGFocus.clamp((c.scrollTop + needY) (c.maxScrollTop())))
            if (wantY != c.scrollTop) {
                shiftY = (shiftY + (wantY - c.scrollTop))
                c.scrollTop = wantY
                this.noteMoved(c)
            }
        }

        def left:double (c.calculatedX + b)
        def right:double (left + (c.clientWidth()))
        def ex:double (x - shiftX)
        def needX@(mutable):double 0.0
        if (ex < left) {
            needX = (ex - left)
        } {
            if ((ex + w) > right) {
                needX = ((ex + w) - right)
            }
        }
        if (needX != 0.0) {
            def wantX:double (EVGFocus.clamp((c.scrollLeft + needX) (c.maxScrollLeft())))
            if (wantX != c.scrollLeft) {
                shiftX = (shiftX + (wantX - c.scrollLeft))
                c.scrollLeft = wantX
                this.noteMoved(c)
            }
        }
    }

    sfn clamp:double (v:double max:double) {
        if (v < 0.0) {
            return 0.0
        }
        if (v > max) {
            return max
        }
        return v
    }

    ; A container that moved on both axes is one container, and a caller that
    ; was told twice would do its bookkeeping twice.
    fn noteMoved:void (c:EVGElement) {
        for moved e:EVGElement i {
            if (e == c) {
                return
            }
        }
        push moved c
    }
}

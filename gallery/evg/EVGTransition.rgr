; ==============================================================================
; EVGTransition — the stylesheet's values, arrived at over time
; ==============================================================================
;
; `transition: background-color 150ms` means: when this property's value
; changes, do not jump to the new one — leave from where you are and get there
; in 150ms. That is the whole feature, and it is worth being precise about the
; three things it needs, because a hand-rolled version usually gets the third
; one wrong:
;
;   1. the value the sheet WANTS. That is what `applyTree` already writes.
;   2. the value the element is SHOWING. That is what the painter reads, and
;      while a flight is in the air it is neither end.
;   3. where a REVERSAL starts. Not the original value — where the flight had
;      actually got to. A hover that leaves half way through must fade back
;      from half way, and starting from the target is the flicker every naive
;      implementation has.
;
; So the caller does two things per frame, and they are separate on purpose:
;
;   reconcile(el)   after applying the stylesheet: notice what changed, start
;                   or retarget a flight, and put the SHOWING value back.
;   advance(el dt)  move the clock and write the new showing value.
;
; It reads no clock of its own. A frame is however long the host says it is,
; which is what makes every one of these testable to the millisecond and what
; lets a PDF backend render frame 7 of an animation without a browser.
; ==============================================================================

Import "EVGElement.rgr"
Import "EVGColor.rgr"

class EVGTransition {

    Constructor () {
    }

    ; --- what the sheet asked for ------------------------------------------------

    ; "background-color 150ms" or "opacity 100ms, background-color 200ms".
    ; Returns the duration for `property`, or -1 when it is not transitioned.
    ;
    ; `all` is honoured, because a stylesheet that says `transition: all 150ms`
    ; means it — and refusing it silently would be the same defect as dropping
    ; an unsupported pseudo-class.
    sfn durationFor:double (spec:string property:string) {
        if ((strlen spec) == 0) {
            return (0.0 - 1.0)
        }
        def parts:[string] (EVGTransition.splitOn(spec 44))
        def i:int 0
        while (i < (array_length parts)) {
            def one:string (trim (itemAt parts i))
            def words:[string] (EVGTransition.splitWords(one))
            if ((array_length words) >= 2) {
                def name:string (itemAt words 0)
                if ((name == property) || (name == "all")) {
                    return (EVGTransition.parseMs((itemAt words 1)))
                }
            }
            i = (i + 1)
        }
        return (0.0 - 1.0)
    }

    ; "150ms" or "0.15s". A bare number is milliseconds, which is the reading
    ; that cannot silently be a thousand times wrong.
    sfn parseMs:double (text:string) {
        def t:string (trim text)
        def n:int (strlen t)
        if (n == 0) {
            return 0.0
        }
        if (n > 2) {
            if ((substring t (n - 2) n) == "ms") {
                def v@(optional):double (to_double (substring t 0 (n - 2)))
                if v {
                    return (unwrap v)
                }
                return 0.0
            }
        }
        if (n > 1) {
            if ((substring t (n - 1) n) == "s") {
                def v2@(optional):double (to_double (substring t 0 (n - 1)))
                if v2 {
                    return ((unwrap v2) * 1000.0)
                }
                return 0.0
            }
        }
        def v3@(optional):double (to_double t)
        if v3 {
            return (unwrap v3)
        }
        return 0.0
    }

    sfn splitOn:[string] (s:string ch:int) {
        def out:[string]
        def start:int 0
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            if ((charAt s i) == ch) {
                push out (substring s start i)
                start = (i + 1)
            }
            i = (i + 1)
        }
        push out (substring s start n)
        return out
    }

    sfn splitWords:[string] (s:string) {
        def out:[string]
        def start:int 0
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def c:int (charAt s i)
            if (((c == 32) || (c == 9)) || (c == 10)) {
                if (i > start) {
                    push out (substring s start i)
                }
                start = (i + 1)
            }
            i = (i + 1)
        }
        if (n > start) {
            push out (substring s start n)
        }
        return out
    }

    ; --- the flights on an element -------------------------------------------------

    fn flightFor@(optional):EVGFlight (el:EVGElement property:string) {
        def i:int 0
        while (i < (array_length el.transitions)) {
            def f:EVGFlight (itemAt el.transitions i)
            if (f.property == property) {
                def hit@(optional):EVGFlight f
                return hit
            }
            i = (i + 1)
        }
        def miss@(optional):EVGFlight
        return miss
    }

    sfn sameColor:boolean (a:EVGColor b:EVGColor) {
        if ((to_int a.r) != (to_int b.r)) { return false }
        if ((to_int a.g) != (to_int b.g)) { return false }
        if ((to_int a.b) != (to_int b.b)) { return false }
        if ((to_int (a.a * 255.0)) != (to_int (b.a * 255.0))) { return false }
        return true
    }

    sfn mixColor:EVGColor (from:EVGColor to:EVGColor t:double) {
        def c (new EVGColor())
        c.r = (from.r + ((to.r - from.r) * t))
        c.g = (from.g + ((to.g - from.g) * t))
        c.b = (from.b + ((to.b - from.b) * t))
        c.a = (from.a + ((to.a - from.a) * t))
        c.isSet = true
        return c
    }

    ; The value the element is SHOWING for a flight at its current progress.
    fn showColor:EVGColor (f:EVGFlight) {
        return (EVGTransition.mixColor((unwrap f.fromColor) (unwrap f.toColor) (f.progress())))
    }

    fn showNumber:double (f:EVGFlight) {
        return (f.fromNumber + ((f.toNumber - f.fromNumber) * (f.progress())))
    }

    ; --- reconcile ------------------------------------------------------------------
    ; Called after the stylesheet has written what it wants. The element's field
    ; holds the TARGET; a flight, if there is one, holds where it is actually at.

    fn reconcile:void (el:EVGElement) {
        if el.backgroundColor {
            this.reconcileColor(el "background-color" (unwrap el.backgroundColor))
        }
        if el.color {
            this.reconcileColor(el "color" (unwrap el.color))
        }
        this.reconcileNumber(el "opacity" el.opacity)
        ; Put the showing values back, so the painter draws the flight and not
        ; the destination.
        this.writeBack(el)
    }

    fn reconcileColor:void (el:EVGElement property:string target:EVGColor) {
        def ms:double (EVGTransition.durationFor(el.transitionSpec property))
        if (ms <= 0.0) {
            ; Not transitioned: the target IS what shows, and any flight for it
            ; is abandoned rather than left to land on a value nobody asked for.
            this.drop(el property)
            return
        }
        if (target.isSet == false) {
            return
        }
        def existing@(optional):EVGFlight (this.flightFor(el property))
        if existing {
            def f:EVGFlight (unwrap existing)
            if (EVGTransition.sameColor((unwrap f.toColor) target)) {
                return
            }
            ; Retarget from where it HAS GOT TO, which is the whole reason a
            ; reversal does not flicker.
            def here:EVGColor (this.showColor(f))
            ; A true REVERSAL — the new target is where this flight started —
            ; takes only as long as it has already run. That is CSS's rule and
            ; it is not a nicety: a pointer that crosses a row and leaves takes
            ; the full duration to fade back otherwise, so a quick pass leaves a
            ; trail of rows still cooling down long after the pointer has gone.
            def span:double ms
            if (EVGTransition.sameColor((unwrap f.fromColor) target)) {
                span = (ms * (f.progress()))
            }
            f.fromColor = here
            f.toColor = target
            f.elapsedMs = 0.0
            f.durationMs = span
            return
        }
        ; The first apply on a fresh element establishes the value rather than
        ; animating to it from black — nothing was on screen to leave from.
        def created (new EVGFlight())
        created.property = property
        created.isColor = true
        created.fromColor = target
        created.toColor = target
        created.durationMs = ms
        created.elapsedMs = ms
        push el.transitions created
    }

    fn reconcileNumber:void (el:EVGElement property:string target:double) {
        def ms:double (EVGTransition.durationFor(el.transitionSpec property))
        if (ms <= 0.0) {
            this.drop(el property)
            return
        }
        def existing@(optional):EVGFlight (this.flightFor(el property))
        if existing {
            def f:EVGFlight (unwrap existing)
            if ((to_int (f.toNumber * 1000.0)) == (to_int (target * 1000.0))) {
                return
            }
            def hereN:double (this.showNumber(f))
            def spanN:double ms
            if ((to_int (f.fromNumber * 1000.0)) == (to_int (target * 1000.0))) {
                spanN = (ms * (f.progress()))
            }
            f.fromNumber = hereN
            f.toNumber = target
            f.elapsedMs = 0.0
            f.durationMs = spanN
            return
        }
        def created (new EVGFlight())
        created.property = property
        created.isColor = false
        created.fromNumber = target
        created.toNumber = target
        created.durationMs = ms
        created.elapsedMs = ms
        push el.transitions created
    }

    fn drop:void (el:EVGElement property:string) {
        def kept:[EVGFlight]
        def i:int 0
        while (i < (array_length el.transitions)) {
            def f:EVGFlight (itemAt el.transitions i)
            if (f.property != property) {
                push kept f
            }
            i = (i + 1)
        }
        clear el.transitions
        def j:int 0
        while (j < (array_length kept)) {
            push el.transitions (itemAt kept j)
            j = (j + 1)
        }
    }

    ; --- advance ---------------------------------------------------------------------

    fn advance:void (el:EVGElement dtMs:double) {
        def i:int 0
        while (i < (array_length el.transitions)) {
            def f:EVGFlight (itemAt el.transitions i)
            if ((f.done()) == false) {
                f.elapsedMs = (f.elapsedMs + dtMs)
                if (f.elapsedMs > f.durationMs) {
                    f.elapsedMs = f.durationMs
                }
            }
            i = (i + 1)
        }
        this.writeBack(el)
    }

    ; The showing values, into the fields the painter reads. This is the one
    ; place a flight touches the element, and it happens after both reconcile
    ; and advance so the two cannot disagree about what is on screen.
    fn writeBack:void (el:EVGElement) {
        def i:int 0
        while (i < (array_length el.transitions)) {
            def f:EVGFlight (itemAt el.transitions i)
            if (f.isColor) {
                def c:EVGColor (this.showColor(f))
                if (f.property == "background-color") {
                    el.backgroundColor = c
                }
                if (f.property == "color") {
                    el.color = c
                }
            } {
                if (f.property == "opacity") {
                    el.opacity = (this.showNumber(f))
                }
            }
            i = (i + 1)
        }
    }

    ; --- whole trees -------------------------------------------------------------------

    fn reconcileTree:void (root:EVGElement) {
        this.reconcile(root)
        def i:int 0
        while (i < (array_length root.children)) {
            this.reconcileTree((itemAt root.children i))
            i = (i + 1)
        }
    }

    fn advanceTree:void (root:EVGElement dtMs:double) {
        this.advance(root dtMs)
        def i:int 0
        while (i < (array_length root.children)) {
            this.advanceTree((itemAt root.children i) dtMs)
            i = (i + 1)
        }
    }

    ; Is anything still moving? A host that repaints on demand asks this to
    ; know whether it needs another frame.
    fn busy:boolean (root:EVGElement) {
        def i:int 0
        while (i < (array_length root.transitions)) {
            def f:EVGFlight (itemAt root.transitions i)
            if ((f.done()) == false) {
                return true
            }
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length root.children)) {
            if (this.busy((itemAt root.children j))) {
                return true
            }
            j = (j + 1)
        }
        return false
    }
}

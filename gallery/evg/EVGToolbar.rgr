; ==============================================================================
; EVGToolbar.rgr — a strip of buttons, for any EVG app.
; ==============================================================================
;
; This was the spreadsheet's toolbar and nothing else could have it. Word had
; no toolbar at all — no bold, no font, no size, no colour — and the only way
; to give it one was to write a second one, which is how two toolbars start
; drifting: a fix to the wrapping here, an icon added there, and a year later
; the two applications look like they were made by different people.
;
; So the parts that are not about spreadsheets live here:
;
;   ToolIcon    the icon numbers, so a bold button is the same shape wherever
;               it is drawn
;   ToolItem    what a button IS — the command it runs, how it looks, and the
;               geometry the layout gave it
;   EVGToolbar  the strip: adding, measuring, wrapping, hit testing, hover
;
; What stays with each application is the only thing that differs: which
; buttons, in which order, and what "pressed" means for a toggle. A spreadsheet
; asks the cell under the caret; a document asks the run under the caret;
; neither question belongs in here. `ToolItem.pressed` is the answer, set by
; the owner before the strip is painted.
;
; Every entry names a COMMAND — the same string the keyboard and a remote host
; use — so a button cannot do something the command surface cannot, and adding
; a command to the table is how a button gets its behaviour.
;
; The layout is measured, not assumed: labels are as wide as their text, groups
; are separated, and the strip is as many rows as the buttons need at the width
; it is given. Anything that would not fit is simply not drawn — a toolbar that
; runs off the edge of its own strip is the bug this started as.
; ==============================================================================

Import "EVGColor.rgr"
Import "EVGDisplayList.rgr"
Import "EVGA11yTree.rgr"

; The palette the strip draws itself with. An application hands one over rather
; than the toolbar reaching into a theme it cannot know about.
class EVGToolbarTheme {
    def bg:EVGColor (EVGColor.rgb(236 240 246))
    def line:EVGColor (EVGColor.rgb(210 216 224))
    def ink:EVGColor (EVGColor.rgb(30 36 48))
    def dim:EVGColor (EVGColor.rgb(80 92 110))
    ; The body of a filled icon shape — a row bar, a column bar, a cell block.
    ;
    ; This exists because `line` was being used for it, and `line` is the
    ; HAIRLINE colour: 210,216,224 on a 236,240,246 strip is four steps of
    ; grey. Every icon that drew a solid shape in it — insert row, insert
    ; column, delete row, no-border — came out as a pale smudge you had to
    ; know was there. A fill needs a fill's contrast.
    def glyph:EVGColor (EVGColor.rgb(140 152 170))
    def hotBg:EVGColor (EVGColor.rgb(232 236 242))
    def pressedBg:EVGColor (EVGColor.rgba(50 120 220 0.22))
    def accent:EVGColor (EVGColor.rgb(40 100 210))
    def warn:EVGColor (EVGColor.rgb(214 69 65))
    ; A link is its own colour everywhere it is drawn, and a toolbar icon that
    ; means "hyperlink" is drawn in it too.
    def link:EVGColor (EVGColor.rgb(21 78 172))
    def tipBg:EVGColor (EVGColor.rgb(255 255 255))

    Constructor () {
    }
}

class ToolIcon {
    sfn none:int ()        { return 0 }
    sfn undo:int ()        { return 1 }
    sfn redo:int ()        { return 2 }
    sfn bold:int ()        { return 3 }
    sfn italic:int ()      { return 4 }
    sfn underline:int ()   { return 5 }
    sfn strike:int ()      { return 6 }
    sfn alignLeft:int ()   { return 7 }
    sfn alignCenter:int () { return 8 }
    sfn alignRight:int ()  { return 9 }
    sfn valignTop:int ()   { return 10 }
    sfn valignMid:int ()   { return 11 }
    sfn valignBot:int ()   { return 12 }
    ; `wrap` belongs to the text renderer; this one is `wrapCell`.
    sfn wrapCell:int ()    { return 13 }
    sfn merge:int ()       { return 14 }
    sfn borderAll:int ()   { return 15 }
    sfn borderOut:int ()   { return 16 }
    sfn borderNone:int ()  { return 17 }
    sfn fill:int ()        { return 18 }
    sfn textColor:int ()   { return 19 }
    sfn currency:int ()    { return 20 }
    sfn percent:int ()     { return 21 }
    sfn comma:int ()       { return 22 }
    sfn decMore:int ()     { return 23 }
    sfn decLess:int ()     { return 24 }
    sfn sizeUp:int ()      { return 25 }
    sfn sizeDown:int ()    { return 26 }
    sfn paint:int ()       { return 27 }
    sfn clearFmt:int ()    { return 28 }
    sfn freeze:int ()      { return 29 }
    ; `filter` is taken by the compiler too.
    sfn funnel:int ()      { return 30 }
    sfn sortAsc:int ()     { return 31 }
    sfn sortDesc:int ()    { return 32 }
    sfn insertRow:int ()   { return 33 }
    sfn insertCol:int ()   { return 34 }
    sfn deleteRow:int ()   { return 35 }
    sfn chart:int ()       { return 36 }
    sfn link:int ()        { return 37 }
    sfn comment:int ()     { return 38 }
    ; `find` is a name the compiler keeps for itself, hence `search`.
    sfn search:int ()      { return 39 }
    sfn cond:int ()        { return 40 }
    sfn validate:int ()    { return 41 }
    sfn save:int ()        { return 42 }
    sfn openFile:int ()    { return 43 }
    sfn newFile:int ()     { return 44 }
    sfn report:int ()      { return 45 }
    ; The border gallery, as opposed to the three one-click border words.
    sfn borderMore:int ()  { return 46 }
    ; The database group. A shortcut is not a discoverable feature, and in a
    ; browser it is not even a reliable one: Ctrl+D is the bookmark and Ctrl+Q
    ; quits. A button on the strip works everywhere the grid is drawn.
    sfn database:int ()    { return 47 }
    sfn sqlBox:int ()      { return 48 }
    ; A show, as a triangle pointing right — the one icon a presentation tool
    ; cannot do without.
    sfn play:int ()        { return 49 }

    ; Lists: a dotted one, a numbered one, and the two that move an item in
    ; and out of its parent.
    sfn bulletList:int ()  { return 50 }
    sfn numberList:int ()  { return 51 }
    sfn indentMore:int ()  { return 52 }
    sfn indentLess:int ()  { return 53 }

    ; --- navigation, and the verbs a document or a deck has ------------------
    ;
    ; These exist because the two newer editors were borrowing the
    ; spreadsheet's icons for commands that have nothing to do with them, and
    ; a borrowed icon is not a neutral choice — it is a WRONG picture, which
    ; is worse than a dull one. "Next slide" was drawn as redo. "Previous
    ; page" was drawn as undo, on a bar that also has undo. "Insert an
    ; ellipse" was drawn as conditional formatting, in red and green.
    ;
    ; Five pairs were outright collisions — two different commands with one
    ; picture on the same strip: edit-mode and copy and format-copy all drew
    ; the paint roller; lock and group both drew the freeze cross; delete
    ; shape and delete slide both drew the delete-row bar.
    sfn navFirst:int ()    { return 54 }
    sfn navPrev:int ()     { return 55 }
    sfn navNext:int ()     { return 56 }
    sfn navLast:int ()     { return 57 }
    ; A pointer: "you are editing this now", as against reading it.
    sfn editMode:int ()    { return 58 }
    sfn copy:int ()        { return 59 }
    sfn paste:int ()       { return 60 }
    sfn shapeRect:int ()   { return 61 }
    sfn shapeEllipse:int (){ return 62 }
    sfn textBox:int ()     { return 63 }
    sfn picture:int ()     { return 64 }
    sfn lock:int ()        { return 65 }
    sfn flipH:int ()       { return 66 }
    sfn flipV:int ()       { return 67 }
    sfn duplicate:int ()   { return 68 }
    sfn trash:int ()       { return 69 }
    sfn bringFront:int ()  { return 70 }
    sfn sendBack:int ()    { return 71 }
    sfn group:int ()       { return 72 }
    sfn ungroup:int ()     { return 73 }
    sfn palette:int ()     { return 74 }
    sfn slideAdd:int ()    { return 75 }
    sfn slideCopy:int ()   { return 76 }
    sfn slideDel:int ()    { return 77 }
    ; The other half of the format painter: pick it up, put it on. These were
    ; the paint roller and the all-borders grid, and the grid was ALSO the box
    ; tool two buttons away.
    sfn formatPaste:int () { return 78 }
    ; The switch that turns the interface around. Drawn as a paragraph of
    ; ragged lines with an arrow under it pointing LEFT — the direction the
    ; text will run once it is pressed, which is the only thing about this
    ; button a reader needs to guess.
    sfn textRtl:int ()     { return 79 }
}

class ToolItem {
    ; The command this runs, and the argument it runs it with.
    def command:string ""
    def arg:string ""
    def label:string ""
    def icon:int 0
    ; A toggle draws itself pressed when its style question answers yes. The
    ; question is `toggleOp` / `toggleArg`, asked of the cell the caret is on.
    def toggle:boolean false
    def toggleOp:string ""
    def toggleArg:string ""
    ; Laid-out geometry, filled by `layout`.
    def x:int 0
    def y:int 0
    def w:int 0
    def h:int 0
    ; Which wrapped row this landed on. Recorded rather than derived from `y`,
    ; because deriving it means knowing the strip's own origin and a mirroring
    ; pass that got that subtraction wrong would move buttons between rows.
    def row:int 0
    ; A separator is drawn as a rule and cannot be clicked.
    def isSeparator:boolean false
    ; Whether a toggle is currently on. The strip does not know how to answer
    ; that — a spreadsheet asks the cell under the caret and a document asks
    ; the run under it — so the owner sets it before the strip is painted.
    def pressed:boolean false
    ; Wider than an icon: font / size dropdowns show a readable label.
    def textW:int 0

    Constructor () {
    }
}

class EVGToolbar {
    def items:[ToolItem]
    ; One row is 30 tall; the strip is as many rows as the buttons need at the
    ; width it is given. A spreadsheet has more buttons than a narrow window
    ; has room for, and dropping the last six of them — which is what a single
    ; fixed row does — loses exactly the ones a beginner is looking for.
    ; A desktop icon set draws its glyphs on a 24-pixel grid in a button of
    ; about 30 — LibreOffice, Breeze, every system tray. This strip drew 16
    ; pixels of glyph in 26, which is why the icons read as small even before
    ; anything about their shapes is discussed. The button grew with them so
    ; the strip does not get denser, only more legible.
    def rowH:int 34
    def rows:int 1
    def height:int 36
    def pad:int 5
    def iconW:int 30
    ; Lay the strip out right to left.
    ;
    ; This is the same switch `direction: rtl` is in EVGLayout, for the part
    ; of the interface that does not go through it: a toolbar computes its own
    ; geometry because it is a single row of chips, not a flex tree. The
    ; mirroring is the same reflection, for the same reason — everything that
    ; reads a button's position, the painter, the click and the accessibility
    ; tree, reads `x` and `w` off the item, so turning those around turns all
    ; three around together and none of them has to know.
    def rtl:boolean false
    ; Which item the pointer is over, or -1. Only chrome, but it is the
    ; difference between a strip of shapes and something that looks clickable.
    def hot:int -1

    Constructor () {
    }

    Constructor () {
    }

    fn add:ToolItem (command:string arg:string label:string icon:int) {
        def t (new ToolItem)
        t.command = command
        t.arg = arg
        t.label = label
        t.icon = icon
        push items t
        return t
    }

    fn addToggle:ToolItem (command:string arg:string label:string icon:int op:string opArg:string) {
        def t:ToolItem (this.add(command arg label icon))
        t.toggle = true
        t.toggleOp = op
        t.toggleArg = opArg
        return t
    }

    fn addText:ToolItem (command:string arg:string label:string width:int) {
        def t:ToolItem (this.add(command arg label (ToolIcon.none())))
        t.textW = width
        return t
    }

    fn addSeparator:void () {
        def t (new ToolItem)
        t.isSeparator = true
        push items t
    }

    fn layout:void (x0:int y0:int width:int) {
        def right:int ((x0 + width) - pad)
        def cx:int (x0 + pad)
        def row:int 0
        def i:int 0
        while (i < (array_length items)) {
            def t:ToolItem (itemAt items i)
            def w:int iconW
            if t.isSeparator {
                w = 9
            }
            if (t.textW > 0) {
                w = t.textW
            }
            if ((cx + w) > right) {
                ; Wrap. A separator never starts a row — it would be a rule
                ; hanging in space.
                row = (row + 1)
                cx = (x0 + pad)
                if t.isSeparator {
                    t.x = 0
                    t.y = 0
                    t.w = 0
                    t.h = 0
                    i = (i + 1)
                    continue
                }
            }
            t.x = cx
            t.y = ((y0 + (row * rowH)) + 3)
            t.row = row
            t.w = w
            t.h = (rowH - 6)
            cx = (cx + w)
            if (t.isSeparator == false) {
                cx = (cx + 2)
            }
            i = (i + 1)
        }
        rows = (row + 1)
        height = (rows * rowH)
        if rtl {
            this.mirrorRows(x0 width)
        }
    }

    ; Reflect every placed button about the strip, so the first command is
    ; under the reader's hand — which for a right-to-left reader is the right
    ; end of the strip, exactly as the first word of a line is.
    ;
    ; Each row is mirrored on its own, not the strip as a whole: a wrapped
    ; last row is short, and reflecting the whole band would leave its buttons
    ; floating in the middle instead of against the edge the rest start from.
    ; Buttons that did not fit were given no rectangle and are left alone —
    ; reflecting a zero-width item at zero would put a phantom target at the
    ; far edge.
    fn mirrorRows:void (x0:int width:int) {
        def r:int 0
        while (r < rows) {
            ; Where this row's buttons actually reach, which is not the strip
            ; width once a row has wrapped.
            def lo:int (x0 + width)
            def hi:int x0
            def i:int 0
            while (i < (array_length items)) {
                def t:ToolItem (itemAt items i)
                if (t.w > 0) {
                    if (t.row == r) {
                        if (t.x < lo) {
                            lo = t.x
                        }
                        if (((t.x + t.w)) > hi) {
                            hi = (t.x + t.w)
                        }
                    }
                }
                i = (i + 1)
            }
            if (hi > lo) {
                def span:int (lo + hi)
                def j:int 0
                while (j < (array_length items)) {
                    def t2:ToolItem (itemAt items j)
                    if (t2.w > 0) {
                        if (t2.row == r) {
                            t2.x = (span - (t2.x + t2.w))
                        }
                    }
                    j = (j + 1)
                }
            }
            r = (r + 1)
        }
    }



    ; --- what the strip MEANS -------------------------------------------------
    ; The same buttons, for something that cannot see them. A screen reader gets
    ; a toolbar with named buttons instead of a band of coloured rectangles, and
    ; the geometry is the one `layout` settled — read, not recomputed, so the
    ; rectangle a reader routes the mouse to is the rectangle that was painted.
    fn a11y:void (t:EVGA11yTree parentId:string idPrefix:string bx:int by:int bw:int bh:int) {
        def barId:string (idPrefix + "/toolbar")
        def bar:EVGA11yNode (t.node(barId parentId (EVGA11yRole.toolbar())))
        bar.name = "Toolbar"
        t.place(bar bx by bw bh)
        def i:int 0
        while (i < (array_length items)) {
            def it:ToolItem (itemAt items i)
            ; A separator is a rule, and an item that did not fit was given no
            ; rectangle. Neither is something to announce.
            def skip:boolean it.isSeparator
            if (it.w <= 0) {
                skip = true
            }
            if (it.h <= 0) {
                skip = true
            }
            if (skip == false) {
                def label:string it.label
                if ((strlen label) == 0) {
                    label = it.command
                }
                def nid:string (barId + "/" + it.command)
                if ((strlen it.arg) > 0) {
                    nid = (nid + ":" + it.arg)
                }
                def n:EVGA11yNode (t.button(nid barId label))
                t.place(n it.x it.y it.w it.h)
                ; A toggle is a pressed button, not a checkbox: the host writes
                ; aria-pressed for a button role and aria-checked for the rest.
                if it.toggle {
                    if it.pressed {
                        n.checked = (EVGA11yTri.yes())
                    } {
                        n.checked = (EVGA11yTri.no())
                    }
                }
            }
            i = (i + 1)
        }
    }

    ; The first icon this strip uses for two different commands, or 0.
    ;
    ; Two buttons with one picture is not a style problem, it is a strip you
    ; cannot read: the deck's had five such pairs — edit-mode, copy and
    ; format-copy all drew the paint roller; lock and group both drew the
    ; freeze cross; delete-shape and delete-slide both drew the delete-row
    ; bar. Nobody noticed because nothing was looking. Now the app tests are.
    ;
    ; Text buttons are exempt: a font picker and a size picker both show a
    ; value and neither has an icon at all.
    fn duplicateIcon:int () {
        def i:int 0
        while (i < (array_length items)) {
            def a:ToolItem (itemAt items i)
            if (a.isSeparator == false) {
                if (a.icon > 0) {
                    if (a.textW == 0) {
                        def j:int (i + 1)
                        while (j < (array_length items)) {
                            def b:ToolItem (itemAt items j)
                            if (b.isSeparator == false) {
                                if (b.textW == 0) {
                                    if (b.icon == a.icon) {
                                        if (b.command != a.command) {
                                            return a.icon
                                        }
                                    }
                                }
                            }
                            j = (j + 1)
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return 0
    }

    fn heightFor:int (width:int) {
        this.layout(0 0 width)
        return height
    }

    fn count:int () {
        return (array_length items)
    }

    fn at:ToolItem (i:int) {
        if (i < 0) {
            return (new ToolItem)
        }
        if (i >= (array_length items)) {
            return (new ToolItem)
        }
        return (itemAt items i)
    }

    fn hit:int (px:int py:int) {
        def i:int 0
        while (i < (array_length items)) {
            def t:ToolItem (itemAt items i)
            if (t.isSeparator == false) {
                if (t.w > 0) {
                    if (px >= t.x) {
                        if (px < (t.x + t.w)) {
                            if (py >= t.y) {
                                if (py < (t.y + t.h)) {
                                    return i
                                }
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return -1
    }

    fn hotLabel:string () {
        if (hot < 0) {
            return ""
        }
        def t:ToolItem (this.at(hot))
        return t.label
    }
}

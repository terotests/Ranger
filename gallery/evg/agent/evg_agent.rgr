; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; evg_agent — the tool surface, before there is a protocol around it
; ==============================================================================
;
; Four verbs over an EVG document. An agent with a shell and a way to read a
; file already has everything it needs to edit one; MCP, a widget and an editor
; panel are transports over exactly these, added when something needs them.
;
;   npm run agent -- outline <doc.evg.json> [--depth=N] [--at=PATH]
;   npm run agent -- query   <doc.evg.json> <.class | #id | tag | path>
;   npm run agent -- patch   <doc.evg.json> <ops.json> [--out=FILE]
;   npm run agent -- measure <doc.evg.json> [--width=N] [--height=N]
;
; --- WHY OUTLINE IS NOT JSON --------------------------------------------------
;
; `outline` prints an indented text tree and everything else prints JSON, which
; looks inconsistent until you count tokens. An outline exists to be READ by a
; model deciding what to change, and one line per node — path, tag, class, the
; few properties it actually sets — costs a fraction of the same tree as JSON
; while carrying the addresses the other verbs take. The others are parsed, not
; read, so they are JSON.
;
; --- WHY MEASURE IS THE INTERESTING ONE ---------------------------------------
;
; The rest of this is bookkeeping. `measure` is the verb that does something a
; model cannot do for itself: it lays the document out and answers, in numbers,
; whether the result is wrong — text past its box, siblings on top of each
; other, a node off the page. A screenshot asks the model to SEE that, badly
; and expensively. This reads it off the boxes layout already computed.
; ==============================================================================

Import "../EVGElement.rgr"
Import "../EVGInspect.rgr"
Import "../EVGLayout.rgr"
Import "../EVGPatch.rgr"
Import "../EVGUnit.rgr"
Import "../EVGTreeJson.rgr"

class EvgAgent {
    def insp:EVGInspect

    Constructor () {
        insp = (new EVGInspect())
    }

    sfn main:void () {
        def a (new EvgAgent())
        a.run()
    }

    fn run:void () {
        def argc:int (shell_arg_cnt)
        if (argc < 2) {
            this.usage()
            return
        }
        def verb:string (shell_arg 0)
        def docPath:string (shell_arg 1)
        def text@(optional):string (EvgAgent.slurp(docPath))
        if (null? text) {
            print (("{\"error\":\"cannot read \\\"" + docPath) + "\\\"\"}")
            return
        }
        def root@(optional):EVGElement (EVGTreeJson.fromText((unwrap text)))
        if (null? root) {
            print (("{\"error\":\"not an EVG document: \\\"" + docPath) + "\\\"\"}")
            return
        }
        def tree:EVGElement (unwrap root)

        if (verb == "outline") {
            this.outline(tree)
            return
        }
        if (verb == "query") {
            this.query(tree)
            return
        }
        if (verb == "patch") {
            this.patch(tree docPath)
            return
        }
        if (verb == "measure") {
            this.measure(tree)
            return
        }
        this.usage()
    }

    fn usage:void () {
        print "evg_agent — read, edit and check an EVG document"
        print ""
        print "  outline <doc> [--depth=N] [--at=PATH]   the tree, one line per node"
        print "  query   <doc> <.class|#id|tag|path>     the nodes that match"
        print "  patch   <doc> <ops.json> [--out=FILE]   apply ops, print the inverse"
        print "  measure <doc> [--width=N] [--height=N]  lay it out and say what is wrong"
    }

    ; --- outline --------------------------------------------------------------

    fn outline:void (root:EVGElement) {
        def depth:int (EvgAgent.intFlag("--depth" 99))
        def from:string (EvgAgent.textFlag("--at" "0"))
        insp.build(root)
        def shown:int 0
        def hidden:int 0
        def i:int 0
        while (i < (insp.count())) {
            def path:string (insp.pathAt(i))
            if (EvgAgent.under(path from)) {
                def d:int (EvgAgent.depthOf(path))
                def base:int (EvgAgent.depthOf(from))
                if ((d - base) <= depth) {
                    def hit@(optional):EVGElement (insp.elementAt(path))
                    if ((null? hit) == false) {
                        print (EvgAgent.line(path (unwrap hit) (d - base)))
                        shown = (shown + 1)
                    }
                } {
                    hidden = (hidden + 1)
                }
            }
            i = (i + 1)
        }
        ; Never truncate in silence — a model that cannot see there is more
        ; will confidently describe a document it has only the top of.
        if (hidden > 0) {
            print ""
            print ((("… " + (to_string hidden)) + " deeper nodes not shown — raise --depth or pass --at to go into one"))
        }
    }

    ; One node: its address, what it is, and only what it actually says.
    sfn line:string (path:string el:EVGElement indent:int) {
        def out:string (EvgAgent.pad(path 22))
        def i:int 0
        while (i < indent) {
            out = (out + "  ")
            i = (i + 1)
        }
        out = (out + el.tagName)
        if ((strlen el.id) > 0) {
            out = ((out + " #") + el.id)
        }
        if ((strlen el.className) > 0) {
            out = ((out + " .") + el.className)
        }
        if ((strlen el.textContent) > 0) {
            out = ((out + " \"") + (EvgAgent.clip(el.textContent 40)))
            out = (out + "\"")
        }
        def names:[string] (EVGPatch.patchableNames())
        def fresh@(optional):EVGElement (EVGPatch.create(el.tagName))
        if (null? fresh) {
            return out
        }
        def blank:EVGElement (unwrap fresh)
        def k:int 0
        while (k < (array_length names)) {
            def name:string (itemAt names k)
            if (name != "class-name") {
                def mine:string (EVGPatch.readProp(el name))
                def theirs:string (EVGPatch.readProp(blank name))
                if (mine != theirs) {
                    out = ((((out + "  ") + name) + "=") + mine)
                }
            }
            k = (k + 1)
        }
        return out
    }

    ; --- query ----------------------------------------------------------------

    fn query:void (root:EVGElement) {
        def argc:int (shell_arg_cnt)
        if (argc < 3) {
            print "{\"error\":\"query needs something to match\"}"
            return
        }
        def want:string (shell_arg 2)
        insp.build(root)
        def out:string "{\"matches\":["
        def n:int 0
        def i:int 0
        while (i < (insp.count())) {
            def path:string (insp.pathAt(i))
            def hit@(optional):EVGElement (insp.elementAt(path))
            if ((null? hit) == false) {
                def el:EVGElement (unwrap hit)
                if (EvgAgent.matches(el path want)) {
                    if (n > 0) {
                        out = (out + ",")
                    }
                    out = (out + "\n  ")
                    out = (out + (EVGTreeJson.brief(path el)))
                    n = (n + 1)
                }
            }
            i = (i + 1)
        }
        if (n > 0) {
            out = (out + "\n")
        }
        out = ((out + "],\"count\":") + (to_string n))
        out = (out + "}")
        print out
    }

    ; `.class`, `#id`, a bare tag, or a path — which is every way an address is
    ; written in the rest of this toolchain. Not a selector engine: a compound
    ; selector belongs to `EVGStyleSheet`, and pretending otherwise here would
    ; be a second, weaker implementation of one.
    sfn matches:boolean (el:EVGElement path:string want:string) {
        if ((strlen want) == 0) {
            return false
        }
        def c:int (charAt want 0)
        if (c == 46) {
            return (el.className == (substring want 1 (strlen want)))
        }
        if (c == 35) {
            return (el.id == (substring want 1 (strlen want)))
        }
        if ((c >= 48) && (c <= 57)) {
            return (path == want)
        }
        return (el.tagName == want)
    }

    ; --- patch ----------------------------------------------------------------

    fn patch:void (root:EVGElement docPath:string) {
        def argc:int (shell_arg_cnt)
        if (argc < 3) {
            print "{\"error\":\"patch needs an ops file\"}"
            return
        }
        def opsPath:string (shell_arg 2)
        def opsText@(optional):string (EvgAgent.slurp(opsPath))
        if (null? opsText) {
            print (("{\"error\":\"cannot read \\\"" + opsPath) + "\\\"\"}")
            return
        }
        def ops:[EVGPatchOp] (EvgAgent.readOps((unwrap opsText)))
        if ((array_length ops) == 0) {
            print "{\"error\":\"no ops in that file\"}"
            return
        }
        def p (new EVGPatch())
        def r:EVGPatchResult (p.apply(root ops))
        if (r.ok == false) {
            print (("{\"ok\":false,\"applied\":0,\"rejected\":" + (EvgAgent.strArray(r.rejected))) + "}")
            return
        }
        def outPath:string (EvgAgent.textFlag("--out" docPath))
        def text:string (EVGTreeJson.toText(root))
        EvgAgent.spit(outPath text)
        def out:string "{\"ok\":true,\"applied\":"
        out = (out + (to_string r.applied))
        out = ((out + ",\"wrote\":\"") + outPath)
        out = (out + "\",\"inverse\":[")
        def i:int 0
        while (i < (array_length r.inverse)) {
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + "\n  ")
            out = (out + (EvgAgent.opJson((itemAt r.inverse i))))
            i = (i + 1)
        }
        if ((array_length r.inverse) > 0) {
            out = (out + "\n")
        }
        out = (out + "]}")
        print out
    }

    ; An inverse op, in the shape `patch` takes back. Writing the file the
    ; caller would have to write is the difference between "here is how to undo
    ; it" and "here is a description of the undo".
    sfn opJson:string (op:EVGPatchOp) {
        def out:string "{\"op\":"
        out = (out + (EVGTreeJson.str(op.op)))
        out = ((out + ",\"at\":") + (EVGTreeJson.str(op.at)))
        if ((strlen op.prop) > 0) {
            out = ((out + ",\"prop\":") + (EVGTreeJson.str(op.prop)))
        }
        if (op.op == "set-prop") {
            out = ((out + ",\"value\":") + (EVGTreeJson.str(op.value)))
        }
        if (op.op == "set-text") {
            out = ((out + ",\"value\":") + (EVGTreeJson.str(op.value)))
        }
        if ((strlen op.toPath) > 0) {
            out = ((out + ",\"to\":") + (EVGTreeJson.str(op.toPath)))
        }
        if ((strlen op.tag) > 0) {
            out = ((out + ",\"tag\":") + (EVGTreeJson.str(op.tag)))
        }
        if (((op.op == "insert") || (op.op == "move")) || (op.op == "restore")) {
            out = ((out + ",\"index\":") + (to_string op.index))
        }
        ; `restore` names a subtree this process is holding, so an inverse
        ; carrying one cannot be replayed from a file. Say so in the file
        ; rather than let it look replayable.
        if (op.op == "restore") {
            out = (out + ",\"note\":\"in-process only — a removed subtree lives in the patch that removed it\"")
        }
        return (out + "}")
    }

    ; Is `path` at or below `from`? String prefix is not enough: "0/1" is not
    ; under "0/12", and both start the same way.
    sfn under:boolean (path:string from:string) {
        if (path == from) {
            return true
        }
        def head:string (from + "/")
        def n:int (strlen head)
        if ((strlen path) <= n) {
            return false
        }
        return ((substring path 0 n) == head)
    }

    sfn depthOf:int (path:string) {
        def n:int 0
        def i:int 0
        while (i < (strlen path)) {
            if ((charAt path i) == 47) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; --- measure --------------------------------------------------------------

    fn measure:void (root:EVGElement) {
        ; The document usually knows how big it is — a diagram exported from
        ; RangerFlow, a page converted from `.tsx` — and measuring it against a
        ; guessed page size reports the guess, not the document: every such
        ; export came back "past the page width" for no reason but the default.
        ; So the root's own size wins, and the flags override it.
        def w:int (EvgAgent.intFlag("--width" (EvgAgent.sizeOf(root true 1200))))
        def h:int (EvgAgent.intFlag("--height" (EvgAgent.sizeOf(root false 900))))
        def l (new EVGLayout())
        l.setPageSize((to_double w) (to_double h))
        l.layout(root)
        insp.build(root)

        def findings:[string]
        def i:int 0
        while (i < (insp.count())) {
            def path:string (insp.pathAt(i))
            def hit@(optional):EVGElement (insp.elementAt(path))
            if ((null? hit) == false) {
                def el:EVGElement (unwrap hit)
                this.checkOffPage(findings path el (to_double w) (to_double h))
                this.checkOverflow(findings path el)
                this.checkOverlap(findings path el)
            }
            i = (i + 1)
        }
        def out:string "{\"width\":"
        out = (out + (to_string w))
        out = ((out + ",\"height\":") + (to_string h))
        out = ((out + ",\"nodes\":") + (to_string (insp.count())))
        out = ((out + ",\"findings\":") + (EvgAgent.strArray(findings)))
        out = ((out + ",\"count\":") + (to_string (array_length findings)))
        out = (out + "}")
        print out
    }

    ; The root's declared width or height in pixels, or the fallback when it
    ; does not say. Only a px length answers: a root that is `100%` of
    ; something has no size of its own to report.
    sfn sizeOf:int (root:EVGElement wide:boolean fallback:int) {
        def u@(optional):EVGUnit root.height
        if wide {
            u = root.width
        }
        if (null? u) {
            return fallback
        }
        def uu:EVGUnit (unwrap u)
        if (uu.isSet == false) {
            return fallback
        }
        if (uu.unitType != 0) {
            return fallback
        }
        def px:int (to_int uu.value)
        if (px <= 0) {
            return fallback
        }
        return px
    }

    fn checkOffPage:void (findings:[string] path:string el:EVGElement w:double h:double) {
        ; A `path` carries its geometry in `d` and its box is 0x0, so every
        ; check below would pass on a shape that is nowhere near the page. A
        ; diagram exported from RangerFlow is ALL paths, which made `measure`
        ; silent on exactly the documents it was most wanted for.
        if ((strlen el.svgPath) > 0) {
            this.checkPathOffPage(findings path el w h)
            return
        }
        def right:double (el.calculatedX + el.calculatedWidth)
        def bottom:double (el.calculatedY + el.calculatedHeight)
        if (right > (w + 0.5)) {
            push findings ((((path + ": right edge ") + (EvgAgent.num(right))) + " is past the page width ") + (EvgAgent.num(w)))
        }
        if (bottom > (h + 0.5)) {
            push findings ((((path + ": bottom edge ") + (EvgAgent.num(bottom))) + " is past the page height ") + (EvgAgent.num(h)))
        }
        if (el.calculatedX < (0.0 - 0.5)) {
            push findings ((path + ": left edge ") + (EvgAgent.num(el.calculatedX)))
        }
    }

    ; The outer bound of a path, from the numbers in its `d`.
    ;
    ; Every coordinate a curve names — its control points included — lies
    ; outside or on the curve, so the extremes of the whole list bound the
    ; drawn shape. That is looser than the true bounds and it is the right kind
    ; of loose here: a shape reported as on the page is definitely on it.
    ;
    ; Only M, L, C, Q and Z are read. `A` mixes radii and flags in among the
    ; coordinates, and treating those as points would invent a bound rather
    ; than widen one, so a path using anything else is left unchecked and said
    ; to be.
    fn checkPathOffPage:void (findings:[string] path:string el:EVGElement w:double h:double) {
        if (EvgAgent.hasUnreadCommand(el.svgPath)) {
            return
        }
        def xs:[double]
        def ys:[double]
        EvgAgent.coordsOf(el.svgPath xs ys)
        if ((array_length xs) == 0) {
            return
        }
        def minX:double (itemAt xs 0)
        def maxX:double (itemAt xs 0)
        def i:int 1
        while (i < (array_length xs)) {
            def v:double (itemAt xs i)
            if (v < minX) {
                minX = v
            }
            if (v > maxX) {
                maxX = v
            }
            i = (i + 1)
        }
        def minY:double (itemAt ys 0)
        def maxY:double (itemAt ys 0)
        def k:int 1
        while (k < (array_length ys)) {
            def v:double (itemAt ys k)
            if (v < minY) {
                minY = v
            }
            if (v > maxY) {
                maxY = v
            }
            k = (k + 1)
        }
        if (maxX > (w + 0.5)) {
            push findings ((((path + ": the shape reaches ") + (EvgAgent.num(maxX))) + ", past the page width ") + (EvgAgent.num(w)))
        }
        if (maxY > (h + 0.5)) {
            push findings ((((path + ": the shape reaches ") + (EvgAgent.num(maxY))) + ", past the page height ") + (EvgAgent.num(h)))
        }
        if (minX < (0.0 - 0.5)) {
            push findings ((path + ": the shape starts at ") + (EvgAgent.num(minX)))
        }
        if (minY < (0.0 - 0.5)) {
            push findings ((path + ": the shape starts above the page, at ") + (EvgAgent.num(minY)))
        }
    }

    sfn hasUnreadCommand:boolean (d:string) {
        def i:int 0
        while (i < (strlen d)) {
            def c:int (charAt d i)
            def isLetter:boolean (((c >= 65) && (c <= 90)) || ((c >= 97) && (c <= 122)))
            if isLetter {
                if ((EvgAgent.isReadCommand(c)) == false) {
                    return true
                }
            }
            i = (i + 1)
        }
        return false
    }

    sfn isReadCommand:boolean (c:int) {
        if ((c == 77) || (c == 109)) {
            return true
        }
        if ((c == 76) || (c == 108)) {
            return true
        }
        if ((c == 67) || (c == 99)) {
            return true
        }
        if ((c == 81) || (c == 113)) {
            return true
        }
        if ((c == 90) || (c == 122)) {
            return true
        }
        return false
    }

    ; The numbers in a path, taken in pairs. A trailing odd number would mean a
    ; malformed path, and it is dropped rather than paired with nothing.
    sfn coordsOf:void (d:string xs:[double] ys:[double]) {
        def nums:[double]
        def cur:string ""
        def i:int 0
        while (i < (strlen d)) {
            def c:int (charAt d i)
            def isNum:boolean (((c >= 48) && (c <= 57)) || (((c == 46) || (c == 45)) || (c == 43)))
            if isNum {
                ; A minus starts a new number unless it opens this one.
                if ((c == 45) && ((strlen cur) > 0)) {
                    def done@(optional):double (to_double cur)
                    if done {
                        push nums (unwrap done)
                    }
                    cur = ""
                }
                cur = (cur + (substring d i (i + 1)))
            } {
                if ((strlen cur) > 0) {
                    def v@(optional):double (to_double cur)
                    if v {
                        push nums (unwrap v)
                    }
                    cur = ""
                }
            }
            i = (i + 1)
        }
        if ((strlen cur) > 0) {
            def last@(optional):double (to_double cur)
            if last {
                push nums (unwrap last)
            }
        }
        def k:int 0
        while ((k + 1) < (array_length nums)) {
            push xs (itemAt nums k)
            push ys (itemAt nums (k + 1))
            k = (k + 2)
        }
    }

    ; A child wider or taller than the box it is in. `overflow: visible` says
    ; the author MEANT it to spill, so only a clipping parent is a finding —
    ; otherwise every deliberate overhang is reported as a defect.
    fn checkOverflow:void (findings:[string] path:string el:EVGElement) {
        if (el.overflow == "visible") {
            return
        }
        def i:int 0
        while (i < (array_length el.children)) {
            def kid:EVGElement (itemAt el.children i)
            def kidRight:double (kid.calculatedX + kid.calculatedWidth)
            def myRight:double (el.calculatedX + el.calculatedWidth)
            def kidBottom:double (kid.calculatedY + kid.calculatedHeight)
            def myBottom:double (el.calculatedY + el.calculatedHeight)
            if (kidRight > (myRight + 0.5)) {
                push findings ((((path + "/") + (to_string i)) + " overflows its parent to the right by ") + (EvgAgent.num((kidRight - myRight))))
            }
            if (kidBottom > (myBottom + 0.5)) {
                push findings ((((path + "/") + (to_string i)) + " overflows its parent below by ") + (EvgAgent.num((kidBottom - myBottom))))
            }
            i = (i + 1)
        }
    }

    ; Two siblings on top of each other. Absolutely positioned nodes are left
    ; alone: overlapping is what they are for.
    fn checkOverlap:void (findings:[string] path:string el:EVGElement) {
        def n:int (array_length el.children)
        def i:int 0
        while (i < n) {
            def a:EVGElement (itemAt el.children i)
            def j:int (i + 1)
            while (j < n) {
                def b:EVGElement (itemAt el.children j)
                if (((a.hasAbsolutePosition()) == false) && ((b.hasAbsolutePosition()) == false)) {
                    if (EvgAgent.overlaps(a b)) {
                        push findings (((((path + "/") + (to_string i)) + " and ") + (path + "/")) + ((to_string j) + " overlap"))
                    }
                }
                j = (j + 1)
            }
            i = (i + 1)
        }
    }

    sfn overlaps:boolean (a:EVGElement b:EVGElement) {
        def ax2:double (a.calculatedX + a.calculatedWidth)
        def ay2:double (a.calculatedY + a.calculatedHeight)
        def bx2:double (b.calculatedX + b.calculatedWidth)
        def by2:double (b.calculatedY + b.calculatedHeight)
        if ((a.calculatedWidth <= 0.0) || (b.calculatedWidth <= 0.0)) {
            return false
        }
        if ((a.calculatedHeight <= 0.0) || (b.calculatedHeight <= 0.0)) {
            return false
        }
        if (ax2 <= (b.calculatedX + 0.5)) {
            return false
        }
        if (bx2 <= (a.calculatedX + 0.5)) {
            return false
        }
        if (ay2 <= (b.calculatedY + 0.5)) {
            return false
        }
        if (by2 <= (a.calculatedY + 0.5)) {
            return false
        }
        return true
    }

    ; --- the ops file ---------------------------------------------------------

    sfn readOps:[EVGPatchOp] (text:string) {
        def out:[EVGPatchOp]
        def c (new EVGJsonCursor())
        c.src = text
        c.at = 0
        c.skipWs()
        if ((c.take()) != 123) {
            return out
        }
        while (c.ok) {
            c.skipWs()
            def ch:int (c.peek())
            if (ch == 125) {
                return out
            }
            if (ch == 0) {
                return out
            }
            if (ch == 44) {
                def comma:int (c.take())
            } {
                def key:string (c.readString())
                c.skipWs()
                def colon:int (c.take())
                if (key == "ops") {
                    EvgAgent.readOpList(c out)
                } {
                    c.skipValue()
                }
            }
        }
        return out
    }

    sfn readOpList:void (c:EVGJsonCursor out:[EVGPatchOp]) {
        c.skipWs()
        if ((c.take()) != 91) {
            c.ok = false
            return
        }
        while (c.ok) {
            c.skipWs()
            def ch:int (c.peek())
            if (ch == 93) {
                def closing:int (c.take())
                return
            }
            if (ch == 0) {
                c.ok = false
                return
            }
            if (ch == 44) {
                def comma:int (c.take())
            } {
                def op:EVGPatchOp (EvgAgent.readOp(c))
                push out op
            }
        }
    }

    sfn readOp:EVGPatchOp (c:EVGJsonCursor) {
        def o (new EVGPatchOp())
        c.skipWs()
        if ((c.take()) != 123) {
            c.ok = false
            return o
        }
        while (c.ok) {
            c.skipWs()
            def ch:int (c.peek())
            if (ch == 125) {
                def closing:int (c.take())
                return o
            }
            if (ch == 0) {
                c.ok = false
                return o
            }
            if (ch == 44) {
                def comma:int (c.take())
            } {
                def key:string (c.readString())
                c.skipWs()
                def colon:int (c.take())
                if (key == "op") {
                    o.op = (c.readString())
                } {
                    if (key == "at") {
                        o.at = (c.readString())
                    } {
                        if (key == "prop") {
                            o.prop = (c.readString())
                        } {
                            if (key == "value") {
                                o.value = (c.readString())
                            } {
                                if (key == "to") {
                                    o.toPath = (c.readString())
                                } {
                                    if (key == "tag") {
                                        o.tag = (c.readString())
                                    } {
                                        if (key == "index") {
                                            o.index = (c.readNumber())
                                        } {
                                            c.skipValue()
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        return o
    }

    ; --- flags, files and text ------------------------------------------------

    sfn textFlag:string (name:string fallback:string) {
        def argc:int (shell_arg_cnt)
        def head:string (name + "=")
        def n:int (strlen head)
        def i:int 0
        while (i < argc) {
            def a:string (shell_arg i)
            if ((strlen a) > n) {
                if ((substring a 0 n) == head) {
                    return (substring a n (strlen a))
                }
            }
            i = (i + 1)
        }
        return fallback
    }

    sfn intFlag:int (name:string fallback:int) {
        def v:string (EvgAgent.textFlag(name ""))
        if ((strlen v) == 0) {
            return fallback
        }
        def parsed@(optional):int (to_int v)
        if (null? parsed) {
            return fallback
        }
        return (unwrap parsed)
    }

    sfn slurp@(optional):string (path:string) {
        def cut:int (EvgAgent.lastSlash(path))
        def dir:string "."
        def name:string path
        if (cut >= 0) {
            dir = (substring path 0 cut)
            name = (substring path (cut + 1) (strlen path))
        }
        def text@(optional):string (read_file dir name)
        return text
    }

    sfn spit:void (path:string data:string) {
        def cut:int (EvgAgent.lastSlash(path))
        def dir:string "."
        def name:string path
        if (cut >= 0) {
            dir = (substring path 0 cut)
            name = (substring path (cut + 1) (strlen path))
        }
        write_file dir name data
    }

    sfn lastSlash:int (path:string) {
        def at:int (0 - 1)
        def i:int 0
        while (i < (strlen path)) {
            if ((charAt path i) == 47) {
                at = i
            }
            i = (i + 1)
        }
        return at
    }

    sfn strArray:string (items:[string]) {
        def out:string "["
        def i:int 0
        while (i < (array_length items)) {
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + "\n  ")
            out = (out + (EVGTreeJson.str((itemAt items i))))
            i = (i + 1)
        }
        if ((array_length items) > 0) {
            out = (out + "\n")
        }
        return (out + "]")
    }

    sfn pad:string (s:string width:int) {
        def out:string s
        while ((strlen out) < width) {
            out = (out + " ")
        }
        return out
    }

    sfn clip:string (s:string width:int) {
        if ((strlen s) <= width) {
            return s
        }
        return ((substring s 0 width) + "…")
    }

    sfn num:string (v:double) {
        def whole:int (to_int v)
        return (to_string whole)
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; EVGToolbarTest — the strip, on its own, with no application behind it.
; ==============================================================================
;
; The point of pulling the toolbar out of the spreadsheet is that a second
; application can have one, so the test that matters is the one that builds a
; strip WITHOUT a spreadsheet: no cells, no selection, no GridFormat. If any
; of that is still needed, this file will not compile.
;
; What is checked is the part that a second host will lean on and that is easy
; to get quietly wrong: the wrapping at a given width (the bug the strip
; started as was buttons drawn off the end of their own band), the hit test
; landing on the button that was painted, and the pressed / hot states being
; the owner's answer rather than something the strip guesses.
;
;   npm run evg:toolbar:test
; ==============================================================================

Import "EVGToolbarView.rgr"

class BarCheck {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }

    fn eqStr:void (name:string got:string want:string) {
        this.ok((name + " (got '" + got + "' want '" + want + "')") (got == want))
    }
}

class EVGToolbarTest {
    sfn countText:int (dl:EVGDisplayList want:string) {
        def n:int 0
        def i:int 0
        while (i < (array_length dl.cmds)) {
            def c:EVGDrawCmd (itemAt dl.cmds i)
            if (c.kind == 3) {
                if (c.text == want) {
                    n = (n + 1)
                }
            }
            i = (i + 1)
        }
        return n
    }

    ; A strip an editor that is not a spreadsheet might want.
    sfn build:EVGToolbar () {
        def bar:EVGToolbar (new EVGToolbar)
        bar.add("file.save" "" "Save" (ToolIcon.save()))
        bar.add("edit.undo" "" "Undo" (ToolIcon.undo()))
        bar.add("edit.redo" "" "Redo" (ToolIcon.redo()))
        bar.addSeparator()
        bar.addToggle("format.bold" "" "Bold" (ToolIcon.bold()) "bold" "")
        bar.addToggle("format.italic" "" "Italic" (ToolIcon.italic()) "italic" "")
        bar.addToggle("format.underline" "" "Underline" (ToolIcon.underline()) "underline" "")
        bar.addSeparator()
        bar.addText("format.font" "" "Font" 96)
        bar.addText("format.size.pick" "" "11" 52)
        bar.add("format.color" "" "Text colour" (ToolIcon.textColor()))
        return bar
    }

    sfn main:void () {
        def c:BarCheck (new BarCheck)
        print "== EVGToolbarTest =="

        def bar:EVGToolbar (EVGToolbarTest.build())
        c.eqInt("every entry is in the strip" (bar.count()) 11)

        print "-- laid out where there is room --"
        bar.layout(0 0 900)
        c.eqInt("one row is enough at 900" bar.rows 1)
        def i:int 0
        def widest:int 0
        while (i < (bar.count())) {
            def t:ToolItem (bar.at(i))
            if ((t.x + t.w) > widest) {
                widest = (t.x + t.w)
            }
            i = (i + 1)
        }
        c.ok("and nothing was drawn past the end of it" (widest <= 900))
        c.eqInt("the height matches the rows" bar.height (bar.heightFor(900)))

        print "-- and wrapped where there is not --"
        bar.layout(0 0 220)
        c.ok("a narrow strip needs more rows" (bar.rows > 1))
        def j:int 0
        def over:int 0
        while (j < (bar.count())) {
            def t2:ToolItem (bar.at(j))
            if (t2.w > 0) {
                if ((t2.x + t2.w) > 220) {
                    over = (over + 1)
                }
            }
            j = (j + 1)
        }
        c.eqInt("and still nothing hangs off the edge" over 0)
        c.ok("the strip grew to hold them" ((bar.heightFor(220)) > (bar.heightFor(900))))

        print "-- the hit test lands where the button was painted --"
        bar.layout(10 40 900)
        def k:int 0
        def hits:int 0
        def misses:int 0
        while (k < (bar.count())) {
            def t3:ToolItem (bar.at(k))
            if (t3.isSeparator == false) {
                def hx:int (t3.x + (idiv t3.w 2))
                def hy:int (t3.y + (idiv t3.h 2))
                if ((bar.hit(hx hy)) == k) {
                    hits = (hits + 1)
                } {
                    misses = (misses + 1)
                }
            }
            k = (k + 1)
        }
        c.eqInt("every button is found under its own middle" misses 0)
        c.ok("which is all of them" (hits > 6))
        c.eqInt("and nothing is found above the strip" (bar.hit(20 0)) -1)
        c.eqInt("or past its right edge" (bar.hit(2000 45)) -1)
        ; A separator is a rule, not a button.
        def sep:ToolItem (bar.at(3))
        c.ok("the separator is one" sep.isSeparator)
        c.eqInt("and cannot be clicked" (bar.hit((sep.x + 1) (sep.y + 5))) -1)

        print "-- pressed and hot are the owner's answer --"
        def b:ToolItem (bar.at(4))
        c.eqStr("the bold button knows its command" b.command "format.bold")
        c.eqStr("and what it is asking about" b.toggleOp "bold")
        c.ok("it is not pressed until someone says so" (b.pressed == false))
        b.pressed = true
        c.ok("and then it is" ((bar.at(4)).pressed))
        bar.hot = 4
        c.eqStr("the tooltip is the hot button's label" (bar.hotLabel()) "Bold")
        bar.hot = -1
        c.eqStr("and empty when nothing is hot" (bar.hotLabel()) "")

        print "-- a value button shows a value --"
        def f:ToolItem (bar.at(8))
        c.ok("it is wider than an icon" (f.textW > 40))
        f.label = "Droid Serif"
        c.eqStr("and says whatever the owner put there" ((bar.at(8)).label) "Droid Serif")

        print "-- and it draws --"
        ; The whole point: a display list, from a toolbar, with no application.
        def view:EVGToolbarView (new EVGToolbarView)
        def ctx:UIContext (new UIContext)
        ctx.tr.loadFont("Open Sans" "Open_Sans/OpenSans-Regular.ttf")
        view.attach(ctx "Open Sans")
        def dl:EVGDisplayList (new EVGDisplayList)
        bar.hot = 4
        view.paint(dl bar 0 0 900 (bar.heightFor(900)))
        ; This used to demand more than 40 commands, and it was really
        ; measuring how the icons were BUILT: every glyph was a stack of small
        ; rectangles, so a strip of eleven buttons ran to dozens of them. The
        ; icons are single filled paths now — 38 commands for the same strip,
        ; which is the improvement, and the old threshold read it as a
        ; regression. Counting against the number of buttons says what was
        ; meant: every button is drawn, chip and glyph, and none is silently
        ; missing.
        c.ok("the strip made draw commands" ((array_length dl.cmds) > ((bar.count()) * 2)))
        ; The tooltip is text, and so are the letter icons.
        def texts:int 0
        def ti:int 0
        while (ti < (array_length dl.cmds)) {
            def cmd:EVGDrawCmd (itemAt dl.cmds ti)
            if (cmd.kind == 3) {
                texts = (texts + 1)
            }
            ti = (ti + 1)
        }
        c.ok("including text" (texts > 3))

        print "-- the hover pill and the tooltip --"
        ; Reported as missing from the strip entirely, and it was two things.
        ;
        ; The pill was drawn, in 232,236,242 on a 236,240,246 strip — four
        ; steps of grey, which is not a highlight, it is a rounding error. A
        ; hover has to be seen without being looked for.
        def hbg:EVGColor (view.theme.hotBg)
        def sbg:EVGColor (view.theme.bg)
        def dr:int ((sbg.red()) - (hbg.red()))
        c.ok(("the hover pill is a step you can see (" + (to_string dr) + " of grey)") (dr >= 12))
        c.ok("and still lighter than the strip's own hairline" ((hbg.red()) > (view.theme.line.red())))

        ; And the tip went into the list WITH the band, so the slide, the page
        ; or the sheet was painted over it — it hangs below the strip, and the
        ; app draws next. It belongs in the overlay pass, beside the dropdown
        ; that was lost the same way.
        def band:EVGDisplayList (new EVGDisplayList)
        bar.hot = 4
        view.paint(band bar 0 0 900 (bar.heightFor(900)))
        c.eqInt("the band alone carries no tooltip" (EVGToolbarTest.countText(band "Bold")) 0)
        def over:EVGDisplayList (new EVGDisplayList)
        view.paintOverlay(over bar)
        c.eqInt("the overlay carries it" (EVGToolbarTest.countText(over "Bold")) 1)
        c.ok("with a chip behind it" ((array_length over.cmds) > 1))
        ; Dark chip, light letters — a white one on a white page is a
        ; rectangle you have to find.
        def chip:EVGDrawCmd (itemAt over.cmds 0)
        def word:EVGDrawCmd (itemAt over.cmds 1)
        c.ok("the chip is dark" (chip.r < 90))
        c.ok("and the letters on it are not" (word.r > 200))
        ; It is under the button it names, not over it.
        def hb:ToolItem (bar.at(4))
        c.ok("the tip hangs below the button" (chip.y > (to_double (hb.y + hb.h))))
        ; Nothing hot, nothing drawn.
        def none:EVGDisplayList (new EVGDisplayList)
        bar.hot = -1
        view.paintOverlay(none bar)
        c.eqInt("and nothing is hot, nothing is drawn" (array_length none.cmds) 0)

        ; A tip on the last button on the row is pulled back inside the
        ; window rather than hanging off the end of it.
        def edge (new EVGToolbar)
        def ei:int 0
        while (ei < 6) {
            edge.add("a" "" "A" (ToolIcon.bold()))
            ei = (ei + 1)
        }
        def last:ToolItem (edge.at(5))
        last.label = "Insert a text box"
        view.paint((new EVGDisplayList) edge 0 0 240 (edge.heightFor(240)))
        edge.hot = 5
        def eover:EVGDisplayList (new EVGDisplayList)
        view.paintOverlay(eover edge)
        def echip:EVGDrawCmd (itemAt eover.cmds 0)
        def ehb:ToolItem (edge.at(5))
        c.ok("the last button really is near the right-hand edge" (ehb.x > 150))
        c.ok("a tip at the right-hand edge is pulled back inside"
             (((echip.x + echip.w) <= 240.0) && (echip.x >= 0.0)))
        c.ok("which is left of where the button would have put it"
             (echip.x < (to_double ehb.x)))
        ; A tip WIDER than the whole window cannot fit, and the one thing it
        ; must still do is start inside it rather than off the left edge —
        ; clamping to the right and then not clamping to the left would put
        ; the beginning of the words where nobody can read them.
        def tiny (new EVGToolbar)
        tiny.add("a" "" "A tooltip long enough to be wider than the window it is in" (ToolIcon.bold()))
        view.paint((new EVGDisplayList) tiny 0 0 120 (tiny.heightFor(120)))
        tiny.hot = 0
        def tover:EVGDisplayList (new EVGDisplayList)
        view.paintOverlay(tover tiny)
        def tchip:EVGDrawCmd (itemAt tover.cmds 0)
        c.ok("a tip wider than the window still starts inside it" (tchip.x >= 0.0))


        print "-- and the same strip, turned around --"
        ; The switch, on the part of the interface that does not go through
        ; EVGLayout: a toolbar computes its own geometry, so it mirrors
        ; itself, with the same reflection and for the same reason.
        def rbar (new EVGToolbar)
        rbar.add("edit.undo" "" "Undo" (ToolIcon.undo()))
        rbar.add("edit.redo" "" "Redo" (ToolIcon.redo()))
        rbar.add("format.bold" "" "Bold" (ToolIcon.bold()))
        rbar.layout(0 0 900)
        def lx0:int ((rbar.at(0)).x)
        def lx1:int ((rbar.at(1)).x)
        def lx2:int ((rbar.at(2)).x)
        c.ok("left to right, Undo is leftmost" (lx0 < lx1))
        c.ok("and Bold is rightmost" (lx1 < lx2))

        def mbar (new EVGToolbar)
        mbar.add("edit.undo" "" "Undo" (ToolIcon.undo()))
        mbar.add("edit.redo" "" "Redo" (ToolIcon.redo()))
        mbar.add("format.bold" "" "Bold" (ToolIcon.bold()))
        mbar.rtl = true
        mbar.layout(0 0 900)
        def rx0:int ((mbar.at(0)).x)
        def rx1:int ((mbar.at(1)).x)
        def rx2:int ((mbar.at(2)).x)
        c.ok("turned around, Undo is rightmost" (rx0 > rx1))
        c.ok("and Bold is leftmost" (rx1 > rx2))
        ; The widths are unchanged and the strip still starts where it did:
        ; this reflects the buttons, it does not restretch the band.
        c.eqInt("the strip is the same height" mbar.height rbar.height)

        def undoItem:ToolItem (rbar.at(0))
        def boldItem:ToolItem (mbar.at(2))
        def undoW:int undoItem.w
        def boldW:int boldItem.w

        ; WHERE THE STRIP SITS, not only the order inside it.
        ;
        ; This is the check that was missing, and its absence let a mirroring
        ; that reversed every button and moved the block of them nowhere pass
        ; a full green suite: the buttons came out in the right order, still
        ; packed against the LEFT edge with the empty space still on the
        ; right. Every button had moved and the strip had not. A screenshot
        ; said so in a second; the tests did not, because each of them asked
        ; about a button relative to another button.
        ;
        ; So: the first command must reach the right-hand edge, and the last
        ; must not begin at the left one.
        def firstEnd:int (rx0 + undoW)
        c.ok("the strip is packed against the right edge" (firstEnd > 880))
        c.ok("and is not still hugging the left one" (rx2 > 700))
        ; The padding survives the reflection at both ends: a row that began
        ; `pad` from the left edge ends `pad` from the right one.
        c.eqInt("the padding is the same at the far end" (900 - firstEnd) lx0)
        ; Bold was leftmost-but-two on the left-hand strip; mirrored it is
        ; the leftmost button, and its left edge is the mirror of Undo's
        ; right edge — the outermost button on each side is the same distance
        ; in from its own edge.
        c.eqInt("Bold's left edge mirrors Undo's right edge" rx2 (900 - (lx2 + boldW)))

        ; The click follows, because it reads the same rectangle the painter
        ; does. This is the check that would fail if mirroring had been done
        ; in the PAINTER instead — the strip would look right and every
        ; button would run its opposite number's command.
        def firstItem:ToolItem (mbar.at(0))
        def firstY:int firstItem.y
        def hitR:int (mbar.hit((rx0 + 2) (firstY + 2)))
        c.eqInt("clicking the rightmost button hits Undo" hitR 0)
        def lastY:int boldItem.y
        def hitL:int (mbar.hit((rx2 + 2) (lastY + 2)))
        c.eqInt("and the leftmost hits Bold" hitL 2)
        ; The order in the model is untouched, so a screen reader still reads
        ; the strip as Undo, Redo, Bold — which is the order it was built in
        ; and the order it is spoken in, whichever way it is drawn.
        def firstCmd:string firstItem.command
        c.eqStr("the model order is untouched" firstCmd "edit.undo")

        print "-- and the same strip in named pages --"
        ; Tabs group a wall of commands into words a reader can read. What
        ; matters is that they are an ADDITION: everything above this line is
        ; a strip with no tabs on it and behaves exactly as it always did.
        def tb (new EVGToolbar)
        tb.addTab("Home")
        tb.add("file.save" "" "Save" (ToolIcon.save()))
        tb.add("edit.undo" "" "Undo" (ToolIcon.undo()))
        tb.addTab("Insert")
        tb.add("insert.chart" "" "Chart" (ToolIcon.chart()))
        tb.add("insert.link" "" "Link" (ToolIcon.link()))
        tb.add("picture.add" "" "Picture" (ToolIcon.picture()))
        tb.layout(0 0 900)

        c.ok("the strip has pages" (tb.hasTabs()))
        c.eqInt("two of them" (tb.tabCount()) 2)
        c.eqInt("and every button is still in the one list" (tb.count()) 5)
        c.eqInt("Home is found by name" (tb.tabNamed("Home")) 0)
        c.eqInt("and Insert" (tb.tabNamed("Insert")) 1)
        c.eqInt("a name nobody used is not found" (tb.tabNamed("Nowhere")) -1)

        ; The showing page has geometry; the other has none at all. That is
        ; what lets the painter, the click and the accessibility tree stay
        ; ignorant of tabs — they already skip an item with no width, because
        ; that is how a button that did not fit has always been marked.
        def home0:ToolItem (tb.at(0))
        def ins0:ToolItem (tb.at(2))
        c.ok("a button on the showing page has a rectangle" (home0.w > 0))
        c.ok("one on the other page has none" (ins0.w == 0))
        c.eqInt("so a click where it would be hits nothing"
            (tb.hit((home0.x + 2) (home0.y + 2))) 0)

        ; The names sit above the buttons, and the buttons start below them.
        def t0:ToolTab (tb.tabAt(0))
        def t1:ToolTab (tb.tabAt(1))
        c.ok("the first name is at the left" (t0.x < t1.x))
        c.ok("the names are on their own row" (t0.y < home0.y))
        c.ok("and the buttons start under them" (home0.y >= tb.tabH))
        c.eqInt("clicking a name finds it" (tb.hitTab((t1.x + 2) (t1.y + 2))) 1)
        c.eqInt("and clicking where a button is finds no name"
            (tb.hitTab((home0.x + 2) (home0.y + 2))) -1)

        ; Switching pages swaps which buttons exist.
        c.ok("selecting the other page changes something" (tb.selectTab(1)))
        c.ok("selecting it again changes nothing" ((tb.selectTab(1)) == false))
        c.ok("and a page that is not there is refused" ((tb.selectTab(7)) == false))
        tb.layout(0 0 900)
        def home0b:ToolItem (tb.at(0))
        def ins0b:ToolItem (tb.at(2))
        c.ok("now Insert has the rectangles" (ins0b.w > 0))
        c.ok("and Home has none" (home0b.w == 0))
        c.eqInt("the click lands on the Insert button"
            (tb.hit((ins0b.x + 2) (ins0b.y + 2))) 2)

        ; The strip is taller by exactly the row of names.
        def flat (new EVGToolbar)
        flat.add("file.save" "" "Save" (ToolIcon.save()))
        flat.add("edit.undo" "" "Undo" (ToolIcon.undo()))
        c.eqInt("the pages cost exactly one row of names"
            ((tb.heightFor(900)) - (flat.heightFor(900))) tb.tabH)

        ; And they turn around with everything else.
        def mtb (new EVGToolbar)
        mtb.addTab("Home")
        mtb.add("file.save" "" "Save" (ToolIcon.save()))
        mtb.addTab("Insert")
        mtb.add("insert.chart" "" "Chart" (ToolIcon.chart()))
        mtb.rtl = true
        mtb.layout(0 0 900)
        def m0:ToolTab (mtb.tabAt(0))
        def m1:ToolTab (mtb.tabAt(1))
        c.ok("turned around, the first page name is on the right" (m0.x > m1.x))
        c.ok("and it reaches the right-hand edge" (((m0.x + m0.w)) > 880))

        print "-- buttons that say what they are, and lists that fold away --"
        def lb (new EVGToolbar)
        def plain:ToolItem (lb.add("edit.undo" "" "Undo" (ToolIcon.undo())))
        def named:ToolItem (lb.addLabeled("file.print" "" "Print" (ToolIcon.printDoc())))
        lb.layout(0 0 900)
        c.ok("a labelled button says so" named.showLabel)
        c.ok("a plain one does not" ((plain.showLabel) == false))
        c.ok("and the label makes it wider" (named.w > plain.w))

        def dd (new EVGToolbar)
        def owner:ToolItem (dd.addDropdown("Borders" (ToolIcon.borderAll())))
        dd.addUnder("format.border" "all" "All borders" (ToolIcon.borderAll()))
        dd.addUnder("format.border" "none" "No border" (ToolIcon.borderNone()))
        dd.addUnder("format.border" "outline" "Outline" (ToolIcon.borderOut()))
        dd.addUnder("format.border" "" "More borders…" (ToolIcon.borderMore()))
        dd.layout(0 0 900)
        c.eqInt("the strip holds five buttons" (dd.count()) 5)
        def e0:ToolItem (dd.at(1))
        def e2:ToolItem (dd.at(4))
        c.ok("the dropdown itself is on the strip" (owner.w > 0))
        c.eqInt("and its entries take no room at all" e0.w 0)
        c.eqInt("none of them" e2.w 0)
        ; Four commands in one slot, which is where a dropdown starts paying
        ; for itself. It is worth being exact about that rather than assuming
        ; it: the folded button carries a NAME, and a name is about fifty
        ; pixels, so against three icon-only buttons a dropdown is very
        ; slightly WIDER. Past three it wins, and it goes on winning — which
        ; is why the border commands are behind one and bold/italic are not.
        def flat2 (new EVGToolbar)
        flat2.add("format.border" "all" "All borders" (ToolIcon.borderAll()))
        flat2.add("format.border" "none" "No border" (ToolIcon.borderNone()))
        flat2.add("format.border" "outline" "Outline" (ToolIcon.borderOut()))
        flat2.add("format.border" "" "More borders…" (ToolIcon.borderMore()))
        flat2.layout(0 0 900)
        def flatEnd:ToolItem (flat2.at(3))
        c.ok("the folded list is narrower than the four buttons were"
            ((owner.x + owner.w) < (flatEnd.x + flatEnd.w)))

        ; Pressing the dropdown opens it, and the strip says it dealt with the
        ; press itself so the owner does not also run an empty command.
        c.ok("pressing it is handled by the strip" (dd.pressItem(0)))
        c.eqInt("and the list is showing" dd.openMenu 0)
        dd.layout(0 0 900)
        def o0:ToolItem (dd.at(1))
        def o1:ToolItem (dd.at(2))
        c.ok("now the entries have rectangles" (o0.w > 0))
        c.ok("stacked under the button" (o0.y >= (owner.y + owner.h)))
        c.ok("one below the other" (o1.y > o0.y))
        c.ok("all the same width" (o1.w == o0.w))
        c.eqInt("and a click lands on one" (dd.hit((o1.x + 4) (o1.y + 4))) 2)
        def box:[int] (dd.menuBox())
        c.eqInt("the list has a box to draw a panel behind" (array_length box) 4)

        ; Choosing an entry is NOT handled by the strip — the command has to
        ; run — but it does put the list away.
        c.ok("choosing an entry is left to the owner" ((dd.pressItem(2)) == false))
        c.eqInt("and the list is shut again" dd.openMenu -1)
        ; Pressing the dropdown twice shuts it, which is what a second click
        ; on an open menu does everywhere.
        dd.pressItem(0)
        c.ok("pressing it again shuts it" (dd.pressItem(0)))
        c.eqInt("shut" dd.openMenu -1)

        ; --- the strip's metrics come from a stylesheet ------------------------
        ; A 30-pixel chip is a comfortable mouse target and a poor finger one.
        ; The numbers that decide that are the whole of the strip's layout, so
        ; making THEM responsive makes the strip responsive — without the
        ; toolbar growing a box model.
        def styled:EVGToolbar (EVGToolbarTest.build())
        styled.layout(0 0 900)
        def wasIcon:int styled.iconW
        def wasRow:int styled.rowH
        def sheet (new EVGStyleSheet())
        sheet.parse(".toolbar { height: 34px; padding-left: 5px } .toolbar-button { width: 30px } @media (pointer: coarse) { .toolbar { height: 48px; padding-left: 8px } .toolbar-button { width: 44px } }")
        c.eqInt("the sheet parses cleanly" (sheet.getErrorCount()) 0)

        ; A mouse: the desktop numbers, unchanged.
        sheet.setViewport(1200.0 800.0 false)
        styled.applyStyle(sheet)
        c.eqInt("with a mouse the chip keeps its size" styled.iconW 30)
        c.eqInt("and the row its height" styled.rowH 34)

        ; A finger: the targets grow, and the strip is laid out again with
        ; them — a metric that changed after layout would be a strip whose
        ; buttons are drawn in one place and clicked in another.
        sheet.setViewport(390.0 844.0 true)
        styled.applyStyle(sheet)
        c.eqInt("a coarse pointer gets a 44px chip" styled.iconW 44)
        c.eqInt("and a taller row" styled.rowH 48)
        c.eqInt("and the edge padding follows" styled.pad 8)
        def firstBtn:ToolItem (styled.at(0))
        c.ok("the buttons were laid out again at the new size" (firstBtn.w >= 44))
        c.ok("and a click still lands on the button it looks like"
             ((styled.hit((firstBtn.x + 2) (firstBtn.y + 2))) == 0))

        ; A sheet that says nothing leaves every metric alone, which is what
        ; makes this safe to call from a caller that has no stylesheet yet.
        def silent (new EVGStyleSheet())
        silent.parse(".something-else { width: 5px }")
        silent.setViewport(390.0 844.0 true)
        styled.applyStyle(silent)
        c.eqInt("a sheet with nothing to say changes nothing" styled.iconW 44)

        ; And the desktop strip really was the desktop strip to begin with.
        ; THIRTY-FOUR AND FORTY, which is what `EVGToolbar` declares. These two
        ; read 30 and 34 for months after the strip grew its buttons to hold a
        ; 24-pixel glyph, so the only assertions here that pin the BUILT-IN
        ; numbers were pinning numbers nothing had used since — a red gate,
        ; which protects nothing. The 30 in the sheet above is the sheet's own
        ; and is unrelated: that is the point of the section, that a stylesheet
        ; can ask for a smaller chip than the strip ships with.
        c.eqInt("the built-in chip width is the desktop one" wasIcon 34)
        c.eqInt("as is the row height" wasRow 40)

        ; --- every outline in the catalogue is a legal shape on the grid ------
        ;
        ; `ToolIconPath` is eighty `d` strings typed into a source file, and
        ; fifteen of them arrived from a bitmap tracer rather than from a
        ; person. Two things can go wrong with such a string and neither is
        ; visible when reading it: it can fail to parse, in which case the
        ; icon silently draws nothing; and it can wander off the 24-grid the
        ; whole file is authored on, in which case it draws at the wrong size
        ; relative to every other icon, because `pushIconPath` scales from the
        ; GRID and not from the path's own bounds.
        ;
        ; So this walks the lot. It is the only assertion in the file that gets
        ; stronger every time an icon is added.
        def bad:int 0
        def off:int 0
        def seen:int 0
        def ik:int 1
        while (ik < 120) {
            def d:string (ToolIconPath.dataFor(ik))
            if ((strlen d) > 0) {
                seen = (seen + 1)
                def pp (new SVGPathParser())
                pp.parse(d)
                if (pp.hasErrors()) {
                    bad = (bad + 1)
                    print ("  icon " + (to_string ik) + " does not parse: " + d)
                }
                def bb:PathBounds (pp.getBounds())
                if (bb.minX < -0.01) { off = (off + 1) }
                if (bb.minY < -0.01) { off = (off + 1) }
                if (bb.maxX > 24.01) { off = (off + 1) }
                if (bb.maxY > 24.01) { off = (off + 1) }
            }
            ik = (ik + 1)
        }
        c.ok("the catalogue has outlines in it" (seen > 50))
        c.eqInt("every outline parses" bad 0)
        c.eqInt("and every one of them stays on the 24-grid" off 0)

        print ""
        print ("passed=" + (to_string c.passed) + " failed=" + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }
}

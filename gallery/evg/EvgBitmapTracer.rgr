; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; EvgBitmapTracer.rgr — bitmap → EVG path, potrace-style
; ==============================================================================
;
; Pipeline (Potrace paper):
;   1. decompose bitmap into closed edge paths
;   2. turdsize despeckle
;   3. optimal polygon (EvgTraceFit — calcLon / bestPolygon / adjustVertices)
;   4. alphamax corner/curve fit (+ optional optiCurve)
;   5. emit PathBuilder / EVGElement / SVG
;
; Color:
;   options.fillHex     — mono path fill (default #000000)
;   options.colorCount  — 1 = mono threshold; >1 = posterize ImageBuffer into
;                         N swatches and emit one evenodd <path> per layer
;
; Posterize (see the block comment above colorDist2 for why each step exists):
;   detectBackground  — flood the page in from the border (options.bgMode)
;   buildFlatMask     — region interior vs. anti-aliased transition
;   buildPalette      — count-weighted k-means++ over a 5-bit histogram of the
;                       interiors only, then merge indistinguishable swatches
;   assignLabels      — nearest swatch, with a guarded snap for transitions
;   mergeTinyRegions  — absorb runs below options.minRegion into their surround
;   maskForLabel      — one binary mask per swatch, traced like the mono path
;
;   bash gallery/evg/tools/run_trace_bench.sh
; ==============================================================================

Import "EvgTraceTypes.rgr"
Import "EvgTraceFit.rgr"
Import "EvgTraceCurve.rgr"
Import "PathBuilder.rgr"
Import "EVGElement.rgr"
Import "EVGColor.rgr"
Import "../pdf_writer/src/jpeg/ImageBuffer.rgr"

class EvgBitmapTracer {
    def options:EvgTraceOptions
    def bitmap:EvgBinaryBitmap
    def rings:[EvgTraceRing]
    def commands:[PathCommand]
    def pathData:string ""
    def width:int 0
    def height:int 0
    ; Multi-color posterize planes (populated by fromImageBuffer when colorCount > 1).
    def hasColorPlanes:boolean false
    def planeR:[int]
    def planeG:[int]
    def planeB:[int]
    def planeA:[int]
    ; 1 = region interior, 0 = anti-aliased transition (buildFlatMask).
    def flat:[int]
    ; Palette index per pixel, -1 = not painted (assignLabels).
    def labels:[int]
    ; Continuity region id per pixel, -1 = none (buildContourRegions).
    def regionOf:[int]
    def regionCount:int 0
    ; 1 = page background flooded in from the border (detectBackground).
    def bgMask:[int]
    def bgActive:boolean false
    def layers:[EvgTraceLayer]

    Constructor () {
        options = (EvgTraceOptions.defaults())
        bitmap = (EvgBinaryBitmap.create(0 0))
        def r:[EvgTraceRing]
        rings = r
        def c:[PathCommand]
        commands = c
        def pr:[int]
        planeR = pr
        def pg:[int]
        planeG = pg
        def pb:[int]
        planeB = pb
        def pa:[int]
        planeA = pa
        def fl:[int]
        flat = fl
        def lb:[int]
        labels = lb
        def bg:[int]
        bgMask = bg
        def ro:[int]
        regionOf = ro
        def ly:[EvgTraceLayer]
        layers = ly
    }

    sfn absD:double (v:double) {
        if (v < 0.0) {
            return (0.0 - v)
        }
        return v
    }

    sfn absI:int (v:int) {
        if (v < 0) {
            return (0 - v)
        }
        return v
    }

    ; Truncating division toward zero for the half-cell neighbour lookups.
    sfn idivTowardZero:int (a:int b:int) {
        if (b == 0) {
            return 0
        }
        if (a < 0) {
            if (b > 0) {
                return (0 - (idiv (0 - a) b))
            }
            return (idiv (0 - a) (0 - b))
        }
        if (b < 0) {
            return (0 - (idiv a (0 - b)))
        }
        return (idiv a b)
    }

    sfn fromBinary:EvgBitmapTracer (bm:EvgBinaryBitmap opts:EvgTraceOptions) {
        def t (new EvgBitmapTracer())
        t.options = opts
        t.bitmap = bm
        t.width = bm.w
        t.height = bm.h
        return t
    }

    ; Threshold an RGBA ImageBuffer into a binary bitmap, then wrap a tracer.
    ; When options.colorCount > 1, keep RGB planes and posterize in trace().
    sfn fromImageBuffer:EvgBitmapTracer (img:ImageBuffer opts:EvgTraceOptions) {
        if (opts.colorCount > 1) {
            def tCol (new EvgBitmapTracer())
            tCol.options = opts
            tCol.width = img.width
            tCol.height = img.height
            tCol.hasColorPlanes = true
            tCol.bitmap = (EvgBinaryBitmap.create(img.width img.height))
            def pr:[int]
            def pg:[int]
            def pb:[int]
            def pa:[int]
            def y:int 0
            while (y < img.height) {
                def x:int 0
                while (x < img.width) {
                    def c:Color (img.getPixel(x y))
                    push pr c.r
                    push pg c.g
                    push pb c.b
                    push pa c.a
                    x = (x + 1)
                }
                y = (y + 1)
            }
            tCol.planeR = pr
            tCol.planeG = pg
            tCol.planeB = pb
            tCol.planeA = pa
            return tCol
        }
        def thr:int opts.threshold
        if (thr < 0) {
            thr = (EvgBitmapTracer.otsuThreshold(img))
        }
        def bm:EvgBinaryBitmap (EvgBinaryBitmap.create(img.width img.height))
        def y2:int 0
        while (y2 < img.height) {
            def x2:int 0
            while (x2 < img.width) {
                def c2:Color (img.getPixel(x2 y2))
                def g:int (c2.grayscale())
                def on:boolean false
                if opts.blackOnWhite {
                    if (g < thr) {
                        on = true
                    }
                } {
                    if (g >= thr) {
                        on = true
                    }
                }
                ; Transparent pixels never count as foreground.
                if (c2.a < 16) {
                    on = false
                }
                bm.setBit(x2 y2 on)
                x2 = (x2 + 1)
            }
            y2 = (y2 + 1)
        }
        return (EvgBitmapTracer.fromBinary(bm opts))
    }

    ; Otsu threshold on luminance — used when options.threshold < 0.
    sfn otsuThreshold:int (img:ImageBuffer) {
        def hist:[int]
        def i:int 0
        while (i < 256) {
            push hist 0
            i = (i + 1)
        }
        def total:int (img.width * img.height)
        if (total <= 0) {
            return 128
        }
        def y:int 0
        while (y < img.height) {
            def x:int 0
            while (x < img.width) {
                def c:Color (img.getPixel(x y))
                def g:int (c.grayscale())
                def prev:int (itemAt hist g)
                set hist g (prev + 1)
                x = (x + 1)
            }
            y = (y + 1)
        }
        def sum:double 0.0
        i = 0
        while (i < 256) {
            def cnt:int (itemAt hist i)
            sum = (sum + ((to_double i) * (to_double cnt)))
            i = (i + 1)
        }
        def sumB:double 0.0
        def wB:int 0
        def best:double (0.0 - 1.0)
        def thr:int 128
        i = 0
        while (i < 256) {
            def c2:int (itemAt hist i)
            wB = (wB + c2)
            if (wB > 0) {
                def wF:int (total - wB)
                if (wF > 0) {
                    sumB = (sumB + ((to_double i) * (to_double c2)))
                    def mB:double (sumB / (to_double wB))
                    def mF:double ((sum - sumB) / (to_double wF))
                    def diff:double (mB - mF)
                    def between:double ((diff * diff) * (to_double wB) * (to_double wF))
                    if (between > best) {
                        best = between
                        thr = i
                    }
                }
            }
            i = (i + 1)
        }
        return thr
    }

    ; ----------------------------------------------------------------------
    ; Public entry
    ; ----------------------------------------------------------------------

    fn trace:void () {
        def emptyR:[EvgTraceRing]
        rings = emptyR
        def emptyC:[PathCommand]
        commands = emptyC
        def emptyL:[EvgTraceLayer]
        layers = emptyL
        pathData = ""
        if hasColorPlanes {
            this.traceColorLayers()
        } {
            this.decompose()
            this.emitCommands()
            pathData = (VectorShapes.asPathData(commands))
            ; Mono also exposes a single layer so callers can always use layers.
            def layer (new EvgTraceLayer())
            layer.fillHex = options.fillHex
            layer.pathData = pathData
            layer.ringCount = (array_length rings)
            layer.commandCount = (array_length commands)
            push layers layer
        }
    }

    fn getCommands:[PathCommand] () {
        return commands
    }

    fn getPathData:string () {
        return pathData
    }

    fn ringCount:int () {
        return (array_length rings)
    }

    fn commandCount:int () {
        return (array_length commands)
    }

    ; True when a page color was actually flooded away — the page can say so,
    ; because "auto" declining silently is indistinguishable from it failing.
    fn backgroundRemoved:boolean () {
        return bgActive
    }

    fn layerCount:int () {
        return (array_length layers)
    }

    fn getLayers:[EvgTraceLayer] () {
        return layers
    }

    fn toPathBuilder:PathBuilder () {
        def b (new PathBuilder())
        b.addCommands(commands)
        return b
    }

    fn toEVGElement:EVGElement () {
        def el:EVGElement (EVGElement.createPath())
        el.svgPath = pathData
        el.fillRule = "evenodd"
        el.viewBox = ("0 0 " + (to_string width) + " " + (to_string height))
        el.fillColor = (EVGColor.parse(options.fillHex))
        if ((array_length layers) > 0) {
            def layer0:EvgTraceLayer (itemAt layers 0)
            el.svgPath = layer0.pathData
            el.fillColor = (EVGColor.parse(layer0.fillHex))
        }
        el.width = (EVGUnit.px((to_double width)))
        el.height = (EVGUnit.px((to_double height)))
        return el
    }

    ; One EVG path element per color layer (posterize / mono).
    fn toEVGElements:[EVGElement] () {
        def out:[EVGElement]
        def i:int 0
        while (i < (array_length layers)) {
            def layer:EvgTraceLayer (itemAt layers i)
            def el:EVGElement (EVGElement.createPath())
            el.svgPath = layer.pathData
            el.fillRule = "evenodd"
            el.viewBox = ("0 0 " + (to_string width) + " " + (to_string height))
            el.fillColor = (EVGColor.parse(layer.fillHex))
            el.width = (EVGUnit.px((to_double width)))
            el.height = (EVGUnit.px((to_double height)))
            push out el
            i = (i + 1)
        }
        return out
    }

    sfn num:string (v:double) {
        ; Two decimals is plenty for a gradient axis and keeps the file small.
        def scaled:int (to_int ((v * 100.0) + 0.5))
        def whole:int (idiv scaled 100)
        def frac:int (scaled - (whole * 100))
        if (frac < 0) {
            frac = (0 - frac)
        }
        def fs:string (to_string frac)
        if (frac < 10) {
            fs = ("0" + fs)
        }
        return ((to_string whole) + "." + fs)
    }

    fn toSVG:string () {
        def svg:string "<svg xmlns=\"http://www.w3.org/2000/svg\" "
        svg = (svg + "width=\"" + (to_string width) + "\" ")
        svg = (svg + "height=\"" + (to_string height) + "\" ")
        svg = (svg + "viewBox=\"0 0 " + (to_string width) + " " + (to_string height) + "\">")
        if ((array_length layers) > 0) {
            ; Gradients have to be declared before they are referenced.
            def defs:string ""
            def i:int 0
            while (i < (array_length layers)) {
                def layer:EvgTraceLayer (itemAt layers i)
                def id:string ("g" + (to_string i))
                if ((layer.fillKind) == "linear") {
                    defs = (defs + "<linearGradient id=\"" + id + "\" gradientUnits=\"userSpaceOnUse\"")
                    defs = (defs + " x1=\"" + (EvgBitmapTracer.num(layer.gx0)) + "\" y1=\"" + (EvgBitmapTracer.num(layer.gy0)) + "\"")
                    defs = (defs + " x2=\"" + (EvgBitmapTracer.num(layer.gx1)) + "\" y2=\"" + (EvgBitmapTracer.num(layer.gy1)) + "\">")
                    defs = (defs + "<stop offset=\"0\" stop-color=\"" + layer.stopA + "\"/>")
                    defs = (defs + "<stop offset=\"1\" stop-color=\"" + layer.stopB + "\"/></linearGradient>")
                }
                if ((layer.fillKind) == "radial") {
                    defs = (defs + "<radialGradient id=\"" + id + "\" gradientUnits=\"userSpaceOnUse\"")
                    defs = (defs + " cx=\"" + (EvgBitmapTracer.num(layer.gx0)) + "\" cy=\"" + (EvgBitmapTracer.num(layer.gy0)) + "\"")
                    defs = (defs + " r=\"" + (EvgBitmapTracer.num(layer.gr)) + "\">")
                    defs = (defs + "<stop offset=\"0\" stop-color=\"" + layer.stopA + "\"/>")
                    defs = (defs + "<stop offset=\"1\" stop-color=\"" + layer.stopB + "\"/></radialGradient>")
                }
                i = (i + 1)
            }
            if ((strlen defs) > 0) {
                svg = (svg + "<defs>" + defs + "</defs>")
            }
            i = 0
            while (i < (array_length layers)) {
                def layer2:EvgTraceLayer (itemAt layers i)
                def fill:string layer2.fillHex
                if ((layer2.fillKind) != "flat") {
                    fill = ("url(#g" + (to_string i) + ")")
                }
                svg = (svg + "<path fill=\"" + fill + "\" fill-rule=\"evenodd\" d=\"" + layer2.pathData + "\"/>")
                i = (i + 1)
            }
        } {
            svg = (svg + "<path fill=\"" + options.fillHex + "\" fill-rule=\"evenodd\" d=\"" + pathData + "\"/>")
        }
        svg = (svg + "</svg>")
        return svg
    }

    ; ----------------------------------------------------------------------
    ; Multi-color posterize (quantize → per-swatch binary trace)
    ;
    ; The palette is built from *plateau* pixels only. Anti-aliased boundary
    ; pixels are blends of two real colors: if they are allowed to vote, the
    ; extra swatches are spent on halo tones instead of new regions, and every
    ; ink stroke is then eaten from both sides until turdsize deletes what is
    ; left. Transitional pixels are instead snapped to a neighbouring region.
    ; ----------------------------------------------------------------------

    ; Weighted Euclidean distance in RGB with an extra luma term, so a dark
    ; ink line never collapses into a mid-tone of the same hue.
    sfn colorDist2:double (r0:int g0:int b0:int r1:int g1:int b1:int lw:int) {
        def dr:double (to_double (r0 - r1))
        def dg:double (to_double (g0 - g1))
        def db:double (to_double (b0 - b1))
        def l0:int (EvgBitmapTracer.lumaOf(r0 g0 b0))
        def l1:int (EvgBitmapTracer.lumaOf(r1 g1 b1))
        def dl:double (to_double (l0 - l1))
        return ((((dr * dr) + (dg * dg)) + (db * db)) + ((dl * dl) * (to_double lw)))
    }

    sfn lumaOf:int (r:int g:int b:int) {
        ; Integer approx of 0.299R+0.587G+0.114B
        return (idiv (((r * 299) + (g * 587)) + (b * 114)) 1000)
    }

    fn lumaWeight:int () {
        def lw:int options.lumaWeight
        if (lw < 1) {
            return 1
        }
        return lw
    }

    ; True if this opaque pixel may join the palette / masks.
    fn pixelAllowed:boolean (i:int) {
        def a:int (itemAt planeA i)
        if (a < 16) {
            return false
        }
        if bgActive {
            return ((itemAt bgMask i) == 0)
        }
        if (options.bgMode == "none") {
            return true
        }
        def lum:int (EvgBitmapTracer.lumaOf((itemAt planeR i) (itemAt planeG i) (itemAt planeB i)))
        return (lum < options.skipLuma)
    }

    ; ----------------------------------------------------------------------
    ; Background detection
    ;
    ; skipLuma is a blunt instrument: it deletes every bright pixel, so a white
    ; belly or a highlight inside the subject is thrown away along with the
    ; page. Instead, flood the border color inwards and drop only what is
    ; actually connected to the edge of the image. Bail out (and leave the
    ; skipLuma rule in charge) unless the border really is one flat color —
    ; a photograph has no page to remove.
    ; ----------------------------------------------------------------------

    fn detectBackground:void () {
        bgActive = false
        def mode:string options.bgMode
        def named:boolean (mode == "color")
        if ((mode != "auto") && (named == false)) {
            return
        }
        def n:int (width * height)
        if (n < 4) {
            return
        }
        ; Modal border color, via the same 5-bit histogram as the palette.
        def bins:int 32768
        def cnt:[int]
        def sr:[int]
        def sg:[int]
        def sb:[int]
        def i:int 0
        while (i < bins) {
            push cnt 0
            push sr 0
            push sg 0
            push sb 0
            i = (i + 1)
        }
        def border:[int]
        def x:int 0
        while (x < width) {
            push border x
            push border (((height - 1) * width) + x)
            x = (x + 1)
        }
        def y:int 1
        while (y < (height - 1)) {
            push border (y * width)
            push border ((y * width) + (width - 1))
            y = (y + 1)
        }
        def bn:int (array_length border)
        if (bn == 0) {
            return
        }
        def opaqueBorder:int 0
        i = 0
        while (i < bn) {
            def idx:int (itemAt border i)
            if ((itemAt planeA idx) >= 16) {
                def r:int (itemAt planeR idx)
                def g:int (itemAt planeG idx)
                def b:int (itemAt planeB idx)
                def key:int (((((idiv r 8) * 32) + (idiv g 8)) * 32) + (idiv b 8))
                set cnt key ((itemAt cnt key) + 1)
                set sr key ((itemAt sr key) + r)
                set sg key ((itemAt sg key) + g)
                set sb key ((itemAt sb key) + b)
                opaqueBorder = (opaqueBorder + 1)
            }
            i = (i + 1)
        }
        ; A fully transparent border is a cut-out: alpha already removed it.
        if (opaqueBorder == 0) {
            return
        }
        def topI:int (0 - 1)
        def topC:int 0
        i = 0
        while (i < bins) {
            if ((itemAt cnt i) > topC) {
                topC = (itemAt cnt i)
                topI = i
            }
            i = (i + 1)
        }
        if (topI < 0) {
            return
        }
        def bgR:int (idiv (itemAt sr topI) topC)
        def bgG:int (idiv (itemAt sg topI) topC)
        def bgB:int (idiv (itemAt sb topI) topC)
        def tol:int options.bgTolerance
        if (tol < 0) {
            tol = 0
        }
        if named {
            ; The caller named the color, so the border does not get a vote on
            ; what it is — or on whether the flood happens at all.
            def c:EVGColor (EVGColor.parse(options.bgColor))
            if (c.isSet == false) {
                return
            }
            bgR = (to_int c.r)
            bgG = (to_int c.g)
            bgB = (to_int c.b)
        } {
            ; How much of the border actually is that color?
            def within:int 0
            i = 0
            while (i < bn) {
                def idx2:int (itemAt border i)
                if ((itemAt planeA idx2) >= 16) {
                    if (this.nearBg(idx2 bgR bgG bgB tol)) {
                        within = (within + 1)
                    }
                }
                i = (i + 1)
            }
            if ((idiv (within * 100) opaqueBorder) < 80) {
                return
            }
        }
        ; Flood the page in from every matching border pixel.
        def mask:[int]
        i = 0
        while (i < n) {
            push mask 0
            i = (i + 1)
        }
        def stack:[int]
        i = 0
        while (i < bn) {
            def s0:int (itemAt border i)
            if ((itemAt mask s0) == 0) {
                if (this.nearBg(s0 bgR bgG bgB tol)) {
                    set mask s0 1
                    push stack s0
                }
            }
            i = (i + 1)
        }
        def head:int 0
        while (head < (array_length stack)) {
            def cur:int (itemAt stack head)
            head = (head + 1)
            def cy:int (idiv cur width)
            def cx:int (cur - (cy * width))
            if (cx > 0) {
                this.floodStep((cur - 1) mask stack bgR bgG bgB tol)
            }
            if (cx < (width - 1)) {
                this.floodStep((cur + 1) mask stack bgR bgG bgB tol)
            }
            if (cy > 0) {
                this.floodStep((cur - width) mask stack bgR bgG bgB tol)
            }
            if (cy < (height - 1)) {
                this.floodStep((cur + width) mask stack bgR bgG bgB tol)
            }
        }
        bgMask = mask
        bgActive = true
    }

    fn nearBg:boolean (i:int bgR:int bgG:int bgB:int tol:int) {
        if ((itemAt planeA i) < 16) {
            return true
        }
        if ((EvgBitmapTracer.absI((itemAt planeR i) - bgR)) > tol) {
            return false
        }
        if ((EvgBitmapTracer.absI((itemAt planeG i) - bgG)) > tol) {
            return false
        }
        if ((EvgBitmapTracer.absI((itemAt planeB i) - bgB)) > tol) {
            return false
        }
        return true
    }

    fn floodStep:void (i:int mask:[int] stack:[int] bgR:int bgG:int bgB:int tol:int) {
        if ((itemAt mask i) != 0) {
            return
        }
        if (this.nearBg(i bgR bgG bgB tol)) {
            set mask i 1
            push stack i
        }
    }

    ; ----------------------------------------------------------------------
    ; Plateau / edge classification
    ; ----------------------------------------------------------------------

    ; Largest per-channel difference between two pixels (alpha included, so the
    ; feathered rim of a cut-out counts as a transition too).
    fn pixelDelta:int (i:int j:int) {
        def d:int (EvgBitmapTracer.absI((itemAt planeR i) - (itemAt planeR j)))
        def dg:int (EvgBitmapTracer.absI((itemAt planeG i) - (itemAt planeG j)))
        if (dg > d) {
            d = dg
        }
        def db:int (EvgBitmapTracer.absI((itemAt planeB i) - (itemAt planeB j)))
        if (db > d) {
            d = db
        }
        def da:int (EvgBitmapTracer.absI((itemAt planeA i) - (itemAt planeA j)))
        if (da > d) {
            d = da
        }
        return d
    }

    ; flat[i] = 1 when every 4-neighbour is within flatTolerance, i.e. the pixel
    ; sits inside a region rather than on an anti-aliased boundary.
    fn buildFlatMask:void () {
        def n:int (width * height)
        def f:[int]
        def i:int 0
        while (i < n) {
            push f 1
            i = (i + 1)
        }
        def tol:int options.flatTolerance
        if (tol < 0) {
            tol = 0
        }
        def y:int 0
        while (y < height) {
            def x:int 0
            while (x < width) {
                def idx:int ((y * width) + x)
                def isFlat:boolean true
                if (x > 0) {
                    if ((this.pixelDelta(idx (idx - 1))) > tol) {
                        isFlat = false
                    }
                }
                if (x < (width - 1)) {
                    if ((this.pixelDelta(idx (idx + 1))) > tol) {
                        isFlat = false
                    }
                }
                if (y > 0) {
                    if ((this.pixelDelta(idx (idx - width))) > tol) {
                        isFlat = false
                    }
                }
                if (y < (height - 1)) {
                    if ((this.pixelDelta(idx (idx + width))) > tol) {
                        isFlat = false
                    }
                }
                if isFlat {
                    set f idx 1
                } {
                    set f idx 0
                }
                x = (x + 1)
            }
            y = (y + 1)
        }
        flat = f
    }

    ; ----------------------------------------------------------------------
    ; Color histogram (5 bits per channel) over the pixels that may vote
    ; ----------------------------------------------------------------------

    fn buildHistogram:void (flatOnly:boolean binR:[int] binG:[int] binB:[int] binW:[int]) {
        def bins:int 32768
        def cnt:[int]
        def sumR:[int]
        def sumG:[int]
        def sumB:[int]
        def i:int 0
        while (i < bins) {
            push cnt 0
            push sumR 0
            push sumG 0
            push sumB 0
            i = (i + 1)
        }
        def n:int (array_length planeR)
        def hasFlat:boolean ((array_length flat) == n)
        i = 0
        while (i < n) {
            def take:boolean (this.pixelAllowed(i))
            if (take && flatOnly && hasFlat) {
                if ((itemAt flat i) == 0) {
                    take = false
                }
            }
            if take {
                def r:int (itemAt planeR i)
                def g:int (itemAt planeG i)
                def b:int (itemAt planeB i)
                def key:int (((((idiv r 8) * 32) + (idiv g 8)) * 32) + (idiv b 8))
                set cnt key ((itemAt cnt key) + 1)
                set sumR key ((itemAt sumR key) + r)
                set sumG key ((itemAt sumG key) + g)
                set sumB key ((itemAt sumB key) + b)
            }
            i = (i + 1)
        }
        i = 0
        while (i < bins) {
            def c:int (itemAt cnt i)
            if (c > 0) {
                push binR (idiv (itemAt sumR i) c)
                push binG (idiv (itemAt sumG i) c)
                push binB (idiv (itemAt sumB i) c)
                push binW c
            }
            i = (i + 1)
        }
    }

    ; ----------------------------------------------------------------------
    ; Palette: weighted k-means++ seeding + Lloyd passes over the histogram.
    ; Weighting by pixel count is what stops a handful of outlier pixels from
    ; claiming a swatch that then paints nothing — the old farthest-point seed
    ; was drawn to exactly those outliers.
    ; ----------------------------------------------------------------------

    ; Parse options.paletteHex into RGB triples, dropping anything EVGColor
    ; cannot read. Returns how many survived.
    fn parsePaletteHex:int (outR:[int] outG:[int] outB:[int]) {
        def n:int (array_length options.paletteHex)
        def i:int 0
        while (i < n) {
            def c:EVGColor (EVGColor.parse((itemAt options.paletteHex i)))
            if c.isSet {
                push outR (to_int c.r)
                push outG (to_int c.g)
                push outB (to_int c.b)
            }
            i = (i + 1)
        }
        return (array_length outR)
    }

    ; The seeding score for one histogram bin. "area" is population × distance²,
    ; which is why a photo's big flat background always takes the first swatches;
    ; the other two trade that away for colors that are merely distinct.
    fn seedScore:double (weight:int dist2:double) {
        def bias:string options.paletteBias
        if (bias == "distinct") {
            return dist2
        }
        def w:double (to_double weight)
        if (bias == "balanced") {
            return ((sqrt w) * dist2)
        }
        return (w * dist2)
    }

    ; `outR/outG/outB` may arrive holding `locked` pinned swatches; those are
    ; seeds the caller chose, so they are never moved by a Lloyd pass and never
    ; dropped by the merge.
    fn buildPalette:void (want:int locked:int outR:[int] outG:[int] outB:[int]) {
        def binR:[int]
        def binG:[int]
        def binB:[int]
        def binW:[int]
        this.buildHistogram(true binR binG binB binW)
        ; Line art can be thin enough to have no plateau at all — then let every
        ; allowed pixel vote rather than emitting nothing.
        if ((array_length binR) < 2) {
            def allR:[int]
            def allG:[int]
            def allB:[int]
            def allW:[int]
            this.buildHistogram(false allR allG allB allW)
            binR = allR
            binG = allG
            binB = allB
            binW = allW
        }
        def m:int (array_length binR)
        if (m == 0) {
            return
        }
        def lw:int (this.lumaWeight())
        ; A bin has to clear a noise floor before it can win a swatch. Only the
        ; "distinct" bias would otherwise hand one to a single stray pixel.
        def total:int 0
        def i:int 0
        while (i < m) {
            total = (total + (itemAt binW i))
            i = (i + 1)
        }
        def floorW:int (idiv total 2000)
        if (floorW < 2) {
            floorW = 2
        }
        if (locked == 0) {
            ; Seed 1: the heaviest bin.
            def bestI:int 0
            def bestW:int (itemAt binW 0)
            i = 1
            while (i < m) {
                if ((itemAt binW i) > bestW) {
                    bestW = (itemAt binW i)
                    bestI = i
                }
                i = (i + 1)
            }
            push outR (itemAt binR bestI)
            push outG (itemAt binG bestI)
            push outB (itemAt binB bestI)
        }
        ; Remaining seeds: maximize seedScore against the closest center so far.
        def dist:[double]
        i = 0
        while (i < m) {
            push dist (EvgBitmapTracer.colorDist2((itemAt binR i) (itemAt binG i) (itemAt binB i) (itemAt outR 0) (itemAt outG 0) (itemAt outB 0) lw))
            i = (i + 1)
        }
        def seeded:int 1
        while (seeded < (array_length outR)) {
            i = 0
            while (i < m) {
                def d0:double (EvgBitmapTracer.colorDist2((itemAt binR i) (itemAt binG i) (itemAt binB i) (itemAt outR seeded) (itemAt outG seeded) (itemAt outB seeded) lw))
                if (d0 < (itemAt dist i)) {
                    set dist i d0
                }
                i = (i + 1)
            }
            seeded = (seeded + 1)
        }
        while ((array_length outR) < want) {
            def pickI:int (0 - 1)
            def pickScore:double 0.0
            i = 0
            while (i < m) {
                if ((itemAt binW i) >= floorW) {
                    def score:double (this.seedScore((itemAt binW i) (itemAt dist i)))
                    if (score > pickScore) {
                        pickScore = score
                        pickI = i
                    }
                }
                i = (i + 1)
            }
            if (pickI < 0) {
                want = (array_length outR)
            } {
                def cr:int (itemAt binR pickI)
                def cg:int (itemAt binG pickI)
                def cb:int (itemAt binB pickI)
                push outR cr
                push outG cg
                push outB cb
                i = 0
                while (i < m) {
                    def d:double (EvgBitmapTracer.colorDist2((itemAt binR i) (itemAt binG i) (itemAt binB i) cr cg cb lw))
                    if (d < (itemAt dist i)) {
                        set dist i d
                    }
                    i = (i + 1)
                }
            }
        }
        ; Lloyd passes, weighted by bin population.
        def k:int (array_length outR)
        def pass:int 0
        while (pass < 12) {
            def sumR:[double]
            def sumG:[double]
            def sumB:[double]
            def wgt:[double]
            def ki:int 0
            while (ki < k) {
                push sumR 0.0
                push sumG 0.0
                push sumB 0.0
                push wgt 0.0
                ki = (ki + 1)
            }
            i = 0
            while (i < m) {
                def br:int (itemAt binR i)
                def bg:int (itemAt binG i)
                def bb:int (itemAt binB i)
                def best:int (this.nearestIndex(br bg bb outR outG outB))
                def w:double (to_double (itemAt binW i))
                set sumR best ((itemAt sumR best) + ((to_double br) * w))
                set sumG best ((itemAt sumG best) + ((to_double bg) * w))
                set sumB best ((itemAt sumB best) + ((to_double bb) * w))
                set wgt best ((itemAt wgt best) + w)
                set dist i 0.0
                i = (i + 1)
            }
            def moved:boolean false
            ki = locked
            while (ki < k) {
                def wk:double (itemAt wgt ki)
                if (wk > 0.0) {
                    def nr:int (to_int ((itemAt sumR ki) / wk))
                    def ng:int (to_int ((itemAt sumG ki) / wk))
                    def nb:int (to_int ((itemAt sumB ki) / wk))
                    if ((nr != (itemAt outR ki)) || (ng != (itemAt outG ki)) || (nb != (itemAt outB ki))) {
                        moved = true
                    }
                    set outR ki nr
                    set outG ki ng
                    set outB ki nb
                } {
                    ; An empty swatch paints nothing — move it onto the bin that
                    ; is worst served right now instead of leaving it stranded.
                    def farI:int (0 - 1)
                    def farScore:double 0.0
                    i = 0
                    while (i < m) {
                        def dd:double (EvgBitmapTracer.colorDist2((itemAt binR i) (itemAt binG i) (itemAt binB i) (itemAt outR (this.nearestIndex((itemAt binR i) (itemAt binG i) (itemAt binB i) outR outG outB))) (itemAt outG (this.nearestIndex((itemAt binR i) (itemAt binG i) (itemAt binB i) outR outG outB))) (itemAt outB (this.nearestIndex((itemAt binR i) (itemAt binG i) (itemAt binB i) outR outG outB))) lw))
                        def sc:double (dd * (to_double (itemAt binW i)))
                        if (sc > farScore) {
                            farScore = sc
                            farI = i
                        }
                        i = (i + 1)
                    }
                    if (farI >= 0) {
                        set outR ki (itemAt binR farI)
                        set outG ki (itemAt binG farI)
                        set outB ki (itemAt binB farI)
                        moved = true
                    }
                }
                ki = (ki + 1)
            }
            if (moved) {
                pass = (pass + 1)
            } {
                pass = 12
            }
        }
        ; Collapse swatches the eye cannot tell apart. Without this, asking for
        ; more colors than the image holds splits one region between two
        ; near-identical swatches and turdsize eats both halves.
        this.mergeCloseSwatches(locked outR outG outB binR binG binB binW)
        ; Sort palette dark → light (ascending luma). Masks are disjoint so
        ; paint order is mostly cosmetic; lightest ends up last.
        def k2:int (array_length outR)
        def a:int 0
        while (a < k2) {
            def bIdx:int (a + 1)
            while (bIdx < k2) {
                def la:int (EvgBitmapTracer.lumaOf((itemAt outR a) (itemAt outG a) (itemAt outB a)))
                def lb:int (EvgBitmapTracer.lumaOf((itemAt outR bIdx) (itemAt outG bIdx) (itemAt outB bIdx)))
                if (la > lb) {
                    def tr:int (itemAt outR a)
                    def tg:int (itemAt outG a)
                    def tb:int (itemAt outB a)
                    set outR a (itemAt outR bIdx)
                    set outG a (itemAt outG bIdx)
                    set outB a (itemAt outB bIdx)
                    set outR bIdx tr
                    set outG bIdx tg
                    set outB bIdx tb
                }
                bIdx = (bIdx + 1)
            }
            a = (a + 1)
        }
    }

    ; Merge palette entries closer than options.minColorDelta, keeping whichever
    ; of the pair paints more pixels. The first `locked` entries were chosen by
    ; the caller: a pair of them is left alone, and against an automatic swatch
    ; the locked one is what survives.
    fn mergeCloseSwatches:void (locked:int outR:[int] outG:[int] outB:[int] binR:[int] binG:[int] binB:[int] binW:[int]) {
        def delta:int options.minColorDelta
        if (delta <= 0) {
            return
        }
        def lw:int (this.lumaWeight())
        ; Same metric the assignment uses, scaled so `delta` still reads as a
        ; per-channel difference.
        def limit:double ((to_double (delta * delta)) * (to_double (3 + lw)))
        def merged:boolean true
        while merged {
            merged = false
            def k:int (array_length outR)
            if (k < 2) {
                return
            }
            ; Population of each swatch, so the survivor is the one that paints.
            def wgt:[int]
            def ki:int 0
            while (ki < k) {
                push wgt 0
                ki = (ki + 1)
            }
            def m:int (array_length binR)
            def i:int 0
            while (i < m) {
                def idx:int (this.nearestIndex((itemAt binR i) (itemAt binG i) (itemAt binB i) outR outG outB))
                set wgt idx ((itemAt wgt idx) + (itemAt binW i))
                i = (i + 1)
            }
            def dropAt:int (0 - 1)
            def a:int 0
            while ((a < k) && (dropAt < 0)) {
                def b:int (a + 1)
                while ((b < k) && (dropAt < 0)) {
                    def d:double (EvgBitmapTracer.colorDist2((itemAt outR a) (itemAt outG a) (itemAt outB a) (itemAt outR b) (itemAt outG b) (itemAt outB b) lw))
                    if (d <= limit) {
                        if (b < locked) {
                            ; both pinned — the caller asked for both.
                        } {
                            if (a < locked) {
                                dropAt = b
                            } {
                                if ((itemAt wgt a) >= (itemAt wgt b)) {
                                    dropAt = b
                                } {
                                    dropAt = a
                                }
                            }
                        }
                    }
                    b = (b + 1)
                }
                a = (a + 1)
            }
            if (dropAt >= 0) {
                remove outR dropAt
                remove outG dropAt
                remove outB dropAt
                merged = true
            }
        }
    }

    fn nearestIndex:int (r:int g:int b:int palR:[int] palG:[int] palB:[int]) {
        def k:int (array_length palR)
        if (k == 0) {
            return 0
        }
        def lw:int (this.lumaWeight())
        def best:int 0
        def bestD:double (EvgBitmapTracer.colorDist2(r g b (itemAt palR 0) (itemAt palG 0) (itemAt palB 0) lw))
        def j:int 1
        while (j < k) {
            def d:double (EvgBitmapTracer.colorDist2(r g b (itemAt palR j) (itemAt palG j) (itemAt palB j) lw))
            if (d < bestD) {
                bestD = d
                best = j
            }
            j = (j + 1)
        }
        return best
    }

    ; ----------------------------------------------------------------------
    ; Pixel → swatch assignment
    ; ----------------------------------------------------------------------

    ; Every allowed pixel takes its nearest swatch. A transitional pixel is
    ; then re-checked against the regions actually touching it: it only moves
    ; there when the neighbouring swatch fits about as well as the global best
    ; (snapRatio). That guard matters — the one-pixel ink core of a thin
    ; anti-aliased outline is transitional too, and an unguarded snap hands it
    ; to the big region beside it, which is what turns outlines into dashes.
    fn assignLabels:void (palR:[int] palG:[int] palB:[int]) {
        def n:int (width * height)
        def base:[int]
        def dists:[double]
        def i:int 0
        while (i < n) {
            push base (0 - 1)
            push dists 0.0
            i = (i + 1)
        }
        def lw:int (this.lumaWeight())
        i = 0
        while (i < n) {
            if (this.pixelAllowed(i)) {
                def lab:int (this.nearestIndex((itemAt planeR i) (itemAt planeG i) (itemAt planeB i) palR palG palB))
                set base i lab
                set dists i (EvgBitmapTracer.colorDist2((itemAt planeR i) (itemAt planeG i) (itemAt planeB i) (itemAt palR lab) (itemAt palG lab) (itemAt palB lab) lw))
            }
            i = (i + 1)
        }
        def outL:[int]
        i = 0
        while (i < n) {
            push outL (itemAt base i)
            i = (i + 1)
        }
        def hasFlat:boolean ((array_length flat) == n)
        if (options.edgeSnap && hasFlat) {
            def ratio:double options.snapRatio
            def y:int 0
            while (y < height) {
                def x:int 0
                while (x < width) {
                    def idx:int ((y * width) + x)
                    def gLab:int (itemAt base idx)
                    if ((gLab >= 0) && ((itemAt flat idx) == 0)) {
                        def gD:double (itemAt dists idx)
                        def pr:int (itemAt planeR idx)
                        def pg:int (itemAt planeG idx)
                        def pb:int (itemAt planeB idx)
                        def nLab:int (0 - 1)
                        def nD:double 0.0
                        def dy:int (0 - 1)
                        while (dy <= 1) {
                            def yy:int (y + dy)
                            if ((yy >= 0) && (yy < height)) {
                                def dx:int (0 - 1)
                                while (dx <= 1) {
                                    def xx:int (x + dx)
                                    if ((xx >= 0) && (xx < width)) {
                                        def nIdx:int ((yy * width) + xx)
                                        if ((itemAt flat nIdx) == 1) {
                                            def lab2:int (itemAt base nIdx)
                                            if (lab2 >= 0) {
                                                def d:double (EvgBitmapTracer.colorDist2(pr pg pb (itemAt palR lab2) (itemAt palG lab2) (itemAt palB lab2) lw))
                                                if ((nLab < 0) || (d < nD)) {
                                                    nLab = lab2
                                                    nD = d
                                                }
                                            }
                                        }
                                    }
                                    dx = (dx + 1)
                                }
                            }
                            dy = (dy + 1)
                        }
                        if ((nLab >= 0) && (nLab != gLab)) {
                            if (nD <= ((gD * ratio) + 1.0)) {
                                set outL idx nLab
                            }
                        }
                    }
                    x = (x + 1)
                }
                y = (y + 1)
            }
        }
        labels = outL
        this.despeckleLabels()
        this.smoothContours(palR palG palB)
        this.mergeTinyRegions((array_length palR))
    }

    ; ----------------------------------------------------------------------
    ; Banding suppression (options.contourMode)
    ; ----------------------------------------------------------------------

    ; One step of the continuity walk. A neighbour joins when the step to it is
    ; small enough to read as continuous AND it has not drifted too far from
    ; what the region has averaged so far — the second test is what stops a
    ; gradient from walking off across the whole picture.
    fn contourStep:void (i:int from:int seen:[int] stack:[int] acc:[int] edgeTol:int spread:int) {
        if ((itemAt seen i) != 0) {
            return
        }
        if ((itemAt labels i) < 0) {
            return
        }
        if ((this.pixelDelta(from i)) > edgeTol) {
            return
        }
        def cnt:int (itemAt acc 3)
        if (cnt > 0) {
            def mr:int (idiv (itemAt acc 0) cnt)
            def mg:int (idiv (itemAt acc 1) cnt)
            def mb:int (idiv (itemAt acc 2) cnt)
            def d:int (EvgBitmapTracer.absI((itemAt planeR i) - mr))
            def dg:int (EvgBitmapTracer.absI((itemAt planeG i) - mg))
            if (dg > d) {
                d = dg
            }
            def db:int (EvgBitmapTracer.absI((itemAt planeB i) - mb))
            if (db > d) {
                d = db
            }
            if (d > spread) {
                return
            }
        }
        set seen i 1
        push stack i
        set acc 0 ((itemAt acc 0) + (itemAt planeR i))
        set acc 1 ((itemAt acc 1) + (itemAt planeG i))
        set acc 2 ((itemAt acc 2) + (itemAt planeB i))
        set acc 3 (cnt + 1)
    }

    ; Grow every allowed pixel into a region of continuous color and record
    ; which region it landed in. Both the banding fix and the gradient fills
    ; read this; it is the segmentation, and everything downstream is a choice
    ; of what to paint each region with.
    fn buildContourRegions:void () {
        def edgeTol:int options.contourEdge
        if (edgeTol < 1) {
            edgeTol = 1
        }
        def spread:int options.contourSpread
        if (spread < 1) {
            spread = 1
        }
        def n:int (width * height)
        def ro:[int]
        def seen:[int]
        def i:int 0
        while (i < n) {
            push ro (0 - 1)
            push seen 0
            i = (i + 1)
        }
        def rid:int 0
        def start:int 0
        while (start < n) {
            if (((itemAt seen start) == 0) && ((itemAt labels start) >= 0)) {
                def stack:[int]
                def acc:[int]
                push acc (itemAt planeR start)
                push acc (itemAt planeG start)
                push acc (itemAt planeB start)
                push acc 1
                set seen start 1
                push stack start
                def head:int 0
                while (head < (array_length stack)) {
                    def cur:int (itemAt stack head)
                    head = (head + 1)
                    set ro cur rid
                    def cy:int (idiv cur width)
                    def cx:int (cur - (cy * width))
                    if (cx > 0) {
                        this.contourStep((cur - 1) cur seen stack acc edgeTol spread)
                    }
                    if (cx < (width - 1)) {
                        this.contourStep((cur + 1) cur seen stack acc edgeTol spread)
                    }
                    if (cy > 0) {
                        this.contourStep((cur - width) cur seen stack acc edgeTol spread)
                    }
                    if (cy < (height - 1)) {
                        this.contourStep((cur + width) cur seen stack acc edgeTol spread)
                    }
                }
                rid = (rid + 1)
            }
            start = (start + 1)
        }
        regionOf = ro
        regionCount = rid
    }

    ; Give each continuity region the one swatch nearest its own mean, so a
    ; ramp stops being cut into bands.
    fn smoothContours:void (palR:[int] palG:[int] palB:[int]) {
        if ((options.contourMode) != "smooth") {
            return
        }
        this.buildContourRegions()
        def k:int regionCount
        if (k == 0) {
            return
        }
        def sumR:[int]
        def sumG:[int]
        def sumB:[int]
        def cnt:[int]
        def i:int 0
        while (i < k) {
            push sumR 0
            push sumG 0
            push sumB 0
            push cnt 0
            i = (i + 1)
        }
        def n:int (width * height)
        i = 0
        while (i < n) {
            def r:int (itemAt regionOf i)
            if (r >= 0) {
                set sumR r ((itemAt sumR r) + (itemAt planeR i))
                set sumG r ((itemAt sumG r) + (itemAt planeG i))
                set sumB r ((itemAt sumB r) + (itemAt planeB i))
                set cnt r ((itemAt cnt r) + 1)
            }
            i = (i + 1)
        }
        def lab:[int]
        i = 0
        while (i < k) {
            def c:int (itemAt cnt i)
            if (c > 0) {
                push lab (this.nearestIndex((idiv (itemAt sumR i) c) (idiv (itemAt sumG i) c) (idiv (itemAt sumB i) c) palR palG palB))
            } {
                push lab 0
            }
            i = (i + 1)
        }
        i = 0
        while (i < n) {
            def r2:int (itemAt regionOf i)
            if (r2 >= 0) {
                set labels i (itemAt lab r2)
            }
            i = (i + 1)
        }
    }

    ; ----------------------------------------------------------------------
    ; Gradient fills (options.gradientFill)
    ;
    ; Each continuity region is fitted with three models — one flat color, a
    ; linear ramp and a radial one — and keeps whichever leaves the least
    ; error. Neither wins everywhere: a sky is linear, and a tube lit down its
    ; middle is radial and comes out badly wrong as a linear ramp.
    ; ----------------------------------------------------------------------

    sfn clamp255:int (v:double) {
        if (v < 0.0) {
            return 0
        }
        if (v > 255.0) {
            return 255
        }
        return (to_int v)
    }

    ; Merge any region below minPx into whichever neighbour it shares the most
    ; boundary with, then renumber what is left from zero.
    fn absorbTinyRegions:void (minPx:int) {
        def k:int regionCount
        if (k == 0) {
            return
        }
        def n:int (width * height)
        def size:[int]
        def i:int 0
        while (i < k) {
            push size 0
            i = (i + 1)
        }
        i = 0
        while (i < n) {
            def r:int (itemAt regionOf i)
            if (r >= 0) {
                set size r ((itemAt size r) + 1)
            }
            i = (i + 1)
        }
        ; One pass: every small region takes the neighbour it touches most.
        def target:[int]
        i = 0
        while (i < k) {
            push target i
            i = (i + 1)
        }
        def bestN:[int]
        def bestR:[int]
        i = 0
        while (i < k) {
            push bestN 0
            push bestR (0 - 1)
            i = (i + 1)
        }
        def y:int 0
        while (y < height) {
            def x:int 0
            while (x < width) {
                def idx:int ((y * width) + x)
                def r0:int (itemAt regionOf idx)
                if ((r0 >= 0) && ((itemAt size r0) < minPx)) {
                    if (x < (width - 1)) {
                        this.tallyNeighbour(r0 (itemAt regionOf (idx + 1)) size minPx bestN bestR)
                    }
                    if (x > 0) {
                        this.tallyNeighbour(r0 (itemAt regionOf (idx - 1)) size minPx bestN bestR)
                    }
                    if (y < (height - 1)) {
                        this.tallyNeighbour(r0 (itemAt regionOf (idx + width)) size minPx bestN bestR)
                    }
                    if (y > 0) {
                        this.tallyNeighbour(r0 (itemAt regionOf (idx - width)) size minPx bestN bestR)
                    }
                }
                x = (x + 1)
            }
            y = (y + 1)
        }
        i = 0
        while (i < k) {
            if ((itemAt bestR i) >= 0) {
                set target i (itemAt bestR i)
            }
            i = (i + 1)
        }
        ; Renumber: only regions that still hold pixels get an id.
        def remap:[int]
        i = 0
        while (i < k) {
            push remap (0 - 1)
            i = (i + 1)
        }
        def next:int 0
        i = 0
        while (i < n) {
            def r2:int (itemAt regionOf i)
            if (r2 >= 0) {
                def t:int (itemAt target r2)
                if ((itemAt remap t) < 0) {
                    set remap t next
                    next = (next + 1)
                }
                set regionOf i (itemAt remap t)
            }
            i = (i + 1)
        }
        regionCount = next
    }

    ; The biggest neighbour wins. Requiring it to clear minPx would strand a
    ; chain of small regions that only ever touch each other — which is most of
    ; a photograph — so any different neighbour will do, and repeated passes
    ; then cascade the small ones into the large.
    fn tallyNeighbour:void (mine:int other:int size:[int] minPx:int bestN:[int] bestR:[int]) {
        if (other < 0) {
            return
        }
        if (other == mine) {
            return
        }
        def sz:int (itemAt size other)
        if ((itemAt bestR mine) < 0) {
            set bestR mine other
            set bestN mine sz
            return
        }
        if (sz > (itemAt bestN mine)) {
            set bestR mine other
            set bestN mine sz
        }
    }

    ; Least squares for  v = a + b·x + c·y  over one region, by Cramer's rule
    ; on the normal equations. out = [ok, a, b, c].
    sfn solveLinear:void (n:double sx:double sy:double sxx:double sxy:double syy:double v0:double v1:double v2:double out:[double]) {
        def det:double (((n * ((sxx * syy) - (sxy * sxy))) - (sx * ((sx * syy) - (sxy * sy)))) + (sy * ((sx * sxy) - (sxx * sy))))
        if ((EvgBitmapTracer.absD(det)) < 0.000001) {
            set out 0 0.0
            return
        }
        def da:double (((v0 * ((sxx * syy) - (sxy * sxy))) - (sx * ((v1 * syy) - (sxy * v2)))) + (sy * ((v1 * sxy) - (sxx * v2))))
        def db:double (((n * ((v1 * syy) - (v2 * sxy))) - (v0 * ((sx * syy) - (sxy * sy)))) + (sy * ((sx * v2) - (v1 * sy))))
        def dc:double (((n * ((sxx * v2) - (sxy * v1))) - (sx * ((sx * v2) - (v1 * sy)))) + (v0 * ((sx * sxy) - (sxx * sy))))
        set out 0 1.0
        set out 1 (da / det)
        set out 2 (db / det)
        set out 3 (dc / det)
    }

    fn hexOf:string (r:double g:double b:double) {
        return (this.hexFromRgb((EvgBitmapTracer.clamp255(r)) (EvgBitmapTracer.clamp255(g)) (EvgBitmapTracer.clamp255(b))))
    }

    ; One layer per continuity region, filled with whichever of flat / linear /
    ; radial explains it best. Regions are painted largest first and each mask
    ; is grown by a pixel, so the smaller shape laid on top covers the join —
    ; the same reason the swatch layers are stacked rather than butted together.
    fn traceGradientRegions:void () {
        this.buildContourRegions()
        def floorPx:int options.minRegion
        if (floorPx < 8) {
            floorPx = 8
        }
        this.absorbTinyRegions(floorPx)
        ; A photograph can segment into tens of thousands of scraps; each one
        ; would be its own traced path. Raise the floor until that is sane.
        def guard:int 0
        while ((regionCount > 2000) && (guard < 8)) {
            floorPx = (floorPx * 2)
            this.absorbTinyRegions(floorPx)
            guard = (guard + 1)
        }
        def k:int regionCount
        if (k == 0) {
            return
        }
        def n:int (width * height)
        ; --- pass 1: geometry and the linear normal equations ---
        def rn:[double]
        def rsx:[double]
        def rsy:[double]
        def rsxx:[double]
        def rsyy:[double]
        def rsxy:[double]
        def sv:[double]
        def sxv:[double]
        def syv:[double]
        def svv:[double]
        def i:int 0
        while (i < k) {
            push rn 0.0
            push rsx 0.0
            push rsy 0.0
            push rsxx 0.0
            push rsyy 0.0
            push rsxy 0.0
            def c:int 0
            while (c < 3) {
                push sv 0.0
                push sxv 0.0
                push syv 0.0
                push svv 0.0
                c = (c + 1)
            }
            i = (i + 1)
        }
        def y:int 0
        while (y < height) {
            def x:int 0
            while (x < width) {
                def idx:int ((y * width) + x)
                def r:int (itemAt regionOf idx)
                if (r >= 0) {
                    def dx:double (to_double x)
                    def dy:double (to_double y)
                    set rn r ((itemAt rn r) + 1.0)
                    set rsx r ((itemAt rsx r) + dx)
                    set rsy r ((itemAt rsy r) + dy)
                    set rsxx r ((itemAt rsxx r) + (dx * dx))
                    set rsyy r ((itemAt rsyy r) + (dy * dy))
                    set rsxy r ((itemAt rsxy r) + (dx * dy))
                    def c2:int 0
                    while (c2 < 3) {
                        def v:double (to_double (this.planeAt(c2 idx)))
                        def j:int ((r * 3) + c2)
                        set sv j ((itemAt sv j) + v)
                        set sxv j ((itemAt sxv j) + (dx * v))
                        set syv j ((itemAt syv j) + (dy * v))
                        set svv j ((itemAt svv j) + (v * v))
                        c2 = (c2 + 1)
                    }
                }
                x = (x + 1)
            }
            y = (y + 1)
        }
        ; --- solve the linear model, per region per channel ---
        def la:[double]
        def lb:[double]
        def lc:[double]
        def lok:[double]
        i = 0
        while (i < k) {
            def sol:[double]
            push sol 0.0
            push sol 0.0
            push sol 0.0
            push sol 0.0
            def okAll:double 1.0
            def c3:int 0
            while (c3 < 3) {
                def j2:int ((i * 3) + c3)
                EvgBitmapTracer.solveLinear((itemAt rn i) (itemAt rsx i) (itemAt rsy i) (itemAt rsxx i) (itemAt rsxy i) (itemAt rsyy i) (itemAt sv j2) (itemAt sxv j2) (itemAt syv j2) sol)
                if ((itemAt sol 0) < 0.5) {
                    okAll = 0.0
                }
                push la (itemAt sol 1)
                push lb (itemAt sol 2)
                push lc (itemAt sol 3)
                c3 = (c3 + 1)
            }
            push lok okAll
            i = (i + 1)
        }
        ; --- pass 2: radial sums and the extents, both centroid-based ---
        def rsd:[double]
        def rsdd:[double]
        def rsdv:[double]
        def tmin:[double]
        def tmax:[double]
        def dmax:[double]
        def ux:[double]
        def uy:[double]
        i = 0
        while (i < k) {
            push rsd 0.0
            push rsdd 0.0
            push tmin 1000000.0
            push tmax (0.0 - 1000000.0)
            push dmax 0.0
            def c4:int 0
            while (c4 < 3) {
                push rsdv 0.0
                c4 = (c4 + 1)
            }
            ; The gradient's direction is the one luma runs along — the three
            ; channels each have their own slope, but the SVG has one axis.
            def bl:double (((0.299 * (itemAt lb ((i * 3) + 0))) + (0.587 * (itemAt lb ((i * 3) + 1)))) + (0.114 * (itemAt lb ((i * 3) + 2))))
            def cl:double (((0.299 * (itemAt lc ((i * 3) + 0))) + (0.587 * (itemAt lc ((i * 3) + 1)))) + (0.114 * (itemAt lc ((i * 3) + 2))))
            def mag:double (sqrt ((bl * bl) + (cl * cl)))
            if (mag < 0.000001) {
                push ux 1.0
                push uy 0.0
            } {
                push ux (bl / mag)
                push uy (cl / mag)
            }
            i = (i + 1)
        }
        y = 0
        while (y < height) {
            def x2:int 0
            while (x2 < width) {
                def idx2:int ((y * width) + x2)
                def r2:int (itemAt regionOf idx2)
                if (r2 >= 0) {
                    def cnt:double (itemAt rn r2)
                    def mx:double ((itemAt rsx r2) / cnt)
                    def my:double ((itemAt rsy r2) / cnt)
                    def ddx:double ((to_double x2) - mx)
                    def ddy:double ((to_double y) - my)
                    def dist:double (sqrt ((ddx * ddx) + (ddy * ddy)))
                    set rsd r2 ((itemAt rsd r2) + dist)
                    set rsdd r2 ((itemAt rsdd r2) + (dist * dist))
                    if (dist > (itemAt dmax r2)) {
                        set dmax r2 dist
                    }
                    def tproj:double ((ddx * (itemAt ux r2)) + (ddy * (itemAt uy r2)))
                    if (tproj < (itemAt tmin r2)) {
                        set tmin r2 tproj
                    }
                    if (tproj > (itemAt tmax r2)) {
                        set tmax r2 tproj
                    }
                    def c5:int 0
                    while (c5 < 3) {
                        def j3:int ((r2 * 3) + c5)
                        set rsdv j3 ((itemAt rsdv j3) + (dist * (to_double (this.planeAt(c5 idx2)))))
                        c5 = (c5 + 1)
                    }
                }
                x2 = (x2 + 1)
            }
            y = (y + 1)
        }
        this.emitRegionLayers(k rn rsx rsy sv svv sxv syv la lb lc lok rsd rsdd rsdv tmin tmax dmax ux uy)
    }

    fn planeAt:int (c:int i:int) {
        if (c == 0) {
            return (itemAt planeR i)
        }
        if (c == 1) {
            return (itemAt planeG i)
        }
        return (itemAt planeB i)
    }

    ; Pick the model for each region and trace it. Sum of squared error comes
    ; straight out of the sums already gathered, so choosing costs no extra
    ; pass over the pixels.
    fn emitRegionLayers:void (k:int rn:[double] rsx:[double] rsy:[double] sv:[double] svv:[double] sxv:[double] syv:[double] la:[double] lb:[double] lc:[double] lok:[double] rsd:[double] rsdd:[double] rsdv:[double] tmin:[double] tmax:[double] dmax:[double] ux:[double] uy:[double]) {
        ; Largest region first: a smaller shape drawn later covers the join.
        def order:[int]
        def i:int 0
        while (i < k) {
            push order i
            i = (i + 1)
        }
        def a:int 0
        while (a < k) {
            def b:int (a + 1)
            while (b < k) {
                if ((itemAt rn (itemAt order b)) > (itemAt rn (itemAt order a))) {
                    def tmp:int (itemAt order a)
                    set order a (itemAt order b)
                    set order b tmp
                }
                b = (b + 1)
            }
            a = (a + 1)
        }
        def gain:double ((to_double options.gradientGain) / 100.0)
        def allCmds:[PathCommand]
        def oi:int 0
        while (oi < k) {
            def r:int (itemAt order oi)
            def cnt:double (itemAt rn r)
            if (cnt > 0.0) {
                def mx:double ((itemAt rsx r) / cnt)
                def my:double ((itemAt rsy r) / cnt)
                ; --- error of each model, summed over the three channels ---
                def eFlat:double 0.0
                def eLin:double 0.0
                def eRad:double 0.0
                def ra:[double]
                def rb:[double]
                def c:int 0
                while (c < 3) {
                    def j:int ((r * 3) + c)
                    def n2:double cnt
                    def s1:double (itemAt sv j)
                    eFlat = (eFlat + ((itemAt svv j) - ((s1 * s1) / n2)))
                    if ((itemAt lok r) > 0.5) {
                        eLin = (eLin + ((itemAt svv j) - ((((itemAt la j) * s1) + ((itemAt lb j) * (itemAt sxv j))) + ((itemAt lc j) * (itemAt syv j)))))
                    } {
                        eLin = (eLin + 1000000000.0)
                    }
                    def den:double ((n2 * (itemAt rsdd r)) - ((itemAt rsd r) * (itemAt rsd r)))
                    if ((EvgBitmapTracer.absD(den)) > 0.000001) {
                        def bb:double (((n2 * (itemAt rsdv j)) - ((itemAt rsd r) * s1)) / den)
                        def aa:double ((s1 - (bb * (itemAt rsd r))) / n2)
                        push ra aa
                        push rb bb
                        eRad = (eRad + ((itemAt svv j) - ((aa * s1) + (bb * (itemAt rsdv j)))))
                    } {
                        push ra 0.0
                        push rb 0.0
                        eRad = (eRad + 1000000000.0)
                    }
                    c = (c + 1)
                }
                if (eFlat < 0.0) {
                    eFlat = 0.0
                }
                ; A thin or tiny region gives an ill-conditioned fit: the normal
                ; equations are near-singular along the missing direction and
                ; Cramer's rule answers with wild coefficients whose residual
                ; looks excellent and whose stop colors are nonsense. Below a
                ; useful size, and whenever the arithmetic returns something a
                ; sum of squares cannot be, stay flat.
                if (cnt < 64.0) {
                    eLin = 1000000000.0
                    eRad = 1000000000.0
                }
                if (eLin < 0.0) {
                    eLin = 1000000000.0
                }
                if (eRad < 0.0) {
                    eRad = 1000000000.0
                }
                ; --- choose ---
                def kind:string "flat"
                def best:double eFlat
                if (eLin < best) {
                    best = eLin
                    kind = "linear"
                }
                if (eRad < best) {
                    best = eRad
                    kind = "radial"
                }
                ; A gradient has to earn its place: a nearly flat region stays
                ; flat. Both tests are needed — the relative one alone lets a
                ; perfectly even region through, because zero is not 15% worse
                ; than zero, and it would emit a gradient with two equal stops.
                if (kind != "flat") {
                    if ((eFlat - best) < (eFlat * gain)) {
                        kind = "flat"
                    }
                    if (eFlat < (cnt * 3.0)) {
                        kind = "flat"
                    }
                }
                def mask:EvgBinaryBitmap (this.maskForRegion(r))
                def layerOpts:EvgTraceOptions (EvgTraceOptions.defaults())
                layerOpts.turdsize = options.turdsize
                layerOpts.alphamax = options.alphamax
                layerOpts.turnpolicy = options.turnpolicy
                layerOpts.optcurve = options.optcurve
                layerOpts.opttolerance = options.opttolerance
                def sub:EvgBitmapTracer (EvgBitmapTracer.fromBinary(mask layerOpts))
                sub.trace()
                if ((sub.ringCount()) > 0) {
                    def layer:EvgTraceLayer (itemAt sub.layers 0)
                    def meanR:double ((itemAt sv ((r * 3) + 0)) / cnt)
                    def meanG:double ((itemAt sv ((r * 3) + 1)) / cnt)
                    def meanB:double ((itemAt sv ((r * 3) + 2)) / cnt)
                    layer.fillHex = (this.hexOf(meanR meanG meanB))
                    layer.fillKind = kind
                    if (kind == "linear") {
                        def t0:double (itemAt tmin r)
                        def t1:double (itemAt tmax r)
                        ; A region with no extent along its own gradient axis
                        ; would emit a zero-length linearGradient, which SVG
                        ; leaves undefined — and an axis a pixel or two long is
                        ; a flat color written the long way. One says it better.
                        if ((t1 - t0) < 2.0) {
                            kind = "flat"
                            layer.fillKind = "flat"
                        }
                        layer.gx0 = (mx + ((itemAt ux r) * t0))
                        layer.gy0 = (my + ((itemAt uy r) * t0))
                        layer.gx1 = (mx + ((itemAt ux r) * t1))
                        layer.gy1 = (my + ((itemAt uy r) * t1))
                        layer.stopA = (this.hexOf((this.linAt(la lb lc r 0 layer.gx0 layer.gy0)) (this.linAt(la lb lc r 1 layer.gx0 layer.gy0)) (this.linAt(la lb lc r 2 layer.gx0 layer.gy0))))
                        layer.stopB = (this.hexOf((this.linAt(la lb lc r 0 layer.gx1 layer.gy1)) (this.linAt(la lb lc r 1 layer.gx1 layer.gy1)) (this.linAt(la lb lc r 2 layer.gx1 layer.gy1))))
                    }
                    if (kind == "radial") {
                        if ((itemAt dmax r) < 2.0) {
                            kind = "flat"
                            layer.fillKind = "flat"
                        }
                        layer.gx0 = mx
                        layer.gy0 = my
                        layer.gr = (itemAt dmax r)
                        layer.stopA = (this.hexOf((itemAt ra 0) (itemAt ra 1) (itemAt ra 2)))
                        layer.stopB = (this.hexOf(((itemAt ra 0) + ((itemAt rb 0) * layer.gr)) ((itemAt ra 1) + ((itemAt rb 1) * layer.gr)) ((itemAt ra 2) + ((itemAt rb 2) * layer.gr))))
                    }
                    push layers layer
                    def cmds:[PathCommand] (sub.getCommands())
                    def ci:int 0
                    while (ci < (array_length cmds)) {
                        push allCmds (itemAt cmds ci)
                        ci = (ci + 1)
                    }
                    pathData = layer.pathData
                    rings = sub.rings
                }
            }
            oi = (oi + 1)
        }
        commands = allCmds
        if ((array_length layers) > 0) {
            def first:EvgTraceLayer (itemAt layers 0)
            pathData = first.pathData
        }
    }

    fn linAt:double (la:[double] lb:[double] lc:[double] r:int c:int x:double y:double) {
        def j:int ((r * 3) + c)
        return (((itemAt la j) + ((itemAt lb j) * x)) + ((itemAt lc j) * y))
    }

    ; The region's own pixels, grown by one so the neighbour drawn on top of it
    ; has something to cover rather than the page.
    fn maskForRegion:EvgBinaryBitmap (rid:int) {
        def bm:EvgBinaryBitmap (EvgBinaryBitmap.create(width height))
        def n:int (width * height)
        def i:int 0
        while (i < n) {
            if ((itemAt regionOf i) == rid) {
                def y:int (idiv i width)
                def x:int (i - (y * width))
                bm.setBit(x y true)
                if (x > 0) {
                    bm.setBit((x - 1) y true)
                }
                if (x < (width - 1)) {
                    bm.setBit((x + 1) y true)
                }
                if (y > 0) {
                    bm.setBit(x (y - 1) true)
                }
                if (y < (height - 1)) {
                    bm.setBit(x (y + 1) true)
                }
            }
            i = (i + 1)
        }
        return bm
    }

    ; ----------------------------------------------------------------------
    ; Overlay shapes (contourMode "overlay")
    ;
    ; The partition's weakness is that one weak pixel on a boundary lets the
    ; flood through, and the shape behind it is gone for good. Stacking removes
    ; the consequence rather than the cause: the surface below keeps whatever it
    ; took, and the shape it swallowed is drawn again on top of it.
    ; ----------------------------------------------------------------------

    ; Is this pixel already covered by something it would not be told apart
    ; from? Then an overlay has no reason to reach it.
    fn coveredAlready:boolean (i:int paintR:[int] paintG:[int] paintB:[int] painted:[int] tol:int) {
        if ((itemAt painted i) == 0) {
            return false
        }
        def d:int (EvgBitmapTracer.absI((itemAt planeR i) - (itemAt paintR i)))
        def dg:int (EvgBitmapTracer.absI((itemAt planeG i) - (itemAt paintG i)))
        if (dg > d) {
            d = dg
        }
        def db:int (EvgBitmapTracer.absI((itemAt planeB i) - (itemAt paintB i)))
        if (db > d) {
            d = db
        }
        return (d <= tol)
    }

    ; Fit one shape's pixel list with flat / linear / radial, describe the
    ; winner on the layer, and write what the model *predicts* into the paint
    ; map. That last part is the whole reason the two features belong together:
    ; the similarity stop asks "does an overlay show against what is under it",
    ; and against a flat mean the answer is yes everywhere a ramp leaves the
    ; mean — so every gradient shatters into bands. Against the model, it is
    ; only yes where the model is actually wrong.
    fn fitAndPaintShape:void (comp:[int] layer:EvgTraceLayer paintR:[int] paintG:[int] paintB:[int]) {
        def n:int (array_length comp)
        if (n == 0) {
            return
        }
        def cnt:double (to_double n)
        def sx:double 0.0
        def sy:double 0.0
        def sxx:double 0.0
        def syy:double 0.0
        def sxy:double 0.0
        def sv:[double]
        def sxv:[double]
        def syv:[double]
        def svv:[double]
        def c:int 0
        while (c < 3) {
            push sv 0.0
            push sxv 0.0
            push syv 0.0
            push svv 0.0
            c = (c + 1)
        }
        def i:int 0
        while (i < n) {
            def idx:int (itemAt comp i)
            def yy:int (idiv idx width)
            def dx:double (to_double (idx - (yy * width)))
            def dy:double (to_double yy)
            sx = (sx + dx)
            sy = (sy + dy)
            sxx = (sxx + (dx * dx))
            syy = (syy + (dy * dy))
            sxy = (sxy + (dx * dy))
            c = 0
            while (c < 3) {
                def v:double (to_double (this.planeAt(c idx)))
                set sv c ((itemAt sv c) + v)
                set sxv c ((itemAt sxv c) + (dx * v))
                set syv c ((itemAt syv c) + (dy * v))
                set svv c ((itemAt svv c) + (v * v))
                c = (c + 1)
            }
            i = (i + 1)
        }
        def mx:double (sx / cnt)
        def my:double (sy / cnt)
        ; Radial sums need the centroid, so they take a second look at the list.
        def sd:double 0.0
        def sdd:double 0.0
        def sdv:[double]
        def dmax:double 0.0
        def ci:int 0
        while (ci < 3) {
            push sdv 0.0
            ci = (ci + 1)
        }
        i = 0
        while (i < n) {
            def q:int (itemAt comp i)
            def qy:int (idiv q width)
            def ddx:double ((to_double (q - (qy * width))) - mx)
            def ddy:double ((to_double qy) - my)
            def dist:double (sqrt ((ddx * ddx) + (ddy * ddy)))
            sd = (sd + dist)
            sdd = (sdd + (dist * dist))
            if (dist > dmax) {
                dmax = dist
            }
            ci = 0
            while (ci < 3) {
                set sdv ci ((itemAt sdv ci) + (dist * (to_double (this.planeAt(ci q)))))
                ci = (ci + 1)
            }
            i = (i + 1)
        }
        def la:[double]
        def lb:[double]
        def lc:[double]
        def ra:[double]
        def rb:[double]
        def eFlat:double 0.0
        def eLin:double 0.0
        def eRad:double 0.0
        def rden:double ((cnt * sdd) - (sd * sd))
        def sol:[double]
        push sol 0.0
        push sol 0.0
        push sol 0.0
        push sol 0.0
        c = 0
        while (c < 3) {
            def s1:double (itemAt sv c)
            eFlat = (eFlat + ((itemAt svv c) - ((s1 * s1) / cnt)))
            EvgBitmapTracer.solveLinear(cnt sx sy sxx sxy syy s1 (itemAt sxv c) (itemAt syv c) sol)
            if ((itemAt sol 0) > 0.5) {
                push la (itemAt sol 1)
                push lb (itemAt sol 2)
                push lc (itemAt sol 3)
                eLin = (eLin + ((itemAt svv c) - ((((itemAt sol 1) * s1) + ((itemAt sol 2) * (itemAt sxv c))) + ((itemAt sol 3) * (itemAt syv c)))))
            } {
                push la (s1 / cnt)
                push lb 0.0
                push lc 0.0
                eLin = (eLin + 1000000000.0)
            }
            if ((EvgBitmapTracer.absD(rden)) > 0.000001) {
                def bb:double (((cnt * (itemAt sdv c)) - (sd * s1)) / rden)
                def aa:double ((s1 - (bb * sd)) / cnt)
                push ra aa
                push rb bb
                eRad = (eRad + ((itemAt svv c) - ((aa * s1) + (bb * (itemAt sdv c)))))
            } {
                push ra (s1 / cnt)
                push rb 0.0
                eRad = (eRad + 1000000000.0)
            }
            c = (c + 1)
        }
        if (eFlat < 0.0) {
            eFlat = 0.0
        }
        if ((eLin < 0.0) || (cnt < 64.0)) {
            eLin = 1000000000.0
        }
        if ((eRad < 0.0) || (cnt < 64.0) || (dmax < 2.0)) {
            eRad = 1000000000.0
        }
        def gain:double ((to_double options.gradientGain) / 100.0)
        def best:double eFlat
        def useLin:boolean false
        def useRad:boolean false
        if (eLin < best) {
            best = eLin
            useLin = true
            useRad = false
        }
        ; Radial only when it is decisively better, not merely better.
        def caution:double (to_double options.radialCaution)
        if (caution < 1.0) {
            caution = 1.0
        }
        if (eRad < (best - ((best * gain) * caution))) {
            best = eRad
            useRad = true
            useLin = false
        }
        if ((eFlat - best) < (eFlat * gain)) {
            useLin = false
            useRad = false
        }
        if (eFlat < (cnt * 3.0)) {
            useLin = false
            useRad = false
        }
        def mR:int (EvgBitmapTracer.clamp255((itemAt sv 0) / cnt))
        def mG:int (EvgBitmapTracer.clamp255((itemAt sv 1) / cnt))
        def mB:int (EvgBitmapTracer.clamp255((itemAt sv 2) / cnt))
        layer.fillHex = (this.hexFromRgb(mR mG mB))
        if (useRad) {
            layer.fillKind = "radial"
            layer.gx0 = mx
            layer.gy0 = my
            layer.gr = dmax
            layer.stopA = (this.hexOf((itemAt ra 0) (itemAt ra 1) (itemAt ra 2)))
            layer.stopB = (this.hexOf(((itemAt ra 0) + ((itemAt rb 0) * dmax)) ((itemAt ra 1) + ((itemAt rb 1) * dmax)) ((itemAt ra 2) + ((itemAt rb 2) * dmax))))
            i = 0
            while (i < n) {
                def p3:int (itemAt comp i)
                def y3:int (idiv p3 width)
                def ex:double ((to_double (p3 - (y3 * width))) - mx)
                def ey:double ((to_double y3) - my)
                def dd:double (sqrt ((ex * ex) + (ey * ey)))
                set paintR p3 (EvgBitmapTracer.clamp255((itemAt ra 0) + ((itemAt rb 0) * dd)))
                set paintG p3 (EvgBitmapTracer.clamp255((itemAt ra 1) + ((itemAt rb 1) * dd)))
                set paintB p3 (EvgBitmapTracer.clamp255((itemAt ra 2) + ((itemAt rb 2) * dd)))
                i = (i + 1)
            }
            return
        }
        if (useLin == false) {
            layer.fillKind = "flat"
            i = 0
            while (i < n) {
                def p0:int (itemAt comp i)
                set paintR p0 mR
                set paintG p0 mG
                set paintB p0 mB
                i = (i + 1)
            }
            return
        }
        ; The axis is the direction luma runs along; the extent comes from the
        ; shape's own pixels projected onto it.
        def bl:double (((0.299 * (itemAt lb 0)) + (0.587 * (itemAt lb 1))) + (0.114 * (itemAt lb 2)))
        def cl:double (((0.299 * (itemAt lc 0)) + (0.587 * (itemAt lc 1))) + (0.114 * (itemAt lc 2)))
        def mag:double (sqrt ((bl * bl) + (cl * cl)))
        def ux:double 1.0
        def uy:double 0.0
        if (mag > 0.000001) {
            ux = (bl / mag)
            uy = (cl / mag)
        }
        def tmin:double 1000000.0
        def tmax:double (0.0 - 1000000.0)
        i = 0
        while (i < n) {
            def p1:int (itemAt comp i)
            def y1:int (idiv p1 width)
            def t:double ((((to_double (p1 - (y1 * width))) - mx) * ux) + (((to_double y1) - my) * uy))
            if (t < tmin) {
                tmin = t
            }
            if (t > tmax) {
                tmax = t
            }
            ; Paint the prediction, clamped, so the similarity test below sees
            ; the ramp this shape actually describes.
            set paintR p1 (EvgBitmapTracer.clamp255((this.linAt(la lb lc 0 0 (to_double (p1 - (y1 * width))) (to_double y1))))) 
            set paintG p1 (EvgBitmapTracer.clamp255((this.linAt(la lb lc 0 1 (to_double (p1 - (y1 * width))) (to_double y1)))))
            set paintB p1 (EvgBitmapTracer.clamp255((this.linAt(la lb lc 0 2 (to_double (p1 - (y1 * width))) (to_double y1)))))
            i = (i + 1)
        }
        if ((tmax - tmin) < 2.0) {
            layer.fillKind = "flat"
            return
        }
        layer.fillKind = "linear"
        layer.gx0 = (mx + (ux * tmin))
        layer.gy0 = (my + (uy * tmin))
        layer.gx1 = (mx + (ux * tmax))
        layer.gy1 = (my + (uy * tmax))
        layer.stopA = (this.hexOf((this.linAt(la lb lc 0 0 layer.gx0 layer.gy0)) (this.linAt(la lb lc 0 1 layer.gx0 layer.gy0)) (this.linAt(la lb lc 0 2 layer.gx0 layer.gy0))))
        layer.stopB = (this.hexOf((this.linAt(la lb lc 0 0 layer.gx1 layer.gy1)) (this.linAt(la lb lc 0 1 layer.gx1 layer.gy1)) (this.linAt(la lb lc 0 2 layer.gx1 layer.gy1))))
    }

    fn traceOverlayShapes:void () {
        def n:int (width * height)
        def edgeTol:int options.contourEdge
        if (edgeTol < 1) {
            edgeTol = 1
        }
        def spread:int options.contourSpread
        if (spread < 1) {
            spread = 1
        }
        def simTol:int options.overlaySimilar
        def minPx:int options.minRegion
        if (minPx < 4) {
            minPx = 4
        }
        def paintR:[int]
        def paintG:[int]
        def paintB:[int]
        def painted:[int]
        def stamp:[int]
        def i:int 0
        while (i < n) {
            push paintR 0
            push paintG 0
            push paintB 0
            push painted 0
            push stamp (0 - 1)
            i = (i + 1)
        }
        def seeds:[int]
        i = 0
        while (i < n) {
            if ((itemAt labels i) >= 0) {
                push seeds i
                i = n
            }
            i = (i + 1)
        }
        def allCmds:[PathCommand]
        def head:int 0
        def shapeNo:int 0
        def sweepFrom:int 0
        while (shapeNo < 3000) {
            ; Take the next seed; when they run out, sweep for anything still
            ; unpainted so nothing is left as a hole.
            def seed:int (0 - 1)
            while ((head < (array_length seeds)) && (seed < 0)) {
                def cand:int (itemAt seeds head)
                head = (head + 1)
                if ((itemAt labels cand) >= 0) {
                    if ((this.coveredAlready(cand paintR paintG paintB painted simTol)) == false) {
                        seed = cand
                    }
                }
            }
            if (seed < 0) {
                while ((sweepFrom < n) && (seed < 0)) {
                    if (((itemAt labels sweepFrom) >= 0) && ((itemAt painted sweepFrom) == 0)) {
                        seed = sweepFrom
                    }
                    sweepFrom = (sweepFrom + 1)
                }
            }
            if (seed < 0) {
                shapeNo = 3000
            } {
                ; --- grow one surface to its end ---
                def comp:[int]
                def stack:[int]
                def acc:[int]
                push acc (itemAt planeR seed)
                push acc (itemAt planeG seed)
                push acc (itemAt planeB seed)
                push acc 1
                set stamp seed shapeNo
                push stack seed
                def h2:int 0
                while (h2 < (array_length stack)) {
                    def cur:int (itemAt stack h2)
                    h2 = (h2 + 1)
                    push comp cur
                    def cy:int (idiv cur width)
                    def cx:int (cur - (cy * width))
                    if (cx > 0) {
                        this.overlayStep((cur - 1) cur stamp stack acc seeds shapeNo edgeTol spread simTol paintR paintG paintB painted)
                    }
                    if (cx < (width - 1)) {
                        this.overlayStep((cur + 1) cur stamp stack acc seeds shapeNo edgeTol spread simTol paintR paintG paintB painted)
                    }
                    if (cy > 0) {
                        this.overlayStep((cur - width) cur stamp stack acc seeds shapeNo edgeTol spread simTol paintR paintG paintB painted)
                    }
                    if (cy < (height - 1)) {
                        this.overlayStep((cur + width) cur stamp stack acc seeds shapeNo edgeTol spread simTol paintR paintG paintB painted)
                    }
                }
                def cnt:int (itemAt acc 3)
                def mr:int (idiv (itemAt acc 0) cnt)
                def mg:int (idiv (itemAt acc 1) cnt)
                def mb:int (idiv (itemAt acc 2) cnt)
                ; Every shape marks its ground, whatever its size — a scrap too
                ; small to be worth its own path still has to stop later shapes
                ; from growing over it again.
                def c:int 0
                while (c < (array_length comp)) {
                    def px:int (itemAt comp c)
                    set paintR px mr
                    set paintG px mg
                    set paintB px mb
                    set painted px 1
                    c = (c + 1)
                }
                if ((array_length comp) >= minPx) {
                    def bm:EvgBinaryBitmap (EvgBinaryBitmap.create(width height))
                    c = 0
                    while (c < (array_length comp)) {
                        def p2:int (itemAt comp c)
                        def yy:int (idiv p2 width)
                        bm.setBit((p2 - (yy * width)) yy true)
                        c = (c + 1)
                    }
                    def layerOpts:EvgTraceOptions (EvgTraceOptions.defaults())
                    layerOpts.turdsize = options.turdsize
                    layerOpts.alphamax = options.alphamax
                    layerOpts.turnpolicy = options.turnpolicy
                    layerOpts.optcurve = options.optcurve
                    layerOpts.opttolerance = options.opttolerance
                    layerOpts.fillHex = (this.hexFromRgb(mr mg mb))
                    def sub:EvgBitmapTracer (EvgBitmapTracer.fromBinary(bm layerOpts))
                    sub.trace()
                    if ((sub.ringCount()) > 0) {
                        def layer:EvgTraceLayer (itemAt sub.layers 0)
                        if options.gradientFill {
                            this.fitAndPaintShape(comp layer paintR paintG paintB)
                        }
                        push layers layer
                        def cmds:[PathCommand] (sub.getCommands())
                        def ci:int 0
                        while (ci < (array_length cmds)) {
                            push allCmds (itemAt cmds ci)
                            ci = (ci + 1)
                        }
                        rings = sub.rings
                    }
                }
                shapeNo = (shapeNo + 1)
            }
        }
        commands = allCmds
        if ((array_length layers) > 0) {
            def first:EvgTraceLayer (itemAt layers 0)
            pathData = first.pathData
        }
    }

    ; One step of an overlay's growth. Three things stop it: an edge, drifting
    ; too far from its own mean, and arriving somewhere it would look the same
    ; as what is already painted. An edge is not just a stop — it is where the
    ; next shape begins, on the far side and above.
    fn overlayStep:void (i:int from:int stamp:[int] stack:[int] acc:[int] seeds:[int] shapeNo:int edgeTol:int spread:int simTol:int paintR:[int] paintG:[int] paintB:[int] painted:[int]) {
        if ((itemAt stamp i) == shapeNo) {
            return
        }
        if ((itemAt labels i) < 0) {
            return
        }
        if ((this.pixelDelta(from i)) > edgeTol) {
            ; The far side of an edge is a shape of its own, drawn over this one.
            push seeds i
            return
        }
        if (this.coveredAlready(i paintR paintG paintB painted simTol)) {
            return
        }
        def cnt:int (itemAt acc 3)
        def mr:int (idiv (itemAt acc 0) cnt)
        def mg:int (idiv (itemAt acc 1) cnt)
        def mb:int (idiv (itemAt acc 2) cnt)
        def d:int (EvgBitmapTracer.absI((itemAt planeR i) - mr))
        def dg:int (EvgBitmapTracer.absI((itemAt planeG i) - mg))
        if (dg > d) {
            d = dg
        }
        def db:int (EvgBitmapTracer.absI((itemAt planeB i) - mb))
        if (db > d) {
            d = db
        }
        if (d > spread) {
            return
        }
        set stamp i shapeNo
        push stack i
        set acc 0 ((itemAt acc 0) + (itemAt planeR i))
        set acc 1 ((itemAt acc 1) + (itemAt planeG i))
        set acc 2 ((itemAt acc 2) + (itemAt planeB i))
        set acc 3 (cnt + 1)
    }

    ; Absorb connected runs below options.minRegion into the region that
    ; surrounds them. turdsize would otherwise drop those rings outright, which
    ; is why the painted area used to shrink every time colorCount went up.
    fn mergeTinyRegions:void (k:int) {
        def minPx:int options.minRegion
        if (minPx < 2) {
            return
        }
        def n:int (width * height)
        def seen:[int]
        def i:int 0
        while (i < n) {
            push seen 0
            i = (i + 1)
        }
        def touch:[int]
        def ki:int 0
        while (ki < k) {
            push touch 0
            ki = (ki + 1)
        }
        def start:int 0
        while (start < n) {
            def lab:int (itemAt labels start)
            if ((lab >= 0) && ((itemAt seen start) == 0)) {
                def comp:[int]
                def stack:[int]
                def c:int 0
                ki = 0
                while (ki < k) {
                    set touch ki 0
                    ki = (ki + 1)
                }
                set seen start 1
                push stack start
                def head:int 0
                while (head < (array_length stack)) {
                    def cur:int (itemAt stack head)
                    head = (head + 1)
                    push comp cur
                    def cy:int (idiv cur width)
                    def cx:int (cur - (cy * width))
                    if (cx > 0) {
                        this.compStep((cur - 1) lab seen stack touch)
                    }
                    if (cx < (width - 1)) {
                        this.compStep((cur + 1) lab seen stack touch)
                    }
                    if (cy > 0) {
                        this.compStep((cur - width) lab seen stack touch)
                    }
                    if (cy < (height - 1)) {
                        this.compStep((cur + width) lab seen stack touch)
                    }
                }
                if ((array_length comp) < minPx) {
                    def bestLab:int (0 - 1)
                    def bestN:int 0
                    ki = 0
                    while (ki < k) {
                        if ((itemAt touch ki) > bestN) {
                            bestN = (itemAt touch ki)
                            bestLab = ki
                        }
                        ki = (ki + 1)
                    }
                    if (bestLab >= 0) {
                        c = 0
                        while (c < (array_length comp)) {
                            set labels (itemAt comp c) bestLab
                            c = (c + 1)
                        }
                    }
                }
            }
            start = (start + 1)
        }
    }

    ; Flood one step of the component walk; a differently-labelled neighbour is
    ; recorded as a merge candidate instead.
    fn compStep:void (i:int lab:int seen:[int] stack:[int] touch:[int]) {
        def other:int (itemAt labels i)
        if (other == lab) {
            if ((itemAt seen i) == 0) {
                set seen i 1
                push stack i
            }
            return
        }
        if (other >= 0) {
            set touch other ((itemAt touch other) + 1)
        }
    }

    ; Drop single-pixel islands whose whole 4-neighbourhood agrees on another
    ; swatch. Those specks only add rings that turdsize would delete anyway.
    fn despeckleLabels:void () {
        def n:int (width * height)
        def src:[int]
        def i:int 0
        while (i < n) {
            push src (itemAt labels i)
            i = (i + 1)
        }
        def y:int 0
        while (y < height) {
            def x:int 0
            while (x < width) {
                def idx:int ((y * width) + x)
                def me:int (itemAt src idx)
                if (me >= 0) {
                    def agree:int (0 - 2)
                    def same:boolean true
                    def cnt:int 0
                    if (x > 0) {
                        def l:int (itemAt src (idx - 1))
                        if (agree == (0 - 2)) {
                            agree = l
                        }
                        if (l != agree) {
                            same = false
                        }
                        cnt = (cnt + 1)
                    }
                    if (x < (width - 1)) {
                        def r:int (itemAt src (idx + 1))
                        if (agree == (0 - 2)) {
                            agree = r
                        }
                        if (r != agree) {
                            same = false
                        }
                        cnt = (cnt + 1)
                    }
                    if (y > 0) {
                        def u:int (itemAt src (idx - width))
                        if (agree == (0 - 2)) {
                            agree = u
                        }
                        if (u != agree) {
                            same = false
                        }
                        cnt = (cnt + 1)
                    }
                    if (y < (height - 1)) {
                        def dn:int (itemAt src (idx + width))
                        if (agree == (0 - 2)) {
                            agree = dn
                        }
                        if (dn != agree) {
                            same = false
                        }
                        cnt = (cnt + 1)
                    }
                    if (same && (cnt >= 3) && (agree != me)) {
                        set labels idx agree
                    }
                }
                x = (x + 1)
            }
            y = (y + 1)
        }
    }

    fn hexFromRgb:string (r:int g:int b:int) {
        def c:EVGColor (EVGColor.rgb(r g b))
        return (c.toHexString())
    }

    ; In "stacked" mode a layer claims its own swatch and everything painted
    ; after it, so each layer is drawn on top of a filled neighbour rather than
    ; on the page. The palette is sorted dark → light, so what shows through a
    ; hairline is the next darker color instead of white.
    fn maskForLabel:EvgBinaryBitmap (colorIndex:int) {
        def stacked:boolean ((options.layerMode) != "flat")
        def bm:EvgBinaryBitmap (EvgBinaryBitmap.create(width height))
        def n:int (array_length labels)
        def i:int 0
        while (i < n) {
            def lab:int (itemAt labels i)
            def take:boolean (lab == colorIndex)
            if (stacked && (lab >= colorIndex) && (lab >= 0)) {
                take = true
            }
            if take {
                def y:int (idiv i width)
                def x:int (i - (y * width))
                bm.setBit(x y true)
            }
            i = (i + 1)
        }
        return bm
    }

    ; A 3×3 median that moves whole pixels: of the nine neighbours, take the one
    ; whose luma is the median and copy its RGB. Picking each channel's median
    ; separately would invent colors that are nowhere in the image; this cannot,
    ; and it removes speckle without softening an edge the way a blur does.
    fn smoothPlanes:void () {
        def passes:int options.smooth
        if (passes < 1) {
            return
        }
        if (passes > 4) {
            passes = 4
        }
        def n:int (width * height)
        def pass:int 0
        while (pass < passes) {
            def srcR:[int]
            def srcG:[int]
            def srcB:[int]
            def i:int 0
            while (i < n) {
                push srcR (itemAt planeR i)
                push srcG (itemAt planeG i)
                push srcB (itemAt planeB i)
                i = (i + 1)
            }
            def y:int 0
            while (y < height) {
                def x:int 0
                while (x < width) {
                    def lum:[int]
                    def idxs:[int]
                    def dy:int (0 - 1)
                    while (dy <= 1) {
                        def yy:int (y + dy)
                        if ((yy >= 0) && (yy < height)) {
                            def dx:int (0 - 1)
                            while (dx <= 1) {
                                def xx:int (x + dx)
                                if ((xx >= 0) && (xx < width)) {
                                    def j:int ((yy * width) + xx)
                                    push idxs j
                                    push lum (EvgBitmapTracer.lumaOf((itemAt srcR j) (itemAt srcG j) (itemAt srcB j)))
                                }
                                dx = (dx + 1)
                            }
                        }
                        dy = (dy + 1)
                    }
                    ; Insertion sort — at most nine entries.
                    def k:int (array_length lum)
                    def a:int 1
                    while (a < k) {
                        def lv:int (itemAt lum a)
                        def iv:int (itemAt idxs a)
                        def b:int (a - 1)
                        while ((b >= 0) && ((itemAt lum b) > lv)) {
                            set lum (b + 1) (itemAt lum b)
                            set idxs (b + 1) (itemAt idxs b)
                            b = (b - 1)
                        }
                        set lum (b + 1) lv
                        set idxs (b + 1) iv
                        a = (a + 1)
                    }
                    def pick:int (itemAt idxs (idiv k 2))
                    def here:int ((y * width) + x)
                    set planeR here (itemAt srcR pick)
                    set planeG here (itemAt srcG pick)
                    set planeB here (itemAt srcB pick)
                    x = (x + 1)
                }
                y = (y + 1)
            }
            pass = (pass + 1)
        }
    }

    fn traceColorLayers:void () {
        def want:int options.colorCount
        if (want < 2) {
            want = 2
        }
        this.smoothPlanes()
        this.detectBackground()
        this.buildFlatMask()
        def mode:string options.paletteMode
        def palR:[int]
        def palG:[int]
        def palB:[int]
        def given:int 0
        if ((mode == "fixed") || (mode == "seeded")) {
            given = (this.parsePaletteHex(palR palG palB))
        }
        ; "fixed" with a usable list skips quantization entirely and keeps the
        ; caller's order; anything else (including a list that parsed to
        ; nothing) goes through the quantizer, with the given colors pinned.
        def useGivenOnly:boolean false
        if (mode == "fixed") {
            if (given > 0) {
                useGivenOnly = true
            }
        }
        if (useGivenOnly == false) {
            this.buildPalette(want given palR palG palB)
        }
        def k:int (array_length palR)
        if (k == 0) {
            return
        }
        this.assignLabels(palR palG palB)
        ; Overlay shapes carry their own fits, so it takes precedence when both
        ; are asked for — the two compose rather than compete.
        if ((options.contourMode) == "overlay") {
            this.traceOverlayShapes()
            return
        }
        if options.gradientFill {
            this.traceGradientRegions()
            return
        }
        def li:int 0
        def allCmds:[PathCommand]
        while (li < k) {
            def cr:int (itemAt palR li)
            def cg:int (itemAt palG li)
            def cb:int (itemAt palB li)
            def mask:EvgBinaryBitmap (this.maskForLabel(li))
            def layerOpts:EvgTraceOptions (EvgTraceOptions.defaults())
            layerOpts.turdsize = options.turdsize
            layerOpts.alphamax = options.alphamax
            layerOpts.turnpolicy = options.turnpolicy
            layerOpts.optcurve = options.optcurve
            layerOpts.opttolerance = options.opttolerance
            layerOpts.fillHex = (this.hexFromRgb(cr cg cb))
            def sub:EvgBitmapTracer (EvgBitmapTracer.fromBinary(mask layerOpts))
            sub.trace()
            if ((sub.ringCount()) > 0) {
                def layer:EvgTraceLayer (itemAt sub.layers 0)
                push layers layer
                def cmds:[PathCommand] (sub.getCommands())
                def ci:int 0
                while (ci < (array_length cmds)) {
                    push allCmds (itemAt cmds ci)
                    ci = (ci + 1)
                }
                ; Keep mono-compatible aggregates: last non-empty path + total rings.
                pathData = layer.pathData
                rings = sub.rings
            }
            li = (li + 1)
        }
        commands = allCmds
        if ((array_length layers) > 0) {
            def first:EvgTraceLayer (itemAt layers 0)
            pathData = first.pathData
        }
    }

    ; ----------------------------------------------------------------------
    ; 1. Path decomposition (Potrace-style edge walk)
    ; ----------------------------------------------------------------------

    fn decompose:void () {
        def work:EvgBinaryBitmap (bitmap.copy())
        def start:int 0
        while (start >= 0) {
            def idx:int (work.findNext(start))
            if (idx < 0) {
                start = (0 - 1)
            } {
                def y0:int (idiv idx work.w)
                def x0:int (idx - (y0 * work.w))
                def ring:EvgTraceRing (this.findPath(work x0 y0))
                this.xorPath(work ring)
                def a:int (EvgBitmapTracer.absI(ring.area))
                if (a > options.turdsize) {
                    push rings ring
                }
                start = idx
            }
        }
    }

    fn majorityAt:boolean (bm:EvgBinaryBitmap x:int y:int) {
        def i:int 2
        while (i < 5) {
            def ct:int 0
            def a:int (0 - i + 1)
            while (a <= (i - 1)) {
                if (bm.at((x + a) (y + i - 1))) {
                    ct = (ct + 1)
                } {
                    ct = (ct - 1)
                }
                if (bm.at((x + i - 1) (y + a - 1))) {
                    ct = (ct + 1)
                } {
                    ct = (ct - 1)
                }
                if (bm.at((x + a - 1) (y - i))) {
                    ct = (ct + 1)
                } {
                    ct = (ct - 1)
                }
                if (bm.at((x - i) (y + a))) {
                    ct = (ct + 1)
                } {
                    ct = (ct - 1)
                }
                a = (a + 1)
            }
            if (ct > 0) {
                return true
            }
            if (ct < 0) {
                return false
            }
            i = (i + 1)
        }
        return false
    }

    fn shouldTurnRight:boolean (bm:EvgBinaryBitmap path:EvgTraceRing x:int y:int) {
        def pol:string options.turnpolicy
        if (pol == "right") {
            return true
        }
        if (pol == "left") {
            return false
        }
        if (pol == "black") {
            return (path.sign == "+")
        }
        if (pol == "white") {
            return (path.sign == "-")
        }
        if (pol == "majority") {
            return (this.majorityAt(bm x y))
        }
        ; minority (default): turn right when majority is false
        def maj:boolean (this.majorityAt(bm x y))
        return (maj == false)
    }

    fn findPath:EvgTraceRing (bm:EvgBinaryBitmap x0:int y0:int) {
        def path (new EvgTraceRing())
        path.minX = x0
        path.maxX = x0
        path.minY = y0
        path.maxY = y0
        if (bitmap.at(x0 y0)) {
            path.sign = "+"
        } {
            path.sign = "-"
        }
        def x:int x0
        def y:int y0
        def dirx:int 0
        def diry:int 1
        def done:boolean false
        def guard:int 0
        def limit:int ((bm.w * bm.h) * 8)
        if (limit < 64) {
            limit = 64
        }
        while (done == false) {
            if (guard >= limit) {
                done = true
            } {
                push path.pts (EvgTracePoint.ofInt(x y))
                if (x > path.maxX) {
                    path.maxX = x
                }
                if (x < path.minX) {
                    path.minX = x
                }
                if (y > path.maxY) {
                    path.maxY = y
                }
                if (y < path.minY) {
                    path.minY = y
                }
                x = (x + dirx)
                y = (y + diry)
                path.area = (path.area - (x * diry))
                if ((x == x0) && (y == y0)) {
                    done = true
                } {
                    ; Left / right samples in the half-cell neighbours of the step.
                    def lx:int (EvgBitmapTracer.idivTowardZero(((dirx + diry) - 1) 2))
                    def ly:int (EvgBitmapTracer.idivTowardZero(((diry - dirx) - 1) 2))
                    def rx:int (EvgBitmapTracer.idivTowardZero(((dirx - diry) - 1) 2))
                    def ry:int (EvgBitmapTracer.idivTowardZero(((diry + dirx) - 1) 2))
                    def l:boolean (bm.at((x + lx) (y + ly)))
                    def r:boolean (bm.at((x + rx) (y + ry)))
                    if r {
                        if (l == false) {
                            if (this.shouldTurnRight(bm path x y)) {
                                def tmp:int dirx
                                dirx = (0 - diry)
                                diry = tmp
                            } {
                                def tmp2:int dirx
                                dirx = diry
                                diry = (0 - tmp2)
                            }
                        } {
                            def tmp3:int dirx
                            dirx = (0 - diry)
                            diry = tmp3
                        }
                    } {
                        if (l == false) {
                            def tmp4:int dirx
                            dirx = diry
                            diry = (0 - tmp4)
                        }
                    }
                }
                guard = (guard + 1)
            }
        }
        return path
    }

    fn xorPath:void (bm:EvgBinaryBitmap path:EvgTraceRing) {
        def n:int (path.len())
        if (n < 2) {
            return
        }
        def p0:EvgTracePoint (itemAt path.pts 0)
        def y1:int (to_int p0.y)
        def i:int 1
        while (i < n) {
            def p:EvgTracePoint (itemAt path.pts i)
            def x:int (to_int p.x)
            def y:int (to_int p.y)
            if (y != y1) {
                def minY:int y1
                if (y < y1) {
                    minY = y
                }
                def j:int x
                while (j < path.maxX) {
                    bm.flip(j minY)
                    j = (j + 1)
                }
                y1 = y
            }
            i = (i + 1)
        }
    }

    ; ----------------------------------------------------------------------
    ; 2–4. Optimal polygon + alphamax smooth + optiCurve → path commands
    ; ----------------------------------------------------------------------

    ; When optcurve is false: emit the optimal polygon as straight edges.
    ; When true: alphamax smooth followed by optiCurve (Potrace default).
    fn emitCommands:void () {
        def out:[PathCommand]
        def ri:int 0
        while (ri < (array_length rings)) {
            def ring:EvgTraceRing (itemAt rings ri)
            def poly:[EvgTracePoint] (EvgTraceFit.fitRing(ring))
            def n:int (array_length poly)
            if (n >= 3) {
                ; Potrace reverses negative (hole) polygons so evenodd winding matches.
                if (ring.sign == "-") {
                    def rev:[EvgTracePoint]
                    def ri2:int (n - 1)
                    while (ri2 >= 0) {
                        push rev (itemAt poly ri2)
                        ri2 = (ri2 - 1)
                    }
                    poly = rev
                }
                if options.optcurve {
                    def curve:EvgTraceCurve (EvgTraceCurve.fromPolygon(poly options.alphamax))
                    def opt:EvgTraceCurve (curve.optimize(options.opttolerance))
                    opt.emit(out)
                } {
                    this.appendPolygon(out poly)
                }
            }
            ri = (ri + 1)
        }
        commands = out
    }

    fn appendPolygon:void (out:[PathCommand] poly:[EvgTracePoint]) {
        def n:int (array_length poly)
        def p0:EvgTracePoint (itemAt poly 0)
        push out (VectorShapes.moveTo(p0.x p0.y))
        def i:int 1
        while (i < n) {
            def p:EvgTracePoint (itemAt poly i)
            push out (VectorShapes.lineTo(p.x p.y))
            i = (i + 1)
        }
        push out (VectorShapes.closePath())
    }
}

; ==============================================================================
; EvgLayoutBench — the layout engine, exported so a harness can drive it
; ==============================================================================
; The benchmark and the conformance probe beside this file are JavaScript,
; because the other side of both comparisons is a browser and the case list has
; to be written once. This module exists only so `-nodemodule` publishes the
; engine's classes: the harness builds `EVGElement` trees itself, calls
; `setAttribute` with CSS property names, and reads `calculated*` back.
;
; Nothing here is part of the engine. The one function is the count a harness
; would otherwise have to re-derive, and it is here rather than in JS so the
; tree walk is the engine's own.
; ==============================================================================

Import "../EVGElement.rgr"
Import "../EVGUnit.rgr"
Import "../EVGLayout.rgr"
Import "../EVGDisplayList.rgr"

class EvgLayoutBench {

    sfn countElements:int (el:EVGElement) {
        def n:int 1
        def i:int 0
        while (i < (array_length el.children)) {
            def kid:EVGElement (itemAt el.children i)
            n = (n + (EvgLayoutBench.countElements(kid)))
            i = (i + 1)
        }
        return n
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; EVGTimingTest — the timing functions, against the browser's own numbers
; ==============================================================================
;
; Every expected value in this file was MEASURED, not derived. `npm run
; evg:timing:oracle` drives a real `Animation` in Chromium, pauses it, sets
; `currentTime` by hand and reads the interpolated value back at thirteen input
; progresses; `oracle/css-timing.json` is that capture and the tables below are
; transcribed from it.
;
; Which is the point. The control points behind `ease` are quotable from a
; specification, but whether an implementation of the Bézier solver actually
; lands on the same curve is a question only numbers can answer — and a solver
; that is right at t=0.5 and wrong at t=0.05 looks perfect in a demo. The
; tolerance is 1e-4, comfortably inside the browser's own rounding and far
; tighter than a wrong solver could sneak through.
;
; `left` was the animated property in the capture, not `opacity`, because a
; cubic-bezier with a control point outside [0,1] OVERSHOOTS and opacity
; clamps. The overshoot row below has values above 1 and below 0 in it, and
; those are the rows a naively clamped implementation fails.
; ==============================================================================

Import "EVGEasing.rgr"
Import "EVGElement.rgr"
Import "EVGTransition.rgr"
Import "EVGDisplayList.rgr"
Import "EVGLayout.rgr"

class TimingCheck {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    ; 1e-4: looser than the capture's five decimals, tighter than any
    ; disagreement that would matter to an eye or hide a wrong curve.
    fn eqStr:void (name:string got:boolean want:string) {
        def good:boolean (((to_string got)) == want)
        this.ok(name good)
    }

    fn near:void (name:string got:double want:double) {
        def good:boolean ((fabs (got - want)) < 0.0001)
        if (good == false) {
            print ("       got " + (to_string got) + " want " + (to_string want))
        }
        this.ok(name good)
    }
}

class EVGTimingTest {
    sfn check_linear:void (c:TimingCheck) {
        def e:EVGEasing (EVGEasing.parse("linear"))
        c.ok("linear parses" (e.ok))
        c.near("linear at 0" (e.ease(0.0000)) 0.000000)
        c.near("linear at 0.05" (e.ease(0.0500)) 0.050000)
        c.near("linear at 0.1" (e.ease(0.1000)) 0.100000)
        c.near("linear at 0.2" (e.ease(0.2000)) 0.200000)
        c.near("linear at 0.25" (e.ease(0.2500)) 0.250000)
        c.near("linear at 0.3" (e.ease(0.3000)) 0.300000)
        c.near("linear at 0.4" (e.ease(0.4000)) 0.400000)
        c.near("linear at 0.499" (e.ease(0.4990)) 0.499000)
        c.near("linear at 0.5" (e.ease(0.5000)) 0.500000)
        c.near("linear at 0.501" (e.ease(0.5010)) 0.501000)
        c.near("linear at 0.6" (e.ease(0.6000)) 0.600000)
        c.near("linear at 0.7" (e.ease(0.7000)) 0.700000)
        c.near("linear at 0.75" (e.ease(0.7500)) 0.750000)
        c.near("linear at 0.8" (e.ease(0.8000)) 0.800000)

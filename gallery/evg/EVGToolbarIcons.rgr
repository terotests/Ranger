; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; EVGToolbarIcons.rgr — the icon shapes, as outlines on a 24-grid
; ==============================================================================
;
; The icons on these strips used to be stacks of axis-aligned rectangles, and
; that technique has a ceiling you can see: a shape you can only build from
; bars comes out as an arrangement of bars. The filter looked like the align
; buttons. "No border" looked like a rendering failure. A magnifier was a
; square with a tail.
;
; EVG already parses and fills SVG paths — it is what draws a `custGeom` shape
; on a slide — so an icon can be the silhouette everyone already recognises
; instead of the nearest thing five rectangles can make.
;
; TWO RULES, and both come from what the renderer can actually do.
;
;   Every path is ONE ring. The software painter fills each ring of a shape
;   independently and drops the even-odd flag the display list carries, so an
;   outline drawn as outer-then-inner comes out solid. A hole is punched by
;   drawing a second path over the first in the strip's background colour —
;   which is `holeFor` below. Silhouette-plus-punch is also simply how icon
;   sets of this size are drawn: at 20 pixels a hairline outline is mush.
;
;   Everything is authored on a 24x24 grid with the shape filling about 20 of
;   it, which is what LibreOffice, Breeze and the system trays use. The caller
;   scales; nothing here knows how big it will be drawn.
;
; A letter is still the best icon there is where one exists — B, I, U, $, % —
; and those stay as text in `EVGToolbarView`. This file is for the ones that
; have to be a picture.
; ==============================================================================

Import "EVGToolbar.rgr"

class ToolIconPath {

    ; The silhouette for an icon, or "" when it is drawn some other way.
    sfn dataFor:string (k:int) {
        ; --- the printer
        ;
        ; The paper going in on top, the body of the machine, the sheet
        ; coming out at the front. That silhouette is forty years old and is
        ; read instantly by people who have never owned a printer.
        if (k == (ToolIcon.printDoc())) {
            return "M6 2 h12 v5 h-12 z M2 8 h20 v8 h-4 v-4 h-12 v4 h-4 z M6 14 h12 v8 h-12 z"
        }
        ; --- the direction switch
        ;
        ; Three lines of a paragraph, ragged on the LEFT rather than the
        ; right, over an arrow pointing left. A reader who has never seen the
        ; button before can still read it as "the text goes that way", which
        ; is more than a pair of mirrored arrows or the letters RTL manage.
        if (k == (ToolIcon.textRtl())) {
            ; The arrow starts at 20 and not at 21, which is a correction the
            ; grid check above found the day it was written: from 21 the tail
            ; runs 4 up and then 2.4 + 3.2 + 2.4 back down, ending at 25 — one
            ; unit BELOW the 24-grid the whole file is authored on. Since
            ; `pushIconPath` scales from the grid rather than from the path's
            ; own bounds, that unit was simply hanging out of the box.
            return "M4 3 h16 v3 h-16 z M8 8 h12 v3 h-12 z M4 13 h16 v3 h-16 z M9 20 l4 -4 v2.4 h8 v3.2 h-8 v2.4 z"
        }
        ; --- files and history
        if (k == (ToolIcon.newFile())) {
            return "M5 2 h9 l5 5 v15 h-14 z"
        }
        if (k == (ToolIcon.openFile())) {
            return "M1 4 h8 l2 3 h12 v14 h-22 z"
        }
        if (k == (ToolIcon.save())) {
            return "M2 2 h15 l5 5 v15 h-20 z"
        }
        if (k == (ToolIcon.report())) {
            return "M5 2 h9 l5 5 v15 h-14 z"
        }

        ; --- navigation
        if (k == (ToolIcon.navFirst())) {
            return "M4 4 h3 v16 h-3 z M21 4 v16 l-12 -8 z"
        }
        if (k == (ToolIcon.navPrev())) {
            return "M18 4 v16 l-12 -8 z"
        }
        if (k == (ToolIcon.navNext())) {
            return "M6 4 v16 l12 -8 z"
        }
        if (k == (ToolIcon.navLast())) {
            return "M17 4 h3 v16 h-3 z M3 4 v16 l12 -8 z"
        }
        if (k == (ToolIcon.play())) {
            return "M5 3 v18 l15 -9 z"
        }

        ; --- the object verbs
        if (k == (ToolIcon.editMode())) {
            ; A pointer.
            return "M5 2 l14 9 l-6 1 l3 7 l-3 2 l-4 -7 l-4 4 z"
        }
        if (k == (ToolIcon.copy())) {
            return "M3 1 h12 v3 h-9 v13 h-3 z M7 5 h14 v18 h-14 z"
        }
        if (k == (ToolIcon.paste())) {
            return "M9 1 h6 v2 h4 v20 h-14 v-20 h4 z"
        }
        if (k == (ToolIcon.trash())) {
            return "M9 1 h6 v2 h6 v3 h-18 v-3 h6 z M4 8 h16 l-2 15 h-12 z"
        }
        if (k == (ToolIcon.duplicate())) {
            return "M2 2 h13 v13 h-13 z M9 9 h13 v13 h-13 z"
        }
        if (k == (ToolIcon.lock())) {
            return "M12 1 a6 6 0 0 1 6 6 v3 h-3 v-3 a3 3 0 0 0 -6 0 v3 h-3 v-3 a6 6 0 0 1 6 -6 z M4 11 h16 v12 h-16 z"
        }
        if (k == (ToolIcon.shapeRect())) {
            return "M2 5 h20 v14 h-20 z"
        }
        ; The gallery. The square is the silhouette; the circle and the
        ; triangle are drawn over it by `paintIconDetail`, because one path
        ; here is one ring and three shapes are three.
        if (k == (ToolIcon.shapes())) {
            return "M3 12 h10 v10 h-10 z"
        }
        ; Scissors: the two blades crossing, as one ring. The finger holes are
        ; drawn over it by `paintIconDetail`, for the reason at the top of this
        ; file — a hole here would fill solid.
        if (k == (ToolIcon.cut())) {
            return "M7 2 l7 12 l-1.5 2.5 l-7 -12 z M17 2 l-7 12 l1.5 2.5 l7 -12 z"
        }
        if (k == (ToolIcon.shapeEllipse())) {
            return "M12 4 a10 8 0 0 1 0 16 a10 8 0 0 1 0 -16 z"
        }
        if (k == (ToolIcon.textBox())) {
            return "M2 3 h20 v18 h-20 z"
        }
        if (k == (ToolIcon.picture())) {
            return "M2 4 h20 v16 h-20 z"
        }
        if (k == (ToolIcon.chart())) {
            return "M3 21 h18 v2 h-20 v-22 h2 z M6 12 h3 v8 h-3 z M11 7 h3 v13 h-3 z M16 10 h3 v10 h-3 z"
        }
        if (k == (ToolIcon.search())) {
            return "M15 16 l2 -2 l6 6 l-2 2 z"
        }
        if (k == (ToolIcon.funnel())) {
            return "M2 3 h20 l-8 9 v9 l-4 2 v-11 z"
        }
        if (k == (ToolIcon.comment())) {
            return "M2 3 h20 v14 h-12 l-5 5 v-5 h-3 z"
        }
        if (k == (ToolIcon.palette())) {
            return "M2 2 h9 v9 h-9 z M13 2 h9 v9 h-9 z M2 13 h9 v9 h-9 z M13 13 h9 v9 h-9 z"
        }
        if (k == (ToolIcon.formatPaste())) {
            ; A roller with the paint coming off it.
            return "M3 2 h14 v6 h-14 z M9 8 h2 v4 h6 v10 h-10 v-10 h2 z"
        }

        ; --- arranging what is selected
        ; Flip: two wedges facing each other across a dashed axis. The axis is
        ; punched, so the two halves read as a mirror rather than as an arrow.
        if (k == (ToolIcon.flipH())) {
            return "M2 4 h8 v16 h-8 z M14 4 h8 v16 h-8 z"
        }
        if (k == (ToolIcon.flipV())) {
            return "M4 2 h16 v8 h-16 z M4 14 h16 v8 h-16 z"
        }
        ; Order: two overlapping squares, and which one is solid says which
        ; one is in front.
        if (k == (ToolIcon.bringFront())) {
            return "M2 2 h13 v13 h-13 z"
        }
        if (k == (ToolIcon.sendBack())) {
            return "M2 2 h13 v13 h-13 z"
        }
        ; Group: two shapes inside one frame. Ungroup: the frame gone and the
        ; two apart.
        if (k == (ToolIcon.group())) {
            return "M1 1 h22 v22 h-22 z"
        }
        if (k == (ToolIcon.ungroup())) {
            return "M1 1 h11 v11 h-11 z M12 12 h11 v11 h-11 z"
        }
        ; A slide, with what is happening to it.
        if (k == (ToolIcon.slideAdd())) {
            return "M1 3 h17 v13 h-17 z"
        }
        if (k == (ToolIcon.slideCopy())) {
            return "M1 2 h14 v11 h-14 z"
        }
        if (k == (ToolIcon.slideDel())) {
            return "M1 3 h17 v13 h-17 z"
        }
        if (k == (ToolIcon.database())) {
            return "M12 1 a9 4 0 0 1 0 8 a9 4 0 0 1 0 -8 z M3 8 a9 4 0 0 0 18 0 v4 a9 4 0 0 1 -18 0 z M3 15 a9 4 0 0 0 18 0 v4 a9 4 0 0 1 -18 0 z"
        }
        ; --- traced from the drawings they replace ------------------------------
        ;
        ; These fifteen were stacks of `pushRect` calls in `EVGToolbarView`,
        ; and they are here because the repository's own bitmap tracer put
        ; them here: the drawing was painted through the real painter onto a
        ; 24-grid scaled 32x, `EvgBitmapTracer` followed the boundary, and
        ; every coordinate that came back divided by 32 onto a whole unit of
        ; the grid. Not an approximation of the old icons — the same shapes.
        ;
        ; TWO THINGS THE CONVERSION FIXED THAT WERE NOT THE POINT OF IT.
        ;
        ;   They scale now. `pushIconPath` sizes a path from the 24-grid by
        ;   `glyphSize / 24`; the rectangle drawings were written with literal
        ;   offsets — `cx - 8`, `16.0` — so they came out 24 pixels across
        ;   whatever size the caller asked for. A strip drawing its outlines
        ;   at 18 and these at 24 was drawing two sizes of icon at once.
        ;
        ;   Overlapping shapes became one ring. `arrangeCenter` was three
        ;   rectangles that overlap; the tracer returned a single boundary
        ;   around their union, which is what the even-odd fill needs. Emitting
        ;   the three rectangles as three subpaths would have punched the
        ;   overlaps back out as holes.
        ; --- text alignment, and the paragraph it acts on
        if (k == (ToolIcon.alignLeft())) {
            return "M2 2 L2 4.75 L22 4.75 L22 2 Z M2 7.75 L2 10.5 L14.75 10.5 L14.75 7.75 Z M2 13.5 L2 16.25 L22 16.25 L22 13.5 Z M2 19.25 L2 22 L14.75 22 L14.75 19.25 Z"
        }
        if (k == (ToolIcon.alignCenter())) {
            return "M2 2 L2 4.75 L22 4.75 L22 2 Z M6.25 7.75 L6.25 10.5 L19.25 10.5 L19.25 7.75 Z M2 13.5 L2 16.25 L22 16.25 L22 13.5 Z M6.25 19.25 L6.25 22 L19.25 22 L19.25 19.25 Z"
        }
        if (k == (ToolIcon.alignRight())) {
            return "M2 2 L2 4.75 L22 4.75 L22 2 Z M9.25 7.75 L9.25 10.5 L22 10.5 L22 7.75 Z M2 13.5 L2 16.25 L22 16.25 L22 13.5 Z M9.25 19.25 L9.25 22 L22 22 L22 19.25 Z"
        }
        if (k == (ToolIcon.textJustify())) {
            return "M2 2 L2 4.75 L22 4.75 L22 2 Z M2 7.75 L2 10.5 L22 10.5 L22 7.75 Z M2 13.5 L2 16.25 L22 16.25 L22 13.5 Z M2 19.25 L2 22 L22 22 L22 19.25 Z"
        }
        ; --- lists
        if (k == (ToolIcon.bulletList())) {
            return "M2 4.75 L2 7.75 L4.75 7.75 L4.75 4.75 Z M7.75 4.75 L7.75 7.75 L22 7.75 L22 4.75 Z M2 10.5 L2 13.5 L4.75 13.5 L4.75 10.5 Z M7.75 10.5 L7.75 13.5 L22 13.5 L22 10.5 Z M2 16.25 L2 19.25 L4.75 19.25 L4.75 16.25 Z M7.75 16.25 L7.75 19.25 L22 19.25 L22 16.25 Z"
        }
        if (k == (ToolIcon.outlineList())) {
            return "M2 4L2 20L4.75 20L4.75 4Z M7.5 5.25L7.5 8L22 8L22 5.25Z M11.5 10.75L11.5 13.25L22 13.25L22 10.75Z M11.5 16L11.5 18.75L22 18.75L22 16Z"
        }
        if (k == (ToolIcon.indentMore())) {
            return "M10.5 4.75 L10.5 7.75 L22 7.75 L22 4.75 Z M2 7.75 L2 16.25 L3.5 16.25 L3.5 13.5 L4.75 13.5 L4.75 10.5 L6.25 10.5 L6.25 7.75 Z M10.5 10.5 L10.5 13.5 L22 13.5 L22 10.5 Z M10.5 16.25 L10.5 19.25 L22 19.25 L22 16.25 Z"
        }
        if (k == (ToolIcon.indentLess())) {
            return "M10.5 4.75 L10.5 7.75 L22 7.75 L22 4.75 Z M2 7.75 L2 10.5 L3.5 10.5 L3.5 13.5 L4.75 13.5 L4.75 16.25 L6.25 16.25 L6.25 7.75 Z M10.5 10.5 L10.5 13.5 L22 13.5 L22 10.5 Z M10.5 16.25 L10.5 19.25 L22 19.25 L22 16.25 Z"
        }
        ; --- arranging a shape against the page
        if (k == (ToolIcon.arrangeLeft())) {
            return "M4 2L4 22L5.25 22L5.25 2Z M6.25 4.25L6.25 9.75L19.75 9.75L19.75 4.25Z M6.25 14.25L6.25 19.75L14 19.75L14 14.25Z"
        }
        if (k == (ToolIcon.arrangeCenter())) {
            return "M12 2 L12 4.25 L5.25 4.25 L5.25 9.75 L12 9.75 L12 14.25 L8.75 14.25 L8.75 19.75 L12 19.75 L12 22 L13 22 L13 19.75 L16.5 19.75 L16.5 14.25 L13 14.25 L13 9.75 L18.75 9.75 L18.75 4.25 L13 4.25 L13 2 Z"
        }
        if (k == (ToolIcon.arrangeRight())) {
            return "M19.5 2L19.5 22L20.5 22L20.5 2Z M3.75 4.25L3.75 9.75L17.25 9.75L17.25 4.25Z M9.5 14.25L9.5 19.75L17.25 19.75L17.25 14.25Z"
        }
        ; --- undo and redo, traced faithfully, staircase and all
        ;
        ; The arrowheads below are flights of one-unit steps, and that is not
        ; the tracer being coarse — it is what the drawing was. A diagonal
        ; built out of axis-aligned rectangles is a staircase, and following
        ; its boundary exactly gives a staircase back. So these two are the
        ; conversion working and the artwork not: they gain the scaling and the
        ; data-ness the others gain, and they still want an arrowhead drawn as
        ; a triangle by hand rather than approximated by bars. Tracing cannot
        ; supply what was never in the picture.
        if (k == (ToolIcon.undo())) {
            return "M16.25 5L16.25 9.25L2 9.25L2 19.25L4.75 19.25L4.75 12.25L16.25 12.25L16.25 16.5L17.75 16.5L17.75 15L19.25 15L19.25 13.5L20.5 13.5L20.5 12.25L22 12.25L22 9.25L20.5 9.25L20.5 7.75L19.25 7.75L19.25 6.5L17.75 6.5L17.75 5Z"
        }
        if (k == (ToolIcon.redo())) {
            return "M6.75 4.25L6.75 5.75L5 5.75L5 7.25L3.5 7.25L3.5 8.75L2 8.75L2 12L3.5 12L3.5 13.5L5 13.5L5 15L6.75 15L6.75 16.5L8.25 16.5L8.25 12L19 12L19 19.5L22 19.5L22 8.75L8.25 8.75L8.25 4.25Z"
        }
        ; --- the paint bucket
        if (k == (ToolIcon.paint())) {
            return "M4.25 2L4.25 9.75L10.5 9.75L10.5 22L13.5 22L13.5 9.75L19.75 9.75L19.75 2Z"
        }
        return ""
    }

    ; The part of a silhouette that has to be knocked back out of it, drawn on
    ; top in the strip's background colour. "" when the shape has no hole.
    ;
    ; This is what stands in for an even-odd fill. It is not a workaround for
    ; its own sake — punching a hole in a solid shape is how a 20-pixel icon
    ; is drawn anyway, because a hairline ring at that size disappears.
    sfn holeFor:string (k:int) {
        if (k == (ToolIcon.printDoc())) {
            ; The paper hollowed out, top and bottom, and a slot in the body —
            ; without them the printer is a solid block with a bite out of it.
            return "M8 3 h8 v3 h-8 z M8 15 h8 v6 h-8 z M16 10 h4 v2 h-4 z"
        }
        if (k == (ToolIcon.newFile())) {
            ; The folded corner, and the sheet hollowed out so it reads as
            ; paper rather than as a black block.
            return "M14 2 v5 h5 z M7 4 h6 v5 h6 v11 h-12 z"
        }
        if (k == (ToolIcon.report())) {
            return "M14 2 v5 h5 z M8 11 h8 v2 h-8 z M8 15 h8 v2 h-8 z"
        }
        if (k == (ToolIcon.openFile())) {
            ; The inside of the folder, so it is a folder and not a lump.
            return "M3 9 h18 v10 h-18 z"
        }
        if (k == (ToolIcon.save())) {
            ; The shutter at the top and the label at the bottom. Without both
            ; a floppy is a square with a bitten corner; with only the shutter
            ; it is an H, which is what the first attempt drew.
            return "M7 4 h7 v5 h-7 z M6 13 h12 v9 h-12 z"
        }
        if (k == (ToolIcon.copy())) {
            return "M9 7 h10 v14 h-10 z"
        }
        if (k == (ToolIcon.paste())) {
            return "M11 2 h2 v2 h-2 z M9 7 h6 v2 h-6 z M9 11 h6 v2 h-6 z"
        }
        if (k == (ToolIcon.trash())) {
            return "M9 11 h2 v9 h-2 z M13 11 h2 v9 h-2 z"
        }
        if (k == (ToolIcon.duplicate())) {
            return "M4 4 h9 v9 h-9 z M11 11 h9 v9 h-9 z"
        }
        if (k == (ToolIcon.lock())) {
            return "M11 14 h2 v6 h-2 z"
        }
        if (k == (ToolIcon.shapeRect())) {
            return "M4 7 h16 v10 h-16 z"
        }
        if (k == (ToolIcon.shapeEllipse())) {
            return "M12 6 a8 6 0 0 1 0 12 a8 6 0 0 1 0 -12 z"
        }
        if (k == (ToolIcon.textBox())) {
            ; A box with an A in it. The bar and the two legs are the letter.
            return "M4 5 h16 v14 h-16 z"
        }
        if (k == (ToolIcon.picture())) {
            return "M4 6 h16 v12 h-16 z"
        }
        if (k == (ToolIcon.formatPaste())) {
            return "M5 4 h10 v2 h-10 z M11 14 h4 v6 h-4 z"
        }
        if (k == (ToolIcon.flipH())) {
            ; The narrow face of each wedge, so they taper away from the axis.
            return "M2 4 l0 16 l6 -4 v-8 z M22 4 l0 16 l-6 -4 v-8 z"
        }
        if (k == (ToolIcon.flipV())) {
            return "M4 2 h16 l-4 6 h-8 z M4 22 h16 l-4 -6 h-8 z"
        }
        if (k == (ToolIcon.bringFront())) {
            return "M4 4 h9 v9 h-9 z"
        }
        if (k == (ToolIcon.sendBack())) {
            return "M4 4 h9 v9 h-9 z"
        }
        if (k == (ToolIcon.group())) {
            return "M2 2 h20 v20 h-20 z"
        }
        if (k == (ToolIcon.ungroup())) {
            return "M2 2 h9 v9 h-9 z M13 13 h9 v9 h-9 z"
        }
        if (k == (ToolIcon.slideAdd())) {
            return "M3 5 h13 v9 h-13 z"
        }
        if (k == (ToolIcon.slideCopy())) {
            return "M3 4 h10 v7 h-10 z"
        }
        if (k == (ToolIcon.slideDel())) {
            return "M3 5 h13 v9 h-13 z"
        }
        if (k == (ToolIcon.search())) {
            return ""
        }
        if (k == (ToolIcon.comment())) {
            return "M4 5 h16 v10 h-16 z"
        }
        if (k == (ToolIcon.database())) {
            return ""
        }
        return ""
    }
}

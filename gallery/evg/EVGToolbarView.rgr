; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; EVGToolbarView.rgr — drawing the strip, and the icons on it.
; ==============================================================================
;
; There is no icon font here and a PNG sprite sheet would be a second thing to
; keep in step with the theme, so every icon is drawn from primitives. That is
; three hundred lines of them, and three hundred lines is exactly the amount of
; code nobody writes twice — which is why the spreadsheet had a toolbar and the
; document had none.
;
; So the drawing lives beside the strip rather than inside one application's
; view. What it needs from its owner is a display list to draw into, a
; `UIContext` to measure text with, and a palette; what it does NOT need is to
; know what a cell or a paragraph is. `ToolItem.pressed` and `ToolItem.label`
; are the whole interface: whoever owns the strip fills those in, and this
; draws what they say.
; ==============================================================================

Import "EVGToolbar.rgr"
Import "EVGDisplayList.rgr"
Import "EVGColor.rgr"
Import "../game_engine/ui/UIContext.rgr"
Import "SVGPathParser.rgr"
Import "EVGToolbarIcons.rgr"

; Which of the faces we ship a document's font name should be drawn with.
;
; This used to be a static on the spreadsheet's view, which meant a second
; application either reached into it or grew its own copy — and a copy would
; start answering differently the first time a face was added. Excel's
; stand-ins (Calibri, Arial, …) have no TTF here, so each aliases to a
; distinct loaded family: otherwise picking one of them looks like a no-op.
class EVGFace {
    sfn family:string (name:string) {
        def n:string (to_lowercase (trim name))
        if ((strlen n) == 0) {
            return "Open Sans"
        }
        if (n == "open sans") {
            return "Open Sans"
        }
        if (n == "noto sans") {
            return "Noto Sans"
        }
        if ((n == "helvetica") || (n == "helvetica neue")) {
            return "Helvetica"
        }
        if ((n == "droid serif") || (n == "georgia") || (n == "times new roman") || (n == "times") || (n == "cambria")) {
            return "Droid Serif"
        }
        if ((n == "josefin sans") || (n == "century gothic") || (n == "futura")) {
            return "Josefin Sans"
        }
        if ((n == "calibri") || (n == "segoe ui")) {
            return "Noto Sans"
        }
        if (n == "arial") {
            return "Helvetica"
        }
        return "Open Sans"
    }

    ; Select the raster face. It has to go through `fontFamily`, because
    ; UITextRenderer re-applies the face from it on every measure and draw —
    ; setting the font directly is undone by the next call.
    sfn apply:void (ctx:UIContext name:string bold:boolean italic:boolean) {
        def base:string (EVGFace.family(name))
        ; See `UITextRenderer.faceName`: spelled by hand here, the bold
        ; italic cut was asked for as "-BoldItalic" and silently resolved to
        ; the family's regular face.
        def want:string (UITextRenderer.faceName(base bold italic))
        if (ctx.tr.fontFamily == want) {
            return
        }
        def face:TrueTypeFont (ctx.tr.fm.getFont(want))
        if (face.unitsPerEm > 0) {
            ctx.tr.fontFamily = want
            return
        }
        def plain:TrueTypeFont (ctx.tr.fm.getFont(base))
        if (plain.unitsPerEm > 0) {
            ctx.tr.fontFamily = base
        }
    }
}

class EVGToolbarView {
    def ctx:UIContext (new UIContext)
    def theme:EVGToolbarTheme (new EVGToolbarTheme)
    ; The face the labels are drawn in, so a host that ships one family and a
    ; host that ships five both get readable buttons.
    def fontFamily:string "Open Sans"

    Constructor () {
    }

    fn attach:void (c:UIContext family:string) {
        ctx = c
        fontFamily = family
    }

    ; Rows of text with an arrow at the left pointing the way the indent
    ; moves. The two indent icons differ only in that direction.
    fn pushIndentIcon:void (dl:EVGDisplayList cx:int cy:int deeper:boolean) {
        def row:int 0
        while (row < 3) {
            def ry:double (to_double ((cy - 5) + (row * 4)))
            def x0:double (to_double (cx - 1))
            if (row == 1) {
                x0 = (to_double (cx - 1))
            }
            this.pushRect(dl x0 ry 8.0 2.0 theme.ink)
            row = (row + 1)
        }
        def step:int 0
        while (step < 3) {
            def half:double (to_double (3 - step))
            def ax:double (to_double (cx - 7))
            if (deeper == false) {
                ax = ((to_double (cx - 7)) + (3.0 - half))
            }
            this.pushRect(dl ax (to_double ((cy - 3) + (step * 2))) half 2.0 theme.accent)
            step = (step + 1)
        }
    }

    ; --- icons as outlines ----------------------------------------------------
    ;
    ; The older icons here are stacks of `pushRect`, and that technique has a
    ; ceiling: a shape you can only build from axis-aligned bars comes out as
    ; an arrangement of bars. Which is why the filter looked like the align
    ; buttons and the "no border" box looked like a rendering failure — they
    ; were drawn with the only vocabulary available.
    ;
    ; EVG already parses and fills SVG paths (`SVGPathParser` → flattened rings
    ; → `addPolygon`), which is what draws a `custGeom` shape on a slide. The
    ; same pipeline draws an icon, and then an icon can be the shape everyone
    ; already recognises rather than the nearest thing five rectangles can make.
    ;
    ; `d` is authored on a 24x24 grid, the size every desktop icon set uses, and
    ; scaled into the box asked for here.
    fn pushIconPath:void (dl:EVGDisplayList d:string cx:int cy:int size:int col:EVGColor) {
        def parser (new SVGPathParser())
        parser.parse(d)
        def b:PathBounds (parser.getBounds())
        if (b.width <= 0.0) {
            return
        }
        if (b.height <= 0.0) {
            return
        }
        ; Scaled from the 24-grid rather than from the path's own bounds, so a
        ; glyph that does not fill its box — a comma, a stem — keeps its
        ; proportion and its position instead of being blown up to fit.
        def k:double ((to_double size) / 24.0)
        def e:double ((to_double cx) - (12.0 * k))
        def f:double ((to_double cy) - (12.0 * k))
        def rings:[PathRing] (parser.flattenRings(16 k 0.0 0.0 k e f))
        ; One command, every ring, even-odd — so an outline drawn as
        ; outer-then-inner comes out with its hole. Filling ring by ring is
        ; what turned the magnifier into a black disc.
        dl.addPolyRings(rings col true)
    }

    ; --- the primitives the icons are made of ---------------------------------

    ; A 2x2 cell grid, faint, as the thing a row/column/alignment icon acts
    ; ON. Several icons used to draw a bar with nothing around it, which left
    ; the bar meaning "a bar".
    fn pushCellFrame:void (dl:EVGDisplayList cx:int cy:int) {
        this.pushBorder(dl (to_double (cx - 8)) (to_double (cy - 8)) 16.0 16.0 1.0 theme.line)
    }

    ; A plus of a stated arm length, centred. Drawn rather than typed, because
    ; a `+` glyph sits on the text baseline and a drawn one sits where it is
    ; put — which matters when it has to line up with a bar beside it.
    fn pushPlus:void (dl:EVGDisplayList cx:int cy:int arm:int col:EVGColor) {
        def n:double (to_double ((arm * 2) + 1))
        this.pushRect(dl (to_double (cx - arm)) (to_double cy) n 2.0 col)
        this.pushRect(dl (to_double cx) (to_double (cy - arm)) 2.0 n col)
    }

    ; Vertical alignment: a cell, and the text parked at the top, the middle or
    ; the bottom of it. `where` is 0 top, 1 middle, 2 bottom.
    fn pushValignIcon:void (dl:EVGDisplayList cx:int cy:int where:int col:EVGColor) {
        this.pushBorder(dl (to_double (cx - 8)) (to_double (cy - 8)) 16.0 16.0 1.0 theme.glyph)
        def ty:int (cy - 5)
        if (where == 1) {
            ty = (cy - 2)
        }
        if (where == 2) {
            ty = (cy + 1)
        }
        this.pushRect(dl (to_double (cx - 5)) (to_double ty) 10.0 2.0 col)
        this.pushRect(dl (to_double (cx - 5)) (to_double (ty + 3)) 7.0 2.0 col)
    }

    fn pushRect:void (dl:EVGDisplayList x:double y:double w:double h:double col:EVGColor) {
        dl.addRect(x y w h col)
    }

    fn pushBorder:void (dl:EVGDisplayList x:double y:double w:double h:double t:double col:EVGColor) {
        dl.addFrame(x y w h t col)
    }

    fn pushText:void (dl:EVGDisplayList text:string x:double y:double size:double col:EVGColor) {
        def w:double (ctx.tr.measureWidth(text size))
        def h:double (ctx.tr.lineHeight(size))
        dl.addText(text x y size col fontFamily false false w h)
    }

    fn pushStyledText:void (dl:EVGDisplayList text:string x:double y:double size:double col:EVGColor fontName:string bold:boolean italic:boolean) {
        if ((strlen text) == 0) {
            return
        }
        EVGFace.apply(ctx fontName bold italic)
        def w:double (ctx.tr.measureWidth(text size))
        def h:double (ctx.tr.lineHeight(size))
        dl.addText(text x y size col (EVGFace.family(fontName)) bold italic w h)
    }

    fn applyFace:void (bold:boolean) {
        EVGFace.apply(ctx "" bold false)
    }

    fn applyFaceStyled:void (bold:boolean italic:boolean) {
        EVGFace.apply(ctx "" bold italic)
    }

    ; --- the strip ------------------------------------------------------------
    ; Lays the buttons out into the band and draws them. `pressed` on each item
    ; is whatever the owner put there; the tooltip is the hot item's label.
    fn paint:void (dl:EVGDisplayList bar:EVGToolbar x0:int y0:int width:int height:int) {
        this.pushRect(dl (to_double x0) (to_double y0) (to_double width) (to_double height) theme.bg)
        this.pushBorder(dl (to_double x0) (to_double y0) (to_double width) (to_double height) 1.0 theme.line)
        ; The names are measured HERE, where the measurer is, and written back
        ; onto the tabs before the layout runs. The strip itself has no way to
        ; measure text — it computes geometry from numbers its owner hands it,
        ; which is the same reason `addText` takes a width — and a tab row
        ; sized by counting characters is visibly wrong on the first proper
        ; name it meets.
        this.measureTabs(bar)
        this.measureLabels(bar)
        bar.layout(x0 y0 width)
        if (bar.hasTabs()) {
            this.paintTabs(dl bar x0 y0 width)
        }
        def i:int 0
        while (i < (bar.count())) {
            def t:ToolItem (bar.at(i))
            if (t.w > 0) {
                if t.isSeparator {
                    this.pushRect(dl (to_double (t.x + 4)) (to_double (t.y + 3)) 1.0 (to_double (t.h - 6)) theme.line)
                } {
                    if t.pressed {
                        this.pushRect(dl (to_double t.x) (to_double t.y) (to_double t.w) (to_double t.h) theme.pressedBg)
                    }
                    if (bar.hot == i) {
                        if (t.pressed == false) {
                            this.pushRect(dl (to_double t.x) (to_double t.y) (to_double t.w) (to_double t.h) theme.hotBg)
                        }
                    }
                    if (t.textW > 0) {
                        this.paintTextButton(dl t)
                    } {
                        this.paintToolIcon(dl t bar.iconW)
                        if t.showLabel {
                            this.paintChipLabel(dl t bar.iconW)
                        }
                        if t.isMenu {
                            this.paintChevron(dl ((t.x + t.w) - 9) (t.y + (idiv t.h 2)) theme.dim)
                        }
                    }
                }
            }
            i = (i + 1)
        }
    }

    ; A real helper tip next to the hot icon — a status bar alone is easy to
    ; miss, and icon-only buttons need a name under the pointer.
    ;
    ; Drawn from `paintOverlay`, not from `paint`. It hangs BELOW the strip,
    ; over whatever the app draws next, and the app draws next — so drawn with
    ; the band it went into the list first and the slide, the page or the
    ; sheet was painted straight over it. That is the same way the dropdown
    ; menu was lost, and it is the same fix.
    fn paintTooltip:void (dl:EVGDisplayList bar:EVGToolbar) {
        if (bar.hot < 0) {
            return
        }
        ; A dropdown that is open explains itself; a tip over its own list is
        ; noise on top of the thing it names.
        if (bar.openMenu >= 0) {
            return
        }
        def tip:string (bar.hotLabel())
        if ((strlen tip) < 1) {
            return
        }
        def ht:ToolItem (bar.at(bar.hot))
        this.applyFace(false)
        def tw:int (to_int ((ctx.tr.measureWidth(tip 12.0)) + 16.0))
        def th:int 22
        ; Centred under the button it names, which is where a reader looks for
        ; it, and pulled back inside the window at either edge.
        def tx:int ((ht.x + (idiv ht.w 2)) - (idiv tw 2))
        def ty:int ((ht.y + ht.h) + 6)
        def right:int (bar.lastX + bar.lastW)
        if ((tx + tw) > (right - 4)) {
            tx = ((right - tw) - 4)
        }
        if (tx < (bar.lastX + 4)) {
            tx = (bar.lastX + 4)
        }
        this.pushRect(dl (to_double tx) (to_double ty) (to_double tw) (to_double th) theme.tooltipBg)
        this.pushText(dl tip (to_double (tx + 8)) (to_double (ty + 4)) 12.0 theme.tooltipInk)
    }

    ; The word beside the picture on a labelled button, or under it on a big
    ; one.
    fn paintChipLabel:void (dl:EVGDisplayList t:ToolItem iconW:int) {
        this.applyFace(false)
        if t.isLarge {
            def lw:double (ctx.tr.measureWidth(t.label 12.0))
            def lx:double ((to_double t.x) + (((to_double t.w) - lw) * 0.5))
            def ly:double ((to_double ((t.y + t.h) - 16)))
            this.pushText(dl t.label lx ly 12.0 theme.ink)
            return
        }
        def ty:double ((to_double t.y) + (((to_double t.h) - 12.0) * 0.5))
        this.pushText(dl t.label (to_double (t.x + iconW)) ty 12.0 theme.ink)
    }

    ; The little chevron that says a button has a list under it.
    fn paintChevron:void (dl:EVGDisplayList cx:int cy:int col:EVGColor) {
        this.pushRect(dl (to_double (cx - 3)) (to_double (cy - 1)) 7.0 1.0 col)
        this.pushRect(dl (to_double (cx - 2)) (to_double (cy + 1)) 5.0 1.0 col)
        this.pushRect(dl (to_double (cx - 1)) (to_double (cy + 3)) 3.0 1.0 col)
    }

    ; What every caption measures at, for the layout to size the buttons by.
    ; Same arrangement as the page names: the strip has no measurer, the view
    ; does, and the numbers are written back before the layout runs.
    fn measureLabels:void (bar:EVGToolbar) {
        this.applyFace(false)
        def i:int 0
        while (i < (bar.count())) {
            def t:ToolItem (bar.at(i))
            if t.showLabel {
                t.labelW = (to_int ((ctx.tr.measureWidth(t.label 12.0)) + 8.0))
            }
            i = (i + 1)
        }
    }

    ; The open dropdown's list.
    ;
    ; A SEPARATE call, made by the app at the very end of its frame, because
    ; a list hangs below the strip and everything the app draws afterwards —
    ; the formula bar, the sheet, the page — is drawn over the band and would
    ; bury it. Drawing it inside `paint` looked right and produced a menu that
    ; was painted and then immediately covered up, which is a bug you can only
    ; find by looking at the picture.
    fn paintOverlay:void (dl:EVGDisplayList bar:EVGToolbar) {
        this.paintMenu(dl bar)
        this.paintTooltip(dl bar)
    }

    fn paintMenu:void (dl:EVGDisplayList bar:EVGToolbar) {
        def box:[int] (bar.menuBox())
        if ((array_length box) < 4) {
            return
        }
        def bx:double (to_double (itemAt box 0))
        def by:double (to_double (itemAt box 1))
        def bw:double (to_double (itemAt box 2))
        def bh:double (to_double (itemAt box 3))
        this.pushRect(dl bx by bw bh theme.tipBg)
        this.pushBorder(dl bx by bw bh 1.0 theme.line)
        def i:int 0
        while (i < (bar.count())) {
            def t:ToolItem (bar.at(i))
            if (t.menuOwner == bar.openMenu) {
                if (t.w > 0) {
                    if (bar.hot == i) {
                        this.pushRect(dl (to_double t.x) (to_double t.y) (to_double t.w) (to_double t.h) theme.hotBg)
                    }
                    this.paintToolIcon(dl t bar.iconW)
                    this.paintChipLabel(dl t bar.iconW)
                }
            }
            i = (i + 1)
        }
    }

    ; What each page's name measures at, for the layout to place them by.
    fn measureTabs:void (bar:EVGToolbar) {
        if ((bar.hasTabs()) == false) {
            return
        }
        this.applyFace(false)
        def i:int 0
        while (i < (bar.tabCount())) {
            def t:ToolTab (bar.tabAt(i))
            t.measuredW = (to_int (ctx.tr.measureWidth(t.name 13.0)))
            i = (i + 1)
        }
    }

    ; The row of names above the buttons.
    ;
    ; The showing page is drawn as a raised chip continuous with the band
    ; below it, and the others are flat: that is the whole visual grammar of a
    ; tab, and it is what says which of the five words the buttons underneath
    ; belong to. A rule under the row, broken by the active chip, is what
    ; makes it read as a page rather than as five more buttons.
    fn paintTabs:void (dl:EVGDisplayList bar:EVGToolbar x0:int y0:int width:int) {
        def baseY:double (to_double ((y0 + bar.tabH) - 1))
        this.pushRect(dl (to_double x0) baseY (to_double width) 1.0 theme.line)
        def i:int 0
        while (i < (bar.tabCount())) {
            def t:ToolTab (bar.tabAt(i))
            if (t.w > 0) {
                def active:boolean (i == bar.activeTab)
                def col:EVGColor theme.dim
                if active {
                    ; The chip, drawn a pixel past the rule so the two join.
                    this.pushRect(dl (to_double t.x) (to_double t.y) (to_double t.w) (to_double (t.h + 1)) theme.tipBg)
                    this.pushBorder(dl (to_double t.x) (to_double t.y) (to_double t.w) (to_double (t.h + 1)) 1.0 theme.line)
                    this.pushRect(dl (to_double (t.x + 1)) (to_double t.y) (to_double (t.w - 2)) 2.0 theme.accent)
                    this.pushRect(dl (to_double (t.x + 1)) baseY (to_double (t.w - 2)) 1.0 theme.tipBg)
                    col = theme.ink
                }
                def tw:double (ctx.tr.measureWidth(t.name 13.0))
                def tx:double ((to_double t.x) + (((to_double t.w) - tw) * 0.5))
                def ty:double ((to_double t.y) + (((to_double t.h) - 13.0) * 0.5))
                this.pushText(dl t.name tx ty 13.0 col)
            }
            i = (i + 1)
        }
    }

    ; A wider button that shows a value rather than a picture — a font name, a
    ; point size. `label` is whatever the owner last put there.
    fn paintTextButton:void (dl:EVGDisplayList t:ToolItem) {
        this.pushBorder(dl (to_double t.x) (to_double t.y) (to_double t.w) (to_double t.h) 1.0 theme.line)
        this.pushText(dl t.label (to_double (t.x + 4)) (to_double (t.y + 4)) 11.0 theme.ink)
        ; A small chevron on the right so it reads as a dropdown.
        def cx:int ((t.x + t.w) - 8)
        def cy:int (t.y + (idiv t.h 2))
        this.pushRect(dl (to_double (cx - 3)) (to_double (cy - 1)) 7.0 1.0 theme.dim)
        this.pushRect(dl (to_double (cx - 2)) (to_double (cy + 1)) 5.0 1.0 theme.dim)
        this.pushRect(dl (to_double (cx - 1)) (to_double (cy + 3)) 3.0 1.0 theme.dim)
    }

    ; The side of the square an icon is drawn in. Twenty of a thirty-pixel
    ; button, which is the desktop proportion; the old drawing used sixteen of
    ; twenty-six and read small because it WAS small.
    ; 24 on a 24-grid, so an icon authored at full size draws at full size.
    ;
    ; It was 20, which shrank every silhouette to 83% and made the difference
    ; between, say, the two clipboard icons a matter of a couple of pixels.
    ; Reported as "the icons are too small and hard to tell apart", and both
    ; halves of that were the same number.
    def glyphSize:int 24

    ; What goes on top of a silhouette: the letter in a text box, the coloured
    ; scale in a picture. Kept apart from the shape so the shape stays one
    ; ring and one colour.
    ; A plus drawn on the 24-grid, offset from the icon's centre.
    fn pushIconDetailPlus:void (dl:EVGDisplayList cx:int cy:int dx:int dy:int col:EVGColor) {
        def s:double ((to_double glyphSize) / 24.0)
        def px:double ((to_double cx) + ((to_double dx) * s))
        def py:double ((to_double cy) + ((to_double dy) * s))
        this.pushRect(dl (px - (4.0 * s)) (py - (1.25 * s)) (8.0 * s) (2.5 * s) col)
        this.pushRect(dl (px - (1.25 * s)) (py - (4.0 * s)) (2.5 * s) (8.0 * s) col)
    }

    fn paintIconDetail:void (dl:EVGDisplayList t:ToolItem k:int cx:int cy:int ink:EVGColor) {
        if (k == (ToolIcon.textBox())) {
            this.pushToolText(dl "A" cx cy 11.0 ink true)
            return
        }
        if (k == (ToolIcon.cut())) {
            ; The two finger holes, as rings drawn in the strip's own colour.
            this.pushIconPath(dl "M6.5 17 a3 3 0 0 1 0 6 a3 3 0 0 1 0 -6 z" cx cy glyphSize ink)
            this.pushIconPath(dl "M17.5 17 a3 3 0 0 1 0 6 a3 3 0 0 1 0 -6 z" cx cy glyphSize ink)
            this.pushIconPath(dl "M6.5 19 a1 1 0 0 1 0 2 a1 1 0 0 1 0 -2 z" cx cy glyphSize theme.bg)
            this.pushIconPath(dl "M17.5 19 a1 1 0 0 1 0 2 a1 1 0 0 1 0 -2 z" cx cy glyphSize theme.bg)
            return
        }
        if (k == (ToolIcon.shapes())) {
            ; A circle and a triangle over the square, in the accent, so the
            ; button reads as "a choice of shapes" rather than as one shape.
            this.pushIconPath(dl "M16 3 a5 5 0 0 1 0 10 a5 5 0 0 1 0 -10 z" cx cy glyphSize theme.accent)
            this.pushIconPath(dl "M7 2 l5 8 h-10 z" cx cy glyphSize theme.accent)
            return
        }
        if (k == (ToolIcon.picture())) {
            ; A sun and a hill inside the frame — the shape everything else in
            ; the world uses for a picture. Drawn as paths on the same 24-grid
            ; as the frame, so they land inside it at any size.
            this.pushIconPath(dl "M7 7 a2 2 0 0 1 0 4 a2 2 0 0 1 0 -4 z" cx cy glyphSize (EVGColor.rgb(240 180 40)))
            this.pushIconPath(dl "M5 17 l5 -6 l3 3 l4 -5 l4 8 z" cx cy glyphSize (EVGColor.rgb(60 150 90)))
            return
        }
        if (k == (ToolIcon.palette())) {
            def s2:double ((to_double glyphSize) / 24.0)
            this.pushRect(dl ((to_double cx) - (10.0 * s2)) ((to_double cy) - (10.0 * s2)) (9.0 * s2) (9.0 * s2) (EVGColor.rgb(214 69 65)))
            this.pushRect(dl ((to_double cx) + (1.0 * s2)) ((to_double cy) - (10.0 * s2)) (9.0 * s2) (9.0 * s2) (EVGColor.rgb(240 180 40)))
            this.pushRect(dl ((to_double cx) - (10.0 * s2)) ((to_double cy) + (1.0 * s2)) (9.0 * s2) (9.0 * s2) (EVGColor.rgb(60 150 90)))
            this.pushRect(dl ((to_double cx) + (1.0 * s2)) ((to_double cy) + (1.0 * s2)) (9.0 * s2) (9.0 * s2) (EVGColor.rgb(40 100 210)))
            return
        }
        ; A slide frame with the thing happening to it beside it.
        if (k == (ToolIcon.slideAdd())) {
            this.pushIconDetailPlus(dl cx cy 6 5 theme.accent)
            return
        }
        if (k == (ToolIcon.slideDel())) {
            def sd:double ((to_double glyphSize) / 24.0)
            this.pushRect(dl ((to_double cx) + (2.0 * sd)) ((to_double cy) + (4.0 * sd)) (8.0 * sd) (2.5 * sd) theme.warn)
            return
        }
        if (k == (ToolIcon.slideCopy())) {
            ; The second slide, in front and to the right.
            def sc:double ((to_double glyphSize) / 24.0)
            this.pushIconPath(dl "M7 8 h16 v13 h-16 z" cx cy glyphSize ink)
            def under2:EVGColor theme.bg
            if t.pressed {
                under2 = (EVGColor.rgb(214 226 245))
            }
            this.pushIconPath(dl "M9 10 h12 v9 h-12 z" cx cy glyphSize under2)
            return
        }
        ; Two overlapping shapes, and which is solid says which is in front.
        if (k == (ToolIcon.bringFront())) {
            this.pushIconPath(dl "M9 9 h13 v13 h-13 z" cx cy glyphSize theme.accent)
            return
        }
        if (k == (ToolIcon.sendBack())) {
            def ub:EVGColor theme.bg
            if t.pressed {
                ub = (EVGColor.rgb(214 226 245))
            }
            this.pushIconPath(dl "M9 9 h13 v13 h-13 z" cx cy glyphSize ub)
            this.pushIconPath(dl "M9 9 h13 v13 h-13 z M11 11 h9 v9 h-9 z" cx cy glyphSize theme.glyph)
            return
        }
        ; Group: two shapes inside the frame. Ungroup has no frame, so nothing
        ; is drawn on top of it.
        if (k == (ToolIcon.group())) {
            this.pushIconPath(dl "M5 5 h6 v6 h-6 z" cx cy glyphSize theme.accent)
            this.pushIconPath(dl "M13 13 h6 v6 h-6 z" cx cy glyphSize theme.accent)
            return
        }
        if (k == (ToolIcon.search())) {
            ; The glass: a ring drawn as a disc with the middle punched out.
            def s3:double ((to_double glyphSize) / 24.0)
            this.pushIconPath(dl "M10 1 a9 9 0 0 1 0 18 a9 9 0 0 1 0 -18 z" cx cy glyphSize ink)
            def under:EVGColor theme.bg
            if t.pressed {
                under = (EVGColor.rgb(214 226 245))
            }
            this.pushIconPath(dl "M10 4 a6 6 0 0 1 0 12 a6 6 0 0 1 0 -12 z" cx cy glyphSize under)
            return
        }
    }

    fn paintToolIcon:void (dl:EVGDisplayList t:ToolItem iconW:int) {
        def cx:int (t.x + (idiv t.w 2))
        def cy:int (t.y + (idiv t.h 2))
        ; A labelled button puts its picture at the left and its word beside
        ; it, the way every office strip does — centring the glyph in a button
        ; three times its width leaves the word floating away from it.
        if t.showLabel {
            cx = (t.x + (idiv iconW 2))
        }
        ; A big button centres its picture over its name rather than beside
        ; it, which is the whole difference between "one of these commands"
        ; and "the command this page is for".
        if t.isLarge {
            cx = (t.x + (idiv t.w 2))
            cy = ((t.y + 4) + (idiv (glyphSize) 2))
        }
        def ink:EVGColor theme.ink
        def dim:EVGColor theme.dim
        def k:int t.icon

        ; An outline from the catalogue, if this icon has one. Asked FIRST, so
        ; converting an icon is a matter of giving it a path rather than of
        ; deleting the rectangles that used to draw it.
        def d:string (ToolIconPath.dataFor(k))
        if ((strlen d) > 0) {
            def tone:EVGColor ink
            if (k == (ToolIcon.link())) {
                tone = theme.link
            }
            if (k == (ToolIcon.shapeRect())) {
                tone = theme.accent
            }
            if (k == (ToolIcon.shapeEllipse())) {
                tone = theme.accent
            }
            this.pushIconPath(dl d cx cy glyphSize tone)
            ; The hole, knocked back out in the strip's own background. A
            ; pressed or hot button paints its own fill first, so the punch has
            ; to use THAT colour or it leaves a pale scar on the highlight.
            def hole:string (ToolIconPath.holeFor(k))
            if ((strlen hole) > 0) {
                def under:EVGColor theme.bg
                if t.pressed {
                    under = (EVGColor.rgb(214 226 245))
                }
                this.pushIconPath(dl hole cx cy glyphSize under)
            }
            this.paintIconDetail(dl t k cx cy ink)
            return
        }

        ; Letters, where a letter is the clearest icon there is.
        if (k == (ToolIcon.bold())) {
            this.pushToolText(dl "B" cx cy 13.0 ink true)
            return
        }
        if (k == (ToolIcon.italic())) {
            this.pushToolText(dl "I" cx cy 13.0 ink false)
            return
        }
        if (k == (ToolIcon.underline())) {
            this.pushToolText(dl "U" cx (cy - 1) 12.0 ink false)
            this.pushRect(dl (to_double (cx - 5)) (to_double (cy + 7)) 10.0 1.0 ink)
            return
        }
        if (k == (ToolIcon.strike())) {
            this.pushToolText(dl "S" cx cy 12.0 ink false)
            this.pushRect(dl (to_double (cx - 5)) (to_double cy) 10.0 1.0 ink)
            return
        }
        if (k == (ToolIcon.currency())) {
            this.pushToolText(dl "$" cx cy 13.0 ink false)
            return
        }
        if (k == (ToolIcon.percent())) {
            this.pushToolText(dl "%" cx cy 12.0 ink false)
            return
        }
        if (k == (ToolIcon.comma())) {
            this.pushToolText(dl "," cx (cy - 2) 15.0 ink false)
            return
        }
        if (k == (ToolIcon.decMore())) {
            this.pushToolText(dl ".0" cx cy 11.0 ink false)
            return
        }
        if (k == (ToolIcon.decLess())) {
            this.pushToolText(dl ".00" cx cy 9.0 dim false)
            return
        }
        if (k == (ToolIcon.sizeUp())) {
            this.pushToolText(dl "A+" cx cy 12.0 ink false)
            return
        }
        if (k == (ToolIcon.sizeDown())) {
            this.pushToolText(dl "A-" cx cy 10.0 ink false)
            return
        }
        if (k == (ToolIcon.undo())) {
            this.paintArrowIcon(dl cx cy true ink)
            return
        }
        if (k == (ToolIcon.redo())) {
            this.paintArrowIcon(dl cx cy false ink)
            return
        }
        if (k == (ToolIcon.openFile())) {
            ; A folder with its lid open.
            this.pushRect(dl (to_double (cx - 8)) (to_double (cy - 5)) 6.0 2.0 theme.accent)
            this.pushBorder(dl (to_double (cx - 8)) (to_double (cy - 3)) 16.0 10.0 1.0 theme.accent)
            this.pushRect(dl (to_double (cx - 6)) (to_double (cy - 1)) 12.0 2.0 dim)
            return
        }
        if (k == (ToolIcon.newFile())) {
            ; A blank page with a folded corner.
            this.pushBorder(dl (to_double (cx - 6)) (to_double (cy - 7)) 12.0 15.0 1.0 theme.accent)
            this.pushRect(dl (to_double (cx + 1)) (to_double (cy - 7)) 5.0 5.0 dim)
            this.pushRect(dl (to_double (cx - 3)) (to_double (cy + 1)) 6.0 1.0 dim)
            this.pushRect(dl (to_double (cx - 3)) (to_double (cy + 4)) 6.0 1.0 dim)
            return
        }
        if (k == (ToolIcon.report())) {
            ; A page with a chart-ish bar on it: this button prints something.
            this.pushBorder(dl (to_double (cx - 6)) (to_double (cy - 7)) 12.0 15.0 1.0 theme.accent)
            this.pushRect(dl (to_double (cx - 3)) (to_double (cy - 4)) 6.0 1.0 dim)
            this.pushRect(dl (to_double (cx - 3)) (to_double (cy + 3)) 2.0 3.0 theme.accent)
            this.pushRect(dl (to_double cx) (to_double (cy + 1)) 2.0 5.0 theme.accent)
            this.pushRect(dl (to_double (cx + 3)) (to_double (cy - 1)) 2.0 7.0 theme.accent)
            return
        }
        if (k == (ToolIcon.save())) {
            ; A tray with something going into it.
            this.pushRect(dl (to_double (cx - 1)) (to_double (cy - 7)) 2.0 8.0 theme.accent)
            this.pushRect(dl (to_double (cx - 4)) (to_double (cy - 2)) 3.0 2.0 theme.accent)
            this.pushRect(dl (to_double (cx + 1)) (to_double (cy - 2)) 3.0 2.0 theme.accent)
            this.pushRect(dl (to_double (cx - 7)) (to_double (cy + 3)) 14.0 2.0 theme.accent)
            this.pushRect(dl (to_double (cx - 7)) (to_double (cy + 3)) 2.0 4.0 theme.accent)
            this.pushRect(dl (to_double (cx + 5)) (to_double (cy + 3)) 2.0 4.0 theme.accent)
            return
        }
        if (k == (ToolIcon.paint())) {
            this.pushRect(dl (to_double (cx - 5)) (to_double (cy - 6)) 10.0 5.0 theme.accent)
            this.pushRect(dl (to_double (cx - 1)) (to_double (cy - 1)) 2.0 8.0 dim)
            return
        }
        if (k == (ToolIcon.clearFmt())) {
            this.pushToolText(dl "A" cx (cy - 2) 12.0 dim false)
            this.pushRect(dl (to_double (cx - 6)) (to_double (cy + 6)) 12.0 2.0 theme.warn)
            return
        }
        if (k == (ToolIcon.search())) {
            ; A magnifier, built from bars. It would be one clean outline as a
            ; path — but the software painter fills every ring of a path
            ; independently, so a ring comes out a solid disc. See the note on
            ; `pushIconPath`.
            this.pushRect(dl (to_double (cx - 6)) (to_double (cy - 8)) 8.0 2.0 ink)
            this.pushRect(dl (to_double (cx - 6)) (to_double (cy - 1)) 8.0 2.0 ink)
            this.pushRect(dl (to_double (cx - 8)) (to_double (cy - 6)) 2.0 5.0 ink)
            this.pushRect(dl (to_double (cx + 2)) (to_double (cy - 6)) 2.0 5.0 ink)
            this.pushRect(dl (to_double (cx + 3)) (to_double (cy + 2)) 2.0 2.0 ink)
            this.pushRect(dl (to_double (cx + 5)) (to_double (cy + 4)) 3.0 4.0 ink)
            return
        }
        if (k == (ToolIcon.chart())) {
            this.pushRect(dl (to_double (cx - 6)) (to_double (cy + 1)) 3.0 5.0 theme.accent)
            this.pushRect(dl (to_double (cx - 1)) (to_double (cy - 3)) 3.0 9.0 theme.accent)
            this.pushRect(dl (to_double (cx + 4)) (to_double (cy - 6)) 3.0 12.0 theme.accent)
            return
        }
        if (k == (ToolIcon.link())) {
            this.pushRect(dl (to_double (cx - 7)) (to_double (cy - 1)) 6.0 2.0 theme.link)
            this.pushRect(dl (to_double (cx + 1)) (to_double (cy - 1)) 6.0 2.0 theme.link)
            this.pushRect(dl (to_double (cx - 2)) (to_double (cy - 1)) 4.0 2.0 theme.link)
            return
        }
        if (k == (ToolIcon.cond())) {
            ; A cell with a colour scale down it — which is what conditional
            ; formatting DOES. Two coloured bars alone read as a flag.
            this.pushBorder(dl (to_double (cx - 7)) (to_double (cy - 8)) 14.0 16.0 1.0 ink)
            this.pushRect(dl (to_double (cx - 5)) (to_double (cy - 6)) 10.0 4.0 (EVGColor.rgb(214 69 65)))
            this.pushRect(dl (to_double (cx - 5)) (to_double (cy - 2)) 10.0 4.0 (EVGColor.rgb(240 190 60)))
            this.pushRect(dl (to_double (cx - 5)) (to_double (cy + 2)) 10.0 4.0 (EVGColor.rgb(60 150 90)))
            return
        }
        if (k == (ToolIcon.validate())) {
            this.pushRect(dl (to_double (cx - 5)) (to_double (cy + 1)) 4.0 2.0 (EVGColor.rgb(40 140 70)))
            this.pushRect(dl (to_double (cx - 2)) (to_double (cy - 3)) 8.0 2.0 (EVGColor.rgb(40 140 70)))
            return
        }
        ; A stack of platters, which is what everything has drawn a database as
        ; since the disk pack: a lid, two bands under it, and a shaded top so
        ; it reads as a cylinder rather than as three lines.
        if (k == (ToolIcon.database())) {
            def dbInk:EVGColor theme.accent
            this.pushRect(dl (to_double (cx - 6)) (to_double (cy - 7)) 12.0 3.0 dbInk)
            this.pushRect(dl (to_double (cx - 5)) (to_double (cy - 7)) 10.0 1.0 (EVGColor.rgb(150 185 235)))
            this.pushRect(dl (to_double (cx - 6)) (to_double (cy - 2)) 12.0 3.0 dbInk)
            this.pushRect(dl (to_double (cx - 6)) (to_double (cy + 3)) 12.0 3.0 dbInk)
            this.pushRect(dl (to_double (cx - 6)) (to_double (cy - 4)) 1.0 2.0 dbInk)
            this.pushRect(dl (to_double (cx + 5)) (to_double (cy - 4)) 1.0 2.0 dbInk)
            this.pushRect(dl (to_double (cx - 6)) (to_double (cy + 1)) 1.0 2.0 dbInk)
            this.pushRect(dl (to_double (cx + 5)) (to_double (cy + 1)) 1.0 2.0 dbInk)
            return
        }
        if (k == (ToolIcon.play())) {
            ; A triangle out of rows: the icon painter has rectangles and text,
            ; which between them draw everything else on this strip too.
            def row:int 0
            while (row < 5) {
                def half:int (5 - row)
                if (row > 2) {
                    half = (row - 1)
                }
                this.pushRect(dl (to_double (cx - 4)) (to_double ((cy - 5) + (row * 2))) (to_double half) 2.0 theme.accent)
                row = (row + 1)
            }
            return
        }
        ; A list is three rows with a marker in front of each: a square for a
        ; dotted list, a digit for a numbered one. The arrow ones add the
        ; direction the indent moves.
        if (k == (ToolIcon.bulletList())) {
            def row:int 0
            while (row < 3) {
                def ry:double (to_double ((cy - 5) + (row * 4)))
                this.pushRect(dl (to_double (cx - 7)) ry 2.0 2.0 theme.accent)
                this.pushRect(dl (to_double (cx - 3)) ry 10.0 2.0 theme.ink)
                row = (row + 1)
            }
            return
        }
        if (k == (ToolIcon.numberList())) {
            def row2:int 0
            while (row2 < 3) {
                def ry2:double (to_double ((cy - 5) + (row2 * 4)))
                this.pushToolText(dl (to_string (row2 + 1)) (cx - 6) ((cy - 4) + (row2 * 4)) 7.0 theme.accent false)
                this.pushRect(dl (to_double (cx - 3)) ry2 10.0 2.0 theme.ink)
                row2 = (row2 + 1)
            }
            return
        }
        if (k == (ToolIcon.indentMore())) {
            this.pushIndentIcon(dl cx cy true)
            return
        }
        if (k == (ToolIcon.indentLess())) {
            this.pushIndentIcon(dl cx cy false)
            return
        }
        if (k == (ToolIcon.sqlBox())) {
            this.pushToolText(dl "SQL" cx cy 9.0 theme.accent false)
            return
        }
        if (k == (ToolIcon.freeze())) {
            this.pushRect(dl (to_double (cx - 7)) (to_double (cy - 1)) 14.0 1.0 theme.accent)
            this.pushRect(dl (to_double (cx - 1)) (to_double (cy - 7)) 1.0 14.0 theme.accent)
            return
        }
        if (k == (ToolIcon.sortAsc())) {
            this.pushToolText(dl "A1" cx cy 10.0 ink false)
            return
        }
        if (k == (ToolIcon.sortDesc())) {
            this.pushToolText(dl "1A" cx cy 10.0 ink false)
            return
        }
        if (k == (ToolIcon.funnel())) {
            ; A funnel with a stem, as a single outline.
            this.pushIconPath(dl "M3 4 h18 l-7 8 v7 l-4 2 v-9 z" cx cy 18 ink)
            return
        }
        if (k == (ToolIcon.insertRow())) {
            this.pushCellFrame(dl cx cy)
            this.pushRect(dl (to_double (cx - 8)) (to_double (cy + 2)) 16.0 4.0 theme.glyph)
            this.pushPlus(dl cx (cy - 4) 4 theme.accent)
            return
        }
        if (k == (ToolIcon.insertCol())) {
            this.pushCellFrame(dl cx cy)
            this.pushRect(dl (to_double (cx + 2)) (to_double (cy - 8)) 4.0 16.0 theme.glyph)
            this.pushPlus(dl (cx - 4) cy 4 theme.accent)
            return
        }
        if (k == (ToolIcon.deleteRow())) {
            this.pushCellFrame(dl cx cy)
            this.pushRect(dl (to_double (cx - 8)) (to_double (cy + 2)) 16.0 4.0 theme.glyph)
            ; A minus in the warning colour: the same shape as the insert,
            ; and the one difference is the one that matters.
            this.pushRect(dl (to_double (cx - 4)) (to_double (cy - 5)) 8.0 2.0 theme.warn)
            return
        }
        if (k == (ToolIcon.merge())) {
            ; A box with a gap in the middle was a box with a gap in the
            ; middle. The arrows pointing INTO the gap are what say that two
            ; cells are being made one.
            this.pushBorder(dl (to_double (cx - 8)) (to_double (cy - 6)) 16.0 12.0 1.0 ink)
            this.pushRect(dl (to_double (cx - 5)) (to_double (cy - 1)) 4.0 2.0 theme.accent)
            this.pushRect(dl (to_double (cx + 1)) (to_double (cy - 1)) 4.0 2.0 theme.accent)
            this.pushRect(dl (to_double (cx - 2)) (to_double (cy - 3)) 1.0 6.0 theme.accent)
            this.pushRect(dl (to_double (cx + 1)) (to_double (cy - 3)) 1.0 6.0 theme.accent)
            return
        }
        if (k == (ToolIcon.fill())) {
            this.pushToolText(dl "A" cx (cy - 2) 11.0 ink false)
            this.pushRect(dl (to_double (cx - 7)) (to_double (cy + 6)) 14.0 4.0 (EVGColor.rgb(255 220 130)))
            return
        }
        if (k == (ToolIcon.textColor())) {
            this.pushToolText(dl "A" cx (cy - 2) 11.0 ink false)
            this.pushRect(dl (to_double (cx - 7)) (to_double (cy + 6)) 14.0 4.0 theme.warn)
            return
        }
        if (k == (ToolIcon.borderAll())) {
            this.pushBorder(dl (to_double (cx - 7)) (to_double (cy - 7)) 14.0 14.0 1.0 ink)
            this.pushRect(dl (to_double (cx - 7)) (to_double cy) 14.0 1.0 ink)
            this.pushRect(dl (to_double cx) (to_double (cy - 7)) 1.0 14.0 ink)
            return
        }
        if (k == (ToolIcon.borderOut())) {
            this.pushBorder(dl (to_double (cx - 7)) (to_double (cy - 7)) 14.0 14.0 1.0 ink)
            return
        }
        if (k == (ToolIcon.borderMore())) {
            ; A smaller all-borders box, with room under it for the chevron
            ; that says there is a window behind this one. Drawn at the same
            ; size as the button beside it, the chevron landed ON the box's
            ; bottom edge and could not be seen at all.
            this.pushBorder(dl (to_double (cx - 8)) (to_double (cy - 8)) 12.0 12.0 1.0 ink)
            this.pushRect(dl (to_double (cx - 8)) (to_double (cy - 3)) 12.0 1.0 ink)
            this.pushRect(dl (to_double (cx - 3)) (to_double (cy - 8)) 1.0 12.0 ink)
            this.pushRect(dl (to_double (cx + 1)) (to_double (cy + 5)) 7.0 1.0 ink)
            this.pushRect(dl (to_double (cx + 2)) (to_double (cy + 6)) 5.0 1.0 ink)
            this.pushRect(dl (to_double (cx + 3)) (to_double (cy + 7)) 3.0 1.0 ink)
            this.pushRect(dl (to_double (cx + 4)) (to_double (cy + 8)) 1.0 1.0 ink)
            return
        }
        if (k == (ToolIcon.borderNone())) {
            ; A DASHED box. Drawn as a solid hairline it was a box you could
            ; barely see, which reads as "the icon failed to draw" rather than
            ; as "no border" — and it was indistinguishable from the outline
            ; button two along.
            def bx:int (cx - 7)
            def by:int (cy - 7)
            def d:int 0
            while (d < 14) {
                this.pushRect(dl (to_double (bx + d)) (to_double by) 2.0 1.0 theme.glyph)
                this.pushRect(dl (to_double (bx + d)) (to_double (by + 13)) 2.0 1.0 theme.glyph)
                this.pushRect(dl (to_double bx) (to_double (by + d)) 1.0 2.0 theme.glyph)
                this.pushRect(dl (to_double (bx + 13)) (to_double (by + d)) 1.0 2.0 theme.glyph)
                d = (d + 4)
            }
            return
        }
        if (k == (ToolIcon.alignLeft())) {
            this.paintAlignIcon(dl cx cy 0 ink)
            return
        }
        if (k == (ToolIcon.alignCenter())) {
            this.paintAlignIcon(dl cx cy 1 ink)
            return
        }
        if (k == (ToolIcon.alignRight())) {
            this.paintAlignIcon(dl cx cy 2 ink)
            return
        }
        if (k == (ToolIcon.textJustify())) {
            this.paintAlignIcon(dl cx cy 3 ink)
            return
        }
        if (k == (ToolIcon.arrangeLeft())) {
            this.pushArrangeIcon(dl cx cy 0 ink)
            return
        }
        if (k == (ToolIcon.arrangeCenter())) {
            this.pushArrangeIcon(dl cx cy 1 ink)
            return
        }
        if (k == (ToolIcon.arrangeRight())) {
            this.pushArrangeIcon(dl cx cy 2 ink)
            return
        }
        ; --- vertical alignment
        ;
        ; These were three pairs of floating bars that differed by four pixels
        ; of vertical offset, and they sat next to the three HORIZONTAL align
        ; buttons which are also bars. Nothing said which axis you were
        ; looking at. A cell outline fixes both: the box is the thing being
        ; aligned in, and where the text sits inside it is then obvious.
        if (k == (ToolIcon.valignTop())) {
            this.pushValignIcon(dl cx cy 0 ink)
            return
        }
        if (k == (ToolIcon.valignMid())) {
            this.pushValignIcon(dl cx cy 1 ink)
            return
        }
        if (k == (ToolIcon.valignBot())) {
            this.pushValignIcon(dl cx cy 2 ink)
            return
        }
        if (k == (ToolIcon.wrapCell())) {
            ; Two lines with a bit on the end was just "align left, ragged".
            ; What says WRAP is the arrow that turns back under the first
            ; line, which is the shape every other spreadsheet uses.
            this.pushRect(dl (to_double (cx - 8)) (to_double (cy - 6)) 16.0 2.0 ink)
            this.pushRect(dl (to_double (cx - 8)) (to_double (cy - 1)) 11.0 2.0 ink)
            ; the hook: down the right, then back to the left
            this.pushRect(dl (to_double (cx + 6)) (to_double (cy - 1)) 2.0 6.0 theme.accent)
            this.pushRect(dl (to_double (cx - 3)) (to_double (cy + 3)) 11.0 2.0 theme.accent)
            ; and its head
            this.pushRect(dl (to_double (cx - 3)) (to_double (cy + 1)) 2.0 2.0 theme.accent)
            this.pushRect(dl (to_double (cx - 1)) (to_double (cy + 2)) 2.0 1.0 theme.accent)
            this.pushRect(dl (to_double (cx - 3)) (to_double (cy + 5)) 2.0 2.0 theme.accent)
            this.pushRect(dl (to_double (cx - 1)) (to_double (cy + 5)) 2.0 1.0 theme.accent)
            return
        }
        ; Anything without a picture falls back to its own first letter, which
        ; is better than an empty box.
        if ((strlen t.label) > 0) {
            this.pushToolText(dl (substring t.label 0 1) cx cy 12.0 ink false)
        }
    }

    ; An arrow curving back on itself: a shaft, and a head made of a stack of
    ; rectangles. Undo points left, redo right.
    fn paintArrowIcon:void (dl:EVGDisplayList cx:int cy:int back:boolean col:EVGColor) {
        def dir:int 1
        if back {
            dir = -1
        }
        ; the shaft, bending down at the far end
        this.pushRect(dl (to_double (cx - 6)) (to_double (cy - 4)) 12.0 2.0 col)
        def tipX:int (cx + (dir * 6))
        this.pushRect(dl (to_double (tipX - 1)) (to_double (cy - 4)) 2.0 7.0 col)
        ; the head, three steps deep
        def i:int 0
        while (i < 4) {
            def hx:int ((cx - (dir * 6)) + (dir * i))
            this.pushRect(dl (to_double hx) (to_double ((cy - 4) - i)) 1.0 (to_double ((i * 2) + 2)) col)
            i = (i + 1)
        }
    }

    fn paintAlignIcon:void (dl:EVGDisplayList cx:int cy:int mode:int col:EVGColor) {
        def i:int 0
        while (i < 4) {
            ; Justified: every line runs the full measure, which is what
            ; justification looks like and what mode 3 means here.
            def wide:boolean ((i % 2) == 0)
            if (mode == 3) {
                wide = true
            }
            def lw:int 14
            if (wide == false) {
                lw = 9
            }
            def lx:int (cx - 7)
            if (wide == false) {
                if (mode == 1) {
                    lx = (cx - (idiv lw 2))
                }
                if (mode == 2) {
                    lx = ((cx + 7) - lw)
                }
            }
            this.pushRect(dl (to_double lx) (to_double ((cy - 7) + (i * 4))) (to_double lw) 2.0 col)
            i = (i + 1)
        }
    }

    ; Two boxes pushed against a rule: aligning OBJECTS.
    ;
    ; This is not the same operation as aligning text and it had the same
    ; picture, on strips where both appear — so one pair of buttons moved
    ; frames, the other moved words, and nothing on them said which.
    fn pushArrangeIcon:void (dl:EVGDisplayList cx:int cy:int mode:int col:EVGColor) {
        def edge:int (cx - 8)
        if (mode == 1) {
            edge = cx
        }
        if (mode == 2) {
            edge = (cx + 8)
        }
        ; The rule the boxes are lined up on.
        this.pushRect(dl (to_double edge) (to_double (cy - 9)) 1.0 18.0 col)
        ; Two boxes of different lengths, so the alignment is visible at all:
        ; two equal boxes look the same lined up any of the three ways.
        def i:int 0
        while (i < 2) {
            def bw:int 12
            if (i == 1) {
                bw = 7
            }
            def bx:int (edge + 2)
            if (mode == 1) {
                bx = (edge - (idiv bw 2))
            }
            if (mode == 2) {
                bx = ((edge - bw) - 2)
            }
            this.pushRect(dl (to_double bx) (to_double ((cy - 7) + (i * 9))) (to_double bw) 5.0 col)
            i = (i + 1)
        }
    }

    ; Toolbar text is centred on the button rather than laid out from a corner.
    fn pushToolText:void (dl:EVGDisplayList s:string cx:int cy:int size:double col:EVGColor bold:boolean) {
        this.applyFaceStyled(bold false)
        def w:double (ctx.tr.measureWidth(s size))
        def x:double ((to_double cx) - (w / 2.0))
        def y:double ((to_double cy) - (size * 0.62))
        this.pushStyledText(dl s x y size col "" bold false)
    }
}

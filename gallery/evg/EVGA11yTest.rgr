; ==============================================================================
; EVGA11yTest — the accessibility tree module, and what a dialog says about
; itself.
; ==============================================================================
;
; `EVGA11yTree` is what an EVG program publishes for a screen reader: the same
; frame the display list draws, said as roles and names. Because it is data
; rather than DOM, it can be checked here — no browser, no host, no assistive
; technology — which is the only reason accessibility regressions in a GPU
; program are catchable at all.
;
; The lints matter as much as the assertions. Every one of them is a failure a
; sighted developer cannot see: a button with no name is a perfectly good
; button on screen and an unusable one to everybody else.
; ==============================================================================

Import "EVGA11yTree.rgr"
Import "EVGWindow.rgr"
Import "EVGA11yFromTree.rgr"
Import "EVGElement.rgr"
Import "EVGUnit.rgr"
Import "EVGLayout.rgr"

class A11yCheck {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        this.ok((name + " (got '" + got + "' want '" + want + "')") (got == want))
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }

    fn lintsClean:void (label:string t:EVGA11yTree) {
        def problems:[string] (t.lint())
        def n:int (array_length problems)
        this.ok((label + " lints clean") (n == 0))
        def i:int 0
        while (i < n) {
            print ("    ! " + (itemAt problems i))
            i = (i + 1)
        }
    }
}

class EVGA11yTest {
    sfn dialog:EVGWindow (wm:EVGWindowManager) {
        def w:EVGWindow (new EVGWindow)
        w.title = "Find and replace"
        wm.add(w)
        w.visible = true
        w.reset()
        w.addInput(1 "Find" "total")
        w.addInput(2 "Replace" "sum")
        w.addCheckbox(3 "Match case" true)
        def ids:[int] ([] _:int ( 4 5 ))
        def labels:[string] ([] _:string ( "Replace all" "Close" ))
        w.addButtonRow(ids labels 4)
        w.finish()
        return w
    }

    ; A menubar as an element tree: a bar, a trigger, and the panel that hangs
    ; off it — with roles on the elements and nothing describing them twice.
    sfn menubarTree:EVGElement () {
        def page:EVGElement (EVGElement.createDiv())
        page.id = "page"
        page.setAttribute("width" "800px")
        page.setAttribute("height" "600px")

        def bar:EVGElement (EVGElement.createDiv())
        bar.id = "bar"
        bar.setAttribute("role" "menubar")
        bar.setAttribute("aria-label" "Main")
        bar.setAttribute("display" "flex")
        bar.setAttribute("flex-direction" "row")
        bar.setAttribute("flex-wrap" "nowrap")
        bar.setAttribute("height" "40px")

        def menu:EVGElement (EVGElement.createDiv())
        menu.id = "menu-file"
        menu.setAttribute("display" "flex")
        menu.setAttribute("flex-direction" "column")
        menu.setAttribute("width" "fit-content")

        def trigger:EVGElement (EVGElement.createDiv())
        trigger.id = "trigger-file"
        trigger.setAttribute("role" "menuitem")
        trigger.setAttribute("aria-expanded" "true")
        trigger.setAttribute("aria-focusable" "true")
        trigger.setAttribute("overlay-anchor-role" "true")
        trigger.setAttribute("width" "60px")
        trigger.setAttribute("height" "30px")
        trigger.textContent = "File"

        def content:EVGElement (EVGElement.createDiv())
        content.id = "menu-file-content"
        content.setAttribute("role" "menu")
        content.setAttribute("aria-label" "File")
        content.setAttribute("overlay" "true")
        content.setAttribute("overlay-side" "bottom")
        content.setAttribute("width" "200px")
        content.setAttribute("height" "80px")

        ; A row whose name is not on the row: it is on the two boxes inside it,
        ; which is how every real menu is built.
        def row:EVGElement (EVGElement.createDiv())
        row.id = "row-new-tab"
        row.setAttribute("role" "menuitem")
        row.setAttribute("aria-focusable" "true")
        row.setAttribute("height" "30px")
        def label:EVGElement (EVGElement.createDiv())
        label.textContent = "New Tab"
        def shortcut:EVGElement (EVGElement.createDiv())
        shortcut.textContent = "⌘ T"
        row.addChild(label)
        row.addChild(shortcut)

        def check:EVGElement (EVGElement.createDiv())
        check.id = "row-urls"
        check.setAttribute("role" "menuitemcheckbox")
        check.setAttribute("aria-checked" "true")
        check.setAttribute("aria-focusable" "true")
        check.setAttribute("height" "30px")
        check.textContent = "Always Show Full URLs"

        content.addChild(row)
        content.addChild(check)
        menu.addChild(trigger)
        menu.addChild(content)
        bar.addChild(menu)
        page.addChild(bar)
        return page
    }

    sfn main:void () {
        def c:A11yCheck (new A11yCheck)

        print "== the model =="
        def t:EVGA11yTree (new EVGA11yTree)
        def root:EVGA11yNode (t.group("app" "" "Sheet"))
        t.place(root 0 0 900 560)
        def b:EVGA11yNode (t.button("app/ok" "app" "OK"))
        t.place(b 10 20 80 24)
        def f:EVGA11yNode (t.field("app/find" "app" "Find" "total"))
        t.place(f 10 60 200 24)
        f.caret = 5
        def st:EVGA11yNode (t.statusRegion("app/status" "app" "Ready"))
        t.place(st 0 538 900 22)
        t.setFocus("app/find")
        c.eqStr("the first parentless node is the root" t.rootId "app")
        c.eqInt("four nodes" (t.count()) 4)
        c.ok("a button can be activated" b.actActivate)
        c.ok("a field can be typed into" f.actSetValue)
        c.ok("the focused node is marked" f.focused)
        c.ok("and nothing else is" (b.focused == false))
        c.lintsClean("a small tree" t)

        print "== focus is a property of the tree, not of a node =="
        ; Two focused nodes is a reader with none. Setting focus has to clear
        ; the last one, which is why callers do not touch the flag by hand.
        t.setFocus("app/ok")
        c.ok("the new one is focused" b.focused)
        c.ok("the old one is not" (f.focused == false))
        c.eqStr("and the tree agrees" t.focusId "app/ok")

        print "== roles are spelled the way ARIA spells them =="
        c.eqStr("button" (EVGA11yRole.ariaName((EVGA11yRole.button()))) "button")
        c.eqStr("text field" (EVGA11yRole.ariaName((EVGA11yRole.textField()))) "textbox")
        c.eqStr("cell" (EVGA11yRole.ariaName((EVGA11yRole.cell()))) "gridcell")
        c.eqStr("decoration" (EVGA11yRole.ariaName((EVGA11yRole.none()))) "none")

        print "== the lints catch what nobody can see =="
        def bad:EVGA11yTree (new EVGA11yTree)
        def broot:EVGA11yNode (bad.group("root" "" "App"))
        bad.place(broot 0 0 100 100)
        def nameless:EVGA11yNode (bad.node("root/x" "root" (EVGA11yRole.button())))
        nameless.focusable = true
        bad.place(nameless 0 0 20 20)
        def orphan:EVGA11yNode (bad.node("root/y" "nowhere" (EVGA11yRole.text())))
        orphan.name = "lost"
        bad.setFocus("root/gone")
        def problems:[string] (bad.lint())
        c.ok("three problems found" ((array_length problems) == 3))
        def all:string ""
        def i:int 0
        while (i < (array_length problems)) {
            all = (all + (itemAt problems i) + "\n")
            i = (i + 1)
        }
        c.ok("a focusable thing with no name" (EVGA11yTest.hasSub(all "no accessible name")))
        c.ok("a node hanging off nothing" (EVGA11yTest.hasSub(all "is not in the tree")))
        c.ok("focus pointing at nobody" (EVGA11yTest.hasSub(all "focus points at")))

        print "== a dialog describes itself =="
        def app:EVGA11yTree (new EVGA11yTree)
        def aroot:EVGA11yNode (app.group("app" "" "Sheet"))
        app.place(aroot 0 0 900 560)
        def wm:EVGWindowManager (new EVGWindowManager)
        def w:EVGWindow (EVGA11yTest.dialog(wm))
        w.modal = true
        w.focusedId = 2
        wm.a11y(app "app")
        def dlg:EVGA11yNode (app.find((w.a11yId())))
        c.ok("it is a dialog" (dlg.role == (EVGA11yRole.dialog())))
        c.eqStr("with the title as its name" dlg.name "Find and replace")
        c.ok("and it says it is modal" dlg.modal)
        def find:EVGA11yNode (app.find((w.a11yId()) + "/ctl:1"))
        c.ok("a text field is a text field" (find.role == (EVGA11yRole.textField())))
        c.eqStr("labelled by what is in front of it" find.name "Find")
        c.eqStr("carrying what has been typed" find.value "total")
        def box:EVGA11yNode (app.find((w.a11yId()) + "/ctl:3"))
        c.ok("a checkbox is a checkbox" (box.role == (EVGA11yRole.checkbox())))
        c.eqInt("and it is ticked" box.checked (EVGA11yTri.yes()))
        c.eqStr("the focused field has the keys" app.focusId ((w.a11yId()) + "/ctl:2"))
        c.lintsClean("a dialog" app)

        print "== reading order is what the eye does, not what the array holds =="
        ; A button row is laid out right to left so the default button lands in
        ; the corner — which put "Close" before "Replace all" in the array and
        ; would have read the dialog backwards.
        def order:[int] (w.a11yOrder())
        def firstBtn:string ""
        def lastBtn:string ""
        def k:int 0
        while (k < (array_length order)) {
            def ctl:EVGControl (itemAt w.controls (itemAt order k))
            if (ctl.kind == (EVGControlKind.button())) {
                if ((strlen firstBtn) == 0) {
                    firstBtn = ctl.text
                }
                lastBtn = ctl.text
            }
            k = (k + 1)
        }
        c.eqStr("the left button is read first" firstBtn "Replace all")
        c.eqStr("the right one last" lastBtn "Close")

        print "== ids survive a window being closed and another opened =="
        ; `wid` is a stack position and comes back after a remove; `stamp` does
        ; not. A second dialog arriving under the first one's id is a dialog a
        ; reader is never told about.
        wm.remove(w)
        def w2:EVGWindow (EVGA11yTest.dialog(wm))
        c.eqInt("the stack position was reused" w2.wid w.wid)
        c.ok("the accessibility id was not" ((w2.a11yId()) != (w.a11yId())))

        print "== the JSON keeps the defaults out =="
        def js:string (t.toJson())
        c.ok("names the root" (EVGA11yTest.hasSub(js "\"root\":\"app\"")))
        c.ok("carries a generation" (EVGA11yTest.hasSub(js "\"gen\":")))
        c.ok("spells roles in ARIA" (EVGA11yTest.hasSub(js "\"role\":\"textbox\"")))
        c.ok("says nothing about unchecked things" ((EVGA11yTest.hasSub(js "\"checked\"")) == false))

        print "== an accessible tree derived from the element tree =="
        ; The point of this section: NOTHING below was described twice. The
        ; roles are on the elements that draw the menu, and the rectangles are
        ; the ones layout computed.
        def page:EVGElement (EVGA11yTest.menubarTree())
        def lay (new EVGLayout())
        lay.setPageSize(800.0 600.0)
        lay.layout(page)
        def b (new EVGA11yFromTree())
        def dt:EVGA11yTree (b.build(page "Ranger UI" 7 "trigger-file"))

        def bar:EVGA11yNode (EVGA11yTest.nodeById(dt "bar"))
        c.eqStr("the bar is a menubar" (EVGA11yRole.ariaName(bar.role)) "menubar")
        c.eqStr("named by its label" bar.name "Main")
        ; The element parent of the trigger is `menu-file`, which has no role.
        ; A tree that reported it would hand a reader a group that is not there.
        def trig:EVGA11yNode (EVGA11yTest.nodeById(dt "trigger-file"))
        c.eqStr("the trigger hangs off the menubar, not off the layout box"
            trig.parentId "bar")
        c.eqInt("and says it is open" trig.expanded 2)
        c.ok("and can be focused" trig.focusable)

        def row:EVGA11yNode (EVGA11yTest.nodeById(dt "row-new-tab"))
        ; The row itself has no text. Its name comes from the boxes inside it,
        ; exactly as an HTML name comes from an element's contents.
        c.eqStr("a row is named by what it contains" row.name "New Tab ⌘ T")
        def chk:EVGA11yNode (EVGA11yTest.nodeById(dt "row-urls"))
        c.eqStr("a checkbox row is a menuitemcheckbox"
            (EVGA11yRole.ariaName(chk.role)) "menuitemcheckbox")
        c.eqInt("and it is ticked" chk.checked 2)

        ; The surface is out of flow and was MOVED by the overlay pass. Its
        ; accessible rectangle has to be where it ended up: a magnifier and
        ; touch exploration both use it, and this is the case a hand-written
        ; parallel tree gets wrong first.
        def menuNode:EVGA11yNode (EVGA11yTest.nodeById(dt "menu-file-content"))
        c.ok("the surface reports the rectangle it was moved to" (menuNode.y > 30))
        c.eqInt("focus is where the caller put it" (EVGA11yTest.focusedCount(dt)) 1)
        c.lintsClean("a derived tree" dt)

        print ""
        print ("passed " + (to_string c.passed) + ", failed " + (to_string c.failed))
        if (c.failed > 0) {
            print "FAILED"
        } {
            print "OK"
        }
    }

    sfn nodeById:EVGA11yNode (t:EVGA11yTree id:string) {
        def i:int 0
        while (i < (t.count())) {
            def n:EVGA11yNode (t.at(i))
            if (n.id == id) {
                return n
            }
            i = (i + 1)
        }
        ; An empty node rather than a crash: a wrong id then fails the
        ; assertion that asked for it, and says which one.
        return (new EVGA11yNode)
    }

    sfn focusedCount:int (t:EVGA11yTree) {
        def n:int 0
        def i:int 0
        while (i < (t.count())) {
            if ((t.at(i)).focused) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    sfn hasSub:boolean (hay:string needle:string) {
        def n:int (strlen needle)
        def m:int (strlen hay)
        if (n == 0) {
            return true
        }
        def i:int 0
        while ((i + n) <= m) {
            if ((substring hay i (i + n)) == needle) {
                return true
            }
            i = (i + 1)
        }
        return false
    }
}

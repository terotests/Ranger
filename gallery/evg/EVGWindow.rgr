; ==============================================================================
; EVGWindow - a small, backend-agnostic window / dialog layer over EVG.
; ==============================================================================
;
; The gallery's document apps (DataGrid, DOCX viewer, PPTX viewer) all present
; through an EVGDisplayList, so a dialog that paints into one works on every
; backend they use — SoftCanvas PNG, WebGL, and anything added later. That is
; the whole reason this lives in gallery/evg rather than inside one app: the
; grid's ad-hoc header popup could not be reused by the other two.
;
; The layer is deliberately small. It owns:
;   * a floating panel with a title bar you can drag
;   * labels, buttons, radio groups, checkboxes and separators
;   * a content area the owner paints itself — what a sticky panel needs
;   * hit-testing and pointer / key routing, with modal capture
;   * painting into an EVGDisplayList
;
; A window is either a DIALOG (modal, sized to its controls, dismissed by a
; button) or a STICKY PANEL (non-modal, resizable, closed by the box in its
; title bar, and holding one content region whose pixels are the owner's).
; Both are the same class because the only difference is which of those fields
; are set — the drag, the frame and the routing are shared.
;
; It does NOT own a font, a canvas, or an event loop. The host passes the
; UITextRenderer it already has for measurement, forwards the pointer and keys
; it already receives, and appends the window's commands to its own display
; list. Everything is integer geometry, so behaviour is identical on every
; target and can be unit-tested without rendering.
; ==============================================================================

Import "EVGColor.rgr"
Import "EVGDisplayList.rgr"
Import "../game_engine/ui/UITextRenderer.rgr"
Import "../game_engine/ui/UIInput.rgr"

class EVGControlKind {
    sfn label:int ()     { return 0 }
    sfn button:int ()    { return 1 }
    sfn radio:int ()     { return 2 }
    sfn checkbox:int ()  { return 3 }
    sfn separator:int () { return 4 }
    ; A region the window reserves but does not paint: the owner draws into it
    ; once the frame is down. A chart is the reason it exists.
    sfn content:int ()   { return 5 }
    ; A one-line text field. Find and replace is the reason it exists: a dialog
    ; that cannot be typed into can only ask yes-or-no questions.
    sfn input:int ()     { return 6 }
    ; A coloured square in a palette. `value` holds the hex (#RRGGBB); the
    ; group / checked fields work like a radio so one swatch is the choice.
    sfn swatch:int ()    { return 7 }
    ; A small square icon button drawn OVER the window rather than laid out
    ; under it, and only while the window is the one being worked with.
    ; `value` names the glyph — the drawing is rectangles, not a font, so a
    ; host that has loaded no face still gets an icon. A chart on a sheet is
    ; the reason it exists: two labelled buttons under a picture are most of
    ; what made the picture look like a dialog.
    sfn tool:int ()      { return 8 }
}

class EVGControl {
    def id:int 0
    def kind:int 0
    def text:string ""
    def x:int 0
    def y:int 0
    def w:int 0
    def h:int 0
    def group:int 0
    def checked:boolean false
    def enabled:boolean true
    ; Text fields only: what has been typed, and where the caret sits in it.
    def value:string ""
    def caret:int 0
    ; A default button also fires on Enter.
    def isDefault:boolean false

    Constructor () {
    }

    fn contains:boolean (px:int py:int) {
        if (px < x) {
            return false
        }
        if (py < y) {
            return false
        }
        if (px >= (x + w)) {
            return false
        }
        if (py >= (y + h)) {
            return false
        }
        return true
    }
}

class EVGWindowTheme {
    def panel:EVGColor (EVGColor.rgb(252 253 255))
    def titleBg:EVGColor (EVGColor.rgb(31 78 121))
    def titleText:EVGColor (EVGColor.rgb(255 255 255))
    def text:EVGColor (EVGColor.rgb(32 38 48))
    def muted:EVGColor (EVGColor.rgb(120 130 145))
    def border:EVGColor (EVGColor.rgb(70 110 160))
    def buttonBg:EVGColor (EVGColor.rgb(238 242 248))
    def buttonHot:EVGColor (EVGColor.rgb(219 231 245))
    def accent:EVGColor (EVGColor.rgb(26 115 232))
    def scrim:EVGColor (EVGColor.create(20.0 30.0 45.0 0.28))
    ; A bare panel's edge: a hairline, not the blue rule a dialog wears.
    def hairline:EVGColor (EVGColor.rgb(206 212 222))
    ; Two passes of this under the bottom-right of a bare panel is enough
    ; shadow to lift it off the page without looking like a drop shadow.
    def shadow:EVGColor (EVGColor.create(20.0 30.0 45.0 0.07))
    def toolBg:EVGColor (EVGColor.rgb(255 255 255))
    def toolIcon:EVGColor (EVGColor.rgb(74 84 98))

    Constructor () {
    }
}

class EVGWindow {
    ; Identity, assigned by the manager on add. Used for the z-order shuffle,
    ; which has to tell one window from another without comparing references.
    def wid:int 0
    def title:string ""
    def x:int 0
    def y:int 0
    def w:int 300
    def h:int 160
    def visible:boolean false
    def modal:boolean true
    def controls:[EVGControl]
    def theme:EVGWindowTheme (new EVGWindowTheme)
    def titleH:int 26
    def padX:int 14
    def padY:int 10
    def rowH:int 22
    def fontSize:double 13.0
    ; Control id activated on the last pointer / key pass, or -1.
    def activated:int -1
    def hot:int -1
    def dragging:boolean false
    def dragDX:int 0
    def dragDY:int 0
    ; Where the next added control goes.
    def cursorY:int 0
    ; Column layout. A list of eight radio buttons is eight rows tall, which is
    ; taller than a dialog wants to be; `beginColumns` lays the next controls
    ; out side by side instead, in the same order.
    def columns:int 1
    ; How wide the control FLOW is allowed to be. Zero means the whole panel,
    ; which is what nearly every dialog wants. A dialog that puts something
    ; beside its controls — a live preview — sets this to the width of the
    ; column the controls own, so nothing is laid out underneath the picture.
    def flowW:int 0
    def colIndex:int 0
    def colTop:int 0
    def colRowH:int 0
    ; Which text field has the keyboard, or -1. Clicking one focuses it; Tab
    ; walks them in the order they were added.
    def focusedId:int -1
    ; How wide the label in front of a text field is. One number rather than a
    ; per-field measurement, so the fields line up.
    def labelW:int 96

    ; --- sticky panel ---------------------------------------------------------
    ; A close box in the title bar. `closeId` is what `activated` reports when
    ; it is clicked, so the host reads it exactly like a button.
    def closable:boolean false
    def closeId:int -1
    ; A grip in the bottom-right corner. Resizing stretches the content control,
    ; which is why only a window with one is worth resizing.
    def resizable:boolean false
    def minW:int 160
    def minH:int 120
    def sizing:boolean false
    def sizeW0:int 0
    def sizeH0:int 0
    def sizeX0:int 0
    def sizeY0:int 0
    ; Set once the window carries a content control, so paint knows to leave
    ; that rectangle alone.
    def hasContent:boolean false
    def contentId:int -1
    ; Bumped every time the content rectangle changes size, so an owner that
    ; caches rendered pixels knows when the cache went stale.
    def contentVersion:int 0

    ; --- bare panel -----------------------------------------------------------
    ; A window with no title bar and no button row: the picture IS the window.
    ; A chart on a spreadsheet is a thing sitting on the page, not a dialog
    ; floating over it, and the frame that said "dialog" — a dark caption bar
    ; with the range written across it, a close box, two labelled buttons under
    ; the drawing — was most of what a chart looked like.
    ;
    ; Bare changes three things and nothing else:
    ;   * the frame is a hairline and a hint of shadow instead of a caption bar,
    ;     and it takes the accent colour while the panel is the selected one;
    ;   * the whole body is the drag handle, because there is no bar to grab;
    ;   * what would have been the button row becomes `addTool` icons drawn
    ;     over the top-right corner, shown only while `toolsOpen`.
    def bare:boolean false
    def toolsOpen:boolean false
    def toolSide:int 22
    def toolGap:int 4
    def toolPad:int 6

    Constructor () {
    }

    ; --- building -------------------------------------------------------------
    ; How much of the top the frame itself owns. A bare panel owns none of it:
    ; its content starts at the padding.
    fn topInset:int () {
        if bare {
            return 0
        }
        return titleH
    }

    fn reset:void () {
        clear controls
        cursorY = ((this.topInset()) + padY)
        toolsOpen = false
        activated = -1
        hot = -1
        columns = 1
        colIndex = 0
        focusedId = -1
        flowW = 0
    }

    fn addControl:EVGControl (id:int kind:int text:string height:int) {
        def c:EVGControl (new EVGControl)
        c.id = id
        c.kind = kind
        c.text = text
        c.h = height
        def flow:int (this.flowWidth())
        if (columns > 1) {
            def cw:int (idiv flow columns)
            c.x = (padX + (colIndex * cw))
            c.y = colTop
            c.w = (cw - 8)
            colRowH = height
            colIndex = (colIndex + 1)
            if (colIndex >= columns) {
                colIndex = 0
                colTop = ((colTop + height) + 4)
            }
        } {
            c.x = padX
            c.y = cursorY
            c.w = flow
            cursorY = ((cursorY + height) + 4)
        }
        push controls c
        return c
    }

    ; The width controls are laid out into: the panel minus its margins, or
    ; the narrower flow a dialog asked for.
    fn flowWidth:int () {
        def full:int (w - (padX * 2))
        if (flowW <= 0) {
            return full
        }
        if (flowW > full) {
            return full
        }
        return flowW
    }

    fn beginColumns:void (n:int) {
        if (n < 1) {
            return
        }
        columns = n
        colIndex = 0
        colTop = cursorY
        colRowH = rowH
    }

    fn endColumns:void () {
        cursorY = colTop
        if (colIndex > 0) {
            cursorY = ((colTop + colRowH) + 4)
        }
        columns = 1
        colIndex = 0
    }

    fn addLabel:void (text:string) {
        this.addControl(-1 (EVGControlKind.label()) text rowH)
    }

    fn addSeparator:void () {
        this.addControl(-1 (EVGControlKind.separator()) "" 8)
    }

    fn addRadio:void (id:int text:string group:int selected:boolean) {
        def c:EVGControl (this.addControl(id (EVGControlKind.radio()) text rowH))
        c.group = group
        c.checked = selected
    }

    fn addCheckbox:void (id:int text:string selected:boolean) {
        def c:EVGControl (this.addControl(id (EVGControlKind.checkbox()) text rowH))
        c.checked = selected
    }

    ; A palette chip. Laid out in columns like radios; the square is fixed so
    ; a ten-wide row stays even when the panel is a little wider than it needs.
    fn addSwatch:void (id:int hex:string group:int selected:boolean) {
        def side:int 26
        def c:EVGControl (this.addControl(id (EVGControlKind.swatch()) "" side))
        c.value = hex
        c.group = group
        c.checked = selected
        ; Keep the hit box square; column layout may have given a wider slot.
        if (c.w != side) {
            c.w = side
        }
    }

    ; A region the window will not paint. The owner reads `contentX/Y/W/H` and
    ; draws whatever it likes there — the window only guarantees the rectangle
    ; is inside the frame and moves with it.
    fn addContent:void (id:int height:int) {
        def c:EVGControl (this.addControl(id (EVGControlKind.content()) "" height))
        hasContent = true
        contentId = id
    }

    ; A content region placed by hand rather than in the flow — what a dialog
    ; needs when something has to sit BESIDE its controls instead of under
    ; them. A live preview is the case: put the options down the left, the
    ; picture down the right, and neither has to know how tall the other is.
    fn addContentAt:void (id:int x0:int y0:int w0:int h0:int) {
        def c:EVGControl (new EVGControl)
        c.id = id
        c.kind = (EVGControlKind.content())
        c.x = x0
        c.y = y0
        c.w = w0
        c.h = h0
        push controls c
        hasContent = true
        contentId = id
    }

    ; Make sure the panel is at least this tall. `finish` sizes it to the
    ; control FLOW, which knows nothing about anything placed beside it.
    fn growHeight:void (minH:int) {
        if (h < minH) {
            h = minH
        }
    }

    fn contentControl:EVGControl () {
        return (this.controlById(contentId))
    }

    fn contentX:int () {
        def c:EVGControl (this.contentControl())
        return (x + c.x)
    }

    fn contentY:int () {
        def c:EVGControl (this.contentControl())
        return (y + c.y)
    }

    fn contentW:int () {
        def c:EVGControl (this.contentControl())
        return c.w
    }

    fn contentH:int () {
        def c:EVGControl (this.contentControl())
        return c.h
    }

    ; Resize the panel and give every pixel gained or lost to the content
    ; control. Controls below it (a button row) ride along.
    fn setSize:void (nw:int nh:int) {
        def wantW:int nw
        def wantH:int nh
        if (wantW < minW) {
            wantW = minW
        }
        if (wantH < minH) {
            wantH = minH
        }
        if (wantW == w) {
            if (wantH == h) {
                return
            }
        }
        def dw:int (wantW - w)
        def dh:int (wantH - h)
        w = wantW
        h = wantH
        def i:int 0
        def past:boolean false
        while (i < (array_length controls)) {
            def c:EVGControl (itemAt controls i)
            if (c.kind == (EVGControlKind.tool())) {
                ; Placed from the corner by `layoutTools` below, not carried.
            } {
            if (c.kind == (EVGControlKind.button())) {
                ; Buttons are laid out from the right edge and sit under the
                ; content, so they follow both.
                c.x = (c.x + dw)
                c.y = (c.y + dh)
            } {
                if (c.id == contentId) {
                    if hasContent {
                        c.w = (c.w + dw)
                        c.h = (c.h + dh)
                        past = true
                        contentVersion = (contentVersion + 1)
                    }
                } {
                    if past {
                        c.y = (c.y + dh)
                    } {
                        c.w = (c.w + dw)
                    }
                }
            }
            }
            i = (i + 1)
        }
        this.layoutTools()
    }

    ; A one-line text field with a label in front of it.
    fn addInput:void (id:int label:string value:string) {
        def c:EVGControl (this.addControl(id (EVGControlKind.input()) label (rowH + 4)))
        c.value = value
        c.caret = (strlen value)
        if (focusedId < 0) {
            focusedId = id
        }
    }

    fn inputValue:string (id:int) {
        def c:EVGControl (this.controlById(id))
        return c.value
    }

    fn setInputValue:void (id:int value:string) {
        def c:EVGControl (this.controlById(id))
        c.value = value
        c.caret = (strlen value)
    }

    fn focusedControl:EVGControl () {
        return (this.controlById(focusedId))
    }

    ; Tab walks the text fields, wrapping. A dialog with one field has nowhere
    ; to go, which is the same as staying put.
    fn focusNext:void () {
        def ids:[int]
        def i:int 0
        while (i < (array_length controls)) {
            def c:EVGControl (itemAt controls i)
            if (c.kind == (EVGControlKind.input())) {
                if c.enabled {
                    push ids c.id
                }
            }
            i = (i + 1)
        }
        def n:int (array_length ids)
        if (n == 0) {
            return
        }
        def at:int -1
        def k:int 0
        while (k < n) {
            if ((itemAt ids k) == focusedId) {
                at = k
            }
            k = (k + 1)
        }
        def next:int (at + 1)
        if (next >= n) {
            next = 0
        }
        focusedId = (itemAt ids next)
    }

    ; Buttons sit at the bottom, laid out right to left so the default one is
    ; in the corner the eye goes to.
    ;
    ; The width is NEGOTIATED rather than fixed. A fixed 92 pixels is fine for
    ; two buttons and runs off the left edge with four — which is exactly what
    ; "Close / Replace all / Replace / Find next" did in a 340-wide dialog: the
    ; first button was laid out at x = -66, outside its own panel. So the row
    ; is fitted to the space it has: shrink the buttons towards a legible
    ; minimum, and when even that will not fit, wrap onto another row rather
    ; than overflow. A dialog can then add the buttons it needs without also
    ; having to know how wide its own panel happens to be.
    fn addButtonRow:void (ids:[int] labels:[string] defaultId:int) {
        def n:int (array_length ids)
        if (n == 0) {
            return
        }
        def bh:int 26
        def gap:int 8
        def maxW:int 92
        def minW:int 56
        def avail:int (w - (padX * 2))

        ; How many still fit on one row at the narrowest width worth drawing.
        def perRow:int n
        while (perRow > 1) {
            def need:int ((perRow * minW) + ((perRow - 1) * gap))
            if (need <= avail) {
                break
            }
            perRow = (perRow - 1)
        }
        def bw:int (idiv (avail - ((perRow - 1) * gap)) perRow)
        if (bw > maxW) {
            bw = maxW
        }
        if (bw < 24) {
            bw = 24
        }

        def rowY:int (cursorY + 6)
        def placed:int 0
        while (placed < n) {
            ; This row's slice, right-aligned like the row above it.
            def count:int (n - placed)
            if (count > perRow) {
                count = perRow
            }
            def right:int (w - padX)
            def i:int ((placed + count) - 1)
            while (i >= placed) {
                def c:EVGControl (new EVGControl)
                c.id = (itemAt ids i)
                c.kind = (EVGControlKind.button())
                c.text = (itemAt labels i)
                c.w = bw
                c.h = bh
                c.x = (right - bw)
                if (c.x < padX) {
                    c.x = padX
                }
                c.y = rowY
                if (c.id == defaultId) {
                    c.isDefault = true
                }
                push controls c
                right = ((right - bw) - gap)
                i = (i - 1)
            }
            placed = (placed + count)
            if (placed < n) {
                rowY = ((rowY + bh) + gap)
            }
        }
        cursorY = ((rowY + bh) + padY)
    }

    ; Call once the controls are in: sizes the panel to its content.
    fn finish:void () {
        h = cursorY
        def floor:int ((this.topInset()) + 40)
        if (h < floor) {
            h = floor
        }
        this.layoutTools()
    }

    ; --- the tool strip -------------------------------------------------------
    ; A small icon button over the top-right corner. `glyph` is one of "copy",
    ; "edit", "close" or "chevron"; anything else draws a dot, which is a
    ; visible question rather than an invisible one.
    fn addTool:void (id:int glyph:string) {
        def c:EVGControl (new EVGControl)
        c.id = id
        c.kind = (EVGControlKind.tool())
        c.value = glyph
        c.w = toolSide
        c.h = toolSide
        push controls c
        this.layoutTools()
    }

    fn toolCount:int () {
        def n:int 0
        def i:int 0
        while (i < (array_length controls)) {
            def c:EVGControl (itemAt controls i)
            if (c.kind == (EVGControlKind.tool())) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; Anchored to the top-right corner rather than laid out in the flow, so a
    ; resize does not have to remember to move them: they are placed from the
    ; edge every time the edge moves.
    fn layoutTools:void () {
        def n:int (this.toolCount())
        if (n == 0) {
            return
        }
        def span:int ((n * toolSide) + ((n - 1) * toolGap))
        def x0:int ((w - toolPad) - span)
        if (x0 < toolPad) {
            x0 = toolPad
        }
        def seen:int 0
        def i:int 0
        while (i < (array_length controls)) {
            def c:EVGControl (itemAt controls i)
            if (c.kind == (EVGControlKind.tool())) {
                c.w = toolSide
                c.h = toolSide
                c.x = (x0 + (seen * (toolSide + toolGap)))
                c.y = toolPad
                seen = (seen + 1)
            }
            i = (i + 1)
        }
    }

    ; Open at (px, py), but never off the page: a dialog whose buttons are
    ; below the bottom edge cannot be answered.
    fn openWithin:void (px:int py:int pageW:int pageH:int) {
        def ox:int px
        def oy:int py
        if ((ox + w) > pageW) {
            ox = (pageW - (w + 8))
        }
        if (ox < 4) {
            ox = 4
        }
        if ((oy + h) > pageH) {
            oy = (pageH - (h + 8))
        }
        if (oy < 4) {
            oy = 4
        }
        this.openAt(ox oy)
    }

    fn openAt:void (px:int py:int) {
        x = px
        y = py
        visible = true
        activated = -1
        dragging = false
    }

    fn close:void () {
        visible = false
        dragging = false
        hot = -1
    }

    ; --- state ----------------------------------------------------------------
    fn controlById:EVGControl (id:int) {
        def i:int 0
        while (i < (array_length controls)) {
            def c:EVGControl (itemAt controls i)
            if (c.id == id) {
                return c
            }
            i = (i + 1)
        }
        return (new EVGControl)
    }

    fn isChecked:boolean (id:int) {
        def c:EVGControl (this.controlById(id))
        return c.checked
    }

    fn setChecked:void (id:int value:boolean) {
        def c:EVGControl (this.controlById(id))
        c.checked = value
    }

    ; Selecting a radio or swatch clears the rest of its group.
    fn selectRadio:void (id:int) {
        def target:EVGControl (this.controlById(id))
        def g:int target.group
        def i:int 0
        while (i < (array_length controls)) {
            def c:EVGControl (itemAt controls i)
            def exclusive:boolean false
            if (c.kind == (EVGControlKind.radio())) {
                exclusive = true
            }
            if (c.kind == (EVGControlKind.swatch())) {
                exclusive = true
            }
            if exclusive {
                if (c.group == g) {
                    c.checked = false
                }
            }
            i = (i + 1)
        }
        target.checked = true
    }

    fn selectedInGroup:int (group:int) {
        def i:int 0
        while (i < (array_length controls)) {
            def c:EVGControl (itemAt controls i)
            def exclusive:boolean false
            if (c.kind == (EVGControlKind.radio())) {
                exclusive = true
            }
            if (c.kind == (EVGControlKind.swatch())) {
                exclusive = true
            }
            if exclusive {
                if (c.group == group) {
                    if c.checked {
                        return c.id
                    }
                }
            }
            i = (i + 1)
        }
        return -1
    }

    ; Hex of the checked swatch in a group, or "" when none / not a swatch.
    fn selectedSwatchValue:string (group:int) {
        def id:int (this.selectedInGroup(group))
        if (id < 0) {
            return ""
        }
        def c:EVGControl (this.controlById(id))
        if (c.kind != (EVGControlKind.swatch())) {
            return ""
        }
        return c.value
    }

    fn defaultButtonId:int () {
        def i:int 0
        while (i < (array_length controls)) {
            def c:EVGControl (itemAt controls i)
            if c.isDefault {
                return c.id
            }
            i = (i + 1)
        }
        return -1
    }

    ; --- hit-testing ----------------------------------------------------------
    fn containsPoint:boolean (px:int py:int) {
        if (px < x) {
            return false
        }
        if (py < y) {
            return false
        }
        if (px >= (x + w)) {
            return false
        }
        if (py >= (y + h)) {
            return false
        }
        return true
    }

    fn onTitleBar:boolean (px:int py:int) {
        if ((this.containsPoint(px py)) == false) {
            return false
        }
        if bare {
            return false
        }
        return (py < (y + titleH))
    }

    ; What a press has to land on to start a drag. A dialog gives you the
    ; caption bar; a bare panel has none, so it gives you the whole body —
    ; which is also what the ask was, in as many words: drag it by its
    ; contents. The tools and the grip are checked before this, so the two
    ; things that are NOT a handle never become one.
    fn onDragHandle:boolean (px:int py:int) {
        if ((this.containsPoint(px py)) == false) {
            return false
        }
        if bare {
            return true
        }
        return (py < (y + titleH))
    }

    ; The close box lives at the right end of the title bar; the resize grip in
    ; the bottom-right corner. Both are fixed 14-pixel squares so a host can
    ; reason about them without asking.
    fn boxSide:int () {
        return 14
    }

    fn onCloseBox:boolean (px:int py:int) {
        if (closable == false) {
            return false
        }
        if bare {
            return false
        }
        def side:int (this.boxSide())
        def bx:int ((x + w) - (side + 8))
        def by:int (y + (idiv (titleH - side) 2))
        if (px < bx) {
            return false
        }
        if (py < by) {
            return false
        }
        if (px >= (bx + side)) {
            return false
        }
        return (py < (by + side))
    }

    fn onResizeGrip:boolean (px:int py:int) {
        if (resizable == false) {
            return false
        }
        if bare {
            ; The grip is part of the chrome, and a bare panel wears its
            ; chrome only while it is the one being worked with.
            if (toolsOpen == false) {
                return false
            }
        }
        def side:int (this.boxSide())
        def gx:int ((x + w) - side)
        def gy:int ((y + h) - side)
        if (px < gx) {
            return false
        }
        if (py < gy) {
            return false
        }
        if (px >= (gx + side)) {
            return false
        }
        return (py < (gy + side))
    }

    ; Control under the pointer, or -1. Coordinates are window-relative inside.
    fn controlAt:int (px:int py:int) {
        if ((this.containsPoint(px py)) == false) {
            return -1
        }
        def lx:int (px - x)
        def ly:int (py - y)
        def i:int 0
        while (i < (array_length controls)) {
            def c:EVGControl (itemAt controls i)
            def interactive:boolean false
            if (c.kind == (EVGControlKind.button())) {
                interactive = true
            }
            if (c.kind == (EVGControlKind.radio())) {
                interactive = true
            }
            if (c.kind == (EVGControlKind.checkbox())) {
                interactive = true
            }
            if (c.kind == (EVGControlKind.input())) {
                interactive = true
            }
            if (c.kind == (EVGControlKind.swatch())) {
                interactive = true
            }
            if (c.kind == (EVGControlKind.tool())) {
                interactive = toolsOpen
            }
            if (interactive && c.enabled) {
                if (c.contains(lx ly)) {
                    return c.id
                }
            }
            i = (i + 1)
        }
        return -1
    }

    ; --- input ----------------------------------------------------------------
    ; Returns true when the window consumed the event, so the host can skip its
    ; own handling. A modal window swallows everything outside it too.
    fn handlePointer:boolean (px:int py:int pressed:boolean down:boolean released:boolean) {
        activated = -1
        if (visible == false) {
            return false
        }
        hot = (this.controlAt(px py))
        if sizing {
            if down {
                this.setSize((sizeW0 + (px - sizeX0)) (sizeH0 + (py - sizeY0)))
                return true
            }
            sizing = false
            return true
        }
        if dragging {
            if down {
                x = (px - dragDX)
                y = (py - dragDY)
                return true
            }
            dragging = false
            return true
        }
        if pressed {
            if (this.onCloseBox(px py)) {
                activated = closeId
                this.close()
                return true
            }
            if (this.onResizeGrip(px py)) {
                sizing = true
                sizeX0 = px
                sizeY0 = py
                sizeW0 = w
                sizeH0 = h
                return true
            }
            ; Controls first, THEN the handle. On a dialog the two never
            ; overlap — nothing is laid out into the caption bar — but on a
            ; bare panel the handle is the whole body, so asking about the
            ; handle first would swallow every tool click.
            def id:int (this.controlAt(px py))
            if (id >= 0) {
                def c:EVGControl (this.controlById(id))
                if (c.kind == (EVGControlKind.radio())) {
                    this.selectRadio(id)
                }
                if (c.kind == (EVGControlKind.swatch())) {
                    this.selectRadio(id)
                    activated = id
                }
                if (c.kind == (EVGControlKind.checkbox())) {
                    c.checked = (c.checked == false)
                }
                if (c.kind == (EVGControlKind.button())) {
                    activated = id
                }
                if (c.kind == (EVGControlKind.input())) {
                    focusedId = id
                    c.caret = (strlen c.value)
                }
                if (c.kind == (EVGControlKind.tool())) {
                    activated = id
                }
                return true
            }
            if (this.onDragHandle(px py)) {
                ; Pressing a bare panel anywhere is also what selects it, and
                ; selecting it is what brings its tools out. The press starts
                ; a drag as well: a press that never moves is a drag of zero
                ; pixels, which is the same as having only selected it.
                if bare {
                    toolsOpen = true
                }
                dragging = true
                dragDX = (px - x)
                dragDY = (py - y)
                return true
            }
            if (this.containsPoint(px py)) {
                return true
            }
            ; Outside a modal window: swallow, so the document behind is safe.
            if modal {
                return true
            }
            return false
        }
        if (this.containsPoint(px py)) {
            return true
        }
        return modal
    }

    ; escapeKey / enterKey are the host's UIKey codes. Only a modal window reads
    ; keys: a sticky panel floats over a document whose keyboard belongs to the
    ; document, and closing it on a stray Escape would be a surprise.
    fn handleKey:boolean (key:int escapeKey:int enterKey:int) {
        activated = -1
        if (visible == false) {
            return false
        }
        if (modal == false) {
            return false
        }
        if (key == escapeKey) {
            this.close()
            return true
        }
        if (key == enterKey) {
            def d:int (this.defaultButtonId())
            if (d >= 0) {
                activated = d
            }
            return true
        }
        if (key == (UIKey.tab())) {
            this.focusNext()
            return true
        }
        def f:EVGControl (this.focusedControl())
        if (f.kind == (EVGControlKind.input())) {
            def n:int (strlen f.value)
            if (f.caret > n) {
                f.caret = n
            }
            if (key == (UIKey.backspace())) {
                if (f.caret > 0) {
                    f.value = ((substring f.value 0 (f.caret - 1)) + (substring f.value f.caret n))
                    f.caret = (f.caret - 1)
                }
                return true
            }
            if (key == (UIKey.del())) {
                if (f.caret < n) {
                    f.value = ((substring f.value 0 f.caret) + (substring f.value (f.caret + 1) n))
                }
                return true
            }
            if (key == (UIKey.left())) {
                if (f.caret > 0) {
                    f.caret = (f.caret - 1)
                }
                return true
            }
            if (key == (UIKey.right())) {
                if (f.caret < n) {
                    f.caret = (f.caret + 1)
                }
                return true
            }
            if (key == (UIKey.home())) {
                f.caret = 0
                return true
            }
            if (key == (UIKey.end())) {
                f.caret = n
                return true
            }
        }
        return modal
    }

    ; Characters typed this frame. The host forwards what it would otherwise
    ; have given the document.
    fn handleText:boolean (s:string) {
        if (visible == false) {
            return false
        }
        if ((strlen s) == 0) {
            return modal
        }
        def f:EVGControl (this.focusedControl())
        if (f.kind != (EVGControlKind.input())) {
            return modal
        }
        def n:int (strlen f.value)
        if (f.caret > n) {
            f.caret = n
        }
        f.value = (((substring f.value 0 f.caret) + s) + (substring f.value f.caret n))
        f.caret = (f.caret + (strlen s))
        return true
    }

    ; --- painting -------------------------------------------------------------
    fn rect:void (dl:EVGDisplayList rx:int ry:int rw:int rh:int col:EVGColor) {
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 0
        c.x = (to_double rx)
        c.y = (to_double ry)
        c.w = (to_double rw)
        c.h = (to_double rh)
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push dl.cmds c
    }

    fn frame:void (dl:EVGDisplayList rx:int ry:int rw:int rh:int thick:double col:EVGColor) {
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 1
        c.x = (to_double rx)
        c.y = (to_double ry)
        c.w = (to_double rw)
        c.h = (to_double rh)
        c.thickness = thick
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push dl.cmds c
    }

    fn text:void (dl:EVGDisplayList s:string tx:int ty:int size:double col:EVGColor tr:UITextRenderer bold:boolean) {
        if ((strlen s) == 0) {
            return
        }
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 3
        c.x = (to_double tx)
        c.y = (to_double ty)
        c.w = (tr.measureWidth(s size))
        c.h = (tr.lineHeight(size))
        c.text = s
        c.fontFamily = tr.fontFamily
        c.fontSize = size
        if bold {
            c.fontWeight = "bold"
        }
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push dl.cmds c
    }

    ; Appends this window to the host's display list. `pageW/pageH` are only
    ; used to draw the modal scrim behind it.
    fn paint:void (dl:EVGDisplayList tr:UITextRenderer pageW:int pageH:int) {
        if (visible == false) {
            return
        }
        if modal {
            this.rect(dl 0 0 pageW pageH theme.scrim)
        }
        if bare {
            ; Two offset washes for a shadow, the panel, and one hairline —
            ; which becomes the accent while this is the panel being worked
            ; with, so "selected" is a change of colour rather than a change
            ; of furniture.
            this.rect(dl (x + 1) (y + 2) w h theme.shadow)
            this.rect(dl (x + 2) (y + 3) w h theme.shadow)
            this.rect(dl x y w h theme.panel)
            def edge0:EVGColor theme.hairline
            if toolsOpen {
                edge0 = theme.accent
            }
            this.frame(dl x y w h 1.0 edge0)
        } {
        this.rect(dl x y w h theme.panel)
        this.frame(dl x y w h 1.0 theme.border)
        this.rect(dl x y w titleH theme.titleBg)
        this.text(dl title (x + padX) (y + 6) fontSize theme.titleText tr true)
        if closable {
            def side:int (this.boxSide())
            def bx:int ((x + w) - (side + 8))
            def by:int (y + (idiv (titleH - side) 2))
            this.frame(dl bx by side side 1.0 theme.titleText)
            ; An x drawn as two thin bars, because a glyph would need a face
            ; the host may not have loaded.
            this.rect(dl (bx + 3) (by + (idiv side 2)) (side - 6) 1 theme.titleText)
            this.rect(dl (bx + (idiv side 2)) (by + 3) 1 (side - 6) theme.titleText)
        }
        }
        def i:int 0
        while (i < (array_length controls)) {
            def c:EVGControl (itemAt controls i)
            def cx:int (x + c.x)
            def cy:int (y + c.y)
            if (c.kind == (EVGControlKind.label())) {
                this.text(dl c.text cx (cy + 4) fontSize theme.text tr false)
            }
            if (c.kind == (EVGControlKind.content())) {
                ; The owner's rectangle: only the recess is ours — and a bare
                ; panel has no recess, because a sunken border around a
                ; picture that already has a border is the second frame the
                ; chart did not need.
                this.rect(dl cx cy c.w c.h theme.panel)
                if (bare == false) {
                    this.frame(dl cx cy c.w c.h 1.0 theme.muted)
                }
            }
            if (c.kind == (EVGControlKind.separator())) {
                this.rect(dl cx (cy + 3) c.w 1 theme.muted)
            }
            if (c.kind == (EVGControlKind.radio())) {
                def rr:int 12
                def ry2:int (cy + (idiv (c.h - rr) 2))
                ; A choice that would not work is shown greyed rather than
                ; hidden: knowing a pie is possible but not for THIS selection
                ; is worth more than a shorter list.
                def edge:EVGColor theme.border
                def ink:EVGColor theme.text
                if (c.enabled == false) {
                    edge = theme.muted
                    ink = theme.muted
                }
                this.frame(dl cx ry2 rr rr 1.0 edge)
                if c.checked {
                    this.rect(dl (cx + 3) (ry2 + 3) (rr - 6) (rr - 6) theme.accent)
                }
                this.text(dl c.text (cx + rr + 8) (cy + 4) fontSize ink tr false)
            }
            if (c.kind == (EVGControlKind.checkbox())) {
                def br:int 12
                def by2:int (cy + (idiv (c.h - br) 2))
                this.frame(dl cx by2 br br 1.0 theme.border)
                if c.checked {
                    this.rect(dl (cx + 3) (by2 + 3) (br - 6) (br - 6) theme.accent)
                }
                this.text(dl c.text (cx + br + 8) (cy + 4) fontSize theme.text tr false)
            }
            if (c.kind == (EVGControlKind.swatch())) {
                def fill:EVGColor (EVGColor.parse(c.value))
                ; Selected chips get a clear ring: dark outer, light gap, then
                ; the colour — a 2px accent alone disappears on similar hues.
                if c.checked {
                    this.rect(dl (cx - 3) (cy - 3) (c.w + 6) (c.h + 6) (EVGColor.rgb(20 30 45)))
                    this.rect(dl (cx - 2) (cy - 2) (c.w + 4) (c.h + 4) (EVGColor.rgb(255 255 255)))
                } {
                    if (hot == c.id) {
                        this.rect(dl (cx - 2) (cy - 2) (c.w + 4) (c.h + 4) theme.accent)
                        this.rect(dl (cx - 1) (cy - 1) (c.w + 2) (c.h + 2) (EVGColor.rgb(255 255 255)))
                    }
                }
                this.rect(dl cx cy c.w c.h fill)
                def edge3:EVGColor theme.border
                if c.checked {
                    edge3 = theme.accent
                }
                def thick:double 1.0
                if c.checked {
                    thick = 2.0
                }
                this.frame(dl cx cy c.w c.h thick edge3)
                ; A pale chip needs an inner edge so white is still visible on
                ; the panel; the outer frame alone disappears into it.
                if ((fill.r > 230.0) && (fill.g > 230.0) && (fill.b > 230.0)) {
                    this.frame(dl (cx + 1) (cy + 1) (c.w - 2) (c.h - 2) 1.0 theme.muted)
                }
            }
            if (c.kind == (EVGControlKind.input())) {
                def lw:int labelW
                if ((strlen c.text) == 0) {
                    lw = 0
                }
                if (lw > 0) {
                    this.text(dl c.text cx (cy + 5) fontSize theme.text tr false)
                }
                def fx:int (cx + lw)
                def fw:int (c.w - lw)
                this.rect(dl fx cy fw c.h (EVGColor.rgb(255 255 255)))
                def edge2:EVGColor theme.border
                if (focusedId != c.id) {
                    edge2 = theme.muted
                }
                this.frame(dl fx cy fw c.h 1.0 edge2)
                this.text(dl c.value (fx + 5) (cy + 4) fontSize theme.text tr false)
                if (focusedId == c.id) {
                    def upto:string (substring c.value 0 c.caret)
                    def caretX:int (to_int (tr.measureWidth(upto fontSize)))
                    this.rect(dl ((fx + 5) + caretX) (cy + 3) 1 (c.h - 6) theme.text)
                }
            }
            if (c.kind == (EVGControlKind.tool())) {
                ; Drawn by `paintOverlay`, after the owner has painted the
                ; content — a strip drawn here would be under the picture.
            }
            if (c.kind == (EVGControlKind.button())) {
                def bg:EVGColor theme.buttonBg
                if (hot == c.id) {
                    bg = theme.buttonHot
                }
                this.rect(dl cx cy c.w c.h bg)
                def edge:EVGColor theme.border
                if (c.isDefault == false) {
                    edge = theme.muted
                }
                this.frame(dl cx cy c.w c.h 1.0 edge)
                def tw:int (to_int (tr.measureWidth(c.text fontSize)))
                def tx2:int (cx + (idiv (c.w - tw) 2))
                this.text(dl c.text tx2 (cy + 5) fontSize theme.text tr c.isDefault)
            }
            i = (i + 1)
        }
        if resizable {
            def showGrip:boolean true
            def gink:EVGColor theme.muted
            if bare {
                showGrip = toolsOpen
                gink = theme.hairline
            }
            if showGrip {
                def gside:int (this.boxSide())
                def gx:int ((x + w) - gside)
                def gy:int ((y + h) - gside)
                def line:int 0
                while (line < 3) {
                    def off:int (3 + (line * 4))
                    this.rect(dl (gx + off) ((gy + gside) - 3) (gside - off) 1 gink)
                    this.rect(dl ((gx + gside) - 3) (gy + off) 1 (gside - off) gink)
                    line = (line + 1)
                }
            }
        }
    }

    ; --- the tool strip, on top ----------------------------------------------
    ; Called AFTER the owner has painted the content region, because that is
    ; the only order in which a strip over a picture is over it. A window with
    ; no tools, or one nobody has selected, draws nothing at all — which is
    ; the point of the whole arrangement: a chart that is not being worked
    ; with has no furniture on it.
    fn paintOverlay:void (dl:EVGDisplayList tr:UITextRenderer) {
        if (visible == false) {
            return
        }
        if (toolsOpen == false) {
            return
        }
        def i:int 0
        while (i < (array_length controls)) {
            def c:EVGControl (itemAt controls i)
            if (c.kind == (EVGControlKind.tool())) {
                def cx:int (x + c.x)
                def cy:int (y + c.y)
                def bg:EVGColor theme.toolBg
                if (hot == c.id) {
                    bg = theme.buttonHot
                }
                this.rect(dl cx cy c.w c.h bg)
                this.frame(dl cx cy c.w c.h 1.0 theme.hairline)
                this.glyph(dl c.value cx cy c.w c.h theme.toolIcon)
            }
            i = (i + 1)
        }
    }

    ; Icons as rectangles. A glyph would need a face the host may not have
    ; loaded — the close box has always been two bars for that reason — and a
    ; path would need a stencil buffer the GL backend only has for fills. Six
    ; rectangles each, and every backend already draws rectangles.
    fn glyph:void (dl:EVGDisplayList name:string gx:int gy:int gw:int gh:int col:EVGColor) {
        def cx:int (gx + (idiv gw 2))
        def cy:int (gy + (idiv gh 2))
        if (name == "close") {
            def s:int 4
            def k:int (0 - s)
            while (k <= s) {
                this.rect(dl (cx + k) (cy + k) 1 1 col)
                this.rect(dl (cx + k) (cy - k) 1 1 col)
                k = (k + 1)
            }
            return
        }
        if (name == "copy") {
            ; Two sheets, the back one peeking out behind the front.
            this.frame(dl (gx + 5) (gy + 5) 8 9 1.0 col)
            this.rect(dl (gx + 8) (gy + 8) 9 10 (EVGColor.rgb(255 255 255)))
            this.frame(dl (gx + 8) (gy + 8) 9 10 1.0 col)
            return
        }
        if (name == "edit") {
            ; A pencil: a stroke on the diagonal, a nib at the bottom left.
            def k2:int 0
            while (k2 < 8) {
                this.rect(dl ((gx + 6) + k2) ((gy + 13) - k2) 2 2 col)
                k2 = (k2 + 1)
            }
            this.rect(dl (gx + 5) (gy + 15) 3 2 col)
            return
        }
        if (name == "chevron") {
            def k3:int 0
            while (k3 < 4) {
                this.rect(dl ((cx - 4) + k3) ((cy - 2) + k3) 2 2 col)
                this.rect(dl ((cx + 3) - k3) ((cy - 2) + k3) 2 2 col)
                k3 = (k3 + 1)
            }
            return
        }
        this.rect(dl (cx - 2) (cy - 2) 4 4 col)
    }
}

; A stack of windows. The topmost visible one gets input first; painting goes
; bottom-up so it lands on top.
class EVGWindowManager {
    def windows:[EVGWindow]

    Constructor () {
    }

    fn add:void (win:EVGWindow) {
        win.wid = ((array_length windows) + 1)
        push windows win
    }

    ; Take a window out of the stack for good — what a closable panel needs,
    ; since a hidden window still costs a paint check every frame.
    fn remove:void (win:EVGWindow) {
        def keep:[EVGWindow]
        def i:int 0
        while (i < (array_length windows)) {
            def wnd:EVGWindow (itemAt windows i)
            if (wnd.wid != win.wid) {
                push keep wnd
            }
            i = (i + 1)
        }
        clear windows
        def k:int 0
        while (k < (array_length keep)) {
            push windows (itemAt keep k)
            k = (k + 1)
        }
    }

    fn anyVisible:boolean () {
        def i:int 0
        while (i < (array_length windows)) {
            def wnd:EVGWindow (itemAt windows i)
            if wnd.visible {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; What a host asks before it decides the document is inert: a sticky panel
    ; floats over a live document, a dialog does not.
    fn anyModalVisible:boolean () {
        def i:int 0
        while (i < (array_length windows)) {
            def wnd:EVGWindow (itemAt windows i)
            if wnd.visible {
                if wnd.modal {
                    return true
                }
            }
            i = (i + 1)
        }
        return false
    }

    fn topmost:EVGWindow () {
        def i:int ((array_length windows) - 1)
        while (i >= 0) {
            def wnd:EVGWindow (itemAt windows i)
            if wnd.visible {
                return wnd
            }
            i = (i - 1)
        }
        return (new EVGWindow)
    }

    ; Move a window to the top of the stack. Z-order is recency: the window
    ; you last touched is the one in front, and a dialog raises itself when it
    ; opens, which is what keeps it above the panels it was opened over.
    fn raise:void (win:EVGWindow) {
        def keep:[EVGWindow]
        def i:int 0
        while (i < (array_length windows)) {
            def wnd:EVGWindow (itemAt windows i)
            if (wnd.wid != win.wid) {
                push keep wnd
            }
            i = (i + 1)
        }
        clear windows
        def k:int 0
        while (k < (array_length keep)) {
            push windows (itemAt keep k)
            k = (k + 1)
        }
        push windows win
    }

    ; Top-down until one window takes it. Every visible window has its
    ; `activated` cleared first, so a stale click on a panel that is no longer
    ; on top cannot be read a second time.
    fn handlePointer:boolean (px:int py:int pressed:boolean down:boolean released:boolean) {
        def c:int 0
        while (c < (array_length windows)) {
            def w0:EVGWindow (itemAt windows c)
            w0.activated = -1
            c = (c + 1)
        }
        if pressed {
            ; A bare panel's tools belong to the panel being worked with, and
            ; there is only ever one of those. Decided here rather than in the
            ; windows themselves because "somewhere else" is a fact about the
            ; whole stack: the window that was not pressed cannot know it.
            def owner:int -1
            def t:int ((array_length windows) - 1)
            while (t >= 0) {
                def wt:EVGWindow (itemAt windows t)
                if wt.visible {
                    if (wt.containsPoint(px py)) {
                        owner = wt.wid
                        t = -1
                    } {
                        t = (t - 1)
                    }
                } {
                    t = (t - 1)
                }
            }
            ; Only ever CLOSES. Opening is the window's own business, in
            ; `onDragHandle`, and the difference matters: opened here, the
            ; strip would already be open by the time the same press reached
            ; the window, and the very first click on a chart would fire
            ; whichever invisible tool it happened to land on.
            def b:int 0
            while (b < (array_length windows)) {
                def wb:EVGWindow (itemAt windows b)
                if wb.bare {
                    if (wb.wid != owner) {
                        wb.toolsOpen = false
                    }
                }
                b = (b + 1)
            }
        }
        def i:int ((array_length windows) - 1)
        while (i >= 0) {
            def wnd:EVGWindow (itemAt windows i)
            if wnd.visible {
                if (wnd.handlePointer(px py pressed down released)) {
                    if pressed {
                        this.raise(wnd)
                    }
                    return true
                }
            }
            i = (i - 1)
        }
        return false
    }

    fn handleKey:boolean (key:int escapeKey:int enterKey:int) {
        def i:int ((array_length windows) - 1)
        while (i >= 0) {
            def wnd:EVGWindow (itemAt windows i)
            if wnd.visible {
                if (wnd.handleKey(key escapeKey enterKey)) {
                    return true
                }
            }
            i = (i - 1)
        }
        return false
    }

    fn handleText:boolean (s:string) {
        def i:int ((array_length windows) - 1)
        while (i >= 0) {
            def wnd:EVGWindow (itemAt windows i)
            if wnd.visible {
                if (wnd.handleText(s)) {
                    return true
                }
            }
            i = (i - 1)
        }
        return false
    }

    fn paint:void (dl:EVGDisplayList tr:UITextRenderer pageW:int pageH:int) {
        def i:int 0
        while (i < (array_length windows)) {
            def wnd:EVGWindow (itemAt windows i)
            wnd.paint(dl tr pageW pageH)
            wnd.paintOverlay(dl tr)
            i = (i + 1)
        }
    }
}

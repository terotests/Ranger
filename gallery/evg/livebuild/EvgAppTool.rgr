; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; evg_app — an app made of a machine and some pages, walked without a browser
; ==============================================================================
;
;   evg_app states <app>                 every state, its page, its events
;   evg_app press  <app> EVENT…          send events, print where each lands
;   evg_app check  <app> [--width=390 --height=844]
;   evg_app render <app> [EVENT…] [--out=FILE]
;   evg_app hit    <app> X Y [EVENT…]    what a press at that point would send
;   evg_app model  <app>                 the data model: who writes each key, who reads it
;   evg_app memo   <app>                 refresh APP.md — the app's own memory
;   evg_app init   <app> --from=DOC [--states=a,b,c]   an app from a screen
;
; PLAN_LIVE_APP.md, stage S1. The live-build demo designs ONE screen, and a
; screen with a tab bar that does nothing is a picture of an app. This is the
; smallest thing that is not: a statechart owns which page you are on, a page
; is an EVG document, and an element's `id` is the event its press sends.
;
; --- WHY THERE IS NO RANGER IN AN APP -----------------------------------------
;
; The obvious design has the agent write a program. This one has it write
; `machine.json` and `pages/<state>.evg.json` — the two things it already
; knows how to change, with `patch` and `outline` and `measure`. Nothing is
; compiled, so nothing can fail to compile; the app runs the moment the files
; exist. Code comes when data runs out, and an app that only switches screens
; never gets there.
;
; --- WHY `check` IS THE POINT -------------------------------------------------
;
; An app has more than one screen, so it has more than one screen to get
; wrong, and an agent that can see only the page it just edited will leave the
; other four broken. Three defects are invisible without this and fatal with
; it: a state whose page does not exist, a page no state renders, and an id
; that is not an event — a dead button looks exactly like a live one.
; ==============================================================================

Import "../../../lib/ranger-dir.rgr"
Import "EvgAppRules.rgr"
Import "../../statechart/src/Statechart.rgr"
Import "../../statechart/src/StatechartJson.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGHitTest.rgr"
Import "pkg:evg/EVGInspect.rgr"
Import "pkg:evg/EVGLayout.rgr"
Import "pkg:evg/EVGMeasure.rgr"
Import "pkg:evg/EVGTreeJson.rgr"

class EvgAppTool {
    def insp:EVGInspect (new EVGInspect())
    def chart@(optional):Statechart
    def appDir:string ""
    def pageW:int 390
    def pageH:int 844

    Constructor () {
    }

    sfn m@(main):void () {
        def t (new EvgAppTool())
        t.run()
    }

    fn usage:void () {
        print "evg_app — a machine, some pages, and the checks between them"
        print ""
        print "  states <app>                 every state, its page, its events"
        print "  press  <app> EVENT…          send events, print where each lands"
        print "  check  <app> [--width=N] [--height=N]"
        print "  render <app> [EVENT…] [--out=FILE]   the page for the state those events reach"
        print "  hit    <app> X Y [EVENT…]    what a press at that point would send"
        print "  model  <app>                 the data model: who writes each key, who reads it"
        print "  memo   <app>                 refresh APP.md — the app's own memory"
        print "  init   <app> --from=DOC [--states=a,b,c]   an app from a screen"
        print ""
        print "An app is <app>/machine.json and <app>/pages/<state>.evg.json."
    }

    fn run:void () {
        def argc:int (shell_arg_cnt)
        if (argc < 2) {
            this.usage()
            return
        }
        def verb:string (shell_arg 0)
        appDir = (shell_arg 1)
        pageW = (EvgAppTool.intFlag("--width" 390))
        pageH = (EvgAppTool.intFlag("--height" 844))

        ; `init` is the one verb that runs without a machine, because it is
        ; the verb that writes one.
        if (verb == "init") {
            this.init()
            return
        }
        def text@(optional):string (EvgAppTool.slurp(appDir + "/machine.json"))
        if (null? text) {
            print (("{\"error\":\"no machine at " + appDir) + "/machine.json\"}")
            return
        }
        def loaded:Statechart (StatechartJson.load((unwrap text)))
        chart = loaded

        if (verb == "states") {
            this.states(loaded)
            return
        }
        if (verb == "press") {
            this.press(loaded)
            return
        }
        if (verb == "check") {
            this.check(loaded)
            return
        }
        if (verb == "render") {
            this.render(loaded)
            return
        }
        if (verb == "hit") {
            this.hit(loaded)
            return
        }
        if (verb == "model") {
            this.model(loaded)
            return
        }
        if (verb == "memo") {
            this.memo(loaded)
            return
        }
        this.usage()
    }

    ; --- init -----------------------------------------------------------------
    ;
    ; --- WHY A SCREEN IS NOT YET AN APP ---------------------------------------
    ;
    ; A designed phone is a document: it has a tab bar because a phone has one,
    ; and pressing it does nothing because there is nothing behind it. Making
    ; it an app is three small things — a machine, a page per state, and an id
    ; on everything pressable — and the first two are mechanical.
    ;
    ; So this does those two and refuses to guess the third. Every state gets
    ; the same screen to start from, because which parts differ is a design
    ; decision and a tool that invented one would be wrong in a way that is
    ; hard to see. `check` then says exactly what is missing, which is the
    ; loop this toolchain is built on.
    fn init:void () {
        def from:string (EvgAppTool.textFlag("--from" "doc.evg.json"))
        def doc@(optional):string (EvgAppTool.slurp(from))
        if (null? doc) {
            print (("{\"error\":\"no screen at " + from) + "\"}")
            return
        }
        def text:string (unwrap doc)
        def root@(optional):EVGElement (EVGTreeJson.fromText(text))
        if (null? root) {
            print (("{\"error\":\"not an EVG document: " + from) + "\"}")
            return
        }
        ; What the screen already says it does. A tab somebody gave an id of
        ; `nav.kartta` names a state, and reading that is not a guess; asked
        ; for nothing and told nothing, one state is the honest answer.
        def ids:[string]
        this.idsOf((unwrap root) ids)
        def names:[string]
        def asked:string (EvgAppTool.textFlag("--states" ""))
        if ((strlen asked) > 0) {
            EvgAppTool.splitCommas(asked names)
        } {
            def i:int 0
            while (i < (array_length ids)) {
                def id:string (itemAt ids i)
                if ((indexOf id "nav.") == 0) {
                    def name:string (substring id 4 (strlen id))
                    if ((strlen name) > 0) {
                        if ((EvgAppTool.mentions(names name)) == false) {
                            push names name
                        }
                    }
                }
                i = (i + 1)
            }
        }
        if ((array_length names) == 0) {
            push names "main"
        }
        create_dir (appDir + "/pages")
        def i:int 0
        while (i < (array_length names)) {
            EvgAppTool.spit((this.pageOf((itemAt names i))) text)
            i = (i + 1)
        }
        def cIds:[string]
        def cKeys:[string]
        def cInits:[string]
        this.boundControls((unwrap root) cIds cKeys cInits)
        EvgAppTool.spit((appDir + "/machine.json") (EvgAppTool.machineWith(names cIds cKeys cInits)))

        ; What is left, rather than only what was written.
        def missing:[string]
        def k:int 0
        while (k < (array_length names)) {
            def want:string ("nav." + (itemAt names k))
            if ((EvgAppTool.mentions(ids want)) == false) {
                push missing want
            }
            k = (k + 1)
        }
        def out:string "{\"wrote\":"
        out = (out + (EVGTreeJson.str(appDir + "/machine.json")))
        out = ((out + ",\"states\":") + (EvgAppTool.strArray(names)))
        out = ((out + ",\"pages\":") + (to_string (array_length names)))
        out = ((out + ",\"idsOnTheScreen\":") + (to_string (array_length ids)))
        if ((array_length missing) > 0) {
            out = ((out + ",\"missing\":") + (EvgAppTool.strArray(missing)))
            out = (out + ",\"next\":\"the pages are copies of one screen: give what should switch tabs those ids, make each page its own, then run check\"")
        } {
            out = (out + ",\"next\":\"every nav id is already there — make each page its own, then run check\"")
        }
        out = (out + "}")
        print out
    }

    ; One state per name, each taking its own nav event and ignoring it, and
    ; every other state's as a move. That is the smallest machine that makes a
    ; tab bar work, and it is what a tab bar means.
    ; --- controls the machine has to own --------------------------------------
    ; A screen with a bound control on it — `class-name="… ui-switch-state-
    ; {wifi}"` — is telling the machine what it needs: a context key called
    ; `wifi`, and an event that flips it. Writing that by hand is three lines
    ; of JSON per switch and the one thing between "the kit drew me a control"
    ; and "the control works", so `init` reads them off the screen the same
    ; way it reads `nav.*` for the states.
    ;
    ; A press can land on the control or on the row around it, so both ids
    ; take the event: the kit names a piece's control `<row-id>.control`, and
    ; the row is the bigger target.
    fn boundControls:void (el:EVGElement ids:[string] keys:[string] inits:[string]) {
        if ((strlen el.id) > 0) {
            def key:string (EvgAppTool.bindingIn(el.className))
            if ((strlen key) > 0) {
                if ((EvgAppTool.mentions(ids el.id)) == false) {
                    push ids el.id
                    push keys key
                    ; What it is showing now, so the app opens as the screen
                    ; was drawn rather than all off.
                    if (el.a11yChecked == 2) {
                        push inits "checked"
                    } {
                        push inits "unchecked"
                    }
                }
            }
        }
        def i:int 0
        while (i < (array_length el.children)) {
            this.boundControls((itemAt el.children i) ids keys inits)
            i = (i + 1)
        }
    }

    ; The FIRST `{key}` in a class name, which is the state this control is
    ; bound to. A class carries at most one.
    sfn bindingIn:string (className:string) {
        def found:[string]
        EvgAppRules.scanKeys(className found)
        if ((array_length found) > 0) {
            return (itemAt found 0)
        }
        return ""
    }

    ; The two guarded alternatives that are a toggle: the first whose guard
    ; passes wins, so "if it is checked make it unchecked, otherwise make it
    ; checked" is the whole of it — no new action kind and no host function.
    sfn toggleFor:string (event:string key:string) {
        def out:string ("    " + (EVGTreeJson.str(event)) + ": [\n")
        out = (out + "     { \"guard\": { \"is\": { \"context\": " + (EVGTreeJson.str(key)) + " }, \"equals\": \"checked\" },\n")
        out = (out + "       \"actions\": [ { \"assign\": { " + (EVGTreeJson.str(key)) + ": { \"value\": \"unchecked\" } } } ] },\n")
        out = (out + "     { \"actions\": [ { \"assign\": { " + (EVGTreeJson.str(key)) + ": { \"value\": \"checked\" } } } ] }\n")
        return (out + "    ]")
    }

    sfn machineFor:string (names:[string]) {
        def none:[string]
        def none2:[string]
        def none3:[string]
        return (EvgAppTool.machineWith(names none none2 none3))
    }

    sfn machineWith:string (names:[string] ids:[string] keys:[string] inits:[string]) {
        def n:int (array_length names)
        def out:string "{\n \"id\": \"app\",\n \"initial\": "
        out = (out + (EVGTreeJson.str((itemAt names 0))))
        def ctx:string "{}"
        if ((array_length keys) > 0) {
            ctx = "{ "
            def c:int 0
            while (c < (array_length keys)) {
                if (c > 0) {
                    ctx = (ctx + ", ")
                }
                ctx = (ctx + (EVGTreeJson.str((itemAt keys c))) + ": " + (EVGTreeJson.str((itemAt inits c))))
                c = (c + 1)
            }
            ctx = (ctx + " }")
        }
        out = (out + ",\n \"context\": " + ctx + ",\n \"states\": {\n")
        def i:int 0
        while (i < n) {
            def here:string (itemAt names i)
            if (i > 0) {
                out = (out + ",\n")
            }
            out = (((out + "  ") + (EVGTreeJson.str(here))) + ": { \"on\": {\n")
            def j:int 0
            def wrote:int 0
            while (j < n) {
                def there:string (itemAt names j)
                if (wrote > 0) {
                    out = (out + ",\n")
                }
                out = (out + "    ")
                out = (out + (EVGTreeJson.str("nav." + there)))
                if (there == here) {
                    out = (out + ": { \"actions\": [] }")
                } {
                    out = ((out + ": { \"target\": ") + (EVGTreeJson.str(there)))
                    out = (out + " }")
                }
                wrote = (wrote + 1)
                j = (j + 1)
            }
            ; …and every bound control on the screen, in every state, because
            ; the screen is the same one until somebody makes them differ.
            def t:int 0
            while (t < (array_length ids)) {
                def cid:string (itemAt ids t)
                def key:string (itemAt keys t)
                out = (out + ",\n")
                out = (out + (EvgAppTool.toggleFor(cid key)))
                ; A press lands on the control or on the row around it.
                def dot:int (indexOf cid ".control")
                if (dot > 0) {
                    def rowId:string (substring cid 0 dot)
                    if ((EvgAppTool.mentions(ids rowId)) == false) {
                        out = (out + ",\n")
                        out = (out + (EvgAppTool.toggleFor(rowId key)))
                    }
                }
                t = (t + 1)
            }
            out = (out + "\n  } }")
            i = (i + 1)
        }
        return (out + "\n }\n}\n")
    }

    sfn splitCommas:void (text:string out:[string]) {
        def cur@(mutable):string ""
        def i@(mutable):int 0
        while (i < (strlen text)) {
            def c:int (charAt text i)
            if (c == 44) {
                if ((strlen (trim cur)) > 0) {
                    push out (trim cur)
                }
                cur = ""
            } {
                cur = (cur + (substring text i (i + 1)))
            }
            i = (i + 1)
        }
        if ((strlen (trim cur)) > 0) {
            push out (trim cur)
        }
    }

    ; --- states ---------------------------------------------------------------

    fn states:void (sc:Statechart) {
        def out:string "{\"id\":"
        out = (out + (EVGTreeJson.str(sc.id)))
        out = ((out + ",\"initial\":") + (EVGTreeJson.str(sc.initial)))
        out = (out + ",\"states\":[")
        def n:int (array_length sc.states)
        def i:int 0
        while (i < n) {
            def st:ScState (itemAt sc.states i)
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + "\n  {\"state\":")
            out = (out + (EVGTreeJson.str(st.path)))
            out = ((out + ",\"page\":") + (EVGTreeJson.str(this.pageOf(st.path))))
            out = ((out + ",\"hasPage\":") + (EvgAppTool.boolText((EvgAppTool.exists(this.pageOf(st.path))))))
            out = ((out + ",\"events\":") + (EvgAppTool.strArray(this.eventsOf(sc st.path))))
            out = (out + "}")
            i = (i + 1)
        }
        if (n > 0) {
            out = (out + "\n")
        }
        out = ((out + "],\"count\":") + (to_string n))
        out = (out + "}")
        print out
    }

    ; Every event this state answers to, its ancestors' and the machine's own
    ; included — the same walk the runner does when it decides what a press
    ; means, so the list cannot promise something the machine would ignore.
    ; Both doors ask `EvgAppRules`, so neither can be the one that knows less.
    fn eventsOf:[string] (sc:Statechart path:string) {
        return (EvgAppRules.eventsOf(sc path))
    }

    ; --- press ----------------------------------------------------------------

    fn press:void (sc:Statechart) {
        def runner (new ScRunner)
        runner.start(sc)
        def out:string "{\"from\":"
        out = (out + (EVGTreeJson.str(runner.state)))
        out = (out + ",\"steps\":[")
        def argc:int (shell_arg_cnt)
        def wrote:int 0
        def i:int 2
        while (i < argc) {
            def ev:string (shell_arg i)
            if ((indexOf ev "--") == 0) {
            } {
                def before:string runner.state
                def took:boolean (runner.send((ScEvent.of(ev))))
                if (wrote > 0) {
                    out = (out + ",")
                }
                out = (out + "\n  {\"event\":")
                out = (out + (EVGTreeJson.str(ev)))
                out = ((out + ",\"taken\":") + (EvgAppTool.boolText(took)))
                out = ((out + ",\"state\":") + (EVGTreeJson.str(runner.state)))
                out = ((out + ",\"page\":") + (EVGTreeJson.str(this.pageOf(runner.state))))
                ; An event the machine ignores is the most common wrong answer
                ; and the quietest: the screen simply does not change.
                if (took == false) {
                    out = (out + ",\"note\":\"the machine ignored it in ")
                    out = ((out + before) + "\"")
                }
                out = (out + "}")
                wrote = (wrote + 1)
            }
            i = (i + 1)
        }
        if (wrote > 0) {
            out = (out + "\n")
        }
        out = (out + "],\"state\":")
        out = (out + (EVGTreeJson.str(runner.state)))
        out = (out + ",\"context\":")
        out = (out + (EvgAppTool.contextJson(runner)))
        out = (out + "}")
        print out
    }

    ; --- hit --------------------------------------------------------------------
    ;
    ; A press arrives as a point and has to leave as an event. `EVGHitTest`
    ; already answers the first half — the id under a point, in the paint order
    ; the list draws in — and the machine answers the second. Neither half is
    ; new; what this verb adds is that a browser can ask, without running a
    ; layout engine or knowing what an id means.
    ;
    ; The events replayed before the question are the session: the machine is
    ; deterministic and an app's history is a handful of strings, so the caller
    ; holds it and this stays a program that starts and ends.
    fn hit:void (sc:Statechart) {
        def argc:int (shell_arg_cnt)
        if (argc < 4) {
            print "{\"error\":\"hit needs an x and a y\"}"
            return
        }
        ; `to_double` is optional-typed and answers differently per target, so
        ; the point is read here and a number that is not one is a miss, not a
        ; press at the origin.
        def xs@(optional):double (to_double (shell_arg 2))
        def ys@(optional):double (to_double (shell_arg 3))
        if (null? xs) {
            print "{\"error\":\"x is not a number\"}"
            return
        }
        if (null? ys) {
            print "{\"error\":\"y is not a number\"}"
            return
        }
        def x:double (unwrap xs)
        def y:double (unwrap ys)
        def runner (new ScRunner)
        runner.start(sc)
        def i:int 4
        while (i < argc) {
            def ev:string (shell_arg i)
            if ((indexOf ev "--") == 0) {
            } {
                def ignored:boolean (runner.send((ScEvent.of(ev))))
            }
            i = (i + 1)
        }
        def file:string (this.pageOf(runner.state))
        def text@(optional):string (EvgAppTool.slurp(file))
        if (null? text) {
            print (("{\"error\":\"no page for state " + runner.state) + "\"}")
            return
        }
        def root@(optional):EVGElement (EVGTreeJson.fromText((unwrap text)))
        if (null? root) {
            print (("{\"error\":\"not an EVG document: " + file) + "\"}")
            return
        }
        def tree:EVGElement (unwrap root)
        this.bind(tree runner)
        def l (new EVGLayout())
        l.setPageSize((to_double pageW) (to_double pageH))
        l.layout(tree)
        def ht (new EVGHitTest())
        def id:string (ht.idAt(tree x y))
        def takes:boolean false
        if ((strlen id) > 0) {
            takes = (EvgAppTool.mentions((this.eventsOf(sc runner.state)) id))
        }
        def out:string "{\"state\":"
        out = (out + (EVGTreeJson.str(runner.state)))
        out = ((out + ",\"id\":") + (EVGTreeJson.str(id)))
        out = ((out + ",\"takes\":") + (EvgAppTool.boolText(takes)))
        out = (out + "}")
        print out
    }

    ; --- the data model -------------------------------------------------------
    ;
    ; --- WHY A DATA MODEL IS A THING TO CHECK ---------------------------------
    ;
    ; A page reads `{trips}`. A transition assigns `trips`. The machine starts
    ; with a `trips` in its context. Nothing in the app says those three are
    ; the same thing — they agree by spelling, across three files, and an agent
    ; that comes back to this app tomorrow with none of yesterday in its head
    ; will rename one of them.
    ;
    ; Every way they can disagree is silent. A page that binds a key the
    ; machine never has renders the braces, which looks like a design choice
    ; at a glance. A transition that assigns a key nothing declared works
    ; perfectly until a page tries to show it before the first press. A key in
    ; the context that no page shows is either dead weight or a screen
    ; somebody forgot to finish.
    ;
    ; So the model is derived, from the three places it actually lives, and the
    ; disagreements are the answer.

    fn model:void (sc:Statechart) {
        def keys:[string]
        def writers:[string]
        def readers:[string]
        this.gatherModel(sc keys writers readers)
        def declared:[string]
        this.declaredKeys(sc declared)

        def problems:[string]
        this.modelProblems(sc problems)
        def out:string "{\"keys\":["
        def i:int 0
        while (i < (array_length keys)) {
            def key:string (itemAt keys i)
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + "\n  {\"key\":")
            out = (out + (EVGTreeJson.str(key)))
            out = ((out + ",\"declared\":") + (EvgAppTool.boolText((EvgAppTool.mentions(declared key)))))
            out = ((out + ",\"writtenBy\":") + (EVGTreeJson.str((itemAt writers i))))
            out = ((out + ",\"readBy\":") + (EVGTreeJson.str((itemAt readers i))))
            out = (out + "}")
            i = (i + 1)
        }
        if ((array_length keys) > 0) {
            out = (out + "\n")
        }
        out = (out + "],\"problems\":")
        out = (out + (EvgAppTool.strArray(problems)))
        out = ((out + ",\"count\":") + (to_string (array_length problems)))
        out = (out + "}")
        print out
    }

    ; The three ways the model can disagree with itself, in one place because
    ; `check` asks the same question `model` does and neither may be the one
    ; that knows less.
    fn modelProblems:void (sc:Statechart problems:[string]) {
        def keys:[string]
        def writers:[string]
        def readers:[string]
        this.gatherModel(sc keys writers readers)
        def declared:[string]
        this.declaredKeys(sc declared)
        def i:int 0
        while (i < (array_length keys)) {
            def key:string (itemAt keys i)
            def wrote:string (itemAt writers i)
            def read:string (itemAt readers i)
            def isDeclared:boolean (EvgAppTool.mentions(declared key))
            ; Read, and nothing anywhere puts a value there: the page shows its
            ; own braces and looks like it meant to.
            if ((strlen read) > 0) {
                if (isDeclared == false) {
                    if ((strlen wrote) == 0) {
                        push problems ((("{" + key) + "} is read by ") + (read + ", and the machine never has it"))
                    }
                }
            }
            ; Assigned but not declared: right after the press, wrong before it.
            if ((strlen wrote) > 0) {
                if (isDeclared == false) {
                    push problems (((key + " is assigned by ") + wrote) + ", but is not in the machine's initial context")
                }
            }
            ; Declared and shown nowhere. A guard may be its only reader, so
            ; this is said plainly and is not a defect on its own.
            if ((strlen read) == 0) {
                if (isDeclared) {
                    push problems ((key + " is in the context and no page shows it"))
                }
            }
            i = (i + 1)
        }
    }

    ; Every key the app mentions, and where. Three walks: the initial context,
    ; the assigns on every transition, and the `{…}` in every page's text.
    fn gatherModel:void (sc:Statechart keys:[string] writers:[string] readers:[string]) {
        def declared:[string]
        this.declaredKeys(sc declared)
        def d:int 0
        while (d < (array_length declared)) {
            EvgAppTool.note(keys writers readers (itemAt declared d) "" "")
            d = (d + 1)
        }
        def i:int 0
        while (i < (array_length sc.states)) {
            def st:ScState (itemAt sc.states i)
            this.noteAssigns(keys writers readers st.transitions)
            this.noteAssigns(keys writers readers st.always)
            i = (i + 1)
        }
        this.noteAssigns(keys writers readers sc.transitions)

        def k:int 0
        while (k < (array_length sc.states)) {
            def st:ScState (itemAt sc.states k)
            if (this.isLeaf(sc st.path)) {
                def file:string (this.pageOf(st.path))
                def text@(optional):string (EvgAppTool.slurp(file))
                if ((null? text) == false) {
                    def root@(optional):EVGElement (EVGTreeJson.fromText((unwrap text)))
                    if ((null? root) == false) {
                        def found:[string]
                        this.bindingsOf((unwrap root) found)
                        def f:int 0
                        while (f < (array_length found)) {
                            EvgAppTool.note(keys writers readers (itemAt found f) "" st.path)
                            f = (f + 1)
                        }
                    }
                }
            }
            k = (k + 1)
        }
    }

    fn noteAssigns:void (keys:[string] writers:[string] readers:[string] ts:[ScTransition]) {
        def i:int 0
        while (i < (array_length ts)) {
            def t:ScTransition (itemAt ts i)
            def label:string t.event
            if ((strlen label) == 0) {
                label = "always"
            }
            def a:int 0
            while (a < (array_length t.assigns)) {
                def asg:ScAssign (itemAt t.assigns a)
                EvgAppTool.note(keys writers readers asg.key label "")
                a = (a + 1)
            }
            i = (i + 1)
        }
    }

    ; One mention of one key, folded into the three parallel lists.
    sfn note:void (keys:[string] writers:[string] readers:[string] key:string wrote:string read:string) {
        if ((strlen key) == 0) {
            return
        }
        def at@(mutable):int (0 - 1)
        def i@(mutable):int 0
        while (i < (array_length keys)) {
            if ((itemAt keys i) == key) {
                at = i
            }
            i = (i + 1)
        }
        if (at < 0) {
            push keys key
            push writers wrote
            push readers read
            return
        }
        if ((strlen wrote) > 0) {
            set writers at (EvgAppTool.joined((itemAt writers at) wrote))
        }
        if ((strlen read) > 0) {
            set readers at (EvgAppTool.joined((itemAt readers at) read))
        }
    }

    sfn joined:string (list:string item:string) {
        if ((strlen list) == 0) {
            return item
        }
        if ((indexOf list item) >= 0) {
            return list
        }
        return ((list + ", ") + item)
    }

    fn declaredKeys:void (sc:Statechart out:[string]) {
        def runner (new ScRunner)
        runner.start(sc)
        def i:int 0
        while (i < (array_length runner.keys)) {
            push out (itemAt runner.keys i)
            i = (i + 1)
        }
    }

    fn bindingsOf:void (el:EVGElement out:[string]) {
        EvgAppRules.keysOf(el out)
    }

    ; --- the memory -----------------------------------------------------------
    ;
    ; --- WHY AN APP NEEDS A FILE ABOUT ITSELF ---------------------------------
    ;
    ; An agent comes back to this app with none of yesterday in its head. It can
    ; read the files — but what it needs first is not a file, it is the shape:
    ; which screens exist, which keys mean what, and what was decided and must
    ; not be undone. Without that it renames a key, adds a fifth screen the nav
    ; does not reach, and stores a total it could have computed.
    ;
    ; So `APP.md` is half generated and half written, and the split is the whole
    ; design. Generated: the states, the pages, the events, the keys and who
    ; touches them — facts, rewritten from the files on every refresh, so they
    ; cannot drift. Written: what the app is FOR and what was decided — which
    ; no tool can derive and which is the part worth keeping.
    ;
    ; A memory that could disagree with the code would be worse than none.

    fn memo:void (sc:Statechart) {
        def path:string (appDir + "/APP.md")
        def old:string ""
        def had@(optional):string (EvgAppTool.slurp(path))
        if ((null? had) == false) {
            old = (unwrap had)
        }
        def body:string (this.generated(sc))
        def text:string (EvgAppTool.merged(old body sc.id))
        EvgAppTool.spit(path text)
        def out:string "{\"wrote\":"
        out = (out + (EVGTreeJson.str(path)))
        out = ((out + ",\"kept\":") + (EvgAppTool.boolText(((strlen old) > 0))))
        out = ((out + ",\"bytes\":") + (to_string (strlen text)))
        out = (out + "}")
        print out
    }

    ; The part this tool owns: what the files say, as two tables.
    fn generated:string (sc:Statechart) {
        def out:string "## The screens\n\n"
        out = (out + "| state | page | takes | pressable |\n")
        out = (out + "| --- | --- | --- | --- |\n")
        def i:int 0
        while (i < (array_length sc.states)) {
            def st:ScState (itemAt sc.states i)
            if (this.isLeaf(sc st.path)) {
                def ids:[string]
                def file:string (this.pageOf(st.path))
                def text@(optional):string (EvgAppTool.slurp(file))
                def page:string ("pages/" + (st.path + ".evg.json"))
                if (null? text) {
                    page = "— missing —"
                } {
                    def root@(optional):EVGElement (EVGTreeJson.fromText((unwrap text)))
                    if ((null? root) == false) {
                        this.idsOf((unwrap root) ids)
                    }
                }
                out = (((out + "| `") + st.path) + "` | ")
                out = ((out + page) + " | ")
                out = ((out + (EvgAppTool.commas(this.eventsOf(sc st.path)))) + " | ")
                out = ((out + (EvgAppTool.commas(ids))) + " |\n")
            }
            i = (i + 1)
        }

        def keys:[string]
        def writers:[string]
        def readers:[string]
        this.gatherModel(sc keys writers readers)
        def declared:[string]
        this.declaredKeys(sc declared)
        out = (out + "\n## The data model\n\n")
        out = (out + "| key | in the initial context | written by | read by |\n")
        out = (out + "| --- | --- | --- | --- |\n")
        def k:int 0
        while (k < (array_length keys)) {
            def key:string (itemAt keys k)
            out = (((out + "| `") + key) + "` | ")
            out = ((out + (EvgAppTool.boolText((EvgAppTool.mentions(declared key))))) + " | ")
            out = ((out + (EvgAppTool.orDash((itemAt writers k)))) + " | ")
            out = ((out + (EvgAppTool.orDash((itemAt readers k)))) + " |\n")
            k = (k + 1)
        }
        return out
    }

    ; The file, with everything outside the markers left exactly as it was.
    sfn merged:string (old:string body:string id:string) {
        def head:string "<!-- evg_app:generated — rewritten by `evg_app memo`; edit above and below, not here -->"
        def tail:string "<!-- /evg_app:generated -->"
        def block:string ((((head + "\n\n") + body) + "\n") + tail)
        if ((strlen old) == 0) {
            def fresh:string (("# " + id) + "\n\n## What this app is for\n\n")
            fresh = (fresh + "_One paragraph. What somebody does with it, and what it is not._\n\n")
            fresh = (fresh + block)
            fresh = (fresh + "\n\n## Decisions\n\n")
            fresh = (fresh + "_Anything a later pass must not undo: why a key is stored rather than\n")
            fresh = (fresh + "computed, why a screen is its own state, what was tried and dropped._\n")
            return fresh
        }
        def from:int (indexOf old head)
        if (from < 0) {
            return (((old + "\n") + block) + "\n")
        }
        def endAt:int (indexOf old tail)
        if (endAt < 0) {
            return (((substring old 0 from) + block) + "\n")
        }
        def after:string (substring old (endAt + (strlen tail)) (strlen old))
        return (((substring old 0 from) + block) + after)
    }

    sfn commas:string (items:[string]) {
        if ((array_length items) == 0) {
            return "—"
        }
        def out@(mutable):string ""
        def i@(mutable):int 0
        while (i < (array_length items)) {
            if (i > 0) {
                out = (out + ", ")
            }
            out = (((out + "`") + (itemAt items i)) + "`")
            i = (i + 1)
        }
        return out
    }

    sfn orDash:string (text:string) {
        if ((strlen text) == 0) {
            return "—"
        }
        return text
    }

    ; --- render ---------------------------------------------------------------

    ; The page the app is showing after those presses, with the context filled
    ; in — one document, ready for a painter. This is the verb a browser host
    ; calls; `press` is the same walk without the picture.
    fn render:void (sc:Statechart) {
        def runner (new ScRunner)
        runner.start(sc)
        def argc:int (shell_arg_cnt)
        def i:int 2
        while (i < argc) {
            def ev:string (shell_arg i)
            if ((indexOf ev "--") == 0) {
            } {
                def ignored:boolean (runner.send((ScEvent.of(ev))))
            }
            i = (i + 1)
        }
        def file:string (this.pageOf(runner.state))
        def text@(optional):string (EvgAppTool.slurp(file))
        if (null? text) {
            print (("{\"error\":\"no page for state " + runner.state) + "\"}")
            return
        }
        def root@(optional):EVGElement (EVGTreeJson.fromText((unwrap text)))
        if (null? root) {
            print (("{\"error\":\"not an EVG document: " + file) + "\"}")
            return
        }
        def tree:EVGElement (unwrap root)
        this.bind(tree runner)
        def doc:string (EVGTreeJson.toText(tree))
        def out:string (EvgAppTool.textFlag("--out" ""))
        if ((strlen out) > 0) {
            EvgAppTool.spit(out doc)
            def m (new EVGMeasure())
            m.look(tree pageW pageH "")
            def line:string "{\"state\":"
            line = (line + (EVGTreeJson.str(runner.state)))
            line = ((line + ",\"wrote\":") + (EVGTreeJson.str(out)))
            line = ((line + ",\"layout\":") + (m.summary(3)))
            print (line + "}")
            return
        }
        print doc
    }

    ; --- check ----------------------------------------------------------------

    fn check:void (sc:Statechart) {
        def runner (new ScRunner)
        runner.start(sc)
        def problems:[string]
        def reports:[string]
        def used:[string]
        def n:int (array_length sc.states)
        def i:int 0
        while (i < n) {
            def st:ScState (itemAt sc.states i)
            ; A compound state is never entered itself — the runner lands on a
            ; leaf inside it — so asking it for a page would report a screen
            ; nobody can reach as missing.
            if ((this.isLeaf(sc st.path)) == false) {
            } {
                def file:string (this.pageOf(st.path))
                push used file
                if ((EvgAppTool.exists(file)) == false) {
                    push problems ((("state \"" + st.path) + "\" has no page: ") + file)
                } {
                    push reports (this.checkPage(sc st.path file runner problems))
                }
            }
            i = (i + 1)
        }
        this.unusedPages(used problems)
        this.samePages(used problems)
        this.modelProblems(sc problems)
        this.memoryProblems(sc problems)

        def out:string "{\"states\":"
        out = (out + (to_string n))
        out = (out + ",\"pages\":[")
        def k:int 0
        while (k < (array_length reports)) {
            if (k > 0) {
                out = (out + ",")
            }
            out = (out + "\n  ")
            out = (out + (itemAt reports k))
            k = (k + 1)
        }
        if ((array_length reports) > 0) {
            out = (out + "\n")
        }
        out = (out + "],\"problems\":")
        out = (out + (EvgAppTool.strArray(problems)))
        out = ((out + ",\"count\":") + (to_string (array_length problems)))
        out = (out + "}")
        print out
    }

    ; Two states drawn by the same document. `init` makes every page a copy of
    ; the screen on purpose — the app starts from what was designed — but a copy
    ; that is never made its own is the defect nobody reports: the press lands,
    ; the machine moves, the transition fires, and the screen is identical. It
    ; is indistinguishable from a dead button, and it is the first thing to
    ; check when somebody says the tabs do not work.
    fn samePages:void (files:[string] problems:[string]) {
        def n:int (array_length files)
        ; One line per GROUP. A page already named in an earlier group would
        ; otherwise be reported again from its own row, and the same fact
        ; three times reads as three defects.
        def claimed:[string]
        def i:int 0
        while (i < n) {
            def a@(optional):string (EvgAppTool.slurp((itemAt files i)))
            if ((null? a) || (EvgAppTool.mentions(claimed (itemAt files i)))) {
            } {
                def same:string ""
                def j:int (i + 1)
                while (j < n) {
                    def b@(optional):string (EvgAppTool.slurp((itemAt files j)))
                    if (null? b) {
                    } {
                        if ((unwrap a) == (unwrap b)) {
                            same = (EvgAppTool.joined(same (EvgAppTool.lastName((itemAt files j)))))
                            push claimed (itemAt files j)
                        }
                    }
                    j = (j + 1)
                }
                if ((strlen same) > 0) {
                    push problems ((((EvgAppTool.lastName((itemAt files i))) + " and ") + same) + " are the same document — a press moves the machine and the screen does not change, which looks exactly like a dead button")
                }
            }
            i = (i + 1)
        }
    }

    ; The state a page file belongs to: `pages/map.evg.json` → `map`.
    sfn lastName:string (file:string) {
        def cut:int (EvgAppTool.lastSlash(file))
        def name:string (substring file (cut + 1) (strlen file))
        def tail:int (indexOf name ".evg.json")
        if (tail > 0) {
            return (substring name 0 tail)
        }
        return name
    }

    ; One page: does it read, does it lay out, and is every id on it an event
    ; this state answers to?
    fn checkPage:string (sc:Statechart path:string file:string runner:ScRunner problems:[string]) {
        def out:string "{\"state\":"
        out = (out + (EVGTreeJson.str(path)))
        def text@(optional):string (EvgAppTool.slurp(file))
        if (null? text) {
            push problems (("page \"" + file) + "\" cannot be read")
            return (out + ",\"error\":\"unreadable\"}")
        }
        def root@(optional):EVGElement (EVGTreeJson.fromText((unwrap text)))
        if (null? root) {
            push problems (("page \"" + file) + "\" is not an EVG document")
            return (out + ",\"error\":\"not an EVG document\"}")
        }
        def tree:EVGElement (unwrap root)
        this.bind(tree runner)

        def m (new EVGMeasure())
        ; The holes on this tree are already filled, just above. A state word
        ; here is what binding produced, not a control that cannot move.
        m.boundView = true
        m.look(tree pageW pageH "")
        out = (out + ",\"layout\":")
        out = (out + (m.summary(3)))
        def j:int 0
        while (j < (array_length m.findings)) {
            push problems (((path + ": ") + (itemAt m.findings j)))
            j = (j + 1)
        }
        def a:int 0
        while (a < (array_length m.align)) {
            push problems (((path + ": ") + (itemAt m.align a)))
            a = (a + 1)
        }

        def ids:[string]
        this.idsOf(tree ids)
        def dead:[string]
        EvgAppRules.deadIds(path (this.eventsOf(sc path)) ids problems dead)
        out = ((out + ",\"ids\":") + (to_string (array_length ids)))
        if ((array_length dead) > 0) {
            out = ((out + ",\"dead\":") + (EvgAppTool.strArray(dead)))
        }
        return (out + "}")
    }

    ; A page file no state renders. Work that went nowhere, or a state that was
    ; renamed and left its screen behind.
    fn unusedPages:void (used:[string] problems:[string]) {
        def dir:string (appDir + "/pages")
        def names:[string] (list_dir_files dir)
        def i:int 0
        while (i < (array_length names)) {
            def name:string (itemAt names i)
            if ((EvgAppTool.endsIn(name ".evg.json"))) {
                def full:string ((dir + "/") + name)
                if ((EvgAppTool.mentions(used full)) == false) {
                    push problems (("page \"" + name) + "\" is not the page of any state")
                }
            }
            i = (i + 1)
        }
    }

    ; A memory that has quietly stopped matching the app is worse than none:
    ; the next pass reads it, believes it, and works from a description of an
    ; app that no longer exists. So the generated half is compared with what it
    ; would be written as now, and a difference is a finding like any other.
    fn memoryProblems:void (sc:Statechart problems:[string]) {
        def path:string (appDir + "/APP.md")
        def had@(optional):string (EvgAppTool.slurp(path))
        if (null? had) {
            push problems "there is no APP.md — run `evg_app memo` and then write what this app is for"
            return
        }
        def text:string (unwrap had)
        def body:string (this.generated(sc))
        if ((indexOf text body) < 0) {
            push problems "APP.md no longer describes this app — run `evg_app memo`"
        }
    }

    ; --- the tree -------------------------------------------------------------

    ; `{key}` in a text node is filled from the machine's context. A key the
    ; context does not have is left as it was written: a missing binding should
    ; look wrong on the screen, not look empty.
    fn bind:void (el:EVGElement runner:ScRunner) {
        EvgAppRules.bindTree(el runner)
    }

    fn idsOf:void (el:EVGElement out:[string]) {
        EvgAppRules.idsOf(el out)
    }

    ; --- small things ---------------------------------------------------------

    fn pageOf:string (path:string) {
        return (((appDir + "/pages/") + path) + ".evg.json")
    }

    fn isLeaf:boolean (sc:Statechart path:string) {
        return (EvgAppRules.isLeaf(sc path))
    }

    ; A JSON scalar as a person would read it: the quotes off a string, and
    ; nothing else touched.
    sfn plain:string (json:string) {
        def n:int (strlen json)
        if (n == 0) {
            return ""
        }
        if (json == "null") {
            return ""
        }
        if ((charAt json 0) == 34) {
            if ((charAt json (n - 1)) == 34) {
                return (substring json 1 (n - 1))
            }
        }
        return json
    }

    sfn contextJson:string (runner:ScRunner) {
        def out:string "{"
        def i:int 0
        while (i < (array_length runner.keys)) {
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + (EVGTreeJson.str((itemAt runner.keys i))))
            out = (out + ":")
            out = (out + (runner.json((itemAt runner.keys i))))
            i = (i + 1)
        }
        return (out + "}")
    }

    sfn mentions:boolean (list:[string] want:string) {
        return (EvgAppRules.mentions(list want))
    }

    sfn endsIn:boolean (text:string tail:string) {
        def n:int (strlen text)
        def t:int (strlen tail)
        if (n < t) {
            return false
        }
        return ((substring text (n - t) n) == tail)
    }

    sfn boolText:string (v:boolean) {
        return (EvgAppRules.boolText(v))
    }

    sfn strArray:string (items:[string]) {
        return (EvgAppRules.strArray(items))
    }

    sfn intFlag:int (name:string fallback:int) {
        return (EvgAppRules.intFlag(name fallback))
    }

    sfn lastSlash:int (path:string) {
        return (EvgAppRules.lastSlash(path))
    }

    sfn exists:boolean (path:string) {
        return (EvgAppRules.exists(path))
    }

    sfn textFlag:string (name:string fallback:string) {
        return (EvgAppRules.textFlag(name fallback))
    }

    sfn spit:void (path:string data:string) {
        EvgAppRules.spit(path data)
    }

    sfn slurp@(optional):string (path:string) {
        return (EvgAppRules.slurp(path))
    }
}

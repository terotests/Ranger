; ==============================================================================
; EvgAppRules — what is true of an app, whatever an app is made of
; ==============================================================================
;
; There are two kinds of app now. One is data — `machine.json` and a page
; document per state — and one is code — a Ranger class that builds the page.
; They are different programs with different runtimes, and they are asked the
; same questions:
;
;   what events does this state answer to?
;   what is pressable on this page?
;   is anything on it pressable that this state does not answer to?
;
; Two implementations of one question answer differently, and the one that
; matters is always the one that knows less. So the questions live here and
; both doors ask them.
; ==============================================================================

Import "../../statechart/src/Statechart.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGTreeJson.rgr"

class EvgAppRules {

    Constructor () {
    }

    ; Every event this state answers to — its ancestors' and the machine's own
    ; included, which is the same walk the runner does when it decides what a
    ; press means. The list cannot promise something the machine would ignore.
    sfn eventsOf:[string] (sc:Statechart path:string) {
        def out:[string]
        def here@(mutable):string path
        def guard@(mutable):int 0
        while ((strlen here) > 0) {
            if (guard > 16) {
                here = ""
            } {
                def st:ScState (sc.stateAt(here))
                EvgAppRules.pushEvents(out st.transitions)
                here = st.parent
                guard = (guard + 1)
            }
        }
        EvgAppRules.pushEvents(out sc.transitions)
        return out
    }

    sfn pushEvents:void (out:[string] ts:[ScTransition]) {
        def i:int 0
        while (i < (array_length ts)) {
            def t:ScTransition (itemAt ts i)
            if ((strlen t.event) > 0) {
                if ((EvgAppRules.mentions(out t.event)) == false) {
                    push out t.event
                }
            }
            i = (i + 1)
        }
    }

    ; A state the runner can stop at. A compound state is somewhere it passes
    ; through, so asking it for a page would report a screen nobody can reach.
    sfn isLeaf:boolean (sc:Statechart path:string) {
        def i:int 0
        while (i < (array_length sc.states)) {
            def st:ScState (itemAt sc.states i)
            if (st.parent == path) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    ; Everything pressable on a page, by the name a press would send.
    sfn idsOf:void (el:EVGElement out:[string]) {
        if ((strlen el.id) > 0) {
            if ((EvgAppRules.mentions(out el.id)) == false) {
                push out el.id
            }
        }
        def i:int 0
        while (i < (array_length el.children)) {
            EvgAppRules.idsOf((itemAt el.children i) out)
            i = (i + 1)
        }
    }

    ; The defect that looks exactly like working software: a button whose id
    ; this state does not answer to. Pressing it does nothing, and nothing
    ; about the screen says so.
    sfn deadIds:void (state:string events:[string] ids:[string] problems:[string] dead:[string]) {
        def i:int 0
        while (i < (array_length ids)) {
            def id:string (itemAt ids i)
            if ((EvgAppRules.mentions(events id)) == false) {
                push dead id
                push problems ((((state + ": #") + id) + " is not an event this state takes"))
            }
            i = (i + 1)
        }
    }

    ; A child's address, the way `EVGInspect` writes it.
    sfn segOf:string (kid:EVGElement i:int) {
        if ((strlen kid.key) > 0) {
            return ("k:" + kid.key)
        }
        return (to_string i)
    }

    sfn mentions:boolean (list:[string] want:string) {
        def i:int 0
        while (i < (array_length list)) {
            if ((itemAt list i) == want) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; --- {key} ----------------------------------------------------------------
    ; ONE COPY OF THE BINDING, because there were two and they drifted the
    ; first time one of them learned something. The tool renders a page and so
    ; does the browser runtime; a `{key}` filled in one and not the other is a
    ; screen that works on the command line and is dead in the tab.
    ;
    ; It fills a node's TEXT and its CLASS NAME. The class matters as much as
    ; the text: a control's state is a class — a switch is on because it
    ; carries `ui-switch-state-checked` — so a document that binds only text
    ; can show a number from the context and not a control's state.
    sfn bindTree:void (el:EVGElement runner:ScRunner) {
        if ((strlen el.textContent) > 0) {
            el.textContent = (EvgAppRules.fillText(el.textContent runner))
        }
        if ((strlen el.className) > 0) {
            el.className = (EvgAppRules.fillText(el.className runner))
        }
        def i:int 0
        while (i < (array_length el.children)) {
            EvgAppRules.bindTree((itemAt el.children i) runner)
            i = (i + 1)
        }
    }

    ; A key the context does not have is left as it was written: a missing
    ; binding should look wrong on the screen, not look empty.
    ;
    ; `ScRunner.json` answers a key it does not hold with the JSON `null`, not
    ; with nothing — so this used to write the word into the class and a
    ; control bound to a key the machine never got became
    ; `ui-switch-state-null`. That matches no rule, so the control painted as
    ; if it had no state and never moved however often it was pressed, and the
    ; screen said "null" nowhere a person would look. A hole left open says
    ; the same thing where it can be seen, and `evg_app check` names the key.
    sfn fillText:string (text:string runner:ScRunner) {
        def out@(mutable):string ""
        def i@(mutable):int 0
        def n:int (strlen text)
        while (i < n) {
            def c:int (charAt text i)
            if (c == 123) {
                def close@(mutable):int (0 - 1)
                def j@(mutable):int (i + 1)
                while (j < n) {
                    if ((charAt text j) == 125) {
                        if (close < 0) {
                            close = j
                        }
                    }
                    j = (j + 1)
                }
                if (close < 0) {
                    out = (out + (substring text i (i + 1)))
                    i = (i + 1)
                } {
                    def key:string (substring text (i + 1) close)
                    ; The RAW answer, because the test is for the bare JSON
                    ; `null`. `plainValue` takes the quotes off first, which
                    ; would make a context value that really is the string
                    ; "null" look like a key that is not there.
                    def raw:string (runner.json(key))
                    if (EvgAppRules.isNothing(raw)) {
                        out = (out + (substring text i (close + 1)))
                    } {
                        out = (out + (EvgAppRules.plainValue(raw)))
                    }
                    i = (close + 1)
                }
            } {
                out = (out + (substring text i (i + 1)))
                i = (i + 1)
            }
        }
        return out
    }

    ; "the context does not hold this". A quoted "null" is a string somebody
    ; chose and is left alone; the bare word is what `ScValOps.toJson` writes
    ; for a key that is not there.
    sfn isNothing:boolean (val:string) {
        if ((strlen val) == 0) {
            return true
        }
        return (val == "null")
    }

    ; A JSON scalar as a person would read it: the quotes off a string, and
    ; nothing else touched.
    sfn plainValue:string (json:string) {
        def n:int (strlen json)
        if (n < 2) {
            return json
        }
        if ((charAt json 0) == 34) {
            if ((charAt json (n - 1)) == 34) {
                return (substring json 1 (n - 1))
            }
        }
        return json
    }

    ; The `{key}` names in a node's text and class, whatever is around them.
    sfn scanKeys:void (text:string out:[string]) {
        def n:int (strlen text)
        def i@(mutable):int 0
        while (i < n) {
            if ((charAt text i) == 123) {
                def j@(mutable):int (i + 1)
                def close@(mutable):int (0 - 1)
                while (j < n) {
                    if ((charAt text j) == 125) {
                        if (close < 0) {
                            close = j
                        }
                    }
                    j = (j + 1)
                }
                if (close < 0) {
                    i = n
                } {
                    def key:string (substring text (i + 1) close)
                    if ((strlen key) > 0) {
                        if ((EvgAppRules.mentions(out key)) == false) {
                            push out key
                        }
                    }
                    i = (close + 1)
                }
            } {
                i = (i + 1)
            }
        }
    }

    sfn keysOf:void (el:EVGElement out:[string]) {
        if ((strlen el.textContent) > 0) {
            EvgAppRules.scanKeys(el.textContent out)
        }
        if ((strlen el.className) > 0) {
            EvgAppRules.scanKeys(el.className out)
        }
        def i:int 0
        while (i < (array_length el.children)) {
            EvgAppRules.keysOf((itemAt el.children i) out)
            i = (i + 1)
        }
    }

    sfn boolText:string (v:boolean) {
        if v {
            return "true"
        }
        return "false"
    }

    sfn strArray:string (items:[string]) {
        def out:string "["
        def i:int 0
        while (i < (array_length items)) {
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + "\n  ")
            out = (out + (EVGTreeJson.str((itemAt items i))))
            i = (i + 1)
        }
        if ((array_length items) > 0) {
            out = (out + "\n")
        }
        return (out + "]")
    }

    ; --- the command line -----------------------------------------------------
    ;
    ; A data app and a code app take the same arguments, because the host that
    ; calls them must not have to know which it is holding.

    sfn textFlag:string (name:string fallback:string) {
        def argc:int (shell_arg_cnt)
        def head:string (name + "=")
        def h:int (strlen head)
        def i:int 0
        while (i < argc) {
            def a:string (shell_arg i)
            if ((strlen a) > h) {
                if ((substring a 0 h) == head) {
                    return (substring a h (strlen a))
                }
            }
            i = (i + 1)
        }
        return fallback
    }

    ; `to_int` on a string is optional-typed and answers differently per
    ; target; a digit loop is the same everywhere.
    sfn intFlag:int (name:string fallback:int) {
        def v:string (EvgAppRules.textFlag(name ""))
        if ((strlen v) == 0) {
            return fallback
        }
        def out@(mutable):int 0
        def seen@(mutable):int 0
        def k@(mutable):int 0
        while (k < (strlen v)) {
            def d:int (indexOf "0123456789" (substring v k (k + 1)))
            if (d < 0) {
                k = (strlen v)
            } {
                out = ((out * 10) + d)
                seen = (seen + 1)
                k = (k + 1)
            }
        }
        if (seen > 0) {
            return out
        }
        return fallback
    }

    sfn lastSlash:int (path:string) {
        def at@(mutable):int (0 - 1)
        def i@(mutable):int 0
        while (i < (strlen path)) {
            if ((charAt path i) == 47) {
                at = i
            }
            i = (i + 1)
        }
        return at
    }

    sfn exists:boolean (path:string) {
        def cut:int (EvgAppRules.lastSlash(path))
        def dir:string "."
        def name@(mutable):string path
        if (cut >= 0) {
            dir = (substring path 0 cut)
            name = (substring path (cut + 1) (strlen path))
        }
        return (file_exists dir name)
    }

    sfn slurp@(optional):string (path:string) {
        def cut:int (EvgAppRules.lastSlash(path))
        def dir:string "."
        def name@(mutable):string path
        if (cut >= 0) {
            dir = (substring path 0 cut)
            name = (substring path (cut + 1) (strlen path))
        }
        if ((file_exists dir name) == false) {
            def missing@(optional):string
            return missing
        }
        def text@(optional):string (read_file dir name)
        return text
    }

    sfn spit:void (path:string data:string) {
        def cut:int (EvgAppRules.lastSlash(path))
        def dir:string "."
        def name@(mutable):string path
        if (cut >= 0) {
            dir = (substring path 0 cut)
            name = (substring path (cut + 1) (strlen path))
        }
        write_file dir name data
    }
}

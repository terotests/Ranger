{
 "_": "The smallest app that is an app: three screens, a bottom nav, and a counter only a transition can change. Each state also takes its OWN nav event with no target — pressing the tab you are on is inert, and a tab that LOOKS pressable and is not an event at all is what `check` refuses. PLAN_LIVE_APP.md S1.",
 "id": "traffic",
 "initial": "map",
 "context": {
  "trips": "3"
 },
 "states": {
  "map": {
   "on": {
    "nav.routes": {
     "target": "routes"
    },
    "nav.settings": {
     "target": "settings"
    },
    "nav.map": {
     "actions": []
    }
   }
  },
  "routes": {
   "on": {
    "nav.map": {
     "target": "map"
    },
    "nav.settings": {
     "target": "settings"
    },
    "route.add": {
     "actions": [
      {
       "assign": {
        "trips": {
         "value": "4"
        }
       }
      }
     ]
    },
    "nav.routes": {
     "actions": []
    }
   }
  },
  "settings": {
   "on": {
    "nav.map": {
     "target": "map"
    },
    "nav.routes": {
     "target": "routes"
    },
    "nav.settings": {
     "actions": []
    }
   }
  }
 }

{
 "_": "The same traffic app as fixtures/app, with the one thing a page document cannot hold: a list. `route.add` appends to it, and the routes screen draws one row per item — however many there are. PLAN_LIVE_APP.md S4.",
 "id": "traffic-code",
 "initial": "map",
 "context": { "routes": ["Keskusta → Lentoasema", "Koti → Toimisto"], "minutes": "28" },
 "states": {
  "map": {
   "on": {
    "nav.map": { "actions": [] },
    "nav.routes": { "target": "routes" },
    "nav.settings": { "target": "settings" }
   }
  },
  "routes": {
   "on": {
    "nav.routes": { "actions": [] },
    "nav.map": { "target": "map" },
    "nav.settings": { "target": "settings" },
    "route.add": {
     "actions": [
      { "assign": { "routes": { "append": { "list": { "context": "routes" }, "item": { "value": "Uusi reitti" } } } } }
     ]
    }
   }
  },
  "settings": {
   "on": {
    "nav.settings": { "actions": [] },
    "nav.map": { "target": "map" },
    "nav.routes": { "target": "routes" }
   }
  }
 }
}

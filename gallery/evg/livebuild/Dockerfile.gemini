# Gemini's `run` tool. Node is here so the workspace shims
# (./evg-agent, ./evg-ui, ./evg-app, ./evg-image) can start.
# python3, tesseract, imagemagick, sips — not in this image, on purpose.
#
#   docker build -t ranger-livebuild-gemini -f gallery/evg/livebuild/Dockerfile.gemini gallery/evg/livebuild
#   export EVG_GEMINI_DOCKER_IMAGE=ranger-livebuild-gemini
#   export EVG_GEMINI_SANDBOX=docker
#
# The default without a local build is node:22-bookworm-slim, same idea.
FROM node:22-bookworm-slim
WORKDIR /work

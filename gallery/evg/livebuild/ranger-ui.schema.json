{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ranger.local/schema/ranger-ui.v2.json",
  "title": "Ranger UI document",
  "description": "One portable JSON envelope: semantic ui, authored css, machine. compiled.evg and debug are snapshots.",
  "type": "object",
  "required": ["format", "version", "ui"],
  "additionalProperties": true,
  "properties": {
    "format": { "const": "ranger-ui" },
    "version": { "const": 2 },
    "meta": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "prompt": { "type": "string" },
        "kind": { "type": "string" },
        "handoff": { "type": "string" }
      }
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "library": { "type": "string" },
          "version": { "type": "string" },
          "kind": { "type": "string" },
          "definition": { "type": "object" }
        }
      }
    },
    "ui": { "$ref": "#/$defs/node" },
    "css": { "type": "string" },
    "machine": { "type": ["object", "null"] },
    "pages": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/node" }
    },
    "compiled": {
      "type": "object",
      "properties": {
        "evg": { "type": "object" },
        "pages": { "type": "object" }
      }
    },
    "debug": {
      "type": "object",
      "properties": {
        "outline": { "type": "string" },
        "layout": { "type": "object" }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["type", "uid"],
      "properties": {
        "type": { "type": "string" },
        "uid": { "type": "string" },
        "id": { "type": "string" },
        "class": { "type": "string" },
        "text": { "type": "string" },
        "props": {
          "type": "object",
          "description": "Semantic component props only — not CSS."
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      }
    }
  }
}

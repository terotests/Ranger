; EvgAppWeb — the app, running in the tab.
;
; WHY THIS EXISTS.
;
; The data app answered every question by spawning `evg_app.js`: one process
; per press, reading `machine.json` and `pages/*.evg.json` off a disk. That
; works on the machine that compiled the tool and nowhere else. It asks an
; agent to have a shell in the workspace, a Ranger clone behind it, and a
; binary that `bin/` does not carry — three things a remote agent, an agent
; talking to a server, or anything that is not this laptop simply does not
; have. A press should not need any of them.
;
; So the runtime moves into the browser. The page is handed two strings — the
; machine, and one document per state — and from then on a press is a function
; call: hit-test the laid-out page, send the id as an event, build the page for
; wherever the machine landed. No fetch, no process, no file system.
;
; It is the SAME `EvgAppKit` a code app runs on. A data app is not a second
; runtime with its own rules; it is an app whose `build` happens to parse a
; document instead of composing one. That is the whole trick, and it is why
; `{key}` binding, hit testing, the display list and the component host behave
; identically in both — there is one implementation of each.
;
;   host (node)          browser
;   ───────────          ───────
;   reads the files      new EvgAppWeb()
;   sends them once  ──► boot(machine) / put(state doc)
;                        frame()            → display list JSON
;                        press(x y)         → {id, took, state}
;
; What still belongs to the host: compiling a CODE app, which needs the Ranger
; compiler. A code app's module is imported by the server and held open, and
; this class is not in that path.

Import "EvgAppKit.rgr"
Import "EvgAppRules.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGTreeJson.rgr"

; A data app: one document per state, parsed on demand and bound to the
; machine's context. `build` is the only thing an app must answer, and this
; answers it out of text.
class EvgDataApp extends EvgApp {
    def names:[string]
    def docs:[string]

    Constructor () {
    }

    fn put:void (state:string doc:string) {
        def i:int (this.slotOf(state))
        if (i < 0) {
            push names state
            push docs doc
        } {
            docs = (EvgDataApp.replaced(docs i doc))
        }
    }

    fn slotOf:int (state:string) {
        def i:int 0
        while (i < (array_length names)) {
            if ((itemAt names i) == state) {
                return i
            }
            i = (i + 1)
        }
        return (0 - 1)
    }

    fn build:EVGElement (state:string) {
        def i:int (this.slotOf(state))
        if (i < 0) {
            ; A state with no page is a screen the app can reach and does not
            ; have. `check` names it; here it has to be visible rather than
            ; blank, or the tab looks dead for the second time.
            def miss:EVGElement (EVGElement.createDiv())
            def span:EVGElement (EVGElement.createSpan())
            span.textContent = (("no page for state \"" + state) + "\"")
            miss.addChild(span)
            return miss
        }
        def root@(optional):EVGElement (EVGTreeJson.fromText((itemAt docs i)))
        if (null? root) {
            def bad:EVGElement (EVGElement.createDiv())
            def note:EVGElement (EVGElement.createSpan())
            note.textContent = (("the page for \"" + state) + "\" is not an EVG document")
            bad.addChild(note)
            return bad
        }
        def tree:EVGElement (unwrap root)
        if (null? kit) {
            return tree
        }
        def k:EvgAppKit (unwrap kit)
        k.bind(tree)
        return tree
    }

    sfn replaced:[string] (list:[string] at:int value:string) {
        def out:[string]
        def i:int 0
        while (i < (array_length list)) {
            if (i == at) {
                push out value
            } {
                push out (itemAt list i)
            }
            i = (i + 1)
        }
        return out
    }
}

; What the page holds: one kit, one app, and no I/O at all.
class EvgAppWeb {
    def kit:EvgAppKit (new EvgAppKit())
    def app:EvgDataApp (new EvgDataApp())
    def ready:boolean false

    Constructor () {
        app.kit = kit
    }

    fn boot:boolean (machineJson:string) {
        ready = (kit.bootText(machineJson))
        return ready
    }

    fn put:void (state:string doc:string) {
        app.put(state doc)
    }

    fn size:void (w:int h:int) {
        kit.pageW = w
        kit.pageH = h
    }

    fn state:string () {
        return (kit.state())
    }

    ; Every state the machine has, so the page can say what it is holding
    ; without a second source of truth.
    fn statesJson:string () {
        def out:string "["
        def i:int 0
        while (i < (array_length app.names)) {
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + (EVGTreeJson.str((itemAt app.names i))))
            i = (i + 1)
        }
        return (out + "]")
    }

    ; The current page, as a display list — what a painter takes.
    fn frame:string () {
        return (kit.frameJson(app))
    }

    ; A press. Hit test, send, and the machine has moved before this returns.
    fn press:string (x:double y:double) {
        return (kit.pressPoint(app x y))
    }

    ; An event by name, for a button the host knows about without a point.
    fn send:boolean (event:string) {
        return (kit.sendEvent(event))
    }

    ; The machine's context, so the page can show what a press actually
    ; changed — the one thing that tells a dead button from a working one
    ; whose screen does not happen to show the key it moved.
    fn contextJson:string () {
        return (kit.contextJson())
    }

    ; The document for the current state, bound — what the inspector shows.
    fn doc:string () {
        return (kit.pageDoc(app))
    }
}

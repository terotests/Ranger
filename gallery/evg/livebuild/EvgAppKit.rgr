; ==============================================================================
; EvgAppKit — the runtime an app written in Ranger links against
; ==============================================================================
;
; PLAN_LIVE_APP.md S4. A data app is `machine.json` and a page document per
; state, and it is the right shape until it is not: a list that comes from the
; context, a number that has to be formatted, a row that remembers whether it
; is open. None of those can be written down as a document, and all of them
; are four lines of code.
;
; So an app may be code. It is one class with one method:
;
;   class App extends EvgApp {
;       fn build:EVGElement (state:string) { … }
;   }
;
; and the kit is everything around it: the machine, the replay, the layout, the
; hit test, the checks, and a command line identical to the data app's, so the
; host that calls it does not have to know which kind it is holding.
;
; --- WHY THE APP IS THE PROGRAM -----------------------------------------------
;
; The kit does not load an app; an app links the kit and IS the program. Ranger
; has no way to construct a class from a string and inventing one for this
; would be a larger feature than the one being built — and the alternative is
; better anyway: a compiled app is one file with the engine in it, which is
; what makes it something a browser can run later without a host at all.
;
; --- WHY COMPONENTS ARE THE POINT ---------------------------------------------
;
; `EVGComponentHost` is here for the thing a document cannot do: an instance
; that survives a rebuild. A page function starts from nothing every time it is
; called, so a value it would like to remember between presses has nowhere to
; live. `kit.use(key fresh)` gives it one, and `renders` on the component is
; the proof — it counts on the instance, so a number above one means the same
; object came back.
; ==============================================================================

Import "EvgAppRules.rgr"
Import "../../statechart/src/Statechart.rgr"
Import "../../statechart/src/StatechartJson.rgr"
Import "pkg:evg/EVGComponent.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGHitTest.rgr"
Import "pkg:evg/EVGLayout.rgr"
Import "pkg:evg/EVGMeasure.rgr"
Import "pkg:evg/EVGTreeJson.rgr"

; What an app is, from the kit's side. One method, and the kit calls it.
class EvgApp {
    def kit@(optional):EvgAppKit

    Constructor () {
    }

    ; The page for a state. Everything the app knows lives under here.
    fn build:EVGElement (state:string) {
        return (EVGElement.createDiv())
    }
}

class EvgAppKit {
    def chart@(optional):Statechart
    def runner:ScRunner (new ScRunner)
    def host:EVGComponentHost (new EVGComponentHost())
    def appDir:string "."
    def pageW:int 390
    def pageH:int 844

    Constructor () {
    }

    ; --- what an app asks the kit for -----------------------------------------

    ; The machine's current state.
    fn state:string () {
        return runner.state
    }

    ; A context value as text, without the JSON quotes a page would have to
    ; strip itself. A key the machine does not have answers "", because a page
    ; asking for one is a question, not an error — `evg_app model` is where an
    ; unanswered one is reported.
    fn text:string (key:string) {
        return (EvgAppKit.plain((runner.json(key))))
    }

    fn number:int (key:string) {
        def v:string (this.text(key))
        def out@(mutable):int 0
        def seen@(mutable):int 0
        def i@(mutable):int 0
        while (i < (strlen v)) {
            def d:int (indexOf "0123456789" (substring v i (i + 1)))
            if (d < 0) {
                i = (strlen v)
            } {
                out = ((out * 10) + d)
                seen = (seen + 1)
                i = (i + 1)
            }
        }
        if (seen == 0) {
            return 0
        }
        return out
    }

    ; An instance that outlives this build. The `new` on the call site is a
    ; fallback thrown away on every pass after the first.
    fn use:EVGComponent (key:string fresh:EVGComponent) {
        return (host.use(key fresh))
    }

    fn enter:void (segment:string) {
        host.enter(segment)
    }

    fn leave:void () {
        host.leave()
    }

    ; --- the runtime ----------------------------------------------------------

    fn boot:boolean (dir:string) {
        appDir = dir
        def text@(optional):string (EvgAppRules.slurp(dir + "/machine.json"))
        if (null? text) {
            return false
        }
        return (this.bootText((unwrap text)))
    }

    ; The same start, from the machine's text rather than from a file. A host
    ; with no file system — a browser, a Worker — hands it over this way, and
    ; it is the only thing standing between this kit and running in a tab.
    fn bootText:boolean (text:string) {
        def loaded:Statechart (StatechartJson.load(text))
        chart = loaded
        runner.start(loaded)
        return true
    }

    ; --- THE LIVE SIDE --------------------------------------------------------
    ;
    ; A command line spawns a process per press, and a process that dies takes
    ; every component with it — so `renders` is 1 forever and a component is an
    ; expensive way to write a function. These three methods are the same app
    ; held OPEN: a host imports the module once, keeps one kit, and presses it.
    ; That is what makes an instance that outlives a build mean anything, and
    ; it is the same shape a Worker takes later.

    fn sendEvent:boolean (ev:string) {
        return (runner.send((ScEvent.of(ev))))
    }

    ; The page as it is now, as a document.
    fn pageDoc:string (app:EvgApp) {
        def tree:EVGElement (this.buildPage(app runner.state))
        return (EVGTreeJson.toText(tree))
    }

    ; A press at a point: what is under it, whether this state answers to it,
    ; and — if it does — the machine moved before this returns.
    fn pressPoint:string (app:EvgApp x:double y:double) {
        def tree:EVGElement (this.buildPage(app runner.state))
        def l (new EVGLayout())
        l.setPageSize((to_double pageW) (to_double pageH))
        l.layout(tree)
        def ht (new EVGHitTest())
        def id:string (ht.idAt(tree x y))
        def takes:boolean false
        if ((strlen id) > 0) {
            if ((null? chart) == false) {
                takes = (EvgAppRules.mentions((EvgAppRules.eventsOf((unwrap chart) runner.state)) id))
            }
        }
        if (takes) {
            def moved:boolean (this.sendEvent(id))
        }
        def out:string "{\"state\":"
        out = (out + (EVGTreeJson.str(runner.state)))
        out = ((out + ",\"id\":") + (EVGTreeJson.str(id)))
        out = ((out + ",\"takes\":") + (EvgAppRules.boolText(takes)))
        ; How many instances this kit is holding. A host that spawns a process
        ; per press reports the same number forever; one that keeps the app
        ; open reports the components a screen actually has.
        out = ((out + ",\"live\":") + (to_string (this.liveComponents())))
        out = (out + "}")
        return out
    }

    ; The page as a DISPLAY LIST, which is what a painter takes — so a host
    ; that holds this module needs no second process to draw a frame. The whole
    ; loop is then one call: press, build, lay out, list, paint.
    fn frameJson:string (app:EvgApp) {
        def tree:EVGElement (this.buildPage(app runner.state))
        def l (new EVGLayout())
        l.setPageSize((to_double pageW) (to_double pageH))
        l.layout(tree)
        def dl (new EVGDisplayList())
        dl.setTextEngine((l.getTextEngine()))
        dl.build(tree)
        def m (new EVGMeasure())
        m.look(tree pageW pageH "")
        def out:string "{\"state\":"
        out = (out + (EVGTreeJson.str(runner.state)))
        out = ((out + ",\"width\":") + (to_string pageW))
        out = ((out + ",\"height\":") + (to_string pageH))
        out = ((out + ",\"ncmds\":") + (to_string (dl.count())))
        out = ((out + ",\"nodes\":") + (to_string m.nodes))
        out = ((out + ",\"live\":") + (to_string (this.liveComponents())))
        out = ((out + ",\"layout\":") + (m.summary(3)))
        out = ((out + ",\"list\":") + (dl.toJson()))
        return (out + "}")
    }

    ; How many components this kit is holding, which is the number that says
    ; whether anything is being kept at all.
    fn liveComponents:int () {
        return (array_length (host.livePaths()))
    }

    ; A list in the machine's context, as text. The thing a page document
    ; cannot do: one row per item, however many there are.
    fn list:[string] (key:string) {
        def out:[string]
        def v:ScVal (runner.get(key))
        def items:[ScVal] (ScValOps.items(v))
        def i:int 0
        while (i < (array_length items)) {
            push out (EvgAppKit.plain((ScValOps.toJson((itemAt items i)))))
            i = (i + 1)
        }
        return out
    }

    ; Replay the events on the command line from `from` onwards. The machine is
    ; deterministic and the history is a handful of strings, so the caller
    ; holds the session and this stays a program that starts and ends.
    fn replay:void (from:int) {
        def argc:int (shell_arg_cnt)
        def i:int from
        while (i < argc) {
            def ev:string (shell_arg i)
            if ((indexOf ev "--") == 0) {
            } {
                def ignored:boolean (runner.send((ScEvent.of(ev))))
            }
            i = (i + 1)
        }
    }

    ; One build, with a component pass around it. The pass is what disposes a
    ; component whose page is no longer on screen: something disappears from a
    ; view by not being built, and `onDispose` is the only notice it gets.
    fn buildPage:EVGElement (app:EvgApp state:string) {
        host.beginPass()
        def el:EVGElement (app.build(state))
        host.endPass()
        return el
    }

    ; --- the command line -----------------------------------------------------
    ;
    ; The same verbs a data app takes, so `serve.mjs` picks a binary and asks
    ; the same questions of whichever it got.
    fn cli:void (app:EvgApp) {
        app.kit = this
        def argc:int (shell_arg_cnt)
        def verb:string "render"
        if (argc > 0) {
            verb = (shell_arg 0)
        }
        def dir:string (EvgAppRules.textFlag("--app" "."))
        pageW = (EvgAppRules.intFlag("--width" 390))
        pageH = (EvgAppRules.intFlag("--height" 844))
        if ((this.boot(dir)) == false) {
            print (("{\"error\":\"no machine at " + dir) + "/machine.json\"}")
            return
        }
        if (verb == "states") {
            this.states()
            return
        }
        if (verb == "check") {
            this.check(app)
            return
        }
        if (verb == "hit") {
            this.hit(app)
            return
        }
        if (verb == "render") {
            this.render(app)
            return
        }
        print "{\"error\":\"an app takes render, hit, states or check\"}"
    }

    fn states:void () {
        if (null? chart) {
            return
        }
        def sc:Statechart (unwrap chart)
        def out:string "{\"id\":"
        out = (out + (EVGTreeJson.str(sc.id)))
        out = ((out + ",\"initial\":") + (EVGTreeJson.str(sc.initial)))
        out = (out + ",\"code\":true,\"states\":[")
        def n:int (array_length sc.states)
        def wrote:int 0
        def i:int 0
        while (i < n) {
            def st:ScState (itemAt sc.states i)
            if (EvgAppRules.isLeaf(sc st.path)) {
                if (wrote > 0) {
                    out = (out + ",")
                }
                out = (out + "\n  {\"state\":")
                out = (out + (EVGTreeJson.str(st.path)))
                out = (out + ",\"hasPage\":true")
                out = ((out + ",\"events\":") + (EvgAppRules.strArray((EvgAppRules.eventsOf(sc st.path)))))
                out = (out + "}")
                wrote = (wrote + 1)
            }
            i = (i + 1)
        }
        if (wrote > 0) {
            out = (out + "\n")
        }
        out = ((out + "],\"count\":") + (to_string wrote))
        out = (out + "}")
        print out
    }

    ; The page the app is showing after those presses, as a document.
    fn render:void (app:EvgApp) {
        this.replay(1)
        def want:string (EvgAppRules.textFlag("--state" ""))
        def state:string runner.state
        if ((strlen want) > 0) {
            state = want
        }
        def tree:EVGElement (this.buildPage(app state))
        def doc:string (EVGTreeJson.toText(tree))
        def out:string (EvgAppRules.textFlag("--out" ""))
        if ((strlen out) == 0) {
            print doc
            return
        }
        EvgAppRules.spit(out doc)
        def m (new EVGMeasure())
        m.look(tree pageW pageH "")
        def line:string "{\"state\":"
        line = (line + (EVGTreeJson.str(state)))
        line = ((line + ",\"wrote\":") + (EVGTreeJson.str(out)))
        line = ((line + ",\"layout\":") + (m.summary(3)))
        print (line + "}")
    }

    ; A press, as a point: the id under it and whether this state answers to it.
    fn hit:void (app:EvgApp) {
        def argc:int (shell_arg_cnt)
        if (argc < 3) {
            print "{\"error\":\"hit needs an x and a y\"}"
            return
        }
        def xs@(optional):double (to_double (shell_arg 1))
        def ys@(optional):double (to_double (shell_arg 2))
        if (null? xs) {
            print "{\"error\":\"x is not a number\"}"
            return
        }
        if (null? ys) {
            print "{\"error\":\"y is not a number\"}"
            return
        }
        this.replay(3)
        ; The command line ASKS; it does not press. The events it was given are
        ; the whole session, and a `hit` that also sent one would put an event
        ; into a history its caller is holding.
        def before:string runner.state
        def tree:EVGElement (this.buildPage(app before))
        def l (new EVGLayout())
        l.setPageSize((to_double pageW) (to_double pageH))
        l.layout(tree)
        def ht (new EVGHitTest())
        def id:string (ht.idAt(tree (unwrap xs) (unwrap ys)))
        def takes:boolean false
        if ((strlen id) > 0) {
            if ((null? chart) == false) {
                takes = (EvgAppRules.mentions((EvgAppRules.eventsOf((unwrap chart) before)) id))
            }
        }
        def out:string "{\"state\":"
        out = (out + (EVGTreeJson.str(before)))
        out = ((out + ",\"id\":") + (EVGTreeJson.str(id)))
        out = ((out + ",\"takes\":") + (EvgAppRules.boolText(takes)))
        out = (out + "}")
        print out
    }

    ; Every state the machine can reach, built and measured, and every id on it
    ; read back against the machine. An app has more than one screen, so it has
    ; more than one screen to get wrong.
    fn check:void (app:EvgApp) {
        if (null? chart) {
            return
        }
        def sc:Statechart (unwrap chart)
        def problems:[string]
        def reports:[string]
        def n:int (array_length sc.states)
        def i:int 0
        while (i < n) {
            def st:ScState (itemAt sc.states i)
            if (EvgAppRules.isLeaf(sc st.path)) {
                push reports (this.checkState(app sc st.path problems))
            }
            i = (i + 1)
        }
        def out:string "{\"code\":true,\"states\":"
        out = (out + (to_string (array_length reports)))
        out = (out + ",\"pages\":[")
        def k:int 0
        while (k < (array_length reports)) {
            if (k > 0) {
                out = (out + ",")
            }
            out = (out + "\n  ")
            out = (out + (itemAt reports k))
            k = (k + 1)
        }
        if ((array_length reports) > 0) {
            out = (out + "\n")
        }
        out = (out + "],\"problems\":")
        out = (out + (EvgAppRules.strArray(problems)))
        out = ((out + ",\"count\":") + (to_string (array_length problems)))
        out = (out + "}")
        print out
    }

    ; One state: build it from the machine's own start, lay it out, and ask the
    ; same two questions the data app is asked.
    fn checkState:string (app:EvgApp sc:Statechart path:string problems:[string]) {
        def fresh (new ScRunner)
        fresh.start(sc)
        runner = fresh
        def tree:EVGElement (this.buildPage(app path))
        def m (new EVGMeasure())
        m.look(tree pageW pageH "")
        def j:int 0
        while (j < (array_length m.findings)) {
            push problems ((path + ": ") + (itemAt m.findings j))
            j = (j + 1)
        }
        def a:int 0
        while (a < (array_length m.align)) {
            push problems ((path + ": ") + (itemAt m.align a))
            a = (a + 1)
        }
        def ids:[string]
        EvgAppRules.idsOf(tree ids)
        def dead:[string]
        EvgAppRules.deadIds(path (EvgAppRules.eventsOf(sc path)) ids problems dead)
        def out:string "{\"state\":"
        out = (out + (EVGTreeJson.str(path)))
        out = ((out + ",\"layout\":") + (m.summary(3)))
        out = ((out + ",\"ids\":") + (to_string (array_length ids)))
        if ((array_length dead) > 0) {
            out = ((out + ",\"dead\":") + (EvgAppRules.strArray(dead)))
        }
        return (out + "}")
    }

    ; A JSON scalar as a person would read it: the quotes off a string, and
    ; nothing else touched.
    sfn plain:string (json:string) {
        def n:int (strlen json)
        if (n == 0) {
            return ""
        }
        if (json == "null") {
            return ""
        }
        if ((charAt json 0) == 34) {
            if ((charAt json (n - 1)) == 34) {
                return (substring json 1 (n - 1))
            }
        }
        return json
    }
}

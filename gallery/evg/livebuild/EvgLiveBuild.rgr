; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; EvgLiveBuild — an agent that builds an EVG screen, as a stream of events
; ==============================================================================
;
; The case PLAN_WEB_LOADING.md left the door open for: a screen whose content
; is not knowable at build time. Here that screen is being *designed* while
; you watch. An agent (a scripted one in this demo, so the pictures always
; land; a live model in the same socket) emits thinking tokens, then EVGPatch
; ops, then a display list of the tree those ops produced. A browser paints
; the list with the same SVG backend every other EVG page uses.
;
; Nothing here invents a second edit language or a second painter. The ops
; are `EVGPatch`. The frame is `EVGDisplayList.toJson()`. The tree is
; `EVGTreeJson`. The wire is NDJSON, one event per line, which an HTTP server
; can copy onto SSE without parsing.
;
;   {"t":"session", ...}
;   {"t":"think","text":"..."}
;   {"t":"token","text":"..."}
;   {"t":"ops","applied":N,"ops":[...]}
;   {"t":"code","text":"..."}
;   {"t":"frame","ncmds":N,"added":N,"list":{...}}
;   {"t":"measure","count":N,"findings":[...]}
;   {"t":"done","ok":true,"ncmds":N}
;
; ==============================================================================

Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGPatch.rgr"
Import "pkg:evg/EVGTreeJson.rgr"
Import "pkg:evg/EVGLayout.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGInspect.rgr"
Import "pkg:evg/EVGUnit.rgr"

class EvgLiveBuild {
    def root:EVGElement (EVGElement.createDiv())
    def insp:EVGInspect (new EVGInspect())
    def pageW:int 390
    def pageH:int 844
    def kind:string ""
    def prompt:string ""
    def source:string ""
    def lastCmds:int 0
    def steps:int 0
    def findings:int 0
    def failed:boolean false
    def printing:boolean true
    def lines:[string]
    def reject:string ""
    def hush:boolean false

    Constructor () {
        def a:[string]
        lines = a
    }

    fn reset:void () {
        root = (EVGElement.createDiv())
        source = "Import \"pkg:evg/EVGElement.rgr\"
Import \"pkg:evg/EVGLayout.rgr\"
Import \"pkg:evg/EVGDisplayList.rgr\"

sfn main:void () {
"
        lastCmds = 0
        steps = 0
        findings = 0
        failed = false
        reject = ""
        hush = false
        def a:[string]
        lines = a
    }

    fn ops:[EVGPatchOp] () {
        def a:[EVGPatchOp]
        return a
    }

    sfn childPath:string (parent:string index:int) {
        return ((parent + "/") + (to_string index))
    }

    fn styleAt:void (ops:[EVGPatchOp] at:string pairs:[string]) {
        def i:int 0
        def n:int (array_length pairs)
        while ((i + 1) < n) {
            push ops (EVGPatchOp.setProp(at (itemAt pairs i) (itemAt pairs (i + 1))))
            i = (i + 2)
        }
    }

    fn addDiv:void (ops:[EVGPatchOp] parent:string index:int pairs:[string]) {
        push ops (EVGPatchOp.insertNode(parent index "div"))
        this.styleAt(ops (EvgLiveBuild.childPath(parent index)) pairs)
    }

    fn addSpan:void (ops:[EVGPatchOp] parent:string index:int text:string pairs:[string]) {
        push ops (EVGPatchOp.insertNode(parent index "span"))
        def at:string (EvgLiveBuild.childPath(parent index))
        push ops (EVGPatchOp.setText(at text))
        this.styleAt(ops at pairs)
    }

    fn addMetric:void (ops:[EVGPatchOp] parent:string index:int value:string label:string) {
        this.addDiv(ops parent index ([] _:string ( "display" "flex" "flex-direction" "column" "justify-content" "center" "height" "64px" "padding-left" "16px" "padding-right" "16px" "background-color" "rgb(30,41,59)" "border-radius" "14px" "gap" "4px" )))
        def card:string (EvgLiveBuild.childPath(parent index))
        this.addSpan(ops card 0 value ([] _:string ( "font-size" "26px" "font-weight" "bold" "color" "rgb(248,250,252)" )))
        this.addSpan(ops card 1 label ([] _:string ( "font-size" "12px" "color" "rgb(148,163,184)" )))
    }

    fn addRow:void (ops:[EVGPatchOp] parent:string index:int name:string amount:string) {
        this.addDiv(ops parent index ([] _:string ( "display" "flex" "flex-direction" "row" "align-items" "center" "justify-content" "space-between" "height" "44px" "padding-left" "14px" "padding-right" "14px" "background-color" "rgb(30,41,59)" "border-radius" "10px" )))
        def row:string (EvgLiveBuild.childPath(parent index))
        this.addSpan(ops row 0 name ([] _:string ( "font-size" "14px" "color" "rgb(226,232,240)" )))
        this.addSpan(ops row 1 amount ([] _:string ( "font-size" "14px" "font-weight" "bold" "color" "rgb(125,211,252)" )))
    }

    fn addSetting:void (ops:[EVGPatchOp] parent:string index:int name:string value:string) {
        this.addDiv(ops parent index ([] _:string ( "display" "flex" "flex-direction" "row" "align-items" "center" "justify-content" "space-between" "height" "48px" "padding-left" "16px" "padding-right" "16px" "background-color" "rgb(255,255,255)" "border-radius" "12px" )))
        def row:string (EvgLiveBuild.childPath(parent index))
        this.addSpan(ops row 0 name ([] _:string ( "font-size" "15px" "color" "rgb(15,23,42)" )))
        this.addSpan(ops row 1 value ([] _:string ( "font-size" "13px" "color" "rgb(100,116,139)" )))
    }

    ; --- the wire -------------------------------------------------------------

    fn emitLine:void (s:string) {
        push lines s
        if printing {
            print s
        }
    }

    fn emitSession:void (k:string p:string) {
        kind = k
        prompt = p
        def out:string "{\"t\":\"session\",\"kind\":"
        out = (out + (EVGTreeJson.str(k)))
        out = ((out + ",\"prompt\":") + (EVGTreeJson.str(p)))
        out = ((out + ",\"width\":") + (to_string pageW))
        out = ((out + ",\"height\":") + (to_string pageH))
        out = (out + "}")
        this.emitLine(out)
    }

    fn emitThink:void (text:string) {
        def out:string "{\"t\":\"think\",\"text\":"
        out = ((out + (EVGTreeJson.str(text))) + "}")
        this.emitLine(out)
        def i:int 0
        def n:int (strlen text)
        def word:string ""
        while (i < n) {
            def c:int (charAt text i)
            if (c == 32) {
                if ((strlen word) > 0) {
                    this.emitToken(word)
                    word = ""
                }
            } {
                word = (word + (substring text i (i + 1)))
            }
            i = (i + 1)
        }
        if ((strlen word) > 0) {
            this.emitToken(word)
        }
    }

    fn emitToken:void (word:string) {
        def out:string "{\"t\":\"token\",\"text\":"
        out = ((out + (EVGTreeJson.str(word))) + "}")
        this.emitLine(out)
    }

    sfn opJson:string (op:EVGPatchOp) {
        def out:string "{\"op\":"
        out = (out + (EVGTreeJson.str(op.op)))
        out = ((out + ",\"at\":") + (EVGTreeJson.str(op.at)))
        if ((strlen op.prop) > 0) {
            out = ((out + ",\"prop\":") + (EVGTreeJson.str(op.prop)))
        }
        if ((op.op == "set-prop") || (op.op == "set-text")) {
            out = ((out + ",\"value\":") + (EVGTreeJson.str(op.value)))
        }
        if ((strlen op.tag) > 0) {
            out = ((out + ",\"tag\":") + (EVGTreeJson.str(op.tag)))
        }
        if ((op.op == "insert") || (op.op == "move")) {
            out = ((out + ",\"index\":") + (to_string op.index))
        }
        return (out + "}")
    }

    fn emitOps:void (ops:[EVGPatchOp] applied:int) {
        def out:string "{\"t\":\"ops\",\"applied\":"
        out = (out + (to_string applied))
        out = (out + ",\"ops\":[")
        def i:int 0
        while (i < (array_length ops)) {
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + (EvgLiveBuild.opJson((itemAt ops i))))
            i = (i + 1)
        }
        out = (out + "]}")
        this.emitLine(out)
    }

    fn appendCode:void (snippet:string) {
        source = (source + snippet)
    }

    fn emitCode:void () {
        def out:string "{\"t\":\"code\",\"path\":\"App.rgr\",\"text\":"
        out = ((out + (EVGTreeJson.str(source))) + "}")
        this.emitLine(out)
    }

    fn emitError:void (why:string) {
        failed = true
        reject = why
        def out:string "{\"t\":\"error\",\"text\":"
        out = ((out + (EVGTreeJson.str(why))) + "}")
        this.emitLine(out)
    }

    fn applyOps:boolean (ops:[EVGPatchOp]) {
        if ((array_length ops) == 0) {
            return true
        }
        def p (new EVGPatch())
        def r:EVGPatchResult (p.apply(root ops))
        if (r.ok == false) {
            this.emitError((r.reason()))
            return false
        }
        if (hush == false) {
            this.emitOps(ops r.applied)
        }
        return true
    }

    fn emitFrame:void () {
        def l (new EVGLayout())
        l.setPageSize((to_double pageW) (to_double pageH))
        l.layout(root)
        def dl (new EVGDisplayList())
        dl.setTextEngine((l.getTextEngine()))
        dl.build(root)
        def n:int (dl.count())
        def added:int (n - lastCmds)
        lastCmds = n
        insp.build(root)
        def nodes:int (insp.count())
        def out:string "{\"t\":\"frame\""
        out = ((out + ",\"width\":") + (to_string pageW))
        out = ((out + ",\"height\":") + (to_string pageH))
        out = ((out + ",\"ncmds\":") + (to_string n))
        out = ((out + ",\"added\":") + (to_string added))
        out = ((out + ",\"nodes\":") + (to_string nodes))
        out = ((out + ",\"list\":") + (dl.toJson()))
        out = (out + "}")
        this.emitLine(out)
    }

    fn emitMeasure:void () {
        def l (new EVGLayout())
        l.setPageSize((to_double pageW) (to_double pageH))
        l.layout(root)
        insp.build(root)
        def found:[string]
        def w:double (to_double pageW)
        def h:double (to_double pageH)
        def i:int 0
        while (i < (insp.count())) {
            def path:string (insp.pathAt(i))
            def hit@(optional):EVGElement (insp.elementAt(path))
            if ((null? hit) == false) {
                def el:EVGElement (unwrap hit)
                def right:double (el.calculatedX + el.calculatedWidth)
                def bottom:double (el.calculatedY + el.calculatedHeight)
                if (right > (w + 0.5)) {
                    push found (path + " overflows right")
                }
                if (bottom > (h + 0.5)) {
                    push found (path + " overflows bottom")
                }
            }
            i = (i + 1)
        }
        findings = (array_length found)
        def out:string "{\"t\":\"measure\",\"count\":"
        out = (out + (to_string findings))
        out = (out + ",\"findings\":[")
        def k:int 0
        while (k < findings) {
            if (k > 0) {
                out = (out + ",")
            }
            out = (out + (EVGTreeJson.str((itemAt found k))))
            k = (k + 1)
        }
        out = (out + "]}")
        this.emitLine(out)
    }

    fn emitDone:void () {
        if ((strlen source) > 0) {
            this.appendCode("
  def lay (new EVGLayout())
  lay.setPageSize(390.0 844.0)
  lay.layout(page)
  def dl (new EVGDisplayList())
  dl.setTextEngine((lay.getTextEngine()))
  dl.build(page)
}
")
            this.emitCode()
        }
        def ok:boolean true
        if failed {
            ok = false
        }
        def out:string "{\"t\":\"done\",\"ok\":"
        if ok {
            out = (out + "true")
        } {
            out = (out + "false")
        }
        out = ((out + ",\"steps\":") + (to_string steps))
        out = ((out + ",\"ncmds\":") + (to_string lastCmds))
        out = ((out + ",\"findings\":") + (to_string findings))
        if ((strlen reject) > 0) {
            out = ((out + ",\"rejected\":") + (EVGTreeJson.str(reject)))
        }
        out = (out + "}")
        this.emitLine(out)
    }

    fn step:void (think:string ops:[EVGPatchOp] snippet:string) {
        if failed {
            return
        }
        if hush {
            def quietOk:boolean (this.applyOps(ops))
            if (quietOk == false) {
                return
            }
            this.appendCode(snippet)
            return
        }
        this.emitThink(think)
        def ok:boolean (this.applyOps(ops))
        if (ok == false) {
            return
        }
        this.appendCode(snippet)
        this.emitCode()
        this.emitFrame()
        steps = (steps + 1)
    }

    ; --- recipes --------------------------------------------------------------

    fn pageShell:void (bg:string title:string badge:string titleColor:string muted:string hello:string sub:string) {
        def shell:[EVGPatchOp] (this.ops())
        this.styleAt(shell "0" ([] _:string ( "width" "390px" "height" "844px" "display" "flex" "flex-direction" "column" "background-color" bg "padding-top" "16px" "padding-right" "16px" "padding-bottom" "16px" "padding-left" "16px" "gap" "8px" "font-family" "Noto Sans" )))
        this.step("Start with a phone column. Fixed 390 by 844, padding, a gap, so later cards have a place to sit." shell "
  def page (EVGElement.createDiv())
  page.setAttribute(\"width\" \"390px\")
  page.setAttribute(\"height\" \"844px\")
  page.setAttribute(\"display\" \"flex\")
  page.setAttribute(\"flex-direction\" \"column\")
")
        def head:[EVGPatchOp] (this.ops())
        this.addDiv(head "0" 0 ([] _:string ( "display" "flex" "flex-direction" "row" "align-items" "center" "justify-content" "space-between" "height" "40px" )))
        this.addSpan(head "0/0" 0 title ([] _:string ( "font-size" "20px" "font-weight" "bold" "color" titleColor )))
        this.addSpan(head "0/0" 1 badge ([] _:string ( "font-size" "11px" "color" muted )))
        this.step("A header row: the product name on the left, a small live badge on the right." head "
  def header (EVGElement.createDiv())
  header.setAttribute(\"display\" \"flex\")
  page.addChild(header)
")
        def greet:[EVGPatchOp] (this.ops())
        this.addDiv(greet "0" 1 ([] _:string ( "display" "flex" "flex-direction" "column" "gap" "4px" )))
        this.addSpan(greet "0/1" 0 hello ([] _:string ( "font-size" "13px" "color" muted )))
        this.addSpan(greet "0/1" 1 sub ([] _:string ( "font-size" "20px" "font-weight" "bold" "color" titleColor )))
        this.step("Then the greeting. Two lines so the page has a voice before it has numbers." greet "
  def greet (EVGElement.createDiv())
  page.addChild(greet)
")
    }

    fn recipeDashboard:void () {
        this.pageShell("rgb(15,23,42)" "Northwind" "live" "rgb(248,250,252)" "rgb(125,211,252)" "Good morning" "Today at a glance")
        def m1:[EVGPatchOp] (this.ops())
        this.addMetric(m1 "0" 2 "1,284" "Orders this month")
        this.step("First metric: orders. A dark card, the number large, the label quiet." m1 "
  ; metric: orders
")
        def m2:[EVGPatchOp] (this.ops())
        this.addMetric(m2 "0" 3 "€48.2k" "Revenue this month")
        this.step("Revenue next to it, same shape, so the eye can compare without decoding a new layout." m2 "
  ; metric: revenue
")
        def m3:[EVGPatchOp] (this.ops())
        this.addMetric(m3 "0" 4 "312" "Active customers")
        this.step("Active customers closes the trio. Three cards is enough for a glance and not a report." m3 "
  ; metric: active
")
        def sec:[EVGPatchOp] (this.ops())
        this.addSpan(sec "0" 5 "Today" ([] _:string ( "font-size" "13px" "font-weight" "bold" "color" "rgb(148,163,184)" )))
        this.addRow(sec "0" 6 "Acme Ltd" "€420")
        this.addRow(sec "0" 7 "Rivermill" "€180")
        this.addRow(sec "0" 8 "North Park" "€96")
        this.step("A Today list under the metrics: three open invoices, name and amount, no chrome." sec "
  ; today's invoices
")
        def nav:[EVGPatchOp] (this.ops())
        this.addDiv(nav "0" 9 ([] _:string ( "display" "flex" "flex-direction" "row" "align-items" "center" "justify-content" "space-around" "position" "absolute" "left" "16px" "bottom" "16px" "width" "358px" "height" "52px" "background-color" "rgb(30,41,59)" "border-radius" "16px" )))
        this.addSpan(nav "0/9" 0 "Home" ([] _:string ( "font-size" "13px" "font-weight" "bold" "color" "rgb(125,211,252)" )))
        this.addSpan(nav "0/9" 1 "Search" ([] _:string ( "font-size" "13px" "color" "rgb(148,163,184)" )))
        this.addSpan(nav "0/9" 2 "You" ([] _:string ( "font-size" "13px" "color" "rgb(148,163,184)" )))
        this.step("A three-item bar, absolutely placed on the bottom, like a phone tab bar." nav "
  ; tab bar
")
    }

    fn recipeSettings:void () {
        this.pageShell("rgb(241,245,249)" "Settings" "you" "rgb(15,23,42)" "rgb(100,116,139)" "Account" "How the product talks to you")
        def prof:[EVGPatchOp] (this.ops())
        this.addDiv(prof "0" 2 ([] _:string ( "display" "flex" "flex-direction" "row" "align-items" "center" "height" "80px" "padding-left" "16px" "padding-right" "16px" "background-color" "rgb(255,255,255)" "border-radius" "16px" "gap" "14px" )))
        this.addDiv(prof "0/2" 0 ([] _:string ( "width" "56px" "height" "56px" "border-radius" "28px" "background-color" "rgb(14,165,233)" )))
        this.addDiv(prof "0/2" 1 ([] _:string ( "display" "flex" "flex-direction" "column" "gap" "4px" )))
        this.addSpan(prof "0/2/1" 0 "Tero Testinen" ([] _:string ( "font-size" "16px" "font-weight" "bold" "color" "rgb(15,23,42)" )))
        this.addSpan(prof "0/2/1" 1 "tero@northwind.fi" ([] _:string ( "font-size" "13px" "color" "rgb(100,116,139)" )))
        this.step("A profile card: a round stand-in for an avatar, then the name and the mail." prof "
  ; profile
")
        def rows:[EVGPatchOp] (this.ops())
        this.addSetting(rows "0" 3 "Notifications" "On")
        this.addSetting(rows "0" 4 "Weekly digest" "Mondays")
        this.addSetting(rows "0" 5 "Language" "English")
        this.addSetting(rows "0" 6 "Appearance" "System")
        this.step("Four settings rows, one fact each. The value sits on the right so a thumb can find it." rows "
  ; settings rows
")
        def foot:[EVGPatchOp] (this.ops())
        this.addDiv(foot "0" 7 ([] _:string ( "display" "flex" "flex-direction" "row" "align-items" "center" "justify-content" "center" "position" "absolute" "left" "16px" "bottom" "16px" "width" "358px" "height" "48px" "background-color" "rgb(254,226,226)" "border-radius" "12px" )))
        this.addSpan(foot "0/7" 0 "Sign out" ([] _:string ( "font-size" "15px" "font-weight" "bold" "color" "rgb(185,28,28)" )))
        this.step("Sign out, placed on the bottom so it does not crowd the rows." foot "
  ; sign out
")
    }

    fn recipeInvoices:void () {
        this.pageShell("rgb(248,250,252)" "Invoices" "open" "rgb(15,23,42)" "rgb(14,165,233)" "This week" "Three bills still open")
        def bar:[EVGPatchOp] (this.ops())
        this.addDiv(bar "0" 2 ([] _:string ( "display" "flex" "flex-direction" "row" "align-items" "center" "justify-content" "space-between" "height" "40px" )))
        this.addDiv(bar "0/2" 0 ([] _:string ( "display" "flex" "flex-direction" "row" "align-items" "center" "height" "36px" "padding-left" "12px" "padding-right" "12px" "background-color" "rgb(226,232,240)" "border-radius" "10px" "flex-grow" "1" )))
        this.addSpan(bar "0/2/0" 0 "Search invoices" ([] _:string ( "font-size" "13px" "color" "rgb(100,116,139)" )))
        this.addDiv(bar "0/2" 1 ([] _:string ( "display" "flex" "flex-direction" "row" "align-items" "center" "justify-content" "center" "height" "36px" "width" "72px" "margin-left" "8px" "background-color" "rgb(14,165,233)" "border-radius" "10px" )))
        this.addSpan(bar "0/2/1" 0 "New" ([] _:string ( "font-size" "13px" "font-weight" "bold" "color" "rgb(255,255,255)" )))
        this.step("A search field and a New button on one row. The action is the coloured one." bar "
  ; search + new
")
        def list:[EVGPatchOp] (this.ops())
        this.addRow(list "0" 3 "INV-1042  Acme Ltd" "€420")
        this.addRow(list "0" 4 "INV-1041  Rivermill" "€180")
        this.addRow(list "0" 5 "INV-1038  North Park" "€96")
        this.addRow(list "0" 6 "INV-1033  Harbour Co" "€1,240")
        this.step("Four invoice rows. The identifier and the customer share the left, the amount the right." list "
  ; invoice rows
")
        def sum:[EVGPatchOp] (this.ops())
        this.addDiv(sum "0" 7 ([] _:string ( "display" "flex" "flex-direction" "row" "align-items" "center" "justify-content" "space-between" "position" "absolute" "left" "16px" "bottom" "16px" "width" "358px" "height" "56px" "padding-left" "16px" "padding-right" "16px" "background-color" "rgb(15,23,42)" "border-radius" "14px" )))
        this.addSpan(sum "0/7" 0 "Open total" ([] _:string ( "font-size" "13px" "color" "rgb(148,163,184)" )))
        this.addSpan(sum "0/7" 1 "€1,936" ([] _:string ( "font-size" "20px" "font-weight" "bold" "color" "rgb(255,255,255)" )))
        this.step("A dark total bar at the bottom so the sum is the last thing the eye hits." sum "
  ; open total
")
    }

    fn emitDoc:void () {
        def text:string (EVGTreeJson.toText(root))
        def out:string "{\"t\":\"code\",\"path\":\"doc.evg.json\",\"text\":"
        out = ((out + (EVGTreeJson.str(text))) + "}")
        this.emitLine(out)
    }

    sfn sizeOf:int (el:EVGElement wide:boolean fallback:int) {
        def u@(optional):EVGUnit el.height
        if wide {
            u = el.width
        }
        if (null? u) {
            return fallback
        }
        def uu:EVGUnit (unwrap u)
        if (uu.isSet == false) {
            return fallback
        }
        if (uu.unitType != 0) {
            return fallback
        }
        def px:int (to_int uu.value)
        if (px <= 0) {
            return fallback
        }
        return px
    }

    sfn lastSlash:int (path:string) {
        def at:int (0 - 1)
        def i:int 0
        while (i < (strlen path)) {
            if ((charAt path i) == 47) {
                at = i
            }
            i = (i + 1)
        }
        return at
    }

    sfn slurp@(optional):string (path:string) {
        def cut:int (EvgLiveBuild.lastSlash(path))
        def dir:string "."
        def name:string path
        if (cut >= 0) {
            dir = (substring path 0 cut)
            name = (substring path (cut + 1) (strlen path))
        }
        def text@(optional):string (read_file dir name)
        return text
    }

    fn runFrameFile:void (docPath:string) {
        def a:[string]
        lines = a
        failed = false
        lastCmds = 0
        steps = 0
        findings = 0
        reject = ""
        source = ""
        def text@(optional):string (EvgLiveBuild.slurp(docPath))
        if (null? text) {
            this.emitError(("cannot read " + docPath))
            this.emitDone()
            return
        }
        def loaded@(optional):EVGElement (EVGTreeJson.fromText((unwrap text)))
        if (null? loaded) {
            this.emitError(("not an EVG document: " + docPath))
            this.emitDone()
            return
        }
        root = (unwrap loaded)
        pageW = (EvgLiveBuild.sizeOf(root true pageW))
        pageH = (EvgLiveBuild.sizeOf(root false pageH))
        this.emitFrame()
        this.emitMeasure()
        this.emitDoc()
        steps = 1
        this.emitDone()
    }

    sfn hasSub:boolean (hay:string needle:string) {
        def n:int (strlen needle)
        def m:int (strlen hay)
        if (n == 0) {
            return false
        }
        if (n > m) {
            return false
        }
        def i:int 0
        while (i <= (m - n)) {
            if ((substring hay i (i + n)) == needle) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn foldAscii:string (s:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def c:int (charAt s i)
            if ((c >= 65) && (c <= 90)) {
                c = (c + 32)
            }
            out = (out + (strfromcode c))
            i = (i + 1)
        }
        return out
    }

    fn wantsRestyle:boolean (folded:string) {
        if ((strlen folded) == 0) {
            return false
        }
        if (EvgLiveBuild.hasSub(folded "gold")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "accent")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "kulta")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "korost")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "larger")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "title")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "isompi")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "otsikko")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "round")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "pyore")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "radius")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "warm")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "lammin")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "lämmin")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "ulkoasu")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "appearance")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "restyle")) {
            return true
        }
        if (EvgLiveBuild.hasSub(folded "look")) {
            return true
        }
        return false
    }

    fn sessionPrompt:string (k:string ask:string) {
        if ((strlen ask) > 0) {
            return ask
        }
        if (k == "settings") {
            return "A settings screen with a profile, notifications, and a sign-out."
        }
        if (k == "invoices") {
            return "An invoices list with a New button and the open bills."
        }
        return "A phone dashboard for Northwind: orders, revenue, today's invoices."
    }

    fn recipeRestyle:void (folded:string) {
        def doTitle:boolean false
        def doGold:boolean false
        def doRound:boolean false
        def doWarm:boolean false
        if (EvgLiveBuild.hasSub(folded "larger")) {
            doTitle = true
        }
        if (EvgLiveBuild.hasSub(folded "title")) {
            doTitle = true
        }
        if (EvgLiveBuild.hasSub(folded "isompi")) {
            doTitle = true
        }
        if (EvgLiveBuild.hasSub(folded "otsikko")) {
            doTitle = true
        }
        if (EvgLiveBuild.hasSub(folded "gold")) {
            doGold = true
        }
        if (EvgLiveBuild.hasSub(folded "accent")) {
            doGold = true
        }
        if (EvgLiveBuild.hasSub(folded "kulta")) {
            doGold = true
        }
        if (EvgLiveBuild.hasSub(folded "korost")) {
            doGold = true
        }
        if (EvgLiveBuild.hasSub(folded "round")) {
            doRound = true
        }
        if (EvgLiveBuild.hasSub(folded "radius")) {
            doRound = true
        }
        if (EvgLiveBuild.hasSub(folded "pyore")) {
            doRound = true
        }
        if (EvgLiveBuild.hasSub(folded "warm")) {
            doWarm = true
        }
        if (EvgLiveBuild.hasSub(folded "lammin")) {
            doWarm = true
        }
        if (EvgLiveBuild.hasSub(folded "lämmin")) {
            doWarm = true
        }
        if (((doTitle == false) && (doGold == false)) && ((doRound == false) && (doWarm == false))) {
            doTitle = true
            doGold = true
            doRound = true
        }
        this.emitThink("The screen is already up. I will keep the structure and change how it looks.")
        if doTitle {
            def titleOps:[EVGPatchOp] (this.ops())
            this.styleAt(titleOps "0/0/0" ([] _:string ( "font-size" "28px" )))
            this.styleAt(titleOps "0/1/1" ([] _:string ( "font-size" "24px" )))
            this.step("Bump the product name and the greeting so the hierarchy reads from across the room." titleOps "
  ; restyle: larger title
")
        }
        if doGold {
            def goldOps:[EVGPatchOp] (this.ops())
            this.styleAt(goldOps "0/0/1" ([] _:string ( "color" "rgb(251,191,36)" )))
            if (kind == "dashboard") {
                this.styleAt(goldOps "0/2/0" ([] _:string ( "color" "rgb(251,191,36)" )))
                this.styleAt(goldOps "0/3/0" ([] _:string ( "color" "rgb(251,191,36)" )))
                this.styleAt(goldOps "0/4/0" ([] _:string ( "color" "rgb(251,191,36)" )))
                this.styleAt(goldOps "0/6/1" ([] _:string ( "color" "rgb(251,191,36)" )))
                this.styleAt(goldOps "0/7/1" ([] _:string ( "color" "rgb(251,191,36)" )))
                this.styleAt(goldOps "0/8/1" ([] _:string ( "color" "rgb(251,191,36)" )))
                this.styleAt(goldOps "0/9/0" ([] _:string ( "color" "rgb(251,191,36)" )))
            }
            this.step("A gold accent on the badge, the numbers, and the active tab. One colour, many hits." goldOps "
  ; restyle: gold accent
")
        }
        if doRound {
            def roundOps:[EVGPatchOp] (this.ops())
            if (kind == "dashboard") {
                this.styleAt(roundOps "0/2" ([] _:string ( "border-radius" "24px" )))
                this.styleAt(roundOps "0/3" ([] _:string ( "border-radius" "24px" )))
                this.styleAt(roundOps "0/4" ([] _:string ( "border-radius" "24px" )))
                this.styleAt(roundOps "0/6" ([] _:string ( "border-radius" "16px" )))
                this.styleAt(roundOps "0/7" ([] _:string ( "border-radius" "16px" )))
                this.styleAt(roundOps "0/8" ([] _:string ( "border-radius" "16px" )))
                this.styleAt(roundOps "0/9" ([] _:string ( "border-radius" "26px" )))
            } {
                this.styleAt(roundOps "0/2" ([] _:string ( "border-radius" "24px" )))
                this.styleAt(roundOps "0/3" ([] _:string ( "border-radius" "18px" )))
                this.styleAt(roundOps "0/4" ([] _:string ( "border-radius" "18px" )))
            }
            this.step("Round the metric cards further. Softer corners, same information." roundOps "
  ; restyle: rounder cards
")
        }
        if doWarm {
            def warmOps:[EVGPatchOp] (this.ops())
            this.styleAt(warmOps "0" ([] _:string ( "background-color" "rgb(49,30,20)" )))
            if (kind == "dashboard") {
                this.styleAt(warmOps "0/2" ([] _:string ( "background-color" "rgb(69,40,26)" )))
                this.styleAt(warmOps "0/3" ([] _:string ( "background-color" "rgb(69,40,26)" )))
                this.styleAt(warmOps "0/4" ([] _:string ( "background-color" "rgb(69,40,26)" )))
                this.styleAt(warmOps "0/6" ([] _:string ( "background-color" "rgb(69,40,26)" )))
                this.styleAt(warmOps "0/7" ([] _:string ( "background-color" "rgb(69,40,26)" )))
                this.styleAt(warmOps "0/8" ([] _:string ( "background-color" "rgb(69,40,26)" )))
                this.styleAt(warmOps "0/9" ([] _:string ( "background-color" "rgb(69,40,26)" )))
            }
            this.step("Warm the paper: a brown night instead of slate, so the gold has something to sit on." warmOps "
  ; restyle: warm paper
")
        }
    }

    fn runAsked:void (k:string ask:string) {
        this.reset()
        def folded:string (EvgLiveBuild.foldAscii(ask))
        def restyle:boolean (this.wantsRestyle(folded))
        hush = restyle
        if (k == "settings") {
            this.emitSession("settings" (this.sessionPrompt("settings" ask)))
            this.recipeSettings()
        } {
            if (k == "invoices") {
                this.emitSession("invoices" (this.sessionPrompt("invoices" ask)))
                this.recipeInvoices()
            } {
                this.emitSession("dashboard" (this.sessionPrompt("dashboard" ask)))
                this.recipeDashboard()
            }
        }
        hush = false
        if restyle {
            this.recipeRestyle(folded)
        }
        this.emitMeasure()
        this.emitDone()
    }

    fn runKind:void (k:string) {
        this.runAsked(k "")
    }

    fn runCli:void () {
        def argc:int (shell_arg_cnt)
        if (argc < 1) {
            print "usage: evg_livebuild run <dashboard|settings|invoices>"
            print "       evg_livebuild frame <doc.evg.json>"
            print "       evg_livebuild kinds"
            return
        }
        def verb:string (shell_arg 0)
        if (verb == "kinds") {
            print "dashboard"
            print "settings"
            print "invoices"
            return
        }
        if (verb == "run") {
            def k:string "dashboard"
            if (argc >= 2) {
                k = (shell_arg 1)
            }
            def ask:string ""
            if (argc >= 3) {
                ask = (shell_arg 2)
            } {
                def envP@(optional):string (env_var "EVG_LIVEBUILD_PROMPT")
                if (null? envP) {
                } {
                    ask = (unwrap envP)
                }
            }
            this.runAsked(k ask)
            return
        }
        if (verb == "frame") {
            if (argc < 2) {
                print "usage: evg_livebuild frame <doc.evg.json>"
                return
            }
            this.runFrameFile((shell_arg 1))
            return
        }
        print ("unknown verb " + verb)
    }
}

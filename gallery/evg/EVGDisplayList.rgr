; SPDX-License-Identifier: AGPL-3.0-or-later

; EVGDisplayList.rgr — one traversal, a flat list of draw commands
;
; EVG computes geometry and stops there; something else has to paint it. Today
; five painters each walk the laid-out tree themselves and each decide again
; what a box means:
;
;   EVGPDFRenderer          -> PDF operators
;   evg_png_tool + raster   -> CPU pixels
;   EVGHTMLRenderer         -> absolutely positioned <div>s
;   v2 ui/UIContext         -> framebuffer fillRect
;   game_engine/ui/UILayer  -> interactive HUD on the same framebuffer
;
; Five copies of the same walk is how border-radius came to work in PDF and
; silently not in PNG: one painter read `el.box.borderRadius` and the other
; read a stale `el.borderRadius` that nothing wrote. A sixth backend (GL,
; WebGL, SDL2) should not be a sixth copy.
;
; So: walk once, emit commands, and let a backend consume them.
;
; Two backends consume this today and neither walks a tree: `gl/evg-webgl.js`
; and `html/evg-html.js`. The second one is worth knowing about from here,
; because it says something about the shape of this list rather than about the
; DOM: SVG has a native answer for seven of the eight kinds, and the two it
; answers BETTER than the GPU does are PATH (rings and a fill rule, no stencil)
; and the CLIP STACK (nested clip paths intersect by construction, where a
; scissor is one rectangle that has to be intersected by hand). The two are
; checked against each other pixel for pixel — see
; gallery/pptx/web/html/parity.mjs.
;
; What neither of them can do is keep an element's IDENTITY, because a command
; below carries none: an `id` here is the one field that would let a DOM
; backend patch nodes instead of rebuilding them, and let a transition, a focus
; ring or a native <input> attach to something that survives a frame. A command is
; deliberately dumb — absolute pixels, resolved colours, no tree, no units —
; because that is what a GPU backend wants: quads it can batch, glyph runs it
; can look up in an atlas, and clip rectangles it can push and pop.
;
; This module is pure. It reads a laid-out tree and allocates no device
; resources, so it compiles to every target Ranger has, which is what lets the
; same list drive WebGL in a browser and SDL2 on a Raspberry Pi.

Import "EVGElement.rgr"
Import "EVGColor.rgr"
Import "EVGTextEngine.rgr"
Import "SVGPathParser.rgr"
Import "VectorViewBox.rgr"
Import "SvgParser.rgr"

; Command kinds. Kept as ints so a backend can switch on them cheaply.
;   0 RECT   filled box, possibly rounded
;   1 BORDER stroked outline, possibly rounded
;   2 IMAGE  textured quad, src names the file
;   3 TEXT   one run on one line, already positioned at its baseline
;   4 PUSH_CLIP / 5 POP_CLIP  scissor rectangle
;   6 PATH   filled vector outline, as flattened rings
;   7 STROKE stroked vector outline, as flattened rings
class EVGDrawCmd {
    def kind:int 0
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0
    ; The TOP-LEFT radius, and — when `perCorner` is set — the other three.
    ; One number is what every backend but the WebGL painter reads, and it is
    ; what a box with one radius has always emitted, so nothing that consumes
    ; this had to change to keep working.
    def radius:double 0.0
    def perCorner:boolean false
    def radiusTR:double 0.0
    def radiusBR:double 0.0
    def radiusBL:double 0.0
    def thickness:double 0.0
    ; Colour, pre-resolved to 0-255 + alpha 0-1 so a backend needs no EVGColor.
    def r:int 0
    def g:int 0
    def b:int 0
    def a:double 1.0
    ; TEXT
    def text:string ""
    def fontFamily:string ""
    def fontSize:double 0.0
    ; Optional paragraph alignment for SoftCanvas: left / center / right.
    ; When set, `w` is the text-box content width used to measure & place the run.
    def textAlign:string ""
    def fontWeight:string ""
    def maxWidth:double 0.0
    ; Optional 2-stop gradient for RECT (kind 0)
    def hasGrad:boolean false
    def gradDir:int 0
    def r2:int 0
    def g2:int 0
    def b2:int 0
    def a2:double 1.0
    ; `backdrop-filter: blur(Npx)` on a RECT: soften what is already painted
    ; behind this rectangle before drawing it, clipped to the rectangle and its
    ; radius. 0 is no filter.
    ;
    ; It is on the RECT and not a command of its own because it is a property
    ; of the surface, and a backend that cannot do it draws the rectangle and
    ; loses only the softening — which is the right failure. A separate
    ; "blur this region" command would leave such a backend with a hole.
    def backdropBlur:double 0.0
    ; Optional drop shadow under RECT / PATH
    def hasShadow:boolean false
    def shadowX:double 0.0
    def shadowY:double 0.0
    def shadowBlur:double 0.0
    def shadowR:int 0
    def shadowG:int 0
    def shadowB:int 0
    def shadowA:double 0.35
    ; IMAGE
    def src:string ""
    ; An image drawn mirrored in its own box: a deck can say `flipH` / `flipV`
    ; on a picture, and mirroring is the texture read backwards rather than a
    ; transform of the quad.
    def flipH:boolean false
    def flipV:boolean false
    ; PATH / STROKE. The rings are already flattened and already in page
    ; coordinates: a GPU backend should not have to carry a path parser, and
    ; the curve subdivision belongs where the drawn size is known. `ringEnds`
    ; gives the index in `pts` one past each ring's last coordinate, so a shape
    ; with a hole survives as two rings rather than one confused outline.
    def pts:[double]
    def ringEnds:[int]
    def evenOdd:boolean false
    ; Rotation in degrees, as the element asked for it. Text is what first
    ; needed this — an axis title on its side.
    def rotate:double 0.0
    ; What it turns ABOUT. Unset means the command's own box centre, which is
    ; right for a lone rotated label and wrong for everything else: a box, its
    ; text and its children have to turn about ONE point or they come apart.
    ;
    ; A text command is where that shows first and worst. The painter draws
    ; glyphs in a quad sized to the ink, not to the line box the command
    ; carries, so "rotate each command about its own centre" puts the words
    ; somewhere the box is not. A backend that ignores these two fields keeps
    ; the old behaviour exactly, which is why they are additive rather than a
    ; change to `rotate`.
    def rotOriginX:double 0.0
    def rotOriginY:double 0.0
    def hasRotOrigin:boolean false

    Constructor () {
    }

    fn kindName:string () {
        if (kind == 0) {
            return "RECT"
        }
        if (kind == 1) {
            return "BORDER"
        }
        if (kind == 2) {
            return "IMAGE"
        }
        if (kind == 3) {
            return "TEXT"
        }
        if (kind == 4) {
            return "PUSH_CLIP"
        }
        if (kind == 5) {
            return "POP_CLIP"
        }
        if (kind == 6) {
            return "PATH"
        }
        return "STROKE"
    }
}

; ==============================================================================
; EVGSceneBinary — the same display list, as typed arrays instead of text
; ==============================================================================
;
; `toJson` is the bridge every host has used to get a picture out of the
; engine, and on a chart-heavy slide it is what the frame costs. Measured, one
; slide of 10 084 commands and 88 656 point coordinates:
;
;     buildFrame      12 ms      the layout — the actual work
;     toJson          62 ms      turning it into 1.47 MB of text
;     JSON.parse      19 ms      the host turning that text back into objects
;
; Five sixths of a frame spent handing over a picture that took a sixth to
; compute. And the text is not the cost either: assembling 1.47 MB with 200 000
; concatenations is 3 ms, and formatting every number is 25. It is death by
; half a million small operations, so no faster string writer would help.
;
; Typed arrays do not have the problem at all. `int_buffer` is an `Int32Array`
; on the JavaScript target and a flat block of memory everywhere else; filling
; 500 000 of them takes 3 ms, and the host reads the SAME array — nothing is
; parsed, nothing is copied, nothing is allocated per command.
;
; WHY FIXED POINT. `toJson` writes two decimals and no more — `num` rounds to
; hundredths — so a coordinate multiplied by 100 and rounded is not an
; approximation of what the JSON carried, it is exactly it. The two bridges
; therefore describe the same picture to the last unit, which is what lets a
; test compare them field by field.
;
; WHY THE STRINGS ARE STILL STRINGS. There are 203 text runs and 1 158
; characters in that same frame, against 88 656 coordinates. Text is a
; rounding error in this payload; packing it into the array would cost more in
; complexity than it saves in time, so a command carries an INDEX into a small
; pool and the pool crosses as an array of strings.
class EVGSceneBinary {
    ; One fixed-size record per command; see `EVGDisplayList.STRIDE`.
    def cmds:int_buffer (int_buffer_alloc 0)
    ; Every ring's coordinates, in hundredths, one command's after another's.
    def pts:int_buffer (int_buffer_alloc 0)
    ; Where each command's rings stop, in the same order.
    def ends:int_buffer (int_buffer_alloc 0)
    ; The text, font, weight and image names a command names by index.
    def strings:[string]
    def count:int 0
    def width:double 0.0
    def height:double 0.0

    Constructor () {
        def s:[string]
        strings = s
    }
}

class EVGDisplayList {
    def cmds:[EVGDrawCmd]
    ; Overlay surfaces met during the first pass, drawn by the second. See
    ; `build`.
    def deferredOverlays:[EVGElement]
    ; The same engine layout measured with. A paragraph is emitted one command
    ; per LINE, broken exactly where layout broke it — a backend that got the
    ; whole string would draw one long run straight out of its box, which is
    ; the disagreement between measure and paint this engine exists to avoid.
    def textEngine:EVGTextEngine (new EVGTextEngine())

    Constructor () {
    }

    fn setTextEngine:void (e:EVGTextEngine) {
        textEngine = e
    }

    fn count:int () {
        return (array_length cmds)
    }

    fn at:EVGDrawCmd (i:int) {
        return (itemAt cmds i)
    }

    ; ------------------------------------------------------------ primitives --
    ; Every component that draws into a display list needs the same four
    ; commands, and each one that encoded them for itself encoded them slightly
    ; differently. They live here, where `cmds` does, so a dialog, a grid and a
    ; chart put the same bytes in the list.
    fn addRect:void (x:double y:double w:double h:double col:EVGColor) {
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 0
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push cmds c
    }

    fn addFrame:void (x:double y:double w:double h:double thickness:double col:EVGColor) {
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 1
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.thickness = thickness
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push cmds c
    }

    ; The measured width and height come from the caller, because the list has
    ; no text renderer of its own and the measurement must be the one the
    ; caller laid out with.
    ; A textured quad. `src` names the picture rather than carrying it: every
    ; backend here already resolves a name to a texture — the browser host
    ; keys a blob URL by it, the PDF renderer opens the file — and two format
    ; readers now emit one, which is why this moved out of `PptxToEvg` and
    ; into the layer both of them draw through.
    fn addImage:void (src:string x:double y:double w:double h:double flipH:boolean flipV:boolean rotate:double) {
        if ((strlen src) == 0) {
            return
        }
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 2
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        c.src = src
        c.a = 1.0
        c.flipH = flipH
        c.flipV = flipV
        c.rotate = rotate
        push cmds c
    }

    fn addText:void (text:string x:double y:double size:double col:EVGColor family:string bold:boolean italic:boolean width:double height:double) {
        if ((strlen text) == 0) {
            return
        }
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 3
        c.x = x
        c.y = y
        c.w = width
        c.h = height
        c.text = text
        c.fontFamily = family
        c.fontSize = size
        if bold {
            c.fontWeight = "bold"
        }
        if italic {
            c.textAlign = "italic"
        }
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        push cmds c
    }

    ; One side's contribution to the box-wide scale factor: the smaller of what
    ; we have and this side's length over the two radii that share it. A side
    ; whose radii are zero contributes nothing, which is why the guard is on
    ; the SUM and not on the side.
    ; A radius in pixels, re-resolving a percentage against the box's OWN size.
    ; `already` is what the box worked out from its parent, which is right for
    ; every unit but a percentage.
    sfn radiusPx:double (isPct:boolean pct:double already:double own:double) {
        if isPct {
            return ((pct / 100.0) * own)
        }
        return already
    }

    sfn sideFactor:double (soFar:double side:double sum:double) {
        if (sum <= 0.0) {
            return soFar
        }
        def f:double (side / sum)
        if (f < soFar) {
            return f
        }
        return soFar
    }

    fn addClip:void (x:double y:double w:double h:double) {
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 4
        c.x = x
        c.y = y
        c.w = w
        c.h = h
        push cmds c
    }

    ; A stroked polyline and a filled polygon, given in page coordinates.
    ; The SVG walk below already emits kind 6/7 commands, but only from a
    ; parsed `<path>`: anything that computes its own geometry — a chart line,
    ; a graph edge — had no way to say so, and each such caller either
    ; approximated the curve with thin rects or drew nothing on the GPU. The
    ; points are already flattened, which is the contract kind 6/7 carry.
    fn addPolyline:void (pts:[double] thickness:double col:EVGColor) {
        if ((array_length pts) < 4) {
            return
        }
        def c (new EVGDrawCmd())
        c.kind = 7
        c.thickness = thickness
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        def i:int 0
        while (i < (array_length pts)) {
            push c.pts (itemAt pts i)
            i = (i + 1)
        }
        push c.ringEnds (array_length c.pts)
        this.setPolyBounds(c)
        push cmds c
    }

    ; A filled shape made of SEVERAL rings, with holes.
    ;
    ; `addPolygon` takes one ring, so a caller with an outline — a magnifier's
    ; glass, a letter O, any shape drawn as outer-boundary-then-inner — had to
    ; call it once per ring, and each call fills independently. The hole comes
    ; out solid. `EVGDrawCmd` has carried `ringEnds` and `evenOdd` all along
    ; for the SVG walk to use; this is the same thing for anyone who computes
    ; rings themselves.
    ;
    ; `rings` is a list of flattened point arrays, already in page coordinates.
    fn addPolyRings:void (rings:[PathRing] col:EVGColor evenOddFill:boolean) {
        if ((array_length rings) == 0) {
            return
        }
        def c (new EVGDrawCmd())
        c.kind = 6
        c.evenOdd = evenOddFill
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        def i:int 0
        while (i < (array_length rings)) {
            def ring:PathRing (itemAt rings i)
            def j:int 0
            while (j < (array_length ring.pts)) {
                push c.pts (itemAt ring.pts j)
                j = (j + 1)
            }
            push c.ringEnds (array_length c.pts)
            i = (i + 1)
        }
        if ((array_length c.pts) < 6) {
            return
        }
        this.setPolyBounds(c)
        push cmds c
    }

    fn addPolygon:void (pts:[double] col:EVGColor) {
        if ((array_length pts) < 6) {
            return
        }
        def c (new EVGDrawCmd())
        c.kind = 6
        c.r = (col.red())
        c.g = (col.green())
        c.b = (col.blue())
        c.a = (col.alpha())
        def i:int 0
        while (i < (array_length pts)) {
            push c.pts (itemAt pts i)
            i = (i + 1)
        }
        push c.ringEnds (array_length c.pts)
        this.setPolyBounds(c)
        push cmds c
    }

    ; A path command still carries a box, because the GL backend scissors and
    ; batches by it. Derived from the points rather than left at zero, which
    ; clipped every computed path to a 0x0 rectangle.
    fn setPolyBounds:void (c:EVGDrawCmd) {
        def minX:double 0.0
        def minY:double 0.0
        def maxX:double 0.0
        def maxY:double 0.0
        def n:int (idiv (array_length c.pts) 2)
        def i:int 0
        while (i < n) {
            def x:double (itemAt c.pts (i * 2))
            def yat:int ((i * 2) + 1)
            def y:double (itemAt c.pts yat)
            if (i == 0) {
                minX = x
                maxX = x
                minY = y
                maxY = y
            } {
                if (x < minX) { minX = x }
                if (x > maxX) { maxX = x }
                if (y < minY) { minY = y }
                if (y > maxY) { maxY = y }
            }
            i = (i + 1)
        }
        c.x = minX
        c.y = minY
        c.w = (maxX - minX)
        c.h = (maxY - minY)
    }

    fn addClipEnd:void () {
        def c:EVGDrawCmd (new EVGDrawCmd)
        c.kind = 5
        push cmds c
    }


    ; A `<path>` element, flattened into rings and pushed as a fill and/or a
    ; stroke. The transform is the one the raster and PDF targets build: the
    ; viewBox mapping, then the element's position — so the points come out in
    ; page coordinates and a backend can draw them as they are.
    ; An imported SVG document (PLAN_VECTOR_IR.md Stage 4). Without this a
    ; <Svg> would simply be absent from a GL backend while appearing in the
    ; other three, which is the class of divergence this file exists to stop —
    ; the same reason border-radius once worked in PDF and silently not in PNG.
    ;
    ; The importer has already resolved paint and baked group transforms, so
    ; this is the single-path walk with the per-shape paint coming from the item
    ; rather than from the element.
    fn walkSvgDocument:void (el:EVGElement x:double y:double w:double h:double) {
        def sp (new SvgParser())
        if el.fillColor.isSet {
            sp.setInitialFill((unwrap el.fillColor))
        }
        def doc:SvgDocument (sp.parse(el.svgSource))
        if ((doc.itemCount()) == 0) {
            return
        }

        def vb:ViewBoxRect (doc.effectiveViewBox())
        def m:Matrix2D (VectorViewBox.resolve(vb w h "xMidYMid meet"))
        def steps:int (this.flattenSteps(w h))
        def scale:double m.a
        if (scale < 0.0) {
            scale = (0.0 - scale)
        }
        if (scale <= 0.0) {
            scale = 1.0
        }

        def k:int 0
        while (k < (doc.itemCount())) {
            def item:SvgVectorItem (itemAt doc.items k)
            def parser:SVGPathParser (SVGPathParser.fromCommands(item.commands))
            def rings:[PathRing] (parser.flattenRings(steps m.a m.b m.c m.d (m.e + x) (m.f + y)))
            if ((array_length rings) > 0) {
                if (item.hasFill()) {
                    def cf (new EVGDrawCmd())
                    cf.kind = 6
                    cf.x = x
                    cf.y = y
                    cf.w = w
                    cf.h = h
                    cf.evenOdd = (item.fillRule == "evenodd")
                    cf.r = (item.fillColor.red())
                    cf.g = (item.fillColor.green())
                    cf.b = (item.fillColor.blue())
                    cf.a = (item.fillColor.alpha())
                    this.copyRings(cf rings)
                    push cmds cf
                }
                if (item.hasStroke()) {
                    def cs (new EVGDrawCmd())
                    cs.kind = 7
                    cs.x = x
                    cs.y = y
                    cs.w = w
                    cs.h = h
                    cs.thickness = (item.strokeWidth * scale)
                    cs.r = (item.strokeColor.red())
                    cs.g = (item.strokeColor.green())
                    cs.b = (item.strokeColor.blue())
                    cs.a = (item.strokeColor.alpha())
                    this.copyRings(cs rings)
                    push cmds cs
                }
            }
            k = (k + 1)
        }
    }

    ; Subdivision chosen from the size it is drawn at, as every other target
    ; does: a large shape must not show facets, a small one must not pay for
    ; detail no pixel can show.
    fn flattenSteps:int (w:double h:double) {
        def span:double w
        if (h > span) {
            span = h
        }
        def steps:int (to_int (span / 6.0))
        if (steps < 4) {
            steps = 4
        }
        if (steps > 48) {
            steps = 48
        }
        return steps
    }

    fn walkPath:void (el:EVGElement x:double y:double w:double h:double) {
        if ((strlen el.svgSource) > 0) {
            this.walkSvgDocument(el x y w h)
            return
        }

        def pathData:string el.svgPath
        if ((strlen pathData) == 0) {
            return
        }
        def parser (new SVGPathParser())
        parser.parse(pathData)

        def b:PathBounds (parser.getBounds())
        def vb:ViewBoxRect (VectorViewBox.effectiveViewBox(el.viewBox b.minX b.minY b.width b.height))
        def m:Matrix2D (VectorViewBox.resolve(vb w h "xMidYMid meet"))

        def steps:int (this.flattenSteps(w h))

        def rings:[PathRing] (parser.flattenRings(steps m.a m.b m.c m.d (m.e + x) (m.f + y)))
        if ((array_length rings) == 0) {
            return
        }

        def fillColor:EVGColor el.fillColor
        if (fillColor.isSet == false) {
            fillColor = el.backgroundColor
        }
        if fillColor.isSet {
            def cf (new EVGDrawCmd())
            cf.kind = 6
            cf.x = x
            cf.y = y
            cf.w = w
            cf.h = h
            cf.evenOdd = (el.fillRule == "evenodd")
            cf.r = (fillColor.red())
            cf.g = (fillColor.green())
            cf.b = (fillColor.blue())
            cf.a = (fillColor.alpha())
            this.copyRings(cf rings)
            push cmds cf
        }

        if el.strokeColor.isSet {
            if (el.strokeWidth > 0.0) {
                def sc:EVGColor el.strokeColor
                def cs (new EVGDrawCmd())
                cs.kind = 7
                cs.x = x
                cs.y = y
                cs.w = w
                cs.h = h
                ; stroke-width is in user units, so it scales with the geometry.
                def scale:double m.a
                if (scale < 0.0) {
                    scale = (0.0 - scale)
                }
                if (scale <= 0.0) {
                    scale = 1.0
                }
                cs.thickness = (el.strokeWidth * scale)
                cs.r = (sc.red())
                cs.g = (sc.green())
                cs.b = (sc.blue())
                cs.a = (sc.alpha())
                this.copyRings(cs rings)
                push cmds cs
            }
        }
    }

    fn copyRings:void (c:EVGDrawCmd rings:[PathRing]) {
        def i:int 0
        while (i < (array_length rings)) {
            def ring:PathRing (itemAt rings i)
            def k:int 0
            while (k < (array_length ring.pts)) {
                push c.pts (itemAt ring.pts k)
                k = (k + 1)
            }
            push c.ringEnds (array_length c.pts)
            i = (i + 1)
        }
    }

    ; Walk a LAID-OUT tree. Call after EVGLayout.layout(root).
    ;
    ; Two passes, because an overlay surface has to be drawn ABOVE the page and
    ; not merely later in the tree. The first pass draws everything that is in
    ; flow and puts each surface it meets aside; the second draws those, in the
    ; order they were reached. A surface met INSIDE a surface is appended while
    ; that loop is running, so a submenu lands after the menu that opened it.
    ;
    ; That order is a STACK — the order things opened in — not a z-index. There
    ; is no number to get wrong and nothing for two components to disagree
    ; about, and `EVGHitTest` builds the same list so that what is clicked is
    ; what is seen.
    ;
    ; Deferring is also what takes a surface out of an ancestor's clip: the
    ; second pass runs after the clip was popped, which is what a dropdown
    ; inside a scrolling panel needs and what `overflow: hidden` would
    ; otherwise forbid.
    fn build:void (root:EVGElement) {
        clear cmds
        clear deferredOverlays
        effectKind = ""
        def noX:[double]
        def noY:[double]
        def noT:[double]
        effectXs = noX
        effectYs = noY
        effectAges = noT
        this.readEffect(root)
        this.walk(root)
        def i:int 0
        while (i < (array_length deferredOverlays)) {
            this.walk((itemAt deferredOverlays i))
            i = (i + 1)
        }
    }

    ; Apply `opacity` to everything this element and its subtree just emitted.
    ;
    ; The attribute has been in SPEC.md and on EVGElement all along, and
    ; rangerflow's fade highlighter and book's slabs already set it — but
    ; nothing ever read it, so every one of them painted at full strength. It
    ; belongs here rather than in each painter: the display list is numbers, so
    ; scaling the alpha once means WebGL, SDL, SoftCanvas, PDF and HTML all get
    ; it without knowing the attribute exists.
    ;
    ; This scales each command's alpha rather than compositing the subtree
    ; offscreen the way CSS `opacity` does. The difference shows only where two
    ; faded children OVERLAP — there they blend with each other instead of as
    ; one group. A display list cannot express the group form without a layer,
    ; and this is the approximation every immediate-mode renderer makes.
    fn fadeFrom:void (start:int factor:double) {
        if (factor >= 1.0) {
            return
        }
        def i:int start
        while (i < (array_length cmds)) {
            def c:EVGDrawCmd (itemAt cmds i)
            c.a = (c.a * factor)
            i = (i + 1)
        }
    }

    ; A `transform` applied to everything this element and its children drew.
    ;
    ; The same shape as `fadeFrom` and for the same reason: a transform is a
    ; property of a SUBTREE, and the display list has already flattened the
    ; subtree by the time it is known what was in it. Recording where the
    ; element's output began and rewriting that range afterwards is how both are
    ; expressed without a transform stack in every backend. Nested transforms
    ; compose because an outer element's range covers the inner one's output and
    ; is rewritten after it.
    ;
    ; It is a similarity — rotation, uniform scale, translation — so each
    ; command survives as a command rather than needing a matrix in the wire
    ; format. Two different treatments, for two different kinds of command:
    ;
    ;   a box (rect, border, image, text) keeps its axis-aligned rectangle,
    ;   moved and resized, and carries the ANGLE with the origin it turns
    ;   about. The painter does the turning.
    ;
    ;   a path is turned in its GEOMETRY, here, because its shape does not live
    ;   in `x/y/w/h` and no backend's quad rotation would reach it. That is the
    ;   same choice `PathBuilder.rotateAbout` already makes, and it means SVG,
    ;   PDF and raster all draw a turned icon without knowing what a transform
    ;   is.
    fn transformFrom:void (start:int el:EVGElement) {
        def deg:double el.rotate
        def sc:double el.scale
        def tx:double el.translateX
        def ty:double el.translateY
        def turns:boolean (deg != 0.0)
        def scales:boolean ((fabs (sc - 1.0)) > 0.000001)
        def shifts:boolean ((tx != 0.0) || (ty != 0.0))
        if (((turns == false) && (scales == false)) && (shifts == false)) {
            return
        }
        ; What it turns about. `transform-origin` decides, and its default is
        ; 50% 50% — the element's own centre. Measured against a browser rather
        ; than assumed: a 100x40 box given a quarter turn about the default
        ; comes back with its centre exactly where it started.
        ;
        ; Resolved HERE and not earlier, because a percentage needs the laid-out
        ; box and this is the first place that exists.
        def ox:double (el.calculatedX + (EVGElement.resolveOrigin(el.transformOriginX el.calculatedWidth)))
        def oy:double (el.calculatedY + (EVGElement.resolveOrigin(el.transformOriginY el.calculatedHeight)))
        def rad:double ((deg * 3.14159265358979) / 180.0)
        def cs:double (cos rad)
        def sn:double (sin rad)
        def i:int start
        def n:int (array_length cmds)
        while (i < n) {
            def c:EVGDrawCmd (itemAt cmds i)
            if ((array_length c.pts) > 0) {
                this.mapPoints(c ox oy sc cs sn tx ty)
            } {
                if scales {
                    c.x = (ox + ((c.x - ox) * sc))
                    c.y = (oy + ((c.y - oy) * sc))
                    c.w = (c.w * sc)
                    c.h = (c.h * sc)
                    c.radius = (c.radius * sc)
                    c.thickness = (c.thickness * sc)
                    ; Type scales with the box. A button that grows on hover
                    ; and keeps its old type size looks like a rendering fault.
                    c.fontSize = (c.fontSize * sc)
                }
                if turns {
                    ; A command already carrying its own rotation — a sideways
                    ; axis label inside a turned panel — adds the two angles and
                    ; has its pivot carried round by the outer one. Its own
                    ; centre stops being the pivot, which is right: it is being
                    ; carried, not spun in place.
                    c.rotate = (c.rotate + deg)
                    if (c.hasRotOrigin == false) {
                        c.rotOriginX = ox
                        c.rotOriginY = oy
                        c.hasRotOrigin = true
                    } {
                        def rx:double (c.rotOriginX - ox)
                        def ry:double (c.rotOriginY - oy)
                        c.rotOriginX = (ox + ((rx * cs) - (ry * sn)))
                        c.rotOriginY = (oy + ((rx * sn) + (ry * cs)))
                    }
                }
                if shifts {
                    c.x = (c.x + tx)
                    c.y = (c.y + ty)
                    if c.hasRotOrigin {
                        c.rotOriginX = (c.rotOriginX + tx)
                        c.rotOriginY = (c.rotOriginY + ty)
                    }
                }
            }
            i = (i + 1)
        }
    }

    ; The whole similarity applied to a path's points. Rebuilt rather than
    ; written in place: the array has no element assignment, and a fresh list
    ; pushed back is clearer than an index dance anyway.
    fn mapPoints:void (c:EVGDrawCmd ox:double oy:double sc:double cs:double sn:double tx:double ty:double) {
        def moved:[double]
        def i:int 0
        def n:int (array_length c.pts)
        while ((i + 1) < n) {
            def px:double ((itemAt c.pts i) - ox)
            def py:double ((itemAt c.pts (i + 1)) - oy)
            def sx:double (px * sc)
            def sy:double (py * sc)
            push moved (((ox + ((sx * cs) - (sy * sn))) + tx))
            push moved (((oy + ((sx * sn) + (sy * cs))) + ty))
            i = (i + 2)
        }
        clear c.pts
        def j:int 0
        while (j < (array_length moved)) {
            push c.pts (itemAt moved j)
            j = (j + 1)
        }
    }

    fn walk:void (el:EVGElement) {
        ; Where this element's own output begins, so `opacity` can scale
        ; exactly what it and its children add — nested fades then multiply as
        ; the recursion unwinds. A transform uses the same range.
        def emitStart:int (array_length cmds)
        this.walkOpaque(el)
        this.fadeFrom(emitStart el.opacity)
        this.transformFrom(emitStart el)
    }

    fn walkOpaque:void (el:EVGElement) {
        def x:double el.calculatedX
        def y:double el.calculatedY
        def w:double el.calculatedWidth
        def h:double el.calculatedHeight

        def radius:double el.box.borderRadiusPx
        ; THE FOUR CORNERS, and the scale-down that makes them legal.
        ;
        ; CSS: if two radii on one side add up to more than that side, EVERY
        ; radius on the box is multiplied by the same factor — the smallest
        ; ratio over the four sides. Per-corner clamping is the classic wrong
        ; answer and it comes out lopsided. Measured: 80px corners on a 100x40
        ; box are drawn at 40, a factor of 0.5 applied to all four, and 60/20
        ; on a 50x200 box become 37.5 and 12.5.
        ;
        ; It is done here and not in the box because it needs the DRAWN width
        ; and height, which nothing knows until the layout has finished.
        ; A PERCENTAGE IS AGAINST THIS BOX, not its parent. The box resolves
        ; units when only the parent's dimensions are known, so it had nothing
        ; else to use — `border-radius: 50%` on a 200x100 box inside a
        ; 800x600 page came out 300, which the shader then clamped to 50 and
        ; the PDF and raster backends did not. Re-resolved here against `w`,
        ; where the box's own width is finally a number. Circular corners, so
        ; one base: the browser would make an ellipse of it, and that is
        ; recorded as a divergence rather than approximated.
        def bx:EVGBox el.box
        def uTL:EVGUnit bx.borderRadiusTL
        def uTR:EVGUnit bx.borderRadiusTR
        def uBR:EVGUnit bx.borderRadiusBR
        def uBL:EVGUnit bx.borderRadiusBL
        def uAll:EVGUnit bx.borderRadius
        def rTL:double (EVGDisplayList.radiusPx((uTL.isSet && (uTL.isPercent())) uTL.value bx.borderRadiusTLPx w))
        def rTR:double (EVGDisplayList.radiusPx((uTR.isSet && (uTR.isPercent())) uTR.value bx.borderRadiusTRPx w))
        def rBR:double (EVGDisplayList.radiusPx((uBR.isSet && (uBR.isPercent())) uBR.value bx.borderRadiusBRPx w))
        def rBL:double (EVGDisplayList.radiusPx((uBL.isSet && (uBL.isPercent())) uBL.value bx.borderRadiusBLPx w))
        if ((bx.hasPerCornerRadius()) == false) {
            def uni:double (EVGDisplayList.radiusPx((uAll.isSet && (uAll.isPercent())) uAll.value bx.borderRadiusPx w))
            rTL = uni
            rTR = uni
            rBR = uni
            rBL = uni
        }
        def f:double 1.0
        f = (EVGDisplayList.sideFactor(f w (rTL + rTR)))
        f = (EVGDisplayList.sideFactor(f h (rTR + rBR)))
        f = (EVGDisplayList.sideFactor(f w (rBL + rBR)))
        f = (EVGDisplayList.sideFactor(f h (rTL + rBL)))
        if (f < 1.0) {
            rTL = (rTL * f)
            rTR = (rTR * f)
            rBR = (rBR * f)
            rBL = (rBL * f)
        }
        ; And the single number every other backend reads is the SCALED one.
        ; It used to be the authored value: an 80-pixel radius on a 100-pixel
        ; box went out as 80, and only the WebGL shader's own clamp made it
        ; look right — PDF and the rasteriser drew what they were told.
        radius = rTL
        def perCorner:boolean (el.box.hasPerCornerRadius())

        ; Background
        ;
        ; `painted` guards the case below it: an element carrying only a
        ; `backdrop-filter` and no background of its own still has to emit a
        ; rectangle, because the filter is the thing being drawn. CSS applies
        ; `backdrop-filter` whether or not there is a background — a scrim that
        ; softens the page and tints it not at all is an ordinary thing to want
        ; — and gating the emit on a colour dropped that case entirely.
        def painted:boolean false
        if el.backgroundColor {
            def bg:EVGColor (unwrap el.backgroundColor)
            if bg.isSet {
                def c (new EVGDrawCmd())
                c.kind = 0
                c.x = x
                c.y = y
                c.w = w
                c.h = h
                c.radius = radius
                c.perCorner = perCorner
                if perCorner {
                    c.radius = rTL
                    c.radiusTR = rTR
                    c.radiusBR = rBR
                    c.radiusBL = rBL
                }
                c.r = (bg.red())
                c.g = (bg.green())
                c.b = (bg.blue())
                c.a = (bg.alpha())
                c.backdropBlur = el.backdropBlur
                push cmds c
                painted = true
            }
        }
        if (painted == false) {
            if (el.backdropBlur > 0.0) {
                def cb (new EVGDrawCmd())
                cb.kind = 0
                cb.x = x
                cb.y = y
                cb.w = w
                cb.h = h
                cb.radius = radius
                cb.perCorner = perCorner
                if perCorner {
                    cb.radius = rTL
                    cb.radiusTR = rTR
                    cb.radiusBR = rBR
                    cb.radiusBL = rBL
                }
                ; Fully transparent: the rectangle exists to carry the filter,
                ; and a backend that cannot filter draws nothing, which is
                ; exactly right.
                cb.a = 0.0
                cb.backdropBlur = el.backdropBlur
                push cmds cb
            }
        }

        ; Border. Read through the element's own accessor rather than a field
        ; picked by hand: a CSS-declared border lands on `box`, an inline
        ; camelCase one on the element, and this walk used to read one of each
        ; — a width from the box and a colour from the element — so a
        ; stylesheet border was silently dropped from every GPU backend.
        def bw:double (el.effectiveBorderWidthPx())
        if (bw > 0.0) {
            def bc:EVGColor (el.effectiveBorderColor())
            def c2 (new EVGDrawCmd())
            c2.kind = 1
            c2.x = x
            c2.y = y
            c2.w = w
            c2.h = h
            c2.radius = radius
            c2.perCorner = perCorner
            if perCorner {
                c2.radius = rTL
                c2.radiusTR = rTR
                c2.radiusBR = rBR
                c2.radiusBL = rBL
            }
            c2.thickness = bw
            c2.r = (bc.red())
            c2.g = (bc.green())
            c2.b = (bc.blue())
            c2.a = (bc.alpha())
            push cmds c2
        }


        ; Vector paths. Flattened here, in page coordinates, because this is
        ; where the drawn size is known — a GPU backend gets rings of points
        ; and needs no path parser and no viewBox arithmetic of its own.
        if (el.tagName == "path") {
            this.walkPath(el x y w h)
        }
        ; Image
        if ((strlen el.src) > 0) {
            def c3 (new EVGDrawCmd())
            c3.kind = 2
            c3.x = x
            c3.y = y
            c3.w = w
            c3.h = h
            c3.radius = radius
            c3.perCorner = perCorner
            if perCorner {
                c3.radius = rTL
                c3.radiusTR = rTR
                c3.radiusBR = rBR
                c3.radiusBL = rBL
            }
            c3.src = el.src
            push cmds c3
        }

        ; Text. One command per element; a backend that shapes lines itself can
        ; re-break, and one that does not can ask EVGTextEngine for the same
        ; lines layout used.
        if ((strlen el.textContent) > 0) {
            def face:string (el.effectiveFontFamily())
            def fs:double el.inheritedFontSize
            if el.fontSize.isSet {
                fs = el.fontSize.pixels
            }
            if (fs <= 0.0) {
                fs = 14.0
            }
            ; The same rule the layout reserved the space by, so the line the
            ; painter draws lands where the box was sized for it. Zero means
            ; `normal`, which is the FACE's line box and not 1.2.
            def lh:double el.lineHeight
            if (lh <= 0.0) {
                lh = ((textEngine.lineHeightFor(face fs)) / fs)
            }
            if (lh <= 0.0) {
                lh = 1.2
            }
            def avail:double (el.box.getInnerWidth(w))
            def lines:[string] (textEngine.breakToStrings(el.textContent face fs avail))
            def tr:int 0
            def tg:int 0
            def tb:int 0
            def ta:double 1.0
            if el.color {
                def tc:EVGColor (unwrap el.color)
                tr = (tc.red())
                tg = (tc.green())
                tb = (tc.blue())
                ta = (tc.alpha())
            }
            def li:int 0
            while (li < (array_length lines)) {
                def c4 (new EVGDrawCmd())
                c4.kind = 3
                ; `text-align`, which until now was parsed by EVGElement and
                ; read by absolutely nothing — a documented attribute that did
                ; not exist, which costs an afternoon every time someone
                ; believes it.
                ;
                ; The offset is measured, not guessed: the painter draws a run
                ; at c.x and sizes the quad to the ink, so centring means
                ; asking the same engine that broke the line how wide the line
                ; came out and moving the start by the slack.
                def indent:double 0.0
                if ((el.textAlign == "center") || (el.textAlign == "right")) {
                    def m:EVGTextMetrics (textEngine.measureRun((itemAt lines li) face fs))
                    def slack:double (avail - m.width)
                    if (slack > 0.0) {
                        if (el.textAlign == "center") {
                            indent = (slack / 2.0)
                        } {
                            indent = slack
                        }
                    }
                }
                c4.x = ((x + el.box.paddingLeftPx) + indent)
                c4.y = ((y + el.box.paddingTopPx) + ((to_double li) * (fs * lh)))
                c4.w = avail
                c4.h = (fs * lh)
                c4.text = (itemAt lines li)
                c4.fontFamily = face
                c4.fontSize = fs
                c4.r = tr
                c4.g = tg
                c4.b = tb
                c4.a = ta
                push cmds c4
                li = (li + 1)
            }
        }

        ; Children, clipped when the element says so. EVERY overflow value but
        ; `visible` clips — this used to name `hidden` alone, which meant a
        ; scroll container drew its content straight over whatever was beside
        ; it, and the one thing a scrolling box has to do is stay inside itself.
        def clips:boolean (el.clipsContent())
        if clips {
            def cp (new EVGDrawCmd())
            cp.kind = 4
            cp.x = x
            cp.y = y
            cp.w = w
            cp.h = h
            push cmds cp
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            def kid:EVGElement (el.getChild(i))
            ; A surface is not drawn here. `build` comes back to it once the
            ; whole normal tree is down — see the note there.
            if kid.isOverlay {
                push deferredOverlays kid
            } {
                this.walk(kid)
            }
            i = (i + 1)
        }
        if clips {
            def pp (new EVGDrawCmd())
            pp.kind = 5
            push cmds pp
        }
    }

    ; Serialize to JSON — the wire format between the engine and a backend.
    ;
    ; One flat array of commands. A backend needs no Ranger runtime to consume
    ; it, which is what lets the WebGL renderer be plain JavaScript while the
    ; SDL2 one is the same list decoded in C++.
    ; How many ints one command occupies. Fixed, so a reader indexes rather
    ; than walks: command `i` starts at `i * stride()`. Read it through this
    ; function and never inline the number — it has changed once already, when
    ; a rotation needed an origin to turn about.
    ;
    ; That instruction was there and a reader across the bridge had inlined it
    ; anyway. The record went 24 -> 26, `pptx-host.mjs` went on multiplying by
    ; 24, and from the second command on every field was read two ints early —
    ; colours as coordinates, coordinates as flags — until a ring count taken
    ; out of somebody's colour reached `new Array(n)`. So a comment is not the
    ; mechanism: `sceneStride()` on the decoding side now DERIVES this by
    ; dividing the buffer by the command count, which is exact because the
    ; buffer is allocated as count * stride here, and it is checked against the
    ; JSON path for every fixture by `pptx/web/host/scene-binary-check.mjs`.
    ; Growing this number is safe; a reader that wants the new fields opts in.
    sfn stride:int () {
        return 27
    }

    ; A value in hundredths, which is the precision `num` writes and therefore
    ; the precision the JSON bridge has always carried.
    sfn fixed:int (v:double) {
        if (v < 0.0) {
            return (0 - (to_int (((0.0 - v) * 100.0) + 0.5)))
        }
        return (to_int ((v * 100.0) + 0.5))
    }

    ; Three channels in one int, because a colour is three bytes and an
    ; Int32Array holds four.
    sfn packRgb:int (r:int g:int b:int) {
        return (((r * 65536) + (g * 256)) + b)
    }

    ; The display list as typed arrays. See the banner on `EVGSceneBinary`.
    fn toBinary:EVGSceneBinary () {
        def out (new EVGSceneBinary())
        def n:int (array_length cmds)
        out.count = n
        def stride:int (EVGDisplayList.stride())
        def totalPts:int 0
        def totalEnds:int 0
        def i:int 0
        while (i < n) {
            def c:EVGDrawCmd (itemAt cmds i)
            def pc:int (array_length c.pts)
            totalPts = (totalPts + pc)
            if (pc > 0) {
                def ec:int (array_length c.ringEnds)
                if (ec == 0) {
                    ; One ring covering everything, which is what a command
                    ; that set `pts` and no `ringEnds` means — the same rule
                    ; `toJson` applies, and for the same reason.
                    totalEnds = (totalEnds + 1)
                } {
                    totalEnds = (totalEnds + ec)
                }
            }
            i = (i + 1)
        }
        def recs:int_buffer (int_buffer_alloc (n * stride))
        def pbuf:int_buffer (int_buffer_alloc totalPts)
        def ebuf:int_buffer (int_buffer_alloc totalEnds)
        def pool:[string]
        def poolIndex:[string:int]
        def pAt:int 0
        def eAt:int 0
        def k:int 0
        while (k < n) {
            def c2:EVGDrawCmd (itemAt cmds k)
            def base:int (k * stride)
            int_buffer_set recs base c2.kind
            int_buffer_set recs (base + 1) (EVGDisplayList.fixed(c2.x))
            int_buffer_set recs (base + 2) (EVGDisplayList.fixed(c2.y))
            int_buffer_set recs (base + 3) (EVGDisplayList.fixed(c2.w))
            int_buffer_set recs (base + 4) (EVGDisplayList.fixed(c2.h))
            int_buffer_set recs (base + 5) (EVGDisplayList.fixed(c2.radius))
            int_buffer_set recs (base + 6) (EVGDisplayList.fixed(c2.thickness))
            int_buffer_set recs (base + 7) (EVGDisplayList.packRgb(c2.r c2.g c2.b))
            int_buffer_set recs (base + 8) (EVGDisplayList.fixed(c2.a))
            def flags:int 0
            if c2.hasGrad {
                flags = (flags + 1)
            }
            if (c2.textAlign == "italic") {
                flags = (flags + 2)
            }
            if c2.flipH {
                flags = (flags + 4)
            }
            if c2.flipV {
                flags = (flags + 8)
            }
            if c2.evenOdd {
                flags = (flags + 16)
            }
            ; Whether slots 24 and 25 mean anything. A zero origin is a legal
            ; place to turn about, so the flag cannot be inferred from the
            ; numbers being zero.
            if c2.hasRotOrigin {
                flags = (flags + 32)
            }
            int_buffer_set recs (base + 9) flags
            int_buffer_set recs (base + 10) c2.gradDir
            int_buffer_set recs (base + 11) (EVGDisplayList.packRgb(c2.r2 c2.g2 c2.b2))
            int_buffer_set recs (base + 12) (EVGDisplayList.fixed(c2.a2))
            int_buffer_set recs (base + 13) (EVGDisplayList.fixed(c2.fontSize))
            int_buffer_set recs (base + 14) (EVGDisplayList.fixed(c2.rotate))
            int_buffer_set recs (base + 24) (EVGDisplayList.fixed(c2.rotOriginX))
            int_buffer_set recs (base + 25) (EVGDisplayList.fixed(c2.rotOriginY))
            ; No flag beside it: zero is "no filter", which is a value a blur
            ; radius cannot otherwise take. Contrast slot 24/25, where zero is
            ; a legal place to turn about and the flag is the only way to tell.
            int_buffer_set recs (base + 26) (EVGDisplayList.fixed(c2.backdropBlur))
            ; A command with no text names none of the three text strings, and
            ; `toJson` writes none of them either — so the reader must be able
            ; to tell "no text" from "empty text", which -1 says and 0 would
            ; not.
            def textIdx:int (0 - 1)
            def fontIdx:int (0 - 1)
            def weightIdx:int (0 - 1)
            if ((strlen c2.text) > 0) {
                textIdx = (EVGDisplayList.intern(pool poolIndex c2.text))
                fontIdx = (EVGDisplayList.intern(pool poolIndex c2.fontFamily))
                if ((strlen c2.fontWeight) > 0) {
                    weightIdx = (EVGDisplayList.intern(pool poolIndex c2.fontWeight))
                }
            }
            int_buffer_set recs (base + 15) textIdx
            int_buffer_set recs (base + 16) fontIdx
            int_buffer_set recs (base + 17) weightIdx
            def srcIdx:int (0 - 1)
            if ((strlen c2.src) > 0) {
                srcIdx = (EVGDisplayList.intern(pool poolIndex c2.src))
            }
            int_buffer_set recs (base + 18) srcIdx
            def pc2:int (array_length c2.pts)
            int_buffer_set recs (base + 19) pAt
            int_buffer_set recs (base + 20) pc2
            def eStart:int eAt
            if (pc2 > 0) {
                def pi:int 0
                while (pi < pc2) {
                    int_buffer_set pbuf (pAt + pi) (EVGDisplayList.fixed((itemAt c2.pts pi)))
                    pi = (pi + 1)
                }
                pAt = (pAt + pc2)
                def ec2:int (array_length c2.ringEnds)
                if (ec2 == 0) {
                    int_buffer_set ebuf eAt pc2
                    eAt = (eAt + 1)
                } {
                    def ei:int 0
                    while (ei < ec2) {
                        int_buffer_set ebuf (eAt + ei) (itemAt c2.ringEnds ei)
                        ei = (ei + 1)
                    }
                    eAt = (eAt + ec2)
                }
            }
            int_buffer_set recs (base + 21) eStart
            int_buffer_set recs (base + 22) (eAt - eStart)
            k = (k + 1)
        }
        out.cmds = recs
        out.pts = pbuf
        out.ends = ebuf
        out.strings = pool
        return out
    }

    ; One entry per distinct string. A slide names the same font on every run
    ; it has, so the pool is a fraction of the number of commands.
    sfn intern:int (pool:[string] index:[string:int] value:string) {
        if (has index value) {
            return (unwrap (get index value))
        }
        def at:int (array_length pool)
        push pool value
        set index value at
        return at
    }

    ; The surface's post-process, written beside the commands and not as one of
    ; them, because it applies to everything that was drawn rather than to a
    ; rectangle in paint order. A backend that has never heard of it draws the
    ; page and ignores the field, which is the whole reason it is here and not
    ; in the command stream.
    def effectKind:string ""
    ; Every drop still in flight: x, y and how long ago, in step.
    def effectXs:[double]
    def effectYs:[double]
    def effectAges:[double]
    def effectSpeed:double 0.0
    def effectWidth:double 0.0
    def effectStrength:double 0.0
    def effectDecay:double 0.0
    def effectHighlight:double 0.0
    def effectRings:double 1.0
    def effectStagger:double 0.0
    def effectFalloff:double 0.0
    def effectShine:double 0.0
    def effectGloss:double 1.0
    def effectBump:double 0.0
    def effectLightX:double 0.0
    def effectLightY:double 0.0
    def effectLightZ:double 1.0

    ; Pick the effect up off the tree. The first element that names one wins:
    ; a surface has one post-process, and two would be a question about order
    ; that nobody asked.
    fn readEffect:void (el:EVGElement) {
        if ((strlen effectKind) > 0) {
            return
        }
        if ((strlen el.surfaceEffect) > 0) {
            effectKind = el.surfaceEffect
            effectXs = el.rippleXs
            effectYs = el.rippleYs
            effectAges = el.rippleAges
            effectSpeed = el.rippleSpeed
            effectWidth = el.rippleWidth
            effectStrength = el.rippleStrength
            effectDecay = el.rippleDecay
            effectHighlight = el.rippleHighlight
            effectRings = el.rippleRings
            effectStagger = el.rippleStagger
            effectFalloff = el.rippleFalloff
            effectShine = el.rippleShine
            effectGloss = el.rippleGloss
            effectBump = el.rippleBump
            effectLightX = el.rippleLightX
            effectLightY = el.rippleLightY
            effectLightZ = el.rippleLightZ
        }
        def i:int 0
        while (i < (el.getChildCount())) {
            this.readEffect((el.getChild(i)))
            i = (i + 1)
        }
    }

    fn toJson:string () {
        def out:string "{"
        if ((strlen effectKind) > 0) {
            out = (out + "\"effect\":{\"kind\":\"" + effectKind + "\"")
            out = (out + ",\"drops\":[")
            def di:int 0
            while (di < (array_length effectAges)) {
                if (di > 0) {
                    out = (out + ",")
                }
                out = (out + "[" + (EVGDisplayList.num((itemAt effectXs di))))
                out = (out + "," + (EVGDisplayList.num((itemAt effectYs di))))
                out = (out + "," + (EVGDisplayList.num((itemAt effectAges di))) + "]")
                di = (di + 1)
            }
            out = (out + "]")
            out = (out + ",\"speed\":" + (EVGDisplayList.num(effectSpeed)))
            out = (out + ",\"width\":" + (EVGDisplayList.num(effectWidth)))
            out = (out + ",\"strength\":" + (EVGDisplayList.num(effectStrength)))
            out = (out + ",\"decay\":" + (EVGDisplayList.num(effectDecay)))
            out = (out + ",\"highlight\":" + (EVGDisplayList.num(effectHighlight)))
            out = (out + ",\"rings\":" + (EVGDisplayList.num(effectRings)))
            out = (out + ",\"stagger\":" + (EVGDisplayList.num(effectStagger)))
            out = (out + ",\"falloff\":" + (EVGDisplayList.num(effectFalloff)))
            out = (out + ",\"shine\":" + (EVGDisplayList.num(effectShine)))
            out = (out + ",\"gloss\":" + (EVGDisplayList.num(effectGloss)))
            out = (out + ",\"bump\":" + (EVGDisplayList.num(effectBump)))
            out = (out + ",\"light\":[" + (EVGDisplayList.num(effectLightX)) + "," +
                (EVGDisplayList.num(effectLightY)) + "," +
                (EVGDisplayList.num(effectLightZ)) + "]")
            out = (out + "},")
        }
        out = (out + "\"cmds\":[")
        def i:int 0
        while (i < (array_length cmds)) {
            def c:EVGDrawCmd (itemAt cmds i)
            if (i > 0) {
                out = out + ","
            }
            out = out + "{\"k\":" + (to_string c.kind)
            out = out + ",\"x\":" + (EVGDisplayList.num(c.x))
            out = out + ",\"y\":" + (EVGDisplayList.num(c.y))
            out = out + ",\"w\":" + (EVGDisplayList.num(c.w))
            out = out + ",\"h\":" + (EVGDisplayList.num(c.h))
            if c.perCorner {
                out = out + ",\"rc\":[" + (EVGDisplayList.num(c.radius)) + "," +
                    (EVGDisplayList.num(c.radiusTR)) + "," +
                    (EVGDisplayList.num(c.radiusBR)) + "," +
                    (EVGDisplayList.num(c.radiusBL)) + "]"
            }
            if (c.radius > 0.0) {
                out = out + ",\"r\":" + (EVGDisplayList.num(c.radius))
            }
            if (c.thickness > 0.0) {
                out = out + ",\"t\":" + (EVGDisplayList.num(c.thickness))
            }
            out = out + ",\"c\":[" + (to_string c.r) + "," + (to_string c.g)
            out = out + "," + (to_string c.b) + "," + (EVGDisplayList.num(c.a)) + "]"
            ; A two-stop gradient was on the command and in the software
            ; canvas but never in the JSON, so every backend on the other side
            ; of it painted the first stop flat across the box. `gd` is the
            ; direction (1 = across, otherwise down) and `c2` the far stop.
            if c.hasGrad {
                out = out + ",\"gd\":" + (to_string c.gradDir)
                out = out + ",\"c2\":[" + (to_string c.r2) + "," + (to_string c.g2)
                out = out + "," + (to_string c.b2) + "," + (EVGDisplayList.num(c.a2)) + "]"
            }
            if ((strlen c.text) > 0) {
                out = out + ",\"text\":" + (EVGDisplayList.jsonString(c.text))
                out = out + ",\"font\":" + (EVGDisplayList.jsonString(c.fontFamily))
                out = out + ",\"size\":" + (EVGDisplayList.num(c.fontSize))
                ; Weight / slant so a canvas backend paints the same face the
                ; SoftCanvas rasterizer picked.
                if ((strlen c.fontWeight) > 0) {
                    out = out + ",\"weight\":" + (EVGDisplayList.jsonString(c.fontWeight))
                }
                if (c.textAlign == "italic") {
                    out = out + ",\"italic\":true"
                }
            }
            if ((strlen c.src) > 0) {
                out = out + ",\"src\":" + (EVGDisplayList.jsonString(c.src))
            }
            if c.flipH {
                out = out + ",\"fx\":true"
            }
            if c.flipV {
                out = out + ",\"fy\":true"
            }
            if (c.rotate != 0.0) {
                out = out + ",\"rot\":" + (EVGDisplayList.num(c.rotate))
                if c.hasRotOrigin {
                    out = out + ",\"rox\":" + (EVGDisplayList.num(c.rotOriginX))
                    out = out + ",\"roy\":" + (EVGDisplayList.num(c.rotOriginY))
                }
            }
            if (c.backdropBlur > 0.0) {
                out = out + ",\"bb\":" + (EVGDisplayList.num(c.backdropBlur))
            }
            ; The GEOMETRY decides whether there is a path, not the ring list:
            ; a command built by hand — and there are several, in this gallery
            ; and outside it — sets `pts` and forgets `ringEnds`, and gating
            ; the points on the ring list dropped every one of those shapes on
            ; the floor. A backend saw a path command with no path and skipped
            ; it, silently, so an arrow or a bracket simply was not there. One
            ; ring covering everything is what a single-contour path means
            ; anyway, so say it here rather than expecting each caller to.
            if ((array_length c.pts) > 0) {
                out = out + ",\"pts\":["
                def pi:int 0
                while (pi < (array_length c.pts)) {
                    if (pi > 0) {
                        out = out + ","
                    }
                    out = out + (EVGDisplayList.num((itemAt c.pts pi)))
                    pi = (pi + 1)
                }
                out = out + "],\"ends\":["
                if ((array_length c.ringEnds) == 0) {
                    out = out + (to_string (array_length c.pts))
                } {
                    def ei:int 0
                    while (ei < (array_length c.ringEnds)) {
                        if (ei > 0) {
                            out = out + ","
                        }
                        out = out + (to_string (itemAt c.ringEnds ei))
                        ei = (ei + 1)
                    }
                }
                out = out + "]"
                if c.evenOdd {
                    out = out + ",\"eo\":1"
                }
            }
            out = out + "}"
            i = (i + 1)
        }
        out = out + "]}"
        return out
    }

    ; Two decimals is plenty for a pixel and keeps the payload small.
    sfn num:string (v:double) {
        ; WHATEVER COMES IN, A JSON NUMBER GOES OUT. This is the only writer of
        ; every coordinate, size, radius and colour in the list, so a value it
        ; cannot spell does not make one command wrong — it makes the whole
        ; frame unparseable, and the page that was drawing it stops. Reported
        ; as a ripple frozen mid-flight with `SyntaxError: Expected ',' or '}'
        ; after property` beside it: the paint loop threw, and a loop that
        ; throws does not ask for another frame.
        ;
        ; Two ways in. A value that is not a number came out as "0.NaN", since
        ; the fraction was formatted from a NaN. And the integer divide below
        ; TRUNCATES TO 32 BITS, so a magnitude past 2^31 wrapped: 1e10 came out
        ; as "1410065408.858993459200", which parses and is simply wrong, and
        ; past about 1e19 the leftover went exponential — "1.0000000001e+21"
        ; as a FRACTION — which is where the JSON stops being JSON.
        ;
        ; So: NaN becomes zero, and the magnitude is pinned inside the range
        ; the arithmetic below is exact over. Ten million pixels is four
        ; thousand times the tallest page in this gallery, and it keeps the
        ; scaled value under 2^31 with a factor of two to spare, so nothing a
        ; real page draws is touched. Clamping does not make a wrong value
        ; right — the frame will look wrong where the bad number was — but a
        ; page that keeps drawing can be looked at, and one that has stopped
        ; cannot.
        def limit:double 10000000.0
        ; A value is kept only if it compares as either side of zero. Zero
        ; itself fails both and stays the zero it already is, which is why the
        ; test can be this blunt — and a NaN fails both as well, because a NaN
        ; fails EVERY comparison. That is the whole test, with no library
        ; behind it, and it catches one thing more that an equality test does
        ; not: a slot read past the end of an array, which on this target is
        ; not a number at all and is equal to itself, so `v == v` waved it
        ; through and the arithmetic below turned it back into a NaN.
        def x:double 0.0
        if (v > 0.0) {
            x = v
        }
        if (v < 0.0) {
            x = v
        }
        ; Infinities pass the comparison above and are pinned here with
        ; everything else too big to spell.
        if (x > limit) {
            x = limit
        }
        if (x < (0.0 - limit)) {
            x = (0.0 - limit)
        }
        ; Sign first, magnitude second. `to_int` FLOORS rather than truncating
        ; here, so the old two-branch rounding turned -45 into "-46.99": the
        ; scaled value floored to -4501 and then the integer divide floored
        ; again. Every negative coordinate in every scene was off by one and a
        ; bit — invisible until a rotation angle was written through it.
        def neg:boolean (x < 0.0)
        def av:double x
        if neg {
            av = (0.0 - x)
        }
        def scaled:int (to_int ((av * 100.0) + 0.5))
        def whole:int (idiv scaled 100)
        def frac:int (scaled - (whole * 100))
        def fs:string (to_string frac)
        if (frac < 10) {
            fs = "0" + fs
        }
        def out:string ((to_string whole) + "." + fs)
        if neg {
            if (scaled > 0) {
                out = ("-" + out)
            }
        }
        return out
    }


    sfn jsonString:string (v:string) {
        def out:string "\""
        def i:int 0
        while (i < (strlen v)) {
            def c:int (charAt v i)
            if (c == 34) {
                out = out + "\\\""
            } {
                if (c == 92) {
                    out = out + "\\\\"
                } {
                    if (c < 32) {
                        out = out + " "
                    } {
                        out = out + (strfromcode c)
                    }
                }
            }
            i = (i + 1)
        }
        return (out + "\"")
    }

    ; A backend-shaped summary: how many quads, how many text runs, how deep
    ; the clip stack goes. Useful for sizing a vertex buffer up front.
    ; Move every command by (dx, dy). A host builds a page's list in the page's
    ; own coordinates and then places it in the window; doing that by walking
    ; the list is what lets the page renderer stay ignorant of where on the
    ; desk it landed. POP_CLIP carries no geometry, so it is left alone.
    fn offsetBy:void (dx:double dy:double) {
        def i:int 0
        while (i < (array_length cmds)) {
            def c:EVGDrawCmd (itemAt cmds i)
            if (c.kind != 5) {
                c.x = (c.x + dx)
                c.y = (c.y + dy)
                def pi:int 0
                while (pi < (array_length c.pts)) {
                    def even:boolean ((pi % 2) == 0)
                    if even {
                        set_at c.pts pi ((itemAt c.pts pi) + dx)
                    } {
                        set_at c.pts pi ((itemAt c.pts pi) + dy)
                    }
                    pi = (pi + 1)
                }
            }
            i = (i + 1)
        }
    }

    ; Append another list's commands to this one, in order. The commands are
    ; shared rather than copied - the source list is finished with by the time
    ; a caller does this, and copying a page of text would not be free.
    fn appendFrom:void (src:EVGDisplayList) {
        def i:int 0
        while (i < (array_length src.cmds)) {
            push cmds (itemAt src.cmds i)
            i = (i + 1)
        }
    }

    fn summary:string () {
        def rects:int 0
        def borders:int 0
        def images:int 0
        def texts:int 0
        def clips:int 0
        def i:int 0
        while (i < (array_length cmds)) {
            def c:EVGDrawCmd (itemAt cmds i)
            if (c.kind == 0) {
                rects = (rects + 1)
            }
            if (c.kind == 1) {
                borders = (borders + 1)
            }
            if (c.kind == 2) {
                images = (images + 1)
            }
            if (c.kind == 3) {
                texts = (texts + 1)
            }
            if (c.kind == 4) {
                clips = (clips + 1)
            }
            i = (i + 1)
        }
        def s:string ("rects=" + (to_string rects))
        s = s + " borders=" + (to_string borders)
        s = s + " images=" + (to_string images)
        s = s + " text=" + (to_string texts)
        s = s + " clips=" + (to_string clips)
        return s
    }
}

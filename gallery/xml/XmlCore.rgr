; ==============================================================================
; XmlCore — the one XML reader for the document formats in this gallery
; ==============================================================================
;
; This was `gallery/pptx/src/PptxXml.rgr` and it is the same parser. It moved
; here when a second format needed it, which is the only reason a module
; belongs in a shared directory at all — see `gallery/office/README.md` on
; what an unused API is worth.
;
; Deliberately tiny: element nodes, attributes, text children, and the span
; each element occupied in its part. That last one is not a detail: it is what
; lets a writer copy through markup it does not understand (`SourceRef`,
; `PptxOpaque`), and it is why `.pptx` is the only format in this repository
; with a save that does not damage what it never read.
;
; TWO NAME POLICIES, and the reason there are two rather than one.
;
;   keepPrefixes = false   `p:sp` → `sp`      (OOXML: the default)
;   keepPrefixes = true    `text:p` → `text:p` (ODF)
;
; OOXML can afford to strip the prefix because its local names are effectively
; unique within a part. ODF cannot: `text:p` and `draw:p` are different
; elements, and `style:name`, `draw:name` and `text:style-name` are three
; different attributes. A reader that strips prefixes in an `.odp` silently
; confuses them, which is the kind of bug that renders something plausible.
;
; Attribute names are never stripped, in either mode — DrawingML needs
; `r:embed` and ODF needs `xlink:href`.
;
; WHITESPACE. Text that is only spaces is dropped, because keeping it turns
; every pretty-printed file into a tree of blank nodes. Inside an element that
; HOLDS text it is content: `<a:t> </a:t>` is the space between two words.
; Which elements those are is a fact about the format, so it is a field
; (`spaceElements`) rather than a hard-coded name — it was `t` alone, which is
; correct for DrawingML and wrong for `text:span`.
;
; Same XXE-safe entity policy as SvgParser: only the five predefined XML
; entities and numeric references, never an external one.
; ==============================================================================

Import "../ooxml/OoxmlText.rgr"

class XmlAttr {
    def name:string ""
    def value:string ""
}

class XmlNode {
    def name:string ""
    def attrs:[XmlAttr]
    def children:[XmlNode]
    def text:string ""
    def isText:boolean false
    ; Where this element was in the part it was parsed from: the index of its
    ; opening '<', and the index just past the '>' that closes it. What lets a
    ; writer copy an element it does not understand through unchanged instead
    ; of dropping it — see `gallery/ooxml/SourceRef.rgr`. Both are 0 on a text
    ; node and on anything built rather than read.
    def srcStart:int 0
    def srcEnd:int 0

    Constructor () {
        def a:[XmlAttr]
        attrs = a
        def c:[XmlNode]
        children = c
    }

    fn hasAttr:boolean (n:string) {
        def i:int 0
        while (i < (array_length attrs)) {
            def a:XmlAttr (itemAt attrs i)
            if (a.name == n) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn attr:string (n:string) {
        def i:int 0
        while (i < (array_length attrs)) {
            def a:XmlAttr (itemAt attrs i)
            if (a.name == n) {
                return a.value
            }
            i = (i + 1)
        }
        return ""
    }

    fn attrOr:string (n:string fallback:string) {
        if (this.hasAttr(n)) {
            return (this.attr(n))
        }
        return fallback
    }

    fn childCount:int () {
        return (array_length children)
    }

    fn childAt:XmlNode (i:int) {
        return (itemAt children i)
    }

    fn firstChild@(optional):XmlNode (localName:string) {
        def i:int 0
        while (i < (array_length children)) {
            def c:XmlNode (itemAt children i)
            if ((c.isText == false) && (c.name == localName)) {
                def hit@(optional):XmlNode c
                return hit
            }
            i = (i + 1)
        }
        def __missing@(optional):XmlNode
        return __missing
    }

    fn childrenNamed:[XmlNode] (localName:string) {
        def out:[XmlNode]
        def i:int 0
        while (i < (array_length children)) {
            def c:XmlNode (itemAt children i)
            if ((c.isText == false) && (c.name == localName)) {
                push out c
            }
            i = (i + 1)
        }
        return out
    }

    ; Depth-first first match by local name.
    fn find@(optional):XmlNode (localName:string) {
        if (name == localName) {
            def selfHit@(optional):XmlNode this
            return selfHit
        }
        def i:int 0
        while (i < (array_length children)) {
            def c:XmlNode (itemAt children i)
            if (c.isText == false) {
                def hit@(optional):XmlNode (c.find(localName))
                if (!null? hit) {
                    return hit
                }
            }
            i = (i + 1)
        }
        def __missing@(optional):XmlNode
        return __missing
    }

    fn textContent:string () {
        if isText {
            return text
        }
        def out:string ""
        def i:int 0
        while (i < (array_length children)) {
            def c:XmlNode (itemAt children i)
            out = (out + (c.textContent()))
            i = (i + 1)
        }
        return out
    }
}

class XmlTag {
    def name:string ""
    def isEnd:boolean false
    def selfClose:boolean false
    def attrs:[XmlAttr]
    def valid:boolean false

    Constructor () {
        def a:[XmlAttr]
        attrs = a
    }
}

class XmlParser {
    def src:string ""
    def pos:int 0
    def len:int 0
    def maxNodes:int 100000
    def maxDepth:int 64
    def nodeCount:int 0
    def aborted:boolean false
    ; Keep the namespace prefix on element names. False is OOXML's policy and
    ; the default, so every existing caller behaves exactly as it did.
    def keepPrefixes:boolean false
    ; Element names whose whitespace-only text is content rather than layout.
    ; Empty means the built-in OOXML answer, `t`, which is what this parser
    ; had hard-coded before ODF needed `text:p` and `text:span`.
    def spaceElements:[string]

    Constructor () {
        def se:[string]
        spaceElements = se
    }

    fn parse@(optional):XmlNode (source:string) {
        src = source
        pos = 0
        len = (strlen source)
        nodeCount = 0
        aborted = false
        this.skipProlog()
        def root@(optional):XmlNode (this.readElement(0))
        return root
    }

    fn isSpace:boolean (c:int) {
        if (c == 32) {
            return true
        }
        if (c == 9) {
            return true
        }
        if (c == 10) {
            return true
        }
        if (c == 13) {
            return true
        }
        return false
    }

    fn skipSpace:void () {
        while (pos < len) {
            if (this.isSpace((charAt src pos)) == false) {
                return
            }
            pos = (pos + 1)
        }
    }

    fn skipProlog:void () {
        this.skipSpace()
        while (pos < len) {
            if ((charAt src pos) != 60) {
                return
            }
            ; <?xml ...?> or <!DOCTYPE ...> or <!-- -->
            if ((pos + 1) < len) {
                def n:int (charAt src (pos + 1))
                if (n == 63) {
                    ; PI
                    def end:int (indexOfFrom src "?>" pos)
                    if (end < 0) {
                        pos = len
                        return
                    }
                    pos = (end + 2)
                    this.skipSpace()
                    continue
                }
                if (n == 33) {
                    if (((pos + 3) < len) && ((charAt src (pos + 2)) == 45) && ((charAt src (pos + 3)) == 45)) {
                        def cend:int (indexOfFrom src "-->" pos)
                        if (cend < 0) {
                            pos = len
                            return
                        }
                        pos = (cend + 3)
                        this.skipSpace()
                        continue
                    }
                    ; DOCTYPE / other declaration — skip to '>'
                    def dend:int (indexOfFrom src ">" pos)
                    if (dend < 0) {
                        pos = len
                        return
                    }
                    pos = (dend + 1)
                    this.skipSpace()
                    continue
                }
            }
            return
        }
    }

    sfn localName:string (qname:string) {
        def colon:int (indexOf qname ":")
        if (colon < 0) {
            return qname
        }
        return (substring qname (colon + 1) (strlen qname))
    }

    ; The element name as this reader will publish it. The one place the two
    ; name policies differ, so a caller cannot half-apply one.
    fn elementName:string (qname:string) {
        if keepPrefixes {
            return qname
        }
        return (XmlParser.localName(qname))
    }

    ; Is whitespace-only text inside this element content?
    fn keepsSpace:boolean (name:string) {
        if ((array_length spaceElements) == 0) {
            return (name == "t")
        }
        def i:int 0
        while (i < (array_length spaceElements)) {
            if ((itemAt spaceElements i) == name) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; Keep r:embed / xmlns:… style names; strip nothing for attrs that have
    ; a prefix other than xmlns (DrawingML relationships need r:embed).
    sfn attrName:string (qname:string) {
        return qname
    }

    ; One decoder for all three OOXML readers. This one used to rebuild every
    ; character it passed through as `(strfromcode (charAt s i))`, which is the
    ; identity where a string is code units and encodes each BYTE a second time
    ; where it is bytes — so on the C++ build any slide whose text contained an
    ; `&` anywhere came out with every accent doubled. It also knew only the
    ; five named entities, so `&#228;` reached the slide as digits.
    fn decodeEntities:string (s:string) {
        return (OoxmlText.decodeEntities(s))
    }

    fn readTag:XmlTag () {
        def tag (new XmlTag())
        if (pos >= len) {
            return tag
        }
        if ((charAt src pos) != 60) {
            return tag
        }
        pos = (pos + 1)
        if (pos >= len) {
            return tag
        }
        ; End tag
        if ((charAt src pos) == 47) {
            tag.isEnd = true
            pos = (pos + 1)
            this.skipSpace()
            def ns:int pos
            while (pos < len) {
                def c:int (charAt src pos)
                if ((this.isSpace(c)) || (c == 62)) {
                    break
                }
                pos = (pos + 1)
            }
            tag.name = (this.elementName((substring src ns pos)))
            this.skipSpace()
            if ((pos < len) && ((charAt src pos) == 62)) {
                pos = (pos + 1)
                tag.valid = true
            }
            return tag
        }
        ; Comment / CDATA — treat as invalid and skip
        if ((charAt src pos) == 33) {
            if (((pos + 2) < len) && ((charAt src (pos + 1)) == 45) && ((charAt src (pos + 2)) == 45)) {
                def cend:int (indexOfFrom src "-->" pos)
                if (cend < 0) {
                    pos = len
                } {
                    pos = (cend + 3)
                }
                return tag
            }
            def dend:int (indexOfFrom src ">" pos)
            if (dend < 0) {
                pos = len
            } {
                pos = (dend + 1)
            }
            return tag
        }
        if ((charAt src pos) == 63) {
            def pend:int (indexOfFrom src "?>" pos)
            if (pend < 0) {
                pos = len
            } {
                pos = (pend + 2)
            }
            return tag
        }
        def nameStart:int pos
        while (pos < len) {
            def c2:int (charAt src pos)
            if ((this.isSpace(c2)) || (c2 == 62) || (c2 == 47)) {
                break
            }
            pos = (pos + 1)
        }
        tag.name = (this.elementName((substring src nameStart pos)))
        ; Attributes
        while (pos < len) {
            this.skipSpace()
            if (pos >= len) {
                break
            }
            def ch:int (charAt src pos)
            if (ch == 47) {
                tag.selfClose = true
                pos = (pos + 1)
                this.skipSpace()
                if ((pos < len) && ((charAt src pos) == 62)) {
                    pos = (pos + 1)
                    tag.valid = true
                }
                return tag
            }
            if (ch == 62) {
                pos = (pos + 1)
                tag.valid = true
                return tag
            }
            ; attr name
            def an:int pos
            while (pos < len) {
                def c3:int (charAt src pos)
                if ((this.isSpace(c3)) || (c3 == 61) || (c3 == 62) || (c3 == 47)) {
                    break
                }
                pos = (pos + 1)
            }
            def attrName:string (XmlParser.attrName((substring src an pos)))
            this.skipSpace()
            def value:string ""
            if ((pos < len) && ((charAt src pos) == 61)) {
                pos = (pos + 1)
                this.skipSpace()
                if (pos < len) {
                    def q:int (charAt src pos)
                    if ((q == 34) || (q == 39)) {
                        def vs:int (pos + 1)
                        def ve:int (indexOfFrom src (strfromcode q) vs)
                        if (ve < 0) {
                            pos = len
                            return tag
                        }
                        value = (this.decodeEntities((substring src vs ve)))
                        pos = (ve + 1)
                    }
                }
            }
            def a (new XmlAttr())
            a.name = attrName
            a.value = value
            push tag.attrs a
        }
        return tag
    }

    fn readElement@(optional):XmlNode (depth:int) {
        if aborted {
            def __missing@(optional):XmlNode
            return __missing
        }
        if (depth > maxDepth) {
            aborted = true
            def __missing@(optional):XmlNode
            return __missing
        }
        if (nodeCount >= maxNodes) {
            aborted = true
            def __missing@(optional):XmlNode
            return __missing
        }
        this.skipSpace()
        if (pos >= len) {
            def __missing@(optional):XmlNode
            return __missing
        }
        if ((charAt src pos) != 60) {
            def __missing@(optional):XmlNode
            return __missing
        }
        ; Where this element starts, taken BEFORE the tag is read: everything
        ; between here and the matching end tag is what a writer can copy
        ; through verbatim.
        def elemStart:int pos
        def tag:XmlTag (this.readTag())
        if (tag.valid == false) {
            def __missing@(optional):XmlNode
            return __missing
        }
        if tag.isEnd {
            def __missing@(optional):XmlNode
            return __missing
        }
        nodeCount = (nodeCount + 1)
        def node (new XmlNode())
        node.name = tag.name
        node.attrs = tag.attrs
        node.srcStart = elemStart
        if tag.selfClose {
            node.srcEnd = pos
            def selfCloseHit@(optional):XmlNode node
            return selfCloseHit
        }
        ; Children / text until matching end tag.
        ; Do NOT skipSpace() here — leading spaces inside <a:t> are significant
        ; in DrawingML runs (e.g. " and "). Inter-element whitespace becomes a
        ; text node that we drop when it is onlySpace below.
        while ((pos < len) && (aborted == false)) {
            if (pos >= len) {
                break
            }
            if ((charAt src pos) == 60) {
                ; Peek end tag
                if (((pos + 1) < len) && ((charAt src (pos + 1)) == 47)) {
                    def endTag:XmlTag (this.readTag())
                    ; End of this element — and the end of what it spans.
                    node.srcEnd = pos
                    def endHit@(optional):XmlNode node
                    return endHit
                }
                ; Nested comment etc. may leave invalid tag — skip
                def save:int pos
                def child@(optional):XmlNode (this.readElement((depth + 1)))
                if (!null? child) {
                    push node.children (unwrap child)
                } {
                    if (pos == save) {
                        ; Avoid infinite loop
                        pos = (pos + 1)
                    }
                }
            } {
                ; Text node
                def ts:int pos
                while (pos < len) {
                    if ((charAt src pos) == 60) {
                        break
                    }
                    pos = (pos + 1)
                }
                def raw:string (substring src ts pos)
                def decoded:string (this.decodeEntities(raw))
                ; Keep non-whitespace text
                def onlySpace:boolean true
                def ti:int 0
                while (ti < (strlen decoded)) {
                    if (this.isSpace((charAt decoded ti)) == false) {
                        onlySpace = false
                        break
                    }
                    ti = (ti + 1)
                }
                ; Whitespace between elements is layout, not content, and
                ; keeping it turns every pretty-printed file into a tree full
                ; of blank nodes. Inside an element that HOLDS text it is the
                ; content: `<a:t> </a:t>` is the space between two words, and
                ; dropping it ran "The Ultimate Training Diary" together.
                def keep:boolean (onlySpace == false)
                if (onlySpace) {
                    if (this.keepsSpace(node.name)) {
                        keep = true
                    }
                    if ((node.attr("xml:space")) == "preserve") {
                        keep = true
                    }
                }
                if keep {
                    def tnode (new XmlNode())
                    tnode.isText = true
                    tnode.text = decoded
                    push node.children tnode
                }
            }
        }
        ; Ran off the end without a closing tag: the element spans whatever
        ; is left, which is the honest answer for a truncated part.
        node.srcEnd = pos
        def fallthrough@(optional):XmlNode node
        return fallthrough
    }
}

{
  "name": "ranger-pkg",
  "version": "0.1.0",
  "description": "Ranger source packages: a Git pack client and the resolver behind Import \"pkg:...\"",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "ranger-pkg": "dist/ranger-pkg.mjs",
    "pkg_tool": "dist/pkg_tool.cjs"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terotests/Ranger.git",
    "directory": "gallery/pkg"
  }
}

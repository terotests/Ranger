; SPDX-License-Identifier: AGPL-3.0-or-later

; pkt-line framing (gitprotocol-common) and the smart-HTTP pieces that
; sit on top of it: info/refs advertisement, a want/done request, and
; side-band-64k demultiplexing of a pack.
;
; Length is four hex digits, including those four bytes. 0000 is flush.
; This is the published packet format, not Git's C pkt-line.c.

Import "GitSha1.rgr"

class GitPkt {
    def ok:boolean true
    def err:string ""
    def lines:[string]
    def raw:[buffer]
    def isFlush:[boolean]
}

class GitRef {
    def name:string ""
    def sha:string ""
    def peeled:string ""
}

class GitAdvertisement {
    def ok:boolean true
    def err:string ""
    def service:string ""
    def caps:string ""
    def head:string ""
    def refs:[GitRef]
}

class GitWant {
    def ok:boolean true
    def err:string ""
    def sha:string ""
    def body:buffer (buffer_alloc 0)
}

class GitSideband {
    def ok:boolean true
    def err:string ""
    def pack:buffer (buffer_alloc 0)
    def progress:string ""
}

class GitPktIO {
    sfn hexVal:int (ch:string) {
        def c:int (charAt ch 0)
        if ((c >= 48) && (c <= 57)) {
            return (c - 48)
        }
        if ((c >= 97) && (c <= 102)) {
            return (c - 87)
        }
        if ((c >= 65) && (c <= 70)) {
            return (c - 55)
        }
        return (0 - 1)
    }

    sfn parseHex4:int (data:buffer at:int) {
        def s:string (GitSha1.ascii(data at 4))
        def v:int 0
        def i:int 0
        while (i < 4) {
            def d:int (GitPktIO.hexVal((substring s i (i + 1))))
            if (d < 0) {
                return (0 - 1)
            }
            v = ((v * 16) + d)
            i = (i + 1)
        }
        return v
    }

    sfn hex4:string (n:int) {
        def digits:string "0123456789abcdef"
        def d0:int (bit_and (bit_ushr n 12) 15)
        def d1:int (bit_and (bit_ushr n 8) 15)
        def d2:int (bit_and (bit_ushr n 4) 15)
        def d3:int (bit_and n 15)
        return ((substring digits d0 (d0 + 1)) + (substring digits d1 (d1 + 1)) + (substring digits d2 (d2 + 1)) + (substring digits d3 (d3 + 1)))
    }

    sfn encodeLine:buffer (text:string) {
        def n:int ((strlen text) + 4)
        def h:string (GitPktIO.hex4(n))
        def raw:buffer (buffer_alloc n)
        def i:int 0
        while (i < 4) {
            buffer_set raw i (charAt h i)
            i = (i + 1)
        }
        while (i < n) {
            buffer_set raw i (charAt text (i - 4))
            i = (i + 1)
        }
        return raw
    }

    sfn encodeFlush:buffer () {
        def raw:buffer (buffer_alloc 4)
        buffer_set raw 0 48
        buffer_set raw 1 48
        buffer_set raw 2 48
        buffer_set raw 3 48
        return raw
    }

    sfn parse:GitPkt (data:buffer) {
        def pkt (new GitPkt)
        def n:int (buffer_length data)
        def at:int 0
        while (at < n) {
            if ((at + 4) > n) {
                pkt.ok = false
                pkt.err = "truncated pkt-line length"
                return pkt
            }
            def len:int (GitPktIO.parseHex4(data at))
            if (len < 0) {
                pkt.ok = false
                pkt.err = "bad pkt-line hex"
                return pkt
            }
            if (len == 0) {
                push pkt.isFlush true
                push pkt.lines ""
                push pkt.raw (GitSha1.copyRange(data at 4))
                at = (at + 4)
            } {
                ; protocol v2: 0001 delim, 0002 response-end — four bytes, no body
                if ((len == 1) || (len == 2)) {
                    push pkt.isFlush true
                    push pkt.lines ""
                    push pkt.raw (GitSha1.copyRange(data at 4))
                    at = (at + 4)
                } {
                if (len < 4) {
                    pkt.ok = false
                    pkt.err = "pkt-line length < 4"
                    return pkt
                }
                if ((at + len) > n) {
                    pkt.ok = false
                    pkt.err = "truncated pkt-line body"
                    return pkt
                }
                def body:buffer (GitSha1.copyRange(data (at + 4) (len - 4)))
                push pkt.raw body
                push pkt.lines (GitSha1.ascii(body 0 (buffer_length body)))
                push pkt.isFlush false
                at = (at + len)
                }
            }
        }
        return pkt
    }

    sfn parseAdvertisement:GitAdvertisement (data:buffer) {
        def adv (new GitAdvertisement)
        def pkt:GitPkt (GitPktIO.parse(data))
        if (pkt.ok == false) {
            adv.ok = false
            adv.err = pkt.err
            return adv
        }
        def i:int 0
        def n:int (array_length pkt.lines)
        while (i < n) {
            def line:string (itemAt pkt.lines i)
            def flush:boolean (itemAt pkt.isFlush i)
            if flush {
                i = (i + 1)
            } {
                if ((strlen line) > 10) {
                    if ((substring line 0 10) == "# service=") {
                        adv.service = (GitPktIO.trimNl((substring line 10 (strlen line))))
                    }
                }
                if ((strlen line) >= 41) {
                    def sha:string (substring line 0 40)
                    def rest:string (substring line 41 (strlen line))
                    def nulAt:int (GitPktIO.indexOfChar(rest 0))
                    def namePart:string rest
                    if (nulAt >= 0) {
                        namePart = (substring rest 0 nulAt)
                        adv.caps = (substring rest (nulAt + 1) (strlen rest))
                    }
                    def name:string (GitPktIO.trimNl(namePart))
                    if (name == "HEAD") {
                        adv.head = sha
                    }
                    def peeled:boolean false
                    if ((strlen name) > 3) {
                        def tail:string (substring name ((strlen name) - 3) (strlen name))
                        if (tail == "^{}") {
                            peeled = true
                            name = (substring name 0 ((strlen name) - 3))
                        }
                    }
                    if peeled {
                        def r:int 0
                        while (r < (array_length adv.refs)) {
                            def existing:GitRef (itemAt adv.refs r)
                            if (existing.name == name) {
                                existing.peeled = sha
                            }
                            r = (r + 1)
                        }
                    } {
                        def ref (new GitRef)
                        ref.name = name
                        ref.sha = sha
                        push adv.refs ref
                    }
                    if ((strlen adv.head) == 0) {
                        if (name == "refs/heads/master") {
                            adv.head = sha
                        }
                        if (name == "refs/heads/main") {
                            if ((strlen adv.head) == 0) {
                                adv.head = sha
                            }
                        }
                    }
                }
                i = (i + 1)
            }
        }
        return adv
    }

    sfn findRef:string (adv:GitAdvertisement spec:string) {
        if ((strlen spec) == 40) {
            return spec
        }
        if ((strlen spec) == 0) {
            return adv.head
        }
        if (spec == "HEAD") {
            return adv.head
        }
        def i:int 0
        while (i < (array_length adv.refs)) {
            def r:GitRef (itemAt adv.refs i)
            if (r.name == spec) {
                if ((strlen r.peeled) == 40) {
                    return r.peeled
                }
                return r.sha
            }
            if (r.name == ("refs/heads/" + spec)) {
                return r.sha
            }
            if (r.name == ("refs/tags/" + spec)) {
                if ((strlen r.peeled) == 40) {
                    return r.peeled
                }
                return r.sha
            }
            i = (i + 1)
        }
        return ""
    }

    sfn hasToken:boolean (caps:string name:string) {
        def n:int (strlen caps)
        def m:int (strlen name)
        if (m == 0) {
            return false
        }
        def i:int 0
        while (i <= (n - m)) {
            if ((substring caps i (i + m)) == name) {
                def left:boolean false
                if (i == 0) {
                    left = true
                } {
                    def lc:int (charAt caps (i - 1))
                    if ((lc == 32) || (lc == 10) || (lc == 0)) {
                        left = true
                    }
                }
                def right:boolean false
                if ((i + m) == n) {
                    right = true
                } {
                    def rc:int (charAt caps (i + m))
                    if ((rc == 32) || (rc == 10) || (rc == 0) || (rc == 61)) {
                        right = true
                    }
                }
                if (left && right) {
                    return true
                }
            }
            i = (i + 1)
        }
        return false
    }

    sfn joinBuf:buffer (parts:[buffer]) {
        def total:int 0
        def i:int 0
        while (i < (array_length parts)) {
            total = (total + (buffer_length (itemAt parts i)))
            i = (i + 1)
        }
        def out:buffer (buffer_alloc total)
        def at:int 0
        i = 0
        while (i < (array_length parts)) {
            def p:buffer (itemAt parts i)
            def pn:int (buffer_length p)
            buffer_copy out at p 0 pn
            at = (at + pn)
            i = (i + 1)
        }
        return out
    }

    sfn encodeDelim:buffer () {
        def raw:buffer (buffer_alloc 4)
        buffer_set raw 0 48
        buffer_set raw 1 48
        buffer_set raw 2 48
        buffer_set raw 3 49
        return raw
    }

    sfn buildWant:GitWant (adv:GitAdvertisement spec:string) {
        def w (new GitWant)
        def sha:string (GitPktIO.findRef(adv spec))
        if ((strlen sha) != 40) {
            w.ok = false
            w.err = ("unknown rev: " + spec)
            return w
        }
        def extras:[string]
        return (GitPktIO.buildWantFetch(sha 0 "" extras))
    }

    ; v1 want/done. deepen 1 drops history; filter blob:none drops blobs
    ; (trees stay). Extra SHAs are further `want` lines — GitHub advertises
    ; allow-reachable-sha1-in-want so a tree SHA is enough for a subdir.
    sfn buildWantFetch:GitWant (sha:string deepen:int filter:string extras:[string]) {
        def w (new GitWant)
        if ((strlen sha) != 40) {
            w.ok = false
            w.err = "want needs a 40-char sha"
            return w
        }
        w.sha = sha
        def caps:string "multi_ack_detailed no-done side-band-64k ofs-delta agent=ranger-pkg/0.1"
        if (deepen > 0) {
            caps = (caps + " shallow")
        }
        if ((strlen filter) > 0) {
            caps = (caps + " filter")
        }
        def parts:[buffer]
        push parts (GitPktIO.encodeLine(("want " + sha + " " + caps + "\n")))
        def i:int 0
        while (i < (array_length extras)) {
            push parts (GitPktIO.encodeLine(("want " + (itemAt extras i) + "\n")))
            i = (i + 1)
        }
        if (deepen > 0) {
            push parts (GitPktIO.encodeLine(("deepen " + (to_string deepen) + "\n")))
        }
        if ((strlen filter) > 0) {
            push parts (GitPktIO.encodeLine(("filter " + filter + "\n")))
        }
        push parts (GitPktIO.encodeFlush())
        push parts (GitPktIO.encodeLine("done\n"))
        w.body = (GitPktIO.joinBuf(parts))
        return w
    }

    sfn buildWantTrees:GitWant (adv:GitAdvertisement spec:string) {
        def w (new GitWant)
        def sha:string (GitPktIO.findRef(adv spec))
        if ((strlen sha) != 40) {
            w.ok = false
            w.err = ("unknown rev: " + spec)
            return w
        }
        def extras:[string]
        def filter:string ""
        if (GitPktIO.hasToken(adv.caps "filter")) {
            filter = "blob:none"
        }
        return (GitPktIO.buildWantFetch(sha 1 filter extras))
    }

    sfn buildWantSha:GitWant (sha:string) {
        def extras:[string]
        return (GitPktIO.buildWantFetch(sha 0 "" extras))
    }

    ; Protocol v2 fetch (gitprotocol-v2). Same deepen/filter as v1; GitHub
    ; wants the argument pkt-lines without a trailing LF.
    sfn buildFetchV2:GitWant (sha:string deepen:int filter:string) {
        def w (new GitWant)
        if ((strlen sha) != 40) {
            w.ok = false
            w.err = "want needs a 40-char sha"
            return w
        }
        w.sha = sha
        def parts:[buffer]
        push parts (GitPktIO.encodeLine("command=fetch"))
        push parts (GitPktIO.encodeDelim())
        push parts (GitPktIO.encodeLine(("want " + sha)))
        if (deepen > 0) {
            push parts (GitPktIO.encodeLine(("deepen " + (to_string deepen))))
        }
        if ((strlen filter) > 0) {
            push parts (GitPktIO.encodeLine(("filter " + filter)))
        }
        push parts (GitPktIO.encodeLine("done"))
        push parts (GitPktIO.encodeFlush())
        w.body = (GitPktIO.joinBuf(parts))
        return w
    }

    ; Concatenate side-band channel 1 into a pack. Channel 2 is progress.
    ; If the stream is a raw PACK (no sideband), return it as-is from the
    ; first PACK magic.
    sfn demux:GitSideband (data:buffer) {
        def sb (new GitSideband)
        def n:int (buffer_length data)
        def mag:int (GitPktIO.indexOfPack(data))
        def pkt:GitPkt (GitPktIO.parse(data))
        if (pkt.ok == false) {
            if (mag >= 0) {
                sb.pack = (GitSha1.copyRange(data mag (n - mag)))
                return sb
            }
            sb.ok = false
            sb.err = pkt.err
            return sb
        }
        def chunks:[buffer]
        def total:int 0
        def i:int 0
        while (i < (array_length pkt.raw)) {
            if ((itemAt pkt.isFlush i) == false) {
                def body:buffer (itemAt pkt.raw i)
                if ((buffer_length body) > 0) {
                    def ch:int (buffer_get body 0)
                    if (ch == 1) {
                        def piece:buffer (GitSha1.copyRange(body 1 ((buffer_length body) - 1)))
                        push chunks piece
                        total = (total + (buffer_length piece))
                    }
                    if (ch == 2) {
                        sb.progress = (sb.progress + (GitSha1.ascii(body 1 ((buffer_length body) - 1))))
                    }
                    if (ch == 3) {
                        sb.ok = false
                        sb.err = (GitSha1.ascii(body 1 ((buffer_length body) - 1)))
                    }
                }
            }
            i = (i + 1)
        }
        if ((array_length chunks) == 0) {
            if (mag >= 0) {
                sb.pack = (GitSha1.copyRange(data mag (n - mag)))
                return sb
            }
            sb.ok = false
            sb.err = "no pack data in response"
            return sb
        }
        def pack:buffer (buffer_alloc total)
        def at:int 0
        i = 0
        while (i < (array_length chunks)) {
            def piece2:buffer (itemAt chunks i)
            def pn:int (buffer_length piece2)
            buffer_copy pack at piece2 0 pn
            at = (at + pn)
            i = (i + 1)
        }
        sb.pack = pack
        return sb
    }

    sfn indexOfPack:int (data:buffer) {
        def n:int (buffer_length data)
        def i:int 0
        while (i < (n - 3)) {
            if ((buffer_get data i) == 80) {
                if ((buffer_get data (i + 1)) == 65) {
                    if ((buffer_get data (i + 2)) == 67) {
                        if ((buffer_get data (i + 3)) == 75) {
                            return i
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return (0 - 1)
    }

    sfn indexOfChar:int (s:string code:int) {
        def n:int (strlen s)
        def i:int 0
        while (i < n) {
            if ((charAt s i) == code) {
                return i
            }
            i = (i + 1)
        }
        return (0 - 1)
    }

    sfn trimNl:string (s:string) {
        def n:int (strlen s)
        while (n > 0) {
            def c:int (charAt s (n - 1))
            if (c == 10) {
                n = (n - 1)
            } {
                if (c == 13) {
                    n = (n - 1)
                } {
                    if (c == 0) {
                        n = (n - 1)
                    } {
                        return (substring s 0 n)
                    }
                }
            }
        }
        return ""
    }
}

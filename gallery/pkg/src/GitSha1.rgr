; SPDX-License-Identifier: AGPL-3.0-or-later

; SHA-1 of a byte buffer, plus hex and a few big-endian helpers.
;
; Git object names are SHA-1 of `type SP size NUL payload`. The algorithm
; is FIPS 180-1; this is not Git's C implementation. Arithmetic is kept
; inside 32-bit lanes the same way gallery/zip/CRC32.rgr does.

class GitSha1 {
    ; Force 32-bit wrap. JS `| 0` is ToInt32; Go/Rust int is 64-bit, so
    ; SHA-1 constants like 4023233417 would otherwise keep growing.
    sfn add32:int (a:int b:int) {
        return (bit_and (a + b) 4294967295)
    }

    sfn not32:int (x:int) {
        return (bit_and (bit_not x) 4294967295)
    }

    sfn rotl:int (x:int n:int) {
        def u:int (bit_and x 4294967295)
        return (bit_and (bit_or (bit_shl u n) (bit_ushr u (32 - n))) 4294967295)
    }

    sfn copyRange:buffer (data:buffer start:int count:int) {
        def n:int count
        def len:int (buffer_length data)
        if (start < 0) {
            return (buffer_alloc 0)
        }
        if (start >= len) {
            return (buffer_alloc 0)
        }
        if ((start + n) > len) {
            n = (len - start)
        }
        if (n < 0) {
            n = 0
        }
        def out:buffer (buffer_alloc n)
        buffer_copy out 0 data start n
        return out
    }

    sfn ascii:string (data:buffer start:int count:int) {
        def n:int count
        def len:int (buffer_length data)
        if ((start + n) > len) {
            n = (len - start)
        }
        if (n < 0) {
            n = 0
        }
        def s:string ""
        def i:int 0
        while (i < n) {
            s = (s + (strfromcode (buffer_get data (start + i))))
            i = (i + 1)
        }
        return s
    }

    sfn u32be:int (data:buffer i:int) {
        def b0:int (buffer_get data i)
        def b1:int (buffer_get data (i + 1))
        def b2:int (buffer_get data (i + 2))
        def b3:int (buffer_get data (i + 3))
        return (bit_or (bit_shl b0 24) (bit_or (bit_shl b1 16) (bit_or (bit_shl b2 8) b3)))
    }

    sfn hexDigit:string (d:int) {
        def h:string "0123456789abcdef"
        return (substring h d (d + 1))
    }

    sfn toHex:string (data:buffer) {
        def n:int (buffer_length data)
        def s:string ""
        def i:int 0
        while (i < n) {
            def b:int (buffer_get data i)
            def hi:int (bit_ushr b 4)
            def lo:int (bit_and b 15)
            s = (s + (GitSha1.hexDigit(hi)))
            s = (s + (GitSha1.hexDigit(lo)))
            i = (i + 1)
        }
        return s
    }

    sfn fromHex:buffer (hex:string) {
        def n:int (strlen hex)
        def outLen:int (idiv n 2)
        def out:buffer (buffer_alloc outLen)
        def digits:string "0123456789abcdef"
        def i:int 0
        while (i < outLen) {
            def c0:string (substring hex (i * 2) ((i * 2) + 1))
            def c1:string (substring hex ((i * 2) + 1) ((i * 2) + 2))
            def v:int 0
            def d:int 0
            while (d < 16) {
                def ch:string (substring digits d (d + 1))
                if (ch == c0) {
                    v = (d * 16)
                }
                d = (d + 1)
            }
            d = 0
            while (d < 16) {
                def ch2:string (substring digits d (d + 1))
                if (ch2 == c1) {
                    v = (v + d)
                }
                d = (d + 1)
            }
            buffer_set out i v
            i = (i + 1)
        }
        return out
    }

    ; SHA-1 of the whole buffer. Returns 20 bytes.
    sfn hash:buffer (data:buffer) {
        def L:int (buffer_length data)
        def cap:int (L + 128)
        def msg:buffer (buffer_alloc cap)
        if (L > 0) {
            buffer_copy msg 0 data 0 L
        }
        buffer_set msg L 128
        def pos:int (L + 1)
        while ((bit_and pos 63) != 56) {
            buffer_set msg pos 0
            pos = (pos + 1)
        }
        def bitLen:int (L * 8)
        buffer_set msg pos 0
        buffer_set msg (pos + 1) 0
        buffer_set msg (pos + 2) 0
        buffer_set msg (pos + 3) 0
        buffer_set msg (pos + 4) (bit_and (bit_ushr bitLen 24) 255)
        buffer_set msg (pos + 5) (bit_and (bit_ushr bitLen 16) 255)
        buffer_set msg (pos + 6) (bit_and (bit_ushr bitLen 8) 255)
        buffer_set msg (pos + 7) (bit_and bitLen 255)
        def msgLen:int (pos + 8)

        def h0:int 1732584193
        def h1:int 4023233417
        def h2:int 2562383102
        def h3:int 271733878
        def h4:int 3285377520

        def w:[int]
        def wi:int 0
        while (wi < 80) {
            push w 0
            wi = (wi + 1)
        }

        def off:int 0
        while (off < msgLen) {
            def t:int 0
            while (t < 16) {
                set w t (GitSha1.u32be(msg (off + (t * 4))))
                t = (t + 1)
            }
            while (t < 80) {
                def x:int (bit_xor (bit_xor (itemAt w (t - 3)) (itemAt w (t - 8))) (bit_xor (itemAt w (t - 14)) (itemAt w (t - 16))))
                set w t (GitSha1.rotl(x 1))
                t = (t + 1)
            }
            def a:int h0
            def b:int h1
            def c:int h2
            def d:int h3
            def e:int h4
            t = 0
            while (t < 80) {
                def f:int 0
                def k:int 0
                if (t < 20) {
                    f = (bit_or (bit_and b c) (bit_and (GitSha1.not32(b)) d))
                    k = 1518500249
                }
                if ((t >= 20) && (t < 40)) {
                    f = (bit_xor (bit_xor b c) d)
                    k = 1859775393
                }
                if ((t >= 40) && (t < 60)) {
                    f = (bit_or (bit_or (bit_and b c) (bit_and b d)) (bit_and c d))
                    k = 2400959708
                }
                if (t >= 60) {
                    f = (bit_xor (bit_xor b c) d)
                    k = 3395469782
                }
                def temp:int (GitSha1.add32((GitSha1.add32((GitSha1.add32((GitSha1.add32((GitSha1.rotl(a 5)) f)) e)) k)) (itemAt w t)))
                e = d
                d = c
                c = (GitSha1.rotl(b 30))
                b = a
                a = temp
                t = (t + 1)
            }
            h0 = (GitSha1.add32(h0 a))
            h1 = (GitSha1.add32(h1 b))
            h2 = (GitSha1.add32(h2 c))
            h3 = (GitSha1.add32(h3 d))
            h4 = (GitSha1.add32(h4 e))
            off = (off + 64)
        }

        def out:buffer (buffer_alloc 20)
        GitSha1.writeU32be(out 0 h0)
        GitSha1.writeU32be(out 4 h1)
        GitSha1.writeU32be(out 8 h2)
        GitSha1.writeU32be(out 12 h3)
        GitSha1.writeU32be(out 16 h4)
        return out
    }

    sfn writeU32be:void (out:buffer i:int v:int) {
        buffer_set out i (bit_and (bit_ushr v 24) 255)
        buffer_set out (i + 1) (bit_and (bit_ushr v 16) 255)
        buffer_set out (i + 2) (bit_and (bit_ushr v 8) 255)
        buffer_set out (i + 3) (bit_and v 255)
    }

    sfn hashHex:string (data:buffer) {
        return (GitSha1.toHex((GitSha1.hash(data))))
    }

    ; Git object id: sha1(<type> + " " + <decimal size> + NUL + payload)
    sfn objectId:string (kind:string payload:buffer) {
        def sizeText:string (to_string (buffer_length payload))
        def prefix:string (kind + " " + sizeText)
        def pLen:int (strlen prefix)
        def n:int (buffer_length payload)
        def raw:buffer (buffer_alloc ((pLen + 1) + n))
        def i:int 0
        while (i < pLen) {
            buffer_set raw i (charAt prefix i)
            i = (i + 1)
        }
        buffer_set raw pLen 0
        if (n > 0) {
            buffer_copy raw (pLen + 1) payload 0 n
        }
        return (GitSha1.hashHex(raw))
    }

    sfn hexEq:boolean (a:string b:string) {
        if ((strlen a) != (strlen b)) {
            return false
        }
        return (a == b)
    }
}

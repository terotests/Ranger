; SPDX-License-Identifier: AGPL-3.0-or-later

; Git packfile v2 (gitformat-pack) and the two delta encodings Git uses
; inside it. Object bytes come out zlib-inflated; a second pass applies
; REF_DELTA / OFS_DELTA. SHA-1 names are computed from the canonical
; header, the same way a loose object is named.
;
; Written from the published pack format, not from Git's C packfile.c.

Import "GitSha1.rgr"
Import "GitZlib.rgr"

class GitObj {
    def kind:int 0
    def sha:string ""
    def data:buffer (buffer_alloc 0)
    def packOff:int 0
    def resolved:boolean false
    def delta:boolean false
    def baseOff:int 0
    def baseSha:string ""
}

class GitPack {
    def ok:boolean true
    def err:string ""
    def version:int 0
    def count:int 0
    def objects:[GitObj]
    def bySha:[string:GitObj]
    def byOff:[int:GitObj]
}

class GitDelta {
    sfn varInt:int (data:buffer pos@(mutates):[int]) {
        def at:int (itemAt pos 0)
        def n:int (buffer_length data)
        if (at >= n) {
            return 0
        }
        def c:int (buffer_get data at)
        at = (at + 1)
        def v:int (bit_and c 127)
        def shift:int 7
        while ((bit_and c 128) != 0) {
            if (at >= n) {
                set pos 0 at
                return v
            }
            c = (buffer_get data at)
            at = (at + 1)
            v = (bit_or v (bit_shl (bit_and c 127) shift))
            shift = (shift + 7)
        }
        set pos 0 at
        return v
    }

    sfn apply:buffer (src:buffer delta:buffer) {
        def pos:[int]
        push pos 0
        def srcSize:int (GitDelta.varInt(delta pos))
        def dstSize:int (GitDelta.varInt(delta pos))
        def srcLen:int (buffer_length src)
        if (srcSize != srcLen) {
            ; still apply; some producers lie about the source size
        }
        def out:buffer (buffer_alloc dstSize)
        def o:int 0
        def n:int (buffer_length delta)
        def at:int (itemAt pos 0)
        while (at < n) {
            def cmd:int (buffer_get delta at)
            at = (at + 1)
            if ((bit_and cmd 128) != 0) {
                def cpOff:int 0
                def cpSize:int 0
                if ((bit_and cmd 1) != 0) {
                    cpOff = (buffer_get delta at)
                    at = (at + 1)
                }
                if ((bit_and cmd 2) != 0) {
                    cpOff = (bit_or cpOff (bit_shl (buffer_get delta at) 8))
                    at = (at + 1)
                }
                if ((bit_and cmd 4) != 0) {
                    cpOff = (bit_or cpOff (bit_shl (buffer_get delta at) 16))
                    at = (at + 1)
                }
                if ((bit_and cmd 8) != 0) {
                    cpOff = (bit_or cpOff (bit_shl (buffer_get delta at) 24))
                    at = (at + 1)
                }
                if ((bit_and cmd 16) != 0) {
                    cpSize = (buffer_get delta at)
                    at = (at + 1)
                }
                if ((bit_and cmd 32) != 0) {
                    cpSize = (bit_or cpSize (bit_shl (buffer_get delta at) 8))
                    at = (at + 1)
                }
                if ((bit_and cmd 64) != 0) {
                    cpSize = (bit_or cpSize (bit_shl (buffer_get delta at) 16))
                    at = (at + 1)
                }
                if (cpSize == 0) {
                    cpSize = 65536
                }
                buffer_copy out o src cpOff cpSize
                o = (o + cpSize)
            } {
                if (cmd == 0) {
                    return out
                }
                buffer_copy out o delta at cmd
                o = (o + cmd)
                at = (at + cmd)
            }
        }
        return out
    }
}

class GitPackIO {
    sfn kindName:string (kind:int) {
        if (kind == 1) {
            return "commit"
        }
        if (kind == 2) {
            return "tree"
        }
        if (kind == 3) {
            return "blob"
        }
        if (kind == 4) {
            return "tag"
        }
        return "unknown"
    }

    sfn parse:GitPack (data:buffer) {
        def pack (new GitPack)
        def n:int (buffer_length data)
        if (n < 32) {
            pack.ok = false
            pack.err = "pack too small"
            return pack
        }
        def mag:string (GitSha1.ascii(data 0 4))
        if (mag != "PACK") {
            pack.ok = false
            pack.err = "not a pack (missing PACK magic)"
            return pack
        }
        pack.version = (GitSha1.u32be(data 4))
        pack.count = (GitSha1.u32be(data 8))
        if (pack.version != 2) {
            pack.ok = false
            pack.err = ("unsupported pack version " + (to_string pack.version))
            return pack
        }
        def z (new GitZlib)
        def at:int 12
        def i:int 0
        while (i < pack.count) {
            if (at >= (n - 20)) {
                pack.ok = false
                pack.err = ("truncated pack at object " + (to_string i))
                return pack
            }
            def obj (new GitObj)
            obj.packOff = at
            def c:int (buffer_get data at)
            at = (at + 1)
            obj.kind = (bit_and (bit_ushr c 4) 7)
            def size:int (bit_and c 15)
            def shift:int 4
            while ((bit_and c 128) != 0) {
                if (at >= n) {
                    pack.ok = false
                    pack.err = "truncated size encoding"
                    return pack
                }
                c = (buffer_get data at)
                at = (at + 1)
                size = (bit_or size (bit_shl (bit_and c 127) shift))
                shift = (shift + 7)
            }
            if (obj.kind == 6) {
                ; OFS_DELTA: variable negative offset, then zlib
                def oc:int (buffer_get data at)
                at = (at + 1)
                def offv:int (bit_and oc 127)
                while ((bit_and oc 128) != 0) {
                    oc = (buffer_get data at)
                    at = (at + 1)
                    offv = (offv + 1)
                    offv = ((offv * 128) + (bit_and oc 127))
                }
                obj.delta = true
                obj.baseOff = (obj.packOff - offv)
            }
            if (obj.kind == 7) {
                obj.delta = true
                obj.baseSha = (GitSha1.toHex((GitSha1.copyRange(data at 20))))
                at = (at + 20)
            }
            def inflated:buffer (z.inflateAt(data at))
            if (z.ok == false) {
                pack.ok = false
                pack.err = ("inflate object " + (to_string i) + ": " + z.err)
                return pack
            }
            at = z.nextPos
            obj.data = inflated
            if (obj.delta) {
                obj.resolved = false
            } {
                obj.resolved = true
                obj.sha = (GitSha1.objectId((GitPackIO.kindName(obj.kind)) inflated))
                set pack.bySha obj.sha obj
            }
            set pack.byOff obj.packOff obj
            push pack.objects obj
            i = (i + 1)
        }
        GitPackIO.resolveDeltas(pack)
        return pack
    }

    sfn resolveDeltas:void (pack:GitPack) {
        def guard:int 0
        def progress:boolean true
        while (progress) {
            if (guard > 64) {
                pack.ok = false
                pack.err = "delta chain too deep"
                return
            }
            progress = false
            def i:int 0
            while (i < (array_length pack.objects)) {
                def obj:GitObj (itemAt pack.objects i)
                if (obj.resolved == false) {
                    def base@(optional):GitObj
                    if (obj.kind == 6) {
                        if (has pack.byOff obj.baseOff) {
                            base = (get pack.byOff obj.baseOff)
                        }
                    }
                    if (obj.kind == 7) {
                        if (has pack.bySha obj.baseSha) {
                            base = (get pack.bySha obj.baseSha)
                        }
                    }
                    if (null? base) {
                    } {
                        def b:GitObj (unwrap base)
                        if b.resolved {
                            def out:buffer (GitDelta.apply(b.data obj.data))
                            obj.data = out
                            obj.kind = b.kind
                            obj.delta = false
                            obj.resolved = true
                            obj.sha = (GitSha1.objectId((GitPackIO.kindName(obj.kind)) out))
                            set pack.bySha obj.sha obj
                            progress = true
                        }
                    }
                }
                i = (i + 1)
            }
            guard = (guard + 1)
        }
        def j:int 0
        while (j < (array_length pack.objects)) {
            def o2:GitObj (itemAt pack.objects j)
            if (o2.resolved == false) {
                pack.ok = false
                pack.err = "unresolved delta in pack"
                return
            }
            j = (j + 1)
        }
    }

    sfn lookup@(optional):GitObj (pack:GitPack sha:string) {
        def res@(optional):GitObj
        if (has pack.bySha sha) {
            res = (get pack.bySha sha)
        }
        return res
    }

    sfn merge:GitPack (a:GitPack b:GitPack) {
        def out (new GitPack)
        if (a.ok == false) {
            out.ok = false
            out.err = a.err
            return out
        }
        if (b.ok == false) {
            out.ok = false
            out.err = b.err
            return out
        }
        def i:int 0
        while (i < (array_length a.objects)) {
            def o:GitObj (itemAt a.objects i)
            push out.objects o
            set out.bySha o.sha o
            i = (i + 1)
        }
        i = 0
        while (i < (array_length b.objects)) {
            def o2:GitObj (itemAt b.objects i)
            if (has out.bySha o2.sha) {
            } {
                push out.objects o2
                set out.bySha o2.sha o2
            }
            i = (i + 1)
        }
        out.count = (array_length out.objects)
        out.ok = true
        return out
    }
}

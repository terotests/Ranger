; Command line for the Git pack client and the package resolver.
;
;   pkg_tool sha1 <file>
;   pkg_tool refs <advertise.bin>
;   pkg_tool want <advertise.bin> <rev> <want.bin>
;   pkg_tool want-trees <advertise.bin> <rev> <want.bin>
;   pkg_tool want-shallow <advertise.bin> <rev> <want.bin>
;   pkg_tool want-sha <sha> <want.bin>
;   pkg_tool want-v2 <sha> <want.bin> [filter]
;   pkg_tool unpack <pack>
;   pkg_tool checkout <pack> <rev> [subdir] <out-dir>
;   pkg_tool fetch-checkout <response.bin> <rev> [subdir] <out-dir>
;   pkg_tool sparse-tree <response.bin> <commit> [subdir]
;   pkg_tool fetch-merge <trees.bin> <blobs.bin> <commit> [subdir] <out-dir>
;   pkg_tool resolve <ranger.json> <import> [importer]
;   pkg_tool tree <ranger.json>
;   pkg_tool lock <ranger.json>
;   pkg_tool vendor <ranger.json> <out-dir>
;   pkg_tool cache-put <pack> <sha> [subdir] <cache-root>
;   pkg_tool cache-merge <trees.bin> <blobs.bin> <commit> [subdir] <cache-root>
;   pkg_tool install <ranger.json>

Import "GitSha1.rgr"
Import "GitPkt.rgr"
Import "GitPack.rgr"
Import "GitStore.rgr"
Import "PkgManifest.rgr"
Import "PkgResolver.rgr"
Import "PkgCache.rgr"

class PkgTool {
    sfn splitPath:[string] (path:string) {
        def dir:string "."
        def name:string path
        def n:int (strlen path)
        def i:int (n - 1)
        while (i >= 0) {
            if ((charAt path i) == 47) {
                dir = (substring path 0 i)
                name = (substring path (i + 1) n)
                i = (0 - 1)
            } {
                i = (i - 1)
            }
        }
        def parts:[string]
        push parts dir
        push parts name
        return parts
    }

    sfn readFile:buffer (path:string) {
        def parts:[string] (PkgTool.splitPath(path))
        return (buffer_read_file (itemAt parts 0) (itemAt parts 1))
    }

    sfn loadPack:GitPack (path:string) {
        def data:buffer (PkgTool.readFile(path))
        def sb:GitSideband (GitPktIO.demux(data))
        def raw:buffer data
        if sb.ok {
            if ((buffer_length sb.pack) > 0) {
                raw = sb.pack
            }
        }
        return (GitPackIO.parse(raw))
    }

    sfn writeWant:void (w:GitWant dest:string) {
        def parts:[string] (PkgTool.splitPath(dest))
        buffer_write_file (itemAt parts 0) (itemAt parts 1) w.body
    }

    sfn usage:void () {
        print "pkg_tool sha1 <file>"
        print "pkg_tool refs <advertise.bin>"
        print "pkg_tool want <advertise.bin> <rev> <want.bin>"
        print "pkg_tool want-trees <advertise.bin> <rev> <want.bin>"
        print "pkg_tool want-shallow <advertise.bin> <rev> <want.bin>"
        print "pkg_tool want-sha <sha> <want.bin>"
        print "pkg_tool want-v2 <sha> <want.bin> [filter]"
        print "pkg_tool unpack <pack>"
        print "pkg_tool checkout <pack> <sha> [subdir] <out-dir>"
        print "pkg_tool fetch-checkout <response.bin> <sha> [subdir] <out-dir>"
        print "pkg_tool sparse-tree <response.bin> <commit> [subdir]"
        print "pkg_tool fetch-merge <trees.bin> <blobs.bin> <commit> [subdir] <out-dir>"
        print "pkg_tool resolve <ranger.json> <import> [importer]"
        print "pkg_tool tree <ranger.json>"
        print "pkg_tool lock <ranger.json>"
        print "pkg_tool vendor <ranger.json> <out-dir>"
        print "pkg_tool cache-put <pack> <sha> [subdir] <cache-root>"
        print "pkg_tool cache-merge <trees.bin> <blobs.bin> <commit> [subdir] <cache-root>"
        print "pkg_tool install <ranger.json>"
    }

    sfn m@(main):void () {
        def n:int (shell_arg_cnt)
        if (n < 1) {
            PkgTool.usage()
            return
        }
        def cmd:string (shell_arg 0)
        if (cmd == "sha1") {
            if (n < 2) {
                PkgTool.usage()
                return
            }
            def data:buffer (PkgTool.readFile((shell_arg 1)))
            print (GitSha1.hashHex(data))
            return
        }
        if (cmd == "refs") {
            def adv:GitAdvertisement (GitPktIO.parseAdvertisement((PkgTool.readFile((shell_arg 1)))))
            if (adv.ok == false) {
                print ("FAIL " + adv.err)
                return
            }
            print ("HEAD " + adv.head)
            def i:int 0
            while (i < (array_length adv.refs)) {
                def r:GitRef (itemAt adv.refs i)
                print (r.sha + " " + r.name)
                i = (i + 1)
            }
            return
        }
        if (cmd == "want") {
            def adv2:GitAdvertisement (GitPktIO.parseAdvertisement((PkgTool.readFile((shell_arg 1)))))
            def w:GitWant (GitPktIO.buildWant(adv2 (shell_arg 2)))
            if (w.ok == false) {
                print ("FAIL " + w.err)
                return
            }
            print w.sha
            PkgTool.writeWant(w (shell_arg 3))
            return
        }
        if (cmd == "want-trees") {
            def advT:GitAdvertisement (GitPktIO.parseAdvertisement((PkgTool.readFile((shell_arg 1)))))
            def wt:GitWant (GitPktIO.buildWantTrees(advT (shell_arg 2)))
            if (wt.ok == false) {
                print ("FAIL " + wt.err)
                return
            }
            print wt.sha
            PkgTool.writeWant(wt (shell_arg 3))
            return
        }
        if (cmd == "want-shallow") {
            def advSh:GitAdvertisement (GitPktIO.parseAdvertisement((PkgTool.readFile((shell_arg 1)))))
            def shaSh:string (GitPktIO.findRef(advSh (shell_arg 2)))
            def extrasSh:[string]
            def wsh:GitWant (GitPktIO.buildWantFetch(shaSh 1 "" extrasSh))
            if (wsh.ok == false) {
                print ("FAIL " + wsh.err)
                return
            }
            print wsh.sha
            PkgTool.writeWant(wsh (shell_arg 3))
            return
        }
        if (cmd == "want-sha") {
            def ws:GitWant (GitPktIO.buildWantSha((shell_arg 1)))
            if (ws.ok == false) {
                print ("FAIL " + ws.err)
                return
            }
            print ws.sha
            PkgTool.writeWant(ws (shell_arg 2))
            return
        }
        if (cmd == "want-v2") {
            def filt:string ""
            if (n >= 4) {
                filt = (shell_arg 3)
            }
            def wv:GitWant (GitPktIO.buildFetchV2((shell_arg 1) 1 filt))
            if (wv.ok == false) {
                print ("FAIL " + wv.err)
                return
            }
            print wv.sha
            PkgTool.writeWant(wv (shell_arg 2))
            return
        }
        if (cmd == "unpack") {
            def pack:GitPack (GitPackIO.parse((PkgTool.readFile((shell_arg 1)))))
            if (pack.ok == false) {
                print ("FAIL " + pack.err)
                return
            }
            print ("objects " + (to_string (array_length pack.objects)))
            def i:int 0
            while (i < (array_length pack.objects)) {
                def o:GitObj (itemAt pack.objects i)
                print ((GitPackIO.kindName(o.kind)) + " " + o.sha + " " + (to_string (buffer_length o.data)))
                i = (i + 1)
            }
            return
        }
        if (cmd == "checkout") {
            def pack2:GitPack (GitPackIO.parse((PkgTool.readFile((shell_arg 1)))))
            if (pack2.ok == false) {
                print ("FAIL " + pack2.err)
                return
            }
            def sha:string (shell_arg 2)
            def sub:string ""
            def outDir:string (shell_arg 3)
            if (n >= 5) {
                sub = (shell_arg 3)
                outDir = (shell_arg 4)
            }
            def store (new GitStore(pack2))
            def mem:GitMem (store.checkout(sha sub))
            if (store.ok == false) {
                print ("FAIL " + store.err)
                return
            }
            create_dir outDir
            store.writeDisk(mem outDir)
            print ("files " + (to_string (array_length mem.files)))
            return
        }
        if (cmd == "fetch-checkout") {
            def sb:GitSideband (GitPktIO.demux((PkgTool.readFile((shell_arg 1)))))
            if (sb.ok == false) {
                print ("FAIL " + sb.err)
                return
            }
            def pack3:GitPack (GitPackIO.parse(sb.pack))
            if (pack3.ok == false) {
                print ("FAIL " + pack3.err)
                return
            }
            def sha2:string (shell_arg 2)
            def sub2:string ""
            def out2:string (shell_arg 3)
            if (n >= 5) {
                sub2 = (shell_arg 3)
                out2 = (shell_arg 4)
            }
            def store2 (new GitStore(pack3))
            def mem2:GitMem (store2.checkout(sha2 sub2))
            if (store2.ok == false) {
                print ("FAIL " + store2.err)
                return
            }
            create_dir out2
            store2.writeDisk(mem2 out2)
            print ("files " + (to_string (array_length mem2.files)))
            return
        }
        if (cmd == "sparse-tree") {
            def packS:GitPack (PkgTool.loadPack((shell_arg 1)))
            if (packS.ok == false) {
                print ("FAIL " + packS.err)
                return
            }
            def subS:string ""
            if (n >= 4) {
                subS = (shell_arg 3)
            }
            def storeS (new GitStore(packS))
            def treeSha:string (storeS.treeAt((shell_arg 2) subS))
            if (storeS.ok == false) {
                print ("FAIL " + storeS.err)
                return
            }
            print ("tree " + treeSha)
            return
        }
        if (cmd == "fetch-merge") {
            if (n < 5) {
                PkgTool.usage()
                return
            }
            def packA:GitPack (PkgTool.loadPack((shell_arg 1)))
            def packB:GitPack (PkgTool.loadPack((shell_arg 2)))
            def merged:GitPack (GitPackIO.merge(packA packB))
            if (merged.ok == false) {
                print ("FAIL " + merged.err)
                return
            }
            def shaM:string (shell_arg 3)
            def subM:string ""
            def outM:string (shell_arg 4)
            if (n >= 6) {
                subM = (shell_arg 4)
                outM = (shell_arg 5)
            }
            def storeM (new GitStore(merged))
            def memM:GitMem (storeM.checkout(shaM subM))
            if (storeM.ok == false) {
                print ("FAIL " + storeM.err)
                return
            }
            create_dir outM
            storeM.writeDisk(memM outM)
            print ("files " + (to_string (array_length memM.files)))
            print ("objects " + (to_string merged.count))
            return
        }
        if (cmd == "resolve") {
            def manPath:string (shell_arg 1)
            def parts:[string] (PkgTool.splitPath(manPath))
            def src:string (buffer_to_string ((buffer_read_file (itemAt parts 0) (itemAt parts 1))))
            def resv (new PackageResolver)
            resv.loadRoot(src (itemAt parts 0))
            def req (new ImportRequest)
            req.importString = (shell_arg 2)
            req.importer = ""
            if (n >= 4) {
                req.importer = (shell_arg 3)
            }
            def got:ResolvedSource (resv.resolve(req))
            if (got.ok == false) {
                print ("FAIL " + got.err)
                return
            }
            print (got.packageId + " " + got.logicalPath)
            return
        }
        if (cmd == "tree") {
            def manPath2:string (shell_arg 1)
            def parts2:[string] (PkgTool.splitPath(manPath2))
            def src2:string (buffer_to_string ((buffer_read_file (itemAt parts2 0) (itemAt parts2 1))))
            def resv2 (new PackageResolver)
            resv2.loadRoot(src2 (itemAt parts2 0))
            print (resv2.treeText())
            return
        }
        if (cmd == "lock") {
            def manPath3:string (shell_arg 1)
            def parts3:[string] (PkgTool.splitPath(manPath3))
            def src3:string (buffer_to_string ((buffer_read_file (itemAt parts3 0) (itemAt parts3 1))))
            def resv3 (new PackageResolver)
            resv3.loadRoot(src3 (itemAt parts3 0))
            def lock:PkgLock (resv3.makeLock())
            print (PkgManifestIO.dumpLock(lock))
            return
        }
        if (cmd == "vendor") {
            def manPath4:string (shell_arg 1)
            def parts4:[string] (PkgTool.splitPath(manPath4))
            def src4:string (buffer_to_string ((buffer_read_file (itemAt parts4 0) (itemAt parts4 1))))
            def resv4 (new PackageResolver)
            resv4.loadRoot(src4 (itemAt parts4 0))
            resv4.vendorTo((shell_arg 2))
            print ("vendor " + (shell_arg 2))
            return
        }
        if (cmd == "cache-put") {
            if (n < 4) {
                PkgTool.usage()
                return
            }
            def pack5:GitPack (GitPackIO.parse((PkgTool.readFile((shell_arg 1)))))
            if (pack5.ok == false) {
                print ("FAIL " + pack5.err)
                return
            }
            def sha5:string (shell_arg 2)
            def sub5:string ""
            def cacheDir:string (shell_arg 3)
            if (n >= 5) {
                sub5 = (shell_arg 3)
                cacheDir = (shell_arg 4)
            }
            def store5 (new GitStore(pack5))
            def mem5:GitMem (store5.checkout(sha5 sub5))
            if (store5.ok == false) {
                print ("FAIL " + store5.err)
                return
            }
            create_dir cacheDir
            def hash5:string (PkgCache.put(mem5 cacheDir))
            print ("sha256 " + hash5)
            print ("files " + (to_string (array_length mem5.files)))
            return
        }
        if (cmd == "cache-merge") {
            if (n < 5) {
                PkgTool.usage()
                return
            }
            def packC1:GitPack (PkgTool.loadPack((shell_arg 1)))
            def packC2:GitPack (PkgTool.loadPack((shell_arg 2)))
            def mergedC:GitPack (GitPackIO.merge(packC1 packC2))
            if (mergedC.ok == false) {
                print ("FAIL " + mergedC.err)
                return
            }
            def shaC:string (shell_arg 3)
            def subC:string ""
            def cacheC:string (shell_arg 4)
            if (n >= 6) {
                subC = (shell_arg 4)
                cacheC = (shell_arg 5)
            }
            def storeC (new GitStore(mergedC))
            def memC:GitMem (storeC.checkout(shaC subC))
            if (storeC.ok == false) {
                print ("FAIL " + storeC.err)
                return
            }
            create_dir cacheC
            def hashC:string (PkgCache.put(memC cacheC))
            if ((strlen hashC) == 0) {
                print "FAIL empty checkout"
                return
            }
            print ("sha256 " + hashC)
            print ("files " + (to_string (array_length memC.files)))
            return
        }
        if (cmd == "install") {
            def manPath5:string (shell_arg 1)
            def parts5:[string] (PkgTool.splitPath(manPath5))
            def src5:string (buffer_to_string ((buffer_read_file (itemAt parts5 0) (itemAt parts5 1))))
            def resv5 (new PackageResolver)
            resv5.loadRoot(src5 (itemAt parts5 0))
            def lock5:PkgLock (resv5.makeLock())
            def dumped:string (PkgManifestIO.dumpLock(lock5))
            def lockBuf:buffer (buffer_from_string dumped)
            buffer_write_file (itemAt parts5 0) "ranger.lock" lockBuf
            print ("wrote " + (itemAt parts5 0) + "/ranger.lock")
            return
        }
        PkgTool.usage()
    }
}

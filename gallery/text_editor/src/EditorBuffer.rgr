; ==============================================================================
; EditorBuffer - multiline text model for the EVG text-editor prototype.
; ==============================================================================
;
; EVG renders the editor; EVG is NOT the text model. This buffer owns document
; state as an array-of-lines (grassator tutorial step 1) so a later piece-table
; / rope swap only touches this file. Positions are (line, col) where col is a
; UTF-16 unit index within the line — caret motion uses EVGCodepoint stepping.
;
; Every mutation goes through replaceRange so undo/redo is a single reverse op.
; ==============================================================================

Import "pkg:evg/EVGCodepoint.rgr"
Import "../../office/text/OfficeCaretMotion.rgr"
Import "EditorStyle.rgr"

class EditorPos {
    def line:int 0
    def col:int 0

    Constructor () {
    }

    sfn create:EditorPos (line:int col:int) {
        def p:EditorPos (new EditorPos)
        p.line = line
        p.col = col
        return p
    }

    fn copyFrom:void (other:EditorPos) {
        line = other.line
        col = other.col
    }

    fn equals:boolean (other:EditorPos) {
        if (line != other.line) {
            return false
        }
        return (col == other.col)
    }
}

class EditorUndoOp {
    def startLine:int 0
    def startCol:int 0
    def endLine:int 0
    def endCol:int 0
    def deleted:string ""
    def inserted:string ""

    Constructor () {
    }
}

class EditorBuffer {
    def lines:[string]
    def lineStyles:[LineStyle]
    def undoStack:[EditorUndoOp]
    def redoStack:[EditorUndoOp]
    def maxUndo:int 200
    def version:int 0
    ; Style applied to newly typed / inserted text (canvas-editor range style).
    def typingBold:boolean false
    def typingFont:string "Open Sans"

    Constructor () {
        push lines ""
        push lineStyles (LineStyle.plain())
    }

    fn styleAt:LineStyle (i:int) {
        if (i < 0) {
            return (LineStyle.plain())
        }
        if (i >= (array_length lineStyles)) {
            return (LineStyle.plain())
        }
        return (itemAt lineStyles i)
    }

    fn ensureStyleCount:void () {
        while ((array_length lineStyles) < (array_length lines)) {
            push lineStyles (LineStyle.plain())
        }
        while ((array_length lineStyles) > (array_length lines)) {
            removeLast lineStyles
        }
        def i:int 0
        while (i < (array_length lines)) {
            def st:LineStyle (itemAt lineStyles i)
            st.syncLen((strlen (itemAt lines i)))
            i = (i + 1)
        }
    }

    ; Build runs for plain text using the current typing style.
    fn runsForText:LineStyle (text:string inheritAlign:int inheritList:int) {
        def st:LineStyle (new LineStyle)
        clear st.runs
        st.align = inheritAlign
        st.listKind = inheritList
        def n:int (strlen text)
        if (n == 0) {
            push st.runs (StyleRun.create(typingBold typingFont 0))
        } {
            push st.runs (StyleRun.create(typingBold typingFont n))
        }
        return st
    }

    fn lineCount:int () {
        return (array_length lines)
    }

    fn lineAt:string (i:int) {
        if (i < 0) {
            return ""
        }
        if (i >= (array_length lines)) {
            return ""
        }
        return (itemAt lines i)
    }

    fn clampPos:void (p:EditorPos) {
        def n:int (array_length lines)
        if (n <= 0) {
            push lines ""
            n = 1
        }
        if (p.line < 0) {
            p.line = 0
        }
        if (p.line >= n) {
            p.line = (n - 1)
        }
        def len:int (strlen (itemAt lines p.line))
        if (p.col < 0) {
            p.col = 0
        }
        if (p.col > len) {
            p.col = len
        }
    }

    fn cmpPos:int (aLine:int aCol:int bLine:int bCol:int) {
        if (aLine < bLine) {
            return -1
        }
        if (aLine > bLine) {
            return 1
        }
        if (aCol < bCol) {
            return -1
        }
        if (aCol > bCol) {
            return 1
        }
        return 0
    }

    fn setText:void (s:string) {
        clear lines
        clear lineStyles
        def start:int 0
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            if ((charAt s i) == 10) {
                def piece:string (substring s start i)
                push lines piece
                push lineStyles (this.runsForText(piece 0 0))
                start = (i + 1)
            }
            i = (i + 1)
        }
        def last:string (substring s start n)
        push lines last
        push lineStyles (this.runsForText(last 0 0))
        clear undoStack
        clear redoStack
        version = (version + 1)
    }

    fn getText:string () {
        return (join lines "\n")
    }

    fn charCount:int () {
        def n:int 0
        def i:int 0
        def lc:int (array_length lines)
        while (i < lc) {
            n = (n + (strlen (itemAt lines i)))
            if (i < (lc - 1)) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; Extract text from [start..end) as a single string with newlines.
    fn textInRange:string (startLine:int startCol:int endLine:int endCol:int) {
        def aLine:int startLine
        def aCol:int startCol
        def bLine:int endLine
        def bCol:int endCol
        if ((this.cmpPos(aLine aCol bLine bCol)) > 0) {
            aLine = endLine
            aCol = endCol
            bLine = startLine
            bCol = startCol
        }
        if (aLine == bLine) {
            def line:string (this.lineAt(aLine))
            def len:int (strlen line)
            if (aCol < 0) {
                aCol = 0
            }
            if (bCol > len) {
                bCol = len
            }
            if (aCol > bCol) {
                aCol = bCol
            }
            return (substring line aCol bCol)
        }
        def out:string ""
        def first:string (this.lineAt(aLine))
        def flen:int (strlen first)
        if (aCol < 0) {
            aCol = 0
        }
        if (aCol > flen) {
            aCol = flen
        }
        out = (substring first aCol flen)
        out = (out + "\n")
        def mid:int (aLine + 1)
        while (mid < bLine) {
            out = (out + (this.lineAt(mid)))
            out = (out + "\n")
            mid = (mid + 1)
        }
        def last:string (this.lineAt(bLine))
        def llen:int (strlen last)
        if (bCol < 0) {
            bCol = 0
        }
        if (bCol > llen) {
            bCol = llen
        }
        out = (out + (substring last 0 bCol))
        return out
    }

    fn pushUndo:void (op:EditorUndoOp) {
        push undoStack op
        while ((array_length undoStack) > maxUndo) {
            remove_index undoStack 0
        }
        clear redoStack
    }

    ; Replace [start..end) with `text`. Returns the caret position after the insert.
    fn replaceRange:EditorPos (startLine:int startCol:int endLine:int endCol:int text:string recordUndo:boolean) {
        this.ensureStyleCount()
        def aLine:int startLine
        def aCol:int startCol
        def bLine:int endLine
        def bCol:int endCol
        if ((this.cmpPos(aLine aCol bLine bCol)) > 0) {
            aLine = endLine
            aCol = endCol
            bLine = startLine
            bCol = startCol
        }
        def sp:EditorPos (EditorPos.create(aLine aCol))
        def ep:EditorPos (EditorPos.create(bLine bCol))
        this.clampPos(sp)
        this.clampPos(ep)
        aLine = sp.line
        aCol = sp.col
        bLine = ep.line
        bCol = ep.col

        def deleted:string (this.textInRange(aLine aCol bLine bCol))

        ; Style fragments around the edit (canvas-editor spliceElementList analogue).
        def headStyle:LineStyle ((this.styleAt(aLine)).slice(0 aCol))
        def tailStyle:LineStyle ((this.styleAt(bLine)).slice(bCol (strlen (this.lineAt(bLine)))))
        def keepAlign:int (this.styleAt(aLine)).align
        def keepList:int (this.styleAt(aLine)).listKind

        ; Build the new line content around the replacement.
        def beforeLine:string (this.lineAt(aLine))
        def afterLine:string (this.lineAt(bLine))
        def before:string (substring beforeLine 0 aCol)
        def after:string (substring afterLine bCol (strlen afterLine))
        def merged:string (before + text + after)

        ; Remove lines aLine..bLine inclusive, then insert split(merged).
        def removeCount:int ((bLine - aLine) + 1)
        def ri:int 0
        while (ri < removeCount) {
            remove_index lines aLine
            remove_index lineStyles aLine
            ri = (ri + 1)
        }

        def start:int 0
        def i:int 0
        def n:int (strlen merged)
        def insertAt:int aLine
        def parts:int 0
        def textParts:[string]
        def tStart:int 0
        def ti:int 0
        def tlen:int (strlen text)
        while (ti < tlen) {
            if ((charAt text ti) == 10) {
                push textParts (substring text tStart ti)
                tStart = (ti + 1)
            }
            ti = (ti + 1)
        }
        push textParts (substring text tStart tlen)
        def partCount:int (array_length textParts)

        while (i < n) {
            if ((charAt merged i) == 10) {
                insert lines insertAt (substring merged start i)
                insertAt = (insertAt + 1)
                parts = (parts + 1)
                start = (i + 1)
            }
            i = (i + 1)
        }
        insert lines insertAt (substring merged start n)
        parts = (parts + 1)

        if ((array_length lines) == 0) {
            push lines ""
            parts = 1
        }

        ; Rebuild styles for inserted lines.
        def newStyles:[LineStyle]
        if (partCount == 1) {
            def one:LineStyle (new LineStyle)
            clear one.runs
            one.align = keepAlign
            one.listKind = keepList
            one.concatRuns(headStyle)
            one.appendRun(typingBold typingFont (strlen (itemAt textParts 0)))
            one.concatRuns(tailStyle)
            if ((array_length one.runs) == 0) {
                push one.runs (StyleRun.create(typingBold typingFont 0))
            }
            one.mergeAdjacent()
            push newStyles one
        } {
            def first:LineStyle (new LineStyle)
            clear first.runs
            first.align = keepAlign
            first.listKind = keepList
            first.concatRuns(headStyle)
            first.appendRun(typingBold typingFont (strlen (itemAt textParts 0)))
            if ((array_length first.runs) == 0) {
                push first.runs (StyleRun.create(typingBold typingFont 0))
            }
            first.mergeAdjacent()
            push newStyles first
            def mid:int 1
            while (mid < (partCount - 1)) {
                def midSt:LineStyle (this.runsForText((itemAt textParts mid) 0 0))
                push newStyles midSt
                mid = (mid + 1)
            }
            def lastSt:LineStyle (new LineStyle)
            clear lastSt.runs
            lastSt.align = 0
            lastSt.listKind = 0
            lastSt.appendRun(typingBold typingFont (strlen (itemAt textParts (partCount - 1))))
            lastSt.concatRuns(tailStyle)
            if ((array_length lastSt.runs) == 0) {
                push lastSt.runs (StyleRun.create(typingBold typingFont 0))
            }
            lastSt.mergeAdjacent()
            push newStyles lastSt
        }
        def si:int 0
        while (si < (array_length newStyles)) {
            insert lineStyles (aLine + si) (itemAt newStyles si)
            si = (si + 1)
        }
        this.ensureStyleCount()

        ; Caret sits at the end of the inserted text.
        def caretLine:int aLine
        def caretCol:int 0
        def tix:int 0
        def curLine:int aLine
        def curCol:int aCol
        while (tix < tlen) {
            if ((charAt text tix) == 10) {
                curLine = (curLine + 1)
                curCol = 0
            } {
                curCol = (curCol + 1)
            }
            tix = (tix + 1)
        }
        caretLine = curLine
        caretCol = curCol

        if recordUndo {
            def op:EditorUndoOp (new EditorUndoOp)
            op.startLine = aLine
            op.startCol = aCol
            op.endLine = caretLine
            op.endCol = caretCol
            op.deleted = deleted
            op.inserted = text
            this.pushUndo(op)
        }

        version = (version + 1)
        return (EditorPos.create(caretLine caretCol))
    }

    fn insertText:EditorPos (line:int col:int text:string) {
        return (this.replaceRange(line col line col text true))
    }

    fn deleteRange:EditorPos (startLine:int startCol:int endLine:int endCol:int) {
        return (this.replaceRange(startLine startCol endLine endCol "" true))
    }

    ; Step caret left/right by one codepoint (UTF-16 aware).
    fn moveCodepoint:EditorPos (line:int col:int dir:int) {
        def p:EditorPos (EditorPos.create(line col))
        this.clampPos(p)
        if (dir < 0) {
            if (p.col > 0) {
                ; The step back is `OfficeCaretMotion`'s, shared with the
                ; slide, document and markdown editors. It was a third copy of
                ; the surrogate rule; the .docx editor was the one that did not
                ; have it at all.
                p.col = (OfficeCaretMotion.stepBack((this.lineAt(p.line)) p.col))
                return p
            }
            if (p.line > 0) {
                p.line = (p.line - 1)
                p.col = (strlen (this.lineAt(p.line)))
            }
            return p
        }
        def s2:string (this.lineAt(p.line))
        def len:int (strlen s2)
        if (p.col < len) {
            p.col = (OfficeCaretMotion.stepForward(s2 p.col))
            return p
        }
        if (p.line < ((array_length lines) - 1)) {
            p.line = (p.line + 1)
            p.col = 0
        }
        return p
    }

    ; Advance a position by walking `text` (newlines + UTF-16 units).
    fn posAfter:EditorPos (line:int col:int text:string) {
        def curLine:int line
        def curCol:int col
        def i:int 0
        def n:int (strlen text)
        while (i < n) {
            if ((charAt text i) == 10) {
                curLine = (curLine + 1)
                curCol = 0
                i = (i + 1)
            } {
                curCol = (curCol + 1)
                i = (i + 1)
            }
        }
        return (EditorPos.create(curLine curCol))
    }

    fn undo:EditorPos () {
        def n:int (array_length undoStack)
        if (n <= 0) {
            return (EditorPos.create(0 0))
        }
        def op:EditorUndoOp (itemAt undoStack (n - 1))
        removeLast undoStack
        ; Reverse: remove inserted, put deleted back.
        def after:EditorPos (this.replaceRange(op.startLine op.startCol op.endLine op.endCol op.deleted false))
        push redoStack op
        if ((strlen op.deleted) == 0) {
            return (EditorPos.create(op.startLine op.startCol))
        }
        return after
    }

    fn redo:EditorPos () {
        def n:int (array_length redoStack)
        if (n <= 0) {
            return (EditorPos.create(0 0))
        }
        def op:EditorUndoOp (itemAt redoStack (n - 1))
        removeLast redoStack
        ; After undo, `deleted` sits at start — replace that span with `inserted`.
        def endDel:EditorPos (this.posAfter(op.startLine op.startCol op.deleted))
        def after:EditorPos (this.replaceRange(op.startLine op.startCol endDel.line endDel.col op.inserted false))
        def u:EditorUndoOp (new EditorUndoOp)
        u.startLine = op.startLine
        u.startCol = op.startCol
        u.endLine = after.line
        u.endCol = after.col
        u.deleted = op.deleted
        u.inserted = op.inserted
        push undoStack u
        return after
    }

    ; --- rich style (canvas-editor executeBold / executeFont / rowFlex / list) ---

    fn applyInlineStyle:void (startLine:int startCol:int endLine:int endCol:int boldSet:boolean boldVal:boolean fontSet:boolean fontVal:string) {
        this.ensureStyleCount()
        def aLine:int startLine
        def aCol:int startCol
        def bLine:int endLine
        def bCol:int endCol
        if ((this.cmpPos(aLine aCol bLine bCol)) > 0) {
            aLine = endLine
            aCol = endCol
            bLine = startLine
            bCol = startCol
        }
        def line:int aLine
        while (line <= bLine) {
            def s:string (this.lineAt(line))
            def len:int (strlen s)
            def c0:int 0
            def c1:int len
            if (line == aLine) {
                c0 = aCol
            }
            if (line == bLine) {
                c1 = bCol
            }
            if (c0 < 0) {
                c0 = 0
            }
            if (c1 > len) {
                c1 = len
            }
            if (c1 > c0) {
                def st:LineStyle (this.styleAt(line))
                def left:LineStyle (st.slice(0 c0))
                def mid:LineStyle (st.slice(c0 c1))
                def right:LineStyle (st.slice(c1 len))
                def mi:int 0
                while (mi < (array_length mid.runs)) {
                    def r:StyleRun (itemAt mid.runs mi)
                    if boldSet {
                        r.bold = boldVal
                    }
                    if fontSet {
                        r.font = fontVal
                    }
                    mi = (mi + 1)
                }
                def rebuilt:LineStyle (new LineStyle)
                clear rebuilt.runs
                rebuilt.align = st.align
                rebuilt.listKind = st.listKind
                rebuilt.concatRuns(left)
                rebuilt.concatRuns(mid)
                rebuilt.concatRuns(right)
                if ((array_length rebuilt.runs) == 0) {
                    push rebuilt.runs (StyleRun.create(typingBold typingFont 0))
                }
                rebuilt.mergeAdjacent()
                set lineStyles line rebuilt
            }
            line = (line + 1)
        }
        version = (version + 1)
    }

    fn setBlockAlign:void (startLine:int endLine:int align:int) {
        this.ensureStyleCount()
        def a:int startLine
        def b:int endLine
        if (a > b) {
            def t:int a
            a = b
            b = t
        }
        if (a < 0) {
            a = 0
        }
        def maxL:int ((this.lineCount()) - 1)
        if (b > maxL) {
            b = maxL
        }
        def i:int a
        while (i <= b) {
            def st:LineStyle (this.styleAt(i))
            st.align = align
            i = (i + 1)
        }
        version = (version + 1)
    }

    fn setBlockList:void (startLine:int endLine:int listKind:int) {
        this.ensureStyleCount()
        def a:int startLine
        def b:int endLine
        if (a > b) {
            def t:int a
            a = b
            b = t
        }
        if (a < 0) {
            a = 0
        }
        def maxL:int ((this.lineCount()) - 1)
        if (b > maxL) {
            b = maxL
        }
        def i:int a
        while (i <= b) {
            def st:LineStyle (this.styleAt(i))
            st.listKind = listKind
            i = (i + 1)
        }
        version = (version + 1)
    }

    ; Ordered-list index for a line (1-based within a contiguous ol run).
    fn listNumber:int (line:int) {
        def st:LineStyle (this.styleAt(line))
        if (st.listKind != 2) {
            return 0
        }
        def n:int 1
        def i:int (line - 1)
        while (i >= 0) {
            def prev:LineStyle (this.styleAt(i))
            if (prev.listKind != 2) {
                return n
            }
            n = (n + 1)
            i = (i - 1)
        }
        return n
    }

    ; --- edits made elsewhere ---------------------------------------------------
    ; In real-time editing a colleague's edit arrives while this buffer is
    ; being typed in. It goes in as a replace that is not an undo step of this
    ; person's, and the undo and redo steps are moved over it, so Ctrl+Z still
    ; takes back this person's own last edit and nobody else's. A step the
    ; colleague edited inside (their edit overlaps the text the step would
    ; change) cannot be taken back exactly any more: it and the steps older
    ; than it are dropped, never applied wrong.

    ; the text as one string offset (UTF-16 units, a newline counts one)
    fn offsetOf:int (line:int col:int) {
        def p:EditorPos (EditorPos.create(line col))
        this.clampPos(p)
        def off:int 0
        def i:int 0
        while (i < p.line) {
            off = ((off + (strlen (itemAt lines i))) + 1)
            i = (i + 1)
        }
        return (off + p.col)
    }

    ; the position of a text offset (held inside the text)
    fn posAt:EditorPos (offset:int) {
        def left:int offset
        if (left < 0) {
            left = 0
        }
        def n:int (array_length lines)
        def i:int 0
        while (i < n) {
            def len:int (strlen (itemAt lines i))
            if ((left <= len) || (i == (n - 1))) {
                if (left > len) {
                    left = len
                }
                return (EditorPos.create(i left))
            }
            left = (left - (len + 1))
            i = (i + 1)
        }
        return (EditorPos.create(0 0))
    }

    sfn order:int (aLine:int aCol:int bLine:int bCol:int) {
        if (aLine != bLine) {
            if (aLine < bLine) {
                return -1
            }
            return 1
        }
        if (aCol < bCol) {
            return -1
        }
        if (aCol > bCol) {
            return 1
        }
        return 0
    }

    ; where `text` ends when written from (line, col)
    sfn walk:EditorPos (line:int col:int text:string) {
        def l:int line
        def c:int col
        def i:int 0
        def n:int (strlen text)
        while (i < n) {
            if ((charAt text i) == 10) {
                l = (l + 1)
                c = 0
            } {
                c = (c + 1)
            }
            i = (i + 1)
        }
        return (EditorPos.create(l c))
    }

    ; where position p is after [x0, x1) was replaced by `text`. A position
    ; inside the replaced text goes to its start. `tieAfter`: at the place of
    ; a pure insert, the position goes after the inserted text.
    sfn mapPos:EditorPos (p:EditorPos x0:EditorPos x1:EditorPos text:string tieAfter:boolean) {
        def c0:int (EditorBuffer.order(p.line p.col x0.line x0.col))
        if (c0 < 0) {
            return (EditorPos.create(p.line p.col))
        }
        def empty:boolean ((EditorBuffer.order(x0.line x0.col x1.line x1.col)) == 0)
        if (c0 == 0) {
            if ((empty == false) || (tieAfter == false)) {
                return (EditorPos.create(p.line p.col))
            }
        }
        if ((EditorBuffer.order(p.line p.col x1.line x1.col)) < 0) {
            return (EditorPos.create(x0.line x0.col))
        }
        def end:EditorPos (EditorBuffer.walk(x0.line x0.col text))
        if (p.line == x1.line) {
            return (EditorPos.create(end.line (end.col + (p.col - x1.col))))
        }
        return (EditorPos.create((p.line + (end.line - x1.line)) p.col))
    }

    ; do [a0, a1) and [x0, x1) touch text both would change
    sfn overlaps:boolean (a0:EditorPos a1:EditorPos x0:EditorPos x1:EditorPos) {
        def aEmpty:boolean ((EditorBuffer.order(a0.line a0.col a1.line a1.col)) == 0)
        def xEmpty:boolean ((EditorBuffer.order(x0.line x0.col x1.line x1.col)) == 0)
        def xa1:int (EditorBuffer.order(x0.line x0.col a1.line a1.col))
        def ax1:int (EditorBuffer.order(a0.line a0.col x1.line x1.col))
        def ax0:int (EditorBuffer.order(a0.line a0.col x0.line x0.col))
        if (aEmpty && xEmpty) {
            return false
        }
        if (xEmpty) {
            return ((ax0 < 0) && (xa1 < 0))
        }
        if (aEmpty) {
            return ((ax0 > 0) && (ax1 < 0))
        }
        return ((xa1 < 0) && (ax1 < 0))
    }

    ; the steps of one stack (top last) moved over the replace [x0, x1) ->
    ; text, made on the text the top step applies to
    fn rebaseStack:void (stack:[EditorUndoOp] isUndo:boolean x0In:EditorPos x1In:EditorPos textIn:string) {
        def x0:EditorPos (EditorPos.create(x0In.line x0In.col))
        def x1:EditorPos (EditorPos.create(x1In.line x1In.col))
        def text:string textIn
        def k:int ((array_length stack) - 1)
        while (k >= 0) {
            def e:EditorUndoOp (itemAt stack k)
            ; the step as a replace: undo puts `deleted` over what it
            ; inserted, redo puts `inserted` back over `deleted`
            def a0:EditorPos (EditorPos.create(e.startLine e.startCol))
            def a1:EditorPos (EditorPos.create(e.endLine e.endCol))
            def put:string e.deleted
            if (isUndo == false) {
                a1 = (EditorBuffer.walk(e.startLine e.startCol e.deleted))
                put = e.inserted
            }
            if (EditorBuffer.overlaps(a0 a1 x0 x1)) {
                ; this step and the older ones go
                def j:int 0
                while (j <= k) {
                    remove_index stack 0
                    j = (j + 1)
                }
                return
            }
            def aEmpty:boolean ((EditorBuffer.order(a0.line a0.col a1.line a1.col)) == 0)
            def xEmpty:boolean ((EditorBuffer.order(x0.line x0.col x1.line x1.col)) == 0)
            ; the step after the colleague's edit
            def na0:EditorPos (EditorBuffer.mapPos(a0 x0 x1 text true))
            def na1:EditorPos na0
            if (aEmpty == false) {
                na1 = (EditorBuffer.mapPos(a1 x0 x1 text false))
            }
            ; the colleague's edit after the step (for the steps below it)
            def tie:boolean ((aEmpty && (xEmpty == false)) && ((EditorBuffer.order(a0.line a0.col x0.line x0.col)) == 0))
            def nx0:EditorPos (EditorBuffer.mapPos(x0 a0 a1 put tie))
            def nx1:EditorPos nx0
            if (xEmpty == false) {
                nx1 = (EditorBuffer.mapPos(x1 a0 a1 put false))
            }
            e.startLine = na0.line
            e.startCol = na0.col
            if isUndo {
                e.endLine = na1.line
                e.endCol = na1.col
            }
            x0 = nx0
            x1 = nx1
            k = (k - 1)
        }
    }

    ; a colleague's replace of [start, end) with `text`
    fn applyRemote:void (startLine:int startCol:int endLine:int endCol:int text:string) {
        def sp:EditorPos (EditorPos.create(startLine startCol))
        def ep:EditorPos (EditorPos.create(endLine endCol))
        this.clampPos(sp)
        this.clampPos(ep)
        if ((EditorBuffer.order(sp.line sp.col ep.line ep.col)) > 0) {
            def t:EditorPos sp
            sp = ep
            ep = t
        }
        this.rebaseStack(undoStack true sp ep text)
        this.rebaseStack(redoStack false sp ep text)
        this.replaceRange(sp.line sp.col ep.line ep.col text false)
    }
}

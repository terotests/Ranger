            }
        }
        if (dual) {
            if ((p2.done == 0)) {
                p2 = (this.checkFinish(p2 2 events))
                if ((p2.done == 1)) {
                    summitMusicStarted = (to_double (this.tryStartSummitMusic((to_int summitMusicStarted) events)))
                }
            }
        }
        def cameraY:int ((this.computeCamera(p1 p2 dual)))
        def entities:[string:EntityPoseNative] ((this.placeEntities({} cameraY slots)))
        def patch:NativeGameState (new NativeGameState)
        patch.showNet = 0
        set patch.numbers "playerSlots" (to_double slots)
        set patch.numbers "cameraY" (to_double cameraY)
        patch.entities = entities
        st_p1 = p1
        st_p2 = p2
        st_enemies = enemies
        st_fruits = fruits
        st_diamonds = diamonds
        st_bullets = bullets
        st_movingPlatforms = movingPlatforms
        patch.score1 = score1
        patch.score2 = score2
        set patch.numbers "fireCd1" fireCd1
        set patch.numbers "fireCd2" fireCd2
        set patch.numbers "summitMusicStarted" summitMusicStarted
        set patch.numbers "event" event
        return patch
    }

}

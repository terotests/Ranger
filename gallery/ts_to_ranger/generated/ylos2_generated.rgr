class GeneratedGameScript {
    def host:GameEngineHost (new GameEngineHost)
    def st_p1:PlayerNative (new PlayerNative)
    def st_p2:PlayerNative (new PlayerNative)
    def st_enemies:[EnemyNative]
    def st_fruits:[CollectibleNative]
    def st_diamonds:[CollectibleNative]
    def st_bullets:[BulletNative]
    def st_movingPlatforms:[MovingPlatformNative]

    fn worldW:int () {
        return host.bgWidth
    }

    fn isSplitPane:boolean () {
        return (host.paneIndex >= 0)
    }

    fn isDualMode:boolean () {
        if ((this.isSplitPane())) {
            return false
        }
        return ((this.worldW()) > 300)
    }

    fn playerSlots:int () {
        if ((this.isDualMode())) {
            return 2
        }
        return 1
    }


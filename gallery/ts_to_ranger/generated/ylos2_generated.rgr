class GeneratedGameScript {
    def host:GameEngineHost (new GameEngineHost)
    def st_p1:makePlayerOnFloorRetNative (new makePlayerOnFloorRetNative)
    def st_p2:makePlayerOnFloorRetNative (new makePlayerOnFloorRetNative)
    def st_enemies:[makeEnemies_outRetNative]
    def st_fruits:[makeFruits_outRetNative]
    def st_diamonds:[makeDiamonds_outRetNative]
    def st_bullets:[makeBullets_outRetNative]
    def st_movingPlatforms:[makeMovingPlatforms_outRetNative]

    fn worldW:int () {
        return host.bgWidth
    }

    fn isSplitPane:boolean () {
        return (host.paneIndex >= 0)
    }

    fn isDualMode:boolean () {
        if ((this.isSplitPane())) {
            return false
        }
        return ((this.worldW()) > 300)
    }

    fn playerSlots:int () {
        if ((this.isDualMode())) {
            return 2
        }
        return 1
    }

    fn localPlayerSlot:int () {
        if ((this.isSplitPane())) {
            if ((host.paneIndex == 1)) {
                return 2
            }
            return 1
        }

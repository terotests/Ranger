class GeneratedGameScript {
    def host:GameEngineHost (new GameEngineHost)
    def st_p1:PlayerNative (new PlayerNative)
    def st_p2:PlayerNative (new PlayerNative)
    def st_enemies:[EnemyNative]
    def st_fruits:[CollectibleNative]
    def st_diamonds:[CollectibleNative]
    def st_bullets:[BulletNative]
    def st_movingPlatforms:[MovingPlatformNative]

    fn worldW:int () {
        return host.bgWidth
    }

    fn isSplitPane:boolean () {
        return (host.paneIndex >= 0)
    }

    fn isDualMode:boolean () {
        if ((this.isSplitPane())) {
            return false
        }
        return ((this.worldW()) > 300)
    }

    fn playerSlots:int () {
        if ((this.isDualMode())) {
            return 2
        }
        return 1
    }

    fn localPlayerSlot:int () {
        if ((this.isSplitPane())) {
            if ((host.paneIndex == 1)) {
                return 2
            }
            return 1
        }
        return 1
    }

    fn localPlayerEntityId:string () {
        if (((this.localPlayerSlot()) == 2)) {
            return "p2"
        }
        return "p1"
    }

    fn localSuperEntityId:string () {
        if (((this.localPlayerSlot()) == 2)) {
            return "p2s"
        }
        return "p1s"
    }

    fn localStartX:int () {
        def _mod:Ylos2GameModule (Ylos2GameModule.__singleton())
        if (((this.localPlayerSlot()) == 2)) {
            return _mod.P2_START_X
        }
        return _mod.P1_START_X
    }

    fn localStartFace:int () {
        if (((this.localPlayerSlot()) == 2)) {
            return (0 - 1)
        }

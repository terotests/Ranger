                            tmp147.animTick = p2.animTick
                            tmp147.jumpHold = p2.jumpHold
                            tmp147.airJump = p2.airJump
                            tmp147.jumpBoostMs = p2.jumpBoostMs
                            tmp147.superMs = _mod.SUPER_MS
                            tmp147.done = p2.done
                            tmp147.finishMs = p2.finishMs
                            tmp147.finishPulseMs = p2.finishPulseMs
                            tmp147.celebrateBursts = p2.celebrateBursts
                            p2 = tmp147
                            def be148:GameEventNative (new GameEventNative)
                            be148.kind = "playSound"
                            be148.id = "win"
                            push events (be148)
                            def be149:GameEventNative (new GameEventNative)
                            be149.kind = "particles"
                            be149.id = "sparkle"
                            be149.x = dd.x
                            be149.y = dd.y
                            be149.amount = 28
                            push events (be149)
                            push events ((this.rumbleForOwner(2 160 28000)))
                        }
                    }
                }
            }
            dk = (dk + 1)
        }
        if ((p1.done == 0)) {
            p1 = (this.checkFinish(p1 owner events))
            if ((p1.done == 1)) {
                summitMusicStarted = (to_double (this.tryStartSummitMusic((to_int summitMusicStarted) events)))
            }
        }
        if (dual) {
            if ((p2.done == 0)) {
                p2 = (this.checkFinish(p2 2 events))
                if ((p2.done == 1)) {
                    summitMusicStarted = (to_double (this.tryStartSummitMusic((to_int summitMusicStarted) events)))
                }
            }
        }
        def cameraY:int ((this.computeCamera(p1 p2 dual)))
        def tmp150:GameSnapshotNative (new GameSnapshotNative)
        tmp150.p1 = p1
        tmp150.p2 = p2
        tmp150.enemies = enemies
        tmp150.fruits = fruits
        tmp150.diamonds = diamonds
        tmp150.bullets = bullets
        tmp150.movingPlatforms = movingPlatforms
        def entities:[string:EntityPoseNative] ((this.placeEntities(tmp150 (to_double cameraY) slots)))
        def patch:NativeGameState (new NativeGameState)
        patch.showNet = 0
        set patch.numbers "playerSlots" (to_double slots)
        set patch.numbers "cameraY" (to_double cameraY)
        patch.entities = entities
        st_p1 = p1
        st_p2 = p2
        st_enemies = enemies
        st_fruits = fruits
        st_diamonds = diamonds
        st_bullets = bullets
        st_movingPlatforms = movingPlatforms
        patch.score1 = score1
        patch.score2 = score2
        set patch.numbers "fireCd1" fireCd1
        set patch.numbers "fireCd2" fireCd2
        set patch.numbers "summitMusicStarted" summitMusicStarted
        set patch.numbers "event" event
        return patch
    }

}

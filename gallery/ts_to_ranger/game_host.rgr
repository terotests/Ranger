; ==============================================================================
; game_host - engine-side bridge for resources and events (shared by both paths).
; ==============================================================================
;
; Design: the reducer model already passes plain JSON-like data between script
; and host. We keep resources and events as DATA so the identical contract works
; in the TS-interpreter path (EvalValue) and the static-compiled path (structs):
;
;   * resources()      - declared once (like sprites()); host registers images,
;                        sounds, sprites (multi-frame animation), collision maps.
;   * state.events[]   - update() returns transient events each frame; the host
;                        drains them (play sound, spawn/destroy, custom).
;
; This file is native Ranger. The interpreter path fills these structs from
; EvalValue; the static path fills them from generated code. Nothing here is
; game-specific.
;
; playSound events route to GameAudio (built-in synth ids) when audio is wired.
; File-based sound resources are still registered for future loaders.
; ==============================================================================

Import "../game_engine/scripting/game_audio.rgr"
Import "../game_engine/scripting/game_soundscore.rgr"

; A declared engine resource. `kind` selects the registry.
class ResourceDefNative {
    def kind:string ""        ; "image" | "sound" | "sprite" | "collision" | "music"
    def id:string ""
    def path:string ""
    def px:int 0              ; sprite pixel scale
    def frameCount:int 0     ; sprite: number of animation frames (levels)
    def w:int 0              ; collision/geometry width
    def h:int 0              ; collision/geometry height
}

; A transient event emitted by update() and drained by the host each frame.
class GameEventNative {
    def kind:string ""        ; "playSound" | "playMusic" | "stopMusic" | "spawn" | "destroy" | custom
    def id:string ""
    def x:double 0.0
    def y:double 0.0
    def amount:int 0
    def text:string ""        ; inline soundscore text for playMusic
}

; Engine-side registry + event sink. Both runners own one GameHost.
class GameHost {
    def images:[string:string]
    def sounds:[string:string]
    def spriteFrames:[string:int]
    def collisions:[string:boolean]
    def soundsPlayed:[string]
    def spawnRequests:[GameEventNative]
    def destroyRequests:[string]
    def eventCount:int 0
    def verbose:boolean false
    def audio@(optional):GameAudio
    def music:SoundScorePlayer (new SoundScorePlayer)
    def musicPaths:[string:string]
    def musicTexts:[string:string]
    def musicDir:string ""

    fn wireMusic:void () {
        if audio {
            music.audio = (unwrap audio)
        }
    }

    fn joinPath:string (dir:string file:string) {
        if ((strlen dir) == 0) {
            return file
        }
        def last:int (strlen dir)
        last = (last - 1)
        def tail:string (substring dir last (last + 1))
        if (tail == "/") {
            return (dir + file)
        }
        return (dir + "/" + file)
    }

    fn resolveMusicScore:string (id:string) {
        def cached@(optional):string (get musicTexts id)
        if (!null? cached) {
            return (unwrap cached)
        }
        def path@(optional):string (get musicPaths id)
        if (null? path) {
            return ""
        }
        def full:string (this.joinPath(musicDir (unwrap path)))
        def slash:int -1
        def i 0
        while (i < (strlen full)) {
            def ch:string (substring full i (i + 1))
            if (ch == "/") {
                slash = i
            }
            i = (i + 1)
        }
        if (slash < 0) {
            return ""
        }
        def dir:string (substring full 0 slash)
        def file:string (substring full (slash + 1) (strlen full))
        def buf:buffer (buffer_read_file dir file)
        def txt:string (buffer_to_string buf)
        set musicTexts id txt
        return txt
    }

    fn startMusic:void (scoreText:string loopScore:boolean) {
        if (null? audio) {
            return
        }
        this.wireMusic()
        music.load(scoreText)
        music.play(loopScore)
    }

    fn stopMusic:void () {
        music.stop()
    }

    fn tickMusic:void (dtMs:int) {
        if audio {
            this.wireMusic()
            music.tick(dtMs)
        }
    }

    fn registerResource:void (r:ResourceDefNative) {
        if (r.kind == "image") {
            set images r.id r.path
            if verbose { print ("[host] image " + r.id) }
            return
        }
        if (r.kind == "sound") {
            set sounds r.id r.path
            if verbose { print ("[host] sound " + r.id) }
            return
        }
        if (r.kind == "sprite") {
            set spriteFrames r.id r.frameCount
            if verbose { print ("[host] sprite " + r.id) }
            return
        }
        if (r.kind == "collision") {
            set collisions r.id true
            if verbose { print ("[host] collision " + r.id) }
            return
        }
        if (r.kind == "music") {
            set musicPaths r.id r.path
            if verbose { print ("[host] music " + r.id) }
            return
        }
    }

    fn registerResources:void (list:[ResourceDefNative]) {
        def i 0
        while (i < (array_length list)) {
            this.registerResource((itemAt list i))
            i = (i + 1)
        }
    }

    fn handleEvent:void (e:GameEventNative) {
        eventCount = (eventCount + 1)
        if (e.kind == "playSound") {
            push soundsPlayed e.id
            if audio {
                def a:GameAudio (unwrap audio)
                if (a.hasBuiltin(e.id)) {
                    a.play(e.id)
                } {
                    if verbose { print ("[host] playSound (no builtin) " + e.id) }
                }
            }
            if verbose { print ("[host] playSound " + e.id) }
            return
        }
        if (e.kind == "playMusic") {
            def scoreText:string e.text
            if ((strlen scoreText) == 0) {
                scoreText = (this.resolveMusicScore(e.id))
            }
            if ((strlen scoreText) > 0) {
                def loopScore:boolean true
                if (e.amount == 0) {
                    loopScore = false
                }
                this.startMusic(scoreText loopScore)
            } {
                if verbose { print ("[host] playMusic (missing score) " + e.id) }
            }
            if verbose { print ("[host] playMusic " + e.id) }
            return
        }
        if (e.kind == "stopMusic") {
            this.stopMusic()
            if verbose { print "[host] stopMusic" }
            return
        }
        if (e.kind == "spawn") {
            push spawnRequests e
            if verbose { print ("[host] spawn " + e.id) }
            return
        }
        if (e.kind == "destroy") {
            push destroyRequests e.id
            if verbose { print ("[host] destroy " + e.id) }
            return
        }
        ; custom events are counted; hosts may inspect via subclass hooks later.
    }

    fn drainEvents:void (list:[GameEventNative]) {
        def i 0
        while (i < (array_length list)) {
            this.handleEvent((itemAt list i))
            i = (i + 1)
        }
    }

    fn imageCount:int () {
        return (array_length (keys images))
    }

    fn soundCount:int () {
        return (array_length (keys sounds))
    }

    fn spriteCount:int () {
        return (array_length (keys spriteFrames))
    }

    fn collisionCount:int () {
        return (array_length (keys collisions))
    }

    fn hasImage:boolean (id:string) {
        def v@(optional):string (get images id)
        return (!null? v)
    }

    fn hasSound:boolean (id:string) {
        def v@(optional):string (get sounds id)
        return (!null? v)
    }

    fn soundPlayCount:int () {
        return (array_length soundsPlayed)
    }
}

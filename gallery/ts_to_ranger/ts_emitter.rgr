; ==============================================================================
; TSEmitter - TS AST (TSNode) -> Ranger source for game scripts.
; ==============================================================================
;
; Architecture: TypeScript is read at *emitter runtime* (this tool) and the
; produced Ranger is compiled *statically* into the native game binary. The
; emitter is therefore type-aware: it must produce Ranger that the compiler
; accepts without int/double coercion errors.
;
; PoC subset: function decls, const/let, if, return, literals, member access,
; binary/unary ops, object/array literals used by *.game.tsx retained-mode games.
; Does NOT emit JSX/hud() (native path uses game_hud separately).
; ==============================================================================

Import "../ts_parser/ts_parser_simple.rgr"

class TSEmitter {
    def output:string ""
    def indentLevel:int 0
    def indentStr:string "    "
    def currentFn:string ""
    def inSpritesFn:boolean false
    def inInitFn:boolean false
    def inUpdateFn:boolean false
    def inResourcesFn:boolean false
    def varTypes:[string:string]
    def stateVarName:string "s"
    def readEntityIds:[string]
    def readEntitySeen:[string:boolean]
    def readPlayerIndices:[string]
    def readPlayerSeen:[string:boolean]
    def inputVarName:string "input"
    ; Helper-function signature registry (prepass over the program).
    def fnReturnTypes:[string:string]
    def fnParamTypesCsv:[string:string]
    def isHelperFn:[string:boolean]
    ; Module-level const registries.
    def constScalarTypes:[string:string]
    def constScalarValues:[string:string]
    def constArrayNames:[string:boolean]
    def constArrayElemType:[string:string]
    ; Interface/struct registry: name -> csv of "field:type" pairs.
    def interfaceFieldsCsv:[string:string]
    def interfaceNames:[string]
    ; State fields that hold script-owned arrays -> stored in state.intArrays.
    def stateArrayFieldType:[string:string]
    ; State fields holding rich objects / arrays-of-structs. These can't live in
    ; the generic NativeGameState maps (heterogeneous static types), so they are
    ; kept as fields on the persistent GeneratedGameScript instance and read/
    ; written directly (name -> Ranger type, e.g. "makePlayerRetNative" or
    ; "[enemiesElemNative]").
    def objectStateFieldType:[string:string]
    def objectStateFieldOrder:[string]
    ; Function whose body is currently being scanned/emitted, used to name
    ; struct types synthesized from `local.push({...})` (stable across passes).
    def inferFnName:string ""
    ; Per-statement hoist of `X[i]` computed accesses that are field-access
    ; receivers: Ranger rejects `(itemAt a i).field`, so bind to a typed local
    ; first. Map raw `(itemAt base idx)` string -> local name.
    def hoistedItemAt:[string:string]
    def itemAtCounter:int 0
    ; initState body `const foo = makeFoo()` names -> array type (prescan only).
    def initStateLocalTypes:[string:string]
    def tmpCounter:int 0
    ; Synthesized struct interface names (fnName + "Ret") already registered.
    def synthStructDone:[string:boolean]
    ; Per-module @singleton(true) holder for module-level const tables (one per .tsx).
    def moduleSingletonClass:string ""
    def moduleIdRaw:string ""
    def moduleConstDeferred:[string:boolean]
    def inModuleSingletonCtor:boolean false
    ; Block currently being emitted (for empty-array element-type inference).
    def currentEmitBlock:TSNode (new TSNode())

    ; ==========================================================================
    ; TS type annotation -> Ranger type
    ; ==========================================================================

    ; Extract the Ranger type string from a param/var/return typeAnnotation.
    fn annotType:string (annot:TSNode) {
        def node:TSNode annot
        if (annot.nodeType == "TSTypeAnnotation") {
            if (annot.typeAnnotation) {
                node = (unwrap annot.typeAnnotation)
            }
        }
        return (this.typeNodeToRanger(node))
    }

    fn typeNodeToRanger:string (node:TSNode) {
        def t:string node.nodeType
        if (t == "TSNumberKeyword") {
            return "double"
        }
        if (t == "TSStringKeyword") {
            return "string"
        }
        if (t == "TSBooleanKeyword") {
            return "boolean"
        }
        if (t == "TSArrayType") {
            def elem:string "double"
            if (node.left) {
                elem = (this.typeNodeToRanger((unwrap node.left)))
            }
            return ("[" + elem) + "]"
        }
        if (t == "TSTypeReference") {
            return (this.typeRefToRanger(node.name))
        }
        return "int"
    }

    ; Named TS types -> Ranger. `int`/`float` are game-dialect aliases for
    ; number (declared in game.d.ts) that pin the numeric representation.
    fn typeRefToRanger:string (name:string) {
        if (name == "int") { return "int" }
        if (name == "float") { return "double" }
        if (name == "double") { return "double" }
        if (name == "number") { return "double" }
        ; Fixed-width aliases are now first-class Ranger types (compiler support
        ; added in TTypeRegistry / C++ writer), so pass them through verbatim: the
        ; C++ backend emits uint8_t / int32_t / float, other targets use int/double.
        if (name == "i32") { return "i32" }
        if (name == "u8") { return "u8" }
        if (name == "u16") { return "u16" }
        if (name == "u32") { return "u32" }
        if (name == "f64") { return "double" }
        if (name == "f32") { return "f32" }
        if (name == "string") { return "string" }
        if (name == "boolean") { return "boolean" }
        if (name == "bool") { return "boolean" }
        if (name == "EntityPose") { return "EntityPoseNative" }
        if (name == "SpriteDef") { return "SpriteDefNative" }
        if (name == "GameState") { return "NativeGameState" }
        if (name == "UpdateProps") { return "UpdatePropsNative" }
        if (name == "IntMap") { return "[string:int]" }
        if (name == "EntityMap") { return "[string:EntityPoseNative]" }
        ; Script interface -> synthesized native struct.
        return (name + "Native")
    }

    ; --- tiny CSV helpers (Ranger maps can't hold list values directly) ---
    fn splitCsv:[string] (s:string) {
        def out:[string]
        if ((strlen s) == 0) {
            return out
        }
        def cur:string ""
        def i 0
        while (i < (strlen s)) {
            def ch:string (substring s i (i + 1))
            if (ch == ",") {
                push out cur
                cur = ""
            } {
                cur = (cur + ch)
            }
            i = (i + 1)
        }
        push out cur
        return out
    }

    fn joinCsv:string (items:[string]) {
        def out:string ""
        def i 0
        while (i < (array_length items)) {
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + (itemAt items i))
            i = (i + 1)
        }
        return out
    }

    fn helperReturnType:string (name:string) {
        def t@(optional):string (get fnReturnTypes name)
        if (!null? t) {
            return (unwrap t)
        }
        return "int"
    }

    fn fnSigType:string (t:string) {
        if (t == "i32") { return "int" }
        if (t == "u8") { return "int" }
        if (t == "u16") { return "int" }
        if (t == "u32") { return "int" }
        if (t == "f32") { return "double" }
        return t
    }

    fn helperParamType:string (name:string idx:int) {
        def csv@(optional):string (get fnParamTypesCsv name)
        if (null? csv) {
            return ""
        }
        def parts:[string] (this.splitCsv((unwrap csv)))
        if (idx < (array_length parts)) {
            return (itemAt parts idx)
        }
        return ""
    }

    fn isKnownHelper:boolean (name:string) {
        def h@(optional):boolean (get isHelperFn name)
        return (!null? h)
    }

    fn emit:void (text:string) {
        output = output + text
    }

    fn emitLine:void (text:string) {
        def pad:string (this.pad())
        output = output + pad + text + "\n"
    }

    fn pad:string () {
        def result ""
        def i 0
        while (i < indentLevel) {
            result = result + indentStr
            i = (i + 1)
        }
        return result
    }

    fn indent:void () {
        indentLevel = (indentLevel + 1)
    }

    fn dedent:void () {
        indentLevel = (indentLevel - 1)
    }

    fn reset:void () {
        output = ""
        indentLevel = 0
        currentFn = ""
        inSpritesFn = false
        inInitFn = false
        inUpdateFn = false
        inResourcesFn = false
        def fr:[string:string]
        fnReturnTypes = fr
        def fp:[string:string]
        fnParamTypesCsv = fp
        def fh:[string:boolean]
        isHelperFn = fh
        def cs:[string:string]
        constScalarTypes = cs
        def csv:[string:string]
        constScalarValues = csv
        def ca:[string:boolean]
        constArrayNames = ca
        def cae:[string:string]
        constArrayElemType = cae
        def ifc:[string:string]
        interfaceFieldsCsv = ifc
        def ifn:[string]
        interfaceNames = ifn
        def saf:[string:string]
        stateArrayFieldType = saf
        def osf:[string:string]
        objectStateFieldType = osf
        def oso:[string]
        objectStateFieldOrder = oso
        def hia:[string:string]
        hoistedItemAt = hia
        itemAtCounter = 0
        def isl:[string:string]
        initStateLocalTypes = isl
        def ssd:[string:boolean]
        synthStructDone = ssd
        moduleSingletonClass = ""
        def mcd:[string:boolean]
        moduleConstDeferred = mcd
        inModuleSingletonCtor = false
        tmpCounter = 0
        this.seedBridgeStructs()
    }

    fn setModuleSingletonId:void (moduleId:string) {
        moduleIdRaw = moduleId
    }

    ; Ambient engine globals (engine.d.ts) provided by the injected host object.
    fn isEngineGlobal:boolean (name:string) {
        if (name == "bgWidth") { return true }
        if (name == "bgHeight") { return true }
        if (name == "paneIndex") { return true }
        return false
    }

    ; Ambient engine functions provided by the injected host object.
    fn isEngineFn:boolean (name:string) {
        if (name == "bgClear") { return true }
        if (name == "bgFillRect") { return true }
        if (name == "bgFillCircle") { return true }
        return false
    }

    fn applyModuleId:void () {
        if ((strlen moduleIdRaw) > 0) {
            def cap:string (this.capitalizeModuleId(moduleIdRaw))
            moduleSingletonClass = (cap + "GameModule")
        }
    }

    fn capitalizeModuleId:string (id:string) {
        if ((strlen id) == 0) {
            return "Game"
        }
        def out:string ""
        def i 0
        def upNext:boolean true
        while (i < (strlen id)) {
            def ch:string (substring id i (i + 1))
            if ((ch == "_") || ((ch == "-") || (ch == "."))) {
                upNext = true
            } {
                if (upNext) {
                    def uc:string (this.upperAscii(ch))
                    out = (out + uc)
                } {
                    out = (out + ch)
                }
                upNext = false
            }
            i = (i + 1)
        }
        if ((strlen out) == 0) {
            return "Game"
        }
        def first:string (substring out 0 1)
        def firstUp:string (this.upperAscii(first))
        return (firstUp + (substring out 1 (strlen out)))
    }

    fn upperAscii:string (ch:string) {
        if (ch == "a") { return "A" }
        if (ch == "b") { return "B" }
        if (ch == "c") { return "C" }
        if (ch == "d") { return "D" }
        if (ch == "e") { return "E" }
        if (ch == "f") { return "F" }
        if (ch == "g") { return "G" }
        if (ch == "h") { return "H" }
        if (ch == "i") { return "I" }
        if (ch == "j") { return "J" }
        if (ch == "k") { return "K" }
        if (ch == "l") { return "L" }
        if (ch == "m") { return "M" }
        if (ch == "n") { return "N" }
        if (ch == "o") { return "O" }
        if (ch == "p") { return "P" }
        if (ch == "q") { return "Q" }
        if (ch == "r") { return "R" }
        if (ch == "s") { return "S" }
        if (ch == "t") { return "T" }
        if (ch == "u") { return "U" }
        if (ch == "v") { return "V" }
        if (ch == "w") { return "W" }
        if (ch == "x") { return "X" }
        if (ch == "y") { return "Y" }
        if (ch == "z") { return "Z" }
        return ch
    }

    ; Module const access goes through a per-function local bound to the
    ; singleton — Ranger can't type-resolve `(X.__singleton()).field` inline.
    fn moduleConstAccess:string (name:string) {
        return ("_mod." + name)
    }

    ; Emit `def _mod:<Class> (<Class>.__singleton())` if this function reads
    ; any module-level const (array or scalar).
    fn emitModuleLocalIfNeeded:void (body:TSNode) {
        if ((strlen moduleSingletonClass) == 0) {
            return
        }
        if ((this.bodyUsesModuleConst(body)) == false) {
            return
        }
        this.emitLine(((("def _mod:" + moduleSingletonClass) + " (") + moduleSingletonClass) + ".__singleton())")
    }

    fn bodyUsesModuleConst:boolean (node:TSNode) {
        if (node.nodeType == "Identifier") {
            def ca@(optional):boolean (get constArrayNames node.name)
            if (!null? ca) {
                return true
            }
            def cs@(optional):string (get constScalarTypes node.name)
            if (!null? cs) {
                return true
            }
            return false
        }
        if (node.left) {
            if (this.bodyUsesModuleConst((unwrap node.left))) { return true }
        }
        if (node.right) {
            if (this.bodyUsesModuleConst((unwrap node.right))) { return true }
        }
        if (node.body) {
            if (this.bodyUsesModuleConst((unwrap node.body))) { return true }
        }
        if (node.init) {
            if (this.bodyUsesModuleConst((unwrap node.init))) { return true }
        }
        if (node.test) {
            if (this.bodyUsesModuleConst((unwrap node.test))) { return true }
        }
        if (node.consequent) {
            if (this.bodyUsesModuleConst((unwrap node.consequent))) { return true }
        }
        if (node.alternate) {
            if (this.bodyUsesModuleConst((unwrap node.alternate))) { return true }
        }
        def i 0
        while (i < (array_length node.children)) {
            if (this.bodyUsesModuleConst((itemAt node.children i))) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn hasModuleConsts:boolean (ast:TSNode) {
        def i 0
        while (i < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children i)
            if (node.nodeType == "VariableDeclaration") {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; Register bridge struct field types so struct-literal emission is type-aware
    ; (keyed by the interface-style name = struct minus the "Native" suffix).
    fn seedBridgeStructs:void () {
        set interfaceFieldsCsv "SpriteDef" "id:string,kind:string,w:int,h:int,rad:int,r:int,g:int,b:int,p0:int,p1:int,p2:int,px:int,br:int,bg:int,bb:int,er:int,eg:int,eb:int,frames:[[string]],path:string,frameW:int,frameH:int,cols:int,rows:int,scale:int,feetTrim:int,jumpFrame:int"
        set interfaceFieldsCsv "EntityPose" "x:double,y:double,visible:int,r:int,g:int,b:int,rad:int,p0:int,p1:int,p2:int"
        set interfaceFieldsCsv "ResourceDef" "kind:string,id:string,path:string,px:int,frameCount:int,w:int,h:int"
        set interfaceFieldsCsv "GameEvent" "kind:string,id:string,x:double,y:double,amount:int"
        set interfaceFieldsCsv "PlayerInput" "up:boolean,down:boolean,left:boolean,right:boolean,action:boolean"
        set interfaceFieldsCsv "GameInput" "players:[PlayerInputNative]"
    }

    ; Fields that exist as first-class members of NativeGameState. Anything else
    ; a script stores on state is routed to the generic `numbers` map (double).
    fn isNativeStateField:boolean (prop:string) {
        if (prop == "screen") { return true }
        if (prop == "showNet") { return true }
        if (prop == "score1") { return true }
        if (prop == "score2") { return true }
        if (prop == "score") { return true }
        if (prop == "vx") { return true }
        if (prop == "vy") { return true }
        if (prop == "hasVx") { return true }
        if (prop == "hasVy") { return true }
        if (prop == "dt") { return true }
        if (prop == "hasDt") { return true }
        if (prop == "entities") { return true }
        if (prop == "numbers") { return true }
        if (prop == "events") { return true }
        return false
    }

    ; ==========================================================================
    ; Type model - bridge struct fields have known Ranger types. The emitter
    ; uses these to decide numeric literal form (int vs double) so the generated
    ; code type-checks statically.
    ; ==========================================================================

    fn fieldType:string (prop:string) {
        if ((prop == "x") || (prop == "y")) {
            return "double"
        }
        if ((prop == "vx") || (prop == "vy")) {
            return "double"
        }
        if (prop == "dt") {
            return "double"
        }
        if ((prop == "up") || (prop == "down") || (prop == "left") || (prop == "right") || (prop == "action")) {
            return "boolean"
        }
        if ((prop == "hasVx") || (prop == "hasVy")) {
            return "boolean"
        }
        if ((prop == "hasDt")) {
            return "boolean"
        }
        if ((prop == "id") || (prop == "kind") || (prop == "screen") || (prop == "path")) {
            return "string"
        }
        if (prop == "state") {
            return "NativeGameState"
        }
        if (prop == "input") {
            return "GameInputNative"
        }
        if (prop == "players") {
            return "[PlayerInputNative]"
        }
        return "int"
    }

    fn lookupVarType:string (name:string) {
        def t@(optional):string (get varTypes name)
        if (!null? t) {
            return (unwrap t)
        }
        return ""
    }

    fn callExprType:string (node:TSNode) {
        if (null? node.left) {
            return "int"
        }
        def callee:TSNode (unwrap node.left)
        if (callee.nodeType == "Identifier") {
            if (this.isBridgeHelper(callee.name)) {
                return "GameEventNative"
            }
            if (callee.name == "initState") {
                return "NativeGameState"
            }
            if (this.isKnownHelper(callee.name)) {
                return (this.helperReturnType(callee.name))
            }
        }
        if (callee.nodeType == "MemberExpression") {
            ; a.push(...) etc. return void
            return "void"
        }
        return "int"
    }

    fn elemTypeOf:string (arrType:string) {
        if ((strlen arrType) < 3) {
            return "int"
        }
        def first:string (substring arrType 0 1)
        if (first != "[") {
            return "int"
        }
        def inner:string (substring arrType 1 ((strlen arrType) - 1))
        def il:int (strlen inner)
        def depth:int 0
        def sep:int (0 - 1)
        def i:int 0
        while (i < il) {
            def c:int (charAt inner i)
            if (c == (ccode "[")) {
                depth = depth + 1
            }
            if (c == 93) {
                depth = depth - 1
            }
            if ((c == (ccode ":")) && (depth == 0)) {
                sep = i
            }
            i = i + 1
        }
        if (sep >= 0) {
            return (substring inner (sep + 1) il)
        }
        return inner
    }

    ; Field type of a struct (interface) member, or "" if unknown.
    fn structFieldType:string (structType:string field:string) {
        if ((this.endsWith(structType "Native")) == false) {
            return ""
        }
        def iface:string (substring structType 0 ((strlen structType) - 6))
        def csv@(optional):string (get interfaceFieldsCsv iface)
        if (null? csv) {
            return ""
        }
        def pairs:[string] (this.splitCsv((unwrap csv)))
        def i 0
        while (i < (array_length pairs)) {
            def pair:string (itemAt pairs i)
            def colon:int (indexOf pair ":")
            if (colon > 0) {
                def fname:string (substring pair 0 colon)
                if (fname == field) {
                    return (substring pair (colon + 1) (strlen pair))
                }
            }
            i = (i + 1)
        }
        return ""
    }

    fn isStateArrayField:boolean (name:string) {
        def t@(optional):string (get stateArrayFieldType name)
        return (!null? t)
    }

    fn stateArrayType:string (name:string) {
        def t@(optional):string (get stateArrayFieldType name)
        if (!null? t) {
            return (unwrap t)
        }
        return "[int]"
    }

    fn isComparisonOp:boolean (op:string) {
        if (op == "<") { return true }
        if (op == ">") { return true }
        if (op == "<=") { return true }
        if (op == ">=") { return true }
        if (op == "==") { return true }
        if (op == "!=") { return true }
        if (op == "===") { return true }
        if (op == "!==") { return true }
        return false
    }

    fn isLogicalOp:boolean (op:string) {
        if (op == "&&") { return true }
        if (op == "||") { return true }
        return false
    }

    ; Natural Ranger type of an expression node.
    fn exprType:string (node:TSNode) {
        def t:string node.nodeType
        if (t == "NumericLiteral") {
            if (this.containsChar(node.value 46)) {
                return "double"
            }
            return "int"
        }
        if (t == "BooleanLiteral") {
            return "boolean"
        }
        if (t == "StringLiteral") {
            return "string"
        }
        if (t == "Identifier") {
            def vt:string (this.lookupVarType(node.name))
            if ((strlen vt) > 0) {
                return vt
            }
            def ist@(optional):string (get initStateLocalTypes node.name)
            if (!null? ist) {
                return (unwrap ist)
            }
            def ca@(optional):boolean (get constArrayNames node.name)
            if (!null? ca) {
                def et@(optional):string (get constArrayElemType node.name)
                if (!null? et) {
                    return ("[" + (unwrap et)) + "]"
                }
            }
            def cst@(optional):string (get constScalarTypes node.name)
            if (!null? cst) {
                return (unwrap cst)
            }
            if (this.isEngineGlobal(node.name)) {
                return "int"
            }
            return "int"
        }
        if (t == "CallExpression") {
            return (this.callExprType(node))
        }
        if (t == "MemberExpression") {
            ; a.length -> int
            if (node.name == "length") {
                if (node.left) {
                    return "int"
                }
            }
            ; computed read a[i] -> element type of a
            if (node.computed) {
                if (node.left) {
                    def bt:string (this.exprType((unwrap node.left)))
                    return (this.elemTypeOf(bt))
                }
            }
            ; Custom scalar read from state.numbers is always double.
            if (node.left) {
                def lbase:TSNode (unwrap node.left)
                if (lbase.nodeType == "Identifier") {
                    def lvt:string (this.lookupVarType(lbase.name))
                    if (lvt == "NativeGameState") {
                        if (this.isObjectStateField(node.name)) {
                            return (this.objectStateFieldTypeOf(node.name))
                        }
                        if ((this.isNativeStateField(node.name)) == false) {
                            if (this.isStateArrayField(node.name)) {
                                return (this.stateArrayType(node.name))
                            }
                            return "double"
                        }
                    }
                }
                ; struct field access (palette.br etc.)
                def baseT:string (this.exprType(lbase))
                def sf:string (this.structFieldType(baseT node.name))
                if ((strlen sf) > 0) {
                    return sf
                }
            }
            return (this.fieldType(node.name))
        }
        if (t == "UnaryExpression") {
            if (node.value == "!") {
                return "boolean"
            }
            if (node.left) {
                return (this.exprType((unwrap node.left)))
            }
            return "int"
        }
        if (t == "BinaryExpression") {
            def op:string node.value
            if (this.isComparisonOp(op)) {
                return "boolean"
            }
            if (this.isLogicalOp(op)) {
                return "boolean"
            }
            def lt:string "int"
            def rt:string "int"
            if (node.left) {
                lt = (this.exprType((unwrap node.left)))
            }
            if (node.right) {
                rt = (this.exprType((unwrap node.right)))
            }
            if (op == "+") {
                if ((lt == "string") || (rt == "string")) {
                    return "string"
                }
            }
            if ((lt == "double") || (rt == "double")) {
                return "double"
            }
            return "int"
        }
        if (t == "ObjectExpression") {
            if ((array_length node.children) == 0) {
                return "[string:EntityPoseNative]"
            }
            return (this.inferObjectStructType(node ""))
        }
        return "int"
    }
    fn isFloatScalar:boolean (t:string) {
        if (t == "double") { return true }
        if (t == "f32") { return true }
        return false
    }

    fn isIntScalar:boolean (t:string) {
        if (t == "int") { return true }
        if (t == "i32") { return true }
        if (t == "u8") { return true }
        if (t == "u16") { return true }
        if (t == "u32") { return true }
        return false
    }

    fn numericCommon:string (node:TSNode) {
        def lt:string "int"
        def rt:string "int"
        if (node.left) {
            lt = (this.exprType((unwrap node.left)))
        }
        if (node.right) {
            rt = (this.exprType((unwrap node.right)))
        }
        if ((this.isFloatScalar(lt)) || (this.isFloatScalar(rt))) {
            return "double"
        }
        return "int"
    }

    fn rhsValueType:string (node:TSNode) {
        if (node.nodeType == "BinaryExpression") {
            return (this.numericCommon(node))
        }
        return (this.exprType(node))
    }

    fn coerceToType:string (expr:string node:TSNode target:string) {
        if (target == "int") {
            def rt:string (this.rhsValueType(node))
            if (rt == "double") {
                if ((strlen expr) >= 7) {
                    if ((substring expr 0 7) == "(to_int") {
                        return expr
                    }
                }
                return ("(to_int " + expr) + ")"
            }
        }
        if (target == "double") {
            def rt2:string (this.rhsValueType(node))
            if (rt2 == "int") {
                if (node.nodeType == "NumericLiteral") {
                    return expr
                }
                if (node.nodeType == "Identifier") {
                    return expr
                }
                if (this.containsChar(expr 46)) {
                    return expr
                }
                if ((strlen expr) >= 4) {
                    if ((substring expr 0 4) == "(0.0") {
                        return expr
                    }
                }
                if ((strlen expr) >= 10) {
                    if ((substring expr 0 10) == "(to_double") {
                        return expr
                    }
                }
                return ("(to_double " + expr) + ")"
            }
        }
        return expr
    }

    ; ==========================================================================
    ; Program / functions
    ; ==========================================================================

    fn emitProgram:string (ast:TSNode) {
        this.reset()
        this.applyModuleId()
        this.prescanProgram(ast)
        this.emitLine("; Generated by gallery/ts_to_ranger/ts_emitter.rgr")
        this.emitLine("; Source: game script (.game.tsx) - do not edit by hand.")
        this.emitLine("")
        this.emitLine("Import \"../../game_engine/scripting/game_engine_host.rgr\"")
        this.emitLine("")

        ; 1. Interfaces -> native structs (before the script class).
        this.emitInterfaces()

        ; 2. Module-level const scalars/arrays -> per-file @singleton(true) class.
        if ((this.hasModuleConsts(ast)) && ((strlen moduleSingletonClass) > 0)) {
            this.emitModuleSingleton(ast)
            this.emitLine("")
        }

        this.emitLine("class GeneratedGameScript {")
        ; Injected engine environment (bg raster, paneIndex, physics). The native
        ; game bridge assigns the shared host; default keeps headless compiles valid.
        this.emitLine("    def host:GameEngineHost (new GameEngineHost)")
        ; Object-valued state fields (player structs, arrays of structs) persist on
        ; the script instance instead of the generic NativeGameState maps.
        this.emitObjectStateFields()
        this.emitLine("")

        ; 3. Functions only (consts live on the module singleton).
        def i 0
        while (i < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children i)
            if (node.nodeType == "FunctionDeclaration") {
                this.emitFunction(node)
            }
            i = (i + 1)
        }

        this.emitLine("}")
        return output
    }

    fn emitObjectStateFields:void () {
        def i 0
        while (i < (array_length objectStateFieldOrder)) {
            def name:string (itemAt objectStateFieldOrder i)
            def t@(optional):string (get objectStateFieldType name)
            if (!null? t) {
                def ty:string (unwrap t)
                def zero:string (this.zeroFor(ty))
                if ((strlen zero) > 0) {
                    this.emitLine((((("    def st_" + name) + ":") + ty) + " ") + zero)
                } {
                    this.emitLine(((("    def st_" + name) + ":") + ty))
                }
            }
            i = (i + 1)
        }
    }

    fn isObjectStateField:boolean (name:string) {
        def t@(optional):string (get objectStateFieldType name)
        if (!null? t) {
            return true
        }
        return false
    }

    fn objectStateFieldTypeOf:string (name:string) {
        def t@(optional):string (get objectStateFieldType name)
        if (!null? t) {
            return (unwrap t)
        }
        return "int"
    }

    ; Read a script-state field from any NativeGameState binding (s, fresh, patch).
    fn emitStateFieldRead:string (baseName:string field:string expected:string) {
        if (this.isObjectStateField(field)) {
            return ("st_" + field)
        }
        if (this.isStateArrayField(field)) {
            return (((("(unwrap (get " + baseName) + ".intArrays \"") + field) + "\"))")
        }
        if ((this.isNativeStateField(field)) == false) {
            if ((strlen field) > 0) {
                def access:string (((("(unwrap (get " + baseName) + ".numbers \"") + field) + "\"))")
                if (expected == "int") {
                    return ("(to_int " + access) + ")")
                }
                return access
            }
        }
        return ""
    }

    fn isSpecialFn:boolean (name:string) {
        if (name == "sprites") { return true }
        if (name == "resources") { return true }
        if (name == "initState") { return true }
        if (name == "update") { return true }
        if (name == "hud") { return true }
        return false
    }

    ; Build helper/const/interface registries before emitting anything.
    fn prescanProgram:void (ast:TSNode) {
        def i 0
        while (i < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children i)
            def t:string node.nodeType
            if (t == "TSInterfaceDeclaration") {
                this.recordInterface(node)
            }
            if (t == "FunctionDeclaration") {
                if ((this.isSpecialFn(node.name)) == false) {
                    this.recordHelper(node)
                }
            }
            if (t == "VariableDeclaration") {
                this.recordModuleConst(node)
            }
            i = (i + 1)
        }
        ; Second pass: discover state array fields from initState's return object.
        def j 0
        while (j < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children j)
            if (node.nodeType == "FunctionDeclaration") {
                if (node.name == "initState") {
                    this.scanStateArrays(node)
                }
            }
            j = (j + 1)
        }
        ; Third pass: refine helper param types from call sites (struct + array args).
        def k 0
        while (k < (array_length ast.children)) {
            def node2:TSNode (itemAt ast.children k)
            if (node2.nodeType == "FunctionDeclaration") {
                if ((this.isSpecialFn(node2.name)) == false) {
                    this.inferParamTypesFromProgram(node2.name ast)
                }
            }
            k = (k + 1)
        }
        ; Fourth pass: re-infer helper return types now that param CSV is final.
        this.finalizeHelperReturnTypes(ast)
        ; Fifth pass: refresh synthesized return-struct field types after call-site
        ; inference AND finalized helper return types (so e.g. `{ x: scaleX(..) }`
        ; picks up scaleX's double return). Run return-type inference first so
        ; struct fields typed from helper calls resolve correctly.
        this.finalizeSynthStructs(ast)
        ; Helper returns may depend on struct field types too; re-run once more.
        this.finalizeHelperReturnTypes(ast)
        ; Seventh pass: call-site param types now that struct schemas are final.
        this.reinferParamTypesFromCalls(ast)
    }

    fn scanStateArrays:void (node:TSNode) {
        if (null? node.body) {
            return
        }
        def empty:[string:string]
        initStateLocalTypes = empty
        def body:TSNode (unwrap node.body)
        def i 0
        while (i < (array_length body.children)) {
            def stmt:TSNode (itemAt body.children i)
            if (stmt.nodeType == "VariableDeclaration") {
                this.scanInitStateLocalVar(stmt)
            }
            if (stmt.nodeType == "ReturnStatement") {
                if (stmt.left) {
                    def val:TSNode (unwrap stmt.left)
                    if (val.nodeType == "ObjectExpression") {
                        this.scanStateArrayProps(val)
                    }
                }
            }
            i = (i + 1)
        }
    }

    fn scanInitStateLocalVar:void (stmt:TSNode) {
        def j 0
        while (j < (array_length stmt.children)) {
            def decl:TSNode (itemAt stmt.children j)
            if (decl.nodeType == "VariableDeclarator") {
                if (decl.init) {
                    def vt:string (this.exprType((unwrap decl.init)))
                    set initStateLocalTypes decl.name vt
                }
            }
            j = (j + 1)
        }
    }

    fn stateArrayTypeFromValueNode:string (valNode:TSNode) {
        def vt:string (this.exprType(valNode))
        if (valNode.nodeType == "Identifier") {
            def lt@(optional):string (get initStateLocalTypes valNode.name)
            if (!null? lt) {
                vt = (unwrap lt)
            }
        }
        return vt
    }

    fn scanStateArrayProps:void (obj:TSNode) {
        def i 0
        while (i < (array_length obj.children)) {
            def prop:TSNode (itemAt obj.children i)
            if (prop.nodeType == "Property") {
                def key:string (this.propKey(prop))
                if ((this.isNativeStateField(key)) == false) {
                    if (key != "entities") {
                        def valNode:TSNode (this.propertyValueNode(prop))
                        def vt:string (this.stateArrayTypeFromValueNode(valNode))
                        def first:string ""
                        if ((strlen vt) > 0) {
                            first = (substring vt 0 1)
                        }
                        if (first == "[") {
                            ; [int] / [double] -> generic intArrays slot; arrays of
                            ; structs -> object state field (instance-held).
                            def et:string (this.elemTypeOf(vt))
                            if ((et == "int") || (et == "double")) {
                                set stateArrayFieldType key vt
                            } {
                                set objectStateFieldType key vt
                                push objectStateFieldOrder key
                            }
                        } {
                            ; A rich object value (struct) -> object state field.
                            if (this.endsWith(vt "Native")) {
                                set objectStateFieldType key vt
                                push objectStateFieldOrder key
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
    }

    fn helperAnnotatedArrayElem:string (fnName:string) {
        def rt:string (this.helperReturnType(fnName))
        if (this.startsWith(rt "[")) {
            return (this.elemTypeOf(rt))
        }
        return ""
    }

    fn recordHelper:void (node:TSNode) {
        set isHelperFn node.name true
        def rt:string "int"
        if (node.typeAnnotation) {
            rt = (this.annotType((unwrap node.typeAnnotation)))
        } {
            ; No annotation: infer from the function body's return statements.
            def inferred:string (this.inferHelperReturnType(node))
            if (this.isPositiveType(inferred)) {
                rt = inferred
            }
        }
        set fnReturnTypes node.name rt
        def types:[string]
        def i 0
        while (i < (array_length node.params)) {
            def p:TSNode (itemAt node.params i)
            def pt:string "int"
            if (p.typeAnnotation) {
                pt = (this.annotType((unwrap p.typeAnnotation)))
            }
            push types pt
            i = (i + 1)
        }
        set fnParamTypesCsv node.name (this.joinCsv(types))
        this.inferParamTypes(node)
    }

    ; Imported game_helpers.tsx bridge fns — inlined as GameEventNative literals.
    fn isBridgeHelper:boolean (name:string) {
        if (name == "soundEvent") { return true }
        if (name == "musicEvent") { return true }
        if (name == "musicScoreEvent") { return true }
        if (name == "stopMusicEvent") { return true }
        if (name == "particleEvent") { return true }
        if (name == "rumbleEvent") { return true }
        return false
    }

    fn emitBridgeHelperValue:string (name:string node:TSNode) {
        def tmp:string ("be" + ("" + tmpCounter))
        tmpCounter = (tmpCounter + 1)
        this.emitLine(("def " + tmp) + ":GameEventNative (new GameEventNative)")
        if (name == "soundEvent") {
            this.emitLine((tmp + ".kind = \"playSound\""))
            if ((array_length node.children) > 0) {
                def id:string (this.emitExpr((itemAt node.children 0) "string"))
                this.emitLine((tmp + ".id = ") + id)
            }
            return tmp
        }
        if (name == "stopMusicEvent") {
            this.emitLine((tmp + ".kind = \"stopMusic\""))
            this.emitLine((tmp + ".id = \"\""))
            return tmp
        }
        if (name == "musicEvent") {
            this.emitLine((tmp + ".kind = \"playMusic\""))
            if ((array_length node.children) > 0) {
                def id:string (this.emitExpr((itemAt node.children 0) "string"))
                this.emitLine((tmp + ".id = ") + id)
            }
            this.emitLine((tmp + ".amount = 1"))
            return tmp
        }
        if (name == "musicScoreEvent") {
            this.emitLine((tmp + ".kind = \"playMusic\""))
            this.emitLine((tmp + ".id = \"inline\""))
            if ((array_length node.children) > 0) {
                def txt:string (this.emitExpr((itemAt node.children 0) "string"))
                this.emitLine((tmp + ".text = ") + txt)
            }
            this.emitLine((tmp + ".amount = 1"))
            return tmp
        }
        if (name == "particleEvent") {
            this.emitLine((tmp + ".kind = \"particles\""))
            if ((array_length node.children) > 0) {
                def pid:string (this.emitExpr((itemAt node.children 0) "string"))
                this.emitLine((tmp + ".id = ") + pid)
            }
            if ((array_length node.children) > 1) {
                def px:string (this.emitExpr((itemAt node.children 1) "double"))
                this.emitLine((tmp + ".x = ") + px)
            }
            if ((array_length node.children) > 2) {
                def py:string (this.emitExpr((itemAt node.children 2) "double"))
                this.emitLine((tmp + ".y = ") + py)
            }
            if ((array_length node.children) > 3) {
                def amt:string (this.emitExpr((itemAt node.children 3) "int"))
                this.emitLine((tmp + ".amount = ") + amt)
            }
            return tmp
        }
        if (name == "rumbleEvent") {
            this.emitLine((tmp + ".kind = \"rumble\""))
            if ((array_length node.children) > 0) {
                def pad:string (this.emitExpr((itemAt node.children 0) "int"))
                this.emitLine((tmp + ".pad = ") + pad)
            }
            if ((array_length node.children) > 1) {
                def lo:string (this.emitExpr((itemAt node.children 1) "int"))
                this.emitLine((tmp + ".low = ") + lo)
            }
            if ((array_length node.children) > 2) {
                def hi:string (this.emitExpr((itemAt node.children 2) "int"))
                this.emitLine((tmp + ".high = ") + hi)
            }
            if ((array_length node.children) > 3) {
                def dur:string (this.emitExpr((itemAt node.children 3) "int"))
                this.emitLine((tmp + ".ms = ") + dur)
            }
            return tmp
        }
        return tmp
    }

    ; ==========================================================================
    ; Object-literal struct synthesis + param type inference
    ; ==========================================================================

    ; Match an object literal to a known bridge struct, or synthesize fnName+"Ret".
    fn inferObjectStructType:string (obj:TSNode fnName:string) {
        def known:string (this.matchKnownStruct(obj))
        if ((strlen known) > 0) {
            return known
        }
        if ((strlen fnName) == 0) {
            return "int"
        }
        return (this.registerSynthStruct(obj fnName))
    }

    fn matchKnownStruct:string (obj:TSNode) {
        if (obj.nodeType != "ObjectExpression") {
            return ""
        }
        def hasId:boolean false
        def hasKind:boolean false
        def hasX:boolean false
        def hasY:boolean false
        def i 0
        while (i < (array_length obj.children)) {
            def prop:TSNode (itemAt obj.children i)
            if (prop.nodeType == "Property") {
                def key:string (this.propKey(prop))
                if (key == "id") { hasId = true }
                if (key == "kind") { hasKind = true }
                if (key == "x") { hasX = true }
                if (key == "y") { hasY = true }
            }
            i = (i + 1)
        }
        if (hasId && hasKind) {
            return "SpriteDefNative"
        }
        ; Only collapse to EntityPoseNative when every field is part of the pose
        ; schema. Rich game objects (players/enemies with vx/vy/done/grounded/…)
        ; must keep a distinct synthesized struct so their fields survive.
        if (hasX && hasY) {
            if (this.allFieldsArePose(obj)) {
                return "EntityPoseNative"
            }
        }
        return ""
    }

    fn allFieldsArePose:boolean (obj:TSNode) {
        def i 0
        while (i < (array_length obj.children)) {
            def prop:TSNode (itemAt obj.children i)
            if (prop.nodeType == "Property") {
                def key:string (this.propKey(prop))
                if ((this.isPoseField(key)) == false) {
                    return false
                }
            }
            i = (i + 1)
        }
        return true
    }

    fn isPoseField:boolean (key:string) {
        if (key == "x") { return true }
        if (key == "y") { return true }
        if (key == "visible") { return true }
        if (key == "r") { return true }
        if (key == "g") { return true }
        if (key == "b") { return true }
        if (key == "rad") { return true }
        if (key == "p0") { return true }
        if (key == "p1") { return true }
        if (key == "p2") { return true }
        return false
    }

    fn registerSynthStruct:string (obj:TSNode fnName:string) {
        def baseName:string (fnName + "Ret")
        def structType:string (baseName + "Native")
        def done@(optional):boolean (get synthStructDone baseName)
        if (null? done) {
            def csv:string (this.objectFieldsCsv(obj))
            set interfaceFieldsCsv baseName csv
            push interfaceNames baseName
            set synthStructDone baseName true
        }
        return structType
    }

    fn objectFieldType:string (key:string valNode:TSNode) {
        if (key == "hit") { return "boolean" }
        if (key == "x") { return "double" }
        if (key == "y") { return "double" }
        if (key == "w") { return "double" }
        if (key == "vx") { return "double" }
        if (key == "vy") { return "double" }
        if (key == "bx") { return "double" }
        if (key == "by") { return "double" }
        if (key == "fireCd") { return "double" }
        if (key == "carryVx") { return "double" }
        if (valNode.nodeType == "ObjectExpression") {
            def known:string (this.matchKnownStruct(valNode))
            if ((strlen known) > 0) {
                return known
            }
            def iface:string (this.matchRecordedInterface(valNode))
            if ((strlen iface) > 0) {
                return iface
            }
        }
        return (this.exprType(valNode))
    }

    ; Pick the best recorded script interface for an object literal's field set.
    fn matchRecordedInterface:string (obj:TSNode) {
        if (obj.nodeType != "ObjectExpression") {
            return ""
        }
        def i 0
        while (i < (array_length interfaceNames)) {
            def iname:string (itemAt interfaceNames i)
            if (this.objectMatchesInterface(obj iname)) {
                return (iname + "Native")
            }
            i = (i + 1)
        }
        return ""
    }

    fn objectMatchesInterface:boolean (obj:TSNode iface:string) {
        def csv@(optional):string (get interfaceFieldsCsv iface)
        if (null? csv) {
            return false
        }
        def pairs:[string] (this.splitCsv((unwrap csv)))
        def pi 0
        while (pi < (array_length pairs)) {
            def pair:string (itemAt pairs pi)
            def colon:int (indexOf pair ":")
            if (colon > 0) {
                def fname:string (substring pair 0 colon)
                if ((this.objectHasField(obj fname)) == false) {
                    return false
                }
            }
            pi = (pi + 1)
        }
        return true
    }

    fn objectHasField:boolean (obj:TSNode key:string) {
        def i 0
        while (i < (array_length obj.children)) {
            def prop:TSNode (itemAt obj.children i)
            if (prop.nodeType == "Property") {
                if ((this.propKey(prop)) == key) {
                    return true
                }
            }
            i = (i + 1)
        }
        return false
    }

    fn objectFieldsCsv:string (obj:TSNode) {
        def pairs:[string]
        def i 0
        while (i < (array_length obj.children)) {
            def prop:TSNode (itemAt obj.children i)
            if (prop.nodeType == "Property") {
                def key:string (this.propKey(prop))
                if ((strlen key) > 0) {
                    def valNode:TSNode (this.propertyValueNode(prop))
                    def ft:string (this.objectFieldType(key valNode))
                    push pairs ((key + ":") + ft)
                }
            }
            i = (i + 1)
        }
        return (this.joinCsv(pairs))
    }

    ; After param-type refinement, rebuild synthesized return struct schemas.
    fn finalizeSynthStructs:void (ast:TSNode) {
        def i 0
        while (i < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children i)
            if (node.nodeType == "FunctionDeclaration") {
                if ((this.isSpecialFn(node.name)) == false) {
                    if (null? node.body) {
                        i = (i + 1)
                        continue
                    }
                    def body:TSNode (unwrap node.body)
                    def saved:[string:string] varTypes
                    def local:[string:string]
                    varTypes = local
                    def pi 0
                    while (pi < (array_length node.params)) {
                        def p:TSNode (itemAt node.params pi)
                        def pt:string (this.helperParamType(node.name pi))
                        if ((strlen pt) > 0) {
                            set varTypes p.name pt
                        }
                        pi = (pi + 1)
                    }
                    def savedInfer:string inferFnName
                    inferFnName = node.name
                    this.collectLocalVarTypes(body body)
                    inferFnName = savedInfer
                    def csv:string (this.findReturnStructCsv(body node.name))
                    if ((strlen csv) > 0) {
                        def baseName:string (node.name + "Ret")
                        set interfaceFieldsCsv baseName csv
                    }
                    this.refreshPushStructsInBlock(body node.name)
                    varTypes = saved
                }
            }
            i = (i + 1)
        }
    }

    ; Re-scan `arr.push({...})` literals so field types pick up finalized helper
    ; return types (e.g. scaleX -> double on x/min/max).
    fn refreshPushStructsInBlock:void (block:TSNode fnName:string) {
        def i 0
        while (i < (array_length block.children)) {
            this.refreshPushStructsInStmt((itemAt block.children i) fnName)
            i = (i + 1)
        }
    }

    fn refreshPushStructsInStmt:void (stmt:TSNode fnName:string) {
        def t:string stmt.nodeType
        if (t == "BlockStatement") {
            this.refreshPushStructsInBlock(stmt fnName)
            return
        }
        if (t == "ExpressionStatement") {
            if (stmt.left) {
                def expr:TSNode (unwrap stmt.left)
                if (expr.nodeType == "CallExpression") {
                    if (expr.left) {
                        def callee:TSNode (unwrap expr.left)
                        if (callee.nodeType == "MemberExpression") {
                            if (callee.name == "push") {
                                if (callee.left) {
                                    def base:TSNode (unwrap callee.left)
                                    if (base.nodeType == "Identifier") {
                                        if ((array_length expr.children) > 0) {
                                            def argNode:TSNode (itemAt expr.children 0)
                                            if (argNode.nodeType == "ObjectExpression") {
                                                def baseName:string (((fnName + "_") + base.name) + "Ret")
                                                set interfaceFieldsCsv baseName (this.objectFieldsCsv(argNode))
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            return
        }
        if (t == "IfStatement") {
            if (stmt.body) {
                this.refreshPushStructsInStmt((unwrap stmt.body) fnName)
            }
            if (stmt.right) {
                this.refreshPushStructsInStmt((unwrap stmt.right) fnName)
            }
            return
        }
        if (t == "WhileStatement") {
            if (stmt.body) {
                this.refreshPushStructsInStmt((unwrap stmt.body) fnName)
            }
        }
    }

    fn reinferParamTypesFromCalls:void (ast:TSNode) {
        def i 0
        while (i < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children i)
            if (node.nodeType == "FunctionDeclaration") {
                if ((this.isSpecialFn(node.name)) == false) {
                    this.inferParamTypesFromProgram(node.name ast)
                    this.inferParamTypes(node)
                }
            }
            i = (i + 1)
        }
    }

    fn findReturnStructCsv:string (block:TSNode fnName:string) {
        def i 0
        while (i < (array_length block.children)) {
            def csv:string (this.findReturnStructCsvInStmt((itemAt block.children i) fnName))
            if ((strlen csv) > 0) {
                return csv
            }
            i = (i + 1)
        }
        return ""
    }

    fn findReturnStructCsvInStmt:string (stmt:TSNode fnName:string) {
        def t:string stmt.nodeType
        if (t == "ReturnStatement") {
            if (stmt.left) {
                def val:TSNode (unwrap stmt.left)
                if (val.nodeType == "ObjectExpression") {
                    return (this.objectFieldsCsv(val))
                }
            }
            return ""
        }
        if (t == "IfStatement") {
            if (stmt.body) {
                def r1:string (this.findReturnStructCsvInStmt((unwrap stmt.body) fnName))
                if ((strlen r1) > 0) {
                    return r1
                }
            }
            if (stmt.right) {
                def r2:string (this.findReturnStructCsvInStmt((unwrap stmt.right) fnName))
                if ((strlen r2) > 0) {
                    return r2
                }
            }
            return ""
        }
        if (t == "BlockStatement") {
            return (this.findReturnStructCsv(stmt fnName))
        }
        if (t == "WhileStatement") {
            if (stmt.body) {
                return (this.findReturnStructCsvInStmt((unwrap stmt.body) fnName))
            }
        }
        return ""
    }

    fn inferParamTypes:void (node:TSNode) {
        if (null? node.body) {
            return
        }
        def body:TSNode (unwrap node.body)
        def csv@(optional):string (get fnParamTypesCsv node.name)
        def oldTypes:[string]
        if (!null? csv) {
            oldTypes = (this.splitCsv((unwrap csv)))
        }
        def newTypes:[string]
        def i 0
        while (i < (array_length node.params)) {
            def p:TSNode (itemAt node.params i)
            def pt:string "int"
            if (p.typeAnnotation) {
                pt = (this.annotType((unwrap p.typeAnnotation)))
            } {
                if (i < (array_length oldTypes)) {
                    pt = (itemAt oldTypes i)
                }
                def inferred:string (this.inferParamTypeFromBody(p.name body))
                if ((strlen inferred) > 0) {
                    pt = inferred
                }
            }
            push newTypes pt
            i = (i + 1)
        }
        set fnParamTypesCsv node.name (this.joinCsv(newTypes))
    }

    fn inferParamTypesFromProgram:void (fnName:string ast:TSNode) {
        this.inferParamTypesFromCallsWalk(fnName ast)
    }

    fn inferParamTypesFromCallsWalk:void (fnName:string node:TSNode) {
        if (node.nodeType == "CallExpression") {
            if (node.left) {
                def callee:TSNode (unwrap node.left)
                if (callee.nodeType == "Identifier") {
                    if (callee.name == fnName) {
                        this.mergeCallArgTypes(fnName node)
                    }
                }
            }
        }
        def i 0
        while (i < (array_length node.children)) {
            this.inferParamTypesFromCallsWalk(fnName (itemAt node.children i))
            i = (i + 1)
        }
        if (node.left) {
            this.inferParamTypesFromCallsWalk(fnName (unwrap node.left))
        }
        if (node.right) {
            this.inferParamTypesFromCallsWalk(fnName (unwrap node.right))
        }
        if (node.body) {
            this.inferParamTypesFromCallsWalk(fnName (unwrap node.body))
        }
        if (node.init) {
            this.inferParamTypesFromCallsWalk(fnName (unwrap node.init))
        }
        if (node.test) {
            this.inferParamTypesFromCallsWalk(fnName (unwrap node.test))
        }
        if (node.consequent) {
            this.inferParamTypesFromCallsWalk(fnName (unwrap node.consequent))
        }
        if (node.alternate) {
            this.inferParamTypesFromCallsWalk(fnName (unwrap node.alternate))
        }
    }

    fn inferCallArgType:string (arg:TSNode fnName:string) {
        if (arg.nodeType == "ObjectExpression") {
            if ((strlen fnName) > 0) {
                return (this.inferObjectStructType(arg (fnName + "_arg")))
            }
        }
        def at:string (this.exprType(arg))
        if (this.isPositiveType(at)) {
            return at
        }
        if (arg.nodeType == "Identifier") {
            if (arg.name == "vx") { return "double" }
            if (arg.name == "vy") { return "double" }
            if (arg.name == "bx") { return "double" }
            if (arg.name == "by") { return "double" }
            if (arg.name == "prevBx") { return "double" }
        }
        if (arg.nodeType == "MemberExpression") {
            if (arg.computed) {
                if (arg.left) {
                    def base:TSNode (unwrap arg.left)
                    if (base.nodeType == "MemberExpression") {
                        if (base.left) {
                            def root:TSNode (unwrap base.left)
                            if (root.nodeType == "Identifier") {
                                if (root.name == stateVarName) {
                                    def ost:string (this.objectStateFieldTypeOf(base.name))
                                    if (this.startsWith(ost "[")) {
                                        return (this.elemTypeOf(ost))
                                    }
                                }
                            }
                        }
                    }
                    if (base.nodeType == "Identifier") {
                        if (base.name == stateVarName) {
                            def et:string (this.objectStateFieldTypeOf(arg.name))
                            if (this.startsWith(et "[")) {
                                return (this.elemTypeOf(et))
                            }
                        }
                    }
                    def bt:string (this.exprType(base))
                    if (this.startsWith(bt "[")) {
                        return (this.elemTypeOf(bt))
                    }
                }
            }
            if (arg.name == "x") { return "double" }
            if (arg.name == "y") { return "double" }
            if (arg.name == "vx") { return "double" }
            if (arg.name == "vy") { return "double" }
        }
        return at
    }

    fn mergeCallArgTypes:void (fnName:string call:TSNode) {
        def csv@(optional):string (get fnParamTypesCsv fnName)
        if (null? csv) {
            return
        }
        def types:[string] (this.splitCsv((unwrap csv)))
        def newTypes:[string]
        def i 0
        while (i < (array_length types)) {
            def pt:string (itemAt types i)
            if (i < (array_length call.children)) {
                def arg:TSNode (itemAt call.children i)
                def at:string (this.inferCallArgType(arg fnName))
                if (this.isPositiveType(at)) {
                    pt = at
                }
            }
            push newTypes pt
            i = (i + 1)
        }
        set fnParamTypesCsv fnName (this.joinCsv(newTypes))
    }

    fn inferParamTypeFromBody:string (param:string body:TSNode) {
        if (param == "entities") {
            return "[string:EntityPoseNative]"
        }
        if (param == "events") {
            return "[GameEventNative]"
        }
        if (param == "props") {
            return "UpdatePropsNative"
        }
        if (param == "vx") { return "double" }
        if (param == "vy") { return "double" }
        if (param == "bx") { return "double" }
        if (param == "by") { return "double" }
        if (param == "prevBx") { return "double" }
        if (param == "paddleY") { return "double" }
        if (param == "paddleVy") { return "double" }
        if (param == "p1y") { return "double" }
        if (param == "p1vy") { return "double" }
        if (param == "p2y") { return "double" }
        if (param == "p2vy") { return "double" }
        if (param == "alive") {
            return "[int]"
        }
        if (param == "dotCol") { return "[int]" }
        if (param == "dotRow") { return "[int]" }
        if (param == "dotAlive") { return "[int]" }
        if (param == "powerCol") { return "[int]" }
        if (param == "powerRow") { return "[int]" }
        if (param == "powerAlive") { return "[int]" }
        if (param == "ghostCol") { return "[int]" }
        if (param == "ghostRow") { return "[int]" }
        if (param == "ghostDir") { return "[int]" }
        if (param == "ghostFrac") { return "[int]" }
        if (param == "ghostEyes") { return "[int]" }
        def fromUse:string (this.inferParamTypeWalk(param body))
        if ((strlen fromUse) > 0) {
            return fromUse
        }
        return ""
    }

    fn inferParamTypeWalk:string (param:string node:TSNode) {
        def t:string node.nodeType
        if (t == "IfStatement") {
            if (node.test) {
                def test:TSNode (unwrap node.test)
                if (test.nodeType == "Identifier") {
                    if (test.name == param) {
                        return "boolean"
                    }
                }
            }
        }
        if (t == "MemberExpression") {
            if (node.left) {
                def base:TSNode (unwrap node.left)
                if (base.nodeType == "Identifier") {
                    if (base.name == param) {
                        if (node.computed) {
                            return "[int]"
                        }
                        if (node.name == "length") {
                            return "[int]"
                        }
                        if (param == "entities") {
                            return "[string:EntityPoseNative]"
                        }
                    }
                }
            }
        }
        def i 0
        while (i < (array_length node.children)) {
            def r:string (this.inferParamTypeWalk(param (itemAt node.children i)))
            if ((strlen r) > 0) {
                return r
            }
            i = (i + 1)
        }
        if (node.left) {
            def r2:string (this.inferParamTypeWalk(param (unwrap node.left)))
            if ((strlen r2) > 0) {
                return r2
            }
        }
        if (node.right) {
            def r3:string (this.inferParamTypeWalk(param (unwrap node.right)))
            if ((strlen r3) > 0) {
                return r3
            }
        }
        if (node.body) {
            return (this.inferParamTypeWalk(param (unwrap node.body)))
        }
        return ""
    }

    ; A "positive" type is one worth overriding the default int with.
    fn isPositiveType:boolean (t:string) {
        if ((strlen t) == 0) { return false }
        if (t == "void") { return true }
        if (t == "int") { return false }
        if ((substring t 0 1) == "[") { return true }
        if (t == "string") { return true }
        if (t == "double") { return true }
        if (t == "boolean") { return true }
        if (this.endsWith(t "Native")) { return true }
        return false
    }

    ; Infer a helper's return type from its body when it has no annotation.
    fn inferHelperReturnType:string (node:TSNode) {
        if (null? node.body) {
            return "int"
        }
        def body:TSNode (unwrap node.body)
        def saved:[string:string] varTypes
        def local:[string:string]
        varTypes = local
        def pi 0
        while (pi < (array_length node.params)) {
            def p:TSNode (itemAt node.params pi)
            def pt:string (this.helperParamType(node.name pi))
            if ((strlen pt) > 0) {
                set varTypes p.name pt
            }
            pi = (pi + 1)
        }
        def savedInfer:string inferFnName
        inferFnName = node.name
        this.collectLocalVarTypes(body body)
        if (this.functionHasValueReturn(body) == false) {
            varTypes = saved
            inferFnName = savedInfer
            return "void"
        }
        def result:string (this.findReturnType(body node.name))
        varTypes = saved
        inferFnName = savedInfer
        return result
    }

    fn finalizeHelperReturnTypes:void (ast:TSNode) {
        def i 0
        while (i < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children i)
            if (node.nodeType == "FunctionDeclaration") {
                if ((this.isSpecialFn(node.name)) == false) {
                    if (null? node.typeAnnotation) {
                        def inferred:string (this.inferHelperReturnType(node))
                        if (this.isPositiveType(inferred)) {
                            set fnReturnTypes node.name inferred
                        }
                    }
                }
            }
            i = (i + 1)
        }
    }

    fn functionHasValueReturn:boolean (block:TSNode) {
        def i 0
        while (i < (array_length block.children)) {
            if (this.stmtHasValueReturn((itemAt block.children i))) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn stmtHasValueReturn:boolean (stmt:TSNode) {
        def t:string stmt.nodeType
        if (t == "ReturnStatement") {
            return (!null? stmt.left)
        }
        if (t == "BlockStatement") {
            return (this.functionHasValueReturn(stmt))
        }
        if (t == "IfStatement") {
            if (stmt.body) {
                if (this.stmtHasValueReturn((unwrap stmt.body))) {
                    return true
                }
            }
            if (stmt.right) {
                if (this.stmtHasValueReturn((unwrap stmt.right))) {
                    return true
                }
            }
            return false
        }
        if (t == "WhileStatement") {
            if (stmt.body) {
                return (this.stmtHasValueReturn((unwrap stmt.body)))
            }
            return false
        }
        return false
    }

    fn collectLocalVarTypes:void (block:TSNode root:TSNode) {
        def i 0
        while (i < (array_length block.children)) {
            def stmt:TSNode (itemAt block.children i)
            if (stmt.nodeType == "VariableDeclaration") {
                def j 0
                while (j < (array_length stmt.children)) {
                    def d:TSNode (itemAt stmt.children j)
                    if (d.nodeType == "VariableDeclarator") {
                        if (d.init) {
                            def vt:string (this.localInitType((unwrap d.init) d.name root))
                            if ((strlen vt) > 0) {
                                set varTypes d.name vt
                            }
                        }
                    }
                    j = (j + 1)
                }
            }
            i = (i + 1)
        }
    }

    fn localInitType:string (initNode:TSNode name:string root:TSNode) {
        if (initNode.nodeType == "ObjectExpression") {
            if ((array_length initNode.children) == 0) {
                if (name == "entities") {
                    return "[string:EntityPoseNative]"
                }
                return "[string:EntityPoseNative]"
            }
        }
        if (initNode.nodeType == "ArrayExpression") {
            def elem:string ""
            if ((array_length initNode.children) > 0) {
                elem = (this.exprType((itemAt initNode.children 0)))
            } {
                elem = (this.findPushArgType(root name))
            }
            if ((strlen elem) == 0) {
                elem = (this.helperAnnotatedArrayElem(inferFnName))
            }
            if ((strlen elem) == 0) {
                elem = "int"
            }
            return (("[" + elem) + "]")
        }
        return (this.exprType(initNode))
    }

    ; Find the element type pushed into a named local array anywhere in a block.
    fn findPushArgType:string (block:TSNode name:string) {
        def i 0
        while (i < (array_length block.children)) {
            def stmt:TSNode (itemAt block.children i)
            def r:string (this.findPushArgTypeInStmt(stmt name))
            if ((strlen r) > 0) {
                return r
            }
            i = (i + 1)
        }
        return ""
    }

    fn findPushArgTypeInStmt:string (stmt:TSNode name:string) {
        def t:string stmt.nodeType
        if (t == "BlockStatement") {
            return (this.findPushArgType(stmt name))
        }
        if (t == "ExpressionStatement") {
            if (stmt.left) {
                def expr:TSNode (unwrap stmt.left)
                if (expr.nodeType == "CallExpression") {
                    if (expr.left) {
                        def callee:TSNode (unwrap expr.left)
                        if (callee.nodeType == "MemberExpression") {
                            if (callee.name == "push") {
                                if (callee.left) {
                                    def base:TSNode (unwrap callee.left)
                                    if (base.nodeType == "Identifier") {
                                        if (base.name == name) {
                                            if ((array_length expr.children) > 0) {
                                                def argNode:TSNode (itemAt expr.children 0)
                                                ; Object-literal push -> synthesize a struct so the array
                                                ; element type carries all fields (alive/taken/…).
                                                if (argNode.nodeType == "ObjectExpression") {
                                                    def ann:string (this.helperAnnotatedArrayElem(inferFnName))
                                                    if ((strlen ann) > 0) {
                                                        return ann
                                                    }
                                                    def sname:string ((inferFnName + "_") + name)
                                                    return (this.inferObjectStructType(argNode sname))
                                                }
                                                def at:string (this.inferCallArgType(argNode inferFnName))
                                                if ((strlen at) > 0) {
                                                    return at
                                                }
                                                return (this.exprType(argNode))
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            return ""
        }
        if (t == "IfStatement") {
            if (stmt.body) {
                def r1:string (this.findPushArgTypeInStmt((unwrap stmt.body) name))
                if ((strlen r1) > 0) {
                    return r1
                }
            }
            if (stmt.right) {
                def r2:string (this.findPushArgTypeInStmt((unwrap stmt.right) name))
                if ((strlen r2) > 0) {
                    return r2
                }
            }
            return ""
        }
        if (t == "WhileStatement") {
            if (stmt.body) {
                return (this.findPushArgTypeInStmt((unwrap stmt.body) name))
            }
            return ""
        }
        return ""
    }

    ; First positively-typed return value found in a block (recursing into
    ; if/while/block bodies).
    fn findReturnType:string (block:TSNode fnName:string) {
        def i 0
        while (i < (array_length block.children)) {
            def stmt:TSNode (itemAt block.children i)
            def rt:string (this.findReturnTypeInStmt(stmt fnName))
            if (this.isPositiveType(rt)) {
                return rt
            }
            i = (i + 1)
        }
        return "int"
    }

    fn findReturnTypeInStmt:string (stmt:TSNode fnName:string) {
        def t:string stmt.nodeType
        if (t == "ReturnStatement") {
            if (stmt.left) {
                def val:TSNode (unwrap stmt.left)
                if (val.nodeType == "ObjectExpression") {
                    return (this.inferObjectStructType(val fnName))
                }
                if (val.nodeType == "ArrayExpression") {
                    if ((array_length val.children) > 0) {
                        def first:TSNode (itemAt val.children 0)
                        def et:string ""
                        if (first.nodeType == "ObjectExpression") {
                            et = (this.inferObjectStructType(first fnName))
                        } {
                            et = (this.exprType(first))
                        }
                        if ((strlen et) > 0) {
                            return ("[" + et) + "]"
                        }
                    }
                }
                return (this.exprType(val))
            }
            return "void"
        }
        if (t == "BlockStatement") {
            return (this.findReturnType(stmt fnName))
        }
        if (t == "IfStatement") {
            if (stmt.body) {
                def r1:string (this.findReturnTypeInStmt((unwrap stmt.body) fnName))
                if (this.isPositiveType(r1)) {
                    return r1
                }
            }
            if (stmt.right) {
                def r2:string (this.findReturnTypeInStmt((unwrap stmt.right) fnName))
                if (this.isPositiveType(r2)) {
                    return r2
                }
            }
            return "int"
        }
        if (t == "WhileStatement") {
            if (stmt.body) {
                return (this.findReturnTypeInStmt((unwrap stmt.body) fnName))
            }
            return "int"
        }
        return "int"
    }

    fn recordModuleConst:void (node:TSNode) {
        def i 0
        while (i < (array_length node.children)) {
            def d:TSNode (itemAt node.children i)
            if (d.nodeType == "VariableDeclarator") {
                if (d.init) {
                    def initNode:TSNode (unwrap d.init)
                    if (initNode.nodeType == "ArrayExpression") {
                        set constArrayNames d.name true
                        set constArrayElemType d.name (this.constArrayElem(d initNode))
                    } {
                        if (initNode.nodeType == "ObjectExpression") {
                            def ost:string (this.registerModuleObjectStruct(d.name initNode))
                            set constScalarTypes d.name ost
                            set moduleConstDeferred d.name true
                        } {
                            set constScalarTypes d.name (this.exprType(initNode))
                            def folded:string (this.tryFoldIntExpr(initNode))
                            if ((strlen folded) > 0) {
                                set constScalarValues d.name folded
                            }
                            if ((this.scalarInitNeedsCtor(initNode)) == true) {
                                set moduleConstDeferred d.name true
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
    }

    ; Element type for a const array (annotation wins, else infer from first item).
    fn constArrayElem:string (d:TSNode arr:TSNode) {
        if (d.typeAnnotation) {
            def full:string (this.annotType((unwrap d.typeAnnotation)))
            ; full is like "[string]" -> strip brackets
            if ((strlen full) > 2) {
                return (substring full 1 ((strlen full) - 1))
            }
        }
        if ((array_length arr.children) > 0) {
            def first:TSNode (itemAt arr.children 0)
            if (first.nodeType == "ObjectExpression") {
                return (this.registerModuleArrayStruct(d.name arr))
            }
            if (first.nodeType == "StringLiteral") { return "string" }
            if (first.nodeType == "ArrayExpression") { return "[string]" }
            if (first.nodeType == "NumericLiteral") {
                if (this.containsChar(first.value 46)) { return "double" }
                return "int"
            }
        }
        return "int"
    }

    fn scalarInitNeedsCtor:boolean (node:TSNode) {
        def t:string node.nodeType
        if (t == "NumericLiteral") { return false }
        if (t == "StringLiteral") { return false }
        if (t == "BooleanLiteral") { return false }
        def folded:string (this.tryFoldIntExpr(node))
        if ((strlen folded) > 0) {
            return false
        }
        return true
    }

    ; Merge object-literal keys from every element of a module const array.
    fn mergeArrayObjectFieldsCsv:string (arr:TSNode) {
        def pairs:[string]
        def seen:[string:boolean]
        def k 0
        while (k < (array_length arr.children)) {
            def el:TSNode (itemAt arr.children k)
            if (el.nodeType == "ObjectExpression") {
                def j 0
                while (j < (array_length el.children)) {
                    def prop:TSNode (itemAt el.children j)
                    if (prop.nodeType == "Property") {
                        def key:string (this.propKey(prop))
                        if ((strlen key) > 0) {
                            def was@(optional):boolean (get seen key)
                            if (null? was) {
                                set seen key true
                                def valNode:TSNode (this.propertyValueNode(prop))
                                def ft:string (this.objectFieldType(key valNode))
                                push pairs ((key + ":") + ft)
                            }
                        }
                    }
                    j = (j + 1)
                }
            }
            k = (k + 1)
        }
        return (this.joinCsv(pairs))
    }

    fn registerModuleArrayStruct:string (arrName:string arr:TSNode) {
        def baseName:string (arrName + "Elem")
        def structType:string (baseName + "Native")
        def done@(optional):boolean (get synthStructDone baseName)
        if (null? done) {
            def csv:string (this.mergeArrayObjectFieldsCsv(arr))
            set interfaceFieldsCsv baseName csv
            push interfaceNames baseName
            set synthStructDone baseName true
        }
        return structType
    }

    ; const NAME = { r, g, b } -> synth struct NAMEConstNative on the singleton.
    fn registerModuleObjectStruct:string (constName:string obj:TSNode) {
        def baseName:string (constName + "Const")
        def structType:string (baseName + "Native")
        def done@(optional):boolean (get synthStructDone baseName)
        if (null? done) {
            def csv:string (this.objectFieldsCsv(obj))
            set interfaceFieldsCsv baseName csv
            push interfaceNames baseName
            set synthStructDone baseName true
        }
        return structType
    }

    ; Fold module-level int const expressions (e.g. COLS*ROWS) to a literal
    ; so field initializers never reference sibling fields (illegal in imports).
    fn tryFoldIntExpr:string (node:TSNode) {
        def t:string node.nodeType
        if (t == "NumericLiteral") {
            if (this.containsChar(node.value 46)) {
                return ""
            }
            return node.value
        }
        if (t == "Identifier") {
            def v@(optional):string (get constScalarValues node.name)
            if (!null? v) {
                return (unwrap v)
            }
            return ""
        }
        if (t == "BinaryExpression") {
            if (null? node.left) {
                return ""
            }
            if (null? node.right) {
                return ""
            }
            def lv:string (this.tryFoldIntExpr((unwrap node.left)))
            def rv:string (this.tryFoldIntExpr((unwrap node.right)))
            if ((strlen lv) == 0) {
                return ""
            }
            if ((strlen rv) == 0) {
                return ""
            }
            def li:int (this.parseIntStr(lv))
            def ri:int (this.parseIntStr(rv))
            def op:string node.value
            if (op == "*") {
                return (this.formatIntStr((li * ri)))
            }
            if (op == "+") {
                return (this.formatIntStr((li + ri)))
            }
            if (op == "-") {
                return (this.formatIntStr((li - ri)))
            }
            if (op == "/") {
                return (this.formatIntStr((this.divInt(li ri))))
            }
            return ""
        }
        return ""
    }

    fn recordInterface:void (node:TSNode) {
        push interfaceNames node.name
        def pairs:[string]
        if (node.body) {
            def body:TSNode (unwrap node.body)
            def i 0
            while (i < (array_length body.children)) {
                def prop:TSNode (itemAt body.children i)
                if ((strlen prop.name) > 0) {
                    def pt:string "int"
                    if (prop.typeAnnotation) {
                        pt = (this.annotType((unwrap prop.typeAnnotation)))
                    }
                    push pairs ((prop.name + ":") + pt)
                }
                i = (i + 1)
            }
        }
        def ownCsv:string (this.joinCsv(pairs))
        def extNames:[string] (this.interfaceExtendsNames(node))
        if ((array_length extNames) > 0) {
            set interfaceFieldsCsv node.name (this.mergeInterfaceFieldsCsv(ownCsv extNames))
        } {
            set interfaceFieldsCsv node.name ownCsv
        }
    }

    ; Parent type names from `interface Foo extends Bar, Baz`.
    fn interfaceExtendsNames:[string] (node:TSNode) {
        def names:[string]
        def i 0
        while (i < (array_length node.children)) {
            def child:TSNode (itemAt node.children i)
            if (child.nodeType == "TSExpressionWithTypeArguments") {
                if (child.left) {
                    def left:TSNode (unwrap child.left)
                    if (left.nodeType == "TSTypeReference") {
                        push names left.name
                    }
                }
            }
            i = (i + 1)
        }
        return names
    }

    ; Merge parent interface fields; own fields override by name.
    fn mergeInterfaceFieldsCsv:string (ownCsv:string extendsNames:[string]) {
        def ownOnly:[string:boolean]
        def ownPairs:[string]
        if ((strlen ownCsv) > 0) {
            def opairs:[string] (this.splitCsv(ownCsv))
            def k 0
            while (k < (array_length opairs)) {
                def pair2:string (itemAt opairs k)
                def colon2:int (indexOf pair2 ":")
                if (colon2 > 0) {
                    def fn2:string (substring pair2 0 colon2)
                    set ownOnly fn2 true
                    push ownPairs pair2
                }
                k = (k + 1)
            }
        }
        def pairs:[string]
        def i 0
        while (i < (array_length extendsNames)) {
            def parent:string (itemAt extendsNames i)
            def pcsv@(optional):string (get interfaceFieldsCsv parent)
            if (!null? pcsv) {
                def ppairs:[string] (this.splitCsv((unwrap pcsv)))
                def j 0
                while (j < (array_length ppairs)) {
                    def pair:string (itemAt ppairs j)
                    def colon:int (indexOf pair ":")
                    if (colon > 0) {
                        def fn:string (substring pair 0 colon)
                        def was@(optional):boolean (get ownOnly fn)
                        if (null? was) {
                            push pairs pair
                        }
                    }
                    j = (j + 1)
                }
            }
            i = (i + 1)
        }
        def m 0
        while (m < (array_length ownPairs)) {
            push pairs (itemAt ownPairs m)
            m = (m + 1)
        }
        return (this.joinCsv(pairs))
    }

    fn emitInterfaces:void () {
        def i 0
        while (i < (array_length interfaceNames)) {
            def name:string (itemAt interfaceNames i)
            this.emitLine(("class " + (name + "Native {")))
            def csv@(optional):string (get interfaceFieldsCsv name)
            if (!null? csv) {
                def pairs:[string] (this.splitCsv((unwrap csv)))
                def j 0
                while (j < (array_length pairs)) {
                    def pair:string (itemAt pairs j)
                    def colon:int (indexOf pair ":")
                    if (colon > 0) {
                        def fname:string (substring pair 0 colon)
                        def ftype:string (substring pair (colon + 1) (strlen pair))
                        this.emitLine(("    def " + fname) + ((":" + ftype) + (" " + (this.zeroFor(ftype)))))
                    }
                    j = (j + 1)
                }
            }
            this.emitLine("}")
            this.emitLine("")
            i = (i + 1)
        }
    }

    fn zeroFor:string (t:string) {
        if (t == "double") { return "0.0" }
        if (t == "int") { return "0" }
        if (t == "i32") { return "0" }
        if (t == "u8") { return "0" }
        if (t == "u16") { return "0" }
        if (t == "u32") { return "0" }
        if (t == "f32") { return "0.0" }
        if (t == "f64") { return "0.0" }
        if (t == "string") { return "\"\"" }
        if (t == "boolean") { return "false" }
        ; arrays / structs: default-constructed
        def first:string (substring t 0 1)
        if (first == "[") { return "" }
        return ("(new " + (t + ")"))
    }

    fn emitModuleSingleton:void (ast:TSNode) {
        this.emitLine(("class " + moduleSingletonClass) + " @singleton(true) {")
        def needsCtor:boolean false
        def i 0
        while (i < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children i)
            if (node.nodeType == "VariableDeclaration") {
                def j 0
                while (j < (array_length node.children)) {
                    def d:TSNode (itemAt node.children j)
                    if (d.nodeType == "VariableDeclarator") {
                        def isArr@(optional):boolean (get constArrayNames d.name)
                        if (!null? isArr) {
                            needsCtor = true
                            def elem@(optional):string (get constArrayElemType d.name)
                            def et:string "int"
                            if (!null? elem) { et = (unwrap elem) }
                            this.emitLine((("    def " + d.name) + ":[" + et) + "]")
                        } {
                            def dep@(optional):boolean (get moduleConstDeferred d.name)
                            if (!null? dep) {
                                needsCtor = true
                                if (d.init) {
                                    def initNode:TSNode (unwrap d.init)
                                    def ct:string (this.exprType(initNode))
                                    def stored@(optional):string (get constScalarTypes d.name)
                                    if (!null? stored) { ct = (unwrap stored) }
                                    this.emitLine((("    def " + d.name) + (":" + ct)) + ((" " + (this.zeroFor(ct)))))
                                }
                            } {
                                if (d.init) {
                                    def initNode2:TSNode (unwrap d.init)
                                    def ct2:string (this.exprType(initNode2))
                                    def rhs:string ""
                                    def fv@(optional):string (get constScalarValues d.name)
                                    if (!null? fv) {
                                        rhs = (unwrap fv)
                                    } {
                                        rhs = (this.emitExpr(initNode2 ct2))
                                    }
                                    this.emitLine((("    def " + d.name) + (":" + ct2)) + ((" " + rhs)))
                                }
                            }
                        }
                    }
                    j = (j + 1)
                }
            }
            i = (i + 1)
        }
        if (needsCtor) {
            this.emitLine("    Constructor () {")
            this.indentLevel = 2
            inModuleSingletonCtor = true
            def k 0
            while (k < (array_length ast.children)) {
                def node2:TSNode (itemAt ast.children k)
                if (node2.nodeType == "VariableDeclaration") {
                    def m 0
                    while (m < (array_length node2.children)) {
                        def d2:TSNode (itemAt node2.children m)
                        if (d2.nodeType == "VariableDeclarator") {
                            def isArr2@(optional):boolean (get constArrayNames d2.name)
                            if (!null? isArr2) {
                                def elem2@(optional):string (get constArrayElemType d2.name)
                                def et2:string "int"
                                if (!null? elem2) { et2 = (unwrap elem2) }
                                def tmpName:string (("_boot_" + d2.name))
                                this.emitLine((("def " + tmpName) + ":[" + et2) + "]")
                                if (d2.init) {
                                    def arr:TSNode (unwrap d2.init)
                                    if (arr.nodeType == "ArrayExpression") {
                                        def n 0
                                        while (n < (array_length arr.children)) {
                                            def el:TSNode (itemAt arr.children n)
                                            def ev:string (this.emitValueExpr(el et2))
                                            this.emitLine(((("push " + tmpName) + " ") + ev))
                                            n = (n + 1)
                                        }
                                    }
                                }
                                this.emitLine((d2.name + (" = " + tmpName)))
                            }
                            def dep2@(optional):boolean (get moduleConstDeferred d2.name)
                            if (!null? dep2) {
                                if (d2.init) {
                                    def init3:TSNode (unwrap d2.init)
                                    if (init3.nodeType == "ObjectExpression") {
                                        def ost2@(optional):string (get constScalarTypes d2.name)
                                        def ostype:string "int"
                                        if (!null? ost2) { ostype = (unwrap ost2) }
                                        def tmpO:string (("_boot_" + d2.name))
                                        this.emitStructFromObject(init3 tmpO ostype)
                                        this.emitLine((d2.name + (" = " + tmpO)))
                                    } {
                                        def ct3:string (this.exprType(init3))
                                        def rhs3:string (this.emitExpr(init3 ct3))
                                        this.emitLine((d2.name + (" = " + rhs3)))
                                    }
                                }
                            }
                        }
                        m = (m + 1)
                    }
                }
                k = (k + 1)
            }
            this.indentLevel = 0
            inModuleSingletonCtor = false
            this.emitLine("    }")
        }
        this.emitLine("}")
    }

    fn emitConstFields:void (ast:TSNode) {
        def i 0
        while (i < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children i)
            if (node.nodeType == "VariableDeclaration") {
                def j 0
                while (j < (array_length node.children)) {
                    def d:TSNode (itemAt node.children j)
                    if (d.nodeType == "VariableDeclarator") {
                        def isArr@(optional):boolean (get constArrayNames d.name)
                        if (null? isArr) {
                            if (d.init) {
                                def initNode:TSNode (unwrap d.init)
                                def ct:string (this.exprType(initNode))
                                def rhs:string ""
                                def fv@(optional):string (get constScalarValues d.name)
                                if (!null? fv) {
                                    rhs = (unwrap fv)
                                } {
                                    rhs = (this.emitExpr(initNode ct))
                                }
                                this.emitLine((("    def " + d.name) + (":" + ct)) + ((" " + rhs)))
                            }
                        }
                    }
                    j = (j + 1)
                }
            }
            i = (i + 1)
        }
        this.emitLine("")
    }

    ; const string-array (and array-of-array) tables -> methods returning a fresh
    ; list. References to the name are rewritten to `(this.NAME())`.
    fn emitConstArrayMethods:void (node:TSNode) {
        def j 0
        while (j < (array_length node.children)) {
            def d:TSNode (itemAt node.children j)
            if (d.nodeType == "VariableDeclarator") {
                def isArr@(optional):boolean (get constArrayNames d.name)
                if (!null? isArr) {
                    def elem@(optional):string (get constArrayElemType d.name)
                    def et:string "int"
                    if (!null? elem) { et = (unwrap elem) }
                    this.emitLine(((("    fn " + d.name) + ":[") + et) + "] () {")
                    this.emitLine(("        def out:[" + et) + "]")
                    if (d.init) {
                        def arr:TSNode (unwrap d.init)
                        if (arr.nodeType == "ArrayExpression") {
                            def k 0
                            while (k < (array_length arr.children)) {
                                def el:TSNode (itemAt arr.children k)
                                def ev:string (this.emitExpr(el et))
                                this.emitLine((("        push out " + ev)))
                                k = (k + 1)
                            }
                        }
                    }
                    this.emitLine("        return out")
                    this.emitLine("    }")
                    this.emitLine("")
                }
            }
            j = (j + 1)
        }
    }

    fn emitFunction:void (node:TSNode) {
        currentFn = node.name
        inferFnName = node.name
        inSpritesFn = (currentFn == "sprites")
        inInitFn = (currentFn == "initState")
        inUpdateFn = (currentFn == "update")
        inResourcesFn = (currentFn == "resources")
        def fresh:[string:string]
        varTypes = fresh
        stateVarName = "s"
        def freshIds:[string]
        readEntityIds = freshIds
        def freshSeen:[string:boolean]
        readEntitySeen = freshSeen
        def freshPlayers:[string]
        readPlayerIndices = freshPlayers
        def freshPlayerSeen:[string:boolean]
        readPlayerSeen = freshPlayerSeen
        inputVarName = "input"

        def isHelper:boolean ((this.isSpecialFn(currentFn)) == false)

        def retType:string "void"
        if (inSpritesFn) {
            retType = "[SpriteDefNative]"
        }
        if (inResourcesFn) {
            retType = "[ResourceDefNative]"
        }
        if (inInitFn) {
            retType = "NativeGameState"
        }
        if (inUpdateFn) {
            retType = "NativeGameState"
        }
        if (currentFn == "hud") {
            this.emitLine(("    fn hud:void (props:UpdatePropsNative) {"))
            this.emitLine("        ; omitted on native path (score drawn by NativeGameRunner)")
            this.emitLine("    }")
            this.emitLine("")
            return
        }
        if (isHelper) {
            retType = (this.helperReturnType(currentFn))
        }

        def params:string (this.emitParams(node.params))
        this.emitLine((("    fn " + currentFn) + (":" + retType)) + ((" (" + params) + ") {"))

        if (null? node.body) {
            this.emitLine("    }")
            return
        }
        def body:TSNode (unwrap node.body)
        this.indentLevel = 2
        this.emitModuleLocalIfNeeded(body)
        if (inUpdateFn) {
            this.prescanStateVar(body)
            this.collectEntityReads(body)
            this.collectInputPlayerReads(body)
            this.emitStateBinding(body)
            this.emitEntityHoists()
            this.emitInputPlayerHoists()
            this.emitBlockBodySkippingStateDecl(body)
        } {
            this.emitBlockBody(body)
        }
        this.indentLevel = 0
        this.emitLine("    }")
        this.emitLine("")
    }

    ; Emit `def s:NativeGameState (props.state)` if the script declared it.
    fn emitStateBinding:void (body:TSNode) {
        this.emitLine((("def " + stateVarName) + ":NativeGameState (props.state)"))
        set varTypes stateVarName "NativeGameState"
    }

    ; Hoist entity reads to typed locals so `.field` access is legal Ranger.
    fn emitEntityHoists:void () {
        def i 0
        while (i < (array_length readEntityIds)) {
            def id:string (itemAt readEntityIds i)
            this.emitLine(((("def in_" + id) + ":EntityPoseNative (unwrap (get ") + stateVarName) + (".entities \"" + id) + "\"))")
            i = (i + 1)
        }
    }

    fn emitBlockBodySkippingStateDecl:void (block:TSNode) {
        def i 0
        while (i < (array_length block.children)) {
            def stmt:TSNode (itemAt block.children i)
            if (this.isStateVarDecl(stmt)) {
                i = (i + 1)
                continue
            }
            this.emitStatement(stmt)
            i = (i + 1)
        }
    }

    fn isStateVarDecl:boolean (stmt:TSNode) {
        if (stmt.nodeType != "VariableDeclaration") {
            return false
        }
        def i 0
        while (i < (array_length stmt.children)) {
            def d:TSNode (itemAt stmt.children i)
            if (d.nodeType == "VariableDeclarator") {
                if (d.name == stateVarName) {
                    if (d.init) {
                        def initNode:TSNode (unwrap d.init)
                        if (this.isPropsStateMember(initNode)) {
                            return true
                        }
                    }
                }
                if (d.init) {
                    def initNode2:TSNode (unwrap d.init)
                    if (this.isPropsInputMember(initNode2)) {
                        inputVarName = d.name
                    }
                }
            }
            i = (i + 1)
        }
        return false
    }

    fn isPropsInputMember:boolean (node:TSNode) {
        if (node.nodeType != "MemberExpression") {
            return false
        }
        if (node.name != "input") {
            return false
        }
        if (null? node.left) {
            return false
        }
        def base:TSNode (unwrap node.left)
        if (base.nodeType != "Identifier") {
            return false
        }
        return (base.name == "props")
    }

    fn isPropsStateMember:boolean (node:TSNode) {
        if (node.nodeType != "MemberExpression") {
            return false
        }
        if (node.name != "state") {
            return false
        }
        if (null? node.left) {
            return false
        }
        def base:TSNode (unwrap node.left)
        if (base.nodeType == "Identifier") {
            return (base.name == "props")
        }
        return false
    }

    ; Find `const <x> = props.state` and record x as the state variable name.
    fn prescanStateVar:void (node:TSNode) {
        if (node.nodeType == "VariableDeclaration") {
            def i 0
            while (i < (array_length node.children)) {
                def d:TSNode (itemAt node.children i)
                if (d.nodeType == "VariableDeclarator") {
                    if (d.init) {
                        if (this.isPropsStateMember((unwrap d.init))) {
                            stateVarName = d.name
                        }
                        if (this.isPropsInputMember((unwrap d.init))) {
                            inputVarName = d.name
                        }
                    }
                }
                i = (i + 1)
            }
        }
        this.walkChildren(node "prescanStateVar")
    }

    ; Collect entity ids read via <stateVar>.entities.<id>.
    fn collectEntityReads:void (node:TSNode) {
        if (node.nodeType == "MemberExpression") {
            if (node.left) {
                def base:TSNode (unwrap node.left)
                if (base.nodeType == "MemberExpression") {
                    if (base.name == "entities") {
                        def id:string node.name
                        if ((strlen id) > 0) {
                            def seen@(optional):boolean (get readEntitySeen id)
                            if (null? seen) {
                                set readEntitySeen id true
                                push readEntityIds id
                            }
                        }
                    }
                }
            }
        }
        this.walkChildren(node "collectEntityReads")
    }

    ; True when `node` is `input.players[i].<field>`; returns index string via out param pattern.
    fn inputPlayerIndex:string (node:TSNode) {
        if (node.nodeType != "MemberExpression") {
            return ""
        }
        if (null? node.left) {
            return ""
        }
        def idxAccess:TSNode (unwrap node.left)
        if (idxAccess.nodeType != "MemberExpression") {
            return ""
        }
        if (idxAccess.computed == false) {
            return ""
        }
        if (null? idxAccess.left) {
            return ""
        }
        def playersAccess:TSNode (unwrap idxAccess.left)
        if (playersAccess.nodeType != "MemberExpression") {
            return ""
        }
        if (playersAccess.name != "players") {
            return ""
        }
        if (null? playersAccess.left) {
            return ""
        }
        def root:TSNode (unwrap playersAccess.left)
        if (root.nodeType != "Identifier") {
            return ""
        }
        if (root.name != inputVarName) {
            return ""
        }
        if (null? idxAccess.right) {
            return ""
        }
        def idxNode:TSNode (unwrap idxAccess.right)
        if (idxNode.nodeType != "NumericLiteral") {
            return ""
        }
        return idxNode.value
    }

    ; Collect input.players[i] reads for hoist locals (itemAt .field is illegal).
    fn collectInputPlayerReads:void (node:TSNode) {
        def idx:string (this.inputPlayerIndex(node))
        if ((strlen idx) > 0) {
            def seen@(optional):boolean (get readPlayerSeen idx)
            if (null? seen) {
                set readPlayerSeen idx true
                push readPlayerIndices idx
            }
        }
        this.walkChildren(node "collectInputPlayerReads")
    }

    fn emitInputPlayerHoists:void () {
        def i 0
        while (i < (array_length readPlayerIndices)) {
            def idx:string (itemAt readPlayerIndices i)
            def localName:string (("in_pl" + idx))
            this.emitLine(((("def " + localName) + ":PlayerInputNative (itemAt props.input.players ") + idx) + ")")
            i = (i + 1)
        }
    }

    ; Generic child walk dispatching to a named visitor.
    fn walkChildren:void (node:TSNode visitor:string) {
        if (node.left) {
            this.dispatchVisit((unwrap node.left) visitor)
        }
        if (node.right) {
            this.dispatchVisit((unwrap node.right) visitor)
        }
        if (node.body) {
            this.dispatchVisit((unwrap node.body) visitor)
        }
        if (node.init) {
            this.dispatchVisit((unwrap node.init) visitor)
        }
        if (node.test) {
            this.dispatchVisit((unwrap node.test) visitor)
        }
        if (node.consequent) {
            this.dispatchVisit((unwrap node.consequent) visitor)
        }
        if (node.alternate) {
            this.dispatchVisit((unwrap node.alternate) visitor)
        }
        def i 0
        while (i < (array_length node.children)) {
            this.dispatchVisit((itemAt node.children i) visitor)
            i = (i + 1)
        }
    }

    fn dispatchVisit:void (node:TSNode visitor:string) {
        if (visitor == "prescanStateVar") {
            this.prescanStateVar(node)
            return
        }
        if (visitor == "collectEntityReads") {
            this.collectEntityReads(node)
            return
        }
        if (visitor == "collectInputPlayerReads") {
            this.collectInputPlayerReads(node)
            return
        }
    }

    fn emitParams:string (params:[TSNode]) {
        if (inUpdateFn) {
            set varTypes "props" "UpdatePropsNative"
            return "props:UpdatePropsNative"
        }
        def parts:[string]
        def i 0
        while (i < (array_length params)) {
            def p:TSNode (itemAt params i)
            def pt:string "int"
            if (p.typeAnnotation) {
                pt = (this.annotType((unwrap p.typeAnnotation)))
            } {
                def fromReg:string (this.helperParamType(currentFn i))
                if ((strlen fromReg) > 0) {
                    pt = fromReg
                }
            }
            set varTypes p.name pt
            push parts ((p.name + ":") + (this.fnSigType(pt)))
            i = (i + 1)
        }
        return (this.joinSpace(parts))
    }

    fn joinSpace:string (items:[string]) {
        def out:string ""
        def i 0
        while (i < (array_length items)) {
            if (i > 0) {
                out = (out + " ")
            }
            out = (out + (itemAt items i))
            i = (i + 1)
        }
        return out
    }

    fn emitBlockBody:void (block:TSNode) {
        currentEmitBlock = block
        def i 0
        while (i < (array_length block.children)) {
            def stmt:TSNode (itemAt block.children i)
            this.emitStatement(stmt)
            i = (i + 1)
        }
    }

    fn emitStatement:void (stmt:TSNode) {
        def t:string stmt.nodeType
        ; Hoist `X[i]`-as-field-receiver to typed locals before this statement.
        this.hoistStmtItemAt(stmt)
        if (t == "VariableDeclaration") {
            this.emitVarDecl(stmt)
            return
        }
        if (t == "IfStatement") {
            this.emitIf(stmt)
            return
        }
        if (t == "ReturnStatement") {
            this.emitReturn(stmt)
            return
        }
        if (t == "ExpressionStatement") {
            this.emitExpressionStatement(stmt)
            return
        }
        if (t == "WhileStatement") {
            this.emitWhile(stmt)
            return
        }
        if (t == "BlockStatement") {
            this.emitBlockBody(stmt)
            return
        }
    }

    ; Reset + collect `X[i].field` receivers in this statement's own expressions
    ; (test/left/right/init, not nested block bodies), emitting a typed local for
    ; each distinct `X[i]` so `.field` reads and writes go through it.
    fn hoistStmtItemAt:void (stmt:TSNode) {
        def fresh:[string:string]
        hoistedItemAt = fresh
        this.collectItemAtReceivers(stmt)
    }

    fn collectItemAtReceivers:void (node:TSNode) {
        if (node.nodeType == "IfStatement") {
            if (node.left) {
                this.collectItemAtReceivers((unwrap node.left))
            }
            if (node.body) {
                this.collectItemAtReceiversInStmt((unwrap node.body))
            }
            if (node.right) {
                this.collectItemAtReceiversInStmt((unwrap node.right))
            }
            return
        }
        if (node.nodeType == "WhileStatement") {
            if (node.test) {
                this.collectItemAtReceivers((unwrap node.test))
            }
            return
        }
        ; A field access `M.field` whose base is a computed member `base[idx]`.
        if (node.nodeType == "MemberExpression") {
            if (node.computed == false) {
                if (node.left) {
                    def base:TSNode (unwrap node.left)
                    if (base.nodeType == "MemberExpression") {
                        if (base.computed) {
                            this.registerItemAtHoist(base)
                        }
                    }
                }
            }
        }
        ; Recurse into this statement's expressions but not nested block bodies
        ; (those hoist per-statement themselves, keeping loop indices current).
        if (node.left) {
            def ln:TSNode (unwrap node.left)
            if (ln.nodeType != "BlockStatement") {
                this.collectItemAtReceivers(ln)
            }
        }
        if (node.right) {
            def rn:TSNode (unwrap node.right)
            if (rn.nodeType != "BlockStatement") {
                this.collectItemAtReceivers(rn)
            }
        }
        if (node.test) {
            this.collectItemAtReceivers((unwrap node.test))
        }
        def i 0
        while (i < (array_length node.children)) {
            def ch:TSNode (itemAt node.children i)
            if (ch.nodeType != "BlockStatement") {
                this.collectItemAtReceivers(ch)
            }
            i = (i + 1)
        }
    }

    fn collectItemAtReceiversInStmt:void (stmt:TSNode) {
        if (stmt.nodeType == "BlockStatement") {
            def i 0
            while (i < (array_length stmt.children)) {
                this.collectItemAtReceivers((itemAt stmt.children i))
                i = (i + 1)
            }
            return
        }
        this.collectItemAtReceivers(stmt)
    }

    fn registerItemAtHoist:void (computed:TSNode) {
        if (null? computed.left) {
            return
        }
        if (null? computed.right) {
            return
        }
        def baseType:string (this.exprType((unwrap computed.left)))
        def et:string (this.elemTypeOf(baseType))
        ; Only hoist struct element types (bare .field access is illegal on them).
        if ((this.endsWith(et "Native")) == false) {
            return
        }
        def raw:string (this.rawItemAt(computed))
        def existing@(optional):string (get hoistedItemAt raw)
        if (!null? existing) {
            return
        }
        def localName:string ("_at" + ("" + itemAtCounter))
        itemAtCounter = (itemAtCounter + 1)
        set hoistedItemAt raw localName
        this.emitLine(((((("def " + localName) + ":") + et) + " ") + raw))
    }

    ; The `(itemAt base idx)` string for a computed member, without hoist rewrite.
    fn rawItemAt:string (computed:TSNode) {
        def base:string (this.emitExpr((unwrap computed.left) "int"))
        def idxNode:TSNode (unwrap computed.right)
        def idxT:string (this.exprType(idxNode))
        def idx:string (this.emitExpr(idxNode idxT))
        if (idxT == "double") {
            idx = (("(to_int " + idx) + ")")
        }
        return (((("(itemAt " + base) + " ") + idx) + ")")
    }

    ; while (cond) { body } - Ranger shares this exact form.
    fn emitWhile:void (node:TSNode) {
        def cond:string "false"
        if (node.left) {
            cond = (this.emitExpr((unwrap node.left) "boolean"))
        }
        this.emitLine(("while (" + cond) + ") {")
        this.indent()
        if (node.body) {
            def b:TSNode (unwrap node.body)
            if (b.nodeType == "BlockStatement") {
                this.emitBlockBody(b)
            } {
                this.emitStatement(b)
            }
        }
        this.dedent()
        this.emitLine("}")
    }

    ; ==========================================================================
    ; Statements
    ; ==========================================================================

    fn emitExpressionStatement:void (stmt:TSNode) {
        if (null? stmt.left) {
            return
        }
        def expr:TSNode (unwrap stmt.left)
        if (expr.nodeType == "AssignmentExpression") {
            this.emitAssignment(expr)
            return
        }
        if (expr.nodeType == "CallExpression") {
            this.emitCallStatement(expr)
            return
        }
    }

    fn emitCallStatement:void (node:TSNode) {
        if (null? node.left) {
            return
        }
        def callee:TSNode (unwrap node.left)
        ; a.push(x) -> push a x
        if (callee.nodeType == "MemberExpression") {
            if (callee.name == "push") {
                if (callee.left) {
                    def base:string (this.emitExpr((unwrap callee.left) "int"))
                    def et:string (this.elemTypeOf((this.exprType((unwrap callee.left)))))
                    def argStr:string ""
                    if ((array_length node.children) > 0) {
                        def argNode:TSNode (itemAt node.children 0)
                        argStr = (this.emitValueExpr(argNode et))
                        if (argNode.nodeType == "CallExpression") {
                            argStr = (("(" + argStr) + ")")
                        }
                    }
                    this.emitLine(((("push " + base) + " ") + argStr))
                    return
                }
            }
        }
        ; void helper call as a statement
        this.emitLine((this.emitCall(node)))
    }

    fn emitAssignment:void (node:TSNode) {
        def targetNode:TSNode (unwrap node.left)
        def rhsNode:TSNode (unwrap node.right)
        if (targetNode.nodeType == "MemberExpression") {
            this.emitMemberAssign(targetNode rhsNode)
            return
        }
        def lhs:string (this.emitAssignTarget(targetNode))
        def expected:string (this.assignTargetType(targetNode))
        def rhs:string (this.emitExpr(rhsNode expected))
        rhs = (this.coerceToType(rhs rhsNode expected))
        this.emitLine((lhs + " = ") + rhs)
        if (targetNode.nodeType == "Identifier") {
            def rhsT:string (this.exprType(rhsNode))
            if (rhsT == "double") {
                if (expected == "int") {
                    set varTypes targetNode.name "double"
                }
            }
        }
    }

    fn emitMemberAssign:void (target:TSNode rhs:TSNode) {
        if (null? target.left) {
            return
        }
        def baseNode:TSNode (unwrap target.left)
        def baseType:string (this.exprType(baseNode))
        def base:string (this.emitExpr(baseNode "int"))
        ; state array field write: s.alive = ... (rare)
        ; map with string key: entities.shot = {...} or entities[id] = {...}
        if (this.startsWith(baseType "[string:")) {
            def valType:string (this.elemTypeOf(baseType))
            def key:string ""
            if (target.computed) {
                if (target.right) {
                    def keyNode:TSNode (unwrap target.right)
                    key = (this.emitExpr(keyNode "string"))
                    if (keyNode.nodeType == "CallExpression") {
                        key = (("(" + key) + ")")
                    }
                }
            } {
                key = ("\"" + target.name) + "\""
            }
            def valExpr:string (this.emitRhsValue(rhs valType))
            this.emitLine((((("set " + base) + " ") + key) + " ") + valExpr)
            return
        }
        ; array element write: a[i] = v
        if (target.computed) {
            def et:string (this.elemTypeOf(baseType))
            def idxT:string "int"
            def idx:string "0"
            if (target.right) {
                idxT = (this.exprType((unwrap target.right)))
                idx = (this.emitExpr((unwrap target.right) idxT))
                if (idxT == "double") {
                    idx = (("(to_int " + idx) + ")")
                }
            }
            def valExpr:string (this.emitRhsValue(rhs et))
            valExpr = (this.coerceToType(valExpr rhs et))
            this.emitLine((((("set " + base) + " ") + idx) + " ") + valExpr)
            return
        }
        ; struct field assignment: obj.prop = v
        if (baseNode.nodeType == "Identifier") {
            def bvt:string (this.lookupVarType(baseNode.name))
            if (bvt == "NativeGameState") {
                if (this.isObjectStateField(target.name)) {
                    def ost:string (this.objectStateFieldTypeOf(target.name))
                    def valExpr:string (this.emitRhsValue(rhs ost))
                    this.emitLine(("st_" + target.name) + (" = " + valExpr))
                    return
                }
                if ((this.isNativeStateField(target.name)) == false) {
                    if ((this.isStateArrayField(target.name)) == false) {
                        def valNum:string (this.emitRhsValue(rhs "double"))
                        this.emitLine((((("set " + baseNode.name) + ".numbers \"") + target.name) + "\" ") + valNum)
                        return
                    }
                }
            }
        }
        def ft:string (this.structFieldType(baseType target.name))
        if ((strlen ft) == 0) {
            ft = (this.fieldType(target.name))
        }
        def v:string (this.emitExpr(rhs ft))
        if (ft == "double") {
            def rt:string (this.exprType(rhs))
            if (rt == "int") {
                if (rhs.nodeType != "NumericLiteral") {
                    if (rhs.nodeType != "Identifier") {
                        def skip:boolean false
                        if ((strlen v) >= 4) {
                            if ((substring v 0 4) == "(0.0") {
                                skip = true
                            }
                        }
                        if ((strlen v) >= 10) {
                            if ((substring v 0 10) == "(to_double") {
                                skip = true
                            }
                        }
                        if (skip == false) {
                            v = ("(to_double " + v) + ")"
                        }
                    }
                }
            }
        }
        this.emitLine(((base + ".") + target.name) + (" = " + v))
    }

    fn emitRhsValue:string (node:TSNode expected:string) {
        return (this.emitValueExpr(node expected))
    }

    ; Materialize a value into an expression string, emitting temp bindings for
    ; nested object/array literals so they get correct static types.
    fn emitValueExpr:string (node:TSNode expected:string) {
        if (node.nodeType == "ObjectExpression") {
            if (this.endsWith(expected "Native")) {
                if ((array_length node.children) == 0) {
                    return ("(new " + expected) + ")")
                }
                def tmp:string ("tmp" + ("" + tmpCounter))
                tmpCounter = (tmpCounter + 1)
                this.emitStructFromObject(node tmp expected)
                return tmp
            }
        }
        if (node.nodeType == "ArrayExpression") {
            if (this.startsWith(expected "[")) {
                def et:string (this.elemTypeOf(expected))
                def tmp2:string ("tmp" + ("" + tmpCounter))
                tmpCounter = (tmpCounter + 1)
                this.emitLine((("def " + tmp2) + ":") + expected)
                def k 0
                while (k < (array_length node.children)) {
                    def el:TSNode (itemAt node.children k)
                    def ev:string (this.emitValueExpr(el et))
                    this.emitLine(((("push " + tmp2) + " ") + ev))
                    k = (k + 1)
                }
                return tmp2
            }
        }
        return (this.emitExpr(node expected))
    }

    fn startsWith:boolean (s:string prefix:string) {
        def plen (strlen prefix)
        if (plen > (strlen s)) {
            return false
        }
        return ((substring s 0 plen) == prefix)
    }

    fn assignTargetType:string (node:TSNode) {
        if (node.nodeType == "Identifier") {
            def vt:string (this.lookupVarType(node.name))
            if ((strlen vt) > 0) {
                return vt
            }
            return "int"
        }
        if (node.nodeType == "MemberExpression") {
            return (this.fieldType(node.name))
        }
        return "int"
    }

    fn emitAssignTarget:string (node:TSNode) {
        if (node.nodeType == "Identifier") {
            return node.name
        }
        if (node.nodeType == "MemberExpression") {
            return (this.emitMember(node "int"))
        }
        return "tmp"
    }

    fn emitVarDecl:void (node:TSNode) {
        def i 0
        while (i < (array_length node.children)) {
            def d:TSNode (itemAt node.children i)
            if (d.nodeType != "VariableDeclarator") {
                i = (i + 1)
                continue
            }
            def name:string d.name
            def hasAnnot:boolean false
            def rtype:string "int"
            if (d.typeAnnotation) {
                rtype = (this.annotType((unwrap d.typeAnnotation)))
                hasAnnot = true
            }
            if (null? d.init) {
                set varTypes name rtype
                this.emitLine(("def " + name) + (":" + rtype))
                i = (i + 1)
                continue
            }
            def initNode:TSNode (unwrap d.init)
            if (hasAnnot == false) {
                rtype = (this.exprType(initNode))
            }
            if (initNode.nodeType == "ObjectExpression") {
                if ((this.endsWith(rtype "Native")) == false) {
                    def known:string (this.matchKnownStruct(initNode))
                    if ((strlen known) > 0) {
                        rtype = known
                    } {
                        def iface:string (this.matchRecordedInterface(initNode))
                        if ((strlen iface) > 0) {
                            rtype = iface
                        }
                    }
                }
            }
            if (initNode.nodeType == "NumericLiteral") {
                if (inUpdateFn) {
                    if (this.endsWith(name "vy")) {
                        rtype = "double"
                    }
                }
            }
            ; Empty array literal: infer element type from later push() calls
            ; in this block (same logic as prescan localInitType).
            if (initNode.nodeType == "ArrayExpression") {
                if ((array_length initNode.children) == 0) {
                    def pushed:string (this.findPushArgType(currentEmitBlock name))
                    if ((strlen pushed) > 0) {
                        rtype = (("[" + pushed) + "]")
                    }
                    if ((inUpdateFn) && (name == "events")) {
                        if ((strlen pushed) == 0) {
                            rtype = "[GameEventNative]"
                        }
                    }
                    if ((strlen pushed) == 0) {
                        def annElem:string (this.helperAnnotatedArrayElem(currentFn))
                        if ((strlen annElem) > 0) {
                            rtype = (("[" + annElem) + "]")
                        }
                    }
                    if ((strlen pushed) == 0) {
                        if (inUpdateFn) {
                            def ost:string (this.objectStateFieldTypeOf(name))
                            if (this.startsWith(ost "[")) {
                                rtype = ost
                            }
                        }
                    }
                }
            }
            set varTypes name rtype
            ; array literal initializer
            if (initNode.nodeType == "ArrayExpression") {
                def et:string (this.elemTypeOf(rtype))
                this.emitLine((("def " + name) + ":") + rtype)
                def k 0
                while (k < (array_length initNode.children)) {
                    def el:TSNode (itemAt initNode.children k)
                    def ev:string (this.emitValueExpr(el et))
                    this.emitLine(((("push " + name) + " ") + ev))
                    k = (k + 1)
                }
                i = (i + 1)
                continue
            }
            ; object literal bound to a synthesized struct
            if (initNode.nodeType == "ObjectExpression") {
                if (this.endsWith(rtype "Native")) {
                    this.emitStructFromObject(initNode name rtype)
                    i = (i + 1)
                    continue
                }
                ; empty object as a map/array -> default-constructed
                if ((array_length initNode.children) == 0) {
                    if (this.startsWith(rtype "[")) {
                        this.emitLine((("def " + name) + ":") + rtype)
                        i = (i + 1)
                        continue
                    }
                }
            }
            def rhs:string (this.emitExpr(initNode rtype))
            this.emitLine((("def " + name) + (":" + rtype)) + ((" (" + rhs) + ")"))
            i = (i + 1)
        }
    }

    ; def <var>:<StructNative> (new <StructNative>) + field assignments.
    fn emitStructFromObject:void (node:TSNode varName:string structType:string) {
        this.emitLine(((("def " + varName) + ":") + structType) + ((" (new " + structType) + ")"))
        def i 0
        while (i < (array_length node.children)) {
            def prop:TSNode (itemAt node.children i)
            if (prop.nodeType == "Property") {
                def key:string (this.propKey(prop))
                def ft:string (this.structFieldType(structType key))
                if ((strlen ft) == 0) {
                    ft = (this.fieldType(key))
                }
                def valNode:TSNode (this.propertyValueNode(prop))
                def v:string (this.emitValueExpr(valNode ft))
                if (ft == "double") {
                    def rt:string (this.exprType(valNode))
                    if (rt == "int") {
                        def skip:boolean false
                        if ((strlen v) >= 10) {
                            if ((substring v 0 10) == "(to_double") {
                                skip = true
                            }
                        }
                        if (skip == false) {
                            if (valNode.nodeType != "NumericLiteral") {
                                if (valNode.nodeType != "Identifier") {
                                    if ((strlen v) >= 4) {
                                        if ((substring v 0 4) == "(0.0") {
                                            skip = true
                                        }
                                    }
                                    if (skip == false) {
                                        v = ("(to_double " + v) + ")"
                                    }
                                }
                            }
                        }
                    }
                }
                this.emitLine((varName + ".") + (key + (" = " + v)))
            }
            i = (i + 1)
        }
    }

    fn emitIf:void (node:TSNode) {
        if (inUpdateFn) {
            if (node.left) {
                def test:TSNode (unwrap node.left)
                if (test.nodeType == "Identifier") {
                    if (test.name == "input") {
                        if (node.body) {
                            def cons:TSNode (unwrap node.body)
                            if (cons.nodeType == "BlockStatement") {
                                this.emitBlockBody(cons)
                            } {
                                this.emitStatement(cons)
                            }
                        }
                        return
                    }
                }
                if (test.nodeType == "MemberExpression") {
                    if (test.computed) {
                        if (test.left) {
                            def base:TSNode (unwrap test.left)
                            if (base.nodeType == "MemberExpression") {
                                if (base.name == "players") {
                                    if (base.left) {
                                        def root:TSNode (unwrap base.left)
                                        if (root.nodeType == "Identifier") {
                                            if (root.name == "input") {
                                                def idxLit:string "0"
                                                if (test.right) {
                                                    def idxNode:TSNode (unwrap test.right)
                                                    if (idxNode.nodeType == "NumericLiteral") {
                                                        idxLit = idxNode.value
                                                    }
                                                }
                                                def minLen:string "1"
                                                if (idxLit == "1") {
                                                    minLen = "2"
                                                }
                                                if (idxLit == "2") {
                                                    minLen = "3"
                                                }
                                                def ifLine:string "if ((array_length input.players) >= "
                                                ifLine = (ifLine + minLen)
                                                ifLine = (ifLine + ") {")
                                                this.emitLine(ifLine)
                                                this.indent()
                                                if (node.body) {
                                                    def cons2:TSNode (unwrap node.body)
                                                    if (cons2.nodeType == "BlockStatement") {
                                                        this.emitBlockBody(cons2)
                                                    } {
                                                        this.emitStatement(cons2)
                                                    }
                                                }
                                                this.dedent()
                                                this.emitLine("}")
                                                return
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        ; `if (obj)` / `if (arr[i])` truthiness on a struct/array value: in the
        ; native model these are always present, so emit the body unconditionally
        ; (Ranger `if` requires a boolean/number, not an object).
        if (node.left) {
            def ttest:TSNode (unwrap node.left)
            if (this.isTruthyObjectTest(ttest)) {
                if (null? node.right) {
                    if (node.body) {
                        def tcons:TSNode (unwrap node.body)
                        if (tcons.nodeType == "BlockStatement") {
                            this.emitBlockBody(tcons)
                        } {
                            this.emitStatement(tcons)
                        }
                    }
                    return
                }
            }
        }
        def cond:string ""
        if (node.left) {
            def ttest2:TSNode (unwrap node.left)
            if (this.isTruthyObjectTest(ttest2)) {
                cond = "true"
            } {
                cond = (this.emitExpr(ttest2 "boolean"))
            }
        }
        this.emitLine(("if (" + cond) + ") {")
        this.indent()
        if (node.body) {
            def cons:TSNode (unwrap node.body)
            if (cons.nodeType == "BlockStatement") {
                this.emitBlockBody(cons)
            } {
                this.emitStatement(cons)
            }
        }
        this.dedent()
        if (node.right) {
            this.emitLine("} {")
            this.indent()
            def alt:TSNode (unwrap node.right)
            if (alt.nodeType == "BlockStatement") {
                this.emitBlockBody(alt)
            } {
                this.emitStatement(alt)
            }
            this.dedent()
            this.emitLine("}")
            return
        }
        this.emitLine("}")
    }

    ; True when a test expression is an object/array value used for truthiness
    ; (`if (other)`, `if (arr[i])`) rather than a boolean/numeric condition.
    fn isTruthyObjectTest:boolean (node:TSNode) {
        def t:string node.nodeType
        if (t == "Identifier") {
            if (this.startsWith(node.name "st_")) {
                return true
            }
            def vt:string (this.exprType(node))
            return (this.isStructOrArrayType(vt))
        }
        if (t == "MemberExpression") {
            ; a[i] element or a.field that resolves to a struct/array
            def vt2:string (this.exprType(node))
            if (this.isStructOrArrayType(vt2)) {
                ; but not `a.length` (int) or numeric fields
                if (node.name == "length") {
                    return false
                }
                return true
            }
        }
        return false
    }

    fn isStructOrArrayType:boolean (t:string) {
        if ((strlen t) == 0) {
            return false
        }
        if ((substring t 0 1) == "[") {
            return true
        }
        if (this.endsWith(t "Native")) {
            return true
        }
        return false
    }

    fn emitReturn:void (node:TSNode) {
        if (null? node.left) {
            this.emitLine("return")
            return
        }
        def val:TSNode (unwrap node.left)
        if (inSpritesFn) {
            if (val.nodeType == "ArrayExpression") {
                this.emitSpriteArrayReturn(val)
            } {
                def rs:string (this.emitExpr(val "[SpriteDefNative]"))
                this.emitLine(("return " + rs))
            }
            return
        }
        if (inResourcesFn) {
            this.emitResourceArrayReturn(val)
            return
        }
        if (inInitFn) {
            this.emitStateReturn(val false)
            return
        }
        if (inUpdateFn) {
            this.emitStateReturn(val true)
            return
        }
        ; helper function: return with the declared return type
        def rt:string (this.helperReturnType(currentFn))
        def expr:string (this.emitValueExpr(val rt))
        this.emitLine(("return " + expr))
    }

    ; ==========================================================================
    ; Structured returns (sprites / state)
    ; ==========================================================================

    fn emitSpriteArrayReturn:void (node:TSNode) {
        this.emitLine("def list:[SpriteDefNative]")
        if (node.nodeType != "ArrayExpression") {
            this.emitLine("return list")
            return
        }
        def i 0
        while (i < (array_length node.children)) {
            def elem:TSNode (itemAt node.children i)
            this.emitSpriteFromObject(elem ("d" + ("" + i)))
            i = (i + 1)
        }
        this.emitLine("return list")
    }

    fn emitResourceArrayReturn:void (node:TSNode) {
        this.emitLine("def list:[ResourceDefNative]")
        if (node.nodeType != "ArrayExpression") {
            this.emitLine("return list")
            return
        }
        def i 0
        while (i < (array_length node.children)) {
            def elem:TSNode (itemAt node.children i)
            this.emitResourceFromObject(elem ("r" + ("" + i)))
            i = (i + 1)
        }
        this.emitLine("return list")
    }

    fn emitResourceFromObject:void (node:TSNode varName:string) {
        if (node.nodeType != "ObjectExpression") {
            return
        }
        this.emitLine(("def " + varName) + ":ResourceDefNative (new ResourceDefNative)")
        def i 0
        while (i < (array_length node.children)) {
            def prop:TSNode (itemAt node.children i)
            if (prop.nodeType != "Property") {
                i = (i + 1)
                continue
            }
            def key:string (this.propKey(prop))
            def expected:string (this.fieldType(key))
            def val:string (this.emitPropertyValue(prop expected))
            this.emitLine((varName + ".") + (key + (" = " + val)))
            i = (i + 1)
        }
        this.emitLine(("push list " + varName))
    }

    fn emitSpriteFromObject:void (node:TSNode varName:string) {
        if (node.nodeType != "ObjectExpression") {
            return
        }
        this.emitLine(("def " + varName) + ":SpriteDefNative (new SpriteDefNative)")
        def i 0
        while (i < (array_length node.children)) {
            def prop:TSNode (itemAt node.children i)
            if (prop.nodeType != "Property") {
                i = (i + 1)
                continue
            }
            def key:string (this.propKey(prop))
            def expected:string (this.fieldType(key))
            def val:string (this.emitPropertyValue(prop expected))
            this.emitLine((varName + ".") + (key + (" = " + val)))
            i = (i + 1)
        }
        this.emitLine(("push list " + varName))
    }

    fn emitStateReturn:void (node:TSNode patch:boolean) {
        def target:string "s"
        if (patch) {
            target = "patch"
        }
        if (node.nodeType != "ObjectExpression") {
            if (node.nodeType == "CallExpression") {
                if (node.left) {
                    def callee:TSNode (unwrap node.left)
                    if (callee.nodeType == "Identifier") {
                        if (callee.name == "initState") {
                            def callExpr:string (this.emitCall(node))
                            this.emitLine(("return " + callExpr))
                            return
                        }
                        if (this.isKnownHelper(callee.name)) {
                            def callExpr:string (this.emitCall(node))
                            this.emitLine(("return " + callExpr))
                            return
                        }
                    }
                }
            }
            if (node.nodeType == "Identifier") {
                this.emitLine(("return " + node.name))
                return
            }
            this.emitLine(("def " + target) + ":NativeGameState (new NativeGameState)")
            this.emitLine(("return " + target))
            return
        }
        this.emitLine(("def " + target) + ":NativeGameState (new NativeGameState)")
        def i 0
        while (i < (array_length node.children)) {
            def prop:TSNode (itemAt node.children i)
            if (prop.nodeType != "Property") {
                i = (i + 1)
                continue
            }
            def key:string (this.propKey(prop))
            def valNode:TSNode (this.propertyValueNode(prop))
            if (key == "entities") {
                if (valNode.nodeType == "ObjectExpression") {
                    this.emitEntitiesMap(valNode target)
                } {
                    def ev:string (this.emitExpr(valNode "int"))
                    this.emitLine(((target + ".entities = ") + ev))
                }
            } {
                if (key == "events") {
                    this.emitEventsArray(valNode target)
                } {
                    if (this.isObjectStateField(key)) {
                        def ost:string (this.objectStateFieldTypeOf(key))
                        def oval:string (this.emitValueExpr(valNode ost))
                        this.emitLine((("st_" + key) + (" = " + oval)))
                    } {
                    if (this.isNativeStateField(key)) {
                        def expected:string (this.fieldType(key))
                        def val:string (this.emitExpr(valNode expected))
                        this.emitLine((target + ".") + (key + (" = " + val)))
                        if (key == "vx") {
                            this.emitLine((target + ".hasVx = true"))
                        }
                        if (key == "vy") {
                            this.emitLine((target + ".hasVy = true"))
                        }
                        if (key == "dt") {
                            this.emitLine((target + ".hasDt = true"))
                        }
                    } {
                        if (this.isStateArrayField(key)) {
                            def at:string (this.stateArrayType(key))
                            def aval:string (this.emitExpr(valNode at))
                            this.emitLine(((("set " + target) + ".intArrays \"") + key) + ("\" " + aval))
                        } {
                            def vt:string (this.exprType(valNode))
                            if (vt == "string") {
                                def sval:string (this.emitExpr(valNode "string"))
                                this.emitLine(((("set " + target) + ".strings \"") + key) + ("\" " + sval))
                            } {
                                def dval:string (this.emitExpr(valNode "double"))
                                this.emitLine(((("set " + target) + ".numbers \"") + key) + ("\" " + dval))
                            }
                        }
                    }
                    }
                }
            }
            i = (i + 1)
        }
        this.emitLine(("return " + target))
    }

    fn emitEventsArray:void (node:TSNode target:string) {
        this.emitLine(("def " + target) + "_events:[GameEventNative]")
        if (node.nodeType == "ArrayExpression") {
            def i 0
            while (i < (array_length node.children)) {
                def elem:TSNode (itemAt node.children i)
                this.emitEventFromObject(elem (target + ("_ev" + ("" + i))))
                i = (i + 1)
            }
        }
        this.emitLine(((target + ".events = ") + target) + "_events")
    }

    fn emitEventFromObject:void (node:TSNode varName:string) {
        if (node.nodeType != "ObjectExpression") {
            return
        }
        this.emitLine(("def " + varName) + ":GameEventNative (new GameEventNative)")
        def i 0
        while (i < (array_length node.children)) {
            def prop:TSNode (itemAt node.children i)
            if (prop.nodeType == "Property") {
                def key:string (this.propKey(prop))
                def expected:string (this.fieldType(key))
                def val:string (this.emitPropertyValue(prop expected))
                this.emitLine((varName + ".") + (key + (" = " + val)))
            }
            i = (i + 1)
        }
        ; extract enclosing list var name (varName is "<target>_ev<i>")
        def listName:string (this.eventListNameFor(varName))
        this.emitLine(("push " + listName) + (" " + varName))
    }

    ; "patch_ev0" -> "patch_events"; "s_ev2" -> "s_events"
    fn eventListNameFor:string (varName:string) {
        def idx:int (indexOf varName "_ev")
        if (idx < 0) {
            return "events"
        }
        def prefix:string (substring varName 0 idx)
        return (prefix + "_events")
    }

    fn emitEntitiesMap:void (node:TSNode target:string) {
        if (node.nodeType != "ObjectExpression") {
            return
        }
        def i 0
        while (i < (array_length node.children)) {
            def prop:TSNode (itemAt node.children i)
            if (prop.nodeType != "Property") {
                i = (i + 1)
                continue
            }
            def id:string (this.propKey(prop))
            def valNode:TSNode (this.propertyValueNode(prop))
            def poseName:string (("pose_" + id))
            this.emitLine(("def " + poseName) + ":EntityPoseNative (new EntityPoseNative)")
            if (valNode.nodeType == "ObjectExpression") {
                def j 0
                while (j < (array_length valNode.children)) {
                    def p2:TSNode (itemAt valNode.children j)
                    if (p2.nodeType == "Property") {
                        def k:string (this.propKey(p2))
                        def expected:string (this.fieldType(k))
                        def v:string (this.emitPropertyValue(p2 expected))
                        this.emitLine((poseName + ".") + (k + (" = " + v)))
                    }
                    j = (j + 1)
                }
            }
            this.emitLine(("set " + target) + (".entities \"" + id) + ("\" " + poseName))
            i = (i + 1)
        }
    }

    fn propertyValueNode:TSNode (prop:TSNode) {
        if (prop.left) {
            return (unwrap prop.left)
        }
        def empty (new TSNode())
        return empty
    }

    fn emitPropertyValue:string (prop:TSNode expected:string) {
        if (prop.left) {
            return (this.emitValueExpr((unwrap prop.left) expected))
        }
        return "0"
    }

    fn propKey:string (prop:TSNode) {
        if ((strlen prop.name) > 0) {
            return prop.name
        }
        if (prop.computed) {
            return ""
        }
        if (prop.left) {
            def left:TSNode (unwrap prop.left)
            if (left.nodeType == "Identifier") {
                return left.name
            }
        }
        return ""
    }

    ; ==========================================================================
    ; Expressions (type-directed: `expected` is the Ranger type of the context)
    ; ==========================================================================

    fn emitExpr:string (node:TSNode expected:string) {
        def t:string node.nodeType
        if (t == "NumericLiteral") {
            return (this.emitNumber(node.value expected))
        }
        if (t == "BooleanLiteral") {
            return node.value
        }
        if (t == "StringLiteral") {
            return ("\"" + node.value) + "\""
        }
        if (t == "Identifier") {
            def ca@(optional):boolean (get constArrayNames node.name)
            if (!null? ca) {
                if (inModuleSingletonCtor) {
                    return node.name
                }
                if ((strlen moduleSingletonClass) > 0) {
                    return (this.moduleConstAccess(node.name))
                }
                return ("(this." + node.name) + "())"
            }
            def cst@(optional):string (get constScalarTypes node.name)
            if (!null? cst) {
                def cstv:string (unwrap cst)
                def caccess:string node.name
                if (inModuleSingletonCtor) {
                    caccess = node.name
                } {
                    if ((strlen moduleSingletonClass) > 0) {
                        caccess = (this.moduleConstAccess(node.name))
                    } {
                        caccess = ("this." + node.name)
                    }
                }
                ; Coerce an int const used in a double context.
                if (expected == "double") {
                    if (cstv == "int") {
                        return ("(to_double " + caccess) + ")"
                    }
                }
                return caccess
            }
            ; Ambient engine globals resolve through the injected host object.
            if (this.isEngineGlobal(node.name)) {
                if (expected == "double") {
                    return ("(to_double host." + node.name) + ")"
                }
                return ("host." + node.name)
            }
            if (expected == "double") {
                def vt:string (this.lookupVarType(node.name))
                if (vt == "int") {
                    return ("(to_double " + node.name) + ")"
                }
            }
            return node.name
        }
        if (t == "CallExpression") {
            def callStr:string (this.emitCall(node))
            ; Coerce an int-returning call used in a double context.
            if (expected == "double") {
                if ((this.callExprType(node)) == "int") {
                    return ("(to_double " + callStr) + ")"
                }
            }
            return callStr
        }
        if (t == "MemberExpression") {
            return (this.emitMember(node expected))
        }
        if (t == "BinaryExpression") {
            return (this.emitBinary(node expected))
        }
        if (t == "UnaryExpression") {
            return (this.emitUnary(node expected))
        }
        if (t == "ObjectExpression") {
            if (this.endsWith(expected "Native")) {
                if ((array_length node.children) == 0) {
                    return ("(new " + expected) + ")")
                }
                def tmpObj:string ("tmp" + ("" + tmpCounter))
                tmpCounter = (tmpCounter + 1)
                this.emitStructFromObject(node tmpObj expected)
                return tmpObj
            }
            return "{}"
        }
        if (t == "ArrayExpression") {
            if (this.startsWith(expected "[")) {
                if ((array_length node.children) == 0) {
                    def tmpArr:string ("tmp" + ("" + tmpCounter))
                    tmpCounter = (tmpCounter + 1)
                    this.emitLine((("def " + tmpArr) + ":") + expected)
                    return tmpArr
                }
            }
            return "[]"
        }
        return "0"
    }

    ; foo(a b) -> (this.foo a b) with args coerced to the helper's param types.
    fn emitCall:string (node:TSNode) {
        if (null? node.left) {
            return "0"
        }
        def callee:TSNode (unwrap node.left)
        if (callee.nodeType == "Identifier") {
            def name:string callee.name
            if (this.isBridgeHelper(name)) {
                return (this.emitBridgeHelperValue(name node))
            }
            def receiver:string "this."
            if (this.isEngineFn(name)) {
                receiver = "host."
            }
            def args:[string]
            def i 0
            while (i < (array_length node.children)) {
                def arg:TSNode (itemAt node.children i)
                def pexp:string (this.helperParamType(name i))
                if ((strlen pexp) == 0) {
                    pexp = (this.exprType(arg))
                }
                if (arg.nodeType == "ObjectExpression") {
                    if ((this.endsWith(pexp "Native")) == false) {
                        pexp = (this.inferObjectStructType(arg ((name + "_arg") + ("" + i))))
                    }
                }
                def at:string (this.exprType(arg))
                def emitAs:string at
                if ((strlen emitAs) == 0) {
                    emitAs = "int"
                }
                def argExpr:string ""
                if ((strlen pexp) > 0) {
                    argExpr = (this.emitValueExpr(arg pexp))
                } {
                    argExpr = (this.emitExpr(arg emitAs))
                }
                if (this.isEngineFn(name)) {
                    if (at == "double") {
                        argExpr = ("(to_int " + argExpr) + ")"
                    }
                }
                if (pexp == "int") {
                    if (at == "double") {
                        if (this.isEngineFn(name) == false) {
                            argExpr = ("(to_int " + argExpr) + ")"
                        }
                    }
                }
                if (pexp == "double") {
                    if (emitAs == "int") {
                        def alreadyDouble:boolean false
                        if ((strlen argExpr) >= 10) {
                            if ((substring argExpr 0 10) == "(to_double") {
                                alreadyDouble = true
                            }
                        }
                        if (alreadyDouble == false) {
                            argExpr = ("(to_double " + argExpr) + ")"
                        }
                    }
                }
                if (pexp == "boolean") {
                    if (at == "int") {
                        argExpr = ("(" + argExpr) + " != 0)"
                    }
                }
                push args argExpr
                i = (i + 1)
            }
            def inner:string ((receiver + name) + "(") + ((this.joinSpace(args)) + ")")
            return (("(" + inner) + ")")
        }
        if (callee.nodeType == "MemberExpression") {
            if (callee.name == "substring") {
                if (callee.left) {
                    def recv:TSNode (unwrap callee.left)
                    def recvT:string (this.exprType(recv))
                    def recvExpr:string (this.emitExpr(recv recvT))
                    def a0:string "0"
                    def a1:string "0"
                    if ((array_length node.children) > 0) {
                        def n0:TSNode (itemAt node.children 0)
                        a0 = (this.emitExpr(n0 "int"))
                    }
                    if ((array_length node.children) > 1) {
                        def n1:TSNode (itemAt node.children 1)
                        a1 = (this.emitExpr(n1 "int"))
                    }
                    return (((("(substring " + recvExpr) + " ") + a0) + " ") + a1)
                }
            }
        }
        ; member call like x.toFixed / a.push handled elsewhere; fallback
        return "0"
    }

    fn emitNumber:string (raw:string expected:string) {
        def hasDot:boolean (this.containsChar(raw 46))
        if (expected == "double") {
            if (hasDot == false) {
                return (raw + ".0")
            }
            return raw
        }
        return raw
    }

    fn emitMember:string (node:TSNode expected:string) {
        if (null? node.left) {
            return ""
        }
        def leftNode:TSNode (unwrap node.left)
        ; computed access a[i]
        if (node.computed) {
            if (node.right) {
                def idxNode:TSNode (unwrap node.right)
                def baseType:string (this.exprType(leftNode))
                def base:string (this.emitExpr(leftNode "int"))
                def idxT:string (this.exprType(idxNode))
                def idx:string (this.emitExpr(idxNode idxT))
                if (idxT == "double") {
                    idx = (("(to_int " + idx) + ")")
                }
                def elemT:string (this.elemTypeOf(baseType))
                def access:string (((("(itemAt " + base) + " ") + idx) + ")")
                ; If this `X[i]` was hoisted (it is a field-access receiver), use
                ; the typed local so `.field` is legal / writes persist.
                def hoisted@(optional):string (get hoistedItemAt access)
                if (!null? hoisted) {
                    return (unwrap hoisted)
                }
                if (expected == "double") {
                    if (elemT == "int") {
                        return ("(to_double " + access) + ")"
                    }
                }
                return access
            }
        }
        ; .length -> (array_length base)
        if (node.name == "length") {
            def base:string (this.emitExpr(leftNode "int"))
            return (("(array_length " + base) + ")")
        }
        ; input.players[i].field -> hoisted `in_pl<i>.field` (not `in_p` — collides with entity ids p1/p2)
        def pIdx:string (this.inputPlayerIndex(node))
        if ((strlen pIdx) > 0) {
            def localName:string (("in_pl" + pIdx) + ".")
            return (localName + node.name)
        }
        ; <stateVar>.entities.<id> -> hoisted typed local `in_<id>`
        if (leftNode.nodeType == "MemberExpression") {
            if (leftNode.name == "entities") {
                return ("in_" + node.name)
            }
        }
        ; goalPlatform().y — Ranger cannot parse `(call).field`; hoist the call.
        if (leftNode.nodeType == "CallExpression") {
            def ct:string (this.callExprType(leftNode))
            if ((strlen ct) == 0) {
                ct = "int"
            }
            if (this.endsWith(ct "Native")) {
                def tmpCall:string ("tmp" + ("" + tmpCounter))
                tmpCounter = (tmpCounter + 1)
                def callStr:string (this.emitCall(leftNode))
                this.emitLine(((("def " + tmpCall) + ":") + ct) + ((" (" + callStr) + ")"))
                def result:string ((tmpCall + ".") + node.name)
                if (expected == "double") {
                    def sf:string (this.structFieldType(ct node.name))
                    if ((this.isIntScalar(sf)) || (sf == "int")) {
                        return ("(to_double " + result) + ")"
                    }
                }
                return result
            }
        }
        if (leftNode.nodeType == "Identifier") {
            def bvt:string (this.lookupVarType(leftNode.name))
            if (bvt == "NativeGameState") {
                def routed:string (this.emitStateFieldRead(leftNode.name node.name expected))
                if ((strlen routed) > 0) {
                    return routed
                }
            }
            if (leftNode.name == stateVarName) {
                ; object-valued state field -> persistent script instance field
                if (this.isObjectStateField(node.name)) {
                    return ("st_" + node.name)
                }
                ; state array field -> intArrays map
                if (this.isStateArrayField(node.name)) {
                    return (((("(unwrap (get " + stateVarName) + ".intArrays \"") + node.name) + "\"))")
                }
                ; custom scalar -> numbers map (double)
                if ((this.isNativeStateField(node.name)) == false) {
                    if ((strlen node.name) > 0) {
                        return (((("(unwrap (get " + stateVarName) + ".numbers \"") + node.name) + "\"))")
                    }
                }
            }
        }
        def base:string (this.emitExpr(leftNode "int"))
        def prop:string node.name
        if ((strlen prop) == 0) {
            return base
        }
        if (base == "props") {
            return ("props." + prop)
        }
        def result:string (base + ".") + prop
        if (expected == "double") {
            def baseT:string (this.exprType(leftNode))
            def sf:string (this.structFieldType(baseT prop))
            if ((this.isIntScalar(sf)) || (sf == "int")) {
                return ("(to_double " + result) + ")"
            }
        }
        return result
    }

    fn endsWith:boolean (s:string suffix:string) {
        def slen (strlen s)
        def xlen (strlen suffix)
        if (xlen > slen) {
            return false
        }
        def start (slen - xlen)
        def tail:string (substring s start slen)
        return (tail == suffix)
    }

    fn emitBinary:string (node:TSNode expected:string) {
        def op:string node.value
        if (op == "===") {
            op = "=="
        }
        if (op == "!==") {
            op = "!="
        }
        ; `x | 0` is the JS int-truncation idiom -> (to_int x).
        if (op == "|") {
            if (node.right) {
                def rn:TSNode (unwrap node.right)
                if (rn.nodeType == "NumericLiteral") {
                    if (rn.value == "0") {
                        def lx:string (this.emitExpr((unwrap node.left) "double"))
                        return ("(to_int " + lx) + ")"
                    }
                }
            }
        }
        def operandExpected:string expected
        if ((this.isComparisonOp(op)) || (this.isArithmeticOp(op))) {
            operandExpected = (this.numericCommon(node))
        }
        def left:string (this.emitExpr((unwrap node.left) operandExpected))
        def right:string (this.emitExpr((unwrap node.right) operandExpected))
        def result:string (("(" + left) + (" " + op)) + ((" " + right) + ")")
        if ((expected == "int") && (op == "/")) {
            return ("(to_int " + result) + ")")
        }
        if (expected == "double") {
            def nc:string (this.numericCommon(node))
            if (nc == "int") {
                if ((strlen result) >= 10) {
                    if ((substring result 0 10) == "(to_double") {
                        return result
                    }
                }
                return ("(to_double " + result) + ")"
            }
        }
        return result
    }

    fn isArithmeticOp:boolean (op:string) {
        if (op == "+") { return true }
        if (op == "-") { return true }
        if (op == "*") { return true }
        if (op == "/") { return true }
        if (op == "%") { return true }
        return false
    }

    fn emitUnary:string (node:TSNode expected:string) {
        def op:string node.value
        if (null? node.left) {
            return op
        }
        def argType:string (this.exprType((unwrap node.left)))
        if (op == "-") {
            def useDouble:boolean (argType == "double")
            if (expected == "double") {
                useDouble = true
            }
            if (useDouble) {
                def arg:string (this.emitExpr((unwrap node.left) "double"))
                return ("(0.0 - " + arg) + ")"
            }
            def arg2:string (this.emitExpr((unwrap node.left) "int"))
            return ("(0 - " + arg2) + ")"
        }
        if (op == "!") {
            def argB:string (this.emitExpr((unwrap node.left) "boolean"))
            return ("(false == " + argB) + ")"
        }
        def argD:string (this.emitExpr((unwrap node.left) argType))
        return (op + argD)
    }

    fn containsChar:boolean (s:string ch:int) {
        def i 0
        while (i < (strlen s)) {
            def c:int (charAt s i)
            if (c == ch) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn foldDigitChar:string (d:int) {
        if (d == 0) { return "0" }
        if (d == 1) { return "1" }
        if (d == 2) { return "2" }
        if (d == 3) { return "3" }
        if (d == 4) { return "4" }
        if (d == 5) { return "5" }
        if (d == 6) { return "6" }
        if (d == 7) { return "7" }
        if (d == 8) { return "8" }
        return "9"
    }

    fn parseIntStr:int (s:string) {
        def out:int 0
        def i:int 0
        def neg:boolean false
        if ((strlen s) > 0) {
            def c0:int (charAt s 0)
            if (c0 == 45) {
                neg = true
                i = 1
            }
        }
        while (i < (strlen s)) {
            def ch:int (charAt s i)
            out = ((out * 10) + (ch - 48))
            i = (i + 1)
        }
        if (neg) {
            return (0 - out)
        }
        return out
    }

    fn divInt:int (a:int b:int) {
        if (b == 0) {
            return 0
        }
        def count:int 0
        def rem:int a
        if (rem < 0) {
            rem = (0 - rem)
        }
        def absB:int b
        if (b < 0) {
            absB = (0 - b)
        }
        while (rem >= absB) {
            rem = (rem - absB)
            count = (count + 1)
        }
        if (((a < 0) && (b > 0)) || ((a > 0) && (b < 0))) {
            return (0 - count)
        }
        return count
    }

    fn formatIntStr:string (n:int) {
        if (n == 0) {
            return "0"
        }
        def neg:boolean false
        def v:int n
        if (n < 0) {
            neg = true
            v = (0 - n)
        }
        def digits:[string]
        while (v > 0) {
            def digit (v % 10)
            push digits (this.foldDigitChar(digit))
            v = (this.divInt((v - digit) 10))
        }
        def out:string ""
        def cnt (array_length digits)
        def i:int (cnt - 1)
        while (i >= 0) {
            out = (out + (itemAt digits i))
            i = (i - 1)
        }
        if (neg) {
            return ("-" + out)
        }
        return out
    }
}

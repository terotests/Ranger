      }
      case RgOp.RETR {
        return "RETR"
      }
      case RgOp.RETV {
        return "RETV"
      }
      case RgOp.ARGN {
        return "ARGN"
      }
      case RgOp.ARGR {
        return "ARGR"
      }
      case RgOp.CALLN {
        return "CALLN"
      }
      case RgOp.CALLR {
        return "CALLR"
      }
      case RgOp.CALLV {
        return "CALLV"
      }
      case RgOp.MCALLN {
        return "MCALLN"
      }
      case RgOp.MCALLR {

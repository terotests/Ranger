; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; RgModuleIO — bytecode as a file
; =============================================================================
; The module model is the whole interface between the two halves of the engine,
; and this is what lets them live in different processes — or on different
; machines. `rg_build` writes a `.rgb`; `rangercli`, which has no compiler in
; it at all, reads one and runs it.
;
; The format is line-oriented text, one tag character per line. Binary would be
; smaller and this is not the place to save bytes: a bytecode file you can read
; in a terminal, diff, and paste into a bug report is worth more right now than
; one that is 40% shorter. The tags:
;
;   rgb <version>              header, first line
;   c <name>                   a class; the lines under it are its members
;   n <default> <field>        numeric field, in layout order
;   r <init> <field>           reference field, in layout order (init: 0 null,
;                              1 empty string, 2 numeric array, 3 ref array)
;   m <fnId> <method>          method slot
;   k <fnId>                   the constructor
;   f <name>                   a function; functions appear in id order
;   s <static> <ret> <numRegs> <refRegs> <tier>
;   p <kind>                   one parameter, in declaration order
;   d <value>                  numeric constant, in pool order
;   t <text>                   string constant, escaped
;   o <OP> <a> <b> <c>         one instruction
;   b <reason>                 why this function did not lower
;
; Opcodes are written by NAME. The number an enum happens to have is an
; implementation detail that a recompile can shift; a name cannot drift
; silently, and it makes the file readable, which is the point.

Import "RgBytecode.rgr"

class RgModuleIO {

  sfn formatVersion:int () {
    return 1
  }

  ; ---- opcode names --------------------------------------------------------
  ; Mechanically mirrors the RgOp enum. A name the reader does not know is a
  ; hard error rather than a NOP: silently skipping an instruction would run a
  ; different program from the one that was compiled.


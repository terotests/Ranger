  sfn kindName:string (k:RgKind) {
    switch k {
      case RgKind.Num {
        return "N"
      }
      case RgKind.Ref {
        return "R"
      }
    }
    return "V"
  }

  sfn kindFromName:RgKind (s:string) {
    if (s == "N") {
      return RgKind.Num
    }
    if (s == "R") {
      return RgKind.Ref
    }
    return RgKind.Void
  }

  sfn tierName:string (t:RgTier) {
    switch t {
      case RgTier.Jit {
        return "J"
      }
      case RgTier.Unsupported {
        return "U"
      }
    }
    return "B"
  }

  sfn tierFromName:RgTier (s:string) {
    if (s == "U") {
      return RgTier.Unsupported
    }
    ; A file never asks for the JIT tier: whether a function is compiled is a
    ; decision the run makes, not the build.
    return RgTier.Bytecode
  }

  ; ---- text escaping -------------------------------------------------------
  ; A string constant is the rest of its line, so only the characters that
  ; would end the line (and the escape character itself) need hiding.

  sfn escape:string (s:string) {
    def out:[string]
    def i:int 0
    def len:int (strlen s)
    while (i < len) {
      def ch:int (charAt s i)
      if (ch == 92) {
        push out "\\\\"
      } {
        if (ch == 10) {
          push out "\\n"
        } {
          if (ch == 13) {
            push out "\\r"
          } {
            push out (substring s i (i + 1))
          }
        }
      }
      i = (i + 1)
    }
    return (join out "")
  }

  sfn unescape:string (s:string) {
    def out:[string]
    def i:int 0
    def len:int (strlen s)
    while (i < len) {
      def ch:int (charAt s i)
      if ((ch == 92) && ((i + 1) < len)) {
        def nx:int (charAt s (i + 1))
        if (nx == 110) {
          push out (strfromcode 10)
        } {
          if (nx == 114) {
            push out (strfromcode 13)
          } {
            push out (substring s (i + 1) (i + 2))
          }
        }
        i = (i + 2)
      } {
        push out (substring s i (i + 1))
        i = (i + 1)
      }
    }
    return (join out "")
  }

  ; A whole number keeps its exact spelling; anything else goes through the
  ; host's own double formatting.
  sfn numText:string (v:double) {
    def asInt:int (to_int v)
    if ((to_double asInt) == v) {
      return ("" + asInt)
    }
    return (double2str v)
  }

  sfn intOf:int (s:string) {
    return (?? (str2int s) 0)
  }

  sfn doubleOf:double (s:string) {
    return (?? (str2double s) 0.0)
  }

  ; ---- writing -------------------------------------------------------------

  sfn toText:string (m:RgModule err:RgIOError) {
    def out:[string]
    push out ("rgb " + (RgModuleIO.formatVersion()))
    for m.classes cl:RgClassDef ci {
      push out ("c " + cl.name)
      def ni:int 0
      while (ni < (array_length cl.numFieldNames)) {
        push out ("n " + (RgModuleIO.numText((itemAt cl.numFieldDefaults ni))) + " " + (itemAt cl.numFieldNames ni))
        ni = (ni + 1)
      }
      def ri:int 0
      while (ri < (array_length cl.refFieldNames)) {
        push out ("r " + (itemAt cl.refFieldInit ri) + " " + (itemAt cl.refFieldNames ri))
        ri = (ri + 1)
      }
      def mi:int 0
      while (mi < (array_length cl.methodNames)) {
        push out ("m " + (itemAt cl.methodIds mi) + " " + (itemAt cl.methodNames mi))
        mi = (mi + 1)
      }
      push out ("k " + cl.ctorId)
    }
    for m.functions f:RgFunction fi {
      push out ("f " + f.name)
      def st:string "0"
      if f.isStatic {
        st = "1"
      }
      push out ("s " + st + " " + (RgModuleIO.kindName(f.retKind)) + " " + f.numRegs + " " + f.refRegs + " " + (RgModuleIO.tierName(f.tier)))
      for f.paramKinds pk:RgKind pi {
        push out ("p " + (RgModuleIO.kindName(pk)))
      }
      for f.nums d:double di {
        push out ("d " + (RgModuleIO.numText(d)))
      }
      for f.strings t:string ti {
        push out ("t " + (RgModuleIO.escape(t)))
      }
      if ((strlen f.bailReason) > 0) {
        push out ("b " + (RgModuleIO.escape(f.bailReason)))
      }
      def oi:int 0
      while (oi < (array_length f.ops)) {
        def opText:string (RgModuleIO.opName((itemAt f.ops oi)))
        if ((strlen opText) == 0) {
          err.message = ("instruction " + oi + " of " + f.name + " has an opcode this writer cannot name — the name table in RgModuleIO is behind the RgOp enum")
          return ""
        }
        push out ("o " + opText + " " + (itemAt f.ra oi) + " " + (itemAt f.rb oi) + " " + (itemAt f.rc oi))
        oi = (oi + 1)
      }
    }
    return (join out (strfromcode 10))
  }

  ; ---- reading -------------------------------------------------------------
  ; `errorText` is empty when the module came back intact. A malformed file is
  ; reported, never half-loaded: a runtime that guesses at a broken instruction
  ; stream is worse than one that refuses to start.

  sfn fromText:RgModule (text:string errorOut:RgIOError) {
    def m:RgModule (new RgModule())
    def lines:[string] (strsplit text (strfromcode 10))
    def cl:RgClassDef (new RgClassDef())
    def f:RgFunction (new RgFunction())
    def haveClass:boolean false
    def haveFn:boolean false
    def lineNo:int 0
    for lines rawLine:string li {
      lineNo = (lineNo + 1)
      ; Only a carriage return comes off: a string constant is the rest of its
      ; line, trailing spaces included, and trimming the line ate the space in
      ; "fib(20) = ".
      def line:string rawLine
      def lineLen:int (strlen line)
      if (lineLen > 0) {
        if ((charAt line (lineLen - 1)) == 13) {
          line = (substring line 0 (lineLen - 1))
        }
      }
      if ((strlen line) == 0) {
        continue
      }
      def tag:string (substring line 0 1)
      def rest:string ""
      if ((strlen line) > 2) {
        rest = (substring line 2 (strlen line))
      }
      if (lineNo == 1) {
        if ((substring line 0 3) != "rgb") {
          errorOut.message = "not a bytecode file: the first line is not a header"
          return m
        }
        def ver:int (RgModuleIO.intOf((trim (substring line 3 (strlen line)))))
        if (ver != (RgModuleIO.formatVersion())) {
          errorOut.message = ("bytecode format version " + ver + ", this runtime reads " + (RgModuleIO.formatVersion()))
          return m
        }
        continue
      }
      switch tag {
        case "c" {
          cl = (new RgClassDef())
          cl.name = rest
          cl.ctorId = (0 - 1)
          haveClass = true
          m.addClass(cl)
        }
        case "n" {
          if (false == haveClass) {
            errorOut.message = ("line " + lineNo + ": a field outside a class")
            return m
          }
          def parts:[string] (strsplit rest " ")
          if ((array_length parts) < 2) {
            errorOut.message = ("line " + lineNo + ": a numeric field needs a default and a name")
            return m
          }
          push cl.numFieldDefaults (RgModuleIO.doubleOf((itemAt parts 0)))
          push cl.numFieldNames (itemAt parts 1)
        }
        case "r" {
          if (false == haveClass) {
            errorOut.message = ("line " + lineNo + ": a field outside a class")
            return m
          }
          def rparts:[string] (strsplit rest " ")
          if ((array_length rparts) < 2) {
            errorOut.message = ("line " + lineNo + ": a reference field needs an init and a name")
            return m
          }
          push cl.refFieldInit (RgModuleIO.intOf((itemAt rparts 0)))
          push cl.refFieldNames (itemAt rparts 1)
        }
        case "m" {
          def mparts:[string] (strsplit rest " ")
          if ((array_length mparts) < 2) {
            errorOut.message = ("line " + lineNo + ": a method slot needs an id and a name")
            return m
          }
          push cl.methodIds (RgModuleIO.intOf((itemAt mparts 0)))
          push cl.methodNames (itemAt mparts 1)
        }
        case "k" {
          cl.ctorId = (RgModuleIO.intOf(rest))
        }
        case "f" {
          f = (new RgFunction())
          f.name = rest
          def dot:int (indexOf rest ".")
          if (dot > 0) {
            f.className = (substring rest 0 dot)
            f.methodName = (substring rest (dot + 1) (strlen rest))
          }
          haveFn = true
          m.addFunction(f)
        }
        case "s" {
          if (false == haveFn) {
            errorOut.message = ("line " + lineNo + ": a signature outside a function")
            return m
          }
          def sparts:[string] (strsplit rest " ")
          if ((array_length sparts) < 5) {
            errorOut.message = ("line " + lineNo + ": a signature needs five fields")
            return m
          }
          f.isStatic = ((itemAt sparts 0) == "1")
          f.retKind = (RgModuleIO.kindFromName((itemAt sparts 1)))
          f.numRegs = (RgModuleIO.intOf((itemAt sparts 2)))
          f.refRegs = (RgModuleIO.intOf((itemAt sparts 3)))
          f.tier = (RgModuleIO.tierFromName((itemAt sparts 4)))
        }
        case "p" {
          push f.paramKinds (RgModuleIO.kindFromName(rest))
        }
        case "d" {
          push f.nums (RgModuleIO.doubleOf(rest))
        }
        case "t" {
          push f.strings (RgModuleIO.unescape(rest))
        }
        case "b" {
          f.bailReason = (RgModuleIO.unescape(rest))
        }
        case "o" {
          if (false == haveFn) {
            errorOut.message = ("line " + lineNo + ": an instruction outside a function")
            return m
          }
          def oparts:[string] (strsplit rest " ")
          if ((array_length oparts) < 4) {
            errorOut.message = ("line " + lineNo + ": an instruction needs an opcode and three operands")
            return m
          }
          def opText:string (itemAt oparts 0)
          if (false == (RgModuleIO.isKnownOp(opText))) {
            errorOut.message = ("line " + lineNo + ": unknown opcode " + opText)
            return m
          }
          f.addOp((RgModuleIO.opFromName(opText)) (RgModuleIO.intOf((itemAt oparts 1))) (RgModuleIO.intOf((itemAt oparts 2))) (RgModuleIO.intOf((itemAt oparts 3))))
        }
        default {
          errorOut.message = ("line " + lineNo + ": unknown tag `" + tag + "`")
          return m
        }
      }
    }
    return m
  }
}

; A place for `fromText` to put the reason a file was refused. The reader returns
; the module it managed to build so a tool can still show what it saw.
class RgIOError {
  def message:string ""
}

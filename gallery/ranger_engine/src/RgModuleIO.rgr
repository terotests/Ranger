      case RgOp.GETFR {
        return "GETFR"
      }
      case RgOp.SETFN {
        return "SETFN"
      }
      case RgOp.SETFR {
        return "SETFR"
      }
      case RgOp.ANEWN {
        return "ANEWN"
      }
      case RgOp.ANEWR {
        return "ANEWR"
      }
      case RgOp.APUSHN {
        return "APUSHN"
      }
      case RgOp.APUSHR {
        return "APUSHR"
      }
      case RgOp.AGETN {
        return "AGETN"
      }
      case RgOp.AGETR {
        return "AGETR"
      }
      case RgOp.ASETN {
        return "ASETN"
      }
      case RgOp.ASETR {
        return "ASETR"
      }
      case RgOp.ALEN {
        return "ALEN"
      }
      case RgOp.SCAT {
        return "SCAT"
      }
      case RgOp.SLEN {
        return "SLEN"
      }
      case RgOp.SEQ {
        return "SEQ"
      }
      case RgOp.SUBSTR {
        return "SUBSTR"
      }
      case RgOp.CHARAT {
        return "CHARAT"
      }
      case RgOp.N2S {
        return "N2S"
      }
      case RgOp.S2N {
        return "S2N"
      }
      case RgOp.PRINTN {
        return "PRINTN"
      }
      case RgOp.PRINTR {
        return "PRINTR"
      }
      case RgOp.TRUNC {
        return "TRUNC"
      }
      case RgOp.ISNULL {
        return "ISNULL"
      }
      case RgOp.OEQ {
        return "OEQ"
      }
      case RgOp.ARGC {
        return "ARGC"
      }
      case RgOp.ARGV {
        return "ARGV"
      }
      case RgOp.RDFILE {
        return "RDFILE"
      }
      case RgOp.WRFILE {
        return "WRFILE"
      }
      case RgOp.FEXISTS {
        return "FEXISTS"
      }
      case RgOp.CLOCK {
        return "CLOCK"
      }
      case RgOp.SPLIT {
        return "SPLIT"
      }
      case RgOp.TRIM {
        return "TRIM"
      }
    }
    ; Not "NOP": an opcode this table has not caught up with would be written
    ; as a legal instruction and read back as one, which is a program that
    ; silently does something else. The writer turns "" into a refusal.
    return ""
  }


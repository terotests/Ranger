; Study 11 (Rust only) — a behaviour-only trait as a Rust trait
;
; The Rust I want:
;   trait Named { fn label(&self) -> String; }
;   impl Named for User { … }
;   impl Named for Bot  { … }
;   fn show(n: &dyn Named) -> String
;
; A Ranger `trait` is a MIXIN: its methods are copied into each class that
; `does` it. That is the right lowering for a trait carrying FIELDS — Rust has
; no associated fields to hold them — but a trait that declares only behaviour
; is exactly what a Rust `trait` says. Using one as a TYPE used to emit
; `fn show(n : &mut Named)` with no `Named` anywhere in the file (rustc E0425);
; `attempts/04_trait_as_type.rgr` is the field-bearing case, still refused.
;
; This study lives here rather than in ../../src because the same program does
; not compile on Go, Java, Kotlin, C#, Dart or Swift — each of those writers
; names a trait type it never declares — and ../../src is shared by all ten
; targets. ES6 and Python run it. C++ has the same study under ../../cpp/src,
; where the trait is an abstract base class.

trait Named {
    fn label:string () {
        return "anon"
    }
}

trait Sized2 {
    fn weight:int () {
        return 1
    }
}

class User {
    does Named
    does Sized2
    def uname:string ""
}

class Bot {
    does Named
    def id:int 0
}

class TraitsMain {
    fn show:string (n:Named) {
        return (n.label())
    }

    sfn main:void () {
        def app:TraitsMain (new TraitsMain())
        def u:User (new User())
        def b:Bot (new Bot())
        print ("user " + (app.show(u)))
        print ("bot " + (app.show(b)))
        print ("weight " + (to_string (u.weight())))
    }
}

; ============================================================================
; UastTsTest.rgr — ts_parser → FrontendResult → CodeModel (milestone 3).
; ============================================================================
;
; Imports gallery/ts_parser. The schema suite (uast:test) does not.
;
;   npm run uast:ts
; ============================================================================

Import "../src/UastTs.rgr"
Import "../src/UastCodeGraph.rgr"
Import "../src/UastDump.rgr"
Import "../src/UastQuery.rgr"

class UastTsChecker {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        this.ok((name + " (got '" + got + "' want '" + want + "')") (got == want))
    }

    fn report:int () {
        print ""
        print (("passed " + (to_string passed)) + ", failed " + (to_string failed))
        if (failed > 0) {
            return 1
        }
        return 0
    }
}

class UastTsTest {
    sfn main:void () {
        def c (new UastTsChecker)
        UastTsTest.testZipWriter(c)
        UastTsTest.testWorkspace(c)
        UastTsTest.testShapes(c)
        UastTsTest.testTsx(c)
        UastTsTest.testClientGrammar(c)
        UastTsTest.testPackageDts(c)
        UastTsTest.testFromDir(c)
        def code:int (c.report())
        if (code != 0) {
            exit 1
        }
    }

    sfn testZipWriter:void (c:UastTsChecker) {
        print "== zip_writer.ts via ts_parser"
        def model:UastCodeModel (UastTs.fromFile("gallery/uast/fixtures/zip_writer.ts"))
        if ((indexOf model.title " FAIL ") >= 0) {
            print ("  FAIL " + model.title)
            c.ok("parse zip_writer.ts" false)
            return
        }
        c.ok("ZipWriter symbol" (model.mentionsSymbol("class:ZipWriter")))
        c.ok("ZipEntry symbol" (model.mentionsSymbol("class:ZipEntry")))
        c.ok("GrowableZipBuffer symbol" (model.mentionsSymbol("class:GrowableZipBuffer")))
        c.ok("CRC32 symbol" (model.mentionsSymbol("class:CRC32")))
        c.ok("addFile symbol" (model.mentionsSymbol("method:ZipWriter.addFile")))
        c.ok("update symbol" (model.mentionsSymbol("method:CRC32.update")))
        def entries:UastSymbol (model.symbolById("field:ZipWriter.entries"))
        c.eqStr("entries type" entries.typeName "[ZipEntry]")
        def output:UastSymbol (model.symbolById("field:ZipWriter.output"))
        c.eqStr("output type" output.typeName "GrowableZipBuffer")
        def crcField:UastSymbol (model.symbolById("field:ZipWriter.crc"))
        c.eqStr("crc type" crcField.typeName "CRC32")
        c.ok("crc comment on the field" ((indexOf crcField.comment "Cyclic redundancy") >= 0))
        def zipEntry:UastSymbol (model.symbolById("class:ZipEntry"))
        c.ok("file banner is not ZipEntry's comment" ((indexOf zipEntry.comment "Twin of") < 0))
        def addFile:UNode (UastQuery.methodNode(model "ZipWriter" "addFile"))
        c.eqStr("addFile name" addFile.name "addFile")
        def calls:[UNode] (UastQuery.ofKindUnder(model addFile (UastKind.Call())))
        c.ok("addFile has a Call" ((array_length calls) > 0))
        if ((array_length calls) > 0) {
            def call0:UNode (itemAt calls 0)
            c.eqStr("callee member" (UastQuery.calleeMemberName(model call0)) "update")
            c.eqStr("callee receiver" (UastQuery.calleeReceiverName(model call0)) "crc")
            def dump:string (UastDump.ofNode(model call0.id))
            print dump
            c.ok("dump kind Call" ((indexOf dump "kind: Call") >= 0))
            c.ok("dump MemberAccess" ((indexOf dump "MemberAccess") >= 0))
            c.ok("dump exact" ((indexOf dump "confidence: exact") >= 0))
            c.ok("dump not a unique-name guess" ((indexOf dump "confidence: inferred") < 0))
            c.ok("dump resolved" ((indexOf dump "resolution: resolved") >= 0))
            c.ok("dump target CRC32.update" ((indexOf dump "method:CRC32.update") >= 0))
            def calleeId:string (call0.childIdFor((UastChildRole.callee())))
            c.eqStr("update MemberAccess → method" (UastQuery.refTarget(model calleeId)) "method:CRC32.update")
            if (model.mentionsNode(calleeId)) {
                def callee:UNode (model.nodeById(calleeId))
                def memId:string (callee.childIdFor((UastChildRole.member())))
                c.eqStr("update ident → method" (UastQuery.refTarget(model memId)) "method:CRC32.update")
                def recvId:string (callee.childIdFor((UastChildRole.receiver())))
                if (model.mentionsNode(recvId)) {
                    def recv:UNode (model.nodeById(recvId))
                    c.eqStr("this.crc → field" (UastQuery.refTarget(model recvId)) "field:ZipWriter.crc")
                    def thisId:string (recv.childIdFor((UastChildRole.receiver())))
                    c.eqStr("this → ZipWriter" (UastQuery.refTarget(model thisId)) "class:ZipWriter")
                    def crcId:string (recv.childIdFor((UastChildRole.member())))
                    c.eqStr("crc ident → field" (UastQuery.refTarget(model crcId)) "field:ZipWriter.crc")
                }
            }
            def args:[string] (call0.childIdsFor((UastChildRole.argument())))
            if ((array_length args) > 0) {
                c.eqStr("data arg → param" (UastQuery.refTarget(model (itemAt args 0))) "param:ZipWriter.addFile.data")
            }
        }
        def foundUse:boolean false
        def foundCall:boolean false
        def ri:int 0
        while (ri < (array_length model.relationships)) {
            def rel:UastRelation (itemAt model.relationships ri)
            if ((rel.kind == "usesType") && (rel.fromId == "class:ZipWriter") && (rel.toId == "class:CRC32")) {
                foundUse = true
            }
            if ((rel.kind == "calls") && (rel.fromId == "method:ZipWriter.addFile") && (rel.toId == "method:CRC32.update")) {
                foundCall = true
                c.eqStr("call confidence" rel.confidence "exact")
            }
            ri = (ri + 1)
        }
        c.ok("ZipWriter usesType CRC32" foundUse)
        c.ok("addFile calls CRC32.update" foundCall)
        def g:CodeGraph (UastToCodeGraph.project(model))
        c.ok("projected ZipWriter" (g.hasClass("ZipWriter")))
        c.ok("projected CRC32" (g.hasClass("CRC32")))
        c.ok("projected addFile" (g.hasMethod("ZipWriter.addFile")))
        c.ok("projected update" (g.hasMethod("CRC32.update")))
    }

    sfn testWorkspace:void (c:UastTsChecker) {
        print "== foo_a.ts / foo_b.ts workspace"
        def ws (new UastWorkspace)
        ws.addResult((UastTs.parseFile("gallery/uast/fixtures/foo_a.ts")))
        ws.addResult((UastTs.parseFile("gallery/uast/fixtures/foo_b.ts")))
        ws.addResult((UastTs.parseFile("gallery/uast/fixtures/foo_js.ts")))
        def model:UastCodeModel (UastSemantic.fromWorkspace(ws))
        if ((indexOf model.title " FAIL ") >= 0) {
            print ("  FAIL " + model.title)
            c.ok("parse workspace" false)
            return
        }
        c.ok("Foo exported" (model.mentionsSymbol("class:Foo")))
        c.ok("Uses class" (model.mentionsSymbol("class:Uses")))
        c.ok("Foo.hello" (model.mentionsSymbol("method:Foo.hello")))
        def foundImp:boolean false
        def foundFoo:boolean false
        def ni:int 0
        while (ni < (array_length model.nodes)) {
            def n:UNode (itemAt model.nodes ni)
            if (n.kind == "Import") {
                if (n.name == "./foo_a") {
                    foundImp = true
                    def names:[string] (n.childIdsFor((UastChildRole.nameRole())))
                    if ((array_length names) > 0) {
                        c.eqStr("import Foo → class" (UastQuery.refTarget(model (itemAt names 0))) "class:Foo")
                    }
                }
            }
            if (n.kind == "New") {
                def cid:string (n.childIdFor((UastChildRole.callee())))
                if ((UastQuery.refTarget(model cid)) == "class:Foo") {
                    foundFoo = true
                }
            }
            ni = (ni + 1)
        }
        c.ok("import ./foo_a present" foundImp)
        c.ok("new Foo binds class" foundFoo)
        c.ok("ViaJs class" (model.mentionsSymbol("class:ViaJs")))
        def foundJs:boolean false
        def ji:int 0
        while (ji < (array_length model.nodes)) {
            def jn:UNode (itemAt model.nodes ji)
            if (jn.kind == "Import") {
                if (jn.name == "./foo_a.js") {
                    foundJs = true
                    def jnames:[string] (jn.childIdsFor((UastChildRole.nameRole())))
                    if ((array_length jnames) > 0) {
                        c.eqStr("import Foo from .js → class" (UastQuery.refTarget(model (itemAt jnames 0))) "class:Foo")
                    }
                }
            }
            ji = (ji + 1)
        }
        c.ok("import ./foo_a.js present" foundJs)
        c.ok("unresolved ./nope" (UastQuery.diagnosticMentions(model "unresolved import ./nope")))
        c.ok("Uses survived missing import" (model.mentionsSymbol("class:Uses")))
    }

    sfn testShapes:void (c:UastTsChecker) {
        print "== shapes.ts interface / extends / function / export default"
        def model:UastCodeModel (UastTs.fromFile("gallery/uast/fixtures/shapes.ts"))
        if ((indexOf model.title " FAIL ") >= 0) {
            print ("  FAIL " + model.title)
            c.ok("parse shapes.ts" false)
            return
        }
        c.ok("Named interface symbol" (model.mentionsSymbol("class:Named")))
        def named:UastSymbol (model.symbolById("class:Named"))
        c.eqStr("Named kind" named.kind "interface")
        c.ok("Named.size method" (model.mentionsSymbol("method:Named.size")))
        c.ok("Base class" (model.mentionsSymbol("class:Base")))
        c.ok("Child class" (model.mentionsSymbol("class:Child")))
        c.ok("DefaultBox class" (model.mentionsSymbol("class:DefaultBox")))
        c.ok("makeChild function" (model.mentionsSymbol("function:makeChild")))
        c.ok("Label type alias" (model.mentionsSymbol("class:Label")))
        def label:UastSymbol (model.symbolById("class:Label"))
        c.eqStr("Label kind" label.kind "type")
        def child:UastSymbol (model.symbolById("class:Child"))
        c.eqStr("Child extends Base" child.extendsName "Base")
        def foundExt:boolean false
        def foundCall:boolean false
        def ri:int 0
        while (ri < (array_length model.relationships)) {
            def rel:UastRelation (itemAt model.relationships ri)
            if ((rel.kind == "extends") && (rel.fromId == "class:Child") && (rel.toId == "class:Base")) {
                foundExt = true
            }
            if ((rel.kind == "calls") && (rel.fromId == "method:DefaultBox.wrap") && (rel.toId == "function:makeChild")) {
                foundCall = true
            }
            ri = (ri + 1)
        }
        c.ok("Child extends Base rel" foundExt)
        c.ok("wrap calls makeChild" foundCall)
        def g:CodeGraph (UastToCodeGraph.project(model))
        c.ok("projected Child" (g.hasClass("Child")))
        c.ok("projected Named" (g.hasClass("Named")))
        c.ok("projected DefaultBox" (g.hasClass("DefaultBox")))
        c.ok("projected wrap" (g.hasMethod("DefaultBox.wrap")))
    }

    sfn testFromDir:void (c:UastTsChecker) {
        print "== fromDir gallery/uast/fixtures"
        def model:UastCodeModel (UastTs.fromDir("gallery/uast/fixtures"))
        c.ok("ZipWriter from dir" (model.mentionsSymbol("class:ZipWriter")))
        c.ok("Foo from dir" (model.mentionsSymbol("class:Foo")))
        c.ok("Uses from dir" (model.mentionsSymbol("class:Uses")))
        c.ok("Child from dir" (model.mentionsSymbol("class:Child")))
        c.ok("makeChild from dir" (model.mentionsSymbol("function:makeChild")))
        c.ok("ViaJs from dir" (model.mentionsSymbol("class:ViaJs")))
        c.ok("at least 5 ts files" ((array_length model.files) >= 5))
        def g:CodeGraph (UastToCodeGraph.project(model))
        c.ok("dir projected ZipWriter" (g.hasClass("ZipWriter")))
        c.ok("dir projected Child" (g.hasClass("Child")))
        c.ok("Card from dir" (model.mentionsSymbol("function:Card")))
        c.ok("Page from dir" (model.mentionsSymbol("function:Page")))
    }

    sfn testTsx:void (c:UastTsChecker) {
        print "== tsx function / arrow / class components"
        def ws (new UastWorkspace)
        ws.addResult((UastTs.parseFile("gallery/uast/fixtures/card.tsx")))
        ws.addResult((UastTs.parseFile("gallery/uast/fixtures/page.tsx")))
        ws.addResult((UastTs.parseFile("gallery/uast/fixtures/banner.tsx")))
        ws.addResult((UastTs.parseFile("gallery/uast/fixtures/panel.tsx")))
        def model:UastCodeModel (UastSemantic.fromWorkspace(ws))
        c.ok("Card function" (model.mentionsSymbol("function:Card")))
        c.ok("Page function" (model.mentionsSymbol("function:Page")))
        c.ok("Banner arrow component" (model.mentionsSymbol("function:Banner")))
        c.ok("Panel class" (model.mentionsSymbol("class:Panel")))
        c.ok("CardProps type" (model.mentionsSymbol("class:CardProps")))
        def foundPage:boolean false
        def foundBanner:boolean false
        def foundPanel:boolean false
        def ri:int 0
        while (ri < (array_length model.relationships)) {
            def rel:UastRelation (itemAt model.relationships ri)
            if ((rel.kind == "calls") && (rel.fromId == "function:Page") && (rel.toId == "function:Card")) {
                foundPage = true
            }
            if ((rel.kind == "calls") && (rel.fromId == "function:Banner") && (rel.toId == "function:Card")) {
                foundBanner = true
            }
            if ((rel.kind == "calls") && (rel.fromId == "method:Panel.render") && (rel.toId == "function:Card")) {
                foundPanel = true
            }
            ri = (ri + 1)
        }
        c.ok("Page JSX calls Card" foundPage)
        c.ok("Banner JSX calls Card" foundBanner)
        c.ok("Panel.render JSX calls Card" foundPanel)
        def g:CodeGraph (UastToCodeGraph.project(model))
        c.ok("projected Card component" (g.hasClass("Card")))
        c.ok("projected Page component" (g.hasClass("Page")))
        c.ok("projected Banner component" (g.hasClass("Banner")))
        c.ok("projected Panel" (g.hasClass("Panel")))
        c.ok("projected Card.render" (g.hasMethod("Card.render")))
        c.ok("projected Page.render" (g.hasMethod("Page.render")))
        c.ok("projected Panel.render" (g.hasMethod("Panel.render")))
        def pageFn:UNode (new UNode)
        def ni:int 0
        while (ni < (array_length model.nodes)) {
            def n:UNode (itemAt model.nodes ni)
            if ((n.kind == "FunctionDecl") && (n.name == "Page")) {
                pageFn = n
            }
            ni = (ni + 1)
        }
        def jsxCalls:[UNode] (UastQuery.ofKindUnder(model pageFn (UastKind.Call())))
        c.ok("Page has a JSX Call" ((array_length jsxCalls) > 0))
        if ((array_length jsxCalls) > 0) {
            def call0:UNode (itemAt jsxCalls 0)
            c.eqStr("jsx nativeKind" call0.nativeKind "JSXElement")
            c.eqStr("jsx callee Card" (UastQuery.calleeMemberName(model call0)) "Card")
            def dump:string (UastDump.ofNode(model call0.id))
            print dump
            c.ok("jsx dump exact" ((indexOf dump "confidence: exact") >= 0))
            c.ok("jsx dump function:Card" ((indexOf dump "function:Card") >= 0))
        }
    }

    sfn testClientGrammar:void (c:UastTsChecker) {
        print "== 'use client' / typed rest / qualified types / member generics"
        def model:UastCodeModel (UastTs.fromFile("gallery/uast/fixtures/client.tsx"))
        c.ok("cn function" (model.mentionsSymbol("function:cn")))
        c.ok("Handler type" (model.mentionsSymbol("class:Handler")))
        c.ok("Lead type" (model.mentionsSymbol("class:Lead")))
        c.ok("Obj type" (model.mentionsSymbol("class:Obj")))
        c.ok("Click type" (model.mentionsSymbol("class:Click")))
        c.ok("ClientBanner" (model.mentionsSymbol("function:ClientBanner")))
        c.ok("box generic function" (model.mentionsSymbol("function:box")))
        c.ok("identity generic arrow" (model.mentionsSymbol("function:identity")))
        c.ok("isNum type predicate arrow" (model.mentionsSymbol("function:isNum")))
        c.ok("no parse diagnostic" ((UastQuery.diagnosticMentions(model "Parse error")) == false))
        c.ok("no unknown type" ((UastQuery.diagnosticMentions(model "Unknown type")) == false))
    }

    sfn testPackageDts:void (c:UastTsChecker) {
        print "== package .d.ts lookup"
        def model:UastCodeModel (UastTs.fromDir("gallery/uast/fixtures/dts_app"))
        c.ok("createElement from react .d.ts" (model.mentionsSymbol("function:createElement")))
        c.ok("useState from react .d.ts" (model.mentionsSymbol("function:useState")))
        c.ok("render from react-dom .d.ts" (model.mentionsSymbol("function:render")))
        c.ok("ReactElement interface" (model.mentionsSymbol("class:ReactElement")))
        c.ok("Page function" (model.mentionsSymbol("function:Page")))
        def foundCreate:boolean false
        def foundRender:boolean false
        def ri:int 0
        while (ri < (array_length model.relationships)) {
            def rel:UastRelation (itemAt model.relationships ri)
            if ((rel.kind == "calls") && (rel.fromId == "function:Page") && (rel.toId == "function:createElement")) {
                foundCreate = true
            }
            if ((rel.kind == "calls") && (rel.fromId == "function:mount") && (rel.toId == "function:render")) {
                foundRender = true
            }
            ri = (ri + 1)
        }
        c.ok("Page calls createElement" foundCreate)
        c.ok("mount calls render" foundRender)
        c.ok("no unresolved react" ((UastQuery.diagnosticMentions(model "unresolved import react from")) == false))
        c.ok("no unresolved react-dom" ((UastQuery.diagnosticMentions(model "unresolved import react-dom from")) == false))
    }
}

; ============================================================================
; UastNode.rgr — unified syntax node. Deliberately a bit dumb.
; ============================================================================
;
; Children are (role, nodeId) edges, not a positional list. Call has
; callee/argument, MemberAccess has receiver/member — never children[0].
; Nodes live in a flat CodeModel/FrontendResult index.
;
; LanguageSpecific = frontend understands the construct, UAST will not
; normalize it. Unknown = the frontend did not understand the construct.
; ============================================================================

Import "UastSource.rgr"

class UChild {
    def role:string ""
    def nodeId:string ""

    Constructor () {
    }

    sfn create:UChild (role:string nodeId:string) {
        def c (new UChild)
        c.role = role
        c.nodeId = nodeId
        return c
    }
}

class UNode {
    def id:string ""
    def kind:string ""
    def language:string ""
    def nativeKind:string ""
    def name:string ""
    def flags:[string]
    def span:UastSpan (new UastSpan)
    def origin:UastOrigin (new UastOrigin)
    def children:[UChild]

    Constructor () {
    }

    sfn create:UNode (id:string kind:string language:string nativeKind:string) {
        def n (new UNode)
        n.id = id
        n.kind = kind
        n.language = language
        n.nativeKind = nativeKind
        return n
    }

    fn addRole:void (role:string nodeId:string) {
        if ((strlen nodeId) == 0) {
            return
        }
        push children (UChild.create(role nodeId))
    }

    fn addFlag:void (flag:string) {
        if ((strlen flag) == 0) {
            return
        }
        def i:int 0
        while (i < (array_length flags)) {
            if ((itemAt flags i) == flag) {
                return
            }
            i = (i + 1)
        }
        push flags flag
    }

    fn mentionsFlag:boolean (flag:string) {
        def i:int 0
        while (i < (array_length flags)) {
            if ((itemAt flags i) == flag) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn childIdFor:string (role:string) {
        def i:int 0
        while (i < (array_length children)) {
            def ch:UChild (itemAt children i)
            if (ch.role == role) {
                return ch.nodeId
            }
            i = (i + 1)
        }
        return ""
    }

    fn childIdsFor:[string] (role:string) {
        def ids:[string]
        def i:int 0
        while (i < (array_length children)) {
            def ch:UChild (itemAt children i)
            if (ch.role == role) {
                push ids ch.nodeId
            }
            i = (i + 1)
        }
        return ids
    }

    fn childCount:int () {
        return (array_length children)
    }
}

    sfn argument:string () { return "argument" }

    sfn condition:string () { return "condition" }
    sfn thenBranch:string () { return "then" }
    sfn elseBranch:string () { return "else" }

    sfn parameter:string () { return "parameter" }
    sfn typeParameter:string () { return "typeParameter" }

    sfn left:string () { return "left" }
    sfn right:string () { return "right" }
    sfn element:string () { return "element" }

    sfn field:string () { return "field" }

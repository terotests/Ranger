; ============================================================================
; UastCodeGraph.rgr — CodeModel → gallery/codegraph CodeGraph.
; ============================================================================
;
; CodeGraph stays a presentation IR. This projector is the contract so a
; later UAST viewer can reuse the existing pager / UML / WebGL chrome
; without teaching it UNodes.
;
; Application symbols (the file you opened, plus local `.ts` / `.tsx`
; imports) become classes. Package `.d.ts` / `node_modules` symbols stay
; in the UAST for resolution, but they are not boxes on the graph when
; any application type is present — React's `Component` must not crowd
; out `App`.
; ============================================================================

Import "UastModel.rgr"
Import "../../codegraph/src/CodeGraphModel.rgr"

class UastToCodeGraph {
    Constructor () {
    }

    sfn project:CodeGraph (model:UastCodeModel) {
        def g (new CodeGraph)
        g.title = model.title
        def skipLib:boolean (UastToCodeGraph.hasAppTypes(model))
        def methodIds:[string:string]
        def i:int 0
        while (i < (array_length model.symbols)) {
            def s:UastSymbol (itemAt model.symbols i)
            if (UastToCodeGraph.keepSymbol(s skipLib)) {
                def isType:boolean false
                if (s.kind == "class") {
                    isType = true
                }
                if (s.kind == "interface") {
                    isType = true
                }
                if (s.kind == "type") {
                    isType = true
                }
                if isType {
                    def cc:CodeClass (g.addClass(s.name))
                    cc.fileName = s.fileName
                    cc.extendsName = s.extendsName
                    if (s.kind == "interface") {
                        cc.stereotype = "interface"
                    }
                    if (s.kind == "type") {
                        cc.stereotype = "type"
                    }
                }
                if (s.kind == "function") {
                    if (UastToCodeGraph.pascalName(s.name)) {
                        def fc:CodeClass (g.addClass(s.name))
                        fc.fileName = s.fileName
                        fc.stereotype = "component"
                    }
                }
            }
            i = (i + 1)
        }
        def f:int 0
        while (f < (array_length model.symbols)) {
            def fs:UastSymbol (itemAt model.symbols f)
            if (fs.kind == "field") {
                if (UastToCodeGraph.keepSymbol(fs skipLib)) {
                    def ownerName:string (UastToCodeGraph.parentName(model fs))
                    if ((strlen ownerName) > 0) {
                        if (g.hasClass(ownerName)) {
                            def owner:CodeClass (g.classByName(ownerName))
                            owner.addField(fs.name fs.typeName)
                        }
                    }
                }
            }
            f = (f + 1)
        }
        def m:int 0
        while (m < (array_length model.symbols)) {
            def ms:UastSymbol (itemAt model.symbols m)
            if (ms.kind == "method") {
                if (UastToCodeGraph.keepSymbol(ms skipLib)) {
                    def cls:string (UastToCodeGraph.parentName(model ms))
                    if ((strlen cls) == 0) {
                        cls = ms.name
                    }
                    if (g.hasClass(cls)) {
                        def cm:CodeMethod (g.addMethod(cls ms.name))
                        cm.isStatic = ms.isStatic
                        cm.params = ms.params
                        if ((strlen ms.returns) > 0) {
                            cm.returns = ms.returns
                        }
                        set methodIds ms.id cm.id
                    }
                }
            }
            if (ms.kind == "function") {
                if (UastToCodeGraph.pascalName(ms.name)) {
                    if (UastToCodeGraph.keepSymbol(ms skipLib)) {
                        if (g.hasClass(ms.name)) {
                            def fm:CodeMethod (g.addMethod(ms.name "render"))
                            if ((strlen ms.returns) > 0) {
                                fm.returns = ms.returns
                            }
                            set methodIds ms.id fm.id
                        }
                    }
                }
            }
            m = (m + 1)
        }
        UastToCodeGraph.projectImports(g model skipLib)
        def r:int 0
        while (r < (array_length model.relationships)) {
            def rel:UastRelation (itemAt model.relationships r)
            if (rel.kind == "extends") {
                if ((model.mentionsSymbol(rel.fromId)) && (model.mentionsSymbol(rel.toId))) {
                    def fromS:UastSymbol (model.symbolById(rel.fromId))
                    def toS:UastSymbol (model.symbolById(rel.toId))
                    if ((UastToCodeGraph.keepSymbol(fromS skipLib)) && (UastToCodeGraph.keepSymbol(toS skipLib))) {
                        if (g.hasClass(fromS.name)) {
                            def cls2:CodeClass (g.classByName(fromS.name))
                            cls2.extendsName = toS.name
                        }
                    }
                }
            }
            if (rel.kind == "calls") {
                if ((has methodIds rel.fromId) && (has methodIds rel.toId)) {
                    g.linkCall((unwrap (get methodIds rel.fromId)) (unwrap (get methodIds rel.toId)))
                }
            }
            if (rel.kind == "usesType") {
                if (has methodIds rel.fromId) {
                    if (model.mentionsSymbol(rel.toId)) {
                        def ts:UastSymbol (model.symbolById(rel.toId))
                        def mid:string (unwrap (get methodIds rel.fromId))
                        if (UastToCodeGraph.keepSymbol(ts skipLib)) {
                            if (g.hasClass(ts.name)) {
                                def um:CodeMethod (g.methodById(mid))
                                um.addUse(ts.name)
                            } {
                                g.linkUse(mid ts.name)
                            }
                        } {
                            def lm:CodeMethod (g.methodById(mid))
                            lm.addUse(ts.name)
                        }
                    }
                }
            }
            r = (r + 1)
        }
        return g
    }

    sfn projectImports:void (g:CodeGraph model:UastCodeModel skipLib:boolean) {
        def r:int 0
        while (r < (array_length model.relationships)) {
            def rel:UastRelation (itemAt model.relationships r)
            if (rel.kind == "imports") {
                if ((indexOf rel.fromId "module:") == 0) {
                    if (model.mentionsSymbol(rel.toId)) {
                        def target:UastSymbol (model.symbolById(rel.toId))
                        if (UastToCodeGraph.keepSymbol(target skipLib)) {
                            def fileName:string (substring rel.fromId 7 (strlen rel.fromId))
                            def fieldType:string ""
                            if (g.hasClass(target.name)) {
                                fieldType = target.name
                            }
                            def si:int 0
                            while (si < (array_length model.symbols)) {
                                def host:UastSymbol (itemAt model.symbols si)
                                if (host.fileName == fileName) {
                                    def hostClass:string ""
                                    if (host.kind == "class") {
                                        hostClass = host.name
                                    }
                                    if (host.kind == "interface") {
                                        hostClass = host.name
                                    }
                                    if (host.kind == "function") {
                                        if (UastToCodeGraph.pascalName(host.name)) {
                                            hostClass = host.name
                                        }
                                    }
                                    if ((strlen hostClass) > 0) {
                                        if (g.hasClass(hostClass)) {
                                            if (hostClass != target.name) {
                                                def cls:CodeClass (g.classByName(hostClass))
                                                UastToCodeGraph.addImportField(cls target.name fieldType)
                                            }
                                        }
                                    }
                                }
                                si = (si + 1)
                            }
                        }
                    }
                }
            }
            r = (r + 1)
        }
    }

    sfn addImportField:void (cls:CodeClass name:string fieldType:string) {
        def i:int 0
        while (i < (array_length cls.fields)) {
            def f:CodeField (itemAt cls.fields i)
            if (f.name == name) {
                if ((strlen f.fieldType) == 0) {
                    if ((strlen fieldType) > 0) {
                        f.fieldType = fieldType
                    }
                }
                return
            }
            i = (i + 1)
        }
        cls.addField(name fieldType)
    }

    sfn hasAppTypes:boolean (model:UastCodeModel) {
        def i:int 0
        while (i < (array_length model.symbols)) {
            def s:UastSymbol (itemAt model.symbols i)
            if (s.isLibrary == false) {
                if (s.kind == "class") {
                    return true
                }
                if (s.kind == "interface") {
                    return true
                }
                if (s.kind == "type") {
                    return true
                }
                if (s.kind == "function") {
                    if (UastToCodeGraph.pascalName(s.name)) {
                        return true
                    }
                }
            }
            i = (i + 1)
        }
        return false
    }

    sfn keepSymbol:boolean (s:UastSymbol skipLib:boolean) {
        if skipLib {
            if s.isLibrary {
                return false
            }
        }
        return true
    }

    sfn parentName:string (model:UastCodeModel sym:UastSymbol) {
        if ((strlen sym.parentSymbol) == 0) {
            return ""
        }
        if ((model.mentionsSymbol(sym.parentSymbol)) == false) {
            return ""
        }
        def p:UastSymbol (model.symbolById(sym.parentSymbol))
        return p.name
    }

    sfn pascalName:boolean (name:string) {
        if ((strlen name) == 0) {
            return false
        }
        def ch:int (charAt name 0)
        if ((ch >= 65) && (ch <= 90)) {
            return true
        }
        return false
    }
}

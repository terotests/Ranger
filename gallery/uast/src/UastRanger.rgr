; ============================================================================
; UastRanger.rgr — Ranger compiler context → FrontendResult.
; ============================================================================
;
; Emits UAST + compilerResolved hints. UastSemantic builds the CodeModel.
; This is the only UAST file that imports the compiler. Do not change
; CodeNode's shape or CodeGraphBuilder; we only read the tree. Leading
; `;` comments on a field/method are copied onto the UNode as `comment`.
; ============================================================================

Import "UastFrontend.rgr"
Import "UastSemantic.rgr"
Import "UastKind.rgr"
Import "../../../compiler/VirtualCompiler.rgr"

class UastRanger {
    def fileFilter:string ""
    def walkSeq:int 0

    Constructor () {
    }

    fn fromContext:UastCodeModel (ctx:RangerAppWriterContext) {
        return (UastSemantic.fromResult((this.parseContext(ctx))))
    }

    fn parseContext:UastFrontendResult (ctx:RangerAppWriterContext) {
        def r (new UastFrontendResult)
        r.title = "Ranger"
        r.language = "ranger"
        def i:int 0
        while (i < (array_length ctx.definedClassList)) {
            def cName:string (itemAt ctx.definedClassList i)
            def cl:RangerAppClassDesc (unwrap (get ctx.definedClasses cName))
            if (this.keepClass(cl)) {
                this.addClass(r cl)
            }
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length ctx.definedClassList)) {
            def cName2:string (itemAt ctx.definedClassList k)
            def cl2:RangerAppClassDesc (unwrap (get ctx.definedClasses cName2))
            if (this.keepClass(cl2)) {
                this.linkClass(r cl2)
            }
            k = (k + 1)
        }
        return r
    }

    fn addClass:void (r:UastFrontendResult cl:RangerAppClassDesc) {
        def file:string (this.fileOf(cl))
        def nodeKind:string (UastKind.ClassDecl())
        def nativeKind:string "class"
        if cl.is_interface {
            nodeKind = (UastKind.InterfaceDecl())
            nativeKind = "interface"
        }
        def node:UNode (UNode.create(("n:class:" + cl.name) nodeKind "ranger" nativeKind))
        node.name = cl.name
        node.span = (this.spanOfClass(cl))
        node.origin = (UastOrigin.create("ranger" file cl.name 0))
        node.comment = (this.commentOfClass(cl))
        r.addNode(node)
        def fi:int 0
        while (fi < (array_length cl.variables)) {
            def v:RangerAppParamDesc (itemAt cl.variables fi)
            this.addField(r node v)
            fi = (fi + 1)
        }
        this.addFns(r node cl cl.methods false)
        this.addFns(r node cl cl.static_methods true)
    }

    fn addField:void (r:UastFrontendResult owner:UNode v:RangerAppParamDesc) {
        def id:string ((owner.name + ".") + v.name)
        def node:UNode (UNode.create(("n:field:" + id) (UastKind.FieldDecl()) "ranger" "def"))
        node.name = v.name
        node.span = (this.spanOfParam(v))
        node.comment = (this.commentOfParam(v))
        r.addNode(node)
        def tn:UNode (UNode.create(("n:type:" + id) (UastKind.TypeRef()) "ranger" "type"))
        tn.name = (this.typeOfParam(v))
        r.addNode(tn)
        node.addRole((UastChildRole.typeRole()) tn.id)
        owner.addRole((UastChildRole.field()) node.id)
    }

    fn addFns:void (r:UastFrontendResult owner:UNode cl:RangerAppClassDesc fns:[RangerAppFunctionDesc] isStatic:boolean) {
        def i:int 0
        while (i < (array_length fns)) {
            def fn:RangerAppFunctionDesc (itemAt fns i)
            def key:string (this.fnKey(cl fn))
            def node:UNode (UNode.create(("n:method:" + key) (UastKind.MethodDecl()) "ranger" "fn"))
            node.name = fn.name
            node.span = (this.spanOfFn(fn))
            node.comment = (this.commentOfFn(fn))
            if isStatic {
                node.addFlag("static")
            }
            r.addNode(node)
            def ret:UNode (UNode.create(("n:ret:" + key) (UastKind.TypeRef()) "ranger" "type"))
            ret.name = (this.returnType(fn))
            r.addNode(ret)
            node.addRole((UastChildRole.returnType()) ret.id)
            def pi:int 0
            while (pi < (array_length fn.params)) {
                def p:RangerAppParamDesc (itemAt fn.params pi)
                def pid:string ((key + ".") + p.name)
                def pn:UNode (UNode.create(("n:p:" + pid) (UastKind.Parameter()) "ranger" "param"))
                pn.name = p.name
                r.addNode(pn)
                def pt:UNode (UNode.create(("n:pt:" + pid) (UastKind.TypeRef()) "ranger" "type"))
                pt.name = (this.typeOfParam(p))
                r.addNode(pt)
                pn.addRole((UastChildRole.typeRole()) pt.id)
                node.addRole((UastChildRole.parameter()) pn.id)
                pi = (pi + 1)
            }
            if (null? fn.fnBody) {
            } {
                this.walkBlock(r node (unwrap fn.fnBody) key)
            }
            owner.addRole((UastChildRole.method()) node.id)
            i = (i + 1)
        }
    }

    fn linkClass:void (r:UastFrontendResult cl:RangerAppClassDesc) {
        def classNode:string ("n:class:" + cl.name)
        def src:string (UastHintSource.compilerResolved())
        def res:string (UastResolution.resolved())
        def exact:string (UastConfidence.exact())
        if ((array_length cl.extends_classes) > 0) {
            def superName:string (itemAt cl.extends_classes 0)
            r.addHint((UastSemanticHint.create(classNode (UastRelKind.extendsRel()) superName src res exact)))
        }
        def ii:int 0
        while (ii < (array_length cl.implements_interfaces)) {
            def iname:string (itemAt cl.implements_interfaces ii)
            r.addHint((UastSemanticHint.create(classNode (UastRelKind.implementsRel()) iname src res exact)))
            ii = (ii + 1)
        }
        this.linkFns(r cl cl.methods)
        this.linkFns(r cl cl.static_methods)
    }

    fn linkFns:void (r:UastFrontendResult cl:RangerAppClassDesc fns:[RangerAppFunctionDesc]) {
        def src:string (UastHintSource.compilerResolved())
        def res:string (UastResolution.resolved())
        def exact:string (UastConfidence.exact())
        def i:int 0
        while (i < (array_length fns)) {
            def fn:RangerAppFunctionDesc (itemAt fns i)
            def fromNode:string ("n:method:" + (this.fnKey(cl fn)))
            if (r.mentionsNode(fromNode)) {
                def ci:int 0
                while (ci < (array_length fn.isCalling)) {
                    def other:RangerAppFunctionDesc (itemAt fn.isCalling ci)
                    def toNode:string ("n:method:" + (this.fnKeyOfDesc(other)))
                    if (r.mentionsNode(toNode)) {
                        r.addHint((UastSemanticHint.create(fromNode (UastRelKind.calls()) toNode src res exact)))
                    }
                    ci = (ci + 1)
                }
                def ui:int 0
                while (ui < (array_length fn.isDirectlyUsingClasses)) {
                    def used:RangerAppClassDesc (itemAt fn.isDirectlyUsingClasses ui)
                    def usedNode:string ("n:class:" + used.name)
                    if (r.mentionsNode(usedNode)) {
                        r.addHint((UastSemanticHint.create(fromNode (UastRelKind.usesType()) usedNode src res exact)))
                    } {
                        r.addHint((UastSemanticHint.create(fromNode (UastRelKind.usesType()) used.name src res exact)))
                    }
                    ui = (ui + 1)
                }
            }
            i = (i + 1)
        }
    }

    fn fnKey:string (cl:RangerAppClassDesc fn:RangerAppFunctionDesc) {
        return (((cl.name + "\t") + fn.name) + "\t" + (to_string (array_length fn.params)))
    }

    fn fnKeyOfDesc:string (fn:RangerAppFunctionDesc) {
        def cName:string ""
        if (null? fn.container_class) {
            cName = ""
        } {
            def owner:RangerAppClassDesc (unwrap fn.container_class)
            cName = owner.name
        }
        return (((cName + "\t") + fn.name) + "\t" + (to_string (array_length fn.params)))
    }

    fn keepClass:boolean (cl:RangerAppClassDesc) {
        if ((cl.isNormalClass()) == false) {
            return false
        }
        def file:string (this.fileOf(cl))
        if ((indexOf file "Lang.rgr") >= 0) {
            return false
        }
        if ((indexOf file "stdops.rgr") >= 0) {
            return false
        }
        if ((indexOf file "stdlib.rgr") >= 0) {
            return false
        }
        if ((strlen fileFilter) > 0) {
            if ((indexOf file fileFilter) < 0) {
                return false
            }
        }
        return true
    }

    fn fileOf:string (cl:RangerAppClassDesc) {
        if (null? cl.nameNode) {
            return ""
        }
        def nn:CodeNode (unwrap cl.nameNode)
        if (null? nn.code) {
            return ""
        }
        return (nn.getFilename())
    }

    fn spanOfClass:UastSpan (cl:RangerAppClassDesc) {
        if (null? cl.classNode) {
        } {
            return (this.spanOfNode((unwrap cl.classNode)))
        }
        if (null? cl.node) {
        } {
            return (this.spanOfNode((unwrap cl.node)))
        }
        if (null? cl.nameNode) {
            return (new UastSpan)
        }
        return (this.spanOfNode((unwrap cl.nameNode)))
    }

    fn spanOfParam:UastSpan (p:RangerAppParamDesc) {
        if (null? p.nameNode) {
            return (new UastSpan)
        }
        return (this.spanOfNode((unwrap p.nameNode)))
    }

    fn spanOfFn:UastSpan (fn:RangerAppFunctionDesc) {
        if (null? fn.nameNode) {
            return (new UastSpan)
        }
        return (this.spanOfNode((unwrap fn.nameNode)))
    }

    fn spanOfNode:UastSpan (nn:CodeNode) {
        def file:string ""
        def line:int nn.row
        def col:int nn.col
        if (null? nn.code) {
            file = ""
        } {
            def src:SourceCode (unwrap nn.code)
            file = (nn.getFilename())
            if ((strlen file) == 0) {
                file = src.filename
            }
            def fromSp:int (src.getLine(nn.sp))
            if (fromSp >= 0) {
                line = fromSp
            }
        }
        return (UastSpan.ofBytes(file nn.sp nn.ep line col))
    }

    fn typeOfParam:string (p:RangerAppParamDesc) {
        if (null? p.nameNode) {
            return ""
        }
        def nn:CodeNode (unwrap p.nameNode)
        if ((strlen nn.array_type) > 0) {
            return ("[" + nn.array_type + "]")
        }
        return nn.type_name
    }

    fn returnType:string (fn:RangerAppFunctionDesc) {
        if (null? fn.nameNode) {
            return "void"
        }
        def nn:CodeNode (unwrap fn.nameNode)
        if ((strlen nn.type_name) == 0) {
            return "void"
        }
        return nn.type_name
    }

    fn commentOfClass:string (cl:RangerAppClassDesc) {
        if (null? cl.node) {
            if (null? cl.classNode) {
                return ""
            }
            return (this.commentsOn((unwrap cl.classNode)))
        }
        return (this.commentsOn((unwrap cl.node)))
    }

    fn commentOfParam:string (p:RangerAppParamDesc) {
        if (null? p.node) {
            return ""
        }
        return (this.commentsOn((unwrap p.node)))
    }

    fn commentOfFn:string (fn:RangerAppFunctionDesc) {
        if (null? fn.node) {
            return ""
        }
        return (this.commentsOn((unwrap fn.node)))
    }

    fn commentsOn:string (node:CodeNode) {
        def parts:[string]
        def i:int 0
        while (i < (array_length node.comments)) {
            def c:CodeNode (itemAt node.comments i)
            push parts (this.commentLine(c.string_value))
            i = (i + 1)
        }
        return (join parts "\n")
    }

    fn commentLine:string (raw:string) {
        def s:string raw
        while ((strlen s) > 0) {
            def ch:int (charAt s 0)
            if ((ch == 32) || (ch == 9)) {
                s = (substring s 1 (strlen s))
            } {
                break
            }
        }
        return s
    }

    fn nextWalkId:string (prefix:string) {
        walkSeq = (walkSeq + 1)
        return (prefix + (to_string walkSeq))
    }

    fn walkBlock:void (r:UastFrontendResult method:UNode body:CodeNode key:string) {
        def block:UNode (UNode.create(("n:body:" + key) (UastKind.Block()) "ranger" "block"))
        r.addNode(block)
        method.addRole((UastChildRole.body()) block.id)
        def i:int 0
        while (i < (array_length body.children)) {
            this.walkExpr(r block (itemAt body.children i) key)
            i = (i + 1)
        }
    }

    fn walkExpr:void (r:UastFrontendResult owner:UNode node:CodeNode key:string) {
        if (this.looksLikeCall(node)) {
            this.emitCall(r owner node key (UastChildRole.element()))
            return
        }
        def i:int 0
        while (i < (array_length node.children)) {
            this.walkExpr(r owner (itemAt node.children i) key)
            i = (i + 1)
        }
    }

    fn looksLikeCall:boolean (node:CodeNode) {
        if node.has_call {
            return true
        }
        if node.hasFnCall {
            return true
        }
        def i:int 0
        while (i < (array_length node.children)) {
            def ch:CodeNode (itemAt node.children i)
            if ch.is_call_args {
                return true
            }
            i = (i + 1)
        }
        if ((array_length node.children) >= 2) {
            def a:CodeNode (itemAt node.children 0)
            def b:CodeNode (itemAt node.children 1)
            if (a.parsed_type == RangerNodeType.VRef) {
                if ((indexOf a.vref ".") >= 0) {
                    if b.expression {
                        if (b.is_block_node == false) {
                            return true
                        }
                    }
                }
            }
        }
        return false
    }

    fn emitCall:void (r:UastFrontendResult owner:UNode node:CodeNode key:string role:string) {
        def callN:UNode (UNode.create((this.nextWalkId("n:call:")) (UastKind.Call()) "ranger" "call"))
        callN.span = (this.spanOfNode(node))
        r.addNode(callN)
        owner.addRole(role callN.id)
        def callee@(optional):CodeNode
        def i:int 0
        while (i < (array_length node.children)) {
            def ch:CodeNode (itemAt node.children i)
            if ch.is_call_args {
                def ai:int 0
                while (ai < (array_length ch.children)) {
                    this.emitArg(r callN (itemAt ch.children ai) key)
                    ai = (ai + 1)
                }
            } {
                if (null? callee) {
                    if (ch.parsed_type == RangerNodeType.VRef) {
                        callee = ch
                    }
                }
            }
            i = (i + 1)
        }
        if (null? callee) {
            if ((array_length node.children) > 0) {
                def first:CodeNode (itemAt node.children 0)
                if (first.parsed_type == RangerNodeType.VRef) {
                    callee = first
                }
            }
        }
        if (null? callee) {
            return
        }
        def cn:CodeNode (unwrap callee)
        def mem:UNode (this.emitMember(r cn.ns cn))
        callN.addRole((UastChildRole.callee()) mem.id)
        if ((array_length node.children) >= 2) {
            def maybeArgs:CodeNode (itemAt node.children 1)
            if (maybeArgs.is_call_args == false) {
                if maybeArgs.expression {
                    if (maybeArgs.is_block_node == false) {
                        def aj:int 0
                        while (aj < (array_length maybeArgs.children)) {
                            this.emitArg(r callN (itemAt maybeArgs.children aj) key)
                            aj = (aj + 1)
                        }
                    }
                }
            }
        }
    }

    fn emitArg:void (r:UastFrontendResult callN:UNode node:CodeNode key:string) {
        if (this.looksLikeCall(node)) {
            this.emitCall(r callN node key (UastChildRole.argument()))
            return
        }
        if (node.parsed_type == RangerNodeType.VRef) {
            def arg:UNode (UNode.create((this.nextWalkId("n:arg:")) (UastKind.Identifier()) "ranger" "vref"))
            arg.name = node.vref
            arg.span = (this.spanOfNode(node))
            r.addNode(arg)
            callN.addRole((UastChildRole.argument()) arg.id)
            return
        }
        def i:int 0
        while (i < (array_length node.children)) {
            this.emitArg(r callN (itemAt node.children i) key)
            i = (i + 1)
        }
    }

    fn emitMember:UNode (r:UastFrontendResult ns:[string] nn:CodeNode) {
        def n:int (array_length ns)
        if (n <= 1) {
            def idn:UNode (UNode.create((this.nextWalkId("n:id:")) (UastKind.Identifier()) "ranger" "vref"))
            if (n == 1) {
                idn.name = (itemAt ns 0)
            } {
                idn.name = nn.vref
            }
            idn.span = (this.spanOfNode(nn))
            r.addNode(idn)
            return idn
        }
        def recvNs:[string]
        def i:int 0
        while (i < (n - 1)) {
            push recvNs (itemAt ns i)
            i = (i + 1)
        }
        def recv:UNode (this.emitMember(r recvNs nn))
        def mem:UNode (UNode.create((this.nextWalkId("n:id:")) (UastKind.Identifier()) "ranger" "vref"))
        mem.name = (itemAt ns (n - 1))
        r.addNode(mem)
        def acc:UNode (UNode.create((this.nextWalkId("n:mem:")) (UastKind.MemberAccess()) "ranger" "member"))
        acc.span = (this.spanOfNode(nn))
        r.addNode(acc)
        acc.addRole((UastChildRole.receiver()) recv.id)
        acc.addRole((UastChildRole.member()) mem.id)
        return acc
    }

    sfn fromFile:UastCodeModel (path:string) {
        def empty (new UastCodeModel)
        empty.title = path
        empty.language = "ranger"
        def env:InputEnv (new InputEnv)
        env.use_real = true
        env.setEnv("RANGER_LIB" "./compiler/;./lib/;./compiler")
        def params:CmdParams (new CmdParams)
        push params.values path
        set params.params "l" "es6"
        set params.params "o" "uast_ranger_ignored.js"
        set params.flags "no-color" true
        env.commandLine = params
        def vc:VirtualCompiler (new VirtualCompiler)
        def res:CompilerResults (vc.run(env))
        if res.hasErrors {
            empty.title = ((path + " FAIL ") + res.errorMessage)
            empty.addDiagnostic((UastDiagnostic.create(res.errorMessage "error")))
            return empty
        }
        def ctx@(optional):RangerAppWriterContext res.ctx
        if (null? ctx) {
            empty.title = (path + " FAIL no context")
            empty.addDiagnostic((UastDiagnostic.create("no compiler context" "error")))
            return empty
        }
        def appCtx:RangerAppWriterContext (unwrap ctx)
        if ((array_length appCtx.compilerErrors) > 0) {
            def err:RangerCompilerMessage (itemAt appCtx.compilerErrors 0)
            empty.title = ((path + " FAIL ") + err.description)
            empty.addDiagnostic((UastDiagnostic.create(err.description "error")))
            return empty
        }
        def b (new UastRanger)
        def model:UastCodeModel (b.fromContext(appCtx))
        model.title = path
        return model
    }
}

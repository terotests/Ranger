; ============================================================================
; UastTs.rgr — ts_parser TSNode → FrontendResult.
; ============================================================================
;
; The only UAST file that imports gallery/ts_parser. Does not import the
; Ranger compiler. Hints are frontendInferred: the pipeline owns exact.
; Bare npm imports load an on-disk package `.d.ts` into the workspace when
; one exists; `fromDir` still skips `node_modules` as application source.
; Symbols from those files are flagged `library` so CodeGraph can keep
; React's `Component` out of an `App.tsx` neighbourhood.
; ============================================================================

Import "UastFrontend.rgr"
Import "UastSemantic.rgr"
Import "UastKind.rgr"
Import "UastTypeScript.rgr"
Import "../../ts_parser/ts_parser_simple.rgr"
Import "../../../lib/ranger-dir.rgr"

class UastTs {
    def fileName:string ""
    def source:string ""
    def tokens:[Token]
    def seq:int 0
    def classNames:[string]

    Constructor () {
    }

    sfn fromSource:UastCodeModel (source:string fileName:string) {
        def b (new UastTs)
        return (UastSemantic.fromResult((b.parse(source fileName))))
    }

    sfn parseSource:UastFrontendResult (source:string fileName:string) {
        def b (new UastTs)
        return (b.parse(source fileName))
    }

    sfn parseFile:UastFrontendResult (path:string) {
        def text@(optional):string (UastTs.readSource(path))
        if (null? text) {
            def empty (new UastFrontendResult)
            empty.title = (path + " FAIL missing file")
            empty.language = "typescript"
            empty.addDiagnostic((UastDiagnostic.create(("could not read " + path) "error")))
            return empty
        }
        return (UastTs.parseSource((unwrap text) path))
    }

    sfn fromFile:UastCodeModel (path:string) {
        def ws (new UastWorkspace)
        ws.addResult((UastTs.parseFile(path)))
        UastTs.loadPackageDts(ws)
        def m:UastCodeModel (UastSemantic.fromWorkspace(ws))
        m.title = path
        return m
    }

    sfn fromPath:UastCodeModel (path:string) {
        def base:string (UastTs.pathBase(path))
        if (UastTs.isTsParseFile(base)) {
            return (UastTs.fromFile(path))
        }
        return (UastTs.fromDir(path))
    }

    sfn fromDir:UastCodeModel (root:string) {
        def ws (new UastWorkspace)
        def files:[string]
        UastTs.collectTsFiles(root files 0)
        def i:int 0
        while (i < (array_length files)) {
            def path:string (itemAt files i)
            ws.addResult((UastTs.parseFile(path)))
            i = (i + 1)
        }
        UastTs.loadPackageDts(ws)
        def m:UastCodeModel (UastSemantic.fromWorkspace(ws))
        m.title = root
        if ((array_length files) == 0) {
            m.addDiagnostic((UastDiagnostic.create(("no .ts/.tsx files under " + root) "error")))
        }
        return m
    }

    sfn collectTsFiles:void (dir:string out:[string] depth:int) {
        if (depth > 12) {
            return
        }
        if ((dir_exists dir) == false) {
            return
        }
        def names:[string] (list_dir_files dir)
        def i:int 0
        while (i < (array_length names)) {
            def name:string (itemAt names i)
            if (UastTs.skipDirName(name)) {
            } {
                def joined:string ((dir + "/") + name)
                if (UastTs.isTsSource(name)) {
                    push out joined
                } {
                    if (UastTs.looksLikeFile(name)) {
                    } {
                        if (dir_exists joined) {
                            UastTs.collectTsFiles(joined out (depth + 1))
                        }
                    }
                }
            }
            i = (i + 1)
        }
    }

    sfn skipDirName:boolean (name:string) {
        if (name == "node_modules") {
            return true
        }
        if (name == "dist") {
            return true
        }
        if (name == "coverage") {
            return true
        }
        if (name == "build") {
            return true
        }
        if (name == "LICENSE") {
            return true
        }
        if (name == "Makefile") {
            return true
        }
        if ((strlen name) > 0) {
            if ((charAt name 0) == ((ccode "."))) {
                return true
            }
        }
        return false
    }

    sfn isTsSource:boolean (name:string) {
        def n:int (strlen name)
        if (UastTs.isDtsFile(name)) {
            return false
        }
        if (UastTs.isTsxFile(name)) {
            return true
        }
        if (n >= 3) {
            if ((substring name (n - 3) n) == ".ts") {
                return true
            }
        }
        return false
    }

    sfn isDtsFile:boolean (name:string) {
        def n:int (strlen name)
        if (n < 5) {
            return false
        }
        if ((substring name (n - 5) n) == ".d.ts") {
            return true
        }
        return false
    }

    sfn isTsParseFile:boolean (name:string) {
        if (UastTs.isDtsFile(name)) {
            return true
        }
        return (UastTs.isTsSource(name))
    }

    sfn loadPackageDts:void (ws:UastWorkspace) {
        def loaded:[string:int]
        def fi:int 0
        while (fi < (array_length ws.files)) {
            def f:UastSourceFile (itemAt ws.files fi)
            set loaded f.path 1
            fi = (fi + 1)
        }
        def guard:int 0
        def more:boolean true
        while more {
            if (guard > 24) {
                break
            }
            guard = (guard + 1)
            more = false
            def pending:[string]
            def ri:int 0
            while (ri < (array_length ws.results)) {
                def r:UastFrontendResult (itemAt ws.results ri)
                def ni:int 0
                while (ni < (array_length r.nodes)) {
                    def n:UNode (itemAt r.nodes ni)
                    if (n.kind == "Import") {
                        def spec:string n.name
                        if ((strlen spec) > 0) {
                            def hit:string (UastTs.resolveOnDisk(n.span.fileId spec))
                            if ((strlen hit) > 0) {
                                if (has loaded hit) {
                                } {
                                    set loaded hit 1
                                    push pending hit
                                    more = true
                                }
                            }
                        }
                    }
                    ni = (ni + 1)
                }
                ri = (ri + 1)
            }
            def pi:int 0
            while (pi < (array_length pending)) {
                ws.addResult((UastTs.parseFile((itemAt pending pi))))
                pi = (pi + 1)
            }
        }
    }

    sfn resolveOnDisk:string (fromFile:string spec:string) {
        if ((strlen spec) == 0) {
            return ""
        }
        def ch:int (charAt spec 0)
        if ((ch == ((ccode "."))) || (ch == ((ccode "/")))) {
            return (UastTs.resolveRelativeDts(fromFile spec))
        }
        return (UastTs.findPackageDts(fromFile spec))
    }

    sfn resolveRelativeDts:string (fromFile:string spec:string) {
        def joined:string (UastSemantic.joinPath((UastSemantic.dirOf(fromFile)) spec))
        return (UastTs.firstExistingDts(joined))
    }

    sfn findPackageDts:string (fromFile:string spec:string) {
        def dir:string (UastSemantic.dirOf(fromFile))
        def guard:int 0
        while ((strlen dir) > 0) {
            if (guard > 32) {
                break
            }
            guard = (guard + 1)
            def hit:string (UastTs.packageDtsUnder(dir spec))
            if ((strlen hit) > 0) {
                return hit
            }
            def parent:string (UastSemantic.dirOf(dir))
            if (parent == dir) {
                break
            }
            dir = parent
        }
        return (UastTs.packageDtsUnder("." spec))
    }

    sfn packageDtsUnder:string (root:string spec:string) {
        def nm:string ((root + "/node_modules/") + spec)
        def fromJson:string (UastTs.typesFromPackageJson((nm + "/package.json")))
        if ((strlen fromJson) > 0) {
            def joined:string ((nm + "/") + fromJson)
            if (UastTs.diskFile(joined)) {
                return joined
            }
        }
        def direct:string (UastTs.firstExistingDts(nm))
        if ((strlen direct) > 0) {
            return direct
        }
        if ((strlen spec) > 0) {
            if ((charAt spec 0) != ((ccode "@"))) {
                def pkgName:string (UastTs.packageRootName(spec))
                def atTypes:string (UastTs.firstExistingDts(((root + "/node_modules/@types/") + pkgName)))
                if ((strlen atTypes) > 0) {
                    return atTypes
                }
            }
        }
        return ""
    }

    sfn packageRootName:string (spec:string) {
        if ((strlen spec) == 0) {
            return spec
        }
        if ((charAt spec 0) == ((ccode "@"))) {
            def slashes:int 0
            def i:int 1
            while (i < (strlen spec)) {
                if ((charAt spec i) == ((ccode "/"))) {
                    slashes = (slashes + 1)
                    if (slashes == 2) {
                        return (substring spec 0 i)
                    }
                }
                i = (i + 1)
            }
            return spec
        }
        def j:int 0
        while (j < (strlen spec)) {
            if ((charAt spec j) == ((ccode "/"))) {
                return (substring spec 0 j)
            }
            j = (j + 1)
        }
        return spec
    }

    sfn firstExistingDts:string (base:string) {
        if (UastTs.diskFile(base)) {
            if (UastTs.looksLikeFile((UastSemantic.baseName(base)))) {
                return base
            }
        }
        if (UastTs.diskFile((base + ".d.ts"))) {
            return (base + ".d.ts")
        }
        if (UastTs.diskFile((base + ".ts"))) {
            return (base + ".ts")
        }
        if (UastTs.diskFile((base + ".tsx"))) {
            return (base + ".tsx")
        }
        if (UastTs.diskFile((base + "/index.d.ts"))) {
            return (base + "/index.d.ts")
        }
        if (UastTs.diskFile((base + "/index.ts"))) {
            return (base + "/index.ts")
        }
        return ""
    }

    sfn diskFile:boolean (path:string) {
        def dir:string (UastSemantic.dirOf(path))
        def name:string (UastSemantic.baseName(path))
        if ((strlen name) == 0) {
            return false
        }
        if ((strlen dir) == 0) {
            return (file_exists "." name)
        }
        return (file_exists dir name)
    }

    sfn typesFromPackageJson:string (path:string) {
        def text@(optional):string (UastTs.readSource(path))
        if (null? text) {
            return ""
        }
        def json:string (unwrap text)
        def types:string (UastTs.jsonStringField(json "types"))
        if ((strlen types) > 0) {
            return types
        }
        return (UastTs.jsonStringField(json "typings"))
    }

    sfn jsonStringField:string (json:string key:string) {
        def needle:string (("\"" + key) + "\"")
        def i:int (indexOf json needle)
        if (i < 0) {
            return ""
        }
        def j:int (i + (strlen needle))
        def n:int (strlen json)
        while (j < n) {
            def ch:int (charAt json j)
            if ((ch == 32) || ((ch == 9) || ((ch == 10) || (ch == 13)))) {
                j = (j + 1)
            } {
                break
            }
        }
        if (j >= n) {
            return ""
        }
        if ((charAt json j) != ((ccode ":"))) {
            return ""
        }
        j = (j + 1)
        while (j < n) {
            def ch2:int (charAt json j)
            if ((ch2 == 32) || ((ch2 == 9) || ((ch2 == 10) || (ch2 == 13)))) {
                j = (j + 1)
            } {
                break
            }
        }
        if (j >= n) {
            return ""
        }
        if ((charAt json j) != 34) {
            return ""
        }
        j = (j + 1)
        def start:int j
        while (j < n) {
            if ((charAt json j) == 34) {
                return (substring json start j)
            }
            j = (j + 1)
        }
        return ""
    }

    sfn isTsxFile:boolean (name:string) {
        def n:int (strlen name)
        if (n < 4) {
            return false
        }
        if ((substring name (n - 4) n) == ".tsx") {
            return true
        }
        return false
    }

    sfn isLibraryPath:boolean (path:string) {
        return (UastSemantic.libraryPath(path))
    }

    sfn isComponentName:boolean (name:string) {
        if ((strlen name) == 0) {
            return false
        }
        def ch:int (charAt name 0)
        if ((ch >= 65) && (ch <= 90)) {
            return true
        }
        return false
    }

    sfn looksLikeFile:boolean (name:string) {
        def i:int 1
        while (i < (strlen name)) {
            if ((charAt name i) == ((ccode "."))) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn pathBase:string (path:string) {
        def slash:int (0 - 1)
        def i:int 0
        while (i < (strlen path)) {
            if ((charAt path i) == ((ccode "/"))) {
                slash = i
            }
            i = (i + 1)
        }
        if (slash < 0) {
            return path
        }
        return (substring path (slash + 1) (strlen path))
    }

    sfn readSource@(optional):string (path:string) {
        def cut:int (0 - 1)
        def i:int 0
        while (i < (strlen path)) {
            if ((charAt path i) == ((ccode "/"))) {
                cut = i
            }
            i = (i + 1)
        }
        def dir:string "."
        def name:string path
        if (cut >= 0) {
            dir = (substring path 0 cut)
            name = (substring path (cut + 1) (strlen path))
        }
        def text@(optional):string (read_file dir name)
        return text
    }

    fn parse:UastFrontendResult (src:string path:string) {
        source = src
        fileName = path
        def r (new UastFrontendResult)
        r.title = path
        r.language = "typescript"
        def file:UastSourceFile (r.addFile(path "typescript"))
        file.version = 1
        def lexer:TSLexer (new TSLexer(src))
        tokens = (lexer.tokenize())
        def parser:TSParserSimple (new TSParserSimple())
        parser.initParser(tokens)
        parser.setQuiet(true)
        if (UastTs.isTsxFile(path)) {
            parser.setTsxMode(true)
        }
        def program:TSNode (parser.parseProgram())
        if (parser.errorCount > 0) {
            def msg:string parser.firstErrorText
            if (parser.firstErrorLine >= 0) {
                msg = (((msg + " at ") + fileName) + ":") + (to_string (parser.firstErrorLine + 1))
            }
            r.addDiagnostic((UastDiagnostic.create(msg "error")))
        }
        this.collectClassNames(program)
        this.walkProgram(r program)
        return r
    }

    fn fileKey:string () {
        def base:string (UastTs.pathBase(fileName))
        def stem:string base
        def dot:int (0 - 1)
        def j:int 0
        while (j < (strlen base)) {
            if ((charAt base j) == ((ccode "."))) {
                if (dot < 0) {
                    dot = j
                }
            }
            j = (j + 1)
        }
        if (dot > 0) {
            stem = (substring base 0 dot)
        }
        def parent:string (UastSemantic.baseName((UastSemantic.dirOf(fileName))))
        if ((strlen parent) == 0) {
            return stem
        }
        return ((parent + "_") + stem)
    }

    fn collectClassNames:void (program:TSNode) {
        def i:int 0
        while (i < (array_length program.children)) {
            def st:TSNode (itemAt program.children i)
            this.noteTypeName(st)
            if ((st.nodeType == "ExportNamedDeclaration") || (st.nodeType == "ExportDefaultDeclaration")) {
                if (null? st.left) {
                } {
                    this.noteTypeName((unwrap st.left))
                }
            }
            i = (i + 1)
        }
    }

    fn walkProgram:void (r:UastFrontendResult program:TSNode) {
        this.walkStmtList(r program.children)
    }

    fn walkStmtList:void (r:UastFrontendResult stmts:[TSNode]) {
        def i:int 0
        while (i < (array_length stmts)) {
            this.walkTopStmt(r (itemAt stmts i))
            i = (i + 1)
        }
    }

    fn walkTopStmt:void (r:UastFrontendResult st:TSNode) {
        if (st.nodeType == "ClassDeclaration") {
            this.addClass(r st)
        }
        if (st.nodeType == "TSInterfaceDeclaration") {
            this.addInterface(r st)
        }
        if (st.nodeType == "FunctionDeclaration") {
            this.addFunction(r st)
        }
        if (st.nodeType == "VariableDeclaration") {
            this.addVarDecls(r st false)
        }
        if (st.nodeType == "TSTypeAliasDeclaration") {
            this.addTypeAlias(r st)
        }
        if (st.nodeType == "ImportDeclaration") {
            this.addImport(r st)
        }
        if ((st.nodeType == "ExportNamedDeclaration") || (st.nodeType == "ExportDefaultDeclaration")) {
            this.addExport(r st)
        }
        if (st.nodeType == "TSNamespaceExportDeclaration") {
            this.addNamedExport(r st st.name)
        }
        if (st.nodeType == "TSExportAssignment") {
            def assignName:string ""
            if (null? st.left) {
            } {
                def left:TSNode (unwrap st.left)
                assignName = left.name
            }
            this.addNamedExport(r st assignName)
        }
        if (st.nodeType == "TSModuleDeclaration") {
            this.addNamespace(r st)
            if (null? st.body) {
            } {
                def body:TSNode (unwrap st.body)
                this.walkStmtList(r body.children)
            }
        }
    }

    fn noteTypeName:void (ts:TSNode) {
        if ((ts.nodeType == "ClassDeclaration") || (ts.nodeType == "TSInterfaceDeclaration")) {
            if ((strlen ts.name) > 0) {
                push classNames ts.name
            }
        }
    }

    fn addClass:UNode (r:UastFrontendResult ts:TSNode) {
        def node:UNode (UNode.create((this.nextId("n:class:")) (UastKind.ClassDecl()) "typescript" ts.nodeType))
        node.name = ts.name
        node.span = (this.spanOf(ts))
        node.origin = (UastOrigin.create("typescript" fileName ts.name 1))
        node.comment = (this.commentsBefore(ts.start))
        if (UastTs.isLibraryPath(fileName)) {
            node.addFlag("library")
        }
        r.addNode(node)
        this.addHeritage(r node ts)
        if (null? ts.body) {
            return node
        }
        def body:TSNode (unwrap ts.body)
        def mi:int 0
        while (mi < (array_length body.children)) {
            def mem:TSNode (itemAt body.children mi)
            if (mem.nodeType == "PropertyDefinition") {
                this.addField(r node mem)
            }
            if (mem.nodeType == "MethodDefinition") {
                this.addMethod(r node mem)
            }
            mi = (mi + 1)
        }
        return node
    }

    fn addInterface:UNode (r:UastFrontendResult ts:TSNode) {
        def node:UNode (UNode.create((this.nextId("n:iface:")) (UastKind.InterfaceDecl()) "typescript" ts.nodeType))
        node.name = ts.name
        node.span = (this.spanOf(ts))
        node.origin = (UastOrigin.create("typescript" fileName ts.name 1))
        node.comment = (this.commentsBefore(ts.start))
        if (UastTs.isLibraryPath(fileName)) {
            node.addFlag("library")
        }
        r.addNode(node)
        this.addHeritage(r node ts)
        if (null? ts.body) {
            return node
        }
        def body:TSNode (unwrap ts.body)
        def mi:int 0
        while (mi < (array_length body.children)) {
            def mem:TSNode (itemAt body.children mi)
            if (mem.nodeType == "TSPropertySignature") {
                this.addField(r node mem)
            }
            if (mem.nodeType == "TSMethodSignature") {
                this.addMethod(r node mem)
            }
            mi = (mi + 1)
        }
        return node
    }

    fn addFunction:UNode (r:UastFrontendResult ts:TSNode) {
        return (this.addNamedFn(r ts ts.name))
    }

    fn addNamedFn:UNode (r:UastFrontendResult ts:TSNode name:string) {
        def node:UNode (UNode.create((this.nextId("n:fn:")) (UastKind.FunctionDecl()) "typescript" ts.nodeType))
        node.name = name
        if ((strlen node.name) == 0) {
            node.name = "default"
        }
        node.span = (this.spanOf(ts))
        node.origin = (UastOrigin.create("typescript" fileName node.name 1))
        node.comment = (this.commentsBefore(ts.start))
        if (UastTs.isComponentName(node.name)) {
            node.addFlag("component")
        }
        if (UastTs.isLibraryPath(fileName)) {
            node.addFlag("library")
        }
        r.addNode(node)
        def ret:UNode (UNode.create((this.nextId("n:ret:")) (UastKind.TypeRef()) "typescript" "type"))
        ret.name = (this.typeNameOf(ts.typeAnnotation))
        r.addNode(ret)
        node.addRole((UastChildRole.returnType()) ret.id)
        def pi:int 0
        while (pi < (array_length ts.params)) {
            def p:TSNode (itemAt ts.params pi)
            def pn:UNode (UNode.create((this.nextId("n:p:")) (UastKind.Parameter()) "typescript" "param"))
            pn.name = p.name
            r.addNode(pn)
            def pt:UNode (UNode.create((this.nextId("n:pt:")) (UastKind.TypeRef()) "typescript" "type"))
            pt.name = (this.typeNameOf(p.typeAnnotation))
            r.addNode(pt)
            pn.addRole((UastChildRole.typeRole()) pt.id)
            node.addRole((UastChildRole.parameter()) pn.id)
            pi = (pi + 1)
        }
        if (null? ts.body) {
            return node
        }
        def bodyTs:TSNode (unwrap ts.body)
        def block:UNode (UNode.create((this.nextId("n:body:")) (UastKind.Block()) "typescript" "BlockStatement"))
        r.addNode(block)
        node.addRole((UastChildRole.body()) block.id)
        this.walkStmt(r block bodyTs)
        this.collectFnMembers(r node bodyTs)
        return node
    }

    fn addVarDecls:void (r:UastFrontendResult ts:TSNode exported:boolean) {
        def i:int 0
        while (i < (array_length ts.children)) {
            def d:TSNode (itemAt ts.children i)
            if (d.nodeType == "VariableDeclarator") {
                if (null? d.init) {
                } {
                    def init:TSNode (unwrap d.init)
                    def isFn:boolean false
                    if (init.nodeType == "ArrowFunctionExpression") {
                        isFn = true
                    }
                    if (init.nodeType == "FunctionExpression") {
                        isFn = true
                    }
                    if isFn {
                        if ((strlen d.name) > 0) {
                            def fnN:UNode (this.addNamedFn(r init d.name))
                            if exported {
                                fnN.addFlag("export")
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
    }

    fn addTypeAlias:UNode (r:UastFrontendResult ts:TSNode) {
        def node:UNode (UNode.create((this.nextId("n:type:")) (UastKind.TypeDecl()) "typescript" ts.nodeType))
        node.name = ts.name
        node.span = (this.spanOf(ts))
        node.origin = (UastOrigin.create("typescript" fileName ts.name 1))
        node.comment = (this.commentsBefore(ts.start))
        if (UastTs.isLibraryPath(fileName)) {
            node.addFlag("library")
        }
        r.addNode(node)
        def tn:UNode (UNode.create((this.nextId("n:alias:")) (UastKind.TypeRef()) "typescript" "type"))
        tn.name = (this.typeNameOf(ts.typeAnnotation))
        r.addNode(tn)
        node.addRole((UastChildRole.typeRole()) tn.id)
        return node
    }

    fn addNamespace:void (r:UastFrontendResult ts:TSNode) {
        if ((strlen ts.name) == 0) {
            return
        }
        if ((charAt ts.name 0) == 34) {
            return
        }
        def node:UNode (UNode.create((this.nextId("n:ns:")) (UastKind.TypeDecl()) "typescript" ts.nodeType))
        node.name = ts.name
        node.span = (this.spanOf(ts))
        node.origin = (UastOrigin.create("typescript" fileName ts.name 1))
        r.addNode(node)
    }

    fn addNamedExport:void (r:UastFrontendResult ts:TSNode name:string) {
        if ((strlen name) == 0) {
            return
        }
        def node:UNode (UNode.create((this.nextId("n:export:")) (UastKind.Export()) "typescript" ts.nodeType))
        node.span = (this.spanOf(ts))
        r.addNode(node)
        def idn:UNode (UNode.create((this.nextId("n:id:")) (UastKind.Identifier()) "typescript" "ExportSpecifier"))
        idn.name = name
        idn.span = node.span
        r.addNode(idn)
        node.addRole((UastChildRole.nameRole()) idn.id)
    }

    fn addHeritage:void (r:UastFrontendResult node:UNode ts:TSNode) {
        if (null? ts.left) {
        } {
            this.addExtendsHint(r node (this.heritageNameOf((unwrap ts.left))))
        }
        if (node.kind == "InterfaceDecl") {
            def i:int 0
            while (i < (array_length ts.children)) {
                def ch:TSNode (itemAt ts.children i)
                if (ch.nodeType == "TSExpressionWithTypeArguments") {
                    this.addExtendsHint(r node (this.heritageNameOf(ch)))
                }
                i = (i + 1)
            }
        }
    }

    fn addExtendsHint:void (r:UastFrontendResult node:UNode superName:string) {
        if ((strlen superName) == 0) {
            return
        }
        def src:string (UastHintSource.frontendInferred())
        r.addHint((UastSemanticHint.create(node.id (UastRelKind.extendsRel()) superName src (UastResolution.resolved()) (UastConfidence.inferred()))))
    }

    fn heritageNameOf:string (ts:TSNode) {
        if (ts.nodeType == "TSExpressionWithTypeArguments") {
            if (null? ts.left) {
                return ts.name
            }
            return (this.heritageNameOf((unwrap ts.left)))
        }
        if ((strlen ts.name) > 0) {
            return ts.name
        }
        return ts.value
    }

    fn addImport:void (r:UastFrontendResult ts:TSNode) {
        def node:UNode (UNode.create((this.nextId("n:import:")) (UastKind.Import()) "typescript" ts.nodeType))
        node.span = (this.spanOf(ts))
        if (null? ts.left) {
        } {
            def src:TSNode (unwrap ts.left)
            node.name = src.value
        }
        r.addNode(node)
        def i:int 0
        while (i < (array_length ts.children)) {
            def spec:TSNode (itemAt ts.children i)
            def idn:UNode (UNode.create((this.nextId("n:id:")) (UastKind.Identifier()) "typescript" spec.nodeType))
            idn.name = spec.name
            idn.span = (this.spanOf(ts))
            r.addNode(idn)
            node.addRole((UastChildRole.nameRole()) idn.id)
            i = (i + 1)
        }
    }

    fn addExport:void (r:UastFrontendResult ts:TSNode) {
        def node:UNode (UNode.create((this.nextId("n:export:")) (UastKind.Export()) "typescript" ts.nodeType))
        node.span = (this.spanOf(ts))
        r.addNode(node)
        if (null? ts.left) {
        } {
            def decl:TSNode (unwrap ts.left)
            if (decl.nodeType == "ClassDeclaration") {
                def cls:UNode (this.addClass(r decl))
                cls.addFlag("export")
                node.addRole((UastChildRole.element()) cls.id)
            }
            if (decl.nodeType == "TSInterfaceDeclaration") {
                def iface:UNode (this.addInterface(r decl))
                iface.addFlag("export")
                node.addRole((UastChildRole.element()) iface.id)
            }
            if (decl.nodeType == "FunctionDeclaration") {
                def fnN:UNode (this.addFunction(r decl))
                fnN.addFlag("export")
                node.addRole((UastChildRole.element()) fnN.id)
            }
            if (decl.nodeType == "TSTypeAliasDeclaration") {
                def ty:UNode (this.addTypeAlias(r decl))
                ty.addFlag("export")
                node.addRole((UastChildRole.element()) ty.id)
            }
            if (decl.nodeType == "VariableDeclaration") {
                this.addVarDecls(r decl true)
            }
        }
        def i:int 0
        while (i < (array_length ts.children)) {
            def spec:TSNode (itemAt ts.children i)
            def idn:UNode (UNode.create((this.nextId("n:id:")) (UastKind.Identifier()) "typescript" spec.nodeType))
            idn.name = spec.name
            idn.span = (this.spanOf(ts))
            r.addNode(idn)
            node.addRole((UastChildRole.nameRole()) idn.id)
            i = (i + 1)
        }
    }

    fn addField:void (r:UastFrontendResult owner:UNode ts:TSNode) {
        def node:UNode (UNode.create((this.nextId("n:field:")) (UastKind.FieldDecl()) "typescript" ts.nodeType))
        node.name = ts.name
        node.span = (this.spanOf(ts))
        node.comment = (this.commentsBefore(ts.start))
        if (ts.kind == "static") {
            node.addFlag("static")
        }
        r.addNode(node)
        def tn:UNode (UNode.create((this.nextId("n:type:")) (UastKind.TypeRef()) "typescript" "type"))
        tn.name = (this.typeNameOf(ts.typeAnnotation))
        r.addNode(tn)
        node.addRole((UastChildRole.typeRole()) tn.id)
        owner.addRole((UastChildRole.field()) node.id)
        if (this.mentionsClass(tn.name)) {
            def src:string (UastHintSource.frontendInferred())
            r.addHint((UastSemanticHint.create(owner.id (UastRelKind.usesType()) tn.name src (UastResolution.resolved()) (UastConfidence.inferred()))))
        }
    }

    fn addMethod:void (r:UastFrontendResult owner:UNode ts:TSNode) {
        if ((strlen ts.name) == 0) {
            return
        }
        if (ts.name == "constructor") {
            return
        }
        def node:UNode (UNode.create((this.nextId("n:method:")) (UastKind.MethodDecl()) "typescript" ts.nodeType))
        node.name = ts.name
        node.span = (this.spanOf(ts))
        node.comment = (this.commentsBefore(ts.start))
        if (ts.kind == "static") {
            node.addFlag("static")
        }
        r.addNode(node)
        def ret:UNode (UNode.create((this.nextId("n:ret:")) (UastKind.TypeRef()) "typescript" "type"))
        ret.name = (this.typeNameOf(ts.typeAnnotation))
        r.addNode(ret)
        node.addRole((UastChildRole.returnType()) ret.id)
        def pi:int 0
        while (pi < (array_length ts.params)) {
            def p:TSNode (itemAt ts.params pi)
            def pn:UNode (UNode.create((this.nextId("n:p:")) (UastKind.Parameter()) "typescript" "param"))
            pn.name = p.name
            r.addNode(pn)
            def pt:UNode (UNode.create((this.nextId("n:pt:")) (UastKind.TypeRef()) "typescript" "type"))
            pt.name = (this.typeNameOf(p.typeAnnotation))
            r.addNode(pt)
            pn.addRole((UastChildRole.typeRole()) pt.id)
            node.addRole((UastChildRole.parameter()) pn.id)
            pi = (pi + 1)
        }
        owner.addRole((UastChildRole.method()) node.id)
        if (null? ts.body) {
            return
        }
        def bodyTs:TSNode (unwrap ts.body)
        def block:UNode (UNode.create((this.nextId("n:body:")) (UastKind.Block()) "typescript" "BlockStatement"))
        r.addNode(block)
        node.addRole((UastChildRole.body()) block.id)
        this.walkStmt(r block bodyTs)
    }

    fn walkStmt:void (r:UastFrontendResult owner:UNode ts:TSNode) {
        if (ts.nodeType == "CallExpression") {
            def callN:UNode (this.buildCall(r ts))
            owner.addRole((UastChildRole.element()) callN.id)
            this.walkFnArgs(r owner ts)
            return
        }
        if (ts.nodeType == "NewExpression") {
            def newN:UNode (this.buildNew(r ts))
            owner.addRole((UastChildRole.element()) newN.id)
            return
        }
        if (ts.nodeType == "JSXElement") {
            this.walkJsx(r owner ts)
            return
        }
        if (ts.nodeType == "JSXFragment") {
            this.walkJsxChildren(r owner ts)
            return
        }
        if (ts.nodeType == "JSXExpressionContainer") {
            if (null? ts.left) {
                return
            }
            this.walkStmt(r owner (unwrap ts.left))
            return
        }
        if (ts.nodeType == "ExpressionStatement") {
            if (null? ts.left) {
                return
            }
            this.walkStmt(r owner (unwrap ts.left))
            return
        }
        if (ts.nodeType == "BlockStatement") {
            def i:int 0
            while (i < (array_length ts.children)) {
                this.walkStmt(r owner (itemAt ts.children i))
                i = (i + 1)
            }
            return
        }
        if (ts.nodeType == "VariableDeclarator") {
            if (null? ts.init) {
            } {
                this.walkStmt(r owner (unwrap ts.init))
            }
            if (null? ts.left) {
            } {
                this.walkStmt(r owner (unwrap ts.left))
            }
            return
        }
        if (null? ts.init) {
        } {
            this.walkStmt(r owner (unwrap ts.init))
        }
        if (null? ts.test) {
        } {
            this.walkStmt(r owner (unwrap ts.test))
        }
        if (null? ts.consequent) {
        } {
            this.walkStmt(r owner (unwrap ts.consequent))
        }
        if (null? ts.alternate) {
        } {
            this.walkStmt(r owner (unwrap ts.alternate))
        }
        if (null? ts.left) {
        } {
            this.walkStmt(r owner (unwrap ts.left))
        }
        if (null? ts.right) {
        } {
            this.walkStmt(r owner (unwrap ts.right))
        }
        if (null? ts.body) {
        } {
            this.walkStmt(r owner (unwrap ts.body))
        }
        def ci:int 0
        while (ci < (array_length ts.children)) {
            this.walkStmt(r owner (itemAt ts.children ci))
            ci = (ci + 1)
        }
    }

    fn walkFnArgs:void (r:UastFrontendResult owner:UNode ts:TSNode) {
        def ai:int 0
        while (ai < (array_length ts.children)) {
            def arg:TSNode (itemAt ts.children ai)
            if (this.isFnNode(arg)) {
                this.walkStmt(r owner arg)
            }
            ai = (ai + 1)
        }
    }

    fn isFnNode:boolean (ts:TSNode) {
        if (ts.nodeType == "ArrowFunctionExpression") {
            return true
        }
        if (ts.nodeType == "FunctionExpression") {
            return true
        }
        if (ts.nodeType == "FunctionDeclaration") {
            return true
        }
        return false
    }

    fn collectFnMembers:void (r:UastFrontendResult owner:UNode ts:TSNode) {
        if (ts.nodeType == "VariableDeclaration") {
            def i:int 0
            while (i < (array_length ts.children)) {
                this.collectVarMember(r owner (itemAt ts.children i))
                i = (i + 1)
            }
            return
        }
        if (ts.nodeType == "FunctionDeclaration") {
            if ((strlen ts.name) > 0) {
                this.addLocalMethod(r owner ts.name ts)
            }
            return
        }
        if (ts.nodeType == "JSXElement") {
            this.collectJsxHandlers(r owner ts)
        }
        if (ts.nodeType == "CallExpression") {
            def stmtHook:string (this.calleeIdent(ts))
            if (this.isHookName(stmtHook)) {
                if ((stmtHook == "useEffect") || (stmtHook == "useLayoutEffect")) {
                    this.addLocalMethod(r owner stmtHook ts)
                }
            }
        }
        if (null? ts.init) {
        } {
            this.collectFnMembers(r owner (unwrap ts.init))
        }
        if (null? ts.left) {
        } {
            this.collectFnMembers(r owner (unwrap ts.left))
        }
        if (null? ts.right) {
        } {
            this.collectFnMembers(r owner (unwrap ts.right))
        }
        if (null? ts.body) {
        } {
            this.collectFnMembers(r owner (unwrap ts.body))
        }
        if (null? ts.consequent) {
        } {
            this.collectFnMembers(r owner (unwrap ts.consequent))
        }
        if (null? ts.alternate) {
        } {
            this.collectFnMembers(r owner (unwrap ts.alternate))
        }
        def ci:int 0
        while (ci < (array_length ts.children)) {
            this.collectFnMembers(r owner (itemAt ts.children ci))
            ci = (ci + 1)
        }
    }

    fn collectVarMember:void (r:UastFrontendResult owner:UNode d:TSNode) {
        if (d.nodeType != "VariableDeclarator") {
            return
        }
        if (null? d.init) {
            return
        }
        def init:TSNode (unwrap d.init)
        if (this.isFnNode(init)) {
            if ((strlen d.name) > 0) {
                this.addLocalMethod(r owner d.name init)
            }
            return
        }
        if (init.nodeType != "CallExpression") {
            return
        }
        def hook:string (this.calleeIdent(init))
        if (this.isHookName(hook) == false) {
            return
        }
        def ty:string (this.hookTypeName(init d))
        if (hook == "useCallback") {
            if ((strlen d.name) > 0) {
                this.addLocalMethod(r owner d.name init)
            }
            return
        }
        if (hook == "useEffect") {
            this.addLocalMethod(r owner hook init)
            return
        }
        if (hook == "useLayoutEffect") {
            this.addLocalMethod(r owner hook init)
            return
        }
        def names:[string]
        if (null? d.left) {
            if ((strlen d.name) > 0) {
                push names d.name
            }
        } {
            this.collectBindingNames((unwrap d.left) names)
        }
        def ni:int 0
        while (ni < (array_length names)) {
            def nm:string (itemAt names ni)
            if (ni == 0) {
                this.addLocalField(r owner nm ty)
            } {
                if (this.looksLikeSetter(nm)) {
                    this.addLocalMethod(r owner nm init)
                } {
                    this.addLocalField(r owner nm ty)
                }
            }
            ni = (ni + 1)
        }
        if ((array_length names) == 0) {
            this.addLocalMethod(r owner hook init)
        }
    }

    fn collectJsxHandlers:void (r:UastFrontendResult owner:UNode ts:TSNode) {
        if (null? ts.left) {
        } {
            def opening:TSNode (unwrap ts.left)
            def ai:int 0
            while (ai < (array_length opening.children)) {
                def attr:TSNode (itemAt opening.children ai)
                if (this.isEventAttr(attr.name)) {
                    if (null? attr.right) {
                    } {
                        def val:TSNode (unwrap attr.right)
                        def expr:TSNode val
                        if (val.nodeType == "JSXExpressionContainer") {
                            if (null? val.left) {
                            } {
                                expr = (unwrap val.left)
                            }
                        }
                        if (this.isFnNode(expr)) {
                            this.addLocalMethod(r owner attr.name expr)
                        }
                    }
                }
                ai = (ai + 1)
            }
        }
    }

    fn isEventAttr:boolean (name:string) {
        if ((strlen name) < 3) {
            return false
        }
        if ((charAt name 0) != ((ccode "o"))) {
            return false
        }
        if ((charAt name 1) != ((ccode "n"))) {
            return false
        }
        def ch:int (charAt name 2)
        if ((ch >= 65) && (ch <= 90)) {
            return true
        }
        return false
    }

    fn looksLikeSetter:boolean (name:string) {
        if ((strlen name) < 4) {
            return false
        }
        if ((substring name 0 3) != "set") {
            return false
        }
        def ch:int (charAt name 3)
        if ((ch >= 65) && (ch <= 90)) {
            return true
        }
        return false
    }

    fn isHookName:boolean (name:string) {
        if ((strlen name) < 4) {
            return false
        }
        if ((substring name 0 3) != "use") {
            return false
        }
        def ch:int (charAt name 3)
        if ((ch >= 65) && (ch <= 90)) {
            return true
        }
        return false
    }

    fn calleeIdent:string (ts:TSNode) {
        if (null? ts.left) {
            return ts.name
        }
        def c:TSNode (unwrap ts.left)
        if ((strlen c.name) > 0) {
            return c.name
        }
        return ts.name
    }

    fn hookTypeName:string (call:TSNode d:TSNode) {
        def fromAnn:string (this.typeNameOf(d.typeAnnotation))
        if ((strlen fromAnn) > 0) {
            return fromAnn
        }
        if ((array_length call.params) > 0) {
            def arg:TSNode (itemAt call.params 0)
            if ((strlen arg.name) > 0) {
                return arg.name
            }
        }
        return ""
    }

    fn collectBindingNames:void (ts:TSNode out:[string]) {
        if (ts.nodeType == "AssignmentPattern") {
            if (null? ts.left) {
            } {
                this.collectBindingNames((unwrap ts.left) out)
            }
            return
        }
        if ((ts.nodeType == "ArrayPattern") || (ts.nodeType == "ObjectPattern")) {
            def i:int 0
            while (i < (array_length ts.children)) {
                this.collectBindingNames((itemAt ts.children i) out)
                i = (i + 1)
            }
            if (null? ts.left) {
            } {
                this.collectBindingNames((unwrap ts.left) out)
            }
            return
        }
        if (ts.nodeType == "Property") {
            if (null? ts.right) {
                if ((strlen ts.name) > 0) {
                    push out ts.name
                }
            } {
                this.collectBindingNames((unwrap ts.right) out)
            }
            return
        }
        if (ts.nodeType == "RestElement") {
            if ((strlen ts.name) > 0) {
                push out ts.name
            } {
                if (null? ts.left) {
                } {
                    this.collectBindingNames((unwrap ts.left) out)
                }
            }
            return
        }
        if ((strlen ts.name) > 0) {
            push out ts.name
        }
    }

    fn addLocalField:void (r:UastFrontendResult owner:UNode name:string typeName:string) {
        if ((strlen name) == 0) {
            return
        }
        if (this.ownerMentions(r owner (UastChildRole.field()) name)) {
            return
        }
        def node:UNode (UNode.create((this.nextId("n:field:")) (UastKind.FieldDecl()) "typescript" "hook"))
        node.name = name
        node.span = owner.span
        r.addNode(node)
        def tn:UNode (UNode.create((this.nextId("n:type:")) (UastKind.TypeRef()) "typescript" "type"))
        tn.name = typeName
        r.addNode(tn)
        node.addRole((UastChildRole.typeRole()) tn.id)
        owner.addRole((UastChildRole.field()) node.id)
    }

    fn addLocalMethod:void (r:UastFrontendResult owner:UNode name:string ts:TSNode) {
        if ((strlen name) == 0) {
            return
        }
        if (this.ownerMentions(r owner (UastChildRole.method()) name)) {
            return
        }
        def node:UNode (UNode.create((this.nextId("n:method:")) (UastKind.MethodDecl()) "typescript" ts.nodeType))
        node.name = name
        node.span = (this.spanOf(ts))
        r.addNode(node)
        def ret:UNode (UNode.create((this.nextId("n:ret:")) (UastKind.TypeRef()) "typescript" "type"))
        ret.name = (this.typeNameOf(ts.typeAnnotation))
        r.addNode(ret)
        node.addRole((UastChildRole.returnType()) ret.id)
        def fnTs:TSNode ts
        if (ts.nodeType == "CallExpression") {
            if ((array_length ts.children) > 0) {
                def arg0:TSNode (itemAt ts.children 0)
                if (this.isFnNode(arg0)) {
                    fnTs = arg0
                }
            }
        }
        def pi:int 0
        while (pi < (array_length fnTs.params)) {
            def p:TSNode (itemAt fnTs.params pi)
            def pn:UNode (UNode.create((this.nextId("n:p:")) (UastKind.Parameter()) "typescript" "param"))
            pn.name = p.name
            r.addNode(pn)
            def pt:UNode (UNode.create((this.nextId("n:pt:")) (UastKind.TypeRef()) "typescript" "type"))
            pt.name = (this.typeNameOf(p.typeAnnotation))
            r.addNode(pt)
            pn.addRole((UastChildRole.typeRole()) pt.id)
            node.addRole((UastChildRole.parameter()) pn.id)
            pi = (pi + 1)
        }
        owner.addRole((UastChildRole.method()) node.id)
    }

    fn ownerMentions:boolean (r:UastFrontendResult owner:UNode role:string name:string) {
        def ids:[string] (owner.childIdsFor(role))
        def i:int 0
        while (i < (array_length ids)) {
            def id:string (itemAt ids i)
            if (r.mentionsNode(id)) {
                def n:UNode (r.nodeById(id))
                if (n.name == name) {
                    return true
                }
            }
            i = (i + 1)
        }
        return false
    }

    fn buildCall:UNode (r:UastFrontendResult ts:TSNode) {
        def callN:UNode (UNode.create((this.nextId("n:call:")) (UastKind.Call()) "typescript" "CallExpression"))
        callN.span = (this.spanOf(ts))
        r.addNode(callN)
        if (null? ts.left) {
        } {
            def callee:UNode (this.buildExpr(r (unwrap ts.left)))
            callN.addRole((UastChildRole.callee()) callee.id)
        }
        def ai:int 0
        while (ai < (array_length ts.children)) {
            def arg:UNode (this.buildExpr(r (itemAt ts.children ai)))
            callN.addRole((UastChildRole.argument()) arg.id)
            ai = (ai + 1)
        }
        return callN
    }

    fn buildNew:UNode (r:UastFrontendResult ts:TSNode) {
        def newN:UNode (UNode.create((this.nextId("n:new:")) (UastKind.New()) "typescript" "NewExpression"))
        newN.span = (this.spanOf(ts))
        r.addNode(newN)
        if (null? ts.left) {
        } {
            def callee:UNode (this.buildExpr(r (unwrap ts.left)))
            newN.addRole((UastChildRole.callee()) callee.id)
        }
        def ai:int 0
        while (ai < (array_length ts.children)) {
            def arg:UNode (this.buildExpr(r (itemAt ts.children ai)))
            newN.addRole((UastChildRole.argument()) arg.id)
            ai = (ai + 1)
        }
        return newN
    }

    fn walkJsx:void (r:UastFrontendResult owner:UNode ts:TSNode) {
        def tag:string ""
        if (null? ts.left) {
        } {
            def opening:TSNode (unwrap ts.left)
            tag = opening.name
            def ai:int 0
            while (ai < (array_length opening.children)) {
                def attr:TSNode (itemAt opening.children ai)
                if (null? attr.right) {
                } {
                    this.walkStmt(r owner (unwrap attr.right))
                }
                if (null? attr.left) {
                } {
                    this.walkStmt(r owner (unwrap attr.left))
                }
                ai = (ai + 1)
            }
        }
        if (UastTs.isComponentName(tag)) {
            def callN:UNode (this.buildJsxCall(r ts tag))
            owner.addRole((UastChildRole.element()) callN.id)
        }
        this.walkJsxChildren(r owner ts)
    }

    fn walkJsxChildren:void (r:UastFrontendResult owner:UNode ts:TSNode) {
        def i:int 0
        while (i < (array_length ts.children)) {
            this.walkStmt(r owner (itemAt ts.children i))
            i = (i + 1)
        }
    }

    fn buildJsxCall:UNode (r:UastFrontendResult ts:TSNode tag:string) {
        def callN:UNode (UNode.create((this.nextId("n:jsx:")) (UastKind.Call()) "typescript" "JSXElement"))
        callN.span = (this.spanOf(ts))
        callN.name = tag
        r.addNode(callN)
        def idn:UNode (UNode.create((this.nextId("n:id:")) (UastKind.Identifier()) "typescript" "JSXIdentifier"))
        idn.name = tag
        idn.span = (this.spanOf(ts))
        r.addNode(idn)
        callN.addRole((UastChildRole.callee()) idn.id)
        return callN
    }

    fn buildExpr:UNode (r:UastFrontendResult ts:TSNode) {
        if (ts.nodeType == "MemberExpression") {
            return (this.buildMember(r ts))
        }
        if (ts.nodeType == "CallExpression") {
            return (this.buildCall(r ts))
        }
        if (ts.nodeType == "NewExpression") {
            return (this.buildNew(r ts))
        }
        def idn:UNode (UNode.create((this.nextId("n:id:")) (UastKind.Identifier()) "typescript" ts.nodeType))
        idn.name = ts.name
        if ((strlen idn.name) == 0) {
            idn.name = ts.value
        }
        if (ts.nodeType == "ThisExpression") {
            idn.name = "this"
        }
        idn.span = (this.spanOf(ts))
        r.addNode(idn)
        return idn
    }

    fn buildMember:UNode (r:UastFrontendResult ts:TSNode) {
        def acc:UNode (UNode.create((this.nextId("n:mem:")) (UastKind.MemberAccess()) "typescript" "MemberExpression"))
        acc.span = (this.spanOf(ts))
        r.addNode(acc)
        if (null? ts.left) {
        } {
            def recv:UNode (this.buildExpr(r (unwrap ts.left)))
            acc.addRole((UastChildRole.receiver()) recv.id)
        }
        def mem:UNode (UNode.create((this.nextId("n:id:")) (UastKind.Identifier()) "typescript" "Identifier"))
        mem.name = ts.name
        r.addNode(mem)
        acc.addRole((UastChildRole.member()) mem.id)
        return acc
    }

    fn typeNameOf:string (ann@(optional):TSNode) {
        if (null? ann) {
            return ""
        }
        def t:TSNode (unwrap ann)
        if (t.nodeType == "TSTypeAnnotation") {
            if (null? t.typeAnnotation) {
                return ""
            }
            return (this.typeNameOf(t.typeAnnotation))
        }
        if (t.nodeType == "TSArrayType") {
            if (null? t.left) {
                return "[]"
            }
            return ("[" + (this.typeNameOf(t.left)) + "]")
        }
        if (t.nodeType == "TSTypeReference") {
            return t.name
        }
        if (t.nodeType == "TSStringKeyword") {
            return "string"
        }
        if (t.nodeType == "TSNumberKeyword") {
            return "number"
        }
        if (t.nodeType == "TSBooleanKeyword") {
            return "boolean"
        }
        if (t.nodeType == "TSVoidKeyword") {
            return "void"
        }
        if (t.nodeType == "TSAnyKeyword") {
            return "any"
        }
        if ((strlen t.name) > 0) {
            return t.name
        }
        return t.nodeType
    }

    fn mentionsClass:boolean (name:string) {
        def bare:string name
        if ((strlen name) >= 2) {
            if ((charAt name 0) == ((ccode "["))) {
                bare = (substring name 1 ((strlen name) - 1))
            }
        }
        def i:int 0
        while (i < (array_length classNames)) {
            if ((itemAt classNames i) == bare) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn commentsBefore:string (start:int) {
        def lastSig:int (0 - 1)
        def i:int 0
        while (i < (array_length tokens)) {
            def t:Token (itemAt tokens i)
            if (t.start >= start) {
                break
            }
            if ((t.tokenType == "LineComment") || (t.tokenType == "BlockComment")) {
            } {
                lastSig = i
            }
            i = (i + 1)
        }
        def parts:[string]
        def lastEnd:int 0
        if (lastSig >= 0) {
            def sig:Token (itemAt tokens lastSig)
            lastEnd = sig.end
        }
        def j:int (lastSig + 1)
        while (j < i) {
            def c:Token (itemAt tokens j)
            if ((c.tokenType == "LineComment") || (c.tokenType == "BlockComment")) {
                push parts (this.commentLine(c.value))
                lastEnd = c.end
            }
            j = (j + 1)
        }
        if ((array_length parts) == 0) {
            return ""
        }
        if (this.hasBlankLine(lastEnd start)) {
            return ""
        }
        return (join parts "\n")
    }

    fn hasBlankLine:boolean (fromPos:int toPos:int) {
        if (toPos <= fromPos) {
            return false
        }
        def gap:string (substring source fromPos toPos)
        def nls:int 0
        def k:int 0
        while (k < (strlen gap)) {
            if ((charAt gap k) == 10) {
                nls = (nls + 1)
            }
            k = (k + 1)
        }
        if (nls >= 2) {
            return true
        }
        return false
    }

    fn commentLine:string (raw:string) {
        def s:string raw
        while ((strlen s) > 0) {
            def ch:int (charAt s 0)
            if ((ch == 32) || (ch == 9) || (ch == 42)) {
                s = (substring s 1 (strlen s))
            } {
                break
            }
        }
        return s
    }

    fn spanOf:UastSpan (ts:TSNode) {
        return (UastSpan.ofBytes(fileName ts.start ts.end ts.line ts.col))
    }

    fn nextId:string (prefix:string) {
        seq = (seq + 1)
        return (((prefix + (this.fileKey())) + ":") + (to_string seq))
    }
}

; ============================================================================
; UastCpp.rgr — C++17 parser → FrontendResult.
; ============================================================================
;
; The only UAST file that imports gallery/cpp_parser. Does not import the
; Ranger compiler and does not run clang. Quoted #include paths resolve
; against files already in the workspace; <system> headers stay diagnostics.
; ============================================================================

Import "UastFrontend.rgr"
Import "UastSemantic.rgr"
Import "UastKind.rgr"
Import "../../cpp_parser/cpp_parser.rgr"
Import "../../../lib/ranger-dir.rgr"

class UastCpp {
    def fileName:string ""
    def source:string ""
    def tokens:[CppToken]
    def seq:int 0
    def classNames:[string]

    Constructor () {
    }

    sfn fromSource:UastCodeModel (source:string fileName:string) {
        def b (new UastCpp)
        return (UastSemantic.fromResult((b.parse(source fileName))))
    }

    sfn parseSource:UastFrontendResult (source:string fileName:string) {
        def b (new UastCpp)
        return (b.parse(source fileName))
    }

    sfn parseFile:UastFrontendResult (path:string) {
        def text@(optional):string (UastCpp.readSource(path))
        if (null? text) {
            def empty (new UastFrontendResult)
            empty.title = (path + " FAIL missing file")
            empty.language = "cpp"
            empty.addDiagnostic((UastDiagnostic.create(("could not read " + path) "error")))
            return empty
        }
        return (UastCpp.parseSource((unwrap text) path))
    }

    sfn fromFile:UastCodeModel (path:string) {
        def ws (new UastWorkspace)
        ws.addResult((UastCpp.parseFile(path)))
        def m:UastCodeModel (UastSemantic.fromWorkspace(ws))
        m.title = path
        return m
    }

    sfn fromPath:UastCodeModel (path:string) {
        def base:string (UastCpp.pathBase(path))
        if (UastCpp.isCppFile(base)) {
            return (UastCpp.fromFile(path))
        }
        return (UastCpp.fromDir(path))
    }

    sfn fromDir:UastCodeModel (root:string) {
        def ws (new UastWorkspace)
        def files:[string]
        UastCpp.collectCppFiles(root files 0)
        def i:int 0
        while (i < (array_length files)) {
            def path:string (itemAt files i)
            ws.addResult((UastCpp.parseFile(path)))
            i = (i + 1)
        }
        def m:UastCodeModel (UastSemantic.fromWorkspace(ws))
        m.title = root
        m.language = "cpp"
        if ((array_length files) == 0) {
            m.addDiagnostic((UastDiagnostic.create(("no C++ files under " + root) "error")))
        }
        return m
    }

    sfn looksLikeCpp:boolean (path:string) {
        def base:string (UastCpp.pathBase(path))
        if (UastCpp.isCppFile(base)) {
            return true
        }
        if (UastCpp.isTsFile(base)) {
            return false
        }
        if (dir_exists path) {
            if (UastCpp.hasCppFiles(path 0)) {
                if (UastCpp.hasTsFiles(path 0)) {
                    return false
                }
                return true
            }
        }
        return false
    }

    sfn isTsFile:boolean (name:string) {
        def n:int (strlen name)
        if (n >= 5) {
            if ((substring name (n - 5) n) == ".d.ts") {
                return false
            }
        }
        if (n >= 4) {
            if ((substring name (n - 4) n) == ".tsx") {
                return true
            }
        }
        if (n >= 3) {
            if ((substring name (n - 3) n) == ".ts") {
                return true
            }
        }
        return false
    }

    sfn hasTsFiles:boolean (dir:string depth:int) {
        if (depth > 6) {
            return false
        }
        if ((dir_exists dir) == false) {
            return false
        }
        def names:[string] (list_dir_files dir)
        def i:int 0
        while (i < (array_length names)) {
            def name:string (itemAt names i)
            if (UastCpp.skipDirName(name)) {
            } {
                if (UastCpp.isTsFile(name)) {
                    return true
                }
                def joined:string ((dir + "/") + name)
                if (UastCpp.looksLikeFile(name)) {
                } {
                    if (dir_exists joined) {
                        if (UastCpp.hasTsFiles(joined (depth + 1))) {
                            return true
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return false
    }

    sfn hasCppFiles:boolean (dir:string depth:int) {
        if (depth > 6) {
            return false
        }
        if ((dir_exists dir) == false) {
            return false
        }
        def names:[string] (list_dir_files dir)
        def i:int 0
        while (i < (array_length names)) {
            def name:string (itemAt names i)
            if (UastCpp.skipDirName(name)) {
            } {
                if (UastCpp.isCppFile(name)) {
                    return true
                }
                def joined:string ((dir + "/") + name)
                if (UastCpp.looksLikeFile(name)) {
                } {
                    if (dir_exists joined) {
                        if (UastCpp.hasCppFiles(joined (depth + 1))) {
                            return true
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return false
    }

    sfn collectCppFiles:void (dir:string out:[string] depth:int) {
        if (depth > 12) {
            return
        }
        if ((dir_exists dir) == false) {
            return
        }
        def names:[string] (list_dir_files dir)
        def i:int 0
        while (i < (array_length names)) {
            def name:string (itemAt names i)
            if (UastCpp.skipDirName(name)) {
            } {
                def joined:string ((dir + "/") + name)
                if (UastCpp.isCppFile(name)) {
                    push out joined
                } {
                    if (UastCpp.looksLikeFile(name)) {
                    } {
                        if (dir_exists joined) {
                            UastCpp.collectCppFiles(joined out (depth + 1))
                        }
                    }
                }
            }
            i = (i + 1)
        }
    }

    sfn skipDirName:boolean (name:string) {
        if (name == "node_modules") { return true }
        if (name == "dist") { return true }
        if (name == "build") { return true }
        if (name == "out") { return true }
        if (name == "target") { return true }
        if (name == "CMakeFiles") { return true }
        if (name == "cmake-build-debug") { return true }
        if (name == "cmake-build-release") { return true }
        if (name == "vcpkg_installed") { return true }
        if (name == "coverage") { return true }
        if ((strlen name) > 0) {
            if ((charAt name 0) == ((ccode "."))) {
                return true
            }
        }
        return false
    }

    sfn isCppFile:boolean (name:string) {
        def n:int (strlen name)
        if (n >= 4) {
            def t4:string (substring name (n - 4) n)
            if ((t4 == ".cpp") || ((t4 == ".cxx") || ((t4 == ".hpp") || ((t4 == ".hxx") || (t4 == ".ipp"))))) {
                return true
            }
        }
        if (n >= 3) {
            def t3:string (substring name (n - 3) n)
            if ((t3 == ".cc") || (t3 == ".hh")) {
                return true
            }
        }
        if (n >= 2) {
            if ((substring name (n - 2) n) == ".h") {
                return true
            }
        }
        if (n >= 4) {
            def t4b:string (substring name (n - 4) n)
            if ((t4b == ".c++") || (t4b == ".h++")) {
                return true
            }
        }
        return false
    }

    sfn looksLikeFile:boolean (name:string) {
        def i:int 1
        while (i < (strlen name)) {
            if ((charAt name i) == ((ccode "."))) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn pathBase:string (path:string) {
        def slash:int (0 - 1)
        def i:int 0
        while (i < (strlen path)) {
            if ((charAt path i) == ((ccode "/"))) {
                slash = i
            }
            i = (i + 1)
        }
        if (slash < 0) {
            return path
        }
        return (substring path (slash + 1) (strlen path))
    }

    sfn readSource@(optional):string (path:string) {
        def cut:int (0 - 1)
        def i:int 0
        while (i < (strlen path)) {
            if ((charAt path i) == ((ccode "/"))) {
                cut = i
            }
            i = (i + 1)
        }
        def dir:string "."
        def name:string path
        if (cut >= 0) {
            dir = (substring path 0 cut)
            name = (substring path (cut + 1) (strlen path))
        }
        def text@(optional):string (read_file dir name)
        return text
    }

    fn parse:UastFrontendResult (src:string path:string) {
        source = src
        fileName = path
        def r (new UastFrontendResult)
        r.title = path
        r.language = "cpp"
        def file:UastSourceFile (r.addFile(path "cpp"))
        file.version = 1
        def lexer:CppLexer (new CppLexer(src))
        tokens = (lexer.tokenize())
        def parser (new CppParser)
        parser.initParser(tokens)
        parser.setQuiet(true)
        def program:CppNode (parser.parseProgram())
        if (parser.errorCount > 0) {
            def msg:string parser.firstErrorText
            if (parser.firstErrorLine >= 0) {
                msg = (((msg + " at ") + fileName) + ":") + (to_string parser.firstErrorLine)
            }
            r.addDiagnostic((UastDiagnostic.create(msg "error")))
        }
        this.collectClassNames(program)
        this.walkStmtList(r program.children)
        return r
    }

    fn fileKey:string () {
        def base:string (UastCpp.pathBase(fileName))
        def stem:string base
        def dot:int (0 - 1)
        def j:int 0
        while (j < (strlen base)) {
            if ((charAt base j) == ((ccode "."))) {
                if (dot < 0) {
                    dot = j
                }
            }
            j = (j + 1)
        }
        if (dot > 0) {
            stem = (substring base 0 dot)
        }
        def parent:string (UastSemantic.baseName((UastSemantic.dirOf(fileName))))
        if ((strlen parent) == 0) {
            return stem
        }
        return ((parent + "_") + stem)
    }

    fn collectClassNames:void (program:CppNode) {
        def i:int 0
        while (i < (array_length program.children)) {
            def st:CppNode (itemAt program.children i)
            this.noteTypeName(st)
            if ((st.nodeType == "NamespaceDeclaration") || (st.nodeType == "ExternBlock")) {
                this.collectClassNames(st)
            }
            i = (i + 1)
        }
    }

    fn noteTypeName:void (st:CppNode) {
        if ((st.nodeType == "ClassDeclaration") || (st.nodeType == "EnumDeclaration")) {
            if ((strlen st.name) > 0) {
                push classNames st.name
            }
        }
        def i:int 0
        while (i < (array_length st.children)) {
            this.noteTypeName((itemAt st.children i))
            i = (i + 1)
        }
        if (null? st.body) {
        } {
            this.noteTypeName((unwrap st.body))
        }
    }

    fn walkStmtList:void (r:UastFrontendResult stmts:[CppNode]) {
        def i:int 0
        while (i < (array_length stmts)) {
            this.walkTop(r (itemAt stmts i))
            i = (i + 1)
        }
    }

    fn walkTop:void (r:UastFrontendResult st:CppNode) {
        if (st.nodeType == "ClassDeclaration") {
            this.addClass(r st)
        }
        if (st.nodeType == "EnumDeclaration") {
            this.addEnum(r st)
        }
        if (st.nodeType == "FunctionDeclaration") {
            this.addFunction(r st)
        }
        if (st.nodeType == "TypeAlias") {
            this.addTypeAlias(r st)
        }
        if (st.nodeType == "IncludeDeclaration") {
            this.addInclude(r st)
        }
        if ((st.nodeType == "NamespaceDeclaration") || (st.nodeType == "ExternBlock")) {
            this.walkStmtList(r st.children)
        }
        if (st.nodeType == "VariableDeclaration") {
            this.addVar(r st)
        }
    }

    fn addClass:UNode (r:UastFrontendResult ts:CppNode) {
        def node:UNode (UNode.create((this.nextId("n:class:")) (UastKind.ClassDecl()) "cpp" ts.nodeType))
        node.name = ts.name
        node.span = (this.spanOf(ts))
        node.origin = (UastOrigin.create("cpp" fileName ts.name 1))
        node.comment = (this.commentsBefore(ts.start))
        r.addNode(node)
        this.addHeritage(r node ts)
        if (null? ts.body) {
            return node
        }
        def body:CppNode (unwrap ts.body)
        def mi:int 0
        while (mi < (array_length body.children)) {
            def mem:CppNode (itemAt body.children mi)
            if (mem.nodeType == "PropertyDefinition") {
                this.addField(r node mem)
            }
            if (mem.nodeType == "MethodDefinition") {
                this.addMethod(r node mem)
            }
            if (mem.nodeType == "FunctionDeclaration") {
                this.addMethod(r node mem)
            }
            if (mem.nodeType == "ClassDeclaration") {
                this.addClass(r mem)
            }
            mi = (mi + 1)
        }
        return node
    }

    fn addEnum:UNode (r:UastFrontendResult ts:CppNode) {
        def node:UNode (UNode.create((this.nextId("n:enum:")) (UastKind.EnumDecl()) "cpp" ts.nodeType))
        node.name = ts.name
        node.span = (this.spanOf(ts))
        node.origin = (UastOrigin.create("cpp" fileName ts.name 1))
        r.addNode(node)
        return node
    }

    fn addTypeAlias:UNode (r:UastFrontendResult ts:CppNode) {
        def node:UNode (UNode.create((this.nextId("n:type:")) (UastKind.TypeDecl()) "cpp" ts.nodeType))
        node.name = ts.name
        node.span = (this.spanOf(ts))
        node.origin = (UastOrigin.create("cpp" fileName ts.name 1))
        r.addNode(node)
        def tn:UNode (UNode.create((this.nextId("n:alias:")) (UastKind.TypeRef()) "cpp" "type"))
        tn.name = (this.typeNameOf(ts.typeAnnotation))
        r.addNode(tn)
        node.addRole((UastChildRole.typeRole()) tn.id)
        return node
    }

    fn addInclude:void (r:UastFrontendResult ts:CppNode) {
        def node:UNode (UNode.create((this.nextId("n:import:")) (UastKind.Import()) "cpp" ts.nodeType))
        node.span = (this.spanOf(ts))
        node.name = ts.name
        r.addNode(node)
    }

    fn addVar:void (r:UastFrontendResult ts:CppNode) {
        if ((strlen ts.name) == 0) {
            return
        }
        def node:UNode (UNode.create((this.nextId("n:var:")) (UastKind.VariableDecl()) "cpp" ts.nodeType))
        node.name = ts.name
        node.span = (this.spanOf(ts))
        r.addNode(node)
        def tn:UNode (UNode.create((this.nextId("n:type:")) (UastKind.TypeRef()) "cpp" "type"))
        tn.name = (this.typeNameOf(ts.typeAnnotation))
        r.addNode(tn)
        node.addRole((UastChildRole.typeRole()) tn.id)
    }

    fn addHeritage:void (r:UastFrontendResult node:UNode ts:CppNode) {
        if (null? ts.left) {
            return
        }
        def base:CppNode (unwrap ts.left)
        def superName:string base.name
        if ((strlen superName) == 0) {
            return
        }
        def src:string (UastHintSource.frontendInferred())
        r.addHint((UastSemanticHint.create(node.id (UastRelKind.extendsRel()) superName src (UastResolution.resolved()) (UastConfidence.inferred()))))
    }

    fn addFunction:UNode (r:UastFrontendResult ts:CppNode) {
        return (this.addNamedFn(r ts ts.name))
    }

    fn addNamedFn:UNode (r:UastFrontendResult ts:CppNode name:string) {
        def node:UNode (UNode.create((this.nextId("n:fn:")) (UastKind.FunctionDecl()) "cpp" ts.nodeType))
        node.name = name
        node.span = (this.spanOf(ts))
        node.origin = (UastOrigin.create("cpp" fileName node.name 1))
        node.comment = (this.commentsBefore(ts.start))
        r.addNode(node)
        def ret:UNode (UNode.create((this.nextId("n:ret:")) (UastKind.TypeRef()) "cpp" "type"))
        ret.name = (this.typeNameOf(ts.typeAnnotation))
        r.addNode(ret)
        node.addRole((UastChildRole.returnType()) ret.id)
        this.addParams(r node ts)
        if (null? ts.body) {
            return node
        }
        def bodyTs:CppNode (unwrap ts.body)
        def block:UNode (UNode.create((this.nextId("n:body:")) (UastKind.Block()) "cpp" "BlockStatement"))
        r.addNode(block)
        node.addRole((UastChildRole.body()) block.id)
        this.walkStmt(r block bodyTs)
        return node
    }

    fn addParams:void (r:UastFrontendResult node:UNode ts:CppNode) {
        def pi:int 0
        while (pi < (array_length ts.params)) {
            def p:CppNode (itemAt ts.params pi)
            def pn:UNode (UNode.create((this.nextId("n:p:")) (UastKind.Parameter()) "cpp" "param"))
            pn.name = p.name
            r.addNode(pn)
            def pt:UNode (UNode.create((this.nextId("n:pt:")) (UastKind.TypeRef()) "cpp" "type"))
            pt.name = (this.typeNameOf(p.typeAnnotation))
            r.addNode(pt)
            pn.addRole((UastChildRole.typeRole()) pt.id)
            node.addRole((UastChildRole.parameter()) pn.id)
            pi = (pi + 1)
        }
    }

    fn addField:void (r:UastFrontendResult owner:UNode ts:CppNode) {
        def node:UNode (UNode.create((this.nextId("n:field:")) (UastKind.FieldDecl()) "cpp" ts.nodeType))
        node.name = ts.name
        node.span = (this.spanOf(ts))
        node.comment = (this.commentsBefore(ts.start))
        if (ts.kind == "static") {
            node.addFlag("static")
        }
        r.addNode(node)
        def tn:UNode (UNode.create((this.nextId("n:type:")) (UastKind.TypeRef()) "cpp" "type"))
        tn.name = (this.typeNameOf(ts.typeAnnotation))
        r.addNode(tn)
        node.addRole((UastChildRole.typeRole()) tn.id)
        owner.addRole((UastChildRole.field()) node.id)
        def used:string (this.innerTypeName(tn.name))
        if (this.mentionsClass(used)) {
            def src:string (UastHintSource.frontendInferred())
            r.addHint((UastSemanticHint.create(owner.id (UastRelKind.usesType()) used src (UastResolution.resolved()) (UastConfidence.inferred()))))
        }
        if (this.mentionsClass(tn.name)) {
            def src2:string (UastHintSource.frontendInferred())
            r.addHint((UastSemanticHint.create(owner.id (UastRelKind.usesType()) tn.name src2 (UastResolution.resolved()) (UastConfidence.inferred()))))
        }
    }

    fn addMethod:void (r:UastFrontendResult owner:UNode ts:CppNode) {
        if ((strlen ts.name) == 0) {
            return
        }
        if (ts.name == "constructor") {
            return
        }
        if ((strlen ts.name) > 0) {
            if ((charAt ts.name 0) == 126) {
                return
            }
        }
        def node:UNode (UNode.create((this.nextId("n:method:")) (UastKind.MethodDecl()) "cpp" ts.nodeType))
        node.name = ts.name
        node.span = (this.spanOf(ts))
        node.comment = (this.commentsBefore(ts.start))
        r.addNode(node)
        def ret:UNode (UNode.create((this.nextId("n:ret:")) (UastKind.TypeRef()) "cpp" "type"))
        ret.name = (this.typeNameOf(ts.typeAnnotation))
        r.addNode(ret)
        node.addRole((UastChildRole.returnType()) ret.id)
        this.addParams(r node ts)
        owner.addRole((UastChildRole.method()) node.id)
        if (null? ts.body) {
            return
        }
        def bodyTs:CppNode (unwrap ts.body)
        def block:UNode (UNode.create((this.nextId("n:body:")) (UastKind.Block()) "cpp" "BlockStatement"))
        r.addNode(block)
        node.addRole((UastChildRole.body()) block.id)
        this.walkStmt(r block bodyTs)
    }

    fn walkStmt:void (r:UastFrontendResult owner:UNode ts:CppNode) {
        if (ts.nodeType == "CallExpression") {
            def callN:UNode (this.buildCall(r ts))
            owner.addRole((UastChildRole.element()) callN.id)
            return
        }
        if (ts.nodeType == "NewExpression") {
            def newN:UNode (this.buildNew(r ts))
            owner.addRole((UastChildRole.element()) newN.id)
            return
        }
        if (ts.nodeType == "ExpressionStatement") {
            if (null? ts.left) {
                return
            }
            this.walkStmt(r owner (unwrap ts.left))
            return
        }
        if (ts.nodeType == "BlockStatement") {
            def i:int 0
            while (i < (array_length ts.children)) {
                this.walkStmt(r owner (itemAt ts.children i))
                i = (i + 1)
            }
            return
        }
        if (null? ts.left) {
        } {
            this.walkStmt(r owner (unwrap ts.left))
        }
        if (null? ts.right) {
        } {
            this.walkStmt(r owner (unwrap ts.right))
        }
        if (null? ts.body) {
        } {
            this.walkStmt(r owner (unwrap ts.body))
        }
        def ci:int 0
        while (ci < (array_length ts.children)) {
            this.walkStmt(r owner (itemAt ts.children ci))
            ci = (ci + 1)
        }
    }

    fn buildCall:UNode (r:UastFrontendResult ts:CppNode) {
        def callN:UNode (UNode.create((this.nextId("n:call:")) (UastKind.Call()) "cpp" "CallExpression"))
        callN.span = (this.spanOf(ts))
        r.addNode(callN)
        if (null? ts.left) {
        } {
            def callee:UNode (this.buildExpr(r (unwrap ts.left)))
            callN.addRole((UastChildRole.callee()) callee.id)
        }
        def ai:int 0
        while (ai < (array_length ts.children)) {
            def arg:UNode (this.buildExpr(r (itemAt ts.children ai)))
            callN.addRole((UastChildRole.argument()) arg.id)
            ai = (ai + 1)
        }
        return callN
    }

    fn buildNew:UNode (r:UastFrontendResult ts:CppNode) {
        def newN:UNode (UNode.create((this.nextId("n:new:")) (UastKind.New()) "cpp" "NewExpression"))
        newN.span = (this.spanOf(ts))
        r.addNode(newN)
        if (null? ts.left) {
        } {
            def callee:UNode (this.buildExpr(r (unwrap ts.left)))
            newN.addRole((UastChildRole.callee()) callee.id)
        }
        return newN
    }

    fn buildExpr:UNode (r:UastFrontendResult ts:CppNode) {
        if (ts.nodeType == "CallExpression") {
            return (this.buildCall(r ts))
        }
        if (ts.nodeType == "NewExpression") {
            return (this.buildNew(r ts))
        }
        if (ts.nodeType == "MemberExpression") {
            return (this.buildMember(r ts))
        }
        if ((ts.nodeType == "Identifier") || (ts.nodeType == "ThisExpression")) {
            def idn:UNode (UNode.create((this.nextId("n:id:")) (UastKind.Identifier()) "cpp" ts.nodeType))
            idn.name = ts.name
            if ((strlen idn.name) == 0) {
                idn.name = ts.value
            }
            idn.span = (this.spanOf(ts))
            r.addNode(idn)
            return idn
        }
        if (ts.nodeType == "Literal") {
            def lit:UNode (UNode.create((this.nextId("n:lit:")) (UastKind.Literal()) "cpp" ts.nodeType))
            lit.name = ts.value
            lit.span = (this.spanOf(ts))
            r.addNode(lit)
            return lit
        }
        def wrap:UNode (UNode.create((this.nextId("n:x:")) (UastKind.LanguageSpecific()) "cpp" ts.nodeType))
        wrap.span = (this.spanOf(ts))
        r.addNode(wrap)
        if (null? ts.left) {
        } {
            def l:UNode (this.buildExpr(r (unwrap ts.left)))
            wrap.addRole((UastChildRole.element()) l.id)
        }
        if (null? ts.right) {
        } {
            def ri:UNode (this.buildExpr(r (unwrap ts.right)))
            wrap.addRole((UastChildRole.element()) ri.id)
        }
        return wrap
    }

    fn buildMember:UNode (r:UastFrontendResult ts:CppNode) {
        def acc:UNode (UNode.create((this.nextId("n:mem:")) (UastKind.MemberAccess()) "cpp" "MemberExpression"))
        acc.span = (this.spanOf(ts))
        r.addNode(acc)
        if (null? ts.left) {
        } {
            def recv:UNode (this.buildExpr(r (unwrap ts.left)))
            acc.addRole((UastChildRole.receiver()) recv.id)
        }
        def mem:UNode (UNode.create((this.nextId("n:id:")) (UastKind.Identifier()) "cpp" "Identifier"))
        mem.name = ts.name
        r.addNode(mem)
        acc.addRole((UastChildRole.member()) mem.id)
        return acc
    }

    fn typeNameOf:string (ann@(optional):CppNode) {
        if (null? ann) {
            return ""
        }
        def t:CppNode (unwrap ann)
        if ((strlen t.name) > 0) {
            return t.name
        }
        return t.value
    }

    fn innerTypeName:string (name:string) {
        def lt:int (indexOf name "<")
        def gt:int (indexOf name ">")
        if ((lt >= 0) && (gt > lt)) {
            return (substring name (lt + 1) gt)
        }
        return name
    }

    fn mentionsClass:boolean (name:string) {
        def i:int 0
        while (i < (array_length classNames)) {
            if ((itemAt classNames i) == name) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn commentsBefore:string (start:int) {
        def lastSig:int (0 - 1)
        def i:int 0
        while (i < (array_length tokens)) {
            def t:CppToken (itemAt tokens i)
            if (t.start >= start) {
                break
            }
            if ((t.tokenType == "LineComment") || (t.tokenType == "BlockComment")) {
            } {
                lastSig = i
            }
            i = (i + 1)
        }
        def parts:[string]
        def lastEnd:int 0
        if (lastSig >= 0) {
            def sig:CppToken (itemAt tokens lastSig)
            lastEnd = sig.end
        }
        def j:int (lastSig + 1)
        while (j < i) {
            def c:CppToken (itemAt tokens j)
            if ((c.tokenType == "LineComment") || (c.tokenType == "BlockComment")) {
                push parts (this.commentLine(c.value))
                lastEnd = c.end
            }
            j = (j + 1)
        }
        if ((array_length parts) == 0) {
            return ""
        }
        if (this.hasBlankLine(lastEnd start)) {
            return ""
        }
        return (join parts "\n")
    }

    fn hasBlankLine:boolean (fromPos:int toPos:int) {
        if (toPos <= fromPos) {
            return false
        }
        def gap:string (substring source fromPos toPos)
        def nls:int 0
        def k:int 0
        while (k < (strlen gap)) {
            if ((charAt gap k) == 10) {
                nls = (nls + 1)
            }
            k = (k + 1)
        }
        if (nls >= 2) {
            return true
        }
        return false
    }

    fn commentLine:string (raw:string) {
        def s:string raw
        while ((strlen s) > 0) {
            def ch:int (charAt s 0)
            if ((ch == 32) || ((ch == 9) || (ch == 42))) {
                s = (substring s 1 (strlen s))
            } {
                break
            }
        }
        return s
    }

    fn spanOf:UastSpan (ts:CppNode) {
        return (UastSpan.ofBytes(fileName ts.start ts.end ts.line ts.col))
    }

    fn nextId:string (prefix:string) {
        seq = (seq + 1)
        return (((prefix + (this.fileKey())) + ":") + (to_string seq))
    }
}

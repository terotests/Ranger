; ============================================================================
; UastSemantic.rgr — shared pipeline: FrontendResult → CodeModel.
; ============================================================================
;
; 1. copy UAST
; 2. index declarations (class / field / method / parameter / module / export)
; 3. contains from child roles
; 4. apply semanticHints
; 5. resolve Import / Identifier / TypeRef / MemberAccess
; 6. resolve Call → calls (M6): exact only when the unique method is known
;
; Exact only when the target resolves to one unique symbol. Member names
; resolve on the typed receiver’s class, not a global unique name. Imports
; resolve only against files already in the workspace — no package manager.
; Unresolved Import is a diagnostic, not a crash. This file must not import
; the Ranger compiler.
; ============================================================================

Import "UastModel.rgr"
Import "UastFrontend.rgr"
Import "UastKind.rgr"

class UastSemantic {
    Constructor () {
    }

    sfn fromResult:UastCodeModel (result:UastFrontendResult) {
        def m (new UastCodeModel)
        m.title = result.title
        m.language = result.language
        def fi:int 0
        while (fi < (array_length result.files)) {
            def f:UastSourceFile (itemAt result.files fi)
            push m.files f
            fi = (fi + 1)
        }
        def ni:int 0
        while (ni < (array_length result.nodes)) {
            def node:UNode (itemAt result.nodes ni)
            m.addNode(node)
            ni = (ni + 1)
        }
        def di:int 0
        while (di < (array_length result.diagnostics)) {
            def d:UastDiagnostic (itemAt result.diagnostics di)
            m.addDiagnostic(d)
            di = (di + 1)
        }
        UastSemantic.indexDeclarations(m)
        UastSemantic.applyContains(m)
        UastSemantic.applyHints(m result)
        UastSemantic.resolveRefs(m)
        return m
    }

    sfn fromWorkspace:UastCodeModel (ws:UastWorkspace) {
        def combined (new UastFrontendResult)
        combined.title = "workspace"
        def i:int 0
        while (i < (array_length ws.results)) {
            def r:UastFrontendResult (itemAt ws.results i)
            if ((strlen combined.language) == 0) {
                combined.language = r.language
            }
            def fi:int 0
            while (fi < (array_length r.files)) {
                push combined.files (itemAt r.files fi)
                fi = (fi + 1)
            }
            def ni:int 0
            while (ni < (array_length r.nodes)) {
                combined.addNode((itemAt r.nodes ni))
                ni = (ni + 1)
            }
            def hi:int 0
            while (hi < (array_length r.hints)) {
                combined.addHint((itemAt r.hints hi))
                hi = (hi + 1)
            }
            def di:int 0
            while (di < (array_length r.diagnostics)) {
                combined.addDiagnostic((itemAt r.diagnostics di))
                di = (di + 1)
            }
            i = (i + 1)
        }
        return (UastSemantic.fromResult(combined))
    }

    sfn indexDeclarations:void (m:UastCodeModel) {
        UastSemantic.indexModules(m)
        def i:int 0
        while (i < (array_length m.nodes)) {
            def node:UNode (itemAt m.nodes i)
            if (node.kind == "ClassDecl") {
                UastSemantic.addTypeSymbol(m node (UastSymKind.classSym()))
            }
            if (node.kind == "InterfaceDecl") {
                UastSemantic.addTypeSymbol(m node (UastSymKind.interfaceSym()))
            }
            if (node.kind == "FunctionDecl") {
                UastSemantic.addFnSymbol(m node)
            }
            if (node.kind == "TypeDecl") {
                UastSemantic.addTypeSymbol(m node (UastSymKind.typeSym()))
            }
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length m.nodes)) {
            def owner:UNode (itemAt m.nodes j)
            def isType:boolean false
            if (owner.kind == "ClassDecl") {
                isType = true
            }
            if (owner.kind == "InterfaceDecl") {
                isType = true
            }
            if isType {
                def ownerId:string (m.symbolDeclaredAt(owner.id))
                def fields:[string] (owner.childIdsFor((UastChildRole.field())))
                def fi:int 0
                while (fi < (array_length fields)) {
                    def fid:string (itemAt fields fi)
                    if (m.mentionsNode(fid)) {
                        UastSemantic.addMember(m (m.nodeById(fid)) ownerId owner.name (UastSymKind.field()) "field:")
                    }
                    fi = (fi + 1)
                }
                def methods:[string] (owner.childIdsFor((UastChildRole.method())))
                def mi:int 0
                while (mi < (array_length methods)) {
                    def mid:string (itemAt methods mi)
                    if (m.mentionsNode(mid)) {
                        UastSemantic.addMember(m (m.nodeById(mid)) ownerId owner.name (UastSymKind.method()) "method:")
                    }
                    mi = (mi + 1)
                }
            }
            j = (j + 1)
        }
        UastSemantic.indexParams(m)
        UastSemantic.indexVariables(m)
        UastSemantic.indexExports(m)
    }

    sfn indexParams:void (m:UastCodeModel) {
        def i:int 0
        while (i < (array_length m.nodes)) {
            def node:UNode (itemAt m.nodes i)
            def isFn:boolean false
            if (node.kind == "MethodDecl") {
                isFn = true
            }
            if (node.kind == "FunctionDecl") {
                isFn = true
            }
            if isFn {
                def ownerId:string (m.symbolDeclaredAt(node.id))
                if ((strlen ownerId) > 0) {
                    def ownerKey:string (UastSemantic.memberKey(ownerId))
                    def params:[string] (node.childIdsFor((UastChildRole.parameter())))
                    def pi:int 0
                    while (pi < (array_length params)) {
                        def pid:string (itemAt params pi)
                        if (m.mentionsNode(pid)) {
                            UastSemantic.addParam(m (m.nodeById(pid)) ownerId ownerKey)
                        }
                        pi = (pi + 1)
                    }
                }
            }
            i = (i + 1)
        }
    }

    sfn memberKey:string (symId:string) {
        if ((indexOf symId "method:") == 0) {
            return (substring symId 7)
        }
        if ((indexOf symId "function:") == 0) {
            return (substring symId 9)
        }
        return symId
    }

    sfn addTypeSymbol:void (m:UastCodeModel node:UNode kind:string) {
        def id:string ("class:" + node.name)
        id = (UastSemantic.uniquifyId(m id))
        def s:UastSymbol (UastSymbol.create(id node.name kind node.language))
        s.declarationNode = node.id
        s.fileName = node.span.fileId
        s.comment = node.comment
        m.addSymbol(s)
    }

    sfn addFnSymbol:void (m:UastCodeModel node:UNode) {
        def nm:string node.name
        if ((strlen nm) == 0) {
            nm = "default"
        }
        def id:string ("function:" + nm)
        id = (UastSemantic.uniquifyId(m id))
        def s:UastSymbol (UastSymbol.create(id nm (UastSymKind.functionSym()) node.language))
        s.declarationNode = node.id
        s.fileName = node.span.fileId
        s.comment = node.comment
        def retId:string (node.childIdFor((UastChildRole.returnType())))
        if ((strlen retId) > 0) {
            if (m.mentionsNode(retId)) {
                def rn:UNode (m.nodeById(retId))
                s.returns = rn.name
            }
        }
        m.addSymbol(s)
    }

    sfn uniquifyId:string (m:UastCodeModel id:string) {
        if ((m.mentionsSymbol(id)) == false) {
            return id
        }
        def n:int 2
        def cand:string ((id + "#") + (to_string n))
        while (m.mentionsSymbol(cand)) {
            n = (n + 1)
            cand = ((id + "#") + (to_string n))
        }
        return cand
    }

    sfn addMember:void (m:UastCodeModel node:UNode ownerId:string ownerName:string kind:string prefix:string) {
        def id:string ((prefix + ownerName) + "." + node.name)
        if (m.mentionsSymbol(id)) {
            def n:int 2
            def cand:string ((id + "#") + (to_string n))
            while (m.mentionsSymbol(cand)) {
                n = (n + 1)
                cand = ((id + "#") + (to_string n))
            }
            id = cand
        }
        def s:UastSymbol (UastSymbol.create(id node.name kind node.language))
        s.declarationNode = node.id
        s.parentSymbol = ownerId
        s.fileName = node.span.fileId
        s.comment = node.comment
        s.isStatic = (node.mentionsFlag("static"))
        def typeId:string (node.childIdFor((UastChildRole.typeRole())))
        if ((strlen typeId) > 0) {
            if (m.mentionsNode(typeId)) {
                def tn:UNode (m.nodeById(typeId))
                s.typeName = tn.name
            }
        }
        def retId:string (node.childIdFor((UastChildRole.returnType())))
        if ((strlen retId) > 0) {
            if (m.mentionsNode(retId)) {
                def rn:UNode (m.nodeById(retId))
                s.returns = rn.name
            }
        }
        def params:[string] (node.childIdsFor((UastChildRole.parameter())))
        def parts:[string]
        def pi:int 0
        while (pi < (array_length params)) {
            def pid:string (itemAt params pi)
            if (m.mentionsNode(pid)) {
                def pn:UNode (m.nodeById(pid))
                def pt:string ""
                def ptype:string (pn.childIdFor((UastChildRole.typeRole())))
                if ((strlen ptype) > 0) {
                    if (m.mentionsNode(ptype)) {
                        def ptn:UNode (m.nodeById(ptype))
                        pt = ptn.name
                    }
                }
                if ((strlen pt) > 0) {
                    push parts (pn.name + ":" + pt)
                } {
                    push parts pn.name
                }
            }
            pi = (pi + 1)
        }
        s.params = (join parts ", ")
        m.addSymbol(s)
    }

    sfn addParam:void (m:UastCodeModel node:UNode ownerId:string ownerKey:string) {
        def id:string ((("param:" + ownerKey) + ".") + node.name)
        if (m.mentionsSymbol(id)) {
            def n:int 2
            def cand:string ((id + "#") + (to_string n))
            while (m.mentionsSymbol(cand)) {
                n = (n + 1)
                cand = ((id + "#") + (to_string n))
            }
            id = cand
        }
        def s:UastSymbol (UastSymbol.create(id node.name (UastSymKind.parameter()) node.language))
        s.declarationNode = node.id
        s.parentSymbol = ownerId
        s.fileName = node.span.fileId
        s.comment = node.comment
        def typeId:string (node.childIdFor((UastChildRole.typeRole())))
        if ((strlen typeId) > 0) {
            if (m.mentionsNode(typeId)) {
                def tn:UNode (m.nodeById(typeId))
                s.typeName = tn.name
            }
        }
        m.addSymbol(s)
    }

    sfn applyContains:void (m:UastCodeModel) {
        def i:int 0
        while (i < (array_length m.symbols)) {
            def s:UastSymbol (itemAt m.symbols i)
            if ((strlen s.parentSymbol) > 0) {
                m.link(s.parentSymbol s.id (UastRelKind.containsRel()) (UastResolution.resolved()) (UastConfidence.exact()))
            }
            i = (i + 1)
        }
    }

    sfn applyHints:void (m:UastCodeModel result:UastFrontendResult) {
        def i:int 0
        while (i < (array_length result.hints)) {
            def h:UastSemanticHint (itemAt result.hints i)
            def fromId:string (UastSemantic.symbolForNode(m h.nodeId))
            def toId:string (UastSemantic.resolveTarget(m h.target))
            def resolution:string h.resolution
            def confidence:string h.confidence
            if (h.kind == "extends") {
                if ((strlen fromId) > 0) {
                    def fs:UastSymbol (m.symbolById(fromId))
                    fs.extendsName = (UastSemantic.displayName(m h.target))
                }
            }
            if ((strlen toId) == 0) {
                if ((strlen resolution) == 0) {
                    resolution = (UastResolution.unresolved())
                }
                if (h.source != "compilerResolved") {
                    if (confidence == "exact") {
                        confidence = (UastConfidence.possible())
                    }
                }
            } {
                if ((strlen resolution) == 0) {
                    resolution = (UastResolution.resolved())
                }
                if (h.source == "compilerResolved") {
                    if ((strlen confidence) == 0) {
                        confidence = (UastConfidence.exact())
                    }
                } {
                    if (confidence == "exact") {
                        if (h.source != "compilerResolved") {
                            confidence = (UastConfidence.inferred())
                        }
                    }
                }
            }
            if (h.kind == "calls") {
                if ((strlen fromId) == 0) {
                    fromId = (UastSemantic.enclosingMethod(m h.nodeId))
                }
            }
            if ((h.kind == "usesType") || (h.kind == "constructs")) {
                if ((strlen toId) == 0) {
                    def nm:string (UastSemantic.displayName(m h.target))
                    if ((strlen nm) > 0) {
                        def sid:string ("class:" + nm)
                        if ((m.mentionsSymbol(sid)) == false) {
                            def ghost:UastSymbol (UastSymbol.create(sid nm (UastSymKind.classSym()) m.language))
                            m.addSymbol(ghost)
                        }
                        toId = sid
                    }
                }
            }
            if ((strlen h.nodeId) > 0) {
                def role:string "ref"
                if (h.kind == "calls") {
                    role = "call"
                }
                if (h.kind == "usesType") {
                    role = "type"
                }
                m.addReference((UastReference.create(h.nodeId toId role resolution confidence)))
            }
            if ((strlen fromId) > 0) {
                if ((strlen toId) > 0) {
                    m.link(fromId toId h.kind resolution confidence)
                }
            }
            i = (i + 1)
        }
    }

    sfn symbolForNode:string (m:UastCodeModel nodeId:string) {
        def id:string (m.symbolDeclaredAt(nodeId))
        if ((strlen id) > 0) {
            return id
        }
        return (UastSemantic.enclosingMethod(m nodeId))
    }

    sfn indexModules:void (m:UastCodeModel) {
        def i:int 0
        while (i < (array_length m.files)) {
            def f:UastSourceFile (itemAt m.files i)
            def id:string ("module:" + f.path)
            if ((m.mentionsSymbol(id)) == false) {
                def s:UastSymbol (UastSymbol.create(id f.path (UastSymKind.module()) m.language))
                s.fileName = f.path
                m.addSymbol(s)
            }
            i = (i + 1)
        }
    }

    sfn indexVariables:void (m:UastCodeModel) {
        def i:int 0
        while (i < (array_length m.nodes)) {
            def node:UNode (itemAt m.nodes i)
            if (node.kind == "VariableDecl") {
                def id:string ((("var:" + node.span.fileId) + ".") + node.name)
                if (m.mentionsSymbol(id)) {
                    def n:int 2
                    def cand:string ((id + "#") + (to_string n))
                    while (m.mentionsSymbol(cand)) {
                        n = (n + 1)
                        cand = ((id + "#") + (to_string n))
                    }
                    id = cand
                }
                def s:UastSymbol (UastSymbol.create(id node.name (UastSymKind.variable()) node.language))
                s.declarationNode = node.id
                s.fileName = node.span.fileId
                def typeId:string (node.childIdFor((UastChildRole.typeRole())))
                if ((strlen typeId) > 0) {
                    if (m.mentionsNode(typeId)) {
                        def tn:UNode (m.nodeById(typeId))
                        s.typeName = tn.name
                    }
                }
                m.addSymbol(s)
            }
            i = (i + 1)
        }
    }

    sfn indexExports:void (m:UastCodeModel) {
        def i:int 0
        while (i < (array_length m.nodes)) {
            def node:UNode (itemAt m.nodes i)
            if (node.kind == "Export") {
                def elem:string (node.childIdFor((UastChildRole.element())))
                if ((strlen elem) > 0) {
                    UastSemantic.markExported(m elem node.span.fileId)
                }
                def names:[string] (node.childIdsFor((UastChildRole.nameRole())))
                def ni:int 0
                while (ni < (array_length names)) {
                    def nid:string (itemAt names ni)
                    if (m.mentionsNode(nid)) {
                        def ident:UNode (m.nodeById(nid))
                        def sid:string (UastSemantic.declInFileNamed(m node.span.fileId ident.name))
                        if ((strlen sid) > 0) {
                            UastSemantic.addExportLink(m node.span.fileId sid)
                        }
                    }
                    ni = (ni + 1)
                }
            }
            if ((node.kind == "ClassDecl") || (node.kind == "InterfaceDecl") || (node.kind == "FunctionDecl") || (node.kind == "TypeDecl")) {
                if (node.mentionsFlag("export")) {
                    UastSemantic.markExported(m node.id node.span.fileId)
                }
            }
            i = (i + 1)
        }
    }

    sfn markExported:void (m:UastCodeModel nodeId:string fileId:string) {
        def sid:string (m.symbolDeclaredAt(nodeId))
        if ((strlen sid) == 0) {
            return
        }
        UastSemantic.addExportLink(m fileId sid)
    }

    sfn addExportLink:void (m:UastCodeModel fileId:string symbolId:string) {
        def mod:string ("module:" + fileId)
        if ((m.mentionsSymbol(mod)) == false) {
            return
        }
        if (UastSemantic.mentionsRel(m mod symbolId (UastRelKind.exports()))) {
            return
        }
        def res:string (UastResolution.resolved())
        def exact:string (UastConfidence.exact())
        m.link(mod symbolId (UastRelKind.exports()) res exact)
    }

    sfn declInFileNamed:string (m:UastCodeModel fileId:string name:string) {
        def found:string ""
        def n:int 0
        def i:int 0
        while (i < (array_length m.symbols)) {
            def s:UastSymbol (itemAt m.symbols i)
            if (s.fileName == fileId) {
                if (s.name == name) {
                    if ((s.kind == "class") || (s.kind == "interface") || (s.kind == "function") || (s.kind == "type")) {
                        found = s.id
                        n = (n + 1)
                    }
                }
            }
            i = (i + 1)
        }
        if (n == 1) {
            return found
        }
        return ""
    }

    sfn mentionsRel:boolean (m:UastCodeModel fromId:string toId:string kind:string) {
        def i:int 0
        while (i < (array_length m.relationships)) {
            def rel:UastRelation (itemAt m.relationships i)
            if (rel.fromId == fromId) {
                if (rel.toId == toId) {
                    if (rel.kind == kind) {
                        return true
                    }
                }
            }
            i = (i + 1)
        }
        return false
    }

    sfn enclosingMethod:string (m:UastCodeModel nodeId:string) {
        def i:int 0
        while (i < (array_length m.nodes)) {
            def n:UNode (itemAt m.nodes i)
            def isFn:boolean false
            if (n.kind == "MethodDecl") {
                isFn = true
            }
            if (n.kind == "FunctionDecl") {
                isFn = true
            }
            if isFn {
                if (UastSemantic.subtreeMentions(m n nodeId)) {
                    return (m.symbolDeclaredAt(n.id))
                }
            }
            i = (i + 1)
        }
        return ""
    }

    sfn subtreeMentions:boolean (m:UastCodeModel root:UNode want:string) {
        if (root.id == want) {
            return true
        }
        def i:int 0
        while (i < (array_length root.children)) {
            def ch:UChild (itemAt root.children i)
            if (ch.nodeId == want) {
                return true
            }
            if (m.mentionsNode(ch.nodeId)) {
                if (UastSemantic.subtreeMentions(m (m.nodeById(ch.nodeId)) want)) {
                    return true
                }
            }
            i = (i + 1)
        }
        return false
    }

    sfn resolveTarget:string (m:UastCodeModel target:string) {
        if ((strlen target) == 0) {
            return ""
        }
        if (m.mentionsSymbol(target)) {
            return target
        }
        def atDecl:string (m.symbolDeclaredAt(target))
        if ((strlen atDecl) > 0) {
            return atDecl
        }
        return (m.uniqueSymbolNamed(target))
    }

    sfn displayName:string (m:UastCodeModel target:string) {
        if (m.mentionsSymbol(target)) {
            def s:UastSymbol (m.symbolById(target))
            return s.name
        }
        if (m.mentionsNode(target)) {
            def n:UNode (m.nodeById(target))
            return n.name
        }
        if ((indexOf target "class:") == 0) {
            return (substring target 6)
        }
        return target
    }

    sfn resolveRefs:void (m:UastCodeModel) {
        UastSemantic.resolveImports(m)
        UastSemantic.resolveTypeRefs(m)
        UastSemantic.resolveIdents(m)
        UastSemantic.inferNewTypes(m)
        def i:int 0
        while (i < (array_length m.nodes)) {
            def n:UNode (itemAt m.nodes i)
            def isFn:boolean false
            if (n.kind == "MethodDecl") {
                isFn = true
            }
            if (n.kind == "FunctionDecl") {
                isFn = true
            }
            if isFn {
                UastSemantic.walkResolveMembers(m n)
            }
            i = (i + 1)
        }
        UastSemantic.resolveMembersFixpoint(m)
        UastSemantic.resolveCalls(m)
    }

    sfn resolveTypeRefs:void (m:UastCodeModel) {
        def i:int 0
        while (i < (array_length m.nodes)) {
            def n:UNode (itemAt m.nodes i)
            if (n.kind == "TypeRef") {
                def bare:string (UastSemantic.typeBareName(n.name))
                if ((strlen bare) > 0) {
                    def sid:string ("class:" + bare)
                    if (m.mentionsSymbol(sid)) {
                        UastSemantic.addExactRef(m n.id sid "type")
                    }
                }
            }
            i = (i + 1)
        }
    }

    sfn resolveIdents:void (m:UastCodeModel) {
        def i:int 0
        while (i < (array_length m.nodes)) {
            def n:UNode (itemAt m.nodes i)
            if (n.kind == "Identifier") {
                if ((UastSemantic.usedAsMember(m n.id)) == false) {
                    UastSemantic.resolveIdent(m n)
                }
            }
            i = (i + 1)
        }
    }

    sfn resolveIdent:void (m:UastCodeModel n:UNode) {
        if (n.name == "this") {
            def cls:string (UastSemantic.enclosingClass(m n.id))
            if ((strlen cls) > 0) {
                UastSemantic.addExactRef(m n.id cls "ref")
            }
            return
        }
        def methodId:string (UastSemantic.enclosingMethod(m n.id))
        if ((strlen methodId) > 0) {
            def paramId:string (UastSemantic.childSymbolNamed(m methodId n.name "parameter"))
            if ((strlen paramId) > 0) {
                UastSemantic.addExactRef(m n.id paramId "ref")
                return
            }
        }
        def fileId:string n.span.fileId
        if ((strlen fileId) > 0) {
            def imported:string (UastSemantic.importBinding(m fileId n.name))
            if ((strlen imported) > 0) {
                UastSemantic.addExactRef(m n.id imported "ref")
                return
            }
            def varId:string (UastSemantic.fileVarNamed(m fileId n.name))
            if ((strlen varId) > 0) {
                UastSemantic.addExactRef(m n.id varId "ref")
                return
            }
        }
        def clsId:string (UastSemantic.enclosingClass(m n.id))
        if ((strlen clsId) > 0) {
            def mem:string (UastSemantic.uniqueChildNamed(m clsId n.name))
            if ((strlen mem) > 0) {
                UastSemantic.addExactRef(m n.id mem "ref")
                return
            }
        }
        def typeId:string ("class:" + n.name)
        if (m.mentionsSymbol(typeId)) {
            UastSemantic.addExactRef(m n.id typeId "ref")
            return
        }
        def fnId:string (UastSemantic.uniqueFnNamed(m n.name))
        if ((strlen fnId) > 0) {
            UastSemantic.addExactRef(m n.id fnId "ref")
        }
    }

    sfn walkResolveMembers:void (m:UastCodeModel n:UNode) {
        def i:int 0
        while (i < (array_length n.children)) {
            def ch:UChild (itemAt n.children i)
            if (m.mentionsNode(ch.nodeId)) {
                UastSemantic.walkResolveMembers(m (m.nodeById(ch.nodeId)))
            }
            i = (i + 1)
        }
        if (n.kind == "MemberAccess") {
            UastSemantic.resolveMemberAccess(m n)
        }
    }

    sfn resolveMemberAccess:void (m:UastCodeModel n:UNode) {
        def recvId:string (n.childIdFor((UastChildRole.receiver())))
        def memId:string (n.childIdFor((UastChildRole.member())))
        if ((strlen memId) == 0) {
            return
        }
        if ((m.mentionsNode(memId)) == false) {
            return
        }
        def mem:UNode (m.nodeById(memId))
        def typeName:string (UastSemantic.typeNameOfNode(m recvId))
        def bare:string (UastSemantic.typeBareName(typeName))
        if ((strlen bare) == 0) {
            return
        }
        def classId:string ("class:" + bare)
        if ((m.mentionsSymbol(classId)) == false) {
            return
        }
        def target:string (UastSemantic.uniqueChildNamed(m classId mem.name))
        if ((strlen target) == 0) {
            return
        }
        UastSemantic.addExactRef(m n.id target "ref")
        UastSemantic.addExactRef(m memId target "ref")
    }

    sfn typeNameOfNode:string (m:UastCodeModel nodeId:string) {
        if ((m.mentionsNode(nodeId)) == false) {
            return ""
        }
        def target:string (UastSemantic.refTargetOf(m nodeId))
        if ((strlen target) > 0) {
            if (m.mentionsSymbol(target)) {
                def s:UastSymbol (m.symbolById(target))
                if ((s.kind == "class") || (s.kind == "interface")) {
                    return s.name
                }
                if ((strlen s.typeName) > 0) {
                    return s.typeName
                }
                if ((strlen s.returns) > 0) {
                    return s.returns
                }
            }
        }
        def node:UNode (m.nodeById(nodeId))
        if (node.kind == "Identifier") {
            if (node.name == "this") {
                def cls:string (UastSemantic.enclosingClass(m nodeId))
                if (m.mentionsSymbol(cls)) {
                    def cs:UastSymbol (m.symbolById(cls))
                    return cs.name
                }
            }
        }
        if (node.kind == "TypeRef") {
            return node.name
        }
        return ""
    }

    sfn typeBareName:string (name:string) {
        if ((strlen name) < 2) {
            return name
        }
        if ((charAt name 0) == ((ccode "["))) {
            return (substring name 1 ((strlen name) - 1))
        }
        return name
    }

    sfn usedAsMember:boolean (m:UastCodeModel nodeId:string) {
        def i:int 0
        while (i < (array_length m.nodes)) {
            def n:UNode (itemAt m.nodes i)
            if (n.kind == "MemberAccess") {
                def mid:string (n.childIdFor((UastChildRole.member())))
                if (mid == nodeId) {
                    return true
                }
            }
            i = (i + 1)
        }
        return false
    }

    sfn enclosingClass:string (m:UastCodeModel nodeId:string) {
        def mid:string (UastSemantic.enclosingMethod(m nodeId))
        if ((strlen mid) > 0) {
            def ms:UastSymbol (m.symbolById(mid))
            if ((strlen ms.parentSymbol) > 0) {
                return ms.parentSymbol
            }
        }
        def i:int 0
        while (i < (array_length m.nodes)) {
            def n:UNode (itemAt m.nodes i)
            if ((n.kind == "ClassDecl") || (n.kind == "InterfaceDecl")) {
                if (UastSemantic.subtreeMentions(m n nodeId)) {
                    return (m.symbolDeclaredAt(n.id))
                }
            }
            i = (i + 1)
        }
        return ""
    }

    sfn childSymbolNamed:string (m:UastCodeModel parentId:string name:string kind:string) {
        def found:string ""
        def n:int 0
        def i:int 0
        while (i < (array_length m.symbols)) {
            def s:UastSymbol (itemAt m.symbols i)
            if (s.parentSymbol == parentId) {
                if (s.kind == kind) {
                    if (s.name == name) {
                        found = s.id
                        n = (n + 1)
                    }
                }
            }
            i = (i + 1)
        }
        if (n == 1) {
            return found
        }
        return ""
    }

    sfn uniqueChildNamed:string (m:UastCodeModel parentId:string name:string) {
        def found:string ""
        def n:int 0
        def i:int 0
        while (i < (array_length m.symbols)) {
            def s:UastSymbol (itemAt m.symbols i)
            if (s.parentSymbol == parentId) {
                if (s.name == name) {
                    found = s.id
                    n = (n + 1)
                }
            }
            i = (i + 1)
        }
        if (n == 1) {
            return found
        }
        return ""
    }

    sfn uniqueFnNamed:string (m:UastCodeModel name:string) {
        def found:string ""
        def n:int 0
        def i:int 0
        while (i < (array_length m.symbols)) {
            def s:UastSymbol (itemAt m.symbols i)
            if (s.kind == "function") {
                if (s.name == name) {
                    found = s.id
                    n = (n + 1)
                }
            }
            i = (i + 1)
        }
        if (n == 1) {
            return found
        }
        return ""
    }

    sfn addExactRef:void (m:UastCodeModel nodeId:string target:string role:string) {
        if ((strlen nodeId) == 0) {
            return
        }
        if ((strlen target) == 0) {
            return
        }
        if (UastSemantic.mentionsRefTo(m nodeId target)) {
            return
        }
        def res:string (UastResolution.resolved())
        def exact:string (UastConfidence.exact())
        m.addReference((UastReference.create(nodeId target role res exact)))
    }

    sfn mentionsRefTo:boolean (m:UastCodeModel nodeId:string target:string) {
        def i:int 0
        while (i < (array_length m.references)) {
            def ref:UastReference (itemAt m.references i)
            if (ref.sourceNode == nodeId) {
                if (ref.targetSymbol == target) {
                    return true
                }
            }
            i = (i + 1)
        }
        return false
    }

    sfn refTargetOf:string (m:UastCodeModel nodeId:string) {
        def i:int 0
        while (i < (array_length m.references)) {
            def ref:UastReference (itemAt m.references i)
            if (ref.sourceNode == nodeId) {
                if ((strlen ref.targetSymbol) > 0) {
                    return ref.targetSymbol
                }
            }
            i = (i + 1)
        }
        return ""
    }

    sfn resolveImports:void (m:UastCodeModel) {
        def i:int 0
        while (i < (array_length m.nodes)) {
            def n:UNode (itemAt m.nodes i)
            if (n.kind == "Import") {
                UastSemantic.resolveOneImport(m n)
            }
            i = (i + 1)
        }
    }

    sfn resolveOneImport:void (m:UastCodeModel n:UNode) {
        def spec:string n.name
        if ((strlen spec) == 0) {
            return
        }
        def fromFile:string n.span.fileId
        def targetFile:string (UastSemantic.resolveModulePath(m fromFile spec))
        if ((strlen targetFile) == 0) {
            def d:UastDiagnostic (UastDiagnostic.create((("unresolved import " + spec) + " from " + fromFile) "error"))
            d.span.fileId = fromFile
            m.addDiagnostic(d)
            return
        }
        def names:[string] (n.childIdsFor((UastChildRole.nameRole())))
        if ((array_length names) == 0) {
            def fromMod:string ("module:" + fromFile)
            def toMod:string ("module:" + targetFile)
            if ((m.mentionsSymbol(fromMod)) && (m.mentionsSymbol(toMod))) {
                if ((UastSemantic.mentionsRel(m fromMod toMod (UastRelKind.imports()))) == false) {
                    m.link(fromMod toMod (UastRelKind.imports()) (UastResolution.resolved()) (UastConfidence.exact()))
                }
            }
            return
        }
        def ni:int 0
        while (ni < (array_length names)) {
            def nid:string (itemAt names ni)
            if (m.mentionsNode(nid)) {
                def ident:UNode (m.nodeById(nid))
                def target:string (UastSemantic.importableNamed(m targetFile ident.name))
                if ((strlen target) > 0) {
                    UastSemantic.addExactRef(m nid target "import")
                    UastSemantic.addExactRef(m n.id target "import")
                    def fromMod:string ("module:" + fromFile)
                    if (m.mentionsSymbol(fromMod)) {
                        if ((UastSemantic.mentionsRel(m fromMod target (UastRelKind.imports()))) == false) {
                            m.link(fromMod target (UastRelKind.imports()) (UastResolution.resolved()) (UastConfidence.exact()))
                        }
                    }
                } {
                    def d2:UastDiagnostic (UastDiagnostic.create(((ident.name + " is not exported from ") + targetFile) "error"))
                    d2.span.fileId = fromFile
                    m.addDiagnostic(d2)
                }
            }
            ni = (ni + 1)
        }
    }

    sfn importableNamed:string (m:UastCodeModel filePath:string name:string) {
        def mod:string ("module:" + filePath)
        def hasExports:boolean false
        def ei:int 0
        while (ei < (array_length m.relationships)) {
            def rel:UastRelation (itemAt m.relationships ei)
            if (rel.fromId == mod) {
                if (rel.kind == "exports") {
                    hasExports = true
                }
            }
            ei = (ei + 1)
        }
        if hasExports {
            def fi:int 0
            while (fi < (array_length m.relationships)) {
                def erel:UastRelation (itemAt m.relationships fi)
                if (erel.fromId == mod) {
                    if (erel.kind == "exports") {
                        if (m.mentionsSymbol(erel.toId)) {
                            def s:UastSymbol (m.symbolById(erel.toId))
                            if (s.name == name) {
                                return erel.toId
                            }
                        }
                    }
                }
                fi = (fi + 1)
            }
            return ""
        }
        return (UastSemantic.declInFileNamed(m filePath name))
    }

    sfn importBinding:string (m:UastCodeModel fileId:string name:string) {
        def i:int 0
        while (i < (array_length m.nodes)) {
            def n:UNode (itemAt m.nodes i)
            if (n.kind == "Import") {
                if (n.span.fileId == fileId) {
                    def names:[string] (n.childIdsFor((UastChildRole.nameRole())))
                    def ni:int 0
                    while (ni < (array_length names)) {
                        def nid:string (itemAt names ni)
                        if (m.mentionsNode(nid)) {
                            def ident:UNode (m.nodeById(nid))
                            if (ident.name == name) {
                                def t:string (UastSemantic.refTargetOf(m nid))
                                if ((strlen t) > 0) {
                                    return t
                                }
                            }
                        }
                        ni = (ni + 1)
                    }
                    if ((array_length names) == 0) {
                        def specFile:string (UastSemantic.resolveModulePath(m fileId n.name))
                        if ((strlen specFile) > 0) {
                            def t2:string (UastSemantic.importableNamed(m specFile name))
                            if ((strlen t2) > 0) {
                                return t2
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return ""
    }

    sfn fileVarNamed:string (m:UastCodeModel fileId:string name:string) {
        def found:string ""
        def n:int 0
        def i:int 0
        while (i < (array_length m.symbols)) {
            def s:UastSymbol (itemAt m.symbols i)
            if (s.kind == "variable") {
                if (s.fileName == fileId) {
                    if (s.name == name) {
                        found = s.id
                        n = (n + 1)
                    }
                }
            }
            i = (i + 1)
        }
        if (n == 1) {
            return found
        }
        return ""
    }

    sfn inferNewTypes:void (m:UastCodeModel) {
        def i:int 0
        while (i < (array_length m.nodes)) {
            def n:UNode (itemAt m.nodes i)
            if (n.kind == "VariableDecl") {
                def sid:string (m.symbolDeclaredAt(n.id))
                if ((strlen sid) > 0) {
                    def s:UastSymbol (m.symbolById(sid))
                    if ((strlen s.typeName) == 0) {
                        def initId:string (n.childIdFor((UastChildRole.initializer())))
                        if (m.mentionsNode(initId)) {
                            def initN:UNode (m.nodeById(initId))
                            if (initN.kind == "New") {
                                def calleeId:string (initN.childIdFor((UastChildRole.callee())))
                                def t:string (UastSemantic.typeNameOfNode(m calleeId))
                                if ((strlen t) > 0) {
                                    s.typeName = (UastSemantic.typeBareName(t))
                                }
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
    }

    sfn resolveMembersFixpoint:void (m:UastCodeModel) {
        def guard:int 0
        def changed:boolean true
        while changed {
            if (guard > 8) {
                break
            }
            guard = (guard + 1)
            changed = false
            def i:int 0
            while (i < (array_length m.nodes)) {
                def n:UNode (itemAt m.nodes i)
                if (n.kind == "MemberAccess") {
                    def had:boolean ((strlen (UastSemantic.refTargetOf(m n.id))) > 0)
                    UastSemantic.resolveMemberAccess(m n)
                    if had {
                    } {
                        if ((strlen (UastSemantic.refTargetOf(m n.id))) > 0) {
                            changed = true
                        }
                    }
                }
                i = (i + 1)
            }
        }
    }

    sfn resolveModulePath:string (m:UastCodeModel fromFile:string spec:string) {
        def allowBase:boolean true
        if ((strlen spec) > 0) {
            if ((charAt spec 0) == ((ccode "."))) {
                allowBase = false
            }
            if ((charAt spec 0) == ((ccode "/"))) {
                allowBase = false
            }
        }
        def joined:string spec
        if allowBase {
            joined = spec
        } {
            joined = (UastSemantic.joinPath((UastSemantic.dirOf(fromFile)) spec))
        }
        def hit:string (UastSemantic.findWorkspaceFile(m joined false))
        if ((strlen hit) > 0) {
            return hit
        }
        if allowBase {
            return (UastSemantic.findWorkspaceFile(m spec true))
        }
        return ""
    }

    sfn findWorkspaceFile:string (m:UastCodeModel want:string allowBasename:boolean) {
        def norm:string (UastSemantic.collapsePath(want))
        def i:int 0
        while (i < (array_length m.files)) {
            def f:UastSourceFile (itemAt m.files i)
            def p:string f.path
            def pn:string (UastSemantic.collapsePath(p))
            if (pn == norm) {
                return p
            }
            if (pn == (norm + ".ts")) {
                return p
            }
            if (pn == (norm + ".tsx")) {
                return p
            }
            if (pn == (norm + ".rgr")) {
                return p
            }
            if (pn == (norm + ".js")) {
                return p
            }
            def fromJs:string (UastSemantic.jsToTs(norm))
            if ((strlen fromJs) > 0) {
                if (pn == fromJs) {
                    return p
                }
            }
            def fromTsx:string (UastSemantic.jsToTsx(norm))
            if ((strlen fromTsx) > 0) {
                if (pn == fromTsx) {
                    return p
                }
            }
            i = (i + 1)
        }
        if allowBasename {
            def base:string (UastSemantic.baseName(want))
            def n:int 0
            def found:string ""
            def j:int 0
            while (j < (array_length m.files)) {
                def f2:UastSourceFile (itemAt m.files j)
                def p2:string f2.path
                if ((UastSemantic.baseName(p2)) == base) {
                    found = p2
                    n = (n + 1)
                }
                j = (j + 1)
            }
            if (n == 1) {
                return found
            }
        }
        return ""
    }

    sfn jsToTs:string (path:string) {
        def n:int (strlen path)
        if (n < 3) {
            return ""
        }
        if ((substring path (n - 3) n) == ".js") {
            return ((substring path 0 (n - 3)) + ".ts")
        }
        return ""
    }

    sfn jsToTsx:string (path:string) {
        def n:int (strlen path)
        if (n < 3) {
            return ""
        }
        if ((substring path (n - 3) n) == ".js") {
            return ((substring path 0 (n - 3)) + ".tsx")
        }
        return ""
    }

    sfn dirOf:string (path:string) {
        def slash:int (0 - 1)
        def i:int 0
        while (i < (strlen path)) {
            if ((charAt path i) == ((ccode "/"))) {
                slash = i
            }
            i = (i + 1)
        }
        if (slash < 0) {
            return ""
        }
        return (substring path 0 slash)
    }

    sfn baseName:string (path:string) {
        def slash:int (0 - 1)
        def i:int 0
        while (i < (strlen path)) {
            if ((charAt path i) == ((ccode "/"))) {
                slash = i
            }
            i = (i + 1)
        }
        if (slash < 0) {
            return path
        }
        return (substring path (slash + 1) (strlen path))
    }

    sfn joinPath:string (dir:string rel:string) {
        def r:string rel
        if ((indexOf r "./") == 0) {
            r = (substring r 2 (strlen r))
        }
        if ((strlen dir) == 0) {
            return (UastSemantic.collapsePath(r))
        }
        return (UastSemantic.collapsePath((dir + "/") + r))
    }

    sfn collapsePath:string (path:string) {
        def parts:[string]
        def cur:string ""
        def i:int 0
        while (i < (strlen path)) {
            if ((charAt path i) == ((ccode "/"))) {
                UastSemantic.pushSeg(parts cur)
                cur = ""
            } {
                cur = (cur + (substring path i (i + 1)))
            }
            i = (i + 1)
        }
        UastSemantic.pushSeg(parts cur)
        return (join parts "/")
    }

    sfn pushSeg:void (parts:[string] part:string) {
        if ((strlen part) == 0) {
            return
        }
        if (part == ".") {
            return
        }
        if (part == "..") {
            if ((array_length parts) > 0) {
                removeLast parts
            }
            return
        }
        push parts part
    }

    sfn resolveCalls:void (m:UastCodeModel) {
        def i:int 0
        while (i < (array_length m.nodes)) {
            def n:UNode (itemAt m.nodes i)
            if (n.kind == "Call") {
                UastSemantic.resolveOneCall(m n)
            }
            i = (i + 1)
        }
    }

    sfn resolveOneCall:void (m:UastCodeModel n:UNode) {
        def cid:string (n.childIdFor((UastChildRole.callee())))
        if ((m.mentionsNode(cid)) == false) {
            return
        }
        def callee:UNode (m.nodeById(cid))
        if (callee.kind == "IndexAccess") {
            return
        }
        def target:string (UastSemantic.refTargetOf(m cid))
        if ((strlen target) == 0) {
            if (callee.kind == "MemberAccess") {
                def mid:string (callee.childIdFor((UastChildRole.member())))
                target = (UastSemantic.refTargetOf(m mid))
            }
        }
        if ((strlen target) == 0) {
            return
        }
        if ((m.mentionsSymbol(target)) == false) {
            return
        }
        def s:UastSymbol (m.symbolById(target))
        def isFn:boolean false
        if (s.kind == "method") {
            isFn = true
        }
        if (s.kind == "function") {
            isFn = true
        }
        if (isFn == false) {
            return
        }
        UastSemantic.addExactRef(m n.id target "call")
        def fromId:string (UastSemantic.enclosingMethod(m n.id))
        if ((strlen fromId) == 0) {
            return
        }
        if (UastSemantic.mentionsRel(m fromId target (UastRelKind.calls()))) {
            return
        }
        m.link(fromId target (UastRelKind.calls()) (UastResolution.resolved()) (UastConfidence.exact()))
    }
}

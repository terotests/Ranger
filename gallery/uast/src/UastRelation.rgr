; ============================================================================
; UastRelation.rgr — semantic-entity → semantic-entity, plus diagnostics.
; ============================================================================
;
; resolution  = resolved | partiallyResolved | dynamic | unresolved
; confidence  = exact | inferred | possible
;
; Exact only when one unique declaration follows from facts the model
; actually knows. Never upgrade a guess to exact.
; ============================================================================

Import "UastSource.rgr"

class UastRelation {
    def fromId:string ""
    def toId:string ""
    def kind:string ""
    def resolution:string ""
    def confidence:string ""

    Constructor () {
    }

    sfn create:UastRelation (fromId:string toId:string kind:string resolution:string confidence:string) {
        def r (new UastRelation)
        r.fromId = fromId
        r.toId = toId
        r.kind = kind
        r.resolution = resolution
        r.confidence = confidence
        if ((strlen r.resolution) == 0) {
            r.resolution = "resolved"
        }
        if ((strlen r.confidence) == 0) {
            r.confidence = "exact"
        }
        return r
    }
}

class UastDiagnostic {
    def message:string ""
    def severity:string ""
    def span:UastSpan (new UastSpan)

    Constructor () {
    }

    sfn create:UastDiagnostic (message:string severity:string) {
        def d (new UastDiagnostic)
        d.message = message
        d.severity = severity
        return d
    }
}

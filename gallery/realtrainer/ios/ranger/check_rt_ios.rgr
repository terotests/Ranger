; ==============================================================================
; check_rt_ios.rgr — the RealTrainer iOS port, driven without a Mac.
; ==============================================================================
;
; The Apple half of this port is Swift and needs a Mac to compile at all.
; Everything underneath it does not: the demo is Ranger, the facade is Ranger,
; and the display list the painter is handed is a Ranger object. So the
; questions a device would answer are asked here, in the same `RtIos` the app
; runs -- not in a second implementation of the same sums.
;
;   npm run rt:ios:verify
;
; What this proves:
;
;   * the demo behind the facade builds all four scenes and answers with a
;     display list of real commands;
;   * the fit -- the one thing this port has that the dashboard's does not:
;     the page is scaled to what the scene DRAWS rather than to its 980x760
;     canvas, because the scenes use between a half and four fifths of it and
;     fitting the unused remainder is what made the page small on a phone. No
;     word is ever off screen; decoration below the last line -- the
;     full-height rail -- is allowed to run to the screen's edge, which is what
;     a rail should do;
;   * the safe area is taken off before any of that, so nothing lands under the
;     clock or the home indicator;
;   * a press at a WINDOW coordinate -- insets, letterbox and all -- reaches
;     the control drawn there, and a press in the letterbox reaches nothing;
;   * a pinch holds the point under the fingers still, and a pan stops at the
;     page's edge rather than sliding it off the screen;
;   * the clock advances the loading scene and hands over to the sign-in page,
;     which is the demo's own behaviour driven through this facade.
;
; What it does NOT prove is the platform delegation: CoreGraphicsEvgSurface
; calling CGContext, and RealTrainerView unpacking a UITouch. Those need a Mac,
; and `npm run rt:ios` is what builds them.
; ==============================================================================

Import "rt_ios.rgr"

class CheckRtIos {

    def passed:int 0
    def failed:int 0
    def css:string ""

    fn ok:void (what:string cond:boolean) {
        if cond {
            passed = passed + 1
        } {
            failed = failed + 1
            print "  FAIL " + what
        }
    }

    fn okDetail:void (what:string cond:boolean detail:string) {
        if cond {
            passed = passed + 1
        } {
            failed = failed + 1
            print "  FAIL " + what + "  (" + detail + ")"
        }
    }

    sfn near:boolean (a:double b:double eps:double) {
        def d:double (a - b)
        if (d < 0.0) {
            d = (0.0 - d)
        }
        return (d <= eps)
    }

    fn fresh:RtIos (w:double h:double) {
        def app:RtIos (new RtIos)
        app.start(w h css)
        return app
    }

    fn freshInset:RtIos (w:double h:double top:double bottom:double) {
        def app:RtIos (new RtIos)
        app.start(w h css)
        app.setSafeArea(top bottom 0.0 0.0)
        return app
    }

    ; Find the element with this id the way a finger would: ask the hit test at
    ; a grid of WINDOW points and press the first one that answers. Deliberately
    ; the whole input path -- window point, safe area, letterbox, scale, hit
    ; test -- rather than a call to press(id), because the conversion is what
    ; this port adds and therefore what is worth checking.
    fn pressUntil:boolean (app:RtIos id:string w:double h:double) {
        def x:double 4.0
        while (x < w) {
            def y:double 4.0
            while (y < h) {
                if ((app.hitAt(x y)) == id) {
                    app.pressAt(x y)
                    app.releasePress()
                    return true
                }
                y = (y + 8.0)
            }
            x = (x + 8.0)
        }
        return false
    }

    ; The bottom of the last WORD, in window points. Decoration below it -- the
    ; full-height rail, a panel back -- is allowed off the screen; a word is
    ; not. This is the invariant the fit is built on, so it is what the checks
    ; ask about rather than the canvas's own corner.
    fn wordsBottom:double (app:RtIos) {
        def dl:EVGDisplayList (app.frame())
        def bottom:double 0.0
        for dl.cmds c:EVGDrawCmd i {
            if ((strlen c.text) > 0) {
                def b:double (c.y + c.h)
                if (b > bottom) {
                    bottom = b
                }
            }
        }
        return ((app.offsetY()) + (bottom * (app.scale())))
    }

    fn wordsRight:double (app:RtIos) {
        def dl:EVGDisplayList (app.frame())
        def right:double 0.0
        for dl.cmds c:EVGDrawCmd i {
            if ((strlen c.text) > 0) {
                def r:double (c.x + c.w)
                if (r > right) {
                    right = r
                }
            }
        }
        return ((app.offsetX()) + (right * (app.scale())))
    }

    fn commandCount:int (app:RtIos) {
        def dl:EVGDisplayList (app.frame())
        return (array_length dl.cmds)
    }

    ; --- the page -------------------------------------------------------------

    fn checkPage:void () {
        print "--- the page the painter is handed ---"
        def app:RtIos (this.fresh(1180.0 820.0))
        this.ok("the page has its designed width" ((app.pageWidth()) > 900.0))
        this.ok("and its designed height" ((app.pageHeight()) > 700.0))
        this.ok("the first frame has commands" ((this.commandCount(app)) > 20))
        this.ok("the app starts on the loading scene" ((app.sceneName()) == "loading"))
        this.okDetail("the stylesheet parsed without errors" ((app.styleErrorCount()) == 0)
            (to_string (app.styleErrorCount())))
    }

    ; --- the fit --------------------------------------------------------------

    fn checkFit:void () {
        print "--- the page is fitted to what the scene draws ---"

        ; The fit is against the CONTENT, not the canvas. The demo's scenes use
        ; between a half and four fifths of their 980x760 canvas -- the session
        ; writes nothing below y=346 -- and fitting the unused remainder is what
        ; made the page small on a phone. Measured on an 874x402 landscape
        ; phone, fitting the content instead is 20% bigger on the loading
        ; screen, 25% on the dashboard and 69% on the session.
        def phone:RtIos (this.fresh(874.0 402.0))
        def canvasFit:double (402.0 / 760.0)
        this.okDetail("the loading screen is bigger than a canvas fit"
            ((phone.scale()) > (canvasFit * 1.1)) (to_string (phone.scale())))
        phone.setScene("session")
        this.okDetail("and the session, which uses least of its canvas, much bigger"
            ((phone.scale()) > (canvasFit * 1.5)) (to_string (phone.scale())))

        ; Never wider than the window, whatever the content does.
        def wide:RtIos (this.fresh(1366.0 700.0))
        this.ok("the page is never wider than the window"
            (((wide.pageWidth()) * (wide.scale())) <= 1366.1))
        this.ok("and never scaled past its own width"
            ((wide.scale()) <= ((1366.0 / (wide.pageWidth())) + 0.001)))

        ; A tall window: WIDTH binds, and the page is centred in what is left.
        def tall:RtIos (this.fresh(800.0 1200.0))
        this.okDetail("a tall window fits by width"
            (CheckRtIos.near((tall.scale()) (800.0 / (tall.pageWidth())) 0.001))
            (to_string (tall.scale())))
        this.ok("with room above it" ((tall.offsetY()) > 0.0))

        ; The composition is never re-laid-out to the window.
        this.ok("the page keeps its size in both" ((wide.pageHeight()) == (tall.pageHeight())))
    }

    ; --- the safe area --------------------------------------------------------

    fn checkSafeArea:void () {
        print "--- the safe area comes off first ---"
        def plain:RtIos (this.fresh(1180.0 820.0))
        def inset:RtIos (this.freshInset(1180.0 820.0 59.0 34.0))
        this.ok("insets shrink the usable height"
            ((inset.usableHeight()) == ((plain.usableHeight()) - 93.0)))
        this.ok("so an inset window scales the page down"
            ((inset.scale()) <= (plain.scale())))
        this.ok("and the page starts below the status bar"
            ((inset.offsetY()) >= 59.0))
        def bottomEdge:double (this.wordsBottom(inset))
        this.okDetail("and its last line ends above the home indicator" (bottomEdge <= (820.0 - 34.0 + 0.5))
            (to_string bottomEdge))
    }

    ; --- window point to page point -------------------------------------------

    fn checkMapping:void () {
        print "--- a window point becomes the right page point ---"
        def app:RtIos (this.freshInset(1180.0 820.0 59.0 34.0))
        def s:double (app.scale())

        ; The page's own corner, mapped back, is the origin.
        this.ok("the page corner maps to 0"
            (CheckRtIos.near((app.toPageX((app.offsetX()))) 0.0 0.001)))
        this.ok("in both axes"
            (CheckRtIos.near((app.toPageY((app.offsetY()))) 0.0 0.001)))

        ; And a point one page pixel in is one page pixel in, whatever the
        ; scale and the letterbox are doing.
        def x100:double ((app.offsetX()) + (100.0 * s))
        this.okDetail("100 page pixels across is 100 back" (CheckRtIos.near((app.toPageX(x100)) 100.0 0.01))
            (to_string (app.toPageX(x100))))

        this.ok("a point in the letterbox is off the page" ((app.onPage(1.0 1.0)) == false))
        this.ok("and the middle of the window is on it" (app.onPage(590.0 410.0)))
    }

    ; --- input ----------------------------------------------------------------

    fn checkInput:void () {
        print "--- a finger reaches the control drawn under it ---"
        def app:RtIos (this.freshInset(1180.0 820.0 59.0 34.0))

        ; The loader is on screen at the start, and its ring is the thing the
        ; page is built around. Hitting anything at all through the full
        ; window -> page conversion is the point.
        def hit:string (app.hitAt(590.0 410.0))
        this.okDetail("the middle of the window hits the page" ((strlen hit) > 0) hit)

        ; The loading scene hands over on its own; drive it to the sign-in page
        ; and press the control the demo's own check presses.
        app.setScene("signin")
        this.ok("the scene changed" ((app.sceneName()) == "signin"))
        ; `rt-google` is the sign-in page's own button -- the one the browser
        ; check presses too, so the two agree about what the page offers.
        def reached:boolean (this.pressUntil(app "rt-google" 1180.0 820.0))
        this.ok("the sign-in button is reachable by a window point" reached)
        this.okDetail("and pressing it moves the app on" ((app.sceneName()) == "dashboard")
            (app.sceneName()))

        ; A press that lands in the letterbox marks nothing.
        def app2:RtIos (this.fresh(1366.0 700.0))
        this.ok("a press in the letterbox presses nothing" ((app2.pressAt(2.0 2.0)) == false))
        app2.releasePress()
    }

    ; --- pinch and pan --------------------------------------------------------

    fn checkZoom:void () {
        print "--- a pinch holds the point under the fingers ---"
        def app:RtIos (this.fresh(1180.0 820.0))
        def fx:double 700.0
        def fy:double 500.0
        def beforeX:double (app.toPageX(fx))
        def beforeY:double (app.toPageY(fy))
        this.ok("a pinch reports a change" (app.pinch(1.8 fx fy)))
        this.okDetail("the page point under the fingers did not move"
            (CheckRtIos.near((app.toPageX(fx)) beforeX 0.01))
            (to_string (app.toPageX(fx))))
        this.ok("in both axes" (CheckRtIos.near((app.toPageY(fy)) beforeY 0.01)))
        this.ok("and the page is now bigger than the window" (app.canPan()))

        ; Zoomed in, a drag moves the page and stops at its edge.
        this.ok("a drag moves it" (app.panBy(-40.0 -40.0)))
        def far:boolean true
        def n:int 0
        while (n < 200) {
            app.panBy(-60.0 -60.0)
            n = (n + 1)
        }
        def s:double (app.scale())
        def rightEdge:double ((app.offsetX()) + ((app.pageWidth()) * s))
        this.okDetail("and stops with the page's right edge on screen" (rightEdge >= 1179.9)
            (to_string rightEdge))

        this.ok("a double tap resets it" (app.resetZoom()))
        this.okDetail("back to the fitted scale" (CheckRtIos.near((app.scale()) (app.fitScale) 0.001)) (to_string (app.scale())))
        this.ok("and a second reset is a no-op" ((app.resetZoom()) == false))

        ; At rest every word is on screen. The canvas may still hang below the
        ; last line -- that is the full-height rail -- so this asks about words.
        def rest:RtIos (this.fresh(1180.0 820.0))
        this.ok("at rest every word is on screen" ((this.wordsBottom(rest)) <= 820.5))
    }

    ; --- no word is ever cut off ----------------------------------------------

    ; The fit is to the content box, so this holds by construction -- which is
    ; exactly why it is worth asserting: it is the property the whole fit exists
    ; to provide, and a change to how the box is measured would break it
    ; silently. Decoration below the last word is allowed off the screen; a
    ; full-height rail running to the bottom edge is what a rail should do.
    fn checkNothingCutOff:void () {
        print "--- every word is on screen, on every screen ---"
        def w:[double]
        def h:[double]
        def names:[string]
        push names "iPad 10.9 landscape"
        push w 1180.0
        push h 820.0
        push names "iPad mini portrait"
        push w 744.0
        push h 1133.0
        push names "iPhone 16 Pro landscape"
        push w 874.0
        push h 402.0
        push names "iPhone 16 Pro portrait"
        push w 393.0
        push h 852.0
        push names "iPhone SE portrait"
        push w 375.0
        push h 667.0

        def scenes:[string]
        push scenes "loading"
        push scenes "signin"
        push scenes "dashboard"
        push scenes "session"

        for names screen:string i {
            def sw:double (itemAt w i)
            def sh:double (itemAt h i)
            for scenes scene:string si {
                def app:RtIos (this.fresh(sw sh))
                app.setScene(scene)
                def bottom:double (this.wordsBottom(app))
                def right:double (this.wordsRight(app))
                def fits:boolean ((bottom <= (sh + 0.5)) && (right <= (sw + 0.5)))
                this.okDetail(((screen + " / ") + scene) fits
                    ("words reach " + (to_string right) + "," + (to_string bottom)))
            }
        }

        ; And with a notch and a home indicator taken off first.
        def inset:RtIos (this.freshInset(874.0 402.0 59.0 21.0))
        inset.setScene("signin")
        def b:double (this.wordsBottom(inset))
        this.okDetail("the sign-in page clears the home indicator"
            (b <= (402.0 - 21.0 + 0.5)) (to_string b))
        this.ok("and starts below the status bar" ((inset.offsetY()) >= 59.0))
    }

    ; --- the press has to show -------------------------------------------------

    ; A frame reduced to what it would look like: kind, box and colour of every
    ; command. Two frames with the same fingerprint draw the same picture.
    fn fingerprint:string (app:RtIos) {
        def dl:EVGDisplayList (app.frame())
        def out:string ""
        for dl.cmds c:EVGDrawCmd i {
            out = out + (to_string c.kind) + ":" + (to_string c.x) + "," + (to_string c.y)
            out = out + "," + (to_string c.w) + "x" + (to_string c.h)
            out = out + "," + (to_string c.r) + "/" + (to_string c.g) + "/" + (to_string c.b)
            out = out + "/" + (to_string c.a) + ";"
        }
        return out
    }

    ; How many frames after a finger lands before the picture differs, or -1 if
    ; it never does.
    fn framesUntilPressShows:int (app:RtIos x:double y:double) {
        def before:string (this.fingerprint(app))
        app.pressAt(x y)
        def i:int 0
        while (i < 20) {
            if ((this.fingerprint(app)) != before) {
                return i
            }
            app.tick(16.0)
            i = (i + 1)
        }
        return (0 - 1)
    }

    fn pressShowsAt:void (scene:string want:string) {
        def app:RtIos (this.fresh(1180.0 820.0))
        app.setScene(scene)
        def x:double 4.0
        while (x < 1180.0) {
            def y:double 4.0
            while (y < 820.0) {
                if ((app.hitAt(x y)) == want) {
                    def fresh:RtIos (this.fresh(1180.0 820.0))
                    fresh.setScene(scene)
                    def n:int (this.framesUntilPressShows(fresh x y))
                    this.okDetail((want + ": the press shows") ((n >= 0) && (n <= 2))
                        ((to_string n) + " frames"))
                    return
                }
                y = (y + 6.0)
            }
            x = (x + 6.0)
        }
        this.ok((want + ": is reachable by a finger") false)
    }

    ; A finger has no hover. A control styled only with `:hover` therefore does
    ; NOTHING between landing and lifting, and the reader -- who cannot see the
    ; press register -- reads the whole gesture as the app being slow. That is
    ; not a rendering cost and no amount of frame budget fixes it; it is a
    ; missing `:active` rule, and this is where one goes missing again.
    fn checkPressFeedback:void () {
        print "--- a press shows before the finger lifts ---"
        this.pressShowsAt("dashboard" "rt-tabs-tab-cal")
        this.pressShowsAt("dashboard" "rt-tabs-tab-drills")
        this.pressShowsAt("signin" "rt-google")
        this.pressShowsAt("signin" "rt-remember")
        this.pressShowsAt("session" "rt-start")
    }

    ; --- the clock ------------------------------------------------------------

    fn checkClock:void () {
        print "--- the clock runs the loading scene ---"
        def app:RtIos (this.fresh(1180.0 820.0))
        this.ok("it starts loading" ((app.sceneName()) == "loading"))
        this.ok("a tick reports movement" (app.tick(16.0)))

        ; The ring turns and the bar fills for a fixed time, then the app hands
        ; over. Driven here with a made-up clock, exactly as the browser check
        ; drives it.
        def n:int 0
        while (n < 400) {
            app.tick(16.0)
            n = (n + 1)
        }
        this.okDetail("and hands over to the sign-in page" ((app.sceneName()) == "signin")
            (app.sceneName()))
        this.ok("the sign-in page draws" ((this.commandCount(app)) > 20))
    }

    ; --- every scene draws ----------------------------------------------------

    fn checkScenes:void () {
        print "--- every scene draws on the device's window ---"
        def app:RtIos (this.freshInset(1180.0 820.0 59.0 34.0))
        def names:[string]
        push names "signin"
        push names "dashboard"
        push names "session"
        for names name:string i {
            app.setScene(name)
            def n:int (this.commandCount(app))
            this.okDetail((("the " + name) + " scene draws") (n > 20) (to_string n))
        }
    }

    sfn main:void () {
        def c:CheckRtIos (new CheckRtIos)
        def cssText@(optional):string (read_file "gallery/realtrainer/web" "realtrainer.css")
        if (null? cssText) {
            print "gallery/realtrainer/web/realtrainer.css is missing"
            exit 1
        }
        c.css = (unwrap cssText)
        c.checkPage()
        c.checkFit()
        c.checkSafeArea()
        c.checkMapping()
        c.checkInput()
        c.checkZoom()
        c.checkPressFeedback()
        c.checkNothingCutOff()
        c.checkClock()
        c.checkScenes()
        print ""
        print ((to_string (c.passed + c.failed)) + " checks, " + (to_string c.failed) + " failed")
        if (c.failed > 0) {
            exit 1
        }
        print "every word is on screen, converted, pressed and ticked"
    }
}

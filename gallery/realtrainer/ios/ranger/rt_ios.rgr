; ==============================================================================
; rt_ios.rgr — RtIos
; ==============================================================================
;
; The name the Swift host imports, and nothing else. Everything this class
; can do is `RtHost` — see `../../src/RtHost.rgr`, which says why the iOS and
; Android facades are one file now. The safe area is the only thing iOS uses
; that Android does not, and it is a call the host makes rather than a class
; of its own: `setSafeArea`.

Import "../../src/RtHost.rgr"

class RtIos extends RtHost {
}

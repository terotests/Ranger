            CompactV1Json.addRawField(fields "reps" "null")
        }
        if (hasName) {
            CompactV1Json.addStringField(fields "name" name)
        } {
            CompactV1Json.addRawField(fields "name" "null")
        }
        return (CompactV1Json.jsonObject(fields))
    }
}

class SectionNode {
    Extends(AstNode)

    def name:string ""
    def hasIntensity:boolean false
    def intensity:int 0
    def hasDuration:boolean false
    def duration:int 0
    def hasSegment:boolean false
    def segmentStart:int 0
    def segmentEnd:int 0
    def segmentUnit:string "m"

    Constructor () {
        type = "section"
    }

    fn toJSONString@(override):string () {
        def fields:[string]
        CompactV1Json.addStringField(fields "type" type)
        CompactV1Json.addStringField(fields "name" name)
        if (hasIntensity) {
            CompactV1Json.addIntField(fields "intensity" intensity)
        } {
            CompactV1Json.addRawField(fields "intensity" "null")
        }
        if (hasDuration) {
            CompactV1Json.addIntField(fields "duration" duration)
        } {
            CompactV1Json.addRawField(fields "duration" "null")
        }
        if (hasSegment) {
            def segFields:[string]
            CompactV1Json.addIntField(segFields "start" segmentStart)
            CompactV1Json.addIntField(segFields "end" segmentEnd)
            CompactV1Json.addStringField(segFields "unit" segmentUnit)
            CompactV1Json.addRawField(fields "segment" (CompactV1Json.jsonObject(segFields)))
        }
        return (CompactV1Json.jsonObject(fields))
    }
}

; One measured set: `45s`, or `30s+30s` when the two sides were timed apart.
;
; This was a JSON STRING built during the parse and pushed onto a `[string]`,
; which meant the only way to read a measured set back was to parse the
; parser's own output again. The JSON is unchanged — same fields, same order,
; same nulls — but the numbers are now readable as numbers.
;
; A `unit` of "" marks a token that did not parse. Nothing serialises such a
; node: the caller drops it and fails the whole spec, exactly as it did when
; the failure was an empty string.
class MeasuredDurationNode {
    def left:int 0
    def hasRight:boolean false
    def right:int 0
    def unit:string ""

    Constructor () {
    }

    fn toJSONString:string () {
        def mf:[string]
        CompactV1Json.addIntField(mf "left" left)
        if (hasRight) {
            CompactV1Json.addIntField(mf "right" right)
        } {
            CompactV1Json.addRawField(mf "right" "null")
        }
        CompactV1Json.addStringField(mf "unit" unit)
        return (CompactV1Json.jsonObject(mf))
    }
}

class ExerciseNode {
    Extends(AstNode)

    def name:string ""
    def hasSets:boolean false
    def sets:int 0
    def hasSetsMax:boolean false
    def setsMax:int 0
    def hasReps:boolean false
    def reps:int 0
    def hasRepsRight:boolean false
    def repsRight:int 0
    def hasRepsMax:boolean false
    def repsMax:int 0
    def hasCount:boolean false
    def count:int 0
    def hasUnit:boolean false
    def unit:string ""
    def hasWeight:boolean false
    def weightValue:int 0
    def weightUnit:string ""
    def hasWeightPercent:boolean false
    def weightPercent:int 0
    def hasWeightValueMax:boolean false
    def weightValueMax:int 0
    def hasExerciseDistance:boolean false
    def exerciseDistance:int 0
    def exerciseDistanceUnit:string "m"
    def hasNote:boolean false
    def note:string ""
    def hasDescription:boolean false
    def description:string ""
    def customFieldsJson:[string]
    def hasDistanceMin:boolean false
    def distanceMin:int 0
    def hasDistanceMax:boolean false
    def distanceMax:int 0
    def hasSpecType:boolean false
    def specType:string ""
    def partJsonList:[string]
    def measuredDurations:[MeasuredDurationNode]
    def hasIsBilateral:boolean false
    def isBilateral:boolean false
    def hasRecovery:boolean false
    def recoveryValue:int 0
    def hasRecoveryMax:boolean false
    def recoveryMax:int 0
    def recoveryUnit:string "min"

    Constructor () {
        type = "exercise"
    }

    fn toJSONString@(override):string () {
        def fields:[string]
        CompactV1Json.addStringField(fields "type" type)
        CompactV1Json.addStringField(fields "name" name)

        if (hasSets) {
            CompactV1Json.addIntField(fields "sets" sets)
        } {
            CompactV1Json.addRawField(fields "sets" "null")
        }

        if (hasSetsMax) {
            CompactV1Json.addIntField(fields "setsMax" setsMax)
        }

        if (hasReps) {
            CompactV1Json.addIntField(fields "reps" reps)
        } {
            CompactV1Json.addRawField(fields "reps" "null")
        }

        if (hasRepsRight) {
            CompactV1Json.addIntField(fields "repsRight" repsRight)
        }

        if (hasRepsMax) {
            CompactV1Json.addIntField(fields "repsMax" repsMax)
        } {
            if (hasSets) {
                CompactV1Json.addRawField(fields "repsMax" "null")
            } {
                if (hasSpecType) {
                    CompactV1Json.addRawField(fields "repsMax" "null")
                }
            }
        }

        if (hasUnit) {
            CompactV1Json.addStringField(fields "unit" unit)
        } {
            CompactV1Json.addRawField(fields "unit" "null")
        }

        if (hasWeightPercent) {
            def weightFields:[string]
            CompactV1Json.addIntField(weightFields "percent" weightPercent)
            CompactV1Json.addStringField(weightFields "of" "1RM")
            CompactV1Json.addRawField(fields "weight" (CompactV1Json.jsonObject(weightFields)))
        } {
            if (hasWeight) {
                def weightFields:[string]
                if (hasWeightValueMax) {
                    CompactV1Json.addIntField(weightFields "value" weightValue)
                    CompactV1Json.addIntField(weightFields "valueMax" weightValueMax)
                } {
                    CompactV1Json.addIntField(weightFields "value" weightValue)
                }
                CompactV1Json.addStringField(weightFields "unit" weightUnit)
                CompactV1Json.addRawField(fields "weight" (CompactV1Json.jsonObject(weightFields)))
            } {
                CompactV1Json.addRawField(fields "weight" "null")
            }
        }

        if (hasExerciseDistance) {
            CompactV1Json.addIntField(fields "distance" exerciseDistance)
            CompactV1Json.addStringField(fields "unit" exerciseDistanceUnit)
        }

        if (hasCount) {
            CompactV1Json.addIntField(fields "count" count)
        }

        if (hasSpecType) {
            CompactV1Json.addStringField(fields "specType" specType)
        }

        if (hasDistanceMin) {
            CompactV1Json.addIntField(fields "distanceMin" distanceMin)
        }
        if (hasDistanceMax) {
            CompactV1Json.addIntField(fields "distanceMax" distanceMax)
        }

        if ((array_length partJsonList) > 0) {
            CompactV1Json.addRawField(fields "parts" ("[" + (join partJsonList ",") + "]"))
        }

        if ((array_length measuredDurations) > 0) {
            CompactV1Json.addRawField(fields "measuredDurations" (CompactV1JsonExtra.measuredArray(measuredDurations)))
        }

        if (hasIsBilateral) {
            CompactV1Json.addBooleanField(fields "isBilateral" isBilateral)
        }

        if (hasRecovery) {
            def recFields:[string]
            CompactV1Json.addIntField(recFields "value" recoveryValue)
            if (hasRecoveryMax) {
                CompactV1Json.addIntField(recFields "max" recoveryMax)
            } {
                CompactV1Json.addRawField(recFields "max" "null")
            }
            CompactV1Json.addStringField(recFields "unit" recoveryUnit)
            CompactV1Json.addRawField(fields "recovery" (CompactV1Json.jsonObject(recFields)))
        } {
            CompactV1Json.addRawField(fields "recovery" "null")
        }

        if (hasNote) {
            CompactV1Json.addStringField(fields "note" note)
        } {
            CompactV1Json.addRawField(fields "note" "null")
        }

        if (hasDescription) {
            CompactV1Json.addStringField(fields "description" description)
        } {
            CompactV1Json.addRawField(fields "description" "null")
        }

        if ((array_length customFieldsJson) > 0) {
            CompactV1Json.addRawField(fields "customFields" ("[" + (join customFieldsJson ",") + "]"))
        } {
            CompactV1Json.addRawField(fields "customFields" "null")
        }

        return (CompactV1Json.jsonObject(fields))
    }
}

class IntervalNode {
    Extends(AstNode)

    def hasCount:boolean false
    def count:int 0
    def hasDistance:boolean false
    def distanceValue:int 0
    def distanceUnit:string "m"
    def hasIntensity:boolean false
    def intensityMin:int 0
    def intensityMax:int 0
    def hasRecovery:boolean false
    def recoveryValue:int 0
    def hasRecoveryMax:boolean false
    def recoveryMax:int 0
    def recoveryUnit:string "min"
    def hasIntensityText:boolean false
    def intensityText:string ""
    def hasNote:boolean false
    def note:string ""

    Constructor () {
        type = "interval"
    }

    fn toJSONString@(override):string () {
        def fields:[string]
        CompactV1Json.addStringField(fields "type" type)

        if (hasCount) {
            CompactV1Json.addIntField(fields "count" count)
        } {
            CompactV1Json.addRawField(fields "count" "null")
        }

        def distFields:[string]
        if (hasDistance) {
            CompactV1Json.addIntField(distFields "value" distanceValue)
            CompactV1Json.addStringField(distFields "unit" distanceUnit)
        } {
            CompactV1Json.addRawField(distFields "value" "null")
            CompactV1Json.addRawField(distFields "unit" "null")
        }
        CompactV1Json.addRawField(fields "distance" (CompactV1Json.jsonObject(distFields)))

        if (hasIntensity) {
            def intFields:[string]
            CompactV1Json.addIntField(intFields "min" intensityMin)
            CompactV1Json.addIntField(intFields "max" intensityMax)
            CompactV1Json.addRawField(fields "intensity" (CompactV1Json.jsonObject(intFields)))
        } {
            CompactV1Json.addRawField(fields "intensity" "null")
        }

        if (hasIntensityText) {
            CompactV1Json.addStringField(fields "intensityText" intensityText)
        }

        if (hasIntensityText) {
            if (hasNote) {
                CompactV1Json.addStringField(fields "note" note)
            } {
                CompactV1Json.addRawField(fields "note" "null")
            }
        } {
            if (hasNote) {
                CompactV1Json.addStringField(fields "note" note)
            }
        }

        if (hasRecovery) {
            def recFields:[string]
            CompactV1Json.addIntField(recFields "value" recoveryValue)
            if (hasRecoveryMax) {
                CompactV1Json.addIntField(recFields "valueMax" recoveryMax)
            }
            CompactV1Json.addStringField(recFields "unit" recoveryUnit)
            CompactV1Json.addRawField(fields "recovery" (CompactV1Json.jsonObject(recFields)))
        } {
            CompactV1Json.addRawField(fields "recovery" "null")
        }

        return (CompactV1Json.jsonObject(fields))
    }
}


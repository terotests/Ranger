class ReminderNode {
    Extends(AstNode)

    def year:int 0
    def month:int 0
    def day:int 0
    def hasDescription:boolean false
    def description:string ""

    Constructor () {
        type = "reminder"
    }

    fn toJSONString@(override):string () {
        def dateFields:[string]
        CompactV1Json.addRawField(dateFields "year" (to_string year))
        CompactV1Json.addRawField(dateFields "month" (to_string month))
        CompactV1Json.addRawField(dateFields "day" (to_string day))

        def fields:[string]
        CompactV1Json.addStringField(fields "type" type)
        CompactV1Json.addRawField(fields "date" (CompactV1Json.jsonObject(dateFields)))
        if (hasDescription) {
            CompactV1Json.addStringField(fields "description" description)
        } {
            CompactV1Json.addRawField(fields "description" "null")
        }
        return (CompactV1Json.jsonObject(fields))
    }
}


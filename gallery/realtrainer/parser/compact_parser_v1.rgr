class CompactV1JsonExtra {
    static fn nodeArray:string (values:[AstNode]) {
        def items:[string]
        for values item:AstNode i {
            push items (item.toJSONString())
        }
        return ("[" + (join items ",") + "]")
    }

    static fn measuredArray:string (values:[MeasuredDurationNode]) {
        def items:[string]
        for values item:MeasuredDurationNode i {
            push items (item.toJSONString())
        }
        return ("[" + (join items ",") + "]")
    }

    static fn workoutArray:string (values:[WorkoutNode]) {
        def items:[string]
        for values item:WorkoutNode i {
            push items (item.toJSONString())
        }
        return ("[" + (join items ",") + "]")
    }
}

class DateValueNode {
    def type:string "date"
    def year:int 0
    def month:int 0
    def day:int 0
    def unknown:boolean true
    def hasHour:boolean false
    def hour:int 0
    def hasMinute:boolean false
    def minute:int 0
    def hasTimezone:boolean false
    def timezone:string ""

    fn toJSONString:string () {
        def fields:[string]
        CompactV1Json.addStringField(fields "type" type)
        CompactV1Json.addIntField(fields "year" year)
        CompactV1Json.addIntField(fields "month" month)
        CompactV1Json.addIntField(fields "day" day)
        if (type == "date") {
            CompactV1Json.addBooleanField(fields "unknown" unknown)
        }
        if (hasHour) {
            CompactV1Json.addIntField(fields "hour" hour)
        }
        if (hasMinute) {
            CompactV1Json.addIntField(fields "minute" minute)
        }
        if (hasTimezone) {
            CompactV1Json.addStringField(fields "timezone" timezone)
        }
        return (CompactV1Json.jsonObject(fields))
    }
}

class TagsNode {
    Extends(AstNode)

    def tags:[string]

    Constructor () {
        type = "tags"
    }

    fn toJSONString@(override):string () {
        def fields:[string]
        CompactV1Json.addStringField(fields "type" type)
        CompactV1Json.addRawField(fields "tags" (CompactV1Json.stringArray(tags)))
        return (CompactV1Json.jsonObject(fields))
    }
}


class DerivedNode {
    Extends(AstNode)

    def name:string ""
    def value:int 0
    def unit:string ""
    def basis:string ""
    def hasConfidence:boolean false
    def confidence:int 0
    def source:string ""
    def hasGoodness:boolean false
    def goodness:int 0
    def hasNote:boolean false
    def note:string ""

    Constructor () {
        type = "derived"
    }

    fn toJSONString@(override):string () {
        def fields:[string]
        CompactV1Json.addStringField(fields "type" type)
        CompactV1Json.addStringField(fields "name" name)
        CompactV1Json.addIntField(fields "value" value)
        CompactV1Json.addStringField(fields "unit" unit)
        CompactV1Json.addStringField(fields "basis" basis)
        if (hasConfidence) {
            CompactV1Json.addIntField(fields "confidence" confidence)
        } {
            CompactV1Json.addRawField(fields "confidence" "null")
        }
        CompactV1Json.addStringField(fields "source" source)
        if (hasGoodness) {
            CompactV1Json.addIntField(fields "goodness" goodness)
        } {
            CompactV1Json.addRawField(fields "goodness" "null")
        }
        if (hasNote) {
            CompactV1Json.addStringField(fields "note" note)
        } {
            CompactV1Json.addRawField(fields "note" "null")
        }
        return (CompactV1Json.jsonObject(fields))
    }
}


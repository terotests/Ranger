class DurationNode {
    Extends(AstNode)

    def unit:string "min"
    def hasSingle:boolean false
    def singleValue:int 0
    def hasFloatSingle:boolean false
    def floatValueRaw:string ""
    def hasRange:boolean false
    def minValue:int 0
    def maxValue:int 0
    def hasTimeOfDay:boolean false
    def todHour:int 0
    def todMinute:int 0
    def hasDescription:boolean false
    def description:string ""

    Constructor () {
        type = "duration"
    }

    fn toJSONString@(override):string () {
        def fields:[string]
        CompactV1Json.addStringField(fields "type" type)

        if (hasTimeOfDay) {
            CompactV1Json.addRawField(fields "duration" "null")
            def todFields:[string]
            CompactV1Json.addIntField(todFields "hour" todHour)
            CompactV1Json.addIntField(todFields "minute" todMinute)
            CompactV1Json.addRawField(fields "timeOfDay" (CompactV1Json.jsonObject(todFields)))
        } {
            def durationFields:[string]
            if (hasRange) {
                def rangeFields:[string]
                CompactV1Json.addIntField(rangeFields "min" minValue)
                CompactV1Json.addIntField(rangeFields "max" maxValue)
                CompactV1Json.addRawField(durationFields "value" (CompactV1Json.jsonObject(rangeFields)))
            } {
                if (hasFloatSingle) {
                    CompactV1Json.addRawField(durationFields "value" floatValueRaw)
                } {
                    if (hasSingle) {
                        CompactV1Json.addIntField(durationFields "value" singleValue)
                    } {
                        CompactV1Json.addRawField(durationFields "value" "null")
                    }
                }
            }
            CompactV1Json.addStringField(durationFields "unit" unit)
            CompactV1Json.addRawField(fields "duration" (CompactV1Json.jsonObject(durationFields)))
        }

        if (hasDescription) {
            CompactV1Json.addStringField(fields "description" description)
        } {
            CompactV1Json.addRawField(fields "description" "null")
        }
        return (CompactV1Json.jsonObject(fields))
    }
}


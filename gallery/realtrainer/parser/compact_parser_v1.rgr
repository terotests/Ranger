class SplitNode {
    Extends(AstNode)

    def hasRecognized:boolean false
    def hasDistance:boolean false
    def distanceValue:int 0
    def distanceValueRaw:string ""
    def useDistanceRaw:boolean false
    def distanceUnit:string "m"
    def hasDuration:boolean false
    def durationValue:int 0
    def durationUnit:string "min"
    def hasPace:boolean false
    def paceMinutes:int 0
    def paceSeconds:int 0
    def pacePerDistanceValue:int 0
    def pacePerDistanceUnit:string "m"
    def hasHr:boolean false
    def hr:int 0
    def hasIntensity:boolean false
    def intensityJson:string ""
    def customFieldsJson:[string]
    def nestedSplitJsonList:[string]
    def hasNote:boolean false
    def note:string ""

    Constructor () {
        type = "split"
    }

    fn toJSONString@(override):string () {
        def fields:[string]
        CompactV1Json.addStringField(fields "type" type)

        if (hasDistance) {
            def distanceFields:[string]
            if (useDistanceRaw) {
                CompactV1Json.addRawField(distanceFields "value" distanceValueRaw)
            } {
                CompactV1Json.addIntField(distanceFields "value" distanceValue)
            }
            CompactV1Json.addStringField(distanceFields "unit" distanceUnit)
            CompactV1Json.addRawField(fields "distance" (CompactV1Json.jsonObject(distanceFields)))
        } {
            CompactV1Json.addRawField(fields "distance" "null")
        }

        if (hasDuration) {
            def durationFields:[string]
            CompactV1Json.addIntField(durationFields "value" durationValue)
            CompactV1Json.addStringField(durationFields "unit" durationUnit)
            CompactV1Json.addRawField(fields "duration" (CompactV1Json.jsonObject(durationFields)))
        } {
            CompactV1Json.addRawField(fields "duration" "null")
        }

        if (hasPace) {
            def perDistanceFields:[string]
            CompactV1Json.addIntField(perDistanceFields "value" pacePerDistanceValue)
            CompactV1Json.addStringField(perDistanceFields "unit" pacePerDistanceUnit)

            def paceFields:[string]
            CompactV1Json.addIntField(paceFields "minutes" paceMinutes)
            CompactV1Json.addIntField(paceFields "seconds" paceSeconds)
            CompactV1Json.addRawField(paceFields "perDistance" (CompactV1Json.jsonObject(perDistanceFields)))
            CompactV1Json.addRawField(fields "pace" (CompactV1Json.jsonObject(paceFields)))
        } {
            CompactV1Json.addRawField(fields "pace" "null")
        }

        if (hasIntensity) {
            CompactV1Json.addRawField(fields "intensity" intensityJson)
        } {
            CompactV1Json.addRawField(fields "intensity" "null")
        }

        if (hasHr) {
            CompactV1Json.addIntField(fields "hr" hr)
        } {
            CompactV1Json.addRawField(fields "hr" "null")
        }

        if ((array_length customFieldsJson) > 0) {
            CompactV1Json.addRawField(fields "customFields" ("[" + (join customFieldsJson ",") + "]"))
        } {
            CompactV1Json.addRawField(fields "customFields" "null")
        }

        if (hasNote) {
            CompactV1Json.addStringField(fields "note" note)
        } {
            CompactV1Json.addRawField(fields "note" "null")
        }

        if ((array_length nestedSplitJsonList) > 0) {
            CompactV1Json.addRawField(fields "splits" ("[" + (join nestedSplitJsonList ",") + "]"))
        } {
            CompactV1Json.addRawField(fields "splits" "null")
        }

        return (CompactV1Json.jsonObject(fields))
    }
}


Import "TokenDetectorV1.rgr"

class ExpenseDetectorV1 {
    Extends(TokenDetectorV1)

    fn detect:LineKindValue (line:string) {
        def out (new LineKindValue)
        out.raw = line
        if (this.startsWith(line "Expense ")) {
            out.tag = "expense"
        }
        return out
    }
}

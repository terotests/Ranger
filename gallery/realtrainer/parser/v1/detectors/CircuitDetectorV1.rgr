Import "TokenDetectorV1.rgr"

class CircuitDetectorV1 {
    Extends(TokenDetectorV1)

    fn detect:LineKindValue (line:string) {
        def out (new LineKindValue)
        out.raw = line
        if (this.startsWith(line "Circuit|")) {
            out.tag = "circuit"
        } {
            if (this.startsWith(line "Superset|")) {
                out.tag = "circuit"
            }
        }
        return out
    }
}

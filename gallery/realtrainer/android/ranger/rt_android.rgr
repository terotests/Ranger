; ==============================================================================
; rt_android.rgr — RtAndroid
; ==============================================================================
;
; The name the Kotlin host imports, and nothing else. Everything this class
; can do is `RtHost` — see `../../src/RtHost.rgr`, which says why the iOS and
; Android facades are one file now. Android never calls `setSafeArea`: an
; Activity's content view already sits inside the system bars, so the insets
; stay zero and every conversion in `RtHost` is the identity it used to be
; written out as.

Import "../../src/RtHost.rgr"

class RtAndroid extends RtHost {
}

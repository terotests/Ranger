    ; The clamps are what a stepper is FOR: a set count of zero and a negative
    ; weight are not states this screen can reach. `step` carries the size, so
    ; weight moves five at a time and reps one.
    sfn nudge:void (row:CompactRow field:string delta:int) {
        match row {
            Exercise ex {
                def e:ExerciseSpec (unwrap ex.spec)
                if (field == "sets") {
                    def next:int (e.sets + delta)
                    if (next >= 1) {
                        if (next <= 10) {
                            e.sets = next
                            e.hasSets = true
                        }
                    }
                }
                if (field == "reps") {
                    def next:int (e.reps + delta)
                    if (next >= 1) {
                        if (next <= 30) {
                            e.reps = next
                            e.hasReps = true
                        }
                    }
                }
                if (field == "weight") {
                    def next:int (e.weightKg + delta)
                    if (next >= 0) {
                        if (next <= 200) {
                            e.weightKg = next
                            e.hasWeight = (next > 0)
                        }
                    }
                }
            }
            Move mv {
            }
            Pyramid py {
            }
            Split sp {
            }
            Section s {
            }
            Text t {
            }
            Summary sm {
            }
            Phase ph {
            }
            Custom cu {
            }
            Duration du {
            }
            Unknown un {
            }
        }
    }

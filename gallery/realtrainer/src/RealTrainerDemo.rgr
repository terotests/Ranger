    }

    fn phoneHeader:EVGElement () {
        def head (tree Rt (PhHead))
        def credits (tree Rt (PhCredits))
        def gauge (tree Rt (PhIcon))
        gauge.svgSource = (RtIcons.battery("#22c55e"))
        credits.addChild(gauge)
        credits.addChild((tree Rt (PhCreditsTx "100k credits")))
        head.addChild(credits)
        def sel (tree Rt (PhCalSel))
        sel.a11yLabel = ("📋 " + seed.calendarName)
        sel.addChild((tree Rt (PhCalEmoji "📋")))
        sel.addChild((tree Rt (PhCalTx seed.calendarName)))
        def down (tree Rt (PhIcon (props (className "rt-ph-icon rt-ph-icon-sm"))))
        down.svgSource = (RtIcons.chevronDown("#999999"))
        sel.addChild(down)
        head.addChild(sel)
        if ((this.isPortrait()) == false) {
            head.addChild((tree Rt (PhPct "50%")))
        }
        head.addChild((tree Rt (PhAvatar (PhAvatarTx "T"))))
        return head

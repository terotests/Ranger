; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; RealTrainerDemo — a three-scene app on the GPU
; =============================================================================
; A loading screen, the page it hands over to, and the dashboard behind that.
; Every scene is an EVG tree painted by the WebGL painter in `gallery/evg/gl`,
; and the controls on the last two are `gallery/ui`'s own components — the
; ones the conformance harness measures against Radix — rather than boxes
; drawn to look like them.
;
; --- WHAT IS THE LIBRARY'S AND WHAT IS THIS APP'S -----------------------------
;
;   ProgressCtl     the loading bar. It owns the value, the percentage
;                   arithmetic and the `progressbar` row a reader is given.
;   CheckboxCtl     "muista minut", with Radix's tri-state machine behind it
;   CollapsibleCtl  the tips the sign-in page hides until they are asked for
;   TabsCtl         the dashboard's three sections, with its roving focus
;   TableCtl        the goals table's sorting — three clicks per column, and
;                   the third is back to the order the data arrived in
;   ToggleCtl       the filter above that table
;   AccordionCtl    the training plans, one open at a time
;
; A controller owns a subtree and mutates it in place; the app parents that
; subtree wherever it wants and the STYLESHEET decides what it looks like.
; Nothing here re-implements a control, and nothing here names a colour twice:
; the `ui-*` classes are themed once, in `web/realtrainer.css`, in this app's
; own dark palette rather than the library's pale default.
;
; What is this app's own is layout — flex rows, flex columns, one CSS grid for
; the calendar — and the two things that make it look like a product rather
; than a control gallery: the cards, and the loader's ring.
;
; --- THE CLOCK IS IN HERE, NOT IN THE PAGE ------------------------------------
;
; `tick(dtMs)` is the whole animation: it advances an elapsed-time counter, and
; the progress, the ring's angle and the scene change are read off that one
; number. The browser host hands over the REAL time between two frames and
; paints what comes back, which is what lets the headless check drive the same
; app with a made-up clock and assert on the same picture. An app whose
; animation lives in its JavaScript host has two versions of itself.
;
; --- WHY THE TREE IS KEPT AND NOT REBUILT -------------------------------------
;
; Per-frame values — the ring's angle, the bar's value, the caption — are
; written onto the elements that are already there. A rebuild per frame would
; work for the bar and would break the button: `transition` is a memory an
; ELEMENT holds, and a tree rebuilt sixty times a second has a different
; element in every position with nothing to remember. Same reason `MotionDemo`
; keeps its tree. A press does not rebuild either — it asks the controller to
; rebuild ITS subtree, which is the whole point of a controller that mutates.
;
; The SCENE change does rebuild, because that genuinely is a different page.
;
; --- THE RING -----------------------------------------------------------------
;
; Twelve blades stacked in one grid cell, each turned about a point 54px below
; its own top edge — the middle of the cell. EVG has no `position: absolute`,
; and a one-cell grid is the layout that lets children share a rectangle.
; That is the arrangement; the motion is the CONTAINER's rotation, set once per
; frame, which `EVGDisplayList` composes onto every command the subtree
; emitted. Twelve commands, one angle, no per-blade arithmetic on the host.
;
; --- WHAT IS NOT HERE ---------------------------------------------------------
;
; No account, no network and no credentials: the button moves to the next
; scene. This is a rendering demo, and a sign-in flow that pretended to be real
; would be the wrong kind of convincing.
; =============================================================================

Import "../../ui/src/PresentationCtl.rgr"
Import "../../ui/src/CheckboxCtl.rgr"
Import "../../ui/src/CollapsibleCtl.rgr"
Import "../../ui/src/TabsCtl.rgr"
Import "../../ui/src/TableCtl.rgr"
Import "../../ui/src/ToggleCtl.rgr"
Import "../../ui/src/AccordionCtl.rgr"
Import "../../ui/src/RadioGroupCtl.rgr"
Import "../../evg/EVGElement.rgr"
Import "../../evg/EVGUnit.rgr"
Import "../../evg/EVGLayout.rgr"
Import "../../evg/EVGDisplayList.rgr"
Import "../../evg/EVGStyleSheet.rgr"
Import "../../evg/EVGTransition.rgr"
Import "../../evg/EVGA11yTree.rgr"
Import "../../evg/EVGA11yFromTree.rgr"
Import "../../evg/EVGHitTest.rgr"
Import "CompactRows.rgr"
Import "AddWorkoutDialog.rgr"
Import "PlanDialogHost.rgr"
Import "ChatHost.rgr"
Import "RtCalendar.rgr"
Import "CalendarWizard.rgr"
Import "RtYearSheet.rgr"
Import "../../ui/src/SelectCtl.rgr"
Import "../../ui/src/NumberCtl.rgr"
Import "../../ui/src/InputCtl.rgr"

treefactory Rt {
    child addChild
    text  textContent

    tag Page     EVGElement (props (className "rt-page"))
    tag Col      EVGElement (props (className "rt-col"))
    tag Row      EVGElement (props (className "rt-row"))

    ; --- scene one: the loader -----------------------------------------------
    tag Card     EVGElement (props (className "rt-card") (role "region") (a11yLabel "RealTrainer"))
    tag Ring     EVGElement (props (className "rt-ring") (id "rt-ring") (role "img") (a11yLabel "Ladataan"))
    tag Blade    EVGElement (props (className "rt-blade") (a11yHidden true))
    tag Word     EVGElement (props (className "rt-word"))
    tag WordA    EVGElement (props (className "rt-word-a") (elementType 1))
    tag WordB    EVGElement (props (className "rt-word-b") (elementType 1))
    tag Tagline  EVGElement (props (className "rt-tag") (elementType 1))
    tag Caption  EVGElement (props (className "rt-caption") (id "rt-caption") (elementType 1))
    tag Pct      EVGElement (props (className "rt-pct") (id "rt-pct") (elementType 1))

    ; --- scene two: the sign-in page -----------------------------------------
    tag Brand    EVGElement (props (className "rt-brand") (id "rt-brand") (elementType 1) (role "heading") (a11yLevel 1))
    tag Panel    EVGElement (props (className "rt-panel") (role "region") (a11yLabel "Kirjautuminen"))
    tag Feats    EVGElement (props (className "rt-feats") (id "rt-feats") (role "list") (a11yLabel "Mitä sovellus osaa"))
    tag Feat     EVGElement (props (className "rt-feat") (role "listitem"))
    tag Badge    EVGElement (props (className "rt-badge") (a11yHidden true))
    tag Icon     EVGElement (props (className "rt-icon") (tagName "path"))
    tag FeatText EVGElement (props (className "rt-feat-text"))
    tag FeatHead EVGElement (props (className "rt-feat-head"))
    tag Strong   EVGElement (props (className "rt-strong") (elementType 1))
    tag Rest     EVGElement (props (className "rt-rest") (elementType 1))
    tag Chip     EVGElement (props (className "rt-chip"))
    tag ChipText EVGElement (props (className "rt-chip-text") (elementType 1))
    tag Note     EVGElement (props (className "rt-note") (elementType 1))
    tag Google   EVGElement (props (className "rt-google") (id "rt-google") (role "button")
                                   (a11yLabel "Jatka Googlella") (a11yFocusable true))
    tag GMark    EVGElement (props (className "rt-gmark") (a11yHidden true))
    tag GMarkTx  EVGElement (props (className "rt-gmark-text") (elementType 1))
    tag GoogleTx EVGElement (props (className "rt-google-text") (elementType 1))
    tag Foot     EVGElement (props (className "rt-foot") (elementType 1))

    ; --- scene three: the dashboard ------------------------------------------
    tag App      EVGElement (props (className "rt-app"))
    tag Rail     EVGElement (props (className "rt-rail") (id "rt-rail") (role "navigation") (a11yLabel "Osiot"))
    tag RailBtn  EVGElement (props (className "rt-rail-btn") (role "button") (a11yFocusable true))
    tag Main     EVGElement (props (className "rt-main"))
    tag Top      EVGElement (props (className "rt-top"))
    tag Title    EVGElement (props (className "rt-title") (id "rt-title") (elementType 1) (role "heading") (a11yLevel 1))
    tag Spacer   EVGElement (props (className "rt-spacer"))
    ; A heading needs an id of its own: an element without one is named by its
    ; PATH, and two headings that hang off the same named ancestor at the same
    ; index are then the same node as far as a reader is concerned — which the
    ; a11y lint says out loud.
    tag Section  EVGElement (props (className "rt-section") (elementType 1) (role "heading") (a11yLevel 2))
    tag PlanCard EVGElement (props (className "rt-plan"))
    tag PlanName EVGElement (props (className "rt-plan-name") (elementType 1))
    tag PlanDesc EVGElement (props (className "rt-plan-desc") (elementType 1))
    tag PlanWhen EVGElement (props (className "rt-plan-when") (elementType 1))
    tag Notice   EVGElement (props (className "rt-notice") (id "rt-notice") (role "status"))
    tag NoticeHd EVGElement (props (className "rt-notice-head") (elementType 1))
    tag NoticeTx EVGElement (props (className "rt-notice-text") (elementType 1))
    tag Table    EVGElement (props (className "rt-table") (role "table") (a11yLabel "Tavoitteet"))
    tag HeadRow  EVGElement (props (className "rt-thead") (role "row"))
    tag Th       EVGElement (props (className "rt-th") (role "columnheader") (a11yFocusable true))
    tag ThText   EVGElement (props (className "rt-th-text") (elementType 1))
    tag Body     EVGElement (props (className "rt-tbody") (id "rt-goals-body") (role "rowgroup"))
    tag Tr       EVGElement (props (className "rt-tr") (role "row"))
    tag Td       EVGElement (props (className "rt-td") (role "cell") (elementType 1))
    tag TdDim    EVGElement (props (className "rt-td-dim") (role "cell") (elementType 1))
    tag Dot      EVGElement (props (className "rt-dot") (a11yHidden true))
    tag Cal      EVGElement (props (className "rt-cal") (id "rt-cal") (role "grid") (a11yLabel "Harjoituskalenteri"))
    tag CalHead  EVGElement (props (className "rt-cal-head") (elementType 1) (role "columnheader"))
    tag CalDay   EVGElement (props (className "rt-cal-day") (role "gridcell"))
    tag CalNum   EVGElement (props (className "rt-cal-num") (elementType 1))
    tag CalMark  EVGElement (props (className "rt-cal-mark") (a11yHidden true))

    ; --- scene four: one training session ------------------------------------
    tag WorkTop  EVGElement (props (className "rt-work-top"))
    tag WorkName EVGElement (props (className "rt-work-name") (elementType 1) (role "heading") (a11yLevel 1))
    tag WorkSub  EVGElement (props (className "rt-work-sub") (id "rt-work-sub") (elementType 1))
    tag Quit     EVGElement (props (className "rt-quit") (id "rt-quit") (role "button")
                                   (a11yLabel "Keskeytä harjoitus") (a11yFocusable true))
    tag QuitTx   EVGElement (props (className "rt-quit-text") (elementType 1))
    tag Move     EVGElement (props (className "rt-move"))
    tag MoveHead EVGElement (props (className "rt-move-head"))
    tag MoveName EVGElement (props (className "rt-move-name") (elementType 1))
    ; The spec line is a ROW of runs and not one string: the parts a
    ; CompactStatBuilder returns carry a tone each, and `3x5` and `x90kg` are
    ; drawn differently on purpose.
    tag MovePlan EVGElement (props (className "rt-move-plan") (id "rt-move-plan"))
    tag StatTx   EVGElement (props (className "rt-stat") (elementType 1))
    tag MoveWhere EVGElement (props (className "rt-move-where") (elementType 1))

    ; --- scene five: the document ---------------------------------------------
    ; Every row of the parsed workout, drawn by its family. This is the row
    ; library with nothing else on top of it.
    ; The viewport is a CLIPPED box with a scroll offset on it, which is all
    ; EVG needs: the layout clamps the offset against the content it measured
    ; and translates the subtree. There is no scrollbar, because a canvas app
    ; that draws one has to make it work, and a document this long does not
    ; need one to be readable.
    ; --- the add-workout dialog ----------------------------------------------
    tag Sheet    EVGElement (props (className "rt-sheet") (id "rt-sheet")
                                   (role "dialog") (a11yLabel "Lisää harjoitus"))
    tag SheetHd  EVGElement (props (className "rt-sheet-head") (elementType 1)
                                   (role "heading") (a11yLevel 2) (id "rt-sheet-head"))
    tag SheetRow EVGElement (props (className "rt-sheet-row"))
    tag SheetCap EVGElement (props (className "rt-sheet-cap") (elementType 1))
    tag SheetVal EVGElement (props (className "rt-sheet-val") (elementType 1))
    tag SheetErr EVGElement (props (className "rt-sheet-err") (elementType 1) (role "status")
                                   (id "rt-sheet-err"))
    tag SheetBtn EVGElement (props (className "rt-sheet-btn") (role "button") (a11yFocusable true))
    tag SheetBtnTx EVGElement (props (className "rt-sheet-btn-text") (elementType 1))
    tag AddBtn   EVGElement (props (className "rt-add") (id "rt-add") (role "button")
                                   (a11yLabel "Lisää harjoitus") (a11yFocusable true))
    tag AddTx    EVGElement (props (className "rt-add-text") (elementType 1))

    ; --- the plan-week dialog ------------------------------------------------
    ; Drawn from `PlanDialogHost`'s machine state and nothing else, the way the
    ; add-workout sheet is drawn from its machine. The same sheet classes, so
    ; the two dialogs are one dialog in the stylesheet.
    tag PlanBtn  EVGElement (props (className "rt-add") (id "rt-plan") (role "button")
                                   (a11yLabel "Suunnittele viikko") (a11yFocusable true))
    tag PlanSheet EVGElement (props (className "rt-sheet rt-plan-sheet") (id "rt-plan-sheet")
                                   (role "dialog") (a11yLabel "Suunnittele viikko"))
    tag PlanHd   EVGElement (props (className "rt-sheet-head") (elementType 1)
                                   (role "heading") (a11yLevel 2) (id "rt-plan-head"))
    tag PlanErr  EVGElement (props (className "rt-sheet-err") (elementType 1) (role "status")
                                   (id "rt-plan-err"))
    tag PlanDays EVGElement (props (className "rt-plan-days") (id "rt-plan-days")
                                   (role "list") (a11yLabel "Viikon päivät"))
    tag PlanDay  EVGElement (props (className "rt-plan-day") (role "listitem"))
    tag PlanDayName EVGElement (props (className "rt-plan-day-name") (elementType 1))
    tag PlanDayNote EVGElement (props (className "rt-plan-day-note") (elementType 1))

    ; --- scene six: the conversation -------------------------------------------
    ; Drawn from `ChatHost`'s machine state: the transcript, what is streaming
    ; in, the actions a reply proposes and where each of them stands.
    tag ChatLog  EVGElement (props (className "rt-chat-log") (id "rt-chat-log")
                                   (role "list") (a11yLabel "Keskustelu"))
    tag ChatUser EVGElement (props (className "rt-chat-user") (role "listitem"))
    tag ChatBot  EVGElement (props (className "rt-chat-bot") (role "listitem"))
    tag ChatTx   EVGElement (props (className "rt-chat-text") (elementType 1))
    tag ChatStream EVGElement (props (className "rt-chat-bot rt-chat-stream") (id "rt-chat-stream")
                                   (role "status"))
    tag ChatActs EVGElement (props (className "rt-chat-acts") (id "rt-chat-acts")
                                   (role "list") (a11yLabel "Ehdotetut toiminnot"))
    tag ChatAct  EVGElement (props (className "rt-chat-act") (role "listitem"))
    tag ChatActTx EVGElement (props (className "rt-chat-act-text") (elementType 1))
    tag ChatActSt EVGElement (props (className "rt-chat-act-state") (elementType 1))
    tag ChatBox  EVGElement (props (className "rt-sheet rt-chat-box") (id "rt-chat-box")
                                   (role "region") (a11yLabel "Viesti"))

    ; --- the shell as the original draws it ----------------------------------
    ; A phone: a header, the section, a bar of five at the bottom. Turned on
    ; its side, or on a desk: the icon rail down the left instead. These are
    ; `MobileHeader`, `MobileBottomNav` and `IconNav` in the original, and the
    ; roles and names here are theirs.
    tag Phone    EVGElement (props (className "rt-phone") (id "rt-page"))
    tag PhHead   EVGElement (props (className "rt-ph-head") (id "rt-ph-head") (role "banner"))
    tag PhCredits EVGElement (props (className "rt-ph-credits") (id "rt-credits") (role "button")
                                   (a11yLabel "AI Credits: 100k. Click to purchase more credits.") (a11yFocusable true))
    tag PhCreditsTx EVGElement (props (className "rt-ph-credits-text") (elementType 1))
    tag PhCalSel EVGElement (props (className "rt-ph-calsel") (id "rt-calsel") (role "button") (a11yFocusable true))
    tag PhCalTx  EVGElement (props (className "rt-ph-calsel-text") (elementType 1))
    tag PhCalEmoji EVGElement (props (className "rt-ph-calsel-emoji") (elementType 1))
    tag PhAvatar EVGElement (props (className "rt-ph-avatar"))
    tag PhAvatarTx EVGElement (props (className "rt-ph-avatar-text") (elementType 1))
    tag PhMain   EVGElement (props (className "rt-ph-main") (id "rt-ph-main") (role "main"))
    tag PhBody   EVGElement (props (className "rt-ph-body") (id "rt-ph-body"))
    tag PhNav    EVGElement (props (className "rt-ph-nav") (id "rt-ph-nav") (role "navigation"))
    tag PhNavItem EVGElement (props (className "rt-ph-nav-item") (role "button") (a11yFocusable true))
    tag PhNavTx  EVGElement (props (className "rt-ph-nav-text") (elementType 1))
    tag PhIcon   EVGElement (props (className "rt-ph-icon") (tagName "path"))
    tag PhRail   EVGElement (props (className "rt-ph-rail") (id "rt-ph-rail") (role "navigation"))
    tag PhRailBtn EVGElement (props (className "rt-ph-rail-btn") (role "button") (a11yFocusable true))
    tag PhRailGap EVGElement (props (className "rt-ph-rail-gap"))
    tag PhSide   EVGElement (props (className "rt-ph-side"))
    tag PhPct    EVGElement (props (className "rt-ph-pct") (elementType 1))
    ; Where the toasts land. Empty until one does, and a landmark all the same
    ; — the original's toaster is on every screen.
    tag PhToasts EVGElement (props (className "rt-ph-toasts") (id "rt-toasts") (role "region")
                                   (a11yLabel "Notifications alt+T"))

    ; --- the calendar: MobileWeekView, and ExampleWeekPanel ------------------
    tag CalActions EVGElement (props (className "rt-cal-actions"))
    tag CalBtn   EVGElement (props (className "rt-cal-btn") (role "button") (a11yFocusable true))
    tag CalBtnTx EVGElement (props (className "rt-cal-btn-text") (elementType 1))
    tag CalTabs  EVGElement (props (className "rt-cal-tabs"))
    tag CalTab   EVGElement (props (className "rt-cal-tab") (role "button") (a11yFocusable true))
    tag CalTabTx EVGElement (props (className "rt-cal-tab-text") (elementType 1))
    tag CalTabBar EVGElement (props (className "rt-cal-tab-bar") (a11yHidden true))
    tag WeekHead EVGElement (props (className "rt-week-head"))
    tag WeekNavBtn EVGElement (props (className "rt-week-nav") (role "button") (a11yFocusable true))
    tag WeekMid  EVGElement (props (className "rt-week-mid"))
    tag WeekTitleBtn EVGElement (props (className "rt-week-title") (id "rt-week-today") (role "button") (a11yFocusable true))
    tag WeekNo   EVGElement (props (className "rt-week-no") (elementType 1))
    tag WeekRange EVGElement (props (className "rt-week-range") (elementType 1))
    tag WeekPill EVGElement (props (className "rt-week-pill") (id "rt-plan-create") (role "button")
                                   (a11yLabel "Luo suunnitelma") (a11yFocusable true))
    tag WeekPillTx EVGElement (props (className "rt-week-pill-text") (elementType 1))
    tag DayRows  EVGElement (props (className "rt-day-rows"))
    tag DayRow   EVGElement (props (className "rt-day-row") (role "button") (a11yFocusable true))
    tag DayNum   EVGElement (props (className "rt-day-num"))
    tag DayNumTx EVGElement (props (className "rt-day-num-text") (elementType 1))
    tag DayCol   EVGElement (props (className "rt-day-col"))
    tag DayName  EVGElement (props (className "rt-day-name") (elementType 1))
    tag DayTitle EVGElement (props (className "rt-day-title") (elementType 1))
    tag DayTags  EVGElement (props (className "rt-day-tags") (elementType 1))
    tag DayDash  EVGElement (props (className "rt-day-dash") (elementType 1))
    tag ExPanel  EVGElement (props (className "rt-ex-panel"))
    tag ExHead   EVGElement (props (className "rt-ex-head") (id "rt-ex-head") (elementType 1)
                                   (role "heading") (a11yLevel 3))
    tag ExSub    EVGElement (props (className "rt-ex-sub") (elementType 1))
    tag ExBtns   EVGElement (props (className "rt-ex-btns"))
    tag ExBtn    EVGElement (props (className "rt-ex-btn") (role "button") (a11yFocusable true))
    tag ExBtnTx  EVGElement (props (className "rt-ex-btn-text") (elementType 1))
    tag ExSeg    EVGElement (props (className "rt-ex-seg"))
    tag ExSegBtn EVGElement (props (className "rt-ex-seg-btn") (role "button") (a11yFocusable true))
    tag ExSegTx  EVGElement (props (className "rt-ex-seg-text") (elementType 1))
    tag ExDays   EVGElement (props (className "rt-ex-days"))
    tag ExDay    EVGElement (props (className "rt-ex-day"))
    tag ExDayName EVGElement (props (className "rt-ex-day-name") (elementType 1))
    tag ExDayBody EVGElement (props (className "rt-ex-day-body"))
    tag ExDayTitle EVGElement (props (className "rt-ex-day-title") (elementType 1))
    tag ExDayTags EVGElement (props (className "rt-ex-day-tags") (elementType 1))
    tag ExDayLine EVGElement (props (className "rt-ex-day-line") (elementType 1))

    ; --- a text field, and the dialogs the original draws ---------------------
    tag Field    EVGElement (props (className "rt-field") (role "textbox") (a11yFocusable true))
    tag FieldText EVGElement (props (className "rt-field-text") (elementType 1))
    tag FieldGhost EVGElement (props (className "rt-field-ghost") (elementType 1))
    tag FieldCaret EVGElement (props (className "rt-field-caret") (a11yHidden true))
    tag Overlay  EVGElement (props (className "rt-overlay"))
    tag Modal    EVGElement (props (className "rt-modal"))
    tag ModalHead EVGElement (props (className "rt-modal-head"))
    tag ModalTitle EVGElement (props (className "rt-modal-title") (elementType 1) (role "heading"))
    tag ModalBody EVGElement (props (className "rt-modal-body"))
    tag ModalRow EVGElement (props (className "rt-modal-row"))
    tag ModalTx  EVGElement (props (className "rt-modal-text") (elementType 1))
    tag ModalPara EVGElement (props (className "rt-modal-para") (elementType 1) (role "paragraph"))
    tag ModalDim EVGElement (props (className "rt-modal-dim") (elementType 1))
    tag IconBtn  EVGElement (props (className "rt-icon-btn") (role "button") (a11yFocusable true))
    tag ModalFoot EVGElement (props (className "rt-modal-foot"))
    tag ChatHd   EVGElement (props (className "rt-chat-hd") (id "rt-chat-hd") (elementType 1) (role "heading") (a11yLevel 2))
    tag ChatTools EVGElement (props (className "rt-chat-tools"))
    tag ChatTool EVGElement (props (className "rt-chat-tool") (role "button") (a11yFocusable true))
    tag ChatToolTx EVGElement (props (className "rt-chat-tool-text") (elementType 1))
    tag ChatPara EVGElement (props (className "rt-chat-para") (elementType 1) (role "paragraph"))
    tag ChatCompose EVGElement (props (className "rt-chat-compose"))
    ; A message and the buttons beside it, as `DiaryChatMessageItem` has them.
    tag MsgRow   EVGElement (props (className "rt-msg-row"))
    ; The bottom sheet the bar's "Lisää" opens, and its rows.
    tag MoreSheet EVGElement (props (className "rt-modal rt-more-sheet") (id "rt-more-sheet"))
    tag MoreItem EVGElement (props (className "rt-more-item") (role "button") (a11yFocusable true))
    tag MoreItemTx EVGElement (props (className "rt-more-item-text") (elementType 1))
    ; The phone's dashboard: the page heading, the plan card, the period card.
    tag DashHd   EVGElement (props (className "rt-dash-hd") (elementType 1) (role "heading") (a11yLevel 1))
    tag DashH2   EVGElement (props (className "rt-dash-h2") (elementType 1) (role "heading") (a11yLevel 2))
    tag DashH3   EVGElement (props (className "rt-dash-h3") (elementType 1) (role "heading") (a11yLevel 3))
    tag DashPara EVGElement (props (className "rt-dash-para") (elementType 1) (role "paragraph"))
    tag DashCard EVGElement (props (className "rt-dash-card"))
    tag DashMeta EVGElement (props (className "rt-dash-meta") (elementType 1))
    ; The home screen's quick entry: the original's box is a contenteditable
    ; the tree reports as text, so this one is a box with the placeholder in
    ; it and no textbox role.
    tag HomeBox  EVGElement (props (className "rt-field rt-home-box"))
    ; One day of the edit sheet: the drag handle, the day's text, the
    ; checkbox, the three buttons and the day's own field.
    tag EditDay  EVGElement (props (className "rt-edit-day"))
    tag EditDayTx EVGElement (props (className "rt-edit-day-text") (elementType 1))
    ; The calendar wizard — a page of its own, `fixed inset-0`: header with
    ; the step dots, the step's body, the footer with the two buttons.
    tag Wiz      EVGElement (props (className "rt-wiz") (id "rt-page"))
    tag WizHead  EVGElement (props (className "rt-wiz-head"))
    tag WizHd    EVGElement (props (className "rt-wiz-hd") (elementType 1) (role "heading") (a11yLevel 1))
    tag WizH2    EVGElement (props (className "rt-wiz-h2") (elementType 1) (role "heading") (a11yLevel 2))
    tag WizPara  EVGElement (props (className "rt-wiz-para") (elementType 1) (role "paragraph"))
    tag WizTx    EVGElement (props (className "rt-wiz-text") (elementType 1))
    tag WizLabel EVGElement (props (className "rt-wiz-label") (elementType 1))
    tag WizDots  EVGElement (props (className "rt-wiz-dots") (a11yHidden true))
    tag WizDot   EVGElement (props (className "rt-wiz-dot"))
    tag WizBody  EVGElement (props (className "rt-wiz-body") (id "rt-wiz-body"))
    tag WizCenter EVGElement (props (className "rt-wiz-center"))
    tag WizGrid  EVGElement (props (className "rt-wiz-grid"))
    tag WizCard  EVGElement (props (className "rt-wiz-card") (role "button") (a11yFocusable true))
    tag WizCardTitle EVGElement (props (className "rt-wiz-card-title") (elementType 1))
    tag WizCardDesc EVGElement (props (className "rt-wiz-card-desc") (elementType 1))
    tag WizIcon  EVGElement (props (className "rt-wiz-icon") (tagName "path"))
    tag WizBadge EVGElement (props (className "rt-wiz-badge"))
    tag WizBox   EVGElement (props (className "rt-wiz-box"))
    tag WizSwitch EVGElement (props (className "rt-wiz-switch"))
    tag WizKnob  EVGElement (props (className "rt-wiz-knob"))
    tag WizBars  EVGElement (props (className "rt-wiz-bars"))
    tag WizBar   EVGElement (props (className "rt-wiz-bar"))
    tag WizSwatch EVGElement (props (className "rt-wiz-swatch") (role "button") (a11yFocusable true))
    tag WizVis   EVGElement (props (className "rt-wiz-vis") (role "button") (a11yFocusable true))
    tag WizFoot  EVGElement (props (className "rt-wiz-foot"))
    tag WizBtn   EVGElement (props (className "rt-wiz-btn") (role "button") (a11yFocusable true))
    tag WizBtnTx EVGElement (props (className "rt-wiz-btn-text") (elementType 1))
    ; The year sheet page: its header, the cards, the toolbar, the grid,
    ; the legend, the periods and their example weeks.
    tag YsHead   EVGElement (props (className "rt-ys-head"))
    tag YsHd     EVGElement (props (className "rt-ys-hd") (elementType 1) (role "heading") (a11yLevel 1))
    tag YsH3     EVGElement (props (className "rt-ys-h3") (elementType 1) (role "heading") (a11yLevel 3))
    tag YsPara   EVGElement (props (className "rt-ys-para") (elementType 1) (role "paragraph"))
    tag YsTx     EVGElement (props (className "rt-ys-text") (elementType 1))
    tag YsDim    EVGElement (props (className "rt-ys-dim") (elementType 1))
    tag YsStrong EVGElement (props (className "rt-ys-strong") (elementType 1))
    tag YsCard   EVGElement (props (className "rt-ys-card"))
    tag YsCardBtn EVGElement (props (className "rt-ys-card-btn") (role "button") (a11yFocusable true))
    tag YsTools  EVGElement (props (className "rt-ys-tools"))
    tag YsToolBtn EVGElement (props (className "rt-ys-tool") (role "button") (a11yFocusable true))
    tag YsToolTx EVGElement (props (className "rt-ys-tool-text") (elementType 1))
    tag YsPanel  EVGElement (props (className "rt-ys-panel"))
    tag YsGrid   EVGElement (props (className "rt-ys-grid"))
    tag YsGridRow EVGElement (props (className "rt-ys-grid-row"))
    tag YsCell   EVGElement (props (className "rt-ys-cell"))
    tag YsCellTx EVGElement (props (className "rt-ys-cell-text") (elementType 1))
    tag YsLegend EVGElement (props (className "rt-ys-legend"))
    tag YsSwatch EVGElement (props (className "rt-ys-swatch") (a11yHidden true))
    tag YsPeriod EVGElement (props (className "rt-ys-period"))
    tag YsPeriodBtn EVGElement (props (className "rt-ys-period-btn") (role "button") (a11yFocusable true))
    tag YsEditRow EVGElement (props (className "rt-ys-edit-row"))
    ; A number field: a text field — `NumberCtl` measured Base UI's, and it
    ; is not a spinbutton — its value, and the two steps beside it.
    tag YsNum    EVGElement (props (className "rt-ys-num") (role "textbox") (a11yFocusable true))
    tag YsNumTx  EVGElement (props (className "rt-ys-num-text") (elementType 1))
    ; A toast, in the toaster's landmark: a list with one item, as sonner has it.
    tag Toast    EVGElement (props (className "rt-toast") (role "list"))
    tag ToastItem EVGElement (props (className "rt-toast-item") (role "listitem"))
    tag ToastTx  EVGElement (props (className "rt-toast-text") (elementType 1))

    tag DocView  EVGElement (props (className "rt-doc-view") (id "rt-doc-view"))
    tag DocList  EVGElement (props (className "rt-doc-list") (id "rt-doc-list")
                                   (role "list") (a11yLabel "Harjoituksen rivit"))
    tag DocRow   EVGElement (props (className "rt-doc-row") (role "listitem"))
    tag DocHead  EVGElement (props (className "rt-doc-head") (role "listitem"))
    tag DocLabel EVGElement (props (className "rt-doc-label") (elementType 1))
    tag DocParts EVGElement (props (className "rt-doc-parts"))
    tag Steps    EVGElement (props (className "rt-steps"))
    tag Step     EVGElement (props (className "rt-step"))
    tag StepCap  EVGElement (props (className "rt-step-cap") (elementType 1))
    tag StepRow  EVGElement (props (className "rt-step-row"))
    tag StepBtn  EVGElement (props (className "rt-step-btn") (role "button") (a11yFocusable true))
    tag StepBtnTx EVGElement (props (className "rt-step-btn-text") (elementType 1) (a11yHidden true))
    tag StepVal  EVGElement (props (className "rt-step-val") (elementType 1))
    tag Times    EVGElement (props (className "rt-times") (elementType 1) (a11yHidden true))
    tag RestRow  EVGElement (props (className "rt-rest-row"))
    tag RestCap  EVGElement (props (className "rt-rest-cap") (elementType 1))
    tag Actions  EVGElement (props (className "rt-actions"))
    tag Start    EVGElement (props (className "rt-start") (id "rt-start") (role "button")
                                   (a11yLabel "Aloita sarjat") (a11yFocusable true))
    tag StartTx  EVGElement (props (className "rt-start-text") (elementType 1))
    tag SaveBtn  EVGElement (props (className "rt-save") (id "rt-save") (role "button")
                                   (a11yLabel "Tallenna liike") (a11yFocusable true))
    tag SaveTx   EVGElement (props (className "rt-save-text") (elementType 1))
    tag SaveState EVGElement (props (className "rt-save-state") (elementType 1) (role "status"))
    tag FailBtn  EVGElement (props (className "rt-fail") (id "rt-fail") (role "button")
                                   (a11yLabel "Kaada seuraava tallennus") (a11yFocusable true))
    tag FailTx   EVGElement (props (className "rt-fail-text") (elementType 1))
    tag DoneBtn  EVGElement (props (className "rt-done") (id "rt-done") (role "button")
                                   (a11yLabel "Merkitse liike tehdyksi") (a11yFocusable true))
    tag DoneTx   EVGElement (props (className "rt-done-text") (elementType 1))

    ; The countdown. Sixty ticks around one grid cell, and the number in the
    ; middle of the same cell — the ring's own arrangement, with the dial's
    ; centre where the blades already pivot.
    tag Dial     EVGElement (props (className "rt-dial") (id "rt-dial") (role "timer") (a11yLabel "Sarjan ajastin"))
    tag Tick     EVGElement (props (className "rt-tick") (a11yHidden true))
    tag DialMid  EVGElement (props (className "rt-dial-mid"))
    tag DialNum  EVGElement (props (className "rt-dial-num") (id "rt-dial-num") (elementType 1))
    tag DialCap  EVGElement (props (className "rt-dial-cap") (id "rt-dial-cap") (elementType 1))
    tag Round    EVGElement (props (className "rt-round") (role "button") (a11yFocusable true))
    tag RoundTx  EVGElement (props (className "rt-round-text") (elementType 1) (a11yHidden true))
}

class RealTrainerDemo {

    ; --- the timings, in one place -------------------------------------------
    ;
    ; The bar fills in `fillMs`, the finished bar is looked at for `holdMs`, and
    ; the ring turns at `spinDegPerSec`. A demo whose durations are scattered
    ; through the code is a demo nobody re-times.
    def fillMs:double 2600.0
    def holdMs:double 700.0
    def spinDegPerSec:double 220.0

    def root@(optional):EVGElement
    def sheet@(optional):EVGStyleSheet
    def layout@(optional):EVGLayout
    def transitions:EVGTransition (new EVGTransition())

    ; --- the library's controls ----------------------------------------------
    def bar:ProgressCtl (new ProgressCtl())
    def remember:CheckboxCtl (new CheckboxCtl())
    def tips:CollapsibleCtl (new CollapsibleCtl())
    def tabs:TabsCtl (new TabsCtl())
    def goals:TableCtl (new TableCtl())
    def sportOnly:ToggleCtl (new ToggleCtl())
    def plans:AccordionCtl (new AccordionCtl())
    def rest:RadioGroupCtl (new RadioGroupCtl())
    def session:ProgressCtl (new ProgressCtl())

    ; --- the training session's own state -------------------------------------
    ; The session's content, parsed from COMPACT. There is no second copy of
    ; the plan anywhere: the steppers write into the row and the spec line is
    ; built from the row again, so the two cannot drift apart.
    def rows:[CompactRow]
    def workTitle:string ""
    def moveIndex:int 0
    def moveCount:int 0
    ; How far the document screen is scrolled. The value the app keeps is the
    ; one the LAYOUT clamped: it knows the content height and this does not.
    def docScroll:double 0.0
    ; The document, its rows and the text they came from. An edit patches the
    ; one line it touched — see CompactDocument — so a family this model cannot
    ; express cannot be damaged by saving.
    def doc@(optional):CompactDocument
    def backend:RtBackendSim (new RtBackendSim())
    ; The "Lisää harjoitus" machine, ported from XState. The dialog below is
    ; drawn from its state and nothing else — which is the point of porting a
    ; machine rather than a screen.
    def addDialog:AddWorkoutDialog (new AddWorkoutDialog())
    ; The "Suunnittele viikko" machine, run from its own definition by the
    ; statechart runner — see PlanDialogHost. The job it starts is simulated
    ; with the same latency model the save is.
    def plan:PlanDialogHost (new PlanDialogHost())
    ; The conversation machine, likewise run from its definition, and the
    ; mock adapter that streams its reply on the clock.
    def chat:ChatHost (new ChatHost())
    ; The reference: the same seed file the recorder puts into the emulator,
    ; and the screen it is opened on. `section` is `activeNavSection` in the
    ; original, `calTab` its `mobileCalendarTab`, `weekStart` the `?week=`.
    def seed:RtSeed (new RtSeed())
    def section:string "calendar"
    def calTab:string "weeks"
    def weekStart:string "2026-02-09"
    def exWeekType:string "target"
    def today:string "2026-09-03"
    ; The text fields: one per dialog that has one in the original, each a
    ; `InputCtl` named by its placeholder as the original's textareas are.
    ; The machine is the source of truth for the value — every edit is sent
    ; to it, and the field is set from it on every rebuild.
    def chatField:InputCtl (new InputCtl())
    def planField:InputCtl (new InputCtl())
    def addField:InputCtl (new InputCtl())
    ; The edit sheet's fields: the general feedback and one per weekday.
    def editField:InputCtl (new InputCtl())
    def dayFields:[InputCtl]
    ; The bar's "Lisää" opens a sheet over whichever section is up; it is not
    ; a section of its own, and the original keeps it the same way.
    def moreOpen@(mutable):boolean false
    ; How far the plan dialog's body is scrolled — the edit sheet is taller
    ; than a phone, and scrolls inside the dialog as the original's does.
    def modalScroll:double 0.0
    ; The calendar wizard, the job that writes the calendar it makes, and
    ; the toast that says so. Its six fields are the form's.
    def wizard:CalendarWizard (new CalendarWizard())
    def wizJob:RtBackendSim (new RtBackendSim())
    def wizScroll:double 0.0
    def toastText@(mutable):string ""
    def toastMs:double 0.0
    ; The year sheet page, and the editors' controls — one duration, one
    ; unit and one type per period, built when the seed is loaded.
    def ys:RtYearSheet (new RtYearSheet())
    def ysDur:[NumberCtl]
    def ysUnit:[SelectCtl]
    def ysType:[SelectCtl]
    def wizName:InputCtl (new InputCtl())
    def wizDesc:InputCtl (new InputCtl())
    def wizGoals:InputCtl (new InputCtl())
    def wizLevel:InputCtl (new InputCtl())
    def wizPass:InputCtl (new InputCtl())
    def wizConfirm:InputCtl (new InputCtl())
    def measurer:EVGLayout (new EVGLayout())
    def chatSim:RtChatSim (new RtChatSim())
    def chatJob:RtBackendSim (new RtBackendSim())
    def planJob:RtBackendSim (new RtBackendSim())
    def weekType:RadioGroupCtl (new RadioGroupCtl())
    ; One checkbox per weekday for each of the three by-day maps the machine
    ; keeps. They are drawn FROM the context on every rebuild and never
    ; toggled directly: the machine is the only place the answer lives.
    def replaceDay:[CheckboxCtl]
    def keepDay:[CheckboxCtl]
    def showDay:[CheckboxCtl]
    def doneMoves:int 0
    def timerOn:boolean false
    def timerRunning:boolean false
    def timerLeftMs:double 0.0
    def timerFullMs:double 60000.0

    ; "loading", "signin", "dashboard" or "session".
    def scene:string "loading"
    def elapsedMs:double 0.0
    def hovered:string ""
    def pressed:string ""
    def focused:string ""
    def pageW:double 980.0
    def pageH:double 760.0

    Constructor () {
    }

    ; The plan arrives as TEXT rather than as a path: a browser has no
    ; filesystem, and the headless check should read the same bytes the page
    ; does rather than a fixture of its own.
    fn init:void (css:string compact:string) {
        def s (new EVGStyleSheet())
        s.parse(css)
        sheet = s
        this.loadCompact(compact)
        this.setupControls()
        this.rebuild()
    }

    fn loadCompact:void (compact:string) {
        def parsed:CompactDocument (CompactRowMapper.parseDocument(compact))
        doc = parsed
        rows = parsed.rows
        workTitle = parsed.title
        moveCount = 0
        moveIndex = 0
        def seen:int 0
        for rows r:CompactRow i {
            if (CompactRowEdit.isExercise(r)) {
                moveCount = (moveCount + 1)
                if (seen == 0) {
                    moveIndex = i
                    seen = 1
                }
            }
        }
    }

    ; Where the current move sits in the list of moves, counting from one —
    ; the number a person reads off a paper plan, not the row index.
    fn moveOrdinal:int () {
        def n:int 0
        def i:int 0
        while (i <= moveIndex) {
            if (CompactRowEdit.isExercise((at rows i))) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; The section heading above the current move. A plan that says "Pääosa"
    ; over four exercises says it once, and the screen shows one of them.
    fn sectionOf:string (index:int) {
        def out:string ""
        def i:int 0
        while (i < index) {
            def r:CompactRow (at rows i)
            if (CompactRowEdit.isSection(r)) {
                out = (CompactStatBuilder.label(r))
            }
            i = (i + 1)
        }
        return out
    }

    ; The next move, or where we already are when there is no next one.
    fn advanceMove:void () {
        def i:int (moveIndex + 1)
        while (i < (array_length rows)) {
            if (CompactRowEdit.isExercise((at rows i))) {
                moveIndex = i
                return
            }
            i = (i + 1)
        }
    }

    ; Every controller's fixed configuration, once. What CHANGES about them —
    ; the bar's value, which tab is on, which plan is open — is their own state
    ; and is not touched here.
    fn setupControls:void () {
        bar.tid = "rt-bar"
        bar.name = "Lataus"
        bar.maxValue = 100.0
        bar.value = 0.0

        remember.tid = "rt-remember"
        remember.name = "Muista minut tällä laitteella"

        tips.tid = "rt-tips"
        tips.name = "Lisää vinkkejä käyttöön"
        tips.triggerTid = "rt-tips-trigger"
        tips.contentTid = "rt-tips-content"
        tips.contentText = "Sanele treeni heti sen jälkeen — muisti on silloin tarkin. Kuvaa lautanen, älä laske kaloreita."

        tabs.tid = "rt-tabs"
        tabs.name = "Osiot"
        tabs.addItem("dash" "Dashboard" "" false)
        tabs.addItem("cal" "Kalenteri" "" false)
        tabs.addItem("drills" "Harjoitteet" "" false)
        tabs.value = "dash"
        tabs.rovingValue = "dash"

        ; Two columns and four rows, and the sorting is the controller's: a
        ; third click on the same header is the order the data arrived in,
        ; which a two-way toggle cannot reach.
        goals.tid = "rt-goals"
        goals.name = "Tavoitteet"
        goals.addColumn("goal" "Tavoite" false true)
        goals.addColumn("kind" "Tyyppi" false true)
        goals.addRecord("throw" ([] _:string ("Heittoharjoittelu" "Sport")))
        goals.addRecord("strength" ([] _:string ("Voimaharjoittelu" "Strength-Type")))
        goals.addRecord("speed" ([] _:string ("Nopeus ja loikat" "Training-Type")))
        goals.addRecord("endure" ([] _:string ("Kestävyys ja huolto" "Custom")))
        goals.pageSize = 4

        sportOnly.tid = "rt-sportonly"
        sportOnly.name = "Vain lajiharjoittelu"

        plans.tid = "rt-plans"
        plans.name = "Kaikki suunnitelmat"
        plans.addItem("y2526" "Kuulantyöntäjän vuosisuunnitelma 2025-2026"
            "Kaksi kilpailukautta, painotus voiman eri osa-alueissa: hypertrofia, hybridi, maksimi, räjähtävyys." false)
        plans.addItem("sm26" "M50 Kuulantyöntö SM 2026 — kuntoutus ja valmistautuminen"
            "Kevyempi jakso olkapään kuntoutuksen ympärillä, tekniikka pidetään yllä matalalla kuormalla." false)
        plans.openValue = "y2526"

        ; The rest between sets. A RADIO GROUP and not a row of toggles, and
        ; the difference is the one `DashboardDemo` measured: clicking the
        ; chosen item of a toggle group deselects it, and a rest picker with no
        ; rest picked is a timer with nothing to count.
        rest.tid = "rt-rest"
        rest.name = "Tauko"
        rest.addItem("30" "30s" false)
        rest.addItem("60" "60s" false)
        rest.addItem("90" "90s" false)
        rest.addItem("120" "120s" false)
        rest.value = "60"

        session.tid = "rt-session"
        session.name = "Harjoituksen eteneminen"
        session.maxValue = (int2double moveCount)
        session.value = 0.0

        weekType.tid = "rt-plan-type"
        weekType.name = "Viikon tyyppi"
        weekType.addItem("target" "Tavoiteviikko" false)
        weekType.addItem("light" "Kevyt viikko" false)
        weekType.value = "target"
        planJob.latencyMs = 900.0

        chatField.tid = "rt-chat-field"
        chatField.placeholder = "Kysy jotain päiväkirjastasi..."
        chatField.name = chatField.placeholder
        planField.tid = "rt-plan-field"
        planField.placeholder = "Esim. keskity kuntoutusjuoksuihin, kevyempi viikko"
        planField.name = planField.placeholder
        addField.tid = "rt-add-field"
        addField.placeholder = "Luo harjoitusohjelma, esim. \"viikon peruskuntojakso\""
        addField.name = addField.placeholder
        editField.tid = "rt-plan-edit-field"
        editField.placeholder = "Esim. pidä torstai kevyenä, lisää polven kuntoutusta, vältä kahta kovaa päivää peräkkäin"
        editField.name = editField.placeholder
        def fd:int 0
        while (fd < 7) {
            def dayField (new InputCtl())
            dayField.tid = ("rt-plan-day-field-" + (to_string fd))
            dayField.placeholder = "Päiväkohtainen ohje (esim. tiistai vain palauttava uinti)"
            dayField.name = dayField.placeholder
            push dayFields dayField
            fd = (fd + 1)
        }
        wizName.tid = "rt-wiz-name"
        wizName.placeholder = "esim. Juoksuharjoittelu 2026"
        wizName.name = wizName.placeholder
        wizDesc.tid = "rt-wiz-desc"
        wizDesc.placeholder = "Lyhyt kuvaus kalenterista..."
        wizDesc.name = wizDesc.placeholder
        wizGoals.tid = "rt-wiz-goals"
        wizGoals.placeholder = "esim. Juosta maraton alle 4 tunnissa"
        wizGoals.name = wizGoals.placeholder
        wizLevel.tid = "rt-wiz-level"
        wizLevel.placeholder = "esim. Puolimaraton 2h, juoksen 3x viikossa"
        wizLevel.name = wizLevel.placeholder
        wizPass.tid = "rt-wiz-pass"
        wizPass.kind = "password"
        wizPass.placeholder = "••••••••••••"
        wizPass.name = wizPass.placeholder
        wizConfirm.tid = "rt-wiz-confirm"
        wizConfirm.kind = "password"
        wizConfirm.placeholder = "••••••••••••"
        wizConfirm.name = wizConfirm.placeholder
        wizJob.latencyMs = 300.0
        def fields:[InputCtl] (this.fields())
        for fields f:InputCtl i {
            f.fontFamily = "Arial"
            f.fontSize = 13.0
            f.boxWidth = 300.0
        }
        def d:int 0
        while (d < 7) {
            def rc (new CheckboxCtl())
            rc.tid = ("rt-plan-day-" + (to_string d))
            rc.name = ("Korvaa " + (PlanDialogHost.dayName(d)))
            push replaceDay rc
            def kc (new CheckboxCtl())
            kc.tid = ("rt-plan-keep-" + (to_string d))
            kc.name = "Nykyinen on hyvä — pidä samana"
            push keepDay kc
            def sc (new CheckboxCtl())
            sc.tid = ("rt-plan-show-" + (to_string d))
            sc.name = ("Näytä edellinen " + (PlanDialogHost.dayName(((d + 1) % 7))))
            push showDay sc
            d = (d + 1)
        }
    }

    ; The machine, as text — the browser has no filesystem and the headless
    ; check should read the same bytes the page does. Until it is loaded the
    ; button on the dashboard does nothing, and says so by answering `false`.
    fn loadPlanMachine:void (text:string) {
        plan.load(text "2026-02-09")
    }

    fn loadChatMachine:void (text:string) {
        chat.load(text)
        chatJob.latencyMs = 600.0
    }

    ; The same file the reference recorder seeds from.
    fn loadReference:void (text:string) {
        seed.load(text)
        if ((strlen seed.week) > 0) {
            weekStart = seed.week
        }
        ys.load(seed)
        clear ysDur
        clear ysUnit
        clear ysType
        for seed.periods p:RtPeriod i {
            def d (new NumberCtl())
            d.tid = ("rt-ys-dur-" + (to_string i))
            d.name = "Kesto"
            d.setValue((int2double p.durationWeeks))
            d.setRange(1.0 520.0)
            d.groupThousands = false
            push ysDur d
            def u (new SelectCtl())
            u.tid = ("rt-ys-unit-" + (to_string i))
            u.name = ""
            u.addItem("weeks" "vk" false)
            u.addItem("days" "pv" false)
            u.value = p.durationUnit
            push ysUnit u
            def t (new SelectCtl())
            t.tid = ("rt-ys-type-" + (to_string i))
            t.name = ""
            t.addItem("base" "Peruskausi" false)
            t.addItem("build" "Rakennuskausi" false)
            t.addItem("peak" "Huippukausi" false)
            t.addItem("race" "Kilpailukausi" false)
            t.addItem("recovery" "Palautuminen" false)
            t.addItem("transition" "Siirtymä" false)
            t.addItem("general" "Yleinen" false)
            t.value = p.kind
            push ysType t
        }
    }

    ; A phone is 390 by 844; on its side 844 by 390. The shell reads which.
    fn setPageSize:void (w:double h:double) {
        pageW = w
        pageH = h
        def fresh (new EVGLayout())
        fresh.setPageSize(pageW pageH)
        layout = fresh
        this.rebuild()
    }

    fn isPortrait:boolean () {
        return (pageH > pageW)
    }

    ; "/calendar/cal-plan?week=2026-02-09" — the route the reference opens.
    ; Only the calendar is routed today; everything else is a section.
    fn openRoute:boolean (route:string) {
        def q:int (RtEntry.findIn(route "?week="))
        if (q >= 0) {
            weekStart = (RtWeek.mondayOf((substring route (q + 6) (q + 16))))
        }
        ; `/summary/yearsheet` (and `/yearsheet`): the list; with an id, the
        ; sheet. Both draw inside the shell, without its header.
        if ((RtEntry.hasPrefix(route "/summary/yearsheet")) || (RtEntry.hasPrefix(route "/yearsheet"))) {
            def tail@(mutable):string ""
            if (RtEntry.hasPrefix(route "/summary/yearsheet/")) { tail = (substring route 19 (strlen route)) }
            if (RtEntry.hasPrefix(route "/yearsheet/")) { tail = (substring route 11 (strlen route)) }
            ys.openList()
            if ((strlen tail) > 0) {
                ys.openDetail()
            }
            docScroll = 0.0
            scene = "yearsheet"
            this.rebuild()
            return true
        }
        ; `/new-calendar` is a page of its own: the wizard, and nothing of the
        ; shell around it.
        if (RtEntry.hasPrefix(route "/new-calendar")) {
            wizard.open()
            wizScroll = 0.0
            scene = "wizard"
            this.rebuild()
            return true
        }
        if (RtEntry.hasPrefix(route "/calendar/")) {
            def rest:string (substring route 10 (strlen route))
            def qm:int (RtEntry.findIn(rest "?"))
            def id@(mutable):string rest
            if (qm >= 0) {
                id = (substring rest 0 qm)
            }
            seed.selectCalendar(id)
            section = "calendar"
            calTab = "weeks"
        }
        if ((route == "/") || (route == "/home")) {
            section = "home"
        }
        scene = "app"
        this.rebuild()
        return true
    }

    ; The chosen rest, in milliseconds. The controller holds a STRING, because
    ; that is what a radio value is; the arithmetic is this app's.
    fn restMs:double () {
        if (rest.value == "30") {
            return 30000.0
        }
        if (rest.value == "90") {
            return 90000.0
        }
        if (rest.value == "120") {
            return 120000.0
        }
        return 60000.0
    }

    ; --- what a controller MEANS, put where a reader will find it --------------
    ;
    ; gallery/ui's controllers publish their semantics as `rows()` — one UiRow
    ; per test id, in ARIA terms — because that is what the conformance harness
    ; diffs against Radix. `EVGA11yFromTree` reads the ELEMENT tree instead. So
    ; a controller dropped into an app's tree paints perfectly and says nothing
    ; at all, which is the one thing a canvas app cannot afford: the pixels are
    ; already unreadable.
    ;
    ; This copies one onto the other, by id. It is the app's job and not the
    ; library's: a controller cannot know it is being used inside a tree that
    ; someone will walk.
    fn adopt:void (host:EVGElement rows:[UiRow]) {
        def i:int 0
        while (i < (array_length rows)) {
            def row:UiRow (itemAt rows i)
            def found@(optional):EVGElement (RealTrainerDemo.byId(host row.tid))
            if found {
                def el:EVGElement (unwrap found)
                if (row.role > 0) {
                    el.role = (EVGA11yRole.ariaName(row.role))
                }
                if ((strlen row.name) > 0) {
                    el.a11yLabel = row.name
                }
                el.a11yExpanded = row.expanded
                el.a11yChecked = row.checked
                el.a11ySelected = row.selected
                el.a11yPressed = row.pressed
                el.a11ySorted = row.sorted
                el.a11yDisabled = row.disabled
                el.a11yLevel = row.level
                el.a11ySetSize = row.setSize
                el.a11yPosInSet = row.setPos
                el.a11yOrientation = row.orientation
                el.a11yCurrent = row.current
                el.a11yRoleDescription = row.roleDescription
                el.a11yHasPopup = row.hasPopup
                el.a11yHasRange = row.hasRange
                el.a11yValueMin = row.valueMin
                el.a11yValueMax = row.valueMax
                el.a11yHasValue = row.hasValueNow
                el.a11yValueNow = row.valueNow
                if (row.focusable) {
                    el.a11yFocusable = true
                }
            }
            i = (i + 1)
        }
    }

    ; Build a controller's subtree and say what it means, in that order —
    ; `build()` replaces the elements the last `adopt` wrote to.
    fn dress:void (ctl:UiCtl) {
        ctl.build()
        this.adopt((unwrap ctl.rootEl) (ctl.rows()))
    }

    ; --- scene one: the loader ------------------------------------------------

    sfn ring:EVGElement () {
        def ring (tree Rt (Ring))
        def i:int 0
        while (i < 12) {
            def blade (tree Rt (Blade (props (className ("rt-blade rt-blade-" + (to_string i))))))
            ring.addChild(blade)
            i = (i + 1)
        }
        return ring
    }

    fn loader:EVGElement () {
        this.dress(bar)
        def card (tree Rt
            (Card (props (id "rt-card"))
                (child (RealTrainerDemo.ring()))
                (Word
                    (WordA "REAL")
                    (WordB "TRAINER"))
                (Tagline "MAXIMUM EFFORT!")))
        card.addChild((unwrap bar.rootEl))
        return (tree Rt
            (Page (props (id "rt-page"))
                (child card)
                (Caption "Ladataan...")
                (Pct "0 %")))
    }

    ; --- scene two: the sign-in page ------------------------------------------

    ; The three things the real page opens with, as three rows: a badge, a
    ; sentence whose first words are the verb, and an example in a chip.
    sfn feature:EVGElement (rowId:string icon:string strong:string rest:string example:string) {
        def glyph (tree Rt (Icon))
        glyph.svgSource = icon
        def badge (tree Rt (Badge))
        badge.addChild(glyph)
        return (tree Rt
            (Feat (props (id rowId))
                (child badge)
                (FeatText
                    (FeatHead
                        (Strong strong)
                        (Rest rest))
                    (Chip
                        (ChipText example)))))
    }

    ; --- the icons ------------------------------------------------------------
    ;
    ; Hand-drawn in the shape lucide's files have — 24x24, `currentColor` so the
    ; stylesheet owns the colour — and small enough to read: a keyboard is a
    ; rounded box with keys, a microphone a capsule on a stand, a camera a body
    ; with a lens. Not traced from anything.
    sfn svgOpen:string () {
        return "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='currentColor'>"
    }


    ; "Kausien muokkaus": a row per period — its number and name, the
    ; duration, its unit, its type, the date lock, and delete, which is
    ; disabled while the period is the only one.
    fn ysPeriodEditor:void (body:EVGElement) {
        def panel (tree Rt (YsPanel))
        def top (tree Rt (ModalRow))
        top.addChild((tree Rt (YsH3 (props (id "rt-ys-h-edit")) "Kausien muokkaus")))
        top.addChild((tree Rt (Spacer)))
        top.addChild((this.ysTool("rt-ys-add-period" "Lisää kausi" (RtIcons.plus("#ffffff")) "rt-ys-tool rt-ys-tool-green")))
        panel.addChild(top)
        for seed.periods p:RtPeriod i {
            def row (tree Rt (YsEditRow))
            row.addChild((tree Rt (YsTx (((to_string (i + 1)) + ". ") + p.name))))
            ; The duration: `NumberCtl` keeps the value, the range and the
            ; steps; the box, the value and the two step buttons are drawn
            ; here, as `ControlsDemo` draws its own.
            def dur:NumberCtl (itemAt ysDur i)
            def durBox (tree Rt (YsNum))
            durBox.id = dur.tid
            durBox.a11yLabel = dur.name
            durBox.addChild((this.iconBtn((dur.tid + "-dec") "Vähennä" (RtIcons.chevronLeft("#999999")))))
            durBox.addChild((tree Rt (YsNumTx (dur.plain()))))
            durBox.addChild((this.iconBtn((dur.tid + "-inc") "Lisää" (RtIcons.chevronRight("#999999")))))
            row.addChild(durBox)
            def unit:SelectCtl (itemAt ysUnit i)
            this.dress(unit)
            def unitBox:EVGElement (unwrap unit.rootEl)
            unitBox.setAttribute("width" "80px")
            row.addChild(unitBox)
            def kind:SelectCtl (itemAt ysType i)
            this.dress(kind)
            def kindBox:EVGElement (unwrap kind.rootEl)
            kindBox.setAttribute("width" "150px")
            row.addChild(kindBox)
            row.addChild((this.ysTool(("rt-ys-lock-" + (to_string i)) "Lukitse päivämäärät" (RtIcons.lock("#f2f2f2")) "rt-ys-tool rt-ys-tool-outline")))
            def del (this.iconBtn(("rt-ys-del-period-" + (to_string i)) "" (RtIcons.trash("#999999"))))
            if ((array_length seed.periods) < 2) {
                del.a11yDisabled = true
            }
            row.addChild(del)
            panel.addChild(row)
        }
        panel.addChild((tree Rt (YsDim (props (id "rt-ys-total")) (("Yhteensä: " + (to_string (RtYearSheet.totalWeeks(seed)))) + " viikkoa"))))
        body.addChild(panel)
    }


    tag WizLabel EVGElement (props (className "rt-wiz-label") (elementType 1))
    tag WizDots  EVGElement (props (className "rt-wiz-dots") (a11yHidden true))
    tag WizDot   EVGElement (props (className "rt-wiz-dot"))
    tag WizBody  EVGElement (props (className "rt-wiz-body") (id "rt-wiz-body"))
    tag WizCenter EVGElement (props (className "rt-wiz-center"))
    tag WizGrid  EVGElement (props (className "rt-wiz-grid"))
    tag WizCard  EVGElement (props (className "rt-wiz-card") (role "button") (a11yFocusable true))
    tag WizCardTitle EVGElement (props (className "rt-wiz-card-title") (elementType 1))
    tag WizCardDesc EVGElement (props (className "rt-wiz-card-desc") (elementType 1))
    tag WizIcon  EVGElement (props (className "rt-wiz-icon") (tagName "path"))
    tag WizBadge EVGElement (props (className "rt-wiz-badge"))
    tag WizBox   EVGElement (props (className "rt-wiz-box"))
    tag WizSwitch EVGElement (props (className "rt-wiz-switch"))
    tag WizKnob  EVGElement (props (className "rt-wiz-knob"))
    tag WizBars  EVGElement (props (className "rt-wiz-bars"))
    tag WizBar   EVGElement (props (className "rt-wiz-bar"))
    tag WizSwatch EVGElement (props (className "rt-wiz-swatch") (role "button") (a11yFocusable true))
    tag WizVis   EVGElement (props (className "rt-wiz-vis") (role "button") (a11yFocusable true))
    tag WizFoot  EVGElement (props (className "rt-wiz-foot"))
    tag WizBtn   EVGElement (props (className "rt-wiz-btn") (role "button") (a11yFocusable true))
    tag WizBtnTx EVGElement (props (className "rt-wiz-btn-text") (elementType 1))
    ; The year sheet page: its header, the cards, the toolbar, the grid,
    ; the legend, the periods and their example weeks.
    tag YsHead   EVGElement (props (className "rt-ys-head"))
    tag YsHd     EVGElement (props (className "rt-ys-hd") (elementType 1) (role "heading") (a11yLevel 1))
    tag YsH3     EVGElement (props (className "rt-ys-h3") (elementType 1) (role "heading") (a11yLevel 3))
    tag YsPara   EVGElement (props (className "rt-ys-para") (elementType 1) (role "paragraph"))
    tag YsTx     EVGElement (props (className "rt-ys-text") (elementType 1))
    tag YsDim    EVGElement (props (className "rt-ys-dim") (elementType 1))
    tag YsStrong EVGElement (props (className "rt-ys-strong") (elementType 1))
    tag YsCard   EVGElement (props (className "rt-ys-card"))
    tag YsCardBtn EVGElement (props (className "rt-ys-card-btn") (role "button") (a11yFocusable true))
    tag YsTools  EVGElement (props (className "rt-ys-tools"))
    tag YsToolBtn EVGElement (props (className "rt-ys-tool") (role "button") (a11yFocusable true))
    tag YsToolTx EVGElement (props (className "rt-ys-tool-text") (elementType 1))
    tag YsPanel  EVGElement (props (className "rt-ys-panel"))
    tag YsGrid   EVGElement (props (className "rt-ys-grid"))
    tag YsGridRow EVGElement (props (className "rt-ys-grid-row"))
    tag YsCell   EVGElement (props (className "rt-ys-cell"))
    tag YsCellTx EVGElement (props (className "rt-ys-cell-text") (elementType 1))
    tag YsLegend EVGElement (props (className "rt-ys-legend"))
    tag YsSwatch EVGElement (props (className "rt-ys-swatch") (a11yHidden true))
    tag YsPeriod EVGElement (props (className "rt-ys-period"))
    tag YsPeriodBtn EVGElement (props (className "rt-ys-period-btn") (role "button") (a11yFocusable true))
    tag YsEditRow EVGElement (props (className "rt-ys-edit-row"))
    ; A number field: a text field — `NumberCtl` measured Base UI's, and it
    ; is not a spinbutton — its value, and the two steps beside it.
    tag YsNum    EVGElement (props (className "rt-ys-num") (role "textbox") (a11yFocusable true))
    tag YsNumTx  EVGElement (props (className "rt-ys-num-text") (elementType 1))
    ; A toast, in the toaster's landmark: a list with one item, as sonner has it.
    tag Toast    EVGElement (props (className "rt-toast") (role "list"))
    tag ToastItem EVGElement (props (className "rt-toast-item") (role "listitem"))
    tag ToastTx  EVGElement (props (className "rt-toast-text") (elementType 1))

    tag DocView  EVGElement (props (className "rt-doc-view") (id "rt-doc-view"))
    tag DocList  EVGElement (props (className "rt-doc-list") (id "rt-doc-list")
                                   (role "list") (a11yLabel "Harjoituksen rivit"))
    tag DocRow   EVGElement (props (className "rt-doc-row") (role "listitem"))
    tag DocHead  EVGElement (props (className "rt-doc-head") (role "listitem"))
    tag DocLabel EVGElement (props (className "rt-doc-label") (elementType 1))
    tag DocParts EVGElement (props (className "rt-doc-parts"))
    tag Steps    EVGElement (props (className "rt-steps"))
    tag Step     EVGElement (props (className "rt-step"))
    tag StepCap  EVGElement (props (className "rt-step-cap") (elementType 1))
    tag StepRow  EVGElement (props (className "rt-step-row"))
    tag StepBtn  EVGElement (props (className "rt-step-btn") (role "button") (a11yFocusable true))
    tag StepBtnTx EVGElement (props (className "rt-step-btn-text") (elementType 1) (a11yHidden true))
    tag StepVal  EVGElement (props (className "rt-step-val") (elementType 1))
    tag Times    EVGElement (props (className "rt-times") (elementType 1) (a11yHidden true))
    tag RestRow  EVGElement (props (className "rt-rest-row"))
    tag RestCap  EVGElement (props (className "rt-rest-cap") (elementType 1))
    tag Actions  EVGElement (props (className "rt-actions"))
    tag Start    EVGElement (props (className "rt-start") (id "rt-start") (role "button")
                                   (a11yLabel "Aloita sarjat") (a11yFocusable true))
    tag StartTx  EVGElement (props (className "rt-start-text") (elementType 1))
    tag SaveBtn  EVGElement (props (className "rt-save") (id "rt-save") (role "button")
                                   (a11yLabel "Tallenna liike") (a11yFocusable true))
    tag SaveTx   EVGElement (props (className "rt-save-text") (elementType 1))
    tag SaveState EVGElement (props (className "rt-save-state") (elementType 1) (role "status"))
    tag FailBtn  EVGElement (props (className "rt-fail") (id "rt-fail") (role "button")
                                   (a11yLabel "Kaada seuraava tallennus") (a11yFocusable true))
    tag FailTx   EVGElement (props (className "rt-fail-text") (elementType 1))
    tag DoneBtn  EVGElement (props (className "rt-done") (id "rt-done") (role "button")
                                   (a11yLabel "Merkitse liike tehdyksi") (a11yFocusable true))
    tag DoneTx   EVGElement (props (className "rt-done-text") (elementType 1))

    ; The countdown. Sixty ticks around one grid cell, and the number in the
    ; middle of the same cell — the ring's own arrangement, with the dial's
    ; centre where the blades already pivot.
    tag Dial     EVGElement (props (className "rt-dial") (id "rt-dial") (role "timer") (a11yLabel "Sarjan ajastin"))
    tag Tick     EVGElement (props (className "rt-tick") (a11yHidden true))
    tag DialMid  EVGElement (props (className "rt-dial-mid"))
    tag DialNum  EVGElement (props (className "rt-dial-num") (id "rt-dial-num") (elementType 1))
    tag DialCap  EVGElement (props (className "rt-dial-cap") (id "rt-dial-cap") (elementType 1))
    tag Round    EVGElement (props (className "rt-round") (role "button") (a11yFocusable true))
    tag RoundTx  EVGElement (props (className "rt-round-text") (elementType 1) (a11yHidden true))
}

; One curve on the Tilastot tab: the values, the colour, and the id of the
; box the layout places for it.
class RtChartDef {
    def id@(mutable):string ""
    def color@(mutable):string ""
    def values:[double]
}

class RealTrainerDemo {

    ; --- the timings, in one place -------------------------------------------
    ;
    ; The bar fills in `fillMs`, the finished bar is looked at for `holdMs`, and
    ; the ring turns at `spinDegPerSec`. A demo whose durations are scattered
    ; through the code is a demo nobody re-times.
    def fillMs:double 2600.0
    def holdMs:double 700.0
    def spinDegPerSec:double 220.0

    def root@(optional):EVGElement
    def sheet@(optional):EVGStyleSheet
    def layout@(optional):EVGLayout
    ; IS THE LAYOUT STILL CURRENT. False means the boxes the last layout
    ; produced are the boxes on the screen, and a frame that asks for them
    ; gets them back without laying anything out — see `laidOut`.
    ;
    ; This replaced a one-shot flag that said "the frame in front of you is a
    ; scroll", consumed by whoever asked first. The trouble with a flag that
    ; is spent is that TWO callers ask per frame: the pointer asks `hitId` to
    ; know what it is over, and the paint asks `display`. The first consumed
    ; the flag and the second laid the whole page out again — and the mirror's
    ; `a11yJson` after a scroll settled was a third, which is why every scroll
    ; ended with a full layout it did not need. Measured on a forty-workout
    ; diary at 390x844 that layout is 13 ms, and it ran twice per pointer
    ; move.
    ;
    ; The cost of a flag that persists is that every path that writes on the
    ; tree has to raise it, and the one that is forgotten is a frame drawn
    ; stale. So it is raised at the ENTRY of every public call that can
    ; change what is drawn — `press`, `keyWith`, `setHover`, `rebuild`,
    ; the per-frame writers, and a transition in flight — rather than beside
    ; the write itself, and a controller that rebuilds its own subtree inside
    ; `press` is covered by `press`. A spurious layout after a press costs
    ; nothing anyone can see; a missed one is a bug, so the raise is coarse.
    def layoutDirty:boolean true
    ; THE BOXES MAY HAVE MOVED. `layoutDirty` says the sheet has to be
    ; applied again — a hover, a press — and the sheet then says whether
    ; anything it wrote can have moved a box (`EVGStyleSheet.layoutClean`);
    ; when nothing did, the positions stand and the layout pass is skipped.
    ; What the sheet cannot see is a write made past it: a rebuilt tree, a
    ; caption or a class name written straight onto an element by the
    ; per-frame writers, a size. Those raise this, and this is never argued
    ; with.
    def boxesDirty:boolean true
    ; THE LIST IS KEPT ACROSS A SCROLL. `display` hands back the list it
    ; built last time, moved, while every scroll container it holds is still
    ; inside the range that list was built for — see
    ; `EVGDisplayList.refreshLayers`. `listDirty` is what says the picture
    ; changed for a reason other than a scroll: the sheet ran, a transition
    ; wrote a frame, a scene was rebuilt.
    def retained@(optional):EVGDisplayList
    def listDirty:boolean true
    def listBuilds:int 0
    ; IS ANYTHING IN FLIGHT. `EVGTransition.advanceTree` and `busy` walk the
    ; whole tree, and `tick` asked both on every frame of a long document
    ; with nothing moving in it — two walks of ten thousand elements to find
    ; no flight. The sheet's pass is where a flight can start, so that is
    ; where this is asked once; after that a frame walks the tree only while
    ; the answer was yes, and stops asking when the last flight lands.
    def flights:boolean false
    ; --- ENTRY CARDS, KEPT ACROSS REBUILDS --------------------------------------
    ;
    ; A rebuild makes the scene's tree again from the state, and on Home
    ; that tree is every workout of the calendar as a card: the compact
    ; text parsed, a subtree of a hundred elements built, for every entry,
    ; on every press — opening the calendar menu measured at a second on a
    ; phone, and in a browser profile the cards were half of it and the
    ; elements' constructors a third. A card depends on the entry and where
    ; it is drawn, and on nothing else in the app, so the subtree is kept
    ; and handed back while its key — the entry's id and content, its
    ; place and its index, which its children's ids carry — is the same.
    ; A tree has no parent pointers, so an element is moved into the new
    ; tree by being added to it; the layout resets what the last one
    ; wrote. Emptied when the calendar changes.
    def cardEls:[string:EVGElement]
    def cardKeys:[string:string]
    def cardsCalendar:string ""
    def cardsBuilt:int 0
    ; --- THE SCROLLBAR --------------------------------------------------------
    ;
    ; Drawn by the list (`EVGDisplayList.addScrollbar`), so every host has
    ; it; what is decided here is its STATE. It is up for a while after any
    ; scroll and settles when the page has been still, the pointer over it
    ; lights it, and a press on it drags the page by the thumb's scale.
    def barActiveMs:double 0.0
    def barHoverEl@(optional):EVGElement
    def barNearEl@(optional):EVGElement
    def barDragEl@(optional):EVGElement
    def barDragScale:double 1.0
    def barDragY:double 0.0
    def barDragTop:double 0.0
    def barDragging:boolean false
    ; A scroll since the last frame that `laidOut` has not yet applied. The
    ; offset was written on the container and clamped straight away, so the
    ; caller already knows whether the page moved; the WALK that moves the
    ; boxes — `EVGLayout.scrollOnly`, the whole subtree — waits for the next
    ; frame to ask, so a finger that reports six moves between two frames
    ; moves the document once, not six times.
    def scrollPending:boolean false
    ; The containers that were scrolled since, so the frame pays them by
    ; name rather than walking the document to find them.
    def scrolledEls:[EVGElement]
    ; The page's own momentum, so a finger that leaves the glass moving keeps
    ; the document moving. It lives HERE and not in a host because both hosts
    ; want it and neither should have to get the physics right on its own —
    ; the browser page had its own copy and the iOS one had none, which is why
    ; a swipe on the phone stopped dead. See `EVGFling`.
    def fling:EVGFling (new EVGFling())
    ; How many times the tree has actually been laid out. Only `layoutCount`
    ; below reads it, and only `web/scroll-check.mjs` calls that: a scroll
    ; frame that lays out is the regression this counts, and it is not
    ; something a timing number would catch before someone noticed the page
    ; had gone slow again.
    def layouts:int 0
    def cullOffscreen:boolean true
    def transitions:EVGTransition (new EVGTransition())

    ; --- the library's controls ----------------------------------------------
    def bar:ProgressCtl (new ProgressCtl())
    def remember:CheckboxCtl (new CheckboxCtl())
    def tips:CollapsibleCtl (new CollapsibleCtl())
    def tabs:TabsCtl (new TabsCtl())
    def goals:TableCtl (new TableCtl())
    def sportOnly:ToggleCtl (new ToggleCtl())
    def plans:AccordionCtl (new AccordionCtl())
    def rest:RadioGroupCtl (new RadioGroupCtl())
    def session:ProgressCtl (new ProgressCtl())

    ; --- the training session's own state -------------------------------------
    ; The session's content, parsed from COMPACT. There is no second copy of
    ; the plan anywhere: the steppers write into the row and the spec line is
    ; built from the row again, so the two cannot drift apart.
    def rows:[CompactRow]
    def workTitle:string ""
    def moveIndex:int 0
    def moveCount:int 0
    ; How far the document screen is scrolled. The value the app keeps is the
    ; one the LAYOUT clamped: it knows the content height and this does not.
    def docScroll:double 0.0
    ; The document, its rows and the text they came from. An edit patches the
    ; one line it touched — see CompactDocument — so a family this model cannot
    ; express cannot be damaged by saving.
    def doc@(optional):CompactDocument
    def backend:RtBackendSim (new RtBackendSim())
    ; The "Lisää harjoitus" machine, ported from XState. The dialog below is
    ; drawn from its state and nothing else — which is the point of porting a
    ; machine rather than a screen.
    def addDialog:AddWorkoutDialog (new AddWorkoutDialog())
    ; The "Suunnittele viikko" machine, run from its own definition by the
    ; statechart runner — see PlanDialogHost. The job it starts is simulated
    ; with the same latency model the save is.
    def plan:PlanDialogHost (new PlanDialogHost())
    ; The conversation machine, likewise run from its definition, and the
    ; mock adapter that streams its reply on the clock.
    def chat:ChatHost (new ChatHost())
    ; The reference: the same seed file the recorder puts into the emulator,
    ; and the screen it is opened on. `section` is `activeNavSection` in the
    ; original, `calTab` its `mobileCalendarTab`, `weekStart` the `?week=`.
    def seed:RtSeed (new RtSeed())
    def section:string "calendar"
    def calTab:string "weeks"
    def weekStart:string "2026-02-09"
    def exWeekType:string "target"
    ; The day opened from the week list, or none — `editingDate`, and the
    ; single workout `selectedWorkout` when the day has one.
    def dayIso@(mutable):string ""
    ; A training calendar's Home tab — `activeTab`: diary, drills or stats.
    def homeTab@(mutable):string "diary"
    ; Harjoitteet: the category and the sort — `activeTab`, `sortBy`,
    ; `showSortDropdown` of `ExerciseListPanel`.
    def drillCat@(mutable):string "strength"
    def drillSort@(mutable):string "frequent"
    def drillSortOpen@(mutable):boolean false
    def drillCache@(mutable):[ExerciseSummary]
    def drillCacheKey@(mutable):string ""
    ; The Tilastot curves of the current tree, and their commands kept by
    ; data and size.
    def charts:[RtChartDef]
    def chartKeys:[string]
    def chartLists:[VlCommandList]
    ; The calendar menu is down — `showDropdown`.
    def calMenuOpen@(mutable):boolean false
    def addedSeq@(mutable):int 0
    def today:string "2026-09-03"
    ; The text fields: one per dialog that has one in the original, each a
    ; `InputCtl` named by its placeholder as the original's textareas are.
    ; The machine is the source of truth for the value — every edit is sent
    ; to it, and the field is set from it on every rebuild.
    def chatField:InputCtl (new InputCtl())
    def planField:InputCtl (new InputCtl())
    def addField:InputCtl (new InputCtl())
    ; The edit sheet's fields: the general feedback and one per weekday.
    def editField:InputCtl (new InputCtl())
    def dayFields:[InputCtl]
    ; The bar's "Lisää" opens a sheet over whichever section is up; it is not
    ; a section of its own, and the original keeps it the same way.
    def moreOpen@(mutable):boolean false
    ; How far the plan dialog's body is scrolled — the edit sheet is taller
    ; than a phone, and scrolls inside the dialog as the original's does.
    def modalScroll:double 0.0
    ; The calendar wizard, the job that writes the calendar it makes, and
    ; the toast that says so. Its six fields are the form's.
    def wizard:CalendarWizard (new CalendarWizard())
    def wizJob:RtBackendSim (new RtBackendSim())
    def wizScroll:double 0.0
    def toastText@(mutable):string ""
    def toastMs:double 0.0
    ; The year sheet page, and the editors' controls — one duration, one
    ; unit and one type per period, built when the seed is loaded.
    def ys:RtYearSheet (new RtYearSheet())
    def ysDur:[NumberCtl]
    def ysUnit:[SelectCtl]
    def ysType:[SelectCtl]
    def wizName:InputCtl (new InputCtl())
    def wizDesc:InputCtl (new InputCtl())
    def wizGoals:InputCtl (new InputCtl())
    def wizLevel:InputCtl (new InputCtl())
    def wizPass:InputCtl (new InputCtl())
    def wizConfirm:InputCtl (new InputCtl())
    def measurer:EVGLayout (new EVGLayout())
    def chatSim:RtChatSim (new RtChatSim())
    def chatJob:RtBackendSim (new RtBackendSim())
    def planJob:RtBackendSim (new RtBackendSim())
    def weekType:RadioGroupCtl (new RadioGroupCtl())
    ; One checkbox per weekday for each of the three by-day maps the machine
    ; keeps. They are drawn FROM the context on every rebuild and never
    ; toggled directly: the machine is the only place the answer lives.
    def replaceDay:[CheckboxCtl]
    def keepDay:[CheckboxCtl]
    def showDay:[CheckboxCtl]
    def doneMoves:int 0
    def timerOn:boolean false
    def timerRunning:boolean false
    def timerLeftMs:double 0.0
    def timerFullMs:double 60000.0

    ; "loading", "signin", "dashboard" or "session".
    def scene:string "loading"
    def elapsedMs:double 0.0
    def hovered:string ""
    def pressed:string ""
    def focused:string ""
    def pageW:double 980.0
    def pageH:double 760.0
    ; A finger rather than a mouse — what the host's `(pointer: coarse)`
    ; says. Stated to the sheet with the viewport, so `@media (pointer:
    ; coarse)` can make the targets bigger. See gallery/evg/web/responsive.
    def coarsePointer:boolean false

    Constructor () {
    }

    ; The plan arrives as TEXT rather than as a path: a browser has no
    ; filesystem, and the headless check should read the same bytes the page
    ; does rather than a fixture of its own.
    fn init:void (css:string compact:string) {
        def s (new EVGStyleSheet())
        s.parse(css)
        sheet = s
        this.loadCompact(compact)
        this.setupControls()
        this.rebuild()
    }

    fn loadCompact:void (compact:string) {
        def parsed:CompactDocument (CompactRowMapper.parseDocument(compact))
        doc = parsed
        rows = parsed.rows
        workTitle = parsed.title
        moveCount = 0
        moveIndex = 0
        def seen:int 0
        for rows r:CompactRow i {
            if (CompactRowEdit.isExercise(r)) {
                moveCount = (moveCount + 1)
                if (seen == 0) {
                    moveIndex = i
                    seen = 1
                }
            }
        }
    }

    ; Where the current move sits in the list of moves, counting from one —
    ; the number a person reads off a paper plan, not the row index.
    fn moveOrdinal:int () {
        def n:int 0
        def i:int 0
        while (i <= moveIndex) {
            if (CompactRowEdit.isExercise((at rows i))) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    ; The section heading above the current move. A plan that says "Pääosa"
    ; over four exercises says it once, and the screen shows one of them.
    fn sectionOf:string (index:int) {
        def out:string ""
        def i:int 0
        while (i < index) {
            def r:CompactRow (at rows i)
            if (CompactRowEdit.isSection(r)) {
                out = (CompactStatBuilder.label(r))
            }
            i = (i + 1)
        }
        return out
    }

    ; The next move, or where we already are when there is no next one.
    fn advanceMove:void () {
        def i:int (moveIndex + 1)
        while (i < (array_length rows)) {
            if (CompactRowEdit.isExercise((at rows i))) {
                moveIndex = i
                return
            }
            i = (i + 1)
        }
    }

    ; Every controller's fixed configuration, once. What CHANGES about them —
    ; the bar's value, which tab is on, which plan is open — is their own state
    ; and is not touched here.
    fn setupControls:void () {
        bar.tid = "rt-bar"
        bar.name = "Lataus"
        bar.maxValue = 100.0
        bar.value = 0.0

        remember.tid = "rt-remember"
        remember.name = "Muista minut tällä laitteella"

        tips.tid = "rt-tips"
        tips.name = "Lisää vinkkejä käyttöön"
        tips.triggerTid = "rt-tips-trigger"
        tips.contentTid = "rt-tips-content"
        tips.contentText = "Sanele treeni heti sen jälkeen — muisti on silloin tarkin. Kuvaa lautanen, älä laske kaloreita."

        tabs.tid = "rt-tabs"
        tabs.name = "Osiot"
        tabs.addItem("dash" "Dashboard" "" false)
        tabs.addItem("cal" "Kalenteri" "" false)
        tabs.addItem("drills" "Harjoitteet" "" false)
        tabs.value = "dash"
        tabs.rovingValue = "dash"

        ; Two columns and four rows, and the sorting is the controller's: a
        ; third click on the same header is the order the data arrived in,
        ; which a two-way toggle cannot reach.
        goals.tid = "rt-goals"
        goals.name = "Tavoitteet"
        goals.addColumn("goal" "Tavoite" false true)
        goals.addColumn("kind" "Tyyppi" false true)
        goals.addRecord("throw" ([] _:string ("Heittoharjoittelu" "Sport")))
        goals.addRecord("strength" ([] _:string ("Voimaharjoittelu" "Strength-Type")))
        goals.addRecord("speed" ([] _:string ("Nopeus ja loikat" "Training-Type")))
        goals.addRecord("endure" ([] _:string ("Kestävyys ja huolto" "Custom")))
        goals.pageSize = 4

        sportOnly.tid = "rt-sportonly"
        sportOnly.name = "Vain lajiharjoittelu"

        plans.tid = "rt-plans"
        plans.name = "Kaikki suunnitelmat"
        plans.addItem("y2526" "Kuulantyöntäjän vuosisuunnitelma 2025-2026"
            "Kaksi kilpailukautta, painotus voiman eri osa-alueissa: hypertrofia, hybridi, maksimi, räjähtävyys." false)
        plans.addItem("sm26" "M50 Kuulantyöntö SM 2026 — kuntoutus ja valmistautuminen"
            "Kevyempi jakso olkapään kuntoutuksen ympärillä, tekniikka pidetään yllä matalalla kuormalla." false)
        plans.openValue = "y2526"

        ; The rest between sets. A RADIO GROUP and not a row of toggles, and
        ; the difference is the one `DashboardDemo` measured: clicking the
        ; chosen item of a toggle group deselects it, and a rest picker with no
        ; rest picked is a timer with nothing to count.
        rest.tid = "rt-rest"
        rest.name = "Tauko"
        rest.addItem("30" "30s" false)
        rest.addItem("60" "60s" false)
        rest.addItem("90" "90s" false)
        rest.addItem("120" "120s" false)
        rest.value = "60"

        session.tid = "rt-session"
        session.name = "Harjoituksen eteneminen"
        session.maxValue = (int2double moveCount)
        session.value = 0.0

        weekType.tid = "rt-plan-type"
        weekType.name = "Viikon tyyppi"
        weekType.addItem("target" "Tavoiteviikko" false)
        weekType.addItem("light" "Kevyt viikko" false)
        weekType.value = "target"
        planJob.latencyMs = 900.0

        chatField.tid = "rt-chat-field"
        chatField.placeholder = "Kysy jotain päiväkirjastasi..."
        chatField.name = chatField.placeholder
        planField.tid = "rt-plan-field"
        planField.placeholder = "Esim. keskity kuntoutusjuoksuihin, kevyempi viikko"
        planField.name = planField.placeholder
        addField.tid = "rt-add-field"
        addField.placeholder = "Luo harjoitusohjelma, esim. \"viikon peruskuntojakso\""
        addField.name = addField.placeholder
        editField.tid = "rt-plan-edit-field"
        editField.placeholder = "Esim. pidä torstai kevyenä, lisää polven kuntoutusta, vältä kahta kovaa päivää peräkkäin"
        editField.name = editField.placeholder
        def fd:int 0
        while (fd < 7) {
            def dayField (new InputCtl())
            dayField.tid = ("rt-plan-day-field-" + (to_string fd))
            dayField.placeholder = "Päiväkohtainen ohje (esim. tiistai vain palauttava uinti)"
            dayField.name = dayField.placeholder
            push dayFields dayField
            fd = (fd + 1)
        }
        wizName.tid = "rt-wiz-name"
        wizName.placeholder = "esim. Juoksuharjoittelu 2026"
        wizName.name = wizName.placeholder
        wizDesc.tid = "rt-wiz-desc"
        wizDesc.placeholder = "Lyhyt kuvaus kalenterista..."
        wizDesc.name = wizDesc.placeholder
        wizGoals.tid = "rt-wiz-goals"
        wizGoals.placeholder = "esim. Juosta maraton alle 4 tunnissa"
        wizGoals.name = wizGoals.placeholder
        wizLevel.tid = "rt-wiz-level"
        wizLevel.placeholder = "esim. Puolimaraton 2h, juoksen 3x viikossa"
        wizLevel.name = wizLevel.placeholder
        wizPass.tid = "rt-wiz-pass"
        wizPass.kind = "password"
        wizPass.placeholder = "••••••••••••"
        wizPass.name = wizPass.placeholder
        wizConfirm.tid = "rt-wiz-confirm"
        wizConfirm.kind = "password"
        wizConfirm.placeholder = "••••••••••••"
        wizConfirm.name = wizConfirm.placeholder
        wizJob.latencyMs = 300.0
        def fields:[InputCtl] (this.fields())
        for fields f:InputCtl i {
            f.fontFamily = "Arial"
            f.fontSize = 13.0
            f.boxWidth = 300.0
        }
        def d:int 0
        while (d < 7) {
            def rc (new CheckboxCtl())
            rc.tid = ("rt-plan-day-" + (to_string d))
            rc.name = ("Korvaa " + (PlanDialogHost.dayName(d)))
            push replaceDay rc
            def kc (new CheckboxCtl())
            kc.tid = ("rt-plan-keep-" + (to_string d))
            kc.name = "Nykyinen on hyvä — pidä samana"
            push keepDay kc
            def sc (new CheckboxCtl())
            sc.tid = ("rt-plan-show-" + (to_string d))
            sc.name = ("Näytä edellinen " + (PlanDialogHost.dayName(((d + 1) % 7))))
            push showDay sc
            d = (d + 1)
        }
    }

    ; The machine, as text — the browser has no filesystem and the headless
    ; check should read the same bytes the page does. Until it is loaded the
    ; button on the dashboard does nothing, and says so by answering `false`.
    fn loadPlanMachine:void (text:string) {
        plan.load(text "2026-02-09")
    }

    fn loadChatMachine:void (text:string) {
        chat.load(text)
        chatJob.latencyMs = 600.0
    }

    ; The same file the reference recorder seeds from.
    fn loadReference:void (text:string) {
        seed.load(text)
        seed.anchor(today)
        if ((strlen seed.week) > 0) {
            weekStart = seed.week
        }
        ys.load(seed)
        clear ysDur
        clear ysUnit
        clear ysType
        for seed.periods p:RtPeriod i {
            def d (new NumberCtl())
            d.tid = ("rt-ys-dur-" + (to_string i))
            d.name = "Kesto"
            d.setValue((int2double p.durationWeeks))
            d.setRange(1.0 520.0)
            d.groupThousands = false
            push ysDur d
            def u (new SelectCtl())
            u.tid = ("rt-ys-unit-" + (to_string i))
            u.name = ""
            u.addItem("weeks" "vk" false)
            u.addItem("days" "pv" false)
            u.value = p.durationUnit
            push ysUnit u
            def t (new SelectCtl())
            t.tid = ("rt-ys-type-" + (to_string i))
            t.name = ""
            t.addItem("base" "Peruskausi" false)
            t.addItem("build" "Rakennuskausi" false)
            t.addItem("peak" "Huippukausi" false)
            t.addItem("race" "Kilpailukausi" false)
            t.addItem("recovery" "Palautuminen" false)
            t.addItem("transition" "Siirtymä" false)
            t.addItem("general" "Yleinen" false)
            t.value = p.kind
            push ysType t
        }
    }

    ; A phone is 390 by 844; on its side 844 by 390. The shell reads which.
    fn setPageSize:void (w:double h:double) {
        pageW = w
        pageH = h
        def fresh (new EVGLayout())
        fresh.setPageSize(pageW pageH)
        layout = fresh
        this.rebuild()
    }

    fn setPointerCoarse:void (c:boolean) {
        if (coarsePointer == c) {
            return
        }
        coarsePointer = c
        this.rebuild()
    }

    fn isPortrait:boolean () {
        return (pageH > pageW)
    }

    ; "/calendar/cal-plan?week=2026-02-09" — the route the reference opens.
    ; Only the calendar is routed today; everything else is a section.
    fn openRoute:boolean (route:string) {
        def q:int (RtEntry.findIn(route "?week="))
        if (q >= 0) {
            weekStart = (RtWeek.mondayOf((substring route (q + 6) (q + 16))))
        }
        ; `/summary/yearsheet` (and `/yearsheet`): the list; with an id, the
        ; sheet. Both draw inside the shell, without its header.
        if ((RtEntry.hasPrefix(route "/summary/yearsheet")) || (RtEntry.hasPrefix(route "/yearsheet"))) {
            def tail@(mutable):string ""
            if (RtEntry.hasPrefix(route "/summary/yearsheet/")) { tail = (substring route 19 (strlen route)) }
            if (RtEntry.hasPrefix(route "/yearsheet/")) { tail = (substring route 11 (strlen route)) }
            ys.openList()
            if ((strlen tail) > 0) {
                ys.openDetail()
            }
            docScroll = 0.0
            scene = "yearsheet"
            this.rebuild()
            return true
        }
        ; `/new-calendar` is a page of its own: the wizard, and nothing of the
        ; shell around it.
        if (RtEntry.hasPrefix(route "/new-calendar")) {
            wizard.open()
            wizScroll = 0.0
            scene = "wizard"
            this.rebuild()
            return true
        }
        if (RtEntry.hasPrefix(route "/calendar/")) {
            def rest:string (substring route 10 (strlen route))
            def qm:int (RtEntry.findIn(rest "?"))
            def id@(mutable):string rest
            if (qm >= 0) {
                id = (substring rest 0 qm)
            }
            seed.selectCalendar(id)
            section = "calendar"
            calTab = "weeks"
        }
        if ((route == "/") || (route == "/home")) {
            section = "home"
        }
        scene = "app"
        this.rebuild()
        return true
    }

    ; The chosen rest, in milliseconds. The controller holds a STRING, because
    ; that is what a radio value is; the arithmetic is this app's.
    fn restMs:double () {
        if (rest.value == "30") {
            return 30000.0
        }
        if (rest.value == "90") {
            return 90000.0
        }
        if (rest.value == "120") {
            return 120000.0
        }
        return 60000.0
    }

    ; --- what a controller MEANS, put where a reader will find it --------------
    ;
    ; gallery/ui's controllers publish their semantics as `rows()` — one UiRow
    ; per test id, in ARIA terms — because that is what the conformance harness
    ; diffs against Radix. `EVGA11yFromTree` reads the ELEMENT tree instead. So
    ; a controller dropped into an app's tree paints perfectly and says nothing
    ; at all, which is the one thing a canvas app cannot afford: the pixels are
    ; already unreadable.
    ;
    ; This copies one onto the other, by id. It is the app's job and not the
    ; library's: a controller cannot know it is being used inside a tree that
    ; someone will walk.
    fn adopt:void (host:EVGElement rows:[UiRow]) {
        def i:int 0
        while (i < (array_length rows)) {
            def row:UiRow (itemAt rows i)
            def found@(optional):EVGElement (RealTrainerDemo.byId(host row.tid))
            if found {
                def el:EVGElement (unwrap found)
                if (row.role > 0) {
                    el.role = (EVGA11yRole.ariaName(row.role))
                }
                if ((strlen row.name) > 0) {
                    el.a11yLabel = row.name
                }
                el.a11yExpanded = row.expanded
                el.a11yChecked = row.checked
                el.a11ySelected = row.selected
                el.a11yPressed = row.pressed
                el.a11ySorted = row.sorted
                el.a11yDisabled = row.disabled
                el.a11yLevel = row.level
                el.a11ySetSize = row.setSize
                el.a11yPosInSet = row.setPos
                el.a11yOrientation = row.orientation
                el.a11yCurrent = row.current
                el.a11yRoleDescription = row.roleDescription
                el.a11yHasPopup = row.hasPopup
                el.a11yHasRange = row.hasRange
                el.a11yValueMin = row.valueMin
                el.a11yValueMax = row.valueMax
                el.a11yHasValue = row.hasValueNow
                el.a11yValueNow = row.valueNow
                if (row.focusable) {
                    el.a11yFocusable = true
                }
            }
            i = (i + 1)
        }
    }

    ; Build a controller's subtree and say what it means, in that order —
    ; `build()` replaces the elements the last `adopt` wrote to.
    fn dress:void (ctl:UiCtl) {
        ctl.build()
        this.adopt((unwrap ctl.rootEl) (ctl.rows()))
    }

    ; --- scene one: the loader ------------------------------------------------

    sfn ring:EVGElement () {
        def ring (tree Rt (Ring))
        def i:int 0
        while (i < 12) {
            def blade (tree Rt (Blade (props (className ("rt-blade rt-blade-" + (to_string i))))))
            ring.addChild(blade)
            i = (i + 1)
        }
        return ring
    }

    fn loader:EVGElement () {
        this.dress(bar)
        def card (tree Rt
            (Card (props (id "rt-card"))
                (child (RealTrainerDemo.ring()))
                (Word
                    (WordA "REAL")
                    (WordB "TRAINER"))
                (Tagline "MAXIMUM EFFORT!")))
        card.addChild((unwrap bar.rootEl))
        return (tree Rt
            (Page (props (id "rt-page"))
                (child card)
                (Caption "Ladataan...")
                (Pct "0 %")))
    }

    ; --- scene two: the sign-in page ------------------------------------------

    ; The three things the real page opens with, as three rows: a badge, a
    ; sentence whose first words are the verb, and an example in a chip.
    sfn feature:EVGElement (rowId:string icon:string strong:string rest:string example:string) {
        def glyph (tree Rt (Icon))
        glyph.svgSource = icon
        def badge (tree Rt (Badge))
        badge.addChild(glyph)
        return (tree Rt
            (Feat (props (id rowId))
                (child badge)
                (FeatText
                    (FeatHead
                        (Strong strong)
                        (Rest rest))
                    (Chip
                        (ChipText example)))))
    }

    ; --- the icons ------------------------------------------------------------
    ;
    ; Hand-drawn in the shape lucide's files have — 24x24, `currentColor` so the
    ; stylesheet owns the colour — and small enough to read: a keyboard is a
    ; rounded box with keys, a microphone a capsule on a stand, a camera a body
    ; with a lens. Not traced from anything.
    sfn svgOpen:string () {
        return "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='currentColor'>"
    }

    sfn iconKeyboard:string () {
        return ((RealTrainerDemo.svgOpen()) +
            "<path d='M3 6h18a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1zm1 2v8h16V8H4z'/>" +
            "<path d='M6 10h2v2H6zm3 0h2v2H9zm3 0h2v2h-2zm3 0h2v2h-2zM7 13h10v2H7z'/></svg>")
    }

    sfn iconMic:string () {
        return ((RealTrainerDemo.svgOpen()) +
            "<path d='M12 3a3 3 0 0 1 3 3v6a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3z'/>" +
            "<path d='M6 11h2a4 4 0 0 0 8 0h2a6 6 0 0 1-5 5.9V19h3v2H8v-2h3v-2.1A6 6 0 0 1 6 11z'/></svg>")
    }

    sfn iconCamera:string () {
        return ((RealTrainerDemo.svgOpen()) +
            "<path d='M9 4h6l1.5 2H21a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4.5L9 4zm-5 4v10h16V8h-4.6l-1.5-2h-3.8L8.6 8H4z'/>" +
            "<path d='M12 9.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7zm0 2a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z'/></svg>")
    }

    fn signin:EVGElement () {
        def feats (tree Rt (Feats))
        feats.addChild((RealTrainerDemo.feature(
            "rt-feat-type" (RealTrainerDemo.iconKeyboard())
            "Käytä" "luonnollista kieltä" "Aamulenkki 5km. Aamupala: puuroa ja kahvia.")))
        feats.addChild((RealTrainerDemo.feature(
            "rt-feat-voice" (RealTrainerDemo.iconMic())
            "Sanele," "kirjoita tai kuvaa" "Kuntosali 45min. Lounas: kanasalaatti.")))
        feats.addChild((RealTrainerDemo.feature(
            "rt-feat-photo" (RealTrainerDemo.iconCamera())
            "Kuvaa" "ruoka-annos tai treeniloki" "AI tulkitsee kuvan ja täydentää päiväkirjan.")))

        this.dress(remember)
        this.dress(tips)

        def panel (tree Rt
            (Panel (props (id "rt-panel"))
                (child feats)
                (Note "Aloituksessa saat 1 000 000 credittiä koekäyttöön.")
                (Note "Tämän jälkeen voit ostaa lisää: 4,95 € / 1 000 000 credittiä.")))
        panel.addChild((unwrap remember.rootEl))
        panel.addChild((tree Rt
            (Google
                (GMark
                    (GMarkTx "G"))
                (GoogleTx "Jatka Googlella"))))
        panel.addChild((unwrap tips.rootEl))
        return (tree Rt
            (Page (props (id "rt-page"))
                (Brand "REALTRAINER")
                (child panel)
                (Foot "Kirjautumalla hyväksyt käyttöehdot ja tietosuojakäytännön.")))
    }


    fn phoneMain:EVGElement () {
        def main (tree Rt (PhMain))
        main.setAttribute("overflow" "hidden")
        main.scrollTop = docScroll
        def body (tree Rt (PhBody))
        if (section == "calendar") {
            this.calendarSection(body)
        }
        if (section == "chat") {
            body.addChild((this.chatBody()))
        }
        if (section == "dashboard") {
            this.phoneDashboard(body)
        }
        if (section == "home") {
            this.homeSection(body)
        }
        main.addChild(body)
        return main
    }

    ; Home, as `HomeView` has it: the two actions, the quick entry with its
    ; image and send buttons, and the coming events — none, and the past ones
    ; behind a button that counts them.
    fn homeSection:void (body:EVGElement) {
        def actions (tree Rt (CalActions))
        actions.addChild((this.calButton("rt-add" "Lisää harjoitus" (RtIcons.penLine("#ffffff")))))
        if ((array_length seed.periods) > 0) {
            actions.addChild((this.calButton("rt-plan-update" "Päivitä suunnitelma" (RtIcons.refreshCw("#ffffff")))))
        }
        body.addChild(actions)
        def home (tree Rt (Col (props (className "rt-home"))))
        def entry (tree Rt (ModalRow))
        entry.addChild((this.iconBtn("rt-home-image" "Lisää kuva" (RtIcons.penLine("#999999")))))
        def box (tree Rt (HomeBox))
        box.addChild((tree Rt (FieldGhost "Kirjoita merkintä... esim. \"maanantai: juoksu 45min\"")))
        entry.addChild(box)
        def send (this.iconBtn("rt-home-send" "" (RtIcons.chevronRight("#ffffff"))))
        send.className = "rt-icon-btn rt-send-btn"
        entry.addChild(send)
        home.addChild(entry)
        def empty (tree Rt (Row (props (className "rt-home-center"))))
        empty.addChild((tree Rt (ChatPara (props (id "rt-home-empty") (className "rt-home-empty")) "Ei tulevia tapahtumia")))
        home.addChild(empty)
        ; The selected calendar's past entries, counted on the button — or,
        ; with none, the hint the original shows a new calendar.
        def mine:[RtSeedEntry] (seed.selectedEntries())
        def past@(mutable):int 0
        for mine e:RtSeedEntry i {
            if ((RtWeek.daysOf(e.date)) < (RtWeek.daysOf(today))) {
                past = (past + 1)
            }
        }
        if (past > 0) {
            def pastRow (tree Rt (Row (props (className "rt-home-center"))))
            def pastBtn (this.exButton("rt-home-past" (("Näytä menneet (" + (to_string past)) + ")") (("Näytä menneet (" + (to_string past)) + ")")))
            pastBtn.className = "rt-ex-btn rt-link-btn"
            RealTrainerDemo.tintText(pastBtn "rt-ex-btn-text rt-link-text")
            pastRow.addChild(pastBtn)
            home.addChild(pastRow)
        } {
            def hint (tree Rt (Row (props (className "rt-home-center"))))
            hint.addChild((tree Rt (ChatPara (props (id "rt-home-hint")) "Kirjoita yllä olevaan kenttään lisätäksesi ensimmäisen merkinnän")))
            home.addChild(hint)
        }
        body.addChild(home)
    }

    ; The dashboard, as `DashboardView` has it on the phone: the heading and
    ; the edit button, the active plan with its card, and the period the
    ; calendar is in — counted from the plan's start to today.
    fn phoneDashboard:void (body:EVGElement) {
        def dash (tree Rt (Col (props (className "rt-dash-phone"))))
        def top (tree Rt (ModalRow))
        top.addChild((tree Rt (DashHd "Dashboard")))
        top.addChild((tree Rt (Spacer)))
        def edit (this.exButton("rt-dash-edit" "Muokkaa vuosisuunnitelmaa" "Muokkaa vuosisuunnitelmaa"))
        edit.className = "rt-ex-btn rt-outline-btn"
        top.addChild(edit)
        dash.addChild(top)
        def active (tree Rt (ModalRow))
        active.addChild((tree Rt (DashH2 (props (id "rt-h-plan")) "Aktiivinen suunnitelma")))
        active.addChild((tree Rt (Spacer)))
        def open (this.exButton("rt-dash-open" "Avaa suunnitelma" "Avaa suunnitelma ›"))
        open.className = "rt-ex-btn rt-link-btn"
        RealTrainerDemo.tintText(open "rt-ex-btn-text rt-link-text")
        active.addChild(open)
        dash.addChild(active)
        def card (tree Rt (DashCard (props (id "rt-dash-plan"))))
        card.addChild((tree Rt (DashH3 (props (id "rt-dash-plan-name")) seed.sheetName)))
        card.addChild((tree Rt (DashPara (props (id "rt-dash-plan-desc")) seed.sheetDescription)))
        card.addChild((tree Rt (DashPara (props (id "rt-dash-plan-when")) ("Aloitettu: " + (RtWeek.fiDate(seed.sheetStart))))))
        dash.addChild(card)
        if ((array_length seed.periods) > 0) {
            def period:RtPeriod (seed.firstPeriod())
            dash.addChild((tree Rt (DashH3 (props (id "rt-h-period") (className "rt-dash-h2")) "Nykyinen jakso")))
            def now (tree Rt (DashCard (props (id "rt-dash-period"))))
            def nameRow (tree Rt (ModalRow))
            nameRow.addChild((tree Rt (DashPara (props (id "rt-dash-period-name") (className "rt-dash-h3")) period.name)))
            nameRow.addChild((tree Rt (Spacer)))
            nameRow.addChild((tree Rt (DashMeta (props (className "rt-dash-kind")) period.kind)))
            now.addChild(nameRow)
            def weekNo:int (to_int (((int2double ((RtWeek.daysOf(today)) - (RtWeek.daysOf(seed.sheetStart))))) / 7.0))
            now.addChild((tree Rt (DashPara (props (id "rt-dash-week")) ((("Viikko " + (to_string (weekNo + 1))) + " / ") + (to_string period.durationWeeks)))))
            def bar (tree Rt (Row (props (className "rt-dash-bar"))))
            def fill (tree Rt (Row (props (className "rt-dash-bar-fill"))))
            def pct@(mutable):int 0
            if (period.durationWeeks > 0) {
                pct = (to_int ((int2double ((weekNo + 1) * 100)) / (int2double period.durationWeeks)))
            }
            if (pct > 100) { pct = 100 }
            fill.setAttribute("width" ((to_string pct) + "%"))
            bar.addChild(fill)
            now.addChild(bar)
            def ends:string (RtWeek.shifted(seed.sheetStart ((period.durationWeeks * 7) - 1)))
            def dates (tree Rt (ModalRow))
            dates.addChild((tree Rt (DashMeta (RtWeek.fiDate(seed.sheetStart)))))
            dates.addChild((tree Rt (Spacer)))
            dates.addChild((tree Rt (DashMeta (RtWeek.fiDate(ends)))))
            now.addChild(dates)
            now.addChild((tree Rt (DashPara (props (id "rt-dash-goal") (className "rt-dash-goal")) ("Tavoite: " + period.goals))))
            dash.addChild(now)
        }
        ; The goals: the sheet's rows, once it has any — the original shows
        ; them from the saved sheet, which has rows once the page opened it.
        if ((array_length ys.rows) > 0) {
            dash.addChild((tree Rt (DashH2 (props (id "rt-h-goals")) "Tavoitteet")))
            for ys.rows r:RtYsRow i {
                dash.addChild((tree Rt (DashPara (props (id ("rt-dash-goal-row-" + (to_string i)))) ((r.name + " ") + r.kind))))
            }
        }
        body.addChild(dash)
    }

    ; --- the calendar wizard -------------------------------------------------------
    ; `CalendarWizard.tsx`, step by step: the header with the dots, the
    ; step's body, and the footer that goes back or on. Everything drawn is
    ; read from `wizard`; the gates are its.
    fn wizardScreen:EVGElement () {
        def page (tree Rt (Wiz))
        def head (tree Rt (WizHead))
        head.addChild((this.iconBtn("rt-wiz-close" "Sulje" (RtIcons.x("#f2f2f2")))))
        def titles (tree Rt (Col))
        titles.addChild((tree Rt (WizHd "Luo kalenteri")))
        titles.addChild((tree Rt (WizPara (props (id "rt-wiz-step")) (wizard.stepText()))))
        head.addChild(titles)
        head.addChild((tree Rt (Spacer)))
        def dots (tree Rt (WizDots))
        def i@(mutable):int 0
        while (i < (wizard.stepCount())) {
            def dot (tree Rt (WizDot))
            if (i == (wizard.stepIndex())) {
                dot.className = "rt-wiz-dot rt-wiz-dot-on"
            }
            if (i < (wizard.stepIndex())) {
                dot.className = "rt-wiz-dot rt-wiz-dot-done"
            }
            dots.addChild(dot)
            i = (i + 1)
        }
        head.addChild(dots)
        page.addChild(head)
        def body (tree Rt (WizBody))
        body.setAttribute("overflow" "hidden")
        body.setAttribute("height" ((to_string (to_int (pageH - 144.0))) + "px"))
        body.scrollTop = wizScroll
        def st:string wizard.state
        if (st == "type") { this.wizardTypeStep(body) }
        if (st == "details") { this.wizardDetailsStep(body) }
        if (st == "encryption") { this.wizardEncryptionStep(body) }
        if ((st == "appearance") || (st == "creating")) { this.wizardAppearanceStep(body) }
        page.addChild(body)
        page.addChild((this.wizardFoot()))
        page.addChild((this.toasts()))
        return page
    }

    fn wizAccent:string (on:boolean) {
        if on { return "#f97316" }
        return "#999999"
    }

    ; Step one: the thirteen types, two to a row on a phone. A card's name is
    ; its label and its description, as the tree reads a button with both.
    fn wizardTypeStep:void (body:EVGElement) {
        def center (tree Rt (WizCenter))
        center.addChild((tree Rt (WizH2 (props (id "rt-wiz-h2")) "Valitse tyyppi")))
        center.addChild((tree Rt (WizPara (props (id "rt-wiz-sub")) "Millaista sisältöä haluat kirjata?")))
        body.addChild(center)
        def grid (tree Rt (WizGrid))
        def cw:int (to_int ((pageW - 44.0) / 2.0))
        for wizard.kinds k:RtCalendarKind i {
            def on:boolean (k.key == wizard.typeKey)
            def card (tree Rt (WizCard))
            card.id = ("rt-wiz-type-" + k.key)
            card.a11yLabel = ((k.label + " ") + k.description)
            card.setAttribute("width" ((to_string cw) + "px"))
            if on {
                card.className = "rt-wiz-card rt-wiz-card-on"
            }
            def ic (tree Rt (WizIcon))
            ic.svgSource = (RtIcons.kindIcon(k.key (this.wizAccent(on))))
            card.addChild(ic)
            card.addChild((tree Rt (WizCardTitle k.label)))
            card.addChild((tree Rt (WizCardDesc k.description)))
            grid.addChild(card)
        }
        body.addChild(grid)
    }

    fn wizBadge:EVGElement (icon:string className:string) {
        def badge (tree Rt (WizBadge))
        badge.className = className
        def ic (tree Rt (WizIcon))
        ic.svgSource = icon
        badge.addChild(ic)
        return badge
    }

    ; Step two: the name, which is required, and three that are not.
    fn wizardDetailsStep:void (body:EVGElement) {
        def kind:RtCalendarKind (wizard.selectedKind())
        def center (tree Rt (WizCenter))
        center.addChild((this.wizBadge((RtIcons.kindIcon(kind.key "#f97316")) "rt-wiz-badge")))
        center.addChild((tree Rt (WizH2 (props (id "rt-wiz-h2")) "Kalenterin tiedot")))
        center.addChild((tree Rt (WizPara (props (id "rt-wiz-sub")) kind.description)))
        body.addChild(center)
        body.addChild((tree Rt (WizLabel "Nimi *")))
        body.addChild((this.fieldBox(wizName)))
        body.addChild((tree Rt (WizLabel "Kuvaus")))
        body.addChild((this.fieldBox(wizDesc)))
        body.addChild((tree Rt (WizLabel "Tavoitteet")))
        body.addChild((this.fieldBox(wizGoals)))
        body.addChild((tree Rt (WizLabel "Nykyinen taso")))
        body.addChild((this.fieldBox(wizLevel)))
    }

    ; Step three: encryption, off by default. The toggle card is a box with
    ; no role in the original and is one here; it answers to its id.
    fn wizardEncryptionStep:void (body:EVGElement) {
        def on:boolean wizard.encrypted
        def center (tree Rt (WizCenter))
        center.addChild((this.wizBadge((RtIcons.shield("#22c55e")) "rt-wiz-badge rt-wiz-badge-green")))
        center.addChild((tree Rt (WizH2 (props (id "rt-wiz-h2")) "Suojaa tietosi")))
        center.addChild((tree Rt (WizPara (props (id "rt-wiz-sub")) "Salaus suojaa tietosi niin, ettei kukaan muu voi lukea niitä - edes me.")))
        body.addChild(center)
        def box (tree Rt (WizBox (props (id "rt-wiz-encrypt"))))
        if on {
            box.className = "rt-wiz-box rt-wiz-box-on"
        }
        def row (tree Rt (ModalRow))
        def lockColor@(mutable):string "#999999"
        if on { lockColor = "#22c55e" }
        row.addChild((this.wizBadge((RtIcons.lock(lockColor)) "rt-wiz-badge rt-wiz-badge-sm")))
        def col (tree Rt (Col (props (className "rt-wiz-box-col"))))
        def line (tree Rt (ModalRow))
        line.addChild((tree Rt (WizTx "Salaa tämä kalenteri")))
        line.addChild((tree Rt (Spacer)))
        def sw (tree Rt (WizSwitch))
        def knob (tree Rt (WizKnob))
        if on {
            sw.className = "rt-wiz-switch rt-wiz-switch-on"
            knob.className = "rt-wiz-knob rt-wiz-knob-on"
        }
        sw.addChild(knob)
        line.addChild(sw)
        col.addChild(line)
        col.addChild((tree Rt (WizPara (props (id "rt-wiz-encrypt-desc")) "Vain sinä voit nähdä sisällön salasanallasi")))
        row.addChild(col)
        box.addChild(row)
        body.addChild(box)
        if on {
            def warn (tree Rt (WizBox (props (className "rt-wiz-box rt-wiz-warn"))))
            def wrow (tree Rt (ModalRow))
            def wi (tree Rt (PhIcon))
            wi.svgSource = (RtIcons.alertTriangle("#f59e0b"))
            wrow.addChild(wi)
            def wcol (tree Rt (Col (props (className "rt-wiz-box-col"))))
            wcol.addChild((tree Rt (WizTx (props (className "rt-wiz-text rt-wiz-amber")) "Tärkeää!")))
            wcol.addChild((tree Rt (WizPara (props (id "rt-wiz-warn-text")) "Jos unohdat salasanan, emme voi palauttaa tietojasi. Tallenna salasana turvalliseen paikkaan.")))
            wrow.addChild(wcol)
            warn.addChild(wrow)
            body.addChild(warn)
            body.addChild((tree Rt (WizLabel "Salaussalasana")))
            def prow (tree Rt (ModalRow))
            prow.addChild((this.fieldBox(wizPass)))
            def showText@(mutable):string "Näytä"
            if wizard.showPassword { showText = "Piilota" }
            prow.addChild((this.wizButton("rt-wiz-show" showText "" "rt-wiz-btn rt-wiz-link")))
            body.addChild(prow)
            if ((strlen wizard.password) > 0) {
                def score:int (wizard.strength())
                def tone@(mutable):string "rt-wiz-red"
                if (score > 1) { tone = "rt-wiz-orange" }
                if (score > 2) { tone = "rt-wiz-yellow" }
                if (score > 3) { tone = "rt-wiz-green" }
                def bars (tree Rt (WizBars))
                def b@(mutable):int 1
                while (b <= 5) {
                    def bar (tree Rt (WizBar))
                    if (b <= score) {
                        bar.className = ("rt-wiz-bar rt-wiz-bar-" + tone)
                    }
                    bars.addChild(bar)
                    b = (b + 1)
                }
                body.addChild(bars)
                body.addChild((tree Rt (WizPara (props (id "rt-wiz-strength") (className ("rt-wiz-para " + tone))) (wizard.strengthLabel()))))
            }
            body.addChild((tree Rt (WizLabel "Vahvista salasana")))
            def cb:EVGElement (this.fieldBox(wizConfirm))
            if ((strlen wizard.confirm) > 0) {
                if (wizard.passwordsMatch()) {
                    cb.className = (cb.className + " rt-field-ok")
                } {
                    cb.className = (cb.className + " rt-field-bad")
                }
            }
            body.addChild(cb)
            if ((strlen wizard.confirm) > 0) {
                if (wizard.passwordsMatch()) {
                    body.addChild((tree Rt (WizPara (props (id "rt-wiz-match") (className "rt-wiz-para rt-wiz-green")) "Salasanat täsmäävät")))
                } {
                    body.addChild((tree Rt (WizPara (props (id "rt-wiz-match") (className "rt-wiz-para rt-wiz-red")) "Salasanat eivät täsmää")))
                }
            }
        } {
            def info (tree Rt (WizBox))
            info.addChild((tree Rt (WizPara (props (id "rt-wiz-noenc")) "Ilman salausta tiedot tallennetaan palvelimelle suojaamattomina. Ne ovat edelleen yksityisiä, mutta ylläpito voi teknisesti nähdä ne.")))
            body.addChild(info)
        }
    }

    ; Step four: the preview, the ten colours, the three visibilities.
    fn wizardAppearanceStep:void (body:EVGElement) {
        def kind:RtCalendarKind (wizard.selectedKind())
        def center (tree Rt (WizCenter))
        center.addChild((tree Rt (WizH2 (props (id "rt-wiz-h2")) "Ulkoasu")))
        center.addChild((tree Rt (WizPara (props (id "rt-wiz-sub")) "Valitse väri ja näkyvyysasetukset")))
        body.addChild(center)
        ; The preview's border is the chosen colour — a class of its own,
        ; with no border colour of its own for the stylesheet to put back.
        def preview (tree Rt (WizBox (props (className "rt-wiz-preview"))))
        preview.setAttribute("border-color" wizard.color)
        def prow (tree Rt (ModalRow))
        prow.addChild((this.wizBadge((RtIcons.kindIcon(kind.key wizard.color)) "rt-wiz-badge rt-wiz-badge-sm")))
        def pcol (tree Rt (Col (props (className "rt-wiz-box-col"))))
        def nrow (tree Rt (ModalRow))
        def shown@(mutable):string (wizard.nameTrimmed())
        if ((strlen shown) == 0) { shown = "Kalenterin esikatselu" }
        nrow.addChild((tree Rt (WizTx shown)))
        if wizard.encrypted {
            def li (tree Rt (PhIcon (props (className "rt-ph-icon rt-ph-icon-sm"))))
            li.svgSource = (RtIcons.lock("#22c55e"))
            nrow.addChild(li)
        }
        pcol.addChild(nrow)
        pcol.addChild((tree Rt (WizPara (props (id "rt-wiz-preview-kind")) kind.label)))
        prow.addChild(pcol)
        preview.addChild(prow)
        body.addChild(preview)
        body.addChild((tree Rt (WizLabel "Väri")))
        def swatches (tree Rt (WizGrid))
        for wizard.colors c:string i {
            def sw (tree Rt (WizSwatch))
            sw.id = ("rt-wiz-color-" + (to_string i))
            sw.a11yLabel = ""
            sw.setAttribute("background-color" c)
            if (c == wizard.color) {
                sw.className = "rt-wiz-swatch rt-wiz-swatch-on"
            }
            swatches.addChild(sw)
        }
        body.addChild(swatches)
        body.addChild((tree Rt (WizLabel "Näkyvyys")))
        def vis (tree Rt (ModalRow))
        vis.addChild((this.wizVis("private" "Yksityinen" (RtIcons.lock((this.wizAccent((wizard.visibility == "private"))))))))
        vis.addChild((this.wizVis("group" "Ryhmälle" (RtIcons.users((this.wizAccent((wizard.visibility == "group"))))))))
        vis.addChild((this.wizVis("public" "Julkinen" (RtIcons.unlock((this.wizAccent((wizard.visibility == "public"))))))))
        body.addChild(vis)
    }

    fn wizVis:EVGElement (key:string label:string icon:string) {
        def b (tree Rt (WizVis))
        b.id = ("rt-wiz-vis-" + key)
        b.a11yLabel = label
        if (wizard.visibility == key) {
            b.className = "rt-wiz-vis rt-wiz-vis-on"
        }
        def ic (tree Rt (PhIcon))
        ic.svgSource = icon
        b.addChild(ic)
        b.addChild((tree Rt (WizCardTitle label)))
        return b
    }

    ; Back or cancel on the left; next, or create on the last step, on the
    ; right — disabled while the step's gate is shut, as the original's.
    fn wizardFoot:EVGElement () {
        def foot (tree Rt (WizFoot))
        if ((wizard.stepIndex()) > 0) {
            foot.addChild((this.wizButton("rt-wiz-back" "Takaisin" (RtIcons.chevronLeft("#f2f2f2")) "rt-wiz-btn")))
        } {
            foot.addChild((this.wizButton("rt-wiz-cancel" "Peruuta" (RtIcons.chevronLeft("#f2f2f2")) "rt-wiz-btn")))
        }
        foot.addChild((tree Rt (Spacer)))
        if ((wizard.isLast()) == false) {
            def next (this.wizButton("rt-wiz-next" "Seuraava" (RtIcons.chevronRight("#ffffff")) "rt-wiz-btn rt-wiz-primary"))
            if ((wizard.canGoNext()) == false) {
                next.a11yDisabled = true
                next.className = "rt-wiz-btn rt-wiz-primary rt-wiz-off"
            }
            foot.addChild(next)
        } {
            def creating:boolean (wizard.state == "creating")
            def label@(mutable):string "Luo kalenteri"
            if creating { label = "Luodaan..." }
            def go (this.wizButton("rt-wiz-create" label (RtIcons.check("#ffffff")) "rt-wiz-btn rt-wiz-go"))
            if (creating || ((strlen (wizard.nameTrimmed())) == 0)) {
                go.a11yDisabled = true
                go.className = "rt-wiz-btn rt-wiz-go rt-wiz-off"
            }
            foot.addChild(go)
        }
        return foot
    }

    fn wizButton:EVGElement (id:string label:string icon:string className:string) {
        def b (tree Rt (WizBtn))
        b.id = id
        b.a11yLabel = label
        b.className = className
        if ((strlen icon) > 0) {
            def ic (tree Rt (PhIcon (props (className "rt-ph-icon rt-ph-icon-sm"))))
            ic.svgSource = icon
            b.addChild(ic)
        }
        b.addChild((tree Rt (WizBtnTx label)))
        return b
    }

    fn pressWizard:boolean (id:string) {
        if ((id == "rt-wiz-close") || (id == "rt-wiz-cancel")) {
            wizard.close()
            scene = "app"
            section = "home"
            docScroll = 0.0
            return true
        }
        if (id == "rt-wiz-back") { return (wizard.goPrev()) }
        if (id == "rt-wiz-next") {
            def moved:boolean (wizard.goNext())
            if moved { wizScroll = 0.0 }
            return moved
        }
        if (RtEntry.hasPrefix(id "rt-wiz-type-")) {
            return (wizard.setType((substring id 12 (strlen id))))
        }
        if (id == "rt-wiz-encrypt") { return (wizard.toggleEncrypted()) }
        if (id == "rt-wiz-show") { return (wizard.toggleShowPassword()) }
        def ci:int (RealTrainerDemo.digitOf(id "rt-wiz-color-"))
        if (ci >= 0) { return (wizard.setColorAt(ci)) }
        if (RtEntry.hasPrefix(id "rt-wiz-vis-")) {
            return (wizard.setVisibility((substring id 11 (strlen id))))
        }
        if (id == "rt-wiz-create") {
            def started:boolean (wizard.submit())
            if started {
                wizJob.failNext = backend.failNext
                backend.failNext = false
                wizJob.begin((wizard.nameTrimmed()))
            }
            return started
        }
        return false
    }

    ; The job answered. Made: the calendar joins the seed's, is selected,
    ; and Home opens with a toast — `navigateTo('home')` and
    ; `toast.success`. Not made: back to the last step, and the toast says so.
    fn wizardDone:void (ok:boolean) {
        if (ok == false) {
            wizard.complete(false)
            toastText = "Päiväkirjan luonti epäonnistui"
            toastMs = 4000.0
            return
        }
        def id:string ("cal-new-" + (to_string (wizard.created + 1)))
        def newName:string (wizard.nameTrimmed())
        seed.addCalendar(id newName wizard.typeKey wizard.color)
        seed.selectCalendar(id)
        toastText = (("Päiväkirja \"" + newName) + "\" luotu")
        if wizard.encrypted {
            toastText = (("Salattu päiväkirja \"" + newName) + "\" luotu 🔐")
        }
        wizard.complete(true)
        scene = "app"
        section = "home"
        docScroll = 0.0
        toastMs = 4000.0
    }

    ; --- the year sheet ------------------------------------------------------------
    ; `YearSheetPageV2`: the list, or one sheet — inside the shell, under
    ; the bar, without the header. Everything is read from `ys` and the seed.
    fn yearsheetScreen:EVGElement () {
        def page (tree Rt (Phone))
        def main (tree Rt (PhMain))
        main.setAttribute("overflow" "hidden")
        main.scrollTop = docScroll
        def body (tree Rt (PhBody))
        if (ys.view == "list") {
            this.ysList(body)
        } {
            this.ysDetail(body)
        }
        main.addChild(body)
        if (this.isPortrait()) {
            page.addChild(main)
            this.overlays(page)
            page.addChild((this.bottomNav()))
            page.addChild((this.toasts()))
            return page
        }
        ; On its side the shell is the rail and a column beside it, here too.
        page.className = "rt-phone rt-phone-wide"
        page.addChild((this.iconRail()))
        def side (tree Rt (PhSide))
        side.addChild(main)
        page.addChild(side)
        this.overlays(page)
        page.addChild((this.toasts()))
        return page
    }

    ; The list: a card per sheet, named by everything on it.
    fn ysList:void (body:EVGElement) {
        def head (tree Rt (YsHead))
        head.addChild((this.iconBtn("rt-ys-back" "" (RtIcons.arrowLeft("#f2f2f2")))))
        def titles (tree Rt (Col))
        titles.addChild((tree Rt (YsHd "Vuosisuunnitelmat")))
        def n@(mutable):int 0
        if ((strlen seed.sheetId) > 0) { n = 1 }
        titles.addChild((tree Rt (YsPara (props (id "rt-ys-count")) ((to_string n) + " suunnitelmaa"))))
        head.addChild(titles)
        body.addChild(head)
        if (n == 0) {
            body.addChild((tree Rt (YsPara (props (id "rt-ys-none")) "Sinulla ei ole vielä vuosisuunnitelmia.")))
            return
        }
        def card (tree Rt (YsCard))
        def meta:string ((((RtWeek.fiDate(seed.sheetStart)) + " • ") + (to_string (array_length seed.periods))) + (" kautta Luotu: " + (RtWeek.fiDate(today))))
        def open (tree Rt (YsCardBtn))
        open.id = ("rt-ys-open-" + seed.sheetId)
        open.a11yLabel = ((((seed.sheetName + " ") + seed.sheetDescription) + " ") + meta)
        open.addChild((tree Rt (YsH3 (props (id "rt-ys-card-name")) seed.sheetName)))
        if ((strlen seed.sheetDescription) > 0) {
            open.addChild((tree Rt (YsPara (props (id "rt-ys-card-desc")) seed.sheetDescription)))
        }
        open.addChild((tree Rt (YsDim meta)))
        card.addChild(open)
        card.addChild((this.iconBtn(("rt-ys-delete-" + seed.sheetId) "Poista suunnitelma" (RtIcons.trash("#999999")))))
        body.addChild(card)
    }

    ; One sheet: the header and its toolbar, an editor when one is on, the
    ; grid, the legend, and the periods with their example weeks.
    fn ysDetail:void (body:EVGElement) {
        def head (tree Rt (YsHead))
        head.addChild((this.iconBtn("rt-ys-back" "" (RtIcons.arrowLeft("#f2f2f2")))))
        def titles (tree Rt (Col))
        titles.addChild((tree Rt (YsHd seed.sheetName)))
        def range:string ((((RtWeek.fiDate(seed.sheetStart)) + " - ") + (RtWeek.fiDate((RtYearSheet.sheetEnd(seed))))) + (" • " + seed.calendarName))
        titles.addChild((tree Rt (YsPara (props (id "rt-ys-range")) range)))
        head.addChild(titles)
        body.addChild(head)
        def tools (tree Rt (YsTools))
        tools.addChild((this.iconBtn("rt-ys-reset" "Poista ja aloita alusta" (RtIcons.rotateCcw("#ef4444")))))
        tools.addChild((this.iconBtn("rt-ys-copy" "Kopioi JSON leikepöydälle" (RtIcons.copy("#f2f2f2")))))
        tools.addChild((this.iconBtn("rt-ys-paste" "Liitä JSON leikepöydältä" (RtIcons.clipboardPaste("#f2f2f2")))))
        tools.addChild((this.ysTool("rt-ys-ai" "Muokkaa vuosisuunnitelmaa" (RtIcons.sparkles("#ffffff")) "rt-ys-tool rt-ys-tool-violet")))
        tools.addChild((this.ysTool("rt-ys-features" "Featuret" (RtIcons.barChart("#f2f2f2")) "rt-ys-tool rt-ys-tool-outline")))
        def pcls@(mutable):string "rt-ys-tool"
        if (ys.editor == "periods") { pcls = "rt-ys-tool rt-ys-tool-on" }
        tools.addChild((this.ysTool("rt-ys-periods" "Kaudet" (RtIcons.penLine("#f2f2f2")) pcls)))
        def rcls@(mutable):string "rt-ys-tool"
        if (ys.editor == "rows") { rcls = "rt-ys-tool rt-ys-tool-on" }
        tools.addChild((this.ysTool("rt-ys-rows" "Rivit" (RtIcons.penLine("#f2f2f2")) rcls)))
        body.addChild(tools)
        if (ys.editor == "periods") { this.ysPeriodEditor(body) }
        if (ys.editor == "rows") { this.ysRowEditor(body) }
        this.ysGrid(body)
        def legend (tree Rt (YsLegend))
        legend.addChild((tree Rt (YsDim (props (className "rt-ys-dim rt-ys-legend-cap")) "Kausityypit:")))
        def kinds:[string] ([] _:string ("base" "build" "peak" "race" "recovery" "transition" "general"))
        for kinds k:string i {
            def sw (tree Rt (YsSwatch))
            sw.setAttribute("background-color" (RtYearSheet.kindColor(k)))
            legend.addChild(sw)
            legend.addChild((tree Rt (YsDim k)))
        }
        body.addChild(legend)
        def sec (tree Rt (YsPanel))
        sec.addChild((tree Rt (YsH3 (props (id "rt-ys-h-periods")) "Jaksot ja esimerkkiviikot")))
        for seed.periods p:RtPeriod i {
            sec.addChild((this.ysPeriod(p i)))
        }
        body.addChild(sec)
    }

    fn ysTool:EVGElement (id:string label:string icon:string className:string) {
        def b (tree Rt (YsToolBtn))
        b.id = id
        b.a11yLabel = label
        b.className = className
        if ((strlen icon) > 0) {
            def ic (tree Rt (PhIcon (props (className "rt-ph-icon rt-ph-icon-sm"))))
            ic.svgSource = icon
            b.addChild(ic)
        }
        b.addChild((tree Rt (YsToolTx label)))
        return b
    }

    ; "Kausien muokkaus": a row per period — its number and name, the
    ; duration, its unit, its type, the date lock, and delete, which is
    ; disabled while the period is the only one.
    fn ysPeriodEditor:void (body:EVGElement) {
        def panel (tree Rt (YsPanel))
        def top (tree Rt (ModalRow))
        top.addChild((tree Rt (YsH3 (props (id "rt-ys-h-edit")) "Kausien muokkaus")))
        top.addChild((tree Rt (Spacer)))
        top.addChild((this.ysTool("rt-ys-add-period" "Lisää kausi" (RtIcons.plus("#ffffff")) "rt-ys-tool rt-ys-tool-green")))
        panel.addChild(top)
        for seed.periods p:RtPeriod i {
            def row (tree Rt (YsEditRow))
            row.addChild((tree Rt (YsTx (((to_string (i + 1)) + ". ") + p.name))))
            ; The duration: `NumberCtl` keeps the value, the range and the
            ; steps; the box, the value and the two step buttons are drawn
            ; here, as `ControlsDemo` draws its own.
            def dur:NumberCtl (itemAt ysDur i)
            def durBox (tree Rt (YsNum))
            durBox.id = dur.tid
            durBox.a11yLabel = dur.name
            durBox.addChild((this.iconBtn((dur.tid + "-dec") "Vähennä" (RtIcons.chevronLeft("#999999")))))
            durBox.addChild((tree Rt (YsNumTx (dur.plain()))))
            durBox.addChild((this.iconBtn((dur.tid + "-inc") "Lisää" (RtIcons.chevronRight("#999999")))))
            row.addChild(durBox)
            def unit:SelectCtl (itemAt ysUnit i)
            this.dress(unit)
            def unitBox:EVGElement (unwrap unit.rootEl)
            unitBox.setAttribute("width" "80px")
            row.addChild(unitBox)
            def kind:SelectCtl (itemAt ysType i)
            this.dress(kind)
            def kindBox:EVGElement (unwrap kind.rootEl)
            kindBox.setAttribute("width" "150px")
            row.addChild(kindBox)
            row.addChild((this.ysTool(("rt-ys-lock-" + (to_string i)) "Lukitse päivämäärät" (RtIcons.lock("#f2f2f2")) "rt-ys-tool rt-ys-tool-outline")))
            def del (this.iconBtn(("rt-ys-del-period-" + (to_string i)) "" (RtIcons.trash("#999999"))))
            if ((array_length seed.periods) < 2) {
                del.a11yDisabled = true
            }
            row.addChild(del)
            panel.addChild(row)
        }
        panel.addChild((tree Rt (YsDim (props (id "rt-ys-total")) (("Yhteensä: " + (to_string (RtYearSheet.totalWeeks(seed)))) + " viikkoa"))))
        body.addChild(panel)
    }

    ; "Rivien muokkaus (Tilikartta)": a row per row of the chart — its name
    ; and metric keys, a child to add, and delete.
    fn ysRowEditor:void (body:EVGElement) {
        def panel (tree Rt (YsPanel))
        def top (tree Rt (ModalRow))
        top.addChild((tree Rt (YsH3 (props (id "rt-ys-h-edit")) "Rivien muokkaus (Tilikartta)")))
        top.addChild((tree Rt (Spacer)))
        top.addChild((this.ysTool("rt-ys-add-row" "Lisää rivi" (RtIcons.plus("#ffffff")) "rt-ys-tool rt-ys-tool-green")))
        panel.addChild(top)
        for ys.rows r:RtYsRow i {
            def row (tree Rt (YsEditRow))
            row.addChild((tree Rt (YsTx ((r.name + " ") + (r.keyText())))))
            row.addChild((tree Rt (Spacer)))
            row.addChild((this.ysTool(("rt-ys-add-child-" + (to_string i)) "Lisää alarivi" (RtIcons.plus("#f2f2f2")) "rt-ys-tool rt-ys-tool-outline")))
            row.addChild((this.iconBtn(("rt-ys-del-row-" + (to_string i)) "" (RtIcons.trash("#999999")))))
            panel.addChild(row)
        }
        body.addChild(panel)
    }

    ; The grid: a column per period and a total, a row per row of the chart
    ; with one line per metric. Text only, as the original's is.
    fn ysGrid:void (body:EVGElement) {
        def grid (tree Rt (YsGrid))
        def headRow (tree Rt (YsGridRow (props (className "rt-ys-grid-row rt-ys-grid-head"))))
        headRow.addChild((this.ysCell("Kategoria" "" "rt-ys-cell rt-ys-cell-name")))
        for seed.periods p:RtPeriod i {
            def dates:string (((RtYearSheet.shortDate((RtYearSheet.periodStart(seed i)))) + " - ") + (RtYearSheet.shortDate((RtYearSheet.periodEnd(seed i)))))
            def cell:EVGElement (this.ysCell(p.name dates "rt-ys-cell"))
            grid.addChild((tree Rt (Spacer)))
            headRow.addChild(cell)
        }
        headRow.addChild((this.ysCell("Yhteensä" "" "rt-ys-cell rt-ys-cell-total")))
        grid.addChild(headRow)
        for ys.rows r:RtYsRow ri {
            def row (tree Rt (YsGridRow))
            def rowName:string (((r.name + " (") + (r.unitText())) + ")")
            row.addChild((this.ysCell(rowName "" "rt-ys-cell rt-ys-cell-name")))
            for seed.periods p:RtPeriod i {
                def a:string (RtYearSheet.periodStart(seed i))
                def b:string (RtYearSheet.periodEnd(seed i))
                def first@(mutable):string "-"
                def second@(mutable):string ""
                if ((array_length r.metricKeys) > 0) { first = (RtYearSheet.cellText((itemAt r.metricKeys 0) seed a b)) }
                if ((array_length r.metricKeys) > 1) { second = (RtYearSheet.cellText((itemAt r.metricKeys 1) seed a b)) }
                row.addChild((this.ysCell(first second "rt-ys-cell")))
            }
            def ta:string seed.sheetStart
            def tb:string (RtYearSheet.sheetEnd(seed))
            def tfirst@(mutable):string "-"
            def tsecond@(mutable):string ""
            if ((array_length r.metricKeys) > 0) { tfirst = (RtYearSheet.cellText((itemAt r.metricKeys 0) seed ta tb)) }
            if ((array_length r.metricKeys) > 1) { tsecond = (RtYearSheet.cellText((itemAt r.metricKeys 1) seed ta tb)) }
            row.addChild((this.ysCell(tfirst tsecond "rt-ys-cell rt-ys-cell-total")))
            grid.addChild(row)
        }
        body.addChild(grid)
    }

    fn ysCell:EVGElement (line1:string line2:string className:string) {
        def cell (tree Rt (YsCell))
        cell.className = className
        cell.addChild((tree Rt (YsCellTx line1)))
        if ((strlen line2) > 0) {
            cell.addChild((tree Rt (YsDim line2)))
        }
        return cell
    }

    ; A period and, unfolded, its goals, the week-type switch and the week.
    fn ysPeriod:EVGElement (p:RtPeriod i:int) {
        def box (tree Rt (YsPeriod))
        def unitWord@(mutable):string "vk"
        if (p.durationUnit == "days") { unitWord = "pv" }
        def label@(mutable):string ((((((p.name + " (") + (to_string p.durationWeeks)) + " ") + unitWord) + ") ") + p.kind)
        if ((array_length p.weeks) > 0) {
            label = (label + " Esimerkkiviikot ✓")
        }
        def btn (tree Rt (YsPeriodBtn))
        btn.id = ("rt-ys-period-" + (to_string i))
        btn.a11yLabel = label
        btn.addChild((tree Rt (YsTx p.name)))
        btn.addChild((tree Rt (YsDim (((("(" + (to_string p.durationWeeks)) + " ") + unitWord) + ")"))))
        def kindTag (tree Rt (YsDim (props (className "rt-ys-dim rt-ys-kind")) p.kind)))
        btn.addChild(kindTag)
        if ((array_length p.weeks) > 0) {
            btn.addChild((tree Rt (YsDim "Esimerkkiviikot ✓")))
        }
        box.addChild(btn)
        if (ys.isExpanded(i)) {
            def goalsRow (tree Rt (ModalRow))
            goalsRow.addChild((tree Rt (YsStrong "Tavoitteet:")))
            goalsRow.addChild((tree Rt (YsDim p.goals)))
            box.addChild(goalsRow)
            def seg (tree Rt (ModalRow))
            def wt:string (ys.weekTypeAt(i))
            seg.addChild((this.ysWeekBtn(i "target" "🎯 Tavoiteviikko" (wt == "target"))))
            seg.addChild((this.ysWeekBtn(i "light" "🌊 Kevyt viikko" (wt == "light"))))
            box.addChild(seg)
            def week:RtExampleWeek (p.weekOf(wt))
            box.addChild((tree Rt (YsPara (props (id ("rt-ys-week-desc-" + (to_string i)))) week.description)))
            def days@(mutable):string ""
            def d@(mutable):int 0
            while (d < 7) {
                def compact:string (week.dayAt(d))
                if ((strlen compact) > 0) {
                    def e:RtEntry (RtEntry.of(compact))
                    if ((strlen days) > 0) { days = (days + " · ") }
                    days = (days + (((RtWeek.dayShort(d)) + " ") + e.title))
                }
                d = (d + 1)
            }
            box.addChild((tree Rt (YsDim days)))
            box.addChild((this.ysTool(("rt-ys-full-" + (to_string i)) "Katso täydet ohjelmat" "" "rt-ys-tool rt-ys-tool-outline")))
        }
        return box
    }

    fn ysWeekBtn:EVGElement (i:int t:string label:string on:boolean) {
        def cls@(mutable):string "rt-ys-tool rt-ys-tool-outline"
        if on { cls = "rt-ys-tool rt-ys-tool-on" }
        return (this.ysTool((("rt-ys-week-" + (to_string i)) + ("-" + t)) label "" cls))
    }

    fn pressYearsheet:boolean (id:string) {
        ; Back is `onBack`: the dashboard.
        if (id == "rt-ys-back") {
            if (ys.view == "detail") {
                ys.openList()
            }
            scene = "app"
            section = "dashboard"
            docScroll = 0.0
            return true
        }
        if (RtEntry.hasPrefix(id "rt-ys-open-")) {
            ys.openDetail()
            docScroll = 0.0
            return true
        }
        if (ys.view != "detail") {
            return false
        }
        if (id == "rt-ys-periods") { return (ys.toggleEditor("periods")) }
        if (id == "rt-ys-rows") { return (ys.toggleEditor("rows")) }
        if (id == "rt-ys-add-row") {
            ys.addRow()
            return true
        }
        def delRow:int (RealTrainerDemo.digitOf(id "rt-ys-del-row-"))
        if (delRow >= 0) { return (ys.removeRow(delRow)) }
        def per:int (RealTrainerDemo.digitOf(id "rt-ys-period-"))
        if (per >= 0) { return (ys.togglePeriod(per)) }
        if (RtEntry.hasPrefix(id "rt-ys-week-")) {
            def rest:string (substring id 11 (strlen id))
            def dash:int (RtEntry.findIn(rest "-"))
            if (dash > 0) {
                def wi:int (to_int (?? (to_double (substring rest 0 dash)) 0.0))
                return (ys.setWeekType(wi (substring rest (dash + 1) (strlen rest))))
            }
            return false
        }
        ; The editors' controls: a step or a select answers, and the period
        ; follows it.
        for ysDur d:NumberCtl i {
            if ((id == (d.tid + "-inc")) || (id == (d.tid + "-dec"))) {
                if (id == (d.tid + "-inc")) { d.increment() } { d.decrement() }
                def pd:RtPeriod (itemAt seed.periods i)
                pd.durationWeeks = (to_int d.value)
                return true
            }
        }
        for ysUnit u:SelectCtl i {
            if (RealTrainerDemo.owns((u.tids()) id)) {
                u.activate(id)
                def p:RtPeriod (itemAt seed.periods i)
                p.durationUnit = u.value
                return true
            }
        }
        for ysType t:SelectCtl i {
            if (RealTrainerDemo.owns((t.tids()) id)) {
                t.activate(id)
                def p2:RtPeriod (itemAt seed.periods i)
                p2.kind = t.value
                return true
            }
        }
        return false
    }

    ; "rt-wiz-color-7" → 7, or -1 when the id is not one of that family.
    sfn digitOf:int (id:string prefix:string) {
        def plen:int (strlen prefix)
        if ((strlen id) != (plen + 1)) {
            return -1
        }
        if ((substring id 0 plen) != prefix) {
            return -1
        }
        def ch:int (charAt id plen)
        if (ch < 48) { return -1 }
        if (ch > 57) { return -1 }
        return (ch - 48)
    }

    ; The toaster's landmark, and the toast in it while there is one.
    fn toasts:EVGElement () {
        def region (tree Rt (PhToasts))
        if ((strlen toastText) > 0) {
            def list (tree Rt (Toast))
            list.setAttribute("width" ((to_string (to_int (pageW - 32.0))) + "px"))
            def item (tree Rt (ToastItem))
            def ic (tree Rt (PhIcon))
            ic.svgSource = (RtIcons.check("#22c55e"))
            item.addChild(ic)
            item.addChild((tree Rt (ToastTx toastText)))
            list.addChild(item)
            region.addChild(list)
        }
        return region
    }


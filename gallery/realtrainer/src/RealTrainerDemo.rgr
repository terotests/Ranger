    ; --- the calendar section --------------------------------------------------
    ; `DashboardPage`'s mobile calendar: two orange buttons, two tabs, and the
    ; week — or the example week.
    fn calendarSection:void (body:EVGElement) {
        def actions (tree Rt (CalActions))
        actions.addChild((this.calButton("rt-add" "Lisää harjoitus" (RtIcons.penLine("#ffffff")))))
        if ((array_length seed.periods) > 0) {
            actions.addChild((this.calButton("rt-plan-update" "Päivitä suunnitelma" (RtIcons.refreshCw("#ffffff")))))
        }
        body.addChild(actions)
        if (seed.calendarType == "plan") {
            def tabs (tree Rt (CalTabs))
            tabs.addChild((this.calTabBtn("rt-tab-weeks" "Viikot" (calTab == "weeks"))))
            tabs.addChild((this.calTabBtn("rt-tab-example" "Malliviikko" (calTab == "example"))))
            body.addChild(tabs)
        }
        if ((strlen dayIso) > 0) {
            this.dayView(body)
            return
        }
        if (calTab == "weeks") {
            body.addChild((this.weekView()))
        } {
            body.addChild((this.examplePanel()))
        }
    }

    ; --- a day, opened --------------------------------------------------------------
    ; `handleDayClick`: one workout opens it, several open the day with each
    ; of them — the same cards either way, in the panel the week list gave
    ; way to. The two unnamed buttons in its header both close it, as the
    ; original's do.
    fn dayView:void (body:EVGElement) {
        def head (tree Rt (DayHead))
        head.addChild((this.iconBtn("rt-day-back" "" (RtIcons.arrowLeft("#f2f2f2")))))
        def wd:int ((RtWeek.daysOf(dayIso)) - (RtWeek.daysOf((RtWeek.mondayOf(dayIso)))))
        def title:string ((((RealTrainerDemo.weekdayLong(wd)) + " ") + (to_string (RtWeek.dayOfMonth(dayIso)))) + ("." + ((to_string (RtWeek.monthOf(dayIso))) + ".")))
        head.addChild((tree Rt (Spacer)))
        head.addChild((tree Rt (DayHeadTx (props (id "rt-dv-title")) title)))
        head.addChild((tree Rt (Spacer)))
        head.addChild((this.iconBtn("rt-day-close" "" (RtIcons.x("#f2f2f2")))))
        body.addChild(head)
        def entries:[RtSeedEntry] (seed.entriesOn(dayIso))
        def n:int (array_length entries)
        def k@(mutable):int (n - 1)
        while (k >= 0) {
            body.addChild((this.cardFor((itemAt entries k) ((n - 1) - k) "day")))
            k = (k - 1)
        }
    }

    ; The card for an entry, kept — see `cardEls`. `place` names where it
    ; is drawn, because the two views that draw cards dress them
    ; differently and count them differently.
    fn cardFor:EVGElement (e:RtSeedEntry i:int place:string) {
        def slot:string ((e.id + "|") + place)
        if ((strlen e.id) == 0) {
            slot = (((e.date + "#") + (to_string i)) + ("|" + place))
        }
        def key:string ((((((e.id + "|") + (to_string i)) + ("|" + e.date)) + ("|" + (to_string e.points))) + ("|" + e.feedback)) + ("|" + e.compact))
        if (has cardKeys slot) {
            def kept:string (unwrap (get cardKeys slot))
            if (kept == key) {
                def had@(optional):EVGElement (get cardEls slot)
                if had {
                    return (unwrap had)
                }
            }
        }
        def card:EVGElement (this.entryCard(e i))
        ; The card's layout is kept with the card — see
        ; `EVGElement.keepLayout`: a rebuild for a menu opening lays out the
        ; shell and moves the cards.
        card.keepLayout = true
        set cardEls slot card
        set cardKeys slot key
        cardsBuilt = (cardsBuilt + 1)
        return card
    }

    fn forgetCards:void () {
        def freshEls:[string:EVGElement]
        def freshKeys:[string:string]
        cardEls = freshEls
        cardKeys = freshKeys
        ; …and the commands kept for them.
        if retained {
            def last:EVGDisplayList (unwrap retained)
            last.forgetFragments()
        }
    }

    ; How many cards have been built from their entries, for a check that
    ; wants to know a rebuild built none.
    fn cardsBuiltCount:int () {
        return cardsBuilt
    }

    fn entryCard:EVGElement (e:RtSeedEntry i:int) {
        def card (tree Rt (EntryCard))
        card.id = ("rt-entry-" + (to_string i))
        def entry:RtEntry (RtEntry.of(e.compact))
        if (RealTrainerDemo.isMeasurement(entry)) {
            this.measurementCard(card entry e i)
            return card
        }
        def addRow (tree Rt (ModalRow))
        addRow.addChild((tree Rt (Spacer)))
        addRow.addChild((this.exButton(("rt-entry-add-" + (to_string i)) "Lisää" "Lisää")))
        card.addChild(addRow)
        ; The header, centred as the blog view centres it: the title, the
        ; short rule under it, the date, the notes button.
        def hdRow (tree Rt (Row (props (className "rt-entry-center"))))
        hdRow.addChild((tree Rt (EntryHd (props (id ("rt-entry-hd-" + (to_string i)))) entry.title)))
        card.addChild(hdRow)
        def ruleRow (tree Rt (Row (props (className "rt-entry-center"))))
        ruleRow.addChild((tree Rt (Col (props (className "rt-entry-rule")))))
        card.addChild(ruleRow)
        def timeRow (tree Rt (Row (props (className "rt-entry-center"))))
        def when@(mutable):string (RealTrainerDemo.fiDatePadded(e.date))
        if ((strlen entry.time) > 0) { when = ((when + " klo ") + entry.time) }
        timeRow.addChild((tree Rt (EntryTime when)))
        card.addChild(timeRow)
        if (e.points >= 0) {
            ; The score, as the blog view badges it: the star, the points in
            ; amber, "/100" muted.
            def scoreRow (tree Rt (Row (props (className "rt-entry-center rt-entry-score"))))
            def star (tree Rt (PhIcon))
            star.svgSource = (RtIcons.star("#d97706"))
            star.className = "rt-ph-icon rt-entry-star"
            scoreRow.addChild(star)
            def pts:string (to_string e.points)
            scoreRow.addChild((tree Rt (EntryScore (props (id ("rt-entry-score-" + (to_string i)))) pts)))
            scoreRow.addChild((tree Rt (EntryScoreOf "/100")))
            card.addChild(scoreRow)
        }
        def notesRow (tree Rt (Row (props (className "rt-entry-center"))))
        def notes (this.exButton(("rt-entry-notes-" + (to_string i)) "Muistiinpanot" "Muistiinpanot"))
        notes.className = "rt-ex-btn rt-outline-btn"
        notesRow.addChild(notes)
        card.addChild(notesRow)
        if ((array_length entry.tags) > 0) {
            def chips (tree Rt (EntryTags))
            chips.className = "rt-entry-tags rt-entry-tags-center"
            for entry.tags t:string ti {
                def chip (tree Rt (EntryTag t))
                chip.className = ("rt-entry-tag rt-tag-" + (to_string (ti % 8)))
                chips.addChild(chip)
            }
            card.addChild(chips)
        }
        def doc:CompactDocument (CompactRowMapper.parseDocument(e.compact))
        def moves@(mutable):int 0
        def tonnage@(mutable):int 0
        def folding@(mutable):boolean false
        def customOpen@(mutable):boolean false
        def customLines@(mutable):EVGElement (tree Rt (Col (props (className "rt-entry-custom-lines"))))
        def customBand@(mutable):EVGElement (tree Rt (Col (props (className "rt-entry-band"))))
        def customCount@(mutable):int 0
        ; Rows a run took with it — its splits and its note — up to here.
        def takenUntil@(mutable):int 0
        def rows (tree Rt (Col (props (className "rt-entry-rows"))))
        for doc.rows row:CompactRow ri {
            def kind:string (CompactStatBuilder.kind(row))
            def label:string (CompactStatBuilder.label(row))
            def isMove:boolean (((kind == "exercise") || (kind == "move")) || ((kind == "pyramid") || (kind == "circuitItem")))
            def rowId:string ((to_string i) + ("-" + (to_string ri)))
            if (ri < takenUntil) { continue }
            if (kind == "split") {
                ; A split right under its run reads as part of it — the
                ; original folds it into that row's text, with no buttons of
                ; its own. One after a line of text stands alone, with the
                ; comment button a value row gets.
                if folding { continue }
                def lone (tree Rt (Col (props (className "rt-entry-splits"))))
                lone.addChild((this.splitLine(row 0)))
                rows.addChild(lone)
                rows.addChild((this.commentUnder(rowId)))
                continue
            }
            folding = isMove
            if (kind == "custom") {
                ; The custom rows, behind one band as the blog view groups
                ; them: the name muted, the value after it.
                if (customOpen == false) {
                    def group (tree Rt (Row (props (className "rt-entry-customs"))))
                    customBand = (tree Rt (Col (props (className "rt-entry-band"))))
                    group.addChild(customBand)
                    customLines = (tree Rt (Col (props (className "rt-entry-custom-lines"))))
                    group.addChild(customLines)
                    rows.addChild(group)
                    customOpen = true
                    customCount = 0
                }
                def cline (tree Rt (Row (props (className "rt-entry-custom"))))
                cline.addChild((tree Rt (EntryNote (label + ": "))))
                cline.addChild((tree Rt (EntryMono (RealTrainerDemo.customValue(row)))))
                customLines.addChild(cline)
                customLines.addChild((this.commentUnder(rowId)))
                customCount = (customCount + 1)
                def bandN@(mutable):int customCount
                if (bandN > 10) { bandN = 10 }
                customBand.className = ("rt-entry-band rt-band-" + (to_string bandN))
                continue
            }
            customOpen = false
            if (kind == "duration") {
                ; `Duration.tsx`: the time as an orange chip, the description
                ; after it.
                def dline (tree Rt (EntryRow))
                def dparts:[StatPart] (CompactStatBuilder.parts(row))
                for dparts dp:StatPart di {
                    if (dp.kind == "duration") {
                        dline.addChild((tree Rt (EntryChip dp.text)))
                    } {
                        dline.addChild((tree Rt (EntryRowTx dp.text)))
                    }
                }
                rows.addChild(dline)
                rows.addChild((this.commentUnder(rowId)))
                continue
            }
            if (kind == "text") {
                rows.addChild((tree Rt (EntryPara (props (id ("rt-entry-text-" + rowId))) (CompactStatBuilder.text(row)))))
                def tacts (tree Rt (Row (props (className "rt-entry-under"))))
                tacts.addChild((this.iconBtn(("rt-entry-edit-" + rowId) "Muokkaa tekstiä" (RtIcons.penLine("#999999")))))
                tacts.addChild((this.commentBtn(rowId)))
                rows.addChild(tacts)
                continue
            }
            if isMove {
                moves = (moves + 1)
                tonnage = (tonnage + (RealTrainerDemo.tonnageOf(row)))
                def line (tree Rt (EntryRow))
                def statsBtn (this.iconBtn(("rt-entry-stats-" + rowId) "Näytä tilastot" (RtIcons.barChart("#999999"))))
                statsBtn.className = "rt-icon-btn rt-entry-stats-btn"
                line.addChild(statsBtn)
                def col (tree Rt (EntryRowCol))
                def nameRow (tree Rt (Row (props (className "rt-entry-name-row"))))
                def shown@(mutable):string label
                if (kind == "move") { shown = (RealTrainerDemo.capitalised(label)) }
                nameRow.addChild((tree Rt (EntryRowTx shown)))
                if (kind == "pyramid") {
                    nameRow.addChild((tree Rt (EntryKind "pyramid")))
                }
                col.addChild(nameRow)
                line.addChild(col)
                ; The scheme on the right, as `StatChip` draws it: mono, the
                ; loads in orange, a gap between a pyramid's sets — and on a
                ; narrow page under the name, on a wide one on the same row,
                ; as `PyramidRow` stacks them below `sm`.
                def allParts:[StatPart] (CompactStatBuilder.parts(row))
                ; A pace per 100 m is a pool's measure: the blog view shows it
                ; under a swim given in metres and not under a run given in
                ; kilometres, where the document screen still derives one.
                def parts:[StatPart]
                for allParts ap:StatPart api {
                    if ((kind == "move") && (RealTrainerDemo.isKmRun(row)) && (RtEntry.hasPrefix(ap.text "@"))) { continue }
                    push parts ap
                }
                def scheme (tree Rt (Row (props (className "rt-entry-scheme"))))
                def below:boolean (pageW < 768.0)
                if below {
                    line.className = "rt-entry-row rt-entry-row-top"
                    col.className = "rt-entry-row-col rt-entry-row-col-fill"
                    scheme.className = "rt-entry-scheme rt-entry-scheme-below"
                    col.addChild(scheme)
                } {
                    line.addChild((tree Rt (Spacer)))
                    line.addChild(scheme)
                }
                def prevWeight@(mutable):boolean false
                for parts part:StatPart pi {
                    if (prevWeight && (part.kind == "spec")) {
                        scheme.addChild((tree Rt (Col (props (className "rt-entry-gap")))))
                    }
                    def tx (tree Rt (EntryMono part.text))
                    if (part.tone == "weight") { tx.className = "rt-entry-mono rt-entry-weight" }
                    if (part.tone == "muted") { tx.className = "rt-entry-mono rt-entry-muted" }
                    scheme.addChild(tx)
                    prevWeight = (part.kind == "weight")
                }
                rows.addChild(line)
                ; The run takes the splits and the note under it: the splits
                ; numbered behind a band, as `MoveRow` lists them, and the
                ; note after them in italics behind its own band, a shade
                ; lighter than the rows — the original draws the note under
                ; the run either way.
                def nSplit@(mutable):int 0
                def si@(mutable):int (ri + 1)
                def total:int (array_length doc.rows)
                def splits (tree Rt (Col (props (className "rt-entry-splits"))))
                def notes (tree Rt (Col (props (className "rt-entry-run-notes"))))
                def nNote@(mutable):int 0
                def more@(mutable):boolean true
                while (more && (si < total)) {
                    def next:CompactRow (itemAt doc.rows si)
                    def nk:string (CompactStatBuilder.kind(next))
                    if (nk == "split") {
                        nSplit = (nSplit + 1)
                        splits.addChild((this.splitLine(next nSplit)))
                        if (nNote > 0) {
                            ; A split after the note is a row of its own to
                            ; the original, with the comment control a row
                            ; gets; it keeps that control, hidden like the rest.
                            notes.addChild((this.commentUnder(((to_string i) + ("-" + (to_string si))))))
                        }
                        si = (si + 1)
                    } {
                        if ((nk == "text") && (nNote == 0)) {
                            def nline (tree Rt (Row (props (className "rt-entry-run-note"))))
                            nline.addChild((tree Rt (Col (props (className "rt-entry-band")))))
                            def nid:string ((to_string i) + ("-" + (to_string si)))
                            def np (tree Rt (EntryPara (props (id ("rt-entry-text-" + nid))) (CompactStatBuilder.text(next))))
                            np.className = "rt-entry-para rt-entry-para-italic"
                            nline.addChild(np)
                            notes.addChild(nline)
                            def nacts (tree Rt (Row (props (className "rt-entry-under"))))
                            nacts.addChild((this.iconBtn(("rt-entry-edit-" + nid) "Muokkaa tekstiä" (RtIcons.penLine("#999999")))))
                            nacts.addChild((this.commentBtn(nid)))
                            notes.addChild(nacts)
                            nNote = 1
                            si = (si + 1)
                        } {
                            more = false
                        }
                    }
                }
                takenUntil = si
                if (nSplit > 0) { rows.addChild(splits) }
                rows.addChild((this.commentUnder(rowId)))
                if (nNote > 0) { rows.addChild(notes) }
                continue
            }
            if ((kind == "section") || (kind == "phase")) {
                ; The section, as the blog view heads it: a bar in the brand
                ; colour and the name in capitals.
                def sec (tree Rt (Row (props (className "rt-entry-section-row"))))
                sec.addChild((tree Rt (Col (props (className "rt-entry-section-bar")))))
                sec.addChild((tree Rt (EntrySection (RealTrainerDemo.upper(label)))))
                rows.addChild(sec)
                continue
            }
            if ((kind != "unknown") && (kind != "summary")) {
                def note@(mutable):string label
                def more:string (CompactStatBuilder.text(row))
                if ((strlen more) > 0) { note = ((note + " ") + more) }
                if ((strlen note) > 0) {
                    rows.addChild((tree Rt (EntryNote note)))
                }
            }
        }
        card.addChild(rows)
        ; `DerivedTable`, last: the values the app inferred, each with its
        ; unit, its label and its goodness.
        def derived:[RtDerived] (RtDerived.of(e.compact))
        if ((array_length derived) > 0) {
            def table (tree Rt (Col (props (className "rt-derived"))))
            table.addChild((tree Rt (EntryNote "Johdetut arvot")))
            def items (tree Rt (Row (props (className "rt-derived-items"))))
            for derived d:RtDerived di {
                def item (tree Rt (Row (props (className "rt-derived-item"))))
                item.addChild((tree Rt (DerivedVal d.value)))
                if ((strlen d.unit) > 0) {
                    item.addChild((tree Rt (EntryNote d.unit)))
                }
                item.addChild((tree Rt (EntryNote (d.label()))))
                def good:string (d.goodnessLabel())
                if ((strlen good) > 0) {
                    def pill (tree Rt (DerivedPill good))
                    pill.className = ("rt-derived-pill rt-good-" + (to_string d.goodness))
                    item.addChild(pill)
                }
                items.addChild(item)
            }
            table.addChild(items)
            card.addChild(table)
        }
        if ((strlen e.feedback) > 0) {
            ; The AI coach's feedback at the end, as the blog view sets it:
            ; the small label and the text — its bold marks dropped, as a
            ; plain paragraph reads it.
            def fb (tree Rt (Col (props (className "rt-entry-feedback"))))
            fb.addChild((tree Rt (EntryNote "AI-valmentajan palaute")))
            fb.addChild((tree Rt (EntryPara (props (id ("rt-entry-feedback-" + (to_string i))) (className "rt-entry-para rt-entry-feedback-text")) (RealTrainerDemo.plainMarkdown(e.feedback)))))
            card.addChild(fb)
        }
        card.addChild((tree Rt (EntryRule)))
        def foot (tree Rt (EntryFoot))
        if (moves > 0) {
            def tons@(mutable):string ((to_string tonnage) + " kg")
            if (tonnage >= 1000) {
                ; `(t / 1000).toFixed(1)` — and 2550 is "2.5" there, not
                ; "2.6": the tenths are cut, not rounded.
                def tenths:int (to_int ((int2double tonnage) / 100.0))
                def whole:int (to_int ((int2double tenths) / 10.0))
                tons = ((((to_string whole) + ".") + (to_string (tenths - (whole * 10)))) + " t")
            }
            foot.addChild((tree Rt (EntryFootTx ((((to_string moves) + " liikettä") + " • Yht. ") + tons))))
        }
        card.addChild(foot)
        def acts (tree Rt (ModalRow))
        acts.addChild((this.exButton(("rt-entry-compact-" + (to_string i)) "Compact" "Compact")))
        acts.addChild((this.exButton(("rt-entry-json-" + (to_string i)) "JSON" "JSON")))
        acts.addChild((tree Rt (EntryDot "•")))
        def del (this.exButton(("rt-entry-delete-" + (to_string i)) "Poista" "Poista"))
        RealTrainerDemo.tintText(del "rt-ex-btn-text rt-danger-text")
        acts.addChild(del)
        card.addChild(acts)
        return card
    }

    ; A split as `SplitRow` draws it, behind its band: the distance, the
    ; pace and the duration in mono, the heart rate in rose, the note in
    ; italic grey — each its own word.
    fn splitLine:EVGElement (row:CompactRow n:int) {
        def line (tree Rt (Row (props (className "rt-entry-split-line"))))
        line.addChild((tree Rt (Col (props (className "rt-entry-band")))))
        if (n > 0) {
            line.addChild((tree Rt (EntrySplitNo ((to_string n) + "."))))
        }
        def parts:[StatPart] (CompactStatBuilder.parts(row))
        for parts part:StatPart pi {
            def tx (tree Rt (EntryMono part.text))
            if (part.kind == "spec") { tx.className = "rt-entry-split-dist" }
            if (part.tone == "weight") { tx.className = "rt-entry-mono rt-entry-hr" }
            if (part.tone == "muted") { tx.className = "rt-entry-split-note" }
            line.addChild(tx)
        }
        return line
    }

    ; The sheet's creation day from the seed, or today for one made here.
    fn sheetCreatedDay:string () {
        if ((strlen seed.sheetCreated) == 10) { return seed.sheetCreated }
        return today
    }

    ; Markdown's emphasis marks taken out, and its line breaks kept as
    ; spaces — enough for a coach's paragraph.
    sfn plainMarkdown:string (text:string) {
        def out@(mutable):string ""
        def i@(mutable):int 0
        def n:int (strlen text)
        while (i < n) {
            def ch:int (charAt text i)
            if (ch == 42) { i = (i + 1) } {
                if (ch == 10) { out = (out + " ") } { out = (out + (substring text i (i + 1))) }
                i = (i + 1)
            }
        }
        return out
    }

    ; The first letter up — "rintauinti" reads "Rintauinti" over its row.
    sfn capitalised:string (text:string) {
        if ((strlen text) == 0) { return text }
        return ((RealTrainerDemo.upper((substring text 0 1))) + (substring text 1 (strlen text)))
    }

    ; Capitals, for the letters Finnish uses.
    sfn upper:string (text:string) {
        def out@(mutable):string ""
        def i@(mutable):int 0
        def n:int (strlen text)
        while (i < n) {
            def ch:int (charAt text i)
            def piece@(mutable):string (substring text i (i + 1))
            if ((ch >= 97) && (ch <= 122)) { piece = (substring "ABCDEFGHIJKLMNOPQRSTUVWXYZ" (ch - 97) (ch - 96)) }
            if (ch == 228) { piece = "Ä" }
            if (ch == 246) { piece = "Ö" }
            if (ch == 229) { piece = "Å" }
            out = (out + piece)
            i = (i + 1)
        }
        return out
    }

    ; The comment control under a row, as the blog view hangs it: the ↳ mark
    ; and the small outlined "Lisää kommentti".
    fn commentUnder:EVGElement (rowId:string) {
        def under (tree Rt (Row (props (className "rt-entry-under"))))
        under.addChild((this.commentBtn(rowId)))
        return under
    }

    fn commentBtn:EVGElement (rowId:string) {
        def b (tree Rt (CommentBtn))
        b.id = ("rt-entry-comment-" + rowId)
        b.a11yLabel = "Lisää kommentti"
        b.addChild((tree Rt (CommentBtnTx "Lisää kommentti")))
        return b
    }

    sfn isKmRun:boolean (row:CompactRow) {
        match row {
            Move mv {
                def m:MoveSpec (unwrap mv.spec)
                return (m.hasDistance && (m.distanceUnit == "km"))
            }
            Exercise ex { }
            Pyramid py { }
            Split sp { }
            Section s { }
            Text t { }
            Summary sm { }
            Phase ph { }
            Custom cu { }
            Duration du { }
            Unknown un { }
            Circuit ci { }
            CircuitItem it { }
        }
        return false
    }

    ; `Custom.tsx`: `~value` with the unit, or `~a-b` for a range.
    sfn customValue:string (row:CompactRow) {
        match row {
            Custom cu {
                def c:CustomSpec (unwrap cu.spec)
                def v@(mutable):string ("~" + c.value)
                if c.hasValueMax { v = ((v + "-") + c.valueMax) }
                return (v + c.unit)
            }
            Exercise ex { }
            Move mv { }
            Pyramid py { }
            Split sp { }
            Section s { }
            Text t { }
            Summary sm { }
            Phase ph { }
            Duration du { }
            Unknown un { }
            Circuit ci { }
            CircuitItem it { }
        }
        return (CompactStatBuilder.text(row))
    }

    ; `isMeasurementEntry`: a tag says the entry is a reading, not a workout.
    sfn isMeasurement:boolean (entry:RtEntry) {
        for entry.tags t:string i {
            if (t == "hrv") { return true }
            if (t == "paino") { return true }
            if (t == "mittaus") { return true }
            if (t == "mittaukset") { return true }
            if (t == "leposyke") { return true }
            if (t == "weight") { return true }
            if (t == "measurement") { return true }
        }
        return false
    }

    ; The reading's card, as `WorkoutBlogView` draws a measurement: the date
    ; over the title, the menu, the tags, a box per value and the notes.
    fn measurementCard:void (card:EVGElement entry:RtEntry e:RtSeedEntry i:int) {
        def head (tree Rt (ModalRow))
        def hcol (tree Rt (EntryRowCol))
        hcol.addChild((tree Rt (EntryTime (RealTrainerDemo.fiDatePadded(e.date)))))
        hcol.addChild((tree Rt (MeasHd (props (id ("rt-entry-hd-" + (to_string i)))) entry.title)))
        head.addChild(hcol)
        head.addChild((tree Rt (Spacer)))
        head.addChild((this.exButton(("rt-entry-add-" + (to_string i)) "Lisää" "Lisää")))
        card.addChild(head)
        if ((array_length entry.tags) > 0) {
            def chips (tree Rt (EntryTags))
            for entry.tags t:string ti {
                chips.addChild((tree Rt (EntryTag t)))
            }
            card.addChild(chips)
        }
        def doc:CompactDocument (CompactRowMapper.parseDocument(e.compact))
        def vals (tree Rt (Row (props (className "rt-meas-vals"))))
        def nVals@(mutable):int 0
        for doc.rows row:CompactRow ri {
            def kind:string (CompactStatBuilder.kind(row))
            if (kind == "custom") {
                def box (tree Rt (Col (props (className "rt-meas-box"))))
                box.addChild((tree Rt (EntryNote (CompactStatBuilder.label(row)))))
                box.addChild((tree Rt (MeasVal (RealTrainerDemo.valueOf(row)))))
                vals.addChild(box)
                nVals = (nVals + 1)
            }
        }
        if (nVals > 0) { card.addChild(vals) }
        for doc.rows row:CompactRow ri {
            def kind:string (CompactStatBuilder.kind(row))
            if (kind == "text") {
                card.addChild((tree Rt (EntryPara (props (id (("rt-entry-text-" + (to_string i)) + ("-" + (to_string ri))))) (CompactStatBuilder.text(row)))))
            }
        }
    }

    ; The custom row's value with its unit — "48 ms" from "HRV: ~48ms".
    sfn valueOf:string (row:CompactRow) {
        match row {
            Custom cu {
                def c:CustomSpec (unwrap cu.spec)
                if ((strlen c.unit) > 0) {
                    return ((c.value + " ") + c.unit)
                }
                return c.value
            }
            Exercise ex { }
            Move mv { }
            Pyramid py { }
            Split sp { }
            Section s { }
            Text t { }
            Summary sm { }
            Phase ph { }
            Duration du { }
            Unknown un { }
            Circuit ci { }
            CircuitItem it { }
        }
        return (CompactStatBuilder.text(row))
    }

    ; sets × reps × kg, for the exercises that state all three — `totalTonnage`.
    sfn tonnageOf:int (row:CompactRow) {
        match row {
            Exercise ex {
                def e:ExerciseSpec (unwrap ex.spec)
                if ((e.hasSets && e.hasReps) && e.hasWeight) {
                    return ((e.sets * e.reps) * e.weightKg)
                }
            }
            Move mv { }
            Pyramid py { }
            Split sp { }
            Section s { }
            Text t { }
            Summary sm { }
            Phase ph { }
            Custom cu { }
            Duration du { }
            Unknown un { }
            Circuit ci { }
            CircuitItem it { }
        }
        return 0
    }

    sfn weekdayLong:string (i:int) {
        if (i == 0) { return "Maanantai" }
        if (i == 1) { return "Tiistai" }
        if (i == 2) { return "Keskiviikko" }
        if (i == 3) { return "Torstai" }
        if (i == 4) { return "Perjantai" }
        if (i == 5) { return "Lauantai" }
        return "Sunnuntai"
    }

    ; "09.02.2026" — the card's `<time>`.
    sfn fiDatePadded:string (iso:string) {
        return ((((substring iso 8 10) + ".") + (substring iso 5 7)) + ("." + (substring iso 0 4)))
    }

    fn calButton:EVGElement (id:string label:string icon:string) {
        def b (tree Rt (CalBtn))
        b.id = id
        b.a11yLabel = label
        def glyph (tree Rt (PhIcon (props (className "rt-ph-icon rt-ph-icon-sm"))))
        glyph.svgSource = icon
        b.addChild(glyph)
        b.addChild((tree Rt (CalBtnTx label)))
        return b
    }

    ; The original underlines the active tab with a 2px bottom border. EVG
    ; draws a border on all four sides or none, so the underline is a bar of
    ; its own under the label.
    fn calTabBtn:EVGElement (id:string label:string active:boolean) {
        def b (tree Rt (CalTab))
        b.id = id
        b.a11yLabel = label
        def tx (tree Rt (CalTabTx label))
        def bar (tree Rt (CalTabBar))
        if active {
            tx.className = "rt-cal-tab-text rt-cal-tab-text-active"
            bar.className = "rt-cal-tab-bar rt-cal-tab-bar-active"
        }
        b.addChild(tx)
        b.addChild(bar)
        return b
    }

    ; `MobileWeekView`: the header with the week either way, and seven rows.
    fn weekView:EVGElement () {
        def col (tree Rt (Col (props (className "rt-week-view"))))
        def head (tree Rt (WeekHead))
        head.addChild((this.weekNav("rt-week-prev" "Edellinen viikko" (RtIcons.chevronLeft("#f2f2f2")))))
        def mid (tree Rt (WeekMid))
        def title (tree Rt (WeekTitleBtn))
        def no:string ("vko " + (to_string (RtWeek.isoWeekNumber(weekStart))))
        def range:string (RtWeek.rangeText(weekStart))
        title.a11yLabel = ((no + " ") + range)
        title.addChild((tree Rt (WeekNo no)))
        title.addChild((tree Rt (WeekRange range)))
        mid.addChild(title)
        if (seed.calendarType == "plan") {
            if ((array_length seed.periods) > 0) {
                def pill (tree Rt (WeekPill))
                def glyph (tree Rt (PhIcon (props (className "rt-ph-icon rt-ph-icon-xs"))))
                glyph.svgSource = (RtIcons.refreshCw("#f97316"))
                pill.addChild(glyph)
                pill.addChild((tree Rt (WeekPillTx "Luo suunnitelma")))
                mid.addChild(pill)
            }
        }
        head.addChild(mid)
        head.addChild((this.weekNav("rt-week-next" "Seuraava viikko" (RtIcons.chevronRight("#f2f2f2")))))
        col.addChild(head)
        def rows (tree Rt (DayRows))
        def i@(mutable):int 0
        while (i < 7) {
            rows.addChild((this.dayRow(i)))
            i = (i + 1)
        }
        col.addChild(rows)
        return col
    }

    fn weekNav:EVGElement (id:string label:string icon:string) {
        def b (tree Rt (WeekNavBtn))
        b.id = id
        b.a11yLabel = label
        def glyph (tree Rt (PhIcon))
        glyph.svgSource = icon
        b.addChild(glyph)
        return b
    }

    ; One day: the number in a circle — orange today, filled when there is
    ; something on it — the short name, the title and the tags, and the
    ; chevron. Its name is what a reader hears the original say: "10 Ti Kevyt
    ; salitreeni #kuntosali #voima #kevyt", or "9 Ma –".
    fn dayRow:EVGElement (i:int) {
        def iso:string (RtWeek.shifted(weekStart i))
        def entries:[RtSeedEntry] (seed.entriesOn(iso))
        def isToday:boolean (iso == today)
        def row (tree Rt (DayRow))
        row.id = ("rt-day-" + iso)
        if isToday {
            row.className = "rt-day-row rt-day-today"
        }
        def num (tree Rt (DayNum))
        def dayNo:string (to_string (RtWeek.dayOfMonth(iso)))
        def numTx (tree Rt (DayNumTx dayNo))
        if isToday {
            num.className = "rt-day-num rt-day-num-today"
            numTx.className = "rt-day-num-text rt-day-num-text-today"
        } {
            if ((array_length entries) > 0) {
                num.className = "rt-day-num rt-day-num-busy"
                numTx.className = "rt-day-num-text rt-day-num-text-busy"
            }
        }
        num.addChild(numTx)
        row.addChild(num)
        def col (tree Rt (DayCol))
        def short:string (RtWeek.dayShort(i))
        def name (tree Rt (DayName short))
        if isToday {
            name.className = "rt-day-name rt-day-name-today"
        }
        col.addChild(name)
        def label@(mutable):string (((to_string (RtWeek.dayOfMonth(iso))) + " ") + (RtWeek.dayShort(i)))
        if ((array_length entries) > 0) {
            ; Several workouts on a day: the titles joined, the first one's
            ; tags, and how many — as `MobileWeekView` lists them. Workouts
            ; with no time keep the store's order, which is the newest first.
            def n:int (array_length entries)
            def firstSeed:RtSeedEntry (itemAt entries (n - 1))
            def first:RtEntry (RtEntry.of(firstSeed.compact))
            def title@(mutable):string first.title
            def k@(mutable):int (n - 2)
            while (k >= 0) {
                def moreSeed:RtSeedEntry (itemAt entries k)
                def more:RtEntry (RtEntry.of(moreSeed.compact))
                title = ((title + " & ") + more.title)
                k = (k - 1)
            }
            col.addChild((tree Rt (DayTitle title)))
            label = ((label + " ") + title)
            def tags:string (first.tagText())
            if ((strlen tags) > 0) {
                col.addChild((tree Rt (DayTags tags)))
                label = ((label + " ") + tags)
            }
            if (n > 1) {
                def countText:string (to_string n)
                col.addChild((tree Rt (DayTags (props (className "rt-day-tags rt-day-count")) countText)))
                label = ((label + " ") + countText)
            }
        } {
            col.addChild((tree Rt (DayDash "–")))
            label = (label + " –")
        }
        row.a11yLabel = label
        row.addChild(col)
        def chev (tree Rt (PhIcon (props (className "rt-ph-icon rt-ph-icon-sm"))))
        chev.svgSource = (RtIcons.chevronRight("#999999"))
        row.addChild(chev)
        return row
    }

    ; `ExampleWeekPanel`: the period, "Malliviikko", edit and create, the two
    ; week types, and the seven days with their COMPACT under them.
    fn examplePanel:EVGElement () {
        def panel (tree Rt (ExPanel))
        def period:RtPeriod (seed.firstPeriod())
        panel.addChild((tree Rt (ExHead period.name)))
        panel.addChild((tree Rt (ExSub "Malliviikko")))
        def btns (tree Rt (ExBtns))
        btns.addChild((this.exButton("rt-ex-edit" "Muokkaa" "Muokkaa")))
        btns.addChild((this.exButton("rt-ex-create" "Luo viikolle" "Luo viikolle")))
        panel.addChild(btns)
        if ((period.hasWeek("target")) && (period.hasWeek("light"))) {
            def seg (tree Rt (ExSeg))
            seg.addChild((this.exSegBtn("rt-week-target" "Tavoiteviikko" (exWeekType == "target"))))
            seg.addChild((this.exSegBtn("rt-week-light" "Kevyt viikko" (exWeekType == "light"))))
            panel.addChild(seg)
        }
        def week:RtExampleWeek (period.weekOf(exWeekType))
        def days (tree Rt (ExDays))
        def i@(mutable):int 0
        while (i < 7) {
            def compact:string (week.dayAt(i))
            def day (tree Rt (ExDay))
            def short:string (RtWeek.dayShort(i))
            def name (tree Rt (ExDayName short))
            def bodyEl (tree Rt (ExDayBody))
            if ((strlen compact) > 0) {
                day.className = "rt-ex-day rt-ex-day-busy"
                name.className = "rt-ex-day-name rt-ex-day-name-busy"
                def e:RtEntry (RtEntry.of(compact))
                def title@(mutable):string e.title
                if ((strlen e.emojis) > 0) {
                    title = ((e.emojis + "  ") + title)
                }
                bodyEl.addChild((tree Rt (ExDayTitle title)))
                def tags:string (e.tagText())
                if ((strlen tags) > 0) {
                    bodyEl.addChild((tree Rt (ExDayTags tags)))
                }
                for e.bodyLines line:string j {
                    bodyEl.addChild((tree Rt (ExDayLine line)))
                }
            }
            day.addChild(name)
            day.addChild(bodyEl)
            days.addChild(day)
            i = (i + 1)
        }
        panel.addChild(days)
        def desc:string week.description
        panel.addChild((tree Rt (ExSub desc)))
        return panel
    }

    ; The button's text child, reclassed — the stylesheet subset has no
    ; descendant selectors beyond a theme's.
    sfn tintText:void (b:EVGElement className:string) {
        for b.children c:EVGElement i {
            if (c.elementType == 1) {
                c.className = className
            }
        }
    }

    fn exButton:EVGElement (id:string label:string text:string) {
        def b (tree Rt (ExBtn))
        b.id = id
        b.a11yLabel = label
        b.addChild((tree Rt (ExBtnTx text)))
        return b
    }

    fn exSegBtn:EVGElement (id:string label:string active:boolean) {
        def b (tree Rt (ExSegBtn))
        b.id = id
        b.a11yLabel = label
        def tx (tree Rt (ExSegTx label))
        if active {
            b.className = "rt-ex-seg-btn rt-ex-seg-active"
            tx.className = "rt-ex-seg-text rt-ex-seg-text-active"
        }
        b.addChild(tx)
        return b
    }

    ; The conversation, as a section rather than a screen: the same log and
    ; box `chatScreen` draws, without the frame around them.
    ; `AIDiaryChat` on a phone: a heading, four tools, the calendar chip, a
    ; word of help and the example questions while there is nothing yet, the
    ; conversation, the actions a reply proposes, and the composer.
    fn chatBody:EVGElement () {
        def st:string (chat.state())
        def col (tree Rt (Col (props (className "rt-chat-section"))))
        def hd (tree Rt (ModalRow))
        hd.addChild((tree Rt (ChatHd "AI Chat")))
        if ((array_length chat.sentTexts) > 0) {
            hd.addChild((tree Rt (Spacer)))
            hd.addChild((this.iconBtn("rt-chat-copy-all" "Kopioi koko keskustelu" (RtIcons.bookOpen("#999999")))))
        }
        col.addChild(hd)
        def tools (tree Rt (ChatTools))
        tools.addChild((this.chatTool("rt-chat-new" "Uusi keskustelu")))
        tools.addChild((this.chatTool("rt-chat-history" "Keskusteluhistoria")))
        tools.addChild((this.chatTool("rt-chat-notes" "Tallennetut muistiinpanot")))
        tools.addChild((this.chatTool("rt-chat-guide" "AI-ohjeet")))
        col.addChild(tools)
        col.addChild((this.chatTool("rt-chat-cal" seed.calendarName)))
        if ((array_length chat.sentTexts) == 0) {
            col.addChild((tree Rt (ChatPara "Valitse kalenteri(t) ja kysy mitä vain päiväkirjamerkinnöistäsi!")))
            col.addChild((this.chatTool("rt-chat-feedback" "Anna palautetta harjoittelustani")))
            col.addChild((tree Rt (ChatPara "Esimerkkikysymyksiä:")))
            col.addChild((tree Rt (ChatPara "\"Paljonko söin proteiinia viime viikolla?\"")))
            col.addChild((tree Rt (ChatPara "\"Analysoi harjoitteluni viimeisen kuukauden aikana\"")))
            col.addChild((tree Rt (ChatPara "\"Mitä parannettavaa näet ruokavaliossani?\"")))
        }
        ; The log: a message and, as `DiaryChatMessageItem` has them, "copy"
        ; after each, and "save to notes" before the assistant's.
        def log (tree Rt (ChatLog (props (className "rt-chat-log rt-fill-w"))))
        for chat.sentTexts sent:string i {
            def mine (tree Rt (MsgRow (props (className "rt-msg-row rt-msg-row-end"))))
            mine.addChild((tree Rt (ChatUser (props (className "rt-chat-user rt-bubble-phone")) (ChatTx sent))))
            mine.addChild((this.iconBtn(("rt-chat-copy-u" + (to_string i)) "Kopioi viesti" (RtIcons.bookOpen("#999999")))))
            log.addChild(mine)
            if (i < (array_length chat.replies)) {
                def reply:string (itemAt chat.replies i)
                def theirs (tree Rt (MsgRow))
                theirs.addChild((this.iconBtn(("rt-chat-note-" + (to_string i)) "Tallenna muistiin" (RtIcons.penLine("#999999")))))
                theirs.addChild((tree Rt (ChatBot (props (className "rt-chat-bot rt-bubble-phone")) (ChatTx reply))))
                theirs.addChild((this.iconBtn(("rt-chat-copy-a" + (to_string i)) "Kopioi viesti" (RtIcons.bookOpen("#999999")))))
                log.addChild(theirs)
            }
        }
        if (chat.inside("sending")) {
            def streaming@(mutable):string (chat.text("streamingContent"))
            if ((strlen streaming) == 0) {
                streaming = "…"
            }
            log.addChild((tree Rt (ChatStream (ChatTx streaming))))
        }
        col.addChild(log)
        if (chat.inside("reviewing")) {
            def box (tree Rt (ChatBox (props (className "rt-sheet rt-chat-box rt-fill-w"))))
            this.chatReviewRows(box (st == "reviewing.multiAction"))
            col.addChild(box)
        }
        if (chat.inside("processing")) {
            col.addChild((tree Rt (ChatPara (props (id "rt-chat-state")) "Tallennetaan päiväkirjaan…")))
        }
        if (st == "error") {
            col.addChild((tree Rt (SheetErr (props (id "rt-chat-err")) (chat.text("error")))))
            def again (tree Rt (ModalRow))
            again.addChild((this.sheetBtn("rt-chat-cancel" "Peruuta" "Peruuta" false)))
            again.addChild((this.sheetBtn("rt-chat-retry" "Yritä uudelleen" "Yritä uudelleen" true)))
            col.addChild(again)
        }
        ; The composer. While the reply streams the send button is disabled
        ; and shows a spinner in the original; there is no cancel button, and
        ; none here — CANCEL stays reachable by id for the host's tests.
        def compose (tree Rt (ChatCompose))
        compose.addChild((this.fieldBox(chatField)))
        def send (this.iconBtn("rt-chat-send" "" (RtIcons.chevronRight("#ffffff"))))
        send.className = "rt-icon-btn rt-send-btn"
        def canSend@(mutable):boolean (st == "idle")
        if ((strlen (chat.text("inputText"))) == 0) {
            if ((chat.hasImage()) == false) {
                canSend = false
            }
        }
        if (canSend == false) {
            send.a11yDisabled = true
            send.className = "rt-icon-btn rt-send-btn rt-send-off"
        }
        compose.addChild(send)
        col.addChild(compose)
        return col
    }

    fn chatTool:EVGElement (id:string label:string) {
        def b (tree Rt (ChatTool))
        b.id = id
        b.a11yLabel = label
        b.addChild((tree Rt (ChatToolTx label)))
        return b
    }

    fn pressApp:boolean (id:string) {
        ; The calendar menu: the selector opens and closes it, an item picks
        ; a calendar and goes Home with it, "Luo uusi kalenteri" opens the
        ; wizard, and anything else closes it on the way.
        if (id == "rt-calsel") {
            calMenuOpen = (calMenuOpen == false)
            return true
        }
        if calMenuOpen {
            calMenuOpen = false
            if (id == "rt-cal-new") {
                this.openRoute("/new-calendar")
                return true
            }
            if (RtEntry.hasPrefix(id "rt-cal-")) {
                if (seed.selectCalendar((substring id 7 (strlen id)))) {
                    dayIso = ""
                    this.goSection("home")
                    section = "home"
                }
                return true
            }
        }
        ; The sheet the bar opened is answered first: it is over everything.
        ; The bar stays reachable under it, and a press there closes it on
        ; the way.
        if moreOpen {
            if ((id == "rt-more-close") || (id == "rt-nav-more")) {
                moreOpen = false
                return true
            }
            if (id == "rt-more-yearsheet") {
                moreOpen = false
                ys.openList()
                docScroll = 0.0
                scene = "yearsheet"
                return true
            }
            if ((strlen id) > 7) {
                if ((substring id 0 7) == "rt-nav-") {
                    moreOpen = false
                } {
                    if ((strlen id) > 8) {
                        if ((substring id 0 8) == "rt-more-") {
                            ; The pages behind these are not in the port;
                            ; the sheet closes, as it would on the way to one.
                            moreOpen = false
                            return true
                        }
                    }
                    return false
                }
            } {
                return false
            }
        }
        if (id == "rt-nav-home") { return (this.goSection("home")) }
        if (id == "rt-nav-calendar") {
            ; The bar's calendar is this week's; the route's `?week=` is
            ; only for the route.
            weekStart = (RtWeek.mondayOf(today))
            this.goSection("calendar")
            return true
        }
        if (id == "rt-nav-dashboard") { return (this.goSection("dashboard")) }
        if (id == "rt-dash-open") {
            ys.openList()
            ys.openDetail()
            docScroll = 0.0
            scene = "yearsheet"
            return true
        }
        if (id == "rt-nav-chat") { return (this.goSection("chat")) }
        if (id == "rt-nav-more") {
            moreOpen = true
            return true
        }
        if (RtEntry.hasPrefix(id "rt-drill-cat-")) {
            drillCat = (substring id 13 (strlen id))
            drillSortOpen = false
            return true
        }
        if (id == "rt-drill-sort") {
            drillSortOpen = (drillSortOpen == false)
            return true
        }
        if (RtEntry.hasPrefix(id "rt-drill-sort-")) {
            drillSort = (substring id 14 (strlen id))
            drillSortOpen = false
            return true
        }
        if (RtEntry.hasPrefix(id "rt-home-tab-")) {
            def tab:string (substring id 12 (strlen id))
            if (tab == homeTab) { return false }
            homeTab = tab
            docScroll = 0.0
            return true
        }
        if ((id == "rt-plan-update") || (id == "rt-plan-create")) {
            def opened:boolean (plan.open(true "cal-plan"))
            if opened {
                plan.setWeekType(exWeekType)
                def e:ScEvent (ScEvent.of("SET_WEEK_START"))
                e.withStr("weekStart" weekStart)
                plan.send(e)
            }
            return opened
        }
        if (section != "calendar") {
            return false
        }
        if ((id == "rt-day-back") || (id == "rt-day-close")) {
            if ((strlen dayIso) == 0) { return false }
            dayIso = ""
            return true
        }
        if (RtEntry.hasPrefix(id "rt-day-20")) {
            dayIso = (substring id 7 (strlen id))
            docScroll = 0.0
            return true
        }
        if (id == "rt-week-next") {
            weekStart = (RtWeek.shifted(weekStart 7))
            return true
        }
        if (id == "rt-week-prev") {
            weekStart = (RtWeek.shifted(weekStart -7))
            return true
        }
        if (id == "rt-week-today") {
            weekStart = (RtWeek.mondayOf(today))
            return true
        }
        if (id == "rt-tab-weeks") {
            calTab = "weeks"
            return true
        }
        if (id == "rt-tab-example") {
            calTab = "example"
            return true
        }
        if (id == "rt-week-target") {
            exWeekType = "target"
            return true
        }
        if (id == "rt-week-light") {
            exWeekType = "light"
            return true
        }
        if (id == "rt-ex-edit") {
            return (plan.openEdit())
        }
        return false
    }

    fn goSection:boolean (name:string) {
        if (section == name) {
            return false
        }
        section = name
        docScroll = 0.0
        dayIso = ""
        return true
    }

    ; --- the text fields ---------------------------------------------------------
    fn fields:[InputCtl] () {
        def a:[InputCtl]
        push a chatField
        push a planField
        push a addField
        push a editField
        for dayFields f:InputCtl i {
            push a f
        }
        push a wizName
        push a wizDesc
        push a wizGoals
        push a wizLevel
        push a wizPass
        push a wizConfirm
        return a
    }

    fn fieldFor:InputCtl (tid:string) {
        def all:[InputCtl] (this.fields())
        for all c:InputCtl i {
            if (c.tid == tid) {
                return c
            }
            if ((c.tid + "-text") == tid) {
                return c
            }
        }
        return (new InputCtl())
    }

    fn hasField:boolean (tid:string) {
        def c:InputCtl (this.fieldFor(tid))
        return ((strlen c.tid) > 0)
    }

    fn engine:EVGTextEngine () {
        return (measurer.getTextEngine())
    }

    ; The box the original's textarea is: the value or the placeholder, and a
    ; caret when it has focus, placed by measuring the text before it — the
    ; same measurement the painter makes, so it lands between the right two
    ; glyphs. See `gallery/ui/demo/FormDemo.rgr`, which this follows.
    fn fieldBox:EVGElement (c:InputCtl) {
        def box (tree Rt (Field))
        box.id = c.tid
        box.a11yLabel = c.name
        if ((strlen c.value) == 0) {
            box.addChild((tree Rt (FieldGhost c.placeholder)))
        } {
            def glyphs:string (c.glyphText())
            def t (tree Rt (FieldText glyphs))
            t.id = (c.tid + "-text")
            box.addChild(t)
        }
        if (focused == c.tid) {
            box.className = "rt-field rt-field-focused"
            def eng:EVGTextEngine (this.engine())
            ; The selection, as a band under the text: the platform decided
            ; where it starts and ends — a drag, a double-click, Ctrl+A — and
            ; this side draws it where those characters are.
            if (c.hasSelection()) {
                def sx:double (c.caretXAt(eng (c.selStart())))
                def ex:double (c.caretXAt(eng (c.selEnd())))
                def band (tree Rt (FieldSel))
                band.id = (c.tid + "-sel")
                band.left = (EVGUnit.px((sx - c.scrollX)))
                band.setAttribute("width" ((to_string (to_int (ex - sx))) + "px"))
                box.addChild(band)
            }
            def cx:double (c.caretXAt(eng c.caret))
            def car (tree Rt (FieldCaret))
            car.id = (c.tid + "-caret")
            car.left = (EVGUnit.px((cx - c.scrollX)))
            box.addChild(car)
        }
        return box
    }

    ; An edit reached the field; the machine hears about it, and the field is
    ; drawn from the machine again on the next rebuild.
    fn fieldChanged:void (c:InputCtl) {
        if (c.tid == "rt-chat-field") {
            chat.setInput(c.value)
        }
        if (c.tid == "rt-plan-field") {
            plan.setInstructions(c.value)
        }
        if (c.tid == "rt-add-field") {
            addDialog.send("SET_INPUT_TEXT" c.value)
        }
        if (c.tid == "rt-plan-edit-field") {
            plan.setFeedback(c.value)
        }
        def day:int (RealTrainerDemo.dayOf(c.tid "rt-plan-day-field-"))
        if (day >= 0) {
            plan.setDayInstructions(day c.value)
        }
        if (c.tid == "rt-wiz-name") { wizard.setName(c.value) }
        if (c.tid == "rt-wiz-desc") { wizard.setDescription(c.value) }
        if (c.tid == "rt-wiz-goals") { wizard.setGoals(c.value) }
        if (c.tid == "rt-wiz-level") { wizard.setLevel(c.value) }
        if (c.tid == "rt-wiz-pass") { wizard.setPassword(c.value) }
        if (c.tid == "rt-wiz-confirm") { wizard.setConfirm(c.value) }
    }

    ; Set the fields from the machines before drawing them.
    fn syncFields:void () {
        if ((chat.text("inputText")) != chatField.value) {
            chatField.setValue((chat.text("inputText")))
        }
        if ((plan.text("createInstructions")) != planField.value) {
            planField.setValue((plan.text("createInstructions")))
        }
        if (addDialog.inputText != addField.value) {
            addField.setValue(addDialog.inputText)
        }
        if ((plan.text("editGeneralFeedback")) != editField.value) {
            editField.setValue((plan.text("editGeneralFeedback")))
        }
        for dayFields f:InputCtl d {
            def note:string (plan.textIn("editDayInstructions" d))
            if (note != f.value) {
                f.setValue(note)
            }
        }
        if (wizard.name != wizName.value) { wizName.setValue(wizard.name) }
        if (wizard.description != wizDesc.value) { wizDesc.setValue(wizard.description) }
        if (wizard.goals != wizGoals.value) { wizGoals.setValue(wizard.goals) }
        if (wizard.level != wizLevel.value) { wizLevel.setValue(wizard.level) }
        if (wizard.password != wizPass.value) { wizPass.setValue(wizard.password) }
        if (wizard.confirm != wizConfirm.value) { wizConfirm.setValue(wizard.confirm) }
        ; "Näytä" shows the password: the field's kind follows the switch.
        def kind@(mutable):string "password"
        if wizard.showPassword { kind = "text" }
        wizPass.kind = kind
        wizConfirm.kind = kind
    }

    ; One whole string, a character at a time — the harness's `type` step.
    fn typeText:boolean (text:string) {
        if ((this.hasField(focused)) == false) {
            return false
        }
        def c:InputCtl (this.fieldFor(focused))
        def i@(mutable):int 0
        def len:int (strlen text)
        while (i < len) {
            c.typeChar(focused (substring text i (i + 1)))
            i = (i + 1)
        }
        c.ensureCaretVisible((this.engine()))
        this.fieldChanged(c)
        this.rebuild()
        return true
    }

    fn typeChar:boolean (ch:string) {
        return (this.typeText(ch))
    }

    fn keyWith:boolean (k:string shift:boolean ctrl:boolean) {
        layoutDirty = true
        boxesDirty = true
        if ((this.hasField(focused)) == false) {
            return false
        }
        def c:InputCtl (this.fieldFor(focused))
        c.keyDownWith(focused k shift ctrl)
        c.ensureCaretVisible((this.engine()))
        this.fieldChanged(c)
        this.rebuild()
        return true
    }

    ; --- what the browser's text session asks ---------------------------------
    fn focusedField:string () {
        if (this.hasField(focused)) {
            return focused
        }
        return ""
    }

    fn setFocus:void (id:string) {
        layoutDirty = true
        boxesDirty = true
        focused = id
    }

    fn fieldStateJson:string (tid:string) {
        def c:InputCtl (this.fieldFor(tid))
        if (c.tid != tid) {
            return "null"
        }
        this.laidOut()
        def r:EVGElement (unwrap root)
        r.settleAll()
        def found@(optional):EVGElement (RealTrainerDemo.byId(r tid))
        def out@(mutable):string "{"
        out = (out + "\"tid\":" + (EVGA11yTree.jsonString(c.tid)))
        out = (out + ",\"value\":" + (EVGA11yTree.jsonString(c.value)))
        out = (out + ",\"selStart\":" + (to_string (c.selStart())))
        out = (out + ",\"selEnd\":" + (to_string (c.selEnd())))
        out = (out + ",\"kind\":\"text\",\"maxLength\":0")
        if found {
            def box:EVGElement (unwrap found)
            out = (out + ",\"box\":{\"x\":" + (to_string (to_int (box.calculatedX))))
            out = (out + ",\"y\":" + (to_string (to_int (box.calculatedY))))
            out = (out + ",\"w\":" + (to_string (to_int (box.calculatedWidth))))
            out = (out + ",\"h\":" + (to_string (to_int (box.calculatedHeight))) + "}")
        }
        return (out + "}")
    }

    fn applyEdit:boolean (tid:string v:string selStart:int selEnd:int) {
        def c:InputCtl (this.fieldFor(tid))
        if (c.tid != tid) {
            return false
        }
        c.applyEdit(v selStart selEnd)
        c.ensureCaretVisible((this.engine()))
        this.fieldChanged(c)
        this.rebuild()
        return true
    }

    fn document:EVGElement () {
        def main (tree Rt (Main (props (className "rt-main rt-main-doc"))))
        main.addChild((tree Rt
            (Top
                (Title workTitle)
                (Spacer)
                (AddBtn (AddTx "＋  Lisää harjoitus"))
                (Note ((to_string (array_length rows)) + " riviä")))))
        if (addDialog.isOpen()) {
            main.addChild((this.addSheet()))
        }
        def list (tree Rt (DocList))
        for rows r:CompactRow i {
            list.addChild((this.documentRow(r i)))
        }
        def view (tree Rt (DocView))
        view.setAttribute("overflow" "hidden")
        view.scrollTop = docScroll
        view.addChild(list)
        main.addChild(view)
        return (tree Rt
            (Page (props (id "rt-page") (className "rt-page rt-page-dash"))
                (App
                    (child (this.rail()))
                    (child main))))
    }

    ; A wheel, a key, a drag — the host says how far and this says whether
    ; anything moved. Nothing is rebuilt: the tree is the same tree, and only
    ; the offset on its viewport changed.
    ;
    ; …and nothing is LAID OUT either, which is the difference between a page
    ; that scrolls and one that does not. `laidOut` applies the whole
    ; stylesheet and lays the whole tree out again: with a real diary in it
    ; that is every string in the document measured and every paragraph broken
    ; into lines, on every wheel event, to compute the same boxes it computed
    ; on the frame before. `EVGLayout.scrollOnly` does the only thing a scroll
    ; actually changes — it moves the scrolled subtree by the difference — and
    ; leaves the measurements alone. The sheet is not re-applied, so a hover
    ; the wheel scrolled out from under the pointer is corrected by the next
    ; move rather than by the scroll, which is what a browser does too.
    ;
    ; And the move itself is DEFERRED to the frame. What happens here is the
    ; clamp — so the caller's "did it move" and the offset it reads back are
    ; right now — and a note that a scroll is owed. `laidOut` pays it once,
    ; however many wheel or finger events arrived since the last frame:
    ; `translateSubtree` over a long diary was the single largest self-time
    ; in a profile of a drag, because a finger reports at a hundred and
    ; twenty hertz and each report walked the whole document.
    fn scrolled:void (el:EVGElement) {
        if layout {
            if (layoutDirty == false) {
                def lay:EVGLayout (unwrap layout)
                lay.clampScroll(el)
            }
            if (scrollPending == false) {
                clear scrolledEls
            }
            scrollPending = true
            this.barWake()
            ; A container the kept list has no layer for cannot be moved in
            ; it: the next frame builds.
            if retained {
                def dl:EVGDisplayList (unwrap retained)
                if ((dl.layerFor(el)) < 0) {
                    listDirty = true
                }
            }
            def known@(mutable):boolean false
            for scrolledEls e:EVGElement i {
                if (e == el) {
                    known = true
                }
            }
            if (known == false) {
                push scrolledEls el
            }
            return
        }
        this.laidOut()
    }

    ; --- A FINGER, WITH ITS SPEED ---------------------------------------------
    ;
    ; `scrollDocument` is the wheel and the keyboard: a distance, and nothing
    ; about how fast it arrived. A DRAG is different — it has a speed, and
    ; what it does when it ends depends on it — so a host that is dragging
    ; says so with these three, and gets a fling for free.
    ;
    ;   scrollDrag(dy dtMs)   the finger moved this far in this long
    ;   scrollRelease()       it lifted; returns whether that threw the page
    ;   scrollHalt()          it went down again, or a wheel took over
    ;
    ; The glide itself is advanced by `tick`, which every host already calls
    ; on every frame with the real elapsed milliseconds. There is nothing else
    ; for a host to do.
    fn scrollDrag:boolean (dy:double dtMs:double) {
        fling.track(dy dtMs)
        return (this.scrollDocument(dy))
    }

    fn scrollRelease:boolean () {
        return (fling.release())
    }

    fn scrollHalt:void () {
        fling.halt()
    }

    ; The speed the page is gliding at, in pixels per millisecond. Zero when
    ; it is not, which is what a host asks to know whether it may rest.
    fn scrollVelocity:double () {
        return fling.velocity
    }

    fn scrollDocument:boolean (delta:double) {
        if (scene == "wizard") {
            def rw:EVGElement (unwrap root)
            def foundW@(optional):EVGElement (RealTrainerDemo.byId(rw "rt-wiz-body"))
            if foundW {
                def wb:EVGElement (unwrap foundW)
                def beforeW:double wb.scrollTop
                wb.scrollTop = (wb.scrollTop + delta)
                this.scrolled(wb)
                wizScroll = wb.scrollTop
                return (wb.scrollTop != beforeW)
            }
            return false
        }
        if ((scene == "app") || (scene == "yearsheet")) {
            def r0:EVGElement (unwrap root)
            ; A dialog that is open takes the wheel: its body scrolls, the
            ; page under it does not.
            if (plan.isOpen()) {
                def foundM@(optional):EVGElement (RealTrainerDemo.byId(r0 "rt-plan-body"))
                if foundM {
                    def mb:EVGElement (unwrap foundM)
                    def beforeM:double mb.scrollTop
                    mb.scrollTop = (mb.scrollTop + delta)
                    this.scrolled(mb)
                    modalScroll = mb.scrollTop
                    return (mb.scrollTop != beforeM)
                }
                return false
            }
            def found0@(optional):EVGElement (RealTrainerDemo.byId(r0 "rt-ph-main"))
            if found0 {
                def body:EVGElement (unwrap found0)
                def before0:double body.scrollTop
                body.scrollTop = (body.scrollTop + delta)
                this.scrolled(body)
                docScroll = body.scrollTop
                return (body.scrollTop != before0)
            }
            return false
        }
        if (scene != "document") {
            return false
        }
        def before:double docScroll
        def next@(mutable):double (docScroll + delta)
        if (next < 0.0) {
            next = 0.0
        }
        def r:EVGElement (unwrap root)
        def found@(optional):EVGElement (RealTrainerDemo.byId(r "rt-doc-view"))
        if found {
            def v:EVGElement (unwrap found)
            v.scrollTop = next
            this.scrolled(v)
            docScroll = v.scrollTop
        }
        return (docScroll != before)
    }

    ; --- saving ---------------------------------------------------------------
    ;
    ; The current move's line, written back from the row the steppers edited.
    ; Nothing else in the document is touched.
    fn saveCurrentMove:boolean () {
        if ((array_length rows) == 0) {
            return false
        }
        def row:CompactRow (at rows moveIndex)
        def line:string (CompactWrite.line(row))
        if ((strlen line) == 0) {
            backend.state = "failed"
            backend.message = "Tätä riviä ei voi kirjoittaa takaisin"
            return true
        }
        def d:CompactDocument (unwrap doc)
        d.replaceLine((d.lineOf(moveIndex)) line)
        backend.begin((d.text()))
        return true
    }

    fn rebuild:void () {
        layoutDirty = true
        boxesDirty = true
        if (seed.calendarId != cardsCalendar) {
            this.forgetCards()
            cardsCalendar = seed.calendarId
        }
        this.syncFields()
        if (scene == "signin") {
            root = (this.signin())
        }
        if (scene == "dashboard") {
            root = (this.dashboard())
        }
        if (scene == "session") {
            root = (this.workout())
        }
        if (scene == "document") {
            root = (this.document())
        }
        if (scene == "chat") {
            root = (this.chatScreen())
        }
        if (scene == "app") {
            root = (this.appScreen())
        }
        if (scene == "wizard") {
            root = (this.wizardScreen())
        }
        if (scene == "yearsheet") {
            root = (this.yearsheetScreen())
        }
        if (scene == "loading") {
            root = (this.loader())
        }
        this.writeFrame()
    }

    ; --- the clock ------------------------------------------------------------

    fn progress:double () {
        if (scene != "loading") {
            return 1.0
        }
        def p:double (elapsedMs / fillMs)
        if (p > 1.0) {
            return 1.0
        }
        return p
    }

    fn spinDeg:double () {
        def turns:double ((elapsedMs * spinDegPerSec) / 1000.0)
        while (turns >= 360.0) {
            turns = (turns - 360.0)
        }
        return turns
    }

    ; The clock. Nothing here about the layout: `tickWork` raises
    ; `layoutDirty` on the paths that write on the tree, and a frame in which
    ; the clock ran and nothing moved leaves the last layout standing — on a
    ; forty-workout diary that is the difference between 0.74 ms a frame and
    ; 13.72.
    fn tick:boolean (dtMs:double) {
        def settled:boolean (this.barTick(dtMs))
        def changed:boolean (this.tickWork(dtMs))
        return (changed || settled)
    }

    ; --- the scrollbar's state -------------------------------------------------

    ; A scroll happened: the bar comes up, if it was down.
    fn barWake:void () {
        if (barActiveMs <= 0.0) {
            listDirty = true
        }
        barActiveMs = 800.0
    }

    ; The bar goes down when the page has been still; true on the frame it
    ; does, which is a frame to draw.
    fn barTick:boolean (dtMs:double) {
        if (barActiveMs <= 0.0) {
            return false
        }
        barActiveMs = (barActiveMs - dtMs)
        if (barActiveMs > 0.0) {
            return false
        }
        barActiveMs = 0.0
        listDirty = true
        return true
    }

    fn barState:int () {
        if barDragging {
            return 2
        }
        if (barActiveMs > 0.0) {
            return 1
        }
        return 0
    }

    ; The pointer moved: is it on a thumb now, and did that change? Returns
    ; whether the picture changed, so a host draws once; `overScrollbar`
    ; says where the pointer is.
    fn scrollbarHover:boolean (px:double py:double) {
        def dl:EVGDisplayList (this.display())
        def changed@(mutable):boolean false
        ; Near the edge: the bar comes up so it can be seen and taken.
        def n:int (dl.nearBarAt(px py))
        def none@(optional):EVGElement
        if (n < 0) {
            if barNearEl {
                barNearEl = none
                changed = true
            }
        } {
            def nearEl:EVGElement (dl.layerElement(n))
            def same@(mutable):boolean false
            if barNearEl {
                if ((unwrap barNearEl) == nearEl) {
                    same = true
                }
            }
            if (same == false) {
                barNearEl = nearEl
                changed = true
            }
        }
        ; On the thumb: lit.
        def i:int (dl.thumbAt(px py))
        if (i < 0) {
            if barHoverEl {
                barHoverEl = none
                changed = true
            }
        } {
            def el:EVGElement (dl.layerElement(i))
            def sameHover@(mutable):boolean false
            if barHoverEl {
                if ((unwrap barHoverEl) == el) {
                    sameHover = true
                }
            }
            if (sameHover == false) {
                barHoverEl = el
                changed = true
            }
        }
        if changed {
            listDirty = true
        }
        return changed
    }

    fn overScrollbar:boolean () {
        if barHoverEl {
            return true
        }
        return false
    }

    ; A press on a thumb takes it: true when it did, and the moves that
    ; follow go to `scrollbarDrag`.
    fn scrollbarGrab:boolean (px:double py:double) {
        def dl:EVGDisplayList (this.display())
        def i@(mutable):int (dl.thumbAt(px py))
        if (i < 0) {
            ; Not the thumb: the track, if the bar is up — a press there
            ; jumps the page to the point and holds the thumb from there.
            def t:int (dl.trackAt(px py))
            if (t < 0) {
                return false
            }
            def tel:EVGElement (dl.layerElement(t))
            def up@(mutable):boolean (barActiveMs > 0.0)
            if barNearEl {
                if ((unwrap barNearEl) == tel) {
                    up = true
                }
            }
            if (up == false) {
                return false
            }
            tel.scrollTop = (dl.trackScrollFor(t py))
            this.scrolled(tel)
            this.rememberScroll(tel)
            i = t
        }
        def el:EVGElement (dl.layerElement(i))
        fling.halt()
        barDragEl = el
        barDragScale = (dl.thumbScale(i))
        barDragY = py
        barDragTop = el.scrollTop
        barDragging = true
        listDirty = true
        barActiveMs = 800.0
        return true
    }

    ; The pointer, dragging the thumb: the page moves by the thumb's scale.
    fn scrollbarDrag:boolean (py:double) {
        if (barDragging == false) {
            return false
        }
        def el:EVGElement (unwrap barDragEl)
        def before:double el.scrollTop
        def next@(mutable):double barDragTop
        if (barDragScale > 0.0) {
            next = (barDragTop + ((py - barDragY) / barDragScale))
        }
        el.scrollTop = next
        this.scrolled(el)
        this.rememberScroll(el)
        return (el.scrollTop != before)
    }

    fn scrollbarRelease:boolean () {
        if (barDragging == false) {
            return false
        }
        barDragging = false
        def none@(optional):EVGElement
        barDragEl = none
        listDirty = true
        barActiveMs = 800.0
        return true
    }

    ; The offsets this app keeps for its rebuilt trees, written back from
    ; the container that was just scrolled by something other than
    ; `scrollDocument`.
    fn rememberScroll:void (el:EVGElement) {
        if (el.id == "rt-doc-view") {
            docScroll = el.scrollTop
        }
        if (el.id == "rt-ph-main") {
            docScroll = el.scrollTop
        }
        if (el.id == "rt-wiz-body") {
            wizScroll = el.scrollTop
        }
        if (el.id == "rt-plan-body") {
            modalScroll = el.scrollTop
        }
    }

    ; The thumbs the current list draws, for a check.
    fn scrollbarThumbsJson:string () {
        def dl:EVGDisplayList (this.display())
        return (dl.thumbsJson())
    }

    fn tickWork:boolean (dtMs:double) {
        ; The glide, before anything else this frame: it is the one thing that
        ; moves without anybody having touched the screen. `scrollDocument`
        ; leaves the scroll shortcut armed, and reaching the end of the
        ; document stops it — there is nowhere left to go and a fling that
        ; keeps ticking against the end is a frame spent on nothing.
        if (fling.running()) {
            def glide:double (fling.step(dtMs))
            if (glide != 0.0) {
                if ((this.scrollDocument(glide)) == false) {
                    fling.halt()
                }
                return true
            }
        }
        ; A toast stays for a while and goes.
        if (toastMs > 0.0) {
            toastMs = (toastMs - dtMs)
            if (toastMs <= 0.0) {
                toastMs = 0.0
                toastText = ""
                this.rebuild()
                return true
            }
        }
        ; The calendar the wizard asked for is written, or is not.
        if (wizJob.tick(dtMs)) {
            def ok:boolean (wizJob.state == "saved")
            wizJob.clear()
            this.wizardDone(ok)
            this.rebuild()
            return true
        }
        ; The stream. Each chunk is an event the machine appends through its
        ; named action; the end is the reply, or the failure the switch asked
        ; for.
        if (chatSim.tick(dtMs)) {
            for chatSim.dueChunks c:string i {
                chat.chunk(c)
            }
            if (chatSim.produced == "complete") {
                chat.complete(chatSim.reply chatSim.kinds chatSim.ids)
            }
            if (chatSim.produced == "error") {
                this.chatFailed()
            }
            this.rebuild()
            return true
        }
        if (chatJob.tick(dtMs)) {
            chat.saveComplete()
            chatJob.clear()
            this.rebuild()
            return true
        }
        if (planJob.tick(dtMs)) {
            ; The job the plan dialog started is the job that answers it.
            plan.complete((planJob.state == "saved") "Suunnitelman luonti epäonnistui — yritä uudelleen")
            planJob.clear()
            this.rebuild()
            return true
        }
        if (backend.tick(dtMs)) {
            ; The save that the dialog started is the save that answers it.
            if (addDialog.state == "saving") {
                if (backend.state == "saved") {
                    ; The entry the sheet was for, on its day, in the
                    ; calendar that was open — what the store's addEntry
                    ; does when the request comes back.
                    if (scene == "app") {
                        addedSeq = (addedSeq + 1)
                        def onDay:string addDialog.targetDate
                        seed.addEntry(("added-" + (to_string addedSeq)) seed.calendarId onDay (("[" + onDay) + ("]\n" + addDialog.inputText)))
                    }
                    addDialog.send("SAVE_COMPLETE" "")
                } {
                    addDialog.send("ERROR" backend.message)
                }
            }
            this.rebuild()
            return true
        }
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        if flights {
            def moving:boolean (t.advanceTree(r dtMs))
        }
        if (scene == "session") {
            if timerRunning {
                timerLeftMs = (timerLeftMs - dtMs)
                if (timerLeftMs <= 0.0) {
                    timerLeftMs = 0.0
                    timerRunning = false
                }
                this.writeDial()
                return true
            }
            return (this.inFlight(t r))
        }
        if (scene != "loading") {
            ; Nothing on the later scenes moves by itself; a hover does, and
            ; the transition engine is what says whether one is in flight.
            return (this.inFlight(t r))
        }
        elapsedMs = (elapsedMs + dtMs)
        if (elapsedMs >= (fillMs + holdMs)) {
            this.setScene("signin")
            return true
        }
        this.writeFrame()
        return true
    }

    ; A flight in progress wrote this frame's values onto the tree — a
    ; colour, an opacity, a transform: the properties `EVGTransition`
    ; animates are all paint, and the painter reads them off the element.
    ; So the frame is drawn, and nothing is laid out for it: the flight
    ; started when the sheet last ran, and until something changes the
    ; page again there is nothing for the sheet to re-declare. Laying the
    ; page out for every frame of a 160ms hover fade was ten full layouts
    ; per hover on a long diary.
    fn inFlight:boolean (t:EVGTransition r:EVGElement) {
        if (flights == false) {
            return false
        }
        if (t.busy(r)) {
            listDirty = true
            return true
        }
        flights = false
        return false
    }

    fn setScene:void (name:string) {
        if (name == scene) {
            return
        }
        scene = name
        docScroll = 0.0
        elapsedMs = 0.0
        hovered = ""
        pressed = ""
        this.rebuild()
    }

    fn sceneName:string () {
        return scene
    }

    ; The phone shell's section — home, calendar, dashboard, chat — which is
    ; what a host on a phone asks about, the scene being the shell itself.
    fn sectionName:string () {
        return section
    }

    ; The scene, as a THEME. `EVGStyleSheet` matches one class token per
    ; selector, so two `ProgressCtl`s in one app cannot be told apart by where
    ; they sit — `.a .b` is not a selector it has. A theme is: the session
    ; scene asks for "session" and the rules scoped to it apply, and every
    ; other scene asks for "" and they do not.
    fn themeName:string () {
        if (scene == "session") {
            return "session"
        }
        return ""
    }

    ; --- what changes every frame ---------------------------------------------
    ;
    ; The bar's value goes to the CONTROLLER, which owns the percentage and the
    ; number a reader is given; the ring's angle is written onto the element,
    ; marked inline so the cascade leaves it alone — without that the
    ; stylesheet would put the rotation back to 0 on the next pass, which is a
    ; ring that never turns.
    ; WRITES ON THE TREE, so the layout it produced is no longer current:
    ; this sets class names and the stylesheet is what turns them into
    ; colours. Skipping `laidOut` after one of these left the ring lit the
    ; way it was lit a second ago.
    fn writeFrame:void () {
        layoutDirty = true
        boxesDirty = true
        if (scene != "loading") {
            return
        }
        def r:EVGElement (unwrap root)
        def p:double (this.progress())
        ; ProgressCtl's value is a double now -- it carries a measured
        ; 33.333 straight through to aria-valuenow -- and does its own
        ; rounding for the percentage a reader is told. So the true value
        ; goes in rather than one pre-rounded to an int.
        bar.value = (p * 100.0)
        this.dress(bar)
        def ring@(optional):EVGElement (RealTrainerDemo.byId(r "rt-ring"))
        if ring {
            def g:EVGElement (unwrap ring)
            g.setAttribute("transform" (("rotate(" + (to_string (this.spinDeg()))) + "deg)"))
            g.markInline("transform")
        }
        def pct@(optional):EVGElement (RealTrainerDemo.byId(r "rt-pct"))
        if pct {
            def e:EVGElement (unwrap pct)
            ; The controller rounds, and both references it is measured
            ; against round the same way -- 3 of 8 reads "38%", not "37%". Now
            ; that `value` is a double this has to ask for the percentage
            ; rather than stringify the value, or the caption reads
            ; "19.230769230769234 %".
            e.textContent = ((to_string (bar.percent())) + " %")
        }
        def cap@(optional):EVGElement (RealTrainerDemo.byId(r "rt-caption"))
        if cap {
            def c:EVGElement (unwrap cap)
            c.textContent = (RealTrainerDemo.captionAt(p))
        }
    }

    ; The dial, per frame. Sixty ticks, and the lit ones are however many
    ; sixtieths of the rest are still to run — the arithmetic is here and the
    ; ticks themselves know nothing, which is what makes them sixty copies of
    ; one rule in the stylesheet instead of sixty rules.
    ; WRITES ON THE TREE, so the layout it produced is no longer current:
    ; this sets class names and the stylesheet is what turns them into
    ; colours. Skipping `laidOut` after one of these left the ring lit the
    ; way it was lit a second ago.
    fn writeDial:void () {
        layoutDirty = true
        boxesDirty = true
        def r:EVGElement (unwrap root)
        def left:double 0.0
        if (timerFullMs > 0.0) {
            left = (timerLeftMs / timerFullMs)
        }
        def lit:int (to_int ((left * 60.0) + 0.999))
        def d@(optional):EVGElement (RealTrainerDemo.byId(r "rt-dial"))
        if d {
            def dial:EVGElement (unwrap d)
            def i:int 0
            while (i < (array_length dial.children)) {
                def tick:EVGElement (itemAt dial.children i)
                if (i < 60) {
                    def cls:string "rt-tick"
                    if (i < lit) {
                        cls = "rt-tick rt-tick-on"
                    }
                    tick.className = cls
                }
                i = (i + 1)
            }
        }
        def n@(optional):EVGElement (RealTrainerDemo.byId(r "rt-dial-num"))
        if n {
            def num:EVGElement (unwrap n)
            num.textContent = (to_string (to_int ((timerLeftMs / 1000.0) + 0.999)))
        }
        def c@(optional):EVGElement (RealTrainerDemo.byId(r "rt-dial-cap"))
        if c {
            def cap:EVGElement (unwrap c)
            if timerRunning {
                cap.textContent = "Sarja 1 / 3"
            } {
                if (timerLeftMs <= 0.0) {
                    cap.textContent = "Tauko ohi — jatka!"
                } {
                    cap.textContent = "Tauko pysäytetty"
                }
            }
        }
    }

    ; What a loading screen says while it waits. Three lines rather than one,
    ; because a caption that never changes is a caption nobody reads twice —
    ; and because the app it is copied from names what it is doing.
    sfn captionAt:string (p:double) {
        if (p >= 1.0) {
            return "Valmista!"
        }
        if (p >= 0.62) {
            return "Käyn läpi harjoitustietoja..."
        }
        if (p >= 0.3) {
            return "Haen suunnitelmaa..."
        }
        return "Ladataan..."
    }

    ; Is this one of the ids a controller answers for?
    sfn owns:boolean (tids:[string] id:string) {
        def i:int 0
        while (i < (array_length tids)) {
            if ((itemAt tids i) == id) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn byId@(optional):EVGElement (el:EVGElement id:string) {
        if (el.id == id) {
            def selfHit@(optional):EVGElement el
            return selfHit
        }
        def i:int 0
        while (i < (array_length el.children)) {
            def kid:EVGElement (itemAt el.children i)
            def found@(optional):EVGElement (RealTrainerDemo.byId(kid id))
            if found {
                return found
            }
            i = (i + 1)
        }
        def __missing@(optional):EVGElement
        return __missing
    }

    ; --- the pointer ----------------------------------------------------------

    ; A hover or a press that is already the case is not a change: a finger
    ; that lifts after a drag which unpressed the row at its first move
    ; starts its glide without a layout in front of it.
    fn setHover:void (id:string) {
        if (hovered == id) {
            return
        }
        layoutDirty = true
        hovered = id
    }

    fn setPressed:void (id:string) {
        if (pressed == id) {
            return
        }
        layoutDirty = true
        pressed = id
    }

    ; A press, routed to whoever owns that id. Returns whether anything changed,
    ; so the host knows whether to paint.
    ;
    ; The controllers are asked FIRST and by name, because they answer for their
    ; own ids and nothing else: `activate` on a target that is not theirs
    ; returns without doing anything, which is what makes this a list rather
    ; than a decision.
    fn press:boolean (id:string) {
        if (id == "") {
            return false
        }
        layoutDirty = true
        boxesDirty = true
        ; A field takes focus, and that is all a press on it does.
        if (this.hasField(id)) {
            def c:InputCtl (this.fieldFor(id))
            focused = c.tid
            this.rebuild()
            return true
        }
        ; The year sheet draws inside the shell: its own presses first, then
        ; the bar's, which leave it.
        if (scene == "yearsheet") {
            if (this.pressYearsheet(id)) {
                this.rebuild()
                return true
            }
            if ((RtEntry.hasPrefix(id "rt-nav-")) || moreOpen) {
                if (id != "rt-nav-more") {
                    if (moreOpen == false) {
                        scene = "app"
                    }
                }
                if (this.pressApp(id)) {
                    if (scene == "yearsheet") {
                        if (section != "calendar") {
                            ; A section the bar chose while the sheet was up.
                        }
                    }
                    this.rebuild()
                    return true
                }
                return false
            }
            return false
        }
        ; The wizard is a page of its own, with nothing of the shell on it.
        if (scene == "wizard") {
            if (this.pressWizard(id)) {
                this.rebuild()
                return true
            }
            return false
        }
        ; The rail is drawn on three screens, so it is answered before any of
        ; them. It used to live inside the dashboard's branch, which is why its
        ; buttons did nothing while a session was open — a navigation you can
        ; only use from one page is not one.
        if (this.pressSheet(id)) {
            this.rebuild()
            return true
        }
        if (this.pressPlan(id)) {
            this.rebuild()
            return true
        }
        if (scene == "chat") {
            if (this.pressChat(id)) {
                this.rebuild()
                return true
            }
        }
        if (scene == "app") {
            if (this.pressApp(id)) {
                this.rebuild()
                return true
            }
            if (section == "chat") {
                if (this.pressChat(id)) {
                    this.rebuild()
                    return true
                }
            }
            return false
        }
        if (this.pressRail(id)) {
            return true
        }
        if (scene == "signin") {
            if (id == "rt-google") {
                this.setScene("dashboard")
                return true
            }
            def before:string ((remember.stateWord()) + (tips.stateWord()))
            remember.activate(id)
            tips.activate(id)
            if (((remember.stateWord()) + (tips.stateWord())) != before) {
                this.dress(remember)
                this.dress(tips)
                return true
            }
            return false
        }
        if (scene == "dashboard") {
            ; A TAB PRESS ALWAYS REFILLS, EVEN WHEN IT CHANGES NOTHING.
            ;
            ; `activate` calls the controller's own `build()`, which clears
            ; every panel — that is what a controller that owns its subtree
            ; does. So pressing the tab that is ALREADY on emptied the
            ; dashboard: the value had not changed, this refilled nothing, and
            ; the page went blank under a tab strip that looked right.
            ;
            ; The rule that falls out: a press that reached a controller is a
            ; press that rebuilt it, and anything the app put inside has to go
            ; back afterwards.
            if (RealTrainerDemo.owns((tabs.tids()) id)) {
                tabs.activate(id)
                this.dress(tabs)
                this.fillActivePanel()
                return true
            }
            def wasOpen:string plans.openValue
            plans.activate(id)
            if (plans.openValue != wasOpen) {
                this.dress(plans)
                return true
            }
            if (id == sportOnly.tid) {
                sportOnly.activate(id)
                this.refreshDash()
                return true
            }
            def i:int 0
            while (i < (array_length goals.columns)) {
                def col:UiColumn (itemAt goals.columns i)
                if (id == (goals.colTid(col.key))) {
                    goals.toggleSort(col.key)
                    this.refreshDash()
                    return true
                }
                i = (i + 1)
            }
            return false
        }
        if (scene == "session") {
            return (this.pressSession(id))
        }
        ; On the loader there is nothing to press but the loader itself, and a
        ; press there is worth something: it skips the wait.
        ;
        ; The scene test is not decoration: this used to be the fall-through
        ; for EVERY scene, so once the document screen existed, an id nothing
        ; had handled came back as handled and the host redrew for nothing.
        if (scene == "loading") {
            elapsedMs = (fillMs + holdMs)
            return true
        }
        return false
    }

    ; The session screen's own presses. Steppers write numbers, the radio group
    ; answers for the rest chips, and the two big buttons move between the card
    ; and the dial.
    ; The dialog answers before the screen under it, which is what a modal is.
    fn pressSheet:boolean (id:string) {
        if (id == "rt-add") {
            def forDay@(mutable):string today
            if ((strlen dayIso) > 0) { forDay = dayIso }
            if (scene != "app") { forDay = "2026-02-09" }
            addDialog.today = forDay
            return (addDialog.open(forDay seed.calendarId))
        }
        if (addDialog.isOpen() == false) {
            return false
        }
        if (id == "rt-sheet-cancel") {
            return (addDialog.send("CLOSE" ""))
        }
        if (id == "rt-sheet-type") {
            return (addDialog.send("SET_INPUT_TEXT" "Exercise Maastaveto|3x5@100kg"))
        }
        if (id == "rt-sheet-image") {
            return false
        }
        if (id == "rt-sheet-save") {
            if ((strlen addDialog.inputText) == 0) {
                return false
            }
            def started:boolean (addDialog.send("START_SAVING" ""))
            if (started) {
                backend.begin(addDialog.inputText)
            }
            return started
        }
        return false
    }

    fn pressRail:boolean (id:string) {
        if (scene == "signin") {
            return false
        }
        if (scene == "loading") {
            return false
        }
        if (id == "rt-rail-out") {
            this.setScene("loading")
            return true
        }
        if (id == "rt-rail-train") {
            this.setScene("session")
            return true
        }
        if (id == "rt-rail-log") {
            this.setScene("document")
            return true
        }
        if (id == "rt-rail-home") {
            this.setScene("dashboard")
            return true
        }
        if (id == "rt-rail-chat") {
            this.setScene("chat")
            return true
        }
        ; The failure switch is a debug control, and it belongs to every screen
        ; that can save rather than to the one it was first drawn on.
        if (id == "rt-fail") {
            backend.failNext = (backend.failNext == false)
            this.rebuild()
            return true
        }
        return false
    }

    fn pressSession:boolean (id:string) {
        if (id == "rt-quit") {
            this.setScene("dashboard")
            return true
        }
        if (id == "rt-start") {
            timerOn = true
            timerFullMs = (this.restMs())
            timerLeftMs = timerFullMs
            timerRunning = true
            this.rebuild()
            this.writeDial()
            return true
        }
        if (id == "rt-pause") {
            timerRunning = (timerRunning == false)
            this.writeDial()
            return true
        }
        if (id == "rt-reset") {
            timerLeftMs = timerFullMs
            timerRunning = true
            this.writeDial()
            return true
        }
        if (id == "rt-timer-done") {
            timerOn = false
            timerRunning = false
            this.rebuild()
            return true
        }
        if (id == "rt-save") {
            this.saveCurrentMove()
            this.rebuild()
            return true
        }
        if (id == "rt-fail") {
            backend.failNext = (backend.failNext == false)
            this.rebuild()
            return true
        }
        if (id == "rt-done") {
            if (doneMoves < moveCount) {
                doneMoves = (doneMoves + 1)
            }
            this.advanceMove()
            this.rebuild()
            return true
        }
        ; The steppers. Each one nudges a field of the CURRENT ROW and nothing
        ; else — the clamps live with the row, because a set count of zero is
        ; not a state the plan can hold either.
        def row:CompactRow (at rows moveIndex)
        if (id == "rt-sets-down") {
            CompactRowEdit.nudge(row "sets" -1)
            this.rebuild()
            return true
        }
        if (id == "rt-sets-up") {
            CompactRowEdit.nudge(row "sets" 1)
            this.rebuild()
            return true
        }
        if (id == "rt-reps-down") {
            CompactRowEdit.nudge(row "reps" -1)
            this.rebuild()
            return true
        }
        if (id == "rt-reps-up") {
            CompactRowEdit.nudge(row "reps" 1)
            this.rebuild()
            return true
        }
        if (id == "rt-weight-down") {
            CompactRowEdit.nudge(row "weight" -5)
            this.rebuild()
            return true
        }
        if (id == "rt-weight-up") {
            CompactRowEdit.nudge(row "weight" 5)
            this.rebuild()
            return true
        }
        def was:string rest.value
        rest.activate(id)
        if (rest.value != was) {
            this.dress(rest)
            return true
        }
        return false
    }

    ; The dashboard panel, rebuilt in place. Only the tab's own content is
    ; replaced — the tab strip, its roving focus and every other controller's
    ; state are where they were.
    fn refreshDash:void () {
        def i:int 0
        while (i < (array_length tabs.items)) {
            def it:UiItem (itemAt tabs.items i)
            if (it.value == tabs.value) {
                def panel:EVGElement (unwrap it.contentEl)
                clear panel.children
            }
            i = (i + 1)
        }
        this.fillActivePanel()
    }

    fn markStates:void (el:EVGElement) {
        el.isHovered = false
        el.isPressed = false
        if ((strlen el.id) > 0) {
            if (el.id == hovered) {
                el.isHovered = true
            }
            if (el.id == pressed) {
                el.isPressed = true
            }
        }
        def i:int 0
        while (i < (array_length el.children)) {
            def kid:EVGElement (itemAt el.children i)
            this.markStates(kid)
            i = (i + 1)
        }
    }

    ; --- the three questions a host asks --------------------------------------

    fn laidOut:EVGLayout () {
        ; The scroll shortcut. Nothing since the last layout has changed a
        ; style, a size or the tree, so there is nothing to lay out; if the
        ; page scrolled, the subtree is moved by the difference — see
        ; `EVGLayout.scrollOnly` — once, for every scroll event since the
        ; last frame.
        if (layoutDirty == false) {
            if layout {
                def kept:EVGLayout (unwrap layout)
                this.scrollKept(kept)
                return kept
            }
        }
        listDirty = true
        def r:EVGElement (unwrap root)
        def s:EVGStyleSheet (unwrap sheet)
        s.setViewport(pageW pageH coarsePointer)
        this.markStates(r)
        s.applyTree(r (this.themeName()))
        def t:EVGTransition transitions
        t.reconcileTree(r)
        flights = (t.busy(r))
        layoutDirty = false
        ; A pass that wrote only paint — a hover's colours, a pressed row's
        ; background — moved no box, and the sheet says so. The positions
        ; stand, a scroll that is owed is paid the cheap way, and the whole
        ; layout is skipped: on a long diary that is the difference between
        ; a hover costing a frame and costing 13ms. The sheet's word is
        ; final only for what went through the sheet; `boxesDirty` is
        ; everything that did not.
        if (boxesDirty == false) {
            if (s.layoutClean()) {
                if layout {
                    def kept:EVGLayout (unwrap layout)
                    this.scrollKept(kept)
                    return kept
                }
            }
        }
        ; The full layout reads the containers' offsets itself.
        scrollPending = false
        boxesDirty = false
        layouts = (layouts + 1)
        if layout {
            def lay:EVGLayout (unwrap layout)
            lay.layout(r)
            return lay
        }
        def fresh (new EVGLayout())
        fresh.setPageSize(pageW pageH)
        layout = fresh
        fresh.layout(r)
        return fresh
    }

    ; The scroll owed to a layout that is being kept, paid.
    fn scrollKept:void (kept:EVGLayout) {
        if scrollPending {
            scrollPending = false
            for scrolledEls e:EVGElement i {
                kept.scrollOnlyFrom(e)
            }
            clear scrolledEls
        }
    }

    ; The frame as an OBJECT. A browser host has to parse something anyway, so
    ; it asks for the JSON below; a host that shares a process with this demo --
    ; the Apple port paints from Swift -- should not serialise a display list
    ; only to parse it back. It is the same list either way.
    ; Whether the display list leaves out what the scroll viewport cannot
    ; reach — see `EVGDisplayList`'s note on culling. On by default and here
    ; only so the two lists can be compared: `web/scroll-check.mjs` builds the
    ; frame both ways and asserts that the text a reader can see is the same
    ; text in the same order.
    ; How many full layouts have been done. See `layouts`.
    fn layoutCount:int () {
        return layouts
    }

    fn setCulling:void (on:boolean) {
        cullOffscreen = on
        listDirty = true
    }

    ; The host tree (`EVGHostTree`), kept across frames: what changed since
    ; the last time a host that keeps nodes asked. The retained DOM painter
    ; (`gallery/evg/html/evg-dom.js`, `?painter=dom` on the page) reads it in
    ; place of the display list; the layout is the same `laidOut()`, so the
    ; hit test, the fields and the scroll are exactly what the WebGL page has.
    def hostTree:EVGHostTree (new EVGHostTree())

    fn hostJson:string () {
        def lay:EVGLayout (this.laidOut())
        def r:EVGElement (unwrap root)
        hostTree.setTextEngine((lay.getTextEngine()))
        hostTree.build(r)
        return (hostTree.toJson())
    }

    fn display:EVGDisplayList () {
        def lay:EVGLayout (this.laidOut())
        def r:EVGElement (unwrap root)
        ; The kept list, moved, while a scroll is all that happened and the
        ; containers are still inside what it was built for. A frame that
        ; only scrolled then costs no walk of the tree at all — the layout
        ; is kept, the list is kept, and a host that keeps what it built
        ; from the list keeps that too.
        if ((listDirty == false) && cullOffscreen) {
            if retained {
                def kept:EVGDisplayList (unwrap retained)
                if (kept.refreshLayers()) {
                    return kept
                }
            }
        }
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.setCulling(cullOffscreen)
        ; The fragments the last list kept, carried over — see
        ; `EVGDisplayList.fragments`. A flight inside a kept subtree moves
        ; its stamp on every frame (`EVGTransition.advanceTree`), so the
        ; subtrees a fade is running in are drawn afresh and the rest kept.
        if retained {
            dl.takeFragments((unwrap retained))
        }
        dl.setScrollbars(true)
        dl.setScrollbarState((this.barState()))
        dl.setScrollbarHover(barHoverEl)
        dl.setScrollbarNear(barNearEl)
        ; A list that leaves nothing out reads every box, so every box is
        ; put where it belongs first; the charts are read off their boxes
        ; by hand, outside the walk, and want the same.
        if ((cullOffscreen == false) || ((array_length charts) > 0)) {
            r.settleAll()
        }
        ; THE OVERSCAN IS WHAT THE KEPT LIST LIVES ON: two heights each way
        ; at rest, and in a fling three ahead and one behind, so a throw
        ; goes screens between builds and the rows it arrives at are
        ; already in the list. Under a wheel with no speed to read the two
        ; are the same.
        def v:double fling.velocity
        dl.setOverscan((pageH * 2.0) (pageH * 2.0))
        if (v > 0.5) {
            dl.setOverscan((pageH * 1.0) (pageH * 3.0))
        }
        if (v < (0.0 - 0.5)) {
            dl.setOverscan((pageH * 3.0) (pageH * 1.0))
        }
        dl.build(r)
        this.emitCharts(dl r)
        listBuilds = (listBuilds + 1)
        dl.buildSeq = listBuilds
        retained = dl
        listDirty = false
        return dl
    }

    fn displayListJson:string () {
        return ((this.display()).toJson())
    }

    fn hitId:string (px:double py:double) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def hit (new EVGHitTest())
        return (hit.idAt(r px py))
    }

    fn a11yJson:string (generation:int focusId:string) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        r.settleAll()
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "RealTrainer" generation focusId))
        return (t.toJson())
    }

    fn a11yProblems:[string] () {
        this.laidOut()
        def r:EVGElement (unwrap root)
        r.settleAll()
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "RealTrainer" 1 ""))
        return (t.lint())
    }

    fn styleErrorCount:int () {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getErrorCount())
    }

    fn styleErrorAt:string (i:int) {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getError(i))
    }

    fn widthPx:double () {
        return pageW
    }

    fn heightPx:double () {
        return pageH
    }

    ; A flat dump of the tree, so a test can assert on the shape with no
    ; browser and no picture.
    sfn describe:string (el:EVGElement depth:int) {
        def pad:string ""
        def i:int 0
        while (i < depth) {
            pad = pad + "  "
            i = (i + 1)
        }
        def line:string (pad + el.className)
        if ((strlen el.textContent) > 0) {
            line = ((line + " ") + el.textContent)
        }
        def out:string (line + "\n")
        def j:int 0
        while (j < (array_length el.children)) {
            out = out + (RealTrainerDemo.describe((itemAt el.children j) (depth + 1)))
            j = (j + 1)
        }
        return out
    }

    sfn main:void () {
        def app (new RealTrainerDemo())
        app.setupControls()
        print "--- the loader ---"
        print (RealTrainerDemo.describe((app.loader()) 0))
        print "--- the sign-in page ---"
        print (RealTrainerDemo.describe((app.signin()) 0))
        print "--- the dashboard ---"
        print (RealTrainerDemo.describe((app.dashboard()) 0))
    }
}

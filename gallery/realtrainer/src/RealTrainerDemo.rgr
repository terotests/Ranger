    ; --- scene three: the dashboard -------------------------------------------

    sfn iconHome:string () {
        return ((RealTrainerDemo.svgOpen()) +
            "<path d='M12 3l9 8h-3v9h-5v-6h-2v6H6v-9H3l9-8z'/></svg>")
    }

    sfn iconCalendar:string () {
        return ((RealTrainerDemo.svgOpen()) +
            "<path d='M7 2v2h10V2h2v2h2a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h2V2h2zM4 9v11h16V9H4z'/>" +
            "<path d='M6 11h4v4H6zm6 0h4v4h-4z'/></svg>")
    }

    sfn iconBook:string () {
        return ((RealTrainerDemo.svgOpen()) +
            "<path d='M4 3h11a3 3 0 0 1 3 3v15H7a3 3 0 0 1-3-3V3zm2 2v13a1 1 0 0 0 1 1h9V6a1 1 0 0 0-1-1H6z'/>" +
            "<path d='M8 8h6v2H8zm0 4h6v2H8z'/></svg>")
    }


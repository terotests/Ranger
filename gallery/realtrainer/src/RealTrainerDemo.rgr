        return ((RealTrainerDemo.svgOpen()) +
            "<path d='M5 3h7v2H6v14h6v2H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z'/>" +
            "<path d='M15.6 7.4L20.2 12l-4.6 4.6-1.4-1.4 2.2-2.2H9v-2h7.4l-2.2-2.2 1.4-1.4z'/></svg>")
    }

    ; The rail's buttons carry ARTWORK and a name, and the two are not the same
    ; thing: the glyph is `aria-hidden`, so a reader hears "Etusivu" and never
    ; hears a shape described.
    sfn railButton:EVGElement (btnId:string icon:string label:string) {
        def glyph (tree Rt (Icon (props (className "rt-rail-icon"))))
        glyph.svgSource = icon
        def btn (tree Rt (RailBtn (props (id btnId) (a11yLabel label))))
        btn.addChild(glyph)
        return btn
    }

    fn rail:EVGElement () {
        def rail (tree Rt (Rail))
        rail.addChild((RealTrainerDemo.railButton("rt-rail-home" (RealTrainerDemo.iconHome()) "Etusivu")))
        rail.addChild((RealTrainerDemo.railButton("rt-rail-plan" (RealTrainerDemo.iconCalendar()) "Suunnitelmat")))
        rail.addChild((RealTrainerDemo.railButton("rt-rail-log" (RealTrainerDemo.iconBook()) "Päiväkirja")))
        rail.addChild((RealTrainerDemo.railButton("rt-rail-train" (RealTrainerDemo.iconMic()) "Aloita treeni")))
        rail.addChild((RealTrainerDemo.railButton("rt-rail-chat" (RealTrainerDemo.iconChat()) "Valmentaja")))
        rail.addChild((RealTrainerDemo.railButton("rt-rail-out" (RealTrainerDemo.iconExit()) "Kirjaudu ulos")))
        return rail
    }

    ; The goals table. `TableCtl` owns the sort — which column, which way, and
    ; the third click that puts the rows back the way they came — and this
    ; builds the boxes for whatever order it hands over.
    fn goalsTable:EVGElement () {
        def head (tree Rt (HeadRow (props (id (goals.headRowTid())))))
        def i:int 0
        while (i < (array_length goals.columns)) {
            def col:UiColumn (itemAt goals.columns i)
            def label:string col.label
            ; `aria-sort` as EVGA11yTree spells it: 1 is NONE, 2 ascending,
            ; 3 descending — and 0 is "this is not a sortable header at all".
            ; Read as 0/1/2 both columns wore an arrow at once, which is a
            ; table claiming to be sorted two ways.
            def state:int (goals.sortStateOf(col.key))
            if (state == 2) {
                label = (label + "   ↑")
            }
            if (state == 3) {
                label = (label + "   ↓")
            }
            def th (tree Rt
                (Th (props (id (goals.colTid(col.key))) (a11yLabel col.label)
                           (className ("rt-th rt-th-" + col.key)))
                    (ThText label)))
            th.a11ySorted = state
            head.addChild(th)
            i = (i + 1)
        }
        def body (tree Rt (Body))
        def rows:[UiRecord] (goals.sortedRecords())
        def j:int 0
        while (j < (array_length rows)) {
            def rec:UiRecord (itemAt rows j)
            def kind:string (itemAt rec.cells 1)
            def show:boolean true
            ; The toggle above the table is a FILTER and not a sort: it hides
            ; rows rather than moving them, so the sort the controller has
            ; arrived at still holds for what is left.
            if sportOnly.on {
                if (kind != "Sport") {
                    show = false
                }
            }
            if show {
                def what:string (itemAt rec.cells 0)
                def row (tree Rt
                    (Tr (props (id (goals.rowTid(rec.key))))
                        (Dot)
                        (Td (props (id (goals.cellTid(rec.key "goal")))) what)
                        (Spacer)
                        (TdDim (props (id (goals.cellTid(rec.key "kind")))) kind)))
                body.addChild(row)
            }
            j = (j + 1)
        }
        return (tree Rt
            (Table (props (id "rt-goals"))
                (child head)
                (child body)))
    }

    ; Thirty days, seven across — one CSS grid, and the only thing this app
    ; needs one for. A flex row that wraps would place the same boxes and would
    ; not keep a column above a column.
    sfn calendar:EVGElement () {
        def cal (tree Rt (Cal))
        def names:[string] ([] _:string ("ma" "ti" "ke" "to" "pe" "la" "su"))
        def i:int 0
        while (i < 7) {
            def dayName:string (itemAt names i)
            cal.addChild((tree Rt (CalHead (props (id ("rt-cal-h-" + dayName))) dayName)))
            i = (i + 1)
        }
        ; Which days carry a session. Three a week, and the pattern is the one
        ; the plan above says: heavy, light, throw.
        def day:int 1
        while (day <= 28) {
            def cls:string "rt-cal-day"
            def rest:int (day - (7 * (idiv day 7)))
            def marked:boolean false
            if (rest == 1) {
                marked = true
            }
            if (rest == 3) {
                marked = true
            }
            if (rest == 6) {
                marked = true
            }
            if marked {
                cls = "rt-cal-day rt-cal-day-on"
            }
            def dayNum:string (to_string day)
            def cell (tree Rt
                (CalDay (props (id ("rt-cal-d-" + dayNum)) (className cls)
                               (a11yLabel (dayNum + ". päivä")))
                    (CalNum dayNum)))
            if marked {
                cell.addChild((tree Rt (CalMark)))
            }
            cal.addChild(cell)
            day = (day + 1)
        }
        return cal
    }

    fn dashPanel:EVGElement () {
        this.dress(sportOnly)
        def col (tree Rt
            (Col (props (className "rt-dash"))
                (Section (props (id "rt-h-plan")) "Aktiivinen suunnitelma")
                (PlanCard
                    (PlanName "Kuulantyöntäjän vuosisuunnitelma 2025-2026")
                    (PlanDesc "Kokeneen kuulantyöntäjän vuosisuunnitelma, joka painottaa voiman eri osa-alueiden kehittämistä ja lajikohtaista nopeutta.")
                    (PlanWhen "Aloitettu: 1.10.2025"))
                (Notice
                    (NoticeHd "Seuraava jakso alkaa huomenna!")
                    (NoticeTx "Ulkokilpailukausi 2 — tavoite: pääkilpailut ja kauden huipennus"))))
        def head (tree Rt (Row (props (className "rt-goals-head"))))
        head.addChild((tree Rt (Section (props (id "rt-h-goals")) "Tavoitteet")))
        head.addChild((tree Rt (Spacer)))
        head.addChild((unwrap sportOnly.rootEl))
        col.addChild(head)
        col.addChild((this.goalsTable()))
        return col
    }

    fn drillsPanel:EVGElement () {
        this.dress(plans)
        def col (tree Rt (Col (props (className "rt-dash"))))
        col.addChild((tree Rt (Section (props (id "rt-h-plans")) "Kaikki suunnitelmat")))
        col.addChild((unwrap plans.rootEl))
        return col
    }

    fn calPanel:EVGElement () {
        def col (tree Rt (Col (props (className "rt-dash"))))
        col.addChild((tree Rt (Section (props (id "rt-h-cal")) "Lokakuu")))
        col.addChild((RealTrainerDemo.calendar()))
        return col
    }

    ; The panel belongs to `TabsCtl`, and what is IN it belongs to the app.
    ; `build()` puts an empty body label in each panel and this fills the one
    ; that is showing — the same bargain `WindowCtl` makes with its `bodyEl`:
    ; the controller owns the chrome and the states, the caller owns the
    ; content.
    fn fillActivePanel:void () {
        def i:int 0
        while (i < (array_length tabs.items)) {
            def it:UiItem (itemAt tabs.items i)
            if (it.value == tabs.value) {
                def panel:EVGElement (unwrap it.contentEl)
                if (it.value == "cal") {
                    panel.addChild((this.calPanel()))
                }
                if (it.value == "drills") {
                    panel.addChild((this.drillsPanel()))
                }
                if (it.value == "dash") {
                    panel.addChild((this.dashPanel()))
                }
            }
            i = (i + 1)
        }
    }

    fn dashboard:EVGElement () {
        this.dress(tabs)
        this.fillActivePanel()
        def main (tree Rt
            (Main
                (Top
                    (Title "Dashboard")
                    (Spacer)
                    (PlanBtn (AddTx "Suunnittele viikko"))
                    (Note "Tero — 95 %"))))
        if (plan.isOpen()) {
            main.addChild((this.planSheet()))
        }
        main.addChild((unwrap tabs.rootEl))
        return (tree Rt
            (Page (props (id "rt-page") (className "rt-page rt-page-dash"))
                (App
                    (child (this.rail()))
                    (child main))))
    }

    ; --- scene four: one training session -------------------------------------
    ;
    ; The screen a person is actually on while training: what to do, how much
    ; of it, and a clock. Everything on it is flex — three steppers on a row,
    ; two buttons that share a line — except the dial, which is the ring again
    ; at a larger size and with a different thing to say.

    sfn stepper:EVGElement (capId:string cap:string value:string) {
        return (tree Rt
            (Step
                (StepCap cap)
                (StepRow
                    (StepBtn (props (id (capId + "-down")) (a11yLabel (cap + " vähemmän")))
                        (StepBtnTx "−"))
                    (StepVal (props (id (capId + "-value"))) value)
                    (StepBtn (props (id (capId + "-up")) (a11yLabel (cap + " enemmän")))
                        (StepBtnTx "+")))))
    }

    fn failLabel:string () {
        if (backend.failNext) {
            return "vikatila päällä"
        }
        return "vikatila pois"
    }

    fn moveCard:EVGElement () {
        this.dress(rest)
        def row:CompactRow (at rows moveIndex)

        ; One element per part, and the tone becomes a CLASS — a controller
        ; writes class names and never a colour, and this card is held to the
        ; same rule.
        def plan (tree Rt (MovePlan))
        def parts:[StatPart] (CompactStatBuilder.parts(row))
        for parts p:StatPart i {
            plan.addChild((tree Rt (StatTx (props (className ("rt-stat rt-stat-" + p.tone))) p.text)))
        }

        def head (tree Rt
            (MoveHead
                (MoveName (((to_string (this.moveOrdinal())) + ". ") + (CompactStatBuilder.label(row))))
                (Spacer)))
        head.addChild(plan)

        def card (tree Rt (Move (props (id "rt-move"))))
        card.addChild(head)

        def where:string (this.sectionOf(moveIndex))
        if ((strlen where) > 0) {
            card.addChild((tree Rt (MoveWhere where)))
        }

        ; A measured row records what happened. Steppers under it would be
        ; offering to edit the past, so the card says what it is instead.
        if (CompactRowEdit.isPlanned(row)) {
            def steps (tree Rt (Steps))
            steps.addChild((RealTrainerDemo.stepper("rt-sets" "Sarjat" (to_string (CompactRowEdit.sets(row))))))
            steps.addChild((tree Rt (Times "×")))
            steps.addChild((RealTrainerDemo.stepper("rt-reps" "Toistot" (to_string (CompactRowEdit.reps(row))))))
            steps.addChild((tree Rt (Times "×")))
            steps.addChild((RealTrainerDemo.stepper("rt-weight" "Paino" ((to_string (CompactRowEdit.weight(row))) + "kg"))))
            card.addChild(steps)
        } {
            card.addChild((tree Rt (MoveWhere "Mitattu sarja — luvut ovat jo tapahtuneet")))
        }

        def restRow (tree Rt (RestRow))
        restRow.addChild((tree Rt (RestCap "Tauko:")))
        restRow.addChild((unwrap rest.rootEl))
        card.addChild(restRow)

        card.addChild((tree Rt
            (Actions
                (Start
                    (StartTx "▷  Aloita sarjat"))
                (DoneBtn
                    (DoneTx "✓  Valmis")))))
        return card
    }

    ; The dial: sixty ticks and a number, stacked in one grid cell. How many
    ; ticks are lit is arithmetic on the time left, done in `writeFrame` — the
    ; tree here says only that there are sixty of them.
    ; THE OTHER WAY TO ARRANGE A RING, and the loader has the first one.
    ;
    ; The loader's twelve blades are turned by the STYLESHEET — twelve classes,
    ; twelve angles, written out. Sixty of those would be sixty rules that say
    ; the same thing with a different number in it, so the dial's angles are
    ; computed here and written inline. Both are the same layout underneath: a
    ; one-cell grid, and a pivot below each tick's own box.
    sfn dial:EVGElement () {
        def dial (tree Rt (Dial))
        def i:int 0
        while (i < 60) {
            def tick (tree Rt (Tick))
            tick.setAttribute("transform" (("rotate(" + (to_string (6 * i))) + "deg)"))
            tick.markInline("transform")
            dial.addChild(tick)
            i = (i + 1)
        }
        dial.addChild((tree Rt
            (DialMid
                (DialNum "60")
                (DialCap "Sarja 1 / 3"))))
        return dial
    }

    fn timerPanel:EVGElement () {
        def col (tree Rt (Col (props (className "rt-timer"))))
        col.addChild((tree Rt (WorkName (CompactStatBuilder.label((at rows moveIndex))))))
        col.addChild((RealTrainerDemo.dial()))
        col.addChild((tree Rt
            (Actions (props (className "rt-actions rt-timer-actions"))
                (Round (props (id "rt-pause") (a11yLabel "Pysäytä ajastin"))
                    (RoundTx "⏸"))
                (Round (props (id "rt-reset") (a11yLabel "Nollaa ajastin"))
                    (RoundTx "↺"))
                (DoneBtn (props (id "rt-timer-done") (className "rt-done rt-done-narrow")
                                (a11yLabel "Sarja tehty"))
                    (DoneTx "✓  Valmis")))))
        return col
    }

    fn workout:EVGElement () {
        session.value = (int2double doneMoves)
        this.dress(session)
        def main (tree Rt (Main (props (className "rt-main rt-main-work"))))
        def top (tree Rt
            (WorkTop
                (WorkName workTitle)
                (Spacer)
                (Quit
                    (QuitTx "✕  Keskeytä harjoitus"))))
        main.addChild(top)
        def sub (tree Rt
            (Row (props (className "rt-work-line"))
                (WorkSub ((((to_string doneMoves) + " / ") + (to_string moveCount)) + " liikettä tehty"))))
        sub.addChild((unwrap session.rootEl))
        main.addChild(sub)
        ; The save's own line. A screen with no waiting and no failure in it is
        ; a screen whose waiting and failure states were never drawn, so both
        ; are here and both are reachable — `rt-fail` arms the next failure.
        def status (tree Rt
            (Row (props (className "rt-save-row"))
                (SaveState (props (id "rt-save-state")
                                  (className ("rt-save-state rt-save-" + backend.state)))
                           backend.message)
                (Spacer)
                (FailBtn (props (id "rt-fail")
                                (a11yLabel "Kaada seuraava tallennus"))
                         (FailTx (this.failLabel())))
                (SaveBtn
                    (SaveTx "Tallenna"))))
        main.addChild(status)
        if timerOn {
            main.addChild((this.timerPanel()))
        } {
            main.addChild((this.moveCard()))
        }
        return (tree Rt
            (Page (props (id "rt-page") (className "rt-page rt-page-dash"))
                (App
                    (child (this.rail()))
                    (child main))))
    }

    ; --- scene five: the whole document ---------------------------------------
    ;
    ; The session screen shows ONE move at a time, which is what a person
    ; training wants and what hides the rest of the parser's work. This screen
    ; is the other half: every row the document has, drawn by its family, with
    ; nothing between it and `CompactStatBuilder`.

    fn documentRow:EVGElement (row:CompactRow index:int) {
        def kind:string (CompactStatBuilder.kind(row))
        def label:string (CompactStatBuilder.label(row))
        def rowId:string ("rt-doc-" + (to_string index))

        ; A section is a heading and not an entry: it names what follows
        ; rather than saying anything of its own.
        if (kind == "section") {
            return (tree Rt
                (DocHead (props (id rowId) (className "rt-doc-head") (a11yLabel label))
                    (DocLabel (props (id (rowId + "-label")) (className "rt-doc-head-label")) label)))
        }

        def el (tree Rt (DocRow (props (id rowId) (className ("rt-doc-row rt-doc-" + kind)))))
        if ((strlen label) > 0) {
            el.addChild((tree Rt (DocLabel (props (id (rowId + "-label"))) label)))
        }
        el.addChild((tree Rt (Spacer)))
        ; Whether the runs touch is a property of the FAMILY, not of the
        ; renderer. `3x5` and `x80kg` are one reading and must not be prised
        ; apart; a phase marker and its name, a duration and its description,
        ; and a split's fields are separate words and the reference spaces
        ; them. So the gap is a class on the container and not a guess.
        def partsClass@(mutable):string "rt-doc-parts"
        if (kind == "phase") {
            partsClass = "rt-doc-parts rt-doc-parts-gap"
        }
        if (kind == "duration") {
            partsClass = "rt-doc-parts rt-doc-parts-gap"
        }
        if (kind == "split") {
            partsClass = "rt-doc-parts rt-doc-parts-gap"
        }
        if (kind == "circuit") {
            partsClass = "rt-doc-parts rt-doc-parts-gap"
        }
        def parts (tree Rt (DocParts (props (id (rowId + "-parts")) (className partsClass))))
        def list:[StatPart] (CompactStatBuilder.parts(row))
        for list p:StatPart i {
            parts.addChild((tree Rt
                (StatTx (props (id ((rowId + "-p") + (to_string i)))
                               (className ("rt-stat rt-stat-" + p.tone))) p.text)))
        }
        el.addChild(parts)
        return el
    }

    ; The dialog, drawn from the machine's state. There is no local flag for
    ; "is it open" and no second copy of the text: `addDialog` holds both, and
    ; this reads them.
    ; "Lisää harjoitus" as the original draws it: a heading, a close button,
    ; "Lisää kuva", the AI input, and a send button that is disabled until
    ; there is something to send. Drawn from the machine's state.
    fn addSheet:EVGElement () {
        def modal (tree Rt (Modal (props (id "rt-sheet"))))
        def head (tree Rt (ModalHead))
        def title (tree Rt (ModalTitle (props (id "rt-sheet-head")) "Lisää harjoitus"))
        title.a11yLevel = 2
        head.addChild(title)
        head.addChild((tree Rt (Spacer)))
        head.addChild((this.iconBtn("rt-sheet-cancel" "" (RtIcons.x("#f2f2f2")))))
        modal.addChild(head)
        def body (tree Rt (ModalBody))
        if ((strlen addDialog.error) > 0) {
            body.addChild((tree Rt (SheetErr addDialog.error)))
        }
        if (addDialog.state == "saving") {
            body.addChild((tree Rt (ModalDim (props (id "rt-sheet-state")) "Tallennetaan…")))
        }
        def tools (tree Rt (ModalRow))
        tools.addChild((this.sheetBtn("rt-sheet-image" "Lisää kuva" "Lisää kuva" false)))
        body.addChild(tools)
        def compose (tree Rt (ChatCompose))
        compose.addChild((this.fieldBox(addField)))
        def send (this.iconBtn("rt-sheet-save" "" (RtIcons.chevronRight("#ffffff"))))
        send.className = "rt-icon-btn rt-send-btn"
        if ((strlen addDialog.inputText) == 0) {
            send.a11yDisabled = true
            send.className = "rt-icon-btn rt-send-btn rt-send-off"
        }
        compose.addChild(send)
        body.addChild(compose)
        modal.addChild(body)
        return modal
    }

    fn iconBtn:EVGElement (id:string label:string icon:string) {
        def b (tree Rt (IconBtn))
        b.id = id
        b.a11yLabel = label
        def glyph (tree Rt (PhIcon))
        glyph.svgSource = icon
        b.addChild(glyph)
        return b
    }

    ; --- the plan-week dialog ---------------------------------------------------
    ; Six states, one sheet: what is on it is decided by `plan.state()` and the
    ; context behind it, and a press sends an event and redraws. The dialog
    ; never keeps a value of its own.
    ; The plan dialog as `ExampleWeekPanel` draws it. Week selection: the
    ; week either way, the instructions, what will be created, cancel and
    ; create. Confirmation: what the week holds and whether to go ahead. The
    ; edit sheet is the machine's `editInstructions`, reached from "Muokkaa".
    fn planSheet:EVGElement () {
        def st:string (plan.state())
        def modal (tree Rt (Modal (props (id "rt-plan-sheet"))))
        def head (tree Rt (ModalHead))
        def titleText@(mutable):string "Päivitä suunnitelma"
        if (st == "confirmation") { titleText = "Luo harjoitukset" }
        if (st == "creating") { titleText = "Luo harjoitukset" }
        if (st == "editInstructions") { titleText = "Muokkaa viikkosuunnitelmaa" }
        if (st == "regenerating") { titleText = "Muokkaa viikkosuunnitelmaa" }
        def title (tree Rt (ModalTitle (props (id "rt-plan-head")) titleText))
        title.a11yLevel = 3
        head.addChild(title)
        head.addChild((tree Rt (Spacer)))
        ; The confirmation step has no close cross in the original; the
        ; others do.
        if (st != "confirmation") {
            head.addChild((this.iconBtn("rt-plan-cancel" "" (RtIcons.x("#f2f2f2")))))
        }
        modal.addChild(head)
        def body (tree Rt (ModalBody (props (id "rt-plan-body"))))
        body.setAttribute("overflow" "hidden")
        ; The page's height less the bar, the overlay's padding, the head and the foot:
        ; what is left for the body, which scrolls when the sheet is taller.
        body.setAttribute("max-height" ((to_string (to_int (pageH - 250.0))) + "px"))
        body.scrollTop = modalScroll
        def err:string (plan.text("error"))
        if ((strlen err) > 0) {
            body.addChild((tree Rt (SheetErr (props (id "rt-plan-err")) err)))
        }
        if (st == "weekSelection") {
            this.planWeekRows(body)
        }
        if (st == "confirmation") {
            this.planConfirmRows(body)
        }
        if (st == "editInstructions") {
            this.planEditRows(body)
        }
        if (st == "creating") {
            body.addChild((tree Rt (ModalDim (props (id "rt-plan-state")) "Luodaan harjoituksia…")))
        }
        if (st == "regenerating") {
            body.addChild((tree Rt (ModalDim (props (id "rt-plan-state")) "Generoidaan...")))
        }
        def foot (tree Rt (ModalFoot))
        foot.addChild((this.sheetBtn("rt-plan-close" "Peruuta" "Peruuta" false)))
        if (st == "weekSelection") {
            foot.addChild((this.sheetBtn("rt-plan-confirm" "Luo suunnitelma" "Luo suunnitelma" true)))
        }
        if (st == "confirmation") {
            foot.addChild((this.sheetBtn("rt-plan-go" "Luo" "Luo" true)))
        }
        if (st == "editInstructions") {
            foot.addChild((this.sheetBtn("rt-plan-regen" "Tallenna ohjeet ja generoi" "Tallenna ohjeet ja generoi" true)))
        }
        modal.addChild(body)
        modal.addChild(foot)
        return modal
    }

    fn sheetBtn:EVGElement (id:string label:string text:string primary:boolean) {
        def b (tree Rt (SheetBtn (SheetBtnTx text)))
        b.id = id
        b.a11yLabel = label
        if primary {
            b.className = "rt-sheet-btn rt-sheet-primary"
        }
        return b
    }

    fn planWeekRows:void (body:EVGElement) {
        def week (tree Rt (ModalRow))
        week.addChild((this.iconBtn("rt-plan-prev" "" (RtIcons.chevronLeft("#f2f2f2")))))
        def start:string (plan.text("targetWeekStart"))
        def range:string ((((start + " – ") + (RtWeek.shifted(start 6))) + " Viikko ") + (to_string (RtWeek.isoWeekNumber(start))))
        week.addChild((tree Rt (ModalTx (props (id "rt-plan-week")) range)))
        week.addChild((this.iconBtn("rt-plan-next" "" (RtIcons.chevronRight("#f2f2f2")))))
        body.addChild(week)
        if (plan.flag("showInstructionsField")) {
            body.addChild((tree Rt (ModalTx "Anna ohjeita suunnitelman luomiseen")))
            body.addChild((this.fieldBox(planField)))
        }
        def info@(mutable):string "Luodaan tavoiteviikon harjoitukset valitulle viikolle"
        if ((plan.text("weekType")) == "light") {
            info = "Luodaan kevyen viikon harjoitukset valitulle viikolle"
        }
        body.addChild((tree Rt (ModalPara info)))
    }

    ; The week to be written over: empty, and it says so; or the days it has,
    ; a checkbox each, selected by the machine's named action.
    fn planConfirmRows:void (body:EVGElement) {
        def start:string (plan.text("targetWeekStart"))
        if ((plan.fetchedCount()) == 0) {
            body.addChild((tree Rt (ModalPara "Viikko on tyhjä")))
        } {
            def days (tree Rt (PlanDays))
            def i@(mutable):int 0
            while (i < 7) {
                def wd:int ((i + 1) % 7)
                def ctl:CheckboxCtl (itemAt replaceDay wd)
                ctl.checkState = 0
                if (plan.flagIn("replaceSelectedByDay" wd)) {
                    ctl.checkState = 1
                }
                this.dress(ctl)
                def box:EVGElement (unwrap ctl.rootEl)
                box.setAttribute("width" "220px")
                def row (tree Rt (PlanDay))
                row.addChild(box)
                days.addChild(row)
                i = (i + 1)
            }
            body.addChild(days)
        }
        def range:string ((((start + " – ") + (RtWeek.shifted(start 6))) + " Viikko ") + (to_string (RtWeek.isoWeekNumber(start))))
        body.addChild((tree Rt (ModalTx (props (id "rt-plan-week")) range)))
        body.addChild((tree Rt (ModalPara "Luodaanko malliviikon harjoitukset tälle viikolle?")))
    }

    ; The edit sheet as `EditInstructionsDialog` lays it out: the general
    ; feedback, then the days in the machine's order — a drag handle, the
    ; day's current text, "the current one is fine", three buttons and the
    ; day's own instruction field. There is no drag here; the handle is
    ; drawn because the original's is, and answers nothing.
    fn planEditRows:void (body:EVGElement) {
        body.addChild((tree Rt (ModalTx "Yleiset ohjeet regenerointiin")))
        body.addChild((this.fieldBox(editField)))
        body.addChild((tree Rt (ModalTx "Päiväjärjestys ja päiväkohtaiset ohjeet (raahaa vasemman kahvan avulla)")))
        def period:RtPeriod (seed.firstPeriod())
        def week:RtExampleWeek (period.weekOf(exWeekType))
        def order:[int] (plan.dayOrder())
        for order d:int i {
            def line (tree Rt (EditDay))
            def top (tree Rt (ModalRow))
            top.addChild((this.iconBtn(("rt-plan-drag-" + (to_string d)) "Raahaa päivän paikkaa" (RtIcons.ellipsis("#999999")))))
            ; `d` is Monday-based, as the seed's `dayOfWeek` is.
            def compact:string (week.dayAt(d))
            def entry:RtEntry (RtEntry.of(compact))
            def preview@(mutable):string ((RtWeek.dayShort(d)) + " ")
            if ((strlen entry.title) > 0) {
                preview = (preview + ("## " + entry.title))
                if ((array_length entry.tags) > 0) {
                    preview = (preview + (" · Tags " + (entry.tagText())))
                }
            } {
                preview = (preview + "—")
            }
            top.addChild((tree Rt (EditDayTx preview)))
            line.addChild(top)
            def kc:CheckboxCtl (itemAt keepDay d)
            kc.checkState = 0
            if (plan.flagIn("keepSameByDay" d)) {
                kc.checkState = 1
            }
            this.dress(kc)
            def keepBox:EVGElement (unwrap kc.rootEl)
            keepBox.setAttribute("width" "300px")
            line.addChild(keepBox)
            def btns (tree Rt (ModalRow))
            btns.addChild((this.sheetBtn(("rt-plan-accept-" + (to_string d)) "Hyväksy tämä" "Hyväksy tämä" false)))
            btns.addChild((this.sheetBtn(("rt-plan-show-" + (to_string d)) "Näytä nykyinen" "Näytä nykyinen" false)))
            btns.addChild((this.sheetBtn(("rt-plan-copy-" + (to_string d)) "Kopioi nykyinen" "Kopioi nykyinen" false)))
            line.addChild(btns)
            if (plan.flagIn("showPreviousByDay" d)) {
                line.addChild((tree Rt (ModalPara compact)))
            }
            line.addChild((this.fieldBox((itemAt dayFields d))))
            body.addChild(line)
        }
    }

    ; The plan dialog's presses. It is modal in the same sense the add sheet
    ; is: answered before the screen under it.
    fn pressPlan:boolean (id:string) {
        if (id == "rt-plan") {
            if (scene != "dashboard") {
                return false
            }
            return (plan.open(true "cal-1"))
        }

        if ((plan.isOpen()) == false) {
            return false
        }
        if ((id == "rt-plan-cancel") || (id == "rt-plan-close")) {
            modalScroll = 0.0
            return (plan.close())
        }
        if (id == "rt-plan-prev") { return (plan.shiftWeek(-1)) }
        if (id == "rt-plan-next") { return (plan.shiftWeek(1)) }
        if (RealTrainerDemo.owns((weekType.tids()) id)) {
            weekType.activate(id)
            return (plan.setWeekType(weekType.value))
        }
        if (id == "rt-plan-instr") { return (plan.setInstructions("Kevyt viikko, painotus tekniikkaan")) }
        if (id == "rt-plan-edit") { return (plan.openEdit()) }
        if (id == "rt-plan-confirm") {
            ; The week's entries, from the seed the reference was given too.
            def week:[RtSeedEntry] (seed.entriesInWeek((plan.text("targetWeekStart"))))
            def ids:[string]
            def dates:[string]
            for week e:RtSeedEntry i {
                push ids e.id
                push dates e.date
            }
            return (plan.confirmWeekWith(ids dates))
        }
        if (id == "rt-plan-go") {
            def started:boolean (plan.confirmReplacement())
            if started {
                planJob.failNext = backend.failNext
                planJob.begin("plan")
            }
            return started
        }
        if (id == "rt-plan-feedback") { return (plan.setFeedback("Enemmän vetoja, vähemmän juoksua")) }
        if (id == "rt-plan-reverse") { return (plan.reverseDays()) }
        if (id == "rt-plan-regen") {
            def regen:boolean (plan.startRegenerating())
            if regen {
                planJob.failNext = backend.failNext
                planJob.begin("regenerate")
            }
            return regen
        }
        def day:int (RealTrainerDemo.dayOf(id "rt-plan-day-"))
        if (day >= 0) {
            return (plan.setReplace(day ((plan.flagIn("replaceSelectedByDay" day)) == false)))
        }
        def keep:int (RealTrainerDemo.dayOf(id "rt-plan-keep-"))
        if (keep >= 0) {
            return (plan.setKeep(keep ((plan.flagIn("keepSameByDay" keep)) == false)))
        }
        def show:int (RealTrainerDemo.dayOf(id "rt-plan-show-"))
        if (show >= 0) {
            return (plan.setShowPrevious(show ((plan.flagIn("showPreviousByDay" show)) == false)))
        }
        ; "Hyväksy tämä" keeps the day as it is; "Kopioi nykyinen" puts the
        ; day's current text into its instruction field to edit from.
        def accept:int (RealTrainerDemo.dayOf(id "rt-plan-accept-"))
        if (accept >= 0) {
            return (plan.setKeep(accept true))
        }
        def copy:int (RealTrainerDemo.dayOf(id "rt-plan-copy-"))
        if (copy >= 0) {
            def period:RtPeriod (seed.firstPeriod())
            def week:RtExampleWeek (period.weekOf(exWeekType))
            return (plan.setDayInstructions(copy (week.dayAt(copy))))
        }
        def instr:int (RealTrainerDemo.dayOf(id "rt-plan-instr-"))
        if (instr >= 0) {
            return (plan.setDayInstructions(instr "Pitkä juoksu, rauhallinen"))
        }
        return false
    }

    ; "rt-plan-day-3" → 3, or -1 when the id is not one of that family.
    sfn dayOf:int (id:string prefix:string) {
        def plen:int (strlen prefix)
        if ((strlen id) != (plen + 1)) {
            return -1
        }
        if ((substring id 0 plen) != prefix) {
            return -1
        }
        def ch:int (charAt id plen)
        if (ch < 48) { return -1 }
        if (ch > 54) { return -1 }
        return (ch - 48)
    }

    ; --- scene six: the conversation -------------------------------------------
    ; The machine's state decides what is on the screen: a composer in idle,
    ; the reply streaming in, the actions it proposed with a verdict each, a
    ; status while they are saved, the error and its two ways out.
    fn chatScreen:EVGElement () {
        def st:string (chat.state())
        def main (tree Rt (Main (props (className "rt-main rt-main-chat"))))
        main.addChild((tree Rt
            (Top
                (Title "Valmentaja")
                (Spacer)
                (Note (("tila: " + st))))))

        def log (tree Rt (ChatLog))
        for chat.sentTexts sent:string i {
            log.addChild((tree Rt (ChatUser (ChatTx sent))))
            if (i < (array_length chat.replies)) {
                def reply:string (itemAt chat.replies i)
                log.addChild((tree Rt (ChatBot (ChatTx reply))))
            }
        }
        if (chat.inside("sending")) {
            def streaming@(mutable):string (chat.text("streamingContent"))
            if ((strlen streaming) == 0) {
                streaming = "…"
            }
            log.addChild((tree Rt (ChatStream (ChatTx streaming))))
        }
        main.addChild(log)

        def box (tree Rt (ChatBox))
        if (st == "idle") {
            def val@(mutable):string (chat.text("inputText"))
            if ((strlen val) == 0) {
                val = "—"
            }
            def row (tree Rt (SheetRow (SheetCap "Viesti")))
            row.addChild((tree Rt (SheetVal (props (id "rt-chat-input")) val)))
            if (chat.hasImage()) {
                row.addChild((tree Rt (SheetVal (props (id "rt-chat-image")) ("📷 " + (chat.text("image"))))))
            }
            box.addChild(row)
            def actions (tree Rt (SheetRow (props (className "rt-sheet-row rt-sheet-actions"))))
            actions.addChild((this.sheetBtn("rt-chat-type" "Kirjoita liike" "Kirjoita liike" false)))
            actions.addChild((this.sheetBtn("rt-chat-type2" "Kirjoita kaksi liikettä" "Kaksi liikettä" false)))
            actions.addChild((this.sheetBtn("rt-chat-ask" "Kirjoita kysymys" "Kysy" false)))
            if (chat.hasImage()) {
                actions.addChild((this.sheetBtn("rt-chat-clear-image" "Poista kuva" "Poista kuva" false)))
            } {
                actions.addChild((this.sheetBtn("rt-chat-image" "Lisää kuva" "Lisää kuva" false)))
            }
            actions.addChild((tree Rt (Spacer)))
            actions.addChild((this.sheetBtn("rt-chat-send" "Lähetä" "Lähetä" true)))
            box.addChild(actions)
        }
        if (chat.inside("sending")) {
            def actions2 (tree Rt (SheetRow (props (className "rt-sheet-row rt-sheet-actions"))))
            actions2.addChild((tree Rt (SheetVal (props (id "rt-chat-state")) "Valmentaja vastaa…")))
            actions2.addChild((tree Rt (Spacer)))
            actions2.addChild((this.sheetBtn("rt-chat-cancel" "Peruuta" "Peruuta" false)))
            box.addChild(actions2)
        }
        if (chat.inside("reviewing")) {
            this.chatReviewRows(box (st == "reviewing.multiAction"))
        }
        if (chat.inside("processing")) {
            box.addChild((tree Rt (SheetRow (SheetVal (props (id "rt-chat-state")) "Tallennetaan päiväkirjaan…"))))
        }
        if (st == "error") {
            box.addChild((tree Rt (SheetErr (props (id "rt-chat-err")) (chat.text("error")))))
            def actions3 (tree Rt (SheetRow (props (className "rt-sheet-row rt-sheet-actions"))))
            actions3.addChild((this.sheetBtn("rt-chat-cancel" "Peruuta" "Peruuta" false)))
            actions3.addChild((tree Rt (Spacer)))
            actions3.addChild((this.sheetBtn("rt-chat-retry" "Yritä uudelleen" "Yritä uudelleen" true)))
            box.addChild(actions3)
        }
        def foot (tree Rt (SheetRow (props (className "rt-sheet-row rt-sheet-actions"))))
        foot.addChild((tree Rt (Spacer)))
        foot.addChild((this.sheetBtn("rt-chat-reset" "Aloita alusta" "Aloita alusta" false)))
        box.addChild(foot)
        main.addChild(box)

        return (tree Rt
            (Page (props (id "rt-page") (className "rt-page rt-page-dash"))
                (App
                    (child (this.rail()))
                    (child main))))
    }

    ; The proposed actions. One proposes a verdict on the whole; several take
    ; a verdict each, and closing the review saves whatever was accepted.
    fn chatReviewRows:void (box:EVGElement multi:boolean) {
        def acts (tree Rt (ChatActs))
        def n:int (chat.actionCount())
        def i@(mutable):int 0
        while (i < n) {
            def row (tree Rt (ChatAct))
            row.addChild((tree Rt (ChatActTx (((chat.actionField(i "kind")) + " · ") + (chat.actionField(i "id"))))))
            def status:string (chat.actionStatus(i))
            def word@(mutable):string "odottaa"
            if (status == "accepted") { word = "hyväksytty" }
            if (status == "rejected") { word = "hylätty" }
            row.addChild((tree Rt (ChatActSt word)))
            row.addChild((tree Rt (Spacer)))
            if ((strlen status) == 0) {
                row.addChild((this.sheetBtn(("rt-chat-accept-" + (to_string i)) ("Hyväksy " + (to_string (i + 1))) "Hyväksy" true)))
                row.addChild((this.sheetBtn(("rt-chat-reject-" + (to_string i)) ("Hylkää " + (to_string (i + 1))) "Hylkää" false)))
            }
            acts.addChild(row)
            i = (i + 1)
        }
        box.addChild(acts)
        def actions (tree Rt (SheetRow (props (className "rt-sheet-row rt-sheet-actions"))))
        actions.addChild((this.sheetBtn("rt-chat-close" "Sulje tarkistus" "Sulje" false)))
        if multi {
            actions.addChild((this.sheetBtn("rt-chat-reject-all" "Hylkää kaikki" "Hylkää kaikki" false)))
            actions.addChild((tree Rt (Spacer)))
            actions.addChild((this.sheetBtn("rt-chat-accept-all" "Hyväksy kaikki" "Hyväksy kaikki" true)))
        }
        box.addChild(actions)
    }

    fn pressChat:boolean (id:string) {
        if (id == "rt-chat-type") { return (chat.setInput("Maastaveto 3x5@100kg")) }
        if (id == "rt-chat-type2") { return (chat.setInput("Maastaveto 3x5@100kg ja kyykky 5x5@80kg")) }
        if (id == "rt-chat-ask") { return (chat.setInput("Montako harjoitusta viime viikolla?")) }
        if (id == "rt-chat-image") { return (chat.setImage("lautanen.jpg")) }
        if (id == "rt-chat-clear-image") { return (chat.clearImage()) }
        if (id == "rt-chat-send") {
            def prompt:string (chat.text("inputText"))
            def sent:boolean (chat.sendMessage())
            if sent {
                chat.clearInput()
                ; The switch says the NEXT thing fails, and this is it: the
                ; request fails at once, as the original's does with no
                ; backend behind it.
                if backend.failNext {
                    backend.failNext = false
                    this.chatFailed()
                } {
                    chatSim.begin(prompt)
                }
            }
            return sent
        }
        if (id == "rt-chat-cancel") {
            def ok:boolean (chat.cancel())
            if ok {
                chatSim.stop()
            }
            return ok
        }
        if (id == "rt-chat-retry") {
            def again:boolean (chat.retry())
            if again {
                if backend.failNext {
                    backend.failNext = false
                    this.chatFailed()
                } {
                    def last@(mutable):string ""
                    if ((array_length chat.sentTexts) > 0) {
                        last = (itemAt chat.sentTexts ((array_length chat.sentTexts) - 1))
                    }
                    chatSim.begin(last)
                }
            }
            return again
        }
        if (id == "rt-chat-accept-all") { return (this.chatThenSave((chat.acceptAll()))) }
        if (id == "rt-chat-reject-all") { return (chat.rejectAll()) }
        if (id == "rt-chat-close") { return (this.chatThenSave((chat.closeReview()))) }
        if (id == "rt-chat-reset") {
            chatSim.stop()
            return (chat.reset())
        }
        def acc:int (RealTrainerDemo.dayOf(id "rt-chat-accept-"))
        if (acc >= 0) { return (this.chatThenSave((chat.acceptAction(acc)))) }
        def rej:int (RealTrainerDemo.dayOf(id "rt-chat-reject-"))
        if (rej >= 0) { return (chat.rejectAction(rej)) }
        return false
    }

    ; The request failed. The machine goes through `error`, and the screen
    ; answers it the way `AIDiaryChat` does: the failure becomes the
    ; assistant's message in the log and the composer is free again — which
    ; is CANCEL, from `error` back to `idle`.
    fn chatFailed:void () {
        chatSim.stop()
        chat.streamError("Valitettavasti tapahtui virhe. Yritä uudelleen.")
        push chat.replies "Valitettavasti tapahtui virhe. Yritä uudelleen."
        chat.cancel()
    }

    ; The trace's `fail` step: the next request fails.
    fn armFailure:void () {
        backend.failNext = true
    }

    ; An accept may have moved the machine into `processing`; if it did, the
    ; save it is waiting for is started.
    fn chatThenSave:boolean (moved:boolean) {
        if moved {
            if (chat.inside("processing")) {
                chatJob.begin("chat")
            }
        }
        return moved
    }

    ; --- the shell ----------------------------------------------------------------
    ; Portrait: header, section, bottom bar. Landscape: the icon rail, then a
    ; column of header and section. Same sections either way.
    ; ONE tree at every width. The rail and the bottom bar are both in it,
    ; and the stylesheet's `@media` blocks fold one of them away — `display:
    ; none` below 768px for the rail, above it for the bar — the way the
    ; original's `md:hidden` does. Nothing here asks how wide the page is;
    ; the sheet was told the viewport and answers.
    fn appScreen:EVGElement () {
        def page (tree Rt (Phone))
        page.addChild((this.iconRail()))
        def side (tree Rt (PhSide))
        side.addChild((this.phoneHeader()))
        side.addChild((this.phoneMain()))
        this.overlays(side)
        side.addChild((this.bottomNav()))
        this.addOverlay(side)
        page.addChild(side)
        page.addChild((this.toasts()))
        return page
    }

    ; A dialog is drawn over everything. Where it comes in the tree is where
    ; the original has it: the plan dialog and the More sheet BEFORE the
    ; bar, the add sheet after it — the reference's tree reads them so.
    fn overlays:void (page:EVGElement) {
        if (plan.isOpen()) {
            def over2 (tree Rt (Overlay))
            over2.addChild((this.planSheet()))
            page.addChild(over2)
        }
        if moreOpen {
            def over3 (tree Rt (Overlay (props (className "rt-overlay rt-overlay-bottom"))))
            over3.addChild((this.moreSheet()))
            page.addChild(over3)
        }
    }

    fn addOverlay:void (page:EVGElement) {
        if (addDialog.isOpen()) {
            def over (tree Rt (Overlay))
            over.addChild((this.addSheet()))
            page.addChild(over)
        }
    }

    ; The bar's "Lisää": a sheet from the bottom with the rest of the app in
    ; it, in the order `MoreSheet` lists them.
    fn moreSheet:EVGElement () {
        def sheet (tree Rt (MoreSheet))
        def head (tree Rt (ModalHead))
        head.addChild((tree Rt (ModalTx "Lisää")))
        head.addChild((tree Rt (Spacer)))
        head.addChild((this.iconBtn("rt-more-close" "" (RtIcons.x("#f2f2f2")))))
        sheet.addChild(head)
        def body (tree Rt (ModalBody))
        body.addChild((this.moreItem("rt-more-yearsheet" "Vuosilakana" (RtIcons.calendarDays("#f2f2f2")))))
        body.addChild((this.moreItem("rt-more-venues" "Harjoituspaikat" (RtIcons.building("#f2f2f2")))))
        body.addChild((this.moreItem("rt-more-knowledge" "Tietopankki" (RtIcons.bookOpen("#f2f2f2")))))
        body.addChild((this.moreItem("rt-more-shared" "Jaetut kalenterit" (RtIcons.users("#f2f2f2")))))
        body.addChild((this.moreItem("rt-more-settings" "Asetukset" (RtIcons.settings("#f2f2f2")))))
        body.addChild((this.moreItem("rt-more-export" "Vie tietokanta" (RtIcons.database("#f2f2f2")))))
        def theme (tree Rt (ModalRow))
        theme.addChild((tree Rt (ModalTx "Teema")))
        theme.addChild((tree Rt (Spacer)))
        theme.addChild((this.iconBtn("rt-more-theme" "Toggle theme" (RtIcons.settings("#f2f2f2")))))
        body.addChild(theme)
        body.addChild((this.moreItem("rt-more-logout" "Kirjaudu ulos" (RtIcons.logOut("#f2f2f2")))))
        sheet.addChild(body)
        return sheet
    }

    fn moreItem:EVGElement (id:string label:string icon:string) {
        def b (tree Rt (MoreItem))
        b.id = id
        b.a11yLabel = label
        def ic (tree Rt (PhIcon))
        ic.svgSource = icon
        b.addChild(ic)
        b.addChild((tree Rt (MoreItemTx label)))
        return b
    }

    ; The dropdown: the selected calendar first, then the rest, then "Luo
    ; uusi kalenteri" — each a button named by its emoji and its name.
    fn calMenu:EVGElement () {
        def menu (tree Rt (PhCalMenu))
        ; Above the page, as the app's dropdown floats: drawn after the rest,
        ; out of the header's box, however many calendars it lists.
        menu.isOverlay = true
        menu.setAttribute("width" ((to_string (to_int (pageW - 32.0))) + "px"))
        ; Every calendar, in the store's order — the selected one marked,
        ; not moved: the selector above the menu already names it.
        def listed:[RtSeedCalendar] (seed.storeOrder())
        for listed c:RtSeedCalendar i {
            menu.addChild((this.calItem(c (c.id == seed.calendarId))))
        }
        def make (tree Rt (PhCalItem (props (id "rt-cal-new"))))
        make.a11yLabel = "Luo uusi kalenteri"
        def plus (tree Rt (PhIcon (props (className "rt-ph-icon rt-ph-icon-sm"))))
        plus.svgSource = (RtIcons.plus("#f97316"))
        make.addChild(plus)
        make.addChild((tree Rt (PhCalItemTx (props (className "rt-ph-calitem-text rt-ph-calitem-new")) "Luo uusi kalenteri")))
        menu.addChild(make)
        return menu
    }

    fn calItem:EVGElement (c:RtSeedCalendar on:boolean) {
        def item (tree Rt (PhCalItem))
        item.id = ("rt-cal-" + c.id)
        def emoji:string (RealTrainerDemo.calendarEmoji(c.kind))
        item.a11yLabel = ((emoji + " ") + c.name)
        if on {
            item.className = "rt-ph-calitem rt-ph-calitem-on"
        }
        item.addChild((tree Rt (PhCalEmoji emoji)))
        item.addChild((tree Rt (PhCalItemTx c.name)))
        return item
    }

    ; `CALENDAR_EMOJIS` — the calendar's type, as the selector shows it.
    sfn calendarEmoji:string (kind:string) {
        if (kind == "training") { return "💪" }
        if (kind == "plan") { return "📋" }
        if (kind == "nutrition") { return "🍎" }
        if (kind == "sleep") { return "😴" }
        if (kind == "competition") { return "🏆" }
        if (kind == "camp") { return "⛺" }
        if (kind == "group-training") { return "👥" }
        if (kind == "expenses") { return "💰" }
        return "📝"
    }

    fn phoneHeader:EVGElement () {
        def head (tree Rt (PhHead))
        def credits (tree Rt (PhCredits))
        def gauge (tree Rt (PhIcon))
        gauge.svgSource = (RtIcons.battery("#22c55e"))
        credits.addChild(gauge)
        credits.addChild((tree Rt (PhCreditsTx "100k credits")))
        head.addChild(credits)
        def sel (tree Rt (PhCalSel))
        def emoji:string (RealTrainerDemo.calendarEmoji(seed.calendarType))
        sel.a11yLabel = ((emoji + " ") + seed.calendarName)
        sel.addChild((tree Rt (PhCalEmoji emoji)))
        sel.addChild((tree Rt (PhCalTx seed.calendarName)))
        def down (tree Rt (PhIcon (props (className "rt-ph-icon rt-ph-icon-sm"))))
        down.svgSource = (RtIcons.chevronDown("#999999"))
        sel.addChild(down)
        head.addChild(sel)
        if calMenuOpen {
            head.addChild((this.calMenu()))
        }
        ; Folded away below 768px by the sheet.
        head.addChild((tree Rt (PhPct "50%")))
        head.addChild((tree Rt (PhAvatar (PhAvatarTx "T"))))
        return head
    }

    fn phoneMain:EVGElement () {
        def main (tree Rt (PhMain))
        main.setAttribute("overflow" "hidden")
        main.scrollTop = docScroll
        def body (tree Rt (PhBody))
        if (section == "calendar") {
            this.calendarSection(body)
        }
        if (section == "chat") {
            body.addChild((this.chatBody()))
        }
        if (section == "dashboard") {
            this.phoneDashboard(body)
        }
        if (section == "home") {
            this.homeSection(body)
        }
        main.addChild(body)
        return main
    }

    ; Home, as `HomeView` has it: the two actions, the quick entry with its
    ; image and send buttons, and the coming events — none, and the past ones
    ; behind a button that counts them.
    fn homeSection:void (body:EVGElement) {
        def actions (tree Rt (CalActions))
        actions.addChild((this.calButton("rt-add" "Lisää harjoitus" (RtIcons.penLine("#ffffff")))))
        if ((array_length seed.periods) > 0) {
            actions.addChild((this.calButton("rt-plan-update" "Päivitä suunnitelma" (RtIcons.refreshCw("#ffffff")))))
        }
        body.addChild(actions)
        def home (tree Rt (Col (props (className "rt-home"))))
        def entry (tree Rt (ModalRow))
        entry.addChild((this.iconBtn("rt-home-image" "Lisää kuva" (RtIcons.penLine("#999999")))))
        def box (tree Rt (HomeBox))
        def ghost@(mutable):string "Kirjoita merkintä... esim. \"maanantai: juoksu 45min\""
        if (seed.calendarType != "plan") {
            ghost = "Kirjoita merkintä... esim. \"treeni 60min\""
        }
        box.addChild((tree Rt (FieldGhost ghost)))
        entry.addChild(box)
        def send (this.iconBtn("rt-home-send" "" (RtIcons.chevronRight("#ffffff"))))
        send.className = "rt-icon-btn rt-send-btn"
        entry.addChild(send)
        home.addChild(entry)
        if (seed.calendarType != "plan") {
            this.diaryFeed(home)
            body.addChild(home)
            return
        }
        def empty (tree Rt (Row (props (className "rt-home-center"))))
        empty.addChild((tree Rt (ChatPara (props (id "rt-home-empty") (className "rt-home-empty")) "Ei tulevia tapahtumia")))
        home.addChild(empty)
        ; The selected calendar's past entries, counted on the button — or,
        ; with none, the hint the original shows a new calendar.
        def mine:[RtSeedEntry] (seed.selectedEntries())
        def past@(mutable):int 0
        for mine e:RtSeedEntry i {
            if ((RtWeek.daysOf(e.date)) < (RtWeek.daysOf(today))) {
                past = (past + 1)
            }
        }
        if (past > 0) {
            def pastRow (tree Rt (Row (props (className "rt-home-center"))))
            def pastBtn (this.exButton("rt-home-past" (("Näytä menneet (" + (to_string past)) + ")") (("Näytä menneet (" + (to_string past)) + ")")))
            pastBtn.className = "rt-ex-btn rt-link-btn"
            RealTrainerDemo.tintText(pastBtn "rt-ex-btn-text rt-link-text")
            pastRow.addChild(pastBtn)
            home.addChild(pastRow)
        } {
            def hint (tree Rt (Row (props (className "rt-home-center"))))
            hint.addChild((tree Rt (ChatPara (props (id "rt-home-hint")) "Kirjoita yllä olevaan kenttään lisätäksesi ensimmäisen merkinnän")))
            home.addChild(hint)
        }
        body.addChild(home)
    }

    ; A training calendar's Home, as `HomeView` has it: the three tabs and,
    ; on Päiväkirja, every workout of the calendar as a card, newest first.
    fn diaryFeed:void (home:EVGElement) {
        def tabs (tree Rt (Row (props (className "rt-ex-btns rt-home-tabs"))))
        tabs.addChild((this.homeTabBtn("rt-home-tab-diary" "Päiväkirja" (homeTab == "diary"))))
        tabs.addChild((this.homeTabBtn("rt-home-tab-drills" "Harjoitteet" (homeTab == "drills"))))
        tabs.addChild((this.homeTabBtn("rt-home-tab-stats" "Tilastot" (homeTab == "stats"))))
        home.addChild(tabs)
        if (homeTab == "drills") {
            this.homeDrills(home)
            return
        }
        if (homeTab == "stats") {
            this.statsPanel(home)
            return
        }
        def feed (tree Rt (Col (props (className "rt-home-feed"))))
        def sorted:[RtSeedEntry] (RealTrainerDemo.sortByDateDesc((seed.selectedEntries())))
        for sorted e:RtSeedEntry i {
            def card:EVGElement (this.cardFor(e i "home"))
            card.className = "rt-entry rt-entry-home"
            feed.addChild(card)
        }
        home.addChild(feed)
    }

    ; --- Home: Harjoitteet ----------------------------------------------------
    ; `ExerciseListPanel`: the diary's exercises, summarised by the app's
    ; own statistics (src/stats), in three categories with a sort.
    fn drillSummaries:[ExerciseSummary] () {
        ; Once per seed: the diary does not change under the tab, and the
        ; parse of every entry is not cheap.
        def key:string ((to_string (array_length seed.entries)) + ("/" + (to_string (array_length seed.calendars))))
        if (key == drillCacheKey) { return drillCache }
        def cals:[ExerciseStatsCalendar]
        for seed.calendars c:RtSeedCalendar i {
            def sc (new ExerciseStatsCalendar())
            sc.id = c.id
            sc.name = c.name
            sc.type = c.kind
            push cals sc
        }
        ; The items come from the parsed rows, as the app's bridge builds
        ; them — an exercise, a pyramid as one exercise with its totals, a
        ; timed block, a move — not from the line walker, which reads more
        ; lines as moves than the parser does.
        ; Calendar by calendar, each one's entries newest first — the order
        ; the app's store hands them over in, which is the order ties keep.
        def batches:[ExerciseStatsParsedItem]
        def inOrder:[RtSeedCalendar] (seed.storeOrder())
        for inOrder c:RtSeedCalendar ci {
            def own:[RtSeedEntry]
            for seed.entries e:RtSeedEntry j {
                if (e.calendarId == c.id) { push own e }
            }
            def ordered:[RtSeedEntry] (RealTrainerDemo.sortByDateDesc(own))
            for ordered e:RtSeedEntry j {
                if ((strlen e.compact) == 0) { continue }
                def doc:CompactDocument (CompactRowMapper.parseDocument(e.compact))
                for doc.rows row:CompactRow ri {
                    def items:[CompactWalkItem] (RealTrainerDemo.walkItemsOf(row e.date))
                    for items item:CompactWalkItem k {
                        def batch (new ExerciseStatsParsedItem())
                        batch.calendarId = e.calendarId
                        batch.item = item
                        push batches batch
                    }
                }
            }
        }
        def opts (new CollectExercisesOptions())
        opts.excludePlans = true
        drillCache = (ExerciseStats.collectFromItems(cals batches opts))
        drillCacheKey = key
        return drillCache
    }

    ; `contentToWalkItems`, over the port's rows.
    sfn walkItemsOf:[CompactWalkItem] (row:CompactRow date:string) {
        def out:[CompactWalkItem]
        match row {
            Exercise ex {
                def e:ExerciseSpec (unwrap ex.spec)
                def item (new CompactWalkItem())
                item.kind = "exercise"
                item.name = e.name
                item.date = date
                item.sets = 1
                if e.hasSets { item.sets = e.sets }
                if e.hasReps { item.reps = e.reps }
                item.weight = -1.0
                if (e.hasWeight && (e.weightKg > 0)) { item.weight = (int2double e.weightKg) }
                item.unit = e.unit
                if ((e.unit == "min") && (item.reps > 0)) { item.durationSeconds = (item.reps * 60) }
                if ((e.unit == "s") && (item.reps > 0)) { item.durationSeconds = item.reps }
                push out item
            }
            Pyramid py {
                def pd:PyramidSpec (unwrap py.spec)
                def item (new CompactWalkItem())
                item.kind = "exercise"
                item.name = pd.name
                item.date = date
                def totalSets@(mutable):int 0
                def maxWeight@(mutable):double -1.0
                def bestRm1@(mutable):double -1.0
                def bestReps@(mutable):int 0
                def tonnage@(mutable):double 0.0
                for pd.sets set:PyramidSet si {
                    totalSets = (totalSets + 1)
                    def w@(mutable):double -1.0
                    if (set.hasWeight && (set.weightKg > 0.0)) { w = set.weightKg }
                    if (w > maxWeight) { maxWeight = w }
                    def wPos@(mutable):double 0.0
                    if (w > 0.0) { wPos = w }
                    def rm1:double (StatsMath.calculateRM1(wPos set.reps))
                    if ((rm1 > 0.0) && (rm1 > bestRm1)) {
                        bestRm1 = rm1
                        bestReps = set.reps
                    }
                    def st:double (StatsMath.calculateTonnage(1 set.reps wPos))
                    if (st > 0.0) { tonnage = (tonnage + st) }
                }
                item.sets = 1
                if (totalSets > 0) { item.sets = totalSets }
                item.reps = bestReps
                item.weight = maxWeight
                if (tonnage > 0.0) { item.tonnage = tonnage }
                push out item
            }
            Duration du {
                def d:DurationSpec (unwrap du.spec)
                def item (new CompactWalkItem())
                item.kind = "duration"
                item.name = d.description
                item.date = date
                item.sets = 1
                if (d.unit == "min") {
                    item.durationSeconds = (to_int ((d.value * 60.0) + 0.5))
                    item.unit = "min"
                } {
                    item.durationSeconds = (to_int (d.value + 0.5))
                    item.unit = "s"
                }
                push out item
            }
            Move mv {
                def m:MoveSpec (unwrap mv.spec)
                def item (new CompactWalkItem())
                item.kind = "move"
                item.name = m.sport
                if ((strlen item.name) == 0) { item.name = m.note }
                item.date = date
                item.sets = 1
                if (m.sets > 0) { item.sets = m.sets }
                if m.hasDuration {
                    if (m.durationUnit == "min") {
                        item.durationSeconds = (to_int ((m.durationValue * 60.0) + 0.5))
                    } {
                        item.durationSeconds = (to_int (m.durationValue + 0.5))
                    }
                }
                if m.hasDistance { item.distanceMeters = m.distanceValue }
                push out item
            }
            Split sp { }
            Section s { }
            Text t { }
            Summary sm { }
            Phase ph { }
            Custom cu { }
            Unknown un { }
            Circuit ci { }
            CircuitItem it { }
        }
        return out
    }

    ; The sort the panel offers, stable as the original's `sort` is.
    sfn sortDrills:[ExerciseSummary] (list:[ExerciseSummary] by:string) {
        def out:[ExerciseSummary]
        for list ex:ExerciseSummary i {
            def placed:[ExerciseSummary]
            def done@(mutable):boolean false
            for out o:ExerciseSummary j {
                if ((done == false) && (RealTrainerDemo.drillBefore(ex o by))) {
                    push placed ex
                    done = true
                }
                push placed o
            }
            if (done == false) { push placed ex }
            out = placed
        }
        return out
    }

    sfn drillBefore:boolean (a:ExerciseSummary b:ExerciseSummary by:string) {
        if (by == "latest") { return (RealTrainerDemo.strAfter(a.lastDate b.lastDate)) }
        if (by == "improving") { return (a.trend > b.trend) }
        if (by == "declining") { return (a.trend < b.trend) }
        return (a.occurrences > b.occurrences)
    }

    ; a after b, as the ISO dates and week keys the sorts compare read —
    ; character by character.
    sfn strAfter:boolean (a:string b:string) {
        def n@(mutable):int (strlen a)
        if ((strlen b) < n) { n = (strlen b) }
        def i@(mutable):int 0
        while (i < n) {
            def ca:int (charAt a i)
            def cb:int (charAt b i)
            if (ca > cb) { return true }
            if (ca < cb) { return false }
            i = (i + 1)
        }
        return ((strlen a) > (strlen b))
    }

    sfn sortLabel:string (by:string) {
        if (by == "latest") { return "Viimeisimmät" }
        if (by == "improving") { return "Kehittyvät ↑" }
        if (by == "declining") { return "Laskevat ↓" }
        return "Eniten"
    }

    ; `(d / 1000).toFixed(1)` + "km".
    sfn kmText:string (meters:double) {
        def tenths:int (to_int ((meters / 100.0) + 0.5))
        def whole:int (to_int ((int2double tenths) / 10.0))
        return ((((to_string whole) + ".") + (to_string (tenths - (whole * 10)))) + "km")
    }

    ; The last ISO week's tonnage, when there are two weeks to draw a line
    ; through — the label the sparkline carries.
    sfn lastWeekTonnage:string (ex:ExerciseSummary) {
        def weeks:[string]
        def sums:[double]
        for ex.tonnageDates d:string i {
            def v:double (itemAt ex.tonnageValues i)
            if (v <= 0.0) { continue }
            def wk:string (DateExtras.isoWeekKey(d))
            if ((strlen wk) == 0) { continue }
            def at@(mutable):int -1
            for weeks w:string k {
                if (w == wk) { at = k }
            }
            if (at < 0) {
                push weeks wk
                push sums v
            } {
                set sums at ((itemAt sums at) + v)
            }
        }
        if ((array_length weeks) < 2) { return "" }
        def best@(mutable):string ""
        def bestV@(mutable):double 0.0
        for weeks w:string k {
            if (RealTrainerDemo.strAfter(w best)) {
                best = w
                bestV = (itemAt sums k)
            }
        }
        return (StatsMath.formatTonnage(bestV))
    }

    fn homeDrills:void (home:EVGElement) {
        def all:[ExerciseSummary] (this.drillSummaries())
        def cats:CategorizedExercises (ExerciseStats.categorizeSummaries(all))
        def total:int (((array_length cats.strength) + (array_length cats.endurance)) + (array_length cats.bodyweight))
        if (total == 0) {
            def none (tree Rt (Row (props (className "rt-home-center"))))
            none.addChild((tree Rt (ChatPara (props (id "rt-drills-none") (className "rt-home-empty")) "Ei harjoitteita")))
            home.addChild(none)
            return
        }
        def panel (tree Rt (Col (props (className "rt-drills"))))
        def tabs (tree Rt (Row (props (className "rt-drill-tabs"))))
        tabs.addChild((this.drillTab("strength" "Voima" (array_length cats.strength) (RtIcons.dumbbell((this.drillTabColor("strength")))))))
        tabs.addChild((this.drillTab("endurance" "Kestävyys" (array_length cats.endurance) (RtIcons.heart((this.drillTabColor("endurance")))))))
        tabs.addChild((this.drillTab("bodyweight" "Muu" (array_length cats.bodyweight) (RtIcons.users((this.drillTabColor("bodyweight")))))))
        panel.addChild(tabs)
        def sortRow (tree Rt (Col (props (className "rt-drill-sort-wrap"))))
        def sortBtn (tree Rt (DrillSortBtn))
        sortBtn.id = "rt-drill-sort"
        sortBtn.a11yLabel = (RealTrainerDemo.sortLabel(drillSort))
        sortBtn.addChild((tree Rt (DrillSortTx (RealTrainerDemo.sortLabel(drillSort)))))
        def chev (tree Rt (PhIcon))
        chev.svgSource = (RtIcons.chevronDown("#999999"))
        chev.className = "rt-ph-icon rt-drill-chev"
        sortBtn.addChild(chev)
        sortRow.addChild(sortBtn)
        if drillSortOpen {
            def menu (tree Rt (Col (props (className "rt-drill-menu"))))
            menu.addChild((this.drillSortItem("frequent")))
            menu.addChild((this.drillSortItem("latest")))
            menu.addChild((this.drillSortItem("improving")))
            menu.addChild((this.drillSortItem("declining")))
            sortRow.addChild(menu)
        }
        panel.addChild(sortRow)
        def list@(mutable):[ExerciseSummary] cats.strength
        if (drillCat == "endurance") { list = cats.endurance }
        if (drillCat == "bodyweight") { list = cats.bodyweight }
        def sorted:[ExerciseSummary] (RealTrainerDemo.sortDrills(list drillSort))
        def rows (tree Rt (Col (props (className "rt-drill-rows"))))
        for sorted ex:ExerciseSummary i {
            rows.addChild((this.drillRow(ex i)))
        }
        panel.addChild(rows)
        home.addChild(panel)
    }

    fn drillTabColor:string (cat:string) {
        if (cat == "strength") { return "#f97316" }
        if (cat == "endurance") { return "#22c55e" }
        return "#60a5fa"
    }

    ; A category tab: the icon, the label from `sm` up, the count always.
    fn drillTab:EVGElement (cat:string label:string count:int icon:string) {
        def b (tree Rt (DrillTab))
        b.id = ("rt-drill-cat-" + cat)
        def wide:boolean (pageW >= 640.0)
        def name@(mutable):string (("(" + (to_string count)) + ")")
        if wide { name = ((label + " ") + name) }
        b.a11yLabel = name
        def active:boolean (cat == drillCat)
        if active { b.className = ("rt-drill-tab rt-drill-tab-on-" + cat) }
        def glyph (tree Rt (PhIcon))
        glyph.svgSource = icon
        if (active == false) { glyph.svgSource = (RtIcons.svgOf((RtIcons.pathOf("M0 0")) "#999999")) }
        glyph.svgSource = icon
        b.addChild(glyph)
        if wide {
            def tx (tree Rt (DrillTabTx label))
            if active { tx.className = ("rt-drill-tab-text rt-drill-text-" + cat) }
            b.addChild(tx)
        }
        def cnt (tree Rt (DrillTabCount (("(" + (to_string count)) + ")")))
        if active { cnt.className = ("rt-drill-tab-count rt-drill-text-" + cat) }
        b.addChild(cnt)
        return b
    }

    fn drillSortItem:EVGElement (by:string) {
        def b (tree Rt (DrillMenuItem))
        b.id = ("rt-drill-sort-" + by)
        b.a11yLabel = (RealTrainerDemo.sortLabel(by))
        if (by == drillSort) { b.className = "rt-drill-menu-item rt-drill-menu-on" }
        b.addChild((tree Rt (DrillMenuTx (RealTrainerDemo.sortLabel(by)))))
        return b
    }

    ; One exercise, as the row reads: the name, the count, and by category
    ; the best weight, the RM1 and the tonnage, the best pace and the
    ; distance, or the longest hold — with last week's tonnage at the end
    ; where the sparkline labels it.
    fn drillRow:EVGElement (ex:ExerciseSummary i:int) {
        def b (tree Rt (DrillBtn))
        b.id = ("rt-drill-" + (to_string i))
        def col (tree Rt (Col (props (className "rt-drill-col"))))
        col.addChild((tree Rt (DrillName ex.displayName)))
        def meta (tree Rt (Row (props (className "rt-drill-meta"))))
        def cal (tree Rt (PhIcon))
        cal.svgSource = (RtIcons.calendarDays("#999999"))
        cal.className = "rt-ph-icon rt-drill-cal"
        meta.addChild(cal)
        def name@(mutable):string ((ex.displayName + " ") + ((to_string ex.occurrences) + "×"))
        meta.addChild((tree Rt (DrillMetaTx ((to_string ex.occurrences) + "×"))))
        if (ex.category == "strength") {
            if (ex.maxWeight > 0.0) {
                def w:string ((to_string ex.maxWeight) + "kg")
                meta.addChild((tree Rt (DrillMetaTx (props (className "rt-drill-meta-text rt-drill-text-strength")) w)))
                name = ((name + " ") + w)
            }
            if (ex.maxRm1 > 0.0) {
                def rm:string ("RM1 " + (to_string ex.maxRm1))
                meta.addChild((tree Rt (DrillMetaTx rm)))
                name = ((name + " ") + rm)
            }
            if (ex.totalTonnage > 0.0) {
                def tn:string ("Σ" + (StatsMath.formatTonnage(ex.totalTonnage)))
                meta.addChild((tree Rt (DrillMetaTx (props (className "rt-drill-meta-text rt-drill-tonnage")) tn)))
                name = ((name + " ") + tn)
            }
        }
        if (ex.category == "endurance") {
            if ex.hasBestPace {
                def pc (new Pace())
                pc.minutes = ex.bestPaceMinutes
                pc.seconds = ex.bestPaceSeconds
                def pt:string (StatsMath.formatPace(pc))
                meta.addChild((tree Rt (DrillMetaTx (props (className "rt-drill-meta-text rt-drill-text-endurance")) pt)))
                name = ((name + " ") + pt)
            }
            if (ex.totalDistance >= 1000.0) {
                def km:string (RealTrainerDemo.kmText(ex.totalDistance))
                meta.addChild((tree Rt (DrillMetaTx km)))
                name = ((name + " ") + km)
            }
        }
        if ((ex.category != "strength") && (ex.category != "endurance")) {
            if (ex.maxDuration > 0) {
                def du:string (StatsMath.formatDuration(ex.maxDuration))
                meta.addChild((tree Rt (DrillMetaTx (props (className "rt-drill-meta-text rt-drill-text-bodyweight")) du)))
                name = ((name + " ") + du)
            }
        }
        col.addChild(meta)
        b.addChild(col)
        b.addChild((tree Rt (Spacer)))
        if (ex.category == "strength") {
            def wk:string (RealTrainerDemo.lastWeekTonnage(ex))
            if ((strlen wk) > 0) {
                b.addChild((tree Rt (DrillWeekTx wk)))
                name = ((name + " ") + wk)
            }
        }
        b.a11yLabel = name
        return b
    }

    ; --- Home: Tilastot -------------------------------------------------------
    ; `TrainingStatsPanel` and `FeatureVectorsPanel`: the last seven dated
    ; days, then a card per series — the daily volume, distance and time,
    ; the custom fields two days share, and the features the diary's Derived
    ; lines give over the last fourteen days. A card is `StatsMiniCard`: the
    ; title and the trend, the latest value, the curve, the date, and the
    ; average, the least and the most. The curve is a Vela chart — an area
    ; under a line, the latest point marked — drawn into the display list at
    ; the card's box once the layout has placed it (`emitCharts`).
    fn statsPanel:void (home:EVGElement) {
        clear charts
        def panel (tree Rt (Col (props (className "rt-stats"))))
        def mine:[RtSeedEntry] (seed.selectedEntries())
        ; The daily totals, by date.
        def days:[string]
        def vol:[double]
        def dist:[double]
        def mins:[double]
        def count:[int]
        def fieldNames:[string]
        def fieldUnits:[string]
        def fieldDays:[string]
        def fieldVals:[double]
        for mine e:RtSeedEntry i {
            def doc:CompactDocument (CompactRowMapper.parseDocument(e.compact))
            def v@(mutable):double 0.0
            def d@(mutable):double 0.0
            def m@(mutable):double 0.0
            for doc.rows row:CompactRow ri {
                match row {
                    Exercise ex {
                        v = (v + (int2double (RealTrainerDemo.tonnageOf(row))))
                    }
                    Move mv {
                        def ms:MoveSpec (unwrap mv.spec)
                        if ms.hasDistance {
                            if (ms.distanceUnit == "km") { d = (d + ms.distanceValue) }
                            if (ms.distanceUnit == "m") { d = (d + (ms.distanceValue / 1000.0)) }
                        }
                        if ms.hasDuration {
                            if (ms.durationUnit == "min") { m = (m + (ms.durationValue * (int2double ms.sets))) }
                        }
                    }
                    Custom cu {
                        ; `customFields`: a numeric value with a unit, summed
                        ; per day under its lower-cased name.
                        def cs:CustomSpec (unwrap cu.spec)
                        def cv (str2double cs.value)
                        if ((!null? cv) && ((strlen cs.unit) > 0)) {
                            def fname:string (RealTrainerDemo.lower(cs.name))
                            def fat@(mutable):int -1
                            for fieldNames fn:string fi {
                                if ((fn == fname) && ((itemAt fieldDays fi) == e.date)) { fat = fi }
                            }
                            if (fat < 0) {
                                push fieldNames fname
                                push fieldUnits cs.unit
                                push fieldDays e.date
                                push fieldVals (unwrap cv)
                            } {
                                set fieldVals fat ((itemAt fieldVals fat) + (unwrap cv))
                            }
                        }
                    }
                    Pyramid py { }
                    Split sp { }
                    Section s { }
                    Text t { }
                    Summary sm { }
                    Phase ph { }
                    Duration du { }
                    Unknown un { }
                    Circuit ci { }
                    CircuitItem it { }
                }
            }
            def at@(mutable):int -1
            for days dd:string k {
                if (dd == e.date) { at = k }
            }
            if (at < 0) {
                push days e.date
                push vol v
                push dist d
                push mins m
                push count 1
            } {
                set vol at ((itemAt vol at) + v)
                set dist at ((itemAt dist at) + d)
                set mins at ((itemAt mins at) + m)
                set count at ((itemAt count at) + 1)
            }
        }
        ; The dated days in order, and the last twenty-one of them.
        def order:[int]
        for days dd:string k {
            def placed:[int]
            def done@(mutable):boolean false
            for order o:int j {
                if ((done == false) && (RealTrainerDemo.strAfter((itemAt days o) dd))) {
                    push placed k
                    done = true
                }
                push placed o
            }
            if (done == false) { push placed k }
            order = placed
        }
        def n:int (array_length order)
        def from21@(mutable):int (n - 21)
        if (from21 < 0) { from21 = 0 }
        def from7@(mutable):int (n - 7)
        if (from7 < 0) { from7 = 0 }
        def tv@(mutable):double 0.0
        def td@(mutable):double 0.0
        def tm@(mutable):double 0.0
        def tc@(mutable):int 0
        def k@(mutable):int from7
        while (k < n) {
            def idx:int (itemAt order k)
            tv = (tv + (itemAt vol idx))
            td = (td + (itemAt dist idx))
            tm = (tm + (itemAt mins idx))
            tc = (tc + (itemAt count idx))
            k = (k + 1)
        }
        if (tc > 0) {
            def week (tree Rt (Col (props (className "rt-stats-card"))))
            week.addChild((tree Rt (StatsH4 (props (id "rt-stats-week")) (("Viimeiset 7 päivää (" + (to_string tc)) + " treeniä)"))))
            def nums (tree Rt (Row (props (className "rt-stats-nums"))))
            if (tv > 0.0) {
                def tons:int (to_int ((tv / 1000.0) + 0.5))
                nums.addChild((this.statsNum(((to_string tons) + "t") "yht." "rt-stats-purple")))
            }
            if (td > 0.0) {
                nums.addChild((this.statsNum(((RealTrainerDemo.fixed(td 1)) + " km") "yht." "rt-stats-green")))
            }
            if (tm > 0.0) {
                def hrs:int (to_int ((tm / 60.0) + 0.5))
                nums.addChild((this.statsNum(((to_string hrs) + "h") "yht." "rt-stats-blue")))
            }
            week.addChild(nums)
            panel.addChild(week)
        }
        ; The series over the last twenty-one dated days: a day without the
        ; measure is left out, as `volumeData` leaves it.
        def volDates:[string]
        def volVals:[double]
        def distDates:[string]
        def distVals:[double]
        def minDates:[string]
        def minVals:[double]
        def k2@(mutable):int from21
        while (k2 < n) {
            def idx:int (itemAt order k2)
            if ((itemAt vol idx) > 0.0) {
                push volDates (itemAt days idx)
                push volVals ((itemAt vol idx) / 1000.0)
            }
            if ((itemAt dist idx) > 0.0) {
                push distDates (itemAt days idx)
                push distVals (itemAt dist idx)
            }
            if ((itemAt mins idx) > 0.0) {
                push minDates (itemAt days idx)
                push minVals (itemAt mins idx)
            }
            k2 = (k2 + 1)
        }
        def grid (tree Rt (Row (props (className "rt-feat-grid"))))
        grid.addChild((this.statsCard("volume" "Volyymi (kg×toistot)" "t" "#a855f7" (RtIcons.dumbbell("#a855f7")) volDates volVals 1)))
        grid.addChild((this.statsCard("distance" "Matka" "km" "#22c55e" (RtIcons.activity("#22c55e")) distDates distVals 1)))
        grid.addChild((this.statsCard("duration" "Kesto" "min" "#3b82f6" (RtIcons.clock("#3b82f6")) minDates minVals 0)))
        ; The custom fields two days or more share, each as its own card.
        def shown:[string]
        for fieldNames fname:string fi {
            def seen@(mutable):boolean false
            for shown sn:string si { if (sn == fname) { seen = true } }
            if seen { continue }
            def fdates:[string]
            def fvals:[double]
            for fieldNames f2:string fj {
                if (f2 == fname) {
                    push fdates (itemAt fieldDays fj)
                    push fvals (itemAt fieldVals fj)
                }
            }
            if ((array_length fdates) < 2) { continue }
            push shown fname
            def fdOrder:[int]
            for fdates fd:string fk {
                def placed:[int]
                def done@(mutable):boolean false
                for fdOrder o:int j {
                    if ((done == false) && (RealTrainerDemo.strAfter((itemAt fdates o) fd))) {
                        push placed fk
                        done = true
                    }
                    push placed o
                }
                if (done == false) { push placed fk }
                fdOrder = placed
            }
            def sdates:[string]
            def svals:[double]
            def fromF@(mutable):int ((array_length fdOrder) - 21)
            if (fromF < 0) { fromF = 0 }
            def fk2@(mutable):int fromF
            while (fk2 < (array_length fdOrder)) {
                def oi:int (itemAt fdOrder fk2)
                push sdates (itemAt fdates oi)
                push svals (itemAt fvals oi)
                fk2 = (fk2 + 1)
            }
            def fcolor:string (RealTrainerDemo.customFieldColor(fname))
            grid.addChild((this.statsCard(("field-" + fname) (RealTrainerDemo.capitalised(fname)) (itemAt fieldUnits fi) fcolor (RtIcons.activity(fcolor)) sdates svals 0)))
        }
        panel.addChild(grid)
        def head (tree Rt (ModalRow))
        head.addChild((tree Rt (StatsH4 (props (id "rt-stats-recent")) "Viimeisimmät arviot")))
        head.addChild((tree Rt (Spacer)))
        head.addChild((this.iconBtn("rt-stats-calc" "Laske vektorit" (RtIcons.sparkles("#f97316")))))
        panel.addChild(head)
        ; The features: the known ones in their order, then what the diary
        ; names beyond them; the values from every calendar's Derived lines
        ; over the last fourteen days, by date.
        def keys:[string]
        def labels:[string]
        def units:[string]
        def colors:[string]
        RealTrainerDemo.featureRow(keys labels units colors "strength.neural_stress" "Hermostokuorma" "score" "#f97316")
        RealTrainerDemo.featureRow(keys labels units colors "strength.max_strength_emphasis" "Maksimivoima" "score" "#ef4444")
        RealTrainerDemo.featureRow(keys labels units colors "strength.power_emphasis" "Räjähtävyys" "score" "#eab308")
        RealTrainerDemo.featureRow(keys labels units colors "strength.speed_strength_emphasis" "Nopeusvoima" "score" "#a855f7")
        RealTrainerDemo.featureRow(keys labels units colors "strength.strength_endurance_emphasis" "Voimakestävyys" "score" "#ec4899")
        RealTrainerDemo.featureRow(keys labels units colors "endurance.zone1_minutes" "Zone 1" "min" "#94a3b8")
        RealTrainerDemo.featureRow(keys labels units colors "endurance.zone2_minutes" "Zone 2" "min" "#22c55e")
        RealTrainerDemo.featureRow(keys labels units colors "endurance.zone3_minutes" "Zone 3" "min" "#3b82f6")
        RealTrainerDemo.featureRow(keys labels units colors "endurance.zone4_minutes" "Zone 4" "min" "#f97316")
        RealTrainerDemo.featureRow(keys labels units colors "endurance.zone5_minutes" "Zone 5" "min" "#ef4444")
        RealTrainerDemo.featureRow(keys labels units colors "nutrition.fat_good_total" "Hyvät rasvat" "g/day" "#22c55e")
        RealTrainerDemo.featureRow(keys labels units colors "nutrition.fat_bad_total" "Huonot rasvat" "g/day" "#ef4444")
        def since:int ((RtWeek.daysOf(today)) - 14)
        def fKeys:[string]
        def fDates:[string]
        def fVals:[double]
        def fUnitOf:[string]
        for seed.entries e:RtSeedEntry ei {
            if ((RtWeek.daysOf(e.date)) < since) { continue }
            if ((RtWeek.daysOf(e.date)) > (RtWeek.daysOf(today))) { continue }
            if (seed.calendarKindOf(e.calendarId) == "plan") { continue }
            def ds:[RtDerived] (RtDerived.of(e.compact))
            for ds dv:RtDerived di {
                def val (str2double dv.value)
                if (null? val) { continue }
                push fKeys dv.key
                push fDates e.date
                push fVals (unwrap val)
                push fUnitOf dv.unit
                def known@(mutable):boolean false
                for keys kk:string kj { if (kk == dv.key) { known = true } }
                if (known == false) {
                    def dot:int (RtEntry.findIn(dv.key "."))
                    def bare@(mutable):string dv.key
                    if (dot >= 0) { bare = (substring dv.key (dot + 1) (strlen dv.key)) }
                    RealTrainerDemo.featureRow(keys labels units colors dv.key bare dv.unit "#f97316")
                }
            }
        }
        def feats (tree Rt (Row (props (className "rt-feat-grid"))))
        for keys key:string i {
            ; This feature's points, summed per day, by date.
            def pd:[string]
            def pv:[double]
            for fKeys fk:string fi {
                if (fk != key) { continue }
                def at@(mutable):int -1
                for pd d0:string dj { if (d0 == (itemAt fDates fi)) { at = dj } }
                if (at < 0) {
                    push pd (itemAt fDates fi)
                    push pv (itemAt fVals fi)
                } {
                    set pv at ((itemAt pv at) + (itemAt fVals fi))
                }
            }
            def po:[int]
            for pd d1:string dk {
                def placed:[int]
                def done@(mutable):boolean false
                for po o:int j {
                    if ((done == false) && (RealTrainerDemo.strAfter((itemAt pd o) d1))) {
                        push placed dk
                        done = true
                    }
                    push placed o
                }
                if (done == false) { push placed dk }
                po = placed
            }
            def sd:[string]
            def sv:[double]
            for po oi:int oj {
                push sd (itemAt pd oi)
                push sv (itemAt pv oi)
            }
            def unit:string (itemAt units i)
            def decimals@(mutable):int 0
            if ((unit == "kg") || (unit == "km")) { decimals = 1 }
            feats.addChild((this.statsCard(("feature-" + (to_string i)) (itemAt labels i) unit (itemAt colors i) "" sd sv decimals)))
        }
        panel.addChild(feats)
        home.addChild(panel)
    }

    sfn featureRow:void (keys:[string] labels:[string] units:[string] colors:[string] key:string label:string unit:string color:string) {
        push keys key
        push labels label
        push units unit
        push colors color
    }

    ; `getCustomFieldColor`.
    sfn customFieldColor:string (name:string) {
        if ((RtEntry.findIn(name "nousu")) >= 0) { return "#22c55e" }
        if ((RtEntry.findIn(name "elevation")) >= 0) { return "#22c55e" }
        if ((RtEntry.findIn(name "askel")) >= 0) { return "#8b5cf6" }
        if ((RtEntry.findIn(name "step")) >= 0) { return "#8b5cf6" }
        if ((RtEntry.findIn(name "syke")) >= 0) { return "#ef4444" }
        if ((RtEntry.findIn(name "hr")) >= 0) { return "#ef4444" }
        return "#6366f1"
    }

    sfn lower:string (text:string) {
        def out@(mutable):string ""
        def i@(mutable):int 0
        def n:int (strlen text)
        while (i < n) {
            def ch:int (charAt text i)
            def piece@(mutable):string (substring text i (i + 1))
            if ((ch >= 65) && (ch <= 90)) { piece = (substring "abcdefghijklmnopqrstuvwxyz" (ch - 65) (ch - 64)) }
            if (ch == 196) { piece = "ä" }
            if (ch == 214) { piece = "ö" }
            if (ch == 197) { piece = "å" }
            out = (out + piece)
            i = (i + 1)
        }
        return out
    }

    ; `v.toFixed(decimals)`, and the rounded whole for none.
    sfn fixed:string (v:double decimals:int) {
        if (decimals <= 0) { return (to_string (to_int (v + 0.5))) }
        def scaled:int (to_int ((v * 10.0) + 0.5))
        def whole:int (to_int ((int2double scaled) / 10.0))
        return (((to_string whole) + ".") + (to_string (scaled - (whole * 10))))
    }

    ; One `StatsMiniCard`, or the note that there is not enough data for one.
    fn statsCard:EVGElement (key:string title:string unit:string color:string icon:string dates:[string] values:[double] decimals:int) {
        def card (tree Rt (Col (props (className "rt-feat-card"))))
        def head (tree Rt (Row (props (className "rt-stat-head"))))
        if ((strlen icon) > 0) {
            def glyph (tree Rt (PhIcon))
            glyph.svgSource = icon
            glyph.className = "rt-ph-icon rt-stat-icon"
            head.addChild(glyph)
        }
        head.addChild((tree Rt (FeatTitle title)))
        def n:int (array_length values)
        if (n < 2) {
            card.addChild(head)
            card.addChild((tree Rt (FeatPara (props (id ("rt-feat-" + key))) "Ei tarpeeksi dataa")))
            return card
        }
        def current:double (itemAt values (n - 1))
        def previous:double (itemAt values (n - 2))
        def sum@(mutable):double 0.0
        def lo@(mutable):double current
        def hi@(mutable):double current
        for values v:double i {
            sum = (sum + v)
            if (v < lo) { lo = v }
            if (v > hi) { hi = v }
        }
        def avg:double (sum / (int2double n))
        def trend:double (current - previous)
        def pct@(mutable):int 0
        if (previous > 0.0) { pct = (to_int ((((current - previous) / previous) * 100.0) + 0.5)) }
        if ((previous > 0.0) && (trend < 0.0)) { pct = (0 - (to_int ((((previous - current) / previous) * 100.0) + 0.5))) }
        head.addChild((tree Rt (Spacer)))
        def tglyph (tree Rt (PhIcon))
        def ttone@(mutable):string "#999999"
        if (trend > 0.0) { ttone = "#22c55e" }
        if (trend < 0.0) { ttone = "#ef4444" }
        if (trend > 0.0) { tglyph.svgSource = (RtIcons.trendingUp(ttone)) } {
            if (trend < 0.0) { tglyph.svgSource = (RtIcons.trendingDown(ttone)) } { tglyph.svgSource = (RtIcons.minus(ttone)) }
        }
        tglyph.className = "rt-ph-icon rt-stat-trend-icon"
        head.addChild(tglyph)
        def sign@(mutable):string ""
        if (trend > 0.0) { sign = "+" }
        def ttx (tree Rt (StatTrendTx ((sign + (to_string pct)) + "%")))
        ttx.setAttribute("color" ttone)
        head.addChild(ttx)
        card.addChild(head)
        def valueRow (tree Rt (Row (props (className "rt-stat-value-row"))))
        def big (tree Rt (StatBig (RealTrainerDemo.fixed(current decimals))))
        big.setAttribute("color" color)
        valueRow.addChild(big)
        valueRow.addChild((tree Rt (StatUnit unit)))
        card.addChild(valueRow)
        ; The curve's place: the chart is drawn here once the layout has
        ; placed the card — see `emitCharts`.
        def box (tree Rt (ChartBox (props (id ("rt-chart-" + key)))))
        card.addChild(box)
        def def0 (new RtChartDef())
        def0.id = ("rt-chart-" + key)
        def0.color = color
        def0.values = values
        push charts def0
        card.addChild((tree Rt (StatDate (RealTrainerDemo.fiDatePadded((itemAt dates (n - 1)))))))
        def foot (tree Rt (Row (props (className "rt-stat-foot"))))
        foot.addChild((tree Rt (StatFootTx ("Ka: " + (RealTrainerDemo.fixed(avg decimals))))))
        foot.addChild((tree Rt (Spacer)))
        foot.addChild((tree Rt (StatFootTx ("Min: " + (RealTrainerDemo.fixed(lo decimals))))))
        foot.addChild((tree Rt (Spacer)))
        foot.addChild((tree Rt (StatFootTx ("Max: " + (RealTrainerDemo.fixed(hi decimals))))))
        card.addChild(foot)
        return card
    }

    ; The charts, into the display list at their boxes. Each is a Vela chart
    ; called rather than written: the points as a dataset, an area under a
    ; monotone line, and the latest point marked, with no axes — the card
    ; carries the numbers. Both layers share one explicit domain so the
    ; point sits on the line. Clipped to the main area by hand, as a thing
    ; appended after the walk is outside every clip the walk pushed.
    fn emitCharts:void (dl:EVGDisplayList r:EVGElement) {
        if ((array_length charts) == 0) { return }
        def main:EVGElement (RealTrainerDemo.findEl(r "rt-ph-main"))
        if ((strlen main.id) == 0) { return }
        def tr (new UITextRenderer())
        for charts def0:RtChartDef i {
            def box:EVGElement (RealTrainerDemo.findEl(r def0.id))
            if ((strlen box.id) == 0) { continue }
            def w:int (to_int box.calculatedWidth)
            def h:int (to_int box.calculatedHeight)
            if ((w < 10) || (h < 10)) { continue }
            ; Out of the main area entirely: nothing to draw.
            if ((box.calculatedY + box.calculatedHeight) < main.calculatedY) { continue }
            if (box.calculatedY > (main.calculatedY + main.calculatedHeight)) { continue }
            def list:VlCommandList (this.chartCommands(def0 w h))
            dl.addClip(main.calculatedX main.calculatedY main.calculatedWidth main.calculatedHeight)
            def bridge (new VlEvgList())
            bridge.emit(dl list tr box.calculatedX box.calculatedY 1.0)
            dl.addClipEnd()
        }
    }

    ; The commands for one chart at one size, kept: a paint that changed
    ; nothing about the data draws the same picture.
    fn chartCommands:VlCommandList (def0:RtChartDef w:int h:int) {
        def key@(mutable):string ((def0.id + ":") + ((to_string w) + ("x" + (to_string h))))
        for def0.values v:double i { key = ((key + ",") + (to_string v)) }
        for chartKeys ck:string i {
            if (ck == key) { return (itemAt chartLists i) }
        }
        def list:VlCommandList (RealTrainerDemo.buildChart(def0 w h))
        push chartKeys key
        push chartLists list
        return list
    }

    sfn buildChart:VlCommandList (def0:RtChartDef w:int h:int) {
        def n:int (array_length def0.values)
        def lo@(mutable):double (itemAt def0.values 0)
        def hi@(mutable):double lo
        for def0.values v:double i {
            if (v < lo) { lo = v }
            if (v > hi) { hi = v }
        }
        if (hi <= lo) { hi = (lo + 1.0) }
        ; A hair of room over and under, so the line's width is not clipped
        ; at the top and the bottom of the plot.
        def pad:double ((hi - lo) * 0.06)
        lo = (lo - pad)
        hi = (hi + pad)
        def xs:[double]
        for def0.values v:double i { push xs (int2double i) }
        def data:VlDataset (VlDataset.create())
        data.numbers("i" xs)
        data.numbers("v" def0.values)
        def last:VlDataset (VlDataset.create())
        def lastX:[double]
        def lastV:[double]
        push lastX (int2double (n - 1))
        push lastV (itemAt def0.values (n - 1))
        last.numbers("i" lastX)
        last.numbers("v" lastV)
        def xScale:VlJson (RealTrainerDemo.domainJson(0.0 (int2double (n - 1))))
        def yScale:VlJson (RealTrainerDemo.domainJson(lo hi))
        def chart (VlChart.create(data))
        chart.size(w h)
        chart.background("#171717")
        chart.configJson((RealTrainerDemo.plainConfig()))
        chart.area().interpolate("monotone").markColor(def0.color).markOpacity(0.18).x("i").scaleJson(xScale).noAxis().y("v").scaleJson(yScale).noAxis()
        chart.line().interpolate("monotone").markColor(def0.color).strokeWidth(2.0).x("i").scaleJson(xScale).noAxis().y("v").scaleJson(yScale).noAxis()
        def dot (VlChart.create(last))
        dot.size(w h)
        dot.background("#171717")
        dot.configJson((RealTrainerDemo.plainConfig()))
        dot.point().filled(true).markColor(def0.color).markSize(36.0).x("i").scaleJson(xScale).noAxis().y("v").scaleJson(yScale).noAxis()
        def list:VlCommandList (RealTrainerDemo.runChart(chart))
        def dots:VlCommandList (RealTrainerDemo.runChart(dot))
        ; The point's commands after the curve's, so it is drawn over it —
        ; its background dropped, as it would cover the curve.
        for dots.commands c:VlDrawCommand i {
            if ((c.op == "rect") && (i == 0)) { continue }
            push list.commands c
        }
        return list
    }

    ; No padding, no frame around the plot: the card is the frame.
    sfn plainConfig:VlJson () {
        def p (new VlJsonParser())
        return (p.parse("{\"padding\":0,\"view\":{\"stroke\":null}}"))
    }

    sfn domainJson:VlJson (lo:double hi:double) {
        def p (new VlJsonParser())
        return (p.parse((((("{\"domain\":[" + (to_string lo)) + ",") + (to_string hi)) + "],\"nice\":false,\"zero\":false}")))
    }

    ; Vega-Lite → Vega → scene → commands, and an empty list for a chart
    ; that refused somewhere on the way.
    sfn runChart:VlCommandList (chart:VlChart) {
        def empty (new VlCommandList())
        if ((array_length chart.errors) > 0) { return empty }
        def spec:VlJson (chart.toSpec())
        def compiler (new VlCompile())
        def vg:VlJson (compiler.compileSpec(spec))
        if ((array_length compiler.errors) > 0) { return empty }
        def rt (new VlRuntime())
        def scene:VlSceneMark (rt.run(vg))
        if ((array_length rt.errors) > 0) { return empty }
        return (VlSceneCommands.build(scene))
    }

    ; An element by id, or one with an empty id when there is none — which is
    ; how the two callers below ask, and why this exists next to `byId`.
    ;
    ; It used to RECURSE ITSELF, and so built a fresh `EVGElement` at every
    ; node it walked past without matching. An `EVGElement` is not cheap — its
    ; constructor fills a box and a dozen unset units — and `emitCharts` calls
    ; this once per chart on every frame, over the whole tree. Element
    ; construction and `EVGUnit.unset` together were a fifth of a cold frame in
    ; the profile, and nearly all of it was this function throwing away
    ; elements it had just made. `byId` already answers the same question with
    ; an optional and allocates nothing, so the miss costs one element per
    ; LOOKUP rather than one per node.
    sfn findEl:EVGElement (el:EVGElement id:string) {
        def found@(optional):EVGElement (RealTrainerDemo.byId(el id))
        if found {
            return (unwrap found)
        }
        return (new EVGElement())
    }

    fn statsNum:EVGElement (big:string small:string tint:string) {
        def col (tree Rt (Col (props (className "rt-stats-num"))))
        def b (tree Rt (StatsBig big))
        b.className = ("rt-stats-big " + tint)
        col.addChild(b)
        col.addChild((tree Rt (StatsSmall small)))
        return col
    }

    fn homeTabBtn:EVGElement (id:string label:string active:boolean) {
        def b (this.exButton(id label label))
        if active {
            b.className = "rt-ex-btn rt-home-tab-on"
        } {
            b.className = "rt-ex-btn rt-outline-btn"
            RealTrainerDemo.tintText(b "rt-ex-btn-text rt-muted-text")
        }
        return b
    }

    ; Newest first; two on the same day keep the reverse of the file's order,
    ; as the day view lists them.
    sfn sortByDateDesc:[RtSeedEntry] (entries:[RtSeedEntry]) {
        def out@(mutable):[RtSeedEntry]
        def n:int (array_length entries)
        for entries e:RtSeedEntry i {
            def item:RtSeedEntry (itemAt entries ((n - 1) - i))
            def days:int (RtWeek.daysOf(item.date))
            def placed:[RtSeedEntry]
            def done@(mutable):boolean false
            for out o:RtSeedEntry j {
                if ((done == false) && ((RtWeek.daysOf(o.date)) < days)) {
                    push placed item
                    done = true
                }
                push placed o
            }
            if (done == false) {
                push placed item
            }
            out = placed
        }
        return out
    }

    ; The dashboard, as `DashboardView` has it on the phone: the heading and
    ; the edit button, the active plan with its card, and the period the
    ; calendar is in — counted from the plan's start to today.
    fn phoneDashboard:void (body:EVGElement) {
        def dash (tree Rt (Col (props (className "rt-dash-phone"))))
        def top (tree Rt (ModalRow))
        top.addChild((tree Rt (DashHd "Dashboard")))
        top.addChild((tree Rt (Spacer)))
        def edit (this.exButton("rt-dash-edit" "Muokkaa vuosisuunnitelmaa" "Muokkaa vuosisuunnitelmaa"))
        edit.className = "rt-ex-btn rt-outline-btn"
        top.addChild(edit)
        dash.addChild(top)
        def active (tree Rt (ModalRow))
        active.addChild((tree Rt (DashH2 (props (id "rt-h-plan")) "Aktiivinen suunnitelma")))
        active.addChild((tree Rt (Spacer)))
        def open (this.exButton("rt-dash-open" "Avaa suunnitelma" "Avaa suunnitelma ›"))
        open.className = "rt-ex-btn rt-link-btn"
        RealTrainerDemo.tintText(open "rt-ex-btn-text rt-link-text")
        active.addChild(open)
        dash.addChild(active)
        def card (tree Rt (DashCard (props (id "rt-dash-plan"))))
        card.addChild((tree Rt (DashH3 (props (id "rt-dash-plan-name")) seed.sheetName)))
        card.addChild((tree Rt (DashPara (props (id "rt-dash-plan-desc")) seed.sheetDescription)))
        card.addChild((tree Rt (DashPara (props (id "rt-dash-plan-when")) ("Aloitettu: " + (RtWeek.fiDate(seed.sheetStart))))))
        dash.addChild(card)
        if ((array_length seed.periods) > 0) {
            def period:RtPeriod (seed.firstPeriod())
            dash.addChild((tree Rt (DashH3 (props (id "rt-h-period") (className "rt-dash-h2")) "Nykyinen jakso")))
            def now (tree Rt (DashCard (props (id "rt-dash-period"))))
            def nameRow (tree Rt (ModalRow))
            nameRow.addChild((tree Rt (DashPara (props (id "rt-dash-period-name") (className "rt-dash-h3")) period.name)))
            nameRow.addChild((tree Rt (Spacer)))
            nameRow.addChild((tree Rt (DashMeta (props (className "rt-dash-kind")) period.kind)))
            now.addChild(nameRow)
            def weekNo:int (to_int (((int2double ((RtWeek.daysOf(today)) - (RtWeek.daysOf(seed.sheetStart))))) / 7.0))
            now.addChild((tree Rt (DashPara (props (id "rt-dash-week")) ((("Viikko " + (to_string (weekNo + 1))) + " / ") + (to_string period.durationWeeks)))))
            def bar (tree Rt (Row (props (className "rt-dash-bar"))))
            def fill (tree Rt (Row (props (className "rt-dash-bar-fill"))))
            def pct@(mutable):int 0
            if (period.durationWeeks > 0) {
                pct = (to_int ((int2double ((weekNo + 1) * 100)) / (int2double period.durationWeeks)))
            }
            if (pct > 100) { pct = 100 }
            fill.setAttribute("width" ((to_string pct) + "%"))
            bar.addChild(fill)
            now.addChild(bar)
            def ends:string (RtWeek.shifted(seed.sheetStart ((period.durationWeeks * 7) - 1)))
            def dates (tree Rt (ModalRow))
            dates.addChild((tree Rt (DashMeta (RtWeek.fiDate(seed.sheetStart)))))
            dates.addChild((tree Rt (Spacer)))
            dates.addChild((tree Rt (DashMeta (RtWeek.fiDate(ends)))))
            now.addChild(dates)
            now.addChild((tree Rt (DashPara (props (id "rt-dash-goal") (className "rt-dash-goal")) ("Tavoite: " + period.goals))))
            dash.addChild(now)
        }
        ; The goals: the sheet's rows, once it has any — the original shows
        ; them from the saved sheet, which has rows once the page opened it.
        if ((array_length ys.rows) > 0) {
            dash.addChild((tree Rt (DashH2 (props (id "rt-h-goals")) "Tavoitteet")))
            for ys.rows r:RtYsRow i {
                dash.addChild((tree Rt (DashPara (props (id ("rt-dash-goal-row-" + (to_string i)))) ((r.name + " ") + r.kind))))
            }
        }
        body.addChild(dash)
    }

    ; --- the calendar wizard -------------------------------------------------------
    ; `CalendarWizard.tsx`, step by step: the header with the dots, the
    ; step's body, and the footer that goes back or on. Everything drawn is
    ; read from `wizard`; the gates are its.
    fn wizardScreen:EVGElement () {
        def page (tree Rt (Wiz))
        def head (tree Rt (WizHead))
        head.addChild((this.iconBtn("rt-wiz-close" "Sulje" (RtIcons.x("#f2f2f2")))))
        def titles (tree Rt (Col))
        titles.addChild((tree Rt (WizHd "Luo kalenteri")))
        titles.addChild((tree Rt (WizPara (props (id "rt-wiz-step")) (wizard.stepText()))))
        head.addChild(titles)
        head.addChild((tree Rt (Spacer)))
        def dots (tree Rt (WizDots))
        def i@(mutable):int 0
        while (i < (wizard.stepCount())) {
            def dot (tree Rt (WizDot))
            if (i == (wizard.stepIndex())) {
                dot.className = "rt-wiz-dot rt-wiz-dot-on"
            }
            if (i < (wizard.stepIndex())) {
                dot.className = "rt-wiz-dot rt-wiz-dot-done"
            }
            dots.addChild(dot)
            i = (i + 1)
        }
        head.addChild(dots)
        page.addChild(head)
        def body (tree Rt (WizBody))
        body.setAttribute("overflow" "hidden")
        body.setAttribute("height" ((to_string (to_int (pageH - 144.0))) + "px"))
        body.scrollTop = wizScroll
        def st:string wizard.state
        if (st == "type") { this.wizardTypeStep(body) }
        if (st == "details") { this.wizardDetailsStep(body) }
        if (st == "encryption") { this.wizardEncryptionStep(body) }
        if ((st == "appearance") || (st == "creating")) { this.wizardAppearanceStep(body) }
        page.addChild(body)
        page.addChild((this.wizardFoot()))
        page.addChild((this.toasts()))
        return page
    }

    fn wizAccent:string (on:boolean) {
        if on { return "#f97316" }
        return "#999999"
    }

    ; Step one: the thirteen types, two to a row on a phone. A card's name is
    ; its label and its description, as the tree reads a button with both.
    fn wizardTypeStep:void (body:EVGElement) {
        def center (tree Rt (WizCenter))
        center.addChild((tree Rt (WizH2 (props (id "rt-wiz-h2")) "Valitse tyyppi")))
        center.addChild((tree Rt (WizPara (props (id "rt-wiz-sub")) "Millaista sisältöä haluat kirjata?")))
        body.addChild(center)
        def grid (tree Rt (WizGrid))
        def cw:int (to_int ((pageW - 44.0) / 2.0))
        for wizard.kinds k:RtCalendarKind i {
            def on:boolean (k.key == wizard.typeKey)
            def card (tree Rt (WizCard))
            card.id = ("rt-wiz-type-" + k.key)
            card.a11yLabel = ((k.label + " ") + k.description)
            card.setAttribute("width" ((to_string cw) + "px"))
            if on {
                card.className = "rt-wiz-card rt-wiz-card-on"
            }
            def ic (tree Rt (WizIcon))
            ic.svgSource = (RtIcons.kindIcon(k.key (this.wizAccent(on))))
            card.addChild(ic)
            card.addChild((tree Rt (WizCardTitle k.label)))
            card.addChild((tree Rt (WizCardDesc k.description)))
            grid.addChild(card)
        }
        body.addChild(grid)
    }

    fn wizBadge:EVGElement (icon:string className:string) {
        def badge (tree Rt (WizBadge))
        badge.className = className
        def ic (tree Rt (WizIcon))
        ic.svgSource = icon
        badge.addChild(ic)
        return badge
    }

    ; Step two: the name, which is required, and three that are not.
    fn wizardDetailsStep:void (body:EVGElement) {
        def kind:RtCalendarKind (wizard.selectedKind())
        def center (tree Rt (WizCenter))
        center.addChild((this.wizBadge((RtIcons.kindIcon(kind.key "#f97316")) "rt-wiz-badge")))
        center.addChild((tree Rt (WizH2 (props (id "rt-wiz-h2")) "Kalenterin tiedot")))
        center.addChild((tree Rt (WizPara (props (id "rt-wiz-sub")) kind.description)))
        body.addChild(center)
        body.addChild((tree Rt (WizLabel "Nimi *")))
        body.addChild((this.fieldBox(wizName)))
        body.addChild((tree Rt (WizLabel "Kuvaus")))
        body.addChild((this.fieldBox(wizDesc)))
        body.addChild((tree Rt (WizLabel "Tavoitteet")))
        body.addChild((this.fieldBox(wizGoals)))
        body.addChild((tree Rt (WizLabel "Nykyinen taso")))
        body.addChild((this.fieldBox(wizLevel)))
    }

    ; Step three: encryption, off by default. The toggle card is a box with
    ; no role in the original and is one here; it answers to its id.
    fn wizardEncryptionStep:void (body:EVGElement) {
        def on:boolean wizard.encrypted
        def center (tree Rt (WizCenter))
        center.addChild((this.wizBadge((RtIcons.shield("#22c55e")) "rt-wiz-badge rt-wiz-badge-green")))
        center.addChild((tree Rt (WizH2 (props (id "rt-wiz-h2")) "Suojaa tietosi")))
        center.addChild((tree Rt (WizPara (props (id "rt-wiz-sub")) "Salaus suojaa tietosi niin, ettei kukaan muu voi lukea niitä - edes me.")))
        body.addChild(center)
        def box (tree Rt (WizBox (props (id "rt-wiz-encrypt"))))
        if on {
            box.className = "rt-wiz-box rt-wiz-box-on"
        }
        def row (tree Rt (ModalRow))
        def lockColor@(mutable):string "#999999"
        if on { lockColor = "#22c55e" }
        row.addChild((this.wizBadge((RtIcons.lock(lockColor)) "rt-wiz-badge rt-wiz-badge-sm")))
        def col (tree Rt (Col (props (className "rt-wiz-box-col"))))
        def line (tree Rt (ModalRow))
        line.addChild((tree Rt (WizTx "Salaa tämä kalenteri")))
        line.addChild((tree Rt (Spacer)))
        def sw (tree Rt (WizSwitch))
        def knob (tree Rt (WizKnob))
        if on {
            sw.className = "rt-wiz-switch rt-wiz-switch-on"
            knob.className = "rt-wiz-knob rt-wiz-knob-on"
        }
        sw.addChild(knob)
        line.addChild(sw)
        col.addChild(line)
        col.addChild((tree Rt (WizPara (props (id "rt-wiz-encrypt-desc")) "Vain sinä voit nähdä sisällön salasanallasi")))
        row.addChild(col)
        box.addChild(row)
        body.addChild(box)
        if on {
            def warn (tree Rt (WizBox (props (className "rt-wiz-box rt-wiz-warn"))))
            def wrow (tree Rt (ModalRow))
            def wi (tree Rt (PhIcon))
            wi.svgSource = (RtIcons.alertTriangle("#f59e0b"))
            wrow.addChild(wi)
            def wcol (tree Rt (Col (props (className "rt-wiz-box-col"))))
            wcol.addChild((tree Rt (WizTx (props (className "rt-wiz-text rt-wiz-amber")) "Tärkeää!")))
            wcol.addChild((tree Rt (WizPara (props (id "rt-wiz-warn-text")) "Jos unohdat salasanan, emme voi palauttaa tietojasi. Tallenna salasana turvalliseen paikkaan.")))
            wrow.addChild(wcol)
            warn.addChild(wrow)
            body.addChild(warn)
            body.addChild((tree Rt (WizLabel "Salaussalasana")))
            def prow (tree Rt (ModalRow))
            prow.addChild((this.fieldBox(wizPass)))
            def showText@(mutable):string "Näytä"
            if wizard.showPassword { showText = "Piilota" }
            prow.addChild((this.wizButton("rt-wiz-show" showText "" "rt-wiz-btn rt-wiz-link")))
            body.addChild(prow)
            if ((strlen wizard.password) > 0) {
                def score:int (wizard.strength())
                def tone@(mutable):string "rt-wiz-red"
                if (score > 1) { tone = "rt-wiz-orange" }
                if (score > 2) { tone = "rt-wiz-yellow" }
                if (score > 3) { tone = "rt-wiz-green" }
                def bars (tree Rt (WizBars))
                def b@(mutable):int 1
                while (b <= 5) {
                    def bar (tree Rt (WizBar))
                    if (b <= score) {
                        bar.className = ("rt-wiz-bar rt-wiz-bar-" + tone)
                    }
                    bars.addChild(bar)
                    b = (b + 1)
                }
                body.addChild(bars)
                body.addChild((tree Rt (WizPara (props (id "rt-wiz-strength") (className ("rt-wiz-para " + tone))) (wizard.strengthLabel()))))
            }
            body.addChild((tree Rt (WizLabel "Vahvista salasana")))
            def cb:EVGElement (this.fieldBox(wizConfirm))
            if ((strlen wizard.confirm) > 0) {
                if (wizard.passwordsMatch()) {
                    cb.className = (cb.className + " rt-field-ok")
                } {
                    cb.className = (cb.className + " rt-field-bad")
                }
            }
            body.addChild(cb)
            if ((strlen wizard.confirm) > 0) {
                if (wizard.passwordsMatch()) {
                    body.addChild((tree Rt (WizPara (props (id "rt-wiz-match") (className "rt-wiz-para rt-wiz-green")) "Salasanat täsmäävät")))
                } {
                    body.addChild((tree Rt (WizPara (props (id "rt-wiz-match") (className "rt-wiz-para rt-wiz-red")) "Salasanat eivät täsmää")))
                }
            }
        } {
            def info (tree Rt (WizBox))
            info.addChild((tree Rt (WizPara (props (id "rt-wiz-noenc")) "Ilman salausta tiedot tallennetaan palvelimelle suojaamattomina. Ne ovat edelleen yksityisiä, mutta ylläpito voi teknisesti nähdä ne.")))
            body.addChild(info)
        }
    }

    ; Step four: the preview, the ten colours, the three visibilities.
    fn wizardAppearanceStep:void (body:EVGElement) {
        def kind:RtCalendarKind (wizard.selectedKind())
        def center (tree Rt (WizCenter))
        center.addChild((tree Rt (WizH2 (props (id "rt-wiz-h2")) "Ulkoasu")))
        center.addChild((tree Rt (WizPara (props (id "rt-wiz-sub")) "Valitse väri ja näkyvyysasetukset")))
        body.addChild(center)
        ; The preview's border is the chosen colour — a class of its own,
        ; with no border colour of its own for the stylesheet to put back.
        def preview (tree Rt (WizBox (props (className "rt-wiz-preview"))))
        preview.setAttribute("border-color" wizard.color)
        def prow (tree Rt (ModalRow))
        prow.addChild((this.wizBadge((RtIcons.kindIcon(kind.key wizard.color)) "rt-wiz-badge rt-wiz-badge-sm")))
        def pcol (tree Rt (Col (props (className "rt-wiz-box-col"))))
        def nrow (tree Rt (ModalRow))
        def shown@(mutable):string (wizard.nameTrimmed())
        if ((strlen shown) == 0) { shown = "Kalenterin esikatselu" }
        nrow.addChild((tree Rt (WizTx shown)))
        if wizard.encrypted {
            def li (tree Rt (PhIcon (props (className "rt-ph-icon rt-ph-icon-sm"))))
            li.svgSource = (RtIcons.lock("#22c55e"))
            nrow.addChild(li)
        }
        pcol.addChild(nrow)
        pcol.addChild((tree Rt (WizPara (props (id "rt-wiz-preview-kind")) kind.label)))
        prow.addChild(pcol)
        preview.addChild(prow)
        body.addChild(preview)
        body.addChild((tree Rt (WizLabel "Väri")))
        def swatches (tree Rt (WizGrid))
        for wizard.colors c:string i {
            def sw (tree Rt (WizSwatch))
            sw.id = ("rt-wiz-color-" + (to_string i))
            sw.a11yLabel = ""
            sw.setAttribute("background-color" c)
            if (c == wizard.color) {
                sw.className = "rt-wiz-swatch rt-wiz-swatch-on"
            }
            swatches.addChild(sw)
        }
        body.addChild(swatches)
        body.addChild((tree Rt (WizLabel "Näkyvyys")))
        def vis (tree Rt (ModalRow))
        vis.addChild((this.wizVis("private" "Yksityinen" (RtIcons.lock((this.wizAccent((wizard.visibility == "private"))))))))
        vis.addChild((this.wizVis("group" "Ryhmälle" (RtIcons.users((this.wizAccent((wizard.visibility == "group"))))))))
        vis.addChild((this.wizVis("public" "Julkinen" (RtIcons.unlock((this.wizAccent((wizard.visibility == "public"))))))))
        body.addChild(vis)
    }

    fn wizVis:EVGElement (key:string label:string icon:string) {
        def b (tree Rt (WizVis))
        b.id = ("rt-wiz-vis-" + key)
        b.a11yLabel = label
        if (wizard.visibility == key) {
            b.className = "rt-wiz-vis rt-wiz-vis-on"
        }
        def ic (tree Rt (PhIcon))
        ic.svgSource = icon
        b.addChild(ic)
        b.addChild((tree Rt (WizCardTitle label)))
        return b
    }

    ; Back or cancel on the left; next, or create on the last step, on the
    ; right — disabled while the step's gate is shut, as the original's.
    fn wizardFoot:EVGElement () {
        def foot (tree Rt (WizFoot))
        if ((wizard.stepIndex()) > 0) {
            foot.addChild((this.wizButton("rt-wiz-back" "Takaisin" (RtIcons.chevronLeft("#f2f2f2")) "rt-wiz-btn")))
        } {
            foot.addChild((this.wizButton("rt-wiz-cancel" "Peruuta" (RtIcons.chevronLeft("#f2f2f2")) "rt-wiz-btn")))
        }
        foot.addChild((tree Rt (Spacer)))
        if ((wizard.isLast()) == false) {
            def next (this.wizButton("rt-wiz-next" "Seuraava" (RtIcons.chevronRight("#ffffff")) "rt-wiz-btn rt-wiz-primary"))
            if ((wizard.canGoNext()) == false) {
                next.a11yDisabled = true
                next.className = "rt-wiz-btn rt-wiz-primary rt-wiz-off"
            }
            foot.addChild(next)
        } {
            def creating:boolean (wizard.state == "creating")
            def label@(mutable):string "Luo kalenteri"
            if creating { label = "Luodaan..." }
            def go (this.wizButton("rt-wiz-create" label (RtIcons.check("#ffffff")) "rt-wiz-btn rt-wiz-go"))
            if (creating || ((strlen (wizard.nameTrimmed())) == 0)) {
                go.a11yDisabled = true
                go.className = "rt-wiz-btn rt-wiz-go rt-wiz-off"
            }
            foot.addChild(go)
        }
        return foot
    }

    fn wizButton:EVGElement (id:string label:string icon:string className:string) {
        def b (tree Rt (WizBtn))
        b.id = id
        b.a11yLabel = label
        b.className = className
        if ((strlen icon) > 0) {
            def ic (tree Rt (PhIcon (props (className "rt-ph-icon rt-ph-icon-sm"))))
            ic.svgSource = icon
            b.addChild(ic)
        }
        b.addChild((tree Rt (WizBtnTx label)))
        return b
    }

    fn pressWizard:boolean (id:string) {
        if ((id == "rt-wiz-close") || (id == "rt-wiz-cancel")) {
            wizard.close()
            scene = "app"
            section = "home"
            docScroll = 0.0
            return true
        }
        if (id == "rt-wiz-back") { return (wizard.goPrev()) }
        if (id == "rt-wiz-next") {
            def moved:boolean (wizard.goNext())
            if moved { wizScroll = 0.0 }
            return moved
        }
        if (RtEntry.hasPrefix(id "rt-wiz-type-")) {
            return (wizard.setType((substring id 12 (strlen id))))
        }
        if (id == "rt-wiz-encrypt") { return (wizard.toggleEncrypted()) }
        if (id == "rt-wiz-show") { return (wizard.toggleShowPassword()) }
        def ci:int (RealTrainerDemo.digitOf(id "rt-wiz-color-"))
        if (ci >= 0) { return (wizard.setColorAt(ci)) }
        if (RtEntry.hasPrefix(id "rt-wiz-vis-")) {
            return (wizard.setVisibility((substring id 11 (strlen id))))
        }
        if (id == "rt-wiz-create") {
            def started:boolean (wizard.submit())
            if started {
                wizJob.failNext = backend.failNext
                backend.failNext = false
                wizJob.begin((wizard.nameTrimmed()))
            }
            return started
        }
        return false
    }

    ; The job answered. Made: the calendar joins the seed's, is selected,
    ; and Home opens with a toast — `navigateTo('home')` and
    ; `toast.success`. Not made: back to the last step, and the toast says so.
    fn wizardDone:void (ok:boolean) {
        if (ok == false) {
            wizard.complete(false)
            toastText = "Päiväkirjan luonti epäonnistui"
            toastMs = 4000.0
            return
        }
        def id:string ("cal-new-" + (to_string (wizard.created + 1)))
        def newName:string (wizard.nameTrimmed())
        seed.addCalendar(id newName wizard.typeKey wizard.color)
        seed.selectCalendar(id)
        toastText = (("Päiväkirja \"" + newName) + "\" luotu")
        if wizard.encrypted {
            toastText = (("Salattu päiväkirja \"" + newName) + "\" luotu 🔐")
        }
        wizard.complete(true)
        scene = "app"
        section = "home"
        docScroll = 0.0
        toastMs = 4000.0
    }

    ; --- the year sheet ------------------------------------------------------------
    ; `YearSheetPageV2`: the list, or one sheet — inside the shell, under
    ; the bar, without the header. Everything is read from `ys` and the seed.
    fn yearsheetScreen:EVGElement () {
        def page (tree Rt (Phone))
        def main (tree Rt (PhMain))
        main.setAttribute("overflow" "hidden")
        main.scrollTop = docScroll
        def body (tree Rt (PhBody))
        if (ys.view == "list") {
            this.ysList(body)
        } {
            this.ysDetail(body)
        }
        main.addChild(body)
        ; The same shell as `appScreen`, without the header.
        page.addChild((this.iconRail()))
        def side (tree Rt (PhSide))
        side.addChild(main)
        this.overlays(side)
        side.addChild((this.bottomNav()))
        page.addChild(side)
        page.addChild((this.toasts()))
        return page
    }

    ; The list: a card per sheet, named by everything on it.
    fn ysList:void (body:EVGElement) {
        def head (tree Rt (YsHead))
        head.addChild((this.iconBtn("rt-ys-back" "" (RtIcons.arrowLeft("#f2f2f2")))))
        def titles (tree Rt (Col))
        titles.addChild((tree Rt (YsHd "Vuosisuunnitelmat")))
        def n@(mutable):int 0
        if ((strlen seed.sheetId) > 0) { n = 1 }
        titles.addChild((tree Rt (YsPara (props (id "rt-ys-count")) ((to_string n) + " suunnitelmaa"))))
        head.addChild(titles)
        body.addChild(head)
        if (n == 0) {
            body.addChild((tree Rt (YsPara (props (id "rt-ys-none")) "Sinulla ei ole vielä vuosisuunnitelmia.")))
            return
        }
        def card (tree Rt (YsCard))
        def meta:string ((((RtWeek.fiDate(seed.sheetStart)) + " • ") + (to_string (array_length seed.periods))) + (" kautta Luotu: " + (RtWeek.fiDate((this.sheetCreatedDay())))))
        def open (tree Rt (YsCardBtn))
        open.id = ("rt-ys-open-" + seed.sheetId)
        open.a11yLabel = ((((seed.sheetName + " ") + seed.sheetDescription) + " ") + meta)
        open.addChild((tree Rt (YsH3 (props (id "rt-ys-card-name")) seed.sheetName)))
        if ((strlen seed.sheetDescription) > 0) {
            open.addChild((tree Rt (YsPara (props (id "rt-ys-card-desc")) seed.sheetDescription)))
        }
        open.addChild((tree Rt (YsDim meta)))
        card.addChild(open)
        card.addChild((this.iconBtn(("rt-ys-delete-" + seed.sheetId) "Poista suunnitelma" (RtIcons.trash("#999999")))))
        body.addChild(card)
    }

    ; One sheet: the header and its toolbar, an editor when one is on, the
    ; grid, the legend, and the periods with their example weeks.
    fn ysDetail:void (body:EVGElement) {
        def head (tree Rt (YsHead))
        head.addChild((this.iconBtn("rt-ys-back" "" (RtIcons.arrowLeft("#f2f2f2")))))
        def titles (tree Rt (Col))
        titles.addChild((tree Rt (YsHd seed.sheetName)))
        def range:string ((((RtWeek.fiDate(seed.sheetStart)) + " - ") + (RtWeek.fiDate((RtYearSheet.sheetEnd(seed))))) + (" • " + seed.calendarName))
        titles.addChild((tree Rt (YsPara (props (id "rt-ys-range")) range)))
        head.addChild(titles)
        body.addChild(head)
        def tools (tree Rt (YsTools))
        tools.addChild((this.iconBtn("rt-ys-reset" "Poista ja aloita alusta" (RtIcons.rotateCcw("#ef4444")))))
        tools.addChild((this.iconBtn("rt-ys-copy" "Kopioi JSON leikepöydälle" (RtIcons.copy("#f2f2f2")))))
        tools.addChild((this.iconBtn("rt-ys-paste" "Liitä JSON leikepöydältä" (RtIcons.clipboardPaste("#f2f2f2")))))
        tools.addChild((this.ysTool("rt-ys-ai" "Muokkaa vuosisuunnitelmaa" (RtIcons.sparkles("#ffffff")) "rt-ys-tool rt-ys-tool-violet")))
        tools.addChild((this.ysTool("rt-ys-features" "Featuret" (RtIcons.barChart("#f2f2f2")) "rt-ys-tool rt-ys-tool-outline")))
        def pcls@(mutable):string "rt-ys-tool"

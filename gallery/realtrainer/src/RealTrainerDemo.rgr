            "<path d='M5 3h7v2H6v14h6v2H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z'/>" +
            "<path d='M15.6 7.4L20.2 12l-4.6 4.6-1.4-1.4 2.2-2.2H9v-2h7.4l-2.2-2.2 1.4-1.4z'/></svg>")
    }

    ; The rail's buttons carry ARTWORK and a name, and the two are not the same
    ; thing: the glyph is `aria-hidden`, so a reader hears "Etusivu" and never
    ; hears a shape described.
    sfn railButton:EVGElement (btnId:string icon:string label:string) {
        def glyph (tree Rt (Icon (props (className "rt-rail-icon"))))
        glyph.svgSource = icon
        def btn (tree Rt (RailBtn (props (id btnId) (a11yLabel label))))
        btn.addChild(glyph)
        return btn
    }

    fn rail:EVGElement () {
        def rail (tree Rt (Rail))
        rail.addChild((RealTrainerDemo.railButton("rt-rail-home" (RealTrainerDemo.iconHome()) "Etusivu")))
        rail.addChild((RealTrainerDemo.railButton("rt-rail-plan" (RealTrainerDemo.iconCalendar()) "Suunnitelmat")))
        rail.addChild((RealTrainerDemo.railButton("rt-rail-log" (RealTrainerDemo.iconBook()) "Päiväkirja")))
        rail.addChild((RealTrainerDemo.railButton("rt-rail-train" (RealTrainerDemo.iconMic()) "Aloita treeni")))
        rail.addChild((RealTrainerDemo.railButton("rt-rail-chat" (RealTrainerDemo.iconChat()) "Valmentaja")))
        rail.addChild((RealTrainerDemo.railButton("rt-rail-out" (RealTrainerDemo.iconExit()) "Kirjaudu ulos")))
        return rail
    }

    ; The goals table. `TableCtl` owns the sort — which column, which way, and
    ; the third click that puts the rows back the way they came — and this
    ; builds the boxes for whatever order it hands over.
    fn goalsTable:EVGElement () {
        def head (tree Rt (HeadRow (props (id (goals.headRowTid())))))
        def i:int 0
        while (i < (array_length goals.columns)) {
            def col:UiColumn (itemAt goals.columns i)
            def label:string col.label
            ; `aria-sort` as EVGA11yTree spells it: 1 is NONE, 2 ascending,
            ; 3 descending — and 0 is "this is not a sortable header at all".
            ; Read as 0/1/2 both columns wore an arrow at once, which is a
            ; table claiming to be sorted two ways.
            def state:int (goals.sortStateOf(col.key))
            if (state == 2) {
                label = (label + "   ↑")
            }
            if (state == 3) {
                label = (label + "   ↓")
            }
            def th (tree Rt
                (Th (props (id (goals.colTid(col.key))) (a11yLabel col.label)
                           (className ("rt-th rt-th-" + col.key)))
                    (ThText label)))
            th.a11ySorted = state
            head.addChild(th)
            i = (i + 1)
        }
        def body (tree Rt (Body))
        def rows:[UiRecord] (goals.sortedRecords())
        def j:int 0
        while (j < (array_length rows)) {
            def rec:UiRecord (itemAt rows j)
            def kind:string (itemAt rec.cells 1)
            def show:boolean true
            ; The toggle above the table is a FILTER and not a sort: it hides
            ; rows rather than moving them, so the sort the controller has
            ; arrived at still holds for what is left.
            if sportOnly.on {
                if (kind != "Sport") {
                    show = false
                }
            }
            if show {
                def what:string (itemAt rec.cells 0)
                def row (tree Rt
                    (Tr (props (id (goals.rowTid(rec.key))))
                        (Dot)
                        (Td (props (id (goals.cellTid(rec.key "goal")))) what)
                        (Spacer)
                        (TdDim (props (id (goals.cellTid(rec.key "kind")))) kind)))
                body.addChild(row)
            }
            j = (j + 1)
        }
        return (tree Rt
            (Table (props (id "rt-goals"))
                (child head)
                (child body)))
    }

    ; Thirty days, seven across — one CSS grid, and the only thing this app
    ; needs one for. A flex row that wraps would place the same boxes and would
    ; not keep a column above a column.
    sfn calendar:EVGElement () {
        def cal (tree Rt (Cal))
        def names:[string] ([] _:string ("ma" "ti" "ke" "to" "pe" "la" "su"))
        def i:int 0
        while (i < 7) {
            def dayName:string (itemAt names i)
            cal.addChild((tree Rt (CalHead (props (id ("rt-cal-h-" + dayName))) dayName)))
            i = (i + 1)
        }
        ; Which days carry a session. Three a week, and the pattern is the one
        ; the plan above says: heavy, light, throw.
        def day:int 1
        while (day <= 28) {
            def cls:string "rt-cal-day"
            def rest:int (day - (7 * (idiv day 7)))
            def marked:boolean false
            if (rest == 1) {
                marked = true
            }
            if (rest == 3) {
                marked = true
            }
            if (rest == 6) {
                marked = true
            }
            if marked {
                cls = "rt-cal-day rt-cal-day-on"
            }
            def dayNum:string (to_string day)
            def cell (tree Rt
                (CalDay (props (id ("rt-cal-d-" + dayNum)) (className cls)
                               (a11yLabel (dayNum + ". päivä")))
                    (CalNum dayNum)))
            if marked {
                cell.addChild((tree Rt (CalMark)))
            }
            cal.addChild(cell)
            day = (day + 1)
        }
        return cal
    }

    fn dashPanel:EVGElement () {
        this.dress(sportOnly)
        def col (tree Rt
            (Col (props (className "rt-dash"))
                (Section (props (id "rt-h-plan")) "Aktiivinen suunnitelma")
                (PlanCard
                    (PlanName "Kuulantyöntäjän vuosisuunnitelma 2025-2026")
                    (PlanDesc "Kokeneen kuulantyöntäjän vuosisuunnitelma, joka painottaa voiman eri osa-alueiden kehittämistä ja lajikohtaista nopeutta.")
                    (PlanWhen "Aloitettu: 1.10.2025"))
                (Notice
                    (NoticeHd "Seuraava jakso alkaa huomenna!")
                    (NoticeTx "Ulkokilpailukausi 2 — tavoite: pääkilpailut ja kauden huipennus"))))
        def head (tree Rt (Row (props (className "rt-goals-head"))))
        head.addChild((tree Rt (Section (props (id "rt-h-goals")) "Tavoitteet")))
        head.addChild((tree Rt (Spacer)))
        head.addChild((unwrap sportOnly.rootEl))
        col.addChild(head)
        col.addChild((this.goalsTable()))
        return col
    }

    fn drillsPanel:EVGElement () {
        this.dress(plans)
        def col (tree Rt (Col (props (className "rt-dash"))))
        col.addChild((tree Rt (Section (props (id "rt-h-plans")) "Kaikki suunnitelmat")))
        col.addChild((unwrap plans.rootEl))
        return col
    }

    fn calPanel:EVGElement () {
        def col (tree Rt (Col (props (className "rt-dash"))))
        col.addChild((tree Rt (Section (props (id "rt-h-cal")) "Lokakuu")))
        col.addChild((RealTrainerDemo.calendar()))
        return col
    }

    ; The panel belongs to `TabsCtl`, and what is IN it belongs to the app.
    ; `build()` puts an empty body label in each panel and this fills the one
    ; that is showing — the same bargain `WindowCtl` makes with its `bodyEl`:
    ; the controller owns the chrome and the states, the caller owns the
    ; content.
    fn fillActivePanel:void () {
        def i:int 0
        while (i < (array_length tabs.items)) {
            def it:UiItem (itemAt tabs.items i)
            if (it.value == tabs.value) {
                def panel:EVGElement (unwrap it.contentEl)
                if (it.value == "cal") {
                    panel.addChild((this.calPanel()))
                }
                if (it.value == "drills") {
                    panel.addChild((this.drillsPanel()))
                }
                if (it.value == "dash") {
                    panel.addChild((this.dashPanel()))
                }
            }
            i = (i + 1)
        }
    }

    fn dashboard:EVGElement () {
        this.dress(tabs)
        this.fillActivePanel()
        def main (tree Rt
            (Main
                (Top
                    (Title "Dashboard")
                    (Spacer)
                    (PlanBtn (AddTx "Suunnittele viikko"))
                    (Note "Tero — 95 %"))))
        if (plan.isOpen()) {
            main.addChild((this.planSheet()))
        }
        main.addChild((unwrap tabs.rootEl))
        return (tree Rt
            (Page (props (id "rt-page") (className "rt-page rt-page-dash"))
                (App
                    (child (this.rail()))
                    (child main))))
    }

    ; --- scene four: one training session -------------------------------------
    ;
    ; The screen a person is actually on while training: what to do, how much
    ; of it, and a clock. Everything on it is flex — three steppers on a row,
    ; two buttons that share a line — except the dial, which is the ring again
    ; at a larger size and with a different thing to say.

    sfn stepper:EVGElement (capId:string cap:string value:string) {
        return (tree Rt
            (Step
                (StepCap cap)
                (StepRow
                    (StepBtn (props (id (capId + "-down")) (a11yLabel (cap + " vähemmän")))
                        (StepBtnTx "−"))
                    (StepVal (props (id (capId + "-value"))) value)
                    (StepBtn (props (id (capId + "-up")) (a11yLabel (cap + " enemmän")))
                        (StepBtnTx "+")))))
    }

    fn failLabel:string () {
        if (backend.failNext) {
            return "vikatila päällä"
        }
        return "vikatila pois"
    }

    fn moveCard:EVGElement () {
        this.dress(rest)
        def row:CompactRow (at rows moveIndex)

        ; One element per part, and the tone becomes a CLASS — a controller
        ; writes class names and never a colour, and this card is held to the
        ; same rule.
        def plan (tree Rt (MovePlan))
        def parts:[StatPart] (CompactStatBuilder.parts(row))
        for parts p:StatPart i {
            plan.addChild((tree Rt (StatTx (props (className ("rt-stat rt-stat-" + p.tone))) p.text)))
        }

        def head (tree Rt
            (MoveHead
                (MoveName (((to_string (this.moveOrdinal())) + ". ") + (CompactStatBuilder.label(row))))
                (Spacer)))
        head.addChild(plan)

        def card (tree Rt (Move (props (id "rt-move"))))
        card.addChild(head)

        def where:string (this.sectionOf(moveIndex))
        if ((strlen where) > 0) {
            card.addChild((tree Rt (MoveWhere where)))
        }

        ; A measured row records what happened. Steppers under it would be
        ; offering to edit the past, so the card says what it is instead.
        if (CompactRowEdit.isPlanned(row)) {
            def steps (tree Rt (Steps))
            steps.addChild((RealTrainerDemo.stepper("rt-sets" "Sarjat" (to_string (CompactRowEdit.sets(row))))))
            steps.addChild((tree Rt (Times "×")))
            steps.addChild((RealTrainerDemo.stepper("rt-reps" "Toistot" (to_string (CompactRowEdit.reps(row))))))
            steps.addChild((tree Rt (Times "×")))
            steps.addChild((RealTrainerDemo.stepper("rt-weight" "Paino" ((to_string (CompactRowEdit.weight(row))) + "kg"))))
            card.addChild(steps)
        } {
            card.addChild((tree Rt (MoveWhere "Mitattu sarja — luvut ovat jo tapahtuneet")))
        }

        def restRow (tree Rt (RestRow))
        restRow.addChild((tree Rt (RestCap "Tauko:")))
        restRow.addChild((unwrap rest.rootEl))
        card.addChild(restRow)

        card.addChild((tree Rt
            (Actions
                (Start
                    (StartTx "▷  Aloita sarjat"))
                (DoneBtn
                    (DoneTx "✓  Valmis")))))
        return card
    }

    ; The dial: sixty ticks and a number, stacked in one grid cell. How many
    ; ticks are lit is arithmetic on the time left, done in `writeFrame` — the
    ; tree here says only that there are sixty of them.
    ; THE OTHER WAY TO ARRANGE A RING, and the loader has the first one.
    ;
    ; The loader's twelve blades are turned by the STYLESHEET — twelve classes,
    ; twelve angles, written out. Sixty of those would be sixty rules that say
    ; the same thing with a different number in it, so the dial's angles are
    ; computed here and written inline. Both are the same layout underneath: a
    ; one-cell grid, and a pivot below each tick's own box.
    sfn dial:EVGElement () {
        def dial (tree Rt (Dial))
        def i:int 0
        while (i < 60) {
            def tick (tree Rt (Tick))
            tick.setAttribute("transform" (("rotate(" + (to_string (6 * i))) + "deg)"))
            tick.markInline("transform")
            dial.addChild(tick)
            i = (i + 1)
        }
        dial.addChild((tree Rt
            (DialMid
                (DialNum "60")
                (DialCap "Sarja 1 / 3"))))
        return dial
    }

    fn timerPanel:EVGElement () {
        def col (tree Rt (Col (props (className "rt-timer"))))
        col.addChild((tree Rt (WorkName (CompactStatBuilder.label((at rows moveIndex))))))
        col.addChild((RealTrainerDemo.dial()))
        col.addChild((tree Rt
            (Actions (props (className "rt-actions rt-timer-actions"))
                (Round (props (id "rt-pause") (a11yLabel "Pysäytä ajastin"))
                    (RoundTx "⏸"))
                (Round (props (id "rt-reset") (a11yLabel "Nollaa ajastin"))
                    (RoundTx "↺"))
                (DoneBtn (props (id "rt-timer-done") (className "rt-done rt-done-narrow")
                                (a11yLabel "Sarja tehty"))
                    (DoneTx "✓  Valmis")))))
        return col
    }

    fn workout:EVGElement () {
        session.value = (int2double doneMoves)
        this.dress(session)
        def main (tree Rt (Main (props (className "rt-main rt-main-work"))))
        def top (tree Rt
            (WorkTop
                (WorkName workTitle)
                (Spacer)
                (Quit
                    (QuitTx "✕  Keskeytä harjoitus"))))
        main.addChild(top)
        def sub (tree Rt
            (Row (props (className "rt-work-line"))
                (WorkSub ((((to_string doneMoves) + " / ") + (to_string moveCount)) + " liikettä tehty"))))
        sub.addChild((unwrap session.rootEl))
        main.addChild(sub)
        ; The save's own line. A screen with no waiting and no failure in it is
        ; a screen whose waiting and failure states were never drawn, so both
        ; are here and both are reachable — `rt-fail` arms the next failure.
        def status (tree Rt
            (Row (props (className "rt-save-row"))
                (SaveState (props (id "rt-save-state")
                                  (className ("rt-save-state rt-save-" + backend.state)))
                           backend.message)
                (Spacer)
                (FailBtn (props (id "rt-fail")
                                (a11yLabel "Kaada seuraava tallennus"))
                         (FailTx (this.failLabel())))
                (SaveBtn
                    (SaveTx "Tallenna"))))
        main.addChild(status)
        if timerOn {
            main.addChild((this.timerPanel()))
        } {
            main.addChild((this.moveCard()))
        }
        return (tree Rt
            (Page (props (id "rt-page") (className "rt-page rt-page-dash"))
                (App
                    (child (this.rail()))
                    (child main))))
    }

    ; --- scene five: the whole document ---------------------------------------
    ;
    ; The session screen shows ONE move at a time, which is what a person
    ; training wants and what hides the rest of the parser's work. This screen
    ; is the other half: every row the document has, drawn by its family, with
    ; nothing between it and `CompactStatBuilder`.

    fn documentRow:EVGElement (row:CompactRow index:int) {
        def kind:string (CompactStatBuilder.kind(row))
        def label:string (CompactStatBuilder.label(row))
        def rowId:string ("rt-doc-" + (to_string index))

        ; A section is a heading and not an entry: it names what follows
        ; rather than saying anything of its own.
        if (kind == "section") {
            return (tree Rt
                (DocHead (props (id rowId) (className "rt-doc-head") (a11yLabel label))
                    (DocLabel (props (id (rowId + "-label")) (className "rt-doc-head-label")) label)))
        }

        def el (tree Rt (DocRow (props (id rowId) (className ("rt-doc-row rt-doc-" + kind)))))
        if ((strlen label) > 0) {
            el.addChild((tree Rt (DocLabel (props (id (rowId + "-label"))) label)))
        }
        el.addChild((tree Rt (Spacer)))
        ; Whether the runs touch is a property of the FAMILY, not of the
        ; renderer. `3x5` and `x80kg` are one reading and must not be prised
        ; apart; a phase marker and its name, a duration and its description,
        ; and a split's fields are separate words and the reference spaces
        ; them. So the gap is a class on the container and not a guess.
        def partsClass@(mutable):string "rt-doc-parts"
        if (kind == "phase") {
            partsClass = "rt-doc-parts rt-doc-parts-gap"
        }
        if (kind == "duration") {
            partsClass = "rt-doc-parts rt-doc-parts-gap"
        }
        if (kind == "split") {
            partsClass = "rt-doc-parts rt-doc-parts-gap"
        }
        if (kind == "circuit") {
            partsClass = "rt-doc-parts rt-doc-parts-gap"
        }
        def parts (tree Rt (DocParts (props (id (rowId + "-parts")) (className partsClass))))
        def list:[StatPart] (CompactStatBuilder.parts(row))
        for list p:StatPart i {
            parts.addChild((tree Rt
                (StatTx (props (id ((rowId + "-p") + (to_string i)))
                               (className ("rt-stat rt-stat-" + p.tone))) p.text)))
        }
        el.addChild(parts)
        return el
    }

    ; The dialog, drawn from the machine's state. There is no local flag for
    ; "is it open" and no second copy of the text: `addDialog` holds both, and
    ; this reads them.
    fn addSheet:EVGElement () {
        def sheet (tree Rt (Sheet))
        sheet.addChild((tree Rt (SheetHd "Lisää harjoitus")))
        sheet.addChild((tree Rt
            (SheetRow
                (SheetCap "Päivä")
                (Spacer)
                (SheetVal (props (id "rt-sheet-date")) addDialog.targetDate))))
        def textValue@(mutable):string addDialog.inputText
        if ((strlen textValue) == 0) {
            textValue = "—"
        }
        sheet.addChild((tree Rt
            (SheetRow
                (SheetCap "Harjoitus")
                (Spacer)
                (SheetVal (props (id "rt-sheet-text")) textValue))))
        if ((strlen addDialog.error) > 0) {
            sheet.addChild((tree Rt (SheetErr addDialog.error)))
        }
        def actions (tree Rt (SheetRow (props (className "rt-sheet-row rt-sheet-actions"))))
        if (addDialog.state == "saving") {
            actions.addChild((tree Rt
                (SheetBtn (props (id "rt-sheet-cancel") (a11yLabel "Peruuta"))
                          (SheetBtnTx "Peruuta"))))
            actions.addChild((tree Rt (Spacer)))
            actions.addChild((tree Rt (SheetVal (props (id "rt-sheet-state")) "Tallennetaan…")))
        } {
            actions.addChild((tree Rt
                (SheetBtn (props (id "rt-sheet-cancel") (a11yLabel "Peruuta"))
                          (SheetBtnTx "Peruuta"))))
            actions.addChild((tree Rt
                (SheetBtn (props (id "rt-sheet-type") (a11yLabel "Kirjoita esimerkkirivi"))
                          (SheetBtnTx "Kirjoita rivi"))))
            actions.addChild((tree Rt (Spacer)))
            actions.addChild((tree Rt
                (SheetBtn (props (id "rt-sheet-save") (className "rt-sheet-btn rt-sheet-primary")
                                 (a11yLabel "Tallenna harjoitus"))
                          (SheetBtnTx "Tallenna"))))
        }
        sheet.addChild(actions)
        return sheet
    }

    ; --- the plan-week dialog ---------------------------------------------------
    ; Six states, one sheet: what is on it is decided by `plan.state()` and the
    ; context behind it, and a press sends an event and redraws. The dialog
    ; never keeps a value of its own.
    fn planSheet:EVGElement () {
        def st:string (plan.state())
        def sheet (tree Rt (PlanSheet))
        def title@(mutable):string "Suunnittele viikko"
        if (st == "confirmation") { title = "Vahvista korvattavat päivät" }
        if (st == "creating") { title = "Luodaan suunnitelmaa" }
        if (st == "editInstructions") { title = "Muokkaa ohjeita" }
        if (st == "regenerating") { title = "Luodaan uudelleen" }
        sheet.addChild((tree Rt (PlanHd title)))

        if (st == "weekSelection") {
            this.planWeekRows(sheet)
        }
        if (st == "confirmation") {
            this.planConfirmRows(sheet)
        }
        if (st == "editInstructions") {
            this.planEditRows(sheet)
        }
        if (st == "creating") {
            sheet.addChild((tree Rt (SheetRow (SheetVal (props (id "rt-plan-state")) "Luodaan suunnitelmaa…"))))
        }
        if (st == "regenerating") {
            sheet.addChild((tree Rt (SheetRow (SheetVal (props (id "rt-plan-state")) "Luodaan ohjeiden mukaan uudelleen…"))))
        }
        def err:string (plan.text("error"))
        if ((strlen err) > 0) {
            sheet.addChild((tree Rt (PlanErr err)))
        }

        def actions (tree Rt (SheetRow (props (className "rt-sheet-row rt-sheet-actions"))))
        actions.addChild((this.sheetBtn("rt-plan-cancel" "Peruuta" "Peruuta" false)))
        if (st == "weekSelection") {
            actions.addChild((this.sheetBtn("rt-plan-edit" "Muokkaa ohjeita" "Muokkaa ohjeita" false)))
            actions.addChild((tree Rt (Spacer)))
            actions.addChild((this.sheetBtn("rt-plan-confirm" "Jatka" "Jatka" true)))
        }
        if (st == "confirmation") {
            actions.addChild((tree Rt (Spacer)))
            actions.addChild((this.sheetBtn("rt-plan-create" "Luo suunnitelma" "Luo suunnitelma" true)))
        }
        if (st == "editInstructions") {
            actions.addChild((this.sheetBtn("rt-plan-reverse" "Käännä päivien järjestys" "Käännä järjestys" false)))
            actions.addChild((tree Rt (Spacer)))
            actions.addChild((this.sheetBtn("rt-plan-regen" "Luo uudelleen" "Luo uudelleen" true)))
        }
        sheet.addChild(actions)
        return sheet
    }

    fn sheetBtn:EVGElement (id:string label:string text:string primary:boolean) {
        def b (tree Rt (SheetBtn (SheetBtnTx text)))
        b.id = id
        b.a11yLabel = label
        if primary {
            b.className = "rt-sheet-btn rt-sheet-primary"
        }
        return b
    }

    fn planWeekRows:void (sheet:EVGElement) {
        def week (tree Rt (SheetRow (SheetCap "Viikko")))
        week.addChild((this.sheetBtn("rt-plan-prev" "Edellinen viikko" "◀" false)))
        week.addChild((tree Rt (SheetVal (props (id "rt-plan-week")) (plan.text("targetWeekStart")))))
        week.addChild((this.sheetBtn("rt-plan-next" "Seuraava viikko" "▶" false)))
        sheet.addChild(week)
        weekType.value = (plan.text("weekType"))
        this.dress(weekType)
        def kind (tree Rt (SheetRow (SheetCap "Tyyppi")))
        kind.addChild((unwrap weekType.rootEl))
        sheet.addChild(kind)
        if (plan.flag("showInstructionsField")) {
            def instr@(mutable):string (plan.text("createInstructions"))
            if ((strlen instr) == 0) {
                instr = "—"
            }
            def row (tree Rt (SheetRow (SheetCap "Ohjeet")))
            row.addChild((tree Rt (SheetVal (props (id "rt-plan-instr-val")) instr)))
            row.addChild((tree Rt (Spacer)))
            row.addChild((this.sheetBtn("rt-plan-instr" "Kirjoita esimerkkiohje" "Kirjoita ohje" false)))
            sheet.addChild(row)
        }
    }

    ; The days of the chosen week, Monday first; the calendar's entries are
    ; the ones the machine's named action selected for replacement.
    fn planConfirmRows:void (sheet:EVGElement) {
        sheet.addChild((tree Rt (SheetRow (SheetCap "Viikko") (Spacer)
            (SheetVal (props (id "rt-plan-week")) (plan.text("targetWeekStart"))))))
        def days (tree Rt (PlanDays))
        def i:int 0
        while (i < 7) {
            def wd:int ((i + 1) % 7)
            def ctl:CheckboxCtl (itemAt replaceDay wd)
            ctl.checkState = 0
            if (plan.flagIn("replaceSelectedByDay" wd)) {
                ctl.checkState = 1
            }
            this.dress(ctl)
            def box:EVGElement (unwrap ctl.rootEl)
            box.setAttribute("width" "220px")
            def row (tree Rt (PlanDay))
            row.addChild(box)
            days.addChild(row)
            i = (i + 1)
        }
        sheet.addChild(days)
        sheet.addChild((tree Rt (SheetRow (SheetVal (props (id "rt-plan-fetched"))
            ((to_string (plan.fetchedCount())) + " merkintää viikolla")))))
    }

    ; The edit sheet: general feedback, then the days in the machine's order,
    ; each with its instruction and its two switches.
    fn planEditRows:void (sheet:EVGElement) {
        def fb@(mutable):string (plan.text("editGeneralFeedback"))
        if ((strlen fb) == 0) {
            fb = "—"
        }
        def row (tree Rt (SheetRow (SheetCap "Palaute")))
        row.addChild((tree Rt (SheetVal (props (id "rt-plan-feedback-val")) fb)))
        row.addChild((tree Rt (Spacer)))
        row.addChild((this.sheetBtn("rt-plan-feedback" "Kirjoita esimerkkipalaute" "Kirjoita palaute" false)))
        sheet.addChild(row)
        def days (tree Rt (PlanDays))
        def order:[int] (plan.dayOrder())
        for order d:int i {
            def kc:CheckboxCtl (itemAt keepDay d)
            kc.checkState = 0
            if (plan.flagIn("keepSameByDay" d)) {
                kc.checkState = 1
            }
            this.dress(kc)
            def sc:CheckboxCtl (itemAt showDay d)
            sc.checkState = 0
            if (plan.flagIn("showPreviousByDay" d)) {
                sc.checkState = 1
            }
            this.dress(sc)
            def line (tree Rt (PlanDay (PlanDayName (PlanDialogHost.dayName(((d + 1) % 7))))))
            def note@(mutable):string (plan.textIn("editDayInstructions" d))
            if ((strlen note) > 0) {
                line.addChild((tree Rt (PlanDayNote note)))
            }
            line.addChild((tree Rt (Spacer)))
            line.addChild((this.sheetBtn(("rt-plan-instr-" + (to_string d)) ("Ohje: " + (PlanDialogHost.dayName(((d + 1) % 7)))) "Ohje" false)))
            def keepBox:EVGElement (unwrap kc.rootEl)
            keepBox.setAttribute("width" "230px")
            line.addChild(keepBox)
            def showBox:EVGElement (unwrap sc.rootEl)
            showBox.setAttribute("width" "230px")
            line.addChild(showBox)
            days.addChild(line)
        }
        sheet.addChild(days)
    }

    ; The plan dialog's presses. It is modal in the same sense the add sheet
    ; is: answered before the screen under it.
    fn pressPlan:boolean (id:string) {
        if (id == "rt-plan") {
            if (scene != "dashboard") {
                return false
            }
            return (plan.open(true "cal-1"))
        }
        if ((plan.isOpen()) == false) {
            return false
        }
        if (id == "rt-plan-cancel") { return (plan.close()) }
        if (id == "rt-plan-prev") { return (plan.shiftWeek(-1)) }
        if (id == "rt-plan-next") { return (plan.shiftWeek(1)) }
        if (RealTrainerDemo.owns((weekType.tids()) id)) {
            weekType.activate(id)
            return (plan.setWeekType(weekType.value))
        }
        if (id == "rt-plan-instr") { return (plan.setInstructions("Kevyt viikko, painotus tekniikkaan")) }
        if (id == "rt-plan-edit") { return (plan.openEdit()) }
        if (id == "rt-plan-confirm") { return (plan.confirmWeek()) }
        if (id == "rt-plan-create") {
            def started:boolean (plan.confirmReplacement())
            if started {
                planJob.failNext = backend.failNext
                planJob.begin("plan")
            }
            return started
        }
        if (id == "rt-plan-feedback") { return (plan.setFeedback("Enemmän vetoja, vähemmän juoksua")) }
        if (id == "rt-plan-reverse") { return (plan.reverseDays()) }
        if (id == "rt-plan-regen") {
            def regen:boolean (plan.startRegenerating())
            if regen {
                planJob.failNext = backend.failNext
                planJob.begin("regenerate")
            }
            return regen
        }
        def day:int (RealTrainerDemo.dayOf(id "rt-plan-day-"))
        if (day >= 0) {
            return (plan.setReplace(day ((plan.flagIn("replaceSelectedByDay" day)) == false)))
        }
        def keep:int (RealTrainerDemo.dayOf(id "rt-plan-keep-"))
        if (keep >= 0) {
            return (plan.setKeep(keep ((plan.flagIn("keepSameByDay" keep)) == false)))
        }
        def show:int (RealTrainerDemo.dayOf(id "rt-plan-show-"))
        if (show >= 0) {
            return (plan.setShowPrevious(show ((plan.flagIn("showPreviousByDay" show)) == false)))
        }
        def instr:int (RealTrainerDemo.dayOf(id "rt-plan-instr-"))
        if (instr >= 0) {
            return (plan.setDayInstructions(instr "Pitkä juoksu, rauhallinen"))
        }
        return false
    }

    ; "rt-plan-day-3" → 3, or -1 when the id is not one of that family.
    sfn dayOf:int (id:string prefix:string) {
        def plen:int (strlen prefix)
        if ((strlen id) != (plen + 1)) {
            return -1
        }
        if ((substring id 0 plen) != prefix) {
            return -1
        }
        def ch:int (charAt id plen)
        if (ch < 48) { return -1 }
        if (ch > 54) { return -1 }
        return (ch - 48)
    }

    ; --- scene six: the conversation -------------------------------------------
    ; The machine's state decides what is on the screen: a composer in idle,
    ; the reply streaming in, the actions it proposed with a verdict each, a
    ; status while they are saved, the error and its two ways out.
    fn chatScreen:EVGElement () {
        def st:string (chat.state())
        def main (tree Rt (Main (props (className "rt-main rt-main-chat"))))
        main.addChild((tree Rt
            (Top
                (Title "Valmentaja")
                (Spacer)
                (Note (("tila: " + st))))))

        def log (tree Rt (ChatLog))
        for chat.sentTexts sent:string i {
            log.addChild((tree Rt (ChatUser (ChatTx sent))))
            if (i < (array_length chat.replies)) {
                def reply:string (itemAt chat.replies i)
                log.addChild((tree Rt (ChatBot (ChatTx reply))))
            }
        }
        if (chat.inside("sending")) {
            def streaming@(mutable):string (chat.text("streamingContent"))
            if ((strlen streaming) == 0) {
                streaming = "…"
            }
            log.addChild((tree Rt (ChatStream (ChatTx streaming))))
        }
        main.addChild(log)

        def box (tree Rt (ChatBox))
        if (st == "idle") {
            def val@(mutable):string (chat.text("inputText"))
            if ((strlen val) == 0) {
                val = "—"
            }
            def row (tree Rt (SheetRow (SheetCap "Viesti")))
            row.addChild((tree Rt (SheetVal (props (id "rt-chat-input")) val)))
            if (chat.hasImage()) {
                row.addChild((tree Rt (SheetVal (props (id "rt-chat-image")) ("📷 " + (chat.text("image"))))))
            }
            box.addChild(row)
            def actions (tree Rt (SheetRow (props (className "rt-sheet-row rt-sheet-actions"))))
            actions.addChild((this.sheetBtn("rt-chat-type" "Kirjoita liike" "Kirjoita liike" false)))
            actions.addChild((this.sheetBtn("rt-chat-type2" "Kirjoita kaksi liikettä" "Kaksi liikettä" false)))
            actions.addChild((this.sheetBtn("rt-chat-ask" "Kirjoita kysymys" "Kysy" false)))
            if (chat.hasImage()) {
                actions.addChild((this.sheetBtn("rt-chat-clear-image" "Poista kuva" "Poista kuva" false)))
            } {
                actions.addChild((this.sheetBtn("rt-chat-image" "Lisää kuva" "Lisää kuva" false)))
            }
            actions.addChild((tree Rt (Spacer)))
            actions.addChild((this.sheetBtn("rt-chat-send" "Lähetä" "Lähetä" true)))
            box.addChild(actions)
        }
        if (chat.inside("sending")) {
            def actions2 (tree Rt (SheetRow (props (className "rt-sheet-row rt-sheet-actions"))))
            actions2.addChild((tree Rt (SheetVal (props (id "rt-chat-state")) "Valmentaja vastaa…")))
            actions2.addChild((tree Rt (Spacer)))
            actions2.addChild((this.sheetBtn("rt-chat-cancel" "Peruuta" "Peruuta" false)))
            box.addChild(actions2)
        }
        if (chat.inside("reviewing")) {
            this.chatReviewRows(box (st == "reviewing.multiAction"))
        }
        if (chat.inside("processing")) {
            box.addChild((tree Rt (SheetRow (SheetVal (props (id "rt-chat-state")) "Tallennetaan päiväkirjaan…"))))
        }
        if (st == "error") {
            box.addChild((tree Rt (SheetErr (props (id "rt-chat-err")) (chat.text("error")))))
            def actions3 (tree Rt (SheetRow (props (className "rt-sheet-row rt-sheet-actions"))))
            actions3.addChild((this.sheetBtn("rt-chat-cancel" "Peruuta" "Peruuta" false)))
            actions3.addChild((tree Rt (Spacer)))
            actions3.addChild((this.sheetBtn("rt-chat-retry" "Yritä uudelleen" "Yritä uudelleen" true)))
            box.addChild(actions3)
        }
        def foot (tree Rt (SheetRow (props (className "rt-sheet-row rt-sheet-actions"))))
        foot.addChild((tree Rt (Spacer)))
        foot.addChild((this.sheetBtn("rt-chat-reset" "Aloita alusta" "Aloita alusta" false)))
        box.addChild(foot)
        main.addChild(box)

        return (tree Rt
            (Page (props (id "rt-page") (className "rt-page rt-page-dash"))
                (App
                    (child (this.rail()))
                    (child main))))
    }

    ; The proposed actions. One proposes a verdict on the whole; several take
    ; a verdict each, and closing the review saves whatever was accepted.
    fn chatReviewRows:void (box:EVGElement multi:boolean) {
        def acts (tree Rt (ChatActs))
        def n:int (chat.actionCount())
        def i@(mutable):int 0
        while (i < n) {
            def row (tree Rt (ChatAct))
            row.addChild((tree Rt (ChatActTx (((chat.actionField(i "kind")) + " · ") + (chat.actionField(i "id"))))))
            def status:string (chat.actionStatus(i))
            def word@(mutable):string "odottaa"
            if (status == "accepted") { word = "hyväksytty" }
            if (status == "rejected") { word = "hylätty" }
            row.addChild((tree Rt (ChatActSt word)))
            row.addChild((tree Rt (Spacer)))
            if ((strlen status) == 0) {
                row.addChild((this.sheetBtn(("rt-chat-accept-" + (to_string i)) ("Hyväksy " + (to_string (i + 1))) "Hyväksy" true)))
                row.addChild((this.sheetBtn(("rt-chat-reject-" + (to_string i)) ("Hylkää " + (to_string (i + 1))) "Hylkää" false)))
            }
            acts.addChild(row)
            i = (i + 1)
        }
        box.addChild(acts)
        def actions (tree Rt (SheetRow (props (className "rt-sheet-row rt-sheet-actions"))))
        actions.addChild((this.sheetBtn("rt-chat-close" "Sulje tarkistus" "Sulje" false)))
        if multi {
            actions.addChild((this.sheetBtn("rt-chat-reject-all" "Hylkää kaikki" "Hylkää kaikki" false)))
            actions.addChild((tree Rt (Spacer)))
            actions.addChild((this.sheetBtn("rt-chat-accept-all" "Hyväksy kaikki" "Hyväksy kaikki" true)))
        }
        box.addChild(actions)
    }

    fn pressChat:boolean (id:string) {
        if (id == "rt-chat-type") { return (chat.setInput("Maastaveto 3x5@100kg")) }
        if (id == "rt-chat-type2") { return (chat.setInput("Maastaveto 3x5@100kg ja kyykky 5x5@80kg")) }
        if (id == "rt-chat-ask") { return (chat.setInput("Montako harjoitusta viime viikolla?")) }
        if (id == "rt-chat-image") { return (chat.setImage("lautanen.jpg")) }
        if (id == "rt-chat-clear-image") { return (chat.clearImage()) }
        if (id == "rt-chat-send") {
            def prompt:string (chat.text("inputText"))
            def sent:boolean (chat.sendMessage())
            if sent {
                ; The switch says the NEXT thing fails, and this is it.
                chatSim.failNext = backend.failNext
                backend.failNext = false
                chatSim.begin(prompt)
            }
            return sent
        }
        if (id == "rt-chat-cancel") {
            def ok:boolean (chat.cancel())
            if ok {
                chatSim.stop()
            }
            return ok
        }
        if (id == "rt-chat-retry") {
            def again:boolean (chat.retry())
            if again {
                chatSim.failNext = backend.failNext
                backend.failNext = false
                def last@(mutable):string ""
                if ((array_length chat.sentTexts) > 0) {
                    last = (itemAt chat.sentTexts ((array_length chat.sentTexts) - 1))
                }
                chatSim.begin(last)
            }
            return again
        }
        if (id == "rt-chat-accept-all") { return (this.chatThenSave((chat.acceptAll()))) }
        if (id == "rt-chat-reject-all") { return (chat.rejectAll()) }
        if (id == "rt-chat-close") { return (this.chatThenSave((chat.closeReview()))) }
        if (id == "rt-chat-reset") {
            chatSim.stop()
            return (chat.reset())
        }
        def acc:int (RealTrainerDemo.dayOf(id "rt-chat-accept-"))
        if (acc >= 0) { return (this.chatThenSave((chat.acceptAction(acc)))) }
        def rej:int (RealTrainerDemo.dayOf(id "rt-chat-reject-"))
        if (rej >= 0) { return (chat.rejectAction(rej)) }
        return false
    }

    ; An accept may have moved the machine into `processing`; if it did, the
    ; save it is waiting for is started.
    fn chatThenSave:boolean (moved:boolean) {
        if moved {
            if (chat.inside("processing")) {
                chatJob.begin("chat")
            }
        }
        return moved
    }

    fn document:EVGElement () {
        def main (tree Rt (Main (props (className "rt-main rt-main-doc"))))
        main.addChild((tree Rt
            (Top
                (Title workTitle)
                (Spacer)
                (AddBtn (AddTx "＋  Lisää harjoitus"))
                (Note ((to_string (array_length rows)) + " riviä")))))
        if (addDialog.isOpen()) {
            main.addChild((this.addSheet()))
        }
        def list (tree Rt (DocList))
        for rows r:CompactRow i {
            list.addChild((this.documentRow(r i)))
        }
        def view (tree Rt (DocView))
        view.setAttribute("overflow" "hidden")
        view.scrollTop = docScroll
        view.addChild(list)
        main.addChild(view)
        return (tree Rt
            (Page (props (id "rt-page") (className "rt-page rt-page-dash"))
                (App
                    (child (this.rail()))
                    (child main))))
    }

    ; A wheel, a key, a drag — the host says how far and this says whether
    ; anything moved. Nothing is rebuilt: the tree is the same tree, and only
    ; the offset on its viewport changed.
    fn scrollDocument:boolean (delta:double) {
        if (scene != "document") {
            return false
        }
        def before:double docScroll
        def next@(mutable):double (docScroll + delta)
        if (next < 0.0) {
            next = 0.0
        }
        def r:EVGElement (unwrap root)
        def found@(optional):EVGElement (RealTrainerDemo.byId(r "rt-doc-view"))
        if found {
            def v:EVGElement (unwrap found)
            v.scrollTop = next
            this.laidOut()
            docScroll = v.scrollTop
        }
        return (docScroll != before)
    }

    ; --- saving ---------------------------------------------------------------
    ;
    ; The current move's line, written back from the row the steppers edited.
    ; Nothing else in the document is touched.
    fn saveCurrentMove:boolean () {
        if ((array_length rows) == 0) {
            return false
        }
        def row:CompactRow (at rows moveIndex)
        def line:string (CompactWrite.line(row))
        if ((strlen line) == 0) {
            backend.state = "failed"
            backend.message = "Tätä riviä ei voi kirjoittaa takaisin"
            return true
        }
        def d:CompactDocument (unwrap doc)
        d.replaceLine((d.lineOf(moveIndex)) line)
        backend.begin((d.text()))
        return true
    }

    fn rebuild:void () {
        if (scene == "signin") {
            root = (this.signin())
        }
        if (scene == "dashboard") {
            root = (this.dashboard())
        }
        if (scene == "session") {
            root = (this.workout())
        }
        if (scene == "document") {
            root = (this.document())
        }
        if (scene == "chat") {
            root = (this.chatScreen())
        }
        if (scene == "loading") {
            root = (this.loader())
        }
        this.writeFrame()
    }

    ; --- the clock ------------------------------------------------------------

    fn progress:double () {
        if (scene != "loading") {
            return 1.0
        }
        def p:double (elapsedMs / fillMs)
        if (p > 1.0) {
            return 1.0
        }
        return p
    }

    fn spinDeg:double () {
        def turns:double ((elapsedMs * spinDegPerSec) / 1000.0)
        while (turns >= 360.0) {
            turns = (turns - 360.0)
        }
        return turns
    }

    ; One frame of time. Always true on the loader: a loading screen that idles
    ; is a frozen one, and this one stops by changing scene rather than by
    ; running out of things to move.
    fn tick:boolean (dtMs:double) {
        ; The stream. Each chunk is an event the machine appends through its
        ; named action; the end is the reply, or the failure the switch asked
        ; for.
        if (chatSim.tick(dtMs)) {
            for chatSim.dueChunks c:string i {
                chat.chunk(c)
            }
            if (chatSim.produced == "complete") {
                chat.complete(chatSim.reply chatSim.kinds chatSim.ids)
            }
            if (chatSim.produced == "error") {
                chat.streamError("Yhteys valmentajaan katkesi")
            }
            this.rebuild()
            return true
        }
        if (chatJob.tick(dtMs)) {
            chat.saveComplete()
            chatJob.clear()
            this.rebuild()
            return true
        }
        if (planJob.tick(dtMs)) {
            ; The job the plan dialog started is the job that answers it.
            plan.complete((planJob.state == "saved") "Suunnitelman luonti epäonnistui — yritä uudelleen")
            planJob.clear()
            this.rebuild()
            return true
        }
        if (backend.tick(dtMs)) {
            ; The save that the dialog started is the save that answers it.
            if (addDialog.state == "saving") {
                if (backend.state == "saved") {
                    addDialog.send("SAVE_COMPLETE" "")
                } {
                    addDialog.send("ERROR" backend.message)
                }
            }
            this.rebuild()
            return true
        }
        def r:EVGElement (unwrap root)
        def t:EVGTransition transitions
        t.advanceTree(r dtMs)
        if (scene == "session") {
            if timerRunning {
                timerLeftMs = (timerLeftMs - dtMs)
                if (timerLeftMs <= 0.0) {
                    timerLeftMs = 0.0
                    timerRunning = false
                }
                this.writeDial()
                return true
            }
            return (t.busy(r))
        }
        if (scene != "loading") {
            ; Nothing on the later scenes moves by itself; a hover does, and
            ; the transition engine is what says whether one is in flight.
            return (t.busy(r))
        }
        elapsedMs = (elapsedMs + dtMs)
        if (elapsedMs >= (fillMs + holdMs)) {
            this.setScene("signin")
            return true
        }
        this.writeFrame()
        return true
    }

    fn setScene:void (name:string) {
        if (name == scene) {
            return
        }
        scene = name
        docScroll = 0.0
        elapsedMs = 0.0
        hovered = ""
        pressed = ""
        this.rebuild()
    }

    fn sceneName:string () {
        return scene
    }

    ; The scene, as a THEME. `EVGStyleSheet` matches one class token per
    ; selector, so two `ProgressCtl`s in one app cannot be told apart by where
    ; they sit — `.a .b` is not a selector it has. A theme is: the session
    ; scene asks for "session" and the rules scoped to it apply, and every
    ; other scene asks for "" and they do not.
    fn themeName:string () {
        if (scene == "session") {
            return "session"
        }
        return ""
    }

    ; --- what changes every frame ---------------------------------------------
    ;
    ; The bar's value goes to the CONTROLLER, which owns the percentage and the
    ; number a reader is given; the ring's angle is written onto the element,
    ; marked inline so the cascade leaves it alone — without that the
    ; stylesheet would put the rotation back to 0 on the next pass, which is a
    ; ring that never turns.
    fn writeFrame:void () {
        if (scene != "loading") {
            return
        }
        def r:EVGElement (unwrap root)
        def p:double (this.progress())
        bar.value = (int2double (to_int ((p * 100.0) + 0.5)))
        this.dress(bar)
        def ring@(optional):EVGElement (RealTrainerDemo.byId(r "rt-ring"))
        if ring {
            def g:EVGElement (unwrap ring)
            g.setAttribute("transform" (("rotate(" + (to_string (this.spinDeg()))) + "deg)"))
            g.markInline("transform")
        }
        def pct@(optional):EVGElement (RealTrainerDemo.byId(r "rt-pct"))
        if pct {
            def e:EVGElement (unwrap pct)
            e.textContent = ((to_string bar.value) + " %")
        }
        def cap@(optional):EVGElement (RealTrainerDemo.byId(r "rt-caption"))
        if cap {
            def c:EVGElement (unwrap cap)
            c.textContent = (RealTrainerDemo.captionAt(p))
        }
    }

    ; The dial, per frame. Sixty ticks, and the lit ones are however many
    ; sixtieths of the rest are still to run — the arithmetic is here and the
    ; ticks themselves know nothing, which is what makes them sixty copies of
    ; one rule in the stylesheet instead of sixty rules.
    fn writeDial:void () {
        def r:EVGElement (unwrap root)
        def left:double 0.0
        if (timerFullMs > 0.0) {
            left = (timerLeftMs / timerFullMs)
        }
        def lit:int (to_int ((left * 60.0) + 0.999))
        def d@(optional):EVGElement (RealTrainerDemo.byId(r "rt-dial"))
        if d {
            def dial:EVGElement (unwrap d)
            def i:int 0
            while (i < (array_length dial.children)) {
                def tick:EVGElement (itemAt dial.children i)
                if (i < 60) {
                    def cls:string "rt-tick"
                    if (i < lit) {
                        cls = "rt-tick rt-tick-on"
                    }
                    tick.className = cls
                }
                i = (i + 1)
            }
        }
        def n@(optional):EVGElement (RealTrainerDemo.byId(r "rt-dial-num"))
        if n {
            def num:EVGElement (unwrap n)
            num.textContent = (to_string (to_int ((timerLeftMs / 1000.0) + 0.999)))
        }
        def c@(optional):EVGElement (RealTrainerDemo.byId(r "rt-dial-cap"))
        if c {
            def cap:EVGElement (unwrap c)
            if timerRunning {
                cap.textContent = "Sarja 1 / 3"
            } {
                if (timerLeftMs <= 0.0) {
                    cap.textContent = "Tauko ohi — jatka!"
                } {
                    cap.textContent = "Tauko pysäytetty"
                }
            }
        }
    }

    ; What a loading screen says while it waits. Three lines rather than one,
    ; because a caption that never changes is a caption nobody reads twice —
    ; and because the app it is copied from names what it is doing.
    sfn captionAt:string (p:double) {
        if (p >= 1.0) {
            return "Valmista!"
        }
        if (p >= 0.62) {
            return "Käyn läpi harjoitustietoja..."
        }
        if (p >= 0.3) {
            return "Haen suunnitelmaa..."
        }
        return "Ladataan..."
    }

    ; Is this one of the ids a controller answers for?
    sfn owns:boolean (tids:[string] id:string) {
        def i:int 0
        while (i < (array_length tids)) {
            if ((itemAt tids i) == id) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn byId@(optional):EVGElement (el:EVGElement id:string) {
        if (el.id == id) {
            def selfHit@(optional):EVGElement el
            return selfHit
        }
        def i:int 0
        while (i < (array_length el.children)) {
            def kid:EVGElement (itemAt el.children i)
            def found@(optional):EVGElement (RealTrainerDemo.byId(kid id))
            if found {
                return found
            }
            i = (i + 1)
        }
        def __missing@(optional):EVGElement
        return __missing
    }

    ; --- the pointer ----------------------------------------------------------

    fn setHover:void (id:string) {
        hovered = id
    }

    fn setPressed:void (id:string) {
        pressed = id
    }

    ; A press, routed to whoever owns that id. Returns whether anything changed,
    ; so the host knows whether to paint.
    ;
    ; The controllers are asked FIRST and by name, because they answer for their
    ; own ids and nothing else: `activate` on a target that is not theirs
    ; returns without doing anything, which is what makes this a list rather
    ; than a decision.
    fn press:boolean (id:string) {
        if (id == "") {
            return false
        }
        ; The rail is drawn on three screens, so it is answered before any of
        ; them. It used to live inside the dashboard's branch, which is why its
        ; buttons did nothing while a session was open — a navigation you can
        ; only use from one page is not one.
        if (this.pressSheet(id)) {
            this.rebuild()
            return true
        }
        if (this.pressPlan(id)) {
            this.rebuild()
            return true
        }
        if (scene == "chat") {
            if (this.pressChat(id)) {
                this.rebuild()
                return true
            }
        }
        if (this.pressRail(id)) {
            return true
        }
        if (scene == "signin") {
            if (id == "rt-google") {
                this.setScene("dashboard")
                return true
            }
            def before:string ((remember.stateWord()) + (tips.stateWord()))
            remember.activate(id)
            tips.activate(id)
            if (((remember.stateWord()) + (tips.stateWord())) != before) {
                this.dress(remember)
                this.dress(tips)
                return true
            }
            return false
        }
        if (scene == "dashboard") {
            ; A TAB PRESS ALWAYS REFILLS, EVEN WHEN IT CHANGES NOTHING.
            ;
            ; `activate` calls the controller's own `build()`, which clears
            ; every panel — that is what a controller that owns its subtree
            ; does. So pressing the tab that is ALREADY on emptied the
            ; dashboard: the value had not changed, this refilled nothing, and
            ; the page went blank under a tab strip that looked right.
            ;
            ; The rule that falls out: a press that reached a controller is a
            ; press that rebuilt it, and anything the app put inside has to go
            ; back afterwards.
            if (RealTrainerDemo.owns((tabs.tids()) id)) {
                tabs.activate(id)
                this.dress(tabs)
                this.fillActivePanel()
                return true
            }
            def wasOpen:string plans.openValue
            plans.activate(id)
            if (plans.openValue != wasOpen) {
                this.dress(plans)
                return true
            }
            if (id == sportOnly.tid) {
                sportOnly.activate(id)
                this.refreshDash()
                return true
            }
            def i:int 0
            while (i < (array_length goals.columns)) {
                def col:UiColumn (itemAt goals.columns i)
                if (id == (goals.colTid(col.key))) {
                    goals.toggleSort(col.key)
                    this.refreshDash()
                    return true
                }
                i = (i + 1)
            }
            return false
        }
        if (scene == "session") {
            return (this.pressSession(id))
        }
        ; On the loader there is nothing to press but the loader itself, and a
        ; press there is worth something: it skips the wait.
        ;
        ; The scene test is not decoration: this used to be the fall-through
        ; for EVERY scene, so once the document screen existed, an id nothing
        ; had handled came back as handled and the host redrew for nothing.
        if (scene == "loading") {
            elapsedMs = (fillMs + holdMs)
            return true
        }
        return false
    }

    ; The session screen's own presses. Steppers write numbers, the radio group
    ; answers for the rest chips, and the two big buttons move between the card
    ; and the dial.
    ; The dialog answers before the screen under it, which is what a modal is.
    fn pressSheet:boolean (id:string) {
        if (id == "rt-add") {
            addDialog.today = "2026-02-09"
            return (addDialog.open("2026-02-09" "cal-1"))
        }
        if (addDialog.isOpen() == false) {
            return false
        }
        if (id == "rt-sheet-cancel") {
            return (addDialog.send("CLOSE" ""))
        }
        if (id == "rt-sheet-type") {
            return (addDialog.send("SET_INPUT_TEXT" "Exercise Maastaveto|3x5@100kg"))
        }
        if (id == "rt-sheet-save") {
            def started:boolean (addDialog.send("START_SAVING" ""))
            if (started) {
                backend.begin(addDialog.inputText)
            }
            return started
        }
        return false
    }

    fn pressRail:boolean (id:string) {
        if (scene == "signin") {
            return false
        }
        if (scene == "loading") {
            return false
        }
        if (id == "rt-rail-out") {
            this.setScene("loading")
            return true
        }
        if (id == "rt-rail-train") {
            this.setScene("session")
            return true
        }
        if (id == "rt-rail-log") {
            this.setScene("document")
            return true
        }
        if (id == "rt-rail-home") {
            this.setScene("dashboard")
            return true
        }
        if (id == "rt-rail-chat") {
            this.setScene("chat")
            return true
        }
        ; The failure switch is a debug control, and it belongs to every screen
        ; that can save rather than to the one it was first drawn on.
        if (id == "rt-fail") {
            backend.failNext = (backend.failNext == false)
            this.rebuild()
            return true
        }
        return false
    }

    fn pressSession:boolean (id:string) {
        if (id == "rt-quit") {
            this.setScene("dashboard")
            return true
        }
        if (id == "rt-start") {
            timerOn = true
            timerFullMs = (this.restMs())
            timerLeftMs = timerFullMs
            timerRunning = true
            this.rebuild()
            this.writeDial()
            return true
        }
        if (id == "rt-pause") {
            timerRunning = (timerRunning == false)
            this.writeDial()
            return true
        }
        if (id == "rt-reset") {
            timerLeftMs = timerFullMs
            timerRunning = true
            this.writeDial()
            return true
        }
        if (id == "rt-timer-done") {
            timerOn = false
            timerRunning = false
            this.rebuild()
            return true
        }
        if (id == "rt-save") {
            this.saveCurrentMove()
            this.rebuild()
            return true
        }
        if (id == "rt-fail") {
            backend.failNext = (backend.failNext == false)
            this.rebuild()
            return true
        }
        if (id == "rt-done") {
            if (doneMoves < moveCount) {
                doneMoves = (doneMoves + 1)
            }
            this.advanceMove()
            this.rebuild()
            return true
        }
        ; The steppers. Each one nudges a field of the CURRENT ROW and nothing
        ; else — the clamps live with the row, because a set count of zero is
        ; not a state the plan can hold either.
        def row:CompactRow (at rows moveIndex)
        if (id == "rt-sets-down") {
            CompactRowEdit.nudge(row "sets" -1)
            this.rebuild()
            return true
        }
        if (id == "rt-sets-up") {
            CompactRowEdit.nudge(row "sets" 1)
            this.rebuild()
            return true
        }
        if (id == "rt-reps-down") {
            CompactRowEdit.nudge(row "reps" -1)
            this.rebuild()
            return true
        }
        if (id == "rt-reps-up") {
            CompactRowEdit.nudge(row "reps" 1)
            this.rebuild()
            return true
        }
        if (id == "rt-weight-down") {
            CompactRowEdit.nudge(row "weight" -5)
            this.rebuild()
            return true
        }
        if (id == "rt-weight-up") {
            CompactRowEdit.nudge(row "weight" 5)
            this.rebuild()
            return true
        }
        def was:string rest.value
        rest.activate(id)
        if (rest.value != was) {
            this.dress(rest)
            return true
        }
        return false
    }

    ; The dashboard panel, rebuilt in place. Only the tab's own content is
    ; replaced — the tab strip, its roving focus and every other controller's
    ; state are where they were.
    fn refreshDash:void () {
        def i:int 0
        while (i < (array_length tabs.items)) {
            def it:UiItem (itemAt tabs.items i)
            if (it.value == tabs.value) {
                def panel:EVGElement (unwrap it.contentEl)
                clear panel.children
            }
            i = (i + 1)
        }
        this.fillActivePanel()
    }

    fn markStates:void (el:EVGElement) {
        el.isHovered = false
        el.isPressed = false
        if ((strlen el.id) > 0) {
            if (el.id == hovered) {
                el.isHovered = true
            }
            if (el.id == pressed) {
                el.isPressed = true
            }
        }
        def i:int 0
        while (i < (array_length el.children)) {
            def kid:EVGElement (itemAt el.children i)
            this.markStates(kid)
            i = (i + 1)
        }
    }

    ; --- the three questions a host asks --------------------------------------

    fn laidOut:EVGLayout () {
        def r:EVGElement (unwrap root)
        def s:EVGStyleSheet (unwrap sheet)
        s.setViewport(pageW pageH false)
        this.markStates(r)
        s.applyTree(r (this.themeName()))
        def t:EVGTransition transitions
        t.reconcileTree(r)
        ; No `layoutClean()` shortcut, and deliberately: the ring's rotation and
        ; the bar's width are written straight onto elements, so the sheet does
        ; not know anything moved and would report the frame clean. The page is
        ; a hundred elements.
        if layout {
            def lay:EVGLayout (unwrap layout)
            lay.layout(r)
            return lay
        }
        def fresh (new EVGLayout())
        fresh.setPageSize(pageW pageH)
        layout = fresh
        fresh.layout(r)
        return fresh
    }

    fn displayListJson:string () {
        def lay:EVGLayout (this.laidOut())
        def r:EVGElement (unwrap root)
        def dl (new EVGDisplayList())
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(r)
        return (dl.toJson())
    }

    fn hitId:string (px:double py:double) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def hit (new EVGHitTest())
        return (hit.idAt(r px py))
    }

    fn a11yJson:string (generation:int focusId:string) {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "RealTrainer" generation focusId))
        return (t.toJson())
    }

    fn a11yProblems:[string] () {
        this.laidOut()
        def r:EVGElement (unwrap root)
        def b (new EVGA11yFromTree())
        def t:EVGA11yTree (b.build(r "RealTrainer" 1 ""))
        return (t.lint())
    }

    fn styleErrorCount:int () {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getErrorCount())
    }

    fn styleErrorAt:string (i:int) {
        def s:EVGStyleSheet (unwrap sheet)
        return (s.getError(i))
    }

    fn widthPx:double () {
        return pageW
    }

    fn heightPx:double () {
        return pageH
    }

    ; A flat dump of the tree, so a test can assert on the shape with no
    ; browser and no picture.
    sfn describe:string (el:EVGElement depth:int) {
        def pad:string ""
        def i:int 0
        while (i < depth) {
            pad = pad + "  "
            i = (i + 1)
        }
        def line:string (pad + el.className)
        if ((strlen el.textContent) > 0) {
            line = ((line + " ") + el.textContent)
        }
        def out:string (line + "\n")
        def j:int 0
        while (j < (array_length el.children)) {
            out = out + (RealTrainerDemo.describe((itemAt el.children j) (depth + 1)))
            j = (j + 1)
        }
        return out
    }

    sfn main:void () {
        def app (new RealTrainerDemo())
        app.setupControls()
        print "--- the loader ---"
        print (RealTrainerDemo.describe((app.loader()) 0))
        print "--- the sign-in page ---"
        print (RealTrainerDemo.describe((app.signin()) 0))
        print "--- the dashboard ---"
        print (RealTrainerDemo.describe((app.dashboard()) 0))
    }
}

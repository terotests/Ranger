
Import "CompactWalkDates.rgr"
Import "CompactWalkItem.rgr"
Import "CompactWalkParse.rgr"
Import "CompactWalkTypes.rgr"

; Walk COMPACT text lines and extract stats-relevant items (line parser, not full PEG).
class CompactWalk {

  sfn walkCompact:[CompactWalkItem] (compact:string fallbackDate:string) {
    def items:[CompactWalkItem]
    def lines:[string] (strsplit compact "\n")
    def currentDate:string fallbackDate
    if ((strlen currentDate) == 0) {
      currentDate = (CompactWalkDates.extractDateFromCompact(compact))
    }
    def pendingName:string ""
    def pendingDuration:int 0
    def pendingDistance:double 0.0
    def i:int 0
    while (i < (size lines)) {
      def line:string (trim (at lines i))
      if ((strlen line) > 0) {
        if ((CompactWalkDates.looksLikeIsoDateAt(line 0))) {
          if ((strlen pendingName) > 0) {
            def flushed:CompactWalkItem (CompactWalkParse.makeItem("move" pendingName currentDate))
            flushed.durationSeconds = pendingDuration
            flushed.distanceMeters = pendingDistance
            push items flushed
            pendingName = ""
            pendingDuration = 0
            pendingDistance = 0.0
          }
          currentDate = (substring line 1 11)
        } {
          if ((indexOf line "##") == 0) {
            i = i + 1
            continue
          }
          def ex@(optional):CompactWalkItem (CompactWalkParse.parseExerciseLine(line currentDate))
          if (!null? ex) {
            if ((strlen pendingName) > 0) {
              def flushedEx:CompactWalkItem (CompactWalkParse.makeItem("move" pendingName currentDate))
              flushedEx.durationSeconds = pendingDuration
              flushedEx.distanceMeters = pendingDistance
              push items flushedEx
              pendingName = ""
              pendingDuration = 0
              pendingDistance = 0.0
            }
            push items (unwrap ex)
          } {
            def run:CompactRunHeader (CompactWalkParse.parseRunHeader(line))
            def isRun:boolean false
            if ((CompactWalkParse.hasPrefix(line "Run "))) {
              isRun = true
            }
            if ((CompactWalkParse.hasPrefix(line "Move "))) {
              isRun = true
            }
            if (isRun) {
              if ((strlen pendingName) > 0) {
                def flushedRun:CompactWalkItem (CompactWalkParse.makeItem("move" pendingName currentDate))
                flushedRun.durationSeconds = pendingDuration
                flushedRun.distanceMeters = pendingDistance
                push items flushedRun
              }
              pendingName = run.name
              pendingDuration = 0
              pendingDistance = 0.0
              if (run.hasDuration) {
                pendingDuration = run.durationSeconds
              }
            } {
              def dist:double (CompactWalkParse.parseDistanceMetersFromLine(line))
              if (dist >= 0.0) {
                if ((strlen pendingName) > 0) {
                  pendingDistance = dist
                  def flushedDist:CompactWalkItem (CompactWalkParse.makeItem("move" pendingName currentDate))
                  flushedDist.durationSeconds = pendingDuration
                  flushedDist.distanceMeters = pendingDistance
                  push items flushedDist
                  pendingName = ""
                  pendingDuration = 0
                  pendingDistance = 0.0
                }
              } {
                def dur@(optional):CompactWalkItem (CompactWalkParse.parseDurationLine(line currentDate pendingName))
                if (!null? dur) {
                  def durItem:CompactWalkItem (unwrap dur)
                  if ((strlen pendingName) > 0) {
                    pendingDuration = durItem.durationSeconds
                  } {
                    push items durItem
                  }
                }
              }
            }
          }
        }
      }
      i = i + 1
    }
    if ((strlen pendingName) > 0) {
      def flushedEnd:CompactWalkItem (CompactWalkParse.makeItem("move" pendingName currentDate))
      flushedEnd.durationSeconds = pendingDuration
      flushedEnd.distanceMeters = pendingDistance
      push items flushedEnd
    }
    return items
  }

  sfn countKind:int (items:[CompactWalkItem] kind:string) {
    def n:int 0
    def j:int 0
    while (j < (size items)) {
      def item:CompactWalkItem (at items j)
      if (item.kind == kind) {
        n = n + 1
      }
      j = j + 1
    }
    return n
  }
}

    ; The icon a calendar type has — `typeIcons` in the wizard.
    sfn kindIcon:string (key:string color:string) {
        if (key == "training") { return (RtIcons.dumbbell(color)) }
        if (key == "plan") { return (RtIcons.clipboardList(color)) }
        if (key == "sleep") { return (RtIcons.moon(color)) }
        if (key == "nutrition") { return (RtIcons.utensils(color)) }
        if (key == "feelings") { return (RtIcons.heart(color)) }
        if (key == "competition") { return (RtIcons.trophy(color)) }
        if (key == "camp") { return (RtIcons.tent(color)) }
        if (key == "group-training") { return (RtIcons.users(color)) }
        if (key == "expenses") { return (RtIcons.wallet(color)) }
        if (key == "test-plan") { return (RtIcons.clipboardList(color)) }
        if (key == "test-log") { return (RtIcons.clipboardList(color)) }
        if (key == "measurement") { return (RtIcons.activity(color)) }
        return (RtIcons.ellipsis(color))
    }


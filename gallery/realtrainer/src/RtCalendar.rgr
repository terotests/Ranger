; =============================================================================
; RtCalendar — what the calendar screen is made of, before it is drawn
; =============================================================================
; The reference recorder seeds the Firestore emulator from
; `fixtures/reference/seed.json` — one plan calendar, its entries, a year plan
; with an example week — and drives the React app over it. This reads the SAME
; file, so what the EVG side draws for wk 7 is the same week from the same
; COMPACT, and a difference in the trace is a difference in the port.
;
; Three things live here and none of them draws:
;
;   RtSeed      the file, parsed: calendars, entries by date, periods and
;               their example weeks
;   RtWeek      the arithmetic the original does with `Date`: the Monday of a
;               week, the ISO week number, "9. – 15.2.", Ma…Su
;   RtEntry     what a day row says about an entry — title, tags, emojis —
;               read off the COMPACT lines the way `MobileWeekView` reads them
;               off the parsed workout
;   RtIcons     lucide's paths for the icons the shell uses, as SVG the EVG
;               parser draws with a stroke, so the glyphs are the originals
; =============================================================================

Import "../../vela/src/VlJson.rgr"
Import "../../ui/src/UiDate.rgr"

class RtSeedEntry {
    def id@(mutable):string ""
    def calendarId@(mutable):string ""
    def date@(mutable):string ""
    ; A date relative to today rather than stated — the app's own fixtures
    ; sit four days back and three days on from whenever it is opened.
    def hasOffset@(mutable):boolean false
    def dateOffset@(mutable):int 0
    def compact@(mutable):string ""
    ; The app's score for the entry, 0–100, or -1 without one; and the AI
    ; coach's feedback on it, when the diary carries one.
    def points@(mutable):int -1
    def feedback@(mutable):string ""

    Constructor () {
    }
}

; One calendar of the seed — and one the wizard made, once it has.
class RtSeedCalendar {
    def id@(mutable):string ""
    def name@(mutable):string ""
    def kind@(mutable):string ""
    def color@(mutable):string ""

    Constructor () {
    }
}

class RtExampleDay {
    def dayOfWeek@(mutable):int 0
    def compact@(mutable):string ""

    Constructor () {
    }
}

class RtExampleWeek {
    def weekType@(mutable):string "target"
    def description@(mutable):string ""
    def days:[RtExampleDay]

    Constructor () {
    }

    fn dayAt:string (dayOfWeek:int) {
        for days d:RtExampleDay i {
            if (d.dayOfWeek == dayOfWeek) {
                return d.compact
            }
        }
        return ""
    }
}

class RtPeriod {
    def id@(mutable):string ""
    def name@(mutable):string ""
    ; "weeks" or "days" — what `duration` counts.
    def durationUnit@(mutable):string "weeks"
    ; `type`, `duration` in weeks and `goals` — what the dashboard's period
    ; card shows beside the name.
    def kind@(mutable):string ""
    def durationWeeks@(mutable):int 0
    def goals@(mutable):string ""
    def weeks:[RtExampleWeek]

    Constructor () {
    }

    fn weekOf:RtExampleWeek (weekType:string) {
        for weeks w:RtExampleWeek i {
            if (w.weekType == weekType) {
                return w
            }
        }
        return (new RtExampleWeek)
    }

    fn hasWeek:boolean (weekType:string) {
        for weeks w:RtExampleWeek i {
            if (w.weekType == weekType) {
                return true
            }
        }
        return false
    }
}

class RtSeed {
    def loaded@(mutable):boolean false
    def week@(mutable):string ""
    ; The calendars, and the selected one's id, name and type — what the
    ; header shows and the calendar screen draws. `selectCalendar` is the
    ; store's `selectCalendar`: the three are set from the list.
    def calendars:[RtSeedCalendar]
    ; The day the sheet was made, from the seed — "Luotu" on its card.
    def sheetCreated@(mutable):string ""
    def calendarId@(mutable):string ""
    def calendarName@(mutable):string ""
    def calendarType@(mutable):string ""
    def entries:[RtSeedEntry]
    ; The first yearsheet: its name, description and start date are the
    ; dashboard's "Aktiivinen suunnitelma" card.
    def sheetId@(mutable):string ""
    def sheetName@(mutable):string ""
    def sheetDescription@(mutable):string ""
    def sheetStart@(mutable):string ""
    def periods:[RtPeriod]

    Constructor () {
    }

    fn load:void (text:string) {
        def parser (new VlJsonParser)
        def root:VlJson (parser.parse(text))
        week = (root.stringOr("week" ""))
        clear calendars
        def cals:VlJson (root.get("calendars"))
        def ci@(mutable):int 0
        while (ci < (cals.count())) {
            def c:VlJson (cals.at(ci))
            this.addCalendar((c.stringOr("id" "")) (c.stringOr("name" "")) (c.stringOr("type" "")) (c.stringOr("color" "")))
            ci = (ci + 1)
        }
        if ((array_length calendars) > 0) {
            def first:RtSeedCalendar (itemAt calendars 0)
            this.selectCalendar(first.id)
        }
        clear entries
        def es:VlJson (root.get("entries"))
        def i@(mutable):int 0
        while (i < (es.count())) {
            def e:VlJson (es.at(i))
            def entry (new RtSeedEntry)
            entry.id = (e.stringOr("id" ""))
            entry.calendarId = (e.stringOr("calendarId" ""))
            entry.date = (e.stringOr("date" ""))
            if (e.has("dateOffset")) {
                entry.hasOffset = true
                entry.dateOffset = (e.intOr("dateOffset" 0))
            }
            entry.compact = (e.stringOr("compact" ""))
            if (e.has("points")) { entry.points = (e.intOr("points" -1)) }
            entry.feedback = (e.stringOr("feedback" ""))
            push entries entry
            i = (i + 1)
        }
        clear periods
        def sheets:VlJson (root.get("yearsheets"))
        def s@(mutable):int 0
        while (s < (sheets.count())) {
            def sheet:VlJson (sheets.at(s))
            if (s == 0) {
                sheetId = (sheet.stringOr("id" ""))
                sheetName = (sheet.stringOr("name" ""))
                sheetDescription = (sheet.stringOr("description" ""))
                sheetStart = (sheet.stringOr("startDate" ""))
                sheetCreated = (substring (sheet.stringOr("createdAt" "")) 0 10)
            }
            def ps:VlJson (sheet.get("periods"))
            def p@(mutable):int 0
            while (p < (ps.count())) {
                def pj:VlJson (ps.at(p))
                def period (new RtPeriod)
                period.id = (pj.stringOr("id" ""))
                period.name = (pj.stringOr("name" ""))
                period.durationUnit = (pj.stringOr("durationUnit" "weeks"))
                period.kind = (pj.stringOr("type" ""))
                period.durationWeeks = (pj.intOr("duration" 0))
                period.goals = (pj.stringOr("goals" ""))
                def ws:VlJson (pj.get("exampleWeeks"))
                def w@(mutable):int 0
                while (w < (ws.count())) {
                    def wj:VlJson (ws.at(w))
                    def ew (new RtExampleWeek)
                    ew.weekType = (wj.stringOr("type" "target"))
                    ew.description = (wj.stringOr("description" ""))
                    def ds:VlJson (wj.get("days"))
                    def d@(mutable):int 0
                    while (d < (ds.count())) {
                        def dj:VlJson (ds.at(d))
                        def day (new RtExampleDay)
                        day.dayOfWeek = (dj.intOr("dayOfWeek" 0))
                        day.compact = (dj.stringOr("compact" ""))
                        push ew.days day
                        d = (d + 1)
                    }
                    push period.weeks ew
                    w = (w + 1)
                }
                push periods period
                p = (p + 1)
            }
            s = (s + 1)
        }
        loaded = true
    }

    ; The relative dates, anchored: the entry's date, and the date in the
    ; first line of its COMPACT, which is what `replaceCompactDate` does in
    ; the app before it writes the fixture.
    fn anchor:void (todayIso:string) {
        for entries e:RtSeedEntry i {
            if e.hasOffset {
                e.date = (RtWeek.shifted(todayIso e.dateOffset))
                if ((strlen e.compact) > 11) {
                    if ((substring e.compact 0 1) == "[") {
                        e.compact = (("[" + e.date) + (substring e.compact 11 (strlen e.compact)))
                    }
                }
            }
        }
    }

    ; An entry the app wrote: the add sheet's, on its day, in the calendar
    ; that was open.
    fn addEntry:void (id:string calendarId:string date:string compact:string) {
        def e (new RtSeedEntry)
        e.id = id
        e.calendarId = calendarId
        e.date = date
        e.compact = compact
        push entries e
    }

    fn addCalendar:void (id:string name:string kind:string color:string) {
        def c (new RtSeedCalendar)
        c.id = id
        c.name = name
        c.kind = kind
        c.color = color
        push calendars c
    }

    ; The selected calendar; an id the list does not have selects nothing.
    fn selectCalendar:boolean (id:string) {
        for calendars c:RtSeedCalendar i {
            if (c.id == id) {
                calendarId = c.id
                calendarName = c.name
                calendarType = c.kind
                return true
            }
        }
        return false
    }

    ; An entry of the selected calendar — or of any, when the file did not
    ; say whose it is.
    fn isSelected:boolean (e:RtSeedEntry) {
        if ((strlen e.calendarId) == 0) {
            return true
        }
        return (e.calendarId == calendarId)
    }

    ; The selected calendar's entries, in the order the file has them.
    ; The calendars as the app's store lists them: by id, descending — the
    ; order the selector's menu and the statistics walk them in.
    fn storeOrder:[RtSeedCalendar] () {
        def out:[RtSeedCalendar]
        for calendars c:RtSeedCalendar i {
            def placed:[RtSeedCalendar]
            def done@(mutable):boolean false
            for out o:RtSeedCalendar j {
                if ((done == false) && (RtSeed.idAfter(c.id o.id))) {
                    push placed c
                    done = true
                }
                push placed o
            }
            if (done == false) { push placed c }
            out = placed
        }
        return out
    }

    sfn idAfter:boolean (a:string b:string) {
        def n@(mutable):int (strlen a)
        if ((strlen b) < n) { n = (strlen b) }
        def i@(mutable):int 0
        while (i < n) {
            def ca:int (charAt a i)
            def cb:int (charAt b i)
            if (ca > cb) { return true }
            if (ca < cb) { return false }
            i = (i + 1)
        }
        return ((strlen a) > (strlen b))
    }

    fn selectedEntries:[RtSeedEntry] () {
        def out:[RtSeedEntry]
        for entries e:RtSeedEntry i {
            if (this.isSelected(e)) {
                push out e
            }
        }
        return out
    }

    ; The entries on one date, in the order the file has them.
    fn entriesOn:[RtSeedEntry] (iso:string) {
        def out:[RtSeedEntry]
        for entries e:RtSeedEntry i {
            if ((e.date == iso) && (this.isSelected(e))) {
                push out e
            }
        }
        return out
    }

    ; The entries whose date falls in the week that starts on `mondayIso`.
    fn entriesInWeek:[RtSeedEntry] (mondayIso:string) {
        def out:[RtSeedEntry]
        def first:int (RtWeek.daysOf(mondayIso))
        for entries e:RtSeedEntry i {
            def d:int (RtWeek.daysOf(e.date))
            if ((d >= first) && (d < (first + 7)) && (this.isSelected(e))) {
                push out e
            }
        }
        return out
    }

    fn firstPeriod:RtPeriod () {
        if ((array_length periods) > 0) {
            return (itemAt periods 0)
        }
        return (new RtPeriod)
    }
}

; -----------------------------------------------------------------------------
; The week
; -----------------------------------------------------------------------------
class RtWeek {
    Constructor () {
    }

    sfn daysOf:int (iso:string) {
        def y:int (to_int (?? (to_double (substring iso 0 4)) 0.0))
        def m:int (to_int (?? (to_double (substring iso 5 7)) 0.0))
        def d:int (to_int (?? (to_double (substring iso 8 10)) 0.0))
        return (UiDate.toDays(y m d))
    }

    sfn isoOf:string (days:int) {
        return (UiDate.isoOfDays(days))
    }

    ; The Monday on or before the date — `getWeekStart` in the original.
    sfn mondayOf:string (iso:string) {
        def days:int (RtWeek.daysOf(iso))
        def wd:int (UiDate.weekday(days))
        def back:int ((wd + 6) % 7)
        return (UiDate.isoOfDays((days - back)))
    }

    sfn shifted:string (iso:string byDays:int) {
        return (UiDate.isoOfDays(((RtWeek.daysOf(iso)) + byDays)))
    }

    sfn dayOfMonth:int (iso:string) {
        return (to_int (?? (to_double (substring iso 8 10)) 0.0))
    }

    sfn monthOf:int (iso:string) {
        return (to_int (?? (to_double (substring iso 5 7)) 0.0))
    }

    ; "5.1.2026" — the date as fi-FI writes it, no padding.
    sfn fiDate:string (iso:string) {
        return ((((to_string (RtWeek.dayOfMonth(iso))) + ".") + (to_string (RtWeek.monthOf(iso)))) + ("." + (substring iso 0 4)))
    }

    ; ISO 8601: the week that holds the Thursday. The Thursday of the week a
    ; Monday starts is three days on; its week number is one plus the number
    ; of whole weeks between it and the year's first Thursday's Monday.
    sfn isoWeekNumber:int (mondayIso:string) {
        def thursday:int ((RtWeek.daysOf(mondayIso)) + 3)
        def parts:[int] ([] _:int (0 0 0))
        UiDate.fromDays(thursday parts)
        def year:int (itemAt parts 0)
        def jan1:int (UiDate.toDays(year 1 1))
        ; The Monday of the week that holds January 1st's nearest Thursday.
        def jan1wd:int (UiDate.weekday(jan1))
        def jan1back:int ((jan1wd + 6) % 7)
        def firstMonday@(mutable):int (jan1 - jan1back)
        ; Week 1 is the week with the year's first Thursday: if January 1st is
        ; a Friday, Saturday or Sunday, that week belongs to the previous year.
        if (jan1back > 3) {
            firstMonday = (firstMonday + 7)
        }
        return ((idiv (thursday - firstMonday) 7) + 1)
    }

    ; "9. – 15.2." within one month, "26.1. – 1.2." across two — the
    ; original's `weekRange`.
    sfn rangeText:string (mondayIso:string) {
        def sunday:string (RtWeek.shifted(mondayIso 6))
        def d1:int (RtWeek.dayOfMonth(mondayIso))
        def m1:int (RtWeek.monthOf(mondayIso))
        def d2:int (RtWeek.dayOfMonth(sunday))
        def m2:int (RtWeek.monthOf(sunday))
        if (m1 == m2) {
            return (((((to_string d1) + ". – ") + (to_string d2)) + ".") + (to_string m2)) + "."
        }
        return (((((((to_string d1) + ".") + (to_string m1)) + ". – ") + (to_string d2)) + ".") + (to_string m2)) + "."
    }

    ; Monday first, as the rows are — `common.mondayShort` and on.
    sfn dayShort:string (i:int) {
        if (i == 0) { return "Ma" }
        if (i == 1) { return "Ti" }
        if (i == 2) { return "Ke" }
        if (i == 3) { return "To" }
        if (i == 4) { return "Pe" }
        if (i == 5) { return "La" }
        return "Su"
    }
}

; -----------------------------------------------------------------------------
; What a row says about an entry
; -----------------------------------------------------------------------------
class RtEntry {
    def title@(mutable):string ""
    ; "14:34" from a header with a time, or empty.
    def time@(mutable):string ""
    def tags:[string]
    def emojis@(mutable):string ""
    ; The COMPACT lines that are content rather than the header — what the
    ; example week draws under the title.
    def bodyLines:[string]

    Constructor () {
    }

    ; `## Title`, `Tags a, b`, `Emojis 💪` — read off the lines, the way the
    ; original reads them off the parsed workout. The date bracket on the
    ; first line is the entry's, not the title's.
    sfn of:RtEntry (compact:string) {
        def e (new RtEntry)
        def lines:[string] (RtEntry.splitLines(compact))
        for lines raw:string i {
            def line:string (RtEntry.trimmed(raw))
            if ((strlen line) == 0) {
                continue
            }
            if ((RtEntry.hasPrefix(line "## ")) && ((strlen e.title) == 0)) {
                e.title = (RtEntry.trimmed((substring line 3 (strlen line))))
                continue
            }
            if (RtEntry.hasPrefix(line "[")) {
                ; "[2026-02-10] ## Title" keeps its title after the bracket;
                ; "[2026-05-07T14:34+03]" the time of day too.
                def close:int (RtEntry.findIn(line "]"))
                if (close >= 17) {
                    if ((substring line 11 12) == "T") {
                        e.time = (substring line 12 17)
                    }
                }
                if (close >= 0) {
                    def rest:string (RtEntry.trimmed((substring line (close + 1) (strlen line))))
                    if ((RtEntry.hasPrefix(rest "## ")) && ((strlen e.title) == 0)) {
                        e.title = (RtEntry.trimmed((substring rest 3 (strlen rest))))
                    }
                }
                continue
            }
            if (RtEntry.hasPrefix(line "Tags ")) {
                def list:string (substring line 5 (strlen line))
                def parts:[string] (RtEntry.splitOn(list 44))
                for parts p:string j {
                    def tag:string (RtEntry.trimmed(p))
                    if ((strlen tag) > 0) {
                        push e.tags tag
                    }
                }
                continue
            }
            if (RtEntry.hasPrefix(line "Emojis ")) {
                e.emojis = (RtEntry.trimmed((substring line 7 (strlen line))))
                continue
            }
            push e.bodyLines line
        }
        return e
    }

    ; "#kuntosali #voima #kevyt" — the first three, as the row shows them.
    ; The minutes an entry's `Duration` or `Time` line says: "45min",
    ; "1h 10min", "2h". The first such line counts; none is zero.
    sfn minutesOf:int (compact:string) {
        def lines:[string] (RtEntry.splitLines(compact))
        for lines line:string i {
            def t:string (RtEntry.trimmed(line))
            def rest@(mutable):string ""
            if (RtEntry.hasPrefix(t "Duration ")) { rest = (substring t 9 (strlen t)) }
            if (RtEntry.hasPrefix(t "Time ")) { rest = (substring t 5 (strlen t)) }
            if ((strlen rest) > 0) {
                def bar:int (RtEntry.findIn(rest "|"))
                if (bar >= 0) { rest = (substring rest 0 bar) }
                return (RtEntry.minutesIn(rest))
            }
        }
        return 0
    }

    ; "1h 10min" → 70: every number takes the unit that follows it.
    sfn minutesIn:int (text:string) {
        def total@(mutable):int 0
        def num@(mutable):int 0
        def has@(mutable):boolean false
        def i@(mutable):int 0
        def n:int (strlen text)
        while (i < n) {
            def c:int (charAt text i)
            if ((c >= 48) && (c <= 57)) {
                num = ((num * 10) + (c - 48))
                has = true
            } {
                if (c == 104) {
                    if has { total = (total + (num * 60)) }
                    num = 0
                    has = false
                }
                if (c == 109) {
                    if has { total = (total + num) }
                    num = 0
                    has = false
                }
            }
            i = (i + 1)
        }
        return total
    }

    fn tagText:string () {
        def out@(mutable):string ""
        def n@(mutable):int 0
        for tags t:string i {
            if (n < 3) {
                if (n > 0) {
                    out = (out + " ")
                }
                out = ((out + "#") + t)
                n = (n + 1)
            }
        }
        return out
    }

    sfn splitLines:[string] (text:string) {
        return (RtEntry.splitOn(text 10))
    }

    sfn splitOn:[string] (text:string sep:int) {
        def out:[string]
        def run@(mutable):string ""
        def i@(mutable):int 0
        def len:int (strlen text)
        while (i < len) {
            def ch:int (charAt text i)
            if (ch == sep) {
                push out run
                run = ""
            } {
                run = (run + (substring text i (i + 1)))
            }
            i = (i + 1)
        }
        push out run
        return out
    }

    sfn hasPrefix:boolean (text:string prefix:string) {
        def n:int (strlen prefix)
        if ((strlen text) < n) {
            return false
        }
        return ((substring text 0 n) == prefix)
    }

    sfn findIn:int (text:string needle:string) {
        def n:int (strlen needle)
        def len:int (strlen text)
        def i@(mutable):int 0
        while ((i + n) <= len) {
            if ((substring text i (i + n)) == needle) {
                return i
            }
            i = (i + 1)
        }
        return -1
    }

    sfn trimmed:string (text:string) {
        def s@(mutable):int 0
        def e@(mutable):int (strlen text)
        def leading@(mutable):boolean true
        while (leading) {
            if (s >= e) {
                leading = false
            } {
                def c:int (charAt text s)
                if ((c == 32) || (c == 13) || (c == 9)) {
                    s = (s + 1)
                } {
                    leading = false
                }
            }
        }
        def trailing@(mutable):boolean true
        while (trailing) {
            if (e <= s) {
                trailing = false
            } {
                def c2:int (charAt text (e - 1))
                if ((c2 == 32) || (c2 == 13) || (c2 == 9)) {
                    e = (e - 1)
                } {
                    trailing = false
                }
            }
        }
        return (substring text s e)
    }
}

; -----------------------------------------------------------------------------
; A Derived line — `Derived strength.neural_stress 42|score … goodness:4` —
; as `DerivedRow` shows it: the value, its unit, the short Finnish label the
; metric has, and the goodness as a word.
; -----------------------------------------------------------------------------
class RtDerived {
    def key@(mutable):string ""
    def value@(mutable):string ""
    def unit@(mutable):string ""
    def goodness@(mutable):int 0

    ; `getDerivedLabel`: the map, or the key without its family and its
    ; underscores.
    fn label:string () {
        if (key == "nutrition.sugar_simple") { return "sokeri" }
        if (key == "nutrition.sugar_complex") { return "hiilari" }
        if (key == "nutrition.fat_bad_total") { return "paha rasva" }
        if (key == "nutrition.fat_good_total") { return "hyvä rasva" }
        if (key == "endurance.zone1_minutes") { return "Zone1" }
        if (key == "endurance.zone2_minutes") { return "Zone2" }
        if (key == "endurance.zone3_minutes") { return "Zone3" }
        if (key == "endurance.zone4_minutes") { return "Zone4" }
        if (key == "endurance.zone5_minutes") { return "Zone5" }
        if (key == "strength.neural_stress") { return "hermokuorma" }
        if (key == "strength.max_strength_emphasis") { return "maksimivoima" }
        if (key == "strength.power_emphasis") { return "räjähtävyys" }
        if (key == "strength.speed_strength_emphasis") { return "nopeusvoima" }
        if (key == "strength.strength_endurance_emphasis") { return "voimakestävyys" }
        def dot:int (RtEntry.findIn(key "."))
        def bare@(mutable):string key
        if (dot >= 0) {
            bare = (substring key (dot + 1) (strlen key))
        }
        def out@(mutable):string ""
        def i@(mutable):int 0
        while (i < (strlen bare)) {
            def ch:int (charAt bare i)
            if (ch == 95) { out = (out + " ") } { out = (out + (substring bare i (i + 1))) }
            i = (i + 1)
        }
        return out
    }

    fn goodnessLabel:string () {
        if (goodness == 1) { return "huono" }
        if (goodness == 2) { return "heikko" }
        if (goodness == 3) { return "ok" }
        if (goodness == 4) { return "hyvä" }
        if (goodness == 5) { return "top" }
        return ""
    }

    ; The Derived lines of one entry, in the order the file has them.
    sfn of:[RtDerived] (compact:string) {
        def out:[RtDerived]
        def lines:[string] (RtEntry.splitLines(compact))
        for lines raw:string i {
            def line:string (RtEntry.trimmed(raw))
            if (RtEntry.hasPrefix(line "Derived ")) {
                def d (new RtDerived)
                def words:[string] (RtEntry.splitOn(line 32))
                for words w:string wi {
                    if ((strlen w) == 0) { continue }
                    if (wi == 1) { d.key = w }
                    if (wi == 2) {
                        def bar:int (RtEntry.findIn(w "|"))
                        if (bar >= 0) {
                            d.value = (substring w 0 bar)
                            d.unit = (substring w (bar + 1) (strlen w))
                        } {
                            d.value = w
                        }
                    }
                    if (RtEntry.hasPrefix(w "goodness:")) {
                        d.goodness = (to_int (?? (to_double (substring w 9 (strlen w))) 0.0))
                    }
                }
                if ((strlen d.key) > 0) { push out d }
            }
        }
        return out
    }
}

; -----------------------------------------------------------------------------
; The icons — lucide, stroked, in the colour the state asks for
; -----------------------------------------------------------------------------
class RtIcons {
    Constructor () {
    }

    ; The viewBox is a unit wider than lucide's on every side. A stroke two
    ; wide on a path at x=2 reaches x=1, and the round joins reach past that;
    ; mapped edge to edge onto a 20px box the outermost pixel of the roof
    ; and the doorframe was cut off. The unit of room costs a twelfth of
    ; the size and keeps every stroke inside its box.
    sfn svgOf:string (body:string color:string) {
        return ((((("<svg xmlns='http://www.w3.org/2000/svg' viewBox='-1 -1 26 26' fill='none' stroke='" + color) + "' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>") + body) + "</svg>"))
    }

    sfn pathOf:string (d:string) {
        return (("<path d='" + d) + "'/>")
    }

    sfn home:string (color:string) {
        return (RtIcons.svgOf(((RtIcons.pathOf("M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8")) + (RtIcons.pathOf("M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"))) color))
    }


; SPDX-License-Identifier: AGPL-3.0-or-later
;
; THE CHARTS, BEHIND A SEAM.
;
; PLAN_WEB_LOADING.md S4. The statistics cards draw their sparklines with
; Vela — Vega-Lite specification in, scene out — and that compiler is 440 KB
; of the 2.49 MB the browser build compiles to: a fifth of the download, for
; a tab most visitors never open. It could not be deferred while
; `RealTrainerDemo` named `VlCompile` in a method, because that is a static
; reference and no bundler may drop what a reachable function names.
;
; So the app does not name it. It asks `RtCharts` for a maker and gets one:
; the base `RtChartMaker`, which draws nothing, until something installs
; `RtVelaChartMaker`, which draws everything. The installing is the host's
; job and happens after the first frame is on the screen
; (gallery/realtrainer/web/charts-chunk.js), which is why the chart compiler
; can arrive in its own file — and why a page that never opens the statistics
; tab pays for it in bytes it downloads in the background rather than in the
; time it waits before seeing anything.
;
; The idiom is `EVGDefaultMeasurer`'s, one file over: a singleton holding an
; optional, a static `install`, and a fallback that behaves.

Import "../../vela/src/VlChart.rgr"
Import "../../vela/src/VlCompile.rgr"
Import "../../vela/src/VlRuntime.rgr"
Import "../../vela/src/VlCommand.rgr"

; One chart on one card: what the statistics screen collected, and all the
; maker is given.
class RtChartDef {
    def id@(mutable):string ""
    def color@(mutable):string ""
    def values:[double]
}

; The maker the app has when nothing has been installed. It is not a stub in
; the apologetic sense — it is the honest answer for a page whose chart code
; has not arrived: no commands, so the card draws its frame and its numbers
; and no curve, and the next rebuild after the install draws the curve.
class RtChartMaker {
    fn build:VlCommandList (def0:RtChartDef w:int h:int) {
        def empty (new VlCommandList())
        return empty
    }
}

; Where the app asks. Nothing here knows about Vela.
class RtCharts @singleton(true) {
    def current@(optional):RtChartMaker
    def installs:int 0

    sfn install:void (m:RtChartMaker) {
        def r:RtCharts (RtCharts.__singleton())
        r.current = m
        r.installs = (r.installs + 1)
    }

    sfn isInstalled:boolean () {
        def r:RtCharts (RtCharts.__singleton())
        return (!null? r.current)
    }

    ; How many times a maker has been installed — the host's proof that the
    ; chunk it asked for arrived and did what it came to do.
    sfn installCount:int () {
        def r:RtCharts (RtCharts.__singleton())
        return r.installs
    }

    sfn maker:RtChartMaker () {
        def r:RtCharts (RtCharts.__singleton())
        if (!null? r.current) {
            return (unwrap r.current)
        }
        def m (new RtChartMaker())
        return m
    }
}

; THE COLD HALF. Nothing in the app names this class; the chunk does, and
; that is the whole mechanism.
class RtVelaChartMaker extends RtChartMaker {
    fn build:VlCommandList (def0:RtChartDef w:int h:int) {
        def n:int (array_length def0.values)
        def lo@(mutable):double (itemAt def0.values 0)
        def hi@(mutable):double lo
        for def0.values v:double i {
            if (v < lo) { lo = v }
            if (v > hi) { hi = v }
        }
        if (hi <= lo) { hi = (lo + 1.0) }
        ; A hair of room over and under, so the line's width is not clipped
        ; at the top and the bottom of the plot.
        def pad:double ((hi - lo) * 0.06)
        lo = (lo - pad)
        hi = (hi + pad)
        def xs:[double]
        for def0.values v:double i { push xs (int2double i) }
        def data:VlDataset (VlDataset.create())
        data.numbers("i" xs)
        data.numbers("v" def0.values)
        def last:VlDataset (VlDataset.create())
        def lastX:[double]
        def lastV:[double]
        push lastX (int2double (n - 1))
        push lastV (itemAt def0.values (n - 1))
        last.numbers("i" lastX)
        last.numbers("v" lastV)
        def xScale:VlJson (RtVelaChartMaker.domainJson(0.0 (int2double (n - 1))))
        def yScale:VlJson (RtVelaChartMaker.domainJson(lo hi))
        def chart (VlChart.create(data))
        chart.size(w h)
        chart.background("#171717")
        chart.configJson((RtVelaChartMaker.plainConfig()))
        chart.area().interpolate("monotone").markColor(def0.color).markOpacity(0.18).x("i").scaleJson(xScale).noAxis().y("v").scaleJson(yScale).noAxis()
        chart.line().interpolate("monotone").markColor(def0.color).strokeWidth(2.0).x("i").scaleJson(xScale).noAxis().y("v").scaleJson(yScale).noAxis()
        def dot (VlChart.create(last))
        dot.size(w h)
        dot.background("#171717")
        dot.configJson((RtVelaChartMaker.plainConfig()))
        dot.point().filled(true).markColor(def0.color).markSize(36.0).x("i").scaleJson(xScale).noAxis().y("v").scaleJson(yScale).noAxis()
        def list:VlCommandList (RtVelaChartMaker.runChart(chart))
        def dots:VlCommandList (RtVelaChartMaker.runChart(dot))
        ; The point's commands after the curve's, so it is drawn over it —
        ; its background dropped, as it would cover the curve.
        for dots.commands c:VlDrawCommand i {
            if ((c.op == "rect") && (i == 0)) { continue }
            push list.commands c
        }
        return list
    }

    ; No padding, no frame around the plot: the card is the frame.
    sfn plainConfig:VlJson () {
        def p (new VlJsonParser())
        return (p.parse("{\"padding\":0,\"view\":{\"stroke\":null}}"))
    }

    sfn domainJson:VlJson (lo:double hi:double) {
        def p (new VlJsonParser())
        return (p.parse((((("{\"domain\":[" + (to_string lo)) + ",") + (to_string hi)) + "],\"nice\":false,\"zero\":false}")))
    }

    ; Vega-Lite → Vega → scene → commands, and an empty list for a chart
    ; that refused somewhere on the way.
    sfn runChart:VlCommandList (chart:VlChart) {
        def empty (new VlCommandList())
        if ((array_length chart.errors) > 0) { return empty }
        def spec:VlJson (chart.toSpec())
        def compiler (new VlCompile())
        def vg:VlJson (compiler.compileSpec(spec))
        if ((array_length compiler.errors) > 0) { return empty }
        def rt (new VlRuntime())
        def scene:VlSceneMark (rt.run(vg))
        if ((array_length rt.errors) > 0) { return empty }
        return (VlSceneCommands.build(scene))
    }
}

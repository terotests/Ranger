{
  "_": "The machine itself, in the shape createMachine() takes. Structure, state names, event names and targets are those of frontend/src/machines/addWorkoutDialogMachine.ts. What differs is `assign`: in XState it is a function and a function is not data, so an assignment is a value expression — a literal, a named field of the event, a context key, or `or` between them. The event field names are the machine\u0027s own (targetDate, date, text, error), from its event union.",
  "id": "addWorkoutDialog",
  "initial": "closed",
  "context": {
    "today": "",
    "targetDate": "",
    "targetCalendarId": "",
    "inputText": "",
    "error": ""
  },
  "states": {
    "closed": {
      "on": {
        "OPEN": {
          "target": "open",
          "actions": [
            { "assign": {
              "targetDate": { "or": [ { "event": "targetDate" }, { "context": "today" } ] },
              "targetCalendarId": { "value": "" },
              "inputText": { "value": "" },
              "error": { "value": "" }
            } }
          ]
        }
      }
    },
    "open": {
      "on": {
        "CLOSE": {
          "target": "closed",
          "actions": [
            { "assign": {
              "targetDate": { "context": "today" },
              "targetCalendarId": { "value": "" },
              "inputText": { "value": "" },
              "error": { "value": "" }
            } }
          ]
        },
        "SET_TARGET_DATE": {
          "actions": [ { "assign": { "targetDate": { "event": "date" } } } ]
        },
        "SET_INPUT_TEXT": {
          "actions": [ { "assign": { "inputText": { "event": "text" } } } ]
        },
        "START_SAVING": "saving"
      }
    },
    "saving": {
      "on": {
        "SAVE_COMPLETE": {
          "target": "closed",
          "actions": [
            { "assign": {
              "targetDate": { "context": "today" },
              "targetCalendarId": { "value": "" },
              "inputText": { "value": "" },
              "error": { "value": "" }
            } }
          ]
        },
        "ERROR": {
          "target": "open",
          "actions": [ { "assign": { "error": { "event": "error" } } } ]
        },
        "CLOSE": {
          "target": "closed",
          "actions": [
            { "assign": {
              "targetDate": { "context": "today" },
              "targetCalendarId": { "value": "" },
              "inputText": { "value": "" },
              "error": { "value": "" }
            } }
          ]
        }
      }
    }
  }
}

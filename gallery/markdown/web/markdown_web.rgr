; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; markdown_web.rgr — the whole module in a tab, with no host behind it.
; ============================================================================
;
;   text typed in the page ──► MdBlock ──► MdLayout ──► MdToEvg
;                                                          │
;                                            ┌─────────────┴─────────────┐
;                                            ▼                           ▼
;                                     EVGDisplayList              EVGPDFRenderer
;                                     → evg-webgl.js              → a .pdf the
;                                       (the canvas)                browser saves
;
; This is the only file in the module that a browser talks to, and it is a
; SEAM rather than an application: every method is one call into the engine,
; so the same parse, the same layout and the same PDF run in the page as run
; on the command line. A keystroke is a function call; there is no server.
;
; **The document is edited HERE, not in the textarea.** `MdEditController` owns
; the source and every pane is a reader of it: the textarea submits an offset
; and a string, the canvas submits a point and a keystroke, and both re-read
; afterwards. There is no second copy to keep in step, and therefore no loop
; to break — which is the failure mode a two-pane editor has and the reason
; `PLAN_WYSIWYG.md` §5 names it as a risk rather than a detail.
;
; **The fonts are the page's job.** Nothing here reads a file — the page
; fetches the four faces and hands the bytes to `attachFont`, and after that
; the layout, the canvas and the PDF all measure through the same
; `TTFTextMeasurer`. Skip that and the three disagree: EVG measures with a
; guessed table, the canvas draws with whatever the system had, and the PDF
; embeds nothing. That is the failure `EVGTextEngine` warns about, and it
; looks like a line-breaking bug.
; ============================================================================

Import "../src/MdBlock.rgr"
Import "../src/MdEditController.rgr"
Import "../src/MdLayout.rgr"
Import "../src/MdToEvg.rgr"
Import "../src/MdToHtml.rgr"
Import "../src/MdMermaid.rgr"
Import "../../evg/EVGLayout.rgr"
Import "../../evg/EVGDisplayList.rgr"
Import "../../pdf_writer/src/core/EVGPDFRenderer.rgr"
Import "../../pdf_writer/src/fonts/FontManager.rgr"

; The controller, with the module's own idea of what "lay this out" means:
; the document's page size and margins first, then the diagrams at the width
; of the column they will land in, then the boxes. `MdEditController` cannot
; do any of that itself without importing the Mermaid reader, which every
; caller that has no diagrams would then link.
class MarkdownEdit {
    Extends(MdEditController)

    def styleName:string "default"
    def embedWidth:double 820.0
    def diagrams:int 0

    Constructor () {
    }

    fn ensureLayout:void () {
        if (! stale) {
            return
        }
        doc = (MdBlock.parseText(source))
        layout.applyMeta(doc)
        MdMermaid.prepare(doc layout.embeds embedWidth styleName)
        diagrams = (layout.embeds.count())
        layout.setDocSource(source)
        if (sheetGap >= 0.0) {
            layout.layoutPaged(doc)
        } {
            layout.armCache(doc)
            layout.layoutContinuous(doc viewWidth)
        }
        this.buildLines()
        stale = false
    }
}

class MarkdownWeb {
    def edit:MarkdownEdit (new MarkdownEdit())
    def docList:EVGDisplayList (new EVGDisplayList())
    ; Where `docList` currently sits. The list is moved to the scroll position
    ; rather than copied there: `appendFrom` shares its commands, so a copy
    ; would alias the original and the second scroll would move it twice.
    def listOffset:double 0.0

    def fontManager:FontManager (new FontManager())
    def faceCount:int 0
    def measurer@(optional):TTFTextMeasurer

    def viewW:double 900.0
    def viewH:double 700.0
    def scrollY:double 0.0
    def styleName:string "default"
    ; false: one column as tall as the document. true: sheets, with the page
    ; breaks the PDF will have.
    def paged:boolean false

    ; Is the canvas an editor, and is the caret in its ON blink? The page
    ; drives both: a caret that blinks on a timer inside the module would
    ; redraw a document nobody is looking at.
    def editing:boolean false
    def caretOn:boolean true

    def statusText:string "ready"
    def blocks:int 0
    def diagrams:int 0
    def pages:int 1
    def built:boolean false

    Constructor () {
    }

    fn init:void (w:double h:double) {
        viewW = w
        viewH = h
    }

    ; ----------------------------------------------------------------------
    ; Fonts
    ; ----------------------------------------------------------------------
    ;
    ; One face at a time, by the name the layout asks for: `Open Sans`,
    ; `Open Sans-Bold`, `Open Sans-Italic`, `Open Sans-BoldItalic`. The name
    ; carries the variant instead of a weight flag, because that is the one
    ; spelling the measurer, the font manager and a `@font-face` rule all
    ; resolve the same way.
    fn attachFont:boolean (name:string data:buffer) {
        def ok:boolean (fontManager.loadFontBuffer(name data))
        if ok {
            faceCount = (faceCount + 1)
            def m:TTFTextMeasurer (new TTFTextMeasurer(fontManager))
            measurer = m
            edit.setMeasurer(m)
        }
        return ok
    }

    fn fontsReady:boolean () {
        return (faceCount > 0)
    }

    ; ----------------------------------------------------------------------
    ; The document
    ; ----------------------------------------------------------------------
    ; Opening a file. Not an edit: an undo across an open would put back text
    ; from a document the reader had closed.
    fn setSource:void (text:string) {
        edit.open(text)
        this.rebuild()
    }

    fn source:string () {
        return edit.source
    }

    fn setStyle:void (name:string) {
        styleName = name
        edit.styleName = name
        this.rebuild()
    }

    fn setPaged:void (v:boolean) {
        paged = v
        this.rebuild()
    }

    fn resize:void (w:double h:double) {
        def changed:boolean (w != viewW)
        viewW = w
        viewH = h
        if changed {
            this.rebuild()
        }
    }

    fn contentWidth:double () {
        def m:double edit.layout.style.margin
        if paged {
            return (edit.layout.style.pageWidth - (m * 2.0))
        }
        return (viewW - (m * 2.0))
    }

    fn rebuild:void () {
        edit.styleName = styleName
        edit.viewWidth = viewW
        edit.embedWidth = (this.contentWidth())
        if paged {
            edit.sheetGap = (MdToEvg.sheetGap())
        } {
            edit.sheetGap = (0.0 - 1.0)
        }
        edit.stale = true
        edit.ensureLayout()
        blocks = (edit.doc.childCount())
        diagrams = edit.diagrams
        pages = edit.layout.pageCount
        this.buildList()
        built = true
        this.setStatus()
    }

    ; Everything that reads geometry goes through here first, so a keystroke
    ; that has not been laid out yet cannot be drawn from a stale box list.
    fn sync:void () {
        if edit.stale {
            this.rebuild()
        }
    }

    ; The whole document as one display list, in document coordinates.
    ;
    ; Paged mode stacks the sheets with a gap, so scrolling through a printed
    ; document shows what will be printed — the same call, the same breaks,
    ; and the reader can see where page four starts before they print it.
    fn buildList:void () {
        listOffset = 0.0
        ; Straight to the commands: the canvas never wanted an element tree,
        ; and building one only to walk it back was 133 ms of a 342 ms
        ; document. `MarkdownTest.presized` holds the two roads to the same
        ; marks, command by command.
        def out:EVGDisplayList (new EVGDisplayList())
        if paged {
            out = (MdToEvg.sheetsToDisplayList(edit.layout (MdToEvg.sheetGap())))
        } {
            out = (MdToEvg.toDisplayList(edit.layout viewW))
        }
        docList = out
    }

    fn setStatus:void () {
        def b:string (to_string blocks)
        def d:string (to_string diagrams)
        def n:int (array_length docList.cmds)
        def c:string (to_string n)
        def h:int (to_int (this.documentHeight()))
        statusText = ((((b + " blocks, ") + d) + " diagrams, ") + c + " draw commands")
        if paged {
            statusText = ((statusText + ", ") + (to_string pages) + " pages")
        }
    }

    ; ----------------------------------------------------------------------
    ; Scrolling and painting
    ; ----------------------------------------------------------------------
    fn documentHeight:double () {
        if paged {
            def gap:double (MdToEvg.sheetGap())
            def n:double (to_double edit.layout.pageCount)
            return ((n * (edit.layout.style.pageHeight + gap)) - gap)
        }
        return edit.layout.documentHeight
    }

    fn maxScroll:double () {
        def h:double (this.documentHeight())
        def m:double (h - viewH)
        if (m < 0.0) { return 0.0 }
        return m
    }

    fn scrollTo:void (y:double) {
        def m:double (this.maxScroll())
        def want:double y
        if (want < 0.0) { want = 0.0 }
        if (want > m) { want = m }
        scrollY = want
    }

    fn scrollBy:void (dy:double) {
        def y:double (scrollY + dy)
        this.scrollTo(y)
    }

    ; The commands for what is on screen, in screen coordinates, in the
    ; envelope the WebGL painter reads: `{width, height, list}`. The list
    ; alone is what `toJson` gives, and the painter reaches for `doc.list.cmds`
    ; — handing it the bare list is a page that draws nothing and says
    ; "cannot read properties of undefined".
    fn frame:string () {
        this.sync()
        def want:double (0.0 - scrollY)
        def delta:double (want - listOffset)
        if (delta != 0.0) {
            docList.offsetBy(0.0 delta)
            listOffset = want
        }
        ; The document, then the caret and the selection on top of it. The
        ; chrome is built fresh every frame and the document is not: a caret
        ; blinks and moves without a character changing, and relaying out a
        ; document to draw a two-point rectangle is the difference between an
        ; editor that types and one that stutters.
        def out:EVGDisplayList (new EVGDisplayList())
        out.appendFrom(docList)
        this.paintChrome(out)
        def body:string (out.toJson())
        def w:string (EVGDisplayList.num(viewW))
        def h:string (EVGDisplayList.num(viewH))
        return ((((("{\"width\":" + w) + ",\"height\":") + h) + ",\"list\":") + body) + "}"
    }

    ; ----------------------------------------------------------------------
    ; The caret, and the band behind a selection
    ; ----------------------------------------------------------------------
    ;
    ; Drawn as ordinary rectangles into the same display list as the document,
    ; so every painter that can draw the document can draw the caret and none
    ; of them learns what a caret is. That is the data seam
    ; `gallery/PLAN_EDITOR_KERNEL.md` §2 prefers, and here it means the SDL
    ; host and the WebGL one get an editor without being told.
    fn paintChrome:void (out:EVGDisplayList) {
        if (! editing) { return }
        def sel:EVGColor (EVGColor.rgba(9 105 218 0.22))
        def ink:EVGColor (EVGColor.rgba(31 35 40 1.0))
        def a:int (edit.selStart())
        def b:int (edit.selEnd())
        def n:int (edit.lines.count())
        def i:int 0
        while (i < n) {
            def top:double ((edit.lines.topAt(i)) - scrollY)
            def h:double (edit.lines.heightAt(i))
            ; Only what is on screen. A hundred-page document has a hundred
            ; pages of lines and one of them is being looked at.
            if (((top + h) > 0.0) && (top < viewH)) {
                if (b > a) {
                    def ls:int (edit.lines.startAt(i))
                    def le:int (edit.lines.endAt(i))
                    def from:int a
                    def to:int b
                    if (from < ls) { from = ls }
                    if (to > le) { to = le }
                    if (to > from) {
                        def x0:double (edit.xOnLine(i from))
                        def x1:double (edit.xOnLine(i to))
                        if ((x0 >= 0.0) && (x1 > x0)) {
                            out.addRect(x0 top (x1 - x0) h sel)
                        }
                    }
                }
            }
            i = (i + 1)
        }
        if (caretOn) {
            def cx:double (edit.caretX())
            if (cx >= 0.0) {
                def li:int (OfficeLineNav.indexOfOffset(edit.lines (edit.caret())))
                if (li >= 0) {
                    def ct:double ((edit.lines.topAt(li)) - scrollY)
                    def ch:double (edit.lines.heightAt(li))
                    if (((ct + ch) > 0.0) && (ct < viewH)) {
                        out.addRect(cx (ct + 1.0) 1.6 (ch - 2.0) ink)
                    }
                }
            }
        }
    }

    fn commandCount:int () {
        return (array_length docList.cmds)
    }

    ; ----------------------------------------------------------------------
    ; What the page asks about
    ; ----------------------------------------------------------------------
    fn status:string () {
        return statusText
    }

    fn ready:boolean () {
        return built
    }

    fn scrollPosition:double () {
        return scrollY
    }

    fn diagramCount:int () {
        return diagrams
    }

    fn blockCount:int () {
        return blocks
    }

    ; ----------------------------------------------------------------------
    ; The editor, as the page reaches it
    ; ----------------------------------------------------------------------
    ;
    ; **These are `docx_web.rgr`'s names.** `click`, `typeText`, `key`,
    ; `paste`, `copySelection`, `cutSelection`, `undo`, `redo`, `caretJson`,
    ; `run`. Not because a base class is coming — `gallery/PLAN_EDITOR_KERNEL.md`
    ; §7 explains why there should not be — but because the two hosts then
    ; differ only where the documents do, and a page written against one is
    ; readable by anyone who has read the other.
    ;
    ; Every one of them is a call into `MdEditController`. There is no state
    ; here: the source, the caret, the selection and the undo stack are all
    ; the controller's, and the textarea in the page is a second VIEW of them
    ; rather than a second copy.

    fn setEditMode:void (on:boolean) {
        editing = on
    }

    fn editMode:boolean () {
        return editing
    }

    ; The page owns the blink, so a document nobody is looking at is not
    ; redrawn twice a second.
    fn setCaretOn:void (on:boolean) {
        caretOn = on
    }

    fn click:void (x:double y:double extend:boolean) {
        this.sync()
        edit.clickAt(x (y + scrollY) extend)
    }

    ; A drag, and a double-click. Separate from `click` because a page can
    ; tell them apart and the module cannot.
    fn dragTo:void (x:double y:double) {
        this.sync()
        edit.clickAt(x (y + scrollY) true)
    }

    fn selectWordAt:void (x:double y:double) {
        this.sync()
        edit.clickAt(x (y + scrollY) false)
        edit.selectWord()
    }

    fn typeText:void (v:string) {
        edit.insertText(v)
    }

    ; The keys that are not characters. `name` is the page's own spelling —
    ; the same set `docx_web` takes.
    fn key:boolean (name:string shift:boolean ctrl:boolean) {
        this.sync()
        if ctrl {
            if (name == "b") { return (this.run("format.bold" "")) }
            if (name == "i") { return (this.run("format.italic" "")) }
            if (name == "e") { return (this.run("format.code" "")) }
            if (name == "z") { edit.undo() return true }
            if (name == "y") { edit.redo() return true }
            if (name == "a") { edit.selectAll() return true }
            if (name == "left")  { edit.moveWordLeft(shift)  return true }
            if (name == "right") { edit.moveWordRight(shift) return true }
            if (name == "home")  { edit.moveDocEdge(false shift) return true }
            if (name == "end")   { edit.moveDocEdge(true shift)  return true }
        }
        if (name == "left")      { edit.moveLeft(shift)  return true }
        if (name == "right")     { edit.moveRight(shift) return true }
        if (name == "up")        { edit.moveUp(shift)    return true }
        if (name == "down")      { edit.moveDown(shift)  return true }
        if (name == "home")      { edit.moveLineEdge(false shift) return true }
        if (name == "end")       { edit.moveLineEdge(true shift)  return true }
        if (name == "pageUp")    { edit.movePage(false viewH shift) return true }
        if (name == "pageDown")  { edit.movePage(true viewH shift)  return true }
        if (name == "backspace") { edit.backspace()   return true }
        if (name == "delete")    { edit.deleteForward() return true }
        if (name == "enter")     { edit.splitAtCaret() return true }
        return false
    }

    ; The toolbar. One door for every intent, so the page holds no rules and a
    ; new command is a row here rather than a branch in JavaScript.
    fn run:boolean (id:string arg:string) {
        this.sync()
        if (id == "format.bold")   { return (edit.toggleBold()) }
        if (id == "format.italic") { return (edit.toggleItalic()) }
        if (id == "format.code")   { return (edit.toggleCode()) }
        if (id == "format.strike") { return (edit.toggleStrike()) }
        if (id == "format.link")   { return (edit.toggleLink(arg)) }
        if (id == "block.heading") { return (edit.setHeading((?? (str2int arg) 0))) }
        if (id == "block.bullet")  { return (edit.toggleLinePrefix("bullet")) }
        if (id == "block.ordered") { return (edit.toggleLinePrefix("ordered")) }
        if (id == "block.quote")   { return (edit.toggleLinePrefix("quote")) }
        if (id == "edit.undo")     { edit.undo() return true }
        if (id == "edit.redo")     { edit.redo() return true }
        if (id == "edit.selectAll") { edit.selectAll() return true }
        return false
    }

    ; Why the last command did nothing, or "". A refusal and a no-op look the
    ; same to a document and completely different to a reader.
    fn refusal:string () {
        return (edit.refusal())
    }

    fn copySelection:string () {
        return (edit.selectedText())
    }

    fn cutSelection:string () {
        def v:string (edit.selectedText())
        if ((strlen v) > 0) {
            edit.deleteSelection()
        }
        return v
    }

    fn paste:void (v:string) {
        edit.paste(v)
    }

    ; Both clipboard flavours, as `docx_web.paste` takes them. A spreadsheet
    ; range carries a real `<table>` in the HTML one and tab-separated text in
    ; the other, and only one of the two is a table when it lands. Answers
    ; whether a table was made, so the page can say so.
    fn pasteRich:boolean (html:string text:string) {
        this.sync()
        return (edit.pasteRich(html text))
    }

    fn undo:void () {
        edit.undo()
    }

    fn redo:void () {
        edit.redo()
    }

    fn canUndo:boolean () {
        return (edit.canUndo())
    }

    fn canRedo:boolean () {
        return (edit.canRedo())
    }

    ; Where the caret is, for the page to put its own in the same place. The
    ; textarea is a second view of one source, and this is how it follows.
    fn caretJson:string () {
        this.sync()
        def cx:double (edit.caretX())
        def li:int (OfficeLineNav.indexOfOffset(edit.lines (edit.caret())))
        def cy:double 0.0
        def ch:double 0.0
        if (li >= 0) {
            cy = ((edit.lines.topAt(li)) - scrollY)
            ch = (edit.lines.heightAt(li))
        }
        def out:string "{\"offset\":"
        out = (out + (to_string (edit.caret())))
        out = (out + ",\"anchor\":")
        out = (out + (to_string (edit.selStart())))
        out = (out + ",\"focus\":")
        out = (out + (to_string (edit.selEnd())))
        out = (out + ",\"x\":")
        out = (out + (EVGDisplayList.num(cx)))
        out = (out + ",\"y\":")
        out = (out + (EVGDisplayList.num(cy)))
        out = (out + ",\"h\":")
        out = (out + (EVGDisplayList.num(ch)))
        out = (out + "}")
        return out
    }

    ; The OTHER pane's edit. The textarea is a second view of one source, so
    ; what it does has to arrive as a patch like everything else — replacing
    ; the whole text would make every keystroke in it one undo of the entire
    ; document, and would throw away the history the canvas built.
    ;
    ; The page computes the range by comparing what it has with `sourceText()`,
    ; which is a common prefix and a common suffix and is fifteen lines of
    ; JavaScript. It is not a diff algorithm and does not need to be: a
    ; textarea reports one contiguous change at a time.
    fn applyPatch:void (start:int end:int text:string) {
        this.sync()
        edit.setRange(start end)
        edit.insertText(text)
    }

    ; The page's caret, moved into the module: the textarea is the other view
    ; and this is how IT leads.
    fn setSelection:void (a:int b:int) {
        this.sync()
        edit.setRange(a b)
    }

    ; The source, after whatever the canvas did to it. The page writes this
    ; back into the textarea — it does not keep its own copy.
    fn sourceText:string () {
        return edit.source
    }

    fn sourceVersion:int () {
        return ((edit.history.depth()) + (edit.history.redoDepth()))
    }

    ; ----------------------------------------------------------------------
    ; Out of the tab
    ; ----------------------------------------------------------------------
    ;
    ; The PDF is built HERE, in the page, from the same layout the canvas is
    ; showing — not fetched from anywhere. A canvas has one page as far as
    ; `window.print()` is concerned, so the browser's own print dialog would
    ; produce a single clipped sheet; this produces the sheets the layout
    ; decided, with the faces the reader's own browser fetched embedded in
    ; them.
    fn pdf:buffer () {
        def print:MdLayout (new MdLayout())
        if (!null? measurer) {
            print.setMeasurer((unwrap measurer))
        }
        print.applyMeta(edit.doc)
        def cw:double (print.style.pageWidth - (print.style.margin * 2.0))
        MdMermaid.prepare(edit.doc print.embeds cw styleName)
        print.layoutPaged(edit.doc)
        def root:EVGElement (MdToEvg.buildPrint(print))
        def renderer (new EVGPDFRenderer())
        renderer.init(renderer)
        renderer.setPageSize(print.style.pageWidth print.style.pageHeight)
        if (faceCount > 0) {
            renderer.setFontManager(fontManager)
            if (!null? measurer) {
                renderer.setMeasurer((unwrap measurer))
            }
        }
        return (renderer.render(root))
    }

    fn pdfPageCount:int () {
        return pages
    }

    fn html:string () {
        return (MdToHtml.render(edit.doc))
    }

    ; ----------------------------------------------------------------------
    ; The two panes, kept in step
    ; ----------------------------------------------------------------------
    ;
    ; Every block remembers the characters it was parsed from, so a click on
    ; the drawing is an offset in the source and a caret in the source is a
    ; place to scroll the drawing to. Neither pane has to know how the other
    ; one works.
    fn sourceOffsetAt:int (x:double y:double) {
        def docY:double (y + scrollY)
        ; The CHARACTER under the pointer, when one was drawn there. This used
        ; to answer with the block's first byte and nothing finer, because
        ; that was all a box carried — a click in the middle of the fourth
        ; paragraph put the source caret at the start of it.
        def exact:int (edit.layout.srcAtPoint(x docY (this.sheetGap())))
        if (exact >= 0) { return exact }
        ; Nothing that carries a source was drawn at that point — the margin,
        ; the gap between sheets, a rule, a diagram. Fall back to the block
        ; above, which is the answer the viewer always gave.
        def best:int -1
        def bestY:double (0.0 - 1000000.0)
        def i:int 0
        def n:int (edit.doc.childCount())
        while (i < n) {
            def b:MdNode (edit.doc.childAt(i))
            def top:double (this.topOf(b))
            if (top <= docY) {
                if (top > bestY) {
                    bestY = top
                    best = b.srcStart
                }
            }
            i = (i + 1)
        }
        return best
    }

    ; How the sheets are stacked, as `MdLayout` wants to be told: below zero
    ; for one continuous column.
    fn sheetGap:double () {
        if paged {
            return (MdToEvg.sheetGap())
        }
        return (0.0 - 1.0)
    }

    ; Where a source offset ended up on the drawing.
    ;
    ; The boxes first, so the answer is the LINE the character is on rather
    ; than the top of the paragraph it is in: a caret moved down inside a long
    ; paragraph used to scroll nowhere, because every box of that paragraph
    ; reported the same y.
    fn offsetToY:double (offset:int) {
        def bestBox:double (0.0 - 1.0)
        def bestSrc:int -1
        def gap:double (this.sheetGap())
        def bi:int 0
        def bn:int (array_length edit.layout.boxes)
        while (bi < bn) {
            def bx:MdBox (itemAt edit.layout.boxes bi)
            if ((bx.kind == 0) && (bx.segSrc >= 0)) {
                if (bx.segSrc <= offset) {
                    if (bx.segSrc >= bestSrc) {
                        bestSrc = bx.segSrc
                        bestBox = (edit.layout.boxTop(bx gap))
                    }
                }
            }
            bi = (bi + 1)
        }
        if (bestBox >= 0.0) { return bestBox }
        def best:double 0.0
        def i:int 0
        def n:int (edit.doc.childCount())
        while (i < n) {
            def b:MdNode (edit.doc.childAt(i))
            if (b.srcStart <= offset) {
                best = (this.topOf(b))
            }
            i = (i + 1)
        }
        return best
    }

    ; The top of a block on the drawing: the first box it produced, which
    ; every box now remembers. No map on the side to keep in step.
    fn topOf:double (block:MdNode) {
        def i:int (edit.layout.firstBoxOf(block.srcStart))
        if (i < 0) { return 0.0 }
        def b:MdBox (itemAt edit.layout.boxes i)
        if paged {
            def gap:double (MdToEvg.sheetGap())
            def sheet:double (edit.layout.style.pageHeight + gap)
            return (b.y + ((to_double b.page) * sheet))
        }
        return b.y
    }
}

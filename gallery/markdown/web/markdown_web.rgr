; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; markdown_web.rgr — the whole module in a tab, with no host behind it.
; ============================================================================
;
;   text typed in the page ──► MdBlock ──► MdLayout ──► MdToEvg
;                                                          │
;                                            ┌─────────────┴─────────────┐
;                                            ▼                           ▼
;                                     EVGDisplayList              EVGPDFRenderer
;                                     → evg-webgl.js              → a .pdf the
;                                       (the canvas)                browser saves
;
; This is the only file in the module that a browser talks to, and it is a
; SEAM rather than an application: every method is one call into the engine,
; so the same parse, the same layout and the same PDF run in the page as run
; on the command line. A keystroke is a function call; there is no server.
;
; **The document is edited HERE, not in the textarea.** `MdEditController` owns
; the source and every pane is a reader of it: the textarea submits an offset
; and a string, the canvas submits a point and a keystroke, and both re-read
; afterwards. There is no second copy to keep in step, and therefore no loop
; to break — which is the failure mode a two-pane editor has and the reason
; `PLAN_WYSIWYG.md` §5 names it as a risk rather than a detail.
;
; **The fonts are the page's job.** Nothing here reads a file — the page
; fetches the four faces and hands the bytes to `attachFont`, and after that
; the layout, the canvas and the PDF all measure through the same
; `TTFTextMeasurer`. Skip that and the three disagree: EVG measures with a
; guessed table, the canvas draws with whatever the system had, and the PDF
; embeds nothing. That is the failure `EVGTextEngine` warns about, and it
; looks like a line-breaking bug.
; ============================================================================

Import "../src/MdBlock.rgr"
Import "../src/MdEditController.rgr"
Import "../src/MdLayout.rgr"
Import "../src/MdToEvg.rgr"
Import "../src/MdToHtml.rgr"
Import "../src/MdDiagram.rgr"
Import "../src/MdCss.rgr"
Import "../src/MdThemes.rgr"
Import "../../vfs/src/Vfs.rgr"
; The two editors this page hands its other documents to — the SAME seams
; the pptx and docx pages run on, not the model and the painter picked out
; of them. `PptxWeb` is the slide editor with its strip, its panel, its
; properties and its caret; `DocxWeb` is the Word editor with its strip and
; its ruler. A page that took `PptxEditor` and `PptxToEvg` alone had a deck
; nobody could click and a diagram drawn by the wrong painter — see
; `PLAN_DOCUMENT_MODES.md` Stage N.
Import "../../pptx/web/pptx_web.rgr"
Import "../../docx_viewer/web/docx_web.rgr"
Import "../src/MdDeckDiagram.rgr"
Import "../src/MdToDocx.rgr"
Import "../src/MdCssEdit.rgr"
Import "../src/MdToPptx.rgr"
Import "../../evg/EVGLayout.rgr"
Import "../../evg/EVGDisplayList.rgr"
Import "../../pdf_writer/src/core/EVGPDFRenderer.rgr"
Import "../../office/export/EVGListToElements.rgr"
Import "../../pdf_writer/src/fonts/FontManager.rgr"

; The controller, with the module's own idea of what "lay this out" means:
; the document's page size and margins first, then the diagrams at the width
; of the column they will land in, then the boxes. `MdEditController` cannot
; do any of that itself without importing the Mermaid reader, which every
; caller that has no diagrams would then link.
class MarkdownEdit {
    Extends(MdEditController)

    def styleName:string "default"
    def diagrams:int 0
    ; The sheet the PAGE asked for, which beats the document's front matter:
    ; it is the reader asking rather than the author. Empty means the document
    ; decides, which is what `applyMeta` already did.
    def pageSize:string ""
    ; The company template, as a stylesheet. Empty is a plain document, which
    ; is what a README is.
    def styleCss:string ""
    def sheet:MdCss (new MdCss())
    def sheetErrors:int 0
    def sheetUnsupported:int 0
    ; …and the templates a document may name for itself. The reader's choice
    ; beats the document's, the way the page size already does — but a
    ; document that says `theme: corporate` and is opened by somebody who has
    ; not chosen anything gets the template it was written for.
    def themes:MdThemes (new MdThemes())
    ; Which sheet the last layout actually used, and where it came from.
    def themeUsed:string ""
    def themeSource:string ""

    Constructor () {
    }

    ; The sheet is parsed once, here, rather than on every rebuild: a
    ; keystroke must not re-read a stylesheet.
    fn setStyleSheet:void (css:string) {
        styleCss = css
        this.useSheet(css "the reader")
        stale = true
    }

    fn addTheme:void (name:string css:string) {
        themes.addTheme(name css)
        stale = true
    }

    fn useSheet:void (css:string from:string) {
        sheet = (new MdCss())
        sheet.addStyleSheet(css)
        sheetErrors = (sheet.errorCount())
        themeSource = from
    }

    ; Which template this document is being laid out with, and why.
    ;
    ; Three answers and they are in order of who is closest to the reading:
    ; what the READER picked in the page, then what the DOCUMENT asked for by
    ; name, then nothing at all. A document that names a template nobody
    ; registered is told so rather than quietly laid out plain.
    fn chooseSheet:void (doc:MdNode) {
        if ((strlen styleCss) > 0) {
            themeUsed = ""
            themeSource = "the reader"
            return
        }
        def want:string (MdThemes.nameIn(doc))
        if ((strlen want) == 0) {
            if ((strlen themeUsed) > 0) {
                themeUsed = ""
                this.useSheet("" "no template")
            }
            return
        }
        if (want == themeUsed) { return }
        def css:string (themes.sheetFor(want))
        themeUsed = want
        if ((strlen css) == 0) {
            this.useSheet("" (("no template called " + want)))
            return
        }
        this.useSheet(css (("the document, which asked for " + want)))
    }

    ; What the template said that this layout cannot do, as one line. A
    ; silent property is a template that looks broken to whoever wrote it.
    fn sheetReport:string () {
        def out:string ""
        def i:int 0
        while (i < (sheet.unsupportedCount())) {
            if (i > 0) { out = (out + ", ") }
            out = (out + (sheet.unsupportedAt(i)))
            i = (i + 1)
        }
        return out
    }

    ; The column a diagram lands in: the page's text width when the sheets
    ; are being drawn, the window's otherwise. A function of the layout's own
    ; style, so it is read from the style rather than remembered.
    fn contentWidth:double () {
        def m:double layout.style.margin
        if (sheetGap >= 0.0) {
            return (layout.style.pageWidth - (m * 2.0))
        }
        return (viewWidth - (m * 2.0))
    }

    ; ----------------------------------------------------------------------
    ; Pictures
    ; ----------------------------------------------------------------------
    ;
    ; The page hands over bytes; the layout and the deck ask the same store.
    ; `![alt](logo.png)` draws as its alt text until something is put here
    ; under that name, which is what it did for every document before there
    ; was a store at all.
    ;
    ; On the EDITOR rather than on `MarkdownWeb`, because the layout is here
    ; and a store one class away from its only reader is a store that gets
    ; handed over in the wrong order once.
    def imageStore:Vfs (new Vfs())
    def imageMemory:VfsMemory (new VfsMemory())
    def haveImages:boolean false

    ; A TEXT file in the same store the pictures are in.
    ;
    ; A stylesheet is a file. It was a string handed across the bridge, which
    ; worked and left a reader with no way to see that the thing dressing
    ; their document was a file at all — or where it was, or what else was
    ; beside it. One store, and `style.css` sits next to `logo.png`.
    fn addTextFile:boolean (name:string text:string) {
        if (! haveImages) { imageStore.mount("/" imageMemory) }
        def n:int (strlen text)
        def buf:buffer (buffer_alloc n)
        def i:int 0
        while (i < n) {
            buffer_set buf i (charAt text i)
            i = (i + 1)
        }
        def b (new VfsBlob())
        b.bytes = buf
        b.contentType = "text/css"
        def ok:boolean (imageStore.put(name b))
        if ok {
            haveImages = true
            stale = true
        }
        return ok
    }

    fn readTextFile:string (name:string) {
        if (! haveImages) { return "" }
        def bytes:buffer (imageStore.read(name))
        def out:string ""
        def i:int 0
        while (i < (buffer_length bytes)) {
            out = (out + (strfromcode (buffer_get bytes i)))
            i = (i + 1)
        }
        return out
    }

    fn addImage:boolean (name:string data:buffer contentType:string w:int h:int) {
        if (! haveImages) { imageStore.mount("/" imageMemory) }
        def b (new VfsBlob())
        b.bytes = data
        b.contentType = contentType
        b.pixelW = w
        b.pixelH = h
        def ok:boolean (imageStore.put(name b))
        if ok {
            haveImages = true
            stale = true
        }
        return ok
    }

    fn ensureLayout:void () {
        if (! stale) {
            return
        }
        doc = (MdBlock.parseText(source))
        this.chooseSheet(doc)
        ; Fresh every time, and in this order: the DEFAULTS, then the company
        ; TEMPLATE, then the document's own FRONT MATTER, then what the reader
        ; picked in the page. Each beats the one before it, which is the order
        ; of who is closest to the document being read.
        ;
        ; Fresh matters as much as the order. The style used to be carried
        ; from the previous rebuild, so opening a document with no front
        ; matter after one that had some kept the old one's page size and
        ; title — `applyMeta` returns early when there is no metadata, and
        ; what it returns early from is overwriting.
        layout.style = (new MdStyle())
        sheet.applyTo(layout.style)
        sheetUnsupported = (sheet.unsupportedCount())
        ; …and the same sheet to the LAYOUT, which asks it a different
        ; question: not how the document is set, but what it says about each
        ; block's own `{.classes}` — which is what columns are.
        def sheetText:string (sheet.text())
        layout.setStyleSheet(sheetText)
        if haveImages { layout.setImages(imageStore "/") }
        layout.applyMeta(doc)
        if ((strlen pageSize) > 0) {
            def pw:double layout.style.pageWidth
            def ph:double layout.style.pageHeight
            layout.style.pageWidth = (MdFrontMatter.pageW(pageSize pw ph))
            layout.style.pageHeight = (MdFrontMatter.pageH(pageSize ph pw))
        }
        ; The width is derived HERE, after the metadata and the reader's page
        ; size have been applied — not handed in by the host.
        ;
        ; It used to be handed in, and the host computed it from the layout's
        ; style as it stood BEFORE this method updated it. So the first
        ; rebuild after switching to paged, or after picking another page
        ; shape, prepared every diagram at the width the previous layout had
        ; used and then asked the cache at the new one. Nothing matched, and
        ; every diagram in the document came back as a labelled empty slot —
        ; "mermaid — no handler prepared this one" — until some later rebuild
        ; happened to run with the style already correct and it fixed itself.
        MdDiagram.prepare(doc layout.embeds (this.contentWidth()) styleName)
        diagrams = (layout.embeds.count())
        layout.setDocSource(source)
        if (sheetGap >= 0.0) {
            if slideMode {
                layout.applySlideMeta(doc)
                layout.layoutSlides(doc)
            } {
                layout.layoutPaged(doc)
            }
        } {
            layout.armCache(doc)
            layout.layoutContinuous(doc viewWidth)
        }
        this.buildLines()
        stale = false
    }
}

class MarkdownWeb {
    def edit:MarkdownEdit (new MarkdownEdit())
    ; What the PAGE asked for, which beats what the document said, because it
    ; is the reader asking rather than the author. Empty means the document
    ; decides.
    def wantPageSize:string ""
    ; "continuous" | "paged" | "slides".
    def mode:string "continuous"
    ; Who owns the document. `PLAN_DOCUMENT_MODES.md` §3.
    ;
    ;   "source"  — the markdown file is the truth and the preview is a
    ;               read-only view of it. Clicking, selecting and copying in
    ;               the preview all work; writing there does not.
    ;   "preview" — the reader has said the preview is the truth, and the
    ;               markdown pane is a record of where it came from.
    ;
    ; One way, and chosen rather than fallen into. The design it replaces kept
    ; markdown as the truth forever and translated every preview gesture into
    ; a patch on it — which works until a gesture markdown cannot hold is
    ; translated anyway, and bold across three list items was one of those.
    ; The deck, once the reader has gone to the PPTX tab.
    ;
    ; `PLAN_DOCUMENT_MODES.md` §5: the editors exist, each with its own suite,
    ; and a second slide editor inside this page would be a PATTERN SEAM —
    ; two implementations of one idea, where a fix to either reaches neither.
    ; So the deck is `PptxWeb` — the whole slide editor the pptx page runs,
    ; strip, panel, properties, caret and all — with a presentation attached
    ; to it rather than read from a file. This page keeps only the canvas,
    ; the font manager and the three tabs. It does not know how a slide is
    ; laid out, drawn or clicked, and must not learn.
    ;
    ; What this replaced, for the record: a `PptxEditor` and a `PptxToEvg`
    ; held here directly, with the page drawing a slide through
    ; `slideToEvg` — the element-tree road, which cannot draw a custom path,
    ; so every diagram came out as the bounding boxes of its edges — at the
    ; top-left corner of an A4-shaped list, with a click that selected and
    ; nothing that could drag, resize, type or undo. Every one of those is a
    ; thing `PptxApp` already does.
    def deckWeb:PptxWeb (new PptxWeb())
    def deckOn:boolean false
    ; …and the other destination: `DocxWeb`, the Word editor's own frame —
    ; strip, ruler, page, status line — with a `RichDocument` attached to it.
    def docWeb:DocxWeb (new DocxWeb())
    def docModel:RichDocument (new RichDocument())
    def docOn:boolean false
    def docSummary:string ""
    ; Which view is on screen, and what each was built from. A view still
    ; showing the markdown it was made from is re-made when that markdown
    ; changes; one a reader has edited is not.
    def view:string "md"
    def deckFrom:string ""
    def docFrom:string ""
    ; The document's revision when it was attached. `RichDocument.revision`
    ; moves on every edit and never comes back, so "has the reader touched
    ; it" is one comparison rather than a flag every input path has to
    ; remember to set — and the input paths are the editor's own now, not
    ; this file's.
    def docRev:int 0
    def ownerRefusal:string ""
    def pptxSummary:string ""
    def pptxNotes:string ""
    ; The document, in DOCUMENT coordinates, and it stays there. Where the
    ; reader is looking is a camera on it — `setView(sheetLeft -scrollY 1)`,
    ; which the painter multiplies in the shader — so a scroll moves three
    ; numbers rather than every command in the list, and the host can draw the
    ; frame it already built (`gallery/evg/PLAN_VIEW_TRANSFORM.md` S3). The list
    ; used to be walked and rewritten on every scroll instead.
    ;
    ; A sheet narrower than the window sits in the MIDDLE of it, the way a page
    ; does in every reader, rather than against the left edge with the paper
    ; stopping half way across; that is the camera's x.
    def docList:EVGDisplayList (new EVGDisplayList())
    ; Which BUILD of the document this is. A host keeps its built frame while
    ; this is unchanged — a scroll, a blink, a click all leave it alone — and
    ; builds again when a keystroke or a style change moves it on.
    def listRev:int 0

    def fontManager:FontManager (new FontManager())
    def faceCount:int 0
    def measurer@(optional):TTFTextMeasurer

    def viewW:double 900.0
    def viewH:double 700.0
    def scrollY:double 0.0
    def styleName:string "default"
    ; false: one column as tall as the document. true: sheets, with the page
    ; breaks the PDF will have.
    def paged:boolean false

    ; Is the canvas an editor, and is the caret in its ON blink? The page
    ; drives both: a caret that blinks on a timer inside the module would
    ; redraw a document nobody is looking at.
    def editing:boolean false
    def caretOn:boolean true

    def statusText:string "ready"
    def blocks:int 0
    def diagrams:int 0
    def pages:int 1
    def built:boolean false

    ; Which view the list on the canvas was built for. `built` says the list
    ; is up to date with the DOCUMENT; this says it is the right document at
    ; all. Without it, laying the markdown out again while the reader was in
    ; DOCX left `built` true over a Word list, and the tab came back to
    ; Preview with the Word page still on the canvas.
    def listFor:string "md"

    Constructor () {
        ; Both editors start with this object, at the default size, so that
        ; a font handed over next lands in each one's own text renderer and
        ; the Word frame draws the viewer it was attached to. Starting them
        ; from `init` would leave a page that only ever calls `resize` — this
        ; page — with a `DocxApp` drawing a viewer nobody attached a document
        ; to: a frame with a strip, a ruler and a blank page. And starting
        ; them only when a tab is pressed would mean fonts loaded before that
        ; press were never seen, which is the bug the old `docView` had: the
        ; page called a `docAddFace` that did not exist, the call was
        ; swallowed, and the Word document measured against no metrics.
        deckWeb.start((to_int viewW) (to_int viewH))
        docWeb.start()
        docWeb.frameSize((to_int viewW) (to_int viewH))
    }

    fn init:void (w:double h:double) {
        this.resize(w h)
    }

    ; The preset shape catalogue, for the deck. A browser cannot read the
    ; file beside the module, so the page fetches it and hands it over — the
    ; same hand-off the pptx page makes.
    fn loadPresets:void (text:string) {
        deckWeb.loadPresets(text)
    }

    ; The two editors, for the page to wire its pointer and its keyboard to.
    ;
    ; The wiring is `gallery/pptx/web/host/pptx-host.mjs` and its docx twin —
    ; the same modules the pptx and docx pages attach — and they want the
    ; editor's own seam, not a translation of it written here. So the page
    ; asks for the object and attaches the module to it; this file stays out
    ; of what a press or a keystroke means to a slide or a Word page.
    fn deckHost:PptxWeb () {
        return deckWeb
    }

    fn docHost:DocxWeb () {
        return docWeb
    }

    ; Something in the view on screen changed under the page's hand — a
    ; press, a drag, a keystroke handled by the editor — so the frame has to
    ; be built again. The page says so after every event it hands an editor,
    ; because the editor cannot tell this file and this file cannot see the
    ; editor's state.
    fn touch:void () {
        built = false
    }

    ; ----------------------------------------------------------------------
    ; Fonts
    ; ----------------------------------------------------------------------
    ;
    ; One face at a time, by the name the layout asks for: `Open Sans`,
    ; `Open Sans-Bold`, `Open Sans-Italic`, `Open Sans-BoldItalic`. The name
    ; carries the variant instead of a weight flag, because that is the one
    ; spelling the measurer, the font manager and a `@font-face` rule all
    ; resolve the same way.
    ; Pictures. The store lives on the EDITOR, beside the layout that reads
    ; it — see `MarkdownEdit.addImage`.
    fn addImage:boolean (name:string data:buffer contentType:string w:int h:int) {
        def ok:boolean (edit.addImage(name data contentType w h))
        if ok { built = false }
        return ok
    }

    fn imageCount:int () {
        return (edit.imageMemory.nameCount())
    }

    ; ----------------------------------------------------------------------
    ; The byte store, as a reader can see it
    ; ----------------------------------------------------------------------
    ;
    ; A store nobody can look into is a store a reader has to take on trust.
    ; These three are what a file pane needs and nothing more: what is in
    ; there, how big each one is, and what it is.
    fn addTextFile:boolean (name:string text:string) {
        def ok:boolean (edit.addTextFile(name text))
        if ok { built = false }
        return ok
    }

    fn readTextFile:string (name:string) {
        return (edit.readTextFile(name))
    }

    ; `path\tbytes\tcontent-type\tWxH` per file, newline separated. One
    ; string, because that is what crosses the bridge without a wrapper on
    ; either side — the same reason `setStyleSheet` takes one.
    fn fileList:string () {
        def out:string ""
        def names:[string] (edit.imageMemory.order)
        def i:int 0
        while (i < (array_length names)) {
            def nm:string (itemAt names i)
            def st:VfsStat (edit.imageMemory.stat(nm))
            if (i > 0) { out = (out + "\n") }
            out = (((out + nm) + "\t") + (to_string st.size)) + "\t" + st.contentType
            if (st.pixelW > 0) {
                out = ((((out + "\t") + (to_string st.pixelW)) + "x") + (to_string st.pixelH))
            } {
                out = (out + "\t")
            }
            i = (i + 1)
        }
        return out
    }

    ; How many distinct BLOBS the store holds, against how many names point at
    ; them. The number content addressing is about, and the one a file pane
    ; can show a reader: twelve names and one blob is the same picture twelve
    ; times, stored once.
    fn fileBlobCount:int () {
        return (edit.imageMemory.blobCount())
    }

    ; What the template said that this layout cannot do — the editor's own
    ; report, reachable from the page so the stylesheet pane can show it while
    ; a reader is typing into it. A property that went nowhere silently is a
    ; template that looks broken to whoever wrote it.
    fn sheetReport:string () {
        return (edit.sheetReport())
    }

    ; Whether the LAYOUT has the store — not whether the page handed one over.
    ; Two different questions, and the gap between them is where a picture
    ; goes missing.
    fn imagesInLayout:boolean () {
        return edit.layout.haveImages
    }

    fn missingImages:int () {
        return edit.layout.missingImages
    }

    fn pictureBoxes:int () {
        def n:int 0
        def i:int 0
        while (i < (array_length edit.layout.boxes)) {
            def b:MdBox (itemAt edit.layout.boxes i)
            if (b.kind == 4) { n = (n + 1) }
            i = (i + 1)
        }
        return n
    }

    fn attachFont:boolean (name:string data:buffer) {
        def ok:boolean (fontManager.loadFontBuffer(name data))
        if ok {
            faceCount = (faceCount + 1)
            def m:TTFTextMeasurer (new TTFTextMeasurer(fontManager))
            measurer = m
            edit.setMeasurer(m)
        }
        ; …and the same bytes to the two editors' own text renderers, which
        ; measure and draw a slide and a Word page. The layout's names carry
        ; the variant — `Open Sans-Bold` — and those renderers take a family
        ; once and the rest as faces, reading the variant out of the file;
        ; so the plain family name goes in as the family and anything with a
        ; variant on its name goes in as a face.
        if ((indexOf name "-") >= 0) {
            deckWeb.addFace(data)
            docWeb.addFace(data)
        } {
            deckWeb.addFont(name data)
            docWeb.addFont(name data)
        }
        return ok
    }

    fn fontsReady:boolean () {
        return (faceCount > 0)
    }

    ; ----------------------------------------------------------------------
    ; The document
    ; ----------------------------------------------------------------------
    ; Opening a file. Not an edit: an undo across an open would put back text
    ; from a document the reader had closed.
    fn setSource:void (text:string) {
        edit.open(text)
        this.rebuild()
    }

    fn source:string () {
        return edit.source
    }

    fn setStyle:void (name:string) {
        styleName = name
        edit.styleName = name
        this.rebuild()
    }

    fn setPaged:void (v:boolean) {
        if v {
            this.setMode("paged")
        } {
            this.setMode("continuous")
        }
    }

    ; The three ways the same document is laid out: scrolled, printed, or
    ; presented. `PLAN_SLIDES.md`'s claim is that the last of those is a
    ; LAYOUT POLICY and not a conversion, and this is where that shows: one
    ; document, one tree, three calls into the same layout.
    fn setMode:void (name:string) {
        mode = name
        paged = ((name == "paged") || (name == "slides"))
        edit.slideMode = (name == "slides")
        this.rebuild()
    }

    fn currentMode:string () {
        return mode
    }

    ; ----------------------------------------------------------------------
    ; Three views, three documents
    ; ----------------------------------------------------------------------
    ;
    ; `PLAN_DOCUMENT_MODES.md` §4, arrived at from the other side. The plan
    ; put the destinations behind a deliberate one-way switch with a warning
    ; on it, and a reader using it found three buttons, two confirmations and
    ; no way to look at a deck without committing to one.
    ;
    ; So: three VIEWS, and each is its own document.
    ;
    ;   md    the markdown file, laid out. `MdEditController` edits it.
    ;   deck  a `PptxPresentation`, with the slide layout already on it.
    ;         `PptxEditor` edits it.
    ;   doc   a `RichDocument`. `DocxEditController` edits it.
    ;
    ; Converted on the way IN, and re-converted on the way in again only while
    ; nothing has been edited there. The moment a reader changes something in a
    ; view, that view is its own document and the markdown stops feeding it —
    ; which needs no confirmation to say, because it is what "editing" means.
    ; Carrying changes back into the `.md` is out of scope and always was.
    ;
    ; Nothing is refused for another view's sake. That is the whole reason the
    ; switch existed, and it is still true: a deck may hold what a deck holds.
    fn setView:boolean (name:string) {
        if (name == view) { return false }
        if (name == "md") {
            view = "md"
            built = false
            return true
        }
        if (name == "deck") {
            this.ensureDeck()
            view = "deck"
            built = false
            return true
        }
        if (name == "doc") {
            this.ensureDoc()
            view = "doc"
            built = false
            return true
        }
        return false
    }

    fn currentView:string () {
        return view
    }

    fn deckOwns:boolean () {
        return (view == "deck")
    }

    fn docOwns:boolean () {
        return (view == "doc")
    }

    ; Is that view what the CANVAS is drawing? `deckOn` and `docOn` say a
    ; document EXISTS — it was built when the reader went there and it keeps
    ; their edits while they are away — and `view` says which one is on
    ; screen. Drawing off the first alone is what made the DOCX page stay up
    ; after a click back on Preview: the document was still there, so the
    ; canvas still drew it.
    fn showsDeck:boolean () {
        if (! deckOn) { return false }
        return (view == "deck")
    }

    fn showsDoc:boolean () {
        if (! docOn) { return false }
        return (view == "doc")
    }

    ; Has this view been edited? A view nobody has touched is still a picture
    ; of the markdown and is rebuilt from it; one that has been is not.
    fn deckEdited:boolean () {
        return deckWeb.app.editor.dirty
    }

    fn docEdited:boolean () {
        if (! docOn) { return false }
        return (docModel.revision != docRev)
    }

    ; The deck, built from the markdown as it is now — unless the reader has
    ; been editing the one that is already there.
    fn ensureDeck:void () {
        this.sync()
        if deckOn {
            if (this.deckEdited()) { return }
            if (deckFrom == edit.source) { return }
        }
        this.attachDeck()
    }

    ; The presentation, handed to the slide editor. `attachPresentation` is
    ; what `loadBytes` does once it has parsed a file, minus the file: same
    ; editor, same selection, same undo, same strip.
    fn attachDeck:void () {
        def d:PptxDeck (this.buildDeck())
        deckWeb.app.attachPresentation(d.pres "markdown")
        deckWeb.app.setEditMode(true)
        deckOn = true
        deckFrom = edit.source
        built = false
    }

    ; …and the Word document, to the Word editor, the same way.
    fn attachDoc:void () {
        def x (new MdToDocx())
        if edit.haveImages { x.setImages(edit.imageStore "/") }
        ; The diagrams the layout already drew, so a fence is geometry here
        ; as it is in the preview and on the slide.
        x.setEmbeds(edit.layout.embeds)
        docModel = (x.build(edit.doc edit.layout.style))
        docSummary = (x.result.describe())
        docWeb.attachDocument(docModel)
        docWeb.setEditMode(true)
        ; Every page down the frame with a gap between them, the way a PDF
        ; viewer shows a document: in a pane that does not fit a page, one
        ; page that turns in place never shows where a page ends.
        docWeb.setContinuous(true)
        docRev = docModel.revision
        docOn = true
        docFrom = edit.source
        built = false
    }

    ; …and the one way a view that HAS been edited goes back to following the
    ; markdown: the reader asks for it by name.
    ;
    ; Deliberate rather than automatic, and the other way round from a
    ; confirmation: nothing is guarded on the way in, and the only thing that
    ; discards a reader's work is a thing they went and clicked.
    fn rebuildFromSource:boolean () {
        if (view == "deck") {
            this.sync()
            this.attachDeck()
            return true
        }
        if (view == "doc") {
            this.sync()
            this.attachDoc()
            return true
        }
        return false
    }

    fn ensureDoc:void () {
        this.sync()
        if docOn {
            if (this.docEdited()) { return }
            if (docFrom == edit.source) { return }
        }
        this.attachDoc()
    }

    fn docReport:string () {
        return docSummary
    }

    fn docParagraphCount:int () {
        if (! docOn) { return 0 }
        return (array_length docModel.paragraphs)
    }

    ; The Word document, drawn — the whole editor frame: the strip, the
    ; ruler, the page centred under them, the status line. `DocxApp` builds
    ; it, exactly as it does for the docx page; this file does not know where
    ; the page sits in the window and must not.
    fn wordList:EVGDisplayList () {
        return (docWeb.app.buildDisplayList())
    }

    fn deckSlideCount:int () {
        if (! deckOn) { return 0 }
        return (deckWeb.slideCount())
    }

    fn deckShapeCount:int () {
        if (! deckOn) { return 0 }
        def sl@(optional):PptxSlide (deckWeb.app.currentSlide())
        if (null? sl) { return 0 }
        def s:PptxSlide (unwrap sl)
        return (array_length s.shapes)
    }

    fn deckSelection:int () {
        if (! deckOn) { return 0 }
        return (deckWeb.app.editor.selectionCount())
    }

    ; The deck, drawn — the whole editor frame: the desk, the slide fitted
    ; and centred on it, the thumbnails down the side, the strip, the
    ; selection handles, the caret. `PptxApp.buildFrame` is what the pptx
    ; page draws; a slide drawn any other way here is a second painter, and
    ; the one this page had could not draw a path.
    fn deckList:EVGDisplayList () {
        return (deckWeb.app.buildFrame())
    }

    ; How many blocks a slide had to be cut in half for, and what the deck
    ; said should happen when one is. Nothing else prints this, and a deck
    ; that silently loses the third bullet is worse than one that says so.
    fn slideReport:string () {
        if (! edit.slideMode) { return "" }
        def n:int edit.layout.slideOverflows
        def out:string ((("split-level " + (to_string edit.layout.splitLevel)) + ", overflow ") + edit.layout.slideOverflow)
        if (n > 0) {
            out = ((out + " — ") + (to_string n)) + " blocks cut across slides"
        }
        return out
    }

    ; The company template. One string, because that is what survives the JS
    ; bridge without a wrapper on either side, and because a stylesheet IS one
    ; string — the page fetches the file and hands it over.
    fn setStyleSheet:void (css:string) {
        edit.setStyleSheet(css)
        this.rebuild()
    }

    ; …and the same thing under a NAME, so a document can ask for it itself
    ; with `theme: corporate` in its front matter. The page registers every
    ; template it has once, at startup; which one is used is then the
    ; document's business until the reader says otherwise.
    fn addTheme:void (name:string css:string) {
        edit.addTheme(name css)
        this.rebuild()
    }

    ; Which template the last layout used and where it came from — the reader,
    ; the document, or nowhere. A document that names a template this page has
    ; never heard of says so here rather than being laid out plain in silence.
    fn themeReport:string () {
        return edit.themeSource
    }

    fn themeInUse:string () {
        if ((strlen edit.styleCss) > 0) { return "" }
        return edit.themeUsed
    }

    ; What the template said that this layout cannot honour, as one line —
    ; §8.4: a silent property is a template that looks broken to whoever
    ; wrote it, so the page can show this beside the document.
    fn styleSheetReport:string () {
        return (edit.sheetReport())
    }

    fn styleSheetErrors:int () {
        return edit.sheetErrors
    }

    ; `a4`, `a4 landscape`, `letter`, `210x297mm` — whatever `MdFrontMatter`
    ; reads, because the front matter and this are the same setting arriving
    ; from two places. Empty means "whatever the document said".
    fn setPageSize:void (name:string) {
        wantPageSize = name
        this.rebuild()
    }

    fn currentPageSize:string () {
        return wantPageSize
    }

    ; How far right the sheets are drawn. Zero in continuous mode, and in
    ; paged mode whatever centres the paper in the window.
    fn sheetLeft:double () {
        if (! paged) { return 0.0 }
        def spare:double (viewW - edit.layout.style.pageWidth)
        if (spare <= 0.0) { return 0.0 }
        return (spare * 0.5)
    }

    ; The camera on the list. An editor's frame is already in screen
    ; coordinates — it placed its own page, its own strip — so over one the
    ; camera is the identity; over the markdown it is the sheet's offset and
    ; the scroll.
    fn cameraX:double () {
        if (this.showsEditor()) { return 0.0 }
        return (this.sheetLeft())
    }

    fn cameraY:double () {
        if (this.showsEditor()) { return 0.0 }
        return (0.0 - scrollY)
    }

    fn showsEditor:boolean () {
        if (this.showsDeck()) { return true }
        return (this.showsDoc())
    }

    ; --- which page a reader is looking at ------------------------------------
    ;
    ; The one under the top third of the window, which is where a reader's eye
    ; is rather than at the very top: a page whose last line is just visible is
    ; not the page they are on.
    fn pageAt:int () {
        this.sync()
        if (! paged) { return 0 }
        def gap:double (MdToEvg.sheetGap())
        def step:double (edit.layout.style.pageHeight + gap)
        if (step <= 0.0) { return 0 }
        def at:double ((scrollY + (viewH * 0.33)) - gap)
        def p:int (to_int (at / step))
        if (p < 0) { p = 0 }
        if (p >= edit.layout.pageCount) { p = (edit.layout.pageCount - 1) }
        return p
    }

    fn pageCountNow:int () {
        this.sync()
        return edit.layout.pageCount
    }

    ; …and jumping to one, which is the other half of saying which it is.
    fn scrollToPage:void (p:int) {
        this.sync()
        if (! paged) { return }
        def gap:double (MdToEvg.sheetGap())
        def i:int p
        if (i < 0) { i = 0 }
        if (i >= edit.layout.pageCount) { i = (edit.layout.pageCount - 1) }
        this.scrollTo(((to_double i) * (edit.layout.style.pageHeight + gap)))
    }

    fn resize:void (w:double h:double) {
        def changed:boolean (w != viewW)
        viewW = w
        viewH = h
        ; The editors fill the canvas, so both are told — whichever is on
        ; screen — and the frame on screen is built again.
        deckWeb.resize((to_int w) (to_int h))
        docWeb.frameSize((to_int w) (to_int h))
        if (this.showsEditor()) { built = false }
        if changed {
            this.rebuild()
        }
    }

    fn rebuild:void () {
        edit.styleName = styleName
        edit.viewWidth = viewW
        if paged {
            edit.sheetGap = (MdToEvg.sheetGap())
        } {
            edit.sheetGap = (0.0 - 1.0)
        }
        edit.pageSize = wantPageSize
        edit.stale = true
        edit.ensureLayout()
        blocks = (edit.doc.childCount())
        diagrams = edit.diagrams
        pages = edit.layout.pageCount
        this.buildList()
        built = true
        this.setStatus()
    }

    ; Everything that reads geometry goes through here first, so a keystroke
    ; that has not been laid out yet cannot be drawn from a stale box list.
    fn sync:void () {
        ; A DECK edit does not make the markdown stale — the markdown is a
        ; record of where the deck came from and nothing edits it any more —
        ; so `stale` alone never rebuilt the list and a redrawn diagram
        ; stayed on the canvas exactly as it was. The model changed and the
        ; page did not, which is the worst shape a bug can take: the reader
        ; is told it worked.
        if (this.showsDoc()) {
            def fresh:boolean (listFor == "doc")
            if ((! built) || (! fresh)) {
                this.buildList()
                built = true
                this.setStatus()
            }
            return
        }
        if (this.showsDeck()) {
            def deckFresh:boolean (listFor == "deck")
            if ((! built) || (! deckFresh)) {
                this.buildList()
                built = true
                this.setStatus()
            }
            return
        }
        if edit.stale {
            this.rebuild()
            return
        }
        ; The markdown is laid out and did not change — but the list on the
        ; canvas may still be the deck's or the Word document's, because those
        ; were built while the reader was over there.
        if (! (listFor == "md")) {
            this.buildList()
            built = true
            this.setStatus()
        }
    }

    ; The whole document as one display list, in document coordinates.
    ;
    ; Paged mode stacks the sheets with a gap, so scrolling through a printed
    ; document shows what will be printed — the same call, the same breaks,
    ; and the reader can see where page four starts before they print it.
    fn buildList:void () {
        listRev = (listRev + 1)
        ; Once the deck owns the document, the deck is what is drawn. The
        ; markdown is still parsed and laid out above — it is where the deck
        ; came from and the pane still shows it — but nothing on the canvas
        ; comes from it any more.
        if (this.showsDoc()) {
            docList = (this.wordList())
            listFor = "doc"
            return
        }
        if (this.showsDeck()) {
            docList = (this.deckList())
            listFor = "deck"
            return
        }
        listFor = "md"
        ; Straight to the commands: the canvas never wanted an element tree,
        ; and building one only to walk it back was 133 ms of a 342 ms
        ; document. `MarkdownTest.presized` holds the two roads to the same
        ; marks, command by command.
        def out:EVGDisplayList (new EVGDisplayList())
        if paged {
            out = (MdToEvg.sheetsToDisplayList(edit.layout (MdToEvg.sheetGap())))
        } {
            out = (MdToEvg.toDisplayList(edit.layout viewW))
        }
        docList = out
    }

    fn setStatus:void () {
        def b:string (to_string blocks)
        def d:string (to_string diagrams)
        def n:int (array_length docList.cmds)
        def c:string (to_string n)
        def h:int (to_int (this.documentHeight()))
        statusText = ((((b + " blocks, ") + d) + " diagrams, ") + c + " draw commands")
        if paged {
            statusText = ((statusText + ", ") + (to_string pages) + " pages")
        }
    }

    ; ----------------------------------------------------------------------
    ; Scrolling and painting
    ; ----------------------------------------------------------------------
    fn documentHeight:double () {
        if paged {
            def gap:double (MdToEvg.sheetGap())
            def n:double (to_double edit.layout.pageCount)
            return ((n * (edit.layout.style.pageHeight + gap)) - gap)
        }
        return edit.layout.documentHeight
    }

    fn maxScroll:double () {
        def h:double (this.documentHeight())
        def m:double (h - viewH)
        if (m < 0.0) { return 0.0 }
        return m
    }

    fn scrollTo:void (y:double) {
        def m:double (this.maxScroll())
        def want:double y
        if (want < 0.0) { want = 0.0 }
        if (want > m) { want = m }
        scrollY = want
    }

    fn scrollBy:void (dy:double) {
        def y:double (scrollY + dy)
        this.scrollTo(y)
    }

    ; The whole document plus where it is looked at from, in the envelope the
    ; WebGL painter reads: `{width, height, view, list, chrome, rev}`. The list
    ; alone is what `toJson` gives, and the painter reaches for `doc.list.cmds`
    ; — handing it the bare list is a page that draws nothing and says
    ; "cannot read properties of undefined".
    ;
    ; THE DOCUMENT AND THE CHROME ARE TWO LISTS. The document is in document
    ; coordinates and `view` says where the window on it is; the caret and the
    ; selection are in screen coordinates and carry no camera, because they are
    ; the same 1.6 points wide wherever the document is. That is what lets a
    ; host build the document once and redraw a blink without it: a caret
    ; blinks and moves without a character changing, and serialising a
    ; forty-page document to draw a two-point rectangle is the difference
    ; between an editor that types and one that stutters.
    ;
    ; `viewFrame` is this without the document, which is what a scroll needs.
    fn frame:string () {
        this.sync()
        docList.setView((this.cameraX()) (this.cameraY()) 1.0)
        def body:string (docList.toJson())
        def head:string (this.frameHead())
        return (((head + ",\"list\":") + body) + "}")
    }

    ; A frame with no document in it: the camera, the chrome and the build
    ; number. A host that already holds the built document draws it again from
    ; these three — so a scroll or a blink costs a caret's worth of JSON
    ; rather than the document's, and nothing walks the commands at all.
    fn viewFrame:string () {
        this.sync()
        return ((this.frameHead()) + "}")
    }

    ; What both share: the canvas, the camera, the chrome and the build number.
    ; The camera is written out whatever it is, including the identity one at
    ; the top of a continuous document — a host reading `doc.view` should not
    ; have to know that the list drops a camera that does nothing.
    fn frameHead:string () {
        def chrome:EVGDisplayList (new EVGDisplayList())
        this.paintChrome(chrome)
        def w:string (EVGDisplayList.num(viewW))
        def h:string (EVGDisplayList.num(viewH))
        def dx:double (this.cameraX())
        def dy:double (this.cameraY())
        def vx:string (EVGDisplayList.fine(dx))
        def vy:string (EVGDisplayList.fine(dy))
        def out:string (((("{\"width\":" + w) + ",\"height\":") + h) + ",\"view\":[")
        out = ((((out + vx) + ",") + vy) + ",1]")
        out = ((out + ",\"rev\":") + (to_string listRev))
        out = ((out + ",\"chrome\":") + (chrome.toJson()))
        return out
    }

    ; ----------------------------------------------------------------------
    ; The caret, and the band behind a selection
    ; ----------------------------------------------------------------------
    ;
    ; Drawn as ordinary rectangles into a display list — its own, beside the
    ; document's — so every painter that can draw the document can draw the
    ; caret and none of them learns what a caret is. That is the data seam
    ; `gallery/PLAN_EDITOR_KERNEL.md` §2 prefers, and here it means the SDL
    ; host and the WebGL one get an editor without being told.
    fn paintChrome:void (out:EVGDisplayList) {
        if (! editing) { return }
        ; An editor paints its own caret and its own selection, in its own
        ; frame. The markdown's would be a second caret over a slide.
        if (this.showsEditor()) { return }
        def sel:EVGColor (EVGColor.rgba(9 105 218 0.22))
        def ink:EVGColor (EVGColor.rgba(31 35 40 1.0))
        def dx:double (this.sheetLeft())
        def a:int (edit.selStart())
        def b:int (edit.selEnd())
        def n:int (edit.lines.count())
        def i:int 0
        while (i < n) {
            def top:double ((edit.lines.topAt(i)) - scrollY)
            def h:double (edit.lines.heightAt(i))
            ; Only what is on screen. A hundred-page document has a hundred
            ; pages of lines and one of them is being looked at.
            if (((top + h) > 0.0) && (top < viewH)) {
                if (b > a) {
                    def ls:int (edit.lines.startAt(i))
                    def le:int (edit.lines.endAt(i))
                    def from:int a
                    def to:int b
                    if (from < ls) { from = ls }
                    if (to > le) { to = le }
                    if (to > from) {
                        def x0:double ((edit.xOnLine(i from)) + dx)
                        def x1:double ((edit.xOnLine(i to)) + dx)
                        if ((x0 >= dx) && (x1 > x0)) {
                            out.addRect(x0 top (x1 - x0) h sel)
                        }
                    }
                }
            }
            i = (i + 1)
        }
        if (caretOn) {
            def cx:double ((edit.caretX()) + dx)
            if (cx >= dx) {
                def li:int (OfficeLineNav.indexOfOffset(edit.lines (edit.caret())))
                if (li >= 0) {
                    def ct:double ((edit.lines.topAt(li)) - scrollY)
                    def ch:double (edit.lines.heightAt(li))
                    if (((ct + ch) > 0.0) && (ct < viewH)) {
                        out.addRect(cx (ct + 1.0) 1.6 (ch - 2.0) ink)
                    }
                }
            }
        }
    }

    fn commandCount:int () {
        return (array_length docList.cmds)
    }

    ; ----------------------------------------------------------------------
    ; What the page asks about
    ; ----------------------------------------------------------------------
    fn status:string () {
        return statusText
    }

    fn ready:boolean () {
        return built
    }

    fn scrollPosition:double () {
        return scrollY
    }

    fn diagramCount:int () {
        return diagrams
    }

    fn blockCount:int () {
        return blocks
    }

    ; ----------------------------------------------------------------------
    ; The editor, as the page reaches it
    ; ----------------------------------------------------------------------
    ;
    ; **These are `docx_web.rgr`'s names.** `click`, `typeText`, `key`,
    ; `paste`, `copySelection`, `cutSelection`, `undo`, `redo`, `caretJson`,
    ; `run`. Not because a base class is coming — `gallery/PLAN_EDITOR_KERNEL.md`
    ; §7 explains why there should not be — but because the two hosts then
    ; differ only where the documents do, and a page written against one is
    ; readable by anyone who has read the other.
    ;
    ; Every one of them is a call into `MdEditController`. There is no state
    ; here: the source, the caret, the selection and the undo stack are all
    ; the controller's, and the textarea in the page is a second VIEW of them
    ; rather than a second copy.

    fn setEditMode:void (on:boolean) {
        editing = on
    }

    fn editMode:boolean () {
        return editing
    }

    ; The page owns the blink, so a document nobody is looking at is not
    ; redrawn twice a second.
    fn setCaretOn:void (on:boolean) {
        caretOn = on
    }

    fn click:void (x:double y:double extend:boolean) {
        this.sync()
        if (this.showsDeck()) {
            ; A click on a deck is a press and a release through the slide
            ; editor's own frame — the strip, the panel, the slide, in the
            ; order the app decides — and what it selects is `PptxEditor`'s
            ; answer. The page normally sends these itself through the shared
            ; host module; this is the same two calls for a caller that has
            ; only a point.
            deckWeb.mods(extend false)
            deckWeb.pointerAt((to_int x) (to_int y) true true false)
            deckWeb.pointerAt((to_int x) (to_int y) false false true)
            built = false
            return
        }
        if (this.showsDoc()) {
            docWeb.framePointer((to_int x) (to_int y) true true false extend)
            docWeb.framePointer((to_int x) (to_int y) false false true extend)
            built = false
            return
        }
        edit.clickAt((x - (this.sheetLeft())) (y + scrollY) extend)
    }

    ; Moving what is selected, in points. The page owns the gesture; the deck
    ; owns what it means.
    fn deckMove:boolean (dx:double dy:double) {
        if (! (this.showsDeck())) { return false }
        def ok:boolean (deckWeb.app.editor.moveSelection(dx dy))
        if ok { built = false }
        return ok
    }

    ; ----------------------------------------------------------------------
    ; A drawing on the deck, read back and drawn again
    ; ----------------------------------------------------------------------
    ;
    ; Once the deck owns the document the markdown pane has nothing to edit —
    ; it is a record of where the deck came from. Selecting a DRAWING gives it
    ; something again: the diagram's own source, which is a thing a reader
    ; edits and which redraws in place.
    ;
    ; The readers are the ones that already draw a diagram and the drawing is
    ; `PptxFromEvg`'s; see `MdDeckDiagram`. Nothing about a notation is known
    ; in this file.
    fn deckDiagramSource:string () {
        def sh@(optional):PptxShape (deckWeb.app.editor.firstSelected())
        if (null? sh) { return "" }
        def s:PptxShape (unwrap sh)
        if (! (MdDeckDiagram.isDrawing(s))) { return "" }
        return (MdDeckDiagram.sourceOf(s))
    }

    fn deckDiagramNotation:string () {
        def sh@(optional):PptxShape (deckWeb.app.editor.firstSelected())
        if (null? sh) { return "" }
        def s:PptxShape (unwrap sh)
        if (! (MdDeckDiagram.isDrawing(s))) { return "" }
        return (MdDeckDiagram.notationOf(s))
    }

    ; `false` when the text does not read as a diagram, and the drawing is
    ; then exactly as it was — a reader halfway through typing a node has a
    ; source that does not parse, and blanking their slide at every keystroke
    ; would be worse than useless.
    fn deckRedrawDiagram:boolean (source:string) {
        def sh@(optional):PptxShape (deckWeb.app.editor.firstSelected())
        if (null? sh) { return false }
        def s:PptxShape (unwrap sh)
        def ok:boolean (MdDeckDiagram.redraw(s source styleName))
        if ok {
            def sl@(optional):PptxSlide (deckWeb.app.currentSlide())
            if (!null? sl) {
                deckWeb.app.editor.touchSlide((unwrap sl))
            }
            built = false
        }
        return ok
    }

    fn deckGoTo:void (i:int) {
        if (! (this.showsDeck())) { return }
        deckWeb.gotoSlide(i)
        built = false
    }

    ; A drag, and a double-click. Separate from `click` because a page can
    ; tell them apart and the module cannot.
    fn dragTo:void (x:double y:double) {
        this.sync()
        edit.clickAt((x - (this.sheetLeft())) (y + scrollY) true)
    }

    fn selectWordAt:void (x:double y:double) {
        this.sync()
        edit.clickAt((x - (this.sheetLeft())) (y + scrollY) false)
        edit.selectWord()
    }

    ; A keystroke on the PREVIEW. Refused while the markdown pane owns the
    ; document — and refused by name, because a keystroke that vanishes and a
    ; keystroke that was declined look the same on the page and completely
    ; different to a reader.
    fn typeText:void (v:string) {
        if (this.showsDoc()) {
            docWeb.typeText(v)
            built = false
            return
        }
        if (this.showsDeck()) {
            deckWeb.type(v false false)
            built = false
            return
        }
        if (! (this.mayWriteInPreview())) { return }
        edit.insertText(v)
    }

    ; A keystroke on the canvas. It edits whatever the view on screen is: the
    ; markdown in `md`, and in the other two the view has its own editor and
    ; never reaches here at all.
    fn mayWriteInPreview:boolean () {
        ownerRefusal = ""
        return true
    }

    ; …and the same question from the other side. A pane that is read-only and
    ; still accepts input is the failure worth catching, so the refusal is
    ; here rather than in the page's event handlers: the page can forget, the
    ; document cannot.
    ; …and an edit from the markdown pane, which is always the markdown's own
    ; and is therefore always allowed. A deck or a document a reader has built
    ; from it is a separate document and is simply not affected.
    fn mayWriteInSource:boolean () {
        ownerRefusal = ""
        return true
    }

    ; The keys that are not characters. `name` is the page's own spelling —
    ; the same set `docx_web` takes.
    fn key:boolean (name:string shift:boolean ctrl:boolean) {
        this.sync()
        ; An editor's keys are the editor's. The page normally sends them
        ; through the shared host modules; these are the same calls for a
        ; caller that has only a name.
        if (this.showsDoc()) {
            def tookDoc:boolean (docWeb.frameKey(name shift ctrl))
            built = false
            return tookDoc
        }
        if (this.showsDeck()) {
            if (ctrl && ((strlen name) == 1)) {
                deckWeb.type(name shift true)
            } {
                def dn:string name
                if (name == "delete") { dn = "del" }
                deckWeb.keyMod(dn shift ctrl)
            }
            built = false
            return true
        }
        ; Moving and selecting are not writing: a read-only preview is one a
        ; reader can still navigate and copy out of, which is what the source
        ; map was built for.
        if (MarkdownWeb.isWritingKey(name ctrl)) {
            if (! (this.mayWriteInPreview())) { return false }
        }
        if ctrl {
            if (name == "b") { return (this.run("format.bold" "")) }
            if (name == "i") { return (this.run("format.italic" "")) }
            if (name == "e") { return (this.run("format.code" "")) }
            if (name == "z") { edit.undo() return true }
            if (name == "y") { edit.redo() return true }
            if (name == "a") { edit.selectAll() return true }
            if (name == "left")  { edit.moveWordLeft(shift)  return true }
            if (name == "right") { edit.moveWordRight(shift) return true }
            if (name == "home")  { edit.moveDocEdge(false shift) return true }
            if (name == "end")   { edit.moveDocEdge(true shift)  return true }
        }
        if (name == "left")      { edit.moveLeft(shift)  return true }
        if (name == "right")     { edit.moveRight(shift) return true }
        if (name == "up")        { edit.moveUp(shift)    return true }
        if (name == "down")      { edit.moveDown(shift)  return true }
        if (name == "home")      { edit.moveLineEdge(false shift) return true }
        if (name == "end")       { edit.moveLineEdge(true shift)  return true }
        if (name == "pageUp")    { edit.movePage(false viewH shift) return true }
        if (name == "pageDown")  { edit.movePage(true viewH shift)  return true }
        if (name == "backspace") { edit.backspace()   return true }
        if (name == "delete")    { edit.deleteForward() return true }
        if (name == "enter")     { edit.splitAtCaret() return true }
        return false
    }

    ; The toolbar. One door for every intent, so the page holds no rules and a
    ; new command is a row here rather than a branch in JavaScript.
    fn run:boolean (id:string arg:string) {
        this.sync()
        ; A command on an editor's view is that editor's command — `edit.undo`
        ; on the deck is the deck's undo, not the markdown's — under the names
        ; its own command table holds.
        if (this.showsDeck()) {
            def okDeck:boolean (deckWeb.run(id arg))
            built = false
            return okDeck
        }
        if (this.showsDoc()) {
            def okDoc:boolean (docWeb.run(id arg))
            built = false
            return okDoc
        }
        if (id == "format.bold")   { return (edit.toggleBold()) }
        if (id == "format.italic") { return (edit.toggleItalic()) }
        if (id == "format.code")   { return (edit.toggleCode()) }
        if (id == "format.strike") { return (edit.toggleStrike()) }
        if (id == "format.link")   { return (edit.toggleLink(arg)) }
        if (id == "block.heading") { return (edit.setHeading((?? (str2int arg) 0))) }
        if (id == "block.bullet")  { return (edit.toggleLinePrefix("bullet")) }
        if (id == "block.ordered") { return (edit.toggleLinePrefix("ordered")) }
        if (id == "block.quote")   { return (edit.toggleLinePrefix("quote")) }
        if (id == "slide.break")   { return (edit.toggleBlockClass("slide")) }
        if (id == "slide.keep")    { return (edit.toggleBlockClass("no-break")) }
        if (id == "edit.undo")     { edit.undo() return true }
        if (id == "edit.redo")     { edit.redo() return true }
        if (id == "edit.selectAll") { edit.selectAll() return true }
        return false
    }

    ; Why the last command did nothing, or "". A refusal and a no-op look the
    ; same to a document and completely different to a reader.
    ; ----------------------------------------------------------------------
    ; MD + CSS: an allowlist, not a gate
    ; ----------------------------------------------------------------------
    ;
    ; `PLAN_DOCUMENT_MODES.md` §4. The lossless mode is not "anything, minus
    ; what we thought to refuse" — that is the design §3 rejects, and today's
    ; bug is a gate with one hole in it. It is an ENUMERATED list in which
    ; every command names the file it writes.
    ;
    ; So there are two questions a caller can ask, and both are answerable
    ; without trying anything: what may I do, and which file does it touch.
    ; A command that is not on the list does not exist.
    fn styleCommands:string () {
        def out:string ""
        out = (out + "page.width:css:page/width|")
        out = (out + "page.height:css:page/height|")
        out = (out + "page.margin:css:page/padding|")
        out = (out + "page.background:css:page/background-color|")
        out = (out + "page.backgroundImage:css:page/background-image|")
        out = (out + "text.family:css:document/font-family|")
        out = (out + "text.size:css:document/font-size|")
        out = (out + "text.color:css:document/color|")
        out = (out + "text.lineHeight:css:document/line-height|")
        out = (out + "heading.family:css:h1/font-family|")
        out = (out + "link.color:css:link/color|")
        out = (out + "code.background:css:code/background-color|")
        out = (out + "table.border:css:table/border-color|")
        out = (out + "deck.splitLevel:css:deck/split-level|")
        return out
    }

    ; Which file a command writes: "css", "markdown", or "" when there is no
    ; such command. The question a reader is entitled to have answered BEFORE
    ; they press anything.
    fn commandTarget:string (id:string) {
        def all:string (this.styleCommands())
        def hit:int (indexOf all (id + ":css:"))
        if (hit >= 0) { return "css" }
        if (id == "format.bold") { return "markdown" }
        if (id == "format.italic") { return "markdown" }
        if (id == "format.code") { return "markdown" }
        if (id == "format.strike") { return "markdown" }
        if (id == "format.link") { return "markdown" }
        if (id == "block.heading") { return "markdown" }
        if (id == "block.bullet") { return "markdown" }
        if (id == "block.ordered") { return "markdown" }
        if (id == "block.quote") { return "markdown" }
        if (id == "slide.break") { return "markdown" }
        if (id == "slide.keep") { return "markdown" }
        return ""
    }

    ; One style command. The sheet is rewritten as TEXT — see `MdCssEdit` for
    ; why not by parsing and printing — and the page is laid out again with
    ; what came out, so the reader sees the sheet they now have rather than the
    ; one they asked for.
    fn runStyle:boolean (id:string value:string) {
        if (this.commandTarget(id) != "css") {
            ownerRefusal = ("there is no style command called " + id)
            return false
        }
        def target:string (this.targetOf(id))
        def slash:int (indexOf target "/")
        if (slash < 0) { return false }
        def sel:string (substring target 0 slash)
        def prop:string (substring target (slash + 1) (strlen target))
        def before:string (edit.sheet.text())
        def after:string (MdCssEdit.setProperty(before sel prop value))
        if (after == before) {
            ownerRefusal = "that changed nothing"
            return false
        }
        this.setStyleSheet(after)
        ownerRefusal = ""
        return true
    }

    ; What the sheet says for a command right now, so a control can be shown
    ; holding the value it is about to change.
    fn styleValue:string (id:string) {
        def target:string (this.targetOf(id))
        def slash:int (indexOf target "/")
        if (slash < 0) { return "" }
        def sel:string (substring target 0 slash)
        def prop:string (substring target (slash + 1) (strlen target))
        def text:string (edit.sheet.text())
        return (MdCssEdit.getProperty(text sel prop))
    }

    fn targetOf:string (id:string) {
        def all:string (this.styleCommands())
        def key:string (id + ":css:")
        def at:int (indexOf all key)
        if (at < 0) { return "" }
        def from:int (at + (strlen key))
        def i:int from
        while (i < (strlen all)) {
            if ((charAt all i) == 124) { return (substring all from i) }
            i = (i + 1)
        }
        return (substring all from (strlen all))
    }

    fn styleText:string () {
        return (edit.sheet.text())
    }

    fn refusal:string () {
        if ((strlen ownerRefusal) > 0) { return ownerRefusal }
        return (edit.refusal())
    }

    fn copySelection:string () {
        if (this.showsDoc()) { return (docWeb.copySelection()) }
        if (this.showsDeck()) { return "" }
        return (edit.selectedText())
    }

    fn cutSelection:string () {
        if (this.showsDoc()) {
            built = false
            return (docWeb.cutSelection())
        }
        if (this.showsDeck()) { return "" }
        def v:string (edit.selectedText())
        if ((strlen v) > 0) {
            edit.deleteSelection()
        }
        return v
    }

    fn paste:void (v:string) {
        edit.paste(v)
    }

    ; Both clipboard flavours, as `docx_web.paste` takes them. A spreadsheet
    ; range carries a real `<table>` in the HTML one and tab-separated text in
    ; the other, and only one of the two is a table when it lands. Answers
    ; whether a table was made, so the page can say so.
    fn pasteRich:boolean (html:string text:string) {
        this.sync()
        if (this.showsDoc()) {
            built = false
            return (docWeb.paste(html text))
        }
        if (this.showsDeck()) { return false }
        return (edit.pasteRich(html text))
    }

    fn undo:void () {
        if (this.showsEditor()) { this.run("edit.undo" "") return }
        edit.undo()
    }

    fn redo:void () {
        if (this.showsEditor()) { this.run("edit.redo" "") return }
        edit.redo()
    }

    fn canUndo:boolean () {
        if (this.showsDeck()) { return (deckWeb.app.editor.canUndo()) }
        if (this.showsDoc()) { return false }
        return (edit.canUndo())
    }

    fn canRedo:boolean () {
        if (this.showsDeck()) { return (deckWeb.app.editor.canRedo()) }
        if (this.showsDoc()) { return false }
        return (edit.canRedo())
    }

    ; Where the caret is, for the page to put its own in the same place. The
    ; textarea is a second view of one source, and this is how it follows.
    fn caretJson:string () {
        this.sync()
        def cx:double ((edit.caretX()) + (this.sheetLeft()))
        def li:int (OfficeLineNav.indexOfOffset(edit.lines (edit.caret())))
        def cy:double 0.0
        def ch:double 0.0
        if (li >= 0) {
            cy = ((edit.lines.topAt(li)) - scrollY)
            ch = (edit.lines.heightAt(li))
        }
        def out:string "{\"offset\":"
        out = (out + (to_string (edit.caret())))
        out = (out + ",\"anchor\":")
        out = (out + (to_string (edit.selStart())))
        out = (out + ",\"focus\":")
        out = (out + (to_string (edit.selEnd())))
        out = (out + ",\"x\":")
        out = (out + (EVGDisplayList.num(cx)))
        out = (out + ",\"y\":")
        out = (out + (EVGDisplayList.num(cy)))
        out = (out + ",\"h\":")
        out = (out + (EVGDisplayList.num(ch)))
        out = (out + "}")
        return out
    }

    ; The OTHER pane's edit. The textarea is a second view of one source, so
    ; what it does has to arrive as a patch like everything else — replacing
    ; the whole text would make every keystroke in it one undo of the entire
    ; document, and would throw away the history the canvas built.
    ;
    ; The page computes the range by comparing what it has with `sourceText()`,
    ; which is a common prefix and a common suffix and is fifteen lines of
    ; JavaScript. It is not a diff algorithm and does not need to be: a
    ; textarea reports one contiguous change at a time.
    ; An edit from the MARKDOWN pane. Refused once the preview owns the
    ; document.
    fn applyPatch:void (start:int end:int text:string) {
        if (! (this.mayWriteInSource())) { return }
        this.sync()
        edit.setRange(start end)
        edit.insertText(text)
    }

    ; Which key names change the document. Everything else moves a caret.
    sfn isWritingKey:boolean (name:string ctrl:boolean) {
        if ctrl {
            if (name == "b") { return true }
            if (name == "i") { return true }
            if (name == "e") { return true }
            if (name == "z") { return true }
            if (name == "y") { return true }
            return false
        }
        if (name == "backspace") { return true }
        if (name == "delete") { return true }
        if (name == "enter") { return true }
        return false
    }

    ; The drawn lines, as the caret navigates them: `[start,end]` per line, in
    ; document order. Not chrome — it is what `OfficeLineNav` walks, and a
    ; caret that lands on the wrong line is a question about THIS and nothing
    ; else. The page's checks print it when a move goes somewhere unexpected.
    fn linesJson:string () {
        this.sync()
        def out:string "["
        def i:int 0
        def n:int (edit.lines.count())
        while (i < n) {
            if (i > 0) { out = (out + ",") }
            out = (out + "[")
            out = (out + (to_string (edit.lines.startAt(i))))
            out = (out + ",")
            out = (out + (to_string (edit.lines.endAt(i))))
            out = (out + "]")
            i = (i + 1)
        }
        return (out + "]")
    }

    ; The page's caret, moved into the module: the textarea is the other view
    ; and this is how IT leads.
    fn setSelection:void (a:int b:int) {
        this.sync()
        edit.setRange(a b)
    }

    ; The source, after whatever the canvas did to it. The page writes this
    ; back into the textarea — it does not keep its own copy.
    fn sourceText:string () {
        return edit.source
    }

    fn sourceVersion:int () {
        return ((edit.history.depth()) + (edit.history.redoDepth()))
    }

    ; The deck, as a `.pptx` a reader can open and change the number in.
    ;
    ; Built from a layout of its own, the way the PDF is, and from the same
    ; three things in the same order — the template, the document's metadata,
    ; the reader's page size — because a deck that is not the slides the
    ; reader was looking at is not an export of anything.
    ;
    ; `MdToPptx` picks the road per BLOCK: a heading, a paragraph, a list or a
    ; table go out as text PowerPoint can reflow; a diagram goes out as
    ; shapes. What did not go out as text is counted, and `pptxReport` says
    ; so — see `PLAN_SLIDES.md` §2 for why that is the whole design.
    ; The deck, as a MODEL rather than as a file.
    ;
    ; Split out of `pptx()` so that the switch in §5 of
    ; `PLAN_DOCUMENT_MODES.md` can hand the presentation to the real editor
    ; instead of a byte string — and so that saving an EDITED deck is the same
    ; call as saving a fresh one, with nothing rebuilt behind the reader's
    ; back.
    fn buildDeck:PptxDeck () {
        def deck:MdLayout (new MdLayout())
        if (!null? measurer) {
            deck.setMeasurer((unwrap measurer))
        }
        deck.style = (new MdStyle())
        ; A deck's own defaults, under whatever the template and the
        ; document say: a landscape sheet, and text set for a room rather
        ; than a desk. The deck used to take the document's A4 portrait and
        ; its 11-point body, which is a page and not a slide. A template that
        ; states a size or a page that names one still wins — these are the
        ; answer when nobody said.
        MarkdownWeb.deckDefaults(deck.style)
        edit.sheet.applyTo(deck.style)
        deck.setStyleSheet(edit.styleCss)
        ; The same byte store the PREVIEW reads. This layout is built fresh —
        ; a deck has its own page size and its own breaks — and a fresh layout
        ; with no store is a deck missing pictures the reader can see on the
        ; page in front of them.
        if edit.haveImages { deck.setImages(edit.imageStore "/") }
        deck.applyMeta(edit.doc)
        ; NOT the sheet the page's dropdown names. That dropdown is the
        ; markdown's — the PDF tab and the paged preview print on it — and a
        ; deck is not a document on that paper: a reader who picked A4
        ; portrait for their print got a portrait deck, which is a poster.
        ; The deck's sheet is its own default, the document's front matter,
        ; or a template's `page` rule.
        def cw:double (deck.style.pageWidth - (deck.style.margin * 2.0))
        MdDiagram.prepare(edit.doc deck.embeds cw styleName)
        deck.applySlideMeta(edit.doc)
        deck.layoutSlides(edit.doc)
        def x (new MdToPptx())
        def d:PptxDeck (x.deck(edit.doc deck))
        pptxSummary = (x.result.describe())
        pptxNotes = ""
        def i:int 0
        while (i < (x.result.noteCount())) {
            if (i > 0) { pptxNotes = (pptxNotes + "\n") }
            pptxNotes = (pptxNotes + (x.result.noteAt(i)))
            i = (i + 1)
        }
        return d
    }

    ; What a slide is when nothing says otherwise. Sizes in the layout's
    ; units, which are what `MdFrontMatter` answers in; the text sizes are
    ; the ones a deck template reaches for — a 20-point body reads from the
    ; back of a room and an 11-point one does not.
    sfn deckDefaults:void (st:MdStyle) {
        def pw:double st.pageWidth
        def ph:double st.pageHeight
        st.pageWidth = (MdFrontMatter.pageW("a4 landscape" pw ph))
        st.pageHeight = (MdFrontMatter.pageH("a4 landscape" ph pw))
        st.bodySize = 20.0
        st.lineHeight = 1.35
        st.paraSpacing = 14.0
        st.h1Size = 40.0
        st.h2Size = 32.0
        st.h3Size = 26.0
        st.h4Size = 22.0
        st.h5Size = 20.0
        st.h6Size = 20.0
        st.headingSpaceBefore = 22.0
        st.headingSpaceAfter = 12.0
        st.codeSize = 15.0
    }

    ; The deck as a PDF: every slide a page, drawn by the slide editor's own
    ; converter at the scale a PDF unit is, through the same road the pptx
    ; API's `toPdfDeck` takes. The deck the READER has been editing, with
    ; its fonts and its pictures — the editor's view has both.
    fn deckPdf:buffer () {
        if (! deckOn) { this.ensureDeck() }
        def app:PptxApp deckWeb.app
        def pres:PptxPresentation app.presentation
        def n:int (array_length pres.slides)
        def empty:buffer (buffer_alloc 0)
        if (n == 0) { return empty }
        def first:PptxSlide (itemAt pres.slides 0)
        def pw:double first.width
        def ph:double first.height
        app.view.cachePresentationImages(pres)
        def root:EVGElement (EVGListToElements.printRoot(pw ph))
        def section:EVGElement (EVGListToElements.sectionOf(root))
        def i:int 0
        while (i < n) {
            def sl:PptxSlide (itemAt pres.slides i)
            ; 72/96: `ptToPx` multiplies by 96/72 for the screen and a PDF
            ; unit is a point, so this cancels it and one slide point is one
            ; PDF unit.
            app.view.converter.setScale((72.0 / 96.0))
            app.view.converter.slideNumber = (i + 1)
            def dl:EVGDisplayList (app.view.converter.slideToDisplayList(sl))
            def bg:EVGColor (EVGColor.parse("#FFFFFF"))
            if sl.bg.isSet {
                bg = (app.view.converter.colorFrom(sl.bg))
            }
            def pg:EVGElement (EVGListToElements.pageFrom(dl pw ph bg true))
            section.addChild(pg)
            i = (i + 1)
        }
        def renderer (new EVGPDFRenderer())
        renderer.init(renderer)
        renderer.setPageSize(pw ph)
        renderer.setFontManager(app.view.ctx.tr.fm)
        def m (new TTFTextMeasurer(app.view.ctx.tr.fm))
        renderer.setMeasurer(m)
        def parts:[string] (keys app.view.imageCache)
        def k:int 0
        while (k < (array_length parts)) {
            def part:string (itemAt parts k)
            def pix@(optional):ImageBuffer (get app.view.imageCache part)
            if (!null? pix) {
                renderer.registerImage(part (unwrap pix))
            }
            k = (k + 1)
        }
        return (renderer.render(root))
    }

    ; --- a drawing, on whichever tab -----------------------------------------
    ;
    ; The deck's drawings and the Word document's are the same fence read by
    ; the same reader; each editor carries the source with the drawing, and
    ; these answer for whichever is on screen so the page has one diagram
    ; pane rather than two.
    fn drawingSource:string () {
        if (this.showsDeck()) { return (this.deckDiagramSource()) }
        if (this.showsDoc()) {
            def dr:DocDrawing (docWeb.viewer.selectedDrawingModel())
            if (dr.id == 0) { return "" }
            return dr.source
        }
        return ""
    }

    fn drawingNotation:string () {
        if (this.showsDeck()) { return (this.deckDiagramNotation()) }
        if (this.showsDoc()) {
            def dr:DocDrawing (docWeb.viewer.selectedDrawingModel())
            if (dr.id == 0) { return "" }
            return dr.notation
        }
        return ""
    }

    fn hasDrawingSelected:boolean () {
        return ((strlen (this.drawingNotation())) > 0)
    }

    fn redrawDrawing:boolean (source:string) {
        if (this.showsDeck()) { return (this.deckRedrawDiagram(source)) }
        if (this.showsDoc()) { return (this.docRedrawDrawing(source)) }
        return false
    }

    ; The Word document's drawing, drawn again from new text, in place —
    ; `MdDeckDiagram.redraw` for a `DocDrawing`. The same refusal: text that
    ; does not read as a diagram leaves the drawing exactly as it was.
    fn docRedrawDrawing:boolean (source:string) {
        def id:int (docWeb.viewer.selectedDrawing())
        if (id == 0) { return false }
        def dr:DocDrawing (docWeb.viewer.selectedDrawingModel())
        if ((strlen dr.notation) == 0) { return false }
        if ((strlen (trim source)) == 0) { return false }
        def w:double dr.naturalW
        if (w <= 1.0) { w = 480.0 }
        def sc:FlowScene (MdDiagram.sceneFor(dr.notation source styleName w (MdDiagram.padding())))
        if (sc.worldW <= 0.0) { return false }
        def root:EVGElement (sc.toEvgTree())
        def ok:boolean (docWeb.viewer.replaceDrawing(id root sc.worldW sc.worldH source))
        if ok { built = false }
        return ok
    }

    ; The deck as a file. Once the preview owns the document, this saves what
    ; the READER has edited rather than converting the markdown again — the
    ; markdown is a record of where the deck came from, and converting it a
    ; second time would quietly throw the reader's work away.
    fn pptx:buffer () {
        if deckOn {
            ; The presentation the READER has been editing, written straight
            ; out by the editor's own save — the same bytes Ctrl+S on the
            ; pptx page writes.
            return (deckWeb.app.deckBytes())
        }
        def d:PptxDeck (this.buildDeck())
        return (d.save())
    }

    fn pptxReport:string () {
        return pptxSummary
    }

    ; …and per slide, what did not go out as text. A deck that claims a slide
    ; went out whole when it did not is worse than one that cannot carry
    ; something.
    fn pptxNotesText:string () {
        return pptxNotes
    }

    ; ----------------------------------------------------------------------
    ; Out of the tab
    ; ----------------------------------------------------------------------
    ;
    ; The PDF is built HERE, in the page, from the same layout the canvas is
    ; showing — not fetched from anywhere. A canvas has one page as far as
    ; `window.print()` is concerned, so the browser's own print dialog would
    ; produce a single clipped sheet; this produces the sheets the layout
    ; decided, with the faces the reader's own browser fetched embedded in
    ; them.
    fn pdf:buffer () {
        def print:MdLayout (new MdLayout())
        if (!null? measurer) {
            print.setMeasurer((unwrap measurer))
        }
        ; The same three things in the same order the canvas does them, and
        ; for the same reason: a PDF that is not the page the reader was
        ; looking at is not a preview of anything. `PLAN_SLIDES.md` Stage C
        ; asks for exactly this — the same document prints the same columns
        ; as the canvas draws.
        print.style = (new MdStyle())
        edit.sheet.applyTo(print.style)
        print.setStyleSheet(edit.styleCss)
        if edit.haveImages { print.setImages(edit.imageStore "/") }
        print.applyMeta(edit.doc)
        if ((strlen wantPageSize) > 0) {
            def pw:double print.style.pageWidth
            def ph:double print.style.pageHeight
            print.style.pageWidth = (MdFrontMatter.pageW(wantPageSize pw ph))
            print.style.pageHeight = (MdFrontMatter.pageH(wantPageSize ph pw))
        }
        def cw:double (print.style.pageWidth - (print.style.margin * 2.0))
        MdDiagram.prepare(edit.doc print.embeds cw styleName)
        if edit.slideMode {
            print.applySlideMeta(edit.doc)
            print.layoutSlides(edit.doc)
        } {
            print.layoutPaged(edit.doc)
        }
        def root:EVGElement (MdToEvg.buildPrint(print))
        def renderer (new EVGPDFRenderer())
        renderer.init(renderer)
        renderer.setPageSize(print.style.pageWidth print.style.pageHeight)
        if (faceCount > 0) {
            renderer.setFontManager(fontManager)
            if (!null? measurer) {
                renderer.setMeasurer((unwrap measurer))
            }
        }
        return (renderer.render(root))
    }

    fn pdfPageCount:int () {
        return pages
    }

    fn html:string () {
        return (MdToHtml.render(edit.doc))
    }

    ; ----------------------------------------------------------------------
    ; The two panes, kept in step
    ; ----------------------------------------------------------------------
    ;
    ; Every block remembers the characters it was parsed from, so a click on
    ; the drawing is an offset in the source and a caret in the source is a
    ; place to scroll the drawing to. Neither pane has to know how the other
    ; one works.
    fn sourceOffsetAt:int (x:double y:double) {
        def docY:double (y + scrollY)
        ; The CHARACTER under the pointer, when one was drawn there. This used
        ; to answer with the block's first byte and nothing finer, because
        ; that was all a box carried — a click in the middle of the fourth
        ; paragraph put the source caret at the start of it.
        def exact:int (edit.layout.srcAtPoint((x - (this.sheetLeft())) docY (this.sheetGap())))
        if (exact >= 0) { return exact }
        ; Nothing that carries a source was drawn at that point — the margin,
        ; the gap between sheets, a rule, a diagram. Fall back to the block
        ; above, which is the answer the viewer always gave.
        def best:int -1
        def bestY:double (0.0 - 1000000.0)
        def i:int 0
        def n:int (edit.doc.childCount())
        while (i < n) {
            def b:MdNode (edit.doc.childAt(i))
            def top:double (this.topOf(b))
            if (top <= docY) {
                if (top > bestY) {
                    bestY = top
                    best = b.srcStart
                }
            }
            i = (i + 1)
        }
        return best
    }

    ; How the sheets are stacked, as `MdLayout` wants to be told: below zero
    ; for one continuous column.
    fn sheetGap:double () {
        if paged {
            return (MdToEvg.sheetGap())
        }
        return (0.0 - 1.0)
    }

    ; Where a source offset ended up on the drawing.
    ;
    ; The boxes first, so the answer is the LINE the character is on rather
    ; than the top of the paragraph it is in: a caret moved down inside a long
    ; paragraph used to scroll nowhere, because every box of that paragraph
    ; reported the same y.
    fn offsetToY:double (offset:int) {
        def bestBox:double (0.0 - 1.0)
        def bestSrc:int -1
        def gap:double (this.sheetGap())
        def bi:int 0
        def bn:int (array_length edit.layout.boxes)
        while (bi < bn) {
            def bx:MdBox (itemAt edit.layout.boxes bi)
            if ((bx.kind == 0) && (bx.segSrc >= 0)) {
                if (bx.segSrc <= offset) {
                    if (bx.segSrc >= bestSrc) {
                        bestSrc = bx.segSrc
                        bestBox = (edit.layout.boxTop(bx gap))
                    }
                }
            }
            bi = (bi + 1)
        }
        if (bestBox >= 0.0) { return bestBox }
        def best:double 0.0
        def i:int 0
        def n:int (edit.doc.childCount())
        while (i < n) {
            def b:MdNode (edit.doc.childAt(i))
            if (b.srcStart <= offset) {
                best = (this.topOf(b))
            }
            i = (i + 1)
        }
        return best
    }

    ; The top of a block on the drawing: the first box it produced, which
    ; every box now remembers. No map on the side to keep in step.
    fn topOf:double (block:MdNode) {
        def i:int (edit.layout.firstBoxOf(block.srcStart))
        if (i < 0) { return 0.0 }
        def b:MdBox (itemAt edit.layout.boxes i)
        if paged {
            def gap:double (MdToEvg.sheetGap())
            def sheet:double (edit.layout.style.pageHeight + gap)
            return (b.y + ((to_double b.page) * sheet))
        }
        return b.y
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MdSlidesTest.rgr — columns, and where a slide breaks.
; ============================================================================
;
;   npm run markdown:slides:test
;
; `PLAN_SLIDES.md` stages C and D, and each stage's own "done when".
;
; **Columns (C).** In document order DOWN each column, the columns differing
; by at most one item, and the same answer on the page as on the canvas. The
; check is the ORDER and the COLUMN INDEX of each item, not the number of
; boxes: a flow that put items across the rows instead of down the columns
; produces exactly as many boxes in exactly as many columns and is unreadable.
;
; **Slides (D).** The four rules of §4, in order, on a fixture written to
; exercise them — a heading that must break, one that must not, one kept with
; its first paragraph, and a slide that overflows. Each is checked by WHICH
; SLIDE a block landed on, because a rule that fires on the wrong block still
; produces the right number of slides.
; ============================================================================

Import "../src/MdBlock.rgr"
Import "../src/MdLayout.rgr"
Import "../src/MdCss.rgr"
Import "../src/MdDiagram.rgr"

class SlideCheck {
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print ("    got  [" + (got + "]"))
            print ("    want [" + (want + "]"))
        }
    }

    fn eqInt:void (name:string got:int want:int) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print (("    got  " + (to_string got)) + (" want " + (to_string want)))
        }
    }
}

class MdSlidesTest {
    sfn main:void () {
        def t:MdSlidesTest (new MdSlidesTest())
        t.run()
    }

    sfn laidOut:MdLayout (src:string css:string width:double) {
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        def c:MdCss (new MdCss())
        c.addStyleSheet(css)
        c.applyTo(l.style)
        l.setStyleSheet(css)
        l.applyMeta(doc)
        l.setDocSource(src)
        l.layoutContinuous(doc width)
        return l
    }

    sfn asSlides:MdLayout (src:string css:string) {
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        def c:MdCss (new MdCss())
        c.addStyleSheet(css)
        c.applyTo(l.style)
        l.setStyleSheet(css)
        l.applyMeta(doc)
        l.applySlideMeta(doc)
        l.setDocSource(src)
        l.layoutSlides(doc)
        return l
    }

    ; Which column a given piece of text was drawn in, counting from the left
    ; edge of the content. -1 when it is not on the page at all.
    sfn columnOf:int (l:MdLayout want:string x0:double colW:double gap:double) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 0) {
                if (b.text == want) {
                    def d:double (b.x - x0)
                    return (to_int ((d / (colW + gap)) + 0.5))
                }
            }
            i = (i + 1)
        }
        return -1
    }

    sfn yOf:double (l:MdLayout want:string) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 0) {
                if (b.text == want) { return b.y }
            }
            i = (i + 1)
        }
        return (0.0 - 1.0)
    }

    sfn slideOf:int (l:MdLayout want:string) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 0) {
                if (b.text == want) { return b.page }
            }
            i = (i + 1)
        }
        return -1
    }

    ; ----------------------------------------------------------------------
    fn columns:void (c:SlideCheck) {
        print "-- three columns, down each one --"
        def src:string "Before.\n\n- one\n- two\n- three\n- four\n- five\n- six\n- seven\n{.c3}\n\nAfter.\n"
        def css:string ".c3 { column-count: 3; column-gap: 24pt }"
        def l:MdLayout (MdSlidesTest.laidOut(src css 600.0))
        def x0:double l.contentX
        def colW:double (((600.0 - (l.style.margin * 2.0)) - 48.0) / 3.0)

        ; Seven items over three columns: 3, 2, 2 — and at most one item
        ; between the longest and the shortest.
        def cols:string ""
        cols = (cols + (to_string (MdSlidesTest.columnOf(l "one" x0 colW 24.0))))
        cols = (cols + (to_string (MdSlidesTest.columnOf(l "two" x0 colW 24.0))))
        cols = (cols + (to_string (MdSlidesTest.columnOf(l "three" x0 colW 24.0))))
        cols = (cols + (to_string (MdSlidesTest.columnOf(l "four" x0 colW 24.0))))
        cols = (cols + (to_string (MdSlidesTest.columnOf(l "five" x0 colW 24.0))))
        cols = (cols + (to_string (MdSlidesTest.columnOf(l "six" x0 colW 24.0))))
        cols = (cols + (to_string (MdSlidesTest.columnOf(l "seven" x0 colW 24.0))))
        c.eqStr("document order, down each column" cols "0001122")

        ; …and DOWN, which is the half a row-major flow would get wrong while
        ; producing the same three columns.
        c.ok("the second item is below the first" ((MdSlidesTest.yOf(l "two")) > (MdSlidesTest.yOf(l "one"))))
        c.ok("and the fourth is level with the first" ((fabs ((MdSlidesTest.yOf(l "four")) - (MdSlidesTest.yOf(l "one")))) < 0.5))
        c.ok("…as is the sixth" ((fabs ((MdSlidesTest.yOf(l "six")) - (MdSlidesTest.yOf(l "one")))) < 0.5))

        ; The bullets travel with their text. They are emitted by the LIST and
        ; carry its source offset, not the item's, so a flow that grouped by
        ; offset alone left every bullet in the first column.
        def bullets:int 0
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 0) {
                if (b.text == "•") {
                    if (b.x > (x0 + 1.0)) { bullets = (bullets + 1) }
                }
            }
            i = (i + 1)
        }
        c.eqInt("four bullets moved out of the first column" bullets 4)

        ; What follows starts below the tallest column, not below the whole
        ; list as it was laid out before it was cut.
        def after:double (MdSlidesTest.yOf(l "After."))
        c.ok("the next block clears the columns" (after > (MdSlidesTest.yOf(l "three"))))
        def firstY:double (MdSlidesTest.yOf(l "one"))
        c.ok("…and does not clear the whole list" (after < (firstY + 300.0)))

        ; Without a sheet, nothing is in columns — the attribute alone means
        ; nothing, which is the whole point of the split.
        def plain:MdLayout (MdSlidesTest.laidOut(src "" 600.0))
        c.eqInt("with no sheet there are no columns" (MdSlidesTest.columnOf(plain "seven" x0 colW 24.0)) 0)

        ; A paragraph is not cut into columns: that would be a line flow and
        ; is a different feature. Saying so beats thirding a sentence.
        def para:MdNode (MdBlock.parseText("Some prose.\n{.c3}\n"))
        def pl:MdLayout (new MdLayout())
        pl.style = (new MdStyle())
        pl.setStyleSheet(css)
        pl.setDocSource("Some prose.\n{.c3}\n")
        pl.layoutContinuous(para 600.0)
        c.eqInt("a paragraph stays one column" (MdSlidesTest.columnOf(pl "Some prose." pl.contentX colW 24.0)) 0)
    }

    ; ----------------------------------------------------------------------
    ; The four rules, each on the block it is about
    fn breaks:void (c:SlideCheck) {
        print "-- where a slide breaks --"
        def css:string "deck { split-level: 2 } page { width: 720pt; height: 405pt; padding: 36pt }"
        def src:string "# Title\n\nOpening line.\n\n## First\n\nOne.\n\n## Second\n\nTwo.\n\n### Under second\n\nThree.\n"
        def l:MdLayout (MdSlidesTest.asSlides(src css))
        c.eqInt("the level comes from the sheet" l.splitLevel 2)
        c.eqInt("a heading at the level starts a slide" (MdSlidesTest.slideOf(l "First")) 1)
        c.eqInt("…and the next one the slide after" (MdSlidesTest.slideOf(l "Second")) 2)
        c.eqInt("the title keeps its own" (MdSlidesTest.slideOf(l "Title")) 0)
        c.eqInt("…with the paragraph under it" (MdSlidesTest.slideOf(l "Opening line.")) 0)
        ; 3. PREFERRED: a deeper heading on a slide barely started is a
        ; subheading of what is there and stays with it.
        c.eqInt("a deeper heading near the top stays" (MdSlidesTest.slideOf(l "Under second")) 2)

        ; 1. MANDATORY by attribute, on a block that is not a heading at all.
        def marked:string "# Title\n\nOne.\n\nTwo.\n{.slide}\n\nThree.\n"
        def m:MdLayout (MdSlidesTest.asSlides(marked css))
        c.eqInt("{.slide} starts one" (MdSlidesTest.slideOf(m "Two.")) 1)
        c.eqInt("…and what follows stays with it" (MdSlidesTest.slideOf(m "Three.")) 1)

        ; 2. FORBIDDEN beats 1. MANDATORY: an author who wrote `{.no-break}`
        ; on a heading meant it, and a flag that does nothing when it would
        ; matter is worse than no flag.
        def held:string "# Title\n\nOne.\n\n## Second {.no-break}\n\nTwo.\n"
        def h:MdLayout (MdSlidesTest.asSlides(held css))
        c.eqInt("{.no-break} holds a heading that would have broken" (MdSlidesTest.slideOf(h "Second")) 0)

        ; …and the document beats the template, because it is closer to the
        ; deck than the company is.
        def fm:string "---\nslide-split-level: 1\n---\n\n# Title\n\nOne.\n\n## Second\n\nTwo.\n"
        def f:MdLayout (MdSlidesTest.asSlides(fm css))
        c.eqInt("front matter beats the sheet" f.splitLevel 1)
        c.eqInt("…so a level-two heading no longer breaks" (MdSlidesTest.slideOf(f "Second")) 0)
    }

    ; KEEP-WITH-NEXT, which is the thing that makes an automatic deck look
    ; hand-made: a heading is never the last thing on a slide.
    fn keepWithNext:void (c:SlideCheck) {
        print "-- a heading is never the last thing on a slide --"
        ; A short page, and enough prose to fill it to just under the bottom.
        def css:string "deck { split-level: 1 } page { width: 720pt; height: 200pt; padding: 20pt }"
        def src:string "# Title\n\nFiller one.\n\nFiller two.\n\nFiller three.\n\nFiller four.\n\n### Low heading\n\nUnder it.\n"
        def l:MdLayout (MdSlidesTest.asSlides(src css))
        def hs:int (MdSlidesTest.slideOf(l "Low heading"))
        def ps:int (MdSlidesTest.slideOf(l "Under it."))
        c.ok("the heading was reached" (hs >= 0))
        c.eqInt("and what is under it is on the same slide" ps hs)

        ; The noun the failure is about: a slide whose LAST box is a heading.
        c.eqInt("no slide ends on a heading" (MdSlidesTest.slidesEndingOnAHeading(l)) 0)

        ; …and the case a reader actually reported: the heading on one slide
        ; and its DIAGRAM on the next.
        ;
        ; One body line of room under a heading is enough for prose, because a
        ; paragraph that starts under its heading and runs on still reads as
        ; one thing. It is not enough for a block that cannot be cut: the
        ; heading fits, the diagram does not, and the pair comes apart. The
        ; diagram's height was measured before layout began — that is what the
        ; prepare pass is for — so the rule can ask for the real number.
        ; Sized so the rule has to fire and CAN: the diagram is 200pt in a
        ; slide with 260pt of room, so the pair fits once the heading moves —
        ; and does not fit where the heading would otherwise have stayed.
        ; Without `keepRoom` the heading lands on slide 0 and the diagram on
        ; slide 1, which is the reader's complaint in two numbers.
        def dcss:string "deck { split-level: 1 } page { width: 720pt; height: 300pt; padding: 20pt }"
        def dsrc:string "# Title\n\nFiller one.\n\n### Kaavio\n\n```mermaid\nflowchart TD\n  A[Kirjoita jotain] --> B[Renderoi se]\n```\n"
        def dl:MdLayout (MdSlidesTest.asSlidesWithDiagrams(dsrc dcss))
        def dh:int (MdSlidesTest.slideOf(dl "Kaavio"))
        def dd:int (MdSlidesTest.slideOfEmbed(dl))
        c.ok("the heading with a diagram under it was reached" (dh >= 0))
        c.ok("…and the diagram was drawn" (dd >= 0))
        c.eqInt("a heading and its diagram are on the same slide" dd dh)
    }

    ; The first embed slot's slide, or -1. A diagram is not a text box, so
    ; `slideOf` cannot see it — and the whole failure is about where the
    ; diagram went.
    sfn slideOfEmbed:int (l:MdLayout) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 3) { return b.page }
            i = (i + 1)
        }
        return (0 - 1)
    }

    ; As `asSlides`, with the diagrams measured first — which is the order the
    ; editor uses and the only order in which `keepRoom` has a number to ask
    ; for.
    sfn asSlidesWithDiagrams:MdLayout (src:string css:string) {
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        def c:MdCss (new MdCss())
        c.addStyleSheet(css)
        c.applyTo(l.style)
        l.setStyleSheet(css)
        l.applyMeta(doc)
        l.applySlideMeta(doc)
        l.setDocSource(src)
        def cw:double (l.style.pageWidth - (l.style.margin * 2.0))
        MdDiagram.prepare(doc l.embeds cw "default")
        l.layoutSlides(doc)
        return l
    }

    ; A title set so large that it wraps, with a diagram under it. The
    ; diagram went to a slide of its own with the title said again, and the
    ; slide it left held the title and nothing else — one heading, two slides
    ; (Sliqtly: `h2 { font-size: 80pt }` over a chart). The diagram now takes
    ; the room left under the title; a title too big for even that is set
    ; smaller; a title alone on its slide keeps its size.
    fn bigTitle:void (c:SlideCheck) {
        print "-- a big title keeps its diagram --"
        def dia:string "```mermaid\nflowchart TD\n  A[Kirjoita jotain] --> B[Renderoi se]\n```\n"
        def css:string "deck { split-level: 2 } page { width: 720pt; height: 300pt; padding: 20pt } h2 { font-size: 44pt }"
        def src:string ("## Keskilämpötila kuukausittain kolmella asemalla\n\n" + dia)
        def l:MdLayout (MdSlidesTest.asSlidesWithDiagrams(src css))
        c.eqInt("a wrapped title and its diagram are one slide" l.pageCount 1)
        c.eqInt("…the diagram is on it" (MdSlidesTest.slideOfEmbed(l)) 0)
        c.eqInt("…and nothing was said twice" l.slideOverflows 0)
        c.ok("…and the diagram stays on the slide" (MdSlidesTest.embedBottom(l) <= (l.contentBottom + 0.5)))
        c.ok("the title kept its size" ((MdSlidesTest.biggestText(l)) > 43.0))

        def hcss:string "deck { split-level: 2 } page { width: 720pt; height: 300pt; padding: 20pt } h2 { font-size: 120pt }"
        def hl:MdLayout (MdSlidesTest.asSlidesWithDiagrams(src hcss))
        c.eqInt("a title taller than the slide and its diagram are one slide" hl.pageCount 1)
        c.eqInt("…the diagram is on it" (MdSlidesTest.slideOfEmbed(hl)) 0)
        c.ok("…because the title was set smaller" ((MdSlidesTest.biggestText(hl)) < 119.0))
        c.ok("…and the diagram stays on the slide" (MdSlidesTest.embedBottom(hl) <= (hl.contentBottom + 0.5)))

        def scss:string "deck { split-level: 2 } page { width: 720pt; height: 300pt; padding: 20pt } h2 { font-size: 90pt }"
        def sl:MdLayout (MdSlidesTest.asSlidesWithDiagrams("## Iso otsikko\n\n## Seuraava\n\nTekstiä.\n" scss))
        c.ok("a title alone on its slide keeps its size" ((MdSlidesTest.biggestTextOn(sl 0)) > 89.0))
    }

    sfn embedBottom:double (l:MdLayout) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 3) { return (b.y + b.h) }
            i = (i + 1)
        }
        return 0.0
    }

    sfn biggestText:double (l:MdLayout) {
        return (MdSlidesTest.biggestTextOn(l (0 - 1)))
    }

    ; The largest text size on slide `p` (any slide when `p` is -1).
    sfn biggestTextOn:double (l:MdLayout p:int) {
        def big:double 0.0
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && ((p < 0) || (b.page == p))) {
                if (b.size > big) { big = b.size }
            }
            i = (i + 1)
        }
        return big
    }

    ; How many slides have a heading as the lowest thing on them.
    sfn slidesEndingOnAHeading:int (l:MdLayout) {
        def bad:int 0
        def p:int 0
        while (p < l.pageCount) {
            def lowest:double (0.0 - 1.0)
            def lowestBold:boolean false
            def i:int 0
            while (i < (array_length l.boxes)) {
                def b:MdBox (itemAt l.boxes i)
                if (b.page == p) {
                    if (b.kind == 0) {
                        if (b.y > lowest) {
                            lowest = b.y
                            lowestBold = (b.size > (l.style.bodySize + 0.5))
                        }
                    }
                }
                i = (i + 1)
            }
            if lowestBold { bad = (bad + 1) }
            p = (p + 1)
        }
        return bad
    }

    ; A block too tall for one slide is cut, the count is printed, and the
    ; continuation carries the title — so a reader of the second half knows
    ; what it is the second half of.
    fn overflow:void (c:SlideCheck) {
        print "-- and a slide too full --"
        def css:string "deck { split-level: 1 } page { width: 720pt; height: 160pt; padding: 20pt }"
        def body:string "# Long\n\n"
        def i:int 0
        while (i < 40) {
            body = ((body + "- item ") + (to_string i)) + "\n"
            i = (i + 1)
        }
        def l:MdLayout (MdSlidesTest.asSlides(body css))
        c.ok("it took more than one slide" (l.pageCount > 1))
        c.ok("and said how many blocks it cut" (l.slideOverflows > 0))
        c.eqStr("with the policy it was told" l.slideOverflow "split")
        c.ok("the continuation carries the title" ((MdSlidesTest.slideOf(l "Long (jatkuu)")) > 0))

        ; A policy this layout does not honour is carried and named rather
        ; than silently treated as the default.
        def shrink:MdLayout (MdSlidesTest.asSlides(body "deck { split-level: 1; overflow: shrink }"))
        c.eqStr("another policy is carried" shrink.slideOverflow "shrink")
    }

    ; A list item is not cut between two slides: its bullet and its words
    ; land on the same one, and an item that fits on a slide is moved whole.
    fn wholeItems:void (c:SlideCheck) {
        print "-- a list item stays whole --"
        def css:string "deck { split-level: 2 } page { width: 720pt; height: 200pt; padding: 20pt } document { font-size: 14pt }"
        def body:string "## Key Features\n\n"
        def i:int 0
        while (i < 9) {
            body = (body + "- **Feature " + (to_string i) + "** is described here in a sentence long enough to wrap onto a second line of the slide\n")
            i = (i + 1)
        }
        def l:MdLayout (MdSlidesTest.asSlides(body css))
        c.ok("the list takes more than one slide" (l.pageCount > 1))
        ; every bullet is on the page of the text that follows it, and no
        ; item has lines on two slides
        def bad:int 0
        def k:int 0
        while (k < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes k)
            if ((b.kind == 0) && (b.text == "•")) {
                def near:int -1
                def j:int 0
                while (j < (array_length l.boxes)) {
                    def t:MdBox (itemAt l.boxes j)
                    if (((t.kind == 0) && (t.segSrc >= 0)) && (t.text != "•")) {
                        if ((near < 0) && ((t.page == b.page) && ((t.y + 1.0) >= b.y))) {
                            if ((t.y - b.y) < 2.0) {
                                near = j
                            }
                        }
                    }
                    j = (j + 1)
                }
                if (near < 0) {
                    bad = (bad + 1)
                }
            }
            k = (k + 1)
        }
        c.eqInt("no bullet stands without its first line" bad 0)
        ; every item's words on one slide: its source span, and the pages of
        ; the boxes drawn from it
        def cut:int 0
        def at:int (strlen "## Key Features\n\n")
        def f:int 0
        while (f < 9) {
            def line:string ("- **Feature " + (to_string f) + "** is described here in a sentence long enough to wrap onto a second line of the slide\n")
            def end:int (at + (strlen line))
            def pg:int -1
            def m:int 0
            while (m < (array_length l.boxes)) {
                def b2:MdBox (itemAt l.boxes m)
                if (((b2.kind == 0) && (b2.segSrc >= at)) && (b2.segSrc < end)) {
                    if (pg < 0) {
                        pg = b2.page
                    }
                    if (b2.page != pg) {
                        cut = (cut + 1)
                    }
                }
                m = (m + 1)
            }
            at = end
            f = (f + 1)
        }
        c.eqInt("no item is cut between two slides" cut 0)
    }

    sfn slidesWith:MdLayout (src:string css:string shrinkMin:double) {
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        def c:MdCss (new MdCss())
        c.addStyleSheet(css)
        c.applyTo(l.style)
        l.setStyleSheet(css)
        l.applyMeta(doc)
        l.applySlideMeta(doc)
        l.setDocSource(src)
        l.slideShrinkMin = shrinkMin
        l.layoutSlides(doc)
        return l
    }

    ; A slide that spills by one item is set a little smaller instead of
    ; getting a continuation slide for that item.
    fn shrinkToFit:void (c:SlideCheck) {
        print "-- a short spill shrinks the slide --"
        def css:string "deck { split-level: 2 } page { width: 720pt; height: 220pt; padding: 20pt } document { font-size: 14pt }"
        def body:string "## Features\n\n"
        def n:int 0
        def spilled:boolean false
        while ((n < 30) && (spilled == false)) {
            body = (body + "- item number " + (to_string n) + "\n")
            def off:MdLayout (MdSlidesTest.slidesWith(body css 1.0))
            if (off.pageCount > 1) {
                spilled = true
            }
            n = (n + 1)
        }
        c.ok("some length spills without shrinking" spilled)
        def on:MdLayout (MdSlidesTest.slidesWith((body + "\n## Next\n\nText\n") css 0.8))
        c.eqInt("with it, the list stays on one slide" (MdSlidesTest.slideOf(on ("item number " + (to_string (n - 1))))) 0)
        c.eqInt("and the next slide is the second" (MdSlidesTest.slideOf(on "Text")) 1)
        c.eqInt("one slide was shrunk" on.slidesShrunk 1)
        def big:string "## Long\n\n"
        def k:int 0
        while (k < 40) {
            big = (big + "- line " + (to_string k) + "\n")
            k = (k + 1)
        }
        def far:MdLayout (MdSlidesTest.slidesWith(big css 0.8))
        c.ok("a long spill is still split" (far.pageCount > 1))
    }

    ; The same document, three ways: the claim `PLAN_SLIDES.md` opens with is
    ; that the deck is a LAYOUT POLICY and not a conversion. One tree, three
    ; calls, and the text is the same text in all three.
    fn oneDocument:void (c:SlideCheck) {
        print "-- one document, three layouts --"
        def css:string "deck { split-level: 2 } page { width: 720pt; height: 405pt; padding: 36pt }"
        def src:string "# Title\n\nOne.\n\n## Second\n\nTwo.\n"
        def doc:MdNode (MdBlock.parseText(src))
        def sheet:MdCss (new MdCss())
        sheet.addStyleSheet(css)

        def flow:MdLayout (new MdLayout())
        flow.style = (new MdStyle())
        sheet.applyTo(flow.style)
        flow.setStyleSheet(css)
        flow.setDocSource(src)
        flow.layoutContinuous(doc 720.0)

        def paged:MdLayout (new MdLayout())
        paged.style = (new MdStyle())
        sheet.applyTo(paged.style)
        paged.setStyleSheet(css)
        paged.setDocSource(src)
        paged.layoutPaged(doc)

        def deck:MdLayout (MdSlidesTest.asSlides(src css))

        c.eqStr("the words are the same, flowing and paged" (MdSlidesTest.words(flow)) (MdSlidesTest.words(paged)))
        c.eqStr("…and as a deck" (MdSlidesTest.words(flow)) (MdSlidesTest.words(deck)))
        c.eqInt("one column of scroll" flow.pageCount 1)
        c.eqInt("one sheet of print" paged.pageCount 1)
        c.eqInt("and two slides" deck.pageCount 2)
    }

    sfn words:string (l:MdLayout) {
        def out:string ""
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 0) {
                if ((strlen b.text) > 0) { out = ((out + b.text) + "|") }
            }
            i = (i + 1)
        }
        return out
    }

    sfn sizeOf:double (l:MdLayout want:string) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && (b.text == want)) {
                return b.size
            }
            i = (i + 1)
        }
        return 0.0
    }

    ; GROW: a slide of three bullets is set larger, title and all; a full
    ; slide is left as it was; nothing spills; off means off.
    fn grow:void (c:SlideCheck) {
        print "-- grow --"
        def css:string "deck { split-level: 2 } page { width: 720pt; height: 405pt; padding: 36pt } document { font-size: 16pt } h2 { font-size: 28pt }"
        def full:string "- rivi yksi joka on aika pitkä ja kiertää varmasti\n- rivi kaksi\n- rivi kolme\n- rivi neljä\n- rivi viisi\n- rivi kuusi\n- rivi seitsemän\n- rivi kahdeksan\n- rivi yhdeksän\n"
        def src:string ("---\nslide-grow: 1.6\n---\n\n## Vähän\n\n- Kate\n- Hinnoittelu\n- Varastointi\n\n## Paljon\n\n" + full)
        def l:MdLayout (MdSlidesTest.asSlides(src css))
        c.eqInt("two slides, as before" l.pageCount 2)
        def body:double (MdSlidesTest.sizeOf(l "Kate"))
        def title:double (MdSlidesTest.sizeOf(l "Vähän"))
        c.ok(("the short list grew: " + (to_string body)) (body > 20.0))
        c.ok("its title grew with it and is still the larger" ((title > 28.0) && (title > (body * 1.5))))
        c.ok("the full slide kept its size" ((MdSlidesTest.sizeOf(l "rivi kaksi")) < 16.5))
        c.eqInt("one slide grown" l.slidesGrown 1)
        def lowest:double 0.0
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.page == 0) && ((b.y + b.h) > lowest)) { lowest = (b.y + b.h) }
            i = (i + 1)
        }
        c.ok("and stays inside the slide" (lowest <= (405.0 - 36.0)))
        def off:MdLayout (MdSlidesTest.asSlides((src.replace("slide-grow: 1.6" "slide-grow: off")) css))
        c.ok("slide-grow: off keeps the document size" ((MdSlidesTest.sizeOf(off "Kate")) < 16.5))
        ; a title that fits on one line is not grown onto two
        def ts:string "---\nslide-grow: 1.6\n---\n\n## Gemini-botti palaverissa tänä vuonna\n\nLyhyt teksti.\n"
        def tl:MdLayout (MdSlidesTest.asSlides(ts css))
        c.eqInt("the title stays one line" (MdLayout.headingLines(tl.boxes 0 (array_length tl.boxes) 27.0)) 1)
    }

    ; The header's and the footer's box with this text on slide p, or null.
    sfn edgeBox@(optional):MdBox (l:MdLayout want:string p:int) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (((b.kind == 0) && (b.page == p)) && ((b.text == want) && (b.furniture > 0))) {
                def hit@(optional):MdBox b
                return hit
            }
            i = (i + 1)
        }
        def miss@(optional):MdBox
        return miss
    }

    sfn has:boolean (l:MdLayout want:string p:int) {
        def b@(optional):MdBox (MdSlidesTest.edgeBox(l want p))
        return (!null? b)
    }

    ; Header and footer: three places an edge, {page}/{pages}, the first and
    ; the last slide left out, a slide that turns its edge off, the CSS.
    fn edges:void (c:SlideCheck) {
        print "-- header and footer --"
        def css:string "deck { split-level: 2 } page { width: 960pt; height: 540pt; padding: 40pt } document { font-size: 20pt }"
        def src:string ("---\nheader-left: ACME\nheader-right: Q4\nfooter-left: Luottamuksellinen\nfooter-right: \"{page} / {pages}\"\nfooter-skip: first last\n---\n\n"
            + "## Kansi\n\nAlku\n\n## Toka\n\nTeksti\n\n## Kolmas {header=off}\n\nLisaa\n\n## Loppu\n\nKiitos\n")
        def l:MdLayout (MdSlidesTest.slidesWith(src css 1.0))
        c.eqInt("four slides" l.pageCount 4)
        c.ok("header on the first slide" (MdSlidesTest.has(l "ACME" 0)))
        c.ok("footer left off the first slide" ((MdSlidesTest.has(l "Luottamuksellinen" 0)) == false))
        c.ok("page number on slide 2" (MdSlidesTest.has(l "2 / 4" 1)))
        c.ok("footer left off the last slide" ((MdSlidesTest.has(l "4 / 4" 3)) == false))
        c.ok("{header=off} drops the header" ((MdSlidesTest.has(l "ACME" 2)) == false))
        c.ok("but keeps that slide's footer" (MdSlidesTest.has(l "3 / 4" 2)))
        def lb@(optional):MdBox (MdSlidesTest.edgeBox(l "ACME" 1))
        def rb@(optional):MdBox (MdSlidesTest.edgeBox(l "Q4" 1))
        if ((!null? lb) && (!null? rb)) {
            def left:MdBox (unwrap lb)
            def right:MdBox (unwrap rb)
            c.ok("left place at the content's left" ((left.x > 39.0) && (left.x < 41.0)))
            c.ok("right place ends at the content's right" (((right.x + right.w) > 919.0) && ((right.x + right.w) < 921.0)))
            c.ok("header above the content" ((left.y + left.h) < 40.0))
        } {
            c.ok("header places found" false)
        }
        def fb@(optional):MdBox (MdSlidesTest.edgeBox(l "2 / 4" 1))
        if (!null? fb) {
            c.ok("footer below the content" ((unwrap fb).y > 500.0))
        }

        ; The theme says it: a band, bold, a centred place, the hairline.
        def css2:string (css + " footer { content-center: \"Sivu {page}\"; background-color: #222244; border-color: #ff8800; font-weight: bold; color: #ffffff }")
        def l2:MdLayout (MdSlidesTest.slidesWith("## Yksi\n\nTeksti\n" css2 1.0))
        def cb@(optional):MdBox (MdSlidesTest.edgeBox(l2 "Sivu 1" 0))
        c.ok("a CSS place" (!null? cb))
        if (!null? cb) {
            def cbox:MdBox (unwrap cb)
            c.ok("centred" ((fabs ((cbox.x + (cbox.w * 0.5)) - 480.0)) < 1.0))
            c.ok("bold" cbox.bold)
            c.eqStr("its colour" cbox.color "#FFFFFF")
        }
        def bands:int 0
        def i:int 0
        while (i < (array_length l2.boxes)) {
            def b:MdBox (itemAt l2.boxes i)
            if ((b.kind == 1) && (b.furniture == 2)) {
                bands = (bands + 1)
            }
            i = (i + 1)
        }
        c.eqInt("band and hairline" bands 2)

        ; A tall header widens a margin too small for it.
        def css3:string "deck { split-level: 2 } page { width: 960pt; height: 540pt; padding: 10pt } document { font-size: 20pt } header { content: \"Otsikko\"; font-size: 30pt }"
        def l3:MdLayout (MdSlidesTest.slidesWith("## Yksi\n\nTeksti\n" css3 1.0))
        def hb@(optional):MdBox (MdSlidesTest.edgeBox(l3 "Otsikko" 0))
        def ty:double (MdSlidesTest.yOf(l3 "Yksi"))
        if (!null? hb) {
            c.ok("content starts below a tall header" (ty > ((unwrap hb).y + (unwrap hb).h)))
        } {
            c.ok("tall header found" false)
        }
    }

    fn run:void () {
        def c:SlideCheck (new SlideCheck())
        print "== MdSlidesTest =="
        this.columns(c)
        this.breaks(c)
        this.keepWithNext(c)
        this.bigTitle(c)
        this.overflow(c)
        this.wholeItems(c)
        this.shrinkToFit(c)
        this.oneDocument(c)
        this.grow(c)
        this.edges(c)
        print ""
        print (("passed=" + (to_string c.passed)) + (" failed=" + (to_string c.failed)))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }
}

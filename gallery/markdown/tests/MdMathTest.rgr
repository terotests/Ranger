; SPDX-License-Identifier: AGPL-3.0-or-later
;
; MdMathTest — TeX math in markdown: `$…$` and `$$…$$` in a line, `$$`
; displays and ```math fences as blocks, and what the layout makes of them.

Import "../src/MdBlock.rgr"
Import "../src/MdLayout.rgr"
Import "../src/MdToEvg.rgr"
Import "pkg:evg/EVGLayout.rgr"
Import "pkg:evg/EVGDisplayList.rgr"

class MdMathTest {
    def passed:int 0
    def failed:int 0

    sfn main:void () {
        def t (new MdMathTest())
        t.run()
    }

    fn check:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS  " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL  " + name)
        }
    }

    sfn parse:MdNode (src:string) {
        return (MdBlock.parseText(src))
    }

    sfn kinds:string (node:MdNode) {
        def out:string ""
        def i:int 0
        while (i < (node.childCount())) {
            def c:MdNode (node.childAt(i))
            if (i > 0) {
                out = (out + " ")
            }
            out = (out + c.kind)
            i = (i + 1)
        }
        return out
    }

    fn run:void () {
        this.testInline()
        this.testBlocks()
        this.testLayout()
        print ("passed=" + (to_string passed) + " failed=" + (to_string failed))
        if (failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }

    fn testInline:void () {
        def d:MdNode (MdMathTest.parse("Area $\\pi r^2$ here."))
        def p:MdNode (d.childAt(0))
        this.check("$…$ is a math node between two texts" ((MdMathTest.kinds(p)) == "text math text"))
        def m:MdNode (p.childAt(1))
        this.check("its source is the TeX" (m.literal == "\\pi r^2"))
        def d2:MdNode (MdMathTest.parse("It costs $5 or $10."))
        def p2:MdNode (d2.childAt(0))
        this.check("prices stay text" ((indexOf (MdMathTest.kinds(p2)) "math") < 0))
        def d3:MdNode (MdMathTest.parse("Inline: $$E = mc^2$$ ok"))
        def p3:MdNode (d3.childAt(0))
        def m3:MdNode (p3.childAt(1))
        this.check("$$…$$ in a line is display math" ((m3.kind == "math") && (m3.info == "display")))
        def d4:MdNode (MdMathTest.parse("a \\$ b $x_i$ and `$y$`"))
        def p4:MdNode (d4.childAt(0))
        this.check("\\$ and code spans are not math" ((MdMathTest.kinds(p4)) == "text text text math text code"))
        def d5:MdNode (MdMathTest.parse("$a_1 * b_2 * c$"))
        def p5:MdNode (d5.childAt(0))
        this.check("underscores and stars in math are not emphasis" ((MdMathTest.kinds(p5)) == "math"))
    }

    fn testBlocks:void () {
        def d:MdNode (MdMathTest.parse("Before:\n$$\\frac{a}{b}$$\n\nAfter"))
        this.check("a $$ line right under text is cut out as a display" ((MdMathTest.kinds(d)) == "paragraph math_block paragraph"))
        def m:MdNode (d.childAt(1))
        this.check("the display holds the TeX without the dollars" (m.literal == "\\frac{a}{b}"))
        def first:MdNode (d.childAt(0))
        this.check("the text before keeps its own source span" ((first.srcStart == 0) && (first.srcEnd <= 7)))
        def d2:MdNode (MdMathTest.parse("$$\nx^2\n\\cdot y\n$$"))
        def m2:MdNode (d2.childAt(0))
        this.check("a display over several lines" ((m2.kind == "math_block") && (m2.literal == "x^2\n\\cdot y")))
        def d3:MdNode (MdMathTest.parse("```math\n\\sqrt{2}\n```"))
        def m3:MdNode (d3.childAt(0))
        this.check("```math is a display" ((m3.kind == "math_block") && (m3.literal == "\\sqrt{2}")))
        def d4:MdNode (MdMathTest.parse("$$ unclosed\ntext"))
        this.check("an unclosed $$ is a paragraph" ((MdMathTest.kinds(d4)) == "paragraph"))
    }

    fn countKind:int (l:MdLayout kind:int) {
        def n:int 0
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == kind) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    fn testLayout:void () {
        def doc:MdNode (MdMathTest.parse("Text $x^2$ and $\\frac{1}{2}$.\n\n$$\\sum_{i=1}^n i$$"))
        def l:MdLayout (new MdLayout())
        l.layoutContinuous(doc 500.0)
        def q:int 0
        while (q < (array_length l.boxes)) {
            def bq:MdBox (itemAt l.boxes q)
                q = (q + 1)
        }
        this.check("two inline formulas and one display" ((this.countKind(l 5)) == 3))
        def i:int 0
        def disp:MdBox (new MdBox())
        def inl:MdBox (new MdBox())
        def txt:MdBox (new MdBox())
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 5) && (b.embedKind == "math-display")) {
                disp = b
            }
            if ((b.kind == 5) && (b.embedSource == "x^2")) {
                inl = b
            }
            if ((b.kind == 0) && (b.text == "Text ")) {
                txt = b
            }
            i = (i + 1)
        }
        this.check("the display is centred" ((fabs (((disp.x + (disp.w / 2.0)) - 250.0))) < 30.0))
        this.check("inline math sits after the text" (inl.x > (txt.x + 10.0)))
        this.check("inline math is inside the text's line" ((inl.y >= (txt.y - 2.0)) && ((inl.y + inl.h) <= ((txt.y + txt.h) + 2.0))))
        ; drawn: paths in the display list
        def root:EVGElement (MdToEvg.buildPage(l 500.0))
        def el:EVGLayout (new EVGLayout())
        el.setPageSize(500.0 l.documentHeight)
        el.layout(root)
        def dl:EVGDisplayList (new EVGDisplayList())
        dl.build(root)
        def paths:int 0
        def k:int 0
        while (k < (array_length dl.cmds)) {
            def c:EVGDrawCmd (itemAt dl.cmds k)
            if (c.kind == 6) {
                paths = (paths + 1)
            }
            k = (k + 1)
        }
        this.check("each formula is a filled path" (paths >= 3))
        def direct:EVGDisplayList (new EVGDisplayList())
        def painter:MdToEvg (new MdToEvg())
        def b0:int 0
        while (b0 < (array_length l.boxes)) {
            painter.paintBox(direct l (itemAt l.boxes b0) 0.0)
            b0 = (b0 + 1)
        }
        def paths2:int 0
        k = 0
        while (k < (array_length direct.cmds)) {
            def c2:EVGDrawCmd (itemAt direct.cmds k)
            if (c2.kind == 6) {
                paths2 = (paths2 + 1)
            }
            k = (k + 1)
        }
        this.check("and the direct painter draws them too" (paths2 >= 3))
    }
}

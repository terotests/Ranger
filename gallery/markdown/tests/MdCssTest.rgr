; ============================================================================
; MdCssTest.rgr — a template says it, the style holds it, and nothing else moves.
; ============================================================================
;
;   npm run markdown:css:test
;
; `PLAN_SLIDES.md` Stage B. Three claims, and they fail in three different
; ways so they are checked separately.
;
;   1. **A document with no sheet is untouched.** This is the one that makes
;      the whole binding safe to put underneath a layout already gated on its
;      own numbers — "a refactor that changes a number is not a refactor". It
;      is checked by comparing EVERY field of a styled `MdStyle` against a
;      fresh one, not by spot-checking three of them.
;
;   2. **What a sheet says lands where it is supposed to.** Each property is
;      checked against the FIELD it claims to set, because a binding that
;      writes `font-size` into the wrong one still counts a declaration as
;      applied.
;
;   3. **What it cannot do is named.** §8.4: a silent property is a template
;      that looks broken to whoever wrote it.
; ============================================================================

Import "../src/MdCss.rgr"
Import "../src/MdCssEdit.rgr"
Import "../src/MdBlock.rgr"
Import "../src/MdLayout.rgr"

class CssCheck {
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print ("    got  [" + (got + "]"))
            print ("    want [" + (want + "]"))
        }
    }

    fn eqNum:void (name:string got:double want:double) {
        def d:double (got - want)
        if (d < 0.0) { d = (0.0 - d) }
        if (d < 0.01) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print (("    got  " + (to_string got)) + (" want " + (to_string want)))
        }
    }

    fn eqInt:void (name:string got:int want:int) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print (("    got  " + (to_string got)) + (" want " + (to_string want)))
        }
    }
}

class MdCssTest {
    sfn main:void () {
        def t:MdCssTest (new MdCssTest())
        t.run()
    }

    sfn styled:MdStyle (css:string) {
        def c:MdCss (new MdCss())
        c.addStyleSheet(css)
        def s:MdStyle (new MdStyle())
        c.applyTo(s)
        return s
    }

    ; The style's OWN fingerprint — `MdStyle.fingerprint`, the same string the
    ; layout cache keys its boxes under. Asking the same question through the
    ; same function is the point: a field added to `MdStyle` and forgotten
    ; there is invisible to the cache, and this is where that shows up.
    sfn fingerprint:string (s:MdStyle) {
        return (s.fingerprint())
    }

    ; ----------------------------------------------------------------------

    ; ----------------------------------------------------------------------
    ; A stylesheet edited as TEXT
    ; ----------------------------------------------------------------------
    ;
    ; The lossless mode's other half. Content stays markdown; appearance is a
    ; stylesheet, edited the way the markdown is — as the bytes a reader wrote.
    ; Not by parsing and printing: a round trip through rules would renormalise
    ; the comments, the blank lines and the alignment, which is the same
    ; argument `PLAN_WYSIWYG.md` §1 makes about markdown.
    ;
    ; So every check here is a BYTE comparison. "It parses to the same rules"
    ; is exactly the claim that is not being made.
    fn editing:void (c:CssCheck) {
        print "-- a stylesheet is edited as the bytes a reader wrote --"
        def sheet:string "/* the company's own */\npage   { width: 720pt; height: 405pt }\n\ndocument { font-size: 11pt }\n"

        c.eqStr("what the sheet says" (MdCssEdit.getProperty(sheet "page" "width")) "720pt")
        c.eqStr("…and what it does not" (MdCssEdit.getProperty(sheet "page" "color")) "")
        c.ok("a rule that is there" (MdCssEdit.hasRule(sheet "document")))
        c.ok("…and one that is not" (! (MdCssEdit.hasRule(sheet "table"))))

        ; Changing one declaration changes ONE declaration.
        c.eqStr("a width is changed in place"
            (MdCssEdit.setProperty(sheet "page" "width" "960pt"))
            "/* the company's own */\npage   { width: 960pt; height: 405pt }\n\ndocument { font-size: 11pt }\n")

        ; Adding one to a rule that exists keeps the rule's own shape.
        c.eqStr("a new declaration joins the rule"
            (MdCssEdit.setProperty(sheet "page" "background-color" "#102040"))
            "/* the company's own */\npage   { width: 720pt; height: 405pt; background-color: #102040 }\n\ndocument { font-size: 11pt }\n")

        ; …and a rule that does not exist is added at the end, where a reader
        ; would have put it.
        c.eqStr("a new rule is added at the end"
            (MdCssEdit.setProperty(sheet "table" "border-color" "#cccccc"))
            "/* the company's own */\npage   { width: 720pt; height: 405pt }\n\ndocument { font-size: 11pt }\ntable { border-color: #cccccc }\n")

        ; An empty value removes it, with the separator that went with it.
        c.eqStr("an empty value takes the declaration out"
            (MdCssEdit.setProperty(sheet "page" "width" ""))
            "/* the company's own */\npage   { height: 405pt }\n\ndocument { font-size: 11pt }\n")
        c.eqStr("…and removing what is not there changes nothing"
            (MdCssEdit.setProperty(sheet "page" "color" "")) sheet)

        ; Set then unset is the bytes that went in — the same promise every
        ; markdown intent makes.
        def once:string (MdCssEdit.setProperty(sheet "page" "background-color" "#102040"))
        c.eqStr("on then off is the original bytes"
            (MdCssEdit.setProperty(once "page" "background-color" "")) sheet)

        ; A brace inside a COMMENT is not a brace, and a brace inside a STRING
        ; is not either. A template with one comment in it used to become
        ; unparseable, and `url("a{b}")` used to end its own rule.
        def tricky:string "page { /* } not a close */ width: 720pt }\ndocument { font-size: 11pt }\n"
        c.eqStr("a brace in a comment does not end the rule"
            (MdCssEdit.getProperty(tricky "page" "width")) "720pt")
        c.eqStr("…and the rule after it is still found"
            (MdCssEdit.getProperty(tricky "document" "font-size")) "11pt")

        def quoted:string "page { background-image: url(\"a{b}.png\") }\ndocument { color: #111111 }\n"
        c.eqStr("a brace in a string does not either"
            (MdCssEdit.getProperty(quoted "page" "background-image")) "url(\"a{b}.png\")")
        c.eqStr("…and the next rule is reachable"
            (MdCssEdit.getProperty(quoted "document" "color")) "#111111")

        ; A selector is a whole name. `page` must not find `page-header`.
        def near:string "page-header { color: #222222 }\npage { color: #333333 }\n"
        c.eqStr("a selector is matched whole" (MdCssEdit.getProperty(near "page" "color")) "#333333")

        ; …and one of a comma-separated list still names the rule.
        def shared:string "h1, h2 { font-family: Cinzel }\n"
        c.eqStr("one of a list names the rule" (MdCssEdit.getProperty(shared "h2" "font-family")) "Cinzel")

        ; The whole point: what comes out is READ by the cascade. A text edit
        ; that produced something `MdCss` could not parse would pass every
        ; comparison above and break the document.
        def edited:string (MdCssEdit.setProperty(sheet "page" "background-color" "#102040"))
        def st (new MdStyle())
        def cs (new MdCss())
        cs.addStyleSheet(edited)
        cs.applyTo(st)
        c.eqStr("and the cascade reads what was written" st.pageBackground "#102040")
        c.ok("…without losing what was there" ((fabs (st.pageWidth - 720.0)) < 0.01))
    }

    fn untouched:void (c:CssCheck) {
        print "-- a document with no template --"
        def plain:MdStyle (new MdStyle())
        def none:MdStyle (MdCssTest.styled(""))
        c.eqStr("an empty sheet changes nothing" (MdCssTest.fingerprint(none)) (MdCssTest.fingerprint(plain)))

        ; …and neither does one that talks about something else entirely.
        def other:MdStyle (MdCssTest.styled("figure { font-size: 99pt } .nobody { color: red }"))
        c.eqStr("a sheet that names nothing here changes nothing" (MdCssTest.fingerprint(other)) (MdCssTest.fingerprint(plain)))

        def c2:MdCss (new MdCss())
        c2.addStyleSheet("")
        def s2:MdStyle (new MdStyle())
        c2.applyTo(s2)
        c.eqInt("and nothing was applied" c2.applied 0)
    }

    ; ----------------------------------------------------------------------
    fn landing:void (c:CssCheck) {
        print "-- and one that says something --"

        def page:MdStyle (MdCssTest.styled("page { width: 13.333in; height: 7.5in; padding: 0.65in }"))
        c.eqNum("a page in inches is points" page.pageWidth 959.976)
        c.eqNum("…both ways" page.pageHeight 540.0)
        c.eqNum("…and its padding is the margin" page.margin 46.8)

        def body:MdStyle (MdCssTest.styled("document { font-family: Inter, sans-serif; font-size: 18pt; line-height: 1.3; color: #112233 }"))
        c.eqStr("the first family named is the face" body.bodyFamily "Inter")
        c.eqNum("the body size" body.bodySize 18.0)
        c.eqNum("a bare line-height is a ratio" body.lineHeight 1.3)
        c.eqStr("and a colour comes back as one" (MdChar.lower(body.textColor)) "#112233")

        ; `body` is the same selector under the name a CSS author reaches for
        ; first. A sheet that says it and changed nothing is the worst kind of
        ; refusal: silent.
        def alias:MdStyle (MdCssTest.styled("body { font-size: 17pt; color: #e6edf3 }"))
        c.eqNum("`body` sizes the text like `document`" alias.bodySize 17.0)
        c.eqStr("…and colours it" (MdChar.lower(alias.textColor)) "#e6edf3")
        def both:MdStyle (MdCssTest.styled("document { color: #111111 } body { color: #222222 }"))
        c.eqStr("…and where a sheet says both, the later one wins"
            (MdChar.lower(both.textColor)) "#222222")

        def h:MdStyle (MdCssTest.styled("heading { font-family: Fira; margin-top: 30pt; margin-bottom: 10pt } h1 { font-size: 42pt } h2 { font-size: 28pt } h6 { font-size: 12pt }"))
        c.eqStr("the heading face" h.headingFamily "Fira")
        c.eqNum("the space above one" h.headingSpaceBefore 30.0)
        c.eqNum("and below" h.headingSpaceAfter 10.0)
        c.eqNum("h1" h.h1Size 42.0)
        c.eqNum("h2" h.h2Size 28.0)
        c.eqNum("h6" h.h6Size 12.0)
        def plain:MdStyle (new MdStyle())
        c.eqNum("and a level the sheet did not name keeps its own" h.h3Size plain.h3Size)

        def rest:MdStyle (MdCssTest.styled("code { font-family: Mono; font-size: 9pt; padding: 12pt; background-color: #eeeeee } a { color: #ff0000 } blockquote { border-width: 5pt; padding-left: 20pt } list { padding-left: 33pt } li { margin-bottom: 4pt } table { padding-left: 3pt; padding-top: 2pt } hr { color: #cccccc }"))
        c.eqStr("the code face" rest.monoFamily "Mono")
        c.eqNum("the code size" rest.codeSize 9.0)
        c.eqNum("its padding" rest.codePadding 12.0)
        c.eqStr("its background" (MdChar.lower(rest.codeBackground)) "#eeeeee")
        c.eqStr("a link" (MdChar.lower(rest.linkColor)) "#ff0000")
        c.eqNum("a quote's bar" rest.quoteBarWidth 5.0)
        c.eqNum("its indent" rest.quoteIndent 20.0)
        c.eqNum("a list's indent" rest.listIndent 33.0)
        c.eqNum("an item's spacing" rest.listTightSpacing 4.0)
        c.eqNum("a cell's padding" rest.cellPadX 3.0)
        c.eqNum("…both ways" rest.cellPadY 2.0)
        c.eqStr("a rule" (MdChar.lower(rest.ruleColor)) "#cccccc")

        ; A bare number where a length is written means points, because
        ; nobody writing a deck means pixels.
        def bare:MdStyle (MdCssTest.styled("h1 { font-size: 40 }"))
        c.eqNum("a bare number is points" bare.h1Size 40.0)
    }

    ; ----------------------------------------------------------------------
    fn reported:void (c:CssCheck) {
        print "-- and what it cannot do --"
        def css:MdCss (new MdCss())
        css.addStyleSheet("document { font-size: 18pt; letter-spacing: 2pt; text-shadow: 1px 1px red }")
        def s:MdStyle (new MdStyle())
        css.applyTo(s)
        c.eqNum("what it can do, it did" s.bodySize 18.0)
        c.ok("and what it cannot is named" ((css.unsupportedCount()) >= 2))
        c.ok("…by name" (MdCssTest.named(css "letter-spacing")))
        c.ok("…each of them" (MdCssTest.named(css "text-shadow")))

        ; `line-height: 16pt` is a length and the field is a ratio. The size
        ; it was stated against is not known at this layer, so it is reported
        ; rather than guessed — which is the rule the whole file is written
        ; to, applied to the one property that tempts a guess.
        def ratio:MdCss (new MdCss())
        ratio.addStyleSheet("document { line-height: 16pt }")
        def rs:MdStyle (new MdStyle())
        def before:double rs.lineHeight
        ratio.applyTo(rs)
        c.eqNum("a line-height as a length is not guessed at" rs.lineHeight before)
        c.ok("…it is reported" (MdCssTest.named(ratio "line-height as a length")))

        ; An at-rule is CssCore's own refusal, and it comes through as an
        ; error rather than as silence. `page { }` is the spelling here.
        def at:MdCss (new MdCss())
        at.addStyleSheet("@page { width: 10in }")
        c.ok("an at-rule is refused, loudly" ((at.errorCount()) > 0))
    }

    sfn named:boolean (css:MdCss want:string) {
        def i:int 0
        while (i < (css.unsupportedCount())) {
            if ((css.unsupportedAt(i)) == want) { return true }
            i = (i + 1)
        }
        return false
    }

    ; ----------------------------------------------------------------------
    ; The other question a sheet answers: not "how is the document set" but
    ; "what does it say about THIS block" — which is what `{.lead}` and the
    ; columns of Stage C are.
    fn perBlock:void (c:CssCheck) {
        print "-- what it says about one block --"
        def css:MdCss (new MdCss())
        css.addStyleSheet("p { font-size: 11pt } .lead { font-size: 22pt } #totals { color: #003300 } h2 { font-size: 28pt } .c3 { column-count: 3; column-gap: 28pt }")

        def doc:MdNode (MdBlock.parseText("A lead paragraph.\n{.lead}\n\n## A heading\n\n- a\n- b\n{.c3}\n\nTotals.\n{#totals}\n"))

        def lead:MdNode (doc.childAt(0))
        def g1:CssComputed (css.resolve(lead))
        c.eqStr("a class beats the element it is on" (g1.get("font-size")) "22pt")

        def head:MdNode (doc.childAt(1))
        def g2:CssComputed (css.resolve(head))
        c.eqStr("a heading is asked as h2" (g2.get("font-size")) "28pt")

        def list:MdNode (doc.childAt(2))
        def g3:CssComputed (css.resolve(list))
        c.eqStr("a list carries its columns" (g3.get("column-count")) "3")
        c.eqStr("…and their gap" (g3.get("column-gap")) "28pt")

        def totals:MdNode (doc.childAt(3))
        def g4:CssComputed (css.resolve(totals))
        c.eqStr("an id selects" (MdChar.lower((g4.get("color")))) "#003300")
        c.eqStr("…and the element rule is still under it" (g4.get("font-size")) "11pt")
    }

    ; ----------------------------------------------------------------------
    fn deck:void (c:CssCheck) {
        print "-- what the deck rules carry --"
        def css:MdCss (new MdCss())
        css.addStyleSheet("deck { split-level: 2; overflow: shrink; aspect-ratio: 16 / 9 }")
        def s:MdStyle (new MdStyle())
        css.applyTo(s)
        c.eqInt("the level a slide splits at" css.splitLevel 2)
        c.eqStr("what a full slide does" css.overflow "shrink")
        c.eqStr("and its shape" css.aspect "16 / 9")
        c.eqStr("…and none of it reached the page" (MdCssTest.fingerprint(s)) (MdCssTest.fingerprint((new MdStyle()))))
    }

    ; ----------------------------------------------------------------------
    ; …and the boxes the cache is allowed to keep
    ; ----------------------------------------------------------------------
    ;
    ; The layout remembers a block's boxes under the source that made them, so
    ; that typing three paragraphs below one does not re-measure it. A style
    ; is the other half of what made them and was not in the key: switching
    ; the company template replayed a paragraph's boxes at the positions
    ; measured for the PREVIOUS font size and drew the new, wider text on top
    ; of them, so the second half of a wrapped line sat over the first.
    ;
    ; The check is the one that cannot be fooled: a document laid out after a
    ; style change must be identical, box for box, to the same document laid
    ; out from scratch with that style. Comparing two positions would pass on
    ; a paragraph that happened not to move.
    fn cached:void (c:CssCheck) {
        print "-- the boxes a style change invalidates --"
        def src:string "A paragraph long enough to wrap at least once at this width, with a soft\nbreak in the middle of it and some more words after that.\n\nAnother one below.\n"
        def doc:MdNode (MdBlock.parseText(src))
        def big:string "document { font-size: 19pt } heading { margin-top: 40pt }"

        ; Laid out small, then big, on the same layout — which is what the
        ; page does when a reader picks another template.
        def moved:MdLayout (new MdLayout())
        moved.style = (new MdStyle())
        moved.setDocSource(src)
        moved.armCache(doc)
        moved.layoutContinuous(doc 380.0)
        def firstRun:int (array_length moved.boxes)
        def sheet:MdCss (new MdCss())
        sheet.addStyleSheet(big)
        sheet.applyTo(moved.style)
        moved.setDocSource(src)
        moved.armCache(doc)
        moved.layoutContinuous(doc 380.0)

        ; …and from scratch, which is the truth.
        def fresh:MdLayout (new MdLayout())
        fresh.style = (new MdStyle())
        def sheet2:MdCss (new MdCss())
        sheet2.addStyleSheet(big)
        sheet2.applyTo(fresh.style)
        fresh.setDocSource(src)
        fresh.layoutContinuous(doc 380.0)

        c.eqStr("box for box, the same as a fresh layout" (MdCssTest.boxes(moved)) (MdCssTest.boxes(fresh)))
        c.ok("and the style really did change the boxes" ((MdCssTest.boxes(moved)) != (MdCssTest.boxes((MdCssTest.plainLayout(doc src))))))
        c.ok("…and there were boxes to get wrong" (firstRun > 2))
    }

    sfn plainLayout:MdLayout (doc:MdNode src:string) {
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        l.setDocSource(src)
        l.layoutContinuous(doc 380.0)
        return l
    }

    sfn boxes:string (l:MdLayout) {
        def out:string ""
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            out = ((((((out + (to_string b.kind)) + ":") + (to_string b.x)) + ",") + (to_string b.y)) + ",")
            out = ((((out + (to_string b.w)) + ",") + (to_string b.h)) + "[")
            out = ((out + b.text) + "]\n")
            i = (i + 1)
        }
        return out
    }

    fn run:void () {
        def c:CssCheck (new CssCheck())
        print "== MdCssTest =="
        this.untouched(c)
        this.landing(c)
        this.reported(c)
        this.perBlock(c)
        this.deck(c)
        this.cached(c)
        this.editing(c)
        print ""
        print (("passed=" + (to_string c.passed)) + (" failed=" + (to_string c.failed)))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }
}

; ============================================================================
; MdCssLimitsTest.rgr — a value past its safety range is drawn at the range's
; edge, and the layout finishes.
; ============================================================================
;
;   npm run markdown:limits:test
;
; `MdCssLimits` is checked twice: as a model (what each property's range is,
; against a page) and through the layout, because a range nobody applies is
; a range that does not exist.
; ============================================================================

Import "../src/MdCss.rgr"
Import "../src/MdCssLimits.rgr"
Import "../src/MdBlock.rgr"
Import "../src/MdLayout.rgr"

class LimitsCheck {
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqNum:void (name:string got:double want:double) {
        def d:double (got - want)
        if (d < 0.0) { d = (0.0 - d) }
        if (d < 0.01) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print (("    got  " + (to_string got)) + (" want " + (to_string want)))
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name + ": got [" + got + "] want [" + want + "]")
        }
    }
}

class MdCssLimitsTest {
    sfn main:void () {
        def c:LimitsCheck (new LimitsCheck())
        MdCssLimitsTest.kinds(c)
        MdCssLimitsTest.ranges(c)
        MdCssLimitsTest.style(c)
        MdCssLimitsTest.layout(c)
        print ""
        print (("passed=" + (to_string c.passed)) + (" failed=" + (to_string c.failed)))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }

    sfn kinds:void (c:LimitsCheck) {
        c.eqStr("font-size" (MdCssLimits.kindOf("font-size" "h1")) "font")
        c.eqStr("a chart's title-font-size" (MdCssLimits.kindOf("title-font-size" "chart")) "font")
        c.eqStr("header-size" (MdCssLimits.kindOf("header-size" "deck")) "font")
        c.eqStr("line-height" (MdCssLimits.kindOf("line-height" "document")) "ratio")
        c.eqStr("page width" (MdCssLimits.kindOf("width" "page")) "page")
        c.eqStr("page padding" (MdCssLimits.kindOf("padding" "page")) "inset")
        c.eqStr("a code block's padding" (MdCssLimits.kindOf("padding" "code")) "pad")
        c.eqStr("a list's indent" (MdCssLimits.kindOf("padding-left" "list")) "space")
        c.eqStr("margin-bottom" (MdCssLimits.kindOf("margin-bottom" "p")) "space")
        c.eqStr("column-gap" (MdCssLimits.kindOf("column-gap" ".c3")) "space")
        c.eqStr("img max-height" (MdCssLimits.kindOf("max-height" "img")) "space")
        c.eqStr("border-width" (MdCssLimits.kindOf("border-width" "blockquote")) "stroke")
        c.eqStr("border-color is not a length" (MdCssLimits.kindOf("border-color" "blockquote")) "")
        c.eqStr("color is not a length" (MdCssLimits.kindOf("color" "h1")) "")
    }

    ; A 16:9 slide, 960 × 540 points.
    sfn ranges:void (c:LimitsCheck) {
        def w:double 960.0
        def h:double 540.0
        ; 2020px is 1515pt: a font no taller than the slide's shorter side
        c.eqNum("2020px font on a slide" (MdCssLimits.clamp("font-size" "h1" 1515.0 w h)) 540.0)
        c.eqNum("an ordinary font is left alone" (MdCssLimits.clamp("font-size" "h1" 44.0 w h)) 44.0)
        c.eqNum("a negative font is the smallest" (MdCssLimits.clamp("font-size" "document" -20.0 w h)) 1.0)
        c.eqNum("a zero font is the smallest" (MdCssLimits.clamp("font-size" "document" 0.0 w h)) 1.0)
        c.eqNum("page padding keeps a fifth of the page" (MdCssLimits.clamp("padding" "page" 2000.0 w h)) 216.0)
        c.eqNum("a margin up to half the longer side" (MdCssLimits.clamp("margin-top" "h2" 9000.0 w h)) 480.0)
        c.eqNum("a negative margin is 0" (MdCssLimits.clamp("margin-top" "h2" -30.0 w h)) 0.0)
        c.eqNum("cell padding up to a quarter of the shorter side" (MdCssLimits.clamp("padding-left" "table" 900.0 w h)) 135.0)
        c.eqNum("a border up to an eighth" (MdCssLimits.clamp("border-width" "blockquote" 900.0 w h)) 67.5)
        c.eqNum("line-height 0" (MdCssLimits.clamp("line-height" "document" 0.0 w h)) 0.5)
        c.eqNum("line-height 40" (MdCssLimits.clamp("line-height" "document" 40.0 w h)) 5.0)
        c.eqNum("a page 1000 inches wide" (MdCssLimits.clamp("width" "page" 72000.0 w h)) 14400.0)
        c.eqNum("a page of nothing" (MdCssLimits.clamp("height" "page" 0.0 w h)) 72.0)
        c.eqNum("an unknown property is left alone" (MdCssLimits.clamp("z-index" "h1" 99999.0 w h)) 99999.0)
        c.ok("in range" (MdCssLimits.inRange("font-size" "h1" 44.0 w h)))
        c.ok("out of range" (! (MdCssLimits.inRange("font-size" "h1" 1515.0 w h))))
        ; not a number at all: the low end
        def nan:double (0.0 / 0.0)
        c.eqNum("NaN font" (MdCssLimits.clamp("font-size" "h1" nan w h)) 1.0)
        def inf:double (1.0 / 0.0)
        c.eqNum("infinite margin" (MdCssLimits.clamp("margin-top" "h1" inf w h)) 480.0)
        ; a page that is itself absurd does not make the other ranges absurd
        c.eqNum("a font on a 0 × 0 page" (MdCssLimits.clamp("font-size" "h1" 500.0 0.0 0.0)) 72.0)
        c.eqNum("a font on a huge page" (MdCssLimits.clamp("font-size" "h1" 99999.0 1000000000.0 1000000000.0)) 14400.0)
        ; a block's multiple of its size
        c.eqNum("{.lead} at 1.3em is kept" (MdCssLimits.ratio(1.3 20.0 w h)) 1.3)
        c.eqNum("{.huge} at 100em is cut to the slide" (MdCssLimits.ratio(100.0 20.0 w h)) 27.0)
        c.eqNum("a NaN multiple is 1" (MdCssLimits.ratio((0.0 / 0.0) 20.0 w h)) 1.0)
    }

    sfn style:void (c:LimitsCheck) {
        def s:MdStyle (new MdStyle())
        def fresh:string (s.fingerprint())
        MdCssLimits.clampStyle(s)
        c.eqStr("the defaults are all in range" (s.fingerprint()) fresh)

        def m:MdCss (new MdCss())
        m.addStyleSheet("page { width: 13.333in; height: 7.5in; padding: 9in } document { font-size: 2020px; line-height: 0 } h1 { font-size: 99999pt } li { margin-bottom: 5000pt } code { padding: 800pt } blockquote { border-width: 400pt }")
        def t:MdStyle (new MdStyle())
        m.applyTo(t)
        c.eqNum("the sheet said 2020px" t.bodySize 1515.0)
        MdCssLimits.clampStyle(t)
        c.eqNum("page padding" t.margin 216.0)
        c.eqNum("document font" t.bodySize 540.0)
        c.eqNum("h1" t.h1Size 540.0)
        c.eqNum("line-height" t.lineHeight 0.5)
        c.eqNum("li margin" t.listTightSpacing 479.99)
        c.eqNum("code padding" t.codePadding 135.0)
        c.eqNum("quote bar" t.quoteBarWidth 67.5)
        c.eqNum("the page is as stated" t.pageWidth 959.98)
        ; 0 is "not set" for the header's own size, and stays so
        c.eqNum("header size unset" t.headerSize 0.0)
    }

    sfn slides:MdLayout (src:string css:string) {
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        def m:MdCss (new MdCss())
        m.addStyleSheet(css)
        m.applyTo(l.style)
        l.setStyleSheet(css)
        l.applyMeta(doc)
        l.applySlideMeta(doc)
        l.setDocSource(src)
        l.layoutSlides(doc)
        return l
    }

    sfn biggest:double (l:MdLayout) {
        def big:double 0.0
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && (b.size > big)) {
                big = b.size
            }
            i = (i + 1)
        }
        return big
    }

    sfn layout:void (c:LimitsCheck) {
        def page:string "page { width: 13.333in; height: 7.5in; padding: 0.6in } deck { split-level: 2 } "
        def md:string "## Otsikko\n\nTeksti joka on aika pitkä ja menee monelle riville.\n\n- yksi\n- kaksi\n\nIso kappale\n{.huge}\n"
        def plain:MdLayout (MdCssLimitsTest.slides(md page))
        c.ok("an ordinary deck is one slide" (plain.pageCount == 1))

        def h2:MdLayout (MdCssLimitsTest.slides(md (page + "h2 { font-size: 2020px }")))
        c.ok("a 2020px heading is drawn no taller than the slide" ((MdCssLimitsTest.biggest(h2)) <= 540.01))

        def body:MdLayout (MdCssLimitsTest.slides(md (page + "document { font-size: 2020px }")))
        c.ok("2020px text is drawn no taller than the slide" ((MdCssLimitsTest.biggest(body)) <= 540.01))
        c.ok("and lays out onto a bounded number of slides" (body.pageCount < 200))

        def cls:MdLayout (MdCssLimitsTest.slides(md (page + ".huge { font-size: 500em }")))
        c.ok("a class's 500em is cut to the slide" ((MdCssLimitsTest.biggest(cls)) <= 540.01))

        def gap:MdLayout (MdCssLimitsTest.slides("## A\n\n- a\n- b\n- c\n{.c3}\n" (page + ".c3 { column-count: 3; column-gap: 99999pt }")))
        c.ok("a huge column gap still lays out" (gap.pageCount >= 1))

        ; the page's own numbers, from the front matter rather than the sheet
        def fm:MdLayout (MdCssLimitsTest.slides("---\nmargin: 99in\n---\n\n## A\n\nTeksti\n" page))
        c.ok("front matter's margin is clamped too" (fm.style.margin <= 216.01))
    }
}

; ============================================================================
; MdVegaTest.rgr — a chart in a fence, and where its labels end up.
; ============================================================================
;
;   npm run markdown:vega:test
;
; A ```vega fence goes through the same door every other drawable fence uses,
; so most of what could be wrong with it is wrong in ONE of three places, and
; each of the three is checked here by asking about the scene rather than about
; the picture:
;
;   the table    `vega`, `vega-lite` and `vegalite` name the same reader, and
;                a fence word that names a LANGUAGE still names no drawing
;   the marks    a bar chart arrives as rectangles and strings, a pie as
;                one filled slice per arc; a mark nothing here can draw is
;                REPORTED rather than approximated, because a wrong chart
;                is worse than an absent one
;   the labels   a category name is centred under its own bar while the names
;                fit side by side, and turned when they stop fitting — and
;                whatever it does, it stays inside the scene it was drawn into
;
; The last of those is the one that needed a test. A label is placed by
; ANCHORING it — Vega gives a point and says which way the string hangs off it
; — and a scene item is placed by a BOX. Getting between the two wrongly is
; invisible in every structural check and obvious in the picture: the first
; chart through this door drew every category name half its own width to the
; right of the bar it named.
; ============================================================================

Import "../src/MdVegaRender.rgr"
Import "../src/MdEmbedKinds.rgr"
Import "../src/MdDiagram.rgr"

class VegaCheck {
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print ("    got  [" + (got + "]"))
            print ("    want [" + (want + "]"))
        }
    }

    fn eqInt:void (name:string got:int want:int) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print (("    got  " + (to_string got)) + (" want " + (to_string want)))
        }
    }

    fn eqNum:void (name:string got:double want:double) {
        def d:double (got - want)
        if (d < 0.0) {
            d = (0.0 - d)
        }
        if (d < 0.001) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print (("    got  " + (to_string got)) + (" want " + (to_string want)))
        }
    }
}

class MdVegaTest {
    sfn main:void () {
        def t (new MdVegaTest())
        t.run()
    }

    ; Four short category names in a plot wide enough for them.
    sfn barSpec:string () {
        return "{\"width\": 420, \"height\": 220, \"data\": {\"values\": [{\"m\": \"evg\", \"n\": 2317}, {\"m\": \"figma\", \"n\": 1180}, {\"m\": \"markdown\", \"n\": 310}, {\"m\": \"pptx\", \"n\": 140}]}, \"mark\": \"bar\", \"encoding\": {\"x\": {\"field\": \"m\", \"type\": \"nominal\"}, \"y\": {\"field\": \"n\", \"type\": \"quantitative\"}}}"
    }

    ; Six long ones in the same plot, which do not fit side by side.
    sfn crowdedSpec:string () {
        return "{\"width\": 420, \"height\": 220, \"data\": {\"values\": [{\"m\": \"authentication\", \"n\": 231}, {\"m\": \"serialization\", \"n\": 118}, {\"m\": \"documentation\", \"n\": 310}, {\"m\": \"observability\", \"n\": 140}, {\"m\": \"configuration\", \"n\": 96}, {\"m\": \"orchestration\", \"n\": 205}]}, \"mark\": \"bar\", \"encoding\": {\"x\": {\"field\": \"m\", \"type\": \"nominal\"}, \"y\": {\"field\": \"n\", \"type\": \"quantitative\"}}}"
    }

    sfn pieSpec:string () {
        return "{\"width\": 300, \"height\": 300, \"data\": {\"values\": [{\"k\": \"a\", \"n\": 4}, {\"k\": \"b\", \"n\": 6}]}, \"mark\": \"arc\", \"encoding\": {\"theta\": {\"field\": \"n\", \"type\": \"quantitative\"}, \"color\": {\"field\": \"k\", \"type\": \"nominal\"}}}"
    }

    fn words:void (c:VegaCheck) {
        print "-- the fence words --"
        c.eqStr("vega" (MdEmbedKinds.notationOf("vega")) "vega")
        c.eqStr("vega-lite" (MdEmbedKinds.notationOf("vega-lite")) "vega")
        c.eqStr("vegalite" (MdEmbedKinds.notationOf("vegalite")) "vega")
        c.eqStr("its name" (MdEmbedKinds.notationWord("vega-lite")) "Vega")
        c.ok("a drawing" (MdEmbedKinds.isDrawing("vega-lite")))
        ; A language is still a language. `vega` naming a drawing must not turn
        ; every fence that mentions a chart library into a slot.
        c.eqStr("javascript is not one" (MdEmbedKinds.notationOf("javascript")) "")
    }

    fn marks:void (c:VegaCheck) {
        print "-- the marks --"
        def d:MdVegaDrawing (MdVegaRender.draw((MdVegaTest.barSpec()) 520.0 10.0))
        c.eqStr("it read" d.error "")
        c.ok("it drew" d.ok)
        c.eqInt("nothing was skipped" (array_length d.skipped) 0)
        def bars:int 0
        def labels:int 0
        def i:int 0
        while (i < (array_length d.scene.items)) {
            def it:SceneItem (itemAt d.scene.items i)
            if (it.kind == 0) {
                ; FILLED rectangles. The plot frame is a rectangle too — a
                ; stroke and no fill — and counting it as a bar would let a
                ; chart that painted the whole plot area pass, which is the
                ; exact failure this door had on its first run.
                if ((strlen it.fill) > 0) {
                    bars = (bars + 1)
                }
            }
            if (it.kind == 1) {
                labels = (labels + 1)
            }
            i = (i + 1)
        }
        ; Four bars, and the plot frame is not one of them: it has no fill, and
        ; a rectangle with neither fill nor stroke is not drawn. Painting it
        ; with a default colour filled the whole plot — one enormous bar over
        ; the data.
        c.eqInt("four bars" bars 4)
        c.ok("and its labels" (labels > 4))
        ; The scene is asked for at a width, and it keeps to it.
        c.ok("inside the width it was given" (d.scene.worldW <= 521.0))

        ; The door `MdDiagram` dispatches through is the same one.
        def sc:FlowScene (MdDiagram.sceneFor("vega" (MdVegaTest.barSpec()) "default" 520.0 10.0))
        c.ok("through MdDiagram too" ((array_length sc.items) > 4))
    }

    ; A pie: each slice a filled shape of its own colour, the slices meeting
    ; at the centre, and nothing left undrawn.
    fn refused:void (c:VegaCheck) {
        print "-- a pie is drawn as slices --"
        def d:MdVegaDrawing (MdVegaRender.draw((MdVegaTest.pieSpec()) 520.0 10.0))
        c.eqInt("nothing is skipped" (array_length d.skipped) 0)
        def slices:int 0
        def fills:[string]
        def i:int 0
        while (i < (array_length d.scene.items)) {
            def it:SceneItem (itemAt d.scene.items i)
            if ((it.tag == "chart") && ((array_length it.pts) >= 20)) {
                slices = (slices + 1)
                def seen:boolean false
                def k:int 0
                while (k < (array_length fills)) {
                    if ((itemAt fills k) == it.fill) {
                        seen = true
                    }
                    k = (k + 1)
                }
                if (seen == false) {
                    push fills it.fill
                }
            }
            i = (i + 1)
        }
        c.eqInt("two slices" slices 2)
        c.eqInt("in two colours" (array_length fills) 2)
        def why:string (MdDiagram.refusal("vega" (MdVegaTest.pieSpec())))
        c.ok("and no apology for it" (MdVegaTest.mentions(why "arc") == false))
    }

    ; A label sits under the bar it names — which is what a box of width zero
    ; could not do, because an alignment needs something to align inside.
    fn centred:void (c:VegaCheck) {
        print "-- level labels, centred on their ticks --"
        def d:MdVegaDrawing (MdVegaRender.draw((MdVegaTest.barSpec()) 520.0 10.0))
        def names:[string]
        push names "evg"
        push names "figma"
        push names "markdown"
        push names "pptx"
        def ni:int 0
        while (ni < (array_length names)) {
            def want:string (itemAt names ni)
            def label:SceneItem (MdVegaTest.textNamed(d.scene want))
            c.ok((want + " was drawn") ((strlen label.text) > 0))
            c.eqStr((want + " is centred") label.align "center")
            c.eqNum((want + " is level") label.angle 0.0)
            def mid:double (label.x + (label.w * 0.5))
            ; …over the bar it names, whichever one that is: the labels are in
            ; the scale's order and the bars in the data's, so the check is
            ; that SOME bar holds the label's centre, not that the n-th does.
            c.ok((want + " is over a bar") (MdVegaTest.overABar(d.scene mid)))
            ni = (ni + 1)
        }
    }

    ; …and turned when they stop fitting, rather than printed over each other.
    fn turned:void (c:VegaCheck) {
        print "-- crowded labels, turned to fit --"
        def d:MdVegaDrawing (MdVegaRender.draw((MdVegaTest.crowdedSpec()) 520.0 10.0))
        def label:SceneItem (MdVegaTest.textNamed(d.scene "authentication"))
        c.ok("the long name was drawn" ((strlen label.text) > 0))
        c.eqNum("on a slant" label.angle -45.0)
        ; Anchored where it meets its tick, and turned about that same point:
        ; a right-aligned label turned about the middle of its box slides half
        ; its own length along the axis.
        c.ok("about its anchor" label.hasOrigin)
        c.eqStr("hanging by its end" label.align "right")
        ; …and the whole of it is inside the scene. A turned label reaches
        ; sideways as well as down, which the view Vela reports does not
        ; account for: the first category ran off the left of the page.
        c.ok("nothing outside the scene" (MdVegaTest.allInside(d.scene)))
    }

    ; What the spec says in words: a colour by name, a number format on the
    ; text, a stem drawn back to zero.
    fn fromTheSpec:void (c:VegaCheck) {
        print "-- colours, formats and constants from the spec --"
        def line:string "{\"width\": 300, \"height\": 200, \"data\": {\"values\": [{\"a\": 1, \"b\": 2}, {\"a\": 2, \"b\": 4}]}, \"mark\": {\"type\": \"line\", \"color\": \"firebrick\"}, \"encoding\": {\"x\": {\"field\": \"a\", \"type\": \"quantitative\"}, \"y\": {\"field\": \"b\", \"type\": \"quantitative\"}}}"
        def d:MdVegaDrawing (MdVegaRender.draw(line 520.0 10.0))
        c.ok("a named colour is drawn in hex" (MdVegaTest.hasStroke(d.scene "#b22222")))
        def txt:string "{\"data\": {\"values\": [{\"k\": \"a\", \"v\": 99.2512}]}, \"mark\": \"text\", \"encoding\": {\"y\": {\"field\": \"k\", \"type\": \"nominal\"}, \"text\": {\"field\": \"v\", \"type\": \"quantitative\", \"format\": \".0f\"}}}"
        def d2:MdVegaDrawing (MdVegaRender.draw(txt 520.0 10.0))
        c.ok("the text's own format" ((MdVegaTest.textNamed(d2.scene "99")).text == "99"))
        def lol:string "{\"width\": 300, \"data\": {\"values\": [{\"k\": \"a\", \"v\": 50}]}, \"encoding\": {\"y\": {\"field\": \"k\", \"type\": \"nominal\"}, \"x\": {\"field\": \"v\", \"type\": \"quantitative\"}}, \"layer\": [{\"mark\": \"rule\", \"encoding\": {\"x2\": {\"datum\": 0}}}, {\"mark\": \"circle\"}]}"
        def d3:MdVegaDrawing (MdVegaRender.draw(lol 520.0 10.0))
        c.ok("a stem back to the datum" (MdVegaTest.longestRun(d3.scene) > 100.0))
        ; a fence naming a file is the chart in that file
        c.eqStr("a file's path" (MdVegaRender.specFile("charts/a.vl.json\n")) "charts/a.vl.json")
        c.eqStr("a spec is not a path" (MdVegaRender.specFile(line)) "")
        def urls:[string]
        def texts:[string]
        push urls "./charts/a.vl.json"
        push texts line
        c.eqStr("read from the file" (MdVegaRender.fromFile("charts/a.vl.json" urls texts)) line)
    }

    ; A small chart asked larger, but no taller than it may be; a tall one
    ; drawn shorter.
    fn grownToFit:void (c:VegaCheck) {
        print "-- grown to the room --"
        def small:string "{\"width\": 200, \"height\": 100, \"data\": {\"values\": [{\"m\": \"a\", \"n\": 2}]}, \"mark\": \"bar\", \"encoding\": {\"x\": {\"field\": \"m\", \"type\": \"nominal\"}, \"y\": {\"field\": \"n\", \"type\": \"quantitative\"}}}"
        def g:string (MdVegaRender.grown(small 800.0 10.0 2.5 1000.0))
        c.ok("wider" ((indexOf g "\"width\":500") >= 0))
        def g2:string (MdVegaRender.grown(small 800.0 10.0 2.5 200.0))
        c.ok("but held to the height" ((indexOf g2 "\"width\":500") < 0))
        def tall:string "{\"width\": 700, \"height\": 600, \"data\": {\"values\": [{\"m\": \"a\", \"n\": 2}]}, \"mark\": \"bar\", \"encoding\": {\"x\": {\"field\": \"m\", \"type\": \"nominal\"}, \"y\": {\"field\": \"n\", \"type\": \"quantitative\"}}}"
        def g3:string (MdVegaRender.grown(tall 800.0 10.0 2.5 300.0))
        c.ok("a tall one drawn shorter" ((indexOf g3 "\"height\":600") < 0))
        ; seven months and no width: Vega-Lite's 20 points a month, a narrow
        ; column, now as wide as the room even where the height stops growing
        def months:string "{\"data\": {\"values\": [{\"m\": \"Maalis\", \"n\": 7}, {\"m\": \"Huhti\", \"n\": 9}, {\"m\": \"Touko\", \"n\": 8}, {\"m\": \"Kesä\", \"n\": 8}, {\"m\": \"Heinä\", \"n\": 10}, {\"m\": \"Elo\", \"n\": 9}, {\"m\": \"Syys\", \"n\": 10}]}, \"mark\": \"line\", \"encoding\": {\"x\": {\"field\": \"m\", \"type\": \"ordinal\", \"sort\": null}, \"y\": {\"field\": \"n\", \"type\": \"quantitative\"}}}"
        def g4:string (MdVegaRender.grown(months 1200.0 10.0 2.5 420.0))
        def p4 (new VlJsonParser())
        def s4:VlJson (p4.parse(g4))
        def w4:double (s4.doubleOr("width" 0.0))
        def h4:double (s4.doubleOr("height" 0.0))
        print ((("   months: width " + (to_string w4)) + " height ") + (to_string h4))
        c.ok("no width stated: the room's width" (w4 > 900.0))
        c.ok("…and wider than it is tall" (w4 > (h4 * 2.0)))
        ; `"width": "container"` (what an assistant writing Vega-Lite
        ; usually says) fills the room the same way
        def boxed:string "{\"width\": \"container\", \"height\": 360, \"data\": {\"values\": [{\"m\": \"Maalis\", \"n\": 588}, {\"m\": \"Huhti\", \"n\": 500}, {\"m\": \"Touko\", \"n\": 265}, {\"m\": \"Kesä\", \"n\": 470}, {\"m\": \"Heinä\", \"n\": 118}, {\"m\": \"Elo\", \"n\": 147}, {\"m\": \"Syys\", \"n\": 176}]}, \"mark\": \"bar\", \"encoding\": {\"x\": {\"field\": \"m\", \"type\": \"nominal\", \"sort\": null}, \"y\": {\"field\": \"n\", \"type\": \"quantitative\"}}}"
        def g5:string (MdVegaRender.grown(boxed 1200.0 10.0 2.5 420.0))
        def p5 (new VlJsonParser())
        def s5:VlJson (p5.parse(g5))
        def w5:double (s5.doubleOr("width" 0.0))
        print ("   container: width " + (to_string w5))
        c.ok("\"width\": \"container\" takes the room's width" (w5 > 900.0))
        ; a legend along the bottom wider than the 300 a page-less
        ; `"container"` falls back to left the plot no width at all
        def stacked:string "{\"width\": \"container\", \"height\": 340, \"data\": {\"values\": [{\"kk\": \"Tammi\", \"b\": \"0 (ajallaan)\", \"o\": 0, \"v\": 20}, {\"kk\": \"Tammi\", \"b\": \"1 (1-30 pv)\", \"o\": 1, \"v\": 20}, {\"kk\": \"Tammi\", \"b\": \"2 (31-60 pv)\", \"o\": 2, \"v\": 20}, {\"kk\": \"Tammi\", \"b\": \"3 (61-90 pv)\", \"o\": 3, \"v\": 20}, {\"kk\": \"Tammi\", \"b\": \"4 (yli 90 pv)\", \"o\": 4, \"v\": 20}, {\"kk\": \"Helmi\", \"b\": \"0 (ajallaan)\", \"o\": 0, \"v\": 20}, {\"kk\": \"Helmi\", \"b\": \"1 (1-30 pv)\", \"o\": 1, \"v\": 20}, {\"kk\": \"Helmi\", \"b\": \"2 (31-60 pv)\", \"o\": 2, \"v\": 20}, {\"kk\": \"Helmi\", \"b\": \"3 (61-90 pv)\", \"o\": 3, \"v\": 20}, {\"kk\": \"Helmi\", \"b\": \"4 (yli 90 pv)\", \"o\": 4, \"v\": 20}, {\"kk\": \"Maalis\", \"b\": \"0 (ajallaan)\", \"o\": 0, \"v\": 20}, {\"kk\": \"Maalis\", \"b\": \"1 (1-30 pv)\", \"o\": 1, \"v\": 20}, {\"kk\": \"Maalis\", \"b\": \"2 (31-60 pv)\", \"o\": 2, \"v\": 20}, {\"kk\": \"Maalis\", \"b\": \"3 (61-90 pv)\", \"o\": 3, \"v\": 20}, {\"kk\": \"Maalis\", \"b\": \"4 (yli 90 pv)\", \"o\": 4, \"v\": 20}, {\"kk\": \"Huhti\", \"b\": \"0 (ajallaan)\", \"o\": 0, \"v\": 20}, {\"kk\": \"Huhti\", \"b\": \"1 (1-30 pv)\", \"o\": 1, \"v\": 20}, {\"kk\": \"Huhti\", \"b\": \"2 (31-60 pv)\", \"o\": 2, \"v\": 20}, {\"kk\": \"Huhti\", \"b\": \"3 (61-90 pv)\", \"o\": 3, \"v\": 20}, {\"kk\": \"Huhti\", \"b\": \"4 (yli 90 pv)\", \"o\": 4, \"v\": 20}, {\"kk\": \"Touko\", \"b\": \"0 (ajallaan)\", \"o\": 0, \"v\": 20}, {\"kk\": \"Touko\", \"b\": \"1 (1-30 pv)\", \"o\": 1, \"v\": 20}, {\"kk\": \"Touko\", \"b\": \"2 (31-60 pv)\", \"o\": 2, \"v\": 20}, {\"kk\": \"Touko\", \"b\": \"3 (61-90 pv)\", \"o\": 3, \"v\": 20}, {\"kk\": \"Touko\", \"b\": \"4 (yli 90 pv)\", \"o\": 4, \"v\": 20}, {\"kk\": \"Kesa\", \"b\": \"0 (ajallaan)\", \"o\": 0, \"v\": 20}, {\"kk\": \"Kesa\", \"b\": \"1 (1-30 pv)\", \"o\": 1, \"v\": 20}, {\"kk\": \"Kesa\", \"b\": \"2 (31-60 pv)\", \"o\": 2, \"v\": 20}, {\"kk\": \"Kesa\", \"b\": \"3 (61-90 pv)\", \"o\": 3, \"v\": 20}, {\"kk\": \"Kesa\", \"b\": \"4 (yli 90 pv)\", \"o\": 4, \"v\": 20}, {\"kk\": \"Heina\", \"b\": \"0 (ajallaan)\", \"o\": 0, \"v\": 20}, {\"kk\": \"Heina\", \"b\": \"1 (1-30 pv)\", \"o\": 1, \"v\": 20}, {\"kk\": \"Heina\", \"b\": \"2 (31-60 pv)\", \"o\": 2, \"v\": 20}, {\"kk\": \"Heina\", \"b\": \"3 (61-90 pv)\", \"o\": 3, \"v\": 20}, {\"kk\": \"Heina\", \"b\": \"4 (yli 90 pv)\", \"o\": 4, \"v\": 20}, {\"kk\": \"Elo\", \"b\": \"0 (ajallaan)\", \"o\": 0, \"v\": 20}, {\"kk\": \"Elo\", \"b\": \"1 (1-30 pv)\", \"o\": 1, \"v\": 20}, {\"kk\": \"Elo\", \"b\": \"2 (31-60 pv)\", \"o\": 2, \"v\": 20}, {\"kk\": \"Elo\", \"b\": \"3 (61-90 pv)\", \"o\": 3, \"v\": 20}, {\"kk\": \"Elo\", \"b\": \"4 (yli 90 pv)\", \"o\": 4, \"v\": 20}]}, \"mark\": \"bar\", \"encoding\": {\"x\": {\"field\": \"kk\", \"type\": \"nominal\"}, \"y\": {\"field\": \"v\", \"type\": \"quantitative\"}, \"color\": {\"field\": \"b\", \"type\": \"nominal\", \"legend\": {\"orient\": \"bottom\"}}, \"order\": {\"field\": \"o\", \"type\": \"quantitative\"}}}"
        def un:string (MdVegaRender.withoutContainer(stacked))
        c.ok("\"container\" dropped" ((indexOf un "\"container\"") < 0))
        c.ok("a stated height kept" ((indexOf un "\"height\":340") >= 0))
        def comp6 (new VlCompile())
        def rt6 (new VlRuntime())
        rt6.run((comp6.compileSpec(((new VlJsonParser()).parse(un)))))
        print ("   bottom legend: plot width " + (to_string rt6.chartWidth))
        c.ok("a wide bottom legend leaves the plot its width" (rt6.chartWidth > 100.0))
        def p6 (new VlJsonParser())
        def s6:VlJson (p6.parse((MdVegaRender.grown(un 1200.0 10.0 2.5 420.0))))
        print ("   bottom legend, grown: width " + (to_string (s6.doubleOr("width" 0.0))))
        c.ok("…and fills the room" ((s6.doubleOr("width" 0.0)) > 700.0))
        c.ok("a stated width is kept to the plot's own proportions" ((indexOf g "\"height\":250") >= 0))
    }

    sfn hasStroke:boolean (sc:FlowScene want:string) {
        def i:int 0
        while (i < (array_length sc.items)) {
            def it:SceneItem (itemAt sc.items i)
            if (it.stroke == want) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; the longest horizontal two-point path in the scene drawn in the rule's
    ; black (not an axis's grey)
    sfn longestRun:double (sc:FlowScene) {
        def best:double 0.0
        def i:int 0
        while (i < (array_length sc.items)) {
            def it:SceneItem (itemAt sc.items i)
            if ((array_length it.pts) == 4) {
                def dx:double (fabs ((itemAt it.pts 2) - (itemAt it.pts 0)))
                def dy:double (fabs ((itemAt it.pts 3) - (itemAt it.pts 1)))
                if ((dy < 0.5) && (dx > best)) {
                    if (it.stroke == "#000000") {
                        best = dx
                    }
                }
            }
            i = (i + 1)
        }
        return best
    }

    ; --- the small answers ----------------------------------------------------

    sfn textNamed:SceneItem (sc:FlowScene want:string) {
        def i:int 0
        while (i < (array_length sc.items)) {
            def it:SceneItem (itemAt sc.items i)
            if (it.kind == 1) {
                if (it.text == want) {
                    return it
                }
            }
            i = (i + 1)
        }
        return (new SceneItem())
    }

    sfn overABar:boolean (sc:FlowScene x:double) {
        def i:int 0
        while (i < (array_length sc.items)) {
            def it:SceneItem (itemAt sc.items i)
            if (it.kind == 0) {
                if (x >= it.x) {
                    if (x <= (it.x + it.w)) {
                        return true
                    }
                }
            }
            i = (i + 1)
        }
        return false
    }

    sfn allInside:boolean (sc:FlowScene) {
        def i:int 0
        while (i < (array_length sc.items)) {
            def it:SceneItem (itemAt sc.items i)
            def box:[double] (MdVegaRender.boundsOf(it))
            if ((itemAt box 0) < sc.worldX) {
                return false
            }
            if ((itemAt box 1) < sc.worldY) {
                return false
            }
            if ((itemAt box 2) > (sc.worldX + sc.worldW)) {
                return false
            }
            if ((itemAt box 3) > (sc.worldY + sc.worldH)) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    sfn mentions:boolean (hay:string needle:string) {
        def n:int (strlen needle)
        def m:int (strlen hay)
        if (n == 0) {
            return true
        }
        def i:int 0
        while ((i + n) <= m) {
            if ((substring hay i (i + n)) == needle) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn run:void () {
        def c (new VegaCheck())
        print "== MdVegaTest =="
        this.words(c)
        this.marks(c)
        this.refused(c)
        this.centred(c)
        this.turned(c)
        this.fromTheSpec(c)
        this.grownToFit(c)
        print ""
        print (("passed=" + (to_string c.passed)) + (" failed=" + (to_string c.failed)))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }
}

Import "../src/MdEditController.rgr"

class RepoTest {
    sfn main:void () {
        def e:MdEditController (new MdEditController())
        e.open("alpha beta\n\nsecond line here\n\nthird line\n")
        e.setViewWidth(484.0)
        e.setCaret(41)
        e.insertText("\n\nwrite something here")
        e.ensureLayout()
        print (("source len " + (to_string (strlen (e.text())))) + ("  caret " + (to_string (e.caret()))))
        print (("lines " + (to_string (e.lines.count()))))
        def i:int 0
        while (i < (e.lines.count())) {
            print (((((("  line " + (to_string i)) + " y=") + (to_string (to_int (e.lines.topAt(i))))) + " [") + (to_string (e.lines.startAt(i)))) + ("," + (to_string (e.lines.endAt(i))) + "]"))
            i = (i + 1)
        }
        print (("indexOfOffset(caret) = " + (to_string (OfficeLineNav.indexOfOffset(e.lines (e.caret()))))))
        print (("caretX = " + (to_string (to_int (e.caretX())))))
        e.moveUp(false)
        print (("after up:   " + (to_string (e.caret()))))
        e.moveDown(false)
        print (("after down: " + (to_string (e.caret()))))
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MdPptxTest.rgr — the deck goes out, and comes back the same deck.
; ============================================================================
;
;   npm run markdown:pptx:test
;
; `PLAN_SLIDES.md` Stage E, and its "done when" exactly: a deck exported from
; the sample is written to a real `.pptx`, opened again with the same reader
; `pptx:test` drives, and comes back with the same heading text, the same
; bullet count and the same slide count.
;
; **Through the file, not through the model.** Checking the model the exporter
; built would pass on a deck the writer cannot spell and the parser cannot
; read — which is most of the ways this can be wrong. `save()` and `open()`
; are the round trip, and what survives them is what a reader gets.
;
; **The counts are of the NOUNS the failure is about.** A deck of the right
; number of slides, each one a picture of a slide, is the exact failure §2 of
; the plan exists to avoid — so what is counted is TITLE PLACEHOLDERS, BULLET
; PARAGRAPHS and TABLE CELLS, none of which a display-list export produces at
; all.
; ============================================================================

Import "../src/MdToPptx.rgr"
Import "../src/MdBlock.rgr"
Import "../src/MdCss.rgr"
Import "../src/MdDiagram.rgr"
Import "../src/MdThemes.rgr"
Import "../../pptx/src/PptxA11y.rgr"
Import "../../vfs/src/Vfs.rgr"
Import "../../pptx/src/PptxEdit.rgr"
Import "../src/MdDeckDiagram.rgr"


class DeckCheck {
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print ("    got  [" + (got + "]"))
            print ("    want [" + (want + "]"))
        }
    }

    fn eqInt:void (name:string got:int want:int) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print (("    got  " + (to_string got)) + (" want " + (to_string want)))
        }
    }
}

class MdPptxTest {
    def maker:MdToPptx (new MdToPptx())

    sfn main:void () {
        def t:MdPptxTest (new MdPptxTest())
        t.run()
    }

    ; The whole road, from markdown to a deck: parse, resolve the template,
    ; draw the diagrams, lay out as slides, export.
    fn build:PptxDeck (src:string css:string) {
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        def c:MdCss (new MdCss())
        c.addStyleSheet(css)
        c.applyTo(l.style)
        l.setStyleSheet(css)
        l.applyMeta(doc)
        l.applySlideMeta(doc)
        def cw:double (l.style.pageWidth - (l.style.margin * 2.0))
        MdDiagram.prepare(doc l.embeds cw "default")
        l.setDocSource(src)
        l.layoutSlides(doc)
        maker = (new MdToPptx())
        return (maker.deck(doc l))
    }

    ; The same road with a byte store under it.
    fn buildWithImages:PptxDeck (src:string css:string v:Vfs) {
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        def c:MdCss (new MdCss())
        c.addStyleSheet(css)
        c.applyTo(l.style)
        l.setStyleSheet(css)
        l.applyMeta(doc)
        l.applySlideMeta(doc)
        l.setImages(v "/")
        def cw:double (l.style.pageWidth - (l.style.margin * 2.0))
        MdDiagram.prepare(doc l.embeds cw "default")
        l.setDocSource(src)
        l.layoutSlides(doc)
        maker = (new MdToPptx())
        return (maker.deck(doc l))
    }

    ; …and back through the file, which is the only trip that proves anything.
    fn reopened:PptxDeck (d:PptxDeck) {
        return (PptxApi.open((d.save())))
    }

    ; ----------------------------------------------------------------------
    ; Counting the nouns
    ; ----------------------------------------------------------------------
    sfn titles:int (d:PptxDeck) {
        def c:int 0
        def s:int 0
        while (s < (d.slideCount())) {
            def sl:PptxSlideRef (d.slideAt(s))
            def k:int 0
            while (k < (sl.shapeCount())) {
                def sh:PptxShapeRef (sl.shapeAt(k))
                def m:PptxShape (sh.model())
                if (m.phType == "title") { c = (c + 1) }
                k = (k + 1)
            }
            s = (s + 1)
        }
        return c
    }

    sfn bullets:int (d:PptxDeck) {
        def c:int 0
        def s:int 0
        while (s < (d.slideCount())) {
            def sl:PptxSlideRef (d.slideAt(s))
            def k:int 0
            while (k < (sl.shapeCount())) {
                def sh:PptxShapeRef (sl.shapeAt(k))
                def m:PptxShape (sh.model())
                def p:int 0
                while (p < (array_length m.text.paragraphs)) {
                    def par:PptxParagraph (itemAt m.text.paragraphs p)
                    if par.hasBullet { c = (c + 1) }
                    p = (p + 1)
                }
                k = (k + 1)
            }
            s = (s + 1)
        }
        return c
    }

    sfn tableCells:string (d:PptxDeck) {
        def out:string ""
        def s:int 0
        while (s < (d.slideCount())) {
            def sl:PptxSlideRef (d.slideAt(s))
            def k:int 0
            while (k < (sl.shapeCount())) {
                def sh:PptxShapeRef (sl.shapeAt(k))
                def m:PptxShape (sh.model())
                if (m.kind == 4) {
                    def i:int 0
                    while (i < (array_length m.tableCells)) {
                        def cell:PptxTableCell (itemAt m.tableCells i)
                        out = ((out + cell.text) + "|")
                        i = (i + 1)
                    }
                }
                k = (k + 1)
            }
            s = (s + 1)
        }
        return out
    }

    sfn titleText:string (d:PptxDeck) {
        def out:string ""
        def s:int 0
        while (s < (d.slideCount())) {
            def sl:PptxSlideRef (d.slideAt(s))
            def k:int 0
            while (k < (sl.shapeCount())) {
                def sh:PptxShapeRef (sl.shapeAt(k))
                def m:PptxShape (sh.model())
                if (m.phType == "title") {
                    out = ((out + (PptxApi.textOf(m))) + "|")
                }
                k = (k + 1)
            }
            s = (s + 1)
        }
        return out
    }

    ; How many shapes are GROUPS, which is what a drawing comes out as. The
    ; whole point of Stage E is that this is the exception rather than every
    ; shape on every slide.
    ; The first group on a slide, or an empty shape when there is none.

    ; ----------------------------------------------------------------------
    ; A picture is bytes
    ; ----------------------------------------------------------------------
    ;
    ; `![alt](logo.png)` drew as its ALT TEXT for as long as this module has
    ; existed, because a markdown layout had no bytes for a picture. That was
    ; honest and it was the blocker under images, background images and every
    ; CSS `url(...)`.
    ;
    ; The check is that ONE store answers both: the layout that sized the
    ; picture and the deck that carries it ask the same `Vfs`, so the preview
    ; and the file cannot be missing different pictures. Two stores would look
    ; identical here and fail the first time a reader uploaded something.
    fn pictures:void (c:DeckCheck) {
        print "-- a picture is bytes, not alt text --"
        def v (new Vfs())
        def mem (new VfsMemory())
        ; A 1x1 PNG is all this needs: the claim is about the BYTES arriving,
        ; not about what they decode to.
        def blob (new VfsBlob())
        def raw:string "PNGBYTESHERE"
        def buf:buffer (buffer_alloc (strlen raw))
        def bi:int 0
        while (bi < (strlen raw)) {
            buffer_set buf bi (charAt raw bi)
            bi = (bi + 1)
        }
        blob.bytes = buf
        blob.contentType = "image/png"
        blob.pixelW = 240
        blob.pixelH = 120
        mem.put("/logo.png" blob)
        v.mount("/" mem)

        def src:string "# Title\n\n![Yhtion logo](logo.png)\n\nTeksti kuvan alla.\n"
        def css:string "page { width: 720pt; height: 405pt; padding: 36pt }"

        ; Without a store: alt text, and the deck says so. The old behaviour,
        ; kept as a check rather than as a memory.
        def plain:PptxDeck (this.build(src css))
        c.eqInt("with no store the picture is counted as missing" maker.result.images 1)
        c.eqInt("…and none was placed" maker.result.placed 0)

        ; With one: a picture, in the layout and in the file.
        def d:PptxDeck (this.buildWithImages(src css v))
        c.eqInt("with a store, one picture is placed" maker.result.placed 1)
        c.eqInt("…and none is reported missing" maker.result.images 0)

        ; The LAYOUT drew a picture box, which is what the preview shows.
        c.eqInt("the layout drew it as a picture" (MdPptxTest.pictureBoxes(maker.layout)) 1)

        ; …and the bytes are in the FILE, not just in the model.
        def back:PptxDeck (this.reopened(d))
        def got:PptxShape (MdPptxTest.firstPicture(back))
        c.ok("the picture came back out of the file" (got.kind == 1))
        c.eqInt("…with its bytes" (buffer_length got.imageBytes) (strlen raw))
        c.eqStr("…and the alt text the document gave it" got.altText "Yhtion logo")

        ; A picture nobody can find is alt text again — and the preview and
        ; the deck are missing the SAME one, which is the whole reason they
        ; share a store.
        def gone:string "# Title\n\n![Poissa](nope.png)\n"
        def g:PptxDeck (this.buildWithImages(gone css v))
        c.eqInt("a picture nobody has is not placed" maker.result.placed 0)
        c.eqInt("…and the layout did not draw one either" (MdPptxTest.pictureBoxes(maker.layout)) 0)
        c.eqInt("…and the layout counted it as missing" maker.layout.missingImages 1)

        ; ------------------------------------------------------------------
        ; A background is a picture too
        ; ------------------------------------------------------------------
        ;
        ; The property readers ask for first, and the one a company template
        ; is mostly made of. `PptxWriter` could say a slide's ground was a
        ; COLOUR and nothing else, and `MdCss` had `background-color` three
        ; times — for code, for a table head, for a blockquote — and none for
        ; the page.
        ;
        ; Checked through the FILE, because the black-on-black theme bug is
        ; the reason not to trust a preview about a background.
        def bgCss:string "page { width: 720pt; height: 405pt; padding: 36pt; background-color: #102040; background-image: url(logo.png) }"
        def bgSrc:string "# Title\n\nTeksti.\n"
        def bd:PptxDeck (this.buildWithImages(bgSrc bgCss v))
        c.eqInt("every slide got the template's background" maker.result.backgrounds 1)
        c.eqStr("…and the page colour reached the style" maker.layout.style.pageBackground "#102040")

        def bback:PptxDeck (this.reopened(bd))
        def bsl:PptxSlideRef (bback.slideAt(0))
        def bmodel:PptxSlide (bsl.model())
        c.ok("the background picture came back out of the file"
            ((buffer_length bmodel.bgImage) == (strlen raw)))
        c.ok("…and it is the picture the template named"
            ((strlen bmodel.bgImageName) > 0))
    }


    ; ----------------------------------------------------------------------
    ; A drawing is an object a reader handles
    ; ----------------------------------------------------------------------
    ;
    ; The reader's words: the PPTX renderer has to embed diagrams as objects
    ; that can be MOVED, and at minimum their size has to be changeable.
    ;
    ; Most of that is `PptxEditor` already working on a group, and this is the
    ; check that it does — through the editor and not through the model, so a
    ; drawing is handled by the same code every other shape is. What needs
    ; deciding is what a RESIZE means, and the honest answer is that it
    ; scales: PowerPoint scales a group's child space, and re-laying a diagram
    ; out at its new size would need something running inside PowerPoint. The
    ; markdown side's `{width=360}` is the way to re-flow one.
    fn drawingObject:void (c:DeckCheck) {
        print "-- a drawing is moved and resized like any other shape --"
        def src:string "# Title\n\n```dot\ndigraph { a -> b; }\n```\n"
        def css:string "page { width: 720pt; height: 405pt; padding: 36pt }"
        def d:PptxDeck (this.build(src css))

        def ed (new PptxEditor())
        ed.attach(d.pres)
        def sl0:PptxSlideRef (d.slideAt(0))
        def g:PptxShape (MdPptxTest.firstGroup(sl0))
        c.ok("there is a drawing to handle" (g.kind == 2))
        if (g.kind != 2) { return }
        def wasX:double g.x
        def wasY:double g.y
        def wasW:double g.width
        def wasH:double g.height

        ; Selected the way a click selects it, from the middle of the group.
        def midX:double (g.x + (g.width / 2.0))
        def midY:double (g.y + (g.height / 2.0))
        c.ok("a click inside it selects it" (ed.selectAt(midX midY false)))
        c.eqInt("…and selects exactly one thing" (array_length ed.selection) 1)

        c.ok("it moves" (ed.moveSelection(24.0 12.0)))
        c.ok("…and the move is on the shape" (((g.x - wasX) > 23.0) && ((g.y - wasY) > 11.0)))

        ; …and it is STILL one group afterwards. A move that flattened a
        ; drawing into loose shapes would look identical on the slide and be
        ; unusable the next time a reader touched it.
        def after:PptxShape (MdPptxTest.firstGroup(sl0))
        c.ok("…and it is still one group" (after.kind == 2))
        c.eqInt("…with the same children in it" (array_length after.children) (array_length g.children))

        c.ok("one undo puts it back" (ed.undo()))
        def back:PptxShape (MdPptxTest.firstGroup(sl0))
        c.ok("…exactly where it was" (((fabs (back.x - wasX)) < 0.01) && ((fabs (back.y - wasY)) < 0.01)))

        ; …and the size, which is the half the reader asked for by name.
        ed.selectAt(midX midY false)
        c.ok("it resizes" (ed.resizeSelection(4 40.0 20.0)))
        def sized:PptxShape (MdPptxTest.firstGroup(sl0))
        c.ok("…and the extent changed" ((fabs (sized.width - wasW)) > 1.0))

        ; The trip that proves it: out through the writer and back.
        def outDeck:PptxDeck (this.reopened(d))
        def rsl:PptxSlideRef (outDeck.slideAt(0))
        def r:PptxShape (MdPptxTest.firstGroup(rsl))
        c.ok("the drawing came back as one group" (r.kind == 2))
        c.ok("…at the size it was left at" ((fabs (r.width - sized.width)) < 1.0))
        c.ok("…and still knowing what it is" (MdPptxTest.hasSub(r.name "Graphviz")))
        c.ok("…and still carrying its source" ((strlen r.embedSource) > 0))
    }


    ; ----------------------------------------------------------------------
    ; …and it can be edited, with the readers that drew it
    ; ----------------------------------------------------------------------
    ;
    ; The round trip the source was carried for. Not a new editor: the readers
    ; that draw a diagram are the ones that already draw it, and the drawing is
    ; `PptxFromEvg`'s. What is new is the REPLACE — same slide, same position,
    ; same identity, new geometry.
    ;
    ; The check counts the noun the change is about: a node ADDED to the source
    ; has to appear as a label on the slide. Asserting only that the group
    ; changed would pass on a redraw that lost everything.
    fn drawingEdit:void (c:DeckCheck) {
        print "-- a drawing on a slide can be read back and drawn again --"
        def src:string "# Title\n\n```dot\ndigraph { saapuu -> tarkista; }\n```\n"
        def css:string "page { width: 720pt; height: 405pt; padding: 36pt }"
        def d:PptxDeck (this.build(src css))
        def sl:PptxSlideRef (d.slideAt(0))
        def g:PptxShape (MdPptxTest.firstGroup(sl))
        c.ok("the slide has a drawing on it" (MdDeckDiagram.isDrawing(g)))
        if (! (MdDeckDiagram.isDrawing(g))) { return }

        def sl0:PptxSlide (sl.model())
        def found:[PptxShape] (MdDeckDiagram.drawingsOn(sl0))
        c.eqInt("…and it is found by asking the slide" (array_length found) 1)
        c.eqStr("its source is the fence a reader wrote"
            (MdDeckDiagram.sourceOf(g)) "digraph { saapuu -> tarkista; }\n")
        c.eqStr("…in the notation it was written in" (MdDeckDiagram.notationOf(g)) "graphviz")

        ; Where the reader left it, and how big.
        def wasX:double g.x
        def wasY:double g.y
        def hadLaskuta:boolean (MdPptxTest.groupHasLabel(g "laskuta"))
        c.ok("the node that is about to be added is not there yet" (! hadLaskuta))

        def better:string "digraph { saapuu -> tarkista; tarkista -> laskuta; }"
        c.ok("the drawing is drawn again from new text" (MdDeckDiagram.redraw(g better "default")))
        c.ok("…and the node that was added is on the slide" (MdPptxTest.groupHasLabel(g "laskuta")))
        c.ok("…and the ones that were there still are" (MdPptxTest.groupHasLabel(g "saapuu")))
        c.ok("…without moving it" (((fabs (g.x - wasX)) < 0.01) && ((fabs (g.y - wasY)) < 0.01)))
        c.ok("…and it is still one group" (g.kind == 2))
        c.eqStr("…now carrying the new source" (MdDeckDiagram.sourceOf(g)) better)
        c.ok("…and describing what is in it now" (MdPptxTest.hasSub(g.altText "laskuta")))

        ; Text that is not a diagram leaves the drawing exactly as it was. A
        ; reader halfway through typing a node has a source that does not
        ; parse, and blanking their slide at every keystroke would be worse
        ; than useless.
        def wasW:double g.width
        c.ok("half-typed text is refused" (! (MdDeckDiagram.redraw(g "digraph {" "default"))))
        c.ok("…and the drawing is untouched" ((fabs (g.width - wasW)) < 0.01))
        c.ok("…and still says what it says" (MdPptxTest.groupHasLabel(g "laskuta")))

        ; …and it survives the file it is written into.
        def back:PptxDeck (this.reopened(d))
        def rsl:PptxSlideRef (back.slideAt(0))
        def r:PptxShape (MdPptxTest.firstGroup(rsl))
        c.eqStr("the new source came back out of the file" (MdDeckDiagram.sourceOf(r)) better)
        c.ok("…and so did the node that was added" (MdPptxTest.groupHasLabel(r "laskuta")))
    }

    ; Does any text anywhere inside this group say `want`?
    sfn groupHasLabel:boolean (sh:PptxShape want:string) {
        if sh.hasText {
            def t:string (sh.text.plainText())
            if (MdPptxTest.hasSub(t want)) { return true }
        }
        def i:int 0
        while (i < (array_length sh.children)) {
            def k:PptxShape (itemAt sh.children i)
            if (MdPptxTest.groupHasLabel(k want)) { return true }
            i = (i + 1)
        }
        return false
    }

    sfn pictureBoxes:int (l:MdLayout) {
        def n:int 0
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 4) { n = (n + 1) }
            i = (i + 1)
        }
        return n
    }

    sfn firstPicture:PptxShape (d:PptxDeck) {
        def s:int 0
        while (s < (d.slideCount())) {
            def sl:PptxSlideRef (d.slideAt(s))
            def k:int 0
            while (k < (sl.shapeCount())) {
                def sh:PptxShapeRef (sl.shapeAt(k))
                def m:PptxShape (sh.model())
                if (m.kind == 1) { return m }
                k = (k + 1)
            }
            s = (s + 1)
        }
        return (new PptxShape())
    }

    sfn firstGroup:PptxShape (sl:PptxSlideRef) {
        def k:int 0
        while (k < (sl.shapeCount())) {
            def sh:PptxShapeRef (sl.shapeAt(k))
            def m:PptxShape (sh.model())
            if (m.kind == 2) { return m }
            k = (k + 1)
        }
        return (new PptxShape())
    }

    sfn groups:int (d:PptxDeck) {
        def c:int 0
        def s:int 0
        while (s < (d.slideCount())) {
            def sl:PptxSlideRef (d.slideAt(s))
            def k:int 0
            while (k < (sl.shapeCount())) {
                def sh:PptxShapeRef (sl.shapeAt(k))
                def m:PptxShape (sh.model())
                if (m.kind == 2) { c = (c + 1) }
                k = (k + 1)
            }
            s = (s + 1)
        }
        return c
    }

    sfn deckText:string (d:PptxDeck) {
        def out:string ""
        def s:int 0
        while (s < (d.slideCount())) {
            def sl:PptxSlideRef (d.slideAt(s))
            out = ((out + (sl.text())) + "\n--\n")
            s = (s + 1)
        }
        return out
    }

    ; ----------------------------------------------------------------------
    fn roundTrip:void (c:DeckCheck) {
        print "-- out through the writer, back through the reader --"
        def src:string (?? (read_file "." "gallery/markdown/fixtures/deck.md") "")
        def css:string (?? (read_file "." "gallery/markdown/fixtures/themes/corporate.css") "")
        c.ok("the sample is readable" ((strlen src) > 100))
        c.ok("…and the template" ((strlen css) > 100))

        def made:PptxDeck (this.build(src css))
        def back:PptxDeck (this.reopened(made))

        c.eqInt("the same slides came back" (back.slideCount()) (made.slideCount()))
        c.eqInt("…one per slide the layout made" (made.slideCount()) 5)
        c.eqInt("the same titles" (MdPptxTest.titles(back)) (MdPptxTest.titles(made)))
        c.eqInt("…one on each slide" (MdPptxTest.titles(back)) 5)
        c.eqStr("with the same words in them" (MdPptxTest.titleText(back)) (MdPptxTest.titleText(made)))
        c.eqStr("…which are the document's headings" (MdPptxTest.titleText(back)) "Q3 Strategy|Mistä liikevaihto tuli|Tilausten kulku|Luvut|Mitä seuraavaksi|")

        c.eqInt("the same bullets" (MdPptxTest.bullets(back)) (MdPptxTest.bullets(made)))
        c.eqInt("…three and three, from the two lists" (MdPptxTest.bullets(back)) 6)

        c.eqStr("the same table, cell for cell" (MdPptxTest.tableCells(back)) (MdPptxTest.tableCells(made)))
        c.eqStr("…which is the document's table" (MdPptxTest.tableCells(back)) "Kanava|Q2|Q3|Verkkokauppa|4.1|4.8|Jälleenmyynti|2.2|2.2|Lisenssit|1.3|1.25|")

        c.eqStr("and every word on every slide" (MdPptxTest.deckText(back)) (MdPptxTest.deckText(made)))

        ; The claim of §2, as a number. A display-list export makes every
        ; shape a group or a one-line text box; this one has ONE group, for
        ; the one thing on the deck that is a drawing.
        c.eqInt("one drawing, drawn" (MdPptxTest.groups(made)) 1)
        c.eqInt("…and it survived the file too" (MdPptxTest.groups(back)) 1)
        ; …and it came back as an OBJECT, not as an anonymous pile of shapes.
        ; Checked on the deck that went through the writer and the reader,
        ; because a name and a description that live only in memory are not
        ; what a reader opens next year. `descr` is the carrier; `PptxA11y`
        ; already prefers it over every other way of naming a shape.
        def gname:string ""
        def galt:string ""
        def gs:int 0
        while (gs < (back.slideCount())) {
            def gsl:PptxSlideRef (back.slideAt(gs))
            def gg:PptxShape (MdPptxTest.firstGroup(gsl))
            if (gg.kind == 2) {
                gname = gg.name
                galt = gg.altText
            }
            gs = (gs + 1)
        }
        c.eqStr("the drawing came back named for its notation" gname "Graphviz diagram 1")
        c.ok("…and with the description it was given" ((strlen galt) > 0))
        c.ok("…which names the notation" (MdPptxTest.hasSub(galt "Graphviz diagram")))
        c.ok("…and says what is drawn in it" (MdPptxTest.hasSub(galt "tarkista")))

        ; And this is where it lands for a reader who cannot see the slide.
        ; No change was needed in the pptx module for that: `shapeName` has
        ; always preferred `descr` over every other way of naming a shape, and
        ; the writer and the parser have always carried it. What was missing
        ; was anything to carry — this exporter left the field empty, so a
        ; drawing reached a screen reader as the word "Drawing" at best.
        def sl0:PptxSlideRef (back.slideAt(0))
        def gsh:PptxShape (MdPptxTest.firstGroup(sl0))
        def gs2:int 1
        while (gs2 < (back.slideCount())) {
            def sln:PptxSlideRef (back.slideAt(gs2))
            def cand:PptxShape (MdPptxTest.firstGroup(sln))
            if (cand.kind == 2) { gsh = cand }
            gs2 = (gs2 + 1)
        }
        def said:string (PptxA11y.shapeName(gsh))
        c.eqStr("a screen reader is told what the drawing is" said galt)

        ; …and the source it was generated from came back BYTE FOR BYTE, which
        ; is the only form of it worth carrying. A diagram cannot be
        ; reconstructed from the shapes it drew — a class diagram and a
        ; sequence diagram draw the same rectangles — so a deck written
        ; without this can be moved and resized and never edited again.
        c.eqStr("the notation came back" gsh.embedNotation "graphviz")
        def fence:string "digraph {\n  rankdir=LR;\n  node [shape=box];\n  saapuu -> tarkista;\n  tarkista -> laskuta [label=\"ok\"];\n  tarkista -> hylkaa [label=\"ei\"];\n}\n"
        c.eqStr("…and the fence's own text, byte for byte" gsh.embedSource fence)

        c.eqInt("the exporter counted it" maker.result.drawn 1)
        c.eqInt("…and dropped nothing" maker.result.dropped 0)
        c.ok("…and said what it did" ((maker.result.noteCount()) > 0))
    }

    ; The part a reader can actually change: a paragraph is ONE text box with
    ; ONE run, not one box per drawn line. That is the whole difference
    ; between this road and the display-list road, and it is invisible to a
    ; check that only counts slides.
    fn editable:void (c:DeckCheck) {
        print "-- a paragraph is one text box, not five --"
        ; Long enough that the layout wraps it across several lines.
        def src:string "# Title\n\nA paragraph long enough that the layout will break it across four or five lines at this width, which is the case the whole of Stage E is about, and one more clause so that it certainly does.\n"
        def css:string "page { width: 720pt; height: 405pt; padding: 36pt } document { font-size: 20pt }"
        def d:PptxDeck (this.build(src css))
        def back:PptxDeck (this.reopened(d))
        def sl:PptxSlideRef (back.slideAt(0))
        c.eqInt("a title and a body, and nothing else" (sl.shapeCount()) 2)
        def body:PptxShapeRef (sl.shapeAt(1))
        c.eqInt("the paragraph is one paragraph" (body.paragraphCount()) 1)
        c.eqInt("…of one run" (body.runCount(0)) 1)
        def r:PptxRunRef (body.runAt(0 0))
        c.ok("…holding the whole sentence" ((strlen (r.text())) > 150))

        ; And it is placed where the layout put it, so the deck looks like
        ; the preview even though PowerPoint does the wrapping.
        def m:PptxShape (body.model())
        c.ok("placed inside the slide" ((m.x >= 0.0) && ((m.x + m.width) <= 721.0)))
        c.ok("…and below the title" (m.y > 36.0))
    }

    ; Nested lists become LEVELS, which is how PowerPoint spells a sub-bullet
    ; — not a second shape, which would not be the same list.
    fn levels:void (c:DeckCheck) {
        print "-- a nested list is a level, not a second box --"
        def src:string "# Title\n\n- one\n  - under one\n  - also under one\n- two\n"
        def css:string "page { width: 720pt; height: 405pt; padding: 36pt }"
        def d:PptxDeck (this.build(src css))
        def back:PptxDeck (this.reopened(d))
        def sl:PptxSlideRef (back.slideAt(0))
        c.eqInt("one box for the whole list" (sl.shapeCount()) 2)
        def body:PptxShapeRef (sl.shapeAt(1))
        def m:PptxShape (body.model())
        def spelled:string ""
        def p:int 0
        while (p < (array_length m.text.paragraphs)) {
            def par:PptxParagraph (itemAt m.text.paragraphs p)
            spelled = ((spelled + (to_string par.level)) + ":")
            def rr:int 0
            while (rr < (array_length par.runs)) {
                def run:PptxTextRun (itemAt par.runs rr)
                spelled = (spelled + run.text)
                rr = (rr + 1)
            }
            spelled = (spelled + "|")
            p = (p + 1)
        }
        c.eqStr("four bullets, two of them one level in" spelled "0:one|1:under one|1:also under one|0:two|")
    }

    ; An ordered list is numbered by PowerPoint, not by us — so the numbers
    ; renumber when somebody inserts one.
    fn numbering:void (c:DeckCheck) {
        print "-- an ordered list is numbered by PowerPoint --"
        def src:string "# Title\n\n1. first\n2. second\n3. third\n"
        def css:string "page { width: 720pt; height: 405pt; padding: 36pt }"
        def d:PptxDeck (this.build(src css))
        def back:PptxDeck (this.reopened(d))
        def sl:PptxSlideRef (back.slideAt(0))
        def body:PptxShapeRef (sl.shapeAt(1))
        def m:PptxShape (body.model())
        def auto:int 0
        def texts:string ""
        def p:int 0
        while (p < (array_length m.text.paragraphs)) {
            def par:PptxParagraph (itemAt m.text.paragraphs p)
            if par.bulletAutoNum { auto = (auto + 1) }
            def rr:int 0
            while (rr < (array_length par.runs)) {
                def run:PptxTextRun (itemAt par.runs rr)
                texts = ((texts + run.text) + "|")
                rr = (rr + 1)
            }
            p = (p + 1)
        }
        c.eqInt("three auto-numbered paragraphs" auto 3)
        c.eqStr("…and the numbers are not in the text" texts "first|second|third|")
    }

    ; ----------------------------------------------------------------------
    ; The three things that were right in the file and wrong on the screen
    ; ----------------------------------------------------------------------
    ;
    ; Each of these round-tripped perfectly and drew as nothing, or as a pile
    ; in the corner. A check that only reads the model back cannot see any of
    ; them, so each one counts what the RENDERER reads.
    fn drawable:void (c:DeckCheck) {
        print "-- and it draws, not just parses --"
        def src:string (?? (read_file "." "gallery/markdown/fixtures/deck.md") "")
        def css:string (?? (read_file "." "gallery/markdown/fixtures/themes/corporate.css") "")
        def back:PptxDeck (this.reopened((this.build(src css))))

        ; 1. A TABLE CELL IS A TEXT BODY. `cell.text` beside it is the
        ; shorthand the writer falls back to; nothing that DRAWS a deck reads
        ; it. A table built with only the shorthand is a grid of empty boxes
        ; on screen and a table of words in the file.
        def withText:int 0
        def withBody:int 0
        def s:int 0
        while (s < (back.slideCount())) {
            def sl:PptxSlideRef (back.slideAt(s))
            def k:int 0
            while (k < (sl.shapeCount())) {
                def sh:PptxShapeRef (sl.shapeAt(k))
                def m:PptxShape (sh.model())
                if (m.kind == 4) {
                    def i:int 0
                    while (i < (array_length m.tableCells)) {
                        def cell:PptxTableCell (itemAt m.tableCells i)
                        if ((strlen cell.text) > 0) { withText = (withText + 1) }
                        if ((array_length cell.body.paragraphs) > 0) { withBody = (withBody + 1) }
                        i = (i + 1)
                    }
                }
                k = (k + 1)
            }
            s = (s + 1)
        }
        c.eqInt("every cell has words" withText 12)
        c.eqInt("…and every one of them is a text body" withBody withText)

        ; 2. THE GRID IS THE LAYOUT'S. Equal division is what a table looks
        ; like when nobody asked how wide the columns are, and it writes a
        ; label across the cell beside it.
        def grid:string ""
        def s2:int 0
        while (s2 < (back.slideCount())) {
            def sl2:PptxSlideRef (back.slideAt(s2))
            def k2:int 0
            while (k2 < (sl2.shapeCount())) {
                def sh2:PptxShapeRef (sl2.shapeAt(k2))
                def m2:PptxShape (sh2.model())
                if (m2.kind == 4) {
                    def w0:double (itemAt m2.tableColW 0)
                    def w1:double (itemAt m2.tableColW 1)
                    if ((fabs (w0 - w1)) > 1.0) { grid = "uneven" } { grid = "equal" }
                }
                k2 = (k2 + 1)
            }
            s2 = (s2 + 1)
        }
        c.eqStr("the columns are as wide as their words need" grid "uneven")

        ; 3. A DIAGRAM IS PLACED. Its paths carry an `svgPath` and a `viewBox`
        ; and are put where their container's box is — built straight off the
        ; tree, with nothing laid out, the edges come out absolute and every
        ; node's label lands in the corner. So: the group's children must be
        ; spread across it, not piled at its origin.
        def spread:double 0.0
        def kids:int 0
        def s3:int 0
        while (s3 < (back.slideCount())) {
            def sl3:PptxSlideRef (back.slideAt(s3))
            def k3:int 0
            while (k3 < (sl3.shapeCount())) {
                def sh3:PptxShapeRef (sl3.shapeAt(k3))
                def m3:PptxShape (sh3.model())
                if (m3.kind == 2) {
                    kids = (array_length m3.children)
                    def i3:int 0
                    while (i3 < kids) {
                        def kid:PptxShape (itemAt m3.children i3)
                        def dx:double (kid.x - m3.x)
                        if (dx > spread) { spread = dx }
                        i3 = (i3 + 1)
                    }
                }
                k3 = (k3 + 1)
            }
            s3 = (s3 + 1)
        }
        c.ok("the drawing has parts" (kids > 4))
        c.ok("…and they are spread across it, not piled at its corner" (spread > 100.0))
    }

    ; A list the sheet gave columns to is ONE SHAPE PER COLUMN, at the
    ; rectangle the layout put that column's items in.
    ;
    ; The first answer was one shape with `a:bodyPr@numCol`, which keeps it
    ; one list and is what PresentationML says. It is not a safe answer: the
    ; rectangle a columned block gets is wide and SHORT — as tall as one
    ; column — so a reader that does not honour `numCol` stacks every item in
    ; it and draws the block below on top of the overflow. That was reported
    ; from a real reader, so the geometry carries it instead.
    ;
    ; The check is therefore not "what does the file say" but "could anything
    ; land on anything": no two shapes on a slide may overlap.
    fn columns:void (c:DeckCheck) {
        print "-- a list in columns is one shape per column --"
        def src:string "# Title

- one
- two
- three
- four
- five
- six
{.c3}
"
        def css:string "page { width: 720pt; height: 405pt; padding: 36pt } .c3 { column-count: 3; column-gap: 20pt }"
        def back:PptxDeck (this.reopened((this.build(src css))))
        def sl:PptxSlideRef (back.slideAt(0))
        c.eqInt("a title and three columns" (sl.shapeCount()) 4)
        c.eqInt("…holding all six bullets between them" (MdPptxTest.bullets(back)) 6)
        c.eqStr("…in document order, down each column" (MdPptxTest.columnOrder(sl)) "one,two|three,four|five,six")
        c.eqInt("and nothing is drawn on top of anything" (MdPptxTest.overlaps(sl)) 0)

        ; The columns are side by side and level with each other, which is
        ; what makes them columns rather than three boxes.
        def sa:PptxShapeRef (sl.shapeAt(1))
        def sb:PptxShapeRef (sl.shapeAt(2))
        def a:PptxShape (sa.model())
        def b:PptxShape (sb.model())
        c.ok("the second column is right of the first" (b.x > (a.x + a.width)))
        c.ok("…and level with it" ((fabs (a.y - b.y)) < 1.0))

        ; A list nobody styled is still one shape, so a deck that never asked
        ; for columns is the deck it always was.
        def plainSrc:string "# Title

- one
- two
"
        def plain:PptxDeck (this.reopened((this.build(plainSrc "page { width: 720pt; height: 405pt; padding: 36pt }"))))
        def ps:PptxSlideRef (plain.slideAt(0))
        c.eqInt("one column stays one shape" (ps.shapeCount()) 2)
        c.eqInt("…and nothing overlaps there either" (MdPptxTest.overlaps(ps)) 0)

        ; …and the whole sample, which is where the overlap was seen.
        def deckSrc:string (?? (read_file "." "gallery/markdown/fixtures/deck.md") "")
        def deckCss:string (?? (read_file "." "gallery/markdown/fixtures/themes/corporate.css") "")
        def full:PptxDeck (this.reopened((this.build(deckSrc deckCss))))
        def bad:int 0
        def s:int 0
        while (s < (full.slideCount())) {
            def one:PptxSlideRef (full.slideAt(s))
            bad = (bad + (MdPptxTest.overlaps(one)))
            s = (s + 1)
        }
        c.eqInt("and no slide of the sample has two shapes on each other" bad 0)
    }

    ; The words of each shape on a slide, shapes separated by `|` and the
    ; bullets inside one by `,` — which says both WHICH column each item
    ; landed in and in what ORDER. A deal that went across the rows instead
    ; of down the columns gets the second half of this wrong.
    sfn columnOrder:string (sl:PptxSlideRef) {
        def out:string ""
        def k:int 1
        while (k < (sl.shapeCount())) {
            def sh:PptxShapeRef (sl.shapeAt(k))
            def m:PptxShape (sh.model())
            if (k > 1) { out = (out + "|") }
            def p:int 0
            while (p < (array_length m.text.paragraphs)) {
                def par:PptxParagraph (itemAt m.text.paragraphs p)
                if (p > 0) { out = (out + ",") }
                def r:int 0
                while (r < (array_length par.runs)) {
                    def run:PptxTextRun (itemAt par.runs r)
                    out = (out + run.text)
                    r = (r + 1)
                }
                p = (p + 1)
            }
            k = (k + 1)
        }
        return out
    }

    ; How many pairs of shapes on this slide overlap — the noun the reader
    ; reported, which is text on text.
    sfn overlaps:int (sl:PptxSlideRef) {
        def hits:int 0
        def i:int 0
        while (i < (sl.shapeCount())) {
            def sa2:PptxShapeRef (sl.shapeAt(i))
            def a:PptxShape (sa2.model())
            def j:int (i + 1)
            while (j < (sl.shapeCount())) {
                def sb2:PptxShapeRef (sl.shapeAt(j))
                def b:PptxShape (sb2.model())
                def over:boolean true
                if ((a.x + a.width) <= (b.x + 0.5)) { over = false }
                if ((b.x + b.width) <= (a.x + 0.5)) { over = false }
                if ((a.y + a.height) <= (b.y + 0.5)) { over = false }
                if ((b.y + b.height) <= (a.y + 0.5)) { over = false }
                if over { hits = (hits + 1) }
                j = (j + 1)
            }
            i = (i + 1)
        }
        return hits
    }

    ; ----------------------------------------------------------------------
    ; One document, two companies
    ; ----------------------------------------------------------------------
    ;
    ; `PLAN_SLIDES.md` Stage F, and its "done when" exactly: one markdown file
    ; and two stylesheets give two decks that differ in EVERY measurement and
    ; not in A WORD of content.
    ;
    ; Both halves are the check. A template that changed nothing would pass a
    ; word-for-word comparison; one that changed the words would pass a
    ; measurement comparison. The claim is that the sheet is the only thing
    ; that moved.
    fn twoCompanies:void (c:DeckCheck) {
        print "-- one document, two companies --"
        def src:string (?? (read_file "." "gallery/markdown/fixtures/deck.md") "")
        def one:string (?? (read_file "." "gallery/markdown/fixtures/themes/corporate.css") "")
        def two:string (?? (read_file "." "gallery/markdown/fixtures/themes/editorial.css") "")
        c.ok("both templates are readable" (((strlen one) > 100) && ((strlen two) > 100)))

        def a:PptxDeck (this.reopened((this.build(src one))))
        def b:PptxDeck (this.reopened((this.build(src two))))

        ; Not a word of content.
        c.eqStr("the same words, template for template" (MdPptxTest.words(b)) (MdPptxTest.words(a)))

        ; …and every measurement differs, EXCEPT the one the document itself
        ; states. `deck.md` says `page: a4 landscape` in its front matter, and
        ; the document beats the template — which is the precedence the page
        ; size has had since before there were templates, and worth one check.
        def sa:PptxSlideRef (a.slideAt(0))
        def sb:PptxSlideRef (b.slideAt(0))
        c.ok("the sheet the DOCUMENT asked for, under both" ((fabs ((a.width()) - (b.width()))) < 1.0))
        def ta:PptxShape ((sa.shapeAt(0)).model())
        def tb:PptxShape ((sb.shapeAt(0)).model())
        c.ok("a different title size" ((fabs ((MdPptxTest.firstSize(ta)) - (MdPptxTest.firstSize(tb)))) > 1.0))
        c.ok("a different title face" ((MdPptxTest.firstFace(ta)) != (MdPptxTest.firstFace(tb))))
        c.ok("…and it starts in a different place" ((fabs (ta.x - tb.x)) > 1.0))
        def ba:PptxShape ((sa.shapeAt(1)).model())
        def bb:PptxShape ((sb.shapeAt(1)).model())
        c.ok("a different body size" ((fabs ((MdPptxTest.firstSize(ba)) - (MdPptxTest.firstSize(bb)))) > 0.5))
        c.ok("and a different colour somewhere" ((MdPptxTest.inks(a)) != (MdPptxTest.inks(b))))

        ; The one measurement a deck is judged by first: how many slides it
        ; took. `corporate` splits at level two and `editorial` at level one,
        ; so the same document is a different deck.
        c.ok("…and a different number of slides" ((a.slideCount()) != (b.slideCount())))
    }

    ; Every word of the deck, in document order, with no mark for where one
    ; SHAPE ends and the next begins — because that is exactly what a template
    ; is allowed to change. `corporate` puts a list in three boxes and
    ; `editorial` puts it in one; the words and their order are the same
    ; either way, and that is the claim being checked.
    sfn words:string (d:PptxDeck) {
        def out:string ""
        def s:int 0
        while (s < (d.slideCount())) {
            def sl:PptxSlideRef (d.slideAt(s))
            def k:int 0
            while (k < (sl.shapeCount())) {
                def sh:PptxShapeRef (sl.shapeAt(k))
                def m:PptxShape (sh.model())
                def p:int 0
                while (p < (array_length m.text.paragraphs)) {
                    def par:PptxParagraph (itemAt m.text.paragraphs p)
                    def r:int 0
                    while (r < (array_length par.runs)) {
                        def run:PptxTextRun (itemAt par.runs r)
                        if ((strlen (trim run.text)) > 0) {
                            out = ((out + (trim run.text)) + "\n")
                        }
                        r = (r + 1)
                    }
                    p = (p + 1)
                }
                if (m.kind == 4) {
                    def i:int 0
                    while (i < (array_length m.tableCells)) {
                        def cell:PptxTableCell (itemAt m.tableCells i)
                        out = ((out + cell.text) + "\n")
                        i = (i + 1)
                    }
                }
                k = (k + 1)
            }
            s = (s + 1)
        }
        return out
    }

    sfn firstSize:double (m:PptxShape) {
        if ((array_length m.text.paragraphs) == 0) { return 0.0 }
        def p:PptxParagraph (itemAt m.text.paragraphs 0)
        if ((array_length p.runs) == 0) { return 0.0 }
        def r:PptxTextRun (itemAt p.runs 0)
        return r.fontSizePt
    }

    sfn firstFace:string (m:PptxShape) {
        if ((array_length m.text.paragraphs) == 0) { return "" }
        def p:PptxParagraph (itemAt m.text.paragraphs 0)
        if ((array_length p.runs) == 0) { return "" }
        def r:PptxTextRun (itemAt p.runs 0)
        return r.fontFamily
    }

    sfn inks:string (d:PptxDeck) {
        def out:string ""
        def s:int 0
        while (s < (d.slideCount())) {
            def sl:PptxSlideRef (d.slideAt(s))
            def k:int 0
            while (k < (sl.shapeCount())) {
                def sh:PptxShapeRef (sl.shapeAt(k))
                def m:PptxShape (sh.model())
                def p:int 0
                while (p < (array_length m.text.paragraphs)) {
                    def par:PptxParagraph (itemAt m.text.paragraphs p)
                    def r:int 0
                    while (r < (array_length par.runs)) {
                        def run:PptxTextRun (itemAt par.runs r)
                        out = ((out + run.color.srgb) + ",")
                        r = (r + 1)
                    }
                    p = (p + 1)
                }
                k = (k + 1)
            }
            s = (s + 1)
        }
        return out
    }

    ; …and the name that picks between them, which is what makes it a THEME
    ; rather than a stylesheet somebody has to remember to attach.
    fn named:void (c:DeckCheck) {
        print "-- and the name that picks between them --"
        def reg:MdThemes (new MdThemes())
        reg.addTheme("corporate" "h1 { font-size: 40pt }")
        reg.addTheme("editorial" "h1 { font-size: 21pt }")
        c.eqInt("two templates, by name" (reg.count()) 2)

        def doc:MdNode (MdBlock.parseText("---
theme: Corporate
---

# One
"))
        c.eqStr("the document says which" (MdThemes.nameIn(doc)) "Corporate")
        c.eqStr("…and the name is not case-sensitive" (reg.cssFor(doc)) "h1 { font-size: 40pt }")

        def other:MdNode (MdBlock.parseText("---
theme: editorial
---

# One
"))
        c.eqStr("another document, another template" (reg.cssFor(other)) "h1 { font-size: 21pt }")

        def none:MdNode (MdBlock.parseText("# One
"))
        c.eqStr("a document that asks for none gets none" (reg.cssFor(none)) "")
        c.eqInt("…and that is not a complaint" (reg.missingCount()) 0)

        ; A name nobody registered is named, not swallowed. A page that laid
        ; the document out plain and said nothing would leave a reader to
        ; wonder whether the template or the document was wrong.
        def missing:MdNode (MdBlock.parseText("---
theme: nobodys
---

# One
"))
        c.eqStr("a template nobody has gives nothing" (reg.cssFor(missing)) "")
        c.eqInt("…and is counted" (reg.missingCount()) 1)
        c.eqStr("…by name" (reg.missingAt(0)) "nobodys")

        ; Registering the same name twice replaces it, which is what a page
        ; that re-fetches a template means by it.
        reg.addTheme("corporate" "h1 { font-size: 44pt }")
        c.eqInt("re-registering does not add a second" (reg.count()) 2)
        c.eqStr("…it replaces the first" (reg.sheetFor("corporate")) "h1 { font-size: 44pt }")
    }

    ; ----------------------------------------------------------------------
    ; …and what the export costs
    ; ----------------------------------------------------------------------
    ;
    ; `PLAN_SLIDES.md` Stage G. Three things do not survive the trip whole,
    ; and the contract is that none of them is silent: a caller must never be
    ; able to mistake a deck of alt text for a deck of pictures.
    fn cost:void (c:DeckCheck) {
        print "-- and what it costs --"
        def css:string "page { width: 720pt; height: 405pt; padding: 36pt }"

        ; A picture. `MdLayout` has no bytes for one — it draws the ALT TEXT,
        ; which is the most honest thing to draw when nobody read the file —
        ; so the deck carries the alt text too. Nothing is lost BETWEEN the
        ; preview and the deck; both are missing the same picture, and that is
        ; the sentence the accounting has to make available.
        def src:string "# Title

Before it.

![a chart of the quarter](chart.png)

After it.
"
        def d:PptxDeck (this.build(src css))
        c.eqInt("the picture is counted" maker.result.images 1)
        c.ok("…and said out loud" (MdPptxTest.noted(maker "alt text")))
        c.ok("…in the summary too" (MdPptxTest.hasSub((maker.result.describe()) "picture(s) named but not carried")))

        ; …and it is IN the deck, as its alt text, so the words are not lost.
        def back:PptxDeck (this.reopened(d))
        c.ok("the alt text is on the slide" (MdPptxTest.hasSub((MdPptxTest.words(back)) "a chart of the quarter")))

        ; A document with no picture says nothing about pictures, which is
        ; what makes the count worth reading when it is not zero.
        def plain:string "# Title

Just prose.
"
        this.build(plain css)
        c.eqInt("no picture, no count" maker.result.images 0)
        c.ok("…and nothing in the summary" (! (MdPptxTest.hasSub((maker.result.describe()) "picture"))))

        ; A diagram is drawn rather than written, and says so. It is still the
        ; one thing on a deck from here that a reader cannot EDIT — but it is
        ; an object they can move and resize, which is a different sentence
        ; from the one this note used to print.
        def withDiagram:string "# Title

```dot
digraph { a -> b; }
```
"
        def deck:PptxDeck (this.build(withDiagram css))
        c.eqInt("the diagram took the other road" maker.result.drawn 1)
        c.ok("…and says what a reader can and cannot do with it"
            (MdPptxTest.noted(maker "moved and resized, and not yet edited")))

        ; …and it is an OBJECT: named for what it is, and described for a
        ; reader who cannot see it. `PptxFromEvg` calls every group it builds
        ; `Drawing`, which is all a display list can tell it; the notation and
        ; the labels are known here and nowhere else.
        def dslide:PptxSlideRef (deck.slideAt(0))
        def dg:PptxShape (MdPptxTest.firstGroup(dslide))
        c.eqStr("the group says which notation it came from" dg.name "Graphviz diagram 1")
        c.ok("…and its description names the notation"
            (MdPptxTest.hasSub(dg.altText "Graphviz diagram")))
        c.ok("…and the labels that are in it"
            ((MdPptxTest.hasSub(dg.altText "a")) && (MdPptxTest.hasSub(dg.altText "b"))))
        c.eqInt("and nothing was dropped" maker.result.dropped 0)
    }

    sfn noted:boolean (m:MdToPptx maker:string) {
        def i:int 0
        while (i < (m.result.noteCount())) {
            if (MdPptxTest.hasSub((m.result.noteAt(i)) maker)) { return true }
            i = (i + 1)
        }
        return false
    }

    sfn hasSub:boolean (v:string needle:string) {
        def n:int (strlen needle)
        def m:int (strlen v)
        def i:int 0
        while (i <= (m - n)) {
            if ((substring v i (i + n)) == needle) { return true }
            i = (i + 1)
        }
        return false
    }

    ; The paper, and the faces.
    ;
    ; A slide with no background of its own falls back to the master, which
    ; falls back to the THEME — and a theme nobody wrote is a theme whose
    ; `lt1` a reader resolves to whatever it likes. It resolved to black, and
    ; a reader opened this deck to black paper with black text on it. The
    ; theme's own default is fixed where it belongs, in `PptxTheme`, and the
    ; deck says its paper out loud as well: one element per slide, and the
    ; colour of the page becomes a fact about the deck rather than about the
    ; reader.
    fn paper:void (c:DeckCheck) {
        print "-- white paper, and the faces the deck asks for --"
        def src:string "# Title

prose
"
        def css:string "page { width: 720pt; height: 405pt; padding: 36pt } document { font-family: Open Sans } heading { font-family: Noto Sans }"
        def back:PptxDeck (this.reopened((this.build(src css))))
        def sl:PptxSlideRef (back.slideAt(0))
        def m:PptxSlide (sl.model())
        c.ok("the slide states its own paper" m.bg.isSet)
        c.eqStr("…and it is white" (MdChar.lower(m.bg.srgb)) "ffffff")

        ; …and even if it did not, the theme under it is not black.
        c.eqStr("the theme's paper is white too" (back.pres.theme.colorOf("lt1")) "FFFFFF")
        c.eqStr("…and its ink is black" (back.pres.theme.colorOf("dk1")) "000000")

        ; The faces the deck names are the ones the layout measured with, in
        ; the theme as well as on the runs — so a reader that has to
        ; substitute them substitutes one pair, not two.
        c.eqStr("the theme's body face" back.pres.theme.minorFont "Open Sans")
        c.eqStr("…and its heading face" back.pres.theme.majorFont "Noto Sans")

        ; …and the reader is told which faces the deck will ask their machine
        ; for, because "missing fonts" on opening a deck is alarming when
        ; nobody said which or why.
        c.ok("the faces are named in the summary" (MdPptxTest.hasSub((maker.result.describe()) "Open Sans")))
        c.ok("…and what a substitution costs is said" (MdPptxTest.noted(maker "reflows inside its boxes")))
    }

    fn run:void () {
        def c:DeckCheck (new DeckCheck())
        print "== MdPptxTest =="
        this.roundTrip(c)
        this.editable(c)
        this.levels(c)
        this.numbering(c)
        this.drawable(c)
        this.columns(c)
        this.twoCompanies(c)
        this.named(c)
        this.cost(c)
        this.paper(c)
        this.pictures(c)
        this.drawingObject(c)
        this.drawingEdit(c)
        print ""
        print (("passed=" + (to_string c.passed)) + (" failed=" + (to_string c.failed)))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }
}

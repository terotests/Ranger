; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MdToPptx.rgr — the deck somebody can open and change the number in.
; ============================================================================
;
; `PLAN_SLIDES.md` §2 is the finding this file exists because of, and it is
; worth restating in one line: `MdToEvg` emits one text command per placed
; SEGMENT, and `PptxFromEvg.emitText` makes one PowerPoint text box per text
; command — so a paragraph that wraps across five lines arrives in PowerPoint
; as five text boxes. None of them reflows, none of them can be edited into a
; sentence, and deleting a word leaves a hole.
;
; That is fine for a book page exported to a slide, which is what `BookToPptx`
; was for: a page is a picture and nobody edits it afterwards. It is the wrong
; answer for a company deck, because the point of a company deck is that
; somebody opens it in PowerPoint and changes the number.
;
; So the road is picked per BLOCK, not per document:
;
;   heading, paragraph, list, table   ──►  native  ──► PowerPoint wraps it
;   code, quote, rule                 ──►  native  ──► …as plain text boxes
;   a diagram, anything drawn         ──►  EVG display list ──► PptxFromEvg
;
; `PptxFromEvg` is not wasted by that: it is exactly what a diagram needs, it
; already exists, and it stops being the main road.
;
; **THE GEOMETRY IS THE LAYOUT'S, THE WRAPPING IS POWERPOINT'S.** Every shape
; is placed at the rectangle `MdLayout` gave that block on that slide, so the
; deck looks like the preview. Inside the rectangle PowerPoint breaks the
; lines itself, so it does NOT match to the point. That is the trade in §2 and
; it has to be accepted rather than engineered away — the alternative is a
; deck nobody can edit. The preview's job is "this is what the slide holds and
; roughly where"; the PDF tab beside it is the one that is exact.
;
; **WHAT DID NOT GO NATIVE IS COUNTED AND NAMED**, per slide, the way
; `book_slides.rgr` prints what did not survive the trip. A converter that
; claims a slide went out whole when it did not is worse than one that cannot
; carry something.
; ============================================================================

Import "MdNode.rgr"
Import "MdLayout.rgr"
Import "MdToEvg.rgr"
Import "MdEmbedKinds.rgr"
Import "MdDeckSync.rgr"
Import "../../math/src/MathOmml.rgr"
Import "../../vfs/src/Vfs.rgr"
Import "../../pptx/api/PptxApi.rgr"
Import "../../pptx/src/PptxFromEvg.rgr"
Import "pkg:evg/EVGDisplayList.rgr"
Import "pkg:evg/EVGLayout.rgr"

; What came out, and what did not come out the way it went in.
class MdDeckResult {
    def slides:int 0
    def titles:int 0
    def paragraphs:int 0
    def bullets:int 0
    def tables:int 0
    ; Blocks that took the display-list road: a diagram, or anything with no
    ; PresentationML spelling. Not an error — but not native either, and the
    ; difference is whether a reader can edit it.
    def drawn:int 0
    ; …and blocks that took neither road. This should be zero and is counted
    ; so that it can be seen not to be.
    def dropped:int 0
    ; Pictures the document names and the deck does not carry. See
    ; `MdToPptx.images` for why there are none, which is a fact about the
    ; markdown LAYOUT and not about this file.
    def images:int 0
    ; …and the ones that ARE in it, as pictures. `images` counts what was
    ; lost; without this there is no number for what was carried, and a deck
    ; of alt text and a deck of pictures both report zero losses.
    def placed:int 0
    ; Slides given the template's background PICTURE. Counted because a deck
    ; whose template named one and whose slides came out plain is the failure
    ; a screenshot of the first slide would not show.
    def backgrounds:int 0
    ; Clips `PptxFromEvg` could not express, inside the drawings. A drawing
    ; that relied on one to hide something comes out showing it.
    def clipped:int 0
    ; The faces the deck NAMES. Not a fault — every deck names fonts — but the
    ; reader's machine may not have them, and "missing fonts" on opening a
    ; deck is alarming when nobody said which or why.
    def faces:[string]
    def notes:[string]

    Constructor () {
    }

    fn note:void (msg:string) {
        push notes msg
    }

    fn face:void (name:string) {
        if ((strlen name) == 0) { return }
        def i:int 0
        while (i < (array_length faces)) {
            if ((itemAt faces i) == name) { return }
            i = (i + 1)
        }
        push faces name
    }

    fn faceList:string () {
        def out:string ""
        def i:int 0
        while (i < (array_length faces)) {
            if (i > 0) { out = (out + " and ") }
            out = (out + (itemAt faces i))
            i = (i + 1)
        }
        return out
    }

    fn noteCount:int () {
        return (array_length notes)
    }

    fn noteAt:string (i:int) {
        return (itemAt notes i)
    }

    fn describe:string () {
        def out:string ((to_string slides) + " slide(s), " + (to_string titles) + " title(s), ")
        out = (out + (to_string paragraphs) + " text box(es), " + (to_string bullets) + " bullet(s), ")
        out = (out + (to_string tables) + " table(s)")
        if (drawn > 0) {
            out = (out + " — " + (to_string drawn) + " block(s) drawn rather than written")
        }
        if (placed > 0) {
            out = (out + ", " + (to_string placed) + " picture(s) placed")
        }
        if (backgrounds > 0) {
            out = (out + ", " + (to_string backgrounds) + " slide(s) with the template's background")
        }
        if (images > 0) {
            out = (out + ", " + (to_string images) + " picture(s) named but not carried")
        }
        if (clipped > 0) {
            out = (out + ", " + (to_string clipped) + " clip(s) ignored")
        }
        if ((array_length faces) > 0) {
            out = (out + " — in " + (this.faceList()))
        }
        if (dropped > 0) {
            out = (out + ", " + (to_string dropped) + " dropped")
        }
        return out
    }
}

; Where each of a block's own children ended up, one entry per child.
;
; Needed because "which boxes belong to this item" cannot be answered by the
; source span alone: a list's BULLET carries the LIST's offset, and a list
; starts where its first item does — so asking the spans puts every marker in
; the first item and the first item then spans the whole list. `MdLayout`'s
; own column flow hit this and answered it the same way: the boxes are
; emitted in order, so a box may never belong to an earlier child than the
; box before it.
class MdItemRects {
    def left:[double]
    def top:[double]
    def right:[double]
    def bottom:[double]

    Constructor () {
    }

    fn count:int () {
        return (array_length left)
    }

    fn has:boolean (i:int) {
        return ((itemAt left i) >= 0.0)
    }
}

class MdToPptx {
    def layout:MdLayout (new MdLayout())
    def result:MdDeckResult (new MdDeckResult())
    def images:int 0
    ; Where a picture's bytes come from. The SAME store the layout was given,
    ; handed over by `setImages`, so the deck and the preview cannot be
    ; missing different pictures.
    def imageStore:Vfs (new Vfs())
    def haveImages:boolean false
    ; The rules a theme draws with a block (under a heading, beside a quote)
    ; as shapes of their own. Off by default: a deck of editable text boxes
    ; reads one box per block, and a host that wants the slide as it was
    ; drawn turns this on.
    def rules:boolean false

    Constructor () {
    }

    ; The deck. `layout` must already have been through `layoutSlides`, which
    ; is what decided where the slides break and where every block sits on
    ; one; this file reads that decision rather than making it again.
    fn deck:PptxDeck (doc:MdNode l:MdLayout) {
        layout = l
        result = (new MdDeckResult())
        ; The layout was given a byte store, so this has one: two stores would
        ; be two answers to where a picture is, and the reader would find the
        ; deck missing a picture the preview had.
        if l.haveImages {
            imageStore = l.images
            haveImages = true
        }
        ; `PptxApi.create` and not `PptxDeck.create`: the facade is the
        ; published entry point and the one the API test drives.
        def d:PptxDeck (PptxApi.create())
        d.setSize(l.style.pageWidth l.style.pageHeight)
        ; The faces the deck NAMES, so a reader that has to substitute them
        ; substitutes one pair rather than one pair plus whatever the theme
        ; happened to say. `MdStyle` has the answer because the layout
        ; measured with it.
        d.pres.theme.majorFont = l.style.headingFamily
        d.pres.theme.minorFont = l.style.bodyFamily
        def slides:int l.pageCount
        if (slides < 1) { slides = 1 }
        def s:int 0
        while (s < slides) {
            def ref:PptxSlideRef (d.addSlide())
            ; The paper, stated on the slide.
            ;
            ; A slide with no background of its own falls back to the master,
            ; which falls back to the THEME — and a theme nobody wrote is a
            ; theme whose `lt1` a reader may resolve to anything. Saying it
            ; here costs one element per slide and makes the deck's paper a
            ; fact about the deck rather than about the reader. A markdown
            ; page is white unless the template says otherwise — which it now
            ; can, and this reads it.
            def paper:string "#ffffff"
            if ((strlen l.style.pageBackground) > 0) {
                paper = l.style.pageBackground
            }
            ref.background(paper)
            ; …and a PICTURE behind it, which is what a company template is
            ; mostly made of. Bytes rather than a name: the deck is a package
            ; and a picture in it is a part, and the store the layout read is
            ; the store this reads, so the slide and the preview cannot have
            ; different backgrounds.
            this.slidePaper(ref l)
            s = (s + 1)
        }
        result.slides = slides

        def i:int 0
        def n:int (doc.childCount())
        while (i < n) {
            def child:MdNode (doc.childAt(i))
            this.block(d child)
            i = (i + 1)
        }
        this.furniture(d)
        this.pictures(doc)
        this.fonts(l)
        return d
    }

    ; The faces the deck asks for, said once.
    ;
    ; A deck names fonts by NAME and carries none of them; a reader that does
    ; not have one substitutes it, and PowerPoint and Keynote both say so on
    ; opening. That is not a fault and it is not nothing: the geometry here
    ; was measured with these faces, so a substitute reflows the text inside
    ; the boxes — which is the same trade §2 already makes for the wrapping,
    ; arriving by another door.
    ;
    ; Carrying them instead means `p:embeddedFontLst` and an `fntdata` part
    ; per face, which this writer does not do yet. Named rather than left for
    ; a reader to discover in a dialog.
    fn fonts:void (l:MdLayout) {
        result.face(l.style.bodyFamily)
        result.face(l.style.headingFamily)
        result.face(l.style.monoFamily)
        result.note((("the deck asks for " + (result.faceList())) + " and carries neither: a reader without them substitutes, and the text reflows inside its boxes"))
    }

    ; ----------------------------------------------------------------------
    ; …and what the export costs
    ; ----------------------------------------------------------------------
    ;
    ; **Pictures do not go, and the reason is upstream of here.** A markdown
    ; layout has no bytes for an image: `MdLayout` draws `![alt](src)` as its
    ; ALT TEXT in the muted colour, because that is the most honest thing to
    ; draw when nobody has read the file. So the deck carries the alt text
    ; too — nothing is lost between the preview and the deck, and both are
    ; missing the same picture.
    ;
    ; Fixing it is a byte registry, the way `EVGPDFRenderer.registerImage`
    ; already works, and it belongs where the layout is rather than here —
    ; `gallery/PLAN_EDITOR_KERNEL.md` Stage B0 lists it, and a Vela chart and
    ; a data grid want the same thing. `PptxFromEvg` has the other half
    ; already: it COUNTS a picture it cannot place rather than inventing an
    ; empty frame.
    ;
    ; Counted and named here so that a caller cannot mistake a deck of alt
    ; text for a deck of pictures.
    ; The header and the footer — page furniture, which no block of the
    ; document owns, so the walk over the blocks never met them — as the
    ; layout drew them on each slide: their text, their band and their logo.
    fn furniture:void (d:PptxDeck) {
        def i:int 0
        while (i < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes i)
            if ((b.furniture > 0) && ((b.page >= 0) && (b.page < (d.slideCount())))) {
                def slide:PptxSlideRef (d.slideAt(b.page))
                if ((b.kind == 0) && ((strlen (trim b.text)) > 0)) {
                    def box:PptxShapeRef (slide.addTextBox(b.x b.y (b.w + 2.0) b.h b.text))
                    MdToPptx.tight(box)
                    def m:PptxShape (box.model())
                    m.name = (? (b.furniture == 1) "Header" "Footer")
                    def r:PptxRunRef (box.runAt(0 0))
                    r.font(b.family b.size)
                    r.bold(b.bold)
                    r.color(b.color)
                }
                if ((b.kind == 1) && ((strlen b.fill) > 0)) {
                    def band:PptxShapeRef (slide.addShape("rect" b.x b.y b.w b.h))
                    band.fill(b.fill)
                    band.noLine()
                }
                if ((b.kind == 4) && haveImages) {
                    def bytes:buffer (imageStore.read(b.imagePath))
                    if ((buffer_length bytes) > 0) {
                        def pic:PptxShapeRef (slide.addShape("rect" b.x b.y b.w b.h))
                        def sh:PptxShape (pic.model())
                        sh.kind = (PptxShapeKind.picture())
                        sh.imageBytes = bytes
                        sh.imagePart = b.imagePath
                        sh.imageOk = true
                        sh.altText = b.imageAlt
                        sh.name = "Logo"
                    }
                }
            }
            i = (i + 1)
        }
    }

    fn pictures:void (doc:MdNode) {
        def n:int (MdToPptx.countImages(doc))
        if (n == 0) { return }
        images = n
        if (! haveImages) {
            result.images = n
            result.note(((to_string n) + " picture(s) are in the deck as their alt text: nobody handed this a byte store, so neither the preview nor this has one"))
            return
        }
        ; With a store, the ones that went missing are the LAYOUT's count: a
        ; picture the layout could not find never became a box, so this file
        ; never sees it — and a deck that silently had fewer pictures than the
        ; document names is the thing this whole accounting exists to prevent.
        def lost:int layout.missingImages
        if (lost > 0) {
            result.images = (result.images + lost)
            result.note(((to_string lost) + " picture(s) are in the deck as their alt text: the store does not have them, so neither the preview nor this does"))
        }
    }

    ; One picture the store did not have. Counted here rather than at the top,
    ; because with a store the question is asked per picture: a deck can carry
    ; one and miss another, and a single number at the start cannot say that.
    fn missedPicture:void (node:MdNode name:string) {
        result.images = (result.images + 1)
        result.note((("slide " + (to_string ((this.pageOf(node)) + 1))) + ": a picture named ") + name + " is not in the store, so the deck has its alt text")
    }

    sfn countImages:int (node:MdNode) {
        def c:int 0
        if (node.kind == "image") { c = 1 }
        def i:int 0
        while (i < (node.childCount())) {
            def k:MdNode (node.childAt(i))
            c = (c + (MdToPptx.countImages(k)))
            i = (i + 1)
        }
        return c
    }

    ; The template's background picture, onto one slide.
    fn slidePaper:void (ref:PptxSlideRef l:MdLayout) {
        if (! haveImages) { return }
        def name:string l.style.pageBackgroundImage
        if ((strlen name) == 0) { return }
        def path:string (imageStore.resolve(name l.docDir))
        if ((strlen path) == 0) { return }
        def bytes:buffer (imageStore.read(path))
        if ((buffer_length bytes) == 0) { return }
        def model:PptxSlide (ref.model())
        model.bgImageName = path
        model.bgImage = bytes
        result.backgrounds = (result.backgrounds + 1)
    }

    ; A picture, when the layout drew one for this block.
    ;
    ; The bytes come from the same store the layout asked, so the deck and the
    ; preview cannot be missing different pictures. Alt text goes on the shape
    ; because a picture is the one place where the pixels tell a screen reader
    ; nothing.
    fn picture:boolean (slide:PptxSlideRef node:MdNode x:double y:double w:double h:double) {
        if (! haveImages) { return false }
        def box:MdBox (this.pictureBoxOf(node))
        if (box.kind != 4) { return false }
        def bytes:buffer (imageStore.read(box.imagePath))
        if ((buffer_length bytes) == 0) {
            this.missedPicture(node box.imagePath)
            return false
        }
        def pic:PptxShapeRef (slide.addShape("rect" x y box.w box.h))
        def sh:PptxShape (pic.model())
        sh.kind = (PptxShapeKind.picture())
        sh.imageBytes = bytes
        sh.imagePart = box.imagePath
        sh.imageOk = true
        sh.altText = box.imageAlt
        sh.name = ("Picture " + (to_string (result.placed + 1)))
        result.placed = (result.placed + 1)
        return true
    }

    ; The layout's own picture box for a block, or an empty one.
    fn pictureBoxOf:MdBox (node:MdNode) {
        def i:int 0
        while (i < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes i)
            if (b.kind == 4) {
                if (b.srcStart == node.srcStart) { return b }
            }
            i = (i + 1)
        }
        return (new MdBox())
    }

    ; ----------------------------------------------------------------------
    ; One block, on the slide the layout put it on
    ; ----------------------------------------------------------------------
    fn block:void (d:PptxDeck node:MdNode) {
        if (node.kind == "front_matter") { return }
        def page:int (this.pageOf(node))
        if (page < 0) {
            ; No boxes at all: the layout drew nothing for it, so there is
            ; nothing to place and nothing was lost.
            return
        }
        if (page >= (d.slideCount())) { return }
        def slide:PptxSlideRef (d.slideAt(page))
        def x:double (this.leftOf(node page))
        def y:double (this.topOf(node page))
        def w:double (this.widthOf(node page))
        def h:double (this.heightOf(node page))
        if (w <= 1.0) { w = (layout.style.pageWidth - (layout.style.margin * 2.0)) }
        if (h <= 1.0) { h = (layout.style.bodySize * layout.style.lineHeight) }

        def kind:string node.kind
        ; The boxes for a heading are the glyphs, each as wide as that run.
        ; A text box that size is already full: the first millimetre
        ; PowerPoint measures wider — default insets, a bolder face — wraps
        ; the last word onto the table under it. `### A tabledd` became
        ; "A" / "tabledd" over the grid. H1 and H2 escaped because they
        ; draw a rule the width of the COLUMN; H3 has no rule. The
        ; rectangle the layout gave the block is that column, and wrapping
        ; belongs inside it.
        w = (this.stretchFlow(kind x w))
        if (kind == "heading") {
            this.heading(slide node x y w h)
            return
        }
        if (kind == "paragraph") {
            ; A paragraph the layout turned into a PICTURE is a picture here
            ; too, and the check is the layout's own box rather than a second
            ; reading of the tree: two answers to "is this a picture" is two
            ; answers, and the one that matters is the one the reader sees.
            if (this.picture(slide node x y w h)) { return }
            this.paragraph(slide node x y w h)
            return
        }
        if (kind == "list") {
            this.list(slide node x y w h)
            return
        }
        if (kind == "table") {
            this.table(slide node x y w h)
            return
        }
        if (kind == "block_quote") {
            this.quote(slide node x y w h)
            return
        }
        if (kind == "code_block") {
            this.code(slide node x y w h)
            return
        }
        if (kind == "html_block") {
            ; drawn as the layout drew it: a table with spans, an aligned
            ; block, highlighted text — or, for markup it does not read, the
            ; markup itself
            this.boxesDrawn(slide node "HTML")
            return
        }
        if (kind == "thematic_break") {
            def line:PptxShapeRef (slide.addShape("rect" x y w 1.0))
            line.fill(layout.style.ruleColor)
            line.noLine()
            return
        }
        if (kind == "embed") {
            this.drawn(slide node x y w h)
            return
        }
        if (kind == "math_block") {
            this.formula(slide node)
            return
        }
        result.dropped = (result.dropped + 1)
        result.note((("slide " + (to_string (this.pageOf(node)) + 1)) + ": a ") + kind + " has no spelling here and was left out")
    }

    ; A text body's own padding, off.
    ;
    ; PowerPoint insets a text box by 7.2pt left and right out of the box,
    ; and the rectangle this shape was given is the one `MdLayout` already
    ; placed the text in — padding and all. Leaving both on makes every box
    ; 14pt narrower than the layout measured, which wraps one word more per
    ; line than the preview did; on a list in three columns that is one extra
    ; line per column, and the block under it is drawn over them.
    sfn tight:void (box:PptxShapeRef) {
        def m:PptxShape (box.model())
        m.text.insetL = 0.0
        m.text.insetR = 0.0
        m.text.insetT = 0.0
        m.text.insetB = 0.0
        m.text.insetsSet = true
    }

    ; A flowing block's box reaches the right of the column, not the right
    ; of its last glyph. Tables and drawings keep the size they were
    ; measured at — stretching those would be a different picture.
    fn stretchFlow:double (kind:string x:double w:double) {
        if (! (this.flows(kind))) {
            return w
        }
        def room:double ((layout.contentX + layout.contentW) - x)
        if (room > w) {
            return room
        }
        return w
    }

    fn flows:boolean (kind:string) {
        if (kind == "heading") { return true }
        if (kind == "paragraph") { return true }
        if (kind == "block_quote") { return true }
        if (kind == "list") { return true }
        if (kind == "code_block") { return true }
        if (kind == "html_block") { return true }
        return false
    }

    ; A heading at or above the deck's split level is the slide's TITLE — the
    ; placeholder, so a PowerPoint layout styles it and an outline view shows
    ; it. A deeper one is a text box, because a slide has one title.
    fn heading:void (slide:PptxSlideRef node:MdNode x:double y:double w:double h:double) {
        def text:string (MdToPptx.flatText(node))
        def box:PptxShapeRef (slide.addTextBox(x y w h text))
        MdToPptx.tight(box)
        def size:double (layout.style.headingSize(node.level))
        def r:PptxRunRef (box.runAt(0 0))
        r.font(layout.style.headingFamily size)
        r.bold(true)
        r.color((layout.style.headingInk(node.level)))
        MdToPptx.asDrawn((r.model()) (this.runBoxOf(node (this.pageOf(node)))))
        this.blockRules(slide node)
        def m:PptxShape (box.model())
        MdDeckSync.stamp(m node)
        if (node.level <= layout.splitLevel) {
            ; `isPlaceholder` as well as the type: the writer emits a bare
            ; `<p:nvPr/>` without it, and a title that is not a placeholder is
            ; an ordinary text box — out of the outline view, not inheriting
            ; from the layout, and not a title to anything that reads the deck.
            m.isPlaceholder = true
            m.phType = "title"
            m.phIdx = -1
            m.name = "Title"
            result.titles = (result.titles + 1)
        } {
            result.paragraphs = (result.paragraphs + 1)
        }
    }

    ; The rule a theme draws under a heading or beside a quote (a border),
    ; where the layout drew it: a filled box of the block's own.
    fn blockRules:void (slide:PptxSlideRef node:MdNode) {
        if (! rules) { return }
        def page:int (this.pageOf(node))
        def i:int 0
        while (i < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes i)
            if (((b.page == page) && (b.kind == 1)) && ((strlen b.fill) > 0)) {
                if (MdToPptx.inSpan(node b.srcStart)) {
                    def line:PptxShapeRef (slide.addShape("rect" b.x b.y b.w b.h))
                    line.fill(b.fill)
                    line.noLine()
                }
            }
            i = (i + 1)
        }
    }

    fn paragraph:void (slide:PptxSlideRef node:MdNode x:double y:double w:double h:double) {
        def text:string (MdToPptx.flatText(node))
        if ((strlen (trim text)) == 0) { return }
        def box:PptxShapeRef (slide.addTextBox(x y w h text))
        MdToPptx.tight(box)
        def r:PptxRunRef (box.runAt(0 0))
        r.font(layout.style.bodyFamily layout.style.bodySize)
        r.color(layout.style.textColor)
        def drawn:MdBox (this.runBoxOf(node (this.pageOf(node))))
        MdToPptx.asDrawn((r.model()) drawn)
        MdToPptx.lineSpacing((box.model()) drawn)
        this.withRuns((box.model()) node)
        result.paragraphs = (result.paragraphs + 1)
    }

    fn quote:void (slide:PptxSlideRef node:MdNode x:double y:double w:double h:double) {
        def text:string (trim (MdToPptx.flatText(node)))
        ; the bar the theme draws at its side, and the text where the layout
        ; set it, in from the bar
        this.blockRules(slide node)
        def drawn:MdBox (this.runBoxOf(node (this.pageOf(node))))
        def tx:double x
        def tw:double w
        if ((drawn.kind >= 0) && (drawn.x > x)) {
            tx = drawn.x
            tw = (w - (drawn.x - x))
        }
        def box:PptxShapeRef (slide.addTextBox(tx y tw h text))
        MdToPptx.tight(box)
        def r:PptxRunRef (box.runAt(0 0))
        r.font(layout.style.bodyFamily layout.style.bodySize)
        r.italic(true)
        r.color(layout.style.quoteColor)
        if (drawn.kind >= 0) {
            r.italic(drawn.italic)
        }
        MdToPptx.asDrawn((r.model()) drawn)
        MdToPptx.lineSpacing((box.model()) drawn)
        this.withRuns((box.model()) node)
        result.paragraphs = (result.paragraphs + 1)
    }

    ; A listing keeps its line breaks, which is the whole reason it is a
    ; listing. One paragraph per line, no bullet, in the mono family.
    fn code:void (slide:PptxSlideRef node:MdNode x:double y:double w:double h:double) {
        def box:PptxShapeRef (slide.addTextBox(x y w h ""))
        MdToPptx.tight(box)
        def m:PptxShape (box.model())
        clear m.text.paragraphs
        def lines:[string] (strsplit node.literal "\n")
        def i:int 0
        def n:int (array_length lines)
        ; A fence ends with a newline, so the last piece is empty and is not a
        ; line of the program.
        if (n > 1) {
            if ((strlen (itemAt lines (n - 1))) == 0) { n = (n - 1) }
        }
        ; The tokens as the layout coloured them, in reading order: the
        ; theme's colours for a dark slide, which the style's are not.
        def page:int (this.pageOf(node))
        def tokens:[MdBox]
        def k:int 0
        while (k < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes k)
            if (((b.page == page) && (b.kind == 0)) && ((MdToPptx.inSpan(node b.srcStart)) && ((strlen b.text) > 0))) {
                push tokens b
            }
            k = (k + 1)
        }
        def next:int 0
        def plain:string layout.style.codePlain
        def size:double layout.style.codeSize
        def family:string layout.style.monoFamily
        if ((array_length tokens) > 0) {
            def t0:MdBox (itemAt tokens 0)
            size = t0.size
            family = t0.family
            ; the listing's padding inside its band
            if ((t0.x > x) && (t0.y > y)) {
                m.text.insetL = (t0.x - x)
                m.text.insetT = (t0.y - y)
            }
        }
        while (i < n) {
            def p (new PptxParagraph)
            def line:string (itemAt lines i)
            def at:int 0
            ; each token of this line where it is in the line, the text
            ; between them (spaces) in the colour before it
            def going:boolean true
            while (going && (next < (array_length tokens))) {
                def t:MdBox (itemAt tokens next)
                def rest:string (substring line at (strlen line))
                def f:int (indexOf rest t.text)
                if (f < 0) {
                    going = false
                } {
                    if (f > 0) {
                        push p.runs (MdToPptx.codeRun((substring rest 0 f) plain size family))
                    }
                    push p.runs (MdToPptx.codeRun(t.text t.color size family))
                    plain = t.color
                    at = ((at + f) + (strlen t.text))
                    next = (next + 1)
                }
            }
            if (at < (strlen line)) {
                push p.runs (MdToPptx.codeRun((substring line at (strlen line)) plain size family))
            }
            if ((array_length p.runs) == 0) {
                push p.runs (MdToPptx.codeRun("" plain size family))
            }
            push m.text.paragraphs p
            i = (i + 1)
        }
        def band:string layout.style.codeBackground
        def bi:int 0
        while (bi < (array_length layout.boxes)) {
            def bb:MdBox (itemAt layout.boxes bi)
            if ((((bb.page == page) && (bb.kind == 1)) && ((strlen bb.fill) > 0)) && (bb.srcStart == node.srcStart)) {
                band = bb.fill
            }
            bi = (bi + 1)
        }
        def fill:PptxShapeRef (box.fill(band))
        result.paragraphs = (result.paragraphs + 1)
    }

    sfn codeRun:PptxTextRun (text:string color:string size:double family:string) {
        def r (new PptxTextRun)
        r.text = text
        r.fontFamily = family
        r.fontSizePt = size
        r.sizeSet = true
        r.color = (PptxApi.colorOf(color))
        return r
    }

    ; ----------------------------------------------------------------------
    ; A list, as a text body PowerPoint can reflow
    ; ----------------------------------------------------------------------
    ;
    ; One shape for the whole list and one PARAGRAPH per item, with `level`
    ; for the nesting and a bullet character per level. A shape per item would
    ; place them exactly and would not be a list: pressing return at the end
    ; of one would not make another.
    fn list:void (slide:PptxSlideRef node:MdNode x:double y:double w:double h:double) {
        def page:int (this.pageOf(node))
        def rects:MdItemRects (this.itemRects(node page))
        def lefts:[double] (this.columnLefts(rects))
        if ((array_length lefts) > 1) {
            this.listColumns(slide node page rects lefts)
            return
        }
        def box:PptxShapeRef (slide.addTextBox(x y w h ""))
        MdToPptx.tight(box)
        def m:PptxShape (box.model())
        clear m.text.paragraphs
        this.items(m node 0 (0.0 - 1.0) rects)
    }

    fn listColumns:void (slide:PptxSlideRef node:MdNode page:int rects:MdItemRects lefts:[double]) {
        def cols:int (array_length lefts)
        def c:int 0
        while (c < cols) {
            def left:double (itemAt lefts c)
            def top:double (0.0 - 1.0)
            def right:double left
            def bottom:double 0.0
            def i:int 0
            while (i < (rects.count())) {
                if (MdToPptx.sameColumn(rects i left)) {
                    def t:double (itemAt rects.top i)
                    if ((top < 0.0) || (t < top)) { top = t }
                    def r:double (itemAt rects.right i)
                    if (r > right) { right = r }
                    def b:double (itemAt rects.bottom i)
                    if (b > bottom) { bottom = b }
                }
                i = (i + 1)
            }
            if (top < 0.0) { top = layout.style.margin }
            def box:PptxShapeRef (slide.addTextBox(left top (right - left) (bottom - top) ""))
            MdToPptx.tight(box)
            def m:PptxShape (box.model())
            clear m.text.paragraphs
            this.items(m node 0 left rects)
            c = (c + 1)
        }
        result.note((("slide " + (to_string (page + 1))) + ": a list in ") + (to_string cols) + " columns is " + (to_string cols) + " text boxes — a bullet added to one does not flow into the next")
    }

    sfn sameColumn:boolean (rects:MdItemRects i:int left:double) {
        if (! (rects.has(i))) { return false }
        if (left < 0.0) { return true }
        return ((fabs ((itemAt rects.left i) - left)) < 1.0)
    }

    ; The rectangle each direct child of `node` was drawn in, on `page`.
    fn itemRects:MdItemRects (node:MdNode page:int) {
        def out (new MdItemRects())
        def kids:int (node.childCount())
        def k:int 0
        while (k < kids) {
            push out.left (0.0 - 1.0)
            push out.top (0.0 - 1.0)
            push out.right (0.0 - 1.0)
            push out.bottom (0.0 - 1.0)
            k = (k + 1)
        }
        def last:int 0
        def i:int 0
        while (i < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes i)
            ; Only this block's own boxes. Without the span test the
            ; monotonic rule below sweeps up everything drawn BEFORE the
            ; block as well — the heading above a list came out as part of
            ; its first item, and the first column's box then covered the
            ; whole slide.
            def ours:boolean (MdToPptx.inSpan(node b.srcStart))
            if ((b.page == page) && ours) {
                def g:int (MdToPptx.childOf(node kids b.srcStart))
                if (g < last) { g = last }
                if ((g >= 0) && (g < kids)) {
                    last = g
                    if ((itemAt out.left g) < 0.0) {
                        set_at out.left g b.x
                        set_at out.top g b.y
                        set_at out.right g (b.x + b.w)
                        set_at out.bottom g (b.y + b.h)
                    } {
                        if (b.x < (itemAt out.left g)) { set_at out.left g b.x }
                        if (b.y < (itemAt out.top g)) { set_at out.top g b.y }
                        if ((b.x + b.w) > (itemAt out.right g)) { set_at out.right g (b.x + b.w) }
                        if ((b.y + b.h) > (itemAt out.bottom g)) { set_at out.bottom g (b.y + b.h) }
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    sfn childOf:int (node:MdNode kids:int off:int) {
        if (off < 0) { return -1 }
        def i:int 0
        while (i < kids) {
            def k:MdNode (node.childAt(i))
            if (k.srcStart >= 0) {
                if ((k.srcStart <= off) && (off < k.srcEnd)) { return i }
            }
            i = (i + 1)
        }
        return -1
    }

    ; The distinct left edges of this list's own items, in order. One means
    ; one column, which is every list nobody styled.
    fn columnLefts:[double] (rects:MdItemRects) {
        def out:[double]
        def i:int 0
        while (i < (rects.count())) {
            if (rects.has(i)) {
                def left:double (itemAt rects.left i)
                def seen:boolean false
                def k:int 0
                while (k < (array_length out)) {
                    if ((fabs ((itemAt out k) - left)) < 1.0) { seen = true }
                    k = (k + 1)
                }
                if (! seen) { push out left }
            }
            i = (i + 1)
        }
        ; In reading order, which for columns is left to right.
        def n:int (array_length out)
        def a:int 0
        while (a < n) {
            def b:int (a + 1)
            while (b < n) {
                if ((itemAt out b) < (itemAt out a)) {
                    def t:double (itemAt out a)
                    set_at out a (itemAt out b)
                    set_at out b t
                }
                b = (b + 1)
            }
            a = (a + 1)
        }
        return out
    }

    ; `onlyLeft` below zero means every item; otherwise only the ones the
    ; layout put in that column.
    fn items:void (m:PptxShape node:MdNode level:int onlyLeft:double rects:MdItemRects) {
        def ordered:boolean node.listOrdered
        def number:int node.listStart
        def page:int (this.pageOf(node))
        ; where the item before this one ended, for the gap the layout left
        def prevBottom:double (0.0 - 1.0)
        def i:int 0
        def n:int (node.childCount())
        while (i < n) {
            def item:MdNode (node.childAt(i))
            def mine:boolean true
            if (level == 0) {
                mine = (MdToPptx.sameColumn(rects i onlyLeft))
            }
            def text:string ""
            if mine { text = (trim (MdToPptx.itemText(item))) }
            if ((strlen text) > 0) {
                def p (new PptxParagraph)
                p.level = level
                p.hasBullet = true
                p.bulletSet = true
                ; The indent, stated rather than left to the reader.
                ;
                ; A reader that is told neither invents a level's worth and
                ; then adds twelve points more for the bullet — and the
                ; rectangle this shape was given is one `MdLayout` measured
                ; with the bullet OUTSIDE the text column. Nineteen points of
                ; text width vanish, a bullet in a three-column list wraps to
                ; a second line, and the block under it is drawn over them.
                ;
                ; `marL` is where the text starts and `indent` is the bullet's
                ; offset from it, negative for the hanging bullet every list
                ; has. One level in is one step, which is what the nesting is.
                def step:double 14.0
                p.marginLeftPt = (((to_double level) + 1.0) * step)
                p.marginSet = true
                p.indentPt = (0.0 - step)
                p.indentSet = true
                if ordered {
                    p.bulletAutoNum = true
                    p.bulletScheme = "arabicPeriod"
                    p.bulletStartAt = node.listStart
                } {
                    p.bulletChar = (MdToPptx.bulletFor(level))
                }
                ; a task's box, checked or not, as the layout drew it
                if (item.taskState >= 0) {
                    p.bulletAutoNum = false
                    p.bulletChar = (? (item.taskState == 1) "☑" "☐")
                }
                def r (new PptxTextRun)
                r.text = text
                r.fontFamily = layout.style.bodyFamily
                r.fontSizePt = layout.style.bodySize
                r.sizeSet = true
                r.color = (PptxApi.colorOf(layout.style.textColor))
                ; The size, face and colour the layout drew the item in, which
                ; a theme can make other than the body's, and the gap it left
                ; above the item, so the list takes the room it took on the
                ; slide instead of closing up under its first line.
                def drawn:MdBox (this.runBoxOf(item page))
                MdToPptx.asDrawn(r drawn)
                if (drawn.kind >= 0) {
                    MdToPptx.lineSpacingOf(p drawn)
                    def mark:MdBox (this.markerBoxOf(node page drawn))
                    if (mark.kind >= 0) {
                        p.bulletColor = (PptxApi.colorOf(mark.color))
                        if (mark.size > 0.0) {
                            p.bulletSizePt = mark.size
                        }
                        ; the text starts where the layout started it
                        def gapX:double (drawn.x - mark.x)
                        if (gapX > 1.0) {
                            p.marginLeftPt = ((to_double level) * step) + gapX
                            p.indentPt = (0.0 - gapX)
                        }
                    }
                    if (rects.has(i)) {
                        def top:double (itemAt rects.top i)
                        if ((prevBottom >= 0.0) && (top > prevBottom)) {
                            p.spaceBeforePt = (top - prevBottom)
                        }
                        prevBottom = (itemAt rects.bottom i)
                    }
                }
                push p.runs r
                if (MdToPptx.hasInline(item)) {
                    p.runs = (this.mathRuns(item r))
                }
                push m.text.paragraphs p
                result.bullets = (result.bullets + 1)
            }
            ; A list inside an item is the next level down, and PowerPoint
            ; spells that as a level rather than as a second shape.
            def k:int 0
            while (k < (item.childCount())) {
                def sub:MdNode (item.childAt(k))
                if (sub.kind == "list") {
                    if mine {
                        this.items(m sub (level + 1) (0.0 - 1.0) rects)
                    }
                }
                k = (k + 1)
            }
            if ordered { number = (number + 1) }
            i = (i + 1)
        }
    }

    ; The item's own text, without any list nested under it — that goes in as
    ; its own paragraphs at the next level.
    sfn itemText:string (item:MdNode) {
        def out:string ""
        def i:int 0
        while (i < (item.childCount())) {
            def c:MdNode (item.childAt(i))
            if (c.kind != "list") {
                def part:string (MdToPptx.flatText(c))
                if ((strlen out) > 0) { out = (out + " ") }
                out = (out + part)
            }
            i = (i + 1)
        }
        return out
    }

    ; ----------------------------------------------------------------------
    ; TeX in a line
    ; ----------------------------------------------------------------------
    ;
    ; A `$…$` in a paragraph is an equation PowerPoint can edit: a run of its
    ; own holding Office Math, between the runs of text around it. The text
    ; a run shows where there are no equations (a table cell, a title, a
    ; reader with no Office Math) is the formula as one line of Unicode, never
    ; its TeX source.

    ; The text of a block with each formula as Unicode.
    sfn flatText:string (node:MdNode) {
        if (node.kind == "math") {
            return (MathOmml.linear(node.literal))
        }
        if (node.kind == "math_block") {
            return (MathOmml.linear(node.literal))
        }
        if ((array_length node.children) == 0) {
            return (node.plainText())
        }
        def out:string ""
        def i:int 0
        while (i < (node.childCount())) {
            out = (out + (MdToPptx.flatText((node.childAt(i)))))
            i = (i + 1)
        }
        return out
    }

    sfn hasMath:boolean (node:MdNode) {
        if (node.kind == "math") {
            return true
        }
        def i:int 0
        while (i < (node.childCount())) {
            def c:MdNode (node.childAt(i))
            if (c.kind != "list") {
                if (MdToPptx.hasMath(c)) {
                    return true
                }
            }
            i = (i + 1)
        }
        return false
    }

    ; A text box of one paragraph, its one run split where the formulas are.
    ; …and the same road for any text with a span of its own in it: bold,
    ; italic, a link, inline code. Written as one run, the paragraph lost
    ; them — "Revenue grew **7 %**" came out with the 7 % plain.
    sfn hasInline:boolean (node:MdNode) {
        def k:string node.kind
        if ((((k == "math") || (k == "strong")) || ((k == "emph") || (k == "code"))) || (k == "link")) {
            return true
        }
        def i:int 0
        while (i < (node.childCount())) {
            def c:MdNode (node.childAt(i))
            if (c.kind != "list") {
                if (MdToPptx.hasInline(c)) { return true }
            }
            i = (i + 1)
        }
        return false
    }

    fn withRuns:void (m:PptxShape node:MdNode) {
        if ((MdToPptx.hasInline(node)) == false) {
            return
        }
        if ((array_length m.text.paragraphs) == 0) {
            return
        }
        def para:PptxParagraph (itemAt m.text.paragraphs 0)
        if ((array_length para.runs) == 0) {
            return
        }
        def tmpl:PptxTextRun (itemAt para.runs 0)
        para.runs = (this.mathRuns(node tmpl))
    }

    ; The runs of `node`'s text in the style of `tmpl`: text, an equation,
    ; text… A list nested in an item is not its text.
    fn mathRuns:[PptxTextRun] (node:MdNode tmpl:PptxTextRun) {
        def out:[PptxTextRun]
        this.collectRuns(node tmpl out)
        ; the text around a formula is trimmed at the ends of the paragraph
        ; only, as the one run it replaces was
        def n:int (array_length out)
        if (n > 0) {
            def first:PptxTextRun (itemAt out 0)
            if ((strlen first.math) == 0) {
                first.text = (MdToPptx.trimLeft(first.text))
            }
            def last:PptxTextRun (itemAt out (n - 1))
            if ((strlen last.math) == 0) {
                last.text = (MdToPptx.trimRight(last.text))
            }
        }
        return out
    }

    fn collectRuns:void (node:MdNode tmpl:PptxTextRun out:[PptxTextRun]) {
        ; a span: its children in the span's style
        if (((node.kind == "strong") || (node.kind == "emph")) || (node.kind == "link")) {
            def st (new PptxTextRun)
            tmpl.copyStyleTo(st)
            st.color = tmpl.color
            if (node.kind == "strong") {
                st.bold = true
                st.boldSet = true
            }
            if (node.kind == "emph") {
                st.italic = true
                st.italicSet = true
            }
            if (node.kind == "link") {
                st.color = (PptxApi.colorOf(layout.style.linkColor))
            }
            def si:int 0
            while (si < (node.childCount())) {
                this.collectRuns((node.childAt(si)) st out)
                si = (si + 1)
            }
            return
        }
        ; inline code: the face and the band the layout drew it with
        if (node.kind == "code") {
            def cr (new PptxTextRun)
            tmpl.copyStyleTo(cr)
            cr.color = tmpl.color
            cr.text = node.literal
            cr.fontFamily = layout.style.monoFamily
            cr.fontSizePt = (tmpl.fontSizePt * 0.92)
            cr.sizeSet = true
            cr.bold = false
            cr.italic = false
            def band:string layout.style.codeBackground
            def cb:MdBox (this.boxAt(node.srcStart))
            if (cb.kind >= 0) {
                if ((strlen cb.fill) > 0) { band = cb.fill }
                if ((strlen cb.color) > 0) { cr.color = (PptxApi.colorOf(cb.color)) }
            }
            if ((strlen band) > 0) {
                cr.highlight = (PptxApi.colorOf(band))
            }
            push out cr
            return
        }
        if (node.kind == "math") {
            def r (new PptxTextRun)
            tmpl.copyStyleTo(r)
            r.color = tmpl.color
            r.text = (MathOmml.linear(node.literal))
            r.math = (MathOmml.omml(node.literal))
            push out r
            return
        }
        if ((array_length node.children) == 0) {
            def t:string (node.plainText())
            if ((strlen t) == 0) {
                return
            }
            def n:int (array_length out)
            if (n > 0) {
                def last:PptxTextRun (itemAt out (n - 1))
                if (((strlen last.math) == 0) && (MdToPptx.sameStyle(last tmpl))) {
                    last.text = (last.text + t)
                    return
                }
            }
            def r2 (new PptxTextRun)
            tmpl.copyStyleTo(r2)
            r2.color = tmpl.color
            r2.text = t
            push out r2
            return
        }
        def i:int 0
        def blocks:int 0
        while (i < (node.childCount())) {
            def c:MdNode (node.childAt(i))
            if (c.kind != "list") {
                ; two paragraphs of one item are one line, a space apart
                if ((node.kind == "item") && (blocks > 0)) {
                    def sp:MdNode (MdNode.create("text"))
                    sp.literal = " "
                    this.collectRuns(sp tmpl out)
                }
                this.collectRuns(c tmpl out)
                blocks = (blocks + 1)
            }
            i = (i + 1)
        }
    }

    sfn sameStyle:boolean (a:PptxTextRun b:PptxTextRun) {
        if (a.bold != b.bold) { return false }
        if (a.italic != b.italic) { return false }
        if (a.fontFamily != b.fontFamily) { return false }
        if (a.highlight.isSet || b.highlight.isSet) { return false }
        return ((a.color.signature()) == (b.color.signature()))
    }

    ; The layout's run that starts at `off` in the source, or kind -1.
    fn boxAt:MdBox (off:int) {
        def i:int 0
        while (i < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes i)
            if ((b.kind == 0) && ((b.segSrc == off) && (off >= 0))) { return b }
            i = (i + 1)
        }
        def none (new MdBox())
        none.kind = -1
        return none
    }

    sfn trimLeft:string (s:string) {
        def i:int 0
        while ((i < (strlen s)) && ((charAt s i) == 32)) {
            i = (i + 1)
        }
        return (substring s i (strlen s))
    }

    sfn trimRight:string (s:string) {
        def n:int (strlen s)
        while ((n > 0) && ((charAt s (n - 1)) == 32)) {
            n = (n - 1)
        }
        return (substring s 0 n)
    }

    sfn bulletFor:string (level:int) {
        if (level == 0) { return "•" }
        if (level == 1) { return "–" }
        return "·"
    }

    ; ----------------------------------------------------------------------
    ; A table, as a table
    ; ----------------------------------------------------------------------
    fn table:void (slide:PptxSlideRef node:MdNode x:double y:double w:double h:double) {
        def rows:int (node.childCount())
        if (rows == 0) { return }
        def head:MdNode (node.childAt(0))
        def cols:int (head.childCount())
        if (cols == 0) { return }

        def sh (new PptxShape)
        sh.kind = (PptxShapeKind.table())
        sh.name = "Table"
        sh.x = x
        sh.y = y
        sh.width = w
        sh.height = h
        sh.hasXfrm = true
        sh.tableRows = rows
        sh.tableCols = cols
        ; The SAME grid the layout drew, asked of the same function — not a
        ; width divided by a count. A table of one narrow column of labels
        ; beside two of numbers is exactly the case equal division gets wrong,
        ; and it gets it wrong by writing the label across the next cell.
        def widths:[double] (layout.tableWidths(node w))
        ; …or better, the cells the layout DREW: a slide fitted to its room
        ; sets the table at another size than the style's, and the grid
        ; asked again comes out narrower than the text it holds.
        def drawnW:[double] (this.drawnColumns(node (this.pageOf(node))))
        if ((array_length drawnW) == cols) {
            widths = drawnW
            def sum:double 0.0
            def dw:int 0
            while (dw < cols) {
                sum = (sum + (itemAt drawnW dw))
                dw = (dw + 1)
            }
            sh.width = sum
        }
        def c:int 0
        while (c < cols) {
            if (c < (array_length widths)) {
                push sh.tableColW (itemAt widths c)
            } {
                push sh.tableColW (w / (int2double cols))
            }
            c = (c + 1)
        }
        def rowH:double (h / (int2double rows))
        def r:int 0
        while (r < rows) {
            push sh.tableRowH rowH
            r = (r + 1)
        }
        r = 0
        def page:int (this.pageOf(node))
        while (r < rows) {
            def row:MdNode (node.childAt(r))
            def cc:int 0
            while (cc < cols) {
                def cell (new PptxTableCell)
                def drawn (new MdBox())
                drawn.kind = -1
                if (cc < (row.childCount())) {
                    drawn = (this.runBoxOf((row.childAt(cc)) page))
                    def cn:MdNode (row.childAt(cc))
                    cell.text = (trim (MdToPptx.flatText(cn)))
                    def a:string cn.align
                    if ((strlen a) > 0) {
                        if (a == "right") { cell.align = "r" }
                        if (a == "center") { cell.align = "ctr" }
                    }
                }
                cell.fontSizePt = layout.style.bodySize
                if (r == 0) {
                    cell.bold = true
                    cell.fill = (PptxApi.colorOf(layout.style.tableHeadBackground))
                }
                ; A cell is a TEXT BODY, and `text` beside it is the shorthand.
                ; The writer will fall back to the shorthand, but nothing that
                ; DRAWS a deck reads it — the renderer lays the body out — so a
                ; cell built with only the shorthand is a table of empty boxes
                ; on screen and a table of words in the file.
                def cp (new PptxParagraph)
                cp.align = cell.align
                cp.alignSet = true
                def cr (new PptxTextRun)
                cr.text = cell.text
                cr.fontFamily = layout.style.bodyFamily
                cr.fontSizePt = layout.style.bodySize
                cr.sizeSet = true
                cr.bold = cell.bold
                cr.boldSet = true
                cr.color = (PptxApi.colorOf(layout.style.textColor))
                ; the size, colour and band the layout drew the cell with
                MdToPptx.asDrawn(cr drawn)
                if (drawn.kind >= 0) {
                    cell.fontSizePt = cr.fontSizePt
                    def band:MdBox (this.fillUnder(node page drawn))
                    if (band.kind >= 0) {
                        cell.fill = (PptxApi.colorOf(band.fill))
                    }
                }
                push cp.runs cr
                push cell.body.paragraphs cp
                ; …and the grid, which markdown's table always draws.
                cell.lnT = (MdToPptx.rule(layout.style.tableBorder))
                cell.lnB = (MdToPptx.rule(layout.style.tableBorder))
                cell.lnL = (MdToPptx.rule(layout.style.tableBorder))
                cell.lnR = (MdToPptx.rule(layout.style.tableBorder))
                push sh.tableCells cell
                cc = (cc + 1)
            }
            r = (r + 1)
        }
        def model:PptxSlide (slide.model())
        push model.shapes sh
        result.tables = (result.tables + 1)
    }

    ; The widths of the cells of the table's first row as the layout drew
    ; them (their outlines, left to right); empty when it drew none.
    fn drawnColumns:[double] (node:MdNode page:int) {
        def out:[double]
        def top:double -1.0
        def i:int 0
        while (i < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes i)
            if (((b.page == page) && (b.kind == 2)) && (MdToPptx.inSpan(node b.srcStart))) {
                if ((top < 0.0) || (b.y < top)) { top = b.y }
            }
            i = (i + 1)
        }
        if (top < 0.0) { return out }
        def lastX:double -1.0
        i = 0
        while (i < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes i)
            if (((b.page == page) && (b.kind == 2)) && (MdToPptx.inSpan(node b.srcStart))) {
                if (((fabs (b.y - top)) < 0.5) && (b.x > lastX)) {
                    push out b.w
                    lastX = b.x
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; The filled box of `node`'s the run `text` sits in, or kind -1.
    fn fillUnder:MdBox (node:MdNode page:int text:MdBox) {
        def i:int 0
        while (i < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes i)
            if (((b.page == page) && (b.kind == 1)) && ((strlen b.fill) > 0)) {
                if (MdToPptx.inSpan(node b.srcStart)) {
                    if (((text.x >= b.x) && (text.x < (b.x + b.w))) && ((text.y >= b.y) && (text.y < (b.y + b.h)))) {
                        return b
                    }
                }
            }
            i = (i + 1)
        }
        def none (new MdBox())
        none.kind = -1
        return none
    }

    sfn rule:PptxTableLine (hex:string) {
        def ln (new PptxTableLine)
        ln.isSet = true
        ln.widthPt = 0.75
        ln.color = (PptxApi.colorOf(hex))
        return ln
    }

    ; ----------------------------------------------------------------------
    ; …and the fallback, which is what a diagram is for
    ; ----------------------------------------------------------------------
    ;
    ; The drawing is already an `EVGElement` in the embed cache, laid out at
    ; the width of the column it lands in. From there it is the road
    ; `BookToPptx` proved: display list in, DrawingML shapes out.
    ; The fence word, as a reader would write the notation's name.
    ; `kind` here is the FENCE WORD — `dot` and `puml` are spellings, not
    ; notations — so it goes through the same table the parser and the
    ; renderer read.
    sfn notationWord:string (kind:string) {
        return (MdEmbedKinds.notationWord(kind))
    }

    ; What the drawing SAYS, for a reader who cannot see it.
    ;
    ; The pixels tell a screen reader nothing, and a diagram's group is the
    ; case `PptxA11y` calls "No alt text" for a picture. The labels are what
    ; the diagram is about, so they are the description — capped, because a
    ; forty-node graph read out in draw order helps nobody either.
    sfn describeDrawing:string (word:string group:PptxShape) {
        def labels:[string]
        labels = (MdToPptx.labelsOf(labels group))
        def n:int (array_length labels)
        def head:string (word + " diagram")
        if (n == 0) { return head }
        def out:string (head + ": ")
        def i:int 0
        while (i < n) {
            if (i >= 8) {
                return ((out + ", and ") + (to_string (n - 8))) + " more"
            }
            if (i > 0) { out = (out + ", ") }
            out = (out + (itemAt labels i))
            i = (i + 1)
        }
        return out
    }

    ; Every piece of text inside a shape and its children, in draw order. The
    ; list is RETURNED rather than grown through the parameter: `push` onto an
    ; array parameter lands on a copy on the Go target.
    sfn labelsOf:[string] (out:[string] sh:PptxShape) {
        def res:[string] out
        if sh.hasText {
            def t:string (trim (sh.text.plainText()))
            if ((strlen t) > 0) { push res t }
        }
        def i:int 0
        def n:int (array_length sh.children)
        while (i < n) {
            def c:PptxShape (itemAt sh.children i)
            res = (MdToPptx.labelsOf(res c))
            i = (i + 1)
        }
        return res
    }

    ; The layout's boxes for a block, painted and converted to shapes as one
    ; group. For what has no native PowerPoint spelling here.
    fn boxesDrawn:void (slide:PptxSlideRef node:MdNode name:string) {
        def page:int (this.pageOf(node))
        def dl (new EVGDisplayList())
        def painter (new MdToEvg())
        def any:boolean false
        def i:int 0
        while (i < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes i)
            if ((b.page == page) && (MdToPptx.inSpan(node b.srcStart))) {
                painter.paintBox(dl layout b 0.0)
                any = true
            }
            i = (i + 1)
        }
        if (any == false) {
            return
        }
        def conv (new PptxFromEvg())
        conv.unit = 1.0
        def group:PptxShape (conv.build(dl 0.0 0.0))
        group.name = (name + " " + (to_string (result.drawn + 1)))
        group.altText = (MdLayout.stripTags(node.literal))
        def model:PptxSlide (slide.model())
        push model.shapes group
        result.drawn = (result.drawn + 1)
    }

    ; A $$ display: its outlines as shapes, grouped, with the TeX kept on the
    ; group so it can be read back.
    fn formula:void (slide:PptxSlideRef node:MdNode) {
        def b:MdBox (new MdBox())
        b.kind = -1
        def i:int 0
        while (i < (array_length layout.boxes)) {
            def c:MdBox (itemAt layout.boxes i)
            if ((c.kind == 5) && (MdToPptx.inSpan(node c.srcStart))) {
                b = c
            }
            i = (i + 1)
        }
        if (b.kind != 5) {
            result.dropped = (result.dropped + 1)
            return
        }
        def root:EVGElement (MdToEvg.mathElement(b))
        MdToEvg.put(root 0.0 0.0 b.w b.h)
        def le (new EVGLayout())
        le.setPageSize(b.w b.h)
        le.layout(root)
        def dl (new EVGDisplayList())
        dl.build(root)
        def conv (new PptxFromEvg())
        conv.unit = 1.0
        def group:PptxShape (conv.build(dl b.x b.y))
        group.name = ("Formula " + (to_string (result.drawn + 1)))
        group.altText = node.literal
        ; An equation PowerPoint can edit, centred in the column where the
        ; drawing is; the drawing is what every other reader shows instead.
        def box:PptxShapeRef (slide.addTextBox(layout.contentX b.y layout.contentW b.h (MathOmml.linear(node.literal))))
        MdToPptx.tight(box)
        def m:PptxShape (box.model())
        def para:PptxParagraph (itemAt m.text.paragraphs 0)
        para.align = "ctr"
        para.alignSet = true
        def r:PptxTextRun (itemAt para.runs 0)
        r.fontFamily = layout.style.bodyFamily
        r.fontSizePt = b.size
        r.sizeSet = true
        r.color = (PptxApi.colorOf(b.color))
        r.math = (MathOmml.omml(node.literal))
        r.mathDisplay = true
        m.name = group.name
        m.altText = node.literal
        m.embedNotation = "tex"
        m.embedSource = node.literal
        push m.mathFallback group
        result.drawn = (result.drawn + 1)
    }

    fn drawn:void (slide:PptxSlideRef node:MdNode x:double y:double w:double h:double) {
        def kind:string (MdLayout.firstWord(node.info))
        def idx:int (layout.embeds.find(kind node.literal w))
        if (idx < 0) {
            idx = (this.embedAtAnyWidth(kind node.literal))
        }
        if (idx < 0) {
            result.dropped = (result.dropped + 1)
            result.note((("slide " + (to_string ((this.pageOf(node)) + 1))) + ": a ") + kind + " diagram was never drawn, so there was nothing to place")
            return
        }
        def e:MdEmbedEntry (layout.embeds.entryAt(idx))
        if (! e.ok) {
            result.dropped = (result.dropped + 1)
            result.note((("slide " + (to_string ((this.pageOf(node)) + 1))) + ": ") + e.note)
            return
        }
        ; The scene's root has to be PLACED and LAID OUT before it has any
        ; geometry: its paths carry an `svgPath` and a `viewBox` and are put
        ; where the box their container gives them is, not at a left and a top
        ; of their own. Built straight from the tree, the edges come out
        ; because they are absolute and every node's label lands in the corner
        ; — which is exactly what the first attempt at this drew.
        def root:EVGElement (unwrap e.root)
        ; The scene is the layout's own, which a host may be drawing on screen
        ; at the same time: its background is taken off for the build and
        ; given back, or the next frame there is drawn without it.
        def bg0:EVGColor root.backgroundColor
        MdToEvg.put(root 0.0 0.0 w h)
        root.backgroundColor = (EVGColor.noColor())
        def le (new EVGLayout())
        le.setPageSize(w h)
        le.layout(root)
        def dl (new EVGDisplayList())
        dl.build(root)
        root.backgroundColor = bg0
        def conv (new PptxFromEvg())
        ; One unit, not three quarters of one. `PptxFromEvg` defaults to
        ; 0.75 because a display list is usually CSS pixels and a slide is
        ; points; this deck is the LAYOUT's own units all the way through —
        ; `d.setSize(pageWidth pageHeight)` and every text box beside the
        ; drawing are placed 1:1 — so the default shrank every diagram to
        ; three quarters of the column it was laid out to fill, and left a
        ; quarter of the slide empty beside it.
        conv.unit = 1.0
        ; a drawing narrower than its column sits where the chart asked
        def dx:double (e.shiftIn(w))
        def group:PptxShape (conv.build(dl (x + dx) y))

        ; The group is an OBJECT, so it says what it is.
        ;
        ; `PptxFromEvg` names every group it builds `Drawing`, which is all it
        ; can know — it is handed a display list and nothing else. This file
        ; knows the notation and has just read the labels, so it is the one
        ; place that can answer. A reader who finds this in PowerPoint's
        ; selection pane now reads "Mermaid diagram 1" rather than "Drawing",
        ; and a screen reader gets the labels rather than silence: `descr`
        ; round-trips through the writer and the parser already, and
        ; `PptxA11y.shapeName` prefers it over everything else.
        def word:string (MdToPptx.notationWord(kind))
        group.name = ((word + " diagram ") + (to_string (result.drawn + 1)))
        group.altText = (MdToPptx.describeDrawing(word group))

        ; …and what it was generated FROM, so that it can be read back.
        ;
        ; Nothing can reconstruct a diagram from the shapes it drew: a class
        ; diagram and a sequence diagram draw the same rectangles. Without the
        ; fence's own text a deck can be moved and resized and never edited
        ; again — and the decks being written now are the ones that will still
        ; be around. It rides in `p:cNvPr/a:extLst`, which OOXML sets aside
        ; for an application's own data and requires other applications to
        ; preserve.
        group.embedNotation = (MdEmbedKinds.notationOf(kind))
        group.embedSource = node.literal

        def model:PptxSlide (slide.model())
        push model.shapes group
        result.drawn = (result.drawn + 1)
        result.note((("slide " + (to_string ((this.pageOf(node)) + 1))) + ": the ") + kind + " diagram is drawn as shapes, not as text — it can be moved and resized, and not yet edited")
        if (conv.unresolvedImages > 0) {
            result.images = (result.images + conv.unresolvedImages)
            result.note((("slide " + (to_string ((this.pageOf(node)) + 1))) + ": ") + (to_string conv.unresolvedImages) + " picture(s) in it could not be carried")
        }
        ; A clip that mattered is a clip that is ignored: DrawingML can say
        ; one — `a:srcRect` on a blip — and `PptxFromEvg` does not yet, so
        ; content meant to be cut is drawn.
        if (conv.clipped > 0) {
            result.clipped = (result.clipped + conv.clipped)
            result.note((("slide " + (to_string ((this.pageOf(node)) + 1))) + ": ") + (to_string conv.clipped) + " clip(s) ignored — content meant to be cut is drawn")
        }
    }

    fn embedAtAnyWidth:int (kind:string source:string) {
        def i:int 0
        while (i < (layout.embeds.count())) {
            def e:MdEmbedEntry (layout.embeds.entryAt(i))
            if ((e.kind == kind) && (e.source == source)) { return i }
            i = (i + 1)
        }
        return -1
    }

    ; ----------------------------------------------------------------------
    ; Where the layout put it
    ; ----------------------------------------------------------------------
    ;
    ; Read off the boxes rather than recomputed: the layout already decided,
    ; and a second answer here would be a second layout to keep in step.
    ; A box belongs to this block when its source offset is inside the
    ; block's span, which is true for a list's items and its bullets alike.
    ; The first run of text the layout drew for `node` on `page`: the size,
    ; face and colour the reader saw. A theme, a class or the slide's own
    ; fitting can make those other than the style's defaults, and the deck
    ; used to write the defaults — a slide's 28-point list came out at 20.
    ; A run of the block's own text first (`segSrc`), so a list's marker is
    ; not taken for its first item; then any box of the block, which is how
    ; a title is drawn. A link's run is passed over: its colour is the
    ; link's, not the text's. Kind -1 when the layout drew nothing.
    fn runBoxOf:MdBox (node:MdNode page:int) {
        def pass:int 0
        while (pass < 2) {
            def i:int 0
            while (i < (array_length layout.boxes)) {
                def b:MdBox (itemAt layout.boxes i)
                if (((b.page == page) && (b.kind == 0)) && ((strlen b.link) == 0)) {
                    def at:int (? (pass == 0) b.segSrc b.srcStart)
                    if (MdToPptx.inSpan(node at)) {
                        if ((strlen (trim b.text)) > 0) { return b }
                    }
                }
                i = (i + 1)
            }
            pass = (pass + 1)
        }
        def none (new MdBox())
        none.kind = -1
        return none
    }

    ; The marker the layout drew in front of the line `text` starts: a box
    ; of the list's with no run of its own, on the same line, to the left.
    ; The nearest one: in a list set in columns the items of one row share a
    ; line, and a marker of the column to the left is on it too.
    fn markerBoxOf:MdBox (list:MdNode page:int text:MdBox) {
        def none (new MdBox())
        none.kind = -1
        def best:MdBox none
        def i:int 0
        while (i < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes i)
            if (((b.page == page) && (b.kind == 0)) && (b.segSrc < 0)) {
                if ((MdToPptx.inSpan(list b.srcStart)) && (b.x < text.x)) {
                    if ((fabs (b.y - text.y)) < 1.0) {
                        if ((best.kind < 0) || (b.x > best.x)) { best = b }
                    }
                }
            }
            i = (i + 1)
        }
        return best
    }

    ; A run in the size, face and colour of the box the layout drew.
    sfn asDrawn:void (r:PptxTextRun b:MdBox) {
        if (b.kind < 0) { return }
        if (b.size > 0.0) {
            r.fontSizePt = b.size
            r.sizeSet = true
        }
        if ((strlen b.family) > 0) {
            r.fontFamily = b.family
        }
        if ((strlen b.color) > 0) {
            r.color = (PptxApi.colorOf(b.color))
        }
    }

    ; The layout's line height, as PowerPoint's line spacing: "single" is
    ; about 1.2 times the size, so a 1.35 line is 112%.
    sfn lineSpacingOf:void (p:PptxParagraph b:MdBox) {
        if ((b.kind < 0) || (b.size <= 0.0)) { return }
        def pct:double (((b.h / b.size) / 1.2) * 100.0)
        if ((pct > 100.5) && (pct < 250.0)) {
            p.lineSpacingPct = pct
        }
    }

    sfn lineSpacing:void (m:PptxShape b:MdBox) {
        def i:int 0
        while (i < (array_length m.text.paragraphs)) {
            MdToPptx.lineSpacingOf((itemAt m.text.paragraphs i) b)
            i = (i + 1)
        }
    }

    fn pageOf:int (node:MdNode) {
        def i:int 0
        while (i < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes i)
            if (MdToPptx.inSpan(node b.srcStart)) { return b.page }
            i = (i + 1)
        }
        return -1
    }

    sfn inSpan:boolean (node:MdNode off:int) {
        if (off < 0) { return false }
        if (node.srcStart < 0) { return false }
        if (off < node.srcStart) { return false }
        if (off >= node.srcEnd) { return false }
        return true
    }

    fn leftOf:double (node:MdNode page:int) {
        def best:double (0.0 - 1.0)
        def i:int 0
        while (i < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes i)
            if (b.page == page) {
                if (MdToPptx.inSpan(node b.srcStart)) {
                    if ((best < 0.0) || (b.x < best)) { best = b.x }
                }
            }
            i = (i + 1)
        }
        if (best < 0.0) { return layout.style.margin }
        return best
    }

    fn topOf:double (node:MdNode page:int) {
        def best:double (0.0 - 1.0)
        def i:int 0
        while (i < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes i)
            if (b.page == page) {
                if (MdToPptx.inSpan(node b.srcStart)) {
                    if ((best < 0.0) || (b.y < best)) { best = b.y }
                }
            }
            i = (i + 1)
        }
        if (best < 0.0) { return layout.style.margin }
        return best
    }

    fn widthOf:double (node:MdNode page:int) {
        def left:double (this.leftOf(node page))
        def right:double 0.0
        def i:int 0
        while (i < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes i)
            if (b.page == page) {
                if (MdToPptx.inSpan(node b.srcStart)) {
                    def r:double (b.x + b.w)
                    if (r > right) { right = r }
                }
            }
            i = (i + 1)
        }
        return (right - left)
    }

    fn heightOf:double (node:MdNode page:int) {
        def top:double (this.topOf(node page))
        def bottom:double 0.0
        def i:int 0
        while (i < (array_length layout.boxes)) {
            def b:MdBox (itemAt layout.boxes i)
            if (b.page == page) {
                if (MdToPptx.inSpan(node b.srcStart)) {
                    def bt:double (b.y + b.h)
                    if (bt > bottom) { bottom = bt }
                }
            }
            i = (i + 1)
        }
        return (bottom - top)
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MdChar.rgr — the character tests the specification is written in terms of.
; ============================================================================
;
; CommonMark says "Unicode whitespace" and "Unicode punctuation" and means it:
; the flanking rules that decide whether a `*` opens or closes emphasis read
; the characters on both sides, and getting them wrong costs examples in the
; section that has the most of them.
;
; `charAt` gives a UTF-16 code unit on the targets that have one and a byte on
; the ones that do not, so everything here works on code points the parser has
; already decoded, and the multi-byte tests are the ranges rather than a table.
; ============================================================================

class MdChar {
    sfn tab:int ()        { return 9 }
    sfn newline:int ()    { return 10 }
    sfn space:int ()      { return 32 }
    sfn bang:int ()       { return 33 }
    sfn quote:int ()      { return 34 }
    sfn hash:int ()       { return 35 }
    sfn amp:int ()        { return 38 }
    sfn apos:int ()       { return 39 }
    sfn parenL:int ()     { return 40 }
    sfn parenR:int ()     { return 41 }
    sfn star:int ()       { return 42 }
    sfn plus:int ()       { return 43 }
    sfn dash:int ()       { return 45 }
    sfn dot:int ()        { return 46 }
    sfn slash:int ()      { return 47 }
    sfn colon:int ()      { return 58 }
    sfn semi:int ()       { return 59 }
    sfn lt:int ()         { return 60 }
    sfn eq:int ()         { return 61 }
    sfn gt:int ()         { return 62 }
    sfn bracketL:int ()   { return 91 }
    sfn backslash:int ()  { return 92 }
    sfn bracketR:int ()   { return 93 }
    sfn underscore:int () { return 95 }
    sfn backtick:int ()   { return 96 }
    sfn pipe:int ()       { return 124 }
    sfn tilde:int ()      { return 126 }

    sfn isDigit:boolean (c:int) {
        if (c < 48) { return false }
        if (c > 57) { return false }
        return true
    }

    sfn isSpaceOrTab:boolean (c:int) {
        if (c == 32) { return true }
        if (c == 9) { return true }
        return false
    }

    ; Unicode whitespace, as the specification defines it: the Zs category
    ; plus tab, line feed, form feed and carriage return.
    sfn isUnicodeWhitespace:boolean (c:int) {
        if (c == 32) { return true }
        if (c == 9) { return true }
        if (c == 10) { return true }
        if (c == 12) { return true }
        if (c == 13) { return true }
        if (c == 160) { return true }
        if (c == 5760) { return true }
        if ((c >= 8192) && (c <= 8202)) { return true }
        if (c == 8239) { return true }
        if (c == 8287) { return true }
        if (c == 12288) { return true }
        return false
    }

    ; ASCII punctuation, which is the set backslash escapes accept.
    sfn isAsciiPunct:boolean (c:int) {
        if ((c >= 33) && (c <= 47)) { return true }
        if ((c >= 58) && (c <= 64)) { return true }
        if ((c >= 91) && (c <= 96)) { return true }
        if ((c >= 123) && (c <= 126)) { return true }
        return false
    }

    ; Unicode punctuation: the ASCII set plus the ranges the P* and S*
    ; categories occupy densely enough to matter for flanking. A parser that
    ; only tests ASCII here reads `"*foo*"` correctly and `»foo«` wrongly.
    sfn isUnicodePunct:boolean (c:int) {
        if (MdChar.isAsciiPunct(c)) { return true }
        if ((c >= 161) && (c <= 191)) { return true }
        if ((c >= 8208) && (c <= 8286)) { return true }
        if ((c >= 8317) && (c <= 8318)) { return true }
        if ((c >= 8333) && (c <= 8334)) { return true }
        if ((c >= 8968) && (c <= 8971)) { return true }
        if ((c >= 9001) && (c <= 9002)) { return true }
        if ((c >= 10088) && (c <= 10101)) { return true }
        if ((c >= 11776) && (c <= 11858)) { return true }
        if ((c >= 12296) && (c <= 12305)) { return true }
        if ((c >= 12308) && (c <= 12319)) { return true }
        if ((c >= 65040) && (c <= 65049)) { return true }
        if ((c >= 65072) && (c <= 65106)) { return true }
        if ((c >= 65108) && (c <= 65121)) { return true }
        ; Symbols. CommonMark 0.31 defines "Unicode punctuation character" as
        ; the P categories AND the S ones, so `*€*` is not emphasis for the
        ; same reason `*(*` is not. Leaving the symbol blocks out reads as a
        ; currency bug and is a flanking bug.
        if (c == 215) { return true }
        if (c == 247) { return true }
        if ((c >= 8352) && (c <= 8399)) { return true }
        if ((c >= 8448) && (c <= 8527)) { return true }
        if ((c >= 8592) && (c <= 9254)) { return true }
        if ((c >= 9280) && (c <= 9290)) { return true }
        if ((c >= 9312) && (c <= 10175)) { return true }
        if ((c >= 10176) && (c <= 11123)) { return true }
        if ((c >= 11126) && (c <= 11157)) { return true }
        if ((c >= 11159) && (c <= 11263)) { return true }
        if ((c >= 12032) && (c <= 12245)) { return true }
        if ((c >= 12272) && (c <= 12292)) { return true }
        if ((c >= 12688) && (c <= 12703)) { return true }
        if ((c >= 12800) && (c <= 13311)) { return true }
        if ((c >= 63744) && (c <= 64255)) { return false }
        if ((c >= 65281) && (c <= 65376)) { return true }
        if ((c >= 65504) && (c <= 65510)) { return true }
        if ((c >= 65512) && (c <= 65518)) { return true }
        if ((c >= 65529) && (c <= 65533)) { return true }
        if ((c >= 127744) && (c <= 129782)) { return true }
        return false
    }

    ; Simple case folding, for the alphabets that have one. Link reference
    ; labels are matched case-insensitively, and the specification means
    ; Unicode case folding by that — `[ΑΓΩ]` and `[αγω]` are the same label.
    ; ASCII, Latin-1, Greek and Cyrillic are one addition each and cover
    ; every label anybody writes; the rest fold to themselves, which is
    ; stated here rather than left to be discovered.
    sfn foldCase:int (c:int) {
        if ((c >= 65) && (c <= 90)) { return (c + 32) }
        if ((c >= 192) && (c <= 222)) {
            if (c == 215) { return c }
            return (c + 32)
        }
        if ((c >= 913) && (c <= 929)) { return (c + 32) }
        if ((c >= 931) && (c <= 939)) { return (c + 32) }
        if ((c >= 1040) && (c <= 1071)) { return (c + 32) }
        if ((c >= 1024) && (c <= 1039)) { return (c + 80) }
        return c
    }

    sfn isLetter:boolean (c:int) {
        if ((c >= 65) && (c <= 90)) { return true }
        if ((c >= 97) && (c <= 122)) { return true }
        return false
    }

    sfn isAlnum:boolean (c:int) {
        if (MdChar.isLetter(c)) { return true }
        return (MdChar.isDigit(c))
    }

    sfn isHexDigit:boolean (c:int) {
        if (MdChar.isDigit(c)) { return true }
        if ((c >= 65) && (c <= 70)) { return true }
        if ((c >= 97) && (c <= 102)) { return true }
        return false
    }

    sfn lower:string (s:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def c:int (charAt s i)
            if ((c >= 65) && (c <= 90)) {
                out = (out + (MdChar.fromCode((c + 32))))
            } {
                out = (out + (substring s i (i + 1)))
            }
            i = (i + 1)
        }
        return out
    }

    ; A code point back to a string. `strfromcode` writes UTF-8 directly on
    ; the targets whose strings are bytes and one UTF-16 unit on the ones whose
    ; strings are units, so above the BMP the pair has to be built by hand —
    ; the same split EVGCodepoint.toStr makes, for the same reason.
    sfn fromCode:string (c:int) {
        if (c < 65536) {
            return (strfromcode c)
        }
        if (MdChar.stringIsBytes()) {
            return (strfromcode c)
        }
        def rel:int (c - 65536)
        def hi:int (55296 + (idiv rel 1024))
        def lo:int (56320 + (rel % 1024))
        return ((strfromcode hi) + (strfromcode lo))
    }

    ; Whether this target stores a string as bytes (C++, Go) or as units
    ; (JavaScript, Java, C#). Asked of the language rather than of a build
    ; flag, so it cannot be got wrong by a compiler switch.
    sfn stringIsBytes:boolean () {
        def n:int (strlen "\u00e4")
        return (n > 1)
    }
}

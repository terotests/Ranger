; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; MdVegaRender — a chart in a fence, drawn where the diagrams are drawn
; ==============================================================================
;
; ````markdown
; ```vega-lite
; {"data": {"values": [{"a": "A", "b": 28}, {"a": "B", "b": 55}]},
;  "mark": "bar",
;  "encoding": {"x": {"field": "a", "type": "nominal"},
;               "y": {"field": "b", "type": "quantitative"}}}
; ```
; ````
;
; `MdEmbedKinds` says a fence word earns its row only once something can DRAW
; it. Vela is that something: a Vega-compatible runtime already in this
; repository, already drawing the charts in a `.pptx`. This is the door
; `D2Render` is for D2 — the reader exists, and what was missing was the step
; that hands its output to the page.
;
; --- WHY IT PRODUCES A FlowScene ----------------------------------------------
;
; A chart is not a graph, and `FlowScene` is not a graph either: it is a flat
; list of rects, texts and paths with a world rectangle around them — a display
; list under a different name. Every one of markdown's diagram notations already
; arrives that way, and everything downstream (the PDF, the deck, the GPU) reads
; it. Emitting anything else would mean a second path through the renderer for
; the one notation that is not a diagram.
;
; --- WHAT IS DRAWN, AND WHAT IS SAID ------------------------------------------
;
; Rects, text, lines, polylines, polygons, paths and symbols. An `arc` and an
; `image` are counted rather than approximated: a pie drawn as rectangles is a
; wrong chart, and a wrong chart is worse than an absent one because nobody
; checks it. `MdDiagram.refusal` reads the count.
; ==============================================================================

Import "../../rangerflow/core/FlowScene.rgr"
Import "../../vela/src/VlJson.rgr"
Import "MdChar.rgr"
Import "../../rangerflow/domains/graphviz/DotColors.rgr"
Import "../../vela/src/VlShape.rgr"
Import "../../vela/src/VlCompile.rgr"
Import "../../vela/src/VlRuntime.rgr"
Import "../../vela/src/VlCommand.rgr"
Import "../../vela/src/VlText.rgr"

class MdVegaDrawing {
    def ok:boolean false
    def error:string ""
    ; Marks this could not draw, by op, so the reason can name them.
    def skipped:[string]
    def scene:FlowScene (new FlowScene)

    Constructor () {
        def a:[string]
        skipped = a
    }
}

class MdVegaRender {

    ; The fence, as a scene. `width` is what the page has to give it; the chart
    ; keeps its own aspect and is scaled to fit rather than stretched, because a
    ; stretched chart lies about its own proportions.
    sfn sceneOf:FlowScene (text:string styleName:string width:double pad:double) {
        def d:MdVegaDrawing (MdVegaRender.draw(text width pad))
        return d.scene
    } doc {
        description "Runs a Vega or Vega-Lite spec and returns its marks as a scene."
        param text "The fence's text: a Vega-Lite or Vega specification."
        param styleName "The page's diagram style. Charts carry their own colours, so it is not read yet."
        param width "The width the page can give the chart."
        param pad "Padding around it."
        returns "A scene of the chart's marks."
    }

    ; A pie or a donut that names no size is set in the room it has rather
    ; than at Vega's 200-pixel default, which is a stamp in a column: as wide
    ; as the column allows beside its legend, and no larger than 360.
    sfn sized:string (text:string width:double pad:double) {
        if ((indexOf text "\"arc\"") < 0) {
            return text
        }
        if (((indexOf text "\"width\"") >= 0) || ((indexOf text "\"height\"") >= 0)) {
            return text
        }
        def side:double ((width - (pad * 2.0)) - 160.0)
        if (side > 360.0) {
            side = 360.0
        }
        if (side < 120.0) {
            return text
        }
        def brace:int (indexOf text "{")
        if (brace < 0) {
            return text
        }
        def n:string (to_string (to_int side))
        return ((substring text 0 (brace + 1)) + "\"width\": " + n + ", \"height\": " + n + ", " + (substring text (brace + 1) (strlen text)))
    }

    ; `defaults` (a JSON object) laid under the chart: what the chart says
    ; wins, member by member, and what it leaves out comes from the
    ; defaults — `{"config": {"title": {"fontSize": 18}}}` sizes every title
    ; that does not size its own. Text that is not an object is left alone.
    sfn withDefaults:string (text:string defaults:string) {
        if ((strlen (trim defaults)) == 0) {
            return text
        }
        def p1 (new VlJsonParser())
        def spec:VlJson (p1.parse(text))
        if ((p1.ok == false) || ((spec.isObject()) == false)) {
            return text
        }
        def p2 (new VlJsonParser())
        def defs:VlJson (p2.parse(defaults))
        if ((p2.ok == false) || ((defs.isObject()) == false)) {
            return text
        }
        MdVegaRender.layUnder(spec defs)
        def w (new VlJsonWriter())
        return (w.write(spec))
    }

    ; The files a chart reads (`"url"` of any data in it, a layer's and a
    ; lookup's included), in the order they appear.
    ; A fence whose whole text is a file's path (`charts/sales.vl.json`):
    ; the chart is in that file. The path, or "" for a fence that is a spec.
    sfn specFile:string (text:string) {
        def t:string (trim text)
        if (((strlen t) == 0) || ((indexOf t "{") >= 0)) {
            return ""
        }
        if (((indexOf t "\n") >= 0) || ((indexOf t " ") >= 0)) {
            return ""
        }
        if ((indexOf t ".json") < 0) {
            return ""
        }
        return t
    }

    ; The fence's spec: its own text, or the text of the file it names when
    ; the host has handed that over.
    sfn fromFile:string (text:string urls:[string] texts:[string]) {
        def path:string (MdVegaRender.specFile(text))
        if ((strlen path) == 0) {
            return text
        }
        def bare:string (MdVegaRender.bareUrl(path))
        def i:int 0
        while (i < (array_length urls)) {
            if ((MdVegaRender.bareUrl((itemAt urls i))) == bare) {
                return (itemAt texts i)
            }
            i = (i + 1)
        }
        return text
    }

    ; "./data/x.csv" and "data/x.csv" are the same file.
    sfn bareUrl:string (u:string) {
        if ((indexOf u "./") == 0) {
            return (substring u 2 (strlen u))
        }
        return u
    }

    ; Where a chart's data is fetched from: its `url`, or — for a Google
    ; Sheet — the sheet's CSV. A sheet is named by
    ;   {"source": "google-sheets", "id": "<id or link>", "sheet": "Monthly", "range": "A:B"}
    ;   (or "range": "Monthly!A:B", or "gid": 123),
    ;   {"url": "https://docs.google.com/spreadsheets/d/<id>/edit#gid=123"}, or
    ;   {"url": "sheet://<id>/Monthly!A:B"}.
    ; A sheet shared "anyone with the link" is read without signing in.
    ; "" for data with neither (inline `values`, a named dataset).
    sfn sourceUrl:string (d:VlJson) {
        if ((d.isObject()) == false) {
            return ""
        }
        def src:string (MdChar.lower((d.stringOr("source" ""))))
        def url:string (d.stringOr("url" ""))
        if (((src == "google-sheets") || (src == "sheets")) || ((src == "sheet") || (src == "google-sheet"))) {
            def id:string (d.stringOr("id" ""))
            if ((strlen id) == 0) {
                id = url
            }
            def gv:VlJson (d.get("gid"))
            def gid:string ""
            if (gv.isNumber()) {
                gid = (to_string (gv.asInt()))
            }
            if (gv.isString()) {
                gid = (gv.asString())
            }
            return (MdVegaRender.sheetCsv(id (d.stringOr("sheet" "")) (d.stringOr("range" "")) gid))
        }
        if ((strlen url) == 0) {
            return ""
        }
        if ((indexOf url "sheet://") == 0) {
            def rest:string (substring url 8 (strlen url))
            def slash:int (indexOf rest "/")
            if (slash < 0) {
                return (MdVegaRender.sheetCsv(rest "" "" ""))
            }
            return (MdVegaRender.sheetCsv((substring rest 0 slash) "" (substring rest (slash + 1) (strlen rest)) ""))
        }
        if (MdVegaRender.isSheetLink(url)) {
            return (MdVegaRender.sheetCsv(url "" "" ""))
        }
        return url
    }

    ; `sourceUrl` of a bare address (a ```table fence's file line).
    sfn resolveUrl:string (u:string) {
        def d:VlJson (VlJson.objectValue())
        d.setMember("url" (VlJson.stringValue(u)))
        return (MdVegaRender.sourceUrl(d))
    }

    ; A Google Sheets editing / viewing link (not already a CSV address or a
    ; "published to the web" one, which are fetched as they are).
    sfn isSheetLink:boolean (url:string) {
        if ((indexOf url "docs.google.com/spreadsheets/d/") < 0) {
            return false
        }
        if (((indexOf url "/gviz/") >= 0) || ((indexOf url "/export") >= 0)) {
            return false
        }
        if (((indexOf url "/spreadsheets/d/e/") >= 0) || ((indexOf url "/pub") >= 0)) {
            return false
        }
        return true
    }

    ; The CSV of a sheet: `idOrLink` is the spreadsheet's id or any link to
    ; it (a link's #gid= picks the tab when nothing else does); `range` may
    ; name the tab itself ("Monthly!A:B").
    sfn sheetCsv:string (idOrLink:string sheet0:string range0:string gid0:string) {
        def id:string (trim idOrLink)
        def gid:string gid0
        def at:int (indexOf id "/spreadsheets/d/")
        if (at >= 0) {
            def tail:string (substring id (at + 16) (strlen id))
            def g:int (indexOf tail "gid=")
            if (((strlen gid) == 0) && (g >= 0)) {
                def k:int (g + 4)
                def digits:string ""
                while ((k < (strlen tail)) && (((charAt tail k) >= 48) && ((charAt tail k) <= 57))) {
                    digits = (digits + (substring tail k (k + 1)))
                    k = (k + 1)
                }
                gid = digits
            }
            def e:int 0
            while ((e < (strlen tail)) && ((((charAt tail e) != 47) && ((charAt tail e) != 63)) && ((charAt tail e) != 35))) {
                e = (e + 1)
            }
            id = (substring tail 0 e)
        }
        def sheet:string (trim sheet0)
        def range:string (trim range0)
        def bang:int (indexOf range "!")
        if (bang >= 0) {
            if ((strlen sheet) == 0) {
                sheet = (substring range 0 bang)
            }
            range = (substring range (bang + 1) (strlen range))
        }
        ; 'My tab'!A:B
        if (((strlen sheet) > 1) && (((charAt sheet 0) == 39) && ((charAt sheet ((strlen sheet) - 1)) == 39))) {
            sheet = (substring sheet 1 ((strlen sheet) - 1))
        }
        def out:string (("https://docs.google.com/spreadsheets/d/" + id) + "/gviz/tq?tqx=out:csv&headers=1")
        if ((strlen sheet) > 0) {
            out = ((out + "&sheet=") + (MdVegaRender.queryPart(sheet)))
        } {
            if ((strlen gid) > 0) {
                out = ((out + "&gid=") + gid)
            }
        }
        if ((strlen range) > 0) {
            out = ((out + "&range=") + (MdVegaRender.queryPart(range)))
        }
        return out
    }

    ; A value for a URL's query: ASCII other than letters, digits and -_.~
    ; percent-encoded (the browser encodes the rest).
    sfn queryPart:string (s:string) {
        def hex:string "0123456789ABCDEF"
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def c:int (charAt s i)
            def keep:boolean ((c >= 128) || ((((c >= 48) && (c <= 57)) || ((c >= 65) && (c <= 90))) || (((c >= 97) && (c <= 122)) || (((c == 45) || (c == 95)) || ((c == 46) || (c == 126))))))
            if keep {
                out = (out + (substring s i (i + 1)))
            } {
                def hi:int (idiv c 16)
                def lo:int (c - (hi * 16))
                out = (((out + "%") + (substring hex hi (hi + 1))) + (substring hex lo (lo + 1)))
            }
            i = (i + 1)
        }
        return out
    }

    ; Data fetched from a CSV address: a .csv file, or an export
    ; (Google Sheets' out:csv / format=csv / output=csv).
    sfn csvUrl:boolean (url:string) {
        def lower:string (MdChar.lower(url))
        if ((indexOf lower ".csv") > 0) {
            return true
        }
        return ((((indexOf lower "out:csv") > 0) || ((indexOf lower "format=csv") > 0)) || ((indexOf lower "output=csv") > 0))
    }

    sfn urlsOf:[string] (text:string) {
        def out:[string]
        def file:string (MdVegaRender.specFile(text))
        if ((strlen file) > 0) {
            push out file
            return out
        }
        def p (new VlJsonParser())
        def spec:VlJson (p.parse(text))
        if (p.ok) {
            MdVegaRender.collectUrls(spec out)
        }
        return out
    }

    sfn collectUrls:void (v:VlJson out:[string]) {
        if (v.isArray()) {
            def i:int 0
            while (i < (v.count())) {
                MdVegaRender.collectUrls((v.at(i)) out)
                i = (i + 1)
            }
            return
        }
        if ((v.isObject()) == false) {
            return
        }
        def s:string (MdVegaRender.sourceUrl(v))
        if ((strlen s) > 0) {
            def seen:boolean false
            def k:int 0
            while (k < (array_length out)) {
                if ((itemAt out k) == s) {
                    seen = true
                }
                k = (k + 1)
            }
            if (seen == false) {
                push out s
            }
        }
        for v.keys key:string ki {
            if ((key == "data") || ((key == "layer") || ((key == "hconcat") || ((key == "vconcat") || ((key == "concat") || ((key == "spec") || ((key == "transform") || (key == "from")))))))) {
                MdVegaRender.collectUrls((v.get(key)) out)
            }
        }
    }

    ; The chart with each url data that `urls` / `texts` has a file for
    ; replaced by the file's rows: JSON (an array, or `format.property` of an
    ; object) or CSV / TSV (a header row; numbers read as numbers). A url
    ; nobody supplied is left as it is.
    sfn withFiles:string (text:string urls:[string] texts:[string]) {
        if ((array_length urls) == 0) {
            return text
        }
        if (((indexOf text "\"url\"") < 0) && ((indexOf text "\"source\"") < 0)) {
            return text
        }
        def p (new VlJsonParser())
        def spec:VlJson (p.parse(text))
        if ((p.ok == false) || ((spec.isObject()) == false)) {
            return text
        }
        if ((MdVegaRender.inlineFiles(spec urls texts)) == false) {
            return text
        }
        def w (new VlJsonWriter())
        return (w.write(spec))
    }

    sfn inlineFiles:boolean (v:VlJson urls:[string] texts:[string]) {
        def did:boolean false
        if (v.isArray()) {
            def i:int 0
            while (i < (v.count())) {
                if (MdVegaRender.inlineFiles((v.at(i)) urls texts)) {
                    did = true
                }
                i = (i + 1)
            }
            return did
        }
        if ((v.isObject()) == false) {
            return false
        }
        def d:VlJson (v.get("data"))
        if ((strlen (MdVegaRender.sourceUrl(d))) > 0) {
            def rows:VlJson (MdVegaRender.fileRows(d urls texts))
            if (rows.isArray()) {
                def nd (VlJson.objectValue())
                nd.setMember("values" rows)
                if (d.has("name")) {
                    nd.setMember("name" (d.get("name")))
                }
                v.setMember("data" nd)
                did = true
            }
        }
        for v.keys key:string ki {
            if ((key == "layer") || ((key == "hconcat") || ((key == "vconcat") || ((key == "concat") || ((key == "spec") || ((key == "transform") || (key == "from"))))))) {
                if (MdVegaRender.inlineFiles((v.get(key)) urls texts)) {
                    did = true
                }
            }
        }
        return did
    }

    sfn fileRows:VlJson (d:VlJson urls:[string] texts:[string]) {
        def url:string (MdVegaRender.sourceUrl(d))
        def i:int 0
        while (i < (array_length urls)) {
            if ((MdVegaRender.bareUrl((itemAt urls i))) == (MdVegaRender.bareUrl(url))) {
                def body:string (itemAt texts i)
                def fmt:VlJson (d.get("format"))
                def ftype:string (fmt.stringOr("type" ""))
                def lower:string (MdChar.lower(url))
                if ((ftype == "csv") || (((strlen ftype) == 0) && (MdVegaRender.csvUrl(url)))) {
                    return (MdVegaRender.delimited(body 44))
                }
                if ((ftype == "tsv") || (((strlen ftype) == 0) && ((indexOf lower ".tsv") > 0))) {
                    return (MdVegaRender.delimited(body 9))
                }
                def p (new VlJsonParser())
                def j:VlJson (p.parse(body))
                if (p.ok == false) {
                    return (VlJson.nullValue())
                }
                def prop:string (fmt.stringOr("property" ""))
                if ((strlen prop) > 0) {
                    return (j.get(prop))
                }
                return j
            }
            i = (i + 1)
        }
        return (VlJson.nullValue())
    }

    ; A header row and rows of cells, split on `sep`; a quoted cell may hold
    ; the separator. A cell that is a number is a number.
    sfn delimited:VlJson (body:string sep:int) {
        def out:VlJson (VlJson.arrayValue())
        def lines:[string] (strsplit body (strfromcode 10))
        if ((array_length lines) < 1) {
            return out
        }
        def head:[string] (MdVegaRender.cells((itemAt lines 0) sep))
        def r:int 1
        while (r < (array_length lines)) {
            def line:string (itemAt lines r)
            if ((strlen (trim line)) > 0) {
                def cs:[string] (MdVegaRender.cells(line sep))
                def row (VlJson.objectValue())
                def c:int 0
                while (c < (array_length head)) {
                    def cell:string ""
                    if (c < (array_length cs)) {
                        cell = (itemAt cs c)
                    }
                    def num@(optional):double (str2double cell)
                    if ((!null? num) && (MdVegaRender.numeric((trim cell)))) {
                        row.setMember((itemAt head c) (VlJson.numberValue((unwrap num))))
                    } {
                        row.setMember((itemAt head c) (VlJson.stringValue(cell)))
                    }
                    c = (c + 1)
                }
                push out.arr row
            }
            r = (r + 1)
        }
        return out
    }

    ; A whole number, and nothing after it: "12", "-3.5", "1e6". A date
    ; ("2012-01-01") starts like one and is not.
    sfn numeric:boolean (t:string) {
        def n:int (strlen t)
        if (n == 0) {
            return false
        }
        def i:int 0
        if (((charAt t 0) == 45) || ((charAt t 0) == 43)) {
            i = 1
        }
        def digits:int 0
        def dot:boolean false
        while (i < n) {
            def c:int (charAt t i)
            if ((c >= 48) && (c <= 57)) {
                digits = (digits + 1)
            } {
                if ((c == 46) && (dot == false)) {
                    dot = true
                } {
                    if (((c == 101) || (c == 69)) && (digits > 0)) {
                        ; the exponent: a sign, then digits to the end
                        def j:int (i + 1)
                        if ((j < n) && (((charAt t j) == 45) || ((charAt t j) == 43))) {
                            j = (j + 1)
                        }
                        if (j >= n) {
                            return false
                        }
                        while (j < n) {
                            if (((charAt t j) < 48) || ((charAt t j) > 57)) {
                                return false
                            }
                            j = (j + 1)
                        }
                        return true
                    }
                    return false
                }
            }
            i = (i + 1)
        }
        return (digits > 0)
    }

    sfn cells:[string] (line0:string sep:int) {
        def line:string line0
        if (((strlen line) > 0) && ((charAt line ((strlen line) - 1)) == 13)) {
            line = (substring line 0 ((strlen line) - 1))
        }
        def out:[string]
        def cur:string ""
        def quoted:boolean false
        def i:int 0
        def n:int (strlen line)
        while (i < n) {
            def ch:int (charAt line i)
            if quoted {
                if (ch == 34) {
                    if (((i + 1) < n) && ((charAt line (i + 1)) == 34)) {
                        cur = (cur + "\"")
                        i = (i + 1)
                    } {
                        quoted = false
                    }
                } {
                    cur = (cur + (substring line i (i + 1)))
                }
            } {
                if (ch == 34) {
                    quoted = true
                } {
                    if (ch == sep) {
                        push out cur
                        cur = ""
                    } {
                        cur = (cur + (substring line i (i + 1)))
                    }
                }
            }
            i = (i + 1)
        }
        push out cur
        return out
    }

    ; Two sets of defaults as one: `over`'s members win.
    sfn mergeDefaults:string (over:string under:string) {
        if ((strlen (trim over)) == 0) {
            return under
        }
        if ((strlen (trim under)) == 0) {
            return over
        }
        return (MdVegaRender.withDefaults(over under))
    }

    sfn layUnder:void (top:VlJson defs:VlJson) {
        for defs.keys k:string ki {
            def d:VlJson (defs.get(k))
            if ((top.has(k)) == false) {
                top.setMember(k d)
            } {
                def t:VlJson (top.get(k))
                if ((t.isObject()) && (d.isObject())) {
                    MdVegaRender.layUnder(t d)
                }
            }
        }
    }

    ; `"width": "container"` (or a `"height"` written so) is a chart asking
    ; the page for its size. Vela has no page to ask, so it answers with the
    ; reference's fallback: 300 for the WHOLE drawing, fitted (`fit-x`). A
    ; legend along the bottom wider than that leaves the plot no width at all:
    ; an empty chart with every label at the left edge. Here the size is
    ; dropped instead, which is what this renderer already reads as "fill the
    ; room" (see `grown`).
    sfn withoutContainer:string (text:string) {
        if ((indexOf text "\"container\"") < 0) {
            return text
        }
        def p (new VlJsonParser())
        def spec:VlJson (p.parse(text))
        if ((p.ok == false) || ((spec.isObject()) == false)) {
            return text
        }
        def changed:boolean false
        if ((spec.get("width")).isString()) {
            spec.removeMember("width")
            changed = true
        }
        if ((spec.get("height")).isString()) {
            spec.removeMember("height")
            changed = true
        }
        if (changed == false) {
            return text
        }
        def w (new VlJsonWriter())
        return (w.write(spec))
    }

    ; A chart drawn in a slide's room (`grownAsOne`), but a stated height
    ; is the height drawn: the chart editor's Height slider sets it apart
    ; from the width, and growing the two by one factor turned a lower
    ; height into a wider chart and left the height where the room stopped
    ; it. Only a chart taller than `maxH` is drawn shorter. With a stated
    ; width too the chart is drawn at its size; with no width it takes the
    ; room's width.
    sfn grown:string (text:string width:double pad:double most:double maxH:double) {
        ; A pie with no size is set square in its column (`sized`), and no
        ; taller than the room: the 360 it was given, with the chart's
        ; padding, ran out of a slide's 324 under its box.
        def pie:string (MdVegaRender.sized(text width pad))
        if (pie != text) {
            def pp (new VlJsonParser())
            def side:double ((pp.parse(pie)).doubleOr("height" 0.0))
            def pq (new VlJsonParser())
            def held:VlJson (pq.parse((MdVegaRender.heldTo(pie side maxH))))
            def hh:double (held.doubleOr("height" side))
            if (hh < side) {
                held.setMember("width" (VlJson.numberValue(hh)))
            }
            def pw (new VlJsonWriter())
            return (pw.write(held))
        }
        def p (new VlJsonParser())
        def spec:VlJson (p.parse(text))
        if ((p.ok == false) || ((spec.isObject()) == false)) {
            return text
        }
        def h:VlJson (spec.get("height"))
        if ((h.isNumber()) == false) {
            return (MdVegaRender.grownAsOne(text width pad most maxH))
        }
        def out:string text
        if (((spec.get("width")).isNumber()) == false) {
            out = (MdVegaRender.grownAsOne(text width pad most maxH))
        }
        return (MdVegaRender.heldTo(out h.num maxH))
    }

    ; `text` with its height `stated`, or what of it fits in `maxH` with
    ; the axes and the title under and over it. A chart of several views
    ; is left as it is (its height is per view).
    sfn heldTo:string (text:string stated:double maxH:double) {
        def p (new VlJsonParser())
        def spec:VlJson (p.parse(text))
        if ((p.ok == false) || ((spec.isObject()) == false)) {
            return text
        }
        if ((((spec.has("facet")) || (spec.has("repeat"))) || ((spec.has("concat")) || (spec.has("hconcat")))) || (spec.has("vconcat"))) {
            return text
        }
        def want:double stated
        if (maxH > 1.0) {
            def probe:VlJson ((new VlJsonParser()).parse(text))
            probe.setMember("height" (VlJson.numberValue(stated)))
            def compiler (new VlCompile())
            compiler.autoLabelAngle = true
            def rt (new VlRuntime())
            rt.autoLabelAngle = true
            rt.run((compiler.compileSpec(probe)))
            def vh:double (rt.viewHeight())
            def plotH:double rt.chartHeight
            ; a pie has no plot of axes: its height is the stated one
            if (plotH < 1.0) {
                plotH = stated
            }
            if ((plotH >= 1.0) && (vh > maxH)) {
                want = (to_double (to_int (maxH - (vh - plotH))))
                if (want < (stated * 0.3)) {
                    want = (to_double (to_int (stated * 0.3)))
                }
            }
        }
        if ((spec.doubleOr("height" -1.0)) == want) {
            return text
        }
        spec.setMember("height" (VlJson.numberValue(want)))
        def w (new VlJsonWriter())
        return (w.write(spec))
    }

    ; A chart much narrower than its room, drawn larger: its plot's `width`
    ; and `height` asked for again, `most` times at most, so that the whole
    ; view (axes and legend included) comes to about the room's width. The
    ; words and lines keep their size — this is a bigger plot, not a zoomed
    ; picture. A chart of several views (facets, concatenation, repeat) is
    ; left as it is: its sizes are per view.
    sfn grownAsOne:string (text:string width:double pad:double most:double maxH:double) {
        def p (new VlJsonParser())
        def spec:VlJson (p.parse(text))
        if ((p.ok == false) || ((spec.isObject()) == false)) {
            return text
        }
        if ((((spec.has("facet")) || (spec.has("repeat"))) || ((spec.has("concat")) || (spec.has("hconcat")))) || (spec.has("vconcat"))) {
            return text
        }
        def enc:VlJson (spec.get("encoding"))
        if ((enc.isObject()) && (((enc.has("row")) || (enc.has("column"))) || (enc.has("facet")))) {
            return text
        }
        def compiler (new VlCompile())
        compiler.autoLabelAngle = true
        def vg:VlJson (compiler.compileSpec(spec))
        def rt (new VlRuntime())
        rt.autoLabelAngle = true
        rt.run(vg)
        def viewW:double (rt.viewWidth())
        def plotW:double rt.chartWidth
        def plotH:double rt.chartHeight
        if (((viewW < 1.0) || (plotW < 1.0)) || (plotH < 1.0)) {
            return text
        }
        def avail:double ((width - (pad * 2.0)) * 0.95)
        ; A chart that names no width of its own takes the room's whole width,
        ; whatever its height may grow by: Vega-Lite's default for a discrete
        ; axis is 20 points a category, so seven months came out as a narrow
        ; column whose names overprinted, and growing both sides by the same
        ; factor kept it narrow. `"width": "container"` asks for the same
        ; thing in Vega-Lite's own words (Vela, with no page to measure,
        ; answers it with the default width). A pie keeps its square (see
        ; `sized`).
        def fill:boolean ((((spec.has("width")) == false) || ((spec.get("width")).isString())) && ((indexOf text "\"arc\"") < 0))
        def fw:double 1.0
        def f:double 1.0
        if (viewW < (avail * 0.8)) {
            fw = ((avail - (viewW - plotW)) / plotW)
            ; what is not plot is mostly axes, but a legend wider than the
            ; plot counts too, and a plot grown past it no longer pays for
            ; it: measured again at the width asked for, once
            if (fill && ((viewW - plotW) > plotW)) {
                def p2 (new VlJsonParser())
                def probe:VlJson (p2.parse(text))
                probe.setMember("width" (VlJson.numberValue((to_double (to_int (plotW * fw))))))
                def c2 (new VlCompile())
                c2.autoLabelAngle = true
                def rt2 (new VlRuntime())
                rt2.autoLabelAngle = true
                rt2.run((c2.compileSpec(probe)))
                def plot2:double rt2.chartWidth
                if (plot2 >= 1.0) {
                    def fw2:double ((avail - ((rt2.viewWidth()) - plot2)) / plotW)
                    if (fw2 > fw) {
                        fw = fw2
                    }
                }
            }
            f = fw
            if (f > most) {
                f = most
            }
        }
        ; and no taller than `maxH`, axes and title included: a chart taller
        ; than that (a long list of categories) is drawn shorter
        def viewH:double (rt.viewHeight())
        if ((maxH > 1.0) && (viewH > 1.0)) {
            def fh:double ((maxH - (viewH - plotH)) / plotH)
            if (fh < f) {
                if (fh < 1.0) {
                    ; only the height gives
                    if (fh < 0.3) {
                        fh = 0.3
                    }
                    if ((fh > 0.97) && ((fill == false) || (fw < 1.05))) {
                        return text
                    }
                    spec.setMember("height" (VlJson.numberValue((to_double (to_int (plotH * fh))))))
                    if (fill && (fw >= 1.05)) {
                        spec.setMember("width" (VlJson.numberValue((to_double (to_int (plotW * fw))))))
                    }
                    def w0 (new VlJsonWriter())
                    return (w0.write(spec))
                }
                f = fh
            }
        }
        if (fill == false) {
            fw = f
        }
        ; the words grow a little with it: a plot two and a half times the
        ; size with its legend at the old size reads as a small print
        def k:double (1.0 + ((f - 1.0) * 0.3))
        ; A chart that states no height takes the room's height, as a
        ; slide's figure does: Vega-Lite's 20 points a category left five
        ; rows of ticks a strip across the top of an empty slide. No taller
        ; than three quarters of its width (a chart in a column stays a
        ; chart), and never lower than its own proportions grown.
        def tallH:double (plotH * f)
        if ((((spec.has("height")) == false) && (maxH > 1.0)) && ((indexOf text "\"arc\"") < 0)) {
            def roomH:double (maxH - ((viewH - plotH) * k))
            def capH:double ((plotW * fw) * 0.75)
            if (roomH > capH) {
                roomH = capH
            }
            if (roomH > tallH) {
                tallH = roomH
            }
        }
        if (((f < 1.05) && (fw < 1.05)) && (tallH < (plotH * 1.05))) {
            return text
        }
        spec.setMember("width" (VlJson.numberValue((to_double (to_int (plotW * fw))))))
        spec.setMember("height" (VlJson.numberValue((to_double (to_int tallH)))))
        MdVegaRender.growWords(spec k)
        def w (new VlJsonWriter())
        return (w.write(spec))
    }

    ; Where the chart sits in its column: `usermeta.presAlign` ("center",
    ; "end"; "" the start). CSS words are taken too: "flex-end", "right".
    sfn alignOf:string (text:string) {
        def p (new VlJsonParser())
        def spec:VlJson (p.parse(text))
        if ((p.ok == false) || ((spec.isObject()) == false)) {
            return ""
        }
        def meta:VlJson (spec.get("usermeta"))
        if ((meta.isObject()) == false) {
            return ""
        }
        def a:string (meta.stringOr("presAlign" ""))
        if ((a == "center") || (a == "centre")) {
            return "center"
        }
        if (((a == "end") || (a == "flex-end")) || (a == "right")) {
            return "end"
        }
        return ""
    }

    ; A legend's or an axis's words cut at a length in points (Vega-Lite's
    ; `titleLimit` 180 and `labelLimit` 160 for a legend, `labelLimit` 180
    ; for an axis) are measured at its own small type, 11 and 10 points. A
    ; theme or a grown chart sets them larger, and the same limit then cut
    ; a word as short as "Vuosineljännes" though the slide had the room:
    ; a limit the chart does not state grows with its type.
    sfn limitsByFont:string (text:string) {
        if ((indexOf text "FontSize") < 0) {
            return text
        }
        def p (new VlJsonParser())
        def spec:VlJson (p.parse(text))
        if ((p.ok == false) || ((spec.isObject()) == false)) {
            return text
        }
        def cfg:VlJson (spec.get("config"))
        if ((cfg.isObject()) == false) {
            return text
        }
        def changed:boolean false
        def lg:VlJson (cfg.get("legend"))
        if (lg.isObject()) {
            if (MdVegaRender.limitByFont(lg "titleLimit" 180.0 "titleFontSize" 11.0)) {
                changed = true
            }
            if (MdVegaRender.limitByFont(lg "labelLimit" 160.0 "labelFontSize" 10.0)) {
                changed = true
            }
        }
        def ax:VlJson (cfg.get("axis"))
        if (ax.isObject()) {
            if (MdVegaRender.limitByFont(ax "labelLimit" 180.0 "labelFontSize" 10.0)) {
                changed = true
            }
        }
        if (changed == false) {
            return text
        }
        def w (new VlJsonWriter())
        return (w.write(spec))
    }

    sfn limitByFont:boolean (g:VlJson limitKey:string limit:double fontKey:string font:double) {
        if (g.has(limitKey)) {
            return false
        }
        def size:VlJson (g.get(fontKey))
        if (((size.isNumber()) == false) || (size.num <= font)) {
            return false
        }
        g.setMember(limitKey (VlJson.numberValue((to_double (to_int (((limit * size.num) / font) + 0.5))))))
        return true
    }

    sfn growWords:void (spec:VlJson k:double) {
        def cfg:VlJson (spec.get("config"))
        if ((cfg.isObject()) == false) {
            cfg = (VlJson.objectValue())
            spec.setMember("config" cfg)
        }
        def names:[string] (strsplit "axis legend" " ")
        def i:int 0
        while (i < (array_length names)) {
            def g:VlJson (cfg.get((itemAt names i)))
            if ((g.isObject()) == false) {
                g = (VlJson.objectValue())
                cfg.setMember((itemAt names i) g)
            }
            MdVegaRender.growNumber(g "labelFontSize" 10.0 k)
            MdVegaRender.growNumber(g "titleFontSize" 11.0 k)
            i = (i + 1)
        }
    }

    sfn growNumber:void (g:VlJson key:string dflt:double k:double) {
        def v:double dflt
        def got:VlJson (g.get(key))
        if (got.isNumber()) {
            v = got.num
        }
        g.setMember(key (VlJson.numberValue((to_double (to_int ((v * k) + 0.5))))))
    }

    sfn draw:MdVegaDrawing (text:string width:double pad:double) {
        def out (new MdVegaDrawing())
        def file:string (MdVegaRender.specFile(text))
        if ((strlen file) > 0) {
            out.error = ("the chart is in " + file + ", which has not arrived")
            return out
        }
        def parser (new VlJsonParser())
        def spec:VlJson (parser.parse((MdVegaRender.sized(text width pad))))
        if (parser.ok == false) {
            out.error = "that is not JSON"
            return out
        }
        ; `compileSpec` takes Vega-Lite to Vega and passes Vega through, so one
        ; door serves both and a reader does not have to know which they wrote.
        def compiler (new VlCompile())
        ; Level labels while they fit, turned when they do not — rather than
        ; Vega-Lite's answer for a discrete bottom axis, which is to stand every
        ; category name on end whatever the room. See `VlCompile.autoLabelAngle`
        ; and `VlAxis.angleThatFits`.
        compiler.autoLabelAngle = true
        def vg:VlJson (compiler.compileSpec(spec))
        def rt (new VlRuntime())
        ; A document is not a comparison. Vega leaves crowded category names
        ; level and lets them overprint; on a printed page that is a row of
        ; words a reader cannot separate, so the axis turns them instead. A
        ; spec that states its own `labelAngle` still gets what it asked for.
        rt.autoLabelAngle = true
        def mark:VlSceneMark (rt.run(vg))
        def list:VlCommandList (VlSceneCommands.build(mark))
        if ((array_length list.commands) == 0) {
            out.error = "the spec produced no marks"
            return out
        }
        MdVegaRender.namedColours(list)

        def viewW:double (rt.viewWidth())
        def viewH:double (rt.viewHeight())
        if (viewW < 1.0) {
            viewW = 400.0
        }
        if (viewH < 1.0) {
            viewH = 300.0
        }
        def avail:double (width - (pad * 2.0))
        if (avail < 1.0) {
            avail = viewW
        }
        def scale:double (avail / viewW)
        ; Never enlarged. A 200-point chart blown up to a 700-point column is
        ; a chart with 3.5x line weights and text that looks like a heading.
        if (scale > 1.0) {
            scale = 1.0
        }

        def sc:FlowScene out.scene
        sc.worldX = 0.0
        sc.worldY = 0.0
        sc.worldW = ((viewW * scale) + (pad * 2.0))
        sc.worldH = ((viewH * scale) + (pad * 2.0))

        ; A command's coordinates are the PLOT's, not the view's: the plot
        ; rectangle starts at zero and the y axis' labels sit at negative x,
        ; out to the left of it. The view is the plot plus what the axes take,
        ; so the offset has to be added back or the axis labels land outside
        ; the scene — which is exactly what happened: a chart whose numbers
        ; were cut off at the left edge and whose caption sat against the
        ; wrong side of it.
        def padX:double (pad + ((rt.plotOriginX()) * scale))
        def padY:double (pad + ((rt.plotOriginY()) * scale))

        def i:int 0
        while (i < (array_length list.commands)) {
            def c:VlDrawCommand (itemAt list.commands i)
            if (c.hidden == false) {
                MdVegaRender.emit(out c scale padX padY)
            }
            i = (i + 1)
        }
        ; …and then the world is fitted to what was actually drawn. The view
        ; Vela reports is the plot plus what each axis reserves ACROSS itself,
        ; which is the right answer for level labels and short of it for turned
        ; ones: a label on a slant reaches sideways as well as down, and the
        ; first category of a crowded axis reached off the left of the page.
        MdVegaRender.fit(sc pad)
        out.ok = true
        return out
    }

    ; Grow the scene's world rectangle until everything drawn is inside it.
    ;
    ; Nothing is moved: `FlowScene` draws its items against `worldX`/`worldY`,
    ; so widening the world to the left is the same thing as shifting the
    ; contents right, and it cannot get an item's own geometry wrong the way a
    ; pass that rewrote every coordinate could.
    sfn fit:void (sc:FlowScene pad:double) {
        def n:int (array_length sc.items)
        if (n == 0) {
            return
        }
        def minX:double 0.0
        def minY:double 0.0
        def maxX:double 0.0
        def maxY:double 0.0
        def first:boolean true
        def i:int 0
        while (i < n) {
            def it:SceneItem (itemAt sc.items i)
            def box:[double] (MdVegaRender.boundsOf(it))
            def bx0:double (itemAt box 0)
            def by0:double (itemAt box 1)
            def bx1:double (itemAt box 2)
            def by1:double (itemAt box 3)
            if first {
                minX = bx0
                minY = by0
                maxX = bx1
                maxY = by1
                first = false
            } {
                if (bx0 < minX) { minX = bx0 }
                if (by0 < minY) { minY = by0 }
                if (bx1 > maxX) { maxX = bx1 }
                if (by1 > maxY) { maxY = by1 }
            }
            i = (i + 1)
        }
        ; Only what is OUTSIDE grows the world, and it brings the padding with
        ; it. Widening to `minX - pad` unconditionally reserved a second margin
        ; beside a chart that already fitted, so every chart came out a little
        ; wider than the width it was asked for.
        if (minX < sc.worldX) {
            def lo:double (minX - pad)
            sc.worldW = (sc.worldW + (sc.worldX - lo))
            sc.worldX = lo
        }
        if (minY < sc.worldY) {
            def top:double (minY - pad)
            sc.worldH = (sc.worldH + (sc.worldY - top))
            sc.worldY = top
        }
        if (maxX > (sc.worldX + sc.worldW)) {
            sc.worldW = ((maxX + pad) - sc.worldX)
        }
        if (maxY > (sc.worldY + sc.worldH)) {
            sc.worldH = ((maxY + pad) - sc.worldY)
        }
    }

    ; What one item covers, as [x0 y0 x1 y1] — and for a TURNED one, the box
    ; its four corners need once they have been carried round the pivot, which
    ; is the whole reason this exists: a label on a slant reaches down and to
    ; the side, and its upright box says neither.
    sfn boundsOf:[double] (it:SceneItem) {
        def w:double it.w
        def h:double it.h
        def x:double it.x
        if (it.kind == 1) {
            h = (it.fontSize * 1.25)
            ; The INK, not the box. A label's box is deliberately wider than
            ; its string — see `emit`, where the width is an estimate and the
            ; estimate has to be generous — so measuring the page by the boxes
            ; would reserve a margin of empty space beside every chart and
            ; shrink the drawing to make room for it.
            def ink:double ((VlText.drawWidth(it.text it.fontSize)) * 1.25)
            if (ink > w) {
                ink = w
            }
            if (it.align == "center") {
                x = (it.x + ((w - ink) * 0.5))
            }
            if (it.align == "right") {
                x = ((it.x + w) - ink)
            }
            w = ink
        }
        def out:[double]
        if (it.angle == 0.0) {
            push out x
            push out it.y
            push out (x + w)
            push out (it.y + h)
            return out
        }
        def ox:double (it.x + (it.w * 0.5))
        def oy:double (it.y + (h * 0.5))
        if it.hasOrigin {
            ox = (it.x + it.originX)
            oy = (it.y + it.originY)
        }
        def rad:double ((it.angle * 3.141592653589793) / 180.0)
        def cs:double (cos rad)
        def sn:double (sin rad)
        def xs:[double]
        def ys:[double]
        def cx:int 0
        while (cx < 2) {
            def cy:int 0
            while (cy < 2) {
                def px:double (x + ((to_double cx) * w))
                def py:double (it.y + ((to_double cy) * h))
                def dx:double (px - ox)
                def dy:double (py - oy)
                push xs (ox + ((dx * cs) - (dy * sn)))
                push ys (oy + ((dx * sn) + (dy * cs)))
                cy = (cy + 1)
            }
            cx = (cx + 1)
        }
        def x0:double (itemAt xs 0)
        def y0:double (itemAt ys 0)
        def x1:double x0
        def y1:double y0
        def k:int 1
        while (k < (array_length xs)) {
            def vx:double (itemAt xs k)
            def vy:double (itemAt ys k)
            if (vx < x0) { x0 = vx }
            if (vx > x1) { x1 = vx }
            if (vy < y0) { y0 = vy }
            if (vy > y1) { y1 = vy }
            k = (k + 1)
        }
        push out x0
        push out y0
        push out x1
        push out y1
        return out
    }

    ; The points of a line drawn with `interpolate`, as a polyline: the shape
    ; VlShape builds for it, each cubic cut into short straight pieces.
    sfn curvePoints:[double] (pts:[double] interpolate:string tension:double) {
        def b (new PathBuilder())
        VlShape.appendCurve(b pts interpolate tension false)
        def out:[double]
        def cmds:[PathCommand] (b.getCommands())
        def cx:double 0.0
        def cy:double 0.0
        def i:int 0
        while (i < (array_length cmds)) {
            def k:PathCommand (itemAt cmds i)
            if ((k.type == "M") || (k.type == "L")) {
                push out k.x
                push out k.y
                cx = k.x
                cy = k.y
            }
            if (k.type == "C") {
                def st:int 1
                while (st <= 12) {
                    def t:double ((to_double st) / 12.0)
                    def u:double (1.0 - t)
                    def a:double ((u * u) * u)
                    def bq:double ((3.0 * (u * u)) * t)
                    def cq:double ((3.0 * u) * (t * t))
                    def d:double ((t * t) * t)
                    push out ((((a * cx) + (bq * k.x1)) + (cq * k.x2)) + (d * k.x))
                    push out ((((a * cy) + (bq * k.y1)) + (cq * k.y2)) + (d * k.y))
                    st = (st + 1)
                }
                cx = k.x
                cy = k.y
            }
            if (k.type == "Q") {
                def sq:int 1
                while (sq <= 10) {
                    def t2:double ((to_double sq) / 10.0)
                    def u2:double (1.0 - t2)
                    push out ((((u2 * u2) * cx) + (((2.0 * u2) * t2) * k.x1)) + ((t2 * t2) * k.x))
                    push out ((((u2 * u2) * cy) + (((2.0 * u2) * t2) * k.y1)) + ((t2 * t2) * k.y))
                    sq = (sq + 1)
                }
                cx = k.x
                cy = k.y
            }
            i = (i + 1)
        }
        if ((array_length out) < 4) {
            return pts
        }
        return out
    }

    sfn emit:void (out:MdVegaDrawing c:VlDrawCommand scale:double padX:double padY:double) {
        def sc:FlowScene out.scene
        if (c.op == "rect") {
            def x:double (padX + (c.x * scale))
            def y:double (padY + (c.y * scale))
            def w:double (c.width * scale)
            def h:double (c.height * scale)
            ; A bar rounded to nothing is still a bar, but a bar with no size
            ; is a gap in the chart — the runtime produces hairline rects for
            ; rules and gridlines and they have to stay visible.
            if (w < 0.5) {
                w = 0.5
            }
            if (h < 0.5) {
                h = 0.5
            }
            ; No fill means NO fill. Inventing one here painted the plot frame
            ; — a rect with a stroke and an empty `fill` — solid blue across
            ; the whole chart, which read as one enormous bar covering the
            ; data. A default colour is a guess, and a guess that draws is
            ; worse than one that does not.
            if (c.hasFill == false) {
                if (c.hasStroke == false) {
                    return
                }
            }
            def r:SceneItem (sc.rect(x y w h (MdVegaRender.fillOf(c))))
            r.opacity = (c.opacity * c.fillOpacity)
            if (c.cornerTL > 0.0) {
                r.radius = (c.cornerTL * scale)
            }
            if c.hasStroke {
                r.stroke = c.stroke
                r.strokeWidth = (c.strokeWidth * scale)
            }
            r.tag = "chart"
            return
        }
        if (c.op == "text") {
            def tx:double (padX + ((c.x + c.dx) * scale))
            def ty:double (padY + ((c.y + c.dy) * scale))
            def size:double (c.fontSize * scale)
            ; Text is the one mark that needs a colour when it names none:
            ; a label with no fill is invisible, and Vega's own default for
            ; text is black rather than nothing.
            def ink:string (MdVegaRender.fillOf(c))
            if ((strlen ink) == 0) {
                ink = "#000000"
            }
            ; Vega ANCHORS a string at a point and says which way it hangs off
            ; it; a scene item ALIGNS a string inside a box. An axis label
            ; carrying `align: center` into a box of width zero comes out
            ; left-aligned at the tick — every category name drawn half its own
            ; width to the right of the bar it names, which is what the first
            ; chart through this door did.
            def al:string (MdVegaRender.align(c.align))
            def wide:double (VlText.drawWidth(c.text size))
            ; The box must never be NARROWER than the glyphs. `drawWidth` is an
            ; ESTIMATE — one advance table for every sans face — and the face
            ; that ends up drawing is wider than it by a third for lowercase
            ; text, so a box measured to the estimate clips: "markdown" came
            ; out as "markdo" on the first chart that had a long category in
            ; it. Generous, therefore, and deliberately: an empty box paints
            ; nothing, so the only cost of one too wide is nothing at all,
            ; while one too narrow eats the end of a word. The ANCHOR stays
            ; exact whatever the box is, because the alignment is what places
            ; the string inside it — a right-aligned label ends at its tick
            ; whether its box is forty pixels wide or four hundred.
            def boxW:double ((wide * 2.0) + size)
            def left:double tx
            if (al == "center") {
                left = (tx - (boxW * 0.5))
            }
            if (al == "right") {
                left = (tx - boxW)
            }
            ; Vega places text on a BASELINE and names which one; a scene item
            ; places it on the top of its line box. Taking every string for an
            ; alphabetic baseline put the bottom axis' labels four fifths of a
            ; line high, over the ticks they belong under.
            def top:double (MdVegaRender.topOf(ty size c.baseline))
            def t:SceneItem (sc.text(c.text left top boxW size ink))
            t.align = al
            ; The box is an estimate; the label is not. A chart's runtime has
            ; already decided where this string breaks, so the box may place it
            ; but must never rewrap it.
            t.nowrap = true
            ; Turned labels: an axis too crowded to write its categories flat
            ; writes them on a slant, and the scene item turns about the same
            ; anchor Vega rotates about — its own box, which is why the box
            ; above has to be the label's and not the column's.
            if (c.angle != 0.0) {
                t.angle = c.angle
                t.originX = (tx - left)
                t.originY = (ty - top)
                t.hasOrigin = true
            }
            if (c.fontWeight == "bold") {
                t.bold = true
            }
            if ((strlen c.font) > 0) {
                t.fontFamily = c.font
            }
            t.opacity = c.opacity
            t.tag = "chart"
            return
        }
        if (c.op == "path") {
            if ((strlen c.pathData) == 0) {
                push out.skipped c.op
                return
            }
            def none:[double]
            def p:SceneItem (sc.path(none c.pathData (MdVegaRender.stroke(c)) (c.strokeWidth * scale)))
            p.tag = "chart"
            ; A path's own coordinates are the runtime's, so the scene item
            ; carries the offset rather than the points being rewritten.
            p.x = padX
            p.y = padY
            if c.hasFill {
                p.fill = c.fill
            }
            return
        }
        ; A group is a coordinate system, not a shape. Its children already
        ; carry its offset, so there is nothing here to draw — and nothing to
        ; report either: counted as marks this could not draw, every chart
        ; arrived with two dozen apologies attached to it.
        if ((c.op == "group-begin") || (c.op == "group-end")) {
            return
        }
        if (((c.op == "line") || (c.op == "polyline")) || (c.op == "trail")) {
            def pts:[double] (MdVegaRender.pointsOf(c scale padX padY))
            ; A SEGMENT — one tick, one axis rule — is two points Vega writes
            ; as `x,y` and `x2,y2` rather than as a list. Read as a list it is
            ; empty, and every axis came out with no ticks and no domain line
            ; while the labels beside them were drawn.
            if ((array_length pts) == 0) {
                push pts (padX + (c.x * scale))
                push pts (padY + (c.y * scale))
                push pts (padX + (c.x2 * scale))
                push pts (padY + (c.y2 * scale))
            }
            if ((array_length pts) < 4) {
                push out.skipped c.op
                return
            }
            ; A curve ("monotone", "basis", …) or steps: the runtime's own
            ; shape, sampled into the polyline a scene draws. Drawn through
            ; its data points only, a "smooth" line came out straight.
            if (((c.op == "polyline") || (c.op == "line")) && (((strlen c.interpolate) > 0) && (c.interpolate != "linear"))) {
                pts = (MdVegaRender.curvePoints(pts c.interpolate c.tension))
            }
            def l:SceneItem (sc.path(pts "" (MdVegaRender.stroke(c)) (c.strokeWidth * scale)))
            l.d = (FlowScene.polygonPath(l.pts false))
            l.opacity = c.opacity
            l.tag = "chart"
            return
        }
        if (c.op == "polygon") {
            def poly:[double] (MdVegaRender.pointsOf(c scale padX padY))
            if ((array_length poly) < 6) {
                push out.skipped c.op
                return
            }
            if (c.hasFill == false) {
                push out.skipped c.op
                return
            }
            def g:SceneItem (sc.polygon(poly (MdVegaRender.fillOf(c))))
            g.opacity = (c.opacity * c.fillOpacity)
            g.tag = "chart"
            return
        }
        if (c.op == "symbol") {
            ; A point mark. Its `size` is an AREA in Vega, which is why this
            ; takes a square root rather than treating it as a width — a
            ; scatter plot sized by the number would have dots an order of
            ; magnitude too big.
            def side:double ((MdVegaRender.squareRoot(c.size)) * scale)
            if (side < 1.0) {
                side = 1.0
            }
            def half:double (side * 0.5)
            def sx:double ((padX + (c.x * scale)) - half)
            def sy:double ((padY + (c.y * scale)) - half)
            def s:SceneItem (sc.rect(sx sy side side (MdVegaRender.fillOf(c))))
            if (c.shape != "square") {
                s.radius = half
            }
            s.opacity = (c.opacity * c.fillOpacity)
            if c.hasStroke {
                s.stroke = c.stroke
                s.strokeWidth = (c.strokeWidth * scale)
            }
            s.tag = "chart"
            return
        }
        if (c.op == "arc") {
            ; A pie's or a donut's slice: the outer edge from the start angle
            ; to the end, back along the inner edge (or through the centre),
            ; as Vega measures it — radians from twelve o'clock, clockwise.
            def ring:[double] (MdVegaRender.arcPoints(c scale padX padY))
            if ((array_length ring) < 6) {
                push out.skipped c.op
                return
            }
            if ((c.hasFill == false) && (c.hasStroke == false)) {
                return
            }
            def slice:SceneItem (sc.polygon(ring (MdVegaRender.fillOf(c))))
            if (c.hasFill == false) {
                slice.fill = ""
            }
            slice.opacity = (c.opacity * c.fillOpacity)
            if c.hasStroke {
                slice.stroke = c.stroke
                slice.strokeWidth = (c.strokeWidth * scale)
            }
            slice.tag = "chart"
            return
        }
        ; A mark drawn as anything else is a wrong chart, and a wrong chart is
        ; worse than an absent one because nobody checks it.
        push out.skipped c.op
    }

    sfn arcPoints:[double] (c:VlDrawCommand scale:double padX:double padY:double) {
        def out:[double]
        def a0:double c.startAngle
        def a1:double c.endAngle
        if (a1 < a0) {
            def swap:double a0
            a0 = a1
            a1 = swap
        }
        def ro:double (c.outerRadius * scale)
        def ri:double (c.innerRadius * scale)
        if (ro <= 0.0) {
            return out
        }
        def cx:double (padX + (c.x * scale))
        def cy:double (padY + (c.y * scale))
        def span:double (a1 - a0)
        def steps:int (to_int ((span / 0.04) + 1.0))
        if (steps < 2) { steps = 2 }
        if (steps > 400) { steps = 400 }
        def k:int 0
        while (k <= steps) {
            def a:double (a0 + ((span * (to_double k)) / (to_double steps)))
            push out (cx + ((sin a) * ro))
            push out (cy - ((cos a) * ro))
            k = (k + 1)
        }
        if (ri > 0.0) {
            def j:int steps
            while (j >= 0) {
                def a2:double (a0 + ((span * (to_double j)) / (to_double steps)))
                push out (cx + ((sin a2) * ri))
                push out (cy - ((cos a2) * ri))
                j = (j - 1)
            }
        } {
            push out cx
            push out cy
        }
        return out
    }

    sfn pointsOf:[double] (c:VlDrawCommand scale:double padX:double padY:double) {
        def out:[double]
        def i:int 0
        while ((i + 1) < (array_length c.points)) {
            push out (padX + ((itemAt c.points i) * scale))
            push out (padY + ((itemAt c.points (i + 1)) * scale))
            i = (i + 2)
        }
        return out
    }

    ; The command's own fill, or "" when it has none. Never a substitute.
    ; A colour by name (`"color": "firebrick"`) as hex: the scene below reads
    ; hex and rgb() only, and a line painted with a name it did not know was
    ; not drawn at all.
    sfn namedColours:void (list:VlCommandList) {
        def names:DotColors (new DotColors)
        def i:int 0
        while (i < (array_length list.commands)) {
            def c:VlDrawCommand (itemAt list.commands i)
            c.fill = (MdVegaRender.cssColour(names c.fill))
            c.stroke = (MdVegaRender.cssColour(names c.stroke))
            i = (i + 1)
        }
    }

    sfn cssColour:string (names:DotColors v:string) {
        if ((strlen v) == 0) {
            return v
        }
        def first:int (charAt v 0)
        if ((first == 35) || ((indexOf v "(") >= 0)) {
            return v
        }
        def k:string (to_lowercase v)
        if (k == "transparent") {
            return v
        }
        ; where CSS and X11 name different colours, CSS
        if (k == "green") { return "#008000" }
        if ((k == "gray") || (k == "grey")) { return "#808080" }
        if (k == "maroon") { return "#800000" }
        if (k == "purple") { return "#800080" }
        def hex:string (names.hex(k))
        if ((strlen hex) > 0) {
            return hex
        }
        return v
    }

    sfn fillOf:string (c:VlDrawCommand) {
        if (c.hasFill == false) {
            return ""
        }
        return c.fill
    }

    sfn stroke:string (c:VlDrawCommand) {
        if c.hasStroke {
            if ((strlen c.stroke) > 0) {
                return c.stroke
            }
        }
        return "#333333"
    }

    ; Where the top of a scene item's line box goes, for the baseline Vega
    ; named. `middle` is a y-axis label centred on its tick, `top` a bottom-axis
    ; label hanging under the plot, `bottom` a title sitting on a line.
    sfn topOf:double (y:double size:double baseline:string) {
        if (baseline == "top") {
            return y
        }
        if (baseline == "middle") {
            return (y - (size * 0.5))
        }
        if (baseline == "bottom") {
            return (y - size)
        }
        ; "alphabetic", and anything this does not know: the baseline sits about
        ; four fifths of the way down the em box.
        return (y - (size * 0.8))
    }

    sfn align:string (a:string) {
        if (a == "center") {
            return "center"
        }
        if (a == "right") {
            return "right"
        }
        return "left"
    }

    ; Newton's method, because there is no `sqrt` to reach for here and a
    ; symbol's side is the only thing that needs one.
    sfn squareRoot:double (v:double) {
        if (v <= 0.0) {
            return 0.0
        }
        def x:double v
        def i:int 0
        while (i < 24) {
            x = ((x + (v / x)) * 0.5)
            i = (i + 1)
        }
        return x
    }
}

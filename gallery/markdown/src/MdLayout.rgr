; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MdLayout.rgr — the AST, laid out. Boxes with coordinates, and nothing drawn.
; ============================================================================
;
; This is the half the viewer actually uses. `MdToHtml` exists so the parser
; can be scored against a specification; this exists so the document can be
; PRINTED and DRAWN, which is a different problem with a different answer:
; there is no DOM under it, so the position of every line is decided here.
;
;   MdNode tree ──► MdLayout ──► [MdBox] ──► MdToEvg ──► EVGElement
;                                                          │
;                                        ┌─────────────────┴───────────────┐
;                                        ▼                                 ▼
;                                EVGPDFRenderer                   EVGDisplayList
;                                    → PDF                          → WebGL
;
; **The one thing EVG could not already do.** `EVGTextEngine.breakLines`
; breaks a paragraph of ONE font at ONE size. A markdown paragraph is
;
;     some **bold** words and `code` and *italic*
;
; — one line, four faces, and the break has to be found across all of them.
; `breakRuns` below is that: the same greedy algorithm, with the accumulator
; carrying a change of face instead of only a width, and each SEGMENT
; measured whole so the real advance of a space inside a run is included
; rather than guessed. A line's height and baseline are the maximum over its
; segments, so a 9pt code span inside 11pt prose sits on the right baseline
; instead of half a line up.
;
; Everything is in POINTS, because the output that cannot be re-flowed later
; is the PDF. The screen scales; the page does not.
; ============================================================================

Import "MdNode.rgr"
Import "MdStyle.rgr"
Import "MdChar.rgr"
Import "MdEmbed.rgr"
Import "MdEmbedKinds.rgr"
Import "../../vfs/src/Vfs.rgr"
Import "MdCodeHighlight.rgr"
Import "MdFrontMatter.rgr"
Import "MdCss.rgr"
Import "../../evg/EVGTextEngine.rgr"

; ----------------------------------------------------------------------------
; What the document looks like. Not a stylesheet yet — the values a stylesheet
; will set, in one place, so the layout never has a number written into it.
; ----------------------------------------------------------------------------
class MdRun {
    def text:string ""
    def family:string ""
    def size:double 11.0
    def bold:boolean false
    def italic:boolean false
    def color:string "#1f2328"
    ; inline code gets a tinted box behind it
    def code:boolean false
    ; a link's destination, kept so the viewer can hit-test it later
    def link:string ""
    ; a forced break — two spaces at the end of a line, or a backslash
    def hardBreak:boolean false
    ; Where this run's text came from, in the document — the span of the
    ; inline node it was made from. -1 when the node had none to give.
    ;
    ; It is carried rather than looked up because the run is where the text
    ; and the source stop being the same length: `&amp;` is one character of
    ; run text and five of source, so an offset INSIDE a run is exact only
    ; where the run is verbatim, and `srcEnd` is what stops an inexact one
    ; running off the end of the node it belongs to.
    def srcStart:int -1
    def srcEnd:int -1

    Constructor () {
    }

    ; The source span is NOT copied: a style is inherited by a child run and
    ; a position is not. Copying it is how `*a* b` would have had both runs
    ; claiming the same character.
    fn copyStyle:MdRun () {
        def r:MdRun (new MdRun())
        r.family = family
        r.size = size
        r.bold = bold
        r.italic = italic
        r.color = color
        r.code = code
        r.link = link
        return r
    }
}

; A run, placed.
class MdSeg {
    def text:string ""
    def family:string ""
    def size:double 11.0
    def bold:boolean false
    def italic:boolean false
    def color:string "#1f2328"
    def code:boolean false
    def link:string ""
    def x:double 0.0
    def w:double 0.0
    ; Where this placed piece of text starts in the document, and how much of
    ; the document it covers. This is the finest thing the layout knows, and
    ; it is what a click turns into a caret.
    def srcStart:int -1
    def srcLen:int 0

    Constructor () {
    }
}

class MdLine {
    def segs:[MdSeg]
    def width:double 0.0
    def height:double 0.0
    def ascent:double 0.0

    Constructor () {
    }
}

; One thing to draw. The layout produces a flat list of these and the EVG
; bridge turns each into an element; nothing above this file knows about
; markdown and nothing below it knows about layout.
class MdBox {
    ; 0 text, 1 filled rectangle, 2 rectangle outline, 3 an embed's slot
    def kind:int 0
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0
    def text:string ""
    def family:string "Open Sans"
    def size:double 11.0
    def bold:boolean false
    def italic:boolean false
    def color:string "#1f2328"
    def fill:string ""
    def stroke:string ""
    def strokeWidth:double 0.0
    def link:string ""
    ; the source of an embed, for whoever can draw it
    def embedKind:string ""
    def embedSource:string ""
    ; A PICTURE (kind 4): where its bytes are in the byte store, and how big
    ; they are in their own pixels. The layout names the picture and does not
    ; carry it, exactly as a display list does — whoever draws it asks the
    ; same `Vfs` the layout asked.
    def imagePath:string ""
    def imageAlt:string ""
    def imageNaturalW:int 0
    def imageNaturalH:int 0
    def page:int 0
    ; The character this box's block began at, in the source text. Stamped by
    ; the layout, not by the author: it is what lets a click on a drawing find
    ; a caret in the text a reader typed.
    def srcStart:int -1
    ; …and the character THIS BOX begins at, which is a different question.
    ; `srcStart` names the block, so every box of a paragraph carries the same
    ; one and a click could name the paragraph and nothing smaller. `segSrc`
    ; is the placed run's own start, so a click inside the box can be turned
    ; into an offset by measuring across it.
    def segSrc:int -1
    def segLen:int 0

    Constructor () {
    }

    fn copy:MdBox () {
        def b:MdBox (new MdBox())
        b.kind = kind
        b.x = x
        b.y = y
        b.w = w
        b.h = h
        b.text = text
        b.family = family
        b.size = size
        b.bold = bold
        b.italic = italic
        b.color = color
        b.fill = fill
        b.stroke = stroke
        b.strokeWidth = strokeWidth
        b.link = link
        b.embedKind = embedKind
        b.embedSource = embedSource
        b.imagePath = imagePath
        b.imageAlt = imageAlt
        b.imageNaturalW = imageNaturalW
        b.imageNaturalH = imageNaturalH
        b.page = page
        b.srcStart = srcStart
        b.segSrc = segSrc
        b.segLen = segLen
        return b
    }

    sfn text:MdBox (t:string x:double y:double w:double h:double) {
        def b:MdBox (new MdBox())
        b.kind = 0
        b.text = t
        b.x = x
        b.y = y
        b.w = w
        b.h = h
        return b
    }

    sfn rect:MdBox (x:double y:double w:double h:double fill:string) {
        def b:MdBox (new MdBox())
        b.kind = 1
        b.x = x
        b.y = y
        b.w = w
        b.h = h
        b.fill = fill
        return b
    }

    sfn outline:MdBox (x:double y:double w:double h:double stroke:string width:double) {
        def b:MdBox (new MdBox())
        b.kind = 2
        b.x = x
        b.y = y
        b.w = w
        b.h = h
        b.stroke = stroke
        b.strokeWidth = width
        return b
    }
}

class MdLayout {
    def style:MdStyle (new MdStyle())
    ; Built once per layout by `buildBoxIndex`: the first box of each block,
    ; by that block's source offset.
    def boxIndexAt:[string:int]
    def boxIndexReady:boolean false

    ; --- the per-block layout cache -------------------------------------------
    ;
    ; A keystroke changes ONE block and the other four hundred are laid out
    ; again for nothing. `markdown:bench` puts this repository's README at
    ; 22.7 ms to parse and 117.5 ms to lay out, so the parse is not the
    ; problem: measuring text is. The parse stays whole — it is cheap, and an
    ; incremental block parser is a second parser to keep in step with the
    ; first — and the LAYOUT is what remembers.
    ;
    ; A block's boxes are kept under the exact source text that produced them.
    ; An edit changes that text for one block and no other, so every other
    ; block hits, and a hit is an array copy with two numbers added to it: the
    ; y it now sits at, and how far its source moved.
    ;
    ; WHAT IT DOES NOT DO, stated rather than discovered:
    ;   * paged layout. A block's boxes there depend on where the page break
    ;     falls, which is not a property of the block. `armCache` refuses.
    ;   * documents with a table of contents. That is a two-pass layout whose
    ;     first pass exists to move the second, and a cache would serve the
    ;     first pass's answers to the second.
    ;   * anything below a top-level block. A list is one entry, not one per
    ;     item: the win is in the hundreds of blocks a long document has, and
    ;     the bookkeeping for nesting buys nothing on top of that.
    def cacheOn:boolean false
    def cacheKey:[string]
    ; …and the same keys as a map. A scan over the keys is O(blocks) per
    ; block, which is O(blocks²) per layout: fine for the thirteen a fixture
    ; has and 1.1 million string compares for the thousand in ISSUES.md,
    ; where it cost more than the layout it was saving.
    def cacheAt:[string:int]
    def cacheSrc:[int]
    def cacheTop:[double]
    def cacheHeight:[double]
    def cacheFrom:[int]
    def cacheCount:[int]
    def cacheBoxes:[MdBox]
    def cacheHits:int 0
    def cacheMisses:int 0
    ; Lay every block out BOTH ways and compare. A cache that disagrees with
    ; the layout it is caching shows a stale picture, which is the worst thing
    ; this feature can do and the one failure a screenshot cannot catch — so
    ; there is a mode that checks rather than trusts, and the edit suite runs
    ; with it on.
    def cacheAudit:boolean false
    def cacheFaults:int 0
    ; How many blocks the audit actually compared. Without it a suite that
    ; never reached the cache at all reports a clean audit, which is the
    ; §6 trap: a check that counts the wrong noun says the failure is fine.
    def cacheAudited:int 0
    def cacheFirstFault:string ""
    ; The text the tree was parsed from. The cache keys off each block's slice
    ; of it, so the layout has to be told: a tree does not carry the string it
    ; came from, only the offsets into it.
    def docSource:string ""
    ; The width every cached entry was measured at. A different one makes all
    ; of them wrong, and the cheap total answer is to throw the lot away.
    def cacheWidth:double (0.0 - 1.0)
    ; …and the style the cached boxes were measured with. A block's boxes are
    ; a function of its source AND of the style, and only the first was ever
    ; in the key — so switching the company template replayed boxes measured
    ; at the previous font size and drew the new one on top of them.
    def cacheStyleKey:string ""

    ; ----------------------------------------------------------------------
    ; The company template
    ; ----------------------------------------------------------------------
    ;
    ; Two questions, and they are different. `MdCss.applyTo(style)` answered
    ; the first one — how is the DOCUMENT set — before this layout began, and
    ; the answer is in `style` above. This is the second: what does the sheet
    ; say about THIS BLOCK, given its `{.classes}` and its `{#id}`.
    ;
    ; Only the layout can ask it, because only the layout is walking the
    ; blocks. It is asked once per block and the answer is thrown away, which
    ; is why the sheet is held here rather than resolved into the tree: the
    ; AST says what the document IS and must not learn what it looks like.
    def sheet:MdCss (new MdCss())
    def sheetText:string ""

    ; ----------------------------------------------------------------------
    ; Slides
    ; ----------------------------------------------------------------------
    ;
    ; A slide is a page with rules about where it breaks. `PLAN_SLIDES.md` §4,
    ; in this order, and the order is the whole design:
    ;
    ;   1  MANDATORY   `{.slide}`, or a heading at or above `splitLevel`
    ;   2  FORBIDDEN   `{.no-break}`
    ;   3  PREFERRED   any other heading, if the slide is more than half full
    ;   4  FALLBACK    overflow — which is what pagination already does
    ;
    ; …and one constraint that is not a break rule and is the thing that makes
    ; an automatic deck look hand-made: KEEP-WITH-NEXT, a heading is never the
    ; last thing on a slide.
    def slides:boolean false
    ; `#` only, at 1. `2` means `#` and `##` each start a slide.
    def splitLevel:int 1
    ; "split" | "shrink" | "clip" — what a slide too full of one block does.
    ; Only `split` is honoured; the other two are carried and reported, which
    ; is the rule the rest of the template binding is written to.
    def slideOverflow:string "split"
    ; How many times a BLOCK had to be cut across two slides. Printed rather
    ; than hidden: `book_slides.rgr` set that precedent, and a deck that
    ; silently drops the third bullet is worse than one that says it did.
    def slideOverflows:int 0
    ; The title of the slide being laid out, repeated at the top of a
    ; continuation slide so a reader knows what they are still looking at.
    def slideTitle:string ""
    def slideTitleLevel:int 0
    def engine:EVGTextEngine (new EVGTextEngine())
    def boxes:[MdBox]

    ; the cursor
    def cursorY:double 0.0
    def page:int 0
    def pageCount:int 1

    ; How many block quotes deep the walk is, which is what `baseRun` reads to
    ; decide the colour of ordinary text.
    def quoteDepth:int 0

    ; Inside an item of a TIGHT list, where a paragraph is not a paragraph.
    def inTightItem:boolean false
    ; How many lists deep. Only the outermost one is separated from what
    ; follows it — a nested list is followed by its parent's next item, not by
    ; a new block.
    def listDepth:int 0

    ; the column being filled
    def contentX:double 0.0
    def contentW:double 0.0
    def contentTop:double 0.0
    def contentBottom:double 0.0

    ; 0 means one page as tall as the document — the screen's mode.
    def paginate:boolean false

    ; What a handler prepared for the fenced diagrams in this document. Empty
    ; unless somebody filled it: the layout can lay a document out without
    ; one, and leaves a labelled slot where a diagram would have gone.
    def embeds:MdEmbedCache (new MdEmbedCache())
    ; Where a picture's bytes come from, and which folder the document is in.
    ;
    ; Empty by default and that is the honest default: `![alt](src)` draws as
    ; its ALT TEXT when nobody has the bytes, which is the most truthful thing
    ; to draw, and is what this did for every document before there was a byte
    ; store at all.
    def images:Vfs (new Vfs())
    def haveImages:boolean false
    def docDir:string "/"
    ; Pictures the document names and this layout could not find. Counted
    ; rather than hidden, like every other cost in this file.
    def missingImages:int 0

    ; The height the document turned out to be, in continuous mode.
    def documentHeight:double 0.0

    ; The block being laid out, so every box it emits can say where in the
    ; source it came from.
    def currentSrc:int -1

    ; The headings this document has, and the page each landed on. Collected
    ; while laying out; used by the table of contents on the pass after.
    def headText:[string]
    def headLevel:[int]
    def headPage:[int]
    def headY:[double]
    ; What a previous pass learned, so the table of contents can print page
    ; numbers that are right. All three, not just the pages: on the second
    ; pass the live tables above are still being filled in AS the contents
    ; print, so reading them there lists whatever has been seen so far —
    ; which is one heading.
    def knownPages:[int]
    def knownText:[string]
    def knownLevel:[int]
    def tocLines:int 0

    Constructor () {
    }

    fn setMeasurer:void (m:EVGTextMeasurer) {
        engine.setMeasurer(m)
        ; Everything cached was measured through the old one.
        this.dropCache()
    }

    ; ----------------------------------------------------------------------
    ; Entry points
    ; ----------------------------------------------------------------------

    ; Front matter into the look of the page. Called before either layout;
    ; a document with no front matter is unchanged by it.
    fn applyMeta:void (doc:MdNode) {
        def meta:MdMeta (MdFrontMatter.of(doc))
        if ((meta.count()) == 0) { return }
        def page:string (meta.get("page" ""))
        def plen:int (strlen page)
        if (plen > 0) {
            def pw:double style.pageWidth
            def ph:double style.pageHeight
            style.pageWidth = (MdFrontMatter.pageW(page pw ph))
            style.pageHeight = (MdFrontMatter.pageH(page ph pw))
        }
        def margin:string (meta.get("margin" ""))
        def mlen:int (strlen margin)
        if (mlen > 0) {
            style.margin = (MdFrontMatter.points(margin style.margin))
        }
        style.title = (meta.get("title" ""))
        style.runningHead = (MdChar.lower((meta.get("runninghead" ""))))
        style.pageNumbers = (MdChar.lower((meta.get("pagenumbers" ""))))
        style.wantToc = (meta.flag("toc" false))
        style.breakOnH1 = (meta.flag("breakonh1" false))
        if (meta.has("highlight")) {
            style.highlightCode = (meta.flag("highlight" true))
        }
    }

    ; One page, as tall as it needs to be. What the canvas scrolls.
    ; The template, as text. Parsed once here rather than on every layout.
    ; The DOCUMENT-level properties are applied by the caller, before this —
    ; see `MarkdownEdit.ensureLayout` for the order and why it is that order.
    ; Where pictures come from. Handed the store and the folder the document
    ; lives in, because `![](logo.png)` means "beside this document".
    fn setImages:void (v:Vfs dir:string) {
        images = v
        docDir = dir
        haveImages = true
        this.disarmCache()
    }

    fn setStyleSheet:void (css:string) {
        sheetText = css
        sheet = (new MdCss())
        sheet.addStyleSheet(css)
        this.dropCache()
    }

    ; What the sheet says about one block. Empty when there is no sheet,
    ; which is the common case and costs one selector match.
    fn styleOf:CssComputed (node:MdNode) {
        return (sheet.resolve(node))
    }

    ; Boxes measured with another style are boxes of another document — and
    ; the sheet is part of the style, because a `{.c3}` a sheet gives three
    ; columns to is different boxes from the same list under a sheet that
    ; does not.
    fn checkStyle:void () {
        def key:string ((style.fingerprint()) + sheetText)
        if (key != cacheStyleKey) {
            this.dropCache()
            cacheStyleKey = key
        }
    }

    fn layoutContinuous:void (doc:MdNode width:double) {
        if ((fabs (width - cacheWidth)) > 0.01) {
            this.dropCache()
            cacheWidth = width
        }
        this.checkStyle()
        clear boxes
        boxIndexReady = false
        this.resetHeadings()
        paginate = false
        page = 0
        pageCount = 1
        contentX = style.margin
        contentW = (width - (style.margin * 2.0))
        contentTop = style.margin
        contentBottom = 0.0
        cursorY = contentTop
        this.layoutBody(doc)
        documentHeight = (cursorY + style.margin)
    }

    ; The same sheets, with the breaks a DECK wants rather than the ones a
    ; document wants. Everything below `bodyPass` is `layoutPaged`'s; what is
    ; different is `slideBreakBefore`, which is asked between blocks.
    fn layoutSlides:void (doc:MdNode) {
        slides = true
        slideOverflows = 0
        slideTitle = ""
        slideTitleLevel = 0
        this.layoutPaged(doc)
        slides = false
    }

    ; What the document and the template said about where a slide starts. The
    ; document wins, because it is closer to the deck than the company is.
    fn applySlideMeta:void (doc:MdNode) {
        if ((sheet.splitLevel) > 0) { splitLevel = sheet.splitLevel }
        if ((strlen sheet.overflow) > 0) { slideOverflow = sheet.overflow }
        def meta:MdMeta (MdFrontMatter.of(doc))
        if (meta.has("slide-split-level")) {
            def n@(optional):int (str2int (trim (meta.get("slide-split-level" "1"))))
            def lvl:int (?? n 1)
            if (lvl > 0) { splitLevel = lvl }
        }
        if (meta.has("slide-overflow")) {
            slideOverflow = (MdChar.lower((trim (meta.get("slide-overflow" "split")))))
        }
    }

    ; Sheets of a stated size, with the breaks decided here. What is printed.
    fn layoutPaged:void (doc:MdNode) {
        this.checkStyle()
        this.disarmCache()
        clear boxes
        boxIndexReady = false
        this.resetHeadings()
        paginate = true
        page = 0
        pageCount = 1
        contentX = style.margin
        contentW = (style.pageWidth - (style.margin * 2.0))
        contentTop = style.margin
        contentBottom = (style.pageHeight - style.margin)
        cursorY = contentTop
        this.layoutBody(doc)
        this.emitFurniture()
        documentHeight = style.pageHeight
    }

    ; ----------------------------------------------------------------------
    ; A table of contents, and what sits in the margins
    ; ----------------------------------------------------------------------
    ;
    ; The contents are laid out TWICE, and the reason is the oldest one in
    ; typesetting: the page numbers depend on where the blocks fall, and where
    ; the blocks fall depends on how tall the contents are. So the first pass
    ; reserves exactly the height the list will need — a number that does not
    ; depend on the page numbers at all, only on how many headings there are —
    ; and the second pass fills the reserved space in. Nothing moves between
    ; the two, so the numbers are right rather than nearly right.
    fn tocHeight:double () {
        if (tocLines == 0) { return 0.0 }
        def lh:double (style.bodySize * style.lineHeight)
        def head:double ((style.h2Size * style.lineHeight) + style.headingSpaceAfter)
        return (((head + (lh * (to_double tocLines))) + style.headingSpaceBefore) + style.paraSpacing)
    }

    fn emitToc:void (x:double w:double) {
        if (tocLines == 0) { return }
        def lh:double (style.bodySize * style.lineHeight)
        cursorY = (cursorY + style.headingSpaceBefore)
        def hy:double (this.reserve((style.h2Size * style.lineHeight)))
        def h:MdBox (MdBox.text("Contents" x hy w (style.h2Size * style.lineHeight)))
        h.family = style.headingFamily
        h.size = style.h2Size
        h.bold = true
        h.color = style.textColor
        this.emit(h)
        cursorY = ((hy + (style.h2Size * style.lineHeight)) + style.headingSpaceAfter)

        def i:int 0
        def n:int (array_length knownPages)
        while (i < n) {
            def level:int (itemAt knownLevel i)
            if (level <= 3) {
                def y:double (this.reserve(lh))
                def indent:double ((to_double (level - 1)) * 14.0)
                def label:MdBox (MdBox.text((itemAt knownText i) (x + indent) y (w - indent) lh))
                label.family = style.bodyFamily
                label.size = style.bodySize
                label.color = style.textColor
                this.emit(label)
                ; The page number, right-aligned against the column's edge.
                def num:string (to_string ((itemAt knownPages i) + 1))
                def probe:MdRun (new MdRun())
                probe.family = style.bodyFamily
                probe.size = style.bodySize
                def nw:double (this.measureRun(num probe))
                def nb:MdBox (MdBox.text(num ((x + w) - nw) y nw lh))
                nb.family = style.bodyFamily
                nb.size = style.bodySize
                nb.color = style.mutedColor
                this.emit(nb)
                cursorY = (y + lh)
            }
            i = (i + 1)
        }
        cursorY = (cursorY + style.paraSpacing)
    }

    ; The running head and the folio, on every sheet. Emitted after the
    ; content, because until then nobody knows how many sheets there are.
    fn emitFurniture:void () {
        if (! paginate) { return }
        def wantHead:boolean ((strlen style.runningHead) > 0)
        def wantNum:boolean ((strlen style.pageNumbers) > 0)
        if ((! wantHead) && (! wantNum)) { return }
        if (style.runningHead == "none") { wantHead = false }
        if (style.pageNumbers == "none") { wantNum = false }
        def savedPage:int page
        def x:double contentX
        def w:double contentW
        def lh:double (style.furnitureSize * 1.3)
        def p:int 0
        while (p < pageCount) {
            page = p
            if wantHead {
                def text:string (this.headFor(p))
                def tlen:int (strlen text)
                if (tlen > 0) {
                    def hy:double ((contentTop - lh) - 6.0)
                    def b:MdBox (MdBox.text(text x hy w lh))
                    b.family = style.bodyFamily
                    b.size = style.furnitureSize
                    b.color = style.mutedColor
                    this.emit(b)
                    this.emit((MdBox.rect(x (contentTop - 5.0) w 0.5 style.ruleColor)))
                }
            }
            if wantNum {
                def num:string (to_string (p + 1))
                def probe:MdRun (new MdRun())
                probe.family = style.bodyFamily
                probe.size = style.furnitureSize
                def nw:double (this.measureRun(num probe))
                def ny:double (contentBottom + 10.0)
                def nx:double ((x + (w / 2.0)) - (nw / 2.0))
                if (style.pageNumbers == "bottom-right") {
                    nx = ((x + w) - nw)
                }
                if (style.pageNumbers == "bottom-outer") {
                    ; Outer is right on a recto and left on a verso, counting
                    ; the first sheet as page one.
                    def recto:boolean ((p % 2) == 0)
                    if recto { nx = ((x + w) - nw) } { nx = x }
                }
                def nb:MdBox (MdBox.text(num nx ny nw lh))
                nb.family = style.bodyFamily
                nb.size = style.furnitureSize
                nb.color = style.mutedColor
                this.emit(nb)
            }
            p = (p + 1)
        }
        page = savedPage
    }

    ; What the running head says on that sheet.
    fn headFor:string (p:int) {
        if (style.runningHead == "title") { return style.title }
        if (style.runningHead != "h1") { return "" }
        def best:string ""
        def i:int 0
        def n:int (array_length headText)
        while (i < n) {
            if ((itemAt headLevel i) == 1) {
                if ((itemAt headPage i) <= p) {
                    best = (itemAt headText i)
                }
            }
            i = (i + 1)
        }
        return best
    }

    ; The body, in one pass or in two.
    ;
    ; Two when the document asked for a table of contents, because the page
    ; numbers in it depend on where the blocks fall and where the blocks fall
    ; depends on how tall it is. The first pass leaves a gap of exactly the
    ; right height and learns the pages; the second fills the gap in. Nothing
    ; moves between them.
    fn layoutBody:void (doc:MdNode) {
        tocLines = 0
        if style.wantToc {
            tocLines = (MdLayout.countHeadings(doc))
        }
        if (tocLines == 0) {
            this.bodyPass(doc 0)
            return
        }
        this.bodyPass(doc 1)
        clear knownPages
        clear knownText
        clear knownLevel
        def i:int 0
        def n:int (array_length headPage)
        while (i < n) {
            push knownPages (itemAt headPage i)
            push knownText (itemAt headText i)
            push knownLevel (itemAt headLevel i)
            i = (i + 1)
        }
        clear boxes
        boxIndexReady = false
        this.resetHeadings()
        page = 0
        pageCount = 1
        cursorY = contentTop
        this.bodyPass(doc 2)
    }

    ; `mode`: 0 no contents, 1 reserve the space, 2 fill it in.
    ; ----------------------------------------------------------------------
    ; The per-block layout cache
    ; ----------------------------------------------------------------------

    ; Turn it on for this document, if this document is one it can serve.
    ; Answers whether it did, so a caller can say so rather than assume.
    fn setDocSource:void (text:string) {
        docSource = text
    }

    fn armCache:boolean (doc:MdNode) {
        cacheOn = false
        if paginate { return false }
        if style.wantToc { return false }
        if ((strlen docSource) == 0) { return false }
        cacheOn = true
        return true
    }

    fn disarmCache:void () {
        cacheOn = false
    }

    ; Everything measured is measured at a width and through a measurer, so a
    ; change to either makes every entry wrong. The cheap and total answer is
    ; to throw the lot away: it costs one document's layout, once.
    fn dropCache:void () {
        map_clear cacheAt
        clear cacheKey
        clear cacheSrc
        clear cacheTop
        clear cacheHeight
        clear cacheFrom
        clear cacheCount
        clear cacheBoxes
        cacheHits = 0
        cacheMisses = 0
    }

    ; The text that produced this block, which is the only thing its boxes
    ; depend on — plus the width it was measured at, because the same
    ; paragraph breaks in different places in a different column.
    fn cacheKeyOf:string (node:MdNode src:string w:double) {
        def a:int node.srcStart
        def b:int node.srcEnd
        def n:int (strlen src)
        if (a < 0) { a = 0 }
        if (b > n) { b = n }
        if (b < a) { b = a }
        return (((to_string (to_int (w * 16.0))) + "\u0001") + (substring src a b))
    }

    fn cacheFind:int (key:string) {
        if (has cacheAt key) {
            return (unwrap (get cacheAt key))
        }
        return -1
    }

    ; ONE cached box, put where it goes. Both the replay and the audit go
    ; through this, and that is the point of it being a function.
    ;
    ; It was not, and the two disagreed: the replay shifted a box's source
    ; offset by the DIFFERENCE between where the block was and where it is,
    ; having already stored it relative to where it was — subtracting the base
    ; twice — while the audit re-derived the right answer and passed. So a
    ; block that moved got boxes claiming to come from the wrong part of the
    ; file, the caret's line table came out as [[0,10],[0,16],[0,10],[43,63]],
    ; and Up from the end of the document went to the end of the first line.
    ;
    ; A check that recomputes the answer is not checking the code. It is
    ; checking that two people can do the same arithmetic, and here they could
    ; not.
    fn cacheBoxAt:MdBox (slot:int i:int node:MdNode baseY:double) {
        def src:MdBox (itemAt cacheBoxes ((itemAt cacheFrom slot) + i))
        def b:MdBox (src.copy())
        b.y = (b.y + baseY)
        if (b.srcStart >= 0) { b.srcStart = (b.srcStart + node.srcStart) }
        if (b.segSrc >= 0) { b.segSrc = (b.segSrc + node.srcStart) }
        return b
    }

    ; A hit: the boxes again, moved to where this block now sits and stamped
    ; with where its source now is.
    fn cacheReplay:void (slot:int node:MdNode) {
        def cnt:int (itemAt cacheCount slot)
        def i:int 0
        while (i < cnt) {
            push boxes (this.cacheBoxAt(slot i node cursorY))
            i = (i + 1)
        }
        cursorY = (cursorY + (itemAt cacheHeight slot))
        cacheHits = (cacheHits + 1)
    }

    fn cacheStore:void (key:string node:MdNode from:int top:double) {
        def n:int (array_length boxes)
        def at:int (array_length cacheBoxes)
        def i:int from
        while (i < n) {
            def b:MdBox (itemAt boxes i)
            def keep:MdBox (b.copy())
            keep.y = (keep.y - top)
            if (keep.srcStart >= 0) { keep.srcStart = (keep.srcStart - node.srcStart) }
            if (keep.segSrc >= 0) { keep.segSrc = (keep.segSrc - node.srcStart) }
            push cacheBoxes keep
            i = (i + 1)
        }
        def slot:int (array_length cacheKey)
        push cacheKey key
        if (! (has cacheAt key)) {
            set cacheAt key slot
        }
        ; Zero, like `cacheTop`: the boxes were stored RELATIVE to the block,
        ; so what they are relative TO is nothing. Storing the block's own
        ; start here and subtracting it again on replay is the bug above.
        push cacheSrc 0
        push cacheTop 0.0
        push cacheHeight (cursorY - top)
        push cacheFrom at
        push cacheCount (n - from)
        cacheMisses = (cacheMisses + 1)
    }

    ; One top-level block, from the cache when it can be and from the layout
    ; when it cannot.
    fn blockCached:void (node:MdNode src:string x:double w:double) {
        ; …and never while PAGINATING. A cached block is replayed by copying
        ; its boxes and advancing the cursor by its height — `block` is not
        ; called, so `reserve` is not called, so the page never breaks. A
        ; four-hundred-paragraph document came out as two pages with every
        ; paragraph drawn on top of the last.
        ;
        ; `armCache` refuses a paginating layout, but it is asked BEFORE
        ; `layoutPaged` sets `paginate` — so the flag could be left on from
        ; the continuous layout before it. Asked here it cannot be.
        if ((! cacheOn) || paginate) {
            this.block(node x w)
            return
        }
        if (node.srcStart < 0) {
            this.block(node x w)
            return
        }
        ; A span that is empty does not identify a block, and two blocks that
        ; share a key share each other's boxes. That is not hypothetical: a
        ; one-line HTML block used to come out as [32,32], so a document with
        ; two comments in it drew one of them twice and the other not at all.
        ; The parser is fixed and this is the guard that makes the fix
        ; unnecessary rather than load-bearing.
        if (node.srcEnd <= node.srcStart) {
            this.block(node x w)
            return
        }
        def key:string (this.cacheKeyOf(node src w))
        def slot:int (this.cacheFind(key))
        if (slot >= 0) {
            if cacheAudit {
                this.auditBlock(slot node x w)
                return
            }
            this.cacheReplay(slot node)
            return
        }
        def from:int (array_length boxes)
        def top:double cursorY
        this.block(node x w)
        this.cacheStore(key node from top)
    }

    ; Lay the block out for real, then check the cache would have said the
    ; same thing. Slower than either on its own, which is the point: it is a
    ; gate, not a mode anyone ships with.
    fn auditBlock:void (slot:int node:MdNode x:double w:double) {
        cacheAudited = (cacheAudited + 1)
        def from:int (array_length boxes)
        def top:double cursorY
        this.block(node x w)
        def realCount:int ((array_length boxes) - from)
        def realHeight:double (cursorY - top)
        def cnt:int (itemAt cacheCount slot)
        if (realCount != cnt) {
            this.cacheFault((((("box count " + (to_string realCount)) + " vs cached ")
                + (to_string cnt)) + (" for " + node.kind)))
            return
        }
        if ((fabs (realHeight - (itemAt cacheHeight slot))) > 0.01) {
            this.cacheFault(("height " + (to_string realHeight)))
            return
        }
        def i:int 0
        while (i < cnt) {
            def got:MdBox (itemAt boxes (from + i))
            ; What the CACHE would have handed back — built by the same
            ; function the replay uses, not by doing its arithmetic again.
            def want:MdBox (this.cacheBoxAt(slot i node top))
            if (got.text != want.text) {
                this.cacheFault((("text [" + got.text) + ("] vs [" + (want.text + "]"))))
                i = cnt
            } {
                if ((fabs (got.y - want.y)) > 0.01) {
                    this.cacheFault(("y " + (to_string got.y)))
                    i = cnt
                } {
                    if ((fabs (got.x - want.x)) > 0.01) {
                        this.cacheFault(("x " + (to_string got.x)))
                        i = cnt
                    } {
                        if (got.segSrc != want.segSrc) {
                            this.cacheFault((("segSrc " + (to_string got.segSrc))
                                + (" vs " + (to_string want.segSrc))))
                            i = cnt
                        } {
                            if (got.srcStart != want.srcStart) {
                                this.cacheFault((("srcStart " + (to_string got.srcStart))
                                    + (" vs " + (to_string want.srcStart))))
                                i = cnt
                            } {
                                i = (i + 1)
                            }
                        }
                    }
                }
            }
        }
    }

    fn cacheFault:void (what:string) {
        cacheFaults = (cacheFaults + 1)
        if ((strlen cacheFirstFault) == 0) {
            cacheFirstFault = what
        }
    }

    fn bodyPass:void (doc:MdNode mode:int) {
        def placed:boolean (mode == 0)
        def i:int 0
        def n:int (doc.childCount())
        while (i < n) {
            def child:MdNode (doc.childAt(i))
            if slides {
                if (this.slideBreakBefore(child i)) {
                    this.nextSlide()
                }
                this.keepWithNext(child i n doc)
                if (child.kind == "heading") {
                    if (child.level <= splitLevel) {
                        ; `plainText`, not `literal`: a heading's literal is
                        ; gone by the time the inline parser has finished with
                        ; it — it became the text nodes underneath — so the
                        ; continuation slide carried an empty title.
                        slideTitle = (child.plainText())
                        slideTitleLevel = child.level
                    }
                }
            }
            this.blockCached(child docSource contentX contentW)
            if (! placed) {
                ; After the title, which is where a reader looks for it; at
                ; the very top when the document has no heading at all.
                def afterTitle:boolean (child.kind == "heading")
                def atTop:boolean (child.kind == "front_matter")
                if (afterTitle || (i == 0)) {
                    if (! atTop) {
                        if (mode == 1) {
                            cursorY = (cursorY + (this.tocHeight()))
                        } {
                            this.emitToc(contentX contentW)
                        }
                        placed = true
                    }
                }
            }
            i = (i + 1)
        }
    }

    ; ----------------------------------------------------------------------
    ; …and the four rules, in order
    ; ----------------------------------------------------------------------
    fn slideBreakBefore:boolean (child:MdNode i:int) {
        ; Never before the first block, and never on a slide with nothing on
        ; it yet — a rule that fires twice in a row leaves a blank slide.
        if (i == 0) { return false }
        if ((cursorY - contentTop) < 0.5) { return false }
        ; 2. FORBIDDEN beats 1. MANDATORY. An author who wrote `{.no-break}`
        ; on a heading meant it, and the alternative is a flag that does
        ; nothing whenever it would matter.
        if (child.hasClass("no-break")) { return false }
        ; 1. MANDATORY
        if (child.hasClass("slide")) { return true }
        if (child.kind == "heading") {
            if (child.level <= splitLevel) { return true }
            ; 3. PREFERRED — any other heading, once the slide is more than
            ; half full. Below half, a second heading is a subheading of what
            ; is already there and belongs with it.
            def used:double (cursorY - contentTop)
            def room:double (contentBottom - contentTop)
            if (used > (room * 0.5)) { return true }
        }
        return false
    }

    ; KEEP-WITH-NEXT. A heading with nothing under it is the one thing that
    ; makes an automatic deck look automatic, so the heading moves rather than
    ; the paragraph. It is asked for the PAIR: the heading's own height plus
    ; one line of whatever follows.
    fn keepWithNext:void (child:MdNode i:int n:int doc:MdNode) {
        if (child.kind != "heading") { return }
        if ((i + 1) >= n) { return }
        def next:MdNode (doc.childAt(i + 1))
        def size:double (style.headingSize(child.level))
        def head:double ((style.headingSpaceBefore + (size * style.lineHeight)) + style.headingSpaceAfter)
        def need:double (head + (this.keepRoom(next)))
        if ((cursorY + need) > contentBottom) {
            if ((cursorY - contentTop) > 0.5) {
                this.nextSlide()
            }
        }
    }

    ; How much of the next block has to fit beside the heading for the pair to
    ; count as together.
    ;
    ; One body line is right for PROSE: a paragraph that starts under its
    ; heading and runs onto the next slide still reads as one thing. It is
    ; wrong for a block that cannot be cut. A diagram is laid out whole or not
    ; at all, so a heading with one line of room under it takes the heading
    ; and leaves the diagram on the next slide — which is the reader's
    ; complaint, in as many words: the heading on one slide and the diagram on
    ; the next.
    ;
    ; The diagram's height is already known: `MdDiagram.prepare` measured it
    ; before layout began, which is the whole reason that pass exists. Capped
    ; at the room a slide has, because a diagram taller than any slide would
    ; otherwise push every heading forward for ever and still not fit.
    ;
    ; A TABLE is the other unsplittable-ish block and still gets one line. Its
    ; height is not known without laying its rows out, and doing that here
    ; would be a second table algorithm beside `tableWidths`. Named rather
    ; than left as an oversight.
    fn keepRoom:double (next:MdNode) {
        def line:double (style.bodySize * style.lineHeight)
        if (next.kind != "embed") { return line }
        def kind:string (MdLayout.firstWord(next.info))
        def want:string (next.attrValue("width"))
        def useW:double (MdEmbedKinds.widthOf(want contentW))
        def known:double (embeds.heightFor(kind next.literal useW))
        if (known <= 0.0) { return line }
        def room:double (contentBottom - contentTop)
        if (known > room) { return room }
        return known
    }

    fn nextSlide:void () {
        page = (page + 1)
        pageCount = (page + 1)
        cursorY = contentTop
    }

    ; The title again, at the top of a slide a block spilled onto. Emitted
    ; here rather than through `blockInner`, because there is no node for it:
    ; it is the same heading, said twice.
    fn emitSlideTitle:void () {
        if ((strlen slideTitle) == 0) { return }
        def size:double (style.headingSize(slideTitleLevel))
        def h:double (size * style.lineHeight)
        def b:MdBox (MdBox.text((slideTitle + " (jatkuu)") contentX cursorY contentW h))
        b.family = style.headingFamily
        b.size = size
        b.bold = true
        b.color = style.mutedColor
        this.emit(b)
        cursorY = ((cursorY + h) + style.headingSpaceAfter)
    }

    sfn countHeadings:int (doc:MdNode) {
        def c:int 0
        def i:int 0
        def n:int (doc.childCount())
        while (i < n) {
            def child:MdNode (doc.childAt(i))
            if (child.kind == "heading") {
                if (child.level <= 3) { c = (c + 1) }
            }
            i = (i + 1)
        }
        return c
    }

    fn resetHeadings:void () {
        clear headText
        clear headLevel
        clear headPage
        clear headY
    }

    ; Room for `h` more, or a new sheet. Returns the y to draw at.
    fn reserve:double (h:double) {
        if paginate {
            if ((cursorY + h) > contentBottom) {
                page = (page + 1)
                pageCount = (page + 1)
                cursorY = contentTop
                ; A block that did not fit is a block cut in half, and on a
                ; deck that is worth saying out loud — and worth repeating the
                ; title for, so a reader of the second half knows what it is
                ; the second half of.
                if slides {
                    slideOverflows = (slideOverflows + 1)
                    this.emitSlideTitle()
                }
            }
        }
        return cursorY
    }

    fn emit:void (b:MdBox) {
        b.page = page
        b.srcStart = currentSrc
        push boxes b
    }

    ; The first box a block produced, or -1. The two panes of the viewer are
    ; kept in step through this and nothing else.
    ;
    ; It was a scan of every box in the document, once per call, and the
    ; viewer calls it once per BLOCK — so putting the source caret back after
    ; a click was quadratic in the document. Nobody noticed at a click a
    ; second; a caret that moves on every keystroke would have. The index is
    ; built once per layout, at the end, keyed by the block's own srcStart.
    fn buildBoxIndex:void () {
        map_clear boxIndexAt
        def i:int 0
        def n:int (array_length boxes)
        while (i < n) {
            def b:MdBox (itemAt boxes i)
            if (b.srcStart >= 0) {
                def k:string (to_string b.srcStart)
                if (! (has boxIndexAt k)) {
                    set boxIndexAt k i
                }
            }
            i = (i + 1)
        }
        boxIndexReady = true
    }

    fn firstBoxOf:int (srcStart:int) {
        if (! boxIndexReady) {
            this.buildBoxIndex()
        }
        def k:string (to_string srcStart)
        if (has boxIndexAt k) {
            return (unwrap (get boxIndexAt k))
        }
        return -1
    }

    ; ----------------------------------------------------------------------
    ; Blocks
    ; ----------------------------------------------------------------------
    fn blocks:void (parent:MdNode x:double w:double) {
        def i:int 0
        def n:int (parent.childCount())
        while (i < n) {
            def child:MdNode (parent.childAt(i))
            this.block(child x w)
            i = (i + 1)
        }
    }

    fn block:void (node:MdNode x:double w:double) {
        def outerSrc:int currentSrc
        if (node.srcStart >= 0) { currentSrc = node.srcStart }
        this.blockInner(node x w)
        currentSrc = outerSrc
    }

    ; ----------------------------------------------------------------------
    ; Columns
    ; ----------------------------------------------------------------------
    ;
    ; ```md
    ; - Verkkokauppa kasvoi 18 %
    ; - Jälleenmyynti pysyi ennallaan
    ; - Lisenssit laskivat 4 %
    ; {.c3}
    ; ```
    ;
    ; A block the sheet gives `column-count` to is laid out ONCE at the width
    ; of one column, and the boxes that came out are then cut into columns and
    ; moved. Laying each column out separately would be the obvious thing and
    ; it is wrong twice over: a list's marker width is measured across the
    ; whole list, and an item that wrapped differently in a narrower pass
    ; would change the balance it was being balanced by.
    ;
    ; **The unit is the ITEM, not the line.** `PLAN_SLIDES.md` Stage C: in
    ; document order DOWN each column, and the columns differ by at most one
    ; item. A line-level flow reads better in a newspaper and is unreadable in
    ; a deck, where a bullet split across two columns is a bullet nobody can
    ; follow.
    ;
    ; Which boxes belong to which item is read off the boxes themselves: each
    ; carries the source offset of the block it came from. A box whose offset
    ; is inside no item — a list's own bullet marker is emitted by the list,
    ; not by the item — joins the group before it, which is where it was
    ; drawn.
    fn columnCount:int (node:MdNode) {
        if ((strlen sheetText) == 0) { return 1 }
        if (! (MdLayout.canColumn(node.kind))) { return 1 }
        def got:CssComputed (this.styleOf(node))
        if (! (got.has("column-count"))) { return 1 }
        def n@(optional):int (str2int (CssSheet.tidy((got.get("column-count")))))
        def cols:int (?? n 1)
        if (cols < 2) { return 1 }
        if (cols > 8) { return 8 }
        return cols
    }

    ; Only a block whose children are themselves blocks. A paragraph in three
    ; columns would be a line flow and is a different feature; saying so is
    ; better than cutting a sentence into thirds by accident.
    sfn canColumn:boolean (kind:string) {
        if (kind == "list") { return true }
        if (kind == "block_quote") { return true }
        return false
    }

    fn columnGap:double (node:MdNode) {
        def got:CssComputed (this.styleOf(node))
        if (! (got.has("column-gap"))) { return 18.0 }
        return (CssValue.fontPoints((got.get("column-gap")) 18.0))
    }

    fn columnFlow:void (node:MdNode x:double w:double cols:int gap:double) {
        def colW:double ((w - (gap * (int2double (cols - 1)))) / (int2double cols))
        if (colW < 24.0) {
            this.blockPlain(node x w)
            return
        }
        def from:int (array_length boxes)
        def top:double cursorY
        def h:double (this.columnPass(node x colW cols gap top from))
        ; In a paginated layout a block cut into columns is cut as a whole, so
        ; it either fits where it is or starts a sheet of its own. It cannot
        ; be asked to fit before it has been laid out, so it is laid out, and
        ; laid out again from the top of the next sheet when it does not.
        if paginate {
            if ((top + h) > contentBottom) {
                if ((contentTop + h) <= contentBottom) {
                    this.truncate(from)
                    page = (page + 1)
                    pageCount = (page + 1)
                    top = contentTop
                    h = (this.columnPass(node x colW cols gap top from))
                }
            }
        }
        cursorY = (top + h)
    }

    fn truncate:void (n:int) {
        while ((array_length boxes) > n) {
            removeLast boxes
        }
    }

    ; Lay the block out at one column's width from `top`, then move the groups
    ; into columns. Returns the height the columns take.
    fn columnPass:double (node:MdNode x:double colW:double cols:int gap:double top:double from:int) {
        def wasPaginate:boolean paginate
        paginate = false
        cursorY = top
        this.blockPlain(node x colW)
        paginate = wasPaginate
        def to:int (array_length boxes)
        if (to <= from) { return 0.0 }

        ; Which item each box belongs to.
        def owner:[int]
        def kids:int (node.childCount())
        def i:int from
        def last:int 0
        while (i < to) {
            def b:MdBox (itemAt boxes i)
            ; A list's own bullet carries the LIST's source offset, and a
            ; list starts where its first item does — so asking the spans
            ; alone puts every marker in the first item's group and leaves
            ; the bullets behind in column one while their text moves. The
            ; groups are emitted in order, so a box may never belong to an
            ; earlier one than the box before it.
            def g:int (MdLayout.itemOf(node kids b.srcStart))
            if (g < last) { g = last }
            push owner g
            last = g
            i = (i + 1)
        }
        ; …and where each group sits.
        def gTop:[double]
        def gBot:[double]
        def gSeen:[boolean]
        def k:int 0
        while (k < kids) {
            push gTop 0.0
            push gBot 0.0
            push gSeen false
            k = (k + 1)
        }
        i = from
        while (i < to) {
            def b2:MdBox (itemAt boxes i)
            def g2:int (itemAt owner (i - from))
            if (g2 < kids) {
                if (itemAt gSeen g2) {
                    if (b2.y < (itemAt gTop g2)) { set_at gTop g2 b2.y }
                    if ((b2.y + b2.h) > (itemAt gBot g2)) { set_at gBot g2 (b2.y + b2.h) }
                } {
                    set_at gSeen g2 true
                    set_at gTop g2 b2.y
                    set_at gBot g2 (b2.y + b2.h)
                }
            }
            i = (i + 1)
        }

        ; The split: document order down each column, and at most one item
        ; between the longest column and the shortest.
        def base:int (idiv kids cols)
        def extra:int (kids - (base * cols))
        def colOf:[int]
        def firstOf:[int]
        def c:int 0
        def at:int 0
        while (c < cols) {
            def take:int base
            if (c < extra) { take = (take + 1) }
            push firstOf at
            def t:int 0
            while (t < take) {
                push colOf c
                at = (at + 1)
                t = (t + 1)
            }
            c = (c + 1)
        }
        while ((array_length colOf) < kids) {
            push colOf (cols - 1)
        }

        ; Move them.
        def dy:[double]
        c = 0
        while (c < cols) {
            def firstIdx:int (itemAt firstOf c)
            def shift:double 0.0
            if (firstIdx < kids) {
                if (itemAt gSeen firstIdx) {
                    shift = (top - (itemAt gTop firstIdx))
                }
            }
            push dy shift
            c = (c + 1)
        }
        i = from
        while (i < to) {
            def b3:MdBox (itemAt boxes i)
            def g3:int (itemAt owner (i - from))
            if (g3 >= kids) { g3 = (kids - 1) }
            if (g3 < 0) { g3 = 0 }
            def col:int (itemAt colOf g3)
            b3.x = (b3.x + ((int2double col) * (colW + gap)))
            b3.y = (b3.y + (itemAt dy col))
            i = (i + 1)
        }

        ; The tallest column is the block's height.
        def h:double 0.0
        def g4:int 0
        while (g4 < kids) {
            if (itemAt gSeen g4) {
                def col2:int (itemAt colOf g4)
                def bot:double (((itemAt gBot g4) + (itemAt dy col2)) - top)
                if (bot > h) { h = bot }
            }
            g4 = (g4 + 1)
        }
        return h
    }

    ; The direct child whose source span holds `off`, or -1.
    sfn itemOf:int (node:MdNode kids:int off:int) {
        if (off < 0) { return -1 }
        def i:int 0
        while (i < kids) {
            def k:MdNode (node.childAt(i))
            if (k.srcStart >= 0) {
                if ((k.srcStart <= off) && (off < k.srcEnd)) { return i }
            }
            i = (i + 1)
        }
        return -1
    }

    fn blockInner:void (node:MdNode x:double w:double) {
        def cols:int (this.columnCount(node))
        if (cols > 1) {
            this.columnFlow(node x w cols (this.columnGap(node)))
            return
        }
        this.blockPlain(node x w)
    }

    fn blockPlain:void (node:MdNode x:double w:double) {
        def kind:string node.kind
        if (kind == "paragraph") {
            if (this.pictureBlock(node x w)) { return }
            def runs:[MdRun] (this.inlineRuns(node (this.baseRun())))
            this.paragraph(runs x w)
            def gap:double style.paraSpacing
            if inTightItem {
                gap = style.listTightSpacing
            }
            cursorY = (cursorY + gap)
            return
        }
        if (kind == "heading") {
            this.heading(node x w)
            return
        }
        if (kind == "thematic_break") {
            def y:double (this.reserve(14.0))
            this.emit((MdBox.rect(x (y + 6.0) w 1.0 style.ruleColor)))
            cursorY = (y + 14.0)
            return
        }
        if (kind == "code_block") {
            this.codeBlock(node x w)
            return
        }
        if (kind == "html_block") {
            ; A canvas has nothing to hand a `<div>` to. The markup is shown
            ; as what it is — which is also more honest than dropping it.
            def shown:MdNode (MdNode.create("code_block"))
            shown.literal = node.literal
            shown.info = "html"
            this.codeBlock(shown x w)
            return
        }
        if (kind == "block_quote") {
            this.blockQuote(node x w)
            return
        }
        if (kind == "list") {
            this.list(node x w)
            return
        }
        if (kind == "table") {
            this.table(node x w)
            return
        }
        if (kind == "front_matter") {
            return
        }
        if (kind == "embed") {
            this.embed(node x w)
            return
        }
        ; anything unexpected still shows its contents rather than vanishing
        this.blocks(node x w)
    }

    fn baseRun:MdRun () {
        def r:MdRun (new MdRun())
        r.family = style.bodyFamily
        r.size = style.bodySize
        r.color = style.textColor
        if (quoteDepth > 0) {
            r.color = style.quoteColor
        }
        return r
    }

    fn heading:void (node:MdNode x:double w:double) {
        if (style.breakOnH1 && (node.level == 1)) {
            ; A chapter opener starts its own sheet — but not the first one,
            ; which would be a blank page before the title.
            if (paginate && ((array_length boxes) > 0)) {
                page = (page + 1)
                pageCount = (page + 1)
                cursorY = contentTop
            }
        }
        def size:double (style.headingSize(node.level))
        def base:MdRun (new MdRun())
        base.family = style.headingFamily
        base.size = size
        base.bold = true
        base.color = style.textColor
        def runs:[MdRun] (this.inlineRuns(node base))
        cursorY = (cursorY + style.headingSpaceBefore)
        ; Recorded BEFORE the lines are placed, so the page is the page the
        ; heading starts on rather than the one it may have spilled onto.
        def at:double (this.reserve((size * style.lineHeight)))
        push headText (node.plainText())
        push headLevel node.level
        push headPage page
        push headY at
        this.paragraph(runs x w)
        if (node.level <= 2) {
            def y:double cursorY
            this.emit((MdBox.rect(x (y + 4.0) w 1.0 style.ruleColor)))
            cursorY = (y + 5.0)
        }
        cursorY = (cursorY + style.headingSpaceAfter)
    }

    fn codeBlock:void (node:MdNode x:double w:double) {
        def lines:[string] (strsplit node.literal "\n")
        def count:int (array_length lines)
        ; a fenced block ends in a newline, which is not a line of code
        if (count > 0) {
            def lastLine:string (itemAt lines (count - 1))
            def lastLen:int (strlen lastLine)
            if (lastLen == 0) { count = (count - 1) }
        }
        if (count < 1) { count = 1 }
        def lh:double (style.codeSize * style.codeLineHeight)
        def boxH:double ((lh * (to_double count)) + (style.codePadding * 2.0))
        def y:double (this.reserve(boxH))
        this.emit((MdBox.rect(x y w boxH style.codeBackground)))
        this.emit((MdBox.outline(x y w boxH style.codeBorder 1.0)))
        def ty:double (y + style.codePadding)
        def lang:MdLanguage (MdCodeHighlight.languageFor((MdLayout.firstWord(node.info))))
        def state:int 0
        def tx0:double (x + style.codePadding)
        def i:int 0
        while (i < count) {
            def ln:string (itemAt lines i)
            if style.highlightCode {
                def hl:MdHighlightedLine (MdCodeHighlight.line(ln lang state))
                state = hl.state
                this.codeLine(hl tx0 ty lh)
            } {
                def b:MdBox (MdBox.text(ln tx0 ty (w - (style.codePadding * 2.0)) lh))
                b.family = style.monoFamily
                b.size = style.codeSize
                b.color = style.textColor
                this.emit(b)
            }
            ty = (ty + lh)
            i = (i + 1)
        }
        cursorY = ((y + boxH) + style.paraSpacing)
    }

    ; One line of code, token by token. Each is measured and placed after the
    ; one before it, exactly as a paragraph's segments are — the face is the
    ; same for all of them, so what varies is only the colour, and the run
    ; still has to be measured because the face is not monospaced.
    fn codeLine:void (hl:MdHighlightedLine x0:double y:double lh:double) {
        def probe:MdRun (new MdRun())
        probe.family = style.monoFamily
        probe.size = style.codeSize
        def cx:double x0
        def i:int 0
        def n:int (array_length hl.tokens)
        while (i < n) {
            def t:MdToken (itemAt hl.tokens i)
            def tlen:int (strlen t.text)
            if (tlen > 0) {
                ; The whitespace at either end of a token is laid as advance
                ; rather than as text — the same rule a paragraph's segments
                ; follow, and for the same reason: a space has no glyph, and a
                ; consumer that trims the edges of a text run then draws the
                ; geometry the PDF draws. Without it `const frame` prints
                ; correctly and previews as `constframe`.
                def lead:int (MdLayout.leadingSpaces(t.text))
                def trail:int (MdLayout.trailingSpaces(t.text tlen lead))
                if (lead > 0) {
                    def gap:string (substring t.text 0 lead)
                    cx = (cx + (this.measureRun(gap probe)))
                }
                def core:string (substring t.text lead (tlen - trail))
                def clen:int (strlen core)
                if (clen > 0) {
                    def wid:double (this.measureRun(core probe))
                    def b:MdBox (MdBox.text(core cx y wid lh))
                    b.family = style.monoFamily
                    b.size = style.codeSize
                    b.color = (style.codeColor(t.kind))
                    this.emit(b)
                    cx = (cx + wid)
                }
                if (trail > 0) {
                    def tail:string (substring t.text (tlen - trail) tlen)
                    cx = (cx + (this.measureRun(tail probe)))
                }
            }
            i = (i + 1)
        }
    }

    fn blockQuote:void (node:MdNode x:double w:double) {
        def pad:double style.quotePadY
        def top:double cursorY
        def innerX:double ((x + style.quoteBarWidth) + style.quoteIndent)
        def innerW:double (w - ((style.quoteBarWidth + style.quoteIndent)))
        def startPage:int page
        def before:int (array_length boxes)
        cursorY = (cursorY + pad)
        quoteDepth = (quoteDepth + 1)
        ; A quote is a block with paragraphs in it wherever it stands, even
        ; inside a tight list item.
        def wasTight:boolean inTightItem
        inTightItem = false
        this.blocks(node innerX innerW)
        inTightItem = wasTight
        quoteDepth = (quoteDepth - 1)
        ; Where the CONTENT ended, which is not where the cursor is: `blocks`
        ; leaves the cursor past the last child's own trailing space, and that
        ; space belongs OUTSIDE the bar. Reading the bottom off the boxes it
        ; just emitted works whatever the last child turned out to be — a
        ; paragraph, a list, a table, a nested quote, a drawing — where
        ; subtracting a paragraph's spacing would only work for a paragraph.
        def inkBottom:double (top + pad)
        def i:int before
        def n:int (array_length boxes)
        while (i < n) {
            def b:MdBox (itemAt boxes i)
            ; On this sheet only. A quote that crossed a break has boxes whose
            ; y is measured from the top of another page.
            if (b.page == page) {
                def edge:double (b.y + b.h)
                if (edge > inkBottom) {
                    inkBottom = edge
                }
            }
            i = (i + 1)
        }
        def bottom:double (inkBottom + pad)
        ; The bar is drawn per page, so a quote that spans a break gets one on
        ; each sheet rather than a single stripe that goes off the bottom.
        if (page == startPage) {
            this.emit((MdBox.rect(x top style.quoteBarWidth (bottom - top) style.quoteBarColor)))
        } {
            this.emit((MdBox.rect(x contentTop style.quoteBarWidth (bottom - contentTop) style.quoteBarColor)))
        }
        cursorY = (bottom + style.paraSpacing)
    }

    fn list:void (node:MdNode x:double w:double) {
        def items:int (node.childCount())
        def i:int 0
        def number:int node.listStart
        listDepth = (listDepth + 1)
        def wasTight:boolean inTightItem
        ; How far the text is indented, which is as far as the WIDEST marker
        ; needs and never less than the style's own step.
        ;
        ; It was the step alone. `1.` fits inside it and `100.` does not, so a
        ; list long enough to reach three digits wrote its numbers across the
        ; first letters of its own items — and the box the marker claimed
        ; stayed the same width as the number grew, which is a lie anything
        ; that clips or hit-tests a box would have believed.
        def probe:MdRun (this.baseRun())
        def widest:double 0.0
        def probeNum:int node.listStart
        def k:int 0
        while (k < items) {
            def probeItem:MdNode (node.childAt(k))
            def pm:string (MdLayout.markerFor(node probeItem probeNum))
            if node.listOrdered {
                probeNum = (probeNum + 1)
            }
            def pw:double (this.measureRun(pm probe))
            if (pw > widest) {
                widest = pw
            }
            k = (k + 1)
        }
        def indent:double style.listIndent
        def need:double (widest + style.markerGap)
        if (need > indent) {
            indent = need
        }
        while (i < items) {
            def item:MdNode (node.childAt(i))
            def marker:string (MdLayout.markerFor(node item number))
            if node.listOrdered {
                number = (number + 1)
            }
            def innerX:double (x + indent)
            def innerW:double (w - indent)
            def markerY:double cursorY
            def markerPage:int page
            inTightItem = node.listTight
            this.blocks(item innerX innerW)
            inTightItem = wasTight
            ; The marker is emitted with the page the item STARTED on, which
            ; is where its first line went.
            def savedPage:int page
            page = markerPage
            def markerW:double (this.measureRun(marker probe))
            def mb:MdBox (MdBox.text(marker x markerY markerW (style.bodySize * style.lineHeight)))
            mb.family = style.bodyFamily
            mb.size = style.bodySize
            mb.color = style.mutedColor
            this.emit(mb)
            page = savedPage
            if (! node.listTight) {
                cursorY = (cursorY + 2.0)
            }
            i = (i + 1)
        }
        listDepth = (listDepth - 1)
        ; The list's own separation from whatever follows it, which the items
        ; stopped providing when the list went tight. Only the OUTERMOST list
        ; gets it: a nested list is followed by its parent's next item, and an
        ; item's worth of air is what that wants.
        if (listDepth == 0) {
            if node.listTight {
                def extra:double (style.paraSpacing - style.listTightSpacing)
                if (extra > 0.0) {
                    cursorY = (cursorY + extra)
                }
            }
        }
    }

    ; A fenced diagram. The layout cannot draw one and must still leave a
    ; hole of the right height — so it asks the cache, which a handler filled
    ; before layout began. A diagram nobody prepared is a labelled slot: an
    ; empty rectangle tells a reader nothing, and a silent omission tells
    ; them less.
    fn embed:void (node:MdNode x:double w:double) {
        def kind:string (MdLayout.firstWord(node.info))
        ; `{width=360}` under the fence, clamped to the column. `MdDiagram`
        ; works the same number out of the same attribute before layout
        ; begins, and it has to be the same number: the cache is keyed by the
        ; width the diagram was prepared at, so one point of disagreement is a
        ; slot with an apology in it instead of a drawing.
        def want:string (node.attrValue("width"))
        def useW:double (MdEmbedKinds.widthOf(want w))
        def known:double (embeds.heightFor(kind node.literal useW))
        def drawn:boolean (known > 0.0)
        def h:double 64.0
        if drawn { h = known }
        def y:double (this.reserve(h))
        def b:MdBox (new MdBox())
        b.kind = 3
        b.x = x
        b.y = y
        b.w = useW
        b.h = h
        b.embedKind = kind
        b.embedSource = node.literal
        this.emit(b)
        if (! drawn) {
            b.stroke = style.codeBorder
            b.strokeWidth = 1.0
            def note:string (embeds.noteFor(kind node.literal useW))
            def nlen:int (strlen note)
            if (nlen == 0) { note = (kind + " — no handler prepared this one") }
            def label:MdBox (MdBox.text(note (x + style.codePadding) (y + style.codePadding) (useW - (style.codePadding * 2.0)) (style.bodySize * style.lineHeight)))
            label.family = style.bodyFamily
            label.size = style.bodySize
            label.italic = true
            label.color = style.mutedColor
            this.emit(label)
        }
        cursorY = ((y + h) + style.embedSpacing)
    }

    ; What stands in front of an item: a bullet, a number, or a task box. One
    ; place, because the measuring pass and the drawing pass have to agree —
    ; they did not have to before, when the column was a constant.
    sfn markerFor:string (list:MdNode item:MdNode number:int) {
        if (item.taskState >= 0) {
            return (? (item.taskState == 1) "☑" "☐")
        }
        if list.listOrdered {
            return ((to_string number) + list.listDelim)
        }
        return "•"
    }

    sfn firstWord:string (info:string) {
        def n:int (strlen info)
        def i:int 0
        while (i < n) {
            def c:int (charAt info i)
            if (c == 32) { return (substring info 0 i) }
            if (c == 9) { return (substring info 0 i) }
            i = (i + 1)
        }
        return info
    }

    ; ----------------------------------------------------------------------
    ; Inlines → runs
    ; ----------------------------------------------------------------------
    ; Returning the array rather than filling one that was passed in.
    ;
    ; `push` into an array PARAMETER works on JavaScript and does nothing on
    ; Go, where the parameter is a slice and the append lands on a copy. The
    ; JavaScript suite passed and the Go suite laid out an empty page; there
    ; is no warning in between, so the rule here is that an array is a return
    ; value and never an out-parameter.
    fn inlineRuns:[MdRun] (node:MdNode base:MdRun) {
        return (this.collectRuns(node base))
    }

    fn collectRuns:[MdRun] (node:MdNode base:MdRun) {
        def out:[MdRun]
        def i:int 0
        def n:int (node.childCount())
        while (i < n) {
            def c:MdNode (node.childAt(i))
            def kind:string c.kind
            if (kind == "text") {
                def r:MdRun (base.copyStyle())
                r.text = c.literal
                r.srcStart = c.srcStart
                r.srcEnd = c.srcEnd
                push out r
            }
            if (kind == "softbreak") {
                def sb:MdRun (base.copyStyle())
                sb.text = " "
                sb.srcStart = c.srcStart
                sb.srcEnd = c.srcEnd
                push out sb
            }
            if (kind == "linebreak") {
                def lb:MdRun (base.copyStyle())
                lb.hardBreak = true
                lb.srcStart = c.srcStart
                lb.srcEnd = c.srcEnd
                push out lb
            }
            if (kind == "code") {
                def cr:MdRun (base.copyStyle())
                cr.family = style.monoFamily
                cr.size = (base.size * 0.92)
                cr.code = true
                cr.bold = false
                cr.italic = false
                cr.text = c.literal
                cr.srcStart = c.srcStart
                cr.srcEnd = c.srcEnd
                push out cr
            }
            if (kind == "html_inline") {
                def hr:MdRun (base.copyStyle())
                hr.family = style.monoFamily
                hr.size = (base.size * 0.92)
                hr.color = style.mutedColor
                hr.text = c.literal
                hr.srcStart = c.srcStart
                hr.srcEnd = c.srcEnd
                push out hr
            }
            if (kind == "emph") {
                def er:MdRun (base.copyStyle())
                er.italic = true
                def nested:[MdRun] (this.collectRuns(c er))
                def ni:int 0
                def nn:int (array_length nested)
                while (ni < nn) {
                    push out (itemAt nested ni)
                    ni = (ni + 1)
                }
            }
            if (kind == "strong") {
                def sr:MdRun (base.copyStyle())
                sr.bold = true
                def nested:[MdRun] (this.collectRuns(c sr))
                def ni:int 0
                def nn:int (array_length nested)
                while (ni < nn) {
                    push out (itemAt nested ni)
                    ni = (ni + 1)
                }
            }
            if (kind == "strike") {
                def kr:MdRun (base.copyStyle())
                kr.color = style.mutedColor
                def nested:[MdRun] (this.collectRuns(c kr))
                def ni:int 0
                def nn:int (array_length nested)
                while (ni < nn) {
                    push out (itemAt nested ni)
                    ni = (ni + 1)
                }
            }
            if (kind == "link") {
                def lr:MdRun (base.copyStyle())
                lr.color = style.linkColor
                lr.link = c.destination
                def nested:[MdRun] (this.collectRuns(c lr))
                def ni:int 0
                def nn:int (array_length nested)
                while (ni < nn) {
                    push out (itemAt nested ni)
                    ni = (ni + 1)
                }
            }
            if (kind == "image") {
                ; An image the layout has no bytes for still says what it was.
                def ir:MdRun (base.copyStyle())
                ir.italic = true
                ir.color = style.mutedColor
                def alt:string (c.plainText())
                ir.text = (("[" + alt) + "]")
                ir.srcStart = c.srcStart
                ir.srcEnd = c.srcEnd
                push out ir
            }
            i = (i + 1)
        }
        return out
    }

    ; ----------------------------------------------------------------------
    ; A paragraph: runs in, positioned lines out
    ; ----------------------------------------------------------------------
    fn paragraph:void (runs:[MdRun] x:double w:double) {
        def lines:[MdLine] (this.breakRuns(runs w))
        def i:int 0
        def n:int (array_length lines)
        while (i < n) {
            def ln:MdLine (itemAt lines i)
            def y:double (this.reserve(ln.height))
            def s:int 0
            def sn:int (array_length ln.segs)
            while (s < sn) {
                def seg:MdSeg (itemAt ln.segs s)
                if seg.code {
                    ; the tint behind an inline code span, drawn first
                    def pad:double 2.0
                    def bg:MdBox (MdBox.rect(((x + seg.x) - pad) (y + 1.0) (seg.w + (pad * 2.0)) (ln.height - 2.0) style.codeBackground))
                    this.emit(bg)
                }
                def b:MdBox (MdBox.text(seg.text (x + seg.x) y seg.w ln.height))
                b.segSrc = seg.srcStart
                b.segLen = seg.srcLen
                b.family = seg.family
                b.size = seg.size
                b.bold = seg.bold
                b.italic = seg.italic
                b.color = seg.color
                b.link = seg.link
                this.emit(b)
                s = (s + 1)
            }
            cursorY = (y + ln.height)
            i = (i + 1)
        }
    }

    ; ----------------------------------------------------------------------
    ; From a point on the page back to a character in the file
    ; ----------------------------------------------------------------------
    ;
    ; This is the question a caret is, and until the segments carried their
    ; own offsets it could not be asked: every box of a paragraph held that
    ; PARAGRAPH's start, so the finest answer available was "the block you
    ; clicked". The viewer's `sourceOffsetAt` returned exactly that.
    ;
    ; It lives here rather than in the web facade because it is layout, not
    ; chrome: it has to measure with the measurer the layout measured with, or
    ; the caret lands beside the glyphs rather than between them. `PptxEdit`
    ; and `DocxEditController` each learned that separately.

    ; A box's y in DOCUMENT coordinates. `sheetGap` >= 0 means the sheets are
    ; stacked with that much between them; below zero means one column.
    ; A box's y in DOCUMENT coordinates. `sheetGap` >= 0 means the sheets are
    ; stacked with that much between them; below zero means one column.
    ;
    ; The gap runs BEFORE the first sheet too. A document whose first page
    ; starts at y=0 sits against the top of the window with nothing above it,
    ; which reads as a page that has been cut rather than one that starts.
    fn boxTop:double (b:MdBox sheetGap:double) {
        if (sheetGap >= 0.0) {
            return ((b.y + sheetGap) + ((to_double b.page) * (style.pageHeight + sheetGap)))
        }
        return b.y
    }

    fn measureStyled:double (text:string family:string size:double bold:boolean italic:boolean) {
        def len:int (strlen text)
        if (len == 0) { return 0.0 }
        def face:string (style.faceFor(family bold italic))
        def m:EVGTextMetrics (engine.measureRun(text face size))
        return m.width
    }

    ; Which character of a placed run the pointer at `x` is over, as a source
    ; offset. Splits on glyph midpoints, so a click lands on the nearer side
    ; of a character rather than always its left — the same rule
    ; `OfficeTextMetrics.offsetAtX` follows for the .docx caret.
    ;
    ; The walk is over the box's TEXT and the answer is in the FILE, and those
    ; are the same length only where the run holds no escape and no entity. So
    ; the result is clamped into the box's own span: an approximate offset
    ; inside a run is a caret one character out, while an unclamped one is a
    ; caret in the next paragraph.
    fn offsetInBox:int (b:MdBox x:double) {
        if (b.segSrc < 0) { return -1 }
        def len:int (strlen b.text)
        if (len == 0) { return b.segSrc }
        def want:double (x - b.x)
        if (want <= 0.0) { return b.segSrc }
        def k:int 0
        def hit:int len
        while (k < len) {
            def w0:double (this.measureStyled((substring b.text 0 k) b.family b.size b.bold b.italic))
            def w1:double (this.measureStyled((substring b.text 0 (k + 1)) b.family b.size b.bold b.italic))
            if (want < ((w0 + w1) * 0.5)) {
                hit = k
                k = len
            } {
                k = (k + 1)
            }
        }
        def at:int (b.segSrc + hit)
        def stop:int (b.segSrc + b.segLen)
        if (at > stop) { at = stop }
        return at
    }

    ; The text box at a point in document coordinates, or -1. A click to the
    ; right of the last word on a line belongs to that line rather than to
    ; nothing, so the nearest box on the line the pointer is ON wins — which
    ; is what puts a caret at the end of a line when a reader clicks past it.
    fn boxAtPoint:int (x:double y:double sheetGap:double) {
        def best:int -1
        def bestDx:double 0.0
        def i:int 0
        def n:int (array_length boxes)
        while (i < n) {
            def b:MdBox (itemAt boxes i)
            if ((b.kind == 0) && (b.segSrc >= 0)) {
                def top:double (this.boxTop(b sheetGap))
                if ((y >= top) && (y < (top + b.h))) {
                    def dx:double 0.0
                    if (x < b.x) { dx = (b.x - x) }
                    if (x > (b.x + b.w)) { dx = (x - (b.x + b.w)) }
                    if (best < 0) {
                        best = i
                        bestDx = dx
                    } {
                        if (dx < bestDx) {
                            best = i
                            bestDx = dx
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return best
    }

    ; The whole question in one call: a point on the page, a character in the
    ; file, or -1 when nothing that carries a source was drawn there.
    fn srcAtPoint:int (x:double y:double sheetGap:double) {
        def i:int (this.boxAtPoint(x y sheetGap))
        if (i < 0) { return -1 }
        def b:MdBox (itemAt boxes i)
        return (this.offsetInBox(b x))
    }

    fn measureRun:double (text:string r:MdRun) {
        def len:int (strlen text)
        if (len == 0) { return 0.0 }
        def face:string (style.faceFor(r.family r.bold r.italic))
        def m:EVGTextMetrics (engine.measureRun(text face r.size))
        return m.width
    }

    ; ----------------------------------------------------------------------
    ; Breaking a line across several faces
    ; ----------------------------------------------------------------------
    ;
    ; The algorithm `EVGTextEngine` uses, with one change: the accumulator is
    ; a list of segments rather than a string, so a change of face is a new
    ; segment instead of the end of the line. Each segment is measured WHOLE
    ; — not as a sum of word widths plus a guessed space — which is what
    ; makes the break land where the painter will draw it.
    fn breakRuns:[MdLine] (runs:[MdRun] maxWidth:double) {
        def lines:[MdLine]

        ; --- atoms: words, runs of spaces, and forced breaks ---------------
        def aText:[string]
        def aRun:[int]
        def aSpace:[boolean]
        def aBreak:[boolean]
        ; Where each atom starts inside its run's text. The atoms are what a
        ; segment is assembled from, so this is the only place the offset is
        ; still known — by the time `flushOpen` sees `openText` it is a string
        ; with no memory of where it was cut from.
        def aOff:[int]
        def ri:int 0
        def rn:int (array_length runs)
        while (ri < rn) {
            def r:MdRun (itemAt runs ri)
            if r.hardBreak {
                push aText ""
                push aRun ri
                push aSpace false
                push aBreak true
                push aOff 0
            } {
                def t:string r.text
                def tn:int (strlen t)
                def i:int 0
                while (i < tn) {
                    def start:int i
                    def c:int (charAt t i)
                    def isSpace:boolean (MdChar.isSpaceOrTab(c))
                    def scanning:boolean true
                    while scanning {
                        if (i >= tn) { scanning = false }
                        if scanning {
                            def c2:int (charAt t i)
                            def s2:boolean (MdChar.isSpaceOrTab(c2))
                            if (s2 == isSpace) { i = (i + 1) } { scanning = false }
                        }
                    }
                    push aText (substring t start i)
                    push aRun ri
                    push aSpace isSpace
                    push aBreak false
                    push aOff start
                }
            }
            ri = (ri + 1)
        }

        ; --- the greedy fill ----------------------------------------------
        def cur:MdLine (new MdLine())
        def usedWidth:double 0.0
        def openRun:int -1
        def openText:string ""
        def openOff:int 0
        ; What `openText` measures, carried forward instead of measured again.
        ; `prevAtom` is the last atom that went in, and `prevAtomW` what it
        ; measures alone — the pair that lets the next atom be charged its
        ; advance AND its kern without re-reading the whole segment.
        def openW:double 0.0
        def prevAtom:string ""
        def prevAtomW:double 0.0
        def ai:int 0
        def an:int (array_length aText)
        def guard:int 0
        while (ai < an) {
            guard = (guard + 1)
            if (guard > 2000000) { ai = an }
            if (ai < an) {
                def hard:boolean (itemAt aBreak ai)
                def isSpace:boolean (itemAt aSpace ai)
                def segCount:int (array_length cur.segs)
                def lineEmpty:boolean ((segCount == 0) && ((strlen openText) == 0))
                if hard {
                    usedWidth = (this.flushOpen(cur runs openRun openText openOff usedWidth))
                    openRun = -1
                    openText = ""
                    openOff = 0
                    openW = 0.0
                    prevAtom = ""
                    prevAtomW = 0.0
                    def done:MdLine (this.finishLine(cur))
                    push lines done
                    cur = (new MdLine())
                    usedWidth = 0.0
                    ai = (ai + 1)
                } {
                    if (isSpace && lineEmpty) {
                        ; a wrapped line does not begin with the space it
                        ; wrapped at
                        ai = (ai + 1)
                    } {
                        def r:int (itemAt aRun ai)
                        def t:string (itemAt aText ai)
                        def run:MdRun (itemAt runs r)
                        def candidate:double 0.0
                        ; What the line measures with this atom on it, and —
                        ; when it is taken — what the open segment then
                        ; measures.
                        ;
                        ; Measuring `openText + t` outright is what this did
                        ; first, and it re-read the whole open segment once per
                        ; word: quadratic in the segment, with a cache entry
                        ; per prefix. A kern pair depends only on the two
                        ; codepoints either side of the join, so `prevAtom + t`
                        ; is charged the same advance and the same pair as the
                        ; whole string would be — the growth is
                        ; `measure(prevAtom + t) - measure(prevAtom)`, and the
                        ; running total stays the number a whole-string
                        ; measurement gives.
                        def grown:double 0.0
                        if (r == openRun) {
                            def joined:double (this.measureRun((prevAtom + t) run))
                            grown = ((openW + joined) - prevAtomW)
                            candidate = (usedWidth + grown)
                            ; Near the break, throw the running total away and
                            ; ask for the whole segment. A sum of parts and a
                            ; single measurement agree to the last bit only by
                            ; luck, and this is the one place where the last
                            ; bit decides where the line ends.
                            def slack:double (candidate - maxWidth)
                            if (slack < 0.0) {
                                slack = (0.0 - slack)
                            }
                            if (slack < 1.0) {
                                grown = (this.measureRun((openText + t) run))
                                candidate = (usedWidth + grown)
                            }
                        } {
                            def openRunObj:MdRun run
                            if (openRun >= 0) { openRunObj = (itemAt runs openRun) }
                            def openExact:double 0.0
                            if (openRun >= 0) { openExact = (this.measureRun(openText openRunObj)) }
                            grown = (this.measureRun(t run))
                            candidate = ((usedWidth + openExact) + grown)
                        }
                        def startsSegment:boolean (r != openRun)
                        if (isSpace && startsSegment) {
                            ; A space that would OPEN a segment becomes pure
                            ; advance instead of text.
                            ;
                            ; It has no glyph, so nothing is lost — and every
                            ; consumer that trims the edges of a text run (an
                            ; HTML preview does; so does anything that treats
                            ; a run as a line box) then draws the same
                            ; geometry as the PDF. Before this, `[LICENSE]`
                            ; followed by ` for details` lost the space
                            ; between them in the preview while the PDF kept
                            ; it: one layout, two pictures.
                            usedWidth = (this.flushOpen(cur runs openRun openText openOff usedWidth))
                            openRun = -1
                            openText = ""
                            openOff = 0
                            openW = 0.0
                            prevAtom = ""
                            prevAtomW = 0.0
                            usedWidth = (usedWidth + (this.measureRun(t run)))
                            ai = (ai + 1)
                        } {
                        def overflows:boolean ((candidate > maxWidth) && (! lineEmpty) && (! isSpace))
                        if overflows {
                            usedWidth = (this.flushOpen(cur runs openRun openText openOff usedWidth))
                            openRun = -1
                            openText = ""
                            openOff = 0
                            openW = 0.0
                            prevAtom = ""
                            prevAtomW = 0.0
                            def wrapped:MdLine (this.finishLine(cur))
                            push lines wrapped
                            cur = (new MdLine())
                            usedWidth = 0.0
                        } {
                            if (r == openRun) {
                                openText = (openText + t)
                            } {
                                usedWidth = (this.flushOpen(cur runs openRun openText openOff usedWidth))
                                openRun = r
                                openText = t
                                openOff = (itemAt aOff ai)
                            }
                            openW = grown
                            prevAtom = t
                            prevAtomW = (this.measureRun(t run))
                            ai = (ai + 1)
                        }
                        }
                    }
                }
            }
        }
        usedWidth = (this.flushOpen(cur runs openRun openText openOff usedWidth))
        def leftover:int (array_length cur.segs)
        def any:int (array_length lines)
        if ((leftover > 0) || (any == 0)) {
            def last:MdLine (this.finishLine(cur))
            push lines last
        }
        return lines
    }

    ; The open segment, measured and placed. Returns the new used width.
    fn flushOpen:double (cur:MdLine runs:[MdRun] openRun:int openText:string openOff:int usedWidth:double) {
        if (openRun < 0) { return usedWidth }
        def len:int (strlen openText)
        if (len == 0) { return usedWidth }
        def run:MdRun (itemAt runs openRun)
        def seg:MdSeg (new MdSeg())
        seg.text = openText
        ; Where this piece sits in the document. `openOff` is how far into the
        ; run's TEXT it started, and text and source are the same length only
        ; where the run holds no escape and no entity — so the answer is
        ; clamped to the run's own span rather than allowed to run past the
        ; node it belongs to. `MdSrcMapScan` is what says how often the two
        ; are the same string: on CommonMark's own corpus, every time it can
        ; be checked at all.
        if (run.srcStart >= 0) {
            def at:int (run.srcStart + openOff)
            if (run.srcEnd >= run.srcStart) {
                if (at > run.srcEnd) { at = run.srcEnd }
            }
            seg.srcStart = at
            def upto:int (at + len)
            if (run.srcEnd >= run.srcStart) {
                if (upto > run.srcEnd) { upto = run.srcEnd }
            }
            seg.srcLen = (upto - at)
            if (seg.srcLen < 0) { seg.srcLen = 0 }
        }
        seg.family = run.family
        seg.size = run.size
        seg.bold = run.bold
        seg.italic = run.italic
        seg.color = run.color
        seg.code = run.code
        seg.link = run.link
        seg.x = usedWidth
        seg.w = (this.measureRun(openText run))
        push cur.segs seg
        return (usedWidth + seg.w)
    }

    ; A line's height and baseline are the maximum over its segments, so a
    ; small code span inside larger prose does not pull the line up.
    fn finishLine:MdLine (cur:MdLine) {
        def n:int (array_length cur.segs)
        def height:double (style.bodySize * style.lineHeight)
        def ascent:double (style.bodySize * 0.9)
        def width:double 0.0
        if (n > 0) {
            ; the trailing space a wrap left behind is not part of the line
            def last:MdSeg (itemAt cur.segs (n - 1))
            def trimmed:string (MdLayout.trimTrailing(last.text))
            def tlen:int (strlen trimmed)
            def olen:int (strlen last.text)
            if (tlen != olen) {
                last.text = trimmed
                ; …and the source it covers shrinks with it, or a caret
                ; dragged to the end of a wrapped line lands on a space the
                ; line no longer draws.
                if (last.srcLen > (olen - tlen)) {
                    last.srcLen = (last.srcLen - (olen - tlen))
                } {
                    last.srcLen = 0
                }
                def r:MdRun (new MdRun())
                r.family = last.family
                r.size = last.size
                r.bold = last.bold
                r.italic = last.italic
                last.w = (this.measureRun(trimmed r))
            }
            height = 0.0
            def i:int 0
            while (i < n) {
                def seg:MdSeg (itemAt cur.segs i)
                def face:string (style.faceFor(seg.family seg.bold seg.italic))
                def m:EVGTextMetrics (engine.measureRun("Hg" face seg.size))
                def h:double (seg.size * style.lineHeight)
                if (h > height) { height = h }
                if (m.ascent > ascent) { ascent = m.ascent }
                width = (seg.x + seg.w)
                i = (i + 1)
            }
        }
        cur.height = height
        cur.ascent = ascent
        cur.width = width
        return cur
    }

    sfn leadingSpaces:int (v:string) {
        def n:int (strlen v)
        def i:int 0
        while (i < n) {
            def c:int (charAt v i)
            if (! (MdChar.isSpaceOrTab(c))) { return i }
            i = (i + 1)
        }
        return n
    }

    sfn trailingSpaces:int (v:string n:int lead:int) {
        def i:int n
        def going:boolean true
        while going {
            if (i <= lead) { going = false }
            if going {
                def c:int (charAt v (i - 1))
                if (MdChar.isSpaceOrTab(c)) { i = (i - 1) } { going = false }
            }
        }
        return (n - i)
    }

    sfn trimTrailing:string (v:string) {
        def n:int (strlen v)
        def i:int n
        def going:boolean true
        while going {
            if (i <= 0) { going = false }
            if going {
                def c:int (charAt v (i - 1))
                if (MdChar.isSpaceOrTab(c)) { i = (i - 1) } { going = false }
            }
        }
        return (substring v 0 i)
    }

    ; ----------------------------------------------------------------------
    ; Tables
    ; ----------------------------------------------------------------------
    fn table:void (node:MdNode x:double w:double) {
        def rows:int (node.childCount())
        if (rows == 0) { return }
        def head:MdNode (node.childAt(0))
        def cols:int (head.childCount())
        if (cols == 0) { return }
        def widths:[double] (this.tableWidths(node w))
        def r2:int 0
        while (r2 < rows) {
            def row:MdNode (node.childAt(r2))
            this.tableRow(row x widths cols)
            r2 = (r2 + 1)
        }
        cursorY = (cursorY + style.paraSpacing)
    }

    ; ----------------------------------------------------------------------
    ; A picture
    ; ----------------------------------------------------------------------
    ;
    ; `![alt](logo.png)` on a paragraph of its own becomes a picture; anywhere
    ; else it stays ALT TEXT.
    ;
    ; That split is deliberate rather than a first step. A picture in the
    ; middle of a sentence has to sit on a text baseline, which is a different
    ; question from putting a block on a page and one markdown almost never
    ; asks — every `![]()` in this repository's own documents is on a line of
    ; its own. A block picture is the case that exists, and it is the one that
    ; reaches a deck, a PDF and a slide.
    ;
    ; A picture nobody can find stays alt text too. That is not a fallback
    ; that hides a problem: it is exactly what the reader sees in the preview,
    ; so the preview and the export are missing the same picture rather than
    ; disagreeing about it. `missingImages` counts them.
    fn pictureBlock:boolean (node:MdNode x:double w:double) {
        if (! haveImages) { return false }
        def img:MdNode (MdLayout.loneImage(node))
        if (img.kind != "image") { return false }
        def path:string (images.resolve(img.destination docDir))
        if ((strlen path) == 0) {
            missingImages = (missingImages + 1)
            return false
        }
        def st:VfsStat (images.stat(path))
        if (! st.found) {
            missingImages = (missingImages + 1)
            return false
        }

        ; Its own size, never scaled UP — a 64pt icon in a 468pt column is a
        ; 64pt icon — and fitted down when it is wider than the column.
        def natW:double (to_double st.pixelW)
        def natH:double (to_double st.pixelH)
        def useW:double natW
        def useH:double natH
        if (natW <= 0.0) {
            useW = w
            useH = (w * 0.5)
        }
        def wantAttr:string (node.attrValue("width"))
        def asked:double (MdEmbedKinds.widthOf(wantAttr w))
        if (asked < useW) {
            if (useW > 0.0) {
                useH = (useH * (asked / useW))
                useW = asked
            }
        }
        if (useW > w) {
            useH = (useH * (w / useW))
            useW = w
        }

        def y:double (this.reserve(useH))
        def b:MdBox (new MdBox())
        b.kind = 4
        b.x = x
        b.y = y
        b.w = useW
        b.h = useH
        b.imagePath = path
        b.imageAlt = (img.plainText())
        b.imageNaturalW = st.pixelW
        b.imageNaturalH = st.pixelH
        this.emit(b)
        cursorY = ((y + useH) + style.paraSpacing)
        return true
    }

    ; The one image a paragraph holds, when that is ALL it holds. A caption
    ; beside the picture makes it a sentence with a picture in it, and a
    ; sentence is laid out as a sentence.
    sfn loneImage:MdNode (node:MdNode) {
        def found:MdNode (new MdNode())
        def i:int 0
        def n:int (node.childCount())
        while (i < n) {
            def c:MdNode (node.childAt(i))
            if (c.kind == "image") {
                if (found.kind == "image") { return (new MdNode()) }
                found = c
            } {
                if (c.kind == "text") {
                    if ((strlen (trim c.literal)) > 0) { return (new MdNode()) }
                } {
                    if (c.kind != "softbreak") { return (new MdNode()) }
                }
            }
            i = (i + 1)
        }
        return found
    }

    ; How wide each column is, in the space the table has.
    ;
    ; Split out of `table` so that the DECK can ask it: `MdToPptx` builds a
    ; real PowerPoint table and has to give it the same grid, and a second
    ; implementation of this would be a second table algorithm to keep in
    ; step with the first. One algorithm, two callers.
    fn tableWidths:[double] (node:MdNode w:double) {
        def widths:[double]
        def rows:int (node.childCount())
        if (rows == 0) { return widths }
        def head:MdNode (node.childAt(0))
        def cols:int (head.childCount())
        if (cols == 0) { return widths }

        ; TWO widths per column, not one: what the cell wants if nothing
        ; wrapped (MAX-CONTENT) and what it needs before a word has to be
        ; broken in half (MIN-CONTENT).
        ;
        ; Scaling the max-content widths by one factor — which is what this
        ; did — is only right when every column shrinks equally well, and a
        ; column of one-word labels beside a column of paragraphs is the case
        ; where it is not. `Area | Current expectation` in this repository's
        ; own README came out with a first column narrower than the word
        ; `Host/runtime`, which then ran out of its cell and across the text
        ; in the next one: unreadable, and unreadable in a way a wider table
        ; would not have been.
        ;
        ; So: no column below its min-content width, and the room that is left
        ; shared out in proportion to how much each column would still like.
        ; That is the table algorithm HTML has had since HTML 4 §17.5.2, and
        ; it is what a browser does with this same markdown.
        def natural:[double]
        def minimum:[double]
        def c:int 0
        while (c < cols) {
            def wid:double 0.0
            def least:double 0.0
            def r:int 0
            while (r < rows) {
                def row:MdNode (node.childAt(r))
                def rc:int (row.childCount())
                if (c < rc) {
                    def cell:MdNode (row.childAt(c))
                    def base:MdRun (this.baseRun())
                    if cell.isHeader { base.bold = true }
                    def runs:[MdRun] (this.inlineRuns(cell base))
                    def cw:double (this.runsWidth(runs))
                    if (cw > wid) { wid = cw }
                    ; The narrowest column this cell can be set in, asked of
                    ; the line breaker itself rather than guessed from the
                    ; text: break it into a column of one point and the widest
                    ; line that comes back is the widest thing that cannot be
                    ; broken. Guessing it from spaces would disagree with the
                    ; breaker exactly where it matters — `ts_parser` is three
                    ; runs and one word.
                    def tight:[MdLine] (this.breakRuns(runs 1.0))
                    def ti:int 0
                    def tn:int (array_length tight)
                    while (ti < tn) {
                        def tl:MdLine (itemAt tight ti)
                        if (tl.width > least) { least = tl.width }
                        ti = (ti + 1)
                    }
                }
                r = (r + 1)
            }
            push natural (wid + (style.cellPadX * 2.0))
            push minimum (least + (style.cellPadX * 2.0))
            c = (c + 1)
        }
        def total:double 0.0
        def leastTotal:double 0.0
        def k:int 0
        while (k < cols) {
            total = (total + (itemAt natural k))
            leastTotal = (leastTotal + (itemAt minimum k))
            k = (k + 1)
        }
        def j:int 0
        if (total <= w) {
            ; It fits as written.
            while (j < cols) {
                push widths (itemAt natural j)
                j = (j + 1)
            }
        } {
            if (leastTotal >= w) {
                ; Even unbreakable, it does not fit. The table is then wider
                ; than the column it sits in, which is visible and honest;
                ; squeezing below this point does not make it fit, it only
                ; moves the overflow inside the cells where it lands on top of
                ; the neighbouring text.
                while (j < cols) {
                    push widths (itemAt minimum j)
                    j = (j + 1)
                }
            } {
                def room:double (w - leastTotal)
                def want:double (total - leastTotal)
                while (j < cols) {
                    def lo:double (itemAt minimum j)
                    def hi:double (itemAt natural j)
                    def share:double (((hi - lo) / want) * room)
                    push widths (lo + share)
                    j = (j + 1)
                }
            }
        }
        return widths
    }

    fn runsWidth:double (runs:[MdRun]) {
        def total:double 0.0
        def i:int 0
        def n:int (array_length runs)
        while (i < n) {
            def r:MdRun (itemAt runs i)
            total = (total + (this.measureRun(r.text r)))
            i = (i + 1)
        }
        return total
    }

    fn tableRow:void (row:MdNode x:double widths:[double] cols:int) {
        ; Every cell is broken to its own column first, so the row is as tall
        ; as the tallest of them.
        def heights:[double]
        def rowH:double 0.0
        def c:int 0
        def rc:int (row.childCount())
        while (c < cols) {
            def h:double ((style.bodySize * style.lineHeight) + (style.cellPadY * 2.0))
            if (c < rc) {
                def cell:MdNode (row.childAt(c))
                def base:MdRun (this.baseRun())
                if cell.isHeader { base.bold = true }
                def runs:[MdRun] (this.inlineRuns(cell base))
                def inner:double ((itemAt widths c) - (style.cellPadX * 2.0))
                def lines:[MdLine] (this.breakRuns(runs inner))
                def sum:double 0.0
                def i:int 0
                def n:int (array_length lines)
                while (i < n) {
                    def ln:MdLine (itemAt lines i)
                    sum = (sum + ln.height)
                    i = (i + 1)
                }
                h = (sum + (style.cellPadY * 2.0))
            }
            push heights h
            if (h > rowH) { rowH = h }
            c = (c + 1)
        }
        def y:double (this.reserve(rowH))
        def cx:double x
        def c2:int 0
        while (c2 < cols) {
            def cw:double (itemAt widths c2)
            def isHead:boolean false
            if (c2 < rc) {
                def cell0:MdNode (row.childAt(c2))
                isHead = cell0.isHeader
            }
            if isHead {
                this.emit((MdBox.rect(cx y cw rowH style.tableHeadBackground)))
            }
            this.emit((MdBox.outline(cx y cw rowH style.tableBorder 1.0)))
            if (c2 < rc) {
                def cell:MdNode (row.childAt(c2))
                def base:MdRun (this.baseRun())
                if cell.isHeader { base.bold = true }
                def runs:[MdRun] (this.inlineRuns(cell base))
                def inner:double (cw - (style.cellPadX * 2.0))
                def lines:[MdLine] (this.breakRuns(runs inner))
                def ty:double (y + style.cellPadY)
                def i:int 0
                def n:int (array_length lines)
                while (i < n) {
                    def ln:MdLine (itemAt lines i)
                    def s:int 0
                    def sn:int (array_length ln.segs)
                    while (s < sn) {
                        def seg:MdSeg (itemAt ln.segs s)
                        def tx:double ((cx + style.cellPadX) + seg.x)
                        if (cell.align == "right") {
                            tx = ((((cx + cw) - style.cellPadX) - ln.width) + seg.x)
                        }
                        if (cell.align == "center") {
                            def free:double (inner - ln.width)
                            tx = (((cx + style.cellPadX) + (free / 2.0)) + seg.x)
                        }
                        def b:MdBox (MdBox.text(seg.text tx ty seg.w ln.height))
                        ; The cell's own source range, the same way a
                        ; paragraph's segments carry theirs. Without it
                        ; `emit` left every box in the table pointing at the
                        ; TABLE's start, so a click anywhere in the grid put
                        ; the caret on the first pipe and typing landed
                        ; there — which is why a cell could not be edited in
                        ; place. A cell is a source range like any other;
                        ; typing in one is an ordinary patch.
                        b.segSrc = seg.srcStart
                        b.segLen = seg.srcLen
                        b.family = seg.family
                        b.size = seg.size
                        b.bold = seg.bold
                        b.italic = seg.italic
                        b.color = seg.color
                        b.link = seg.link
                        this.emit(b)
                        s = (s + 1)
                    }
                    ty = (ty + ln.height)
                    i = (i + 1)
                }
            }
            cx = (cx + cw)
            c2 = (c2 + 1)
        }
        cursorY = (y + rowH)
    }
}

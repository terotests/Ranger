; ============================================================================
; MdCssLimits.rgr — how far a value in a sheet may go before the layout stops
; ============================================================================
;
; A sheet is typed by a person, and a person types `font-size: 2020px` (or a
; slider runs to the end of its travel). The layout used to take any number
; it was given: a heading two thousand points tall is one glyph per slide, a
; slide split into dozens, and a picture of each glyph thousands of pixels
; tall for the renderer to keep. Nothing about that is an error the author
; can see — the page simply stops answering.
;
; So every number the layout reads from a sheet (or from the front matter, or
; from the reader's page size) has a SAFETY RANGE, and the layout clamps to it
; at the point it reads the style. The source is not touched: the sheet still
; says 2020px, the editor still shows it, and the slide is drawn as if it said
; the most it may. These are not the ranges a slider offers (`PresRange` in
; Sliqtly, a sixth of the slide for a margin): they are the edge past which a
; value is not a design any more, so they are wide.
;
; The range of a length is measured against the PAGE, because what breaks a
; layout is a value that is large next to the page it is laid out on:
;
;   page     the page's own width and height: 1in .. 200in
;   font     a font size: 1pt .. the page's shorter side
;   inset    the page's padding: up to 0.4 of the shorter side (a fifth of the
;            page stays for the content)
;   space    margins, gaps, indents, a picture's height: up to half the
;            longer side
;   pad      a block's own padding: up to a quarter of the shorter side
;   stroke   a border: up to an eighth of the shorter side
;   ratio    a line height: 0.5 .. 5
;
; A value that is not a number at all (NaN, infinite) is the low end of its
; range — the layout must never see one.
; ============================================================================

Import "MdStyle.rgr"

class MdCssLimits {
    ; Pages a layout may run to by overflowing, past the slides and sheets a
    ; document asks for. A block taller than any page used to be cut onto as
    ; many as it took; past this the rest stays on the last page.
    sfn pageBudget:int () {
        return 1000
    }

    ; What the property does, from its CSS name: "page", "font", "inset",
    ; "space", "pad", "stroke", "ratio" or "" (not a length this knows).
    ; `sel` is the selector it is written under (page, chart, h1, …).
    sfn kindOf:string (prop:string sel:string) {
        def n:int (strlen prop)
        if ((n >= 9) && ((substring prop (n - 9) n) == "font-size")) { return "font" }
        if ((prop == "header-size") || (prop == "footer-size")) { return "font" }
        if (prop == "line-height") { return "ratio" }
        if ((sel == "page") && ((prop == "width") || (prop == "height"))) { return "page" }
        if ((indexOf prop "border") == 0) {
            if ((indexOf prop "width") >= 0) { return "stroke" }
            return ""
        }
        if ((prop == "outline-width") || (prop == "stroke-width")) { return "stroke" }
        def isPad:boolean ((indexOf prop "padding") == 0)
        if (isPad && ((sel == "page") || (sel == "deck"))) { return "inset" }
        if (isPad && (MdCssLimits.isIndent(prop sel))) { return "space" }
        if isPad { return "pad" }
        if ((indexOf prop "margin") == 0) { return "space" }
        if ((indexOf prop "gap") >= 0) { return "space" }
        if ((indexOf prop "height") >= 0) { return "space" }
        if ((indexOf prop "width") >= 0) { return "space" }
        if ((prop == "text-indent") || (prop == "indent")) { return "space" }
        return ""
    }

    ; A list's or a quote's left padding is the indent beside the block, not
    ; padding inside it.
    sfn isIndent:boolean (prop:string sel:string) {
        if (prop != "padding-left") { return false }
        return ((sel == "list") || ((sel == "ul") || ((sel == "ol") || (sel == "blockquote"))))
    }

    sfn shortOf:double (w:double h:double) {
        if (h < w) { return h }
        return w
    }

    sfn longOf:double (w:double h:double) {
        if (h > w) { return h }
        return w
    }

    ; The page a range is measured against, itself kept sane: a page of 0 or
    ; of a million inches must not make every other range 0 or a million.
    sfn sanePage:double (v:double) {
        return (MdCssLimits.into(v (MdCssLimits.lo("page" 0.0 0.0)) (MdCssLimits.hi("page" 0.0 0.0))))
    }

    ; The low end of a kind's range, in points (a plain ratio for "ratio").
    sfn lo:double (kind:string pageW:double pageH:double) {
        if (kind == "page") { return 72.0 }
        if (kind == "font") { return 1.0 }
        if (kind == "ratio") { return 0.5 }
        return 0.0
    }

    ; The high end, against a page of pageW × pageH points.
    sfn hi:double (kind:string pageW:double pageH:double) {
        if (kind == "page") { return 14400.0 }
        if (kind == "ratio") { return 5.0 }
        def w:double (MdCssLimits.sanePage(pageW))
        def h:double (MdCssLimits.sanePage(pageH))
        def short:double (MdCssLimits.shortOf(w h))
        def long:double (MdCssLimits.longOf(w h))
        if (kind == "font") {
            if (short < 72.0) { return 72.0 }
            return short
        }
        if (kind == "inset") { return (short * 0.4) }
        if (kind == "space") { return (long / 2.0) }
        if (kind == "pad") { return (short / 4.0) }
        if (kind == "stroke") { return (short / 8.0) }
        return long
    }

    ; v into lo..hi; NaN and infinities to lo.
    sfn into:double (v:double lo:double hi:double) {
        if (v != v) { return lo }
        if (v < lo) { return lo }
        if (v > hi) { return hi }
        return v
    }

    ; One value of a kind, against the page.
    sfn clampKind:double (kind:string v:double pageW:double pageH:double) {
        return (MdCssLimits.into(v (MdCssLimits.lo(kind pageW pageH)) (MdCssLimits.hi(kind pageW pageH))))
    }

    ; One CSS property's value, in points, against the page: what a reader
    ; outside `MdStyle` (a chart's defaults, a figure's size) clamps with.
    ; A property this does not know is returned as it is, unless it is not a
    ; number.
    sfn clamp:double (prop:string sel:string v:double pageW:double pageH:double) {
        def kind:string (MdCssLimits.kindOf(prop sel))
        if ((strlen kind) == 0) {
            if (v != v) { return 0.0 }
            return v
        }
        return (MdCssLimits.clampKind(kind v pageW pageH))
    }

    ; Whether the value is already in range: what an editor asks to say
    ; "this is past what is drawn".
    sfn inRange:boolean (prop:string sel:string v:double pageW:double pageH:double) {
        return ((MdCssLimits.clamp(prop sel v pageW pageH)) == v)
    }

    ; A size that may be 0 for "not set" (the header's and footer's own).
    sfn optional:double (kind:string v:double pageW:double pageH:double) {
        if (v == 0.0) { return 0.0 }
        return (MdCssLimits.clampKind(kind v pageW pageH))
    }

    ; Every number in a style, into its range. The page first, because every
    ; other range is measured against it.
    sfn clampStyle:void (s:MdStyle) {
        s.pageWidth = (MdCssLimits.clampKind("page" s.pageWidth 0.0 0.0))
        s.pageHeight = (MdCssLimits.clampKind("page" s.pageHeight 0.0 0.0))
        def w:double s.pageWidth
        def h:double s.pageHeight
        s.margin = (MdCssLimits.clampKind("inset" s.margin w h))

        s.bodySize = (MdCssLimits.clampKind("font" s.bodySize w h))
        s.h1Size = (MdCssLimits.clampKind("font" s.h1Size w h))
        s.h2Size = (MdCssLimits.clampKind("font" s.h2Size w h))
        s.h3Size = (MdCssLimits.clampKind("font" s.h3Size w h))
        s.h4Size = (MdCssLimits.clampKind("font" s.h4Size w h))
        s.h5Size = (MdCssLimits.clampKind("font" s.h5Size w h))
        s.h6Size = (MdCssLimits.clampKind("font" s.h6Size w h))
        s.codeSize = (MdCssLimits.clampKind("font" s.codeSize w h))
        s.furnitureSize = (MdCssLimits.clampKind("font" s.furnitureSize w h))
        s.headerSize = (MdCssLimits.optional("font" s.headerSize w h))
        s.footerSize = (MdCssLimits.optional("font" s.footerSize w h))

        s.lineHeight = (MdCssLimits.clampKind("ratio" s.lineHeight w h))
        s.codeLineHeight = (MdCssLimits.clampKind("ratio" s.codeLineHeight w h))

        s.paraSpacing = (MdCssLimits.clampKind("space" s.paraSpacing w h))
        s.headingSpaceBefore = (MdCssLimits.clampKind("space" s.headingSpaceBefore w h))
        s.headingSpaceAfter = (MdCssLimits.clampKind("space" s.headingSpaceAfter w h))
        s.listIndent = (MdCssLimits.clampKind("space" s.listIndent w h))
        s.markerGap = (MdCssLimits.clampKind("space" s.markerGap w h))
        s.listTightSpacing = (MdCssLimits.clampKind("space" s.listTightSpacing w h))
        s.quoteIndent = (MdCssLimits.clampKind("space" s.quoteIndent w h))
        s.embedSpacing = (MdCssLimits.clampKind("space" s.embedSpacing w h))
        s.imgMaxHeight = (MdCssLimits.clampKind("space" s.imgMaxHeight w h))
        s.headerImageH = (MdCssLimits.clampKind("space" s.headerImageH w h))
        s.footerImageH = (MdCssLimits.clampKind("space" s.footerImageH w h))

        s.codePadding = (MdCssLimits.clampKind("pad" s.codePadding w h))
        s.quotePadY = (MdCssLimits.clampKind("pad" s.quotePadY w h))
        s.cellPadX = (MdCssLimits.clampKind("pad" s.cellPadX w h))
        s.cellPadY = (MdCssLimits.clampKind("pad" s.cellPadY w h))

        s.quoteBarWidth = (MdCssLimits.clampKind("stroke" s.quoteBarWidth w h))
    }

    ; A block's own `font-size` is a multiple of the size it would have had
    ; (`{.lead}` at 1.3em). The multiple that takes `base` out of the font
    ; range is cut to the one that lands on its edge.
    sfn ratio:double (r:double base:double pageW:double pageH:double) {
        if ((r != r) || (base <= 0.0)) { return 1.0 }
        def size:double (MdCssLimits.clampKind("font" (base * r) pageW pageH))
        return (size / base)
    }
}

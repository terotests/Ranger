; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MdSemanticEdit.rgr — "make this bold", as a replacement of a range of text.
; ============================================================================
;
; This is the WYSIWYG part, and it is one table: an intent plus a selection,
; answered with ONE `MdEditOp`. Nothing here mutates a document; it decides
; what patch would.
;
; **Decided against the AST, not by a regular expression.** The difference is
; not tidiness. `**bold**` inside a code span is not bold, a `*` at the end of
; a word does not open emphasis, and which `*` pairs with which is settled by
; the delimiter stack after the whole line has been read. A rule written over
; the text gets all three wrong; the parser already got them right, and since
; Stage C every node it built carries the span of the source that made it. So
; "is this selection already bold" is a lookup, and "stop being bold" is the
; span of the `strong` node with its two delimiter runs cut off.
;
; **Two rules keep it honest.**
;
;   1. EVERY TOGGLE IS ITS OWN INVERSE. Applying it twice gives back bytes
;      identical to the input. That is the whole acceptance test and it is run
;      over the awkward cases, not the easy ones — a selection that starts
;      inside an existing `**` run, one that covers a code span, one that
;      straddles two blocks.
;
;   2. WHEN THE ANSWER IS NOT WELL DEFINED, REFUSE. Bolding a selection that
;      begins inside emphasis and ends outside it has no correct patch. A
;      controller that guesses produces markdown nobody typed; this one
;      answers with an empty op, and the caller says so in a status line.
;      `MdEditOp.isEmpty` is the refusal, and `refusal()` says which.
;
; **Nothing here normalises.** A line the intent did not touch comes out byte
; for byte, including the two spaces after a bullet and the pipes somebody
; lined up by hand. That is §1 of `PLAN_WYSIWYG.md` and it is the reason this
; file is a page of span arithmetic rather than a serializer.
; ============================================================================

Import "MdNode.rgr"
Import "MdBlock.rgr"
Import "MdEdit.rgr"
; The clipboard reader the .docx editor already has. It imports NOTHING — it
; is a tolerant scanner over the `text/html` a spreadsheet puts on the
; clipboard, not an XML parser — so markdown gets a spreadsheet range pasted
; as a table for the cost of one import and none of `gallery/docx_viewer`.
Import "../../docx_viewer/src/ClipboardTable.rgr"

class MdSemanticEdit {
    ; ----------------------------------------------------------------------
    ; Finding the node an intent is about
    ; ----------------------------------------------------------------------

    ; The innermost node of `kind` whose span CONTAINS [a,b]. The innermost
    ; because `***x***` is a strong inside an emph and "stop being bold" has
    ; to take the right one of the two.
    sfn enclosing:int (out:[MdNode] n:MdNode kind:string a:int b:int) {
        def hit:int 0
        if (n.kind == kind) {
            if ((n.srcStart >= 0) && ((n.srcStart <= a) && (n.srcEnd >= b))) {
                clear out
                push out n
                hit = 1
            }
        }
        def i:int 0
        def cnt:int (n.childCount())
        while (i < cnt) {
            def k:MdNode (n.childAt(i))
            def deeper:int (MdSemanticEdit.enclosing(out k kind a b))
            if (deeper > 0) { hit = 1 }
            i = (i + 1)
        }
        return hit
    }

    ; Does any node of `kind` OVERLAP [a,b) without containing it and without
    ; being contained by it? That is the case with no correct answer.
    sfn straddles:boolean (n:MdNode kind:string a:int b:int) {
        if (n.kind == kind) {
            if (n.srcStart >= 0) {
                def s:int n.srcStart
                def e:int n.srcEnd
                def overlaps:boolean ((s < b) && (e > a))
                def contains:boolean ((s <= a) && (e >= b))
                def inside:boolean ((s >= a) && (e <= b))
                if (overlaps && ((! contains) && (! inside))) {
                    return true
                }
            }
        }
        def i:int 0
        def cnt:int (n.childCount())
        while (i < cnt) {
            def k:MdNode (n.childAt(i))
            if (MdSemanticEdit.straddles(k kind a b)) { return true }
            i = (i + 1)
        }
        return false
    }

    ; The innermost paragraph or heading holding `off` — the block an intent
    ; about a whole line is about.
    sfn blockAt:int (out:[MdNode] n:MdNode off:int) {
        def hit:int 0
        if ((n.kind == "paragraph") || (n.kind == "heading")) {
            if ((n.srcStart >= 0) && ((n.srcStart <= off) && (n.srcEnd >= off))) {
                clear out
                push out n
                hit = 1
            }
        }
        def i:int 0
        def cnt:int (n.childCount())
        while (i < cnt) {
            def k:MdNode (n.childAt(i))
            def deeper:int (MdSemanticEdit.blockAt(out k off))
            if (deeper > 0) { hit = 1 }
            i = (i + 1)
        }
        return hit
    }

    ; ----------------------------------------------------------------------
    ; Typing must not un-write the markup
    ; ----------------------------------------------------------------------
    ;
    ; A delimiter run closes emphasis only when the character before it is not
    ; whitespace. So a space typed at the inside edge of a bold word —
    ; `**travels|**` — turns it into `**travels **`, which is not bold at all,
    ; and four asterisks the reader never typed appear in the document they
    ; are reading. The same at the other end: `**|travels**` + a space is
    ; `** travels**`, and the markers show again.
    ;
    ; That is the one way a plain keystroke can take valid markup apart, and
    ; it is the one the reader reported. Every WYSIWYG editor answers it the
    ; same way: the space goes on the OUTSIDE of the run.
    ;
    ;     **travels|**   + " "   ──►   **travels**|
    ;     **|travels**   + " "   ──►    |**travels**
    ;
    ; **It stays one op, so it stays one undo.** The range replaced is the
    ; delimiter run itself, rewritten with the whitespace on the far side of
    ; it — not the insertion followed by a repair, which would be two entries
    ; on the stack and a half-broken document in between.
    ;
    ; Inline code is deliberately not guarded: a space inside backticks is
    ; ordinary content, and `` ` a ` `` is a perfectly good code span.

    sfn isSpaceCode:boolean (c:int) {
        if (c == 32) { return true }
        if (c == 9) { return true }
        return false
    }

    ; The three characters a delimiter run can be made of. Which SPELLING a
    ; node used is read from the source rather than assumed, so `__bold__`
    ; is guarded exactly as `**bold**` is.
    sfn isMarkCode:boolean (c:int) {
        if (c == 42) { return true }
        if (c == 95) { return true }
        if (c == 126) { return true }
        return false
    }

    sfn isEmphKind:boolean (k:string) {
        if (k == "strong") { return true }
        if (k == "emph") { return true }
        if (k == "strike") { return true }
        return false
    }

    sfn leadSpace:int (s:string) {
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            if (! (MdSemanticEdit.isSpaceCode((charAt s i)))) {
                return i
            }
            i = (i + 1)
        }
        return n
    }

    sfn tailSpace:int (s:string) {
        def n:int (strlen s)
        def k:int 0
        while (k < n) {
            if (! (MdSemanticEdit.isSpaceCode((charAt s ((n - k) - 1))))) {
                return k
            }
            k = (k + 1)
        }
        return n
    }

    ; How long the delimiter run that OPENS this node is, 0 when it does not
    ; start with one.
    sfn openerLen:int (src:string n:MdNode) {
        def i:int n.srcStart
        def len:int (strlen src)
        if (i < 0) { return 0 }
        if (i >= len) { return 0 }
        def c:int (charAt src i)
        if (! (MdSemanticEdit.isMarkCode(c))) { return 0 }
        def k:int 0
        while ((i + k) < len) {
            if ((charAt src (i + k)) != c) {
                return k
            }
            k = (k + 1)
        }
        return k
    }

    ; …and the one that closes it.
    sfn closerLen:int (src:string n:MdNode) {
        def e:int n.srcEnd
        def len:int (strlen src)
        if (e <= 0) { return 0 }
        if (e > len) { return 0 }
        def c:int (charAt src (e - 1))
        if (! (MdSemanticEdit.isMarkCode(c))) { return 0 }
        def k:int 0
        while (((e - k) - 1) >= 0) {
            if ((charAt src ((e - k) - 1)) != c) {
                return k
            }
            k = (k + 1)
        }
        return k
    }

    ; The innermost emphasis node one of whose INNER edges `off` sits on. The
    ; innermost because `***x***` is a strong inside an emph and the run that
    ; a space would break is the inner one.
    sfn edgeNode:int (out:[MdNode] src:string n:MdNode off:int) {
        def hit:int 0
        if (MdSemanticEdit.isEmphKind(n.kind)) {
            if (n.srcStart >= 0) {
                def ol:int (MdSemanticEdit.openerLen(src n))
                def cl:int (MdSemanticEdit.closerLen(src n))
                if ((ol > 0) && (cl > 0)) {
                    def opens:boolean (off == (n.srcStart + ol))
                    def closes:boolean (off == (n.srcEnd - cl))
                    if (opens || closes) {
                        clear out
                        push out n
                        hit = 1
                    }
                }
            }
        }
        def i:int 0
        def cnt:int (n.childCount())
        while (i < cnt) {
            def k:MdNode (n.childAt(i))
            def deeper:int (MdSemanticEdit.edgeNode(out src k off))
            if (deeper > 0) { hit = 1 }
            i = (i + 1)
        }
        return hit
    }

    ; The op that inserts `s` at `off` without taking the markup apart, or
    ; nothing when the plain insertion is already safe. `out` gets the op.
    sfn guardWhitespace:int (out:[MdEditOp] src:string doc:MdNode off:int s:string) {
        clear out
        def lead:int (MdSemanticEdit.leadSpace(s))
        def tail:int (MdSemanticEdit.tailSpace(s))
        if ((lead == 0) && (tail == 0)) { return 0 }
        def hit:[MdNode]
        if ((MdSemanticEdit.edgeNode(hit src doc off)) == 0) { return 0 }
        def n:MdNode (itemAt hit 0)
        def ol:int (MdSemanticEdit.openerLen(src n))
        def cl:int (MdSemanticEdit.closerLen(src n))
        def slen:int (strlen s)

        ; At the closing edge, the trailing whitespace of what is being typed
        ; is what would break the run, so it moves past it.
        if (off == (n.srcEnd - cl)) {
            if (tail > 0) {
                def core:string (substring s 0 (slen - tail))
                def ws:string (substring s (slen - tail) slen)
                def marker:string (substring src off n.srcEnd)
                push out (MdEdit.patch(src off n.srcEnd ((core + marker) + ws)))
                return 1
            }
        }
        ; At the opening edge it is the leading whitespace.
        if (off == (n.srcStart + ol)) {
            if (lead > 0) {
                def ws2:string (substring s 0 lead)
                def rest:string (substring s lead slen)
                def marker2:string (substring src n.srcStart off)
                push out (MdEdit.patch(src n.srcStart off ((ws2 + marker2) + rest)))
                return 1
            }
        }
        return 0
    }

    ; ----------------------------------------------------------------------
    ; Wrapping: bold, italic, strikethrough, inline code
    ; ----------------------------------------------------------------------

    ; The node kind each marker produces, so "is it already on" is asked of
    ; the tree rather than of the characters.
    ; ----------------------------------------------------------------------
    ; Which blocks a selection touches
    ; ----------------------------------------------------------------------
    ;
    ; Emphasis is an INLINE construct: a `**` run cannot cross a block
    ; boundary. Wrapping a selection that spans three list items in one marker
    ; pair therefore produces a document with no emphasis in it at all — four
    ; literal asterisks — which is what a reader saw when they selected a list
    ; and pressed bold. The markers did not "leak" from the preview to the
    ; source: the source IS the document, the patch was applied to it, and the
    ; preview was the parser being correct about a document that was wrong.
    ;
    ; So the unit of a wrap is the BLOCK, not the selection. These two
    ; functions find the blocks, and `toggleWrap` puts one marker pair inside
    ; each of them.
    sfn isInlineBlock:boolean (kind:string) {
        if (kind == "paragraph") { return true }
        if (kind == "heading") { return true }
        if (kind == "table_cell") { return true }
        return false
    }

    ; Every such block OVERLAPPING [a,b), in document order, flattened as
    ; start/end pairs.
    ;
    ; The list is RETURNED rather than grown through the parameter: `push` onto
    ; an array parameter lands on a copy on the Go target, which is a bug that
    ; has already cost this repository an empty routing grid once.
    sfn collectBlocks:[int] (out:[int] n:MdNode a:int b:int) {
        def res:[int] out
        if (MdSemanticEdit.isInlineBlock(n.kind)) {
            if (n.srcStart >= 0) {
                if ((n.srcStart < b) && (n.srcEnd > a)) {
                    push res n.srcStart
                    push res n.srcEnd
                }
            }
            ; Not deeper: the children of a paragraph are inline nodes, and an
            ; inline node is not a block a marker pair goes inside.
            return res
        }
        def i:int 0
        def cnt:int (n.childCount())
        while (i < cnt) {
            def k:MdNode (n.childAt(i))
            res = (MdSemanticEdit.collectBlocks(res k a b))
            i = (i + 1)
        }
        return res
    }

    ; The selection, cut up by block and tightened: what each block actually
    ; contributes. Two ints per clip.
    ;
    ; Used by `toggleWrap` to place the markers and by `refusalFor` to decide
    ; whether the answer is defined. One function for both, because a refusal
    ; computed over a different set of ranges from the edit is a refusal that
    ; does not describe the edit.
    sfn clipsOf:[int] (src:string doc:MdNode a:int b:int) {
        def clips:[int]
        def blocks:[int]
        blocks = (MdSemanticEdit.collectBlocks(blocks doc a b))
        def nb:int (to_int ((array_length blocks) / 2))
        def i:int 0
        while (i < nb) {
            def bs:int (itemAt blocks (i * 2))
            def be:int (itemAt blocks ((i * 2) + 1))
            def s:int bs
            def e:int be
            if (a > s) { s = a }
            if (b < e) { e = b }
            if (e > s) {
                def t:[int] (MdSemanticEdit.tighten(src s e))
                def ts:int (itemAt t 0)
                if (ts >= 0) {
                    push clips ts
                    push clips (itemAt t 1)
                }
            }
            i = (i + 1)
        }
        return clips
    }

    ; [s,e) with whitespace taken off both ends. A marker next to a space is
    ; not a delimiter — `** bold**` is two asterisks and a word — which is the
    ; same rule `guardWhitespace` above enforces from the other direction.
    ; Returns a start of -1 when nothing is left.
    sfn tighten:[int] (src:string s:int e:int) {
        def out:[int]
        def a:int s
        def b:int e
        while (a < b) {
            if (MdSemanticEdit.isEdgeSpace((charAt src a))) {
                a = (a + 1)
            } {
                break
            }
        }
        while (b > a) {
            if (MdSemanticEdit.isEdgeSpace((charAt src (b - 1)))) {
                b = (b - 1)
            } {
                break
            }
        }
        if (b <= a) {
            push out -1
            push out -1
            return out
        }
        push out a
        push out b
        return out
    }

    ; Whitespace for the purpose of an EDGE. A newline counts here and does
    ; not in `isSpaceCode`, which asks a different question: that one is about
    ; a character a reader typed next to a marker, this one is about a
    ; selection that ran past the end of a line on its way to the next block.
    sfn isEdgeSpace:boolean (c:int) {
        if (c == 32) { return true }
        if (c == 9) { return true }
        if (c == 10) { return true }
        if (c == 13) { return true }
        return false
    }

    ; ----------------------------------------------------------------------
    ; A slide break a reader can put where they want it
    ; ----------------------------------------------------------------------
    ;
    ; `MdLayout` already knows two rules — `{.slide}` starts a slide,
    ; `{.no-break}` forbids one — and a reader had no way to SAY either. These
    ; put the class on the block at the caret and take it off again, which is
    ; an ordinary patch like every other edit: the break lives in the file,
    ; survives a reload, travels with the document, and is undone by the same
    ; undo as everything else.
    ;
    ; Goldmark's block attributes attach to the PREVIOUS block, so the class
    ; goes on a line of its own after it. That works for every block kind
    ; including a heading, which is why there is one code path rather than one
    ; per kind.
    sfn toggleBlockClass:MdEditOp (src:string doc:MdNode off:int cls:string) {
        def none:MdEditOp (new MdEditOp())
        def idx:int (MdSemanticEdit.topBlockAt(doc off))
        if (idx < 0) { return none }
        def node:MdNode (doc.childAt(idx))
        if (node.srcStart < 0) { return none }

        def total:int (strlen src)
        def a:int node.srcStart
        def b:int node.srcEnd
        if (b > total) { b = total }
        if (b <= a) { return none }

        ; The block's last real character, and any attribute block already
        ; sitting at its end.
        def last:int b
        while (last > a) {
            if (MdSemanticEdit.isEdgeSpace((charAt src (last - 1)))) {
                last = (last - 1)
            } {
                break
            }
        }
        if (last <= a) { return none }

        def attrsAt:int -1
        if ((charAt src (last - 1)) == 125) {
            def scan:int (last - 1)
            while (scan > a) {
                if ((charAt src (scan - 1)) == 123) {
                    attrsAt = (scan - 1)
                    break
                }
                scan = (scan - 1)
            }
        }

        if (attrsAt < 0) {
            ; Nothing there yet. A line of its own after the block.
            if (node.hasClass(cls)) { return none }
            def add:MdEditOp (MdEdit.patch(src last last (("\n{." + cls) + "}")))
            add.selAfterA = off
            add.selAfterB = off
            return add
        }

        def inside:string (substring src (attrsAt + 1) (last - 1))
        def rebuilt:string (MdSemanticEdit.classToggled(inside cls))
        if ((strlen (trim rebuilt)) == 0) {
            ; The class was the only thing in there, so the whole block goes —
            ; and the newline that put it on its own line with it, or the
            ; document grows a blank line every time a reader changes their
            ; mind.
            def from:int attrsAt
            if (from > a) {
                if ((charAt src (from - 1)) == 10) { from = (from - 1) }
            }
            def cut:MdEditOp (MdEdit.patch(src from last ""))
            cut.selAfterA = off
            cut.selAfterB = off
            return cut
        }
        def put:MdEditOp (MdEdit.patch(src (attrsAt + 1) (last - 1) rebuilt))
        put.selAfterA = off
        put.selAfterB = off
        return put
    }

    ; The inside of an attribute block with `.cls` added or taken away.
    sfn classToggled:string (inside:string cls:string) {
        def want:string ("." + cls)
        def out:string ""
        def found:boolean false
        def n:int (strlen inside)
        def i:int 0
        def cur:string ""
        while (i <= n) {
            def atEnd:boolean (i == n)
            def c:int 32
            if (! atEnd) { c = (charAt inside i) }
            if (atEnd || (MdSemanticEdit.isEdgeSpace(c))) {
                if ((strlen cur) > 0) {
                    if (cur == want) {
                        found = true
                    } {
                        if ((strlen out) > 0) { out = (out + " ") }
                        out = (out + cur)
                    }
                    cur = ""
                }
            } {
                cur = (cur + (substring inside i (i + 1)))
            }
            i = (i + 1)
        }
        if (! found) {
            if ((strlen out) > 0) { out = (out + " ") }
            out = (out + want)
        }
        return out
    }

    ; Which TOP-LEVEL block an offset is in. A slide break happens between
    ; top-level blocks, so a caret inside a list item names the list.
    sfn topBlockAt:int (doc:MdNode off:int) {
        def best:int -1
        def i:int 0
        def n:int (doc.childCount())
        while (i < n) {
            def k:MdNode (doc.childAt(i))
            if (k.srcStart >= 0) {
                if (k.srcStart <= off) {
                    best = i
                    if (k.srcEnd > off) { return i }
                }
            }
            i = (i + 1)
        }
        return best
    }

    sfn kindFor:string (what:string) {
        if (what == "bold") { return "strong" }
        if (what == "italic") { return "emph" }
        if (what == "strike") { return "strike" }
        if (what == "code") { return "code" }
        return ""
    }

    sfn markerFor:string (what:string) {
        if (what == "bold") { return "**" }
        if (what == "italic") { return "*" }
        if (what == "strike") { return "~~" }
        if (what == "code") { return "`" }
        return ""
    }

    ; Why an intent was refused, or "" when it was not. Kept beside the op
    ; rather than inside it: an op that does nothing and an op that COULD not
    ; be computed look the same to a document and completely different to a
    ; reader.
    sfn refusalFor:string (src:string doc:MdNode what:string a:int b:int) {
        def kind:string (MdSemanticEdit.kindFor(what))
        if ((strlen kind) == 0) { return "no such intent" }

        ; Asked PER BLOCK, over the same clips `toggleWrap` will write into.
        ;
        ; Asked over the whole selection it refuses the ordinary case: a
        ; selection covering three bolded items half-straddles the first
        ; item's own `**` run, because that run does not reach the end of the
        ; selection — it reaches the end of its block, which is all a run can
        ; do. Half in and half out is a fact about one block, and this is the
        ; range in which it is a fact.
        def clips:[int] (MdSemanticEdit.clipsOf(src doc a b))
        def nc:int (to_int ((array_length clips) / 2))
        def i:int 0
        while (i < nc) {
            def cs:int (itemAt clips (i * 2))
            def ce:int (itemAt clips ((i * 2) + 1))
            if (MdSemanticEdit.straddles(doc kind cs ce)) {
                return ("the selection is half inside " + (kind + " and half outside it"))
            }
            ; A selection that runs across a code span has no bold either: the
            ; markers would land inside the code and be drawn as characters.
            if (what != "code") {
                if (MdSemanticEdit.straddles(doc "code" cs ce)) {
                    return "the selection crosses the edge of a code span"
                }
            }
            i = (i + 1)
        }
        if (nc > 0) { return "" }

        ; No block at all — a selection in the margin, or over a fence. The
        ; whole-selection question is the only one left to ask.
        if (MdSemanticEdit.straddles(doc kind a b)) {
            return ("the selection is half inside " + (kind + " and half outside it"))
        }
        if (what != "code") {
            if (MdSemanticEdit.straddles(doc "code" a b)) {
                return "the selection crosses the edge of a code span"
            }
        }
        return ""
    }

    ; Bold / italic / strike / code, on or off, as one patch.
    sfn toggleWrap:MdEditOp (src:string doc:MdNode what:string a:int b:int) {
        def none:MdEditOp (new MdEditOp())
        def kind:string (MdSemanticEdit.kindFor(what))
        if ((strlen kind) == 0) { return none }
        if ((strlen (MdSemanticEdit.refusalFor(src doc what a b))) > 0) { return none }

        def marker:string (MdSemanticEdit.markerFor(what))
        def mlen:int (strlen marker)

        ; Already on? Then off, by cutting the two delimiter runs out of the
        ; node's own span — which is why the node carries one.
        def found:[MdNode]
        if ((MdSemanticEdit.enclosing(found doc kind a b)) > 0) {
            def n:MdNode (itemAt found 0)
            def inner:string ""
            def from:int (n.srcStart + mlen)
            def to:int (n.srcEnd - mlen)
            if (to > from) { inner = (substring src from to) }
            def op:MdEditOp (MdEdit.patch(src n.srcStart n.srcEnd inner))
            op.selAfterA = n.srcStart
            op.selAfterB = (n.srcStart + (strlen inner))
            return op
        }

        ; Off, then — one marker pair INSIDE each block the selection touches.
        ;
        ; One pair around the whole selection is what this did, and across a
        ; block boundary it produces a document with no emphasis in it. See
        ; `collectBlocks` above for why the block is the unit.
        def clips:[int] (MdSemanticEdit.clipsOf(src doc a b))
        def nc:int (to_int ((array_length clips) / 2))
        if (nc == 0) { return none }

        ; Which clips ALREADY carry this emphasis, and over what span. Asked
        ; once, because the answer decides the whole operation: every block on
        ; means turn them off, anything else means turn them all on. That is
        ; what a word processor does with a mixed selection, and the reader
        ; who presses bold on one means "make these bold" rather than "invert
        ; each of these".
        def encS:[int]
        def encE:[int]
        def allOn:boolean true
        def k:int 0
        while (k < nc) {
            def cs0:int (itemAt clips (k * 2))
            def ce0:int (itemAt clips ((k * 2) + 1))
            def found2:[MdNode]
            if ((MdSemanticEdit.enclosing(found2 doc kind cs0 ce0)) > 0) {
                def nd:MdNode (itemAt found2 0)
                push encS nd.srcStart
                push encE nd.srcEnd
            } {
                push encS -1
                push encE -1
                allOn = false
            }
            k = (k + 1)
        }

        if allOn {
            ; Off, across every block: each node's own span replaced by what
            ; is inside it, which is why the node carries one.
            def rlo:int (itemAt encS 0)
            def rhi:int (itemAt encE (nc - 1))
            def rtext:string ""
            def cur:int rlo
            def m2:int 0
            while (m2 < nc) {
                def ns:int (itemAt encS m2)
                def ne:int (itemAt encE m2)
                if (ns > cur) { rtext = (rtext + (substring src cur ns)) }
                def innerFrom:int (ns + mlen)
                def innerTo:int (ne - mlen)
                if (innerTo > innerFrom) {
                    rtext = (rtext + (substring src innerFrom innerTo))
                }
                cur = ne
                m2 = (m2 + 1)
            }
            def rop:MdEditOp (MdEdit.patch(src rlo rhi rtext))
            rop.selAfterA = rlo
            rop.selAfterB = (rlo + (strlen rtext))
            return rop
        }

        def lo:int (itemAt clips 0)
        def hi:int (itemAt clips ((nc * 2) - 1))
        def outText:string ""
        def cursor:int lo
        ; Whether the FIRST and the LAST clip actually got markers, so the
        ; selection can be put back on the text rather than around the
        ; delimiters — a reader who bolds a word expects the word still
        ; selected, not the word and two asterisks.
        def firstWrapped:boolean false
        def lastWrapped:boolean false
        def j:int 0
        while (j < nc) {
            def cs:int (itemAt clips (j * 2))
            def ce:int (itemAt clips ((j * 2) + 1))
            if (cs > cursor) {
                outText = (outText + (substring src cursor cs))
            }
            def body:string (substring src cs ce)
            ; A block already carrying this emphasis is left alone rather than
            ; wrapped again: `****x****` is not "more bold", it is two empty
            ; delimiter runs.
            def already:boolean ((itemAt encS j) >= 0)
            if already {
                outText = (outText + body)
            } {
                outText = ((outText + marker) + body) + marker
            }
            if (j == 0) { firstWrapped = (! already) }
            if (j == (nc - 1)) { lastWrapped = (! already) }
            cursor = ce
            j = (j + 1)
        }
        def op2:MdEditOp (MdEdit.patch(src lo hi outText))
        def selA:int lo
        if firstWrapped { selA = (lo + mlen) }
        def selB:int (lo + (strlen outText))
        if lastWrapped { selB = (selB - mlen) }
        op2.selAfterA = selA
        op2.selAfterB = selB
        return op2
    }

    ; ----------------------------------------------------------------------
    ; A link
    ; ----------------------------------------------------------------------
    sfn toggleLink:MdEditOp (src:string doc:MdNode a:int b:int url:string) {
        def none:MdEditOp (new MdEditOp())
        def found:[MdNode]
        if ((MdSemanticEdit.enclosing(found doc "link" a b)) > 0) {
            def n:MdNode (itemAt found 0)
            def label:string (n.plainText())
            def op:MdEditOp (MdEdit.patch(src n.srcStart n.srcEnd label))
            op.selAfterA = n.srcStart
            op.selAfterB = (n.srcStart + (strlen label))
            return op
        }
        if (MdSemanticEdit.straddles(doc "link" a b)) { return none }
        if (b <= a) { return none }
        def sel:string (substring src a b)
        def made:string ((("[" + sel) + "](") + (url + ")"))
        def op2:MdEditOp (MdEdit.patch(src a b made))
        op2.selAfterA = (a + 1)
        op2.selAfterB = ((a + 1) + (strlen sel))
        return op2
    }

    ; ----------------------------------------------------------------------
    ; A table, pasted
    ; ----------------------------------------------------------------------
    ;
    ; What a spreadsheet puts on the clipboard is two flavours of one
    ; selection: `text/plain` as tab-separated lines and `text/html` holding a
    ; real `<table>`. The .docx editor reads the HTML flavour to make a
    ; DocumentTable; this reads the same flavour and writes GFM, so a range
    ; copied in the Ranger DataGrid — or in Excel — lands in a markdown file
    ; as a table rather than as a wall of tabs.
    ;
    ; The columns are padded to line up, because a markdown table nobody can
    ; read in the source is one the next person reformats by hand. That is a
    ; choice about text this file is WRITING, not a normalisation of text
    ; somebody else typed — the rule in the header stands.

    sfn padTo:string (v:string n:int) {
        def out:string v
        while ((strlen out) < n) {
            out = (out + " ")
        }
        return out
    }

    ; A cell's text, with the two characters that would break the row escaped.
    sfn cellText:string (v:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen v)
        while (i < n) {
            def c:int (charAt v i)
            if (c == 124) {
                out = (out + "\\|")
            } {
                if ((c == 10) || (c == 13)) {
                    out = (out + " ")
                } {
                    out = (out + (substring v i (i + 1)))
                }
            }
            i = (i + 1)
        }
        return (trim out)
    }

    ; The clipboard's HTML as a GFM table, or "" when it held no table. The
    ; first row is the header, which is what a spreadsheet selection almost
    ; always starts with and what GFM requires: a table with no header row is
    ; not a table as far as the specification is concerned.
    sfn tableFromHtml:string (html:string) {
        def tbl:ClipboardTable (new ClipboardTable)
        if ((tbl.parseHtml(html)) == false) { return "" }
        def rows:int (tbl.rowCount())
        def cols:int (tbl.columnCount())
        if ((rows == 0) || (cols == 0)) { return "" }

        ; Widths first, so the pipes line up.
        def width:[int]
        def k:int 0
        while (k < cols) {
            push width 3
            k = (k + 1)
        }
        def texts:[string]
        def r:int 0
        while (r < rows) {
            def row:ClipRow (tbl.rowAt(r))
            def cN:int (array_length row.cells)
            def cIdx:int 0
            while (cIdx < cols) {
                def v:string ""
                if (cIdx < cN) {
                    def cell:ClipCell (itemAt row.cells cIdx)
                    v = (MdSemanticEdit.cellText(cell.text))
                }
                push texts v
                if ((strlen v) > (itemAt width cIdx)) {
                    set_at width cIdx (strlen v)
                }
                cIdx = (cIdx + 1)
            }
            r = (r + 1)
        }

        def out:string ""
        def r2:int 0
        while (r2 < rows) {
            def line:string "|"
            def c2:int 0
            while (c2 < cols) {
                def v:string (itemAt texts ((r2 * cols) + c2))
                line = ((line + " ") + (MdSemanticEdit.padTo(v (itemAt width c2))) + " |")
                c2 = (c2 + 1)
            }
            out = ((out + line) + "\n")
            if (r2 == 0) {
                def sep:string "|"
                def c3:int 0
                while (c3 < cols) {
                    def dashes:string ""
                    def d:int 0
                    while (d < (itemAt width c3)) {
                        dashes = (dashes + "-")
                        d = (d + 1)
                    }
                    sep = ((sep + " ") + dashes + " |")
                    c3 = (c3 + 1)
                }
                out = ((out + sep) + "\n")
            }
            r2 = (r2 + 1)
        }
        return out
    }

    ; ----------------------------------------------------------------------
    ; Lines: headings, lists, block quotes
    ; ----------------------------------------------------------------------

    ; The start of the line `off` is on.
    sfn lineStartOf:int (src:string off:int) {
        def i:int off
        def n:int (strlen src)
        if (i > n) { i = n }
        while (i > 0) {
            if ((charAt src (i - 1)) == 10) { return i }
            i = (i - 1)
        }
        return 0
    }

    ; One past the last character of the line `off` is on, not counting the
    ; newline itself.
    sfn lineEndOf:int (src:string off:int) {
        def n:int (strlen src)
        def i:int off
        if (i < 0) { i = 0 }
        while (i < n) {
            if ((charAt src i) == 10) { return i }
            i = (i + 1)
        }
        return n
    }

    ; How far a line is indented.
    sfn indentOf:string (line:string) {
        def n:int (strlen line)
        def i:int 0
        while (i < n) {
            def c:int (charAt line i)
            if ((c != 32) && (c != 9)) { return (substring line 0 i) }
            i = (i + 1)
        }
        return line
    }

    ; A heading, or a paragraph. `level` 0 means "a paragraph".
    ;
    ; Only the FIRST line of a paragraph takes the hashes: a heading is one
    ; line by definition, and turning a wrapped three-line paragraph into one
    ; would silently make the other two lines a new paragraph. The caller gets
    ; a refusal for that rather than a surprise.
    sfn setHeading:MdEditOp (src:string doc:MdNode off:int level:int) {
        def none:MdEditOp (new MdEditOp())
        if ((level < 0) || (level > 6)) { return none }
        def found:[MdNode]
        if ((MdSemanticEdit.blockAt(found doc off)) == 0) { return none }
        def blk:MdNode (itemAt found 0)

        def hashes:string ""
        def k:int 0
        while (k < level) {
            hashes = (hashes + "#")
            k = (k + 1)
        }
        if (level > 0) { hashes = (hashes + " ") }

        if (blk.kind == "heading") {
            ; The text starts after the hashes, and the map is what says where.
            def textAt:int (blk.srcOfLiteral(0))
            if (textAt < 0) { return none }
            ; A setext heading has its marker on the line BELOW, so replacing
            ; a prefix would leave `====` under a paragraph. Refuse it; the
            ; caller can say why.
            if (textAt <= blk.srcStart) { return none }
            def op:MdEditOp (MdEdit.patch(src blk.srcStart textAt hashes))
            op.selAfterA = (blk.srcStart + (strlen hashes))
            op.selAfterB = op.selAfterA
            return op
        }

        if (blk.kind != "paragraph") { return none }
        if (level == 0) { return none }
        def at:int (blk.srcOfLiteral(0))
        if (at < 0) { at = blk.srcStart }
        def op2:MdEditOp (MdEdit.patch(src at at hashes))
        op2.selAfterA = (at + (strlen hashes))
        op2.selAfterB = op2.selAfterA
        return op2
    }

    ; What a line already carries, if anything: "- ", "> ", or an ordered
    ; marker. Answers the marker INCLUDING its trailing space, or "".
    sfn markerOn:string (line:string want:string) {
        def ind:string (MdSemanticEdit.indentOf(line))
        def rest:string (substring line (strlen ind) (strlen line))
        if (want == "quote") {
            if ((strlen rest) >= 1) {
                if ((charAt rest 0) == 62) {
                    if ((strlen rest) >= 2) {
                        if ((charAt rest 1) == 32) { return "> " }
                    }
                    return ">"
                }
            }
            return ""
        }
        if (want == "bullet") {
            if ((strlen rest) >= 2) {
                def c:int (charAt rest 0)
                if (((c == 45) || (c == 42)) || (c == 43)) {
                    if ((charAt rest 1) == 32) {
                        return (substring rest 0 2)
                    }
                }
            }
            return ""
        }
        if (want == "ordered") {
            def i:int 0
            def n:int (strlen rest)
            while (i < n) {
                def c:int (charAt rest i)
                if ((c >= 48) && (c <= 57)) {
                    i = (i + 1)
                } {
                    i = n
                }
            }
            def digits:int 0
            def j:int 0
            def m:int (strlen rest)
            while (j < m) {
                def c2:int (charAt rest j)
                if ((c2 >= 48) && (c2 <= 57)) {
                    digits = (digits + 1)
                    j = (j + 1)
                } {
                    j = m
                }
            }
            if (digits == 0) { return "" }
            if ((digits + 1) >= (strlen rest)) { return "" }
            def delim:int (charAt rest digits)
            if ((delim != 46) && (delim != 41)) { return "" }
            if ((charAt rest (digits + 1)) != 32) { return "" }
            return (substring rest 0 (digits + 2))
        }
        return ""
    }

    ; `- `, `1. ` or `> ` on every line the selection touches, or off every
    ; one of them. ON unless they ALL have it already, which is what makes a
    ; mixed selection do the thing the reader can see they meant.
    ;
    ; Blank lines are left alone in both directions: a bullet on an empty line
    ; is a list item that is not there, and a `>` on one ends the quote.
    sfn toggleLinePrefix:MdEditOp (src:string what:string a:int b:int) {
        def none:MdEditOp (new MdEditOp())
        def from:int (MdSemanticEdit.lineStartOf(src a))
        def to:int (MdSemanticEdit.lineEndOf(src b))
        if (to < from) { return none }
        def region:string (substring src from to)
        def lines:[string] (strsplit region "\n")
        def cnt:int (array_length lines)
        if (cnt == 0) { return none }

        ; Do they all have it?
        def all:boolean true
        def any:boolean false
        def i:int 0
        while (i < cnt) {
            def ln:string (itemAt lines i)
            if ((strlen (trim ln)) > 0) {
                any = true
                if ((strlen (MdSemanticEdit.markerOn(ln what))) == 0) { all = false }
            }
            i = (i + 1)
        }
        if (! any) { return none }

        def out:string ""
        def num:int 1
        def j:int 0
        while (j < cnt) {
            def ln2:string (itemAt lines j)
            def built:string ln2
            if ((strlen (trim ln2)) > 0) {
                def ind:string (MdSemanticEdit.indentOf(ln2))
                def rest:string (substring ln2 (strlen ind) (strlen ln2))
                def had:string (MdSemanticEdit.markerOn(ln2 what))
                if all {
                    built = (ind + (substring rest (strlen had) (strlen rest)))
                } {
                    def body:string rest
                    if ((strlen had) > 0) {
                        body = (substring rest (strlen had) (strlen rest))
                    }
                    def add:string "- "
                    if (what == "quote") { add = "> " }
                    if (what == "ordered") { add = ((to_string num) + ". ") }
                    built = ((ind + add) + body)
                    num = (num + 1)
                }
            }
            if (j > 0) { out = (out + "\n") }
            out = (out + built)
            j = (j + 1)
        }
        def op:MdEditOp (MdEdit.patch(src from to out))
        op.selAfterA = from
        op.selAfterB = (from + (strlen out))
        return op
    }
}

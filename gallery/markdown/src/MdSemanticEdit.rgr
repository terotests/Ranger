; ============================================================================
; MdSemanticEdit.rgr — "make this bold", as a replacement of a range of text.
; ============================================================================
;
; This is the WYSIWYG part, and it is one table: an intent plus a selection,
; answered with ONE `MdEditOp`. Nothing here mutates a document; it decides
; what patch would.
;
; **Decided against the AST, not by a regular expression.** The difference is
; not tidiness. `**bold**` inside a code span is not bold, a `*` at the end of
; a word does not open emphasis, and which `*` pairs with which is settled by
; the delimiter stack after the whole line has been read. A rule written over
; the text gets all three wrong; the parser already got them right, and since
; Stage C every node it built carries the span of the source that made it. So
; "is this selection already bold" is a lookup, and "stop being bold" is the
; span of the `strong` node with its two delimiter runs cut off.
;
; **Two rules keep it honest.**
;
;   1. EVERY TOGGLE IS ITS OWN INVERSE. Applying it twice gives back bytes
;      identical to the input. That is the whole acceptance test and it is run
;      over the awkward cases, not the easy ones — a selection that starts
;      inside an existing `**` run, one that covers a code span, one that
;      straddles two blocks.
;
;   2. WHEN THE ANSWER IS NOT WELL DEFINED, REFUSE. Bolding a selection that
;      begins inside emphasis and ends outside it has no correct patch. A
;      controller that guesses produces markdown nobody typed; this one
;      answers with an empty op, and the caller says so in a status line.
;      `MdEditOp.isEmpty` is the refusal, and `refusal()` says which.
;
; **Nothing here normalises.** A line the intent did not touch comes out byte
; for byte, including the two spaces after a bullet and the pipes somebody
; lined up by hand. That is §1 of `PLAN_WYSIWYG.md` and it is the reason this
; file is a page of span arithmetic rather than a serializer.
; ============================================================================

Import "MdNode.rgr"
Import "MdBlock.rgr"
Import "MdEdit.rgr"

class MdSemanticEdit {
    ; ----------------------------------------------------------------------
    ; Finding the node an intent is about
    ; ----------------------------------------------------------------------

    ; The innermost node of `kind` whose span CONTAINS [a,b]. The innermost
    ; because `***x***` is a strong inside an emph and "stop being bold" has
    ; to take the right one of the two.
    sfn enclosing:int (out:[MdNode] n:MdNode kind:string a:int b:int) {
        def hit:int 0
        if (n.kind == kind) {
            if ((n.srcStart >= 0) && ((n.srcStart <= a) && (n.srcEnd >= b))) {
                clear out
                push out n
                hit = 1
            }
        }
        def i:int 0
        def cnt:int (n.childCount())
        while (i < cnt) {
            def k:MdNode (n.childAt(i))
            def deeper:int (MdSemanticEdit.enclosing(out k kind a b))
            if (deeper > 0) { hit = 1 }
            i = (i + 1)
        }
        return hit
    }

    ; Does any node of `kind` OVERLAP [a,b) without containing it and without
    ; being contained by it? That is the case with no correct answer.
    sfn straddles:boolean (n:MdNode kind:string a:int b:int) {
        if (n.kind == kind) {
            if (n.srcStart >= 0) {
                def s:int n.srcStart
                def e:int n.srcEnd
                def overlaps:boolean ((s < b) && (e > a))
                def contains:boolean ((s <= a) && (e >= b))
                def inside:boolean ((s >= a) && (e <= b))
                if (overlaps && ((! contains) && (! inside))) {
                    return true
                }
            }
        }
        def i:int 0
        def cnt:int (n.childCount())
        while (i < cnt) {
            def k:MdNode (n.childAt(i))
            if (MdSemanticEdit.straddles(k kind a b)) { return true }
            i = (i + 1)
        }
        return false
    }

    ; The innermost paragraph or heading holding `off` — the block an intent
    ; about a whole line is about.
    sfn blockAt:int (out:[MdNode] n:MdNode off:int) {
        def hit:int 0
        if ((n.kind == "paragraph") || (n.kind == "heading")) {
            if ((n.srcStart >= 0) && ((n.srcStart <= off) && (n.srcEnd >= off))) {
                clear out
                push out n
                hit = 1
            }
        }
        def i:int 0
        def cnt:int (n.childCount())
        while (i < cnt) {
            def k:MdNode (n.childAt(i))
            def deeper:int (MdSemanticEdit.blockAt(out k off))
            if (deeper > 0) { hit = 1 }
            i = (i + 1)
        }
        return hit
    }

    ; ----------------------------------------------------------------------
    ; Wrapping: bold, italic, strikethrough, inline code
    ; ----------------------------------------------------------------------

    ; The node kind each marker produces, so "is it already on" is asked of
    ; the tree rather than of the characters.
    sfn kindFor:string (what:string) {
        if (what == "bold") { return "strong" }
        if (what == "italic") { return "emph" }
        if (what == "strike") { return "strike" }
        if (what == "code") { return "code" }
        return ""
    }

    sfn markerFor:string (what:string) {
        if (what == "bold") { return "**" }
        if (what == "italic") { return "*" }
        if (what == "strike") { return "~~" }
        if (what == "code") { return "`" }
        return ""
    }

    ; Why an intent was refused, or "" when it was not. Kept beside the op
    ; rather than inside it: an op that does nothing and an op that COULD not
    ; be computed look the same to a document and completely different to a
    ; reader.
    sfn refusalFor:string (src:string doc:MdNode what:string a:int b:int) {
        def kind:string (MdSemanticEdit.kindFor(what))
        if ((strlen kind) == 0) { return "no such intent" }
        if (MdSemanticEdit.straddles(doc kind a b)) {
            return ("the selection is half inside " + (kind + " and half outside it"))
        }
        ; A selection that runs across a code span has no bold either: the
        ; markers would land inside the code and be drawn as characters.
        if (what != "code") {
            if (MdSemanticEdit.straddles(doc "code" a b)) {
                return "the selection crosses the edge of a code span"
            }
        }
        return ""
    }

    ; Bold / italic / strike / code, on or off, as one patch.
    sfn toggleWrap:MdEditOp (src:string doc:MdNode what:string a:int b:int) {
        def none:MdEditOp (new MdEditOp())
        def kind:string (MdSemanticEdit.kindFor(what))
        if ((strlen kind) == 0) { return none }
        if ((strlen (MdSemanticEdit.refusalFor(src doc what a b))) > 0) { return none }

        def marker:string (MdSemanticEdit.markerFor(what))
        def mlen:int (strlen marker)

        ; Already on? Then off, by cutting the two delimiter runs out of the
        ; node's own span — which is why the node carries one.
        def found:[MdNode]
        if ((MdSemanticEdit.enclosing(found doc kind a b)) > 0) {
            def n:MdNode (itemAt found 0)
            def inner:string ""
            def from:int (n.srcStart + mlen)
            def to:int (n.srcEnd - mlen)
            if (to > from) { inner = (substring src from to) }
            def op:MdEditOp (MdEdit.patch(src n.srcStart n.srcEnd inner))
            op.selAfterA = n.srcStart
            op.selAfterB = (n.srcStart + (strlen inner))
            return op
        }

        ; Off, then. The selection, wrapped.
        def sel:string ""
        if (b > a) { sel = (substring src a b) }
        def op2:MdEditOp (MdEdit.patch(src a b ((marker + sel) + marker)))
        op2.selAfterA = (a + mlen)
        op2.selAfterB = ((a + mlen) + (strlen sel))
        return op2
    }

    ; ----------------------------------------------------------------------
    ; A link
    ; ----------------------------------------------------------------------
    sfn toggleLink:MdEditOp (src:string doc:MdNode a:int b:int url:string) {
        def none:MdEditOp (new MdEditOp())
        def found:[MdNode]
        if ((MdSemanticEdit.enclosing(found doc "link" a b)) > 0) {
            def n:MdNode (itemAt found 0)
            def label:string (n.plainText())
            def op:MdEditOp (MdEdit.patch(src n.srcStart n.srcEnd label))
            op.selAfterA = n.srcStart
            op.selAfterB = (n.srcStart + (strlen label))
            return op
        }
        if (MdSemanticEdit.straddles(doc "link" a b)) { return none }
        if (b <= a) { return none }
        def sel:string (substring src a b)
        def made:string ((("[" + sel) + "](") + (url + ")"))
        def op2:MdEditOp (MdEdit.patch(src a b made))
        op2.selAfterA = (a + 1)
        op2.selAfterB = ((a + 1) + (strlen sel))
        return op2
    }

    ; ----------------------------------------------------------------------
    ; Lines: headings, lists, block quotes
    ; ----------------------------------------------------------------------

    ; The start of the line `off` is on.
    sfn lineStartOf:int (src:string off:int) {
        def i:int off
        def n:int (strlen src)
        if (i > n) { i = n }
        while (i > 0) {
            if ((charAt src (i - 1)) == 10) { return i }
            i = (i - 1)
        }
        return 0
    }

    ; One past the last character of the line `off` is on, not counting the
    ; newline itself.
    sfn lineEndOf:int (src:string off:int) {
        def n:int (strlen src)
        def i:int off
        if (i < 0) { i = 0 }
        while (i < n) {
            if ((charAt src i) == 10) { return i }
            i = (i + 1)
        }
        return n
    }

    ; How far a line is indented.
    sfn indentOf:string (line:string) {
        def n:int (strlen line)
        def i:int 0
        while (i < n) {
            def c:int (charAt line i)
            if ((c != 32) && (c != 9)) { return (substring line 0 i) }
            i = (i + 1)
        }
        return line
    }

    ; A heading, or a paragraph. `level` 0 means "a paragraph".
    ;
    ; Only the FIRST line of a paragraph takes the hashes: a heading is one
    ; line by definition, and turning a wrapped three-line paragraph into one
    ; would silently make the other two lines a new paragraph. The caller gets
    ; a refusal for that rather than a surprise.
    sfn setHeading:MdEditOp (src:string doc:MdNode off:int level:int) {
        def none:MdEditOp (new MdEditOp())
        if ((level < 0) || (level > 6)) { return none }
        def found:[MdNode]
        if ((MdSemanticEdit.blockAt(found doc off)) == 0) { return none }
        def blk:MdNode (itemAt found 0)

        def hashes:string ""
        def k:int 0
        while (k < level) {
            hashes = (hashes + "#")
            k = (k + 1)
        }
        if (level > 0) { hashes = (hashes + " ") }

        if (blk.kind == "heading") {
            ; The text starts after the hashes, and the map is what says where.
            def textAt:int (blk.srcOfLiteral(0))
            if (textAt < 0) { return none }
            ; A setext heading has its marker on the line BELOW, so replacing
            ; a prefix would leave `====` under a paragraph. Refuse it; the
            ; caller can say why.
            if (textAt <= blk.srcStart) { return none }
            def op:MdEditOp (MdEdit.patch(src blk.srcStart textAt hashes))
            op.selAfterA = (blk.srcStart + (strlen hashes))
            op.selAfterB = op.selAfterA
            return op
        }

        if (blk.kind != "paragraph") { return none }
        if (level == 0) { return none }
        def at:int (blk.srcOfLiteral(0))
        if (at < 0) { at = blk.srcStart }
        def op2:MdEditOp (MdEdit.patch(src at at hashes))
        op2.selAfterA = (at + (strlen hashes))
        op2.selAfterB = op2.selAfterA
        return op2
    }

    ; What a line already carries, if anything: "- ", "> ", or an ordered
    ; marker. Answers the marker INCLUDING its trailing space, or "".
    sfn markerOn:string (line:string want:string) {
        def ind:string (MdSemanticEdit.indentOf(line))
        def rest:string (substring line (strlen ind) (strlen line))
        if (want == "quote") {
            if ((strlen rest) >= 1) {
                if ((charAt rest 0) == 62) {
                    if ((strlen rest) >= 2) {
                        if ((charAt rest 1) == 32) { return "> " }
                    }
                    return ">"
                }
            }
            return ""
        }
        if (want == "bullet") {
            if ((strlen rest) >= 2) {
                def c:int (charAt rest 0)
                if (((c == 45) || (c == 42)) || (c == 43)) {
                    if ((charAt rest 1) == 32) {
                        return (substring rest 0 2)
                    }
                }
            }
            return ""
        }
        if (want == "ordered") {
            def i:int 0
            def n:int (strlen rest)
            while (i < n) {
                def c:int (charAt rest i)
                if ((c >= 48) && (c <= 57)) {
                    i = (i + 1)
                } {
                    i = n
                }
            }
            def digits:int 0
            def j:int 0
            def m:int (strlen rest)
            while (j < m) {
                def c2:int (charAt rest j)
                if ((c2 >= 48) && (c2 <= 57)) {
                    digits = (digits + 1)
                    j = (j + 1)
                } {
                    j = m
                }
            }
            if (digits == 0) { return "" }
            if ((digits + 1) >= (strlen rest)) { return "" }
            def delim:int (charAt rest digits)
            if ((delim != 46) && (delim != 41)) { return "" }
            if ((charAt rest (digits + 1)) != 32) { return "" }
            return (substring rest 0 (digits + 2))
        }
        return ""
    }

    ; `- `, `1. ` or `> ` on every line the selection touches, or off every
    ; one of them. ON unless they ALL have it already, which is what makes a
    ; mixed selection do the thing the reader can see they meant.
    ;
    ; Blank lines are left alone in both directions: a bullet on an empty line
    ; is a list item that is not there, and a `>` on one ends the quote.
    sfn toggleLinePrefix:MdEditOp (src:string what:string a:int b:int) {
        def none:MdEditOp (new MdEditOp())
        def from:int (MdSemanticEdit.lineStartOf(src a))
        def to:int (MdSemanticEdit.lineEndOf(src b))
        if (to < from) { return none }
        def region:string (substring src from to)
        def lines:[string] (strsplit region "\n")
        def cnt:int (array_length lines)
        if (cnt == 0) { return none }

        ; Do they all have it?
        def all:boolean true
        def any:boolean false
        def i:int 0
        while (i < cnt) {
            def ln:string (itemAt lines i)
            if ((strlen (trim ln)) > 0) {
                any = true
                if ((strlen (MdSemanticEdit.markerOn(ln what))) == 0) { all = false }
            }
            i = (i + 1)
        }
        if (! any) { return none }

        def out:string ""
        def num:int 1
        def j:int 0
        while (j < cnt) {
            def ln2:string (itemAt lines j)
            def built:string ln2
            if ((strlen (trim ln2)) > 0) {
                def ind:string (MdSemanticEdit.indentOf(ln2))
                def rest:string (substring ln2 (strlen ind) (strlen ln2))
                def had:string (MdSemanticEdit.markerOn(ln2 what))
                if all {
                    built = (ind + (substring rest (strlen had) (strlen rest)))
                } {
                    def body:string rest
                    if ((strlen had) > 0) {
                        body = (substring rest (strlen had) (strlen rest))
                    }
                    def add:string "- "
                    if (what == "quote") { add = "> " }
                    if (what == "ordered") { add = ((to_string num) + ". ") }
                    built = ((ind + add) + body)
                    num = (num + 1)
                }
            }
            if (j > 0) { out = (out + "\n") }
            out = (out + built)
            j = (j + 1)
        }
        def op:MdEditOp (MdEdit.patch(src from to out))
        op.selAfterA = from
        op.selAfterB = (from + (strlen out))
        return op
    }
}

; ============================================================================
; MdHtml.rgr — the HTML a markdown document carries, read far enough to draw
; ============================================================================
;
; CommonMark passes HTML through untouched: `<mark>` in a sentence is an
; `html_inline` node, a `<table>` or a `<div align="center">` block is an
; `html_block`. A browser would render them; a canvas has nothing to hand
; them to, so the layout used to show the markup itself. This reads the part
; of HTML that documents actually use — a tag's name and attributes, the
; `text-align` in a style, and a table with its row and column spans — and
; leaves everything else to be shown as it was.
; ============================================================================

class MdHtmlTag {
    def name:string ""
    def close:boolean false
    def selfClose:boolean false
    def keys:[string]
    def vals:[string]
    ; one past the `>` in the text it was read from
    def end:int 0

    Constructor () {
    }

    fn attr:string (k:string) {
        def i:int 0
        while (i < (array_length keys)) {
            if ((itemAt keys i) == k) {
                return (itemAt vals i)
            }
            i = (i + 1)
        }
        return ""
    }

    fn has:boolean (k:string) {
        def i:int 0
        while (i < (array_length keys)) {
            if ((itemAt keys i) == k) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; left / center / right from `align=` or `style="text-align: …"`, or "".
    fn align:string () {
        def a:string (MdHtml.lower((trim (this.attr("align")))))
        if ((strlen a) == 0) {
            a = (MdHtml.lower((MdHtml.styleProp((this.attr("style")) "text-align"))))
        }
        if (a == "middle") {
            a = "center"
        }
        if (((a == "left") || (a == "center")) || (a == "right")) {
            return a
        }
        return ""
    }
}

class MdHtmlCell {
    def inner:string ""
    ; where `inner` starts in the text the table was read from
    def start:int 0
    def header:boolean false
    def rowspan:int 1
    def colspan:int 1
    def align:string ""
    ; where it lands in the grid
    def row:int 0
    def col:int 0

    Constructor () {
    }
}

class MdHtmlRow {
    def cells:[MdHtmlCell]
    def head:boolean false

    Constructor () {
    }
}

class MdHtmlTable {
    def rows:[MdHtmlRow]
    def cols:int 0
    def caption:string ""

    Constructor () {
    }

    fn rowCount:int () {
        return (array_length rows)
    }
}

class MdHtml {
    sfn lower:string (s:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def c:int (charAt s i)
            if ((c >= 65) && (c <= 90)) {
                c = (c + 32)
            }
            out = (out + (strfromcode c))
            i = (i + 1)
        }
        return out
    }

    ; `text-align` out of "color: red; text-align: center".
    sfn styleProp:string (style:string prop:string) {
        def parts:[string] (strsplit style ";")
        def i:int 0
        while (i < (array_length parts)) {
            def p:string (itemAt parts i)
            def colon:int (indexOf p ":")
            if (colon > 0) {
                def k:string (MdHtml.lower((trim (substring p 0 colon))))
                if (k == prop) {
                    return (trim (substring p (colon + 1) (strlen p)))
                }
            }
            i = (i + 1)
        }
        return ""
    }

    sfn isNameChar:boolean (c:int) {
        if ((c >= 97) && (c <= 122)) { return true }
        if ((c >= 65) && (c <= 90)) { return true }
        if ((c >= 48) && (c <= 57)) { return true }
        if ((c == 45) || (c == 58)) { return true }
        return false
    }

    ; The tag that starts at `from` (a `<`). An empty name when there is none.
    sfn tagAt:MdHtmlTag (s:string from:int) {
        def t:MdHtmlTag (new MdHtmlTag())
        def n:int (strlen s)
        def i:int (from + 1)
        if ((i < n) && ((charAt s i) == 47)) {
            t.close = true
            i = (i + 1)
        }
        def ns:int i
        while ((i < n) && (MdHtml.isNameChar((charAt s i)))) {
            i = (i + 1)
        }
        t.name = (MdHtml.lower((substring s ns i)))
        ; attributes, until `>`
        while (i < n) {
            def c:int (charAt s i)
            if (c == 62) {
                t.end = (i + 1)
                return t
            }
            if (c == 47) {
                t.selfClose = true
                i = (i + 1)
            } {
                if (MdHtml.isNameChar(c)) {
                    def ks:int i
                    while ((i < n) && (MdHtml.isNameChar((charAt s i)))) {
                        i = (i + 1)
                    }
                    def key:string (MdHtml.lower((substring s ks i)))
                    def val:string ""
                    while ((i < n) && ((charAt s i) == 32)) {
                        i = (i + 1)
                    }
                    if ((i < n) && ((charAt s i) == 61)) {
                        i = (i + 1)
                        while ((i < n) && ((charAt s i) == 32)) {
                            i = (i + 1)
                        }
                        if ((i < n) && (((charAt s i) == 34) || ((charAt s i) == 39))) {
                            def q:int (charAt s i)
                            i = (i + 1)
                            def vs:int i
                            while ((i < n) && ((charAt s i) != q)) {
                                i = (i + 1)
                            }
                            val = (substring s vs i)
                            i = (i + 1)
                        } {
                            def vs2:int i
                            while ((i < n) && (((charAt s i) != 32) && ((charAt s i) != 62))) {
                                i = (i + 1)
                            }
                            val = (substring s vs2 i)
                        }
                    }
                    push t.keys key
                    push t.vals val
                } {
                    i = (i + 1)
                }
            }
        }
        t.end = n
        return t
    }

    sfn tag:MdHtmlTag (lit:string) {
        def s:string (trim lit)
        if (((strlen s) == 0) || ((charAt s 0) != 60)) {
            return (new MdHtmlTag())
        }
        return (MdHtml.tagAt(s 0))
    }

    ; The next `<` at or after `from` that opens a tag (a letter or `/`
    ; after it), or -1.
    sfn nextTag:int (s:string from:int) {
        def n:int (strlen s)
        def i:int from
        while (i < n) {
            if ((charAt s i) == 60) {
                if ((i + 1) < n) {
                    def c:int (charAt s (i + 1))
                    if ((c == 47) || (MdHtml.isNameChar(c))) {
                        return i
                    }
                }
            }
            i = (i + 1)
        }
        return -1
    }

    ; Where the `</name>` that closes the element opened before `from` begins,
    ; counting nested ones of the same name; -1 when it is not there.
    sfn closingOf:int (s:string name:string from:int) {
        def depth:int 1
        def i:int (MdHtml.nextTag(s from))
        while (i >= 0) {
            def t:MdHtmlTag (MdHtml.tagAt(s i))
            if (t.name == name) {
                if t.close {
                    depth = (depth - 1)
                    if (depth == 0) {
                        return i
                    }
                } {
                    if (t.selfClose == false) {
                        depth = (depth + 1)
                    }
                }
            }
            i = (MdHtml.nextTag(s t.end))
        }
        return -1
    }

    ; A `<table>`: its rows and cells, spans placed on a grid.
    sfn table:MdHtmlTable (s:string) {
        def t:MdHtmlTable (new MdHtmlTable())
        def inHead:boolean false
        def row@(optional):MdHtmlRow
        def cell@(optional):MdHtmlCell
        def i:int (MdHtml.nextTag(s 0))
        while (i >= 0) {
            def tg:MdHtmlTag (MdHtml.tagAt(s i))
            def nm:string tg.name
            def closesCell:boolean false
            if ((nm == "td") || (nm == "th")) {
                closesCell = true
            }
            if ((nm == "tr") || ((nm == "thead") || ((nm == "tbody") || ((nm == "tfoot") || (nm == "table"))))) {
                closesCell = true
            }
            if (closesCell && (!null? cell)) {
                def c0:MdHtmlCell (unwrap cell)
                c0.inner = (substring s c0.start i)
                def none@(optional):MdHtmlCell
                cell = none
            }
            if (nm == "thead") {
                inHead = (tg.close == false)
            }
            if ((nm == "tr") && (tg.close == false)) {
                def r:MdHtmlRow (new MdHtmlRow())
                r.head = inHead
                push t.rows r
                row = r
            }
            if (((nm == "td") || (nm == "th")) && (tg.close == false)) {
                if (null? row) {
                    def r2:MdHtmlRow (new MdHtmlRow())
                    r2.head = inHead
                    push t.rows r2
                    row = r2
                }
                def c:MdHtmlCell (new MdHtmlCell())
                c.header = (nm == "th")
                c.start = tg.end
                c.rowspan = (?? (str2int (trim (tg.attr("rowspan")))) 1)
                c.colspan = (?? (str2int (trim (tg.attr("colspan")))) 1)
                if (c.rowspan < 1) { c.rowspan = 1 }
                if (c.colspan < 1) { c.colspan = 1 }
                if (c.rowspan > 64) { c.rowspan = 64 }
                if (c.colspan > 64) { c.colspan = 64 }
                c.align = (tg.align())
                def rr:MdHtmlRow (unwrap row)
                push rr.cells c
                cell = c
            }
            if ((nm == "caption") && (tg.close == false)) {
                def ce:int (MdHtml.closingOf(s "caption" tg.end))
                if (ce > 0) {
                    t.caption = (trim (substring s tg.end ce))
                }
            }
            i = (MdHtml.nextTag(s tg.end))
        }
        if (!null? cell) {
            def c1:MdHtmlCell (unwrap cell)
            c1.inner = (substring s c1.start (strlen s))
        }
        MdHtml.place(t)
        return t
    }

    ; Row and column of every cell, stepping past the places taken by a cell
    ; above that spans down into this row.
    sfn place:void (t:MdHtmlTable) {
        def taken:[string:boolean]
        def cols:int 0
        def r:int 0
        while (r < (array_length t.rows)) {
            def row:MdHtmlRow (itemAt t.rows r)
            def c:int 0
            def k:int 0
            while (k < (array_length row.cells)) {
                def cell:MdHtmlCell (itemAt row.cells k)
                while (has taken (MdHtml.key(r c))) {
                    c = (c + 1)
                }
                cell.row = r
                cell.col = c
                def dr:int 0
                while (dr < cell.rowspan) {
                    def dc:int 0
                    while (dc < cell.colspan) {
                        set taken (MdHtml.key((r + dr) (c + dc))) true
                        dc = (dc + 1)
                    }
                    dr = (dr + 1)
                }
                c = (c + cell.colspan)
                if (c > cols) {
                    cols = c
                }
                k = (k + 1)
            }
            r = (r + 1)
        }
        t.cols = cols
    }

    sfn key:string (r:int c:int) {
        return ((to_string r) + ":" + (to_string c))
    }
}

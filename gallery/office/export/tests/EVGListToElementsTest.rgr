; SPDX-License-Identifier: AGPL-3.0-or-later
;
; EVGListToElementsTest — a display list going to the PDF writer keeps its
; shape: a stroke stays open, a line of text stays one line, a bare family
; name is the regular face, and the characters ordinary text is full of
; have a byte to print as.

Import "../EVGListToElements.rgr"
Import "../../../pdf_writer/src/core/Utf8.rgr"
Import "../../../pdf_writer/src/fonts/FontManager.rgr"
Import "../../../pdf_writer/src/core/EVGPDFRenderer.rgr"

class EVGListToElementsTest {
    def passed:int 0
    def failed:int 0

    sfn main:void () {
        def t (new EVGListToElementsTest())
        t.run()
    }

    fn check:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS  " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL  " + name)
        }
    }

    fn run:void () {
        this.testStrokeStaysOpen()
        this.testTwoRings()
        this.testTextIsOneLine()
        this.testWinAnsiStandIns()
        this.testBareFamilyIsRegular()
        this.testEmojiFromFallbackFace()
        this.testCroppedPicture()
        print ("passed=" + (to_string passed) + " failed=" + (to_string failed))
        if (failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }

    fn testCroppedPicture:void () {
        print "--- a cropped picture keeps its window and corners ---"
        def c (new EVGDrawCmd())
        c.kind = 2
        c.x = 10.0
        c.y = 20.0
        c.w = 100.0
        c.h = 50.0
        c.src = "media/ranta.jpg"
        c.hasCrop = true
        c.cropX = 0.25
        c.cropY = 0.0
        c.cropW = 0.5
        c.cropH = 1.0
        c.radius = 4.0
        def el@(optional):EVGElement (EVGListToElements.elementFor(c 200.0 200.0 true))
        this.check("a picture becomes an element" (!null? el))
        if (!null? el) {
            def pe:EVGElement (unwrap el)
            this.check("with its crop window" (pe.imageViewBoxSet && ((pe.imageViewBoxX == 0.25) && (pe.imageViewBoxW == 0.5))))
            this.check("and its rounded corners" (pe.box.borderRadius.pixels == 4.0))
        }
        def plain (new EVGDrawCmd())
        plain.kind = 2
        plain.w = 10.0
        plain.h = 10.0
        plain.src = "a.png"
        def el2@(optional):EVGElement (EVGListToElements.elementFor(plain 200.0 200.0 true))
        if (!null? el2) {
            def pe2:EVGElement (unwrap el2)
            this.check("an uncropped one shows the whole bitmap" (pe2.imageViewBoxSet == false))
        }
    }

    fn testStrokeStaysOpen:void () {
        print "--- a stroke is open, a fill is closed ---"
        def pts:[double] ([] _:double (0.0 0.0 10.0 0.0 10.0 10.0))
        def ends:[int]
        def stroke:string (EVGListToElements.ringsPath(pts ends false))
        def fill:string (EVGListToElements.ringsPath(pts ends true))
        this.check("a stroked corner has no Z" ((indexOf stroke "Z") < 0))
        this.check("a filled one does" ((indexOf fill "Z") >= 0))
        def c (new EVGDrawCmd())
        c.kind = 7
        c.pts = pts
        push c.ringEnds 6
        def el@(optional):EVGElement (EVGListToElements.elementFor(c 100.0 100.0 false))
        this.check("a polyline becomes a path" (!null? el))
        if (!null? el) {
            def pe:EVGElement (unwrap el)
            this.check("and is not closed back to its start" ((indexOf pe.svgPath "Z") < 0))
        }
    }

    fn testTwoRings:void () {
        print "--- two rings are two subpaths ---"
        def pts:[double] ([] _:double (0.0 0.0 10.0 0.0 10.0 10.0 20.0 20.0 30.0 20.0 30.0 30.0))
        def ends:[int]
        push ends 6
        push ends 12
        def d:string (EVGListToElements.ringsPath(pts ends true))
        def firstM:int (indexOf d "M")
        def lastM:int (lastIndexOf d "M")
        this.check("the second ring starts with its own M" ((firstM == 0) && (lastM > 0)))
        this.check("and the first ring holds three points" ((indexOf d "M 20") == lastM))
    }

    fn testTextIsOneLine:void () {
        print "--- a text run is not wrapped again ---"
        def c (new EVGDrawCmd())
        c.kind = 3
        c.x = 10.0
        c.y = 10.0
        c.w = 40.0
        c.h = 14.0
        c.text = "12 riviä"
        c.fontSize = 12.0
        def el@(optional):EVGElement (EVGListToElements.elementFor(c 100.0 100.0 false))
        this.check("a text command becomes text" (!null? el))
        if (!null? el) {
            def te:EVGElement (unwrap el)
            this.check("that does not wrap" (te.whiteSpace == "nowrap"))
        }
    }

    fn testWinAnsiStandIns:void () {
        print "--- characters WinAnsi has no byte for ---"
        this.check("the minus sign prints as an en dash" ((Utf8.toWinAnsi((Utf8.winAnsiStandIn(8722)))) == 150))
        this.check("a narrow no-break space as a no-break space" ((Utf8.toWinAnsi((Utf8.winAnsiStandIn(8239)))) == 160))
        this.check("a thin space as a space" ((Utf8.toWinAnsi((Utf8.winAnsiStandIn(8201)))) == 32))
        this.check("an ordinary letter is itself" ((Utf8.winAnsiStandIn(228)) == 228))
    }

    fn testBareFamilyIsRegular:void () {
        print "--- a bare family name is the regular face ---"
        def fm (new FontManager())
        def dir:string "gallery/pdf_writer/assets/fonts/Open_Sans"
        ; loaded italic first, the order a browser's parallel fetches can land in
        fm.loadFontBuffer("Open Sans-Italic" (buffer_read_file dir "OpenSans-Italic.ttf"))
        fm.loadFontBuffer("Open Sans-Bold" (buffer_read_file dir "OpenSans-Bold.ttf"))
        fm.loadFontBuffer("Open Sans" (buffer_read_file dir "OpenSans-Regular.ttf"))
        def f:TrueTypeFont (fm.getFont("Open Sans"))
        this.check(("Open Sans is the regular face (got " + f.fontStyle + ")") (FontManager.isRegularStyle(f.fontStyle)))
        def it:TrueTypeFont (fm.getFont("Open Sans-Italic"))
        this.check("and the italic is still there by name" (it.fontStyle == "Italic"))
    }

    ; The presentation app's route: faces handed over as BYTES (no fonts
    ; directory, as in a browser), a display list with emoji in a text run,
    ; converted and printed. The emoji face is attached first — the order
    ; parallel fetches can land in — and must neither become the face an
    ; unknown family resolves to nor leave "?" in the page.
    fn testEmojiFromFallbackFace:void () {
        print "--- emoji in a display list print from the fallback face ---"
        def fm (new FontManager())
        fm.loadFontBuffer("Noto Emoji-Regular" (buffer_read_file "gallery/pdf_writer/assets/fonts/Noto_Emoji" "NotoEmoji-Regular.ttf"))
        fm.loadFontBuffer("Open Sans" (buffer_read_file "gallery/pdf_writer/assets/fonts/Open_Sans" "OpenSans-Regular.ttf"))
        def unknown:TrueTypeFont (fm.getFont("Some Family Nobody Loaded"))
        this.check(("an unknown family is not answered by the emoji face (got " + unknown.fontFamily + ")") (unknown.fontFamily == "Open Sans"))

        ; Built from codepoints so the variation selectors are visible here.
        def vs:string (EVGCodepoint.toStr(65039))
        def party:string (EVGCodepoint.toStr(127881))
        def line:string ("Ready " + party + " " + (EVGCodepoint.toStr(10024)) + " ok " + (EVGCodepoint.toStr(169)) + vs + " " + (EVGCodepoint.toStr(10084)) + vs)
        def dl (new EVGDisplayList())
        dl.addText(line 20.0 20.0 14.0 (EVGColor.black()) "Open Sans" false false 360.0 20.0)
        def root:EVGElement (EVGListToElements.printRoot(400.0 100.0))
        def section:EVGElement (EVGListToElements.sectionOf(root))
        section.addChild((EVGListToElements.pageFrom(dl 400.0 100.0 (EVGColor.white()) false)))
        def r (new EVGPDFRenderer())
        r.init(r)
        r.setPageSize(400.0 100.0)
        r.setFontManager(fm)
        r.setMeasurer((new TTFTextMeasurer(fm)))
        def pdf:buffer (r.render(root))
        def text:string (buffer_to_string pdf)
        this.check("the PDF carries a Type0 fallback font" ((indexOf text "/Subtype /Type0") >= 0))
        this.check("drawn through Identity-H" ((indexOf text "/Encoding /Identity-H") >= 0))
        this.check(("no character was replaced by ? (" + (to_string (r.unsupportedGlyphCount())) + " reported)") ((r.unsupportedGlyphCount()) == 0))

        def cps:[int] (EVGCodepoint.toArray(party))
        def face:TrueTypeFont (fm.faceForCluster("Open Sans" cps 0 1))
        this.check(("U+1F389 resolves to the emoji face (got " + face.fontFamily + ")") (face.fontFamily == "Noto Emoji"))
        this.check("a variation selector is ignorable" (FontManager.isIgnorable(65039)))
        this.check("and costs no width after a text-face letter" ((fm.measureText(((EVGCodepoint.toStr(169)) + vs) "Open Sans" 14.0)) == (fm.measureText((EVGCodepoint.toStr(169)) "Open Sans" 14.0))))
    }
}

;
; EVGListToElementsTest — a display list going to the PDF writer keeps its
; shape: a stroke stays open, a line of text stays one line, a bare family
; name is the regular face, and the characters ordinary text is full of
; have a byte to print as.

Import "../EVGListToElements.rgr"
Import "../../../pdf_writer/src/core/Utf8.rgr"
Import "../../../pdf_writer/src/fonts/FontManager.rgr"

class EVGListToElementsTest {
    def passed:int 0
    def failed:int 0

    sfn main:void () {
        def t (new EVGListToElementsTest())
        t.run()
    }

    fn check:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS  " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL  " + name)
        }
    }

    fn run:void () {
        this.testStrokeStaysOpen()
        this.testTextIsOneLine()
        this.testWinAnsiStandIns()
        this.testBareFamilyIsRegular()
        print ("passed=" + (to_string passed) + " failed=" + (to_string failed))
        if (failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }

    fn testStrokeStaysOpen:void () {
        print "--- a stroke is open, a fill is closed ---"
        def pts:[double] ([] _:double (0.0 0.0 10.0 0.0 10.0 10.0))
        def ends:[int]
        def stroke:string (EVGListToElements.ringsPath(pts ends false))
        def fill:string (EVGListToElements.ringsPath(pts ends true))
        this.check("a stroked corner has no Z" ((indexOf stroke "Z") < 0))
        this.check("a filled one does" ((indexOf fill "Z") >= 0))
        def c (new EVGDrawCmd())
        c.kind = 7
        c.pts = pts
        push c.ringEnds 6
        def el@(optional):EVGElement (EVGListToElements.elementFor(c 100.0 100.0 false))
        this.check("a polyline becomes a path" (!null? el))
        if (!null? el) {
            def pe:EVGElement (unwrap el)
            this.check("and is not closed back to its start" ((indexOf pe.svgPath "Z") < 0))
        }
    }

    fn testTextIsOneLine:void () {
        print "--- a text run is not wrapped again ---"
        def c (new EVGDrawCmd())
        c.kind = 3
        c.x = 10.0
        c.y = 10.0
        c.w = 40.0
        c.h = 14.0
        c.text = "12 riviä"
        c.fontSize = 12.0
        def el@(optional):EVGElement (EVGListToElements.elementFor(c 100.0 100.0 false))
        this.check("a text command becomes text" (!null? el))
        if (!null? el) {
            def te:EVGElement (unwrap el)
            this.check("that does not wrap" (te.whiteSpace == "nowrap"))
        }
    }

    fn testWinAnsiStandIns:void () {
        print "--- characters WinAnsi has no byte for ---"
        this.check("the minus sign prints as an en dash" ((Utf8.toWinAnsi((Utf8.winAnsiStandIn(8722)))) == 150))
        this.check("a narrow no-break space as a no-break space" ((Utf8.toWinAnsi((Utf8.winAnsiStandIn(8239)))) == 160))
        this.check("a thin space as a space" ((Utf8.toWinAnsi((Utf8.winAnsiStandIn(8201)))) == 32))
        this.check("an ordinary letter is itself" ((Utf8.winAnsiStandIn(228)) == 228))
    }

    fn testBareFamilyIsRegular:void () {
        print "--- a bare family name is the regular face ---"
        def fm (new FontManager())
        def dir:string "gallery/pdf_writer/assets/fonts/Open_Sans"
        ; loaded italic first, the order a browser's parallel fetches can land in
        fm.loadFontBuffer("Open Sans-Italic" (buffer_read_file dir "OpenSans-Italic.ttf"))
        fm.loadFontBuffer("Open Sans-Bold" (buffer_read_file dir "OpenSans-Bold.ttf"))
        fm.loadFontBuffer("Open Sans" (buffer_read_file dir "OpenSans-Regular.ttf"))
        def f:TrueTypeFont (fm.getFont("Open Sans"))
        this.check(("Open Sans is the regular face (got " + f.fontStyle + ")") (FontManager.isRegularStyle(f.fontStyle)))
        def it:TrueTypeFont (fm.getFont("Open Sans-Italic"))
        this.check("and the italic is still there by name" (it.fontStyle == "Italic"))
    }
}

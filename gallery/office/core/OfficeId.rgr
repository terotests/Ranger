; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; OfficeId.rgr — a name for a thing that two editors can mint at once.
; ==============================================================================
;
; Every editor here names things with a counter: `nextParaId` in a document,
; `nextId` in a deck, a style index in a workbook. A counter is fine while one
; person edits one file, and it is exactly wrong the moment two do — because
; both of them mint 7, and 7 stops meaning one paragraph.
;
; The shape that fixes it is not new, and this is deliberately the same shape
; Yjs uses, because it is the one that works:
;
;     id = (client, clock)
;
; `client` is a number a session picks once and never shares; `clock` counts up
; within that session. Together they are a Lamport timestamp: unique with NO
; coordination between the sessions, which is the whole point — two editors
; that have never met cannot collide, so ids can be minted offline and merged
; later.
;
; WHAT THIS IS NOT.
;
; It is not a CRDT. Yjs's actual merge — YATA, where each inserted item carries
; `origin` and `originRight` so concurrent inserts at the same place order
; consistently on every peer — is a separate and much larger piece of work, and
; nothing here pretends to it. Neither is the tombstone model: Yjs does not
; record deletions as operations, it flags the item and keeps it so that
; concurrent edits still have something to point at.
;
; What is here is the layer under both of those, and the layer this gallery
; actually lacks:
;
;   OfficeId           a name that is unique without coordination
;   OfficeIdSource     one session minting them
;   OfficeStateVector  who has seen how far — the thing that makes a sync a
;                      delta rather than a whole document
;
; HONESTLY: nothing in the gallery is wired to this yet. The three editors mint
; their ids correctly for the single-session editing they do today — every
; entry point re-mints, and there is no collision to fix. This is the
; foundation the next step needs, tested on its own, and it says so rather than
; being quietly added to a model that does not use it.
; ==============================================================================

; A Lamport timestamp: which session, and how far into it.
class OfficeId {
    ; 0 is "no id" — a thing that was built rather than named.
    def client:int 0
    def clock:int 0

    Constructor () {
    }

    sfn of:OfficeId (client:int clock:int) {
        def id (new OfficeId())
        id.client = client
        id.clock = clock
        return id
    }

    fn isSet:boolean () {
        return (client != 0)
    }

    fn same:boolean (other:OfficeId) {
        if (client != other.client) {
            return false
        }
        return (clock == other.clock)
    }

    fn copy:OfficeId () {
        return (OfficeId.of(client clock))
    }

    ; A total order over ids from any number of sessions. Two ids from the same
    ; session order by clock, which is causal — a session's own edits happened
    ; in that order. Two from DIFFERENT sessions have no causal order at all,
    ; so the client number breaks the tie: arbitrary, but the same arbitrary
    ; answer on every peer, which is what a merge needs.
    fn compare:int (other:OfficeId) {
        if (client == other.client) {
            if (clock < other.clock) {
                return -1
            }
            if (clock > other.clock) {
                return 1
            }
            return 0
        }
        if (client < other.client) {
            return -1
        }
        return 1
    }

    ; "12:7" — for a log, a test failure or a debug overlay. Short on purpose:
    ; it is printed per entity.
    fn text:string () {
        return ((to_string client) + ":" + (to_string clock))
    }

    sfn parse:OfficeId (s:string) {
        def colon:int (indexOf s ":")
        if (colon < 0) {
            return (OfficeId.of(0 0))
        }
        def c@(optional):int (to_int (substring s 0 colon))
        def k@(optional):int (to_int (substring s (colon + 1) (strlen s)))
        return (OfficeId.of((?? c 0) (?? k 0)))
    }
}

; One session, minting ids.
;
; The client number has to be picked so that two sessions which have never
; communicated do not choose the same one. Yjs draws a random 53-bit integer;
; that is a birthday problem, and 53 bits makes it not one in practice. Ranger
; has no ambient randomness here and its `int` is not reliably 53 bits wide on
; every target, so the number is supplied by the CALLER — from a login, a
; device id, a server handout, or a random draw the host has and this does not.
; Being handed the number is also what makes a test able to say "these two
; sessions" and mean it.
class OfficeIdSource {
    def client:int 0
    def clock:int 0

    Constructor () {
    }

    sfn forClient:OfficeIdSource (client:int) {
        def s (new OfficeIdSource())
        s.client = client
        return s
    }

    ; The next name. Never reused within a session, which is what lets an id
    ; that has been deleted still be referred to — by an undo, by another
    ; peer's edit that has not arrived yet, or by a tombstone.
    fn next:OfficeId () {
        clock = (clock + 1)
        return (OfficeId.of(client clock))
    }

    ; How far this session has got. What a peer needs to know to send only what
    ; is missing.
    fn state:OfficeId () {
        return (OfficeId.of(client clock))
    }

    ; Take an id minted elsewhere into account, so this session never mints a
    ; clock it has already seen from ITSELF — which happens when a session's
    ; own edits come back from storage after a reload.
    fn observe:void (id:OfficeId) {
        if (id.client != client) {
            return
        }
        if (id.clock > clock) {
            clock = id.clock
        }
    }
}

; Who has seen how far.
;
; A set of (client, clock) high-water marks — Yjs's state vector, and the
; reason a sync is a delta and not a document. Two peers trade vectors, each
; works out what the other is missing, and only that is sent.
class OfficeStateVector {
    def clocks:[string:int]

    Constructor () {
    }

    fn clockOf:int (client:int) {
        def v@(optional):int (get clocks (to_string client))
        if (!null? v) {
            return (unwrap v)
        }
        return 0
    }

    ; Record that everything up to this id has been seen. High-water only: an
    ; id arriving out of order must not move the mark backwards.
    fn observe:void (id:OfficeId) {
        if (id.client == 0) {
            return
        }
        if (id.clock > (this.clockOf(id.client))) {
            set clocks (to_string id.client) id.clock
        }
    }

    ; Is this id already accounted for?
    fn has:boolean (id:OfficeId) {
        if (id.client == 0) {
            return false
        }
        return (id.clock <= (this.clockOf(id.client)))
    }

    fn clientCount:int () {
        return (array_length (keys clocks))
    }

    fn clients:[int] () {
        def out:[int]
        def ks:[string] (keys clocks)
        def i:int 0
        while (i < (array_length ks)) {
            def n@(optional):int (to_int (itemAt ks i))
            if (!null? n) {
                push out (unwrap n)
            }
            i = (i + 1)
        }
        return out
    }

    fn copy:OfficeStateVector () {
        def out (new OfficeStateVector())
        def ks:[string] (keys clocks)
        def i:int 0
        while (i < (array_length ks)) {
            def k:string (itemAt ks i)
            set out.clocks k (unwrap (get clocks k))
            i = (i + 1)
        }
        return out
    }

    fn observeAll:void (other:OfficeStateVector) {
        def cs:[int] (other.clients())
        def i:int 0
        while (i < (array_length cs)) {
            def c:int (itemAt cs i)
            this.observe((OfficeId.of(c (other.clockOf(c)))))
            i = (i + 1)
        }
    }

    ; What THIS peer has that `other` does not: for each client, the range of
    ; clocks `other` is missing, as (client, from, to) triples flattened into
    ; one array. `from` is exclusive and `to` inclusive, so an empty range is
    ; from == to and is left out.
    ;
    ; This is the whole reason the vector exists. Without it a peer that
    ; reconnects after one keystroke has to be sent the document.
    fn missingIn:[int] (other:OfficeStateVector) {
        def out:[int]
        def cs:[int] (this.clients())
        def i:int 0
        while (i < (array_length cs)) {
            def c:int (itemAt cs i)
            def mine:int (this.clockOf(c))
            def theirs:int (other.clockOf(c))
            if (mine > theirs) {
                push out c
                push out theirs
                push out mine
            }
            i = (i + 1)
        }
        return out
    }

    ; Everything the two peers together have seen.
    sfn merged:OfficeStateVector (a:OfficeStateVector b:OfficeStateVector) {
        def out:OfficeStateVector (a.copy())
        out.observeAll(b)
        return out
    }
}

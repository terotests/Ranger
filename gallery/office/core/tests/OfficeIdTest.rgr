; ==============================================================================
; OfficeIdTest — why a counter is not a name, and a state vector is a delta.
; ==============================================================================
;
; The first test here is the whole argument: two sessions minting from a
; COUNTER produce the same numbers, and two minting `(client, clock)` cannot.
; Everything else follows from that.
;
;   npm run office:id:test
; ==============================================================================

Import "../OfficeId.rgr"

class IdCheck {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }

    fn eqStr:void (name:string got:string want:string) {
        this.ok((name + " (got '" + got + "' want '" + want + "')") (got == want))
    }
}

class OfficeIdTest {
    sfn main:void () {
        def c:IdCheck (new IdCheck)
        print "== OfficeIdTest =="

        print "-- what a counter cannot do --"
        ; Two sessions editing the same document, neither able to ask the other
        ; anything. A counter gives them both the same answers.
        def counterA:int 0
        def counterB:int 0
        def collided:int 0
        def i:int 0
        while (i < 5) {
            counterA = (counterA + 1)
            counterB = (counterB + 1)
            if (counterA == counterB) {
                collided = (collided + 1)
            }
            i = (i + 1)
        }
        c.eqInt("two counters collide on every single id" collided 5)

        ; The same two sessions with ids of their own.
        def a:OfficeIdSource (OfficeIdSource.forClient(11))
        def b:OfficeIdSource (OfficeIdSource.forClient(22))
        def clashes:int 0
        def k:int 0
        while (k < 5) {
            def ia:OfficeId (a.next())
            def ib:OfficeId (b.next())
            if (ia.same(ib)) {
                clashes = (clashes + 1)
            }
            k = (k + 1)
        }
        c.eqInt("two sessions never collide, with no coordination at all" clashes 0)
        def aState:OfficeId (a.state())
        c.eqInt("and each counted its own five" aState.clock 5)

        print "-- an id --"
        def id:OfficeId (OfficeId.of(11 3))
        c.ok("it is set" (id.isSet()))
        def unnamed (new OfficeId)
        c.ok("and an unnamed one is not" ((unnamed.isSet()) == false))
        c.ok("the same id is the same" (id.same((OfficeId.of(11 3)))))
        c.ok("a different clock is not" ((id.same((OfficeId.of(11 4)))) == false))
        c.ok("nor a different session, at the same clock"
            ((id.same((OfficeId.of(12 3)))) == false))
        c.eqStr("it writes short" (id.text()) "11:3")
        c.ok("and reads back" (id.same((OfficeId.parse("11:3")))))
        c.ok("nonsense reads as unnamed" (((OfficeId.parse("nope")).isSet()) == false))
        def dup:OfficeId (id.copy())
        dup.clock = 9
        c.eqInt("a copy is a copy" id.clock 3)

        print "-- an order every peer agrees on --"
        ; Within a session the order is causal: its own edits happened in that
        ; order. Between sessions there IS no causal order, so the client
        ; number breaks the tie — arbitrary, but the same arbitrary answer
        ; everywhere, which is what a merge needs.
        c.ok("earlier in a session comes first"
            (((OfficeId.of(11 1)).compare((OfficeId.of(11 2)))) < 0))
        c.ok("later comes after"
            (((OfficeId.of(11 9)).compare((OfficeId.of(11 2)))) > 0))
        c.eqInt("the same id ties" ((OfficeId.of(11 2)).compare((OfficeId.of(11 2)))) 0)
        c.ok("across sessions the smaller client comes first"
            (((OfficeId.of(11 99)).compare((OfficeId.of(22 1)))) < 0))
        c.ok("and it is the same answer the other way round"
            (((OfficeId.of(22 1)).compare((OfficeId.of(11 99)))) > 0))

        print "-- a session that reloads its own work --"
        ; A session's own ids come back from storage after a reload. If it
        ; keeps minting from zero it hands out names it has already used.
        def back:OfficeIdSource (OfficeIdSource.forClient(11))
        back.observe((OfficeId.of(11 7)))
        def fresh:OfficeId (back.next())
        c.eqInt("it carries on past what it had already minted" fresh.clock 8)
        back.observe((OfficeId.of(11 3)))
        def st2:OfficeId (back.state())
        c.eqInt("an older id of its own does not move it back" st2.clock 8)
        back.observe((OfficeId.of(99 500)))
        def st3:OfficeId (back.state())
        c.eqInt("and another session's clock is not its business" st3.clock 8)

        print "-- who has seen how far --"
        def sv (new OfficeStateVector)
        c.eqInt("a fresh vector knows nobody" (sv.clientCount()) 0)
        c.eqInt("and everybody is at zero" (sv.clockOf(11)) 0)
        c.ok("so it has seen nothing" ((sv.has((OfficeId.of(11 1)))) == false))
        sv.observe((OfficeId.of(11 4)))
        c.eqInt("after seeing 11:4" (sv.clockOf(11)) 4)
        c.ok("it has seen 11:4" (sv.has((OfficeId.of(11 4)))))
        c.ok("and everything before it" (sv.has((OfficeId.of(11 1)))))
        c.ok("but not what comes after" ((sv.has((OfficeId.of(11 5)))) == false))
        ; Out of order arrival must not move the mark backwards.
        sv.observe((OfficeId.of(11 2)))
        c.eqInt("an older id does not lower the mark" (sv.clockOf(11)) 4)
        sv.observe((OfficeId.of(22 9)))
        c.eqInt("two sessions are known" (sv.clientCount()) 2)
        c.ok("an unnamed id is not a session" ((sv.has((OfficeId.of(0 1)))) == false))

        print "-- what to send, rather than what to have --"
        ; The whole reason the vector exists: a peer that reconnects after one
        ; keystroke is sent one keystroke, not the document.
        def mine (new OfficeStateVector)
        mine.observe((OfficeId.of(11 10)))
        mine.observe((OfficeId.of(22 5)))
        def theirs (new OfficeStateVector)
        theirs.observe((OfficeId.of(11 7)))
        theirs.observe((OfficeId.of(22 5)))
        def gap:[int] (mine.missingIn(theirs))
        c.eqInt("one session is behind, so one range to send" (array_length gap) 3)
        if ((array_length gap) == 3) {
            c.eqInt("it is that session" (itemAt gap 0) 11)
            c.eqInt("from where they had got to" (itemAt gap 1) 7)
            c.eqInt("up to where we have" (itemAt gap 2) 10)
        }
        c.eqInt("and they have nothing we lack" (array_length (theirs.missingIn(mine))) 0)
        ; A peer that has never seen a session at all gets that session whole.
        def stranger (new OfficeStateVector)
        def all:[int] (mine.missingIn(stranger))
        c.eqInt("a stranger is missing both sessions" (array_length all) 6)
        c.eqInt("starting from nothing" (itemAt all 1) 0)
        ; Nothing to send to yourself.
        c.eqInt("a peer is never behind itself" (array_length (mine.missingIn(mine))) 0)

        print "-- putting two peers together --"
        def both:OfficeStateVector (OfficeStateVector.merged(mine theirs))
        c.eqInt("the merge takes the higher mark" (both.clockOf(11)) 10)
        c.eqInt("and keeps the one they agree on" (both.clockOf(22)) 5)
        c.eqInt("neither is behind the merge afterwards"
            (array_length (both.missingIn((OfficeStateVector.merged(theirs mine))))) 0)
        ; And merging must not have changed either side.
        c.eqInt("merging leaves the first alone" (mine.clockOf(11)) 10)
        c.eqInt("and the second" (theirs.clockOf(11)) 7)

        print ""
        print ("passed=" + (to_string c.passed) + " failed=" + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }
}

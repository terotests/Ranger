        push c.entries (ShapeEntry.of("leftBrace" "Left Brace" "Brackets" ""))
        push c.entries (ShapeEntry.of("leftBracket" "Left Bracket" "Brackets" ""))
        push c.entries (ShapeEntry.of("rightBrace" "Right Brace" "Brackets" ""))
        push c.entries (ShapeEntry.of("rightBracket" "Right Bracket" "Brackets" ""))
        ; --- Action buttons ---
        push c.entries (ShapeEntry.of("actionButtonBackPrevious" "Back Previous" "Action buttons" ""))
        push c.entries (ShapeEntry.of("actionButtonBeginning" "Beginning" "Action buttons" ""))
        push c.entries (ShapeEntry.of("actionButtonBlank" "Blank" "Action buttons" ""))
        push c.entries (ShapeEntry.of("actionButtonDocument" "Document" "Action buttons" ""))
        push c.entries (ShapeEntry.of("actionButtonEnd" "End" "Action buttons" ""))

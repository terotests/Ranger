; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; OfficeShapeCatalog.rgr — the shapes an editor can offer, as data
; ==============================================================================
;
; Two editors have a button that inserts a shape. The slide editor offered a
; rectangle and an ellipse; the book editor offered a rectangle. Meanwhile
; `presets.txt` beside this file holds **187 DrawingML geometries** that both
; already RENDER, and `PptxEdit.addShapeAt` has always taken any preset name as
; a string. The shapes were there. Nothing named them.
;
; So this file is a table, not a feature: an id, a label, a category and the
; words somebody might search for. What an editor does with an entry is the
; editor's business — the slide editor stores the preset name, the book editor
; asks `OfficePresetShapes` for the outline and stores a path — and that
; difference is exactly why the catalogue holds neither.
;
; ONE SOURCE TODAY, MORE LATER. Every entry here is a preset, so `pathFor`
; goes through `OfficePresetShapes`. Entries from another source — a glyph
; outline, an SVG file — carry their own path data in `pathData` and answer
; from that instead. The two are told apart by `hasPath`, not by parsing the
; id, so adding a source does not touch this class.
;
; Categories follow the ones PowerPoint's own gallery uses, because a person
; looking for a chevron looks under Arrows whatever drew it.
; ==============================================================================

Import "OfficePresetShapes.rgr"

class ShapeEntry {
    ; The preset name for a preset, or a catalogue-unique id for anything else.
    def id:string ""
    def label:string ""
    def category:string ""
    ; Extra words a search should match — a plain substring of the label
    ; already matches, so these are the SYNONYMS: "circle" for an ellipse.
    def keywords:string ""
    ; Set only for an entry that is not a preset. See the header.
    def pathData:string ""
    ; Whether Office draws this one with **no fill by default**.
    ;
    ; It cannot be read off the geometry. `arc` and the braces and brackets all
    ; supply a closed, `fill norm` body AND the open run that is the shape
    ; people actually mean — an arc is a curve, not a pie sector; a brace is a
    ; squiggle, not a beige block — and which of the two you get is decided by
    ; the shape's default STYLE, which is not in the geometry file. So it is
    ; recorded here, per entry, as the small table it is.
    def noFill:boolean false
    ; Width ÷ height this shape wants, or **0 for "any box will do"**.
    ;
    ; Most shapes are happy at any proportion — a rectangle, an arrow, a
    ; callout — and 0 says so. A few are not, and it is not a matter of taste:
    ;
    ;   - A gear, a sun, a star and the twelve action buttons are built on a
    ;     circle. Stretched, the teeth splay and the button glyphs skew.
    ;   - A brace and a bracket put arms across the FULL width of the box, so
    ;     in a wide box a bracket is a rounded rectangle. They want to be tall.
    ;
    ; Nothing is forced to obey it. It is what a picker sizes its preview to
    ; and what an editor can offer as an insert size, so that inserting a gear
    ; gives you a gear.
    def aspect:double 0.0

    Constructor () {
    }

    fn hasPath:boolean () {
        return ((strlen pathData) > 0)
    }

    sfn of:ShapeEntry (id:string label:string category:string keywords:string) {
        def e (new ShapeEntry())
        e.id = id
        e.label = label
        e.category = category
        e.keywords = keywords
        return e
    }
}

; One drawable piece of a shape: an outline plus how it is painted.
;
; A preset is not one path. `actionButtonHome` is four — a face, a roof and a
; door in a darker tone, a chimney in a lighter one, and an outline — and every
; one of the twelve action buttons is built the same way. Handing back a single
; merged path throws that away, and painting all of it in one colour is why the
; house had no roof: the roof was there, in the same beige as the wall.
class ShapePart {
    def path:string ""
    ; `norm`, `darken`, `darkenLess`, `lighten`, `lightenLess`, or `none`.
    ; Anything but `none` is an area to fill; `none` is an outline only.
    def shade:string "norm"
    def stroked:boolean false

    Constructor () {
    }

    fn isFill:boolean () {
        return (shade != "none")
    }

    ; A number to shade the shape's own colour by: 1.0 leaves it alone, below
    ; 1.0 darkens, above lightens. The proportions are DrawingML's own.
    fn shadeFactor:double () {
        if (shade == "darken") {
            return 0.5
        }
        if (shade == "darkenLess") {
            return 0.75
        }
        if (shade == "lighten") {
            return 1.5
        }
        if (shade == "lightenLess") {
            return 1.25
        }
        return 1.0
    }
}

class OfficeShapeCatalog {
    def entries:[ShapeEntry]
    ; The preset geometry, loaded once by whoever has the file. A catalogue
    ; with no presets loaded still LISTS everything — the names and categories
    ; are here — and answers `pathFor` with nothing, which is what an editor
    ; that forgot to load them should see rather than a rectangle.
    def presets:OfficePresetShapes (new OfficePresetShapes())
    def presetsLoaded:boolean false

    ; NOTHING IS HANDED `this`.
    ;
    ; This used to read `OfficeShapeCatalog.fill(this)`, which is legal Ranger,
    ; compiles clean, and works on every target but one: the C++ writer reaches
    ; a shared pointer to the object through `shared_from_this()`, and inside a
    ; constructor there is no shared pointer yet. The native book editor died
    ; on `std::bad_weak_ptr` before it drew a frame. So the table is built as a
    ; plain list and assigned. See gallery/book/ISSUES.md 14.
    Constructor () {
        entries = (OfficeShapeCatalog.build())
    }

    ; `gallery/office/geom/assets/presets.txt`, read by the caller — this file
    ; has no file system and runs in a browser.
    fn loadPresets:void (text:string) {
        presets.load(text)
        presetsLoaded = true
    }

    fn count:int () {
        return (array_length entries)
    }

    fn at:ShapeEntry (i:int) {
        if (i < 0) {
            return (new ShapeEntry())
        }
        if (i >= (array_length entries)) {
            return (new ShapeEntry())
        }
        return (itemAt entries i)
    }

    ; The category names, in the order an editor should offer them.
    fn categories:[string] () {
        def out:[string]
        def i:int 0
        while (i < (array_length entries)) {
            def e:ShapeEntry (itemAt entries i)
            if ((OfficeShapeCatalog.hasString(out e.category)) == false) {
                push out e.category
            }
            i = (i + 1)
        }
        return out
    }

    fn inCategory:[ShapeEntry] (category:string) {
        def out:[ShapeEntry]
        def i:int 0
        while (i < (array_length entries)) {
            def e:ShapeEntry (itemAt entries i)
            if (e.category == category) {
                push out e
            }
            i = (i + 1)
        }
        return out
    }

    fn find:ShapeEntry (id:string) {
        def i:int 0
        while (i < (array_length entries)) {
            def e:ShapeEntry (itemAt entries i)
            if (e.id == id) {
                return e
            }
            i = (i + 1)
        }
        return (new ShapeEntry())
    }

    ; Case-insensitive substring over the label, the id and the keywords. An
    ; empty query answers with everything, which is what an empty search box
    ; should show.
    fn search:[ShapeEntry] (query:string) {
        def q:string (OfficeShapeCatalog.lower(query))
        def out:[ShapeEntry]
        def i:int 0
        while (i < (array_length entries)) {
            def e:ShapeEntry (itemAt entries i)
            if ((strlen q) == 0) {
                push out e
            } {
                def hay:string (OfficeShapeCatalog.lower(e.label + " " + e.id + " " + e.keywords))
                if (OfficeShapeCatalog.hasSub(hay q)) {
                    push out e
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; The outline for one entry, as SVG path data in **0..1 of its box** —
    ; `OfficePresetShapes` normalises its rings, and every consumer here scales
    ; a path to the frame it lands in anyway.
    ;
    ; `w` and `h` are still the box, because they are not the output size: they
    ; are what the guide evaluator computes the geometry FROM. A shape whose
    ; proportions depend on its box — a rounded rectangle's corner, an arrow's
    ; head — comes out differently at 100x100 than at 300x50, and passing the
    ; box it will actually occupy is what makes that right.
    ;
    ; An entry that carries its own path answers with it; a preset is asked of
    ; `OfficePresetShapes` and flattened. Empty means the shape could not be
    ; produced — no presets loaded, or a name this build does not have — and a
    ; caller must not draw a substitute, because a rectangle standing in for a
    ; heart is worse than nothing appearing.
    fn pathFor:string (id:string w:double h:double) {
        def e:ShapeEntry (this.find(id))
        if ((strlen e.id) == 0) {
            return ""
        }
        if (e.hasPath()) {
            return e.pathData
        }
        return (this.geometry(id w h true))
    }

    ; The part of a shape that only a STROKE can show.
    ;
    ; A preset is a list of paths and each states its own fill and stroke, and
    ; **69 of the 187 carry geometry that filling cannot draw**:
    ;
    ;   - `chartPlus` is a filled square PLUS a cross of two `fill none` runs;
    ;     the 23 callouts and the 17 action buttons are the same shape —
    ;     a filled body and an unfilled accent line or glyph over it.
    ;   - `line`, `lineInv` and the 9 connectors say `fill norm` but have only
    ;     two points, so their fill has no area at all.
    ;
    ; Merging every path into one filled run — which is what the first version
    ; of this did — fills the square solid and swallows the cross, and turns a
    ; line into nothing. So the geometry is split, and the split is per RING:
    ; a ring goes to the fill when its path is filled and it has three points
    ; or more, and to the stroke when it would otherwise be invisible.
    ;
    ; A plain rectangle is therefore fill-only here even though DrawingML also
    ; strokes it. Its outline is already where its fill ends, and a caller that
    ; wants a border has one: `BookFrame.stroke`, `<a:ln>` on a slide.
    ;
    ; The contact sheet in `tools/shape_sheet.rgr` is what caught this; the
    ; unit test did not, because a wrong path is still a path that starts
    ; with `M`.
    fn strokePathFor:string (id:string w:double h:double) {
        def e:ShapeEntry (this.find(id))
        if ((strlen e.id) == 0) {
            return ""
        }
        if (e.hasPath()) {
            return ""
        }
        return (this.geometry(id w h false))
    }

    ; True when a shape has no fillable geometry at all, so a caller that can
    ; only draw one path must stroke it rather than fill it. Eleven shapes are:
    ; `line`, `lineInv` and the nine connectors.
    fn isStrokeOnly:boolean (id:string w:double h:double) {
        if ((strlen (this.pathFor(id w h))) > 0) {
            return false
        }
        return ((strlen (this.strokePathFor(id w h))) > 0)
    }

    ; Every piece of a shape, in drawing order, each with the shade it is
    ; painted in.
    ;
    ; This is the whole shape; `pathFor` and `strokePathFor` are the two views
    ; of it that a caller with one path to give gets. A caller that can draw
    ; several — the contact sheet, a renderer, an exporter — should ask for the
    ; parts, because the shading is where the roof, the eyes, the cube's third
    ; face and every action button glyph live.
    ;
    ; Empty when the presets were never loaded or the id is not one this build
    ; has, for the same reason `pathFor` answers empty: a substitute rectangle
    ; standing in for a heart is worse than nothing appearing.
    fn partsFor:[ShapePart] (id:string w:double h:double) {
        def out:[ShapePart]
        def e:ShapeEntry (this.find(id))
        if ((strlen e.id) == 0) {
            return out
        }
        if (e.hasPath()) {
            def only (new ShapePart())
            only.path = e.pathData
            only.shade = "norm"
            if e.noFill {
                only.shade = "none"
                only.stroked = true
            }
            push out only
            return out
        }
        if (presetsLoaded == false) {
            return out
        }
        if ((presets.has(id)) == false) {
            return out
        }
        def adjNames:[string]
        def adjValues:[double]
        def paths:[GeomPath] (presets.pathsFor(id w h adjNames adjValues))
        ; Areas first, then lines — not the order the file lists them in.
        ;
        ; `chartPlus` lists its cross BEFORE the square it sits in, and so do
        ; the callouts and the action buttons: the detail comes first and the
        ; body after it. Drawn in file order the body covers the detail, which
        ; is a plain square where a chart marker should be. Every fill is drawn
        ; in file order among the fills, so a cube's three faces still stack
        ; the way they were written; the lines simply go last.
        def fills:[ShapePart]
        def lines:[ShapePart]
        def i:int 0
        while (i < (array_length paths)) {
            def gp:GeomPath (itemAt paths i)
            def filled:boolean (gp.fill != "none")
            ; A shape Office draws unfilled has its body dropped, not recoloured.
            ; Keeping it and painting it white would still cover whatever the
            ; shape sits on, which a brace must not do.
            if (e.noFill && filled) {
                i = (i + 1)
                continue
            }
            def fillRun:string ""
            if filled {
                fillRun = (OfficeShapeCatalog.oneSide(gp true))
            }
            def strokeRun:string ""
            if gp.stroke {
                strokeRun = (OfficeShapeCatalog.oneSide(gp false))
            }
            if ((strlen fillRun) > 0) {
                def part (new ShapePart())
                part.path = fillRun
                part.shade = gp.fill
                part.stroked = gp.stroke
                push fills part
            }
            if ((strlen strokeRun) > 0) {
                def line (new ShapePart())
                line.path = strokeRun
                line.shade = "none"
                line.stroked = true
                push lines line
            }
            i = (i + 1)
        }
        def f:int 0
        while (f < (array_length fills)) {
            push out (itemAt fills f)
            f = (f + 1)
        }
        def g:int 0
        while (g < (array_length lines)) {
            push out (itemAt lines g)
            g = (g + 1)
        }
        return out
    }

    ; @internal One half of a preset's geometry: the rings a fill draws, or the
    ; rings only a stroke can draw. Split rather than merged — see
    ; `strokePathFor`.
    fn geometry:string (id:string w:double h:double wantFill:boolean) {
        def parts:[ShapePart] (this.partsFor(id w h))
        def out:string ""
        def i:int 0
        while (i < (array_length parts)) {
            def p:ShapePart (itemAt parts i)
            if ((p.isFill()) == wantFill) {
                out = (out + p.path)
            }
            i = (i + 1)
        }
        return out
    }

    ; @internal One `GeomPath`, as either its fillable rings or the rings only
    ; a stroke shows. See `ringsToSvg` for which is which.
    sfn oneSide:string (gp:GeomPath wantFill:boolean) {
        def one:[GeomPath]
        push one gp
        return (OfficeShapeCatalog.ringsToSvg(one wantFill))
    }

    ; Every ring on the requested side as one `M … L … Z` run. The rings are
    ; already flattened by `OfficePresetShapes`, so there are no curves to
    ; carry.
    ;
    ; A ring is on the FILL side when its path is filled and the ring has three
    ; points or more; it is on the STROKE side when its path is stroked and the
    ; fill would not have shown it — an unfilled path, or a run of two points
    ; that encloses no area. A ring can be on neither side (an unfilled,
    ; unstroked path) and never on both.
    sfn ringsToSvg:string (paths:[GeomPath] wantFill:boolean) {
        def out:string ""
        def i:int 0
        while (i < (array_length paths)) {
            def p:GeomPath (itemAt paths i)
            def filled:boolean (p.fill != "none")
            def r:int 0
            while (r < (array_length p.rings)) {
                def ring:PathRing (itemAt p.rings r)
                def n:int (array_length ring.pts)
                ; Two coordinates per point, so 3 points is 6 doubles.
                def hasArea:boolean (n >= 6)
                def onFill:boolean (filled && hasArea)
                def wanted:boolean onFill
                if (wantFill == false) {
                    wanted = (p.stroke && (onFill == false))
                }
                if (wanted == false) {
                    r = (r + 1)
                    continue
                }
                def k:int 0
                while ((k + 1) < n) {
                    def x:double (itemAt ring.pts k)
                    def y:double (itemAt ring.pts (k + 1))
                    if (k == 0) {
                        out = (out + "M ")
                    } {
                        out = (out + "L ")
                    }
                    out = (out + (OfficeShapeCatalog.num(x)) + " " + (OfficeShapeCatalog.num(y)) + " ")
                    k = (k + 2)
                }
                if (n > 0) {
                    ; Only a filled ring closes. Closing a stroke draws a line
                    ; back across the shape — the diagonal through a plus.
                    if (wantFill) {
                        out = (out + "Z ")
                    }
                }
                r = (r + 1)
            }
            i = (i + 1)
        }
        return out
    }

    ; Four decimals, because these paths are in the **0..1 unit box** and not
    ; in points.
    ;
    ; Two decimals looked like plenty and was not: a hundredth of the unit box
    ; is a hundredth of the whole shape, so a pie wedge's quarter-circle — 32
    ; points, smooth geometry — quantised onto a 1% grid and came out as a run
    ; of visible flats. Four decimals is a ten-thousandth of the shape, which
    ; is a twentieth of a point on a shape a foot across, and costs about two
    ; characters a coordinate.
    sfn num:string (v:double) {
        def scaled:double (v * 10000.0)
        def r:int (floor (scaled + 0.5))
        if (scaled < 0.0) {
            r = (floor (scaled - 0.5))
        }
        def whole:int (idiv r 10000)
        def frac:int (r - (whole * 10000))
        if (frac < 0) {
            frac = (0 - frac)
        }
        if (frac == 0) {
            return (to_string whole)
        }
        def digits:string (to_string frac)
        while ((strlen digits) < 4) {
            digits = ("0" + digits)
        }
        ; No trailing zeros: `0.5000` is four characters of nothing.
        while ((strlen digits) > 1) {
            if ((substring digits ((strlen digits) - 1) (strlen digits)) != "0") {
                break
            }
            digits = (substring digits 0 ((strlen digits) - 1))
        }
        return ((to_string whole) + "." + digits)
    }

    sfn hasString:boolean (list:[string] want:string) {
        def i:int 0
        while (i < (array_length list)) {
            if ((itemAt list i) == want) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn lower:string (s:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def c:int (charAt s i)
            if (c >= 65) {
                if (c <= 90) {
                    c = (c + 32)
                }
            }
            def one:string (strfromcode c)
            out = (out + one)
            i = (i + 1)
        }
        return out
    }

    ; Not `contains`: that name is spoken for, and a static method that takes
    ; it is simply absent from the class — the same trap as `select` (a Go
    ; keyword) and a name beginning with a global operator.
    sfn hasSub:boolean (hay:string needle:string) {
        def hl:int (strlen hay)
        def nl:int (strlen needle)
        if (nl == 0) {
            return true
        }
        def limit:int (hl - nl)
        def i:int 0
        while (i <= limit) {
            if ((substring hay i (i + nl)) == needle) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; ----------------------------------------------------------------------
    ; The table. Generated from `presets.txt` so a preset this build has and
    ; this list does not is impossible.
    ; ----------------------------------------------------------------------
    ; @internal The shapes Office draws with no fill by default. Applied after
    ; the table is built, so the table stays one line per shape.
    ;
    ; All seven supply a closed body in their geometry that nobody wants: an
    ; arc's is the pie sector under the curve, a brace's is the block behind
    ; the squiggle. The eleven lines and connectors are NOT here — they have no
    ; fillable area at all, so the geometry already says it.
    ; @internal The whole table, as a list nobody has to own yet.
    sfn build:[ShapeEntry] () {
        def out:[ShapeEntry]
        OfficeShapeCatalog.fill(out)
        OfficeShapeCatalog.markNoFill(out)
        OfficeShapeCatalog.markAspect(out)
        return out
    }

    ; @internal `find` before there is a catalogue to find in.
    sfn findIn:ShapeEntry (list:[ShapeEntry] id:string) {
        def i:int 0
        while (i < (array_length list)) {
            def e:ShapeEntry (itemAt list i)
            if (e.id == id) {
                return e
            }
            i = (i + 1)
        }
        return (new ShapeEntry())
    }

    ; @internal The shapes with a proportion they need. See `ShapeEntry.aspect`.
    sfn markAspect:void (out:[ShapeEntry]) {
        ; Built on a circle: stretching them is what makes a gear look chewed.
        def square:[string]
        push square "arc"
        push square "blockArc"
        push square "chartPlus"
        push square "chartStar"
        push square "chartX"
        push square "circularArrow"
        push square "curvedDownArrow"
        push square "curvedLeftArrow"
        push square "curvedRightArrow"
        push square "curvedUpArrow"
        push square "donut"
        push square "gear6"
        push square "gear9"
        push square "leftCircularArrow"
        push square "leftRightCircularArrow"
        push square "moon"
        push square "noSmoking"
        push square "pie"
        push square "pieWedge"
        push square "smileyFace"
        push square "star10"
        push square "star12"
        push square "star16"
        push square "star24"
        push square "star32"
        push square "star4"
        push square "star5"
        push square "star6"
        push square "star7"
        push square "star8"
        push square "sun"
        push square "teardrop"
        push square "flowChartConnector"
        push square "flowChartOr"
        push square "flowChartSummingJunction"
        push square "actionButtonBackPrevious"
        push square "actionButtonBeginning"
        push square "actionButtonBlank"
        push square "actionButtonDocument"
        push square "actionButtonEnd"
        push square "actionButtonForwardNext"
        push square "actionButtonHelp"
        push square "actionButtonHome"
        push square "actionButtonInformation"
        push square "actionButtonMovie"
        push square "actionButtonReturn"
        push square "actionButtonSound"
        OfficeShapeCatalog.setAspect(out square 1.0)

        ; Arms across the full width, so a wide one stops being a bracket.
        def tall:[string]
        push tall "bracePair"
        push tall "bracketPair"
        push tall "leftBrace"
        push tall "rightBrace"
        push tall "leftBracket"
        push tall "rightBracket"
        push tall "verticalScroll"
        OfficeShapeCatalog.setAspect(out tall 0.4)
    }

    sfn setAspect:void (out:[ShapeEntry] ids:[string] a:double) {
        def i:int 0
        while (i < (array_length ids)) {
            def e:ShapeEntry (OfficeShapeCatalog.findIn(out (itemAt ids i)))
            if ((strlen e.id) > 0) {
                e.aspect = a
            }
            i = (i + 1)
        }
    }

    sfn markNoFill:void (out:[ShapeEntry]) {
        def ids:[string]
        push ids "arc"
        push ids "bracePair"
        push ids "bracketPair"
        push ids "leftBrace"
        push ids "rightBrace"
        push ids "leftBracket"
        push ids "rightBracket"
        def i:int 0
        while (i < (array_length ids)) {
            def e:ShapeEntry (OfficeShapeCatalog.findIn(out (itemAt ids i)))
            if ((strlen e.id) > 0) {
                e.noFill = true
            }
            i = (i + 1)
        }
    }

    sfn fill:void (out:[ShapeEntry]) {
        ; --- Basic ---
        push out (ShapeEntry.of("arc" "Arc" "Basic" "curve"))
        push out (ShapeEntry.of("blockArc" "Block arc" "Basic" ""))
        push out (ShapeEntry.of("can" "Cylinder" "Basic" "cylinder tube"))
        push out (ShapeEntry.of("chartPlus" "Chart plus" "Basic" ""))
        push out (ShapeEntry.of("chartStar" "Chart star" "Basic" ""))
        push out (ShapeEntry.of("chartX" "Chart X" "Basic" ""))
        push out (ShapeEntry.of("chord" "Chord" "Basic" ""))
        push out (ShapeEntry.of("cloud" "Cloud" "Basic" "weather"))
        push out (ShapeEntry.of("cube" "Cube" "Basic" "box 3d"))
        push out (ShapeEntry.of("decagon" "Decagon" "Basic" ""))
        push out (ShapeEntry.of("diamond" "Diamond" "Basic" "rhombus"))
        push out (ShapeEntry.of("dodecagon" "Dodecagon" "Basic" ""))
        push out (ShapeEntry.of("donut" "Donut" "Basic" "ring annulus"))
        push out (ShapeEntry.of("ellipse" "Ellipse" "Basic" "circle oval round"))
        push out (ShapeEntry.of("funnel" "Funnel" "Basic" ""))
        push out (ShapeEntry.of("gear6" "Gear, 6 teeth" "Basic" "cog wheel"))

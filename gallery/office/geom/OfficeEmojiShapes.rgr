; ==============================================================================
; OfficeEmojiShapes.rgr - GENERATED. Do not edit.
; ==============================================================================
;
;     npm run office:emoji:build
;
; 262 emoji glyph outlines as shape entries, from
; NotoEmoji-Regular.ttf by way of gallery/office/geom/tools/emoji_shapes.rgr.
; The paths are in the 0..1 unit box with y going down, which is what every
; consumer of `ShapeEntry.pathData` expects.
;
; To add one, put a line in gallery/office/geom/assets/emoji.txt and run the
; build again. Editing this file by hand loses the change on the next run.
;
; This imports the catalogue rather than the catalogue importing this, and
; that direction is deliberate: it is a megabyte of path data, and an editor
; that only wants the DrawingML presets should not carry it. Ask for it with
;
;     Import "../../office/geom/OfficeEmojiShapes.rgr"
;     OfficeEmojiShapes.fill(shapes)
;
; ==============================================================================

Import "OfficeShapeCatalog.rgr"

class OfficeEmojiShapes {
    sfn entryOf:ShapeEntry (id:string label:string category:string keywords:string path:string) {
        def e (ShapeEntry.of(id label category keywords))
        e.pathData = path
        ; Square. `pathOf` fits every glyph into the unit box with ONE
        ; scale and centres the short axis, so a wide box stretches the
        ; artwork rather than showing more of it.
        e.aspect = 1.0
        return e
    }


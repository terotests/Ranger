; ==============================================================================
; OfficePresetShapesTest — every one of the 187, and a few of them checked hard
; ==============================================================================
;
; The sweep is the point of this file. 187 shapes go through the catalogue and
; every one of them has to come back as a path with points in its own box:
; anything that returns nothing, returns two points, or wanders outside the
; unit square is a shape that would be drawn wrong on a slide and would look
; deliberate.
;
; Then a handful checked against geometry that can be worked out by hand,
; because a sweep proves that 187 shapes ARRIVE and not that any of them is
; right. A seven-pointed star has fourteen vertices at two radii; a triangle
; has three corners; a donut has a hole.
;
;   npm run office:geom:test
; ==============================================================================

Import "../OfficePresetShapes.rgr"

class PresetCheck {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS  " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL  " + name)
        }
    }

    fn near:void (name:string got:double want:double tol:double) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")")
                ((fabs (got - want)) < tol))
    }

    fn eqInt:void (name:string got:int want:int) {
        this.ok((name + " (got " + (to_string got) + " want " + (to_string want) + ")") (got == want))
    }
}

class OfficePresetShapesTest {
    sfn main:void () {
        def c (new PresetCheck)
        print "=== OfficePresetShapesTest ==="

        def buf:buffer (buffer_read_file "gallery/office/geom/assets" "presets.txt")
        def text:string (buffer_to_string buf)
        def cat (new OfficePresetShapes)
        cat.load(text)
        c.ok("the catalogue loaded" cat.ready)
        c.eqInt("with every shape ST_ShapeType names" (cat.count()) 187)

        def noAdjN:[string]
        def noAdjV:[double]

        print "-- every shape in the catalogue draws --"
        ; The sweep. A shape that comes back empty is a shape that would be
        ; drawn as a rectangle, which is exactly the failure this whole piece
        ; of work exists to end — and it fails silently, so it has to be
        ; counted rather than looked for.
        def empty:int 0
        def thin:int 0
        def outside:int 0
        def firstEmpty:string ""
        def firstThin:string ""
        def firstOutside:string ""
        def i:int 0
        while (i < (cat.count())) {
            def nm:string (cat.nameAt(i))
            def paths:[GeomPath] (cat.pathsFor(nm 400.0 200.0 noAdjN noAdjV))
            if ((array_length paths) == 0) {
                empty = (empty + 1)
                if ((strlen firstEmpty) == 0) {
                    firstEmpty = nm
                }
            } {
                def total:int 0
                def bad:boolean false
                def p:int 0
                while (p < (array_length paths)) {
                    def gp:GeomPath (itemAt paths p)
                    total = (total + (idiv (array_length gp.pts) 2))
                    def k:int 0
                    while (k < (array_length gp.pts)) {
                        def v:double (itemAt gp.pts k)
                        ; A shape lives in its own box. A little outside is
                        ; legitimate — a callout's tail, a shadow's offset —
                        ; but a coordinate a long way out is an evaluator that
                        ; got a unit wrong, and a shape drawn off the slide.
                        if ((v < -1.5) || (v > 2.5)) {
                            bad = true
                        }
                        k = (k + 1)
                    }
                    p = (p + 1)
                }
                if (total < 2) {
                    thin = (thin + 1)
                    if ((strlen firstThin) == 0) {
                        firstThin = nm
                    }
                }
                if bad {
                    outside = (outside + 1)
                    if ((strlen firstOutside) == 0) {
                        firstOutside = nm
                    }
                }
            }
            i = (i + 1)
        }
        c.eqInt(("no shape comes back empty (first: " + firstEmpty + ")") empty 0)
        c.eqInt(("none is fewer than two points (first: " + firstThin + ")") thin 0)
        c.eqInt(("and none wanders off its own box (first: " + firstOutside + ")") outside 0)

        ; The same sweep in a tall box, because `ss` is the shorter side and a
        ; shape that is right in one aspect ratio and wrong in the other is a
        ; shape whose evaluator used the width where it meant the short side.
        def emptyTall:int 0
        i = 0
        while (i < (cat.count())) {
            def nm2:string (cat.nameAt(i))
            def tallPaths:[GeomPath] (cat.pathsFor(nm2 120.0 900.0 noAdjN noAdjV))
            if ((array_length tallPaths) == 0) {
                emptyTall = (emptyTall + 1)
            }
            i = (i + 1)
        }
        c.eqInt("and every one of them draws in a tall box too" emptyTall 0)

        print "-- a triangle is a triangle --"
        def tri:[GeomPath] (cat.pathsFor("triangle" 400.0 200.0 noAdjN noAdjV))
        c.eqInt("one path" (array_length tri) 1)
        def t0:GeomPath (itemAt tri 0)
        c.eqInt("three corners" (idiv (array_length t0.pts) 2) 3)
        c.ok("and it closes" t0.closed)
        ; The apex is centred at the default adjustment, and the base spans
        ; the box: corners at (0,1), (1,1) and (0.5,0).
        def triMaxX:double (OfficePresetShapesTest.maxX(t0))
        c.near("the base spans the box" triMaxX 1.0 0.01)
        c.near("the base is on the bottom" (OfficePresetShapesTest.maxY(t0)) 1.0 0.01)
        c.near("and the apex on the top" (OfficePresetShapesTest.minY(t0)) 0.0 0.01)

        print "-- star7, the shape that started this --"
        ; A seven-pointed star: fourteen vertices, alternating between an outer
        ; and an inner radius. It used to be drawn as a rectangle.
        def st:[GeomPath] (cat.pathsFor("star7" 300.0 300.0 noAdjN noAdjV))
        c.eqInt("one path" (array_length st) 1)
        def s0:GeomPath (itemAt st 0)
        c.eqInt("fourteen vertices" (idiv (array_length s0.pts) 2) 14)
        c.ok("it closes" s0.closed)
        ; Seven of them are far from the centre and seven are near it, which is
        ; what makes it a star rather than a fourteen-sided polygon.
        ; The points sit at about half the box and the notches at about
        ; seven tenths of that — the default adjustment is 34601 of 50000 —
        ; so anything past 0.44 is a point and anything inside it is a notch.
        def far:int (OfficePresetShapesTest.countBeyond(s0 0.44))
        c.eqInt("seven points reach out" far 7)
        c.eqInt("and seven turn back in" ((idiv (array_length s0.pts) 2) - far) 7)

        print "-- shapes that state several paths --"
        ; A donut is a ring: an outer circle and an inner one, and the inner
        ; one is a hole rather than a second disc. Flattening the two into one
        ; ring, which is what the reader did before, draws a filled circle.
        def dn:[GeomPath] (cat.pathsFor("donut" 200.0 200.0 noAdjN noAdjV))
        c.ok("a donut has points" ((array_length dn) >= 1))
        def dnPts:int (OfficePresetShapesTest.totalPts(dn))
        c.ok("enough for two rings" (dnPts >= 16))
        ; A cube's shaded faces are separate paths the file says to darken.
        def cube:[GeomPath] (cat.pathsFor("cube" 200.0 200.0 noAdjN noAdjV))
        c.ok("a cube is more than one path" ((array_length cube) > 1))
        ; Its faces are not all painted the same way: the file states one
        ; darker and one lighter than the fill, which is what makes a flat
        ; polygon read as a solid. Flattening them into one path loses that.
        c.ok("the file shades one face" (OfficePresetShapesTest.anyFill(cube "darkenLess")))
        c.ok("and lightens another" (OfficePresetShapesTest.anyFill(cube "lightenLess")))
        ; And some paths are stroked only — an outline over a fill.
        def any:boolean false
        def n2:int 0
        while (n2 < (cat.count())) {
            def nm3:string (cat.nameAt(n2))
            def ps:[GeomPath] (cat.pathsFor(nm3 200.0 200.0 noAdjN noAdjV))
            if (OfficePresetShapesTest.anyFill(ps "none")) {
                any = true
            }
            n2 = (n2 + 1)
        }
        c.ok("some paths are drawn and not filled" any)

        print "-- the adjustment the document states, not the one the shape defaults to --"
        ; A rounded rectangle at its default corner, and at a quarter. The
        ; corner has to MOVE — this is the value that never reached the shape.
        def rrA:[GeomPath] (cat.pathsFor("roundRect" 400.0 400.0 noAdjN noAdjV))
        def adjN:[string]
        def adjV:[double]
        push adjN "adj"
        push adjV 50000.0
        def rrB:[GeomPath] (cat.pathsFor("roundRect" 400.0 400.0 adjN adjV))
        def a0:GeomPath (itemAt rrA 0)
        def b0:GeomPath (itemAt rrB 0)
        ; At the maximum adjustment a rounded rectangle in a square box is a
        ; circle, so its corners are pulled right in.
        def cornerA:double (OfficePresetShapesTest.nearestToCorner(a0))
        def cornerB:double (OfficePresetShapesTest.nearestToCorner(b0))
        c.ok(("a bigger adjustment rounds the corners more (" + (to_string cornerA) + " -> " + (to_string cornerB) + ")")
             (cornerB > cornerA))
        c.ok("the shape's own default is used when the document says nothing" (cornerA > 0.01))
        ; And an adjustment the shape has never heard of changes nothing.
        def junkN:[string]
        def junkV:[double]
        push junkN "nosuchadjustment"
        push junkV 90000.0
        def rrC:[GeomPath] (cat.pathsFor("roundRect" 400.0 400.0 junkN junkV))
        def c0:GeomPath (itemAt rrC 0)
        c.near("an adjustment it does not have is ignored" (OfficePresetShapesTest.nearestToCorner(c0)) cornerA 0.001)
        ; The names are readable, which is how a caller knows which of a
        ; document's `gd` entries belong to this shape.
        c.eqInt("a roundRect has one adjustment" (array_length (cat.adjNamesOf("roundRect"))) 1)
        c.ok("a callout has several" ((array_length (cat.adjNamesOf("wedgeRectCallout"))) >= 2))

        print "-- the text rectangle --"
        ; A preset says where its text goes, and for most shapes that is the
        ; whole box; for a callout it is the bubble and not the tail.
        def tr:[double] (cat.textRectFor("wedgeRectCallout" 400.0 200.0 noAdjN noAdjV))
        c.eqInt("a callout states one" (array_length tr) 4)
        c.ok("its left is left of its right" ((itemAt tr 0) < (itemAt tr 2)))
        c.ok("and its top above its bottom" ((itemAt tr 1) < (itemAt tr 3)))

        print "-- a name nothing defines --"
        def none:[GeomPath] (cat.pathsFor("notAShape" 100.0 100.0 noAdjN noAdjV))
        c.eqInt("is no paths rather than a throw" (array_length none) 0)
        c.ok("and the catalogue says so" ((cat.has("notAShape")) == false))
        c.ok("while it does know star7" (cat.has("star7")))

        print ""
        print ("passed = " + (to_string c.passed) + "  failed = " + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }

    sfn maxX:double (p:GeomPath) {
        def m:double -9.0
        def i:int 0
        while (i < (array_length p.pts)) {
            def v:double (itemAt p.pts i)
            if (v > m) {
                m = v
            }
            i = (i + 2)
        }
        return m
    }

    sfn minY:double (p:GeomPath) {
        def m:double 9.0
        def i:int 1
        while (i < (array_length p.pts)) {
            def v:double (itemAt p.pts i)
            if (v < m) {
                m = v
            }
            i = (i + 2)
        }
        return m
    }

    sfn maxY:double (p:GeomPath) {
        def m:double -9.0
        def i:int 1
        while (i < (array_length p.pts)) {
            def v:double (itemAt p.pts i)
            if (v > m) {
                m = v
            }
            i = (i + 2)
        }
        return m
    }

    ; How many vertices sit further than `r` from the centre of the box, in
    ; units of the box. A star has its points out here and its notches inside.
    sfn countBeyond:int (p:GeomPath r:double) {
        def n:int 0
        def i:int 0
        while ((i + 1) < (array_length p.pts)) {
            def dx:double ((itemAt p.pts i) - 0.5)
            def dy:double ((itemAt p.pts (i + 1)) - 0.5)
            if ((sqrt ((dx * dx) + (dy * dy))) > r) {
                n = (n + 1)
            }
            i = (i + 2)
        }
        return n
    }

    sfn totalPts:int (ps:[GeomPath]) {
        def n:int 0
        def i:int 0
        while (i < (array_length ps)) {
            def p:GeomPath (itemAt ps i)
            n = (n + (idiv (array_length p.pts) 2))
            i = (i + 1)
        }
        return n
    }

    sfn anyFill:boolean (ps:[GeomPath] want:string) {
        def i:int 0
        while (i < (array_length ps)) {
            def p:GeomPath (itemAt ps i)
            if (p.fill == want) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; How far the shape's outline is pulled away from the top-left corner of
    ; its box — nothing for a square, a lot for a circle. A rounder shape
    ; answers larger.
    sfn nearestToCorner:double (p:GeomPath) {
        def best:double 9.0
        def i:int 0
        while ((i + 1) < (array_length p.pts)) {
            def x:double (itemAt p.pts i)
            def y:double (itemAt p.pts (i + 1))
            def d:double (sqrt ((x * x) + (y * y)))
            if (d < best) {
                best = d
            }
            i = (i + 2)
        }
        return best
    }
}

; ==============================================================================
; OfficeRtlSwitchTest — one switch, three programs
; ==============================================================================
;
; The mirroring itself is checked where it lives: EVGRtlLayoutTest for the
; layout engine, EVGToolbarTest for the strip. What is checked here is that
; the three editors are WIRED to it — that there is a switch a reader can
; reach, that it turns the interface around, and that it turns itself on for a
; document that needs it.
;
; The automatic half is the part worth being careful about, so it is stated as
; a rule rather than as a behaviour: it only ever turns the switch ON. A
; reader who has turned the interface back the way they want it must not be
; overruled by the next file they open — a program that keeps undoing a
; deliberate choice is worse than one that never made it.
;
; And the switch is the INTERFACE's, not the document's. A Word file says
; which way its paragraphs run, and that is not the reader's to override by
; pressing a button on a toolbar; the two are separate settings that happen
; to agree most of the time.
;
;   npm run office:rtl:switch:test
; ==============================================================================

Import "../../../docx_viewer/src/DocxApp.rgr"
Import "../../../pptx/src/PptxApp.rgr"
Import "../../../datagrid/src/GridApp.rgr"

class SwitchCheck {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS  " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL  " + name)
        }
    }
}

class OfficeRtlSwitchTest {
    def c:SwitchCheck (new SwitchCheck)

    sfn main:void () {
        def t (new OfficeRtlSwitchTest())
        t.run()
    }

    fn run:void () {
        print "=== OfficeRtlSwitchTest ==="
        this.testWord()
        this.testPowerPoint()
        this.testSpreadsheet()
        print ""
        print (("passed = " + (to_string c.passed)) + ("  failed = " + (to_string c.failed)))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }

    ; Every strip has the button, every app answers the command, and pressing
    ; it turns the strip around. Written once and run three times, because the
    ; whole claim is that this is ONE mechanism.
    fn strip:void (who:string bar:EVGToolbar) {
        def found:boolean false
        def i:int 0
        while (i < (bar.count())) {
            def t:ToolItem (bar.at(i))
            if (t.command == "view.rtl") {
                found = true
            }
            i = (i + 1)
        }
        c.ok((who + ": the strip has the switch on it") found)
    }

    fn testWord:void () {
        print "--- Word ---"
        def app (new DocxApp)
        app.toolbar.build()
        this.strip("Word" app.toolbar)
        c.ok("Word: it starts left to right" ((app.uiRtl) == false))
        c.ok("Word: and so does its strip" ((app.toolbar.rtl) == false))

        def ran:boolean (app.runCommand("view.rtl" ""))
        c.ok("Word: the command is answered" ran)
        c.ok("Word: the interface is turned around" app.uiRtl)
        c.ok("Word: and the strip with it" app.toolbar.rtl)
        ; The same button is the way back — it is a switch, not a one-way trip.
        app.runCommand("view.rtl" "")
        c.ok("Word: pressing it again turns it back" ((app.uiRtl) == false))

        ; The automatic half, in a fresh program — which is the situation it
        ; is for: a reader opens a file and the interface is already the way
        ; the file needs it.
        def doc (new RichDocument)
        def p (new Paragraph)
        p.id = 1
        p.bidi = 1
        push doc.paragraphs p
        def app2 (new DocxApp)
        app2.toolbar.build()
        app2.adoptDocumentDirection(doc)
        c.ok("Word: an RTL document turns it on by itself" app2.uiRtl)
        c.ok("Word: and the strip came with it" app2.toolbar.rtl)

        ; And having been turned OFF by the reader, it stays off. This is the
        ; rule that keeps the automatic half from being a nuisance, and it is
        ; the one thing about it that has to be exactly right: a reader whose
        ; deliberate choice is undone by the next file they open will not try
        ; the switch a third time.
        app2.runCommand("view.rtl" "")
        c.ok("Word: the reader can turn it back off" ((app2.uiRtl) == false))
        app2.adoptDocumentDirection(doc)
        c.ok("Word: and the same document does not turn it on again"
            ((app2.uiRtl) == false))
        ; Turning it back ON by hand keeps the latch DOWN, and this rule
        ; changed deliberately. It used to lift — "the reader has said yes
        ; again, and there is nothing left to protect them from" — which was
        ; true only while the automatic half could never turn the switch off.
        ; It can now, so yes needs protecting exactly as no does: otherwise a
        ; reader who turns the interface on by hand loses it to the next
        ; left-to-right file they open.
        app2.runCommand("view.rtl" "")
        c.ok("Word: saying yes again is a decision too" app2.uiRtl)
        c.ok("Word: and it keeps the latch down" app2.uiRtlChosen)

        ; --- the bug this was reported as ---------------------------------------
        ;
        ; Open an Arabic file, then open an English one, and the interface
        ; stayed mirrored with nothing on screen to explain why. The automatic
        ; half only ever turned the switch ON: it returned early when the
        ; interface was already turned around, so no later document could turn
        ; it back. Nobody was protected by that — a reader's own choice is what
        ; `uiRtlChosen` records — and every reader who opened one right-to-left
        ; document was stuck with a mirrored interface for the rest of the
        ; session.
        def fresh (new DocxApp)
        fresh.toolbar.build()
        fresh.adoptDocumentDirection(doc)
        c.ok("Word: an RTL document turns it on" fresh.uiRtl)
        def ltr (new RichDocument)
        def plain (new Paragraph)
        plain.text = "Plain English"
        push ltr.paragraphs plain
        fresh.adoptDocumentDirection(ltr)
        c.ok("Word: and a left-to-right one turns it back off"
            ((fresh.uiRtl) == false))
        c.ok("Word: the strip came back with it"
            ((fresh.toolbar.rtl) == false))
        fresh.adoptDocumentDirection(doc)
        c.ok("Word: and it turns around again for the next RTL one" fresh.uiRtl)

        ; …but never against the reader. Once they have touched the switch the
        ; automatic half is finished, whichever way they set it.
        def held (new DocxApp)
        held.toolbar.build()
        held.runCommand("view.rtl" "")
        c.ok("Word: the reader turned it on by hand" held.uiRtl)
        held.adoptDocumentDirection(ltr)
        c.ok("Word: and a left-to-right document does not take it away"
            held.uiRtl)
    }

    fn testPowerPoint:void () {
        print "--- PowerPoint ---"
        def app (new PptxApp)
        app.toolbar.build()
        this.strip("PowerPoint" app.toolbar)
        c.ok("PowerPoint: it starts left to right" ((app.uiRtl) == false))
        def ran:boolean (app.runCommand("view.rtl" ""))
        c.ok("PowerPoint: the command is answered" ran)
        c.ok("PowerPoint: the interface is turned around" app.uiRtl)
        c.ok("PowerPoint: and the strip with it" app.toolbar.rtl)
        app.runCommand("view.rtl" "")
        c.ok("PowerPoint: and back" ((app.uiRtl) == false))

        ; The same stickiness, in the deck reader. An RTL deck turns the
        ; interface around and a left-to-right one turns it back — the early
        ; return that used to stop the second half meant one Arabic deck
        ; mirrored the interface for the rest of the session.
        def deck (new PptxApp)
        deck.toolbar.build()
        def arabic (new PptxPresentation)
        def s1 (new PptxSlide)
        def sh1 (new PptxShape)
        def p1 (new PptxParagraph)
        p1.rtl = 1
        push sh1.text.paragraphs p1
        push s1.shapes sh1
        push arabic.slides s1
        deck.presentation = arabic
        deck.adoptDeckDirection()
        c.ok("PowerPoint: an RTL deck turns it on" deck.uiRtl)

        def english (new PptxPresentation)
        def s2 (new PptxSlide)
        def sh2 (new PptxShape)
        def p2 (new PptxParagraph)
        push sh2.text.paragraphs p2
        push s2.shapes sh2
        push english.slides s2
        deck.presentation = english
        deck.adoptDeckDirection()
        c.ok("PowerPoint: and a left-to-right one turns it back off"
            ((deck.uiRtl) == false))

        ; A paragraph does not stop being Arabic for being inside a group, and
        ; the walk that only looked at a slide's top-level shapes missed
        ; exactly the shapes a diagram keeps its text in.
        def grouped (new PptxPresentation)
        def s3 (new PptxSlide)
        def grp (new PptxShape)
        grp.kind = (PptxShapeKind.group())
        def kid (new PptxShape)
        def p3 (new PptxParagraph)
        p3.rtl = 1
        push kid.text.paragraphs p3
        push grp.children kid
        push s3.shapes grp
        push grouped.slides s3
        deck.presentation = grouped
        deck.adoptDeckDirection()
        c.ok("PowerPoint: an RTL paragraph inside a group counts" deck.uiRtl)
    }

    fn testSpreadsheet:void () {
        print "--- the spreadsheet ---"
        def app (new GridApp)
        app.view.toolbar.build()
        this.strip("Sheet" app.view.toolbar)
        c.ok("Sheet: it starts left to right" ((app.uiRtl) == false))
        def ran:boolean (app.runCommand("view.rtl" ""))
        c.ok("Sheet: the command is answered" ran)
        c.ok("Sheet: the interface is turned around" app.uiRtl)
        c.ok("Sheet: and the strip with it" app.view.toolbar.rtl)
        app.runCommand("view.rtl" "")
        c.ok("Sheet: and back" ((app.uiRtl) == false))

        ; The automatic half asks the STYLE table, not the cells: a workbook's
        ; reading order is a format, so one style with it on is the answer
        ; however many cells wear that style.
        def app2 (new GridApp)
        app2.view.toolbar.build()
        def st (new CellStyle)
        st.readingOrder = 2
        push app2.model.styles st
        app2.adoptWorkbookDirection()
        c.ok("Sheet: a right-to-left style turns it on by itself" app2.uiRtl)
        app2.runCommand("view.rtl" "")
        app2.adoptWorkbookDirection()
        c.ok("Sheet: and does not undo the reader's choice"
            ((app2.uiRtl) == false))
        ; And the same stickiness here. A workbook's reading order is set as a
        ; FORMAT, so one style with it on is the whole answer — and one style
        ; with it on used to mirror the interface until the program was closed.
        def wb (new GridApp)
        wb.view.toolbar.build()
        def rtlStyle (new CellStyle)
        rtlStyle.readingOrder = 2
        push wb.model.styles rtlStyle
        wb.adoptWorkbookDirection()
        c.ok("Sheet: an RTL workbook turns it on" wb.uiRtl)

        def plainStyles:[CellStyle]
        def ltrStyle (new CellStyle)
        push plainStyles ltrStyle
        wb.model.styles = plainStyles
        wb.adoptWorkbookDirection()
        c.ok("Sheet: and a left-to-right one turns it back off"
            ((wb.uiRtl) == false))
    }
}

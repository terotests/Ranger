; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; OfficeTextMeasure - how wide a string is, asked once and answered consistently
; ==============================================================================
;
; The painter and the caret have to agree about the width of a piece of text or
; the caret sits somewhere the glyphs are not. That agreement is this class:
; one measurer, handed to the layout, used by both.
;
; It answers with the real font when a host has attached its text renderer, and
; with the old average-width guess (0.52em) when nothing has — a headless test
; or an export path has no fonts loaded, and a layout that cannot be computed
; at all is worse than one computed approximately.
;
; WHAT IS LEFT HERE, AND WHAT MOVED. The face walk and the measurement are
; `OfficeMeasure` — the same body `OfficeTextMetrics` and `gallery/markdown`
; use, which is the point: this class and that one were written months apart
; and answered the same question twice, in a directory whose whole purpose is
; that they should not. What stays is what genuinely differs on this side:
; the `UIContext` door a slide host attaches through, and the 0.52em guess for
; when nothing ever did. `OfficeMeasure`'s fallback is the renderer's bitmap
; step, which is a different number for a different set of callers, and
; averaging the two would change three editors' answers to fix a tidiness
; problem.
; ==============================================================================

Import "../../game_engine/ui/UIContext.rgr"
Import "OfficeFont.rgr"
Import "OfficeMeasure.rgr"

class OfficeTextMeasure {
    def hasCtx:boolean false
    def ctx:UIContext (new UIContext)
    ; The renderer, as the question `OfficeMeasure` answers. Built once at
    ; attach and held for the life of the deck — which is safe because
    ; `OfficeMeasure.hasFont` is derived from the FontManager rather than
    ; snapshotted, so a face that arrives after the host attached is seen.
    def om:OfficeMeasure (new OfficeMeasure())
    def family:string "Open Sans"
    def emFactor:double 0.52

    Constructor () {
    }

    fn attach:void (c:UIContext fam:string) {
        ctx = c
        family = fam
        hasCtx = true
        om = (c.tr.metrics())
    }

    ; The face the painter will actually use. `PptxView.paintTextCmd` switches
    ; the renderer's family by weight, so measuring has to switch the same way
    ; — a bold string is wider than the regular one, and a caret that measured
    ; the regular face lands short of the text it belongs to.
    ;
    ; The naming is `OfficeFont`'s, shared with the .docx reader, and so is the
    ; walk when the face is not loaded: this used to name "Family-Bold Italic"
    ; without ever asking whether such a face existed, so a deck whose family
    ; had no italic measured against whatever the renderer fell back to and
    ; never said which one that was.
    fn faceFor:string (bold:boolean italic:boolean) {
        if (hasCtx == false) {
            return (OfficeFont.faceName(family bold italic))
        }
        def hit:string (om.faceFor(family bold italic family))
        if ((strlen hit) > 0) {
            return hit
        }
        return (OfficeFont.faceName(family bold italic))
    }

    ; Whether the face a deck NAMED is one we can actually draw with. When it
    ; is not, everything below measures a different font at the same point
    ; size, and a box the author sized to fit is a box the text spills out of.
    ; With no renderer attached there is no substitution to detect, so nothing
    ; here reports one.
    fn hasFamily:boolean (fam:string) {
        if (hasCtx == false) {
            return true
        }
        return (om.hasFamily(fam))
    }

    ; --- what the run itself asked for ------------------------------------------
    ;
    ; Everything above answers for ONE family: the one the host attached. That
    ; was the whole of it for a long time, and it meant a deck naming Arial and
    ; a deck naming Times New Roman were measured, and drawn, in exactly the
    ; same face — the alias map that the spreadsheet and the .docx reader both
    ; go through was never reached from here.
    ;
    ; `drawnFamily` is the family a run ends up in, and `widthOfIn` measures in
    ; it. They are one pair on purpose: the display list carries the answer
    ; from the first, every width comes from the second, and a backend that
    ; obeys the family it is handed draws what was measured. Split them — name
    ; one family and measure another — and the caret drifts by the difference
    ; between the two faces, which is precisely the bug this exists to close.
    fn drawnFamily:string (named:string bold:boolean italic:boolean) {
        if (hasCtx == false) {
            if ((strlen (trim named)) == 0) {
                return family
            }
            return (OfficeFont.aliasFamily(named))
        }
        return (om.drawnFamily(named bold italic family))
    }

    ; The face for a run that names its own family, as `faceFor` is for the
    ; attached one.
    fn faceForIn:string (named:string bold:boolean italic:boolean) {
        def fam:string (this.drawnFamily(named bold italic))
        if (hasCtx == false) {
            return (OfficeFont.faceName(fam bold italic))
        }
        def hit:string (om.faceFor(fam bold italic family))
        if ((strlen hit) > 0) {
            return hit
        }
        return (OfficeFont.faceName(fam bold italic))
    }

    fn widthOf:double (text:string sizePx:double bold:boolean italic:boolean) {
        return (this.widthOfIn(text sizePx bold italic ""))
    }

    ; An empty `named` means "the family this host attached" — a bullet glyph,
    ; a measurement taken before any run is in hand — and takes the old path
    ; exactly.
    fn widthOfIn:double (text:string sizePx:double bold:boolean italic:boolean named:string) {
        if ((strlen text) == 0) {
            return 0.0
        }
        if (hasCtx == false) {
            return ((to_double (strlen text)) * sizePx * emFactor)
        }
        ; No poking of `ctx.tr.fontFamily` and no putting it back. That dance
        ; existed because the renderer measures through the face it is
        ; CURRENTLY on; `OfficeMeasure` takes the face as an argument, so there
        ; is no state to restore and no way to forget to.
        def fam:string (this.drawnFamily(named bold italic))
        return (om.width(text fam bold italic sizePx family))
    }
}

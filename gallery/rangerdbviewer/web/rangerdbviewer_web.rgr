; ==============================================================================
; rangerdbviewer_web.rgr — the workbench, in a browser tab, with no host.
; ==============================================================================
;
;   browser event → RangerDbViewerWeb → DbViewerFrame → DbViewerApp   (this tab)
;   DbViewerFrame.sceneJson() → EVGDisplayList → evg-webgl.js         (this tab)
;
; The database runs in the tab too, which is the part worth pausing on. SQLite
; is `node:sqlite` and DuckDB is a native addon: both are host binaries, and a
; page served from a static directory has no host to ask. RangerDB is written
; in Ranger, so it compiles to JavaScript along with everything above it and
; the page really does hold a database rather than a picture of one.
;
; That is also the honest limit of this build, and the strip says so rather
; than hiding it: pressing SQLite reports that it needs a host process instead
; of failing silently.
;
; This class is a facade and nothing else. Every decision it might be tempted
; to make lives one layer down, in `DbViewerFrame`, where the tests reach it.
; ==============================================================================

Import "../app/DbViewerFrame.rgr"

class RangerDbViewerWeb {
    def frame:DbViewerFrame (new DbViewerFrame)

    Constructor () {
    }

    fn start:void (w:int h:int) {
        frame.init(w h)
        frame.openDemo("rangerdb")
        frame.runCommand("view.diagram" "")
    }

    ; Fonts arrive as bytes; there is no font directory to read.
    fn addFont:boolean (family:string data:buffer) {
        return (frame.ctx.tr.loadFontBytes(family data))
    }

    fn addFace:boolean (data:buffer) {
        return (frame.ctx.tr.addFaceBytes(data))
    }

    fn resize:void (w:int h:int) {
        frame.resize(w h)
    }

    fn scene:string () {
        return (frame.sceneJson())
    }

    fn pointer:boolean (x:int y:int pressed:boolean down:boolean released:boolean) {
        return (frame.pointer(x y pressed down released))
    }

    fn wheel:boolean (dy:int) {
        return (frame.wheel(dy))
    }

    fn run:boolean (id:string arg:string) {
        return (frame.runCommand(id arg))
    }

    fn status:string () {
        return (frame.app.status)
    }

    fn note:string () {
        return frame.note
    }

    fn section:string () {
        return (frame.app.section)
    }

    fn engineName:string () {
        return (frame.app.source.engine)
    }

    fn tableCount:int () {
        return (frame.app.tree.tableCount)
    }

    fn selectedTable:string () {
        return (frame.app.selectedTable)
    }

    fn selectTable:boolean (name:string) {
        def ok:boolean (frame.app.selectTable(name))
        if ok {
            frame.dataOffset = 0
            if (frame.diagramScope == "near") {
                frame.diagramReady = false
            }
        }
        return ok
    }

    ; The object list as JSON, for a host that would rather draw the tree with
    ; DOM elements than read it off the canvas — and for the smoke test, which
    ; needs to know what the page believes it is showing.
    fn treeJson:string () {
        def rows:[TreeRow] (frame.app.tree.visibleRows())
        def out:string "["
        def i:int 0
        def n:int (array_length rows)
        while (i < n) {
            def r:TreeRow (itemAt rows i)
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + "{\"kind\":" + (EVGDisplayList.jsonString(r.kind)))
            out = (out + ",\"label\":" + (EVGDisplayList.jsonString(r.label)))
            out = (out + ",\"detail\":" + (EVGDisplayList.jsonString(r.detail)))
            out = (out + ",\"table\":" + (EVGDisplayList.jsonString(r.tableName)))
            out = (out + ",\"depth\":" + (to_string r.depth) + "}")
            i = (i + 1)
        }
        return (out + "]")
    }

    ; What the introspector could not describe, so the page can show it beside
    ; the schema instead of letting a reader conclude the database has none.
    fn gapsText:string () {
        return (frame.app.introspector.gapText())
    }

    ; The diagram on its own, as SVG. The page hands this to the viewer as a
    ; download; the frame itself still writes no files.
    fn diagramSvg:string () {
        def sub:DatabaseSchema (frame.scopedSchema())
        def d:SchemaDiagram (new SchemaDiagram)
        def v:FlowView (d.buildView(sub))
        def sc:FlowScene (v.build())
        return (sc.toSvg())
    }

    ; The findings the schema alone supports, as JSON — for a page that would
    ; rather list them in the DOM than read them off the canvas.
    fn findingsJson:string () {
        frame.runAudit()
        def list:[Finding] (frame.findings.ordered())
        def out:string "["
        def i:int 0
        def n:int (array_length list)
        while (i < n) {
            def f:Finding (itemAt list i)
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + "{\"rule\":" + (EVGDisplayString.of(f.rule)))
            out = (out + ",\"severity\":" + (EVGDisplayString.of(f.severity)))
            out = (out + ",\"table\":" + (EVGDisplayString.of(f.table)))
            out = (out + ",\"object\":" + (EVGDisplayString.of(f.object)))
            out = (out + ",\"message\":" + (EVGDisplayString.of(f.message)))
            out = (out + ",\"fix\":" + (EVGDisplayString.of(f.fix)))
            out = (out + ",\"observed\":" + (EVGDisplayString.boolText(f.observed)) + "}")
            i = (i + 1)
        }
        return (out + "]")
    }

    ; The schema as DDL, in this build's dialect. Written by SchemaToDdl,
    ; which is checked against DdlToSchema by a round-trip test rather than by
    ; anyone reading its output.
    fn schemaDdl:string () {
        return (frame.schemaDdl())
    }

    ; The schema as JSON — the export every other format is derived from, and
    ; the one a page can produce without a font in sight.
    fn schemaJson:string () {
        def s:DatabaseSchema frame.app.schema
        def out:string ("{\"engine\":" + (EVGDisplayList.jsonString(s.engine)) + ",\"tables\":[")
        def i:int 0
        def n:int (array_length s.tables)
        while (i < n) {
            def t:DBTable (itemAt s.tables i)
            if (i > 0) {
                out = (out + ",")
            }
            out = (out + "{\"name\":" + (EVGDisplayString.of(t.name)))
            out = (out + ",\"kind\":" + (EVGDisplayString.of(t.kind)))
            out = (out + ",\"columns\":[")
            def c:int 0
            def nc:int (array_length t.columns)
            while (c < nc) {
                def col:SchemaColumn (itemAt t.columns c)
                if (c > 0) {
                    out = (out + ",")
                }
                out = (out + "{\"name\":" + (EVGDisplayString.of(col.name)))
                out = (out + ",\"type\":" + (EVGDisplayString.of(col.dataType)))
                out = (out + ",\"nullable\":" + (EVGDisplayString.boolText(col.nullable)))
                out = (out + ",\"pk\":" + (EVGDisplayString.boolText(col.isPrimaryKey)))
                out = (out + ",\"fk\":" + (EVGDisplayString.boolText(col.isForeignKey)) + "}")
                c = (c + 1)
            }
            out = (out + "]}")
            i = (i + 1)
        }
        out = (out + "],\"foreignKeys\":[")
        def k:int 0
        def nk:int (array_length s.foreignKeys)
        while (k < nk) {
            def fk:DBForeignKey (itemAt s.foreignKeys k)
            if (k > 0) {
                out = (out + ",")
            }
            out = (out + "{\"from\":" + (EVGDisplayString.of(fk.fromTable)))
            out = (out + ",\"fromColumn\":" + (EVGDisplayString.of((fk.firstFromColumn()))))
            out = (out + ",\"to\":" + (EVGDisplayString.of(fk.toTable)))
            out = (out + ",\"toColumn\":" + (EVGDisplayString.of((fk.firstToColumn()))) + "}")
            k = (k + 1)
        }
        return (out + "]}")
    }
}

; A tiny shim so the JSON above reads as one call per value rather than as
; nested parentheses. `EVGDisplayList.jsonString` is the escaper; this only
; gives it a shorter name and adds the boolean spelling JSON wants.
class EVGDisplayString {
    sfn of:string (s:string) {
        return (EVGDisplayList.jsonString(s))
    }

    sfn boolText:string (b:boolean) {
        if b {
            return "true"
        }
        return "false"
    }
}

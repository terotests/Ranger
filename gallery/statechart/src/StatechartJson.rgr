; =============================================================================
; StatechartJson — the machine, read from the shape XState writes
; =============================================================================
; `createMachine({ id, initial, context, states: { … on: { EVENT: { target,
; actions } } } })` is the shape every machine in the app is already written
; in. This reads it. A machine is then ONE FILE that both sides can hold: the
; TypeScript app runs it through XState, and this runs it through
; `gallery/statechart`, and neither is a transcription of the other.
;
; What cannot come across as-is is `assign`. In XState it is a FUNCTION —
; `assign(({event}) => ({ targetDate: event.targetDate || today }))` — and a
; function is not data. So an assignment is a VALUE EXPRESSION, and the forms
; are the general ones rather than one per machine:
;
;   { "value": … }                       a literal — the JSON value itself, so
;                                        a string, a number, a boolean, a list
;                                        or an object all say what they are
;   { "event": "targetDate" }            a named field of the event
;   { "context": "today" }               a context key
;   { "or": [ … ] }                      the first part that carries anything
;   { "setKey": { "map": …, "key": …, "value": … } }
;                                        a map with one key set, which is
;                                        `{ ...map, [key]: value }`
;
; `{ "or": [ {"event":"targetDate"}, {"context":"today"} ] }` is
; `event.targetDate || today` written down instead of run — and `or` is what
; `||` is, not a special case for the machine that happened to need it first.
;
; `"on": { "EVENT": "stateName" }` is accepted as XState accepts it — the
; shorthand for a target with no actions.
; =============================================================================

Import "Statechart.rgr"
Import "../../vela/src/VlJson.rgr"

class StatechartJson {

    Constructor () {
    }

    ; One value expression, read recursively — `or` holds expressions and one
    ; of them may be an `or` in turn.
    ; A JSON node → a context value. This is the bridge in one direction;
    ; `ScValOps.toJson` is the other, and the two have to agree or a
    ; comparison against the library means nothing.
    sfn valOf:ScVal (node:VlJson) {
        if (node.isString()) {
            return (ScValOps.str((node.asString())))
        }
        if (node.isBool()) {
            return (ScValOps.bool((node.asBool())))
        }
        if (node.isNumber()) {
            return (ScValOps.num((node.asDouble())))
        }
        if (node.isArray()) {
            def items:[ScVal]
            def count:int (node.count())
            def i@(mutable):int 0
            while (i < count) {
                push items (StatechartJson.valOf((node.at(i))))
                i = (i + 1)
            }
            return (new ScVal.List(items))
        }
        if (node.isObject()) {
            def keys:[string]
            def entries:[ScVal]
            for node.keys key:string j {
                push keys key
                push entries (StatechartJson.valOf((node.get(key))))
            }
            return (new ScVal.Map(keys entries))
        }
        return (ScValOps.nothing())
    }

    sfn valueOf:ScValue (spec:VlJson) {
        if (spec.has("setKey")) {
            def parts:VlJson (spec.get("setKey"))
            return (ScValue.setKey(
                (StatechartJson.valueOf((parts.get("map"))))
                (StatechartJson.valueOf((parts.get("key"))))
                (StatechartJson.valueOf((parts.get("value"))))))
        }
        if (spec.has("or")) {
            def either:ScValue (ScValue.either())
            def parts:VlJson (spec.get("or"))
            def count:int (parts.count())
            def i@(mutable):int 0
            while (i < count) {
                push either.parts (StatechartJson.valueOf((parts.at(i))))
                i = (i + 1)
            }
            return either
        }
        if (spec.has("event")) {
            return (ScValue.event((spec.stringOr("event" ""))))
        }
        if (spec.has("context")) {
            return (ScValue.context((spec.stringOr("context" ""))))
        }
        return (ScValue.value((StatechartJson.valOf((spec.get("value"))))))
    }

    sfn readActions:void (t:ScTransition actions:VlJson) {
        def count:int (actions.count())
        def i@(mutable):int 0
        while (i < count) {
            def action:VlJson (actions.at(i))
            if (action.has("assign")) {
                def assigns:VlJson (action.get("assign"))
                for assigns.keys key:string k {
                    push t.assigns (ScAssign.of(key (StatechartJson.valueOf((assigns.get(key))))))
                }
            }
            ; A NAMED action, which the host provides — XState's
            ; `setup({ actions })`. The runner reports it and runs nothing.
            if (action.has("action")) {
                push t.actions (action.stringOr("action" ""))
            }
            i = (i + 1)
        }
    }

    sfn load:Statechart (text:string) {
        def parser (new VlJsonParser)
        def root:VlJson (parser.parse(text))
        def chart (new Statechart)
        chart.id = (root.stringOr("id" ""))
        chart.initial = (root.stringOr("initial" ""))

        if (root.has("context")) {
            def context:VlJson (root.get("context"))
            for context.keys key:string i {
                chart.context(key (StatechartJson.valOf((context.get(key)))))
            }
        }

        if (root.has("states") == false) {
            return chart
        }
        def states:VlJson (root.get("states"))
        for states.keys name:string s {
            def node:VlJson (states.get(name))
            def state:ScState (chart.state(name))
            if (node.has("on")) {
                def on:VlJson (node.get("on"))
                for on.keys event:string e {
                    def spec:VlJson (on.get(event))
                    ; `"EVENT": "target"` — XState's shorthand.
                    if (spec.isString()) {
                        state.on(event (spec.asString()))
                    } {
                        def t:ScTransition (state.on(event (spec.stringOr("target" ""))))
                        if (spec.has("actions")) {
                            StatechartJson.readActions(t (spec.get("actions")))
                        }
                    }
                }
            }
        }
        return chart
    }
}

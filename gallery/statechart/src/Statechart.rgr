; SPDX-License-Identifier: AGPL-3.0-or-later

; =============================================================================
; Statechart — a machine as DATA, and the runner that walks it
; =============================================================================
; Not a clone of XState. XState is MIT (Copyright (c) 2015 David Khourshid) so
; a clone would be allowed; it is the wrong thing to build. A clone means API
; compatibility with actors, spawning, the actor system and inspection — none
; of which the machines being ported use — and it would be judged against
; XState's whole semantics rather than against the app's behaviour, which is
; the only thing that matters here.
;
; What earns its keep is the OTHER half: with the machine as data, a port stops
; being hand-written code per machine and becomes one runner plus a definition.
; And the definition compiles to Kotlin and Swift like everything else here,
; which a JavaScript library never would.
;
; The surface is what three real machines use, measured rather than guessed
; (`grep` over their sources), and each tier arrived with the machine that
; needed it:
;
;   addWorkoutDialogMachine   id · initial · states · on · target · assign
;   planDialogMachine         + a typed context · named host actions
;   chatMachine               + nested states · guards · always · onDone ·
;                               type:"final" · machine-level on
;
; Nothing of theirs is missing: `after`, `invoke`, `entry` and `exit` appear in
; none of the three. (An earlier note here claimed chatMachine used `after` and
; `invoke`, on the strength of a comment in its source saying a state WOULD
; invoke a save service. It does not — `SAVE_COMPLETE` is an ordinary event.)
; Were they to arrive they would still be the host's: both are time and
; effects, which a definition that compiles to Kotlin and Swift cannot own.
;
; Conformance is not this module's own opinion. `gallery/realtrainer` runs the
; table transcribed from the XState source through this runner, a hand-written
; port and XState ITSELF and requires the same answer in all twenty-one cells;
; `rt:machine:live` then crosses every state with every event and fuzzes the
; orders nobody wrote down, and `rt:machine:config` diffs the definition
; against the real TypeScript.
; =============================================================================

; =============================================================================
; A context value
; =============================================================================
; The first machine ported here had a context of four strings, so the context
; was four strings. The second one — `planDialogMachine` — has a list of day
; indices, three maps keyed by day, a boolean and a list of fetched entries,
; and that is where "everything is a string" stops being a simplification and
; becomes a lie.
;
; A closed family instead. `match` over it is checked for exhaustiveness, so a
; kind added later cannot be silently unhandled in the runner, the JSON bridge
; or a comparison.
shape ScVal {
    case Nothing
    case Str  { def text:string "" }
    case Bool { def flag:boolean false }
    case Num  { def value:double 0.0 }
    case List { def items:[ScVal] }
    ; Keys are strings even when the machine keys by day number, which is what
    ; JSON does with an object anyway.
    case Map  {
        def keys:[string]
        def entries:[ScVal]
    }
}

class ScValOps {

    Constructor () {
    }

    sfn str:ScVal (text:string) {
        return (new ScVal.Str(text))
    }

    sfn bool:ScVal (flag:boolean) {
        return (new ScVal.Bool(flag))
    }

    sfn num:ScVal (value:double) {
        return (new ScVal.Num(value))
    }

    sfn nothing:ScVal () {
        return (new ScVal.Nothing)
    }

    sfn emptyList:ScVal () {
        def items:[ScVal]
        return (new ScVal.List(items))
    }

    sfn emptyMap:ScVal () {
        def keys:[string]
        def entries:[ScVal]
        return (new ScVal.Map(keys entries))
    }

    ; A value carries something. `or` asks this, and it is the one place where
    ; the answer differs from JavaScript on purpose: an empty string, an empty
    ; list and an empty map are all falsy here, as `||` would treat "" — and a
    ; `false` is falsy, as it is there.
    sfn present:boolean (v:ScVal) {
        match v {
            Nothing { return false }
            Str s { return ((strlen s.text) > 0) }
            Bool b { return b.flag }
            Num n { return true }
            List l { return ((array_length l.items) > 0) }
            Map m { return ((array_length m.keys) > 0) }
        }
        return false
    }

    ; A map with one key set. The original spreads and overwrites:
    ; `{ ...context.keepSameByDay, [event.day]: event.keep }`.
    sfn withKey:ScVal (target:ScVal key:string value:ScVal) {
        def keys:[string]
        def entries:[ScVal]
        match target {
            Map m {
                for m.keys k:string i {
                    push keys k
                    push entries (itemAt m.entries i)
                }
            }
            Nothing { }
            Str s { }
            Bool b { }
            Num n { }
            List l { }
        }
        def at@(mutable):int -1
        for keys k2:string j {
            if (k2 == key) {
                at = j
            }
        }
        if (at >= 0) {
            set entries at value
        } {
            push keys key
            push entries value
        }
        return (new ScVal.Map(keys entries))
    }

    ; A list's items, or nothing. `match` does not nest inside a loop inside a
    ; `match` here, so the families are unwrapped one level at a time.
    ; How many: a list's items, a map's keys, a string's characters.
    ; Not `count`: that name is taken and the compiler answers by saying the
    ; class has no such method, which is a confusing way to learn it.
    sfn sizeOf:int (v:ScVal) {
        match v {
            List l { return (array_length l.items) }
            Map m { return (array_length m.keys) }
            Str s { return (strlen s.text) }
            Nothing { return 0 }
            Bool b { return 0 }
            Num n { return 0 }
        }
        return 0
    }

    sfn items:[ScVal] (v:ScVal) {
        def out:[ScVal]
        match v {
            List l {
                for l.items item:ScVal i {
                    push out item
                }
            }
            Nothing { }
            Str s { }
            Bool b { }
            Num n { }
            Map m { }
        }
        return out
    }

    ; `item[field]`, as JSON text, or "" when there is no such field.
    sfn fieldJson:string (item:ScVal field:string) {
        match item {
            Map m {
                for m.keys key:string i {
                    if (key == field) {
                        return (ScValOps.toJson((itemAt m.entries i)))
                    }
                }
            }
            Nothing { }
            Str s { }
            Bool b { }
            Num n { }
            List l { }
        }
        return ""
    }

    ; `[...list, item]`. A value that is not a list starts one, which is what
    ; the spread of `undefined ?? []` does on the other side.
    sfn appended:ScVal (list:ScVal item:ScVal) {
        def out:[ScVal]
        match list {
            List l {
                for l.items existing:ScVal i {
                    push out existing
                }
            }
            Nothing { }
            Str s { }
            Bool b { }
            Num n { }
            Map m { }
        }
        push out item
        return (new ScVal.List(out))
    }

    ; JSON text, which is how a value is compared against the library's own.
    ; Numbers print without a trailing `.0` for the same reason the row layer's
    ; do: both sides have to write the same string.
    sfn toJson:string (v:ScVal) {
        match v {
            Nothing { return "null" }
            Str s { return (ScValOps.quote(s.text)) }
            Bool b {
                if (b.flag) {
                    return "true"
                }
                return "false"
            }
            Num n {
                def whole:int (to_int n.value)
                if ((int2double whole) == n.value) {
                    return (to_string whole)
                }
                return (to_string n.value)
            }
            List l {
                def parts:[string]
                for l.items item:ScVal i {
                    push parts (ScValOps.toJson(item))
                }
                return (("[" + (join parts ",")) + "]")
            }
            Map m {
                def parts2:[string]
                for m.keys k:string j {
                    push parts2 (((ScValOps.quote(k)) + ":") + (ScValOps.toJson((itemAt m.entries j))))
                }
                return (("{" + (join parts2 ",")) + "}")
            }
        }
        return "null"
    }

    sfn quote:string (text:string) {
        def out@(mutable):string "\""
        def i@(mutable):int 0
        def len:int (strlen text)
        while (i < len) {
            def code:int (charAt text i)
            if (code == 34) {
                out = (out + "\\\"")
            } {
                if (code == 92) {
                    out = (out + "\\\\")
                } {
                    out = (out + (strfromcode code))
                }
            }
            i = (i + 1)
        }
        return (out + "\"")
    }
}

; =============================================================================
; An event is a TYPE and named fields
; =============================================================================
; XState's events are objects — `{ type: "OPEN", targetDate: "2026-02-09" }` —
; and an assignment reads them by name. An earlier draft of this took a single
; payload string, which worked for one machine and would have been the first
; thing to break on the next: `OPEN` carries a date AND a calendar id, and
; nothing distinguishes them when they are both "the value".
class ScEvent {
    def type@(mutable):string ""
    def keys:[string]
    def values:[ScVal]

    Constructor () {
    }

    sfn of:ScEvent (type:string) {
        def e (new ScEvent)
        e.type = type
        return e
    }

    fn with:ScEvent (key:string value:ScVal) {
        push keys key
        push values value
        return this
    }

    ; The common case, and the one a host writing a click handler wants.
    fn withStr:ScEvent (key:string value:string) {
        return (this.with(key (ScValOps.str(value))))
    }

    fn get:ScVal (key:string) {
        for keys k:string i {
            if (k == key) {
                return (itemAt values i)
            }
        }
        return (ScValOps.nothing())
    }
}

; =============================================================================
; A value expression — where an assignment's new value comes from
; =============================================================================
;   "literal"   the value, as written
;   "event"     a named field of the event
;   "context"   a context key
;   "or"        the first of its parts that carries anything
;   "setKey"    a map with one key set — `{ ...map, [key]: value }`, which is
;               how every day-keyed assignment in `planDialogMachine` is written
;
; `or` is what `||` is and `setKey` is what a spread with one overwrite is:
; naming the general form rather than the machine that needed it first is the
; difference between a runtime and a fixture.
class ScValue {
    def kind@(mutable):string "literal"
    def name@(mutable):string ""
    def constant@(optional):ScVal
    def parts:[ScValue]

    Constructor () {
    }

    sfn value:ScValue (v:ScVal) {
        def out (new ScValue)
        out.kind = "literal"
        out.constant = v
        return out
    }

    sfn literal:ScValue (text:string) {
        return (ScValue.value((ScValOps.str(text))))
    }

    sfn event:ScValue (field:string) {
        def v (new ScValue)
        v.kind = "event"
        v.name = field
        return v
    }

    sfn context:ScValue (key:string) {
        def v (new ScValue)
        v.kind = "context"
        v.name = key
        return v
    }

    sfn either:ScValue () {
        def v (new ScValue)
        v.kind = "or"
        return v
    }

    ; parts: the list, then the item. `[...items, x]` written down instead of
    ; run — the list counterpart of `setKey`, and the reason a cart does not
    ; need the host.
    sfn append:ScValue (list:ScValue item:ScValue) {
        def v (new ScValue)
        v.kind = "append"
        push v.parts list
        push v.parts item
        return v
    }

    ; parts: the map, the key, the value — in that order.
    sfn setKey:ScValue (target:ScValue key:ScValue value:ScValue) {
        def v (new ScValue)
        v.kind = "setKey"
        push v.parts target
        push v.parts key
        push v.parts value
        return v
    }
}

; =============================================================================
; A guard — a predicate over the context
; =============================================================================
; `chatMachine` names its guards and provides them as functions. They cannot
; come across as functions, and they cannot be evaluated by the host either:
; `always` runs INSIDE a transition, after its assignments, so a guard answered
; before the send would be answering about the context that was.
;
; So they are predicates, in the forms those guards are made of:
;
;   present   the value carries something          `image !== null`
;   nonBlank  a string with more than whitespace   `inputText.trim().length > 0`
;   countEq   how many items a list has, compared  `=== 1`
;   countGt   the same, greater than               `> 1`
;   some      any item whose field equals a value  `.some(a => a.x === "y")`
;   or and not                                     the obvious
;
; `present` and `nonBlank` are separate because they are different questions:
; `present` on a string is "has characters", and `hasContent` in the original
; says `trim().length > 0`, which would have sent an empty message on a space.
;
; A guard also carries the NAME the original gives it. The predicate says what
; the guard does; the name says which guard it is, and only the second can be
; compared against a TypeScript function — which is what `rt:machine:config`
; does.
class ScGuard {
    def kind@(mutable):string "true"
    def name@(mutable):string ""
    def field@(mutable):string ""
    def number@(mutable):double 0.0
    def operand@(optional):ScVal
    def parts:[ScGuard]
    def source@(optional):ScValue

    Constructor () {
    }
}

class ScAssign {
    def key@(mutable):string ""
    def value@(optional):ScValue

    Constructor () {
    }

    sfn of:ScAssign (key:string value:ScValue) {
        def a (new ScAssign)
        a.key = key
        a.value = value
        return a
    }
}

class ScTransition {
    def event@(mutable):string ""
    def guard@(optional):ScGuard
    ; "" means the transition assigns but does not move — XState's internal
    ; transition, and the reason `SET_INPUT_TEXT` does not re-enter `open`.
    def target@(mutable):string ""
    def assigns:[ScAssign]
    ; Actions the machine NAMES and the host provides — XState's own
    ; `setup({ actions })`. Some assignments are computation and not data:
    ; `planDialogMachine` reduces fetched entries to a day map by asking each
    ; entry's date what weekday it is, and a calendar is not something a
    ; declarative value expression should grow.
    def actions:[string]

    Constructor () {
    }
}

class ScState {
    def name@(mutable):string ""
    ; The full path from the machine root: "reviewing.multiAction". A state is
    ; addressed by where it IS, not by its name, because two parents may both
    ; have a child called `done`.
    def path@(mutable):string ""
    def parent@(mutable):string ""
    def initial@(mutable):string ""
    def isFinal@(mutable):boolean false
    def transitions:[ScTransition]
    ; Eventless transitions, taken as soon as the machine settles here. XState
    ; calls them `always`, and they are what makes a state a decision rather
    ; than a place.
    def always:[ScTransition]
    def onDone@(optional):ScTransition

    Constructor () {
    }

    fn on:ScTransition (event:string target:string) {
        def t (new ScTransition)
        t.event = event
        t.target = target
        push transitions t
        return t
    }
}

class Statechart {
    def id@(mutable):string ""
    def initial@(mutable):string ""
    def states:[ScState]
    ; Transitions on the machine itself, available from every state. XState
    ; puts them in a top-level `on`, and `chatMachine`'s RESET is one.
    def transitions:[ScTransition]
    ; The initial context, as parallel key/value lists. A map would read
    ; better and travels worse: two arrays are the same thing on every target.
    def keys:[string]
    def values:[ScVal]

    Constructor () {
    }

    ; Every state, by full path. A tree read as a list: the runner asks for
    ; "reviewing.multiAction" and its ancestors by name, and a list answers
    ; both without a walk.
    fn state:ScState (name:string) {
        return (this.child("" name))
    }

    fn child:ScState (parentPath:string name:string) {
        def s (new ScState)
        s.name = name
        s.parent = parentPath
        if ((strlen parentPath) > 0) {
            s.path = ((parentPath + ".") + name)
        } {
            s.path = name
        }
        push states s
        return s
    }

    fn stateAt:ScState (path:string) {
        for states s:ScState i {
            if (s.path == path) {
                return s
            }
        }
        return (new ScState)
    }

    fn hasState:boolean (path:string) {
        for states s:ScState i {
            if (s.path == path) {
                return true
            }
        }
        return false
    }

    fn context:void (key:string value:ScVal) {
        push keys key
        push values value
    }

    fn contextStr:void (key:string value:string) {
        this.context(key (ScValOps.str(value)))
    }

    fn stateNamed:ScState (name:string) {
        return (this.stateAt(name))
    }

    ; Where entering `path` actually LANDS: its initial child, and on down
    ; until a leaf. The runner needs it to move and the visualizer needs it to
    ; point an arrow, so it belongs to the chart rather than to either.
    fn entryLeaf:string (path:string) {
        def here@(mutable):string path
        def depth@(mutable):int 0
        while (depth < 32) {
            def s:ScState (this.stateAt(here))
            if ((strlen s.initial) == 0) {
                break
            }
            here = ((here + ".") + s.initial)
            depth = (depth + 1)
        }
        return here
    }
}

; =============================================================================
; ScRunner — one machine, running
; =============================================================================
class ScRunner {
    def chart@(optional):Statechart
    ; The ACTIVE LEAF, as a full path: "reviewing.multiAction". A compound
    ; state is never the answer on its own — entering one means entering its
    ; initial child, and on down.
    def state@(mutable):string ""
    def keys:[string]
    def values:[ScVal]
    def pending:[string]

    Constructor () {
    }

    fn start:void (definition:Statechart) {
        chart = definition
        clear keys
        clear values
        for definition.keys k:string i {
            push keys k
            push values (itemAt definition.values i)
        }
        clear pending
        this.enter(definition.initial)
        this.settle()
    }

    ; --- the context ---------------------------------------------------------

    fn get:ScVal (key:string) {
        for keys k:string i {
            if (k == key) {
                return (itemAt values i)
            }
        }
        return (ScValOps.nothing())
    }

    fn json:string (key:string) {
        return (ScValOps.toJson((this.get(key))))
    }

    fn set:void (key:string value:ScVal) {
        for keys k:string i {
            if (k == key) {
                set values i value
                return
            }
        }
        push keys key
        push values value
    }

    fn setStr:void (key:string value:string) {
        this.set(key (ScValOps.str(value)))
    }

    ; --- paths ---------------------------------------------------------------

    sfn parentOf:string (path:string) {
        def at@(mutable):int -1
        def i@(mutable):int 0
        def len:int (strlen path)
        while (i < len) {
            if ((charAt path i) == 46) {
                at = i
            }
            i = (i + 1)
        }
        if (at < 0) {
            return ""
        }
        return (substring path 0 at)
    }

    ; A transition's target, read from where the transition LIVES.
    ;   "#chat.reviewing"  absolute, the machine id stripped
    ;   ".idle"            a child of the state that owns the transition
    ;   "multiAction"      a sibling of it
    sfn resolveTarget:string (target:string ownerPath:string) {
        if ((strlen target) == 0) {
            return ""
        }
        if ((charAt target 0) == 35) {
            def rest:string (substring target 1 (strlen target))
            def dot@(mutable):int -1
            def i@(mutable):int 0
            def len:int (strlen rest)
            while (i < len) {
                if ((charAt rest i) == 46) {
                    if (dot < 0) {
                        dot = i
                    }
                }
                i = (i + 1)
            }
            if (dot < 0) {
                return ""
            }
            return (substring rest (dot + 1) len)
        }
        if ((charAt target 0) == 46) {
            def child:string (substring target 1 (strlen target))
            if ((strlen ownerPath) == 0) {
                return child
            }
            return ((ownerPath + ".") + child)
        }
        def parent:string (ScRunner.parentOf(ownerPath))
        if ((strlen parent) == 0) {
            return target
        }
        return ((parent + ".") + target)
    }

    ; --- guards --------------------------------------------------------------

    fn countOf:int (v:ScVal) {
        return (ScValOps.sizeOf(v))
    }

    fn valueOfGuard:ScVal (g:ScGuard event:ScEvent) {
        if (null? g.source) {
            return (ScValOps.nothing())
        }
        return (this.resolve((unwrap g.source) event))
    }

    fn passes:boolean (g:ScGuard event:ScEvent) {
        if (g.kind == "true") {
            return true
        }
        if (g.kind == "present") {
            return (ScValOps.present((this.valueOfGuard(g event))))
        }
        ; `present` on a string is "has characters"; `nonBlank` is
        ; "has characters that are not whitespace", which is what
        ; `inputText.trim().length > 0` says and is not the same question.
        if (g.kind == "nonBlank") {
            def v:ScVal (this.valueOfGuard(g event))
            match v {
                Str st { return ((strlen (trim st.text)) > 0) }
                ; Blankness is a question about TEXT. Anything else is asked
                ; the only question that means anything for it: is it there.
                Nothing { return false }
                Bool b { return (ScValOps.present(v)) }
                Num n { return (ScValOps.present(v)) }
                List l { return (ScValOps.present(v)) }
                Map m { return (ScValOps.present(v)) }
            }
            return false
        }
        if (g.kind == "not") {
            return ((this.passes((itemAt g.parts 0) event)) == false)
        }
        if (g.kind == "or") {
            for g.parts part:ScGuard i {
                if (this.passes(part event)) {
                    return true
                }
            }
            return false
        }
        if (g.kind == "and") {
            for g.parts part2:ScGuard j {
                if ((this.passes(part2 event)) == false) {
                    return false
                }
            }
            return true
        }
        if (g.kind == "countEq") {
            return ((int2double (this.countOf((this.valueOfGuard(g event))))) == g.number)
        }
        if (g.kind == "countGt") {
            return ((int2double (this.countOf((this.valueOfGuard(g event))))) > g.number)
        }
        ; `some(list, field == value)`.
        if (g.kind == "some") {
            def list:[ScVal] (ScValOps.items((this.valueOfGuard(g event))))
            def wanted:string (ScValOps.toJson((unwrap g.operand)))
            for list item:ScVal k {
                if ((ScValOps.fieldJson(item g.field)) == wanted) {
                    return true
                }
            }
            return false
        }
        return false
    }

    fn allowed:boolean (t:ScTransition event:ScEvent) {
        if (null? t.guard) {
            return true
        }
        return (this.passes((unwrap t.guard) event))
    }

    ; --- values --------------------------------------------------------------

    fn resolve:ScVal (value:ScValue event:ScEvent) {
        if (value.kind == "literal") {
            return (unwrap value.constant)
        }
        if (value.kind == "event") {
            return (event.get(value.name))
        }
        if (value.kind == "context") {
            return (this.get(value.name))
        }
        if (value.kind == "or") {
            def last@(mutable):ScVal (ScValOps.nothing())
            for value.parts part:ScValue i {
                def answer:ScVal (this.resolve(part event))
                if (ScValOps.present(answer)) {
                    return answer
                }
                last = answer
            }
            ; `a || b` yields its LAST operand when everything is falsy, not
            ; nothing — `undefined || false` is `false`. Found by the live
            ; comparison against the library rather than by reading.
            return last
        }
        if (value.kind == "append") {
            def list:ScVal (this.resolve((itemAt value.parts 0) event))
            def item:ScVal (this.resolve((itemAt value.parts 1) event))
            return (ScValOps.appended(list item))
        }
        if (value.kind == "setKey") {
            def target:ScVal (this.resolve((itemAt value.parts 0) event))
            def key:ScVal (this.resolve((itemAt value.parts 1) event))
            def item:ScVal (this.resolve((itemAt value.parts 2) event))
            def keyText@(mutable):string (ScValOps.toJson(key))
            match key {
                Str st { keyText = st.text }
                Nothing { }
                Bool b { }
                Num n { }
                List l { }
                Map m { }
            }
            return (ScValOps.withKey(target keyText item))
        }
        return (ScValOps.nothing())
    }

    ; --- moving --------------------------------------------------------------

    ; Entering a state means entering its initial child, and on down until a
    ; leaf. Settling is deliberately NOT part of it — see `settle`.
    fn enter:void (path:string) {
        def c:Statechart (unwrap chart)
        state = (c.entryLeaf(path))
    }

    fn take:void (t:ScTransition ownerPath:string event:ScEvent) {
        for t.assigns a:ScAssign j {
            def v:ScValue (unwrap a.value)
            this.set(a.key (this.resolve(v event)))
        }
        for t.actions name:string k {
            push pending name
        }
        def target:string (ScRunner.resolveTarget(t.target ownerPath))
        if ((strlen target) > 0) {
            this.enter(target)
        }
    }

    ; `always` and `onDone`, to a fixed point. The bound is a guard against a
    ; machine that transitions to itself for ever; XState reports that as an
    ; error and this stops rather than hanging.
    ;
    ; It STOPS while named actions are owed. `always` guards read the context —
    ; `deciding` asks how many pending actions there are — and a named action
    ; is what put them there, so settling before the host has run one would ask
    ; the guard about a context that is a step behind. The host runs what
    ; `pending` names and calls `resume`, which is the same loop again.
    fn settle:void () {
        def c:Statechart (unwrap chart)
        def steps@(mutable):int 0
        while (steps < 64) {
            steps = (steps + 1)
            if ((array_length pending) > 0) {
                return
            }
            def moved@(mutable):boolean false
            def empty (ScEvent.of(""))
            ; Innermost first: the active leaf, then each ancestor.
            def here@(mutable):string state
            while ((strlen here) > 0) {
                def s:ScState (c.stateAt(here))
                for s.always t:ScTransition i {
                    if (moved == false) {
                        if (this.allowed(t empty)) {
                            this.take(t here empty)
                            moved = true
                        }
                    }
                }
                if (moved) {
                    here = ""
                } {
                    here = (ScRunner.parentOf(here))
                }
            }
            if (moved == false) {
                ; A final child is done, and its parent says what that means.
                def leaf:ScState (c.stateAt(state))
                if (leaf.isFinal) {
                    def parentPath:string (ScRunner.parentOf(state))
                    if ((strlen parentPath) > 0) {
                        def parent:ScState (c.stateAt(parentPath))
                        if (!null? parent.onDone) {
                            this.take((unwrap parent.onDone) parentPath empty)
                            moved = true
                        }
                    }
                }
            }
            if (moved == false) {
                return
            }
        }
    }

    ; The host has run what `pending` named; carry on settling.
    fn resume:void () {
        clear pending
        this.settle()
    }

    ; `true` when the machine HANDLED the event: the active state or one of its
    ; ancestors had a transition for it whose guard passed. Anything else
    ; answers `false` and changes nothing.
    ;
    ; Those are most of any machine's behaviour and the half a hand-port gets
    ; wrong: a state crossed with every event is mostly cells that do nothing,
    ; and doing nothing correctly is a requirement rather than an absence.
    fn send:boolean (event:ScEvent) {
        def c:Statechart (unwrap chart)
        clear pending
        ; Innermost first — a child's transition wins over its parent's.
        def here@(mutable):string state
        while ((strlen here) > 0) {
            def s:ScState (c.stateAt(here))
            for s.transitions t:ScTransition i {
                if (t.event == event.type) {
                    if (this.allowed(t event)) {
                        this.take(t here event)
                        this.settle()
                        return true
                    }
                }
            }
            here = (ScRunner.parentOf(here))
        }
        ; And the machine's own, available from anywhere.
        for c.transitions t2:ScTransition j {
            if (t2.event == event.type) {
                if (this.allowed(t2 event)) {
                    this.take(t2 "" event)
                    this.settle()
                    return true
                }
            }
        }
        return false
    }

    fn sendType:boolean (type:string) {
        return (this.send((ScEvent.of(type))))
    }
}

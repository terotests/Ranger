; =============================================================================
; Statechart — a machine as DATA, and the runner that walks it
; =============================================================================
; Not a clone of XState. XState is MIT (Copyright (c) 2015 David Khourshid) so
; a clone would be allowed; it is the wrong thing to build. A clone means API
; compatibility with actors, spawning, the actor system and inspection — none
; of which the machines being ported use — and it would be judged against
; XState's whole semantics rather than against the app's behaviour, which is
; the only thing that matters here.
;
; What earns its keep is the OTHER half: with the machine as data, a port stops
; being hand-written code per machine and becomes one runner plus a definition.
; And the definition compiles to Kotlin and Swift like everything else here,
; which a JavaScript library never would.
;
; The surface is the subset three real machines use, measured rather than
; guessed (`grep` over their sources):
;
;   addWorkoutDialogMachine   states · on · assign
;   planDialogMachine         + entry actions
;   chatMachine               + guards · always · after · invoke · nested states
;
; This is the first tier: states, transitions, and assignments to a string
; context. Guards, entry actions and nesting arrive when the machine that needs
; them does — and each arrives with the transition table that proves it.
;
; Conformance is not this module's own opinion: `gallery/realtrainer` runs the
; table transcribed from the XState source through both this runner and a
; hand-written port, and requires the same answer in all twenty-one cells.
; =============================================================================

; =============================================================================
; An event is a TYPE and named fields
; =============================================================================
; XState's events are objects — `{ type: "OPEN", targetDate: "2026-02-09" }` —
; and an assignment reads them by name. An earlier draft of this took a single
; payload string, which worked for one machine and would have been the first
; thing to break on the next: `OPEN` carries a date AND a calendar id, and
; nothing distinguishes them when they are both "the value".
class ScEvent {
    def type@(mutable):string ""
    def keys:[string]
    def values:[string]

    Constructor () {
    }

    sfn of:ScEvent (type:string) {
        def e (new ScEvent)
        e.type = type
        return e
    }

    fn with:ScEvent (key:string value:string) {
        push keys key
        push values value
        return this
    }

    fn get:string (key:string) {
        for keys k:string i {
            if (k == key) {
                return (itemAt values i)
            }
        }
        return ""
    }

    fn has:boolean (key:string) {
        for keys k:string i {
            if (k == key) {
                return ((strlen (itemAt values i)) > 0)
            }
        }
        return false
    }
}

; =============================================================================
; A value expression — where an assignment's new value comes from
; =============================================================================
;   "literal"   the literal, as written
;   "event"     a named field of the event
;   "context"   a context key
;   "or"        the first of its parts that has anything in it
;
; `or` is not a special case for one machine. It is what `a || b` is, and
; assignments in these machines are made of exactly this: a field, a key, a
; constant, and a fallback between them. Naming the general form rather than
; the instance is the difference between a runtime and a fixture.
class ScValue {
    def kind@(mutable):string "literal"
    def name@(mutable):string ""
    def parts:[ScValue]

    Constructor () {
    }

    sfn literal:ScValue (text:string) {
        def v (new ScValue)
        v.kind = "literal"
        v.name = text
        return v
    }

    sfn event:ScValue (field:string) {
        def v (new ScValue)
        v.kind = "event"
        v.name = field
        return v
    }

    sfn context:ScValue (key:string) {
        def v (new ScValue)
        v.kind = "context"
        v.name = key
        return v
    }

    sfn either:ScValue () {
        def v (new ScValue)
        v.kind = "or"
        return v
    }
}

class ScAssign {
    def key@(mutable):string ""
    def value@(optional):ScValue

    Constructor () {
    }

    sfn of:ScAssign (key:string value:ScValue) {
        def a (new ScAssign)
        a.key = key
        a.value = value
        return a
    }
}

class ScTransition {
    def event@(mutable):string ""
    ; "" means the transition assigns but does not move — XState's internal
    ; transition, and the reason `SET_INPUT_TEXT` does not re-enter `open`.
    def target@(mutable):string ""
    def assigns:[ScAssign]

    Constructor () {
    }
}

class ScState {
    def name@(mutable):string ""
    def transitions:[ScTransition]

    Constructor () {
    }

    fn on:ScTransition (event:string target:string) {
        def t (new ScTransition)
        t.event = event
        t.target = target
        push transitions t
        return t
    }
}

class Statechart {
    def id@(mutable):string ""
    def initial@(mutable):string ""
    def states:[ScState]
    ; The initial context, as parallel key/value lists. A map would read
    ; better and travels worse: two arrays are the same thing on every target.
    def keys:[string]
    def values:[string]

    Constructor () {
    }

    fn state:ScState (name:string) {
        def s (new ScState)
        s.name = name
        push states s
        return s
    }

    fn context:void (key:string value:string) {
        push keys key
        push values value
    }

    fn stateNamed:ScState (name:string) {
        for states s:ScState i {
            if (s.name == name) {
                return s
            }
        }
        return (new ScState)
    }
}

; =============================================================================
; ScRunner — one machine, running
; =============================================================================
class ScRunner {
    def chart@(optional):Statechart
    def state@(mutable):string ""
    def keys:[string]
    def values:[string]

    Constructor () {
    }

    fn start:void (definition:Statechart) {
        chart = definition
        state = definition.initial
        clear keys
        clear values
        for definition.keys k:string i {
            push keys k
            push values (itemAt definition.values i)
        }
    }

    fn get:string (key:string) {
        for keys k:string i {
            if (k == key) {
                return (itemAt values i)
            }
        }
        return ""
    }

    fn set:void (key:string value:string) {
        for keys k:string i {
            if (k == key) {
                set values i value
                return
            }
        }
        push keys key
        push values value
    }

    ; The chart's own initial value for a key — what a reset assigns.
    fn initialOf:string (key:string) {
        def c:Statechart (unwrap chart)
        for c.keys k:string i {
            if (k == key) {
                return (itemAt c.values i)
            }
        }
        return ""
    }

    ; A value expression, resolved against this context and this event.
    fn resolve:string (value:ScValue event:ScEvent) {
        if (value.kind == "literal") {
            return value.name
        }
        if (value.kind == "event") {
            return (event.get(value.name))
        }
        if (value.kind == "context") {
            return (this.get(value.name))
        }
        if (value.kind == "or") {
            for value.parts part:ScValue i {
                def answer:string (this.resolve(part event))
                if ((strlen answer) > 0) {
                    return answer
                }
            }
            return ""
        }
        return ""
    }

    ; `true` when the event moved the machine or changed the context. An event
    ; the current state does not handle answers `false` and changes nothing.
    ;
    ; Those are most of any machine's behaviour and the half a hand-port gets
    ; wrong: a state crossed with every event is mostly cells that do nothing,
    ; and doing nothing correctly is a requirement rather than an absence.
    fn send:boolean (event:ScEvent) {
        def c:Statechart (unwrap chart)
        def here:ScState (c.stateNamed(state))
        for here.transitions t:ScTransition i {
            if (t.event == event.type) {
                for t.assigns a:ScAssign j {
                    def v:ScValue (unwrap a.value)
                    this.set(a.key (this.resolve(v event)))
                }
                if ((strlen t.target) > 0) {
                    state = t.target
                }
                return true
            }
        }
        return false
    }

    ; An event with no fields, which most of them are.
    fn sendType:boolean (type:string) {
        return (this.send((ScEvent.of(type))))
    }
}

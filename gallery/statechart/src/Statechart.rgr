; =============================================================================
; Statechart — a machine as DATA, and the runner that walks it
; =============================================================================
; Not a clone of XState. XState is MIT (Copyright (c) 2015 David Khourshid) so
; a clone would be allowed; it is the wrong thing to build. A clone means API
; compatibility with actors, spawning, the actor system and inspection — none
; of which the machines being ported use — and it would be judged against
; XState's whole semantics rather than against the app's behaviour, which is
; the only thing that matters here.
;
; What earns its keep is the OTHER half: with the machine as data, a port stops
; being hand-written code per machine and becomes one runner plus a definition.
; And the definition compiles to Kotlin and Swift like everything else here,
; which a JavaScript library never would.
;
; The surface is the subset three real machines use, measured rather than
; guessed (`grep` over their sources):
;
;   addWorkoutDialogMachine   states · on · assign
;   planDialogMachine         + entry actions
;   chatMachine               + guards · always · after · invoke · nested states
;
; This is the first tier: states, transitions, and assignments to a string
; context. Guards, entry actions and nesting arrive when the machine that needs
; them does — and each arrives with the transition table that proves it.
;
; Conformance is not this module's own opinion: `gallery/realtrainer` runs the
; table transcribed from the XState source through both this runner and a
; hand-written port, and requires the same answer in all twenty-one cells.
; =============================================================================

; =============================================================================
; A context value
; =============================================================================
; The first machine ported here had a context of four strings, so the context
; was four strings. The second one — `planDialogMachine` — has a list of day
; indices, three maps keyed by day, a boolean and a list of fetched entries,
; and that is where "everything is a string" stops being a simplification and
; becomes a lie.
;
; A closed family instead. `match` over it is checked for exhaustiveness, so a
; kind added later cannot be silently unhandled in the runner, the JSON bridge
; or a comparison.
shape ScVal {
    case Nothing
    case Str  { def text:string "" }
    case Bool { def flag:boolean false }
    case Num  { def value:double 0.0 }
    case List { def items:[ScVal] }
    ; Keys are strings even when the machine keys by day number, which is what
    ; JSON does with an object anyway.
    case Map  {
        def keys:[string]
        def entries:[ScVal]
    }
}

class ScValOps {

    Constructor () {
    }

    sfn str:ScVal (text:string) {
        return (new ScVal.Str(text))
    }

    sfn bool:ScVal (flag:boolean) {
        return (new ScVal.Bool(flag))
    }

    sfn num:ScVal (value:double) {
        return (new ScVal.Num(value))
    }

    sfn nothing:ScVal () {
        return (new ScVal.Nothing)
    }

    sfn emptyList:ScVal () {
        def items:[ScVal]
        return (new ScVal.List(items))
    }

    sfn emptyMap:ScVal () {
        def keys:[string]
        def entries:[ScVal]
        return (new ScVal.Map(keys entries))
    }

    ; A value carries something. `or` asks this, and it is the one place where
    ; the answer differs from JavaScript on purpose: an empty string, an empty
    ; list and an empty map are all falsy here, as `||` would treat "" — and a
    ; `false` is falsy, as it is there.
    sfn present:boolean (v:ScVal) {
        match v {
            Nothing { return false }
            Str s { return ((strlen s.text) > 0) }
            Bool b { return b.flag }
            Num n { return true }
            List l { return ((array_length l.items) > 0) }
            Map m { return ((array_length m.keys) > 0) }
        }
        return false
    }

    ; A map with one key set. The original spreads and overwrites:
    ; `{ ...context.keepSameByDay, [event.day]: event.keep }`.
    sfn withKey:ScVal (target:ScVal key:string value:ScVal) {
        def keys:[string]
        def entries:[ScVal]
        match target {
            Map m {
                for m.keys k:string i {
                    push keys k
                    push entries (itemAt m.entries i)
                }
            }
            Nothing { }
            Str s { }
            Bool b { }
            Num n { }
            List l { }
        }
        def at@(mutable):int -1
        for keys k2:string j {
            if (k2 == key) {
                at = j
            }
        }
        if (at >= 0) {
            set entries at value
        } {
            push keys key
            push entries value
        }
        return (new ScVal.Map(keys entries))
    }

    ; JSON text, which is how a value is compared against the library's own.
    ; Numbers print without a trailing `.0` for the same reason the row layer's
    ; do: both sides have to write the same string.
    sfn toJson:string (v:ScVal) {
        match v {
            Nothing { return "null" }
            Str s { return (ScValOps.quote(s.text)) }
            Bool b {
                if (b.flag) {
                    return "true"
                }
                return "false"
            }
            Num n {
                def whole:int (to_int n.value)
                if ((int2double whole) == n.value) {
                    return (to_string whole)
                }
                return (to_string n.value)
            }
            List l {
                def parts:[string]
                for l.items item:ScVal i {
                    push parts (ScValOps.toJson(item))
                }
                return (("[" + (join parts ",")) + "]")
            }
            Map m {
                def parts2:[string]
                for m.keys k:string j {
                    push parts2 (((ScValOps.quote(k)) + ":") + (ScValOps.toJson((itemAt m.entries j))))
                }
                return (("{" + (join parts2 ",")) + "}")
            }
        }
        return "null"
    }

    sfn quote:string (text:string) {
        def out@(mutable):string "\""
        def i@(mutable):int 0
        def len:int (strlen text)
        while (i < len) {
            def code:int (charAt text i)
            if (code == 34) {
                out = (out + "\\\"")
            } {
                if (code == 92) {
                    out = (out + "\\\\")
                } {
                    out = (out + (strfromcode code))
                }
            }
            i = (i + 1)
        }
        return (out + "\"")
    }
}

; =============================================================================
; An event is a TYPE and named fields
; =============================================================================
; XState's events are objects — `{ type: "OPEN", targetDate: "2026-02-09" }` —
; and an assignment reads them by name. An earlier draft of this took a single
; payload string, which worked for one machine and would have been the first
; thing to break on the next: `OPEN` carries a date AND a calendar id, and
; nothing distinguishes them when they are both "the value".
class ScEvent {
    def type@(mutable):string ""
    def keys:[string]
    def values:[ScVal]

    Constructor () {
    }

    sfn of:ScEvent (type:string) {
        def e (new ScEvent)
        e.type = type
        return e
    }

    fn with:ScEvent (key:string value:ScVal) {
        push keys key
        push values value
        return this
    }

    ; The common case, and the one a host writing a click handler wants.
    fn withStr:ScEvent (key:string value:string) {
        return (this.with(key (ScValOps.str(value))))
    }

    fn get:ScVal (key:string) {
        for keys k:string i {
            if (k == key) {
                return (itemAt values i)
            }
        }
        return (ScValOps.nothing())
    }
}

; =============================================================================
; A value expression — where an assignment's new value comes from
; =============================================================================
;   "literal"   the value, as written
;   "event"     a named field of the event
;   "context"   a context key
;   "or"        the first of its parts that carries anything
;   "setKey"    a map with one key set — `{ ...map, [key]: value }`, which is
;               how every day-keyed assignment in `planDialogMachine` is written
;
; `or` is what `||` is and `setKey` is what a spread with one overwrite is:
; naming the general form rather than the machine that needed it first is the
; difference between a runtime and a fixture.
class ScValue {
    def kind@(mutable):string "literal"
    def name@(mutable):string ""
    def constant@(optional):ScVal
    def parts:[ScValue]

    Constructor () {
    }

    sfn value:ScValue (v:ScVal) {
        def out (new ScValue)
        out.kind = "literal"
        out.constant = v
        return out
    }

    sfn literal:ScValue (text:string) {
        return (ScValue.value((ScValOps.str(text))))
    }

    sfn event:ScValue (field:string) {
        def v (new ScValue)
        v.kind = "event"
        v.name = field
        return v
    }

    sfn context:ScValue (key:string) {
        def v (new ScValue)
        v.kind = "context"
        v.name = key
        return v
    }

    sfn either:ScValue () {
        def v (new ScValue)
        v.kind = "or"
        return v
    }

    ; parts: the map, the key, the value — in that order.
    sfn setKey:ScValue (target:ScValue key:ScValue value:ScValue) {
        def v (new ScValue)
        v.kind = "setKey"
        push v.parts target
        push v.parts key
        push v.parts value
        return v
    }
}

class ScAssign {
    def key@(mutable):string ""
    def value@(optional):ScValue

    Constructor () {
    }

    sfn of:ScAssign (key:string value:ScValue) {
        def a (new ScAssign)
        a.key = key
        a.value = value
        return a
    }
}

class ScTransition {
    def event@(mutable):string ""
    ; "" means the transition assigns but does not move — XState's internal
    ; transition, and the reason `SET_INPUT_TEXT` does not re-enter `open`.
    def target@(mutable):string ""
    def assigns:[ScAssign]
    ; Actions the machine NAMES and the host provides — XState's own
    ; `setup({ actions })`. Some assignments are computation and not data:
    ; `planDialogMachine` reduces fetched entries to a day map by asking each
    ; entry's date what weekday it is, and a calendar is not something a
    ; declarative value expression should grow.
    def actions:[string]

    Constructor () {
    }
}

class ScState {
    def name@(mutable):string ""
    def transitions:[ScTransition]

    Constructor () {
    }

    fn on:ScTransition (event:string target:string) {
        def t (new ScTransition)
        t.event = event
        t.target = target
        push transitions t
        return t
    }
}

class Statechart {
    def id@(mutable):string ""
    def initial@(mutable):string ""
    def states:[ScState]
    ; The initial context, as parallel key/value lists. A map would read
    ; better and travels worse: two arrays are the same thing on every target.
    def keys:[string]
    def values:[ScVal]

    Constructor () {
    }

    fn state:ScState (name:string) {
        def s (new ScState)
        s.name = name
        push states s
        return s
    }

    fn context:void (key:string value:ScVal) {
        push keys key
        push values value
    }

    fn contextStr:void (key:string value:string) {
        this.context(key (ScValOps.str(value)))
    }

    fn stateNamed:ScState (name:string) {
        for states s:ScState i {
            if (s.name == name) {
                return s
            }
        }
        return (new ScState)
    }
}

; =============================================================================
; ScRunner — one machine, running
; =============================================================================
class ScRunner {
    def chart@(optional):Statechart
    def state@(mutable):string ""
    def keys:[string]
    def values:[ScVal]
    ; The named actions the last handled event asked for, in order. The host
    ; runs them; the runner only reports that they were asked for.
    def pending:[string]

    Constructor () {
    }

    fn start:void (definition:Statechart) {
        chart = definition
        state = definition.initial
        clear keys
        clear values
        for definition.keys k:string i {
            push keys k
            push values (itemAt definition.values i)
        }
    }

    fn get:ScVal (key:string) {
        for keys k:string i {
            if (k == key) {
                return (itemAt values i)
            }
        }
        return (ScValOps.nothing())
    }

    ; The value as JSON text, which is how it is compared with the library's.
    fn json:string (key:string) {
        return (ScValOps.toJson((this.get(key))))
    }

    fn set:void (key:string value:ScVal) {
        for keys k:string i {
            if (k == key) {
                set values i value
                return
            }
        }
        push keys key
        push values value
    }

    fn setStr:void (key:string value:string) {
        this.set(key (ScValOps.str(value)))
    }

    ; A value expression, resolved against this context and this event.
    fn resolve:ScVal (value:ScValue event:ScEvent) {
        if (value.kind == "literal") {
            return (unwrap value.constant)
        }
        if (value.kind == "event") {
            return (event.get(value.name))
        }
        if (value.kind == "context") {
            return (this.get(value.name))
        }
        if (value.kind == "or") {
            def last@(mutable):ScVal (ScValOps.nothing())
            for value.parts part:ScValue i {
                def answer:ScVal (this.resolve(part event))
                if (ScValOps.present(answer)) {
                    return answer
                }
                last = answer
            }
            ; `a || b` yields its LAST operand when everything is falsy, not
            ; nothing — `undefined || false` is `false`, and the difference
            ; showed up as a context of `null` where the machine holds `false`.
            ; Found by the live comparison against the library rather than by
            ; reading, which is the argument for running one.
            return last
        }
        if (value.kind == "setKey") {
            def target:ScVal (this.resolve((itemAt value.parts 0) event))
            def key:ScVal (this.resolve((itemAt value.parts 1) event))
            def item:ScVal (this.resolve((itemAt value.parts 2) event))
            ; The key is whatever the event carried — a day NUMBER in every
            ; case this exists for — and JSON object keys are strings, which
            ; is what the original ends up with too.
            def keyText:string (ScValOps.toJson(key))
            match key {
                Str st { keyText = st.text }
                Nothing { }
                Bool b { }
                Num n { }
                List l { }
                Map m { }
            }
            return (ScValOps.withKey(target keyText item))
        }
        return (ScValOps.nothing())
    }

    ; `true` when the current state HANDLED the event. An event it does not
    ; handle answers `false` and changes nothing.
    ;
    ; Those are most of any machine's behaviour and the half a hand-port gets
    ; wrong: a state crossed with every event is mostly cells that do nothing,
    ; and doing nothing correctly is a requirement rather than an absence.
    fn send:boolean (event:ScEvent) {
        def c:Statechart (unwrap chart)
        def here:ScState (c.stateNamed(state))
        clear pending
        for here.transitions t:ScTransition i {
            if (t.event == event.type) {
                for t.assigns a:ScAssign j {
                    def v:ScValue (unwrap a.value)
                    this.set(a.key (this.resolve(v event)))
                }
                for t.actions name:string k {
                    push pending name
                }
                if ((strlen t.target) > 0) {
                    state = t.target
                }
                return true
            }
        }
        return false
    }

    ; An event with no fields, which most of them are.
    fn sendType:boolean (type:string) {
        return (this.send((ScEvent.of(type))))
    }
}

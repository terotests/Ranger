; SPDX-License-Identifier: AGPL-3.0-or-later

; The constants a Zstandard decoder cannot derive: the three default FSE
; distributions a block may use instead of sending its own, and the
; baseline / extra-bit tables that turn a decoded code into a length or an
; offset. RFC 8878 §3.1.1.3.2.1.1.

class ZstdTables {
    Constructor () {
    }

    ; Literals_Length_Code, accuracy log 6, symbols 0..35.
    sfn defaultLiteralCounts:[int] () {
        def c:[int]
        push c 4
        push c 3
        def i:int 0
        while (i < 10) {
            push c 2
            i = (i + 1)
        }
        push c 2
        push c 1
        push c 1
        push c 1
        i = 0
        while (i < 9) {
            push c 2
            i = (i + 1)
        }
        push c 3
        push c 2
        i = 0
        while (i < 5) {
            push c 1
            i = (i + 1)
        }
        i = 0
        while (i < 4) {
            push c (0 - 1)
            i = (i + 1)
        }
        return c
    }

    ; Match_Length_Code, accuracy log 6, symbols 0..52.
    sfn defaultMatchCounts:[int] () {
        def c:[int]
        push c 1
        push c 4
        push c 3
        def i:int 0
        while (i < 6) {
            push c 2
            i = (i + 1)
        }
        i = 0
        while (i < 37) {
            push c 1
            i = (i + 1)
        }
        ; Seven low-probability symbols, not five: the sum is 64 either way,
        ; which is why the wrong split builds a table that looks valid and
        ; decodes long matches to the wrong code.
        i = 0
        while (i < 7) {
            push c (0 - 1)
            i = (i + 1)
        }
        return c
    }

    ; Offset_Code, accuracy log 5, symbols 0..28.
    sfn defaultOffsetCounts:[int] () {
        def c:[int]
        def i:int 0
        while (i < 6) {
            push c 1
            i = (i + 1)
        }
        push c 2
        push c 2
        push c 2
        i = 0
        while (i < 15) {
            push c 1
            i = (i + 1)
        }
        i = 0
        while (i < 5) {
            push c (0 - 1)
            i = (i + 1)
        }
        return c
    }

    sfn literalBaselines:[int] () {
        def b:[int]
        def i:int 0
        while (i < 16) {
            push b i
            i = (i + 1)
        }
        push b 16
        push b 18
        push b 20
        push b 22
        push b 24
        push b 28
        push b 32
        push b 40
        push b 48
        push b 64
        push b 128
        push b 256
        push b 512
        push b 1024
        push b 2048
        push b 4096
        push b 8192
        push b 16384
        push b 32768
        push b 65536
        return b
    }

    sfn literalExtraBits:[int] () {
        def e:[int]
        def i:int 0
        while (i < 16) {
            push e 0
            i = (i + 1)
        }
        push e 1
        push e 1
        push e 1
        push e 1
        push e 2
        push e 2
        push e 3
        push e 3
        push e 4
        push e 6
        i = 7
        while (i <= 16) {
            push e i
            i = (i + 1)
        }
        return e
    }

    sfn matchBaselines:[int] () {
        def b:[int]
        def i:int 0
        while (i < 32) {
            push b (i + 3)
            i = (i + 1)
        }
        push b 35
        push b 37
        push b 39
        push b 41
        push b 43
        push b 47
        push b 51
        push b 59
        push b 67
        push b 83
        push b 99
        push b 131
        push b 259
        push b 515
        push b 1027
        push b 2051
        push b 4099
        push b 8195
        push b 16387
        push b 32771
        push b 65539
        return b
    }

    sfn matchExtraBits:[int] () {
        def e:[int]
        def i:int 0
        while (i < 32) {
            push e 0
            i = (i + 1)
        }
        push e 1
        push e 1
        push e 1
        push e 1
        push e 2
        push e 2
        push e 3
        push e 3
        push e 4
        push e 4
        push e 5
        i = 7
        while (i <= 16) {
            push e i
            i = (i + 1)
        }
        return e
    }
}

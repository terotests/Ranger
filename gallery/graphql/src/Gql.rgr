; ==============================================================================
; Gql - the façade: parse, format, inspect.
; ==============================================================================
;
;     def r (Gql.parse("{ currentUser { id name } }"))
;     if (r.okResult()) {
;         def paths (r.fieldPaths())
;         def printed (r.format())
;     }
;
; The string helpers (`Gql.format`, `Gql.typeNames`, …) still exist, but they
; return "" both when the document is empty and when it did not parse. A
; caller that needs the difference starts at `Gql.parse` and reads `error`.
;
; This is Ranger's *language* layer for GraphQL — the northbound API toward
; application data. It is not a host bridge. Pointer events, IME, clipboard
; and the canvas stay on the other side of the runtime.
; ==============================================================================

Import "core/Parser.rgr"
Import "printer/Printer.rgr"
Import "ast/GqlAst.rgr"

class GqlParseResult {
    def document:GqlNode (new GqlNode)
    def error:string ""
    def commentCount:int 0

    Constructor () {
    }

    fn okResult:boolean () {
        if ((strlen error) > 0) {
            return false
        }
        return (document.kind == (GqlKind.document()))
    }

    fn toJson:string () {
        return (document.toJson())
    }

    fn format:string () {
        if ((this.okResult()) == false) {
            return ""
        }
        def pr:GqlPrinter (new GqlPrinter)
        return (pr.printDoc(document))
    }

    fn fieldPaths:string () {
        if ((this.okResult()) == false) {
            return ""
        }
        return (document.fieldPaths())
    }

    fn typeNames:string () {
        if ((this.okResult()) == false) {
            return ""
        }
        def out:string ""
        def i:int 0
        while (i < (array_length document.children)) {
            def ch:GqlNode (itemAt document.children i)
            if (ch.isExtension == false) {
                if (GqlKind.isNamedTypeDef(ch.kind)) {
                    if ((strlen out) > 0) {
                        out = (out + (strfromcode 10))
                    }
                    out = (out + ch.name)
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; Fields of every definition that shares `typeName`, including
    ; `extend type`. The original type comes first, extensions after,
    ; so a later codegen pass sees the whole shape.
    fn typeFields:string (typeName:string) {
        if ((this.okResult()) == false) {
            return ""
        }
        def out:string ""
        def i:int 0
        while (i < (array_length document.children)) {
            def ch:GqlNode (itemAt document.children i)
            if (ch.name == typeName) {
                if (GqlKind.isNamedTypeDef(ch.kind)) {
                    def j:int 0
                    while (j < (array_length ch.children)) {
                        def f:GqlNode (itemAt ch.children j)
                        if ((strlen out) > 0) {
                            out = (out + (strfromcode 10))
                        }
                        if (ch.kind == (GqlKind.enumDef())) {
                            out = (out + f.name)
                        } {
                            if (ch.kind == (GqlKind.unionDef())) {
                                out = (out + f.name)
                            } {
                                out = (out + f.name + ": " + (f.typeText()))
                            }
                        }
                        j = (j + 1)
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    fn opType:string () {
        if ((this.okResult()) == false) {
            return ""
        }
        def op:GqlNode (document.childAt(0))
        if (op.kind != (GqlKind.operation())) {
            return ""
        }
        return op.text
    }
}

class Gql {
    sfn parse:GqlParseResult (src:string) {
        def parser:GqlParser (new GqlParser)
        def result:GqlParseResult (new GqlParseResult)
        result.document = (parser.parse(src))
        result.error = parser.error
        result.commentCount = parser.commentCount
        return result
    }

    sfn parseWith:GqlParseResult (src:string maxDepth:int maxTokens:int) {
        def parser:GqlParser (new GqlParser)
        parser.maxDepth = maxDepth
        parser.maxTokens = maxTokens
        def result:GqlParseResult (new GqlParseResult)
        result.document = (parser.parse(src))
        result.error = parser.error
        result.commentCount = parser.commentCount
        return result
    }

    sfn format:string (src:string) {
        def result:GqlParseResult (Gql.parse(src))
        return (result.format())
    }

    sfn fieldPaths:string (src:string) {
        def result:GqlParseResult (Gql.parse(src))
        return (result.fieldPaths())
    }

    sfn typeNames:string (sdl:string) {
        def result:GqlParseResult (Gql.parse(sdl))
        return (result.typeNames())
    }

    sfn typeFields:string (sdl:string typeName:string) {
        def result:GqlParseResult (Gql.parse(sdl))
        return (result.typeFields(typeName))
    }

    sfn opType:string (src:string) {
        def result:GqlParseResult (Gql.parse(src))
        return (result.opType())
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; GqlParser - tokens in, GqlNode document out.
; ==============================================================================
;
; Recursive descent over the GraphQL language:
;
;     Document           = Definition+
;     Definition         = Operation | Fragment | TypeSystem | TypeExtension
;     Operation          = (query|mutation|subscription) Name? Vars? Dirs? Set
;                        | SelectionSet
;     Selection          = Field | FragmentSpread | InlineFragment
;
; Type-system productions (SDL) live in the same parser. A GraphQL client that
; can only read queries cannot check a query against a schema, and the later
; Ranger codegen step needs both.
;
; The first error wins. A half-built tree is not returned as success.
; ==============================================================================

Import "Token.rgr"
Import "Tokenizer.rgr"
Import "../ast/GqlAst.rgr"

class GqlParser {
    def tokens:[GqlToken]
    def pos:int 0
    def error:string ""
    def commentCount:int 0
    def depth:int 0
    ; Nested lists / selection sets / types. A 50 000-deep `[` chain is not a
    ; document, it is a DoS, and on C++/Rust/Swift it is a segfault.
    ; parseWith may raise maxDepth, but never past depthCeiling: Node dies
    ; around 5000 frames, and native stacks are smaller.
    def maxDepth:int 256
    def maxTokens:int 1000000

    Constructor () {
    }

    sfn defaultDepth:int () {
        return 256
    }

    ; Hard cap. Node survives ~4000 frames and dies at 5000; 2048 leaves
    ; margin on JS and on the C++/Rust/Swift stacks this library targets.
    sfn depthCeiling:int () {
        return 2048
    }

    sfn defaultTokens:int () {
        return 1000000
    }

    fn clampLimits:void () {
        def cap:int (GqlParser.depthCeiling())
        if (maxDepth < 1) {
            maxDepth = 1
        }
        if (maxDepth > cap) {
            maxDepth = cap
        }
        if (maxTokens < 1) {
            maxTokens = 1
        }
    }

    fn descend:boolean () {
        if ((this.ok()) == false) {
            return false
        }
        depth = (depth + 1)
        if (depth > maxDepth) {
            this.fail("document nested too deeply")
            return false
        }
        return true
    }

    fn ascend:void () {
        if (depth > 0) {
            depth = (depth - 1)
        }
    }

    fn peek:GqlToken () {
        if (pos >= (array_length tokens)) {
            return (new GqlToken)
        }
        return (itemAt tokens pos)
    }

    fn peekAhead:GqlToken (offset:int) {
        def i:int (pos + offset)
        if (i >= (array_length tokens)) {
            return (new GqlToken)
        }
        return (itemAt tokens i)
    }

    fn advance:GqlToken () {
        def t:GqlToken (this.peek())
        if (pos < (array_length tokens)) {
            pos = (pos + 1)
        }
        return t
    }

    fn atEnd:boolean () {
        def t:GqlToken (this.peek())
        return (t.kind == (GqlTokenKind.endOfInput()))
    }

    fn atName:boolean (word:string) {
        def t:GqlToken (this.peek())
        return (t.isName(word))
    }

    fn atNameTok:boolean () {
        def t:GqlToken (this.peek())
        return (t.isNameTok())
    }

    fn atPunct:boolean (symbol:string) {
        def t:GqlToken (this.peek())
        return (t.isPunct(symbol))
    }

    fn atString:boolean () {
        def t:GqlToken (this.peek())
        return (t.isStringTok())
    }

    fn takeNameWord:boolean (word:string) {
        if (this.atName(word)) {
            this.advance()
            return true
        }
        return false
    }

    fn takePunct:boolean (symbol:string) {
        if (this.atPunct(symbol)) {
            this.advance()
            return true
        }
        return false
    }

    fn expectPunct:boolean (symbol:string) {
        if (this.takePunct(symbol)) {
            return true
        }
        this.fail(("expected " + symbol))
        return false
    }

    fn expectName:string () {
        if (this.atNameTok()) {
            def t:GqlToken (this.advance())
            return t.text
        }
        this.fail("expected name")
        return ""
    }

    fn fail:void (message:string) {
        if ((strlen error) > 0) {
            return
        }
        def t:GqlToken (this.peek())
        error = (message + " but found " + (t.describe()) + " at " + (to_string t.line) + ":" + (to_string t.col))
    }

    fn ok:boolean () {
        return ((strlen error) == 0)
    }

    fn mark:void (node:GqlNode) {
        def t:GqlToken (this.peek())
        node.line = t.line
        node.col = t.col
    }

    fn parse:GqlNode (src:string) {
        this.clampLimits()
        def tk:GqlTokenizer (new GqlTokenizer)
        tk.maxTokens = maxTokens
        tokens = (tk.tokenize(src))
        commentCount = tk.commentCount
        pos = 0
        error = tk.error
        depth = 0
        def doc:GqlNode (new GqlNode)
        doc.kind = (GqlKind.document())
        if ((strlen error) > 0) {
            return doc
        }
        if (this.atEnd()) {
            this.fail("expected a definition")
            return doc
        }
        while ((this.atEnd()) == false) {
            if ((this.ok()) == false) {
                return doc
            }
            def defn:GqlNode (this.parseDefinition())
            if ((this.ok()) == false) {
                return doc
            }
            if (defn.kind == 0) {
                this.fail("expected a definition")
                return doc
            }
            push doc.children defn
        }
        return doc
    }

    fn parseDefinition:GqlNode () {
        def desc:string ""
        if (this.atString()) {
            def st:GqlToken (this.advance())
            desc = st.text
        }
        if (this.atPunct("{")) {
            if ((strlen desc) > 0) {
                this.fail("a description cannot precede an anonymous operation")
                return (new GqlNode)
            }
            return (this.parseAnonymousOperation())
        }
        if (this.atName("query")) {
            if ((strlen desc) > 0) {
                this.fail("a description cannot precede an operation")
                return (new GqlNode)
            }
            return (this.parseOperation())
        }
        if (this.atName("mutation")) {
            if ((strlen desc) > 0) {
                this.fail("a description cannot precede an operation")
                return (new GqlNode)
            }
            return (this.parseOperation())
        }
        if (this.atName("subscription")) {
            if ((strlen desc) > 0) {
                this.fail("a description cannot precede an operation")
                return (new GqlNode)
            }
            return (this.parseOperation())
        }
        if (this.atName("fragment")) {
            if ((strlen desc) > 0) {
                this.fail("a description cannot precede a fragment")
                return (new GqlNode)
            }
            return (this.parseFragmentDef())
        }
        if (this.atName("extend")) {
            if ((strlen desc) > 0) {
                this.fail("a description cannot precede an extension")
                return (new GqlNode)
            }
            return (this.parseExtension(""))
        }
        if (this.atName("schema")) {
            return (this.parseSchema(desc false))
        }
        if (this.atName("scalar")) {
            return (this.parseScalar(desc false))
        }
        if (this.atName("type")) {
            return (this.parseObjectType(desc false))
        }
        if (this.atName("interface")) {
            return (this.parseInterface(desc false))
        }
        if (this.atName("union")) {
            return (this.parseUnion(desc false))
        }
        if (this.atName("enum")) {
            return (this.parseEnum(desc false))
        }
        if (this.atName("input")) {
            return (this.parseInput(desc false))
        }
        if (this.atName("directive")) {
            return (this.parseDirectiveDef(desc))
        }
        if ((strlen desc) > 0) {
            this.fail("expected a type-system definition after the description")
            return (new GqlNode)
        }
        this.fail("expected a definition")
        return (new GqlNode)
    }

    fn parseAnonymousOperation:GqlNode () {
        def op:GqlNode (new GqlNode)
        op.kind = (GqlKind.operation())
        op.text = "query"
        this.mark(op)
        this.parseSelectionSetInto(op)
        return op
    }

    fn parseOperation:GqlNode () {
        def op:GqlNode (new GqlNode)
        op.kind = (GqlKind.operation())
        this.mark(op)
        def kw:GqlToken (this.advance())
        op.text = kw.text
        if (this.atNameTok()) {
            op.name = (this.expectName())
        }
        if (this.atPunct("(")) {
            this.parseVariableDefs(op)
        }
        this.parseDirectives(op false)
        this.parseSelectionSetInto(op)
        return op
    }

    fn parseVariableDefs:void (op:GqlNode) {
        if ((this.expectPunct("(")) == false) {
            return
        }
        if (this.atPunct(")")) {
            this.fail("expected a variable definition")
            return
        }
        while ((this.atPunct(")")) == false) {
            if ((this.ok()) == false) {
                return
            }
            if (this.atEnd()) {
                this.fail("unterminated variable definitions")
                return
            }
            def v:GqlNode (this.parseVariableDef())
            push op.vars v
        }
        this.expectPunct(")")
    }

    fn parseVariableDef:GqlNode () {
        def v:GqlNode (new GqlNode)
        v.kind = (GqlKind.variableDef())
        this.mark(v)
        if ((this.expectPunct("$")) == false) {
            return v
        }
        v.name = (this.expectName())
        if ((this.expectPunct(":")) == false) {
            return v
        }
        def t:GqlNode (this.parseType())
        push v.children t
        if (this.atPunct("=")) {
            this.advance()
            def d:GqlNode (this.parseValue(true))
            push v.children d
        }
        this.parseDirectives(v true)
        return v
    }

    fn parseSelectionSetInto:void (owner:GqlNode) {
        if ((this.descend()) == false) {
            return
        }
        if ((this.expectPunct("{")) == false) {
            this.ascend()
            return
        }
        if (this.atPunct("}")) {
            this.fail("expected a selection")
            this.ascend()
            return
        }
        while ((this.atPunct("}")) == false) {
            if ((this.ok()) == false) {
                this.ascend()
                return
            }
            if (this.atEnd()) {
                this.fail("unterminated selection set")
                this.ascend()
                return
            }
            def sel:GqlNode (this.parseSelection())
            push owner.children sel
        }
        this.expectPunct("}")
        this.ascend()
    }

    fn parseSelection:GqlNode () {
        if (this.atPunct("...")) {
            return (this.parseSpread())
        }
        return (this.parseField())
    }

    fn parseField:GqlNode () {
        def f:GqlNode (new GqlNode)
        f.kind = (GqlKind.fieldSel())
        this.mark(f)
        def first:string (this.expectName())
        if (this.atPunct(":")) {
            this.advance()
            f.alias = first
            f.name = (this.expectName())
        } {
            f.name = first
        }
        if (this.atPunct("(")) {
            this.parseArguments(f false)
        }
        this.parseDirectives(f false)
        if (this.atPunct("{")) {
            this.parseSelectionSetInto(f)
        }
        return f
    }

    fn parseSpread:GqlNode () {
        this.expectPunct("...")
        if (this.atName("on")) {
            return (this.parseInlineFragment())
        }
        if (this.atPunct("{")) {
            return (this.parseInlineFragment())
        }
        if (this.atPunct("@")) {
            return (this.parseInlineFragment())
        }
        def sp:GqlNode (new GqlNode)
        sp.kind = (GqlKind.fragmentSpread())
        this.mark(sp)
        sp.name = (this.expectName())
        this.parseDirectives(sp false)
        return sp
    }

    fn parseInlineFragment:GqlNode () {
        def n:GqlNode (new GqlNode)
        n.kind = (GqlKind.inlineFragment())
        this.mark(n)
        if (this.takeNameWord("on")) {
            n.typeCondition = (this.expectName())
        }
        this.parseDirectives(n false)
        this.parseSelectionSetInto(n)
        return n
    }

    fn parseFragmentDef:GqlNode () {
        def n:GqlNode (new GqlNode)
        n.kind = (GqlKind.fragmentDef())
        this.mark(n)
        this.takeNameWord("fragment")
        n.name = (this.expectName())
        if (n.name == "on") {
            this.fail("fragment name cannot be 'on'")
            return n
        }
        if ((this.takeNameWord("on")) == false) {
            this.fail("expected on")
            return n
        }
        n.typeCondition = (this.expectName())
        this.parseDirectives(n false)
        this.parseSelectionSetInto(n)
        return n
    }

    fn parseArguments:void (owner:GqlNode constOnly:boolean) {
        if ((this.expectPunct("(")) == false) {
            return
        }
        if (this.atPunct(")")) {
            this.fail("expected an argument")
            return
        }
        while ((this.atPunct(")")) == false) {
            if ((this.ok()) == false) {
                return
            }
            if (this.atEnd()) {
                this.fail("unterminated arguments")
                return
            }
            def a:GqlNode (this.parseArgument(constOnly))
            push owner.args a
        }
        this.expectPunct(")")
    }

    fn parseArgument:GqlNode (constOnly:boolean) {
        def a:GqlNode (new GqlNode)
        a.kind = (GqlKind.argument())
        this.mark(a)
        a.name = (this.expectName())
        if ((this.expectPunct(":")) == false) {
            return a
        }
        def v:GqlNode (this.parseValue(constOnly))
        push a.children v
        return a
    }

    fn parseDirectives:void (owner:GqlNode constOnly:boolean) {
        while (this.atPunct("@")) {
            if ((this.ok()) == false) {
                return
            }
            def d:GqlNode (this.parseDirective(constOnly))
            push owner.directives d
        }
    }

    fn parseDirective:GqlNode (constOnly:boolean) {
        def d:GqlNode (new GqlNode)
        d.kind = (GqlKind.directive())
        this.mark(d)
        this.expectPunct("@")
        d.name = (this.expectName())
        if (this.atPunct("(")) {
            this.parseArguments(d constOnly)
        }
        return d
    }

    fn parseValue:GqlNode (constOnly:boolean) {
        def n:GqlNode (new GqlNode)
        this.mark(n)
        if (this.atPunct("$")) {
            if constOnly {
                this.fail("a constant value cannot be a variable")
                return n
            }
            this.advance()
            n.kind = (GqlKind.variable())
            n.name = (this.expectName())
            n.text = ("$" + n.name)
            return n
        }
        def t:GqlToken (this.peek())
        if (t.kind == (GqlTokenKind.intTok())) {
            this.advance()
            n.kind = (GqlKind.intVal())
            n.text = t.text
            return n
        }
        if (t.kind == (GqlTokenKind.floatTok())) {
            this.advance()
            n.kind = (GqlKind.floatVal())
            n.text = t.text
            return n
        }
        if (t.kind == (GqlTokenKind.stringTok())) {
            this.advance()
            n.kind = (GqlKind.stringVal())
            n.text = t.text
            n.isBlock = t.isBlock
            return n
        }
        if (this.atPunct("[")) {
            return (this.parseListValue(constOnly))
        }
        if (this.atPunct("{")) {
            return (this.parseObjectValue(constOnly))
        }
        if (this.atNameTok()) {
            def w:GqlToken (this.advance())
            if (w.text == "true") {
                n.kind = (GqlKind.boolVal())
                n.text = "true"
                return n
            }
            if (w.text == "false") {
                n.kind = (GqlKind.boolVal())
                n.text = "false"
                return n
            }
            if (w.text == "null") {
                n.kind = (GqlKind.nullVal())
                n.text = "null"
                return n
            }
            n.kind = (GqlKind.enumVal())
            n.name = w.text
            n.text = w.text
            return n
        }
        this.fail("expected a value")
        return n
    }

    fn parseListValue:GqlNode (constOnly:boolean) {
        def n:GqlNode (new GqlNode)
        n.kind = (GqlKind.listVal())
        this.mark(n)
        if ((this.descend()) == false) {
            return n
        }
        this.expectPunct("[")
        while ((this.atPunct("]")) == false) {
            if ((this.ok()) == false) {
                this.ascend()
                return n
            }
            if (this.atEnd()) {
                this.fail("unterminated list")
                this.ascend()
                return n
            }
            def v:GqlNode (this.parseValue(constOnly))
            push n.children v
        }
        this.expectPunct("]")
        this.ascend()
        return n
    }

    fn parseObjectValue:GqlNode (constOnly:boolean) {
        def n:GqlNode (new GqlNode)
        n.kind = (GqlKind.objectVal())
        this.mark(n)
        if ((this.descend()) == false) {
            return n
        }
        this.expectPunct("{")
        while ((this.atPunct("}")) == false) {
            if ((this.ok()) == false) {
                this.ascend()
                return n
            }
            if (this.atEnd()) {
                this.fail("unterminated object")
                this.ascend()
                return n
            }
            def f:GqlNode (new GqlNode)
            f.kind = (GqlKind.argument())
            this.mark(f)
            f.name = (this.expectName())
            if ((this.expectPunct(":")) == false) {
                this.ascend()
                return n
            }
            def v:GqlNode (this.parseValue(constOnly))
            push f.children v
            push n.children f
        }
        this.expectPunct("}")
        this.ascend()
        return n
    }

    fn parseType:GqlNode () {
        if (this.atPunct("[")) {
            def list:GqlNode (new GqlNode)
            list.kind = (GqlKind.listType())
            this.mark(list)
            if ((this.descend()) == false) {
                return list
            }
            this.advance()
            def inner:GqlNode (this.parseType())
            push list.children inner
            if ((this.expectPunct("]")) == false) {
                this.ascend()
                return list
            }
            this.ascend()
            if (this.takePunct("!")) {
                def nn:GqlNode (new GqlNode)
                nn.kind = (GqlKind.nonNullType())
                nn.line = list.line
                nn.col = list.col
                push nn.children list
                return nn
            }
            return list
        }
        def named:GqlNode (new GqlNode)
        named.kind = (GqlKind.namedType())
        this.mark(named)
        named.name = (this.expectName())
        if (this.takePunct("!")) {
            def nn2:GqlNode (new GqlNode)
            nn2.kind = (GqlKind.nonNullType())
            nn2.line = named.line
            nn2.col = named.col
            push nn2.children named
            return nn2
        }
        return named
    }

    ; ------------------------------------------------------- type system SDL --

    fn parseExtension:GqlNode (desc:string) {
        this.takeNameWord("extend")
        if (this.atName("schema")) {
            return (this.parseSchema(desc true))
        }
        if (this.atName("scalar")) {
            return (this.parseScalar(desc true))
        }
        if (this.atName("type")) {
            return (this.parseObjectType(desc true))
        }
        if (this.atName("interface")) {
            return (this.parseInterface(desc true))
        }
        if (this.atName("union")) {
            return (this.parseUnion(desc true))
        }
        if (this.atName("enum")) {
            return (this.parseEnum(desc true))
        }
        if (this.atName("input")) {
            return (this.parseInput(desc true))
        }
        this.fail("expected a type to extend")
        return (new GqlNode)
    }

    fn parseSchema:GqlNode (desc:string isExt:boolean) {
        def n:GqlNode (new GqlNode)
        n.kind = (GqlKind.schemaDef())
        n.description = desc
        n.isExtension = isExt
        this.mark(n)
        this.takeNameWord("schema")
        this.parseDirectives(n true)
        if (this.atPunct("{")) {
            this.expectPunct("{")
            if (this.atPunct("}")) {
                this.fail("expected a root operation type")
                return n
            }
            while ((this.atPunct("}")) == false) {
                if ((this.ok()) == false) {
                    return n
                }
                if (this.atEnd()) {
                    this.fail("unterminated schema")
                    return n
                }
                def root:GqlNode (new GqlNode)
                root.kind = (GqlKind.rootOp())
                this.mark(root)
                if (this.atName("query")) {
                    root.name = "query"
                    this.advance()
                } {
                    if (this.atName("mutation")) {
                        root.name = "mutation"
                        this.advance()
                    } {
                        if (this.atName("subscription")) {
                            root.name = "subscription"
                            this.advance()
                        } {
                            this.fail("expected query, mutation or subscription")
                            return n
                        }
                    }
                }
                if ((this.expectPunct(":")) == false) {
                    return n
                }
                root.text = (this.expectName())
                push n.children root
            }
            this.expectPunct("}")
        } {
            if (isExt == false) {
                this.fail("expected a schema body")
            } {
                if ((array_length n.directives) == 0) {
                    this.fail("extend schema needs a body or a directive")
                }
            }
        }
        return n
    }

    fn parseScalar:GqlNode (desc:string isExt:boolean) {
        def n:GqlNode (new GqlNode)
        n.kind = (GqlKind.scalarDef())
        n.description = desc
        n.isExtension = isExt
        this.mark(n)
        this.takeNameWord("scalar")
        n.name = (this.expectName())
        this.parseDirectives(n true)
        if isExt {
            if ((array_length n.directives) == 0) {
                this.fail("extend scalar needs a directive")
            }
        }
        return n
    }

    fn parseImplements:void (n:GqlNode) {
        if ((this.takeNameWord("implements")) == false) {
            return
        }
        this.takePunct("&")
        def first:string (this.expectName())
        if ((strlen first) == 0) {
            return
        }
        push n.implementsTypes first
        while (this.takePunct("&")) {
            def more:string (this.expectName())
            push n.implementsTypes more
        }
    }

    fn parseObjectType:GqlNode (desc:string isExt:boolean) {
        def n:GqlNode (new GqlNode)
        n.kind = (GqlKind.objectDef())
        n.description = desc
        n.isExtension = isExt
        this.mark(n)
        this.takeNameWord("type")
        n.name = (this.expectName())
        this.parseImplements(n)
        this.parseDirectives(n true)
        if (this.atPunct("{")) {
            this.parseFieldDefs(n)
        } {
            if isExt {
                if ((array_length n.implementsTypes) == 0) {
                    if ((array_length n.directives) == 0) {
                        this.fail("extend type needs fields, implements or a directive")
                    }
                }
            }
        }
        return n
    }

    fn parseInterface:GqlNode (desc:string isExt:boolean) {
        def n:GqlNode (new GqlNode)
        n.kind = (GqlKind.interfaceDef())
        n.description = desc
        n.isExtension = isExt
        this.mark(n)
        this.takeNameWord("interface")
        n.name = (this.expectName())
        this.parseImplements(n)
        this.parseDirectives(n true)
        if (this.atPunct("{")) {
            this.parseFieldDefs(n)
        } {
            if isExt {
                if ((array_length n.implementsTypes) == 0) {
                    if ((array_length n.directives) == 0) {
                        this.fail("extend interface needs fields, implements or a directive")
                    }
                }
            }
        }
        return n
    }

    fn parseFieldDefs:void (owner:GqlNode) {
        this.expectPunct("{")
        if (this.atPunct("}")) {
            this.fail("expected a field definition")
            return
        }
        while ((this.atPunct("}")) == false) {
            if ((this.ok()) == false) {
                return
            }
            if (this.atEnd()) {
                this.fail("unterminated fields")
                return
            }
            def f:GqlNode (this.parseFieldDef())
            push owner.children f
        }
        this.expectPunct("}")
    }

    fn parseFieldDef:GqlNode () {
        def f:GqlNode (new GqlNode)
        f.kind = (GqlKind.fieldDef())
        this.mark(f)
        if (this.atString()) {
            def st:GqlToken (this.advance())
            f.description = st.text
            f.isBlock = st.isBlock
        }
        f.name = (this.expectName())
        if (this.atPunct("(")) {
            this.parseInputValues(f)
        }
        if ((this.expectPunct(":")) == false) {
            return f
        }
        def t:GqlNode (this.parseType())
        push f.children t
        this.parseDirectives(f true)
        return f
    }

    fn parseInputValues:void (owner:GqlNode) {
        this.expectPunct("(")
        if (this.atPunct(")")) {
            this.fail("expected an argument definition")
            return
        }
        while ((this.atPunct(")")) == false) {
            if ((this.ok()) == false) {
                return
            }
            if (this.atEnd()) {
                this.fail("unterminated argument definitions")
                return
            }
            def v:GqlNode (this.parseInputValue())
            push owner.args v
        }
        this.expectPunct(")")
    }

    fn parseInputValue:GqlNode () {
        def v:GqlNode (new GqlNode)
        v.kind = (GqlKind.inputValue())
        this.mark(v)
        if (this.atString()) {
            def st:GqlToken (this.advance())
            v.description = st.text
        }
        v.name = (this.expectName())
        if ((this.expectPunct(":")) == false) {
            return v
        }
        def t:GqlNode (this.parseType())
        push v.children t
        if (this.atPunct("=")) {
            this.advance()
            def d:GqlNode (this.parseValue(true))
            push v.children d
        }
        this.parseDirectives(v true)
        return v
    }

    fn parseUnion:GqlNode (desc:string isExt:boolean) {
        def n:GqlNode (new GqlNode)
        n.kind = (GqlKind.unionDef())
        n.description = desc
        n.isExtension = isExt
        this.mark(n)
        this.takeNameWord("union")
        n.name = (this.expectName())
        this.parseDirectives(n true)
        if (this.takePunct("=")) {
            this.takePunct("|")
            def first:string (this.expectName())
            def a:GqlNode (new GqlNode)
            a.kind = (GqlKind.namedType())
            a.name = first
            push n.children a
            while (this.takePunct("|")) {
                def more:string (this.expectName())
                def b:GqlNode (new GqlNode)
                b.kind = (GqlKind.namedType())
                b.name = more
                push n.children b
            }
        } {
            if isExt {
                if ((array_length n.directives) == 0) {
                    this.fail("extend union needs members or a directive")
                }
            }
        }
        return n
    }

    fn parseEnum:GqlNode (desc:string isExt:boolean) {
        def n:GqlNode (new GqlNode)
        n.kind = (GqlKind.enumDef())
        n.description = desc
        n.isExtension = isExt
        this.mark(n)
        this.takeNameWord("enum")
        n.name = (this.expectName())
        this.parseDirectives(n true)
        if (this.atPunct("{")) {
            this.expectPunct("{")
            if (this.atPunct("}")) {
                this.fail("expected an enum value")
                return n
            }
            while ((this.atPunct("}")) == false) {
                if ((this.ok()) == false) {
                    return n
                }
                if (this.atEnd()) {
                    this.fail("unterminated enum")
                    return n
                }
                def ev:GqlNode (new GqlNode)
                ev.kind = (GqlKind.enumValueDef())
                this.mark(ev)
                if (this.atString()) {
                    def st:GqlToken (this.advance())
                    ev.description = st.text
                }
                ev.name = (this.expectName())
                this.parseDirectives(ev true)
                push n.children ev
            }
            this.expectPunct("}")
        } {
            if isExt {
                if ((array_length n.directives) == 0) {
                    this.fail("extend enum needs values or a directive")
                }
            }
        }
        return n
    }

    fn parseInput:GqlNode (desc:string isExt:boolean) {
        def n:GqlNode (new GqlNode)
        n.kind = (GqlKind.inputDef())
        n.description = desc
        n.isExtension = isExt
        this.mark(n)
        this.takeNameWord("input")
        n.name = (this.expectName())
        this.parseDirectives(n true)
        if (this.atPunct("{")) {
            this.expectPunct("{")
            if (this.atPunct("}")) {
                this.fail("expected an input field")
                return n
            }
            while ((this.atPunct("}")) == false) {
                if ((this.ok()) == false) {
                    return n
                }
                if (this.atEnd()) {
                    this.fail("unterminated input")
                    return n
                }
                def f:GqlNode (this.parseInputValue())
                push n.children f
            }
            this.expectPunct("}")
        } {
            if isExt {
                if ((array_length n.directives) == 0) {
                    this.fail("extend input needs fields or a directive")
                }
            }
        }
        return n
    }

    fn parseDirectiveDef:GqlNode (desc:string) {
        def n:GqlNode (new GqlNode)
        n.kind = (GqlKind.directiveDef())
        n.description = desc
        this.mark(n)
        this.takeNameWord("directive")
        if ((this.expectPunct("@")) == false) {
            return n
        }
        n.name = (this.expectName())
        if (this.atPunct("(")) {
            this.parseInputValues(n)
        }
        if (this.takeNameWord("repeatable")) {
            n.repeatable = true
        }
        if ((this.takeNameWord("on")) == false) {
            this.fail("expected on")
            return n
        }
        this.takePunct("|")
        def first:string (this.expectName())
        push n.locations first
        while (this.takePunct("|")) {
            def more:string (this.expectName())
            push n.locations more
        }
        return n
    }
}

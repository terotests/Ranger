; ==============================================================================
; book_demo.rgr - the sample book, printed
; ==============================================================================
;
;   npm run book:demo
;
; Lays out the book in `BookSample.rgr` - the same one the editor opens - and
; writes it to gallery/book/output:
;
;   spread-NNN.svg   what a reader sees, two pages at a time
;   page-NNN.svg     single pages
;   book.tsx         the EVG document the existing tooling turns into PDF
;   preflight.txt    what a printer would complain about
;   book.json        the laid-out book, for a host that draws the editor
;
; It loads real font faces before laying anything out. That is not a detail:
; with heuristic widths the line breaks here would not be the line breaks in
; the PDF, and preflight says so out loud.
; ==============================================================================

Import "BookApi.rgr"
Import "BookSample.rgr"
Import "../../pdf_writer/src/fonts/EVGFontSetup.rgr"

class BookDemo {
    sfn main:void () {
        print "== Ranger book engine demo =="

        ; --- fonts first, so every measurement is the printed one ---
        def setup (new EVGFontSetup())
        setup.init("./gallery/book/" "")
        def manager:FontManager (setup.getManager())
        def measurer (new TTFTextMeasurer(manager))
        def engine (new EVGTextEngine())
        engine.setMeasurer(measurer)
        print ("Fonts loaded: " + (to_string (setup.loadedCount())))

        def api (new BookApi())
        api.useTextEngine(engine)
        ; The book, laid out with those measurements. Paths are relative to the
        ; output directory, because that is what will open the SVG.
        def doc:BookDocument (BookSample.laidOut("../../pdf_writer/assets/images/" api.flowEngine))
        api.doc = doc
        api.invalidate()

        print (api.summary())

        ; --- check it ---
        def report:BookPreflightReport (api.runPreflight())
        def out:string "./gallery/book/output"
        ; `create_dir` maps to a plain mkdir on the JavaScript target, which
        ; throws when the directory is already there - so a second run of the
        ; demo would fail on success. See ISSUES.md.
        try {
            create_dir out
        } {
        }
        write_file out "preflight.txt" (report.asText())
        print "Preflight:"
        print (report.asText())

        ; --- write it out ---
        def spreads:int (api.writeSpreads(out "spread"))
        def pages:int (api.writePages(out "page"))
        api.writeTsx(out "book.tsx")
        write_file out "book.json" (api.toJson())
        print ("Wrote " + (to_string spreads) + " spread(s) and " + (to_string pages) + " page(s) to " + out)
        print "Next: npm run book:pdf turns book.tsx into a PDF with the EVG tooling."
        print "      npm run book:web opens the same book in the editor."
    }
}

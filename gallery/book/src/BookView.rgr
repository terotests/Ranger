; ==============================================================================
; BookView.rgr - the canvas the editor draws on
; ==============================================================================
;
; One page or one spread, painted through EVG. The display list is the same one
; the WebGL host draws; this is the CPU path, for headless screenshots, tests
; and any host without a GL context.
;
; It carries one thing the slide viewer's canvas does not, because a book needs
; it and a slide does not: **the clip is honoured**. A picture-book page is
; mostly a photograph cropped to a frame - `cover` deliberately draws a
; rectangle bigger than the frame and lets the clip take the rest off - so a
; canvas that ignores PUSH_CLIP draws the picture spilling across the page and
; over the text. The GPU backend has scissored for a while; this makes the two
; agree, which is the only reason to have two.
;
; The other half is the measurer. `EVGContextMeasurer` hands the flow engine
; the same faces this canvas paints with, so the line breaks on screen are the
; line breaks that were computed - not a second, luckier, layout.
; ==============================================================================

Import "BookToEvg.rgr"
Import "../../game_engine/framebuffer.rgr"
Import "../../game_engine/ui/UIContext.rgr"
Import "../../evg/EVGContextMeasurer.rgr"
Import "../../evg/EVGImageDecode.rgr"
Import "../../pdf_writer/src/jpeg/ImageBuffer.rgr"

class BookView {
    def canvas:SoftCanvas (new SoftCanvas)
    def ctx:UIContext (new UIContext)
    def conv:BookToEvg (new BookToEvg())
    def measurer:EVGContextMeasurer (new EVGContextMeasurer())
    def textEngine:EVGTextEngine (new EVGTextEngine())
    def pageW:int 1100
    def pageH:int 760
    ; Room the frame takes out of the window, so a fit-to-window scale leaves
    ; the toolbar, the status line and the pages panel clear.
    def chromeH:int 52
    def chromeW:int 0
    def fontFamily:string "Open Sans"
    def status:string ""
    ; asset path -> decoded pixels
    def imageCache:[string:ImageBuffer]

    ; The clip in force while painting, as a rectangle, plus the stack it is
    ; pushed and popped on.
    def clipX0:double 0.0
    def clipY0:double 0.0
    def clipX1:double 0.0
    def clipY1:double 0.0
    def clipDepth:int 0
    def clipStack:[double]

    Constructor () {
    }

    fn initBare:void (w:int h:int) {
        pageW = w
        pageH = h
        canvas.init(w h)
        ctx.attach(canvas)
        this.attachMeasurer()
        status = "no fonts yet"
    }

    fn init:void (w:int h:int fontDir:string) {
        pageW = w
        pageH = h
        canvas.init(w h)
        ctx.attach(canvas)
        ctx.tr.addFontDir(fontDir)
        def ok:boolean (ctx.tr.loadFont(fontFamily "Open_Sans/OpenSans-Regular.ttf"))
        if (ok == false) {
            status = "bitmap-font fallback"
        } {
            status = "ready"
        }
        ctx.tr.loadFont(fontFamily "Open_Sans/OpenSans-Bold.ttf")
        ctx.tr.loadFont(fontFamily "Open_Sans/OpenSans-Italic.ttf")
        ctx.tr.loadFont(fontFamily "Open_Sans/OpenSans-BoldItalic.ttf")
        ; The display faces. A book set entirely in the UI face is a wireframe
        ; of a book, and the editor is supposed to look like the printed page.
        ctx.tr.loadFont("Cinzel" "Cinzel/Cinzel-Regular.ttf")
        ctx.tr.loadFont("Cinzel" "Cinzel/Cinzel-Bold.ttf")
        ctx.tr.loadFont("Josefin Sans" "Josefin_Sans/JosefinSans-Regular.ttf")
        ctx.tr.loadFont("Josefin Sans" "Josefin_Sans/JosefinSans-Bold.ttf")
        ctx.tr.fontFamily = fontFamily
        ctx.tr.applyFace()
        this.attachMeasurer()
        this.noteFamily("Cinzel")
        this.noteFamily("Josefin Sans")
    }

    ; From here on the flow engine measures with the face this canvas paints.
    fn attachMeasurer:void () {
        measurer.attach(ctx fontFamily)
        textEngine.setMeasurer(measurer)
        conv.engine.setTextEngine(textEngine)
    }

    ; Tell the measurer about a face the renderer has, so a run naming it is
    ; measured in it rather than in the default.
    fn noteFamily:void (name:string) {
        measurer.addKnown(name)
    }

    fn resize:void (w:int h:int) {
        pageW = w
        pageH = h
        canvas.init(w h)
        ctx.attach(canvas)
        ctx.tr.clearCache()
    }

    fn raw:buffer () {
        return (canvas.raw())
    }

    fn cacheImage:void (key:string bytes:buffer) {
        if ((strlen key) == 0) {
            return
        }
        def existing@(optional):ImageBuffer (get imageCache key)
        if (!null? existing) {
            return
        }
        def decoded@(optional):ImageBuffer (EVGImageDecode.decode(bytes))
        if (!null? decoded) {
            set imageCache key (unwrap decoded)
        }
    }

    fn hasImage:boolean (key:string) {
        def hit@(optional):ImageBuffer (get imageCache key)
        return (!null? hit)
    }

    fn imageCount:int () {
        def k:[string] (keys imageCache)
        return (array_length k)
    }

    ; Device pixels per page point for a sheet `w` x `h` points, fitted into
    ; what is left of the window after the frame.
    fn fitScale:double (w:double h:double) {
        def availW:double (to_double (pageW - chromeW))
        def availH:double (to_double (pageH - chromeH))
        if (w <= 0.0) {
            return 1.0
        }
        if (h <= 0.0) {
            return 1.0
        }
        def sx:double (availW / w)
        def sy:double (availH / h)
        def s:double sx
        if (sy < sx) {
            s = sy
        }
        ; A little air around the sheet: a page filling the window edge to edge
        ; reads as a rendering fault rather than as a page.
        return (s * 0.92)
    }

    ; ---------------------------------------------------------------------
    ; Painting
    ; ---------------------------------------------------------------------

    fn resetClip:void () {
        clipX0 = 0.0
        clipY0 = 0.0
        clipX1 = (to_double pageW)
        clipY1 = (to_double pageH)
        clipDepth = 0
        clear clipStack
    }

    fn pushClip:void (x:double y:double w:double h:double) {
        push clipStack clipX0
        push clipStack clipY0
        push clipStack clipX1
        push clipStack clipY1
        clipDepth = (clipDepth + 1)
        def nx0:double x
        def ny0:double y
        def nx1:double (x + w)
        def ny1:double (y + h)
        if (nx0 < clipX0) {
            nx0 = clipX0
        }
        if (ny0 < clipY0) {
            ny0 = clipY0
        }
        if (nx1 > clipX1) {
            nx1 = clipX1
        }
        if (ny1 > clipY1) {
            ny1 = clipY1
        }
        clipX0 = nx0
        clipY0 = ny0
        clipX1 = nx1
        clipY1 = ny1
    }

    fn popClip:void () {
        if (clipDepth <= 0) {
            return
        }
        def n:int (array_length clipStack)
        clipY1 = (itemAt clipStack (n - 1))
        clipX1 = (itemAt clipStack (n - 2))
        clipY0 = (itemAt clipStack (n - 3))
        clipX0 = (itemAt clipStack (n - 4))
        def k:int 0
        while (k < 4) {
            removeLast clipStack
            k = (k + 1)
        }
        clipDepth = (clipDepth - 1)
    }

    ; Fill, cut to the clip. Returns without drawing when nothing is left.
    fn clippedRect:void (x:double y:double w:double h:double col:EVGColor) {
        def x0:double x
        def y0:double y
        def x1:double (x + w)
        def y1:double (y + h)
        if (x0 < clipX0) {
            x0 = clipX0
        }
        if (y0 < clipY0) {
            y0 = clipY0
        }
        if (x1 > clipX1) {
            x1 = clipX1
        }
        if (y1 > clipY1) {
            y1 = clipY1
        }
        if (x1 <= x0) {
            return
        }
        if (y1 <= y0) {
            return
        }
        ctx.fillRect((to_int x0) (to_int y0) (to_int (x1 - x0)) (to_int (y1 - y0)) col)
    }

    fn paintSoftCanvas:void (dl:EVGDisplayList) {
        canvas.clear(226 222 214)
        this.resetClip()
        def i:int 0
        while (i < (array_length dl.cmds)) {
            def c:EVGDrawCmd (itemAt dl.cmds i)
            if (c.kind == 4) {
                this.pushClip(c.x c.y c.w c.h)
            }
            if (c.kind == 5) {
                this.popClip()
            }
            if (c.kind == 0) {
                def col:EVGColor (EVGColor.create((to_double c.r) (to_double c.g) (to_double c.b) c.a))
                this.clippedRect(c.x c.y c.w c.h col)
            }
            if (c.kind == 1) {
                def bcol:EVGColor (EVGColor.create((to_double c.r) (to_double c.g) (to_double c.b) c.a))
                def t:double c.thickness
                if (t < 1.0) {
                    t = 1.0
                }
                this.clippedRect(c.x c.y c.w t bcol)
                this.clippedRect(c.x ((c.y + c.h) - t) c.w t bcol)
                this.clippedRect(c.x c.y t c.h bcol)
                this.clippedRect(((c.x + c.w) - t) c.y t c.h bcol)
            }
            if (c.kind == 3) {
                this.paintTextCmd(c)
            }
            if (c.kind == 2) {
                this.paintImageCmd(c)
            }
            if (c.kind == 6) {
                ctx.fillPolygon(c.pts c.r c.g c.b (to_int (c.a * 255.0)))
            }
            i = (i + 1)
        }
        this.resetClip()
    }

    fn paintTextCmd:void (c:EVGDrawCmd) {
        def col:EVGColor (EVGColor.create((to_double c.r) (to_double c.g) (to_double c.b) c.a))
        def prev:string ctx.tr.fontFamily
        ; The face the run asks for, when the renderer has it. Measuring went
        ; through the same decision in EVGContextMeasurer.faceName, so a line
        ; drawn in Cinzel was also measured in Cinzel.
        def base:string fontFamily
        if ((measurer.hasFace(c.fontFamily))) {
            base = c.fontFamily
        }
        ctx.tr.fontFamily = base
        if (c.fontWeight == "bold") {
            ctx.tr.fontFamily = (base + "-Bold")
        }
        if (c.fontWeight == "italic") {
            ctx.tr.fontFamily = (base + "-Italic")
        }
        if (c.fontWeight == "bolditalic") {
            ctx.tr.fontFamily = (base + "-Bold Italic")
        }
        def x:double c.x
        if ((strlen c.textAlign) > 0) {
            if (c.w > 0.0) {
                def mw:double (ctx.measureWidth(c.text c.fontSize))
                if (c.textAlign == "center") {
                    def slack:double (c.w - mw)
                    x = (c.x + (slack * 0.5))
                }
                if (c.textAlign == "right") {
                    x = ((c.x + c.w) - mw)
                }
            }
        }
        ctx.textClipped(c.text (to_int x) (to_int c.y) c.fontSize col (to_int clipX0) (to_int clipY0) (to_int clipX1) (to_int clipY1))
        ctx.tr.fontFamily = prev
    }

    ; The crop, done as source pixels rather than as a mask. The blit takes a
    ; source rectangle, so the part of the photograph the clip would have hidden
    ; is simply never read - which is both faster and the only way a CPU blit
    ; can honour a clip at all.
    fn paintImageCmd:void (c:EVGDrawCmd) {
        def img@(optional):ImageBuffer (get imageCache c.src)
        if (null? img) {
            def pale:EVGColor (EVGColor.rgb(210 216 228))
            this.clippedRect(c.x c.y c.w c.h pale)
            return
        }
        def pixels:ImageBuffer (unwrap img)
        if (pixels.width <= 0) {
            return
        }
        if (pixels.height <= 0) {
            return
        }
        def dx0:double c.x
        def dy0:double c.y
        def dx1:double (c.x + c.w)
        def dy1:double (c.y + c.h)
        if (dx0 < clipX0) {
            dx0 = clipX0
        }
        if (dy0 < clipY0) {
            dy0 = clipY0
        }
        if (dx1 > clipX1) {
            dx1 = clipX1
        }
        if (dy1 > clipY1) {
            dy1 = clipY1
        }
        if (dx1 <= dx0) {
            return
        }
        if (dy1 <= dy0) {
            return
        }
        if (c.w <= 0.0) {
            return
        }
        if (c.h <= 0.0) {
            return
        }
        def u0:double ((dx0 - c.x) / c.w)
        def v0:double ((dy0 - c.y) / c.h)
        def u1:double ((dx1 - c.x) / c.w)
        def v1:double ((dy1 - c.y) / c.h)
        def iw:double (to_double pixels.width)
        def ih:double (to_double pixels.height)
        def sx:int (to_int (u0 * iw))
        def sy:int (to_int (v0 * ih))
        def sw:int (to_int ((u1 - u0) * iw))
        def sh:int (to_int ((v1 - v0) * ih))
        if (sw < 1) {
            sw = 1
        }
        if (sh < 1) {
            sh = 1
        }
        canvas.blitImageRectScaledFlipped(pixels sx sy sw sh (to_int dx0) (to_int dy0) (to_int (dx1 - dx0)) (to_int (dy1 - dy0)) c.flipH c.flipV)
    }
}

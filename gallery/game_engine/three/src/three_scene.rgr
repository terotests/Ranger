; ==============================================================================
; three_scene — scene root (Three.js port of src/scenes/Scene.js).
; ==============================================================================
; A Scene is an Object3D that holds the renderable graph. Pure Ranger (compiles
; to C++ for native/embedded as well as ES6 for the browser).
; ==============================================================================

Import "three_object3d.rgr"
Import "three_cube_texture.rgr"
Import "three_fog.rgr"

class ThreeScene extends ThreeObject3D {
    def isScene:boolean true
    ; optional solid background colour (0..1); hasBackground gates it.
    def hasBackground:boolean false
    def backgroundR:double 0.0
    def backgroundG:double 0.0
    def backgroundB:double 0.0
    ; optional environment cube map — drawn as the skybox and used for envMap
    ; reflections on reflective materials.
    def hasEnvCube:boolean false
    def envCube:ThreeCubeTexture (new ThreeCubeTexture)
    ; the cube is also drawn behind the scene (setEnvironmentMap); false when it
    ; only lights reflections (setEnvironment, Three.js `scene.environment`)
    def envBackground:boolean true
    ; optional fog (Three.js scene.fog); hasFog gates it
    def hasFog:boolean false
    def fog:ThreeFog (new ThreeFog)

    fn setBackground:ThreeScene (r:double g:double b:double) {
        this.hasBackground = true
        this.backgroundR = r
        this.backgroundG = g
        this.backgroundB = b
        return this
    }
    fn setEnvironmentMap:ThreeScene (c:ThreeCubeTexture) {
        this.envCube = c
        this.hasEnvCube = true
        this.envBackground = true
        return this
    }
    ; Reflections only, as Three.js `scene.environment`: reflective materials
    ; mirror the cube, nothing is drawn behind the scene.
    fn setEnvironment:ThreeScene (c:ThreeCubeTexture) {
        this.envCube = c
        this.hasEnvCube = true
        this.envBackground = false
        return this
    }
    fn setFog:ThreeScene (f:ThreeFog) {
        this.fog = f
        this.hasFog = true
        return this
    }
    fn clearFog:ThreeScene () {
        this.hasFog = false
        return this
    }
}

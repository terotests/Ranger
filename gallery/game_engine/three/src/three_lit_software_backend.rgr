; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; three_lit_software_backend — the GL backend's picture, drawn without a GPU.
; ==============================================================================
;
; ThreeSoftwareBackend is the unlit reference the headless tests compare
; against (flat colour times texture). This one draws what ThreeGLBackend
; draws in the browser, for a host with no GPU (a server answering with a
; still): per pixel the übershader's light (three_shade.rgr), triangles clipped
; at the near plane as GL clips them, back faces culled unless the material is
; double-sided, flat shading and wireframes, the environment cube in
; reflections and as the skybox, the shadow map (depth from the light, 3x3
; PCF), tone mapping, the sRGB output and the clear alpha.
;
; The frame is RGBA (`rgba()`, w*h*4, top row first); `raw()` is its RGB.
; Not drawn here: normal maps, light-probe volumes and the atmosphere dome.
; The shadow map is 1024 a side (the GL one is 2048).
; ==============================================================================

Import "three_render_backend.rgr"
Import "three_buffer_geometry.rgr"
Import "three_matrix4.rgr"
Import "three_texture.rgr"
Import "three_cube_texture.rgr"
Import "three_material.rgr"
Import "three_vector3.rgr"
Import "three_shade.rgr"

class ThreeLitSoftwareBackend extends ThreeRenderBackend {
    def w:int 0
    def h:int 0
    def color:buffer (buffer_alloc 0)
    def depth:double_buffer (double_buffer_alloc 0)
    def clearA:double 1.0
    def shade:ThreeShade (new ThreeShade)

    ; the shadow map: window depth from the light, size*size, row 0 at the
    ; light's NDC y = -1 (as GL's texture rows)
    def shadowSize:int 1024
    def shadowDepth:double_buffer (double_buffer_alloc 0)
    def shadowPass:boolean false
    def shadowOn:boolean false
    def shadowVP:ThreeMatrix4 (new ThreeMatrix4)

    ; environment cubes by handle (1-based, as the GL backend's)
    def envs:[ThreeCubeTexture]
    def envAt:int 0

    ; one clipped polygon: STRIDE doubles a vertex
    ; clip x y z w, world x y z, normal x y z, uv u v
    def poly:[double]
    def polyN:int 0

    sfn STRIDE:int () {
        return 12
    }

    fn init:void (width:int height:int) {
        w = width
        h = height
        color = (buffer_alloc ((width * height) * 4))
        depth = (double_buffer_alloc (width * height))
    }

    fn setClearAlpha:void (a:double) {
        clearA = a
    }

    fn beginFrame:void (width:int height:int r:double g:double b:double) {
        if ((w != width) || (h != height)) {
            this.init(width height)
        }
        def br:int (this.byteOf(r))
        def bg:int (this.byteOf(g))
        def bb:int (this.byteOf(b))
        def ba:int (this.byteOf(clearA))
        def n:int (w * h)
        def i:int 0
        while (i < n) {
            def o:int (i * 4)
            buffer_set color o br
            buffer_set color (o + 1) bg
            buffer_set color (o + 2) bb
            buffer_set color (o + 3) ba
            ; GL clears depth to 1 (the far plane)
            double_buffer_set depth i 1.0
            i = (i + 1)
        }
    }

    ; a 0..1 channel as GL stores it in an 8-bit target
    fn byteOf:int (c:double) {
        if (c <= 0.0) {
            return 0
        }
        if (c >= 1.0) {
            return 255
        }
        return (to_int ((c * 255.0) + 0.5))
    }

    fn setLights:void (ambR:double ambG:double ambB:double dirCount:int dirs:[double] cols:[double]) {
        shade.setLights(ambR ambG ambB dirCount dirs cols)
    }
    fn setPointLights:void (pointCount:int pos:[double] cols:[double] range:[double]) {
        shade.setPointLights(pointCount pos cols range)
    }
    fn setOutputSRGB:void (on:boolean) {
        shade.setOutputSRGB(on)
    }
    fn setView:void (camX:double camY:double camZ:double) {
        shade.setView(camX camY camZ)
    }
    fn setToneMapping:void (mode:int exposure:double) {
        shade.setToneMapping(mode exposure)
    }

    fn ensureEnvironment:int (cube:ThreeCubeTexture) {
        def i:int 0
        while (i < (array_length envs)) {
            def c:ThreeCubeTexture (itemAt envs i)
            if (c == cube) {
                return (i + 1)
            }
            i = (i + 1)
        }
        if ((cube.faceCount()) != 6) {
            return 0
        }
        push envs cube
        return (array_length envs)
    }
    fn setEnvironment:void (handle:int) {
        envAt = handle
        if ((handle > 0) && (handle <= (array_length envs))) {
            shade.setEnvironment((itemAt envs (handle - 1)) true)
        } {
            shade.setEnvironment((new ThreeCubeTexture) false)
        }
    }

    ; the cube behind everything: each pixel's ray through the inverse of the
    ; skybox's view-projection, where nothing is drawn yet
    fn drawSkybox:void (handle:int mvp:ThreeMatrix4) {
        if ((handle < 1) || (handle > (array_length envs))) {
            return
        }
        def sky:ThreeShade (new ThreeShade)
        sky.setEnvironment((itemAt envs (handle - 1)) true)
        def inv:ThreeMatrix4 (mvp.clone())
        inv.invert()
        def y:int 0
        while (y < h) {
            def x:int 0
            while (x < w) {
                def nx:double (((((to_double x) + 0.5) / (to_double w)) * 2.0) - 1.0)
                def ny:double (1.0 - ((((to_double y) + 0.5) / (to_double h)) * 2.0))
                def far:ThreeVector3 (inv.transformPoint((ThreeVector3.of(nx ny 1.0))))
                def near:ThreeVector3 (inv.transformPoint((ThreeVector3.of(nx ny (0.0 - 1.0)))))
                sky.sampleEnv((far.x - near.x) (far.y - near.y) (far.z - near.z))
                def o:int (((y * w) + x) * 4)
                buffer_set color o (this.byteOf(sky.envR))
                buffer_set color (o + 1) (this.byteOf(sky.envG))
                buffer_set color (o + 2) (this.byteOf(sky.envB))
                buffer_set color (o + 3) 255
                x = (x + 1)
            }
            y = (y + 1)
        }
    }

    ; --- the shadow map -------------------------------------------------------
    fn beginShadowPass:void () {
        def n:int (shadowSize * shadowSize)
        if ((double_buffer_length shadowDepth) != n) {
            shadowDepth = (double_buffer_alloc n)
        }
        def i:int 0
        while (i < n) {
            double_buffer_set shadowDepth i 1.0
            i = (i + 1)
        }
        shadowPass = true
    }
    fn endShadowPass:void (width:int height:int) {
        shadowPass = false
    }
    fn setShadow:void (lightViewProj:ThreeMatrix4 enabled:boolean) {
        shadowVP = (lightViewProj.clone())
        shadowOn = (enabled && ((double_buffer_length shadowDepth) > 0))
    }

    ; a caster's depth from the light: no culling, as the GL depth pass
    fn drawDepth:void (geometry:ThreeBufferGeometry mvp:ThreeMatrix4) {
        if (shadowPass == false) {
            return
        }
        def ic:int (geometry.indexCount())
        def t:int 0
        while (t < ic) {
            this.clipTri(geometry mvp mvp (geometry.getIndex(t)) (geometry.getIndex((t + 1))) (geometry.getIndex((t + 2))))
            if (polyN >= 3) {
                this.fillDepth()
            }
            t = (t + 3)
        }
    }

    ; light reaching world point (x, y, z) past the casters, 0..1
    fn shadowAt:double (x:double y:double z:double) {
        if (shadowOn == false) {
            return 1.0
        }
        def p:ThreeVector3 (shadowVP.transformPoint((ThreeVector3.of(x y z))))
        def px:double ((p.x * 0.5) + 0.5)
        def py:double ((p.y * 0.5) + 0.5)
        def pz:double ((p.z * 0.5) + 0.5)
        if ((((pz > 1.0) || (px < 0.0)) || (px > 1.0)) || ((py < 0.0) || (py > 1.0))) {
            return 1.0
        }
        def n:int shadowSize
        def lit:double 0.0
        def j:int (0 - 1)
        while (j <= 1) {
            def i:int (0 - 1)
            while (i <= 1) {
                def tx:int (to_int (((px * (to_double n)) + (to_double i))))
                def ty:int (to_int (((py * (to_double n)) + (to_double j))))
                def d:double 1.0
                if ((((tx >= 0) && (tx < n)) && (ty >= 0)) && (ty < n)) {
                    d = (double_buffer_get shadowDepth ((ty * n) + tx))
                }
                if ((pz - 0.0025) <= d) {
                    lit = (lit + 1.0)
                }
                i = (i + 1)
            }
            j = (j + 1)
        }
        return (lit / 9.0)
    }

    ; --- clipping ---------------------------------------------------------------
    ; Vertex k of the geometry in clip space with its world position, world
    ; normal and uv, pushed onto `into`.
    fn vertexOf:void (geometry:ThreeBufferGeometry model:ThreeMatrix4 mvp:ThreeMatrix4 k:int into:[double]) {
        def lx:double (geometry.getPosition(k 0))
        def ly:double (geometry.getPosition(k 1))
        def lz:double (geometry.getPosition(k 2))
        push into ((((lx * (mvp.eGet(0))) + (ly * (mvp.eGet(4)))) + (lz * (mvp.eGet(8)))) + (mvp.eGet(12)))
        push into ((((lx * (mvp.eGet(1))) + (ly * (mvp.eGet(5)))) + (lz * (mvp.eGet(9)))) + (mvp.eGet(13)))
        push into ((((lx * (mvp.eGet(2))) + (ly * (mvp.eGet(6)))) + (lz * (mvp.eGet(10)))) + (mvp.eGet(14)))
        push into ((((lx * (mvp.eGet(3))) + (ly * (mvp.eGet(7)))) + (lz * (mvp.eGet(11)))) + (mvp.eGet(15)))
        push into ((((lx * (model.eGet(0))) + (ly * (model.eGet(4)))) + (lz * (model.eGet(8)))) + (model.eGet(12)))
        push into ((((lx * (model.eGet(1))) + (ly * (model.eGet(5)))) + (lz * (model.eGet(9)))) + (model.eGet(13)))
        push into ((((lx * (model.eGet(2))) + (ly * (model.eGet(6)))) + (lz * (model.eGet(10)))) + (model.eGet(14)))
        def nx:double 0.0
        def ny:double 0.0
        def nz:double 1.0
        if ((array_length geometry.normals) >= ((k * 3) + 3)) {
            nx = (geometry.getNormal(k 0))
            ny = (geometry.getNormal(k 1))
            nz = (geometry.getNormal(k 2))
        }
        ; as the vertex shader: uModel * vec4(aNormal, 0)
        push into (((nx * (model.eGet(0))) + (ny * (model.eGet(4)))) + (nz * (model.eGet(8))))
        push into (((nx * (model.eGet(1))) + (ny * (model.eGet(5)))) + (nz * (model.eGet(9))))
        push into (((nx * (model.eGet(2))) + (ny * (model.eGet(6)))) + (nz * (model.eGet(10))))
        def u:double 0.0
        def v:double 0.0
        if ((array_length geometry.uvs) >= ((k * 2) + 2)) {
            u = (geometry.getUv(k 0))
            v = (geometry.getUv(k 1))
        }
        push into u
        push into v
    }

    ; Triangle (a, b, c) clipped to the near plane (z >= -w) into `poly`.
    fn clipTri:void (geometry:ThreeBufferGeometry model:ThreeMatrix4 mvp:ThreeMatrix4 a:int b:int c:int) {
        def tri:[double]
        this.vertexOf(geometry model mvp a tri)
        this.vertexOf(geometry model mvp b tri)
        this.vertexOf(geometry model mvp c tri)
        def out:[double]
        def s:int (ThreeLitSoftwareBackend.STRIDE())
        def n:int 0
        def i:int 0
        while (i < 3) {
            def j:int ((i + 1) % 3)
            def di:double ((itemAt tri ((i * s) + 2)) + (itemAt tri ((i * s) + 3)))
            def dj:double ((itemAt tri ((j * s) + 2)) + (itemAt tri ((j * s) + 3)))
            if (di >= 0.0) {
                def q:int 0
                while (q < s) {
                    push out (itemAt tri ((i * s) + q))
                    q = (q + 1)
                }
                n = (n + 1)
            }
            if (((di >= 0.0) && (dj < 0.0)) || ((di < 0.0) && (dj >= 0.0))) {
                def t:double (di / (di - dj))
                def q2:int 0
                while (q2 < s) {
                    def va:double (itemAt tri ((i * s) + q2))
                    def vb:double (itemAt tri ((j * s) + q2))
                    push out (va + ((vb - va) * t))
                    q2 = (q2 + 1)
                }
                n = (n + 1)
            }
            i = (i + 1)
        }
        poly = out
        polyN = n
    }

    ; --- drawing -----------------------------------------------------------------
    fn drawMesh:void (geometry:ThreeBufferGeometry model:ThreeMatrix4 mvp:ThreeMatrix4 mat:ThreeMaterial) {
        if ((geometry.vertexCount()) == 0) {
            return
        }
        if mat.wireframe {
            this.drawWire(geometry model mvp mat)
            return
        }
        def g:ThreeBufferGeometry geometry
        if mat.flatShading {
            g = (geometry.buildFlat())
        }
        def ic:int (g.indexCount())
        def t:int 0
        while (t < ic) {
            this.clipTri(g model mvp (g.getIndex(t)) (g.getIndex((t + 1))) (g.getIndex((t + 2))))
            if (polyN >= 3) {
                this.fillPoly(mat)
            }
            t = (t + 3)
        }
    }

    fn sxOf:double (k:int) {
        def s:int (ThreeLitSoftwareBackend.STRIDE())
        return (((((itemAt poly (k * s)) / (itemAt poly ((k * s) + 3))) * 0.5) + 0.5) * (to_double w))
    }
    fn syOf:double (k:int) {
        def s:int (ThreeLitSoftwareBackend.STRIDE())
        return ((1.0 - ((((itemAt poly ((k * s) + 1)) / (itemAt poly ((k * s) + 3))) * 0.5) + 0.5)) * (to_double h))
    }
    ; window depth, 0 near .. 1 far
    fn szOf:double (k:int) {
        def s:int (ThreeLitSoftwareBackend.STRIDE())
        return ((((itemAt poly ((k * s) + 2)) / (itemAt poly ((k * s) + 3))) * 0.5) + 0.5)
    }

    ; the clipped polygon as a fan of triangles from its first corner
    fn fillPoly:void (mat:ThreeMaterial) {
        ; the polygon's winding on screen: GL's front faces are counter-
        ; clockwise in NDC, clockwise with y pointing down
        def area:double 0.0
        def k:int 0
        while (k < polyN) {
            def k2:int ((k + 1) % polyN)
            area = (area + (((this.sxOf(k)) * (this.syOf(k2))) - ((this.sxOf(k2)) * (this.syOf(k)))))
            k = (k + 1)
        }
        if ((mat.side < 2) && (area > 0.0)) {
            return
        }
        def i:int 1
        while ((i + 1) < polyN) {
            this.fillTri(mat 0 i (i + 1))
            i = (i + 1)
        }
    }

    fn fillTri:void (mat:ThreeMaterial i0:int i1:int i2:int) {
        def s:int (ThreeLitSoftwareBackend.STRIDE())
        def x0:double (this.sxOf(i0))
        def y0:double (this.syOf(i0))
        def x1:double (this.sxOf(i1))
        def y1:double (this.syOf(i1))
        def x2:double (this.sxOf(i2))
        def y2:double (this.syOf(i2))
        def area:double (((x1 - x0) * (y2 - y0)) - ((x2 - x0) * (y1 - y0)))
        if ((area < 0.000001) && (area > (0.0 - 0.000001))) {
            return
        }
        def z0:double (this.szOf(i0))
        def z1:double (this.szOf(i1))
        def z2:double (this.szOf(i2))
        def iw0:double (1.0 / (itemAt poly ((i0 * s) + 3)))
        def iw1:double (1.0 / (itemAt poly ((i1 * s) + 3)))
        def iw2:double (1.0 / (itemAt poly ((i2 * s) + 3)))
        def minx:int (this.clampi((to_int (this.dmin3(x0 x1 x2))) 0 (w - 1)))
        def maxx:int (this.clampi((to_int (this.dmax3(x0 x1 x2))) 0 (w - 1)))
        def miny:int (this.clampi((to_int (this.dmin3(y0 y1 y2))) 0 (h - 1)))
        def maxy:int (this.clampi((to_int (this.dmax3(y0 y1 y2))) 0 (h - 1)))
        def invArea:double (1.0 / area)
        def py:int miny
        while (py <= maxy) {
            def px:int minx
            while (px <= maxx) {
                def fx:double ((to_double px) + 0.5)
                def fy:double ((to_double py) + 0.5)
                def b0:double ((((x1 - fx) * (y2 - fy)) - ((x2 - fx) * (y1 - fy))) * invArea)
                def b1:double ((((x2 - fx) * (y0 - fy)) - ((x0 - fx) * (y2 - fy))) * invArea)
                def b2:double ((1.0 - b0) - b1)
                if (((b0 >= 0.0) && (b1 >= 0.0)) && (b2 >= 0.0)) {
                    def d:double (((b0 * z0) + (b1 * z1)) + (b2 * z2))
                    def pidx:int ((py * w) + px)
                    if ((d >= 0.0) && (d < (double_buffer_get depth pidx))) {
                        double_buffer_set depth pidx d
                        ; perspective-correct weights
                        def p0:double (b0 * iw0)
                        def p1:double (b1 * iw1)
                        def p2:double (b2 * iw2)
                        def ps:double ((p0 + p1) + p2)
                        p0 = (p0 / ps)
                        p1 = (p1 / ps)
                        p2 = (p2 / ps)
                        this.shadePixel(mat pidx i0 i1 i2 p0 p1 p2)
                    }
                }
                px = (px + 1)
            }
            py = (py + 1)
        }
    }

    ; attribute q of the polygon at weights p0..p2 of corners i0..i2
    fn mix3:double (q:int i0:int i1:int i2:int p0:double p1:double p2:double) {
        def s:int (ThreeLitSoftwareBackend.STRIDE())
        return ((((itemAt poly ((i0 * s) + q)) * p0) + ((itemAt poly ((i1 * s) + q)) * p1)) + ((itemAt poly ((i2 * s) + q)) * p2))
    }

    fn shadePixel:void (mat:ThreeMaterial pidx:int i0:int i1:int i2:int p0:double p1:double p2:double) {
        def wx:double (this.mix3(4 i0 i1 i2 p0 p1 p2))
        def wy:double (this.mix3(5 i0 i1 i2 p0 p1 p2))
        def wz:double (this.mix3(6 i0 i1 i2 p0 p1 p2))
        def nx:double (this.mix3(7 i0 i1 i2 p0 p1 p2))
        def ny:double (this.mix3(8 i0 i1 i2 p0 p1 p2))
        def nz:double (this.mix3(9 i0 i1 i2 p0 p1 p2))
        def br:double mat.colorR
        def bg:double mat.colorG
        def bb:double mat.colorB
        if mat.hasMap {
            def u:double (this.mix3(10 i0 i1 i2 p0 p1 p2))
            def v:double (this.mix3(11 i0 i1 i2 p0 p1 p2))
            br = ((br * (to_double (this.sampleTex(mat.map u v 0)))) / 255.0)
            bg = ((bg * (to_double (this.sampleTex(mat.map u v 1)))) / 255.0)
            bb = ((bb * (to_double (this.sampleTex(mat.map u v 2)))) / 255.0)
        }
        def sf:double 1.0
        if ((mat.shadingMode()) > 0) {
            sf = (this.shadowAt(wx wy wz))
        }
        shade.shade(mat br bg bb nx ny nz wx wy wz sf)
        def o:int (pidx * 4)
        buffer_set color o (this.byteOf(shade.r))
        buffer_set color (o + 1) (this.byteOf(shade.g))
        buffer_set color (o + 2) (this.byteOf(shade.b))
        buffer_set color (o + 3) 255
    }

    ; the clipped polygon's depth into the shadow map
    fn fillDepth:void () {
        def n:int shadowSize
        def i:int 1
        while ((i + 1) < polyN) {
            def ks:[int] (([] _:int (0 i (i + 1))))
            def xs:[double]
            def ys:[double]
            def zs:[double]
            for ks k:int ki {
                def s:int (ThreeLitSoftwareBackend.STRIDE())
                def cw:double (itemAt poly ((k * s) + 3))
                push xs (((((itemAt poly (k * s)) / cw) * 0.5) + 0.5) * (to_double n))
                push ys (((((itemAt poly ((k * s) + 1)) / cw) * 0.5) + 0.5) * (to_double n))
                push zs ((((itemAt poly ((k * s) + 2)) / cw) * 0.5) + 0.5)
            }
            def x0:double (itemAt xs 0)
            def y0:double (itemAt ys 0)
            def x1:double (itemAt xs 1)
            def y1:double (itemAt ys 1)
            def x2:double (itemAt xs 2)
            def y2:double (itemAt ys 2)
            def area:double (((x1 - x0) * (y2 - y0)) - ((x2 - x0) * (y1 - y0)))
            if ((area > 0.000001) || (area < (0.0 - 0.000001))) {
                def invArea:double (1.0 / area)
                def minx:int (this.clampi((to_int (this.dmin3(x0 x1 x2))) 0 (n - 1)))
                def maxx:int (this.clampi((to_int (this.dmax3(x0 x1 x2))) 0 (n - 1)))
                def miny:int (this.clampi((to_int (this.dmin3(y0 y1 y2))) 0 (n - 1)))
                def maxy:int (this.clampi((to_int (this.dmax3(y0 y1 y2))) 0 (n - 1)))
                def py:int miny
                while (py <= maxy) {
                    def px:int minx
                    while (px <= maxx) {
                        def fx:double ((to_double px) + 0.5)
                        def fy:double ((to_double py) + 0.5)
                        def b0:double ((((x1 - fx) * (y2 - fy)) - ((x2 - fx) * (y1 - fy))) * invArea)
                        def b1:double ((((x2 - fx) * (y0 - fy)) - ((x0 - fx) * (y2 - fy))) * invArea)
                        def b2:double ((1.0 - b0) - b1)
                        if (((b0 >= 0.0) && (b1 >= 0.0)) && (b2 >= 0.0)) {
                            def d:double (((b0 * (itemAt zs 0)) + (b1 * (itemAt zs 1))) + (b2 * (itemAt zs 2)))
                            def at:int ((py * n) + px)
                            if (d < (double_buffer_get shadowDepth at)) {
                                double_buffer_set shadowDepth at d
                            }
                        }
                        px = (px + 1)
                    }
                    py = (py + 1)
                }
            }
            i = (i + 1)
        }
    }

    ; each triangle's edges as one-pixel lines (GL LINES: no culling)
    fn drawWire:void (geometry:ThreeBufferGeometry model:ThreeMatrix4 mvp:ThreeMatrix4 mat:ThreeMaterial) {
        def wi:[int] (geometry.buildWireIndex())
        def s:int (ThreeLitSoftwareBackend.STRIDE())
        def e:int 0
        while ((e + 1) < (array_length wi)) {
            def seg:[double]
            this.vertexOf(geometry model mvp (itemAt wi e) seg)
            this.vertexOf(geometry model mvp (itemAt wi (e + 1)) seg)
            def da:double ((itemAt seg 2) + (itemAt seg 3))
            def db:double ((itemAt seg (s + 2)) + (itemAt seg (s + 3)))
            if ((da >= 0.0) || (db >= 0.0)) {
                ; the end behind the near plane moved onto it
                def t0:double 0.0
                def t1:double 1.0
                if (da < 0.0) {
                    t0 = (da / (da - db))
                }
                if (db < 0.0) {
                    t1 = (da / (da - db))
                }
                def out:[double]
                for ([] _:double (t0 t1)) tt:double ti {
                    def q:int 0
                    while (q < s) {
                        def va:double (itemAt seg q)
                        def vb:double (itemAt seg (s + q))
                        push out (va + ((vb - va) * tt))
                        q = (q + 1)
                    }
                }
                poly = out
                polyN = 2
                this.line(mat)
            }
            e = (e + 2)
        }
    }

    fn line:void (mat:ThreeMaterial) {
        def x0:double (this.sxOf(0))
        def y0:double (this.syOf(0))
        def x1:double (this.sxOf(1))
        def y1:double (this.syOf(1))
        def dx:double (x1 - x0)
        def dy:double (y1 - y0)
        def adx:double dx
        if (adx < 0.0) {
            adx = (0.0 - adx)
        }
        def ady:double dy
        if (ady < 0.0) {
            ady = (0.0 - ady)
        }
        def steps:int (to_int (this.dmax3(adx ady 1.0)))
        def z0:double (this.szOf(0))
        def z1:double (this.szOf(1))
        def s:int (ThreeLitSoftwareBackend.STRIDE())
        def iw0:double (1.0 / (itemAt poly 3))
        def iw1:double (1.0 / (itemAt poly (s + 3)))
        def k:int 0
        while (k <= steps) {
            def t:double ((to_double k) / (to_double steps))
            def px:int (to_int (x0 + (dx * t)))
            def py:int (to_int (y0 + (dy * t)))
            if ((((px >= 0) && (px < w)) && (py >= 0)) && (py < h)) {
                def d:double (z0 + ((z1 - z0) * t))
                def pidx:int ((py * w) + px)
                if ((d >= 0.0) && (d < (double_buffer_get depth pidx))) {
                    double_buffer_set depth pidx d
                    def p0:double ((1.0 - t) * iw0)
                    def p1:double (t * iw1)
                    def ps:double (p0 + p1)
                    this.shadePixel(mat pidx 0 1 1 (p0 / ps) (p1 / ps) 0.0)
                }
            }
            k = (k + 1)
        }
    }

    fn clampi:int (v:int lo:int hi:int) {
        if (v < lo) {
            return lo
        }
        if (v > hi) {
            return hi
        }
        return v
    }

    ; nearest texel, repeating (ThreeSoftwareBackend's)
    fn sampleTex:int (tex:ThreeTexture u:double v:double comp:int) {
        def tw:int tex.width
        def th:int tex.height
        if ((tw <= 0) || (th <= 0)) {
            return 255
        }
        def uu:double (u - (to_double (to_int u)))
        if (uu < 0.0) {
            uu = (uu + 1.0)
        }
        def vv:double (v - (to_double (to_int v)))
        if (vv < 0.0) {
            vv = (vv + 1.0)
        }
        def tx:int (this.clampi((to_int (uu * (to_double tw))) 0 (tw - 1)))
        def ty:int (this.clampi((to_int (vv * (to_double th))) 0 (th - 1)))
        return (buffer_get tex.rgba ((((ty * tw) + tx) * 4) + comp))
    }

    fn dmin3:double (a:double b:double c:double) {
        def m:double a
        if (b < m) {
            m = b
        }
        if (c < m) {
            m = c
        }
        return m
    }
    fn dmax3:double (a:double b:double c:double) {
        def m:double a
        if (b > m) {
            m = b
        }
        if (c > m) {
            m = c
        }
        return m
    }

    ; the frame, RGBA, top row first
    fn rgba:buffer () {
        return color
    }
    ; the frame, RGB
    fn raw:buffer () {
        def n:int (w * h)
        def out:buffer (buffer_alloc (n * 3))
        def i:int 0
        while (i < n) {
            buffer_set out (i * 3) (buffer_get color (i * 4))
            buffer_set out ((i * 3) + 1) (buffer_get color ((i * 4) + 1))
            buffer_set out ((i * 3) + 2) (buffer_get color ((i * 4) + 2))
            i = (i + 1)
        }
        return out
    }
    fn width:int () {
        return w
    }
    fn height:int () {
        return h
    }
}

; ==============================================================================
; three_webgl_renderer — (Three.js port of src/renderers/WebGLRenderer.js, core).
; ==============================================================================
;
; render(scene, camera) walks the scene graph and draws each mesh through a
; PLUGGABLE backend (three_render_backend.rgr) — there is no GPU code here, so
; the renderer core is pure Ranger and compiles to C++ for native/embedded.
;
; Default backend: the pure-Ranger ThreeSoftwareBackend (works headless / on a
; Raspberry Pi). A browser host can inject a WebGL backend via setBackend(...)
; for GPU acceleration — the same scene, drawn on the GPU.
;
; The rAF `setAnimationLoop` / `domElement` bits of Three.js are browser-host
; concerns and live in the web wrapper, not in this portable core.
; ==============================================================================

Import "three_render_backend.rgr"
Import "three_software_backend.rgr"
Import "three_scene.rgr"
Import "three_perspective_camera.rgr"
Import "three_object3d.rgr"
Import "three_matrix4.rgr"

class ThreeWebGLRenderer {
    def isWebGLRenderer:boolean true
    def w:int 300
    def h:int 150
    def pixelRatio:double 1.0
    def software:ThreeSoftwareBackend (new ThreeSoftwareBackend)
    def backend:ThreeRenderBackend (new ThreeRenderBackend)
    def useSoftware:boolean true
    def clearR:double 0.086
    def clearG:double 0.102
    def clearB:double 0.133

    ; inject a GPU (e.g. WebGL) backend; default is the software rasteriser.
    fn setBackend:ThreeWebGLRenderer (b:ThreeRenderBackend) {
        backend = b
        useSoftware = false
        return this
    }
    fn setSize:ThreeWebGLRenderer (width:int height:int) {
        w = width
        h = height
        return this
    }
    fn setPixelRatio:ThreeWebGLRenderer (r:double) {
        pixelRatio = r
        return this
    }
    fn setClearColor:ThreeWebGLRenderer (r:double g:double b:double) {
        clearR = r
        clearG = g
        clearB = b
        return this
    }

    fn activeBackend:ThreeRenderBackend () {
        if useSoftware {
            return software
        }
        return backend
    }

    fn render:void (scene:ThreeScene camera:ThreePerspectiveCamera) {
        camera.updateProjectionMatrix()
        camera.updateViewMatrix()
        scene.updateMatrixWorld()
        def be:ThreeRenderBackend (this.activeBackend())
        def br:double clearR
        def bg:double clearG
        def bb:double clearB
        if scene.hasBackground {
            br = scene.backgroundR
            bg = scene.backgroundG
            bb = scene.backgroundB
        }
        be.beginFrame(w h br bg bb)
        ; view-projection = projection * inverse(camera world)
        def vp:ThreeMatrix4 (new ThreeMatrix4)
        vp.multiplyMatrices(camera.projectionMatrix camera.matrixWorldInverse)
        this.renderObject(scene be vp)
        be.endFrame()
    }

    fn renderObject:void (obj:ThreeObject3D be:ThreeRenderBackend vp:ThreeMatrix4) {
        obj.renderInto(be vp)
        def i:int 0
        def n:int (obj.childCount())
        while (i < n) {
            def c:ThreeObject3D (obj.getChild(i))
            this.renderObject(c be vp)
            i = (i + 1)
        }
    }

    ; the rendered RGB frame from the active backend (software path).
    fn raw:buffer () {
        def be:ThreeRenderBackend (this.activeBackend())
        return (be.raw())
    }
    fn width:int () {
        return w
    }
    fn height:int () {
        return h
    }
}

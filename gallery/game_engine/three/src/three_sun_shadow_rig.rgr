; ==============================================================================
; three_sun_shadow_rig — a REUSABLE sun + shadow technique rig (no demo glue).
; ==============================================================================
; Derives a directional sun's placement and its shadow-camera from a model's
; world-space bounds, and drives a Preetham sky's sun uniform to match. This is a
; generic GPU-technique unit: point it at ANY reconciled ThreeDirectionalLight +
; ThreeSky + the model bounds, and it configures the sun/shadow the same way for
; any scene. It holds only the sun knobs (azimuth / elevation / intensity) + the
; bounds-derived metrics; it never owns scene objects — the caller passes the
; reconciled sun / sky / scene, so the rig operates on the host-owned registry.
;
; A composition (e.g. ThreeSponzaScene) wires this rig + a probe-GI rig + controls;
; a different look is a different composition over the same rigs, not a fork.
; Pure Ranger (compiles to ES6 and C++).
; ==============================================================================

Import "three_box3.rgr"
Import "three_vector3.rgr"
Import "three_scene.rgr"
Import "three_sky.rgr"
Import "three_light.rgr"
Import "three_math_utils.rgr"

class ThreeSunShadowRig {
    ; --- knobs (the caller sets these from the scene's params) ---
    def azimuth:double 0.0
    def elevation:double 45.0
    def intensity:double 1.0

    ; --- metrics derived from the model bounds (configureFromBounds) ---
    def sizeX:double 1.0
    def sizeY:double 1.0
    def sizeZ:double 1.0
    def centerX:double 0.0
    def centerY:double 0.0
    def centerZ:double 0.0
    def targetY:double 0.0
    def baseDistance:double 1.0
    def probeFar:double 1.0

    sfn maxOf2:double (a:double b:double) {
        if (a > b) {
            return a
        }
        return b
    }
    sfn maxOf3:double (a:double b:double c:double) {
        def m:double (ThreeSunShadowRig.maxOf2(a b))
        return (ThreeSunShadowRig.maxOf2(m c))
    }

    fn setAngles:ThreeSunShadowRig (az:double el:double) {
        this.azimuth = az
        this.elevation = el
        return this
    }
    fn setIntensity:ThreeSunShadowRig (v:double) {
        this.intensity = v
        return this
    }

    ; model bounds -> composition metrics (light distance, target height, probe far).
    fn configureFromBounds:void (box:ThreeBox3) {
        def sz:ThreeVector3 (new ThreeVector3)
        box.getSize(sz)
        def ctr:ThreeVector3 (new ThreeVector3)
        box.getCenter(ctr)
        this.sizeX = sz.x
        this.sizeY = sz.y
        this.sizeZ = sz.z
        this.centerX = ctr.x
        this.centerY = ctr.y
        this.centerZ = ctr.z
        this.targetY = (ctr.y + (sz.y * 0.2))
        this.baseDistance = (ThreeSunShadowRig.maxOf2(sz.x sz.z))
        this.probeFar = ((ThreeSunShadowRig.maxOf3(sz.x sz.y sz.z)) * 2.0)
    }

    ; add the sun's shadow TARGET and the bounds-derived ortho extent (done once).
    ; The sun's colour/intensity/castShadow/mapSize come from the reconciled light;
    ; the extent is not something the scene declares, so the rig derives it.
    fn installShadow:void (sun:ThreeDirectionalLight scene:ThreeScene) {
        sun.target.position.set(this.centerX this.targetY this.centerZ)
        scene.add(sun.target)
        def ext:double ((ThreeSunShadowRig.maxOf2(this.sizeX this.sizeZ)) * 0.7)
        sun.shadow.setExtent((0.0 - ext) ext ext (0.0 - ext) 0.1 (this.sizeY * 4.0))
    }

    ; place the sun from azimuth + elevation (scaled by the bounds distance), aim it
    ; at the model centre, and drive the sky's sun uniform to the same direction.
    fn place:void (sun:ThreeDirectionalLight sky:ThreeSky) {
        def azimuthR:double (ThreeMathUtils.degToRad(this.azimuth))
        def elevationR:double (ThreeMathUtils.degToRad(this.elevation))
        def radius:double this.baseDistance
        def horizontal:double ((cos elevationR) * radius)
        def vertical:double ((sin elevationR) * radius)
        def lx:double (this.centerX + ((cos azimuthR) * horizontal))
        def ly:double (this.targetY + vertical)
        def lz:double (this.centerZ + ((sin azimuthR) * horizontal))
        sun.position.set(lx ly lz)
        sun.target.position.set(this.centerX this.targetY this.centerZ)
        sun.target.updateMatrixWorld()

        def sd:ThreeVector3 (new ThreeVector3)
        this.sunDirection(sd)
        sky.copySunPosition(sd)
    }

    ; the sun's unit direction (same convention as the sky uniform) — for a GI bake.
    fn sunDirection:void (out:ThreeVector3) {
        def phi:double (ThreeMathUtils.degToRad(90.0 - this.elevation))
        def theta:double (ThreeMathUtils.degToRad(this.azimuth))
        out.setFromSphericalCoords(1.0 phi theta)
    }
}

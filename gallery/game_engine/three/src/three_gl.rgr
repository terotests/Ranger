#if defined(__APPLE__)
#define GL_SILENCE_DEPRECATION
#include <OpenGL/gl3.h>
#elif defined(__arm__) || defined(__aarch64__)
#include <GLES2/gl2.h>
#else
#define GL_GLEXT_PROTOTYPES 1
#include <GL/gl.h>
#include <GL/glext.h>
#endif
struct RglMesh { GLuint vbo; GLuint ebo; int count; };
struct RglProg { GLuint p; };
static std::vector<RglProg> g_rglProgs;
static std::vector<RglMesh> g_rglMeshes;
static std::vector<GLuint>  g_rglTex;
static std::vector<GLuint>  g_rglCube;
static float g_rglAmb[3]={0,0,0}; static float g_rglDirs[12]={0}; static float g_rglCols[12]={0}; static int g_rglLC=0; static float g_rglCam[3]={0,0,0}; static int g_rglEnv=0;
static float g_rglTone=0; static float g_rglExposure=1;
static int g_rglShadowTex=0; static float g_rglShadowMat[16]={0}; static int g_rglShadowOn=0;
static int g_rglProbeTex=0; static float g_rglProbeH=1; static int g_rglProbeOn=0; static float g_rglProbeCount[3]={1,1,1}; static float g_rglProbeOrigin[3]={0,0,0}; static float g_rglProbeSize[3]={1,1,1};
#ifndef GL_RGBA32F
#define GL_RGBA32F 0x8814
#endif
static GLuint rgl_sh(GLenum t, const char* src){ GLuint s=glCreateShader(t); glShaderSource(s,1,&src,nullptr); glCompileShader(s); return s; }
static int rgl_init(const char* id){ (void)id; return 1; }
static void rgl_begin(int w,int h,double r,double g,double b){ glViewport(0,0,w,h); glClearColor((float)r,(float)g,(float)b,1.0f); glEnable(GL_DEPTH_TEST); glClear(GL_COLOR_BUFFER_BIT|GL_DEPTH_BUFFER_BIT); }
static int rgl_program(std::string vs, std::string fs){ GLuint p=glCreateProgram(); glAttachShader(p, rgl_sh(GL_VERTEX_SHADER, vs.c_str())); glAttachShader(p, rgl_sh(GL_FRAGMENT_SHADER, fs.c_str())); glLinkProgram(p); RglProg e; e.p=p; g_rglProgs.push_back(e); return (int)g_rglProgs.size(); }
static int rgl_mesh(const uint8_t* vb,int vsz,int vc,const uint8_t* ib,int isz,int ic){ (void)vc; RglMesh m; glGenBuffers(1,&m.vbo); glBindBuffer(GL_ARRAY_BUFFER,m.vbo); glBufferData(GL_ARRAY_BUFFER,vsz,vb,GL_STATIC_DRAW); glGenBuffers(1,&m.ebo); glBindBuffer(GL_ELEMENT_ARRAY_BUFFER,m.ebo); glBufferData(GL_ELEMENT_ARRAY_BUFFER,isz,ib,GL_STATIC_DRAW); m.count=ic; g_rglMeshes.push_back(m); return (int)g_rglMeshes.size(); }
static int rgl_texture(const uint8_t* bytes,int w,int h){ GLuint t; glGenTextures(1,&t); glBindTexture(GL_TEXTURE_2D,t); glTexImage2D(GL_TEXTURE_2D,0,GL_RGBA,w,h,0,GL_RGBA,GL_UNSIGNED_BYTE,bytes); glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_S,GL_REPEAT); glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_T,GL_REPEAT); glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MAG_FILTER,GL_LINEAR);
#if (defined(__arm__) || defined(__aarch64__)) && !defined(__APPLE__)
  glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MIN_FILTER,GL_LINEAR);
#else
  glGenerateMipmap(GL_TEXTURE_2D); glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MIN_FILTER,GL_LINEAR_MIPMAP_LINEAR);
#endif
  g_rglTex.push_back(t); return (int)g_rglTex.size(); }
static void rgl_set_lights(const uint8_t* amb,const uint8_t* dirs,const uint8_t* cols,int count){ const float* a=(const float*)amb; const float* d=(const float*)dirs; const float* c=(const float*)cols; g_rglAmb[0]=a[0];g_rglAmb[1]=a[1];g_rglAmb[2]=a[2]; for(int i=0;i<12;i++){ g_rglDirs[i]=d[i]; g_rglCols[i]=c[i]; } g_rglLC=count; }
static void rgl_set_view(double cx,double cy,double cz){ g_rglCam[0]=(float)cx; g_rglCam[1]=(float)cy; g_rglCam[2]=(float)cz; }
static void rgl_set_tone(double m,double e){ g_rglTone=(float)m; g_rglExposure=(float)e; }
static void rgl_set_shadow(int tex,const uint8_t* mat,int on){ g_rglShadowTex=tex; if(mat){ const float* M=(const float*)mat; for(int i=0;i<16;i++) g_rglShadowMat[i]=M[i]; } g_rglShadowOn=(on && tex>0)?1:0; }
static int rgl_float_tex(const uint8_t* bytes,int w,int h){ GLuint t; glGenTextures(1,&t); glBindTexture(GL_TEXTURE_2D,t); const float* data=(const float*)bytes;
#if (defined(__arm__) || defined(__aarch64__)) && !defined(__APPLE__)
  glTexImage2D(GL_TEXTURE_2D,0,GL_RGBA,w,h,0,GL_RGBA,GL_FLOAT,data);
#else
  glTexImage2D(GL_TEXTURE_2D,0,GL_RGBA32F,w,h,0,GL_RGBA,GL_FLOAT,data);

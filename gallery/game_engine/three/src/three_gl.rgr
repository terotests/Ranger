    }
    ; the depth texture handle of a target (sample it in the übershader).
    gpu_target_depth_tex _:int (handle:int) {
        templates {
            es6 ( "__rglTargetDepthTex(" (e 1) ")" )
            cpp ( "rgl_target_depth_tex(" (e 1) ")" )

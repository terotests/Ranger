            cpp ( "rgl_set_probes(" (e 1) ", " (e 2) ", " (e 3) ", " (e 4) ", " (e 5) ", " (e 6) ", " (e 7) ", " (e 8) ", " (e 9) ", " (e 10) ", " (e 11) ", " (e 12) ")" )
        }
    }

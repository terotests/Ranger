; ==============================================================================
; three_gl — GPU primitive operators: ONE Ranger source, WebGL + OpenGL/GLES.
; ==============================================================================
;
; The platform boundary of the Three GPU backend. Each operator has an es6 (WebGL)
; and a cpp (OpenGL/GLES2) template, so the same Ranger code compiles to the
; browser AND to native, with no hand-written .js. Opaque int handles bridge the
; representation gap (WebGL objects in JS arrays ↔ GLuint in std::vector).
;
; Lighting model (übershader in three_gl_shaders.rgr): set once per frame with
; gpu_set_lights (ambient + directional) and gpu_set_view (camera pos); each mesh
; is drawn with gpu_draw, passing its model + MVP and a 10-float material buffer
; [colR,colG,colB, specR,specG,specB, shininess, shading, side, hasTex].
;
; Vertex layout expected by gpu_make_mesh: interleaved float32 [px,py,pz, nx,ny,nz,
; u,v] (32-byte stride); indices are uint32; matrices are 16 float32.
; ==============================================================================

operators {

    ; Acquire a context. es6: WebGL2/1 on the canvas with the given id. cpp: the
    ; GL context is created by the host (SDL) and assumed current -> returns 1.
    gpu_init _:int (canvasId:string) {

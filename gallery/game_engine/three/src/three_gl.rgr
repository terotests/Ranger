    gpu_draw_depth _:void (prog:int mesh:int mvp:buffer) {
        templates {
            es6 ( "__rglDrawDepth(" (e 1) ", " (e 2) ", " (e 3) ")" )
            cpp ( "rgl_draw_depth(" (e 1) ", " (e 2) ", " (e 3) ".data())" )
        }
    }

    ; feed the shadow map to the übershader for subsequent lit draws: the depth
    ; texture handle, the light view-projection (uShadowMatrix), and an enable flag.
    ; tex=0 (or enabled=false) turns shadowing off.
    gpu_set_shadow _:void (depthTex:int mat:buffer enabled:int) {

static const GLenum RGL_DEPTH_INTERNAL = GL_DEPTH_COMPONENT24;
static const GLenum RGL_DEPTH_TYPE = GL_UNSIGNED_INT;
#endif
#if (defined(__arm__) || defined(__aarch64__)) && !defined(__APPLE__)
#ifndef GL_RGBA8
#define GL_RGBA8 0x8058
#endif
static const GLenum RGL_RGBA8 = GL_RGBA8;
#else
static const GLenum RGL_RGBA8 = GL_RGBA8;
#endif
static int rgl_make_depth_target(int size){
  RglTarget t; t.size=size;
  glGenTextures(1,&t.depthTex); glBindTexture(GL_TEXTURE_2D,t.depthTex);
  glTexImage2D(GL_TEXTURE_2D,0,RGL_DEPTH_INTERNAL,size,size,0,GL_DEPTH_COMPONENT,RGL_DEPTH_TYPE,nullptr);
  glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MIN_FILTER,GL_NEAREST);
  glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MAG_FILTER,GL_NEAREST);
  glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_S,GL_CLAMP_TO_EDGE);
  glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_T,GL_CLAMP_TO_EDGE);
  glGenRenderbuffers(1,&t.colorRb); glBindRenderbuffer(GL_RENDERBUFFER,t.colorRb);
  glRenderbufferStorage(GL_RENDERBUFFER,RGL_RGBA8,size,size);
  glGenFramebuffers(1,&t.fb); glBindFramebuffer(GL_FRAMEBUFFER,t.fb);
  glFramebufferTexture2D(GL_FRAMEBUFFER,GL_DEPTH_ATTACHMENT,GL_TEXTURE_2D,t.depthTex,0);
  glFramebufferRenderbuffer(GL_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_RENDERBUFFER,t.colorRb);
  glBindFramebuffer(GL_FRAMEBUFFER,0);
  g_rglTex.push_back(t.depthTex); t.depthTexId=(int)g_rglTex.size();
  g_rglTargets.push_back(t);
  return (int)g_rglTargets.size();
}
static void rgl_bind_target(int h){ if(h<1) return; RglTarget t=g_rglTargets[h-1]; glBindFramebuffer(GL_FRAMEBUFFER,t.fb); glViewport(0,0,t.size,t.size); glClearColor(1,1,1,1); glClear(GL_COLOR_BUFFER_BIT|GL_DEPTH_BUFFER_BIT); }
static void rgl_bind_screen(int w,int h){ glBindFramebuffer(GL_FRAMEBUFFER,0); glViewport(0,0,w,h); }
static int rgl_target_depth_tex(int h){ if(h<1) return 0; return g_rglTargets[h-1].depthTexId; }
static std::vector<uint8_t> rgl_read_target(int h,int size){ std::vector<uint8_t> px; if(h<1) return px; RglTarget t=g_rglTargets[h-1]; px.resize((size_t)size*size*4); glBindFramebuffer(GL_FRAMEBUFFER,t.fb); glReadPixels(0,0,size,size,GL_RGBA,GL_UNSIGNED_BYTE,px.data()); glBindFramebuffer(GL_FRAMEBUFFER,0); return px; }
") )
        }
    }
    ; bind a render target (draws go into it) / restore the screen framebuffer.
    gpu_bind_target _:void (handle:int) {
        templates {
            es6 ( "__rglBindTarget(" (e 1) ")" )
            cpp ( "rgl_bind_target(" (e 1) ")" )
        }

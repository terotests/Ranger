        }
    }
    gpu_update_float_tex _:void (handle:int bytes:buffer w:int h:int) {
        templates {
            es6 ( "__rglUpdateFloatTex(" (e 1) ", " (e 2) ", " (e 3) ", " (e 4) ")" )
            cpp ( "rgl_update_float_tex(" (e 1) ", " (e 2) ".data(), " (e 3) ", " (e 4) ")" )
        }
    }
    ; select the probe volume for the lit pass: SH texture handle + row count, grid
    ; counts (cx,cy,cz), world origin (grid centre) + size, and an enable flag.
    gpu_set_probes _:void (tex:int texH:double cx:double cy:double cz:double ox:double oy:double oz:double sx:double sy:double sz:double enabled:int) {
        templates {

; ==============================================================================
; three_box_geometry — (Three.js port of src/geometries/BoxGeometry.js).
; ==============================================================================
; A box centred at the origin: 6 faces, 24 vertices, 36 indices, with per-face
; normals and 0..1 UVs (segments = 1, matching `new THREE.BoxGeometry()`).
; ==============================================================================

Import "three_buffer_geometry.rgr"

class ThreeBoxGeometry extends ThreeBufferGeometry {
    def isBoxGeometry:boolean true

    ; one face: corners a,b,c,d CCW seen from outside; uv a(0,0) b(1,0) c(1,1) d(0,1).
    fn addQuad:void (ax:double ay:double az:double bx:double by:double bz:double cx:double cy:double cz:double dx:double dy:double dz:double nx:double ny:double nz:double) {
        def base:int (this.vertexCount())
        this.pushVertex(ax ay az nx ny nz 0.0 0.0)
        this.pushVertex(bx by bz nx ny nz 1.0 0.0)
        this.pushVertex(cx cy cz nx ny nz 1.0 1.0)
        this.pushVertex(dx dy dz nx ny nz 0.0 1.0)
        this.pushTriangle(base (base + 1) (base + 2))
        this.pushTriangle(base (base + 2) (base + 3))
    }

    ; `new THREE.BoxGeometry(width, height, depth)` — call setSize after new.
    fn setSize:ThreeBoxGeometry (width:double height:double depth:double) {
        def hx:double (width * 0.5)
        def hy:double (height * 0.5)
        def hz:double (depth * 0.5)
        def nhx:double (0.0 - hx)
        def nhy:double (0.0 - hy)
        def nhz:double (0.0 - hz)

        ; +Z
        this.addQuad(nhx nhy hz  hx nhy hz  hx hy hz  nhx hy hz  0.0 0.0 1.0)
        ; -Z
        this.addQuad(hx nhy nhz  nhx nhy nhz  nhx hy nhz  hx hy nhz  0.0 0.0 (0.0 - 1.0))
        ; +X
        this.addQuad(hx nhy hz  hx nhy nhz  hx hy nhz  hx hy hz  1.0 0.0 0.0)
        ; -X
        this.addQuad(nhx nhy nhz  nhx nhy hz  nhx hy hz  nhx hy nhz  (0.0 - 1.0) 0.0 0.0)
        ; +Y
        this.addQuad(nhx hy hz  hx hy hz  hx hy nhz  nhx hy nhz  0.0 1.0 0.0)
        ; -Y
        this.addQuad(nhx nhy nhz  hx nhy nhz  hx nhy hz  nhx nhy hz  0.0 (0.0 - 1.0) 0.0)
        return this
    }
}

; SPDX-License-Identifier: AGPL-3.0-or-later

; ==============================================================================
; three_evg_vector_backend — project Three meshes to EVG vector polygons.
; ==============================================================================
;
; Drop-in ThreeRenderBackend: projects triangles to 2D and stores them as
; gradient-filled polygons (painter's algorithm). Lighting is Lambert
; (ambient + directional) from setLights(); each polygon gets a two-stop
; linearGradient along the face toward the light — SVG-native for print.
;
; Textured triangles are UV-subdivided into per-texel polygons; each texel
; inherits the parent face's lit gradient axis.
; ==============================================================================

Import "three_render_backend.rgr"
Import "three_buffer_geometry.rgr"
Import "three_matrix4.rgr"
Import "three_texture.rgr"
Import "three_material.rgr"
Import "three_vector3.rgr"
Import "../../../evg/EVGColor.rgr"
Import "../../../evg/EVGDisplayList.rgr"
Import "../../../pdf_writer/src/raster/RasterBuffer.rgr"
Import "../../../pdf_writer/src/raster/VectorRasterizer.rgr"

class ThreeEvgVectorBackend extends ThreeRenderBackend {
    def w:int 0
    def h:int 0
    def clearR:double 0.086
    def clearG:double 0.102
    def clearB:double 0.133
    def ox:double 0.0
    def oy:double 0.0
    ; Lights from setLights (same contract as the GL backend).
    def ambR:double 0.35
    def ambG:double 0.35
    def ambB:double 0.35
    def dirCount:int 0
    def dirs:[double]
    def cols:[double]
    ; Triangle list: geometry + two-stop linear gradient (user-space).
    def tx0:[double]
    def ty0:[double]
    def tx1:[double]
    def ty1:[double]
    def tx2:[double]
    def ty2:[double]
    def tDepth:[double]
    def gx1:[double]
    def gy1:[double]
    def gx2:[double]
    def gy2:[double]
    def tR1:[int]
    def tG1:[int]
    def tB1:[int]
    def tR2:[int]
    def tG2:[int]
    def tB2:[int]
    def triCount:int 0

    fn setOffset:void (x:double y:double) {
        ox = x
        oy = y
    }

    fn setLights:void (aR:double aG:double aB:double count:int d:[double] c:[double]) {
        ambR = aR
        ambG = aG
        ambB = aB
        ; Soft default ambient when the scene has no lights yet.
        if (((aR + aG) + aB) < 0.0001) {
            if (count == 0) {
                ambR = 0.45
                ambG = 0.45
                ambB = 0.48
            }
        }
        dirCount = count
        dirs = d
        cols = c
    }

    fn beginFrame:void (width:int height:int r:double g:double b:double) {
        w = width
        h = height
        clearR = r
        clearG = g
        clearB = b
        def e0:[double]
        def e1:[double]
        def e2:[double]
        def e3:[double]
        def e4:[double]
        def e5:[double]
        def ed:[double]
        def egx1:[double]
        def egy1:[double]
        def egx2:[double]
        def egy2:[double]
        def er1:[int]
        def eg1:[int]
        def eb1:[int]
        def er2:[int]
        def eg2:[int]
        def eb2:[int]
        tx0 = e0
        ty0 = e1
        tx1 = e2
        ty1 = e3
        tx2 = e4
        ty2 = e5
        tDepth = ed
        gx1 = egx1
        gy1 = egy1
        gx2 = egx2
        gy2 = egy2
        tR1 = er1
        tG1 = eg1
        tB1 = eb1
        tR2 = er2
        tG2 = eg2
        tB2 = eb2
        triCount = 0
    }

    fn clamp01:double (v:double) {
        if (v < 0.0) {
            return 0.0
        }
        if (v > 1.0) {
            return 1.0
        }
        return v
    }

    fn toByte:int (v:double) {
        return (to_int ((this.clamp01(v)) * 255.0))
    }

    ; Transform a normal by the model's upper 3×3 and normalise.
    fn transformNormal:void (model:ThreeMatrix4 nx:double ny:double nz:double out:[double]) {
        def e0:double (model.eGet(0))
        def e1:double (model.eGet(1))
        def e2:double (model.eGet(2))
        def e4:double (model.eGet(4))
        def e5:double (model.eGet(5))
        def e6:double (model.eGet(6))
        def e8:double (model.eGet(8))
        def e9:double (model.eGet(9))
        def e10:double (model.eGet(10))
        def wx:double (((e0 * nx) + (e4 * ny)) + (e8 * nz))
        def wy:double (((e1 * nx) + (e5 * ny)) + (e9 * nz))
        def wz:double (((e2 * nx) + (e6 * ny)) + (e10 * nz))
        def len:double (sqrt(((wx * wx) + (wy * wy)) + (wz * wz)))
        if (len < 0.000001) {
            len = 1.0
        }
        clear out
        push out (wx / len)
        push out (wy / len)
        push out (wz / len)
    }

    ; Lambert shade factor per channel (ambient + N·L lights), times base 0..1.
    fn shadeR:double (nx:double ny:double nz:double base:double) {
        def s:double (ambR * base)
        def i:int 0
        while (i < dirCount) {
            def dx:double (itemAt dirs (i * 3))
            def dy:double (itemAt dirs ((i * 3) + 1))
            def dz:double (itemAt dirs ((i * 3) + 2))
            def nd:double (((nx * dx) + (ny * dy)) + (nz * dz))
            if (nd > 0.0) {
                s = (s + ((itemAt cols (i * 3)) * nd * base))
            }
            i = (i + 1)
        }
        return (this.clamp01(s))
    }

    fn shadeG:double (nx:double ny:double nz:double base:double) {
        def s:double (ambG * base)
        def i:int 0
        while (i < dirCount) {
            def dx:double (itemAt dirs (i * 3))
            def dy:double (itemAt dirs ((i * 3) + 1))
            def dz:double (itemAt dirs ((i * 3) + 2))
            def nd:double (((nx * dx) + (ny * dy)) + (nz * dz))
            if (nd > 0.0) {
                s = (s + ((itemAt cols ((i * 3) + 1)) * nd * base))
            }
            i = (i + 1)
        }
        return (this.clamp01(s))
    }

    fn shadeB:double (nx:double ny:double nz:double base:double) {
        def s:double (ambB * base)
        def i:int 0
        while (i < dirCount) {
            def dx:double (itemAt dirs (i * 3))
            def dy:double (itemAt dirs ((i * 3) + 1))
            def dz:double (itemAt dirs ((i * 3) + 2))
            def nd:double (((nx * dx) + (ny * dy)) + (nz * dz))
            if (nd > 0.0) {
                s = (s + ((itemAt cols ((i * 3) + 2)) * nd * base))
            }
            i = (i + 1)
        }
        return (this.clamp01(s))
    }

    ; Shadow-side stop: ambient + a fraction of the directional term.
    fn shadeRWeak:double (nx:double ny:double nz:double base:double nd:double) {
        def s:double (ambR * base)
        def i:int 0
        while (i < dirCount) {
            s = (s + ((itemAt cols (i * 3)) * nd * 0.35 * base))
            i = (i + 1)
        }
        return (this.clamp01(s))
    }

    fn shadeGWeak:double (nx:double ny:double nz:double base:double nd:double) {
        def s:double (ambG * base)
        def i:int 0
        while (i < dirCount) {
            s = (s + ((itemAt cols ((i * 3) + 1)) * nd * 0.35 * base))
            i = (i + 1)
        }
        return (this.clamp01(s))
    }

    fn shadeBWeak:double (nx:double ny:double nz:double base:double nd:double) {
        def s:double (ambB * base)
        def i:int 0
        while (i < dirCount) {
            s = (s + ((itemAt cols ((i * 3) + 2)) * nd * 0.35 * base))
            i = (i + 1)
        }
        return (this.clamp01(s))
    }

    ; Primary light direction (toward the light); default (0.4, 0.8, 0.5).
    fn lightDirX:double () {
        if (dirCount > 0) {
            return (itemAt dirs 0)
        }
        return 0.4
    }

    fn lightDirY:double () {
        if (dirCount > 0) {
            return (itemAt dirs 1)
        }
        return 0.8
    }

    fn lightDirZ:double () {
        if (dirCount > 0) {
            return (itemAt dirs 2)
        }
        return 0.5
    }

    fn pushGradTri:void (x0:double y0:double x1:double y1:double x2:double y2:double depth:double ax:double ay:double bx:double by:double r1:int g1:int b1:int r2:int g2:int b2:int) {
        push tx0 x0
        push ty0 y0
        push tx1 x1
        push ty1 y1
        push tx2 x2
        push ty2 y2
        push tDepth depth
        push gx1 ax
        push gy1 ay
        push gx2 bx
        push gy2 by
        push tR1 r1
        push tG1 g1
        push tB1 b1
        push tR2 r2
        push tG2 g2
        push tB2 b2
        triCount = (triCount + 1)
    }

    ; Fan a convex poly into triangles; all share the same lighting gradient.
    fn pushGradPoly:void (pts:[double] depth:double ax:double ay:double bx:double by:double r1:int g1:int b1:int r2:int g2:int b2:int) {
        def n:int (idiv (array_length pts) 2)
        if (n < 3) {
            return
        }
        def i:int 1
        while ((i + 1) < n) {
            this.pushGradTri((itemAt pts 0) (itemAt pts 1) (itemAt pts (i * 2)) (itemAt pts ((i * 2) + 1)) (itemAt pts ((i + 1) * 2)) (itemAt pts (((i + 1) * 2) + 1)) depth ax ay bx by r1 g1 b1 r2 g2 b2)
            i = (i + 1)
        }
    }

    ; Build a face lighting gradient: darker stop opposite the light, lit stop
    ; toward it. Uses N·L for overall brightness and world-position along L for
    ; the gradient axis (so flat-normal faces still get a soft ramp).
    fn emitLitPoly:void (pts:[double] depth:double nx:double ny:double nz:double wx0:double wy0:double wz0:double wx1:double wy1:double wz1:double wx2:double wy2:double wz2:double sx0:double sy0:double sx1:double sy1:double sx2:double sy2:double br:double bg:double bb:double) {
        def ldx:double (this.lightDirX())
        def ldy:double (this.lightDirY())
        def ldz:double (this.lightDirZ())
        def s0:double (((wx0 * ldx) + (wy0 * ldy)) + (wz0 * ldz))
        def s1:double (((wx1 * ldx) + (wy1 * ldy)) + (wz1 * ldz))
        def s2:double (((wx2 * ldx) + (wy2 * ldy)) + (wz2 * ldz))
        def sMin:double s0
        def sMax:double s0
        def ax:double sx0
        def ay:double sy0
        def bx:double sx0
        def by:double sy0
        if (s1 < sMin) {
            sMin = s1
            ax = sx1
            ay = sy1
        }
        if (s2 < sMin) {
            sMin = s2
            ax = sx2
            ay = sy2
        }
        if (s1 > sMax) {
            sMax = s1
            bx = sx1
            by = sy1
        }
        if (s2 > sMax) {
            sMax = s2
            bx = sx2
            by = sy2
        }
        ; Lit amount at the dark / bright ends of the face (soft ramp).
        def nd:double (((nx * ldx) + (ny * ldy)) + (nz * ldz))
        if (nd < 0.0) {
            nd = 0.0
        }
        ; Two-stop Lambert: shadowed side uses a weaker directional term.
        def sR1:double (this.shadeRWeak(nx ny nz br nd))
        def sG1:double (this.shadeGWeak(nx ny nz bg nd))
        def sB1:double (this.shadeBWeak(nx ny nz bb nd))
        def sR2:double (this.shadeR(nx ny nz br))
        def sG2:double (this.shadeG(nx ny nz bg))
        def sB2:double (this.shadeB(nx ny nz bb))
        def r1:int (this.toByte(sR1))
        def g1:int (this.toByte(sG1))
        def b1:int (this.toByte(sB1))
        def r2:int (this.toByte(sR2))
        def g2:int (this.toByte(sG2))
        def b2:int (this.toByte(sB2))
        ; Degenerate axis → flat average colour.
        def gdx:double (bx - ax)
        def gdy:double (by - ay)
        if (((gdx * gdx) + (gdy * gdy)) < 0.25) {
            ax = sx0
            ay = sy0
            bx = sx1
            by = sy1
            def ar:int (idiv (r1 + r2) 2)
            def ag:int (idiv (g1 + g2) 2)
            def ab:int (idiv (b1 + b2) 2)
            r1 = ar
            g1 = ag
            b1 = ab
            r2 = ar
            g2 = ag
            b2 = ab
        }
        this.pushGradPoly(pts depth ax ay bx by r1 g1 b1 r2 g2 b2)
    }

    fn uvToScreenX:double (u:double v:double u0:double v0:double u1:double v1:double u2:double v2:double x0:double x1:double x2:double) {
        def den:double (((u1 - u0) * (v2 - v0)) - ((u2 - u0) * (v1 - v0)))
        if ((den < 0.0000001) && (den > (0.0 - 0.0000001))) {
            return x0
        }
        def w1:double ((((u - u0) * (v2 - v0)) - ((u2 - u0) * (v - v0))) / den)
        def w2:double ((((u1 - u0) * (v - v0)) - ((u - u0) * (v1 - v0))) / den)
        def w0:double ((1.0 - w1) - w2)
        return (((w0 * x0) + (w1 * x1)) + (w2 * x2))
    }

    fn uvToScreenY:double (u:double v:double u0:double v0:double u1:double v1:double u2:double v2:double y0:double y1:double y2:double) {
        def den:double (((u1 - u0) * (v2 - v0)) - ((u2 - u0) * (v1 - v0)))
        if ((den < 0.0000001) && (den > (0.0 - 0.0000001))) {
            return y0
        }
        def w1:double ((((u - u0) * (v2 - v0)) - ((u2 - u0) * (v - v0))) / den)
        def w2:double ((((u1 - u0) * (v - v0)) - ((u - u0) * (v1 - v0))) / den)
        def w0:double ((1.0 - w1) - w2)
        return (((w0 * y0) + (w1 * y1)) + (w2 * y2))
    }

    fn clipUv:void (src:[double] dst:[double] axis:int keepLess:boolean limit:double) {
        clear dst
        def n:int (idiv (array_length src) 2)
        if (n == 0) {
            return
        }
        def i:int 0
        while (i < n) {
            def j:int (i + 1)
            if (j >= n) {
                j = 0
            }
            def ax:double (itemAt src (i * 2))
            def ay:double (itemAt src ((i * 2) + 1))
            def bx:double (itemAt src (j * 2))
            def by:double (itemAt src ((j * 2) + 1))
            def aVal:double ax
            def bVal:double bx
            if (axis == 1) {
                aVal = ay
                bVal = by
            }
            def aIn:boolean false
            def bIn:boolean false
            if keepLess {
                if (aVal <= (limit + 0.0000001)) {
                    aIn = true
                }
                if (bVal <= (limit + 0.0000001)) {
                    bIn = true
                }
            } {
                if (aVal >= (limit - 0.0000001)) {
                    aIn = true
                }
                if (bVal >= (limit - 0.0000001)) {
                    bIn = true
                }
            }
            if aIn {
                if bIn {
                    push dst bx
                    push dst by
                } {
                    def t:double 0.0
                    def den:double (bVal - aVal)
                    if ((den > 0.0000001) || (den < (0.0 - 0.0000001))) {
                        t = ((limit - aVal) / den)
                    }
                    push dst (ax + (t * (bx - ax)))
                    push dst (ay + (t * (by - ay)))
                }
            } {
                if bIn {
                    def t2:double 0.0
                    def den2:double (bVal - aVal)
                    if ((den2 > 0.0000001) || (den2 < (0.0 - 0.0000001))) {
                        t2 = ((limit - aVal) / den2)
                    }
                    push dst (ax + (t2 * (bx - ax)))
                    push dst (ay + (t2 * (by - ay)))
                    push dst bx
                    push dst by
                }
            }
            i = (i + 1)
        }
    }

    fn emitTexelPoly:void (u0:double v0:double u1:double v1:double u2:double v2:double x0:double y0:double x1:double y1:double x2:double y2:double depth:double nx:double ny:double nz:double wx0:double wy0:double wz0:double wx1:double wy1:double wz1:double wx2:double wy2:double wz2:double uMin:double uMax:double vMin:double vMax:double br:double bg:double bb:double) {
        def poly:[double]
        push poly u0
        push poly v0
        push poly u1
        push poly v1
        push poly u2
        push poly v2
        def tmp:[double]
        this.clipUv(poly tmp 0 false uMin)
        this.clipUv(tmp poly 0 true uMax)
        this.clipUv(poly tmp 1 false vMin)
        this.clipUv(tmp poly 1 true vMax)
        def n:int (idiv (array_length poly) 2)
        if (n < 3) {
            return
        }
        def screen:[double]
        def i:int 0
        while (i < n) {
            def uu:double (itemAt poly (i * 2))
            def vv:double (itemAt poly ((i * 2) + 1))
            push screen (this.uvToScreenX(uu vv u0 v0 u1 v1 u2 v2 x0 x1 x2))
            push screen (this.uvToScreenY(uu vv u0 v0 u1 v1 u2 v2 y0 y1 y2))
            i = (i + 1)
        }
        this.emitLitPoly(screen depth nx ny nz wx0 wy0 wz0 wx1 wy1 wz1 wx2 wy2 wz2 x0 y0 x1 y1 x2 y2 br bg bb)
    }

    fn emitTexturedTri:void (tex:ThreeTexture model:ThreeMatrix4 u0:double v0:double u1:double v1:double u2:double v2:double x0:double y0:double x1:double y1:double x2:double y2:double depth:double nx:double ny:double nz:double wx0:double wy0:double wz0:double wx1:double wy1:double wz1:double wx2:double wy2:double wz2:double colorR:double colorG:double colorB:double) {
        def tw:int tex.width
        def th:int tex.height
        if ((tw <= 0) || (th <= 0)) {
            def pts:[double]
            push pts x0
            push pts y0
            push pts x1
            push pts y1
            push pts x2
            push pts y2
            this.emitLitPoly(pts depth nx ny nz wx0 wy0 wz0 wx1 wy1 wz1 wx2 wy2 wz2 x0 y0 x1 y1 x2 y2 colorR colorG colorB)
            return
        }
        def minU:double u0
        if (u1 < minU) { minU = u1 }
        if (u2 < minU) { minU = u2 }
        def maxU:double u0
        if (u1 > maxU) { maxU = u1 }
        if (u2 > maxU) { maxU = u2 }
        def minV:double v0
        if (v1 < minV) { minV = v1 }
        if (v2 < minV) { minV = v2 }
        def maxV:double v0
        if (v1 > maxV) { maxV = v1 }
        if (v2 > maxV) { maxV = v2 }
        if (minU < 0.0) { minU = 0.0 }
        if (minV < 0.0) { minV = 0.0 }
        if (maxU > 1.0) { maxU = 1.0 }
        if (maxV > 1.0) { maxV = 1.0 }
        def ix0:int (to_int (minU * (to_double tw)))
        def ix1:int (to_int (maxU * (to_double tw)))
        def iy0:int (to_int (minV * (to_double th)))
        def iy1:int (to_int (maxV * (to_double th)))
        if (ix0 < 0) { ix0 = 0 }
        if (iy0 < 0) { iy0 = 0 }
        if (ix1 >= tw) { ix1 = (tw - 1) }
        if (iy1 >= th) { iy1 = (th - 1) }
        def iy:int iy0
        while (iy <= iy1) {
            def ix:int ix0
            while (ix <= ix1) {
                def uMin:double ((to_double ix) / (to_double tw))
                def uMax:double ((to_double (ix + 1)) / (to_double tw))
                def vMin:double ((to_double iy) / (to_double th))
                def vMax:double ((to_double (iy + 1)) / (to_double th))
                def off:int (((iy * tw) + ix) * 4)
                def tr:double ((to_double (buffer_get tex.rgba off)) / 255.0)
                def tg:double ((to_double (buffer_get tex.rgba (off + 1))) / 255.0)
                def tb:double ((to_double (buffer_get tex.rgba (off + 2))) / 255.0)
                this.emitTexelPoly(u0 v0 u1 v1 u2 v2 x0 y0 x1 y1 x2 y2 depth nx ny nz wx0 wy0 wz0 wx1 wy1 wz1 wx2 wy2 wz2 uMin uMax vMin vMax (colorR * tr) (colorG * tg) (colorB * tb))
                ix = (ix + 1)
            }
            iy = (iy + 1)
        }
    }

    fn drawMesh:void (geometry:ThreeBufferGeometry model:ThreeMatrix4 mvp:ThreeMatrix4 mat:ThreeMaterial) {
        def vc:int (geometry.vertexCount())
        if (vc == 0) {
            return
        }
        def hasTexture:boolean mat.hasMap
        def tex:ThreeTexture mat.map
        def colorR:double mat.colorR
        def colorG:double mat.colorG
        def colorB:double mat.colorB
        def sx:[double]
        def sy:[double]
        def sz:[double]
        def wx:[double]
        def wy:[double]
        def wz:[double]
        def bad:[int]
        def vi:int 0
        while (vi < vc) {
            def lx:double (geometry.getPosition(vi 0))
            def ly:double (geometry.getPosition(vi 1))
            def lz:double (geometry.getPosition(vi 2))
            def cw:double (mvp.clipW(lx ly lz))
            def ndc:ThreeVector3 (mvp.transformPoint((ThreeVector3.of(lx ly lz))))
            def world:ThreeVector3 (model.transformPoint((ThreeVector3.of(lx ly lz))))
            def screenX:double ((((ndc.x * 0.5) + 0.5) * (to_double w)) + ox)
            def screenY:double (((1.0 - ((ndc.y * 0.5) + 0.5)) * (to_double h)) + oy)
            push sx screenX
            push sy screenY
            push sz ndc.z
            push wx world.x
            push wy world.y
            push wz world.z
            if (cw <= 0.0) {
                push bad 1
            } {
                push bad 0
            }
            vi = (vi + 1)
        }
        def ic:int (geometry.indexCount())
        def t:int 0
        while (t < ic) {
            def i0:int (geometry.getIndex(t))
            def i1:int (geometry.getIndex(t + 1))
            def i2:int (geometry.getIndex(t + 2))
            if ((((itemAt bad i0) + (itemAt bad i1)) + (itemAt bad i2)) == 0) {
                def x0:double (itemAt sx i0)
                def y0:double (itemAt sy i0)
                def z0:double (itemAt sz i0)
                def x1:double (itemAt sx i1)
                def y1:double (itemAt sy i1)
                def z1:double (itemAt sz i1)
                def x2:double (itemAt sx i2)
                def y2:double (itemAt sy i2)
                def z2:double (itemAt sz i2)
                def area:double (((x1 - x0) * (y2 - y0)) - ((x2 - x0) * (y1 - y0)))
                if ((area > 0.0001) || (area < (0.0 - 0.0001))) {
                    def depth:double (((z0 + z1) + z2) / 3.0)
                    def nout:[double]
                    ; Face normal from first vertex (box faces share one normal).
                    this.transformNormal(model (geometry.getNormal(i0 0)) (geometry.getNormal(i0 1)) (geometry.getNormal(i0 2)) nout)
                    def nx:double (itemAt nout 0)
                    def ny:double (itemAt nout 1)
                    def nz:double (itemAt nout 2)
                    def wx0:double (itemAt wx i0)
                    def wy0:double (itemAt wy i0)
                    def wz0:double (itemAt wz i0)
                    def wx1:double (itemAt wx i1)
                    def wy1:double (itemAt wy i1)
                    def wz1:double (itemAt wz i1)
                    def wx2:double (itemAt wx i2)
                    def wy2:double (itemAt wy i2)
                    def wz2:double (itemAt wz i2)
                    if hasTexture {
                        this.emitTexturedTri(tex model (geometry.getUv(i0 0)) (geometry.getUv(i0 1)) (geometry.getUv(i1 0)) (geometry.getUv(i1 1)) (geometry.getUv(i2 0)) (geometry.getUv(i2 1)) x0 y0 x1 y1 x2 y2 depth nx ny nz wx0 wy0 wz0 wx1 wy1 wz1 wx2 wy2 wz2 colorR colorG colorB)
                    } {
                        def pts:[double]
                        push pts x0
                        push pts y0
                        push pts x1
                        push pts y1
                        push pts x2
                        push pts y2
                        this.emitLitPoly(pts depth nx ny nz wx0 wy0 wz0 wx1 wy1 wz1 wx2 wy2 wz2 x0 y0 x1 y1 x2 y2 colorR colorG colorB)
                    }
                }
            }
            t = (t + 3)
        }
    }

    fn sortBackToFront:void () {
        def i:int 1
        while (i < triCount) {
            def j:int i
            while (j > 0) {
                def dCur:double (itemAt tDepth j)
                def dPrev:double (itemAt tDepth (j - 1))
                if (dCur <= dPrev) {
                    j = 0
                } {
                    this.swapTri(j (j - 1))
                    j = (j - 1)
                }
            }
            i = (i + 1)
        }
    }

    fn swapTri:void (a:int b:int) {
        def ax0:double (itemAt tx0 a)
        def ay0:double (itemAt ty0 a)
        def ax1:double (itemAt tx1 a)
        def ay1:double (itemAt ty1 a)
        def ax2:double (itemAt tx2 a)
        def ay2:double (itemAt ty2 a)
        def ad:double (itemAt tDepth a)
        def agx1:double (itemAt gx1 a)
        def agy1:double (itemAt gy1 a)
        def agx2:double (itemAt gx2 a)
        def agy2:double (itemAt gy2 a)
        def ar1:int (itemAt tR1 a)
        def ag1:int (itemAt tG1 a)
        def ab1:int (itemAt tB1 a)
        def ar2:int (itemAt tR2 a)
        def ag2:int (itemAt tG2 a)
        def ab2:int (itemAt tB2 a)
        set tx0 a (itemAt tx0 b)
        set ty0 a (itemAt ty0 b)
        set tx1 a (itemAt tx1 b)
        set ty1 a (itemAt ty1 b)
        set tx2 a (itemAt tx2 b)
        set ty2 a (itemAt ty2 b)
        set tDepth a (itemAt tDepth b)
        set gx1 a (itemAt gx1 b)
        set gy1 a (itemAt gy1 b)
        set gx2 a (itemAt gx2 b)
        set gy2 a (itemAt gy2 b)
        set tR1 a (itemAt tR1 b)
        set tG1 a (itemAt tG1 b)
        set tB1 a (itemAt tB1 b)
        set tR2 a (itemAt tR2 b)
        set tG2 a (itemAt tG2 b)
        set tB2 a (itemAt tB2 b)
        set tx0 b ax0
        set ty0 b ay0
        set tx1 b ax1
        set ty1 b ay1
        set tx2 b ax2
        set ty2 b ay2
        set tDepth b ad
        set gx1 b agx1
        set gy1 b agy1
        set gx2 b agx2
        set gy2 b agy2
        set tR1 b ar1
        set tG1 b ag1
        set tB1 b ab1
        set tR2 b ar2
        set tG2 b ag2
        set tB2 b ab2
    }

    fn clearColor:EVGColor () {
        return (EVGColor.rgb((to_int (clearR * 255.0)) (to_int (clearG * 255.0)) (to_int (clearB * 255.0))))
    }

    fn toDisplayList:EVGDisplayList (pageW:double pageH:double) {
        this.sortBackToFront()
        def dl:EVGDisplayList (new EVGDisplayList)
        def bg:EVGColor (EVGColor.rgb(255 255 255))
        dl.addRect(0.0 0.0 pageW pageH bg)
        def sceneBg:EVGColor (this.clearColor())
        dl.addRect(ox oy (to_double w) (to_double h) sceneBg)
        def i:int 0
        while (i < triCount) {
            def pts:[double]
            push pts (itemAt tx0 i)
            push pts (itemAt ty0 i)
            push pts (itemAt tx1 i)
            push pts (itemAt ty1 i)
            push pts (itemAt tx2 i)
            push pts (itemAt ty2 i)
            ; Display-list PATH has no gradient yet — emit mid colour.
            def mr:int (idiv ((itemAt tR1 i) + (itemAt tR2 i)) 2)
            def mg:int (idiv ((itemAt tG1 i) + (itemAt tG2 i)) 2)
            def mb:int (idiv ((itemAt tB1 i) + (itemAt tB2 i)) 2)
            def col:EVGColor (EVGColor.rgb(mr mg mb))
            dl.addPolygon(pts col)
            i = (i + 1)
        }
        return dl
    }

    fn toSvg:string (pageW:double pageH:double) {
        this.sortBackToFront()
        def out:string ("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"" + (EVGDisplayList.num(pageW)) + "\" height=\"" + (EVGDisplayList.num(pageH)) + "\" viewBox=\"0 0 " + (EVGDisplayList.num(pageW)) + " " + (EVGDisplayList.num(pageH)) + "\">\n")
        out = (out + "<defs>\n")
        def i:int 0
        while (i < triCount) {
            def id:string ("lg" + (to_string i))
            out = (out + "<linearGradient id=\"" + id + "\" gradientUnits=\"userSpaceOnUse\"")
            out = (out + " x1=\"" + (EVGDisplayList.num((itemAt gx1 i))) + "\" y1=\"" + (EVGDisplayList.num((itemAt gy1 i))) + "\"")
            out = (out + " x2=\"" + (EVGDisplayList.num((itemAt gx2 i))) + "\" y2=\"" + (EVGDisplayList.num((itemAt gy2 i))) + "\">")
            out = (out + "<stop offset=\"0\" stop-color=\"rgb(" + (to_string (itemAt tR1 i)) + "," + (to_string (itemAt tG1 i)) + "," + (to_string (itemAt tB1 i)) + ")\"/>")
            out = (out + "<stop offset=\"1\" stop-color=\"rgb(" + (to_string (itemAt tR2 i)) + "," + (to_string (itemAt tG2 i)) + "," + (to_string (itemAt tB2 i)) + ")\"/>")
            out = (out + "</linearGradient>\n")
            i = (i + 1)
        }
        out = (out + "</defs>\n")
        out = (out + "<rect x=\"0\" y=\"0\" width=\"" + (EVGDisplayList.num(pageW)) + "\" height=\"" + (EVGDisplayList.num(pageH)) + "\" fill=\"#ffffff\"/>\n")
        def br:int (to_int (clearR * 255.0))
        def bg:int (to_int (clearG * 255.0))
        def bb:int (to_int (clearB * 255.0))
        out = (out + "<rect x=\"" + (EVGDisplayList.num(ox)) + "\" y=\"" + (EVGDisplayList.num(oy)) + "\" width=\"" + (EVGDisplayList.num((to_double w))) + "\" height=\"" + (EVGDisplayList.num((to_double h))) + "\" fill=\"rgb(" + (to_string br) + "," + (to_string bg) + "," + (to_string bb) + ")\"/>\n")
        i = 0
        while (i < triCount) {
            def d:string ("M " + (EVGDisplayList.num((itemAt tx0 i))) + " " + (EVGDisplayList.num((itemAt ty0 i))))
            d = (d + " L " + (EVGDisplayList.num((itemAt tx1 i))) + " " + (EVGDisplayList.num((itemAt ty1 i))))
            d = (d + " L " + (EVGDisplayList.num((itemAt tx2 i))) + " " + (EVGDisplayList.num((itemAt ty2 i))) + " Z")
            out = (out + "<path d=\"" + d + "\" fill=\"url(#lg" + (to_string i) + ")\" stroke=\"none\"/>\n")
            i = (i + 1)
        }
        return (out + "</svg>\n")
    }

    ; Preview: AA silhouette + linear colour ramp along each triangle's gradient.
    fn paintRaster:void (buf:RasterBuffer) {
        this.sortBackToFront()
        def sceneBg:EVGColor (this.clearColor())
        def x0b:int (to_int ox)
        def y0b:int (to_int oy)
        def xx:int x0b
        while (xx < (x0b + w)) {
            def yy:int y0b
            while (yy < (y0b + h)) {
                buf.setPixel(xx yy (sceneBg.red()) (sceneBg.green()) (sceneBg.blue()) 255)
                yy = (yy + 1)
            }
            xx = (xx + 1)
        }
        def i:int 0
        while (i < triCount) {
            this.fillTriGrad(buf (itemAt tx0 i) (itemAt ty0 i) (itemAt tx1 i) (itemAt ty1 i) (itemAt tx2 i) (itemAt ty2 i) (itemAt gx1 i) (itemAt gy1 i) (itemAt gx2 i) (itemAt gy2 i) (itemAt tR1 i) (itemAt tG1 i) (itemAt tB1 i) (itemAt tR2 i) (itemAt tG2 i) (itemAt tB2 i))
            i = (i + 1)
        }
    }

    fn fillTriGrad:void (buf:RasterBuffer x0:double y0:double x1:double y1:double x2:double y2:double ax:double ay:double bx:double by:double r1:int g1:int b1:int r2:int g2:int b2:int) {
        def minx:int (to_int x0)
        def maxx:int (to_int x0)
        def miny:int (to_int y0)
        def maxy:int (to_int y0)
        if ((to_int x1) < minx) { minx = (to_int x1) }
        if ((to_int x2) < minx) { minx = (to_int x2) }
        if ((to_int x1) > maxx) { maxx = (to_int x1) }
        if ((to_int x2) > maxx) { maxx = (to_int x2) }
        if ((to_int y1) < miny) { miny = (to_int y1) }
        if ((to_int y2) < miny) { miny = (to_int y2) }
        if ((to_int y1) > maxy) { maxy = (to_int y1) }
        if ((to_int y2) > maxy) { maxy = (to_int y2) }
        if (minx < 0) { minx = 0 }
        if (miny < 0) { miny = 0 }
        if (maxx >= buf.width) { maxx = (buf.width - 1) }
        if (maxy >= buf.height) { maxy = (buf.height - 1) }
        def gdx:double (bx - ax)
        def gdy:double (by - ay)
        def glen2:double ((gdx * gdx) + (gdy * gdy))
        if (glen2 < 0.0001) {
            glen2 = 0.0001
        }
        def area:double (((x1 - x0) * (y2 - y0)) - ((x2 - x0) * (y1 - y0)))
        if ((area < 0.0001) && (area > (0.0 - 0.0001))) {
            return
        }
        def invArea:double (1.0 / area)
        def py:int miny
        while (py <= maxy) {
            def px:int minx
            while (px <= maxx) {
                def fx:double ((to_double px) + 0.5)
                def fy:double ((to_double py) + 0.5)
                def w0:double ((((x1 - fx) * (y2 - fy)) - ((x2 - fx) * (y1 - fy))) * invArea)
                def w1:double ((((x2 - fx) * (y0 - fy)) - ((x0 - fx) * (y2 - fy))) * invArea)
                def w2:double ((1.0 - w0) - w1)
                if (((w0 >= 0.0) && (w1 >= 0.0)) && (w2 >= 0.0)) {
                    def t:double ((((fx - ax) * gdx) + ((fy - ay) * gdy)) / glen2)
                    t = (this.clamp01(t))
                    def inv:double (1.0 - t)
                    def rr:int (to_int (((to_double r1) * inv) + ((to_double r2) * t)))
                    def gg:int (to_int (((to_double g1) * inv) + ((to_double g2) * t)))
                    def bb:int (to_int (((to_double b1) * inv) + ((to_double b2) * t)))
                    buf.setPixel(px py rr gg bb 255)
                }
                px = (px + 1)
            }
            py = (py + 1)
        }
    }

    fn triangleCount:int () {
        return triCount
    }

    fn width:int () {
        return w
    }

    fn height:int () {
        return h
    }
}

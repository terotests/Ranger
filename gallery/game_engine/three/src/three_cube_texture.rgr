; ==============================================================================
; three_cube_texture — a cube map (Three.js port of src/textures/CubeTexture.js).
; ==============================================================================
; Six RGBA faces (+X -X +Y -Y +Z -Z) used as an environment map: reflections on
; MeshPhongMaterial.envMap and the scene skybox. Kept as pure data + a procedural
; generator so the demo needs no external image assets and stays portable (the
; software path can ignore it; the GL backend uploads it as GL_TEXTURE_CUBE_MAP).
; ==============================================================================

class ThreeCubeTexture {
    def isCubeTexture:boolean true
    def size:int 0
    def faces:[buffer]         ; 6 RGBA buffers, order +X -X +Y -Y +Z -Z
    def glHandle:int (0 - 1)

    fn faceCount:int () {
        return (array_length this.faces)
    }
    fn face:buffer (i:int) {
        return (itemAt this.faces i)
    }

    ; direction for face `f` at normalized (u,v) in [-1,1] (standard GL cube map).
    sfn faceDir:[double] (f:int u:double v:double) {
        def dx:double 0.0
        def dy:double 0.0
        def dz:double 0.0
        if (f == 0) {
            dx = 1.0
            dy = (0.0 - v)
            dz = (0.0 - u)
        }
        if (f == 1) {
            dx = (0.0 - 1.0)
            dy = (0.0 - v)
            dz = u
        }
        if (f == 2) {
            dx = u
            dy = 1.0
            dz = v
        }
        if (f == 3) {
            dx = u
            dy = (0.0 - 1.0)
            dz = (0.0 - v)
        }
        if (f == 4) {
            dx = u
            dy = (0.0 - v)
            dz = 1.0
        }
        if (f == 5) {
            dx = (0.0 - u)
            dy = (0.0 - v)
            dz = (0.0 - 1.0)
        }
        def d:[double]
        push d dx
        push d dy
        push d dz
        return d
    }

    ; Procedural sky: smooth gradient sky→horizon→ground by direction.y, with a
    ; soft sun toward the scene's light so reflections read as a real environment.
    sfn proceduralSky:ThreeCubeTexture (size:int) {
        def t:ThreeCubeTexture (new ThreeCubeTexture)
        t.size = size
        ; sun direction (normalized), matching the probe's directional light
        def sx:double 0.32
        def sy:double 0.39
        def sz:double 0.7
        def sl:double (sqrt(((sx * sx) + (sy * sy)) + (sz * sz)))
        sx = (sx / sl)
        sy = (sy / sl)
        sz = (sz / sl)
        def f:int 0
        while (f < 6) {
            def buf:buffer (buffer_alloc ((size * size) * 4))
            def yy:int 0
            while (yy < size) {
                def xx:int 0
                while (xx < size) {
                    def u:double (((((to_double xx) + 0.5) / (to_double size)) * 2.0) - 1.0)
                    def v:double (((((to_double yy) + 0.5) / (to_double size)) * 2.0) - 1.0)
                    def dir:[double] (ThreeCubeTexture.faceDir(f u v))
                    def dx:double (itemAt dir 0)
                    def dy:double (itemAt dir 1)
                    def dz:double (itemAt dir 2)
                    def dl:double (sqrt(((dx * dx) + (dy * dy)) + (dz * dz)))
                    dx = (dx / dl)
                    dy = (dy / dl)
                    dz = (dz / dl)
                    ; sky gradient by height
                    def h:double dy
                    def r:double 0.0
                    def g:double 0.0
                    def b:double 0.0
                    if (h >= 0.0) {
                        ; horizon (light) -> zenith (blue)
                        r = (0.80 - (h * 0.55))
                        g = (0.86 - (h * 0.36))
                        b = (0.92 - (h * 0.02))
                    } {
                        ; horizon -> ground (warm brown)
                        def hn:double (0.0 - h)
                        r = (0.80 - (hn * 0.44))
                        g = (0.86 - (hn * 0.60))
                        b = (0.92 - (hn * 0.66))
                    }
                    ; soft sun highlight
                    def sd:double (((dx * sx) + (dy * sy)) + (dz * sz))
                    if (sd > 0.86) {
                        def k:double ((sd - 0.86) / 0.14)
                        r = (r + (k * 0.9))
                        g = (g + (k * 0.85))
                        b = (b + (k * 0.6))
                    }
                    if (r > 1.0) { r = 1.0 }
                    if (g > 1.0) { g = 1.0 }
                    if (b > 1.0) { b = 1.0 }
                    def o:int (((yy * size) + xx) * 4)
                    buffer_set buf o (to_int (r * 255.0))
                    buffer_set buf (o + 1) (to_int (g * 255.0))
                    buffer_set buf (o + 2) (to_int (b * 255.0))
                    buffer_set buf (o + 3) 255
                    xx = (xx + 1)
                }
                yy = (yy + 1)
            }
            push t.faces buf
            f = (f + 1)
        }
        return t
    }

    ; A DARK "studio" environment: near-black surround with a soft bright ceiling
    ; and two crisp overhead light bars, plus a faint cool horizon glow. Used as an
    ; envMap it gives chrome objects a moody metallic look (bright top streaks on a
    ; dark body); drawn as the skybox it keeps a dark, arcade-cabinet background
    ; (unlike proceduralSky's bright daytime dome).
    sfn proceduralStudio:ThreeCubeTexture (size:int) {
        def t:ThreeCubeTexture (new ThreeCubeTexture)
        t.size = size
        def f:int 0
        while (f < 6) {
            def buf:buffer (buffer_alloc ((size * size) * 4))
            def yy:int 0
            while (yy < size) {
                def xx:int 0
                while (xx < size) {
                    def u:double (((((to_double xx) + 0.5) / (to_double size)) * 2.0) - 1.0)
                    def v:double (((((to_double yy) + 0.5) / (to_double size)) * 2.0) - 1.0)
                    def dir:[double] (ThreeCubeTexture.faceDir(f u v))
                    def dx:double (itemAt dir 0)
                    def dy:double (itemAt dir 1)
                    def dz:double (itemAt dir 2)
                    def dl:double (sqrt(((dx * dx) + (dy * dy)) + (dz * dz)))
                    dx = (dx / dl)
                    dy = (dy / dl)
                    dz = (dz / dl)
                    def r:double 0.20
                    def g:double 0.23
                    def b:double 0.30
                    ; soft bright ceiling (upper hemisphere) → the ball's top sheen
                    if (dy > 0.10) {
                        def ct:double ((dy - 0.10) / 0.90)
                        r = (r + (ct * 0.50))
                        g = (g + (ct * 0.53))
                        b = (b + (ct * 0.58))
                    }
                    ; two crisp overhead light bars → chrome streaks
                    if (dy > 0.5) {
                        def b1:double (dz - 0.35)
                        def b2:double (dz + 0.45)
                        if (b1 < 0.0) { b1 = (0.0 - b1) }
                        if (b2 < 0.0) { b2 = (0.0 - b2) }
                        if ((b1 < 0.12) || (b2 < 0.12)) {
                            r = (r + 0.85)
                            g = (g + 0.88)
                            b = (b + 0.95)
                        }
                    }
                    ; lower hemisphere: the bright neon playfield the ball sits on —
                    ; makes a reflective ball read as silvery-blue chrome (only the
                    ; ball sees this; the skybox floor is below the cabinet, unseen).
                    if (dy < (0.0 - 0.05)) {
                        def gl:double (((0.0 - dy) - 0.05) / 0.95)
                        r = (r + (gl * 0.24))
                        g = (g + (gl * 0.34))
                        b = (b + (gl * 0.62))
                    }
                    ; faint cool neon glow along the horizon
                    def hv:double dy
                    if (hv < 0.0) { hv = (0.0 - hv) }
                    if (hv < 0.12) {
                        def hg:double ((0.12 - hv) / 0.12)
                        r = (r + (hg * 0.05))
                        g = (g + (hg * 0.10))
                        b = (b + (hg * 0.22))
                    }
                    if (r > 1.0) { r = 1.0 }
                    if (g > 1.0) { g = 1.0 }
                    if (b > 1.0) { b = 1.0 }
                    def o:int (((yy * size) + xx) * 4)
                    buffer_set buf o (to_int (r * 255.0))
                    buffer_set buf (o + 1) (to_int (g * 255.0))
                    buffer_set buf (o + 2) (to_int (b * 255.0))
                    buffer_set buf (o + 3) 255
                    xx = (xx + 1)
                }
                yy = (yy + 1)
            }
            push t.faces buf
            f = (f + 1)
        }
        return t
    }
}

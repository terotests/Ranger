; ==============================================================================
; three_constants — named constants (Three.js src/constants.js, subset).
; ==============================================================================
; Colour-space tokens as strings (Three.js exports SRGBColorSpace = 'srgb', etc).
; ==============================================================================

class ThreeColorSpace {
    sfn NoColorSpace:string () {
        return ""
    }
    sfn SRGBColorSpace:string () {
        return "srgb"
    }
    sfn LinearSRGBColorSpace:string () {
        return "srgb-linear"
    }
}

; Material blending (Three.js NoBlending / NormalBlending / AdditiveBlending).
class ThreeBlending {
    sfn NoBlending:int () {
        return 0
    }
    sfn NormalBlending:int () {
        return 1
    }
    sfn AdditiveBlending:int () {
        return 2
    }
}

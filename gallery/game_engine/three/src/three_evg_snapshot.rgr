; ==============================================================================
; three_evg_snapshot — Three.js scene → EVG vector print (paths / SVG).
; ==============================================================================
;
; Projects a ThreeScene through ThreeEvgVectorBackend (plugged into
; ThreeWebGLRenderer) and emits what EVG print targets already consume:
;
;   • EVGDisplayList PATH polygons   — PDF / SoftPainter / GPU list painters
;   • SVG document                   — true vector still for print / paste
;   • SoftCanvas preview PNG         — AA polygon fill at page resolution
;                                       (not a low-res triangle raster upscale)
;
; Bitmap helpers (toRaster / toPng / toEvgImage) remain for callers that still
; want a raster still from the software backend.
; ==============================================================================

Import "three_webgl_renderer.rgr"
Import "three_scene.rgr"
Import "three_perspective_camera.rgr"
Import "three_evg_vector_backend.rgr"
Import "../../../pdf_writer/src/raster/RasterBuffer.rgr"
Import "../../../pdf_writer/src/raster/PNGEncoder.rgr"
Import "../../../pdf_writer/src/jpeg/ImageBuffer.rgr"
Import "../../../evg/EVGElement.rgr"
Import "../../../evg/EVGUnit.rgr"
Import "../../../evg/EVGColor.rgr"
Import "../../../evg/EVGDisplayList.rgr"

class ThreeEvgSnapshot {
    ; Run the scene once through the vector backend (page placement optional).
    sfn renderVector:ThreeEvgVectorBackend (scene:ThreeScene camera:ThreePerspectiveCamera w:int h:int ox:double oy:double) {
        def backend:ThreeEvgVectorBackend (new ThreeEvgVectorBackend)
        backend.setOffset(ox oy)
        def renderer:ThreeWebGLRenderer (new ThreeWebGLRenderer)
        renderer.setSize(w h)
        renderer.setBackend(backend)
        renderer.render(scene camera)
        return backend
    }

    ; Expand software-backend RGB (w*h*3) into an opaque RGBA RasterBuffer.
    sfn rgbToRaster:RasterBuffer (rgb:buffer w:int h:int) {
        def rb:RasterBuffer (new RasterBuffer)
        rb.create(w h)
        def n:int (w * h)
        def i:int 0
        while (i < n) {
            def so:int (i * 3)
            def doff:int (i * 4)
            buffer_set rb.pixels doff (buffer_get rgb so)
            buffer_set rb.pixels (doff + 1) (buffer_get rgb (so + 1))
            buffer_set rb.pixels (doff + 2) (buffer_get rgb (so + 2))
            buffer_set rb.pixels (doff + 3) 255
            i = (i + 1)
        }
        return rb
    }

    sfn rgbToImage:ImageBuffer (rgb:buffer w:int h:int) {
        def img:ImageBuffer (new ImageBuffer)
        img.initClear(w h)
        def n:int (w * h)
        def i:int 0
        while (i < n) {
            def so:int (i * 3)
            def doff:int (i * 4)
            buffer_set img.pixels doff (buffer_get rgb so)
            buffer_set img.pixels (doff + 1) (buffer_get rgb (so + 1))
            buffer_set img.pixels (doff + 2) (buffer_get rgb (so + 2))
            buffer_set img.pixels (doff + 3) 255
            i = (i + 1)
        }
        return img
    }

    sfn renderRgb:buffer (scene:ThreeScene camera:ThreePerspectiveCamera w:int h:int) {
        def renderer:ThreeWebGLRenderer (new ThreeWebGLRenderer)
        renderer.setSize(w h)
        renderer.render(scene camera)
        return (renderer.raw())
    }

    sfn toRaster:RasterBuffer (scene:ThreeScene camera:ThreePerspectiveCamera w:int h:int) {
        def rgb:buffer (ThreeEvgSnapshot.renderRgb(scene camera w h))
        return (ThreeEvgSnapshot.rgbToRaster(rgb w h))
    }

    sfn toImage:ImageBuffer (scene:ThreeScene camera:ThreePerspectiveCamera w:int h:int) {
        def rgb:buffer (ThreeEvgSnapshot.renderRgb(scene camera w h))
        return (ThreeEvgSnapshot.rgbToImage(rgb w h))
    }

    sfn toPng:string (scene:ThreeScene camera:ThreePerspectiveCamera w:int h:int dir:string file:string) {
        def rb:RasterBuffer (ThreeEvgSnapshot.toRaster(scene camera w h))
        def enc:PNGEncoder (new PNGEncoder)
        enc.encode(rb dir file)
        if ((strlen dir) == 0) {
            return file
        }
        if (dir == ".") {
            return file
        }
        return (dir + "/" + file)
    }

    sfn toEvgImage:EVGElement (scene:ThreeScene camera:ThreePerspectiveCamera w:int h:int dir:string file:string displayW:double displayH:double) {
        def src:string (ThreeEvgSnapshot.toPng(scene camera w h dir file))
        def el:EVGElement (EVGElement.createImg())
        el.src = src
        el.width = (EVGUnit.px(displayW))
        el.height = (EVGUnit.px(displayH))
        el.objectFit = "fill"
        return el
    }

    ; Scene → EVGDisplayList of PATH polygons (vector print seam).
    sfn toDisplayList:EVGDisplayList (scene:ThreeScene camera:ThreePerspectiveCamera imgW:int imgH:int pageW:double pageH:double imgX:double imgY:double) {
        def backend:ThreeEvgVectorBackend (ThreeEvgSnapshot.renderVector(scene camera imgW imgH imgX imgY))
        return (backend.toDisplayList(pageW pageH))
    }

    ; Scene → SVG string (true vector).
    sfn toSvg:string (scene:ThreeScene camera:ThreePerspectiveCamera imgW:int imgH:int pageW:double pageH:double imgX:double imgY:double) {
        def backend:ThreeEvgVectorBackend (ThreeEvgSnapshot.renderVector(scene camera imgW imgH imgX imgY))
        return (backend.toSvg(pageW pageH))
    }

    ; Write SVG file; returns dir/file path.
    sfn toSvgFile:string (scene:ThreeScene camera:ThreePerspectiveCamera imgW:int imgH:int pageW:double pageH:double imgX:double imgY:double dir:string file:string) {
        def svg:string (ThreeEvgSnapshot.toSvg(scene camera imgW imgH pageW pageH imgX imgY))
        def buf:buffer (buffer_from_string svg)
        buffer_write_file dir file buf
        if ((strlen dir) == 0) {
            return file
        }
        if (dir == ".") {
            return file
        }
        return (dir + "/" + file)
    }

    ; Page-sized RasterBuffer filled with AA vector polygons (preview only).
    sfn toVectorPng:string (scene:ThreeScene camera:ThreePerspectiveCamera imgW:int imgH:int pageW:int pageH:int imgX:int imgY:int dir:string file:string) {
        def backend:ThreeEvgVectorBackend (ThreeEvgSnapshot.renderVector(scene camera imgW imgH (to_double imgX) (to_double imgY)))
        def rb:RasterBuffer (new RasterBuffer)
        rb.createWithColor(pageW pageH 255 255 255 255)
        backend.paintRaster(rb)
        def enc:PNGEncoder (new PNGEncoder)
        enc.encode(rb dir file)
        if ((strlen dir) == 0) {
            return file
        }
        if (dir == ".") {
            return file
        }
        return (dir + "/" + file)
    }
}

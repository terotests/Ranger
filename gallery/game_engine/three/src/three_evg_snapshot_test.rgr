; ==============================================================================
; three_evg_snapshot_test — Three scene → EVG vector print (paths + SVG).
; ==============================================================================
;
; Builds the canonical textured cube, projects it through ThreeEvgVectorBackend,
; asserts PATH/SVG wiring, and writes:
;   gallery/game_engine/three/artifacts/three_evg_cube.svg   — true vector
;   gallery/game_engine/three/artifacts/three_evg_print.png  — AA vector fill
;                                                             at page resolution
; ==============================================================================

Import "three_evg_snapshot.rgr"
Import "three_evg_vector_backend.rgr"
Import "three_scene.rgr"
Import "three_perspective_camera.rgr"
Import "three_box_geometry.rgr"
Import "three_mesh_basic_material.rgr"
Import "three_mesh.rgr"
Import "three_texture.rgr"
Import "../../../evg/EVGDisplayList.rgr"

class ThreeEvgSnapshotTest {
    def passed:int 0
    def failed:int 0

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    sfn checkerTexture:ThreeTexture () {
        def px:buffer (buffer_alloc 16)
        buffer_set px 0 220
        buffer_set px 1 60
        buffer_set px 2 60
        buffer_set px 3 255
        buffer_set px 4 60
        buffer_set px 5 200
        buffer_set px 6 90
        buffer_set px 7 255
        buffer_set px 8 70
        buffer_set px 9 120
        buffer_set px 10 230
        buffer_set px 11 255
        buffer_set px 12 230
        buffer_set px 13 220
        buffer_set px 14 180
        buffer_set px 15 255
        def tex:ThreeTexture (new ThreeTexture)
        tex.setImage(px 2 2)
        return tex
    }

    sfn buildCubeScene:ThreeScene () {
        def geometry:ThreeBoxGeometry (new ThreeBoxGeometry)
        geometry.setSize(1.0 1.0 1.0)
        def material:ThreeMeshBasicMaterial (new ThreeMeshBasicMaterial)
        material.setMap((ThreeEvgSnapshotTest.checkerTexture()))
        def mesh:ThreeMesh (new ThreeMesh)
        mesh.setGeometry(geometry)
        mesh.setMaterial(material)
        mesh.rotation.set(0.5 0.7 0.0)
        def scene:ThreeScene (new ThreeScene)
        scene.add(mesh)
        return scene
    }

    sfn countPathCmds:int (dl:EVGDisplayList) {
        def n:int 0
        def i:int 0
        while (i < (dl.count())) {
            def c:EVGDrawCmd (dl.at(i))
            if (c.kind == 6) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    sfn m@(main):void () {
        def t:ThreeEvgSnapshotTest (new ThreeEvgSnapshotTest)
        print "== ThreeEvgSnapshot — cube → EVG vector print =="

        def imgW:int 400
        def imgH:int 400
        def aspect:double ((to_double imgW) / (to_double imgH))
        def camera:ThreePerspectiveCamera (new ThreePerspectiveCamera)
        camera.setPerspective(70.0 aspect 0.1 100.0)
        camera.position.z = 2.0
        def scene:ThreeScene (ThreeEvgSnapshotTest.buildCubeScene())

        def outDir:string "gallery/game_engine/three/artifacts"
        def svgName:string "three_evg_cube.svg"
        def printName:string "three_evg_print.png"

        def pageW:double 480.0
        def pageH:double 560.0
        def margin:double 40.0

        ; --- vector backend collects projected triangles ---
        def backend:ThreeEvgVectorBackend (ThreeEvgSnapshot.renderVector(scene camera imgW imgH margin margin))
        t.ok(("collected triangles (" + (to_string (backend.triangleCount())) + ")") ((backend.triangleCount()) >= 12))

        ; --- EVGDisplayList is PATH polygons, not IMAGE ---
        def dl:EVGDisplayList (backend.toDisplayList(pageW pageH))
        def paths:int (ThreeEvgSnapshotTest.countPathCmds(dl))
        t.ok(("display list has PATH cmds (" + (to_string paths) + ")") (paths >= 12))
        t.ok("no IMAGE cmd in vector list" true)
        def i:int 0
        def sawImage:boolean false
        while (i < (dl.count())) {
            def c:EVGDrawCmd (dl.at(i))
            if (c.kind == 2) {
                sawImage = true
            }
            i = (i + 1)
        }
        t.ok("vector list has no IMAGE" (sawImage == false))
        def firstPath:EVGDrawCmd (dl.at(2))
        t.ok("path has 3 vertices" ((array_length firstPath.pts) == 6))

        ; --- SVG is true vector ---
        def svgPath:string (ThreeEvgSnapshot.toSvgFile(scene camera imgW imgH pageW pageH margin margin outDir svgName))
        t.ok("svg path" (svgPath == (outDir + "/" + svgName)))
        def svg:string (buffer_to_string (buffer_read_file outDir svgName))
        t.ok("svg has path elements" ((indexOf svg "<path d=") >= 0))
        t.ok("svg has no embedded raster" ((indexOf svg "data:image") < 0))

        ; --- page PNG preview via AA polygon fill (page resolution) ---
        def pngPath:string (ThreeEvgSnapshot.toVectorPng(scene camera imgW imgH (to_int pageW) (to_int pageH) (to_int margin) (to_int margin) outDir printName))
        t.ok("vector png path" (pngPath == (outDir + "/" + printName)))

        print "== summary =="
        print ("passed=" + (to_string t.passed) + " failed=" + (to_string t.failed))
        if (t.failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }
}

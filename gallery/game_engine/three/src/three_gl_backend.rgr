; ==============================================================================
; three_gl_backend — GPU render backend for ThreeWebGLRenderer (WebGL + GL/GLES).
; ==============================================================================
;
; A ThreeRenderBackend that draws through the three_gl operator layer. Because
; those operators carry both WebGL (es6) and OpenGL/GLES (cpp) bodies, this ONE
; Ranger backend compiles to the browser (GPU-accelerated WebGL) AND to native /
; desktop / Raspberry Pi (GLES2) — the same code, no hand-written .js.
;
; Wire it into the renderer:  renderer.setBackend(glBackend)  (after glBackend.init).
; ==============================================================================

Import "three_render_backend.rgr"
Import "three_gl.rgr"
Import "three_gl_shaders.rgr"
Import "three_buffer_geometry.rgr"
Import "three_matrix4.rgr"
Import "three_texture.rgr"
Import "../../model3d/ByteReader.rgr"

class ThreeGLBackend extends ThreeRenderBackend {
    def prog:int 0
    def ready:boolean false

    ; acquire the GPU context + compile the program once. canvasId is used by the
    ; WebGL path; the native path takes the host's current GL context.
    fn init:boolean (canvasId:string) {
        def ok:int (gpu_init canvasId)
        if (ok == 0) {
            return false
        }
        def vs:string (ThreeGLShaders.vertexSrc())
        def fs:string (ThreeGLShaders.fragmentSrc())
        prog = (gpu_program vs fs)
        ready = true
        return true
    }

    fn beginFrame:void (w:int h:int r:double g:double b:double) {
        gpu_begin w h r g b
    }

    fn drawMesh:void (geometry:ThreeBufferGeometry mvp:ThreeMatrix4 hasTexture:boolean tex:ThreeTexture colorR:double colorG:double colorB:double) {
        if (ready == false) {
            return
        }
        ; upload geometry once, then reuse the cached GPU handle every frame.
        if (geometry.glHandle < 0) {
            geometry.glHandle = (this.uploadGeometry(geometry))
        }
        def th:int 0
        if hasTexture {
            if (tex.glHandle < 0) {
                tex.glHandle = (gpu_make_texture tex.rgba tex.width tex.height)
            }
            th = tex.glHandle
        }
        def mvpBuf:buffer (this.matrixBytes(mvp))
        gpu_draw prog geometry.glHandle th mvpBuf colorR colorG colorB
    }

    fn endFrame:void () {
        gpu_end
    }

    ; interleaved float32 [px,py,pz, u,v] (20-byte stride) + uint32 index buffer.
    fn uploadGeometry:int (g:ThreeBufferGeometry) {
        def vc:int (g.vertexCount())
        def vbuf:buffer (buffer_alloc (vc * 20))
        def i:int 0
        while (i < vc) {
            def o:int (i * 20)
            def px:double (g.getPosition(i 0))
            def py:double (g.getPosition(i 1))
            def pz:double (g.getPosition(i 2))
            def u:double (g.getUv(i 0))
            def v:double (g.getUv(i 1))
            ByteReader.encodeF32(vbuf o px)
            ByteReader.encodeF32(vbuf (o + 4) py)
            ByteReader.encodeF32(vbuf (o + 8) pz)
            ByteReader.encodeF32(vbuf (o + 12) u)
            ByteReader.encodeF32(vbuf (o + 16) v)
            i = (i + 1)
        }
        def ic:int (g.indexCount())
        def ibuf:buffer (buffer_alloc (ic * 4))
        def k:int 0
        while (k < ic) {
            def idx:int (g.getIndex(k))
            ByteReader.encodeU32(ibuf (k * 4) idx)
            k = (k + 1)
        }
        return (gpu_make_mesh vbuf vc ibuf ic)
    }

    ; 16 float32 (column-major), as the GL uniform expects.
    fn matrixBytes:buffer (m:ThreeMatrix4) {
        def out:buffer (buffer_alloc 64)
        def i:int 0
        while (i < 16) {
            def e:double (m.eGet(i))
            ByteReader.encodeF32(out (i * 4) e)
            i = (i + 1)
        }
        return out
    }
}

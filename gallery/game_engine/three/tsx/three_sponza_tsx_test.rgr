; ==============================================================================
; three_sponza_tsx_test — sponza.tsx runs through the GENERIC bridge + plumbing.
; ==============================================================================
; sponza.tsx has NO bespoke bridge. It reconciles through the one generic
; ThreeTsxBridge (sky, shadow-casting sun, host-attached model, camera); the
; ThreeSponzaScene PLUMBING module runs on those reconciled objects (bounds →
; shadow extent, the baked GI probe volume, per-probe visibility, FPC). This
; asserts the reconcile (sky uniforms, sun, probe volume, model bounds) and the
; hot-reload path (edit a knob + re-run the plumbing changes the core scene).
; ==============================================================================

Import "three_tsx_bridge.rgr"
Import "three_sponza_scene.rgr"
Import "../src/three_mesh.rgr"
Import "../src/three_box_geometry.rgr"

class ThreeSponzaTsxTest {
    def passed:int 0
    def failed:int 0

    fn ok:void (label:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + label)
        } {
            failed = (failed + 1)
            print ("  FAIL " + label)
        }
    }
    fn near:void (label:string got:double want:double) {
        def d:double (got - want)
        if (d < 0.0) {
            d = (0.0 - d)
        }
        if (d < 0.01) {
            passed = (passed + 1)
            print ("  PASS " + label + " (" + (to_string got) + ")")
        } {
            failed = (failed + 1)
            print ("  FAIL " + label + " got=" + (to_string got) + " want=" + (to_string want))
        }
    }

    sfn registerGlobals:void (engine:ComponentEngine) {
        def tk:[string]
        def tv:[EvalValue]
        push tk "SRGBColorSpace"
        push tv (EvalValue.string("srgb"))
        push tk "DoubleSide"
        push tv (EvalValue.number(2.0))
        push tk "RepeatWrapping"
        push tv (EvalValue.number(1000.0))
        push tk "ACESFilmicToneMapping"
        push tv (EvalValue.number(4.0))
        engine.registerGlobal("THREE" (EvalValue.object(tk tv)))

        def wk:[string]
        def wv:[EvalValue]
        push wk "innerWidth"
        push wv (EvalValue.number(1280.0))
        push wk "innerHeight"
        push wv (EvalValue.number(720.0))
        push wk "devicePixelRatio"
        push wv (EvalValue.number(1.0))
        engine.registerGlobal("window" (EvalValue.object(wk wv)))
    }

    sfn m@(main):void () {
        def t:ThreeSponzaTsxTest (new ThreeSponzaTsxTest)
        t.run()
    }

    fn run:void () {
        def dir:string "gallery/game_engine/three/tsx"
        def facadeBuf:buffer (buffer_read_file dir "three.tsx")
        def sponzaBuf:buffer (buffer_read_file dir "sponza.tsx")
        def src:string (((buffer_to_string facadeBuf) + "\n") + (buffer_to_string sponzaBuf))

        def engine (new ComponentEngine())
        engine.quiet = true
        ThreeSponzaTsxTest.registerGlobals(engine)
        engine.loadScript(src)
        engine.callFunction("init" (EvalValue.null()))

        ; the host's decoded model: a 20 x 10 x 8 box stands in for Sponza.
        def geo:ThreeBoxGeometry (new ThreeBoxGeometry)
        geo.setSize(20.0 10.0 8.0)
        def modelMesh:ThreeMesh (new ThreeMesh)
        modelMesh.setGeometry(geo)

        ; generic bridge reconciles the declared scene graph.
        def gbridge (new ThreeTsxBridge)
        gbridge.setEngine(engine)
        gbridge.setHostModel(modelMesh)
        gbridge.reconcile(1280 720)
        ; plumbing module runs on the reconciled objects.
        def sponza (new ThreeSponzaScene)
        sponza.setEngine(engine)
        sponza.bind(gbridge.scene gbridge.camera (gbridge.sunLight()) (gbridge.skyNode()) (gbridge.modelNode()))
        sponza.reconcile()

        print "== sponza.tsx reconciled through the generic bridge + plumbing =="
        ; sky uniforms flowed from the interpreted script (via the generic bridge)
        this.near("sky rayleigh 2" sponza.sky.rayleigh 2.0)
        this.near("sky mieDirectionalG 0.8" sponza.sky.mieDirectionalG 0.8)
        this.near("sky turbidity 10" sponza.sky.turbidity 10.0)
        ; probe volume: 10 x 7 x 7 = 490 (built + baked by the plumbing)
        this.near("probe count 490" (to_double (sponza.volume.probeCount())) 490.0)
        ; sun / light from az -45 / elev 55 (reconciled by the generic bridge)
        this.near("light intensity 100" sponza.dirLight.intensity 100.0)
        this.ok("light casts shadow" sponza.dirLight.castShadow)
        this.ok("light above target (bounds-scaled by the plumbing)" (sponza.dirLight.position.y > sponza.sunRig.targetY))
        this.near("sky sun y = cos(35)" sponza.sky.sunPosition.y 0.819152)
        ; model bounds measured by the plumbing (host box is 20 x 10)
        this.near("model size x = 20" sponza.sunRig.sizeX 20.0)
        this.near("model size y = 10" sponza.sunRig.sizeY 10.0)

        print "== hot-reload: edit a knob, re-run the plumbing =="
        def before:double sponza.sky.sunPosition.y
        engine.callFunction("setLightElevation" (EvalValue.number(20.0)))
        sponza.reconcile()
        this.near("elevation now 20" sponza.sunRig.elevation 20.0)
        this.near("sun y = cos(70)" sponza.sky.sunPosition.y 0.342020)
        this.ok("sun moved" (sponza.sky.sunPosition.y != before))

        ; change a probe count -> the volume rebuilds + rebakes (4 x 7 x 7 = 196)
        engine.callFunction("setProbeCountX" (EvalValue.number(4.0)))
        sponza.reconcile()
        this.near("probe count now 196" (to_double (sponza.volume.probeCount())) 196.0)

        ; toggle GI off -> the probe volume hides
        engine.callFunction("setGI" (EvalValue.boolean(false)))
        sponza.reconcile()
        this.ok("GI toggled off" (sponza.volume.probes.visible == false))

        print "== summary =="
        print (("passed=" + (to_string passed)) + (" failed=" + (to_string failed)))
        if (failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }
}

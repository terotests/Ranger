; ==============================================================================
; three_sponza_scene — the light-probe-volume RECIPE (demo/host layer).
; ==============================================================================
; NOT a reconciler and NOT part of the object model. IDEAL_THREE §5: the ONE
; reconciler is the generic ThreeTsxBridge, which reconciles sponza.tsx's declared
; scene content (the Sky, the shadow-casting DirectionalLight, the host-attached
; model, lit meshes, camera). This module is the thin GPU-technique *recipe* that
; composes REUSABLE rigs over those reconciled objects:
;
;   - ThreeSunShadowRig      — sun placement + shadow-camera, derived from bounds
;   - ThreeLightProbeVolume  — the diffuse-GI probe volume (build / bake / sample)
;   - ThreeFirstPersonControls — the walk-around camera
;
; The recipe holds NO technique logic of its own beyond the wiring + the GI look
; (the sun/sky/ground tints in bakeGI, this scene's art direction). Tuning the
; render means: change knobs (params, live), change the look (bakeGI tints here),
; or — for a different technique stack — write a different recipe over the SAME
; rigs. A new look is never a fork of a rig. `bind()` points scene/camera/sky/
; dirLight/model at the bridge's reconciled objects, so the rigs operate on the
; one host-owned registry. There is no ThreeSponzaTsxBridge — this recipe + the
; generic bridge replace it. Pure Ranger (compiles to C++ for the native SDL host).
; ==============================================================================

Import "../src/three_scene.rgr"
Import "../src/three_perspective_camera.rgr"
Import "../src/three_sky.rgr"
Import "../src/three_light.rgr"
Import "../src/three_object3d.rgr"
Import "../src/three_vector3.rgr"
Import "../src/three_matrix4.rgr"
Import "../src/three_box3.rgr"
Import "../src/three_math_utils.rgr"
Import "../src/three_first_person_controls.rgr"
Import "../src/three_sun_shadow_rig.rgr"
Import "../src/three_light_probe_volume.rgr"
Import "../../../pdf_writer/src/jsx/ComponentEngine.rgr"
Import "../../../pdf_writer/src/jsx/EvalValue.rgr"

class ThreeSponzaScene {
    ; reconciled objects the bridge built (set by bind()); the rigs operate on these.
    def scene:ThreeScene (new ThreeScene)
    def camera:ThreePerspectiveCamera (new ThreePerspectiveCamera)
    def sky:ThreeSky (new ThreeSky)
    def dirLight:ThreeDirectionalLight (new ThreeDirectionalLight)
    def model:ThreeObject3D (new ThreeObject3D)

    ; the reusable technique rigs this recipe composes.
    def sunRig:ThreeSunShadowRig (new ThreeSunShadowRig)
    def volume:ThreeLightProbeVolume (new ThreeLightProbeVolume)
    def fpc:ThreeFirstPersonControls (new ThreeFirstPersonControls)

    def engine:ComponentEngine (new ComponentEngine())
    def built:boolean false

    ; --- controls / GI art-direction knobs the recipe owns ---
    def movementSpeed:double 1.0
    def lookSpeed:double 0.005
    ; extra GI knobs read from params (kept for param round-trip; the bake look is
    ; the tints in bakeGI below).
    def bounces:int 1
    def shadows:boolean true

    fn setEngine:ThreeSponzaScene (e:ComponentEngine) {
        engine = e
        return this
    }
    ; point scene/camera/sky/dirLight/model at the generic bridge's reconciled
    ; objects, so the rigs' bake/shadow math operates on the SAME graph the bridge
    ; built + renders. (The bridge reconciled the Sky/DirectionalLight from
    ; sponza.tsx; this recipe adds only the derived config + the baked probe volume.)
    fn bind:ThreeSponzaScene (s:ThreeScene cam:ThreePerspectiveCamera sun:ThreeDirectionalLight skyNode:ThreeSky mdl:ThreeObject3D) {
        this.scene = s
        this.camera = cam
        this.dirLight = sun
        this.sky = skyNode
        this.model = mdl
        return this
    }

    fn numOr:double (obj:EvalValue key:string dflt:double) {
        def v:EvalValue (obj.getMember(key))
        if (v.isNumber()) {
            return (v.toNumber())
        }
        return dflt
    }
    fn boolOr:boolean (obj:EvalValue key:string dflt:boolean) {
        def v:EvalValue (obj.getMember(key))
        if (v.isBoolean()) {
            return v.boolValue
        }
        return dflt
    }
    ; read the interpreted `params` (the GUI knobs) into the rigs. The sky uniforms,
    ; light colour/intensity and camera are already reconciled by the generic bridge —
    ; only the sun-placement + probe-volume / GI knobs are read here.
    fn applyParams:void () {
        def p:EvalValue (engine.getGlobal("params"))
        if (p.isObject() == false) {
            return
        }
        this.sunRig.azimuth = (this.numOr(p "lightAzimuth" (0.0 - 45.0)))
        this.sunRig.elevation = (this.numOr(p "lightElevation" 55.0))
        this.sunRig.intensity = (this.numOr(p "lightIntensity" 100.0))
        this.volume.gridSizeX = (this.numOr(p "sizeX" 21.0))
        this.volume.gridSizeY = (this.numOr(p "sizeY" 11.0))
        this.volume.gridSizeZ = (this.numOr(p "sizeZ" 9.0))
        this.volume.countX = (to_int (this.numOr(p "countX" 10.0)))
        this.volume.countY = (to_int (this.numOr(p "countY" 7.0)))
        this.volume.countZ = (to_int (this.numOr(p "countZ" 7.0)))
        this.volume.boundsX = (this.numOr(p "boundsX" (0.0 - 0.5)))
        this.volume.boundsY = (this.numOr(p "boundsY" 6.0))
        this.volume.boundsZ = (this.numOr(p "boundsZ" (0.0 - 0.3)))
        this.bounces = (to_int (this.numOr(p "bounces" 1.0)))
        this.shadows = (this.boolOr(p "shadows" true))
        this.volume.enabled = (this.boolOr(p "enabled" true))
        this.volume.showProbes = (this.boolOr(p "showProbes" false))
    }

    ; run the interpreted init() then the first reconcile (build) — the host calls
    ; this after the generic bridge has reconciled the scene graph + bind().
    fn initFromScript:void () {
        this.engine.callFunction("init" (EvalValue.null()))
        this.reconcile()
    }

    ; read the current GUI params and (first time) build the derived config + baked
    ; probe volume; thereafter hot-reload — rebuild + rebake the probes on a count
    ; change, and re-place the sun + re-bake the GI fill for angle/intensity edits.
    fn reconcile:void () {
        this.applyParams()
        if (built == false) {
            this.build(this.model)
            this.volume.captureCounts()
            built = true
            return
        }
        if (this.volume.countsChanged()) {
            this.volume.rebuild(this.scene)
            this.bakeGI()
            this.volume.captureCounts()
        }
        this.volume.setEnabled(this.volume.enabled)
        this.sunRig.place(this.dirLight this.sky)
        this.bakeGI()
    }

    ; assemble the scene around a host-supplied model: derive the bounds-based config,
    ; install the sun + shadow (sun/shadow rig), build + bake the probe volume, and
    ; wire the controls — all on the bridge's reconciled objects (sky/dirLight/model
    ; are already in this.scene, put there by the bridge; bind() pointed our refs at
    ; them). We add only what the bridge does not.
    fn build:ThreeSponzaScene (modelRoot:ThreeObject3D) {
        this.model = modelRoot

        ; model bounds -> composition metrics + sun/shadow, via the reusable rig.
        def box:ThreeBox3 (this.model.boundingBox())
        this.sunRig.configureFromBounds(box)
        this.sunRig.installShadow(this.dirLight this.scene)
        this.sunRig.place(this.dirLight this.sky)

        ; the diffuse-GI probe volume (the bridge can't bake; that is this recipe's
        ; job), built + baked via the reusable rig, added to the bridge's scene.
        this.volume.rebuild(this.scene)
        this.bakeGI()

        ; first-person controls on the bridge's camera.
        this.fpc.setCamera(this.camera)
        this.fpc.setMovementSpeed(this.movementSpeed)
        this.fpc.setLookSpeed(this.lookSpeed)

        return this
    }

    ; the GI LOOK (this scene's art direction): a directional SH environment — cool
    ; sky from above, a warm ground bounce from below, the sun as a directional lobe,
    ; all scaled by the sun's strength + a daylight factor. The volume just stores
    ; whatever radiance we hand it; the tints below are what make this scene's look.
    fn bakeGI:void () {
        def elevationR:double (ThreeMathUtils.degToRad(this.sunRig.elevation))
        def daylight:double ((sin elevationR) + 0.25)
        if (daylight < 0.05) {
            daylight = 0.05
        }
        def sd:ThreeVector3 (new ThreeVector3)
        this.sunRig.sunDirection(sd)

        def sunLevel:double ((this.sunRig.intensity * 0.10) * daylight)
        def skyLevel:double ((this.sunRig.intensity * 0.06) * daylight)
        def gndLevel:double ((this.sunRig.intensity * 0.07) * daylight)
        this.volume.bake(
            sd.x sd.y sd.z
            (sunLevel * 1.0) (sunLevel * 0.96) (sunLevel * 0.86)
            (skyLevel * 0.62) (skyLevel * 0.80) (skyLevel * 1.10)
            (gndLevel * 0.90) (gndLevel * 0.80) (gndLevel * 0.62))
    }

    ; the sun's light-space view-projection (for the per-probe sun-visibility pass).
    fn sunViewProjection:ThreeMatrix4 () {
        return (this.dirLight.shadowViewProjection())
    }
    ; given the shadow map's packed-depth read back to CPU, compute per-probe sun
    ; visibility (shadowed probes lose their direct-sun lobe) and re-bake. The host
    ; calls this once after the first frame renders the shadow map.
    fn applyProbeVisibility:void (shadowDepth:buffer size:int) {
        this.volume.computeVisibility(shadowDepth size (this.sunViewProjection()))
        this.bakeGI()
    }

    ; sample the baked GI irradiance at a world point for a surface normal (what the
    ; shader does per fragment; exposed here for the software path + tests).
    fn sampleGI:ThreeVector3 (wx:double wy:double wz:double nx:double ny:double nz:double target:ThreeVector3) {
        return (this.volume.sample(wx wy wz nx ny nz target))
    }

    ; host feeds viewport + input; per frame: integrate controls.
    fn setViewport:void (w:int h:int) {
        this.camera.aspect = ((to_double w) / (to_double h))
        this.camera.updateProjectionMatrix()
    }
    fn update:void (delta:double) {
        this.fpc.update(delta)
    }
}

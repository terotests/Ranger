; ==============================================================================
; three_sponza_scene — the light-probe-volume PLUMBING MODULE (demo/host layer).
; ==============================================================================
; NOT a reconciler and NOT part of the object model. IDEAL_THREE §5: the ONE
; reconciler is the generic ThreeTsxBridge, which reconciles sponza.tsx's declared
; scene content (the Sky, the shadow-casting DirectionalLight, the host-attached
; model, lit meshes, camera). THIS module is the GPU-technique plumbing that runs
; ON those reconciled objects: it derives the light distance / shadow-camera extent
; / probe-volume far plane from the model bounds, builds + bakes the diffuse-GI
; LightProbeGrid (the bridge can't bake), runs the per-probe sun-visibility pass,
; and owns the FirstPersonControls. `bind()` points scene/camera/sky/dirLight/model
; at the bridge's reconciled objects (so the bake math below is unchanged); the GUI
; knobs are read from the interpreted `params` in reconcile(). There is no
; ThreeSponzaTsxBridge — this module + the generic bridge replace it.
; Pure Ranger (compiles to C++ for the native SDL host).
; ==============================================================================

Import "../src/three_scene.rgr"
Import "../src/three_perspective_camera.rgr"
Import "../src/three_sky.rgr"
Import "../src/three_light.rgr"
Import "../src/three_object3d.rgr"
Import "../src/three_light_probe_grid.rgr"
Import "../src/three_light_probe_grid_helper.rgr"
Import "../src/three_first_person_controls.rgr"
Import "../src/three_box3.rgr"
Import "../src/three_vector3.rgr"
Import "../src/three_math_utils.rgr"
Import "../../../pdf_writer/src/jsx/ComponentEngine.rgr"
Import "../../../pdf_writer/src/jsx/EvalValue.rgr"

class ThreeSponzaScene {
    def scene:ThreeScene (new ThreeScene)
    def camera:ThreePerspectiveCamera (new ThreePerspectiveCamera)
    def sky:ThreeSky (new ThreeSky)
    def dirLight:ThreeDirectionalLight (new ThreeDirectionalLight)
    def probes:ThreeLightProbeGrid (new ThreeLightProbeGrid)
    def probesHelper:ThreeLightProbeGridHelper (new ThreeLightProbeGridHelper)
    def fpc:ThreeFirstPersonControls (new ThreeFirstPersonControls)
    def model:ThreeObject3D (new ThreeObject3D)

    ; reconcile state (this module reads the interpreted GUI params + drives build /
    ; hot-reload; scene/camera/sky/dirLight are the generic bridge's, set by bind()).
    def engine:ComponentEngine (new ComponentEngine())
    def built:boolean false
    def sigCountX:int (0 - 1)
    def sigCountY:int (0 - 1)
    def sigCountZ:int (0 - 1)

    ; derived model metrics (filled by build() from the model bounds)
    def sizeX:double 1.0
    def sizeY:double 1.0
    def sizeZ:double 1.0
    def centerX:double 0.0
    def centerY:double 0.0
    def centerZ:double 0.0
    def targetY:double 0.0
    def lightBaseDistance:double 1.0
    def probeFar:double 1.0

    ; --- tunable knobs — NEUTRAL defaults; the caller (the bridge, from sponza.tsx)
    ; sets the demo's actual values before build(). --------------------------
    def enabled:boolean true
    def showProbes:boolean false
    def probeSize:double 0.2
    def boundsX:double 0.0
    def boundsY:double 0.0
    def boundsZ:double 0.0
    def gridSizeX:double 1.0
    def gridSizeY:double 1.0
    def gridSizeZ:double 1.0
    def countX:int 2
    def countY:int 2
    def countZ:int 2
    def bounces:int 1
    def lightAzimuth:double 0.0
    def lightElevation:double 45.0
    def lightIntensity:double 1.0
    def lightColorHex:int 16777215
    def shadows:boolean true
    def shadowMapSize:int 2048
    def movementSpeed:double 1.0
    def lookSpeed:double 0.005
    ; ambient radiance the analytic bake writes (a placeholder for the GPU bake,
    ; which renders each probe as a cubemap); not a demo value.
    def ambientR:double 0.1
    def ambientG:double 0.1
    def ambientB:double 0.1

    sfn maxOf2:double (a:double b:double) {
        if (a > b) {
            return a
        }
        return b
    }
    sfn maxOf3:double (a:double b:double c:double) {
        def m:double (ThreeSponzaScene.maxOf2(a b))
        return (ThreeSponzaScene.maxOf2(m c))
    }

    fn setEngine:ThreeSponzaScene (e:ComponentEngine) {
        engine = e
        return this
    }
    ; point scene/camera/sky/dirLight/model at the generic bridge's reconciled
    ; objects, so the bake/shadow math below operates on the SAME graph the bridge
    ; built + renders. (The generic bridge reconciled the Sky/DirectionalLight from
    ; sponza.tsx; this module adds only the derived config + the baked probe volume.)
    fn bind:ThreeSponzaScene (s:ThreeScene cam:ThreePerspectiveCamera sun:ThreeDirectionalLight skyNode:ThreeSky mdl:ThreeObject3D) {
        this.scene = s
        this.camera = cam
        this.dirLight = sun
        this.sky = skyNode
        this.model = mdl
        return this
    }

    fn numOr:double (obj:EvalValue key:string dflt:double) {
        def v:EvalValue (obj.getMember(key))
        if (v.isNumber()) {
            return (v.toNumber())
        }
        return dflt
    }
    fn boolOr:boolean (obj:EvalValue key:string dflt:boolean) {
        def v:EvalValue (obj.getMember(key))
        if (v.isBoolean()) {
            return v.boolValue
        }
        return dflt
    }
    ; read the interpreted `params` (the GUI knobs) into this module's fields. The
    ; sky uniforms, light colour/intensity and camera are already reconciled by the
    ; generic bridge — only the probe-volume / GI knobs are read here.
    fn applyParams:void () {
        def p:EvalValue (engine.getGlobal("params"))
        if (p.isObject() == false) {
            return
        }
        this.lightAzimuth = (this.numOr(p "lightAzimuth" (0.0 - 45.0)))
        this.lightElevation = (this.numOr(p "lightElevation" 55.0))
        this.lightIntensity = (this.numOr(p "lightIntensity" 100.0))
        this.gridSizeX = (this.numOr(p "sizeX" 21.0))
        this.gridSizeY = (this.numOr(p "sizeY" 11.0))
        this.gridSizeZ = (this.numOr(p "sizeZ" 9.0))
        this.countX = (to_int (this.numOr(p "countX" 10.0)))
        this.countY = (to_int (this.numOr(p "countY" 7.0)))
        this.countZ = (to_int (this.numOr(p "countZ" 7.0)))
        this.boundsX = (this.numOr(p "boundsX" (0.0 - 0.5)))
        this.boundsY = (this.numOr(p "boundsY" 6.0))
        this.boundsZ = (this.numOr(p "boundsZ" (0.0 - 0.3)))
        this.bounces = (to_int (this.numOr(p "bounces" 1.0)))
        this.shadows = (this.boolOr(p "shadows" true))
        this.enabled = (this.boolOr(p "enabled" true))
        this.showProbes = (this.boolOr(p "showProbes" false))
    }

    fn countsChanged:boolean () {
        if (this.countX != sigCountX) { return true }
        if (this.countY != sigCountY) { return true }
        if (this.countZ != sigCountZ) { return true }
        return false
    }
    fn captureCounts:void () {
        sigCountX = this.countX
        sigCountY = this.countY
        sigCountZ = this.countZ
    }

    ; run the interpreted init() then the first reconcile (build) — the host calls
    ; this after the generic bridge has reconciled the scene graph + bind().
    fn initFromScript:void () {
        this.engine.callFunction("init" (EvalValue.null()))
        this.reconcile()
    }

    ; read the current GUI params and (first time) build the derived config + baked
    ; probe volume; thereafter hot-reload — rebuild + rebake the probes on a count
    ; change, and re-place the sun + re-bake the GI fill for angle/intensity edits.
    fn reconcile:void () {
        this.applyParams()
        if (built == false) {
            this.build(this.model)
            this.captureCounts()
            built = true
            return
        }
        if (this.countsChanged()) {
            this.rebuildProbes()
            this.captureCounts()
        }
        this.probes.visible = this.enabled
        this.updateLightPosition()
        this.refreshGI()
    }

    ; assemble the scene around a host-supplied model. Uses the current knob values
    ; (the caller sets them first); the camera + sky uniforms are configured by the
    ; caller too, not baked here.
    ; Derive the bounds-based config + build the baked probe volume ON the generic
    ; bridge's reconciled objects (sky / dirLight / model are already in this.scene,
    ; put there by the bridge; bind() pointed our references at them). We add only
    ; what the bridge does not: the sun's shadow TARGET, the bounds-derived shadow
    ; extent, the sun's bounds-scaled position, and the baked LightProbeGrid.
    fn build:ThreeSponzaScene (modelRoot:ThreeObject3D) {
        this.model = modelRoot

        ; model bounds -> composition recipe (light distance, probe far).
        def box:ThreeBox3 (this.model.boundingBox())
        def sz:ThreeVector3 (new ThreeVector3)
        box.getSize(sz)
        def ctr:ThreeVector3 (new ThreeVector3)
        box.getCenter(ctr)
        this.sizeX = sz.x
        this.sizeY = sz.y
        this.sizeZ = sz.z
        this.centerX = ctr.x
        this.centerY = ctr.y
        this.centerZ = ctr.z
        this.targetY = (ctr.y + (sz.y * 0.2))
        this.lightBaseDistance = (ThreeSponzaScene.maxOf2(sz.x sz.z))
        this.probeFar = ((ThreeSponzaScene.maxOf3(sz.x sz.y sz.z)) * 2.0)

        ; SHADOW — the sun's colour/intensity/castShadow/mapSize are reconciled by the
        ; bridge from sponza.tsx; here we add the shadow target + the bounds-derived
        ; ortho extent (the extent is not something the scene declares).
        this.dirLight.target.position.set(this.centerX this.targetY this.centerZ)
        this.scene.add(this.dirLight.target)
        def shadowExtent:double ((ThreeSponzaScene.maxOf2(sz.x sz.z)) * 0.7)
        this.dirLight.shadow.setExtent((0.0 - shadowExtent) shadowExtent shadowExtent (0.0 - shadowExtent) 0.1 (sz.y * 4.0))

        this.updateLightPosition()

        ; LIGHT PROBE GRID (built + baked here — the bridge can't bake; the GI bake
        ; is this module's job) added to the bridge's scene.
        this.rebuildProbes()

        ; FIRST-PERSON CONTROLS on the bridge's camera.
        this.fpc.setCamera(this.camera)
        this.fpc.setMovementSpeed(this.movementSpeed)
        this.fpc.setLookSpeed(this.lookSpeed)

        return this
    }

    ; place the sun from azimuth + elevation (knobs) and drive the sky sun uniform.
    fn updateLightPosition:void () {
        def azimuth:double (ThreeMathUtils.degToRad(this.lightAzimuth))
        def elevation:double (ThreeMathUtils.degToRad(this.lightElevation))
        def radius:double this.lightBaseDistance
        def horizontal:double ((cos elevation) * radius)
        def vertical:double ((sin elevation) * radius)
        def lx:double (this.centerX + ((cos azimuth) * horizontal))
        def ly:double (this.targetY + vertical)
        def lz:double (this.centerZ + ((sin azimuth) * horizontal))
        this.dirLight.position.set(lx ly lz)
        this.dirLight.target.position.set(this.centerX this.targetY this.centerZ)
        this.dirLight.target.updateMatrixWorld()

        def phi:double (ThreeMathUtils.degToRad(90.0 - this.lightElevation))
        def theta:double (ThreeMathUtils.degToRad(this.lightAzimuth))
        def sun:ThreeVector3 (new ThreeVector3)
        sun.setFromSphericalCoords(1.0 phi theta)
        this.sky.copySunPosition(sun)
    }

    ; bake the probe volume as a directional SH environment: cool sky from above, a
    ; warm ground bounce from below, and the sun as a directional lobe (all scaled by
    ; the sun's strength). A per-probe "openness" gradient dims the low/enclosed
    ; probes. Analytic stand-in for a cubemap capture, but directional + spatially
    ; varying, so the sun-shadowed surfaces are filled with bounce, not black.
    fn bakeGI:void () {
        def elevation:double (ThreeMathUtils.degToRad(this.lightElevation))
        def daylight:double ((sin elevation) + 0.25)
        if (daylight < 0.05) {
            daylight = 0.05
        }
        ; sun direction (same convention as the sky sun uniform)
        def phi:double (ThreeMathUtils.degToRad(90.0 - this.lightElevation))
        def theta:double (ThreeMathUtils.degToRad(this.lightAzimuth))
        def sun:ThreeVector3 (new ThreeVector3)
        sun.setFromSphericalCoords(1.0 phi theta)

        ; radiance strengths in the scene's lighting scale (a fraction of the direct
        ; sun), tinted warm (sun / ground bounce) and cool (sky).
        def sunLevel:double ((this.lightIntensity * 0.10) * daylight)
        def skyLevel:double ((this.lightIntensity * 0.06) * daylight)
        def gndLevel:double ((this.lightIntensity * 0.07) * daylight)
        this.probes.bakeDirectional(
            sun.x sun.y sun.z
            (sunLevel * 1.0) (sunLevel * 0.96) (sunLevel * 0.86)
            (skyLevel * 0.62) (skyLevel * 0.80) (skyLevel * 1.10)
            (gndLevel * 0.90) (gndLevel * 0.80) (gndLevel * 0.62))
    }

    ; (re)create the probe grid at the current settings and bake it. Removes the
    ; previous volume + helper first so hot-reloads don't leak scene children.
    fn rebuildProbes:void () {
        this.scene.remove(this.probes)
        this.scene.remove(this.probesHelper)
        this.probes = (ThreeLightProbeGrid.create(this.gridSizeX this.gridSizeY this.gridSizeZ this.countX this.countY this.countZ))
        this.probes.position.set(this.boundsX this.boundsY this.boundsZ)
        this.probes.visible = this.enabled
        this.bakeGI()
        this.scene.add(this.probes)
        this.probesHelper = (ThreeLightProbeGridHelper.create(this.probes this.probeSize))
        this.probesHelper.visible = this.showProbes
        this.scene.add(this.probesHelper)
    }

    ; re-bake the existing probe volume (no re-create) — the cheap path when only
    ; the sun's intensity/elevation changed on a hot reload.
    fn refreshGI:void () {
        this.bakeGI()
    }

    ; the sun's light-space view-projection (for testing probe shadowing).
    fn sunViewProjection:ThreeMatrix4 () {
        return (this.dirLight.shadowViewProjection())
    }
    ; given the shadow map's packed-depth read back to CPU, compute per-probe sun
    ; visibility and re-bake so shadowed probes lose their direct-sun lobe. The host
    ; calls this once after the first frame renders the shadow map.
    fn applyProbeVisibility:void (shadowDepth:buffer size:int) {
        this.probes.computeSunVisibility(shadowDepth size (this.sunViewProjection()))
        this.bakeGI()
    }

    ; sample the baked GI irradiance at a world point for a surface normal (what the
    ; shader does per fragment; exposed here for the software path + tests).
    fn sampleGI:ThreeVector3 (wx:double wy:double wz:double nx:double ny:double nz:double target:ThreeVector3) {
        return (this.probes.sampleIrradiance(wx wy wz nx ny nz target))
    }

    ; host feeds viewport + input; per frame: integrate controls.
    fn setViewport:void (w:int h:int) {
        this.camera.aspect = ((to_double w) / (to_double h))
        this.camera.updateProjectionMatrix()
    }
    fn update:void (delta:double) {
        this.fpc.update(delta)
    }
}

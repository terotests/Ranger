; ==============================================================================
; three_teapot_tsx_test — teapot.tsx runs 1:1 through the GENERIC bridge.
; ==============================================================================
; The teapot has NO bespoke bridge any more: teapot.tsx reconciles through the one
; generic ThreeTsxBridge (the OrbitControls + lil-gui panel + procedural env cube /
; UV texture are host plumbing, in WebTeapotTsxHost). This checks the reconcile
; (camera, lights, the tessellated teapot mesh) AND rebuild-on-change: when the
; scene re-tessellates (the GUI's setTess → createNewTeapot removes + re-adds the
; mesh), the generic bridge REBUILDS it — the render changes — instead of freezing
; the first mesh. Software backend, headless.
; ==============================================================================

Import "three_tsx_bridge.rgr"

class ThreeTeapotTsxTest {
    def passed:int 0
    def failed:int 0

    fn ok:void (label:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + label)
        } {
            failed = (failed + 1)
            print ("  FAIL " + label)
        }
    }

    sfn checksum:int (color:buffer w:int h:int) {
        def n:int ((w * h) * 3)
        def sum:int 0
        def i:int 0
        while (i < n) {
            sum = (((sum * 31) + (buffer_get color i)) % 1000000007)
            i = (i + 1)
        }
        return sum
    }
    sfn covered:int (color:buffer w:int h:int) {
        def n:int (w * h)
        def c:int 0
        def i:int 0
        while (i < n) {
            def o:int (i * 3)
            if ((((buffer_get color o) + (buffer_get color (o + 1))) + (buffer_get color (o + 2))) > 60) {
                c = (c + 1)
            }
            i = (i + 1)
        }
        return c
    }

    sfn registerGlobals:void (engine:ComponentEngine) {
        def tk:[string]
        def tv:[EvalValue]
        push tk "SRGBColorSpace"
        push tv (EvalValue.string("srgb"))
        push tk "DoubleSide"
        push tv (EvalValue.number(2.0))
        push tk "FrontSide"
        push tv (EvalValue.number(0.0))
        push tk "BackSide"
        push tv (EvalValue.number(1.0))
        push tk "RepeatWrapping"
        push tv (EvalValue.number(1000.0))
        engine.registerGlobal("THREE" (EvalValue.object(tk tv)))
        def wk:[string]
        def wv:[EvalValue]
        push wk "innerWidth"
        push wv (EvalValue.number(600.0))
        push wk "innerHeight"
        push wv (EvalValue.number(600.0))
        push wk "devicePixelRatio"
        push wv (EvalValue.number(1.0))
        engine.registerGlobal("window" (EvalValue.object(wk wv)))
    }

    sfn m@(main):void () {
        def t:ThreeTeapotTsxTest (new ThreeTeapotTsxTest)
        t.run()
    }

    fn run:void () {
        def dir:string "gallery/game_engine/three/tsx"
        def facadeBuf:buffer (buffer_read_file dir "three.tsx")
        def teapotBuf:buffer (buffer_read_file dir "teapot.tsx")
        def src:string (((buffer_to_string facadeBuf) + "\n") + (buffer_to_string teapotBuf))

        def engine (new ComponentEngine())
        engine.quiet = true
        ThreeTeapotTsxTest.registerGlobals(engine)
        engine.loadScript(src)
        engine.callFunction("init" (EvalValue.null()))
        engine.callFunction("renderScene" (EvalValue.null()))

        def bridge (new ThreeTsxBridge)
        bridge.setEngine(engine)
        bridge.renderFrame(600 600)
        def frame0:buffer (bridge.raw())
        def sum0:int (ThreeTeapotTsxTest.checksum(frame0 600 600))
        def cov0:int (ThreeTeapotTsxTest.covered(frame0 600 600))
        print ("  mesh=" + (to_string (bridge.meshCount())) + " amb=" + (to_string (bridge.ambientLightCount())) + " dir=" + (to_string (bridge.directionalLightCount())) + " covered=" + (to_string cov0))

        this.ok("camera fov 45" ((bridge.camera.fov > 44.9) && (bridge.camera.fov < 45.1)))
        this.ok("camera far 80000" (bridge.camera.far > 79000.0))
        this.ok("one teapot mesh reconciled" ((bridge.meshCount()) == 1))
        this.ok("ambient + directional lights reconciled" (((bridge.ambientLightCount()) == 1) && ((bridge.directionalLightCount()) == 1)))
        this.ok("teapot renders (covers the frame)" (cov0 > 20000))

        ; rebuild-on-change: re-tessellate via the GUI hook. createNewTeapot removes
        ; and re-adds the mesh with a new geometry signature; the generic bridge must
        ; rebuild it, so the render changes. (If it froze the first mesh, sum0==sumN.)
        engine.callFunction("setTess" (EvalValue.number(4.0)))
        bridge.renderFrame(600 600)
        def sumN:int (ThreeTeapotTsxTest.checksum((bridge.raw()) 600 600))
        this.ok("re-tessellation rebuilt the mesh (render changed)" (sum0 != sumN))
        this.ok("still one mesh after rebuild" ((bridge.meshCount()) == 1))

        print "== summary =="
        print (("passed=" + (to_string passed)) + (" failed=" + (to_string failed)))
        if (failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }
}

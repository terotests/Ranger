; ==============================================================================
; three_animation_test — keyframe animation, DRIVEN THROUGH THE INTERPRETER.
; ==============================================================================
; Interprets animation_scene.tsx (a clip with position / quaternion / scale tracks
; on a mesh, played by an AnimationMixer), reconciles it into the Ranger host, then
; SEEKS the mixer to each golden time, reconciles again, and reads the animated
; entity's TRS back — comparing to real three.js (../../reference/animation_goldens
; .json). No rendering: the sampling (linear + slerp) and mixer application are pure
; Ranger core math.
;
; Binding: the mixer targets the SECOND scene mesh (host handle 2); the bridge
; resolves it by __uid, so this also proves real target binding across the
; interpreter's broken object identity.
; ==============================================================================

Import "../../tsx/three_tsx_bridge.rgr"
Import "../../src/three_json.rgr"
Import "../../../../pdf_writer/src/jsx/ComponentEngine.rgr"
Import "../../../../pdf_writer/src/jsx/EvalValue.rgr"

class AnimCheck {
    def passed:int 0
    def failed:int 0
    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }
    sfn near:boolean (a:double b:double) {
        def d:double (a - b)
        if (d < 0.0) { d = (0.0 - d) }
        return (d < 0.001)
    }
    fn vec3:void (label:string x:double y:double z:double g:ThreeJsonValue) {
        this.ok(label (
            (AnimCheck.near(x ((g.at(0)).asNumber())))
            && (AnimCheck.near(y ((g.at(1)).asNumber())))
            && (AnimCheck.near(z ((g.at(2)).asNumber())))))
    }
    fn quat:void (label:string x:double y:double z:double w:double g:ThreeJsonValue) {
        this.ok(label (
            (AnimCheck.near(x ((g.at(0)).asNumber())))
            && (AnimCheck.near(y ((g.at(1)).asNumber())))
            && (AnimCheck.near(z ((g.at(2)).asNumber())))
            && (AnimCheck.near(w ((g.at(3)).asNumber())))))
    }
}

class ThreeAnimationTest {
    sfn m@(main):void () {
        def ck:AnimCheck (new AnimCheck)
        def gbuf:buffer (buffer_read_file "gallery/game_engine/three/reference" "animation_goldens.json")
        def parser:ThreeJsonParser (new ThreeJsonParser)
        def golds:ThreeJsonValue (parser.parse((buffer_to_string gbuf)))

        def engine (new ComponentEngine())
        engine.quiet = true
        def tk:[string]
        def tv:[EvalValue]
        push tk "SRGBColorSpace"
        push tv (EvalValue.string("srgb"))
        engine.registerGlobal("THREE" (EvalValue.object(tk tv)))
        def wk:[string]
        def wv:[EvalValue]
        push wk "innerWidth"
        push wv (EvalValue.number(300.0))
        push wk "innerHeight"
        push wv (EvalValue.number(200.0))
        push wk "devicePixelRatio"
        push wv (EvalValue.number(1.0))
        engine.registerGlobal("window" (EvalValue.object(wk wv)))

        def facade:buffer (buffer_read_file "gallery/game_engine/three/tsx" "three.tsx")
        def scene:buffer (buffer_read_file "gallery/game_engine/three/tests/animation" "animation_scene.tsx")
        def src:string ((buffer_to_string facade) + "\n" + (buffer_to_string scene))
        engine.loadScript(src)
        def initR:EvalValue (engine.callFunction("init" (EvalValue.null())))

        def bridge (new ThreeTsxBridge)
        bridge.setEngine(engine)

        print "== animation: keyframe sampling + mixer via the interpreter =="
        def samples:ThreeJsonValue (golds.get("samples"))
        def n:int (samples.length())
        def i:int 0
        while (i < n) {
            def s:ThreeJsonValue (samples.at(i))
            def t:double (s.numOr("t" 0.0))
            def key:string (to_string t)
            ; seek the mixer to t, then reconcile so the host samples + applies
            def seekR:EvalValue (engine.callFunction("seek" (EvalValue.number(t))))
            bridge.renderFrame(300 200)
            ; the animated mesh is host entity handle 2 (bound by __uid)
            def e:ThreeObject3D (bridge.host.entityAt(2))
            ck.vec3(("t=" + key + " position") (e.position.x) (e.position.y) (e.position.z) (s.get("pos")))
            ck.quat(("t=" + key + " quaternion") (e.quaternion.x) (e.quaternion.y) (e.quaternion.z) (e.quaternion.w) (s.get("quat")))
            ck.vec3(("t=" + key + " scale") (e.scale.x) (e.scale.y) (e.scale.z) (s.get("scale")))
            i = (i + 1)
        }

        print "== summary =="
        print ("passed=" + (to_string ck.passed) + " failed=" + (to_string ck.failed))
        if (ck.failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }
}

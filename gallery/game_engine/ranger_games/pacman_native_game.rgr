; ==============================================================================
; pacman_native_game - static-compiled Pac-Man logic (emitter output).
; ==============================================================================

Import "../scripting/native_game_bridge.rgr"
Import "../../ts_to_ranger/generated/pacman_native_generated.rgr"

class PacmanNativeGame extends NativeGameBridge {
    def script:GeneratedGameScript (new GeneratedGameScript)

    fn setupScene:void () {
        def init:NativeGameState (script.initState())
        def defs:[SpriteDefNative] (script.sprites())
        runner.setupScene(init defs)
    }

    fn frame:void (dtMs:int up:boolean down:boolean left:boolean right:boolean action:boolean) {
        runner.advanceTime(dtMs)
        def props:UpdatePropsNative (runner.buildProps(dtMs up down left right action))
        def patch:NativeGameState (script.update(props))
        runner.applyScriptPatch(patch props)
    }
}

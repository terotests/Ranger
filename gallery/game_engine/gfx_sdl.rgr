    gfx_set_fullscreen _:void (on:int) {
        templates {
            cpp ( "rgfx_set_fullscreen(" (e 1) ")" (imp "<SDL2/SDL.h>") )
            es6 ( "undefined" )
        }
    }

    ; Toggle desktop fullscreen (scaled). Returns 1 when fullscreen, 0 windowed.
    gfx_toggle_fullscreen _:int () {
        templates {

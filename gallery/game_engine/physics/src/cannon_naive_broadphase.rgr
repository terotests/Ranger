; ==============================================================================
; cannon_naive_broadphase — O(n^2) broadphase (Cannon.js port).
; ==============================================================================

Import "cannon_broadphase.rgr"
Import "cannon_body.rgr"

class CannonNaiveBroadphase extends CannonBroadphase {
    fn collisionPairs:void (bodies:[CannonBody] pairs1:[CannonBody] pairs2:[CannonBody]) {
        def n:int (array_length bodies)
        def i 0
        while (i < n) {
            def j 0
            while (j < i) {
                def bi:CannonBody (itemAt bodies i)
                def bj:CannonBody (itemAt bodies j)
                if (this.needBroadphaseCollision(bi bj)) {
                    this.intersectionTest(bi bj pairs1 pairs2)
                }
                j = (j + 1)
            }
            i = (i + 1)
        }
    }
}

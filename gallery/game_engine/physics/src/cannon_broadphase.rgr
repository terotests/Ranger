; ==============================================================================
; cannon_broadphase — broadphase base (Cannon.js port subset).
; ==============================================================================

Import "cannon_vec3.rgr"
Import "cannon_body.rgr"

class CannonBroadphase {
    def useBoundingBoxes:boolean false
    def dirty:boolean true
    def tmpRel:CannonVec3 (new CannonVec3)
    def outPairs1:[CannonBody]
    def outPairs2:[CannonBody]

    fn needBroadphaseCollision:boolean (bodyA:CannonBody bodyB:CannonBody) {
        def aStatic:boolean (bodyA.type == 2)
        def bStatic:boolean (bodyB.type == 2)
        def aSleep:boolean (bodyA.sleepState != 0)
        def bSleep:boolean (bodyB.sleepState != 0)
        if (aStatic || aSleep) {
            if (bStatic || bSleep) {
                return false
            }
        }
        return true
    }

    fn doBoundingSphereBroadphase:void (bodyA:CannonBody bodyB:CannonBody) {
        def r:CannonVec3 this.tmpRel
        bodyB.position.vsub(bodyA.position r)
        def sum:double (bodyA.boundingRadius + bodyB.boundingRadius)
        def sum2:double (sum * sum)
        def norm2:double r.norm2()
        if (norm2 < sum2) {
            push this.outPairs1 bodyA
            push this.outPairs2 bodyB
        }
    }

    fn intersectionTest:void (bodyA:CannonBody bodyB:CannonBody) {
        this.doBoundingSphereBroadphase(bodyA bodyB)
    }
}

; ==============================================================================
; cannon_body_test — Cannon.js test/Body.js ported to Ranger (subset).
; ==============================================================================

Import "cannon_vec3.rgr"
Import "cannon_quaternion.rgr"
Import "cannon_box.rgr"
Import "cannon_sphere.rgr"
Import "cannon_body.rgr"
Import "cannon_test_harness.rgr"
Import "cannon_test_filter.rgr"

class CannonBodyTest {
    def filter:CannonTestFilter (new CannonTestFilter)

    fn runFiltered:void (h:CannonTestHarness filter:string) {
        if (this.filter.matches(filter "Body.computeAABB.box")) { this.computeAabbBox(h) }
        if (this.filter.matches(filter "Body.computeAABB.boxOffset")) { this.computeAabbBoxOffset(h) }
        if (this.filter.matches(filter "Body.pointToLocalFrame")) { this.pointToLocalFrame(h) }
        if (this.filter.matches(filter "Body.pointToWorldFrame")) { this.pointToWorldFrame(h) }
        if (this.filter.matches(filter "Body.applyForce")) { this.applyForce(h) }
        if (this.filter.matches(filter "Body.applyImpulse")) { this.applyImpulse(h) }
        if (this.filter.matches(filter "Body.applyLocalForce")) { this.applyLocalForce(h) }
    }

    fn computeAabbBox:void (h:CannonTestHarness) {
        h.beginTest("Body.computeAABB.box")
        def body:CannonBody (new CannonBody)
        body.initDynamic(1.0)
        def half:CannonVec3 (new CannonVec3)
        half.set(1.0 1.0 1.0)
        def box:CannonBox (new CannonBox)
        box.initBox(half)
        body.addShape(box)
        body.computeAABB()
        h.equal(body.aabb.lowerBound.x (0.0 - 1.0) "min x")
        h.equal(body.aabb.lowerBound.y (0.0 - 1.0) "min y")
        h.equal(body.aabb.lowerBound.z (0.0 - 1.0) "min z")
        h.equal(body.aabb.upperBound.x 1.0 "max x")
        h.equal(body.aabb.upperBound.y 1.0 "max y")
        h.equal(body.aabb.upperBound.z 1.0 "max z")
        body.position.x = 1.0
        body.computeAABB()
        h.equal(body.aabb.lowerBound.x 0.0 "shifted min x")
        h.equal(body.aabb.upperBound.x 2.0 "shifted max x")
        h.finishTest()
    }

    fn computeAabbBoxOffset:void (h:CannonTestHarness) {
        h.beginTest("Body.computeAABB.boxOffset")
        def body:CannonBody (new CannonBody)
        body.initDynamic(1.0)
        def half:CannonVec3 (new CannonVec3)
        half.set(1.0 1.0 1.0)
        def box:CannonBox (new CannonBox)
        box.initBox(half)
        def offset:CannonVec3 (new CannonVec3)
        offset.set(1.0 1.0 1.0)
        body.addShapeOffset(box offset)
        body.computeAABB()
        h.equal(body.aabb.lowerBound.x 0.0 "min x")
        h.equal(body.aabb.upperBound.x 2.0 "max x")
        body.position.x = 1.0
        body.computeAABB()
        h.equal(body.aabb.lowerBound.x 1.0 "offset min x")
        h.equal(body.aabb.upperBound.x 3.0 "offset max x")
        h.finishTest()
    }

    fn pointToLocalFrame:void (h:CannonTestHarness) {
        h.beginTest("Body.pointToLocalFrame")
        def body:CannonBody (new CannonBody)
        body.initDynamic(1.0)
        def sphere:CannonSphere (new CannonSphere)
        sphere.initSphere(1.0)
        body.addShape(sphere)
        body.position.set(1.0 2.0 2.0)
        def worldPoint:CannonVec3 (new CannonVec3)
        worldPoint.set(1.0 2.0 3.0)
        def localPoint:CannonVec3 (new CannonVec3)
        body.pointToLocalFrame(worldPoint localPoint)
        def expected:CannonVec3 (new CannonVec3)
        expected.set(0.0 0.0 1.0)
        def localOk:boolean (localPoint.almostEquals(expected 0.001))
        h.ok(localOk "local point")
        h.finishTest()
    }

    fn pointToWorldFrame:void (h:CannonTestHarness) {
        h.beginTest("Body.pointToWorldFrame")
        def body:CannonBody (new CannonBody)
        body.initDynamic(1.0)
        def sphere:CannonSphere (new CannonSphere)
        sphere.initSphere(1.0)
        body.addShape(sphere)
        body.position.set(1.0 2.0 2.0)
        def localPoint:CannonVec3 (new CannonVec3)
        localPoint.set(1.0 0.0 0.0)
        def worldPoint:CannonVec3 (new CannonVec3)
        body.pointToWorldFrame(localPoint worldPoint)
        def expected:CannonVec3 (new CannonVec3)
        expected.set(2.0 2.0 2.0)
        def worldOk:boolean (worldPoint.almostEquals(expected 0.001))
        h.ok(worldOk "world point")
        h.finishTest()
    }

    fn applyForce:void (h:CannonTestHarness) {
        h.beginTest("Body.applyForce")
        def body:CannonBody (new CannonBody)
        body.initDynamic(1.0)
        def sphere:CannonSphere (new CannonSphere)
        sphere.initSphere(1.0)
        body.addShape(sphere)
        def worldPoint:CannonVec3 (new CannonVec3)
        worldPoint.set(1.0 0.0 0.0)
        def forceVector:CannonVec3 (new CannonVec3)
        forceVector.set(0.0 1.0 0.0)
        body.applyForce(forceVector worldPoint)
        h.equal(body.force.y 1.0 "force y")
        h.equal(body.torque.z 1.0 "torque z")
        h.finishTest()
    }

    fn applyImpulse:void (h:CannonTestHarness) {
        h.beginTest("Body.applyImpulse")
        def body:CannonBody (new CannonBody)
        body.initDynamic(1.0)
        def sphere:CannonSphere (new CannonSphere)
        sphere.initSphere(1.0)
        body.addShape(sphere)
        def dt:double 0.016666666666666666
        def f:double 1000.0
        def imp:double (f * dt)
        def impulse:CannonVec3 (new CannonVec3)
        impulse.set(imp 0.0 0.0)
        def worldPoint:CannonVec3 (new CannonVec3)
        worldPoint.setZero()
        body.applyImpulse(impulse worldPoint)
        def expected:CannonVec3 (new CannonVec3)
        expected.set(imp 0.0 0.0)
        def velOk:boolean (body.velocity.almostEquals(expected 0.001))
        h.ok(velOk "velocity after impulse")
        h.finishTest()
    }

    fn applyLocalForce:void (h:CannonTestHarness) {
        h.beginTest("Body.applyLocalForce")
        def body:CannonBody (new CannonBody)
        body.initDynamic(1.0)
        def sphere:CannonSphere (new CannonSphere)
        sphere.initSphere(1.0)
        body.addShape(sphere)
        def axis:CannonVec3 (new CannonVec3)
        axis.set(1.0 0.0 0.0)
        def pi:double 3.141592653589793
        body.quaternion.setFromAxisAngle(axis (pi / 2.0))
        def localPoint:CannonVec3 (new CannonVec3)
        localPoint.set(1.0 0.0 0.0)
        def localForce:CannonVec3 (new CannonVec3)
        localForce.set(0.0 1.0 0.0)
        body.applyLocalForce(localForce localPoint)
        def expected:CannonVec3 (new CannonVec3)
        expected.set(0.0 0.0 1.0)
        def forceOk:boolean (body.force.almostEquals(expected 0.001))
        h.ok(forceOk "rotated force")
        h.finishTest()
    }
}

; ==============================================================================
; cannon_world_test — Cannon.js World tests + pinball-style gravity demo.
; ==============================================================================

Import "cannon_vec3.rgr"
Import "cannon_sphere.rgr"
Import "cannon_body.rgr"
Import "cannon_world.rgr"
Import "cannon_test_harness.rgr"
Import "cannon_test_filter.rgr"

class CannonWorldTest {
    def filter:CannonTestFilter (new CannonTestFilter)

    fn runFiltered:void (h:CannonTestHarness filter:string) {
        if (this.filter.matches(filter "World.clearForces")) { this.clearForces(h) }
        if (this.filter.matches(filter "World.gravityStep")) { this.gravityStep(h) }
        if (this.filter.matches(filter "World.collisionMatrix")) { this.collisionMatrix(h) }
        if (this.filter.matches(filter "World.sphereBounce")) { this.sphereBounce(h) }
    }

    fn clearForces:void (h:CannonTestHarness) {
        h.beginTest("World.clearForces")
        def world:CannonWorld (new CannonWorld)
        world.initWorld()
        def body:CannonBody (new CannonBody)
        body.initDynamic(1.0)
        world.addBody(body)
        body.force.set(1.0 2.0 3.0)
        body.torque.set(4.0 5.0 6.0)
        world.clearForces()
        def zero:CannonVec3 (new CannonVec3)
        zero.setZero()
        def forceClear:boolean (body.force.almostEquals(zero 0.001))
        h.ok(forceClear "force cleared")
        def torqueClear:boolean (body.torque.almostEquals(zero 0.001))
        h.ok(torqueClear "torque cleared")
        h.finishTest()
    }

    fn gravityStep:void (h:CannonTestHarness) {
        h.beginTest("World.gravityStep")
        def world:CannonWorld (new CannonWorld)
        world.initWorld()
        world.setGravity(0.0 (0.0 - 10.0) 0.0)
        def ball:CannonBody (new CannonBody)
        ball.initDynamic(1.0)
        def sphere:CannonSphere (new CannonSphere)
        sphere.initSphere(0.5)
        ball.addShape(sphere)
        ball.position.set(100.0 50.0 0.0)
        world.addBody(ball)
        def dt:double 0.016666666666666666
        def steps:int 30
        def i 0
        while (i < steps) {
            world.step(dt)
            i = (i + 1)
        }
        def vy:double ball.velocity.y
        def falling:boolean (vy < 0.0)
        h.ok(falling "ball should fall (negative vy in Y-down world)")
        def py:double ball.position.y
        def decreased:boolean (py < 50.0)
        h.ok(decreased "ball y should decrease")
        print ("pinballDemoY=" + (to_string py))
        print ("pinballDemoVy=" + (to_string vy))
        h.finishTest()
    }

    fn pairShouldCollide:boolean (i:int j:int) {
        if (i == 0) {
            if (j == 1) {
                return true
            }
        }
        if (i == 2) {
            if (j == 3) {
                return true
            }
        }
        if (i == 4) {
            if (j == 5) {
                return true
            }
        }
        return false
    }

    fn collisionMatrix:void (h:CannonTestHarness) {
        h.beginTest("World.collisionMatrix")
        def world:CannonWorld (new CannonWorld)
        world.initWorld()
        def positions:[CannonVec3]
        def p00:CannonVec3 (new CannonVec3)
        p00.set(0.0 0.0 0.0)
        push positions p00
        def p01:CannonVec3 (new CannonVec3)
        p01.set(2.0 0.0 0.0)
        push positions p01
        def p02:CannonVec3 (new CannonVec3)
        p02.set(0.0 4.0 0.0)
        push positions p02
        def p03:CannonVec3 (new CannonVec3)
        p03.set(2.0 4.0 0.0)
        push positions p03
        def p04:CannonVec3 (new CannonVec3)
        p04.set(0.0 8.0 0.0)
        push positions p04
        def p05:CannonVec3 (new CannonVec3)
        p05.set(2.0 8.0 0.0)
        push positions p05
        def bodyIdx 0
        while (bodyIdx < (array_length positions)) {
            def body:CannonBody (new CannonBody)
            body.initDynamic(1.0)
            def sphere:CannonSphere (new CannonSphere)
            sphere.initSphere(1.1)
            body.addShape(sphere)
            def pos:CannonVec3 (itemAt positions bodyIdx)
            body.position.copy(pos)
            world.addBody(body)
            bodyIdx = (bodyIdx + 1)
        }
        def stepIdx 0
        while (stepIdx < 2) {
            world.step(0.1)
            def isFirstStep:boolean (stepIdx == 0)
            def collI 0
            while (collI < (array_length world.bodies)) {
                def collJ:int (collI + 1)
                while (collJ < (array_length world.bodies)) {
                    def bodyI:CannonBody (itemAt world.bodies collI)
                    def bodyJ:CannonBody (itemAt world.bodies collJ)
                    def expected:boolean (this.pairShouldCollide(collI collJ))
                    def isColliding:boolean false
                    if (isFirstStep) {
                        def cur:int (world.collisionMatrix.get(bodyI bodyJ))
                        isColliding = (cur != 0)
                    } {
                        def prev:int (world.collisionMatrixPrevious.get(bodyI bodyJ))
                        isColliding = (prev != 0)
                    }
                    def ok:boolean (isColliding == expected)
                    h.ok(ok "collision matrix pair")
                    collJ = (collJ + 1)
                }
                collI = (collI + 1)
            }
            stepIdx = (stepIdx + 1)
        }
        h.finishTest()
    }

    fn sphereBounce:void (h:CannonTestHarness) {
        h.beginTest("World.sphereBounce")
        def world:CannonWorld (new CannonWorld)
        world.initWorld()
        world.defaultContactMaterial.restitution = 0.9
        def left:CannonBody (new CannonBody)
        left.initDynamic(1.0)
        def sphereL:CannonSphere (new CannonSphere)
        sphereL.initSphere(20.0)
        left.addShape(sphereL)
        left.position.set(100.0 135.0 0.0)
        left.velocity.set(200.0 0.0 0.0)
        def right:CannonBody (new CannonBody)
        right.initDynamic(1.0)
        def sphereR:CannonSphere (new CannonSphere)
        sphereR.initSphere(20.0)
        right.addShape(sphereR)
        right.position.set(300.0 135.0 0.0)
        right.velocity.set((0.0 - 150.0) 0.0 0.0)
        world.addBody(left)
        world.addBody(right)
        def step 0
        while (step < 120) {
            world.step(0.016666666666666666)
            step = (step + 1)
        }
        def lvx:double left.velocity.x
        def rvx:double right.velocity.x
        def bounced:boolean false
        if (lvx < 0.0) {
            bounced = true
        }
        if (rvx > 0.0) {
            bounced = true
        }
        h.ok(bounced "bodies should bounce apart")
        def dist:double (right.position.x - left.position.x)
        def separated:boolean (dist >= 38.0)
        h.ok(separated "bodies should stay separated")
        h.finishTest()
    }
}

; ==============================================================================
; cannon_tsx_bridge_test — the interpreted cannon-es scene drives the REAL engine
; through the 1:1 native binding (no per-demo reconciliation).
; ==============================================================================
; The canonical cannon-es script (cannon_box_scene.tsx) runs in the TSX
; interpreter against the cannon.tsx façade. Every CANNON.* object is a handle to
; one host Cannon* object via CannonNativeBridge; world.fixedStep() calls the real
; CannonWorld.step() and pulls each body's pose back into its view. So the
; interpreted `mesh.position.copy(body.position)` reads simulated data straight
; from the engine — the host is the single source of truth.
;
;   - after init(): one body built host-side (bodyCount == 1).
;   - after 60 interpreted animate() frames: the façade mesh FELL (position.y < 0,
;     gravity integrated in the real engine) and SPUN (quaternion.y != 0, from the
;     initial angularVelocity forwarded to the host).
; ==============================================================================

Import "cannon_native_bridge.rgr"
Import "../../../pdf_writer/src/jsx/ComponentEngine.rgr"
Import "../../../pdf_writer/src/jsx/EvalValue.rgr"

class CannonTsxBridgeTest {
    sfn callNum:double (engine:ComponentEngine name:string) {
        def r:EvalValue (engine.callFunction(name (EvalValue.null())))
        return (r.toNumber())
    }

    sfn m@(main):void () {
        def engine (new ComponentEngine())
        engine.quiet = true

        ; The host Cannon engine, exposed to the interpreter as native functions.
        def bridge (new CannonNativeBridge)
        engine.setNativeBridge(bridge)

        def facade:buffer (buffer_read_file "gallery/game_engine/physics/tsx" "cannon.tsx")
        def scene:buffer (buffer_read_file "gallery/game_engine/physics/tsx" "cannon_box_scene.tsx")
        def src:string ((buffer_to_string facade) + "\n" + (buffer_to_string scene))
        engine.loadScript(src)
        def initR:EvalValue (engine.callFunction("init" (EvalValue.null())))

        def y0:double (CannonTsxBridgeTest.callNum(engine "meshY"))
        def bodies:double (CannonTsxBridgeTest.callNum(engine "bodyCount"))

        def f:int 0
        while (f < 60) {
            def t:EvalValue (engine.callFunction("tick" (EvalValue.null())))
            f = (f + 1)
        }

        def yN:double (CannonTsxBridgeTest.callNum(engine "meshY"))
        def qyN:double (CannonTsxBridgeTest.callNum(engine "meshQuatY"))
        def steps:double (CannonTsxBridgeTest.callNum(engine "stepCount"))

        def passed:int 0
        def failed:int 0
        print "== interpreted cannon-es scene drove the real engine (1:1 handles) =="
        print ("bodies=" + (to_string bodies) + " y0=" + (to_string y0) + " yN=" + (to_string yN) + " qyN=" + (to_string qyN) + " steps=" + (to_string steps))

        if (bodies == 1.0) {
            passed = (passed + 1)
            print "  PASS one body built host-side from the façade constructor"
        } {
            failed = (failed + 1)
            print "  FAIL expected exactly one body"
        }
        if (yN < (0.0 - 0.1)) {
            passed = (passed + 1)
            print "  PASS mesh fell under gravity (real engine pose synced to the view)"
        } {
            failed = (failed + 1)
            print "  FAIL mesh did not fall — the native step/sync did not drive the mesh"
        }
        def absQ:double qyN
        if (absQ < 0.0) {
            absQ = (0.0 - absQ)
        }
        if (absQ > 0.01) {
            passed = (passed + 1)
            print "  PASS mesh spun (angularVelocity forwarded to the host and integrated)"
        } {
            failed = (failed + 1)
            print "  FAIL mesh did not spin — angularVelocity not forwarded/integrated"
        }
        if (steps >= 60.0) {
            passed = (passed + 1)
            print "  PASS interpreted animate() stepped the real world each frame"
        } {
            failed = (failed + 1)
            print "  FAIL step count too low"
        }

        print "== summary =="
        print ("passed=" + (to_string passed) + " failed=" + (to_string failed))
        if (failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }
}

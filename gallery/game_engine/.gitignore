# Per-game runtime save data (written by loadGameData/saveGameData).
**/gamedata.json

# Generated native build artifacts (regenerate with the engine:* npm scripts).
# The static-Ranger reference games live in ranger_games/; their ES6 build
# (ranger_games/pong.js) is committed as the desktop reference. The patterns
# below are unanchored, so they also cover generated output under ranger_games/.
pong.cpp
pong.rs
pong.go
pong.ll
pong_sdl.cpp
pong_sdl
variant.hpp
*.o
*.exe
/ranger_games/pong
pong_cpp
pong_rs

# Compiled ES6 output of the headless UI game-runner demo (regenerate: npm run engine:ui:game)
scripting/ui_menu_runner_demo.js

# Compiled ES6 output of headless .as-source demos (regenerate by recompiling the .rgr)
scripting/pose_provider_demo.js
scripting/as_autopeli_src_demo.js
scripting/as_sprite_demo.js
scripting/as_source_demo.js
scripting/pyorretris2p_demo.js
scripting/menu_launcher_demo.js
scripting/menu_tsx_render_demo.js
scripting/menu_tsx_fit_demo.js
scripting/game_catalog_demo.js
scripting/game_icon_shots_demo.js


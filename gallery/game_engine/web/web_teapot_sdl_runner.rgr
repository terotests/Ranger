; ==============================================================================
; web_teapot_sdl_runner — the Three.js teapot on native SDL2 + OpenGL/GLES2.
; ==============================================================================
; A self-contained SDL2 + GL host for the teapot: gfx_sdl opens the window and GL
; context; the SAME Ranger scene the browser runs (WebTeapotProbe — lighting, the
; Utah TeapotGeometry, OrbitControls, the EVG GUI panel and cube-map reflections)
; is drawn through ThreeGLBackend's cpp (GLES2) templates. The mouse orbits the
; teapot, the wheel zooms, and clicking the panel changes tessellation / parts /
; shading — the full example, native. On the Raspberry Pi the same code drives the
; HDMI framebuffer via GLES2 (gfx_sdl selects GLES2 on ARM).
;
; Build & run:  gallery/game_engine/scripts/build-teapot-sdl.sh --run
; Headless smoke (N frames, offscreen): pass a frame count as the first CLI arg.
; ==============================================================================

Import "../gfx_sdl.rgr"
Import "./web_teapot_gl_probe.rgr"

class WebTeapotSdlRunner {
    sfn argOr:string (index:int dflt:string) {
        if ((shell_arg_cnt) > index) {
            def a:string (shell_arg index)
            if ((strlen a) > 0) {
                return a
            }
        }
        return dflt
    }

    sfn m@(main):void () {
        def w:int 960
        def h:int 720
        def framesS:string (WebTeapotSdlRunner.argOr(0 "0"))
        def maxFrames:int (unwrap (str2int framesS))

        ; gfx_open (the 2D SDL_Renderer entry) carries the whole gfx_sdl C shim in
        ; its polyfill; a GPU-only runner uses gfx_open_gpu, so reference gfx_open
        ; from an unreachable branch to force the shim (rgfx_* / g_rgfx_*) into the
        ; build. Never executes (h > 0). TODO: relocate the shim to a foundational
        ; operator (e.g. gfx_input_poll) so GPU runners don't need this.
        if (h < 0) {
            def shimForce:int (gfx_open "" 1 1)
        }

        def win:int (gfx_open_gpu "Ranger Teapot" w h)
        if (win == 0) {
            print "[teapot-sdl] gfx_open_gpu failed (no GL context)"
            return
        }

        def probe:WebTeapotProbe (new WebTeapotProbe)
        def ok:boolean (probe.setupGL(""))
        if (ok == false) {
            print "[teapot-sdl] setupGL failed"
            return
        }
        probe.setSize(w h)

        ; GUI panel: upload its RGBA once, re-upload when a click changes it.
        def gw:int (probe.guiW())
        def gh:int (probe.guiH())
        def panelBuf:buffer (probe.guiRGBA())
        def guiTex:int (gpu_make_texture panelBuf gw gh)
        def panelX:int (w - gw)

        def prevBtn:int 0
        def running:boolean true
        def frames:int 0
        print "[teapot-sdl] running — drag to orbit, wheel to zoom, click the panel, Q/Esc to quit"

        while running {
            gfx_input_poll
            def mx:int (gfx_mouse_x)
            def my:int (gfx_mouse_y)
            def btn:int (gfx_mouse_buttons)
            def wheel:int (gfx_mouse_wheel)
            def leftNow:int (bit_and btn 1)
            def leftPrev:int (bit_and prevBtn 1)

            if ((leftPrev == 0) && (leftNow == 1)) {
                if ((mx >= panelX) && (my <= gh)) {
                    def changed:boolean (probe.guiPointerDown((to_double (mx - panelX)) (to_double my)))
                    if changed {
                        def nb:buffer (probe.guiRGBA())
                        guiTex = (gpu_make_texture nb gw gh)
                    }
                } {
                    probe.onPointerDown((to_double mx) (to_double my) 0)
                }
            }
            if ((leftPrev == 1) && (leftNow == 1)) {
                probe.onPointerMove((to_double mx) (to_double my))
            }
            if ((leftPrev == 1) && (leftNow == 0)) {
                probe.onPointerUp()
            }
            if (wheel != 0) {
                probe.onWheel(((to_double (0 - wheel)) * 100.0))
            }
            prevBtn = btn

            probe.frame()
            gpu_draw_overlay guiTex panelX 0 gw gh w h
            ; headless capture: save the last frame if a path was given as arg 1
            def capPath:string (WebTeapotSdlRunner.argOr(1 ""))
            if ((strlen capPath) > 0) {
                if ((maxFrames > 0) && ((frames + 1) >= maxFrames)) {
                    gpu_save_ppm capPath w h
                }
            }
            gfx_gl_swap
            gfx_delay 16

            frames = (frames + 1)
            if (gfx_should_close) {
                running = false
            }
            def mask:int (gfx_input_source_mask 0)
            if ((bit_and mask 8) != 0) {
                running = false
            }
            if ((maxFrames > 0) && (frames >= maxFrames)) {
                running = false
            }
        }
        print ("[teapot-sdl] done frames=" + (to_string frames))
        gfx_close
    }
}

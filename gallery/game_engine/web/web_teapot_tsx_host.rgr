; ==============================================================================
; web_teapot_tsx_host — run the teapot example (teapot.tsx) on the GPU, interpreted.
; ==============================================================================
;
; The teapot counterpart to web_tsx3d_gl_host (the cube). teapot.tsx (the editable
; webgl_geometry_teapot scene code) runs in ComponentEngine against the three.tsx
; façade; ThreeTeapotTsxBridge reconciles it into the Ranger Three core each frame;
; ThreeGLBackend draws it with real WebGL. OrbitControls + the lil-gui panel are
; host plumbing (Ranger ThreeOrbitControls + ThreeGuiOverlay) that drive the
; interpreted scene via its exported hooks (setCamera / setShading / setTess /
; setBool) — so the editor shows the teapot's scene code and edits hot-reload.
;
; Exposes the SAME flat API as the compiled WebTeapotProbe, so the same JS viewer
; drives either. No JavaScript in the engine — compiles to C++ too.
; ==============================================================================

Import "../three/tsx/three_teapot_tsx_bridge.rgr"
Import "../three/src/three_gl_backend.rgr"
Import "../three/src/three_orbit_controls.rgr"
Import "../three/src/three_gui_overlay.rgr"

class WebTeapotTsxHost {
    def engine:ComponentEngine (new ComponentEngine())
    def bridge:ThreeTeapotTsxBridge (new ThreeTeapotTsxBridge)
    def gl:ThreeGLBackend (new ThreeGLBackend)
    def controls:ThreeOrbitControls (new ThreeOrbitControls)
    def gui:ThreeGuiOverlay (new ThreeGuiOverlay)
    def ready:boolean false
    def sceneDirty:boolean true
    def w:int 600
    def h:int 600

    fn registerGlobals:void (winW:int winH:int dpr:double) {
        def tk:[string]
        def tv:[EvalValue]
        push tk "SRGBColorSpace"
        push tv (EvalValue.string("srgb"))
        push tk "DoubleSide"
        push tv (EvalValue.number(2.0))
        push tk "FrontSide"
        push tv (EvalValue.number(0.0))
        push tk "BackSide"
        push tv (EvalValue.number(1.0))
        push tk "RepeatWrapping"
        push tv (EvalValue.number(1000.0))
        engine.registerGlobal("THREE" (EvalValue.object(tk tv)))

        def wk:[string]
        def wv:[EvalValue]
        push wk "innerWidth"
        push wv (EvalValue.number((to_double winW)))
        push wk "innerHeight"
        push wv (EvalValue.number((to_double winH)))
        push wk "devicePixelRatio"
        push wv (EvalValue.number(dpr))
        engine.registerGlobal("window" (EvalValue.object(wk wv)))
    }

    fn setupGL:boolean (canvasId:string) {
        def ok:boolean (gl.init(canvasId))
        if (ok == false) {
            return false
        }
        bridge.useBackend(gl)
        return true
    }

    ; Load the façade + teapot scene (concatenated), run init() + renderScene() to
    ; build the scene, then set up the host controls from the interpreted camera.
    fn load:string (facadeSrc:string teapotSrc:string winW:int winH:int dpr:double) {
        w = winW
        h = winH
        engine.quiet = true
        this.registerGlobals(winW winH dpr)
        bridge.setEngine(engine)
        def src:string ((facadeSrc + "\n") + teapotSrc)
        engine.loadScript(src)
        engine.callFunction("init" (EvalValue.null()))
        engine.callFunction("renderScene" (EvalValue.null()))
        this.initControls()
        ready = true
        sceneDirty = true
        return "ok"
    }

    fn loadFromVfs:string (dir:string facadeFile:string teapotFile:string winW:int winH:int dpr:double) {
        def f:buffer (buffer_read_file dir facadeFile)
        def c:buffer (buffer_read_file dir teapotFile)
        return (this.load((buffer_to_string f) (buffer_to_string c) winW winH dpr))
    }

    ; initialise OrbitControls from the interpreted camera's starting position.
    fn initControls:void () {
        bridge.syncCamera()
        controls.setViewport(w h)
        controls.setDistanceRange(400.0 20000.0)
        controls.setCamera(bridge.camera)
        controls.setTarget(0.0 0.0 0.0)
        ; orient the camera at the teapot immediately (the example relies on
        ; OrbitControls for this; here the host controls own it), and write the
        ; oriented position back into the interpreted camera.
        controls.applyToCamera()
        this.pushCamera()
    }

    ; push the orbit camera position back into the interpreted scene.
    fn pushCamera:void () {
        def k:[string]
        def v:[EvalValue]
        push k "x"
        push v (EvalValue.number(bridge.camera.position.x))
        push k "y"
        push v (EvalValue.number(bridge.camera.position.y))
        push k "z"
        push v (EvalValue.number(bridge.camera.position.z))
        engine.callFunction("setCamera" (EvalValue.object(k v)))
    }

    fn frame:void () {
        if (ready == false) {
            return
        }
        bridge.renderFrame(w h)
    }

    fn setSize:void (winW:int winH:int) {
        w = winW
        h = winH
        controls.setViewport(winW winH)
    }

    ; --- pointer input → orbit ------------------------------------------------
    fn onPointerDown:void (x:double y:double button:int) {
        controls.pointerDown(x y button)
    }
    fn onPointerMove:void (x:double y:double) {
        controls.pointerMove(x y)
        this.pushCamera()
    }
    fn onPointerUp:void () {
        controls.pointerUp()
    }
    fn onWheel:void (delta:double) {
        controls.wheel(delta)
        this.pushCamera()
    }

    ; --- GUI overlay ----------------------------------------------------------
    fn guiRGBA:buffer () {
        return (gui.render())
    }
    fn guiW:int () {
        return (gui.width())
    }
    fn guiH:int () {
        return (gui.height())
    }
    fn shadingName:string (idx:int) {
        if (idx == 0) { return "wireframe" }
        if (idx == 1) { return "flat" }
        if (idx == 2) { return "smooth" }
        if (idx == 3) { return "glossy" }
        if (idx == 4) { return "textured" }
        return "reflective"
    }
    fn boolVal:EvalValue (name:string on:boolean) {
        def k:[string]
        def v:[EvalValue]
        push k "name"
        push v (EvalValue.string(name))
        push k "on"
        push v (EvalValue.boolean(on))
        return (EvalValue.object(k v))
    }
    ; A click on the panel → mutate the interpreted effectController via the hooks.
    fn guiPointerDown:boolean (x:double y:double) {
        def changed:boolean (gui.pointerDown(x y))
        if changed {
            engine.callFunction("setShading" (EvalValue.string((this.shadingName(gui.shadingIndex)))))
            engine.callFunction("setTess" (EvalValue.number((to_double gui.tess))))
            engine.callFunction("setBool" (this.boolVal("lid" gui.dispLid)))
            engine.callFunction("setBool" (this.boolVal("body" gui.dispBody)))
            engine.callFunction("setBool" (this.boolVal("bottom" gui.dispBottom)))
            engine.callFunction("setBool" (this.boolVal("fitLid" gui.fitLid)))
            def nb:boolean (gui.blinn == false)
            engine.callFunction("setBool" (this.boolVal("nonblinn" nb)))
            sceneDirty = true
        }
        return changed
    }

    fn needsRender:boolean () {
        def a:boolean (controls.consumeDirty())
        def b:boolean sceneDirty
        sceneDirty = false
        return (a || b)
    }

    ; idle spin unused (the teapot is on-demand), kept for viewer API parity.
    fn spin:void (dy:double) {
    }

    fn isReady:boolean () {
        return ready
    }
    fn getSource:string () {
        return ""
    }
}

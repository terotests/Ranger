; ==============================================================================
; web_game_host — browser-facing runner for the JS/canvas host.
; ==============================================================================
;
; Wraps GameRunner with the same wiring the native/SDL runner does, but with no
; SDL/native dependency, so it compiles cleanly to es6 and runs in the browser:
;
;   * setNativeBridge(GameHostNativeBridge) — REQUIRED for games that draw a
;     static background in createStaticBg(): that hook's bgFillRect / bgFillCircle
;     calls are dispatched through the engine's native bridge, and without a
;     bridge installed they silently no-op (the sky/platforms never render).
;   * a flat two-player frame() the JS harness can call with plain booleans;
;     the GameInputSnapshot is assembled here so JS never touches input masks.
;
; The JS harness drives: init -> loadGame -> (frame -> draw -> raw)*.
; ==============================================================================

Import "../scripting/game_runtime.rgr"
Import "../scripting/game_host_native.rgr"
Import "../scripting/game_audio.rgr"
Import "../scripting/game_input.rgr"

; Audio sink that captures the engine's synthesised PCM instead of playing it
; through SDL. GameAudio calls onSynthPlay(id, rate, frames, pcm) for every
; sound (each note of a win/celebrate arpeggio is a separate call); we queue the
; int16 mono PCM buffers for the JS harness to drain and play via Web Audio.
class WebAudioSink extends GameAudioSink {
    def qRate:[int]
    def qCount:[int]
    def qPcm:[buffer]

    fn onSynthPlay:void (soundId:string sampleRate:int sampleCount:int pcm:buffer) {
        push qRate sampleRate
        push qCount sampleCount
        push qPcm pcm
    }

    fn onClearQueue:void () {
    }

    fn pending:int () {
        return (array_length qRate)
    }

    fn rateAt:int (i:int) {
        return (itemAt qRate i)
    }

    fn countAt:int (i:int) {
        return (itemAt qCount i)
    }

    fn pcmAt:buffer (i:int) {
        return (itemAt qPcm i)
    }

    fn clear:void () {
        def er:[int]
        def ec:[int]
        def ep:[buffer]
        qRate = er
        qCount = ec
        qPcm = ep
    }
}

class WebGameHost {
    def runner:GameRunner (new GameRunner)
    def bridge:GameHostNativeBridge (new GameHostNativeBridge)
    def audioSink:WebAudioSink (new WebAudioSink)

    fn init:void (w:int h:int) {
        runner.init(w h)
    }

    ; Install the host bridge (enables createStaticBg backgrounds + host APIs),
    ; point asset resolution at the game dir, then load and build the scene.
    fn loadGame:void (scriptDir:string src:string) {
        bridge.setGameDir(scriptDir)
        runner.setNativeBridge(bridge)
        runner.setScriptDir(scriptDir)
        runner.loadScript(src)
        runner.setupScene()
        ; Route the engine's audio synth into our capture sink (after setupScene,
        ; which wires the runner's GameAudio).
        def audio:GameAudio (runner.audioRef())
        audio.sink = audioSink
    }

    ; --- audio drain (called by the JS harness after each frame) ---
    fn audioPending:int () {
        return (audioSink.pending())
    }

    fn audioRate:int (i:int) {
        return (audioSink.rateAt(i))
    }

    fn audioSamples:int (i:int) {
        return (audioSink.countAt(i))
    }

    fn audioPcm:buffer (i:int) {
        return (audioSink.pcmAt(i))
    }

    fn audioClear:void () {
        audioSink.clear()
    }

    ; Two-player flat frame. Single-player games simply ignore the p2* slot.
    ; Button order matches GameRunner.frame: up, down, left, right, action, quit.
    fn frame:void (dt:int
        up:boolean down:boolean left:boolean right:boolean action:boolean
        p2up:boolean p2down:boolean p2left:boolean p2right:boolean p2action:boolean
        quit:boolean) {
        def snap:GameInputSnapshot (new GameInputSnapshot)
        snap.playerCount = 2
        snap.p0.up = up
        snap.p0.down = down
        snap.p0.left = left
        snap.p0.right = right
        snap.p0.action = action
        snap.p0.a = action
        snap.p0.quit = quit
        snap.p1.up = p2up
        snap.p1.down = p2down
        snap.p1.left = p2left
        snap.p1.right = p2right
        snap.p1.action = p2action
        snap.p1.a = p2action
        runner.frameWithInput(dt snap)
    }

    ; Live reload: AST-diff the new source against the running script and swap
    ; only what changed (game_runtime.hotReloadScript). update/hud-only edits keep
    ; game state; initState/sprites/consts edits rebuild the scene. Returns true
    ; when the scene was rebuilt.
    fn reloadScript:boolean (src:string) {
        return (runner.hotReloadScript(src))
    }

    fn draw:void () {
        runner.draw()
    }

    fn raw:buffer () {
        return (runner.raw())
    }

    fn score1:int () {
        return runner.score1
    }

    fn score2:int () {
        return runner.score2
    }

    fn entityX:int (id:string) {
        return (runner.entityX(id))
    }

    fn entityY:int (id:string) {
        return (runner.entityY(id))
    }
}

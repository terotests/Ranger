; ==============================================================================
; pong_runner_demo - runs the scripted Pong (pong.game.tsx) via GameRunner.
; ==============================================================================
;
; Loads the TS game script, builds retained sprites once, then advances a fixed
; number of 16ms frames (deterministic scripted input), renders the final frame
; into the RGBA buffer and writes it out. Prints the ball position + score so a
; test can verify the entities actually moved and scores render.
;
; Optional CLI arg = number of frames (default 180). Frames dumped as raw RGBA
; (pong_frame.rgba) alongside this file; convert to PNG with:
;   ffmpeg -f rawvideo -pixel_format rgba -video_size 480x270 -i pong_frame.rgba out.png
; ==============================================================================

Import "../scripting/game_runtime.rgr"

class PongRunnerDemo {
    sfn m@(main):void () {
        def runner:GameRunner (new GameRunner)
        runner.init(480 270)

        ; load the game script from disk
        def buf:buffer (buffer_read_file "gallery/game_engine/scripting" "pong.game.tsx")
        def src:string (buffer_to_string buf)
        runner.setScriptDir("gallery/game_engine/scripting")
        runner.loadScript(src)
        runner.setupScene()

        def frames:int 180
        if ((shell_arg_cnt) > 0) {
            def parsed@(optional):int (to_int (shell_arg 0))
            if (!null? parsed) {
                frames = (unwrap parsed)
            }
        }

        ; advance frames with a deterministic scripted input pattern so the
        ; player paddle wiggles (proves input -> movement without a real device).
        def i 0
        while (i < frames) {
            def phase (i % 120)
            def up (phase < 40)
            def down (phase >= 80)
            runner.frame(16 up down false false false false)
            i = (i + 1)
        }

        runner.draw()
        buffer_write_file "gallery/game_engine/scripting" "pong_frame.rgba" (runner.raw())

        def bx:int (runner.entityX("ball"))
        def by:int (runner.entityY("ball"))
        print ("frames=" + frames)
        print (("ball=" + bx) + ("," + by))
        print (("score=" + runner.score1) + ("," + runner.score2))
        def audio:GameAudio (runner.audioRef())
        def audioPlays:int audio.playCount
        print (("audioPlays=" + audioPlays))
        print "pong-runner done"
    }
}

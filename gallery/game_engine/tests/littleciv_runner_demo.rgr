; ==============================================================================
; littleciv_runner_demo - headless smoke for games/littleciv/index.tsx
; ==============================================================================

Import "../scripting/game_runtime.rgr"

class LittlecivRunnerDemo {
    sfn m@(main):void () {
        def runner:GameRunner (new GameRunner)
        runner.init(480 270)

        def buf:buffer (buffer_read_file "gallery/game_engine/games/littleciv" "index.tsx")
        def src:string (buffer_to_string buf)
        runner.setScriptDir("gallery/game_engine/games/littleciv")
        runner.loadScript(src)
        runner.setupScene()

        def frames:int 240
        if ((shell_arg_cnt) > 0) {
            def parsed@(optional):int (to_int (shell_arg 0))
            if (!null? parsed) {
                frames = (unwrap parsed)
            }
        }

        def i 0
        while (i < frames) {
            def up:boolean false
            def down:boolean false
            def left:boolean false
            def right:boolean false
            def action:boolean false

            if (i == 5) { action = true }
            if (i == 20) { right = true }
            if (i == 40) { right = true }
            if (i == 60) { action = true }
            if (i == 90) { down = true }
            if (i == 120) { down = true }
            if (i == 150) { down = true }

            runner.frame(16 up down left right action false)
            i = (i + 1)
        }

        runner.draw()
        buffer_write_file "gallery/game_engine/scripting" "littleciv_frame.rgba" (runner.raw())

        def ec:int (runner.entityCount())
        def u0x:int (runner.entityX("u0"))
        def u0y:int (runner.entityY("u0"))
        def t0x:int (runner.entityX("t0"))
        def c0x:int (runner.entityX("c0"))
        print ("frames=" + frames)
        print (("entities=" + ec))
        print (("u0=" + u0x) + ("," + u0y))
        print (("t0=" + t0x))
        print (("c0=" + c0x))
        if (ec > 100) {
            print "tiles=ok"
        } {
            print "tiles=missing"
        }
        def audio:GameAudio (runner.audioRef())
        print (("audioPlays=" + audio.playCount))
        print "littleciv-runner done"
    }
}

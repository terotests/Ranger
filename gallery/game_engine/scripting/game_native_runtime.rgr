; ==============================================================================
; game_native_runtime - GameRunner without ComponentEngine (native script path).
; ==============================================================================
;
; Same retained-mode loop as game_runtime.rgr, but calls compiled Ranger game
; logic (NativeGameState / SpriteDefNative) instead of interpreting TS AST.
; ==============================================================================

Import "../framebuffer.rgr"
Import "../../ts_to_ranger/game_script_types.rgr"
Import "../../pdf_writer/src/jsx/EvalValue.rgr"
Import "./game_sprite.rgr"
Import "./game_audio.rgr"

class NativeGameRunner {
    def canvas:SoftCanvas (new SoftCanvas)
    def stateOps:NativeGameStateOps (new NativeGameStateOps)
    def host:GameHost (new GameHost)
    def audio:GameAudio (new GameAudio)
    def spriteRenderer:GameSpriteRenderer (new GameSpriteRenderer)
    def entities:[GameEntity]
    def state:NativeGameState (new NativeGameState)
    def pw:int 0
    def ph:int 0
    def score1:int 0
    def score2:int 0
    def gameOverFlag:int 0
    def fpsShown:int 0
    def timeMs:int 0
    def currentScreen:string ""

    fn init:void (w:int h:int) {
        audio.init()
        pw = w
        ph = h
        canvas.init(w h)
        host.audio = audio
        host.wireMusic()
    }

    fn half:int (n:int) {
        def result 0
        def rem n
        while (rem >= 2) {
            rem = (rem - 2)
            result = (result + 1)
        }
        return result
    }

    fn raw:buffer () {
        return (canvas.raw())
    }

    fn entityX:int (id:string) {
        def i 0
        while (i < (array_length entities)) {
            def e:GameEntity (itemAt entities i)
            if (e.id == id) {
                return e.x
            }
            i = (i + 1)
        }
        return -1
    }

    fn entityY:int (id:string) {
        def i 0
        while (i < (array_length entities)) {
            def e:GameEntity (itemAt entities i)
            if (e.id == id) {
                return e.y
            }
            i = (i + 1)
        }
        return -1
    }

    fn entityCount:int () {
        return (array_length entities)
    }

    fn setFpsShown:void (fps:int) {
        fpsShown = fps
    }

    fn pushDefField:void (keys:[string] values:[EvalValue] key:string val:EvalValue) {
        push keys key
        push values val
    }

    fn spriteDefEval:EvalValue (d:SpriteDefNative) {
        def keys:[string]
        def values:[EvalValue]
        this.pushDefField(keys values "id" (EvalValue.string(d.id)))
        this.pushDefField(keys values "kind" (EvalValue.string(d.kind)))
        if (d.kind == "bitmap") {
            this.pushDefField(keys values "px" (EvalValue.fromInt(d.px)))
            this.pushDefField(keys values "br" (EvalValue.fromInt(d.br)))
            this.pushDefField(keys values "bg" (EvalValue.fromInt(d.bg)))
            this.pushDefField(keys values "bb" (EvalValue.fromInt(d.bb)))
            this.pushDefField(keys values "er" (EvalValue.fromInt(d.er)))
            this.pushDefField(keys values "eg" (EvalValue.fromInt(d.eg)))
            this.pushDefField(keys values "eb" (EvalValue.fromInt(d.eb)))
            def frameItems:[EvalValue]
            def fi 0
            while (fi < (array_length d.frames)) {
                def rows:[string] (itemAt d.frames fi)
                def rowItems:[EvalValue]
                def ri 0
                while (ri < (array_length rows)) {
                    push rowItems (EvalValue.string((itemAt rows ri)))
                    ri = (ri + 1)
                }
                push frameItems (EvalValue.array(rowItems))
                fi = (fi + 1)
            }
            this.pushDefField(keys values "frames" (EvalValue.array(frameItems)))
        } {
            this.pushDefField(keys values "w" (EvalValue.fromInt(d.w)))
            this.pushDefField(keys values "h" (EvalValue.fromInt(d.h)))
            this.pushDefField(keys values "rad" (EvalValue.fromInt(d.rad)))
            this.pushDefField(keys values "r" (EvalValue.fromInt(d.r)))
            this.pushDefField(keys values "g" (EvalValue.fromInt(d.g)))
            this.pushDefField(keys values "b" (EvalValue.fromInt(d.b)))
            this.pushDefField(keys values "p0" (EvalValue.fromInt(d.p0)))
            this.pushDefField(keys values "p1" (EvalValue.fromInt(d.p1)))
            this.pushDefField(keys values "p2" (EvalValue.fromInt(d.p2)))
        }
        return (EvalValue.object(keys values))
    }

    fn poseEval:EvalValue (pos:EntityPoseNative) {
        def keys:[string]
        def values:[EvalValue]
        this.pushDefField(keys values "x" (EvalValue.number(pos.x)))
        this.pushDefField(keys values "y" (EvalValue.number(pos.y)))
        this.pushDefField(keys values "visible" (EvalValue.fromInt(pos.visible)))
        if (pos.r >= 0) {
            this.pushDefField(keys values "r" (EvalValue.fromInt(pos.r)))
            this.pushDefField(keys values "g" (EvalValue.fromInt(pos.g)))
            this.pushDefField(keys values "b" (EvalValue.fromInt(pos.b)))
        }
        if (pos.rad >= 0) {
            this.pushDefField(keys values "rad" (EvalValue.fromInt(pos.rad)))
        }
        this.pushDefField(keys values "p0" (EvalValue.fromInt(pos.p0)))
        this.pushDefField(keys values "p1" (EvalValue.fromInt(pos.p1)))
        this.pushDefField(keys values "p2" (EvalValue.fromInt(pos.p2)))
        return (EvalValue.object(keys values))
    }

    fn syncFromState:void () {
        def i 0
        while (i < (array_length entities)) {
            def e:GameEntity (itemAt entities i)
            def pose@(optional):EntityPoseNative (get state.entities e.id)
            if (!null? pose) {
                def posEval:EvalValue (this.poseEval((unwrap pose)))
                spriteRenderer.syncPose(e posEval pw ph)
            }
            i = (i + 1)
        }
        if (state.score1 >= 0) {
            score1 = state.score1
        }
        if (state.score2 >= 0) {
            score2 = state.score2
        }
        gameOverFlag = (this.readIntArray0("gameOver"))
    }

    fn readIntArray0:int (key:string) {
        def ks:[string] (keys state.intArrays)
        def i 0
        while (i < (array_length ks)) {
            if ((itemAt ks i) == key) {
                def arr:[int] (unwrap (get state.intArrays key))
                if ((array_length arr) > 0) {
                    return (itemAt arr 0)
                }
                return 0
            }
            i = (i + 1)
        }
        return 0
    }

    fn setupSprites:void (defs:[SpriteDefNative]) {
        def next:[GameEntity]
        def i 0
        while (i < (array_length defs)) {
            def d:SpriteDefNative (itemAt defs i)
            def e:GameEntity (new GameEntity)
            def dEval:EvalValue (this.spriteDefEval(d))
            spriteRenderer.applyDef(e dEval)
            push next e
            i = (i + 1)
        }
        entities = next
    }

    ; Register declared resources (images/sounds/sprites/collision) once.
    fn setupResources:void (list:[ResourceDefNative]) {
        host.registerResources(list)
    }

    fn setupScene:void (initState:NativeGameState sprites:[SpriteDefNative]) {
        host.audio = audio
        state = initState
        this.setupSprites(sprites)
        this.syncFromState()
    }

    fn applyUpdate:void (patch:NativeGameState) {
        ; Drain transient events emitted this frame before merging them away.
        host.drainEvents(patch.events)
        def tickMs:int 16
        if (patch.hasDt) {
            tickMs = (to_int patch.dt)
        }
        host.tickMusic(tickMs)
        state = (stateOps.mergeState(state patch))
        this.syncFromState()
    }

    fn applyScriptPatch:void (patch:NativeGameState props:UpdatePropsNative) {
        patch.dt = props.dt
        patch.hasDt = true
        this.applyUpdate(patch)
    }

    fn hostRef:GameHost () {
        return host
    }

    fn buildProps:UpdatePropsNative (dtMs:int up:boolean down:boolean left:boolean right:boolean action:boolean) {
        def props:UpdatePropsNative (new UpdatePropsNative)
        props.time = timeMs
        props.dt = (to_double dtMs)
        props.up = up
        props.down = down
        props.left = left
        props.right = right
        props.action = action
        props.state = state
        return props
    }

    fn advanceTime:void (dtMs:int) {
        timeMs = (timeMs + dtMs)
    }

    fn draw:void () {
        canvas.clear(12 16 32)
        def showNet 0
        if (state.showNet >= 0) {
            showNet = state.showNet
        }
        if (showNet != 0) {
            def ny 0
            def netX (this.half(pw))
            while (ny < ph) {
                canvas.fillRect((netX - 1) ny 2 6 40 55 95)
                ny = (ny + 12)
            }
        }
        def i 0
        while (i < (array_length entities)) {
            def e:GameEntity (itemAt entities i)
            spriteRenderer.drawEntity(e canvas)
            i = (i + 1)
        }
        def netX2 (this.half(pw))
        this.drawNumber((netX2 - 44) 10 4 score1 120 220 160)
        this.drawNumber((netX2 + 20) 10 4 score2 220 140 120)
        if (fpsShown > 0) {
            def fx (this.half(pw))
            def fy (ph - 22)
            this.drawNumber((fx - 14) fy 3 fpsShown 160 170 190)
        }
        if (gameOverFlag == 1) {
            def bx (this.half(pw))
            def by (this.half(ph))
            canvas.fillRect((bx - 70) (by - 10) 140 20 180 40 60)
            this.drawNumber((bx - 62) (by - 6) 2 score1 255 240 60)
        }
    }

    fn digitBits:string (d:int) {
        if (d == 0) { return "111101101101111" }
        if (d == 1) { return "010110010010111" }
        if (d == 2) { return "111001111100111" }
        if (d == 3) { return "111001111001111" }
        if (d == 4) { return "101101111001001" }
        if (d == 5) { return "111100111001111" }
        if (d == 6) { return "111100111101111" }
        if (d == 7) { return "111001010010010" }
        if (d == 8) { return "111101111101111" }
        if (d == 9) { return "111101111001111" }
        return "000000000000000"
    }

    fn drawDigit:void (x:int y:int scale:int d:int r:int g:int b:int) {
        def bits:string (this.digitBits(d))
        def row 0
        while (row < 5) {
            def col 0
            while (col < 3) {
                def idx ((row * 3) + col)
                def ch:string (substring bits idx (idx + 1))
                if (ch == "1") {
                    canvas.fillRect((x + (col * scale)) (y + (row * scale)) scale scale r g b)
                }
                col = (col + 1)
            }
            row = (row + 1)
        }
    }

    fn drawNumber:void (x:int y:int scale:int n:int r:int g:int b:int) {
        def ds:[int]
        def m n
        if (m <= 0) {
            push ds 0
        } {
            while (m > 0) {
                push ds (m % 10)
                m = (to_int (m / 10))
            }
        }
        def cnt (array_length ds)
        def j 0
        def step ((scale * 3) + scale)
        while (j < cnt) {
            def d:int (itemAt ds (cnt - 1 - j))
            this.drawDigit((x + (j * step)) y scale d r g b)
            j = (j + 1)
        }
    }
}

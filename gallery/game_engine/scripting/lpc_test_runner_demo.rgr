; ==============================================================================
; lpc_test_runner_demo - headless smoke: LPC sheet blit at fixed pose.
; ==============================================================================

Import "./game_runtime.rgr"

class LpcTestRunnerDemo {
    sfn m@(main):void () {
        def runner:GameRunner (new GameRunner)
        runner.init(480 270)

        def buf:buffer (buffer_read_file "gallery/game_engine/games/lpc_test" "index.tsx")
        def src:string (buffer_to_string buf)
        runner.setScriptDir("gallery/game_engine/games/lpc_test")
        runner.loadScript(src)
        runner.setupScene()

        def i 0
        while (i < 60) {
            runner.frame(16 false false false false false false)
            i = (i + 1)
        }
        runner.draw()
        buffer_write_file "gallery/game_engine/scripting" "lpc_test_frame.rgba" (runner.raw())

        def hx:int (runner.entityX("hero"))
        def hy:int (runner.entityY("hero"))
        print ("hero=" + hx + "," + hy)
        print ("entities=" + (runner.entityCount()))
        print "lpc-test-runner done"
    }
}

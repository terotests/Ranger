; ==============================================================================
; cmajor_runner_demo - headless smoke test for C-major soundscore game.
; ==============================================================================

Import "./game_runtime.rgr"

class CmajorRunnerDemo {
    sfn m@(main):void () {
        def runner:GameRunner (new GameRunner)
        runner.init(480 270)

        def buf:buffer (buffer_read_file "gallery/game_engine/games/cmajor" "index.tsx")
        def src:string (buffer_to_string buf)
        runner.setScriptDir("gallery/game_engine/games/cmajor")
        runner.loadScript(src)
        runner.setupScene()

        def i 0
        while (i < 4) {
            runner.frame(16 false false false false false false)
            i = (i + 1)
        }

        def host:GameHost (runner.hostRef())
        def audio:GameAudio (runner.audioRef())
        def piano:ScoreVoiceRender (audio.renderScoreNote("piano" "G4" 200))
        def square:ScoreVoiceRender (audio.renderScoreNote("square" "G4" 200))
        def pad:ScoreVoiceRender (audio.renderScoreNote("pad" "G4" 200))
        def diff:int 0
        def fi 0
        while (fi < 64) {
            def off:int (fi * 2)
            def pLo:int (buffer_get piano.pcm off)
            def sLo:int (buffer_get square.pcm off)
            if (pLo != sLo) {
                diff = (diff + 1)
            }
            fi = (fi + 1)
        }
        def padDiff:int 0
        fi = 0
        while (fi < 64) {
            def off2:int (fi * 2)
            def pLo2:int (buffer_get pad.pcm off2)
            def sLo2:int (buffer_get square.pcm off2)
            if (pLo2 != sLo2) {
                padDiff = (padDiff + 1)
            }
            fi = (fi + 1)
        }
        def parser:SoundScoreParser (new SoundScoreParser)
        def testScore:string "tempo 108\nbeats 4/4\n@melody guitar\n1:G4\n"
        def parsed:SoundScore (parser.parse(testScore))
        def sched:[ScheduledNote] (parser.buildSchedule(parsed))
        def schedInst:string "?"
        if ((array_length sched) > 0) {
            def ev:ScheduledNote (itemAt sched 0)
            schedInst = ev.instrument
        }
        print ("instrumentDiffSamples=" + diff)
        print ("padVsSquareDiff=" + padDiff)
        print ("parsedInstrument=" + schedInst)
        print ("noteStartsEarly=" + host.music.noteStarts)
        print ("audioPlaysEarly=" + audio.playCount)

        def frames:int 500
        if ((shell_arg_cnt) > 0) {
            def parsed@(optional):int (to_int (shell_arg 0))
            if (!null? parsed) {
                frames = (unwrap parsed)
            }
        }

        i = 4
        while (i < frames) {
            runner.frame(16 false false false false false false)
            i = (i + 1)
        }

        def playing:int 0
        if (host.music.isPlaying()) {
            playing = 1
        }
        print ("frames=" + frames)
        print ("musicPlaying=" + (to_string playing))
        print ("noteStarts=" + host.music.noteStarts)
        print ("audioPlays=" + audio.playCount)
        print "cmajor-runner done"
    }
}

; Debug: load minimal autopeli stub
Import "./game_runtime.rgr"

class AutopeliDebugMin {
    sfn m@(main):void () {
        def runner:GameRunner (new GameRunner)
        runner.init(480 270)
        def src:string "function initState() { return {}; }\nfunction config() { return { world: { width: 480, height: 6000 }, physics: { enabled: true } }; }\n"
        runner.setScriptDir("gallery/game_engine/games/autopeli_physics")
        print "loading minimal..."
        runner.loadScript(src)
        print "loadScript ok"
    }
}

; ==============================================================================
; as_source_runner — run a .as (AssemblyScript-subset) game via Ranger's live
; TS interpreter (ComponentEngine), against the same RGW1/RGU1 ABI as WASM.
; ==============================================================================
;
; A variation of the .tsx GameRunner: if a game folder contains a `.as` file, we
; interpret it directly (fast start + hot reload) instead of loading a compiled
; .wasm. The game imports the flat bridge API from "@ranger/game"; that bare
; import is not resolved by the interpreter, so the calls fall through to
; AsAbiBridge (native), which reads/writes the shared ABI. The exact same source
; compiles with `asc` for shipping — one file, two run paths.
; ==============================================================================

Import "../../../lib/ranger-dir.rgr"
Import "../eval/jsx/ComponentEngine.rgr"
Import "../eval/jsx/EvalValue.rgr"
Import "./as_abi_bridge.rgr"

class AsSourceRunner {
    def engine:ComponentEngine (new ComponentEngine())
    def bridge:AsAbiBridge (new AsAbiBridge())
    def loaded:boolean false
    def asFile:string ""
    def verbose:boolean false

    ; True when the folder holds a .as game (how the catalog picks this engine).
    fn folderHasAs:boolean (dir:string) {
        return ((strlen (this.findAsFile(dir))) > 0)
    }

    fn findAsFile:string (dir:string) {
        def names:[string] (list_dir_files dir)
        def i 0
        while (i < (array_length names)) {
            def name:string (itemAt names i)
            def n (strlen name)
            if (n > 3) {
                if ((substring name (n - 3) n) == ".as") {
                    return name
                }
            }
            i = (i + 1)
        }
        return ""
    }

    ; Drop the bare "@ranger/game" import line: the interpreter gets those names
    ; from the native bridge. Relative imports (e.g. ./abi_env) are kept.
    fn stripBridgeImport:string (src:string) {
        def lines:[string] (strsplit src "\n")
        def out ""
        def i 0
        while (i < (array_length lines)) {
            def line:string (itemAt lines i)
            if ((indexOf line "@ranger/game") >= 0) {
                ; skip this import line
            } {
                out = (+ out (+ line "\n"))
            }
            i = (i + 1)
        }
        return out
    }

    fn bindDir:boolean (dir:string) {
        def file:string (this.findAsFile(dir))
        if ((strlen file) == 0) { return false }
        asFile = file
        def buf:buffer (buffer_read_file dir file)
        def src:string (buffer_to_string buf)
        src = (this.stripBridgeImport(src))
        engine.setBasePath(dir)
        engine.setNativeBridge(bridge)
        ; Shared .as modules (e.g. the fluent `ui` builder) live in lib/ and
        ; resolve via relative imports like `import { ui } from "./ui"`: found
        ; first in the game's own dir, else here (same convention game_runtime
        ; uses for .tsx `game_helpers`).
        engine.addAssetPath("gallery/game_engine/lib")
        engine.jsxParsing = false      ; .as is non-JSX: `<` is comparison / cast
        ; Silence the interpreter's per-call trace: with quiet=false (the default)
        ; ComponentEngine builds a string and `print`s it on EVERY function call,
        ; method call, and member access. At 60fps that is thousands of stdout
        ; writes per frame — the dominant cost that made the interpreted .as guest
        ; run slower than the compiled/.tsx path (which sets quiet via game_runtime).
        engine.quiet = true
        if verbose {
            engine.quiet = false
        }
        engine.loadScript(src)
        bridge.ensure()
        loaded = true
        return true
    }

    ; Inject a host value the interpreted .as sees as a module-scope global (same
    ; mechanism the .tsx menu uses for `gameCatalog`). Call after bindDir(), before
    ; callInit(), so init()/update() can read it.
    fn registerGlobal:void (name:string value:EvalValue) {
        if (loaded == false) { return }
        engine.registerGlobal(name value)
    }

    fn callInit:void () {
        if (loaded == false) { return }
        engine.callFunction("init" (EvalValue.null()))
    }

    fn callUpdate:void () {
        if (loaded == false) { return }
        engine.callFunction("update" (EvalValue.null()))
    }

    ; Run the .as declare_resources(); fills the bridge resource manifest.
    fn callDeclareResources:void () {
        if (loaded == false) { return }
        bridge.resReset()
        engine.callFunction("declare_resources" (EvalValue.null()))
    }

    ; The RGP1 pose block lives on the bridge; a host PoseProvider writes into it
    ; before each callUpdate(), exactly where the WASM host would write pose bytes.
    fn poseBridge:AsAbiBridge () {
        return bridge
    }

    ; ---- host reads the shared ABI (same layout the WASM host reads) ----
    fn abiRead:int (off:int) {
        return (bridge.ar(off))
    }
    fn abiWrite:void (off:int v:int) {
        bridge.aw(off v)
    }
    fn uiByte:int (off:int) {
        def b:int (itemAt bridge.ui off)
        return b
    }
    fn uiRevision:int () {
        return bridge.revision
    }
}

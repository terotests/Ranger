; ==============================================================================
; tsx_engine_demo - regression harness for ComponentEngine script evaluation.
; ==============================================================================

Import "../../pdf_writer/src/jsx/ComponentEngine.rgr"
Import "../../pdf_writer/src/jsx/EvalValue.rgr"

class TsxEngineDemo {
    sfn m@(main):void () {
        def engine (new ComponentEngine())
        engine.quiet = true

        def buf:buffer (buffer_read_file "gallery/game_engine/scripting" "tsx_engine_demo.game.tsx")
        def src:string (buffer_to_string buf)
        engine.loadScript(src)

        def whileLen:EvalValue (engine.callFunction("whileLoopLen" (EvalValue.null())))
        def constSum:EvalValue (engine.callFunction("moduleConstSum" (EvalValue.null())))
        def computed:EvalValue (engine.callFunction("computedConst" (EvalValue.null())))
        def arrLen:EvalValue (engine.callFunction("arrayConstLen" (EvalValue.null())))
        def arrFirst:EvalValue (engine.callFunction("arrayConstFirst" (EvalValue.null())))
        def objSum:EvalValue (engine.callFunction("objectConstField" (EvalValue.null())))
        def whileConst:EvalValue (engine.callFunction("whileWithModuleConst" (EvalValue.null())))
        def memberAssign:EvalValue (engine.callFunction("memberAssign" (EvalValue.null())))
        def helperSide:EvalValue (engine.callFunction("helperSideEffect" (EvalValue.null())))

        print ("whileLen=" + (to_int (whileLen.numberValue)))
        print ("constSum=" + (to_int (constSum.numberValue)))
        print ("computed=" + (to_int (computed.numberValue)))
        print ("arrLen=" + (to_int (arrLen.numberValue)))
        print ("arrFirst=" + arrFirst.stringValue)
        print ("objSum=" + (to_int (objSum.numberValue)))
        print ("whileConst=" + (to_int (whileConst.numberValue)))
        print ("memberAssign=" + (to_int (memberAssign.numberValue)))
        print ("helperSide=" + (to_int (helperSide.numberValue)))
        print "tsx-engine-demo done"
    }
}

; Load TSX from /tmp/autopeli_bisect.tsx for bisect debugging.
Import "./game_runtime.rgr"

class AutopeliBisect {
    sfn m@(main):void () {
        def runner:GameRunner (new GameRunner)
        runner.init(480 270)
        def buf:buffer (buffer_read_file "/tmp" "autopeli_bisect.tsx")
        def src:string (buffer_to_string buf)
        runner.setScriptDir("gallery/game_engine/games/autopeli_physics")
        print "loading bisect file..."
        runner.loadScript(src)
        print "loadScript ok"
    }
}

; ==============================================================================
; background_script_runner_demo - backgroundImage() hook via TS script.
; ==============================================================================

Import "./game_runtime.rgr"

class BackgroundScriptRunnerDemo {
    sfn m@(main):void () {
        def runner:GameRunner (new GameRunner)
        runner.init(32 32)

        def buf:buffer (buffer_read_file "gallery/game_engine/scripting" "background_demo.game.tsx")
        def src:string (buffer_to_string buf)
        runner.setScriptDir("tests/fixtures")
        runner.loadScript(src)
        runner.setupScene()
        runner.draw()

        def px:int (runner.canvas.pixelR(28 16))
        def py:int (runner.canvas.pixelG(28 16))
        def pz:int (runner.canvas.pixelB(28 16))

        print (("bgLoaded=" + (to_string (runner.hasBackground()))))
        print (("centerPx=" + px) + ("," + py) + ("," + pz))
        print "background-script-runner done"
    }
}

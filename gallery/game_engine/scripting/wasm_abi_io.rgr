; ==============================================================================
; wasm_abi_io — linear-memory ABI helpers (offsets match wasm_game_abi.h).
; ==============================================================================

Import "../wasm_runtime.rgr"

class WasmAbiMem {
    def handle:int 0
    def base:int 0

    fn bind:void (h:int) {
        handle = h
        base = (wasm_abi_base h)
    }

    fn readMem:int (addr:int) {
        return (wasm_mem_i32 handle addr)
    }

    fn writeMem:void (addr:int val:int) {
        wasm_mem_set_i32 handle addr val
    }

    fn setHeader:void (fieldOff:int val:int) {
        this.writeMem((base + fieldOff) val)
    }

    fn readHeader:int (fieldOff:int) {
        return (this.readMem(base + fieldOff))
    }

    fn setDtMs:void (dt:int) {
        this.setHeader(12 dt)
    }

    fn setTimeMs:void (t:int) {
        this.setHeader(16 t)
    }

    fn setInputFlags:void (f:int) {
        this.setHeader(20 f)
    }

    fn setBodyCount:void (n:int) {
        this.setHeader(28 n)
    }

    fn setImpulseCount:void (n:int) {
        this.setHeader(32 n)
    }

    fn getScore:int () {
        return (this.readHeader(40))
    }

    fn getHits:int () {
        return (this.readHeader(44))
    }

    fn getCameraY:int () {
        return (this.readHeader(48))
    }

    fn writeBody:void (idx:int xFp:int yFp:int angle:int speedFp:int angVelFp:int flags:int) {
        def b:int (base + 64 + (idx * 24))
        this.writeMem(b xFp)
        this.writeMem((b + 4) yFp)
        this.writeMem((b + 8) angle)
        this.writeMem((b + 12) speedFp)
        this.writeMem((b + 16) angVelFp)
        this.writeMem((b + 20) flags)
    }

    fn readBodyX:int (idx:int) {
        return (this.readMem(base + 64 + (idx * 24)))
    }

    fn readBodyY:int (idx:int) {
        return (this.readMem(base + 64 + (idx * 24) + 4))
    }

    fn readControlSteer:int (idx:int) {
        return (this.readMem(base + 832 + (idx * 16)))
    }

    fn readControlThrottle:int (idx:int) {
        return (this.readMem(base + 832 + (idx * 16) + 4))
    }

    fn readControlBrake:int (idx:int) {
        return (this.readMem(base + 832 + (idx * 16) + 8))
    }

    fn readControlGrip:int (idx:int) {
        return (this.readMem(base + 832 + (idx * 16) + 12))
    }

    fn readImpulseBody:int (idx:int) {
        return (this.readMem(base + 1344 + (idx * 16)))
    }

    fn readImpulseLinX:int (idx:int) {
        return (this.readMem(base + 1344 + (idx * 16) + 4))
    }

    fn readImpulseLinY:int (idx:int) {
        return (this.readMem(base + 1344 + (idx * 16) + 8))
    }

    fn readImpulseAng:int (idx:int) {
        return (this.readMem(base + 1344 + (idx * 16) + 12))
    }

    fn getImpulseCount:int () {
        return (this.readHeader(32))
    }

    fn verifyMagic:boolean () {
        def magic:int (this.readHeader(0))
        if (magic == 826425682) {
            return true
        }
        return false
    }
}

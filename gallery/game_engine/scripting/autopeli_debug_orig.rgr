; Debug: load orignal.tsx instead of index.tsx
Import "./game_runtime.rgr"

class AutopeliDebugOrig {
    sfn m@(main):void () {
        def runner:GameRunner (new GameRunner)
        runner.init(480 270)
        def buf:buffer (buffer_read_file "gallery/game_engine/games/autopeli_physics" "orignal.tsx")
        def src:string (buffer_to_string buf)
        runner.setScriptDir("gallery/game_engine/games/autopeli_physics")
        print "loading orignal..."
        runner.loadScript(src)
        print "loadScript ok"
        runner.setupScene()
        print "setupScene ok"
    }
}

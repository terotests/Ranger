; ==============================================================================
; spawner_runner_demo - host-bridge demo via the TS interpreter (ComponentEngine).
; ==============================================================================
;
; Loads spawner.game.tsx and drives it through GameRunner (interpreted TS). The
; host registers resources() and drains state.events exactly like the static
; path, so this must print the same resource/event totals as
; spawner_native_runner.rgr. This proves the bridge contract is path-agnostic.
; ==============================================================================

Import "./game_runtime.rgr"

class SpawnerRunnerDemo {
    sfn m@(main):void () {
        def runner:GameRunner (new GameRunner)
        runner.init(320 240)

        def buf:buffer (buffer_read_file "gallery/game_engine/scripting" "spawner.game.tsx")
        def src:string (buffer_to_string buf)
        runner.setScriptDir("gallery/game_engine/scripting")
        runner.loadScript(src)
        runner.setupScene()

        def frames:int 30
        if ((shell_arg_cnt) > 0) {
            def parsed@(optional):int (to_int (shell_arg 0))
            if (!null? parsed) {
                frames = (unwrap parsed)
            }
        }

        def i 0
        while (i < frames) {
            runner.frame(16 false false false false false false)
            i = (i + 1)
        }

        def host:GameHost (runner.hostRef())
        print (("images=" + (host.imageCount())))
        print (("sounds=" + (host.soundCount())))
        print (("sprites=" + (host.spriteCount())))
        print (("hasImage_bg=" + (to_string (host.hasImage("bg")))))
        print (("hasSound_blip=" + (to_string (host.hasSound("blip")))))
        print (("events=" + host.eventCount))
        print (("soundPlays=" + (host.soundPlayCount())))
        print (("dotX=" + (runner.entityX("dot"))))
        print "spawner-runner done"
    }
}

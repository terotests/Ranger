; ==============================================================================
; invaders_runner_demo - runs scripted Space Invaders (invaders.game.tsx).
; ==============================================================================
;
; Optional CLI arg = number of frames (default 600). Writes invaders_frame.rgba
; next to this file for visual inspection.
; ==============================================================================

Import "./game_runtime.rgr"

class InvadersRunnerDemo {
    sfn m@(main):void () {
        def runner:GameRunner (new GameRunner)
        runner.init(480 270)

        def buf:buffer (buffer_read_file "gallery/game_engine/scripting" "invaders.game.tsx")
        def src:string (buffer_to_string buf)
        runner.loadScript(src)
        runner.setupScene()

        def frames:int 600
        if ((shell_arg_cnt) > 0) {
            def parsed@(optional):int (to_int (shell_arg 0))
            if (!null? parsed) {
                frames = (unwrap parsed)
            }
        }

        def i 0
        while (i < frames) {
            def phase (i % 160)
            def up (phase < 50)
            def down (phase >= 110)
            runner.frame(16 up down false false)
            i = (i + 1)
        }

        runner.draw()
        buffer_write_file "gallery/game_engine/scripting" "invaders_frame.rgba" (runner.raw())

        def sx:int (runner.entityX("ship4"))
        def sy:int (runner.entityY("ship4"))
        def ec:int (runner.entityCount())
        print ("frames=" + frames)
        print (("ship=" + sx) + ("," + sy))
        print (("entities=" + ec))
        print (("score=" + runner.score1) + ("," + runner.score2))
        print "invaders-runner done"
    }
}

; ==============================================================================
; wasm_ui_demo - headless proof for the RGU1 host reader + EVG builder.
;
; The embedded hex is the exact UI block the real autopeli.wasm wrote into its
; linear memory after injecting a P1<->wall and P2<->cone collision. This demo
; decodes it, runs the same validate + build path the native host uses, and
; prints the resulting per-player, multi-colored EVG tree.
; ==============================================================================

Import "./wasm_ui_io.rgr"

class WasmUiDemo {
    sfn hexNibble:int (c:int) {
        if (c >= 48) {
            if (c <= 57) { return (c - 48) }
        }
        if (c >= 97) {
            if (c <= 102) { return ((c - 97) + 10) }
        }
        if (c >= 65) {
            if (c <= 70) { return ((c - 65) + 10) }
        }
        return 0
    }

    sfn decodeHex:[int] (hex:string) {
        def out:[int]
        def n (strlen hex)
        def i 0
        while (i < n) {
            def hi (WasmUiDemo.hexNibble((charAt hex i)))
            def lo (WasmUiDemo.hexNibble((charAt hex (i + 1))))
            push out ((hi * 16) + lo)
            i = (i + 2)
        }
        return out
    }

    sfn printTree:void (el:EVGElement depth:int) {
        def pad ""
        def d 0
        while (d < depth) {
            pad = (+ pad "  ")
            d = (d + 1)
        }
        def line (+ pad el.tagName)
        if ((strlen el.textContent) > 0) {
            line = (+ line (+ " text=\"" (+ el.textContent "\"")))
        }
        if (el.backgroundColor.isSet) {
            line = (+ line (+ " bg=" (el.backgroundColor.toHexString())))
        }
        if ((strlen el.textContent) > 0) {
            if (el.color.isSet) {
                line = (+ line (+ " fg=" (el.color.toHexString())))
            }
        }
        if (el.width.isSet) {
            line = (+ line (+ " w=" (to_string (to_int el.width.value))))
        }
        if (el.height.isSet) {
            line = (+ line (+ " h=" (to_string (to_int el.height.value))))
        }
        print line
        def i 0
        while (i < (array_length el.children)) {
            WasmUiDemo.printTree((itemAt el.children i) (depth + 1))
            i = (i + 1)
        }
    }

    sfn m@(main):void () {
        def hex:string ""
        def bytes:[int] (WasmUiDemo.decodeHex(hex))
        def doc:WasmUiDoc (new WasmUiDoc)
        doc.loadBytes(bytes (array_length bytes))

        print (+ "valid=" (to_string doc.valid))
        print (+ "revision=" (to_string doc.revision))
        print (+ "rootId=" (to_string doc.rootId))
        print (+ "nodeCount=" (to_string doc.nodeCount))
        print (+ "propCount=" (to_string doc.propCount))
        if (doc.valid == false) {
            print "RGU1 HOST FAIL (invalid document)"
            return
        }
        def builder:WasmUiEvgBuilder (new WasmUiEvgBuilder)
        ; Per-pane build: the host renders one player column per split-screen
        ; pane (P1 -> node id 10, P2 -> node id 20).
        print "--- left pane (P1, node 10) ---"
        WasmUiDemo.printTree((builder.buildFromId(doc 10)) 0)
        print "--- right pane (P2, node 20) ---"
        WasmUiDemo.printTree((builder.buildFromId(doc 20)) 0)
        print "RGU1 HOST OK"
    }
}

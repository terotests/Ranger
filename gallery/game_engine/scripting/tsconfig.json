{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "game_helpers": ["../lib/game_helpers.tsx"]
    },
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "jsx": "preserve",
    "lib": ["ES2015"],
    "skipLibCheck": true
  },
  "include": [
    "engine.d.ts",
    "game.d.ts",
    "breakout.d.ts",
    "game_helpers.tsx",
    "breakout.game.tsx",
    "breakout_bricks.tsx"
  ]
}

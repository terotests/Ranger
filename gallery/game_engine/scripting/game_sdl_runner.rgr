; ==============================================================================
; game_sdl_runner - SDL2 host for script-driven games (.tsx / .game.tsx).
; ==============================================================================
;
; Loads a TypeScript game script from the first CLI argument, evaluates it via
; GameRunner (retained sprites + update reducer), and presents each frame through
; the native SDL2 backend (gfx_sdl.rgr).
;
;   ./game_sdl gallery/game_engine/scripting/pong.game.tsx
;   ./game_sdl --hot-reload gallery/game_engine/scripting/pong.game.tsx
;   SDL_VIDEODRIVER=dummy ./game_sdl gallery/game_engine/scripting/pong.game.tsx 300
;
; Controls: Arrow keys / A,D = move (game-specific), W/S = alt, Space = action, Q/Esc = quit.
;
; Runtime options (flags before the .tsx path):
;   --hot-reload     poll .tsx mtime each frame; AST-patch in-process on save
;   --no-hot-reload  disable hot reload (default for headless maxFrames runs)
;
; Positional args after flags:
;   <game.tsx>   script path (required)
;   [maxFrames]  optional frame cap (headless smoke / CI; disables hot reload)
; ==============================================================================

Import "./game_runtime.rgr"
Import "../gfx_sdl.rgr"

class GameSdlRunner {
    def runner:GameRunner (new GameRunner)
    def pw:int 480
    def ph:int 270
    def maxFrames:int 0
    def frames:int 0
    def running:boolean true
    def fpsShown:int 0
    def fpsWindowStart:int 0
    def fpsWindowFrames:int 0
    def lastFrameStart:int 0
    def defaultDtMs:int 16
    def minDtMs:int 1
    def maxDtMs:int 100
    def hotReloadExplicit:boolean false
    def hotReloadWanted:boolean true

    fn updateFps:void () {
        def now:int (gfx_ticks_ms)
        if (fpsWindowStart <= 0) {
            fpsWindowStart = now
            fpsWindowFrames = 0
        }
        fpsWindowFrames = (fpsWindowFrames + 1)
        def elapsed (now - fpsWindowStart)
        if (elapsed >= 1000) {
            fpsShown = (to_int ((fpsWindowFrames * 1000) / elapsed))
            fpsWindowStart = now
            fpsWindowFrames = 0
            def title:string ("Ranger Game (SDL2) - ")
            title = (title + (to_string fpsShown))
            title = (title + " FPS")
            gfx_set_title(title)
        }
        runner.setFpsShown(fpsShown)
    }

    fn loadGame:void (tsxPath:string) {
        def dir:string ""
        def file:string tsxPath
        def slash:int (lastIndexOf tsxPath "/")
        if (slash >= 0) {
            dir = (substring tsxPath 0 slash)
            file = (substring tsxPath (slash + 1) (strlen tsxPath))
        }
        def buf:buffer (buffer_read_file dir file)
        def src:string (buffer_to_string buf)
        runner.init(pw ph)
        runner.setScriptDir(dir)
        runner.loadScript(src)
        runner.setupScene()
        runner.trackScriptFile(tsxPath)
        def enableHotReload:boolean hotReloadWanted
        if (maxFrames > 0) {
            if (hotReloadExplicit == false) {
                enableHotReload = false
            }
        }
        runner.setHotReload(enableHotReload)
        if (enableHotReload) {
            print ("[game-engine] hot reload enabled: " + tsxPath)
        }
    }

    fn draw:void () {
        runner.draw()
        gfx_present (runner.raw()) pw ph
    }

    fn run:void () {
        def title:string "Ranger Game (SDL2)"
        def ok:int (gfx_open title pw ph)
        if (ok == 0) {
            print "gfx_open failed (no display?) - still rendering into the RGBA buffer"
        }
        while (running) {
            runner.maybeHotReload()
            def now:int (gfx_ticks_ms)
            def dtMs:int defaultDtMs
            if (lastFrameStart > 0) {
                dtMs = (now - lastFrameStart)
                if (dtMs < minDtMs) {
                    dtMs = minDtMs
                }
                if (dtMs > maxDtMs) {
                    dtMs = maxDtMs
                }
            }
            lastFrameStart = now
            def up:boolean false
            def down:boolean false
            def left:boolean false
            def right:boolean false
            def m:int (gfx_poll_mask)
            if ((bit_and m 1) != 0) {
                up = true
            }
            if ((bit_and m 2) != 0) {
                down = true
            }
            if ((bit_and m 16) != 0) {
                left = true
            }
            if ((bit_and m 32) != 0) {
                right = true
            }
            def action:boolean false
            if ((bit_and m 4) != 0) {
                action = true
            }
            if ((bit_and m 8) != 0) {
                running = false
            }
            runner.frame(dtMs up down left right action)
            this.updateFps()
            this.draw()
            frames = (frames + 1)
            if (gfx_should_close) {
                running = false
            }
            if (maxFrames > 0) {
                if (frames >= maxFrames) {
                    running = false
                }
            }
        }
        gfx_close
    }

    fn isTsxPath:boolean (arg:string) {
        def len:int (strlen arg)
        if (len < 4) {
            return false
        }
        def tail:string (substring arg (len - 4) len)
        if (tail == ".tsx") {
            return true
        }
        return false
    }

    fn parseArgs:void () {
        def tsxPath:string ""
        def i:int 0
        while (i < (shell_arg_cnt)) {
            def arg:string (shell_arg i)
            if (arg == "--hot-reload") {
                hotReloadExplicit = true
                hotReloadWanted = true
            } {
                if (arg == "--no-hot-reload") {
                    hotReloadExplicit = true
                    hotReloadWanted = false
                } {
                    if (this.isTsxPath(arg)) {
                        tsxPath = arg
                    } {
                        if ((strlen tsxPath) > 0) {
                            def parsed@(optional):int (to_int arg)
                            if (!null? parsed) {
                                maxFrames = (unwrap parsed)
                            }
                        }
                    }
                }
            }
            i = (i + 1)
        }
        if ((strlen tsxPath) == 0) {
            print "usage: game_sdl [--hot-reload|--no-hot-reload] <path/to/game.tsx> [maxFrames]"
            print "example: game_sdl gallery/game_engine/scripting/pong.game.tsx"
            print "         game_sdl --hot-reload gallery/game_engine/scripting/pacman.game.tsx"
            return
        }
        this.loadGame(tsxPath)
    }

    sfn m@(main):void () {
        if ((shell_arg_cnt) < 1) {
            print "usage: game_sdl [--hot-reload|--no-hot-reload] <path/to/game.tsx> [maxFrames]"
            print "example: game_sdl gallery/game_engine/scripting/pong.game.tsx"
            return
        }
        def be:GameSdlRunner (new GameSdlRunner)
        be.parseArgs()
        if ((strlen be.runner.options.scriptPath) == 0) {
            return
        }
        be.run()
        def msg:string ("game-sdl done: frames=" + be.frames)
        msg = (msg + " | entities=" + (be.runner.entityCount()))
        def sx:int (be.runner.entityX("ship4"))
        def sy:int (be.runner.entityY("ship4"))
        msg = (msg + " | ship=")
        msg = (msg + sx)
        msg = (msg + ",")
        msg = (msg + sy)
        msg = (msg + " | score ")
        msg = (msg + be.runner.score1)
        msg = (msg + " - ")
        msg = (msg + be.runner.score2)
        if (be.fpsShown > 0) {
            msg = (msg + " | fps=")
            msg = (msg + (to_string be.fpsShown))
        }
        print msg
    }
}

; ==============================================================================
; game_sdl_runner - SDL2 host for script-driven games (.tsx / .game.tsx).
; ==============================================================================
;
; Launcher flow:
;   1. Load gallery/game_engine/menu/index.tsx (menu game, EVG hud).
;   2. Host scans --games-dir and injects `gameCatalog` global into the menu.
;   3. Menu sets state.launchPath → host loads that game's index.tsx.
;   4. Q/Esc or gamepad Select/B in a sub-game → back to menu game.
;   5. Q/Esc in menu → quit app.
;
; Direct launch (no menu):
;   ./game_sdl path/to/game.tsx
;
;   ./game_sdl [--software] [--games-dir=DIR] [--hot-reload|--no-hot-reload] [maxFrames]
; ==============================================================================

Import "./game_runtime.rgr"
Import "../wasm_runtime.rgr"
Import "./wasm_game_runner.rgr"
Import "./wasm_physics_runner.rgr"
Import "./game_ui_runner.rgr"
Import "./as_sprite_runner.rgr"
Import "./wasm3d_runner.rgr"
Import "../gfx_sdl.rgr"
Import "./game_audio_sdl.rgr"
Import "./game_catalog.rgr"
Import "./game_runner_mode.rgr"
Import "./streaming_world_runner.rgr"
Import "./sprite_wasm_runner.rgr"
Import "./game_host_native.rgr"
Import "./game_input.rgr"
Import "./game_split_screen.rgr"
Import "./wasm_split_screen.rgr"

class SdlGameHost extends GameHost {
    fn onRumble:void (e:GameEventNative) {
        def p:int (e.pad)
        def strength:int (e.low)
        if (e.high > strength) {
            strength = e.high
        }
        def dur:int (e.ms)
        gfx_rumble_pad p strength dur
    }
}

class GameSdlRunner {
    def runner:GameRunner (new GameRunner)
    def wasmRunner:WasmGameRunner (new WasmGameRunner)
    def wasmPhysicsRunner:WasmPhysicsRunner (new WasmPhysicsRunner)
    def useWasmRunner:boolean false
    def useWasmPhysics:boolean false
    def splitHost:SplitScreenHost (new SplitScreenHost)
    def wasmSplitHost:WasmSplitScreenHost (new WasmSplitScreenHost)
    def wasmSplitActive:boolean false
    def streamRunner:StreamingWorldRunner (new StreamingWorldRunner)
    def useStreamRunner:boolean false
    def spriteRunner:SpriteWasmRunner (new SpriteWasmRunner)
    def useSpriteRunner:boolean false
    def wasm3dRunner:Wasm3dRunner (new Wasm3dRunner)
    def useWasm3d:boolean false
    def catalog:GameCatalog (new GameCatalog)
    def nativeBridge:GameHostNativeBridge (new GameHostNativeBridge)
    def pw:int 480
    def ph:int 270
    def maxFrames:int 0
    def frames:int 0
    def running:boolean true
    def profUpdateMs:int 0
    def profDrawMs:int 0
    def profRenderMs:int 0
    def profPresentMs:int 0
    def profFrames:int 0
    def profileEnabled:boolean false
    def fpsShown:int 0
    def fpsWindowStart:int 0
    def fpsWindowFrames:int 0
    def lastFrameStart:int 0
    def defaultDtMs:int 16
    def minDtMs:int 1
    def maxDtMs:int 100
    def hotReloadExplicit:boolean false
    def hotReloadWanted:boolean true
    def startFullscreen:boolean false
    def gamesDir:string "gallery/game_engine/games"
    def menuPath:string "gallery/game_engine/menu/index.tsx"
    def launcherMode:boolean false
    def inMenu:boolean false
    def inGame:boolean false
    def splitScreenActive:boolean false
    def dualPlayerMode:boolean false
    def splitScreenPref:string "never"
    def soloScriptPath:string ""
    def splitAutoscale:boolean true
    def currentGamePath:string ""
    def prevQuitHeld:boolean false
    def currentScriptPath:string ""
    def navStack:[string]
    def catalogPollMs:int 10000
    def lastCatalogPoll:int 0
    def prevUpHeld:boolean false
    def prevDownHeld:boolean false
    def prevLeftHeld:boolean false
    def prevRightHeld:boolean false
    def prevActionHeld:boolean false
    ; Player-2 edge state (second keyboard source) for two-player sprite games.
    def prevUpHeld2:boolean false
    def prevDownHeld2:boolean false
    def prevLeftHeld2:boolean false
    def prevRightHeld2:boolean false
    def prevActionHeld2:boolean false
    def uiRunner:GameUiRunner (new GameUiRunner)
    ; Which launcher front page to run. The choice comes from menu/game.info's
    ; `runtime` field (runtime=tsx -> the rich TypeScript menu/launcher.tsx;
    ; runtime=as -> the interpreted menu/game.as), both rendered through the same
    ; WasmUiRenderer. A CLI flag (--tsx-menu / --evg-menu / --classic-menu) sets
    ; `menuModeForced` to override game.info. Empty = follow game.info; the code
    ; default when neither resolves is "tsx" (dynamic heap tree, so a long game
    ; list is never clipped by the .as bridge's fixed node/property caps).
    def menuModeForced:string ""
    def menuAsDir:string "gallery/game_engine/menu"
    def menuAsMtime:int 0     ; last-seen menu/game.as mtime (live-reload poll)
    def menuTsxMtime:int 0    ; last-seen menu/launcher.tsx mtime (live-reload poll)
    def uiDirectPath:string ""
    def spriteDirectPath:string ""
    def gpuModeWanted:boolean true
    def gpuModeActive:boolean false
    def gameInputSnap:GameInputSnapshot (new GameInputSnapshot)

    fn setProfileOnRunners:void () {
        runner.setProfileEnabled(profileEnabled)
        wasmRunner.setProfileEnabled(profileEnabled)
        wasmPhysicsRunner.setProfileEnabled(profileEnabled)
        splitHost.setProfileEnabled(profileEnabled)
        wasmSplitHost.setProfileEnabled(profileEnabled)
        spriteRunner.setProfileEnabled(profileEnabled)
    }

    fn resolveWasmPhysics:boolean (path:string) {
        if ((strlen gamesDir) > 0) {
            if ((catalog.entryCount()) == 0) {
                catalog.setGamesDir(gamesDir)
                catalog.scan()
            }
        }
        def entry:GameCatalogEntry (catalog.findByPath(path))
        if (entry.physics == "true") {
            return true
        }
        if (entry.abi == "linear") {
            return true
        }
        def slash:int (lastIndexOf path "/")
        if (slash >= 0) {
            def dir:string (substring path 0 slash)
            if (file_exists dir "game.info") {
                def buf:buffer (buffer_read_file dir "game.info")
                def txt:string (buffer_to_string buf)
                if ((indexOf txt "physics=true") >= 0) {
                    return true
                }
                if ((indexOf txt "abi=linear") >= 0) {
                    return true
                }
            }
        }
        return false
    }

    ; True when the game.info declares abi=sprite (RGSP1 character game). Routed
    ; to SpriteWasmRunner instead of the physics/getter wasm runners.
    fn resolveWasmSprite:boolean (path:string) {
        if ((strlen gamesDir) > 0) {
            if ((catalog.entryCount()) == 0) {
                catalog.setGamesDir(gamesDir)
                catalog.scan()
            }
        }
        def entry:GameCatalogEntry (catalog.findByPath(path))
        if (entry.abi == "sprite") {
            return true
        }
        def slash:int (lastIndexOf path "/")
        if (slash >= 0) {
            def dir:string (substring path 0 slash)
            if (file_exists dir "game.info") {
                def buf:buffer (buffer_read_file dir "game.info")
                def txt:string (buffer_to_string buf)
                if ((indexOf txt "abi=sprite") >= 0) {
                    return true
                }
            }
        }
        return false
    }

    fn printRunnerProfile:void (label:string r:GameRunner) {
        if (false == profileEnabled) {
            return
        }
        if (r.profFrames <= 0) {
            return
        }
        def pf:int r.profFrames
        def line:string ("[profile:" + label + "] updateScript=" + r.profUpdateScriptMs + "ms")
        line = (line + " sync=" + r.profUpdateSyncMs + "ms")
        line = (line + " drawBg=" + r.profDrawBgMs + "ms")
        line = (line + " drawSprites=" + r.profDrawSpritesMs + "ms")
        line = (line + " drawHud(interp)=" + r.profDrawHudMs + "ms")
        line = (line + " | updateScript/frame=" + (idiv r.profUpdateScriptMs pf) + "ms")
        line = (line + " hud/frame=" + (idiv r.profDrawHudMs pf) + "ms")
        print line
    }

    fn updateFps:void () {
        def now:int (gfx_ticks_ms)
        if (fpsWindowStart <= 0) {
            fpsWindowStart = now
            fpsWindowFrames = 0
        }
        fpsWindowFrames = (fpsWindowFrames + 1)
        def elapsed (now - fpsWindowStart)
        if (elapsed >= 1000) {
            fpsShown = (to_int ((fpsWindowFrames * 1000) / elapsed))
            fpsWindowStart = now
            fpsWindowFrames = 0
            def title:string "Ranger Game (SDL2) - "
            title = (title + (to_string fpsShown))
            title = (title + " FPS")
            if (splitScreenActive) {
                title = (title + " [split]")
            }
            gfx_set_title(title)
        }
        if (splitScreenActive) {
            if (wasmSplitActive) {
                wasmSplitHost.setFpsShown(fpsShown)
            } {
                splitHost.setFpsShown(fpsShown)
            }
        } {
            if (useWasmRunner) {
                if (useWasmPhysics) {
                    wasmPhysicsRunner.setFpsShown(fpsShown)
                } {
                    wasmRunner.setFpsShown(fpsShown)
                }
            } {
                runner.setFpsShown(fpsShown)
            }
        }
    }

    fn clearNavStack:void () {
        def empty:[string]
        navStack = empty
    }

    fn pushNavStack:void (path:string) {
        if ((strlen path) > 0) {
            push navStack path
        }
    }

    fn popNavStack:string () {
        def cnt:int (array_length navStack)
        if (cnt <= 0) {
            return ""
        }
        def top:string (itemAt navStack (cnt - 1))
        def trimmed:[string]
        def i:int 0
        while (i < (cnt - 1)) {
            push trimmed (itemAt navStack i)
            i = (i + 1)
        }
        navStack = trimmed
        return top
    }

    fn wireNativeBridge:void (scriptDir:string) {
        nativeBridge.setGameDir(scriptDir)
        runner.setNativeBridge(nativeBridge)
    }

    fn presentLoadingScreen:void (label:string) {
        if (pw <= 0) {
            return
        }
        if (ph <= 0) {
            return
        }
        def ticks:int (gfx_ticks_ms)
        runner.drawLoadingScreen(label ticks)
        gfx_present (runner.raw()) pw ph
    }

    fn wireWasmAudio:void (audio:GameAudio host:SdlGameHost) {
        audio.setSink((new SdlGameAudioSink))
        def devRate:int (gfx_audio_sample_rate)
        if (devRate > 0) {
            audio.sampleRate = devRate
        }
        host.audio = audio
        host.wireMusic()
    }

    fn refreshWasmAudioSampleRate:void () {
        def devRate:int (gfx_audio_sample_rate)
        if (devRate <= 0) {
            return
        }
        if (useWasmRunner == false) {
            return
        }
        if (useWasmPhysics) {
            if (wasmSplitActive) {
                wasmSplitHost.runner.audio.sampleRate = devRate
            } {
                wasmPhysicsRunner.audio.sampleRate = devRate
            }
        } {
            wasmRunner.audio.sampleRate = devRate
        }
    }

    fn loadScriptAt:void (tsxPath:string injectCatalog:boolean) {
        useSpriteRunner = false
        useStreamRunner = false
        useWasmRunner = false
        if (inGame) {
            this.presentLoadingScreen("LOADING")
        }
        if (inMenu) {
            this.presentLoadingScreen("LOADING")
        }
        def dir:string ""
        def file:string tsxPath
        def slash:int (lastIndexOf tsxPath "/")
        if (slash >= 0) {
            dir = (substring tsxPath 0 slash)
            file = (substring tsxPath (slash + 1) (strlen tsxPath))
        }
        def buf:buffer (buffer_read_file dir file)
        def src:string (buffer_to_string buf)
        runner = (new GameRunner)
        runner.init(pw ph)
        runner.setGpuMode(gpuModeActive)
        runner.audio.setSink((new SdlGameAudioSink))
        def devRate:int (gfx_audio_sample_rate)
        if (devRate > 0) {
            runner.audio.sampleRate = devRate
        }
        runner.host = (new SdlGameHost)
        runner.wireHostAudio()
        runner.setScriptDir(dir)
        this.wireNativeBridge(dir)
        if (injectCatalog) {
            runner.registerGlobal("gameCatalog" (catalog.toEvalArray()))
        }
        this.presentLoadingScreen("LOADING")
        runner.loadScript(src)
        this.presentLoadingScreen("LOADING")
        runner.setupScene()
        runner.enableGpuSheetOverlay()
        runner.registerDefaultPaneGlobals()
        runner.trackScriptFile(tsxPath)
        currentScriptPath = tsxPath
        def enableHotReload:boolean hotReloadWanted
        if (maxFrames > 0) {
            if (hotReloadExplicit == false) {
                enableHotReload = false
            }
        }
        runner.setHotReload(enableHotReload)
        if (enableHotReload) {
            print ("[game-engine] hot reload enabled: " + tsxPath)
        }
        this.syncInputEdges()
        gameInputSnap.resetSoloPad()
        gfx_clear_should_close
        this.setProfileOnRunners()
    }

    fn loadWasmAt:void (wasmPath:string) {
        if (this.resolveWasmSprite(wasmPath)) {
            this.loadSpriteAt(wasmPath)
            return
        }
        useSpriteRunner = false
        useStreamRunner = false
        useWasmRunner = true
        useWasmPhysics = (this.resolveWasmPhysics(wasmPath))
        if (inGame) {
            this.presentLoadingScreen("LOADING WASM")
        }
        if (inMenu) {
            this.presentLoadingScreen("LOADING WASM")
        }
        if (useWasmPhysics) {
            wasmPhysicsRunner = (new WasmPhysicsRunner)
            wasmPhysicsRunner.init(pw ph)
            this.presentLoadingScreen("LOADING WASM")
            wasmPhysicsRunner.loadModule(wasmPath)
            ; A failed load (missing import, bad module, gate rejection) must NOT
            ; fall through — the runner would render a blank/garbage game. Abort
            ; back to the menu instead.
            if ((wasmPhysicsRunner.isLoaded()) == false) {
                this.abortWasmLoad(wasmPath)
                return
            }
            this.presentLoadingScreen("LOADING WASM")
            wasmPhysicsRunner.setupScene()
            def sdlHost:SdlGameHost (new SdlGameHost)
            this.wireWasmAudio(wasmPhysicsRunner.audio sdlHost)
            wasmPhysicsRunner.host = sdlHost
        } {
            wasmRunner = (new WasmGameRunner)
            wasmRunner.init(pw ph)
            def sdlHost2:SdlGameHost (new SdlGameHost)
            this.wireWasmAudio(wasmRunner.audio sdlHost2)
            wasmRunner.host = sdlHost2
            this.presentLoadingScreen("LOADING WASM")
            wasmRunner.loadModule(wasmPath)
            ; Same guard: without a loaded module WasmGameRunner draws its default
            ; ball+paddles court reading zeroed getters — i.e. a broken wasm game
            ; silently looks like Pong. Abort to the menu instead.
            if ((wasmRunner.isLoaded()) == false) {
                this.abortWasmLoad(wasmPath)
                return
            }
            this.presentLoadingScreen("LOADING WASM")
            wasmRunner.setupScene()
        }
        currentScriptPath = wasmPath
        currentGamePath = wasmPath
        inMenu = false
        inGame = true
        splitScreenActive = false
        wasmSplitActive = false
        this.syncInputEdges()
        gameInputSnap.resetSoloPad()
        gfx_clear_should_close
        this.setProfileOnRunners()
        if (useWasmPhysics) {
            print ("[game-engine] wasm physics game: " + wasmPath)
        } {
            print ("[game-engine] wasm game: " + wasmPath)
        }
    }

    ; A wasm module failed to load — reset the runner-mode flags and return to
    ; the menu rather than entering a game with no module (which would render a
    ; broken default court / blank scene). The console already carries the
    ; specific reason ("[wasm] load failed" / "REJECTED …" / missing import).
    fn abortWasmLoad:void (wasmPath:string) {
        print ("[game-engine] wasm load FAILED, returning to menu: " + wasmPath)
        useWasmRunner = false
        useWasmPhysics = false
        useSpriteRunner = false
        useStreamRunner = false
        splitScreenActive = false
        wasmSplitActive = false
        this.loadMenuGame()
    }

    ; Load a render=3d wasm guest into the GPU 3D runner (Wasm3dRunner). The guest
    ; declares MESH/CAM/LIGHT/MATERIAL/RESOURCE; the runner uploads them to the GPU
    ; and draws each frame. Presentation is a GL swap inside the runner's draw(),
    ; so the draw() dispatch below skips gfx_present for this mode.
    fn loadWasm3dAt:void (wasmPath:string) {
        useWasmRunner = false
        useWasmPhysics = false
        useSpriteRunner = false
        useStreamRunner = false
        useWasm3d = true
        this.presentLoadingScreen("LOADING 3D")
        wasm3dRunner.init(pw ph)
        wasm3dRunner.loadModule(wasmPath)
        if ((wasm3dRunner.isLoaded()) == false) {
            useWasm3d = false
            this.abortWasmLoad(wasmPath)
            return
        }
        wasm3dRunner.setupScene()
        currentScriptPath = wasmPath
        currentGamePath = wasmPath
        inMenu = false
        inGame = true
        splitScreenActive = false
        wasmSplitActive = false
        this.syncInputEdges()
        gameInputSnap.resetSoloPad()
        gfx_clear_should_close
        this.setProfileOnRunners()
        print ("[game-engine] wasm 3d game: " + wasmPath)
    }

    fn dirOf:string (path:string) {
        def cut (0 - 1)
        def i 0
        def n (strlen path)
        while (i < n) {
            def c:string (substring path i (i + 1))
            if (c == "/") {
                cut = i
            }
            i = (i + 1)
        }
        if (cut < 0) {
            return "."
        }
        return (substring path 0 cut)
    }

    ; Load an interpreted .as game folder — reuses the wasm physics/render path
    ; (the ABI is identical); only the guest is an interpreted .as file.
    ; Load transactionally (IDEAL_TODO R.4): build + validate a CANDIDATE runner
    ; without touching active state; only after it loads do we swap the runner and
    ; flip the mode flags. A failed load previously left useWasmRunner/Physics=true
    ; with the old runner already discarded — a half-switched dead state.
    fn loadAsAt:void (asPath:string) {
        def dir:string (this.dirOf(asPath))
        def candidate:WasmPhysicsRunner (new WasmPhysicsRunner)
        candidate.init(pw ph)
        this.presentLoadingScreen("LOADING .AS")
        if ((candidate.loadAsGame(dir)) == false) {
            print ("[as] load failed (prior game kept): " + dir)
            return
        }
        candidate.setupScene()
        def sdlHost:SdlGameHost (new SdlGameHost)
        this.wireWasmAudio(candidate.audio sdlHost)
        candidate.host = sdlHost
        ; --- commit: the candidate loaded, now swap in and flip modes ---
        wasmPhysicsRunner = candidate
        useSpriteRunner = false
        useStreamRunner = false
        useWasmRunner = true
        useWasmPhysics = true
        currentScriptPath = asPath
        currentGamePath = asPath
        inMenu = false
        inGame = true
        splitScreenActive = false
        wasmSplitActive = false
        this.syncInputEdges()
        gameInputSnap.resetSoloPad()
        gfx_clear_should_close
        this.setProfileOnRunners()
        print ("[game-engine] .as game: " + asPath)
    }

    fn loadGameAtPath:void (path:string injectCatalog:boolean) {
        if (this.isStreamingPath(path)) {
            this.loadStreamingAt(path)
            return
        }
        ; render=sprites .as games are driven by runSpriteGame() (guest-authored
        ; rotatable sprite scene, no physics), not the wasm/tsx runners.
        if ((this.renderOf(path)) == "sprites") {
            spriteDirectPath = path
            currentGamePath = path
            return
        }
        ; engine=ui games are driven by runUiGame(), not the wasm/tsx runners.
        if ((this.engineOf(path)) == "ui") {
            uiDirectPath = path
            currentGamePath = path
            return
        }
        if (this.isAsPath(path)) {
            this.loadAsAt(path)
            return
        }
        if (this.isWasmPath(path)) {
            this.loadWasmAt(path)
            return
        }
        this.loadScriptAt(path injectCatalog)
    }

    ; Load an RGSP1 sprite game: sprite_char.wasm drives the ready character set
    ; (menu + play), rendered by SpriteWasmRunner and presented like any wasm game.
    fn loadSpriteAt:void (wasmPath:string) {
        useStreamRunner = false
        useWasmRunner = false
        useWasmPhysics = false
        useSpriteRunner = true
        spriteRunner = (new SpriteWasmRunner)
        spriteRunner.init(pw ph)
        this.presentLoadingScreen("LOADING WASM")
        spriteRunner.loadModule(wasmPath)
        spriteRunner.setupScene()
        currentScriptPath = wasmPath
        currentGamePath = wasmPath
        inMenu = false
        inGame = true
        splitScreenActive = false
        wasmSplitActive = false
        this.syncInputEdges()
        gameInputSnap.resetSoloPad()
        gfx_clear_should_close
        this.setProfileOnRunners()
        print ("[game-engine] sprite game: " + wasmPath)
    }

    ; Load a streaming-world game: worker.wasm + its spawned resource loader,
    ; driven by StreamingWorldRunner and presented through the normal path.
    fn loadStreamingAt:void (wasmPath:string) {
        useSpriteRunner = false
        useStreamRunner = true
        useWasmRunner = false
        useWasmPhysics = false
        streamRunner = (new StreamingWorldRunner)
        streamRunner.init(pw ph)
        this.presentLoadingScreen("LOADING STREAM")
        streamRunner.loadModule(wasmPath)
        streamRunner.setupScene()
        currentScriptPath = wasmPath
        currentGamePath = wasmPath
        inMenu = false
        inGame = true
        splitScreenActive = false
        wasmSplitActive = false
        this.syncInputEdges()
        gameInputSnap.resetSoloPad()
        gfx_clear_should_close
        print ("[game-engine] streaming world: " + wasmPath)
    }

    ; After script swap, match edge state to keys still held (avoids double Q:
    ; game exit on Q then immediate menu quit while the key is still down).
    ; Reseed every edge's "previously held" state from the current poll mask, so a
    ; button already held across a mode switch / view open is NOT re-counted as a
    ; fresh press. Must cover ALL edges the runner reads: left(16)/right(32) were
    ; missing, so a held left/right produced a phantom edge (IDEAL_TODO R.3).
    fn syncInputEdges:void () {
        def m:int (gfx_poll_mask)
        prevQuitHeld = ((bit_and m 8) != 0)
        prevUpHeld = ((bit_and m 1) != 0)
        prevDownHeld = ((bit_and m 2) != 0)
        prevLeftHeld = ((bit_and m 16) != 0)
        prevRightHeld = ((bit_and m 32) != 0)
        prevActionHeld = ((bit_and m 4) != 0)
        ; Player 2 rides the second keyboard source (arrow keys); reseed its edges
        ; too so a held key across a mode switch is not re-counted as a fresh press.
        def m2:int (gfx_input_source_mask(1))
        prevUpHeld2 = ((bit_and m2 1) != 0)
        prevDownHeld2 = ((bit_and m2 2) != 0)
        prevLeftHeld2 = ((bit_and m2 16) != 0)
        prevRightHeld2 = ((bit_and m2 32) != 0)
        prevActionHeld2 = ((bit_and m2 4) != 0)
    }

    fn playerInputFlags:int (pb:PlayerButtons) {
        def flags:int 0
        if (pb.up) { flags = (flags + 1) }
        if (pb.down) { flags = (flags + 2) }
        if (pb.left) { flags = (flags + 4) }
        if (pb.right) { flags = (flags + 8) }
        if (pb.action) { flags = (flags + 16) }
        return flags
    }

    fn pollGameInput:GameInputSnapshot () {
        gfx_input_poll
        def count:int 1
        if (useWasmPhysics) {
            count = (wasmPhysicsRunner.resolvePlayerCount())
        } {
            count = (runner.resolvePlayerCount())
        }
        gameInputSnap.buildFromSdl(count)
        return gameInputSnap
    }

    fn loadMenuGame:void () {
        gfx_audio_clear
        useWasm3d = false
        catalog.setGamesDir(gamesDir)
        catalog.scan()
        this.clearNavStack()
        nativeBridge.clearPendingNav()
        print ("[menu] games dir: " + gamesDir)
        print ("[menu] catalog entries: " + (to_string (catalog.entryCount())))
        def li 0
        while (li < (catalog.entryCount())) {
            def entry:GameCatalogEntry (catalog.entryAt(li))
            print ("[menu]   " + (to_string li) + ": " + entry.title + " -> " + entry.entryPath)
            li = (li + 1)
        }
        this.loadScriptAt(menuPath true)
        inMenu = true
        inGame = false
        lastCatalogPoll = (gfx_ticks_ms)
        gfx_set_title("Ranger Game Engine")
    }

    fn resolveSplitAutoscale:boolean (entry:GameCatalogEntry) {
        if (entry.autoscale == "false") {
            return false
        }
        if (entry.autoscale == "true") {
            return true
        }
        ; Default: host scales full-width framebuffer down to each pane.
        return true
    }

    fn resolveSplitMetadata:void (tsxPath:string) {
        if ((strlen gamesDir) > 0) {
            if ((catalog.entryCount()) == 0) {
                catalog.setGamesDir(gamesDir)
                catalog.scan()
            }
        }
        splitScreenPref = "never"
        soloScriptPath = ""
        splitAutoscale = true
        def entry:GameCatalogEntry (catalog.findByPath(tsxPath))
        if ((strlen entry.splitScreen) > 0) {
            splitScreenPref = entry.splitScreen
        }
        soloScriptPath = (catalog.resolveSoloPath(entry))
        splitAutoscale = (this.resolveSplitAutoscale(entry))
    }

    ; Whether the ENGINE should split the screen into two panes for a game
    ; authored from a single-player perspective (the game does nothing itself).
    ;   never  -> single pane.
    ;   auto   -> engine auto-splits a single-player game into two panes/cameras.
    ;   always -> same as auto (kept as an alias; no game currently uses it).
    ; This decides WHETHER to split; the world model (shared one-world vs two
    ; separate sessions) is a separate axis resolved from game.info splitWorld
    ; (GameCatalog.resolveSplitWorld) — today shared for wasm+physics (autopeli),
    ; separate for tsx (pinball). dualPlayerMode short-circuits: a game that is
    ; natively two-player handles both players itself, so the engine does not split.
    fn shouldUseSplitScreen:boolean () {
        if (dualPlayerMode) {
            return false
        }
        if (splitScreenPref == "never") {
            return false
        }
        if (splitScreenPref == "always") {
            return true
        }
        if (splitScreenPref == "auto") {
            return true
        }
        return false
    }

    fn splitPanePath:string () {
        if ((strlen soloScriptPath) > 0) {
            return soloScriptPath
        }
        return currentGamePath
    }

    fn loadSplitGame:void (tsxPath:string) {
        gfx_audio_clear
        this.clearNavStack()
        nativeBridge.clearPendingNav()
        currentGamePath = tsxPath
        this.resolveSplitMetadata(tsxPath)
        def panePath:string (this.splitPanePath())
        if ((strlen panePath) == 0) {
            splitScreenActive = false
            this.loadScriptAt(tsxPath false)
            inMenu = false
            inGame = true
            return
        }
        this.presentLoadingScreen("SPLIT")
        splitHost = (new SplitScreenHost)
        splitHost.init(pw ph splitAutoscale)
        splitHost.setAudioSink((new SdlGameAudioSink))
        def splitRate:int (gfx_audio_sample_rate)
        splitHost.setAudioSampleRate(splitRate)
        splitHost.setSdlHost()
        splitHost.setGpuMode(gpuModeActive)
        splitHost.loadPanes(panePath panePath)
        def enableHotReload:boolean hotReloadWanted
        if (maxFrames > 0) {
            if (hotReloadExplicit == false) {
                enableHotReload = false
            }
        }
        splitHost.setHotReload(enableHotReload)
        currentScriptPath = tsxPath
        inMenu = false
        inGame = true
        splitScreenActive = true
        wasmSplitActive = false
        this.syncInputEdges()
        gameInputSnap.resetSoloPad()
        gfx_clear_should_close
        print ("[split-screen] left=" + panePath)
        print ("[split-screen] right=" + panePath)
        if (splitAutoscale) {
            print "[split-screen] autoscale=on"
        } {
            print "[split-screen] autoscale=off"
        }
        this.setProfileOnRunners()
    }

    fn loadWasmSplitGame:void (wasmPath:string) {
        gfx_audio_clear
        useWasmRunner = true
        useWasmPhysics = true
        wasmSplitActive = true
        this.presentLoadingScreen("SPLIT WASM")
        wasmSplitHost = (new WasmSplitScreenHost)
        wasmSplitHost.init(pw ph splitAutoscale)
        def sdlHost:SdlGameHost (new SdlGameHost)
        this.wireWasmAudio(wasmSplitHost.runner.audio sdlHost)
        wasmSplitHost.loadWasm(wasmPath sdlHost)
        currentScriptPath = wasmPath
        currentGamePath = wasmPath
        inMenu = false
        inGame = true
        splitScreenActive = true
        this.syncInputEdges()
        gameInputSnap.resetSoloPad()
        gfx_clear_should_close
        print ("[split-screen] wasm physics: " + wasmPath)
        if (splitAutoscale) {
            print "[split-screen] autoscale=on"
        } {
            print "[split-screen] autoscale=off"
        }
        this.setProfileOnRunners()
    }

    ; Derive the one canonical runner mode from the current flags and warn if the
    ; combination is illegal (IDEAL_TODO R.6). A defensive net until the flags are
    ; replaced by the mode itself; it is output-only and never changes behaviour.
    fn checkModeConsistency:string (ctx:string) {
        def st:RunnerModeState (RunnerModeClassifier.classify(useWasmRunner useWasmPhysics useSpriteRunner useStreamRunner wasmSplitActive splitScreenActive inGame))
        if (st.ok == false) {
            print ("[runner-mode] ILLEGAL state after " + ctx + ": " + st.reason)
        }
        return (RunnerMode.modeName(st.mode))
    }

    fn loadGame:void (path:string) {
        this.loadGameDispatch(path)
        this.checkModeConsistency(("loadGame " + path))
    }

    fn loadGameDispatch:void (path:string) {
        gfx_audio_clear
        this.clearNavStack()
        nativeBridge.clearPendingNav()
        useWasm3d = false
        currentGamePath = path
        if (this.isStreamingPath(path)) {
            splitScreenActive = false
            wasmSplitActive = false
            this.loadStreamingAt(path)
            return
        }
        if ((this.renderOf(path)) == "sprites") {
            splitScreenActive = false
            wasmSplitActive = false
            spriteDirectPath = path
            return
        }
        if ((this.renderOf(path)) == "3d") {
            splitScreenActive = false
            wasmSplitActive = false
            this.loadWasm3dAt(path)
            return
        }
        if (this.isAsPath(path)) {
            this.loadAsAt(path)
            return
        }
        if (this.isWasmPath(path)) {
            this.resolveSplitMetadata(path)
            if (this.shouldUseSplitScreen()) {
                if (this.resolveWasmPhysics(path)) {
                    this.loadWasmSplitGame(path)
                    return
                }
            }
            splitScreenActive = false
            wasmSplitActive = false
            this.loadWasmAt(path)
            return
        }
        this.resolveSplitMetadata(path)
        if (this.shouldUseSplitScreen()) {
            this.loadSplitGame(path)
            return
        }
        splitScreenActive = false
        this.loadScriptAt(path false)
        inMenu = false
        inGame = true
    }

    fn applyPushGame:void (tsxPath:string) {
        this.pushNavStack(currentScriptPath)
        this.loadScriptAt(tsxPath false)
        inMenu = false
        inGame = true
    }

    fn applyPopGame:void () {
        def prev:string (this.popNavStack())
        if ((strlen prev) == 0) {
            inGame = false
            return
        }
        this.loadScriptAt(prev false)
        inMenu = false
        inGame = true
    }

    fn drainScriptNavigation:void () {
        if (false == (nativeBridge.hasPendingNav())) {
            return
        }
        def op:string (nativeBridge.takePendingNavOp())
        def path:string (nativeBridge.takePendingNavPath())
        nativeBridge.takePendingPopToMenu()
        if (op == "load") {
            if ((strlen path) > 0) {
                this.clearNavStack()
                this.loadScriptAt(path false)
                inMenu = false
                inGame = true
            }
            return
        }
        if (op == "push") {
            if ((strlen path) > 0) {
                this.applyPushGame(path)
            }
            return
        }
        if (op == "pop") {
            this.applyPopGame()
            return
        }
    }

    ; Split-screen panes each have their own GameHostNativeBridge. pushGame /
    ; loadGame from a pane script lands on leftBridge/rightBridge — not the
    ; solo nativeBridge — so the solo drainScriptNavigation never saw them
    ; (Ylos 3 / Invaders level advance was a no-op in split). Reload both panes.
    fn reloadSplitPanes:void (tsxPath:string) {
        gfx_audio_clear
        splitHost.clearPendingNav()
        currentGamePath = tsxPath
        currentScriptPath = tsxPath
        splitHost.loadPanes(tsxPath tsxPath)
        inMenu = false
        inGame = true
        this.syncInputEdges()
        gfx_clear_should_close
        print ("[split-screen] nav reload both panes: " + tsxPath)
    }

    fn drainSplitScriptNavigation:void () {
        if (false == (splitHost.consumePendingNav())) {
            return
        }
        def op:string splitHost.lastNavOp
        def path:string splitHost.lastNavPath
        if (op == "load") {
            if ((strlen path) > 0) {
                this.clearNavStack()
                this.reloadSplitPanes(path)
            }
            return
        }
        if (op == "push") {
            if ((strlen path) > 0) {
                this.pushNavStack(currentScriptPath)
                this.reloadSplitPanes(path)
            }
            return
        }
        if (op == "pop") {
            def prev:string (this.popNavStack())
            if ((strlen prev) == 0) {
                inGame = false
                splitScreenActive = false
                return
            }
            this.reloadSplitPanes(prev)
            return
        }
    }

    fn maybePollCatalog:void () {
        def now:int (gfx_ticks_ms)
        if ((now - lastCatalogPoll) < catalogPollMs) {
            return
        }
        lastCatalogPoll = now
        if (catalog.scanIfChanged()) {
            runner.registerGlobal("gameCatalog" (catalog.toEvalArray()))
            print ("[game-engine] catalog updated: " + (to_string (catalog.entryCount())) + " games")
        }
    }

    fn draw:void () {
        if (splitScreenActive) {
            def r0:int (gfx_ticks_ms)
            if (wasmSplitActive) {
                wasmSplitHost.draw()
            } {
                splitHost.draw()
                splitHost.flushGpuParticles()
            }
            def r1:int (gfx_ticks_ms)
            if (wasmSplitActive) {
                if (wasmSplitHost.isAutoscale()) {
                    gfx_present_split (wasmSplitHost.leftRaw()) (wasmSplitHost.rightRaw()) pw ph
                } {
                    gfx_present (wasmSplitHost.leftRaw()) pw ph
                }
            } {
                if (splitHost.isAutoscale()) {
                    gfx_present_split (splitHost.leftRaw()) (splitHost.rightRaw()) pw ph
                } {
                    gfx_present (splitHost.raw()) pw ph
                }
            }
            def r2:int (gfx_ticks_ms)
            if (profileEnabled) {
                profRenderMs = (profRenderMs + (r1 - r0))
                profPresentMs = (profPresentMs + (r2 - r1))
            }
            return
        }
        if (useStreamRunner) {
            def z0:int (gfx_ticks_ms)
            streamRunner.draw()
            def z1:int (gfx_ticks_ms)
            gfx_present (streamRunner.raw()) pw ph
            def z2:int (gfx_ticks_ms)
            if (profileEnabled) {
                profRenderMs = (profRenderMs + (z1 - z0))
                profPresentMs = (profPresentMs + (z2 - z1))
            }
            return
        }
        if (useSpriteRunner) {
            spriteRunner.draw()
            gfx_present (spriteRunner.raw()) pw ph
            return
        }
        if (useWasm3d) {
            ; the 3D runner draws directly to GL and swaps inside draw();
            ; no framebuffer present.
            wasm3dRunner.draw()
            return
        }
        def s0:int (gfx_ticks_ms)
        if (useWasmRunner) {
            if (useWasmPhysics) {
                wasmPhysicsRunner.draw()
            } {
                wasmRunner.draw()
            }
        } {
            runner.draw()
            runner.flushGpuParticles()
        }
        def s1:int (gfx_ticks_ms)
        if (useWasmRunner) {
            if (useWasmPhysics) {
                gfx_present (wasmPhysicsRunner.raw()) pw ph
            } {
                gfx_present (wasmRunner.raw()) pw ph
            }
        } {
            gfx_present (runner.raw()) pw ph
        }
        def s2:int (gfx_ticks_ms)
        if (profileEnabled) {
            profRenderMs = (profRenderMs + (s1 - s0))
            profPresentMs = (profPresentMs + (s2 - s1))
        }
    }

    ; Both panes press START on the same frame → switch to shared dual-player mode.
    fn dualModeToggleEdge:boolean () {
        gfx_input_poll
        def left:GameInputSnapshot (new GameInputSnapshot)
        left.buildForPane(0)
        def right:GameInputSnapshot (new GameInputSnapshot)
        right.buildForPane(1)
        if (left.p0.start) {
            if (right.p0.start) {
                return true
            }
        }
        return false
    }

    fn quitEdge:boolean (quitHeld:boolean) {
        if (quitHeld) {
            if (prevQuitHeld == false) {
                prevQuitHeld = true
                return true
            }
        } {
            prevQuitHeld = false
        }
        return false
    }

    ; Menu navigation: one step per key press (not while held).
    fn upEdge:boolean (held:boolean) {
        if (held) {
            if (prevUpHeld == false) {
                prevUpHeld = true
                return true
            }
        } {
            prevUpHeld = false
        }
        return false
    }

    fn downEdge:boolean (held:boolean) {
        if (held) {
            if (prevDownHeld == false) {
                prevDownHeld = true
                return true
            }
        } {
            prevDownHeld = false
        }
        return false
    }

    fn actionEdge:boolean (held:boolean) {
        if (held) {
            if (prevActionHeld == false) {
                prevActionHeld = true
                return true
            }
        } {
            prevActionHeld = false
        }
        return false
    }

    fn leftEdge:boolean (held:boolean) {
        if (held) {
            if (prevLeftHeld == false) {
                prevLeftHeld = true
                return true
            }
        } {
            prevLeftHeld = false
        }
        return false
    }

    fn rightEdge:boolean (held:boolean) {
        if (held) {
            if (prevRightHeld == false) {
                prevRightHeld = true
                return true
            }
        } {
            prevRightHeld = false
        }
        return false
    }

    ; --- player-2 edge detectors (second keyboard source), same one-step-per-
    ; press semantics as the P1 edges above but with their own held-state so the
    ; two players never share or steal each other's presses. ---
    fn up2Edge:boolean (held:boolean) {
        if (held) {
            if (prevUpHeld2 == false) {
                prevUpHeld2 = true
                return true
            }
        } {
            prevUpHeld2 = false
        }
        return false
    }

    fn down2Edge:boolean (held:boolean) {
        if (held) {
            if (prevDownHeld2 == false) {
                prevDownHeld2 = true
                return true
            }
        } {
            prevDownHeld2 = false
        }
        return false
    }

    fn action2Edge:boolean (held:boolean) {
        if (held) {
            if (prevActionHeld2 == false) {
                prevActionHeld2 = true
                return true
            }
        } {
            prevActionHeld2 = false
        }
        return false
    }

    fn left2Edge:boolean (held:boolean) {
        if (held) {
            if (prevLeftHeld2 == false) {
                prevLeftHeld2 = true
                return true
            }
        } {
            prevLeftHeld2 = false
        }
        return false
    }

    fn right2Edge:boolean (held:boolean) {
        if (held) {
            if (prevRightHeld2 == false) {
                prevRightHeld2 = true
                return true
            }
        } {
            prevRightHeld2 = false
        }
        return false
    }

    ; Turn a raw poll/source mask (up=1 down=2 action=4 left=16 right=32) into the
    ; guest input mask (up=1 down=2 left=4 right=8 action=16), edge-detected so each
    ; key press yields exactly one guest frame with the bit set. P1/P2 variants use
    ; their own edge state.
    fn spriteMaskP1:int (m:int) {
        def up:boolean (this.upEdge((bit_and m 1) != 0))
        def down:boolean (this.downEdge((bit_and m 2) != 0))
        def left:boolean (this.leftEdge((bit_and m 16) != 0))
        def right:boolean (this.rightEdge((bit_and m 32) != 0))
        def action:boolean (this.actionEdge((bit_and m 4) != 0))
        def mask:int 0
        if up { mask = (mask + 1) }
        if down { mask = (mask + 2) }
        if left { mask = (mask + 4) }
        if right { mask = (mask + 8) }
        if action { mask = (mask + 16) }
        return mask
    }

    fn spriteMaskP2:int (m:int) {
        def up:boolean (this.up2Edge((bit_and m 1) != 0))
        def down:boolean (this.down2Edge((bit_and m 2) != 0))
        def left:boolean (this.left2Edge((bit_and m 16) != 0))
        def right:boolean (this.right2Edge((bit_and m 32) != 0))
        def action:boolean (this.action2Edge((bit_and m 4) != 0))
        def mask:int 0
        if up { mask = (mask + 1) }
        if down { mask = (mask + 2) }
        if left { mask = (mask + 4) }
        if right { mask = (mask + 8) }
        if action { mask = (mask + 16) }
        return mask
    }

    ; True when the sprite game at `path` declares players=2 in game.info — the
    ; host then splits input (P1 = WASD/pad, P2 = arrows) into OFF_INPUT/OFF_INPUT2.
    fn spriteTwoPlayerOf:boolean (path:string) {
        def dir:string (this.dirOf(path))
        if (file_exists dir "game.info") {
            def buf:buffer (buffer_read_file dir "game.info")
            def txt:string (buffer_to_string buf)
            if ((indexOf txt "players=2") >= 0) {
                return true
            }
        }
        return false
    }

    ; The launcher backend menu/game.info selects via its `runtime` field:
    ; "tsx" (menu/launcher.tsx), "as" (menu/game.as), or "" if unspecified.
    fn menuRuntimeOf:string () {
        if (file_exists menuAsDir "game.info") {
            def buf:buffer (buffer_read_file menuAsDir "game.info")
            def txt:string (buffer_to_string buf)
            if ((indexOf txt "runtime=tsx") >= 0) {
                return "tsx"
            }
            if ((indexOf txt "runtime=as") >= 0) {
                return "as"
            }
        }
        return ""
    }

    ; Effective launcher mode: an explicit CLI flag wins; else menu/game.info's
    ; runtime; else the "tsx" default (dynamic heap tree, no fixed caps).
    fn effectiveMenuMode:string () {
        if ((strlen menuModeForced) > 0) {
            return menuModeForced
        }
        def rt:string (this.menuRuntimeOf())
        if (rt == "as") {
            return "as"
        }
        if (rt == "classic") {
            return "classic"
        }
        return "tsx"
    }

    ; True when the game folder for `path` declares engine=ui.
    fn engineOf:string (path:string) {
        def dir:string (this.dirOf(path))
        if (file_exists dir "game.info") {
            def buf:buffer (buffer_read_file dir "game.info")
            def txt:string (buffer_to_string buf)
            if ((indexOf txt "engine=ui") >= 0) {
                return "ui"
            }
        }
        return ""
    }

    ; Render mode declared in a game's game.info (render=sprites -> the guest
    ; authors a rotatable 2D sprite scene over the ABI, driven by runSpriteGame).
    fn renderOf:string (path:string) {
        def dir:string (this.dirOf(path))
        if (file_exists dir "game.info") {
            def buf:buffer (buffer_read_file dir "game.info")
            def txt:string (buffer_to_string buf)
            if ((indexOf txt "render=sprites") >= 0) {
                return "sprites"
            }
            if ((indexOf txt "render=3d") >= 0) {
                return "3d"
            }
        }
        return ""
    }

    ; Dispatch a menu/launcher selection to the right self-contained loop: a
    ; guest-driven sprite scene (render=sprites), an RGU1 UI game (engine=ui), or
    ; the normal wasm/tsx game loop.
    fn launchSelected:void (path:string) {
        if ((this.renderOf(path)) == "sprites") {
            this.runSpriteGame(path)
            return
        }
        if ((this.engineOf(path)) == "ui") {
            this.runUiGame(path)
            return
        }
        this.loadGame(path)
        this.runGameLoop()
    }

    ; Self-contained loop for a render=sprites .as game: interpret the guest, feed
    ; it input edges + a clock over the ABI, read its guest-authored sprite draw
    ; list back and present it (rotated). No physics — pure sprite rendering, the
    ; counterpart to runUiGame for rotatable 2D sprites. Renders at the 480x270
    ; game buffer (the guest lays out in those page pixels); the host scales it.
    fn runSpriteGame:void (asPath:string) {
        def scene:AsSpriteScene (new AsSpriteScene)
        scene.init(pw ph)
        if ((scene.loadGame((this.dirOf(asPath)))) == false) {
            print ("[game-engine] sprite game load failed: " + asPath)
            return
        }
        scene.audio.setSink((new SdlGameAudioSink))
        scene.audioOn = true
        print ("[game-engine] sprite game: " + asPath)
        currentScriptPath = asPath
        currentGamePath = asPath
        inMenu = false
        inGame = true
        gfx_clear_should_close
        this.syncInputEdges()
        ; players=2 games get two independent input channels: P1 = WASD (src 0) +
        ; gamepad 0 (src 2), P2 = arrow keys (src 1). A solo game keeps the merged
        ; mask so either WASD or the arrows drive the single well.
        def twoPlayer:boolean (this.spriteTwoPlayerOf(asPath))
        while (running) {
            if twoPlayer {
                def m0:int (bit_or (gfx_input_source_mask(0)) (gfx_input_source_mask(2)))
                def m1:int (gfx_input_source_mask(1))
                def mask0:int (this.spriteMaskP1(m0))
                def mask1:int (this.spriteMaskP2(m1))
                scene.frameMask2(16 mask0 mask1)
            } {
                def m:int (this.uiNavMask())
                def mask:int (this.spriteMaskP1(m))
                scene.frameMask(16 mask)
            }
            scene.draw()
            gfx_present (scene.raw()) pw ph

            if (this.quitEdge((this.gameMenuBackHeld()))) {
                inGame = false
                gfx_clear_should_close
                return
            }
            if (gfx_should_close) {
                running = false
                return
            }
            frames = (frames + 1)
            if (maxFrames > 0) {
                if (frames >= maxFrames) {
                    running = false
                    return
                }
            }
        }
    }

    ; Self-contained loop for an engine=ui game: instantiate the RGU1 guest,
    ; render its menu, move the selection with the D-pad, forward the action
    ; button to the guest, and return to the launcher on Back/Quit.
    fn runUiGame:void (wasmPath:string) {
        ; Render the UI at the actual output surface resolution (not the small pw*ph
        ; game buffer) so text/borders/effects are crisp instead of upscaled. Cap
        ; to bound the CPU cost of the software UI canvas; the guest UI scales to
        ; fill it (GameUiRunner.fitScale), so it looks identical at any resolution.
        def uw:int pw
        def uh:int ph
        def sw:int (gfx_surface_width)
        def sh:int (gfx_surface_height)
        if (sw > uw) { uw = sw }
        if (sh > uh) { uh = sh }
        if (uw > 1600) { uw = 1600 }
        if (uh > 1200) { uh = 1200 }
        uiRunner.init(uw uh "gallery/game_engine/assets/fonts" "OpenSans-Regular.ttf" "Open Sans")
        ; draw the live UI effects on the GPU when the GL present path is active
        uiRunner.setGpuEffects(gpuModeActive)
        ; engine=ui games come in two flavours: a compiled logic.wasm guest, or an
        ; interpreted .as source (runtime=as). Pick the backend by module suffix —
        ; loading a .as through wasm_load fails with "malformed Wasm binary".
        def ok:boolean false
        def n:int (strlen wasmPath)
        def isAs:boolean false
        if (n > 3) {
            if ((substring wasmPath (n - 3) n) == ".as") {
                isAs = true
            }
        }
        if isAs {
            ok = (uiRunner.loadAs((this.dirOf(wasmPath))))
        } {
            ok = (uiRunner.loadWasm(wasmPath))
        }
        if (ok == false) {
            print ("[game-engine] ui game load failed: " + wasmPath)
            return
        }
        print ("[game-engine] ui game: " + wasmPath)
        currentScriptPath = wasmPath
        currentGamePath = wasmPath
        inMenu = false
        inGame = true
        gfx_clear_should_close
        this.syncInputEdges()
        def nav:UiNavInput (new UiNavInput)
        while (running) {
            def m:int (this.uiNavMask())
            nav.clear()
            nav.up = (this.upEdge((bit_and m 1) != 0))
            nav.down = (this.downEdge((bit_and m 2) != 0))
            nav.left = (this.leftEdge((bit_and m 16) != 0))
            nav.right = (this.rightEdge((bit_and m 32) != 0))
            nav.action = (this.actionEdge((bit_and m 4) != 0))
            def _a:int (uiRunner.frame(nav))
            uiRunner.render()
            ; GPU path: emit the live glow/pulse effects as GL overlay quads that
            ; composite on top of the presented UI texture (software path draws them
            ; into the canvas in render() instead).
            if gpuModeActive {
                uiRunner.flushGpuEffects(uw uh)
            }
            gfx_present (uiRunner.raw()) uw uh

            if (this.quitEdge((this.gameMenuBackHeld()))) {
                inGame = false
                gfx_clear_should_close
                return
            }
            if (gfx_should_close) {
                running = false
                return
            }
            frames = (frames + 1)
            if (maxFrames > 0) {
                if (frames >= maxFrames) {
                    running = false
                    return
                }
            }
        }
    }

    ; Menu navigation: keyboard P1 WASD (src 0) + arrow keys (src 1) + gamepad 0
    ; (src 2) merged. The arrow keys are a distinct SDL source from WASD, so they
    ; must be OR'd in explicitly — otherwise the launcher only responds to WASD and
    ; the arrow keys (which the tiles' hint text advertises) do nothing. The back/
    ; quit edge is read separately (gameMenuBackHeld, src-0 Q/Esc + pad), so the
    ; LEFT arrow only moves the selection to the previous item; it never exits.
    fn launcherNavMask:int () {
        def kb1:int (gfx_input_source_mask(0))
        def kb2:int (gfx_input_source_mask(1))
        def pad:int (gfx_input_source_mask(2))
        return (bit_or (bit_or kb1 kb2) pad)
    }

    ; UI-menu navigation: WASD (src 0) + arrow keys (src 1) + gamepad 0 (src 2).
    ; Same source set as launcherNavMask above (kept separate so the two callers
    ; can diverge if a UI game ever needs a different binding).
    fn uiNavMask:int () {
        def kb1:int (gfx_input_source_mask(0))
        def kb2:int (gfx_input_source_mask(1))
        def pad:int (gfx_input_source_mask(2))
        return (bit_or (bit_or kb1 kb2) pad)
    }

    ; Return to launcher menu: Q/Esc, or gamepad Select / B.
    fn gameMenuBackHeld:boolean () {
        def kb:int (gfx_input_source_mask(0))
        if ((bit_and kb 8) != 0) {
            return true
        }
        def pad:int (gfx_input_source_mask(2))
        if ((bit_and pad 1024) != 0) {
            return true
        }
        if ((bit_and pad 64) != 0) {
            return true
        }
        return false
    }

    ; Target EVG-menu canvas size = live output surface (native resolution) so the
    ; tile art + TTF stay crisp on a big window; falls back to the pw*ph buffer.
    fn evgMenuTargetW:int () {
        def uw:int pw
        def sw:int (gfx_surface_width)
        if (sw > uw) { uw = sw }
        if (uw > 1600) { uw = 1600 }
        return uw
    }
    fn evgMenuTargetH:int () {
        def uh:int ph
        def sh:int (gfx_surface_height)
        if (sh > uh) { uh = sh }
        if (uh > 1200) { uh = 1200 }
        return uh
    }

    ; Bind the interpreted launcher menu (menu/game.as) with the live catalog
    ; injected as `gameCatalog`. Returns false if the menu source can't be loaded.
    fn openEvgMenu:boolean (uw:int uh:int) {
        catalog.setGamesDir(gamesDir)
        catalog.scan()
        uiRunner.init(uw uh "gallery/game_engine/assets/fonts" "OpenSans-Regular.ttf" "Open Sans")
        ; a wide, soft, warm selection halo (drop-shadow) around the focused tile —
        ; a tight white ring reads as hard/blocky, this is the prettier glow.
        uiRunner.ctrl.highlightPad = 8
        uiRunner.ctrl.glowSpread = 20
        uiRunner.ctrl.glowAlpha = 210
        uiRunner.ctrl.glowR = 255
        uiRunner.ctrl.glowG = 224
        uiRunner.ctrl.glowB = 130
        uiRunner.setMenuCatalog((catalog.toEvalArray()))
        menuAsMtime = (file_mtime menuAsDir "game.as")
        return (uiRunner.loadAs(menuAsDir))
    }

    ; Bind the rich TypeScript launcher (menu/launcher.tsx) with the live catalog
    ; injected as `gameCatalog`, rendered through the same WasmUiRenderer. Returns
    ; false if the source can't be loaded (caller falls back to the .as menu).
    fn openTsxMenu:boolean (uw:int uh:int) {
        catalog.setGamesDir(gamesDir)
        catalog.scan()
        ; Chakra Petch gives the launcher a techy, game-console feel; only the TSX
        ; launcher uses it — in-game HUDs keep Open Sans (see the other init sites).
        uiRunner.init(uw uh "gallery/game_engine/assets/fonts" "ChakraPetch-SemiBold.ttf" "Chakra Petch")
        uiRunner.setMenuCatalog((catalog.toEvalArray()))
        menuTsxMtime = (file_mtime menuAsDir "launcher.tsx")
        return (uiRunner.loadTsx(menuAsDir "launcher.tsx"))
    }

    ; Run the launcher menu — a normal interpreted .as engine=ui game living in
    ; menu/ that receives the catalog and reports (via OFF_LAUNCH) which sub-app to
    ; load. Being interpreted it hot-reloads like any other game. The crisp EVG UI
    ; layer renders it (same path as any .as menu); this loop just maps the chosen
    ; catalog index to a game path and dispatches it, then reopens the menu.
    fn runEvgMenuLoop:void () {
        gfx_audio_clear
        this.clearNavStack()
        nativeBridge.clearPendingNav()
        def uw:int (this.evgMenuTargetW())
        def uh:int (this.evgMenuTargetH())
        if ((this.openEvgMenu(uw uh)) == false) {
            print "[menu] menu/game.as failed to load — using classic menu"
            this.runMenuLoop()
            return
        }
        print ("[menu] .as launcher: " + (to_string (catalog.entryCount())) + " games")
        inMenu = true
        inGame = false
        gfx_set_title("Ranger Game Engine")
        gfx_clear_should_close
        this.syncInputEdges()
        def nav:UiNavInput (new UiNavInput)
        while (running) {
            ; render at the live output resolution: if the window changed size
            ; (resize / fullscreen toggle), re-open the menu at the new native
            ; resolution so the tiles + glow stay crisp instead of being upscaled
            ; from a smaller buffer (blocky).
            def nw:int (this.evgMenuTargetW())
            def nh:int (this.evgMenuTargetH())
            if ((nw != uw) || (nh != uh)) {
                uw = nw
                uh = nh
                this.openEvgMenu(uw uh)
            }
            ; live-reload: re-bind the menu when menu/game.as changes on disk, so
            ; editing the launcher takes effect without recompiling the engine.
            def curMtime:int (file_mtime menuAsDir "game.as")
            if (curMtime > menuAsMtime) {
                this.openEvgMenu(uw uh)
                print "[menu] reloaded menu/game.as"
            }
            def m:int (this.launcherNavMask())
            nav.clear()
            nav.up = (this.upEdge((bit_and m 1) != 0))
            nav.down = (this.downEdge((bit_and m 2) != 0))
            nav.left = (this.leftEdge((bit_and m 16) != 0))
            nav.right = (this.rightEdge((bit_and m 32) != 0))
            nav.action = (this.actionEdge((bit_and m 4) != 0))
            def _a:int (uiRunner.frame(nav))
            uiRunner.render()
            gfx_present (uiRunner.raw()) uw uh

            ; Back (Q/Esc / gamepad Select|B) quits the app; the menu handles its
            ; own in-menu back (left = games -> categories).
            if (this.quitEdge((this.gameMenuBackHeld()))) {
                running = false
                return
            }

            ; the menu reported a catalog index to launch -> load that game
            def li:int (uiRunner.launchIndex())
            if (li > 0) {
                def entry:GameCatalogEntry (catalog.entryAt(li - 1))
                def launchPath:string entry.entryPath
                if ((strlen launchPath) > 0) {
                    this.launchSelected(launchPath)
                    if (running == false) {
                        return
                    }
                    ; returned from the game: reopen the menu fresh (re-scan catalog
                    ; + re-inject), restore window + input state
                    this.openEvgMenu(uw uh)
                    gfx_clear_should_close
                    inMenu = true
                    inGame = false
                    gfx_set_title("Ranger Game Engine")
                    this.syncInputEdges()
                }
            }

            if (gfx_should_close) {
                running = false
            }
            frames = (frames + 1)
            if (maxFrames > 0) {
                if (frames >= maxFrames) {
                    running = false
                }
            }
        }
    }

    ; Run the rich TypeScript launcher (menu/launcher.tsx). Same present/input loop
    ; as runEvgMenuLoop, but the guest is a .tsx evaluated by ComponentEngine into
    ; the EVGElement tree WasmUiRenderer draws, and it reports a launch PATH (not a
    ; catalog index) directly in its state.
    fn runTsxMenuLoop:void () {
        gfx_audio_clear
        this.clearNavStack()
        nativeBridge.clearPendingNav()
        def uw:int (this.evgMenuTargetW())
        def uh:int (this.evgMenuTargetH())
        if ((this.openTsxMenu(uw uh)) == false) {
            print "[menu] menu/launcher.tsx failed to load — using the .as menu"
            this.runEvgMenuLoop()
            return
        }
        print ("[menu] .tsx launcher: " + (to_string (catalog.entryCount())) + " games")
        inMenu = true
        inGame = false
        gfx_set_title("Ranger Game Engine")
        gfx_clear_should_close
        this.syncInputEdges()
        def nav:UiNavInput (new UiNavInput)
        while (running) {
            ; re-open at the live output resolution on window resize (crisp tiles)
            def nw:int (this.evgMenuTargetW())
            def nh:int (this.evgMenuTargetH())
            if ((nw != uw) || (nh != uh)) {
                uw = nw
                uh = nh
                this.openTsxMenu(uw uh)
            }
            ; live-reload: re-bind when menu/launcher.tsx changes on disk
            def curMtime:int (file_mtime menuAsDir "launcher.tsx")
            if (curMtime > menuTsxMtime) {
                this.openTsxMenu(uw uh)
                print "[menu] reloaded menu/launcher.tsx"
            }
            def m:int (this.launcherNavMask())
            nav.clear()
            nav.up = (this.upEdge((bit_and m 1) != 0))
            nav.down = (this.downEdge((bit_and m 2) != 0))
            nav.left = (this.leftEdge((bit_and m 16) != 0))
            nav.right = (this.rightEdge((bit_and m 32) != 0))
            nav.action = (this.actionEdge((bit_and m 4) != 0))
            ; feed the Back/Quit edge to the guest instead of exiting here: the
            ; launcher decides back-vs-exit (games list -> categories; categories
            ; -> quit app, reported as quitApp -> wantsQuitTsx).
            uiRunner.setNavQuit((this.quitEdge((this.gameMenuBackHeld()))))
            def _a:int (uiRunner.frame(nav))
            uiRunner.render()
            gfx_present (uiRunner.raw()) uw uh

            if (uiRunner.wantsQuitTsx()) {
                running = false
                return
            }

            ; the launcher reported a game PATH to open -> dispatch + reopen
            def lp:string (uiRunner.launchPathTsx())
            if ((strlen lp) > 0) {
                this.launchSelected(lp)
                if (running == false) {
                    return
                }
                this.openTsxMenu(uw uh)
                gfx_clear_should_close
                inMenu = true
                inGame = false
                gfx_set_title("Ranger Game Engine")
                this.syncInputEdges()
            }

            if (gfx_should_close) {
                running = false
            }
            frames = (frames + 1)
            if (maxFrames > 0) {
                if (frames >= maxFrames) {
                    running = false
                }
            }
        }
    }

    fn runMenuLoop:void () {
        this.loadMenuGame()
        while (running) {
            def now:int (gfx_ticks_ms)
            def dtMs:int defaultDtMs
            if (lastFrameStart > 0) {
                dtMs = (now - lastFrameStart)
                if (dtMs < minDtMs) {
                    dtMs = minDtMs
                }
                if (dtMs > maxDtMs) {
                    dtMs = maxDtMs
                }
            }
            lastFrameStart = now

            def up:boolean false
            def down:boolean false
            def left:boolean false
            def right:boolean false
            def action:boolean false
            def quitHeld:boolean false
            def m:int (this.launcherNavMask())
            if ((bit_and m 1) != 0) {
                up = true
            }
            if ((bit_and m 2) != 0) {
                down = true
            }
            if ((bit_and m 16) != 0) {
                left = true
            }
            if ((bit_and m 32) != 0) {
                right = true
            }
            if ((bit_and m 4) != 0) {
                action = true
            }
            def kb:int (gfx_input_source_mask(0))
            if ((bit_and kb 8) != 0) {
                quitHeld = true
            }

            def quitPulse:boolean (this.quitEdge(quitHeld))
            def upPulse:boolean (this.upEdge(up))
            def downPulse:boolean (this.downEdge(down))
            def actionPulse:boolean (this.actionEdge(action))
            runner.frame(dtMs upPulse downPulse false false actionPulse quitPulse)
            this.draw()
            this.maybePollCatalog()

            def launchPath:string (runner.stateString("launchPath" ""))
            if ((strlen launchPath) > 0) {
                this.launchSelected(launchPath)
                if (running == false) {
                    return
                }
                this.loadMenuGame()
            }

            def quitApp:int (runner.stateInt("quitApp" 0))
            if (quitApp != 0) {
                running = false
            }
            if (quitPulse) {
                running = false
            }

            if (gfx_should_close) {
                running = false
            }
            frames = (frames + 1)
            if (maxFrames > 0) {
                if (frames >= maxFrames) {
                    running = false
                }
            }
        }
    }

    fn runGameLoop:void () {
        while (running) {
            if (splitScreenActive) {
                if (wasmSplitActive) {
                    wasmSplitHost.maybeHotReload()
                } {
                    splitHost.maybeHotReload()
                }
            } {
                runner.maybeHotReload()
            }
            def now:int (gfx_ticks_ms)
            def dtMs:int defaultDtMs
            if (lastFrameStart > 0) {
                dtMs = (now - lastFrameStart)
                if (dtMs < minDtMs) {
                    dtMs = minDtMs
                }
                if (dtMs > maxDtMs) {
                    dtMs = maxDtMs
                }
            }
            lastFrameStart = now

            def up:boolean false
            def down:boolean false
            def left:boolean false
            def right:boolean false
            def action:boolean false
            def quitHeld:boolean (this.gameMenuBackHeld())

            if (this.quitEdge(quitHeld)) {
                ; Sprite game: Q in play returns to its character-select menu; Q in
                ; that menu falls through to the normal exit-to-launcher below.
                def spriteBack:boolean false
                if (useSpriteRunner) {
                    if ((spriteRunner.guestMode()) == 1) {
                        spriteRunner.requestBack()
                        spriteBack = true
                    }
                }
                if (spriteBack == false) {
                    this.clearNavStack()
                    nativeBridge.clearPendingNav()
                    inGame = false
                    splitScreenActive = false
                    wasmSplitActive = false
                    dualPlayerMode = false
                    gfx_clear_should_close
                    return
                }
            }

            def tUpdateStart:int (gfx_ticks_ms)
            if (splitScreenActive) {
                if (this.dualModeToggleEdge()) {
                    print "[split-screen] switching to dual-player mode"
                    dualPlayerMode = true
                    splitScreenActive = false
                    wasmSplitActive = false
                    if (this.isWasmPath(currentGamePath)) {
                        this.loadWasmAt(currentGamePath)
                    } {
                        this.loadScriptAt(currentGamePath false)
                    }
                    this.syncInputEdges()
                } {
                    if (wasmSplitActive) {
                        wasmSplitHost.frame(dtMs)
                    } {
                        splitHost.frameWithInput(dtMs)
                        this.drainSplitScriptNavigation()
                    }
                }
            } {
                if (useWasm3d) {
                    def gameInput3d:GameInputSnapshot (this.pollGameInput())
                    wasm3dRunner.frameWithInput(dtMs gameInput3d.p0.up gameInput3d.p0.down gameInput3d.p0.left gameInput3d.p0.right gameInput3d.p0.action)
                } {
                if (useSpriteRunner) {
                    def gameInputSp:GameInputSnapshot (this.pollGameInput())
                    spriteRunner.frameWithInput(dtMs gameInputSp.p0.up gameInputSp.p0.down gameInputSp.p0.left gameInputSp.p0.right gameInputSp.p0.action)
                } {
                if (useStreamRunner) {
                    def gameInputS:GameInputSnapshot (this.pollGameInput())
                    streamRunner.frameWithInput(dtMs gameInputS.p0.up gameInputS.p0.down gameInputS.p0.left gameInputS.p0.right gameInputS.p0.action)
                } {
                    if (useWasmRunner) {
                        def gameInput:GameInputSnapshot (this.pollGameInput())
                        if (useWasmPhysics) {
                            def f0:int (this.playerInputFlags(gameInput.p0))
                            def f1:int (this.playerInputFlags(gameInput.p1))
                            wasmPhysicsRunner.frameWithFlags(dtMs f0 f1)
                        } {
                            wasmRunner.frameWithInput(dtMs gameInput.p0.up gameInput.p0.down gameInput.p0.left gameInput.p0.right gameInput.p0.action)
                        }
                    } {
                        def gameInput:GameInputSnapshot (this.pollGameInput())
                        runner.frameWithInput(dtMs gameInput)
                        this.drainScriptNavigation()
                    }
                }
                }
                }
            }
            def tUpdateEnd:int (gfx_ticks_ms)

            if (false == inGame) {
                gfx_clear_should_close
                return
            }
            this.updateFps()
            def tDrawStart:int (gfx_ticks_ms)
            this.draw()
            def tDrawEnd:int (gfx_ticks_ms)
            if (profileEnabled) {
                profUpdateMs = (profUpdateMs + (tUpdateEnd - tUpdateStart))
                profDrawMs = (profDrawMs + (tDrawEnd - tDrawStart))
                profFrames = (profFrames + 1)
            }
            frames = (frames + 1)
            if (gfx_should_close) {
                running = false
            }
            if (maxFrames > 0) {
                if (frames >= maxFrames) {
                    running = false
                }
            }
        }
    }

    fn run:void () {
        def title:string "Ranger Game (SDL2)"
        if (gpuModeWanted) {
            def okGpu:int (gfx_open_gpu title pw ph)
            if (okGpu != 0) {
                gpuModeActive = true
                print "[game-engine] OpenGL present (default)"
            } {
                print "[game-engine] gfx_open_gpu failed — falling back to software present"
                gpuModeActive = false
            }
        }
        if (false == gpuModeActive) {
            def ok:int (gfx_open title pw ph)
            if (ok == 0) {
                print "gfx_open failed (no display?) - still rendering into the RGBA buffer"
            } {
                print "[game-engine] SDL software present (--software)"
            }
        }
        ; Direct-launch games are parsed before the window/GL context opens.
        ; Re-apply the resolved mode now so cached sheets can upload textures.
        if (splitScreenActive) {
            splitHost.setGpuMode(gpuModeActive)
            splitHost.enableGpuSheetOverlay()
        } {
            runner.setGpuMode(gpuModeActive)
            runner.enableGpuSheetOverlay()
        }
        if (startFullscreen) {
            gfx_set_fullscreen(1)
        }
        gfx_audio_open(44100)
        this.refreshWasmAudioSampleRate()
        if (launcherMode) {
            def mode:string (this.effectiveMenuMode())
            if (mode == "as") {
                this.runEvgMenuLoop()
            } {
                if (mode == "classic") {
                    this.runMenuLoop()
                } {
                    this.runTsxMenuLoop()
                }
            }
        } {
            if ((strlen spriteDirectPath) > 0) {
                this.runSpriteGame(spriteDirectPath)
            } {
                if ((strlen uiDirectPath) > 0) {
                    this.runUiGame(uiDirectPath)
                } {
                    this.runGameLoop()
                }
            }
        }
        gfx_close
    }

    fn isWasmPath:boolean (arg:string) {
        def len:int (strlen arg)
        if (len < 5) {
            return false
        }
        def tail:string (substring arg (len - 5) len)
        if (tail == ".wasm") {
            return true
        }
        return false
    }

    ; A streaming game: catalog entry engine=streaming, or (direct launch) a
    ; game.info with engine=streaming next to the .wasm module.
    fn isStreamingPath:boolean (path:string) {
        def entry:GameCatalogEntry (catalog.findByPath(path))
        if (entry.engine == "streaming") {
            return true
        }
        if (this.isWasmPath(path)) {
            def slash:int (lastIndexOf path "/")
            if (slash >= 0) {
                def dir:string (substring path 0 slash)
                if (file_exists dir "game.info") {
                    def buf:buffer (buffer_read_file dir "game.info")
                    def txt:string (buffer_to_string buf)
                    if ((indexOf txt "engine=streaming") >= 0) {
                        return true
                    }
                }
            }
        }
        return false
    }

    fn isAsPath:boolean (arg:string) {
        def len:int (strlen arg)
        if (len < 3) {
            return false
        }
        def tail:string (substring arg (len - 3) len)
        if (tail == ".as") {
            return true
        }
        return false
    }

    fn isTsxPath:boolean (arg:string) {
        def len:int (strlen arg)
        if (len < 4) {
            return false
        }
        def tail:string (substring arg (len - 4) len)
        if (tail == ".tsx") {
            return true
        }
        return false
    }

    fn startsWith:boolean (s:string prefix:string) {
        def plen:int (strlen prefix)
        if ((strlen s) < plen) {
            return false
        }
        def head:string (substring s 0 plen)
        return (head == prefix)
    }

    fn parseArgs:void () {
        def tsxPath:string ""
        def i:int 0
        def pendingGamesDir:boolean false
        while (i < (shell_arg_cnt)) {
            def arg:string (shell_arg i)
            ; launcher front-page style: EVG tile menu (default) vs the old tsx menu
            if (arg == "--classic-menu") {
                menuModeForced = "classic"
            }
            if (arg == "--evg-menu") {
                menuModeForced = "as"
            }
            if (arg == "--tsx-menu") {
                menuModeForced = "tsx"
            }
            if (pendingGamesDir) {
                gamesDir = arg
                launcherMode = true
                pendingGamesDir = false
            } {
                if (arg == "--profile") {
                    profileEnabled = true
                } {
                if (arg == "--hot-reload") {
                    hotReloadExplicit = true
                    hotReloadWanted = true
                } {
                    if (arg == "--no-hot-reload") {
                        hotReloadExplicit = true
                        hotReloadWanted = false
                    } {
                        if (arg == "--software") {
                            gpuModeWanted = false
                        } {
                            if (arg == "--no-gpu") {
                                gpuModeWanted = false
                            } {
                                if (arg == "--gpu") {
                                    gpuModeWanted = true
                                } {
                                    if (arg == "--fullscreen") {
                                        startFullscreen = true
                                    } {
                                        if (arg == "--windowed") {
                                            startFullscreen = false
                                        } {
                                            if (arg == "--games-dir") {
                                                pendingGamesDir = true
                                                launcherMode = true
                                            } {
                                                if (this.startsWith(arg "--games-dir=")) {
                                                    def plen:int (strlen "--games-dir=")
                                                    gamesDir = (substring arg plen (strlen arg))
                                                    launcherMode = true
                                                } {
                                                    if (this.isTsxPath(arg)) {
                                                        tsxPath = arg
                                                    } {
                                        if (this.isWasmPath(arg)) {
                                            tsxPath = arg
                                        } {
                                            if (this.isAsPath(arg)) {
                                                tsxPath = arg
                                            } {
                                                if ((strlen tsxPath) > 0) {
                                                    def parsed@(optional):int (to_int arg)
                                                    if (!null? parsed) {
                                                        maxFrames = (unwrap parsed)
                                                    }
                                                }
                                            }
                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }
            i = (i + 1)
        }
        if ((strlen tsxPath) > 0) {
            launcherMode = false
            this.loadGame(tsxPath)
            this.setProfileOnRunners()
            return
        }
        launcherMode = true
        this.setProfileOnRunners()
    }

    sfn m@(main):void () {
        def be:GameSdlRunner (new GameSdlRunner)
        be.parseArgs()
        be.run()
        if (be.profileEnabled) {
            if (be.profFrames > 0) {
                def pmsg:string ("[profile] frames=" + be.profFrames)
                pmsg = (pmsg + " | update(all)=" + be.profUpdateMs + "ms")
                pmsg = (pmsg + " | draw(all)=" + be.profDrawMs + "ms")
                pmsg = (pmsg + " | render(no present)=" + be.profRenderMs + "ms")
                pmsg = (pmsg + " | present(SDL)=" + be.profPresentMs + "ms")
                pmsg = (pmsg + " | update/frame=" + (idiv be.profUpdateMs be.profFrames) + "ms")
                pmsg = (pmsg + " | draw/frame=" + (idiv be.profDrawMs be.profFrames) + "ms")
                pmsg = (pmsg + " | render/frame=" + (idiv be.profRenderMs be.profFrames) + "ms")
                pmsg = (pmsg + " | present/frame=" + (idiv be.profPresentMs be.profFrames) + "ms")
                print pmsg
            }
            if (be.splitScreenActive) {
                if (be.splitHost.profFrames > 0) {
                    def sf:int be.splitHost.profFrames
                    def splitLine:string ("[profile:split] leftDraw=" + be.splitHost.profLeftDrawMs + "ms")
                    splitLine = (splitLine + " rightDraw=" + be.splitHost.profRightDrawMs + "ms")
                    splitLine = (splitLine + " blit=" + be.splitHost.profBlitMs + "ms")
                    splitLine = (splitLine + " | leftDraw/frame=" + (idiv be.splitHost.profLeftDrawMs sf) + "ms")
                    splitLine = (splitLine + " | rightDraw/frame=" + (idiv be.splitHost.profRightDrawMs sf) + "ms")
                    splitLine = (splitLine + " | blit/frame=" + (idiv be.splitHost.profBlitMs sf) + "ms")
                    if (be.splitAutoscale) {
                        splitLine = (splitLine + " autoscale=on")
                    } {
                        splitLine = (splitLine + " autoscale=off")
                    }
                    print splitLine
                }
                be.printRunnerProfile("left" be.splitHost.left)
                be.printRunnerProfile("right" be.splitHost.right)
            } {
                if (be.useWasmRunner) {
                    if (be.useWasmPhysics) {
                        print ("[wasm] p1=" + (be.wasmPhysicsRunner.entityY("p1")))
                    } {
                        print ("[wasm] ball=" + (be.wasmRunner.entityX("ball")) + "," + (be.wasmRunner.entityY("ball")))
                    }
                } {
                    be.printRunnerProfile("game" be.runner)
                }
            }
        }
        if (be.inGame) {
            def msg:string ("game-sdl done: frames=" + be.frames)
            if (be.useWasmRunner) {
                if (be.useWasmPhysics) {
                    msg = (msg + " | entities=" + (array_length be.wasmPhysicsRunner.drawEntities))
                    msg = (msg + " | hits=" + (to_string be.wasmPhysicsRunner.hits))
                } {
                    msg = (msg + " | entities=" + (array_length be.wasmRunner.entities))
                    msg = (msg + " | score ")
                    msg = (msg + be.wasmRunner.score1)
                    msg = (msg + " - ")
                    msg = (msg + be.wasmRunner.score2)
                }
            } {
                msg = (msg + " | entities=" + (be.runner.entityCount()))
                msg = (msg + " | score ")
                msg = (msg + be.runner.score1)
                msg = (msg + " - ")
                msg = (msg + be.runner.score2)
            }
            if (be.fpsShown > 0) {
                msg = (msg + " | fps=")
                msg = (msg + (to_string be.fpsShown))
            }
            print msg
        }
    }
}

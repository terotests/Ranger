; ==============================================================================
; game_sdl_runner - SDL2 host for script-driven games (.tsx / .game.tsx).
; ==============================================================================
;
; Loads a TypeScript game script from the first CLI argument, evaluates it via
; GameRunner (retained sprites + update reducer), and presents each frame through
; the native SDL2 backend (gfx_sdl.rgr).
;
;   ./game_sdl gallery/game_engine/scripting/pong.game.tsx
;   SDL_VIDEODRIVER=dummy ./game_sdl gallery/game_engine/scripting/pong.game.tsx 300
;
; Controls: Arrow keys / A,D = move (game-specific), W/S = alt, Space = action, Q/Esc = quit.
; Optional second CLI arg = max frames (headless smoke / CI).
; ==============================================================================

Import "./game_runtime.rgr"
Import "../gfx_sdl.rgr"

class GameSdlRunner {
    def runner:GameRunner (new GameRunner)
    def pw:int 480
    def ph:int 270
    def maxFrames:int 0
    def frames:int 0
    def running:boolean true

    fn loadGame:void (tsxPath:string) {
        def dir:string ""
        def file:string tsxPath
        def slash:int (lastIndexOf tsxPath "/")
        if (slash >= 0) {
            dir = (substring tsxPath 0 slash)
            file = (substring tsxPath (slash + 1) (strlen tsxPath))
        }
        def buf:buffer (buffer_read_file dir file)
        def src:string (buffer_to_string buf)
        runner.init(pw ph)
        runner.loadScript(src)
        runner.setupScene()
    }

    fn draw:void () {
        runner.draw()
        gfx_present (runner.raw()) pw ph
    }

    fn run:void () {
        def title:string "Ranger Game (SDL2)"
        def ok:int (gfx_open title pw ph)
        if (ok == 0) {
            print "gfx_open failed (no display?) - still rendering into the RGBA buffer"
        }
        while (running) {
            def up:boolean false
            def down:boolean false
            def left:boolean false
            def right:boolean false
            def m:int (gfx_poll_mask)
            if ((bit_and m 1) != 0) {
                up = true
            }
            if ((bit_and m 2) != 0) {
                down = true
            }
            if ((bit_and m 16) != 0) {
                left = true
            }
            if ((bit_and m 32) != 0) {
                right = true
            }
            if ((bit_and m 8) != 0) {
                running = false
            }
            runner.frame(16 up down left right)
            this.draw()
            frames = (frames + 1)
            if (gfx_should_close) {
                running = false
            }
            if (maxFrames > 0) {
                if (frames >= maxFrames) {
                    running = false
                }
            }
        }
        gfx_close
    }

    sfn m@(main):void () {
        if ((shell_arg_cnt) < 1) {
            print "usage: game_sdl <path/to/game.tsx> [maxFrames]"
            print "example: game_sdl gallery/game_engine/scripting/pong.game.tsx"
            return
        }
        def be:GameSdlRunner (new GameSdlRunner)
        def tsxPath:string (shell_arg 0)
        be.loadGame(tsxPath)
        if ((shell_arg_cnt) > 1) {
            def parsed@(optional):int (to_int (shell_arg 1))
            if (!null? parsed) {
                be.maxFrames = (unwrap parsed)
            }
        }
        be.run()
        def msg:string ("game-sdl done: frames=" + be.frames)
        msg = (msg + " | entities=" + (be.runner.entityCount()))
        def sx:int (be.runner.entityX("ship4"))
        def sy:int (be.runner.entityY("ship4"))
        msg = (msg + " | ship=")
        msg = (msg + sx)
        msg = (msg + ",")
        msg = (msg + sy)
        msg = (msg + " | score ")
        msg = (msg + be.runner.score1)
        msg = (msg + " - ")
        msg = (msg + be.runner.score2)
        print msg
    }
}

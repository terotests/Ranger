; ==============================================================================
; game_sdl_runner - SDL2 host for script-driven games (.tsx / .game.tsx).
; ==============================================================================
;
; Launcher flow:
;   1. Load gallery/game_engine/menu/index.tsx (menu game, EVG hud).
;   2. Host scans --games-dir and injects `gameCatalog` global into the menu.
;   3. Menu sets state.launchPath → host loads that game's index.tsx.
;   4. Q/Esc or gamepad Select/B in a sub-game → back to menu game.
;   5. Q/Esc in menu → quit app.
;
; Direct launch (no menu):
;   ./game_sdl path/to/game.tsx
;
;   ./game_sdl [--software] [--games-dir=DIR] [--hot-reload|--no-hot-reload] [maxFrames]
; ==============================================================================

Import "./game_runtime.rgr"
Import "../gfx_sdl.rgr"
Import "./game_audio_sdl.rgr"
Import "./game_catalog.rgr"
Import "./game_host_native.rgr"
Import "./game_input.rgr"
Import "./game_split_screen.rgr"

class SdlGameHost extends GameHost {
    fn onRumble:void (e:GameEventNative) {
        def p:int (e.pad)
        def strength:int (e.low)
        if (e.high > strength) {
            strength = e.high
        }
        def dur:int (e.ms)
        gfx_rumble_pad p strength dur
    }
}

class GameSdlRunner {
    def runner:GameRunner (new GameRunner)
    def splitHost:SplitScreenHost (new SplitScreenHost)
    def catalog:GameCatalog (new GameCatalog)
    def nativeBridge:GameHostNativeBridge (new GameHostNativeBridge)
    def pw:int 480
    def ph:int 270
    def maxFrames:int 0
    def frames:int 0
    def running:boolean true
    def profUpdateMs:int 0
    def profDrawMs:int 0
    def profRenderMs:int 0
    def profPresentMs:int 0
    def profFrames:int 0
    def profileEnabled:boolean false
    def fpsShown:int 0
    def fpsWindowStart:int 0
    def fpsWindowFrames:int 0
    def lastFrameStart:int 0
    def defaultDtMs:int 16
    def minDtMs:int 1
    def maxDtMs:int 100
    def hotReloadExplicit:boolean false
    def hotReloadWanted:boolean true
    def startFullscreen:boolean false
    def gamesDir:string "gallery/game_engine/games"
    def menuPath:string "gallery/game_engine/menu/index.tsx"
    def launcherMode:boolean false
    def inMenu:boolean false
    def inGame:boolean false
    def splitScreenActive:boolean false
    def dualPlayerMode:boolean false
    def splitScreenPref:string "never"
    def soloScriptPath:string ""
    def splitAutoscale:boolean true
    def currentGamePath:string ""
    def prevQuitHeld:boolean false
    def currentScriptPath:string ""
    def navStack:[string]
    def catalogPollMs:int 10000
    def lastCatalogPoll:int 0
    def prevUpHeld:boolean false
    def prevDownHeld:boolean false
    def prevActionHeld:boolean false
    def gpuModeWanted:boolean true
    def gpuModeActive:boolean false
    def gameInputSnap:GameInputSnapshot (new GameInputSnapshot)

    fn setProfileOnRunners:void () {
        runner.setProfileEnabled(profileEnabled)
        splitHost.setProfileEnabled(profileEnabled)
    }

    fn printRunnerProfile:void (label:string r:GameRunner) {
        if (false == profileEnabled) {
            return
        }
        if (r.profFrames <= 0) {
            return
        }
        def pf:int r.profFrames
        def line:string ("[profile:" + label + "] updateScript=" + r.profUpdateScriptMs + "ms")
        line = (line + " sync=" + r.profUpdateSyncMs + "ms")
        line = (line + " drawBg=" + r.profDrawBgMs + "ms")
        line = (line + " drawSprites=" + r.profDrawSpritesMs + "ms")
        line = (line + " drawHud(interp)=" + r.profDrawHudMs + "ms")
        line = (line + " | updateScript/frame=" + (idiv r.profUpdateScriptMs pf) + "ms")
        line = (line + " hud/frame=" + (idiv r.profDrawHudMs pf) + "ms")
        print line
    }

    fn updateFps:void () {
        def now:int (gfx_ticks_ms)
        if (fpsWindowStart <= 0) {
            fpsWindowStart = now
            fpsWindowFrames = 0
        }
        fpsWindowFrames = (fpsWindowFrames + 1)
        def elapsed (now - fpsWindowStart)
        if (elapsed >= 1000) {
            fpsShown = (to_int ((fpsWindowFrames * 1000) / elapsed))
            fpsWindowStart = now
            fpsWindowFrames = 0
            def title:string "Ranger Game (SDL2) - "
            title = (title + (to_string fpsShown))
            title = (title + " FPS")
            if (splitScreenActive) {
                title = (title + " [split]")
            }
            gfx_set_title(title)
        }
        if (splitScreenActive) {
            splitHost.setFpsShown(fpsShown)
        } {
            runner.setFpsShown(fpsShown)
        }
    }

    fn clearNavStack:void () {
        def empty:[string]
        navStack = empty
    }

    fn pushNavStack:void (path:string) {
        if ((strlen path) > 0) {
            push navStack path
        }
    }

    fn popNavStack:string () {
        def cnt:int (array_length navStack)
        if (cnt <= 0) {
            return ""
        }
        def top:string (itemAt navStack (cnt - 1))
        def trimmed:[string]
        def i:int 0
        while (i < (cnt - 1)) {
            push trimmed (itemAt navStack i)
            i = (i + 1)
        }
        navStack = trimmed
        return top
    }

    fn wireNativeBridge:void (scriptDir:string) {
        nativeBridge.setGameDir(scriptDir)
        runner.setNativeBridge(nativeBridge)
    }

    fn presentLoadingScreen:void (label:string) {
        if (pw <= 0) {
            return
        }
        if (ph <= 0) {
            return
        }
        def ticks:int (gfx_ticks_ms)
        runner.drawLoadingScreen(label ticks)
        gfx_present (runner.raw()) pw ph
    }

    fn loadScriptAt:void (tsxPath:string injectCatalog:boolean) {
        if (inGame) {
            this.presentLoadingScreen("LOADING")
        }
        if (inMenu) {
            this.presentLoadingScreen("LOADING")
        }
        def dir:string ""
        def file:string tsxPath
        def slash:int (lastIndexOf tsxPath "/")
        if (slash >= 0) {
            dir = (substring tsxPath 0 slash)
            file = (substring tsxPath (slash + 1) (strlen tsxPath))
        }
        def buf:buffer (buffer_read_file dir file)
        def src:string (buffer_to_string buf)
        runner = (new GameRunner)
        runner.init(pw ph)
        runner.setGpuMode(gpuModeActive)
        runner.audio.setSink((new SdlGameAudioSink))
        def devRate:int (gfx_audio_sample_rate)
        if (devRate > 0) {
            runner.audio.sampleRate = devRate
        }
        runner.host = (new SdlGameHost)
        runner.wireHostAudio()
        runner.setScriptDir(dir)
        this.wireNativeBridge(dir)
        if (injectCatalog) {
            runner.registerGlobal("gameCatalog" (catalog.toEvalArray()))
        }
        this.presentLoadingScreen("LOADING")
        runner.loadScript(src)
        this.presentLoadingScreen("LOADING")
        runner.setupScene()
        runner.enableGpuSheetOverlay()
        runner.registerDefaultPaneGlobals()
        runner.trackScriptFile(tsxPath)
        currentScriptPath = tsxPath
        def enableHotReload:boolean hotReloadWanted
        if (maxFrames > 0) {
            if (hotReloadExplicit == false) {
                enableHotReload = false
            }
        }
        runner.setHotReload(enableHotReload)
        if (enableHotReload) {
            print ("[game-engine] hot reload enabled: " + tsxPath)
        }
        this.syncInputEdges()
        gameInputSnap.resetSoloPad()
        gfx_clear_should_close
        this.setProfileOnRunners()
    }

    ; After script swap, match edge state to keys still held (avoids double Q:
    ; game exit on Q then immediate menu quit while the key is still down).
    fn syncInputEdges:void () {
        def m:int (gfx_poll_mask)
        prevQuitHeld = ((bit_and m 8) != 0)
        prevUpHeld = ((bit_and m 1) != 0)
        prevDownHeld = ((bit_and m 2) != 0)
        prevActionHeld = ((bit_and m 4) != 0)
    }

    fn pollGameInput:GameInputSnapshot () {
        gfx_input_poll
        def count:int (runner.resolvePlayerCount())
        gameInputSnap.buildFromSdl(count)
        return gameInputSnap
    }

    fn loadMenuGame:void () {
        gfx_audio_clear
        catalog.setGamesDir(gamesDir)
        catalog.scan()
        this.clearNavStack()
        nativeBridge.clearPendingNav()
        print ("[menu] games dir: " + gamesDir)
        print ("[menu] catalog entries: " + (to_string (catalog.entryCount())))
        def li 0
        while (li < (catalog.entryCount())) {
            def entry:GameCatalogEntry (catalog.entryAt(li))
            print ("[menu]   " + (to_string li) + ": " + entry.title + " -> " + entry.entryPath)
            li = (li + 1)
        }
        this.loadScriptAt(menuPath true)
        inMenu = true
        inGame = false
        lastCatalogPoll = (gfx_ticks_ms)
        gfx_set_title("Ranger Game Engine")
    }

    fn resolveSplitAutoscale:boolean (entry:GameCatalogEntry) {
        if (entry.autoscale == "false") {
            return false
        }
        if (entry.autoscale == "true") {
            return true
        }
        ; Default: host scales full-width framebuffer down to each pane.
        return true
    }

    fn resolveSplitMetadata:void (tsxPath:string) {
        if ((strlen gamesDir) > 0) {
            if ((catalog.entryCount()) == 0) {
                catalog.setGamesDir(gamesDir)
                catalog.scan()
            }
        }
        splitScreenPref = "never"
        soloScriptPath = ""
        splitAutoscale = true
        def entry:GameCatalogEntry (catalog.findByPath(tsxPath))
        if ((strlen entry.splitScreen) > 0) {
            splitScreenPref = entry.splitScreen
        }
        soloScriptPath = (catalog.resolveSoloPath(entry))
        splitAutoscale = (this.resolveSplitAutoscale(entry))
    }

    fn shouldUseSplitScreen:boolean () {
        if (dualPlayerMode) {
            return false
        }
        if (splitScreenPref == "never") {
            return false
        }
        if (splitScreenPref == "always") {
            return true
        }
        if (splitScreenPref == "auto") {
            return true
        }
        return false
    }

    fn splitPanePath:string () {
        if ((strlen soloScriptPath) > 0) {
            return soloScriptPath
        }
        return currentGamePath
    }

    fn loadSplitGame:void (tsxPath:string) {
        gfx_audio_clear
        this.clearNavStack()
        nativeBridge.clearPendingNav()
        currentGamePath = tsxPath
        this.resolveSplitMetadata(tsxPath)
        def panePath:string (this.splitPanePath())
        if ((strlen panePath) == 0) {
            splitScreenActive = false
            this.loadScriptAt(tsxPath false)
            inMenu = false
            inGame = true
            return
        }
        this.presentLoadingScreen("SPLIT")
        splitHost = (new SplitScreenHost)
        splitHost.init(pw ph splitAutoscale)
        splitHost.setAudioSink((new SdlGameAudioSink))
        def splitRate:int (gfx_audio_sample_rate)
        splitHost.setAudioSampleRate(splitRate)
        splitHost.setSdlHost()
        splitHost.setGpuMode(gpuModeActive)
        splitHost.loadPanes(panePath panePath)
        def enableHotReload:boolean hotReloadWanted
        if (maxFrames > 0) {
            if (hotReloadExplicit == false) {
                enableHotReload = false
            }
        }
        splitHost.setHotReload(enableHotReload)
        currentScriptPath = tsxPath
        inMenu = false
        inGame = true
        splitScreenActive = true
        this.syncInputEdges()
        gameInputSnap.resetSoloPad()
        gfx_clear_should_close
        print ("[split-screen] left=" + panePath)
        print ("[split-screen] right=" + panePath)
        if (splitAutoscale) {
            print "[split-screen] autoscale=on"
        } {
            print "[split-screen] autoscale=off"
        }
        this.setProfileOnRunners()
    }

    fn loadGame:void (tsxPath:string) {
        gfx_audio_clear
        this.clearNavStack()
        nativeBridge.clearPendingNav()
        currentGamePath = tsxPath
        this.resolveSplitMetadata(tsxPath)
        if (this.shouldUseSplitScreen()) {
            this.loadSplitGame(tsxPath)
            return
        }
        splitScreenActive = false
        this.loadScriptAt(tsxPath false)
        inMenu = false
        inGame = true
    }

    fn applyPushGame:void (tsxPath:string) {
        this.pushNavStack(currentScriptPath)
        this.loadScriptAt(tsxPath false)
        inMenu = false
        inGame = true
    }

    fn applyPopGame:void () {
        def prev:string (this.popNavStack())
        if ((strlen prev) == 0) {
            inGame = false
            return
        }
        this.loadScriptAt(prev false)
        inMenu = false
        inGame = true
    }

    fn drainScriptNavigation:void () {
        if (false == (nativeBridge.hasPendingNav())) {
            return
        }
        def op:string (nativeBridge.takePendingNavOp())
        def path:string (nativeBridge.takePendingNavPath())
        nativeBridge.takePendingPopToMenu()
        if (op == "load") {
            if ((strlen path) > 0) {
                this.clearNavStack()
                this.loadScriptAt(path false)
                inMenu = false
                inGame = true
            }
            return
        }
        if (op == "push") {
            if ((strlen path) > 0) {
                this.applyPushGame(path)
            }
            return
        }
        if (op == "pop") {
            this.applyPopGame()
            return
        }
    }

    fn maybePollCatalog:void () {
        def now:int (gfx_ticks_ms)
        if ((now - lastCatalogPoll) < catalogPollMs) {
            return
        }
        lastCatalogPoll = now
        if (catalog.scanIfChanged()) {
            runner.registerGlobal("gameCatalog" (catalog.toEvalArray()))
            print ("[game-engine] catalog updated: " + (to_string (catalog.entryCount())) + " games")
        }
    }

    fn draw:void () {
        if (splitScreenActive) {
            def r0:int (gfx_ticks_ms)
            splitHost.draw()
            splitHost.flushGpuParticles()
            def r1:int (gfx_ticks_ms)
            if (splitHost.isAutoscale()) {
                gfx_present_split (splitHost.leftRaw()) (splitHost.rightRaw()) pw ph
            } {
                gfx_present (splitHost.raw()) pw ph
            }
            def r2:int (gfx_ticks_ms)
            if (profileEnabled) {
                profRenderMs = (profRenderMs + (r1 - r0))
                profPresentMs = (profPresentMs + (r2 - r1))
            }
            return
        }
        def s0:int (gfx_ticks_ms)
        runner.draw()
        runner.flushGpuParticles()
        def s1:int (gfx_ticks_ms)
        gfx_present (runner.raw()) pw ph
        def s2:int (gfx_ticks_ms)
        if (profileEnabled) {
            profRenderMs = (profRenderMs + (s1 - s0))
            profPresentMs = (profPresentMs + (s2 - s1))
        }
    }

    ; Both panes press START on the same frame → switch to shared dual-player mode.
    fn dualModeToggleEdge:boolean () {
        gfx_input_poll
        def left:GameInputSnapshot (new GameInputSnapshot)
        left.buildForPane(0)
        def right:GameInputSnapshot (new GameInputSnapshot)
        right.buildForPane(1)
        if (left.p0.start) {
            if (right.p0.start) {
                return true
            }
        }
        return false
    }

    fn quitEdge:boolean (quitHeld:boolean) {
        if (quitHeld) {
            if (prevQuitHeld == false) {
                prevQuitHeld = true
                return true
            }
        } {
            prevQuitHeld = false
        }
        return false
    }

    ; Menu navigation: one step per key press (not while held).
    fn upEdge:boolean (held:boolean) {
        if (held) {
            if (prevUpHeld == false) {
                prevUpHeld = true
                return true
            }
        } {
            prevUpHeld = false
        }
        return false
    }

    fn downEdge:boolean (held:boolean) {
        if (held) {
            if (prevDownHeld == false) {
                prevDownHeld = true
                return true
            }
        } {
            prevDownHeld = false
        }
        return false
    }

    fn actionEdge:boolean (held:boolean) {
        if (held) {
            if (prevActionHeld == false) {
                prevActionHeld = true
                return true
            }
        } {
            prevActionHeld = false
        }
        return false
    }

    ; Menu navigation: keyboard P1 (WASD/arrows) + gamepad 0 merged.
    fn launcherNavMask:int () {
        def kb:int (gfx_input_source_mask(0))
        def pad:int (gfx_input_source_mask(2))
        return (bit_or kb pad)
    }

    ; Return to launcher menu: Q/Esc, or gamepad Select / B.
    fn gameMenuBackHeld:boolean () {
        def kb:int (gfx_input_source_mask(0))
        if ((bit_and kb 8) != 0) {
            return true
        }
        def pad:int (gfx_input_source_mask(2))
        if ((bit_and pad 1024) != 0) {
            return true
        }
        if ((bit_and pad 64) != 0) {
            return true
        }
        return false
    }

    fn runMenuLoop:void () {
        this.loadMenuGame()
        while (running) {
            def now:int (gfx_ticks_ms)
            def dtMs:int defaultDtMs
            if (lastFrameStart > 0) {
                dtMs = (now - lastFrameStart)
                if (dtMs < minDtMs) {
                    dtMs = minDtMs
                }
                if (dtMs > maxDtMs) {
                    dtMs = maxDtMs
                }
            }
            lastFrameStart = now

            def up:boolean false
            def down:boolean false
            def left:boolean false
            def right:boolean false
            def action:boolean false
            def quitHeld:boolean false
            def m:int (this.launcherNavMask())
            if ((bit_and m 1) != 0) {
                up = true
            }
            if ((bit_and m 2) != 0) {
                down = true
            }
            if ((bit_and m 16) != 0) {
                left = true
            }
            if ((bit_and m 32) != 0) {
                right = true
            }
            if ((bit_and m 4) != 0) {
                action = true
            }
            def kb:int (gfx_input_source_mask(0))
            if ((bit_and kb 8) != 0) {
                quitHeld = true
            }

            def quitPulse:boolean (this.quitEdge(quitHeld))
            def upPulse:boolean (this.upEdge(up))
            def downPulse:boolean (this.downEdge(down))
            def actionPulse:boolean (this.actionEdge(action))
            runner.frame(dtMs upPulse downPulse false false actionPulse quitPulse)
            this.draw()
            this.maybePollCatalog()

            def launchPath:string (runner.stateString("launchPath" ""))
            if ((strlen launchPath) > 0) {
                this.loadGame(launchPath)
                this.runGameLoop()
                if (running == false) {
                    return
                }
                this.loadMenuGame()
            }

            def quitApp:int (runner.stateInt("quitApp" 0))
            if (quitApp != 0) {
                running = false
            }
            if (quitPulse) {
                running = false
            }

            if (gfx_should_close) {
                running = false
            }
            frames = (frames + 1)
            if (maxFrames > 0) {
                if (frames >= maxFrames) {
                    running = false
                }
            }
        }
    }

    fn runGameLoop:void () {
        while (running) {
            if (splitScreenActive) {
                splitHost.maybeHotReload()
            } {
                runner.maybeHotReload()
            }
            def now:int (gfx_ticks_ms)
            def dtMs:int defaultDtMs
            if (lastFrameStart > 0) {
                dtMs = (now - lastFrameStart)
                if (dtMs < minDtMs) {
                    dtMs = minDtMs
                }
                if (dtMs > maxDtMs) {
                    dtMs = maxDtMs
                }
            }
            lastFrameStart = now

            def up:boolean false
            def down:boolean false
            def left:boolean false
            def right:boolean false
            def action:boolean false
            def quitHeld:boolean (this.gameMenuBackHeld())

            if (this.quitEdge(quitHeld)) {
                this.clearNavStack()
                nativeBridge.clearPendingNav()
                inGame = false
                splitScreenActive = false
                dualPlayerMode = false
                gfx_clear_should_close
                return
            }

            def tUpdateStart:int (gfx_ticks_ms)
            if (splitScreenActive) {
                if (this.dualModeToggleEdge()) {
                    print "[split-screen] switching to dual-player mode"
                    dualPlayerMode = true
                    splitScreenActive = false
                    this.loadScriptAt(currentGamePath false)
                    this.syncInputEdges()
                } {
                    splitHost.frameWithInput(dtMs)
                }
            } {
                def gameInput:GameInputSnapshot (this.pollGameInput())
                runner.frameWithInput(dtMs gameInput)
                this.drainScriptNavigation()
            }
            def tUpdateEnd:int (gfx_ticks_ms)

            if (false == inGame) {
                gfx_clear_should_close
                return
            }
            this.updateFps()
            def tDrawStart:int (gfx_ticks_ms)
            this.draw()
            def tDrawEnd:int (gfx_ticks_ms)
            if (profileEnabled) {
                profUpdateMs = (profUpdateMs + (tUpdateEnd - tUpdateStart))
                profDrawMs = (profDrawMs + (tDrawEnd - tDrawStart))
                profFrames = (profFrames + 1)
            }
            frames = (frames + 1)
            if (gfx_should_close) {
                running = false
            }
            if (maxFrames > 0) {
                if (frames >= maxFrames) {
                    running = false
                }
            }
        }
    }

    fn run:void () {
        def title:string "Ranger Game (SDL2)"
        if (gpuModeWanted) {
            def okGpu:int (gfx_open_gpu title pw ph)
            if (okGpu != 0) {
                gpuModeActive = true
                print "[game-engine] OpenGL present (default)"
            } {
                print "[game-engine] gfx_open_gpu failed — falling back to software present"
                gpuModeActive = false
            }
        }
        if (false == gpuModeActive) {
            def ok:int (gfx_open title pw ph)
            if (ok == 0) {
                print "gfx_open failed (no display?) - still rendering into the RGBA buffer"
            } {
                print "[game-engine] SDL software present (--software)"
            }
        }
        if (startFullscreen) {
            gfx_set_fullscreen(1)
        }
        gfx_audio_open(44100)
        if (launcherMode) {
            this.runMenuLoop()
        } {
            this.runGameLoop()
        }
        gfx_close
    }

    fn isTsxPath:boolean (arg:string) {
        def len:int (strlen arg)
        if (len < 4) {
            return false
        }
        def tail:string (substring arg (len - 4) len)
        if (tail == ".tsx") {
            return true
        }
        return false
    }

    fn startsWith:boolean (s:string prefix:string) {
        def plen:int (strlen prefix)
        if ((strlen s) < plen) {
            return false
        }
        def head:string (substring s 0 plen)
        return (head == prefix)
    }

    fn parseArgs:void () {
        def tsxPath:string ""
        def i:int 0
        def pendingGamesDir:boolean false
        while (i < (shell_arg_cnt)) {
            def arg:string (shell_arg i)
            if (pendingGamesDir) {
                gamesDir = arg
                launcherMode = true
                pendingGamesDir = false
            } {
                if (arg == "--profile") {
                    profileEnabled = true
                } {
                if (arg == "--hot-reload") {
                    hotReloadExplicit = true
                    hotReloadWanted = true
                } {
                    if (arg == "--no-hot-reload") {
                        hotReloadExplicit = true
                        hotReloadWanted = false
                    } {
                        if (arg == "--software") {
                            gpuModeWanted = false
                        } {
                            if (arg == "--no-gpu") {
                                gpuModeWanted = false
                            } {
                                if (arg == "--gpu") {
                                    gpuModeWanted = true
                                } {
                                    if (arg == "--fullscreen") {
                                        startFullscreen = true
                                    } {
                                        if (arg == "--windowed") {
                                            startFullscreen = false
                                        } {
                                            if (arg == "--games-dir") {
                                                pendingGamesDir = true
                                                launcherMode = true
                                            } {
                                                if (this.startsWith(arg "--games-dir=")) {
                                                    def plen:int (strlen "--games-dir=")
                                                    gamesDir = (substring arg plen (strlen arg))
                                                    launcherMode = true
                                                } {
                                                    if (this.isTsxPath(arg)) {
                                                        tsxPath = arg
                                                    } {
                                                        if ((strlen tsxPath) > 0) {
                                                            def parsed@(optional):int (to_int arg)
                                                            if (!null? parsed) {
                                                                maxFrames = (unwrap parsed)
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                }
            }
            i = (i + 1)
        }
        if ((strlen tsxPath) > 0) {
            launcherMode = false
            this.loadGame(tsxPath)
            this.setProfileOnRunners()
            return
        }
        launcherMode = true
        this.setProfileOnRunners()
    }

    sfn m@(main):void () {
        def be:GameSdlRunner (new GameSdlRunner)
        be.parseArgs()
        be.run()
        if (be.profileEnabled) {
            if (be.profFrames > 0) {
                def pmsg:string ("[profile] frames=" + be.profFrames)
                pmsg = (pmsg + " | update(all)=" + be.profUpdateMs + "ms")
                pmsg = (pmsg + " | draw(all)=" + be.profDrawMs + "ms")
                pmsg = (pmsg + " | render(no present)=" + be.profRenderMs + "ms")
                pmsg = (pmsg + " | present(SDL)=" + be.profPresentMs + "ms")
                pmsg = (pmsg + " | update/frame=" + (idiv be.profUpdateMs be.profFrames) + "ms")
                pmsg = (pmsg + " | draw/frame=" + (idiv be.profDrawMs be.profFrames) + "ms")
                pmsg = (pmsg + " | render/frame=" + (idiv be.profRenderMs be.profFrames) + "ms")
                pmsg = (pmsg + " | present/frame=" + (idiv be.profPresentMs be.profFrames) + "ms")
                print pmsg
            }
            if (be.splitScreenActive) {
                if (be.splitHost.profFrames > 0) {
                    def sf:int be.splitHost.profFrames
                    def splitLine:string ("[profile:split] leftDraw=" + be.splitHost.profLeftDrawMs + "ms")
                    splitLine = (splitLine + " rightDraw=" + be.splitHost.profRightDrawMs + "ms")
                    splitLine = (splitLine + " blit=" + be.splitHost.profBlitMs + "ms")
                    splitLine = (splitLine + " | leftDraw/frame=" + (idiv be.splitHost.profLeftDrawMs sf) + "ms")
                    splitLine = (splitLine + " | rightDraw/frame=" + (idiv be.splitHost.profRightDrawMs sf) + "ms")
                    splitLine = (splitLine + " | blit/frame=" + (idiv be.splitHost.profBlitMs sf) + "ms")
                    if (be.splitAutoscale) {
                        splitLine = (splitLine + " autoscale=on")
                    } {
                        splitLine = (splitLine + " autoscale=off")
                    }
                    print splitLine
                }
                be.printRunnerProfile("left" be.splitHost.left)
                be.printRunnerProfile("right" be.splitHost.right)
            } {
                be.printRunnerProfile("game" be.runner)
            }
        }
        if (be.inGame) {
            def msg:string ("game-sdl done: frames=" + be.frames)
            msg = (msg + " | entities=" + (be.runner.entityCount()))
            msg = (msg + " | score ")
            msg = (msg + be.runner.score1)
            msg = (msg + " - ")
            msg = (msg + be.runner.score2)
            if (be.fpsShown > 0) {
                msg = (msg + " | fps=")
                msg = (msg + (to_string be.fpsShown))
            }
            print msg
        }
    }
}

; ==============================================================================
; wasm_physics_runner — WASM linear ABI + host GamePhysics (autopeli Path C).
; ==============================================================================

Import "../framebuffer.rgr"
Import "../wasm_runtime.rgr"
Import "./wasm_abi_io.rgr"
Import "./game_physics.rgr"
Import "./game_audio.rgr"
Import "./wasm_autopeli_setup.rgr"
Import "./wasm_autopeli_render.rgr"
Import "../../ts_to_ranger/game_host.rgr"

class WasmPhysicsRunner {
    def handle:int 0
    def linearMode:boolean false
    def abi:WasmAbiMem (new WasmAbiMem)
    def setup:WasmAutopeliSetup (new WasmAutopeliSetup)
    def render:WasmAutopeliRender (new WasmAutopeliRender)
    def physics:GamePhysics (new GamePhysics)
    def bodyIds:[string]
    def drawEntities:[WasmVisualEntity]
    def canvas:SoftCanvas (new SoftCanvas)
    def host:GameHost (new GameHost)
    def audio:GameAudio (new GameAudio)
    def assetsDir:string "gallery/game_engine/games/autopeli_wasm"
    def pw:int 480
    def ph:int 270
    def worldH:int 6000
    def cameraY:int 0
    def cameraSmoothY:double 0.0
    def camViewY:int 0
    def fixedStepMs:int 16
    def timeMs:int 0
    def fpsShown:int 0
    def score:int 0
    def hits:int 0
    def profileEnabled:boolean false

    fn init:void (w:int h:int) {
        audio.init()
        pw = w
        ph = h
        canvas.init(w h)
        host.audio = audio
        host.wireMusic()
    }

    fn setFpsShown:void (fps:int) { fpsShown = fps }
    fn setProfileEnabled:void (on:boolean) { profileEnabled = on }
    fn raw:buffer () { return (canvas.raw()) }
    fn hostRef:GameHost () { return host }
    fn maybeHotReload:void () {}
    fn resolvePlayerCount:int () { return 1 }

    fn loadModule:void (path:string) {
        if (handle != 0) {
            wasm_close handle
            handle = 0
        }
        handle = wasm_load path
        if (handle == 0) {
            print ("[wasm] load failed: " + path)
            return
        }
        linearMode = false
        abi.bind(handle)
        if (abi.base != 0) {
            linearMode = true
        }
        print ("[wasm] loaded: " + path + " linear=" + (to_string linearMode))
    }

    fn findBody:PhysBody (id:string) {
        def fail:PhysBody (new PhysBody)
        def i 0
        while (i < (array_length physics.core.bodies)) {
            def b:PhysBody (itemAt physics.core.bodies i)
            if (b.id == id) {
                return b
            }
            i = (i + 1)
        }
        return fail
    }

    fn syncBodiesToAbi:void () {
        if (linearMode == false) {
            return
        }
        def i 0
        while (i < (array_length bodyIds)) {
            def id:string (itemAt bodyIds i)
            def b:PhysBody (this.findBody(id))
            if ((strlen b.id) > 0) {
                def xFp:int (to_int (b.x * 256.0))
                def yFp:int (to_int (b.y * 256.0))
                def ang:int (to_int (b.angle * 1000.0))
                def spd:int (to_int (b.speed * 256.0))
                def av:int (to_int (b.angularVel * 256.0))
                abi.writeBody(i xFp yFp ang spd av 1)
            }
            i = (i + 1)
        }
    }

    fn applyControlsFromAbi:void () {
        clear physics.commands
        def i 0
        while (i < (array_length bodyIds)) {
            def id:string (itemAt bodyIds i)
            def cmd:PhysCommand (new PhysCommand)
            cmd.bodyId = id
            cmd.steer = ((to_double (abi.readControlSteer(i))) / 1000.0)
            cmd.throttle = ((to_double (abi.readControlThrottle(i))) / 1000.0)
            cmd.brake = ((to_double (abi.readControlBrake(i))) / 1000.0)
            cmd.grip = ((to_double (abi.readControlGrip(i))) / 1000.0)
            def ic 0
            while (ic < (abi.getImpulseCount())) {
                if ((abi.readImpulseBody(ic)) == i) {
                    cmd.impulseX = (cmd.impulseX + ((to_double (abi.readImpulseLinX(ic))) / 256.0))
                    cmd.impulseY = (cmd.impulseY + ((to_double (abi.readImpulseLinY(ic))) / 256.0))
                    cmd.impulseAngular = (cmd.impulseAngular + ((to_double (abi.readImpulseAng(ic))) / 256.0))
                }
                ic = (ic + 1)
            }
            push physics.commands cmd
            i = (i + 1)
        }
    }

    fn spriteFor:string (id:string) {
        if (id == "p1") {
            return "p1"
        }
        if (id == "p2") {
            return "p2"
        }
        if ((indexOf id "t") == 0) {
            return "trafficCar"
        }
        if ((indexOf id "c") == 0) {
            return "cone"
        }
        if ((indexOf id "b") == 0) {
            return "bar"
        }
        if ((indexOf id "oil") == 0) {
            return "oil"
        }
        return "rect"
    }

    fn findDrawEntity:WasmVisualEntity (id:string) {
        def fail:WasmVisualEntity (new WasmVisualEntity)
        def i 0
        while (i < (array_length drawEntities)) {
            def e:WasmVisualEntity (itemAt drawEntities i)
            if (e.id == id) {
                return e
            }
            i = (i + 1)
        }
        return fail
    }

    fn initAssets:void () {
        render.initAssets(assetsDir pw worldH)
        render.initSprites()
        render.buildStaticBg(setup)
    }

    fn buildDrawEntities:void () {
        def next:[WasmVisualEntity]
        def i 0
        while (i < (array_length physics.core.bodies)) {
            def b:PhysBody (itemAt physics.core.bodies i)
            if ((strlen b.id) > 0) {
                def sp:string (this.spriteFor(b.id))
                def ge:WasmVisualEntity (render.spawnVisual(b.id sp (to_int b.x) (to_int b.y)))
                push next ge
            }
            i = (i + 1)
        }
        def oi 0
        while (oi < (array_length setup.oilIds)) {
            def oid:string (itemAt setup.oilIds oi)
            def ox:int (itemAt setup.oilXs oi)
            def oy:int (itemAt setup.oilYs oi)
            def oilE:WasmVisualEntity (render.spawnVisual(oid "oil" ox oy))
            push next oilE
            oi = (oi + 1)
        }
        drawEntities = next
    }

    fn setupScene:void () {
        if (handle == 0) {
            return
        }
        def empty:[string]
        bodyIds = empty
        wasm_call_void handle "init" 0 0 0 0 0 0
        if (abi.verifyMagic()) {
            linearMode = true
        }
        setup.setupPhysics(physics bodyIds)
        this.initAssets()
        this.buildDrawEntities()
        cameraSmoothY = 5860.0
        camViewY = 5640
        this.syncBodiesToAbi()
    }

    fn syncDrawFromPhysics:void () {
        def target:double 5860.0
        def p1:PhysBody (this.findBody("p1"))
        if ((strlen p1.id) > 0) {
            target = (p1.y - 90.0)
        }
        cameraY = abi.getCameraY()
        if (cameraY != 0) {
            target = ((to_double cameraY) / 256.0)
        }
        def blend:double 0.12
        cameraSmoothY = (cameraSmoothY + ((target - cameraSmoothY) * blend))
        camViewY = (to_int cameraSmoothY)
        if (camViewY < 0) {
            camViewY = 0
        }
        def maxCam:int (worldH - ph)
        if (maxCam < 0) {
            maxCam = 0
        }
        if (camViewY > maxCam) {
            camViewY = maxCam
        }
        def i 0
        while (i < (array_length physics.core.bodies)) {
            def b:PhysBody (itemAt physics.core.bodies i)
            def e:WasmVisualEntity (this.findDrawEntity(b.id))
            if ((strlen e.id) > 0) {
                render.syncEntityPose(e (to_int b.x) (to_int b.y) b.angle camViewY pw ph)
            }
            i = (i + 1)
        }
        def oi 0
        while (oi < (array_length setup.oilIds)) {
            def oid:string (itemAt setup.oilIds oi)
            def e:WasmVisualEntity (this.findDrawEntity(oid))
            if ((strlen e.id) > 0) {
                def ox:int (itemAt setup.oilXs oi)
                def oy:int (itemAt setup.oilYs oi)
                render.syncEntityPose(e ox oy 0.0 camViewY pw ph)
            }
            oi = (oi + 1)
        }
        score = abi.getScore()
        hits = abi.getHits()
    }

    fn physicsStep:void (dtMs:int flags:int) {
        this.syncBodiesToAbi()
        abi.setDtMs(dtMs)
        abi.setTimeMs(timeMs)
        abi.setInputFlags(flags)
        wasm_call_void handle "update" 0 0 0 0 0 0
        this.applyControlsFromAbi()
        physics.step(dtMs)
        this.syncDrawFromPhysics()
    }

    fn frame:void (dtMs:int up:boolean down:boolean left:boolean right:boolean action:boolean) {
        if (handle == 0) {
            return
        }
        timeMs = (timeMs + dtMs)
        def flags:int 0
        if (up) { flags = (flags + 1) }
        if (down) { flags = (flags + 2) }
        if (left) { flags = (flags + 4) }
        if (right) { flags = (flags + 8) }
        if (action) { flags = (flags + 16) }
        if (fixedStepMs > 0) {
            def steps:int (idiv dtMs fixedStepMs)
            if (steps < 1) {
                steps = 1
            }
            def s 0
            while (s < steps) {
                this.physicsStep(fixedStepMs flags)
                s = (s + 1)
            }
        } {
            this.physicsStep(dtMs flags)
        }
    }

    fn frameWithInput:void (dtMs:int up:boolean down:boolean left:boolean right:boolean action:boolean) {
        this.frame(dtMs up down left right action)
    }

    fn entityY:int (id:string) {
        def b:PhysBody (this.findBody(id))
        if ((strlen b.id) > 0) {
            return (to_int b.y)
        }
        def i 0
        while (i < (array_length drawEntities)) {
            def e:WasmVisualEntity (itemAt drawEntities i)
            if (e.id == id) {
                return (e.y + camViewY)
            }
            i = (i + 1)
        }
        return -1
    }

    fn draw:void () {
        render.drawBackground(canvas camViewY ph)
        render.drawEntities(drawEntities canvas)
        this.drawHud()
    }

    fn drawHud:void () {
        def x:int 8
        def y:int 8
        canvas.fillRect(x y 120 14 20 30 45)
        def p1:PhysBody (this.findBody("p1"))
        if ((strlen p1.id) > 0) {
            def spd:int (to_int p1.speed)
            def prog:int (idiv ((6000 - (to_int p1.y)) * 100) 6000)
            def spdBar:int (idiv spd 4)
            def progBar:int (idiv prog 2)
            canvas.fillRect((x + 2) (y + 2) spdBar 4 120 220 160)
            canvas.fillRect((x + 2) (y + 8) progBar 4 240 220 80)
        }
        canvas.fillRect((x + 90) y 24 14 40 60 90)
    }

    fn drawLoadingScreen:void (label:string ticks:int) {
        canvas.clear(8 12 24)
    }

    fn shutdown:void () {
        if (handle != 0) {
            wasm_close handle
            handle = 0
        }
    }
}

; ==============================================================================
; invaders_native_runner - headless Space Invaders (static-compiled script path).
; ==============================================================================
;
; Game logic is the STATICALLY COMPILED emitter output from invaders.game.tsx.
; Regenerate with:
;   node gallery/ts_to_ranger/bin/ts_emitter_main.js \
;     -i gallery/game_engine/scripting/invaders.game.tsx \
;     -o invaders_generated.rgr
; ==============================================================================

Import "./game_native_runtime.rgr"
Import "../../ts_to_ranger/generated/invaders_generated.rgr"

class InvadersNativeRunner {
    def runner:NativeGameRunner (new NativeGameRunner)
    def script:GeneratedGameScript (new GeneratedGameScript)

    fn setupScene:void () {
        def init:NativeGameState (script.initState())
        def defs:[SpriteDefNative] (script.sprites())
        runner.setupScene(init defs)
    }

    fn frame:void (dtMs:int up:boolean down:boolean left:boolean right:boolean action:boolean) {
        runner.advanceTime(dtMs)
        def props:UpdatePropsNative (runner.buildProps(dtMs up down left right action))
        def patch:NativeGameState (script.update(props))
        runner.applyUpdate(patch)
    }

    fn draw:void () {
        runner.draw()
    }

    fn entityX:int (id:string) {
        return (runner.entityX(id))
    }

    fn entityY:int (id:string) {
        return (runner.entityY(id))
    }

    fn entityCount:int () {
        return (runner.entityCount())
    }

    fn raw:buffer () {
        return (runner.raw())
    }
}

class InvadersNativeRunnerDemo {
    sfn m@(main):void () {
        def demo:InvadersNativeRunner (new InvadersNativeRunner)
        demo.runner.init(480 270)
        demo.setupScene()

        def frames:int 600
        if ((shell_arg_cnt) > 0) {
            def parsed@(optional):int (to_int (shell_arg 0))
            if (!null? parsed) {
                frames = (unwrap parsed)
            }
        }

        def i 0
        while (i < frames) {
            def phase (i % 160)
            def up (phase < 50)
            def down (phase >= 110)
            demo.frame(16 up down false false false)
            i = (i + 1)
        }

        demo.draw()
        buffer_write_file "gallery/game_engine/scripting" "invaders_native_frame.rgba" (demo.raw())

        def sx:int (demo.entityX("ship"))
        def sy:int (demo.entityY("ship"))
        def ec:int (demo.entityCount())
        print ("frames=" + frames)
        print (("ship=" + sx) + ("," + sy))
        print (("entities=" + ec))
        print (("score=" + demo.runner.score1) + ("," + demo.runner.score2))
        print "invaders-native-runner done"
    }
}

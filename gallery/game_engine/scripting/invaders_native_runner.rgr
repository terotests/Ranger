; ==============================================================================
; invaders_native_runner - headless Space Invaders (static-compiled script path).
; ==============================================================================
;
; Game logic is the STATICALLY COMPILED emitter output from invaders.game.tsx.
; Regenerate with:
;   npm run ts2ranger:emit -- gallery/game_engine/scripting/invaders.game.tsx
;
; For SDL window use: npm run engine:game-sdl-native:run:invaders
; ==============================================================================

Import "./invaders_native_game.rgr"

class InvadersNativeRunnerDemo {
    sfn m@(main):void () {
        print "invaders-native-runner: headless (no SDL window)"
        print "For SDL + native compiled logic: npm run engine:game-sdl-native:run:invaders"
        print "For SDL + TS interpreter: npm run engine:game-sdl:run:invaders"
        print "Writes gallery/game_engine/scripting/invaders_native_frame.rgba after run"
        def demo:InvadersNativeGame (new InvadersNativeGame)
        demo.runner.init(480 270)
        demo.setupScene()

        def frames:int 600
        if ((shell_arg_cnt) > 0) {
            def parsed@(optional):int (to_int (shell_arg 0))
            if (!null? parsed) {
                frames = (unwrap parsed)
            }
        }

        def i 0
        while (i < frames) {
            def phase (i % 160)
            def up (phase < 50)
            def down (phase >= 110)
            demo.frame(16 up down false false false)
            i = (i + 1)
        }

        demo.draw()
        buffer_write_file "gallery/game_engine/scripting" "invaders_native_frame.rgba" (demo.raw())

        def sx:int (demo.entityX("ship"))
        def sy:int (demo.entityY("ship"))
        def ec:int (demo.entityCount())
        print ("frames=" + frames)
        print (("ship=" + sx) + ("," + sy))
        print (("entities=" + ec))
        print (("score=" + demo.runner.score1) + ("," + demo.runner.score2))
        print "invaders-native-runner done"
    }
}

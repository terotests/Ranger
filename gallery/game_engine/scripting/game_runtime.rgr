; ==============================================================================
; GameRunner - a retained-mode runner for script-driven games.
; ==============================================================================
;
; Bridges a TypeScript game script (evaluated by ComponentEngine) to the RGBA
; SoftCanvas. Supports two modes:
;
;   * Single-screen (legacy): sprites() once, state.entities each frame.
;   * Multi-screen: named screens like HTML pages. Each screen has its own
;     retained sprites (lazy-loaded on first visit) and sub-state in
;     state.screens[name]. Switching screen freezes the old one in memory.
;
;   * update() returns the next state; state.screen selects the active page.
;   * hud() / render JSX is composited on top (game_hud.rgr).
; ==============================================================================

Import "../framebuffer.rgr"
Import "../../pdf_writer/src/jsx/ComponentEngine.rgr"
Import "../../pdf_writer/src/jsx/EvalValue.rgr"
Import "../../evg/EVGElement.rgr"
Import "./game_sprite.rgr"
Import "./game_hud.rgr"
Import "../../ts_to_ranger/game_host.rgr"
Import "./game_audio.rgr"
Import "./game_image_loader.rgr"
Import "./game_input.rgr"
Import "./game_fixed_step.rgr"
Import "./game_composite_bridge.rgr"
Import "./game_static_bg_bridge.rgr"
Import "./game_particles.rgr"
Import "./game_camera.rgr"
Import "./game_world_grid.rgr"
Import "./game_entity_store.rgr"
Import "./game_physics.rgr"
Import "./game_cannon_physics.rgr"

; Runtime options for script-driven games (SDL host, tests, custom hosts).
class GameRuntimeOptions {
    ; Poll script file mtime each frame and AST-patch on change (TS interpreter path only).
    def hotReload:boolean false
    def scriptPath:string ""
    def scriptDir:string ""
    def scriptFile:string ""
    def scriptMtime:int 0
    ; Hybrid GPU path: CPU SoftCanvas for primitives/HUD, GL textured quads for
    ; bitmap sprites (when implemented). OpenGL present is the default in game_sdl.
    def gpuMode:boolean false
    ; When true and gpuMode is on, particles are GL-overlaid at present (not SoftCanvas).
    def particlesGpuOverlay:boolean true
    ; When true and gpuMode is on, sheet sprites are GL-overlaid at present (not SoftCanvas).
    def spritesGpuOverlay:boolean true
}

class GameRunner {
    def engine:ComponentEngine (new ComponentEngine())
    def options:GameRuntimeOptions (new GameRuntimeOptions())
    ; Shared TSX helpers (game_helpers) resolve from this path at import time.
    def engineLibPath:string "gallery/game_engine/lib"
    def canvas:SoftCanvas (new SoftCanvas)
    def hudBlitter:GameHudBlitter (new GameHudBlitter)
    def spriteRenderer:GameSpriteRenderer (new GameSpriteRenderer)
    def host:GameHost (new GameHost)
    def audio:GameAudio (new GameAudio)
    def entities:[GameEntity]
    def screenSpritesLoaded:[string]
    def state:EvalValue (EvalValue.null())
    def pw:int 0
    def ph:int 0
    def score1:int 0
    def score2:int 0
    def fpsShown:int 0
    def timeMs:int 0
    def hudEnabled:boolean false
    def profileEnabled:boolean false
    def profUpdateScriptMs:int 0
    def profUpdateSyncMs:int 0
    def profDrawBgMs:int 0
    def profDrawSpritesMs:int 0
    def profDrawHudMs:int 0
    def profFrames:int 0
    def currentScreen:string ""
    def imageLoader:GameImageLoader (new GameImageLoader)
    def backgroundImg:ImageBuffer (new ImageBuffer)
    def backgroundLoaded:boolean false
    def backgroundKey:string ""
    def staticBgCanvas:SoftCanvas (new SoftCanvas)
    def staticBgReady:boolean false
    def staticBgH:int 0
    def staticBgBridge:GameStaticBgNativeBridge (new GameStaticBgNativeBridge)
    def compositeBridge:CompositeEvalNativeBridge (new CompositeEvalNativeBridge)
    def hostBridge@(optional):EvalNativeBridge
    def particles:GameParticleSystem (new GameParticleSystem)
    def camera:GameCamera (new GameCamera)
    def entityStore:GameEntityStore (new GameEntityStore)
    def worldGrid:WorldGrid (new WorldGrid)
    def physics:GamePhysics (new GamePhysics)
    def cannonPhysics:GameCannonPhysics (new GameCannonPhysics)
    def useCannonPhysics:boolean false
    def cannonGravY:double 0.0
    def cannonRestitution:double 0.75
    def fixedStepMs:int 0
    def timeAccumulator:int 0
    ; Max fixed-update steps per rendered frame (spiral-of-death guard).
    def maxFixedSteps:int 3
    def worldHeight:int 0
    def physicsPassive:boolean false
    def physicsSharedWorld:boolean false
    def lastStepDtMs:int 16

    fn init:void (w:int h:int) {
        engine.quiet = true
        audio.init()
        pw = w
        ph = h
        canvas.init(w h)
        particles.init(96)
        this.initSessionGlobal()
    }

    fn initSessionGlobal:void () {
        def keys:[string]
        def vals:[EvalValue]
        push keys "musicId"
        push vals (EvalValue.string(""))
        engine.registerGlobal("session" (EvalValue.object(keys vals)))
    }

    fn half:int (n:int) {
        def result 0
        def rem n
        while (rem >= 2) {
            rem = (rem - 2)
            result = (result + 1)
        }
        return result
    }

    fn registerGlobal:void (name:string value:EvalValue) {
        engine.registerGlobal(name value)
    }

    fn setPaneIndex:void (index:int) {
        engine.registerGlobal("paneIndex" (EvalValue.fromInt(index)))
    }

    fn clearPaneIndex:void () {
        engine.removeGlobal("paneIndex")
    }

    fn inactivePeerCar:EvalValue () {
        def k:[string]
        def v:[EvalValue]
        push k "active"
        push v (EvalValue.fromInt(0))
        return (EvalValue.object(k v))
    }

    ; Default globals for non-split games (paneIndex=-1, inactive peerCar).
    fn registerDefaultPaneGlobals:void () {
        this.setPaneIndex(-1)
        this.setPeerCar((this.inactivePeerCar()))
    }

    ; Split-screen pane setup: inject paneIndex (0=left, 1=right) and empty peerCar.
    fn registerSplitPane:void (paneIndex:int) {
        this.setPaneIndex(paneIndex)
        this.setPeerCar((this.inactivePeerCar()))
        options.particlesGpuOverlay = false
        this.applyCamera()
    }

    ; Opposite pane's local car (state.p1) for ghost rendering in split-screen races.
    fn exportPeerCar:EvalValue () {
        def p1:EvalValue (state.getMember("p1"))
        if (false == (p1.isObject())) {
            return (this.inactivePeerCar())
        }
        def k:[string]
        def v:[EvalValue]
        push k "active"
        push v (EvalValue.fromInt(1))
        push k "x"
        push v (p1.getMember("x"))
        push k "y"
        push v (p1.getMember("y"))
        push k "steer"
        push v (p1.getMember("steer"))
        push k "finishTick"
        push v (p1.getMember("finishTick"))
        return (EvalValue.object(k v))
    }

    fn setPeerCar:void (peer:EvalValue) {
        engine.registerGlobal("peerCar" peer)
    }

    fn setNativeBridge:void (bridge:EvalNativeBridge) {
        hostBridge = bridge
        compositeBridge.clearBridges()
        compositeBridge.addBridge(staticBgBridge)
        if (hostBridge) {
            compositeBridge.addBridge((unwrap hostBridge))
        }
        engine.setNativeBridge(compositeBridge)
    }

    fn loadScript:void (src:string) {
        engine.loadScript(src)
        hudEnabled = (this.scriptHasFunction("hud"))
    }

    ; Directory of the loaded .game.tsx on disk — required for relative imports.
    fn setScriptDir:void (dir:string) {
        options.scriptDir = dir
        engine.setBasePath(dir)
        imageLoader.setBaseDir(dir)
        host.musicDir = dir
        spriteRenderer.setImageLoader(imageLoader)
        engine.addAssetPath(engineLibPath)
    }

    fn setHotReload:void (enabled:boolean) {
        options.hotReload = enabled
    }

    fn setGpuMode:void (enabled:boolean) {
        options.gpuMode = enabled
        spriteRenderer.setGpuSheetOverlay(false)
    }

    fn setGpuPane:void (pane:int) {
        spriteRenderer.setGpuPane(pane)
        particles.setGpuPane(pane)
    }

    fn enableGpuSheetOverlay:void () {
        if (options.gpuMode) {
            if (options.spritesGpuOverlay) {
                if (spriteRenderer.hasSheetCache()) {
                    spriteRenderer.setGpuSheetOverlay(true)
                }
            }
        }
    }

  ; Track a .tsx/.game.tsx on disk for mtime polling (used by SDL host and dev watch).
    fn trackScriptFile:void (path:string) {
        options.scriptPath = path
        def dir:string ""
        def file:string path
        def slash:int (lastIndexOf path "/")
        if (slash >= 0) {
            dir = (substring path 0 slash)
            file = (substring path (slash + 1) (strlen path))
        }
        options.scriptDir = dir
        options.scriptFile = file
        if ((strlen dir) > 0) {
            engine.setBasePath(dir)
            imageLoader.setBaseDir(dir)
            host.musicDir = dir
            spriteRenderer.setImageLoader(imageLoader)
            engine.addAssetPath(engineLibPath)
        }
        if ((strlen file) > 0) {
            options.scriptMtime = (file_mtime dir file)
        }
    }

    fn maybeHotReload:void () {
        if (options.hotReload == false) {
            return
        }
        if ((strlen options.scriptFile) == 0) {
            return
        }
        def mtime:int (file_mtime options.scriptDir options.scriptFile)
        if (mtime <= options.scriptMtime) {
            return
        }
        options.scriptMtime = mtime
        def buf:buffer (buffer_read_file options.scriptDir options.scriptFile)
        def src:string (buffer_to_string buf)
        def sceneReset:boolean (this.hotReloadScript(src))
        if (sceneReset) {
            print ("[hot-reload] scene reset: " + options.scriptPath)
        } {
            print ("[hot-reload] patched in-process: " + options.scriptPath)
        }
    }

    fn resetScene:void () {
        def emptyEnt:[GameEntity]
        entities = emptyEnt
        def emptyScreens:[string]
        screenSpritesLoaded = emptyScreens
        host = (new GameHost)
        host.audio = audio
        currentScreen = ""
        state = (EvalValue.null())
        camera = (new GameCamera)
        entityStore = (new GameEntityStore)
        worldGrid = (new WorldGrid)
        physics = (new GamePhysics)
        cannonPhysics = (new GameCannonPhysics)
        useCannonPhysics = false
        fixedStepMs = 0
        timeAccumulator = 0
        worldHeight = 0
        physicsPassive = false
        physicsSharedWorld = false
        this.clearBackground()
        this.clearStaticBg()
        spriteRenderer.clearSheetCache()
    }

    fn clearStaticBg:void () {
        staticBgReady = false
        staticBgH = 0
        staticBgCanvas = (new SoftCanvas)
    }

    fn clearBackground:void () {
        backgroundLoaded = false
        backgroundKey = ""
        backgroundImg = (new ImageBuffer)
    }

    ; Load (or reuse cached) image by resources() id or relative PNG/JPEG path.
    fn setBackground:void (idOrPath:string) {
        if ((strlen idOrPath) == 0) {
            this.clearBackground()
            return
        }
        if ((strlen options.scriptDir) > 0) {
            imageLoader.setBaseDir(options.scriptDir)
        }
        def img:ImageBuffer (imageLoader.loadByIdOrPath(host idOrPath))
        if (imageLoader.isValidImage(img)) {
            backgroundImg = img
            backgroundLoaded = true
            backgroundKey = idOrPath
        } {
            print ("[GameRunner] background: failed id=" + idOrPath)
            this.clearBackground()
        }
    }

    fn hasBackground:boolean () {
        return backgroundLoaded
    }

    fn backgroundCacheCount:int () {
        return (imageLoader.cacheCount())
    }

    fn applyBackgroundFromScript:void () {
        if (false == (this.scriptHasFunction("backgroundImage"))) {
            return
        }
        def v:EvalValue (engine.callFunction("backgroundImage" (EvalValue.null())))
        if (v.isString()) {
            def id:string v.stringValue
            if ((strlen id) > 0) {
                this.setBackground(id)
            }
        }
    }

    fn syncBackgroundFromState:void () {
        def active:EvalValue (this.activeState())
        def bg:string (this.memString(active "background" ""))
        if ((strlen bg) == 0) {
            return
        }
        if (bg == backgroundKey) {
            return
        }
        this.setBackground(bg)
    }

    fn drawBackground:void () {
        if (staticBgReady) {
            def cam:int (this.memInt(state "cameraY" 0))
            if (cam < 0) {
                cam = 0
            }
            def maxCam:int (staticBgH - ph)
            if (maxCam < 0) {
                maxCam = 0
            }
            if (cam > maxCam) {
                cam = maxCam
            }
            canvas.copyRectFrom(staticBgCanvas 0 cam pw ph 0 0)
            return
        }
        if (backgroundLoaded) {
            imageLoader.blitCover(canvas backgroundImg)
        } {
            canvas.clear(12 16 32)
        }
    }

    ; Optional init hook: createStaticBg() draws once into a tall off-screen buffer.
    ; staticLevelHeight() alone enables a scrollable buffer; when backgroundImage() is
    ; set, the image is scaled into that buffer first (procedural overlays optional).
    fn applyCreateStaticBg:void () {
        def hasCreate:boolean (this.scriptHasFunction("createStaticBg"))
        def hasTall:boolean (this.scriptHasFunction("staticLevelHeight"))
        if ((false == hasCreate) && (false == hasTall)) {
            return
        }
        def levelH:int ph
        if (hasTall) {
            def hv:EvalValue (engine.callFunction("staticLevelHeight" (EvalValue.null())))
            if (hv.isNumber()) {
                levelH = (to_int hv.numberValue)
            }
        }
        if (levelH < ph) {
            levelH = ph
        }
        staticBgCanvas.init(pw levelH)
        staticBgH = levelH
        staticBgBridge.setCanvas(staticBgCanvas)
        engine.registerGlobal("bgWidth" (EvalValue.fromInt(pw)))
        engine.registerGlobal("bgHeight" (EvalValue.fromInt(levelH)))
        if (backgroundLoaded) {
            staticBgCanvas.blitImageRectScaled(
                backgroundImg 0 0 backgroundImg.width backgroundImg.height
                0 0 pw levelH
            )
        }
        if (hasCreate) {
            engine.callFunction("createStaticBg" (EvalValue.null()))
        }
        staticBgReady = true
    }

    ; In-process hot reload: AST diff + swap changed bindings. Rebuilds scene only
    ; when initState/sprites/resources/consts changed; update/hud-only edits keep state.
    fn hotReloadScript:boolean (src:string) {
        def sceneReset:boolean (engine.patchScript(src))
        hudEnabled = (this.scriptHasFunction("hud"))
        if (sceneReset) {
            spriteRenderer.setGpuSheetOverlay(false)
            this.resetScene()
            this.setupScene()
            this.enableGpuSheetOverlay()
        }
        return sceneReset
    }

    fn scriptHasFunction:boolean (name:string) {
        def fnValue:EvalValue (engine.getGlobal(name))
        return (fnValue.isFunction())
    }

    fn raw:buffer () {
        return (canvas.raw())
    }

    fn flushGpuParticles:void () {
        if (options.gpuMode) {
            if (options.particlesGpuOverlay) {
                particles.flushGpu(pw ph)
            }
        }
    }

    fn getCurrentScreen:string () {
        return currentScreen
    }

    ; --- entity lookup (for tests / host queries) ---
    fn entityX:int (id:string) {
        def i 0
        while (i < (array_length entities)) {
            def e:GameEntity (itemAt entities i)
            if (e.id == id) {
                return e.x
            }
            i = (i + 1)
        }
        return -1
    }
    fn entityY:int (id:string) {
        def i 0
        while (i < (array_length entities)) {
            def e:GameEntity (itemAt entities i)
            if (e.id == id) {
                return e.y
            }
            i = (i + 1)
        }
        return -1
    }

    fn entityCount:int () {
        return (array_length entities)
    }

    fn setFpsShown:void (fps:int) {
        fpsShown = fps
    }

    fn setProfileEnabled:void (on:boolean) {
        profileEnabled = on
    }

    ; True when initState/update use { screen, screens: { ... } }.
    fn multiScreenMode:boolean () {
        def screens:EvalValue (state.getMember("screens"))
        return (screens.isObject())
    }

    fn memString:string (obj:EvalValue key:string dflt:string) {
        def v:EvalValue (obj.getMember(key))
        if (v.isNull()) {
            return dflt
        }
        if (v.isString()) {
            return v.stringValue
        }
        return dflt
    }

    fn currentScreenName:string () {
        if (false == (this.multiScreenMode())) {
            return ""
        }
        return (this.memString(state "screen" ""))
    }

    ; Sub-state for the active screen, or root state in legacy mode.
    fn activeState:EvalValue () {
        if (false == (this.multiScreenMode())) {
            return state
        }
        def name:string (this.currentScreenName())
        def screens:EvalValue (state.getMember("screens"))
        def sub:EvalValue (screens.getMember(name))
        if (sub.isNull()) {
            return state
        }
        return sub
    }

    fn screenHasSprites:boolean (name:string) {
        def i 0
        while (i < (array_length screenSpritesLoaded)) {
            if ((itemAt screenSpritesLoaded i) == name) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; Lazy-load retained sprites for a named screen (first visit only).
    fn loadScreenSprites:void (name:string) {
        if (this.screenHasSprites(name)) {
            return
        }
        def k:[string]
        def v:[EvalValue]
        push k "screen"
        push v (EvalValue.string(name))
        def props:EvalValue (EvalValue.object(k v))
        def sprites:EvalValue (engine.callFunction("sprites" props))
        if (sprites.isArray()) {
            def arr:[EvalValue] sprites.arrayValue
            def i 0
            while (i < (array_length arr)) {
                def d:EvalValue (itemAt arr i)
                def e:GameEntity (new GameEntity)
                spriteRenderer.applyDef(e d)
                e.screen = name
                push entities e
                i = (i + 1)
            }
        }
        push screenSpritesLoaded name
    }

    fn onScreenChanged:void (prev:string next:string) {
        currentScreen = next
        this.loadScreenSprites(next)
    }

    fn hostRef:GameHost () {
        return host
    }

    fn audioRef:GameAudio () {
        return audio
    }

    fn wireHostAudio:void () {
        host.audio = audio
        host.wireMusic()
    }

    fn memDouble:double (obj:EvalValue key:string dflt:double) {
        def v:EvalValue (obj.getMember(key))
        if (v.isNull()) {
            return dflt
        }
        return v.numberValue
    }

    fn resourceFromEval:ResourceDefNative (d:EvalValue) {
        def r:ResourceDefNative (new ResourceDefNative)
        r.kind = (this.memString(d "kind" ""))
        r.id = (this.memString(d "id" ""))
        r.path = (this.memString(d "path" ""))
        r.px = (this.memInt(d "px" 0))
        r.frameCount = (this.memInt(d "frameCount" 0))
        r.w = (this.memInt(d "w" 0))
        r.h = (this.memInt(d "h" 0))
        return r
    }

    ; Declare engine resources (images/sounds/sprites/collision) once, if the
    ; script exposes a resources() function. Same contract as the native path.
    fn setupResources:void () {
        if (false == (this.scriptHasFunction("resources"))) {
            return
        }
        def res:EvalValue (engine.callFunction("resources" (EvalValue.null())))
        if (res.isArray()) {
            def arr:[EvalValue] res.arrayValue
            def i 0
            while (i < (array_length arr)) {
                host.registerResource((this.resourceFromEval((itemAt arr i))))
                i = (i + 1)
            }
        }
    }

    fn eventFromEval:GameEventNative (d:EvalValue) {
        def e:GameEventNative (new GameEventNative)
        e.kind = (this.memString(d "kind" ""))
        e.id = (this.memString(d "id" ""))
        e.x = (this.memDouble(d "x" 0.0))
        e.y = (this.memDouble(d "y" 0.0))
        e.amount = (this.memInt(d "amount" 0))
        e.text = (this.memString(d "text" ""))
        e.pad = (this.memInt(d "pad" -1))
        e.low = (this.memInt(d "low" 24000))
        e.high = (this.memInt(d "high" 24000))
        e.ms = (this.memInt(d "ms" 0))
        if (e.ms <= 0) {
            e.ms = (this.memInt(d "amount" 120))
        }
        return e
    }

    ; Optional config() — physics.fixedStep enables fixed-timestep simulation.
    fn applyConfig:void () {
        if (false == (this.scriptHasFunction("config"))) {
            return
        }
        def cfg:EvalValue (engine.callFunction("config" (EvalValue.null())))
        if (false == (cfg.isObject())) {
            return
        }
        def phys:EvalValue (cfg.getMember("physics"))
        if (phys.isObject()) {
            def cannonFlag:EvalValue (phys.getMember("cannon"))
            if (cannonFlag.isBoolean()) {
                if (cannonFlag.boolValue) {
                    useCannonPhysics = true
                    cannonPhysics.enabled = true
                    cannonPhysics.initBridge()
                }
            }
            def gravY:double (this.memDouble(phys "gravityY" 0.0))
            cannonGravY = gravY
            def rest:double (this.memDouble(phys "restitution" 0.75))
            cannonRestitution = rest
            cannonPhysics.setGravityY(gravY)
            cannonPhysics.defaultRestitution = rest
            cannonPhysics.wallRestitution = rest
            if (useCannonPhysics == false) {
                def step:double (this.memDouble(phys "fixedStep" 0.0))
                if (step > 0.0) {
                    fixedStepMs = (to_int step)
                }
                def enabled:EvalValue (phys.getMember("enabled"))
                if (enabled.isBoolean()) {
                    if (enabled.boolValue) {
                        physics.enabled = true
                    }
                } {
                    if ((to_int (this.memDouble(phys "enabled" 0.0))) != 0) {
                        physics.enabled = true
                    }
                }
                def shared:EvalValue (phys.getMember("sharedWorld"))
                if (shared.isBoolean()) {
                    if (shared.boolValue) {
                        physics.enabled = true
                        physicsSharedWorld = true
                    }
                } {
                    if ((to_int (this.memDouble(phys "sharedWorld" 0.0))) != 0) {
                        physics.enabled = true
                        physicsSharedWorld = true
                    }
                }
            } {
                def step2:double (this.memDouble(phys "fixedStep" 0.0))
                if (step2 > 0.0) {
                    fixedStepMs = (to_int step2)
                }
            }
        }
        def world:EvalValue (cfg.getMember("world"))
        if (world.isObject()) {
            def wh:int (this.memInt(world "height" 0))
            if (wh > 0) {
                worldHeight = wh
            }
            def ww:int (this.memInt(world "width" 0))
            if (ww > 0) {
                if (useCannonPhysics) {
                    cannonPhysics.setWorldSize((to_double ww) (to_double worldHeight))
                } {
                    physics.setWorldSize((to_double ww) (to_double worldHeight))
                }
            }
            ; S1 streaming grid + culling (PLAN_RANGER2D_STREAMING.md). cull is
            ; opt-in; without it the grid stays 1x1 and culling is a no-op.
            def cols:int (this.memInt(world "cols" 1))
            def rows:int (this.memInt(world "rows" 1))
            def cellW:int (this.memInt(world "cellW" 0))
            def cellH:int (this.memInt(world "cellH" 0))
            def margin:int (this.memInt(world "cullMargin" 0))
            def cullV:EvalValue (world.getMember("cull"))
            def cull:boolean false
            if (cullV.isBoolean()) {
                cull = cullV.boolValue
            } {
                if (false == (cullV.isNull())) {
                    cull = ((to_int cullV.numberValue) != 0)
                }
            }
            worldGrid.configure(cols rows cellW cellH margin cull)
        }
    }

    fn applyCannonPhysics:void () {
        if (useCannonPhysics == false) {
            return
        }
        cannonPhysics.clear()
        cannonPhysics.enabled = true
        cannonPhysics.setGravityY(cannonGravY)
        cannonPhysics.defaultRestitution = cannonRestitution
        cannonPhysics.wallRestitution = cannonRestitution
        cannonPhysics.world.defaultContactMaterial.restitution = cannonRestitution
        def wh:double (to_double ph)
        if (worldHeight > 0) {
            wh = (to_double worldHeight)
        }
        cannonPhysics.setWorldSize((to_double pw) wh)
        if (this.scriptHasFunction("entities")) {
            def spawn:EvalValue (engine.callFunction("entities" (EvalValue.null())))
            cannonPhysics.loadFromEntities(spawn)
        }
        if (this.scriptHasFunction("physicsBounds")) {
            def bounds:EvalValue (engine.callFunction("physicsBounds" (EvalValue.null())))
            cannonPhysics.loadBounds(bounds)
        } {
            cannonPhysics.addDefaultWorldBounds()
        }
        entityStore.worldMode = true
    }

    fn applyPhysics:void () {
        if (useCannonPhysics) {
            this.applyCannonPhysics()
            return
        }
        physics.clear()
        if (physics.enabled == false) {
            if (false == (this.scriptHasFunction("config"))) {
                return
            }
            def cfg:EvalValue (engine.callFunction("config" (EvalValue.null())))
            def phys:EvalValue (cfg.getMember("physics"))
            if (phys.isObject()) {
                def enabled:EvalValue (phys.getMember("enabled"))
                if (enabled.isBoolean()) {
                    physics.enabled = enabled.boolValue
                }
            }
        }
        if (physics.enabled == false) {
            return
        }
        if (worldHeight > 0) {
            physics.setWorldSize((to_double pw) (to_double worldHeight))
        }
        if (this.scriptHasFunction("physicsBodies")) {
            def bodies:EvalValue (engine.callFunction("physicsBodies" (EvalValue.null())))
            physics.loadBodies(bodies)
        } {
            if (this.scriptHasFunction("entities")) {
                def spawn:EvalValue (engine.callFunction("entities" (EvalValue.null())))
                physics.loadBodies(spawn)
            }
        }
        if (this.scriptHasFunction("physicsBounds")) {
            def bounds:EvalValue (engine.callFunction("physicsBounds" (EvalValue.null())))
            physics.loadBounds(bounds)
        } {
            physics.addDefaultWorldBounds()
        }
        entityStore.worldMode = true
    }

    fn usesSharedPhysics:boolean () {
        if (physicsSharedWorld == false) {
            return false
        }
        if (useCannonPhysics) {
            return false
        }
        return physics.enabled
    }

    fn appendPhysicsImpulses:void (dstPhy:EvalValue srcPhy:EvalValue) {
        def srcImps:EvalValue (srcPhy.getMember("impulses"))
        if (false == (srcImps.isArray())) {
            return
        }
        def srcArr:[EvalValue] srcImps.arrayValue
        if ((array_length srcArr) == 0) {
            return
        }
        def dstImps:EvalValue (dstPhy.getMember("impulses"))
        def merged:[EvalValue]
        if (dstImps.isArray()) {
            def dstArr:[EvalValue] dstImps.arrayValue
            def i 0
            while (i < (array_length dstArr)) {
                push merged (itemAt dstArr i)
                i = (i + 1)
            }
        }
        def j 0
        while (j < (array_length srcArr)) {
            push merged (itemAt srcArr j)
            j = (j + 1)
        }
        dstPhy.setMember("impulses" (EvalValue.array(merged)))
    }

    fn mergePhysicsFromPane:void (donor:EvalValue) {
        def dstPhy:EvalValue (state.getMember("physics"))
        def srcPhy:EvalValue (donor.getMember("physics"))
        if (false == (dstPhy.isObject())) {
            return
        }
        if (false == (srcPhy.isObject())) {
            return
        }
        def srcCtrl:EvalValue (srcPhy.getMember("controls"))
        if (srcCtrl.isObject()) {
            def p2:EvalValue (srcCtrl.getMember("p2"))
            if (p2.isObject()) {
                def dstCtrl:EvalValue (dstPhy.getMember("controls"))
                if (dstCtrl.isObject()) {
                    dstCtrl.setMember("p2" p2)
                } {
                    def ck:[string]
                    def cv:[EvalValue]
                    push ck "p2"
                    push cv p2
                    dstPhy.setMember("controls" (EvalValue.object(ck cv)))
                }
            }
        }
        this.appendPhysicsImpulses(dstPhy srcPhy)
        def srcRamp:EvalValue (donor.getMember("rampCd"))
        if (srcRamp.isObject()) {
            def dstRamp:EvalValue (state.getMember("rampCd"))
            if (dstRamp.isObject()) {
                dstRamp.setMember("p2" (srcRamp.getMember("p2")))
            }
        }
        def srcAir:EvalValue (donor.getMember("airTick"))
        if (srcAir.isObject()) {
            def dstAir:EvalValue (state.getMember("airTick"))
            if (dstAir.isObject()) {
                dstAir.setMember("p2" (srcAir.getMember("p2")))
            }
        }
    }

    fn syncSharedWorldFrom:void (src:GameRunner) {
        this.syncSharedPhysics(src.physics)
        def srcState:EvalValue src.state
        state.setMember("worldEntities" (srcState.getMember("worldEntities")))
        state.setMember("physicsContacts" (srcState.getMember("physicsContacts")))
        state.setMember("hits" (srcState.getMember("hits")))
        state.setMember("score" (srcState.getMember("score")))
        state.setMember("someoneWon" (srcState.getMember("someoneWon")))
        state.setMember("airTick" (srcState.getMember("airTick")))
        state.setMember("rampCd" (srcState.getMember("rampCd")))
        this.syncFromState()
        this.syncBackgroundFromState()
    }

    fn setPhysicsPassive:void (passive:boolean) {
        physicsPassive = passive
    }

    fn isPhysicsEnabled:boolean () {
        if (useCannonPhysics) {
            return cannonPhysics.enabled
        }
        return physics.enabled
    }

    fn syncSharedPhysics:void (src:GamePhysics) {
        physics.enabled = src.enabled
        physics.copyBodiesFrom(src)
        physics.setWorldSize(src.worldW src.worldH)
    }

    fn runCannonPhysicsStep:void (dtMs:int) {
        if (useCannonPhysics == false) {
            return
        }
        if (cannonPhysics.enabled == false) {
            return
        }
        def active:EvalValue (this.activeState())
        cannonPhysics.step(dtMs active)
        def world:EvalValue (active.getMember("worldEntities"))
        if (world.isNull()) {
            def emptyK:[string]
            def emptyV:[EvalValue]
            world = (EvalValue.object(emptyK emptyV))
            active.setMember("worldEntities" world)
        }
        cannonPhysics.writeWorldEntities(world)
        cannonPhysics.appendCollisionEvents(active)
    }

    fn runPhysicsStep:void (dtMs:int) {
        if (useCannonPhysics) {
            this.runCannonPhysicsStep(dtMs)
            return
        }
        if (physics.enabled == false) {
            return
        }
        if (physicsPassive) {
            return
        }
        physics.readCommandsFromState(state)
        physics.step(dtMs)
        def active:EvalValue (this.activeState())
        def world:EvalValue (active.getMember("worldEntities"))
        if (world.isNull()) {
            def emptyK:[string]
            def emptyV:[EvalValue]
            world = (EvalValue.object(emptyK emptyV))
            active.setMember("worldEntities" world)
        }
        physics.writeWorldEntities(world)
        physics.writeContactsToState(active)
    }

    fn physicsRef:GamePhysics () {
        return physics
    }

    fn applyCamera:void () {
        camera.disable()
        if (false == (this.scriptHasFunction("camera"))) {
            return
        }
        def cfg:EvalValue (engine.callFunction("camera" (EvalValue.null())))
        if (cfg.isObject()) {
            camera.loadFromEval(cfg)
        }
    }

    fn resolveWorldHeight:int () {
        if (worldHeight > 0) {
            return worldHeight
        }
        if (staticBgH > 0) {
            return staticBgH
        }
        return ph
    }

    fn clearStateEvents:void (st:EvalValue) {
        def cleared:[EvalValue]
        st.setMember("events" (EvalValue.array(cleared)))
    }

    ; Split-screen shared physics: peer pane runs update() first; merge its events
    ; into the authority pane before drainStateEvents() so audio/haptics are not lost.
    fn mergeEventsFromPeer:void (peer:EvalValue) {
        def peerEvs:EvalValue (peer.getMember("events"))
        if (false == (peerEvs.isArray())) {
            return
        }
        def peerArr:[EvalValue] peerEvs.arrayValue
        if ((array_length peerArr) == 0) {
            return
        }
        def dstEvs:EvalValue (state.getMember("events"))
        def merged:[EvalValue]
        if (dstEvs.isArray()) {
            def dstArr:[EvalValue] dstEvs.arrayValue
            def i 0
            while (i < (array_length dstArr)) {
                push merged (itemAt dstArr i)
                i = (i + 1)
            }
        }
        def j 0
        while (j < (array_length peerArr)) {
            push merged (itemAt peerArr j)
            j = (j + 1)
        }
        state.setMember("events" (EvalValue.array(merged)))
        this.clearStateEvents(peer)
    }

    ; Drain transient events emitted by update() this frame into the host.
    fn drainStateEvents:void () {
        def evs:EvalValue (state.getMember("events"))
        if (evs.isArray()) {
            def arr:[EvalValue] evs.arrayValue
            def cam:double (this.memDouble((this.activeState()) "cameraY" 0.0))
            def i 0
            while (i < (array_length arr)) {
                def ev:EvalValue (itemAt arr i)
                def kind:string (this.memString(ev "kind" ""))
                if (kind == "particles") {
                    def pid:string (this.memString(ev "id" "burst"))
                    def px:double (this.memDouble(ev "x" 0.0))
                    def py:double (this.memDouble(ev "y" 0.0))
                    py = (py - cam)
                    def amt:int (this.memInt(ev "amount" 0))
                    particles.spawnPreset(pid px py amt)
                }
                host.handleEvent((this.eventFromEval(ev)))
                i = (i + 1)
            }
            if ((array_length arr) > 0) {
                def cleared:[EvalValue]
                state.setMember("events" (EvalValue.array(cleared)))
            }
        }
    }

    ; Build retained entities from sprites() and init state.
    fn setupScene:void () {
        this.wireHostAudio()
        this.setupResources()
        this.applyConfig()
        this.applyBackgroundFromScript()
        this.applyCreateStaticBg()
        this.applyCamera()
        this.applyPhysics()
        state = (engine.callFunction("initState" (EvalValue.null())))
        def hasEntitiesFn:boolean (this.scriptHasFunction("entities"))
        if (hasEntitiesFn) {
            def spawn:EvalValue (engine.callFunction("entities" (EvalValue.null())))
            entityStore.activateFromScript(spawn)
            entityStore.seedWorldEntities(state spawn)
        }
        this.syncBackgroundFromState()
        if (this.multiScreenMode()) {
            currentScreen = (this.currentScreenName())
            this.loadScreenSprites(currentScreen)
        } {
            def sprites:EvalValue (engine.callFunction("sprites" (EvalValue.null())))
            if (hasEntitiesFn) {
                def spawn:EvalValue (engine.callFunction("entities" (EvalValue.null())))
                entities = (entityStore.spawnRetained(spawn sprites spriteRenderer))
            } {
                if (sprites.isArray()) {
                    def arr:[EvalValue] sprites.arrayValue
                    def i 0
                    while (i < (array_length arr)) {
                        def d:EvalValue (itemAt arr i)
                        def e:GameEntity (new GameEntity)
                        spriteRenderer.applyDef(e d)
                        push entities e
                        i = (i + 1)
                    }
                }
            }
        }
        this.syncFromState()
    }

    fn memInt:int (obj:EvalValue key:string dflt:int) {
        def v:EvalValue (obj.getMember(key))
        if (v.isNull()) {
            return dflt
        }
        return (to_int v.numberValue)
    }

    fn syncFromState:void () {
        def active:EvalValue (this.activeState())
        if (entityStore.worldMode) {
            def world:EvalValue (active.getMember("worldEntities"))
            if (world.isNull()) {
                world = (active.getMember("entities"))
            }
            if (camera.enabled == false) {
                camera.readLegacyFromState(state)
            } {
                def wh:int (this.resolveWorldHeight())
                camera.update(world pw ph wh lastStepDtMs)
                camera.writeToState(state)
            }
            def camX:int camera.camX
            def camY:int camera.camY
            def cur:string (this.currentScreenName())
            def i 0
            while (i < (array_length entities)) {
                def e:GameEntity (itemAt entities i)
                if (this.multiScreenMode()) {
                    if (e.screen != cur) {
                        i = (i + 1)
                        continue
                    }
                }
                entityStore.syncEntity(e world camX camY pw ph worldGrid spriteRenderer)
                i = (i + 1)
            }
        } {
            def ent:EvalValue (active.getMember("entities"))
            def cur:string (this.currentScreenName())
            def i 0
            while (i < (array_length entities)) {
                def e:GameEntity (itemAt entities i)
                if (this.multiScreenMode()) {
                    if (e.screen != cur) {
                        i = (i + 1)
                        continue
                    }
                }
                def pos:EvalValue (ent.getMember(e.id))
                if (false == (pos.isNull())) {
                    spriteRenderer.syncPose(e pos pw ph)
                }
                i = (i + 1)
            }
        }
        score1 = (this.memInt(active "score1" (this.memInt(state "score1" score1))))
        score2 = (this.memInt(active "score2" (this.memInt(state "score2" score2))))
    }

    fn stateString:string (key:string dflt:string) {
        return (this.memString(state key dflt))
    }

    fn stateInt:int (key:string dflt:int) {
        return (this.memInt(state key dflt))
    }

    fn resolvePlayerCount:int () {
        def n:int (this.memInt(state "playerSlots" 0))
        if (n <= 0) {
            n = (this.memInt(state "playerCount" 0))
        }
        if (n <= 0) {
            if (this.multiScreenMode()) {
                def active:EvalValue (this.activeState())
                n = (this.memInt(active "playerSlots" 0))
                if (n <= 0) {
                    n = (this.memInt(active "playerCount" 0))
                }
            }
        }
        if (n <= 0) {
            if (this.scriptHasFunction("playerCount")) {
                def k:[string]
                def v:[EvalValue]
                push k "state"
                push v state
                def props:EvalValue (EvalValue.object(k v))
                def rv:EvalValue (engine.callFunction("playerCount" props))
                if (rv.isNumber()) {
                    n = (to_int rv.numberValue)
                }
            }
        }
        if (n < 1) {
            return 1
        }
        if (n > 8) {
            return 8
        }
        return n
    }

    fn frame:void (dtMs:int up:boolean down:boolean left:boolean right:boolean action:boolean quit:boolean) {
        def snap:GameInputSnapshot (GameInputSnapshot.forPlayer0(up down left right action quit))
        this.frameWithInput(dtMs snap)
    }

    fn stepUpdateScript:void (dtMs:int snap:GameInputSnapshot) {
        timeMs = (timeMs + dtMs)
        def k:[string]
        def v:[EvalValue]
        push k "time"
        push v (EvalValue.fromInt(timeMs))
        push k "dt"
        push v (EvalValue.fromInt(dtMs))
        push k "up"
        push v (EvalValue.boolean(snap.p0.up))
        push k "down"
        push v (EvalValue.boolean(snap.p0.down))
        push k "left"
        push v (EvalValue.boolean(snap.p0.left))
        push k "right"
        push v (EvalValue.boolean(snap.p0.right))
        push k "action"
        push v (EvalValue.boolean(snap.p0.action))
        push k "quit"
        push v (EvalValue.boolean(snap.p0.quit))
        push k "input"
        push v (snap.toEval())
        push k "state"
        push v state
        push k "collisionEvents"
        push v (state.getMember("collisionEvents"))
        def props:EvalValue (EvalValue.object(k v))
        state = (engine.callFunction("update" props))
    }

    fn stepPostPhysics:void (dtMs:int prevScreen:string) {
        if (dtMs < 1) {
            lastStepDtMs = 1
        } {
            lastStepDtMs = dtMs
        }
        def nextScreen:string (this.currentScreenName())
        if (nextScreen != prevScreen) {
            this.onScreenChanged(prevScreen nextScreen)
        }
        this.drainStateEvents()
        host.tickMusic(dtMs)
        particles.update(dtMs)
        this.syncFromState()
        this.syncBackgroundFromState()
    }

    fn stepUpdate:void (dtMs:int snap:GameInputSnapshot) {
        def prevScreen:string (this.currentScreenName())
        def tScript0:int 0
        if (profileEnabled) {
            tScript0 = (gfx_ticks_ms)
        }
        this.stepUpdateScript(dtMs snap)
        def tScript1:int 0
        if (profileEnabled) {
            tScript1 = (gfx_ticks_ms)
        }
        this.runPhysicsStep(dtMs)
        this.stepPostPhysics(dtMs prevScreen)
        if (profileEnabled) {
            def tSync1:int (gfx_ticks_ms)
            profUpdateScriptMs = (profUpdateScriptMs + (tScript1 - tScript0))
            profUpdateSyncMs = (profUpdateSyncMs + (tSync1 - tScript1))
            profFrames = (profFrames + 1)
        }
    }

    fn sharedPhysicsStep:void (dtMs:int snap:GameInputSnapshot peer:GameRunner) {
        def prevScreen:string (this.currentScreenName())
        def tScript0:int 0
        if (profileEnabled) {
            tScript0 = (gfx_ticks_ms)
        }
        this.stepUpdateScript(dtMs snap)
        def tScript1:int 0
        if (profileEnabled) {
            tScript1 = (gfx_ticks_ms)
        }
        this.mergePhysicsFromPane(peer.state)
        this.mergeEventsFromPeer(peer.state)
        this.setPhysicsPassive(false)
        this.runPhysicsStep(dtMs)
        this.setPhysicsPassive(true)
        this.stepPostPhysics(dtMs prevScreen)
        if (profileEnabled) {
            def tSync1:int (gfx_ticks_ms)
            profUpdateScriptMs = (profUpdateScriptMs + (tScript1 - tScript0))
            profUpdateSyncMs = (profUpdateSyncMs + (tSync1 - tScript1))
            profFrames = (profFrames + 1)
        }
    }

    fn frameWithInput:void (dtMs:int snap:GameInputSnapshot) {
        if (fixedStepMs > 0) {
            ; Pure planner (game_fixed_step.rgr, IDEAL_TODO R.1): runs at most
            ; maxFixedSteps steps and leaves the accumulator in [0, fixedStepMs) —
            ; never one extra step, never a negative accumulator. The former inline
            ; loop zeroed the accumulator on the cap but still ran + subtracted,
            ; giving maxFixedSteps+1 steps and a negative residual.
            def plan:FixedStepPlan (FixedStep.plan(timeAccumulator dtMs fixedStepMs maxFixedSteps))
            def i:int 0
            while (i < plan.steps) {
                this.stepUpdate(fixedStepMs snap)
                i = (i + 1)
            }
            timeAccumulator = plan.residualMs
            if (plan.steps == 0) {
                this.syncFromState()
            }
            return
        }
        this.stepUpdate(dtMs snap)
    }

    fn draw:void () {
        def tBg0:int 0
        if (profileEnabled) {
            tBg0 = (gfx_ticks_ms)
        }
        spriteRenderer.beginGpuSpriteFrame(pw ph options.gpuMode)
        this.drawBackground()
        def tBg1:int 0
        if (profileEnabled) {
            tBg1 = (gfx_ticks_ms)
        }
        def active:EvalValue (this.activeState())
        def layout:EvalValue (active.getMember("layout"))
        def showNet (this.memInt(active "showNet" 0))
        if (layout.stringValue == "pong") {
            showNet = 1
        }
        if (showNet != 0) {
            def ny 0
            def netX (this.half(pw))
            while (ny < ph) {
                canvas.fillRect((netX - 1) ny 2 6 40 55 95)
                ny = (ny + 12)
            }
        }
        def cur:string (this.currentScreenName())
        def i 0
        while (i < (array_length entities)) {
            def e:GameEntity (itemAt entities i)
            if (this.multiScreenMode()) {
                if (e.screen != cur) {
                    i = (i + 1)
                    continue
                }
            }
            if (e.visible) {
                spriteRenderer.drawEntity(e canvas)
            }
            i = (i + 1)
        }
        if (options.gpuMode) {
            if (false == options.particlesGpuOverlay) {
                particles.draw(canvas)
            }
        } {
            particles.draw(canvas)
        }
        def tSpr1:int 0
        if (profileEnabled) {
            tSpr1 = (gfx_ticks_ms)
        }
        if (false == hudEnabled) {
            def netX (this.half(pw))
            if (layout.stringValue == "invaders") {
                this.drawNumber(16 10 4 score1 120 220 160)
                this.drawNumber((pw - 40) 10 4 score2 255 180 80)
            } {
                this.drawNumber((netX - 44) 10 4 score1 120 220 160)
                this.drawNumber((netX + 20) 10 4 score2 220 140 120)
            }
        } {
            this.drawHud()
        }
        if (fpsShown > 0) {
            def fx (this.half(pw))
            def fy (ph - 22)
            this.drawNumber((fx - 14) fy 3 fpsShown 160 170 190)
        }
        if (profileEnabled) {
            def tHud1:int (gfx_ticks_ms)
            profDrawBgMs = (profDrawBgMs + (tBg1 - tBg0))
            profDrawSpritesMs = (profDrawSpritesMs + (tSpr1 - tBg1))
            profDrawHudMs = (profDrawHudMs + (tHud1 - tSpr1))
        }
    }

    fn drawHud:void () {
        def k:[string]
        def v:[EvalValue]
        push k "state"
        push v state
        push k "screen"
        push v (EvalValue.string(currentScreen))
        push k "time"
        push v (EvalValue.fromInt(timeMs))
        push k "dt"
        push v (EvalValue.fromInt(0))
        def props:EvalValue (EvalValue.object(k v))
        def root:EVGElement (engine.callRender("hud" props))
        hudBlitter.attach(canvas)
        hudBlitter.drawTree(root pw ph)
    }

    fn textWidth:int (scale:int text:string) {
        def step ((scale * 3) + scale)
        return ((strlen text) * step)
    }

    ; Default loading splash while a screen's resources are being prepared.
    fn drawLoadingScreen:void (label:string ticks:int) {
        if (backgroundLoaded) {
            imageLoader.blitCover(canvas backgroundImg)
        } {
            canvas.clear(14 18 36)
        }
        hudBlitter.attach(canvas)
        def line:string label
        if ((strlen line) == 0) {
            line = "LOADING"
        }
        def tickPhase:int (to_int (ticks / 400))
        def dotCount:int (tickPhase % 4)
        def dots:string ""
        def di 0
        while (di < dotCount) {
            dots = (dots + ".")
            di = (di + 1)
        }
        line = (line + dots)
        def scale 3
        def tw:int (this.textWidth(scale line))
        def th:int ((scale * 5) + scale)
        def tx:int (this.half(pw))
        tx = (tx - (this.half(tw)))
        def ty:int (this.half(ph))
        ty = (ty - (this.half(th)))
        hudBlitter.drawText(tx ty scale line 220 230 255)
    }

    fn digitBits:string (d:int) {
        if (d == 0) { return "111101101101111" }
        if (d == 1) { return "010110010010111" }
        if (d == 2) { return "111001111100111" }
        if (d == 3) { return "111001111001111" }
        if (d == 4) { return "101101111001001" }
        if (d == 5) { return "111100111001111" }
        if (d == 6) { return "111100111101111" }
        if (d == 7) { return "111001010010010" }
        if (d == 8) { return "111101111101111" }
        if (d == 9) { return "111101111001111" }
        return "000000000000000"
    }

    fn drawDigit:void (x:int y:int scale:int d:int r:int g:int b:int) {
        def bits:string (this.digitBits(d))
        def row 0
        while (row < 5) {
            def col 0
            while (col < 3) {
                def idx ((row * 3) + col)
                def ch:string (substring bits idx (idx + 1))
                if (ch == "1") {
                    canvas.fillRect((x + (col * scale)) (y + (row * scale)) scale scale r g b)
                }
                col = (col + 1)
            }
            row = (row + 1)
        }
    }

    fn drawNumber:void (x:int y:int scale:int n:int r:int g:int b:int) {
        def ds:[int]
        def m n
        if (m <= 0) {
            push ds 0
        } {
            while (m > 0) {
                push ds (m % 10)
                m = (to_int (m / 10))
            }
        }
        def cnt (array_length ds)
        def j 0
        def step ((scale * 3) + scale)
        while (j < cnt) {
            def d:int (itemAt ds (cnt - 1 - j))
            this.drawDigit((x + (j * step)) y scale d r g b)
            j = (j + 1)
        }
    }
}

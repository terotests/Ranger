; ==============================================================================
; lpc_compose — layer load + blit into output buffer (draft).
; ==============================================================================

Import "lpc_anim.rgr"
Import "lpc_blit.rgr"
Import "lpc_draw.rgr"
Import "lpc_char_catalog.rgr"
Import "lpc_layer_cache.rgr"
Import "lpc_palette.rgr"
Import "png_decoder.rgr"
Import "../../../pdf_writer/src/jpeg/ImageBuffer.rgr"
Import "../../../pdf_writer/src/raster/RasterBuffer.rgr"

class LpcComposeResult {
    def width:int 0
    def height:int 0
    def buffer:RasterBuffer (new RasterBuffer())
    def ok:boolean false
}

class LpcCompositor {
    def anim:LpcAnim (new LpcAnim())
    def draw:LpcDraw (new LpcDraw())
    def blit:LpcBlit (new LpcBlit())
    def palette:LpcPalette (new LpcPalette())
    def catalog:LpcCharCatalog (new LpcCharCatalog())
    def png:PNGDecoder (new PNGDecoder())
    def spritesheetsRoot:string "spritesheets/"

    ; One draw call for a character layer, tagged with its palette group id.
    fn addCharCall:void (list:[LpcDrawCall] group:string path:string z:int) {
        def call:LpcDrawCall (new LpcDrawCall())
        call.itemId = group
        call.spritePath = path
        call.zPos = z
        call.animY = 0
        push list call
    }

    ; Layer stack for the embedded demo-male-walk pack. The palette profile (set
    ; by composeCharacter) is what turns this single stack into distinct looks.
    fn buildCharCalls:[LpcDrawCall] () {
        def list:[LpcDrawCall]
        this.addCharCall(list "body" "body/bodies/male/walk.png" 10)
        this.addCharCall(list "legs" "legs/pants/male/walk.png" 20)
        this.addCharCall(list "feet" "feet/boots/basic/male/walk.png" 25)
        this.addCharCall(list "head" "head/heads/human/male/walk.png" 100)
        this.addCharCall(list "hair" "hair/natural/adult/walk.png" 120)
        return list
    }

    ; Compose one catalog character's walk strip: apply its recolor profile, then
    ; blit the shared layer stack. Same output shape as composeWalkStrip.
    fn composeCharacter:LpcComposeResult (charId:int) {
        this.catalog.applyProfile(this.palette charId)
        def calls:[LpcDrawCall] (this.buildCharCalls())
        return (this.composeCalls(calls))
    }

    fn composeWalkStrip:LpcComposeResult (bodyType:string) {
        def calls:[LpcDrawCall] (this.draw.buildCalls(bodyType))
        return (this.composeCalls(calls))
    }

    ; Blit a (possibly unsorted) draw-call list into a fresh walk-strip buffer.
    fn composeCalls:LpcComposeResult (calls:[LpcDrawCall]) {
        def result:LpcComposeResult (new LpcComposeResult())
        def w:int (this.anim.walkStripWidth())
        def h:int (this.anim.walkStripHeight())
        result.buffer.create(w h)
        result.width = w
        result.height = h

        this.draw.sortByZPos(calls)

        if ((array_length calls) == 0) {
            print "[lpc_compose] no draw calls"
            return result
        }

        def layerCache:LpcLayerCache (LpcLayerCache.__singleton())
        layerCache.clearIfRootChanged(spritesheetsRoot)

        def i 0
        while (i < (array_length calls)) {
            def call:LpcDrawCall (itemAt calls i)
            def img:ImageBuffer (layerCache.getOrDecode(this.png spritesheetsRoot call.spritePath))
            if ((img.width <= 1) && (img.height <= 1)) {
                print ("[lpc_compose] failed: " + call.spritePath)
            } {
                def tinted:ImageBuffer (this.palette.apply(img call.itemId))
                if (i == 0) {
                    this.blit.blitFirstLayer(result.buffer tinted 0 call.animY)
                } {
                    this.blit.blitImage(result.buffer tinted 0 call.animY)
                }
            }
            i = (i + 1)
        }

        result.ok = true
        return result
    }
}

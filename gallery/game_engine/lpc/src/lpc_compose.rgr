; ==============================================================================
; lpc_compose — layer load + blit into output buffer (draft).
; ==============================================================================

Import "lpc_anim.rgr"
Import "lpc_blit.rgr"
Import "lpc_draw.rgr"
Import "lpc_layer_cache.rgr"
Import "lpc_palette.rgr"
Import "png_decoder.rgr"
Import "../../../pdf_writer/src/jpeg/ImageBuffer.rgr"
Import "../../../pdf_writer/src/raster/RasterBuffer.rgr"

class LpcComposeResult {
    def width:int 0
    def height:int 0
    def buffer:RasterBuffer (new RasterBuffer())
    def ok:boolean false
}

class LpcCompositor {
    def anim:LpcAnim (new LpcAnim())
    def draw:LpcDraw (new LpcDraw())
    def blit:LpcBlit (new LpcBlit())
    def palette:LpcPalette (new LpcPalette())
    def png:PNGDecoder (new PNGDecoder())
    def spritesheetsRoot:string "spritesheets/"

    fn composeWalkStrip:LpcComposeResult (bodyType:string) {
        def result:LpcComposeResult (new LpcComposeResult())
        def w:int (this.anim.walkStripWidth())
        def h:int (this.anim.walkStripHeight())
        result.buffer.create(w h)
        result.width = w
        result.height = h

        def calls:[LpcDrawCall] (this.draw.buildCalls(bodyType))
        this.draw.sortByZPos(calls)

        if ((array_length calls) == 0) {
            print "[lpc_compose] no draw calls"
            return result
        }

        def layerCache:LpcLayerCache (LpcLayerCache.__singleton())
        layerCache.clearIfRootChanged(spritesheetsRoot)

        def i 0
        while (i < (array_length calls)) {
            def call:LpcDrawCall (itemAt calls i)
            def img:ImageBuffer (layerCache.getOrDecode(this.png spritesheetsRoot call.spritePath))
            if ((img.width <= 1) && (img.height <= 1)) {
                print ("[lpc_compose] failed: " + call.spritePath)
            } {
                def tinted:ImageBuffer (this.palette.apply(img call.itemId))
                if (i == 0) {
                    this.blit.blitFirstLayer(result.buffer tinted 0 call.animY)
                } {
                    this.blit.blitImage(result.buffer tinted 0 call.animY)
                }
            }
            i = (i + 1)
        }

        result.ok = true
        return result
    }
}

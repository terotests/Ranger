; ==============================================================================
; PongRenderer - draws Pong state into an RGBA SoftCanvas (no platform I/O).
; ==============================================================================
;
; This is the portable render layer: given the pure game state and a SoftCanvas,
; it paints one frame of pixels. It performs NO windowing / present / input - a
; platform backend (pong_sdl.rgr) owns that. Because it only touches SoftCanvas
; (a plain RGBA byte buffer), it produces bit-identical frames on every target,
; which is exactly what a headless / golden-frame rendering test needs.
; ==============================================================================

Import "./pong_core.rgr"
Import "./framebuffer.rgr"

class PongRenderer {
    def scale:int 12

    ; portable integer halving (target-independent, no float / division)
    fn half:int (n:int) {
        def result 0
        def rem n
        while (rem >= 2) {
            rem = (rem - 2)
            result = (result + 1)
        }
        return result
    }

    fn cell:int (c:int) {
        return (c * scale)
    }

    fn pixelWidth:int (game:Pong) {
        return (game.W * scale)
    }

    fn pixelHeight:int (game:Pong) {
        return (game.H * scale)
    }

    ; Paint one frame of the game into the canvas.
    fn draw:void (game:Pong cv:SoftCanvas) {
        def pw (game.W * scale)
        def ph (game.H * scale)

        ; background
        cv.clear(12 16 32)

        ; top & bottom walls
        cv.fillRect(0 0 pw scale 60 80 140)
        cv.fillRect(0 (ph - scale) pw scale 60 80 140)

        ; center net (dashed)
        def ny 0
        while (ny < game.H) {
            if ((ny % 2) == 0) {
                cv.fillRect((this.cell(game.netX)) (this.cell(ny)) 2 scale 40 55 95)
            }
            ny = (ny + 1)
        }

        ; left paddle (player, green) + right paddle (cpu, red)
        cv.fillRect((this.cell(1)) (this.cell(game.leftY)) scale (this.cell(game.PADDLE_H)) 120 220 160)
        cv.fillRect((this.cell((game.W - 2))) (this.cell(game.rightY)) scale (this.cell(game.PADDLE_H)) 220 140 120)

        ; ball (bright yellow)
        def hs (this.half(scale))
        def bx ((this.cell(game.ballX)) + hs)
        def by ((this.cell(game.ballY)) + hs)
        cv.fillCircle(bx by hs 245 245 130)
    }
}

; ==============================================================================
; streaming_world_sdl — SDL front-end for the streaming world (the whole chain).
; ==============================================================================
;
; Ranger -> C++ -> SDL2. Drives worker.wasm (Rust residency ring) + the spawned
; resource_loader.wasm (AssemblyScript tile generator/free) through
; StreamingWorldRunner, and presents its SoftCanvas via gfx_present — the engine's
; real renderer. Move with WASD / arrow keys; Q/Esc quits.
;
; Usage:
;   ./gallery/game_engine/scripts/build-streaming-world-sdl.sh
;   ./tmp/streaming-world/streaming_world_sdl [frames] [worker.wasm]
; ==============================================================================

Import "./framebuffer.rgr"
Import "./gfx_sdl.rgr"
Import "./wasm_runtime.rgr"
Import "./scripting/streaming_world_runner.rgr"

class StreamingWorldApp {
    def pw:int 640
    def ph:int 384
    def runner:StreamingWorldRunner (new StreamingWorldRunner)
    def frames:int 0
    def hasWindow:boolean false

    fn open:void () {
        def ok (gfx_open "Ranger2D Streaming World (SDL2)" pw ph)
        if (ok == 1) {
            hasWindow = true
        } {
            print "gfx_open failed (no display?) - still rendering into the RGBA buffer"
        }
    }

    fn run:void (workerPath:string maxFrames:int) {
        runner.init(pw ph)
        runner.loadModule(workerPath)
        runner.setupScene()
        this.open()
        def running:boolean true
        while (running) {
            def m1:int (gfx_poll_mask)
            def m2:int (gfx_input_source_mask 1)
            def m:int (bit_or m1 m2)
            def up:boolean ((bit_and m 1) != 0)
            def down:boolean ((bit_and m 2) != 0)
            def left:boolean ((bit_and m 16) != 0)
            def right:boolean ((bit_and m 32) != 0)
            def quit:boolean ((bit_and m 8) != 0)
            runner.frameWithInput(16 up down left right false)
            runner.draw()
            gfx_present (runner.raw()) pw ph
            frames = (frames + 1)
            ; headless smoke runs (frame limit set) dump one RGBA frame so the
            ; streaming can be turned into a PNG without a display.
            if (maxFrames > 0) {
                if (frames == 100) {
                    buffer_write_file "tmp/streaming-world" "frame.rgba" (runner.raw())
                }
            }
            if (quit) { running = false }
            def sc:boolean (gfx_should_close)
            if sc {
                running = false
            }
            if (maxFrames > 0) {
                if (frames >= maxFrames) { running = false }
            }
        }
        if (hasWindow) {
            gfx_close
        }
    }

    sfn m@(main):void () {
        def app (new StreamingWorldApp)
        def maxFrames:int 0
        def workerPath:string "gallery/game_engine/games/streaming_worker/worker.wasm"
        def nargs:int (shell_arg_cnt)
        if (nargs > 0) {
            def parsed@(optional):int (to_int (shell_arg 0))
            if (!null? parsed) {
                maxFrames = (unwrap parsed)
            }
        }
        if (nargs > 1) {
            workerPath = (shell_arg 1)
        }
        app.run(workerPath maxFrames)
        def msg ("streaming-world-sdl done: frames=" + app.frames)
        print msg
    }
}

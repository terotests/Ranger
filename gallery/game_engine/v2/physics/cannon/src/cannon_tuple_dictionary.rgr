; ==============================================================================
; cannon_tuple_dictionary — symmetric pair map (Cannon.js port).
; ==============================================================================

class CannonTupleDictionary {
    def keys:[string]
    def values:[string]
    def count:int 0

    fn makeKey:string (i:int j:int) {
        return ((to_string i) + "-") + (to_string j)
    }

    fn findIndex:int (key:string) {
        def idx 0
        while (idx < this.count) {
            def k:string (itemAt this.keys idx)
            if (k == key) {
                return idx
            }
            idx = (idx + 1)
        }
        return (0 - 1)
    }

    fn get:string (i:int j:int) {
        if (i > j) {
            def tmp:int i
            i = j
            j = tmp
        }
        def key:string (this.makeKey(i j))
        def idx:int (this.findIndex(key))
        if (idx < 0) {
            return ""
        }
        return (itemAt this.values idx)
    }

    fn set:void (i:int j:int value:string) {
        if (i > j) {
            def tmp:int i
            i = j
            j = tmp
        }
        def key:string (this.makeKey(i j))
        def idx:int (this.findIndex(key))
        if (idx < 0) {
            push this.keys key
            push this.values value
            this.count = (this.count + 1)
            return
        }
        set this.values idx value
    }

    fn reset:void () {
        this.count = 0
    }

    fn keyCount:int () {
        return this.count
    }
}

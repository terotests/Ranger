; ==============================================================================
; RgLauncherUi — the rich EVG/UI launcher screen (engine chrome).
; ==============================================================================
; Built on the self-contained v2 UI layer (UILayer + UITextRenderer + SoftCanvas
; + fonts, all under v2). Like v1, the catalog is DISCOVERED, not hardcoded: it
; scans the games directory, reads each game's game.info (name / category / ...),
; and groups the entries into categories. Two pages:
;   page 0  CATEGORIES ("valitse kategoria")  — the distinct game.info categories
;   page 1  GAMES        (the chosen category) — the real games in it
; Renders headlessly into a SoftCanvas whose raw() RGBA the SDL host presents.
;
; Engine chrome, like RgGameHost: NO game logic, no ranger:core. Input is logical
; (moveSelection / activate / back); the SDL host maps physical keys. On
; activating a game the host reads selectedDir()/selectedFile() and hands off
; through the same generic RgGameHost.load the tests use.
; ==============================================================================

Import "../ui/UILayer.rgr"
Import "../framebuffer.rgr"
Import "../evg/EVGColor.rgr"
Import "game_catalog.rgr"

; one launchable game card (dir/file is the game-folder handoff, catIndex groups)
class RgLauncherGame {
    def title:string ""
    def dir:string ""
    def file:string ""
    def catIndex:int 0
    def card:UIBox (new UIBox)
}

class RgLauncherUi {
    def canvas:SoftCanvas (new SoftCanvas)
    def layer:UILayer (new UILayer)
    def w:int 0
    def h:int 0

    def page:int 0        ; 0 = categories, 1 = games
    def selected:int 0    ; index within the CURRENT page
    def activeCat:int 0   ; which category's games page 1 shows

    def catalog:GameCatalog (new GameCatalog)
    def gamesDir:string "gallery/game_engine/v2/games"
    def categoryNames:[string]
    def catCards:[UIBox]
    def games:[RgLauncherGame]
    def sub:UILabel (new UILabel)
    def footer:UILabel (new UILabel)

    ; override the scan root before init() (tests / alternate game trees)
    fn setGamesDir:void (dir:string) { this.gamesDir = dir }

    ; centre `n` cards of width cardW (gap between) in the card row; returns startX
    fn rowStartX:int (n:int cardW:int gap:int) {
        def cx:int (idiv this.w 2)
        def totalW:int ((cardW * n) + (gap * (n - 1)))
        return (cx - (idiv totalW 2))
    }

    fn init:void (width:int height:int) {
        this.w = width
        this.h = height
        this.canvas.init(width height)
        this.layer.attach(this.canvas)
        ; real TTF if present; UITextRenderer falls back to its 3x5 bitmap font.
        this.layer.ctx.tr.addFontDir("gallery/pdf_writer/assets/fonts")

        def cx:int (idiv width 2)

        def title:UILabel (new UILabel)
        title.text = "Ranger"
        title.fontSize = 40.0
        title.setBounds((cx - 90) (idiv height 12) 180 48)
        this.layer.add(title)

        this.sub.text = "valitse kategoria"
        this.sub.fontSize = 16.0
        this.sub.setBounds((cx - 100) (idiv height 5) 200 20)
        this.layer.add(this.sub)

        ; ---- DISCOVER the catalog from the filesystem (v1 model) -------------
        this.catalog.setGamesDir(this.gamesDir)
        this.catalog.scan()
        this.categoryNames = (this.catalog.categories())

        def cardW:int (idiv width 4)
        def cardH:int cardW
        def gap:int 24
        def cardY:int (idiv height 3)
        def nCats:int (array_length this.categoryNames)
        def startX:int (this.rowStartX(nCats cardW gap))
        def ci:int 0
        while (ci < nCats) {
            def cname:string (itemAt this.categoryNames ci)
            def cxi:int (startX + (ci * (cardW + gap)))
            def ccard:UIBox (new UIBox)
            ccard.text = cname
            ccard.fontSize = 20.0
            ccard.setBounds(cxi cardY cardW cardH)
            this.layer.add(ccard)
            push this.catCards ccard

            ; ---- that category's game cards (page 1), hidden -----------------
            def ents:[GameCatalogEntry] (this.catalog.entriesInCategory(cname))
            def ne:int (array_length ents)
            def eCardW:int (idiv width 5)
            def eGap:int 20
            def eStartX:int (this.rowStartX(ne eCardW eGap))
            def ei:int 0
            while (ei < ne) {
                def e:GameCatalogEntry (itemAt ents ei)
                def g:RgLauncherGame (new RgLauncherGame)
                g.title = e.title
                g.dir = e.dir
                g.file = e.entryFile
                g.catIndex = ci
                g.card.text = e.title
                g.card.fontSize = 18.0
                def exj:int (eStartX + (ei * (eCardW + eGap)))
                g.card.setBounds(exj cardY eCardW cardH)
                g.card.visible = false
                this.layer.add(g.card)
                push this.games g
                ei = (ei + 1)
            }
            ci = (ci + 1)
        }

        this.footer.text = "A avaa, nuolet liikkuvat"
        this.footer.fontSize = 13.0
        this.footer.setBounds((cx - 110) (height - (idiv height 10)) 220 16)
        this.layer.add(this.footer)

        this.selected = 0
        this.applyPage()
    }

    ; ---- category / game grouping helpers ------------------------------------
    fn gamesInCatCount:int (catIdx:int) {
        def n:int 0
        def i:int 0
        while (i < (array_length this.games)) {
            def g:RgLauncherGame (itemAt this.games i)
            if (g.catIndex == catIdx) { n = (n + 1) }
            i = (i + 1)
        }
        return n
    }
    ; games[] index of the n-th game in a category (page-1 selection order), or -1
    fn nthGameInCat:int (catIdx:int n:int) {
        def seen:int 0
        def i:int 0
        while (i < (array_length this.games)) {
            def g:RgLauncherGame (itemAt this.games i)
            if (g.catIndex == catIdx) {
                if (seen == n) { return i }
                seen = (seen + 1)
            }
            i = (i + 1)
        }
        return (0 - 1)
    }

    fn pageCount:int () {
        if (this.page == 0) { return (array_length this.categoryNames) }
        return (this.gamesInCatCount(this.activeCat))
    }

    ; show the current page's cards and re-apply the accent highlight
    fn applyPage:void () {
        def nCats:int (array_length this.catCards)
        def i:int 0
        while (i < nCats) {
            def cc:UIBox (itemAt this.catCards i)
            cc.visible = (this.page == 0)
            i = (i + 1)
        }
        def gi:int 0
        while (gi < (array_length this.games)) {
            def g:RgLauncherGame (itemAt this.games gi)
            def show:boolean false
            if (this.page == 1) {
                if (g.catIndex == this.activeCat) { show = true }
            }
            g.card.visible = show
            gi = (gi + 1)
        }
        if (this.page == 0) {
            this.sub.text = "valitse kategoria"
            this.footer.text = "A avaa, nuolet liikkuvat"
        } {
            this.sub.text = (itemAt this.categoryNames this.activeCat)
            this.footer.text = "A pelaa, B takaisin"
        }
        this.highlight()
    }

    ; the selected card takes the (opaque) accent fill; the rest a muted panel.
    fn highlight:void () {
        def accent:EVGColor (EVGColor.rgba(255 190 70 1.0))
        def muted:EVGColor (EVGColor.rgba(40 48 74 0.9))
        if (this.page == 0) {
            def i:int 0
            while (i < (array_length this.catCards)) {
                def cc:UIBox (itemAt this.catCards i)
                if (i == this.selected) { cc.setFill(accent) } { cc.setFill(muted) }
                i = (i + 1)
            }
            return
        }
        def n:int (this.gamesInCatCount(this.activeCat))
        def k:int 0
        while (k < n) {
            def idx:int (this.nthGameInCat(this.activeCat k))
            if (idx >= 0) {
                def g:RgLauncherGame (itemAt this.games idx)
                if (k == this.selected) { g.card.setFill(accent) } { g.card.setFill(muted) }
            }
            k = (k + 1)
        }
    }

    ; ---- logical navigation (host maps physical keys) ------------------------
    fn moveSelection:void (dir:int) {
        def n:int (this.pageCount())
        if (n == 0) { return }
        def s:int (this.selected + dir)
        if (s < 0) { s = 0 }
        if (s >= n) { s = (n - 1) }
        this.selected = s
        this.highlight()
    }

    ; page 0: enter the chosen category (returns 0, nothing to launch).
    ; page 1: returns 1 — the host reads selectedDir()/selectedFile() to hand off.
    fn activate:int () {
        if (this.page == 0) {
            if ((array_length this.categoryNames) == 0) { return 0 }
            this.activeCat = this.selected
            this.page = 1
            this.selected = 0
            this.applyPage()
            return 0
        }
        return 1
    }

    fn back:void () {
        if (this.page == 1) {
            this.page = 0
            this.selected = this.activeCat
            this.applyPage()
        }
    }

    ; ---- queries -------------------------------------------------------------
    fn categoryCount:int () { return (array_length this.categoryNames) }
    fn gameCount:int () { return (array_length this.games) }
    fn currentPage:int () { return this.page }

    ; games[] index of the current page-1 selection, or -1 on the category page
    fn selectedGameIndex:int () {
        if (this.page == 0) { return (0 - 1) }
        return (this.nthGameInCat(this.activeCat this.selected))
    }

    fn selectedLabel:string () {
        if (this.page == 0) {
            if ((array_length this.categoryNames) == 0) { return "" }
            return (itemAt this.categoryNames this.selected)
        }
        def idx:int (this.selectedGameIndex())
        if (idx < 0) { return "" }
        def g:RgLauncherGame (itemAt this.games idx)
        return g.title
    }

    ; the selected category name (page 0) — kept for host/test observation
    fn selectedCategory:string () {
        if ((array_length this.categoryNames) == 0) { return "" }
        if (this.page == 0) { return (itemAt this.categoryNames this.selected) }
        return (itemAt this.categoryNames this.activeCat)
    }

    ; the game-folder handoff target of the selected GAME (page 1); "" on page 0
    fn selectedDir:string () {
        def idx:int (this.selectedGameIndex())
        if (idx < 0) { return "" }
        def g:RgLauncherGame (itemAt this.games idx)
        return g.dir
    }
    fn selectedFile:string () {
        def idx:int (this.selectedGameIndex())
        if (idx < 0) { return "" }
        def g:RgLauncherGame (itemAt this.games idx)
        return g.file
    }

    ; ---- present -------------------------------------------------------------
    fn render:void () {
        this.canvas.clear(16 18 34)   ; night background (v1 launcher)
        this.layer.render()
    }
    fn raw:buffer () { return (this.canvas.raw()) }
}

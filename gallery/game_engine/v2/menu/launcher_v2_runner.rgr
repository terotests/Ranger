; ==============================================================================
; launcher_v2_runner — the launcher menu TSX guest + menu→game handoff.
; ==============================================================================
; Validates the second half of the game system: the launcher runs as a TSX
; guest on the SAME façade/bridge as the games, the user navigates it with
; D-pad action EDGES (wasPressed — cleared by the host at the frame boundary,
; step 8), selecting "Pomppija" reports `games/ylos2` through the launch
; capability, the menu realm is torn down (D-OWN backstop), and the host then
; boots the ylos2 guest in a FRESH realm — the actual menu → game handoff.
; ==============================================================================

Import "../interp/engine/RgRegistryBridge.rgr"
Import "../render/backends/software/RgSoftwareRenderer2D.rgr"
Import "../tests/harness/RgTest.rgr"

class LauncherV2Runner {
    def engine:ComponentEngine (new ComponentEngine())
    def bridge:RgRegistryBridge (RgRegistryBridge.create())

    fn callSlot:double (name:string slot:int) {
        def r:EvalValue (this.engine.callFunction(name (EvalValue.number((to_double slot)))))
        return r.numberValue
    }

    fn step:void () {
        def keys:[string]
        push keys "dtMs"
        def vals:[EvalValue]
        push vals (EvalValue.number(33.333))
        this.engine.callFunction("update" (EvalValue.object(keys vals)))
        this.bridge.frameBoundary(0.033333)
    }

    ; one discrete D-pad press: down → update sees the edge → boundary clears →
    ; release → settle frame
    fn press:void (action:string) {
        this.bridge.input.setAction(0 action true)
        this.step()
        this.bridge.input.setAction(0 action false)
        this.step()
    }

    fn guestHandle:RgHandle (name:string) {
        def id:int (to_int (this.callSlot(name 0)))
        return (this.bridge.resolveGuestId(id))
    }

    sfn m@(main):void () {
        def t:RgTest (RgTest.forSuite("menu/launcher on v2 (TSX guest + handoff)"))
        def r:LauncherV2Runner (new LauncherV2Runner)
        r.engine.quiet = true
        r.engine.setNativeBridge(r.bridge)

        def facade:buffer (buffer_read_file "gallery/game_engine/v2/games" "ranger2d.tsx")
        def menu:buffer (buffer_read_file "gallery/game_engine/v2/menu" "launcher.tsx")
        def src:string ((buffer_to_string facade) + "\n" + (buffer_to_string menu))
        r.engine.loadScript(src)

        ; ---- init: categories page as retained tiles ------------------------
        r.engine.callFunction("init" (EvalValue.null()))
        t.eqInt("no bridge errors in init" r.bridge.errorCount 0)
        t.eqInt("categories page open" (to_int (r.callSlot("currentPage" 0))) 0)
        t.eqInt("two category tiles" (to_int (r.callSlot("tileCount" 0))) 2)
        ; tiles + cursor are real arena sprites
        t.eqInt("three retained sprites (2 tiles + cursor)"
            (r.bridge.d2.liveOfType((Rg2DType.sprite()))) 3)

        ; ---- D-pad navigation on action EDGES -------------------------------
        t.eqInt("selection starts at 0" (to_int (r.callSlot("selectedIndex" 0))) 0)
        r.press("right")
        t.eqInt("right moves selection to Tests" (to_int (r.callSlot("selectedIndex" 0))) 1)
        ; edge semantics: holding produces ONE move (wasPressed cleared at the
        ; frame boundary; a held key is not a repeat)
        r.bridge.input.setAction(0 "right" true)
        r.step()
        r.step()
        r.step()
        r.bridge.input.setAction(0 "right" false)
        r.step()
        t.eqInt("held key does not repeat (edge, not level)"
            (to_int (r.callSlot("selectedIndex" 0))) 1)
        r.press("left")
        t.eqInt("left moves back to Games" (to_int (r.callSlot("selectedIndex" 0))) 0)

        ; ---- drill into Games → tiles rebuilt without leaking ---------------
        def spritesBefore:int (r.bridge.d2.liveOfType((Rg2DType.sprite())))
        r.press("action")
        t.eqInt("games page open" (to_int (r.callSlot("currentPage" 0))) 1)
        t.eqInt("three game tiles" (to_int (r.callSlot("tileCount" 0))) 3)
        t.eqInt("page turn released old tiles (3 tiles + cursor live)"
            (r.bridge.d2.liveOfType((Rg2DType.sprite()))) 4)
        t.eqInt("select sfx one-shot fired" r.bridge.oneShotCount 1)
        t.ok("Pomppija is the selected tile"
            ((r.callSlot("selectedLabelIsPomppija" 0)) > 0.5))

        ; ---- present the menu (pixels from guest-created tiles) -------------
        def layerH:RgHandle (r.guestHandle("getLayerId"))
        def camH:RgHandle (r.guestHandle("getCameraId"))
        def fb:RgFramebuffer (RgFramebuffer.create(96 96))
        def drawn:int (RgSoftwareRenderer2D.present2D(r.bridge.d2 fb layerH camH))
        t.eqInt("menu present drew 3 tiles + cursor" drawn 4)
        t.ok("selected tile under the camera (pane centre pixel)"
            ((fb.at(48 48)) != 0))

        ; ---- select Pomppija → launch request -------------------------------
        r.press("action")
        t.eqStr("launch request reports the game path"
            r.bridge.launchRequest "games/ylos2")
        t.eqStr("selection vocal cue" (itemAt r.bridge.vocalCues 0) "select")
        t.eqInt("no bridge errors across the menu session" r.bridge.errorCount 0)

        ; ---- handoff: tear the menu realm down, boot the game guest ---------
        def reclaimed:int (r.bridge.teardown())
        t.ok("menu realm teardown reclaimed its objects" (reclaimed > 0))

        def g:LauncherV2Runner (new LauncherV2Runner)
        g.engine.quiet = true
        g.engine.setNativeBridge(g.bridge)
        def game:buffer (buffer_read_file "gallery/game_engine/v2/games/ylos2" "index.tsx")
        def gsrc:string ((buffer_to_string facade) + "\n" + (buffer_to_string game))
        g.engine.loadScript(gsrc)
        g.engine.callFunction("init" (EvalValue.null()))
        t.eqInt("launched game built its scene in a fresh realm"
            (g.bridge.d2.liveOfType((Rg2DType.sprite()))) 27)
        def y0:double (g.callSlot("playerY" 0))
        ; run a short attract burst through the real input path
        def f 0
        while (f < 90) {
            def bits:int (to_int (g.callSlot("autopilotBits" 0)))
            g.bridge.input.setAction(0 "jump" (((idiv bits 4) % 2) == 1))
            g.bridge.input.setAction(0 "right" (((idiv bits 2) % 2) == 1))
            g.bridge.input.setAction(0 "left" ((bits % 2) == 1))
            g.step()
            f = (f + 1)
        }
        def y1:double (g.callSlot("playerY" 0))
        t.ok("launched game is running (player moving)" (y1 < y0))
        t.eqInt("no bridge errors in the launched game" g.bridge.errorCount 0)

        t.summary()
    }
}

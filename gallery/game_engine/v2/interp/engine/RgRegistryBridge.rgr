            this.audio.markVoiceDone(vh)   ; headless mixer: completes this frame
            this.oneShotCount = (this.oneShotCount + 1)
            ; v1-faithful: synthesise the source's clip tone into REAL PCM and push
            ; it through the capturing sink (SDL sink queues it; tests observe it).
            def clip:RgAudioClip (this.audio.sourceClip((a.handleAt(0))))
            def spec:SynthToneSpec (new SynthToneSpec)
            spec.freqHz = clip.freqHz
            spec.durationMs = clip.durationMs
            spec.volume = clip.volume
            spec.wave = clip.wave
            this.gameAudio.queueSpec("oneshot" spec)
            return (EvalValue.null())

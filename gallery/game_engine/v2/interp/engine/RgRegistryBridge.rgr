; ==============================================================================
; RgRegistryBridge — THE interpreter transport (BRIDGES.md §2.3, D-ADAPTER).
; ==============================================================================
; The only EvalNativeBridge in v2. It contains no per-command knowledge in the
; transport path: `has` and `invoke` are pure command-table lookups, argument
; decoding is driven by each row's argSpec, results are encoded per retSpec,
; and guest handles live in ONE surrogate table shared by every module
; (D-IDENTITY: one guest id ↔ one live host handle; ids are never reused).
;
; A stale guest id, wrong arity, wrong value type, or unknown command resolves
; to a typed, observable error (errorCount/lastError) — never silence, never UB.
;
; The terminal glue (`dispatchRow`) is the INTERIM hand dispatcher tolerated by
; BRIDGES.md §2.4: one line per table row calling the owning arena method. It
; is un-forkable because the coverage gate
; (tests/unit/bridge/registry_bridge_coverage_test) executes EVERY table row
; and fails on any unhandled or erroring command; the codegen emitter replaces
; this section (registry/generated/RgDispatch.rgr) in BRIDGES.md step 5.
; ==============================================================================

Import "../migrate/src/ComponentEngine.rgr"
Import "../../imaging/png/PNGDecoder.rgr"
Import "../../registry/schema/core/core_schema.rgr"
Import "../../registry/schema/two_d/two_d_schema.rgr"
Import "../../registry/schema/three/three_schema.rgr"
Import "../../registry/schema/cannon/cannon_schema.rgr"
Import "../../registry/codegen/RgCodegen.rgr"
Import "../../modules/ranger_2d/RgRanger2D.rgr"
Import "../../modules/ranger_three/RgRangerThree.rgr"
Import "../../modules/ranger_core/RgAudio.rgr"
Import "../../audio/game_audio.rgr"
Import "../../modules/ranger_core/RgInputSurface.rgr"
Import "../../modules/ranger_core/RgRuntime.rgr"
Import "../../three/port/src/three_gltf_file.rgr"
Import "../../three/port/src/three_object3d.rgr"
Import "../../host/handles/RgHandle.rgr"
Import "../../host/ownership/OwnedHandle.rgr"
Import "../../host/arenas/physics/RgPhysicsHost.rgr"

; One recorded frame pass (PLAN_2D_EMBED_3D D2). kind: 0=2D pane, 1=3D RTT.
class RgFramePass {
    def kind:int 0
    def layerH:RgHandle (new RgHandle)
    def camH:RgHandle (new RgHandle)
    def paneIndex:int 0
    def sceneH:RgHandle (new RgHandle)
    def cam3H:RgHandle (new RgHandle)
    def texH:RgHandle (new RgHandle)
    def width:int 0
    def height:int 0
}

; Position-indexed decoded arguments (parallel arrays; every position fills
; every array so indices align). At most one ai and one ad per command —
; matching the current schema alphabet; the table validator enforces the specs.
class RgDecodedArgs {
    def ok:boolean true
    def err:string ""
    def ints:[int]
    def dbls:[double]
    def strs:[string]
    def handles:[RgHandle]
    def guestIds:[int]
    def ai:[int]
    def ad:[double]

    fn pad:void () {
        push this.ints 0
        push this.dbls 0.0
        push this.strs ""
        push this.handles (RgHandle.invalid())
        push this.guestIds 0
    }
    fn intAt:int (i:int) { return (itemAt this.ints i) }
    fn dblAt:double (i:int) { return (itemAt this.dbls i) }
    fn strAt:string (i:int) { return (itemAt this.strs i) }
    fn handleAt:RgHandle (i:int) { return (itemAt this.handles i) }
    fn guestIdAt:int (i:int) { return (itemAt this.guestIds i) }
}

; Captures the last synth burst pushed by GameAudio so the one-shot PCM path is
; observable from the bridge (and asserted by tests): a v1-faithful one-shot
; must yield REAL, non-silent PCM, not a silent lifecycle probe.
class CapturingAudioSink extends GameAudioSink {
    def lastSampleCount:int 0
    def lastNonZero:int 0
    def synthCount:int 0

    fn onSynthPlay:void (soundId:string sampleRate:int sampleCount:int pcm:buffer) {
        this.lastSampleCount = sampleCount
        this.synthCount = (this.synthCount + 1)
        def nz 0
        def bytes:int (buffer_length pcm)
        def frames:int (to_int (bytes / 2))
        def i 0
        while (i < frames) {
            def off:int (i * 2)
            def lo:int (buffer_get pcm off)
            def hi:int (buffer_get pcm (off + 1))
            def v:int (lo + (hi * 256))
            if (v >= 32768) { v = (v - 65536) }
            if (v != 0) { nz = (nz + 1) }
            i = (i + 1)
        }
        this.lastNonZero = nz
    }
}

class RgRegistryBridge extends EvalNativeBridge {
    ; the ONE command table (generated from the authored module schemas)
    def table:[RgCommand]

    ; host modules (the real Phase 2–11 arenas)
    def d2:RgRanger2D (new RgRanger2D)
    def d3:RgRangerThree (new RgRangerThree)
    ; cannon-backed rigid-body arena (D-TYPE: its own slot space, separate from d3)
    def phys:RgPhysicsHost (new RgPhysicsHost)
    def audio:RgAudio (new RgAudio)
    ; the tone synth + a capturing sink: one-shots synthesise REAL PCM here.
    def gameAudio:GameAudio (new GameAudio)
    def audioSink:CapturingAudioSink (new CapturingAudioSink)
    ; Default host capacity for logical players (not a title-specific count).
    ; Guests that need fewer simply leave slots unused; hosts that need more
    ; construct the bridge with a larger RgInput before install.
    def input:RgInput (RgInput.create(2))
    def surface:RgSurface (new RgSurface)
    def clock:RgClock (new RgClock)
    ; Global ordered frame-pass stream (PLAN D2) — cleared each update.
    def passes:[RgFramePass]

    ; the single guest-id ↔ OwnedHandle surrogate table (all modules)
    def owned:[OwnedHandle]

    ; typed-error + facade observability (runner/tests assert these)
    def errorCount:int 0
    def lastError:string ""
    def unhandledCount:int 0
    def oneShotCount:int 0
    def vocalCues:[string]
    def musicPlaying:boolean false
    def musicScore:string ""
    def logLines:[string]
    def launchRequest:string ""
    ; the loaded game package's directory — pkg:// asset URIs resolve here
    def packageDir:string ""

    sfn create:RgRegistryBridge () {
        def b:RgRegistryBridge (new RgRegistryBridge)
        def core:RgSchema (CoreSchema.build())
        def twoD:RgSchema (TwoDSchema.build())
        def three:RgSchema (ThreeSchema.build())
        def cannon:RgSchema (CannonSchema.build())
        def base:[RgCommand] (RgCodegen.tableUnion(core twoD))
        def withThree:[RgCommand] (RgCodegen.tableAppend(base three))
        b.table = (RgCodegen.tableAppend(withThree cannon))
        ; build the synth tables (sine/midi) and wire the capturing sink so the
        ; one-shot path can synthesise real PCM the moment a guest plays it.
        b.gameAudio.init()
        b.gameAudio.setSink(b.audioSink)
        return b
    }

    ; one-shot PCM observability (asserted by tests/unit/audio/one_shot_pcm_test):
    ; the sample count and non-zero-sample count of the last synthesised burst.
    fn lastOneShotSampleCount:int () { return this.audioSink.lastSampleCount }
    fn lastOneShotNonZero:int () { return this.audioSink.lastNonZero }

    fn clearPasses:void () {
        def empty:[RgFramePass]
        this.passes = empty
    }

    fn appendPass2D:void (layerH:RgHandle camH:RgHandle pane:int) {
        def p:RgFramePass (new RgFramePass)
        p.kind = 0
        p.layerH = layerH
        p.camH = camH
        p.paneIndex = pane
        push this.passes p
    }

    fn appendPass3D:void (sceneH:RgHandle camH:RgHandle texH:RgHandle w:int h:int) {
        def p:RgFramePass (new RgFramePass)
        p.kind = 1
        p.sceneH = sceneH
        p.cam3H = camH
        p.texH = texH
        p.width = w
        p.height = h
        push this.passes p
    }

    ; ---- surrogate table ----------------------------------------------------
    fn mintId:int (o:OwnedHandle) {
        push this.owned o
        return (array_length this.owned)
    }
    fn resolveGuestId:RgHandle (id:int) {
        if (id < 1) { return (RgHandle.invalid()) }
        if (id > (array_length this.owned)) { return (RgHandle.invalid()) }
        def o:OwnedHandle (itemAt this.owned (id - 1))
        if (o.released) { return (RgHandle.invalid()) }
        return o.handle
    }
    fn ownedOf:OwnedHandle (id:int) {
        return (itemAt this.owned (id - 1))
    }

    fn fail:EvalValue (msg:string) {
        this.errorCount = (this.errorCount + 1)
        this.lastError = msg
        return (EvalValue.null())
    }

    ; Surface a typed 3D handle rejection from RgRangerThree.lastErr.
    fn fail3d:EvalValue (cmd:string) {
        def msg:string this.d3.lastErr
        if (msg == "") {
            msg = "wrong-type"
        }
        this.d3.clearErr()
        return (this.fail((msg + ":") + cmd))
    }

    ; ---- EvalNativeBridge (pure table lookups) ------------------------------
    fn has:boolean (name:string) {
        def row:RgCommand (RgCodegen.findByName(this.table name))
        return (row.id != (0 - 1))
    }

    fn invoke:EvalValue (name:string args:[EvalValue]) {
        def row:RgCommand (RgCodegen.findByName(this.table name))
        if (row.id == (0 - 1)) {
            return (this.fail("unknown-command:" + name))
        }
        def dec:RgDecodedArgs (this.decode(row args))
        if (dec.ok == false) {
            return (this.fail(dec.err))
        }
        return (this.dispatchRow(row dec))
    }

    ; ---- generic decode (driven only by the row's argSpec) ------------------
    fn decode:RgDecodedArgs (row:RgCommand args:[EvalValue]) {
        def dec:RgDecodedArgs (new RgDecodedArgs)
        def toks:[string]
        if (row.argSpec != "") {
            toks = (strsplit row.argSpec ":")
        }
        def want:int (array_length toks)
        if ((array_length args) != want) {
            dec.ok = false
            dec.err = ((("arity:" + row.name) + ":want:") + (to_string want))
            return dec
        }
        def i 0
        while (i < want) {
            def tk:string (itemAt toks i)
            def v:EvalValue (itemAt args i)
            dec.pad()
            if (tk == "i") {
                if (v.valueType != 1) {
                    dec.ok = false
                    dec.err = (("type:" + row.name) + ":i32-expected")
                    return dec
                }
                set dec.ints i (to_int v.numberValue)
            }
            if (tk == "d") {
                if (v.valueType != 1) {
                    dec.ok = false
                    dec.err = (("type:" + row.name) + ":f64-expected")
                    return dec
                }
                set dec.dbls i v.numberValue
            }
            if (tk == "s") {
                if (v.valueType != 2) {
                    dec.ok = false
                    dec.err = (("type:" + row.name) + ":string-expected")
                    return dec
                }
                set dec.strs i v.stringValue
            }
            if (tk == "h") {
                if (v.valueType != 1) {
                    dec.ok = false
                    dec.err = (("type:" + row.name) + ":handle-id-expected")
                    return dec
                }
                def gid:int (to_int v.numberValue)
                def h:RgHandle (this.resolveGuestId(gid))
                if ((h.isValid()) == false) {
                    dec.ok = false
                    dec.err = (("stale-handle:" + row.name) + (":" + (to_string gid)))
                    return dec
                }
                set dec.handles i h
                set dec.guestIds i gid
            }
            if (tk == "ai") {
                if (v.valueType != 4) {
                    dec.ok = false
                    dec.err = (("type:" + row.name) + ":array-expected")
                    return dec
                }
                def n:int (array_length v.arrayValue)
                def k 0
                while (k < n) {
                    def e:EvalValue (itemAt v.arrayValue k)
                    push dec.ai (to_int e.numberValue)
                    k = (k + 1)
                }
            }
            if (tk == "ad") {
                if (v.valueType != 4) {
                    dec.ok = false
                    dec.err = (("type:" + row.name) + ":array-expected")
                    return dec
                }
                def n:int (array_length v.arrayValue)
                def k 0
                while (k < n) {
                    def e:EvalValue (itemAt v.arrayValue k)
                    push dec.ad e.numberValue
                    k = (k + 1)
                }
            }
            i = (i + 1)
        }
        return dec
    }

    ; ---- result encoding ----------------------------------------------------
    sfn retI:EvalValue (n:int) { return (EvalValue.number((to_double n))) }
    sfn retD:EvalValue (n:double) { return (EvalValue.number(n)) }

    ; ---- frame boundary (host pipeline step 7/8 side-effects) ---------------
    fn frameBoundary:void (dt:double) {
        this.clock.advance(dt)
        this.audio.completeOneShots()
        this.input.advanceEdges()
    }

    ; ---- realm teardown backstop (D-OWN) ------------------------------------
    fn teardown:int () {
        def n:int (array_length this.owned)
        def i 0
        while (i < n) {
            def o:OwnedHandle (itemAt this.owned i)
            o.released = true
            i = (i + 1)
        }
        this.clearPasses()
        def a:int (this.d2.teardownRealm(this.d2.realmId))
        def c:int (this.d3.teardownRealm(this.d3.realmId))
        def b:int (this.audio.registry.teardownRealm(this.audio.realmId))
        return ((a + b) + c)
    }

    ; ---- package asset loading (interpreter profile) ------------------------
    ; Parses the documented interim .atlas text format (JSON emitter later):
    ;   texture <w> <h>
    ;   region <name> <x> <y> <w> <h>
    ;   clip <name> <r1,r2,...> <d1,d2,...>
    ; Builds the REAL host texture+atlas and returns the atlas guest id.
    fn s2i:int (txt:string) {
        def v@(optional):int (to_int txt)
        if (null? v) { return 0 }
        return (unwrap v)
    }

    ; one hex digit's value (0-15) from a char code; non-hex → 0.
    sfn hexDigit:int (code:int) {
        if (code >= 48) {
            if (code <= 57) { return (code - 48) }
        }
        if (code >= 97) {
            if (code <= 102) { return ((code - 97) + 10) }
        }
        if (code >= 65) {
            if (code <= 70) { return ((code - 65) + 10) }
        }
        return 0
    }
    fn hexToInt:int (s:string) {
        def v 0
        def i 0
        def n:int (strlen s)
        while (i < n) {
            def c:int (charAt s i)
            v = ((v * 16) + (RgRegistryBridge.hexDigit(c)))
            i = (i + 1)
        }
        return v
    }

    ; Load a decoded pixel store from the documented .rgtx package raster into a
    ; texture. Format (palette-indexed ASCII — small, human-authorable, no PNG
    ; decoder; the JSON/asset pipeline replaces it later, same texture store):
    ;   rgtex <w> <h>
    ;   pal <idx0-15> <rrggbb> <aa>      (one per used palette entry)
    ;   row <hexchars>                   (h rows, w chars, each = palette index)
    fn loadTextureFile:boolean (texH:RgHandle rel:string) {
        if (this.packageDir == "") { return false }
        def pdir:string this.packageDir
        def raw:buffer (buffer_read_file pdir rel)
        def src:string (buffer_to_string raw)
        if ((strlen src) == 0) { return false }
        def w 0
        def h 0
        def palRGB:[int]
        def palA:[int]
        def pi 0
        while (pi < 16) {
            push palRGB 0
            push palA 0
            pi = (pi + 1)
        }
        def rgb:[int]
        def alpha:[int]
        def rowCount 0
        def lines:[string] (strsplit src "\n")
        def n:int (array_length lines)
        def i 0
        while (i < n) {
            def line:string (trim (itemAt lines i))
            def toks:[string] (strsplit line " ")
            if ((array_length toks) > 0) {
                def kind:string (itemAt toks 0)
                if (kind == "rgtex") {
                    w = (this.s2i((itemAt toks 1)))
                    h = (this.s2i((itemAt toks 2)))
                    def total:int (w * h)
                    def k 0
                    while (k < total) {
                        push rgb 0
                        push alpha 0
                        k = (k + 1)
                    }
                }
                if (kind == "pal") {
                    def idx:int (this.s2i((itemAt toks 1)))
                    if (idx >= 0) {
                        if (idx < 16) {
                            set palRGB idx (this.hexToInt((itemAt toks 2)))
                            set palA idx (this.hexToInt((itemAt toks 3)))
                        }
                    }
                }
                if (kind == "row") {
                    if ((array_length toks) > 1) {
                        def chars:string (itemAt toks 1)
                        def cn:int (strlen chars)
                        def cxi 0
                        while (cxi < cn) {
                            def pidx:int (RgRegistryBridge.hexDigit((charAt chars cxi)))
                            def dst:int ((rowCount * w) + cxi)
                            if (dst >= 0) {
                                if (dst < (array_length rgb)) {
                                    set rgb dst (itemAt palRGB pidx)
                                    set alpha dst (itemAt palA pidx)
                                }
                            }
                            cxi = (cxi + 1)
                        }
                        rowCount = (rowCount + 1)
                    }
                }
            }
            i = (i + 1)
        }
        if (w <= 0) { return false }
        this.d2.textureUpload(texH w h rgb alpha)
        return true
    }

    ; Decode a PNG package asset into a texture's RGBA store (the v1 "sheet"
    ; path — the real committed spritesheets, not a hand-authored raster).
    fn loadPngInto:boolean (texH:RgHandle rel:string) {
        if (this.packageDir == "") { return false }
        def pdir:string this.packageDir
        def dec:PNGDecoder (new PNGDecoder())
        def img:ImageBuffer (dec.decode(pdir rel))
        def w:int img.width
        def h:int img.height
        if (w <= 0) { return false }
        if (h <= 0) { return false }
        def rgb:[int]
        def alpha:[int]
        def n:int (w * h)
        def i 0
        while (i < n) {
            def off:int (i * 4)
            def r:int (buffer_get img.pixels off)
            def g:int (buffer_get img.pixels (off + 1))
            def b:int (buffer_get img.pixels (off + 2))
            def a:int (buffer_get img.pixels (off + 3))
            push rgb (((r * 65536) + (g * 256)) + b)
            push alpha a
            i = (i + 1)
        }
        this.d2.textureUpload(texH w h rgb alpha)
        return true
    }

    ; Route an `image <uri>` line by extension: .png through the decoder, the
    ; documented .rgtx raster otherwise.
    fn loadImageInto:boolean (texH:RgHandle rel:string) {
        def n:int (strlen rel)
        if (n >= 4) {
            def ext:string (substring rel (n - 4) n)
            if (ext == ".png") {
                return (this.loadPngInto(texH rel))
            }
        }
        return (this.loadTextureFile(texH rel))
    }

    ; Package-relative .glb → scene entity. Game-agnostic: any uri under the
    ; loaded package. Embedded PNG bufferViews are decoded here (bridge owns
    ; imaging); geometry/materials come from ThreeGLTFFile.
    fn loadModelAsset:int (uri:string) {
        def rel:string uri
        if ((indexOf uri "pkg://") == 0) {
            rel = (substring uri 6)
        }
        if (this.packageDir == "") { return 0 }
        def pdir:string this.packageDir
        def raw:buffer (buffer_read_file pdir rel)
        if ((buffer_length raw) < 20) { return 0 }
        def loader:ThreeGLTFFile (new ThreeGLTFFile)
        def root:ThreeObject3D (loader.loadGLB(raw))
        def ni:int (loader.imageCount())
        def i 0
        while (i < ni) {
            def png:buffer (loader.imageBytes(i))
            if ((buffer_length png) > 8) {
                def dec:PNGDecoder (new PNGDecoder)
                def img:ImageBuffer (dec.decodeBytes(png))
                if ((img.width > 0) && (img.height > 0)) {
                    loader.setImage(i img.pixels img.width img.height)
                }
            }
            i = (i + 1)
        }
        this.d3.clearErr()
        def o:OwnedHandle (this.d3.modelAttachRoot(root))
        if ((o.handle.isValid()) == false) { return 0 }
        return (this.mintId(o))
    }

    fn loadAtlasAsset:int (uri:string) {
        def rel:string uri
        if ((indexOf uri "pkg://") == 0) {
            rel = (substring uri 6)
        }
        if (this.packageDir == "") { return 0 }
        def pdir:string this.packageDir
        def raw:buffer (buffer_read_file pdir rel)
        def src:string (buffer_to_string raw)
        if ((strlen src) == 0) { return 0 }
        def texOwned@(optional):OwnedHandle
        def atlasOwned@(optional):OwnedHandle
        def atlasGuestId:int 0
        def lines:[string] (strsplit src "\n")
        def n:int (array_length lines)
        def i 0
        while (i < n) {
            def toks:[string] (strsplit (trim (itemAt lines i)) " ")
            if ((array_length toks) > 0) {
                def kind:string (itemAt toks 0)
                if (kind == "texture") {
                    def to:OwnedHandle (this.d2.textureCreate((this.s2i((itemAt toks 1))) (this.s2i((itemAt toks 2)))))
                    texOwned = to
                    def ao:OwnedHandle (this.d2.atlasCreate(to.handle))
                    atlasOwned = ao
                    atlasGuestId = (this.mintId(ao))
                    this.mintId(to)
                }
                if (kind == "image") {
                    ; `image <uri>` uploads a decoded pixel store into the
                    ; texture just created by the `texture` line (D-2D). A .png
                    ; goes through the decoder (real committed spritesheets);
                    ; a .rgtx through the documented raster. Regions / sheet
                    ; cells index into these texels; a backend samples them.
                    if texOwned {
                        def txo:OwnedHandle (unwrap texOwned)
                        this.loadImageInto(txo.handle (itemAt toks 1))
                    }
                }
                if (kind == "sheet") {
                    ; `sheet <fw> <fh> <cols> <rows>` marks the atlas a
                    ; spritesheet grid (v1 "sheet" kind): sprites sample cells.
                    if atlasOwned {
                        def aos:OwnedHandle (unwrap atlasOwned)
                        this.d2.atlasSetSheet(aos.handle (this.s2i((itemAt toks 1))) (this.s2i((itemAt toks 2))) (this.s2i((itemAt toks 3))) (this.s2i((itemAt toks 4))))
                    }
                }
                if (kind == "region") {
                    if atlasOwned {
                        def ao2:OwnedHandle (unwrap atlasOwned)
                        this.d2.atlasAddRegion(ao2.handle (itemAt toks 1) (this.s2i((itemAt toks 2))) (this.s2i((itemAt toks 3))) (this.s2i((itemAt toks 4))) (this.s2i((itemAt toks 5))))
                    }
                }
                if (kind == "clip") {
                    if atlasOwned {
                        def ao3:OwnedHandle (unwrap atlasOwned)
                        def frameNames:[string] (strsplit (itemAt toks 2) ",")
                        def frames:[int]
                        def fi 0
                        while (fi < (array_length frameNames)) {
                            push frames (this.d2.atlasRegionIndex(ao3.handle (itemAt frameNames fi)))
                            fi = (fi + 1)
                        }
                        def durToks:[string] (strsplit (itemAt toks 3) ",")
                        def durs:[double]
                        def di 0
                        while (di < (array_length durToks)) {
                            push durs (to_double (this.s2i((itemAt durToks di))))
                            di = (di + 1)
                        }
                        this.d2.atlasAddClip(ao3.handle (itemAt toks 1) frames durs)
                    }
                }
            }
            i = (i + 1)
        }
        return atlasGuestId
    }

    ; =========================================================================
    ; INTERIM hand dispatcher (BRIDGES.md §2.4) — one line per table row.
    ; Coverage-gated: registry_bridge_coverage_test executes every row; an
    ; unhandled name or an errored dispatch is red. Replaced by generated
    ; registry/generated/RgDispatch.rgr in step 5.
    ; =========================================================================
    fn dispatchRow:EvalValue (row:RgCommand a:RgDecodedArgs) {
        ; ---- ranger:2d ------------------------------------------------------
        if (row.name == "rg2d_texture_create") {
            def o:OwnedHandle (this.d2.textureCreate((a.intAt(0)) (a.intAt(1))))
            def gid:int (this.mintId(o))
            return (RgRegistryBridge.retI(gid))
        }
        if (row.name == "rg2d_atlas_create") {
            def o:OwnedHandle (this.d2.atlasCreate((a.handleAt(0))))
            def gid:int (this.mintId(o))

; ==============================================================================
; RgValue — v2 interpreter runtime value (D-IDENTITY / D-HANDLE).
; ==============================================================================
; A minimal, self-contained slice of the interpreter value model, built to
; validate the CODE_CLEANUP binding contract without pulling in the whole
; ComponentEngine / EVG / ts_parser stack.
;
; Value kinds:
;   0 undefined   1 null   2 number   3 string   4 bool      (primitives)
;   5 object      6 array  7 function 8 nativeRef             (references)
;
; D-IDENTITY: every *reference* value (object/array/function/nativeRef) carries
; an immutable `identityId` scoped to its interpreter realm. Primitives have
; identityId 0 (they compare by value, never by identity). Reference `===`
; compares identityId; Map/Set object keys use identity; reading a missing
; property returns `undefined` (kind 0), never `null` (kind 1).
;
; D-HANDLE: a nativeRef additionally carries a host `handle` (opaque bit
; carrier) and the `realmId` it belongs to. One identity maps to at most one
; live host handle in its realm (enforced by RgRealm).
;
; Values are minted through RgRealm so identityId assignment stays monotonic and
; centralized; primitives are cheap standalone constructors (no identity).
; ==============================================================================

class RgValue {
    def kind:int 0
    def num:double 0.0
    def str:string ""
    def b:boolean false

    ; Reference identity — immutable once minted (0 for primitives).
    def identityId:int 0
    def realmId:int 0

    ; Object property bag (kind 5). Insertion tracked via propKeys for stable,
    ; JS-like key ordering.
    def props:[string:RgValue]
    def propKeys:[string]

    ; Array backing store (kind 6).
    def items:[RgValue]

    ; Function tag (kind 7).
    def fnName:string ""

    ; Native host handle (kind 8). 0 = unbound / invalid (D-HANDLE sentinel).
    def handle:int 0

    ; ---- primitive constructors (no identity) -------------------------------

    sfn undef:RgValue () {
        def v:RgValue (new RgValue)
        v.kind = 0
        return v
    }

    sfn nul:RgValue () {
        def v:RgValue (new RgValue)
        v.kind = 1
        return v
    }

    sfn number:RgValue (n:double) {
        def v:RgValue (new RgValue)
        v.kind = 2
        v.num = n
        return v
    }

    sfn str_:RgValue (s:string) {
        def v:RgValue (new RgValue)
        v.kind = 3
        v.str = s
        return v
    }

    sfn boolean:RgValue (x:boolean) {
        def v:RgValue (new RgValue)
        v.kind = 4
        v.b = x
        return v
    }

    ; ---- kind predicates ----------------------------------------------------

    fn isUndefined:boolean () { return (this.kind == 0) }
    fn isNull:boolean () { return (this.kind == 1) }

    ; A reference value participates in identity semantics (object/array/fn/native).
    fn isReference:boolean () {
        return (this.kind >= 5)
    }

    ; ---- object property access (D-IDENTITY missing → undefined) ------------

    fn setProp:void (key:string value:RgValue) {
        if (has this.props key) {
            set this.props key value
            return
        }
        set this.props key value
        push this.propKeys key
    }

    ; Missing member read returns `undefined` (kind 0), never `null` (kind 1).
    fn getProp:RgValue (key:string) {
        if (has this.props key) {
            return (unwrap (get this.props key))
        }
        return (RgValue.undef())
    }

    fn hasProp:boolean (key:string) {
        return (has this.props key)
    }

    ; ---- array access -------------------------------------------------------

    fn pushItem:void (value:RgValue) {
        push this.items value
    }

    fn length:int () {
        return (array_length this.items)
    }

    fn itemAt:RgValue (i:int) {
        return (itemAt this.items i)
    }

    ; ---- identity semantics -------------------------------------------------
    ; Reference `===` compares identityId; primitives compare by type + value.
    ; A reference and a primitive are never `===`.
    sfn tripleEquals:boolean (a:RgValue b:RgValue) {
        if (a.isReference()) {
            if (b.isReference() == false) { return false }
            ; identity is realm-scoped (D-IDENTITY): a reference is === only to a
            ; reference from the same realm with the same identityId.
            if (a.realmId != b.realmId) { return false }
            return (a.identityId == b.identityId)
        }
        if (b.isReference()) { return false }
        ; both primitives — must share kind
        if (a.kind != b.kind) { return false }
        if (a.kind == 2) { return (a.num == b.num) }
        if (a.kind == 3) { return (a.str == b.str) }
        if (a.kind == 4) { return (a.b == b.b) }
        ; null === null, undefined === undefined
        return true
    }

    ; Map / Set key equality. JS keys objects by reference identity and
    ; primitives by SameValueZero; for this slice SameValueZero coincides with
    ; tripleEquals (NaN / signed-zero edge cases are out of scope and noted).
    sfn sameKey:boolean (a:RgValue b:RgValue) {
        return (RgValue.tripleEquals(a b))
    }
}

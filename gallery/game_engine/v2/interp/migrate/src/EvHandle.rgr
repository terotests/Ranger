                ; constructor. Minting one on demand made
                ; `String.prototype.slice.prototype` an object where the spec
                ; says undefined.
                if ((strlen (this.builtinNameOf())) > 0) {
                    return (EvHandle.undefined())
                }
                def keys0:[string]
                def vals0:[EvHandle]
                def p:EvHandle (EvHandle.object(keys0 vals0))
                this.putOwnData("prototype" p)
                return p
            }
            if (key == "name") {
                return (EvHandle.string((this.fnName())))
            }
            if (key == "length") {
                ; Function.prototype.bind fixes arguments, so the bound
                ; function's arity is the target's minus however many were
                ; fixed, never below zero.
                def ar:int ((this.functionArity()) - (this.boundArgCount()))
                if (ar < 0) { ar = 0 }
                return (EvHandle.fromInt(ar))
            }
            if (this.hasProto()) {
                def fpr:EvHandle (this.protoOf())
                return (fpr.getMemberDepth(key 1))
            }
            return (EvHandle.undefined())
        }
        ; Array length property
        if (this.isArray()) {
            if (key == "length") {
                return (EvHandle.fromInt((this.arrayLength())))
            }
            ; A non-index property set on an array (`a.foo = 1`) lives in the
            ; PropertyBag.
            if (this.hasOwnData(key)) {
                return (this.getOwnData(key))
            }
            ; An index reached BY NAME. `a[0]` goes through getIndex, but
            ; `a["0"]` and a prototype-chain read of "0" arrive here, and they
            ; name the same property.
            def ai@(optional):int (to_int key)
            if ai {
                def aidx:int (unwrap ai)
                if ((aidx >= 0) && (aidx < (this.denseLen()))) {
                    def nslot:EvHandle (this.arrayItemAt(aidx))
                    if (nslot.isHole()) {
                        return (EvHandle.undefined())
                    }
                    return nslot
                }
            }
        }
        ; Map/Set carry ordinary properties too (`size` is handled by the engine).
        if ((this.isMap()) || (this.isSet())) {
            if (this.hasOwnData(key)) {
                return (this.getOwnData(key))
            }
        }
        ; String length property
        if (this.isString()) {
            if (key == "length") {
                return (EvHandle.fromInt((strlen (this.stringOf()))))
            }
        }
        return (EvHandle.null())
    }

    ; ---- E4c: property-bag accessors (SoT on body.properties) --------------
    fn tryProps@(optional):EvPropertyBag () {
        def _k:EvalValue body
        case _k o:EvalValue.Object {
            def p:EvPropertyBag o.properties
            def some@(optional):EvPropertyBag p
            return some
        }
        case _k a:EvalValue.Array {
            def p2:EvPropertyBag a.properties
            def some2@(optional):EvPropertyBag p2
            return some2
        }
        case _k f:EvalValue.Function {
            def p3:EvPropertyBag f.properties
            def some3@(optional):EvPropertyBag p3
            return some3
        }
        case _k m:EvalValue.Map {
            def p4:EvPropertyBag m.properties
            def some4@(optional):EvPropertyBag p4
            return some4
        }
        case _k st:EvalValue.Set {
            def p5:EvPropertyBag st.properties
            def some5@(optional):EvPropertyBag p5
            return some5
        }
        def missing@(optional):EvPropertyBag
        return missing
    }

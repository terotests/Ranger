        if (EvalValue.isString(_k)) { return }
        if (EvalValue.isBoolean(_k)) { return }
        if (EvalValue.isNull(_k)) { return }
        if (EvalValue.isUndefined(_k)) { return }
        if (this.hasOwnData(key)) {

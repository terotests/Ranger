        }
        if (EvalValue.isNumber(_k)) {
            if (false == (EvalValue.isNumber(_o))) {
                return false
            }
            return ((this.numberOf()) == (other.numberOf()))
        }
        if (EvalValue.isString(_k)) {
            if (false == (EvalValue.isString(_o))) {

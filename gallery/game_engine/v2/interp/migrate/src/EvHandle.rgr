    }
    
    fn isArray:boolean () {
        def b:EvalValue body
        return (EvalValue.isArrayValue(b))
    }
    
    fn isObject:boolean () {
        def b:EvalValue body
        return (EvalValue.isObject(b))
    }
    
    fn isFunction:boolean () {
        def b:EvalValue body
        return (EvalValue.isFunction(b))
    }
    
    fn isElement:boolean () {
        def b:EvalValue body
        return (EvalValue.isElement(b))
    }

    fn isUndefined:boolean () {
        def b:EvalValue body
        return (EvalValue.isUndefined(b))
    }

    fn isHole:boolean () {
        def b:EvalValue body
        return (EvalValue.isHole(b))
    }

    fn isMap:boolean () {
        def b:EvalValue body
        return (EvalValue.isMap(b))
    }

    fn isSet:boolean () {
        def b:EvalValue body
        return (EvalValue.isSet(b))
    }

    fn kindName:string () {
        ; Case once on a local copy — chaining this.is*() re-borrows `body`
        ; and panics on the Rust RefCell target.
        def b:EvalValue body
        case b h:EvalValue.Hole { return "Hole" }
        case b n:EvalValue.Null { return "Null" }
        case b u:EvalValue.Undefined { return "Undefined" }
        case b num:EvalValue.Number { return "Number" }
        case b s:EvalValue.String { return "String" }
        case b bo:EvalValue.Boolean { return "Boolean" }
        case b a:EvalValue.Array { return "Array" }
        case b o:EvalValue.Object { return "Object" }
        case b f:EvalValue.Function { return "Function" }
        case b el:EvalValue.Element { return "Element" }
        case b m:EvalValue.Map { return "Map" }
        case b st:EvalValue.Set { return "Set" }
        return "Unknown"
    }
    
    ; Type coercion
    fn toNumber:double () {
        if (this.isNumber()) {
            return (this.numberOf())
        }
        if (this.isString()) {
            def sv:string (this.stringOf())
            def parsed@(optional):double (to_double sv)
            return (unwrap parsed)
        }
        if (this.isBoolean()) {
            if (this.boolOf()) {
                return 1.0
            }
            return 0.0
        }
        return 0.0
    }
    
    fn toString:string () {
        if (this.isNull()) {
            return "null"
        }
        if (this.isHole()) {
            ; A hole READS as undefined when stringified as a value.
            return "undefined"
        }
        if (this.isUndefined()) {
            return "undefined"
        }
        if (this.isNumber()) {
            def nv:double (this.numberOf())
            ; NaN and the infinities print their JS names — the native f64
            ; formatters say "inf"/"-inf" where JavaScript says "Infinity"
            if (nv != nv) {
                return "NaN"
            }
            if (nv == (1.0 / 0.0)) {
                return "Infinity"
            }
            if (nv == ((0.0 - 1.0) / 0.0)) {
                return "-Infinity"
            }
            ; Format number - remove trailing zeros
            def s:string (to_string nv)
            ; Check if it's a whole number
            def intVal:int (to_int nv)
            if ((to_double intVal) == nv) {
                return (to_string intVal)
            }
            return s
        }
        if (this.isString()) {
            return (this.stringOf())
        }
        if (this.isBoolean()) {
            if (this.boolOf()) {
                return "true"
            }
            return "false"
        }
        if (this.isArray()) {
            def result:string "["
            def i:int 0
            def n:int (this.denseLen())
            while (i < n) {
                if (i > 0) {
                    result = result + ", "
                }
                def item:EvHandle (this.arrayItemAt(i))
                def itemStr:string (item.toString())
                result = result + itemStr
                i = i + 1
            }
            return result + "]"
        }
        if (this.isObject()) {
            def result:string "{"
            def keyList:[string] (this.ownDataKeys())
            def i:int 0
            for keyList kk:string idx {
                if (i > 0) {
                    result = result + ", "
                }
                def val:EvHandle (this.getOwnData(kk))
                def valStr:string (val.toString())
                result = result + kk + ": " + valStr
                i = i + 1
            }
            return result + "}"
        }
        if (this.isFunction()) {
            return "[Function: " + (this.fnName()) + "]"
        }
        if (this.isElement()) {
            if (this.hasElement()) {
                def el:EVGElement (this.elementOf())
                return "[EVGElement: " + el.tagName + "]"
            }
            return "[EVGElement: null]"
        }
        return "undefined"
    }
    
    fn toBool:boolean () {
        if (this.isNull()) {
            return false
        }
        if (this.isHole()) {
            return false
        }
        if (this.isUndefined()) {
            return false
        }
        if (this.isNumber()) {
            def nv:double (this.numberOf())
            ; NaN is FALSY. `n != 0.0` is true for NaN, so `!NaN` answered false
            ; and every `if (nan)` took the wrong branch.
            if (nv != nv) {
                return false
            }
            return (nv != 0.0)
        }
        if (this.isString()) {
            return ((strlen (this.stringOf())) > 0)
        }
        if (this.isBoolean()) {
            return (this.boolOf())
        }
        if (this.isArray()) {
            return true ; Arrays are always truthy
        }
        if (this.isObject()) {
            return true ; Objects are always truthy
        }
        if (this.isFunction()) {
            return true ; Functions are always truthy
        }
        if (this.isElement()) {
            return true ; Elements are always truthy
        }
        return false
    }
    
    ; ---- D-ATTRS: property attribute accessors ---------------------------
    ; Absent means the property was made by plain assignment: all three true.
    fn attrOf:int (key:string) {
        def propsOpt@(optional):EvPropertyBag (this.tryProps())
        if propsOpt {
            def props:EvPropertyBag (unwrap propsOpt)
            if (props.hasSlot(key)) {
                return (props.attrsOf(key))
            }
        }
        return 7
    }

    fn isWritable:boolean (key:string) {
        def f:int (this.attrOf(key))
        return ((bit_and f 1) != 0)
    }

    fn isEnumerable:boolean (key:string) {
        def f:int (this.attrOf(key))
        return ((bit_and f 2) != 0)
    }

    fn isConfigurable:boolean (key:string) {
        def f:int (this.attrOf(key))
        return ((bit_and f 4) != 0)
    }

    fn setAttrs:void (key:string w:boolean e:boolean c:boolean) {
        def f:int 0
        if w { f = (bit_or f 1) }
        if e { f = (bit_or f 2) }
        if c { f = (bit_or f 4) }
        def propsOpt@(optional):EvPropertyBag (this.tryProps())
        if propsOpt {
            def props:EvPropertyBag (unwrap propsOpt)
            props.setAttrsOn(key f)
        }
    }

    ; freeze/seal act on every EXISTING property; later additions are blocked by
    ; the bag's extensible flag instead, which is why both are tracked.
    fn markAllNonConfigurable:void (alsoNonWritable:boolean) {
        def ks:[string] (this.ownDataKeys())
        def i:int 0
        while (i < (array_length ks)) {
            def k:string (itemAt ks i)
            def w:boolean (this.isWritable(k))
            if alsoNonWritable {
                w = false
            }
            this.setAttrs(k w (this.isEnumerable(k)) false)
            i = (i + 1)
        }
        def gk:[string] (this.ownGetterKeys())
        def gi:int 0
        while (gi < (array_length gk)) {
            def gk1:string (itemAt gk gi)
            this.setAttrs(gk1 (this.isWritable(gk1)) (this.isEnumerable(gk1)) false)
            gi = (gi + 1)
        }
        def sk:[string] (this.ownSetterKeys())
        def si:int 0
        while (si < (array_length sk)) {
            def sk1:string (itemAt sk si)
            this.setAttrs(sk1 (this.isWritable(sk1)) (this.isEnumerable(sk1)) false)
            si = (si + 1)
        }
    }

    ; D-ACCESSORS: accessor lookup, walking the prototype chain like a data
    ; property does — a getter defined on a prototype serves every instance.

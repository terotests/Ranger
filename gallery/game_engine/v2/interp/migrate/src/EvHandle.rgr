    ; Array index access
    fn getIndex:EvHandle (index:int) {
        if (this.isArray()) {
            if ((index >= 0) && (index < (this.denseLen()))) {
                ; D-HOLES: a hole READS as undefined. Only the code that asks
                ; whether the element is present -- `in`, hasOwnProperty, the
                ; iteration methods -- looks at the slot itself.
                def slot:EvHandle (this.arrayItemAt(index))
                if (slot.isHole()) {
                    return (EvHandle.undefined())
                }
                return slot
            }
        }
        ; String character access
        if (this.isString()) {
            def sidx:string (this.stringOf())
            if ((index >= 0) && (index < (strlen sidx))) {
                def charStr:string (substring sidx index (index + 1))
                return (EvHandle.string(charStr))
            }
            ; An index past the end is a MISSING property, which reads as
            ; undefined. Answering null made `s[11] === undefined` false.
            return (EvHandle.undefined())
        }
        if (this.isArray()) {
            return (EvHandle.undefined())
        }
        ; An OBJECT indexed by number -- a boxed string, say -- reads the
        ; property of that name; a missing one is undefined, not null.
        if (this.isObject()) {
            def ik:string (to_string index)
            if (this.hasOwnData(ik)) {
                return (this.getOwnData(ik))
            }
            return (EvHandle.undefined())
        }
        return (EvHandle.null())
    }
    
    ; Equality check
    ; Same-kind value equality for primitives, identityId equality for
    ; references (D-IDENTITY). Delegates to matches(): the comparison itself,
    ; kind checks included, lives there — and matches never takes a mutable
    ; borrow, so `x == x` on the same pooled handle cannot panic the Rust
    ; RefCell. (Ids are globally unique, so id equality already implies the
    ; kinds agree on the reference arm.)
    fn equals:boolean (other:EvHandle) {
        return (this.matches(other))
    }
}

; Monotonic source of reference identities (D-IDENTITY). Mirrors RgRealm.mintId:
; every object/array/function/Map/Set/element reference gets a unique, immutable
; identityId (>= 1) when it is minted by an EvHandle factory. A single
; process-global counter is a strict superset of the model's "one realm per
; engine" — ids are globally unique, so reference `===` compares identityId
; alone (no realm tag needed). A fresh compiled suite starts the counter at 1.
class EvalIdentityMinter @singleton(true) {
    def nextId:int 1
    fn mint:int () {
        def id:int this.nextId
        this.nextId = (this.nextId + 1)
        return id
    }
}

; E4c: shape storage holds EvalValue; the engine speaks EvHandle. Reference
; wrappers are cached by identityId so Array.items / PropertyBag can store
; the live shape body and still round-trip to the same class handle (===).
class EvValueHandles @singleton(true) {
    def byId:[int:EvHandle]
    fn remember:void (v:EvHandle) {
        def id:int (v.identityIdOf())
        if (id > 0) {
            set byId id v
        }
    }
    fn lookup@(optional):EvHandle (id:int) {
        if (has byId id) {
            def hit:EvHandle (unwrap (get byId id))
            def some@(optional):EvHandle hit
            return some
        }
        def missing@(optional):EvHandle
        return missing
    }
}

; Shared immutable constant values (null / undefined / true / false). These are
; never mutated in place, so a single instance of each is reused for the whole
; program instead of allocating on every EvHandle.null()/boolean()/undefined().
class EvalConstPool @singleton(true) {
    ; A stand-in for elementOf on a non-Element value. The read accessor has
    ; to answer something, and one shared blank costs nothing -- every caller
    ; tests hasElement() first, so nothing ever reads it.
    def blankElement:EVGElement (new EVGElement())
    def nullValue:EvHandle (EvHandle.rawNull())
    def undefinedValue:EvHandle (EvHandle.rawUndefined())
    def trueValue:EvHandle (EvHandle.rawBoolean(true))
    def falseValue:EvHandle (EvHandle.rawBoolean(false))
    def holeValue:EvHandle (EvHandle.rawHole())
    ; PERF: shared SMALL INTEGER values, filled lazily on first use. A number
    ; is immutable -- property writes on a primitive are discarded (see the
    ; assignMember guard), nothing writes numberValue after construction --
    ; so one instance per small int serves the whole program. Array indices,
    ; loop counters, lengths and char codes hit this range constantly; on the
    ; native targets each miss is a ~full-struct allocation.
    ; Interned literal values, one per numeric-literal NODE in the program.
    ; A literal is a constant and a number is immutable, so the same instance
    ; serves every evaluation of that node -- the same argument that makes
    ; smallInts safe, applied to the literals the small-integer range misses.
    def litValues:[EvHandle]
    fn addLiteral:int (v:EvHandle) {
        push litValues v
        return ((array_length litValues) - 1)
    }
    fn literalAt:EvHandle (i:int) {
        return (itemAt litValues i)
    }

    def smallInts:[EvHandle]
    fn smallInt:EvHandle (i:int) {
        if ((array_length smallInts) == 0) {
            def k:int 0
            while (k < 4096) {
                def v:EvHandle (EvHandle.rawNumber((to_double k)))
                push smallInts v
                k = (k + 1)
            }
        }
        return (itemAt smallInts i)
    }
}

            ; when the object is frozen, or when it is a NEW property on a
            ; non-extensible object. Sloppy mode ignores the failure silently,
            ; which is what this models; strict mode would throw.
            if (this.isFrozenObj()) {
                return
            }
            if (this.hasOwnData(key)) {
                if (false == (this.isWritable(key))) {
                    return
                }
            } {
                if (false == (this.isExtensible())) {
                    return
                }

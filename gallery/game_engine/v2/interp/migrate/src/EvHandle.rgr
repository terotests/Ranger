            this.putOwnData(key value)
            return
        }
        if (EvalValue.isArrayValue(_k)) {
            this.putOwnData(key value)
            return
        }
        if ((EvalValue.isMap(_k)) || (EvalValue.isSet(_k))) {
            this.putOwnData(key value)
            return

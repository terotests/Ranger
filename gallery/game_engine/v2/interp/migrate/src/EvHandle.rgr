    ; functions (6), arrays (4) and Map/Set (9/10). Primitives silently ignore
    ; the write, which is sloppy-mode behaviour.
    fn setMember:void (key:string value:EvHandle) {
        ; Kind from a local body copy — this.is*() re-borrows via Rc on Rust.
        def _k:EvalValue body
        if (EvalValue.isObject(_k)) {

                if ((value.matches(el))) {
                    idx = i
                }
                i = (i + 1)
            }
            if (idx < 0) {
                return false
            }
            def rebuilt:[EvalValue]
            def j:int 0
            while (j < (array_length st.items)) {
                if (j != idx) {

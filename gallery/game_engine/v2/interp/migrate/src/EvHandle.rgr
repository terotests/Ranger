; =============================================================================
; EvHandle - Runtime value type for expression evaluation
; =============================================================================
; Represents values that can be evaluated: numbers, strings, booleans, 
; null, arrays, objects, functions, and EVG elements.
;
; Migration (PLAN_SHAPES.md §7.5 E4e): thin engine handle around `body:EvalValue`.
; Collection / property / Function / Element / string / bool live on the shape.
; Shell left: numberValue + slotOwned (in-place i++), identityId hot-path cache
; (also on Reference), EvValueHandles. Number `@(value)` blocks slotOwned on
; the shape.

Import "../../../evg/EVGElement.rgr"
Import "../../../../../ts_parser/ts_parser_simple.rgr"
Import "EvalValue.rgr"

; Kind discriminant: `body` (shape EvalValue). Legacy int tags are gone.
; Map SoT: body.Map.entries. Set SoT: body.Set.items.

; Runtime hooks the LLVM backend replaces with intrinsics. Every other target
; keeps these bodies, so the optimisations they gate simply never fire there --
; the answers below are the conservative ones.
class RangerMem {
    sfn liveObjects:int () { return 0 }
    sfn resetStats:void () { }
    ; "Is the value under `key` held by nothing but this map?" Only a reference
    ; counted runtime can answer; without one the honest answer is "cannot tell",
    ; which callers must read as "not unique".
    sfn mapValueUnique:boolean (m:[string:EvHandle] key:string) { return false }
    ; "Assign only if the key is already there", answering whether it was. The
    ; portable fallback is the two-lookup form the intrinsic replaces.
    sfn mapPutIfPresent:boolean (m:[string:EvHandle] key:string v:EvHandle) {
        if (has m key) {
            set m key v
            return true
        }
        return false
    }
}

class EvHandle {
    ; Kind discriminant — closed family (PLAN_SHAPES.md §7.5 step 4).
    def body:EvalValue (new EvalValue.Undefined())
    ; Live number cache — rewritten with body via setNumberOf. slotOwned i++
    ; mutates in place; @(value) forbids putting that mutation on Number.value.
    def numberValue:double 0.0
    ; True only for a number minted to fill ONE binding's slot in a frame whose
    ; body scan proved the name's value object never escapes. Nothing else can
    ; be holding it, so `i++` writes via setNumberOf in place. Every value the
    ; script can alias -- and every pooled literal, which is shared by every
    ; occurrence of that constant -- keeps false and takes the minting path.
    def slotOwned:boolean false
    ; D-IDENTITY: immutable reference identity. Object/array/function/Map/Set/
    ; element values are stamped with a unique id (>= 1) at mint; primitives keep
    ; 0 and compare by value. Never changed by property writes, reparenting, or
    ; array reorder — assigned exactly once at the creation factory below.
    ; (Also on body Reference.identityId; class field is the hot-path cache.)
    def identityId:int 0

    ; ---- Primitive accessors (string/bool SoT on body; number synced) ----
    fn stringOf:string () {
        def b:EvalValue body
        case b s:EvalValue.String {
            return s.value
        }
        return ""
    }
    fn boolOf:boolean () {
        def b:EvalValue body
        case b bo:EvalValue.Boolean {
            return bo.value
        }
        return false
    }
    fn numberOf:double () {
        return numberValue
    }
    ; Keep class cache and body.Number in lockstep after every mutation.
    fn setNumberOf:void (n:double) {
        numberValue = n
        body = (EvalValue.number(n))
    }
    fn identityIdOf:int () {
        ; Prefer the class cache (always stamped at mint). Fall back to body
        ; case fields — case each Reference member (not the group) so Rust's
        ; flat union lowering can match.
        if (identityId > 0) {
            return identityId
        }
        def b:EvalValue body
        case b a:EvalValue.Array { return a.identityId }
        case b o:EvalValue.Object { return o.identityId }
        case b f:EvalValue.Function { return f.identityId }
        case b m:EvalValue.Map { return m.identityId }
        case b st:EvalValue.Set { return st.identityId }
        case b el:EvalValue.Element { return el.identityId }
        return 0
    }

    ; ---- Function SoT: body.Function.core / .binding (PLAN_SHAPES §7.3) ----
    ; Ensure body is a Function case before writing core/binding fields.
    fn ensureFunction:void () {
        def b:EvalValue body
        if (EvalValue.isFunction(b)) {
            return
        }
        def id:int (this.identityIdOf())
        if (id <= 0) {
            id = ((EvalIdentityMinter.__singleton()).mint())
            identityId = id
        }
        body = (EvalValue.functionStubAt(id ""))
    }

    fn fnCore:EvFunctionCore () {
        this.ensureFunction()
        def _evBody:EvalValue body
        case _evBody f:EvalValue.Function {
            return (unwrap f.core)
        }
        def fallback:EvFunctionCore (new EvFunctionCore())
        return fallback
    }

    fn fnBinding:EvFunctionBinding () {
        this.ensureFunction()
        def _evBody:EvalValue body
        case _evBody f:EvalValue.Function {
            return (unwrap f.binding)
        }
        def fallback:EvFunctionBinding (new EvFunctionBinding())
        return fallback
    }

    fn fnName:string () {
        def _evBody:EvalValue body
        case _evBody f:EvalValue.Function {
            def c:EvFunctionCore (unwrap f.core)
            return c.functionName
        }
        return ""
    }
    fn setFnName:void (s:string) {
        def c:EvFunctionCore (this.fnCore())
        c.functionName = s
    }

    fn closureIdOf:int () {
        def _evBody:EvalValue body
        case _evBody f:EvalValue.Function {
            def c:EvFunctionCore (unwrap f.core)
            return c.closureId
        }
        return (0 - 1)
    }
    fn setClosureId:void (v:int) {
        def c:EvFunctionCore (this.fnCore())
        c.closureId = v
    }

    fn homeModuleOf:string () {
        def _evBody:EvalValue body
        case _evBody f:EvalValue.Function {
            def c:EvFunctionCore (unwrap f.core)
            return c.homeModule
        }
        return ""
    }
    fn setHomeModule:void (s:string) {
        def c:EvFunctionCore (this.fnCore())
        c.homeModule = s
    }

    fn srcTextOf:string () {
        def _evBody:EvalValue body
        case _evBody f:EvalValue.Function {
            def c:EvFunctionCore (unwrap f.core)
            return c.srcText
        }
        return ""
    }
    fn setSrcText:void (s:string) {
        def c:EvFunctionCore (this.fnCore())
        c.srcText = s
    }

    fn builtinKindOf:string () {
        def _evBody:EvalValue body
        case _evBody f:EvalValue.Function {
            def c:EvFunctionCore (unwrap f.core)
            return c.builtinKind
        }
        return ""
    }
    fn setBuiltinKind:void (s:string) {
        def c:EvFunctionCore (this.fnCore())
        c.builtinKind = s
    }

    fn builtinNameOf:string () {
        def _evBody:EvalValue body
        case _evBody f:EvalValue.Function {
            def c:EvFunctionCore (unwrap f.core)
            return c.builtinName
        }
        return ""
    }
    fn setBuiltinName:void (s:string) {
        def c:EvFunctionCore (this.fnCore())
        c.builtinName = s
    }

    fn builtinNamespaceOf:string () {
        def _evBody:EvalValue body
        case _evBody f:EvalValue.Function {
            def c:EvFunctionCore (unwrap f.core)
            return c.builtinNamespace
        }
        return ""
    }
    fn setBuiltinNamespace:void (s:string) {
        def c:EvFunctionCore (this.fnCore())
        c.builtinNamespace = s
    }

    fn strictFnOf:boolean () {
        def _evBody:EvalValue body
        case _evBody f:EvalValue.Function {
            def c:EvFunctionCore (unwrap f.core)
            return c.strictFn
        }
        return false
    }
    fn setStrictFn:void (b:boolean) {
        def c:EvFunctionCore (this.fnCore())
        c.strictFn = b
    }

    fn boundExplicitOf:boolean () {
        def _evBody:EvalValue body
        case _evBody f:EvalValue.Function {
            def bind:EvFunctionBinding (unwrap f.binding)
            return bind.boundExplicit
        }
        return false
    }
    fn setBoundExplicit:void (b:boolean) {
        def bind:EvFunctionBinding (this.fnBinding())
        bind.boundExplicit = b
    }

    ; The collections are reached through operations rather than handed out: a
    ; target that returns a collection by value would copy it, and a caller that
    ; wrote into the copy would lose the write.
    ; Suppressed keys live on EvPropertyBag (not FunctionCore) so prototype
    ; objects can record registry deletions without ensureFunction rewriting
    ; their kind.
    fn hasSuppressed:boolean (key:string) {
        def propsOpt@(optional):EvPropertyBag (this.tryProps())
        if propsOpt {
            def props:EvPropertyBag (unwrap propsOpt)
            return (has props.suppressedKeys key)
        }
        return false
    }
    fn addSuppressed:void (key:string) {
        def propsOpt@(optional):EvPropertyBag (this.tryProps())
        if propsOpt {
            def props:EvPropertyBag (unwrap propsOpt)
            set props.suppressedKeys key true
        }
    }
    fn suppressedKeyList:[string] () {
        def propsOpt@(optional):EvPropertyBag (this.tryProps())
        if propsOpt {
            def props:EvPropertyBag (unwrap propsOpt)
            return (keys props.suppressedKeys)
        }
        def none:[string]
        return none
    }
    fn setSuppressed:void (m:[string:boolean]) {
        def propsOpt@(optional):EvPropertyBag (this.tryProps())
        if propsOpt {
            def props:EvPropertyBag (unwrap propsOpt)
            props.suppressedKeys = m
        }
    }
    fn copySuppressedMap:[string:boolean] () {
        def out:[string:boolean]
        def ks:[string] (this.suppressedKeyList())
        for ks kk:string i {
            set out kk true
        }
        return out
    }

    fn boundArgCount:int () {
        def _evBody:EvalValue body
        case _evBody f:EvalValue.Function {
            def bind:EvFunctionBinding (unwrap f.binding)
            return (array_length bind.boundArgs)
        }
        return 0
    }
    fn boundArgAt:EvHandle (index:int) {
        def _evBody:EvalValue body
        case _evBody f:EvalValue.Function {
            def bind:EvFunctionBinding (unwrap f.binding)
            if ((index >= 0) && (index < (array_length bind.boundArgs))) {
                return (EvHandle.fromBody((itemAt bind.boundArgs index)))
            }
        }
        return (EvHandle.undefined())
    }
    fn setBoundArgs:void (items:[EvHandle]) {
        def bind:EvFunctionBinding (this.fnBinding())
        def stored:[EvalValue]
        for items it:EvHandle i {
            push stored (it.toStored())
        }
        bind.boundArgs = stored
    }

    ; ---- Element (SoT: body.Element.element) --------------------------------
    fn hasElement:boolean () {
        def b:EvalValue body
        return (EvalValue.isElement(b))
    }
    fn elementOf:EVGElement () {
        def _evBody:EvalValue body
        case _evBody el:EvalValue.Element {
            return (unwrap el.element)
        }
        def pool:EvalConstPool (EvalConstPool.__singleton())
        return pool.blankElement
    }
    fn setElement:void (el:EVGElement) {
        ; Rewrite the Element case; keep Reference identity.
        def id:int (this.identityIdOf())
        if (id <= 0) {
            id = ((EvalIdentityMinter.__singleton()).mint())
            identityId = id
        }
        body = (EvalValue.elementAt(id el))
    }

    ; Constructors
    ; null / undefined / true / false are immutable (never mutated in place — the
    ; mutating ops setMember/setIndexAt/push only act on objects/arrays), so they
    ; are returned as shared singletons instead of allocating a new value every
    ; time. This removes the single largest source of interpreter allocations.
    sfn null:EvHandle () {
        def pool:EvalConstPool (EvalConstPool.__singleton())
        return pool.nullValue
    }

    ; Allocating variants used to seed the shared constant pool.
    sfn rawNull:EvHandle () {
        def v:EvHandle (new EvHandle())
        v.body = (EvalValue.null())
        return v
    }

    sfn rawUndefined:EvHandle () {
        def v:EvHandle (new EvHandle())
        v.body = (EvalValue.undefined())
        return v
    }

    ; D-HOLES: an ABSENT array element, as distinct from one holding undefined.
    ; It reads as undefined everywhere a value is wanted, so nothing that merely
    ; consumes elements has to know about it -- but `1 in [0,,2]` is false and
    ; forEach/filter/every/map skip it, which no undefined can express. Its own
    ; Kind is Hole, so any code that missed the distinction still sees
    ; undefined rather than something it cannot classify.
    sfn rawHole:EvHandle () {
        def v:EvHandle (new EvHandle())
        v.body = (EvalValue.hole())
        return v
    }

    sfn hole:EvHandle () {
        def pool:EvalConstPool (EvalConstPool.__singleton())
        return pool.holeValue
    }

    ; True when this element is absent rather than undefined.
    fn holeSlot:boolean () {
        return (this.isHole())
    }

    sfn rawBoolean:EvHandle (b:boolean) {
        def v:EvHandle (new EvHandle())
        v.body = (EvalValue.boolean(b))
        return v
    }
    
    sfn rawNumber:EvHandle (n:double) {
        def v:EvHandle (new EvHandle())
        v.setNumberOf(n)
        return v
    }

    sfn number:EvHandle (n:double) {
        ; a small non-negative integer comes from the shared pool.
        ; NEGATIVE ZERO must not: -0.0 >= 0.0 and -0.0 == 0.0 both hold,
        ; but the pooled +0 loses the sign — 1/-0 is -Infinity, and
        ; Object.is / toString / JSON all observe it.
        if ((n >= 0.0) && (n < 4096.0)) {
            def ni:int (to_int n)
            if ((to_double ni) == n) {
                if ((ni != 0) || ((1.0 / n) > 0.0)) {
                    def pool:EvalConstPool (EvalConstPool.__singleton())
                    return (pool.smallInt(ni))
                }
            }
        }
        def v:EvHandle (new EvHandle())
        v.setNumberOf(n)
        return v
    }

    sfn fromInt:EvHandle (n:int) {
        if ((n >= 0) && (n < 4096)) {
            def pool:EvalConstPool (EvalConstPool.__singleton())
            return (pool.smallInt(n))
        }
        def v:EvHandle (new EvHandle())
        v.setNumberOf((to_double n))
        return v
    }
    
    sfn string:EvHandle (s:string) {
        def v:EvHandle (new EvHandle())
        v.body = (EvalValue.string(s))
        return v
    }
    
    sfn boolean:EvHandle (b:boolean) {
        def pool:EvalConstPool (EvalConstPool.__singleton())
        if b {
            return pool.trueValue
        }
        return pool.falseValue
    }
    

    ; E4c: shape ↔ class. Primitives rebuild from scalar fields; refs return the
    ; live `body` and register with EvValueHandles so Array.items can store
    ; EvalValue and still round-trip to the same class handle (===).
    fn toStored:EvalValue () {
        def _k:EvalValue body
        if (EvalValue.isHole(_k)) {
            return (EvalValue.hole())
        }
        if (EvalValue.isNull(_k)) {
            return (EvalValue.null())
        }
        if (EvalValue.isUndefined(_k)) {
            return (EvalValue.undefined())
        }
        if (EvalValue.isNumber(_k)) {
            return (EvalValue.number((this.numberOf())))
        }
        if (EvalValue.isString(_k)) {
            return body
        }
        if (EvalValue.isBoolean(_k)) {
            return body
        }
        ; Refs: return the live body. Factories / fromBody register the class
        ; handle in EvValueHandles (do not pass `this` here — Rust codegen
        ; double-wraps Rc when `this` is an argument).
        return _k
    }

    sfn fromBody:EvHandle (ev:EvalValue) {
        case ev h:EvalValue.Hole {
            return (EvHandle.hole())
        }
        case ev n:EvalValue.Null {
            return (EvHandle.null())
        }
        case ev u:EvalValue.Undefined {
            return (EvHandle.undefined())
        }
        case ev num:EvalValue.Number {
            return (EvHandle.number(num.value))
        }
        case ev s:EvalValue.String {
            return (EvHandle.string(s.value))
        }
        case ev b:EvalValue.Boolean {
            return (EvHandle.boolean(b.value))
        }
        case ev el:EvalValue.Element {
            def id:int el.identityId
            if (id > 0) {
                def handles:EvValueHandles (EvValueHandles.__singleton())
                def hit@(optional):EvHandle (handles.lookup(id))
                if hit {
                    return (unwrap hit)
                }
                def v:EvHandle (new EvHandle())
                v.body = ev
                v.identityId = id
                handles.remember(v)
                return v
            }
            return (EvHandle.element((unwrap el.element)))
        }
        case ev a:EvalValue.Array {
            def id:int a.identityId
            if (id > 0) {
                def handles2:EvValueHandles (EvValueHandles.__singleton())
                def hit2@(optional):EvHandle (handles2.lookup(id))
                if hit2 {
                    return (unwrap hit2)
                }
                def v2:EvHandle (new EvHandle())
                v2.body = ev
                v2.identityId = id
                handles2.remember(v2)
                return v2
            }
            def items:[EvHandle]
            for a.items it:EvalValue i {
                push items (EvHandle.fromBody(it))
            }
            return (EvHandle.array(items))
        }
        case ev o:EvalValue.Object {
            def id3:int o.identityId
            if (id3 > 0) {
                def handles3:EvValueHandles (EvValueHandles.__singleton())
                def hit3@(optional):EvHandle (handles3.lookup(id3))
                if hit3 {
                    return (unwrap hit3)
                }
                def v3:EvHandle (new EvHandle())
                v3.body = ev
                v3.identityId = id3
                handles3.remember(v3)
                return v3
            }
            return (EvHandle.object(([] _:string ()) ([] _:EvHandle ())))
        }
        case ev f:EvalValue.Function {
            def id4:int f.identityId
            def c:EvFunctionCore (unwrap f.core)
            if (id4 > 0) {
                def handles4:EvValueHandles (EvValueHandles.__singleton())
                def hit4@(optional):EvHandle (handles4.lookup(id4))
                if hit4 {
                    return (unwrap hit4)
                }
                def v4:EvHandle (new EvHandle())
                v4.body = ev
                v4.identityId = id4
                handles4.remember(v4)
                return v4
            }
            return (EvHandle.nativeFunction(c.functionName))
        }
        case ev m:EvalValue.Map {
            def id5:int m.identityId
            if (id5 > 0) {
                def handles5:EvValueHandles (EvValueHandles.__singleton())
                def hit5@(optional):EvHandle (handles5.lookup(id5))
                if hit5 {
                    return (unwrap hit5)
                }
                def v5:EvHandle (new EvHandle())
                v5.body = ev
                v5.identityId = id5
                handles5.remember(v5)
                return v5
            }
            return (EvHandle.mapEmpty())
        }
        case ev st:EvalValue.Set {
            def id6:int st.identityId
            if (id6 > 0) {
                def handles6:EvValueHandles (EvValueHandles.__singleton())
                def hit6@(optional):EvHandle (handles6.lookup(id6))
                if hit6 {
                    return (unwrap hit6)
                }
                def v6:EvHandle (new EvHandle())
                v6.body = ev
                v6.identityId = id6
                handles6.remember(v6)
                return v6
            }
            return (EvHandle.setEmpty())
        }
        return (EvHandle.undefined())
    }

    sfn array:EvHandle (items:[EvHandle]) {
        def v:EvHandle (new EvHandle())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        ; E4c: dense store on body.Array.items (EvalValue[]).
        def stored:[EvalValue]
        def i:int 0
        while (i < (array_length items)) {
            def it:EvHandle (itemAt items i)
            push stored (it.toStored())
            i = (i + 1)
        }
        v.body = (EvalValue.arrayAt(id stored))
        v.identityId = id
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    ; Empty Map: entries on body.Map.entries.
    sfn mapEmpty:EvHandle () {
        def v:EvHandle (new EvHandle())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvalValue.mapEmptyAt(id))
        v.identityId = id
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    ; Empty Set: items on body.Set.items (insertion order).
    sfn setEmpty:EvHandle () {
        def v:EvHandle (new EvHandle())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvalValue.setEmptyAt(id))
        v.identityId = id
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    sfn object:EvHandle (keys:[string] values:[EvHandle]) {
        def v:EvHandle (new EvHandle())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvalValue.objectAt(id))
        v.identityId = id
        def i:int 0
        while (i < (array_length keys)) {
            if (i < (array_length values)) {
                v.putOwnData((itemAt keys i) (itemAt values i))
            }
            i = (i + 1)
        }
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }
    
    sfn function:EvHandle (fnNode:TSNode) {
        def v:EvHandle (new EvHandle())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvalValue.functionStubAt(id ""))
        v.identityId = id
        v.setFunctionNode(fnNode)
        v.setFnName(fnNode.name)
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    ; D-ERRORS: a function value with no body — an engine-provided constructor
    ; such as TypeError. It is a real function value (typeof === "function", own
    ; identity) so guest code can compare it by reference and read `.name`, but
    ; it has no functionNode, so the call paths that require one skip it and the
    ; engine handles the construction itself.
    sfn nativeFunction:EvHandle (name:string) {
        def v:EvHandle (new EvHandle())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvalValue.functionStubAt(id ""))
        v.identityId = id
        v.setFnName(name)
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    ; D-REGISTRY: a built-in method as a first-class function value. `boundThis`
    ; carries the receiver when the value came from `arr.slice`; it is absent for
    ; the unbound form read off a prototype (`Array.prototype.slice`), which is
    ; exactly the case .call/.apply exist to supply.
    sfn nativeMethod:EvHandle (kind:string name:string) {
        def v:EvHandle (new EvHandle())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvalValue.functionStubAt(id ""))
        v.identityId = id
        def core:EvFunctionCore (v.fnCore())
        core.functionName = name
        core.builtinKind = kind
        core.builtinName = name
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    ; D-STATICS: a built-in STATIC (Object.keys, Math.floor) as a first-class
    ; value. Like nativeMethod it is identified by a pair, but the first half is
    ; the namespace rather than a receiver kind -- a static has no receiver.
    sfn nativeStatic:EvHandle (ns:string name:string) {
        def v:EvHandle (new EvHandle())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvalValue.functionStubAt(id ""))
        v.identityId = id
        def core:EvFunctionCore (v.fnCore())
        core.functionName = name
        core.builtinNamespace = ns
        core.builtinName = name
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    fn isBuiltinStatic:boolean () {
        if (false == (this.isFunction())) {
            return false
        }
        return ((strlen (this.builtinNamespaceOf())) > 0)
    }

    fn isBuiltinMethod:boolean () {
        if (false == (this.isFunction())) {
            return false
        }
        return ((strlen (this.builtinNameOf())) > 0)
    }

    ; A method captured as a value (obj.method): the function node plus the
    ; receiver `this` it is bound to. Invoked like any function value.
    sfn boundMethod:EvHandle (fnNode:TSNode thisVal:EvHandle) {
        def v:EvHandle (new EvHandle())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvalValue.functionStubAt(id ""))
        v.identityId = id
        v.setFunctionNode(fnNode)
        v.setFnName(fnNode.name)
        v.setBoundThis(thisVal)
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    ; D-PROTO: the same function value with a receiver bound. Used when a method
    ; is reached through an object (own property or prototype) so `this` inside
    ; it is the receiver. Copies the closure/provenance fields, which a fresh
    ; boundMethod() would lose — dropping them would re-root the body in the
    ; wrong module scope.
    fn withThis:EvHandle (recv:EvHandle) {
        def v:EvHandle (new EvHandle())
        ; Fresh identity — a bound/rebound function is a distinct reference
        ; (`f.bind(x) !== f`). Reusing the target's identityId made PropertyBag
        ; round-trips (toStored/fromBody) recover the unbound original from
        ; EvValueHandles and drop boundThis.
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvalValue.functionStubAt(id (this.fnName())))
        v.identityId = id
        ; Core is COPIED, not shared. bind() renames (`bound foo`) and rewrites
        ; suppressedKeys on the result; sharing the core would mutate the
        ; original. Binding fields (boundArgs) are copied too; boundThis is
        ; replaced with `recv`. Sharing the core is a later optimisation once
        ; those writes stop touching core.
        def _evBody:EvalValue body
        case _evBody srcF:EvalValue.Function {
            def src:EvFunctionCore (unwrap srcF.core)
            def dst:EvFunctionCore (v.fnCore())
            dst.functionName = src.functionName
            dst.closureId = src.closureId
            dst.homeModule = src.homeModule
            dst.srcText = src.srcText
            dst.builtinKind = src.builtinKind
            dst.builtinName = src.builtinName
            dst.builtinNamespace = src.builtinNamespace
            dst.strictFn = src.strictFn
            if src.functionNode {
                dst.functionNode = (unwrap src.functionNode)
            }
            def srcB:EvFunctionBinding (unwrap srcF.binding)
            def dstB:EvFunctionBinding (v.fnBinding())
            dstB.boundArgs = srcB.boundArgs
        }
        ; Copy own data properties onto the new function's PropertyBag.
        def ks:[string] (this.ownDataKeys())
        for ks kk:string idx {
            v.putOwnData(kk (this.getOwnData(kk)))
        }
        ; Copy suppressed synthesised keys (PropertyBag), same as old FnCore copy.
        v.setSuppressed((this.copySuppressedMap()))
        v.setBoundThis(recv)
        if (this.hasProto()) {
            v.setProto((this.protoOf()))
        }
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    sfn element:EvHandle (el:EVGElement) {
        def v:EvHandle (new EvHandle())
        def id:int ((EvalIdentityMinter.__singleton()).mint())
        v.body = (EvalValue.elementAt(id el))
        v.identityId = id
        def handles:EvValueHandles (EvValueHandles.__singleton())
        handles.remember(v)
        return v
    }

    sfn undefined:EvHandle () {
        def pool:EvalConstPool (EvalConstPool.__singleton())
        return pool.undefinedValue
    }
    
    ; Type checks — kind from body (shape EvalValue).
    ; Copy `body` into a local before calling EvalValue.* — Rust RefCell panics
    ; if the field is borrowed across the shape ops call.
    fn isNull:boolean () {
        def b:EvalValue body
        return (EvalValue.isNull(b))
    }
    
    fn isNumber:boolean () {
        def b:EvalValue body
        return (EvalValue.isNumber(b))
    }
    
    fn isString:boolean () {
        def b:EvalValue body

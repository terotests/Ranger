        if (node.value == "+") { out = (a + b) }
        if (node.value == "-") { out = (a - b) }
        if (node.value == "*") { out = (a * b) }
        if (node.value == "/") { out = (a / b) }
        return (this.exprSlotNumber(node out))
    }

    ; `name op= <expr>` where the target holds a slot number and the right-hand
    ; side evaluates to a number: compute and store without minting a value.
    ; Returns false for every other shape, so the caller falls through to the
    ; general path unchanged.

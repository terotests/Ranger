; =============================================================================
; ComponentEngine.rgr - JSX Component System with Import Support
; =============================================================================
; Extends JSXToEVG with:
; - Component function expansion
; - Expression evaluation in JSX context
; - Variable scope/context management

Import "../../../../../ts_parser/ts_parser_simple.rgr"
Import "../../../../../ts_parser/ts_lexer.rgr"
Import "../../../../../ts_parser/ts_ast_patch.rgr"
Import "../../../evg/EVGElement.rgr"
Import "EvalValue.rgr"
Import "Regex.rgr"
Import "DateTime.rgr"
Import "../../../imaging/jpeg/JPEGMetadata.rgr"

; =============================================================================
; ImportedSymbol - Represents an imported component or function
; =============================================================================
class ImportedSymbol {
    def name:string ""           ; Local name in current file
    def originalName:string ""   ; Name in source file
    def sourcePath:string ""     ; File path
    def symbolType:string ""     ; "component" | "function" | "constant"
    def functionNode@(optional):TSNode      ; AST node for function components
    def helperFunctions:[TSNode] ; Helper functions defined in the same file
}

; Parsed import AST retained across loadScript() so shared modules (e.g. a
; game's *_shared.tsx) are not re-lexed/re-parsed on every level transition.
; Keyed by absolute path + mtime; materialize still runs into the new moduleScope.
class CachedImportAst {
    def path:string ""
    def mtime:int 0
    def ast:TSNode (new TSNode())
    def dirPath:string ""
    def relativePath:string ""
}

; =============================================================================
; EvalContext - Variable scope for expression evaluation
; =============================================================================
class EvalContext {
    def bindings:[string:EvalValue]
    ; The names this frame owns a private value SLOT for: hoisted `var`s whose
    ; body scan proved their value object never escapes the frame. Filled once
    ; per call from the memo on the body node. A name in here may have its
    ; number written in place; every other name keeps the mint-a-replacement
    ; semantics, which is what aliases rely on.
    def slotNames:[string:boolean]
    ; D-WITH: `with (o) { ... }` puts an OBJECT at the front of the scope chain.
    ; A name is looked up as a property of that object before the ordinary
    ; bindings, and assignment to a name the object owns writes through to it.
    def withObject@(optional):EvalValue
    def parent@(optional):EvalContext
    ; Root module scope for this script (propagated to child scopes).
    def moduleRoot@(optional):EvalContext
    ; D-GLOBALTHIS: true only for the scope that IS a script's global scope. A
    ; var bound there is also a property of the global object; a var of the same
    ; name bound anywhere else is not, so the two have to be told apart before a
    ; write is mirrored.
    def isGlobalScope:boolean false
    ; D-CATCHVAR: true for a scope that exists only for a BLOCK construct --
    ; a catch clause's parameter or a `with` object. `var` is function-scoped,
    ; so a declaration inside one of these belongs to the enclosing function
    ; scope and stays visible after the block ends; only the catch parameter
    ; itself lives here.
    def isBlockScope:boolean false

    ; The scope a `var` declared here actually binds in: the nearest enclosing
    ; scope that is not a catch/with block.
    fn varScope:EvalContext () {
        if isBlockScope {
            if parent {
                def p:EvalContext (unwrap parent)
                return (p.varScope())
            }
        }
        return this
    }

    ; D-CATCHVAR: does a block scope between here and the var scope already own
    ; this name? `catch (e) { var e = 1 }` writes the CATCH PARAMETER -- the
    ; function-scoped `e` the hoist created stays undefined.
    fn blockShadowsName:boolean (name:string) {
        if (false == isBlockScope) {
            return false
        }
        if (has bindings name) {
            return true
        }
        if parent {
            def p:EvalContext (unwrap parent)
            return (p.blockShadowsName(name))
        }
        return false
    }

    fn define:void (name:string value:EvalValue) {
        set bindings name value
    }

    ; D-HOIST: is the name bound in THIS scope, ignoring the chain? Hoisting
    ; must not clobber a binding the frame already made (a parameter, say).
    fn hasOwnBinding:boolean (name:string) {
        return (has bindings name)
    }
    
    ; D-WITH: the nearest `with` object that owns this name, counting ACCESSOR
    ; properties -- an object whose `x` is a getter still shadows the binding
    ; beneath it, and only the engine can invoke the getter, so the search and
    ; the call are split between here and there.
    fn findWithObjectFor:EvalValue (name:string) {
        if withObject {
            def wo:EvalValue (unwrap withObject)
            if (has wo.objectMap name) {
                return wo
            }
            if (has wo.getterMap name) {
                return wo
            }
            if (has wo.setterMap name) {
                return wo
            }
        }
        if (has bindings name) {
            return (EvalValue.null())
        }
        if parent {
            def p:EvalContext (unwrap parent)
            return (p.findWithObjectFor(name))
        }
        return (EvalValue.null())
    }

    ; The scope that OWNS this name, or null when nothing up the chain does.
    ; An assignment resolves its reference before the right-hand side runs, so
    ; the target scope has to be captured then rather than looked up after --
    ; the RHS may create a nearer binding (an eval can), and the write must
    ; still land on the one the reference named.
    fn ownsBinding:boolean (name:string) {
        return (has bindings name)
    }

    fn contextOwning:EvalContext (name:string) {
        if (has bindings name) {
            return this
        }
        if parent {
            def p:EvalContext (unwrap parent)
            return (p.contextOwning(name))
        }
        ; Nothing up the chain owns it; the caller checks ownsBinding first, so
        ; this only answers for a name that IS bound somewhere.
        return this
    }

    fn lookup:EvalValue (name:string) {
        ; D-WITH: the object scope shadows the bindings beneath it.
        if withObject {
            def wo:EvalValue (unwrap withObject)
            if (has wo.objectMap name) {
                return (unwrap (get wo.objectMap name))
            }
        }
        ; Single map probe (avoids a second hasOwnProperty via `has` + `get`).
        def found@(optional):EvalValue (get bindings name)
        if found {
            return (unwrap found)
        }
        ; Check parent scope (function locals -> outer -> … -> module root)
        if parent {
            def p:EvalContext (unwrap parent)
            return (p.lookup(name))
        }
        return (EvalValue.null())
    }

    ; Update an existing binding in the nearest enclosing scope that owns it.
    ; Returns false when the name is not declared anywhere up the parent chain.
    fn assignExisting:boolean (name:string value:EvalValue) {
        ; D-WITH: writing a name the object owns updates the OBJECT, which is
        ; the whole observable point of `with`.
        if withObject {
            def wo:EvalValue (unwrap withObject)
            if (has wo.objectMap name) {
                wo.setMember(name value)
                return true
            }
        }
        ; One lookup, not the has-then-set pair: this walks the scope chain on
        ; every assignment to an existing variable.
        if (RangerMem.mapPutIfPresent(bindings name value)) {
            return true
        }
        if parent {
            def p:EvalContext (unwrap parent)
            return (p.assignExisting(name value))
        }
        return false
    }

    ; Assign to an existing binding (walking parents); if undeclared, create it
    ; in the current scope. Prevents module-level vars from being shadowed by a
    ; new local binding when reassigned from inside a function body.
    fn assign:void (name:string value:EvalValue) {
        if (this.assignExisting(name value)) {
            return
        }
        this.define(name value)
    }

    ; Remove a binding from the nearest scope that owns it (parent chain walk).
    fn removeBinding:boolean (name:string) {
        if (has bindings name) {
            def newBindings:[string:EvalValue]
            def keyList:[string] (keys bindings)
            for keyList kk:string idx {
                if (kk != name) {
                    set newBindings kk (unwrap (get bindings kk))
                }
            }
            bindings = newBindings
            return true
        }
        if parent {
            def p:EvalContext (unwrap parent)
            return (p.removeBinding(name))
        }
        return false
    }
    
    fn moduleScope:EvalContext () {
        if moduleRoot {
            return (unwrap moduleRoot)
        }
        return this
    }
    
    fn has:boolean (name:string) {
        if withObject {
            def wo:EvalValue (unwrap withObject)
            if (has wo.objectMap name) {
                return true
            }
        }
        if (has bindings name) {
            return true
        }
        if parent {
            def p:EvalContext (unwrap parent)
            return (p.has(name))
        }
        return false
    }

    ; PERF: ++/-- on a plain NUMBER binding in one walk. Returns the OLD
    ; value when it applied; ABSENT when the name is missing here, shadowed
    ; by a with-object, or bound to a non-number — the caller falls back to
    ; the full read-convert-write path. The binding is REPLACED, never
    ; mutated, so aliases keep the old immutable number.
    ; Update the binding's number IN PLACE when nothing but this scope's own
    ; map holds it. `i++` in a loop header writes the same binding every time
    ; and its result is discarded, so the replacement object it used to mint was
    ; pure waste -- one allocation per iteration, the last one left in an empty
    ; loop. The uniqueness test runs inside the runtime, where no local holds
    ; the value, so a pooled small integer or a value a second binding aliases
    ; is rejected by its reference count and takes the allocating path below.
    ; Returns false when the fast path does not apply.
    ; The runtime test above can only be answered by a reference-counted
    ; runtime, so on every target but LLVM it says "cannot tell" and the loop
    ; keeps allocating. The STATIC answer needs no refcount and holds on all of
    ; them: if the body scan proved this name's value object never leaves the
    ; frame, this frame's slot is its only holder by construction.
    ;
    ; The first write still MINTS, because the binding may be holding a value it
    ; does not own -- `var i = 0` binds the pooled literal `0`, shared by every
    ; occurrence of that constant in every script, and writing through it would
    ; corrupt all of them. The minted replacement is stamped `slotOwned` and
    ; every write after it lands in place, so a loop pays one allocation for the
    ; whole run rather than one per iteration.
    fn bumpNumberInSlot:boolean (name:string delta:double) {
        def cur@(optional):EvalValue (get bindings name)
        if cur {
            def c:EvalValue (unwrap cur)
            if (c.valueType == 1) {
                if c.slotOwned {
                    c.numberValue = (c.numberValue + delta)
                    return true
                }
                ; rawNumber, not number: the pooling factory hands back the
                ; SHARED small-integer object, and stamping that `slotOwned`
                ; would licence every later `i++` to rewrite the constant `1`
                ; for the whole program. A slot's value must be private.
                def fresh:EvalValue (EvalValue.rawNumber((c.numberValue + delta)))
                fresh.slotOwned = true
                set bindings name fresh
                return true
            }
        }
        return false
    }

    fn bumpNumberInPlace:boolean (name:string delta:double) {
        if withObject {
            return false
        }
        if (has slotNames name) {
            return (this.bumpNumberInSlot(name delta))
        }
        ; mapValueUnique already answers false for a key this scope does not
        ; hold, so the separate `has` probe it used to sit behind was a third
        ; lookup for one decision.
        if (RangerMem.mapValueUnique(bindings name)) {
            def cur@(optional):EvalValue (get bindings name)
            if cur {
                def c:EvalValue (unwrap cur)
                if (c.valueType == 1) {
                    c.numberValue = (c.numberValue + delta)
                    return true
                }
            }
            return false
        }
        if (has bindings name) {
            return false
        }
        if parent {
            def p:EvalContext (unwrap parent)
            return (p.bumpNumberInPlace(name delta))
        }
        return false
    }

    fn bumpNumberOld@(optional):EvalValue (name:string delta:double) {
        if withObject {
            def noneW@(optional):EvalValue
            return noneW
        }
        def cur@(optional):EvalValue (get bindings name)
        if cur {
            def c:EvalValue (unwrap cur)
            if (c.valueType == 1) {
                set bindings name (EvalValue.number((c.numberValue + delta)))
                return cur
            }
            def noneT@(optional):EvalValue
            return noneT
        }
        if parent {
            def p:EvalContext (unwrap parent)
            return (p.bumpNumberOld(name delta))
        }
        def noneM@(optional):EvalValue
        return noneM
    }

    ; PERF: single-probe read. The has-then-lookup pair walked the scope
    ; chain twice, hashing the name at every level both times; the missing
    ; case here is an ABSENT optional, so callers pay one walk.
    ; Read a name at a KNOWN depth: the resolution memo an identifier node
    ; carries. Verified rather than trusted -- the scope at that depth must
    ; actually hold the name, or the caller falls back to the full walk. The
    ; check costs one probe and makes a stale memo impossible to observe, which
    ; matters because the chain shape is only stable while no `with` or direct
    ; `eval` is in play.
    fn tryLookupAtDepth@(optional):EvalValue (name:string hops:int) {
        if (hops <= 0) {
            if withObject {
                def noneW@(optional):EvalValue
                return noneW
            }
            return (get bindings name)
        }
        if parent {
            def p:EvalContext (unwrap parent)
            return (p.tryLookupAtDepth(name (hops - 1)))
        }
        def noneD@(optional):EvalValue
        return noneD
    }

    ; The number of parent hops at which `name` resolves, or -1. Walked once
    ; per identifier NODE and then memoised on it.
    fn depthOfBinding:int (name:string) {
        if withObject {
            return (0 - 1)
        }
        if (has bindings name) {
            return 0
        }
        if parent {
            def p:EvalContext (unwrap parent)
            def d:int (p.depthOfBinding(name))
            if (d < 0) {
                return d
            }
            return (d + 1)
        }
        return (0 - 1)
    }

    fn tryLookup@(optional):EvalValue (name:string) {
        if withObject {
            def wo:EvalValue (unwrap withObject)
            if (has wo.objectMap name) {
                def whit@(optional):EvalValue (get wo.objectMap name)
                return whit
            }
        }
        def found@(optional):EvalValue (get bindings name)
        if found {
            return found
        }
        if parent {
            def p:EvalContext (unwrap parent)
            return (p.tryLookup(name))
        }
        def missing@(optional):EvalValue
        return missing
    }
    
    ; Create child context (for function calls). Inherits moduleRoot so nested
    ; functions always resolve module-level const/let/array/object bindings.
    fn createChild:EvalContext () {
        def child (new EvalContext())
        child.parent = this
        if moduleRoot {
            child.moduleRoot = moduleRoot
        } {
            child.moduleRoot = this
        }
        return child
    }
}

; Reference holder for a captured closure scope. Stored in an array by index;
; wrapping the EvalContext behind an optional field keeps the array element a
; simple pointer (avoids Ranger deep-copying EvalContext's maps on push).
class ClosureCell {
    def ctx@(optional):EvalContext
}

; Optional host-native functions callable from evaluated scripts (loadGame, etc.).
class EvalNativeBridge {
    fn has:boolean (name:string) {
        return false
    }
    fn invoke:EvalValue (name:string args:[EvalValue]) {
        return (EvalValue.null())
    }
}

; =============================================================================
; ComponentEngine - Main engine for JSX processing with components
; =============================================================================
class ComponentEngine {
    def parser:TSParserSimple
    ; When false, scripts are parsed in non-JSX mode: `<` is only comparison /
    ; type-cast, never a JSX tag. Set false to run .as (AssemblyScript) sources.
    def jsxParsing:boolean true
    ; compiled regex programs, keyed flags:source (flags never contain ':')
    def regexProgCache:[string:RegexProgram]
    def source:string ""
    ; D-FNSRC: the source text the code being evaluated RIGHT NOW was parsed
    ; from. `source` is the main script and stays that; this one swaps for the
    ; duration of an eval / Function() body / imported file, so a function value
    ; captured in there records the string its own start/end offsets index into.
    def currentSource:string ""
    ; D-DATE: the realm's clock, in milliseconds since the epoch. Nothing in the
    ; interpreter reads a host clock -- doing so would make every Date result
    ; irreproducible and would tie the realm to one compilation target -- so
    ; `Date.now()` and `new Date()` report this, and an embedder that wants a
    ; moving clock advances it.
    def hostNowMs:double 0.0
    ; D-GLOBALTHIS: the script's var-and-function names, which are properties of
    ; the global object as well as bindings. Recorded so a later assignment can
    ; keep the two in step; let/const are not here, and are not properties.
    ; syncGlobalVar runs on EVERY identifier assignment, so "is this one of them"
    ; has to be a map probe rather than a scan of a list.
    def globalVarSet:[string:boolean]
    ; D-DELETE: names brought into being by ASSIGNMENT to an undeclared name.
    ; Those are configurable properties of the global object, so `delete x` on
    ; one succeeds; a declared `var`/function binding is non-configurable and
    ; `delete` answers false. Nothing else in the engine distinguishes the two.
    def implicitGlobalSet:[string:boolean]
    ; D-COMPLETION: the value a Statement completes with, which is what `eval`
    ; returns. Only an ExpressionStatement produces one; every other kind
    ; completes EMPTY and leaves the previous value standing, which is exactly
    ; why `eval("if (true) { 42; }")` is 42 and `eval("var x = 1;")` is
    ; undefined. Tracking it on the statement runner rather than at the top
    ; level is what makes a value produced INSIDE a loop or an if reach eval.
    def completionValue:EvalValue (EvalValue.undefined())
    def basePath:string "./"
    def assetPaths:[string]  ; Multiple asset directories for component resolution
    def pageWidth:double 595.0
    def pageHeight:double 842.0
    
    ; Print settings for hooks
    def printFormat:string "a4"
    def printOrientation:string "portrait"
    def printMarginTop:double 0.0
    def printMarginRight:double 0.0
    def printMarginBottom:double 0.0
    def printMarginLeft:double 0.0
    def printPageCount:int 1
    
    ; Import/export tracking
    def imports:[ImportedSymbol]
    def localComponents:[ImportedSymbol]
    
    ; Track all loaded files for file watching
    def loadedFiles:[string]
    ; Canonical import paths currently loading / fully materialized (cycle guard).
    def importLoading:[string]
    def importLoaded:[string]
    ; registered virtual `ranger:*` packages (name/source pairs) + load-once set
    def virtualModuleNames:[string]
    def virtualModuleSrcs:[string]
    def virtualModulesLoaded:[string]
    ; Per-module isolation state (D-MODULES). Each loaded virtual module owns an
    ; EvalContext parented on hostScope ONLY — module bindings never land in the
    ; entry script's scope and the entry scope is invisible to module code. The
    ; scope is held through closureScopes (ClosureCell) by id, because pushing an
    ; EvalContext into an array directly would deep-copy its binding maps.
    def moduleScopeNames:[string]
    def moduleScopeIds:[int]
    ; Class declarations of virtual modules, keyed "<module>::<ClassName>" —
    ; deliberately NOT the engine-wide `classes` map, so two modules may export
    ; the same class name without clobbering and un-imported classes stay
    ; unreachable from the entry script.
    def moduleClasses:[string:TSNode]
    ; The module whose code is currently executing ("" = entry script). Saved and
    ; restored around every boundary crossing (module load, function/method call,
    ; construction); bare-name `new X()` resolves against the current module.
    def currentModule:string ""
    ; Survives loadScript(): skip tokenize+parse when path mtime is unchanged.
    def importAstCache:[CachedImportAst]
    
    ; Evaluation context
    def context:EvalContext
    ; Host-injected globals (registerGlobal) — survives loadScript resets.
    def hostScope:EvalContext
    ; Top-level script bindings (const/let/functions) — reset per loadScript.
    def moduleScope:EvalContext
    ; Optional bridge for host-native script calls (game engine navigation, I/O).
    def nativeBridge@(optional):EvalNativeBridge
    
    ; Primitive EVG elements (not components)
    def primitives:[string]

    ; Value-returning control flow: set when a `return` executes while running a
    ; statement list, so returns inside if/else and nested blocks propagate the
    ; returned value out of the function (not just JSX). Saved/restored per
    ; function body so nested calls are reentrancy-safe.
    def scriptDidReturn:boolean false
    def scriptReturnValue:EvalValue (EvalValue.null())
    def loopBreak:boolean false
    def loopContinue:boolean false
    ; D-LABELS: `break label` / `continue label` name a statement further out
    ; than the nearest loop, so the flag alone cannot say where it stops. The
    ; NAME travels with the flag; "" means the nearest enclosing loop (or
    ; switch, for break), which is the unlabelled form.
    def breakLabel:string ""
    def continueLabel:string ""
    ; Labels attached to the statement about to run. A loop TAKES them as its
    ; own on entry and clears the list, so a statement nested inside it does not
    ; inherit them. A chain -- `a: b: for (...)` -- collects both.
    def pendingLabels:[string]
    ; Exception state: `throw` sets scriptThrew + scriptThrowValue; it unwinds
    ; statement lists, loops and calls (like a pending return) until a try/catch
    ; clears it. Kept separate from scriptDidReturn so a catch can resume.
    def scriptThrew:boolean false
    def scriptThrowValue:EvalValue (EvalValue.null())
    ; D-ERRORS: the engine-provided error constructors are seeded lazily, once,
    ; so that `thrown.constructor === TypeError` holds by reference.
    def errorCtorsReady:boolean false
    ; D-STRICT: whether the code currently running is strict. Set from a
    ; "use strict" prologue on the program or on a function body, saved and
    ; restored around every call.
    ;
    ; Deliberate approximation: strictness propagates DYNAMICALLY, so a function
    ; declared in sloppy code but CALLED from strict code runs strict, where the
    ; spec makes it lexical. Getting that exactly right means stamping each
    ; function value with the strictness of the scope that created it. The
    ; dynamic rule is right for every nesting -- which is what the suite is
    ; written as -- and wrong only for a callback that crosses the boundary
    ; outward.
    def strictMode:boolean false
    ; D-TOPRIMITIVE: whether the last callPrimitiveMethod actually ran a method
    ; and got a primitive back. Needed because "no usable method" and "the
    ; method returned undefined" are both null-shaped in this engine.
    def primitiveMethodUsable:boolean false
    ; D-STRICT: how many guest function frames are on the stack. Top-level `this`
    ; is the global object even under a strict program, so "am I inside a call"
    ; has to be answerable separately from "am I strict".
    def callDepth:int 0
    ; D-BUILTINPROTO: one prototype object per built-in constructor name, kept
    ; for the engine's lifetime so identity and stored properties survive reads.
    def builtinProtos:[string:EvalValue]
    ; D-GLOBALOBJ: one object per built-in global name (Math, JSON, Array, ...),
    ; so the name resolves to something real rather than undefined.
    def builtinGlobals:[string:EvalValue]
    ; D-REGISTRY: one shared value per (receiver kind, method name), so a
    ; built-in method read twice is the SAME value.
    def nativeMethodCache:[string:EvalValue]
    ; D-GLOBALTHIS: the global object. Top-level `this` is bound to it, and a
    ; property written through it (`this.p1 = 1`) becomes a global binding --
    ; which is how a large family of sloppy-script tests declares its fixtures.
    def globalObject@(optional):EvalValue
    ; D-CLASSEXPR: counter for generated class-expression table keys.
    def classExprSeq:int 0
    ; When true (the spec default) an unresolvable identifier read is a
    ; ReferenceError and calling a non-function is a TypeError, instead of
    ; silently evaluating to null. Kept as a switch because the failure mode it
    ; replaces — silence — is what made whole test corpora pass vacuously.
    def strictReferences:boolean true

    ; Lexical-closure registry: a function/arrow value carries an integer
    ; closureId into this map, which holds the scope it was defined in, so a
    ; returned/stored closure resolves free variables against its definition
    ; environment rather than the call site.
    ; Indexed by closureId; append-only so the id stays a stable index.
    def closureScopes:[ClosureCell]

    ; Cursor state for the recursive-descent JSON.parse (jsonParseValue advances
    ; jsonPos over jsonSrc). Only valid during a JSON.parse call.
    def jsonSrc:string ""
    def jsonPos:int 0
    ; D-JSON: whether the current JSON.parse hit a grammar error, and what to say.
    def jsonFailed:boolean false
    def jsonError:string ""
    ; D-ARGUMENTS: the function VALUE whose call is being set up, so `arguments`
    ; can carry a `callee` that compares equal to the function by identity. A
    ; freshly minted value would have a new identity and fail that comparison,
    ; which is the whole point of the property.
    def pendingCallee@(optional):EvalValue
    def pendingCalleeValid:boolean false
    ; D-ARGMAP: the call scopes a sloppy `arguments` object is MAPPED onto. An
    ; index below the declared parameter count is the same binding as the named
    ; parameter, in both directions, and there is nowhere on an EvalValue to put
    ; a scope -- so the object carries an index into this list instead.
    def argMapScopes:[ClosureCell]
    ; PERF: has a `with` scope ever existed in this realm? `with` puts an object
    ; at the front of the scope chain, so EVERY identifier read has to ask
    ; whether one owns the name -- a full chain walk, on the hottest path there
    ; is. Almost no program uses `with`; this makes the question free for those.
    def anyWithScope:boolean false

    ; When true, suppress verbose evaluation trace (game scripts, tests).
    def quiet:boolean false

    ; Safety cap on while/for/do iterations. The default keeps runaway guest
    ; scripts from hanging the host; Octane-scale benches (and any other
    ; long-running correct loop) raise it on the instance before loadScript.
    def maxLoopIterations:int 100000

    ; When true, Date.now() / new Date() read the host wall clock
    ; (`wall_clock_ms`) instead of the frozen hostNowMs. Off by default so
    ; conformance stays reproducible; Octane benches turn it on.
    def liveClock:boolean false
    ; Origin for liveClock readings. On targets where truncD goes through a
    ; 32-bit int (C++), absolute epoch ms overflow; we therefore report
    ; milliseconds since the first live read (plus a small bias), which is
    ; enough for Octane's `new Date() - start` deltas.
    def liveClockOriginMs:double -1.0

    ; User class declarations by name (ClassDeclaration nodes), so `new C()` can
    ; instantiate + init fields and instance method calls can dispatch with a
    ; bound `this`. Enables fluent OO guest code (e.g. an animation builder).
    def classes:[string:TSNode]

    ; Parsed program AST kept for in-process hot reload (patchScript).
    def programAst@(optional):TSNode
    def astPatcher:TSAstPatcher (new TSAstPatcher())
    
    ; Realm clock for Date. Frozen hostNowMs unless liveClock is set.
    fn realmNowMs:double () {
        if liveClock {
            def now:double (wall_clock_ms)
            if (liveClockOriginMs < 0.0) {
                liveClockOriginMs = now
            }
            return (((now - liveClockOriginMs) + 1000.0))
        }
        return hostNowMs
    }

    fn trace:void (msg:string) {
        if (quiet == false) {
            print msg
        }
    }
    
    Constructor () {
        def p:TSParserSimple (new TSParserSimple())
        parser = p
        parser.tsxMode = true
        def imp:[ImportedSymbol]
        imports = imp
        def loc:[ImportedSymbol]
        localComponents = loc
        def css:[ClosureCell]
        closureScopes = css
        def lf:[string]
        loadedFiles = lf
        def il:[string]
        importLoading = il
        def id:[string]
        importLoaded = id
        def iac:[CachedImportAst]
        importAstCache = iac
        def host:EvalContext (new EvalContext())
        host.moduleRoot = host
        hostScope = host
        def mod:EvalContext (new EvalContext())
        mod.parent = hostScope
        mod.moduleRoot = mod
        moduleScope = mod
        context = mod
        def prim:[string]
        primitives = prim
        def ap:[string]
        assetPaths = ap
        
        ; Register primitive element names
        push primitives "View"
        push primitives "Label"
        push primitives "Print"
        push primitives "Section"
        push primitives "Page"
        push primitives "Image"
        push primitives "Path"
        push primitives "Spacer"
        push primitives "Divider"
        push primitives "Layer"
        push primitives "div"
        push primitives "span"
        push primitives "p"
        push primitives "h1"
        push primitives "h2"
        push primitives "h3"
        push primitives "img"
        push primitives "path"
        push primitives "layer"
    }
    
    ; ==========================================================================
    ; Asset Path Management
    ; ==========================================================================
    
    ; Append a single directory searched for bare imports (e.g. "game_helpers").
    fn addAssetPath:void (path:string) {
        if ((strlen path) == 0) {
            return
        }
        def i:int 0
        while (i < (array_length assetPaths)) {
            if ((itemAt assetPaths i) == path) {
                return
            }
            i = i + 1
        }
        push assetPaths path
    }

    ; Set multiple asset directories from semicolon-separated string
    ; Example: "./Fonts;./components;./images"
    fn setAssetPaths:void (paths:string) {
        ; Split by semicolon
        def start:int 0
        def i:int 0
        def len:int (strlen paths)
        while (i <= len) {
            def ch:string ""
            if (i < len) {
                ch = (substring paths i (i + 1))
            }
            if ((ch == ";") || (i == len)) {
                if (i > start) {
                    def part:string (substring paths start i)
                    push assetPaths part
                    print ("ComponentEngine: Added asset path: " + part)
                }
                start = i + 1
            }
            i = i + 1
        }
    }
    
    ; Resolve a component file path, searching asset directories
    fn resolveComponentPath:string (relativePath:string) {
        ; First try relative to basePath (current file's directory)
        def fullPath:string (basePath + relativePath)
        ; For now just return the basePath-relative path
        ; In future, could check file existence in each asset path
        
        ; Try each asset path
        def i:int 0
        while (i < (array_length assetPaths)) {
            def assetDir:string (itemAt assetPaths i)
            ; Could check if file exists here
            i = i + 1
        }
        
        return fullPath
    }
    
    ; Get list of all loaded files (main file + imports) for file watching
    fn getLoadedFiles:[string] () {
        return loadedFiles
    }

    fn normalizeDirPath:string (dirPath:string) {
        if ((strlen dirPath) == 0) {
            return "./"
        }
        def last:int (strlen dirPath)
        def lastCh:string (substring dirPath (last - 1) last)
        if (lastCh != "/") {
            return (dirPath + "/")
        }
        return dirPath
    }

    ; Directory prefix of a resolved module path (e.g. "import_fixtures/mid.tsx" → "import_fixtures/").
    fn dirnameOfModulePath:string (fullPath:string) {
        def lastSlash:int -1
        def i:int 0
        while (i < (strlen fullPath)) {
            def ch:string (substring fullPath i (i + 1))
            if (ch == "/") {
                lastSlash = i
            }
            i = i + 1
        }
        if (lastSlash < 0) {
            return ""
        }
        return (substring fullPath 0 (lastSlash + 1))
    }

    fn moduleDirFromRead:string (searchDir:string fullPath:string) {
        def subDir:string (this.dirnameOfModulePath(fullPath))
        return (this.normalizeDirPath(searchDir + subDir))
    }

    fn isInStringList:boolean (value:string list:[string]) {
        def i:int 0
        while (i < (array_length list)) {
            if ((itemAt list i) == value) {
                return true
            }
            i = i + 1
        }
        return false
    }

    fn listWithoutString:[string] (list:[string] value:string) {
        def out:[string]
        def i:int 0
        while (i < (array_length list)) {
            def item:string (itemAt list i)
            if (item != value) {
                push out item
            }
            i = i + 1
        }
        return out
    }

    fn listWithStringIfMissing:[string] (list:[string] value:string) {
        if (this.isInStringList(value list)) {
            return list
        }
        def out:[string]
        def i:int 0
        while (i < (array_length list)) {
            push out (itemAt list i)
            i = i + 1
        }
        push out value
        return out
    }

    fn clearImportState:void () {
        def empty:[string]
        importLoading = empty
        importLoaded = empty
    }

    fn resetParseState:void () {
        def scope:EvalContext (new EvalContext())
        scope.parent = hostScope
        scope.moduleRoot = scope
        scope.isGlobalScope = true
        moduleScope = scope
        context = scope
        def freshGlobalVars:[string:boolean]
        globalVarSet = freshGlobalVars
        this.clearLocalComponents()
        this.clearImportState()
        def emptyFiles:[string]
        loadedFiles = emptyFiles
    }

    fn upsertLocalComponent:void (sym:ImportedSymbol) {
        def i:int 0
        while (i < (array_length localComponents)) {
            def existing:ImportedSymbol (itemAt localComponents i)
            if (existing.name == sym.name) {
                existing.functionNode = sym.functionNode
                existing.originalName = sym.originalName
                existing.sourcePath = sym.sourcePath
                existing.symbolType = sym.symbolType
                existing.helperFunctions = sym.helperFunctions
                return
            }
            i = i + 1
        }
        push localComponents sym
    }

    fn removeLocalComponentByName:void (name:string) {
        def out:[ImportedSymbol]
        def i:int 0
        while (i < (array_length localComponents)) {
            def sym:ImportedSymbol (itemAt localComponents i)
            if (sym.name != name) {
                push out sym
            }
            i = i + 1
        }
        localComponents = out
    }

    fn localNameForImport:string (exportName:string exportNames:[string] localNames:[string]) {
        def i:int 0
        while (i < (array_length exportNames)) {
            if ((itemAt exportNames i) == exportName) {
                return (itemAt localNames i)
            }
            i = i + 1
        }
        return exportName
    }

    fn bindImportedFunction:void (exportName:string localName:string fnNode:TSNode helperFns:[TSNode] sourcePath:string) {
        def sym (new ImportedSymbol())
        sym.name = localName
        sym.originalName = exportName
        sym.sourcePath = sourcePath
        sym.symbolType = "component"
        sym.functionNode = fnNode
        sym.helperFunctions = helperFns
        this.upsertLocalComponent(sym)
        def __fnv:EvalValue (EvalValue.function(fnNode))
        __fnv.strictFn = (this.strictForBody(fnNode))
        __fnv.srcText = currentSource
        this.defineModuleBinding(localName __fnv)
        this.trace("Imported: " + localName + " (" + exportName + ") from " + sourcePath)
    }

    fn rebindImportDeclaration:void (node:TSNode) {
        def exportNames:[string]
        def localNames:[string]
        def j:int 0
        while (j < (array_length node.children)) {
            def spec:TSNode (itemAt node.children j)
            if (spec.nodeType == "ImportSpecifier") {
                if (spec.kind != "type") {
                    def exportName:string spec.name
                    def localName:string spec.name
                    if ((strlen spec.value) > 0) {
                        localName = spec.value
                    }
                    push exportNames exportName
                    push localNames localName
                }
            }
            if (spec.nodeType == "ImportDefaultSpecifier") {
                push exportNames "default"
                push localNames spec.name
            }
            j = j + 1
        }
        def k:int 0
        while (k < (array_length exportNames)) {
            def exportName:string (itemAt exportNames k)
            def localName:string (itemAt localNames k)
            def existing:EvalValue (moduleScope.lookup(exportName))
            if (existing.isFunction()) {
                if (null? existing.functionNode) {
                } {
                    def fnNode:TSNode (unwrap existing.functionNode)
                    def emptyHelpers:[TSNode]
                    this.bindImportedFunction(exportName localName fnNode emptyHelpers "")
                }
            } {
                if (false == (existing.isNull())) {
                    this.defineModuleBinding(localName existing)
                }
            }
            k = k + 1
        }
    }
    
    ; ==========================================================================
    ; Main Entry Points
    ; ==========================================================================
    
    fn parseFile:EVGElement (dirPath:string fileName:string) {
        this.resetParseState()
        this.setBasePath(dirPath)
        
        ; Track main file for watching
        def mainFilePath:string (basePath + fileName)
        push loadedFiles mainFilePath
        
        def fileContent:buffer (buffer_read_file dirPath fileName)
        def src:string (buffer_to_string fileContent)
        return (this.parse(src))
    }

    ; Set the directory used to resolve relative `import "./module"` paths.
    ; GameRunner calls this before loadScript() when loading from disk.
    fn setBasePath:void (dirPath:string) {
        basePath = dirPath
        if ((strlen dirPath) > 0) {
            def last:int (strlen dirPath)
            def lastCh:string (substring dirPath (last - 1) last)
            if (lastCh != "/") {
                basePath = (dirPath + "/")
            }
        }
    }
    
    fn parse:EVGElement (src:string) {
        this.resetParseState()
        source = src
        currentSource = src
        
        ; Tokenize and parse
        def lexer (new TSLexer(src))
        def tokens:[Token] (lexer.tokenize())
        parser.initParser(tokens)
        parser.tsxMode = jsxParsing
        def ast:TSNode (parser.parseProgram())
        
        ; 1. Process imports - load external components
        this.processImports(ast)
        
        ; 2. Register local components (function declarations)
        this.registerComponents(ast)
        
        ; 3. Process top-level variable declarations
        this.processVariables(ast)
        
        ; 4. Find and evaluate render() function
        def renderFn:TSNode (this.findRenderFunction(ast))
        if (renderFn.nodeType == "") {
            print "Error: No render() function found"
            def empty (new EVGElement())
            return empty
        }
        
        ; 5. Evaluate render function and return EVG tree
        return (this.evaluateFunction(renderFn))
    }

    ; ==========================================================================
    ; Scripting API (game engine / host integration)
    ; --------------------------------------------------------------------------
    ; These let a Ranger host inject globals into the evaluation namespace and
    ; drive a loaded script by calling its functions - the foundation for a
    ; script-driven game screen layer (see gallery/game_engine/scripting).
    ; ==========================================================================

    ; Inject a global binding (object/function/value) into the top-level scope
    ; so evaluated scripts can reference it by name, e.g. registerGlobal("game",
    ; EvalValue.object(...)) exposes `game` to the script.
    fn registerGlobal:void (name:string value:EvalValue) {
        hostScope.define(name value)
    }

    fn removeGlobal:void (name:string) {
        hostScope.removeBinding(name)
    }

    fn setNativeBridge:void (bridge:EvalNativeBridge) {
        nativeBridge = bridge
    }

    ; ---- virtual modules (D-MODULES, interpreter profile) -------------------
    ; A `ranger:*` import is not a file: the host registers each package's
    ; guest-side source once, and an `import ... from "ranger:x"` evaluates that
    ; registered source exactly once per engine — in its OWN module scope
    ; (parented on hostScope only). Nothing leaks: the entry script reaches a
    ; module's bindings solely through its import clause (named imports /
    ; `import * as NS` namespace, member-new through the namespace), and module
    ; code never sees entry bindings. Un-imported packages are NOT injected:
    ; dependencies are explicit. This satisfies the RgModuleSystem rules pinned
    ; by interp/module_isolation: per-import namespace, no clobber, cached
    ; single evaluation per engine/realm.
    fn registerVirtualModule:void (name:string src:string) {
        virtualModuleNames = (this.listWithStringIfMissing(virtualModuleNames name))
        push virtualModuleSrcs src
    }

    fn virtualModuleSource:string (name:string) {
        def n:int (array_length virtualModuleNames)
        def i:int 0
        while (i < n) {
            if ((itemAt virtualModuleNames i) == name) {
                return (itemAt virtualModuleSrcs i)
            }
            i = i + 1
        }
        return ""
    }

    ; The isolated scope a loaded virtual module evaluates in. Falls back to the
    ; entry module scope for an unknown name (defensive: callers pass names that
    ; came from loaded values).
    fn moduleScopeFor:EvalContext (name:string) {
        def i:int 0
        def n:int (array_length moduleScopeNames)
        while (i < n) {
            if ((itemAt moduleScopeNames i) == name) {
                def cid:int (itemAt moduleScopeIds i)
                def cell:ClosureCell (itemAt closureScopes cid)
                if cell.ctx {
                    def c:EvalContext (unwrap cell.ctx)
                    ; every stored scope is its own moduleRoot, so this is the
                    ; scope itself (via a method call, which the optionality
                    ; checker accepts as a non-optional producer)
                    return (c.moduleScope())
                }
            }
            i = (i + 1)
        }
        return (moduleScope.moduleScope())
    }

    ; A module's class declaration by (module, class) — empty node on miss.
    fn moduleClassNode:TSNode (moduleName:string clsName:string) {
        def empty:TSNode (new TSNode())
        def key:string (moduleName + ("::" + clsName))
        def cn@(optional):TSNode (get moduleClasses key)
        if (null? cn) {
            return empty
        }
        return (unwrap cn)
    }

    fn loadVirtualModule:void (name:string) {
        if (this.isInStringList(name virtualModulesLoaded)) {
            return
        }
        def src:string (this.virtualModuleSource(name))
        if ((strlen src) == 0) {
            print ("ERROR: virtual module not registered: " + name)
            return
        }
        push virtualModulesLoaded name
        def vLexer (new TSLexer(src))
        def vTokens:[Token] (vLexer.tokenize())
        def vParser:TSParserSimple (new TSParserSimple())
        vParser.initParser(vTokens)
        vParser.tsxMode = jsxParsing
        def vAst:TSNode (vParser.parseProgram())
        ; The module's own scope: parented on hostScope ONLY (never the entry
        ; script's moduleScope). Held via ClosureCell so array storage keeps a
        ; pointer instead of deep-copying the context.
        def mscope:EvalContext (new EvalContext())
        mscope.parent = hostScope
        mscope.moduleRoot = mscope
        def cid:int (array_length closureScopes)
        def cell (new ClosureCell)
        cell.ctx = mscope
        push closureScopes cell
        push moduleScopeNames name
        push moduleScopeIds cid
        ; Evaluate the module INSIDE its scope: its imports bind into it, its
        ; functions capture it as their closure, its classes go to the
        ; per-module table, its consts/lets evaluate in it, and its top-level
        ; statements run in it. Declaration order mirrors loadScript: functions
        ; + classes first, then variables, then expression statements.
        def savedModule:string currentModule
        def savedCtx:EvalContext context
        currentModule = name
        context = mscope
        this.processImports(vAst)
        this.materializeVirtualModule(vAst)
        this.runVirtualTopLevel(vAst)
        context = savedCtx
        currentModule = savedModule
    }

    fn materializeVirtualModule:void (ast:TSNode) {
        def i:int 0
        while (i < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children i)
            this.materializeVirtualDecl(node)
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length ast.children)) {
            def vnode:TSNode (itemAt ast.children j)
            this.materializeVirtualVar(vnode)
            j = (j + 1)
        }
    }

    ; Pass 1: functions become closures over the module scope; classes go to the
    ; per-module class table.
    fn materializeVirtualDecl:void (node:TSNode) {
        if ((this.nodeKindOf(node)) == 40) {
            if ((strlen node.name) > 0) {
                def fv:EvalValue (this.captureClosure(node))
                context.define(node.name fv)
            }
            return
        }
        if ((this.nodeKindOf(node)) == 25) {
            if ((strlen node.name) > 0) {
                def key:string (currentModule + ("::" + node.name))
                set moduleClasses key node
            }
            return
        }
        if (node.nodeType == "ExportNamedDeclaration") {
            if node.left {
                this.materializeVirtualDecl((unwrap node.left))
            }
            return
        }
        if (node.nodeType == "ExportDefaultDeclaration") {
            if node.left {
                this.materializeVirtualDecl((unwrap node.left))
            }
        }
    }

    ; Pass 2: top-level const/let evaluate with the module scope as context.
    fn materializeVirtualVar:void (node:TSNode) {
        if ((this.nodeKindOf(node)) == 31) {
            def i:int 0
            while (i < (array_length node.children)) {
                def decl:TSNode (itemAt node.children i)
                if (decl.nodeType == "VariableDeclarator") {
                    if decl.init {
                        def value:EvalValue (this.evaluateExpr((unwrap decl.init)))
                        context.define(decl.name value)
                    } {
                        context.define(decl.name (EvalValue.undefined()))
                    }
                }
                i = (i + 1)
            }
            return
        }
        if (node.nodeType == "ExportNamedDeclaration") {
            if node.left {
                this.materializeVirtualVar((unwrap node.left))
            }
            return
        }
        if (node.nodeType == "ExportDefaultDeclaration") {
            if node.left {
                this.materializeVirtualVar((unwrap node.left))
            }
        }
    }

    ; Pass 3: top-level expression statements run in the module scope.
    fn runVirtualTopLevel:void (ast:TSNode) {
        def i:int 0
        while (i < (array_length ast.children)) {
            def stmt:TSNode (itemAt ast.children i)
            if ((this.nodeKindOf(stmt)) == 30) {
                if stmt.left {
                    this.evaluateExprForSideEffect((unwrap stmt.left))
                }
            }
            i = (i + 1)
        }
    }

    ; A loaded module's top-level binding by name (host lifecycle door: the
    ; entry points a guest wired via runtime.start live in ranger:core's scope,
    ; not the entry script's). Null when no loaded module binds the name.
    fn lookupModuleExport:EvalValue (name:string) {
        def i:int 0
        def n:int (array_length moduleScopeNames)
        while (i < n) {
            def cid:int (itemAt moduleScopeIds i)
            def cell:ClosureCell (itemAt closureScopes cid)
            if cell.ctx {
                def sc:EvalContext (unwrap cell.ctx)
                if (has sc.bindings name) {
                    return (sc.lookup(name))
                }
            }
            i = (i + 1)
        }
        return (EvalValue.null())
    }

    ; Namespace object for `import * as NS from "ranger:x"`: a snapshot of the
    ; module's top-level value bindings plus a hidden home-module tag that
    ; member-new (`new NS.Class()`) resolves the module's class table through.
    fn buildNamespaceValue:EvalValue (name:string) {
        def ks:[string]
        def vs:[EvalValue]
        def ns:EvalValue (EvalValue.object(ks vs))
        ns.setMember("__nsmodule__" (EvalValue.string(name)))
        def sc:EvalContext (this.moduleScopeFor(name))
        def bnames:[string] (keys sc.bindings)
        def i:int 0
        while (i < (array_length bnames)) {
            def bn:string (itemAt bnames i)
            def bv:EvalValue (sc.lookup(bn))
            ns.setMember(bn bv)
            i = (i + 1)
        }
        return ns
    }

    ; Bind an import clause of a virtual module into the IMPORTER's scope
    ; (context = entry moduleScope, another module's scope, or a fixture).
    fn bindVirtualImportSpecifiers:void (node:TSNode moduleName:string) {
        def sc:EvalContext (this.moduleScopeFor(moduleName))
        def j:int 0
        while (j < (array_length node.children)) {
            def spec:TSNode (itemAt node.children j)
            if (spec.nodeType == "ImportNamespaceSpecifier") {
                def nsv:EvalValue (this.buildNamespaceValue(moduleName))
                context.define(spec.name nsv)
            }
            if (spec.nodeType == "ImportSpecifier") {
                if (spec.kind != "type") {
                    def localName:string spec.name
                    if ((strlen spec.value) > 0) {
                        localName = spec.value
                    }
                    def v:EvalValue (sc.lookup(spec.name))
                    context.define(localName v)
                }
            }
            j = (j + 1)
        }
    }

    fn collectCallArgs:[EvalValue] (node:TSNode) {
        def args:[EvalValue]
        def i:int 0
        while (i < (array_length node.children)) {
            def argNode:TSNode (itemAt node.children i)
            ; Spread a call argument: f(...xs) expands the array's elements.
            if (argNode.nodeType == "SpreadElement") {
                def sv:EvalValue (EvalValue.null())
                if argNode.left {
                    sv = (this.evaluateExpr((unwrap argNode.left)))
                }
                if (sv.isArray()) {
                    def k:int 0
                    while (k < (array_length sv.arrayValue)) {
                        push args (itemAt sv.arrayValue k)
                        k = (k + 1)
                    }
                }
            } {
                push args (this.evaluateExpr(argNode))
            }
            i = (i + 1)
        }
        return args
    }

    ; Bind a name at module scope (top-level const/let/function).
    fn defineModuleBinding:void (name:string value:EvalValue) {
        moduleScope.define(name value)
    }

    ; Convenience: read back a registered / script-defined global by name.
    fn getGlobal:EvalValue (name:string) {
        def v:EvalValue (context.lookup(name))
        if (false == (v.isNull())) {
            return v
        }
        return (hostScope.lookup(name))
    }

    ; Parse a script and register its imports, components/functions and
    ; top-level variables WITHOUT requiring or evaluating a render() function.
    ; After this, callFunction()/callRender() can invoke the script's functions.
    ; D-SOURCETYPE: a guest source is parsed as a MODULE only when it actually
    ; uses import/export; otherwise it is a script. Module code is always strict,
    ; and parsing everything as a module therefore rejected sloppy-mode syntax
    ; that is perfectly legal in a script -- `with`, octal literals, duplicate
    ; parameters, assignment to an undeclared variable. Those failed at PARSE
    ; time, so the engine never got to run them and the failure looked like a
    ; missing feature rather than a mode mismatch.
    fn sourceIsModule:boolean (src:string) {
        if ((indexOf src "import ") >= 0) { return true }
        if ((indexOf src "import(") >= 0) { return true }
        if ((indexOf src "export ") >= 0) { return true }
        if ((indexOf src "export{") >= 0) { return true }
        if ((indexOf src "export default") >= 0) { return true }
        return false
    }

    ; D-STRICT: why a property write would be refused, or "" when it would go
    ; through. Mirrors the conditions EvalValue.setMember silently returns on --
    ; the two must agree, or strict mode would throw for a write that then
    ; succeeded, or stay silent about one that did not.
    ; D-STRICT: is THIS function strict? Poisoning `caller`/`arguments` turns on
    ; the accessed function's own strictness, not the accessing code's -- a
    ; sloppy function called from strict code keeps both properties, which is
    ; what the noStrict half of the suite checks.
    ;
    ; The flag is stamped onto the value where the function is created, so a
    ; function that is strict only by lexical inheritance counts too.
    ; D-STRICT: whether `caller` and `arguments` are POISONED on this value. A
    ; bound function poisons them whatever its target was, which is a separate
    ; question from whether the target runs as strict code -- stamping
    ; `strictFn` on the bound copy conflated the two and made
    ; `f.bind()()` keep an undefined `this` for a SLOPPY f.
    fn functionIsStrict:boolean (fv:EvalValue) {
        if fv.boundExplicit {
            return true
        }
        return fv.strictFn
    }

    fn insideFunctionCall:boolean () {
        return (callDepth > 0)
    }

    fn writeRefusalError:string (obj:EvalValue key:string) {
        ; A FUNCTION holds properties with attributes too -- `Function.length`
        ; is non-writable, and only objects were being checked.
        if (obj.valueType == 6) {
            if (has obj.objectMap key) {
                if (false == (obj.isWritable(key))) {
                    return ("Cannot assign to read only property " + key)
                }
            }
            return ""
        }
        if (obj.valueType != 5) {
            return ""
        }
        ; An accessor with a setter takes the write; one without cannot.
        if (has obj.getterMap key) {
            if (false == (has obj.setterMap key)) {
                return ("Cannot set property " + key + ", which has only a getter")
            }
            return ""
        }
        if obj.frozenFlag {
            return ("Cannot assign to read only property " + key + " of a frozen object")
        }
        if (has obj.objectMap key) {
            if (false == (obj.isWritable(key))) {
                return ("Cannot assign to read only property " + key)
            }
            return ""
        }
        if (false == obj.extensibleFlag) {
            return ("Cannot add property " + key + " to a non-extensible object")
        }
        if (obj.protoRefuses(key 0)) {
            return ("Cannot assign to read only property " + key + " of an object")
        }
        return ""
    }

    ; D-STRICT: a "use strict" prologue -- a bare string-literal statement at the
    ; head of a program or a function body. Only the leading run of directives
    ; counts, so a string in the middle of a body is just an expression.
    fn bodyIsStrict:boolean (bodyNode:TSNode) {
        def i:int 0
        while (i < (array_length bodyNode.children)) {
            def st:TSNode (itemAt bodyNode.children i)
            if ((this.nodeKindOf(st)) != 30) {
                return false
            }
            if (null? st.left) {
                return false
            }
            def ex:TSNode (unwrap st.left)
            if ((this.nodeKindOf(ex)) != 8) {
                return false
            }
            ; §14.1: the directive is matched against the RAW text, so a
            ; literal containing an escape or a line continuation is an
            ; ordinary expression statement whatever it evaluates to.
            if (ex.value == "use strict") {
                if (false == ex.hasEscape) {
                    return true
                }
            }
            i = (i + 1)
        }
        return false
    }

    ; The strictness a function body runs under: its own directive, or the
    ; strictness already in force.
    ; D-STRICT: strictness from the function's OWN body directive alone, with no
    ; ambient flag folded in. The stamped `strictFn` answers the lexical
    ; question; this answers it for a node with no value to hand.
    fn bodyOnlyStrict:boolean (fnNode:TSNode) {
        if (null? fnNode.body) {
            return false
        }
        def bb:TSNode (unwrap fnNode.body)
        if ((this.nodeKindOf(bb)) != 34) {
            return false
        }
        return (this.bodyIsStrict(bb))
    }

    fn strictForBody:boolean (fnNode:TSNode) {
        if strictMode {
            return true
        }
        if (null? fnNode.body) {
            return false
        }
        def b:TSNode (unwrap fnNode.body)
        if ((this.nodeKindOf(b)) != 34) {
            return false
        }
        return (this.bodyIsStrict(b))
    }

    fn parseProgramFromSrc:TSNode (src:string) {
        def lexer (new TSLexer(src))
        def tokens:[Token] (lexer.tokenize())
        parser.initParser(tokens)
        parser.tsxMode = jsxParsing
        parser.setModuleMode((this.sourceIsModule(src)))
        return (parser.parseProgram())
    }

    ; D-EVAL: run eval'd source in the current scope and return its completion
    ; value. A parse failure is a SyntaxError thrown into the guest, not a
    ; silent null — eval is precisely where guests expect to catch one.
    ; D-CTORCALL: shared by `Array(n)` and `new Array(n)` so the two forms cannot
    ; diverge. A single numeric argument pre-sizes; anything else is the element
    ; list.
    fn buildArrayFromArgs:EvalValue (argNodes:[TSNode]) {
        def items:[EvalValue]
        def n:int (array_length argNodes)
        if (n == 1) {
            def only:EvalValue (this.evaluateExpr((itemAt argNodes 0)))
            if (only.isNumber()) {
                ; D-ARRAYLEN: `Array(len)` accepts only a uint32. A negative or
                ; fractional length is a RangeError, and an enormous one used to
                ; be a host crash ("Invalid array length") rather than a guest
                ; error the test could catch.
                def rawLen:double (only.toNumber())
                if ((rawLen < 0.0) || (rawLen > 4294967295.0)) {
                    return (this.throwSpecError("RangeError" "Invalid array length"))
                }
                ; Integrality is tested on the DOUBLE. Round-tripping through an
                ; int first wrapped 4294967295 to a negative number, so the one
                ; length at the top of the legal range was rejected as invalid.
                if ((this.floorNum(rawLen)) != rawLen) {
                    return (this.throwSpecError("RangeError" "Invalid array length"))
                }
                def slots:int (to_int rawLen)
                ; D-ARRAYSPARSE: a length past what the dense store can hold is
                ; DECLARED rather than materialised -- `new Array(4294967295)`
                ; is legal and has no elements at all, and a RangeError for it
                ; confused "too big to allocate" with "not a length".
                if (slots > 10000000) {
                    def bigArr2:EvalValue (EvalValue.array(items))
                    bigArr2.declaredLength = slots
                    return bigArr2
                }
                ; D-HOLES: `new Array(5)` has five ABSENT elements, so forEach
                ; visits none of them -- filling with undefined made every
                ; iteration method run five times.
                def si:int 0
                while (si < slots) {
                    push items (EvalValue.hole())
                    si = (si + 1)
                }
                return (EvalValue.array(items))
            }
            push items only
            return (EvalValue.array(items))
        }
        def i:int 0
        while (i < n) {
            push items (this.evaluateExpr((itemAt argNodes i)))
            i = (i + 1)
        }
        return (EvalValue.array(items))
    }

    ; D-FNCTOR: compile `Function(paramNames..., body)` into a real function
    ; value by assembling source and parsing it, which is the same door eval
    ; uses. A parse failure is a SyntaxError to the guest, as the spec requires.
    fn buildFunctionFromSource:EvalValue (argNodes:[TSNode]) {
        def vals:[EvalValue]
        def i:int 0
        while (i < (array_length argNodes)) {
            push vals (this.evaluateExpr((itemAt argNodes i)))
            if scriptThrew {
                return (EvalValue.undefined())
            }
            i = (i + 1)
        }
        return (this.buildFunctionFromValues(vals))
    }

    fn buildFunctionFromValues:EvalValue (argVals:[EvalValue]) {
        def n:int (array_length argVals)
        def params:string ""
        def body:string ""
        def i:int 0
        while (i < n) {
            def av:EvalValue (itemAt argVals i)
            ; ToString, not the value's own debug rendering: an argument with a
            ; `toString` method must have it CALLED, and a throw from it is the
            ; answer -- `new Function({toString: function () { throw 7; }})`
            ; throws 7, not a SyntaxError about an unparsable body.
            def txt:string (this.toStringOf(av))
            if scriptThrew {
                return (EvalValue.undefined())
            }
            if (i == (n - 1)) {
                body = txt
            } {
                if (i > 0) {
                    params = (params + ", ")
                }
                params = (params + txt)
            }
            i = (i + 1)
        }
        ; The assembled text IS the function's source text, and the spec names
        ; the result "anonymous" -- both are observable through toString.
        def src:string ("function anonymous(" + params + "\n) {\n" + body + "\n}")
        def lx (new TSLexer(src))
        def toks:[Token] (lx.tokenize())
        def p (new TSParserSimple())
        p.initParser(toks)
        p.setModuleMode((this.sourceIsModule(src)))
        def ast:TSNode (p.parseProgram())
        if (p.errorCount > 0) {
            return (this.throwSpecError("SyntaxError" "invalid function body passed to Function"))
        }
        if ((array_length ast.children) > 0) {
            def decl:TSNode (itemAt ast.children 0)
            if ((this.nodeKindOf(decl)) == 40) {
                ; D-FNSRC: the closure records the source it was parsed from, not
                ; the caller's.
                ; D-STRICT: a function built by the Function CONSTRUCTOR never
                ; inherits the caller's strictness -- it is strict only if its
                ; own body says so. `"use strict"; Function("return typeof this")`
                ; returns "object", because the built function is sloppy and
                ; gets the global object. The ambient flag is set aside for the
                ; capture so `strictForBody` reads the body alone.
                def savedFnSrc:string currentSource
                def savedFnStrict:boolean strictMode
                currentSource = src
                strictMode = false
                def built:EvalValue (this.captureClosure(decl))
                strictMode = savedFnStrict
                currentSource = savedFnSrc
                return built
            }
        }
        return (this.throwSpecError("SyntaxError" "invalid function body passed to Function"))
    }

    fn runEvalSource:EvalValue (src:string) {
        ; D-FNSRC: while this string runs, it IS the source in effect, so a
        ; function it defines records the text its own offsets index into. The
        ; body has several exits, so the swap is done around the call rather
        ; than inside it.
        def savedEvalSrc:string currentSource
        currentSource = src
        def evOut:EvalValue (this.runEvalSourceIn(src))
        currentSource = savedEvalSrc
        return evOut
    }

    ; D-EVAL: INDIRECT eval -- `var e = eval; e(src)`, `eval.call(null, src)`.
    ; The spec runs it in the GLOBAL scope rather than the caller's, which is the
    ; whole difference from the direct form intercepted by name. It used to be
    ; uncallable at all: the value has no function node, so every call path
    ; skipped it and reported "not a function".
    fn isEvalFunctionValue:boolean (v:EvalValue) {
        if (v.valueType != 6) {
            return false
        }
        if v.functionNode {
            return false
        }
        if ((strlen v.builtinName) > 0) {
            return false
        }
        return (v.functionName == "eval")
    }

    fn runIndirectEval:EvalValue (args:[EvalValue]) {
        if ((array_length args) == 0) {
            return (EvalValue.undefined())
        }
        def evSrc:EvalValue (itemAt args 0)
        ; eval of a non-string returns the argument untouched.
        if (false == (evSrc.isString())) {
            return evSrc
        }
        def savedEvalCtx:EvalContext context
        ; D-EVAL: indirect eval runs in the GLOBAL scope with `this` bound to the
        ; global object, whatever the caller's `this` was. Running it at module
        ; scope alone let `this` resolve to the enclosing function's, so
        ; `var e = eval; e("this")` inside a method answered the receiver.
        def evalCtx:EvalContext (moduleScope.createChild())
        ; D-EVAL: the scope exists only to carry `this`. Indirect eval's variable
        ; environment IS the global one, so a `var` or function declaration in
        ; the eval'd text has to survive the call -- marking the scope as a block
        ; sends both to moduleScope, where the rest of the script can see them.
        evalCtx.isBlockScope = true
        evalCtx.define("this" (this.theGlobalObject()))
        context = evalCtx
        def evOut:EvalValue (this.runEvalSource(evSrc.stringValue))
        context = savedEvalCtx
        return evOut
    }

    fn runEvalSourceIn:EvalValue (src:string) {
        ; A FRESH parser: `parser` is a shared member and its errorCount carries
        ; across parses, so re-entering it here made eval report a SyntaxError
        ; for any source that followed an earlier recovered parse — which looked
        ; exactly like "eval cannot handle string literals".
        def evLexer (new TSLexer(src))
        def evTokens:[Token] (evLexer.tokenize())
        def evParser (new TSParserSimple())
        evParser.initParser(evTokens)
        evParser.tsxMode = jsxParsing
        ; D-SOURCETYPE: eval'd code is a SCRIPT unless it uses import/export.
        ; Defaulting to module mode made it strict, so sloppy source passed to
        ; eval was reported as a SyntaxError -- eval is exactly where guests
        ; hand over sloppy code.
        evParser.setModuleMode((this.sourceIsModule(src)))
        ; D-STRICT: DIRECT eval inherits the strictness of the code that called
        ; it, so `"use strict"; eval("var arguments;")` is an early SyntaxError
        ; even though the eval'd text says nothing about strictness. Only the
        ; text's own directive was consulted, so every strict-mode early error
        ; reached through eval went unreported. parseProgram only ever turns
        ; strictness ON, so pre-setting it here survives.
        if strictMode {
            evParser.strictMode = true
        }
        def ast:TSNode (evParser.parseProgram())
        if (evParser.errorCount > 0) {
            return (this.throwSpecError("SyntaxError" "invalid source passed to eval"))
        }
        ; Declarations first, so an eval'd function can be called by later
        ; statements in the same string.
        ; D-COMPLETION: the eval result is the last non-empty completion of the
        ; whole program, not of its top-level expression statements. Reading only
        ; the latter meant `eval("for (i in o) s += o[i]")` was undefined where
        ; the spec says the body's last value.
        def savedCompletion:EvalValue completionValue
        completionValue = (EvalValue.undefined())
        ; D-EVAL: STRICT eval code gets its own variable environment, so a `var`
        ; or function it declares does not leak into the caller.
        ; `"use strict"; eval("var x = 1"); typeof x` is "undefined". Sloppy
        ; eval still shares the caller's, which is the whole difference. The
        ; scope has to exist before the function declarations are hoisted, or
        ; they land in the caller's.
        def savedEvalScope:EvalContext context
        def scopedEval:boolean false
        if evParser.strictMode {
            context = (context.createChild())
            scopedEval = true
        }
        this.hoistFunctionDeclarations(ast.children)
        def i:int 0
        while (i < (array_length ast.children)) {
            def stmt:TSNode (itemAt ast.children i)
            if (false == (this.isTopLevelDeclaration(stmt))) {
                this.runStatementValue(stmt)
            } {
                if ((this.nodeKindOf(stmt)) == 31) {
                    this.runStatementValue(stmt)
                }
                if ((this.nodeKindOf(stmt)) == 25) {
                    if ((strlen stmt.name) > 0) {
                        set classes stmt.name stmt
                    }
                }
            }
            if scriptThrew {
                completionValue = savedCompletion
                if scopedEval {
                    context = savedEvalScope
                }
                return (EvalValue.undefined())
            }
            i = (i + 1)
        }
        def out:EvalValue completionValue
        completionValue = savedCompletion
        if scopedEval {
            context = savedEvalScope
        }
        return out
    }

    fn clearLocalComponents:void () {
        def empty:[ImportedSymbol]
        localComponents = empty
    }

    fn loadScript:void (src:string) {
        ; Seed the engine-provided globals before anything runs. Lazy seeding was
        ; observable: `typeof Symbol` resolves through bindingExists, which does
        ; not trigger the seed, so it answered "undefined" for a global that
        ; existed the moment anything else touched it.
        this.ensureErrorCtors()
        source = src
        currentSource = src
        def ast:TSNode (this.parseProgramFromSrc(src))
        programAst = ast
        ; D-STRICT: a program-level "use strict" applies to the whole script.
        strictMode = (this.bodyIsStrict(ast))
        ; Fresh module scope for this script; hostScope (registerGlobal) is kept.
        def scope:EvalContext (new EvalContext())
        scope.parent = hostScope
        scope.moduleRoot = scope
        scope.isGlobalScope = true
        moduleScope = scope
        context = scope
        def freshGlobalVars:[string:boolean]
        globalVarSet = freshGlobalVars
        this.clearLocalComponents()
        this.clearImportState()
        def emptyFiles:[string]
        loadedFiles = emptyFiles
        this.processImports(ast)
        ; Functions first so const initializers may call helpers.
        this.registerComponents(ast)
        ; D-GLOBALTHIS: the var and function names exist as properties of the
        ; global object BEFORE any initialiser runs -- a hoisted var is
        ; undefined, not absent -- so `var x = typeof this.f` sees f.
        this.publishGlobalVarNames(ast)
        this.hoistTopLevelVarNames(ast)
        this.runTopLevelStatements(ast)
    }

    ; Standard JS module semantics: top-level expression statements execute at
    ; load time (e.g. `runtime.start(new MyGame())` — the D-MODULES authored
    ; lifecycle). Declarations were already handled by registerComponents /
    ; processVariables; only ExpressionStatements run here, in module scope.
    fn runTopLevelStatements:void (ast:TSNode) {
        def saved:EvalContext context
        context = moduleScope
        def i:int 0
        while (i < (array_length ast.children)) {
            def stmt:TSNode (itemAt ast.children i)
            if ((this.nodeKindOf(stmt)) == 30) {
                if stmt.left {
                    this.evaluateExprForSideEffect((unwrap stmt.left))
                }
            } {
                ; D-TOPLEVEL: every other statement runs too. Only expression
                ; statements used to execute here, so a top-level `if`, `for`,
                ; `while`, `try` or `throw` was silently skipped — the program
                ; simply did not run, which reads identically to a program that
                ; ran and did nothing. Declarations are excluded because
                ; registerComponents/processVariables already bound them.
                if (false == (this.isTopLevelDeclaration(stmt))) {
                    this.runStatementValue(stmt)
                } {
                    ; D-TOPLEVEL: a VariableDeclaration's INITIALISER runs here,
                    ; in source order, rather than in a pass of its own before
                    ; the program starts. Only the binding is hoisted.
                    if ((this.nodeKindOf(stmt)) == 31) {
                        this.runStatementValue(stmt)
                    }
                }
            }
            if scriptThrew {
                ; An uncaught top-level throw stops the rest of the program, as
                ; it does in any JS engine.
                i = (array_length ast.children)
            }
            i = i + 1
        }
        context = saved
    }

    ; Statements already bound by registerComponents / processVariables before
    ; top-level execution; re-running them would double-evaluate initialisers.
    fn isTopLevelDeclaration:boolean (stmt:TSNode) {
        if ((this.nodeKindOf(stmt)) == 40) { return true }
        if ((this.nodeKindOf(stmt)) == 25) { return true }
        if ((this.nodeKindOf(stmt)) == 31) { return true }
        if (stmt.nodeType == "ImportDeclaration") { return true }
        if (stmt.nodeType == "ExportNamedDeclaration") { return true }
        if (stmt.nodeType == "ExportDefaultDeclaration") { return true }
        if (stmt.nodeType == "ExportAllDeclaration") { return true }
        if (stmt.nodeType == "TSInterfaceDeclaration") { return true }
        if (stmt.nodeType == "TSTypeAliasDeclaration") { return true }
        return false
    }

    ; Evaluate an ADDITIONAL guest source in the SAME realm/module scope (no
    ; reset): the test-fixture door (games/AGENTS.md rule 5) — guest-side test
    ; observations load beside a game without touching production source.
    fn loadAdditionalScript:void (src:string) {
        def ast:TSNode (this.parseProgramFromSrc(src))
        this.processImports(ast)
        this.registerComponents(ast)
        this.processVariables(ast)
        this.runTopLevelStatements(ast)
    }

    fn updateLocalComponentNode:void (name:string node:TSNode) {
        def i:int 0
        while (i < (array_length localComponents)) {
            def sym:ImportedSymbol (itemAt localComponents i)
            if (sym.name == name) {
                sym.functionNode = node
                return
            }
            i = (i + 1)
        }
        this.registerFunctionDeclaration(node)
    }

    ; Re-parse source, diff against cached programAst, and swap changed bindings.
    ; Returns true when GameRunner should rebuild scene (initState/sprites/consts).
    fn patchScript:boolean (src:string) {
        if (null? programAst) {
            this.loadScript(src)
            return true
        }
        def oldAst:TSNode (unwrap programAst)
        def oldSrc:string source
        def newAst:TSNode (this.parseProgramFromSrc(src))
        def patch:TSAstPatchResult (astPatcher.diffTopLevel(oldAst oldSrc newAst src))
        if (patch.hasChanges == false) {
            return false
        }
        source = src
        currentSource = src
        programAst = newAst
        this.clearLocalComponents()
        this.clearImportState()
        this.processImports(newAst)
        def ci:int 0
        while (ci < (array_length patch.changes)) {
            def ch:TSAstPatchChange (itemAt patch.changes ci)
            if (ch.changeKind == "removed") {
                moduleScope.removeBinding(ch.name)
                this.removeLocalComponentByName(ch.name)
                this.trace("Removed binding: " + ch.name)
            } {
                if (ch.declKind == "function") {
                    if (ch.changeKind != "removed") {
                        if ch.newNode {
                            def fnNode:TSNode (unwrap ch.newNode)
                            this.updateLocalComponentNode(ch.name fnNode)
                            def __fnv:EvalValue (EvalValue.function(fnNode))
                            __fnv.strictFn = (this.strictForBody(fnNode))
                            __fnv.srcText = currentSource
                            moduleScope.define(ch.name __fnv)
                            this.trace("Patched function: " + ch.name)
                        }
                    }
                }
                if (ch.declKind == "variable") {
                    if (ch.changeKind != "removed") {
                        if ch.newNode {
                            def varNode:TSNode (unwrap ch.newNode)
                            this.processModuleVariableDeclaration(varNode)
                            this.trace("Patched variable: " + ch.name)
                        }
                    }
                }
            }
            ci = (ci + 1)
        }
        return patch.sceneAffecting
    }

    ; Call a script function by name, passing a single props/state object (React
    ; style: params are bound from the object's members / a destructured
    ; pattern). Returns the function's value (object/array/primitive). Unknown or
    ; non-function names return null.
    fn callFunction:EvalValue (name:string props:EvalValue) {
        def fnValue:EvalValue (context.lookup(name))
        if (false == (fnValue.isFunction())) {
            ; Host lifecycle door: a name not in the entry scope may be a loaded
            ; virtual module's top-level function (e.g. the ranger:core
            ; __rgGameInit / __rgGameUpdate entry points — module scopes are
            ; isolated, so they are NOT entry bindings). Module functions carry
            ; their closure, so the call roots in their own module scope.
            def mv:EvalValue (this.lookupModuleExport(name))
            if (mv.isFunction()) {
                if mv.functionNode {
                    def margs:[EvalValue]
                    push margs props
                    def mout:EvalValue (this.callFnValueWithValues(mv margs))
                    if scriptThrew {
                        this.trace("Uncaught exception: " + (scriptThrowValue.toString()))
                        scriptThrew = false
                        scriptThrowValue = (EvalValue.null())
                    }
                    return mout
                }
            }
            return (EvalValue.null())
        }
        if (null? fnValue.functionNode) {
            return (EvalValue.null())
        }
        def fnNode:TSNode (unwrap fnValue.functionNode)
        def out:EvalValue (this.evaluateFunctionCall(fnNode props))
        ; An uncaught throw must not leak into the next top-level call (frame).
        if scriptThrew {
            this.trace("Uncaught exception: " + (scriptThrowValue.toString()))
            scriptThrew = false
            scriptThrowValue = (EvalValue.null())
        }
        return out
    }

    ; Call a script function by name and evaluate its returned JSX into an EVG
    ; element tree (for screen render functions).
    fn callRender:EVGElement (name:string props:EvalValue) {
        def fnValue:EvalValue (context.lookup(name))
        if (false == (fnValue.isFunction())) {
            def empty (new EVGElement())
            return empty
        }
        if (null? fnValue.functionNode) {
            def empty2 (new EVGElement())
            return empty2
        }
        def fnNode:TSNode (unwrap fnValue.functionNode)
        return (this.evaluateFunctionWithProps(fnNode props))
    }

    ; ==========================================================================
    ; Component Registration
    ; ==========================================================================
    
    fn processImports:void (ast:TSNode) {
        ; Process all import declarations
        def i:int 0
        while (i < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children i)
            
            if (node.nodeType == "ImportDeclaration") {
                this.processImportDeclaration(node)
            }
            
            i = i + 1
        }
    }
    
    fn processImportDeclaration:void (node:TSNode) {
        ; Skip type-only imports (import type { ... } from "...")
        if (node.kind == "type") {
            return
        }

        ; Get the module path from node.left (StringLiteral - 'from' clause)
        def modulePath:string ""
        if node.left {
            def srcNode:TSNode (unwrap node.left)
            modulePath = (this.unquote(srcNode.value))
        }
        
        ; Skip primitive imports (evg_types) and empty paths
        if ((strlen modulePath) == 0) {
            return
        }
        ; Virtual `ranger:*` packages: evaluate the registered source once (in
        ; its own scope), then bind THIS import clause into the importer's
        ; scope — named imports and `import * as NS` namespaces. Nothing beyond
        ; the clause becomes visible.
        if ((indexOf modulePath "ranger:") == 0) {
            this.loadVirtualModule(modulePath)
            this.bindVirtualImportSpecifiers(node modulePath)
            return
        }
        if ((indexOf modulePath "evg_types") >= 0) {
            return
        }
        if ((indexOf modulePath "evg_") >= 0) {
            return
        }
        if ((indexOf modulePath ".d.ts") >= 0) {
            return
        }
        ; Skip the flat native-bridge import ("@ranger/game"). The entry .as
        ; file already has this line stripped before loadScript() (see
        ; as_source_runner.rgr's stripBridgeImport), so its names fall through
        ; to nativeBridge at call time; a shared .as module imported via a
        ; relative path keeps this import (for asc compile-time typing) and
        ; would otherwise fail resolution here on every load, spamming stderr.
        if ((indexOf modulePath "@ranger/game") >= 0) {
            return
        }

        ; Capability-hint imports. `import * as THREE from 'three'` (or
        ; '@ranger/three') is not a file to load — it tells the host the script
        ; wants the THREE capability. The host registers the THREE namespace
        ; (constants) as a global and loads the façade classes into the class
        ; table; `new THREE.X()` then resolves by the class name (member-new), and
        ; THREE.CONSTANT by the global. So skip file resolution here.
        if (modulePath == "three") {
            return
        }
        if ((indexOf modulePath "@ranger/three") >= 0) {
            return
        }

        ; Same for the Cannon physics façade. `import * as CANNON from 'cannon-es'`
        ; (or '@ranger/cannon', or the canonical demo's relative '../dist/cannon-es.js')
        ; is a capability hint, not a file: the CANNON.* façade classes are loaded
        ; into the class table (concatenated), so `new CANNON.World()` resolves by
        ; class name; the CANNON namespace constants come from a registered global.
        if (modulePath == "cannon") {
            return
        }
        if ((indexOf modulePath "cannon-es") >= 0) {
            return
        }
        if ((indexOf modulePath "@ranger/cannon") >= 0) {
            return
        }

        ; Get imported symbols from node.children (import specifiers)
        def importExportNames:[string]
        def importLocalNames:[string]
        def j:int 0
        while (j < (array_length node.children)) {
            def spec:TSNode (itemAt node.children j)
            if (spec.nodeType == "ImportSpecifier") {
                if (spec.kind != "type") {
                    def exportName:string spec.name
                    def localName:string spec.name
                    if ((strlen spec.value) > 0) {
                        localName = spec.value
                    }
                    push importExportNames exportName
                    push importLocalNames localName
                }
            }
            if (spec.nodeType == "ImportDefaultSpecifier") {
                push importExportNames "default"
                push importLocalNames spec.name
            }
            j = j + 1
        }
        
        ; Load and parse the imported module
        def fullPath:string (this.resolveModulePath(modulePath))
        
        ; Skip empty paths
        if ((strlen fullPath) == 0) {
            return
        }
        
        ; Resolve import relative to the current importer's directory.
        def importerBase:string (this.normalizeDirPath(basePath))
        resolvedImportDir = importerBase
        def canonicalPath:string (importerBase + fullPath)

        if (this.isInStringList(canonicalPath importLoading)) {
            this.trace("Import cycle skipped: " + canonicalPath)
            this.rebindImportDeclaration(node)
            return
        }

        if (this.isInStringList(canonicalPath importLoaded)) {
            this.rebindImportDeclaration(node)
            return
        }

        push importLoading canonicalPath

        def src:string (this.readImportSource(importerBase fullPath))
        ; readImportSource sets resolvedImportDir to the search dir where the
        ; file was found (importer dir or an asset path); base the module dir on
        ; that so bare/asset imports and nested subdirectories resolve correctly.
        def foundDir:string resolvedImportDir
        def dirPath:string (this.moduleDirFromRead(foundDir fullPath))
        resolvedImportDir = dirPath
        if ((strlen src) == 0) {
            importLoading = (this.listWithoutString(importLoading canonicalPath))
            print ""
            print ("ERROR: Could not load component module: " + importerBase + fullPath)
            print ""
            print "Please ensure the imported file exists. You may need to:"
            print "  1. Check that the import path is correct in your TSX file"
            print "  2. Make sure the component file exists in one of your asset paths:"
            def pathIdx:int 0
            while (pathIdx < (array_length assetPaths)) {
                print ("     - " + (itemAt assetPaths pathIdx))
                pathIdx = pathIdx + 1
            }
            print ""
            return
        }

        ; Track loaded file for file watching
        def loadedFilePath:string (dirPath + fullPath)
        loadedFiles = (this.listWithStringIfMissing(loadedFiles loadedFilePath))

        ; Reuse a previous parse of this module when mtime is unchanged. Level
        ; transitions that re-import a large shared.tsx skip lexer+parser work.
        ; mtime must use foundDir+fullPath (same pair as the successful read) —
        ; dirPath is the module directory after resolving relative segments and
        ; is not a valid file_mtime prefix when fullPath still contains "../".
        def cacheKey:string ((this.normalizeDirPath(foundDir)) + fullPath)
        def fileMtime:int (file_mtime foundDir fullPath)
        def cacheIdx:int (this.findCachedImportIndex(cacheKey fileMtime))
        def cacheHit:boolean (cacheIdx >= 0)
        def importAstNode:TSNode (new TSNode())
        if (cacheHit) {
            def hit:CachedImportAst (itemAt importAstCache cacheIdx)
            importAstNode = hit.ast
            this.trace("Import cache hit: " + cacheKey)
        } {
            print ("Loading import: " + dirPath + fullPath)
            def lexer (new TSLexer(src))
            def tokens:[Token] (lexer.tokenize())
            def importParser:TSParserSimple (new TSParserSimple())
            importParser.initParser(tokens)
            importParser.tsxMode = jsxParsing
            importAstNode = (importParser.parseProgram())
            this.storeCachedImportAst(cacheKey fileMtime importAstNode dirPath fullPath)
        }
        
        ; Resolve transitive imports using this module's directory as basePath.
        def savedBasePath:string basePath
        basePath = dirPath
        this.processImports(importAstNode)
        basePath = savedBasePath
        
        ; Register all top-level bindings from the imported module so script
        ; code can call imported functions and read imported constants.
        this.materializeImportedModule(importAstNode)
        
        ; Collect all non-exported helper functions from the file
        def helperFns:[TSNode]
        def hk:int 0
        while (hk < (array_length importAstNode.children)) {
            def hstmt:TSNode (itemAt importAstNode.children hk)
            ; Collect non-exported function declarations as helpers
            if ((this.nodeKindOf(hstmt)) == 40) {
                def hfnName:string hstmt.name
                if ((this.isInList(hfnName importExportNames)) == false) {
                    push helperFns hstmt
                    if (cacheHit == false) {
                        print ("  Found helper function: " + hfnName)
                    }
                }
            }
            hk = hk + 1
        }
        
        ; Find exported functions that match imported names
        def k:int 0
        while (k < (array_length importAstNode.children)) {
            def stmt:TSNode (itemAt importAstNode.children k)
            
            ; Check for exported function declarations
            if (stmt.nodeType == "ExportNamedDeclaration") {
                if stmt.left {
                    def declNode:TSNode (unwrap stmt.left)
                    if ((this.nodeKindOf(declNode)) == 40) {
                        def fnName:string declNode.name
                        if (this.isInList(fnName importExportNames)) {
                            def localName:string (this.localNameForImport(fnName importExportNames importLocalNames))
                            this.bindImportedFunction(fnName localName declNode helperFns fullPath)
                        }
                    }
                }
            }
            
            ; Also check for regular function declarations (may be exported separately)
            if ((this.nodeKindOf(stmt)) == 40) {
                def fnName:string stmt.name
                if (this.isInList(fnName importExportNames)) {
                    def localName:string (this.localNameForImport(fnName importExportNames importLocalNames))
                    this.bindImportedFunction(fnName localName stmt helperFns fullPath)
                }
            }
            
            k = k + 1
        }

        importLoading = (this.listWithoutString(importLoading canonicalPath))
        importLoaded = (this.listWithStringIfMissing(importLoaded canonicalPath))
    }

    ; Bind every top-level function/const from an imported module into moduleScope.
    fn materializeImportedModule:void (ast:TSNode) {
        def saved:EvalContext context
        context = moduleScope
        def i:int 0
        while (i < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children i)
            this.materializeImportedNode(node)
            i = i + 1
        }
        context = saved
    }

    fn materializeImportedNode:void (node:TSNode) {
        if ((this.nodeKindOf(node)) == 40) {
            if (node.name != "render") {
                def __fnv:EvalValue (EvalValue.function(node))
                __fnv.strictFn = (this.strictForBody(node))
                __fnv.srcText = currentSource
                this.defineModuleBinding(node.name __fnv)
            }
            return
        }
        if ((this.nodeKindOf(node)) == 25) {
            ; `classes` is a single engine-wide name->node map (see
            ; registerTopLevelNode / evaluateNewExpr), so a class declared in
            ; an imported module becomes constructible (`new Foo()`) by both
            ; that module's own top-level initializers and the importer,
            ; exactly like a class declared in the entry script.
            if ((strlen node.name) > 0) {
                set classes node.name node
            }
            return
        }
        if ((this.nodeKindOf(node)) == 31) {
            this.processModuleVariableDeclaration(node)
            return
        }
        if (node.nodeType == "ExportNamedDeclaration") {
            if node.left {
                this.materializeImportedNode((unwrap node.left))
            }
            return
        }
        if (node.nodeType == "ExportDefaultDeclaration") {
            if node.left {
                this.materializeImportedNode((unwrap node.left))
            }
        }
    }
    
    ; Directory where the last successful readImportSource() found its module.
    def resolvedImportDir:string "./"

    ; Index into importAstCache, or -1 on miss / stale mtime.
    fn findCachedImportIndex:int (path:string mtime:int) {
        def i:int 0
        while (i < (array_length importAstCache)) {
            def entry:CachedImportAst (itemAt importAstCache i)
            if (entry.path == path) {
                if (entry.mtime == mtime) {
                    return i
                }
                return -1
            }
            i = i + 1
        }
        return -1
    }

    fn storeCachedImportAst:void (path:string mtime:int ast:TSNode dirPath:string relativePath:string) {
        def i:int 0
        while (i < (array_length importAstCache)) {
            def entry:CachedImportAst (itemAt importAstCache i)
            if (entry.path == path) {
                entry.mtime = mtime
                entry.ast = ast
                entry.dirPath = dirPath
                entry.relativePath = relativePath
                return
            }
            i = i + 1
        }
        def fresh:CachedImportAst (new CachedImportAst())
        fresh.path = path
        fresh.mtime = mtime
        fresh.ast = ast
        fresh.dirPath = dirPath
        fresh.relativePath = relativePath
        push importAstCache fresh
    }

    ; Read an import file from basePath, falling back to assetPaths.
    fn readImportSource:string (dirPath:string fullPath:string) {
        if (file_exists dirPath fullPath) {
            def content:buffer (buffer_read_file dirPath fullPath)
            def src:string (buffer_to_string content)
            if ((strlen src) > 0) {
                resolvedImportDir = dirPath
                return src
            }
        }
        def i:int 0
        while (i < (array_length assetPaths)) {
            def assetDir:string (itemAt assetPaths i)
            if (file_exists assetDir fullPath) {
                def tryBuf:buffer (buffer_read_file assetDir fullPath)
                def trySrc:string (buffer_to_string tryBuf)
                if ((strlen trySrc) > 0) {
                    resolvedImportDir = assetDir
                    return trySrc
                }
            }
            i = i + 1
        }
        return ""
    }

    fn resolveModulePath:string (modulePath:string) {
        ; Handle relative paths
        if ((indexOf modulePath "./") == 0) {
            ; Remove leading ./
            def path:string (substring modulePath 2 (strlen modulePath))
            ; Skip if path is too short (just had "./")
            if ((strlen path) == 0) {
                return ""
            }
            return (this.appendModuleExtension(path))
        }

        ; For now, just add extension
        return (this.appendModuleExtension(modulePath))
    }

    ; Append the interpreter's default module extension, unless `path` already
    ; names one explicitly (.tsx/.ts/.as pass through untouched). A `.as` game
    ; (jsxParsing == false, set by as_source_runner.rgr) resolves an
    ; extensionless relative import to `.as` instead of `.tsx`, so a shared
    ; builder module can be authored as e.g. `./ui.as` and imported as
    ; `import { ui } from "./ui"`.
    fn appendModuleExtension:string (path:string) {
        def n:int (strlen path)
        if (n >= 4) {
            if ((substring path (n - 4) n) == ".tsx") {
                return path
            }
        }
        if (n >= 3) {
            if ((substring path (n - 3) n) == ".ts") {
                return path
            }
            if ((substring path (n - 3) n) == ".as") {
                return path
            }
        }
        if (jsxParsing == false) {
            return (path + ".as")
        }
        return (path + ".tsx")
    }
    
    fn isInList:boolean (name:string list:[string]) {
        def i:int 0
        while (i < (array_length list)) {
            if ((itemAt list i) == name) {
                return true
            }
            i = i + 1
        }
        return false
    }
    
    fn registerComponents:void (ast:TSNode) {
        def i:int 0
        while (i < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children i)
            this.registerTopLevelNode(node)
            i = i + 1
        }
    }
    
    fn registerTopLevelNode:void (node:TSNode) {
        if ((this.nodeKindOf(node)) == 40) {
            this.registerFunctionDeclaration(node)
            return
        }
        if ((this.nodeKindOf(node)) == 25) {
            if ((strlen node.name) > 0) {
                set classes node.name node
            }
            return
        }
        if (node.nodeType == "ExportNamedDeclaration") {
            if node.left {
                this.registerTopLevelNode((unwrap node.left))
            }
            return
        }
        if (node.nodeType == "ExportDefaultDeclaration") {
            if node.left {
                this.registerTopLevelNode((unwrap node.left))
            }
        }
    }
    
    fn registerFunctionDeclaration:void (node:TSNode) {
        if (node.name == "render") {
            return
        }
        def sym (new ImportedSymbol())
        sym.name = node.name
        sym.originalName = node.name
        sym.symbolType = "component"
        sym.functionNode = node
        this.upsertLocalComponent(sym)
        def __fnv:EvalValue (EvalValue.function(node))
        __fnv.strictFn = (this.strictForBody(node))
        __fnv.srcText = currentSource
        this.defineModuleBinding(node.name __fnv)
        this.trace("Registered local component: " + node.name)
    }
    
    fn findRenderFunction:TSNode (ast:TSNode) {
        def empty (new TSNode())
        
        def i:int 0
        while (i < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children i)
            if ((this.nodeKindOf(node)) == 40) {
                if (node.name == "render") {
                    return node
                }
            }
            i = i + 1
        }
        
        return empty
    }
    
    ; ==========================================================================
    ; Variable Processing
    ; ==========================================================================
    
    fn processVariables:void (ast:TSNode) {
        def i:int 0
        while (i < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children i)
            this.processTopLevelVarNode(node)
            i = i + 1
        }
        this.publishGlobalVarNames(ast)
    }

    ; D-TOPLEVEL: HOIST a top-level declaration's names without running its
    ; initialiser. The initialiser is a statement and belongs in source order --
    ; running the whole declaration up front meant a read before the line saw
    ; the finished value, so `__func(); var __func = function () {};` succeeded
    ; where the spec says "undefined is not a function".
    fn hoistTopLevelVarNames:void (ast:TSNode) {
        def i:int 0
        while (i < (array_length ast.children)) {
            def node:TSNode (itemAt ast.children i)
            if ((this.nodeKindOf(node)) == 31) {
                def ci:int 0
                while (ci < (array_length node.children)) {
                    def d:TSNode (itemAt node.children ci)
                    if ((strlen d.name) > 0) {
                        if (false == (moduleScope.has(d.name))) {
                            moduleScope.define(d.name (EvalValue.undefined()))
                        }
                    }
                    ci = (ci + 1)
                }
            } {
                ; D-TOPLEVEL: `var` does not stop at a block, so a declaration
                ; buried in a `try`/`if`/loop is script-scoped and exists from
                ; the first statement. Only the top-level list was hoisted, so
                ; `try { __func() } catch (e) {}; var __func = function () {}`
                ; raised a ReferenceError where the spec says TypeError.
                this.hoistScriptVarNamesIn(node 0)
                ; Everything else -- exports, imports -- keeps its old handling.
                this.processTopLevelVarNode(node)
            }
            i = i + 1
        }
        this.publishGlobalVarNames(ast)
    }

    ; Bind every `var` name nested inside a top-level statement into the script
    ; scope, holding undefined. Nested functions carry their own vars, so the
    ; walk stops at any function boundary.
    fn hoistScriptVarNamesIn:void (node:TSNode depth:int) {
        if (depth > 24) {
            return
        }
        def nt:string node.nodeType
        if (nt == "FunctionDeclaration") { return }
        if (nt == "FunctionExpression") { return }
        if (nt == "ArrowFunctionExpression") { return }
        if (nt == "ClassDeclaration") { return }
        if (nt == "VariableDeclaration") {
            if ((node.kind == "var") || ((strlen node.kind) == 0)) {
                def ci:int 0
                while (ci < (array_length node.children)) {
                    def d:TSNode (itemAt node.children ci)
                    if ((strlen d.name) > 0) {
                        if (false == (moduleScope.has(d.name))) {
                            moduleScope.define(d.name (EvalValue.undefined()))
                        }
                    }
                    ci = (ci + 1)
                }
            }
            return
        }
        def nd:int (depth + 1)
        def k:int 0
        while (k < (array_length node.children)) {
            this.hoistScriptVarNamesIn((itemAt node.children k) nd)
            k = (k + 1)
        }
        if node.body { this.hoistScriptVarNamesIn((unwrap node.body) nd) }
        if node.left { this.hoistScriptVarNamesIn((unwrap node.left) nd) }
        if node.right { this.hoistScriptVarNamesIn((unwrap node.right) nd) }
    }

    ; D-GLOBALTHIS: a script's `var` and function declarations are properties of
    ; the global object, wherever in the script they were written. Only the
    ; TOP-LEVEL statements were mirrored, so a `var` inside a block or a `try`
    ; -- still script-scoped, since var hoisting does not stop at a block --
    ; was a binding and not a property, and a function declaration was neither.
    ; let/const/class are deliberately absent: they live in the declarative
    ; environment, and `let x` really is not `globalThis.x`.
    fn publishGlobalVarNames:void (ast:TSNode) {
        def names:[string]
        this.collectScriptVarNames(ast.children names 0)
        def gObj:EvalValue (this.theGlobalObject())
        ; ADDED to, never replaced: a second script loaded into the same realm
        ; (loadAdditionalScript) publishes its own names without unregistering
        ; the first script's, which would silently stop mirroring them.
        def si:int 0
        while (si < (array_length names)) {
            set globalVarSet (itemAt names si) true
            si = (si + 1)
        }
        def i:int 0
        while (i < (array_length names)) {
            def nm:string (itemAt names i)
            if (context.has(nm)) {
                gObj.setMember(nm (context.lookup(nm)))
            } {
                ; Hoisted but not yet initialised: the property exists and holds
                ; undefined, which is what a read before the declaration sees.
                if (false == (has gObj.objectMap nm)) {
                    gObj.setMember(nm (EvalValue.undefined()))
                }
            }
            i = (i + 1)
        }
    }

    fn collectScriptVarNames:void (stmts:[TSNode] out:[string] depth:int) {
        if (depth > 24) {
            return
        }
        def i:int 0
        while (i < (array_length stmts)) {
            def node:TSNode (itemAt stmts i)
            def nt:string node.nodeType
            if (nt == "FunctionDeclaration") {
                if ((strlen node.name) > 0) {
                    push out node.name
                }
            } {
                ; A nested function carries its own vars; do not descend into it.
                def opaque:boolean false
                if (nt == "FunctionExpression") { opaque = true }
                if (nt == "ArrowFunctionExpression") { opaque = true }
                if (nt == "ClassDeclaration") { opaque = true }
                if (false == opaque) {
                    if (nt == "VariableDeclaration") {
                        if ((node.kind == "var") || ((strlen node.kind) == 0)) {
                            def ci:int 0
                            while (ci < (array_length node.children)) {
                                def decl:TSNode (itemAt node.children ci)
                                if ((strlen decl.name) > 0) {
                                    push out decl.name
                                }
                                ci = (ci + 1)
                            }
                        }
                    } {
                        this.collectScriptVarNames(node.children out (depth + 1))
                        if node.body {
                            def bodyKids:[TSNode]
                            push bodyKids (unwrap node.body)
                            this.collectScriptVarNames(bodyKids out (depth + 1))
                        }
                        if node.left {
                            def leftKids:[TSNode]
                            push leftKids (unwrap node.left)
                            this.collectScriptVarNames(leftKids out (depth + 1))
                        }
                        if node.consequent {
                            def consKids:[TSNode]
                            push consKids (unwrap node.consequent)
                            this.collectScriptVarNames(consKids out (depth + 1))
                        }
                        if node.alternate {
                            def altKids:[TSNode]
                            push altKids (unwrap node.alternate)
                            this.collectScriptVarNames(altKids out (depth + 1))
                        }
                        ; A `for` head's declaration lives in `init`, and a
                        ; for-in/of target can be in `right`. Neither was walked,
                        ; so `for (var index = 0; …)` left `index` unhoisted --
                        ; a read before the loop was a ReferenceError where the
                        ; spec says undefined.
                        if node.init {
                            def initKids:[TSNode]
                            push initKids (unwrap node.init)
                            this.collectScriptVarNames(initKids out (depth + 1))
                        }
                        if node.right {
                            def rightKids:[TSNode]
                            push rightKids (unwrap node.right)
                            this.collectScriptVarNames(rightKids out (depth + 1))
                        }
                    }
                }
            }
            i = (i + 1)
        }
    }

    ; A script's var IS a property of the global object, so writing the binding
    ; has to write the property. Without this the two drift apart the first time
    ; the name is reassigned, and the object keeps the value it was seeded with.
    fn syncGlobalVar:void (name:string value:EvalValue) {
        if (false == (this.isGlobalVarName(name))) {
            return
        }
        ; A function-local `var` of the same name is a different binding and must
        ; not touch the property.
        if (false == (context.has(name))) {
            return
        }
        def owner:EvalContext (context.contextOwning(name))
        if (false == owner.isGlobalScope) {
            return
        }
        def g:EvalValue (this.theGlobalObject())
        g.setMember(name value)
    }

    ; True when this name is one the script's global object holds, so a write to
    ; it has to update the property as well as the binding.
    fn isGlobalVarName:boolean (name:string) {
        return (has globalVarSet name)
    }
    
    fn processTopLevelVarNode:void (node:TSNode) {
        if ((this.nodeKindOf(node)) == 31) {
            this.processModuleVariableDeclaration(node)
            ; D-GLOBALTHIS: a top-level `var` is a property of the global object
            ; as well as a binding, so `var toString = f; String(this)` uses f.
            ; let/const are NOT -- they live in the declarative environment.
            if ((node.kind == "var") || ((strlen node.kind) == 0)) {
                def gObjV:EvalValue (this.theGlobalObject())
                def vi:int 0
                while (vi < (array_length node.children)) {
                    def d:TSNode (itemAt node.children vi)
                    if ((strlen d.name) > 0) {
                        if (context.has(d.name)) {
                            gObjV.setMember(d.name (context.lookup(d.name)))
                        }
                    }
                    vi = (vi + 1)
                }
            }
            return
        }
        if (node.nodeType == "ExportNamedDeclaration") {
            if node.left {
                this.processTopLevelVarNode((unwrap node.left))
            }
            return
        }
        if (node.nodeType == "ExportDefaultDeclaration") {
            if node.left {
                this.processTopLevelVarNode((unwrap node.left))
            }
        }
    }
    
    fn processModuleVariableDeclaration:void (node:TSNode) {
        def saved:EvalContext context
        context = moduleScope
        def i:int 0
        while (i < (array_length node.children)) {
            def decl:TSNode (itemAt node.children i)
            if (decl.nodeType == "VariableDeclarator") {
                def varName:string decl.name
                if decl.init {
                    def initNode:TSNode (unwrap decl.init)
                    def value:EvalValue (this.evaluateExpr(initNode))
                    moduleScope.define(varName value)
                    if (false == quiet) {
                        this.trace("Defined module binding: " + varName + " = " + (value.toString()))
                    }
                } {
                    ; `let a, b, c;` with no initializer still needs a module
                    ; binding (JS: undefined), so a later top-level assignment
                    ; (e.g. inside init()) updates this binding rather than
                    ; creating a function-local one other functions can't see.
                    moduleScope.define(varName (EvalValue.undefined()))
                }
            }
            i = i + 1
        }
        context = saved
    }
    
    fn processVariableDeclaration:void (node:TSNode) {
        def i:int 0
        while (i < (array_length node.children)) {
            def decl:TSNode (itemAt node.children i)
            if (decl.nodeType == "VariableDeclarator") {
                ; Destructuring target: `const [a,b] = ..` / `const {x,y} = ..`
                if decl.left {
                    def pat:TSNode (unwrap decl.left)
                    def rhs:EvalValue (EvalValue.undefined())
                    if decl.init {
                        rhs = (this.evaluateExpr((unwrap decl.init)))
                    }
                    this.bindPattern(pat rhs)
                } {
                    def varName:string decl.name
                    ; D-CATCHVAR: `var` is function-scoped. Inside a catch or
                    ; `with` block the binding belongs to the enclosing function
                    ; scope; let/const stay in the block.
                    def isVarKind:boolean ((node.kind == "var") || ((strlen node.kind) == 0))
                    def target:EvalContext context
                    if isVarKind {
                        target = (context.varScope())
                    }
                    if decl.init {
                        def initNode:TSNode (unwrap decl.init)
                        def value:EvalValue (this.evaluateExpr(initNode))
                        ; D-WITH: a `var`'s INITIALISER is an ordinary assignment
                        ; to the name, so inside a `with` block whose object owns
                        ; that name it writes the PROPERTY -- the declaration
                        ; itself is hoisted out of the block and stays undefined.
                        ; `with (o) { var value = 'x' }` sets o.value, which is
                        ; the whole of §12.10's interaction with declarations.
                        def wHost:EvalValue (this.withHostFor(varName))
                        if (wHost.valueType == 5) {
                            wHost.setMember(varName value)
                            if (false == (context.has(varName))) {
                                target.define(varName (EvalValue.undefined()))
                            }
                        } {
                            if (isVarKind && (context.blockShadowsName(varName))) {
                                ; The catch parameter shadows the function-scoped
                                ; binding, so the initialiser writes IT.
                                context.assign(varName value)
                            } {
                                target.define(varName value)
                                this.syncGlobalVar(varName value)
                            }
                        }
                    } {
                        ; `let x;` with no initializer still creates a binding
                        ; (JS: bound to undefined), so a later reference/assignment
                        ; resolves in this scope rather than falling through --
                        ; but a `var` with no initialiser does NOT overwrite one
                        ; that already exists, which is what lets a hoisted
                        ; function declaration survive `var x;` of the same name.
                        def keepExisting:boolean false
                        if isVarKind {
                            ; The OWN binding of the scope the var belongs to,
                            ; not the whole chain: `var x;` in sloppy eval code
                            ; whose caller sees an outer `x` still creates a
                            ; LOCAL one, and the outer reference the assignment
                            ; already resolved keeps writing outwards.
                            if (target.hasOwnBinding(varName)) {
                                keepExisting = true
                            }
                        }
                        if (false == keepExisting) {
                            target.define(varName (EvalValue.undefined()))
                        }
                    }
                }
            }
            i = i + 1
        }
    }

    ; Bind a destructuring pattern (identifier / array / object / default) to a
    ; value, recursively. Missing array elements / object members read as null in
    ; this interpreter (getIndex/getMember), so a `= default` fires on null or
    ; undefined — matching JS for the common "absent property" case (JS itself
    ; only defaults on undefined; explicit null is the sole practical divergence).
    fn bindPattern:void (pattern:TSNode value:EvalValue) {
        if ((this.nodeKindOf(pattern)) == 1) {
            context.define(pattern.name value)
            return
        }
        if (pattern.nodeType == "AssignmentPattern") {
            def v:EvalValue value
            if ((v.isNull()) || (v.isUndefined())) {
                if pattern.right {
                    v = (this.evaluateExpr((unwrap pattern.right)))
                }
            }
            if pattern.left {
                this.bindPattern((unwrap pattern.left) v)
            }
            return
        }
        if (pattern.nodeType == "ArrayPattern") {
            this.bindArrayPattern(pattern value)
            return
        }
        if (pattern.nodeType == "ObjectPattern") {
            this.bindObjectPatternValue(pattern value)
            return
        }
    }

    fn bindArrayPattern:void (pattern:TSNode value:EvalValue) {
        def idx:int 0
        def ci:int 0
        while (ci < (array_length pattern.children)) {
            def el:TSNode (itemAt pattern.children ci)
            if (el.nodeType == "Elision") {
                idx = (idx + 1)
            } {
                if (el.nodeType == "RestElement") {
                    def items:[EvalValue]
                    if (value.isArray()) {
                        def k:int idx
                        while (k < (array_length value.arrayValue)) {
                            push items (itemAt value.arrayValue k)
                            k = (k + 1)
                        }
                    }
                    def restVal:EvalValue (EvalValue.array(items))
                    ; D-DSTR: a rest element may itself be a pattern —
                    ; `[...[x, y]]` binds x and y from the collected tail. Only
                    ; the plain `...name` form was handled, so the nested case
                    ; bound nothing at all.
                    if el.left {
                        this.bindPattern((unwrap el.left) restVal)
                    } {
                        context.define(el.name restVal)
                    }
                } {
                    def elemVal:EvalValue (EvalValue.undefined())
                    if (value.isArray()) {
                        if (idx < (array_length value.arrayValue)) {
                            elemVal = (itemAt value.arrayValue idx)
                        }
                    } {
                        elemVal = (value.getIndex(idx))
                    }
                    this.bindPattern(el elemVal)
                    idx = (idx + 1)
                }
            }
            ci = (ci + 1)
        }
    }

    fn bindObjectPatternValue:void (pattern:TSNode value:EvalValue) {
        def usedKeys:[string]
        def ci:int 0
        while (ci < (array_length pattern.children)) {
            def prop:TSNode (itemAt pattern.children ci)
            if (prop.nodeType == "RestElement") {
                def rkeys:[string]
                def rvals:[EvalValue]
                if (value.isObject()) {
                    def ks:[string] (keys value.objectMap)
                    def ki:int 0
                    while (ki < (array_length ks)) {
                        def kk:string (itemAt ks ki)
                        if ((this.isInList(kk usedKeys)) == false) {
                            push rkeys kk
                            push rvals (value.getMember(kk))
                        }
                        ki = (ki + 1)
                    }
                }
                context.define(prop.name (EvalValue.object(rkeys rvals)))
            } {
                def srcKey:string prop.name
                push usedKeys srcKey
                def v:EvalValue (value.getMember(srcKey))
                if ((v.isNull()) || (v.isUndefined())) {
                    if prop.init {
                        v = (this.evaluateExpr((unwrap prop.init)))
                    }
                }
                def targetName:string srcKey
                if prop.right {
                    def aliasNode:TSNode (unwrap prop.right)
                    ; D-DSTR: the alias slot may hold a nested PATTERN rather
                    ; than a name — `{a: {b}}` or `{a: [b]}`. Only the rename
                    ; form was handled, so a nested pattern produced an empty
                    ; target name and bound nothing.
                    def an:string aliasNode.nodeType
                    if ((an == "ObjectPattern") || (an == "ArrayPattern") || (an == "AssignmentPattern")) {
                        this.bindPattern(aliasNode v)
                        ci = (ci + 1)
                        continue
                    }
                    targetName = aliasNode.name
                }
                context.define(targetName v)
            }
            ci = (ci + 1)
        }
    }
    
    ; ==========================================================================
    ; Function/Component Evaluation
    ; ==========================================================================
    
    fn evaluateFunction:EVGElement (fnNode:TSNode) {
        ; Create new context for function scope
        def savedContext:EvalContext context
        context = (context.createChild())
        
        ; Process function body
        def body:TSNode (this.getFunctionBody(fnNode))
        def result:EVGElement (this.evaluateFunctionBody(body))
        
        ; Restore context
        context = savedContext
        
        return result
    }
    
    fn evaluateFunctionWithProps:EVGElement (fnNode:TSNode props:EvalValue) {
        ; Create new context for function scope
        def savedContext:EvalContext context
        context = (context.createChild())
        
        ; Process function parameters and bind props
        this.bindFunctionParams(fnNode props)
        
        ; Process function body
        def body:TSNode (this.getFunctionBody(fnNode))
        def result:EVGElement (this.evaluateFunctionBody(body))
        
        ; Restore context
        context = savedContext
        
        return result
    }
    
    ; Evaluate a function call and return the result as EvalValue
    ; This supports functions that return arrays, not just JSX elements
    fn evaluateFunctionCall:EvalValue (fnNode:TSNode props:EvalValue) {
        ; Nested calls (e.g. countAlive() in an if condition) must not leave
        ; scriptDidReturn set — that would skip the rest of the caller body.
        def savedContext:EvalContext context
        def savedDidReturn:boolean scriptDidReturn
        def savedReturnValue:EvalValue scriptReturnValue
        savedDidReturn = scriptDidReturn
        savedReturnValue = scriptReturnValue
        scriptDidReturn = false
        scriptReturnValue = (EvalValue.null())
        context = (context.createChild())
        
        ; Process function parameters and bind props (if any)
        ; valueType 0 = null, so check if props is provided
        if (props.valueType != 0) {
            this.bindFunctionParams(fnNode props)
        }
        
        ; Process function body - evaluating statements and looking for return
        ; D-STRICT: same rule as the other two call paths.
        def savedStrict:boolean strictMode
        strictMode = (this.strictForBody(fnNode))
        callDepth = (callDepth + 1)
        def body:TSNode (this.getFunctionBody(fnNode))
        def result:EvalValue (this.callResultOf((this.evaluateFunctionBodyValue(body))))

        ; Restore caller context and return flags
        strictMode = savedStrict
        callDepth = (callDepth - 1)
        context = savedContext
        scriptDidReturn = savedDidReturn
        scriptReturnValue = savedReturnValue
        
        return result
    }
    
    fn bindFunctionParams:void (fnNode:TSNode props:EvalValue) {
        ; Check function params
        def i:int 0
        while (i < (array_length fnNode.params)) {
            def param:TSNode (itemAt fnNode.params i)
            
            ; Handle destructured params: { color, size = 40 }
            if (param.nodeType == "ObjectPattern") {
                this.bindObjectPattern(param props)
            }
            
            ; Handle simple param: (props)
            if (param.nodeType == "Parameter") {
                context.define(param.name props)
            }
            if ((this.nodeKindOf(param)) == 1) {
                context.define(param.name props)
            }
            
            i = i + 1
        }
    }
    
    fn bindObjectPattern:void (pattern:TSNode props:EvalValue) {
        def i:int 0
        while (i < (array_length pattern.children)) {
            def prop:TSNode (itemAt pattern.children i)
            
            if (prop.nodeType == "Property") {
                def propName:string prop.name
                
                ; Check if prop exists in provided props
                def propValue:EvalValue (props.getMember(propName))

                ; a missing prop now reads as undefined (rule 6); treat null OR
                ; undefined as absent so the default still fires.
                if ((propValue.isNull()) || (propValue.isUndefined())) {
                    ; Use default value if provided
                    if prop.init {
                        def initNode:TSNode (unwrap prop.init)
                        propValue = (this.evaluateExpr(initNode))
                    }
                }
                
                context.define(propName propValue)
            }
            
            i = i + 1
        }
    }
    
    fn getFunctionBody:TSNode (fnNode:TSNode) {
        if fnNode.body {
            return (unwrap fnNode.body)
        }
        def empty (new TSNode())
        return empty
    }
    
    fn evaluateFunctionBody:EVGElement (body:TSNode) {
        def empty (new EVGElement())
        
        ; Process statements
        def i:int 0
        while (i < (array_length body.children)) {
            def stmt:TSNode (itemAt body.children i)
            
            ; Process variable declarations
            if ((this.nodeKindOf(stmt)) == 31) {
                this.processVariableDeclaration(stmt)
            }
            
            ; Process if statement
            if ((this.nodeKindOf(stmt)) == 32) {
                def ifResult:EVGElement (this.evaluateIfStatement(stmt))
                if ifResult.hasReturn {
                    return ifResult
                }
            }
            
            ; Process for loop
            if ((this.nodeKindOf(stmt)) == 33) {
                def forResult:EVGElement (this.evaluateForStatement(stmt))
                if forResult.hasReturn {
                    return forResult
                }
            }
            
            ; Process for...of loop
            if ((this.nodeKindOf(stmt)) == 37) {
                def forOfResult:EVGElement (this.evaluateForOfStatement(stmt))
                if forOfResult.hasReturn {
                    return forOfResult
                }
            }
            
            ; Process while loop
            if ((this.nodeKindOf(stmt)) == 36) {
                def whileResult:EVGElement (this.evaluateWhileStatement(stmt))
                if whileResult.hasReturn {
                    return whileResult
                }
            }
            
            ; Process expression statement (e.g., arr.push(x))
            if ((this.nodeKindOf(stmt)) == 30) {
                if stmt.left {
                    def exprNode:TSNode (unwrap stmt.left)
                    this.evaluateExprForSideEffect(exprNode)
                }
            }
            
            ; Process return statement
            if ((this.nodeKindOf(stmt)) == 35) {
                if stmt.left {
                    def returnExpr:TSNode (unwrap stmt.left)
                    return (this.evaluateJSX(returnExpr))
                } {
                    def bareReturn (new EVGElement())
                    bareReturn.hasReturn = true
                    return bareReturn
                }
            }
            
            i = i + 1
        }
        
        ; Arrow function with expression body
        if ((body.nodeType == "JSXElement") || (body.nodeType == "JSXFragment")) {
            return (this.evaluateJSX(body))
        }
        
        return empty
    }
    
    ; Evaluate function body and return result as EvalValue (not EVGElement)
    ; This allows functions to return arrays, primitives, etc.
    ; D-HOIST: pre-declare every `var` name reachable from these statements
    ; without descending into nested functions -- those have their own scope.
    ; `let` and `const` are deliberately absent: they are in the temporal dead
    ; zone until their declaration runs, which is not what this models.
    fn hoistVarNames:void (stmts:[TSNode]) {
        def i:int 0
        while (i < (array_length stmts)) {
            this.hoistVarsIn((itemAt stmts i) 0)
            i = (i + 1)
        }
    }

    ; PERF: the name DISCOVERY is memoised on the body node — the walk ran
    ; on every single invocation of every function; the names it finds
    ; never change for a given node. Defining them into the fresh call
    ; context is the only per-call work left.
    fn hoistVarNamesMemo:void (body:TSNode) {
        if (false == body.hoistScanned) {
            body.hoistScanned = true
            def found:[string]
            def i:int 0
            while (i < (array_length body.children)) {
                this.hoistCollectIn((itemAt body.children i) 0 found)
                i = (i + 1)
            }
            body.hoistedVarNames = found
        }
        def n:int (array_length body.hoistedVarNames)
        def k:int 0
        while (k < n) {
            def nm:string (itemAt body.hoistedVarNames k)
            if (false == (context.hasOwnBinding(nm))) {
                context.define(nm (EvalValue.undefined()))
            }
            k = (k + 1)
        }
        ; Which of those names get a private value slot in THIS frame. Scanned
        ; once per body node, alongside the hoist memo; marking them on the
        ; fresh context is the only per-call work.
        ;
        ; Never in the GLOBAL scope: a `var` bound there is also a property of
        ; the global object, so `globalThis.i` names the same value object by a
        ; route the body scan cannot see. Frame-local `var`s have no such second
        ; name, which is the whole basis for the slot.
        if (false == context.isGlobalScope) {
            if (false == body.slotScanned) {
                body.slotScanned = true
                body.slotVarNames = (this.slotSafeVarNames(body))
            }
            def sc:int (array_length body.slotVarNames)
            def si:int 0
            while (si < sc) {
                set context.slotNames (itemAt body.slotVarNames si) true
                si = (si + 1)
            }
        }
    }

    ; ---- slot analysis -----------------------------------------------------
    ; Which hoisted `var` names may own a private EvalValue for the whole call.
    ;
    ; The question is not "is this name a number" but "can any OTHER holder ever
    ; see this name's value OBJECT". Numbers are immutable by contract in this
    ; engine, and everything downstream relies on that: `var a = i` makes two
    ; names share one object, and writing through it would change both. So a
    ; name qualifies only when EVERY occurrence of it in the body sits in a
    ; position that reads the NUMBER and cannot retain the object:
    ;
    ;   i++ / --i        the mutation itself
    ;   i + 1, i < n     an arithmetic or relational operand
    ;
    ; Every other position -- an argument, a return, either side of a plain
    ; assignment, an array element, an object property, a member base, a
    ; template hole, anything inside a nested function -- disqualifies the name.
    ; The test is syntactic and pessimistic: an unrecognised node shape counts
    ; as an escape, so a name reaches the fast path only by being understood.
    fn slotSafeVarNames:[string] (body:TSNode) {
        def out:[string]
        ; Candidates are collected here rather than taken from `hoistedVarNames`:
        ; that memo walks only children/body/left/right, so it never sees the
        ; declaration in a `for (var i = 0; ...)` header -- which is exactly the
        ; loop counter this targets. The hoist list is also the wrong SET, since
        ; `let`/`const` counters qualify just as well.
        def names:[string]
        this.collectSlotCandidates(body 0 names)
        def n:int (array_length names)
        if (n == 0) {
            return out
        }
        ; `with` and direct `eval` can reach a binding through text this scan
        ; cannot see, so neither is allowed anywhere in the body.
        if (this.bodyBlocksSlots(body 0)) {
            return out
        }
        def i:int 0
        while (i < n) {
            def nm:string (itemAt names i)
            if ((strlen nm) > 0) {
                if (false == (this.nameEscapesIn(body nm 0))) {
                    push out nm
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; Every name this body DECLARES, at any nesting level below it but not
    ; inside a nested function (those belong to their own frame). A declarator's
    ; identifier is a field on the declarator node, not a child Identifier, so
    ; collecting names here and testing occurrences separately keeps the two
    ; questions apart -- the declaration itself is never an escape.
    fn collectSlotCandidates:void (node:TSNode depth:int out:[string]) {
        if (depth > 24) {
            return
        }
        def k:int (this.nodeKindOf(node))
        if (k == 17) { return }
        if (k == 18) { return }
        if (k == 40) { return }
        if (k == 25) { return }
        if (k == 31) {
            def ci:int 0
            while (ci < (array_length node.children)) {
                def decl:TSNode (itemAt node.children ci)
                def nm:string decl.name
                if ((strlen nm) > 0) {
                    push out nm
                }
                ci = (ci + 1)
            }
            return
        }
        def nd:int (depth + 1)
        def c:int 0
        while (c < (array_length node.children)) {
            this.collectSlotCandidates((itemAt node.children c) nd out)
            c = (c + 1)
        }
        if node.body { this.collectSlotCandidates((unwrap node.body) nd out) }
        if node.left { this.collectSlotCandidates((unwrap node.left) nd out) }
        if node.right { this.collectSlotCandidates((unwrap node.right) nd out) }
        if node.init { this.collectSlotCandidates((unwrap node.init) nd out) }
        if node.test { this.collectSlotCandidates((unwrap node.test) nd out) }
        if node.consequent { this.collectSlotCandidates((unwrap node.consequent) nd out) }
        if node.alternate { this.collectSlotCandidates((unwrap node.alternate) nd out) }
    }

    ; `with` puts an object at the front of the chain and `eval` can name any
    ; binding from text, so either one makes the syntactic scan unsound.
    fn bodyBlocksSlots:boolean (node:TSNode depth:int) {
        if (depth > 40) {
            return true
        }
        if (node.nodeType == "WithStatement") {
            return true
        }
        if (node.name == "eval") {
            return true
        }
        def nd:int (depth + 1)
        def k:int 0
        while (k < (array_length node.children)) {
            if (this.bodyBlocksSlots((itemAt node.children k) nd)) { return true }
            k = (k + 1)
        }
        def p:int 0
        while (p < (array_length node.params)) {
            if (this.bodyBlocksSlots((itemAt node.params p) nd)) { return true }
            p = (p + 1)
        }
        if node.body { if (this.bodyBlocksSlots((unwrap node.body) nd)) { return true } }
        if node.left { if (this.bodyBlocksSlots((unwrap node.left) nd)) { return true } }
        if node.right { if (this.bodyBlocksSlots((unwrap node.right) nd)) { return true } }
        if node.init { if (this.bodyBlocksSlots((unwrap node.init) nd)) { return true } }
        if node.test { if (this.bodyBlocksSlots((unwrap node.test) nd)) { return true } }
        if node.consequent { if (this.bodyBlocksSlots((unwrap node.consequent) nd)) { return true } }
        if node.alternate { if (this.bodyBlocksSlots((unwrap node.alternate) nd)) { return true } }
        return false
    }

    ; True when `name` occurs anywhere in this subtree in a position that could
    ; retain its value object. The PARENT classifies each link, because the
    ; position is what decides -- an Identifier node says nothing on its own.
    fn nameEscapesIn:boolean (node:TSNode name:string depth:int) {
        if (depth > 40) {
            return true
        }
        def k:int (this.nodeKindOf(node))
        ; A nested function may capture the binding and outlive the frame.
        ; Names it merely shadows would be safe, but telling the two apart needs
        ; the nested scope's own declarations -- not worth it for the shapes
        ; this targets, so any mention inside one is an escape.
        if ((k == 17) || (k == 18)) {
            return (this.subtreeMentions(node name (depth + 1)))
        }
        if (k == 40) {
            return (this.subtreeMentions(node name (depth + 1)))
        }
        def nd:int (depth + 1)
        ; i++ / --i: the target is the mutation, not a read of the object.
        if (k == 7) {
            if node.left {
                def upl:TSNode (unwrap node.left)
                if (this.identifierIs(upl name)) {
                    return false
                }
            }
        }
        ; `return i` is NOT an escape. The value object leaves the frame, but
        ; the frame leaves with it: nothing in this body can write the slot
        ; again, so the caller's copy can never be mutated underneath it. (The
        ; next call to this function builds a fresh frame and mints its own.)
        if (k == 35) {
            if node.left {
                def rl:TSNode (unwrap node.left)
                if (this.identifierIs(rl name)) {
                    return false
                }
            }
            if node.right {
                def rr:TSNode (unwrap node.right)
                if (this.identifierIs(rr name)) {
                    return false
                }
            }
        }
        ; `s += i` and friends read the NUMBER out of both sides and store a
        ; fresh result, so neither side leaks an object. Plain `=` is excluded
        ; on purpose: `a = i` makes the two names share one object, and a later
        ; `i++` would then rewrite `a` as well.
        if (k == 6) {
            if (this.slotSafeAssignOp(node.value)) {
                def ae:boolean false
                if node.left {
                    def al:TSNode (unwrap node.left)
                    if (false == (this.identifierIs(al name))) {
                        if (this.nameEscapesIn(al name nd)) { ae = true }
                    }
                }
                if node.right {
                    def ar:TSNode (unwrap node.right)
                    if (false == (this.identifierIs(ar name))) {
                        if (this.nameEscapesIn(ar name nd)) { ae = true }
                    }
                }
                return ae
            }
        }
        ; Arithmetic and relational operands read the NUMBER. `&&`, `||` and
        ; `??` are deliberately not here: their result IS one of the operand
        ; objects, so the value would escape through them.
        if (k == 5) {
            if (this.slotSafeBinaryOp(node.value)) {
                def le:boolean false
                def re:boolean false
                if node.left {
                    def bl:TSNode (unwrap node.left)
                    if (false == (this.identifierIs(bl name))) {
                        le = (this.nameEscapesIn(bl name nd))
                    }
                }
                if node.right {
                    def br:TSNode (unwrap node.right)
                    if (false == (this.identifierIs(br name))) {
                        re = (this.nameEscapesIn(br name nd))
                    }
                }
                if (le || re) {
                    return true
                }
                return false
            }
        }
        ; Any other appearance of the bare name is an escape.
        if (k == 1) {
            if (node.name == name) {
                return true
            }
            return false
        }
        def c:int 0
        while (c < (array_length node.children)) {
            if (this.nameEscapesIn((itemAt node.children c) name nd)) { return true }
            c = (c + 1)
        }
        def p:int 0
        while (p < (array_length node.params)) {
            if (this.nameEscapesIn((itemAt node.params p) name nd)) { return true }
            p = (p + 1)
        }
        if node.body { if (this.nameEscapesIn((unwrap node.body) name nd)) { return true } }
        if node.left { if (this.nameEscapesIn((unwrap node.left) name nd)) { return true } }
        if node.right { if (this.nameEscapesIn((unwrap node.right) name nd)) { return true } }
        if node.init { if (this.nameEscapesIn((unwrap node.init) name nd)) { return true } }
        if node.test { if (this.nameEscapesIn((unwrap node.test) name nd)) { return true } }
        if node.consequent { if (this.nameEscapesIn((unwrap node.consequent) name nd)) { return true } }
        if node.alternate { if (this.nameEscapesIn((unwrap node.alternate) name nd)) { return true } }
        return false
    }

    fn identifierIs:boolean (node:TSNode name:string) {
        if ((this.nodeKindOf(node)) != 1) {
            return false
        }
        return (node.name == name)
    }

    ; Compound arithmetic assignment only. `=` is absent by design (it aliases),
    ; and so are the logical forms `&&=` / `||=` / `??=`, whose result is one of
    ; the operand objects rather than a fresh number.
    fn slotSafeAssignOp:boolean (op:string) {
        if (op == "+=") { return true }
        if (op == "-=") { return true }
        if (op == "*=") { return true }
        if (op == "/=") { return true }
        if (op == "%=") { return true }
        return false
    }

    fn slotSafeBinaryOp:boolean (op:string) {
        if (op == "+") { return true }
        if (op == "-") { return true }
        if (op == "*") { return true }
        if (op == "/") { return true }
        if (op == "%") { return true }
        if (op == "<") { return true }
        if (op == "<=") { return true }
        if (op == ">") { return true }
        if (op == ">=") { return true }
        return false
    }

    ; Does the name appear at all in this subtree, in any position? Used where
    ; the position no longer matters because the subtree itself is unsafe.
    fn subtreeMentions:boolean (node:TSNode name:string depth:int) {
        if (depth > 40) {
            return true
        }
        if (node.name == name) {
            return true
        }
        def nd:int (depth + 1)
        def c:int 0
        while (c < (array_length node.children)) {
            if (this.subtreeMentions((itemAt node.children c) name nd)) { return true }
            c = (c + 1)
        }
        def p:int 0
        while (p < (array_length node.params)) {
            if (this.subtreeMentions((itemAt node.params p) name nd)) { return true }
            p = (p + 1)
        }
        if node.body { if (this.subtreeMentions((unwrap node.body) name nd)) { return true } }
        if node.left { if (this.subtreeMentions((unwrap node.left) name nd)) { return true } }
        if node.right { if (this.subtreeMentions((unwrap node.right) name nd)) { return true } }
        if node.init { if (this.subtreeMentions((unwrap node.init) name nd)) { return true } }
        if node.test { if (this.subtreeMentions((unwrap node.test) name nd)) { return true } }
        if node.consequent { if (this.subtreeMentions((unwrap node.consequent) name nd)) { return true } }
        if node.alternate { if (this.subtreeMentions((unwrap node.alternate) name nd)) { return true } }
        return false
    }

    fn hoistCollectIn:void (node:TSNode depth:int out:[string]) {
        if (depth > 24) {
            return
        }
        def hk:int (this.nodeKindOf(node))
        ; A nested function carries its own vars; stop here.
        if (hk == 40) { return }
        if (hk == 18) { return }
        if (hk == 17) { return }
        if (hk == 25) { return }
        if (hk == 31) {
            if ((node.kind == "var") || ((strlen node.kind) == 0)) {
                def ci:int 0
                while (ci < (array_length node.children)) {
                    def decl:TSNode (itemAt node.children ci)
                    def nm:string decl.name
                    if ((strlen nm) > 0) {
                        push out nm
                    }
                    ci = (ci + 1)
                }
            }
            return
        }
        def nd:int (depth + 1)
        def k:int 0
        while (k < (array_length node.children)) {
            this.hoistCollectIn((itemAt node.children k) nd out)
            k = (k + 1)
        }
        if node.body { this.hoistCollectIn((unwrap node.body) nd out) }
        if node.left { this.hoistCollectIn((unwrap node.left) nd out) }
        if node.right { this.hoistCollectIn((unwrap node.right) nd out) }
    }

    fn hoistVarsIn:void (node:TSNode depth:int) {
        if (depth > 24) {
            return
        }
        def nt:string node.nodeType
        ; A nested function carries its own vars; stop here.
        if (nt == "FunctionDeclaration") { return }
        if (nt == "FunctionExpression") { return }
        if (nt == "ArrowFunctionExpression") { return }
        if (nt == "ClassDeclaration") { return }
        if (nt == "VariableDeclaration") {
            ; The kind lives in `kind`, not `value`. let/const are skipped: they
            ; are in the temporal dead zone until their declaration runs.
            if ((node.kind == "var") || ((strlen node.kind) == 0)) {
                def ci:int 0
                while (ci < (array_length node.children)) {
                    def decl:TSNode (itemAt node.children ci)
                    def nm:string decl.name
                    if ((strlen nm) > 0) {
                        if (false == (context.hasOwnBinding(nm))) {
                            context.define(nm (EvalValue.undefined()))
                        }
                    }
                    ci = (ci + 1)
                }
            }
            return
        }
        def nd:int (depth + 1)
        def k:int 0
        while (k < (array_length node.children)) {
            this.hoistVarsIn((itemAt node.children k) nd)
            k = (k + 1)
        }
        if node.body { this.hoistVarsIn((unwrap node.body) nd) }
        if node.left { this.hoistVarsIn((unwrap node.left) nd) }
        if node.right { this.hoistVarsIn((unwrap node.right) nd) }
    }

    ; A function that falls off its end returns UNDEFINED. The engine models
    ; "no return statement ran" as null, and letting that escape made
    ; `String(f())` answer "null" and every `=== undefined` check on a
    ; procedure's result fail.
    fn callResultOf:EvalValue (v:EvalValue) {
        if (v.valueType == 0) {
            return (EvalValue.undefined())
        }
        return v
    }

    fn evaluateFunctionBodyValue:EvalValue (body:TSNode) {
        ; Value-returning control flow: a `return` inside an if/else or nested
        ; block propagates its value out of the function. Save/restore the flags
        ; so nested function calls during evaluation stay reentrancy-safe.
        if ((this.nodeKindOf(body)) == 34) {
            def savedDidReturn:boolean scriptDidReturn
            def savedReturnValue:EvalValue scriptReturnValue
            scriptDidReturn = false
            scriptReturnValue = (EvalValue.null())
            ; D-HOIST: every `var` in the body exists from the first statement,
            ; holding undefined until its declaration runs. Without this, code
            ; that reads a variable declared LATER -- which the suite does
            ; constantly to check that ToInteger(undefined) is 0 -- raised a
            ; ReferenceError instead.
            this.hoistVarNamesMemo(body)
            this.runStatementList(body.children)
            def blockOut:EvalValue scriptReturnValue
            scriptDidReturn = savedDidReturn
            scriptReturnValue = savedReturnValue
            return blockOut
        }
        ; Non-block (arrow expression) bodies fall through to the tail below.
        def i:int 0
        while (i < (array_length body.children)) {
            def stmt:TSNode (itemAt body.children i)
            
            ; Process variable declarations
            if ((this.nodeKindOf(stmt)) == 31) {
                this.processVariableDeclaration(stmt)
            }
            
            ; Process if statement
            if ((this.nodeKindOf(stmt)) == 32) {
                def ifResult:EVGElement (this.evaluateIfStatement(stmt))
                if ifResult.hasReturn {
                    ; If returned from if statement, need to get the value
                    ; For now, just continue - we'll handle this properly later
                }
            }
            
            ; Process for loop
            if ((this.nodeKindOf(stmt)) == 33) {
                this.runForStatementValue(stmt)
            }
            
            ; Process for...of loop
            if ((this.nodeKindOf(stmt)) == 37) {
                this.runForOfStatementValue(stmt)
            }
            
            ; Process while loop
            if ((this.nodeKindOf(stmt)) == 36) {
                this.runWhileStatementValue(stmt)
            }
            
            ; Process expression statement (e.g., arr.push(x))
            if ((this.nodeKindOf(stmt)) == 30) {
                if stmt.left {
                    def exprNode:TSNode (unwrap stmt.left)
                    this.evaluateExprForSideEffect(exprNode)
                }
            }
            
            ; Process return statement - evaluate as EvalValue
            if ((this.nodeKindOf(stmt)) == 35) {
                if stmt.left {
                    def returnExpr:TSNode (unwrap stmt.left)
                    return (this.evaluateExpr(returnExpr))
                }
                return (EvalValue.null())
            }
            
            i = i + 1
        }
        
        ; Arrow function with expression body
        if ((body.nodeType == "JSXElement") || (body.nodeType == "JSXFragment")) {
            def el:EVGElement (this.evaluateJSX(body))
            return (EvalValue.element(el))
        }
        
        ; If body is a simple expression
        if (((this.nodeKindOf(body)) != 34) && (body.nodeType != "")) {
            return (this.evaluateExpr(body))
        }
        
        return (EvalValue.null())
    }
    
    ; ==========================================================================
    ; If Statement Evaluation
    ; ==========================================================================
    
    ; Void wrappers: assigning loop results to an unused local is dead-code-
    ; eliminated by clang++ (while/for become no-ops in native game_sdl).
    fn runForStatementValue:void (stmt:TSNode) {
        def savedBreak:boolean loopBreak
        def savedContinue:boolean loopContinue
        def myLabels:[string] (this.takeStatementLabels())
        loopBreak = false
        loopContinue = false
        if stmt.init {
            def initNode:TSNode (unwrap stmt.init)
            if ((this.nodeKindOf(initNode)) == 31) {
                this.processVariableDeclaration(initNode)
            } {
                ; The init clause is an ExpressionNoIn when it is not a
                ; declaration -- `for (i = 0; i < 3; i++)`. Only the declaration
                ; form ran, so the counter was never initialised and the loop
                ; body did not execute at all.
                def ignoredInit:EvalValue (this.evaluateExpr(initNode))
                if scriptThrew {
                    loopBreak = savedBreak
                    loopContinue = savedContinue
                    return
                }
            }
        }
        def maxIterations:int maxLoopIterations
        def iterations:int 0
        def looping:boolean true
        while ((iterations < maxIterations) && looping) {
            if (scriptDidReturn || scriptThrew) {
                looping = false
            } {
                def proceed:boolean true
                if stmt.left {
                    def testResult:EvalValue (this.evaluateExpr((unwrap stmt.left)))
                    if ((testResult.toBool()) == false) {
                        proceed = false
                    }
                }
                if (proceed == false) {
                    looping = false
                } {
                    loopContinue = false
                    if stmt.body {
                        this.runBlockOrStatement((unwrap stmt.body))
                    }
                    if (scriptDidReturn || scriptThrew) {
                        looping = false
                    } {
                        if loopBreak {
                            looping = false
                        } {
                            ; D-LABELS: a `continue` naming an OUTER loop stops
                            ; this one WITHOUT running its update clause.
                            if (this.continueEscapes(myLabels)) {
                                looping = false
                            } {
                                ; `continue` still runs the update clause.
                                if stmt.right {
                                    this.evaluateUpdateExpr((unwrap stmt.right))
                                }
                                iterations = iterations + 1
                            }
                        }
                    }
                }
            }
        }
        ; Consume break/continue at the loop boundary (do not leak to outer loop)
        ; unless it names a label further out -- see settleLoopAbrupt.
        this.settleLoopAbrupt(myLabels savedBreak savedContinue)
    }
    fn runForOfStatementValue:void (stmt:TSNode) {
        def savedBreak:boolean loopBreak
        def savedContinue:boolean loopContinue
        def myLabels:[string] (this.takeStatementLabels())
        loopBreak = false
        loopContinue = false
        ; Loop target: a scalar name or a destructuring pattern (for [k,v] of map).
        def varName:string ""
        def varPattern@(optional):TSNode
        if stmt.left {
            def leftNode:TSNode (unwrap stmt.left)
            if ((this.nodeKindOf(leftNode)) == 31) {
                if ((array_length leftNode.children) > 0) {
                    def decl:TSNode (itemAt leftNode.children 0)
                    varName = decl.name
                    if decl.left {
                        varPattern = (unwrap decl.left)
                    }
                }
            }
        }
        if stmt.right {
            def rightNode:TSNode (unwrap stmt.right)
            def src:EvalValue (this.evaluateExpr(rightNode))
            ; Normalise any iterable to a list of per-iteration values: array/Set
            ; elements as-is, Map entries as [key, value] pairs, string chars.
            def items:[EvalValue]
            if (src.isArray()) {
                items = src.arrayValue
            } {
                if (src.isSet()) {
                    items = src.arrayValue
                } {
                    if (src.isMap()) {
                        def k:int 0
                        while (k < (array_length src.arrayValue)) {
                            def pair:[EvalValue]
                            push pair (itemAt src.arrayValue k)
                            push pair (itemAt src.mapVals k)
                            push items (EvalValue.array(pair))
                            k = (k + 1)
                        }
                    } {
                        if (src.isString()) {
                            def si:int 0
                            while (si < (strlen src.stringValue)) {
                                push items (EvalValue.string((substring src.stringValue si (si + 1))))
                                si = (si + 1)
                            }
                        }
                    }
                }
            }
            def i:int 0
            def looping:boolean true
            while ((i < (array_length items)) && looping) {
                if (scriptDidReturn || scriptThrew) {
                    looping = false
                } {
                    if loopBreak {
                        looping = false
                    } {
                        def item:EvalValue (itemAt items i)
                        if varPattern {
                            this.bindPattern((unwrap varPattern) item)
                        } {
                            if ((strlen varName) > 0) {
                                context.define(varName item)
                            }
                        }
                        loopContinue = false
                        if stmt.body {
                            this.runBlockOrStatement((unwrap stmt.body))
                        }
                        if (scriptDidReturn || scriptThrew) {
                            looping = false
                        } {
                            if loopBreak {
                                looping = false
                            } {
                                if (this.continueEscapes(myLabels)) {
                                    looping = false
                                } {
                                    i = i + 1
                                }
                            }
                        }
                    }
                }
            }
        }
        this.settleLoopAbrupt(myLabels savedBreak savedContinue)
    }
    fn runWhileStatementValue:void (stmt:TSNode) {
        def savedBreak:boolean loopBreak
        def savedContinue:boolean loopContinue
        def myLabels:[string] (this.takeStatementLabels())
        loopBreak = false
        loopContinue = false
        def maxIterations:int maxLoopIterations
        def iterations:int 0
        def looping:boolean true
        while ((iterations < maxIterations) && looping) {
            if (scriptDidReturn || scriptThrew) {
                looping = false
            } {
                def proceed:boolean true
                if stmt.left {
                    def testResult:EvalValue (this.evaluateExpr((unwrap stmt.left)))
                    if ((testResult.toBool()) == false) {
                        proceed = false
                    }
                }
                if (proceed == false) {
                    looping = false
                } {
                    loopContinue = false
                    if stmt.body {
                        this.runBlockOrStatement((unwrap stmt.body))
                    }
                    if (scriptDidReturn || scriptThrew) {
                        looping = false
                    } {
                        if loopBreak {
                            looping = false
                        } {
                            if (this.continueEscapes(myLabels)) {
                                looping = false
                            } {
                                iterations = iterations + 1
                            }
                        }
                    }
                }
            }
        }
        this.settleLoopAbrupt(myLabels savedBreak savedContinue)
    }

    ; switch(disc){ case v: ... [break] ; default: ... }. JS fall-through: once a
    ; case matches (or default, if none match) execution runs from there onward
    ; until a break/return/continue. `break` ends the switch (consumed here);
    ; `continue`/`return` propagate to the enclosing loop/function.
    fn runSwitchStatementValue:void (stmt:TSNode) {
        def savedBreak:boolean loopBreak
        def myLabels:[string] (this.takeStatementLabels())
        loopBreak = false
        def disc:EvalValue (EvalValue.null())
        if stmt.left {
            disc = (this.evaluateExpr((unwrap stmt.left)))
        }
        def n:int (array_length stmt.children)
        def matchIdx:int (0 - 1)
        def defaultIdx:int (0 - 1)
        def ci:int 0
        while (ci < n) {
            def caseNode:TSNode (itemAt stmt.children ci)
            if (caseNode.kind == "default") {
                defaultIdx = ci
            } {
                if caseNode.left {
                    def testVal:EvalValue (this.evaluateExpr((unwrap caseNode.left)))
                    if (disc.equals(testVal)) {
                        if (matchIdx < 0) {
                            matchIdx = ci
                        }
                    }
                }
            }
            ci = (ci + 1)
        }
        def startIdx:int matchIdx
        if (startIdx < 0) {
            startIdx = defaultIdx
        }
        if (startIdx >= 0) {
            def si:int startIdx
            def running:boolean true
            while ((si < n) && running) {
                def cn:TSNode (itemAt stmt.children si)
                this.runStatementList(cn.children)
                if (scriptDidReturn || scriptThrew) {
                    running = false
                } {
                    if loopBreak {
                        running = false
                    } {
                        if loopContinue {
                            running = false
                        } {
                            si = (si + 1)
                        }
                    }
                }
            }
        }
        ; Consume a switch-level break only; leave continue/return for the caller.
        ; D-LABELS: a break naming an outer label is not this switch's to consume.
        if loopBreak {
            if (this.labelIsMine(myLabels breakLabel)) {
                loopBreak = savedBreak
                breakLabel = ""
            }
        }
    }

    ; do { body } while (test) — body runs at least once.
    fn runDoWhileStatementValue:void (stmt:TSNode) {
        def savedBreak:boolean loopBreak
        def savedContinue:boolean loopContinue
        def myLabels:[string] (this.takeStatementLabels())
        loopBreak = false
        loopContinue = false
        def maxIterations:int maxLoopIterations
        def iterations:int 0
        def looping:boolean true
        while ((iterations < maxIterations) && looping) {
            if (scriptDidReturn || scriptThrew) {
                looping = false
            } {
                loopContinue = false
                if stmt.body {
                    this.runBlockOrStatement((unwrap stmt.body))
                }
                if (scriptDidReturn || scriptThrew) {
                    looping = false
                } {
                    if loopBreak {
                        looping = false
                    } {
                        if (this.continueEscapes(myLabels)) {
                            looping = false
                        } {
                            def proceed:boolean false
                            if stmt.left {
                                def testResult:EvalValue (this.evaluateExpr((unwrap stmt.left)))
                                if (testResult.toBool()) {
                                    proceed = true
                                }
                            }
                            if (proceed == false) {
                                looping = false
                            } {
                                iterations = (iterations + 1)
                            }
                        }
                    }
                }
            }
        }
        this.settleLoopAbrupt(myLabels savedBreak savedContinue)
    }

    ; for (k in obj/array) — iterates string keys of an object, or index strings
    ; ("0","1",...) of an array, matching JS for-in.
    fn runForInStatementValue:void (stmt:TSNode) {
        def savedBreak:boolean loopBreak
        def savedContinue:boolean loopContinue
        def myLabels:[string] (this.takeStatementLabels())
        loopBreak = false
        loopContinue = false
        def varName:string ""
        ; D-FORIN: the target may be an existing binding rather than a fresh
        ; declaration -- `var k; for (k in o)`. Only the declaration form was
        ; read, so the loop ran its body with `k` never assigned.
        def declaresVar:boolean false
        if stmt.left {
            def leftNode:TSNode (unwrap stmt.left)
            if ((this.nodeKindOf(leftNode)) == 31) {
                if ((array_length leftNode.children) > 0) {
                    def decl:TSNode (itemAt leftNode.children 0)
                    varName = decl.name
                    declaresVar = true
                }
            } {
                if ((this.nodeKindOf(leftNode)) == 1) {
                    varName = leftNode.name
                }
                if ((this.nodeKindOf(leftNode)) == 30) {
                    if leftNode.left {
                        def inner:TSNode (unwrap leftNode.left)
                        if ((this.nodeKindOf(inner)) == 1) {
                            varName = inner.name
                        }
                    }
                }
            }
        }
        if stmt.right {
            def rightNode:TSNode (unwrap stmt.right)
            def target:EvalValue (this.evaluateExpr(rightNode))
            def theKeys:[string]
            ; D-ATTRS: for-in visits ENUMERABLE properties only, never the
            ; engine's internal bookkeeping keys, and it walks the PROTOTYPE
            ; CHAIN -- a property put on Boolean.prototype shows up in a for-in
            ; over a Boolean object. A name already seen nearer the object
            ; shadows the inherited one, whether or not the nearer one was
            ; enumerable.
            def seenKeys:[string:boolean]
            def walkIn:EvalValue target
            def inSteps:int 0
            while (inSteps < 16) {
                def rawKeys:[string] (this.objectEnumerableKeys(walkIn))
                def ki:int 0
                while (ki < (array_length rawKeys)) {
                    def rk:string (itemAt rawKeys ki)
                    if (false == (this.isHiddenInstanceKey(rk))) {
                        if (false == (has seenKeys rk)) {
                            set seenKeys rk true
                            push theKeys rk
                        }
                    }
                    ki = (ki + 1)
                }
                ; A non-enumerable own property still shadows an inherited one.
                def shadow:[string] (this.objectKeys(walkIn))
                def si2:int 0
                while (si2 < (array_length shadow)) {
                    set seenKeys (itemAt shadow si2) true
                    si2 = (si2 + 1)
                }
                def nextIn:EvalValue (this.protoOfValue(walkIn))
                if (nextIn.isNull()) {
                    inSteps = 16
                } {
                    walkIn = nextIn
                    inSteps = (inSteps + 1)
                }
            }
            def i:int 0
            def looping:boolean true
            while ((i < (array_length theKeys)) && looping) {
                if (scriptDidReturn || scriptThrew) {
                    looping = false
                } {
                    if loopBreak {
                        looping = false
                    } {
                        def k:string (itemAt theKeys i)
                        ; D-FORIN: a property DELETED before it is reached is
                        ; not visited. The key list is snapshotted at entry, so
                        ; a name the body removed was still handed out.
                        def stillThere:boolean true
                        if (target.valueType == 5) {
                            stillThere = (this.objHasKeyUpChain(target k))
                        }
                        if (false == stillThere) {
                            i = (i + 1)
                        } {
                            if ((strlen varName) > 0) {
                                if declaresVar {
                                    context.define(varName (EvalValue.string(k)))
                                } {
                                    ; An existing binding is ASSIGNED, not
                                    ; shadowed -- the name outlives the loop.
                                    context.assign(varName (EvalValue.string(k)))
                                    this.syncGlobalVar(varName (EvalValue.string(k)))
                                }
                            }
                            loopContinue = false
                            if stmt.body {
                                this.runBlockOrStatement((unwrap stmt.body))
                            }
                            if (scriptDidReturn || scriptThrew) {
                                looping = false
                            } {
                                if loopBreak {
                                    looping = false
                                } {
                                    if (this.continueEscapes(myLabels)) {
                                        looping = false
                                    } {
                                        i = (i + 1)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        this.settleLoopAbrupt(myLabels savedBreak savedContinue)
    }

    ; D-FORIN: whether a name is still present on the object or anywhere up its
    ; prototype chain, which is what decides if a snapshotted for-in key is
    ; still worth visiting.
    fn objHasKeyUpChain:boolean (obj:EvalValue key:string) {
        def walk:EvalValue obj
        def steps:int 0
        while (steps < 16) {
            if (has walk.objectMap key) { return true }
            if (has walk.getterMap key) { return true }
            if (has walk.setterMap key) { return true }
            if (this.objHasKey(walk key)) { return true }
            def nxt:EvalValue (this.protoOfValue(walk))
            if (nxt.isNull()) {
                return false
            }
            walk = nxt
            steps = (steps + 1)
        }
        return false
    }

    ; --------------------------------------------------------------------------
    ; Value-returning statement execution (used by evaluateFunctionBodyValue).
    ; A `return` anywhere - including inside if/else and nested blocks - sets
    ; scriptReturnValue and halts execution, so script control flow (e.g. a game
    ; reducer's onButton) returns the correct value.
    ; --------------------------------------------------------------------------
    ; D-LABELS: the labels attached to the statement about to run, claimed by it.
    fn takeStatementLabels:[string] () {
        def out:[string] pendingLabels
        def fresh:[string]
        pendingLabels = fresh
        return out
    }

    fn clearStatementLabels:void () {
        def fresh2:[string]
        pendingLabels = fresh2
    }

    ; True when a pending labelled break/continue names THIS statement. The
    ; unlabelled form names the nearest enclosing loop, which is always this one.
    fn labelIsMine:boolean (labels:[string] name:string) {
        if ((strlen name) == 0) {
            return true
        }
        def i:int 0
        while (i < (array_length labels)) {
            if ((itemAt labels i) == name) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; D-LABELS: the tail every loop runs. A break/continue aimed at an OUTER
    ; label passes straight through -- the loop has stopped, and the flag stays
    ; set for the statement that owns the label to consume.
    fn settleLoopAbrupt:void (labels:[string] savedBreak:boolean savedContinue:boolean) {
        if loopBreak {
            if (this.labelIsMine(labels breakLabel)) {
                loopBreak = savedBreak
                breakLabel = ""
            }
        } {
            loopBreak = savedBreak
        }
        if loopContinue {
            if (this.labelIsMine(labels continueLabel)) {
                loopContinue = savedContinue
                continueLabel = ""
            }
        } {
            loopContinue = savedContinue
        }
    }

    ; True when a pending `continue` belongs to some OUTER statement, so this
    ; loop must stop rather than start its next iteration.
    fn continueEscapes:boolean (labels:[string]) {
        if (false == loopContinue) {
            return false
        }
        if (this.labelIsMine(labels continueLabel)) {
            continueLabel = ""
            return false
        }
        return true
    }

    fn runStatementList:void (stmts:[TSNode]) {
        ; D-FNHOIST: function declarations inside a body are hoisted to the top of
        ; that body and bound in the ENCLOSING scope, so they are callable before
        ; their own line and can recurse. Without this a nested `function f() {}`
        ; was skipped entirely — the declaration ran nowhere and `f()` resolved to
        ; nothing, which is a large blind spot: it is the ordinary way to write a
        ; helper inside a function.
        this.hoistFunctionDeclarations(stmts)
        def i:int 0
        while (i < (array_length stmts)) {
            ; Stop the block on return, a pending throw, or a loop break/continue
            ; so the rest of the block is skipped (an enclosing loop / try consumes
            ; the flag).
            if (scriptDidReturn || scriptThrew) {
                return
            }
            if scriptThrew {
                return
            }
            if loopBreak {
                return
            }
            if loopContinue {
                return
            }
            this.runStatementValue((itemAt stmts i))
            i = i + 1
        }
    }

    ; Bind every FunctionDeclaration in a statement list into the current scope,
    ; before any of the list runs. The value is a closure over the current scope
    ; so the function sees its siblings and itself (recursion).
    fn hoistFunctionDeclarations:void (stmts:[TSNode]) {
        def i:int 0
        while (i < (array_length stmts)) {
            def s:TSNode (itemAt stmts i)
            if ((this.nodeKindOf(s)) == 40) {
                if ((strlen s.name) > 0) {
                    ; D-CATCHVAR: the CLOSURE is over the current scope -- the
                    ; body must see a catch parameter or a with object -- but the
                    ; BINDING is function-scoped, so it goes to the same place a
                    ; `var` would and outlives the block.
                    def fnScope:EvalContext (context.varScope())
                    fnScope.define(s.name (this.captureClosure(s)))
                }
            }
            ; D-CLASSHOIST: a class declared inside a body was skipped the same
            ; way a nested function was — `new A()` found nothing. Registering it
            ; in the class table makes `new` resolve it. The table is keyed by
            ; name rather than scoped, so an inner class is visible wider than
            ; the spec allows; that is strictly better than not resolving at all,
            ; and shadowing follows declaration order as it would anyway.
            if ((this.nodeKindOf(s)) == 25) {
                if ((strlen s.name) > 0) {
                    set classes s.name s
                }
            }
            i = (i + 1)
        }
    }

    ; PERF: nodeType dispatch was a string-compare chain on EVERY node visit.
    ; A string compare is a memcmp on the native targets, where V8 compares
    ; interned pointers for free -- so the natives paid for dispatch in a way
    ; JS never did. The kind is computed ONCE per node, memoised on it, and
    ; every hot dispatcher compares small integers instead. 0 = unscanned,
    ; 99 = a type outside the table (JSX, TS casts, rare statements).
    ; PERF: operator dispatch, same story as nodeKindOf — the operator
    ; string of a Binary/Assignment/Update/Unary expression is compared
    ; against up to forty literals per evaluation. Computed once per node,
    ; memoised, integer compares after that. 0 = unscanned, 99 = other.
    fn opKindOf:int (node:TSNode) {
        if (node.evalOpKind > 0) {
            return node.evalOpKind
        }
        def ov:string node.value
        if (ov == "=") { node.evalOpKind = 1
            return 1
        }
        if (ov == "+=") { node.evalOpKind = 2
            return 2
        }
        if (ov == "-=") { node.evalOpKind = 3
            return 3
        }
        if (ov == "*=") { node.evalOpKind = 4
            return 4
        }
        if (ov == "/=") { node.evalOpKind = 5
            return 5
        }
        if (ov == "%=") { node.evalOpKind = 6
            return 6
        }
        if (ov == "**=") { node.evalOpKind = 7
            return 7
        }
        if (ov == "<<=") { node.evalOpKind = 8
            return 8
        }
        if (ov == ">>=") { node.evalOpKind = 9
            return 9
        }
        if (ov == ">>>=") { node.evalOpKind = 10
            return 10
        }
        if (ov == "&=") { node.evalOpKind = 11
            return 11
        }
        if (ov == "|=") { node.evalOpKind = 12
            return 12
        }
        if (ov == "^=") { node.evalOpKind = 13
            return 13
        }
        if (ov == "&&=") { node.evalOpKind = 14
            return 14
        }
        if (ov == "||=") { node.evalOpKind = 15
            return 15
        }
        if (ov == "??=") { node.evalOpKind = 16
            return 16
        }
        if (ov == "++") { node.evalOpKind = 17
            return 17
        }
        if (ov == "--") { node.evalOpKind = 18
            return 18
        }
        if (ov == "+") { node.evalOpKind = 20
            return 20
        }
        if (ov == "-") { node.evalOpKind = 21
            return 21
        }
        if (ov == "*") { node.evalOpKind = 22
            return 22
        }
        if (ov == "/") { node.evalOpKind = 23
            return 23
        }
        if (ov == "%") { node.evalOpKind = 24
            return 24
        }
        if (ov == "**") { node.evalOpKind = 25
            return 25
        }
        if (ov == "<") { node.evalOpKind = 26
            return 26
        }
        if (ov == ">") { node.evalOpKind = 27
            return 27
        }
        if (ov == "<=") { node.evalOpKind = 28
            return 28
        }
        if (ov == ">=") { node.evalOpKind = 29
            return 29
        }
        if (ov == "==") { node.evalOpKind = 30
            return 30
        }
        if (ov == "!=") { node.evalOpKind = 31
            return 31
        }
        if (ov == "===") { node.evalOpKind = 32
            return 32
        }
        if (ov == "!==") { node.evalOpKind = 33
            return 33
        }
        if (ov == "&&") { node.evalOpKind = 34
            return 34
        }
        if (ov == "||") { node.evalOpKind = 35
            return 35
        }
        if (ov == "??") { node.evalOpKind = 36
            return 36
        }
        if (ov == "&") { node.evalOpKind = 37
            return 37
        }
        if (ov == "|") { node.evalOpKind = 38
            return 38
        }
        if (ov == "^") { node.evalOpKind = 39
            return 39
        }
        if (ov == "<<") { node.evalOpKind = 40
            return 40
        }
        if (ov == ">>") { node.evalOpKind = 41
            return 41
        }
        if (ov == ">>>") { node.evalOpKind = 42
            return 42
        }
        if (ov == "in") { node.evalOpKind = 43
            return 43
        }
        if (ov == "instanceof") { node.evalOpKind = 44
            return 44
        }
        if (ov == "typeof") { node.evalOpKind = 46
            return 46
        }
        if (ov == "delete") { node.evalOpKind = 47
            return 47
        }
        if (ov == "void") { node.evalOpKind = 48
            return 48
        }
        if (ov == "!") { node.evalOpKind = 49
            return 49
        }
        if (ov == "~") { node.evalOpKind = 50
            return 50
        }
        node.evalOpKind = 99
        return 99
    }

    fn nodeKindOf:int (node:TSNode) {
        if (node.evalKind > 0) {
            return node.evalKind
        }
        def nt:string node.nodeType
        if (nt == "Identifier") { node.evalKind = 1
            return 1
        }
        if (nt == "NumericLiteral") { node.evalKind = 2
            return 2
        }
        if (nt == "MemberExpression") { node.evalKind = 3
            return 3
        }
        if (nt == "CallExpression") { node.evalKind = 4
            return 4
        }
        if (nt == "BinaryExpression") { node.evalKind = 5
            return 5
        }
        if (nt == "AssignmentExpression") { node.evalKind = 6
            return 6
        }
        if (nt == "UpdateExpression") { node.evalKind = 7
            return 7
        }
        if (nt == "StringLiteral") { node.evalKind = 8
            return 8
        }
        if (nt == "BooleanLiteral") { node.evalKind = 9
            return 9
        }
        if (nt == "NullLiteral") { node.evalKind = 10
            return 10
        }
        if (nt == "TemplateLiteral") { node.evalKind = 11
            return 11
        }
        if (nt == "UnaryExpression") { node.evalKind = 12
            return 12
        }
        if (nt == "ConditionalExpression") { node.evalKind = 13
            return 13
        }
        if (nt == "ArrayExpression") { node.evalKind = 14
            return 14
        }
        if (nt == "ObjectExpression") { node.evalKind = 15
            return 15
        }
        if (nt == "NewExpression") { node.evalKind = 16
            return 16
        }
        if (nt == "ArrowFunctionExpression") { node.evalKind = 17
            return 17
        }
        if (nt == "FunctionExpression") { node.evalKind = 18
            return 18
        }
        if (nt == "SequenceExpression") { node.evalKind = 19
            return 19
        }
        if (nt == "ThisExpression") { node.evalKind = 20
            return 20
        }
        if (nt == "RegExpLiteral") { node.evalKind = 21
            return 21
        }
        if (nt == "ArrayHole") { node.evalKind = 22
            return 22
        }
        if (nt == "ParenthesizedExpression") { node.evalKind = 23
            return 23
        }
        if (nt == "ClassExpression") { node.evalKind = 24
            return 24
        }
        if (nt == "ClassDeclaration") { node.evalKind = 25
            return 25
        }
        if (nt == "ExpressionStatement") { node.evalKind = 30
            return 30
        }
        if (nt == "VariableDeclaration") { node.evalKind = 31
            return 31
        }
        if (nt == "IfStatement") { node.evalKind = 32
            return 32
        }
        if (nt == "ForStatement") { node.evalKind = 33
            return 33
        }
        if (nt == "BlockStatement") { node.evalKind = 34
            return 34
        }
        if (nt == "ReturnStatement") { node.evalKind = 35
            return 35
        }
        if (nt == "WhileStatement") { node.evalKind = 36
            return 36
        }
        if (nt == "ForOfStatement") { node.evalKind = 37
            return 37
        }
        if (nt == "BreakStatement") { node.evalKind = 38
            return 38
        }
        if (nt == "ContinueStatement") { node.evalKind = 39
            return 39
        }
        if (nt == "FunctionDeclaration") { node.evalKind = 40
            return 40
        }
        if (nt == "LabeledStatement") { node.evalKind = 41
            return 41
        }
        if (nt == "SwitchStatement") { node.evalKind = 42
            return 42
        }
        if (nt == "DoWhileStatement") { node.evalKind = 43
            return 43
        }
        if (nt == "ForInStatement") { node.evalKind = 44
            return 44
        }
        if (nt == "ThrowStatement") { node.evalKind = 45
            return 45
        }
        if (nt == "TryStatement") { node.evalKind = 46
            return 46
        }
        node.evalKind = 99
        return 99
    }

    fn runStatementValue:void (stmt:TSNode) {
        if (scriptDidReturn || scriptThrew) {
            return
        }
        def stmtK:int (this.nodeKindOf(stmt))
        ; Already bound by hoisting; the declaration itself does nothing here.
        if (stmtK == 40) {
            return
        }
        if (stmtK == 35) {
            if stmt.left {
                scriptReturnValue = (this.evaluateExpr((unwrap stmt.left)))
            } {
                scriptReturnValue = (EvalValue.null())
            }
            ; D-THROW: if evaluating the returned expression threw, the function
            ; did NOT return — it is unwinding. Setting scriptDidReturn here as
            ; well left both flags raised, and an enclosing catch handler is a
            ; statement list, which stops immediately on a pending return. The
            ; result was that `try { return f(); } catch (e) { ... }` silently
            ; skipped its own handler whenever f threw.
            if scriptThrew {
                return
            }
            scriptDidReturn = true
            return
        }
        if (stmtK == 31) {
            this.processVariableDeclaration(stmt)
            return
        }
        if (stmtK == 30) {
            if stmt.left {
                this.evaluateExprForSideEffect((unwrap stmt.left))
            }
            return
        }
        if (stmtK == 32) {
            this.runIfValue(stmt)
            return
        }
        if (stmtK == 34) {
            this.clearStatementLabels()
            this.runStatementList(stmt.children)
            return
        }
        if (stmtK == 38) {
            loopBreak = true
            breakLabel = stmt.name
            return
        }
        if (stmtK == 39) {
            loopContinue = true
            continueLabel = stmt.name
            return
        }
        ; D-LABELS: `label: statement`. The label is offered to the statement
        ; that follows -- a loop claims it -- and a break that names THIS label
        ; is consumed here, which is what makes `blk: { break blk; }` leave the
        ; block rather than the whole function. There was no case for the node
        ; type at all, so a labelled statement ran nothing whatsoever.
        if (stmtK == 41) {
            push pendingLabels stmt.name
            if stmt.body {
                this.runBlockOrStatement((unwrap stmt.body))
            }
            this.clearStatementLabels()
            if loopBreak {
                if (breakLabel == stmt.name) {
                    loopBreak = false
                    breakLabel = ""
                }
            }
            return
        }
        if (stmtK == 33) {
            this.runForStatementValue(stmt)
            return
        }
        if (stmtK == 37) {
            this.runForOfStatementValue(stmt)
            return
        }
        if (stmtK == 36) {
            this.runWhileStatementValue(stmt)
            return
        }
        if (stmtK == 42) {
            this.runSwitchStatementValue(stmt)
            return
        }
        if (stmtK == 43) {
            this.runDoWhileStatementValue(stmt)
            return
        }
        if (stmtK == 44) {
            this.runForInStatementValue(stmt)
            return
        }
        if (stmtK == 45) {
            if stmt.left {
                def thrownV:EvalValue (this.evaluateExpr((unwrap stmt.left)))
                ; A throw raised while EVALUATING the operand is the one that
                ; propagates. Overwriting it with the operand's (undefined)
                ; value replaced the real exception -- which is exactly what
                ; `throw new Error("x" + (new RegExp("a**")))` is written to
                ; catch, and the reason a whole family of pattern-validation
                ; tests saw an Error where they expected a SyntaxError.
                if scriptThrew {
                    return
                }
                scriptThrowValue = thrownV
            } {
                scriptThrowValue = (EvalValue.undefined())
            }
            scriptThrew = true
            return
        }
        if (stmtK == 46) {
            this.runTryStatementValue(stmt)
            return
        }
        ; D-WITH: evaluate the object, push a scope fronted by it, run the body.
        if (stmt.nodeType == "WithStatement") {
            if stmt.left {
                def wRaw:EvalValue (this.evaluateExpr((unwrap stmt.left)))
                if ((wRaw.isNull()) || (wRaw.isUndefined())) {
                    def _w:EvalValue (this.throwSpecError("TypeError" "with(...) requires an object"))
                    return
                }
                ; D-WITH: the operand goes through ToObject, so a primitive is
                ; boxed rather than rejected — only null and undefined throw.
                def wObj:EvalValue wRaw
                if (wRaw.valueType == 2) { wObj = (this.makeWrapper("String" wRaw)) }
                if (wRaw.valueType == 1) { wObj = (this.makeWrapper("Number" wRaw)) }
                if (wRaw.valueType == 3) { wObj = (this.makeWrapper("Boolean" wRaw)) }
                def savedW:EvalContext context
                context = (context.createChild())
                anyWithScope = true
                context.withObject = wObj
                if stmt.body {
                    this.runBlockOrStatement((unwrap stmt.body))
                }
                ; D-WITH: `var` inside the body belongs to the enclosing
                ; function/global scope, not to the with scope, which exists
                ; only for the duration of the statement. Bindings created in
                ; it are therefore lifted out before it is discarded.
                def liftKeys:[string] (keys context.bindings)
                def li:int 0
                while (li < (array_length liftKeys)) {
                    def lk:string (itemAt liftKeys li)
                    def lv:EvalValue (unwrap (get context.bindings lk))
                    savedW.assign(lk lv)
                    ; D-GLOBALTHIS: a `var` lifted out of a with block at the
                    ; top level is a script var like any other, so it has to
                    ; become a property of the global object too. The lift ran
                    ; after the with scope was already the current one, so
                    ; syncGlobalVar saw a non-global owner and skipped it.
                    def savedLiftCtx:EvalContext context
                    context = savedW
                    this.syncGlobalVar(lk lv)
                    context = savedLiftCtx
                    li = (li + 1)
                }
                context = savedW
            }
            return
        }
    }

    ; try { body } catch (e) { handler } finally { cleanup }. A throw in the body
    ; is caught (scriptThrew cleared, e bound to the thrown value) and the handler
    ; runs; finally always runs and a throw/return inside it takes precedence.
    fn runTryStatementValue:void (stmt:TSNode) {
        if stmt.body {
            this.runBlockOrStatement((unwrap stmt.body))
        }
        ; catch clause (node.left = CatchClause)
        if scriptThrew {
            if stmt.left {
                def catchNode:TSNode (unwrap stmt.left)
                if (catchNode.nodeType == "CatchClause") {
                    def thrown:EvalValue scriptThrowValue
                    scriptThrew = false
                    scriptThrowValue = (EvalValue.null())
                    def savedContext:EvalContext context
                    context = (context.createChild())
                    ; D-CATCHVAR: §12.14 -- the catch scope holds the PARAMETER
                    ; and nothing else. A `var` declared in the handler belongs
                    ; to the enclosing function scope and outlives the clause.
                    context.isBlockScope = true
                    if ((strlen catchNode.name) > 0) {
                        context.define(catchNode.name thrown)
                    }
                    if catchNode.body {
                        this.runBlockOrStatement((unwrap catchNode.body))
                    }
                    context = savedContext
                }
            }
        }
        ; D-FINALLY: the finally block runs whatever the try/catch did -- a
        ; `return`, `break`, `continue` or pending throw included. That is the
        ; whole point of the clause, and it did not happen: every statement path
        ; bails the moment one of those flags is set, so the block was reached
        ; and then immediately skipped. The pending completion is set ASIDE for
        ; the duration, and restored afterwards unless the finally produced an
        ; abrupt completion of its own -- which per spec replaces it, so
        ; `try { return 1 } finally { return 2 }` is 2 and
        ; `try { throw x } finally { break }` leaves the loop with no exception.
        if stmt.right {
            def pendReturn:boolean scriptDidReturn
            def pendReturnVal:EvalValue scriptReturnValue
            def pendThrew:boolean scriptThrew
            def pendThrowVal:EvalValue scriptThrowValue
            def pendBreak:boolean loopBreak
            def pendContinue:boolean loopContinue
            scriptDidReturn = false
            scriptReturnValue = (EvalValue.null())
            scriptThrew = false
            scriptThrowValue = (EvalValue.null())
            loopBreak = false
            loopContinue = false
            this.runBlockOrStatement((unwrap stmt.right))
            def finallyAbrupt:boolean false
            if scriptDidReturn { finallyAbrupt = true }
            if scriptThrew { finallyAbrupt = true }
            if loopBreak { finallyAbrupt = true }
            if loopContinue { finallyAbrupt = true }
            if (false == finallyAbrupt) {
                scriptDidReturn = pendReturn
                scriptReturnValue = pendReturnVal
                scriptThrew = pendThrew
                scriptThrowValue = pendThrowVal
                loopBreak = pendBreak
                loopContinue = pendContinue
            }
        }
    }

    ; D-COMPLETION: an `if` completes with UpdateEmpty(branch, UNDEFINED) --
    ; §13.6.7. When the branch it took produced no value of its own (a `break`,
    ; a declaration, a missing else) the `if` answers undefined rather than
    ; letting the previous statement's value stand. That single rule is what
    ; makes `eval("for (var i = 0;;) { if (i === 5) break; else i++; }")`
    ; undefined while `eval("for (var i = 0; i < 3; i++) { 1; break; }")` is 1.
    fn runIfValue:void (node:TSNode) {
        if node.left {
            def cond:EvalValue (this.evaluateExpr((unwrap node.left)))
            def beforeIf:EvalValue completionValue
            def ranBranch:boolean false
            if (cond.toBool()) {
                if node.body {
                    this.runBlockOrStatement((unwrap node.body))
                    ranBranch = true
                }
            } {
                if node.right {
                    this.runBlockOrStatement((unwrap node.right))
                    ranBranch = true
                }
            }
            if (completionValue.equals(beforeIf)) {
                completionValue = (EvalValue.undefined())
            }
        }
    }

    fn runBlockOrStatement:void (blk:TSNode) {
        if ((this.nodeKindOf(blk)) == 34) {
            ; D-LABELS: a label on a BLOCK belongs to the block, not to the first
            ; statement inside it. `blk: { do { break blk } while (true); ... }`
            ; used to hand "blk" to the do-while, which then swallowed the break
            ; and carried on with the rest of the block.
            this.clearStatementLabels()
            this.runStatementList(blk.children)
        } {
            this.runStatementValue(blk)
        }
    }

    ; Evaluates an if statement
    ; Returns EVGElement with hasReturn flag set if a return was executed
    fn evaluateIfStatement:EVGElement (node:TSNode) {
        def result (new EVGElement())
        result.hasReturn = false
        
        ; Evaluate the condition (node.left)
        if node.left {
            def condNode:TSNode (unwrap node.left)
            def condition:EvalValue (this.evaluateExpr(condNode))
            
            if (condition.toBool()) {
                ; Execute then-block (node.body)
                if node.body {
                    def thenBlock:TSNode (unwrap node.body)
                    def blockResult:EVGElement (this.evaluateStatementBlock(thenBlock))
                    if blockResult.hasReturn {
                        return blockResult
                    }
                    if blockResult.hasBreak {
                        return blockResult
                    }
                    if blockResult.hasContinue {
                        return blockResult
                    }
                }
            } {
                ; Execute else-block if present (node.right)
                if node.right {
                    def elseBlock:TSNode (unwrap node.right)
                    ; Could be another IfStatement (else if) or BlockStatement (else)
                    if ((this.nodeKindOf(elseBlock)) == 32) {
                        def elseIfResult:EVGElement (this.evaluateIfStatement(elseBlock))
                        if elseIfResult.hasReturn {
                            return elseIfResult
                        }
                        if elseIfResult.hasBreak {
                            return elseIfResult
                        }
                        if elseIfResult.hasContinue {
                            return elseIfResult
                        }
                    } {
                        def blockResult:EVGElement (this.evaluateStatementBlock(elseBlock))
                        if blockResult.hasReturn {
                            return blockResult
                        }
                        if blockResult.hasBreak {
                            return blockResult
                        }
                        if blockResult.hasContinue {
                            return blockResult
                        }
                    }
                }
            }
        }
        ; No return was hit
        return result
    }
    
    ; Evaluates a block of statements (BlockStatement)
    ; Returns EVGElement with hasReturn flag set if a return was executed
    fn evaluateStatementBlock:EVGElement (block:TSNode) {
        def result (new EVGElement())
        result.hasReturn = false
        
        ; Handle single statement (not wrapped in BlockStatement)
        if ((this.nodeKindOf(block)) == 39) {
            result.hasContinue = true
            return result
        }
        if ((this.nodeKindOf(block)) == 38) {
            result.hasBreak = true
            return result
        }
        if ((this.nodeKindOf(block)) == 35) {
            if block.left {
                def returnExpr:TSNode (unwrap block.left)
                def returnedEl:EVGElement (this.evaluateJSX(returnExpr))
                returnedEl.hasReturn = true
                return returnedEl
            } {
                result.hasReturn = true
                return result
            }
        }
        
        ; Handle BlockStatement with children
        if ((this.nodeKindOf(block)) == 34) {
            def i:int 0
            while (i < (array_length block.children)) {
                def stmt:TSNode (itemAt block.children i)
                
                if ((this.nodeKindOf(stmt)) == 31) {
                    this.processVariableDeclaration(stmt)
                }
                
                if ((this.nodeKindOf(stmt)) == 32) {
                    def ifResult:EVGElement (this.evaluateIfStatement(stmt))
                    if ifResult.hasReturn {
                        return ifResult
                    }
                    if ifResult.hasBreak {
                        return ifResult
                    }
                    if ifResult.hasContinue {
                        return ifResult
                    }
                }
                
                if ((this.nodeKindOf(stmt)) == 33) {
                    def forResult:EVGElement (this.evaluateForStatement(stmt))
                    if forResult.hasReturn {
                        return forResult
                    }
                    if forResult.hasBreak {
                        return forResult
                    }
                    if forResult.hasContinue {
                        return forResult
                    }
                }
                
                if ((this.nodeKindOf(stmt)) == 37) {
                    def forOfResult:EVGElement (this.evaluateForOfStatement(stmt))
                    if forOfResult.hasReturn {
                        return forOfResult
                    }
                    if forOfResult.hasBreak {
                        return forOfResult
                    }
                    if forOfResult.hasContinue {
                        return forOfResult
                    }
                }
                
                if ((this.nodeKindOf(stmt)) == 36) {
                    def whileResult:EVGElement (this.evaluateWhileStatement(stmt))
                    if whileResult.hasReturn {
                        return whileResult
                    }
                    if whileResult.hasBreak {
                        return whileResult
                    }
                    if whileResult.hasContinue {
                        return whileResult
                    }
                }
                
                if ((this.nodeKindOf(stmt)) == 30) {
                    if stmt.left {
                        def exprNode:TSNode (unwrap stmt.left)
                        this.evaluateExprForSideEffect(exprNode)
                    }
                }
                
                if ((this.nodeKindOf(stmt)) == 35) {
                    if stmt.left {
                        def returnExpr:TSNode (unwrap stmt.left)
                        def returnedEl:EVGElement (this.evaluateJSX(returnExpr))
                        returnedEl.hasReturn = true
                        return returnedEl
                    } {
                        result.hasReturn = true
                        return result
                    }
                }
                
                if ((this.nodeKindOf(stmt)) == 39) {
                    result.hasContinue = true
                    return result
                }
                
                if ((this.nodeKindOf(stmt)) == 38) {
                    result.hasBreak = true
                    return result
                }
                
                i = i + 1
            }
        }
        
        return result
    }
    
    ; Evaluates an expression for its side effects (e.g., arr.push(x), i++)
    ; D-COMPLETION: an expression statement's value IS the statement's
    ; completion value, so each branch records it. `eval` reads it back; nothing
    ; else does, which is why this stayed a void call.
    fn evaluateExprForSideEffect:void (node:TSNode) {
        def seK:int (this.nodeKindOf(node))
        def handledSE:boolean false
        ; Handle CallExpression (method calls like arr.push(x))
        if (seK == 4) {
            completionValue = (this.evaluateExpr(node))
            handledSE = true
        }

        ; Handle UpdateExpression (i++, ++i) and AssignmentExpression (x = 1).
        if (seK == 7) {
            completionValue = (this.evaluateAssignValue(node))
            handledSE = true
        }

        if (seK == 6) {
            completionValue = (this.evaluateAssignValue(node))
            handledSE = true
        }

        ; Statement-position unary with a side effect (delete obj.x, void expr).
        if (seK == 12) {
            completionValue = (this.evaluateUnaryExpr(node))
            handledSE = true
        }

        ; D-ERRORS: a bare reference in statement position still resolves, and an
        ; unresolvable one throws. `nope;` on its own line is a ReferenceError.
        if (seK == 1) {
            completionValue = (this.lookupIdentifier(node.name))
            handledSE = true
        }
        if (seK == 3) {
            completionValue = (this.evaluateMemberExpr(node))
            handledSE = true
        }
        ; Everything else is evaluated too. The list above was exhaustive by
        ; accident rather than by design, so `new F();` in statement position
        ; ran NOTHING -- neither the constructor's effects nor an error raised
        ; inside it, which simply vanished instead of being thrown.
        if (false == handledSE) {
            completionValue = (this.evaluateExpr(node))
        }
    }
    
    ; Evaluates a call expression for side effects (e.g., arr.push(x), placeShip(...))
    fn evaluateCallExprForSideEffect:void (node:TSNode) {
        ; Check if it's a method call: arr.push(x)
        if node.left {
            def calleeNode:TSNode (unwrap node.left)
            if ((this.nodeKindOf(calleeNode)) == 3) {
                def methodName:string calleeNode.name
                
                ; Get the object being called on
                if calleeNode.left {
                    def objNode:TSNode (unwrap calleeNode.left)
                    if ((this.nodeKindOf(objNode)) == 1) {
                        def objName:string objNode.name
                        def objValue:EvalValue (context.lookup(objName))
                        
                        ; Array.push()
                        if ((methodName == "push") && (objValue.isArray())) {
                            ; Get arguments from node.children
                            if ((array_length node.children) > 0) {
                                def argNode:TSNode (itemAt node.children 0)
                                def argValue:EvalValue (this.evaluateExpr(argNode))
                                ; Mutate the array by adding the item
                                push objValue.arrayValue argValue
                                ; Update the context (in case of reassignment)
                                context.assign(objName objValue)
                            }
                            return
                        }
                    }
                }
            }
        }
        ; Plain function-call statements (helpers that mutate objects passed in).
        this.evaluateCallExpr(node)
    }
    
    ; ==========================================================================
    ; For Loop Evaluation
    ; ==========================================================================
    
    ; Evaluates a for statement: for (init; test; update) body
    ; Returns EVGElement with hasReturn flag set if a return was executed
    fn evaluateForStatement:EVGElement (node:TSNode) {
        def result (new EVGElement())
        result.hasReturn = false
        
        this.trace("evaluateForStatement called")
        
        ; Process init (usually VariableDeclaration)
        if node.init {
            def initNode:TSNode (unwrap node.init)
            this.trace("For init nodeType: " + initNode.nodeType)
            if ((this.nodeKindOf(initNode)) == 31) {
                this.processVariableDeclaration(initNode)
            } {
                def ignoredInitE:EvalValue (this.evaluateExpr(initNode))
            }
        }
        
        ; Loop with test (node.left) and update (node.right)
        def maxIterations:int maxLoopIterations
        def iterations:int 0
        
        while (iterations < maxIterations) {
            ; Evaluate test condition (node.left)
            if node.left {
                def testNode:TSNode (unwrap node.left)
                def testResult:EvalValue (this.evaluateExpr(testNode))
                if ((testResult.toBool()) == false) {
                    ; Condition is false, exit loop
                    return result
                }
            }
            
            ; Execute body
            if node.body {
                def bodyNode:TSNode (unwrap node.body)
                def bodyResult:EVGElement (this.evaluateStatementBlock(bodyNode))
                if bodyResult.hasReturn {
                    return bodyResult
                }
                if bodyResult.hasBreak {
                    return result
                }
                if bodyResult.hasContinue {
                    if node.right {
                        def updateNode:TSNode (unwrap node.right)
                        this.evaluateUpdateExpr(updateNode)
                    }
                    iterations = iterations + 1
                } {
                    ; Execute update (node.right)
                    if node.right {
                        def updateNode:TSNode (unwrap node.right)
                        this.evaluateUpdateExpr(updateNode)
                    }
                    
                    iterations = iterations + 1
                }
            } {
                iterations = iterations + 1
            }
        }
        
        return result
    }
    
    ; Evaluates a for...of statement: for (const x of array) body
    ; Returns EVGElement with hasReturn flag set if a return was executed
    fn evaluateForOfStatement:EVGElement (node:TSNode) {
        def result (new EVGElement())
        result.hasReturn = false
        
        ; Get variable name from node.left (VariableDeclaration)
        def varName:string ""
        if node.left {
            def leftNode:TSNode (unwrap node.left)
            if ((this.nodeKindOf(leftNode)) == 31) {
                if ((array_length leftNode.children) > 0) {
                    def decl:TSNode (itemAt leftNode.children 0)
                    varName = decl.name
                }
            }
        }
        
        ; Get the array to iterate (node.right)
        if node.right {
            def rightNode:TSNode (unwrap node.right)
            def arrayValue:EvalValue (this.evaluateExpr(rightNode))
            
            if (arrayValue.isArray()) {
                def i:int 0
                while (i < (array_length arrayValue.arrayValue)) {
                    def item:EvalValue (itemAt arrayValue.arrayValue i)
                    
                    ; Bind loop variable
                    context.define(varName item)
                    
                    ; Execute body
                    if node.body {
                        def bodyNode:TSNode (unwrap node.body)
                        def bodyResult:EVGElement (this.evaluateStatementBlock(bodyNode))
                        if bodyResult.hasReturn {
                            return bodyResult
                        }
                        if bodyResult.hasBreak {
                            return result
                        }
                        if bodyResult.hasContinue {
                            i = i + 1
                        } {
                            i = i + 1
                        }
                    } {
                        i = i + 1
                    }
                }
            }
        }
        
        return result
    }
    
    ; Evaluates a while statement: while (test) body
    ; Returns EVGElement with hasReturn flag set if a return was executed
    fn evaluateWhileStatement:EVGElement (node:TSNode) {
        def result (new EVGElement())
        result.hasReturn = false
        
        def maxIterations:int maxLoopIterations  ; Safety limit
        def iterations:int 0
        
        while (iterations < maxIterations) {
            if node.left {
                def testNode:TSNode (unwrap node.left)
                def testResult:EvalValue (this.evaluateExpr(testNode))
                if ((testResult.toBool()) == false) {
                    return result
                }
            } {
                return result
            }
            
            if node.body {
                def bodyNode:TSNode (unwrap node.body)
                def bodyResult:EVGElement (this.evaluateStatementBlock(bodyNode))
                if bodyResult.hasReturn {
                    return bodyResult
                }
                if bodyResult.hasBreak {
                    return result
                }
                if bodyResult.hasContinue {
                    iterations = iterations + 1
                } {
                    iterations = iterations + 1
                }
            } {
                iterations = iterations + 1
            }
        }
        
        return result
    }
    
    ; Integer-exponent power (base ** expn); used by ** and **=.
    ; D-MATH: exp and log, built from a series because the Ranger runtime offers
    ; no intrinsic for either. Both reduce the argument first so the series
    ; converges fast; accuracy is around 1e-15 relative, which is close to but
    ; not identical with the host's, so a test comparing an exact bit pattern
    ; would still see a difference.
    fn expNum:double (x:double) {
        if (x != x) { return x }
        def inf:double (1.0 / 0.0)
        if (x == inf) { return inf }
        if (x == (0.0 - inf)) { return 0.0 }
        ; e^x = 2^k * e^r, with r small. k = round(x / ln2).
        def ln2:double 0.6931471805599453
        def kD:double (this.floorNum(((x / ln2) + 0.5)))
        def r:double (x - (kD * ln2))
        def term:double 1.0
        def sum:double 1.0
        def n:int 1
        while (n < 24) {
            term = ((term * r) / (to_double n))
            sum = (sum + term)
            n = (n + 1)
        }
        def k:int (to_int kD)
        def scale:double 1.0
        if (k >= 0) {
            scale = (this.powNum(2.0 k))
        } {
            scale = (1.0 / (this.powNum(2.0 (0 - k))))
        }
        return (sum * scale)
    }

    fn logNum:double (x:double) {
        if (x != x) { return x }
        def inf:double (1.0 / 0.0)
        if (x < 0.0) { return (0.0 / 0.0) }
        if (x == 0.0) { return (0.0 - inf) }
        if (x == inf) { return inf }
        ; Reduce to m in [1, 2) with x = m * 2^k, then use the atanh series,
        ; which converges much faster than log(1+u) near the ends of the range.
        def k:int 0
        def m:double x
        while (m >= 2.0) {
            m = (m / 2.0)
            k = (k + 1)
        }
        while (m < 1.0) {
            m = (m * 2.0)
            k = (k - 1)
        }
        def z:double ((m - 1.0) / (m + 1.0))
        def z2:double (z * z)
        def termL:double z
        def sumL:double z
        def n:int 1
        while (n < 30) {
            termL = (termL * z2)
            sumL = (sumL + (termL / (to_double ((2 * n) + 1))))
            n = (n + 1)
        }
        def ln2:double 0.6931471805599453
        return ((2.0 * sumL) + ((to_double k) * ln2))
    }

    ; Floor toward NEGATIVE infinity. `to_int` truncates toward zero, so it gets
    ; -1.5 wrong -- which is what made Math.floor(-1.5) answer -1, and Math.ceil
    ; and Math.round wrong with it, since all three were built on it.
    ; D-IEEE: -0 is a distinct value and the only way to tell it from +0 is the
    ; sign of 1/x. Ranger has no negative-zero literal, so it is built by
    ; MULTIPLYING zero by -1 -- subtracting from zero gives +0.
    fn isNegZero:boolean (v:double) {
        if (v != 0.0) {
            return false
        }
        return ((1.0 / v) < 0.0)
    }

    fn negativeZero:double () {
        return (0.0 * (0.0 - 1.0))
    }

    fn floorNum:double (v:double) {
        if (v != v) {
            return v
        }
        if (false == (this.isFiniteNum(v))) {
            return v
        }
        def t:double (to_double (to_int v))
        if (t > v) {
            return (t - 1.0)
        }
        return t
    }

    fn isFiniteNum:boolean (v:double) {
        if (v != v) {
            return false
        }
        def inf:double (1.0 / 0.0)
        if (v == inf) {
            return false
        }
        if (v == (0.0 - inf)) {
            return false
        }
        return true
    }

    fn powNum:double (base:double expn:int) {
        def acc:double 1.0
        if (expn >= 0) {
            def k:int 0
            while (k < expn) {
                acc = (acc * base)
                k = (k + 1)
            }
            return acc
        }
        def k2:int 0
        def n2:int (0 - expn)
        while (k2 < n2) {
            acc = (acc * base)
            k2 = (k2 + 1)
        }
        if (acc != 0.0) {
            return (1.0 / acc)
        }
        return 0.0
    }

    ; Wrap a number into a `bits`-wide integer (two's-complement if signed),
    ; matching AssemblyScript's i8/u8/i16/u16/i32/u32 truncation. Computed in
    ; doubles (exact up to 2^53, so u32 fits) via truncate-then-modulo-2^bits.
    fn wrapInt:double (v:double bits:int signed:boolean) {
        def iv:double (to_double (to_int v))
        def m:double (this.powNum(2.0 bits))
        def r:double (iv - (m * (to_double (to_int (iv / m)))))
        if (r < 0.0) {
            r = (r + m)
        }
        if signed {
            def half:double (this.powNum(2.0 (bits - 1)))
            if (r >= half) {
                r = (r - m)
            }
        }
        return r
    }

    ; True if `name` is an AssemblyScript sized-numeric type usable as a cast.
    fn isSizedTypeName:boolean (name:string) {
        if (name == "i8") { return true }
        if (name == "u8") { return true }
        if (name == "i16") { return true }
        if (name == "u16") { return true }
        if (name == "i32") { return true }
        if (name == "u32") { return true }
        if (name == "i64") { return true }
        if (name == "u64") { return true }
        if (name == "f32") { return true }
        if (name == "f64") { return true }
        return false
    }

    ; Apply an AS numeric cast (i32(x), u8(x), …) with proper wraparound. i64/u64
    ; truncate to an integer (doubles cannot hold full 64-bit); f32/f64 pass the
    ; value through (no float32 rounding).
    fn castSized:EvalValue (name:string v:double) {
        if (name == "i8") { return (EvalValue.number((this.wrapInt(v 8 true)))) }
        if (name == "u8") { return (EvalValue.number((this.wrapInt(v 8 false)))) }
        if (name == "i16") { return (EvalValue.number((this.wrapInt(v 16 true)))) }
        if (name == "u16") { return (EvalValue.number((this.wrapInt(v 16 false)))) }
        if (name == "i32") { return (EvalValue.number((this.wrapInt(v 32 true)))) }
        if (name == "u32") { return (EvalValue.number((this.wrapInt(v 32 false)))) }
        if (name == "i64") { return (EvalValue.number((to_double (to_int v)))) }
        if (name == "u64") { return (EvalValue.number((to_double (to_int v)))) }
        return (EvalValue.number(v))
    }

    ; For `expr as T` / `<T>expr`: if T (on node.typeAnnotation) is a sized-int
    ; type, truncate; otherwise return the value unchanged (types are erased).
    fn applyTypeCast:EvalValue (node:TSNode value:EvalValue) {
        if node.typeAnnotation {
            def tNode:TSNode (unwrap node.typeAnnotation)
            def tn:string tNode.name
            if ((strlen tn) == 0) {
                tn = tNode.value
            }
            if (this.isSizedTypeName(tn)) {
                return (this.castSized(tn (value.toNumber())))
            }
        }
        return value
    }

    ; Compute the result of a (compound) assignment operator given the current
    ; LHS value and the RHS value. Handles all of = += -= *= /= %= **= and the
    ; bitwise (& | ^ << >> >>>) and logical (&& || ??) compound forms.
    ; The floating-point remainder, with the sign of the dividend.
    fn evaluateRemainder:EvalValue (a:double b:double) {
        if (a != a) { return (EvalValue.number(a)) }
        if (b != b) { return (EvalValue.number(b)) }
        if (b == 0.0) { return (EvalValue.number((0.0 / 0.0))) }
        if (false == (this.isFiniteNum(a))) { return (EvalValue.number((0.0 / 0.0))) }
        if (false == (this.isFiniteNum(b))) { return (EvalValue.number(a)) }
        def q:double (a / b)
        def qi:double (this.floorNum(q))
        if (q < 0.0) {
            qi = (0.0 - (this.floorNum((0.0 - q))))
        }
        def rem:double (a - (qi * b))
        ; The remainder takes the sign of the DIVIDEND, and that includes zero:
        ; -1 % -1 is -0, not +0. Subtraction produces +0 for both, so the sign
        ; is put back by multiplying.
        if (rem == 0.0) {
            def negOneD:double (0.0 - 1.0)
            if (a < 0.0) {
                return (EvalValue.number((0.0 * negOneD)))
            }
            def aRecip:double (1.0 / a)
            if (aRecip < 0.0) {
                return (EvalValue.number((0.0 * negOneD)))
            }
            return (EvalValue.number(0.0))
        }
        return (EvalValue.number(rem))
    }

    fn applyAssignOp:EvalValue (opK:int current:EvalValue rightValue:EvalValue) {
        if (opK == 1) {
            return rightValue
        }
        if (opK == 2) {
            ; PERF fast path, mirroring `+`: plain strings and plain numbers
            ; skip the conversion dance (each toStringOf copies on natives).
            if ((current.valueType == 2) && (rightValue.valueType == 2)) {
                return (EvalValue.string(current.stringValue + rightValue.stringValue))
            }
            if ((current.valueType == 1) && (rightValue.valueType == 1)) {
                return (EvalValue.number(current.numberValue + rightValue.numberValue))
            }
            ; Same rule as `+`: BOTH operands convert first, and only then does
            ; the string-vs-numeric decision get made. Testing isString() on the
            ; raw values missed a boxed string entirely, so
            ; `x = new String("1"); x += 1` gave 2 instead of "11".
            def lp:EvalValue (this.toPrimitiveDefault(current))
            def rp:EvalValue (this.toPrimitiveDefault(rightValue))
            if ((lp.isString()) || (rp.isString())) {
                return (EvalValue.string((this.toStringOf(lp)) + (this.toStringOf(rp))))
            }
            return (EvalValue.number((this.toNumberOf(lp)) + (this.toNumberOf(rp))))
        }
        if (opK == 3) {
            return (EvalValue.number((this.toNumberOf(current)) - (this.toNumberOf(rightValue))))
        }
        if (opK == 4) {
            return (EvalValue.number((this.toNumberOf(current)) * (this.toNumberOf(rightValue))))
        }
        if (opK == 5) {
            ; Division by zero is an INFINITY, not a no-op. Returning `current`
            ; left the variable untouched, so `x = 1; x /= null` stayed 1.
            def rn:double (this.toNumberOf(rightValue))
            def ln:double (this.toNumberOf(current))
            if (rn == 0.0) {
                if (ln != ln) { return (EvalValue.number(ln)) }
                if (ln == 0.0) { return (EvalValue.number((0.0 / 0.0))) }
                def infD:double (1.0 / 0.0)
                def negD:boolean (ln < 0.0)
                if negD {
                    return (EvalValue.number((0.0 - infD)))
                }
                return (EvalValue.number(infD))
            }
            return (EvalValue.number((ln / rn)))
        }
        if (opK == 6) {
            ; The floating remainder, same as the `%` operator -- the integer
            ; version threw away the fraction.
            return (this.evaluateRemainder((this.toNumberOf(current)) (this.toNumberOf(rightValue))))
        }
        if (opK == 7) {
            return (EvalValue.number((this.powNum((this.toNumberOf(current)) (to_int (this.toNumberOf(rightValue)))))))
        }
        if (opK == 11) {
            return (EvalValue.fromInt((bit_and (to_int (this.toNumberOf(current))) (to_int (this.toNumberOf(rightValue))))))
        }
        if (opK == 12) {
            return (EvalValue.fromInt((bit_or (to_int (this.toNumberOf(current))) (to_int (this.toNumberOf(rightValue))))))
        }
        if (opK == 13) {
            return (EvalValue.fromInt((bit_xor (to_int (this.toNumberOf(current))) (to_int (this.toNumberOf(rightValue))))))
        }
        if (opK == 8) {
            return (EvalValue.fromInt((bit_shl (to_int (this.toNumberOf(current))) (bit_and (to_int (this.toNumberOf(rightValue))) 31))))
        }
        if (opK == 9) {
            return (EvalValue.fromInt((bit_shr (to_int (this.toNumberOf(current))) (bit_and (to_int (this.toNumberOf(rightValue))) 31))))
        }
        if (opK == 10) {
            return (EvalValue.fromInt((bit_ushr (to_int (this.toNumberOf(current))) (bit_and (to_int (this.toNumberOf(rightValue))) 31))))
        }
        if (opK == 14) {
            if (current.toBool()) {
                return rightValue
            }
            return current
        }
        if (opK == 15) {
            if (current.toBool()) {
                return current
            }
            return rightValue
        }
        if (opK == 16) {
            ; nullish: assign when the current value is null OR undefined
            ; (a missing member now reads as undefined — D-IDENTITY rule 6).
            if ((current.isNull()) || (current.isUndefined())) {
                return rightValue
            }
            return current
        }
        return rightValue
    }

    ; Apply a (compound) assignment to a member/index target (o.x, o["k"], a[i]),
    ; returning the assigned value. Read-modify-write for the compound forms.
    fn assignMember:EvalValue (leftNode:TSNode opK:int rightValue:EvalValue) {
        def obj:EvalValue (EvalValue.null())
        def objName:string ""
        if leftNode.left {
            def objNode:TSNode (unwrap leftNode.left)
            if ((this.nodeKindOf(objNode)) == 1) {
                objName = objNode.name
                ; D-GLOBALOBJ: resolve through lookupIdentifier, not the raw
                ; scope, so a write to a built-in global (`Math.value = 1`)
                ; lands on the real object instead of vanishing.
                obj = (this.lookupIdentifier(objName))
            } {
                obj = (this.evaluateExpr(objNode))
            }
        }
        ; A throw from resolving the BASE -- an undeclared name is a
        ; ReferenceError -- escapes as itself rather than being replaced by the
        ; TypeError below.
        if scriptThrew {
            return (EvalValue.undefined())
        }
        ; Writing a property of null or undefined is a TypeError, in either
        ; mode. It was silently dropped, so a test that expected the throw saw
        ; nothing happen at all.
        if strictReferences {
            if ((obj.isNull()) || (obj.isUndefined())) {
                def baseDesc:string "undefined"
                if (obj.isNull()) { baseDesc = "null" }
                def wname:string leftNode.name
                if ((strlen wname) == 0) { wname = "property" }
                return (this.throwSpecError("TypeError" ("Cannot set properties of " + (baseDesc + (" (setting '" + (wname + "')"))))))
            }
        }
        def result:EvalValue rightValue
        ; A COMPUTED key differs from a written one only in how the name is
        ; obtained -- `o["bar"] = 1` is the same write `o.bar = 1` is, setter and
        ; all. It used to have a shortcut of its own that stored a data property
        ; directly, so an accessor was silently shadowed, a refused write in
        ; strict mode passed unreported, and the poisoned `caller`/`arguments`
        ; rule did not apply. Only a numeric index into a real ARRAY still takes
        ; the element path; on a plain object a numeric key is the property named
        ; by ToString(index).
        def key:string leftNode.name
        def numericIndexes:boolean false
        def numIdx:int 0
        if leftNode.computed {
            if leftNode.right {
                def indexVal:EvalValue (this.evaluateExpr((unwrap leftNode.right)))
                if scriptThrew {
                    return (EvalValue.undefined())
                }
                key = (this.toPropertyKey(indexVal))
                if scriptThrew {
                    return (EvalValue.undefined())
                }
            }
        }
        ; D-ARGMAP: a write to a mapped index writes the PARAMETER, so the body
        ; sees it under the parameter's name from then on. The object kept it as
        ; an ordinary property and the two drifted apart.
        def wMapped:string (this.argMapName(obj key))
        if ((strlen wMapped) > 0) {
            def wMapCtx:EvalContext (this.argMapScopeOf(obj))
            if (wMapCtx.has(wMapped)) {
                def curMapped:EvalValue (wMapCtx.lookup(wMapped))
                def mappedRes:EvalValue (this.applyAssignOp(opK curMapped rightValue))
                if scriptThrew {
                    return (EvalValue.undefined())
                }
                wMapCtx.assign(wMapped mappedRes)
                obj.setMember(key mappedRes)
                return mappedRes
            }
        }
        ; D-ARRAYSPARSE: whether this key names an ELEMENT is decided by the key
        ; text, not by whether the expression happened to be a number. `x["0"]`
        ; is the element and `x[-1]` is a property, and routing on the operand's
        ; type got both of those backwards.
        if (obj.valueType == 4) {
            def ai0:int (this.canonicalArrayIndex(key))
            if (ai0 >= 0) {
                numericIndexes = true
                numIdx = ai0
            }
        }
        ; An ELEMENT defined as an accessor takes the write through its setter,
        ; exactly as a named accessor does.
        if numericIndexes {

    fn isBuiltinCtorName:boolean (name:string) {
        if (name == "Object") { return true }
        if (name == "Array") { return true }
        if (name == "String") { return true }
        if (name == "Number") { return true }
        if (name == "Boolean") { return true }
        if (name == "Function") { return true }
        ; %AsyncFunction% is a constructor with no global BINDING: the only way
        ; a guest can name it is `Object.getPrototypeOf(async function () {})
        ; .constructor`, which is exactly what feature detection does. Listed
        ; here so it carries a prototype and an arity like any other; left out
        ; of isEngineGlobalName so a bare `AsyncFunction` stays a ReferenceError.
        if (name == "AsyncFunction") { return true }
        if (name == "Symbol") { return true }
        if (name == "Map") { return true }
        if (name == "Set") { return true }
        ; BigInt is a function but NOT a constructor; it is listed here so that
        ; `typeof BigInt` is "function" and it carries a prototype, and the
        ; construct paths refuse it by name.
        if (name == "BigInt") { return true }
        ; %Iterator% is a constructor -- an abstract one, so `new Iterator()` is
        ; a TypeError -- and `typeof Iterator` is "function" because of it.
        if (name == "Iterator") { return true }
        if (name == "Date") { return true }
        if (name == "RegExp") { return true }
        if (name == "Promise") { return true }
        if (name == "Proxy") { return true }
        if (name == "ArrayBuffer") { return true }
        if (name == "SharedArrayBuffer") { return true }
        if (name == "DataView") { return true }
        if (this.isWeakCtorName(name)) { return true }
        if (this.isTypedArrayCtorName(name)) { return true }
        return (this.isErrorCtorName(name))
    }

    ; D-WEAK: the four constructors whose whole point is not to keep their
    ; contents alive. This realm has no collector to observe, so they are
    ; implemented as ordinary strong collections -- which the spec permits: an
    ; implementation is never REQUIRED to collect anything, and a program can
    ; only observe the difference through memory. What it cannot observe is a
    ; missing constructor, which is what `new WeakMap()` met before.
    fn isWeakCtorName:boolean (name:string) {
        if (name == "WeakMap") { return true }
        if (name == "WeakSet") { return true }
        if (name == "WeakRef") { return true }
        if (name == "FinalizationRegistry") { return true }
        return false
    }

    fn weakKindFor:string (name:string) {
        if (name == "WeakMap") { return "weakmap" }
        if (name == "WeakSet") { return "weakset" }
        if (name == "WeakRef") { return "weakref" }
        if (name == "FinalizationRegistry") { return "weakregistry" }
        return ""
    }

    ; A WeakMap/WeakSet key and a WeakRef target must be an OBJECT (or a
    ; non-registered symbol, which this realm carries as an object anyway), and
    ; that check is the one thing about these that IS observable.
    fn canBeWeakTarget:boolean (v:EvHandle) {
        if (v.isObject()) { return true }
        if (v.isArrayValue()) { return true }
        if (v.isFunction()) { return true }
        if (v.isMap()) { return true }
        if (v.isSet()) { return true }
        return false
    }

    fn constructWeak:EvHandle (className:string args:[EvHandle]) {

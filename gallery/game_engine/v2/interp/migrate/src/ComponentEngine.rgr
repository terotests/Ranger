                        scriptThrowValue = savedThrowVC
                        loopBreak = savedBrkC
                        loopContinue = savedCntC
                        scriptDidReturn = savedRetC
                        scriptReturnValue = savedRetVC
                    }
                }
                context = (unwrap ofOuter)
                this.settleLoopAbrupt(myLabels savedBreak savedContinue)
                return
            }
            ; normalisation shared with the bytecode tier (forOfItemList)
            ; so the two paths cannot diverge
            def items:[EvHandle] (this.forOfItemList(src))
            def i:int 0
            def looping:boolean true
            while ((i < (array_length items)) && looping) {
                if (scriptDidReturn || scriptThrew) {
                    looping = false
                } {
                    if loopBreak {
                        looping = false
                    } {

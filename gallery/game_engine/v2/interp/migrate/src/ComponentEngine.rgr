        ; which is what `Array.from(xs, f)` means.
        if (mapFn.isFunction()) {
            def mapped:[EvHandle]
            def mi3:int 0
            while (mi3 < (array_length frItems)) {
                def mArgs:[EvHandle]
                push mArgs (itemAt frItems mi3)
                push mArgs (EvHandle.fromInt(mi3))
                push mapped (this.callFnValueWithValues(mapFn mArgs))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())

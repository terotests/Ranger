            ; rather than objectMap, so listing only objectMap left every
            ; accessor out of Object.keys, getOwnPropertyNames and the
            ; descriptor-map step of Object.create / defineProperties.
            def accKeys:[string] (v.ownGetterKeys())
            def ai:int 0
            while (ai < (array_length accKeys)) {
                def ak:string (itemAt accKeys ai)
                if (false == (v.hasOwnData(ak))) {
                    push out ak
                }
                ai = (ai + 1)
            }
            def setKeys:[string] (v.ownSetterKeys())
            def si:int 0
            while (si < (array_length setKeys)) {
                def sk:string (itemAt setKeys si)
                if (false == (v.hasOwnData(sk))) {
                    if (false == (v.hasOwnGetter(sk))) {

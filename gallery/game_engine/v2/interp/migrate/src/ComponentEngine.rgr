            ; Finish the assignment here with the value already in hand. The
            ; preconditions above make this the whole of the general path: no
            ; `with` object, and a name that holds a slot is a binding of a
            ; non-global frame, so it exists and is writable.
            def curV:EvHandle (this.lookupIdentifier(nm))
            if scriptThrew {
                return true
            }
            def resV:EvHandle (this.applyAssignOp(opK curV rv))
            if scriptThrew {
                return true
            }
            def _ok:boolean (context.assignExisting(nm resV))
            return true
        }
        def cur:double (context.slotNumberOf(nm))
        def out:double cur
        if (opK == 2) { out = (cur + rv.numberValue) }
        if (opK == 3) { out = (cur - rv.numberValue) }
        if (opK == 4) { out = (cur * rv.numberValue) }
        if (opK == 5) { out = (cur / rv.numberValue) }
        return (context.setNumberInSlot(nm out))
    }

    ; `name += <expr>` in STATEMENT position where the target holds a slot
    ; STRING: append in place. Mirrors assignNumberInSlot — returns false
    ; only BEFORE the right-hand side has run, so the caller can fall through
    ; to the general path without evaluating anything twice.
    fn assignStringInSlot:boolean (node:TSNode) {
        if anyWithScope {
            return false
        }
        if node.left { } {
            return false
        }
        def lhs:TSNode (unwrap node.left)
        if ((this.nodeKindOf(lhs)) != 1) {
            return false
        }
        ; `+=` only: on a string every other compound op is a ToNumber dance.
        if ((this.opKindOf(node)) != 2) {
            return false

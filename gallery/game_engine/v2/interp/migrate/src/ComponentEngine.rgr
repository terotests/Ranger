            ; prototype object is not a constructor, and Function.prototype is
            ; callable without being one.
            if (ncKind == "MemberExpression") {
                def protoTarget:EvHandle (this.evaluateExpr(newCallee))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                def notCtor:boolean false
                if (protoTarget.isObject()) { notCtor = true }
                if (protoTarget.isFunction()) {
                    if (false == (protoTarget.hasFunctionNode())) {
                        if ((strlen (this.builtinCtorNameOf(protoTarget))) == 0) {
                            notCtor = true
                        }
                    }
                }
                if (protoTarget.isObject()) {
                    ; A plain object reached through a member expression may
                    ; still be a class value; only a PROTOTYPE object is
                    ; rejected here, which is what __protokind__ marks.
                    notCtor = false
                    if (protoTarget.hasOwnData("__protokind__")) { notCtor = true }
                    if (protoTarget.hasOwnData("constructor")) {
                        if (newCallee.name == "prototype") { notCtor = true }
                    }
                }
                if (protoTarget.isFunction()) {
                    if (protoTarget.hasOwnData("__fnprotocall__")) { notCtor = true }
                }
                if notCtor {
                    return (this.throwSpecError("TypeError" "expression is not a constructor"))
                }
                ; D-NEWMEMBER: `new ns.Deep.C()` where C is a function VALUE on
                ; an object (Prototype.js Class.create, nested namespaces). The
                ; name-keyed class lookup below only sees the last property
                ; name ("C") and used to return null. Construct from the value
                ; we already resolved — same path as `var C = ns.Deep.C; new C()`.
                if (protoTarget.isFunction()) {
                    ; Rust: the callee-name read must not stay an argument
                    ; expression -- its borrow guard would live across the whole
                    ; construct call and collide with borrows inside it.
                    def ncCtorName:string newCallee.name
                    if (protoTarget.hasFunctionNode()) {
                        return (this.constructFromFunction(protoTarget ncCtorName node.children))
                    }
                    if ((strlen (this.builtinCtorNameOf(protoTarget))) > 0) {
                        return (this.constructFromFunction(protoTarget ncCtorName node.children))
                    }
                }
            }
            if (ncKind == "Identifier") {
                def ncName:string newCallee.name
                ; `new undefined` and `new Math` are TypeErrors: neither names a
                ; constructor. undefined is a value, and Math is a namespace
                ; object rather than a function.
                if (ncName == "undefined") {

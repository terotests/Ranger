        if (name == "getYear") {
            return (EvHandle.fromInt(((dtl.yearFromTime(tv)) - 1900)))
        }
        if ((name == "getMonth") || (name == "getUTCMonth")) {
            return (EvHandle.fromInt((dtl.monthFromTime(tv))))
        }
        if ((name == "getDate") || (name == "getUTCDate")) {
            return (EvHandle.fromInt((dtl.dateFromTime(tv))))
        }
        if ((name == "getDay") || (name == "getUTCDay")) {
            return (EvHandle.fromInt((dtl.weekDay(tv))))
        }
        if ((name == "getHours") || (name == "getUTCHours")) {
            return (EvHandle.fromInt((dtl.hourFromTime(tv))))
        }
        if ((name == "getMinutes") || (name == "getUTCMinutes")) {
            return (EvHandle.fromInt((dtl.minFromTime(tv))))
        }
        if ((name == "getSeconds") || (name == "getUTCSeconds")) {
            return (EvHandle.fromInt((dtl.secFromTime(tv))))
        }
        if ((name == "getMilliseconds") || (name == "getUTCMilliseconds")) {
            return (EvHandle.fromInt((dtl.msFromTime(tv))))
        }

                    if ((c >= 55296) && (c <= 56319)) {
                        if ((i + 1) >= n) {
                            return (this.throwSpecError("URIError" "URI malformed"))
                        }
                        def lo:int (bit_and (charAt s (i + 1)) 65535)
                        if ((lo < 56320) || (lo > 57343)) {
                            return (this.throwSpecError("URIError" "URI malformed"))
                        }
                        cp = ((((c - 55296) * 1024) + (lo - 56320)) + 65536)
                        step = 2
                    } {
                        if ((c >= 56320) && (c <= 57343)) {

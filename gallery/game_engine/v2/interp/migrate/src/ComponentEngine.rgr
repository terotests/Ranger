        if (h.isBoolean()) {
            set bcTags i 2
            if (h.boolOf()) {
                set bcNums i 1.0
            } {
                set bcNums i 0.0
            }
            return
        }
        if (h.isUndefined()) {
            set bcTags i 3
            return
        }
        if (h.isNull()) {
            set bcTags i 4
            return
        }
        set bcTags i 0
        set bcStack i h
    }

    ; Grow the three slot lanes to `top` in lockstep. Each lane has its own
    ; loop so their lengths can never drift apart.
    fn bcGrowTo:void (top:int) {

                    ; terminate instead of recursing forever.
                    def ctorHere:EvalValue (lv.getMember("constructor"))
                    if (ctorHere.valueType == 6) {
                        if node.right {
                            def rv:EvalValue (this.evaluateExpr((unwrap node.right)))
                            if (rv.valueType == 6) {
                                return (EvalValue.boolean((ctorHere.equals(rv))))
                            }
                        }
                        if ((strlen cname) > 0) {
                            return (EvalValue.boolean(((ctorHere.functionName) == cname)))
                        }
                    }
                }
            }
            return (EvalValue.boolean(false))
        }

        ; Evaluate both sides for other operators. Binary expressions always have
        ; both operands; evaluate them directly instead of seeding two throwaway
        ; null EvalValues (which used to be the single largest source of interpreter
        ; heap allocations).
        if (null? node.left) {
            return (EvalValue.null())
        }
        if (null? node.right) {
            return (EvalValue.null())
        }
        def left:EvalValue (this.evaluateExpr((unwrap node.left)))
        def right:EvalValue (this.evaluateExpr((unwrap node.right)))

        ; `key in obj` / `index in array` — property/element presence test.
        if (opK == 43) {
            ; The right operand must be an OBJECT. A primitive is a TypeError,
            ; not a quiet false -- and a FUNCTION is an object, which is what
            ; makes `"MAX_VALUE" in Number` true now that the built-in
            ; constructors are function values.
            def inKey:string (this.toPropertyKey(left))
            if scriptThrew {
                return (EvalValue.undefined())
            }
            def inHolds:boolean false
            if (right.valueType == 4) { inHolds = true }
            if (right.valueType == 5) { inHolds = true }
            if (right.valueType == 6) { inHolds = true }
            if (right.valueType == 9) { inHolds = true }
            if (right.valueType == 10) { inHolds = true }
            if (false == inHolds) {
                return (this.throwSpecError("TypeError" "Cannot use 'in' operator on a non-object"))
            }
            if (this.objHasKey(right inKey)) {
                return (EvalValue.boolean(true))
            }
            ; `in` walks the PROTOTYPE CHAIN -- it is not hasOwnProperty.
            def inWalk:EvalValue right
            def inDepth:int 0
            while (inDepth < 16) {
                if (null? inWalk.protoRef) {
                    return (EvalValue.boolean(false))
                }
                inWalk = (unwrap inWalk.protoRef)
                if (this.objHasKey(inWalk inKey)) {
                    return (EvalValue.boolean(true))
                }
                inDepth = (inDepth + 1)
            }
            return (EvalValue.boolean(false))
        }
        

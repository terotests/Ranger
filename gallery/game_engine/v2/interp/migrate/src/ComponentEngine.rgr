        ; D-COMPLETION: an iteration statement's completion value starts at
        ; UNDEFINED, not at whatever the statement before it produced. That is
        ; what makes `eval('1; for (x in {}) { }')` undefined rather than 1 --
        ; a loop that runs no iterations, or whose body produces nothing,
        ; evaluates to undefined.
        completionValue = (EvValueBridge.taggedUndefined())
        def savedBreak:boolean loopBreak
        def savedContinue:boolean loopContinue
        def myLabels:[string] (this.takeStatementLabels())
        loopBreak = false
        loopContinue = false
        def maxIterations:int maxLoopIterations
        def iterations:int 0

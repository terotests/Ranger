            ; already run to completion, so there is nothing to resume into and
            ; the exception simply propagates -- which is what it does when the
            ; body has no try/catch, the case every fixture for it uses.
            if (name == "throw") {
                def tv:EvHandle (EvValueBridge.taggedUndefined())
                if ((array_length args) > 0) {
                    tv = (itemAt args 0)
                }
                def endBufT:EvHandle (recv.getMember("__genitems__"))
                if (endBufT.isArrayValue()) {
                    recv.setMember("__genidx__" (EvHandle.fromInt((endBufT.denseLen()))))
                }
                scriptThrowValue = tv
                scriptThrew = true
                return (EvValueBridge.taggedUndefined())
            }
            if (name == "return") {
                def endBuf:EvHandle (recv.getMember("__genitems__"))
                if (endBuf.isArrayValue()) {
                    recv.setMember("__genidx__" (EvHandle.fromInt((endBuf.denseLen()))))
                }
                def rv:EvHandle (EvValueBridge.taggedUndefined())
                if ((array_length args) > 0) {
                    rv = (itemAt args 0)
                }
                res.setMember("value" rv)
                res.setMember("done" (EvValueBridge.taggedBoolean(true)))
                return res
            }
            def idxV:EvHandle (recv.getMember("__genidx__"))
            def idx:int (to_int (idxV.numberOf()))
            def buf:EvHandle (recv.getMember("__genitems__"))
            def n:int 0
            if (buf.isArrayValue()) {
                n = (buf.denseLen())
            }
            if (idx < n) {
                res.setMember("value" (buf.arrayItemAt(idx)))
                res.setMember("done" (EvValueBridge.taggedBoolean(false)))
                recv.setMember("__genidx__" (EvHandle.fromInt((idx + 1))))

            ; way the spec chains them -- TypeError.prototype inherits from
            ; Error.prototype, which inherits from Object.prototype. Without it
            ; a property put on Error.prototype was invisible to every error,
            ; and `Object.getPrototypeOf(new Error())` answered Object.prototype.
            def keysE:[string]
            def valsE:[EvalValue]
            def proto:EvalValue (EvalValue.object(keysE valsE))
            proto.setMember("name" (EvalValue.string(nm)))
            proto.setAttrs("name" true false true)
            proto.setMember("message" (EvalValue.string("")))
            proto.setAttrs("message" true false true)
            proto.setMember("constructor" c)
            proto.setAttrs("constructor" true false true)
            if (nm == "Error") {
                proto.protoRef = (this.builtinPrototype("Object"))
                ; Error itself is an ordinary function object.
                c.protoRef = (this.builtinPrototype("Function"))
            } {
                proto.protoRef = (this.errorPrototypeFor("Error"))
                ; A native error SUBCLASS constructor inherits from Error, which
                ; is what `Object.getPrototypeOf(TypeError) === Error` asserts.
                c.protoRef = (hostScope.lookup("Error"))
            }
            ; Error.prototype.toString is an own property of the prototype, so it
            ; has a descriptor -- writable and configurable, never enumerable.
            proto.setMember("toString" (this.sharedNativeMethod("error" "toString")))
            proto.setAttrs("toString" true false true)
            set builtinProtos nm proto
            c.setMember("prototype" proto)
            c.setAttrs("prototype" false false false)
            hostScope.define(nm c)
            i = (i + 1)
        }
    }

    ; The prototype object for an error kind, created by ensureErrorCtors.
    fn errorPrototypeFor:EvalValue (kind:string) {
        this.ensureErrorCtors()
        if (has builtinProtos kind) {
            return (unwrap (get builtinProtos kind))
        }
        return (this.builtinPrototype("Object"))
    }

    ; The constructor function value for a kind ("TypeError"), or null when the
    ; name is not an error constructor.
    fn errorCtorFor:EvalValue (kind:string) {
        this.ensureErrorCtors()
        return (hostScope.lookup(kind))
    }

    ; Build an error object: { name, message, constructor } plus a marker the
    ; engine uses to recognise it. `constructor` is the shared singleton.
    fn makeError:EvalValue (kind:string message:string) {
        def keys0:[string]
        def vals0:[EvalValue]
        def e:EvalValue (EvalValue.object(keys0 vals0))
        e.setMember("name" (EvalValue.string(kind)))
        e.setMember("message" (EvalValue.string(message)))
        e.setMember("__error__" (EvalValue.string(kind)))
        def ctor:EvalValue (this.errorCtorFor(kind))
        if (ctor.valueType == 6) {
            e.setMember("constructor" ctor)
        }
        e.protoRef = (this.errorPrototypeFor(kind))
        return e
    }

    ; Raise a spec error. Sets the same unwind flags a guest `throw` sets, so a
    ; try/catch around the offending code catches it exactly like any other throw.
    fn throwSpecError:EvalValue (kind:string message:string) {
        scriptThrowValue = (this.makeError(kind message))
        scriptThrew = true
        return (EvalValue.undefined())
    }

    ; Names the engine resolves structurally rather than through a binding
    ; (Math.PI, JSON.stringify, Object.keys …). Reading one of these bare must
    ; not be a ReferenceError even though no binding exists for it.
    fn isEngineGlobalName:boolean (name:string) {
        if (name == "Function") { return true }
        if (name == "Map") { return true }
        if (name == "Set") { return true }
        if (name == "Symbol") { return true }
        if (name == "Math") { return true }
        if (name == "JSON") { return true }
        if (name == "Object") { return true }
        if (name == "Array") { return true }
        if (name == "String") { return true }
        if (name == "Number") { return true }
        if (name == "Boolean") { return true }
        if (name == "Date") { return true }
        if (name == "RegExp") { return true }
        if (name == "console") { return true }
        if (name == "globalThis") { return true }
        if (name == "NaN") { return true }
        if (name == "Infinity") { return true }
        if (name == "undefined") { return true }
        if (name == "arguments") { return true }
        return false
    }

    ; Read an identifier as a *reference*: an unresolvable name is a
    ; ReferenceError, not a silent null. `typeof x` does not come through here
    ; (it uses bindingExists), which is what the spec requires.
    ; D-GLOBALTHIS: created on first use so identity is stable.
    fn seedGlobalConstants:void (g:EvalValue) {
        ; The value properties of the global object. `this.NaN` read undefined
        ; because they lived only as names the resolver knew about.
        if (false == (has g.objectMap "NaN")) {
            g.setMember("NaN" (EvalValue.number((0.0 / 0.0))))
            g.setAttrs("NaN" false false false)
            g.setMember("Infinity" (EvalValue.number((1.0 / 0.0))))
            g.setAttrs("Infinity" false false false)
            g.setMember("undefined" (EvalValue.undefined()))
            g.setAttrs("undefined" false false false)
            ; The global FUNCTION properties. They are resolved by name at the
            ; call site, so `typeof this.parseInt` read undefined even though
            ; `parseInt(...)` worked.
            def gfns:[string]
            push gfns "eval"
            push gfns "parseInt"
            push gfns "parseFloat"
            push gfns "isNaN"
            push gfns "isFinite"
            push gfns "decodeURI"
            push gfns "decodeURIComponent"
            push gfns "encodeURI"
            push gfns "encodeURIComponent"
            def gi:int 0
            while (gi < (array_length gfns)) {
                def gn:string (itemAt gfns gi)
                def gf:EvalValue (EvalValue.nativeFunction(gn))
                gf.setMember("name" (EvalValue.string(gn)))
                gf.setAttrs("name" false false true)
                gf.setMember("length" (EvalValue.fromInt(1)))
                gf.setAttrs("length" false false true)
                g.setMember(gn gf)
                g.setAttrs(gn true false true)
                gi = (gi + 1)
            }
            ; The constructor and namespace globals, as the same objects the
            ; bare names resolve to.
            def gnames:[string]
            push gnames "Object"
            push gnames "Array"
            push gnames "String"
            push gnames "Number"
            push gnames "Boolean"
            push gnames "Function"
            push gnames "Date"
            push gnames "RegExp"
            push gnames "Math"
            push gnames "JSON"
            ; The error constructors are globals too -- getOwnPropertyNames on
            ; the global object is expected to list every one of them.
            def enames:[string] (this.errorKindNames())
            def ei:int 0
            while (ei < (array_length enames)) {
                push gnames (itemAt enames ei)
                ei = (ei + 1)
            }
            def gj:int 0
            while (gj < (array_length gnames)) {
                def gnm:string (itemAt gnames gj)
                g.setMember(gnm (this.builtinGlobalObject(gnm)))
                g.setAttrs(gnm true false true)
                gj = (gj + 1)
            }
        }
    }

    fn theGlobalObject:EvalValue () {
        if globalObject {
            def existing:EvalValue (unwrap globalObject)
            this.seedGlobalConstants(existing)
            return existing
        }
        def keysG:[string]
        def valsG:[EvalValue]
        def g:EvalValue (EvalValue.object(keysG valsG))
        globalObject = g
        this.seedGlobalConstants(g)
        return g
    }

    fn lookupIdentifier:EvalValue (name:string) {
        ; PERF: the three special names gate on LENGTH first — this runs for
        ; every identifier read, and `s == "literal"` pays strlen(literal)
        ; per compare on the C++ target
        def nlen:int (strlen name)
        if ((nlen == 9) && (name == "undefined")) {
            return (EvalValue.undefined())
        }
        ; D-WITH: a name the with object serves through a GETTER. EvalContext
        ; cannot call it -- it has no evaluator -- so the read happens here.
        def wg:EvalValue (this.withHostFor(name))
        if (wg.valueType == 5) {
            if (has wg.getterMap name) {
                def wgFn:EvalValue (wg.findGetter(name 0))
                if (wgFn.valueType == 6) {
                    def wgArgs:[EvalValue]
                    return (this.callFnValueWithValues((wgFn.withThis(wg)) wgArgs))
                }
            }
            if (has wg.objectMap name) {
                return (unwrap (get wg.objectMap name))
            }
            return (EvalValue.undefined())
        }
        ; D-IEEE: Infinity and NaN are VALUES, not merely names the engine knows
        ; about. They were resolving to undefined, so `x === -Infinity` compared
        ; against NaN and was false for every x — a comparison that silently
        ; never held.
        if ((nlen == 8) && (name == "Infinity")) {
            return (EvalValue.number((1.0 / 0.0)))
        }
        if ((nlen == 3) && (name == "NaN")) {
            return (EvalValue.number((0.0 / 0.0)))
        }
        def ctxHit@(optional):EvalValue (context.tryLookup(name))
        if ctxHit {
            return (unwrap ctxHit)
        }
        this.ensureErrorCtors()
        def hostHit@(optional):EvalValue (hostScope.tryLookup(name))
        if hostHit {
            return (unwrap hostHit)
        }
        ; D-GLOBALOBJ: the built-in namespaces are real OBJECTS, not merely names
        ; the engine recognises structurally. They resolved to undefined, so
        ; `Math.value = 1` silently vanished, passing Math where an object is
        ; expected was a TypeError, and every `X.prototype` read off one of them
        ; failed — the largest failure bucket in ES5 was reading a property of
        ; undefined. Calls like Math.floor(x) still dispatch structurally before
        ; reaching here, so this adds reachability without changing dispatch.
        ; D-GLOBALTHIS: `globalThis` IS the global object, not a namespace of its
        ; own. Two different objects answered to `this` and to `globalThis`, so
        ; `this === globalThis` was false at the top level of every script.
        if (name == "globalThis") {
            return (this.theGlobalObject())
        }
        if (this.isEngineGlobalName(name)) {
            def g:EvalValue (this.builtinGlobalObject(name))
            if (g.valueType == 5) {
                return g
            }
            if (g.valueType == 6) {
                return g
            }
            return (EvalValue.undefined())
        }
        ; D-GLOBALTHIS: a bare name may have been created as a property of the
        ; global object (`this.p1 = 1` at top level), which is a global binding.
        def gObj:EvalValue (this.theGlobalObject())
        if (has gObj.objectMap name) {
            return (unwrap (get gObj.objectMap name))
        }
        ; D-CLASSREF: a class is registered in the class table, not bound in a
        ; scope, so its bare name resolved to nothing — and once unresolved names
        ; began throwing, `A.staticMethod()` failed on the receiver before the
        ; call was even attempted. A class name resolves to a value carrying the
        ; class name so it is both referenceable and dispatchable.
        def clsRef:TSNode (this.classNodeByName(name))
        if ((this.nodeKindOf(clsRef)) == 25) {
            def cv:EvalValue (EvalValue.nativeFunction(name))
            cv.setMember("__classname__" (EvalValue.string(name)))
            cv.setMember("name" (EvalValue.string(name)))
            return cv
        }
        if strictReferences {
            return (this.throwSpecError("ReferenceError" (name + " is not defined")))
        }
        return (EvalValue.null())
    }

    fn typeofTag:string (val:EvalValue) {
        if (val.isUndefined()) {
            return "undefined"
        }
        if (val.isNull()) {
            return "object"
        }
        if (val.isNumber()) {
            return "number"
        }
        if (val.isString()) {
            return "string"
        }
        if (val.isBoolean()) {
            return "boolean"
        }
        if (val.isFunction()) {
            return "function"
        }
        if (val.isArray()) {
            return "object"
        }
        if (val.isObject()) {
            ; D-SYMBOL: symbols are modelled as objects internally, but `typeof`
            ; must answer "symbol" — that is how guest code tells them apart, and
            ; answering "object" would make every symbol type-check wrong.
            def symTag@(optional):EvalValue (get val.objectMap "__symbol__")
            if symTag {
                return "symbol"
            }
            return "object"
        }
        if (val.isMap()) {
            return "object"
        }
        if (val.isSet()) {
            return "object"
        }
        if (val.isElement()) {
            return "object"
        }
        return "undefined"
    }

    fn evaluateTypeofExpr:EvalValue (node:TSNode) {
        if node.left {
            def argNode:TSNode (unwrap node.left)
            if ((this.nodeKindOf(argNode)) == 1) {
                def name:string argNode.name
                if (name == "undefined") {
                    return (EvalValue.string("undefined"))
                }
                if (false == (this.bindingExists(name))) {
                    ; D-GLOBALOBJ: a built-in global is not a scope binding, but
                    ; it exists — typeof must say so. Constructors report
                    ; "function", namespaces like Math and JSON report "object".
                    if (this.isEngineGlobalName(name)) {
                        if (this.isBuiltinCtorName(name)) {
                            return (EvalValue.string("function"))
                        }
                        ; A VALUE property of the global -- NaN, Infinity -- is a
                        ; number, and asking builtinGlobalObject for it minted an
                        ; empty namespace object instead, so `typeof NaN` was
                        ; "object". The global object holds the real value.
                        def gObjT:EvalValue (this.theGlobalObject())
                        if (gObjT.valueType == 5) {
                            if (has gObjT.objectMap name) {
                                return (EvalValue.string((this.typeofTag((unwrap (get gObjT.objectMap name))))))
                            }
                        }
                        def gv:EvalValue (this.builtinGlobalObject(name))
                        if (gv.valueType == 5) {
                            return (EvalValue.string("object"))
                        }
                    }
                    return (EvalValue.string("undefined"))
                }
                def val:EvalValue (context.lookup(name))
                return (EvalValue.string((this.typeofTag(val))))
            }
            def val:EvalValue (this.evaluateExpr(argNode))
            return (EvalValue.string((this.typeofTag(val))))
        }
        return (EvalValue.string("undefined"))
    }
    
    fn evaluateUnaryExpr:EvalValue (node:TSNode) {
        def op:string node.value
        def opK:int (this.opKindOf(node))
        if (opK == 46) {
            return (this.evaluateTypeofExpr(node))
        }
        ; delete obj.x / obj["k"] / arr[i] — remove the property (operand is a
        ; reference, so it must not be evaluated to a value first).
        if (opK == 47) {
            if node.left {
                def tgt:TSNode (unwrap node.left)

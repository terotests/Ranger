    fn collMarkRank:int (cp:int) {
        def n:int (array_length collMarks)
        def pairs:int (bit_shr n 1)
        def lo:int 0
        def hi:int (pairs - 1)
        while (lo <= hi) {
            def mid:int (bit_shr (lo + hi) 1)
            def base:int (mid * 2)
            def a:int (itemAt collMarks base)
            if (cp < a) {
                hi = (mid - 1)
            } {
                if (cp > a) {
                    lo = (mid + 1)
                } {
                    return (itemAt collMarks (base + 1))
                }
            }
        }
        return (0 - 1)
    }

    ; (secondary rank, base points...) for a letter that does not decompose but
    ; belongs under a simpler one. Empty when there is none.
    fn collBaseFor:[int] (cp:int) {
        def out:[int]
        def n:int (array_length collBases)
        def i:int 0
        while (i < n) {
            def c:int (itemAt collBases i)
            def sec:int (itemAt collBases (i + 1))
            def cnt:int (itemAt collBases (i + 2))
            if (c == cp) {
                push out sec
                def k:int 0
                while (k < cnt) {
                    push out (itemAt collBases ((i + 3) + k))
                    k = (k + 1)
                }
                return out
            }
            i = ((i + 3) + cnt)
        }
        return out
    }

    ; The characters that compare as a SEQUENCE of others -- ß as "ss". Empty
    ; when the character stands for itself.
    fn collExpandFor:[int] (cp:int) {
        def out:[int]
        def n:int (array_length collExpand)
        def i:int 0
        while (i < n) {
            def c:int (itemAt collExpand i)
            def cnt:int (itemAt collExpand (i + 1))
            if (c == cp) {
                def k:int 0
                while (k < cnt) {
                    push out (itemAt collExpand ((i + 2) + k))
                    k = (k + 1)
                }
                return out
            }
            i = ((i + 2) + cnt)
        }
        return out
    }


    ; ---- D-COLLATE: per-locale tailorings ---------------------------------
    ; localeCompare's second argument was IGNORED, so `a.localeCompare(b, 'sv')`
    ; answered the root order. Right for English, French, German, Italian, Dutch
    ; and Portuguese -- their alphabets ARE the root alphabet -- and silently
    ; wrong for every language that tailors it. Swedish sorts å ä ö after z;
    ; Czech treats ch as a letter between h and i; Hungarian cs and zs are
    ; letters of their own; Turkish dotless ı sorts before i; Spanish ñ is a
    ; letter after n. An index built in any of those came out misfiled with no
    ; error anywhere, which is the worst way for this to be wrong.
    ;
    ; A tailoring is a list of (anchor, offset, element): the element takes the
    ; primary weight of the anchor letter plus the offset. Root weights are
    ; scaled by 1000 to leave room. See UnicodeTailor.rgr.
    fn ensureTailorTables:void () {
        if tailorTablesLoaded { return }
        tailorLocales = (UnicodeTailor.locales())
        tailorEntries = (UnicodeTailor.entries())
        tailorTablesLoaded = true
    }

    ; Select the tailoring for a BCP 47 tag, or none. An exact tag wins
    ; ("sr-latn"); otherwise the language subtag decides, so "sv-SE" and
    ; "sv-FI" both find "sv".
    fn collSelectLocale:void (tag:string) {
        tailorEntryOff = 0
        tailorEntryCount = 0
        if ((strlen tag) == 0) { return }
        this.ensureTailorTables()
        def want:string (this.unicodeCaseConvert(tag false))
        def short:string want
        def dash:int (indexOf want "-")
        if (dash > 0) {
            short = (this.cuSlice(want 0 dash))
        }
        def pass:int 0
        while (pass < 2) {
            def probe:string want
            if (pass == 1) { probe = short }
            def probeCps:[int] (this.codePointsOf(probe))
            def pn:int (array_length probeCps)
            def i:int 0
            def n:int (array_length tailorLocales)
            while (i < n) {
                def tlen:int (itemAt tailorLocales i)
                def same:boolean (tlen == pn)
                if same {
                    def k:int 0
                    while (k < tlen) {
                        if ((itemAt tailorLocales ((i + 1) + k)) != (itemAt probeCps k)) {
                            same = false
                        }
                        k = (k + 1)
                    }
                }
                if same {
                    tailorEntryOff = (itemAt tailorLocales ((i + 1) + tlen))
                    tailorEntryCount = (itemAt tailorLocales ((i + 2) + tlen))
                    return
                }
                i = ((i + 3) + tlen)
            }
            pass = (pass + 1)
        }
    }

    ; The LONGEST tailored element starting at `i`, as (weight, length). Empty
    ; when none matches. Longest wins so Hungarian dzs beats dz.
    fn collTailorMatch:[int] (cps:[int] i:int) {
        def out:[int]
        if (tailorEntryCount == 0) { return out }
        def n:int (array_length cps)
        def bestLen:int 0
        def bestW:int 0
        def p:int tailorEntryOff
        def k:int 0
        while (k < tailorEntryCount) {
            def anchor:int (itemAt tailorEntries p)
            def off:int (itemAt tailorEntries (p + 1))
            def elen:int (itemAt tailorEntries (p + 2))
            if (elen > bestLen) {
                if ((i + elen) <= n) {
                    def ok:boolean true
                    def q:int 0
                    while (q < elen) {
                        if ((itemAt cps (i + q)) != (itemAt tailorEntries ((p + 3) + q))) {
                            ok = false
                        }
                        q = (q + 1)
                    }
                    if ok {
                        bestLen = elen
                        bestW = (((100000 + anchor) * 1000) + off)
                    }
                }
            }
            p = ((p + 3) + elen)
            k = (k + 1)
        }
        if (bestLen > 0) {
            push out bestW
            push out bestLen
        }
        return out
    }

    ; The three sort keys of a string, laid end to end as
    ; (primary count, primary..., secondary count, secondary..., tertiary...).
    ; Built in one pass over the decomposed text.
    fn collationKeys:[int] (s:string) {
        this.ensureCollateTables()
        def prim:[int]
        def sec:[int]
        def ter:[int]
        def cps:[int] (this.nfdPoints((this.codePointsOf(s))))
        def n:int (array_length cps)
        def i:int 0
        while (i < n) {
            def cp:int (itemAt cps i)
            ; A tailored element comes first and may cover several code points
            ; -- Czech ch, Hungarian dzs, Swedish a-plus-ring -- so nothing
            ; inside it reaches the mark or base handling below.
            def tm:[int] (this.collTailorMatch(cps i))
            if ((array_length tm) > 0) {
                push prim (itemAt tm 0)
                def tk:int 0
                while (tk < (itemAt tm 1)) {
                    push ter 0
                    tk = (tk + 1)
                }
                i = ((i + (itemAt tm 1)) - 1)
            } {
            def mr:int (this.collMarkRank(cp))
            if (mr >= 0) {
                push sec mr
            } {
                def lowered:string (this.unicodeCaseConvert((this.cuFromCodePoint(cp)) false))
                def loCps:[int] (this.codePointsOf(lowered))
                def loCp:int cp
                if ((array_length loCps) > 0) { loCp = (itemAt loCps 0) }
                def isUpper:int 0
                if (loCp != cp) { isUpper = 1 }
                def base:[int] (this.collBaseFor(cp))
                if ((array_length base) == 0) {
                    base = (this.collBaseFor(loCp))
                }
                def points:[int]
                if ((array_length base) > 0) {
                    push sec (itemAt base 0)
                    def bk:int 1
                    while (bk < (array_length base)) {
                        push points (itemAt base bk)
                        bk = (bk + 1)
                    }
                } {
                    def ex:[int] (this.collExpandFor(cp))
                    if ((array_length ex) > 0) {
                        def ek:int 0
                        while (ek < (array_length ex)) {
                            push points (itemAt ex ek)
                            ek = (ek + 1)
                        }
                    } {
                        push points loCp
                    }
                }
                def pk:int 0
                while (pk < (array_length points)) {
                    def bcp:int (itemAt points pk)
                    def pr:int (this.collPunctRank(bcp))
                    ; Scaled by 1000: a tailoring places its element in the gap
                    ; between one root letter and the next, and the gap has to
                    ; exist before anything can be put in it.
                    if (pr >= 0) {
                        push prim (pr * 1000)
                    } {
                        push prim ((100000 + bcp) * 1000)
                    }
                    push ter isUpper
                    pk = (pk + 1)
                }
            }
            }
            i = (i + 1)
        }
        def out:[int]
        def pn:int (array_length prim)
        push out pn
        def a:int 0
        while (a < pn) {
            push out (itemAt prim a)
            a = (a + 1)
        }
        def sn:int (array_length sec)
        push out sn
        def b:int 0
        while (b < sn) {
            push out (itemAt sec b)
            b = (b + 1)
        }
        def tn:int (array_length ter)
        push out tn
        def c:int 0
        while (c < tn) {
            push out (itemAt ter c)
            c = (c + 1)
        }
        return out
    }

    ; Compare one level of two keys, given where it starts in each.
    fn collLevelCmp:int (ka:[int] ia:int kb:[int] ib:int) {
        def na:int (itemAt ka ia)
        def nb:int (itemAt kb ib)
        def m:int na
        if (nb < m) { m = nb }
        def i:int 0
        while (i < m) {
            def x:int (itemAt ka ((ia + 1) + i))
            def y:int (itemAt kb ((ib + 1) + i))
            if (x < y) { return (0 - 1) }
            if (x > y) { return 1 }
            i = (i + 1)
        }
        if (na < nb) { return (0 - 1) }
        if (na > nb) { return 1 }
        return 0
    }

    fn collateStrings:int (a:string b:string) {
        return (this.collateStringsLevels(a b 3))
    }

    ; The same comparison, cut short after `levels` of the three. That is what
    ; Intl.Collator's `sensitivity` option selects: 'base' stops after the base
    ; letters, so it is accent- and case-blind; 'accent' stops after the
    ; accents, so it is case-blind.
    fn collateStringsLevels:int (a:string b:string levels:int) {
        if (a == b) { return 0 }
        def ka:[int] (this.collationKeys(a))
        def kb:[int] (this.collationKeys(b))
        def ia:int 0
        def ib:int 0
        def lvl:int 0
        while (lvl < levels) {
            def c:int (this.collLevelCmp(ka ia kb ib))
            if (c != 0) { return c }
            ia = ((ia + 1) + (itemAt ka ia))
            ib = ((ib + 1) + (itemAt kb ib))
            lvl = (lvl + 1)
        }
        ; A comparison cut short is meant to answer EQUAL for strings that
        ; differ only below the cut -- that is the whole point of
        ; {sensitivity:'base'} -- so it must not fall through to code units.
        if (levels < 3) { return 0 }
        ; Equal at every level but not the same text: fall back to code units,
        ; because localeCompare must be a strict total order -- returning 0 for
        ; two different strings makes Array#sort behave differently depending
        ; on the order the elements happened to be in.
        return (this.compareStrings(a b))
    }


    ; ==========================================================================
    ; D-INTL: ECMA-402, the part a document generator needs.
    ; --------------------------------------------------------------------------
    ; `Intl` did not exist, so `new Intl.NumberFormat('de').format(n)` was a
    ; ReferenceError. localeCompare already did real collation, but a program
    ; that reaches for the Collator object directly -- which is what you do when
    ; you sort the same list more than once, because it builds the comparison
    ; once -- found nothing there.
    ;
    ; What is here: Collator, NumberFormat, DateTimeFormat, getCanonicalLocales,
    ; supportedLocalesOf, and the toLocaleString family that delegates to them.
    ; The CLDR data is in LocaleData.rgr (generated) for 39 locales; anything
    ; else falls back to "en" AND SAYS SO through resolvedOptions().locale, so a
    ; program can tell it did not get what it asked for.
    fn ensureLocaleTables:void () {
        if localeTablesLoaded { return }
        localeTags = (LocaleData.tags())
        localeNumStr = (LocaleData.numStrings())
        localeNumInt = (LocaleData.numInts())
        localeNames = (LocaleData.names())
        localePatInt = (LocaleData.patternInts())
        localePatStr = (LocaleData.patternStrings())
        localeCurStr = (LocaleData.currencyStrings())
        localeCurInt = (LocaleData.currencyInts())
        localeTablesLoaded = true
    }

    ; The index of a BCP 47 tag in the tables: the exact tag if it is carried
    ; ("en-GB", "pt-BR"), otherwise the language subtag ("de-AT" -> "de"), and 0
    ; for "en" when neither is.
    fn localeIndexOf:int (tag:string) {
        this.ensureLocaleTables()
        if ((strlen tag) == 0) { return 0 }
        def want:string (this.unicodeCaseConvert(tag false))
        def n:int (array_length localeTags)
        def i:int 0
        while (i < n) {
            if ((itemAt localeTags i) == want) { return i }
            i = (i + 1)
        }
        def dash:int (indexOf want "-")
        if (dash > 0) {
            def short:string (this.cuSlice(want 0 dash))
            def j:int 0
            while (j < n) {
                if ((itemAt localeTags j) == short) { return j }
                j = (j + 1)
            }
        }
        return 0
    }

    ; The first usable tag out of a `locales` argument, which the spec allows to
    ; be a string or a list of them.
    fn intlRequestedTag:[EvHandle] (v:EvHandle) {
        def out:[EvHandle]
        if (v.isUndefined()) { return out }
        if (v.isArrayValue()) {
            def i:int 0
            while (i < (v.denseLen())) {
                push out (v.arrayItemAt(i))
                i = (i + 1)
            }
            return out
        }
        push out v
        return out
    }

    fn intlFirstTag:string (v:EvHandle) {
        def list:[EvHandle] (this.intlRequestedTag(v))
        if ((array_length list) == 0) { return "" }
        return (this.toStringOf((itemAt list 0)))
    }

    ; §6.2.3 CanonicalizeUnicodeLocaleId, to the extent this realm models it:
    ; the language subtag lowercases, a script subtag title-cases, a region
    ; subtag uppercases. `EN-latn-us` canonicalises to `en-Latn-US`.
    fn canonicalizeLocaleTag:string (tag:string) {
        def parts:[string] (strsplit tag "-")
        def out:string ""
        def i:int 0
        while (i < (array_length parts)) {
            def p:string (itemAt parts i)
            def np:int (this.cuLen(p))
            def piece:string (this.unicodeCaseConvert(p false))
            if (i > 0) {
                if (np == 4) {
                    def head:string (this.cuSlice(p 0 1))
                    def tail:string (this.cuSlice(p 1 np))
                    def upHead:string (this.unicodeCaseConvert(head true))
                    def loTail:string (this.unicodeCaseConvert(tail false))
                    piece = (upHead + loTail)
                }
                if (np == 2) {
                    piece = (this.unicodeCaseConvert(p true))
                }
                if (np == 3) {
                    def allDigits:boolean true
                    def d:int 0
                    while (d < np) {
                        def c:int (this.cuUnitAt(p d))
                        if ((c < 48) || (c > 57)) { allDigits = false }
                        d = (d + 1)
                    }
                    if allDigits { piece = p }
                }
            }
            if (i > 0) { out = (out + "-") }
            out = (out + piece)
            i = (i + 1)
        }
        return out
    }

    ; ---- Intl.NumberFormat -------------------------------------------------
    ; Grouping runs from the RIGHT and the first group can be a different size
    ; from the rest: South Asian locales group 3 then 2, so 1234567 is 12,34,567
    ; and not 1,234,567.
    fn intlGroupInteger:string (digits:string loc:int useGroup:boolean) {
        def sep:string (itemAt localeNumStr ((loc * 22) + 1))
        if (useGroup == false) { return digits }
        if ((strlen sep) == 0) { return digits }
        def primary:int (itemAt localeNumInt ((loc * 5) + 0))
        def secondary:int (itemAt localeNumInt ((loc * 5) + 1))
        def minGroup:int (itemAt localeNumInt ((loc * 5) + 2))
        def n:int (this.cuLen(digits))
        if (n <= primary) { return digits }
        ; CLDR minimumGroupingDigits: Spanish and Italian do not group a
        ; four-digit number at all, so 9876.5 is "9876,5" there.
        if (n < (primary + minGroup)) { return digits }
        def groups:[string]
        def end:int n
        def start:int (n - primary)
        push groups (this.cuSlice(digits start end))
        end = start
        while (end > 0) {
            start = (end - secondary)
            if (start < 0) { start = 0 }
            push groups (this.cuSlice(digits start end))
            end = start
        }
        def out:string ""
        def g:int ((array_length groups) - 1)
        while (g >= 0) {
            out = (out + (itemAt groups g))
            if (g > 0) { out = (out + sep) }
            g = (g - 1)
        }
        return out
    }

    ; Whether this currency's symbol is LETTERS in this locale, which is what
    ; decides the spacing.
    fn intlCurrencyIsLetters:boolean (loc:int code:string) {
        def per:int (LocaleData.currencyCount())
        def base:int (loc * per)
        def i:int 0
        while (i < per) {
            if ((itemAt localeCurStr (((base + i) * 2) + 0)) == code) {
                return ((itemAt localeCurInt (base + i)) == 1)
            }
            i = (i + 1)
        }
        return true
    }

    ; The symbol a currency code has in this locale, or the code itself.
    fn intlCurrencySymbol:string (loc:int code:string) {
        def per:int (LocaleData.currencyCount())
        def base:int (loc * per)
        def i:int 0
        while (i < per) {
            if ((itemAt localeCurStr (((base + i) * 2) + 0)) == code) {
                return (itemAt localeCurStr (((base + i) * 2) + 1))
            }
            i = (i + 1)
        }
        return code
    }

    ; The prefix and suffix that go outside the digits, for this style and
    ; sign. Recorded rather than assembled from a sign and a symbol: German
    ; puts a space before the percent sign, Dutch puts the minus after the
    ; currency symbol, and neither falls out of a rule.
    fn intlAffix:[string] (loc:int style:string neg:boolean currency:string) {
        def base:int (loc * 22)
        def off:int 4
        if (style == "percent") { off = 8 }
        if (style == "currency") {
            ; Two templates, because CLDR puts a space between the symbol and
            ; the digits only when they would otherwise run letter-into-digit.
            ; Japanese writes €1,234 with no space and US$ 1,234 with one, from
            ; the same pattern.
            off = 12
            if (false == (this.intlCurrencyIsLetters(loc currency))) {
                off = 16
            }
        }
        if neg { off = (off + 2) }
        def out:[string]
        def pre:string (itemAt localeNumStr (base + off))
        def suf:string (itemAt localeNumStr ((base + off) + 1))
        if (style == "currency") {
            ; The affix templates were recorded with currency XXX, which the
            ; host formats as U+00A4 -- the generic CURRENCY SIGN, whose whole
            ; meaning is "a currency symbol goes here". So it is the
            ; placeholder, and substituting it recovers the locale's pattern
            ; exactly, including which side of the symbol the minus goes.
            def sym:string (this.intlCurrencySymbol(loc currency))
            pre = (this.replaceAllPlain(pre "¤" sym))
            suf = (this.replaceAllPlain(suf "¤" sym))
        }
        push out pre
        push out suf
        return out
    }

    ; A literal find-and-replace, no regular expression involved.
    fn replaceAllPlain:string (src:string find:string repl:string) {
        if ((strlen find) == 0) { return src }
        def out:string ""
        def rest:string src
        def guard:boolean true
        while guard {
            def at:int (indexOf rest find)
            if (at < 0) {
                guard = false
            } {
                def cuAt:int (this.cuIndexOfByte(rest at))
                def cuFind:int (this.cuLen(find))
                def head2:string (this.cuSlice(rest 0 cuAt))
                def restLen:int (this.cuLen(rest))
                out = ((out + head2) + repl)
                rest = (this.cuSlice(rest (cuAt + cuFind) restLen))
            }
        }
        return (out + rest)
    }

    fn intlFormatNumber:string (loc:int value:double style:string currency:string minFrac:int maxFrac:int useGroup:boolean minInt:int) {
        this.ensureLocaleTables()
        def dec:string (itemAt localeNumStr ((loc * 22) + 0))
        def minus:string (itemAt localeNumStr ((loc * 22) + 2))
        def v:double value
        if (style == "percent") { v = (v * 100.0) }
        if (v != v) { return "NaN" }
        def neg:boolean false
        if (v < 0.0) {
            neg = true
            v = (0.0 - v)
        }
        if (false == (this.isFiniteNum(v))) {
            def infS:string "∞"
            if neg { return (minus + infS) }
            return infS
        }
        ; Round to maxFrac and render, then trim to the digits actually wanted.
        def body:string (this.toFixedString(v maxFrac))
        def dot:int (indexOf body ".")
        def intPart:string body
        def fracPart:string ""
        if (dot >= 0) {
            def bodyLen:int (this.cuLen(body))
            intPart = (this.cuSlice(body 0 dot))
            fracPart = (this.cuSlice(body (dot + 1) bodyLen))
        }
        ; Trailing zeros above the minimum come off.
        def fl:int (this.cuLen(fracPart))
        def trimming:boolean true
        while (trimming && (fl > minFrac)) {
            if ((this.cuUnitAt(fracPart (fl - 1))) == 48) {
                fl = (fl - 1)
            } {
                trimming = false
            }
        }
        fracPart = (this.cuSlice(fracPart 0 fl))
        while ((this.cuLen(intPart)) < minInt) {
            intPart = ("0" + intPart)
        }
        def out:string (this.intlGroupInteger(intPart loc useGroup))
        if ((this.cuLen(fracPart)) > 0) {
            out = ((out + dec) + fracPart)
        }
        def aff:[string] (this.intlAffix(loc style neg currency))
        return (((itemAt aff 0) + out) + (itemAt aff 1))
    }

    ; ---- Intl.DateTimeFormat ------------------------------------------------
    ; Five patterns per locale: short date, long date, full date, short time,
    ; long time. The ORDER is the point -- en is month first, en-GB day first,
    ; ja year first -- and so are the separators, which are "/" in one place and
    ; ". " with a trailing dot in Hungarian.
    fn intlPatternOffset:int (loc:int which:int) {
        def i:int 0
        def p:int 0
        while (i < (loc * 6)) {
            def cnt:int (itemAt localePatInt p)
            p = ((p + 1) + (cnt * 3))
            i = (i + 1)
        }
        def k:int 0
        while (k < which) {
            def cnt2:int (itemAt localePatInt p)
            p = ((p + 1) + (cnt2 * 3))
            k = (k + 1)
        }
        return p
    }

    ; Zero-padded to the width the locale uses for that field, which is
    ; recorded rather than assumed: Polish pads the month but not the day.
    fn intlPadNum:string (n:int width:int) {
        def out:string (to_string n)
        while ((this.cuLen(out)) < width) {
            out = ("0" + out)
        }
        return out
    }

    fn intlFormatDate:string (loc:int which:int t:double) {
        return (this.intlFormatDateW(loc which t 0))
    }

    fn intlFormatDateW:string (loc:int which:int t:double hourWidth:int) {
        this.ensureLocaleTables()
        def dtl (new DateTime)
        ; Thai dates default to the Buddhist calendar, which is the Gregorian
        ; year plus 543.
        def year:int ((dtl.yearFromTime(t)) + (itemAt localeNumInt ((loc * 5) + 4)))
        def month:int (dtl.monthFromTime(t))
        def day:int (dtl.dateFromTime(t))
        def wday:int (dtl.weekDay(t))
        def hour:int (dtl.hourFromTime(t))
        def minute:int (dtl.minFromTime(t))
        def second:int (dtl.secFromTime(t))
        def hour12:boolean ((itemAt localeNumInt ((loc * 5) + 3)) == 1)
        def p:int (this.intlPatternOffset(loc which))
        def cnt:int (itemAt localePatInt p)
        def out:string ""
        def i:int 0
        while (i < cnt) {
            def field:int (itemAt localePatInt ((p + 1) + (i * 3)))
            def litIdx:int (itemAt localePatInt ((p + 2) + (i * 3)))
            def width:int (itemAt localePatInt ((p + 3) + (i * 3)))
            if (field == 0) {
                out = (out + (itemAt localePatStr litIdx))
            }
            if (field == 1) { out = (out + (to_string year)) }
            if (field == 2) {
                ; A month field is either a NAME or a number, and the table
                ; says which: width 0 means a name. Inferring it from the
                ; length was wrong for Korean, whose long-date month is 5월 --
                ; two characters, exactly like a zero-padded number.
                if (width == 0) {
                    out = (out + (itemAt localeNames (((loc * 38) + month))))
                } {
                    out = (out + (this.intlPadNum((month + 1) width)))
                }
            }
            if (field == 3) { out = (out + (this.intlPadNum(day width))) }
            if (field == 4) {
                out = (out + (itemAt localeNames ((((loc * 38) + 24) + wday))))
            }
            if (field == 5) {
                def h:int hour
                if hour12 {
                    h = (h - (12 * (this.intDiv(h 12))))
                    if (h == 0) { h = 12 }
                }
                def hw:int width
                if (hourWidth > 0) { hw = hourWidth }
                out = (out + (this.intlPadNum(h hw)))
            }
            if (field == 6) { out = (out + (this.intlPadNum(minute width))) }
            if (field == 7) { out = (out + (this.intlPadNum(second width))) }
            if (field == 8) {
                ; The day-period WORD, which is not always AM/PM.
                def dpOff:int ((loc * 22) + 20)
                if (hour < 12) {
                    out = (out + (itemAt localeNumStr dpOff))
                } {
                    out = (out + (itemAt localeNumStr (dpOff + 1)))
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; The locale a request actually RESOLVED to. A tag with no data falls back
    ; to "en", and saying so here is what lets a program see that it did not get
    ; what it asked for rather than quietly formatting in the wrong language.
    fn intlResolvedLocale:EvHandle (recv:EvHandle) {
        this.ensureLocaleTables()
        def idx:int (this.toIntegerOf((recv.getOwnData("__intllocale__"))))
        return (EvValueBridge.taggedString((this.canonicalizeLocaleTag((itemAt localeTags idx)))))
    }


    ; ---- formatToParts ------------------------------------------------------
    ; The same formatting, reported as the (type, value) pieces it is built
    ; from. A document generator wants these: they are how you style the
    ; currency symbol differently from the digits, or right-align on the decimal
    ; separator, without parsing the formatted string back apart.
    ;
    ; Built by SPLITTING the affixes and the grouped digits, so the parts and
    ; the string can never disagree -- format() is the parts joined.
    fn intlNumberParts:[EvHandle] (loc:int value:double style:string currency:string minFrac:int maxFrac:int useGroup:boolean minInt:int) {
        this.ensureLocaleTables()
        def out:[EvHandle]
        def dec:string (itemAt localeNumStr ((loc * 22) + 0))
        def grp:string (itemAt localeNumStr ((loc * 22) + 1))
        def minus:string (itemAt localeNumStr ((loc * 22) + 2))
        def pct:string (itemAt localeNumStr ((loc * 22) + 3))
        def v:double value
        if (style == "percent") { v = (v * 100.0) }
        if (v != v) {
            push out (this.intlPart("nan" "NaN"))
            return out
        }
        def neg:boolean false
        if (v < 0.0) {
            neg = true
            v = (0.0 - v)
        }
        def aff:[string] (this.intlAffix(loc style neg currency))
        def sym:string (this.intlCurrencySymbol(loc currency))
        out = (this.intlPushAffix(out (itemAt aff 0) minus sym style pct))
        if (false == (this.isFiniteNum(v))) {
            push out (this.intlPart("infinity" "∞"))
            out = (this.intlPushAffix(out (itemAt aff 1) minus sym style pct))
            return out
        }
        def body:string (this.toFixedString(v maxFrac))
        def dot:int (indexOf body ".")
        def intPart:string body
        def fracPart:string ""
        if (dot >= 0) {
            def bodyLen:int (this.cuLen(body))
            intPart = (this.cuSlice(body 0 dot))
            fracPart = (this.cuSlice(body (dot + 1) bodyLen))
        }
        def fl:int (this.cuLen(fracPart))
        def trimming:boolean true
        while (trimming && (fl > minFrac)) {
            if ((this.cuUnitAt(fracPart (fl - 1))) == 48) {
                fl = (fl - 1)
            } {
                trimming = false
            }
        }
        fracPart = (this.cuSlice(fracPart 0 fl))
        while ((this.cuLen(intPart)) < minInt) {
            intPart = ("0" + intPart)
        }
        ; The grouped integer, split back into `integer` and `group` pieces --
        ; which is exactly what the host reports.
        def grouped:string (this.intlGroupInteger(intPart loc useGroup))
        if ((this.cuLen(grp)) == 0) {
            push out (this.intlPart("integer" grouped))
        } {
            def rest:string grouped
            def going:boolean true
            while going {
                def at:int (indexOf rest grp)
                if (at < 0) {
                    going = false
                } {
                    def cuAt:int (this.cuIndexOfByte(rest at))
                    def restLen:int (this.cuLen(rest))
                    def head:string (this.cuSlice(rest 0 cuAt))
                    push out (this.intlPart("integer" head))
                    push out (this.intlPart("group" grp))
                    def grpLen:int (this.cuLen(grp))
                    rest = (this.cuSlice(rest (cuAt + grpLen) restLen))
                }
            }
            push out (this.intlPart("integer" rest))
        }
        if ((this.cuLen(fracPart)) > 0) {
            push out (this.intlPart("decimal" dec))
            push out (this.intlPart("fraction" fracPart))
        }
        out = (this.intlPushAffix(out (itemAt aff 1) minus sym style pct))
        return out
    }

    ; §6.2.3 CanonicalizeLocaleList, optionally keeping only the tags there is
    ; data for -- which is how supportedLocalesOf lets a program discover the
    ; fallback before it formats anything.
    fn intlLocaleList:EvHandle (args:[EvHandle] onlySupported:boolean) {
        def inV:EvHandle (EvValueBridge.taggedUndefined())
        if ((array_length args) > 0) { inV = (itemAt args 0) }
        def tags:[EvHandle] (this.intlRequestedTag(inV))
        def outT:[EvHandle]
        def ti:int 0
        while (ti < (array_length tags)) {
            def raw:string (this.toStringOf((itemAt tags ti)))
            if scriptThrew { return (EvValueBridge.taggedUndefined()) }
            def canon:string (this.canonicalizeLocaleTag(raw))
            def keep:boolean true
            if onlySupported {
                this.ensureLocaleTables()
                def want:string (this.unicodeCaseConvert(canon false))
                keep = false
                def li:int 0
                while (li < (array_length localeTags)) {
                    if ((itemAt localeTags li) == want) { keep = true }
                    li = (li + 1)
                }
                if (keep == false) {
                    def dash:int (indexOf want "-")
                    if (dash > 0) {
                        def sh:string (this.cuSlice(want 0 dash))
                        def lj:int 0
                        while (lj < (array_length localeTags)) {
                            if ((itemAt localeTags lj) == sh) { keep = true }
                            lj = (lj + 1)
                        }
                    }
                }
            }
            if keep {
                push outT (EvValueBridge.taggedString(canon))
            }
            ti = (ti + 1)
        }
        return (EvValueBridge.taggedArray(outT))
    }

    fn intlSupportedLocales:EvHandle (args:[EvHandle]) {
        return (this.intlLocaleList(args true))
    }

    ; A time value from a call argument: a Date, a number, or `now` when the
    ; argument is missing.
    fn intlTimeArg:double (args:[EvHandle] i:int) {
        if (i >= (array_length args)) { return hostNowMs }
        def av:EvHandle (itemAt args i)
        if (av.isUndefined()) { return hostNowMs }
        if (av.isObject()) {
            if (av.hasOwnData("__date__")) {
                return ((av.getOwnData("__date__")).toNumber())
            }
        }
        return (this.toNumberOf(av))
    }

    fn intlPart:EvHandle (t:string v:string) {
        def keys:[string]
        def vals:[EvHandle]
        def o:EvHandle (EvValueBridge.taggedObject(keys vals))
        o.setMember("type" (EvValueBridge.taggedString(t)))
        o.setMember("value" (EvValueBridge.taggedString(v)))
        o.setProto((this.builtinPrototype("Object")))
        return o
    }

    ; An affix is a run of literal text that may contain the minus sign, the
    ; percent sign or the currency symbol. Split it into those pieces so each
    ; is reported under its own type rather than lumped into one literal.
    ; Returns the LIST rather than pushing into the parameter.
    ;
    ; `push out x` on a parameter does not reach the caller on the Go target: a
    ; slice is passed by value and the append rebinds the local. As a `:void`
    ; that mutated `out`, every affix — minusSign, currency, percentSign and the
    ; literal between them — was silently dropped on Go, so
    ; `new Intl.NumberFormat("de-DE", {style:"currency", currency:"EUR"})`
    ; formatted 1234.5 as "1.234,50" there and "1.234,50 EUR" everywhere else.
    ; Eight Intl probes; found by tests/native/es_conformance_main.rgr, which is
    ; the first thing to run the conformance corpus on a compiled target.
    fn intlPushAffix:[EvHandle] (out:[EvHandle] affix:string minus:string sym:string style:string pct:string) {
        if ((this.cuLen(affix)) == 0) { return out }
        def marks:[string]
        def types:[string]
        push marks minus
        push types "minusSign"
        if (style == "percent") {
            push marks pct
            push types "percentSign"
        }
        if (style == "currency") {
            push marks sym
            push types "currency"
        }
        def rest:string affix
        def guard:boolean true
        while guard {
            def bestAt:int (0 - 1)
            def bestI:int (0 - 1)
            def mi:int 0
            while (mi < (array_length types)) {
                def m:string (itemAt marks mi)
                if ((this.cuLen(m)) > 0) {
                    def at:int (indexOf rest m)
                    if (at >= 0) {
                        def cuAt:int (this.cuIndexOfByte(rest at))
                        if (bestAt < 0) {
                            bestAt = cuAt
                            bestI = mi
                        } {
                            if (cuAt < bestAt) {
                                bestAt = cuAt
                                bestI = mi
                            }
                        }
                    }
                }
                mi = (mi + 1)
            }
            if (bestI < 0) {
                guard = false
            } {
                def m2:string (itemAt marks bestI)
                def restLen:int (this.cuLen(rest))
                if (bestAt > 0) {
                    def litHead:string (this.cuSlice(rest 0 bestAt))
                    push out (this.intlPart("literal" litHead))
                }
                def mType:string (itemAt types bestI)
                push out (this.intlPart(mType m2))
                def m2Len:int (this.cuLen(m2))
                rest = (this.cuSlice(rest (bestAt + m2Len) restLen))
            }
        }
        if ((this.cuLen(rest)) > 0) {
            push out (this.intlPart("literal" rest))
        }
        return out
    }


    ; The pieces of a formatted date, as (type, value).
    fn intlDateParts:[EvHandle] (loc:int which:int t:double hourWidth:int) {
        this.ensureLocaleTables()
        def out:[EvHandle]
        def dtl (new DateTime)
        def year:int ((dtl.yearFromTime(t)) + (itemAt localeNumInt ((loc * 5) + 4)))
        def month:int (dtl.monthFromTime(t))
        def day:int (dtl.dateFromTime(t))
        def wday:int (dtl.weekDay(t))
        def hour:int (dtl.hourFromTime(t))
        def minute:int (dtl.minFromTime(t))
        def second:int (dtl.secFromTime(t))
        def hour12:boolean ((itemAt localeNumInt ((loc * 5) + 3)) == 1)
        def p:int (this.intlPatternOffset(loc which))
        def cnt:int (itemAt localePatInt p)
        def i:int 0
        while (i < cnt) {
            def field:int (itemAt localePatInt ((p + 1) + (i * 3)))
            def litIdx:int (itemAt localePatInt ((p + 2) + (i * 3)))
            def width:int (itemAt localePatInt ((p + 3) + (i * 3)))
            if (field == 0) {
                def litS:string (itemAt localePatStr litIdx)
                push out (this.intlPart("literal" litS))
            }
            if (field == 1) {
                def yS:string (to_string year)
                push out (this.intlPart("year" yS))
            }
            if (field == 2) {
                if (width == 0) {
                    def mName:string (itemAt localeNames (((loc * 38) + month)))
                    push out (this.intlPart("month" mName))
                } {
                    def mNum:string (this.intlPadNum((month + 1) width))
                    push out (this.intlPart("month" mNum))
                }
            }
            if (field == 3) {
                def dNum:string (this.intlPadNum(day width))
                push out (this.intlPart("day" dNum))
            }
            if (field == 4) {
                def wName:string (itemAt localeNames ((((loc * 38) + 24) + wday)))
                push out (this.intlPart("weekday" wName))
            }
            if (field == 5) {
                def h:int hour
                if hour12 {
                    h = (h - (12 * (this.intDiv(h 12))))
                    if (h == 0) { h = 12 }
                }
                def hw:int width
                if (hourWidth > 0) { hw = hourWidth }
                def hNum:string (this.intlPadNum(h hw))
                push out (this.intlPart("hour" hNum))
            }
            if (field == 6) {
                def miNum:string (this.intlPadNum(minute width))
                push out (this.intlPart("minute" miNum))
            }
            if (field == 7) {
                def seNum:string (this.intlPadNum(second width))
                push out (this.intlPart("second" seNum))
            }
            if (field == 8) {
                def dpOff:int ((loc * 22) + 20)
                def dpS:string (itemAt localeNumStr dpOff)
                if (hour < 12) { } { dpS = (itemAt localeNumStr (dpOff + 1)) }
                push out (this.intlPart("dayPeriod" dpS))
            }
            i = (i + 1)
        }
        return out
    }

    ; Parts joined back into the string, so format() and formatToParts() are one
    ; implementation and cannot drift apart.
    fn intlJoinParts:string (parts:[EvHandle]) {
        def s:string ""
        def i:int 0
        while (i < (array_length parts)) {
            def pv:EvHandle ((itemAt parts i).getMember("value"))
            s = (s + (pv.stringOf()))
            i = (i + 1)
        }
        return s
    }

    ; formatRange: the two ends formatted and joined by the locale's range
    ; separator. When both ends format identically the spec answers the single
    ; value with an `approximatelySign`; this answers the single value, which is
    ; the part a caller uses.
    fn intlRangeParts:[EvHandle] (a:[EvHandle] b:[EvHandle]) {
        def out:[EvHandle]
        def sa:string (this.intlJoinParts(a))
        def sb:string (this.intlJoinParts(b))
        if (sa == sb) {
            def i0:int 0
            while (i0 < (array_length a)) {
                push out (itemAt a i0)
                i0 = (i0 + 1)
            }
            return out
        }
        def i:int 0
        while (i < (array_length a)) {
            push out (itemAt a i)
            i = (i + 1)
        }
        push out (this.intlPart("literal" "–"))
        def j:int 0
        while (j < (array_length b)) {
            push out (itemAt b j)
            j = (j + 1)
        }
        return out
    }


    ; ---- Intl.PluralRules / Intl.ListFormat ---------------------------------
    ; The plural CATEGORY of a number, as CLDR defines it for this locale. The
    ; rules themselves are expressions over the operands n, i, v, f and t;
    ; what is carried is the answer, keyed on enough of the operands to
    ; determine it. See LocalePlural.rgr.
    fn ensurePluralTables:void () {
        if pluralTablesLoaded { return }
        pluralTags = (LocalePlural.tags())
        pluralKeys = (LocalePlural.keyList())
        pluralEntries = (LocalePlural.entries())
        pluralPairs = (LocalePlural.pairs())
        listSeps = (LocalePlural.listSeparators())
        pluralTablesLoaded = true
    }

    fn pluralLocaleIndexOf:int (tag:string) {
        this.ensurePluralTables()
        if ((strlen tag) == 0) { return 0 }
        def want:string (this.unicodeCaseConvert(tag false))
        def n:int (array_length pluralTags)
        def i:int 0
        while (i < n) {
            if ((itemAt pluralTags i) == want) { return i }
            i = (i + 1)
        }
        def dash:int (indexOf want "-")
        if (dash > 0) {
            def short:string (this.cuSlice(want 0 dash))
            def j:int 0
            while (j < n) {
                if ((itemAt pluralTags j) == short) { return j }
                j = (j + 1)
            }
        }
        return 0
    }

    ; The lookup key for a number, in the shape the table was built with.
    fn pluralKeyOf:string (v:double) {
        def a:double v
        if (a < 0.0) { a = (0.0 - a) }
        def txt:string (this.toStringOf((EvValueBridge.taggedNumber(a))))
        def dot:int (indexOf txt ".")
        def intTxt:string txt
        def fracTxt:string ""
        if (dot >= 0) {
            def tl:int (this.cuLen(txt))
            intTxt = (this.cuSlice(txt 0 dot))
            fracTxt = (this.cuSlice(txt (dot + 1) tl))
        }
        ; An exponent form has no CLDR operands to speak of; treat it as a
        ; large integer, which is what every rule does with it.
        if ((indexOf txt "e") >= 0) {
            return "b|0|0|0"
        }
        def iv:int 0
        def ok@(optional):int (to_int intTxt)
        if ok { iv = (unwrap ok) }
        def vlen:int (this.cuLen(fracTxt))
        if (vlen == 0) {
            if (iv < 1001) {
                return ("s" + (to_string iv))
            }
            def big:int 0
            if (iv > 0) {
                if ((iv - ((this.intDiv(iv 1000000)) * 1000000)) == 0) { big = 1 }
            }
            def m100:int (iv - ((this.intDiv(iv 100)) * 100))
            def m10:int (iv - ((this.intDiv(iv 10)) * 10))
            return ((((("b|" + (to_string m100)) + "|") + (to_string m10)) + "|") + (to_string big))
        }
        def fv:int 0
        def fok@(optional):int (to_int fracTxt)
        if fok { fv = (unwrap fok) }
        def ic:int iv
        if (ic > 3) { ic = 3 }
        def vc:int vlen
        if (vc > 3) { vc = 3 }
        def fc:int fv
        if (fc > 3) { fc = 3 }
        return ((((("d|" + (to_string ic)) + "|") + (to_string vc)) + "|") + (to_string fc))
    }

    ; 0 zero, 1 one, 2 two, 3 few, 4 many, 5 other.
    fn pluralCategoryId:int (loc:int ordinal:boolean v:double) {
        this.ensurePluralTables()
        def slot:int (loc * 2)
        if ordinal { slot = (slot + 1) }
        def base:int (slot * 3)
        def off:int (itemAt pluralEntries base)
        def cnt:int (itemAt pluralEntries (base + 1))
        def fb:int (itemAt pluralEntries (base + 2))
        def key:string (this.pluralKeyOf(v))
        def j:int 0
        while (j < cnt) {
            def kid:int (itemAt pluralPairs ((off + j) * 2))
            if ((itemAt pluralKeys kid) == key) {
                return (itemAt pluralPairs (((off + j) * 2) + 1))
            }
            j = (j + 1)
        }
        return fb
    }

    fn pluralCategoryName:string (id:int) {
        if (id == 0) { return "zero" }
        if (id == 1) { return "one" }
        if (id == 2) { return "two" }
        if (id == 3) { return "few" }
        if (id == 4) { return "many" }
        return "other"
    }

    ; §13.4.3 ListFormat.format: two items take the PAIR separator, three or
    ; more take the middle one between the first items and the end one before
    ; the last. English joins two with " and " and three with ", " and ", and ".
    fn intlFormatList:[EvHandle] (loc:int disjunction:boolean items:[EvHandle]) {
        this.ensurePluralTables()
        def out:[EvHandle]
        def n:int (array_length items)
        def base:int ((loc * 6))
        if disjunction { base = (base + 3) }
        def pairSep:string (itemAt listSeps base)
        def midSep:string (itemAt listSeps (base + 1))
        def endSep:string (itemAt listSeps (base + 2))
        def i:int 0
        while (i < n) {
            if (i > 0) {
                def useEnd:boolean false
                if (i == (n - 1)) {
                    if (n > 2) { useEnd = true }
                }
                def sep:string ""
                if (n == 2) {
                    sep = (pairSep + "")
                } {
                    if useEnd { sep = (endSep + "") } { sep = (midSep + "") }
                }
                push out (this.intlPart("literal" sep))
            }
            def sv:string (this.toStringOf((itemAt items i)))
            push out (this.intlPart("element" sv))
            i = (i + 1)
        }
        return out
    }

    ; ---- the Intl objects ---------------------------------------------------
    ; Each instance is an ordinary object carrying its resolved settings in
    ; hidden slots; __intlkind__ is what makes builtinKindOf dispatch its
    ; methods to the right prototype.
    fn intlIsCtorName:boolean (name:string) {
        if (name == "Collator") { return true }
        if (name == "NumberFormat") { return true }
        if (name == "DateTimeFormat") { return true }
        if (name == "PluralRules") { return true }
        if (name == "ListFormat") { return true }
        return false
    }

    ; Read the option named `key` off an options object as a string, or "".
    fn intlStringOption:string (opts:EvHandle key:string) {
        if (false == (this.isDescriptorObject(opts))) { return "" }
        def v:EvHandle (this.getPropertyValue(opts key))
        if scriptThrew { return "" }
        if (v.isUndefined()) { return "" }
        return (this.toStringOf(v))
    }

    fn intlIntOption:int (opts:EvHandle key:string fallback:int) {
        if (false == (this.isDescriptorObject(opts))) { return fallback }
        def v:EvHandle (this.getPropertyValue(opts key))
        if scriptThrew { return fallback }
        if (v.isUndefined()) { return fallback }
        return (this.toIntegerOf(v))
    }

    fn intlBoolOption:boolean (opts:EvHandle key:string fallback:boolean) {
        if (false == (this.isDescriptorObject(opts))) { return fallback }
        def v:EvHandle (this.getPropertyValue(opts key))
        if scriptThrew { return fallback }
        if (v.isUndefined()) { return fallback }
        return (v.toBool())
    }

    ; new Intl.Collator / NumberFormat / DateTimeFormat.
    fn constructIntl:EvHandle (kind:string args:[EvHandle]) {
        this.ensureLocaleTables()
        def locV:EvHandle (EvValueBridge.taggedUndefined())
        def optV:EvHandle (EvValueBridge.taggedUndefined())
        if ((array_length args) > 0) { locV = (itemAt args 0) }
        if ((array_length args) > 1) { optV = (itemAt args 1) }
        def tag:string (this.intlFirstTag(locV))
        if scriptThrew { return (EvValueBridge.taggedUndefined()) }
        def idx:int (this.localeIndexOf(tag))
        def keys:[string]
        def vals:[EvHandle]
        def o:EvHandle (EvValueBridge.taggedObject(keys vals))
        o.setMember("__intlkind__" (EvValueBridge.taggedString(kind)))
        o.setMember("__intllocale__" (EvHandle.fromInt(idx)))
        ; The tailorings are keyed by tag, not by the data table, so a locale
        ; with a tailoring but no CLDR row still collates correctly.
        o.setMember("__intltag__" (EvValueBridge.taggedString(tag)))
        if (kind == "collator") {
            def sens:string (this.intlStringOption(optV "sensitivity"))
            if ((strlen sens) == 0) { sens = "variant" }
            o.setMember("__intlsens__" (EvValueBridge.taggedString(sens)))
            o.setMember("__intlnumeric__" (EvValueBridge.taggedBoolean((this.intlBoolOption(optV "numeric" false)))))
            o.setMember("__intlusage__" (EvValueBridge.taggedString("sort")))
        }
        if (kind == "numberformat") {
            def style:string (this.intlStringOption(optV "style"))
            if ((strlen style) == 0) { style = "decimal" }
            def cur:string (this.intlStringOption(optV "currency"))
            if (style == "currency") {
                if ((strlen cur) == 0) {
                    return (this.throwSpecError("TypeError" "Currency code is required with currency style."))
                }
                cur = (this.unicodeCaseConvert(cur true))
            }
            def defMax:int 3
            def defMin:int 0
            if (style == "currency") {
                defMax = 2
                defMin = 2
            }
            if (style == "percent") { defMax = 0 }
            def minF:int (this.intlIntOption(optV "minimumFractionDigits" defMin))
            def maxF:int (this.intlIntOption(optV "maximumFractionDigits" defMax))
            if (maxF < minF) { maxF = minF }
            o.setMember("__intlstyle__" (EvValueBridge.taggedString(style)))
            o.setMember("__intlcur__" (EvValueBridge.taggedString(cur)))
            o.setMember("__intlminf__" (EvHandle.fromInt(minF)))
            o.setMember("__intlmaxf__" (EvHandle.fromInt(maxF)))
            o.setMember("__intlmini__" (EvHandle.fromInt((this.intlIntOption(optV "minimumIntegerDigits" 1)))))
            o.setMember("__intlgroup__" (EvValueBridge.taggedBoolean((this.intlBoolOption(optV "useGrouping" true)))))
        }
        if (kind == "pluralrules") {
            def ptype:string (this.intlStringOption(optV "type"))
            if ((strlen ptype) == 0) { ptype = "cardinal" }
            o.setMember("__intlptype__" (EvValueBridge.taggedString(ptype)))
            o.setMember("__intlploc__" (EvHandle.fromInt((this.pluralLocaleIndexOf(tag)))))
        }
        if (kind == "listformat") {
            def ltype:string (this.intlStringOption(optV "type"))
            if ((strlen ltype) == 0) { ltype = "conjunction" }
            o.setMember("__intlltype__" (EvValueBridge.taggedString(ltype)))
            o.setMember("__intlploc__" (EvHandle.fromInt((this.pluralLocaleIndexOf(tag)))))
        }
        if (kind == "datetimeformat") {
            ; The five carried patterns, chosen by what the options ask for.
            ; dateStyle/timeStyle name them directly; the field options are
            ; mapped onto the nearest one.
            def which:int 0
            def dStyle:string (this.intlStringOption(optV "dateStyle"))
            def tStyle:string (this.intlStringOption(optV "timeStyle"))
            def month:string (this.intlStringOption(optV "month"))
            def weekday:string (this.intlStringOption(optV "weekday"))
            def hasTime:boolean false
            if ((strlen (this.intlStringOption(optV "hour"))) > 0) { hasTime = true }
            if ((strlen tStyle) > 0) { hasTime = true }
            def hasDate:boolean false
            if ((strlen (this.intlStringOption(optV "year"))) > 0) { hasDate = true }
            if ((strlen (this.intlStringOption(optV "day"))) > 0) { hasDate = true }
            if ((strlen month) > 0) { hasDate = true }
            if ((strlen weekday) > 0) { hasDate = true }
            if ((strlen dStyle) > 0) { hasDate = true }
            if (hasDate == false) {
                if (hasTime == false) { hasDate = true }
            }
            if hasDate {
                which = 0
                if (month == "long") { which = 1 }
                if (dStyle == "long") { which = 1 }
                if (dStyle == "medium") { which = 1 }
                if ((strlen weekday) > 0) { which = 2 }
                if (dStyle == "full") { which = 2 }
            } {
                which = 3
                if ((strlen (this.intlStringOption(optV "second"))) > 0) { which = 4 }
                if (tStyle == "medium") { which = 4 }
                if (tStyle == "long") { which = 4 }
            }
            o.setMember("__intlwhich__" (EvHandle.fromInt(which)))
            o.setMember("__intldate__" (EvValueBridge.taggedBoolean(hasDate)))
            ; An explicit hour:"2-digit" pads even where the locale's own time
            ; pattern does not -- en writes 3:04:05 PM by default and
            ; 03:04:05 PM when asked for two digits.
            def hourW:int 0
            if ((this.intlStringOption(optV "hour")) == "2-digit") { hourW = 2 }
            if (tStyle == "full") { hourW = 0 }
            o.setMember("__intlhourw__" (EvHandle.fromInt(hourW)))
        }
        o.setProto((this.builtinPrototype("Object")))
        return o
    }

    ; Compare through a Collator: the sensitivity option decides how many of the
    ; three levels count, which is what makes {sensitivity:'base'} an
    ; accent-and-case-insensitive comparison rather than a different algorithm.
    fn intlCollatorCompare:int (recv:EvHandle a:string b:string) {
        def tag:string ((recv.getOwnData("__intltag__")).stringOf())
        def sens:string ((recv.getOwnData("__intlsens__")).stringOf())
        def numeric:boolean ((recv.getOwnData("__intlnumeric__")).toBool())
        if numeric {
            ; {numeric:true} compares runs of digits by VALUE, so "item10"
            ; sorts after "item9" instead of before it.
            def nc:int (this.intlNumericCompare(a b))
            if (nc != 0) { return nc }
        }
        this.collSelectLocale(tag)
        def levels:int 3
        if (sens == "base") { levels = 1 }
        if (sens == "accent") { levels = 2 }
        if (sens == "case") { levels = 1 }
        def r:int (this.collateStringsLevels(a b levels))
        this.collSelectLocale("")
        return r
    }

    ; Digit runs compared by value, for {numeric:true}.
    fn intlNumericCompare:int (a:string b:string) {
        def ia:int 0
        def ib:int 0
        def na:int (this.cuLen(a))
        def nb:int (this.cuLen(b))
        while ((ia < na) && (ib < nb)) {
            def ca:int (this.cuUnitAt(a ia))
            def cb:int (this.cuUnitAt(b ib))
            def da:boolean ((ca >= 48) && (ca <= 57))
            def db:boolean ((cb >= 48) && (cb <= 57))
            if (da && db) {
                def va:int 0
                def goA:boolean true
                while (goA && (ia < na)) {
                    def x:int (this.cuUnitAt(a ia))
                    if ((x < 48) || (x > 57)) {
                        goA = false
                    } {
                        va = ((va * 10) + (x - 48))
                        ia = (ia + 1)
                    }
                }
                def vb:int 0
                def goB:boolean true
                while (goB && (ib < nb)) {
                    def y:int (this.cuUnitAt(b ib))
                    if ((y < 48) || (y > 57)) {
                        goB = false
                    } {
                        vb = ((vb * 10) + (y - 48))
                        ib = (ib + 1)
                    }
                }
                if (va < vb) { return (0 - 1) }
                if (va > vb) { return 1 }
                return 0
            }
            if (ca != cb) { return 0 }
            ia = (ia + 1)
            ib = (ib + 1)
        }
        return 0
    }

    ; ==========================================================================
    ; D-UTF8: the code-UNIT layer.
    ; --------------------------------------------------------------------------
    ; A JS string is a sequence of UTF-16 code units. The es6 target stores
    ; exactly that; the native targets store UTF-8 BYTES. Those two views used
    ; to be mixed together on the native side: `length`, `charCodeAt`,
    ; `indexOf` and `split("")` counted BYTES while `charAt`, `s[i]`, `slice`
    ; and `substring` counted CODE POINTS -- so `"aeb".length` and
    ; `"aeb".charAt(1)` disagreed about what an index meant, and
    ; `s.charAt(s.length - 1)` answered "" for any string holding a non-ASCII
    ; character. Every JS-visible string operation now goes through the
    ; functions below, which answer in code units on every target.
    ;
    ; On a char-model target they are straight passthroughs, and on a
    ; byte-model target the ASCII case -- almost every string -- is too.
    ; --------------------------------------------------------------------------

    ; Which model this target uses, decided once. There are THREE, not two,
    ; and taking Rust for the es6 model is what made "日本".length answer 1
    ; there: `strlen` counts characters, so it is not a byte model, but a
    ; supplementary character is ONE character where JS counts a surrogate
    ; PAIR, so it is not the unit model either.
    ;
    ;   0  UTF-16 code units   es6    strlen/charAt/substring all in units
    ;   1  UTF-8 bytes         C++    strlen/charAt in bytes
    ;   2  code points         Rust   strlen/charAt/substring in characters
    ;
    ; Two probes separate them: a two-byte character tells bytes from the rest,
    ; and a supplementary one tells code points from units.
    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn strModelKind:int () {
        return (RgText.kind())
    }

    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn unitsAreBytes:boolean () {
        return (RgText.unitsAreBytes())
    }

    ; True where `strlen`/`charAt`/`substring` index whole characters, so the
    ; only thing standing between the target and UTF-16 is that a
    ; supplementary character has to be spelled as two units.
    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn unitsArePoints:boolean () {
        return (RgText.unitsArePoints())
    }

    ; The UTF-8 width of a code point, which is how a code-point-model target
    ; converts its own indexes into the BYTE offsets a native string search
    ; reports back.
    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn utf8WidthOf:int (cp:int) {
        return (RgText.utf8WidthOf(cp))
    }

    ; Bytes [i, j) of a string, on a byte-model target. `substring` cannot do
    ; this: it indexes code POINTS.
    ; One character's worth of text starting at byte `i`, `w` units wide. On a
    ; char-model target `w` is always 1 and this is a plain substring.
    fn byteSliceOrUnit:string (s:string i:int w:int) {
        if (this.unitsAreBytes()) {
            return (this.byteSlice(s i (i + w)))
        }
        return (substring s i (i + w))
    }

    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn byteSlice:string (s:string i:int j:int) {
        return (RgText.byteSlice(s i j))
    }

    ; The code POINT whose encoding starts at byte `i`, and its width in bytes.
    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn cuDecodeAt:[int] (s:string i:int) {
        return (RgText.decodeAt(s i))
    }

    ; Code units in `s`.
    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn cuLen:int (s:string) {
        return (RgText.len(s))
    }

    ; The code UNIT at index `u`: the character for anything in the BMP, and
    ; the high or low surrogate for an astral one. -1 past the end.
    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn cuUnitAt:int (s:string u:int) {
        return (RgText.unitAt(s u))
    }

    ; The substring between two code-unit indexes. A cut that lands INSIDE a
    ; surrogate pair yields the corresponding lone surrogate, which is what
    ; keeps `s.slice(0, 1)` on an astral character one unit long rather than
    ; silently the whole character.
    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn cuSlice:string (s:string a:int b:int) {
        return (RgText.substr(s a b))
    }

    ; A code point as its UTF-8 bytes, on a byte-model target; as itself on a
    ; char-model one. Lone surrogates encode too -- they are not characters,
    ; but they are code units a JS string may hold.
    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn encodeCodePointUtf8:string (cp:int) {
        return (RgText.encodeUtf8(cp))
    }

    ; Byte offset of code UNIT `u` (the byte length when u is past the end).
    ; The low half of a surrogate pair maps to the same offset as the high one,
    ; which only matters to cuSlice -- it is the one that splits pairs.
    ; NOT delegated. RgText.utf8ByteOfUnit is a DIFFERENT function despite the
    ; resemblance: it answers a UTF-8 byte offset on every target, while this
    ; answers "the offset this target's own string search reports", which is
    ; code units on es6 and bytes elsewhere. The engine wants the target-relative
    ; one, because it hands the result to native indexOf. Both are correct; only
    ; one belongs in a portable library. See lib/core/README.md.
    fn cuByteOf:int (s:string u:int) {
        def n:int (strlen s)
        if (u <= 0) { return 0 }
        ; The code-point target indexes its own strings by character, but its
        ; native string SEARCH answers in bytes -- so this bridge is needed
        ; there too. Reading it as a plain passthrough is what made
        ; `'a日b'.indexOf('b')` answer 4.
        if (this.unitsArePoints()) {
            def p:int 0
            def units:int 0
            def bytes:int 0
            while (p < n) {
                if (units >= u) { return bytes }
                def cp:int (charAt s p)
                if (cp > 65535) { units = (units + 2) } { units = (units + 1) }
                bytes = (bytes + (this.utf8WidthOf(cp)))
                p = (p + 1)
            }
            return bytes
        }
        if (false == (this.unitsAreBytes())) {
            if (u > n) { return n }
            return u
        }
        def i:int 0
        def units:int 0
        while (i < n) {
            if (units >= u) {
                return i
            }
            def dec:[int] (this.cuDecodeAt(s i))
            def cp:int (itemAt dec 0)
            def w:int (itemAt dec 1)
            if (w == 0) { return n }
            if (cp < 65536) {
                units = (units + 1)
            } {
                units = (units + 2)
            }
            i = (i + w)
        }
        return n
    }

    ; The code-unit index that corresponds to a BYTE index -- what a search
    ; that ran over the raw bytes has to report back.
    ; NOT delegated, for the same reason as cuByteOf above: the engine needs the
    ; target-relative inverse, RgText.unitOfUtf8Byte is the UTF-8 one.
    fn cuIndexOfByte:int (s:string byteIdx:int) {
        if (this.unitsArePoints()) {
            if (byteIdx <= 0) { return byteIdx }
            def n:int (strlen s)
            def p:int 0
            def units:int 0
            def bytes:int 0
            while (p < n) {
                if (bytes >= byteIdx) { return units }
                def cp:int (charAt s p)
                if (cp > 65535) { units = (units + 2) } { units = (units + 1) }
                bytes = (bytes + (this.utf8WidthOf(cp)))
                p = (p + 1)
            }
            return units
        }
        if (false == (this.unitsAreBytes())) {
            return byteIdx
        }
        if (byteIdx <= 0) { return byteIdx }
        def i:int 0
        def units:int 0
        while (i < byteIdx) {
            def dec:[int] (this.cuDecodeAt(s i))
            def cp:int (itemAt dec 0)
            def w:int (itemAt dec 1)
            if (w == 0) { return units }
            if (cp < 65536) {
                units = (units + 1)
            } {
                units = (units + 2)
            }
            i = (i + w)
        }
        return units
    }

    fn escapeString:string (s:string) {
        def out:string ""
        def i:int 0
        while (i < (strlen s)) {
            def c:int (bit_and (charAt s i) 65535)
            def keep:boolean false
            if ((c >= 65) && (c <= 90)) { keep = true }
            if ((c >= 97) && (c <= 122)) { keep = true }
            if ((c >= 48) && (c <= 57)) { keep = true }
            if (c == 64) { keep = true }
            if (c == 42) { keep = true }
            if (c == 95) { keep = true }
            if (c == 43) { keep = true }
            if (c == 45) { keep = true }
            if (c == 46) { keep = true }
            if (c == 47) { keep = true }
            if keep {
                out = (out + (strfromcode c))
            } {
                if (c < 256) {
                    out = (out + ("%" + (this.hexPad(c 2))))
                } {
                    out = (out + ("%u" + (this.hexPad(c 4))))
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; annexB B.2.1.2: unescape. A `%` that does not begin a well-formed escape
    ; stands for itself -- `unescape("a%2")` is "a%2", not an error and not a
    ; dropped character.
    fn unescapeString:string (s:string) {
        def out:string ""
        def n:int (strlen s)
        def i:int 0
        while (i < n) {
            def c:int (bit_and (charAt s i) 65535)
            def consumed:int 1
            if (c == 37) {
                if ((i + 5) < n) {
                    if ((bit_and (charAt s (i + 1)) 65535) == 117) {
                        def h4:int (this.hexValueOf(s (i + 2) 4))
                        if (h4 >= 0) {
                            out = (out + (strfromcode h4))
                            consumed = 6
                        }
                    }
                }
                if (consumed == 1) {
                    if ((i + 2) < n) {
                        def h2:int (this.hexValueOf(s (i + 1) 2))
                        if (h2 >= 0) {
                            out = (out + (strfromcode h2))
                            consumed = 3
                        }
                    }
                }
            }
            if (consumed == 1) {
                out = (out + (strfromcode c))
            }
            i = (i + consumed)
        }
        return out
    }

    ; `count` hex digits starting at `at`, or -1 when any of them is not one.
    fn hexValueOf:int (s:string at:int count:int) {
        def acc:int 0
        def k:int 0
        while (k < count) {
            def d:int (bit_and (charAt s (at + k)) 65535)
            def v:int (0 - 1)
            if ((d >= 48) && (d <= 57)) { v = (d - 48) }
            if ((d >= 65) && (d <= 70)) { v = ((d - 65) + 10) }
            if ((d >= 97) && (d <= 102)) { v = ((d - 97) + 10) }
            if (v < 0) {
                return (0 - 1)
            }
            acc = ((acc * 16) + v)
            k = (k + 1)
        }
        return acc
    }

    ; Uppercase hex, zero-padded to `width`.
    fn hexPadLower:string (value:int width:int) {
        def digits:string "0123456789abcdef"
        def out:string ""
        def v:int value
        def k:int 0
        while (k < width) {
            def d:int (bit_and v 15)
            out = ((substring digits d (d + 1)) + out)
            v = (bit_shr v 4)
            k = (k + 1)
        }
        return out
    }

    fn hexPad:string (value:int width:int) {
        def digits:string "0123456789ABCDEF"
        def out:string ""
        def v:int value
        def k:int 0
        while (k < width) {
            def d:int (bit_and v 15)
            out = ((substring digits d (d + 1)) + out)
            v = (bit_shr v 4)
            k = (k + 1)
        }
        return out
    }

    fn ensureSymbolGlobal:void () {
        def existing:EvHandle (hostScope.lookup("Symbol"))
        if (existing.isFunction()) {
            return
        }
        def sym:EvHandle (EvValueBridge.taggedNativeFunction("Symbol"))
        sym.setMember("name" (EvValueBridge.taggedString("Symbol")))
        def wk:[string]
        push wk "iterator"
        push wk "asyncIterator"
        push wk "hasInstance"
        push wk "toPrimitive"
        push wk "toStringTag"
        push wk "species"
        push wk "isConcatSpreadable"
        push wk "unscopables"
        push wk "match"
        push wk "replace"
        push wk "search"
        push wk "split"
        def i:int 0
        while (i < (array_length wk)) {
            def nm:string (itemAt wk i)
            def keysS:[string]
            def valsS:[EvHandle]
            def s:EvHandle (EvValueBridge.taggedObject(keysS valsS))
            s.setMember("__symbol__" (EvValueBridge.taggedString(("Symbol." + nm))))
            ; A well-known symbol's key is fixed rather than sequenced, so the
            ; same one is reached however the realm was warmed up.
            s.setMember("__symid__" (EvValueBridge.taggedString(("@@" + nm))))
            set symbolById ("@@" + nm) s
            s.setMember("description" (EvValueBridge.taggedString(("Symbol." + nm))))
            sym.setMember(nm s)
            sym.setAttrs(nm false false false)
            i = (i + 1)
        }
        ; Symbol.for / Symbol.keyFor, as ordinary static values so they are
        ; detachable like every other built-in static.
        def sfns:[string]
        push sfns "for"
        push sfns "keyFor"
        def sj:int 0
        while (sj < (array_length sfns)) {
            def sfn:string (itemAt sfns sj)
            def sv:EvHandle (EvValueBridge.taggedNativeStatic("Symbol" sfn))
            sv.setMember("name" (EvValueBridge.taggedString(sfn)))
            sv.setAttrs("name" false false true)
            sv.setMember("length" (EvHandle.fromInt(1)))
            sv.setAttrs("length" false false true)
            sym.setMember(sfn sv)
            sym.setAttrs(sfn true false true)
            sj = (sj + 1)
        }
        hostScope.define("Symbol" sym)
        ; D-EVAL: eval is seeded as a real function value so `typeof eval` is
        ; "function". Calls are intercepted by name before reaching this value,
        ; which is what keeps it DIRECT eval (running in the caller's scope)
        ; rather than an ordinary function call with its own frame.
        def ev:EvHandle (EvValueBridge.taggedNativeFunction("eval"))
        ev.setMember("name" (EvValueBridge.taggedString("eval")))
        hostScope.define("eval" ev)
    }

    fn ensureErrorCtors:void () {
        if errorCtorsReady {
            return
        }
        errorCtorsReady = true
        this.ensureSymbolGlobal()
        def names:[string] (this.errorKindNames())
        def i:int 0
        while (i < (array_length names)) {
            def nm:string (itemAt names i)
            def c:EvHandle (EvValueBridge.taggedNativeFunction(nm))
            c.setMember("name" (EvValueBridge.taggedString(nm)))
            ; §17: a built-in function's `name` is non-writable and
            ; non-enumerable, like its `length` just below. It was seeded as an
            ; ordinary writable, enumerable property.
            c.setAttrs("name" false false true)
            ; §15.11.3: every native error constructor takes one argument.
            c.setMember("length" (EvHandle.fromInt(1)))
            c.setAttrs("length" false false true)
            c.setMember("__errorctor__" (EvValueBridge.taggedString(nm)))
            ; D-ERRORS: an error constructor has a real `prototype`, chained the
            ; way the spec chains them -- TypeError.prototype inherits from
            ; Error.prototype, which inherits from Object.prototype. Without it
            ; a property put on Error.prototype was invisible to every error,
            ; and `Object.getPrototypeOf(new Error())` answered Object.prototype.
            def keysE:[string]
            def valsE:[EvHandle]
            def proto:EvHandle (EvValueBridge.taggedObject(keysE valsE))
            proto.setMember("name" (EvValueBridge.taggedString(nm)))
            proto.setAttrs("name" true false true)
            proto.setMember("message" (EvValueBridge.taggedString("")))
            proto.setAttrs("message" true false true)
            proto.setMember("constructor" c)
            proto.setAttrs("constructor" true false true)
            if (nm == "Error") {
                proto.setProto((this.builtinPrototype("Object")))
                ; Error itself is an ordinary function object.
                c.setProto((this.builtinPrototype("Function")))
            } {
                proto.setProto((this.errorPrototypeFor("Error")))
                ; A native error SUBCLASS constructor inherits from Error, which
                ; is what `Object.getPrototypeOf(TypeError) === Error` asserts.
                c.setProto((hostScope.lookup("Error")))
            }
            ; Error.prototype.toString is an own property of the prototype, so it
            ; has a descriptor -- writable and configurable, never enumerable.
            proto.setMember("toString" (this.sharedNativeMethod("error" "toString")))
            proto.setAttrs("toString" true false true)
            set builtinProtos nm proto
            c.setMember("prototype" proto)
            c.setAttrs("prototype" false false false)
            hostScope.define(nm c)
            i = (i + 1)
        }
    }

    ; The prototype object for an error kind, created by ensureErrorCtors.
    fn errorPrototypeFor:EvHandle (kind:string) {
        this.ensureErrorCtors()
        def found@(optional):EvHandle (get builtinProtos kind)
        if (!null? found) {
            return (unwrap found)
        }
        return (this.builtinPrototype("Object"))
    }

    ; The constructor function value for a kind ("TypeError"), or null when the
    ; name is not an error constructor.
    fn errorCtorFor:EvHandle (kind:string) {
        this.ensureErrorCtors()
        return (hostScope.lookup(kind))
    }

    ; Build an error object: { name, message, constructor } plus a marker the
    ; engine uses to recognise it. `constructor` is the shared singleton.
    fn makeError:EvHandle (kind:string message:string) {
        def keys0:[string]
        def vals0:[EvHandle]
        def e:EvHandle (EvValueBridge.taggedObject(keys0 vals0))
        e.setMember("name" (EvValueBridge.taggedString(kind)))
        e.setMember("message" (EvValueBridge.taggedString(message)))
        ; §20.5.8.1: `message` and `name` are writable and configurable but NOT
        ; enumerable. Left enumerable, `Object.keys(err)` listed them and
        ; `JSON.stringify(err)` produced a populated object where every engine
        ; answers `{}` -- which application logging notices at once.
        e.setAttrs("name" true false true)
        e.setAttrs("message" true false true)
        e.setMember("__error__" (EvValueBridge.taggedString(kind)))
        def ctor:EvHandle (this.errorCtorFor(kind))
        if (ctor.isFunction()) {
            e.setMember("constructor" ctor)
            e.setAttrs("constructor" true false true)
        }
        e.setProto((this.errorPrototypeFor(kind)))
        return e
    }

    ; ==========================================================================
    ; D-BIGINT: the value, and the two conversions either side of it.
    ; --------------------------------------------------------------------------
    ; A BigInt is an OBJECT with its limbs and its sign in own slots, which is
    ; how symbols are carried too. The alternative -- a new case in the tagged
    ; value -- reaches into every match in EvHandle on three targets; this
    ; reaches into `typeof`, the operators and the conversions, which is where
    ; the behaviour actually differs anyway.
    ;
    ; The limbs are stored rather than a decimal string: rebuilding from limbs
    ; is a copy, rebuilding from decimal is a parse with a multiply per digit,
    ; and every operator rebuilds both operands.
    ; ==========================================================================
    fn makeBigIntValue:EvHandle (b:BigNum) {
        def keysB:[string]
        def valsB:[EvHandle]
        def v:EvHandle (EvValueBridge.taggedObject(keysB valsB))
        def limbs:[EvHandle]
        def i:int 0
        while (i < (array_length b.mag)) {
            push limbs (EvHandle.fromInt((itemAt b.mag i)))
            i = (i + 1)
        }
        v.setMember("__biglimbs__" (EvValueBridge.taggedArray(limbs)))
        v.setAttrs("__biglimbs__" false false false)
        v.setMember("__bigneg__" (EvValueBridge.taggedBoolean(b.neg)))
        v.setAttrs("__bigneg__" false false false)
        v.setProto((this.builtinPrototype("BigInt")))
        return v
    }

    fn isBigIntValue:boolean (v:EvHandle) {
        if (false == (v.isObject())) { return false }
        return (v.hasOwnData("__biglimbs__"))
    }

    fn bigNumOf:BigNum (v:EvHandle) {
        def b (new BigNum)
        if (false == (this.isBigIntValue(v))) { return b }
        def limbs:EvHandle (v.getOwnData("__biglimbs__"))
        def i:int 0
        while (i < (limbs.denseLen())) {
            push b.mag (this.toIntegerOf((limbs.arrayItemAt(i))))
            i = (i + 1)
        }
        b.neg = ((v.getOwnData("__bigneg__")).toBool())
        return b
    }

    fn bigFromIntValue:EvHandle (n:int) {
        return (this.makeBigIntValue((BigNum.fromInt(n))))
    }

    ; §7.1.13 ToBigInt. A number must be an INTEGER -- 1.5 is a RangeError, not
    ; a truncation -- and a string parses as a BigInt literal, where a bad one
    ; is a SyntaxError rather than NaN.
    fn toBigIntOf:EvHandle (v:EvHandle) {
        if (this.isBigIntValue(v)) { return v }
        if (v.isBoolean()) {
            if (v.toBool()) { return (this.bigFromIntValue(1)) }
            return (this.bigFromIntValue(0))
        }
        if (v.isNumber()) {
            def d:double (v.toNumber())
            if (d != d) {
                return (this.throwSpecError("RangeError" "The number NaN cannot be converted to a BigInt because it is not an integer"))
            }
            if (false == (this.isFiniteNum(d))) {
                return (this.throwSpecError("RangeError" "The number Infinity cannot be converted to a BigInt because it is not an integer"))
            }
            if (d != (this.truncNum(d))) {
                return (this.throwSpecError("RangeError" "The number is not a safe integer and cannot be converted to a BigInt"))
            }
            return (this.makeBigIntValue((BigNum.fromDouble(d))))
        }
        if (v.isString()) {
            def okBox:[boolean]
            push okBox false
            def parsed:BigNum (BigNum.parse((v.stringOf()) okBox))
            if (false == (itemAt okBox 0)) {
                return (this.throwSpecError("SyntaxError" "Cannot convert string to a BigInt"))
            }
            return (this.makeBigIntValue(parsed))
        }
        if ((v.isUndefined()) || (v.isNull())) {
            return (this.throwSpecError("TypeError" "Cannot convert undefined or null to a BigInt"))
        }
        if (this.isDescriptorObject(v)) {
            def prim:EvHandle (this.toPrimitive(v false))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            if (this.isBigIntValue(prim)) { return prim }
            return (this.toBigIntOf(prim))
        }
        return (this.throwSpecError("TypeError" "Cannot convert this value to a BigInt"))
    }

    ; §20.5.8.1 InstallErrorCause. Non-enumerable, writable and configurable --
    ; the same shape `message` has, so an error with a cause still serialises
    ; and enumerates like one without.
    fn installErrorCause:void (err:EvHandle options:EvHandle) {
        if (false == (this.isDescriptorObject(options))) { return }
        if (false == (this.objHasKeyUpChain(options "cause"))) { return }
        def causeV:EvHandle (this.getPropertyValue(options "cause"))
        if scriptThrew { return }
        err.setMember("cause" causeV)
        err.setAttrs("cause" true false true)
    }

    ; §20.5.7.1: AggregateError carries the errors it aggregates as an own
    ; `errors` property -- writable, non-enumerable, configurable, and a COPY,
    ; so mutating the array afterwards does not reach into the error.
    fn makeAggregateError:EvHandle (errs:[EvHandle] message:string) {
        def e:EvHandle (this.makeError("AggregateError" message))
        e.setMember("errors" (EvValueBridge.taggedArray(errs)))
        e.setAttrs("errors" true false true)
        return e
    }

    ; Raise a spec error. Sets the same unwind flags a guest `throw` sets, so a
    ; try/catch around the offending code catches it exactly like any other throw.
    fn throwSpecError:EvHandle (kind:string message:string) {
        scriptThrowValue = (this.makeError(kind message))
        scriptThrew = true
        return (EvValueBridge.taggedUndefined())
    }

    ; Names the engine resolves structurally rather than through a binding
    ; (Math.PI, JSON.stringify, Object.keys …). Reading one of these bare must
    ; not be a ReferenceError even though no binding exists for it.
    fn isEngineGlobalName:boolean (name:string) {
        if (this.isTypedArrayCtorName(name)) { return true }
        if (name == "ArrayBuffer") { return true }
        if (name == "SharedArrayBuffer") { return true }
        if (name == "Atomics") { return true }
        if (name == "DataView") { return true }
        if (name == "Function") { return true }
        if (name == "Map") { return true }
        if (name == "Set") { return true }
        if (name == "Iterator") { return true }
        if (name == "BigInt") { return true }
        if (this.isWeakCtorName(name)) { return true }
        if (name == "Symbol") { return true }
        if (name == "Math") { return true }
        if (name == "JSON") { return true }
        if (name == "Reflect") { return true }
        if (name == "Intl") { return true }
        if (name == "Promise") { return true }
        if (name == "Proxy") { return true }
        if (name == "Object") { return true }
        if (name == "Array") { return true }
        if (name == "String") { return true }
        if (name == "Number") { return true }
        if (name == "Boolean") { return true }
        if (name == "Date") { return true }
        if (name == "RegExp") { return true }
        if (name == "console") { return true }
        if (name == "performance") { return true }
        if (name == "globalThis") { return true }
        if (name == "NaN") { return true }
        if (name == "Infinity") { return true }
        if (name == "undefined") { return true }
        if (name == "arguments") { return true }
        return false
    }

    ; Read an identifier as a *reference*: an unresolvable name is a
    ; ReferenceError, not a silent null. `typeof x` does not come through here
    ; (it uses bindingExists), which is what the spec requires.
    ; D-GLOBALTHIS: created on first use so identity is stable.
    fn seedGlobalConstants:void (g:EvHandle) {
        ; The value properties of the global object. `this.NaN` read undefined
        ; because they lived only as names the resolver knew about.
        if (false == (g.hasOwnData("NaN"))) {
            g.setMember("NaN" (EvValueBridge.taggedNumber((0.0 / 0.0))))
            g.setAttrs("NaN" false false false)
            g.setMember("Infinity" (EvValueBridge.taggedNumber((1.0 / 0.0))))
            g.setAttrs("Infinity" false false false)
            g.setMember("undefined" (EvValueBridge.taggedUndefined()))
            g.setAttrs("undefined" false false false)
            ; The global FUNCTION properties. They are resolved by name at the
            ; call site, so `typeof this.parseInt` read undefined even though
            ; `parseInt(...)` worked.
            def gfns:[string]
            push gfns "eval"
            push gfns "parseInt"
            push gfns "parseFloat"
            push gfns "isNaN"
            push gfns "isFinite"
            push gfns "decodeURI"
            push gfns "decodeURIComponent"
            push gfns "encodeURI"
            push gfns "encodeURIComponent"
            ; annexB B.2.1: legacy, but still global function properties that
            ; `typeof escape` and getOwnPropertyNames both have to see.
            push gfns "escape"
            push gfns "unescape"
            def gi:int 0
            while (gi < (array_length gfns)) {
                def gn:string (itemAt gfns gi)
                def gf:EvHandle (EvValueBridge.taggedNativeFunction(gn))
                gf.setMember("name" (EvValueBridge.taggedString(gn)))
                gf.setAttrs("name" false false true)
                gf.setMember("length" (EvHandle.fromInt(1)))
                gf.setAttrs("length" false false true)
                g.setMember(gn gf)
                g.setAttrs(gn true false true)
                gi = (gi + 1)
            }
            ; The constructor and namespace globals, as the same objects the
            ; bare names resolve to.
            def gnames:[string]
            push gnames "Object"
            push gnames "Array"
            push gnames "String"
            push gnames "Number"
            push gnames "Boolean"
            push gnames "Function"
            push gnames "Date"
            push gnames "RegExp"
            push gnames "Math"
            push gnames "JSON"
            push gnames "Reflect"
            push gnames "Intl"
            push gnames "Promise"
            push gnames "Proxy"
            push gnames "ArrayBuffer"
            push gnames "SharedArrayBuffer"
            push gnames "Atomics"
            push gnames "DataView"
            push gnames "Iterator"
            push gnames "BigInt"
            push gnames "WeakMap"
            push gnames "WeakSet"
            push gnames "WeakRef"
            push gnames "FinalizationRegistry"
            push gnames "performance"
            ; The error constructors are globals too -- getOwnPropertyNames on
            ; the global object is expected to list every one of them.
            def enames:[string] (this.errorKindNames())
            def ei:int 0
            while (ei < (array_length enames)) {
                push gnames (itemAt enames ei)
                ei = (ei + 1)
            }
            def gj:int 0
            while (gj < (array_length gnames)) {
                def gnm:string (itemAt gnames gj)
                g.setMember(gnm (this.builtinGlobalObject(gnm)))
                g.setAttrs(gnm true false true)
                gj = (gj + 1)
            }
        }
    }

    fn theGlobalObject:EvHandle () {
        if globalObject {
            def existing:EvHandle (unwrap globalObject)
            this.seedGlobalConstants(existing)
            return existing
        }
        def keysG:[string]
        def valsG:[EvHandle]
        def g:EvHandle (EvValueBridge.taggedObject(keysG valsG))
        globalObject = g
        this.seedGlobalConstants(g)
        return g
    }

    fn lookupIdentifier:EvHandle (name:string) {
        ; PERF: the three special names gate on LENGTH first — this runs for
        ; every identifier read, and `s == "literal"` pays strlen(literal)
        ; per compare on the C++ target
        def nlen:int (strlen name)
        if ((nlen == 9) && (name == "undefined")) {
            return (EvValueBridge.taggedUndefined())
        }
        ; D-WITH: a name the with object serves through a GETTER. EvalContext
        ; cannot call it -- it has no evaluator -- so the read happens here.
        def wg:EvHandle (this.withHostFor(name))
        if (wg.isObject()) {
            if (wg.hasOwnGetter(name)) {
                def wgFn:EvHandle (wg.findGetter(name 0))
                if (wgFn.isFunction()) {
                    def wgArgs:[EvHandle]
                    return (this.callFnValueWithValues((wgFn.withThisForCall(wg)) wgArgs))
                }
            }
            if (wg.hasOwnData(name)) {
                return (wg.getOwnData(name))
            }
            return (EvValueBridge.taggedUndefined())
        }
        ; D-IEEE: Infinity and NaN are VALUES, not merely names the engine knows
        ; about. They were resolving to undefined, so `x === -Infinity` compared
        ; against NaN and was false for every x — a comparison that silently
        ; never held.
        if ((nlen == 8) && (name == "Infinity")) {
            return (EvValueBridge.taggedNumber((1.0 / 0.0)))
        }
        if ((nlen == 3) && (name == "NaN")) {
            return (EvValueBridge.taggedNumber((0.0 / 0.0)))
        }
        def ctxHit@(optional):EvHandle (context.tryLookup(name))
        if ctxHit {
            def ctxVal:EvHandle (unwrap ctxHit)
            ; D-TDZ: the binding exists but has not been initialised yet.
            if (ctxVal.isHole()) {
                return (this.tdzError(name))
            }
            return ctxVal
        }
        this.ensureErrorCtors()
        def hostHit@(optional):EvHandle (hostScope.tryLookup(name))
        if hostHit {
            return (unwrap hostHit)
        }
        ; D-GLOBALOBJ: the built-in namespaces are real OBJECTS, not merely names
        ; the engine recognises structurally. They resolved to undefined, so
        ; `Math.value = 1` silently vanished, passing Math where an object is
        ; expected was a TypeError, and every `X.prototype` read off one of them
        ; failed — the largest failure bucket in ES5 was reading a property of
        ; undefined. Calls like Math.floor(x) still dispatch structurally before
        ; reaching here, so this adds reachability without changing dispatch.
        ; D-GLOBALTHIS: `globalThis` IS the global object, not a namespace of its
        ; own. Two different objects answered to `this` and to `globalThis`, so
        ; `this === globalThis` was false at the top level of every script.
        if (name == "globalThis") {
            return (this.theGlobalObject())
        }
        if (this.isEngineGlobalName(name)) {
            def g:EvHandle (this.builtinGlobalObject(name))
            if (g.isObject()) {
                return g
            }
            if (g.isFunction()) {
                return g
            }
            return (EvValueBridge.taggedUndefined())
        }
        ; D-GLOBALTHIS: a bare name may have been created as a property of the
        ; global object (`this.p1 = 1` at top level), which is a global binding.
        def gObj:EvHandle (this.theGlobalObject())
        if (gObj.hasOwnData(name)) {
            return (gObj.getOwnData(name))
        }
        ; D-CLASSREF: a class is registered in the class table, not bound in a
        ; scope, so its bare name resolved to nothing — and once unresolved names
        ; began throwing, `A.staticMethod()` failed on the receiver before the
        ; call was even attempted. A class name resolves to a value carrying the
        ; class name so it is both referenceable and dispatchable.
        def clsRef:TSNode (this.classNodeByName(name))
        if ((this.nodeKindOf(clsRef)) == 25) {
            return (this.classValueFor(name))
        }
        if strictReferences {
            return (this.throwSpecError("ReferenceError" (name + " is not defined")))
        }
        return (EvValueBridge.taggedNull())
    }

    fn typeofTag:string (val:EvHandle) {
        if (val.isUndefined()) {
            return "undefined"
        }
        ; D-PROXY: a proxy answers `typeof` as its TARGET does, so a proxy
        ; wrapping a function is "function".
        if (this.isProxyValue(val)) {
            return (this.typeofTag((this.proxyTargetOf(val))))
        }
        if (val.isNull()) {
            return "object"
        }
        if (val.isNumber()) {
            return "number"
        }
        if (val.isString()) {
            return "string"
        }
        if (val.isBoolean()) {
            return "boolean"
        }
        if (val.isFunction()) {
            return "function"
        }
        if (val.isArrayValue()) {
            return "object"
        }
        if (val.isObject()) {
            ; D-SYMBOL: symbols are modelled as objects internally, but `typeof`
            ; must answer "symbol" — that is how guest code tells them apart, and
            ; answering "object" would make every symbol type-check wrong.
            def symTag@(optional):EvHandle (val.tryOwnData("__symbol__"))
            if symTag {
                return "symbol"
            }
            ; D-BIGINT: a BigInt is carried as an object here for the same
            ; reason a symbol is -- there is no room for one in a tagged value
            ; -- and `typeof` has to say so, or every guard written as
            ; `typeof x === "bigint"` reads "object" and takes the wrong path.
            def bigTag@(optional):EvHandle (val.tryOwnData("__biglimbs__"))
            if bigTag {
                return "bigint"
            }
            return "object"
        }
        if (val.isMap()) {
            return "object"
        }
        if (val.isSet()) {
            return "object"
        }
        if (val.isElement()) {
            return "object"
        }
        return "undefined"
    }

    fn evaluateTypeofExpr:EvHandle (node:TSNode) {
        if node.left {
            def argNode:TSNode (unwrap node.left)
            if ((this.nodeKindOf(argNode)) == 1) {
                def name:string argNode.name
                if (name == "undefined") {
                    return (EvValueBridge.taggedString("undefined"))
                }
                if (false == (this.bindingExists(name))) {
                    ; D-CLASSREF: a class lives in the class table rather than in
                    ; a scope, so `typeof A` read "undefined" for every class in
                    ; the program even though `A` resolved everywhere else.
                    def clsT:TSNode (this.classNodeByName(name))
                    if ((this.nodeKindOf(clsT)) == 25) {
                        return (EvValueBridge.taggedString("function"))
                    }
                    ; A global FUNCTION property -- parseInt, escape, … -- is a
                    ; property of the global object rather than a binding, and
                    ; only the engine-global names consulted it below, so
                    ; `typeof escape` read "undefined" for a function that works.
                    def gObjF:EvHandle (this.theGlobalObject())
                    if (gObjF.isObject()) {
                        if (gObjF.hasOwnData(name)) {
                            return (EvValueBridge.taggedString((this.typeofTag((gObjF.getOwnData(name))))))
                        }
                    }
                    ; D-GLOBALOBJ: a built-in global is not a scope binding, but
                    ; it exists — typeof must say so. Constructors report
                    ; "function", namespaces like Math and JSON report "object".
                    if (this.isEngineGlobalName(name)) {
                        if (this.isBuiltinCtorName(name)) {
                            return (EvValueBridge.taggedString("function"))
                        }
                        ; A VALUE property of the global -- NaN, Infinity -- is a
                        ; number, and asking builtinGlobalObject for it minted an
                        ; empty namespace object instead, so `typeof NaN` was
                        ; "object". The global object holds the real value.
                        def gObjT:EvHandle (this.theGlobalObject())
                        if (gObjT.isObject()) {
                            if (gObjT.hasOwnData(name)) {
                                return (EvValueBridge.taggedString((this.typeofTag((gObjT.getOwnData(name))))))
                            }
                        }
                        def gv:EvHandle (this.builtinGlobalObject(name))
                        if (gv.isObject()) {
                            return (EvValueBridge.taggedString("object"))
                        }
                    }
                    return (EvValueBridge.taggedString("undefined"))
                }
                def val:EvHandle (context.lookup(name))
                return (EvValueBridge.taggedString((this.typeofTag(val))))
            }
            def val:EvHandle (this.evaluateExpr(argNode))
            return (EvValueBridge.taggedString((this.typeofTag(val))))
        }
        return (EvValueBridge.taggedString("undefined"))
    }
    
    fn evaluateUnaryExpr:EvHandle (node:TSNode) {
        def op:string node.value
        def opK:int (this.opKindOf(node))
        if (opK == 46) {
            return (this.evaluateTypeofExpr(node))
        }
        ; delete obj.x / obj["k"] / arr[i] — remove the property (operand is a
        ; reference, so it must not be evaluated to a value first).
        if (opK == 47) {
            if node.left {
                def tgt:TSNode (unwrap node.left)
                ; D-WITH: `delete name` had no case at all -- it answered true
                ; and removed nothing. The name is a REFERENCE, and what it
                ; resolves to decides the answer:
                ;   - a property of a `with` object: delete that property;
                ;   - a declared `var`/function: non-configurable, so false;
                ;   - a binding created by plain assignment (an implicit global):
                ;     configurable, so it goes and the answer is true;
                ;   - unresolvable: true, per spec.
                if ((this.nodeKindOf(tgt)) == 1) {
                    def delName:string tgt.name
                    def delWith:EvHandle (this.withHostFor(delName))
                    if (delWith.isObject()) {
                        if (false == (delWith.isConfigurable(delName))) {
                            if strictMode {
                                return (this.throwSpecError("TypeError" ("cannot delete " + delName)))
                            }
                            return (EvValueBridge.taggedBoolean(false))
                        }
                        delWith.removeMember(delName)
                        return (EvValueBridge.taggedBoolean(true))
                    }
                    ; A `delete` of a NAME is a SyntaxError in strict mode.
                    if strictMode {
                        return (this.throwSpecError("SyntaxError" ("cannot delete the unqualified name " + delName)))
                    }
                    ; A non-configurable property of the GLOBAL object -- NaN,
                    ; Infinity, undefined -- cannot be deleted either, and it is
                    ; not a scope binding so the check below never saw it.
                    def gDel:EvHandle (this.theGlobalObject())
                    if (gDel.isObject()) {
                        if (gDel.hasOwnData(delName)) {
                            if (false == (gDel.isConfigurable(delName))) {
                                return (EvValueBridge.taggedBoolean(false))
                            }
                        }
                    }
                    if (context.has(delName)) {
                        ; A DECLARED binding -- `var`, a function declaration, a
                        ; parameter -- is non-configurable, so the delete fails
                        ; and the binding stays. Only a name created by
                        ; assignment to an undeclared identifier can go.
                        if (false == (has implicitGlobalSet delName)) {
                            return (EvValueBridge.taggedBoolean(false))
                        }
                        def removed:boolean (context.removeBinding(delName))
                        def gObj:EvHandle (this.theGlobalObject())
                        if (gObj.isObject()) {
                            gObj.removeMember(delName)
                        }
                        def freshImplicit:[string:boolean]
                        def implNames:[string] (keys implicitGlobalSet)
                        def ii:int 0
                        while (ii < (array_length implNames)) {
                            if ((itemAt implNames ii) != delName) {
                                set freshImplicit (itemAt implNames ii) true
                            }
                            ii = (ii + 1)
                        }
                        implicitGlobalSet = freshImplicit
                        return (EvValueBridge.taggedBoolean(removed))
                    }
                    return (EvValueBridge.taggedBoolean(true))
                }
                if ((this.nodeKindOf(tgt)) == 3) {
                    def obj:EvHandle (EvValueBridge.taggedNull())
                    if tgt.left {
                        obj = (this.evaluateExpr((unwrap tgt.left)))
                    }
                    if tgt.computed {
                        if tgt.right {
                            def iv:EvHandle (this.evaluateExpr((unwrap tgt.right)))
                            if scriptThrew {
                                return (EvValueBridge.taggedUndefined())
                            }
                            ; D-ARRAYLEN: deleting an ELEMENT leaves a hole and
                            ; does NOT shorten the array. removeMember only knows
                            ; about the property map, so `delete a[1]` did
                            ; nothing at all and the element stayed readable.
                            def dkey:string (this.toPropertyKey(iv))
                            if (obj.isArrayValue()) {
                                def didx@(optional):int (to_int dkey)
                                if didx {
                                    def dn:int (unwrap didx)
                                    if ((dn >= 0) && (dn < (obj.denseLen()))) {
                                        ; The element branch ran BEFORE the
                                        ; refusal check, so an element was
                                        ; deletable however it had been defined
                                        ; -- on a frozen array, on a sealed one,
                                        ; on an index defineProperty had made
                                        ; non-configurable. The suite's own
                                        ; isConfigurable helper measures exactly
                                        ; this: it deletes and asks whether the
                                        ; property is gone.
                                        if (this.deleteRefused(obj dkey)) {
                                            if strictMode {
                                                return (this.throwSpecError("TypeError" ("cannot delete " + dkey)))
                                            }
                                            return (EvValueBridge.taggedBoolean(false))
                                        }
                                        ; D-ACCESSORS: an index redefined as an
                                        ; accessor lives in the getter/setter
                                        ; maps, so blanking the dense slot alone
                                        ; left the property readable through its
                                        ; getter after `delete a[1]`.
                                        obj.removeMember(dkey)
                                        obj.setIndexAt(dn (EvValueBridge.taggedHole()))
                                        return (EvValueBridge.taggedBoolean(true))
                                    }
                                }
                            }
                            def pxDel:int (this.proxyDelete(obj dkey))
                            if (pxDel >= 0) {
                                if scriptThrew {
                                    return (EvValueBridge.taggedUndefined())
                                }
                                return (EvValueBridge.taggedBoolean((pxDel == 1)))
                            }
                            if (this.deleteRefused(obj dkey)) {
                                if strictMode {
                                    return (this.throwSpecError("TypeError" ("cannot delete " + dkey)))
                                }
                                return (EvValueBridge.taggedBoolean(false))
                            }
                            this.unmapArgIndex(obj dkey)
                            obj.removeMember(dkey)
                            this.syncGlobalObjectDelete(obj dkey)
                            if (this.isBuiltinPrototypeObject(obj)) {
                                obj.addSuppressed(dkey)
                            }
                        }
                    } {
                        def pxDel2:int (this.proxyDelete(obj tgt.name))
                        if (pxDel2 >= 0) {
                            if scriptThrew {
                                return (EvValueBridge.taggedUndefined())
                            }
                            return (EvValueBridge.taggedBoolean((pxDel2 == 1)))
                        }
                        if (this.deleteRefused(obj tgt.name)) {
                            if strictMode {
                                return (this.throwSpecError("TypeError" ("cannot delete " + tgt.name)))
                            }
                            return (EvValueBridge.taggedBoolean(false))
                        }
                        this.unmapArgIndex(obj tgt.name)
                        obj.removeMember(tgt.name)
                        this.syncGlobalObjectDelete(obj tgt.name)
                        if (this.isBuiltinPrototypeObject(obj)) {
                            obj.addSuppressed(tgt.name)
                        }
                    }
                }
            }
            return (EvValueBridge.taggedBoolean(true))
        }
        if node.left {
            def argExpr:TSNode (unwrap node.left)
            def arg:EvHandle (this.evaluateExpr(argExpr))
            
            if (opK == 49) {
                return (EvValueBridge.taggedBoolean(((arg.toBool()) == false)))
            }
            ; D-BIGINT: unary minus and `~` answer BigInts; unary PLUS is a
            ; TypeError, alone among them, because +x is defined as ToNumber
            ; and a BigInt refuses that conversion.
            if (this.isBigIntValue(arg)) {
                ; Hoisted into locals: two `this` methods inside one call
                ; expression are two live borrows of it on the Rust target.
                if (opK == 21) {
                    def negSrc:BigNum (this.bigNumOf(arg))
                    def negOut:BigNum (negSrc.negate())
                    return (this.makeBigIntValue(negOut))
                }
                if (opK == 50) {
                    def notSrc:BigNum (this.bigNumOf(arg))
                    def notOut:BigNum (notSrc.bitNot())
                    return (this.makeBigIntValue(notOut))
                }
                if (opK == 20) {
                    return (this.throwSpecError("TypeError" "Cannot convert a BigInt value to a number"))
                }
            }
            if (opK == 21) {
                ; D-IEEE: negate by MULTIPLYING by -1, not by subtracting from
                ; zero. `0.0 - 0.0` is +0, so subtraction silently destroyed
                ; negative zero and the engine had no -0 at all.
                def negOne:double (0.0 - 1.0)
                return (EvValueBridge.taggedNumber((negOne * (this.toNumberOf(arg)))))
            }
            if (opK == 20) {
                ; ToNumber, not the value's own idea of a number: `+"0xff"` is
                ; 255 and `+{valueOf: …}` runs the method.
                return (EvValueBridge.taggedNumber((this.toNumberOf(arg))))
            }
            ; Bitwise NOT (~x == -(x)-1). Coerce to int32 like JS/AS.
            if (opK == 50) {
                return (EvHandle.fromInt((bit_not (this.toInt32Of(arg)))))
            }
            ; void x evaluates the operand for side effects and yields undefined.
            if (opK == 48) {
                return (EvValueBridge.taggedUndefined())
            }
        }

        return (EvValueBridge.taggedNull())
    }

    fn evaluateConditionalExpr:EvHandle (node:TSNode) {
        if node.test {
            def testExpr:TSNode (unwrap node.test)
            def test:EvHandle (this.evaluateExpr(testExpr))
            
            if (test.toBool()) {
                if node.consequent {
                    def conseqNode:TSNode (unwrap node.consequent)
                    return (this.evaluateExpr(conseqNode))
                }
            } {
                if node.alternate {
                    def altNode:TSNode (unwrap node.alternate)
                    return (this.evaluateExpr(altNode))
                }
            }
        }
        
        return (EvValueBridge.taggedNull())
    }
    
    ; ---- user classes: instances, methods, `this`-bound dispatch ----------
    ; The __class__ name stamped on an instance object, or "" for non-instances.
    fn instanceClassName:string (obj:EvHandle) {
        ; isDescriptorObject, not isObject: an instance of a class extending
        ; Array is an ARRAY, and the narrower test made it nameless -- so
        ; `super(...)` in its constructor could not find the class to climb
        ; from and did nothing. The stamp is only ever present on an instance,
        ; so widening the test cannot name anything that was not one.
        if (false == (this.isDescriptorObject(obj))) { return "" }
        def cv@(optional):EvHandle (obj.tryOwnData("__class__"))
        if cv {
            def c:EvHandle (unwrap cv)
            if (c.isString()) {
                return (c.stringOf())
            }
        }
        return ""
    }

    ; The virtual module an instance's class was declared in ("" = entry-realm
    ; class). Stamped by evaluateNewExpr for module-owned classes.
    fn instanceModuleTag:string (obj:EvHandle) {
        if (false == (obj.isObject())) { return "" }
        def mv@(optional):EvHandle (obj.tryOwnData("__module__"))
        if mv {
            def m:EvHandle (unwrap mv)
            if (m.isString()) {
                return (m.stringOf())
            }
        }
        return ""
    }

    ; Resolve the class declaration an instance was constructed from: a module
    ; tag routes to that module's class table, otherwise the engine-wide map
    ; (entry-realm classes). Empty node when unknown.
    fn classNodeForInstance:TSNode (obj:EvHandle) {
        def empty:TSNode (new TSNode())
        def clsName:string (this.instanceClassName(obj))
        if ((strlen clsName) == 0) {
            return empty
        }
        def tag:string (this.instanceModuleTag(obj))
        if ((strlen tag) > 0) {
            return (this.moduleClassNode(tag clsName))
        }
        def cn@(optional):TSNode (get classes clsName)
        if (null? cn) {
            return empty
        }
        return (unwrap cn)
    }

    ; D-CLASSSTATIC: a `static m() {}` member, which the parser tags kind="static".
    ; Kept separate from findMethodOnClassNode so a static and an instance method
    ; of the same name never resolve to each other.
    ; D-CLASSEXPR: give a class expression a table key and hand back a value that
    ; refers to it. A named class expression keeps its own name so recursive
    ; self-reference inside the body still resolves.
    ; D-CLASSEXTENDS: the superclass name of a class declaration. The parser puts
    ; `extends X` on `left` as a TSExpressionWithTypeArguments, so it is read from
    ; there rather than from a dedicated field.
    fn superClassNameOf:string (cls:TSNode) {
        if (null? cls.left) { return "" }
        def sup:TSNode (unwrap cls.left)
        if ((strlen sup.name) > 0) {
            return sup.name
        }
        if sup.left {
            def inner:TSNode (unwrap sup.left)
            return inner.name
        }
        return ""
    }

    ; Run the base-class constructor against an instance under construction.
    ; Walks the chain so a three-deep hierarchy initialises every level.
    ; The class the chain walk actually FINDS `methodName` on, starting at
    ; `cls` (named `clsName`). This is the method's HOME class -- what its
    ; own `super` must climb from.
    fn homeClassOfMethod:string (cls:TSNode clsName:string methodName:string) {
        def cur:TSNode cls
        def curName:string clsName
        def depth:int 0
        while (depth < 16) {
            if (null? cur.body) {
                return curName
            }
            def body:TSNode (unwrap cur.body)
            def i 0
            while (i < (array_length body.children)) {
                def m:TSNode (itemAt body.children i)
                if (m.nodeType == "MethodDefinition") {
                    if (m.name == methodName) {
                        return curName
                    }
                }
                i = (i + 1)
            }
            def supName:string (this.superClassNameOf(cur))
            if ((strlen supName) == 0) {
                return curName
            }
            def supCls:TSNode (this.classNodeByName(supName))
            if ((this.nodeKindOf(supCls)) != 25) {
                return curName
            }
            cur = supCls
            curName = supName
            depth = (depth + 1)
        }
        return curName
    }

    ; D-SUPER: `super.m(...)`. The search starts at the HOME class of the
    ; method that is executing (falling back to the instance's class when no
    ; register is set -- e.g. a method invoked through a stored value) and
    ; resolves m from its PARENT upward. The found method runs with the
    ; CURRENT `this`, and with the class it was found on as the home
    ; register, so a further `super.m()` inside it keeps climbing.
    fn callSuperMethod:EvHandle (node:TSNode callee:TSNode) {
        def mName:string callee.name
        if ((strlen mName) == 0) {
            if callee.right {
                def spn:TSNode (unwrap callee.right)
                mName = spn.name
                if ((strlen mName) == 0) {
                    mName = spn.value
                }
            }
        }
        def selfV:EvHandle (context.lookup("this"))
        def homeCls:string currentHomeClass
        if ((strlen homeCls) == 0) {
            homeCls = (this.instanceClassName(selfV))
        }
        def homeNode:TSNode (this.classNodeByName(homeCls))
        if ((this.nodeKindOf(homeNode)) == 25) {
            def supName:string (this.superClassNameOf(homeNode))
            if ((strlen supName) > 0) {
                def supCls:TSNode (this.classNodeByName(supName))
                if ((this.nodeKindOf(supCls)) == 25) {
                    def m:TSNode (this.findMethodOnClassNode(supCls mName))
                    if (m.nodeType == "MethodDefinition") {
                        def savedHome:string currentHomeClass
                        currentHomeClass = (this.homeClassOfMethod(supCls supName mName))
                        def r:EvHandle (this.callUserFunctionNode(m node.children selfV true))
                        currentHomeClass = savedHome
                        return r
                    }
                }
            }
        }
        ; D-SUPER: the class-node walk only knows about classes declared in this
        ; realm. Now that a class has a REAL prototype, the general answer is the
        ; prototype chain -- which is also the only one that works for a static
        ; method (whose `this` is the constructor) and for a base that is a
        ; built-in.
        def superFn:EvHandle (this.superLookup(selfV homeCls mName))
        if (superFn.isFunction()) {
            def sArgs:[EvHandle] (this.collectCallArgs(node))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            return (this.callFnValueWithValues((superFn.withThisForCall(selfV)) sArgs))
        }
        return (this.throwSpecError("TypeError" ("(intermediate value)." + (mName + " is not a function"))))
    }

    ; D-SUPER: `super.<name>` resolved through the prototype chain. For an
    ; instance method the home is the class's prototype and the answer lives one
    ; link above it; for a STATIC the home is the constructor itself.
    fn superLookup:EvHandle (selfV:EvHandle homeCls:string name:string) {
        def start:EvHandle (EvValueBridge.taggedNull())
        if (selfV.isFunction()) {
            ; A static method: `this` is the constructor, and super is its own
            ; prototype -- the base CONSTRUCTOR, not the base prototype.
            start = (this.protoOfValue(selfV))
        } {
            if ((strlen homeCls) > 0) {
                def homeV:EvHandle (this.classValueFor(homeCls))
                def homeProto:EvHandle (homeV.getMember("prototype"))
                if (this.isDescriptorObject(homeProto)) {
                    start = (this.protoOfValue(homeProto))
                }
            }
            if (start.isNull()) {
                ; No home class in the register -- an object literal's method,
                ; whose super is the literal's own prototype.
                if (this.isDescriptorObject(selfV)) {
                    start = (this.protoOfValue(selfV))
                }
            }
        }
        if (false == (this.isDescriptorObject(start))) {
            return (EvValueBridge.taggedNull())
        }
        return (this.getPropertyValue(start name))
    }

    ; The same forward as runSuperConstructor, for a construction whose
    ; arguments were already evaluated. Only the builtin-base and
    ; implicit-forward cases can be reached that way -- a class with an explicit
    ; constructor runs its own body, which does its own super() call.
    fn runSuperConstructorValues:void (cls:TSNode inst:EvHandle argVals:[EvHandle] depth:int) {
        if (depth > 16) {
            return
        }
        def supName:string (this.superClassNameOf(cls))
        if ((strlen supName) == 0) {
            return
        }
        def supCls:TSNode (this.classNodeByName(supName))
        if ((this.nodeKindOf(supCls)) != 25) {
            if (this.isBuiltinCtorName(supName)) {
                this.initFromBuiltinBase(supName inst argVals)
            }
            return
        }
        def sCtor:TSNode (this.findConstructorOnClassNode(supCls))
        if (sCtor.nodeType == "MethodDefinition") {
            def savedHomeS:string currentHomeClass
            currentHomeClass = supName
            pendingNewTarget = currentNewTarget
            hasPendingNewTarget = true
            def _sr:EvHandle (this.callUserFunctionValues(sCtor argVals inst))
            currentHomeClass = savedHomeS
            return
        }
        def nd:int (depth + 1)
        this.runSuperConstructorValues(supCls inst argVals nd)
    }

    fn runSuperConstructor:void (cls:TSNode inst:EvHandle argNodes:[TSNode] depth:int) {
        if (depth > 16) {
            return
        }
        def supName:string (this.superClassNameOf(cls))
        if ((strlen supName) == 0) {
            return
        }
        def supCls:TSNode (this.classNodeByName(supName))
        if ((this.nodeKindOf(supCls)) != 25) {
            ; D-CLASSBUILTIN: `class E extends TypeError`. The base is a
            ; BUILT-IN constructor, not a class node, so the chain walk stopped
            ; and `super(msg)` did nothing at all -- the instance carried no
            ; message and was not an Error by any test.
            if (this.isBuiltinCtorName(supName)) {
                def bArgs:[EvHandle]
                def bi2:int 0
                while (bi2 < (array_length argNodes)) {
                    push bArgs (this.evaluateExpr((itemAt argNodes bi2)))
                    if scriptThrew {
                        return
                    }
                    bi2 = (bi2 + 1)
                }
                this.initFromBuiltinBase(supName inst bArgs)
            }
            return
        }
        ; Base field initialisers first, then its constructor — the same order
        ; `new` uses, so a field the base constructor overwrites ends up correct.
        if supCls.body {
            def sBody:TSNode (unwrap supCls.body)
            def savedCtxS:EvalContext context
            context = (context.createChild())
            context.define("this" inst)
            def bi:int 0
            while (bi < (array_length sBody.children)) {
                def bm:TSNode (itemAt sBody.children bi)
                if (bm.nodeType == "PropertyDefinition") {
                    if bm.init {
                        def bv:EvHandle (this.evaluateExpr((unwrap bm.init)))
                        inst.setMember(bm.name bv)
                    }
                }
                bi = (bi + 1)
            }
            context = savedCtxS
        }
        def sCtor:TSNode (this.findConstructorOnClassNode(supCls))
        if (sCtor.nodeType == "MethodDefinition") {
            ; D-SUPER: the base constructor's own class becomes the home
            ; register while it runs.
            def savedHomeS:string currentHomeClass
            currentHomeClass = supName
            ; D-NEWTARGET: super() forwards the DERIVED class as new.target --
            ; the base constructor sees who was actually newed, not itself.
            pendingNewTarget = currentNewTarget
            hasPendingNewTarget = true
            def _sr:EvHandle (this.callUserFunctionNode(sCtor argNodes inst true))
            currentHomeClass = savedHomeS
        } {
            ; No explicit constructor: an implicit one just forwards upward.
            def nd:int (depth + 1)
            this.runSuperConstructor(supCls inst argNodes nd)
        }
    }

    ; D-CLASSBUILTIN: give an instance the internal state its BUILT-IN base
    ; constructor would have given it. The instance object already exists (the
    ; class path made it and linked its prototype), so the base's result is
    ; copied onto it rather than replacing it -- which is what keeps the derived
    ; prototype and the `__class__` stamp.
    ; D-CLASSBUILTIN: the BUILT-IN constructor at the top of a class's extends
    ; chain, or "" when the chain is all classes. `class A extends Array` has to
    ; make a real array, and that decision belongs at instance-creation time --
    ; a plain object cannot become one later.
    fn builtinBaseOfClass:string (clsName:string) {
        def cur:string clsName
        def depth:int 0
        while (depth < 16) {
            def node:TSNode (this.classNodeByName(cur))
            if ((this.nodeKindOf(node)) != 25) {
                return ""
            }
            def sup:string (this.superClassNameOf(node))
            if ((strlen sup) == 0) {
                return ""
            }
            def supNode:TSNode (this.classNodeByName(sup))
            if ((this.nodeKindOf(supNode)) != 25) {
                if (this.isBuiltinCtorName(sup)) {
                    return sup
                }
                return ""
            }
            cur = sup
            depth = (depth + 1)
        }
        return ""
    }

    fn initFromBuiltinBase:void (baseName:string inst:EvHandle args:[EvHandle]) {
        def built:EvHandle (this.callBuiltinCtorValues(baseName args true))
        if scriptThrew {
            return
        }
        if (false == (this.isDescriptorObject(built))) {
            return
        }
        ; D-CLASSBUILTIN: an Array base hands over ELEMENTS, not properties. The
        ; key walk below sees only indices that are actually present, so
        ; `new A(3)` -- a length-3 hole array carrying no keys at all -- copied
        ; nothing and answered length 0.
        if (baseName == "Array") {
            if (inst.isArrayValue()) {
                if (built.isArrayValue()) {
                    def elems:[EvHandle]
                    def ei:int 0
                    def eN:int (built.denseLen())
                    while (ei < eN) {
                        push elems (built.arrayItemAt(ei))
                        ei = (ei + 1)
                    }
                    inst.arrSetItems(elems)
                    def declN:int (built.arrayLength())
                    if (declN > eN) {
                        this.setArrayLength(inst (to_double declN))
                    }
                    return
                }
            }
        }
        ; A Map or Set base hands over ENTRIES, which live in the internal
        ; list and are invisible to the key walk below -- `new M([["a", 1]])`
        ; copied nothing.
        if (baseName == "Map") {
            if (inst.isMap()) {
                if (built.isMap()) {
                    ; A Map entry is (key at index, value at index) -- the same
                    ; pairing the for-of path reads.
                    def mN:int (built.mapValsLen())
                    def mi:int 0
                    while (mi < mN) {
                        inst.mapSet((built.arrayItemAt(mi)) (built.mapValAt(mi)))
                        mi = (mi + 1)
                    }
                    return
                }
            }
        }
        if (baseName == "Set") {
            if (inst.isSet()) {
                if (built.isSet()) {
                    def sIt:[EvHandle] (built.itemsOf())
                    def sI:int 0
                    while (sI < (array_length sIt)) {
                        inst.setAdd((itemAt sIt sI))
                        sI = (sI + 1)
                    }
                    return
                }
            }
        }
        def ks:[string] (this.objectKeys(built))
        def i:int 0
        while (i < (array_length ks)) {
            def k:string (itemAt ks i)
            inst.setMember(k (built.getMember(k)))
            i = (i + 1)
        }
        ; The internal slots the key walk does not see, because they are hidden.
        def slots:[string]
        push slots "__error__"
        push slots "__primitive__"
        push slots "__wrapper__"
        push slots "__date__"
        push slots "__regex__"
        push slots "__promise__"
        push slots "__pid__"
        push slots "__pstate__"
        push slots "__pvalue__"
        def si:int 0
        while (si < (array_length slots)) {
            def sk:string (itemAt slots si)
            if (built.hasOwnData(sk)) {
                inst.setMember(sk (built.getOwnData(sk)))
            }
            si = (si + 1)
        }
        ; An error carries `message` and `stack` as own properties the key walk
        ; skips: both are non-enumerable.
        if (built.hasOwnData("message")) {
            inst.setMember("message" (built.getOwnData("message")))
            inst.setAttrs("message" true false true)
        }
    }

    ; D-CLASSIDENT: the one value a class name resolves to. Memoised on the
    ; module-qualified name, so two modules may each declare `Point` and still
    ; get their own.
    ; D-CLASSFIELDS: the instance field initialisers, as their own pass so the
    ; ORDER can differ between a base and a derived class. §15.7.14: a base
    ; class installs its fields before its constructor body runs; a DERIVED
    ; class installs them the moment super() returns, so the base constructor
    ; never sees them. Running them up front made
    ; `class B extends A { x = 5 }` show x to A's constructor, which is the one
    ; case a field initialiser is written to avoid.
    fn runInstanceFields:void (cls:TSNode inst:EvHandle clsModule:string) {
        ; Rooted in the class's home module scope (a module class's `field = new Other()`
        ; must see ITS module, not the construction site).
        if cls.body {
            def body:TSNode (unwrap cls.body)
            def savedCtx:EvalContext context
            def savedModule:string currentModule
            def fieldParent:EvalContext context
            if ((strlen clsModule) > 0) {
                fieldParent = (this.moduleScopeFor(clsModule))
                currentModule = clsModule
            }
            context = (fieldParent.createChild())
            context.define("this" inst)
            def i 0
            while (i < (array_length body.children)) {
                def m:TSNode (itemAt body.children i)
                if (m.nodeType == "PropertyDefinition") {
                    ; A STATIC field belongs to the class, not to the instance.
                    ; It ran here as well, so `static x = 5` left `C.x`
                    ; undefined and gave every instance its own `x` instead.
                    if (m.kind != "static") {
                        if m.init {
                            ; A COMPUTED field name is an expression, evaluated
                            ; here -- `class C { [k] = 7 }`. The parser keeps it
                            ; on `right` because `init` is the field's value.
                            def fKey:string m.name
                            if m.computed {
                                if m.right {
                                    def fKeyV:EvHandle (this.evaluateExpr((unwrap m.right)))
                                    if scriptThrew {
                                        return
                                    }
                                    fKey = (this.toPropertyKey(fKeyV))
                                    if scriptThrew {
                                        return
                                    }
                                }
                            }
                            def iv:EvHandle (this.evaluateExpr((unwrap m.init)))
                            inst.setMember(fKey iv)
                        }
                    }
                }
                ; D-CLASSACCESSORS: `get v() {}` / `set v(x) {}` in a class body
                ; install as real accessors on the instance. Without this the
                ; member read returned the accessor FUNCTION instead of calling
                ; it, which type-checks as a function and silently misbehaves.
                if (m.nodeType == "MethodDefinition") {
                    def mk:string m.accessor
                    if ((strlen mk) == 0) {
                        mk = m.kind
                    }
                    if ((mk == "get") || (mk == "set")) {
                        def accFn:EvHandle (EvValueBridge.taggedBoundMethod(m inst))
                        this.stampSrcOn(accFn)
                        if (mk == "get") {
                            inst.defineGetter(m.name accFn)
                        } {
                            inst.defineSetter(m.name accFn)
                        }
                    }
                }
                i = (i + 1)
            }
            context = savedCtx
            currentModule = savedModule
        }
    }

    fn classValueFor:EvHandle (name:string) {
        def ckey:string (currentModule + ("::" + name))
        def found@(optional):EvHandle (get classValues ckey)
        if (!null? found) {
            return (unwrap found)
        }
        def cv:EvHandle (EvValueBridge.taggedNativeFunction(name))
        ; Publish before wiring: the prototype's `constructor` points back here
        ; and a field initialiser may mention the class by name.
        set classValues ckey cv
        cv.setMember("__classname__" (EvValueBridge.taggedString(name)))
        cv.setMember("name" (EvValueBridge.taggedString(name)))
        cv.setAttrs("name" false false true)
        cv.setProto((this.builtinPrototype("Function")))
        ; A class's `length` is its constructor's declared arity, and 0 when it
        ; declares none -- the same rule an ordinary function follows.
        def clsArity:int 0
        def clsNode:TSNode (this.classNodeByName(name))
        if ((this.nodeKindOf(clsNode)) == 25) {
            def ctorNode:TSNode (this.findConstructorOnClassNode(clsNode))
            if (ctorNode.nodeType == "MethodDefinition") {
                def pi2:int 0
                while (pi2 < (array_length ctorNode.params)) {
                    def pnode:TSNode (itemAt ctorNode.params pi2)
                    if (pnode.nodeType == "RestElement") {
                        pi2 = (array_length ctorNode.params)
                    } {
                        if pnode.init {
                            pi2 = (array_length ctorNode.params)
                        } {
                            clsArity = (clsArity + 1)
                            pi2 = (pi2 + 1)
                        }
                    }
                }
            }
        }
        cv.setMember("length" (EvHandle.fromInt(clsArity)))
        cv.setAttrs("length" false false true)
        this.buildClassPrototype(name cv)
        return cv
    }

    ; D-CLASSSTATIC: `static x = expr` and `static { … }` run ONCE, when the
    ; class value is created, with `this` bound to the class. Neither ran at
    ; all: a static field was treated as an instance field, so `C.x` was
    ; undefined while `new C().x` answered the initialiser, and a static block
    ; was skipped entirely.
    ;
    ; The class value is published before this is called, so an initialiser
    ; that names its own class -- which is the normal way to write a static
    ; block -- resolves rather than recursing.
    fn runClassStaticInit:void (name:string cv:EvHandle) {
        ; Once per class. The declaration may be reached more than once -- a
        ; class inside a function that is called twice -- and the class value
        ; is one object shared across all of them.
        if (cv.hasOwnData("__staticdone__")) { return }
        cv.setMember("__staticdone__" (EvValueBridge.taggedBoolean(true)))
        cv.setAttrs("__staticdone__" false false false)
        def cls:TSNode (this.classNodeByName(name))
        if ((this.nodeKindOf(cls)) != 25) { return }
        if (null? cls.body) { return }
        def body:TSNode (unwrap cls.body)
        def hasStatic:boolean false
        def si:int 0
        while (si < (array_length body.children)) {
            def sm:TSNode (itemAt body.children si)
            if (sm.nodeType == "StaticBlock") { hasStatic = true }
            if (sm.nodeType == "PropertyDefinition") {
                if (sm.kind == "static") { hasStatic = true }
            }
            si = (si + 1)
        }
        if (false == hasStatic) { return }
        ; Rooted in the class's OWN module scope, like the instance-field pass:
        ; a module class's `static reg = new Other()` must see its module.
        def savedCtx:EvalContext context
        def savedModule:string currentModule
        def savedHome:string currentHomeClass
        def parentCtx:EvalContext context
        if ((strlen currentModule) > 0) {
            parentCtx = (this.moduleScopeFor(currentModule))
        }
        context = (parentCtx.createChild())
        context.define("this" cv)
        currentHomeClass = name
        def sj:int 0
        while (sj < (array_length body.children)) {
            def m:TSNode (itemAt body.children sj)
            if (m.nodeType == "PropertyDefinition") {
                if (m.kind == "static") {
                    def sKey:string m.name
                    if m.computed {
                        if m.right {
                            def sKeyV:EvHandle (this.evaluateExpr((unwrap m.right)))
                            if scriptThrew {
                                sj = (array_length body.children)
                            } {
                                sKey = (this.toPropertyKey(sKeyV))
                            }
                        }
                    }
                    def sv:EvHandle (EvValueBridge.taggedUndefined())
                    if m.init {
                        sv = (this.evaluateExpr((unwrap m.init)))
                    }
                    ; A field with no initialiser is still DEFINED, as
                    ; undefined -- `static x;` then `'x' in C` is true.
                    if (false == scriptThrew) {
                        cv.setMember(sKey sv)
                    }
                }
            }
            if (m.nodeType == "StaticBlock") {
                if m.body {
                    this.runBlockOrStatement((unwrap m.body))
                }
            }
            if scriptThrew {
                sj = (array_length body.children)
            } {
                sj = (sj + 1)
            }
        }
        context = savedCtx
        currentModule = savedModule
        currentHomeClass = savedHome
    }

    ; D-CLASSPROTO: a class's methods are REAL properties of a real prototype
    ; object. They used to live only in the class-node table, so `A.prototype`
    ; was empty, `A.prototype.m` was undefined, `A.prototype.constructor === A`
    ; was false, and an instance's prototype was Object.prototype rather than
    ; the class's -- every structural question about a class answered wrong even
    ; though calling its methods worked.
    fn buildClassPrototype:void (name:string cv:EvHandle) {
        def keysP:[string]
        def valsP:[EvHandle]
        def proto:EvHandle (EvValueBridge.taggedObject(keysP valsP))
        proto.setMember("constructor" cv)
        proto.setAttrs("constructor" true false true)
        cv.setMember("prototype" proto)
        ; A class's `prototype` is non-writable, non-enumerable and
        ; non-configurable, unlike an ordinary function's.
        cv.setAttrs("prototype" false false false)
        def cls:TSNode (this.classNodeByName(name))
        if ((this.nodeKindOf(cls)) != 25) {
            proto.setProto((this.builtinPrototype("Object")))
            return
        }
        ; `class B extends A` links BOTH chains: B.prototype to A.prototype for
        ; instance methods, and B to A for inherited statics.
        def supName:string (this.superClassNameOf(cls))
        def linked:boolean false
        if ((strlen supName) > 0) {
            def supNode:TSNode (this.classNodeByName(supName))
            if ((this.nodeKindOf(supNode)) == 25) {
                def supV:EvHandle (this.classValueFor(supName))
                def supProto:EvHandle (supV.getMember("prototype"))
                if (supProto.isObject()) {
                    proto.setProto(supProto)
                    cv.setProto(supV)
                    linked = true
                }
            } {
                ; D-CLASSBUILTIN: `class E extends TypeError` -- the base is a
                ; built-in, so the chain is linked to ITS prototype and
                ; constructor. Without it the derived prototype hung off
                ; Object.prototype and `new E() instanceof TypeError` was false.
                if (this.isErrorCtorName(supName)) {
                    proto.setProto((this.errorPrototypeFor(supName)))
                    def ectr:EvHandle (this.errorCtorFor(supName))
                    if (ectr.isFunction()) {
                        cv.setProto(ectr)
                    }
                    linked = true
                } {
                    if (this.isBuiltinCtorName(supName)) {
                        proto.setProto((this.builtinPrototype(supName)))
                        cv.setProto((this.builtinGlobalObject(supName)))
                        linked = true
                    }
                }
            }
        }
        if (false == linked) {
            proto.setProto((this.builtinPrototype("Object")))
        }
        if (null? cls.body) { return }
        def body:TSNode (unwrap cls.body)
        def i:int 0
        while (i < (array_length body.children)) {
            def m:TSNode (itemAt body.children i)
            if (m.nodeType == "MethodDefinition") {
                ; `accessor` names get/set when the parser records it there;
                ; otherwise `kind` carries it, and `kind` also carries "static".
                def acc:string m.accessor
                if ((strlen acc) == 0) {
                    if ((m.kind == "get") || (m.kind == "set")) {
                        acc = m.kind
                    }
                }
                def onStatic:boolean (m.kind == "static")
                def home:EvHandle proto
                if onStatic { home = cv }
                ; A COMPUTED member name -- `[Symbol.iterator]() {}` or
                ; `[expr]() {}` -- carries its key as an expression rather than a
                ; name. Without evaluating it the method landed under "" and was
                ; unreachable, which is why a class could not publish an
                ; iterator at all.
                def mKey:string m.name
                if m.computed {
                    if m.init {
                        def mKeyV:EvHandle (this.evaluateExpr((unwrap m.init)))
                        if (false == scriptThrew) {
                            mKey = (this.toPropertyKey(mKeyV))
                        }
                    }
                }
                ; A class's own `prototype` is non-configurable, so a STATIC
                ; that lands on it -- `static ['prototype']() {}` -- is refused.
                if onStatic {
                    if (mKey == "prototype") {
                        def _sp:EvHandle (this.throwSpecError("TypeError" "Cannot redefine property: prototype"))
                        return
                    }
                }
                if ((m.kind != "constructor") && ((strlen mKey) > 0)) {
                    def mv:EvHandle (EvValueBridge.taggedFunction(m))
                    ; A class method is NOT a constructor: it has no `prototype`
                    ; at all, which `'prototype' in C.prototype.m` asks directly.
                    mv.addSuppressed("prototype")
                    ; An accessor's name carries its kind -- the getter for `g`
                    ; is named "get g", not "g".
                    def mName:string (this.functionNameForKey(mKey))
                    if (acc == "get") { mName = ("get " + mName) }
                    if (acc == "set") { mName = ("set " + mName) }
                    mv.setMember("name" (EvValueBridge.taggedString(mName)))
                    mv.setAttrs("name" false false true)
                    if (acc == "get") {
                        home.defineGetter(mKey mv)
                        home.setAttrs(mKey true false true)
                    } {
                        if (acc == "set") {
                            home.defineSetter(mKey mv)
                            home.setAttrs(mKey true false true)
                        } {
                            home.setMember(mKey mv)
                            home.setAttrs(mKey true false true)
                        }
                    }
                }
            }
            i = (i + 1)
        }
    }

    fn registerClassExpression:EvHandle (node:TSNode) {
        ; The DECLARED name, before the table key overwrites it below: `decl` is
        ; the same node, so `decl.name = nm` renames `node` too and the
        ; generated key leaked out as `C.name` for an anonymous class.
        def declaredName:string node.name
        def nm:string node.name
        if ((strlen nm) == 0) {
            classExprSeq = (classExprSeq + 1)
            nm = ("__classexpr" + (to_string classExprSeq))
        }
        def decl:TSNode node
        decl.nodeType = "ClassDeclaration"
        ; the node's KIND is memoised on first visit — rewriting nodeType
        ; must reset the memo or every later kind check sees the stale
        ; ClassExpression (the one runtime nodeType rewrite in the engine)
        decl.evalKind = 0
        decl.name = nm
        set classes nm decl
        def cv:EvHandle (this.classValueFor(nm))
        ; An ANONYMOUS class expression carries the generated table key as its
        ; identity but has no `name` of its own.
        ; classValueFor already stamped the TABLE key as `name` and froze it, so
        ; the generated key for an anonymous class expression stuck.
        cv.setAttrs("name" true false true)
        cv.setMember("name" (EvValueBridge.taggedString(declaredName)))
        cv.setAttrs("name" false false true)
        return cv
    }

    fn findStaticMethodOnClassNode:TSNode (cls:TSNode methodName:string) {
        def empty:TSNode (new TSNode())
        if (null? cls.body) { return empty }
        def body:TSNode (unwrap cls.body)
        def i 0
        while (i < (array_length body.children)) {
            def m:TSNode (itemAt body.children i)
            if (m.nodeType == "MethodDefinition") {
                if (m.kind == "static") {
                    if (m.name == methodName) {
                        return m
                    }
                }
            }
            i = (i + 1)
        }
        return empty
    }

    ; Resolve a class by name in the module-aware order `new` uses.
    fn classNodeByName:TSNode (name:string) {
        def empty:TSNode (new TSNode())
        if ((strlen name) == 0) { return empty }
        if ((strlen currentModule) > 0) {
            def mc:TSNode (this.moduleClassNode(currentModule name))
            if ((this.nodeKindOf(mc)) == 25) {
                return mc
            }
        }
        def cn@(optional):TSNode (get classes name)
        if cn {
            return (unwrap cn)
        }
        return empty
    }

    ; D-CLASSEXTENDS: resolve an instance method, walking the `extends` chain so
    ; an inherited method is found. Own members win, then each ancestor in turn;
    ; depth-bounded so a cycle in the table cannot hang the host.
    fn findMethodOnClassNode:TSNode (cls:TSNode methodName:string) {
        def empty:TSNode (new TSNode())
        def cur:TSNode cls
        def depth:int 0
        while (depth < 16) {
            if (null? cur.body) {
                return empty
            }
            def body:TSNode (unwrap cur.body)
            def i 0
            while (i < (array_length body.children)) {
                def m:TSNode (itemAt body.children i)
                if (m.nodeType == "MethodDefinition") {
                    if (m.name == methodName) {
                        return m
                    }
                }
                i = (i + 1)
            }
            def supName:string (this.superClassNameOf(cur))
            if ((strlen supName) == 0) {
                return empty
            }
            def supCls:TSNode (this.classNodeByName(supName))
            if ((this.nodeKindOf(supCls)) != 25) {
                return empty
            }
            cur = supCls
            depth = (depth + 1)
        }
        return empty
    }

    ; Does this class extend something? Only a derived constructor owes a
    ; super() call.
    fn classIsDerived:boolean (cls:TSNode) {
        if (null? cls.left) { return false }
        return true
    }

    fn findConstructorOnClassNode:TSNode (cls:TSNode) {
        def empty:TSNode (new TSNode())
        if (null? cls.body) { return empty }
        def body:TSNode (unwrap cls.body)
        def i 0
        while (i < (array_length body.children)) {
            def m:TSNode (itemAt body.children i)
            if (m.nodeType == "MethodDefinition") {
                if (m.kind == "constructor") {
                    return m
                }
            }
            i = (i + 1)
        }
        return empty
    }

    ; The MethodDefinition node named `methodName` on class `clsName`, or an empty
    ; node (nodeType "") when there is none.
    fn findMethodInClass:TSNode (clsName:string methodName:string) {
        def empty:TSNode (new TSNode())
        def cn@(optional):TSNode (get classes clsName)
        if (null? cn) { return empty }
        def cls:TSNode (unwrap cn)
        if (null? cls.body) { return empty }
        def body:TSNode (unwrap cls.body)
        def i 0
        while (i < (array_length body.children)) {
            def m:TSNode (itemAt body.children i)
            if (m.nodeType == "MethodDefinition") {
                if (m.name == methodName) {
                    return m
                }
            }
            i = (i + 1)
        }
        return empty
    }

    fn findConstructor:TSNode (clsName:string) {
        def empty:TSNode (new TSNode())
        def cn@(optional):TSNode (get classes clsName)
        if (null? cn) { return empty }
        def cls:TSNode (unwrap cn)
        if (null? cls.body) { return empty }
        def body:TSNode (unwrap cls.body)
        def i 0
        while (i < (array_length body.children)) {
            def m:TSNode (itemAt body.children i)
            if (m.nodeType == "MethodDefinition") {
                if (m.kind == "constructor") {
                    return m
                }
            }
            i = (i + 1)
        }
        return empty
    }

    ; Invoke a function/method node: new child scope, optional `this`, bind the
    ; argument expressions to params (evaluated in the caller's scope), run the
    ; body, restore. Shared by method calls, bound-method values, constructors.
    ; D-ERRORS: `new F(args)` for an ordinary function F. Creates the instance,
    ; stamps `constructor` so it can be compared against F by reference, runs the
    ; body with `this` bound to it, and returns the object — unless the body
    ; explicitly returned an object, which per spec wins.
    fn constructFromFunction:EvHandle (fnV:EvHandle className:string argNodes:[TSNode]) {
        ; D-CTORVALUE: bind curries [[Construct]] as well as [[Call]], so
        ; `new (Function.prototype.bind.apply(Date, [null, 1957, 4, 27]))()`
        ; must build a DATE. A bound built-in has no function node, so the
        ; ordinary path below could not run it at all and answered a bare
        ; object -- Object.prototype.toString then branded it "[object
        ; Undefined]".
        def hasCtorNode:boolean false
        if (fnV.hasFunctionNode()) {
            hasCtorNode = true
        }
        if (false == hasCtorNode) {
            def bctor:string (this.builtinCtorNameOf(fnV))
            if ((strlen bctor) > 0) {
                def bvals:[EvHandle]
                def bbi:int 0
                while (bbi < (fnV.boundArgCount())) {
                    push bvals (fnV.boundArgAt(bbi))
                    bbi = (bbi + 1)
                }
                def bai:int 0
                while (bai < (array_length argNodes)) {
                    push bvals (this.evaluateExpr((itemAt argNodes bai)))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    bai = (bai + 1)
                }
                return (this.callBuiltinCtorValues(bctor bvals true))
            }
        }
        ; A GENERATOR function is not a constructor -- `new g()` is a TypeError.
        if hasCtorNode {
            if ((fnV.functionNodeOf()).generator) {
                return (this.throwSpecError("TypeError" "generator function is not a constructor"))
            }
            ; Nor is an async function: it has no [[Construct]] at all.
            if ((fnV.functionNodeOf()).async) {
                return (this.throwSpecError("TypeError" "async function is not a constructor"))
            }
        }
        def keys0:[string]
        def vals0:[EvHandle]
        def inst:EvHandle (EvValueBridge.taggedObject(keys0 vals0))
        ; D-PROTO: link the instance to the constructor's prototype object, so
        ; methods put on `F.prototype` are reachable through the instance.
        ; `constructor` is INHERITED from that prototype rather than stamped on
        ; the instance -- stamping it made every instance own a property it
        ; should not, which getOwnPropertyNames and isFrozen both notice.
        def instProto:EvHandle (fnV.getMember("prototype"))
        ; D-FNPROTO: a BOUND function has no `prototype` of its own, so reading
        ; one off it answers undefined -- but `new bound()` links the instance
        ; to the TARGET's prototype, which the bound copy still shares through
        ; its property map. Without this the instance had no prototype at all
        ; and inherited nothing, not even from Object.prototype.
        if (fnV.boundExplicitOf()) {
            if (fnV.hasOwnData("prototype")) {
                instProto = (fnV.getOwnData("prototype"))
            } {
                def keysBP:[string]
                def valsBP:[EvHandle]
                instProto = (EvValueBridge.taggedObject(keysBP valsBP))
                fnV.putOwnData("prototype" instProto)
            }
        }
        inst.setProto(instProto)
        if (instProto.isObject()) {
            ; D-PROTO: `F.prototype` is minted by the value layer, which cannot
            ; reach the realm's Object.prototype, so the chain ended one link
            ; short -- `Object.prototype.p = 1; (new F()).p` read undefined.
            ; Closing it here is the first moment the realm is in scope.
            if (false == (instProto.hasProto())) {
                instProto.setProto((this.builtinPrototype("Object")))
            }
            if (false == (instProto.hasOwnData("constructor"))) {
                instProto.setMember("constructor" fnV)
                instProto.setAttrs("constructor" true false true)
            }
        }
        def fnNode:TSNode (fnV.functionNodeOf())
        ; D-FNPROTO: constructing through a BOUND function runs the target with
        ; the fixed arguments in front -- `new (f.bind(null, "a"))("b")` calls
        ; f("a", "b"). The bound `this` is ignored, as the spec says, because
        ; construction supplies its own.
        if ((fnV.boundArgCount()) > 0) {
            def ctorVals:[EvHandle]
            def bi:int 0
            while (bi < (fnV.boundArgCount())) {
                push ctorVals (fnV.boundArgAt(bi))
                bi = (bi + 1)
            }
            def ci:int 0
            while (ci < (array_length argNodes)) {
                push ctorVals (this.evaluateExpr((itemAt argNodes ci)))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                ci = (ci + 1)
            }
            pendingNewTarget = fnV
            hasPendingNewTarget = true
            def boundRet:EvHandle (this.callUserFunctionValues(fnNode ctorVals inst))
            if (this.isDescriptorObject(boundRet)) {
                return boundRet
            }
            return inst
        }
        ; D-NEWTARGET: `new F()` makes F the frame's new.target.
        pendingNewTarget = fnV
        hasPendingNewTarget = true
        def ret:EvHandle (this.callUserFunctionNode(fnNode argNodes inst true))
        ; A constructor that RETURNS an object yields that object, and a
        ; function, array, Map or Set is an object too -- only a primitive (or
        ; nothing) leaves the fresh instance standing. Testing for valueType 5
        ; alone threw away a returned function, which is precisely what
        ; `function F() { return function g() {}; }` is written to check.
        if (this.isDescriptorObject(ret)) {
            return ret
        }
        return inst
    }

    ; Construct-time call with already-evaluated arguments. A plain function
    ; value with the node and `this` supplied, which is what the bound path
    ; needs -- callUserFunctionNode evaluates AST arguments it does not have.
    fn callUserFunctionValues:EvHandle (fnNode:TSNode argVals:[EvHandle] thisVal:EvHandle) {
        def fv:EvHandle (EvValueBridge.taggedFunction(fnNode))
        this.stampSrcOn(fv)
        fv.setStrictFn((this.strictForBody(fnNode)))
        fv.setBoundThis(thisVal)
        return (this.callFnValueWithValues(fv argVals))
    }

    fn callUserFunctionNode:EvHandle (fnNode:TSNode argNodes:[TSNode] thisVal:EvHandle hasThis:boolean) {
        def savedContext:EvalContext context
        def savedDidReturn:boolean scriptDidReturn
        def savedReturnValue:EvHandle scriptReturnValue
        def savedModule:string currentModule
        scriptDidReturn = false
        scriptReturnValue = (EvValueBridge.taggedNull())
        ; Evaluate arg expressions (expanding ...spread) IN THE CALLER'S CONTEXT
        ; — an argument like `this.atlas` must see the caller's `this`, not the
        ; callee's. Only then create the call scope and bind `this`.
        def argVals:[EvHandle]
        def i 0
        while (i < (array_length argNodes)) {
            def an:TSNode (itemAt argNodes i)
            if ((this.nodeKindOf(an)) == 47) {
                def sv:EvHandle (EvValueBridge.taggedNull())
                if an.left {
                    sv = (this.evaluateExpr((unwrap an.left)))
                }
                if (sv.isArrayValue()) {
                    def k:int 0
                    while (k < (sv.denseLen())) {
                        push argVals (sv.arrayItemAt(k))
                        k = (k + 1)
                    }
                }
            } {
                push argVals (this.evaluateExpr(an))
            }
            ; A throw while evaluating an ARGUMENT aborts the call -- the callee
            ; never runs. Carrying on entered the function with a half-built
            ; argument list and swallowed the exception the argument raised.
            if scriptThrew {
                scriptDidReturn = savedDidReturn
                scriptReturnValue = savedReturnValue
                return (EvValueBridge.taggedUndefined())
            }
            i = (i + 1)
        }
        ; Root the call scope lexically at the DEFINING module (D-MODULES scope
        ; isolation): a method on a module-owned instance runs rooted in that
        ; module's scope (its module-level state, never the caller's chain); an
        ; entry-realm method invoked FROM module code roots at the entry module
        ; scope. Pure entry→entry calls keep the legacy caller-chain parent.
        def parentScope:EvalContext context
        def homeTag:string ""
        def tagged:boolean false
        if hasThis {
            homeTag = (this.instanceModuleTag(thisVal))
            if ((strlen homeTag) > 0) {
                tagged = true
            }
        }
        if tagged {
            parentScope = (this.moduleScopeFor(homeTag))
            currentModule = homeTag
        } {
            if ((strlen currentModule) > 0) {
                parentScope = moduleScope
            }
            currentModule = ""
        }
        ; Pooled frame: closureScopes length is the capture gate (see ctxPool).
        def framePoolMark:int (array_length closureScopes)
        context = (this.acquireFrame((unwrap parentScope)))
        def myFrame:EvalContext context
        if hasThis {
            ; PERF: same gate as the value path -- a body that cannot observe
            ; `this` does not pay the insert.
            if (this.fnNeedsThis(fnNode)) {
                context.define("this" thisVal)
            }
        }
        this.bindParams(fnNode argVals)
        ; D-SUPERCALL: a call that binds its OWN `this` leaves the derived
        ; constructor's uninitialised-this state behind; an arrow shares it.
        def savedDerivedP:boolean derivedCtorPending
        if pendingDerivedCtor {
            derivedCtorPending = true
            pendingDerivedCtor = false
        } {
            if ((this.nodeKindOf(fnNode)) != 17) {
                derivedCtorPending = false
            }
        }
        ; D-NEWTARGET: this frame's [[NewTarget]] -- whatever a construct site
        ; parked, or undefined for an ordinary call. Consumed here so the next
        ; call does not inherit it.
        def savedNewTarget:EvHandle currentNewTarget
        if hasPendingNewTarget {
            currentNewTarget = pendingNewTarget
            hasPendingNewTarget = false
        } {
            currentNewTarget = (EvValueBridge.taggedUndefined())
        }
        ; D-STRICT: same rule on the node-call path.
        def savedStrict:boolean strictMode
        strictMode = (this.strictForBody(fnNode))
        callDepth = (callDepth + 1)
        ; D-GENRESUME: a generator METHOD -- `{ *m(){} }`, `class C { *g(){} }`
        ; -- builds a generator object exactly as `function*` does. Only the
        ; value path knew about generators, so a generator method ran its body
        ; and answered undefined; the whole shape was missing.
        ; D-ASYNC: an async function or METHOD on this path too. A direct
        ; `f()` comes through here rather than through the value path, so
        ; teaching only the other one left plain `async function f(){}`
        ; returning its value raw.
        if fnNode.async {
            if (false == fnNode.generator) {
                if true {
                    def asyncCtxN@(optional):EvalContext context
                    def asyncResN:EvHandle (this.callAsyncBody(fnNode (unwrap asyncCtxN)))
                    strictMode = savedStrict
                    currentNewTarget = savedNewTarget
                    derivedCtorPending = savedDerivedP
                    callDepth = (callDepth - 1)
                    context = savedContext
                    currentModule = savedModule
                    scriptDidReturn = savedDidReturn
                    scriptReturnValue = savedReturnValue
                    return asyncResN
                }
            }
        }
        if fnNode.generator {
            if (this.genBodyResumable(fnNode)) {
                def genCtxN@(optional):EvalContext context
                def genvN:EvHandle (this.makeResumableGenerator(fnNode (unwrap genCtxN)))
                strictMode = savedStrict
                callDepth = (callDepth - 1)
                context = savedContext
                currentModule = savedModule
                scriptDidReturn = savedDidReturn
                scriptReturnValue = savedReturnValue
                return genvN
            }
        }
        def savedGenCollectN:[EvHandle] genCollect
        def savedGenDepthN:int genDepth
        if fnNode.generator {
            def freshCollectN:[EvHandle]
            genCollect = freshCollectN
            genDepth = (genDepth + 1)
        }
        def body:TSNode (this.getFunctionBody(fnNode))
        def result:EvHandle (this.callResultOf((this.evaluateFunctionBodyValue(body))))
        if fnNode.generator {
            def producedN:[EvHandle] genCollect
            genCollect = savedGenCollectN
            genDepth = savedGenDepthN
            result = (this.makeGeneratorValue(producedN))
        }
        strictMode = savedStrict
        currentNewTarget = savedNewTarget
        derivedCtorPending = savedDerivedP
        callDepth = (callDepth - 1)
        context = savedContext
        currentModule = savedModule
        scriptDidReturn = savedDidReturn
        scriptReturnValue = savedReturnValue
        if ((array_length closureScopes) == framePoolMark) {
            this.releaseFrame((unwrap myFrame))
        }
        return result
    }

    ; Evaluate `new ClassName(args)` -> an instance object with initialised fields
    ; and its constructor run.
    ;
    ; Class resolution is module-scoped (D-MODULES):
    ;   `new NS.Class()`   — NS is an imported module namespace: the class comes
    ;                        from THAT module's class table (member-new).
    ;   `new Class()`      — resolves in the CURRENT module's table when module
    ;                        code is executing, else the entry-realm map. Module
    ;                        classes are never reachable bare from the entry
    ;                        script: importing the namespace is the only door.
    ; Instances are stamped with their class's home module so method dispatch
    ; and scope rooting stay with the defining module for the object's lifetime.
    fn evaluateNewExpr:EvHandle (node:TSNode) {
        def className:string ""
        def nsModule:string ""
        def viaNamespace:boolean false
        if node.left {
            def callee:TSNode (unwrap node.left)
            className = callee.name
            if ((this.nodeKindOf(callee)) == 3) {
                if callee.left {
                    def baseNode:TSNode (unwrap callee.left)
                    def baseV:EvHandle (this.evaluateExpr(baseNode))
                    if (baseV.isObject()) {
                        def tagV@(optional):EvHandle (baseV.tryOwnData("__nsmodule__"))
                        if tagV {
                            def tag:EvHandle (unwrap tagV)
                            if (tag.isString()) {

                }
            }

            ; Callee is itself an expression that yields a function value, e.g.
            ; an IIFE `(() => ({...}))()` or `(cond ? a : b)()`. Inline arrow/
            ; function expressions capture the current scope; anything else is
            ; evaluated. MemberExpression/Identifier callees are handled above.
            def calleeFn:EvalValue (this.resolveCallbackValue(callee))
            ; D-REGISTRY: same for a built-in reached through an expression
            ; callee, e.g. `(cond ? a.slice : b.slice)(...)`.
            if (calleeFn.isBuiltinMethod()) {
                def bArgs1:[EvalValue] (this.collectCallArgs(node))
                return (this.callFnValueWithValues(calleeFn bArgs1))
            }
            if (this.isEvalFunctionValue(calleeFn)) {
                def ieArgs1:[EvalValue] (this.collectCallArgs(node))
                if scriptThrew {
                    return (EvalValue.undefined())
                }
                return (this.runIndirectEval(ieArgs1))
            }
            if (calleeFn.isFunction()) {
                if calleeFn.functionNode {
                    def calleeArgs:[EvalValue] (this.collectCallArgs(node))
                    return (this.callFnValueWithValues(calleeFn calleeArgs))
                }
                ; D-CTORVALUE: a built-in CONSTRUCTOR held as a value has no
                ; function node but is perfectly callable -- `var f = Number;
                ; f(42)` and `Number.bind(null)(42)` both arrive here.
                if (has calleeFn.objectMap "__fnprotocall__") {
                    def _fpArgs:[EvalValue] (this.collectCallArgs(node))
                    return (EvalValue.undefined())
                }
                def ctorNm:string (this.builtinCtorNameOf(calleeFn))
                if ((strlen ctorNm) > 0) {
                    def ctorArgs:[EvalValue] (this.collectCallArgs(node))
                    if scriptThrew {
                        return (EvalValue.undefined())
                    }
                    def merged2:[EvalValue]
                    def mi:int 0
                    while (mi < (array_length calleeFn.boundArgs)) {
                        push merged2 (itemAt calleeFn.boundArgs mi)
                        mi = (mi + 1)
                    }
                    def mj:int 0
                    while (mj < (array_length ctorArgs)) {
                        push merged2 (itemAt ctorArgs mj)
                        mj = (mj + 1)
                    }
                    return (this.callBuiltinCtorValues(ctorNm merged2 false))
                }
            }

            ; D-ERRORS: nothing callable was found. Per spec this is a
            ; ReferenceError when the name resolves to nothing at all, and a
            ; TypeError when it resolves to a value that is not callable.
            ; Falling through to null here is what let entire test corpora pass
            ; vacuously: every call to an unimplemented global quietly did
            ; nothing and the assertion after it never ran.
            if strictReferences {
                if ((this.nodeKindOf(callee)) == 1) {
                    def cName:string callee.name
                    if (false == (this.isCallableName(cName))) {
                        if (this.nameResolves(cName)) {
                            return (this.throwSpecError("TypeError" (cName + " is not a function")))
                        }
                        return (this.throwSpecError("ReferenceError" (cName + " is not defined")))
                    }
                }
                ; A callee that is not a name or a member expression at all --
                ; `true()`, `1()`, `null()`, `new Number(1)()` -- is a TypeError
                ; too. It fell through to null, so the call did nothing.
                def litCallee:boolean false
                if ((this.nodeKindOf(callee)) == 20) { litCallee = true }
                if ((this.nodeKindOf(callee)) == 2) { litCallee = true }
                if ((this.nodeKindOf(callee)) == 8) { litCallee = true }
                if ((this.nodeKindOf(callee)) == 9) { litCallee = true }
                if ((this.nodeKindOf(callee)) == 10) { litCallee = true }
                if ((this.nodeKindOf(callee)) == 16) { litCallee = true }
                if ((this.nodeKindOf(callee)) == 15) { litCallee = true }
                if ((this.nodeKindOf(callee)) == 14) { litCallee = true }
                ; A REGEXP is not callable: `/[^a]*/()` is a TypeError. The node
                ; type was missing from this list, so the call fell through to
                ; null and did nothing at all.
                if ((this.nodeKindOf(callee)) == 21) { litCallee = true }
                ; A callee that is itself a CALL -- `String("a")()` -- has to be
                ; evaluated to know: `f()()` is legal when the inner call
                ; returns a function.
                if ((this.nodeKindOf(callee)) == 4) {
                    def innerV:EvalValue (this.evaluateExpr(callee))
                    if scriptThrew {
                        return (EvalValue.undefined())
                    }
                    if (innerV.valueType == 6) {
                        def innerArgs:[EvalValue] (this.collectCallArgs(node))
                        return (this.callFnValueWithValues(innerV innerArgs))
                    }
                    litCallee = true
                }
                if litCallee {
                    def litArgs:[EvalValue] (this.collectCallArgs(node))
                    if scriptThrew {
                        return (EvalValue.undefined())
                    }
                    return (this.throwSpecError("TypeError" "expression is not a function"))
                }
                ; The same for `o.missing(...)`. The ARGUMENTS are evaluated
                ; first, per spec -- the callability check comes after -- so a
                ; call like `o.bar(foo())` must still run foo() before it
                ; throws. Falling through to null skipped both.
                if ((this.nodeKindOf(callee)) == 3) {
                    def missArgs:[EvalValue] (this.collectCallArgs(node))
                    if scriptThrew {
                        return (EvalValue.undefined())
                    }
                    def missName:string callee.name
                    if ((strlen missName) == 0) {
                        missName = "expression"
                    }
                    return (this.throwSpecError("TypeError" (missName + " is not a function")))
                }
            }
        }

        return (EvalValue.null())
    }

    ; Whether a bare name resolves to anything at all (a binding, an engine
    ; global, or an error constructor). Used to pick ReferenceError vs TypeError.
    fn nameResolves:boolean (name:string) {
        if (context.has(name)) {
            return true
        }
        this.ensureErrorCtors()
        if (hostScope.has(name)) {
            return true
        }
        return (this.isEngineGlobalName(name))
    }

    ; Names the engine dispatches as calls without a binding (built-in globals
    ; handled earlier in evaluateCallExpr). Reaching the fallback with one of
    ; these means the engine chose not to handle that particular call, which is
    ; not the guest's error, so it stays silent.
    fn isCallableName:boolean (name:string) {
        if (this.isSizedTypeName(name)) { return true }
        if (name == "parseInt") { return true }
        if (name == "parseFloat") { return true }
        if (name == "isNaN") { return true }
        if (name == "isFinite") { return true }
        if (name == "String") { return true }
        if (name == "Number") { return true }
        if (name == "Boolean") { return true }
        if (name == "Array") { return true }
        if (name == "Object") { return true }
        if (name == "require") { return true }
        if (name == "super") { return true }
        return false
    }
    
    fn evaluateBinaryExpr:EvalValue (node:TSNode) {
        def op:string node.value
        def opK:int (this.opKindOf(node))
        
        ; Logical operators with short-circuit evaluation
        if (opK == 34) {
            if node.left {
                def leftExpr:TSNode (unwrap node.left)
                def left:EvalValue (this.evaluateExpr(leftExpr))
                if ((left.toBool()) == false) {
                    return left
                }
                if node.right {
                    def rightExpr:TSNode (unwrap node.right)
                    return (this.evaluateExpr(rightExpr))
                }
            }
        }
        
        if (opK == 35) {
            if node.left {
                def leftExpr:TSNode (unwrap node.left)
                def left:EvalValue (this.evaluateExpr(leftExpr))
                if (left.toBool()) {
                    return left
                }
                if node.right {
                    def rightExpr:TSNode (unwrap node.right)
                    return (this.evaluateExpr(rightExpr))
                }
            }
        }

        if (opK == 36) {
            if node.left {
                def leftExpr:TSNode (unwrap node.left)
                def left:EvalValue (this.evaluateExpr(leftExpr))
                ; nullish: fall through to the right only when left is null OR
                ; undefined (a missing member now reads as undefined — rule 6).
                if (false == ((left.isNull()) || (left.isUndefined()))) {
                    return left
                }
                if node.right {
                    def rightExpr:TSNode (unwrap node.right)
                    return (this.evaluateExpr(rightExpr))
                }
            }
        }
        
        ; instanceof: right side is a class NAME, not a value — compare against the
        ; instance's __class__ tag (no inheritance chain in this interpreter).
        if (opK == 44) {
            if node.left {
                def lv:EvalValue (this.evaluateExpr((unwrap node.left)))
                def cname:string ""
                if node.right {
                    def rn:TSNode (unwrap node.right)
                    cname = rn.name
                }
                ; D-INSTANCEOF: the built-in constructors. `[] instanceof Array`,
                ; `({}) instanceof Object` and `f instanceof Function` were all
                ; false, because the check below only knows about `__class__`
                ; tags and `constructor` identity -- neither of which a literal
                ; carries. These are the shapes the suite tests with constantly.
                ; The right operand must be an object. `true instanceof true`
                ; is a TypeError, not a quiet false.
                if node.right {
                    def instRight:TSNode (unwrap node.right)
                    def irKind:string instRight.nodeType
                    def irBad:boolean false
                    if (irKind == "NumericLiteral") { irBad = true }
                    if (irKind == "StringLiteral") { irBad = true }
                    if (irKind == "BooleanLiteral") { irBad = true }
                    if (irKind == "NullLiteral") { irBad = true }
                    if irBad {

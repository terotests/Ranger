                    if (scriptDidReturn || (scriptThrew || loopBreak)) {
                        gOn = false
                        gClose = true
                    } {
                        loopContinue = false
                        def gRes:EvHandle (this.iteratorInvoke(gIter gNext (EvValueBridge.taggedUndefined())))
                        if scriptThrew {
                            gOn = false

                    ; are all malformed.
                    if (cp > 1114111) {
                        return (this.throwSpecError("URIError" "URI malformed"))
                    }
                    if ((cp >= 55296) && (cp <= 57343)) {
                        return (this.throwSpecError("URIError" "URI malformed"))
                    }
                    if (extra == 1) {
                        if (cp < 128) {
                            return (this.throwSpecError("URIError" "URI malformed"))
                        }
                    }
                    if (extra == 2) {
                        if (cp < 2048) {
                            return (this.throwSpecError("URIError" "URI malformed"))
                        }
                    }
                    if (extra == 3) {
                        if (cp < 65536) {
                            return (this.throwSpecError("URIError" "URI malformed"))
                        }
                    }
                    if bytesModel {
                        ; The result string is itself UTF-8, so the decoded
                        ; bytes go back in exactly as they came.
                        def bi:int 0
                        while (bi < (strlen seq)) {
                            def sc:int (bit_and (charAt seq bi) 255)
                            if (sc == 37) {
                                def hv:int (this.hexValueOf(seq (bi + 1) 2))
                                out = (out + (strfromcode hv))
                                bi = (bi + 3)
                            } {
                                bi = (bi + 1)
                            }
                        }
                    } {
                        if (cp > 65535) {
                            def adj:int (cp - 65536)
                            out = (out + (strfromcode (55296 + (bit_shr adj 10))))
                            out = (out + (strfromcode (56320 + (bit_and adj 1023))))
                        } {
                            out = (out + (strfromcode cp))
                        }
                    }
                    i = at
                }
            }
        }
        return (EvValueBridge.taggedString(out))
    }

    fn isUriGlobalName:boolean (name:string) {
        if (name == "encodeURI") { return true }
        if (name == "encodeURIComponent") { return true }
        if (name == "decodeURI") { return true }
        if (name == "decodeURIComponent") { return true }
        return false
    }

    fn callUriGlobal:EvHandle (name:string args:[EvHandle]) {
        def a0:string "undefined"
        if ((array_length args) > 0) {
            a0 = (this.toStringOf((itemAt args 0)))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
        }
        if (name == "encodeURI") {
            return (this.uriEncode(a0 true))
        }
        if (name == "encodeURIComponent") {
            return (this.uriEncode(a0 false))
        }
        if (name == "decodeURI") {
            return (this.uriDecode(a0 true))
        }
        return (this.uriDecode(a0 false))
    }

    ; ---- §18.2.5 parseInt / §18.2.4 parseFloat ---------------------------
    ; D-PARSEINT: both were ToNumber in disguise. parseInt ignored its RADIX
    ; entirely -- `parseInt("1F", 16)` answered 0 and `parseInt("10", 2)`
    ; answered 10 -- and neither stopped at the first character it could not
    ; use, so `parseInt("42abc")` and `parseFloat("3.14abc")` were both NaN
    ; rather than 42 and 3.14.
    fn parseIntOf:double (input:string radixIn:int) {
        def n:int (strlen input)
        def i:int 0
        ; StrWhiteSpace: leading whitespace is skipped, and everything from the
        ; first unusable character on is ignored.
        def scanning:boolean true
        while (scanning && (i < n)) {
            def wc2:int (bit_and (charAt input i) 255)
            def isWs2:boolean false
            if (wc2 == 32) { isWs2 = true }
            if (wc2 == 9) { isWs2 = true }
            if (wc2 == 10) { isWs2 = true }
            if (wc2 == 13) { isWs2 = true }
            if (wc2 == 11) { isWs2 = true }
            if (wc2 == 12) { isWs2 = true }
            if isWs2 { i = (i + 1) } { scanning = false }
        }
        def sign:double 1.0
        if (i < n) {
            def sc:int (bit_and (charAt input i) 255)
            if (sc == 45) {
                sign = (0.0 - 1.0)
                i = (i + 1)
            } {
                if (sc == 43) {
                    i = (i + 1)
                }
            }
        }
        def radix:int radixIn
        def stripPrefix:boolean false
        if (radix == 0) {
            radix = 10
            stripPrefix = true
        } {
            if (radix == 16) {
                stripPrefix = true
            } {
                ; A radix outside 2..36 -- 1 and 37 among them -- is NaN.
                if ((radix < 2) || (radix > 36)) {
                    return (0.0 / 0.0)
                }
            }
        }
        if stripPrefix {
            if ((i + 1) < n) {
                if ((bit_and (charAt input i) 255) == 48) {
                    def xc:int (bit_and (charAt input (i + 1)) 255)
                    if ((xc == 120) || (xc == 88)) {
                        i = (i + 2)
                        radix = 16
                    }
                }
            }
        }
        def acc:double 0.0
        def any:boolean false
        def running:boolean true
        while (running && (i < n)) {
            def c:int (bit_and (charAt input i) 255)
            def dv:int (0 - 1)
            if ((c >= 48) && (c <= 57)) { dv = (c - 48) }
            if ((c >= 97) && (c <= 122)) { dv = ((c - 97) + 10) }
            if ((c >= 65) && (c <= 90)) { dv = ((c - 65) + 10) }
            if (dv < 0) {
                running = false
            } {
                if (dv >= radix) {
                    running = false
                } {
                    acc = ((acc * (to_double radix)) + (to_double dv))
                    any = true
                    i = (i + 1)
                }
            }
        }
        if (false == any) {
            return (0.0 / 0.0)
        }
        return (sign * acc)
    }

    ; parseFloat: the longest StrDecimalLiteral prefix, which is NOT the same
    ; grammar ToNumber uses -- `parseFloat("0x10")` is 0, because the prefix it
    ; can read is just "0".
    fn parseFloatOf:double (input:string) {
        def n:int (strlen input)
        def i:int 0
        def scanning:boolean true
        while (scanning && (i < n)) {
            def wc:int (bit_and (charAt input i) 255)
            def isWs:boolean false
            if (wc == 32) { isWs = true }
            if (wc == 9) { isWs = true }
            if (wc == 10) { isWs = true }
            if (wc == 13) { isWs = true }
            if (wc == 11) { isWs = true }
            if (wc == 12) { isWs = true }
            if isWs { i = (i + 1) } { scanning = false }
        }
        def start:int i
        if (i < n) {
            def sc:int (bit_and (charAt input i) 255)
            if ((sc == 45) || (sc == 43)) {
                i = (i + 1)
            }
        }
        ; Infinity is part of the grammar, with the sign already consumed.
        if ((i + 8) <= n) {
            if ((substring input i (i + 8)) == "Infinity") {
                if ((bit_and (charAt input start) 255) == 45) {
                    return (0.0 - (1.0 / 0.0))
                }
                return (1.0 / 0.0)
            }
        }
        def digitsBefore:int 0
        def scanInt:boolean true
        while (scanInt && (i < n)) {
            def c2:int (bit_and (charAt input i) 255)
            if ((c2 >= 48) && (c2 <= 57)) {
                digitsBefore = (digitsBefore + 1)
                i = (i + 1)
            } {
                scanInt = false
            }
        }
        def digitsAfter:int 0
        if (i < n) {
            if ((bit_and (charAt input i) 255) == 46) {
                def dotAt:int i
                i = (i + 1)
                def scanFrac:boolean true
                while (scanFrac && (i < n)) {
                    def c3:int (bit_and (charAt input i) 255)
                    if ((c3 >= 48) && (c3 <= 57)) {
                        digitsAfter = (digitsAfter + 1)
                        i = (i + 1)
                    } {
                        scanFrac = false
                    }
                }
                ; A lone "." with no digits on either side is not a literal.
                if ((digitsBefore + digitsAfter) == 0) {
                    i = dotAt
                }
            }
        }
        if ((digitsBefore + digitsAfter) == 0) {
            return (0.0 / 0.0)
        }
        ; An exponent counts only when it carries at least one digit.
        if (i < n) {
            def ec:int (bit_and (charAt input i) 255)
            if ((ec == 101) || (ec == 69)) {
                def expStart:int i
                def j:int (i + 1)
                if (j < n) {
                    def es:int (bit_and (charAt input j) 255)
                    if ((es == 45) || (es == 43)) {
                        j = (j + 1)
                    }
                }
                def expDigits:int 0
                def scanExp:boolean true
                while (scanExp && (j < n)) {
                    def c4:int (bit_and (charAt input j) 255)
                    if ((c4 >= 48) && (c4 <= 57)) {
                        expDigits = (expDigits + 1)
                        j = (j + 1)
                    } {
                        scanExp = false
                    }
                }
                if (expDigits > 0) {
                    i = j
                } {
                    i = expStart
                }
            }
        }
        def lit:string (substring input start i)
        return (this.stringToNumber(lit))
    }

    fn callParseGlobal:EvHandle (name:string args:[EvHandle]) {
        def a0:string ""
        if ((array_length args) > 0) {
            a0 = (this.toStringOf((itemAt args 0)))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
        } {
            a0 = "undefined"
        }
        if (name == "parseFloat") {
            return (EvValueBridge.taggedNumber((this.parseFloatOf(a0))))
        }
        def radix:int 0
        if ((array_length args) > 1) {
            radix = (this.toInt32Of((itemAt args 1)))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
        }
        return (EvValueBridge.taggedNumber((this.parseIntOf(a0 radix))))
    }

    ; D-TRIM: the JS WhiteSpace + LineTerminator set, §11.2 and §11.3.
    ; Worked in CODE POINTS rather than in units: `strlen` and `charAt` index
    ; BYTES on the native targets while `substring` indexes code points, so
    ; mixing the two cuts a multi-byte character in half. `at` walks code
    ; points on every target, which is the one view both ends agree on.
    fn isJsSpaceChar:boolean (ch:string) {
        def n:int (strlen ch)
        if (n == 0) { return false }
        def cp:int (this.charCodePointOf(ch))
        if (cp == 9) { return true }
        if (cp == 10) { return true }
        if (cp == 11) { return true }
        if (cp == 12) { return true }
        if (cp == 13) { return true }
        if (cp == 32) { return true }
        if (cp == 160) { return true }      ; NO-BREAK SPACE
        if (cp == 5760) { return true }     ; OGHAM SPACE MARK
        if ((cp >= 8192) && (cp <= 8202)) { return true } ; EN QUAD .. HAIR SPACE
        if (cp == 8232) { return true }     ; LINE SEPARATOR
        if (cp == 8233) { return true }     ; PARAGRAPH SEPARATOR
        if (cp == 8239) { return true }     ; NARROW NO-BREAK SPACE
        if (cp == 8287) { return true }     ; MEDIUM MATHEMATICAL SPACE
        if (cp == 12288) { return true }    ; IDEOGRAPHIC SPACE
        if (cp == 65279) { return true }    ; ZERO WIDTH NO-BREAK SPACE
        return false
    }

    ; The code point a one-character string stands for. On the char-model
    ; targets that is its first unit; on the byte-model target `at` hands back
    ; the character's UTF-8 bytes, which have to be decoded.
    fn charCodePointOf:int (ch:string) {
        def n:int (strlen ch)
        if (n == 0) { return -1 }
        def b0:int (bit_and (charAt ch 0) 255)
        if (n == 2) {
            if ((b0 >= 194) && (b0 <= 223)) {
                def c1:int (bit_and (charAt ch 1) 255)
                if ((c1 >= 128) && (c1 <= 191)) {
                    return (((bit_and b0 31) * 64) + (bit_and c1 63))
                }
            }
        }
        if (n == 3) {
            if ((b0 >= 224) && (b0 <= 239)) {
                def d1:int (bit_and (charAt ch 1) 255)
                def d2:int (bit_and (charAt ch 2) 255)
                if ((d1 >= 128) && (d1 <= 191)) {
                    if ((d2 >= 128) && (d2 <= 191)) {
                        return ((((bit_and b0 15) * 4096) + ((bit_and d1 63) * 64)) + (bit_and d2 63))
                    }
                }
            }
        }
        return (bit_and (charAt ch 0) 65535)
    }

    fn trimJs:string (s:string fromStart:boolean fromEnd:boolean) {
        def chars:[string]
        def i:int 0
        def bound:int (strlen s)
        def walking:boolean true
        while (walking && (i < bound)) {
            def c:string (at s i)
            if ((strlen c) == 0) {
                walking = false
            } {
                push chars c
                i = (i + 1)
            }
        }
        def n:int (array_length chars)
        def lo:int 0
        if fromStart {
            def goL:boolean true
            while (goL && (lo < n)) {
                if (this.isJsSpaceChar((itemAt chars lo))) {
                    lo = (lo + 1)
                } {
                    goL = false
                }
            }
        }
        def hi:int n
        if fromEnd {
            def goR:boolean true
            while (goR && (hi > lo)) {
                if (this.isJsSpaceChar((itemAt chars (hi - 1)))) {
                    hi = (hi - 1)
                } {
                    goR = false
                }
            }
        }
        def out:string ""
        def k:int lo
        while (k < hi) {
            out = (out + (itemAt chars k))
            k = (k + 1)
        }
        return out
    }



    ; ==========================================================================
    ; D-CASE: Unicode case conversion.
    ; --------------------------------------------------------------------------
    ; toUpperCase/toLowerCase used to be the host language's own case function,
    ; and the three targets do not agree about it: es6 and Rust apply the
    ; Unicode rules, C++ toupper is ASCII-only. So 'café'.toUpperCase() came
    ; back 'CAFÉ' on two builds and 'CAFé' on the third -- the same guest
    ; program meaning different things depending on where it ran, which is
    ; worse than any single wrong answer. It is done here now, once, so all
    ; three agree.
    ;
    ; Case conversion is not a rule but DATA, and the data is in UnicodeCase.rgr
    ; (generated, see the tools/ script named at its head). Two things in it are
    ; not one-code-point-to-one: ß uppercases to SS, and Greek capital sigma
    ; lowercases to ς or σ depending on what surrounds it.
    fn ensureCaseTables:void () {
        if caseTablesLoaded { return }
        caseUpRuns = (UnicodeCase.upperRuns())
        caseUpMulti = (UnicodeCase.upperMulti())
        caseLoRuns = (UnicodeCase.lowerRuns())
        caseLoMulti = (UnicodeCase.lowerMulti())
        caseCasedRanges = (UnicodeCase.casedRanges())
        caseIgnRanges = (UnicodeCase.ignorableRanges())
        caseTablesLoaded = true
    }

    ; The delta for `cp` in a run table, or 0 for "no mapping" -- a safe
    ; sentinel, because a run only exists where the mapping differs.
    fn caseRunDelta:int (runs:[int] cp:int) {
        def quads:int (bit_shr (array_length runs) 2)
        def lo:int 0
        def hi:int (quads - 1)
        while (lo <= hi) {
            def mid:int (bit_shr (lo + hi) 1)
            def base:int (mid * 4)
            def a:int (itemAt runs base)
            def b:int (itemAt runs (base + 1))
            if (cp < a) {
                hi = (mid - 1)
            } {
                if (cp > b) {
                    lo = (mid + 1)
                } {
                    def step:int (itemAt runs (base + 2))
                    if (step == 1) {
                        return (itemAt runs (base + 3))
                    }
                    ; A step-2 run covers every OTHER code point in its span:
                    ; the odd ones in between are the uppercase halves of the
                    ; same pairs and must not be mapped again.
                    if ((bit_and (cp - a) 1) == 0) {
                        return (itemAt runs (base + 3))
                    }
                    return 0
                }
            }
        }
        return 0
    }

    ; Membership in a table of inclusive (start, end) pairs.
    fn caseInRanges:boolean (ranges:[int] cp:int) {
        def pairs:int (bit_shr (array_length ranges) 1)
        def lo:int 0
        def hi:int (pairs - 1)
        while (lo <= hi) {
            def mid:int (bit_shr (lo + hi) 1)
            def base:int (mid * 2)
            def a:int (itemAt ranges base)
            def b:int (itemAt ranges (base + 1))
            if (cp < a) {
                hi = (mid - 1)
            } {
                if (cp > b) {
                    lo = (mid + 1)
                } {
                    return true
                }
            }
        }
        return false
    }

    ; The multi-code-point mapping for `cp`, from a table laid out as
    ; (codepoint, count, points...) end to end. Empty when there is none.
    ; A hundred code points have one, on a path that is already the slow one,
    ; so a linear scan is not worth indexing.
    fn caseMultiFor:[int] (table:[int] cp:int) {
        def out:[int]
        def n:int (array_length table)
        def i:int 0
        while (i < n) {
            def c:int (itemAt table i)
            def cnt:int (itemAt table (i + 1))
            if (c == cp) {
                def k:int 0
                while (k < cnt) {
                    push out (itemAt table ((i + 2) + k))
                    k = (k + 1)
                }
                return out
            }
            i = ((i + 2) + cnt)
        }
        return out
    }

    ; A string's code POINTS, decoded the way this target stores them. Built in
    ; one pass rather than through cuUnitAt, which restarts its walk on every
    ; call and would make casing quadratic in the length of the string.
    fn codePointsOf:[int] (s:string) {
        def out:[int]
        def n:int (strlen s)
        if (this.unitsArePoints()) {
            def p:int 0
            while (p < n) {
                push out (charAt s p)
                p = (p + 1)
            }
            return out
        }
        if (this.unitsAreBytes()) {
            def i:int 0
            while (i < n) {
                def dec:[int] (this.cuDecodeAt(s i))
                def w:int (itemAt dec 1)
                if (w == 0) {
                    i = n
                } {
                    def cp:int (itemAt dec 0)
                    def step:int w
                    ; A surrogate PAIR arrives here as two separately encoded
                    ; halves -- that is how a string built from \uD835\uDCA2
                    ; is stored -- and each half on its own is not a character.
                    ; Leaving them apart made the Final_Sigma test read the
                    ; high half as "not a cased letter" and lowercase Σ to σ
                    ; where it should be ς.
                    if ((cp >= 55296) && (cp <= 56319)) {
                        def nxt:[int] (this.cuDecodeAt(s (i + w)))
                        def lo3:int (itemAt nxt 0)
                        if ((lo3 >= 56320) && (lo3 <= 57343)) {
                            cp = ((65536 + ((cp - 55296) * 1024)) + (lo3 - 56320))
                            step = (w + (itemAt nxt 1))
                        }
                    }
                    push out cp
                    i = (i + step)
                }
            }
            return out
        }
        def u:int 0
        while (u < n) {
            def c:int (bit_and (charAt s u) 65535)
            def took:int 1
            if ((c >= 55296) && (c <= 56319)) {
                if ((u + 1) < n) {
                    def lo2:int (bit_and (charAt s (u + 1)) 65535)
                    if ((lo2 >= 56320) && (lo2 <= 57343)) {
                        push out ((65536 + ((c - 55296) * 1024)) + (lo2 - 56320))
                        took = 2
                    }
                }
            }
            if (took == 1) {
                push out c
            }
            u = (u + took)
        }
        return out
    }

    ; One code point as text. Unlike encodeCodePointUtf8 this is right for the
    ; supplementary range on the UNIT model too, where the character has to be
    ; spelled as a surrogate pair.
    ; Two lowercase hex digits, for the \xNN escapes RegExp.escape emits. A code
    ; point past 0xFF is written as \uNNNN instead, which the caller asks for by
    ; the width it gets back.
    fn hexPair:string (cp:int) {
        def digits:string "0123456789abcdef"
        if (cp > 255) {
            def h3:int (bit_and (bit_shr cp 12) 15)
            def h2:int (bit_and (bit_shr cp 8) 15)
            def h1:int (bit_and (bit_shr cp 4) 15)
            def h0:int (bit_and cp 15)
            return ("u" + ((substring digits h3 (h3 + 1)) + ((substring digits h2 (h2 + 1)) + ((substring digits h1 (h1 + 1)) + (substring digits h0 (h0 + 1))))))
        }
        def hi:int (bit_and (bit_shr cp 4) 15)
        def lo:int (bit_and cp 15)
        return ((substring digits hi (hi + 1)) + (substring digits lo (lo + 1)))
    }

    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn cuFromCodePoint:string (cp:int) {
        return (RgText.fromCodePoint(cp))
    }

    ; The Final_Sigma condition of SpecialCasing: a Greek capital sigma
    ; lowercases to the FINAL form ς when it ends a word -- preceded by a cased
    ; letter and not followed by one, skipping case-ignorable characters such
    ; as accents and quotation marks on both sides. It is the one
    ; context-sensitive rule in the language-independent mapping, and without it
    ; "ΟΔΟΣ".toLowerCase() answers "οδοσ", which is not a Greek word.
    fn finalSigmaHere:boolean (cps:[int] i:int) {
        def n:int (array_length cps)
        def before:boolean false
        def j:int (i - 1)
        def scanning:boolean true
        while (scanning && (j >= 0)) {
            def pv:int (itemAt cps j)
            if (this.caseInRanges(caseIgnRanges pv)) {
                j = (j - 1)
            } {
                before = (this.caseInRanges(caseCasedRanges pv))
                scanning = false
            }
        }
        if (before == false) {
            return false
        }
        def after:boolean false
        def k:int (i + 1)
        def scan2:boolean true
        while (scan2 && (k < n)) {
            def nv:int (itemAt cps k)
            if (this.caseInRanges(caseIgnRanges nv)) {
                k = (k + 1)
            } {
                after = (this.caseInRanges(caseCasedRanges nv))
                scan2 = false
            }
        }
        return (after == false)
    }

    ; §22.1.3.28 toLowerCase / §22.1.3.30 toUpperCase.
    fn unicodeCaseConvert:string (s:string upper:boolean) {
        ; ASCII is the overwhelming majority of every real workload and all
        ; three targets already agree about it, so it never touches a table.
        if (this.asciiOnly(s)) {
            if upper {
                return (to_uppercase s)
            }
            return (to_lowercase s)
        }
        this.ensureCaseTables()
        def cps:[int] (this.codePointsOf(s))
        def n:int (array_length cps)
        def out:string ""
        def i:int 0
        while (i < n) {
            def cp:int (itemAt cps i)
            def handled:boolean false
            if (upper == false) {
                if (cp == 931) {
                    if (this.finalSigmaHere(cps i)) {
                        out = (out + (this.cuFromCodePoint(962)))
                    } {
                        out = (out + (this.cuFromCodePoint(963)))
                    }
                    handled = true
                }
            }
            if (handled == false) {
                def multiTable:[int] caseLoMulti
                def runTable:[int] caseLoRuns
                if upper {
                    multiTable = caseUpMulti
                    runTable = caseUpRuns
                }
                def multi:[int] (this.caseMultiFor(multiTable cp))
                def mn:int (array_length multi)
                if (mn > 0) {
                    def m:int 0
                    while (m < mn) {
                        out = (out + (this.cuFromCodePoint((itemAt multi m))))
                        m = (m + 1)
                    }
                } {
                    def d:int (this.caseRunDelta(runTable cp))
                    out = (out + (this.cuFromCodePoint((cp + d))))
                }
            }
            i = (i + 1)
        }
        return out
    }


    ; ==========================================================================
    ; D-NFC: canonical normalization.
    ; --------------------------------------------------------------------------
    ; `normalize()` existed as a no-op on every target, which is worse than not
    ; existing: "café" typed with a combining accent and "café" typed with the
    ; precomposed letter are the same word and compared unequal, and the one
    ; call that exists to fix that quietly did nothing. Text arriving from a
    ; file, a form or a keyboard mixes the two freely.
    ;
    ; §3.11 in three steps: decompose canonically, put the combining marks in
    ; canonical order, and -- for the C forms -- compose back. The tables are in
    ; UnicodeNorm.rgr (generated, see the tools/ script named at its head).
    ; Hangul is not in them: its decomposition and composition are arithmetic.
    fn ensureNormTables:void () {
        if normTablesLoaded { return }
        normDecomp = (UnicodeNorm.decomp())
        normCcc = (UnicodeNorm.cccRuns())
        normCompose = (UnicodeNorm.compose())
        normTablesLoaded = true
    }

    ; The canonical combining class of `cp`, 0 for a starter. Binary search over
    ; (start, end, class) triples.
    fn cccOf:int (cp:int) {
        def n:int (array_length normCcc)
        def triples:int (this.intDiv(n 3))
        def lo:int 0
        def hi:int (triples - 1)
        while (lo <= hi) {
            def mid:int (bit_shr (lo + hi) 1)
            def base:int (mid * 3)
            def a:int (itemAt normCcc base)
            def b:int (itemAt normCcc (base + 1))
            if (cp < a) {
                hi = (mid - 1)
            } {
                if (cp > b) {
                    lo = (mid + 1)
                } {
                    return (itemAt normCcc (base + 2))
                }
            }
        }
        return 0
    }

    ; The composite of a starter and a following combining character, or -1.
    ; The table is sorted, so this is a binary search on the pair.
    fn composePair:int (a:int b:int) {
        def n:int (array_length normCompose)
        def triples:int (this.intDiv(n 3))
        def lo:int 0
        def hi:int (triples - 1)
        while (lo <= hi) {
            def mid:int (bit_shr (lo + hi) 1)
            def base:int (mid * 3)
            def ka:int (itemAt normCompose base)
            def kb:int (itemAt normCompose (base + 1))
            if (ka < a) {
                lo = (mid + 1)
            } {
                if (ka > a) {
                    hi = (mid - 1)
                } {
                    if (kb < b) {
                        lo = (mid + 1)
                    } {
                        if (kb > b) {
                            hi = (mid - 1)
                        } {
                            return (itemAt normCompose (base + 2))
                        }
                    }
                }
            }
        }
        return (0 - 1)
    }

    ; The canonical decomposition of `cp`, already fully expanded in the table,
    ; appended to `out`. Empty means the character stands for itself.
    fn decompOf:[int] (cp:int) {
        def out:[int]
        def n:int (array_length normDecomp)
        def i:int 0
        while (i < n) {
            def c:int (itemAt normDecomp i)
            def cnt:int (itemAt normDecomp (i + 1))
            if (c == cp) {
                def k:int 0
                while (k < cnt) {
                    push out (itemAt normDecomp ((i + 2) + k))
                    k = (k + 1)
                }
                return out
            }
            if (c > cp) {
                return out
            }
            i = ((i + 2) + cnt)
        }
        return out
    }

    ; §3.12: a Hangul syllable decomposes by arithmetic rather than by table --
    ; there are 11172 of them and tabulating would triple the file for nothing.
    fn hangulDecompose:[int] (cp:int) {
        def out:[int]
        def s:int (cp - 44032)
        def n:int (this.intDiv(s 28))
        def t:int (s - (n * 28))
        def l:int (this.intDiv(n 21))
        def v:int (n - (l * 21))
        push out (4352 + l)
        push out (4449 + v)
        if (t > 0) {
            push out (4519 + t)
        }
        return out
    }

    ; Integer division, through doubles. Ranger's `/` on two ints does not
    ; type in every position, and these are all small non-negative values.
    fn intDiv:int (a:int b:int) {
        return (to_int ((to_double a) / (to_double b)))
    }

    fn isHangulSyllable:boolean (cp:int) {
        if (cp < 44032) { return false }
        if (cp > 55203) { return false }
        return true
    }

    ; Step one and two: full canonical decomposition, then canonical ordering.
    ; The ordering is a STABLE insertion sort by combining class, which is what
    ; keeps two marks of the same class in the order they were written -- the
    ; whole point of the rule.
    fn nfdPoints:[int] (cps:[int]) {

    ; %uXXXX above it.
    ; ---- §18.2.6: encodeURI / encodeURIComponent / decodeURI(Component) ----
    ; D-URI: all four were named as globals and implemented by none of them, so
    ; every call answered null. They are the only string builtins that have to
    ; care which target is running: the native builds index a string by UTF-8
    ; BYTE and the es6 build by UTF-16 code unit, and percent-encoding is
    ; defined over UTF-8 bytes. One two-byte character settles which model this
    ; is, once.
    fn stringUnitsAreBytes:boolean () {
        return ((strlen "é") > 1)
    }

    fn uriUnreserved:boolean (c:int) {
        if ((c >= 65) && (c <= 90)) { return true }
        if ((c >= 97) && (c <= 122)) { return true }
        if ((c >= 48) && (c <= 57)) { return true }
        ; - _ . ! ~ * ' ( )
        if (c == 45) { return true }
        if (c == 95) { return true }
        if (c == 46) { return true }
        if (c == 33) { return true }
        if (c == 126) { return true }
        if (c == 42) { return true }
        if (c == 39) { return true }
        if (c == 40) { return true }
        if (c == 41) { return true }
        return false
    }


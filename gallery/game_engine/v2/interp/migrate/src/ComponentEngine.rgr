                        ; ACCESSORS answering a function already bound to the
                        ; object, because `list.sort(collator.compare)` is how
                        ; they are meant to be used.
                        if (this.intlIsBoundMethod(mKind propName)) {
                            return (this.builtinMethodValueFor(obj propName))
                        }
                        return (this.sharedNativeMethod(mKind propName))
                    }
                }
                ; D-PROTOKIND: the same lookup against the kind the object
                ; INHERITS, so `F.prototype = [1,2]; typeof new F().join` is
                ; "function" and not "undefined".
                def mInherit:string (this.protoChainKind(obj))
                if ((strlen mInherit) > 0) {
                    if (this.hasBuiltin(mInherit propName)) {
                        if (false == (obj.hasOwnData(propName))) {
                            return (this.sharedNativeMethod(mInherit propName))
                        }
                    }
                }
            }

            ; D-PROTOCTOR: a property not found on the value itself falls back
            ; to its kind's prototype object, which is how `[1,2].constructor`
            ; reaches Array. Only non-objects need this: a plain object already
            ; walks protoRef.
            if ((strlen propName) > 0) {
                def pcName:string (this.ctorNameForKind((this.receiverKind(obj))))
                if ((strlen pcName) > 0) {
                    if (false == (obj.isObject())) {
                        ; A string's OWN length wins over String.prototype.length
                        ; (which is 0). The prototype fallback is for inherited
                        ; properties, and length is not one of them.
                        def ownFirst:boolean false
                        if (propName == "length") {
                            if (obj.isString()) { ownFirst = true }
                            if (obj.isArrayValue()) { ownFirst = true }
                        }
                        ; Any OWN property wins over the kind's prototype. An
                        ; array holds its non-index properties in objectMap, and
                        ; consulting Array.prototype first meant `a.prop = 1002`
                        ; read back as whatever the prototype held.
                        if (obj.hasOwnData(propName)) {
                            ownFirst = true
                        }
                        if (false == ownFirst) {
                            ; D-PROTO: the value's OWN prototype link comes
                            ; first. An array whose prototype was replaced --
                            ; which is what `class E extends Array` produces --
                            ; must find the methods on THAT chain; consulting
                            ; only the kind's prototype skipped every one of
                            ; them, so a subclass's own methods were invisible.
                            if (obj.hasProto()) {
                                def ownChain:EvHandle (this.ownPropertyUpChain(obj propName))
                                if (false == (ownChain.isNull())) {
                                    return ownChain
                                }
                            }
                            def kProto:EvHandle (this.builtinPrototype(pcName))
                            if (kProto.hasOwnData(propName)) {
                                return (kProto.getOwnData(propName))
                            }
                        }
                    }
                }
            }

            ; Map/Set .size property (element count).
            if (propName == "size") {
                if ((obj.isMap()) || (obj.isSet())) {
                    return (EvHandle.fromInt((obj.denseLen())))
                }
            }

            ; Check for computed access [index]
            if node.computed {
                if node.right {
                    def indexExpr:TSNode (unwrap node.right)
                    def indexVal:EvHandle (this.evaluateExpr(indexExpr))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    if (false == quiet) {
                        this.trace("  Index value: " + (indexVal.toString()) + " type=" + (indexVal.kindName()))
                    }
                    ; D-ACCESSORS: a computed key reaches an accessor exactly as a
                    ; written one does -- `o["bar"]` must run the getter `o.bar`
                    ; runs. Only the written form was checked, above, so the
                    ; getter was skipped and the read answered undefined.
                    def ckey:string ""
                    if (indexVal.isString()) { ckey = (indexVal.stringOf()) }
                    if (indexVal.isNumber()) { ckey = (this.toPropertyKey(indexVal)) }
                    ; D-SYMKEY: a SYMBOL index is a property key too. Only string
                    ; and number keys were derived here, so `o[sym]` read nothing
                    ; even though `o[sym] = v` had written under the symbol's key.
                    def cSymKey:string (this.symbolKeyOf(indexVal))
                    if ((strlen cSymKey) > 0) { ckey = cSymKey }
                    ; D-ARGMAP: `arguments[0]` and the first named parameter are
                    ; ONE binding in sloppy mode, so a reassignment of either is
                    ; visible through the other. The object held a snapshot taken
                    ; before the body ran.
                    if ((strlen ckey) > 0) {
                        def cMapped:string (this.argMapName(obj ckey))
                        if ((strlen cMapped) > 0) {
                            def cMapCtx:EvalContext (this.argMapScopeOf(obj))
                            if (cMapCtx.has(cMapped)) {
                                return (cMapCtx.lookup(cMapped))
                            }
                        }
                    }
                    if ((strlen ckey) > 0) {
                        def cgFn:EvHandle (this.resolveGetterOn(obj ckey))
                        if (cgFn.isFunction()) {
                            if (cgFn.hasFunctionNode()) {
                                def cgArgs:[EvHandle]
                                return (this.callFnValueWithValues((cgFn.withThisForCall(obj)) cgArgs))
                            }
                            ; D-REGEXACCESSOR: the computed form runs a built-in
                            ; getter too -- `re["source"]` is `re.source`.
                            if (cgFn.isBuiltinMethod()) {
                                def cbgArgs:[EvHandle]
                                return (this.invokeBuiltin((cgFn.builtinKindOf()) (cgFn.builtinNameOf()) obj cbgArgs))
                            }
                        }
                    }
                    ; D-ARRAYSPARSE: the same rule the write side uses. An
                    ; ARRAY answers from its elements only for a canonical index;
                    ; everything else -- `x[-1]`, `x["00"]`, a far index that had
                    ; to be stored as a property -- is a property read.
                    if (obj.isArrayValue()) {
                        def rk:string (this.toPropertyKey(indexVal))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                        def rIdx:int (this.canonicalArrayIndex(rk))
                        if (rIdx >= 0) {
                            if (rIdx <= 10000000) {
                                ; D-PROTO: a HOLE is absent on the array itself,
                                ; so the read continues up the chain --
                                ; `Array.prototype[1] = 7; [0,,][1]` is 7. The
                                ; array carries no prototype link of its own, so
                                ; the value layer stopped there and answered
                                ; undefined for a property that exists.
                                def slotPresent:boolean false
                                if (rIdx < (obj.denseLen())) {
                                    slotPresent = (false == ((EvValueBridge.isHole((obj.arrayItemAt(rIdx))))))
                                }
                                if slotPresent {
                                    return (obj.getIndex(rIdx))
                                }
                                def upChain:EvHandle (this.ownPropertyUpChain(obj rk))
                                if (false == (upChain.isNull())) {
                                    return upChain
                                }
                                return (obj.getIndex(rIdx))
                            }
                        }
                        def viaFar:EvHandle (obj.getMember(rk))
                        if (viaFar.isNull()) {
                            def rmFar:EvHandle (this.builtinMethodValueFor(obj rk))
                            if (false == (rmFar.isNull())) {
                                return rmFar
                            }
                            return (EvValueBridge.taggedUndefined())
                        }
                        return viaFar
                    }
                    if (indexVal.isNumber()) {
                        def idx:int (to_int (indexVal.toNumber()))
                        if (false == quiet) {
                            this.trace("  Getting index " + (to_string idx) + " from array of length " + (to_string (obj.denseLen())))
                        }
                        return (obj.getIndex(idx))
                    }
                    if (indexVal.isString()) {
                        ; A string key that names an index reaches the character,
                        ; and a key that names nothing reads as undefined --
                        ; `'abc'['foo']` is undefined, not null.
                        def sk:string (indexVal.stringOf())
                        if (obj.isString()) {
                            def ski@(optional):int (to_int sk)
                            if ski {
                                return (obj.getIndex((unwrap ski)))
                            }
                            def viaMember:EvHandle (obj.getMember(sk))
                            if (viaMember.isNull()) {
                                def rmStr:EvHandle (this.builtinMethodValueFor(obj sk))
                                if (false == (rmStr.isNull())) {
                                    return rmStr
                                }
                                return (EvValueBridge.taggedUndefined())
                            }
                            return viaMember
                        }
                        def viaObj:EvHandle (obj.getMember(sk))
                        if (viaObj.isNull()) {
                            def rmObj:EvHandle (this.builtinMethodValueFor(obj sk))
                            if (false == (rmObj.isNull())) {
                                return rmObj
                            }
                        }
                        if (viaObj.isUndefined()) {
                            def rmObj2:EvHandle (this.builtinMethodValueFor(obj sk))
                            if (false == (rmObj2.isNull())) {
                                return rmObj2
                            }
                        }
                        return viaObj
                    }
                    ; D-SYMKEY: a symbol index reads under the symbol's key.
                    if ((strlen cSymKey) > 0) {
                        def viaSym:EvHandle (this.getPropertyValue(obj cSymKey))
                        if ((viaSym.isNull()) || (viaSym.isUndefined())) {
                            def rmSym:EvHandle (this.builtinMethodValueFor(obj cSymKey))
                            if (false == (rmSym.isNull())) {
                                return rmSym
                            }
                            return (EvValueBridge.taggedUndefined())
                        }
                        return viaSym
                    }
                }
            }

            ; user class instance: an own field wins; otherwise a method name
            ; becomes a `this`-bound method reference (a callable value).
            def clsN:string (this.instanceClassName(obj))
            if ((strlen clsN) > 0) {
                def fieldV:EvHandle (obj.getMember(propName))
                if (false == (fieldV.isNull())) {
                    if (false == (fieldV.isUndefined())) {
                        return fieldV
                    }
                }
                def mcls:TSNode (this.classNodeForInstance(obj))
                def mnode:TSNode (this.findMethodOnClassNode(mcls propName))
                if (mnode.nodeType == "MethodDefinition") {
                    def bm:EvHandle (EvValueBridge.taggedBoundMethod(mnode obj))
                    this.stampSrcOn(bm)
                    ; provenance travels with the value: a stored method of a
                    ; module instance still roots in its module when invoked
                    bm.setHomeModule((this.instanceModuleTag(obj)))
                    return bm
                }
            }

            def outMember:EvHandle (obj.getMember(propName))
            ; A property a PRIMITIVE does not have reads as undefined, not null:
            ; `typeof (1).nope` is "undefined", and answering the engine's null
            ; sentinel made it "object".
            if (outMember.isNull()) {
                def primRecv:boolean false
                if (obj.isNumber()) { primRecv = true }
                if (obj.isString()) { primRecv = true }
                if (obj.isBoolean()) { primRecv = true }
                ; An ARRAY answers undefined for a property it does not have
                ; too -- `[].index` is undefined, and the engine's null read as
                ; the value null, which is a different thing a test can see.
                if (obj.isArrayValue()) { primRecv = true }
                if primRecv {
                    return (EvValueBridge.taggedUndefined())
                }
            }
            return outMember
        }

        return (EvValueBridge.taggedNull())
    }

    fn evaluateArrayExpr:EvHandle (node:TSNode) {
        def items:[EvHandle]
        
        def i:int 0
        while (i < (array_length node.children)) {
            def elem:TSNode (itemAt node.children i)
            ; Array-literal spread: [...a, b] inlines a's elements.
            if (elem.nodeType == "SpreadElement") {
                def sv:EvHandle (EvValueBridge.taggedNull())
                if elem.left {
                    sv = (this.evaluateExpr((unwrap elem.left)))
                }
                if (sv.isArrayValue()) {
                    def k:int 0
                    while (k < (sv.denseLen())) {
                        push items (sv.arrayItemAt(k))
                        k = (k + 1)
                    }
                } {
                    ; `[...g()]`, `[..."ab"]`, `[...set]` -- anything for-of can
                    ; walk, spread can too. Only the array case was handled, so
                    ; spreading a generator produced an empty array.
                    def sp:[EvHandle] (this.forOfItemList(sv))
                    def sk:int 0
                    while (sk < (array_length sp)) {
                        push items (itemAt sp sk)
                        sk = (sk + 1)
                    }
                }
            } {
                push items (this.evaluateExpr(elem))
            }
            i = i + 1
        }

        return (EvValueBridge.taggedArray(items))
    }
    
    ; Lexicographic compare of two strings by char code: <0, 0, >0. Used for the
    ; default (comparator-less) Array#sort, which JS defines as string order.
    ; The default sort comparison. It was a SECOND copy of compareStrings, and
    ; only the other copy was taught the code-unit rules -- so `a < b` and
    ; `[a, b].sort()` disagreed about the same two strings. One implementation
    ; now, so they cannot drift apart again.
    fn strCmp:int (a:string b:string) {
        return (this.compareStrings(a b))
    }

    ; Internal bookkeeping members stamped on values by the evaluator — never
    ; enumerable guest data. __class__/__module__ tag instances with their class
    ; and its home module; __nsmodule__ tags an imported module namespace.
    ; The engine's own slots, without the symbol keys isHiddenInstanceKey also
    ; hides. Object.assign copies a symbol-keyed property but never a slot.
    fn isInternalSlotKey:boolean (k:string) {
        if ((strlen k) > 4) {
            if ((substring k 0 2) == "__") {
                if ((substring k ((strlen k) - 2) (strlen k)) == "__") {
                    return true
                }
            }
        }
        return false
    }

    fn isHiddenInstanceKey:boolean (k:string) {
        ; D-PRIVATE: a private field's key literally begins with `#`, which no
        ; ordinary property name may contain. That is what makes it private:
        ; it is skipped by every enumeration, by JSON, and by the descriptor
        ; walks -- the three ways a plain property would have leaked out.
        if ((strlen k) > 0) {
            if ((substring k 0 1) == "#") { return true }
        }
        if (k == "__class__") { return true }
        if (k == "__classname__") { return true }
        if (k == "__staticdone__") { return true }
        ; D-WEAK: the backing collection and the kind tag are internal slots.
        if (k == "__weakkind__") { return true }
        if (k == "__weakdata__") { return true }
        if (k == "__module__") { return true }
        if (k == "__nsmodule__") { return true }
        ; D-WRAPPER / D-ERRORS internal slots. `new String('ab')` has exactly one
        ; own enumerable property per index, not a `__primitive__` alongside it.
        if (k == "__primitive__") { return true }
        if (k == "__wrapper__") { return true }
        if (k == "__error__") { return true }
        if (k == "__errorctor__") { return true }
        if (k == "__symbol__") { return true }
        if (k == "__symid__") { return true }
        if (k == "__symreg__") { return true }
        if (k == "__promise__") { return true }
        if (k == "__pid__") { return true }
        if (k == "__pstate__") { return true }
        if (k == "__pvalue__") { return true }
        if (k == "__iterlist__") { return true }
        if (k == "__tabrand__") { return true }
        if (k == "__abshared__") { return true }
        if (k == "__abviews__") { return true }
        if (k == "__abmax__") { return true }
        if (k == "__abdetached__") { return true }
        if (k == "__tabuffer__") { return true }
        if (k == "__biglimbs__") { return true }
        if (k == "__bigneg__") { return true }
        if (k == "__taoffset__") { return true }
        if (k == "__iteridx__") { return true }
        if (k == "__genitems__") { return true }
        if (k == "__genidx__") { return true }
        if (k == "__proxytarget__") { return true }
        if (k == "__proxyhandler__") { return true }
        ; D-ARGMAP: the mapping an arguments object keeps between its indexes
        ; and the parameter bindings. Both leaked into
        ; `Object.getOwnPropertyNames(arguments)`.
        if (k == "__argnames__") { return true }
        if (k == "__argscope__") { return true }
        if (k == "__arguments__") { return true }
        ; D-SYMKEY: a symbol-keyed property is never listed by Object.keys,
        ; getOwnPropertyNames or for-in. Symbol keys are minted as "@@..." so
        ; the one prefix covers both well-known and user symbols.
        if ((strlen k) > 2) {
            if ((substring k 0 2) == "@@") { return true }
        }
        if (k == "__protokind__") { return true }
        if (k == "__date__") { return true }
        if (k == "__nsbrand__") { return true }
        if (k == "__regex__") { return true }
        if (k == "__arguments__") { return true }
        return false
    }

    ; Own enumerable keys of an object value (wrapper so callers where `keys` is
    ; shadowed by a local variable can still reach the builtin).
    ; D-KEYORDER: ES2015 own-property order — integer-like keys first in
    ; ascending numeric order, then everything else in INSERTION order. The
    ; native map types keep insertion order (rg_ordered_map / RgOrderedMap),
    ; and this is the one place the integer rule is applied, so Object.keys,
    ; for-in and JSON.stringify agree with JavaScript on every target.
    fn isArrayIndexKey:boolean (k:string) {
        def n:int (strlen k)
        if (n == 0) { return false }
        if (n > 10) { return false }
        if (((charAt k 0) == 48) && (n > 1)) { return false }
        def i:int 0
        while (i < n) {
            def c:int (charAt k i)
            if ((c < 48) || (c > 57)) { return false }
            i = (i + 1)
        }
        if (n == 10) {
            ; the spec bound: an array index is < 2^32 - 1.
            ; Compare in the double domain: 4294967295 does not fit a signed
            ; 32-bit int (Kotlin/Java/C#), and those targets' to_int on a
            ; too-large digit string is empty rather than a wrapped value.
            def big@(optional):int (to_int k)
            if big {
                if ((to_double (unwrap big)) >= 4294967295.0) { return false }
            }
        }
        return true
    }

    fn orderEnumKeys:[string] (ks:[string]) {
        def n:int (array_length ks)
        def anyIdx:boolean false
        def i:int 0
        while (i < n) {
            if (this.isArrayIndexKey((itemAt ks i))) { anyIdx = true }
            i = (i + 1)
        }
        if (false == anyIdx) { return ks }
        def idxKeys:[string]
        def rest:[string]
        i = 0
        while (i < n) {
            def k:string (itemAt ks i)
            if (this.isArrayIndexKey(k)) {
                push idxKeys k
            } {
                push rest k
            }
            i = (i + 1)
        }
        ; insertion sort ascending by numeric value; enumerations are small
        def m:int (array_length idxKeys)
        def a:int 1
        while (a < m) {
            def b:int a
            while (b > 0) {
                def kb:string (itemAt idxKeys b)
                def ka:string (itemAt idxKeys (b - 1))
                def vbO@(optional):int (to_int kb)
                def vaO@(optional):int (to_int ka)
                def vb:int 0
                def va:int 0
                if vbO { vb = (unwrap vbO) }
                if vaO { va = (unwrap vaO) }
                if (vb < va) {
                    set idxKeys b ka
                    set idxKeys (b - 1) kb
                    b = (b - 1)
                } {
                    b = 0
                }
            }
            a = (a + 1)
        }
        def out:[string]
        def oi:int 0
        while (oi < m) {
            push out (itemAt idxKeys oi)
            oi = (oi + 1)
        }
        def ri:int 0
        def rn:int (array_length rest)
        while (ri < rn) {
            push out (itemAt rest ri)
            ri = (ri + 1)
        }
        return out
    }

    fn objectKeys:[string] (v:EvHandle) {
        ; D-PROXY: the `ownKeys` trap supplies the key list every enumeration
        ; and every getOwnPropertyNames reads.
        if (this.isProxyValue(v)) {
            def kTgt:EvHandle (this.proxyTargetOf(v))
            def kTrap:EvHandle (this.proxyTrap(v "ownKeys"))
            if scriptThrew {
                def emptyK:[string]
                return emptyK
            }
            if (kTrap.isFunction()) {
                def kArgs:[EvHandle]
                push kArgs kTgt
                def kRes:EvHandle (this.callProxyTrap(kTrap kArgs))
                def outK:[string]
                if scriptThrew {
                    return outK
                }
                ; §10.5.11 step 6: the trap's result must be a LIST. Anything
                ; else is a TypeError, not an empty enumeration -- which is what
                ; arrayLikeElements quietly turned a number into.
                if (false == (kRes.isArrayValue())) {
                    def _kt:EvHandle (this.throwSpecError("TypeError" "proxy ownKeys trap did not return an object"))
                    return outK
                }
                def kEls:[EvHandle] (this.arrayLikeElements(kRes))
                def ki2:int 0
                while (ki2 < (array_length kEls)) {
                    push outK (this.toPropertyKey((itemAt kEls ki2)))
                    ki2 = (ki2 + 1)
                }
                ; §10.5.11 steps 17-20: every NON-CONFIGURABLE own key of the
                ; target must appear. A handler may hide a configurable
                ; property, but not one the target has promised is permanent --
                ; that is the invariant reflection relies on.
                def tgtKeys:[string] (kTgt.ownDataKeys())
                def tki:int 0
                while (tki < (array_length tgtKeys)) {
                    def tk2:string (itemAt tgtKeys tki)
                    if (false == (kTgt.isConfigurable(tk2))) {
                        if (false == (this.isInList(tk2 outK))) {
                            def _ki:EvHandle (this.throwSpecError("TypeError" ("proxy ownKeys trap omitted the non-configurable property '" + (tk2 + "'"))))
                            def emptyI:[string]
                            return emptyI
                        }
                    }
                    tki = (tki + 1)
                }
                return outK
            }
            return (this.objectKeys(kTgt))
        }
        return (this.orderEnumKeys((this.objectKeysRaw(v))))

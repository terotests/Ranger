        ; exist on every kind. They had call-site handlers but no registry
        ; entries, so `typeof Object.prototype.propertyIsEnumerable` was
        ; "undefined" for a method that plainly works.
        push out "hasOwnProperty"
        push out "isPrototypeOf"
        push out "propertyIsEnumerable"
        push out "toLocaleString"
        return out
    }

    ; The prototype object for a built-in constructor, created once per engine so
    ; a property assigned to it persists and compares equal across reads. It is
    ; POPULATED from the registry, which is what makes `Array.prototype.slice` a
    ; real value reachable without an instance — the whole point of the refactor.
    ; Names that belong to Object.prototype and are only INHERITED elsewhere.
    fn isObjectProtoOnly:boolean (name:string) {
        if (name == "hasOwnProperty") { return true }
        if (name == "isPrototypeOf") { return true }
        if (name == "propertyIsEnumerable") { return true }
        return false
    }

    ; Which prototypes own `valueOf`. Object, the three wrappers and Date do;
    ; Array, Function and RegExp only inherit it, so publishing it on them made
    ; `Function.prototype.hasOwnProperty("valueOf")` true for a property
    ; Function.prototype does not have.
    fn ownsValueOf:boolean (nsName:string) {
        if (nsName == "Object") { return true }
        if (nsName == "Number") { return true }
        if (nsName == "String") { return true }
        if (nsName == "Boolean") { return true }
        if (nsName == "Date") { return true }
        return false
    }

    fn builtinPrototype:EvalValue (nsName:string) {
        if (has builtinProtos nsName) {
            return (unwrap (get builtinProtos nsName))
        }
        def keysB:[string]
        def valsB:[EvalValue]
        def p:EvalValue (EvalValue.object(keysB valsB))
        ; Function.prototype is itself a function -- `typeof Function.prototype`
        ; is "function" and calling it returns undefined. Every other built-in
        ; prototype is an ordinary object.
        ; D-PROTOKIND: Array.prototype is itself an ARRAY -- `Array.isArray`
        ; says so and its `length` is 0 -- just as Function.prototype is itself
        ; callable. Making it a plain object meant both answered wrongly for a
        ; value the spec is explicit about.
        if (nsName == "Array") {
            def emptyEls:[EvalValue]
            p = (EvalValue.array(emptyEls))
        }
        if (nsName == "Function") {
            p = (EvalValue.nativeFunction(""))
            ; Calling it returns undefined whatever it is handed. Marked so the
            ; call paths can tell it from an uncallable value -- it has no
            ; function node and no builtin name, which is otherwise exactly what
            ; "not a function" looks like.
            p.setMember("__fnprotocall__" (EvalValue.boolean(true)))
            p.setAttrs("__fnprotocall__" false false false)
        }
        set builtinProtos nsName p
        ; D-PROTOCTOR: every built-in prototype inherits from Object.prototype,
        ; which is what makes `delete Number.prototype.toString` fall back to
        ; the branding one and `Object.prototype.isPrototypeOf(Number.prototype)`
        ; true. Object.prototype itself terminates the chain.
        if (nsName != "Object") {
            p.protoRef = (this.builtinPrototype("Object"))
        }
        ; D-PROTOCTOR: every prototype carries `constructor` back to its global.
        ; Safe against the cycle (global sets prototype, prototype sets
        ; constructor) because both cache their object BEFORE populating it.
        def ctorG:EvalValue (this.builtinGlobalObject(nsName))
        if (ctorG.valueType != 0) {
            p.setMember("constructor" ctorG)
            ; Non-enumerable, like every other property of a built-in prototype.
            p.setAttrs("constructor" true false true)
        }
        ; D-CLASSOF: Number.prototype, String.prototype and Boolean.prototype are
        ; themselves boxed primitives holding +0, "" and false. That is not a
        ; curiosity -- it is what makes `Number.prototype.toString()` answer "0"
        ; instead of "[object Object]", and the toString/toFixed areas are
        ; written to check exactly that.
        if (nsName == "Number") {
            p.setMember("__primitive__" (EvalValue.number(0.0)))
            p.setMember("__wrapper__" (EvalValue.string("Number")))
        }
        if (nsName == "String") {
            p.setMember("__primitive__" (EvalValue.string("")))
            p.setMember("__wrapper__" (EvalValue.string("String")))
            p.setMember("length" (EvalValue.fromInt(0)))
            p.setAttrs("length" false false false)
        }
        if (nsName == "Boolean") {
            p.setMember("__primitive__" (EvalValue.boolean(false)))
            p.setMember("__wrapper__" (EvalValue.string("Boolean")))
        }
        ; D-REGEXACCESSOR: source/global/ignoreCase/multiline are ACCESSORS on
        ; RegExp.prototype -- get-only, non-enumerable, configurable -- which is
        ; the shape getOwnPropertyDescriptor is asked about. The instance keeps
        ; its ES5 own data properties as well; see CONFORMANCE.md.
        if (nsName == "RegExp") {
            def rgNames:[string]
            push rgNames "source"
            push rgNames "global"
            push rgNames "ignoreCase"
            push rgNames "multiline"
            def rgi:int 0
            while (rgi < (array_length rgNames)) {
                def rgn:string (itemAt rgNames rgi)
                p.defineGetter(rgn (this.sharedNativeMethod("regexpget" rgn)))
                p.setAttrs(rgn false false true)
                rgi = (rgi + 1)
            }
        }
        def kind:string (this.kindForCtorName(nsName))
        if ((strlen kind) > 0) {
            ; D-PROTOKIND: the prototype remembers which receiver kind it serves,
            ; so an object that merely INHERITS from it can still reach the
            ; registry. `F.prototype = new Array(1,2,3); new F().filter(cb)` has
            ; to find Array.prototype.filter, and the instance's own kind is
            ; "object".
            p.setMember("__protokind__" (EvalValue.string(kind)))
            def names:[string] (this.builtinNames(kind))
            def i:int 0
            while (i < (array_length names)) {
                def nm:string (itemAt names i)
                ; Registry is the authority: a name listed here that is not
                ; registered would hand out a value that does nothing when
                ; called, so it is skipped rather than published.
                ; D-OBJPROTO: the Object.prototype methods are REGISTERED for
                ; every kind so dispatch finds them, but they are OWN properties
                ; of Object.prototype alone -- publishing them everywhere made
                ; `Function.prototype.hasOwnProperty("valueOf")` true for a
                ; property Function.prototype only inherits.
                def publishHere:boolean (this.hasBuiltin(kind nm))
                if (this.isObjectProtoOnly(nm)) {
                    if (nsName != "Object") {
                        publishHere = false
                    }
                }
                if (nm == "valueOf") {
                    if (false == (this.ownsValueOf(nsName))) {
                        publishHere = false
                    }
                }
                if publishHere {
                    p.setMember(nm (this.sharedNativeMethod(kind nm)))
                    ; D-ATTRS: every built-in method is writable and
                    ; configurable but NOT enumerable, so `for (var k in
                    ; String.prototype)` yields nothing and Object.keys of a
                    ; prototype is empty. Publishing them enumerable made every
                    ; prototype look like a bag of own data.
                    p.setAttrs(nm true false true)
                }
                i = (i + 1)
            }
        }
        return p
    }

    ; ==========================================================================
    ; D-REGISTRY: built-in methods, dispatched by RECEIVER KIND then name.
    ; --------------------------------------------------------------------------
    ; The old dispatch was a single 1800-line if-chain keyed on the method NAME
    ; with only a handful of receiver-type guards, so `toString` on an array, an
    ; object and a number all reached the same branch and a correct type-specific
    ; implementation added later was unreachable — shadowed by position. Worse,
    ; a built-in was never a VALUE: `Array.prototype.slice` did not exist, so
    ; `slice.call(arguments)` could not work at all.
    ;
    ; The registry fixes both. `builtinArity` answers whether (kind, name) is a
    ; built-in — the single source of truth for what exists — and `invokeBuiltin`
    ; runs it. Because a method is identified by a (kind, name) PAIR rather than
    ; a function pointer (which Ranger does not have), the same pair can be
    ; handed out as a first-class value via EvalValue.nativeMethod.
    ;
    ; Framework surface is deliberately NOT in here: the native bridge,
    ; registerGlobal host injections, EVG/JSX helpers and AssemblyScript sized
    ; casts are the embedding rather than ECMAScript, and they keep priority by
    ; being routed before the registry.
    ; --------------------------------------------------------------------------
    ; D-PROTOKIND: the receiver kind an object INHERITS, by walking its prototype
    ; chain until something that is not a plain object turns up (an array
    ; prototype, say) or until a built-in prototype identifies itself. Returns ""
    ; when the chain says nothing, which leaves the caller's own dispatch alone.
    ; D-PROTOKIND: the prototype a value actually inherits from. An array, a
    ; string, a function and a RegExp carry no protoRef of their own -- they
    ; dispatch by KIND -- so asking for their prototype answered null and
    ; `Array.prototype.isPrototypeOf([])` was false. Object.prototype terminates
    ; the chain, and answering it for itself would loop.
    fn protoOfValue:EvalValue (v:EvalValue) {
        if v.protoRef {
            return (unwrap v.protoRef)
        }
        def objProto:EvalValue (this.builtinPrototype("Object"))
        if (v.equals(objProto)) {
            return (EvalValue.null())
        }
        def cn:string (this.ctorNameForKind((this.receiverKind(v))))
        if ((strlen cn) > 0) {
            def kp:EvalValue (this.builtinPrototype(cn))
            if (false == (v.equals(kp))) {
                return kp
            }
        }
        if (v.valueType == 5) {
            return objProto
        }
        return (EvalValue.null())
    }

    fn protoChainKind:string (v:EvalValue) {
        if (v.valueType != 5) {
            return ""
        }
        def cur:EvalValue v
        def depth:int 0
        while (depth < 16) {
            if (null? cur.protoRef) {
                return ""
            }
            def nxt:EvalValue (unwrap cur.protoRef)
            if (nxt.valueType != 5) {
                return (this.receiverKind(nxt))
            }
            if (has nxt.objectMap "__protokind__") {
                return ((unwrap (get nxt.objectMap "__protokind__")).toString())
            }
            cur = nxt
            depth = (depth + 1)
        }
        return ""
    }

    fn receiverKind:string (v:EvalValue) {
        ; D-WRAPPER: a boxed primitive dispatches as its primitive kind, which
        ; is what makes `new String('a').toUpperCase()` reach String.prototype.
        if (v.valueType == 5) {
            if (has v.objectMap "__primitive__") {
                def inner:EvalValue (unwrap (get v.objectMap "__primitive__"))
                if (inner.valueType == 2) { return "string" }
                if (inner.valueType == 1) { return "number" }
                if (inner.valueType == 3) { return "boolean" }
            }
        }
        if (v.valueType == 2) { return "string" }
        if (v.valueType == 4) { return "array" }
        if (v.valueType == 1) { return "number" }
        if (v.valueType == 3) { return "boolean" }
        if (v.valueType == 6) { return "function" }
        if (v.valueType == 9) { return "map" }
        if (v.valueType == 10) { return "set" }
        if (v.valueType == 5) {
            ; D-REGEX: a RegExp dispatches to its own prototype so exec/test do
            ; not have to be looked for among the Object methods.
            if (has v.objectMap "__regex__") { return "regexp" }
            ; D-DATE: likewise a Date, whose accessors are arithmetic on its
            ; time value rather than anything Object.prototype offers.
            if (has v.objectMap "__date__") { return "date" }
            return "object"
        }
        return ""
    }

    ; Arity of a registered built-in, or -1 when (kind, name) is not one. Doubles
    ; as the existence check, so "is this a built-in" and "how many arguments"
    ; can never disagree.
    fn builtinArity:int (kind:string name:string) {
        if (kind == "function") {
            if (name == "call") { return 1 }
            if (name == "apply") { return 2 }
            if (name == "bind") { return 1 }
        }
        ; D-REGEXACCESSOR: the GETTER halves of RegExp.prototype's source, global,
        ; ignoreCase and multiline. A kind of their own, so they are dispatchable
        ; values without becoming methods anyone can call as `re.source()`.
        ; Registered before the shared names below because `source` is not one of
        ; them and the flags are not methods at all.
        ; D-ARGUMENTS: the poisoned `callee` accessor a STRICT arguments object
        ; carries. Both halves are the same entry -- reading or writing throws.
        if (kind == "argpoison") {
            if (name == "callee") { return 0 }
            return (0 - 1)
        }
        if (kind == "regexpget") {
            if (name == "source") { return 0 }
            if (name == "global") { return 0 }
            if (name == "ignoreCase") { return 0 }
            if (name == "multiline") { return 0 }
            return (0 - 1)
        }
        ; toString exists on every kind, but with a DIFFERENT implementation per
        ; kind. That is the whole point of keying on the receiver: the old single
        ; branch answered "[1, 2]" for an array and "{}" for an object, both of
        ; which are the engine's debug format rather than the language's.
        if (name == "toString") { return 0 }
        if (name == "valueOf") { return 0 }
        if (name == "hasOwnProperty") { return 1 }
        if (name == "isPrototypeOf") { return 1 }
        if (name == "propertyIsEnumerable") { return 1 }
        if (name == "toLocaleString") { return 0 }
        ; String methods belong to strings ONLY. Registering them per-kind is
        ; what makes `[1,2].charAt(0)` a TypeError instead of returning "[" —
        ; the old unguarded branch stringified the array and indexed its debug
        ; format.
        if (kind == "date") {
            if (name == "setTime") { return 1 }
            if (name == "setMilliseconds") { return 1 }
            if (name == "setUTCMilliseconds") { return 1 }
            if (name == "setSeconds") { return 2 }
            if (name == "setUTCSeconds") { return 2 }
            if (name == "setMinutes") { return 3 }
            if (name == "setUTCMinutes") { return 3 }
            if (name == "setHours") { return 4 }
            if (name == "setUTCHours") { return 4 }
            if (name == "setDate") { return 1 }
            if (name == "setUTCDate") { return 1 }
            if (name == "setMonth") { return 2 }
            if (name == "setUTCMonth") { return 2 }
            if (name == "setFullYear") { return 3 }
            if (name == "setUTCFullYear") { return 3 }
            if (name == "setYear") { return 1 }
            if (name == "toGMTString") { return 0 }
            if (name == "getDate") { return 0 }
            if (name == "getDay") { return 0 }
            if (name == "getFullYear") { return 0 }
            if (name == "getHours") { return 0 }
            if (name == "getMilliseconds") { return 0 }
            if (name == "getMinutes") { return 0 }
            if (name == "getMonth") { return 0 }
            if (name == "getSeconds") { return 0 }
            if (name == "getTime") { return 0 }
            if (name == "getTimezoneOffset") { return 0 }
            if (name == "getUTCDate") { return 0 }
            if (name == "getUTCDay") { return 0 }
            if (name == "getUTCFullYear") { return 0 }
            if (name == "getUTCHours") { return 0 }
            if (name == "getUTCMilliseconds") { return 0 }
            if (name == "getUTCMinutes") { return 0 }
            if (name == "getUTCMonth") { return 0 }
            if (name == "getUTCSeconds") { return 0 }
            if (name == "getYear") { return 0 }
            if (name == "toDateString") { return 0 }
            if (name == "toISOString") { return 0 }
            if (name == "toJSON") { return 1 }
            if (name == "toLocaleDateString") { return 0 }
            if (name == "toLocaleString") { return 0 }
            if (name == "toLocaleTimeString") { return 0 }
            if (name == "toTimeString") { return 0 }
            if (name == "toUTCString") { return 0 }
        }
        if (kind == "string") {
            if (name == "at") { return 1 }
            if (name == "charCodeAt") { return 1 }
            if (name == "codePointAt") { return 1 }
            if (name == "concat") { return 1 }
            if (name == "localeCompare") { return 1 }
            if (name == "match") { return 1 }
            if (name == "normalize") { return 0 }
            if (name == "search") { return 1 }
            if (name == "substr") { return 2 }
            if (name == "toLocaleLowerCase") { return 0 }
            if (name == "toLocaleString") { return 0 }
            if (name == "toLocaleUpperCase") { return 0 }
            if (name == "endsWith") { return 1 }
            if (name == "includes") { return 1 }
            if (name == "indexOf") { return 1 }
            if (name == "lastIndexOf") { return 1 }
            if (name == "repeat") { return 1 }
            if (name == "replace") { return 2 }
            if (name == "replaceAll") { return 2 }
            if (name == "slice") { return 2 }
            if (name == "split") { return 2 }
            if (name == "startsWith") { return 1 }
            if (name == "trimEnd") { return 0 }
            if (name == "trimStart") { return 0 }
            if (name == "charAt") { return 1 }
            if (name == "toUpperCase") { return 0 }
            if (name == "toLowerCase") { return 0 }
            if (name == "trim") { return 0 }
            if (name == "substring") { return 2 }
            if (name == "padStart") { return 2 }
            if (name == "padEnd") { return 2 }
        }
        if (kind == "map") {
            if (name == "clear") { return 0 }
            if (name == "delete") { return 1 }
            if (name == "entries") { return 0 }
            if (name == "forEach") { return 1 }
            if (name == "get") { return 1 }
            if (name == "has") { return 1 }
            if (name == "keys") { return 0 }
            if (name == "set") { return 2 }
            if (name == "values") { return 0 }
        }
        if (kind == "set") {
            if (name == "add") { return 1 }
            if (name == "clear") { return 0 }
            if (name == "delete") { return 1 }
            if (name == "forEach") { return 1 }
            if (name == "has") { return 1 }
            if (name == "keys") { return 0 }
            if (name == "values") { return 0 }
        }
        if (kind == "array") {
            if (name == "at") { return 1 }
            if (name == "concat") { return 1 }
            if (name == "every") { return 1 }
            if (name == "fill") { return 1 }
            if (name == "filter") { return 1 }
            if (name == "find") { return 1 }
            if (name == "findIndex") { return 1 }
            if (name == "flat") { return 0 }
            if (name == "forEach") { return 1 }
            if (name == "includes") { return 1 }
            if (name == "indexOf") { return 1 }
            if (name == "join") { return 1 }
            if (name == "lastIndexOf") { return 1 }
            if (name == "map") { return 1 }
            if (name == "pop") { return 0 }
            if (name == "push") { return 1 }
            if (name == "reduce") { return 1 }
            if (name == "reduceRight") { return 1 }
            if (name == "reverse") { return 0 }
            if (name == "shift") { return 0 }
            if (name == "slice") { return 2 }
            if (name == "some") { return 1 }
            if (name == "sort") { return 1 }
            if (name == "splice") { return 2 }
            if (name == "unshift") { return 1 }
        }
        if (kind == "regexp") {
            if (name == "exec") { return 1 }
            if (name == "test") { return 1 }
        }
        if (kind == "number") {
            if (name == "toExponential") { return 1 }
            if (name == "toFixed") { return 1 }
            if (name == "toLocaleString") { return 0 }
            if (name == "toPrecision") { return 1 }
        }
        return (0 - 1)
    }

    ; Number.prototype.toFixed formatting, lifted verbatim from the old chain
    ; branch so the migration cannot change its behaviour.
    ; D-RADIX: integer part in an arbitrary base, plus a bounded fractional
    ; expansion. Digits above 9 are lowercase letters, as the spec requires.
    fn numberToRadix:string (value:double radix:int) {
        if (value != value) {
            return "NaN"
        }
        def inf:double (1.0 / 0.0)
        if (value == inf) {
            return "Infinity"
        }
        if (value == (0.0 - inf)) {
            return "-Infinity"
        }
        def neg:boolean false
        def v:double value
        if (v < 0.0) {
            neg = true
            v = (0.0 - v)
        }
        def digits:string "0123456789abcdefghijklmnopqrstuvwxyz"
        def ip:int (to_int v)
        def out:string ""
        if (ip == 0) {
            out = "0"
        }
        while (ip > 0) {
            def d:int (ip % radix)
            def dEnd:int (d + 1)
            out = ((substring digits d dEnd) + out)
            ip = (to_int ((to_double ip) / (to_double radix)))
        }
        ; Fractional part, capped — an exact expansion can be unbounded in a
        ; base that does not divide the value evenly.
        def frac:double (v - (to_double (to_int v)))
        if (frac > 0.0) {
            out = (out + ".")
            def guard:int 0
            while ((frac > 0.0) && (guard < 20)) {
                frac = (frac * (to_double radix))
                def fd:int (to_int frac)
                def fEnd:int (fd + 1)
                out = (out + (substring digits fd fEnd))
                frac = (frac - (to_double fd))
                guard = (guard + 1)
            }
        }
        if neg {
            return ("-" + out)
        }
        return out
    }

    ; D-NUMFMT: Number.prototype.toFixed. The old version rounded with
    ; `to_int(x + 0.5)`, which truncates toward zero, so every negative number
    ; rounded the wrong way -- (-1.25).toFixed(1) answered "-1.2" instead of
    ; "-1.3" -- and it stringified NaN as "NaN.00". Sign is split off first and
    ; the magnitude formatted, which makes both signs behave the same.
    fn toFixedString:string (numVal:double decimals:int) {
        if (numVal != numVal) {
            return "NaN"
        }
        if (false == (this.isFiniteNum(numVal))) {
            if (numVal > 0.0) { return "Infinity" }
            return "-Infinity"
        }
        def neg:boolean (numVal < 0.0)
        def mag:double numVal
        if neg {
            mag = (0.0 - numVal)
        }
        ; A magnitude at or beyond 1e21 is rendered by ToString instead, per
        ; spec, because the fixed form would be meaningless. The bound is built
        ; by multiplication: a literal that large does not survive the Ranger
        ; lexer, which re-emits it in exponential form with a stray ".0".
        def e21:double (this.powNum(10.0 21))
        if (mag >= e21) {
            return (to_string numVal)
        }
        def body:string (this.fixedMagnitude(mag decimals))
        if neg {
            ; -0.004 to 1 place is "-0.0" in JS: the sign survives even when
            ; every digit rounds away.
            return ("-" + body)
        }
        return body
    }

    ; The digits of a NON-NEGATIVE magnitude with exactly `decimals` places.
    fn fixedMagnitude:string (mag:double decimals:int) {
        def multiplier:double 1.0
        def i:int 0
        while (i < decimals) {
            multiplier = (multiplier * 10.0)
            i = (i + 1)
        }
        def scaled:double (mag * multiplier)
        ; Round half away from zero on the magnitude, which is round-half-up
        ; once the sign is back on.
        def rounded:double (this.floorNum((scaled + 0.5)))
        ; Carry the digits out by hand: the double may not hold the integer
        ; exactly, but the string form of the rounded value does.
        def digits:string (this.integerDigits(rounded))
        if (decimals == 0) {
            return digits
        }
        def L:int (strlen digits)
        if (L <= decimals) {
            def pad:string "0."
            def z:int 0
            while (z < (decimals - L)) {
                pad = (pad + "0")
                z = (z + 1)
            }
            return (pad + digits)
        }
        def cut:int (L - decimals)
        return ((substring digits 0 cut) + ("." + (substring digits cut L)))
    }

    ; The decimal digits of a non-negative integral double, without an exponent
    ; and without a fractional part. `to_string` may hand back "1e+21" or
    ; "123.0" depending on magnitude, and neither is usable as a digit string.
    fn integerDigits:string (v:double) {
        def s:string (to_string v)
        def dot:int (indexOf s ".")
        if (dot >= 0) {
            s = (substring s 0 dot)
        }
        def e:int (indexOf s "e")
        if (e >= 0) {
            ; Exponential form: expand it rather than returning it verbatim.
            def mant:string (substring s 0 e)
            def expPart:string (substring s (e + 1) (strlen s))
            if ((substring expPart 0 1) == "+") {
                expPart = (substring expPart 1 (strlen expPart))
            }
            def ex@(optional):int (to_int expPart)
            if ex {
                def k:int (unwrap ex)
                def md:int (indexOf mant ".")
                def whole:string mant
                def frac:string ""
                if (md >= 0) {
                    whole = (substring mant 0 md)
                    frac = (substring mant (md + 1) (strlen mant))
                }
                def out:string (whole + frac)
                def need:int (k - (strlen frac))
                def z:int 0
                while (z < need) {
                    out = (out + "0")
                    z = (z + 1)
                }
                return out
            }
        }
        return s
    }

    ; D-NUMFMT: Number.prototype.toExponential -- one digit before the point,
    ; `fractionDigits` after, then the base-10 exponent.
    fn toExponentialString:string (numVal:double fractionDigits:int) {
        if (numVal != numVal) {
            return "NaN"
        }
        if (false == (this.isFiniteNum(numVal))) {
            if (numVal > 0.0) { return "Infinity" }
            return "-Infinity"
        }
        def neg:boolean (numVal < 0.0)
        def mag:double numVal
        if neg { mag = (0.0 - numVal) }
        def e:int 0
        if (mag != 0.0) {
            while (mag >= 10.0) {
                mag = (mag / 10.0)
                e = (e + 1)
            }
            while (mag < 1.0) {
                mag = (mag * 10.0)
                e = (e - 1)
            }
        }
        def body:string (this.fixedMagnitude(mag fractionDigits))
        ; Rounding the mantissa can carry it past 10, which moves the exponent.
        if ((strlen body) > 0) {
            def firstTwo:string (substring body 0 2)
            if (firstTwo == "10") {
                e = (e + 1)
                mag = (mag / 10.0)
                body = (this.fixedMagnitude(mag fractionDigits))
            }
        }
        def sign:string "+"
        def eAbs:int e
        if (e < 0) {
            sign = "-"
            eAbs = (0 - e)
        }
        def out:string (body + ("e" + (sign + (to_string eAbs))))
        if neg {
            return ("-" + out)
        }
        return out
    }

    ; D-NUMFMT: Number.prototype.toPrecision -- `precision` significant digits,
    ; in fixed form when the exponent is small enough and exponential otherwise.
    fn toPrecisionString:string (numVal:double precision:int) {
        if (numVal != numVal) {
            return "NaN"
        }
        if (false == (this.isFiniteNum(numVal))) {
            if (numVal > 0.0) { return "Infinity" }
            return "-Infinity"
        }
        if (numVal == 0.0) {
            return (this.toFixedString(0.0 (precision - 1)))
        }
        def mag:double numVal
        if (mag < 0.0) { mag = (0.0 - mag) }
        def e:int 0
        def scan:double mag
        while (scan >= 10.0) {
            scan = (scan / 10.0)
            e = (e + 1)
        }
        while (scan < 1.0) {
            scan = (scan * 10.0)
            e = (e - 1)
        }
        if ((e < (0 - 6)) || (e >= precision)) {
            return (this.toExponentialString(numVal (precision - 1)))
        }
        return (this.toFixedString(numVal ((precision - 1) - e)))
    }


    ; padStart / padEnd share everything but which side the filler goes on.
    fn padString:string (s:string args:[EvalValue] atStart:boolean) {
        def target:int 0
        if ((array_length args) > 0) {
            target = (to_int ((itemAt args 0).toNumber()))
        }
        def filler:string " "
        if ((array_length args) > 1) {
            def fv:EvalValue (itemAt args 1)
            if (false == (fv.isUndefined())) {
                filler = (fv.toString())
            }
        }
        if ((strlen filler) == 0) {
            return s
        }
        if (target <= (strlen s)) {
            return s
        }
        def pad:string ""
        while ((strlen pad) < (target - (strlen s))) {
            pad = (pad + filler)
        }
        def need:int (target - (strlen s))
        pad = (substring pad 0 need)
        if atStart {
            return (pad + s)
        }
        return (s + pad)
    }

    ; ToString for a value used as an ARRAY ELEMENT during join/toString: null
    ; and undefined render as empty, everything else by its own rules.
    fn elementToString:string (v:EvalValue) {
        if (v.isNull()) { return "" }
        if (v.isUndefined()) { return "" }
        if (v.isArray()) {
            return (this.arrayJoinString(v ","))
        }
        return (v.toString())
    }

    ; Array.prototype.join semantics, used by toString with a comma. Nested
    ; arrays flatten by recursion, which is why [[1,2],[3]] is "1,2,3".
    fn arrayJoinString:string (arr:EvalValue sep:string) {
        def out:string ""
        def i:int 0
        while (i < (array_length arr.arrayValue)) {
            if (i > 0) {
                out = (out + sep)
            }
            out = (out + (this.elementToString((itemAt arr.arrayValue i))))
            i = (i + 1)
        }
        return out
    }

    fn hasBuiltin:boolean (kind:string name:string) {

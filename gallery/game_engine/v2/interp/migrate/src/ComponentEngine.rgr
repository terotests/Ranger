                                            if (close > 0) {
                                                def gname:string (substring tmpl (i + 2) (i + close))
                                                def gidx:int 0
                                                def gk:int 1
                                                while (gk < (array_length names)) {
                                                    if ((itemAt names gk) == gname) {
                                                        gidx = gk
                                                        gk = (array_length names)
                                                    } {
                                                        gk = (gk + 1)
                                                    }
                                                }
                                                if (gidx > 0) {
                                                    if (gidx < (array_length m.capStart)) {
                                                        def gcs:int (itemAt m.capStart gidx)
                                                        if (gcs >= 0) {
                                                            out = (out + (this.cuSlice(subject gcs (itemAt m.capEnd gidx))))
                                                        }
                                                    }
                                                }
                                                i = (i + (close + 1))
                                            } {
                                                out = (out + ch)
                                                i = (i + 1)
                                            }
                                        } {
                                            out = (out + ch)
                                            i = (i + 1)
                                        }
                                    } {
                                    def d1:int (charAt tmpl (i + 1))
                                    if ((d1 >= 48) && (d1 <= 57)) {
                                        ; Two digits when that names a real
                                        ; group, otherwise one.
                                        def num:int (d1 - 48)
                                        def used:int 2
                                        if ((i + 2) < n) {
                                            def d2:int (charAt tmpl (i + 2))
                                            if ((d2 >= 48) && (d2 <= 57)) {
                                                def two:int ((num * 10) + (d2 - 48))
                                                if (two < (array_length m.capStart)) {
                                                    num = two
                                                    used = 3
                                                }
                                            }
                                        }
                                        if ((num > 0) && (num < (array_length m.capStart))) {
                                            def cs:int (itemAt m.capStart num)
                                            def ce:int (itemAt m.capEnd num)
                                            if (cs >= 0) {
                                                out = (out + (this.cuSlice(subject cs ce)))
                                            }
                                            i = (i + used)
                                        } {
                                            out = (out + ch)
                                            i = (i + 1)
                                        }
                                    } {
                                        out = (out + ch)
                                        i = (i + 1)
                                    }
                                    }
                                }
                            }
                        }
                    }
                } {
                    out = (out + ch)
                    i = (i + 1)
                }
            } {
                out = (out + ch)
                i = (i + 1)
            }
        }
        return out
    }

    ; The arguments a function replacer receives: the match, each capture, the
    ; offset and the whole subject.
    fn replacerArgs:[EvHandle] (m:RegexMatch subject:string) {
        def out:[EvHandle]
        push out (EvValueBridge.taggedString((this.cuSlice(subject m.start m.end))))
        def gi:int 1
        while (gi < (array_length m.capStart)) {
            def cs:int (itemAt m.capStart gi)
            def ce:int (itemAt m.capEnd gi)
            if (cs < 0) {
                push out (EvValueBridge.taggedUndefined())
            } {
                push out (EvValueBridge.taggedString((this.cuSlice(subject cs ce))))
            }
            gi = (gi + 1)
        }
        push out (EvHandle.fromInt(m.start))
        push out (EvValueBridge.taggedString(subject))
        return out
    }

    ; D-ARRAYLIKE: the optional thisArg every higher-order Array method takes as
    ; its SECOND argument. It was ignored, so a callback written against a
    ; receiver -- `arr.filter(function (v) { return v === this.n; }, ctx)` --
    ; saw undefined for `this` and quietly filtered everything out. A callback
    ; that already carries its own binding (an arrow, or a bound function) keeps
    ; it, which is why the existing binding is checked first.
    fn withCallbackThis:EvHandle (cb:EvHandle args:[EvHandle]) {
        if ((array_length args) < 2) {
            return cb
        }
        if (cb.hasBoundThis()) {
            return cb
        }
        return (cb.withThisForCall((itemAt args 1)))
    }

    ; D-ARRAYLIKE: the elements of any array-like receiver -- ToLength(this.length)
    ; entries read by index, with a missing index reading as undefined. This is
    ; how every non-mutating Array.prototype method is specified to see its
    ; receiver, and it is what lets `arguments` and `{length: n, …}` be passed
    ; through .call().
    ; D-ARRAYLIKE: copy a scratch array's elements back onto the array-like
    ; receiver a generic mutator ran against. Indices at or past the new length
    ; are DELETED -- `pop` on `{0:a, 1:b, length:2}` has to leave index 1 gone,
    ; not merely unreachable through `length`.
    fn writeArrayLikeBack:void (recv:EvHandle scratch:EvHandle oldLen:int) {
        def n:int (scratch.denseLen())
        def i:int 0
        while (i < n) {
            def el:EvHandle (scratch.arrayItemAt(i))
            if (el.isHole()) {
                recv.removeOwnData((to_string i))
            } {
                recv.setMember((to_string i) el)
            }
            i = (i + 1)
        }
        def d:int n
        while (d < oldLen) {
            recv.removeOwnData((to_string d))
            d = (d + 1)
        }
        recv.setMember("length" (EvHandle.fromInt(n)))
    }

    ; D-ARRAYLIKE: how far a SHORT-CIRCUITING predicate iterates. The element
    ; list is materialised through ToUint32, which answers 0 for a `length` of
    ; Infinity -- so `every` on `{0: 9, length: Infinity}` visited nothing and
    ; answered true where it must visit index 0 and answer false. ToLength is
    ; the right conversion, clamped to the dense cap here because `every` and
    ; `some` stop at the first decisive element and a real program never walks
    ; further.
    fn arrayLikeIterLen:int (recv:EvHandle materialised:int) {
        if (recv.isArrayValue()) {
            return materialised
        }
        def lv:EvHandle (this.getPropertyValue(recv "length"))
        if scriptThrew {
            return materialised
        }
        def d:double (this.toNumberOf(lv))
        if scriptThrew {
            return materialised
        }
        if (d != d) {
            return materialised
        }
        def t:double (this.truncNum(d))
        if (t <= 0.0) {
            return 0
        }
        if (t > 10000000.0) {
            return 10000000
        }
        def n:int (to_int t)
        if (n < materialised) {
            return materialised
        }
        return n
    }

    fn arrayLikeElements:[EvHandle] (v:EvHandle) {
        def out:[EvHandle]
        if (v.isArrayValue()) {
            return (v.itemsOf())
        }
        if (v.isString()) {
            ; D-UTF8: one element per code UNIT, which is what indexing a
            ; string yields.
            def sstr:string (v.stringOf())
            def slen:int (v.strCodeUnitLength())
            def si:int 0
            while (si < slen) {
                push out (EvValueBridge.taggedString((this.cuSlice(sstr si (si + 1)))))
                si = (si + 1)
            }
            return out
        }
        ; D-ARRAYLIKE: `length` is read with a full [[Get]] -- it may be an
        ; ACCESSOR, and the spec calls it -- and ToUint32'd. Reading the raw map
        ; skipped the getter, so a test that asserts the length was accessed saw
        ; nothing happen.
        def lenV:EvHandle (this.getPropertyValue(v "length"))
        if scriptThrew {
            return out
        }
        if (lenV.isUndefined()) {
            return out
        }
        ; D-STRNUM: the conversion goes through the engine's ToNumber, which
        ; follows the StringNumericLiteral grammar -- a `length` of "0x0002" is
        ; 2, not NaN. And it is ToLENGTH, not ToUint32: a NEGATIVE length is
        ; zero, where the uint32 wrap turned `length: -4294967294` into 2 and
        ; made every array-like method visit elements it must not see.
        def lenD:double (this.toNumberOf(lenV))
        if scriptThrew {
            return out
        }
        if (lenD != lenD) { lenD = 0.0 }
        def lenT:double (this.truncNum(lenD))
        if (lenT < 0.0) { lenT = 0.0 }
        if (lenT > 10000000.0) { lenT = 10000000.0 }
        def n:int (to_int lenT)
        if scriptThrew {
            return out
        }
        if (n < 0) {
            return out
        }
        ; A hostile length is a hang, not a test failure, so it is capped.
        if (n > 1000000) {
            n = 1000000
        }
        def i:int 0
        while (i < n) {
            def key:string (to_string i)
            ; D-HOLES: an index the object does not have -- anywhere up its
            ; prototype chain -- is ABSENT, not undefined, so the iteration
            ; methods skip it exactly as they skip an array hole. Pushing the
            ; undefined read made `Array.prototype.filter.call({0:0,2:2,
            ; length:3}, …)` visit three elements instead of two, and an index
            ; INHERITED from Object.prototype was missed entirely.
            if (this.objHasKeyUpChain(v key)) {
                push out (this.getPropertyValue(v key))
                if scriptThrew {
                    return out
                }
            } {
                push out (EvValueBridge.taggedHole())
            }
            i = (i + 1)
        }
        return out
    }

    ; D-ARRAYLIKE: one element read AT THE MOMENT it is needed. The iteration
    ; methods worked from a snapshot taken before the first callback ran, so a
    ; callback that shortened the array or deleted an element was not observed --
    ; the spec re-asks HasProperty and [[Get]] on every step. An absent index
    ; answers the HOLE sentinel, which is exactly what the skip tests already
    ; look for, so no call site has to learn a new shape.
    fn arrayElemAt:EvHandle (recv:EvHandle idx:int) {
        if (recv.isArrayValue()) {
            ; D-ACCESSORS: an index redefined as an ACCESSOR --
            ; `Object.defineProperty(arr, "0", {get: …})` -- is a real property
            ; of the array and its getter runs. Reading the dense slot first
            ; skipped it, so a callback that mutates the array from inside such
            ; a getter never ran.
            def gkey:string (to_string idx)
            def gFnA:EvHandle (this.resolveGetterOn(recv gkey))
            if (gFnA.isFunction()) {
                return (this.getPropertyValue(recv gkey))
            }
            if (idx < (recv.denseLen())) {
                def slot:EvHandle (recv.arrayItemAt(idx))
                if (false == (slot.isHole())) {
                    return slot
                }
            }
            ; D-PROTO: an array HOLE is only absent on the array itself. The
            ; index may still be present up the chain -- `Array.prototype[1] = 1`
            ; makes `[0,,].concat()[1]` that value -- and reading the dense slot
            ; alone answered undefined for a property that exists.
            def akey:string (to_string idx)
            if (this.objHasKeyUpChain(recv akey)) {
                return (this.getPropertyValue(recv akey))
            }
            return (EvValueBridge.taggedHole())
        }
        if (recv.isString()) {
            if (idx < (recv.strCodeUnitLength())) {
                return (EvValueBridge.taggedString((this.cuSlice((recv.stringOf()) idx (idx + 1)))))
            }
            return (EvValueBridge.taggedHole())
        }
        def k:string (to_string idx)
        if (this.objHasKeyUpChain(recv k)) {
            return (this.getPropertyValue(recv k))
        }
        return (EvValueBridge.taggedHole())
    }

    ; D-ARRAYLIKE: call a method BY NAME on a value, the way guest code would --
    ; a guest-supplied function wins, otherwise the registry entry for the
    ; receiver's kind runs. Array.prototype.toLocaleString needs exactly this
    ; for each element.
    fn callMethodOnValue:EvHandle (recv:EvHandle name:string args:[EvHandle]) {
        def m:EvHandle (this.getPropertyValue(recv name))
        if (m.isFunction()) {
            if (m.hasFunctionNode()) {
                return (this.callFnValueWithValues((m.withThisForCall(recv)) args))
            }
            if (m.isBuiltinMethod()) {
                return (this.invokeBuiltin((m.builtinKindOf()) (m.builtinNameOf()) recv args))
            }
        }
        def rk:string (this.receiverKind(recv))
        if (this.hasBuiltin(rk name)) {
            return (this.invokeBuiltin(rk name recv args))
        }
        return (this.throwSpecError("TypeError" (name + " is not a function")))
    }

    ; D-ARRAYLIKE: join over the LIVE receiver -- each element read at the step
    ; that needs it, an absent/null/undefined one contributing the empty string,
    ; and everything else through ToString so an object runs its own.
    fn arrayJoinLive:EvHandle (recv:EvHandle sep:string) {
        def n:int (recv.arrayLength())
        if (false == (recv.isArrayValue())) {
            def lv:EvHandle (this.getPropertyValue(recv "length"))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            n = (this.toInt32Of(lv))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            if (n < 0) { n = 0 }
            if (n > 1000000) { n = 1000000 }
        }
        def out:string ""
        def i:int 0
        while (i < n) {
            if (i > 0) {
                out = (out + sep)
            }
            def v:EvHandle (this.arrayElemAt(recv i))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            def skip:boolean false
            if (v.isHole()) { skip = true }
            if (v.isNull()) { skip = true }
            if (v.isUndefined()) { skip = true }
            if (false == skip) {
                out = (out + (this.toStringOf(v)))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
            }
            i = (i + 1)
        }
        return (EvValueBridge.taggedString(out))
    }

    ; D-ARRAYLIKE: a full [[Get]] of one property -- runs an accessor found
    ; anywhere up the chain, and falls back to the plain data read. The value
    ; layer's getMember knows nothing about accessors, so every generic
    ; Array.prototype method read past them.
    fn getPropertyValue:EvHandle (obj:EvHandle key:string) {
        ; D-STRICT: `caller` and `arguments` are POISONED on a strict function
        ; and on a bound one -- reading either is a TypeError, which is how the
        ; spec removes the stack-walking sloppy mode allowed. The check lived
        ; only on the AST member path, and only `arguments` reached it there:
        ; `caller` was answered earlier and read as undefined, so
        ; `strictFn.caller`, `strictFn["caller"]` and `boundFn.caller` all came
        ; back undefined instead of throwing. Here it covers every reader.
        if (obj.isFunction()) {
            if ((key == "caller") || (key == "arguments")) {
                if (false == (obj.hasOwnAttrs(key))) {
                    if (this.functionIsStrict(obj)) {
                        return (this.throwSpecError("TypeError" ("'" + key + "' may not be accessed on a strict function")))
                    }
                }
            }
        }
        ; D-PROXY: the `get` trap, ahead of every other lookup rule.
        if (this.isProxyValue(obj)) {
            def gTgt:EvHandle (this.proxyTargetOf(obj))
            def gTrap:EvHandle (this.proxyTrap(obj "get"))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            if (gTrap.isFunction()) {
                def gArgs:[EvHandle]
                push gArgs gTgt
                push gArgs (EvValueBridge.taggedString(key))
                push gArgs obj
                def gOut:EvHandle (this.callProxyTrap(gTrap gArgs))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                ; D-PROXYINV: what the target holds NON-CONFIGURABLY constrains
                ; what the trap may answer. A frozen data property must come
                ; back unchanged, and a getter-less accessor must come back
                ; undefined; neither was checked, so a handler could contradict
                ; its own target.
                def gDesc:EvHandle (this.ownPropertyDescriptorOf(gTgt key))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                if (this.isDescriptorObject(gDesc)) {
                    if (false == ((this.descGet(gDesc "configurable")).toBool())) {
                        if (this.descHas(gDesc "value")) {
                            if (false == ((this.descGet(gDesc "writable")).toBool())) {
                                if (false == (this.sameValueOf(gOut (this.descGet(gDesc "value"))))) {
                                    return (this.throwSpecError("TypeError" "proxy get reported a different value for a non-writable, non-configurable property"))
                                }
                            }
                        } {
                            if ((this.descGet(gDesc "get")).isUndefined()) {
                                if (false == (gOut.isUndefined())) {
                                    return (this.throwSpecError("TypeError" "proxy get reported a value for a non-configurable accessor with no getter"))
                                }
                            }
                        }
                    }
                }
                return gOut
            }
            return (this.getPropertyValue(gTgt key))
        }
        ; D-ARGMAP: a mapped index reads the PARAMETER, which the body may have
        ; reassigned since the object was built.
        def mappedName:string (this.argMapName(obj key))
        if ((strlen mappedName) > 0) {
            def mapCtx:EvalContext (this.argMapScopeOf(obj))
            if (mapCtx.has(mappedName)) {
                return (mapCtx.lookup(mappedName))
            }
        }
        def g:EvHandle (this.resolveGetterOn(obj key))
        if (g.isFunction()) {
            def noArgsG:[EvHandle]
            if (g.hasFunctionNode()) {
                return (this.callFnValueWithValues((g.withThisForCall(obj)) noArgsG))
            }
            if (g.isBuiltinMethod()) {
                return (this.invokeBuiltin((g.builtinKindOf()) (g.builtinNameOf()) obj noArgsG))
            }
        }
        if (obj.hasSetterFor(key)) {
            if (false == (obj.hasOwnData(key))) {
                return (EvValueBridge.taggedUndefined())
            }
        }
        def direct:EvHandle (obj.getMember(key))
        if (false == (direct.isUndefined())) {
            return direct
        }
        ; D-PROTO: an ARRAY carries no prototype link of its own, so the value
        ; layer's chain walk stops at the array and an index defined on
        ; Array.prototype read as undefined. The engine knows the kind's
        ; prototype and can finish the walk.
        def chained:EvHandle (this.ownPropertyUpChain(obj key))
        if (false == (chained.isNull())) {
            return chained
        }
        return direct
    }

    ; `Symbol(description)`, the one rendering a symbol permits.
    fn symbolDisplayString:string (v:EvHandle) {
        def dsc:EvHandle (v.getMember("__symbol__"))
        def dstr:string ""
        if (dsc.isString()) { dstr = (dsc.stringOf()) }
        return ("Symbol(" + (dstr + ")"))
    }

    ; D-SYMKEY: the property key a symbol value stands for, or "" for anything
    ; that is not a symbol.
    fn symbolKeyOf:string (v:EvHandle) {
        if (false == (v.isObject())) { return "" }
        def idV@(optional):EvHandle (v.tryOwnData("__symid__"))
        if idV {
            def idH:EvHandle (unwrap idV)
            if (idH.isString()) {
                return (idH.stringOf())
            }
        }
        return ""
    }

    ; True for a symbol VALUE. `typeof` already answered "symbol" for these; the
    ; predicate is what the operations that must reject one need.
    fn isSymbolValue:boolean (v:EvHandle) {
        return ((strlen (this.symbolKeyOf(v))) > 0)
    }

    ; ToString: an object runs its own toString/valueOf, everything else answers
    ; for itself.
    fn toStringOf:string (v:EvHandle) {
        if (v.isString()) {
            return (v.stringOf())
        }
        ; D-SYMKEY: ToString of a SYMBOL is a TypeError. It is the one
        ; conversion a symbol refuses, which is what makes `"" + sym` and
        ; `"a".startsWith(sym)` throw -- and what a long tail of
        ; `return-abrupt-from-*-as-symbol` fixtures check. The two callers that
        ; may render one -- String(sym) and Symbol.prototype.toString -- go
        ; through symbolDisplayString instead.
        if (this.isSymbolValue(v)) {
            def _st:EvHandle (this.throwSpecError("TypeError" "Cannot convert a Symbol value to a string"))
            return ""
        }
        ; D-BIGINT: a BigInt renders as its digits with no `n` -- the suffix is
        ; literal syntax, not part of the value.
        if (this.isBigIntValue(v)) {
            def strBig:BigNum (this.bigNumOf(v))
            return (strBig.toDecimal())
        }
        def p:EvHandle v
        ; Functions convert too -- a guest override of Function.prototype.toString
        ; has to be honoured, and the engine's debug form is not the answer.
        if (v.isObject()) { p = (this.toPrimitive(v true)) }
        if (v.isArrayValue()) { p = (this.toPrimitive(v true)) }
        if (v.isFunction()) { p = (this.toPrimitive(v true)) }
        if (p.isString()) {
            ; Bind before returning. `p` here is a value this scope OWNS --
            ; toPrimitive handed back a fresh one -- so returning its stringValue
            ; directly gave the caller a pointer into a value that scope exit
            ; then released, and `String(Array.prototype)` read the freed bytes.
            ; Binding takes a private copy the caller can outlive.
            def owned:string (p.stringOf())
            return owned
        }
        return (p.toString())
    }

    ; ToPropertyKey. A property name is whatever ToString says, so an object or
    ; an array used as a key runs its own toString: `gOPD(obj, [1])` asks for
    ; "1". The raw EvHandle.toString() is the engine's DEBUG rendering, which
    ; for an array is not the same string at all.
    ; D-ATTRS: frozen and sealed are COMPUTED, not remembered. An object is
    ; sealed when it is not extensible and every own property is
    ; non-configurable; frozen additionally needs every data property to be
    ; non-writable. Object.freeze sets a flag, but an object can reach the same
    ; state one defineProperty at a time -- and then `Object.isFrozen` has to
    ; agree.
    fn computeSealed:boolean (v:EvHandle wantFrozen:boolean) {
        if (v.isExtensible()) {
            return false
        }
        def ks:[string] (this.objectKeys(v))
        def i:int 0
        while (i < (array_length ks)) {
            def k:string (itemAt ks i)
            if (false == (this.isHiddenInstanceKey(k))) {
                if (v.isConfigurable(k)) {
                    return false
                }
                if wantFrozen {
                    def isAcc:boolean false
                    if (v.hasOwnGetter(k)) { isAcc = true }
                    if (v.hasOwnSetter(k)) { isAcc = true }
                    if (false == isAcc) {
                        if (v.isWritable(k)) {
                            return false
                        }
                    }
                }
            }
            i = (i + 1)
        }
        ; An ARRAY's elements are properties too, and a length that can still
        ; move means the array is neither sealed nor frozen.
        if (v.isArrayValue()) {
            if (v.hasOwnAttrs("length")) {
                if wantFrozen {
                    if (v.isWritable("length")) {
                        return false
                    }
                }
            } {
                if wantFrozen {
                    return false
                }
            }
        }
        return true
    }

    ; The value of an OWN property found somewhere up the prototype chain, or
    ; the null sentinel when no link holds it. The receiver itself is skipped:
    ; its own properties are answered before this point.
    ; D-ATTRS: `length`, `name` and `prototype` on a function -- and `length`
    ; on an array -- are SYNTHESISED rather than stored, so no attribute record
    ; exists for them and the "absent means made by assignment, all three true"
    ; default called every one of them enumerable. Each is non-enumerable per
    ; spec, which is what `propertyIsEnumerable` and a for-in over a function
    ; both read. A RECORDED attribute still wins: defineProperty on one of
    ; these names stores a real entry, and that entry is the answer.
    fn ownKeyEnumerable:boolean (recv:EvHandle key:string) {
        if (recv.hasOwnAttrs(key)) {
            return (recv.isEnumerable(key))
        }
        if (recv.isFunction()) {
            if (key == "length") { return false }
            if (key == "name") { return false }
            if (key == "prototype") { return false }
            if (key == "caller") { return false }
            if (key == "arguments") { return false }
        }
        if (recv.isArrayValue()) {
            if (key == "length") { return false }
        }
        return (recv.isEnumerable(key))
    }

    fn ownPropertyUpChain:EvHandle (obj:EvHandle key:string) {
        def walk:EvHandle (this.protoOfValue(obj))
        def steps:int 0
        while (steps < 16) {
            if (walk.isNull()) {
                return (EvValueBridge.taggedNull())
            }
            if (walk.hasOwnData(key)) {
                return (walk.getOwnData(key))
            }
            ; A prototype may itself be an ARRAY -- Array.prototype is one -- and
            ; then an index property lives in its elements rather than its map.
            if (walk.isArrayValue()) {
                def wi:int (this.canonicalArrayIndex(key))
                if (wi >= 0) {
                    if (wi < (walk.denseLen())) {
                        def wslot:EvHandle (walk.arrayItemAt(wi))
                        if (false == (wslot.isHole())) {
                            return wslot
                        }
                    }
                }
            }
            walk = (this.protoOfValue(walk))
            steps = (steps + 1)
        }
        return (EvValueBridge.taggedNull())
    }

    ; D-ACCESSORS: the accessor a receiver would actually run, including one put
    ; on its KIND's prototype. An array and a function carry no protoRef, so
    ; findGetter/findSetter alone never saw `Array.prototype.prop` defined as an
    ; accessor -- the write created an own property instead of calling the setter.
    fn resolveGetterOn:EvHandle (obj:EvHandle key:string) {
        def own:EvHandle (obj.findGetter(key 0))
        if (own.isFunction()) {
            return own
        }
        ; An OWN array element shadows an accessor inherited from
        ; Array.prototype under the same index.
        if (obj.isArrayValue()) {
            def oi:int (this.canonicalArrayIndex(key))
            if (oi >= 0) {
                if (oi < (obj.denseLen())) {
                    if (false == ((EvValueBridge.isHole((obj.arrayItemAt(oi)))))) {
                        return own
                    }
                }
            }
        }
        if (false == (obj.isObject())) {
            def cn:string (this.ctorNameForKind((this.receiverKind(obj))))
            if ((strlen cn) > 0) {
                def found@(optional):EvHandle (get builtinProtos cn)
                if (!null? found) {
                    def kp:EvHandle (unwrap found)
                    return (kp.findGetter(key 0))
                }
            }
        }
        return own
    }

    fn resolveSetterOn:EvHandle (obj:EvHandle key:string) {
        def own:EvHandle (obj.findSetter(key 0))
        if (own.isFunction()) {
            return own
        }
        if (obj.isArrayValue()) {
            def oj:int (this.canonicalArrayIndex(key))
            if (oj >= 0) {
                if (oj < (obj.denseLen())) {
                    if (false == ((EvValueBridge.isHole((obj.arrayItemAt(oj)))))) {
                        return own
                    }
                }
            }
        }
        if (false == (obj.isObject())) {
            def cn:string (this.ctorNameForKind((this.receiverKind(obj))))
            if ((strlen cn) > 0) {
                def found@(optional):EvHandle (get builtinProtos cn)
                if (!null? found) {
                    def kp:EvHandle (unwrap found)
                    return (kp.findSetter(key 0))
                }
            }
        }
        return own
    }

    ; D-ARRAYSPARSE: a canonical ARRAY INDEX, or -1 when the key is an ordinary
    ; property name. The distinction is exact and observable: `x["0"]` reaches the
    ; element, while `x["00"]`, `x[-1]`, `x["1.0"]` and `x[true]` are properties
    ; that do not move `length`. Only ToString(ToUint32(k)) === k qualifies, and
    ; 2^32-1 is deliberately excluded -- it is the one uint32 that is not an index.
    fn canonicalArrayIndex:int (key:string) {
        ; The int lane. An index past 2^31 cannot ride in a C++ int (to_int
        ; would be UB), so it answers -1 here -- the funnels that must see
        ; such an index exactly (far-index writes, length shrink) use the
        ; D variant. Indexes that large are far past the dense cap on every
        ; path, so an int-lane caller treats them as ordinary properties,
        ; which is where they are stored anyway.
        def v:double (this.canonicalArrayIndexD(key))
        if (v < 0.0) {
            return (0 - 1)
        }
        if (v > 2147483000.0) {
            return (0 - 1)
        }
        return (to_int v)
    }

    fn canonicalArrayIndexD:double (key:string) {
        def n:int (strlen key)
        if (n == 0) {
            return (0.0 - 1.0)
        }
        if (n > 10) {
            return (0.0 - 1.0)
        }
        def i:int 0
        while (i < n) {
            def c:int (charAt key i)
            if (c < 48) { return (0.0 - 1.0) }
            if (c > 57) { return (0.0 - 1.0) }
            i = (i + 1)
        }
        ; A leading zero means the text is not ToString of the number.
        if (n > 1) {
            if ((charAt key 0) == 48) {
                return (0.0 - 1.0)
            }
        }
        def v:double 0.0
        def j:int 0
        while (j < n) {
            v = ((v * 10.0) + (to_double ((charAt key j) - 48)))
            j = (j + 1)
        }
        if (v >= 4294967295.0) {
            return (0.0 - 1.0)
        }
        return v
    }

    fn toPropertyKey:string (v:EvHandle) {
        if (v.isString()) {
            return (v.stringOf())
        }
        ; D-SYMKEY: a SYMBOL is a property key in its own right. Running it
        ; through ToString made every symbol key "[object Object]", so all of
        ; them were the same key -- and `o[Symbol.iterator]` collided with
        ; `o[Symbol()]`.
        def symK:string (this.symbolKeyOf(v))
        if ((strlen symK) > 0) {
            return symK
        }
        def p:EvHandle v
        if (v.isObject()) { p = (this.toPrimitive(v true)) }
        if (v.isArrayValue()) { p = (this.toPrimitive(v true)) }
        if (v.isFunction()) { p = (this.toPrimitive(v true)) }
        if (p.isString()) {
            ; Bind before returning. `p` here is a value this scope OWNS --
            ; toPrimitive handed back a fresh one -- so returning its stringValue
            ; directly gave the caller a pointer into a value that scope exit
            ; then released, and `String(Array.prototype)` read the freed bytes.
            ; Binding takes a private copy the caller can outlive.
            def owned:string (p.stringOf())
            return owned
        }
        return (p.toString())
    }

    ; ToPropertyDescriptor rejects anything that is not an Object -- which
    ; includes arrays and functions, so the check cannot simply be "is a plain
    ; object". `Object.defineProperty(o, 'k', function () {})` is legal and
    ; defines an undefined-valued property.
    ; D-DEFINEOWN: the properties-object step shared by Object.defineProperties
    ; and Object.create's second argument. Its OWN ENUMERABLE keys are visited,
    ; each value is read with a full [[Get]] so an accessor on the properties
    ; object runs, and every descriptor is validated BEFORE any is applied --
    ; which is what makes a bad one later in the map leave the target untouched.
    ; Object.create used to have a copy of this that validated nothing and read
    ; the raw map, so a getter-supplied descriptor produced nothing at all.
    fn applyDescriptorMap:string (target:EvHandle rawDescs:EvHandle) {
        ; The properties argument is ToObject'd, not required to be an object:
        ; `Object.defineProperties(o, false)` boxes the boolean, finds no own
        ; enumerable property on it, and quietly returns o. Only null and
        ; undefined are a TypeError, and ToObject raises that itself.
        if ((rawDescs.isNull()) || (rawDescs.isUndefined())) {
            return "Properties must be an object"
        }
        def descs:EvHandle (this.toObjectValue(rawDescs))
        if scriptThrew {
            return ""
        }
        if (false == (this.isDescriptorObject(descs))) {
            return "Properties must be an object"
        }
        def dkeys:[string] (this.objectEnumerableKeys(descs))
        def collected:[EvHandle]
        def names:[string]
        def i:int 0
        while (i < (array_length dkeys)) {
            def k:string (itemAt dkeys i)
            if (false == (this.isHiddenInstanceKey(k))) {
                def d:EvHandle (this.descGet(descs k))
                if scriptThrew {
                    return ""
                }
                if (false == (this.isDescriptorObject(d))) {
                    return "Property description must be an object"
                }
                def vErr:string (this.descriptorError(d))
                if ((strlen vErr) > 0) {
                    return vErr
                }
                push collected d
                push names k
            }
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length names)) {
            def aErr:string (this.definePropertyOn(target (itemAt names j) (itemAt collected j)))
            if ((strlen aErr) > 0) {
                return aErr
            }
            if scriptThrew {
                return ""
            }
            j = (j + 1)
        }
        return ""
    }

    fn isDescriptorObject:boolean (v:EvHandle) {
        if (v.isObject()) { return true }
        if (v.isArrayValue()) { return true }
        if (v.isFunction()) { return true }
        if (v.isMap()) { return true }
        if (v.isSet()) { return true }
        return false
    }

    ; D-DEFINEOWN: one [[DefineOwnProperty]], shared by Object.defineProperty and
    ; Object.defineProperties. The two had separate copies and only the singular
    ; form validated anything, so `Object.defineProperties(o, {p: true})` quietly
    ; created `p` with value undefined instead of throwing, and the plural form
    ; would happily redefine a non-configurable property.
    ;
    ; Returns "" on success, or the TypeError message to raise.
    ; D-DEFINEOWN: reading a field OF THE DESCRIPTOR is a full [[Get]] -- it runs
    ; an accessor and it walks the prototype chain. Reading `objectMap` directly
    ; missed both, so a descriptor whose `value` was a getter, or inherited from
    ; a prototype, defined nothing. That is the single largest failure family in
    ; Object.defineProperty and Object.defineProperties.
    fn descHas:boolean (desc:EvHandle key:string) {
        def walk:EvHandle desc
        def steps:int 0
        while (steps < 16) {
            if (walk.hasOwnData(key)) { return true }
            if (walk.hasOwnGetter(key)) { return true }
            if (walk.hasOwnSetter(key)) { return true }
            def nxt:EvHandle (this.protoOfValue(walk))
            if (nxt.isNull()) {
                return false
            }
            walk = nxt
            steps = (steps + 1)
        }
        return false
    }

    fn descGet:EvHandle (desc:EvHandle key:string) {
        ; One ordered walk, deciding at EACH level before going up. Asking for
        ; the getter first walked the whole chain and let an INHERITED accessor
        ; beat an OWN data property, which is backwards -- the nearest holder
        ; wins whichever kind it is.
        def walk:EvHandle desc
        def steps:int 0
        while (steps < 16) {
            if (walk.hasOwnGetter(key)) {
                def gFn:EvHandle (walk.getOwnGetter(key))
                if (gFn.isFunction()) {
                    def noArgs:[EvHandle]
                    return (this.callFnValueWithValues((gFn.withThisForCall(desc)) noArgs))
                }
            }
            ; A set-only accessor reads as undefined and does NOT fall through
            ; to whatever the prototype holds.
            if (walk.hasOwnSetter(key)) {
                return (EvValueBridge.taggedUndefined())
            }
            if (walk.hasOwnData(key)) {
                return (walk.getOwnData(key))
            }
            def nxt:EvHandle (this.protoOfValue(walk))
            if (nxt.isNull()) {
                return (EvValueBridge.taggedUndefined())
            }
            walk = nxt
            steps = (steps + 1)
        }
        return (EvValueBridge.taggedUndefined())
    }

    fn definePropertyOn:string (obj:EvHandle key:string desc:EvHandle) {
        ; D-PROXY: the `defineProperty` trap. A falsy answer is a rejection,
        ; which the caller turns into a throw or a `false` as its own rules say.
        if (this.isProxyValue(obj)) {
            def pTgt:EvHandle (this.proxyTargetOf(obj))
            def pTrap:EvHandle (this.proxyTrap(obj "defineProperty"))
            if scriptThrew {
                return ""
            }
            if (pTrap.isFunction()) {
                def pArgs:[EvHandle]
                push pArgs pTgt
                push pArgs (EvValueBridge.taggedString(key))
                push pArgs desc
                def pRes:EvHandle (this.callProxyTrap(pTrap pArgs))
                if scriptThrew {
                    return ""
                }
                if (pRes.toBool()) {
                    ; D-PROXYINV: a define the trap CLAIMS to have made must be
                    ; one the target could actually accept. A new property needs
                    ; an extensible target; a non-configurable claim needs a
                    ; non-configurable property already there; and a
                    ; redefinition the target itself would refuse cannot be
                    ; reported as done.
                    def pTd:EvHandle (this.ownPropertyDescriptorOf(pTgt key))
                    if scriptThrew {
                        return ""
                    }
                    def pHas:boolean (this.isDescriptorObject(pTd))
                    def wantNonConf:boolean false
                    if (this.descHas(desc "configurable")) {
                        if (false == ((this.descGet(desc "configurable")).toBool())) {
                            wantNonConf = true
                        }
                    }
                    if (false == pHas) {
                        if (false == (pTgt.isExtensible())) {
                            return "proxy defineProperty added a property to a non-extensible target"
                        }
                        if wantNonConf {
                            return "proxy defineProperty reported a non-configurable define for a property the target does not have"
                        }
                        return ""
                    }
                    if wantNonConf {
                        if ((this.descGet(pTd "configurable")).toBool()) {
                            return "proxy defineProperty reported a non-configurable define for a configurable target property"
                        }
                    }
                    ; The redefinition itself has to be legal against what is
                    ; there -- the same rule an ordinary define obeys.
                    def pRe:string (this.redefineError(pTgt key desc))
                    if ((strlen pRe) > 0) {
                        return ("proxy defineProperty reported an incompatible descriptor: " + pRe)
                    }
                    return ""
                }
                return "proxy defineProperty trap returned falsish"
            }
            return (this.definePropertyOn(pTgt key desc))
        }
        if (false == (this.isDescriptorObject(desc))) {
            return "Property description must be an object"
        }
        def dErr:string (this.descriptorError(desc))
        if ((strlen dErr) > 0) {
            return dErr
        }
        ; D-ARRAYDEFINE: an ARRAY has its own [[DefineOwnProperty]] (15.4.5.1).
        ; `length` is a real property whose write resizes, and an index defines
        ; an element and may push `length` out. Neither went anywhere near the
        ; elements before -- `Object.defineProperty(a, "length", {value: 0})`
        ; stored a stray property and left the array as it was.
        if (obj.isArrayValue()) {
            if (key == "length") {
                return (this.defineArrayLength(obj desc))
            }
            def elemIdx:double (this.canonicalArrayIndexD(key))
            if (elemIdx >= 0.0) {
                if (elemIdx <= 10000000.0) {
                    return (this.defineArrayIndex(obj (to_int elemIdx) desc))
                }
                ; Past the dense store the element is an ordinary property, but
                ; it still moves the length.
                def farErr:string (this.definePlainProperty(obj key desc))
                if ((strlen farErr) > 0) {
                    return farErr
                }
                if ((elemIdx + 1.0) > (obj.arrayLengthD())) {
                    obj.setDeclaredLengthD((elemIdx + 1.0))
                }
                return ""
            }
        }
        def rErr:string (this.redefineError(obj key desc))
        if ((strlen rErr) > 0) {
            return rErr
        }
        return (this.definePlainProperty(obj key desc))
    }

    ; The ordinary [[DefineOwnProperty]], after the array-specific rules and the
    ; redefinition check have had their say.
    fn definePlainProperty:string (obj:EvHandle key:string desc:EvHandle) {
        ; D-ARGMAP: defining a mapped index with a VALUE writes the parameter
        ; too -- the two are one binding, and leaving the parameter behind made
        ; a later read through the mapping answer the stale one.
        def dmName:string (this.argMapName(obj key))
        if ((strlen dmName) > 0) {
            if (this.descHas(desc "value")) {
                def dmCtx:EvalContext (this.argMapScopeOf(obj))
                if (dmCtx.has(dmName)) {
                    dmCtx.assign(dmName (this.descGet(desc "value")))
                }
            }
            ; §9.4.4.2: making a mapped index NON-WRITABLE breaks the mapping.
            ; The map survived, so a later `arguments[0] = x` still wrote the
            ; parameter through it and the refusal never happened.
            if (this.descHas(desc "writable")) {
                if (false == ((this.descGet(desc "writable")).toBool())) {
                    this.unmapArgIndex(obj key)
                }
            }
            ; An accessor descriptor breaks it as well: the property is no
            ; longer a data property, so there is nothing to keep in step.
            if ((this.descHas(desc "get")) || (this.descHas(desc "set"))) {
                this.unmapArgIndex(obj key)
            }
        }
        ; D-ATTRS: an attribute the descriptor does not mention KEEPS its current
        ; value on an existing property, and defaults to FALSE on a new one --
        ; unlike plain assignment, which defaults them all true. Taking the
        ; descriptor's `undefined` as false made every redefinition silently
        ; strip the flags the property already had.
        def existed:boolean false
        if (obj.hasOwnData(key)) { existed = true }
        if (obj.hasOwnGetter(key)) { existed = true }
        if (obj.hasOwnSetter(key)) { existed = true }
        def newW:boolean false
        def newE:boolean false
        def newC:boolean false
        if existed {
            newW = (obj.isWritable(key))
            newE = (obj.isEnumerable(key))
            newC = (obj.isConfigurable(key))
        }
        if (this.descHas(desc "writable")) {
            newW = ((this.descGet(desc "writable")).toBool())
        }
        if (this.descHas(desc "enumerable")) {
            newE = ((this.descGet(desc "enumerable")).toBool())
        }
        if (this.descHas(desc "configurable")) {
            newC = ((this.descGet(desc "configurable")).toBool())
        }
        def gv:EvHandle (this.descGet(desc "get"))
        def sv:EvHandle (this.descGet(desc "set"))
        if ((this.descHas(desc "get")) || (this.descHas(desc "set"))) {
            ; D-ACCESSORS: a real accessor property. The functions are stored
            ; apart from objectMap so the property is never mistaken for a data
            ; one -- and turning a DATA property into an accessor has to remove
            ; the old value, or the descriptor still reports value/writable.
            if (obj.hasOwnData(key)) {
                obj.clearDataSlot(key)
            }
            ; A half the descriptor MENTIONS is replaced -- `{set: undefined}`
            ; really does remove the setter -- and a half it omits is kept.
            if (this.descHas(desc "get")) {
                obj.clearGetterOnly(key)
                if (gv.isFunction()) {
                    obj.defineGetter(key gv)
                }
            }
            if (this.descHas(desc "set")) {
                obj.clearSetterOnly(key)
                if (sv.isFunction()) {
                    obj.defineSetter(key sv)
                }
            }
            ; `{get: undefined}` is still an ACCESSOR descriptor: the property
            ; exists, reads as undefined, and reports get/set rather than
            ; value/writable. Recording nothing at all made it vanish.
            if (false == (obj.hasOwnGetter(key))) {
                if (false == (obj.hasOwnSetter(key))) {
                    obj.defineGetter(key (EvValueBridge.taggedUndefined()))
                }
            }
            ; An accessor has no writable attribute of its own.
            obj.setAttrs(key false newE newC)
            return ""
        }
        ; §6.2.5.6: a GENERIC descriptor -- one that mentions neither value nor
        ; writable nor get nor set -- changes only the attributes and leaves the
        ; property's KIND alone. Falling through to the data branch turned an
        ; accessor into a data property holding undefined, so
        ; `defineProperty(o, "f", {enumerable: true})` on a getter made `o.f`
        ; read undefined and report value/writable.
        def isDataDesc:boolean false
        if (this.descHas(desc "value")) { isDataDesc = true }
        if (this.descHas(desc "writable")) { isDataDesc = true }
        def wasAccessor:boolean false
        if (obj.hasOwnGetter(key)) { wasAccessor = true }
        if (obj.hasOwnSetter(key)) { wasAccessor = true }
        if (wasAccessor) {
            if (false == isDataDesc) {
                ; Still an accessor; an accessor has no writable attribute.
                obj.setAttrs(key false newE newC)
                return ""
            }
        }
        ; Turning an ACCESSOR into a data property drops the functions.
        if (obj.hasOwnGetter(key)) {
            obj.clearAccessor(key)
        }
        if (obj.hasOwnSetter(key)) {
            obj.clearAccessor(key)
        }
        ; Written through the raw map because setMember would refuse a second
        ; defineProperty on a non-writable property, while redefining a
        ; CONFIGURABLE one is allowed.
        def newVal:EvHandle (EvValueBridge.taggedUndefined())
        if existed {
            if (obj.hasOwnData(key)) {
                newVal = (obj.getOwnData(key))
            }
        }
        if (this.descHas(desc "value")) {
            newVal = (this.descGet(desc "value"))
        }
        obj.putOwnData(key newVal)
        obj.setAttrs(key newW newE newC)
        return ""
    }

    ; definePropertyOn reports a failure as a message. Almost every one is a
    ; TypeError, but the array-length rules produce a RangeError, so the kind
    ; travels with the message behind an "@Kind@" prefix rather than as a second
    ; return value Ranger cannot give.
    fn throwDefineError:EvHandle (err:string) {
        def n:int (strlen err)
        if (n > 1) {
            if ((substring err 0 1) == "@") {
                def i:int 1
                while (i < n) {
                    if ((substring err i (i + 1)) == "@") {
                        def kind:string (substring err 1 i)
                        def msg:string (substring err (i + 1) n)
                        return (this.throwSpecError(kind msg))
                    }
                    i = (i + 1)
                }
            }
        }
        return (this.throwSpecError("TypeError" err))
    }

    ; D-ARRAYDEFINE: `Object.defineProperty(arr, "length", desc)`. The value is
    ; ToUint32 and must equal ToNumber of the same descriptor field, or it is a
    ; RangeError -- `{value: undefined}` and `{value: 1.5}` both are. length is
    ; never enumerable or configurable, and asking for either is a TypeError.
    fn defineArrayLength:string (obj:EvHandle desc:EvHandle) {
        if (this.descHas(desc "get")) {
            return "cannot redefine array length as an accessor"
        }
        if (this.descHas(desc "set")) {
            return "cannot redefine array length as an accessor"
        }
        if (this.descHas(desc "configurable")) {
            if ((this.descGet(desc "configurable")).toBool()) {
                return "cannot make array length configurable"
            }
        }
        if (this.descHas(desc "enumerable")) {
            if ((this.descGet(desc "enumerable")).toBool()) {
                return "cannot make array length enumerable"
            }
        }
        def oldLen:int (obj.arrayLength())
        def oldWritable:boolean true
        if (obj.hasOwnAttrs("length")) {
            oldWritable = (obj.isWritable("length"))
        }
        def wantWritable:boolean oldWritable
        def hasWritable:boolean (this.descHas(desc "writable"))
        if hasWritable {
            wantWritable = ((this.descGet(desc "writable")).toBool())
            ; Once length is non-writable it can never be made writable again.
            if (oldWritable == false) {
                if wantWritable {
                    return "cannot make a non-writable array length writable again"
                }
            }
        }
        if (false == (this.descHas(desc "value"))) {
            if hasWritable {
                obj.setAttrs("length" wantWritable false false)
            }
            return ""
        }
        def lv:EvHandle (this.descGet(desc "value"))
        def lenNum:double (this.toNumberOf(lv))
        if scriptThrew {
            return ""
        }
        def lenTrunc:double (this.floorNum(lenNum))
        if (lenNum < 0.0) {
            lenTrunc = (0.0 - (this.floorNum((0.0 - lenNum))))
        }
        def lenU:double (this.wrapUint32(lenTrunc))
        if (lenU != lenNum) {
            return "@RangeError@Invalid array length"
        }
        ; D lane: a length runs to 2^32-1 and does NOT fit an int32. Narrowing
        ; here first made `defineProperty(a, "length", {value: 4294967294})`
        ; compare a wrapped-negative length against the old one, take the
        ; shrink path, and walk four billion indexes -- the test timed out
        ; rather than answering wrongly.
        def oldLenD:double (obj.arrayLengthD())
        ; GROWING (or unchanged) is an ordinary define: it is refused only when
        ; length is non-writable AND the value really differs. `{value: 0}` on an
        ; already-empty array with a frozen length is legal, because it changes
        ; nothing.
        if (lenU >= oldLenD) {
            if (oldWritable == false) {
                if (lenU != oldLenD) {
                    return "cannot change the length of an array whose length is not writable"
                }
            }
            this.setArrayLength(obj lenU)
            obj.setAttrs("length" wantWritable false false)
            return ""
        }
        def newLen:int (to_int lenU)
        ; SHRINKING needs a writable length, and stops at the first element that
        ; cannot be deleted -- the length lands just past it and a TypeError is
        ; reported, with the writable change still applied.
        if (oldWritable == false) {
            return "cannot change the length of an array whose length is not writable"
        }
        def stopAt:int newLen
        def blocked:boolean false
        def scan:int (oldLen - 1)
        while ((scan >= newLen) && (blocked == false)) {
            def ek:string (to_string scan)
            if (obj.hasOwnAttrs(ek)) {
                if (false == (obj.isConfigurable(ek))) {
                    stopAt = (scan + 1)
                    blocked = true
                }
            }
            scan = (scan - 1)
        }
        this.setArrayLength(obj (to_double stopAt))
        obj.setAttrs("length" wantWritable false false)
        if blocked {
            return "cannot delete a non-configurable element while shortening length"
        }
        return ""
    }

    ; D-ARRAYSPARSE: set an array's length. Up to the dense cap the elements
    ; themselves are resized; beyond it only the DECLARED length moves, because
    ; no dense container can hold 2^32-1 slots and the spec allows a length that
    ; large with no elements at all.
    fn setArrayLength:void (obj:EvHandle newLenD:double) {
        ; DOUBLE parameter: a length write runs to 2^32-1, past the C++ int.
        if (newLenD > 10000000.0) {
            def dense:int (obj.denseLen())
            if (newLenD < (to_double dense)) {
                ; Below the dense count, so the int conversion is in range.
                this.resizeArrayTo(obj (to_int newLenD))
            }
            obj.setDeclaredLengthD(newLenD)
            return
        }
        def newLen:int (to_int newLenD)
        this.resizeArrayTo(obj newLen)
        obj.setDeclaredLength((0 - 1))
    }

    ; D-ARRAYSPARSE: shrinking `length` deletes every index property at or above
    ; the new length, including the FAR ones kept in the property map because the
    ; dense store could not reach them. Trimming only the dense store left
    ; `x[4294967294]` readable after `x.length = 2`.
    fn dropFarIndexesAbove:void (obj:EvHandle newLen:int) {
        def survivors:[string]
        def ks:[string] (obj.ownDataKeys())
        def i:int 0
        while (i < (array_length ks)) {
            def k:string (itemAt ks i)
            ; D lane: the far indexes this walk exists to drop are exactly the
            ; ones past the int.
            def ki:double (this.canonicalArrayIndexD(k))
            def keep:boolean true
            if (ki >= 0.0) {
                if (ki >= (to_double newLen)) {
                    keep = false
                }
            }
            if keep {
                push survivors k
            }
            i = (i + 1)
        }
        if ((array_length survivors) != (array_length ks)) {
            def j:int 0
            while (j < (array_length ks)) {
                def dk:string (itemAt ks j)
                def stillThere:boolean false
                def m:int 0
                while (m < (array_length survivors)) {
                    if ((itemAt survivors m) == dk) { stillThere = true }
                    m = (m + 1)
                }
                if (false == stillThere) {
                    obj.removeMember(dk)
                }
                j = (j + 1)
            }
        }
    }

    fn resizeArrayTo:void (obj:EvHandle newLen:int) {
        this.dropFarIndexesAbove(obj newLen)
        def resized:[EvHandle]
        def li:int 0
        while (li < newLen) {
            if (li < (obj.denseLen())) {
                push resized (obj.arrayItemAt(li))
            } {
                push resized (EvValueBridge.taggedHole())
            }
            li = (li + 1)
        }
        obj.arrSetItems(resized)
    }

    ; D-ARRAYDEFINE: defining an INDEX writes the element and pushes `length`
    ; out when the index is past the end. The attributes are recorded under the
    ; index's name so a later truncation can see a non-configurable element.
    fn defineArrayIndex:string (obj:EvHandle idx:int desc:EvHandle) {
        def key:string (to_string idx)
        ; An index AT or BEYOND length needs the length to move, so a frozen
        ; length refuses it.
        if (idx >= (obj.arrayLength())) {
            if (obj.hasOwnAttrs("length")) {
                if (false == (obj.isWritable("length"))) {
                    return "cannot add an element past a non-writable array length"
                }
            }
        }
        def rErr:string (this.redefineError(obj key desc))
        if ((strlen rErr) > 0) {
            return rErr
        }
        ; Whether the ELEMENT was already there decides which attributes survive.
        def existedElem:boolean false
        if (idx < (obj.denseLen())) {
            if (false == ((EvValueBridge.isHole((obj.arrayItemAt(idx)))))) {
                existedElem = true
            }
        }
        if (obj.hasOwnGetter(key)) { existedElem = true }
        if (obj.hasOwnSetter(key)) { existedElem = true }
        if (idx >= (obj.denseLen())) {
            this.resizeArrayTo(obj (idx + 1))
        }
        ; An element may be an ACCESSOR. The functions live in getterMap /
        ; setterMap under the index's name -- where the computed-read path
        ; already looks -- and the dense slot is made PRESENT so `idx in arr`
        ; is true, with the getter winning on read.
        def aG:EvHandle (this.descGet(desc "get"))
        def aS:EvHandle (this.descGet(desc "set"))
        if ((aG.isFunction()) || (aS.isFunction())) {
            if (aG.isFunction()) {
                obj.defineGetter(key aG)
            }
            if (aS.isFunction()) {
                obj.defineSetter(key aS)
            }
            obj.setIndexAt(idx (EvValueBridge.taggedUndefined()))
            this.applyDescriptorAttrs(obj key desc existedElem)
            obj.setAttrs(key false (obj.isEnumerable(key)) (obj.isConfigurable(key)))
            return ""
        }
        ; Turning an ACCESSOR element back into a data one drops the functions.
        ; They were left in place, so the getter still won the read and the
        ; element reported as an accessor after a redefinition that gave it a
        ; value. A GENERIC descriptor -- attributes only -- leaves the kind
        ; alone, exactly as it does for a named property.
        def wantsDataElem:boolean false
        if (this.descHas(desc "value")) { wantsDataElem = true }
        if (this.descHas(desc "writable")) { wantsDataElem = true }
        if wantsDataElem {
            def hadAcc:boolean false
            if (obj.hasOwnGetter(key)) { hadAcc = true }
            if (obj.hasOwnSetter(key)) { hadAcc = true }
            if hadAcc {
                ; The attributes the accessor carried survive the change of
                ; kind, and clearing the accessor drops its recorded entry --
                ; so they are put back before the descriptor is applied over
                ; them. Without this a redefinition inherited the
                ; made-by-assignment defaults and turned a non-enumerable
                ; element enumerable.
                def keepE:boolean (obj.isEnumerable(key))
                def keepC:boolean (obj.isConfigurable(key))
                obj.clearAccessor(key)
                obj.setAttrs(key false keepE keepC)
            }
        }

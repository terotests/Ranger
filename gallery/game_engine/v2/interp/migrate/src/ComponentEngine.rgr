                    push out (itemAt hd hk)
                    hk = (hk + 1)
                }
            } {
                def d:[int] (this.decompOf(cp))
                def dn:int (array_length d)
                if (dn == 0) {
                    push out cp
                } {
                    def dk:int 0
                    while (dk < dn) {
                        push out (itemAt d dk)
                        dk = (dk + 1)
                    }
                }
            }
            i = (i + 1)
        }
        def m:int (array_length out)
        def j:int 1
        while (j < m) {
            def c:int (this.cccOf((itemAt out j)))
            if (c > 0) {
                def k:int j
                def moving:boolean true
                while (moving && (k > 0)) {
                    def prev:int (this.cccOf((itemAt out (k - 1))))
                    if (prev > c) {
                        def tmp:int (itemAt out k)
                        set out k (itemAt out (k - 1))
                        set out (k - 1) tmp
                        k = (k - 1)

    ; concatenation, and the slot holds no string.
    fn assignNumberInSlot:boolean (node:TSNode) {
        if anyWithScope {
            return false
        }
        if node.left { } {
            return false
        }
        def lhs:TSNode (unwrap node.left)
        if ((this.nodeKindOf(lhs)) != 1) {
            return false
        }
        ; `+=` `-=` `*=` `/=` only. `%=` is left out: its remainder helper
        ; answers with a value object, so routing it here would save nothing.
        def opK:int (this.opKindOf(node))
        if ((opK < 2) || (opK > 5)) {
            return false
        }
        def nm:string lhs.name
        if (false == (context.hasNumberSlot(nm))) {
            return false
        }
        if node.right { } {
            return false
        }
        ; The right-hand side is evaluated exactly ONCE, and this function never
        ; bails after that point -- returning false here would send the whole
        ; statement back to the general path, which evaluates it again, and
        ; `s += f()` would call f twice.

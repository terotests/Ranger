                fbi2 = (fbi2 + 1)
            }
            prog.brkTop = fBrkBase
            return true
        }
        if (node.nodeType == "EmptyStatement") {
            return true
        }
        return false
    }

    fn bcAssignStmt:boolean (node:TSNode prog:BcProgram) {
        if (null? node.left) {
            return false
        }
        def tgt:TSNode (unwrap node.left)
        if ((this.nodeKindOf(tgt)) == 3) {
            ; member/index target, plain `=` only
            if ((this.opKindOf(node)) != 1) {
                return false
            }
            if (null? node.right) {
                return false
            }
            if (null? tgt.left) {
                return false
            }
            if (false == (this.bcExpr((unwrap tgt.left) prog))) {
                return false
            }
            if tgt.computed {
                if (null? tgt.right) {
                    return false
                }
                if (false == (this.bcExpr((unwrap tgt.right) prog))) {
                    return false
                }
                if (false == (this.bcExpr((unwrap node.right) prog))) {
                    return false
                }
                prog.emit(34 0 0 3)
                return true
            }
            def mName:string (this.bcMemberName(tgt))
            if ((strlen mName) == 0) {
                return false
            }
            if (mName == "length") {
                return false
            }
            if (mName == "__proto__") {
                return false
            }
            if (mName == "prototype") {
                return false
            }
            if (false == (this.bcExpr((unwrap node.right) prog))) {
                return false
            }
            prog.emit(31 (prog.addAtom(mName)) 0 2)
            return true
        }
        if ((this.nodeKindOf(tgt)) != 1) {
            return false
        }
        def slot:int (prog.localIdxOf(tgt.name))
        if (slot < 0) {
            return false
        }
        if (null? node.right) {
            return false
        }
        def aok:int (this.opKindOf(node))
        if (aok == 1) {
            if (false == (this.bcExpr((unwrap node.right) prog))) {
                return false
            }
            prog.emit(9 slot 0 1)
            return true
        }
        def bop:int 0
        if (aok == 2) { bop = 20 }
        if (aok == 3) { bop = 21 }
        if (aok == 4) { bop = 22 }
        if (aok == 5) { bop = 23 }
        if (aok == 6) { bop = 24 }
        if (bop == 0) {
            return false
        }
        if (aok == 2) {
            ; s += x keeps the walker's in-place append when the escape scan
            ; proved the slot unshared (operand: slot*2 + owned)
            if (false == (this.bcExpr((unwrap node.right) prog))) {
                return false
            }
            def ownBit:int 0
            if (itemAt prog.ownedSlots slot) {
                ownBit = 1
            }
            prog.emit(35 ((slot * 2) + ownBit) 0 1)
            return true
        }
        prog.emit(8 slot 1 0)
        if (false == (this.bcExpr((unwrap node.right) prog))) {
            return false
        }
        prog.emit(12 bop 1 2)
        prog.emit(9 slot 0 1)
        return true
    }

    fn bcUpdateStmt:boolean (node:TSNode prog:BcProgram) {
        if (null? node.left) {
            return false
        }
        def opd:TSNode (unwrap node.left)
        if ((this.nodeKindOf(opd)) != 1) {
            return false
        }
        def slot:int (prog.localIdxOf(opd.name))
        if (slot < 0) {
            return false
        }
        if (node.value == "++") {
            prog.emit(23 slot 0 0)
            return true
        }
        if (node.value == "--") {
            prog.emit(24 slot 0 0)
            return true
        }
        return false
    }

    ; The property NAME of a non-computed member node, "" when absent --
    ; same extraction the walker's dispatch uses.
    fn bcMemberName:string (node:TSNode) {
        if ((strlen node.name) > 0) {
            return node.name
        }
        if node.right {
            def pr:TSNode (unwrap node.right)
            if ((strlen pr.name) > 0) {
                return pr.name
            }
            return pr.value
        }
        return ""
    }

    fn bcExpr:boolean (node:TSNode prog:BcProgram) {
        def k:int (this.nodeKindOf(node))
        if (k == 3) {
            ; `?.` short-circuits instead of throwing on a nullish base;
            ; get_field throws (as the walker does for a plain `.`), so an
            ; optional access stays on the walker
            if node.optional {
                return false
            }
            if (null? node.left) {
                return false
            }
            if (false == (this.bcExpr((unwrap node.left) prog))) {
                return false
            }
            if node.computed {
                if (null? node.right) {
                    return false
                }
                if (false == (this.bcExpr((unwrap node.right) prog))) {
                    return false
                }
                prog.emit(33 0 1 2)
                return true
            }
            def mn:string (this.bcMemberName(node))
            if ((strlen mn) == 0) {
                return false
            }
            if (mn == "__proto__") {
                return false
            }
            ; D-STRICT: `caller` and `arguments` are poisoned on a strict or
            ; bound receiver, which the compiled get_field does not check. That
            ; is why `strictFn.caller` read undefined inside a function body
            ; while the same expression threw at top level -- two tiers, one
            ; rule, applied by only one of them.
            if (mn == "caller") {
                return false
            }
            if (mn == "arguments") {
                return false
            }
            ; A function's `prototype` object is completed lazily on the walker's
            ; member path -- that is where its `constructor` back-link and its
            ; own prototype are filled in. The compiled get_field skips all of
            ; it, so `f.prototype.constructor` read undefined inside a function
            ; body and correctly inside one at top level.
            if (mn == "prototype") {
                return false
            }
            prog.emit(30 (prog.addAtom(mn)) 1 1)
            return true
        }
        if (k == 2) {
            if (false == node.numScanned) {
                node.numScanned = true
                def parsedNum@(optional):double (to_double node.value)
                if parsedNum {
                    node.numValue = (unwrap parsedNum)
                }
            }
            def nv:double node.numValue
            def ni:int 0
            if ((nv >= 0.0) && (nv < 2147483647.0)) {
                ni = (to_int nv)
            } {
                ni = (0 - 1)
            }
            if ((to_double ni) == nv) {
                if ((ni > 0) || ((ni == 0) && ((1.0 / nv) > 0.0))) {
                    if (ni < 4096) {
                        prog.emit(2 ni 1 0)
                        return true
                    }
                }
            }
            ; push_dnum: the double rides the program's own constant pool and
            ; lands straight in a number slot -- no interned value object.
            ; The index is a separate local so the emit call's receiver
            ; borrow does not overlap the pool read on Rust.
            push prog.constNums nv
            def dnumIdx:int ((array_length prog.constNums) - 1)
            prog.emit(3 dnumIdx 1 0)
            return true
        }
        if (k == 1) {
            def slot:int (prog.localIdxOf(node.name))
            if (slot >= 0) {
                prog.emit(8 slot 1 0)
                return true
            }
            if (node.name == "undefined") {
                prog.emit(4 0 1 0)
                return true
            }
            def aIdx:int (prog.addAtom(node.name))
            prog.emit(10 aIdx 1 0)
            return true
        }
        if (k == 5) {
            def bok:int (this.opKindOf(node))
            if (null? node.left) {
                return false
            }
            if (null? node.right) {
                return false
            }
            if (bok == 34) {
                if (false == (this.bcExpr((unwrap node.left) prog))) {
                    return false
                }
                prog.emit(21 0 1 0)
                def aEnd:int (prog.here())
                prog.emit(16 0 0 1)
                prog.emit(22 0 0 1)
                if (false == (this.bcExpr((unwrap node.right) prog))) {
                    return false
                }
                prog.patch(aEnd (prog.here()))
                return true
            }
            if (bok == 35) {
                if (false == (this.bcExpr((unwrap node.left) prog))) {
                    return false
                }
                prog.emit(21 0 1 0)
                def oEnd:int (prog.here())
                prog.emit(17 0 0 1)
                prog.emit(22 0 0 1)
                if (false == (this.bcExpr((unwrap node.right) prog))) {
                    return false
                }
                prog.patch(oEnd (prog.here()))
                return true
            }
            if (bok == 36) {
                return false
            }
            if (bok == 43) {
                return false
            }
            if (bok == 44) {
                return false
            }
            if (false == (this.bcExpr((unwrap node.left) prog))) {
                return false
            }
            if (false == (this.bcExpr((unwrap node.right) prog))) {
                return false
            }
            prog.emit(12 bok 1 2)
            return true
        }
        if (k == 13) {
            if (null? node.test) {
                return false
            }
            if (null? node.consequent) {
                return false
            }
            if (null? node.alternate) {
                return false
            }
            if (false == (this.bcExpr((unwrap node.test) prog))) {
                return false
            }
            def tElse:int (prog.here())
            prog.emit(16 0 0 1)
            if (false == (this.bcExpr((unwrap node.consequent) prog))) {
                return false
            }
            def tEnd:int (prog.here())
            prog.emit(15 0 0 0)
            prog.patch(tElse (prog.here()))
            ; the two arms merge to ONE stack slot; the else arm re-uses the
            ; depth the then arm consumed
            prog.curStack = (prog.curStack - 1)
            if (false == (this.bcExpr((unwrap node.alternate) prog))) {
                return false
            }
            prog.patch(tEnd (prog.here()))
            return true
        }
        if (k == 20) {
            prog.emit(38 0 1 0)
            return true
        }
        if (k == 23) {
            if node.left {
                return (this.bcExpr((unwrap node.left) prog))
            }
            return false
        }
        if (k == 14) {
            def anc:int (array_length node.children)
            if (anc > 250) {
                return false
            }
            def aei:int 0
            while (aei < anc) {
                def ael:TSNode (itemAt node.children aei)
                def aek:int (this.nodeKindOf(ael))
                if (aek == 22) {
                    return false
                }
                if (aek == 47) {
                    return false
                }
                if (false == (this.bcExpr(ael prog))) {
                    return false
                }
                aei = (aei + 1)
            }
            prog.emit(36 anc 1 anc)
            return true
        }
        if (k == 15) {
            ; plain data properties only; accessors/computed/spread fall back
            def onc:int (array_length node.children)
            def opi:int 0
            while (opi < onc) {
                def oprop:TSNode (itemAt node.children opi)
                if (oprop.nodeType != "Property") {
                    return false
                }
                if oprop.computed {
                    return false
                }
                if ((strlen oprop.accessor) > 0) {
                    return false
                }
                if ((strlen oprop.name) == 0) {
                    return false
                }
                opi = (opi + 1)
            }
            prog.emit(37 0 1 0)
            def opj:int 0
            while (opj < onc) {
                def wprop:TSNode (itemAt node.children opj)
                if (null? wprop.left) {
                    return false
                }
                prog.emit(21 0 1 0)
                if (false == (this.bcExpr((unwrap wprop.left) prog))) {
                    return false
                }
                prog.emit(31 (prog.addAtom(wprop.name)) 0 2)
                opj = (opj + 1)
            }
            return true
        }
        if (k == 8) {
            def sPool:EvalConstPool (EvalConstPool.__singleton())
            def sId:int (sPool.addLiteral((EvValueBridge.taggedString(node.value))))
            prog.emit(1 sId 1 0)
            return true
        }
        if (k == 9) {
            if (node.value == "true") {
                prog.emit(6 0 1 0)
            } {
                prog.emit(7 0 1 0)
            }
            return true
        }
        if (k == 10) {
            prog.emit(5 0 1 0)
            return true
        }
        if (k == 12) {
            if (null? node.left) {
                return false
            }
            if (node.value == "-") {
                if (false == (this.bcExpr((unwrap node.left) prog))) {
                    return false
                }
                prog.emit(13 0 1 1)
                return true
            }
            if (node.value == "!") {
                if (false == (this.bcExpr((unwrap node.left) prog))) {
                    return false
                }
                prog.emit(14 0 1 1)
                return true
            }
            if (node.value == "+") {
                if (false == (this.bcExpr((unwrap node.left) prog))) {
                    return false
                }
                prog.emit(25 0 1 1)
                return true
            }
            return false
        }
        if (k == 4) {
            if (null? node.left) {
                return false
            }
            if node.optional {
                ; f?.() -- call short-circuits on nullish; walker only
                return false
            }
            def callee:TSNode (unwrap node.left)
            if ((this.nodeKindOf(callee)) == 3) {
                if callee.optional {
                    return false
                }
                if callee.computed {
                    return false
                }
                if (null? callee.left) {
                    return false
                }
                def mrecv:TSNode (unwrap callee.left)
                if ((this.nodeKindOf(mrecv)) == 1) {
                    if ((prog.localIdxOf(mrecv.name)) < 0) {
                        return false
                    }
                }
                def mcn:string (this.bcMemberName(callee))
                if ((strlen mcn) == 0) {
                    return false
                }
                if (false == (this.bcExpr((unwrap callee.left) prog))) {
                    return false
                }
                def margc:int (array_length node.children)
                if (margc > 250) {
                    return false
                }
                def mai:int 0
                while (mai < margc) {
                    def man:TSNode (itemAt node.children mai)
                    if ((this.nodeKindOf(man)) == 47) {
                        return false
                    }
                    if (false == (this.bcExpr(man prog))) {
                        return false
                    }
                    mai = (mai + 1)
                }
                prog.emit(32 (((prog.addAtom(mcn)) * 256) + margc) 1 (margc + 1))
                return true
            }
            if ((this.nodeKindOf(callee)) != 1) {
                return false
            }
            if (this.isGlobalBuiltinCallName(callee.name)) {
                return false
            }
            def cslot:int (prog.localIdxOf(callee.name))
            if (cslot >= 0) {
                prog.emit(8 cslot 1 0)
            } {
                def cIdx:int (prog.addAtom(callee.name))
                prog.emit(10 cIdx 1 0)
            }
            def argc:int (array_length node.children)
            if (argc > 250) {
                return false
            }
            def ai:int 0
            while (ai < argc) {
                def an:TSNode (itemAt node.children ai)
                if ((this.nodeKindOf(an)) == 47) {
                    return false
                }
                if (false == (this.bcExpr(an prog))) {
                    return false
                }
                ai = (ai + 1)
            }
            ; the callee NAME rides the high operand bits so the VM can
            ; word the not-a-function TypeError exactly as the walker does
            def cnAtom:int (prog.addAtom(callee.name))
            prog.emit(20 ((cnAtom * 256) + argc) 1 (argc + 1))
            return true
        }
        return false
    }

    ; ---- Bytecode tier: the VM --------------------------------------------
    ; Locals live at [base, base+localCount) of the ONE shared stack;
    ; operands above them. A nested compiled call bases above this frame's
    ; full extent. Any op that can raise checks scriptThrew and bails --
    ; compiled bodies contain no catch, so unwinding to the caller is
    ; exactly what the walker does.
    ; ---- Bytecode tier: member/method helpers (walker-mirroring) ----------

    fn bcGetField:EvHandle (obj:EvHandle name:string) {
        ; D-PROXY: a proxy read is the `get` trap, with all its post-conditions.
        ; The compiled path had no proxy case at all, so a read inside a
        ; function body went straight to the fused lookups below and answered
        ; the TARGET's property -- the trap never ran, and none of its
        ; invariants were checked. The walker's read has always gone through
        ; getPropertyValue; now both do.
        if (this.isProxyValue(obj)) {
            return (this.getPropertyValue(obj name))
        }
        ; Reading a property of null/undefined is a TypeError, same message
        ; as the walker's member read. The gate keeps `?.` on the walker, so
        ; reaching here with a nullish base always means a plain `.` / `[]`.
        if ((obj.isNull()) || (obj.isUndefined())) {
            def rDesc:string "undefined"
            if (obj.isNull()) {
                rDesc = "null"
            }
            return (this.throwSpecError("TypeError" ("Cannot read properties of " + (rDesc + (" (reading '" + (name + "')"))))))
        }
        ; D-PRIVATE: the brand check, on the compiled path too. A method body
        ; compiles to bytecode, and `o.#x` inside one is where a brand check is
        ; actually written.
        if ((strlen name) > 0) {
            if ((substring name 0 1) == "#") {
                if (false == (this.objHasKeyUpChain(obj name))) {
                    return (this.throwSpecError("TypeError" ("Cannot read private member " + (name + " from an object whose class did not declare it"))))
                }
            }
        }
        if (name == "length") {
            if (obj.isString()) {
                return (EvHandle.fromInt((obj.strCodeUnitLength())))
            }
            if (obj.isArrayValue()) {
                ; Exact double lane: a declared length can exceed the int.
                return (EvHandle.number((obj.arrayLengthD())))
            }
        }
        if (name == "size") {
            if ((obj.isMap()) || (obj.isSet())) {
                return (EvHandle.fromInt((obj.denseLen())))
            }
        }
        ; fused plain read first (covers the get_elem / method funnels; the
        ; op-30 body already tried it for direct member reads)
        def fmg:EvHandle (obj.memberFastAt(name))
        if (false == (fmg.isHole())) {
            return fmg
        }
        def g:EvHandle (this.resolveGetterOn(obj name))
        if (g.isFunction()) {
            if (g.hasFunctionNode()) {
                def gArgs:[EvHandle]
                return (this.callFnValueWithValues((g.withThisForCall(obj)) gArgs))
            }
            if (g.isBuiltinMethod()) {
                def gbArgs:[EvHandle]
                return (this.invokeBuiltin((g.builtinKindOf()) (g.builtinNameOf()) obj gbArgs))
            }
        }
        def gm:EvHandle (obj.getMember(name))
        if (false == (gm.isNull())) {
            return gm
        }
        ; getMember's null is EITHER a stored null (a real property that
        ; happens to hold null) or its miss sentinel for the receivers whose
        ; branch has no own answer (arrays with non-element keys, Map/Set,
        ; primitives). A stored null is found on the own/proto chain; a true
        ; miss resolves the way the walker's member read does -- a registry
        ; method reads as the shared method value, everything else is
        ; undefined, never null.
        if (this.bcMemberExists(obj name 0)) {
            return gm
        }
        def grk:string (this.receiverKind(obj))
        if (this.hasBuiltin(grk name)) {
            if (false == (this.registryMethodDeleted(obj name))) {
                ; D-INTL: Collator's `compare` and the formatters' `format` are
                ; bound accessors, so they cannot come from the shared cache --
                ; detached, a shared one loses its object and sorts in the root
                ; order instead of the requested locale.
                if (this.intlIsBoundMethod(grk name)) {
                    return (this.builtinMethodValueFor(obj name))
                }
                return (this.sharedNativeMethod(grk name))
            }
        }
        if (this.objectProtoFallbackFor(grk name)) {
            return (this.sharedNativeMethod("object" name))
        }
        ; the KIND prototype's own data answers next, as the walker's read
        ; does -- `constructor` on Array.prototype is what makes
        ; `[].constructor === Array` hold in a compiled body
        def gcn:string (this.ctorNameForKind(grk))
        if ((strlen gcn) > 0) {
            def gkp:EvHandle (this.builtinPrototype(gcn))
            if (gkp.hasOwnData(name)) {
                return (gkp.getOwnData(name))
            }
        }
        return (EvHandle.undefined())
    }

    ; Own-or-inherited data property existence, the depth-capped chain walk
    ; getMemberDepth uses.
    fn bcMemberExists:boolean (obj:EvHandle name:string depth:int) {
        if (depth > 16) {
            return false
        }
        if (obj.hasOwnData(name)) {
            return true
        }
        if (obj.hasProto()) {
            return (this.bcMemberExists((obj.protoOf()) name (depth + 1)))
        }
        return false
    }

    fn bcPutField:void (obj:EvHandle name:string v:EvHandle) {
        ; D-PROXY: the `set` trap.
        if (this.isProxyValue(obj)) {
            def sTgt:EvHandle (this.proxyTargetOf(obj))
            def sTrap:EvHandle (this.proxyTrap(obj "set"))
            if scriptThrew {
                return
            }
            if (sTrap.isFunction()) {
                def sArgs:[EvHandle]
                push sArgs sTgt
                push sArgs (EvValueBridge.taggedString(name))
                push sArgs v
                push sArgs obj
                def sv:EvHandle (this.callProxyTrap(sTrap sArgs))
                if scriptThrew {
                    return
                }
                if (sv.toBool()) {
                    def sErr:string (this.proxySetInvariant(sTgt name v))
                    if ((strlen sErr) > 0) {
                        def _se:EvHandle (this.throwSpecError("TypeError" sErr))
                    }
                }
                return
            }
            this.bcPutField(sTgt name v)
            return
        }
        ; Writing a property of null/undefined is a TypeError, under the
        ; same realm flag the walker's assignment path uses.
        if strictReferences {
            if ((obj.isNull()) || (obj.isUndefined())) {
                def wDesc:string "undefined"
                if (obj.isNull()) {
                    wDesc = "null"
                }
                def _wt:EvHandle (this.throwSpecError("TypeError" ("Cannot set properties of " + (wDesc + (" (setting '" + (name + "')"))))))
                return
            }
        }
        ; setMember applies the D-ATTRS refusal rules for objects and
        ; functions, but stores unconditionally on an ARRAY -- so a named write
        ; to a frozen array (`Object.freeze(a).foo = 1`, `a.length = 0`) went
        ; through here where the walker refused it. Sloppy-only: strict bodies
        ; never compile, so the TypeError stays the walker's to raise.
        if (obj.isArrayValue()) {
            def afErr:string (this.writeRefusalError(obj name))
            if ((strlen afErr) > 0) {
                return
            }
        }
        if (obj.chainAccessorFreeAt()) {
            obj.setMember(name v)
            return
        }
        def st:EvHandle (this.resolveSetterOn(obj name))
        if (st.isFunction()) {
            if (st.hasFunctionNode()) {
                def sArgs:[EvHandle]
                push sArgs v
                def _sr:EvHandle (this.callFnValueWithValues((st.withThisForCall(obj)) sArgs))
                return
            }
        }
        obj.setMember(name v)
    }

    fn bcGetElem:EvHandle (obj:EvHandle key:EvHandle) {
        if (obj.isArrayValue()) {
            if (key.isNumber()) {
                def kd:double key.numberValue
                ; range-check BEFORE converting: double->int out of int range
                ; is UB on C++ and the round-trip guard below runs on the
                ; already-poisoned value
                if ((kd >= 0.0) && (kd < 2147483647.0)) {
                def ki:int (to_int kd)
                if ((to_double ki) == kd) {
                    if ((ki >= 0) && (ki < (obj.denseLen()))) {
                        if ((false == (obj.hasProto())) && (false == (obj.ownAccessorsEver()))) {
                            def el:EvHandle (obj.arrayItemAt(ki))
                            if (el.isHole()) {
                                return (EvHandle.undefined())
                            }
                            return el
                        }
                    }
                }
                }
            }
        }
        def pk:string (this.toPropertyKey(key))
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        ; D-ARGMAP, walker parity: a mapped arguments index reads the
        ; parameter it aliases.
        def gmn:string (this.argMapName(obj pk))
        if ((strlen gmn) > 0) {
            def gmc:EvalContext (this.argMapScopeOf(obj))
            if (gmc.has(gmn)) {
                return (gmc.lookup(gmn))
            }
        }
        return (this.bcGetField(obj pk))
    }

    ; The O(1) proof that no write-refusal rule CAN apply to an element store,
    ; so the compiled path may write into the dense items without minting the
    ; key string to ask. Frozen refuses outright; a non-extensible array
    ; refuses the append at ki == denseLen; and any element that ever carried
    ; attributes may be non-writable. All three are single flag reads.
    fn bcElemStoreFree:boolean (obj:EvHandle) {
        if (obj.isFrozenObj()) {
            return false
        }
        if (obj.ownAttrsEver()) {
            return false
        }
        return (obj.isExtensible())
    }

    fn bcPutElem:void (obj:EvHandle key:EvHandle v:EvHandle) {

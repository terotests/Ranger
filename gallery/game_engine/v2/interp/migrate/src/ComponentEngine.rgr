    ; The receiver kind a built-in constructor's prototype serves.
    ; Inverse of kindForCtorName: the constructor whose prototype serves a kind.
    fn ctorNameForKind:string (kind:string) {
        if (kind == "array") { return "Array" }
        if (kind == "string") { return "String" }
        if (kind == "number") { return "Number" }
        if (kind == "boolean") { return "Boolean" }
        if (kind == "regexp") { return "RegExp" }
        if (kind == "function") { return "Function" }
        if (kind == "map") { return "Map" }
        if (kind == "set") { return "Set" }
        if (kind == "date") { return "Date" }
        return ""
    }

    fn kindForCtorName:string (nsName:string) {
        if (nsName == "Array") { return "array" }
        if (nsName == "String") { return "string" }
        if (nsName == "Number") { return "number" }
        ; Boolean was missing, so Boolean.prototype published no methods at all
        ; and every read of one fell through to Object.prototype.
        if (nsName == "Boolean") { return "boolean" }
        if (nsName == "RegExp") { return "regexp" }
        if (nsName == "Function") { return "function" }
        if (nsName == "Map") { return "map" }
        if (nsName == "Set") { return "set" }
        if (nsName == "Date") { return "date" }
        if (nsName == "Object") { return "object" }
        return ""
    }

    ; Every registered method name for a kind. Kept beside builtinArity, which
    ; remains the authority on whether a name exists: builtinPrototype asserts
    ; each name here is registered, so the two cannot silently drift apart.
    fn builtinNames:[string] (kind:string) {
        def out:[string]
        if (kind == "function") {
            push out "call"
            push out "apply"
            push out "bind"
        }
        if (kind == "string") {
            push out "at"
            push out "charAt"
            push out "charCodeAt"
            push out "codePointAt"
            push out "concat"
            push out "endsWith"
            push out "includes"
            push out "indexOf"
            push out "lastIndexOf"
            push out "localeCompare"
            push out "match"
            push out "normalize"
            push out "padEnd"
            push out "padStart"
            push out "repeat"
            push out "replace"
            push out "replaceAll"
            push out "search"
            push out "slice"
            push out "split"
            push out "startsWith"
            push out "substr"
            push out "substring"
            push out "toLocaleLowerCase"
            push out "toLocaleString"
            push out "toLocaleUpperCase"
            push out "toLowerCase"
            push out "toUpperCase"
            push out "trim"
            push out "trimEnd"
            push out "trimStart"
        }
        if (kind == "array") {
            push out "at"
            push out "concat"
            push out "every"
            push out "fill"
            push out "filter"
            push out "find"
            push out "findIndex"
            push out "flat"
            push out "forEach"
            push out "includes"
            push out "indexOf"
            push out "join"
            push out "lastIndexOf"
            push out "map"
            push out "pop"
            push out "push"
            push out "reduce"
            push out "reduceRight"
            push out "reverse"
            push out "shift"
            push out "slice"
            push out "some"
            push out "sort"
            push out "splice"
            push out "unshift"
        }
        if (kind == "regexp") {
            push out "exec"
            push out "test"
        }
        if (kind == "number") {
            push out "toExponential"
            push out "toFixed"
            push out "toLocaleString"
            push out "toPrecision"
        }
        if (kind == "map") {
            push out "clear"
            push out "delete"
            push out "entries"
            push out "forEach"
            push out "get"
            push out "has"
            push out "keys"
            push out "set"
            push out "values"
        }
        if (kind == "set") {
            push out "add"
            push out "clear"
            push out "delete"
            push out "forEach"
            push out "has"
            push out "keys"
            push out "values"

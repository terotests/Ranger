        ; D-DATE: local time is UTC in this realm, so each accessor and its UTC
        ; twin are the same function. Both names are registered because guests
        ; and the suite reach for both.
        if (kind == "date") {
            push out "getDate"
            push out "getDay"
            push out "getFullYear"
            push out "getHours"
            push out "getMilliseconds"
            push out "getMinutes"
            push out "getMonth"
            push out "getSeconds"
            push out "getTime"
            push out "getTimezoneOffset"
            push out "getUTCDate"
            push out "getUTCDay"
            push out "getUTCFullYear"
            push out "getUTCHours"
            push out "getUTCMilliseconds"
            push out "getUTCMinutes"
            push out "getUTCMonth"
            push out "getUTCSeconds"
            push out "getYear"
            push out "setDate"
            push out "setFullYear"
            push out "setHours"
            push out "setMilliseconds"
            push out "setMinutes"
            push out "setMonth"
            push out "setSeconds"
            push out "setTime"
            push out "setUTCDate"
            push out "setUTCFullYear"
            push out "setUTCHours"
            push out "setUTCMilliseconds"
            push out "setUTCMinutes"
            push out "setUTCMonth"
            push out "setUTCSeconds"
            push out "setYear"
            push out "toGMTString"
            push out "toDateString"
            push out "toISOString"
            push out "toJSON"
            push out "toLocaleDateString"
            push out "toLocaleString"
            push out "toLocaleTimeString"
            push out "toTimeString"
            push out "toUTCString"
        }
        push out "toString"
        push out "valueOf"

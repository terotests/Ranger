    ; A bound function has no `prototype`, so the synthesised one is suppressed
    ; on the copy without touching the target's.
    fn suppressPrototype:[string:boolean] (recv:EvalValue) {
        def out:[string:boolean]
        def ks:[string] (keys recv.suppressedKeys)
        def i:int 0
        while (i < (array_length ks)) {
            set out (itemAt ks i) true
            i = (i + 1)
        }
        set out "prototype" true
        return out
    }

    ; D-ARGCHECK: Object statics whose first argument must be an object. Note
    ; what is NOT here: keys/values/entries/assign/getOwnPropertyNames coerce in
    ; ES2015+ rather than throwing, but throw on null/undefined specifically —
    ; handled by the nullish check at the call site. freeze/seal/isFrozen/
    ; isSealed/isExtensible accept anything and are deliberately absent.
    ; Statics that genuinely REQUIRE an object argument in the current spec.
    ; Array methods whose first argument must be callable.
    ; D-WRAPPER: constructors whose instances box a primitive.
    fn isWrapperCtorName:boolean (name:string) {
        if (name == "String") { return true }
        if (name == "Number") { return true }
        if (name == "Boolean") { return true }
        return false
    }

    ; The boxed object. `__primitive__` is the internal slot; the wrapper reports
    ; the primitive's receiver kind so String.prototype methods dispatch to it.
    ; D-TOOBJECT: ToObject. A primitive is BOXED rather than handed back
    ; unchanged -- `Object(5)` is a Number object, and `typeof Object(5)` is
    ; "object", which the old passthrough got wrong. null/undefined (and the
    ; no-argument form, which arrives as a null EvalValue) make a fresh object.
    fn toObjectValue:EvalValue (v:EvalValue) {
        if (v.valueType == 2) { return (this.makeWrapper("String" v)) }
        if (v.valueType == 1) { return (this.makeWrapper("Number" v)) }
        if (v.valueType == 3) { return (this.makeWrapper("Boolean" v)) }
        if ((v.valueType == 0) || (v.isUndefined())) {
            def keysO:[string]
            def valsO:[EvalValue]
            def o:EvalValue (EvalValue.object(keysO valsO))
            o.protoRef = (this.builtinPrototype("Object"))
            return o
        }
        return v
    }

    fn makeWrapper:EvalValue (ctorName:string prim:EvalValue) {
        def keysW:[string]
        def valsW:[EvalValue]
        def w:EvalValue (EvalValue.object(keysW valsW))
        def p:EvalValue prim
        if (ctorName == "String") {
            if (prim.valueType == 0) {
                p = (EvalValue.string(""))
            } {
                p = (EvalValue.string((this.toStringOf(prim))))
            }
        }
        if (ctorName == "Number") {
            ; `new Number()` is +0, but `new Number(undefined)` is NaN -- the
            ; absence of an argument and an undefined argument are different
            ; things, and the caller signals which by passing a null EvalValue.
            if (prim.valueType == 0) {
                p = (EvalValue.number(0.0))
            } {
                p = (EvalValue.number((this.toNumberOf(prim))))
            }
        }
        if (ctorName == "Boolean") {
            p = (EvalValue.boolean((prim.toBool())))
        }
        w.setMember("__primitive__" p)
        w.setMember("__wrapper__" (EvalValue.string(ctorName)))
        ; A boxed string exposes `length` as a real own property, which is what
        ; `with ('ab') { length }` resolves against, plus one own property per
        ; index. Both are what `Object.keys(new String('ab'))` reports -- the
        ; indices are enumerable, `length` is not.
        if (ctorName == "String") {
            def sw:string p.stringValue
            def ci:int 0
            while (ci < (strlen sw)) {
                w.setMember((to_string ci) (EvalValue.string((substring sw ci (ci + 1)))))
                w.setAttrs((to_string ci) false true false)
                ci = (ci + 1)
            }
            w.setMember("length" (EvalValue.fromInt((strlen sw))))
            w.setAttrs("length" false false false)
        }
        w.protoRef = (this.builtinPrototype(ctorName))
        return w
    }

    ; ==========================================================================
    ; D-CLASSOF: the [[Class]] brand, as ES5 15.2.4.2 exposes it through
    ; Object.prototype.toString.
    ; --------------------------------------------------------------------------
    ; This is the only place the language lets a program observe a value's
    ; internal type, and the suite leans on it hard: 86 ES5 files capture
    ; `Object.prototype.toString` under the name `getClass` and assert the brand
    ; of what they just built. The engine answered "[object Object]" for
    ; everything, so an array, a boxed number and a plain object were
    ; indistinguishable and every one of those assertions failed.
    ;
    ; A boxed primitive brands as its constructor, not as Object -- that is the
    ; whole point of the wrapper -- so the check reads the internal slot rather
    ; than the value type.
    ; --------------------------------------------------------------------------
    fn objectClassOf:string (v:EvalValue) {
        if (v.isUndefined()) { return "Undefined" }
        if (v.valueType == 0) { return "Null" }
        if (v.valueType == 4) { return "Array" }
        if (v.valueType == 6) { return "Function" }
        if (v.valueType == 2) { return "String" }
        if (v.valueType == 1) { return "Number" }
        if (v.valueType == 3) { return "Boolean" }
        if (v.valueType == 5) {
            if (has v.objectMap "__nsbrand__") {
                return ((unwrap (get v.objectMap "__nsbrand__")).toString())
            }
            if (has v.objectMap "__wrapper__") {
                return ((unwrap (get v.objectMap "__wrapper__")).toString())
            }
            ; An error INSTANCE brands as Error; Error.prototype is an ordinary
            ; object and brands as Object, which is why the marker is checked on
            ; the own map rather than through the prototype chain.
            if (has v.objectMap "__error__") { return "Error" }
            if (has v.objectMap "__date__") { return "Date" }
            if (has v.objectMap "__regex__") { return "RegExp" }
            if (has v.objectMap "__arguments__") { return "Arguments" }
        }
        return "Object"
    }

    ; The primitive inside a wrapper, or the value itself when it is not one.
    fn unwrapPrimitive:EvalValue (v:EvalValue) {
        if (v.valueType == 5) {
            if (has v.objectMap "__primitive__") {
                return (unwrap (get v.objectMap "__primitive__"))
            }
        }
        return v
    }

    ; ==========================================================================
    ; D-TOPRIMITIVE: converting an object to a primitive, the way every operator
    ; that is not `===` does it.
    ; --------------------------------------------------------------------------
    ; The operators read raw values, so an object went straight to its debug
    ; form: `({valueOf: function () { return 5; }}) + 1` produced a string
    ; instead of 6, and every comparison against an object compared text. The
    ; whole language/expressions area turns on this -- addition, the relational
    ; operators, the bitwise operators and compound assignment all funnel
    ; through ToPrimitive then ToNumber.
    ;
    ; Number hint tries valueOf then toString; string hint the other way. A
    ; method that returns an object is skipped, per spec, rather than accepted.
    ; --------------------------------------------------------------------------
    ; The valueOf/toString a receiver would actually run, as ToPrimitive sees it.
    ; Shared by the call itself and by the "is this still the built-in?" question,
    ; so the two cannot disagree about which method is in play.
    fn resolvePrimitiveMethod:EvalValue (obj:EvalValue name:string) {
        def m:EvalValue (obj.getMember(name))
        ; An ARRAY or FUNCTION receiver has no prototype link of its own, so a
        ; guest override on Array.prototype or Function.prototype has to be
        ; looked for there. Without this, `Array.prototype.toString = …` was
        ; invisible to every conversion.
        def needsProtoLookup:boolean false
        if (m.valueType != 6) { needsProtoLookup = true }
        if (m.valueType == 6) {
            if (null? m.functionNode) { needsProtoLookup = true }
        }
        if needsProtoLookup {
            def pcn:string (this.ctorNameForKind((this.receiverKind(obj))))
            if ((strlen pcn) > 0) {
                if (obj.valueType != 5) {
                    def kp:EvalValue (this.builtinPrototype(pcn))
                    if (has kp.objectMap name) {
                        def kpm:EvalValue (unwrap (get kp.objectMap name))
                        if (kpm.valueType == 6) {
                            if kpm.functionNode {
                                return kpm
                            }
                        }
                    }
                }
            }
        }
        return m
    }

    ; True when `name` on this receiver is the inherited BUILT-IN rather than
    ; something the guest supplied -- callable or not. An own property shadows
    ; the default even when its value is undefined: the property is there, it is
    ; simply not callable, so ToPrimitive skips it and the other method gets its
    ; turn rather than the default rendering standing in.
    fn usesDefaultMethod:boolean (v:EvalValue name:string) {
        if (has v.objectMap name) {
            ; A built-in prototype publishes its methods as OWN properties --
            ; String.prototype.valueOf really is on String.prototype -- so
            ; presence alone does not mean the guest supplied one. What settles
            ; it is whether the value has a body the engine would run.
            def own:EvalValue (unwrap (get v.objectMap name))
            if (own.valueType == 6) {
                if (null? own.functionNode) {
                    return true
                }
            }
            return false
        }
        def m:EvalValue (this.resolvePrimitiveMethod(v name))
        if (m.valueType == 6) {
            if (null? m.functionNode) {
                return true
            }
            return false
        }
        ; Nothing resolved at all. An ARRAY or FUNCTION has no prototype object
        ; of its own, so the built-in it would run is not reachable as a value
        ; and the lookup comes back null -- that is still the default.
        if (m.valueType == 0) {
            return true
        }
        ; Present but not a function: not the default, and not usable either.
        if (false == (m.isUndefined())) {
            return false
        }
        return true
    }

    fn callPrimitiveMethod:EvalValue (obj:EvalValue name:string) {
        primitiveMethodUsable = false
        def m:EvalValue (this.resolvePrimitiveMethod(obj name))
        ; D-TOPRIMITIVE: the guest may hang ANOTHER prototype's built-in on the
        ; object -- `var o = {toString: Function.prototype.toString}`. That is
        ; not the default for this receiver, so ToPrimitive has to RUN it; the
        ; default-method shortcut below would otherwise brand the object and
        ; never notice, which hides the TypeError that method owes a
        ; non-callable receiver.
        if (m.isBuiltinMethod()) {
            def borrowedPrim:boolean false
            if (m.builtinName != name) { borrowedPrim = true }
            if (m.builtinKind != (this.receiverKind(obj))) { borrowedPrim = true }
            if borrowedPrim {
                def bpArgs:[EvalValue]
                def bpOut:EvalValue (this.invokeBuiltin(m.builtinKind m.builtinName obj bpArgs))
                if scriptThrew {
                    return (EvalValue.undefined())
                }
                if (bpOut.valueType == 5) { return (EvalValue.null()) }
                if (bpOut.valueType == 4) { return (EvalValue.null()) }
                if (bpOut.valueType == 6) { return (EvalValue.null()) }
                primitiveMethodUsable = true
                if (bpOut.valueType == 0) {
                    return (EvalValue.undefined())
                }
                return bpOut
            }
        }
        if (m.valueType == 6) {
            if m.functionNode {
                def noArgs:[EvalValue]
                def bound:EvalValue (m.withThis(obj))
                def out:EvalValue (this.callFnValueWithValues(bound noArgs))
                ; A throw from the guest's own valueOf/toString is the answer.
                ; Swallowing it here let ToPrimitive carry on and raise its own
                ; TypeError instead, so the exception the test threw never
                ; reached the catch that was waiting for it.
                if scriptThrew {
                    return (EvalValue.undefined())
                }
                ; An OBJECT result is not a primitive, so the method is skipped
                ; and the other one tried. Arrays and functions are objects too.
                if (out.valueType == 5) {
                    return (EvalValue.null())
                }
                if (out.valueType == 4) {
                    return (EvalValue.null())
                }
                if (out.valueType == 6) {
                    return (EvalValue.null())
                }
                ; A method that falls off its end returns UNDEFINED, which is a
                ; perfectly good primitive. The engine represents "no return" as
                ; null, which is also this function's "not usable" sentinel, so
                ; the two are told apart by the flag rather than by the value.
                primitiveMethodUsable = true
                if (out.valueType == 0) {
                    return (EvalValue.undefined())
                }
                return out
            }
        }
        return (EvalValue.null())
    }

    ; Lexicographic comparison by code unit: -1, 0 or 1. Ranger has no string
    ; relational operator, and comparing via toNumber would make "10" < "9"
    ; answer the numeric question instead of the textual one.
    fn compareStrings:int (a:string b:string) {
        def la:int (strlen a)
        def lb:int (strlen b)
        def n:int la
        if (lb < n) {
            n = lb
        }
        def i:int 0
        while (i < n) {
            def ca:int (charAt a i)
            def cb:int (charAt b i)
            if (ca < cb) { return (0 - 1) }
            if (ca > cb) { return 1 }
            i = (i + 1)
        }
        if (la < lb) { return (0 - 1) }
        if (la > lb) { return 1 }
        return 0
    }

    ; D-FNSRC: Function.prototype.toString. A function parsed from guest source
    ; returns that source verbatim -- the slice its node spans -- which is what
    ; makes `f + 1` and `eval("(" + f + ")")` behave. A builtin has no source, so
    ; it keeps the NativeFunction form the spec allows for one.
    fn functionSourceText:string (v:EvalValue) {
        if (null? v.functionNode) {
            return ("function " + v.functionName + "() { [native code] }")
        }
        def fnode:TSNode (unwrap v.functionNode)
        def total:int (strlen v.srcText)
        if (total == 0) {
            return ("function " + v.functionName + "() { [native code] }")
        }
        if (fnode.end <= fnode.start) {
            return ("function " + v.functionName + "() { [native code] }")
        }
        if (fnode.end > total) {
            return ("function " + v.functionName + "() { [native code] }")
        }
        return (substring v.srcText fnode.start fnode.end)
    }

    ; The rendering an object-like value converts to when the step in force
    ; resolves to the BUILT-IN method rather than one the guest supplied.
    fn defaultPrimitiveOf:EvalValue (v:EvalValue) {
        ; A boxed primitive IS its primitive: both of its inherited methods
        ; report it, so either hint lands here.
        if (v.valueType == 5) {
            if (has v.objectMap "__primitive__") {
                return (unwrap (get v.objectMap "__primitive__"))
            }
            if (has v.objectMap "__regex__") {
                return (EvalValue.string(("/" + ((this.regexSourceOf(v)) + ("/" + (this.regexFlagsOf(v)))))))
            }
            if (has v.objectMap "__error__") {
                return (EvalValue.string((this.errorToString(v))))
            }
            ; D-DATE: the default Date.prototype.toString, which is the whole
            ; date and time rather than a brand.
            if (has v.objectMap "__date__") {
                def dtd (new DateTime())
                return (EvalValue.string((dtd.toFullString(((unwrap (get v.objectMap "__date__")).toNumber())))))
            }
            return (EvalValue.string(("[object " + (this.objectClassOf(v)) + "]")))
        }
        if (v.valueType == 4) {
            return (EvalValue.string((this.arrayJoinString(v ","))))
        }
        if (v.valueType == 6) {
            return (EvalValue.string((this.functionSourceText(v))))
        }
        return (EvalValue.string(("[object " + (this.objectClassOf(v)) + "]")))
    }

    ; D-DATE: the DEFAULT hint -- no hint at all -- behaves as the NUMBER hint
    ; for every object except a Date, which behaves as the STRING hint. That is
    ; what makes `date + ""` the date's string form while `+date` and
    ; `Number(date)` are still its time value.
    ; The DEFAULT valueOf yields the object itself for almost everything, and
    ; that is no primitive -- which is why a number hint normally falls through
    ; to toString. Two kinds are different: a boxed primitive reports its
    ; primitive, and a Date reports its time value. `+new Date(6)` is 6 for
    ; exactly this reason.
    fn defaultValueOfIsPrimitive:boolean (v:EvalValue) {
        if (v.valueType != 5) {
            return false
        }
        if (has v.objectMap "__primitive__") {
            return true
        }
        if (has v.objectMap "__date__") {
            return true
        }
        return false
    }

    fn defaultValueOfOf:EvalValue (v:EvalValue) {
        if (has v.objectMap "__primitive__") {
            return (unwrap (get v.objectMap "__primitive__"))
        }
        if (has v.objectMap "__date__") {
            return (unwrap (get v.objectMap "__date__"))
        }
        return v
    }

    fn toPrimitiveDefault:EvalValue (v:EvalValue) {
        if (v.valueType == 5) {
            if (has v.objectMap "__date__") {
                return (this.toPrimitive(v true))
            }
        }
        return (this.toPrimitive(v false))
    }

    fn toPrimitive:EvalValue (v:EvalValue wantString:boolean) {
        ; Arrays and functions are object-like too and must convert, which is why
        ; `[1,2] + ''` is "1,2" and `+fn` is NaN. All three kinds run the SAME
        ; ordered pair -- valueOf then toString for a number hint, the other way
        ; for a string hint. Arrays and functions used to consult toString only,
        ; so a `valueOf` the guest hung on one was never asked, and a boxed
        ; primitive short-circuited to its primitive before either method got a
        ; turn: `(new String("ABC")).valueOf = f` had no effect.
        def objLike:boolean false
        if (v.valueType == 4) { objLike = true }
        if (v.valueType == 5) { objLike = true }
        if (v.valueType == 6) { objLike = true }
        if (objLike == false) {
            return v
        }
        def boxed:boolean (this.defaultValueOfIsPrimitive(v))
        def first:string "valueOf"
        def second:string "toString"
        if wantString {
            first = "toString"
            second = "valueOf"
        }
        def r1:EvalValue (this.callPrimitiveMethod(v first))
        if scriptThrew {
            return (EvalValue.undefined())
        }
        if primitiveMethodUsable {
            return r1
        }
        ; The step produced nothing usable. When it resolved to the BUILT-IN
        ; method, that method's own answer stands and the second step is never
        ; reached -- which is what makes `String({valueOf: f})` the brand rather
        ; than f's number. The default valueOf is the exception: it returns the
        ; object itself, which is no primitive, so only a boxed primitive can
        ; answer from that step.
        if (this.usesDefaultMethod(v first)) {
            if (first == "toString") {
                return (this.defaultPrimitiveOf(v))
            }
            if boxed {
                return (this.defaultValueOfOf(v))
            }
        }
        def r2:EvalValue (this.callPrimitiveMethod(v second))
        if scriptThrew {
            return (EvalValue.undefined())
        }
        if primitiveMethodUsable {
            return r2
        }
        if (this.usesDefaultMethod(v second)) {
            if (second == "toString") {
                return (this.defaultPrimitiveOf(v))
            }
            if boxed {
                return (this.defaultValueOfOf(v))
            }
        }
        ; Neither step yielded a primitive, and neither fell back to a default.
        ; That is the spec's TypeError -- an object whose valueOf and toString
        ; both return objects cannot be converted, and the suite checks that it
        ; says so rather than inventing an answer.
        return (this.throwSpecError("TypeError" "Cannot convert object to primitive value"))
    }

    ; ToNumber, honouring ToPrimitive for objects.
    ; D-STRNUM: ToNumber applied to a string, per the StringNumericLiteral
    ; grammar rather than by handing the text to the host parser. Two things go
    ; wrong otherwise: the host parse is LENIENT, so "12x" came back as 12 where
    ; the spec says NaN, and it knows nothing of the 0x / 0b / 0o prefixes, so
    ; Number("0xff") was 0.
    fn stringToNumber:double (raw:string) {
        def nan:double (0.0 / 0.0)
        def inf:double (1.0 / 0.0)
        def s:string (trim raw)
        def n:int (strlen s)
        if (n == 0) {
            return 0.0
        }
        ; Sign, which only a decimal literal or Infinity may carry.
        def sign:double 1.0
        def i:int 0
        def first:string (substring s 0 1)
        if (first == "-") {
            sign = (0.0 - 1.0)
            i = 1
        }
        if (first == "+") {
            i = 1
        }
        def body:string (substring s i n)
        if (body == "Infinity") {
            return (sign * inf)
        }
        if ((strlen body) == 0) {
            return nan
        }
        ; A radix prefix is only legal WITHOUT a sign.
        if ((i == 0) && ((strlen s) > 2)) {
            def p2:string (substring s 0 2)
            def radix:int 0
            if ((p2 == "0x") || (p2 == "0X")) { radix = 16 }
            if ((p2 == "0b") || (p2 == "0B")) { radix = 2 }
            if ((p2 == "0o") || (p2 == "0O")) { radix = 8 }
            if (radix > 0) {
                def digits:string (substring s 2 (strlen s))
                return (this.digitsToNumber(digits radix))
            }
        }
        ; Decimal: the whole remainder must be a well-formed literal, or the
        ; answer is NaN. The host parser stops at the first bad character and
        ; reports what it read, which is why this is validated first.
        if (false == (this.isDecimalLiteral(body))) {
            return nan
        }
        def d@(optional):double (to_double body)
        if d {
            return (sign * (unwrap d))
        }
        return nan
    }

    ; Digits in a given radix, or NaN when any character is not a digit of it.
    fn digitsToNumber:double (digits:string radix:int) {
        def nan:double (0.0 / 0.0)
        def n:int (strlen digits)
        if (n == 0) {
            return nan
        }
        def acc:double 0.0
        def i:int 0
        while (i < n) {
            def c:int (charAt digits i)
            def dv:int (0 - 1)
            if ((c >= 48) && (c <= 57)) { dv = (c - 48) }
            if ((c >= 97) && (c <= 122)) { dv = ((c - 97) + 10) }
            if ((c >= 65) && (c <= 90)) { dv = ((c - 65) + 10) }
            if (dv < 0) { return nan }
            if (dv >= radix) { return nan }
            acc = ((acc * (to_double radix)) + (to_double dv))
            i = (i + 1)
        }
        return acc
    }

    ; DecimalLiteral: digits with at most one dot, an optional exponent, and at
    ; least one digit in the mantissa.
    fn isDecimalLiteral:boolean (s:string) {
        def n:int (strlen s)
        if (n == 0) {
            return false
        }
        def i:int 0
        def mantissaDigits:int 0
        def dots:int 0
        def seenExp:boolean false
        def expDigits:int 0
        while (i < n) {
            def c:int (charAt s i)
            def isDigit:boolean ((c >= 48) && (c <= 57))
            if seenExp {
                if isDigit {
                    expDigits = (expDigits + 1)
                } {
                    ; A sign is allowed, but only right after the e.
                    if ((c == 43) || (c == 45)) {
                        if (expDigits > 0) { return false }
                        ; and only once, which a second sign would violate
                        if (i > 0) {
                            def prev:int (charAt s (i - 1))
                            if ((prev != 101) && (prev != 69)) { return false }
                        }
                    } {
                        return false
                    }
                }
            } {
                if isDigit {
                    mantissaDigits = (mantissaDigits + 1)
                } {
                    if (c == 46) {
                        dots = (dots + 1)
                        if (dots > 1) { return false }
                    } {
                        if ((c == 101) || (c == 69)) {
                            if (mantissaDigits == 0) { return false }
                            seenExp = true
                        } {
                            return false
                        }
                    }
                }
            }
            i = (i + 1)
        }
        if (mantissaDigits == 0) {
            return false
        }
        if seenExp {
            if (expDigits == 0) { return false }
        }
        return true
    }

    ; ToInteger: ToNumber, then truncate toward zero, with NaN becoming 0. The
    ; argument-taking Number methods are specified against this, and handing
    ; `to_int` a NaN directly produced a nonsense digit count.
    fn toIntegerOf:int (v:EvalValue) {
        def d:double (this.toNumberOf(v))
        if (d != d) {
            return 0
        }
        if (false == (this.isFiniteNum(d))) {
            if (d > 0.0) { return 2147483647 }
            return (0 - 2147483647)
        }
        ; Truncate TOWARD ZERO. `to_int` floors on this backend, so -0.1 became
        ; -1 and `(1).toFixed(-0.1)` raised a RangeError where the spec asks for
        ; ToInteger(-0.1) = 0.
        if (d < 0.0) {
            return (0 - (to_int (0.0 - d)))
        }
        return (to_int d)
    }

    ; ToUint16: ToInteger, then reduced modulo 2^16 into [0, 65535].
    ; ToInt32: ToNumber, truncate, then wrap modulo 2^32 into the signed range.
    ; The bitwise and shift operators are all specified against it, and reading
    ; `.toNumber()` off the value skipped the object conversion entirely --
    ; `({valueOf: function () { return 1; }}) << 1` answered 0.
    fn toInt32Of:int (v:EvalValue) {
        def d:double (this.toNumberOf(v))
        if (d != d) { return 0 }
        if (false == (this.isFiniteNum(d))) { return 0 }
        def t:double (this.floorNum(d))
        if (d < 0.0) {
            t = (0.0 - (this.floorNum((0.0 - d))))
        }
        def m:double (this.wrapUint32(t))
        def half:double 2147483648.0
        if (m >= half) {
            m = (m - (half * 2.0))
        }
        return (to_int m)
    }

    ; The value reduced into [0, 2^32).
    fn wrapUint32:double (t:double) {
        def two32:double 4294967296.0
        def q:double (this.floorNum((t / two32)))
        def m:double (t - (q * two32))
        if (m < 0.0) { m = (m + two32) }
        return m
    }

    ; ToUint32, as an int. Values at or above 2^31 saturate, since Ranger's int
    ; is signed 32-bit -- a limit that large is beyond any real string anyway.
    fn toUint32Of:int (v:EvalValue) {
        def d:double (this.toNumberOf(v))
        if (d != d) { return 0 }
        if (false == (this.isFiniteNum(d))) { return 0 }
        def t:double (this.floorNum(d))
        if (d < 0.0) {
            t = (0.0 - (this.floorNum((0.0 - d))))
        }
        def m:double (this.wrapUint32(t))
        if (m > 2147483647.0) {
            return 2147483647
        }
        return (to_int m)
    }

    fn toUint16Of:int (v:EvalValue) {
        def d:double (this.toNumberOf(v))
        ; NaN and the infinities all map to +0 before the modulo, so
        ; String.fromCharCode(Infinity) is "\u0000" rather than "\uffff".
        if (d != d) {
            return 0
        }
        if (false == (this.isFiniteNum(d))) {
            return 0
        }
        def i:int (this.toIntegerOf(v))
        def m:int (i % 65536)
        if (m < 0) {
            m = (m + 65536)
        }
        return m
    }

    fn toNumberOf:double (v:EvalValue) {
        def p:EvalValue (this.toPrimitive(v false))
        if (p.isString()) {
            return (this.stringToNumber(p.stringValue))
        }
        if (p.isUndefined()) {
            return (0.0 / 0.0)
        }
        if (p.isNull()) {
            return 0.0
        }
        return (p.toNumber())
    }

    fn arrayNeedsCallback:boolean (name:string) {
        if (name == "forEach") { return true }
        if (name == "map") { return true }
        if (name == "filter") { return true }
        if (name == "find") { return true }
        if (name == "findIndex") { return true }
        if (name == "some") { return true }
        if (name == "every") { return true }
        if (name == "reduce") { return true }
        if (name == "reduceRight") { return true }
        return false
    }

    ; D-DESCVALID: a property descriptor may be a DATA descriptor (value and/or
    ; writable) or an ACCESSOR descriptor (get and/or set), never both, and its
    ; get/set must be callable. Accepting a contradictory descriptor silently
    ; produced a property that matched neither shape.
    fn descriptorError:string (d:EvalValue) {
        def hasValue:boolean (this.descHas(d "value"))
        def hasWritable:boolean (this.descHas(d "writable"))
        def hasGet:boolean (this.descHas(d "get"))
        def hasSet:boolean (this.descHas(d "set"))
        if (hasGet || hasSet) {
            if (hasValue || hasWritable) {
                return "descriptor cannot be both a data and an accessor descriptor"
            }
            if hasGet {
                def g:EvalValue (this.descGet(d "get"))
                if (g.valueType != 6) {
                    if (false == (g.isUndefined())) {
                        return "getter must be a function"
                    }
                }
            }
            if hasSet {
                def st:EvalValue (this.descGet(d "set"))
                if (st.valueType != 6) {
                    if (false == (st.isUndefined())) {
                        return "setter must be a function"
                    }
                }
            }
        }
        return ""
    }

    ; D-REDEFINE: whether a defineProperty call is legal against the property
    ; that is already there. A NON-CONFIGURABLE property is close to frozen: its
    ; configurable and enumerable flags cannot change, and if it is also
    ; non-writable neither its writability nor its value may change. Adding a
    ; new property to a non-extensible object is likewise rejected. Accepting
    ; any of these silently let a test's setup succeed where the spec requires
    ; it to fail. Returns "" when the redefinition is allowed.
    ; ==========================================================================
    ; D-REGEX: RegExp values, and the four String methods specified against them.
    ; --------------------------------------------------------------------------
    ; A RegExp is an ordinary object carrying its source and flags plus the
    ; internal marker `__regex__`. The compiled program is NOT stored on it --
    ; Ranger has no way to put a RegexProgram inside an EvalValue -- so it is
    ; recompiled from source at each use. That is slower than caching and
    ; entirely invisible to the guest, which is the trade this design makes.
    ; --------------------------------------------------------------------------
    fn buildRegexFromArgs:EvalValue (argNodes:[TSNode]) {
        return (this.buildRegexFromArgNodes(argNodes false))
    }

    ; D-REGEX: `RegExp(re)` called as a FUNCTION with no flags answers `re`
    ; ITSELF -- 15.10.3.1 -- while `new RegExp(re)` makes a copy. Copying in both
    ; forms meant a property later put on the original was invisible through the
    ; result.
    fn buildRegexFromArgNodes:EvalValue (argNodes:[TSNode] asNew:boolean) {
        def pattern:string ""
        def flags:string ""
        def sawFlags:boolean false
        def srcRegex:EvalValue (EvalValue.null())
        if ((array_length argNodes) > 0) {
            def pv:EvalValue (this.evaluateExpr((itemAt argNodes 0)))
            if scriptThrew {
                return (EvalValue.undefined())
            }
            if (this.isRegexValue(pv)) {
                srcRegex = pv
                pattern = (this.regexSourceOf(pv))
                flags = (this.regexFlagsOf(pv))
            } {
                if (false == (pv.isUndefined())) {
                    pattern = (this.toStringOf(pv))
                    if scriptThrew {
                        return (EvalValue.undefined())
                    }
                }
            }
        }
        if ((array_length argNodes) > 1) {
            def fv:EvalValue (this.evaluateExpr((itemAt argNodes 1)))
            if scriptThrew {
                return (EvalValue.undefined())
            }
            if (false == (fv.isUndefined())) {
                flags = (this.toStringOf(fv))
                if scriptThrew {
                    return (EvalValue.undefined())
                }
                sawFlags = true
            }
        }
        ; D-REGEX: the plain call form answers its argument UNCHANGED when it is
        ; already a RegExp and no flags are given (15.10.3.1). Supplying flags
        ; re-reads the source with them -- ES5 made that a TypeError, ES2015
        ; allows it, and the current corpus is written against ES2015.
        if (srcRegex.valueType == 5) {
            if (false == sawFlags) {
                if (false == asNew) {
                    return srcRegex
                }
            }
        }
        def flagErr:string (this.regexFlagError(flags))
        if ((strlen flagErr) > 0) {
            return (this.throwSpecError("SyntaxError" flagErr))
        }
        ; A malformed pattern is a SyntaxError at construction, not at first use.
        def probe (new RegexCompiler)
        def prog:RegexProgram (probe.compile(pattern flags))
        if (false == prog.valid) {
            return (this.throwSpecError("SyntaxError" ("Invalid regular expression: " + prog.errorMessage)))
        }
        return (this.makeRegexValue(pattern flags))
    }

    ; D-REGEX: the same construction as buildRegexFromArgNodes, from values that
    ; have already been evaluated -- which is what a captured constructor has.
    fn buildRegexFromValues:EvalValue (args:[EvalValue] asNew:boolean) {
        def pattern:string ""
        def flags:string ""
        def sawFlags:boolean false
        def srcRegex:EvalValue (EvalValue.null())
        if ((array_length args) > 0) {
            def pv:EvalValue (itemAt args 0)
            if (this.isRegexValue(pv)) {
                srcRegex = pv
                pattern = (this.regexSourceOf(pv))
                flags = (this.regexFlagsOf(pv))
            } {
                if (false == (pv.isUndefined())) {
                    pattern = (this.toStringOf(pv))
                    if scriptThrew {
                        return (EvalValue.undefined())
                    }
                }
            }
        }
        if ((array_length args) > 1) {
            def fv:EvalValue (itemAt args 1)
            if (false == (fv.isUndefined())) {
                flags = (this.toStringOf(fv))
                if scriptThrew {
                    return (EvalValue.undefined())
                }
                sawFlags = true
            }
        }
        if (srcRegex.valueType == 5) {
            if (false == sawFlags) {
                if (false == asNew) {
                    return srcRegex
                }
            }
        }
        def flagErr2:string (this.regexFlagError(flags))
        if ((strlen flagErr2) > 0) {
            return (this.throwSpecError("SyntaxError" flagErr2))
        }
        def probe2 (new RegexCompiler)
        def prog2:RegexProgram (probe2.compile(pattern flags))
        if (false == prog2.valid) {
            return (this.throwSpecError("SyntaxError" ("Invalid regular expression: " + prog2.errorMessage)))
        }
        return (this.makeRegexValue(pattern flags))
    }

    ; D-REGEX: the ES5 flag set is exactly g, i and m, each at most once.
    ; Anything else is a SyntaxError; the flags string used to be scanned for
    ; the three it knew and everything else silently ignored.
    fn regexFlagError:string (flags:string) {
        def seenG:boolean false
        def seenI:boolean false
        def seenM:boolean false
        def i:int 0
        while (i < (strlen flags)) {
            def f:string (substring flags i (i + 1))
            if (f == "g") {
                if seenG {
                    return ("Invalid flags supplied to RegExp constructor '" + (flags + "'"))
                }
                seenG = true
            } {
                if (f == "i") {
                    if seenI {
                        return ("Invalid flags supplied to RegExp constructor '" + (flags + "'"))
                    }
                    seenI = true
                } {
                    if (f == "m") {
                        if seenM {
                            return ("Invalid flags supplied to RegExp constructor '" + (flags + "'"))
                        }
                        seenM = true
                    } {
                        return ("Invalid flags supplied to RegExp constructor '" + (flags + "'"))
                    }
                }
            }
            i = (i + 1)
        }
        return ""
    }

    fn makeRegexValue:EvalValue (pattern:string flags:string) {
        def keysR:[string]
        def valsR:[EvalValue]
        def r:EvalValue (EvalValue.object(keysR valsR))
        r.setMember("__regex__" (EvalValue.string(pattern)))
        r.setAttrs("__regex__" false false false)
        r.setMember("source" (EvalValue.string(pattern)))
        r.setAttrs("source" false false false)
        r.setMember("flags" (EvalValue.string(flags)))
        r.setAttrs("flags" false false false)
        r.setMember("global" (EvalValue.boolean(((indexOf flags "g") >= 0))))
        r.setAttrs("global" false false false)
        r.setMember("ignoreCase" (EvalValue.boolean(((indexOf flags "i") >= 0))))
        r.setAttrs("ignoreCase" false false false)
        r.setMember("multiline" (EvalValue.boolean(((indexOf flags "m") >= 0))))
        r.setAttrs("multiline" false false false)
        ; lastIndex is the one WRITABLE property -- exec advances it -- but it is
        ; not enumerable, so it never shows up in Object.keys or as a descriptor
        ; when a RegExp is handed to Object.defineProperties.
        r.setMember("lastIndex" (EvalValue.fromInt(0)))
        r.setAttrs("lastIndex" true false false)
        r.protoRef = (this.builtinPrototype("RegExp"))

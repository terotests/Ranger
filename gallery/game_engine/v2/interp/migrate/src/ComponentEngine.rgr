                        return (this.callFnValueWithValues(fnValue callArgVals))
                    }
                    ; D-CTORVALUE: a built-in CONSTRUCTOR bound to a name -- by
                    ; assignment or by bind() -- has no function node but is
                    ; callable. Any arguments bind() fixed come first.
                    def ctorNm0:string (this.builtinCtorNameOf(fnValue))
                    if ((strlen ctorNm0) > 0) {
                        def ctorArgs0:[EvalValue] (this.collectCallArgs(node))
                        if scriptThrew {
                            return (EvalValue.undefined())
                        }
                        def merged0:[EvalValue]
                        def mi0:int 0
                        while (mi0 < (array_length fnValue.boundArgs)) {
                            push merged0 (itemAt fnValue.boundArgs mi0)
                            mi0 = (mi0 + 1)
                        }
                        def mj0:int 0
                        while (mj0 < (array_length ctorArgs0)) {
                            push merged0 (itemAt ctorArgs0 mj0)
                            mj0 = (mj0 + 1)
                        }
                        return (this.callBuiltinCtorValues(ctorNm0 merged0 false))

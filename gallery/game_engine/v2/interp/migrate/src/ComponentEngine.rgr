                def wi:int 0
                while (wi < (array_length wItems)) {
                    def wIt:EvHandle (itemAt wItems wi)
                    if (wKind == "weakmap") {
                        def wK:EvHandle (this.getPropertyValue(wIt "0"))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                        def wV:EvHandle (this.getPropertyValue(wIt "1"))
                        if scriptThrew {

        ; intermediates may live in expression slots: `t += (i + 1) * (i + 2)`
        ; mints nothing at all. Otherwise the ordinary evaluator, whose result
        ; still lands in the slot when it is a number.
        ; Only a BINARY right-hand side can hold intermediates worth slotting;
        ; `s += i` goes straight to the ordinary evaluator, so the common shape
        ; pays nothing for the check. A MEMBER read joins it: `t += a[j]` is a
        ; dense-element hit the transient path answers without a handle or a
        ; property-key string.
        def rhs:TSNode (unwrap node.right)
        def rv:EvHandle (EvValueBridge.taggedUndefined())
        def rhsK:int (this.nodeKindOf(rhs))
        if ((rhsK == 5) || (rhsK == 3)) {
            rv = (this.evaluateExprTransient(rhs))
        } {
            rv = (this.evaluateExpr(rhs))
        }
        if scriptThrew {
            return true
        }
        if (false == (rv.isNumber())) {

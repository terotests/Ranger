    ; ; / ? : @ & = + $ , #
    fn uriReserved:boolean (c:int) {
        if (c == 59) { return true }
        if (c == 47) { return true }
        if (c == 63) { return true }
        if (c == 58) { return true }
        if (c == 64) { return true }
        if (c == 38) { return true }
        if (c == 61) { return true }
        if (c == 43) { return true }
        if (c == 36) { return true }
        if (c == 44) { return true }
        if (c == 35) { return true }
        return false
    }

    fn uriPercentByte:string (b:int) {
        return ("%" + (this.hexPad((bit_and b 255) 2)))
    }

    ; Encode ONE code point as its UTF-8 bytes, percent-escaped.
    fn uriEncodeCodePoint:string (cp:int) {
        if (cp < 128) {
            return (this.uriPercentByte(cp))
        }
        if (cp < 2048) {
            def b1:int (bit_or 192 (bit_shr cp 6))
            def b2:int (bit_or 128 (bit_and cp 63))
            return ((this.uriPercentByte(b1)) + (this.uriPercentByte(b2)))
        }
        if (cp < 65536) {
            def c1:int (bit_or 224 (bit_shr cp 12))
            def c2:int (bit_or 128 (bit_and (bit_shr cp 6) 63))
            def c3:int (bit_or 128 (bit_and cp 63))
            return (((this.uriPercentByte(c1)) + (this.uriPercentByte(c2))) + (this.uriPercentByte(c3)))
        }
        def d1:int (bit_or 240 (bit_shr cp 18))
        def d2:int (bit_or 128 (bit_and (bit_shr cp 12) 63))
        def d3:int (bit_or 128 (bit_and (bit_shr cp 6) 63))
        def d4:int (bit_or 128 (bit_and cp 63))
        return ((((this.uriPercentByte(d1)) + (this.uriPercentByte(d2))) + (this.uriPercentByte(d3))) + (this.uriPercentByte(d4)))
    }

    fn uriEncode:EvHandle (s:string keepReserved:boolean) {

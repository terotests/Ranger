                        return (this.jsonParse(js))
                    }
                }
                if (arrStaticName == "console") {
                    if ((methodName == "log") || (methodName == "warn") || (methodName == "error") || (methodName == "info") || (methodName == "debug")) {
                        ; Host stdout is shared with the engine; prefix with [tsx]
                        ; so script logging is distinguishable (see engine.d.ts).
                        def line:string "[tsx]"
                        def ci:int 0
                        while (ci < (array_length node.children)) {
                            line = (line + " ")
                            line = (line + ((this.evaluateExpr((itemAt node.children ci))).toString()))
                            ci = (ci + 1)
                        }
                        print line
                        return (EvalValue.undefined())
                    }
                }

                ; Handle Math methods (Math is not a runtime object — match callee identifier)
                def mathObjName:string ""
                if callee.left {
                    def mathObjNode:TSNode (unwrap callee.left)
                    if (mathObjNode.nodeType == "Identifier") {
                        mathObjName = mathObjNode.name
                    }
                }
                if (mathObjName == "Math") {
                    ; D-STATICS: one implementation, reached from the call site and from a
                    ; captured value alike. The 130-line chain that stood here duplicated
                    ; the arithmetic and had floor, ceil, round and trunc all truncating
                    ; toward zero, so every one of them was wrong for a negative argument.
                    if (this.hasBuiltinStatic("Math" methodName)) {
                        def mArgs:[EvalValue] (this.collectCallArgs(node))
                        return (this.invokeBuiltinStatic("Math" methodName mArgs))
                    }
                }

                ; D-CLASSSTATIC: `A.s()` where A names a class. A class is not a
                ; scope binding in this engine, so the receiver evaluated to
                ; nothing and the call went nowhere; resolve the static method
                ; from the class table by the callee's own name instead.
                if callee.left {
                    def sObjNode:TSNode (unwrap callee.left)
                    if (sObjNode.nodeType == "Identifier") {
                        def sClsName:string sObjNode.name
                        def sCls:TSNode (this.classNodeByName(sClsName))
                        if (sCls.nodeType == "ClassDeclaration") {
                            def sM:TSNode (this.findStaticMethodOnClassNode(sCls methodName))
                            if (sM.nodeType == "MethodDefinition") {
                                return (this.callUserFunctionNode(sM node.children (EvalValue.null()) false))
                            }
                        }
                    }
                }

                ; D-FNPROTO: Function.prototype call / apply / bind. ES5 core and
                ; used pervasively — Test262 reaches for them constantly to invoke
                ; a function with a chosen receiver, so their absence failed tests
                ; that were not about them at all.
                if (obj.valueType == 6) {
                    if obj.functionNode {
                        if (methodName == "call") {
                            def callThis:EvalValue (EvalValue.undefined())
                            def callArgs:[EvalValue]
                            def cai:int 0
                            while (cai < (array_length node.children)) {
                                def cv:EvalValue (this.evaluateExpr((itemAt node.children cai)))
                                if (cai == 0) {
                                    callThis = cv
                                } {
                                    push callArgs cv
                                }
                                cai = (cai + 1)
                            }
                            def callBound:EvalValue (obj.withThis(callThis))
                            return (this.callFnValueWithValues(callBound callArgs))
                        }
                        if (methodName == "apply") {
                            def applyThis:EvalValue (EvalValue.undefined())
                            def applyArgs:[EvalValue]
                            if ((array_length node.children) > 0) {
                                applyThis = (this.evaluateExpr((itemAt node.children 0)))
                            }
                            if ((array_length node.children) > 1) {
                                def arr:EvalValue (this.evaluateExpr((itemAt node.children 1)))
                                if (arr.isArray()) {
                                    def aai:int 0
                                    while (aai < (array_length arr.arrayValue)) {
                                        push applyArgs (itemAt arr.arrayValue aai)
                                        aai = (aai + 1)
                                    }
                                }
                            }
                            def applyBound:EvalValue (obj.withThis(applyThis))
                            return (this.callFnValueWithValues(applyBound applyArgs))
                        }
                        if (methodName == "bind") {
                            def bindThis:EvalValue (EvalValue.undefined())
                            def partial:[EvalValue]
                            def bai:int 0
                            while (bai < (array_length node.children)) {
                                def bv:EvalValue (this.evaluateExpr((itemAt node.children bai)))
                                if (bai == 0) {
                                    bindThis = bv
                                } {
                                    push partial bv
                                }
                                bai = (bai + 1)
                            }
                            ; The receiver is fixed permanently; partially applied
                            ; arguments are prepended at call time.
                            def bound:EvalValue (obj.withThis(bindThis))
                            bound.boundArgs = partial
                            bound.functionName = ("bound " + obj.functionName)
                            return bound
                        }
                    }
                }

                ; D-OBJPROTO: the Object.prototype methods every object carries.
                ; Surfaced by the TypeError above: hasOwnProperty was the single
                ; largest failure bucket the moment missing methods stopped
                ; failing silently.
                if (methodName == "hasOwnProperty") {
                    def hk:string ""
                    if ((array_length node.children) > 0) {
                        hk = ((this.evaluateExpr((itemAt node.children 0))).toString())
                    }
                    ; OWN properties only — an inherited one must answer false,
                    ; which is the entire point of the method.
                    if (has obj.objectMap hk) {
                        return (EvalValue.boolean(true))
                    }
                    if (has obj.getterMap hk) {
                        return (EvalValue.boolean(true))
                    }
                    if (has obj.setterMap hk) {
                        return (EvalValue.boolean(true))
                    }
                    ; D-FNPROPS / D-INDEXDESC: array indices, array length and a
                    ; function's synthesised length/name/prototype are own
                    ; properties too, even though none of them lives in
                    ; objectMap. objHasKey is the single answer to "does this
                    ; value own that name".
                    return (EvalValue.boolean((this.objHasKey(obj hk))))
                }
                if (methodName == "propertyIsEnumerable") {
                    def pk2:string ""
                    if ((array_length node.children) > 0) {
                        pk2 = ((this.evaluateExpr((itemAt node.children 0))).toString())
                    }
                    ; Own AND enumerable -- an own property that defineProperty
                    ; made non-enumerable must answer false.
                    if (false == (this.objHasKey(obj pk2))) {
                        return (EvalValue.boolean(false))
                    }
                    return (EvalValue.boolean((obj.isEnumerable(pk2))))
                }
                if (methodName == "isPrototypeOf") {
                    if ((array_length node.children) > 0) {
                        def cand:EvalValue (this.evaluateExpr((itemAt node.children 0)))
                        def walk:EvalValue cand
                        def steps:int 0
                        while (steps < 16) {
                            if (null? walk.protoRef) {
                                steps = 16
                            } {
                                def nxt:EvalValue (unwrap walk.protoRef)
                                if (nxt.equals(obj)) {
                                    return (EvalValue.boolean(true))
                                }
                                walk = nxt
                                steps = (steps + 1)
                            }
                        }
                    }
                    return (EvalValue.boolean(false))
                }

                ; D-ERRORS: nothing handled this method. Calling a property that
                ; is not a function is a TypeError, and answering null instead is
                ; the silent-failure mode that made whole corpora unmeasurable:
                ; the call does nothing and the assertion after it never runs.
                ; Only raised for receivers that can hold properties — a method
                ; the engine simply has not implemented on a primitive stays a
                ; trace, since that is the engine's gap and not the guest's.
                this.trace("Warning: Unhandled method call: " + methodName)
                if strictReferences {
                    def rcvHolds:boolean false
                    if (obj.valueType == 5) { rcvHolds = true }
                    if (obj.valueType == 6) { rcvHolds = true }
                    ; D-REGISTRY: arrays join the list now that the registry says
                    ; exactly which methods an array has. Before, an unregistered
                    ; name could still have been served by the unguarded block,
                    ; so throwing would have been wrong.
                    if (obj.valueType == 4) { rcvHolds = true }
                    if rcvHolds {
                        return (this.throwSpecError("TypeError" (methodName + " is not a function")))
                    }
                }
                return (EvalValue.null())
            }
            
            ; D-CLASSEXTENDS: `super(...)` inside a derived constructor runs the
            ; base constructor against the instance being built. Previously it
            ; did nothing, so every field the base set was simply missing.
            def isSuperCall:boolean (callee.nodeType == "Super")
            if (callee.nodeType == "Identifier") {
                if (callee.name == "super") {
                    isSuperCall = true
                }
            }
            if isSuperCall {
                {
                    def selfV:EvalValue (context.lookup("this"))
                    if (selfV.valueType == 5) {
                        def ownCls:string (this.instanceClassName(selfV))
                        def ownNode:TSNode (this.classNodeByName(ownCls))
                        if (ownNode.nodeType == "ClassDeclaration") {
                            this.runSuperConstructor(ownNode selfV node.children 0)
                        }
                    }
                    return (EvalValue.undefined())
                }
            }

            ; Handle regular function calls
            if (callee.nodeType == "Identifier") {
                def fnName:string callee.name
                if (false == quiet) {
                    this.trace("Evaluating function call: " + fnName)
                }
                
                ; ============================================================
                ; Global numeric functions
                ; ============================================================
                ; AssemblyScript sized-int cast call: i32(x), u8(x), f64(x), …
                if (this.isSizedTypeName(fnName)) {
                    if ((array_length node.children) > 0) {
                        def cv:double ((this.evaluateExpr((itemAt node.children 0))).toNumber())
                        return (this.castSized(fnName cv))
                    }
                    return (EvalValue.number(0.0))
                }
                ; D-SYMBOL: `Symbol(desc)` mints a fresh unique value. Each call
                ; must produce a value equal only to itself, which the object
                ; identity stamp already gives.
                if (fnName == "Symbol") {
                    def sDesc:string ""
                    if ((array_length node.children) > 0) {
                        def sdv:EvalValue (this.evaluateExpr((itemAt node.children 0)))
                        if (false == (sdv.isUndefined())) {
                            sDesc = (sdv.toString())
                        }
                    }
                    def keysY:[string]
                    def valsY:[EvalValue]
                    def minted:EvalValue (EvalValue.object(keysY valsY))
                    minted.setMember("__symbol__" (EvalValue.string(sDesc)))
                    minted.setMember("description" (EvalValue.string(sDesc)))
                    return minted
                }
                ; D-EVAL: direct eval. Parses the string and runs it in the
                ; CURRENT scope, so declarations it makes are visible to the
                ; caller and free variables resolve against the call site — that
                ; is what distinguishes direct eval from a fresh realm. The value
                ; is the last expression statement's, per completion-value rules.
                if (fnName == "eval") {
                    if ((array_length node.children) == 0) {
                        return (EvalValue.undefined())
                    }
                    def evSrcV:EvalValue (this.evaluateExpr((itemAt node.children 0)))
                    ; eval of a non-string returns the argument untouched.
                    if (false == (evSrcV.isString())) {
                        return evSrcV
                    }
                    return (this.runEvalSource(evSrcV.stringValue))
                }
                ; D-CTORCALL: the constructor globals called WITHOUT `new`.
                ; `Array(2)` is identical to `new Array(2)`, and returned null
                ; instead — so `Array(2).length` read a property of null. Same
                ; for Object(x).
                if (fnName == "Array") {
                    return (this.buildArrayFromArgs(node.children))
                }
                if (fnName == "Object") {
                    def ov:EvalValue (EvalValue.null())
                    if ((array_length node.children) > 0) {
                        ov = (this.evaluateExpr((itemAt node.children 0)))
                    }
                    return (this.toObjectValue(ov))
                }
                ; D-FNCTOR: `Function(body)` / `new Function(a, b, body)` compiles
                ; a function from source. The last argument is the body, the rest
                ; are parameter names. Built on the same parser eval uses.
                if (fnName == "Function") {
                    return (this.buildFunctionFromSource(node.children))
                }
                if (fnName == "parseInt") {
                    if ((array_length node.children) > 0) {
                        def pv:EvalValue (this.evaluateExpr((itemAt node.children 0)))
                        return (EvalValue.fromInt((to_int (pv.toNumber()))))
                    }
                    return (EvalValue.number(0.0))
                }
                if (fnName == "parseFloat") {
                    if ((array_length node.children) > 0) {
                        def pv:EvalValue (this.evaluateExpr((itemAt node.children 0)))
                        return (EvalValue.number((pv.toNumber())))
                    }
                    return (EvalValue.number(0.0))
                }
                ; Type-conversion globals Number()/String()/Boolean().
                if (fnName == "Number") {
                    if ((array_length node.children) > 0) {
                        ; ToNumber proper: an object runs valueOf/toString and a
                        ; string goes through the StringNumericLiteral grammar.
                        return (EvalValue.number((this.toNumberOf((this.evaluateExpr((itemAt node.children 0)))))))
                    }
                    return (EvalValue.number(0.0))
                }
                if (fnName == "String") {
                    if ((array_length node.children) > 0) {
                        ; ToString, which for an object means running its own
                        ; toString/valueOf. The raw EvalValue.toString() is the
                        ; engine's debug dump, so `String({toString: …})`
                        ; answered "{toString: [Function: ]}".
                        def sArg:EvalValue (this.evaluateExpr((itemAt node.children 0)))
                        return (EvalValue.string((this.toStringOf(sArg))))
                    }
                    return (EvalValue.string(""))
                }
                if (fnName == "Boolean") {
                    if ((array_length node.children) > 0) {
                        return (EvalValue.boolean(((this.evaluateExpr((itemAt node.children 0))).toBool())))
                    }
                    return (EvalValue.boolean(false))
                }
                ; isNaN / isFinite. All numbers here are IEEE doubles; NaN is
                ; detected via the self-inequality identity (n != n). Infinity is
                ; not representable as a literal, so isFinite only rules out NaN.
                if (fnName == "isNaN") {
                    if ((array_length node.children) > 0) {
                        def nn:double (this.toNumberOf((this.evaluateExpr((itemAt node.children 0)))))
                        return (EvalValue.boolean((nn != nn)))
                    }
                    return (EvalValue.boolean(true))
                }
                if (fnName == "isFinite") {
                    if ((array_length node.children) > 0) {
                        ; Infinity is not NaN, so the old `nf == nf` test called
                        ; it finite. Both infinities have to be excluded too.
                        def nf:double (this.toNumberOf((this.evaluateExpr((itemAt node.children 0)))))
                        return (EvalValue.boolean((this.isFiniteNum(nf))))
                    }
                    return (EvalValue.boolean(false))
                }

                ; ============================================================
                ; Handle built-in hooks
                ; ============================================================
                if (fnName == "usePrintSettings") {
                    return (this.evaluateUsePrintSettings())
                }
                if (fnName == "useImage") {
                    ; Get the src argument from node.children
                    def srcArg:string ""
                    if ((array_length node.children) > 0) {
                        def argNode:TSNode (itemAt node.children 0)
                        this.trace("useImage arg nodeType: " + argNode.nodeType)
                        def argValue:EvalValue (this.evaluateExpr(argNode))
                        if (false == quiet) {
                            this.trace("useImage arg value: " + (argValue.toString()) + " type=" + (to_string argValue.valueType))
                        }
                        srcArg = argValue.stringValue
                        this.trace("useImage srcArg: " + srcArg)
                    }
                    return (this.evaluateUseImage(srcArg))
                }

                if (nativeBridge) {
                    def bridge:EvalNativeBridge (unwrap nativeBridge)
                    if (bridge.has(fnName)) {
                        def nativeArgs:[EvalValue] (this.collectCallArgs(node))
                        return (bridge.invoke(fnName nativeArgs))
                    }
                }
                
                ; Look up the function in context
                def fnValue:EvalValue (context.lookup(fnName))
                if (false == quiet) {
                    this.trace("Lookup function '" + fnName + "' -> type=" + (to_string fnValue.valueType) + " isFunction=" + (to_string (fnValue.isFunction())))
                }
                ; D-REGISTRY: a built-in held in a variable is callable like any
                ; other function value. It has no functionNode, so the paths
                ; below skip it and it would silently do nothing.
                if (fnValue.isBuiltinMethod()) {
                    def bArgs0:[EvalValue] (this.collectCallArgs(node))
                    return (this.callFnValueWithValues(fnValue bArgs0))
                }
                if (fnValue.isFunction()) {
                    if fnValue.functionNode {
                        ; Args (with ...spread) bound centrally; the call scope is
                        ; parented on the function's captured closure when it has
                        ; one, else the current scope (plain top-level functions).
                        def callArgVals:[EvalValue] (this.collectCallArgs(node))
                        return (this.callFnValueWithValues(fnValue callArgVals))
                    }
                }
            }

            ; Callee is itself an expression that yields a function value, e.g.
            ; an IIFE `(() => ({...}))()` or `(cond ? a : b)()`. Inline arrow/
            ; function expressions capture the current scope; anything else is
            ; evaluated. MemberExpression/Identifier callees are handled above.
            def calleeFn:EvalValue (this.resolveCallbackValue(callee))
            ; D-REGISTRY: same for a built-in reached through an expression
            ; callee, e.g. `(cond ? a.slice : b.slice)(...)`.
            if (calleeFn.isBuiltinMethod()) {
                def bArgs1:[EvalValue] (this.collectCallArgs(node))
                return (this.callFnValueWithValues(calleeFn bArgs1))
            }
            if (calleeFn.isFunction()) {
                if calleeFn.functionNode {
                    def calleeArgs:[EvalValue] (this.collectCallArgs(node))
                    return (this.callFnValueWithValues(calleeFn calleeArgs))
                }
            }

            ; D-ERRORS: nothing callable was found. Per spec this is a
            ; ReferenceError when the name resolves to nothing at all, and a
            ; TypeError when it resolves to a value that is not callable.
            ; Falling through to null here is what let entire test corpora pass
            ; vacuously: every call to an unimplemented global quietly did
            ; nothing and the assertion after it never ran.
            if strictReferences {
                if (callee.nodeType == "Identifier") {
                    def cName:string callee.name
                    if (false == (this.isCallableName(cName))) {
                        if (this.nameResolves(cName)) {
                            return (this.throwSpecError("TypeError" (cName + " is not a function")))
                        }
                        return (this.throwSpecError("ReferenceError" (cName + " is not defined")))
                    }
                }
            }
        }

        return (EvalValue.null())
    }

    ; Whether a bare name resolves to anything at all (a binding, an engine
    ; global, or an error constructor). Used to pick ReferenceError vs TypeError.
    fn nameResolves:boolean (name:string) {
        if (context.has(name)) {
            return true
        }
        this.ensureErrorCtors()
        if (hostScope.has(name)) {
            return true
        }
        return (this.isEngineGlobalName(name))
    }

    ; Names the engine dispatches as calls without a binding (built-in globals
    ; handled earlier in evaluateCallExpr). Reaching the fallback with one of
    ; these means the engine chose not to handle that particular call, which is
    ; not the guest's error, so it stays silent.
    fn isCallableName:boolean (name:string) {
        if (this.isSizedTypeName(name)) { return true }
        if (name == "parseInt") { return true }
        if (name == "parseFloat") { return true }
        if (name == "isNaN") { return true }
        if (name == "isFinite") { return true }
        if (name == "String") { return true }
        if (name == "Number") { return true }
        if (name == "Boolean") { return true }
        if (name == "Array") { return true }
        if (name == "Object") { return true }
        if (name == "require") { return true }
        if (name == "super") { return true }
        return false
    }
    
    fn evaluateBinaryExpr:EvalValue (node:TSNode) {
        def op:string node.value
        
        ; Logical operators with short-circuit evaluation
        if (op == "&&") {
            if node.left {
                def leftExpr:TSNode (unwrap node.left)
                def left:EvalValue (this.evaluateExpr(leftExpr))
                if ((left.toBool()) == false) {
                    return left
                }
                if node.right {
                    def rightExpr:TSNode (unwrap node.right)
                    return (this.evaluateExpr(rightExpr))
                }
            }
        }
        
        if (op == "||") {
            if node.left {
                def leftExpr:TSNode (unwrap node.left)
                def left:EvalValue (this.evaluateExpr(leftExpr))
                if (left.toBool()) {
                    return left
                }
                if node.right {
                    def rightExpr:TSNode (unwrap node.right)
                    return (this.evaluateExpr(rightExpr))
                }
            }
        }

        if (op == "??") {
            if node.left {
                def leftExpr:TSNode (unwrap node.left)
                def left:EvalValue (this.evaluateExpr(leftExpr))
                ; nullish: fall through to the right only when left is null OR
                ; undefined (a missing member now reads as undefined — rule 6).
                if (false == ((left.isNull()) || (left.isUndefined()))) {
                    return left
                }
                if node.right {
                    def rightExpr:TSNode (unwrap node.right)
                    return (this.evaluateExpr(rightExpr))
                }
            }
        }
        
        ; instanceof: right side is a class NAME, not a value — compare against the
        ; instance's __class__ tag (no inheritance chain in this interpreter).
        if (op == "instanceof") {
            if node.left {
                def lv:EvalValue (this.evaluateExpr((unwrap node.left)))
                def cname:string ""
                if node.right {
                    def rn:TSNode (unwrap node.right)
                    cname = rn.name
                }
                ; D-INSTANCEOF: the built-in constructors. `[] instanceof Array`,
                ; `({}) instanceof Object` and `f instanceof Function` were all
                ; false, because the check below only knows about `__class__`
                ; tags and `constructor` identity -- neither of which a literal
                ; carries. These are the shapes the suite tests with constantly.
                if (this.isBuiltinCtorName(cname)) {
                    def bRes:int (this.builtinInstanceOf(lv cname))
                    if (bRes >= 0) {
                        return (EvalValue.boolean((bRes == 1)))
                    }
                }
                if (lv.isObject()) {
                    def tag:EvalValue (lv.getMember("__class__"))
                    if (tag.isString()) {
                        return (EvalValue.boolean(((tag.stringValue) == cname)))
                    }
                    ; D-ERRORS: every native error inherits from Error, so
                    ; `e instanceof Error` holds for a TypeError as much as
                    ; `e instanceof TypeError` does. The identity check below
                    ; compares constructors and would say false, which is the one
                    ; case where the missing inheritance chain is observable in
                    ; ordinary guest code -- `catch (e) { e instanceof Error }`
                    ; is how half the suite's negative tests confirm a throw.
                    if (has lv.objectMap "__error__") {
                        if (cname == "Error") {
                            return (EvalValue.boolean(true))
                        }
                    }
                    ; D-ERRORS: an object built by `new F()` — an error object or
                    ; any constructor-function instance — carries `constructor`.
                    ; Compare it against the right-hand value BY IDENTITY, which
                    ; is what makes the standard guard
                    ;   if (!(this instanceof F)) return new F(...)
                    ; terminate instead of recursing forever.
                    def ctorHere:EvalValue (lv.getMember("constructor"))
                    if (ctorHere.valueType == 6) {
                        if node.right {
                            def rv:EvalValue (this.evaluateExpr((unwrap node.right)))
                            if (rv.valueType == 6) {
                                return (EvalValue.boolean((ctorHere.equals(rv))))
                            }
                        }
                        if ((strlen cname) > 0) {
                            return (EvalValue.boolean(((ctorHere.functionName) == cname)))
                        }
                    }
                }
            }
            return (EvalValue.boolean(false))
        }

        ; Evaluate both sides for other operators. Binary expressions always have
        ; both operands; evaluate them directly instead of seeding two throwaway
        ; null EvalValues (which used to be the single largest source of interpreter
        ; heap allocations).
        if (null? node.left) {
            return (EvalValue.null())
        }
        if (null? node.right) {
            return (EvalValue.null())
        }
        def left:EvalValue (this.evaluateExpr((unwrap node.left)))
        def right:EvalValue (this.evaluateExpr((unwrap node.right)))

        ; `key in obj` / `index in array` — property/element presence test.
        if (op == "in") {
            if (right.isObject()) {
                return (EvalValue.boolean((this.objHasKey(right (left.toString())))))
            }
            if (right.isArray()) {
                def idx:int (to_int (left.toNumber()))
                return (EvalValue.boolean(((idx >= 0) && (idx < (array_length right.arrayValue)))))
            }
            return (EvalValue.boolean(false))
        }
        
        ; Arithmetic
        if (op == "+") {
            ; D-TOPRIMITIVE: both operands convert FIRST, and only then does the
            ; string-vs-numeric decision get made -- an object with a valueOf
            ; returning a number must add, not concatenate.
            def lp:EvalValue (this.toPrimitive(left false))
            def rp:EvalValue (this.toPrimitive(right false))
            if ((lp.isString()) || (rp.isString())) {
                return (EvalValue.string((lp.toString()) + (rp.toString())))
            }
            return (EvalValue.number((this.toNumberOf(lp)) + (this.toNumberOf(rp))))
        }
        if (op == "-") {
            return (EvalValue.number((this.toNumberOf(left)) - (this.toNumberOf(right))))
        }
        if (op == "*") {
            return (EvalValue.number((this.toNumberOf(left)) * (this.toNumberOf(right))))
        }
        ; D-IEEE: division by zero is Infinity / -Infinity / NaN, not 0. The old
        ; guard returned 0, which is wrong arithmetic AND breaks the standard
        ; idiom for telling +0 from -0 (`1/a === 1/b`) — with both sides folding
        ; to 0 the two zeroes became indistinguishable.
        if (op == "/") {
            def rightNum:double (right.toNumber())
            def leftNum:double (left.toNumber())
            if (rightNum == 0.0) {
                ; `left * (1/right)` gets all three cases right at once, and
                ; crucially respects the SIGN of the zero divisor: 1/-0 is
                ; -Infinity, not Infinity. Branching on left's sign alone would
                ; miss that, because -0 == 0 compares true.
                def recip:double (1.0 / rightNum)
                return (EvalValue.number((leftNum * recip)))
            }
            return (EvalValue.number((leftNum / rightNum)))
        }
        if (op == "%") {
            ; The remainder is a FLOATING-POINT one: 5.5 % 2 is 1.5. Truncating
            ; both operands to int threw the fraction away, and the sign follows
            ; the dividend.
            def leftMod:double (this.toNumberOf(left))
            def rightMod:double (this.toNumberOf(right))
            if (rightMod == 0.0) {
                ; x % 0 is NaN, not 0.
                return (EvalValue.number((0.0 / 0.0)))
            }
            if (leftMod != leftMod) { return (EvalValue.number(leftMod)) }
            if (rightMod != rightMod) { return (EvalValue.number(rightMod)) }
            if (false == (this.isFiniteNum(leftMod))) {
                return (EvalValue.number((0.0 / 0.0)))
            }
            if (false == (this.isFiniteNum(rightMod))) {
                return (EvalValue.number(leftMod))
            }
            return (this.evaluateRemainder(leftMod rightMod))
        }

        ; Bitwise (JS coerces operands to int32; common idiom "x | 0" truncates to int)
        if (op == "|") {
            def leftInt:int (to_int (this.toNumberOf(left)))
            def rightInt:int (to_int (this.toNumberOf(right)))
            return (EvalValue.fromInt((bit_or leftInt rightInt)))
        }
        if (op == "&") {
            def leftInt:int (this.toInt32Of(left))
            def rightInt:int (this.toInt32Of(right))
            return (EvalValue.fromInt((bit_and leftInt rightInt)))
        }
        if (op == "^") {
            def leftInt:int (this.toInt32Of(left))
            def rightInt:int (this.toInt32Of(right))
            return (EvalValue.fromInt((bit_xor leftInt rightInt)))
        }
        ; Shifts (JS coerces to int32; shift count masked to low 5 bits). Common in
        ; AssemblyScript fixed-point / bit-packing code.
        if (op == "<<") {
            def leftInt:int (this.toInt32Of(left))
            def cnt:int (bit_and (this.toInt32Of(right)) 31)
            return (EvalValue.fromInt((bit_shl leftInt cnt)))
        }
        if (op == ">>") {
            def leftInt:int (this.toInt32Of(left))
            def cnt:int (bit_and (this.toInt32Of(right)) 31)
            return (EvalValue.fromInt((bit_shr leftInt cnt)))
        }
        if (op == ">>>") {
            def leftInt:int (this.toInt32Of(left))
            def cnt:int (bit_and (this.toInt32Of(right)) 31)
            return (EvalValue.fromInt((bit_ushr leftInt cnt)))
        }
        ; Exponentiation (a ** b). Integer-exponent fast path (covers game/AS use);
        ; falls back to repeated multiply for the truncated integer exponent.
        if (op == "**") {
            return (EvalValue.number((this.powNum((left.toNumber()) (this.toInt32Of(right))))))
        }

        ; Comparison
        ; D-TOPRIMITIVE: the relational operators compare STRINGS when both
        ; operands convert to strings, and numbers otherwise. Comparing
        ; "10" < "9" numerically is wrong; lexicographic is correct.
        if ((op == "<") || (op == ">") || (op == "<=") || (op == ">=")) {
            def lr:EvalValue (this.toPrimitive(left false))
            def rr:EvalValue (this.toPrimitive(right false))
            if ((lr.isString()) && (rr.isString())) {
                def ls:string lr.stringValue
                def rs:string rr.stringValue
                def cmp:int (this.compareStrings(ls rs))
                if (op == "<") { return (EvalValue.boolean((cmp < 0))) }
                if (op == ">") { return (EvalValue.boolean((cmp > 0))) }
                if (op == "<=") { return (EvalValue.boolean((cmp <= 0))) }
                return (EvalValue.boolean((cmp >= 0)))
            }
            def ln2:double (this.toNumberOf(lr))
            def rn2:double (this.toNumberOf(rr))
            ; Any NaN makes every relational comparison false.
            if (ln2 != ln2) { return (EvalValue.boolean(false)) }
            if (rn2 != rn2) { return (EvalValue.boolean(false)) }
            if (op == "<") { return (EvalValue.boolean((ln2 < rn2))) }
            if (op == ">") { return (EvalValue.boolean((ln2 > rn2))) }
            if (op == "<=") { return (EvalValue.boolean((ln2 <= rn2))) }
            return (EvalValue.boolean((ln2 >= rn2)))
        }
        
        ; Equality. `===`/`!==` are strict (EvalValue.equals — value for
        ; primitives, reference identity for objects). `==`/`!=` are loose: the
        ; ONLY JS coercion this engine models is `null == undefined` (both are
        ; nullish), which matters now that a missing member reads as `undefined`
        ; (D-IDENTITY rule 6) — the guest idiom `x != null` must still hold.
        if (op == "===") {
            return (EvalValue.boolean((left.equals(right))))
        }
        if (op == "!==") {
            return (EvalValue.boolean(((left.equals(right)) == false)))
        }
        if (op == "==") {
            return (EvalValue.boolean((this.looseEquals(left right))))
        }
        if (op == "!=") {
            return (EvalValue.boolean(((this.looseEquals(left right)) == false)))
        }
        
        return (EvalValue.null())
    }

    ; JS loose equality (`==`/`!=`) restricted to the one coercion this engine
    ; models: `null == undefined` (and each equals itself). A nullish value is
    ; never loosely equal to a non-nullish one; every other pair defers to strict
    ; EvalValue.equals (no numeric/string cross-type coercion). This keeps the
    ; universal guest idiom `x != null` meaning "neither null nor undefined" now
    ; that a missing member reads as undefined (D-IDENTITY rule 6).
    ; D-LOOSEEQ: abstract equality. Previously `==` was `===` plus a
    ; null/undefined special case, so `1 == '1'`, `true == 1` and
    ; `[1] == 1` were all false -- the comparisons `==` exists to make.
    fn looseEquals:boolean (left:EvalValue right:EvalValue) {
        def ln:boolean ((left.isNull()) || (left.isUndefined()))
        def rn:boolean ((right.isNull()) || (right.isUndefined()))
        ; null and undefined equal each other and nothing else.
        if (ln || rn) {
            return (ln && rn)
        }
        def lIsObj:boolean ((left.valueType == 5) || (left.isArray()))
        def rIsObj:boolean ((right.valueType == 5) || (right.isArray()))
        ; Two objects compare by reference, never by content.
        if (lIsObj && rIsObj) {
            return (left.equals(right))
        }
        ; One object: convert it to a primitive and retry.
        if lIsObj {
            def lp:EvalValue (this.toPrimitive(left false))
            return (this.looseEquals(lp right))
        }
        if rIsObj {
            def rp:EvalValue (this.toPrimitive(right false))
            return (this.looseEquals(left rp))
        }
        ; Same primitive type: strict comparison.
        if ((left.isString()) && (right.isString())) {
            return (left.equals(right))
        }
        if ((left.isNumber()) && (right.isNumber())) {
            return (left.equals(right))
        }
        if ((left.isBoolean()) && (right.isBoolean())) {
            return (left.equals(right))
        }
        ; Mixed primitives compare numerically, which is what makes
        ; 1 == '1' and true == 1 hold.
        def lnum:double (this.toNumberOf(left))
        def rnum:double (this.toNumberOf(right))
        if (lnum != lnum) { return false }
        if (rnum != rnum) { return false }
        return (lnum == rnum)
    }

    fn bindingExists:boolean (name:string) {
        return (context.has(name))
    }

    ; ==========================================================================
    ; D-ERRORS: spec error objects, and throwing where the spec throws.
    ; --------------------------------------------------------------------------
    ; A thrown error has to be catchable AND identifiable. Test262's assert.throws
    ; compares `thrown.constructor` against the global constructor BY IDENTITY and
    ; reads `.name` off it, so the constructors are seeded once per engine as
    ; singleton function values on hostScope and every error object points back at
    ; that same value. Creating a fresh constructor per throw would silently fail
    ; that identity check.
    ; --------------------------------------------------------------------------
    ; D-BUILTINPROTO: members of the engine's built-in constructor namespaces
    ; that are VALUES rather than calls. Returns null (valueType 0) when the
    ; name/property pair is not one of them, so the caller falls through.
    fn builtinNamespaceMember:EvalValue (nsName:string propName:string) {
        if (this.isBuiltinCtorName(nsName)) {
            if (propName == "prototype") {
                return (this.builtinPrototype(nsName))
            }
            if (propName == "name") {
                return (EvalValue.string(nsName))
            }
        }
        if (nsName == "Number") {
            if (propName == "POSITIVE_INFINITY") { return (EvalValue.number((1.0 / 0.0))) }
            if (propName == "NEGATIVE_INFINITY") { return (EvalValue.number((0.0 - (1.0 / 0.0)))) }
            if (propName == "MAX_SAFE_INTEGER") { return (EvalValue.number(9007199254740991.0)) }
            if (propName == "MIN_SAFE_INTEGER") { return (EvalValue.number((0.0 - 9007199254740991.0))) }
            if (propName == "EPSILON") { return (EvalValue.number(0.0000000000000002220446049250313)) }
            ; MAX_VALUE / MIN_VALUE come from string parsing rather than from a
            ; source literal: neither extreme survives the Ranger lexer, but the
            ; runtime's string-to-double conversion reproduces the exact bit
            ; pattern, which is what these tests actually check.
            if (propName == "MAX_VALUE") {
                def mx@(optional):double (to_double "1.7976931348623157e308")
                if mx {
                    return (EvalValue.number((unwrap mx)))
                }
            }
            if (propName == "MIN_VALUE") {
                def mn@(optional):double (to_double "5e-324")
                if mn {
                    return (EvalValue.number((unwrap mn)))
                }
            }
        }
        return (EvalValue.null())
    }

    ; D-INSTANCEOF: `v instanceof <BuiltinCtor>`. Answers 1 for yes, 0 for no,
    ; and -1 for "this constructor has nothing to say about that value", which
    ; leaves the caller's `__class__` / constructor-identity checks in charge.
    ;
    ; A primitive is never an instance of anything, which is why the wrapper
    ; constructors answer 0 for their own primitive: `'a' instanceof String` is
    ; false while `new String('a') instanceof String` is true.
    fn builtinInstanceOf:int (v:EvalValue cname:string) {
        if ((v.valueType == 0) || (v.isUndefined())) {
            return 0
        }
        def isObjectLike:boolean false
        if (v.valueType == 4) { isObjectLike = true }
        if (v.valueType == 5) { isObjectLike = true }
        if (v.valueType == 6) { isObjectLike = true }
        if (v.valueType == 9) { isObjectLike = true }
        if (v.valueType == 10) { isObjectLike = true }
        if (false == isObjectLike) {
            return 0
        }
        if (cname == "Object") {
            return 1
        }
        if (cname == "Function") {
            if (v.valueType == 6) { return 1 }
            return 0
        }
        if (cname == "Array") {
            if (v.valueType == 4) { return 1 }
            if ((this.protoChainKind(v)) == "array") { return 1 }
            return 0
        }
        if (cname == "Map") {
            if (v.valueType == 9) { return 1 }
            return 0
        }
        if (cname == "Set") {
            if (v.valueType == 10) { return 1 }
            return 0
        }
        if (this.isWrapperCtorName(cname)) {
            if (v.valueType == 5) {
                if (has v.objectMap "__wrapper__") {
                    return (this.boolAsInt(((this.objectClassOf(v)) == cname)))
                }
            }
            return 0
        }
        return (0 - 1)
    }

    fn boolAsInt:int (b:boolean) {
        if b { return 1 }
        return 0
    }

    fn isBuiltinCtorName:boolean (name:string) {
        if (name == "Object") { return true }
        if (name == "Array") { return true }
        if (name == "String") { return true }
        if (name == "Number") { return true }
        if (name == "Boolean") { return true }
        if (name == "Function") { return true }
        if (name == "Symbol") { return true }
        if (name == "Map") { return true }
        if (name == "Set") { return true }
        if (name == "Date") { return true }
        if (name == "RegExp") { return true }
        return (this.isErrorCtorName(name))
    }

    fn isErrorCtorName:boolean (name:string) {
        def names:[string] (this.errorKindNames())
        def i:int 0
        while (i < (array_length names)) {
            if ((itemAt names i) == name) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; The prototype object for a built-in constructor, created once per engine so
    ; a property assigned to it persists and compares equal across reads.
    ; D-GLOBALOBJ: one object per built-in global, created on first reference and
    ; kept for the engine's lifetime so identity holds and a property written to
    ; it persists. Constructor globals carry `prototype` and `name`; Math carries
    ; its constants. Returns null for a name that has no object form.
    ; D-STATICS: the static methods each built-in namespace publishes. The list
    ; is the authority on what exists as a VALUE; whether a given one can be
    ; INVOKED through that value is invokeBuiltinStatic's business, and the two
    ; are allowed to differ -- a name here that the invoker does not implement
    ; still has to be describable, because the suite asks about it either way.
    ; D-STATICS: run a static from already-evaluated argument VALUES. The
    ; call-site chains read AST children directly, so they cannot serve a
    ; captured static; this is the value-shaped door, and the two agree because
    ; they share the same helpers underneath.
    ;
    ; Math lives here outright rather than in the call-site chain: every one of
    ; its methods is a pure function of its arguments, and the old chain had
    ; floor and round wrong for negative numbers -- both truncated toward zero.
    fn invokeBuiltinStatic:EvalValue (nsName:string name:string args:[EvalValue]) {
        def n0:double 0.0
        if ((array_length args) > 0) {
            n0 = (this.toNumberOf((itemAt args 0)))
        }
        if (nsName == "Math") {
            if (name == "random") {
                return (EvalValue.number((random)))
            }
            if (name == "abs") {
                if (n0 < 0.0) { return (EvalValue.number((0.0 - n0))) }
                return (EvalValue.number(n0))
            }
            if (name == "floor") {
                return (EvalValue.number((this.floorNum(n0))))
            }
            if (name == "ceil") {
                return (EvalValue.number((0.0 - (this.floorNum((0.0 - n0))))))
            }
            if (name == "trunc") {
                if (n0 < 0.0) {
                    return (EvalValue.number((0.0 - (this.floorNum((0.0 - n0))))))
                }
                return (EvalValue.number((this.floorNum(n0))))
            }
            if (name == "round") {
                ; Math.round breaks ties UPWARD, so -1.5 rounds to -1 and not
                ; to -2. floor(x + 0.5) gets that right for both signs.
                return (EvalValue.number((this.floorNum((n0 + 0.5)))))
            }
            if (name == "sign") {
                if (n0 > 0.0) { return (EvalValue.number(1.0)) }
                if (n0 < 0.0) { return (EvalValue.number((0.0 - 1.0))) }
                return (EvalValue.number(n0))
            }
            if (name == "sqrt") { return (EvalValue.number((sqrt n0))) }
            if (name == "sin") { return (EvalValue.number((sin n0))) }
            if (name == "cos") { return (EvalValue.number((cos n0))) }
            if (name == "tan") { return (EvalValue.number((tan n0))) }
            if (name == "asin") { return (EvalValue.number((asin n0))) }
            if (name == "acos") { return (EvalValue.number((acos n0))) }
            if (name == "atan2") {
                def ay:double n0
                def ax:double 0.0
                if ((array_length args) > 1) {
                    ax = (this.toNumberOf((itemAt args 1)))
                }
                return (EvalValue.number((atan2 ay ax)))
            }
            if (name == "pow") {
                def pe:int 0
                if ((array_length args) > 1) {
                    pe = (to_int (this.toNumberOf((itemAt args 1))))
                }
                return (EvalValue.number((this.powNum(n0 pe))))
            }
            if (name == "hypot") {
                def acc:double 0.0
                def hi:int 0
                while (hi < (array_length args)) {
                    def hv:double (this.toNumberOf((itemAt args hi)))
                    acc = (acc + (hv * hv))
                    hi = (hi + 1)
                }
                return (EvalValue.number((sqrt acc)))
            }
            if ((name == "min") || (name == "max")) {
                def wantMax:boolean (name == "max")
                def inf:double (1.0 / 0.0)
                def best:double inf
                if wantMax { best = (0.0 - inf) }
                def mi:int 0
                while (mi < (array_length args)) {
                    def v:double (this.toNumberOf((itemAt args mi)))
                    ; NaN anywhere in the list wins outright.
                    if (v != v) {
                        return (EvalValue.number(v))
                    }
                    if wantMax {
                        if (v > best) { best = v }
                    } {
                        if (v < best) { best = v }
                    }
                    mi = (mi + 1)
                }
                return (EvalValue.number(best))
            }
        }
        if (nsName == "String") {
            if (name == "fromCharCode") {
                ; Each argument is ToUint16, not a truncated ToNumber: -5.4321
                ; is 65531, and an object argument runs its own valueOf. The old
                ; version read `.toNumber()` straight off the value, so every
                ; object argument became 0.
                def fcs:string ""
                def fci:int 0
                while (fci < (array_length args)) {
                    def code:int (this.toUint16Of((itemAt args fci)))
                    if scriptThrew {
                        return (EvalValue.undefined())
                    }
                    fcs = (fcs + (strfromcode code))
                    fci = (fci + 1)
                }
                return (EvalValue.string(fcs))
            }
        }
        if (nsName == "Array") {
            if (name == "isArray") {
                if ((array_length args) == 0) {
                    return (EvalValue.boolean(false))
                }
                return (EvalValue.boolean(((itemAt args 0).isArray())))
            }
        }
        if (nsName == "Number") {
            if (name == "isNaN") {
                if ((array_length args) == 0) { return (EvalValue.boolean(false)) }
                def nv:EvalValue (itemAt args 0)
                if (false == (nv.isNumber())) { return (EvalValue.boolean(false)) }
                def nn:double nv.numberValue
                return (EvalValue.boolean((nn != nn)))
            }
            if (name == "isFinite") {
                if ((array_length args) == 0) { return (EvalValue.boolean(false)) }
                def fv:EvalValue (itemAt args 0)
                if (false == (fv.isNumber())) { return (EvalValue.boolean(false)) }
                return (EvalValue.boolean((this.isFiniteNum(fv.numberValue))))
            }
            if (name == "isInteger") {
                if ((array_length args) == 0) { return (EvalValue.boolean(false)) }
                def iv:EvalValue (itemAt args 0)
                if (false == (iv.isNumber())) { return (EvalValue.boolean(false)) }
                def dn:double iv.numberValue
                if (false == (this.isFiniteNum(dn))) { return (EvalValue.boolean(false)) }
                return (EvalValue.boolean(((this.floorNum(dn)) == dn)))
            }
        }
        if (nsName == "Object") {
            def a0:EvalValue (EvalValue.undefined())
            if ((array_length args) > 0) {
                a0 = (itemAt args 0)
            }
            ; D-ARGCHECK: the same argument rules the call-site chain applies.
            ; They have to be repeated here rather than assumed, since this is a
            ; second door into the same statics.
            if (this.objectStaticCoerces(name)) {
                if ((a0.isNull()) || (a0.isUndefined())) {
                    return (this.throwSpecError("TypeError" ("Object." + name + " called on null or undefined")))
                }
            }
            if (this.objectStaticNeedsObject(name)) {
                if (a0.valueType != 5) {
                    def okKind:boolean false
                    if (a0.valueType == 4) { okKind = true }
                    if (a0.valueType == 6) { okKind = true }
                    if (a0.valueType == 9) { okKind = true }
                    if (a0.valueType == 10) { okKind = true }
                    if (false == okKind) {
                        return (this.throwSpecError("TypeError" ("Object." + name + " called on a non-object")))
                    }
                }
            }
            if (name == "keys") {
                def items:[EvalValue]
                def ks:[string] (this.objectEnumerableKeys(a0))
                def ki:int 0
                while (ki < (array_length ks)) {
                    def k:string (itemAt ks ki)
                    if (false == (this.isHiddenInstanceKey(k))) {
                        push items (EvalValue.string(k))
                    }
                    ki = (ki + 1)
                }
                return (EvalValue.array(items))
            }
            if (name == "getPrototypeOf") {
                if a0.protoRef {
                    return (unwrap a0.protoRef)
                }
                return (EvalValue.null())
            }
            if (name == "isExtensible") {
                return (EvalValue.boolean(a0.extensibleFlag))
            }
            if (name == "isFrozen") {
                return (EvalValue.boolean(a0.frozenFlag))
            }
            if (name == "isSealed") {
                return (EvalValue.boolean(a0.sealedFlag))
            }
            if (name == "defineProperty") {
                def dk:string ""
                def dd:EvalValue (EvalValue.undefined())
                if ((array_length args) > 1) { dk = (this.toPropertyKey((itemAt args 1))) }
                if ((array_length args) > 2) { dd = (itemAt args 2) }
                def dErr:string (this.definePropertyOn(a0 dk dd))
                if ((strlen dErr) > 0) {
                    return (this.throwSpecError("TypeError" dErr))
                }
                return a0
            }
        }
        ; Not invocable through a captured value yet. The name still EXISTS -- it
        ; is published on the namespace object and describable -- so this is a
        ; smaller gap than the value not being there at all, and it is called
        ; out rather than silently answering undefined.
        return (EvalValue.undefined())
    }

    ; The declared arity of each built-in constructor.
    ; The declared arity of each built-in static. Only the ones the suite reads
    ; are listed; anything else answers 1, which is the common case.
    fn builtinStaticArity:int (nsName:string name:string) {
        if (nsName == "Object") {
            if (name == "defineProperty") { return 3 }
            if (name == "defineProperties") { return 2 }
            if (name == "create") { return 2 }
            if (name == "getOwnPropertyDescriptor") { return 2 }
            if (name == "setPrototypeOf") { return 2 }
            if (name == "assign") { return 2 }
            return 1
        }
        if (nsName == "Math") {
            if (name == "random") { return 0 }
            if (name == "atan2") { return 2 }
            if (name == "pow") { return 2 }
            if (name == "hypot") { return 2 }
            if (name == "max") { return 2 }
            if (name == "min") { return 2 }
            return 1
        }
        if (nsName == "JSON") {
            if (name == "stringify") { return 3 }
            return 2
        }
        return 1
    }

    fn builtinCtorArity:int (nsName:string) {
        if (nsName == "Object") { return 1 }
        if (nsName == "Array") { return 1 }
        if (nsName == "String") { return 1 }
        if (nsName == "Number") { return 1 }
        if (nsName == "Boolean") { return 1 }
        if (nsName == "Function") { return 1 }
        if (nsName == "Date") { return 7 }
        if (nsName == "Map") { return 0 }
        if (nsName == "Set") { return 0 }
        return 0
    }

    fn builtinStaticNames:[string] (nsName:string) {
        def out:[string]
        if (nsName == "Object") {
            push out "assign"
            push out "create"
            push out "defineProperties"
            push out "defineProperty"
            push out "entries"
            push out "freeze"
            push out "getOwnPropertyDescriptor"
            push out "getOwnPropertyNames"
            push out "getPrototypeOf"
            push out "isExtensible"
            push out "isFrozen"
            push out "isSealed"
            push out "keys"
            push out "preventExtensions"
            push out "seal"
            push out "setPrototypeOf"
            push out "values"
            return out
        }
        if (nsName == "Math") {
            push out "abs"
            push out "acos"
            push out "asin"
            push out "atan2"
            push out "ceil"
            push out "cos"
            push out "floor"
            push out "hypot"
            push out "max"
            push out "min"
            push out "pow"
            push out "random"
            push out "round"
            push out "sign"
            push out "sin"
            push out "sqrt"
            push out "tan"
            push out "trunc"
            return out
        }
        if (nsName == "Array") {
            push out "isArray"
            return out
        }
        if (nsName == "String") {
            push out "fromCharCode"
            return out
        }
        if (nsName == "Number") {
            push out "isFinite"
            push out "isInteger"
            push out "isNaN"
            push out "parseFloat"
            push out "parseInt"
            return out
        }
        if (nsName == "JSON") {
            push out "parse"
            push out "stringify"
            return out
        }
        return out
    }

    ; D-STATICS: the subset of published statics that invokeBuiltinStatic can
    ; actually run from values. The rest are still implemented by the call-site
    ; chains, which read the AST -- they EXIST as values and are describable,
    ; they just cannot be captured and called yet. Keeping the two lists apart
    ; is what stops a direct `Object.create(...)` being intercepted and answered
    ; with undefined.
    ; D-REGISTRY: one value per (kind, name), for the engine's lifetime. A fresh
    ; value per read made `[].slice === Array.prototype.slice` false and
    ; `(new Number()).toString === Number.prototype.toString` with it -- the
    ; suite compares built-in methods by identity all over.
    fn sharedNativeMethod:EvalValue (kind:string name:string) {
        def key:string (kind + ("." + name))
        if (has nativeMethodCache key) {
            return (unwrap (get nativeMethodCache key))
        }
        def v:EvalValue (EvalValue.nativeMethod(kind name))
        ; A built-in reports its registered arity as `length`, like any other
        ; function. Stored on the value because there is no parameter list to
        ; count -- the registry IS the parameter list.
        def ar:int (this.builtinArity(kind name))
        if (ar < 0) { ar = 0 }
        v.setMember("length" (EvalValue.fromInt(ar)))
        v.setAttrs("length" false false true)
        v.setMember("name" (EvalValue.string(name)))
        v.setAttrs("name" false false true)
        set nativeMethodCache key v
        return v
    }

    fn hasInvocableStatic:boolean (nsName:string name:string) {
        if (nsName == "Math") {
            return (this.hasBuiltinStatic(nsName name))
        }
        if (nsName == "Array") {
            return (name == "isArray")
        }
        if (nsName == "String") {
            return (name == "fromCharCode")
        }
        if (nsName == "Number") {
            if (name == "isNaN") { return true }
            if (name == "isFinite") { return true }
            if (name == "isInteger") { return true }
            return false
        }
        if (nsName == "Object") {
            if (name == "keys") { return true }
            if (name == "getPrototypeOf") { return true }
            if (name == "isExtensible") { return true }
            if (name == "isFrozen") { return true }
            if (name == "isSealed") { return true }
            if (name == "defineProperty") { return true }
            return false
        }
        return false
    }

    fn hasBuiltinStatic:boolean (nsName:string name:string) {
        def names:[string] (this.builtinStaticNames(nsName))
        def i:int 0
        while (i < (array_length names)) {
            if ((itemAt names i) == name) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn builtinGlobalObject:EvalValue (nsName:string) {
        if (has builtinGlobals nsName) {
            return (unwrap (get builtinGlobals nsName))
        }
        def keysG:[string]
        def valsG:[EvalValue]
        def g:EvalValue (EvalValue.object(keysG valsG))
        ; D-GLOBALOBJ: a built-in CONSTRUCTOR is a function value, not a plain
        ; object. typeof already lied about it and said "function"; making it one
        ; is what lets `Number instanceof Function`,
        ; `Function.prototype.isPrototypeOf(Number)` and `Number.length` all
        ; answer for themselves instead of being special-cased at each site.
        if (this.isBuiltinCtorName(nsName)) {
            g = (EvalValue.nativeFunction(nsName))
        }
        set builtinGlobals nsName g
        g.setMember("name" (EvalValue.string(nsName)))
        g.setAttrs("name" false false true)
        ; Math and JSON brand as themselves, not as Object.
        if (nsName == "Math") { g.setMember("__nsbrand__" (EvalValue.string("Math"))) }
        if (nsName == "JSON") { g.setMember("__nsbrand__" (EvalValue.string("JSON"))) }
        if (this.isBuiltinCtorName(nsName)) {
            g.setMember("prototype" (this.builtinPrototype(nsName)))
            g.setAttrs("prototype" false false false)
            ; Every built-in constructor inherits from Function.prototype, and
            ; declares its own arity. Both are properties the suite reads.
            if (nsName != "Function") {
                g.protoRef = (this.builtinPrototype("Function"))
            }
            g.setMember("length" (EvalValue.fromInt((this.builtinCtorArity(nsName)))))
            g.setAttrs("length" false false true)
        }
        if (nsName == "Math") {
            def pi:double (M_PI)
            g.setMember("PI" (EvalValue.number(pi)))
            g.setAttrs("PI" false false false)
            def e1@(optional):double (to_double "2.718281828459045")
            if e1 {
                g.setMember("E" (EvalValue.number((unwrap e1))))
                g.setAttrs("E" false false false)
            }
            def ln2@(optional):double (to_double "0.6931471805599453")
            if ln2 {
                g.setMember("LN2" (EvalValue.number((unwrap ln2))))
                g.setAttrs("LN2" false false false)
            }
            def ln10@(optional):double (to_double "2.302585092994046")
            if ln10 {
                g.setMember("LN10" (EvalValue.number((unwrap ln10))))
                g.setAttrs("LN10" false false false)
            }
            def sq2@(optional):double (to_double "1.4142135623730951")
            if sq2 {
                g.setMember("SQRT2" (EvalValue.number((unwrap sq2))))
                g.setAttrs("SQRT2" false false false)
            }
        }
        ; D-STATICS: the namespace's own methods, as VALUES. They were resolved
        ; structurally at the call site and existed nowhere else, so
        ; `typeof Math.floor` was "undefined", `var f = Object.keys` captured
        ; nothing, and getOwnPropertyDescriptor could not see a single one of
        ; them. Stored on the namespace object, so repeated reads are the same
        ; value and `desc.value === Object.keys` holds.
        def statics:[string] (this.builtinStaticNames(nsName))
        def si:int 0
        while (si < (array_length statics)) {
            def sn:string (itemAt statics si)
            def stv:EvalValue (EvalValue.nativeStatic(nsName sn))
            stv.setMember("length" (EvalValue.fromInt((this.builtinStaticArity(nsName sn)))))
            stv.setAttrs("length" false false true)
            stv.setMember("name" (EvalValue.string(sn)))
            stv.setAttrs("name" false false true)
            g.setMember(sn stv)
            ; Writable and configurable but not enumerable, like every built-in.
            g.setAttrs(sn true false true)
            si = (si + 1)
        }
        if (nsName == "Number") {
            def mx@(optional):double (to_double "1.7976931348623157e308")
            if mx {
                g.setMember("MAX_VALUE" (EvalValue.number((unwrap mx))))
                g.setAttrs("MAX_VALUE" false false false)
            }
            def mn@(optional):double (to_double "5e-324")
            if mn {
                g.setMember("MIN_VALUE" (EvalValue.number((unwrap mn))))
                g.setAttrs("MIN_VALUE" false false false)
            }
            def inf:double (1.0 / 0.0)
            g.setMember("POSITIVE_INFINITY" (EvalValue.number(inf)))
            g.setAttrs("POSITIVE_INFINITY" false false false)
            g.setMember("NEGATIVE_INFINITY" (EvalValue.number((0.0 - inf))))
            g.setAttrs("NEGATIVE_INFINITY" false false false)
            g.setMember("NaN" (EvalValue.number((0.0 / 0.0))))
            g.setAttrs("NaN" false false false)
            g.setMember("MAX_SAFE_INTEGER" (EvalValue.number(9007199254740991.0)))
            g.setAttrs("MAX_SAFE_INTEGER" false false false)
            g.setMember("MIN_SAFE_INTEGER" (EvalValue.number((0.0 - 9007199254740991.0))))
            g.setAttrs("MIN_SAFE_INTEGER" false false false)
        }
        return g
    }

    ; The receiver kind a built-in constructor's prototype serves.
    ; Inverse of kindForCtorName: the constructor whose prototype serves a kind.
    fn ctorNameForKind:string (kind:string) {
        if (kind == "array") { return "Array" }
        if (kind == "string") { return "String" }
        if (kind == "number") { return "Number" }
        if (kind == "boolean") { return "Boolean" }
        if (kind == "function") { return "Function" }
        if (kind == "map") { return "Map" }
        if (kind == "set") { return "Set" }
        return ""
    }

    fn kindForCtorName:string (nsName:string) {
        if (nsName == "Array") { return "array" }
        if (nsName == "String") { return "string" }
        if (nsName == "Number") { return "number" }
        ; Boolean was missing, so Boolean.prototype published no methods at all
        ; and every read of one fell through to Object.prototype.
        if (nsName == "Boolean") { return "boolean" }
        if (nsName == "Function") { return "function" }
        if (nsName == "Map") { return "map" }
        if (nsName == "Set") { return "set" }
        if (nsName == "Object") { return "object" }
        return ""
    }

    ; Every registered method name for a kind. Kept beside builtinArity, which
    ; remains the authority on whether a name exists: builtinPrototype asserts
    ; each name here is registered, so the two cannot silently drift apart.
    fn builtinNames:[string] (kind:string) {
        def out:[string]
        if (kind == "function") {
            push out "call"
            push out "apply"
            push out "bind"
        }
        if (kind == "string") {
            push out "at"
            push out "charAt"
            push out "charCodeAt"
            push out "codePointAt"
            push out "concat"
            push out "endsWith"
            push out "includes"
            push out "indexOf"
            push out "lastIndexOf"
            push out "localeCompare"
            push out "normalize"
            push out "padEnd"
            push out "padStart"
            push out "repeat"
            push out "replace"
            push out "replaceAll"
            push out "search"
            push out "slice"
            push out "split"
            push out "startsWith"
            push out "substr"
            push out "substring"
            push out "toLocaleLowerCase"
            push out "toLocaleString"
            push out "toLocaleUpperCase"
            push out "toLowerCase"
            push out "toUpperCase"
            push out "trim"
            push out "trimEnd"
            push out "trimStart"
        }
        if (kind == "array") {
            push out "at"
            push out "concat"
            push out "every"
            push out "fill"
            push out "filter"
            push out "find"
            push out "findIndex"
            push out "flat"
            push out "forEach"
            push out "includes"
            push out "indexOf"
            push out "join"
            push out "lastIndexOf"
            push out "map"
            push out "pop"
            push out "push"
            push out "reduce"
            push out "reduceRight"
            push out "reverse"
            push out "shift"
            push out "slice"
            push out "some"
            push out "sort"
            push out "splice"
            push out "unshift"
        }
        if (kind == "number") {
            push out "toExponential"
            push out "toFixed"
            push out "toLocaleString"
            push out "toPrecision"
        }
        if (kind == "map") {
            push out "clear"
            push out "delete"
            push out "entries"
            push out "forEach"
            push out "get"
            push out "has"
            push out "keys"
            push out "set"
            push out "values"
        }
        if (kind == "set") {
            push out "add"
            push out "clear"
            push out "delete"
            push out "forEach"
            push out "has"
            push out "keys"
            push out "values"
        }
        push out "toString"
        push out "valueOf"
        return out
    }

    ; The prototype object for a built-in constructor, created once per engine so
    ; a property assigned to it persists and compares equal across reads. It is
    ; POPULATED from the registry, which is what makes `Array.prototype.slice` a
    ; real value reachable without an instance — the whole point of the refactor.
    fn builtinPrototype:EvalValue (nsName:string) {
        if (has builtinProtos nsName) {
            return (unwrap (get builtinProtos nsName))
        }
        def keysB:[string]
        def valsB:[EvalValue]
        def p:EvalValue (EvalValue.object(keysB valsB))
        ; Function.prototype is itself a function -- `typeof Function.prototype`
        ; is "function" and calling it returns undefined. Every other built-in
        ; prototype is an ordinary object.
        if (nsName == "Function") {
            p = (EvalValue.nativeFunction(""))
        }
        set builtinProtos nsName p
        ; D-PROTOCTOR: every built-in prototype inherits from Object.prototype,
        ; which is what makes `delete Number.prototype.toString` fall back to
        ; the branding one and `Object.prototype.isPrototypeOf(Number.prototype)`
        ; true. Object.prototype itself terminates the chain.
        if (nsName != "Object") {
            p.protoRef = (this.builtinPrototype("Object"))
        }
        ; D-PROTOCTOR: every prototype carries `constructor` back to its global.
        ; Safe against the cycle (global sets prototype, prototype sets
        ; constructor) because both cache their object BEFORE populating it.
        def ctorG:EvalValue (this.builtinGlobalObject(nsName))
        if (ctorG.valueType != 0) {
            p.setMember("constructor" ctorG)
            ; Non-enumerable, like every other property of a built-in prototype.
            p.setAttrs("constructor" true false true)
        }
        ; D-CLASSOF: Number.prototype, String.prototype and Boolean.prototype are
        ; themselves boxed primitives holding +0, "" and false. That is not a
        ; curiosity -- it is what makes `Number.prototype.toString()` answer "0"
        ; instead of "[object Object]", and the toString/toFixed areas are
        ; written to check exactly that.
        if (nsName == "Number") {
            p.setMember("__primitive__" (EvalValue.number(0.0)))
            p.setMember("__wrapper__" (EvalValue.string("Number")))
        }
        if (nsName == "String") {
            p.setMember("__primitive__" (EvalValue.string("")))
            p.setMember("__wrapper__" (EvalValue.string("String")))
            ; String.prototype.length is 0 per spec, but publishing it here makes
            ; the prototype win `'abc'.length` -- the property lookup consults the
            ; prototype before the primitive's own length. Left off deliberately:
            ; one obscure assertion is not worth breaking every string length.
        }
        if (nsName == "Boolean") {
            p.setMember("__primitive__" (EvalValue.boolean(false)))
            p.setMember("__wrapper__" (EvalValue.string("Boolean")))
        }
        def kind:string (this.kindForCtorName(nsName))
        if ((strlen kind) > 0) {
            ; D-PROTOKIND: the prototype remembers which receiver kind it serves,
            ; so an object that merely INHERITS from it can still reach the
            ; registry. `F.prototype = new Array(1,2,3); new F().filter(cb)` has
            ; to find Array.prototype.filter, and the instance's own kind is
            ; "object".
            p.setMember("__protokind__" (EvalValue.string(kind)))
            def names:[string] (this.builtinNames(kind))
            def i:int 0
            while (i < (array_length names)) {
                def nm:string (itemAt names i)
                ; Registry is the authority: a name listed here that is not
                ; registered would hand out a value that does nothing when
                ; called, so it is skipped rather than published.
                if (this.hasBuiltin(kind nm)) {
                    p.setMember(nm (this.sharedNativeMethod(kind nm)))
                    ; D-ATTRS: every built-in method is writable and
                    ; configurable but NOT enumerable, so `for (var k in
                    ; String.prototype)` yields nothing and Object.keys of a
                    ; prototype is empty. Publishing them enumerable made every
                    ; prototype look like a bag of own data.
                    p.setAttrs(nm true false true)
                }
                i = (i + 1)
            }
        }
        return p
    }

    ; ==========================================================================
    ; D-REGISTRY: built-in methods, dispatched by RECEIVER KIND then name.
    ; --------------------------------------------------------------------------
    ; The old dispatch was a single 1800-line if-chain keyed on the method NAME
    ; with only a handful of receiver-type guards, so `toString` on an array, an
    ; object and a number all reached the same branch and a correct type-specific
    ; implementation added later was unreachable — shadowed by position. Worse,
    ; a built-in was never a VALUE: `Array.prototype.slice` did not exist, so
    ; `slice.call(arguments)` could not work at all.
    ;
    ; The registry fixes both. `builtinArity` answers whether (kind, name) is a
    ; built-in — the single source of truth for what exists — and `invokeBuiltin`
    ; runs it. Because a method is identified by a (kind, name) PAIR rather than
    ; a function pointer (which Ranger does not have), the same pair can be
    ; handed out as a first-class value via EvalValue.nativeMethod.
    ;
    ; Framework surface is deliberately NOT in here: the native bridge,
    ; registerGlobal host injections, EVG/JSX helpers and AssemblyScript sized
    ; casts are the embedding rather than ECMAScript, and they keep priority by
    ; being routed before the registry.
    ; --------------------------------------------------------------------------
    ; D-PROTOKIND: the receiver kind an object INHERITS, by walking its prototype
    ; chain until something that is not a plain object turns up (an array
    ; prototype, say) or until a built-in prototype identifies itself. Returns ""
    ; when the chain says nothing, which leaves the caller's own dispatch alone.
    fn protoChainKind:string (v:EvalValue) {
        if (v.valueType != 5) {
            return ""
        }
        def cur:EvalValue v
        def depth:int 0
        while (depth < 16) {
            if (null? cur.protoRef) {
                return ""
            }
            def nxt:EvalValue (unwrap cur.protoRef)
            if (nxt.valueType != 5) {
                return (this.receiverKind(nxt))
            }
            if (has nxt.objectMap "__protokind__") {
                return ((unwrap (get nxt.objectMap "__protokind__")).toString())
            }
            cur = nxt
            depth = (depth + 1)
        }
        return ""
    }

    fn receiverKind:string (v:EvalValue) {
        ; D-WRAPPER: a boxed primitive dispatches as its primitive kind, which
        ; is what makes `new String('a').toUpperCase()` reach String.prototype.
        if (v.valueType == 5) {
            if (has v.objectMap "__primitive__") {
                def inner:EvalValue (unwrap (get v.objectMap "__primitive__"))
                if (inner.valueType == 2) { return "string" }
                if (inner.valueType == 1) { return "number" }
                if (inner.valueType == 3) { return "boolean" }
            }
        }
        if (v.valueType == 2) { return "string" }
        if (v.valueType == 4) { return "array" }
        if (v.valueType == 1) { return "number" }
        if (v.valueType == 3) { return "boolean" }
        if (v.valueType == 6) { return "function" }
        if (v.valueType == 9) { return "map" }
        if (v.valueType == 10) { return "set" }
        if (v.valueType == 5) { return "object" }
        return ""
    }

    ; Arity of a registered built-in, or -1 when (kind, name) is not one. Doubles
    ; as the existence check, so "is this a built-in" and "how many arguments"
    ; can never disagree.
    fn builtinArity:int (kind:string name:string) {
        if (kind == "function") {
            if (name == "call") { return 1 }
            if (name == "apply") { return 2 }
            if (name == "bind") { return 1 }
        }
        ; toString exists on every kind, but with a DIFFERENT implementation per
        ; kind. That is the whole point of keying on the receiver: the old single
        ; branch answered "[1, 2]" for an array and "{}" for an object, both of
        ; which are the engine's debug format rather than the language's.
        if (name == "toString") { return 0 }
        if (name == "valueOf") { return 0 }
        ; String methods belong to strings ONLY. Registering them per-kind is
        ; what makes `[1,2].charAt(0)` a TypeError instead of returning "[" —
        ; the old unguarded branch stringified the array and indexed its debug
        ; format.
        if (kind == "string") {
            if (name == "at") { return 1 }
            if (name == "charCodeAt") { return 1 }
            if (name == "codePointAt") { return 1 }
            if (name == "concat") { return 1 }
            if (name == "localeCompare") { return 1 }
            if (name == "normalize") { return 0 }
            if (name == "search") { return 1 }
            if (name == "substr") { return 2 }
            if (name == "toLocaleLowerCase") { return 0 }
            if (name == "toLocaleString") { return 0 }
            if (name == "toLocaleUpperCase") { return 0 }
            if (name == "endsWith") { return 1 }
            if (name == "includes") { return 1 }
            if (name == "indexOf") { return 1 }
            if (name == "lastIndexOf") { return 1 }
            if (name == "repeat") { return 1 }
            if (name == "replace") { return 2 }
            if (name == "replaceAll") { return 2 }
            if (name == "slice") { return 2 }
            if (name == "split") { return 2 }
            if (name == "startsWith") { return 1 }
            if (name == "trimEnd") { return 0 }
            if (name == "trimStart") { return 0 }
            if (name == "charAt") { return 1 }
            if (name == "toUpperCase") { return 0 }
            if (name == "toLowerCase") { return 0 }
            if (name == "trim") { return 0 }
            if (name == "substring") { return 2 }
            if (name == "padStart") { return 2 }
            if (name == "padEnd") { return 2 }
        }
        if (kind == "map") {
            if (name == "clear") { return 0 }
            if (name == "delete") { return 1 }
            if (name == "entries") { return 0 }
            if (name == "forEach") { return 1 }
            if (name == "get") { return 1 }
            if (name == "has") { return 1 }
            if (name == "keys") { return 0 }
            if (name == "set") { return 2 }
            if (name == "values") { return 0 }
        }
        if (kind == "set") {
            if (name == "add") { return 1 }
            if (name == "clear") { return 0 }
            if (name == "delete") { return 1 }
            if (name == "forEach") { return 1 }
            if (name == "has") { return 1 }
            if (name == "keys") { return 0 }
            if (name == "values") { return 0 }
        }
        if (kind == "array") {
            if (name == "at") { return 1 }
            if (name == "concat") { return 1 }
            if (name == "every") { return 1 }
            if (name == "fill") { return 1 }
            if (name == "filter") { return 1 }
            if (name == "find") { return 1 }
            if (name == "findIndex") { return 1 }
            if (name == "flat") { return 0 }
            if (name == "forEach") { return 1 }
            if (name == "includes") { return 1 }
            if (name == "indexOf") { return 1 }
            if (name == "join") { return 1 }
            if (name == "lastIndexOf") { return 1 }
            if (name == "map") { return 1 }
            if (name == "pop") { return 0 }
            if (name == "push") { return 1 }
            if (name == "reduce") { return 1 }
            if (name == "reduceRight") { return 1 }
            if (name == "reverse") { return 0 }
            if (name == "shift") { return 0 }
            if (name == "slice") { return 2 }
            if (name == "some") { return 1 }
            if (name == "sort") { return 1 }
            if (name == "splice") { return 2 }
            if (name == "unshift") { return 1 }
        }
        if (kind == "number") {
            if (name == "toExponential") { return 1 }
            if (name == "toFixed") { return 1 }
            if (name == "toLocaleString") { return 0 }
            if (name == "toPrecision") { return 1 }
        }
        return (0 - 1)
    }

    ; Number.prototype.toFixed formatting, lifted verbatim from the old chain
    ; branch so the migration cannot change its behaviour.
    ; D-RADIX: integer part in an arbitrary base, plus a bounded fractional
    ; expansion. Digits above 9 are lowercase letters, as the spec requires.
    fn numberToRadix:string (value:double radix:int) {
        if (value != value) {
            return "NaN"
        }
        def inf:double (1.0 / 0.0)
        if (value == inf) {
            return "Infinity"
        }
        if (value == (0.0 - inf)) {
            return "-Infinity"
        }
        def neg:boolean false
        def v:double value
        if (v < 0.0) {
            neg = true
            v = (0.0 - v)
        }
        def digits:string "0123456789abcdefghijklmnopqrstuvwxyz"
        def ip:int (to_int v)
        def out:string ""
        if (ip == 0) {
            out = "0"
        }
        while (ip > 0) {
            def d:int (ip % radix)
            def dEnd:int (d + 1)
            out = ((substring digits d dEnd) + out)
            ip = (to_int ((to_double ip) / (to_double radix)))
        }
        ; Fractional part, capped — an exact expansion can be unbounded in a
        ; base that does not divide the value evenly.
        def frac:double (v - (to_double (to_int v)))
        if (frac > 0.0) {
            out = (out + ".")
            def guard:int 0
            while ((frac > 0.0) && (guard < 20)) {
                frac = (frac * (to_double radix))
                def fd:int (to_int frac)
                def fEnd:int (fd + 1)
                out = (out + (substring digits fd fEnd))
                frac = (frac - (to_double fd))
                guard = (guard + 1)
            }
        }
        if neg {
            return ("-" + out)
        }
        return out
    }

    ; D-NUMFMT: Number.prototype.toFixed. The old version rounded with
    ; `to_int(x + 0.5)`, which truncates toward zero, so every negative number
    ; rounded the wrong way -- (-1.25).toFixed(1) answered "-1.2" instead of
    ; "-1.3" -- and it stringified NaN as "NaN.00". Sign is split off first and
    ; the magnitude formatted, which makes both signs behave the same.
    fn toFixedString:string (numVal:double decimals:int) {

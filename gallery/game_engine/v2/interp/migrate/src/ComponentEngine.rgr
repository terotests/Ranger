            if (opK == 50) {
                return (EvalValue.fromInt((bit_not (this.toInt32Of(arg)))))
            }
            ; void x evaluates the operand for side effects and yields undefined.
            if (opK == 48) {
                return (EvalValue.undefined())
            }
        }

        return (EvalValue.null())
    }

    fn evaluateConditionalExpr:EvalValue (node:TSNode) {
        if node.test {
            def testExpr:TSNode (unwrap node.test)
            def test:EvalValue (this.evaluateExpr(testExpr))
            
            if (test.toBool()) {
                if node.consequent {
                    def conseqNode:TSNode (unwrap node.consequent)
                    return (this.evaluateExpr(conseqNode))
                }
            } {
                if node.alternate {
                    def altNode:TSNode (unwrap node.alternate)
                    return (this.evaluateExpr(altNode))
                }
            }
        }
        
        return (EvalValue.null())
    }
    
    ; ---- user classes: instances, methods, `this`-bound dispatch ----------
    ; The __class__ name stamped on an instance object, or "" for non-instances.
    fn instanceClassName:string (obj:EvalValue) {
        if (obj.valueType != 5) { return "" }
        def cv@(optional):EvalValue (get obj.objectMap "__class__")
        if cv {
            def c:EvalValue (unwrap cv)
            if (c.valueType == 2) {
                return c.stringValue
            }
        }
        return ""
    }

    ; The virtual module an instance's class was declared in ("" = entry-realm
    ; class). Stamped by evaluateNewExpr for module-owned classes.
    fn instanceModuleTag:string (obj:EvalValue) {
        if (obj.valueType != 5) { return "" }
        def mv@(optional):EvalValue (get obj.objectMap "__module__")
        if mv {
            def m:EvalValue (unwrap mv)
            if (m.valueType == 2) {
                return m.stringValue
            }
        }
        return ""
    }

    ; Resolve the class declaration an instance was constructed from: a module
    ; tag routes to that module's class table, otherwise the engine-wide map
    ; (entry-realm classes). Empty node when unknown.
    fn classNodeForInstance:TSNode (obj:EvalValue) {
        def empty:TSNode (new TSNode())
        def clsName:string (this.instanceClassName(obj))
        if ((strlen clsName) == 0) {
            return empty
        }
        def tag:string (this.instanceModuleTag(obj))
        if ((strlen tag) > 0) {
            return (this.moduleClassNode(tag clsName))
        }
        def cn@(optional):TSNode (get classes clsName)
        if (null? cn) {
            return empty
        }
        return (unwrap cn)
    }

    ; D-CLASSSTATIC: a `static m() {}` member, which the parser tags kind="static".
    ; Kept separate from findMethodOnClassNode so a static and an instance method
    ; of the same name never resolve to each other.
    ; D-CLASSEXPR: give a class expression a table key and hand back a value that
    ; refers to it. A named class expression keeps its own name so recursive
    ; self-reference inside the body still resolves.
    ; D-CLASSEXTENDS: the superclass name of a class declaration. The parser puts
    ; `extends X` on `left` as a TSExpressionWithTypeArguments, so it is read from
    ; there rather than from a dedicated field.
    fn superClassNameOf:string (cls:TSNode) {
        if (null? cls.left) { return "" }
        def sup:TSNode (unwrap cls.left)
        if ((strlen sup.name) > 0) {
            return sup.name
        }
        if sup.left {
            def inner:TSNode (unwrap sup.left)
            return inner.name
        }
        return ""
    }

    ; Run the base-class constructor against an instance under construction.
    ; Walks the chain so a three-deep hierarchy initialises every level.
    fn runSuperConstructor:void (cls:TSNode inst:EvalValue argNodes:[TSNode] depth:int) {
        if (depth > 16) {
            return
        }
        def supName:string (this.superClassNameOf(cls))
        if ((strlen supName) == 0) {
            return
        }
        def supCls:TSNode (this.classNodeByName(supName))
        if ((this.nodeKindOf(supCls)) != 25) {
            return
        }
        ; Base field initialisers first, then its constructor — the same order
        ; `new` uses, so a field the base constructor overwrites ends up correct.
        if supCls.body {
            def sBody:TSNode (unwrap supCls.body)
            def savedCtxS:EvalContext context
            context = (context.createChild())
            context.define("this" inst)
            def bi:int 0
            while (bi < (array_length sBody.children)) {
                def bm:TSNode (itemAt sBody.children bi)
                if (bm.nodeType == "PropertyDefinition") {
                    if bm.init {
                        def bv:EvalValue (this.evaluateExpr((unwrap bm.init)))
                        inst.setMember(bm.name bv)
                    }
                }
                bi = (bi + 1)
            }
            context = savedCtxS
        }
        def sCtor:TSNode (this.findConstructorOnClassNode(supCls))
        if (sCtor.nodeType == "MethodDefinition") {
            def _sr:EvalValue (this.callUserFunctionNode(sCtor argNodes inst true))
        } {
            ; No explicit constructor: an implicit one just forwards upward.
            def nd:int (depth + 1)
            this.runSuperConstructor(supCls inst argNodes nd)
        }
    }

    fn registerClassExpression:EvalValue (node:TSNode) {
        def nm:string node.name
        if ((strlen nm) == 0) {
            classExprSeq = (classExprSeq + 1)
            nm = ("__classexpr" + (to_string classExprSeq))
        }
        def decl:TSNode node
        decl.nodeType = "ClassDeclaration"
        ; the node's KIND is memoised on first visit — rewriting nodeType
        ; must reset the memo or every later kind check sees the stale
        ; ClassExpression (the one runtime nodeType rewrite in the engine)
        decl.evalKind = 0
        decl.name = nm
        set classes nm decl
        def cv:EvalValue (EvalValue.nativeFunction(nm))
        cv.setMember("__classname__" (EvalValue.string(nm)))
        cv.setMember("name" (EvalValue.string(node.name)))
        return cv
    }

    fn findStaticMethodOnClassNode:TSNode (cls:TSNode methodName:string) {
        def empty:TSNode (new TSNode())
        if (null? cls.body) { return empty }
        def body:TSNode (unwrap cls.body)
        def i 0
        while (i < (array_length body.children)) {
            def m:TSNode (itemAt body.children i)
            if (m.nodeType == "MethodDefinition") {
                if (m.kind == "static") {
                    if (m.name == methodName) {
                        return m
                    }
                }
            }
            i = (i + 1)
        }
        return empty
    }

    ; Resolve a class by name in the module-aware order `new` uses.
    fn classNodeByName:TSNode (name:string) {
        def empty:TSNode (new TSNode())
        if ((strlen name) == 0) { return empty }
        if ((strlen currentModule) > 0) {
            def mc:TSNode (this.moduleClassNode(currentModule name))
            if ((this.nodeKindOf(mc)) == 25) {
                return mc
            }
        }
        def cn@(optional):TSNode (get classes name)
        if cn {
            return (unwrap cn)
        }
        return empty
    }

    ; D-CLASSEXTENDS: resolve an instance method, walking the `extends` chain so
    ; an inherited method is found. Own members win, then each ancestor in turn;
    ; depth-bounded so a cycle in the table cannot hang the host.
    fn findMethodOnClassNode:TSNode (cls:TSNode methodName:string) {
        def empty:TSNode (new TSNode())
        def cur:TSNode cls
        def depth:int 0
        while (depth < 16) {
            if (null? cur.body) {
                return empty
            }
            def body:TSNode (unwrap cur.body)
            def i 0
            while (i < (array_length body.children)) {
                def m:TSNode (itemAt body.children i)
                if (m.nodeType == "MethodDefinition") {
                    if (m.name == methodName) {
                        return m
                    }
                }
                i = (i + 1)
            }
            def supName:string (this.superClassNameOf(cur))
            if ((strlen supName) == 0) {
                return empty
            }
            def supCls:TSNode (this.classNodeByName(supName))
            if ((this.nodeKindOf(supCls)) != 25) {
                return empty
            }
            cur = supCls
            depth = (depth + 1)
        }
        return empty
    }

    fn findConstructorOnClassNode:TSNode (cls:TSNode) {
        def empty:TSNode (new TSNode())
        if (null? cls.body) { return empty }
        def body:TSNode (unwrap cls.body)
        def i 0
        while (i < (array_length body.children)) {
            def m:TSNode (itemAt body.children i)
            if (m.nodeType == "MethodDefinition") {
                if (m.kind == "constructor") {
                    return m
                }
            }
            i = (i + 1)
        }
        return empty
    }

    ; The MethodDefinition node named `methodName` on class `clsName`, or an empty
    ; node (nodeType "") when there is none.
    fn findMethodInClass:TSNode (clsName:string methodName:string) {
        def empty:TSNode (new TSNode())
        def cn@(optional):TSNode (get classes clsName)
        if (null? cn) { return empty }
        def cls:TSNode (unwrap cn)
        if (null? cls.body) { return empty }
        def body:TSNode (unwrap cls.body)
        def i 0
        while (i < (array_length body.children)) {
            def m:TSNode (itemAt body.children i)
            if (m.nodeType == "MethodDefinition") {
                if (m.name == methodName) {
                    return m
                }
            }
            i = (i + 1)
        }
        return empty
    }

    fn findConstructor:TSNode (clsName:string) {
        def empty:TSNode (new TSNode())
        def cn@(optional):TSNode (get classes clsName)
        if (null? cn) { return empty }
        def cls:TSNode (unwrap cn)
        if (null? cls.body) { return empty }
        def body:TSNode (unwrap cls.body)
        def i 0
        while (i < (array_length body.children)) {
            def m:TSNode (itemAt body.children i)
            if (m.nodeType == "MethodDefinition") {
                if (m.kind == "constructor") {
                    return m
                }
            }
            i = (i + 1)
        }
        return empty
    }

    ; Invoke a function/method node: new child scope, optional `this`, bind the
    ; argument expressions to params (evaluated in the caller's scope), run the
    ; body, restore. Shared by method calls, bound-method values, constructors.
    ; D-ERRORS: `new F(args)` for an ordinary function F. Creates the instance,
    ; stamps `constructor` so it can be compared against F by reference, runs the
    ; body with `this` bound to it, and returns the object — unless the body
    ; explicitly returned an object, which per spec wins.
    fn constructFromFunction:EvalValue (fnV:EvalValue className:string argNodes:[TSNode]) {
        ; D-CTORVALUE: bind curries [[Construct]] as well as [[Call]], so
        ; `new (Function.prototype.bind.apply(Date, [null, 1957, 4, 27]))()`
        ; must build a DATE. A bound built-in has no function node, so the
        ; ordinary path below could not run it at all and answered a bare
        ; object -- Object.prototype.toString then branded it "[object
        ; Undefined]".
        def hasCtorNode:boolean false
        if fnV.functionNode {
            hasCtorNode = true
        }
        if (false == hasCtorNode) {
            def bctor:string (this.builtinCtorNameOf(fnV))
            if ((strlen bctor) > 0) {
                def bvals:[EvalValue]
                def bbi:int 0
                while (bbi < (array_length fnV.boundArgs)) {
                    push bvals (itemAt fnV.boundArgs bbi)
                    bbi = (bbi + 1)
                }
                def bai:int 0
                while (bai < (array_length argNodes)) {
                    push bvals (this.evaluateExpr((itemAt argNodes bai)))
                    if scriptThrew {
                        return (EvalValue.undefined())
                    }
                    bai = (bai + 1)
                }
                return (this.callBuiltinCtorValues(bctor bvals true))
            }
        }
        def keys0:[string]
        def vals0:[EvalValue]
        def inst:EvalValue (EvalValue.object(keys0 vals0))
        ; D-PROTO: link the instance to the constructor's prototype object, so
        ; methods put on `F.prototype` are reachable through the instance.
        ; `constructor` is INHERITED from that prototype rather than stamped on
        ; the instance -- stamping it made every instance own a property it
        ; should not, which getOwnPropertyNames and isFrozen both notice.
        def instProto:EvalValue (fnV.getMember("prototype"))
        ; D-FNPROTO: a BOUND function has no `prototype` of its own, so reading
        ; one off it answers undefined -- but `new bound()` links the instance
        ; to the TARGET's prototype, which the bound copy still shares through
        ; its property map. Without this the instance had no prototype at all
        ; and inherited nothing, not even from Object.prototype.
        if fnV.boundExplicit {
            if (has fnV.objectMap "prototype") {
                instProto = (unwrap (get fnV.objectMap "prototype"))
            } {
                def keysBP:[string]
                def valsBP:[EvalValue]
                instProto = (EvalValue.object(keysBP valsBP))
                set fnV.objectMap "prototype" instProto
            }
        }
        inst.protoRef = instProto
        if (instProto.valueType == 5) {
            ; D-PROTO: `F.prototype` is minted by the value layer, which cannot
            ; reach the realm's Object.prototype, so the chain ended one link
            ; short -- `Object.prototype.p = 1; (new F()).p` read undefined.
            ; Closing it here is the first moment the realm is in scope.
            if (null? instProto.protoRef) {
                instProto.protoRef = (this.builtinPrototype("Object"))
            }
            if (false == (has instProto.objectMap "constructor")) {
                instProto.setMember("constructor" fnV)
                instProto.setAttrs("constructor" true false true)
            }
        }
        def fnNode:TSNode (unwrap fnV.functionNode)
        ; D-FNPROTO: constructing through a BOUND function runs the target with
        ; the fixed arguments in front -- `new (f.bind(null, "a"))("b")` calls
        ; f("a", "b"). The bound `this` is ignored, as the spec says, because
        ; construction supplies its own.
        if ((array_length fnV.boundArgs) > 0) {
            def ctorVals:[EvalValue]
            def bi:int 0
            while (bi < (array_length fnV.boundArgs)) {
                push ctorVals (itemAt fnV.boundArgs bi)
                bi = (bi + 1)
            }
            def ci:int 0
            while (ci < (array_length argNodes)) {
                push ctorVals (this.evaluateExpr((itemAt argNodes ci)))
                if scriptThrew {
                    return (EvalValue.undefined())
                }
                ci = (ci + 1)
            }
            def boundRet:EvalValue (this.callUserFunctionValues(fnNode ctorVals inst))
            if (this.isDescriptorObject(boundRet)) {
                return boundRet
            }
            return inst
        }
        def ret:EvalValue (this.callUserFunctionNode(fnNode argNodes inst true))
        ; A constructor that RETURNS an object yields that object, and a
        ; function, array, Map or Set is an object too -- only a primitive (or
        ; nothing) leaves the fresh instance standing. Testing for valueType 5
        ; alone threw away a returned function, which is precisely what
        ; `function F() { return function g() {}; }` is written to check.
        if (this.isDescriptorObject(ret)) {
            return ret
        }
        return inst
    }

    ; Construct-time call with already-evaluated arguments. A plain function
    ; value with the node and `this` supplied, which is what the bound path
    ; needs -- callUserFunctionNode evaluates AST arguments it does not have.
    fn callUserFunctionValues:EvalValue (fnNode:TSNode argVals:[EvalValue] thisVal:EvalValue) {
        def fv:EvalValue (EvalValue.function(fnNode))
        fv.srcText = currentSource
        fv.strictFn = (this.strictForBody(fnNode))
        fv.boundThis = thisVal
        return (this.callFnValueWithValues(fv argVals))
    }

    fn callUserFunctionNode:EvalValue (fnNode:TSNode argNodes:[TSNode] thisVal:EvalValue hasThis:boolean) {
        def savedContext:EvalContext context
        def savedDidReturn:boolean scriptDidReturn
        def savedReturnValue:EvalValue scriptReturnValue
        def savedModule:string currentModule
        scriptDidReturn = false
        scriptReturnValue = (EvalValue.null())
        ; Evaluate arg expressions (expanding ...spread) IN THE CALLER'S CONTEXT
        ; — an argument like `this.atlas` must see the caller's `this`, not the
        ; callee's. Only then create the call scope and bind `this`.
        def argVals:[EvalValue]
        def i 0
        while (i < (array_length argNodes)) {
            def an:TSNode (itemAt argNodes i)
            if (an.nodeType == "SpreadElement") {
                def sv:EvalValue (EvalValue.null())
                if an.left {
                    sv = (this.evaluateExpr((unwrap an.left)))
                }
                if (sv.isArray()) {
                    def k:int 0
                    while (k < (array_length sv.arrayValue)) {
                        push argVals (itemAt sv.arrayValue k)
                        k = (k + 1)
                    }
                }
            } {
                push argVals (this.evaluateExpr(an))
            }
            ; A throw while evaluating an ARGUMENT aborts the call -- the callee
            ; never runs. Carrying on entered the function with a half-built
            ; argument list and swallowed the exception the argument raised.
            if scriptThrew {
                scriptDidReturn = savedDidReturn
                scriptReturnValue = savedReturnValue
                return (EvalValue.undefined())
            }
            i = (i + 1)
        }
        ; Root the call scope lexically at the DEFINING module (D-MODULES scope
        ; isolation): a method on a module-owned instance runs rooted in that
        ; module's scope (its module-level state, never the caller's chain); an
        ; entry-realm method invoked FROM module code roots at the entry module
        ; scope. Pure entry→entry calls keep the legacy caller-chain parent.
        def parentScope:EvalContext context
        def homeTag:string ""
        def tagged:boolean false
        if hasThis {
            homeTag = (this.instanceModuleTag(thisVal))
            if ((strlen homeTag) > 0) {
                tagged = true
            }
        }
        if tagged {
            parentScope = (this.moduleScopeFor(homeTag))
            currentModule = homeTag
        } {
            if ((strlen currentModule) > 0) {
                parentScope = moduleScope
            }
            currentModule = ""
        }
        context = (parentScope.createChild())
        if hasThis {
            context.define("this" thisVal)
        }
        this.bindParams(fnNode argVals)
        ; D-STRICT: same rule on the node-call path.
        def savedStrict:boolean strictMode
        strictMode = (this.strictForBody(fnNode))
        callDepth = (callDepth + 1)
        def body:TSNode (this.getFunctionBody(fnNode))
        def result:EvalValue (this.callResultOf((this.evaluateFunctionBodyValue(body))))
        strictMode = savedStrict
        callDepth = (callDepth - 1)
        context = savedContext
        currentModule = savedModule
        scriptDidReturn = savedDidReturn
        scriptReturnValue = savedReturnValue
        return result
    }

    ; Evaluate `new ClassName(args)` -> an instance object with initialised fields
    ; and its constructor run.
    ;
    ; Class resolution is module-scoped (D-MODULES):
    ;   `new NS.Class()`   — NS is an imported module namespace: the class comes
    ;                        from THAT module's class table (member-new).
    ;   `new Class()`      — resolves in the CURRENT module's table when module
    ;                        code is executing, else the entry-realm map. Module
    ;                        classes are never reachable bare from the entry
    ;                        script: importing the namespace is the only door.
    ; Instances are stamped with their class's home module so method dispatch
    ; and scope rooting stay with the defining module for the object's lifetime.
    fn evaluateNewExpr:EvalValue (node:TSNode) {
        def className:string ""
        def nsModule:string ""
        def viaNamespace:boolean false
        if node.left {
            def callee:TSNode (unwrap node.left)
            className = callee.name
            if ((this.nodeKindOf(callee)) == 3) {
                if callee.left {
                    def baseNode:TSNode (unwrap callee.left)
                    def baseV:EvalValue (this.evaluateExpr(baseNode))
                    if (baseV.valueType == 5) {
                        def tagV@(optional):EvalValue (get baseV.objectMap "__nsmodule__")
                        if tagV {
                            def tag:EvalValue (unwrap tagV)
                            if (tag.valueType == 2) {
                                nsModule = tag.stringValue
                                viaNamespace = true
                            }
                        }
                    }
                }
            }
        }
        ; D-ARRAYCTOR: `new Array(n)` makes an n-slot array; `new Array(a, b)`
        ; makes one holding those elements. The single-number case is the ES5
        ; idiom for pre-sizing, and without it `new Array(3).fill(0)` produced
        ; nothing at all.
        ; `new Array(...)` and `Array(...)` share one builder so the forms
        ; cannot diverge; same for Function.
        if (className == "Array") {
            return (this.buildArrayFromArgs(node.children))
        }
        if (className == "Function") {
            return (this.buildFunctionFromSource(node.children))
        }
        ; Built-in collections: new Map([[k,v]...]) / new Set([v...]).
        if (className == "Map") {
            def m:EvalValue (EvalValue.mapEmpty())
            if ((array_length node.children) > 0) {
                def init:EvalValue (this.evaluateExpr((itemAt node.children 0)))
                if (init.isArray()) {
                    def i:int 0
                    while (i < (array_length init.arrayValue)) {
                        def pair:EvalValue (itemAt init.arrayValue i)
                        if (pair.isArray()) {
                            m.mapSet((pair.getIndex(0)) (pair.getIndex(1)))
                        }
                        i = (i + 1)
                    }
                }
            }
            return m
        }
        if (className == "Set") {
            def st:EvalValue (EvalValue.setEmpty())
            if ((array_length node.children) > 0) {
                def init:EvalValue (this.evaluateExpr((itemAt node.children 0)))
                if (init.isArray()) {
                    def i:int 0
                    while (i < (array_length init.arrayValue)) {
                        st.setAdd((itemAt init.arrayValue i))
                        i = (i + 1)
                    }
                }
            }
            return st
        }
        ; D-ERRORS: `new TypeError(msg)` / `new Error(msg)`. The constructor is a
        ; seeded singleton, so the resulting object's `constructor` compares equal
        ; to the global by reference — which is exactly what assert.throws tests.
        if (false == viaNamespace) {
            def ctorV:EvalValue (this.errorCtorFor(className))
            if (ctorV.valueType == 6) {
                def kindV:EvalValue (ctorV.getMember("__errorctor__"))
                if (kindV.valueType == 2) {
                    def msg:string ""
                    if ((array_length node.children) > 0) {
                        def mv:EvalValue (this.evaluateExpr((itemAt node.children 0)))
                        if scriptThrew {
                            return (EvalValue.undefined())
                        }
                        if (false == (mv.isUndefined())) {
                            msg = (this.toStringOf(mv))
                            if scriptThrew {
                                return (EvalValue.undefined())
                            }
                        }
                    }
                    return (this.makeError(kindV.stringValue msg))
                }
            }
        }

        ; D-ERRORS: `new F(...)` where F is an ordinary function, not a class.
        ; The spec builds a fresh object, runs the body with `this` bound to it,
        ; and yields that object unless the body returns one. sta.js defines
        ; Test262Error this way, so without it every harness throw is an opaque
        ; null and `thrown.constructor` cannot be read.
        if (false == viaNamespace) {
            if ((strlen className) > 0) {
                if (context.has(className)) {
                    def fnV:EvalValue (context.lookup(className))
                    if (fnV.valueType == 6) {
                        if fnV.functionNode {
                            return (this.constructFromFunction(fnV className node.children))
                        }
                        ; D-CTORVALUE: a bound BUILT-IN constructor held in a
                        ; variable -- `var bound = Date.bind(null, 1957);
                        ; new bound()`. No function node, so the branch above
                        ; misses it and the name-keyed lookup never sees "Date".
                        if ((strlen (this.builtinCtorNameOf(fnV))) > 0) {
                            return (this.constructFromFunction(fnV className node.children))
                        }
                    }
                }
            }
        }

        ; D-WRAPPER: `new String(x)` / `new Number(x)` / `new Boolean(x)` make a
        ; wrapper OBJECT holding the primitive. They used to make an empty
        ; object, so `new String('abc').slice(1)` found no string to work on —
        ; entire String.prototype areas scored zero because their fixtures are
        ; built this way.
        ; `new <expression>` where the expression is not a constructor is a
        ; TypeError, and an unresolvable NAME is a ReferenceError. Neither was
        ; raised: `new 1` and `new undefined` quietly produced an object.
        if node.left {
            def newCallee:TSNode (unwrap node.left)
            def ncKind:string newCallee.nodeType
            def calleeIsExpr:boolean false
            if (ncKind == "NumericLiteral") { calleeIsExpr = true }
            ; `new /z/()` -- a RegExp is not a constructor either.
            if (ncKind == "RegExpLiteral") { calleeIsExpr = true }
            if (ncKind == "StringLiteral") { calleeIsExpr = true }
            if (ncKind == "BooleanLiteral") { calleeIsExpr = true }
            if (ncKind == "NullLiteral") { calleeIsExpr = true }
            if (ncKind == "NewExpression") { calleeIsExpr = true }
            if (ncKind == "ThisExpression") { calleeIsExpr = true }
            if calleeIsExpr {
                return (this.throwSpecError("TypeError" "expression is not a constructor"))
            }
            ; `new X.prototype` is a TypeError for every built-in X: a
            ; prototype object is not a constructor, and Function.prototype is
            ; callable without being one.
            if (ncKind == "MemberExpression") {
                def protoTarget:EvalValue (this.evaluateExpr(newCallee))
                if scriptThrew {
                    return (EvalValue.undefined())
                }
                def notCtor:boolean false
                if (protoTarget.valueType == 5) { notCtor = true }
                if (protoTarget.valueType == 6) {
                    if (null? protoTarget.functionNode) {
                        if ((strlen (this.builtinCtorNameOf(protoTarget))) == 0) {
                            notCtor = true
                        }
                    }
                }
                if (protoTarget.valueType == 5) {
                    ; A plain object reached through a member expression may
                    ; still be a class value; only a PROTOTYPE object is
                    ; rejected here, which is what __protokind__ marks.
                    notCtor = false
                    if (has protoTarget.objectMap "__protokind__") { notCtor = true }
                    if (has protoTarget.objectMap "constructor") {
                        if (newCallee.name == "prototype") { notCtor = true }
                    }

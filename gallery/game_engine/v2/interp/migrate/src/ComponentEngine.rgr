            obj.setIndexAt(idx (this.descGet(desc "value")))
        } {
            ; Attributes only: an element that did not exist becomes a present
            ; undefined, which is what a descriptor without a value creates.
            if ((EvValueBridge.isHole((obj.arrayItemAt(idx))))) {
                obj.setIndexAt(idx (EvValueBridge.taggedUndefined()))
            }
        }
        this.applyDescriptorAttrs(obj key desc existedElem)
        return ""
    }

    ; D-ATTRS: the attribute triple a descriptor produces for a key. An
    ; attribute it does not mention keeps its current value on an EXISTING
    ; property and defaults to false on a new one -- the same rule the ordinary
    ; define uses, applied to an array element so the two cannot diverge.
    fn applyDescriptorAttrs:void (obj:EvHandle key:string desc:EvHandle existed:boolean) {
        def newW:boolean false
        def newE:boolean false
        def newC:boolean false
        if existed {
            newW = (obj.isWritable(key))
            newE = (obj.isEnumerable(key))
            newC = (obj.isConfigurable(key))
        }
        if (this.descHas(desc "writable")) {
            newW = ((this.descGet(desc "writable")).toBool())
        }
        if (this.descHas(desc "enumerable")) {
            newE = ((this.descGet(desc "enumerable")).toBool())
        }
        if (this.descHas(desc "configurable")) {
            newC = ((this.descGet(desc "configurable")).toBool())
        }
        obj.setAttrs(key newW newE newC)
    }

    ; One half of an accessor property as the LANGUAGE sees it: the function, or
    ; undefined when that half is absent. findGetter/findSetter answer with the
    ; engine's null sentinel, which compares equal to nothing.
    fn accessorHalf:EvHandle (obj:EvHandle key:string wantGetter:boolean) {
        def h:EvHandle (obj.findSetter(key 0))
        if wantGetter {
            h = (obj.findGetter(key 0))
        }
        if (h.isFunction()) {
            return h
        }
        return (EvValueBridge.taggedUndefined())
    }

    fn redefineError:string (obj:EvHandle key:string desc:EvHandle) {
        ; An accessor property lives in getterMap/setterMap rather than
        ; objectMap, so existence has to be asked of all three. Checking only
        ; objectMap made every accessor look absent, which meant none of the
        ; rules below ever applied to one.
        def isAccessor:boolean false
        if (obj.hasOwnGetter(key)) { isAccessor = true }
        if (obj.hasOwnSetter(key)) { isAccessor = true }
        def exists:boolean isAccessor
        if (obj.hasOwnData(key)) { exists = true }
        ; D-ARRAYDEFINE: an array ELEMENT exists too, even though it lives in
        ; arrayValue rather than objectMap -- without this none of the
        ; non-configurable rules below ever applied to one.
        if (obj.isArrayValue()) {
            def reIdx:int (this.canonicalArrayIndex(key))
            if (reIdx >= 0) {
                if (reIdx < (obj.denseLen())) {
                    if (false == ((EvValueBridge.isHole((obj.arrayItemAt(reIdx)))))) {
                        exists = true
                    }
                }
            }
        }
        if (false == exists) {
            if (false == (obj.isExtensible())) {
                return "cannot add property to a non-extensible object"
            }
            return ""
        }
        if (obj.isConfigurable(key)) {
            return ""
        }
        ; Non-configurable from here on. configurable and enumerable are frozen
        ; whichever category the property is.
        if (this.descHas(desc "configurable")) {
            if ((this.descGet(desc "configurable")).toBool()) {
                return "cannot redefine a non-configurable property as configurable"
            }
        }
        if (this.descHas(desc "enumerable")) {
            def wantE:boolean ((this.descGet(desc "enumerable")).toBool())
            if (wantE != (obj.isEnumerable(key))) {
                return "cannot change enumerable of a non-configurable property"
            }
        }
        ; A non-configurable property cannot change category either. Both
        ; directions matter: data -> accessor and accessor -> data.
        def wantsAccessor:boolean false
        if (this.descHas(desc "get")) { wantsAccessor = true }
        if (this.descHas(desc "set")) { wantsAccessor = true }
        def wantsData:boolean false
        if (this.descHas(desc "value")) { wantsData = true }
        if (this.descHas(desc "writable")) { wantsData = true }
        if (isAccessor) {
            if wantsData {
                return "cannot redefine a non-configurable accessor property as a data property"
            }
            ; Same category: the accessor functions themselves are frozen too.
            ; An ABSENT half is undefined, not the engine's null sentinel, so
            ; `{set: undefined}` on an accessor that has no setter is SameValue
            ; and therefore permitted even when the property is non-configurable.
            if (this.descHas(desc "get")) {
                def curG:EvHandle (this.accessorHalf(obj key true))
                if (false == (curG.equals((this.descGet(desc "get"))))) {
                    return "cannot change the getter of a non-configurable property"
                }
            }
            if (this.descHas(desc "set")) {
                def curS:EvHandle (this.accessorHalf(obj key false))
                if (false == (curS.equals((this.descGet(desc "set"))))) {
                    return "cannot change the setter of a non-configurable property"
                }
            }
            return ""
        }
        if wantsAccessor {
            return "cannot redefine a non-configurable data property as an accessor property"
        }
        if (obj.isWritable(key)) {
            return ""
        }
        ; Non-configurable AND non-writable: value and writability are frozen.
        if (this.descHas(desc "writable")) {
            if ((this.descGet(desc "writable")).toBool()) {
                return "cannot make a non-configurable, non-writable property writable"
            }
        }
        if (this.descHas(desc "value")) {
            ; getPropertyValue, not getMember: an array ELEMENT lives in the
            ; dense store, so the raw member read answered undefined and every
            ; redefinition of a frozen element looked like a change.
            def cur:EvHandle (this.getPropertyValue(obj key))
            def want:EvHandle (this.descGet(desc "value"))
            if (false == (this.sameValueOf(cur want))) {
                return "cannot change the value of a non-configurable, non-writable property"
            }
        }
        return ""
    }

    ; SameValue (§7.2.11): like ===, except NaN equals itself and +0 does not
    ; equal -0. It is what [[DefineOwnProperty]] compares a redefinition's
    ; value against, and strict equality gets both of those backwards --
    ; redefining a frozen NaN element was refused and redefining a frozen -0
    ; with +0 was allowed.
    fn sameValueOf:boolean (a:EvHandle b:EvHandle) {
        if ((a.isNumber()) && (b.isNumber())) {
            def an:double (a.toNumber())
            def bn:double (b.toNumber())
            if (an != an) {
                return (bn != bn)
            }
            if (bn != bn) {
                return false
            }
            if (an != bn) {
                return false
            }
            if (an == 0.0) {
                return ((1.0 / an) == (1.0 / bn))
            }
            return true
        }
        return (a.equals(b))
    }

    fn objectStaticNeedsObject:boolean (name:string) {
        if (name == "defineProperty") { return true }
        if (name == "defineProperties") { return true }
        if (name == "create") { return true }
        return false
    }

    ; Statics that COERCE their argument to an object and throw only on
    ; null/undefined. ES5.1 threw for any non-object here, and modelling that
    ; older rule made Object.keys('abc') a TypeError instead of ["0","1","2"] --
    ; Test262 tracks the current spec, so the stricter reading cost score even
    ; on tests tagged es5id.
    fn objectStaticCoerces:boolean (name:string) {
        if (name == "keys") { return true }
        if (name == "values") { return true }
        if (name == "entries") { return true }
        if (name == "getOwnPropertyNames") { return true }
        if (name == "getOwnPropertyDescriptor") { return true }
        if (name == "getPrototypeOf") { return true }
        return false
    }

    fn errorKindNames:[string] () {
        def out:[string]
        push out "Error"
        push out "TypeError"
        push out "ReferenceError"
        push out "RangeError"
        push out "SyntaxError"
        push out "EvalError"
        push out "URIError"
        push out "AggregateError"
        return out
    }

    ; D-SYMBOL: `Symbol` as a global with the well-known symbols. Each is a
    ; distinct object value, so `Symbol.iterator !== Symbol.asyncIterator` and a
    ; symbol compares equal only to itself — the property tests rely on that.
    ; Symbol() as a factory is handled at the call site; this seeds the statics.
    ; D-SYMBOL: `Symbol(desc)` mints a value equal only to itself. The
    ; description is what it PRINTS as; the sequenced id is what makes it a
    ; distinct property key.
    fn mintSymbol:EvHandle (desc:string) {
        return (this.mintSymbolDesc(desc true))
    }

    ; `hasDesc` false is `Symbol()` with no argument, whose `description` is
    ; undefined rather than the empty string -- the two are distinguishable.
    fn mintSymbolDesc:EvHandle (desc:string hasDesc:boolean) {
        def keysY:[string]
        def valsY:[EvHandle]
        def minted:EvHandle (EvValueBridge.taggedObject(keysY valsY))
        minted.setMember("__symbol__" (EvValueBridge.taggedString(desc)))
        symbolSeq = (symbolSeq + 1)
        def symId:string ("@@" + (to_string symbolSeq))
        minted.setMember("__symid__" (EvValueBridge.taggedString(symId)))
        set symbolById symId minted
        if hasDesc {
            set symbolFnNames symId (EvValueBridge.taggedString(("[" + (desc + "]"))))
        } {
            set symbolFnNames symId (EvValueBridge.taggedString(""))
        }
        if hasDesc {
            minted.setMember("description" (EvValueBridge.taggedString(desc)))
        } {
            minted.setMember("description" (EvValueBridge.taggedUndefined()))
        }
        return minted
    }

    ; annexB B.2.1.1: escape. The unreserved set is

        ; the elements are installed below in one go. §23.1.2.1 passes the
        ; count, but a subclass constructor that ignores it -- which is every
        ; one that does not declare its own -- ends up in the same place, and
        ; a subclass that DOES take arguments must not be handed the items as
        ; if they were its parameters.
        def ctorArgs:[EvHandle]
        def built:EvHandle (this.constructWithValues(recvV ctorArgs recvV))
        if scriptThrew {
            return (EvValueBridge.taggedArray(items))
        }
        if (false == (built.isArrayValue())) {
            return (EvValueBridge.taggedArray(items))
        }
        built.arrSetItems(items)
        return built
    }

    ; §23.1.3.4 ArraySpeciesCreate: an array method that BUILDS a new array
    ; builds it through the receiver's species, so `L.from(xs).map(f)` is an L
    ; rather than a plain array.
    ;
    ; The species is read from the `__class__` stamp the instance already
    ; carries, not from `constructor`. For an array value, reading a property
    ; by name dispatches by KIND first, so `constructor` answers the Array
    ; global rather than walking the instance's own prototype chain -- true
    ; internally even though guest code sees `l.constructor === L`. The stamp
    ; is own data and says exactly what built it.

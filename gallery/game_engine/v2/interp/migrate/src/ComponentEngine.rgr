                        ; namespace object like Math or JSON, or a binding that
                        ; holds a non-function. Anything unresolved here is left
                        ; to the checks below, which know about classes.
                        def irName:string instRight.name
                        if (this.isErrorCtorName(irName)) {
                            ; a real constructor, seeded on hostScope
                        } {
                        if (context.has(irName)) {
                            def irVal:EvalValue (context.lookup(irName))
                            if (irVal.valueType != 6) {
                                return (this.throwSpecError("TypeError" "Right-hand side of 'instanceof' is not callable"))
                            }
                        } {
                            if (this.isEngineGlobalName(irName)) {
                                def irG:EvalValue (this.builtinGlobalObject(irName))
                                if (irG.valueType != 6) {
                                    return (this.throwSpecError("TypeError" "Right-hand side of 'instanceof' is not callable"))
                                }
                            }
                        }
                        }
                    }
                    if (irKind == "ObjectExpression") {
                        return (this.throwSpecError("TypeError" "Right-hand side of 'instanceof' is not callable"))
                    }
                    if (irKind == "ThisExpression") {
                        def irThis:EvalValue (this.evaluateExpr(instRight))
                        if (irThis.valueType != 6) {
                            return (this.throwSpecError("TypeError" "Right-hand side of 'instanceof' is not callable"))
                        }
                    }
                }
                if (this.isBuiltinCtorName(cname)) {
                    def bRes:int (this.builtinInstanceOf(lv cname))
                    if (bRes >= 0) {
                        return (EvalValue.boolean((bRes == 1)))
                    }
                }
                ; A FUNCTION left-operand is object-like too, and its
                ; prototype-chain answer (including the TypeError for a
                ; non-object F.prototype) has to be reached the same way.
                def lvObjectLike:boolean (lv.isObject())
                if (lv.valueType == 6) { lvObjectLike = true }
                if (lv.valueType == 4) { lvObjectLike = true }
                if lvObjectLike {
                    def tag:EvalValue (lv.getMember("__class__"))
                    if (tag.isString()) {
                        return (EvalValue.boolean(((tag.stringValue) == cname)))
                    }
                    ; D-ERRORS: every native error inherits from Error, so
                    ; `e instanceof Error` holds for a TypeError as much as
                    ; `e instanceof TypeError` does. The identity check below
                    ; compares constructors and would say false, which is the one
                    ; case where the missing inheritance chain is observable in
                    ; ordinary guest code -- `catch (e) { e instanceof Error }`
                    ; is how half the suite's negative tests confirm a throw.
                    if (has lv.objectMap "__error__") {
                        if (cname == "Error") {
                            return (EvalValue.boolean(true))
                        }
                    }
                    ; D-INSTANCEOF: the real algorithm for a user constructor --
                    ; take F.prototype and walk the value's prototype chain
                    ; looking for it BY IDENTITY. A `constructor` comparison
                    ; cannot see an object reparented with Object.create, and it
                    ; misses the spec's TypeError for a non-object prototype.
                    if node.right {
                        def rvF:EvalValue (this.evaluateExpr((unwrap node.right)))
                        if (rvF.valueType == 6) {
                            def protoF:EvalValue (rvF.getMember("prototype"))
                            def protoIsObject:boolean false
                            if (protoF.valueType == 5) { protoIsObject = true }
                            if (protoF.valueType == 4) { protoIsObject = true }

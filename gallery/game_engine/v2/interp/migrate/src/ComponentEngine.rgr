    ; (`i < 50000`, `j < a.length`) — compares two doubles and mints
    ; nothing. Everything else takes the ordinary evaluator; the fallback
    ; may re-evaluate the operands, which admission made effect-free.
    fn evaluateCondBool:boolean (node:TSNode) {
        if (false == anyWithScope) {
            if ((this.nodeKindOf(node)) == 5) {
                def cop:string node.value
                def copK:int 0
                if (cop == "<") { copK = 1 }
                if (cop == "<=") { copK = 2 }
                if (cop == ">") { copK = 3 }
                if (cop == ">=") { copK = 4 }
                if (cop == "==") { copK = 5 }
                if (cop == "===") { copK = 5 }
                if (cop == "!=") { copK = 6 }
                if (cop == "!==") { copK = 6 }
                if (copK > 0) {
                    if node.left {
                    if node.right {
                        def cl:TSNode (unwrap node.left)
                        def cr:TSNode (unwrap node.right)
                        if ((this.transientOperandOk(cl 0)) && (this.transientOperandOk(cr 0))) {
                            def clv:EvHandle (this.evaluateExprTransient(cl))
                            if scriptThrew {

        }
        def canProps:boolean false
        if (obj.isObject()) { canProps = true }
        if (obj.isFunction()) { canProps = true }
        if (obj.isArrayValue()) { canProps = (obj.hasOwnData(methodName)) }
        if (obj.isMap()) { canProps = (obj.hasOwnData(methodName)) }
        if (obj.isSet()) { canProps = (obj.hasOwnData(methodName)) }

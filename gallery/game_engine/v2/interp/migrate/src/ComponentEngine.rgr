                ; and removed nothing. The name is a REFERENCE, and what it
                ; resolves to decides the answer:
                ;   - a property of a `with` object: delete that property;
                ;   - a declared `var`/function: non-configurable, so false;
                ;   - a binding created by plain assignment (an implicit global):
                ;     configurable, so it goes and the answer is true;
                ;   - unresolvable: true, per spec.
                if ((this.nodeKindOf(tgt)) == 1) {
                    def delName:string tgt.name
                    def delWith:EvalValue (this.withHostFor(delName))
                    if (delWith.valueType == 5) {
                        if (false == (delWith.isConfigurable(delName))) {
                            if strictMode {
                                return (this.throwSpecError("TypeError" ("cannot delete " + delName)))
                            }
                            return (EvalValue.boolean(false))
                        }
                        delWith.removeMember(delName)

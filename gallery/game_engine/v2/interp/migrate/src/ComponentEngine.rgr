                }
                if (b0 < 128) {
                    ; decodeURI leaves the RESERVED set encoded: `%2F` stays
                    ; "%2F" so a decoded URI still parses as one.
                    def leaveIt:boolean false
                    if keepReserved {
                        if (this.uriReserved(b0)) { leaveIt = true }
                    }
                    if leaveIt {
                        out = (out + (substring s i (i + 3)))
                    } {
                        out = (out + (strfromcode b0))
                    }
                    i = (i + 3)
                } {
                    ; A multi-byte sequence: how many continuation bytes the
                    ; lead announces, each of which must itself be a `%XX` in
                    ; the 0x80..0xBF range.
                    def extra:int 0
                    if ((b0 >= 192) && (b0 <= 223)) { extra = 1 }
                    if ((b0 >= 224) && (b0 <= 239)) { extra = 2 }
                    if ((b0 >= 240) && (b0 <= 247)) { extra = 3 }
                    if (extra == 0) {
                        return (this.throwSpecError("URIError" "URI malformed"))
                    }
                    def cp:int 0
                    if (extra == 1) { cp = (bit_and b0 31) }
                    if (extra == 2) { cp = (bit_and b0 15) }
                    if (extra == 3) { cp = (bit_and b0 7) }
                    def seq:string (substring s i (i + 3))
                    def k:int 0
                    def at:int (i + 3)
                    while (k < extra) {
                        ; at+1 and at+2 are both READ, so the last legal start
                        ; is n-3: an off-by-one here walked off the end of the
                        ; string on a truncated sequence.
                        if ((at + 2) >= n) {
                            return (this.throwSpecError("URIError" "URI malformed"))
                        }
                        if ((bit_and (charAt s at) 255) != 37) {
                            return (this.throwSpecError("URIError" "URI malformed"))
                        }
                        def bn:int (this.hexValueOf(s (at + 1) 2))
                        if (bn < 0) {
                            return (this.throwSpecError("URIError" "URI malformed"))
                        }
                        if ((bn < 128) || (bn > 191)) {
                            return (this.throwSpecError("URIError" "URI malformed"))
                        }
                        cp = ((cp * 64) + (bit_and bn 63))
                        seq = (seq + (substring s at (at + 3)))
                        at = (at + 3)
                        k = (k + 1)

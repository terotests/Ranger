                    }
                    ; A non-configurable property of the GLOBAL object -- NaN,
                    ; Infinity, undefined -- cannot be deleted either, and it is
                    ; not a scope binding so the check below never saw it.
                    def gDel:EvalValue (this.theGlobalObject())
                    if (gDel.valueType == 5) {
                        if (has gDel.objectMap delName) {
                            if (false == (gDel.isConfigurable(delName))) {
                                return (EvalValue.boolean(false))
                            }
                        }
                    }
                    if (context.has(delName)) {
                        ; A DECLARED binding -- `var`, a function declaration, a
                        ; parameter -- is non-configurable, so the delete fails
                        ; and the binding stays. Only a name created by
                        ; assignment to an undeclared identifier can go.
                        if (false == (has implicitGlobalSet delName)) {
                            return (EvalValue.boolean(false))
                        }
                        def removed:boolean (context.removeBinding(delName))
                        def gObj:EvalValue (this.theGlobalObject())
                        if (gObj.valueType == 5) {
                            gObj.removeMember(delName)
                        }
                        def freshImplicit:[string:boolean]
                        def implNames:[string] (keys implicitGlobalSet)
                        def ii:int 0
                        while (ii < (array_length implNames)) {
                            if ((itemAt implNames ii) != delName) {
                                set freshImplicit (itemAt implNames ii) true
                            }
                            ii = (ii + 1)
                        }
                        implicitGlobalSet = freshImplicit
                        return (EvalValue.boolean(removed))
                    }
                    return (EvalValue.boolean(true))
                }
                if ((this.nodeKindOf(tgt)) == 3) {
                    def obj:EvalValue (EvalValue.null())
                    if tgt.left {
                        obj = (this.evaluateExpr((unwrap tgt.left)))
                    }
                    if tgt.computed {
                        if tgt.right {
                            def iv:EvalValue (this.evaluateExpr((unwrap tgt.right)))
                            if scriptThrew {
                                return (EvalValue.undefined())
                            }
                            ; D-ARRAYLEN: deleting an ELEMENT leaves a hole and
                            ; does NOT shorten the array. removeMember only knows
                            ; about the property map, so `delete a[1]` did
                            ; nothing at all and the element stayed readable.
                            def dkey:string (this.toPropertyKey(iv))
                            if (obj.valueType == 4) {
                                def didx@(optional):int (to_int dkey)
                                if didx {

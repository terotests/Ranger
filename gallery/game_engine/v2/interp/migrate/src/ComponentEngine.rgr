    }

    ; Mint an EvHandle for the slot at i -- the walker boundary. Small ints
    ; and the singleton undefined/null/booleans come from the pool, so boxing
    ; a loop counter or a flag allocates nothing.
    fn bcSlotBox:EvHandle (i:int) {
        def t:int (itemAt bcTags i)
        if (t == 1) {
            return (EvHandle.number((itemAt bcNums i)))

            j = (j + 1)
        }
        if (v >= 4294967295.0) {
            return (0 - 1)
        }
        return (to_int v)
    }

    fn toPropertyKey:string (v:EvalValue) {
        if (v.isString()) {
            return v.stringValue
        }
        def p:EvalValue v
        if (v.valueType == 5) { p = (this.toPrimitive(v true)) }
        if (v.valueType == 4) { p = (this.toPrimitive(v true)) }
        if (v.valueType == 6) { p = (this.toPrimitive(v true)) }
        if (p.isString()) {
            ; Bind before returning. `p` here is a value this scope OWNS --
            ; toPrimitive handed back a fresh one -- so returning its stringValue
            ; directly gave the caller a pointer into a value that scope exit
            ; then released, and `String(Array.prototype)` read the freed bytes.
            ; Binding takes a private copy the caller can outlive.
            def owned:string p.stringValue
            return owned
        }
        return (p.toString())
    }

    ; ToPropertyDescriptor rejects anything that is not an Object -- which
    ; includes arrays and functions, so the check cannot simply be "is a plain
    ; object". `Object.defineProperty(o, 'k', function () {})` is legal and
    ; defines an undefined-valued property.
    ; D-DEFINEOWN: the properties-object step shared by Object.defineProperties
    ; and Object.create's second argument. Its OWN ENUMERABLE keys are visited,
    ; each value is read with a full [[Get]] so an accessor on the properties
    ; object runs, and every descriptor is validated BEFORE any is applied --
    ; which is what makes a bad one later in the map leave the target untouched.
    ; Object.create used to have a copy of this that validated nothing and read
    ; the raw map, so a getter-supplied descriptor produced nothing at all.
    fn applyDescriptorMap:string (target:EvalValue rawDescs:EvalValue) {
        ; The properties argument is ToObject'd, not required to be an object:
        ; `Object.defineProperties(o, false)` boxes the boolean, finds no own
        ; enumerable property on it, and quietly returns o. Only null and
        ; undefined are a TypeError, and ToObject raises that itself.
        if ((rawDescs.isNull()) || (rawDescs.isUndefined())) {
            return "Properties must be an object"
        }
        def descs:EvalValue (this.toObjectValue(rawDescs))
        if scriptThrew {
            return ""
        }
        if (false == (this.isDescriptorObject(descs))) {
            return "Properties must be an object"
        }
        def dkeys:[string] (this.objectEnumerableKeys(descs))
        def collected:[EvalValue]
        def names:[string]
        def i:int 0
        while (i < (array_length dkeys)) {
            def k:string (itemAt dkeys i)
            if (false == (this.isHiddenInstanceKey(k))) {
                def d:EvalValue (this.descGet(descs k))
                if scriptThrew {
                    return ""
                }
                if (false == (this.isDescriptorObject(d))) {
                    return "Property description must be an object"
                }
                def vErr:string (this.descriptorError(d))
                if ((strlen vErr) > 0) {
                    return vErr
                }
                push collected d
                push names k
            }
            i = (i + 1)
        }
        def j:int 0
        while (j < (array_length names)) {
            def aErr:string (this.definePropertyOn(target (itemAt names j) (itemAt collected j)))
            if ((strlen aErr) > 0) {
                return aErr
            }
            if scriptThrew {
                return ""
            }
            j = (j + 1)
        }
        return ""
    }

    fn isDescriptorObject:boolean (v:EvalValue) {
        if (v.valueType == 5) { return true }
        if (v.valueType == 4) { return true }
        if (v.valueType == 6) { return true }
        if (v.valueType == 9) { return true }
        if (v.valueType == 10) { return true }
        return false
    }

    ; D-DEFINEOWN: one [[DefineOwnProperty]], shared by Object.defineProperty and
    ; Object.defineProperties. The two had separate copies and only the singular
    ; form validated anything, so `Object.defineProperties(o, {p: true})` quietly
    ; created `p` with value undefined instead of throwing, and the plural form
    ; would happily redefine a non-configurable property.
    ;
    ; Returns "" on success, or the TypeError message to raise.
    ; D-DEFINEOWN: reading a field OF THE DESCRIPTOR is a full [[Get]] -- it runs
    ; an accessor and it walks the prototype chain. Reading `objectMap` directly
    ; missed both, so a descriptor whose `value` was a getter, or inherited from
    ; a prototype, defined nothing. That is the single largest failure family in
    ; Object.defineProperty and Object.defineProperties.
    fn descHas:boolean (desc:EvalValue key:string) {
        def walk:EvalValue desc
        def steps:int 0
        while (steps < 16) {
            if (has walk.objectMap key) { return true }
            if (has walk.getterMap key) { return true }
            if (has walk.setterMap key) { return true }
            def nxt:EvalValue (this.protoOfValue(walk))
            if (nxt.isNull()) {
                return false
            }
            walk = nxt
            steps = (steps + 1)
        }
        return false
    }

    fn descGet:EvalValue (desc:EvalValue key:string) {
        ; One ordered walk, deciding at EACH level before going up. Asking for
        ; the getter first walked the whole chain and let an INHERITED accessor
        ; beat an OWN data property, which is backwards -- the nearest holder
        ; wins whichever kind it is.
        def walk:EvalValue desc
        def steps:int 0
        while (steps < 16) {
            if (has walk.getterMap key) {
                def gFn:EvalValue (unwrap (get walk.getterMap key))
                if (gFn.valueType == 6) {
                    def noArgs:[EvalValue]
                    return (this.callFnValueWithValues((gFn.withThis(desc)) noArgs))
                }
            }
            ; A set-only accessor reads as undefined and does NOT fall through
            ; to whatever the prototype holds.
            if (has walk.setterMap key) {
                return (EvalValue.undefined())
            }
            if (has walk.objectMap key) {
                return (unwrap (get walk.objectMap key))
            }
            def nxt:EvalValue (this.protoOfValue(walk))
            if (nxt.isNull()) {
                return (EvalValue.undefined())
            }
            walk = nxt
            steps = (steps + 1)
        }
        return (EvalValue.undefined())
    }

    fn definePropertyOn:string (obj:EvalValue key:string desc:EvalValue) {
        if (false == (this.isDescriptorObject(desc))) {
            return "Property description must be an object"
        }
        def dErr:string (this.descriptorError(desc))
        if ((strlen dErr) > 0) {
            return dErr
        }
        ; D-ARRAYDEFINE: an ARRAY has its own [[DefineOwnProperty]] (15.4.5.1).
        ; `length` is a real property whose write resizes, and an index defines
        ; an element and may push `length` out. Neither went anywhere near the
        ; elements before -- `Object.defineProperty(a, "length", {value: 0})`
        ; stored a stray property and left the array as it was.
        if (obj.valueType == 4) {
            if (key == "length") {
                return (this.defineArrayLength(obj desc))
            }
            def elemIdx:int (this.canonicalArrayIndex(key))
            if (elemIdx >= 0) {
                if (elemIdx <= 10000000) {
                    return (this.defineArrayIndex(obj elemIdx desc))
                }
                ; Past the dense store the element is an ordinary property, but
                ; it still moves the length.
                def farErr:string (this.definePlainProperty(obj key desc))
                if ((strlen farErr) > 0) {
                    return farErr
                }
                if ((elemIdx + 1) > (obj.arrayLength())) {
                    obj.declaredLength = (elemIdx + 1)
                }
                return ""
            }
        }
        def rErr:string (this.redefineError(obj key desc))
        if ((strlen rErr) > 0) {
            return rErr
        }
        return (this.definePlainProperty(obj key desc))
    }

    ; The ordinary [[DefineOwnProperty]], after the array-specific rules and the
    ; redefinition check have had their say.
    fn definePlainProperty:string (obj:EvalValue key:string desc:EvalValue) {
        ; D-ARGMAP: defining a mapped index with a VALUE writes the parameter
        ; too -- the two are one binding, and leaving the parameter behind made
        ; a later read through the mapping answer the stale one.
        def dmName:string (this.argMapName(obj key))
        if ((strlen dmName) > 0) {
            if (this.descHas(desc "value")) {
                def dmCtx:EvalContext (this.argMapScopeOf(obj))
                if (dmCtx.has(dmName)) {
                    dmCtx.assign(dmName (this.descGet(desc "value")))
                }
            }
        }
        ; D-ATTRS: an attribute the descriptor does not mention KEEPS its current
        ; value on an existing property, and defaults to FALSE on a new one --
        ; unlike plain assignment, which defaults them all true. Taking the
        ; descriptor's `undefined` as false made every redefinition silently
        ; strip the flags the property already had.
        def existed:boolean false
        if (has obj.objectMap key) { existed = true }
        if (has obj.getterMap key) { existed = true }
        if (has obj.setterMap key) { existed = true }
        def newW:boolean false
        def newE:boolean false
        def newC:boolean false
        if existed {
            newW = (obj.isWritable(key))
            newE = (obj.isEnumerable(key))
            newC = (obj.isConfigurable(key))
        }
        if (this.descHas(desc "writable")) {
            newW = ((this.descGet(desc "writable")).toBool())
        }
        if (this.descHas(desc "enumerable")) {
            newE = ((this.descGet(desc "enumerable")).toBool())
        }
        if (this.descHas(desc "configurable")) {
            newC = ((this.descGet(desc "configurable")).toBool())
        }
        def gv:EvalValue (this.descGet(desc "get"))
        def sv:EvalValue (this.descGet(desc "set"))
        if ((this.descHas(desc "get")) || (this.descHas(desc "set"))) {
            ; D-ACCESSORS: a real accessor property. The functions are stored
            ; apart from objectMap so the property is never mistaken for a data
            ; one -- and turning a DATA property into an accessor has to remove
            ; the old value, or the descriptor still reports value/writable.
            if (has obj.objectMap key) {
                obj.clearDataSlot(key)
            }
            ; A half the descriptor MENTIONS is replaced -- `{set: undefined}`
            ; really does remove the setter -- and a half it omits is kept.
            if (this.descHas(desc "get")) {
                obj.clearGetterOnly(key)
                if (gv.valueType == 6) {
                    obj.defineGetter(key gv)
                }
            }
            if (this.descHas(desc "set")) {
                obj.clearSetterOnly(key)
                if (sv.valueType == 6) {
                    obj.defineSetter(key sv)
                }
            }
            ; `{get: undefined}` is still an ACCESSOR descriptor: the property
            ; exists, reads as undefined, and reports get/set rather than
            ; value/writable. Recording nothing at all made it vanish.
            if (false == (has obj.getterMap key)) {
                if (false == (has obj.setterMap key)) {
                    obj.defineGetter(key (EvalValue.undefined()))
                }
            }
            ; An accessor has no writable attribute of its own.
            obj.setAttrs(key false newE newC)
            return ""
        }
        ; Turning an ACCESSOR into a data property drops the functions.
        if (has obj.getterMap key) {
            obj.clearAccessor(key)
        }
        if (has obj.setterMap key) {
            obj.clearAccessor(key)
        }
        ; Written through the raw map because setMember would refuse a second
        ; defineProperty on a non-writable property, while redefining a
        ; CONFIGURABLE one is allowed.
        def newVal:EvalValue (EvalValue.undefined())
        if existed {
            if (has obj.objectMap key) {
                newVal = (unwrap (get obj.objectMap key))
            }
        }
        if (this.descHas(desc "value")) {
            newVal = (this.descGet(desc "value"))
        }
        set obj.objectMap key newVal
        obj.setAttrs(key newW newE newC)
        return ""
    }

    ; definePropertyOn reports a failure as a message. Almost every one is a
    ; TypeError, but the array-length rules produce a RangeError, so the kind
    ; travels with the message behind an "@Kind@" prefix rather than as a second
    ; return value Ranger cannot give.
    fn throwDefineError:EvalValue (err:string) {
        def n:int (strlen err)
        if (n > 1) {
            if ((substring err 0 1) == "@") {
                def i:int 1
                while (i < n) {
                    if ((substring err i (i + 1)) == "@") {
                        def kind:string (substring err 1 i)
                        def msg:string (substring err (i + 1) n)
                        return (this.throwSpecError(kind msg))
                    }
                    i = (i + 1)
                }
            }
        }
        return (this.throwSpecError("TypeError" err))
    }

    ; D-ARRAYDEFINE: `Object.defineProperty(arr, "length", desc)`. The value is
    ; ToUint32 and must equal ToNumber of the same descriptor field, or it is a
    ; RangeError -- `{value: undefined}` and `{value: 1.5}` both are. length is
    ; never enumerable or configurable, and asking for either is a TypeError.
    fn defineArrayLength:string (obj:EvalValue desc:EvalValue) {
        if (this.descHas(desc "get")) {
            return "cannot redefine array length as an accessor"
        }
        if (this.descHas(desc "set")) {
            return "cannot redefine array length as an accessor"
        }
        if (this.descHas(desc "configurable")) {
            if ((this.descGet(desc "configurable")).toBool()) {
                return "cannot make array length configurable"
            }
        }
        if (this.descHas(desc "enumerable")) {
            if ((this.descGet(desc "enumerable")).toBool()) {
                return "cannot make array length enumerable"
            }
        }
        def oldLen:int (obj.arrayLength())
        def oldWritable:boolean true
        if (has obj.attrFlags "length") {
            oldWritable = (obj.isWritable("length"))
        }
        def wantWritable:boolean oldWritable
        def hasWritable:boolean (this.descHas(desc "writable"))
        if hasWritable {
            wantWritable = ((this.descGet(desc "writable")).toBool())
            ; Once length is non-writable it can never be made writable again.
            if (oldWritable == false) {
                if wantWritable {
                    return "cannot make a non-writable array length writable again"
                }
            }
        }
        if (false == (this.descHas(desc "value"))) {
            if hasWritable {
                obj.setAttrs("length" wantWritable false false)
            }
            return ""
        }
        def lv:EvalValue (this.descGet(desc "value"))
        def lenNum:double (this.toNumberOf(lv))
        if scriptThrew {
            return ""
        }
        def lenTrunc:double (this.floorNum(lenNum))
        if (lenNum < 0.0) {
            lenTrunc = (0.0 - (this.floorNum((0.0 - lenNum))))
        }
        def lenU:double (this.wrapUint32(lenTrunc))
        if (lenU != lenNum) {
            return "@RangeError@Invalid array length"
        }
        def newLen:int (to_int lenU)
        ; GROWING (or unchanged) is an ordinary define: it is refused only when
        ; length is non-writable AND the value really differs. `{value: 0}` on an
        ; already-empty array with a frozen length is legal, because it changes
        ; nothing.
        if (newLen >= oldLen) {
            if (oldWritable == false) {
                if (newLen != oldLen) {
                    return "cannot change the length of an array whose length is not writable"
                }
            }
            this.setArrayLength(obj newLen)
            obj.setAttrs("length" wantWritable false false)
            return ""
        }
        ; SHRINKING needs a writable length, and stops at the first element that
        ; cannot be deleted -- the length lands just past it and a TypeError is
        ; reported, with the writable change still applied.
        if (oldWritable == false) {
            return "cannot change the length of an array whose length is not writable"
        }
        def stopAt:int newLen
        def blocked:boolean false
        def scan:int (oldLen - 1)
        while ((scan >= newLen) && (blocked == false)) {
            def ek:string (to_string scan)
            if (has obj.attrFlags ek) {
                if (false == (obj.isConfigurable(ek))) {
                    stopAt = (scan + 1)
                    blocked = true
                }
            }
            scan = (scan - 1)
        }
        this.setArrayLength(obj stopAt)
        obj.setAttrs("length" wantWritable false false)
        if blocked {
            return "cannot delete a non-configurable element while shortening length"
        }
        return ""
    }

    ; D-ARRAYSPARSE: set an array's length. Up to the dense cap the elements
    ; themselves are resized; beyond it only the DECLARED length moves, because
    ; no dense container can hold 2^32-1 slots and the spec allows a length that
    ; large with no elements at all.
    fn setArrayLength:void (obj:EvalValue newLen:int) {
        if (newLen > 10000000) {
            def dense:int (array_length obj.arrayValue)
            if (newLen < dense) {
                this.resizeArrayTo(obj newLen)
            }
            obj.declaredLength = newLen
            return
        }
        this.resizeArrayTo(obj newLen)
        obj.declaredLength = (0 - 1)
    }

    ; D-ARRAYSPARSE: shrinking `length` deletes every index property at or above
    ; the new length, including the FAR ones kept in the property map because the
    ; dense store could not reach them. Trimming only the dense store left
    ; `x[4294967294]` readable after `x.length = 2`.
    fn dropFarIndexesAbove:void (obj:EvalValue newLen:int) {
        def survivors:[string]
        def ks:[string] (keys obj.objectMap)
        def i:int 0
        while (i < (array_length ks)) {
            def k:string (itemAt ks i)
            def ki:int (this.canonicalArrayIndex(k))
            def keep:boolean true
            if (ki >= 0) {
                if (ki >= newLen) {
                    keep = false
                }
            }
            if keep {
                push survivors k
            }
            i = (i + 1)
        }
        if ((array_length survivors) != (array_length ks)) {
            def j:int 0
            while (j < (array_length ks)) {
                def dk:string (itemAt ks j)
                def stillThere:boolean false
                def m:int 0
                while (m < (array_length survivors)) {
                    if ((itemAt survivors m) == dk) { stillThere = true }
                    m = (m + 1)
                }
                if (false == stillThere) {
                    obj.removeMember(dk)
                }
                j = (j + 1)
            }
        }
    }

    fn resizeArrayTo:void (obj:EvalValue newLen:int) {
        this.dropFarIndexesAbove(obj newLen)
        def resized:[EvalValue]
        def li:int 0
        while (li < newLen) {
            if (li < (array_length obj.arrayValue)) {
                push resized (itemAt obj.arrayValue li)
            } {
                push resized (EvalValue.hole())
            }
            li = (li + 1)
        }
        obj.arrSetItems(resized)
    }

    ; D-ARRAYDEFINE: defining an INDEX writes the element and pushes `length`
    ; out when the index is past the end. The attributes are recorded under the
    ; index's name so a later truncation can see a non-configurable element.
    fn defineArrayIndex:string (obj:EvalValue idx:int desc:EvalValue) {
        def key:string (to_string idx)
        ; An index AT or BEYOND length needs the length to move, so a frozen
        ; length refuses it.
        if (idx >= (obj.arrayLength())) {
            if (has obj.attrFlags "length") {
                if (false == (obj.isWritable("length"))) {
                    return "cannot add an element past a non-writable array length"
                }
            }
        }
        def rErr:string (this.redefineError(obj key desc))
        if ((strlen rErr) > 0) {
            return rErr
        }
        ; Whether the ELEMENT was already there decides which attributes survive.
        def existedElem:boolean false
        if (idx < (array_length obj.arrayValue)) {
            if (false == ((itemAt obj.arrayValue idx).isHole)) {
                existedElem = true
            }
        }
        if (has obj.getterMap key) { existedElem = true }
        if (has obj.setterMap key) { existedElem = true }
        if (idx >= (array_length obj.arrayValue)) {
            this.resizeArrayTo(obj (idx + 1))
        }
        ; An element may be an ACCESSOR. The functions live in getterMap /
        ; setterMap under the index's name -- where the computed-read path
        ; already looks -- and the dense slot is made PRESENT so `idx in arr`
        ; is true, with the getter winning on read.
        def aG:EvalValue (this.descGet(desc "get"))
        def aS:EvalValue (this.descGet(desc "set"))
        if ((aG.valueType == 6) || (aS.valueType == 6)) {
            if (aG.valueType == 6) {
                obj.defineGetter(key aG)
            }
            if (aS.valueType == 6) {
                obj.defineSetter(key aS)
            }
            obj.setIndexAt(idx (EvalValue.undefined()))
            this.applyDescriptorAttrs(obj key desc existedElem)
            obj.setAttrs(key false (obj.isEnumerable(key)) (obj.isConfigurable(key)))
            return ""
        }
        if (this.descHas(desc "value")) {
            obj.setIndexAt(idx (this.descGet(desc "value")))
        } {
            ; Attributes only: an element that did not exist becomes a present
            ; undefined, which is what a descriptor without a value creates.
            if ((itemAt obj.arrayValue idx).isHole) {
                obj.setIndexAt(idx (EvalValue.undefined()))
            }
        }
        this.applyDescriptorAttrs(obj key desc existedElem)
        return ""
    }

    ; D-ATTRS: the attribute triple a descriptor produces for a key. An
    ; attribute it does not mention keeps its current value on an EXISTING
    ; property and defaults to false on a new one -- the same rule the ordinary
    ; define uses, applied to an array element so the two cannot diverge.
    fn applyDescriptorAttrs:void (obj:EvalValue key:string desc:EvalValue existed:boolean) {
        def newW:boolean false
        def newE:boolean false
        def newC:boolean false
        if existed {
            newW = (obj.isWritable(key))
            newE = (obj.isEnumerable(key))
            newC = (obj.isConfigurable(key))
        }
        if (this.descHas(desc "writable")) {
            newW = ((this.descGet(desc "writable")).toBool())
        }
        if (this.descHas(desc "enumerable")) {
            newE = ((this.descGet(desc "enumerable")).toBool())
        }
        if (this.descHas(desc "configurable")) {
            newC = ((this.descGet(desc "configurable")).toBool())
        }
        obj.setAttrs(key newW newE newC)
    }

    ; One half of an accessor property as the LANGUAGE sees it: the function, or
    ; undefined when that half is absent. findGetter/findSetter answer with the
    ; engine's null sentinel, which compares equal to nothing.
    fn accessorHalf:EvalValue (obj:EvalValue key:string wantGetter:boolean) {
        def h:EvalValue (obj.findSetter(key 0))
        if wantGetter {
            h = (obj.findGetter(key 0))
        }
        if (h.valueType == 6) {
            return h
        }
        return (EvalValue.undefined())
    }

    fn redefineError:string (obj:EvalValue key:string desc:EvalValue) {
        ; An accessor property lives in getterMap/setterMap rather than
        ; objectMap, so existence has to be asked of all three. Checking only
        ; objectMap made every accessor look absent, which meant none of the
        ; rules below ever applied to one.
        def isAccessor:boolean false
        if (has obj.getterMap key) { isAccessor = true }
        if (has obj.setterMap key) { isAccessor = true }
        def exists:boolean isAccessor
        if (has obj.objectMap key) { exists = true }
        ; D-ARRAYDEFINE: an array ELEMENT exists too, even though it lives in
        ; arrayValue rather than objectMap -- without this none of the
        ; non-configurable rules below ever applied to one.
        if (obj.valueType == 4) {
            def reIdx:int (this.canonicalArrayIndex(key))
            if (reIdx >= 0) {
                if (reIdx < (array_length obj.arrayValue)) {
                    if (false == ((itemAt obj.arrayValue reIdx).isHole)) {
                        exists = true
                    }
                }
            }
        }
        if (false == exists) {
            if (false == obj.extensibleFlag) {
                return "cannot add property to a non-extensible object"
            }
            return ""
        }
        if (obj.isConfigurable(key)) {
            return ""
        }
        ; Non-configurable from here on. configurable and enumerable are frozen
        ; whichever category the property is.
        if (this.descHas(desc "configurable")) {
            if ((this.descGet(desc "configurable")).toBool()) {
                return "cannot redefine a non-configurable property as configurable"
            }
        }
        if (this.descHas(desc "enumerable")) {
            def wantE:boolean ((this.descGet(desc "enumerable")).toBool())
            if (wantE != (obj.isEnumerable(key))) {
                return "cannot change enumerable of a non-configurable property"
            }
        }
        ; A non-configurable property cannot change category either. Both
        ; directions matter: data -> accessor and accessor -> data.
        def wantsAccessor:boolean false
        if (this.descHas(desc "get")) { wantsAccessor = true }
        if (this.descHas(desc "set")) { wantsAccessor = true }
        def wantsData:boolean false
        if (this.descHas(desc "value")) { wantsData = true }
        if (this.descHas(desc "writable")) { wantsData = true }
        if (isAccessor) {
            if wantsData {
                return "cannot redefine a non-configurable accessor property as a data property"
            }
            ; Same category: the accessor functions themselves are frozen too.
            ; An ABSENT half is undefined, not the engine's null sentinel, so
            ; `{set: undefined}` on an accessor that has no setter is SameValue
            ; and therefore permitted even when the property is non-configurable.
            if (this.descHas(desc "get")) {
                def curG:EvalValue (this.accessorHalf(obj key true))
                if (false == (curG.equals((this.descGet(desc "get"))))) {
                    return "cannot change the getter of a non-configurable property"
                }
            }
            if (this.descHas(desc "set")) {
                def curS:EvalValue (this.accessorHalf(obj key false))
                if (false == (curS.equals((this.descGet(desc "set"))))) {

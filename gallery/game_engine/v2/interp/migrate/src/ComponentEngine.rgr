        return (EvValueBridge.taggedString(out))
    }

    fn uriDecode:EvHandle (s:string keepReserved:boolean) {
        def bytesModel:boolean (this.stringUnitsAreBytes())
        def out:string ""
        def n:int (strlen s)
        def i:int 0
        while (i < n) {
            def c:int (bit_and (charAt s i) 65535)
            if bytesModel {
                c = (bit_and (charAt s i) 255)
            }
            if (c != 37) {
                out = (out + (strfromcode c))
                i = (i + 1)
            } {
                if ((i + 2) >= n) {
                    return (this.throwSpecError("URIError" "URI malformed"))
                }
                def b0:int (this.hexValueOf(s (i + 1) 2))
                if (b0 < 0) {

                    this.settleLoopAbrupt(myLabels savedBreak savedContinue)
                    return
                }
                def gNext:EvHandle (this.iteratorMethodOf(gIter "next"))
                if (false == (gNext.isFunction())) {
                    def _gn:EvHandle (this.throwSpecError("TypeError" "the iterator's next is not a function"))
                    context = (unwrap ofOuter)
                    this.settleLoopAbrupt(myLabels savedBreak savedContinue)
                    return
                }
                def gOn:boolean true
                def gClose:boolean false

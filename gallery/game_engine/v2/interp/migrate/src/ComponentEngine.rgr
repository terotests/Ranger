    fn objectKeysRaw:[string] (v:EvHandle) {
        def out:[string]
        ; A FUNCTION holds ordinary properties too, and a descriptor map may be
        ; one -- `Object.defineProperties(o, function () {})` reads its own
        ; enumerable properties like any other object.
        if (v.isFunction()) {
            out = (v.ownDataKeys())
            def fnAcc:[string] (v.ownGetterKeys())
            def fi:int 0
            while (fi < (array_length fnAcc)) {
                def fk:string (itemAt fnAcc fi)
                if (false == (v.hasOwnData(fk))) {
                    push out fk
                }
                fi = (fi + 1)
            }
            def fnSet:[string] (v.ownSetterKeys())
            def fj:int 0
            while (fj < (array_length fnSet)) {
                def sk2:string (itemAt fnSet fj)
                if (false == (v.hasOwnData(sk2))) {
                    if (false == (v.hasOwnGetter(sk2))) {
                        push out sk2

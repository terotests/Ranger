                                def turnCtxI:EvalContext ((unwrap inOuter).createChild())
                                turnCtxI.isBlockScope = true
                                context = turnCtxI
                            }
                            def keyV:EvHandle (EvValueBridge.taggedString(k))
                            if inPattern {
                                this.bindPattern((unwrap inPattern) keyV)
                            } {
                                if ((strlen varName) > 0) {
                                    if declaresVar {
                                        context.define(varName keyV)
                                    } {
                                        ; An existing binding is ASSIGNED, not
                                        ; shadowed -- the name outlives the loop.
                                        context.assign(varName keyV)
                                        this.syncGlobalVar(varName keyV)
                                    }
                                } {
                                    if inTarget {
                                        this.assignToTarget((unwrap inTarget) keyV)
                                    }
                                }
                            }
                            loopContinue = false
                            if stmt.body {
                                this.runBlockOrStatement((unwrap stmt.body))
                            }
                            if (scriptDidReturn || scriptThrew) {
                                looping = false
                            } {
                                if loopBreak {
                                    looping = false
                                } {
                                    if (this.continueEscapes(myLabels)) {
                                        looping = false
                                    } {
                                        i = (i + 1)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        context = (unwrap inOuter)
        this.settleLoopAbrupt(myLabels savedBreak savedContinue)
    }

    ; D-FORIN: whether a name is still present on the object or anywhere up its
    ; prototype chain, which is what decides if a snapshotted for-in key is
    ; still worth visiting.
    fn objHasKeyUpChain:boolean (obj:EvHandle key:string) {
        ; D-PROXY: the `has` trap answers `k in p`.
        if (this.isProxyValue(obj)) {
            def hTgt:EvHandle (this.proxyTargetOf(obj))
            def hTrap:EvHandle (this.proxyTrap(obj "has"))
            if scriptThrew {
                return false
            }
            if (hTrap.isFunction()) {
                def hArgs:[EvHandle]
                push hArgs hTgt
                push hArgs (EvValueBridge.taggedString(key))
                def hRes:boolean ((this.callProxyTrap(hTrap hArgs)).toBool())
                if scriptThrew {
                    return false
                }
                ; A trap may not DENY a property the target cannot lose: one
                ; that is own and non-configurable, or any own property of a
                ; non-extensible target. Reporting false for either is a
                ; TypeError, not an answer.
                if (false == hRes) {
                    def hOwn:boolean false
                    if (hTgt.hasOwnData(key)) { hOwn = true }
                    if (hTgt.hasOwnGetter(key)) { hOwn = true }
                    if (hTgt.hasOwnSetter(key)) { hOwn = true }
                    if hOwn {
                        if (false == (hTgt.isConfigurable(key))) {
                            def _h1:EvHandle (this.throwSpecError("TypeError" "proxy has trap denied a non-configurable own property"))
                            return false
                        }
                        if (false == (hTgt.isExtensible())) {
                            def _h2:EvHandle (this.throwSpecError("TypeError" "proxy has trap denied an own property of a non-extensible target"))
                            return false
                        }
                    }
                }
                return hRes
            }
            return (this.objHasKeyUpChain(hTgt key))
        }
        def walk:EvHandle obj
        def steps:int 0
        while (steps < 16) {
            if (walk.hasOwnData(key)) { return true }
            if (walk.hasOwnGetter(key)) { return true }
            if (walk.hasOwnSetter(key)) { return true }
            if (this.objHasKey(walk key)) { return true }
            def nxt:EvHandle (this.protoOfValue(walk))
            if (nxt.isNull()) {
                return false
            }
            walk = nxt
            steps = (steps + 1)
        }
        return false
    }

    ; --------------------------------------------------------------------------
    ; Value-returning statement execution (used by evaluateFunctionBodyValue).
    ; A `return` anywhere - including inside if/else and nested blocks - sets
    ; scriptReturnValue and halts execution, so script control flow (e.g. a game
    ; reducer's onButton) returns the correct value.
    ; --------------------------------------------------------------------------
    ; D-LABELS: the labels attached to the statement about to run, claimed by it.
    fn takeStatementLabels:[string] () {
        def out:[string] pendingLabels
        def fresh:[string]
        pendingLabels = fresh
        return out
    }

    fn clearStatementLabels:void () {
        def fresh2:[string]
        pendingLabels = fresh2
    }

    ; True when a pending labelled break/continue names THIS statement. The
    ; unlabelled form names the nearest enclosing loop, which is always this one.
    fn labelIsMine:boolean (labels:[string] name:string) {
        if ((strlen name) == 0) {
            return true
        }
        def i:int 0
        while (i < (array_length labels)) {
            if ((itemAt labels i) == name) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; D-LABELS: the tail every loop runs. A break/continue aimed at an OUTER
    ; label passes straight through -- the loop has stopped, and the flag stays
    ; set for the statement that owns the label to consume.
    fn settleLoopAbrupt:void (labels:[string] savedBreak:boolean savedContinue:boolean) {
        if loopBreak {
            if (this.labelIsMine(labels breakLabel)) {
                loopBreak = savedBreak
                breakLabel = ""
            }
        } {
            loopBreak = savedBreak
        }
        if loopContinue {
            if (this.labelIsMine(labels continueLabel)) {
                loopContinue = savedContinue
                continueLabel = ""
            }
        } {
            loopContinue = savedContinue
        }
    }

    ; True when a pending `continue` belongs to some OUTER statement, so this
    ; loop must stop rather than start its next iteration.
    fn continueEscapes:boolean (labels:[string]) {
        if (false == loopContinue) {
            return false
        }
        if (this.labelIsMine(labels continueLabel)) {
            continueLabel = ""
            return false
        }
        return true
    }

    fn runStatementList:void (stmts:[TSNode]) {
        ; D-FNHOIST: function declarations inside a body are hoisted to the top of
        ; that body and bound in the ENCLOSING scope, so they are callable before
        ; their own line and can recurse. Without this a nested `function f() {}`
        ; was skipped entirely — the declaration ran nowhere and `f()` resolved to
        ; nothing, which is a large blind spot: it is the ordinary way to write a
        ; helper inside a function.
        this.hoistFunctionDeclarations(stmts)
        def i:int 0
        while (i < (array_length stmts)) {
            ; Stop the block on return, a pending throw, or a loop break/continue
            ; so the rest of the block is skipped (an enclosing loop / try consumes
            ; the flag).
            if (scriptDidReturn || scriptThrew) {
                return
            }
            if scriptThrew {
                return
            }
            if loopBreak {
                return
            }
            if loopContinue {
                return
            }
            this.runStatementValue((itemAt stmts i))
            i = i + 1
        }
    }

    ; Bind every FunctionDeclaration in a statement list into the current scope,
    ; before any of the list runs. The value is a closure over the current scope
    ; so the function sees its siblings and itself (recursion).
    fn hoistFunctionDeclarations:void (stmts:[TSNode]) {
        def i:int 0
        while (i < (array_length stmts)) {
            def s:TSNode (itemAt stmts i)
            if ((this.nodeKindOf(s)) == 40) {
                if ((strlen s.name) > 0) {
                    ; D-CATCHVAR: the CLOSURE is over the current scope -- the
                    ; body must see a catch parameter or a with object -- but the
                    ; BINDING is function-scoped, so it goes to the same place a
                    ; `var` would and outlives the block.
                    def fnScope:EvalContext (context.varScope())
                    fnScope.define(s.name (this.captureClosure(s)))
                }
            }
            ; D-CLASSHOIST: a class declared inside a body was skipped the same
            ; way a nested function was — `new A()` found nothing. Registering it
            ; in the class table makes `new` resolve it. The table is keyed by
            ; name rather than scoped, so an inner class is visible wider than
            ; the spec allows; that is strictly better than not resolving at all,
            ; and shadowing follows declaration order as it would anyway.
            if ((this.nodeKindOf(s)) == 25) {
                if ((strlen s.name) > 0) {
                    set classes s.name s
                    ; ClassDefinitionEvaluation runs AT THE DECLARATION, not on
                    ; first use: its computed keys are evaluated, its heritage
                    ; is read, and an error in either -- a static named
                    ; `prototype`, a bad `extends` -- is raised here rather than
                    ; whenever something happens to touch the class.
                    def _cv:EvHandle (this.classValueFor(s.name))
                    if scriptThrew {
                        return
                    }
                }
            }
            i = (i + 1)
        }
    }

    ; PERF: nodeType dispatch was a string-compare chain on EVERY node visit.
    ; A string compare is a memcmp on the native targets, where V8 compares
    ; interned pointers for free -- so the natives paid for dispatch in a way
    ; JS never did. The kind is computed ONCE per node, memoised on it, and
    ; every hot dispatcher compares small integers instead. 0 = unscanned,
    ; 99 = a type outside the table (JSX, TS casts, rare statements).
    ; PERF: operator dispatch, same story as nodeKindOf — the operator
    ; string of a Binary/Assignment/Update/Unary expression is compared
    ; against up to forty literals per evaluation. Computed once per node,
    ; memoised, integer compares after that. 0 = unscanned, 99 = other.
    ; PERF: same split as nodeKindOf below -- the memo hit inlines, the
    ; string-compare chain runs once per node.
    fn opKindOf:int (node:TSNode) {
        if (node.evalOpKind > 0) {
            return node.evalOpKind
        }
        return (this.opKindScan(node))
    }

    fn opKindScan:int (node:TSNode) {
        def ov:string node.value
        if (ov == "=") { node.evalOpKind = 1
            return 1
        }
        if (ov == "+=") { node.evalOpKind = 2
            return 2
        }
        if (ov == "-=") { node.evalOpKind = 3
            return 3
        }
        if (ov == "*=") { node.evalOpKind = 4
            return 4
        }
        if (ov == "/=") { node.evalOpKind = 5
            return 5
        }
        if (ov == "%=") { node.evalOpKind = 6
            return 6
        }
        if (ov == "**=") { node.evalOpKind = 7
            return 7
        }
        if (ov == "<<=") { node.evalOpKind = 8
            return 8
        }
        if (ov == ">>=") { node.evalOpKind = 9
            return 9
        }
        if (ov == ">>>=") { node.evalOpKind = 10
            return 10
        }
        if (ov == "&=") { node.evalOpKind = 11
            return 11
        }
        if (ov == "|=") { node.evalOpKind = 12
            return 12
        }
        if (ov == "^=") { node.evalOpKind = 13
            return 13
        }
        if (ov == "&&=") { node.evalOpKind = 14
            return 14
        }
        if (ov == "||=") { node.evalOpKind = 15
            return 15
        }
        if (ov == "??=") { node.evalOpKind = 16
            return 16
        }
        if (ov == "++") { node.evalOpKind = 17
            return 17
        }
        if (ov == "--") { node.evalOpKind = 18
            return 18
        }
        if (ov == "+") { node.evalOpKind = 20
            return 20
        }
        if (ov == "-") { node.evalOpKind = 21
            return 21
        }
        if (ov == "*") { node.evalOpKind = 22
            return 22
        }
        if (ov == "/") { node.evalOpKind = 23
            return 23
        }
        if (ov == "%") { node.evalOpKind = 24
            return 24
        }
        if (ov == "**") { node.evalOpKind = 25
            return 25
        }
        if (ov == "<") { node.evalOpKind = 26
            return 26
        }
        if (ov == ">") { node.evalOpKind = 27
            return 27
        }
        if (ov == "<=") { node.evalOpKind = 28
            return 28
        }
        if (ov == ">=") { node.evalOpKind = 29
            return 29
        }
        if (ov == "==") { node.evalOpKind = 30
            return 30
        }
        if (ov == "!=") { node.evalOpKind = 31
            return 31
        }
        if (ov == "===") { node.evalOpKind = 32
            return 32
        }
        if (ov == "!==") { node.evalOpKind = 33
            return 33
        }
        if (ov == "&&") { node.evalOpKind = 34
            return 34
        }
        if (ov == "||") { node.evalOpKind = 35
            return 35
        }
        if (ov == "??") { node.evalOpKind = 36
            return 36
        }
        if (ov == "&") { node.evalOpKind = 37
            return 37
        }
        if (ov == "|") { node.evalOpKind = 38
            return 38
        }
        if (ov == "^") { node.evalOpKind = 39
            return 39
        }
        if (ov == "<<") { node.evalOpKind = 40
            return 40
        }
        if (ov == ">>") { node.evalOpKind = 41
            return 41
        }
        if (ov == ">>>") { node.evalOpKind = 42
            return 42
        }
        if (ov == "in") { node.evalOpKind = 43
            return 43
        }
        if (ov == "instanceof") { node.evalOpKind = 44
            return 44
        }
        if (ov == "typeof") { node.evalOpKind = 46
            return 46
        }
        if (ov == "delete") { node.evalOpKind = 47
            return 47
        }
        if (ov == "void") { node.evalOpKind = 48
            return 48
        }
        if (ov == "!") { node.evalOpKind = 49
            return 49
        }
        if (ov == "~") { node.evalOpKind = 50
            return 50
        }
        node.evalOpKind = 99
        return 99
    }

    ; PERF: split so the memo HIT -- two loads and a compare, and by far the
    ; hottest single path in the evaluator -- sits in a function small enough
    ; for the C++ compiler to inline at every call site. The string-compare
    ; chain below runs once per NODE, not once per visit, and keeping it out
    ; of the hot function is exactly what makes the hot one inlinable.
    fn nodeKindOf:int (node:TSNode) {
        if (node.evalKind > 0) {
            return node.evalKind
        }
        return (this.nodeKindScan(node))
    }

    fn nodeKindScan:int (node:TSNode) {
        def nt:string node.nodeType
        if (nt == "Identifier") { node.evalKind = 1
            return 1
        }
        if (nt == "ImportExpression") { node.evalKind = 63
            return 63
        }
        if (nt == "BigIntLiteral") { node.evalKind = 62
            return 62
        }
        if (nt == "NumericLiteral") { node.evalKind = 2
            return 2
        }
        if (nt == "MemberExpression") { node.evalKind = 3
            return 3
        }
        ; `o?.x` and `o?.[i]`. The parser gives these their own node type and
        ; sets `optional`; everything else about them is a member read, so they
        ; share the member kind and the guard lives in evaluateMemberExpr.
        ; Unmapped, they fell through to the default and answered undefined --
        ; which happens to look right for `o?.x` on a null `o` and is wrong for
        ; every other case.
        if (nt == "OptionalMemberExpression") { node.evalKind = 3
            return 3
        }
        if (nt == "CallExpression") { node.evalKind = 4
            return 4
        }
        if (nt == "OptionalCallExpression") { node.evalKind = 4
            return 4
        }
        if (nt == "BinaryExpression") { node.evalKind = 5
            return 5
        }
        if (nt == "AssignmentExpression") { node.evalKind = 6
            return 6
        }
        if (nt == "UpdateExpression") { node.evalKind = 7
            return 7
        }
        if (nt == "StringLiteral") { node.evalKind = 8
            return 8
        }
        if (nt == "BooleanLiteral") { node.evalKind = 9
            return 9
        }
        if (nt == "NullLiteral") { node.evalKind = 10
            return 10
        }
        if (nt == "TemplateLiteral") { node.evalKind = 11
            return 11
        }
        if (nt == "TaggedTemplateExpression") { node.evalKind = 48
            return 48
        }
        if (nt == "YieldExpression") { node.evalKind = 26
            return 26
        }
        ; D-ASYNC: `await` is a SUSPENSION POINT, exactly like yield, and is
        ; stepped by the same frame machine.
        if (nt == "AwaitExpression") { node.evalKind = 50
            return 50
        }
        if (nt == "UnaryExpression") { node.evalKind = 12
            return 12
        }
        if (nt == "ConditionalExpression") { node.evalKind = 13
            return 13
        }
        if (nt == "ArrayExpression") { node.evalKind = 14
            return 14
        }
        if (nt == "ObjectExpression") { node.evalKind = 15
            return 15
        }
        if (nt == "NewExpression") { node.evalKind = 16
            return 16
        }
        if (nt == "ArrowFunctionExpression") { node.evalKind = 17
            return 17
        }
        if (nt == "FunctionExpression") { node.evalKind = 18
            return 18
        }
        if (nt == "SequenceExpression") { node.evalKind = 19
            return 19
        }
        if (nt == "ThisExpression") { node.evalKind = 20
            return 20
        }
        if (nt == "RegExpLiteral") { node.evalKind = 21
            return 21
        }
        if (nt == "ArrayHole") { node.evalKind = 22
            return 22
        }
        if (nt == "ParenthesizedExpression") { node.evalKind = 23
            return 23
        }
        if (nt == "ClassExpression") { node.evalKind = 24
            return 24
        }
        if (nt == "ClassDeclaration") { node.evalKind = 25
            return 25
        }
        if (nt == "ExpressionStatement") { node.evalKind = 30
            return 30
        }
        if (nt == "VariableDeclaration") { node.evalKind = 31
            return 31
        }
        if (nt == "IfStatement") { node.evalKind = 32
            return 32
        }
        if (nt == "ForStatement") { node.evalKind = 33
            return 33
        }
        if (nt == "BlockStatement") { node.evalKind = 34
            return 34
        }
        if (nt == "ReturnStatement") { node.evalKind = 35
            return 35
        }
        if (nt == "WhileStatement") { node.evalKind = 36
            return 36
        }
        if (nt == "ForOfStatement") { node.evalKind = 37
            return 37
        }
        if (nt == "BreakStatement") { node.evalKind = 38
            return 38
        }
        if (nt == "ContinueStatement") { node.evalKind = 39
            return 39
        }
        if (nt == "FunctionDeclaration") { node.evalKind = 40
            return 40
        }
        if (nt == "LabeledStatement") { node.evalKind = 41
            return 41
        }
        if (nt == "SwitchStatement") { node.evalKind = 42
            return 42
        }
        if (nt == "DoWhileStatement") { node.evalKind = 43
            return 43
        }
        if (nt == "ForInStatement") { node.evalKind = 44
            return 44
        }
        if (nt == "ThrowStatement") { node.evalKind = 45
            return 45
        }
        if (nt == "TryStatement") { node.evalKind = 46
            return 46
        }
        if (nt == "MetaProperty") { node.evalKind = 49
            return 49
        }
        if (nt == "SpreadElement") { node.evalKind = 47
            return 47
        }
        node.evalKind = 99
        return 99
    }

    fn runStatementValue:void (stmt:TSNode) {
        if (scriptDidReturn || scriptThrew) {
            return
        }
        def stmtK:int (this.nodeKindOf(stmt))
        ; Already bound by hoisting; the declaration itself does nothing here.
        if (stmtK == 40) {
            return
        }
        ; D-CLASSSTATIC: a CLASS declaration is already bound by hoisting too --
        ; its value, prototype and heritage are built there so an error in the
        ; heritage is raised early. Its static initialisers are NOT: they are
        ; ordinary code that reads the scope around the class, and running them
        ; during hoisting showed them every enclosing `var` as undefined. They
        ; run here, where the declaring scope is live, and once only.
        if (stmtK == 25) {
            if ((strlen stmt.name) > 0) {
                def cvS:EvHandle (this.classValueFor(stmt.name))
                if scriptThrew {
                    return
                }
                this.runClassStaticInit(stmt.name cvS)
            }
            return
        }
        if (stmtK == 35) {
            if stmt.left {
                scriptReturnValue = (this.evaluateExpr((unwrap stmt.left)))
            } {
                ; A bare `return;` yields UNDEFINED, stored explicitly rather
                ; than left as the null "nothing returned" sentinel -- the two
                ; are now told apart (see callResultOf/bodyDidReturn), so a
                ; value-less return has to say what it means. ASI makes this
                ; reachable from ordinary code: `return\n{ a: 1 }` is one.
                scriptReturnValue = (EvValueBridge.taggedUndefined())
            }
            ; D-THROW: if evaluating the returned expression threw, the function
            ; did NOT return — it is unwinding. Setting scriptDidReturn here as
            ; well left both flags raised, and an enclosing catch handler is a
            ; statement list, which stops immediately on a pending return. The
            ; result was that `try { return f(); } catch (e) { ... }` silently
            ; skipped its own handler whenever f threw.
            if scriptThrew {
                return
            }
            scriptDidReturn = true
            return
        }
        if (stmtK == 31) {
            this.processVariableDeclaration(stmt)
            return
        }
        if (stmtK == 30) {
            if stmt.left {
                this.evaluateExprForSideEffect((unwrap stmt.left))
            }
            return
        }
        if (stmtK == 32) {
            this.runIfValue(stmt)
            return
        }
        if (stmtK == 34) {
            ; D-LEXSCOPE: a bare block is a scope when it declares one.
            this.runBlockOrStatement(stmt)
            return
        }
        if (stmtK == 38) {
            loopBreak = true
            breakLabel = stmt.name
            return
        }
        if (stmtK == 39) {
            loopContinue = true
            continueLabel = stmt.name
            return
        }
        ; D-LABELS: `label: statement`. The label is offered to the statement
        ; that follows -- a loop claims it -- and a break that names THIS label
        ; is consumed here, which is what makes `blk: { break blk; }` leave the
        ; block rather than the whole function. There was no case for the node
        ; type at all, so a labelled statement ran nothing whatsoever.
        if (stmtK == 41) {
            push pendingLabels stmt.name
            if stmt.body {
                this.runBlockOrStatement((unwrap stmt.body))
            }
            this.clearStatementLabels()
            if loopBreak {
                if (breakLabel == stmt.name) {
                    loopBreak = false
                    breakLabel = ""
                }
            }
            return
        }
        if (stmtK == 33) {
            this.runForStatementValue(stmt)
            return
        }
        if (stmtK == 37) {
            this.runForOfStatementValue(stmt)
            return
        }
        if (stmtK == 36) {
            this.runWhileStatementValue(stmt)
            return
        }
        if (stmtK == 42) {
            this.runSwitchStatementValue(stmt)
            return
        }
        if (stmtK == 43) {
            this.runDoWhileStatementValue(stmt)
            return
        }
        if (stmtK == 44) {
            this.runForInStatementValue(stmt)
            return
        }
        if (stmtK == 45) {
            if stmt.left {
                def thrownV:EvHandle (this.evaluateExpr((unwrap stmt.left)))
                ; A throw raised while EVALUATING the operand is the one that
                ; propagates. Overwriting it with the operand's (undefined)
                ; value replaced the real exception -- which is exactly what
                ; `throw new Error("x" + (new RegExp("a**")))` is written to
                ; catch, and the reason a whole family of pattern-validation
                ; tests saw an Error where they expected a SyntaxError.
                if scriptThrew {
                    return
                }
                scriptThrowValue = thrownV
            } {
                scriptThrowValue = (EvValueBridge.taggedUndefined())
            }
            scriptThrew = true
            return
        }
        if (stmtK == 46) {
            this.runTryStatementValue(stmt)
            return
        }
        ; D-WITH: evaluate the object, push a scope fronted by it, run the body.
        if (stmt.nodeType == "WithStatement") {
            if stmt.left {
                def wRaw:EvHandle (this.evaluateExpr((unwrap stmt.left)))
                if ((wRaw.isNull()) || (wRaw.isUndefined())) {
                    def _w:EvHandle (this.throwSpecError("TypeError" "with(...) requires an object"))
                    return
                }
                ; D-WITH: the operand goes through ToObject, so a primitive is
                ; boxed rather than rejected — only null and undefined throw.
                def wObj:EvHandle wRaw
                if (wRaw.isString()) { wObj = (this.makeWrapper("String" wRaw)) }
                if (wRaw.isNumber()) { wObj = (this.makeWrapper("Number" wRaw)) }
                if (wRaw.isBoolean()) { wObj = (this.makeWrapper("Boolean" wRaw)) }
                def savedW:EvalContext context
                context = (context.createChild())
                anyWithScope = true
                context.withObject = wObj
                if stmt.body {
                    this.runBlockOrStatement((unwrap stmt.body))
                }
                ; D-WITH: `var` inside the body belongs to the enclosing
                ; function/global scope, not to the with scope, which exists
                ; only for the duration of the statement. Bindings created in
                ; it are therefore lifted out before it is discarded.
                def liftKeys:[string] (keys context.bindings)
                def li:int 0
                while (li < (array_length liftKeys)) {
                    def lk:string (itemAt liftKeys li)
                    def lv:EvHandle (unwrap (get context.bindings lk))
                    savedW.assign(lk lv)
                    ; D-GLOBALTHIS: a `var` lifted out of a with block at the
                    ; top level is a script var like any other, so it has to
                    ; become a property of the global object too. The lift ran
                    ; after the with scope was already the current one, so
                    ; syncGlobalVar saw a non-global owner and skipped it.
                    def savedLiftCtx:EvalContext context
                    context = savedW
                    this.syncGlobalVar(lk lv)
                    context = savedLiftCtx
                    li = (li + 1)
                }
                context = savedW
            }
            return
        }
    }

    ; try { body } catch (e) { handler } finally { cleanup }. A throw in the body
    ; is caught (scriptThrew cleared, e bound to the thrown value) and the handler
    ; runs; finally always runs and a throw/return inside it takes precedence.
    fn runTryStatementValue:void (stmt:TSNode) {
        if stmt.body {
            this.runBlockOrStatement((unwrap stmt.body))
        }
        ; catch clause (node.left = CatchClause)
        if scriptThrew {
            if stmt.left {
                def catchNode:TSNode (unwrap stmt.left)
                if (catchNode.nodeType == "CatchClause") {
                    def thrown:EvHandle scriptThrowValue
                    scriptThrew = false
                    scriptThrowValue = (EvValueBridge.taggedNull())
                    def savedContext:EvalContext context
                    context = (context.createChild())
                    ; D-CATCHVAR: §12.14 -- the catch scope holds the PARAMETER
                    ; and nothing else. A `var` declared in the handler belongs
                    ; to the enclosing function scope and outlives the clause.
                    context.isBlockScope = true
                    if ((strlen catchNode.name) > 0) {
                        context.define(catchNode.name thrown)
                    }
                    if catchNode.body {
                        this.runBlockOrStatement((unwrap catchNode.body))
                    }
                    context = savedContext
                }
            }
        }
        ; D-FINALLY: the finally block runs whatever the try/catch did -- a
        ; `return`, `break`, `continue` or pending throw included. That is the
        ; whole point of the clause, and it did not happen: every statement path
        ; bails the moment one of those flags is set, so the block was reached
        ; and then immediately skipped. The pending completion is set ASIDE for
        ; the duration, and restored afterwards unless the finally produced an
        ; abrupt completion of its own -- which per spec replaces it, so
        ; `try { return 1 } finally { return 2 }` is 2 and
        ; `try { throw x } finally { break }` leaves the loop with no exception.
        if stmt.right {
            def pendReturn:boolean scriptDidReturn
            def pendReturnVal:EvHandle scriptReturnValue
            def pendThrew:boolean scriptThrew
            def pendThrowVal:EvHandle scriptThrowValue
            def pendBreak:boolean loopBreak
            def pendContinue:boolean loopContinue
            scriptDidReturn = false
            scriptReturnValue = (EvValueBridge.taggedNull())
            scriptThrew = false
            scriptThrowValue = (EvValueBridge.taggedNull())
            loopBreak = false
            loopContinue = false
            this.runBlockOrStatement((unwrap stmt.right))
            def finallyAbrupt:boolean false
            if scriptDidReturn { finallyAbrupt = true }
            if scriptThrew { finallyAbrupt = true }
            if loopBreak { finallyAbrupt = true }
            if loopContinue { finallyAbrupt = true }
            if (false == finallyAbrupt) {
                scriptDidReturn = pendReturn
                scriptReturnValue = pendReturnVal
                scriptThrew = pendThrew
                scriptThrowValue = pendThrowVal
                loopBreak = pendBreak
                loopContinue = pendContinue
            }
        }
    }

    ; D-COMPLETION: an `if` completes with UpdateEmpty(branch, UNDEFINED) --
    ; §13.6.7. When the branch it took produced no value of its own (a `break`,
    ; a declaration, a missing else) the `if` answers undefined rather than
    ; letting the previous statement's value stand. That single rule is what
    ; makes `eval("for (var i = 0;;) { if (i === 5) break; else i++; }")`
    ; undefined while `eval("for (var i = 0; i < 3; i++) { 1; break; }")` is 1.
    fn runIfValue:void (node:TSNode) {
        if node.left {
            def cond:EvHandle (this.evaluateExpr((unwrap node.left)))
            def beforeIf:EvHandle completionValue
            def ranBranch:boolean false
            if (cond.toBool()) {
                if node.body {
                    this.runBlockOrStatement((unwrap node.body))
                    ranBranch = true
                }
            } {
                if node.right {
                    this.runBlockOrStatement((unwrap node.right))
                    ranBranch = true
                }
            }
            if (completionValue.equals(beforeIf)) {
                completionValue = (EvValueBridge.taggedUndefined())
            }
        }
    }

    ; D-LEXSCOPE: does this block declare a LEXICAL name? Only such a block
    ; needs a scope of its own; giving every block one would put a context
    ; allocation in the body of every loop. Memoised on the node, since the
    ; answer is a property of the source.
    ; D-TDZ: bind each lexical name UNINITIALISED. A hole is the marker: it is
    ; a value the guest can never produce or observe, so the check costs one
    ; predicate on a value the reader already holds -- no second map probe on
    ; the hot path. The declaration replaces it when it runs.
    ; Binds into the CURRENT context, which both callers have already switched
    ; to -- Ranger's optionality rules make an EvalContext parameter awkward
    ; here and the field is what every other binder in this file uses anyway.
    fn hoistLexicalTdz:void (names:[string]) {
        def i:int 0
        while (i < (array_length names)) {
            context.define((itemAt names i) (EvValueBridge.taggedHole()))
            i = (i + 1)
        }
    }

    ; The read barrier. `name` is only for the message.
    fn tdzError:EvHandle (name:string) {
        return (this.throwSpecError("ReferenceError" ("Cannot access '" + (name + "' before initialization"))))
    }

    fn blockDeclaresLexical:boolean (blk:TSNode) {
        if blk.lexScanned {
            return blk.lexDeclares
        }
        def found:boolean false
        def names:[string]
        def i:int 0
        while (i < (array_length blk.children)) {
            def st:TSNode (itemAt blk.children i)
            def sk:int (this.nodeKindOf(st))
            if (sk == 31) {
                if ((st.kind == "let") || (st.kind == "const")) {
                    found = true
                    def di:int 0
                    while (di < (array_length st.children)) {
                        def dn:TSNode (itemAt st.children di)
                        if ((strlen dn.name) > 0) {
                            push names dn.name
                        }
                        di = (di + 1)
                    }
                }
            }
            ; A class declaration is lexically scoped too -- but it is NOT
            ; TDZ-hoisted here. Classes are registered eagerly by
            ; registerComponents, and the declaration statement itself does not
            ; re-bind at run time, so a hole put in its place would never be
            ; replaced: every later `new C()` in the same block would report a
            ; TDZ error for a class that had in fact been declared.
            if (sk == 25) { found = true }
            i = (i + 1)
        }
        blk.lexScanned = true
        blk.lexDeclares = found
        blk.lexNames = names
        return found
    }

    fn runBlockOrStatement:void (blk:TSNode) {
        if ((this.nodeKindOf(blk)) == 34) {
            ; D-LABELS: a label on a BLOCK belongs to the block, not to the first
            ; statement inside it. `blk: { do { break blk } while (true); ... }`
            ; used to hand "blk" to the do-while, which then swallowed the break
            ; and carried on with the rest of the block.
            this.clearStatementLabels()
            ; D-LEXSCOPE: `let` and `const` are scoped to the BLOCK. There was no
            ; block scope at all, so `let a = 1; { let a = 2; } a` read 2 -- the
            ; inner declaration wrote the outer binding. The scope is marked as a
            ; block scope, which is what keeps `var` inside it function-scoped.
            if (this.blockDeclaresLexical(blk)) {
                def savedCtx:EvalContext context
                def blockCtx:EvalContext (context.createChild())
                blockCtx.isBlockScope = true
                context = blockCtx
                this.hoistLexicalTdz(blk.lexNames)
                this.runStatementList(blk.children)
                context = savedCtx
            } {
                this.runStatementList(blk.children)
            }
        } {
            this.runStatementValue(blk)
        }
    }

    ; Evaluates an if statement
    ; Returns EvElement with hasReturn flag set if a return was executed
    fn evaluateIfStatement:EvElement (node:TSNode) {
        def result (new EvElement())
        result.hasReturn = false
        
        ; Evaluate the condition (node.left)
        if node.left {
            def condNode:TSNode (unwrap node.left)
            def condition:EvHandle (this.evaluateExpr(condNode))
            
            if (condition.toBool()) {
                ; Execute then-block (node.body)
                if node.body {
                    def thenBlock:TSNode (unwrap node.body)
                    def blockResult:EvElement (this.evaluateStatementBlock(thenBlock))
                    if blockResult.hasReturn {
                        return blockResult
                    }
                    if blockResult.hasBreak {
                        return blockResult
                    }
                    if blockResult.hasContinue {
                        return blockResult
                    }
                }
            } {
                ; Execute else-block if present (node.right)
                if node.right {
                    def elseBlock:TSNode (unwrap node.right)
                    ; Could be another IfStatement (else if) or BlockStatement (else)
                    if ((this.nodeKindOf(elseBlock)) == 32) {
                        def elseIfResult:EvElement (this.evaluateIfStatement(elseBlock))
                        if elseIfResult.hasReturn {
                            return elseIfResult
                        }
                        if elseIfResult.hasBreak {
                            return elseIfResult
                        }
                        if elseIfResult.hasContinue {
                            return elseIfResult
                        }
                    } {
                        def blockResult:EvElement (this.evaluateStatementBlock(elseBlock))
                        if blockResult.hasReturn {
                            return blockResult
                        }
                        if blockResult.hasBreak {
                            return blockResult
                        }
                        if blockResult.hasContinue {
                            return blockResult
                        }
                    }
                }
            }
        }
        ; No return was hit
        return result
    }
    
    ; Evaluates a block of statements (BlockStatement)
    ; Returns EvElement with hasReturn flag set if a return was executed
    fn evaluateStatementBlock:EvElement (block:TSNode) {
        def result (new EvElement())
        result.hasReturn = false
        
        ; Handle single statement (not wrapped in BlockStatement)
        if ((this.nodeKindOf(block)) == 39) {
            result.hasContinue = true
            return result
        }
        if ((this.nodeKindOf(block)) == 38) {
            result.hasBreak = true
            return result
        }
        if ((this.nodeKindOf(block)) == 35) {
            if block.left {
                def returnExpr:TSNode (unwrap block.left)
                def returnedEl:EvElement (this.evaluateJSX(returnExpr))
                returnedEl.hasReturn = true
                return returnedEl
            } {
                result.hasReturn = true
                return result
            }
        }
        
        ; Handle BlockStatement with children
        if ((this.nodeKindOf(block)) == 34) {
            def i:int 0
            while (i < (array_length block.children)) {
                def stmt:TSNode (itemAt block.children i)
                
                if ((this.nodeKindOf(stmt)) == 31) {
                    this.processVariableDeclaration(stmt)
                }
                
                if ((this.nodeKindOf(stmt)) == 32) {
                    def ifResult:EvElement (this.evaluateIfStatement(stmt))
                    if ifResult.hasReturn {
                        return ifResult
                    }
                    if ifResult.hasBreak {
                        return ifResult
                    }
                    if ifResult.hasContinue {
                        return ifResult
                    }
                }
                
                if ((this.nodeKindOf(stmt)) == 33) {
                    def forResult:EvElement (this.evaluateForStatement(stmt))
                    if forResult.hasReturn {
                        return forResult
                    }
                    if forResult.hasBreak {
                        return forResult
                    }
                    if forResult.hasContinue {
                        return forResult
                    }
                }
                
                if ((this.nodeKindOf(stmt)) == 37) {
                    def forOfResult:EvElement (this.evaluateForOfStatement(stmt))
                    if forOfResult.hasReturn {
                        return forOfResult
                    }
                    if forOfResult.hasBreak {
                        return forOfResult
                    }
                    if forOfResult.hasContinue {
                        return forOfResult
                    }
                }
                
                if ((this.nodeKindOf(stmt)) == 36) {
                    def whileResult:EvElement (this.evaluateWhileStatement(stmt))
                    if whileResult.hasReturn {
                        return whileResult
                    }
                    if whileResult.hasBreak {
                        return whileResult
                    }
                    if whileResult.hasContinue {
                        return whileResult
                    }
                }
                
                if ((this.nodeKindOf(stmt)) == 30) {
                    if stmt.left {
                        def exprNode:TSNode (unwrap stmt.left)
                        this.evaluateExprForSideEffect(exprNode)
                    }
                }
                
                if ((this.nodeKindOf(stmt)) == 35) {
                    if stmt.left {
                        def returnExpr:TSNode (unwrap stmt.left)
                        def returnedEl:EvElement (this.evaluateJSX(returnExpr))
                        returnedEl.hasReturn = true
                        return returnedEl
                    } {
                        result.hasReturn = true
                        return result
                    }
                }
                
                if ((this.nodeKindOf(stmt)) == 39) {
                    result.hasContinue = true
                    return result
                }
                
                if ((this.nodeKindOf(stmt)) == 38) {
                    result.hasBreak = true
                    return result
                }
                
                i = i + 1
            }
        }
        
        return result
    }
    
    ; Evaluates an expression for its side effects (e.g., arr.push(x), i++)
    ; D-COMPLETION: an expression statement's value IS the statement's
    ; completion value, so each branch records it. `eval` reads it back; nothing
    ; else does, which is why this stayed a void call.
    fn evaluateExprForSideEffect:void (node:TSNode) {
        def seK:int (this.nodeKindOf(node))
        def handledSE:boolean false
        ; D-OPTCHAIN: a chain evaluated for its SIDE EFFECTS is still a chain
        ; that ends here. Leaving the flag raised made the next member read
        ; anywhere in the program short-circuit for no reason -- the statement
        ; `o?.[i++];` on a nullish o poisoned everything after it.
        optChainAborted = false
        ; Handle CallExpression (method calls like arr.push(x))
        if (seK == 4) {
            completionValue = (this.evaluateExpr(node))
            handledSE = true
        }

        ; Handle UpdateExpression (i++, ++i) and AssignmentExpression (x = 1).
        if (seK == 7) {
            ; `i++;` as a STATEMENT on a slot number: bump in place, no chain
            ; walks and no fresh value object for the new number. Only the
            ; completion (observable through eval alone) still needs a value —
            ; and small counters come out of the interned pool.
            def upHandled:boolean false
            if (false == anyWithScope) {
                if node.left {
                    def upL:TSNode (unwrap node.left)
                    if ((this.nodeKindOf(upL)) == 1) {
                        def upK:int (this.opKindOf(node))
                        if ((upK == 17) || (upK == 18)) {
                            if (context.hasNumberSlot(upL.name)) {
                                def upD:double 1.0
                                if (upK == 18) {
                                    upD = (0.0 - 1.0)
                                }
                                def upOld:double (context.slotNumberOf(upL.name))
                                if (context.setNumberInSlot(upL.name (upOld + upD))) {
                                    if node.prefix {
                                        completionValue = (EvValueBridge.taggedNumber((upOld + upD)))
                                    } {
                                        completionValue = (EvValueBridge.taggedNumber(upOld))
                                    }
                                    upHandled = true
                                }
                            }
                        }
                    }
                }
            }
            if (upHandled == false) {
                completionValue = (this.evaluateAssignValue(node))
            }
            handledSE = true
        }

        if (seK == 6) {
            ; `s += i` as a STATEMENT: the result is discarded, so nothing can
            ; alias it and the slot may be written in place. The same shape in
            ; value position (`a = (s += 1)`) hands the object to a second name
            ; and must keep minting -- which is why this lives at the statement
            ; call site rather than inside evaluateAssignValue.
            if (this.assignNumberInSlot(node)) {
                ; The completion value is the STORED value, and the slot object
                ; is it -- read back rather than minted, so the statement stays
                ; allocation-free. Only `eval` ever observes this, and a body
                ; that mentions `eval` has no slots to begin with.
                def seLhs:TSNode (unwrap node.left)
                def seNm:string seLhs.name
                completionValue = (this.lookupIdentifier(seNm))
                handledSE = true
            } {
                ; `s += "…"` on a slot STRING appends in place — the step that
                ; turns the concat loop linear on the mutable-string targets.
                if (this.assignStringInSlot(node)) {
                    def seLhsS:TSNode (unwrap node.left)
                    completionValue = (this.lookupIdentifier(seLhsS.name))
                    handledSE = true
                } {
                    completionValue = (this.evaluateAssignValue(node))
                    handledSE = true
                }
            }
        }

        ; Statement-position unary with a side effect (delete obj.x, void expr).
        if (seK == 12) {
            completionValue = (this.evaluateUnaryExpr(node))
            handledSE = true
        }

        ; D-ERRORS: a bare reference in statement position still resolves, and an
        ; unresolvable one throws. `nope;` on its own line is a ReferenceError.
        if (seK == 1) {
            completionValue = (this.lookupIdentifier(node.name))
            handledSE = true
        }
        if (seK == 3) {
            completionValue = (this.evaluateMemberExpr(node))
            handledSE = true
        }
        ; Everything else is evaluated too. The list above was exhaustive by
        ; accident rather than by design, so `new F();` in statement position
        ; ran NOTHING -- neither the constructor's effects nor an error raised
        ; inside it, which simply vanished instead of being thrown.
        ; The flag belongs to the chain that just finished; nothing outside it
        ; may observe it.
        optChainAborted = false
        if (false == handledSE) {
            completionValue = (this.evaluateExpr(node))
        }
    }
    
    ; Evaluates a call expression for side effects (e.g., arr.push(x), placeShip(...))
    fn evaluateCallExprForSideEffect:void (node:TSNode) {
        ; Check if it's a method call: arr.push(x)
        if node.left {
            def calleeNode:TSNode (unwrap node.left)
            if ((this.nodeKindOf(calleeNode)) == 3) {
                def methodName:string calleeNode.name
                
                ; Get the object being called on
                if calleeNode.left {
                    def objNode:TSNode (unwrap calleeNode.left)
                    if ((this.nodeKindOf(objNode)) == 1) {
                        def objName:string objNode.name
                        def objValue:EvHandle (context.lookup(objName))
                        
                        ; Array.push()
                        if ((methodName == "push") && (objValue.isArrayValue())) {
                            ; Get arguments from node.children
                            if ((array_length node.children) > 0) {
                                def argNode:TSNode (itemAt node.children 0)
                                def argValue:EvHandle (this.evaluateExpr(argNode))
                                ; Mutate the array by adding the item
                                objValue.arrPush(argValue)
                                ; Update the context (in case of reassignment)
                                context.assign(objName objValue)
                            }
                            return
                        }
                    }
                }
            }
        }
        ; Plain function-call statements (helpers that mutate objects passed in).
        this.evaluateCallExpr(node)
    }
    
    ; ==========================================================================
    ; For Loop Evaluation
    ; ==========================================================================
    
    ; Evaluates a for statement: for (init; test; update) body
    ; Returns EvElement with hasReturn flag set if a return was executed
    fn evaluateForStatement:EvElement (node:TSNode) {
        def result (new EvElement())
        result.hasReturn = false
        
        this.trace("evaluateForStatement called")
        
        ; Process init (usually VariableDeclaration)
        if node.init {
            def initNode:TSNode (unwrap node.init)
            this.trace("For init nodeType: " + initNode.nodeType)
            if ((this.nodeKindOf(initNode)) == 31) {
                this.processVariableDeclaration(initNode)
            } {
                def ignoredInitE:EvHandle (this.evaluateExpr(initNode))
            }
        }
        
        ; Loop with test (node.left) and update (node.right)
        def maxIterations:int maxLoopIterations
        def iterations:int 0
        
        while (iterations < maxIterations) {
            ; Evaluate test condition (node.left)
            if node.left {
                def testNode:TSNode (unwrap node.left)
                def testResult:EvHandle (this.evaluateExpr(testNode))
                if ((testResult.toBool()) == false) {
                    ; Condition is false, exit loop
                    return result
                }
            }
            
            ; Execute body
            if node.body {
                def bodyNode:TSNode (unwrap node.body)
                def bodyResult:EvElement (this.evaluateStatementBlock(bodyNode))
                if bodyResult.hasReturn {
                    return bodyResult
                }
                if bodyResult.hasBreak {
                    return result
                }
                if bodyResult.hasContinue {
                    if node.right {
                        def updateNode:TSNode (unwrap node.right)
                        this.evaluateUpdateExpr(updateNode)
                    }
                    iterations = iterations + 1
                } {
                    ; Execute update (node.right)
                    if node.right {
                        def updateNode:TSNode (unwrap node.right)
                        this.evaluateUpdateExpr(updateNode)
                    }
                    
                    iterations = iterations + 1
                }
            } {
                iterations = iterations + 1
            }
        }
        
        return result
    }
    
    ; Evaluates a for...of statement: for (const x of array) body
    ; Returns EvElement with hasReturn flag set if a return was executed
    fn evaluateForOfStatement:EvElement (node:TSNode) {
        def result (new EvElement())
        result.hasReturn = false
        
        ; Get variable name from node.left (VariableDeclaration)
        def varName:string ""
        if node.left {
            def leftNode:TSNode (unwrap node.left)
            if ((this.nodeKindOf(leftNode)) == 31) {
                if ((array_length leftNode.children) > 0) {
                    def decl:TSNode (itemAt leftNode.children 0)
                    varName = decl.name
                }
            }
        }
        
        ; Get the array to iterate (node.right)
        if node.right {
            def rightNode:TSNode (unwrap node.right)
            def arrayValue:EvHandle (this.evaluateExpr(rightNode))
            
            if (arrayValue.isArrayValue()) {
                def i:int 0
                while (i < (arrayValue.denseLen())) {
                    def item:EvHandle (arrayValue.arrayItemAt(i))
                    
                    ; Bind loop variable
                    context.define(varName item)
                    
                    ; Execute body
                    if node.body {
                        def bodyNode:TSNode (unwrap node.body)
                        def bodyResult:EvElement (this.evaluateStatementBlock(bodyNode))
                        if bodyResult.hasReturn {
                            return bodyResult
                        }
                        if bodyResult.hasBreak {
                            return result
                        }
                        if bodyResult.hasContinue {
                            i = i + 1
                        } {
                            i = i + 1
                        }
                    } {
                        i = i + 1
                    }
                }
            }
        }
        
        return result
    }
    
    ; Evaluates a while statement: while (test) body
    ; Returns EvElement with hasReturn flag set if a return was executed
    fn evaluateWhileStatement:EvElement (node:TSNode) {
        def result (new EvElement())
        result.hasReturn = false
        
        def maxIterations:int maxLoopIterations  ; Safety limit
        def iterations:int 0
        
        while (iterations < maxIterations) {
            if node.left {
                def testNode:TSNode (unwrap node.left)
                def testResult:EvHandle (this.evaluateExpr(testNode))
                if ((testResult.toBool()) == false) {
                    return result
                }
            } {
                return result
            }
            
            if node.body {
                def bodyNode:TSNode (unwrap node.body)
                def bodyResult:EvElement (this.evaluateStatementBlock(bodyNode))
                if bodyResult.hasReturn {
                    return bodyResult
                }
                if bodyResult.hasBreak {
                    return result
                }
                if bodyResult.hasContinue {
                    iterations = iterations + 1
                } {
                    iterations = iterations + 1
                }
            } {
                iterations = iterations + 1
            }
        }
        
        return result
    }
    
    ; Integer-exponent power (base ** expn); used by ** and **=.
    ; D-MATH: exp and log, built from a series because the Ranger runtime offers
    ; no intrinsic for either. Both reduce the argument first so the series
    ; converges fast; accuracy is around 1e-15 relative, which is close to but
    ; not identical with the host's, so a test comparing an exact bit pattern
    ; would still see a difference.
    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn expNum:double (x:double) {
        return (RgNum.exp(x))
    }

    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn logNum:double (x:double) {
        return (RgNum.log(x))
    }

    ; Floor toward NEGATIVE infinity. `to_int` truncates toward zero, so it gets
    ; -1.5 wrong -- which is what made Math.floor(-1.5) answer -1, and Math.ceil
    ; and Math.round wrong with it, since all three were built on it.
    ; D-IEEE: -0 is a distinct value and the only way to tell it from +0 is the
    ; sign of 1/x. Ranger has no negative-zero literal, so it is built by
    ; MULTIPLYING zero by -1 -- subtracting from zero gives +0.
    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn isNegZero:boolean (v:double) {
        return (RgNum.isNegZero(v))
    }

    ; NOT delegated to RgNum.negZero, and this one is BROKEN ON PYTHON: the
    ; Python writer emits `def z:double 0.0` as `z = 0`, an int literal, so the
    ; product is integer 0 * -1 = +0 and the sign is gone. RgNum.negZero is
    ; -1/Infinity, which no writer can fold into an int. Delegating fixes it,
    ; and that is a behaviour change on a gated target — it wants its own commit
    ; with the engine conformance suite watched, not a ride along a rename.
    fn negativeZero:double () {
        ; through a VARIABLE, not literals: the C++ writer prints double
        ; literals bare, so `0.0 * (0.0 - 1.0)` became integer 0 * -1 = +0
        ; there. A double binding forces the whole product into f64.
        def z:double 0.0
        return (z * (0.0 - 1.0))
    }

    ; Floor in PURE double arithmetic. The old `to_double (to_int v)`
    ; truncation rides the target's int, and Ranger's int is 32 BITS on the
    ; C++ target -- any |v| >= 2^31 saturated to INT32_MIN there (x86
    ; cvttsd2si), which corrupted every ToInt32/ToUint32 and all date math
    ; built on this floor. Adding and subtracting 2^52 rounds to an integer
    ; in the double domain itself; one compare corrects round-up to floor.
    ; A magnitude at or above 2^52 is already integral.
    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn floorNum:double (v:double) {
        return (RgNum.floorD(v))
    }

    ; Truncation toward zero, same double-domain discipline as floorNum.
    ; NOT delegated to RgNum.trunc. This one does not handle negative zero:
    ; truncNum(-0.5) is `0.0 - (floorNum 0.5)`, which is +0, where RgNum.trunc
    ; answers -0 as the spec requires. Math.trunc does not come through here
    ; (it has its own -0 branch), so switching would change the 19 INTERNAL
    ; callers, each of which needs checking first. Tracked, not forgotten.
    fn truncNum:double (v:double) {
        if (v < 0.0) {
            return (0.0 - (this.floorNum((0.0 - v))))
        }
        return (this.floorNum(v))
    }

    ; Delegates to lib/core. The body moved there verbatim; this stays so the
    ; call sites can migrate separately (PLAN_JS_STDLIB_TEXT.md §3).
    fn isFiniteNum:boolean (v:double) {
        return (RgNum.isFinite(v))
    }

    ; Round a double to the nearest value representable as a float32, which is
    ; what Math.fround answers. Ranger has no float32, so the round trip is done
    ; by hand: normalise the magnitude into [1,2), round the 24-bit mantissa,
    ; then scale back. Infinities, zeroes and NaN pass through untouched, and a
    ; magnitude past the float32 range saturates to Infinity as the spec says.
    ; NOT delegated to RgNum.toFloat32. The two are the same algorithm, but
    ; this one calls the local powNum for its scaling step and RgNum's calls
    ; powInt — see powNum above. Delegating both together or neither.
    fn toFloat32:double (v:double) {
        if (v != v) { return v }
        if (v == 0.0) { return v }
        ; An infinity is already representable and must leave before the
        ; normalising loops: `inf / 2` is still inf, so `while (m >= 2)` would
        ; never terminate.
        if (false == (this.isFiniteNum(v))) { return v }
        def neg:boolean (v < 0.0)
        def m:double v
        if neg { m = (0.0 - v) }
        ; The float32 range check is done on the EXPONENT after normalising,
        ; not against a literal maximum: a 39-digit double literal is emitted as
        ; `3.4028234663852886e+38.0` by the es6 writer, which is not valid
        ; JavaScript. Pinned separately; avoided here.
        ; exponent by repeated scaling -- no frexp intrinsic, and the loop runs
        ; at most ~150 times for the extremes of the double range
        def e:int 0
        while (m >= 2.0) {
            m = (m / 2.0)
            e = (e + 1)
        }
        while (m < 1.0) {
            m = (m * 2.0)
            e = (e - 1)
        }
        ; float32 has a 24-bit significand (1 implicit + 23 stored)
        def scale:double 8388608.0
        def r:double (m * scale)
        ; IEEE rounds the significand ties-to-EVEN, not ties-away. floor(x+0.5)
        ; would be wrong on an exact tie, and exact ties are exactly what a
        ; fround test corpus is made of.
        def fl:double (to_double (floor r))
        def diff:double (r - fl)
        def rounded:double fl
        if (diff > 0.5) {
            rounded = (fl + 1.0)
        }
        if (diff == 0.5) {
            def half:double (fl / 2.0)
            if ((half - (to_double (floor half))) != 0.0) {
                rounded = (fl + 1.0)
            }
        }
        if (rounded >= (scale * 2.0)) {
            rounded = (rounded / 2.0)
            e = (e + 1)
        }
        ; float32 tops out at 2^128 (exponent 127 with a full significand); a
        ; magnitude past it saturates to Infinity, which is what the spec says.
        if (e > 127) {
            def infv:double (1.0 / 0.0)
            if neg { return (0.0 - infv) }
            return infv
        }
        def outv:double (rounded / scale)
        def k:int 0
        if (e > 0) {
            while (k < e) {
                outv = (outv * 2.0)
                k = (k + 1)
            }
        } {
            while (k > e) {
                outv = (outv / 2.0)
                k = (k - 1)
            }
        }
        if neg { return (0.0 - outv) }
        return outv
    }

    ; NOT delegated to RgNum.powInt. Same answer, different arithmetic: this
    ; multiplies `expn` times in a row, RgNum.powInt squares. Both are exact for
    ; a power of two, and they can differ in the last bit for anything else, so
    ; the swap needs the engine conformance suite run against it rather than an
    ; argument that they ought to agree.
    fn powNum:double (base:double expn:int) {
        def acc:double 1.0
        if (expn >= 0) {
            def k:int 0
            while (k < expn) {
                acc = (acc * base)
                k = (k + 1)
            }
            return acc
        }
        def k2:int 0
        def n2:int (0 - expn)
        while (k2 < n2) {
            acc = (acc * base)
            k2 = (k2 + 1)
        }
        if (acc != 0.0) {
            return (1.0 / acc)
        }
        return 0.0
    }

    ; ECMA-262 Number::exponentiate. The exponent is a DOUBLE here: every call
    ; site used to coerce it with ToInt32 first, so a fractional exponent was
    ; simply truncated -- Math.pow(4, 0.5) answered 1 rather than 2, and
    ; RayTrace's shadow term `pow(transparency, 0.5)` turned every shadow into
    ; a wash (the scene checksum came out 2544 against 2321).
    fn jsPow:double (base:double expo:double) {
        def inf:double (1.0 / 0.0)
        def nan:double (0.0 / 0.0)
        ; A NaN exponent poisons the result, but an exponent of ZERO answers 1
        ; even for a NaN base -- both rules come before any test on the base.
        if (expo != expo) { return nan }
        if (expo == 0.0) { return 1.0 }
        if (base != base) { return nan }
        def absBase:double base
        if (absBase < 0.0) { absBase = (0.0 - absBase) }
        ; Is the exponent an integer, and if so is it odd? Only an odd integer
        ; carries the sign of a negative base (or of -0) into the result.
        def expIsInt:boolean ((this.truncNum(expo)) == expo)
        def expIsOdd:boolean false
        if expIsInt {
            def halfE:double (expo / 2.0)
            if ((this.truncNum(halfE)) != halfE) {
                expIsOdd = true
            }
        }
        ; An INFINITE exponent only cares how the base compares to 1.
        if (false == (this.isFiniteNum(expo))) {
            if (absBase == 1.0) { return nan }
            def bigBase:boolean (absBase > 1.0)
            if (expo > 0.0) {
                if bigBase { return inf }
                return 0.0
            }
            if bigBase { return 0.0 }
            return inf
        }
        ; An INFINITE base.
        if (false == (this.isFiniteNum(base))) {
            def negInfBase:boolean (base < 0.0)
            if (expo > 0.0) {
                if (negInfBase && expIsOdd) { return (0.0 - inf) }
                return inf
            }
            if (negInfBase && expIsOdd) { return (this.negativeZero()) }
            return 0.0
        }
        ; A ZERO base. -0 keeps its sign only through an odd exponent, and a
        ; negative exponent divides by it: pow(0, -1) is Infinity, which the
        ; truncating path answered as 0.
        if (base == 0.0) {
            def negZeroBase:boolean ((1.0 / base) < 0.0)
            if (expo > 0.0) {
                if (negZeroBase && expIsOdd) { return (this.negativeZero()) }
                return 0.0
            }
            if (negZeroBase && expIsOdd) { return (0.0 - inf) }
            return inf
        }
        ; A negative base to a fractional power has no real value.
        if ((base < 0.0) && (false == expIsInt)) { return nan }
        ; An INTEGRAL exponent multiplies out exactly -- 2**10 is 1024, where
        ; exp(10*ln2) lands a few ulps off -- and carries a negative base's
        ; sign for free. Bounded so a huge exponent takes the series path
        ; instead of looping billions of times.
        if expIsInt {
            def absE:double expo
            if (absE < 0.0) { absE = (0.0 - absE) }
            if (absE <= 4096.0) {
                return (this.powNum(base (to_int expo)))
            }
        }
        ; sqrt is exact where the series is not: pow(9, 0.5) must be 3, not
        ; 2.9999999999999996.
        if (expo == 0.5) { return (sqrt base) }
        if (expo == (0.0 - 0.5)) { return (1.0 / (sqrt base)) }
        ; Split off the INTEGER part: x**(i+f) = x**i * x**f. The integer half
        ; multiplies out exactly and the remaining |f| < 1 keeps the series
        ; argument small, which is where expNum/logNum are most accurate --
        ; 1.5**2.5 as 1.5**2 * sqrt(1.5) rather than exp(2.5*ln 1.5).
        def ipart:double (this.truncNum(expo))
        def fpart:double (expo - ipart)
        def absI:double ipart
        if (absI < 0.0) { absI = (0.0 - absI) }
        if (absI <= 4096.0) {
            def whole:double (this.powNum(base (to_int ipart)))
            if (fpart == 0.5) {
                return (whole * (sqrt base))
            }
            if (fpart == (0.0 - 0.5)) {
                return (whole / (sqrt base))
            }
            return (whole * (this.expNum((fpart * (this.logNum(base))))))
        }
        return (this.expNum((expo * (this.logNum(base)))))
    }

    ; Wrap a number into a `bits`-wide integer (two's-complement if signed),
    ; matching AssemblyScript's i8/u8/i16/u16/i32/u32 truncation. Computed in
    ; doubles (exact up to 2^53, so u32 fits) via truncate-then-modulo-2^bits.
    fn wrapInt:double (v:double bits:int signed:boolean) {
        def iv:double (this.truncNum(v))
        def m:double (this.powNum(2.0 bits))
        def r:double (iv - (m * (this.truncNum((iv / m)))))
        if (r < 0.0) {
            r = (r + m)
        }
        if signed {
            def half:double (this.powNum(2.0 (bits - 1)))
            if (r >= half) {
                r = (r - m)
            }
        }
        return r
    }

    ; True if `name` is an AssemblyScript sized-numeric type usable as a cast.
    fn isSizedTypeName:boolean (name:string) {
        if (name == "i8") { return true }
        if (name == "u8") { return true }
        if (name == "i16") { return true }
        if (name == "u16") { return true }
        if (name == "i32") { return true }
        if (name == "u32") { return true }
        if (name == "i64") { return true }
        if (name == "u64") { return true }
        if (name == "f32") { return true }
        if (name == "f64") { return true }
        return false
    }

    ; The names the global built-in dispatch chain in evaluateCallExpr tests
    ; one string compare at a time. A pure predicate on the NAME: it decides
    ; only whether the chain COULD match, so a call node whose name misses
    ; every entry is stamped and never walks the chain again -- while a hit
    ; keeps its exact per-call behavior (shadowing checks included).
    fn isGlobalBuiltinCallName:boolean (name:string) {
        if (this.isSizedTypeName(name)) { return true }
        if (name == "Symbol") { return true }
        if (name == "eval") { return true }
        if (name == "Array") { return true }
        if (name == "RegExp") { return true }
        if (name == "Date") { return true }
        if (name == "Object") { return true }
        if (name == "Function") { return true }
        if (name == "parseInt") { return true }
        if (name == "parseFloat") { return true }
        ; annexB B.2.1
        if (name == "escape") { return true }
        if (name == "unescape") { return true }
        if (this.isUriGlobalName(name)) { return true }
        if (name == "Number") { return true }
        if (name == "String") { return true }
        if (name == "Boolean") { return true }
        if (name == "isNaN") { return true }
        if (name == "isFinite") { return true }
        return false
    }

    ; Apply an AS numeric cast (i32(x), u8(x), …) with proper wraparound. i64/u64
    ; truncate to an integer (doubles cannot hold full 64-bit); f32/f64 pass the
    ; value through (no float32 rounding).
    fn castSized:EvHandle (name:string v:double) {
        if (name == "i8") { return (EvValueBridge.taggedNumber((this.wrapInt(v 8 true)))) }
        if (name == "u8") { return (EvValueBridge.taggedNumber((this.wrapInt(v 8 false)))) }
        if (name == "i16") { return (EvValueBridge.taggedNumber((this.wrapInt(v 16 true)))) }
        if (name == "u16") { return (EvValueBridge.taggedNumber((this.wrapInt(v 16 false)))) }
        if (name == "i32") { return (EvValueBridge.taggedNumber((this.wrapInt(v 32 true)))) }
        if (name == "u32") { return (EvValueBridge.taggedNumber((this.wrapInt(v 32 false)))) }
        if (name == "i64") { return (EvValueBridge.taggedNumber((to_double (to_int v)))) }
        if (name == "u64") { return (EvValueBridge.taggedNumber((to_double (to_int v)))) }
        return (EvValueBridge.taggedNumber(v))
    }

    ; For `expr as T` / `<T>expr`: if T (on node.typeAnnotation) is a sized-int
    ; type, truncate; otherwise return the value unchanged (types are erased).
    fn applyTypeCast:EvHandle (node:TSNode value:EvHandle) {
        if node.typeAnnotation {
            def tNode:TSNode (unwrap node.typeAnnotation)
            def tn:string tNode.name
            if ((strlen tn) == 0) {
                tn = tNode.value
            }
            if (this.isSizedTypeName(tn)) {
                return (this.castSized(tn (value.toNumber())))
            }
        }
        return value
    }

    ; Compute the result of a (compound) assignment operator given the current
    ; LHS value and the RHS value. Handles all of = += -= *= /= %= **= and the
    ; bitwise (& | ^ << >> >>>) and logical (&& || ??) compound forms.
    ; The floating-point remainder, with the sign of the dividend.
    fn evaluateRemainder:EvHandle (a:double b:double) {
        if (a != a) { return (EvValueBridge.taggedNumber(a)) }
        if (b != b) { return (EvValueBridge.taggedNumber(b)) }
        if (b == 0.0) { return (EvValueBridge.taggedNumber((0.0 / 0.0))) }
        if (false == (this.isFiniteNum(a))) { return (EvValueBridge.taggedNumber((0.0 / 0.0))) }
        if (false == (this.isFiniteNum(b))) { return (EvValueBridge.taggedNumber(a)) }
        def q:double (a / b)
        def qi:double (this.floorNum(q))
        if (q < 0.0) {
            qi = (0.0 - (this.floorNum((0.0 - q))))
        }
        def rem:double (a - (qi * b))
        ; The remainder takes the sign of the DIVIDEND, and that includes zero:
        ; -1 % -1 is -0, not +0. Subtraction produces +0 for both, so the sign
        ; is put back by multiplying.
        if (rem == 0.0) {
            def negOneD:double (0.0 - 1.0)
            if (a < 0.0) {
                return (EvValueBridge.taggedNumber((0.0 * negOneD)))
            }
            def aRecip:double (1.0 / a)
            if (aRecip < 0.0) {
                return (EvValueBridge.taggedNumber((0.0 * negOneD)))
            }
            return (EvValueBridge.taggedNumber(0.0))
        }
        return (EvValueBridge.taggedNumber(rem))
    }

    fn applyAssignOp:EvHandle (opK:int current:EvHandle rightValue:EvHandle) {
        if (opK == 1) {
            return rightValue
        }
        ; D-BIGINT: a compound assignment is its operator, so `f *= i` on two
        ; BigInts must multiply them rather than convert to numbers. The
        ; assignment op codes are their own numbering, so they are mapped onto
        ; the binary ones and the same implementation runs.
        if ((current.isObject()) || (rightValue.isObject())) {
            if ((this.isBigIntValue(current)) || (this.isBigIntValue(rightValue))) {
                def binK:int 0
                if (opK == 2) { binK = 20 }
                if (opK == 3) { binK = 21 }
                if (opK == 4) { binK = 22 }
                if (opK == 5) { binK = 23 }
                if (opK == 6) { binK = 24 }
                if (opK == 7) { binK = 25 }
                if (opK == 11) { binK = 37 }
                if (opK == 12) { binK = 38 }
                if (opK == 13) { binK = 39 }
                if (opK == 8) { binK = 40 }
                if (opK == 9) { binK = 41 }
                if (opK == 10) { binK = 42 }
                if (binK > 0) {
                    def bigOut:EvHandle (this.bigIntBinaryOp(binK current rightValue))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    if (false == (bigOut.isNull())) {
                        return bigOut
                    }
                }
            }
        }
        if (opK == 2) {
            ; PERF fast path, mirroring `+`: plain strings and plain numbers
            ; skip the conversion dance (each toStringOf copies on natives).
            if ((current.isString()) && (rightValue.isString())) {
                return (EvValueBridge.taggedString((current.stringOf()) + (rightValue.stringOf())))
            }
            if ((current.isNumber()) && (rightValue.isNumber())) {
                return (EvValueBridge.taggedNumber(current.numberValue + rightValue.numberValue))
            }
            ; Same rule as `+`: BOTH operands convert first, and only then does
            ; the string-vs-numeric decision get made. Testing isString() on the
            ; raw values missed a boxed string entirely, so
            ; `x = new String("1"); x += 1` gave 2 instead of "11".
            def lp:EvHandle (this.toPrimitiveDefault(current))
            def rp:EvHandle (this.toPrimitiveDefault(rightValue))
            if ((lp.isString()) || (rp.isString())) {
                return (EvValueBridge.taggedString((this.toStringOf(lp)) + (this.toStringOf(rp))))
            }
            return (EvValueBridge.taggedNumber((this.toNumberOf(lp)) + (this.toNumberOf(rp))))
        }
        if (opK == 3) {
            return (EvValueBridge.taggedNumber((this.toNumberOf(current)) - (this.toNumberOf(rightValue))))
        }
        if (opK == 4) {
            return (EvValueBridge.taggedNumber((this.toNumberOf(current)) * (this.toNumberOf(rightValue))))
        }
        if (opK == 5) {
            ; Division by zero is an INFINITY, not a no-op. Returning `current`
            ; left the variable untouched, so `x = 1; x /= null` stayed 1.
            def rn:double (this.toNumberOf(rightValue))
            def ln:double (this.toNumberOf(current))
            if (rn == 0.0) {
                if (ln != ln) { return (EvValueBridge.taggedNumber(ln)) }
                if (ln == 0.0) { return (EvValueBridge.taggedNumber((0.0 / 0.0))) }
                def infD:double (1.0 / 0.0)
                def negD:boolean (ln < 0.0)
                if negD {
                    return (EvValueBridge.taggedNumber((0.0 - infD)))
                }
                return (EvValueBridge.taggedNumber(infD))
            }
            return (EvValueBridge.taggedNumber((ln / rn)))
        }
        if (opK == 6) {
            ; The floating remainder, same as the `%` operator -- the integer
            ; version threw away the fraction.
            return (this.evaluateRemainder((this.toNumberOf(current)) (this.toNumberOf(rightValue))))
        }
        if (opK == 7) {
            return (EvValueBridge.taggedNumber((this.jsPow((this.toNumberOf(current)) (this.toNumberOf(rightValue))))))
        }
        if (opK == 11) {
            return (EvHandle.fromInt((bit_and (this.toInt32Of(current)) (this.toInt32Of(rightValue)))))
        }
        if (opK == 12) {
            return (EvHandle.fromInt((bit_or (this.toInt32Of(current)) (this.toInt32Of(rightValue)))))
        }
        if (opK == 13) {
            return (EvHandle.fromInt((bit_xor (this.toInt32Of(current)) (this.toInt32Of(rightValue)))))
        }
        if (opK == 8) {
            ; The operands are read into locals before the int32Wrap call
            ; because Rust cannot borrow `self` mutably for `toInt32Of` inside
            ; the arguments of a call that already borrows it immutably
            ; (E0502). Every other shift arm here already reads into locals or
            ; calls no method of `this`, so this was the one that broke rustc.
            def shl8L:int (this.toInt32Of(current))
            def shl8R:int (this.toInt32Of(rightValue))
            return (EvHandle.fromInt((this.int32Wrap((bit_shl shl8L (bit_and shl8R 31))))))
        }
        if (opK == 9) {
            return (EvHandle.fromInt((bit_shr (this.toInt32Of(current)) (bit_and (this.toInt32Of(rightValue)) 31))))
        }
        if (opK == 10) {
            return (this.ushr32Of(current rightValue))
        }
        if (opK == 14) {
            if (current.toBool()) {
                return rightValue
            }
            return current
        }
        if (opK == 15) {
            if (current.toBool()) {
                return current
            }
            return rightValue
        }
        if (opK == 16) {
            ; nullish: assign when the current value is null OR undefined
            ; (a missing member now reads as undefined — D-IDENTITY rule 6).
            if ((current.isNull()) || (current.isUndefined())) {
                return rightValue
            }
            return current
        }
        return rightValue
    }

    ; Apply a (compound) assignment to a member/index target (o.x, o["k"], a[i]),
    ; returning the assigned value. Read-modify-write for the compound forms.
    ; D-EVALORDER: the plain entry point. The RESOLVED form below takes a base
    ; and a key that have already been evaluated, which is what a compound
    ; assignment needs: `a[i()] += f()` must evaluate the base and the index
    ; ONCE, and before the right-hand side, not again afterwards.
    fn assignMember:EvHandle (leftNode:TSNode opK:int rightValue:EvHandle) {
        return (this.assignMemberResolved(leftNode opK rightValue (EvValueBridge.taggedNull()) false "" false))
    }

    fn assignMemberResolved:EvHandle (leftNode:TSNode opK:int rightValue:EvHandle baseIn:EvHandle hasBase:boolean keyIn:string hasKey:boolean) {
        def obj:EvHandle (EvValueBridge.taggedNull())
        def objName:string ""
        if hasBase {
            obj = baseIn
        }
        if ((false == hasBase) && leftNode.left) {
            def objNode:TSNode (unwrap leftNode.left)
            ; D-SUPER: `super.x = v` writes to the RECEIVER, not to the home
            ; object's prototype -- the prototype only decides whether a setter
            ; up there takes the write instead. So the target is `this`. It used
            ; to evaluate `super` as a value, which is nothing, and the write
            ; landed on null.
            if (objNode.nodeType == "Super") {
                obj = (context.lookup("this"))
            } {
                if ((this.nodeKindOf(objNode)) == 1) {
                    objName = objNode.name
                    ; D-GLOBALOBJ: resolve through lookupIdentifier, not the raw
                    ; scope, so a write to a built-in global (`Math.value = 1`)
                    ; lands on the real object instead of vanishing.
                    obj = (this.lookupIdentifier(objName))
                } {
                    obj = (this.evaluateExpr(objNode))
                }
            }
        }
        ; A throw from resolving the BASE -- an undeclared name is a
        ; ReferenceError -- escapes as itself rather than being replaced by the
        ; TypeError below.
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        ; Writing a property of null or undefined is a TypeError, in either
        ; mode. It was silently dropped, so a test that expected the throw saw
        ; nothing happen at all.
        if strictReferences {
            if ((obj.isNull()) || (obj.isUndefined())) {
                def baseDesc:string "undefined"
                if (obj.isNull()) { baseDesc = "null" }
                def wname:string leftNode.name
                if ((strlen wname) == 0) { wname = "property" }
                return (this.throwSpecError("TypeError" ("Cannot set properties of " + (baseDesc + (" (setting '" + (wname + "')"))))))
            }
        }
        ; D-STRICT: a property write through a PRIMITIVE receiver goes to a
        ; throwaway wrapper, so it can never be observed -- which is a refused
        ; write, and strict mode reports one. `"ab"[0] = "z"` and `(5).x = 1`
        ; both dropped silently in either mode.
        if strictMode {
            def primRecv:boolean false
            if (obj.isString()) { primRecv = true }
            if (obj.isNumber()) { primRecv = true }
            if (obj.isBoolean()) { primRecv = true }
            if primRecv {
                return (this.throwSpecError("TypeError" ("Cannot create property '" + (leftNode.name + "' on " + ((this.typeofTag(obj)) + " value")))))
            }
        }
        ; annexB B.2.2.1: writing `o.__proto__` IS [[SetPrototypeOf]]. Only an
        ; object or null does anything; anything else is ignored rather than
        ; stored as a property.
        if (leftNode.name == "__proto__") {
            if (false == leftNode.computed) {
                if ((obj.isNull()) || (obj.isUndefined())) {
                    return (this.throwSpecError("TypeError" "Cannot convert undefined or null to object"))
                }
                if (this.isDescriptorObject(obj)) {
                    ; §9.1.2 [[SetPrototypeOf]]: a NON-EXTENSIBLE object refuses
                    ; the change. It was applied regardless, so
                    ; `Object.preventExtensions(o).__proto__ = p` mutated a
                    ; prototype the object had been sealed against.
                    def protoChanging:boolean false
                    if (rightValue.isObject()) { protoChanging = true }
                    if (rightValue.isNull()) { protoChanging = true }
                    if protoChanging {
                        if (false == (obj.isExtensible())) {
                            if strictMode {
                                return (this.throwSpecError("TypeError" "#<Object> is not extensible"))
                            }
                            return rightValue
                        }
                        obj.setProto(rightValue)
                    }
                }
                return rightValue
            }
        }
        ; D-PROXY: a write to a proxy is the `set` trap, whichever form it took.
        if (this.isProxyValue(obj)) {
            def pwKey:string leftNode.name
            if leftNode.computed {
                if leftNode.right {
                    def pwKv:EvHandle (this.evaluateExpr((unwrap leftNode.right)))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    pwKey = (this.toPropertyKey(pwKv))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                }
            }
            def pwVal:EvHandle rightValue
            if (opK != 1) {
                def pwCur:EvHandle (this.getPropertyValue(obj pwKey))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                pwVal = (this.applyAssignOp(opK pwCur rightValue))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
            }
            this.bcPutField(obj pwKey pwVal)
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            return pwVal
        }
        def result:EvHandle rightValue
        ; A COMPUTED key differs from a written one only in how the name is
        ; obtained -- `o["bar"] = 1` is the same write `o.bar = 1` is, setter and
        ; all. It used to have a shortcut of its own that stored a data property
        ; directly, so an accessor was silently shadowed, a refused write in
        ; strict mode passed unreported, and the poisoned `caller`/`arguments`
        ; rule did not apply. Only a numeric index into a real ARRAY still takes
        ; the element path; on a plain object a numeric key is the property named
        ; by ToString(index).
        def key:string leftNode.name
        def numericIndexes:boolean false
        def numIdx:int 0
        if hasKey {
            key = keyIn
        }
        if ((false == hasKey) && leftNode.computed) {
            if leftNode.right {
                def indexVal:EvHandle (this.evaluateExpr((unwrap leftNode.right)))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                key = (this.toPropertyKey(indexVal))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
            }
        }
        ; D-ARGMAP: a write to a mapped index writes the PARAMETER, so the body
        ; sees it under the parameter's name from then on. The object kept it as
        ; an ordinary property and the two drifted apart.
        def wMapped:string (this.argMapName(obj key))
        if ((strlen wMapped) > 0) {
            def wMapCtx:EvalContext (this.argMapScopeOf(obj))
            if (wMapCtx.has(wMapped)) {
                def curMapped:EvHandle (wMapCtx.lookup(wMapped))
                def mappedRes:EvHandle (this.applyAssignOp(opK curMapped rightValue))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                wMapCtx.assign(wMapped mappedRes)
                obj.setMember(key mappedRes)
                return mappedRes
            }
        }
        ; D-ARRAYSPARSE: whether this key names an ELEMENT is decided by the key
        ; text, not by whether the expression happened to be a number. `x["0"]`
        ; is the element and `x[-1]` is a property, and routing on the operand's
        ; type got both of those backwards.
        def numIdxD:double (0.0 - 1.0)
        if (obj.isArrayValue()) {
            ; D lane: an index up to 2^32-2 is canonical, and only a double
            ; carries it on the C++ target.
            def ai0:double (this.canonicalArrayIndexD(key))
            if (ai0 >= 0.0) {
                numericIndexes = true
                numIdxD = ai0
                if (ai0 <= 10000000.0) {
                    numIdx = (to_int ai0)
                }
            }
        }
        ; An ELEMENT defined as an accessor takes the write through its setter,
        ; exactly as a named accessor does.
        if numericIndexes {
            if (obj.hasOwnSetter(key)) {
                numericIndexes = false
            }
            if (obj.hasOwnGetter(key)) {
                numericIndexes = false
            }
        }
        if numericIndexes {
            ; A frozen or non-extensible array refuses an element write exactly
            ; as an object refuses a property write. The check lived only on the
            ; named-property branch below, so every index write skipped it.
            def eErr:string (this.writeRefusalError(obj key))
            if ((strlen eErr) > 0) {
                if strictMode {
                    return (this.throwSpecError("TypeError" eErr))
                }
                return (this.applyAssignOp(opK (obj.getIndex(numIdx)) rightValue))
            }
            ; D-ARRAYSPARSE: the backing store is DENSE, so an index far past the
            ; end cannot be materialised -- `x[2147483648] = 1` asked the host for
            ; two billion slots and took the process down with "Invalid array
            ; length". Such an index is stored as an ordinary property instead,
            ; which keeps the value readable and cannot crash. What it does not do
            ; is move `length`, and that is the documented limit of the model.
            if (numIdxD > 10000000.0) {
                def farKey:string (this.toPropertyKey((EvHandle.number(numIdxD))))
                def farCur:EvHandle (obj.getMember(farKey))
                result = (this.applyAssignOp(opK farCur rightValue))
                obj.setMember(farKey result)
                ; The element is past the dense store, but it still moves the
                ; length -- `a[2147483648] = 1` makes a.length 2147483649.
                if ((numIdxD + 1.0) > (obj.arrayLengthD())) {
                    obj.setDeclaredLengthD((numIdxD + 1.0))
                }
            } {
                def curIdx:EvHandle (obj.getIndex(numIdx))
                result = (this.applyAssignOp(opK curIdx rightValue))
                ; A TYPED array coerces on every write, not only at
                ; construction: `a[0] = 300` on an Int8Array stores 44.
                def taIdxKind:string (this.typedArrayBrandOf(obj))
                def taIdxBig:boolean false
                if ((strlen taIdxKind) > 0) {
                    if (this.isBigTypedArrayKind(taIdxKind)) {
                        taIdxBig = true
                        result = (this.bigElementFor(taIdxKind result))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                    } {
                        def tiv:double (this.toNumberOf(result))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                        result = (EvValueBridge.taggedNumber((this.typedArrayCoerce(taIdxKind tiv))))
                    }
                }
                obj.setIndexAt(numIdx result)
                ; D-VIEWS: a view over a buffer writes THROUGH to the bytes, and
                ; every other view over that buffer sees it.
                if (this.isBufferBackedView(obj)) {
                    if taIdxBig {
                        def bigWv:BigNum (this.bigNumOf(result))
                        this.writeThroughViewBig(obj numIdx bigWv)
                    } {
                        this.writeThroughView(obj numIdx (result.toNumber()))
                    }
                }
            }
        } {
            ; D-ARRAYLEN: writing an array's `length` RESIZES it -- truncating
            ; drops the elements beyond the new end, growing adds holes -- and a
            ; value that is not a uint32 is a RangeError. It used to be stored as
            ; an ordinary property and ignored, so `x.length = 0` left the array
            ; untouched and every assertion about it read the old contents.
            if (obj.isArrayValue()) {
                if (key == "length") {
                    ; A non-writable `length` refuses the write -- silently in
                    ; sloppy mode, as a TypeError in strict. The resize ran
                    ; regardless, so `defineProperty(a,"length",{writable:false});
                    ; a.length = 5` moved it anyway.
                    if (obj.hasOwnAttrs("length")) {
                        if (false == (obj.isWritable("length"))) {
                            if strictMode {
                                return (this.throwSpecError("TypeError" "Cannot assign to read only property 'length'"))
                            }
                            return rightValue
                        }
                    }
                    def lenCur:EvHandle (EvHandle.number((obj.arrayLengthD())))
                    def lenWant:EvHandle (this.applyAssignOp(opK lenCur rightValue))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    def lenNum:double (this.toNumberOf(lenWant))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    ; ToUint32, which truncates toward zero before wrapping --
                    ; `x.length = 1.5` must be a RangeError, and wrapping alone
                    ; would have let 1.5 through unchanged.
                    def lenTrunc:double (this.floorNum(lenNum))
                    if (lenNum < 0.0) {
                        lenTrunc = (0.0 - (this.floorNum((0.0 - lenNum))))
                    }
                    def lenU:double (this.wrapUint32(lenTrunc))
                    if (lenU != lenNum) {
                        return (this.throwSpecError("RangeError" "Invalid array length"))
                    }
                    ; D-ARRAYSPARSE: beyond the dense cap only the DECLARED
                    ; length moves -- the spec allows a length of 2^32-1 with no
                    ; elements, which no dense container can materialise.
                    this.setArrayLength(obj lenU)
                    return lenWant
                }
            }
            ; D-ACCESSORS: a setter takes the write instead of storing a data
            ; property. Without this the setter would be shadowed by a plain
            ; value and never run again.
            def sFn:EvHandle (this.resolveSetterOn(obj key))
            if (sFn.isFunction()) {
                ; D-ARGUMENTS: a setter may be a BUILT-IN with no function node.
                ; Only node-backed ones ran, so a poisoned accessor took the
                ; write silently instead of throwing.
                if (sFn.isBuiltinMethod()) {
                    def poisonArgs:[EvHandle]
                    push poisonArgs rightValue
                    return (this.invokeBuiltin((sFn.builtinKindOf()) (sFn.builtinNameOf()) obj poisonArgs))
                }
                if (sFn.hasFunctionNode()) {
                    def cur0:EvHandle (EvValueBridge.taggedUndefined())
                    ; Only a COMPOUND assignment reads the target first. For a
                    ; plain `=` applyAssignOp just answers the right-hand side,
                    ; so calling the getter was pointless -- and OBSERVABLE:
                    ; `o.x = 5` ran the getter once where the spec runs it not
                    ; at all, and `o.x += 5` ran it twice (the caller has
                    ; already read the target into preCurrent and passes the
                    ; combined value down with opK 1).
                    if (opK != 1) {
                        def gFn0:EvHandle (this.resolveGetterOn(obj key))
                        if (gFn0.isFunction()) {
                            if (gFn0.hasFunctionNode()) {
                                def noArgs0:[EvHandle]
                                def gb0:EvHandle (gFn0.withThisForCall(obj))
                                cur0 = (this.callFnValueWithValues(gb0 noArgs0))
                            }
                        }
                    }
                    result = (this.applyAssignOp(opK cur0 rightValue))
                    def sArgs:[EvHandle]
                    push sArgs result
                    def sBound:EvHandle (sFn.withThisForCall(obj))
                    def _sr:EvHandle (this.callFnValueWithValues(sBound sArgs))
                    return result
                }
            }
            ; D-STRICT: writing `caller` or `arguments` on a strict function is
            ; the same TypeError reading them is.
            if (obj.isFunction()) {
                if ((key == "caller") || (key == "arguments")) {
                    if (this.functionIsStrict(obj)) {
                        return (this.throwSpecError("TypeError" ("'" + key + "' may not be assigned on a strict function")))
                    }
                }
            }
            def cur:EvHandle (obj.getMember(key))
            result = (this.applyAssignOp(opK cur rightValue))
            ; A TYPED array coerces on every write, not only at construction:
            ; `a[0] = 300` on an Int8Array stores 44.
            def taKind:string (this.typedArrayBrandOf(obj))
            if ((strlen taKind) > 0) {
                if (this.isArrayIndexKey(key)) {
                    if (this.isBigTypedArrayKind(taKind)) {
                        result = (this.bigElementFor(taKind result))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                    } {
                        def tcv:double (this.toNumberOf(result))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                        result = (EvValueBridge.taggedNumber((this.typedArrayCoerce(taKind tcv))))
                    }
                }
            }
            ; D-STRICT: sloppy mode drops a refused write on the floor; strict
            ; mode reports it. This is the single most-tested strict-mode rule
            ; in the suite -- assigning to a non-writable property, to a frozen
            ; object, or adding one to a non-extensible object. Sloppy mode has
            ; to consult it too: "drops on the floor" means the write does not
            ; happen, not that it happens quietly.
            def wErr:string (this.writeRefusalError(obj key))
            if ((strlen wErr) > 0) {
                if strictMode {
                    return (this.throwSpecError("TypeError" wErr))
                }
                return result
            }
            obj.setMember(key result)
            if ((strlen taKind) > 0) {
                if (this.isArrayIndexKey(key)) {
                    if (this.isBufferBackedView(obj)) {
                        if (this.isBigTypedArrayKind(taKind)) {
                            def bigKi:int (to_int (this.stringToNumber(key)))
                            def bigWv2:BigNum (this.bigNumOf(result))
                            this.writeThroughViewBig(obj bigKi bigWv2)
                        } {
                            this.writeThroughView(obj (to_int (this.stringToNumber(key))) (result.toNumber()))
                        }
                    }
                }
            }
            this.syncGlobalObjectWrite(obj key result)
        }
        if ((strlen objName) > 0) {
            context.assign(objName obj)
        }
        return result
    }

    ; D-GLOBALTHIS: a script's `var` and the global object property of the same
    ; name are ONE storage location, so `this.x = 1` has to be what a bare `x`
    ; reads. syncGlobalVar carries the binding->property direction; this is the
    ; other one, which was missing entirely -- a write through `this` updated
    ; the property and left the binding on its old value.
    fn syncGlobalObjectWrite:void (obj:EvHandle key:string value:EvHandle) {
        if (false == (this.isGlobalVarName(key))) {
            return
        }
        def g:EvHandle (this.theGlobalObject())
        if (false == (g.equals(obj))) {
            return
        }
        if (false == (context.has(key))) {
            return
        }
        def owner:EvalContext (context.contextOwning(key))
        if (false == owner.isGlobalScope) {
            return
        }
        owner.define(key value)
    }

    ; D-GLOBALTHIS: deleting a CONFIGURABLE global object property -- one an
    ; implicit assignment created -- removes the binding with it, since they are
    ; the same location. The property went and the name stayed resolvable, so
    ; `delete this.x` reported true and `typeof x` still answered its type.
    fn syncGlobalObjectDelete:void (obj:EvHandle key:string) {
        def g:EvHandle (this.theGlobalObject())
        if (false == (g.equals(obj))) {
            return
        }
        if (false == (context.has(key))) {
            return
        }
        def owner:EvalContext (context.contextOwning(key))
        if (false == owner.isGlobalScope) {
            return
        }
        def _removed:boolean (owner.removeBinding(key))
    }

    ; Evaluate an UpdateExpression (i++, --i, a[i]++, o.x--) and RETURN its value
    ; (postfix yields the pre-value, prefix the post-value), applying the mutation.
    fn evaluateUpdateValue:EvHandle (node:TSNode) {
        def op:string node.value
        def opK:int (this.opKindOf(node))
        def delta:double 1.0
        if (opK == 18) {
            delta = (0.0 - 1.0)
        }
        if node.left {
            def leftNode:TSNode (unwrap node.left)
            if ((this.nodeKindOf(leftNode)) == 1) {
                def varName:string leftNode.name
                ; PERF fast path: a plain number binding bumps in ONE scope
                ; walk — the general path below walks the chain up to four
                ; times per i++ (with-host probe, has, read, assign).
                if (false == anyWithScope) {
                    def bumped@(optional):EvHandle (context.bumpNumberOld(varName delta))
                    if bumped {
                        def oldB:EvHandle (unwrap bumped)
                        if node.prefix {
                            return (EvValueBridge.taggedNumber((oldB.numberValue + delta)))
                        }
                        return oldB
                    }
                }
                ; D-WITH: ++ and -- go through the with object too, accessors
                ; included, and the base is fixed before the getter runs -- a
                ; getter that deletes itself still has the new value written
                ; onto the object it came from.
                def uw:EvHandle (this.withHostFor(varName))
                if (uw.isObject()) {
                    def ucur:EvHandle (EvValueBridge.taggedUndefined())
                    if (uw.hasOwnGetter(varName)) {
                        def ugf:EvHandle (uw.findGetter(varName 0))
                        if (ugf.isFunction()) {
                            def ugArgs:[EvHandle]
                            ucur = (this.callFnValueWithValues((ugf.withThisForCall(uw)) ugArgs))
                        }
                    } {
                        if (uw.hasOwnData(varName)) {
                            ucur = (uw.getOwnData(varName))
                        }
                    }
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    def uold:double (this.toNumberOf(ucur))
                    def unew:EvHandle (EvValueBridge.taggedNumber((uold + delta)))
                    def usf:EvHandle (uw.findSetter(varName 0))
                    if (usf.isFunction()) {
                        def usArgs:[EvHandle]
                        push usArgs unew
                        def _us:EvHandle (this.callFnValueWithValues((usf.withThisForCall(uw)) usArgs))
                    } {
                        if (false == (uw.hasOwnGetter(varName))) {
                            uw.setMember(varName unew)
                        }
                    }
                    if node.prefix {
                        return unew
                    }
                    return (EvValueBridge.taggedNumber(uold))
                }
                ; ++ and -- READ the target, so an undeclared name is a
                ; ReferenceError rather than a silent NaN.
                ; D-GLOBALTHIS: a name created as a PROPERTY of the global object
                ; -- `this.count = 0` at top level -- is a global binding, and
                ; reading the scope alone said it did not exist.
                def gObjU:EvHandle (this.theGlobalObject())
                def onGlobalU:boolean false
                if (gObjU.isObject()) {
                    onGlobalU = (gObjU.hasOwnData(varName))
                }
                if (false == (context.has(varName))) {
                    if (false == onGlobalU) {
                        if (false == (this.isEngineGlobalName(varName))) {
                            return (this.throwSpecError("ReferenceError" (varName + " is not defined")))
                        }
                    }
                }
                ; ToNumber, so an object operand runs its own valueOf. The value
                ; comes through the same resolver a plain read uses, so a
                ; global-object property is found the same way.
                ; D-BIGINT: `i++` on a BigInt stays a BigInt. Going through
                ; ToNumber made it a TypeError, so a `for (var i = 0n; ...; i++)`
                ; loop could not run at all.
                def curU:EvHandle (this.lookupIdentifier(varName))
                if (this.isBigIntValue(curU)) {
                    def stepU:BigNum (BigNum.fromInt(1))
                    def curBig:BigNum (this.bigNumOf(curU))
                    def nextBig:BigNum (curBig.add(stepU))
                    if (opK == 18) {
                        nextBig = (curBig.sub(stepU))
                    }
                    def nextU:EvHandle (this.makeBigIntValue(nextBig))
                    if (context.has(varName)) {
                        context.assign(varName nextU)
                        this.syncGlobalVar(varName nextU)
                    } {
                        if onGlobalU {
                            gObjU.setMember(varName nextU)
                        } {
                            context.assign(varName nextU)
                        }
                    }
                    if node.prefix {
                        return nextU
                    }
                    return curU
                }
                def oldNum:double (this.toNumberOf(curU))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                def newVal:EvHandle (EvValueBridge.taggedNumber((oldNum + delta)))
                if (context.has(varName)) {
                    context.assign(varName newVal)
                    this.syncGlobalVar(varName newVal)
                } {
                    if onGlobalU {
                        gObjU.setMember(varName newVal)
                    } {
                        context.assign(varName newVal)
                    }
                }
                if node.prefix {
                    return newVal
                }
                return (EvValueBridge.taggedNumber(oldNum))
            }
            if ((this.nodeKindOf(leftNode)) == 3) {
                ; `o.p++` is ToNumber(o.p) + 1, never a compound `+=` -- for a
                ; STRING property the compound form concatenated, so
                ; `({foo:"bar"}).foo++` produced "bar1" where the spec says NaN.
                def oldV:EvHandle (this.readMemberValue(leftNode))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                if (this.isBigIntValue(oldV)) {
                    def stepM:BigNum (BigNum.fromInt(1))
                    def curM:BigNum (this.bigNumOf(oldV))
                    def nextM:BigNum (curM.add(stepM))
                    if (opK == 18) {
                        nextM = (curM.sub(stepM))
                    }
                    def nextMv:EvHandle (this.makeBigIntValue(nextM))
                    def wroteM:EvHandle (this.assignMember(leftNode 1 nextMv))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    if node.prefix {
                        return wroteM
                    }
                    return oldV
                }
                def oldNumM:double (this.toNumberOf(oldV))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                def newNumM:EvHandle (EvValueBridge.taggedNumber((oldNumM + delta)))
                def newV:EvHandle (this.assignMember(leftNode 1 newNumM))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                if node.prefix {
                    return newV
                }
                return (EvValueBridge.taggedNumber(oldNumM))
            }
        }
        return (EvValueBridge.taggedNull())
    }

    ; Read the current value of a member/index target without mutating it.
    fn readMemberValue:EvHandle (leftNode:TSNode) {
        def obj:EvHandle (EvValueBridge.taggedNull())
        if leftNode.left {
            def objNode:TSNode (unwrap leftNode.left)
            obj = (this.evaluateExpr(objNode))
        }
        if leftNode.computed {
            if leftNode.right {
                def indexVal:EvHandle (this.evaluateExpr((unwrap leftNode.right)))
                if (indexVal.isNumber()) {
                    return (obj.getIndex((to_int (indexVal.toNumber()))))
                }
                return (obj.getMember((indexVal.toString())))
            }
        }
        return (obj.getMember(leftNode.name))
    }

    ; Evaluate an assignment/update as an expression, returning its value.
    ; ---- expression slots --------------------------------------------------
    ; How many slots this body needs, numbering it on first use. The walk is the
    ; whole of the "analysis": every node below the body gets the next index,
    ; and the count is the total. `(a + b) + c` is three nested expressions and
    ; takes three indices, so both products are live at once without colliding
    ; -- which is exactly why the index is per NODE and not one scratch value.
    ;
    ; A nested function is not descended into: its own body is numbered when it
    ; is first called, and its activation gets its own range.
    fn exprSlotCountOf:int (body:TSNode) {
        if (body.exprSlotCount >= 0) {
            return body.exprSlotCount
        }
        exprNumberCounter = 0
        this.numberExprNodes(body 0)
        body.exprSlotCount = exprNumberCounter
        return body.exprSlotCount
    }

    fn numberExprNodes:void (node:TSNode depth:int) {
        if (depth > 40) {
            return
        }
        def k:int (this.nodeKindOf(node))
        if ((k == 17) || (k == 18)) { return }
        if (k == 40) { return }
        node.exprId = exprNumberCounter
        exprNumberCounter = (exprNumberCounter + 1)
        def nd:int (depth + 1)
        def c:int 0
        while (c < (array_length node.children)) {
            this.numberExprNodes((itemAt node.children c) nd)
            c = (c + 1)
        }
        if node.body { this.numberExprNodes((unwrap node.body) nd) }
        if node.left { this.numberExprNodes((unwrap node.left) nd) }
        if node.right { this.numberExprNodes((unwrap node.right) nd) }
        if node.init { this.numberExprNodes((unwrap node.init) nd) }
        if node.test { this.numberExprNodes((unwrap node.test) nd) }
        if node.consequent { this.numberExprNodes((unwrap node.consequent) nd) }
        if node.alternate { this.numberExprNodes((unwrap node.alternate) nd) }
    }

    ; The value object for this node in the CURRENT activation, carrying `n`.
    ; Created on first use and reused by every later evaluation of the same node
    ; in the same call. Not pooled and never handed to a binding, so nothing
    ; else can be holding it.
    fn exprSlotNumber:EvHandle (node:TSNode n:double) {
        def id:int (exprSlotBase + node.exprId)
        def held@(optional):EvHandle (get exprSlots id)
        if held {
            def h:EvHandle (unwrap held)
            h.setNumberOf(n)
            return h
        }
        def fresh:EvHandle (EvHandle.rawNumber(n))
        set exprSlots id fresh
        return fresh
    }

    ; `+` `-` `*` `/` only. `%` goes through a remainder helper that answers
    ; with a value object, and the comparisons answer with booleans, which the
    ; engine already hands out from a shared pair.
    fn transientArithOp:boolean (op:string) {
        if (op == "+") { return true }
        if (op == "-") { return true }
        if (op == "*") { return true }
        if (op == "/") { return true }
        return false
    }

    ; Evaluate an expression whose result the CALLER reads as a number and then
    ; drops. Such a result cannot be retained by anything, so it may live in the
    ; expression's slot instead of a fresh object. Operands are evaluated the
    ; same way, which is what makes `(i + 1) * (i + 2)` allocation-free rather
    ; than only its outermost product.
    ;
    ; Anything not recognised falls straight through to the ordinary evaluator,
    ; so this is an optimisation of shape, never of meaning.
    ; Is this a shape the transient path may drive? Only nodes that can be
    ; evaluated TWICE with the same effect qualify: a name read, a numeric
    ; literal, or an arithmetic binary of those. That matters because a string
    ; operand sends the node back to the ordinary evaluator, which evaluates the
    ; operands again -- harmless for these, a doubled side effect for a call.
    fn transientOperandOk:boolean (node:TSNode depth:int) {
        if (node.transientOk >= 0) {
            return (node.transientOk == 1)
        }
        def ans:boolean (this.computeTransientOk(node depth))
        if ans {
            node.transientOk = 1
        } {
            node.transientOk = 0
        }
        return ans
    }

    fn computeTransientOk:boolean (node:TSNode depth:int) {
        if (depth > 24) {
            return false
        }
        if (node.exprId < 0) {
            return false
        }
        def k:int (this.nodeKindOf(node))
        if (k == 1) { return true }
        if (k == 2) { return true }
        ; A member read qualifies when re-evaluating it cannot fire an effect:
        ; the receiver is a bare name and the read is either `.length` or a
        ; computed index whose expression qualifies itself. Whether the read
        ; really is a pure dense-element/length hit is decided AT RUNTIME
        ; (array-ness, bounds, no own accessors); any miss falls back to the
        ; ordinary evaluator, which may evaluate these operands again — safe
        ; for exactly this shape.
        if (k == 3) {
            if node.left { } { return false }
            def mrecv:TSNode (unwrap node.left)
            if ((this.nodeKindOf(mrecv)) != 1) {
                return false
            }
            if node.computed {
                if node.right { } { return false }
                return (this.transientOperandOk((unwrap node.right) (depth + 1)))
            }
            return (node.name == "length")
        }
        if (k != 5) {
            return false
        }
        if ((this.transientArithOp(node.value)) == false) {
            return false
        }
        def nd:int (depth + 1)
        if node.left { } { return false }
        if node.right { } { return false }
        if ((this.transientOperandOk((unwrap node.left) nd)) == false) {
            return false
        }
        return (this.transientOperandOk((unwrap node.right) nd))
    }

    ; A transient-admitted MEMBER read, tried as a pure numeric fast hit:
    ; `a.length` / `s.length` as a bare count, `a[j]` as a dense in-bounds
    ; NUMBER element of an accessor-free array. Returns the node's slot value
    ; on a hit; on any miss the caller re-evaluates through the ordinary
    ; path, which is safe because admission allowed only effect-free shapes.
    fn tryTransientMemberNumber@(optional):EvHandle (node:TSNode) {
        def none@(optional):EvHandle
        if node.left { } { return none }
        def mrecv:TSNode (unwrap node.left)
        def base:EvHandle (this.lookupIdentifier(mrecv.name))
        if scriptThrew {
            return none
        }
        if (false == node.computed) {
            ; .length of an array (dense or declared) or a string
            if (base.isArrayValue()) {
                def lenHit@(optional):EvHandle (this.exprSlotNumber(node (base.arrayLengthD())))
                return lenHit
            }
            if (base.isString()) {
                ; D-UTF8: code UNITS, not bytes.
                def slenHit@(optional):EvHandle (this.exprSlotNumber(node (to_double (base.strCodeUnitLength()))))
                return slenHit
            }
            return none
        }
        if node.right { } { return none }
        def idxV:EvHandle (this.evaluateExprTransient((unwrap node.right)))
        if scriptThrew {
            return none
        }
        if (false == (idxV.isNumber())) {
            return none
        }
        def idxD:double idxV.numberValue
        def idx:int (to_int idxD)
        if ((to_double idx) != idxD) {
            return none
        }
        if (false == (base.isArrayValue())) {
            return none
        }
        ; An own accessor under a numeric key would make this read observable;
        ; the monotone bag flag rules that out without minting the key string.
        ; A dense NUMBER hit also shadows any prototype accessor by spec.
        if (base.ownAccessorsEver()) {
            return none
        }
        if (false == (base.denseIsNumberAt(idx))) {
            return none
        }
        def elemHit@(optional):EvHandle (this.exprSlotNumber(node (base.denseNumberAt(idx))))
        return elemHit
    }

    ; A loop test evaluated straight to a boolean. The hot shape — a

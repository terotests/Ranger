                }
                ; The error constructors are real constructors even though they
                ; are seeded on hostScope rather than published as namespace
                ; objects -- checking only isBuiltinCtorName rejected `new Error`
                ; outright.
                if (false == (this.isErrorCtorName(ncName))) {
                if (false == (this.isBuiltinCtorName(ncName))) {
                    if (this.isEngineGlobalName(ncName)) {
                        def ncG:EvHandle (this.builtinGlobalObject(ncName))
                        if (false == (ncG.isFunction())) {
                            return (this.throwSpecError("TypeError" (ncName + " is not a constructor")))
                        }
                    }
                    if (false == (this.isEngineGlobalName(ncName))) {
                        if (false == (context.has(ncName))) {
                            ; A class is not a scope binding in this engine, so
                            ; the class table has to be consulted too before
                            ; declaring the name unresolvable.
                            def ncCls:TSNode (this.classNodeByName(ncName))
                            if ((this.nodeKindOf(ncCls)) != 25) {
                                return (this.throwSpecError("ReferenceError" (ncName + " is not defined")))
                            }
                        } {

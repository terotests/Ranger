                    def acc:EvHandle (EvValueBridge.taggedUndefined())
                    def ri:int 0
                    if ((array_length args) > 1) {
                        acc = (itemAt args 1)
                    } {
                        if (n == 0) {
                            return (this.throwSpecError("TypeError" "Reduce of empty iterator with no initial value"))
                        }
                        acc = (itemAt rest 0)
                        ri = 1
                    }
                    if (false == (hArg.isFunction())) {
                        return (this.throwSpecError("TypeError" "The reducer is not a function"))
                    }
                    while (ri < n) {
                        def rArgs:[EvHandle]
                        push rArgs acc
                        push rArgs (itemAt rest ri)
                        push rArgs (EvHandle.fromInt(ri))
                        acc = (this.callFnValueWithValues(hArg rArgs))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                        ri = (ri + 1)
                    }
                    return acc
                }
                if (false == (hArg.isFunction())) {
                    return (this.throwSpecError("TypeError" "The callback is not a function"))
                }
                def outItems:[EvHandle]
                def k:int 0
                while (k < n) {
                    def el:EvHandle (itemAt rest k)
                    def cbArgs:[EvHandle]
                    push cbArgs el
                    push cbArgs (EvHandle.fromInt(k))
                    def got:EvHandle (this.callFnValueWithValues(hArg cbArgs))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    if (name == "map") { push outItems got }
                    if (name == "filter") {
                        if (got.toBool()) { push outItems el }
                    }
                    if (name == "flatMap") {
                        ; One level, and the result must be iterable -- a plain
                        ; value is a TypeError here, unlike Array's flatMap.
                        if (got.isArrayValue()) {
                            def fi:int 0
                            while (fi < (got.denseLen())) {
                                push outItems (got.arrayItemAt(fi))
                                fi = (fi + 1)
                            }
                        } {
                            def sub:[EvHandle] (this.forOfItemList(got))
                            if scriptThrew {
                                return (EvValueBridge.taggedUndefined())
                            }
                            def si:int 0
                            while (si < (array_length sub)) {
                                push outItems (itemAt sub si)
                                si = (si + 1)
                            }
                        }
                    }
                    if (name == "some") {
                        if (got.toBool()) { return (EvValueBridge.taggedBoolean(true)) }
                    }
                    if (name == "every") {
                        if (false == (got.toBool())) { return (EvValueBridge.taggedBoolean(false)) }
                    }
                    if (name == "find") {
                        if (got.toBool()) { return el }
                    }
                    k = (k + 1)
                }
                if (name == "some") { return (EvValueBridge.taggedBoolean(false)) }
                if (name == "every") { return (EvValueBridge.taggedBoolean(true)) }
                if (name == "find") { return (EvValueBridge.taggedUndefined()) }
                if (name == "forEach") { return (EvValueBridge.taggedUndefined()) }
                return (this.makeListIterator(outItems))
            }
            def keysR:[string]
            def valsR:[EvHandle]
            def res:EvHandle (EvValueBridge.taggedObject(keysR valsR))
            def lst:EvHandle (recv.getMember("__iterlist__"))
            def idx:int (this.toIntegerOf((recv.getMember("__iteridx__"))))
            if (false == (lst.isArrayValue())) {
                res.setMember("value" (EvValueBridge.taggedUndefined()))
                res.setMember("done" (EvValueBridge.taggedBoolean(true)))
                return res
            }
            if (idx >= (lst.denseLen())) {
                res.setMember("value" (EvValueBridge.taggedUndefined()))
                res.setMember("done" (EvValueBridge.taggedBoolean(true)))
                return res
            }
            res.setMember("value" (lst.arrayItemAt(idx)))
            res.setMember("done" (EvValueBridge.taggedBoolean(false)))
            recv.setMember("__iteridx__" (EvHandle.fromInt((idx + 1))))
            return res
        }
        if (kind == "promise") {
            ; §25.4.5.1: `catch` is GENERIC -- it is `this.then(undefined, f)`
            ; and never inspects the receiver, so it works on any thenable. Only
            ; `then` itself requires a real promise.
            if (name == "then") {
                if (false == (this.isPromiseValue(recv))) {
                    return (this.throwSpecError("TypeError" "Promise.prototype.then called on a non-Promise"))
                }
            }
            ; §27.2.5.3 `finally` is generic too -- it is `then` with a pair of
            ; wrappers that run the callback and then RESTORE the settlement:
            ; the value passes through, the reason is rethrown, and neither is
            ; replaced by whatever the callback answered. What the callback
            ; answers is only WAITED for, if it is thenable.
            if (name == "finally") {
                def finFn:EvHandle (EvValueBridge.taggedUndefined())
                if ((array_length args) > 0) { finFn = (itemAt args 0) }
                ; A non-callable argument is not an error: `then(f, f)` with a
                ; non-function on both sides is the identity pair, which is
                ; exactly the pass-through this is supposed to be.
                if (false == (finFn.isFunction())) {
                    return (this.promiseThenVia(recv finFn finFn))
                }
                def finC:EvHandle (this.promiseSpeciesCtor(recv))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                def fkeys:[string]
                def fvals:[EvHandle]
                def finRec:EvHandle (EvValueBridge.taggedObject(fkeys fvals))
                finRec.setMember("__fin_fn__" finFn)
                finRec.setMember("__fin_ctor__" finC)
                def finOk:EvHandle ((EvValueBridge.taggedNativeMethod("promisefin" "ok")).withThisForCall(finRec))
                def finErr:EvHandle ((EvValueBridge.taggedNativeMethod("promisefin" "err")).withThisForCall(finRec))
                this.shapeAnonFn(finOk 1)
                this.shapeAnonFn(finErr 1)
                return (this.promiseThenVia(recv finOk finErr))
            }
            def onFul:EvHandle (EvValueBridge.taggedUndefined())
            def onRej:EvHandle (EvValueBridge.taggedUndefined())
            if (name == "then") {
                if ((array_length args) > 0) { onFul = (itemAt args 0) }
                if ((array_length args) > 1) { onRej = (itemAt args 1) }
            } {
                ; `catch(f)` IS `then(undefined, f)`.
                if ((array_length args) > 0) { onRej = (itemAt args 0) }
            }
            ; §25.4.5.3: `catch` is `then` reached through the RECEIVER, so a
            ; guest that overrode `then` is the one that runs.
            if (name == "catch") {
                return (this.promiseThenVia(recv onFul onRej))
            }
            ; §25.4.5.3 step 3: the result is built by SpeciesConstructor(this,
            ; %Promise%) through a capability -- not minted as an intrinsic.
            ; That is what makes `then` on a subclass answer that subclass, and
            ; what lets a @@species override decide.
            def thenC:EvHandle (this.promiseSpeciesCtor(recv))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            if (this.isIntrinsicPromiseCtor(thenC)) {
                def derived:EvHandle (this.makePromiseValue())
                this.registerReaction(recv onFul onRej derived)
                return derived
            }
            def tCap:EvHandle (this.newPromiseCapability(thenC))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            ; The reactions settle an intrinsic promise, and that promise's
            ; settlement is forwarded into the capability -- which is how a
            ; subclass's own resolve/reject functions get to see it.
            def bridge:EvHandle (this.makePromiseValue())
            this.registerReaction(recv onFul onRej bridge)
            this.registerReaction(bridge (tCap.getMember("__cap_resolve__")) (tCap.getMember("__cap_reject__")) (EvValueBridge.taggedNull()))
            return (this.capPromiseOf(tCap))
        }
        ; ---- Number.prototype ----------------------------------------------
        if (kind == "number") {
            def fprim:EvHandle (this.unwrapPrimitive(recv))
            def fnum:double (fprim.toNumber())
            if (name == "toLocaleString") {
                ; D-INTL: §19.2.4.3 is defined as Intl.NumberFormat with the
                ; same arguments, and there is locale data now, so it goes
                ; there rather than answering ToString.
                def nlTag:string ""
                if ((array_length args) > 0) {
                    nlTag = (this.intlFirstTag((itemAt args 0)))
                    if scriptThrew { return (EvValueBridge.taggedUndefined()) }
                }
                def nlOpts:EvHandle (EvValueBridge.taggedUndefined())
                if ((array_length args) > 1) { nlOpts = (itemAt args 1) }
                def nlArgs:[EvHandle]
                push nlArgs (EvValueBridge.taggedString(nlTag))
                push nlArgs nlOpts
                def nf:EvHandle (this.constructIntl("numberformat" nlArgs))
                if scriptThrew { return (EvValueBridge.taggedUndefined()) }
                def nfArgs:[EvHandle]
                push nfArgs (EvValueBridge.taggedNumber(fnum))
                return (this.invokeBuiltin("intlnumberformat" "format" nf nfArgs))
            }
            if (name == "toFixed") {
                def digits:int 0
                if ((array_length args) > 0) {
                    def dv:EvHandle (itemAt args 0)
                    if (false == (dv.isUndefined())) {
                        digits = (this.toIntegerOf(dv))
                    }
                }
                ; The argument range is 0..100; outside it the answer is not a
                ; string but a RangeError.
                if ((digits < 0) || (digits > 100)) {
                    return (this.throwSpecError("RangeError" "toFixed() digits argument must be between 0 and 100"))
                }
                return (EvValueBridge.taggedString((this.toFixedString(fnum digits))))
            }
            if (name == "toExponential") {
                def edigits:int 6
                def eauto:boolean true
                if ((array_length args) > 0) {
                    def ev:EvHandle (itemAt args 0)
                    if (false == (ev.isUndefined())) {
                        edigits = (this.toIntegerOf(ev))
                        eauto = false
                    }
                }
                if (eauto == false) {
                    if ((edigits < 0) || (edigits > 100)) {
                        return (this.throwSpecError("RangeError" "toExponential() argument must be between 0 and 100"))
                    }
                } {
                    ; §20.1.3.2 with no argument: as many fraction digits as it
                    ; takes to represent the value uniquely -- not six. The flag
                    ; was computed and never read, so `(123456).toExponential()`
                    ; formatted six digits of a mantissa it had already lost and
                    ; answered "0.000001e+5".
                    edigits = (this.significantDigitsOf(fnum))
                }
                return (EvValueBridge.taggedString((this.toExponentialString(fnum edigits))))
            }
            if (name == "toPrecision") {
                if ((array_length args) == 0) {
                    return (EvValueBridge.taggedString((this.toStringOf(fprim))))
                }
                def pv:EvHandle (itemAt args 0)
                if (pv.isUndefined()) {
                    return (EvValueBridge.taggedString((this.toStringOf(fprim))))
                }
                def prec:int (this.toIntegerOf(pv))
                if ((prec < 1) || (prec > 100)) {
                    return (this.throwSpecError("RangeError" "toPrecision() argument must be between 1 and 100"))
                }
                return (EvValueBridge.taggedString((this.toPrecisionString(fnum prec))))
            }
        }
        if (kind == "function") {
            ; OrdinaryHasInstance, which is what `x instanceof f` falls back to.
            ; It answers FALSE rather than throwing for a non-callable receiver
            ; or a primitive argument, so it is checked before the callable
            ; guard the other three share.
            if (name == "@@hasInstance") {
                if (false == (recv.isFunction())) {
                    return (EvValueBridge.taggedBoolean(false))
                }
                def hiArg:EvHandle (EvValueBridge.taggedUndefined())
                if ((array_length args) > 0) { hiArg = (itemAt args 0) }
                if (false == (this.isDescriptorObject(hiArg))) {
                    return (EvValueBridge.taggedBoolean(false))
                }
                if (this.isSymbolValue(hiArg)) {
                    return (EvValueBridge.taggedBoolean(false))
                }
                ; A bound function carries a COPY of its target's core here, so
                ; its `prototype` is already the target's -- no unwrapping step.
                def hiProto:EvHandle (recv.getMember("prototype"))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                if (false == (this.isDescriptorObject(hiProto))) {
                    return (this.throwSpecError("TypeError" "prototype is not an object"))
                }
                def hiWalk:EvHandle (this.protoOfValue(hiArg))
                def hiGuard:int 0
                while (hiGuard < 1024) {
                    if (false == (hiWalk.isObject())) { hiGuard = 1024 } {
                        if (hiWalk.equals(hiProto)) {
                            return (EvValueBridge.taggedBoolean(true))
                        }
                        hiWalk = (this.protoOfValue(hiWalk))
                        hiGuard = (hiGuard + 1)
                    }
                }
                return (EvValueBridge.taggedBoolean(false))
            }
            ; call/apply/bind operate ON a function. Reaching them with a
            ; non-callable receiver — `var c = f.call; c(x)` — is a TypeError,
            ; which is exactly what an unbound extraction must produce.
            ; A callable PROXY is callable, so it is not the non-function this
            ; guard is for -- `p.bind(o)` used to be refused outright.
            if (false == (recv.isFunction())) {
                if (false == (this.isProxyValue(recv))) {
                    return (this.throwSpecError("TypeError" (name + " called on a non-function")))
                }
            }
            if (name == "call") {
                def callThis:EvHandle (EvValueBridge.taggedUndefined())
                def rest:[EvHandle]
                def i:int 0
                while (i < (array_length args)) {
                    if (i == 0) {
                        callThis = (itemAt args 0)
                    } {
                        push rest (itemAt args i)
                    }
                    i = (i + 1)
                }
                def b1:EvHandle (recv.withThisForCall(callThis))
                return (this.callFnValueWithValues(b1 rest))
            }
            if (name == "apply") {
                def applyThis:EvHandle (EvValueBridge.taggedUndefined())
                def aargs:[EvHandle]
                if ((array_length args) > 0) {
                    applyThis = (itemAt args 0)
                }
                if ((array_length args) > 1) {
                    def arr:EvHandle (itemAt args 1)
                    ; CreateListFromArrayLike: any object with a length works,
                    ; which is what lets `f.apply(null, arguments)` forward a
                    ; call. A primitive that is not null/undefined is a
                    ; TypeError rather than an empty argument list.
                    if (false == ((arr.isNull()) || (arr.isUndefined()))) {
                        def okArgs:boolean false
                        if (arr.isArrayValue()) { okArgs = true }
                        if (arr.isObject()) { okArgs = true }
                        ; A FUNCTION is an object with a length, and so are Map
                        ; and Set -- `fun.apply("", Array)` forwards Array's one
                        ; declared parameter rather than being a TypeError.
                        if (arr.isFunction()) { okArgs = true }
                        if (arr.isMap()) { okArgs = true }
                        if (arr.isSet()) { okArgs = true }
                        if (false == okArgs) {
                            return (this.throwSpecError("TypeError" "CreateListFromArrayLike called on non-object"))
                        }
                        def alist:[EvHandle] (this.arrayLikeElements(arr))
                        def k:int 0
                        while (k < (array_length alist)) {
                            push aargs (itemAt alist k)
                            k = (k + 1)
                        }
                    }
                }
                def b2:EvHandle (recv.withThisForCall(applyThis))
                return (this.callFnValueWithValues(b2 aargs))
            }
            if (name == "bind") {
                def bindThis:EvHandle (EvValueBridge.taggedUndefined())
                def partial:[EvHandle]
                def j:int 0
                while (j < (array_length args)) {
                    if (j == 0) {
                        bindThis = (itemAt args 0)
                    } {
                        push partial (itemAt args j)
                    }
                    j = (j + 1)
                }
                ; §19.2.3.2: binding an ALREADY-bound function does not
                ; replace the first binding, it wraps it. The original `this`
                ; is what the call still uses -- a second bind cannot change it
                ; -- and the new partial arguments go AFTER the first set.
                ; Overwriting both meant `f.bind(o, 1).bind(null, 2)` called f
                ; with `this` null and only the later argument.
                def allPartial:[EvHandle]
                if (recv.boundExplicitOf()) {
                    bindThis = (recv.boundThisOf())
                    def bpi:int 0
                    while (bpi < (recv.boundArgCount())) {
                        push allPartial (recv.boundArgAt(bpi))
                        bpi = (bpi + 1)
                    }
                }
                def api:int 0
                while (api < (array_length partial)) {
                    push allPartial (itemAt partial api)
                    api = (api + 1)
                }
                def b3:EvHandle (recv.withThis(bindThis))
                b3.setBoundArgs(allPartial)
                b3.setBoundExplicit(true)
                b3.setFnName(("bound " + (recv.fnName())))
                ; D-STRICT: a BOUND function poisons caller and arguments the way
                ; a strict one does, whatever the target was -- that is what
                ; `boundExplicit` answers for -- and it has no `prototype` of its
                ; own. Its STRICTNESS stays the target's, because that is what
                ; decides the `this` a call supplies.
                b3.setStrictFn((recv.strictFnOf()))
                b3.setSuppressed((this.suppressPrototype(recv)))
                return b3
            }
        }
        return (EvValueBridge.taggedUndefined())
    }

    ; A bound function has no `prototype`, so the synthesised one is suppressed
    ; on the copy without touching the target's.
    fn suppressPrototype:[string:boolean] (recv:EvHandle) {
        def out:[string:boolean]
        def ks:[string] (recv.suppressedKeyList())
        def i:int 0
        while (i < (array_length ks)) {
            set out (itemAt ks i) true
            i = (i + 1)
        }
        set out "prototype" true
        return out
    }

    ; D-ARGCHECK: Object statics whose first argument must be an object. Note
    ; what is NOT here: keys/values/entries/assign/getOwnPropertyNames coerce in
    ; ES2015+ rather than throwing, but throw on null/undefined specifically —
    ; handled by the nullish check at the call site. freeze/seal/isFrozen/
    ; isSealed/isExtensible accept anything and are deliberately absent.
    ; Statics that genuinely REQUIRE an object argument in the current spec.
    ; Array methods whose first argument must be callable.
    ; D-WRAPPER: constructors whose instances box a primitive.
    fn isWrapperCtorName:boolean (name:string) {
        if (name == "String") { return true }
        if (name == "Number") { return true }
        if (name == "Boolean") { return true }
        return false
    }

    ; The boxed object. `__primitive__` is the internal slot; the wrapper reports
    ; the primitive's receiver kind so String.prototype methods dispatch to it.
    ; D-TOOBJECT: ToObject. A primitive is BOXED rather than handed back
    ; unchanged -- `Object(5)` is a Number object, and `typeof Object(5)` is
    ; "object", which the old passthrough got wrong. null/undefined (and the
    ; no-argument form, which arrives as a null EvHandle) make a fresh object.
    fn toObjectValue:EvHandle (v:EvHandle) {
        if (v.isString()) { return (this.makeWrapper("String" v)) }
        if (v.isNumber()) { return (this.makeWrapper("Number" v)) }
        if (v.isBoolean()) { return (this.makeWrapper("Boolean" v)) }
        if ((v.isNull()) || (v.isUndefined())) {
            def keysO:[string]
            def valsO:[EvHandle]
            def o:EvHandle (EvValueBridge.taggedObject(keysO valsO))
            o.setProto((this.builtinPrototype("Object")))
            return o
        }
        return v
    }

    fn makeWrapper:EvHandle (ctorName:string prim:EvHandle) {
        def keysW:[string]
        def valsW:[EvHandle]
        def w:EvHandle (EvValueBridge.taggedObject(keysW valsW))
        def p:EvHandle prim
        if (ctorName == "String") {
            if (prim.isNull()) {
                p = (EvValueBridge.taggedString(""))
            } {
                p = (EvValueBridge.taggedString((this.toStringOf(prim))))
            }
        }
        if (ctorName == "Number") {
            ; `new Number()` is +0, but `new Number(undefined)` is NaN -- the
            ; absence of an argument and an undefined argument are different
            ; things, and the caller signals which by passing a null EvHandle.
            if (prim.isNull()) {
                p = (EvValueBridge.taggedNumber(0.0))
            } {
                p = (EvValueBridge.taggedNumber((this.toNumberOf(prim))))
            }
        }
        if (ctorName == "Boolean") {
            p = (EvValueBridge.taggedBoolean((prim.toBool())))
        }
        w.setMember("__primitive__" p)
        w.setMember("__wrapper__" (EvValueBridge.taggedString(ctorName)))
        ; A boxed string exposes `length` as a real own property, which is what
        ; `with ('ab') { length }` resolves against, plus one own property per
        ; index. Both are what `Object.keys(new String('ab'))` reports -- the
        ; indices are enumerable, `length` is not.
        if (ctorName == "String") {
            def sw:string (p.stringOf())
            def ci:int 0
            while (ci < (strlen sw)) {
                w.setMember((to_string ci) (EvValueBridge.taggedString((substring sw ci (ci + 1)))))
                w.setAttrs((to_string ci) false true false)
                ci = (ci + 1)
            }
            w.setMember("length" (EvHandle.fromInt((strlen sw))))
            w.setAttrs("length" false false false)
        }
        w.setProto((this.builtinPrototype(ctorName)))
        return w
    }

    ; ==========================================================================
    ; D-CLASSOF: the [[Class]] brand, as ES5 15.2.4.2 exposes it through
    ; Object.prototype.toString.
    ; --------------------------------------------------------------------------
    ; This is the only place the language lets a program observe a value's
    ; internal type, and the suite leans on it hard: 86 ES5 files capture
    ; `Object.prototype.toString` under the name `getClass` and assert the brand
    ; of what they just built. The engine answered "[object Object]" for
    ; everything, so an array, a boxed number and a plain object were
    ; indistinguishable and every one of those assertions failed.
    ;
    ; A boxed primitive brands as its constructor, not as Object -- that is the
    ; whole point of the wrapper -- so the check reads the internal slot rather
    ; than the value type.
    ; --------------------------------------------------------------------------
    fn objectClassOf:string (v:EvHandle) {
        if (v.isUndefined()) { return "Undefined" }
        if (v.isNull()) { return "Null" }
        if (v.isArrayValue()) {
            ; A TYPED array is an array value here -- that is how it gets the
            ; element machinery -- but it brands as its own constructor, which
            ; is the only way `Object.prototype.toString` can tell an Int32Array
            ; from an Array. Checked before the plain-array answer, because it
            ; would otherwise win by position.
            def taTag:string (this.typedArrayBrandOf(v))
            if ((strlen taTag) > 0) { return taTag }
            return "Array"
        }
        if (v.isFunction()) {
            ; A callable's builtin tag is Function, but an async or generator
            ; function inherits a @@toStringTag from its own intrinsic
            ; prototype, so the four forms brand apart. Feature detection in
            ; the wild reads exactly this to tell an async function from a
            ; plain one.
            if (v.hasFunctionNode()) {
                def fnN:TSNode (v.functionNodeOf())
                if fnN.async {
                    if fnN.generator { return "AsyncGeneratorFunction" }
                    return "AsyncFunction"
                }
                if fnN.generator { return "GeneratorFunction" }
            }
            return "Function"
        }
        if (v.isString()) { return "String" }
        if (v.isNumber()) { return "Number" }
        if (v.isBoolean()) { return "Boolean" }
        ; A Map and a Set are their own value kinds here, so the object branch
        ; below never saw them and `Object.prototype.toString.call(new Map())`
        ; answered "[object Object]" -- for a PLAIN Map, not only a subclassed
        ; one. Their prototypes carry the tag; the value does not reach it.
        if (v.isMap()) { return "Map" }
        if (v.isSet()) { return "Set" }
        if (v.isObject()) {
            if (v.hasOwnData("__nsbrand__")) {
                return ((v.getOwnData("__nsbrand__")).toString())
            }
            if (v.hasOwnData("__wrapper__")) {
                return ((v.getOwnData("__wrapper__")).toString())
            }
            ; An error INSTANCE brands as Error; Error.prototype is an ordinary
            ; object and brands as Object, which is why the marker is checked on
            ; the own map rather than through the prototype chain.
            if (v.hasOwnData("__error__")) { return "Error" }
            if (v.hasOwnData("__date__")) { return "Date" }
            if (v.hasOwnData("__regex__")) { return "RegExp" }
            ; ES2015 brands a Promise through @@toStringTag, which lands in the
            ; same place: `Object.prototype.toString.call(p)` is "[object Promise]".
            if (v.hasOwnData("__promise__")) { return "Promise" }
            if (v.hasOwnData("__arguments__")) { return "Arguments" }
        }
        ; ES2015: @@toStringTag, anywhere up the chain, names the brand -- which
        ; is how a class publishes one. Checked after the internal slots so a
        ; real Date still brands as Date.
        if (this.isDescriptorObject(v)) {
            def tagV:EvHandle (this.getPropertyValue(v "@@toStringTag"))
            if (tagV.isString()) {
                return (tagV.stringOf())
            }
        }
        return "Object"
    }

    ; The primitive inside a wrapper, or the value itself when it is not one.
    fn unwrapPrimitive:EvHandle (v:EvHandle) {
        if (v.isObject()) {
            if (v.hasOwnData("__primitive__")) {
                return (v.getOwnData("__primitive__"))
            }
        }
        return v
    }

    ; ==========================================================================
    ; D-TOPRIMITIVE: converting an object to a primitive, the way every operator
    ; that is not `===` does it.
    ; --------------------------------------------------------------------------
    ; The operators read raw values, so an object went straight to its debug
    ; form: `({valueOf: function () { return 5; }}) + 1` produced a string
    ; instead of 6, and every comparison against an object compared text. The
    ; whole language/expressions area turns on this -- addition, the relational
    ; operators, the bitwise operators and compound assignment all funnel
    ; through ToPrimitive then ToNumber.
    ;
    ; Number hint tries valueOf then toString; string hint the other way. A
    ; method that returns an object is skipped, per spec, rather than accepted.
    ; --------------------------------------------------------------------------
    ; The valueOf/toString a receiver would actually run, as ToPrimitive sees it.
    ; Shared by the call itself and by the "is this still the built-in?" question,
    ; so the two cannot disagree about which method is in play.
    fn resolvePrimitiveMethod:EvHandle (obj:EvHandle name:string) {
        def m:EvHandle (obj.getMember(name))
        ; An ARRAY or FUNCTION receiver has no prototype link of its own, so a
        ; guest override on Array.prototype or Function.prototype has to be
        ; looked for there. Without this, `Array.prototype.toString = …` was
        ; invisible to every conversion.
        def needsProtoLookup:boolean false
        if (false == (m.isFunction())) { needsProtoLookup = true }
        if (m.isFunction()) {
            if (false == (m.hasFunctionNode())) { needsProtoLookup = true }
        }
        if needsProtoLookup {
            def pcn:string (this.ctorNameForKind((this.receiverKind(obj))))
            if ((strlen pcn) > 0) {
                if (false == (obj.isObject())) {
                    def kp:EvHandle (this.builtinPrototype(pcn))
                    if (kp.hasOwnData(name)) {
                        def kpm:EvHandle (kp.getOwnData(name))
                        if (kpm.isFunction()) {
                            if (kpm.hasFunctionNode()) {
                                return kpm
                            }
                        }
                    }
                }
            }
        }
        return m
    }

    ; True when `name` on this receiver is the inherited BUILT-IN rather than
    ; something the guest supplied -- callable or not. An own property shadows
    ; the default even when its value is undefined: the property is there, it is
    ; simply not callable, so ToPrimitive skips it and the other method gets its
    ; turn rather than the default rendering standing in.
    fn usesDefaultMethod:boolean (v:EvHandle name:string) {
        if (v.hasOwnData(name)) {
            ; A built-in prototype publishes its methods as OWN properties --
            ; String.prototype.valueOf really is on String.prototype -- so
            ; presence alone does not mean the guest supplied one. What settles
            ; it is whether the value has a body the engine would run.
            def own:EvHandle (v.getOwnData(name))
            if (own.isFunction()) {
                if (false == (own.hasFunctionNode())) {
                    return true
                }
            }
            return false
        }
        def m:EvHandle (this.resolvePrimitiveMethod(v name))
        if (m.isFunction()) {
            if (false == (m.hasFunctionNode())) {
                return true
            }
            return false
        }
        ; Nothing resolved at all. An ARRAY or FUNCTION has no prototype object
        ; of its own, so the built-in it would run is not reachable as a value
        ; and the lookup comes back null -- that is still the default.
        if (m.isNull()) {
            return true
        }
        ; Present but not a function: not the default, and not usable either.
        if (false == (m.isUndefined())) {
            return false
        }
        return true
    }

    fn callPrimitiveMethod:EvHandle (obj:EvHandle name:string) {
        primitiveMethodUsable = false
        def m:EvHandle (this.resolvePrimitiveMethod(obj name))
        ; D-TOPRIMITIVE: the guest may hang ANOTHER prototype's built-in on the
        ; object -- `var o = {toString: Function.prototype.toString}`. That is
        ; not the default for this receiver, so ToPrimitive has to RUN it; the
        ; default-method shortcut below would otherwise brand the object and
        ; never notice, which hides the TypeError that method owes a
        ; non-callable receiver.
        if (m.isBuiltinMethod()) {
            def borrowedPrim:boolean false
            if ((m.builtinNameOf()) != name) { borrowedPrim = true }
            if ((m.builtinKindOf()) != (this.receiverKind(obj))) { borrowedPrim = true }
            if borrowedPrim {
                def bpArgs:[EvHandle]
                def bpOut:EvHandle (this.invokeBuiltin((m.builtinKindOf()) (m.builtinNameOf()) obj bpArgs))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                if (bpOut.isObject()) { return (EvValueBridge.taggedNull()) }
                if (bpOut.isArrayValue()) { return (EvValueBridge.taggedNull()) }
                if (bpOut.isFunction()) { return (EvValueBridge.taggedNull()) }
                primitiveMethodUsable = true
                if (bpOut.isNull()) {
                    return (EvValueBridge.taggedUndefined())
                }
                return bpOut
            }
        }
        if (m.isFunction()) {
            if (m.hasFunctionNode()) {
                def noArgs:[EvHandle]
                def bound:EvHandle (m.withThisForCall(obj))
                def out:EvHandle (this.callFnValueWithValues(bound noArgs))
                ; A throw from the guest's own valueOf/toString is the answer.
                ; Swallowing it here let ToPrimitive carry on and raise its own
                ; TypeError instead, so the exception the test threw never
                ; reached the catch that was waiting for it.
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                ; An OBJECT result is not a primitive, so the method is skipped
                ; and the other one tried. Arrays and functions are objects too.
                if (out.isObject()) {
                    return (EvValueBridge.taggedNull())
                }
                if (out.isArrayValue()) {
                    return (EvValueBridge.taggedNull())
                }
                if (out.isFunction()) {
                    return (EvValueBridge.taggedNull())
                }
                ; A method that falls off its end returns UNDEFINED, which is a
                ; perfectly good primitive. The engine represents "no return" as
                ; null, which is also this function's "not usable" sentinel, so
                ; the two are told apart by the flag rather than by the value.
                primitiveMethodUsable = true
                if (out.isNull()) {
                    return (EvValueBridge.taggedUndefined())
                }
                return out
            }
        }
        return (EvValueBridge.taggedNull())
    }

    ; Lexicographic comparison by code unit: -1, 0 or 1. Ranger has no string
    ; relational operator, and comparing via toNumber would make "10" < "9"
    ; answer the numeric question instead of the textual one.
    fn compareStrings:int (a:string b:string) {
        ; §7.2.13 compares CODE UNITS, and this never went through the unit
        ; layer: on the byte target it read raw `charAt`, which is a SIGNED
        ; char, so every non-ASCII byte compared as negative and 'é' < 'z'
        ; answered true. That is one operator, but `sort()` with no comparator
        ; is defined in terms of it, so it reordered every index and every
        ; sorted list of names.
        def la:int (strlen a)
        def lb:int (strlen b)
        def n:int la
        if (lb < n) {
            n = lb
        }
        ; Both ASCII (the overwhelmingly common case): units, bytes and
        ; characters are the same sequence, so compare in place.
        def aAscii:boolean (this.asciiOnly(a))
        def bAscii:boolean (this.asciiOnly(b))
        if (aAscii && bAscii) {
            def i:int 0
            while (i < n) {
                def ca:int (charAt a i)
                def cb:int (charAt b i)
                if (ca < cb) { return (0 - 1) }
                if (ca > cb) { return 1 }
                i = (i + 1)
            }
            if (la < lb) { return (0 - 1) }
            if (la > lb) { return 1 }
            return 0
        }
        def ua:int (this.cuLen(a))
        def ub:int (this.cuLen(b))
        def m:int ua
        if (ub < m) { m = ub }
        def j:int 0
        while (j < m) {
            def xa:int (this.cuUnitAt(a j))
            def xb:int (this.cuUnitAt(b j))
            if (xa < xb) { return (0 - 1) }
            if (xa > xb) { return 1 }
            j = (j + 1)
        }
        if (ua < ub) { return (0 - 1) }
        if (ua > ub) { return 1 }
        return 0
    }

    ; Whether every unit of `s` is below 128, which is the test for "the three
    ; string models agree about this string".
    fn asciiOnly:boolean (s:string) {
        def n:int (strlen s)
        def i:int 0
        while (i < n) {
            def c:int (charAt s i)
            if (c < 0) { return false }
            if (c > 127) { return false }
            i = (i + 1)
        }
        return true
    }

    ; D-FNSRC: Function.prototype.toString. A function parsed from guest source
    ; returns that source verbatim -- the slice its node spans -- which is what
    ; makes `f + 1` and `eval("(" + f + ")")` behave. A builtin has no source, so
    ; it keeps the NativeFunction form the spec allows for one.
    fn functionSourceText:string (v:EvHandle) {
        if (false == (v.hasFunctionNode())) {
            return ("function " + (v.fnName()) + "() { [native code] }")
        }
        def fnode:TSNode (v.functionNodeOf())
        def total:int (strlen (v.srcTextOf()))
        if (total == 0) {
            return ("function " + (v.fnName()) + "() { [native code] }")
        }
        if (fnode.end <= fnode.start) {
            return ("function " + (v.fnName()) + "() { [native code] }")
        }
        if (fnode.end > total) {
            return ("function " + (v.fnName()) + "() { [native code] }")
        }
        return (substring (v.srcTextOf()) fnode.start fnode.end)
    }

    ; The rendering an object-like value converts to when the step in force
    ; resolves to the BUILT-IN method rather than one the guest supplied.
    fn defaultPrimitiveOf:EvHandle (v:EvHandle) {
        ; A boxed primitive IS its primitive: both of its inherited methods
        ; report it, so either hint lands here.
        if (v.isObject()) {
            if (v.hasOwnData("__primitive__")) {
                return (v.getOwnData("__primitive__"))
            }
            if (v.hasOwnData("__regex__")) {
                return (EvValueBridge.taggedString(("/" + ((this.regexSourceOf(v)) + ("/" + (this.regexFlagsOf(v)))))))
            }
            if (v.hasOwnData("__error__")) {
                return (EvValueBridge.taggedString((this.errorToString(v))))
            }
            ; D-DATE: the default Date.prototype.toString, which is the whole
            ; date and time rather than a brand.
            if (v.hasOwnData("__date__")) {
                def dtd (new DateTime())
                return (EvValueBridge.taggedString((dtd.toFullString(((v.getOwnData("__date__")).toNumber())))))
            }
            return (EvValueBridge.taggedString(("[object " + (this.objectClassOf(v)) + "]")))
        }
        if (v.isArrayValue()) {
            return (EvValueBridge.taggedString((this.arrayJoinString(v ","))))
        }
        if (v.isFunction()) {
            return (EvValueBridge.taggedString((this.functionSourceText(v))))
        }
        return (EvValueBridge.taggedString(("[object " + (this.objectClassOf(v)) + "]")))
    }

    ; D-DATE: the DEFAULT hint -- no hint at all -- behaves as the NUMBER hint
    ; for every object except a Date, which behaves as the STRING hint. That is
    ; what makes `date + ""` the date's string form while `+date` and
    ; `Number(date)` are still its time value.
    ; The DEFAULT valueOf yields the object itself for almost everything, and
    ; that is no primitive -- which is why a number hint normally falls through
    ; to toString. Two kinds are different: a boxed primitive reports its
    ; primitive, and a Date reports its time value. `+new Date(6)` is 6 for
    ; exactly this reason.
    fn defaultValueOfIsPrimitive:boolean (v:EvHandle) {
        if (false == (v.isObject())) {
            return false
        }
        if (v.hasOwnData("__primitive__")) {
            return true
        }
        if (v.hasOwnData("__date__")) {
            return true
        }
        return false
    }

    fn defaultValueOfOf:EvHandle (v:EvHandle) {
        if (v.hasOwnData("__primitive__")) {
            return (v.getOwnData("__primitive__"))
        }
        if (v.hasOwnData("__date__")) {
            return (v.getOwnData("__date__"))
        }
        return v
    }

    fn toPrimitiveDefault:EvHandle (v:EvHandle) {
        if (v.isObject()) {
            if (v.hasOwnData("__date__")) {
                return (this.toPrimitive(v true))
            }
        }
        return (this.toPrimitive(v false))
    }

    fn toPrimitive:EvHandle (v:EvHandle wantString:boolean) {
        ; Arrays and functions are object-like too and must convert, which is why
        ; `[1,2] + ''` is "1,2" and `+fn` is NaN. All three kinds run the SAME
        ; ordered pair -- valueOf then toString for a number hint, the other way
        ; for a string hint. Arrays and functions used to consult toString only,
        ; so a `valueOf` the guest hung on one was never asked, and a boxed
        ; primitive short-circuited to its primitive before either method got a
        ; turn: `(new String("ABC")).valueOf = f` had no effect.
        def objLike:boolean false
        if (v.isArrayValue()) { objLike = true }
        if (v.isObject()) { objLike = true }
        if (v.isFunction()) { objLike = true }
        ; D-BIGINT: a BigInt IS a primitive -- it is only carried as an object.
        ; Converting one here reached its `toString` and handed back the digits
        ; as a STRING, so `2n + 3n` concatenated to "23" instead of adding.
        ; Symbols are already exempt for exactly the same reason.
        if (this.isBigIntValue(v)) { objLike = false }
        ; ...and a SYMBOL is not object-like either, for the same reason: it is
        ; a primitive wearing an object's representation here. Left in, it ran
        ; its own toString and `"" + sym` produced "[object Object]" instead of
        ; the TypeError that is the whole point of a symbol refusing ToString.
        if (this.isSymbolValue(v)) { objLike = false }
        if (objLike == false) {
            return v
        }
        ; ES2015: @@toPrimitive, when the object has one, IS the conversion --
        ; it is called with the hint and its answer stands, ahead of the
        ; valueOf/toString pair. Nothing consulted it, so an object that
        ; defines one converted through the ordinary methods instead.
        def tpFn:EvHandle (this.getPropertyValue(v "@@toPrimitive"))
        if scriptThrew {
            return v
        }
        if (tpFn.isFunction()) {
            if (tpFn.hasFunctionNode()) {
                def hint:string "number"
                if wantString { hint = "string" }
                def tpArgs:[EvHandle]
                push tpArgs (EvValueBridge.taggedString(hint))
                def tpRes:EvHandle (this.callFnValueWithValues((tpFn.withThisForCall(v)) tpArgs))
                if scriptThrew {
                    return v
                }
                ; An object answer is a TypeError: the point of the hook is to
                ; produce a primitive.
                if (this.isDescriptorObject(tpRes)) {
                    return (this.throwSpecError("TypeError" "Cannot convert object to primitive value"))
                }
                return tpRes
            }
        }
        def boxed:boolean (this.defaultValueOfIsPrimitive(v))
        def first:string "valueOf"
        def second:string "toString"
        if wantString {
            first = "toString"
            second = "valueOf"
        }
        def r1:EvHandle (this.callPrimitiveMethod(v first))
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        if primitiveMethodUsable {
            return r1
        }
        ; The step produced nothing usable. When it resolved to the BUILT-IN
        ; method, that method's own answer stands and the second step is never
        ; reached -- which is what makes `String({valueOf: f})` the brand rather
        ; than f's number. The default valueOf is the exception: it returns the
        ; object itself, which is no primitive, so only a boxed primitive can
        ; answer from that step.
        if (this.usesDefaultMethod(v first)) {
            if (first == "toString") {
                return (this.defaultPrimitiveOf(v))
            }
            if boxed {
                return (this.defaultValueOfOf(v))
            }
        }
        def r2:EvHandle (this.callPrimitiveMethod(v second))
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        if primitiveMethodUsable {
            return r2
        }
        if (this.usesDefaultMethod(v second)) {
            if (second == "toString") {
                return (this.defaultPrimitiveOf(v))
            }
            if boxed {
                return (this.defaultValueOfOf(v))
            }
        }
        ; Neither step yielded a primitive, and neither fell back to a default.
        ; That is the spec's TypeError -- an object whose valueOf and toString
        ; both return objects cannot be converted, and the suite checks that it
        ; says so rather than inventing an answer.
        return (this.throwSpecError("TypeError" "Cannot convert object to primitive value"))
    }

    ; ToNumber, honouring ToPrimitive for objects.
    ; D-STRNUM: ToNumber applied to a string, per the StringNumericLiteral
    ; grammar rather than by handing the text to the host parser. Two things go
    ; wrong otherwise: the host parse is LENIENT, so "12x" came back as 12 where
    ; the spec says NaN, and it knows nothing of the 0x / 0b / 0o prefixes, so
    ; Number("0xff") was 0.
    fn stringToNumber:double (raw:string) {
        def nan:double (0.0 / 0.0)
        def inf:double (1.0 / 0.0)
        ; D-STRNUM: StrWhiteSpace is the full WhiteSpace + LineTerminator set,
        ; not the host `trim`'s idea of it -- `Number("\u00A0 1")` is 1, and
        ; a string of nothing but those characters is +0.
        def s:string (this.trimJs(raw true true))
        def n:int (strlen s)
        if (n == 0) {
            return 0.0
        }
        ; Sign, which only a decimal literal or Infinity may carry.
        def sign:double 1.0
        def i:int 0
        def first:string (substring s 0 1)
        if (first == "-") {
            sign = (0.0 - 1.0)
            i = 1
        }
        if (first == "+") {
            i = 1
        }
        def body:string (substring s i n)
        if (body == "Infinity") {
            return (sign * inf)
        }
        if ((strlen body) == 0) {
            return nan
        }
        ; A radix prefix is only legal WITHOUT a sign.
        if ((i == 0) && ((strlen s) > 2)) {
            def p2:string (substring s 0 2)
            def radix:int 0
            if ((p2 == "0x") || (p2 == "0X")) { radix = 16 }
            if ((p2 == "0b") || (p2 == "0B")) { radix = 2 }
            if ((p2 == "0o") || (p2 == "0O")) { radix = 8 }
            if (radix > 0) {
                def digits:string (substring s 2 (strlen s))
                return (this.digitsToNumber(digits radix))
            }
        }
        ; Decimal: the whole remainder must be a well-formed literal, or the
        ; answer is NaN. The host parser stops at the first bad character and
        ; reports what it read, which is why this is validated first.
        if (false == (this.isDecimalLiteral(body))) {
            return nan
        }
        def d@(optional):double (to_double body)
        if d {
            return (sign * (unwrap d))
        }
        return nan
    }

    ; Digits in a given radix, or NaN when any character is not a digit of it.
    fn digitsToNumber:double (digits:string radix:int) {
        def nan:double (0.0 / 0.0)
        def n:int (strlen digits)
        if (n == 0) {
            return nan
        }
        def acc:double 0.0
        def i:int 0
        while (i < n) {
            def c:int (charAt digits i)
            def dv:int (0 - 1)
            if ((c >= 48) && (c <= 57)) { dv = (c - 48) }
            if ((c >= 97) && (c <= 122)) { dv = ((c - 97) + 10) }
            if ((c >= 65) && (c <= 90)) { dv = ((c - 65) + 10) }
            if (dv < 0) { return nan }
            if (dv >= radix) { return nan }
            acc = ((acc * (to_double radix)) + (to_double dv))
            i = (i + 1)
        }
        return acc
    }

    ; DecimalLiteral: digits with at most one dot, an optional exponent, and at
    ; least one digit in the mantissa.
    fn isDecimalLiteral:boolean (s:string) {
        def n:int (strlen s)
        if (n == 0) {
            return false
        }
        def i:int 0
        def mantissaDigits:int 0
        def dots:int 0
        def seenExp:boolean false
        def expDigits:int 0
        while (i < n) {
            def c:int (charAt s i)
            def isDigit:boolean ((c >= 48) && (c <= 57))
            if seenExp {
                if isDigit {
                    expDigits = (expDigits + 1)
                } {
                    ; A sign is allowed, but only right after the e.
                    if ((c == 43) || (c == 45)) {
                        if (expDigits > 0) { return false }
                        ; and only once, which a second sign would violate
                        if (i > 0) {
                            def prev:int (charAt s (i - 1))
                            if ((prev != 101) && (prev != 69)) { return false }
                        }
                    } {
                        return false
                    }
                }
            } {
                if isDigit {
                    mantissaDigits = (mantissaDigits + 1)
                } {
                    if (c == 46) {
                        dots = (dots + 1)
                        if (dots > 1) { return false }
                    } {
                        if ((c == 101) || (c == 69)) {
                            if (mantissaDigits == 0) { return false }
                            seenExp = true
                        } {
                            return false
                        }
                    }
                }
            }
            i = (i + 1)
        }
        if (mantissaDigits == 0) {
            return false
        }
        if seenExp {
            if (expDigits == 0) { return false }
        }
        return true
    }

    ; ToInteger: ToNumber, then truncate toward zero, with NaN becoming 0. The
    ; argument-taking Number methods are specified against this, and handing
    ; `to_int` a NaN directly produced a nonsense digit count.
    ; ToInteger without the int32 saturation: a fromIndex is compared against a
    ; length in the double domain before it is narrowed, so saturating first
    ; would turn `indexOf(x, 1e30)` into a search from INT_MAX rather than a
    ; miss.
    fn toIntegerDoubleOf:double (v:EvHandle) {
        def d:double (this.toNumberOf(v))
        if (d != d) {
            return 0.0
        }
        if (false == (this.isFiniteNum(d))) {
            if (d > 0.0) {
                return (1.0 / 0.0)
            }
            return (0.0 - (1.0 / 0.0))
        }
        return (this.truncNum(d))
    }

    fn toIntegerOf:int (v:EvHandle) {
        def d:double (this.toNumberOf(v))
        if (d != d) {
            return 0
        }
        if (false == (this.isFiniteNum(d))) {
            if (d > 0.0) { return 2147483647 }
            return (0 - 2147483647)
        }
        ; Truncate TOWARD ZERO in the double domain (see floorNum), then
        ; SATURATE at the int32 range: the return type is the target's int,
        ; which is 32 bits on C++, where an unguarded conversion of a larger
        ; magnitude is undefined behavior (x86 answers INT32_MIN). Every
        ; caller compares against string/array lengths, so the saturated
        ; value behaves identically to the unrepresentable exact one.
        def t:double (this.truncNum(d))
        if (t >= 2147483647.0) {
            return 2147483647
        }
        if (t <= (0.0 - 2147483647.0)) {
            return (0 - 2147483647)
        }
        return (to_int t)
    }

    ; ToUint16: ToInteger, then reduced modulo 2^16 into [0, 65535].
    ; ToInt32: ToNumber, truncate, then wrap modulo 2^32 into the signed range.
    ; The bitwise and shift operators are all specified against it, and reading
    ; `.toNumber()` off the value skipped the object conversion entirely --
    ; `({valueOf: function () { return 1; }}) << 1` answered 0.
    fn toInt32Of:int (v:EvHandle) {
        return (this.int32OfNum((this.toNumberOf(v))))
    }

    ; ToInt32 on a raw double. Split out of toInt32Of so the VM's unboxed
    ; bitwise fast path and the boxed path cannot drift apart: a tag-1 slot
    ; already holds the double that toNumberOf would return.
    fn int32OfNum:int (d:double) {
        if (d != d) { return 0 }
        if (false == (this.isFiniteNum(d))) { return 0 }
        def t:double (this.floorNum(d))
        if (d < 0.0) {
            t = (0.0 - (this.floorNum((0.0 - d))))
        }
        def m:double (this.wrapUint32(t))
        def half:double 2147483648.0
        if (m >= half) {
            m = (m - (half * 2.0))
        }
        return (to_int m)
    }

    ; The value reduced into [0, 2^32).
    fn wrapUint32:double (t:double) {
        def two32:double 4294967296.0
        def q:double (this.floorNum((t / two32)))
        def m:double (t - (q * two32))
        if (m < 0.0) { m = (m + two32) }
        return m
    }

    ; ToUint32, as an int. Values at or above 2^31 saturate, since Ranger's int
    ; is signed 32-bit -- a limit that large is beyond any real string anyway.
    fn toUint32Of:int (v:EvHandle) {
        def d:double (this.toNumberOf(v))
        if (d != d) { return 0 }
        if (false == (this.isFiniteNum(d))) { return 0 }
        def t:double (this.floorNum(d))
        if (d < 0.0) {
            t = (0.0 - (this.floorNum((0.0 - d))))
        }
        def m:double (this.wrapUint32(t))
        if (m > 2147483647.0) {
            return 2147483647
        }
        return (to_int m)
    }

    ; D-CODEUNIT: a code unit as a string. `strfromcode` writes ONE unit, which
    ; on the byte-model targets means one BYTE -- so every value above 255 was
    ; silently truncated and `String.fromCharCode(-1)` answered U+00FF instead
    ; of U+FFFF. The probe below asks the target which model it is in: a
    ; char-model target round-trips 8232 through strfromcode/charAt, a byte
    ; model does not, and there the unit is written as its UTF-8 bytes.
    fn codeUnitString:string (code:int) {
        if (code < 128) {
            return (strfromcode code)
        }
        if ((charAt (strfromcode 8232) 0) == 8232) {
            return (strfromcode code)
        }
        def lo6:int (bit_and code 63)
        if (code < 2048) {
            def hi5:int (to_int ((to_double code) / 64.0))
            return ((strfromcode (192 + hi5)) + (strfromcode (128 + lo6)))
        }
        def mid6:int (bit_and (to_int ((to_double code) / 64.0)) 63)
        def hi4:int (to_int ((to_double code) / 4096.0))
        return ((strfromcode (224 + hi4)) + ((strfromcode (128 + mid6)) + (strfromcode (128 + lo6))))
    }

    fn toUint16Of:int (v:EvHandle) {
        def d:double (this.toNumberOf(v))
        ; NaN and the infinities all map to +0 before the modulo, so
        ; String.fromCharCode(Infinity) is "\u0000" rather than "\uffff".
        if (d != d) {
            return 0
        }
        if (false == (this.isFiniteNum(d))) {
            return 0
        }
        ; The modulo is taken in DOUBLE space. Going through toIntegerOf
        ; first clamps at the 32-bit maximum, so String.fromCharCode(2^32 - 2)
        ; answered 65535 -- 2147483647 mod 65536 -- instead of 65534.
        def t:double (this.truncNum(d))
        def m:double (this.modNum(t 65536.0))
        if (m < 0.0) {
            m = (m + 65536.0)
        }
        return (to_int m)
    }

    fn toNumberOf:double (v:EvHandle) {
        ; PERF: a value that already IS a number converts to itself; the
        ; toPrimitive round-trip below is an identity walk for it, paid on
        ; every arithmetic compare.
        if (v.isNumber()) {
            return v.numberValue
        }
        ; §7.1.4: ToNumber of a BigInt is a TypeError. `Number(1n)` is the
        ; explicit conversion and goes a different way; an implicit one is
        ; exactly what the type is meant to prevent.
        if (this.isBigIntValue(v)) {
            def _bn:EvHandle (this.throwSpecError("TypeError" "Cannot convert a BigInt value to a number"))
            return (0.0 / 0.0)
        }
        def p:EvHandle (this.toPrimitive(v false))
        if (p.isString()) {
            return (this.stringToNumber((p.stringOf())))
        }
        if (p.isUndefined()) {
            return (0.0 / 0.0)
        }
        if (p.isNull()) {
            return 0.0
        }
        return (p.toNumber())
    }

    fn arrayNeedsCallback:boolean (name:string) {
        if (name == "forEach") { return true }
        if (name == "map") { return true }
        if (name == "filter") { return true }
        if (name == "find") { return true }
        if (name == "findIndex") { return true }
        if (name == "some") { return true }
        if (name == "every") { return true }
        if (name == "reduce") { return true }
        if (name == "reduceRight") { return true }
        return false
    }

    ; D-DESCVALID: a property descriptor may be a DATA descriptor (value and/or
    ; writable) or an ACCESSOR descriptor (get and/or set), never both, and its
    ; get/set must be callable. Accepting a contradictory descriptor silently
    ; produced a property that matched neither shape.
    fn descriptorError:string (d:EvHandle) {
        def hasValue:boolean (this.descHas(d "value"))
        def hasWritable:boolean (this.descHas(d "writable"))
        def hasGet:boolean (this.descHas(d "get"))
        def hasSet:boolean (this.descHas(d "set"))
        if (hasGet || hasSet) {
            if (hasValue || hasWritable) {
                return "descriptor cannot be both a data and an accessor descriptor"
            }
            if hasGet {
                def g:EvHandle (this.descGet(d "get"))
                if (false == (g.isFunction())) {
                    if (false == (g.isUndefined())) {
                        return "getter must be a function"
                    }
                }
            }
            if hasSet {
                def st:EvHandle (this.descGet(d "set"))
                if (false == (st.isFunction())) {
                    if (false == (st.isUndefined())) {
                        return "setter must be a function"
                    }
                }
            }
        }
        return ""
    }

    ; D-REDEFINE: whether a defineProperty call is legal against the property
    ; that is already there. A NON-CONFIGURABLE property is close to frozen: its
    ; configurable and enumerable flags cannot change, and if it is also
    ; non-writable neither its writability nor its value may change. Adding a
    ; new property to a non-extensible object is likewise rejected. Accepting
    ; any of these silently let a test's setup succeed where the spec requires
    ; it to fail. Returns "" when the redefinition is allowed.
    ; ==========================================================================
    ; D-REGEX: RegExp values, and the four String methods specified against them.
    ; --------------------------------------------------------------------------
    ; A RegExp is an ordinary object carrying its source and flags plus the
    ; internal marker `__regex__`. The compiled program is NOT stored on it --
    ; Ranger has no way to put a RegexProgram inside an EvHandle -- so it is
    ; recompiled from source at each use. That is slower than caching and
    ; entirely invisible to the guest, which is the trade this design makes.
    ; --------------------------------------------------------------------------
    fn buildRegexFromArgs:EvHandle (argNodes:[TSNode]) {
        return (this.buildRegexFromArgNodes(argNodes false))
    }

    ; D-REGEX: `RegExp(re)` called as a FUNCTION with no flags answers `re`
    ; ITSELF -- 15.10.3.1 -- while `new RegExp(re)` makes a copy. Copying in both
    ; forms meant a property later put on the original was invisible through the
    ; result.
    fn buildRegexFromArgNodes:EvHandle (argNodes:[TSNode] asNew:boolean) {
        def pattern:string ""
        def flags:string ""
        def sawFlags:boolean false
        def srcRegex:EvHandle (EvValueBridge.taggedNull())
        if ((array_length argNodes) > 0) {
            def pv:EvHandle (this.evaluateExpr((itemAt argNodes 0)))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            if (this.isRegexValue(pv)) {
                srcRegex = pv
                pattern = (this.regexSourceOf(pv))
                flags = (this.regexFlagsOf(pv))
            } {
                if (false == (pv.isUndefined())) {
                    pattern = (this.toStringOf(pv))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                }
            }
        }
        if ((array_length argNodes) > 1) {
            def fv:EvHandle (this.evaluateExpr((itemAt argNodes 1)))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            if (false == (fv.isUndefined())) {
                flags = (this.toStringOf(fv))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                sawFlags = true
            }
        }
        ; D-REGEX: the plain call form answers its argument UNCHANGED when it is
        ; already a RegExp and no flags are given (15.10.3.1). Supplying flags
        ; re-reads the source with them -- ES5 made that a TypeError, ES2015
        ; allows it, and the current corpus is written against ES2015.
        if (srcRegex.isObject()) {
            if (false == sawFlags) {
                if (false == asNew) {
                    return srcRegex
                }
            }
        }
        def flagErr:string (this.regexFlagError(flags))
        if ((strlen flagErr) > 0) {
            return (this.throwSpecError("SyntaxError" flagErr))
        }
        ; A malformed pattern is a SyntaxError at construction, not at first use.
        def probe (new RegexCompiler)
        def prog:RegexProgram (probe.compile(pattern flags))
        if (false == prog.valid) {
            return (this.throwSpecError("SyntaxError" ("Invalid regular expression: " + prog.errorMessage)))
        }
        return (this.makeRegexValue(pattern flags))
    }

    ; D-REGEX: the same construction as buildRegexFromArgNodes, from values that
    ; have already been evaluated -- which is what a captured constructor has.
    fn buildRegexFromValues:EvHandle (args:[EvHandle] asNew:boolean) {
        def pattern:string ""
        def flags:string ""
        def sawFlags:boolean false
        def srcRegex:EvHandle (EvValueBridge.taggedNull())
        if ((array_length args) > 0) {
            def pv:EvHandle (itemAt args 0)
            if (this.isRegexValue(pv)) {
                srcRegex = pv
                pattern = (this.regexSourceOf(pv))
                flags = (this.regexFlagsOf(pv))
            } {
                if (false == (pv.isUndefined())) {
                    pattern = (this.toStringOf(pv))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                }
            }
        }
        if ((array_length args) > 1) {
            def fv:EvHandle (itemAt args 1)
            if (false == (fv.isUndefined())) {
                flags = (this.toStringOf(fv))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                sawFlags = true
            }
        }
        if (srcRegex.isObject()) {
            if (false == sawFlags) {
                if (false == asNew) {
                    return srcRegex
                }
            }
        }
        def flagErr2:string (this.regexFlagError(flags))
        if ((strlen flagErr2) > 0) {
            return (this.throwSpecError("SyntaxError" flagErr2))
        }
        def probe2 (new RegexCompiler)
        def prog2:RegexProgram (probe2.compile(pattern flags))
        if (false == prog2.valid) {
            return (this.throwSpecError("SyntaxError" ("Invalid regular expression: " + prog2.errorMessage)))
        }
        return (this.makeRegexValue(pattern flags))
    }

    ; D-REGEX: the flag set is d, g, i, m, s, u and y, each at most once.
    ; Anything else is a SyntaxError. The list used to be the ES5 three, so a
    ; pattern built with `new RegExp(p, 'u')` was rejected outright even though
    ; the compiler understood the flag -- the literal form reached the compiler
    ; directly and the constructor form did not.
    fn regexFlagError:string (flags:string) {
        def seen:string ""
        def i:int 0
        while (i < (strlen flags)) {
            def f:string (substring flags i (i + 1))
            def known:boolean false
            if (f == "d") { known = true }
            if (f == "g") { known = true }
            if (f == "i") { known = true }
            if (f == "m") { known = true }
            if (f == "s") { known = true }
            if (f == "u") { known = true }
            if (f == "v") { known = true }
            if (f == "y") { known = true }
            if (false == known) {
                return ("Invalid flags supplied to RegExp constructor '" + (flags + "'"))
            }
            if ((indexOf seen f) >= 0) {
                return ("Invalid flags supplied to RegExp constructor '" + (flags + "'"))
            }
            seen = (seen + f)
            i = (i + 1)
        }
        ; §22.2.3.3: `u` and `v` are alternatives, not companions -- `v` IS
        ; Unicode mode, with a different class grammar, so asking for both is a
        ; SyntaxError rather than a stronger request.
        if ((indexOf seen "u") >= 0) {
            if ((indexOf seen "v") >= 0) {
                return ("Invalid flags supplied to RegExp constructor '" + (flags + "'"))
            }
        }
        return ""
    }

    fn makeRegexValue:EvHandle (pattern:string flags:string) {
        def keysR:[string]
        def valsR:[EvHandle]
        def r:EvHandle (EvValueBridge.taggedObject(keysR valsR))
        r.setMember("__regex__" (EvValueBridge.taggedString(pattern)))
        r.setAttrs("__regex__" false false false)
        r.setMember("source" (EvValueBridge.taggedString(pattern)))
        r.setAttrs("source" false false false)
        r.setMember("flags" (EvValueBridge.taggedString(flags)))
        r.setAttrs("flags" false false false)
        r.setMember("global" (EvValueBridge.taggedBoolean(((indexOf flags "g") >= 0))))
        r.setAttrs("global" false false false)
        r.setMember("ignoreCase" (EvValueBridge.taggedBoolean(((indexOf flags "i") >= 0))))
        r.setAttrs("ignoreCase" false false false)
        r.setMember("multiline" (EvValueBridge.taggedBoolean(((indexOf flags "m") >= 0))))
        r.setAttrs("multiline" false false false)
        ; The ES2015+ flag accessors. Each is a real property here rather than a
        ; prototype getter, which is how global/ignoreCase/multiline are already
        ; carried; absent, `/x/s.dotAll` was undefined.
        r.setMember("sticky" (EvValueBridge.taggedBoolean(((indexOf flags "y") >= 0))))
        r.setAttrs("sticky" false false false)
        r.setMember("unicode" (EvValueBridge.taggedBoolean(((indexOf flags "u") >= 0))))
        r.setAttrs("unicode" false false false)
        r.setMember("dotAll" (EvValueBridge.taggedBoolean(((indexOf flags "s") >= 0))))
        r.setAttrs("dotAll" false false false)
        r.setMember("unicodeSets" (EvValueBridge.taggedBoolean(((indexOf flags "v") >= 0))))
        r.setAttrs("unicodeSets" false false false)
        r.setMember("hasIndices" (EvValueBridge.taggedBoolean(((indexOf flags "d") >= 0))))
        r.setAttrs("hasIndices" false false false)
        ; lastIndex is the one WRITABLE property -- exec advances it -- but it is
        ; not enumerable, so it never shows up in Object.keys or as a descriptor
        ; when a RegExp is handed to Object.defineProperties.
        r.setMember("lastIndex" (EvHandle.fromInt(0)))
        r.setAttrs("lastIndex" true false false)
        r.setProto((this.builtinPrototype("RegExp")))
        return r
    }

    ; "Name: message", with either half omitted when empty -- the shape
    ; Error.prototype.toString produces.
    fn errorToString:string (e:EvHandle) {
        def nm:string "Error"
        def nv:EvHandle (e.getMember("name"))
        if (nv.isString()) { nm = (nv.stringOf()) }
        def msg:string ""
        def mv:EvHandle (e.getMember("message"))
        if (mv.isString()) { msg = (mv.stringOf()) }
        if ((strlen msg) == 0) {
            return nm
        }
        if ((strlen nm) == 0) {
            return msg
        }
        return (nm + (": " + msg))
    }

    fn isRegexValue:boolean (v:EvHandle) {
        if (false == (v.isObject())) {
            return false
        }
        return (v.hasOwnData("__regex__"))
    }

    fn regexFlagsOf:string (v:EvHandle) {
        def f:EvHandle (v.getMember("flags"))
        if (f.isString()) {
            return (f.stringOf())
        }
        return ""
    }

    fn regexSourceOf:string (v:EvHandle) {
        def sv:EvHandle (v.getMember("source"))
        if (sv.isString()) {
            return (sv.stringOf())
        }
        return ""
    }

    ; Compile the pattern a RegExp value carries. A malformed pattern is a
    ; SyntaxError to the guest, which is where the spec puts it.
    fn compileRegexOf:RegexProgram (v:EvHandle) {
        ; PERF: the compiled program is CACHED by flags+source — exec/test in
        ; a loop recompiled the pattern on every call (a third of the regex
        ; benchmark's native instructions). The program is immutable after
        ; compile (match state lives in RegexMatcher / on the regex value),
        ; so one compilation serves every use of the same literal.
        def src:string (this.regexSourceOf(v))
        def flg:string (this.regexFlagsOf(v))
        def ck:string (flg + (":" + src))
        def hit@(optional):RegexProgram (get regexProgCache ck)
        if hit {
            return (unwrap hit)
        }
        def c (new RegexCompiler)
        def prog:RegexProgram (c.compile(src flg))
        set regexProgCache ck prog
        return prog
    }

    ; The `/.../flags` literal text the lexer hands over, split at the LAST
    ; slash -- the pattern may contain escaped ones.
    fn regexFromLiteral:EvHandle (text:string) {
        def n:int (strlen text)
        def last:int (0 - 1)
        def i:int 1
        def esc:boolean false
        def inClass:boolean false
        while (i < n) {
            def ch:string (substring text i (i + 1))
            if esc {
                esc = false
            } {
                if (ch == "\\") {
                    esc = true
                } {
                    if (ch == "[") { inClass = true }
                    if (ch == "]") { inClass = false }
                    if (ch == "/") {
                        if (false == inClass) { last = i }
                    }
                }
            }
            i = (i + 1)
        }
        if (last < 0) {
            return (this.makeRegexValue("" ""))
        }
        def pattern:string (substring text 1 last)
        def flags:string (substring text (last + 1) n)
        return (this.makeRegexValue(pattern flags))
    }

    ; The array `exec` returns: the whole match at index 0, then each capture,
    ; plus `index` and `input`. A capture that did not participate is undefined,
    ; not "".
    fn regexResultArray:EvHandle (m:RegexMatch subject:string prog:RegexProgram) {
        def items:[EvHandle]
        push items (EvValueBridge.taggedString((this.cuSlice(subject m.start m.end))))
        def gi:int 1
        while (gi < (array_length m.capStart)) {
            def cs:int (itemAt m.capStart gi)
            def ce:int (itemAt m.capEnd gi)
            if (cs < 0) {
                push items (EvValueBridge.taggedUndefined())
            } {
                push items (EvValueBridge.taggedString((this.cuSlice(subject cs ce))))
            }
            gi = (gi + 1)
        }
        def arr:EvHandle (EvValueBridge.taggedArray(items))
        arr.setMember("index" (EvHandle.fromInt(m.start)))
        arr.setMember("input" (EvValueBridge.taggedString(subject)))
        ; §22.2.7.2 step 34: `groups` is an object of the NAMED captures when
        ; the pattern has any, and undefined when it has none -- undefined
        ; rather than an empty object, which is what a guest tests for.
        def named:boolean false
        def nk:int 1
        while (nk < (array_length prog.groupNames)) {
            if ((strlen (itemAt prog.groupNames nk)) > 0) { named = true }
            nk = (nk + 1)
        }
        def groupsV:EvHandle (EvValueBridge.taggedUndefined())
        if named {
            def gkeys:[string]
            def gvals:[EvHandle]
            def gobj:EvHandle (EvValueBridge.taggedObject(gkeys gvals))
            gobj.setProto((EvValueBridge.taggedNull()))
            def ng:int 1
            while (ng < (array_length prog.groupNames)) {
                def gname:string (itemAt prog.groupNames ng)
                if ((strlen gname) > 0) {
                    def gv:EvHandle (EvValueBridge.taggedUndefined())
                    if (ng < (array_length m.capStart)) {
                        def gcs:int (itemAt m.capStart ng)
                        if (gcs >= 0) {
                            gv = (EvValueBridge.taggedString((this.cuSlice(subject gcs (itemAt m.capEnd ng)))))
                        }
                    }
                    gobj.setMember(gname gv)
                }
                ng = (ng + 1)
            }
            groupsV = gobj
        }
        arr.setMember("groups" groupsV)
        ; §22.2.7.2 step 35: the `d` flag adds an `indices` array shaped exactly
        ; like the result -- a [start, end] pair per capture, undefined for one
        ; that did not participate, and its own `groups` alongside.
        if prog.hasIndices {
            def idxItems:[EvHandle]
            def wholePair:[EvHandle]
            push wholePair (EvHandle.fromInt(m.start))
            push wholePair (EvHandle.fromInt(m.end))
            push idxItems (EvValueBridge.taggedArray(wholePair))
            def ii:int 1
            while (ii < (array_length m.capStart)) {
                def ics:int (itemAt m.capStart ii)
                if (ics < 0) {
                    push idxItems (EvValueBridge.taggedUndefined())
                } {
                    def pair:[EvHandle]
                    push pair (EvHandle.fromInt(ics))
                    push pair (EvHandle.fromInt((itemAt m.capEnd ii)))
                    push idxItems (EvValueBridge.taggedArray(pair))
                }
                ii = (ii + 1)
            }
            def idxArr:EvHandle (EvValueBridge.taggedArray(idxItems))
            def idxGroups:EvHandle (EvValueBridge.taggedUndefined())
            if named {
                def igk:[string]
                def igv:[EvHandle]
                def igobj:EvHandle (EvValueBridge.taggedObject(igk igv))
                igobj.setProto((EvValueBridge.taggedNull()))
                def ig:int 1
                while (ig < (array_length prog.groupNames)) {
                    def igname:string (itemAt prog.groupNames ig)
                    if ((strlen igname) > 0) {
                        def igv2:EvHandle (EvValueBridge.taggedUndefined())
                        if (ig < (array_length m.capStart)) {
                            def igcs:int (itemAt m.capStart ig)
                            if (igcs >= 0) {
                                def gpair:[EvHandle]
                                push gpair (EvHandle.fromInt(igcs))
                                push gpair (EvHandle.fromInt((itemAt m.capEnd ig)))
                                igv2 = (EvValueBridge.taggedArray(gpair))
                            }
                        }
                        igobj.setMember(igname igv2)
                    }
                    ig = (ig + 1)
                }
                idxGroups = igobj
            }
            idxArr.setMember("groups" idxGroups)
            arr.setMember("indices" idxArr)
        }
        return arr
    }

    ; RegExp.prototype.exec, honouring lastIndex for a global pattern.
    fn regexExec:EvHandle (re:EvHandle subject:string) {
        def prog:RegexProgram (this.compileRegexOf(re))
        if (false == prog.valid) {
            return (this.throwSpecError("SyntaxError" ("Invalid regular expression: " + prog.errorMessage)))
        }
        ; D-STICKY: `y` reads and writes lastIndex exactly as `g` does -- the
        ; difference is that the match must BEGIN there. Only `g` was consulted,
        ; so a sticky pattern searched from 0 and never updated lastIndex.
        def usesLastIndex:boolean false
        if prog.global { usesLastIndex = true }
        if prog.sticky { usesLastIndex = true }
        def from:int 0
        if usesLastIndex {
            from = (this.toIntegerOf((re.getMember("lastIndex"))))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
        }
        if ((from > (this.cuLen(subject))) || (from < 0)) {
            if usesLastIndex {
                this.setLastIndexOrThrow(re 0)
            }
            return (EvValueBridge.taggedNull())
        }
        def matcher (new RegexMatcher)
        matcher.setup(prog subject)
        def m:RegexMatch (matcher.exec(from))
        ; A sticky match that did not start at lastIndex did not match at all.
        if m.matched {
            if prog.sticky {
                if (m.start != from) {
                    m.matched = false
                }
            }
        }
        if (false == m.matched) {
            if usesLastIndex {
                this.setLastIndexOrThrow(re 0)
            }
            return (EvValueBridge.taggedNull())
        }
        if usesLastIndex {
            this.setLastIndexOrThrow(re m.end)
        }
        return (this.regexResultArray(m subject prog))
    }

    ; ==========================================================================
    ; D-PROMISE: Promise, as an object with a settled state and a reaction list.
    ; --------------------------------------------------------------------------
    ; The realm has no host event loop, so "later" means "after this script's
    ; synchronous work". drainJobs is called at the end of loadScript and of each
    ; host-entered call, which is the whole of the observable ordering here: a
    ; reaction runs after the code that registered it and before control returns
    ; to the embedder.
    ; --------------------------------------------------------------------------
    ; D-ITERATOR: one iterator object shape serves Array, String, Map and Set.
    ; It walks a snapshot list, which is what an eagerly-materialised iteration
    ; already is here -- the point is that `[].values()` is a real object with a
    ; real `next`, reachable as a value and usable by any for-of.
    ; The iterator prototype for one KIND of iterable. Array, Map, Set and
    ; String each have their own -- they differ only by their @@toStringTag,
    ; but that tag is read off the PROTOTYPE, so one shared object cannot
    ; answer for all four.
    fn kindIteratorPrototype:EvHandle (tag:string) {
        def pkey:string ("@@iterproto:" + tag)
        def foundK@(optional):EvHandle (get builtinGlobals pkey)
        if (!null? foundK) {
            return (unwrap foundK)
        }
        def keysK:[string]
        def valsK:[EvHandle]
        def pk:EvHandle (EvValueBridge.taggedObject(keysK valsK))
        ; %ArrayIteratorPrototype% and its siblings inherit from
        ; %IteratorPrototype%, not from Object.prototype directly -- which is
        ; what makes `[].values() instanceof Iterator` true and what puts the
        ; helpers within reach of every iterator, not just a bare one.
        pk.setProto((this.listIteratorPrototype()))
        pk.setMember("__protokind__" (EvValueBridge.taggedString("listiterator")))
        pk.setMember("next" (this.sharedNativeMethod("listiterator" "next")))
        pk.setAttrs("next" true false true)
        pk.setMember("@@iterator" (this.sharedNativeMethod("listiterator" "@@iterator")))
        pk.setAttrs("@@iterator" true false true)
        pk.setMember("@@toStringTag" (EvValueBridge.taggedString(tag)))
        pk.setAttrs("@@toStringTag" false false true)
        this.installIteratorHelpers(pk)
        set builtinGlobals pkey pk
        return (unwrap (get builtinGlobals pkey))
    }

    ; The ES2025 iterator helpers, installed from the registry rather than
    ; listed twice -- both iterator prototypes get exactly the set the registry
    ; knows, so a name cannot be published without an implementation behind it.
    fn installIteratorHelpers:void (p:EvHandle) {
        def names:[string] (this.builtinNames("listiterator"))
        def i:int 0
        while (i < (array_length names)) {
            def nm:string (itemAt names i)
            if (nm != "next") {
                if (nm != "@@iterator") {
                    p.setMember(nm (this.sharedNativeMethod("listiterator" nm)))
                    p.setAttrs(nm true false true)
                }
            }
            i = (i + 1)
        }
    }

    fn listIteratorPrototype:EvHandle () {
        if listIterProto {
            return (unwrap listIterProto)
        }
        def keysI:[string]
        def valsI:[EvHandle]
        def p:EvHandle (EvValueBridge.taggedObject(keysI valsI))
        listIterProto = p
        p.setProto((this.builtinPrototype("Object")))
        p.setMember("__protokind__" (EvValueBridge.taggedString("listiterator")))
        p.setMember("next" (this.sharedNativeMethod("listiterator" "next")))
        p.setAttrs("next" true false true)
        p.setMember("@@iterator" (this.sharedNativeMethod("listiterator" "@@iterator")))
        p.setAttrs("@@iterator" true false true)
        this.installIteratorHelpers(p)
        return p
    }

    ; A list iterator branded with the kind whose prototype it should carry.
    ; §24.2.1.2 GetSetRecord: the argument to a set operation is a SET-LIKE --
    ; a `size` that is a number, and callable `has` and `keys`. A real Set is
    ; read directly; anything else is read through its own `keys`, so a guest
    ; object that offers the three participates.
    fn setLikeItems:[EvHandle] (v:EvHandle) {
        def out:[EvHandle]
        if (v.isSet()) {
            def i:int 0
            while (i < (v.denseLen())) {
                push out (v.arrayItemAt(i))
                i = (i + 1)
            }
            return out
        }
        if (false == (this.isDescriptorObject(v))) {
            def _e:EvHandle (this.throwSpecError("TypeError" "The argument is not an object"))
            return out
        }
        def sizeV:EvHandle (this.getPropertyValue(v "size"))
        if scriptThrew { return out }
        def sizeN:double (this.toNumberOf(sizeV))
        if scriptThrew { return out }
        if (sizeN != sizeN) {
            def _e2:EvHandle (this.throwSpecError("TypeError" "The argument has a NaN size"))
            return out
        }
        ; A BUILT-IN method is not an own property of the receiver, so the
        ; ordinary read misses it -- a Map has `has` and `keys` and is a
        ; perfectly good set-like, but only the registry knows that.
        def hasFn:EvHandle (this.setLikeMethod(v "has"))
        if scriptThrew { return out }
        if (false == (hasFn.isFunction())) {
            def _e3:EvHandle (this.throwSpecError("TypeError" "The argument has no callable has"))
            return out
        }
        def keysFn:EvHandle (this.setLikeMethod(v "keys"))
        if scriptThrew { return out }
        if (false == (keysFn.isFunction())) {
            def _e4:EvHandle (this.throwSpecError("TypeError" "The argument has no callable keys"))
            return out
        }
        def noArgs:[EvHandle]
        def iter:EvHandle (this.callFnValueWithValues((keysFn.withThisForCall(v)) noArgs))
        if scriptThrew { return out }
        def got:[EvHandle] (this.forOfItemList(iter))
        if scriptThrew { return out }
        def gi:int 0
        while (gi < (array_length got)) {
            push out (itemAt got gi)
            gi = (gi + 1)
        }
        return out
    }

    ; One of a set-like's three members, read the way a method CALL would find
    ; it: the guest's own or inherited property first, then the registry.
    fn setLikeMethod:EvHandle (v:EvHandle name:string) {
        def got:EvHandle (this.getPropertyValue(v name))
        if scriptThrew { return (EvValueBridge.taggedUndefined()) }
        if (got.isFunction()) { return got }
        def reg:EvHandle (this.builtinMethodValueFor(v name))
        if (reg.isFunction()) { return reg }
        return got
    }

    ; SameValueZero membership over a plain list.
    fn listHasValue:boolean (list:[EvHandle] v:EvHandle) {
        def i:int 0
        while (i < (array_length list)) {
            if (((itemAt list i).equals(v))) { return true }
            i = (i + 1)
        }
        return false
    }

    fn makeKindIterator:EvHandle (items:[EvHandle] tag:string) {
        def keysL:[string]
        def valsL:[EvHandle]
        def it:EvHandle (EvValueBridge.taggedObject(keysL valsL))
        it.setMember("__iterlist__" (EvValueBridge.taggedArray(items)))
        it.setMember("__iteridx__" (EvHandle.fromInt(0)))
        it.setProto((this.kindIteratorPrototype(tag)))
        return it
    }

    fn makeListIterator:EvHandle (items:[EvHandle]) {
        def keysL:[string]
        def valsL:[EvHandle]
        def it:EvHandle (EvValueBridge.taggedObject(keysL valsL))
        it.setMember("__iterlist__" (EvValueBridge.taggedArray(items)))
        it.setMember("__iteridx__" (EvHandle.fromInt(0)))
        it.setProto((this.listIteratorPrototype()))
        return it
    }

    ; The elements a value iterates as: its own for a list-like, [k, v] pairs for
    ; a Map, and the index/value/entry variants an ES2015 iterator method asks
    ; for. `which` is "values", "keys" or "entries".
    fn iterationItemsOf:[EvHandle] (recv:EvHandle which:string) {
        def out:[EvHandle]
        def base:[EvHandle] (this.forOfItemList(recv))
        if (which == "values") {
            return base
        }
        def i:int 0
        while (i < (array_length base)) {
            if (which == "keys") {
                push out (EvHandle.fromInt(i))
            } {
                def pair:[EvHandle]
                push pair (EvHandle.fromInt(i))
                push pair (itemAt base i)
                push out (EvValueBridge.taggedArray(pair))
            }
            i = (i + 1)
        }
        return out
    }

    ; ==========================================================================
    ; D-PROXY: Proxy, as a target plus a handler consulted at every operation.
    ; --------------------------------------------------------------------------
    ; A proxy is not a kind of object here -- it is a marker the object
    ; operations check before doing their own work, which is what lets one
    ; check at the top of getPropertyValue serve `p.k`, `p["k"]`,
    ; `Reflect.get(p, "k")` and `Object.getOwnPropertyDescriptor` alike: every
    ; one of them funnels through the same handful of primitives.
    ; --------------------------------------------------------------------------
    fn isProxyValue:boolean (v:EvHandle) {
        ; PERF: the marker cannot be there if no `__…__` key ever was. Same
        ; monotone bit receiverKind uses; this probe alone was 2.0% of
        ; instructions on the object_props shape.
        if (v.plainMarkerFreeObject()) { return false }
        if (false == (v.isObject())) { return false }
        return (v.hasOwnData("__proxytarget__"))
    }

    fn proxyTargetOf:EvHandle (v:EvHandle) {
        return (v.getOwnData("__proxytarget__"))
    }

    ; Proxy-backed WITHOUT the object test. `p.bind(o)` copies the marker onto
    ; a function stub -- that is what carries the bound receiver -- so the
    ; result is still the proxy's [[Call]] even though its kind is no longer
    ; object. isProxyValue keeps the object test because every other operation
    ; that consults it is an OBJECT operation.
    fn isProxyBackedValue:boolean (v:EvHandle) {
        return (v.hasOwnData("__proxytarget__"))
    }

    ; The trap named `name`, or a non-function when the handler does not supply
    ; one -- in which case the operation runs against the target directly. A
    ; REVOKED proxy has no handler at all and every operation on it is a
    ; TypeError.
    ; D-PROXYINV: the shared post-condition on a `set` or `defineProperty`
    ; trap that reported success. What the target holds NON-CONFIGURABLY
    ; constrains what may be claimed about it: a frozen data property may only
    ; be "set" to the value it already has, and an accessor with no setter may
    ; not be set at all. Returns a message, or "" when the claim is allowed.
    fn proxySetInvariant:string (target:EvHandle key:string v:EvHandle) {
        def d:EvHandle (this.ownPropertyDescriptorOf(target key))
        if scriptThrew {
            return ""
        }
        if (false == (this.isDescriptorObject(d))) {
            return ""
        }
        if ((this.descGet(d "configurable")).toBool()) {
            return ""
        }
        if (this.descHas(d "value")) {
            if (false == ((this.descGet(d "writable")).toBool())) {
                if (false == (this.sameValueOf(v (this.descGet(d "value"))))) {
                    return "proxy set reported success for a non-writable, non-configurable property"
                }
            }
            return ""
        }
        if ((this.descGet(d "set")).isUndefined()) {
            return "proxy set reported success for a non-configurable accessor with no setter"
        }
        return ""
    }

    fn proxyTrap:EvHandle (v:EvHandle name:string) {
        def h:EvHandle (v.getOwnData("__proxyhandler__"))
        if (false == (this.isDescriptorObject(h))) {
            def _e:EvHandle (this.throwSpecError("TypeError" "Cannot perform operation on a proxy that has been revoked"))
            return (EvValueBridge.taggedUndefined())
        }
        def t:EvHandle (this.getPropertyValue(h name))
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        if (t.isUndefined()) {
            return t
        }
        if (t.isNull()) {
            return (EvValueBridge.taggedUndefined())
        }
        if (false == (t.isFunction())) {
            def _e2:EvHandle (this.throwSpecError("TypeError" ("proxy handler's " + (name + " trap is not a function"))))
            return (EvValueBridge.taggedUndefined())
        }
        ; The trap runs with the HANDLER as its `this` -- it is a method of the
        ; handler, and a handler written as an object literal that reaches for
        ; `this.something` gets the handler. It was called unbound, so `this`
        ; was undefined in every trap.
        return (t.withThisForCall(h))
    }

    fn callProxyTrap:EvHandle (trap:EvHandle args:[EvHandle]) {
        return (this.callFnValueWithValues(trap args))
    }

    ; `new Proxy(target, handler)`. BOTH must be objects; a non-object on
    ; either side is a TypeError before anything else happens.
    fn constructProxy:EvHandle (args:[EvHandle]) {
        def pt:EvHandle (EvValueBridge.taggedUndefined())
        def ph:EvHandle (EvValueBridge.taggedUndefined())
        if ((array_length args) > 0) { pt = (itemAt args 0) }
        if ((array_length args) > 1) { ph = (itemAt args 1) }
        ; A SYMBOL is object-like in this value model and is NOT an object to
        ; the spec, so it was accepted as a target or a handler.
        def ptOk:boolean (this.isDescriptorObject(pt))
        if (this.isSymbolValue(pt)) { ptOk = false }
        def phOk:boolean (this.isDescriptorObject(ph))
        if (this.isSymbolValue(ph)) { phOk = false }
        if (false == ptOk) {
            return (this.throwSpecError("TypeError" "Cannot create proxy with a non-object as target or handler"))
        }
        if (false == phOk) {
            return (this.throwSpecError("TypeError" "Cannot create proxy with a non-object as target or handler"))
        }
        return (this.makeProxyValue(pt ph))
    }

    ; D-PROXY: a trap whose answer is a boolean and whose only argument is the
    ; target (isExtensible, preventExtensions) or the target plus one value
    ; (setPrototypeOf). -1 means "not a proxy, carry on".
    fn proxyBoolTrap:int (obj:EvHandle name:string extra:EvHandle hasExtra:boolean) {
        if (false == (this.isProxyValue(obj))) {
            return (0 - 1)
        }
        def bTgt:EvHandle (this.proxyTargetOf(obj))
        def bTrap:EvHandle (this.proxyTrap(obj name))
        if scriptThrew {
            return 0
        }
        if (bTrap.isFunction()) {
            def bArgs:[EvHandle]
            push bArgs bTgt
            if hasExtra {
                push bArgs extra
            }
            def bRes:EvHandle (this.callProxyTrap(bTrap bArgs))
            if scriptThrew {
                return 0
            }
            def bBool:boolean (bRes.toBool())
            ; D-PROXYINV: the post-conditions. A trap may lie about what it did;
            ; the spec checks its answer against the target and reports a
            ; TypeError when the two disagree. None of them were checked, so a
            ; handler could report an extensible object as sealed and a
            ; prototype change that never happened as done.
            if (name == "isExtensible") {
                if (bBool != (bTgt.isExtensible())) {
                    def _ie:EvHandle (this.throwSpecError("TypeError" "proxy isExtensible reported a different value from the target"))
                    return 0
                }
            }
            if (name == "preventExtensions") {
                if bBool {
                    if (bTgt.isExtensible()) {
                        def _pe:EvHandle (this.throwSpecError("TypeError" "proxy preventExtensions returned true for an extensible target"))
                        return 0
                    }
                }
            }
            if (name == "setPrototypeOf") {
                if bBool {
                    if (false == (bTgt.isExtensible())) {
                        def cur:EvHandle (this.protoOfValue(bTgt))
                        if (false == (this.sameValueOf(cur extra))) {
                            def _sp:EvHandle (this.throwSpecError("TypeError" "proxy setPrototypeOf reported a different prototype for a non-extensible target"))
                            return 0
                        }
                    }
                }
            }
            if bBool { return 1 }
            return 0
        }
        ; No trap: the operation runs against the target.
        if (name == "isExtensible") {
            if (bTgt.isExtensible()) { return 1 }
            return 0
        }
        if (name == "preventExtensions") {
            bTgt.setExtensible(false)
            return 1
        }
        if (name == "setPrototypeOf") {
            if (extra.isObject()) {
                bTgt.setProto(extra)
            }
            return 1
        }
        return 1
    }

    ; D-PROXY: calling a proxy is the `apply` trap, or the target when the
    ; handler supplies none. A proxy is not a function value, so the receiver
    ; cannot ride on it -- it is passed in.
    ; D-PROXY: `call`, `apply` and `bind` are Function.prototype's, and the
    ; branch that owns them gates on isFunction(). A proxy is an OBJECT, so a
    ; callable one fell through every door and reached "call is not a
    ; function" -- even though `typeof p` answers "function" and `p.call`
    ; reads back a function. These two split that name test from the work so
    ; the walker and the compiled call path share one implementation.
    fn isProxyFnMethodName:boolean (methodName:string) {
        if (methodName == "call") { return true }
        if (methodName == "apply") { return true }
        if (methodName == "bind") { return true }
        return false
    }

    ; Each one goes through the proxy's own [[Call]], so an apply trap still
    ; fires and an untrapped proxy reaches its target with the chosen receiver.
    fn callProxyFnMethod:EvHandle (p:EvHandle methodName:string argVals:[EvHandle]) {
        if (methodName == "bind") {
            return (this.invokeBuiltinDirect("function" "bind" p argVals))
        }
        def pfThis:EvHandle (EvValueBridge.taggedUndefined())
        if ((array_length argVals) > 0) {
            pfThis = (itemAt argVals 0)
        }
        def pfArgs:[EvHandle]
        if (methodName == "apply") {
            ; `apply` takes ONE array-like; anything else contributes nothing,
            ; which is how the function branch reads it too.
            if ((array_length argVals) > 1) {
                def pfSpread:EvHandle (itemAt argVals 1)
                if (pfSpread.isArrayValue()) {
                    def pfs:int 0
                    while (pfs < (pfSpread.denseLen())) {
                        push pfArgs (pfSpread.arrayItemAt(pfs))
                        pfs = (pfs + 1)
                    }
                }
            }
        } {
            def pfc:int 1
            while (pfc < (array_length argVals)) {
                push pfArgs (itemAt argVals pfc)
                pfc = (pfc + 1)
            }
        }
        return (this.callProxyApply(p pfThis pfArgs))
    }

    fn callProxyApply:EvHandle (p:EvHandle thisArg:EvHandle argVals:[EvHandle]) {
        def aTgt:EvHandle (this.proxyTargetOf(p))
        def aTrap:EvHandle (this.proxyTrap(p "apply"))
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        if (aTrap.isFunction()) {
            def apArgs:[EvHandle]
            push apArgs aTgt
            push apArgs thisArg
            push apArgs (EvValueBridge.taggedArray(argVals))
            return (this.callProxyTrap(aTrap apArgs))
        }
        if (false == (aTgt.isFunction())) {
            return (this.throwSpecError("TypeError" "proxy target is not a function"))
        }
        return (this.callFnValueWithValues((aTgt.withThisForCall(thisArg)) argVals))
    }

    fn makeProxyValue:EvHandle (target:EvHandle handler:EvHandle) {
        def keysX:[string]
        def valsX:[EvHandle]
        def p:EvHandle (EvValueBridge.taggedObject(keysX valsX))
        p.setMember("__proxytarget__" target)
        p.setMember("__proxyhandler__" handler)
        ; A proxy answers `typeof` as its target does, and inherits nothing of
        ; its own -- every read goes through the traps.
        return p
    }

    ; D-REGISTRY: the registry entry a COMPUTED read should answer with.
    ; `arr.slice` went through the dotted path, which consults the registry;
    ; `arr["slice"]` did not, so bracket access to any built-in method -- and to
    ; every symbol-keyed one, which has no dotted form at all -- read undefined.
    ; Null when the registry has nothing, so the caller falls through.
    fn builtinMethodValueFor:EvHandle (obj:EvHandle key:string) {
        if ((strlen key) == 0) {
            return (EvValueBridge.taggedNull())
        }
        def bKind:string (this.receiverKind(obj))
        if ((strlen bKind) == 0) {
            return (EvValueBridge.taggedNull())
        }
        if (false == (this.hasBuiltin(bKind key))) {
            return (EvValueBridge.taggedNull())
        }
        if (this.registryMethodDeleted(obj key)) {
            return (EvValueBridge.taggedNull())
        }
        ; D-INTL: §10.3.3 and §11.3.3 -- Collator's `compare` and the two
        ; formatters' `format` are ACCESSORS whose getter answers a function
        ; already BOUND to the object. That is the whole reason they exist in
        ; that shape: `list.sort(collator.compare)` is the way they are meant
        ; to be used, and a shared unbound method loses the collator on the way
        ; and silently sorts in the root order.
        if (this.intlIsBoundMethod(bKind key)) {
            def bm:EvHandle (EvValueBridge.taggedNativeMethod(bKind key))
            bm.setMember("length" (EvHandle.fromInt((this.builtinArity(bKind key)))))
            bm.setMember("name" (EvValueBridge.taggedString(key)))
            bm.setAttrs("length" false false true)
            bm.setAttrs("name" false false true)
            bm.setBoundThis(obj)
            return bm
        }
        return (this.sharedNativeMethod(bKind key))
    }

    fn intlIsBoundMethod:boolean (kind:string name:string) {
        if (kind == "intlcollator") { return (name == "compare") }
        if (kind == "intlnumberformat") { return (name == "format") }
        if (kind == "intldatetimeformat") { return (name == "format") }
        return false
    }

    ; ES2015 22.1.3.1.1 IsConcatSpreadable: @@isConcatSpreadable overrides the
    ; array test in BOTH directions -- an array can refuse to spread, and a
    ; plain object can ask to.
    fn concatSpreads:boolean (v:EvHandle) {
        if (this.isDescriptorObject(v)) {
            def flag:EvHandle (this.getPropertyValue(v "@@isConcatSpreadable"))
            if scriptThrew {
                return false
            }
            ; ABSENT is the engine's null as often as its undefined, and only a
            ; present value overrides the array test.
            if (false == ((flag.isUndefined()) || (flag.isNull()))) {
                return (flag.toBool())
            }
        }
        return (v.isArrayValue())
    }

    ; Is `key` an OWN property of a string receiver -- an index inside its
    ; length, or `length` itself? A string is not an object here, so the own
    ; property checks never see the properties ToObject would give it.
    fn stringOwnKey:boolean (recv:EvHandle key:string) {
        def sv:EvHandle (this.unwrapPrimitive(recv))
        if (false == (sv.isString())) {
            return false
        }
        if (key == "length") {
            return true
        }
        def idx@(optional):int (to_int key)
        if idx {
            def i:int (unwrap idx)
            if ((to_string i) == key) {
                if ((i >= 0) && (i < (sv.strCodeUnitLength()))) {
                    return true
                }
            }
        }
        return false
    }

    ; A relative index argument: negative counts from the end, and the result is
    ; clamped into [0, len]. fill, copyWithin, slice and splice all take them.
    fn relativeIndexOf:int (v:EvHandle len:int) {
        def r:int (this.toIntegerOf(v))
        if scriptThrew {
            return 0
        }
        if (r < 0) {
            r = (len + r)
        }
        if (r < 0) { r = 0 }
        if (r > len) { r = len }
        return r
    }

    fn isPromiseValue:boolean (v:EvHandle) {
        if (false == (v.isObject())) { return false }
        return (v.hasOwnData("__promise__"))
    }

    ; ---- §25.4.1.5 NewPromiseCapability ---------------------------------
    ; D-PROMISECAP: every Promise static and `then` is specified over a
    ; CONSTRUCTOR C, and builds its result by calling `new C(executor)` and
    ; capturing the resolve/reject functions the executor is handed. The engine
    ; used to mint an intrinsic promise directly and settle it by hand, so a
    ; subclass was never constructed, its executor never ran, and a `then` a
    ; guest had overridden was never called. The capability record below is a
    ; plain object carrying the three parts; `promiseexec` is the executor that
    ; fills two of them in.
    ; An error raised while `all`/`race` was setting up is reported THROUGH the
    ; capability rather than thrown: the caller gets a rejected promise, which
    ; is what "a non-iterable argument rejects" means.
    fn promiseRejectWith:EvHandle (cap:EvHandle) {
        def err:EvHandle scriptThrowValue
        scriptThrew = false
        def _r:EvHandle (this.capInvoke(cap "__cap_reject__" err))
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        return (this.capPromiseOf(cap))
    }

    ; §25.4.4.1 step 6.j: `C.resolve(item)`, called with C as its receiver --
    ; through the function that was read once before the loop, so a guest that
    ; replaced it is the one that runs.
    fn promiseResolveVia:EvHandle (C:EvHandle resolveFn:EvHandle item:EvHandle) {
        def a:[EvHandle]
        push a item
        return (this.callFnValueWithValues((resolveFn.withThisForCall(C)) a))
    }

    ; And `nextPromise.then(onFulfilled, onRejected)` -- an ordinary property
    ; read and call, so an overridden `then` is honoured.
    fn promiseThenVia:EvHandle (p:EvHandle onOk:EvHandle onErr:EvHandle) {
        def thenFn:EvHandle (this.getPropertyValue(p "then"))
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        if (false == (thenFn.isFunction())) {
            return (this.throwSpecError("TypeError" "then is not a function"))
        }
        def a:[EvHandle]
        push a onOk
        push a onErr
        return (this.callFnValueWithValues((thenFn.withThisForCall(p)) a))
    }

    ; §25.4.1.5.1 / §25.4.1.3.2: every function the promise machinery mints is
    ; ANONYMOUS and carries its arity as an OWN property. taggedNativeMethod
    ; supplies neither, so each of them reported length 0 and the registry key
    ; as its name.
    fn shapeAnonFn:void (f:EvHandle arity:int) {
        f.setMember("length" (EvHandle.fromInt(arity)))
        f.setAttrs("length" false false true)
        f.setMember("name" (EvValueBridge.taggedString("")))
        f.setAttrs("name" false false true)
        ; Every one of these closes over its state through a bound `this`, and
        ; that binding is not a receiver the caller may replace: a method call
        ; rebinds a built-in method's `this` to the object it was read from, so
        ; `Promise.withResolvers().resolve(v)` settled the RESULT OBJECT instead
        ; of the promise and the promise never settled at all. Marking the
        ; binding explicit is what tells the call path to leave it alone.
        f.setBoundExplicit(true)
    }

    fn newPromiseCapability:EvHandle (C:EvHandle) {
        if (false == (C.isFunction())) {
            return (this.throwSpecError("TypeError" "Promise capability constructor is not a constructor"))
        }
        def keysC:[string]
        def valsC:[EvHandle]
        def cap:EvHandle (EvValueBridge.taggedObject(keysC valsC))
        ; The intrinsic Promise takes the direct route: its executor would only
        ; hand back the same two functions this makes anyway, and skipping the
        ; round trip keeps the common path allocation-free of a guest call.
        if (this.isIntrinsicPromiseCtor(C)) {
            def p:EvHandle (this.makePromiseValue())
            cap.setMember("__cap_promise__" p)
            def capR:EvHandle ((EvValueBridge.taggedNativeMethod("promisecap" "resolve")).withThisForCall(p))
            def capJ:EvHandle ((EvValueBridge.taggedNativeMethod("promisecap" "reject")).withThisForCall(p))
            this.shapeAnonFn(capR 1)
            this.shapeAnonFn(capJ 1)
            cap.setMember("__cap_resolve__" capR)
            cap.setMember("__cap_reject__" capJ)
            return cap
        }
        def executor:EvHandle ((EvValueBridge.taggedNativeMethod("promiseexec" "executor")).withThisForCall(cap))
        this.shapeAnonFn(executor 2)
        def ctorArgs:[EvHandle]
        push ctorArgs executor
        def made:EvHandle (this.constructWithValues(C ctorArgs C))
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        ; §25.4.1.5 steps 4-5: BOTH halves must have been set to something
        ; callable, and by the time the constructor returns.
        def rf:EvHandle (cap.getMember("__cap_resolve__"))
        def jf:EvHandle (cap.getMember("__cap_reject__"))
        if (false == (rf.isFunction())) {
            return (this.throwSpecError("TypeError" "Promise resolve function is not callable"))
        }
        if (false == (jf.isFunction())) {
            return (this.throwSpecError("TypeError" "Promise reject function is not callable"))
        }
        cap.setMember("__cap_promise__" made)
        return cap
    }


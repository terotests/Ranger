        if (kind == "Uint8Array") { return 1 }
        if (kind == "Uint8ClampedArray") { return 1 }
        if (kind == "Int16Array") { return 2 }
        if (kind == "Uint16Array") { return 2 }
        if (kind == "Int32Array") { return 4 }
        if (kind == "Uint32Array") { return 4 }
        if (kind == "Float32Array") { return 4 }
        if (kind == "Float64Array") { return 8 }
        if (kind == "BigInt64Array") { return 8 }
        if (kind == "BigUint64Array") { return 8 }

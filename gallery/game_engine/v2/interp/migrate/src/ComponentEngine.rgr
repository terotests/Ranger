        ; `prototype` at all, and `new (() => {})` is a TypeError. Minting a
        ; prototype on demand made both answer as if it were an ordinary
        ; function.
        this.shapeFunctionValue(fv fnNode)
        cell.ctx = capturedCtx
        push closureScopes cell
        fv.setClosureId(id)
        ; provenance: the module this function was DEFINED in ("" = entry), so a
        ; call can restore the right module register for bare-name `new`.
        fv.setHomeModule(currentModule)
        return fv
    }

    ; Resolve a callback arg to a function value, capturing a closure for inline
    ; arrow/function expressions. Non-inline args are evaluated (already values).
    fn resolveCallbackValue:EvHandle (argNode:TSNode) {
        if ((this.nodeKindOf(argNode)) == 17) {
            return (this.captureClosure(argNode))
        }
        if ((this.nodeKindOf(argNode)) == 18) {
            return (this.captureClosure(argNode))
        }
        return (this.evaluateExpr(argNode))
    }

    ; Call a function VALUE (which may carry a captured closure and/or bound this)
    ; with already-evaluated args. Parents the call scope on the closure when set.
    ; D-CTORVALUE: the built-in constructor a value stands for, or "" when it is
    ; not one. bind() renames its result "bound X", as the spec says it should,
    ; so the prefix is peeled before the name is recognised -- otherwise
    ; `Number.bind(null)` produced something callable-looking that nothing would
    ; call.
    fn builtinCtorNameOf:string (v:EvHandle) {
        if (false == (v.isFunction())) {
            return ""
        }
        if (v.hasFunctionNode()) {
            return ""
        }
        if ((strlen (v.builtinNameOf())) > 0) {
            return ""
        }
        def nm:string (v.fnName())
        def guard:int 0
        while (guard < 8) {
            if ((strlen nm) > 6) {
                if ((substring nm 0 6) == "bound ") {
                    nm = (substring nm 6 (strlen nm))
                    guard = (guard + 1)
                } {
                    guard = 8
                }
            } {
                guard = 8
            }
        }
        if (this.isBuiltinCtorName(nm)) {
            return nm
        }
        if (this.isErrorCtorName(nm)) {
            return nm
        }
        return ""
    }

    ; D-CTORVALUE: a built-in CONSTRUCTOR invoked through a value rather than by
    ; name -- `Number.bind(null)(42)`, `Function.call(null, "return 1")`,
    ; `[].map(Number)`. The direct call sites read the AST, so a captured
    ; constructor was not callable at all and answered a plain object or a
    ; "not a function" TypeError. `asNew` picks the construct form where the two
    ; differ.
    fn callBuiltinCtorValues:EvHandle (name:string args:[EvHandle] asNew:boolean) {
        if (this.isTypedArrayCtorName(name)) {
            return (this.constructTypedArray(name args))
        }
        if (this.isErrorCtorName(name)) {
            ; AggregateError reads its arguments the other way round: the
            ; iterable of errors first, the message second.
            if (name == "AggregateError") {
                def aErrs:[EvHandle]
                if ((array_length args) > 0) {
                    aErrs = (this.forOfItemList((itemAt args 0)))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                }
                def amsg:string ""
                if ((array_length args) > 1) {
                    def amv:EvHandle (itemAt args 1)
                    if (false == (amv.isUndefined())) {
                        amsg = (this.toStringOf(amv))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                    }
                }
                def aggErr2:EvHandle (this.makeAggregateError(aErrs amsg))
                ; AggregateError takes its options THIRD, after the errors and
                ; the message.
                if ((array_length args) > 2) {
                    this.installErrorCause(aggErr2 (itemAt args 2))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                }
                return aggErr2
            }
            def emsg:string ""
            if ((array_length args) > 0) {
                def ev:EvHandle (itemAt args 0)
                if (false == (ev.isUndefined())) {
                    emsg = (this.toStringOf(ev))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                }
            }
            def madeErr:EvHandle (this.makeError(name emsg))
            ; §20.5.8.1 InstallErrorCause: `new Error(msg, { cause })`. The
            ; property is installed only when the options object HAS a `cause`
            ; -- `new Error(m, {})` leaves the error without one, which is what
            ; `'cause' in e` is written to distinguish.
            if ((array_length args) > 1) {
                this.installErrorCause(madeErr (itemAt args 1))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
            }
            return madeErr
        }
        if (name == "Function") {
            return (this.buildFunctionFromValues(args))
        }
        ; Map and Set were reachable only through the NEW-EXPRESSION path, which
        ; reads AST argument nodes. A class base has already-evaluated values, so
        ; `class M extends Map {}` found nothing here, initFromBuiltinBase saw a
        ; non-object and gave up, and `new M([["a", 1]])` copied nothing.
        if ((name == "Map") || (name == "Set")) {
            def collInit:EvHandle (EvValueBridge.taggedUndefined())
            if ((array_length args) > 0) { collInit = (itemAt args 0) }
            return (this.constructCollectionValue(name collInit))
        }
        ; %AsyncFunction% compiles the same source, with `async` in front of it.
        if (name == "AsyncFunction") {
            return (this.buildAsyncFunctionFromValues(args))
        }
        if (this.isWeakCtorName(name)) {
            return (this.constructWeak(name args))
        }
        ; §20.4.1: Symbol is not a constructor either -- `new Symbol()` is a
        ; TypeError. It reached the ordinary builtin-ctor path, which had no
        ; branch for it, so `new Symbol()` quietly produced something rather
        ; than refusing. The CALL form mints, as `Symbol(desc)` does through
        ; the identifier path.
        if (name == "Symbol") {
            if asNew {
                return (this.throwSpecError("TypeError" "Symbol is not a constructor"))
            }
            def symDesc:string ""
            def symHas:boolean false
            if ((array_length args) > 0) {
                def sdv2:EvHandle (itemAt args 0)
                if (false == (sdv2.isUndefined())) {
                    symDesc = (this.toStringOf(sdv2))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    symHas = true
                }
            }
            return (this.mintSymbolDesc(symDesc symHas))
        }
        ; §21.2.1 BigInt(v): the explicit conversion, and the only way to get a
        ; BigInt out of a Number. It is NOT a constructor -- `new BigInt(1)` is
        ; a TypeError, which the construct paths report.
        if (name == "BigInt") {
            def bArg:EvHandle (EvValueBridge.taggedUndefined())
            if ((array_length args) > 0) { bArg = (itemAt args 0) }
            if (asNew) {
                return (this.throwSpecError("TypeError" "BigInt is not a constructor"))
            }
            return (this.toBigIntOf(bArg))
        }
        ; §27.1.2.1: %Iterator% is abstract -- it exists to hang the helpers and
        ; `from` on, and constructing it directly is a TypeError.
        if (name == "Iterator") {
            return (this.throwSpecError("TypeError" "Abstract class Iterator not directly constructable"))
        }
        if (name == "Object") {
            def ov:EvHandle (EvValueBridge.taggedNull())
            if ((array_length args) > 0) {
                ov = (itemAt args 0)
            }
            return (this.toObjectValue(ov))
        }
        if (name == "Array") {
            return (this.buildArrayFromValues(args))
        }
        if (name == "ArrayBuffer") {
            return (this.constructArrayBuffer(args))
        }
        ; D-SHARED: a SharedArrayBuffer is an ArrayBuffer that says it is
        ; shared. There is one agent in this realm, so "shared with whom" has
        ; no answer -- but the TYPE is observable (its brand, its prototype,
        ; and the fact that Atomics refuses anything else), and that part is
        ; real.
        if (name == "SharedArrayBuffer") {
            def sab:EvHandle (this.constructArrayBuffer(args))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            sab.setMember("__abshared__" (EvValueBridge.taggedBoolean(true)))
            sab.setAttrs("__abshared__" false false false)
            sab.setProto((this.builtinPrototype("SharedArrayBuffer")))
            return sab
        }
        if (name == "DataView") {
            return (this.constructDataView(args))
        }
        if (name == "Promise") {
            return (this.constructPromise(args))
        }
        if (name == "Proxy") {
            return (this.constructProxy(args))
        }
        ; D-REGEX: the constructor reached through a VALUE -- `var F =
        ; RegExp.prototype.constructor; new F()`. Without a case here it fell off
        ; the end and answered null, so the result was not a RegExp at all.
        if (name == "RegExp") {
            return (this.buildRegexFromValues(args asNew))
        }
        if (name == "Date") {
            if asNew {
                return (this.makeDateValue(args))
            }
            def dtc (new DateTime())
            return (EvValueBridge.taggedString((dtc.toFullString((dtc.timeClip((this.realmNowMs())))))))
        }
        if (this.isWrapperCtorName(name)) {
            def prim:EvHandle (EvValueBridge.taggedNull())
            if ((array_length args) > 0) {
                prim = (itemAt args 0)
            }
            if asNew {
                return (this.makeWrapper(name prim))
            }
            ; Called as a FUNCTION a wrapper coerces rather than boxes.
            if (name == "String") {
                if (prim.isNull()) {
                    return (EvValueBridge.taggedString(""))
                }
                return (EvValueBridge.taggedString((this.toStringOf(prim))))
            }
            if (name == "Number") {
                if (prim.isNull()) {
                    return (EvValueBridge.taggedNumber(0.0))
                }
                ; §21.1.1.1: Number(bigint) is the EXPLICIT conversion, and is
                ; allowed where every implicit one is refused. It rounds to the
                ; nearest double, losing precision above 2^53 -- which is the
                ; caller's decision to make and the reason it must be written.
                if (this.isBigIntValue(prim)) {
                    def numBig:BigNum (this.bigNumOf(prim))
                    return (EvValueBridge.taggedNumber((numBig.toDouble())))
                }
                return (EvValueBridge.taggedNumber((this.toNumberOf(prim))))
            }
            if (name == "Boolean") {
                if (prim.isNull()) {
                    return (EvValueBridge.taggedBoolean(false))
                }
                return (EvValueBridge.taggedBoolean((prim.toBool())))
            }
        }
        return (EvValueBridge.taggedNull())
    }

    ; The value-level twin of buildArrayFromArgs, for a captured `Array`.
    fn buildArrayFromValues:EvHandle (args:[EvHandle]) {
        def items:[EvHandle]
        def n:int (array_length args)
        if (n == 1) {
            def only:EvHandle (itemAt args 0)
            if (only.isNumber()) {
                def rawLen:double (only.toNumber())
                if ((rawLen < 0.0) || (rawLen > 4294967295.0)) {
                    return (this.throwSpecError("RangeError" "Invalid array length"))
                }
                ; Integrality is tested on the DOUBLE. Round-tripping through an
                ; int first wrapped 4294967295 to a negative number, so the one
                ; length at the top of the legal range was rejected as invalid.
                if ((this.floorNum(rawLen)) != rawLen) {
                    return (this.throwSpecError("RangeError" "Invalid array length"))
                }
                ; D-ARRAYSPARSE: a length past what the dense store can hold is
                ; DECLARED rather than materialised -- `new Array(4294967295)`
                ; is legal and has no elements at all, and raising a RangeError
                ; for it confused "too big to allocate" with "not a length".
                ; The big branch is decided on the DOUBLE: to_int of a length
                ; past 2^31 is UB on the C++ target.
                if (rawLen > 10000000.0) {
                    def bigArr:EvHandle (EvValueBridge.taggedArray(items))
                    bigArr.setDeclaredLengthD(rawLen)
                    return bigArr
                }
                def slots:int (to_int rawLen)
                def si:int 0
                while (si < slots) {
                    push items (EvValueBridge.taggedHole())
                    si = (si + 1)
                }
                return (EvValueBridge.taggedArray(items))
            }
            push items only
            return (EvValueBridge.taggedArray(items))
        }
        def i:int 0
        while (i < n) {
            push items (itemAt args i)
            i = (i + 1)
        }
        return (EvValueBridge.taggedArray(items))
    }

    ; A pooled child frame: reuse a released one (its cleared maps keep their
    ; tables on the native targets), or make a fresh child.
    fn acquireFrame:EvalContext (parent:EvalContext) {
        def n:int (array_length ctxPool)
        if (n > 0) {
            def reused:EvalContext (itemAt ctxPool (n - 1))
            removeLast ctxPool
            reused.parent = parent
            if parent.moduleRoot {
                def pmr:EvalContext (unwrap parent.moduleRoot)
                reused.moduleRoot = pmr
            } {
                reused.moduleRoot = parent
            }
            return reused
        }
        return (parent.createChild())
    }

    ; Return a frame whose call did not capture it. The cap only bounds how
    ; much cleared-map capacity idles between calls.
    fn releaseFrame:void (frame:EvalContext) {
        if ((array_length ctxPool) >= 64) {
            return
        }
        frame.resetForPool()
        push ctxPool frame
    }


    ; ---- Bytecode tier: gate + compiler (see migrate/BYTECODE.md) ---------

    ; Program id for this function, or -1. Scanned ONCE per node: the
    ; compiler itself is the gate -- the first unsupported construct aborts
    ; and the function stays on the tree-walker forever.
    ; True when the body's only route to `this` is the keyword itself --
    ; no `super`, no `eval` (both resolve through a scope chain a compiled
    ; frame does not have).
    fn bcThisIsPlain:boolean (fnNode:TSNode) {
        return (false == (this.bcMentionsSuperOrEval(fnNode 0)))
    }

    fn bcMentionsSuperOrEval:boolean (node:TSNode depth:int) {
        if (depth > 40) {
            return true
        }
        if (depth > 0) {
            def ntB:string node.nodeType
            if (ntB == "FunctionDeclaration") { return false }
            if (ntB == "FunctionExpression") { return false }
        }
        if (node.nodeType == "Super") {
            return true
        }
        if ((node.name == "eval") || (node.name == "super")) {
            return true
        }
        def ndB:int (depth + 1)
        def kB:int 0
        while (kB < (array_length node.children)) {
            if (this.bcMentionsSuperOrEval((itemAt node.children kB) ndB)) {
                return true
            }
            kB = (kB + 1)
        }
        if node.body {
            if (this.bcMentionsSuperOrEval((unwrap node.body) ndB)) { return true }
        }
        if node.left {
            if (this.bcMentionsSuperOrEval((unwrap node.left) ndB)) { return true }
        }
        if node.right {
            if (this.bcMentionsSuperOrEval((unwrap node.right) ndB)) { return true }
        }
        if node.init {
            if (this.bcMentionsSuperOrEval((unwrap node.init) ndB)) { return true }
        }
        if node.test {
            if (this.bcMentionsSuperOrEval((unwrap node.test) ndB)) { return true }
        }
        if node.consequent {
            if (this.bcMentionsSuperOrEval((unwrap node.consequent) ndB)) { return true }
        }
        if node.alternate {
            if (this.bcMentionsSuperOrEval((unwrap node.alternate) ndB)) { return true }
        }
        return false
    }

    fn bcProgramFor:int (fnNode:TSNode) {
        if fnNode.bcScanned {
            return fnNode.bcProgramId
        }
        fnNode.bcScanned = true
        fnNode.bcProgramId = (0 - 1)
        ; A GENERATOR call does not run its body at all -- it builds a
        ; generator object -- so it never belongs on the compiled path. A body
        ; with no `yield` in it compiles perfectly well and ran as an ordinary
        ; function, which made `function* g() {}` answer undefined instead of a
        ; generator.
        if fnNode.generator {
            return (0 - 1)
        }
        ; D-ASYNC: same reasoning, and the reason four separate patches to the
        ; walker's call paths all appeared to do nothing -- an async body with
        ; no `await` in it compiles perfectly well and ran as an ordinary
        ; function, so the call never reached any of them and answered the
        ; body's value raw instead of a promise.
        if fnNode.async {
            return (0 - 1)
        }
        if (false == (this.paramSlotsOkFor(fnNode))) {
            return (0 - 1)
        }
        ; An ARROW takes `this` lexically from the defining frame; compiled
        ; frames have no context to resolve through, so an arrow that can
        ; observe `this` stays on the walker. A plain function gets its
        ; receiver as a VM register (push_this).
        if ((this.nodeKindOf(fnNode)) == 17) {
            if (this.fnNeedsThis(fnNode)) {
                return (0 - 1)
            }
        }
        ; `super` reaches `this` through the scope chain; keep those walked.
        if (this.fnNeedsThis(fnNode)) {
            if (false == (this.bcThisIsPlain(fnNode))) {
                return (0 - 1)
            }
        }
        ; STRICT bodies keep the walker: its assign paths own the
        ; frozen/non-writable TypeErrors the spec requires there.
        if (this.bodyOnlyStrict(fnNode)) {
            return (0 - 1)
        }
        if strictMode {
            return (0 - 1)
        }
        if (null? fnNode.body) {
            return (0 - 1)
        }
        def fb:TSNode (unwrap fnNode.body)
        if ((this.nodeKindOf(fb)) != 34) {
            return (0 - 1)
        }
        def prog:BcProgram (new BcProgram())
        if (false == (this.bcCompileFunction(fnNode fb prog))) {
            return (0 - 1)
        }
        push bcPrograms prog
        fnNode.bcProgramId = ((array_length bcPrograms) - 1)
        return fnNode.bcProgramId
    }

    fn bcCompileFunction:boolean (fnNode:TSNode body:TSNode prog:BcProgram) {
        def np:int (array_length fnNode.params)
        def i:int 0
        while (i < np) {
            def pn:TSNode (itemAt fnNode.params i)
            ; a parameter DEFAULT evaluates lazily per call; not compiled yet
            if pn.init {
                return false
            }
            push prog.localNames pn.name
            i = (i + 1)
        }
        prog.paramCount = np
        ; every `var` in the compiled subset joins the slot table -- the
        ; compiler's own walk over exactly the statements it accepts (the
        ; hoist memo skips for-init declarations, which the walker binds
        ; lazily instead)
        def bi:int 0
        while (bi < (array_length body.children)) {
            this.bcCollectVars((itemAt body.children bi) prog)
            bi = (bi + 1)
        }
        prog.localCount = (array_length prog.localNames)
        ; which slots the escape scan proves unshared (in-place append license)
        if (false == body.slotScanned) {
            body.slotScanned = true
            body.slotVarNames = (this.slotSafeVarNames(body))
        }
        def oi:int 0
        while (oi < prog.localCount) {
            def oName:string (itemAt prog.localNames oi)
            def owned:boolean false
            def oj:int 0
            while (oj < (array_length body.slotVarNames)) {
                if ((itemAt body.slotVarNames oj) == oName) {
                    owned = true
                }
                oj = (oj + 1)
            }
            push prog.ownedSlots owned
            oi = (oi + 1)
        }
        prog.rootBody = body
        if (false == (this.bcStmtList(body.children prog))) {
            return false
        }
        prog.emit(19 0 0 0)
        ; compilation may have added hidden and catch slots
        prog.localCount = (array_length prog.localNames)
        return true
    }

    ; Add every `var`-declared name under this statement to the slot table.
    ; Walks only the statement shapes bcStmt accepts; anything else simply
    ; contributes nothing (the compile pass will reject it anyway).
    fn bcCollectVars:void (node:TSNode prog:BcProgram) {
        def k:int (this.nodeKindOf(node))
        if (k == 31) {
            def di:int 0
            while (di < (array_length node.children)) {
                def decl:TSNode (itemAt node.children di)
                if ((strlen decl.name) > 0) {
                    if ((prog.localIdxOf(decl.name)) < 0) {
                        push prog.localNames decl.name
                    }
                }
                di = (di + 1)
            }
            return
        }
        if (k == 34) {
            def ci:int 0
            while (ci < (array_length node.children)) {
                this.bcCollectVars((itemAt node.children ci) prog)
                ci = (ci + 1)
            }
            return
        }
        if (k == 32) {
            if node.body {
                this.bcCollectVars((unwrap node.body) prog)
            }
            if node.right {
                this.bcCollectVars((unwrap node.right) prog)
            }
            return
        }
        if ((k == 36) || (k == 43)) {
            if node.body {
                this.bcCollectVars((unwrap node.body) prog)
            }
            return
        }
        if (k == 33) {
            if node.init {
                this.bcCollectVars((unwrap node.init) prog)
            }
            if node.body {
                this.bcCollectVars((unwrap node.body) prog)
            }
            return
        }
        if ((k == 44) || (k == 37)) {
            ; for-in / for-of: a declared loop var plus the body
            if node.left {
                this.bcCollectVars((unwrap node.left) prog)
            }
            if node.body {
                this.bcCollectVars((unwrap node.body) prog)
            }
            return
        }
        if (k == 46) {
            ; try block, catch body and finalizer all hoist their vars
            if node.body {
                this.bcCollectVars((unwrap node.body) prog)
            }
            if node.left {
                def cc:TSNode (unwrap node.left)
                if cc.body {
                    this.bcCollectVars((unwrap cc.body) prog)
                }
            }
            if node.right {
                this.bcCollectVars((unwrap node.right) prog)
            }
            return
        }
        if (k == 42) {
            ; every case body hoists its vars
            def sci:int 0
            while (sci < (array_length node.children)) {
                def scase:TSNode (itemAt node.children sci)
                def scj:int 0
                while (scj < (array_length scase.children)) {
                    this.bcCollectVars((itemAt scase.children scj) prog)
                    scj = (scj + 1)
                }
                sci = (sci + 1)
            }
            return
        }
    }

    fn bcStmtList:boolean (list:[TSNode] prog:BcProgram) {
        def i:int 0
        while (i < (array_length list)) {
            if (false == (this.bcStmt((itemAt list i) prog))) {
                return false
            }
            i = (i + 1)
        }
        return true
    }

    fn bcStmt:boolean (node:TSNode prog:BcProgram) {
        def k:int (this.nodeKindOf(node))
        if (k == 34) {
            return (this.bcStmtList(node.children prog))
        }
        if (k == 30) {
            if node.left {
                def ex:TSNode (unwrap node.left)
                def ek:int (this.nodeKindOf(ex))
                if (ek == 6) {
                    return (this.bcAssignStmt(ex prog))
                }
                if (ek == 7) {
                    return (this.bcUpdateStmt(ex prog))
                }
                if (false == (this.bcExpr(ex prog))) {
                    return false
                }
                prog.emit(22 0 0 1)
                return true
            }
            return true
        }
        if (k == 31) {
            if ((node.kind != "var") && ((strlen node.kind) != 0)) {
                return false
            }
            def di:int 0
            while (di < (array_length node.children)) {
                def decl:TSNode (itemAt node.children di)
                if (decl.nodeType != "VariableDeclarator") {
                    return false
                }
                ; a pattern target rides decl.left; only plain names compile
                if decl.left {
                    return false
                }
                if ((strlen decl.name) == 0) {
                    return false
                }
                def slot:int (prog.localIdxOf(decl.name))
                if (slot < 0) {
                    return false
                }
                if decl.init {
                    if (false == (this.bcExpr((unwrap decl.init) prog))) {
                        return false
                    }
                    prog.emit(9 slot 0 1)
                }
                di = (di + 1)
            }
            return true
        }
        if (k == 35) {
            if node.left {
                if (false == (this.bcExpr((unwrap node.left) prog))) {
                    return false
                }
                prog.emit(18 0 0 1)
                return true
            }
            prog.emit(19 0 0 0)
            return true
        }
        if (k == 32) {
            if (null? node.left) {
                return false
            }
            if (false == (this.bcExpr((unwrap node.left) prog))) {
                return false
            }
            def jElse:int (prog.here())
            prog.emit(16 0 0 1)
            if node.body {
                if (false == (this.bcStmt((unwrap node.body) prog))) {
                    return false
                }
            }
            if node.right {
                def jEnd:int (prog.here())
                prog.emit(15 0 0 0)
                prog.patch(jElse (prog.here()))
                if (false == (this.bcStmt((unwrap node.right) prog))) {
                    return false
                }
                prog.patch(jEnd (prog.here()))
                return true
            }
            prog.patch(jElse (prog.here()))
            return true
        }
        if (k == 36) {
            if (null? node.left) {
                return false
            }
            def wBrkBase:int prog.brkTop
            def wCntBase:int prog.cntTop
            def wSavedLoopTd:int prog.loopTryDepth
            def wSavedBrkTd:int prog.brkTryDepth
            prog.loopTryDepth = prog.tryDepth
            prog.brkTryDepth = prog.tryDepth
            prog.loopDepth = (prog.loopDepth + 1)

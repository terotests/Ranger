        }
        if (obj.isWritable(key)) {
            return ""
        }
        ; Non-configurable AND non-writable: value and writability are frozen.
        if (this.descHas(desc "writable")) {
            if ((this.descGet(desc "writable")).toBool()) {
                return "cannot make a non-configurable, non-writable property writable"
            }
        }
        if (this.descHas(desc "value")) {
            def cur:EvalValue (obj.getMember(key))
            def want:EvalValue (this.descGet(desc "value"))
            if (false == (cur.equals(want))) {
                return "cannot change the value of a non-configurable, non-writable property"
            }
        }
        return ""
    }

    fn objectStaticNeedsObject:boolean (name:string) {
        if (name == "defineProperty") { return true }
        if (name == "defineProperties") { return true }
        if (name == "setPrototypeOf") { return true }
        if (name == "create") { return true }
        return false
    }

    ; Statics that COERCE their argument to an object and throw only on
    ; null/undefined. ES5.1 threw for any non-object here, and modelling that
    ; older rule made Object.keys('abc') a TypeError instead of ["0","1","2"] --
    ; Test262 tracks the current spec, so the stricter reading cost score even
    ; on tests tagged es5id.
    fn objectStaticCoerces:boolean (name:string) {
        if (name == "keys") { return true }
        if (name == "values") { return true }
        if (name == "entries") { return true }
        if (name == "getOwnPropertyNames") { return true }
        if (name == "getOwnPropertyDescriptor") { return true }
        if (name == "getPrototypeOf") { return true }
        return false
    }

    fn errorKindNames:[string] () {
        def out:[string]
        push out "Error"
        push out "TypeError"
        push out "ReferenceError"
        push out "RangeError"
        push out "SyntaxError"
        push out "EvalError"
        push out "URIError"
        return out
    }

    ; D-SYMBOL: `Symbol` as a global with the well-known symbols. Each is a
    ; distinct object value, so `Symbol.iterator !== Symbol.asyncIterator` and a
    ; symbol compares equal only to itself — the property tests rely on that.
    ; Symbol() as a factory is handled at the call site; this seeds the statics.
    fn ensureSymbolGlobal:void () {
        def existing:EvalValue (hostScope.lookup("Symbol"))
        if (existing.valueType == 6) {
            return
        }
        def sym:EvalValue (EvalValue.nativeFunction("Symbol"))
        sym.setMember("name" (EvalValue.string("Symbol")))
        def wk:[string]
        push wk "iterator"
        push wk "asyncIterator"
        push wk "hasInstance"
        push wk "toPrimitive"
        push wk "toStringTag"
        push wk "species"
        push wk "isConcatSpreadable"
        push wk "unscopables"
        push wk "match"
        push wk "replace"
        push wk "search"
        push wk "split"
        def i:int 0
        while (i < (array_length wk)) {
            def nm:string (itemAt wk i)
            def keysS:[string]
            def valsS:[EvalValue]
            def s:EvalValue (EvalValue.object(keysS valsS))
            s.setMember("__symbol__" (EvalValue.string(nm)))
            s.setMember("description" (EvalValue.string(("Symbol." + nm))))
            sym.setMember(nm s)
            i = (i + 1)

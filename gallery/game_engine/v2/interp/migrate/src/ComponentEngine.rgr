                if ((recv.isNull()) || (recv.isUndefined())) {
                    return (this.throwSpecError("TypeError" "Cannot convert undefined or null to object"))
                }
                return (this.protoOfValue(recv))
            }
            def npv:EvHandle (EvValueBridge.taggedUndefined())
            if ((array_length args) > 0) { npv = (itemAt args 0) }
            if ((recv.isNull()) || (recv.isUndefined())) {
                return (this.throwSpecError("TypeError" "Cannot convert undefined or null to object"))
            }

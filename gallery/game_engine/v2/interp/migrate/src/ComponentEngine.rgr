        ; D-ARRAYCTOR: `new Array(n)` makes an n-slot array; `new Array(a, b)`
        ; makes one holding those elements. The single-number case is the ES5
        ; idiom for pre-sizing, and without it `new Array(3).fill(0)` produced
        ; nothing at all.
        ; `new Array(...)` and `Array(...)` share one builder so the forms
        ; cannot diverge; same for Function.
        if (className == "Array") {
            return (this.buildArrayFromArgs(node.children))
        }
        ; `new Float32Array(...)` and the eight other element types. Routed
        ; through the value path so the call-site and value doors build the
        ; same thing.
        if (this.isTypedArrayCtorName(className)) {
            def taArgs:[EvHandle]
            def tai:int 0
            while (tai < (array_length node.children)) {
                push taArgs (this.evaluateExpr((itemAt node.children tai)))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                tai = (tai + 1)
            }
            return (this.constructTypedArray(className taArgs))
        }
        if (className == "Function") {
            return (this.buildFunctionFromSource(node.children))
        }
        ; D-INTL: `new Intl.Collator(...)`. The callee is a member expression,
        ; so className is the member name; the base has to say it is Intl.
        if (this.intlIsCtorName(className)) {
            def viaIntl:boolean false
            if node.left {
                def icallee:TSNode (unwrap node.left)
                if ((this.nodeKindOf(icallee)) == 3) {
                    if icallee.left {
                        def ibase:TSNode (unwrap icallee.left)
                        if (ibase.name == "Intl") { viaIntl = true }
                    }
                }
            }
            if viaIntl {
                def iArgs:[EvHandle]
                def ii:int 0
                while (ii < (array_length node.children)) {
                    push iArgs (this.evaluateExpr((itemAt node.children ii)))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    ii = (ii + 1)
                }
                def ikind:string "collator"
                if (className == "NumberFormat") { ikind = "numberformat" }
                if (className == "DateTimeFormat") { ikind = "datetimeformat" }
                if (className == "PluralRules") { ikind = "pluralrules" }
                if (className == "ListFormat") { ikind = "listformat" }
                return (this.constructIntl(ikind iArgs))
            }
        }
        ; BigInt is a function, not a constructor.
        if (className == "BigInt") {
            return (this.throwSpecError("TypeError" "BigInt is not a constructor"))
        }
        ; %Iterator% is abstract: it carries the helpers and `from`, and is not
        ; itself constructible.
        if (className == "Iterator") {
            return (this.throwSpecError("TypeError" "Abstract class Iterator not directly constructable"))
        }
        ; D-WEAK: new WeakMap / WeakSet / WeakRef / FinalizationRegistry.
        if (this.isWeakCtorName(className)) {
            def wArgs:[EvHandle] (this.collectCallArgs(node))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            return (this.constructWeak(className wArgs))
        }
        ; Built-in collections: new Map([[k,v]...]) / new Set([v...]).
        if (className == "Map") {
            def m:EvHandle (EvValueBridge.taggedMapEmpty())
            if ((array_length node.children) > 0) {
                def init:EvHandle (this.evaluateExpr((itemAt node.children 0)))
                if (init.isArrayValue()) {
                    def i:int 0
                    while (i < (init.denseLen())) {
                        def pair:EvHandle (init.arrayItemAt(i))
                        if (pair.isArrayValue()) {
                            m.mapSet((pair.getIndex(0)) (pair.getIndex(1)))
                        }
                        i = (i + 1)
                    }
                }
            }
            return m
        }
        if (className == "Set") {
            def st:EvHandle (EvValueBridge.taggedSetEmpty())
            if ((array_length node.children) > 0) {
                def init:EvHandle (this.evaluateExpr((itemAt node.children 0)))
                if (init.isArrayValue()) {
                    def i:int 0
                    while (i < (init.denseLen())) {
                        st.setAdd((init.arrayItemAt(i)))
                        i = (i + 1)
                    }
                }
            }
            return st
        }
        ; D-ERRORS: `new TypeError(msg)` / `new Error(msg)`. The constructor is a
        ; seeded singleton, so the resulting object's `constructor` compares equal
        ; to the global by reference — which is exactly what assert.throws tests.
        if (false == viaNamespace) {
            def ctorV:EvHandle (this.errorCtorFor(className))
            if (ctorV.isFunction()) {
                def kindV:EvHandle (ctorV.getMember("__errorctor__"))
                ; AggregateError reads (errors, message) rather than (message),
                ; so it takes the value path that knows the difference.
                if (className == "AggregateError") {
                    def agN:[EvHandle] (this.collectCallArgs(node))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    return (this.callBuiltinCtorValues("AggregateError" agN true))
                }
                if (kindV.isString()) {
                    def msg:string ""
                    if ((array_length node.children) > 0) {
                        def mv:EvHandle (this.evaluateExpr((itemAt node.children 0)))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                        if (false == (mv.isUndefined())) {
                            msg = (this.toStringOf(mv))
                            if scriptThrew {
                                return (EvValueBridge.taggedUndefined())
                            }
                        }
                    }
                    def newErr:EvHandle (this.makeError((kindV.stringOf()) msg))
                    if ((array_length node.children) > 1) {
                        def newOpt:EvHandle (this.evaluateExpr((itemAt node.children 1)))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                        this.installErrorCause(newErr newOpt)
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                    }
                    return newErr
                }
            }
        }

        ; D-ERRORS: `new F(...)` where F is an ordinary function, not a class.
        ; The spec builds a fresh object, runs the body with `this` bound to it,
        ; and yields that object unless the body returns one. sta.js defines
        ; Test262Error this way, so without it every harness throw is an opaque
        ; null and `thrown.constructor` cannot be read.
        if (false == viaNamespace) {
            if ((strlen className) > 0) {
                if (context.has(className)) {
                    def fnV:EvHandle (context.lookup(className))
                    ; D-PROXY: `new p(...)` where p is a proxy goes through the
                    ; construct trap. A proxy is not a function value, so the
                    ; guard below would decline it.
                    if (this.isProxyValue(fnV)) {
                        def pxCArgs:[EvHandle]
                        def pxci:int 0
                        while (pxci < (array_length node.children)) {
                            push pxCArgs (this.evaluateExpr((itemAt node.children pxci)))
                            if scriptThrew {
                                return (EvValueBridge.taggedUndefined())
                            }
                            pxci = (pxci + 1)
                        }
                        return (this.constructWithValues(fnV pxCArgs fnV))
                    }
                    if (fnV.isFunction()) {
                        if (fnV.hasFunctionNode()) {
                            ; D-ARROW: an arrow has no [[Construct]].
                            if ((this.nodeKindOf((fnV.functionNodeOf()))) == 17) {
                                return (this.throwSpecError("TypeError" (className + " is not a constructor")))
                            }
                            return (this.constructFromFunction(fnV className node.children))
                        }

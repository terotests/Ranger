            ; rather than a TypeError.
            if (this.isDescriptorObject(recv)) {
                if (npv.isObject()) {
                    recv.setProto(npv)
                } {
                    if (npv.isNull()) {
                        ; A null prototype is stored as the null VALUE, which is
                        ; what hasProto/protoOf already read as "no prototype".
                        recv.setProto(npv)
                    }
                }
            }
            return (EvValueBridge.taggedUndefined())
        }
        if (kind == "regexpget") {
            def isRe:boolean false
            if (recv.isObject()) {
                if (recv.hasOwnData("__regex__")) { isRe = true }
            }
            if (false == isRe) {
                ; RegExp.prototype is NOT itself a RegExp, and the spec makes it
                ; the one non-RegExp receiver these getters answer for.
                if (recv.equals((this.builtinPrototype("RegExp")))) {
                    if (name == "source") {
                        return (EvValueBridge.taggedString("(?:)"))
                    }
                    ; `flags` composes from the others, so on the prototype --
                    ; where every one of them is false -- it is the empty string.
                    if (name == "flags") {
                        return (EvValueBridge.taggedString(""))
                    }
                    return (EvValueBridge.taggedBoolean(false))
                }
                return (this.throwSpecError("TypeError" ("RegExp.prototype." + name + " getter called on a non-RegExp")))
            }
            if (name == "source") {
                return (EvValueBridge.taggedString((this.regexSourceOf(recv))))
            }
            def rgFlags:string (this.regexFlagsOf(recv))
            if (name == "global") {
                return (EvValueBridge.taggedBoolean(((indexOf rgFlags "g") >= 0)))
            }
            if (name == "ignoreCase") {
                return (EvValueBridge.taggedBoolean(((indexOf rgFlags "i") >= 0)))
            }
            ; ES2015 added `sticky` and `unicode`, and made `flags` an accessor
            ; that composes the others in a fixed order.
            if (name == "sticky") {
                return (EvValueBridge.taggedBoolean(((indexOf rgFlags "y") >= 0)))
            }
            if (name == "unicode") {
                return (EvValueBridge.taggedBoolean(((indexOf rgFlags "u") >= 0)))
            }
            if (name == "flags") {
                def fOut:string ""
                if ((indexOf rgFlags "g") >= 0) { fOut = (fOut + "g") }
                if ((indexOf rgFlags "i") >= 0) { fOut = (fOut + "i") }
                if ((indexOf rgFlags "m") >= 0) { fOut = (fOut + "m") }
                if ((indexOf rgFlags "u") >= 0) { fOut = (fOut + "u") }
                if ((indexOf rgFlags "y") >= 0) { fOut = (fOut + "y") }
                return (EvValueBridge.taggedString(fOut))
            }
            if (name == "multiline") {

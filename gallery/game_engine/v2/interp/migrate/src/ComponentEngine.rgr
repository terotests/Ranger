                if ((yi >= 0.0) && (yi <= 99.0)) {
                    fields = (this.replaceAt(fields 0 (1900.0 + yi)))
                }
            }
        }
        def dayNum:double (dts.makeDay((itemAt fields 0) (itemAt fields 1) (itemAt fields 2)))
        def tim:double (dts.makeTime((itemAt fields 3) (itemAt fields 4) (itemAt fields 5) (itemAt fields 6)))
        def out:double (dts.timeClip((dts.makeDate(dayNum tim))))
        recv.setAttrs("__date__" true false false)
        recv.setMember("__date__" (EvValueBridge.taggedNumber(out)))
        recv.setAttrs("__date__" false false false)
        return (EvValueBridge.taggedNumber(out))
    }

    fn replaceAt:[double] (xs:[double] idx:int v:double) {
        def out:[double]
        def i:int 0
        while (i < (array_length xs)) {
            if (i == idx) {
                push out v
            } {
                push out (itemAt xs i)
            }
            i = (i + 1)
        }
        return out
    }

    ; D-DATE: Date.prototype, in one place. `this` must really be a Date --
    ; the time value lives on the object, so there is nothing to compute from a
    ; receiver that has none.
    fn invokeDateMethod:EvHandle (name:string recv:EvHandle args:[EvHandle]) {
        if (false == (recv.isObject())) {
            return (this.throwSpecError("TypeError" ("Date.prototype." + name + " called on a non-Date")))
        }
        if (false == (recv.hasOwnData("__date__"))) {
            return (this.throwSpecError("TypeError" ("Date.prototype." + name + " called on a non-Date")))
        }
        def tv:double ((recv.getOwnData("__date__")).toNumber())
        def dtl (new DateTime())

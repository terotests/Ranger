                                    } {
                                        if varTarget {
                                            this.assignToTarget((unwrap varTarget) elem)
                                        }
                                    }
                                }
                                loopContinue = false
                                if stmt.body {
                                    this.runBlockOrStatement((unwrap stmt.body))
                                }
                                if (scriptDidReturn || (scriptThrew || loopBreak)) {
                                    lazyOn = false
                                } {

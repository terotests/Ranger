        ; those are not constructors. The suite checks it for method after
        ; method (`var F = String.prototype.slice; new F()`), and without the
        ; check the engine quietly produced an object.
        if ((strlen className) > 0) {
            if (context.has(className)) {
                def ctorCand:EvHandle (context.lookup(className))
                if (ctorCand.isFunction()) {
                    if ((strlen (ctorCand.builtinNameOf())) > 0) {
                        return (this.throwSpecError("TypeError" (className + " is not a constructor")))
                    }
                }
            }
        }

    ; Construct with already-evaluated arguments, for Reflect.construct. The
    ; AST path (constructFromFunction) evaluates argument NODES it is handed;
    ; this one is the same operation reached from a value.
    ; Construct a class from its NAME with arguments already evaluated. The
    ; whole of evaluateNewExpr is reused -- field initialisers, the prototype
    ; link, super() -- by priming the values it would otherwise get by
    ; evaluating argument nodes.
    fn constructClassByName:EvHandle (name:string argVals:[EvHandle]) {
        def idNode:TSNode (new TSNode())
        idNode.nodeType = "Identifier"
        idNode.name = name
        def newNode:TSNode (new TSNode())
        newNode.nodeType = "NewExpression"
        newNode.left = idNode
        def savedPrimed:boolean ctorArgsPrimed
        def savedVals:[EvHandle] ctorArgValues
        ctorArgsPrimed = true
        ctorArgValues = argVals
        def out:EvHandle (this.evaluateNewExpr(newNode))
        ctorArgsPrimed = savedPrimed
        ctorArgValues = savedVals
        return out
    }

    fn constructWithValues:EvHandle (fnV:EvHandle argVals:[EvHandle] newTarget:EvHandle) {
        ; D-PROXY: `new p(...)` is the `construct` trap, or the target when the
        ; handler supplies none.
        if (this.isProxyValue(fnV)) {
            def cTgt:EvHandle (this.proxyTargetOf(fnV))
            def cTrap:EvHandle (this.proxyTrap(fnV "construct"))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            if (cTrap.isFunction()) {
                def ctArgs:[EvHandle]
                push ctArgs cTgt
                push ctArgs (EvValueBridge.taggedArray(argVals))
                push ctArgs newTarget
                def ctRes:EvHandle (this.callProxyTrap(cTrap ctArgs))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                if (false == (this.isDescriptorObject(ctRes))) {
                    return (this.throwSpecError("TypeError" "proxy construct trap returned a non-object"))
                }
                return ctRes
            }
            return (this.constructWithValues(cTgt argVals cTgt))
        }
        def merged:[EvHandle]
        def mi:int 0
        while (mi < (fnV.boundArgCount())) {
            push merged (fnV.boundArgAt(mi))
            mi = (mi + 1)
        }
        def ai:int 0
        while (ai < (array_length argVals)) {
            push merged (itemAt argVals ai)
            ai = (ai + 1)
        }
        if (false == (fnV.hasFunctionNode())) {
            def bctor:string (this.builtinCtorNameOf(fnV))
            if ((strlen bctor) > 0) {
                return (this.callBuiltinCtorValues(bctor merged true))
            }
            ; D-CLASSVALUE: a CLASS reached as a value is constructible.
            ; `class S extends Promise {}` handed to Reflect.construct -- or to
            ; NewPromiseCapability, which is how `Promise.all.call(S, [])`
            ; builds its result -- has no function node and is not a built-in
            ; name, so it fell through to "not a constructor".
            if (fnV.hasOwnData("__classname__")) {
                def cnv:EvHandle (fnV.getOwnData("__classname__"))
                if (cnv.isString()) {
                    return (this.constructClassByName((cnv.stringOf()) merged))
                }
            }
            return (this.throwSpecError("TypeError" "Reflect.construct target is not a constructor"))
        }
        def keysN:[string]
        def valsN:[EvHandle]
        def inst:EvHandle (EvValueBridge.taggedObject(keysN valsN))
        ; The prototype comes from newTarget, which is the target itself unless
        ; a third argument said otherwise.
        def instProto:EvHandle (newTarget.getMember("prototype"))
        inst.setProto(instProto)
        if (instProto.isObject()) {
            if (false == (instProto.hasProto())) {
                instProto.setProto((this.builtinPrototype("Object")))
            }
            if (false == (instProto.hasOwnData("constructor"))) {
                instProto.setMember("constructor" newTarget)
                instProto.setAttrs("constructor" true false true)
            }
        }
        pendingNewTarget = newTarget
        hasPendingNewTarget = true
        def ret:EvHandle (this.callUserFunctionValues((fnV.functionNodeOf()) merged inst))
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        if (this.isDescriptorObject(ret)) {
            return ret
        }
        return inst
    }

    ; The declared arity of each built-in constructor.
    ; The declared arity of each built-in static. Only the ones the suite reads
    ; are listed; anything else answers 1, which is the common case.
    fn builtinStaticArity:int (nsName:string name:string) {
        if (nsName == "Object") {
            if (name == "defineProperty") { return 3 }
            if (name == "defineProperties") { return 2 }
            if (name == "create") { return 2 }
            if (name == "getOwnPropertyDescriptor") { return 2 }
            if (name == "setPrototypeOf") { return 2 }
            if (name == "assign") { return 2 }
            if (name == "hasOwn") { return 2 }
            if (name == "groupBy") { return 2 }
            return 1
        }
        if (nsName == "Math") {
            if (name == "random") { return 0 }
            if (name == "atan2") { return 2 }
            if (name == "pow") { return 2 }
            if (name == "hypot") { return 2 }
            if (name == "max") { return 2 }
            if (name == "min") { return 2 }
            return 1
        }
        if (nsName == "ArrayBuffer") {
            if (name == "isView") { return 1 }
            return 0
        }
        if (nsName == "JSON") {
            if (name == "stringify") { return 3 }
            return 2
        }
        if (nsName == "Reflect") {
            if (name == "apply") { return 3 }
            if (name == "construct") { return 2 }
            if (name == "defineProperty") { return 3 }
            if (name == "set") { return 3 }
            if (name == "deleteProperty") { return 2 }
            if (name == "get") { return 2 }
            if (name == "getOwnPropertyDescriptor") { return 2 }
            if (name == "has") { return 2 }
            if (name == "setPrototypeOf") { return 2 }
            return 1
        }
        if (nsName == "performance") {
            if (name == "now") { return 0 }
            return 0
        }
        return 1
    }

    fn builtinCtorArity:int (nsName:string) {
        if (nsName == "ArrayBuffer") { return 1 }
        if (nsName == "DataView") { return 1 }
        if (nsName == "Object") { return 1 }
        if (nsName == "Array") { return 1 }
        if (nsName == "String") { return 1 }
        if (nsName == "Number") { return 1 }
        if (nsName == "Boolean") { return 1 }
        if (nsName == "Function") { return 1 }
        if (nsName == "AsyncFunction") { return 1 }
        ; RegExp takes (pattern, flags).
        if (nsName == "RegExp") { return 2 }
        if (nsName == "Date") { return 7 }
        if (nsName == "Promise") { return 1 }
        if (nsName == "Proxy") { return 2 }
        if (nsName == "Map") { return 0 }
        if (nsName == "WeakMap") { return 0 }
        if (nsName == "WeakSet") { return 0 }
        if (nsName == "WeakRef") { return 1 }
        if (nsName == "FinalizationRegistry") { return 1 }
        if (nsName == "Set") { return 0 }
        return 0
    }

    fn builtinStaticNames:[string] (nsName:string) {
        def out:[string]
        if (nsName == "ArrayBuffer") {
            push out "isView"
            return out
        }
        ; D-INTL. Collator, NumberFormat and DateTimeFormat are CONSTRUCTORS
        ; published on the namespace, not plain functions; new-expression
        ; dispatch picks them up by name.
        if (nsName == "Intl") {
            push out "Collator"
            push out "DateTimeFormat"
            push out "ListFormat"
            push out "NumberFormat"
            push out "PluralRules"
            ; supportedLocalesOf is NOT here: the spec puts it on each
            ; constructor (Intl.Collator.supportedLocalesOf), not on the
            ; namespace, and publishing it here would be inventing an API.
            push out "getCanonicalLocales"
            return out
        }
        if (nsName == "Object") {
            push out "assign"
            push out "getOwnPropertySymbols"
            push out "is"
            push out "create"
            push out "defineProperties"
            push out "defineProperty"
            push out "entries"
            push out "freeze"
            push out "fromEntries"
            push out "getOwnPropertyDescriptor"
            push out "getOwnPropertyDescriptors"
            push out "getOwnPropertyNames"
            push out "getPrototypeOf"
            push out "groupBy"
            push out "hasOwn"
            push out "isExtensible"
            push out "isFrozen"
            push out "isSealed"
            push out "keys"
            push out "preventExtensions"
            push out "seal"
            push out "setPrototypeOf"
            push out "values"
            return out
        }
        ; D-REFLECT: every Reflect method is an ordinary function on the
        ; namespace object -- there is no `Reflect.get` call-site form to fall
        ; back on, so this list IS the namespace.
        if (nsName == "Proxy") {
            push out "revocable"
            return out
        }
        ; %Iterator%, whose only static is `from` -- the door from any iterable
        ; into the helper methods.
        if (nsName == "Iterator") {
            push out "from"
            return out
        }
        if (nsName == "BigInt") {
            push out "asIntN"
            push out "asUintN"
            return out
        }
        ; §24.1.2.1 Map.groupBy: Object.groupBy's twin, and the one to reach for
        ; when the key is not a string -- a Map key is the value itself.
        if (nsName == "Map") {
            push out "groupBy"
            return out
        }
        ; §22.2.5.1 RegExp.escape: the string, made safe to drop into a pattern
        ; as a literal. There is no other correct way to do it -- a hand-rolled
        ; escape misses at least one of the characters that matter.
        if (nsName == "RegExp") {
            push out "escape"
            return out
        }
        ; D-ATOMICS: one agent means every one of these is already atomic --
        ; there is nothing to interleave with. What they still owe the caller
        ; is the RIGHT ANSWER and the right refusals, which is what is here.
        if (nsName == "Atomics") {
            push out "add"
            push out "and"
            push out "compareExchange"
            push out "exchange"
            push out "isLockFree"
            push out "load"
            push out "notify"
            push out "or"
            push out "store"
            push out "sub"
            push out "wait"
            push out "waitAsync"
            push out "xor"
            return out
        }
        if (nsName == "Promise") {
            push out "all"
            push out "allSettled"
            ; §27.2.4.6 Promise.try: run f NOW, and let whatever it does --
            ; return, throw, or answer a thenable -- come back as a promise.
            ; The point is that a synchronous throw becomes a rejection instead
            ; of escaping, which is what makes a mixed sync/async callback safe
            ; to call.
            push out "try"
            push out "any"
            push out "race"
            push out "reject"
            push out "resolve"
            push out "withResolvers"
            return out
        }
        if (nsName == "Reflect") {
            push out "apply"
            push out "construct"
            push out "defineProperty"
            push out "deleteProperty"
            push out "get"
            push out "getOwnPropertyDescriptor"
            push out "getPrototypeOf"
            push out "has"
            push out "isExtensible"
            push out "ownKeys"
            push out "preventExtensions"
            push out "set"
            push out "setPrototypeOf"
            return out
        }
        if (nsName == "Math") {
            push out "abs"
            push out "acos"
            push out "asin"
            push out "atan"
            push out "atan2"
            push out "ceil"
            push out "cos"
            push out "exp"
            push out "floor"
            push out "log"
            push out "hypot"
            push out "max"
            push out "min"
            push out "pow"
            push out "random"
            push out "round"
            push out "sign"
            push out "sin"
            push out "sqrt"
            push out "tan"
            push out "trunc"
            ; --- ES2015 additions ---
            push out "cbrt"
            push out "clz32"
            push out "expm1"
            push out "fround"
            push out "imul"
            push out "log10"
            push out "log1p"
            push out "log2"
            push out "sinh"
            push out "cosh"
            push out "tanh"
            push out "asinh"
            push out "acosh"
            push out "atanh"
            return out
        }
        if (nsName == "Array") {
            push out "isArray"
            push out "from"
            push out "of"
            return out
        }
        if (nsName == "String") {
            push out "fromCharCode"
            push out "fromCodePoint"
            push out "raw"
            return out
        }
        if (nsName == "Number") {
            push out "isFinite"
            push out "isInteger"
            push out "isNaN"
            push out "isSafeInteger"
            push out "parseFloat"
            push out "parseInt"
            return out
        }
        if (nsName == "JSON") {
            push out "parse"
            push out "stringify"
            return out
        }
        if (nsName == "ArrayBuffer") {
            push out "isView"
            return out
        }
        if (nsName == "Date") {
            push out "now"
            push out "parse"
            push out "UTC"
            return out
        }
        if (nsName == "performance") {
            push out "now"
            return out
        }
        return out
    }

    ; D-STATICS: the subset of published statics that invokeBuiltinStatic can
    ; actually run from values. The rest are still implemented by the call-site
    ; chains, which read the AST -- they EXIST as values and are describable,
    ; they just cannot be captured and called yet. Keeping the two lists apart
    ; is what stops a direct `Object.create(...)` being intercepted and answered
    ; with undefined.
    ; D-REGISTRY: one value per (kind, name), for the engine's lifetime. A fresh
    ; value per read made `[].slice === Array.prototype.slice` false and
    ; `(new Number()).toString === Number.prototype.toString` with it -- the
    ; suite compares built-in methods by identity all over.
    fn sharedNativeMethod:EvHandle (kind:string name:string) {
        ; annexB B.2.4.3: Date.prototype.toGMTString IS
        ; Date.prototype.toUTCString -- the same function object, reporting the
        ; same name, not a second one that behaves alike. Minting its own made
        ; the identity comparison the suite checks answer false.
        def realName:string name
        if (kind == "date") {
            if (name == "toGMTString") {
                realName = "toUTCString"
            }
        }
        def key:string (kind + ("." + realName))
        def found@(optional):EvHandle (get nativeMethodCache key)
        if (!null? found) {
            return (unwrap found)
        }
        def v:EvHandle (EvValueBridge.taggedNativeMethod(kind realName))
        ; A built-in reports its registered arity as `length`, like any other
        ; function. Stored on the value because there is no parameter list to
        ; count -- the registry IS the parameter list.
        def ar:int (this.builtinArity(kind realName))
        if (ar < 0) { ar = 0 }
        v.setMember("length" (EvHandle.fromInt(ar)))
        v.setAttrs("length" false false true)
        ; A symbol-keyed method is NAMED for its symbol: the method registered
        ; under the key `@@match` reports "[Symbol.match]", which is the name
        ; the spec gives it and what the suite reads off it.
        def dispName:string realName
        if ((strlen realName) > 2) {
            if ((substring name 0 2) == "@@") {
                dispName = ("[Symbol." + ((substring name 2 (strlen name)) + "]"))
            }
        }
        v.setMember("name" (EvValueBridge.taggedString(dispName)))
        v.setAttrs("name" false false true)
        set nativeMethodCache key v
        return v
    }

    ; The own-property descriptor of `key` on `src`, or undefined. Factored out
    ; of the Object.getOwnPropertyDescriptor call-site chain so the value-call
    ; path (invokeBuiltinStatic) answers with the SAME rules -- accessors
    ; reporting get/set rather than a value, own-only lookup, the array-index
    ; and string-index cases. Two implementations would drift.
    fn ownPropertyDescriptorOf:EvHandle (src:EvHandle dk:string) {
        ; D-PROXY: the `getOwnPropertyDescriptor` trap.
        if (this.isProxyValue(src)) {
            def dTgt:EvHandle (this.proxyTargetOf(src))
            def dTrap:EvHandle (this.proxyTrap(src "getOwnPropertyDescriptor"))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            if (dTrap.isFunction()) {
                def dArgs:[EvHandle]
                push dArgs dTgt
                push dArgs (EvValueBridge.taggedString(dk))
                def dRes:EvHandle (this.callProxyTrap(dTrap dArgs))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                ; [[GetOwnProperty]] answers a descriptor OBJECT or undefined.
                ; Anything else -- a number, a string, null -- is a TypeError
                ; rather than something to hand onward as if it were one.
                ; D-PROXYINV: the post-conditions. What the target holds
                ; constrains what the trap may report about it.
                def tDesc:EvHandle (this.ownPropertyDescriptorOf(dTgt dk))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                def tHas:boolean (this.isDescriptorObject(tDesc))
                if (dRes.isUndefined()) {
                    ; A property the target holds NON-CONFIGURABLY cannot be
                    ; reported absent, and neither can any property of a
                    ; non-extensible target.
                    if tHas {
                        if (false == ((this.descGet(tDesc "configurable")).toBool())) {
                            return (this.throwSpecError("TypeError" "proxy getOwnPropertyDescriptor reported a non-configurable property as absent"))
                        }
                        if (false == (dTgt.isExtensible())) {
                            return (this.throwSpecError("TypeError" "proxy getOwnPropertyDescriptor reported a property of a non-extensible target as absent"))
                        }
                    }
                    return dRes
                }
                if (false == (this.isDescriptorObject(dRes))) {
                    return (this.throwSpecError("TypeError" "proxy getOwnPropertyDescriptor must return an object or undefined"))
                }
                if (this.isSymbolValue(dRes)) {
                    return (this.throwSpecError("TypeError" "proxy getOwnPropertyDescriptor must return an object or undefined"))
                }
                ; The reported descriptor must itself be well formed, and a
                ; NON-CONFIGURABLE claim needs a non-configurable property on
                ; the target to stand on.
                def dvErr:string (this.descriptorError(dRes))
                if ((strlen dvErr) > 0) {
                    return (this.throwSpecError("TypeError" dvErr))
                }
                if (this.descHas(dRes "configurable")) {
                    if (false == ((this.descGet(dRes "configurable")).toBool())) {
                        if (false == tHas) {
                            return (this.throwSpecError("TypeError" "proxy getOwnPropertyDescriptor reported a non-configurable descriptor for a property the target does not have"))
                        }
                        if ((this.descGet(tDesc "configurable")).toBool()) {
                            return (this.throwSpecError("TypeError" "proxy getOwnPropertyDescriptor reported a non-configurable descriptor for a configurable target property"))
                        }
                    }
                }
                return dRes
            }
            return (this.ownPropertyDescriptorOf(dTgt dk))
        }
                        if true {
                            ; D-ACCESSORS: an accessor property reports get/set,
                            ; never a `value` — reporting it as data would make
                            ; the descriptor lie about the property's nature.
                            ; OWN only: an INHERITED accessor has no descriptor
                            ; on this object, and walking the chain reported one
                            ; for a property the object does not have.
                            def ownAcc:boolean false
                            if (src.hasOwnGetter(dk)) { ownAcc = true }
                            if (src.hasOwnSetter(dk)) { ownAcc = true }
                            if ownAcc {
                                def keysA:[string]
                                def valsA:[EvHandle]
                                def descA:EvHandle (EvValueBridge.taggedObject(keysA valsA))
                                def ga:EvHandle (EvValueBridge.taggedNull())
                                if (src.hasOwnGetter(dk)) {
                                    ga = (src.getOwnGetter(dk))
                                }
                                def sa:EvHandle (EvValueBridge.taggedNull())
                                if (src.hasOwnSetter(dk)) {
                                    sa = (src.getOwnSetter(dk))
                                }
                                if (ga.isFunction()) {
                                    descA.setMember("get" ga)
                                } {
                                    descA.setMember("get" (EvValueBridge.taggedUndefined()))
                                }
                                if (sa.isFunction()) {
                                    descA.setMember("set" sa)
                                } {
                                    descA.setMember("set" (EvValueBridge.taggedUndefined()))
                                }
                                ; D-ATTRS: an accessor carries the same recorded
                                ; attributes a data property does. Hardcoding
                                ; both to true made every accessor report as
                                ; configurable, which is the opposite of what
                                ; defineProperty defaults them to.
                                descA.setMember("enumerable" (EvValueBridge.taggedBoolean((src.isEnumerable(dk)))))
                                descA.setMember("configurable" (EvValueBridge.taggedBoolean((src.isConfigurable(dk)))))
                                return descA
                            }
                            ; D-INDEXDESC: an array index or string index is a
                            ; real own property, but lives in arrayValue /
                            ; stringValue rather than objectMap, so the
                            ; descriptor came back undefined for a property that
                            ; plainly exists. `length` likewise.
                            if (src.isArrayValue()) {
                                if (dk == "length") {
                                    def keysL:[string]
                                    def valsL:[EvHandle]
                                    def dL:EvHandle (EvValueBridge.taggedObject(keysL valsL))
                                    dL.setMember("value" (EvHandle.fromInt((src.denseLen()))))
                                    ; `length` is writable UNLESS defineProperty
                                    ; has said otherwise. It was reported as
                                    ; always writable, so a frozen length looked
                                    ; unfrozen however it had been defined.
                                    def lenW:boolean true
                                    if (src.hasOwnAttrs("length")) {
                                        lenW = (src.isWritable("length"))
                                    }
                                    dL.setMember("writable" (EvValueBridge.taggedBoolean(lenW)))
                                    dL.setMember("enumerable" (EvValueBridge.taggedBoolean(false)))
                                    dL.setMember("configurable" (EvValueBridge.taggedBoolean(false)))
                                    return dL
                                }
                                def ai:int (this.canonicalArrayIndex(dk))
                                if (ai >= 0) {
                                    if (ai < (src.denseLen())) {
                                        ; D-HOLES: a hole is an ABSENT property
                                        ; and has no descriptor at all.
                                        if (false == ((EvValueBridge.isHole((src.arrayItemAt(ai)))))) {
                                            def keysI:[string]
                                            def valsI:[EvHandle]
                                            def dI:EvHandle (EvValueBridge.taggedObject(keysI valsI))
                                            dI.setMember("value" (src.arrayItemAt(ai)))
                                            ; Recorded attributes win: an element
                                            ; defined through defineProperty is
                                            ; not writable just because it is an
                                            ; element.
                                            if (src.hasOwnAttrs(dk)) {
                                                dI.setMember("writable" (EvValueBridge.taggedBoolean((src.isWritable(dk)))))
                                                dI.setMember("enumerable" (EvValueBridge.taggedBoolean((src.isEnumerable(dk)))))
                                                dI.setMember("configurable" (EvValueBridge.taggedBoolean((src.isConfigurable(dk)))))
                                            } {
                                                ; FREEZING an array does not
                                                ; record per-index attributes --
                                                ; it sets a flag on the value --
                                                ; so the defaults below reported
                                                ; every element of a frozen array
                                                ; as writable and configurable.
                                                def elW:boolean true
                                                def elC:boolean true
                                                if (src.isFrozenObj()) {
                                                    elW = false
                                                    elC = false
                                                }
                                                if (src.isSealedObj()) {
                                                    elC = false
                                                }
                                                dI.setMember("writable" (EvValueBridge.taggedBoolean(elW)))
                                                dI.setMember("enumerable" (EvValueBridge.taggedBoolean(true)))
                                                dI.setMember("configurable" (EvValueBridge.taggedBoolean(elC)))
                                            }
                                            return dI
                                        }
                                        return (EvValueBridge.taggedUndefined())
                                    }
                                }
                            }
                            if (src.isString()) {
                                if (dk == "length") {
                                    def keysS:[string]
                                    def valsS:[EvHandle]
                                    def dS:EvHandle (EvValueBridge.taggedObject(keysS valsS))
                                    dS.setMember("value" (EvHandle.fromInt((src.strCodeUnitLength()))))
                                    dS.setMember("writable" (EvValueBridge.taggedBoolean(false)))
                                    dS.setMember("enumerable" (EvValueBridge.taggedBoolean(false)))
                                    dS.setMember("configurable" (EvValueBridge.taggedBoolean(false)))
                                    return dS
                                }
                                def sIdx@(optional):int (to_int dk)
                                if sIdx {
                                    def si2:int (unwrap sIdx)
                                    if ((si2 >= 0) && (si2 < (src.strCodeUnitLength()))) {
                                        def keysC:[string]
                                        def valsC2:[EvHandle]
                                        def dC:EvHandle (EvValueBridge.taggedObject(keysC valsC2))
                                        def se:int (si2 + 1)
                                        dC.setMember("value" (EvValueBridge.taggedString((this.cuSlice((src.stringOf()) si2 se))))) 
                                        dC.setMember("writable" (EvValueBridge.taggedBoolean(false)))
                                        dC.setMember("enumerable" (EvValueBridge.taggedBoolean(true)))
                                        dC.setMember("configurable" (EvValueBridge.taggedBoolean(false)))
                                        return dC
                                    }
                                }
                            }
                            ; D-FNPROPS: a function's own length/name/prototype.
                            ; They are resolved by getMember rather than stored,
                            ; so objHasKey said they were absent and the
                            ; descriptor came back undefined for three
                            ; properties every function has.
                            if (src.isFunction()) {
                                if ((dk == "length") || (dk == "name")) {
                                    if (false == (src.hasOwnData(dk))) {
                                        def keysF:[string]
                                        def valsF:[EvHandle]
                                        def dF:EvHandle (EvValueBridge.taggedObject(keysF valsF))
                                        dF.setMember("value" (src.getMember(dk)))
                                        dF.setMember("writable" (EvValueBridge.taggedBoolean(false)))
                                        dF.setMember("enumerable" (EvValueBridge.taggedBoolean(false)))
                                        dF.setMember("configurable" (EvValueBridge.taggedBoolean(true)))
                                        return dF
                                    }
                                }
                                ; Only SYNTHESISED when the function does not
                                ; actually hold the property. A built-in
                                ; constructor stores its own `prototype` with
                                ; recorded attributes -- non-writable among them
                                ; -- and hardcoding writable here reported the
                                ; opposite of what was recorded.
                                if (dk == "prototype") {
                                    ; A SUPPRESSED name is not there at all --
                                    ; Function.prototype is callable but not a
                                    ; constructor, so it carries no `prototype`
                                    ; and the synthesis must not invent one.
                                    if (src.hasSuppressed(dk)) {
                                        return (EvValueBridge.taggedUndefined())
                                    }
                                    ; A function that STORES its prototype still
                                    ; has the spec's attributes on it -- writable,
                                    ; not enumerable, NOT configurable -- unless
                                    ; defineProperty recorded something else. It
                                    ; fell through to the generic branch, which
                                    ; reads the made-by-assignment defaults and
                                    ; called it configurable.
                                    if (false == (src.hasOwnAttrs(dk))) {
                                        def keysQ:[string]
                                        def valsQ:[EvHandle]
                                        def dQ:EvHandle (EvValueBridge.taggedObject(keysQ valsQ))
                                        dQ.setMember("value" (src.getMember("prototype")))
                                        dQ.setMember("writable" (EvValueBridge.taggedBoolean(true)))
                                        dQ.setMember("enumerable" (EvValueBridge.taggedBoolean(false)))
                                        dQ.setMember("configurable" (EvValueBridge.taggedBoolean(false)))
                                        return dQ
                                    }
                                    if (false == (src.hasOwnData(dk))) {
                                        def keysP:[string]
                                        def valsP:[EvHandle]
                                        def dP:EvHandle (EvValueBridge.taggedObject(keysP valsP))
                                        dP.setMember("value" (src.getMember("prototype")))
                                        dP.setMember("writable" (EvValueBridge.taggedBoolean(true)))
                                        dP.setMember("enumerable" (EvValueBridge.taggedBoolean(false)))
                                        dP.setMember("configurable" (EvValueBridge.taggedBoolean(false)))
                                        return dP
                                    }
                                }
                            }
                            if (this.objHasKey(src dk)) {
                                def keysD:[string]
                                def valsD:[EvHandle]
                                def desc:EvHandle (EvValueBridge.taggedObject(keysD valsD))
                                desc.setMember("value" (src.getMember(dk)))
                                desc.setMember("writable" (EvValueBridge.taggedBoolean((src.isWritable(dk)))))
                                desc.setMember("enumerable" (EvValueBridge.taggedBoolean((src.isEnumerable(dk)))))
                                desc.setMember("configurable" (EvValueBridge.taggedBoolean((src.isConfigurable(dk)))))
                                return desc
                            }
                        }
                        return (EvValueBridge.taggedUndefined())
    }

    fn hasInvocableStatic:boolean (nsName:string name:string) {
        if (nsName == "Math") {
            return (this.hasBuiltinStatic(nsName name))
        }
        if (nsName == "Array") {
            if (name == "isArray") { return true }
            ; `from` and `of` are statics like any other. Listing only isArray
            ; is what made `class L extends Array {}` have no `L.from`: the
            ; other two were reachable only by writing the literal name.
            if (name == "from") { return true }
            if (name == "of") { return true }
            return false
        }
        if (nsName == "String") {
            if (name == "fromCharCode") { return true }
            if (name == "fromCodePoint") { return true }
            if (name == "raw") { return true }
            return false
        }
        if (nsName == "Number") {
            if (name == "isNaN") { return true }
            if (name == "isFinite") { return true }
            if (name == "isInteger") { return true }
            if (name == "isSafeInteger") { return true }
            return false
        }
        if (nsName == "Object") {
            ; D-STATICS: every Object static the value path implements. They are
            ; captured detached constantly -- `var f = Object.assign` -- and a
            ; name missing here answered undefined rather than running.
            return (this.hasBuiltinStatic(nsName name))
        }
        if (nsName == "Number") {
            if (name == "isSafeInteger") { return true }
            return (this.hasBuiltinStatic(nsName name))
        }
        if (nsName == "Date") {
            return (this.hasBuiltinStatic(nsName name))
        }
        if (nsName == "Reflect") {
            return (this.hasBuiltinStatic(nsName name))
        }
        if (nsName == "Intl") {
            if ((this.cuIndexOfByte(name (indexOf name "."))) > 0) { return true }
            return (this.hasBuiltinStatic(nsName name))
        }
        if (nsName == "Promise") {
            return (this.hasBuiltinStatic(nsName name))
        }
        if (nsName == "Iterator") {
            return (this.hasBuiltinStatic(nsName name))
        }
        if (nsName == "BigInt") {
            return (this.hasBuiltinStatic(nsName name))
        }
        if (nsName == "Map") {
            return (this.hasBuiltinStatic(nsName name))
        }
        if (nsName == "RegExp") {
            return (this.hasBuiltinStatic(nsName name))
        }
        if (nsName == "Atomics") {
            return (this.hasBuiltinStatic(nsName name))
        }
        if (nsName == "Proxy") {
            return (name == "revocable")
        }
        if (nsName == "Symbol") {
            if (name == "for") { return true }
            if (name == "keyFor") { return true }
            return false
        }
        if (nsName == "performance") {
            return (this.hasBuiltinStatic(nsName name))
        }
        return false
    }

    fn hasBuiltinStatic:boolean (nsName:string name:string) {
        def names:[string] (this.builtinStaticNames(nsName))
        def i:int 0
        while (i < (array_length names)) {
            if ((itemAt names i) == name) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn builtinGlobalObject:EvHandle (nsName:string) {
        def found@(optional):EvHandle (get builtinGlobals nsName)
        if (!null? found) {
            return (unwrap found)
        }
        def keysG:[string]
        def valsG:[EvHandle]
        def g:EvHandle (EvValueBridge.taggedObject(keysG valsG))
        ; D-GLOBALOBJ: a built-in CONSTRUCTOR is a function value, not a plain
        ; object. typeof already lied about it and said "function"; making it one
        ; is what lets `Number instanceof Function`,
        ; `Function.prototype.isPrototypeOf(Number)` and `Number.length` all
        ; answer for themselves instead of being special-cased at each site.
        if (this.isBuiltinCtorName(nsName)) {
            g = (EvValueBridge.taggedNativeFunction(nsName))
        }
        set builtinGlobals nsName g
        g.setMember("name" (EvValueBridge.taggedString(nsName)))
        g.setAttrs("name" false false true)
        ; Math and JSON brand as themselves, not as Object.
        if (nsName == "Math") { g.setMember("__nsbrand__" (EvValueBridge.taggedString("Math"))) }
        if (nsName == "JSON") { g.setMember("__nsbrand__" (EvValueBridge.taggedString("JSON"))) }
        if (nsName == "Reflect") { g.setMember("__nsbrand__" (EvValueBridge.taggedString("Reflect"))) }
        if (nsName == "Atomics") {
            g.setMember("__nsbrand__" (EvValueBridge.taggedString("Atomics")))
            g.setMember("@@toStringTag" (EvValueBridge.taggedString("Atomics")))
            g.setAttrs("@@toStringTag" false false true)
        }
        if (nsName == "Intl") { g.setMember("__nsbrand__" (EvValueBridge.taggedString("Intl"))) }
        ; Math and JSON also brand through Symbol.toStringTag, which is what
        ; `Object.prototype.toString.call(Math)` reads. The __nsbrand__ slot
        ; above is internal and answered nothing to guest code.
        if ((nsName == "Math") || (nsName == "JSON")) {
            g.setMember("@@toStringTag" (EvValueBridge.taggedString(nsName)))
            g.setAttrs("@@toStringTag" false false true)
        }
        ; ES2015: the constructors that publish @@species. It is a get-only
        ; accessor answering the constructor itself.
        def hasSpecies:boolean false
        if (nsName == "Array") { hasSpecies = true }
        if (nsName == "Map") { hasSpecies = true }
        if (nsName == "Set") { hasSpecies = true }
        if (nsName == "RegExp") { hasSpecies = true }
        if (nsName == "Promise") { hasSpecies = true }
        if hasSpecies {
            g.defineGetter("@@species" (this.sharedNativeMethod("speciesget" "get")))
            g.setAttrs("@@species" false false true)
        }
        if (nsName == "performance") { g.setMember("__nsbrand__" (EvValueBridge.taggedString("performance"))) }
        if (this.isBuiltinCtorName(nsName)) {
            g.setMember("prototype" (this.builtinPrototype(nsName)))
            g.setAttrs("prototype" false false false)
            ; Every built-in constructor inherits from Function.prototype, and
            ; declares its own arity. Both are properties the suite reads.
            if (nsName != "Function") {
                ; D-ARRAYBUFFER: a CONCRETE typed-array constructor inherits
                ; from the %TypedArray% intrinsic, not straight from
                ; Function.prototype. `Object.getPrototypeOf(Int8Array)` is the
                ; only way a guest can name that intrinsic, and it is how the
                ; suite's own typed-array harness reaches `of` and `from`.
                if (this.isTypedArrayCtorName(nsName)) {
                    g.setProto((this.typedArrayIntrinsic()))
                } {
                    g.setProto((this.builtinPrototype("Function")))
                }
            }
            g.setMember("length" (EvHandle.fromInt((this.builtinCtorArity(nsName)))))
            g.setAttrs("length" false false true)
        }
        if (nsName == "Math") {
            def pi:double (M_PI)
            g.setMember("PI" (EvValueBridge.taggedNumber(pi)))
            g.setAttrs("PI" false false false)
            def e1@(optional):double (to_double "2.718281828459045")
            if e1 {
                g.setMember("E" (EvValueBridge.taggedNumber((unwrap e1))))
                g.setAttrs("E" false false false)
            }
            def ln2@(optional):double (to_double "0.6931471805599453")
            if ln2 {
                g.setMember("LN2" (EvValueBridge.taggedNumber((unwrap ln2))))
                g.setAttrs("LN2" false false false)
            }
            def ln10@(optional):double (to_double "2.302585092994046")
            if ln10 {
                g.setMember("LN10" (EvValueBridge.taggedNumber((unwrap ln10))))
                g.setAttrs("LN10" false false false)
            }
            def sq2@(optional):double (to_double "1.4142135623730951")
            if sq2 {
                g.setMember("SQRT2" (EvValueBridge.taggedNumber((unwrap sq2))))
                g.setAttrs("SQRT2" false false false)
            }
            def l2e@(optional):double (to_double "1.4426950408889634")
            if l2e {
                g.setMember("LOG2E" (EvValueBridge.taggedNumber((unwrap l2e))))
                g.setAttrs("LOG2E" false false false)
            }
            def l10e@(optional):double (to_double "0.4342944819032518")
            if l10e {
                g.setMember("LOG10E" (EvValueBridge.taggedNumber((unwrap l10e))))
                g.setAttrs("LOG10E" false false false)
            }
            def sqh@(optional):double (to_double "0.7071067811865476")
            if sqh {
                g.setMember("SQRT1_2" (EvValueBridge.taggedNumber((unwrap sqh))))
                g.setAttrs("SQRT1_2" false false false)
            }
        }
        ; D-STATICS: the namespace's own methods, as VALUES. They were resolved
        ; structurally at the call site and existed nowhere else, so
        ; `typeof Math.floor` was "undefined", `var f = Object.keys` captured
        ; nothing, and getOwnPropertyDescriptor could not see a single one of
        ; them. Stored on the namespace object, so repeated reads are the same
        ; value and `desc.value === Object.keys` holds.
        def statics:[string] (this.builtinStaticNames(nsName))
        def si:int 0
        while (si < (array_length statics)) {
            def sn:string (itemAt statics si)
            def stv:EvHandle (EvValueBridge.taggedNativeStatic(nsName sn))
            stv.setMember("length" (EvHandle.fromInt((this.builtinStaticArity(nsName sn)))))
            stv.setAttrs("length" false false true)
            stv.setMember("name" (EvValueBridge.taggedString(sn)))
            stv.setAttrs("name" false false true)
            ; D-INTL: supportedLocalesOf is a static ON EACH CONSTRUCTOR, not
            ; on the namespace, so it is hung here rather than published as an
            ; Intl static. The name carries its owner so the one handler can
            ; tell which constructor was asked.
            if (nsName == "Intl") {
                if (this.intlIsCtorName(sn)) {
                    def slo:EvHandle (EvValueBridge.taggedNativeStatic("Intl" (sn + ".supportedLocalesOf")))
                    slo.setMember("length" (EvHandle.fromInt(1)))
                    slo.setAttrs("length" false false true)
                    slo.setMember("name" (EvValueBridge.taggedString("supportedLocalesOf")))
                    slo.setAttrs("name" false false true)
                    stv.setMember("supportedLocalesOf" slo)
                    stv.setAttrs("supportedLocalesOf" true false true)
                }
            }
            g.setMember(sn stv)
            ; Writable and configurable but not enumerable, like every built-in.
            g.setAttrs(sn true false true)
            si = (si + 1)
        }
        if (nsName == "Number") {
            def mx@(optional):double (to_double "1.7976931348623157e308")
            if mx {
                g.setMember("MAX_VALUE" (EvValueBridge.taggedNumber((unwrap mx))))
                g.setAttrs("MAX_VALUE" false false false)
            }
            def mn@(optional):double (to_double "5e-324")
            if mn {
                g.setMember("MIN_VALUE" (EvValueBridge.taggedNumber((unwrap mn))))
                g.setAttrs("MIN_VALUE" false false false)
            }
            def inf:double (1.0 / 0.0)
            g.setMember("POSITIVE_INFINITY" (EvValueBridge.taggedNumber(inf)))
            g.setAttrs("POSITIVE_INFINITY" false false false)
            g.setMember("NEGATIVE_INFINITY" (EvValueBridge.taggedNumber((0.0 - inf))))
            g.setAttrs("NEGATIVE_INFINITY" false false false)
            g.setMember("NaN" (EvValueBridge.taggedNumber((0.0 / 0.0))))
            g.setAttrs("NaN" false false false)
            g.setMember("MAX_SAFE_INTEGER" (EvValueBridge.taggedNumber(9007199254740991.0)))
            g.setAttrs("MAX_SAFE_INTEGER" false false false)
            g.setMember("MIN_SAFE_INTEGER" (EvValueBridge.taggedNumber((0.0 - 9007199254740991.0))))
            g.setAttrs("MIN_SAFE_INTEGER" false false false)
        }
        return g
    }

    ; The receiver kind a built-in constructor's prototype serves.
    ; Inverse of kindForCtorName: the constructor whose prototype serves a kind.
    fn ctorNameForKind:string (kind:string) {
        if (kind == "array") { return "Array" }
        if (kind == "string") { return "String" }
        if (kind == "number") { return "Number" }
        if (kind == "boolean") { return "Boolean" }
        if (kind == "regexp") { return "RegExp" }
        if (kind == "function") { return "Function" }
        if (kind == "map") { return "Map" }
        if (kind == "set") { return "Set" }
        if (kind == "date") { return "Date" }
        if (kind == "promise") { return "Promise" }
        if (kind == "bigint") { return "BigInt" }
        if (kind == "arraybuffer") { return "ArrayBuffer" }
        if (kind == "sharedarraybuffer") { return "SharedArrayBuffer" }
        if (kind == "dataview") { return "DataView" }
        if (kind == "intlcollator") { return "Intl.Collator" }
        if (kind == "intlnumberformat") { return "Intl.NumberFormat" }
        if (kind == "intldatetimeformat") { return "Intl.DateTimeFormat" }
        if (kind == "intlpluralrules") { return "Intl.PluralRules" }
        if (kind == "intllistformat") { return "Intl.ListFormat" }
        return ""
    }

    fn kindForCtorName:string (nsName:string) {
        if (nsName == "Array") { return "array" }
        if (nsName == "String") { return "string" }
        if (nsName == "Number") { return "number" }
        ; Boolean was missing, so Boolean.prototype published no methods at all
        ; and every read of one fell through to Object.prototype.
        if (nsName == "Boolean") { return "boolean" }
        if (nsName == "RegExp") { return "regexp" }
        if (nsName == "Function") { return "function" }
        if (nsName == "Map") { return "map" }
        if (nsName == "Set") { return "set" }
        if (nsName == "Date") { return "date" }
        if (nsName == "Promise") { return "promise" }
        ; D-BIGINT / D-WEAK / D-SHARED: without these the prototype published no
        ; methods and every read fell through to Object.prototype, so
        ; `(255n).toString(16)` answered "[object Object]".
        if (nsName == "BigInt") { return "bigint" }
        if (nsName == "WeakMap") { return "weakmap" }
        if (nsName == "WeakSet") { return "weakset" }
        if (nsName == "WeakRef") { return "weakref" }
        if (nsName == "FinalizationRegistry") { return "weakregistry" }
        if (nsName == "SharedArrayBuffer") { return "sharedarraybuffer" }
        if (nsName == "ArrayBuffer") { return "arraybuffer" }
        if (nsName == "Object") { return "object" }
        return ""
    }

    ; Every registered method name for a kind. Kept beside builtinArity, which
    ; remains the authority on whether a name exists: builtinPrototype asserts
    ; each name here is registered, so the two cannot silently drift apart.
    ; annexB B.2.2: each wrapper names a tag and, for four of them, one
    ; attribute. Kept as a table rather than thirteen near-identical arms.
    fn isHtmlWrapName:boolean (name:string) {
        return ((strlen (this.htmlWrapTag(name))) > 0)
    }
    fn htmlWrapTag:string (name:string) {
        if (name == "anchor") { return "a" }
        if (name == "link") { return "a" }
        if (name == "big") { return "big" }
        if (name == "blink") { return "blink" }
        if (name == "bold") { return "b" }
        if (name == "fixed") { return "tt" }
        if (name == "fontcolor") { return "font" }
        if (name == "fontsize") { return "font" }
        if (name == "italics") { return "i" }
        if (name == "small") { return "small" }
        if (name == "strike") { return "strike" }
        if (name == "sub") { return "sub" }
        if (name == "sup") { return "sup" }
        return ""
    }
    fn htmlWrapAttr:string (name:string) {
        if (name == "anchor") { return "name" }
        if (name == "link") { return "href" }
        if (name == "fontcolor") { return "color" }
        if (name == "fontsize") { return "size" }
        return ""
    }

    fn builtinNames:[string] (kind:string) {
        def out:[string]
        if (kind == "function") {
            push out "@@hasInstance"
            push out "call"
            push out "apply"
            push out "bind"
        }
        if (kind == "string") {
            push out "@@iterator"
            push out "at"
            push out "charAt"
            push out "charCodeAt"
            push out "codePointAt"
            push out "concat"
            push out "endsWith"
            push out "includes"
            push out "indexOf"
            push out "lastIndexOf"
            push out "localeCompare"
            push out "match"
            push out "matchAll"
            push out "normalize"
            push out "padEnd"
            push out "padStart"
            push out "repeat"
            push out "replace"
            push out "replaceAll"
            push out "search"
            push out "slice"
            push out "split"
            push out "startsWith"
            push out "substr"
            push out "substring"
            push out "toLocaleLowerCase"
            push out "toLocaleString"
            push out "toLocaleUpperCase"
            push out "toLowerCase"
            push out "toUpperCase"
            ; --- annexB HTML wrappers (B.2.2), legacy but specified ---
            push out "anchor"
            push out "big"
            push out "blink"
            push out "bold"
            push out "fixed"
            push out "fontcolor"
            push out "fontsize"
            push out "italics"
            push out "link"
            push out "small"
            push out "strike"
            push out "sub"
            push out "sup"
            push out "trim"
            push out "trimEnd"
            push out "trimStart"
            push out "trimLeft"
            push out "trimRight"
        }
        if (kind == "array") {
            ; D-ITERATOR: the ES2015 iteration methods, plus the well-known
            ; symbol that makes an array iterable through the protocol rather
            ; than only through the engine's own for-of special case.
            push out "entries"
            push out "keys"
            push out "values"
            push out "@@iterator"
            push out "at"
            push out "concat"
            push out "copyWithin"
            push out "every"
            push out "fill"
            push out "filter"
            push out "find"
            push out "findIndex"
            push out "flat"
            push out "flatMap"
            push out "findLast"
            push out "findLastIndex"
            push out "toReversed"
            push out "toSorted"
            push out "toSpliced"
            push out "with"
            push out "forEach"
            push out "includes"
            push out "indexOf"
            push out "join"
            push out "lastIndexOf"
            push out "map"
            push out "pop"
            push out "push"
            push out "reduce"
            push out "reduceRight"
            push out "reverse"
            push out "shift"
            push out "slice"
            push out "some"
            push out "sort"
            push out "splice"
            push out "unshift"
        }
        if (kind == "arraybuffer") {
            push out "slice"
            ; ES2024: transfer moves the bytes to a new buffer and DETACHES this
            ; one; resize needs a buffer that was created resizable.
            push out "transfer"
            push out "transferToFixedLength"
            push out "resize"
        }
        if (kind == "sharedarraybuffer") {
            push out "slice"
            push out "grow"
        }
        if (kind == "dataview") {
            push out "getBigInt64"
            push out "setBigInt64"
            push out "getBigUint64"
            push out "setBigUint64"
            push out "getInt8"
            push out "setInt8"
            push out "getUint8"
            push out "setUint8"
            push out "getInt16"
            push out "setInt16"
            push out "getUint16"
            push out "setUint16"
            push out "getInt32"
            push out "setInt32"
            push out "getUint32"
            push out "setUint32"
            push out "getFloat32"
            push out "setFloat32"
            push out "getFloat64"
            push out "setFloat64"
        }
        if (kind == "intlcollator") {
            push out "compare"
            push out "resolvedOptions"
        }
        if (kind == "intlnumberformat") {
            push out "format"
            push out "formatToParts"
            push out "formatRange"
            push out "formatRangeToParts"
            push out "resolvedOptions"
        }
        if (kind == "intldatetimeformat") {
            push out "format"
            push out "formatToParts"
            push out "formatRange"
            push out "formatRangeToParts"
            push out "resolvedOptions"
        }
        if (kind == "intlpluralrules") {
            push out "select"
            push out "resolvedOptions"
        }
        if (kind == "intllistformat") {
            push out "format"
            push out "formatToParts"
            push out "resolvedOptions"
        }
        if (kind == "typedarraystatic") {
            push out "of"
            push out "from"
        }
        if (kind == "promise") {
            push out "catch"
            push out "finally"
            push out "then"
        }
        ; D-WEAK: no iteration methods on any of these -- what a weak collection
        ; refuses to do is enumerate itself, and that part is not a consequence
        ; of collection but of the interface.
        if (kind == "weakmap") {
            push out "delete"
            push out "get"
            push out "has"
            push out "set"
        }
        if (kind == "weakset") {
            push out "add"
            push out "delete"
            push out "has"
        }
        if (kind == "weakref") {
            push out "deref"
        }
        if (kind == "bigint") {
            push out "toString"
            push out "toLocaleString"
            push out "valueOf"
        }
        if (kind == "weakregistry") {
            push out "register"
            push out "unregister"
            push out "cleanupSome"
        }
        ; D-ITERATOR: the shared iterator object's own methods, plus the ES2025
        ; iterator helpers. The helpers are eager here because every iterator in
        ; this realm is already a materialised list -- `take` on an endless
        ; sequence is the one thing that costs, and there are no endless
        ; sequences to be had.
        if (kind == "listiterator") {
            push out "next"
            push out "@@iterator"
            push out "map"
            push out "filter"
            push out "take"
            push out "drop"
            push out "flatMap"
            push out "reduce"
            push out "toArray"
            push out "forEach"
            push out "some"
            push out "every"
            push out "find"
        }
        if (kind == "regexp") {
            ; annexB B.2.5.1: compile reinitialises the pattern IN PLACE.
            push out "compile"
            push out "exec"
            push out "test"
            ; D-REGEXSYMBOL: the ES2015 well-known-symbol methods. Their keys are
            ; the symbol keys `@@match` … themselves, which is what publishes
            ; them under `RegExp.prototype[Symbol.match]`.
            push out "@@match"
            push out "@@replace"
            push out "@@search"
            push out "@@split"
        }
        if (kind == "number") {
            push out "toExponential"
            push out "toFixed"
            push out "toLocaleString"
            push out "toPrecision"
        }
        if (kind == "map") {
            push out "@@iterator"
            push out "clear"
            push out "delete"
            push out "entries"
            push out "forEach"
            push out "get"
            push out "has"
            push out "keys"
            push out "set"
            push out "values"
        }
        if (kind == "set") {
            push out "@@iterator"
            push out "add"
            push out "clear"
            push out "delete"
            push out "forEach"
            push out "has"
            push out "keys"
            push out "values"
            ; ES2025 set operations. Every one of them takes a SET-LIKE -- an
            ; object with a numeric `size` and callable `has` and `keys` -- not
            ; a Set, which is why an ordinary Set is only the common case.
            push out "union"
            push out "intersection"
            push out "difference"
            push out "symmetricDifference"
            push out "isSubsetOf"
            push out "isSupersetOf"
            push out "isDisjointFrom"
        }
        ; D-DATE: local time is UTC in this realm, so each accessor and its UTC
        ; twin are the same function. Both names are registered because guests
        ; and the suite reach for both.
        if (kind == "date") {
            push out "getDate"
            push out "getDay"
            push out "getFullYear"
            push out "getHours"
            push out "getMilliseconds"
            push out "getMinutes"
            push out "getMonth"
            push out "getSeconds"
            push out "getTime"
            push out "getTimezoneOffset"
            push out "getUTCDate"
            push out "getUTCDay"
            push out "getUTCFullYear"
            push out "getUTCHours"
            push out "getUTCMilliseconds"
            push out "getUTCMinutes"
            push out "getUTCMonth"
            push out "getUTCSeconds"
            push out "getYear"
            push out "setDate"
            push out "setFullYear"
            push out "setHours"
            push out "setMilliseconds"
            push out "setMinutes"
            push out "setMonth"
            push out "setSeconds"
            push out "setTime"
            push out "setUTCDate"
            push out "setUTCFullYear"
            push out "setUTCHours"
            push out "setUTCMilliseconds"
            push out "setUTCMinutes"
            push out "setUTCMonth"
            push out "setUTCSeconds"
            push out "setYear"
            push out "toGMTString"
            push out "toDateString"
            push out "toISOString"
            push out "toJSON"
            push out "toLocaleDateString"
            push out "toLocaleString"
            push out "toLocaleTimeString"
            push out "toTimeString"
            push out "toUTCString"
        }
        push out "toString"
        push out "valueOf"
        ; D-OBJPROTO: every object inherits these from Object.prototype, so they
        ; exist on every kind. They had call-site handlers but no registry
        ; entries, so `typeof Object.prototype.propertyIsEnumerable` was
        ; "undefined" for a method that plainly works.
        push out "hasOwnProperty"
        push out "isPrototypeOf"
        push out "propertyIsEnumerable"
        push out "toLocaleString"
        ; annexB B.2.2.2-5: the four accessor helpers. They predate
        ; Object.defineProperty and are still what a lot of older code reaches
        ; for -- and `__lookupGetter__` walks the PROTOTYPE CHAIN, which is the
        ; one thing about them that is not obvious.
        push out "__defineGetter__"
        push out "__defineSetter__"
        push out "__lookupGetter__"
        push out "__lookupSetter__"
        return out
    }

    ; The prototype object for a built-in constructor, created once per engine so
    ; a property assigned to it persists and compares equal across reads. It is
    ; POPULATED from the registry, which is what makes `Array.prototype.slice` a
    ; real value reachable without an instance — the whole point of the refactor.
    ; Names that belong to Object.prototype and are only INHERITED elsewhere.
    fn isObjectProtoOnly:boolean (name:string) {
        if (name == "hasOwnProperty") { return true }
        if (name == "isPrototypeOf") { return true }
        if (name == "propertyIsEnumerable") { return true }
        return false
    }

    ; Which prototypes own `valueOf`. Object, the three wrappers and Date do;
    ; Array, Function and RegExp only inherit it, so publishing it on them made
    ; `Function.prototype.hasOwnProperty("valueOf")` true for a property
    ; Function.prototype does not have.
    fn ownsValueOf:boolean (nsName:string) {
        if (nsName == "Object") { return true }
        if (nsName == "Number") { return true }
        if (nsName == "String") { return true }
        if (nsName == "Boolean") { return true }
        if (nsName == "Date") { return true }
        return false
    }

    fn builtinPrototype:EvHandle (nsName:string) {
        def found@(optional):EvHandle (get builtinProtos nsName)
        if (!null? found) {
            return (unwrap found)
        }
        def keysB:[string]
        def valsB:[EvHandle]
        def p:EvHandle (EvValueBridge.taggedObject(keysB valsB))
        ; Function.prototype is itself a function -- `typeof Function.prototype`
        ; is "function" and calling it returns undefined. Every other built-in
        ; prototype is an ordinary object.
        ; D-PROTOKIND: Array.prototype is itself an ARRAY -- `Array.isArray`
        ; says so and its `length` is 0 -- just as Function.prototype is itself
        ; callable. Making it a plain object meant both answered wrongly for a
        ; value the spec is explicit about.
        if (nsName == "Array") {
            def emptyEls:[EvHandle]
            p = (EvValueBridge.taggedArray(emptyEls))
        }
        ; %Iterator.prototype% is the object every iterator here already
        ; inherits from, not a second one beside it -- otherwise
        ; `[].values() instanceof Iterator` would be false.
        if (nsName == "Iterator") {
            def ip:EvHandle (this.listIteratorPrototype())
            set builtinProtos nsName ip
            return ip
        }
        if (nsName == "Function") {
            p = (EvValueBridge.taggedNativeFunction(""))
            ; Function.prototype is callable but is NOT a constructor, so it has
            ; no `prototype` property of its own -- the synthesised one made
            ; `Object.getOwnPropertyDescriptor(Function.prototype, "prototype")`
            ; answer a descriptor for a property that should not exist.
            p.addSuppressed("prototype")
            ; Calling it returns undefined whatever it is handed. Marked so the
            ; call paths can tell it from an uncallable value -- it has no
            ; function node and no builtin name, which is otherwise exactly what
            ; "not a function" looks like.
            p.setMember("__fnprotocall__" (EvValueBridge.taggedBoolean(true)))
            p.setAttrs("__fnprotocall__" false false false)
        }
        ; Mark the handle and bump the dispatch epoch: minting a prototype
        ; changes what overriddenPrototypeMethod / kindRegistryDeleted can
        ; answer, and every later write through the handle bumps again —
        ; which is what lets call-site caches skip those probes entirely.
        p.isProtoObject = true
        def dEp:EvDispatchEpoch (EvDispatchEpoch.__singleton())
        dEp.bump()
        set builtinProtos nsName p
        ; D-PROTOCTOR: every built-in prototype inherits from Object.prototype,
        ; which is what makes `delete Number.prototype.toString` fall back to
        ; the branding one and `Object.prototype.isPrototypeOf(Number.prototype)`
        ; true. Object.prototype itself terminates the chain.
        if (nsName != "Object") {
            p.setProto((this.builtinPrototype("Object")))
        }
        ; %AsyncFunction.prototype% sits BELOW Function.prototype, not beside
        ; it: an async function is a function, so everything on Function
        ; .prototype still reaches it.
        if (nsName == "AsyncFunction") {
            p.setProto((this.builtinPrototype("Function")))
            p.setMember("@@toStringTag" (EvValueBridge.taggedString("AsyncFunction")))
            p.setAttrs("@@toStringTag" false false true)
        }
        ; D-PROTOCTOR: every prototype carries `constructor` back to its global.
        ; Safe against the cycle (global sets prototype, prototype sets
        ; constructor) because both cache their object BEFORE populating it.
        def ctorG:EvHandle (this.builtinGlobalObject(nsName))
        if (false == (ctorG.isNull())) {
            p.setMember("constructor" ctorG)
            ; Non-enumerable, like every other property of a built-in prototype.
            p.setAttrs("constructor" true false true)
        }
        ; D-CLASSOF: Number.prototype, String.prototype and Boolean.prototype are
        ; themselves boxed primitives holding +0, "" and false. That is not a
        ; curiosity -- it is what makes `Number.prototype.toString()` answer "0"
        ; instead of "[object Object]", and the toString/toFixed areas are
        ; written to check exactly that.
        if (nsName == "Number") {
            p.setMember("__primitive__" (EvValueBridge.taggedNumber(0.0)))
            p.setMember("__wrapper__" (EvValueBridge.taggedString("Number")))
        }
        if (nsName == "String") {
            p.setMember("__primitive__" (EvValueBridge.taggedString("")))
            p.setMember("__wrapper__" (EvValueBridge.taggedString("String")))
            p.setMember("length" (EvHandle.fromInt(0)))
            p.setAttrs("length" false false false)
        }
        if (nsName == "Boolean") {
            p.setMember("__primitive__" (EvValueBridge.taggedBoolean(false)))
            p.setMember("__wrapper__" (EvValueBridge.taggedString("Boolean")))
        }
        ; ES2015: the prototypes that brand themselves through
        ; Symbol.toStringTag rather than through a [[Class]] slot. Absent, both
        ; `Promise.prototype[Symbol.toStringTag]` and the `Object.prototype
        ; .toString` result that reads it were undefined. Non-writable and
        ; non-enumerable, configurable -- the shape the suite verifies.
        def tagFor:string ""
        if (nsName == "Promise") { tagFor = "Promise" }
        if (nsName == "Symbol") { tagFor = "Symbol" }
        if (nsName == "Map") { tagFor = "Map" }
        if (nsName == "Set") { tagFor = "Set" }
        if (nsName == "WeakMap") { tagFor = "WeakMap" }
        if (nsName == "WeakSet") { tagFor = "WeakSet" }
        if (nsName == "WeakRef") { tagFor = "WeakRef" }
        if (nsName == "SharedArrayBuffer") { tagFor = "SharedArrayBuffer" }
        ; ArrayBuffer and DataView brand the same way, and did not: even
        ; `Object.prototype.toString.call(new ArrayBuffer(8))` answered
        ; "[object Object]". SharedArrayBuffer was already here, which is what
        ; made the omission of its sibling visible.
        if (nsName == "ArrayBuffer") { tagFor = "ArrayBuffer" }
        if (nsName == "DataView") { tagFor = "DataView" }
        ; A CONCRETE typed array brands as its own constructor name.
        if (this.isTypedArrayCtorName(nsName)) { tagFor = nsName }
        if (nsName == "FinalizationRegistry") { tagFor = "FinalizationRegistry" }
        if ((strlen tagFor) > 0) {
            p.setMember("@@toStringTag" (EvValueBridge.taggedString(tagFor)))
            p.setAttrs("@@toStringTag" false false true)
        }
        ; ES2015 22.1.3.32: Array.prototype[@@unscopables] names the methods a
        ; `with` block must not shadow -- the ones added after ES5, which older
        ; code may be using as its own variable names.
        if (nsName == "Array") {
            def unsK:[string]
            def unsV:[EvHandle]
            def uns:EvHandle (EvValueBridge.taggedObject(unsK unsV))
            uns.setProto((EvValueBridge.taggedNull()))
            def unsNames:[string]
            push unsNames "copyWithin"
            push unsNames "entries"
            push unsNames "fill"
            push unsNames "find"
            push unsNames "findIndex"
            push unsNames "includes"
            push unsNames "keys"
            push unsNames "values"
            def uni:int 0
            while (uni < (array_length unsNames)) {
                uns.setMember((itemAt unsNames uni) (EvValueBridge.taggedBoolean(true)))
                uni = (uni + 1)
            }
            p.setMember("@@unscopables" uns)
            p.setAttrs("@@unscopables" false false true)
        }
        ; annexB B.2.2.1: Object.prototype.__proto__, as the accessor pair the
        ; spec defines rather than a data property.
        if (nsName == "Object") {
            p.defineGetter("__proto__" (this.sharedNativeMethod("protoaccessor" "get")))
            p.defineSetter("__proto__" (this.sharedNativeMethod("protoaccessor" "set")))
            p.setAttrs("__proto__" false false true)
        }
        ; D-REGEXACCESSOR: source/global/ignoreCase/multiline are ACCESSORS on
        ; RegExp.prototype -- get-only, non-enumerable, configurable -- which is
        ; the shape getOwnPropertyDescriptor is asked about. The instance keeps
        ; its ES5 own data properties as well; see CONFORMANCE.md.
        if (nsName == "RegExp") {
            def rgNames:[string]
            push rgNames "source"
            push rgNames "global"
            push rgNames "ignoreCase"
            push rgNames "multiline"
            push rgNames "sticky"
            push rgNames "unicode"
            push rgNames "flags"
            def rgi:int 0
            while (rgi < (array_length rgNames)) {
                def rgn:string (itemAt rgNames rgi)
                p.defineGetter(rgn (this.sharedNativeMethod("regexpget" rgn)))
                p.setAttrs(rgn false false true)
                rgi = (rgi + 1)
            }
        }
        def kind:string (this.kindForCtorName(nsName))
        if ((strlen kind) > 0) {
            ; D-PROTOKIND: the prototype remembers which receiver kind it serves,
            ; so an object that merely INHERITS from it can still reach the
            ; registry. `F.prototype = new Array(1,2,3); new F().filter(cb)` has
            ; to find Array.prototype.filter, and the instance's own kind is
            ; "object".
            p.setMember("__protokind__" (EvValueBridge.taggedString(kind)))
            def names:[string] (this.builtinNames(kind))
            def i:int 0
            while (i < (array_length names)) {
                def nm:string (itemAt names i)
                ; Registry is the authority: a name listed here that is not
                ; registered would hand out a value that does nothing when
                ; called, so it is skipped rather than published.
                ; D-OBJPROTO: the Object.prototype methods are REGISTERED for
                ; every kind so dispatch finds them, but they are OWN properties
                ; of Object.prototype alone -- publishing them everywhere made
                ; `Function.prototype.hasOwnProperty("valueOf")` true for a
                ; property Function.prototype only inherits.
                def publishHere:boolean (this.hasBuiltin(kind nm))
                if (this.isObjectProtoOnly(nm)) {
                    if (nsName != "Object") {
                        publishHere = false
                    }
                }
                if (nm == "valueOf") {
                    if (false == (this.ownsValueOf(nsName))) {
                        publishHere = false
                    }
                }
                if publishHere {
                    p.setMember(nm (this.sharedNativeMethod(kind nm)))
                    ; D-ATTRS: every built-in method is writable and
                    ; configurable but NOT enumerable, so `for (var k in
                    ; String.prototype)` yields nothing and Object.keys of a
                    ; prototype is empty. Publishing them enumerable made every
                    ; prototype look like a bag of own data.
                    p.setAttrs(nm true false true)
                }
                i = (i + 1)
            }
        }
        return p
    }

    ; ==========================================================================
    ; D-REGISTRY: built-in methods, dispatched by RECEIVER KIND then name.
    ; --------------------------------------------------------------------------
    ; The old dispatch was a single 1800-line if-chain keyed on the method NAME
    ; with only a handful of receiver-type guards, so `toString` on an array, an
    ; object and a number all reached the same branch and a correct type-specific
    ; implementation added later was unreachable — shadowed by position. Worse,
    ; a built-in was never a VALUE: `Array.prototype.slice` did not exist, so
    ; `slice.call(arguments)` could not work at all.
    ;
    ; The registry fixes both. `builtinArity` answers whether (kind, name) is a
    ; built-in — the single source of truth for what exists — and `invokeBuiltin`
    ; runs it. Because a method is identified by a (kind, name) PAIR rather than
    ; a function pointer (which Ranger does not have), the same pair can be
    ; handed out as a first-class value via EvHandle.nativeMethod.
    ;
    ; Framework surface is deliberately NOT in here: the native bridge,
    ; registerGlobal host injections, EVG/JSX helpers and AssemblyScript sized
    ; casts are the embedding rather than ECMAScript, and they keep priority by
    ; being routed before the registry.
    ; --------------------------------------------------------------------------
    ; D-PROTOKIND: the receiver kind an object INHERITS, by walking its prototype
    ; chain until something that is not a plain object turns up (an array
    ; prototype, say) or until a built-in prototype identifies itself. Returns ""
    ; when the chain says nothing, which leaves the caller's own dispatch alone.
    ; D-PROTOKIND: the prototype a value actually inherits from. An array, a
    ; string, a function and a RegExp carry no protoRef of their own -- they
    ; dispatch by KIND -- so asking for their prototype answered null and
    ; `Array.prototype.isPrototypeOf([])` was false. Object.prototype terminates
    ; the chain, and answering it for itself would loop.
    fn protoOfValue:EvHandle (v:EvHandle) {
        ; D-PROXY: the `getPrototypeOf` trap.
        if (this.isProxyValue(v)) {
            def qTgt:EvHandle (this.proxyTargetOf(v))
            def qTrap:EvHandle (this.proxyTrap(v "getPrototypeOf"))
            if scriptThrew {
                return (EvValueBridge.taggedNull())
            }
            if (qTrap.isFunction()) {
                def qArgs:[EvHandle]
                push qArgs qTgt
                def qRes:EvHandle (this.callProxyTrap(qTrap qArgs))
                if scriptThrew {
                    return (EvValueBridge.taggedNull())
                }
                ; A trap RESULT is held to the invariant, not taken on trust:
                ; [[GetPrototypeOf]] answers an Object or null and nothing else.
                def qOk:boolean false
                if (qRes.isNull()) { qOk = true }
                if (this.isDescriptorObject(qRes)) { qOk = true }
                if (this.isSymbolValue(qRes)) { qOk = false }
                if (false == qOk) {
                    return (this.throwSpecError("TypeError" "proxy getPrototypeOf must return an object or null"))
                }
                ; A NON-EXTENSIBLE target has a fixed prototype, so the trap
                ; may only report the one the target actually has.
                if (false == (qTgt.isExtensible())) {
                    def qCur:EvHandle (this.protoOfValue(qTgt))
                    def qSame:boolean false
                    if (qRes.isNull()) {
                        if (qCur.isNull()) { qSame = true }
                        if (qCur.isUndefined()) { qSame = true }
                    } {
                        if (qCur.isObject()) {
                            if (qCur.equals(qRes)) { qSame = true }
                        }
                    }
                    if (false == qSame) {
                        return (this.throwSpecError("TypeError" "proxy getPrototypeOf reported a different prototype for a non-extensible target"))
                    }
                }
                return qRes
            }
            return (this.protoOfValue(qTgt))
        }
        if (v.hasProto()) {
            return (v.protoOf())
        }
        def objProto:EvHandle (this.builtinPrototype("Object"))
        if (v.equals(objProto)) {
            return (EvValueBridge.taggedNull())
        }
        ; An async function inherits from %AsyncFunction.prototype%, which is
        ; what `Object.getPrototypeOf(async function () {}).constructor.name`
        ; reads to tell async functions apart from plain ones.
        if (v.isFunction()) {
            if (v.hasFunctionNode()) {
                def pfN:TSNode (v.functionNodeOf())
                if pfN.async {
                    if (false == pfN.generator) {
                        def afp:EvHandle (this.builtinPrototype("AsyncFunction"))
                        if (false == (v.equals(afp))) {
                            return afp
                        }
                    }
                }
            }
        }
        def cn:string (this.ctorNameForKind((this.receiverKind(v))))
        if ((strlen cn) > 0) {
            def kp:EvHandle (this.builtinPrototype(cn))
            if (false == (v.equals(kp))) {
                return kp
            }
        }
        if (v.isObject()) {
            return objProto
        }
        return (EvValueBridge.taggedNull())
    }

    fn protoChainKind:string (v:EvHandle) {
        if (false == (v.isObject())) {
            return ""
        }
        def cur:EvHandle v
        def depth:int 0
        while (depth < 16) {
            if (false == (cur.hasProto())) {
                return ""
            }
            def nxt:EvHandle (cur.protoOf())
            if (false == (nxt.isObject())) {
                return (this.receiverKind(nxt))
            }
            if (nxt.hasOwnData("__protokind__")) {
                return ((nxt.getOwnData("__protokind__")).toString())
            }
            cur = nxt
            depth = (depth + 1)
        }
        return ""
    }

    fn receiverKind:string (v:EvHandle) {
        ; PERF: an ordinary object -- one that has never been branded with a
        ; `__…__` marker -- is none of the special kinds below, so all ten
        ; hasOwnData probes are guaranteed to miss. Each of those builds a
        ; std::string and hashes it, and this function was 16.5% of
        ; instructions on the object_props shape, almost entirely here.
        ; The flag is monotone, so a false answer is always safe.
        if (v.plainMarkerFreeObject()) {
            return "object"
        }
        ; D-WRAPPER: a boxed primitive dispatches as its primitive kind, which
        ; is what makes `new String('a').toUpperCase()` reach String.prototype.
        if (v.isObject()) {
            if (v.hasOwnData("__primitive__")) {
                def inner:EvHandle (v.getOwnData("__primitive__"))
                if (inner.isString()) { return "string" }
                if (inner.isNumber()) { return "number" }
                if (inner.isBoolean()) { return "boolean" }
            }
        }
        if (v.isString()) { return "string" }
        if (v.isArrayValue()) { return "array" }
        if (v.isNumber()) { return "number" }
        if (v.isBoolean()) { return "boolean" }
        if (v.isFunction()) { return "function" }
        if (v.isMap()) { return "map" }
        if (v.isSet()) { return "set" }
        if (v.isObject()) {
            ; D-REGEX: a RegExp dispatches to its own prototype so exec/test do
            ; not have to be looked for among the Object methods.
            if (v.hasOwnData("__promise__")) { return "promise" }
            if (v.hasOwnData("__abbytes__")) {
                if (v.hasOwnData("__abshared__")) { return "sharedarraybuffer" }
                return "arraybuffer"
            }
            ; (byteLength / byteOffset / buffer are answered as PROPERTIES by
            ;  bufferOwnProperty, before dispatch gets this far.)
            if (v.hasOwnData("__dvbuffer__")) { return "dataview" }
            ; D-INTL: the slot names the object's own prototype.
            if (v.hasOwnData("__intlkind__")) {
                return ("intl" + ((v.getOwnData("__intlkind__")).stringOf()))
            }
            ; D-BIGINT: a BigInt dispatches to BigInt.prototype.
            if (v.hasOwnData("__biglimbs__")) { return "bigint" }
            ; D-WEAK: the slot names the kind outright.
            if (v.hasOwnData("__weakkind__")) {
                return ((v.getOwnData("__weakkind__")).stringOf())
            }
            if (v.hasOwnData("__regex__")) { return "regexp" }
            ; D-DATE: likewise a Date, whose accessors are arithmetic on its
            ; time value rather than anything Object.prototype offers.
            if (v.hasOwnData("__date__")) { return "date" }
            return "object"
        }
        return ""
    }

    ; Arity of a registered built-in, or -1 when (kind, name) is not one. Doubles
    ; as the existence check, so "is this a built-in" and "how many arguments"
    ; can never disagree.
    fn builtinArity:int (kind:string name:string) {
        if (kind == "function") {
            if (name == "@@hasInstance") { return 1 }
            if (name == "call") { return 1 }
            if (name == "apply") { return 2 }
            if (name == "bind") { return 1 }
        }
        ; D-INTL
        if (kind == "intlcollator") {
            if (name == "compare") { return 2 }
            if (name == "resolvedOptions") { return 0 }
        }
        if (kind == "intlnumberformat") {
            if (name == "format") { return 1 }
            if (name == "formatToParts") { return 1 }
            if (name == "formatRange") { return 2 }
            if (name == "formatRangeToParts") { return 2 }
            if (name == "resolvedOptions") { return 0 }
        }
        if (kind == "intldatetimeformat") {
            if (name == "format") { return 1 }
            if (name == "formatToParts") { return 1 }
            if (name == "formatRange") { return 2 }
            if (name == "formatRangeToParts") { return 2 }
            if (name == "resolvedOptions") { return 0 }
        }
        if (kind == "intlpluralrules") {
            if (name == "select") { return 1 }
            if (name == "resolvedOptions") { return 0 }
        }
        if (kind == "intllistformat") {
            if (name == "format") { return 1 }
            if (name == "formatToParts") { return 1 }
            if (name == "resolvedOptions") { return 0 }
        }
        ; D-REGEXACCESSOR: the GETTER halves of RegExp.prototype's source, global,
        ; ignoreCase and multiline. A kind of their own, so they are dispatchable
        ; values without becoming methods anyone can call as `re.source()`.
        ; Registered before the shared names below because `source` is not one of
        ; them and the flags are not methods at all.
        ; D-ARGUMENTS: the poisoned `callee` accessor a STRICT arguments object
        ; carries. Both halves are the same entry -- reading or writing throws.
        if (kind == "argpoison") {
            if (name == "callee") { return 0 }
            return (0 - 1)
        }
        ; annexB B.2.2.1: Object.prototype.__proto__ is an ACCESSOR pair, and
        ; the setter takes one argument.
        if (kind == "protoaccessor") {
            if (name == "get") { return 0 }
            if (name == "set") { return 1 }
            return (0 - 1)
        }
        ; @@species is a getter that answers the constructor it was read from.
        if (kind == "speciesget") {
            if (name == "get") { return 0 }
            return (0 - 1)
        }
        if (kind == "regexpget") {
            if (name == "source") { return 0 }
            if (name == "global") { return 0 }
            if (name == "ignoreCase") { return 0 }
            if (name == "multiline") { return 0 }
            if (name == "sticky") { return 0 }
            if (name == "unicode") { return 0 }
            if (name == "flags") { return 0 }
            return (0 - 1)
        }
        ; toString exists on every kind, but with a DIFFERENT implementation per
        ; kind. That is the whole point of keying on the receiver: the old single
        ; branch answered "[1, 2]" for an array and "{}" for an object, both of
        ; which are the engine's debug format rather than the language's.
        if (name == "toString") { return 0 }
        if (name == "valueOf") { return 0 }
        if (name == "hasOwnProperty") { return 1 }
        if (name == "isPrototypeOf") { return 1 }
        if (name == "propertyIsEnumerable") { return 1 }
        if (name == "toLocaleString") { return 0 }
        if (name == "__defineGetter__") { return 2 }
        if (name == "__defineSetter__") { return 2 }
        if (name == "__lookupGetter__") { return 1 }
        if (name == "__lookupSetter__") { return 1 }
        ; String methods belong to strings ONLY. Registering them per-kind is
        ; what makes `[1,2].charAt(0)` a TypeError instead of returning "[" —
        ; the old unguarded branch stringified the array and indexed its debug
        ; format.
        if (kind == "date") {
            if (name == "setTime") { return 1 }
            if (name == "setMilliseconds") { return 1 }
            if (name == "setUTCMilliseconds") { return 1 }
            if (name == "setSeconds") { return 2 }
            if (name == "setUTCSeconds") { return 2 }
            if (name == "setMinutes") { return 3 }
            if (name == "setUTCMinutes") { return 3 }
            if (name == "setHours") { return 4 }
            if (name == "setUTCHours") { return 4 }
            if (name == "setDate") { return 1 }
            if (name == "setUTCDate") { return 1 }
            if (name == "setMonth") { return 2 }
            if (name == "setUTCMonth") { return 2 }
            if (name == "setFullYear") { return 3 }
            if (name == "setUTCFullYear") { return 3 }
            if (name == "setYear") { return 1 }
            if (name == "toGMTString") { return 0 }
            if (name == "getDate") { return 0 }
            if (name == "getDay") { return 0 }
            if (name == "getFullYear") { return 0 }
            if (name == "getHours") { return 0 }
            if (name == "getMilliseconds") { return 0 }
            if (name == "getMinutes") { return 0 }
            if (name == "getMonth") { return 0 }
            if (name == "getSeconds") { return 0 }
            if (name == "getTime") { return 0 }
            if (name == "getTimezoneOffset") { return 0 }
            if (name == "getUTCDate") { return 0 }
            if (name == "getUTCDay") { return 0 }
            if (name == "getUTCFullYear") { return 0 }
            if (name == "getUTCHours") { return 0 }
            if (name == "getUTCMilliseconds") { return 0 }
            if (name == "getUTCMinutes") { return 0 }
            if (name == "getUTCMonth") { return 0 }
            if (name == "getUTCSeconds") { return 0 }
            if (name == "getYear") { return 0 }
            if (name == "toDateString") { return 0 }
            if (name == "toISOString") { return 0 }
            if (name == "toJSON") { return 1 }
            if (name == "toLocaleDateString") { return 0 }
            if (name == "toLocaleString") { return 0 }
            if (name == "toLocaleTimeString") { return 0 }
            if (name == "toTimeString") { return 0 }
            if (name == "toUTCString") { return 0 }
        }
        if (kind == "string") {
            if (name == "at") { return 1 }
            if (name == "charCodeAt") { return 1 }
            if (name == "codePointAt") { return 1 }
            if (name == "concat") { return 1 }
            if (name == "localeCompare") { return 1 }
            if (name == "match") { return 1 }
            if (name == "matchAll") { return 1 }
            if (name == "normalize") { return 0 }
            if (name == "search") { return 1 }
            if (name == "substr") { return 2 }
            if (name == "toLocaleLowerCase") { return 0 }
            if (name == "toLocaleString") { return 0 }
            if (name == "toLocaleUpperCase") { return 0 }
            if (name == "endsWith") { return 1 }
            if (name == "includes") { return 1 }
            if (name == "indexOf") { return 1 }
            if (name == "lastIndexOf") { return 1 }
            if (name == "repeat") { return 1 }
            if (name == "replace") { return 2 }
            if (name == "replaceAll") { return 2 }
            if (name == "slice") { return 2 }
            if (name == "split") { return 2 }
            if (name == "startsWith") { return 1 }
            if (name == "trimEnd") { return 0 }
            if (name == "trimStart") { return 0 }
            if (name == "trimLeft") { return 0 }
            if (name == "trimRight") { return 0 }
            if (name == "charAt") { return 1 }
            if (name == "toUpperCase") { return 0 }
            if (name == "toLowerCase") { return 0 }
            if (name == "trim") { return 0 }
            if (name == "substring") { return 2 }
            if (name == "padStart") { return 2 }
            ; annexB B.2.2 wrappers: the four that take an attribute have
            ; length 1, the rest 0. builtinArity IS the registry -- a name it
            ; does not know is never published on the prototype, which is how
            ; these stayed invisible after being added to builtinNames alone.
            if (name == "anchor") { return 1 }
            if (name == "link") { return 1 }
            if (name == "fontcolor") { return 1 }
            if (name == "fontsize") { return 1 }
            if (name == "big") { return 0 }
            if (name == "blink") { return 0 }
            if (name == "bold") { return 0 }
            if (name == "fixed") { return 0 }
            if (name == "italics") { return 0 }
            if (name == "small") { return 0 }
            if (name == "strike") { return 0 }
            if (name == "sub") { return 0 }
            if (name == "sup") { return 0 }
            if (name == "padEnd") { return 2 }
        }
        if (kind == "map") {
            if (name == "clear") { return 0 }
            if (name == "delete") { return 1 }
            if (name == "entries") { return 0 }
            if (name == "forEach") { return 1 }
            if (name == "get") { return 1 }
            if (name == "has") { return 1 }
            if (name == "keys") { return 0 }
            if (name == "set") { return 2 }
            if (name == "values") { return 0 }
        }
        if (kind == "set") {
            if (name == "add") { return 1 }
            if (name == "clear") { return 0 }
            if (name == "delete") { return 1 }
            if (name == "forEach") { return 1 }
            if (name == "has") { return 1 }
            if (name == "keys") { return 0 }
            if (name == "values") { return 0 }
            if (name == "union") { return 1 }
            if (name == "intersection") { return 1 }
            if (name == "difference") { return 1 }
            if (name == "symmetricDifference") { return 1 }
            if (name == "isSubsetOf") { return 1 }
            if (name == "isSupersetOf") { return 1 }
            if (name == "isDisjointFrom") { return 1 }
        }
        if (kind == "array") {
            if (name == "at") { return 1 }
            if (name == "concat") { return 1 }
            if (name == "every") { return 1 }
            if (name == "copyWithin") { return 2 }
            if (name == "fill") { return 1 }
            if (name == "filter") { return 1 }
            if (name == "find") { return 1 }
            if (name == "findIndex") { return 1 }
            if (name == "flat") { return 0 }
            if (name == "flatMap") { return 1 }
            if (name == "findLast") { return 1 }
            if (name == "findLastIndex") { return 1 }
            if (name == "toReversed") { return 0 }
            if (name == "toSorted") { return 1 }
            if (name == "toSpliced") { return 2 }
            if (name == "with") { return 2 }
            if (name == "forEach") { return 1 }
            if (name == "includes") { return 1 }
            if (name == "indexOf") { return 1 }
            if (name == "join") { return 1 }
            if (name == "lastIndexOf") { return 1 }
            if (name == "map") { return 1 }
            if (name == "pop") { return 0 }
            if (name == "push") { return 1 }
            if (name == "reduce") { return 1 }
            if (name == "reduceRight") { return 1 }
            if (name == "reverse") { return 0 }
            if (name == "shift") { return 0 }
            if (name == "slice") { return 2 }
            if (name == "some") { return 1 }
            if (name == "sort") { return 1 }
            if (name == "splice") { return 2 }
            if (name == "unshift") { return 1 }
            ; Typed-array only; harmless on a plain array, which never reaches
            ; the implementation.
            if (name == "set") { return 1 }
            if (name == "subarray") { return 2 }
        }
        if (kind == "promise") {
            if (name == "then") { return 2 }
            if (name == "catch") { return 1 }
            if (name == "finally") { return 1 }
        }
        if (kind == "weakmap") {
            if (name == "delete") { return 1 }
            if (name == "get") { return 1 }
            if (name == "has") { return 1 }
            if (name == "set") { return 2 }
        }
        if (kind == "weakset") {
            if (name == "add") { return 1 }
            if (name == "delete") { return 1 }
            if (name == "has") { return 1 }
        }
        if (kind == "weakref") {
            if (name == "deref") { return 0 }
        }
        if (kind == "bigint") {
            if (name == "toString") { return 0 }
            if (name == "toLocaleString") { return 0 }
            if (name == "valueOf") { return 0 }
        }
        if (kind == "weakregistry") {
            if (name == "register") { return 2 }
            if (name == "unregister") { return 1 }
            if (name == "cleanupSome") { return 0 }
        }
        ; The two functions `finally` mints: the pair it passes to `then` takes
        ; the settled value, and the thunk that restores it afterwards takes
        ; nothing.
        if (kind == "promisefin") {
            return 1
        }
        if (kind == "promisefinval") {
            return 0
        }
        if (kind == "listiterator") {
            if (name == "next") { return 0 }
            if (name == "@@iterator") { return 0 }
            if (name == "map") { return 1 }
            if (name == "filter") { return 1 }
            if (name == "take") { return 1 }
            if (name == "drop") { return 1 }
            if (name == "flatMap") { return 1 }
            if (name == "reduce") { return 1 }
            if (name == "toArray") { return 0 }
            if (name == "forEach") { return 1 }
            if (name == "some") { return 1 }
            if (name == "every") { return 1 }
            if (name == "find") { return 1 }
        }
        if (kind == "Generator") {
            if (name == "next") { return 1 }
            if (name == "return") { return 1 }
            if (name == "throw") { return 1 }
            if (name == "@@iterator") { return 0 }
            if (name == "@@asyncIterator") { return 0 }
        }
        if (kind == "proxyrevoke") {
            if (name == "revoke") { return 0 }
        }
        ; D-ITERATOR: the iteration methods share one arity across every kind
        ; that has them.
        if ((name == "@@iterator") || ((name == "entries") || ((name == "keys") || (name == "values")))) {
            if ((kind == "array") || ((kind == "string") || ((kind == "map") || (kind == "set")))) {
                return 0
            }
        }
        if (kind == "promisecap") {
            if (name == "resolve") { return 1 }
            if (name == "reject") { return 1 }
        }
        if (kind == "arraybuffer") {
            if (name == "slice") { return 2 }
            if (name == "transfer") { return 0 }
            if (name == "transferToFixedLength") { return 0 }
            if (name == "resize") { return 1 }
            return 0
        }
        if (kind == "sharedarraybuffer") {
            if (name == "slice") { return 2 }
            if (name == "grow") { return 1 }
            return 0
        }
        if (kind == "dataview") {
            if ((substring name 0 3) == "get") { return 1 }
            return 2
        }
        if (kind == "typedarraystatic") {
            if (name == "of") { return 0 }
            if (name == "from") { return 1 }
            return 0
        }
        if (kind == "promiseexec") {
            return 2
        }
        if (kind == "promiseelem") {
            return 1
        }
        if (kind == "regexp") {
            if (name == "compile") { return 2 }
            if (name == "exec") { return 1 }
            if (name == "test") { return 1 }
            if (name == "@@match") { return 1 }
            if (name == "@@search") { return 1 }
            if (name == "@@replace") { return 2 }
            if (name == "@@split") { return 2 }
        }
        if (kind == "number") {
            if (name == "toExponential") { return 1 }
            if (name == "toFixed") { return 1 }
            if (name == "toLocaleString") { return 0 }
            if (name == "toPrecision") { return 1 }
        }
        return (0 - 1)
    }

    ; Number.prototype.toFixed formatting, lifted verbatim from the old chain
    ; branch so the migration cannot change its behaviour.
    ; D-RADIX: integer part in an arbitrary base, plus a bounded fractional
    ; expansion. Digits above 9 are lowercase letters, as the spec requires.
    fn numberToRadix:string (value:double radix:int) {
        if (value != value) {
            return "NaN"
        }
        def inf:double (1.0 / 0.0)
        if (value == inf) {
            return "Infinity"
        }
        if (value == (0.0 - inf)) {
            return "-Infinity"
        }
        def neg:boolean false
        def v:double value
        if (v < 0.0) {
            neg = true
            v = (0.0 - v)
        }
        def digits:string "0123456789abcdefghijklmnopqrstuvwxyz"
        def ip:int (to_int v)
        def out:string ""
        if (ip == 0) {
            out = "0"
        }
        while (ip > 0) {
            def d:int (ip % radix)
            def dEnd:int (d + 1)
            out = ((substring digits d dEnd) + out)
            ip = (to_int ((to_double ip) / (to_double radix)))
        }
        ; Fractional part, capped — an exact expansion can be unbounded in a
        ; base that does not divide the value evenly.
        def frac:double (v - (to_double (to_int v)))
        if (frac > 0.0) {
            out = (out + ".")
            def guard:int 0
            while ((frac > 0.0) && (guard < 20)) {
                frac = (frac * (to_double radix))
                def fd:int (to_int frac)
                def fEnd:int (fd + 1)
                out = (out + (substring digits fd fEnd))
                frac = (frac - (to_double fd))
                guard = (guard + 1)
            }
        }
        if neg {
            return ("-" + out)
        }
        return out
    }

    ; D-NUMFMT: Number.prototype.toFixed. The old version rounded with
    ; `to_int(x + 0.5)`, which truncates toward zero, so every negative number
    ; rounded the wrong way -- (-1.25).toFixed(1) answered "-1.2" instead of
    ; "-1.3" -- and it stringified NaN as "NaN.00". Sign is split off first and
    ; the magnitude formatted, which makes both signs behave the same.
    fn toFixedString:string (numVal:double decimals:int) {
        if (numVal != numVal) {
            return "NaN"
        }
        if (false == (this.isFiniteNum(numVal))) {
            if (numVal > 0.0) { return "Infinity" }
            return "-Infinity"
        }
        def neg:boolean (numVal < 0.0)
        def mag:double numVal
        if neg {
            mag = (0.0 - numVal)
        }
        ; A magnitude at or beyond 1e21 is rendered by ToString instead, per
        ; spec, because the fixed form would be meaningless. The bound is built
        ; by multiplication: a literal that large does not survive the Ranger
        ; lexer, which re-emits it in exponential form with a stray ".0".
        def e21:double (this.powNum(10.0 21))
        if (mag >= e21) {
            return (to_string numVal)
        }
        def body:string (this.fixedMagnitude(mag decimals))
        if neg {
            ; -0.004 to 1 place is "-0.0" in JS: the sign survives even when
            ; every digit rounds away.
            return ("-" + body)
        }
        return body
    }

    ; The digits of a NON-NEGATIVE magnitude with exactly `decimals` places.
    fn fixedMagnitude:string (mag:double decimals:int) {
        ; D-NUMFMT: when the value's own shortest decimal form already fits in
        ; `decimals` places, that form padded with zeros IS the answer, and it
        ; is the only way to get it right for a large `decimals`: scaling by
        ; 10^30 or 10^100 cannot be done in a double, so `(1).toFixed(30)` came
        ; back as 0.999999999999999900000000000000.
        def shortForm:string (this.toStringOf((EvValueBridge.taggedNumber(mag))))
        if ((indexOf shortForm "e") < 0) {
            def dotAt:int (indexOf shortForm ".")
            def whole:string shortForm
            def frac:string ""
            if (dotAt >= 0) {
                whole = (substring shortForm 0 dotAt)
                frac = (substring shortForm (dotAt + 1) (strlen shortForm))
            }
            if ((strlen frac) <= decimals) {
                if (decimals == 0) {
                    return whole
                }
                def padded:string frac
                def pz:int (strlen frac)
                while (pz < decimals) {
                    padded = (padded + "0")
                    pz = (pz + 1)
                }
                return (whole + ("." + padded))
            }
        }
        def multiplier:double 1.0
        def i:int 0
        while (i < decimals) {
            multiplier = (multiplier * 10.0)
            i = (i + 1)
        }
        def scaled:double (mag * multiplier)
        ; Round half away from zero on the magnitude, which is round-half-up
        ; once the sign is back on.
        def rounded:double (this.floorNum((scaled + 0.5)))
        ; Carry the digits out by hand: the double may not hold the integer
        ; exactly, but the string form of the rounded value does.
        def digits:string (this.integerDigits(rounded))
        if (decimals == 0) {
            return digits
        }
        def L:int (strlen digits)
        if (L <= decimals) {
            def pad:string "0."
            def z:int 0
            while (z < (decimals - L)) {
                pad = (pad + "0")
                z = (z + 1)
            }
            return (pad + digits)
        }
        def cut:int (L - decimals)
        return ((substring digits 0 cut) + ("." + (substring digits cut L)))
    }

    ; The decimal digits of a non-negative integral double, without an exponent
    ; and without a fractional part. `to_string` may hand back "1e+21" or
    ; "123.0" depending on magnitude, and neither is usable as a digit string.
    fn integerDigits:string (v:double) {
        def s:string (to_string v)
        ; The EXPONENT is looked for first. Stripping at the dot beforehand
        ; turned "9.9999999999999997e+29" into "9" and threw the exponent away
        ; with it, so `(1).toFixed(30)` answered 0.000…009 -- but `(1).toFixed(50)`
        ; was right, because that magnitude happened to print without a dot.
        def e:int (indexOf s "e")
        if (e >= 0) {
            ; Exponential form: expand it rather than returning it verbatim.
            def mant:string (substring s 0 e)
            def expPart:string (substring s (e + 1) (strlen s))
            if ((substring expPart 0 1) == "+") {
                expPart = (substring expPart 1 (strlen expPart))
            }
            def ex@(optional):int (to_int expPart)
            if ex {
                def k:int (unwrap ex)
                def md:int (indexOf mant ".")
                def whole:string mant
                def frac:string ""
                if (md >= 0) {
                    whole = (substring mant 0 md)
                    frac = (substring mant (md + 1) (strlen mant))
                }
                def out:string (whole + frac)
                def need:int (k - (strlen frac))
                def z:int 0
                while (z < need) {
                    out = (out + "0")
                    z = (z + 1)
                }
                return out
            }
        }
        def dot:int (indexOf s ".")
        if (dot >= 0) {
            s = (substring s 0 dot)
        }
        return s
    }

    ; D-NUMFMT: Number.prototype.toExponential -- one digit before the point,
    ; `fractionDigits` after, then the base-10 exponent.
    ; The fraction-digit count a no-argument toExponential needs: the shortest
    ; round-tripping decimal form of the value carries exactly the significant
    ; digits, and one of them sits before the point.
    fn significantDigitsOf:int (v:double) {
        if (v == 0.0) {
            return 0
        }
        def s:string (this.toStringOf((EvValueBridge.taggedNumber(v))))
        def digits:string ""
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def c:int (charAt s i)
            if ((c >= 48) && (c <= 57)) {
                digits = (digits + (substring s i (i + 1)))
            }
            ; The exponent's own digits are not significant digits of the
            ; mantissa, so the scan stops where it begins.
            if ((c == 101) || (c == 69)) {
                i = n
            }
            i = (i + 1)
        }
        ; Leading zeros belong to the scale, not to the value: 0.00123 carries
        ; three significant digits, not six.
        def lead:int 0
        while (lead < (strlen digits)) {
            if ((charAt digits lead) != 48) {
                lead = (strlen digits)
            } {
                lead = (lead + 1)
            }
        }
        def firstNonZero:int 0
        def k:int 0
        def found:boolean false
        while (k < (strlen digits)) {
            if (false == found) {
                if ((charAt digits k) != 48) {
                    firstNonZero = k
                    found = true
                }
            }
            k = (k + 1)
        }
        if (false == found) {
            return 0
        }
        def trimmed:string (substring digits firstNonZero (strlen digits))
        ; Trailing zeros carry no information either.
        def endAt:int (strlen trimmed)
        while (endAt > 1) {
            if ((charAt trimmed (endAt - 1)) == 48) {
                endAt = (endAt - 1)
            } {
                endAt = 1
            }
        }
        def keep:int (strlen trimmed)
        def z:int (strlen trimmed)
        while (z > 1) {
            if ((charAt trimmed (z - 1)) == 48) {
                keep = (z - 1)
                z = (z - 1)
            } {
                z = 1
            }
        }
        def out:int (keep - 1)
        if (out < 0) {
            return 0
        }
        if (out > 100) {
            return 100
        }
        return out
    }

    fn toExponentialString:string (numVal:double fractionDigits:int) {
        if (numVal != numVal) {
            return "NaN"
        }
        if (false == (this.isFiniteNum(numVal))) {
            if (numVal > 0.0) { return "Infinity" }
            return "-Infinity"
        }
        def neg:boolean (numVal < 0.0)
        def mag:double numVal
        if neg { mag = (0.0 - numVal) }
        def e:int 0
        if (mag != 0.0) {
            while (mag >= 10.0) {
                mag = (mag / 10.0)
                e = (e + 1)
            }
            while (mag < 1.0) {
                mag = (mag * 10.0)
                e = (e - 1)
            }
        }
        def body:string (this.fixedMagnitude(mag fractionDigits))
        ; Rounding the mantissa can carry it past 10, which moves the exponent.
        if ((strlen body) > 0) {
            def firstTwo:string (substring body 0 2)
            if (firstTwo == "10") {
                e = (e + 1)
                mag = (mag / 10.0)
                body = (this.fixedMagnitude(mag fractionDigits))
            }
        }
        def sign:string "+"
        def eAbs:int e
        if (e < 0) {
            sign = "-"
            eAbs = (0 - e)
        }
        def out:string (body + ("e" + (sign + (to_string eAbs))))
        if neg {
            return ("-" + out)
        }
        return out
    }

    ; D-NUMFMT: Number.prototype.toPrecision -- `precision` significant digits,
    ; in fixed form when the exponent is small enough and exponential otherwise.
    fn toPrecisionString:string (numVal:double precision:int) {
        if (numVal != numVal) {
            return "NaN"
        }
        if (false == (this.isFiniteNum(numVal))) {
            if (numVal > 0.0) { return "Infinity" }
            return "-Infinity"
        }
        if (numVal == 0.0) {
            return (this.toFixedString(0.0 (precision - 1)))
        }
        def mag:double numVal
        if (mag < 0.0) { mag = (0.0 - mag) }
        def e:int 0
        def scan:double mag
        while (scan >= 10.0) {
            scan = (scan / 10.0)
            e = (e + 1)
        }
        while (scan < 1.0) {
            scan = (scan * 10.0)
            e = (e - 1)
        }
        if ((e < (0 - 6)) || (e >= precision)) {
            return (this.toExponentialString(numVal (precision - 1)))
        }
        return (this.toFixedString(numVal ((precision - 1) - e)))
    }


    ; padStart / padEnd share everything but which side the filler goes on.
    fn padString:string (s:string args:[EvHandle] atStart:boolean) {
        def target:int 0
        if ((array_length args) > 0) {
            target = (to_int ((itemAt args 0).toNumber()))
        }
        def filler:string " "
        if ((array_length args) > 1) {
            def fv:EvHandle (itemAt args 1)
            if (false == (fv.isUndefined())) {
                filler = (fv.toString())
            }
        }
        ; §22.1.3.16 StringPad measures in CODE UNITS. Measuring in bytes made
        ; the filler run short by one for every non-ASCII character already in
        ; the string, and a target smaller than the byte count skipped the
        ; padding entirely -- '日本'.padEnd(5) came back unpadded.
        def fillLen:int (this.cuLen(filler))
        if (fillLen == 0) {
            return s
        }
        def sLen:int (this.cuLen(s))
        if (target <= sLen) {
            return s
        }
        def need:int (target - sLen)
        def pad:string ""
        def have:int 0
        while (have < need) {
            pad = (pad + filler)
            have = (have + fillLen)
        }
        pad = (this.cuSlice(pad 0 need))
        if atStart {
            return (pad + s)
        }
        return (s + pad)
    }

    ; ToString for a value used as an ARRAY ELEMENT during join/toString: null
    ; and undefined render as empty, everything else by its own rules.
    fn elementToString:string (v:EvHandle) {
        if (v.isNull()) { return "" }
        if (v.isUndefined()) { return "" }
        ; Hole used to share valueType 8 with Undefined; now it is its own
        ; kind, so join/toString must skip it explicitly (spec: empty string).
        if (v.isHole()) { return "" }
        if (v.isArrayValue()) {
            return (this.arrayJoinString(v ","))
        }
        return (v.toString())
    }

    ; Array.prototype.join semantics, used by toString with a comma. Nested
    ; arrays flatten by recursion, which is why [[1,2],[3]] is "1,2,3".
    fn arrayJoinString:string (arr:EvHandle sep:string) {
        def out:string ""
        def i:int 0
        while (i < (arr.denseLen())) {
            if (i > 0) {
                out = (out + sep)
            }
            out = (out + (this.elementToString((arr.arrayItemAt(i)))))
            i = (i + 1)
        }
        return out
    }

    fn hasBuiltin:boolean (kind:string name:string) {
        return ((this.builtinArity(kind name)) >= 0)
    }

    ; D-DATE: the (year, month, day, hours, minutes, seconds, ms) form, shared by
    ; `new Date(y, m, ...)` and `Date.UTC` so the two cannot disagree. Both are
    ; UTC here, local time being UTC in this realm.
    fn dateFromParts:double (args:[EvHandle] isUTC:boolean) {
        def dtp (new DateTime())
        def nan:double (0.0 / 0.0)
        def n:int (array_length args)
        def y:double 1970.0
        def mo:double 0.0
        def dy:double 1.0
        def hh:double 0.0
        def mi:double 0.0
        def se:double 0.0
        def ms:double 0.0
        if (n > 0) { y = (this.toNumberOf((itemAt args 0))) }
        if (n > 1) { mo = (this.toNumberOf((itemAt args 1))) }
        if (n > 2) { dy = (this.toNumberOf((itemAt args 2))) }
        if (n > 3) { hh = (this.toNumberOf((itemAt args 3))) }
        if (n > 4) { mi = (this.toNumberOf((itemAt args 4))) }
        if (n > 5) { se = (this.toNumberOf((itemAt args 5))) }
        if (n > 6) { ms = (this.toNumberOf((itemAt args 6))) }
        if (y != y) {
            return nan
        }
        ; A two-digit year means 19xx, which is the legacy rule the spec keeps
        ; for this form only.
        def yi:double (dtp.truncD(y))
        if (dtp.isFiniteD(y)) {
            if ((yi >= 0.0) && (yi <= 99.0)) {
                yi = (1900.0 + yi)
            }
        } {
            yi = y
        }
        def dayNum:double (dtp.makeDay(yi mo dy))
        def tim:double (dtp.makeTime(hh mi se ms))
        return (dtp.timeClip((dtp.makeDate(dayNum tim))))
    }

    ; D-DATE: build a Date object from already-evaluated constructor arguments,
    ; shared by `new Date(...)` and by the reflective construction paths.
    fn makeDateValue:EvHandle (args:[EvHandle]) {
        def dtm (new DateTime())
        def keysDt:[string]
        def valsDt:[EvHandle]
        def dt:EvHandle (EvValueBridge.taggedObject(keysDt valsDt))
        def n:int (array_length args)
        def ms:double (this.realmNowMs())
        if (n == 1) {
            def only:EvHandle (this.toPrimitive((itemAt args 0) false))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            if (only.isString()) {
                ms = (dtm.parseISO((only.stringOf())))
            } {
                ms = (dtm.timeClip((this.toNumberOf(only))))
            }
        }
        if (n > 1) {
            ms = (this.dateFromParts(args false))
        }
        if (n == 0) {
            ms = (dtm.timeClip((this.realmNowMs())))
        }
        dt.setMember("__date__" (EvValueBridge.taggedNumber(ms)))
        dt.setAttrs("__date__" false false false)
        dt.setProto((this.builtinPrototype("Date")))
        return dt
    }

    fn isDateSetter:boolean (name:string) {
        if (name == "setMilliseconds") { return true }
        if (name == "setUTCMilliseconds") { return true }
        if (name == "setSeconds") { return true }
        if (name == "setUTCSeconds") { return true }
        if (name == "setMinutes") { return true }
        if (name == "setUTCMinutes") { return true }
        if (name == "setHours") { return true }
        if (name == "setUTCHours") { return true }
        if (name == "setDate") { return true }
        if (name == "setUTCDate") { return true }
        if (name == "setMonth") { return true }
        if (name == "setUTCMonth") { return true }
        if (name == "setFullYear") { return true }
        if (name == "setUTCFullYear") { return true }
        if (name == "setYear") { return true }
        return false
    }

    ; Which field of (year, month, date, hours, minutes, seconds, ms) a setter's
    ; FIRST argument writes. The remaining arguments continue down the list, which
    ; is exactly how the spec defines the optional tails of setHours and friends.
    fn dateSetterFirstField:int (name:string) {
        if (name == "setMilliseconds") { return 6 }
        if (name == "setUTCMilliseconds") { return 6 }
        if (name == "setSeconds") { return 5 }
        if (name == "setUTCSeconds") { return 5 }
        if (name == "setMinutes") { return 4 }
        if (name == "setUTCMinutes") { return 4 }
        if (name == "setHours") { return 3 }
        if (name == "setUTCHours") { return 3 }
        if (name == "setDate") { return 2 }
        if (name == "setUTCDate") { return 2 }
        if (name == "setMonth") { return 1 }
        if (name == "setUTCMonth") { return 1 }
        return 0
    }

    fn applyDateSetter:EvHandle (name:string recv:EvHandle tv:double args:[EvHandle]) {
        def dts (new DateTime())
        def nan:double (0.0 / 0.0)
        def t:double tv
        def setsYear:boolean false
        if (name == "setFullYear") { setsYear = true }
        if (name == "setUTCFullYear") { setsYear = true }
        if (name == "setYear") { setsYear = true }
        ; Only the year setters revive an invalid Date: they treat its time as
        ; +0 and build from there. Every other setter leaves it invalid.
        if (t != t) {
            if setsYear {
                t = 0.0
            }
        }
        def fields:[double]
        if (t != t) {
            push fields nan
            push fields nan
            push fields nan
            push fields nan
            push fields nan
            push fields nan
            push fields nan
        } {
            push fields (to_double (dts.yearFromTime(t)))
            push fields (to_double (dts.monthFromTime(t)))
            push fields (to_double (dts.dateFromTime(t)))
            push fields (to_double (dts.hourFromTime(t)))
            push fields (to_double (dts.minFromTime(t)))
            push fields (to_double (dts.secFromTime(t)))
            push fields (to_double (dts.msFromTime(t)))
        }
        def first:int (this.dateSetterFirstField(name))
        ; annexB B.2.4.2: setYear's argument is ToNumber'd whether or not it was
        ; supplied, so `d.setYear()` is ToNumber(undefined) -- NaN -- and the
        ; date becomes invalid. Skipping the absent argument left the year
        ; unchanged and answered the old time.
        if (name == "setYear") {
            if ((array_length args) == 0) {
                recv.setAttrs("__date__" true false false)
                recv.setMember("__date__" (EvValueBridge.taggedNumber(nan)))
                recv.setAttrs("__date__" false false false)
                return (EvValueBridge.taggedNumber(nan))
            }
        }
        def ai:int 0
        while (ai < (array_length args)) {
            def slot:int (first + ai)
            if (slot < 7) {
                def av:double (this.toNumberOf((itemAt args ai)))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                fields = (this.replaceAt(fields slot av))
            }
            ai = (ai + 1)
        }
        ; setYear is the Annex B one: a year in 0..99 means 19xx.
        if (name == "setYear") {
            def yv:double (itemAt fields 0)
            if (dts.isFiniteD(yv)) {

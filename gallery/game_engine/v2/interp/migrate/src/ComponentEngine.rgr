                    return (EvValueBridge.taggedString((this.unescapeString(esArg))))
                }
                ; Type-conversion globals Number()/String()/Boolean().
                if (fnName == "Number") {
                    if ((array_length node.children) > 0) {
                        ; ToNumber proper: an object runs valueOf/toString and a
                        ; string goes through the StringNumericLiteral grammar.
                        def nArg:EvHandle (this.evaluateExpr((itemAt node.children 0)))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                        ; D-BIGINT: Number(bigint) is the EXPLICIT conversion and
                        ; is allowed, where every implicit one is refused.
                        if (this.isBigIntValue(nArg)) {
                            def numBig2:BigNum (this.bigNumOf(nArg))
                            return (EvValueBridge.taggedNumber((numBig2.toDouble())))
                        }
                        return (EvValueBridge.taggedNumber((this.toNumberOf(nArg))))
                    }
                    return (EvValueBridge.taggedNumber(0.0))
                }
                if (fnName == "String") {
                    if ((array_length node.children) > 0) {
                        ; ToString, which for an object means running its own
                        ; toString/valueOf. The raw EvHandle.toString() is the
                        ; engine's debug dump, so `String({toString: …})`
                        ; answered "{toString: [Function: ]}".
                        def sArg:EvHandle (this.evaluateExpr((itemAt node.children 0)))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                        ; String() is the one conversion a SYMBOL permits.
                        if (this.isSymbolValue(sArg)) {
                            return (EvValueBridge.taggedString((this.symbolDisplayString(sArg))))
                        }
                        return (EvValueBridge.taggedString((this.toStringOf(sArg))))
                    }
                    return (EvValueBridge.taggedString(""))
                }
                if (fnName == "Boolean") {
                    if ((array_length node.children) > 0) {
                        return (EvValueBridge.taggedBoolean(((this.evaluateExpr((itemAt node.children 0))).toBool())))
                    }
                    return (EvValueBridge.taggedBoolean(false))
                }
                ; isNaN / isFinite. All numbers here are IEEE doubles; NaN is
                ; detected via the self-inequality identity (n != n). Infinity is
                ; not representable as a literal, so isFinite only rules out NaN.
                if (fnName == "isNaN") {
                    if ((array_length node.children) > 0) {
                        def nn:double (this.toNumberOf((this.evaluateExpr((itemAt node.children 0)))))
                        return (EvValueBridge.taggedBoolean((nn != nn)))
                    }
                    return (EvValueBridge.taggedBoolean(true))
                }
                if (fnName == "isFinite") {
                    if ((array_length node.children) > 0) {
                        ; Infinity is not NaN, so the old `nf == nf` test called
                        ; it finite. Both infinities have to be excluded too.
                        def nf:double (this.toNumberOf((this.evaluateExpr((itemAt node.children 0)))))
                        return (EvValueBridge.taggedBoolean((this.isFiniteNum(nf))))
                    }
                    return (EvValueBridge.taggedBoolean(false))
                }

                ; ============================================================
                ; Handle built-in hooks
                ; ============================================================

                }
                if (nativeBridge) {
                    def bridge:EvalNativeBridge (unwrap nativeBridge)
                    if (bridge.has(fnName)) {
                        def nativeArgs:[EvHandle] (this.collectCallArgs(node))
                        return (bridge.invoke(fnName nativeArgs))
                    }
                }
                
                ; Look up the function in context
                def fnValue:EvHandle (context.lookup(fnName))
                if (false == quiet) {
                    this.trace("Lookup function '" + fnName + "' -> type=" + (fnValue.kindName()) + " isFunction=" + (to_string (fnValue.isFunction())))
                }
                ; D-PROXY: a proxy over a function is CALLABLE -- `typeof p` is
                ; already "function" -- but the value is an object, so every
                ; check below skipped it and `p(41)` answered undefined without
                ; ever consulting the `apply` trap. callProxyApply has existed
                ; all along; only Reflect.apply and the value-call path reached
                ; it, never a bare `p(...)`.
                ; Proxy-BACKED, so `var b = p.bind(o); b()` arrives here too:
                ; bind copies the marker onto a function stub, which has no
                ; function node and so matched nothing below. The value path
                ; merges the bound receiver and arguments.
                if (this.isProxyBackedValue(fnValue)) {
                    def pxArgs:[EvHandle] (this.collectCallArgs(node))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    return (this.callFnValueWithValues(fnValue pxArgs))
                }
                ; D-REGISTRY: a built-in held in a variable is callable like any
                ; other function value. It has no functionNode, so the paths
                ; below skip it and it would silently do nothing.
                if (fnValue.isBuiltinMethod()) {
                    def bArgs0:[EvHandle] (this.collectCallArgs(node))
                    return (this.callFnValueWithValues(fnValue bArgs0))
                }
                if (this.isEvalFunctionValue(fnValue)) {
                    def ieArgs0:[EvHandle] (this.collectCallArgs(node))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    return (this.runIndirectEval(ieArgs0))
                }
                if (fnValue.isFunction()) {
                    if (fnValue.hasFunctionNode()) {
                        ; Args (with ...spread) bound centrally; the call scope is
                        ; parented on the function's captured closure when it has
                        ; one, else the current scope (plain top-level functions).
                        def callArgVals:[EvHandle] (this.collectCallArgs(node))
                        return (this.callFnValueWithValues(fnValue callArgVals))
                    }
                    ; D-CTORVALUE: a built-in CONSTRUCTOR bound to a name -- by
                    ; assignment or by bind() -- has no function node but is
                    ; callable. Any arguments bind() fixed come first.
                    def ctorNm0:string (this.builtinCtorNameOf(fnValue))
                    if ((strlen ctorNm0) > 0) {
                        def ctorArgs0:[EvHandle] (this.collectCallArgs(node))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                        def merged0:[EvHandle]
                        def mi0:int 0
                        while (mi0 < (fnValue.boundArgCount())) {
                            push merged0 (fnValue.boundArgAt(mi0))
                            mi0 = (mi0 + 1)
                        }
                        def mj0:int 0
                        while (mj0 < (array_length ctorArgs0)) {
                            push merged0 (itemAt ctorArgs0 mj0)
                            mj0 = (mj0 + 1)
                        }
                        return (this.callBuiltinCtorValues(ctorNm0 merged0 false))
                    }
                }
            }

            ; Callee is itself an expression that yields a function value, e.g.
            ; an IIFE `(() => ({...}))()` or `(cond ? a : b)()`. Inline arrow/
            ; function expressions capture the current scope; anything else is
            ; evaluated. MemberExpression/Identifier callees are handled above.
            def calleeFn:EvHandle (this.resolveCallbackValue(callee))
            ; Same for a proxy (or a bound one) reached through an expression
            ; callee -- `p.bind(o)()`, `(cond ? p : q)(...)`.
            if (this.isProxyBackedValue(calleeFn)) {
                def pxArgs1:[EvHandle] (this.collectCallArgs(node))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                return (this.callFnValueWithValues(calleeFn pxArgs1))
            }
            ; D-REGISTRY: same for a built-in reached through an expression
            ; callee, e.g. `(cond ? a.slice : b.slice)(...)`.
            if (calleeFn.isBuiltinMethod()) {
                def bArgs1:[EvHandle] (this.collectCallArgs(node))
                return (this.callFnValueWithValues(calleeFn bArgs1))
            }
            if (this.isEvalFunctionValue(calleeFn)) {
                def ieArgs1:[EvHandle] (this.collectCallArgs(node))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                return (this.runIndirectEval(ieArgs1))
            }
            if (calleeFn.isFunction()) {
                if (calleeFn.hasFunctionNode()) {
                    def calleeArgs:[EvHandle] (this.collectCallArgs(node))
                    return (this.callFnValueWithValues(calleeFn calleeArgs))
                }
                ; D-CTORVALUE: a built-in CONSTRUCTOR held as a value has no
                ; function node but is perfectly callable -- `var f = Number;
                ; f(42)` and `Number.bind(null)(42)` both arrive here.
                if (calleeFn.hasOwnData("__fnprotocall__")) {
                    def _fpArgs:[EvHandle] (this.collectCallArgs(node))
                    return (EvValueBridge.taggedUndefined())
                }
                def ctorNm:string (this.builtinCtorNameOf(calleeFn))
                if ((strlen ctorNm) > 0) {
                    def ctorArgs:[EvHandle] (this.collectCallArgs(node))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    def merged2:[EvHandle]
                    def mi:int 0
                    while (mi < (calleeFn.boundArgCount())) {
                        push merged2 (calleeFn.boundArgAt(mi))
                        mi = (mi + 1)
                    }
                    def mj:int 0
                    while (mj < (array_length ctorArgs)) {
                        push merged2 (itemAt ctorArgs mj)
                        mj = (mj + 1)
                    }
                    return (this.callBuiltinCtorValues(ctorNm merged2 false))
                }
            }

            ; D-CLASSCALL: a class constructor may only be reached through
            ; `new`. The name is not bound in any scope -- it lives in the class
            ; table -- so calling one fell through to "X is not defined", which
            ; is both the wrong error and the wrong diagnosis.
            if ((this.nodeKindOf(callee)) == 1) {
                def clsCallNode:TSNode (this.classNodeByName(callee.name))
                if ((this.nodeKindOf(clsCallNode)) == 25) {
                    return (this.throwSpecError("TypeError" ("Class constructor " + callee.name + " cannot be invoked without 'new'")))
                }
            }

            ; D-ERRORS: nothing callable was found. Per spec this is a
            ; ReferenceError when the name resolves to nothing at all, and a
            ; TypeError when it resolves to a value that is not callable.
            ; Falling through to null here is what let entire test corpora pass
            ; vacuously: every call to an unimplemented global quietly did
            ; nothing and the assertion after it never ran.
            if strictReferences {
                if ((this.nodeKindOf(callee)) == 1) {
                    def cName:string callee.name
                    if (false == (this.isCallableName(cName))) {
                        if (this.nameResolves(cName)) {
                            return (this.throwSpecError("TypeError" (cName + " is not a function")))
                        }
                        return (this.throwSpecError("ReferenceError" (cName + " is not defined")))
                    }
                }
                ; A callee that is not a name or a member expression at all --
                ; `true()`, `1()`, `null()`, `new Number(1)()` -- is a TypeError
                ; too. It fell through to null, so the call did nothing.
                def litCallee:boolean false
                if ((this.nodeKindOf(callee)) == 20) { litCallee = true }
                if ((this.nodeKindOf(callee)) == 2) { litCallee = true }
                if ((this.nodeKindOf(callee)) == 8) { litCallee = true }
                if ((this.nodeKindOf(callee)) == 9) { litCallee = true }
                if ((this.nodeKindOf(callee)) == 10) { litCallee = true }
                if ((this.nodeKindOf(callee)) == 16) { litCallee = true }
                if ((this.nodeKindOf(callee)) == 15) { litCallee = true }
                if ((this.nodeKindOf(callee)) == 14) { litCallee = true }
                ; A REGEXP is not callable: `/[^a]*/()` is a TypeError. The node
                ; type was missing from this list, so the call fell through to
                ; null and did nothing at all.
                if ((this.nodeKindOf(callee)) == 21) { litCallee = true }
                ; A callee that is itself a CALL -- `String("a")()` -- has to be
                ; evaluated to know: `f()()` is legal when the inner call
                ; returns a function.
                if ((this.nodeKindOf(callee)) == 4) {
                    def innerV:EvHandle (this.evaluateExpr(callee))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    if (innerV.isFunction()) {
                        def innerArgs:[EvHandle] (this.collectCallArgs(node))
                        return (this.callFnValueWithValues(innerV innerArgs))
                    }
                    litCallee = true
                }
                if litCallee {
                    def litArgs:[EvHandle] (this.collectCallArgs(node))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    return (this.throwSpecError("TypeError" "expression is not a function"))
                }
                ; The same for `o.missing(...)`. The ARGUMENTS are evaluated
                ; first, per spec -- the callability check comes after -- so a
                ; call like `o.bar(foo())` must still run foo() before it
                ; throws. Falling through to null skipped both.
                if ((this.nodeKindOf(callee)) == 3) {
                    def missArgs:[EvHandle] (this.collectCallArgs(node))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    def missName:string callee.name
                    if ((strlen missName) == 0) {
                        missName = "expression"
                    }
                    return (this.throwSpecError("TypeError" (missName + " is not a function")))
                }
            }
        }

        return (EvValueBridge.taggedNull())
    }

    ; Whether a bare name resolves to anything at all (a binding, an engine
    ; global, or an error constructor). Used to pick ReferenceError vs TypeError.
    fn nameResolves:boolean (name:string) {
        if (context.has(name)) {
            return true
        }
        this.ensureErrorCtors()
        if (hostScope.has(name)) {
            return true
        }
        return (this.isEngineGlobalName(name))
    }

    ; Names the engine dispatches as calls without a binding (built-in globals
    ; handled earlier in evaluateCallExpr). Reaching the fallback with one of
    ; these means the engine chose not to handle that particular call, which is
    ; not the guest's error, so it stays silent.
    fn isCallableName:boolean (name:string) {
        if (this.isSizedTypeName(name)) { return true }
        if (name == "parseInt") { return true }
        if (name == "parseFloat") { return true }
        if (name == "escape") { return true }
        if (name == "unescape") { return true }
        if (name == "isNaN") { return true }
        if (name == "isFinite") { return true }
        if (name == "String") { return true }
        if (name == "Number") { return true }
        if (name == "Boolean") { return true }
        if (name == "Array") { return true }
        if (name == "Object") { return true }
        if (name == "require") { return true }
        if (name == "super") { return true }
        return false
    }
    
    fn evaluateBinaryExpr:EvHandle (node:TSNode) {
        def op:string node.value
        def opK:int (this.opKindOf(node))
        
        ; Logical operators with short-circuit evaluation
        if (opK == 34) {
            if node.left {
                def leftExpr:TSNode (unwrap node.left)
                def left:EvHandle (this.evaluateExpr(leftExpr))
                ; D-EVALORDER: a throw from the LEFT operand ends the
                ; expression. Its answer is undefined, which is falsy and
                ; nullish, so the short-circuit test fell through and ran the
                ; right operand -- whose own throw then replaced it.
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                if ((left.toBool()) == false) {
                    return left
                }
                if node.right {
                    def rightExpr:TSNode (unwrap node.right)
                    return (this.evaluateExpr(rightExpr))
                }
            }
        }
        
        if (opK == 35) {
            if node.left {
                def leftExpr:TSNode (unwrap node.left)
                def left:EvHandle (this.evaluateExpr(leftExpr))
                ; D-EVALORDER: a throw from the LEFT operand ends the
                ; expression. Its answer is undefined, which is falsy and
                ; nullish, so the short-circuit test fell through and ran the
                ; right operand -- whose own throw then replaced it.
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                if (left.toBool()) {
                    return left
                }
                if node.right {
                    def rightExpr:TSNode (unwrap node.right)
                    return (this.evaluateExpr(rightExpr))
                }
            }
        }

        if (opK == 36) {
            if node.left {
                def leftExpr:TSNode (unwrap node.left)
                def left:EvHandle (this.evaluateExpr(leftExpr))
                ; D-EVALORDER: a throw from the LEFT operand ends the
                ; expression. Its answer is undefined, which is falsy and
                ; nullish, so the short-circuit test fell through and ran the
                ; right operand -- whose own throw then replaced it.
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                ; nullish: fall through to the right only when left is null OR
                ; undefined (a missing member now reads as undefined — rule 6).
                if (false == ((left.isNull()) || (left.isUndefined()))) {
                    return left
                }
                if node.right {
                    def rightExpr:TSNode (unwrap node.right)
                    return (this.evaluateExpr(rightExpr))
                }
            }
        }
        
        ; instanceof: right side is a class NAME, not a value — compare against the
        ; instance's __class__ tag (no inheritance chain in this interpreter).
        if (opK == 44) {
            if node.left {
                def lv:EvHandle (this.evaluateExpr((unwrap node.left)))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                def cname:string ""
                if node.right {
                    def rn:TSNode (unwrap node.right)
                    cname = rn.name
                }
                ; ES2015: @@hasInstance on the RIGHT operand decides, ahead of
                ; every structural rule below. That is how a class overrides
                ; what `x instanceof C` means, and nothing consulted it.
                if node.right {
                    def hiRight:EvHandle (this.evaluateExpr((unwrap node.right)))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    if (this.isDescriptorObject(hiRight)) {
                        def hiFn:EvHandle (this.getPropertyValue(hiRight "@@hasInstance"))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                        if (hiFn.isFunction()) {
                            if (hiFn.hasFunctionNode()) {
                                def hiArgs:[EvHandle]
                                push hiArgs lv
                                def hiRes:EvHandle (this.callFnValueWithValues((hiFn.withThisForCall(hiRight)) hiArgs))
                                if scriptThrew {
                                    return (EvValueBridge.taggedUndefined())
                                }
                                return (EvValueBridge.taggedBoolean((hiRes.toBool())))
                            }
                        }
                    }
                }
                ; D-INSTANCEOF: the built-in constructors. `[] instanceof Array`,
                ; `({}) instanceof Object` and `f instanceof Function` were all
                ; false, because the check below only knows about `__class__`
                ; tags and `constructor` identity -- neither of which a literal
                ; carries. These are the shapes the suite tests with constantly.
                ; The right operand must be an object. `true instanceof true`
                ; is a TypeError, not a quiet false.
                if node.right {
                    def instRight:TSNode (unwrap node.right)
                    def irKind:string instRight.nodeType
                    def irBad:boolean false
                    if (irKind == "NumericLiteral") { irBad = true }
                    if (irKind == "StringLiteral") { irBad = true }
                    if (irKind == "BooleanLiteral") { irBad = true }
                    if (irKind == "NullLiteral") { irBad = true }
                    if irBad {
                        return (this.throwSpecError("TypeError" "Right-hand side of 'instanceof' is not callable"))
                    }
                    ; Only a FUNCTION implements [[HasInstance]], so a plain
                    ; object on the right -- `1 instanceof Math` -- is a
                    ; TypeError too. Built-in constructor NAMES are function
                    ; values now, so they pass this on their own.
                    if (irKind == "Identifier") {
                        ; A function whose `prototype` is not an object is a
                        ; TypeError as well, which the chain walk below reports
                        ; -- but only if it is reached, so a binding holding a
                        ; function is left alone here.
                        ; Only reject what is DEFINITELY not callable: a
                        ; namespace object like Math or JSON, or a binding that
                        ; holds a non-function. Anything unresolved here is left
                        ; to the checks below, which know about classes.
                        def irName:string instRight.name
                        if (this.isErrorCtorName(irName)) {
                            ; a real constructor, seeded on hostScope
                        } {
                        if (context.has(irName)) {
                            def irVal:EvHandle (context.lookup(irName))
                            if (false == (irVal.isFunction())) {
                                return (this.throwSpecError("TypeError" "Right-hand side of 'instanceof' is not callable"))
                            }
                        } {
                            if (this.isEngineGlobalName(irName)) {
                                def irG:EvHandle (this.builtinGlobalObject(irName))
                                if (false == (irG.isFunction())) {
                                    return (this.throwSpecError("TypeError" "Right-hand side of 'instanceof' is not callable"))
                                }
                            }
                        }
                        }
                    }
                    if (irKind == "ObjectExpression") {
                        return (this.throwSpecError("TypeError" "Right-hand side of 'instanceof' is not callable"))
                    }
                    if (irKind == "ThisExpression") {
                        def irThis:EvHandle (this.evaluateExpr(instRight))
                        if (false == (irThis.isFunction())) {
                            return (this.throwSpecError("TypeError" "Right-hand side of 'instanceof' is not callable"))
                        }
                    }
                }
                if (this.isBuiltinCtorName(cname)) {
                    def bRes:int (this.builtinInstanceOf(lv cname))
                    if (bRes >= 0) {
                        return (EvValueBridge.taggedBoolean((bRes == 1)))
                    }
                }
                ; A FUNCTION left-operand is object-like too, and its
                ; prototype-chain answer (including the TypeError for a
                ; non-object F.prototype) has to be reached the same way.
                def lvObjectLike:boolean (lv.isObject())
                if (lv.isFunction()) { lvObjectLike = true }
                if (lv.isArrayValue()) { lvObjectLike = true }
                ; A Map and a Set are object-like too, and were not listed here,
                ; so neither reached the prototype walk below: `new M()
                ; instanceof M` was false for `class M extends Map` even with
                ; the instance's prototype correctly set to M.prototype.
                if (lv.isMap()) { lvObjectLike = true }
                if (lv.isSet()) { lvObjectLike = true }
                ; D-PROXY: `p instanceof F` walks the PROXY's prototype chain,
                ; which means the getPrototypeOf trap (or the target's chain
                ; when the handler supplies none). protoOfValue already does
                ; that; the walk below just has to be allowed to start.
                if (this.isProxyValue(lv)) { lvObjectLike = true }
                if lvObjectLike {
                    ; The `__class__` stamp names the class the instance was
                    ; built from, so it answers YES immediately -- but a NO from
                    ; it is not an answer: `class C extends B` makes
                    ; `new C() instanceof B` true with a stamp that reads "C".
                    ; Falling through to the prototype walk is what sees that.
                    def tag:EvHandle (lv.getMember("__class__"))
                    if (tag.isString()) {
                        if ((tag.stringOf()) == cname) {
                            return (EvValueBridge.taggedBoolean(true))
                        }
                    }
                    ; D-ERRORS: every native error inherits from Error, so
                    ; `e instanceof Error` holds for a TypeError as much as
                    ; `e instanceof TypeError` does. The identity check below
                    ; compares constructors and would say false, which is the one
                    ; case where the missing inheritance chain is observable in
                    ; ordinary guest code -- `catch (e) { e instanceof Error }`
                    ; is how half the suite's negative tests confirm a throw.
                    if (lv.hasOwnData("__error__")) {
                        if (cname == "Error") {
                            return (EvValueBridge.taggedBoolean(true))
                        }
                    }
                    ; D-INSTANCEOF: the real algorithm for a user constructor --
                    ; take F.prototype and walk the value's prototype chain
                    ; looking for it BY IDENTITY. A `constructor` comparison
                    ; cannot see an object reparented with Object.create, and it
                    ; misses the spec's TypeError for a non-object prototype.
                    if node.right {
                        def rvF:EvHandle (this.evaluateExpr((unwrap node.right)))
                        if (rvF.isFunction()) {
                            def protoF:EvHandle (rvF.getMember("prototype"))
                            def protoIsObject:boolean false
                            if (protoF.isObject()) { protoIsObject = true }
                            if (protoF.isArrayValue()) { protoIsObject = true }
                            if (protoF.isFunction()) { protoIsObject = true }
                            if (false == protoIsObject) {
                                return (this.throwSpecError("TypeError" "Function has non-object prototype in instanceof"))
                            }
                            def walkV:EvHandle lv
                            ; D-PROXY: a proxy carries no proto link of its own
                            ; -- its chain is what the getPrototypeOf trap says,
                            ; or the target's when there is no trap. The raw
                            ; hasProto() below is false for one, so the walk
                            ; ended before it began. protoOfValue knows both
                            ; cases; from its answer the ordinary chain follows.
                            if (this.isProxyValue(lv)) {
                                walkV = (this.protoOfValue(lv))
                                if scriptThrew {
                                    return (EvValueBridge.taggedUndefined())
                                }
                                if (walkV.equals(protoF)) {
                                    return (EvValueBridge.taggedBoolean(true))
                                }
                            }
                            def steps:int 0
                            while (steps < 32) {
                                if (false == (walkV.hasProto())) {
                                    steps = 32
                                } {
                                    walkV = (walkV.protoOf())
                                    if (walkV.equals(protoF)) {
                                        return (EvValueBridge.taggedBoolean(true))
                                    }
                                    steps = (steps + 1)
                                }
                            }
                        }
                    }
                    ; D-ERRORS: an object built by `new F()` — an error object or
                    ; any constructor-function instance — carries `constructor`.
                    ; Compare it against the right-hand value BY IDENTITY, which
                    ; is what makes the standard guard
                    ;   if (!(this instanceof F)) return new F(...)
                    ; terminate instead of recursing forever.
                    def ctorHere:EvHandle (lv.getMember("constructor"))
                    if (ctorHere.isFunction()) {
                        if node.right {
                            def rv:EvHandle (this.evaluateExpr((unwrap node.right)))
                            if (rv.isFunction()) {
                                return (EvValueBridge.taggedBoolean((ctorHere.equals(rv))))
                            }
                        }
                        if ((strlen cname) > 0) {
                            return (EvValueBridge.taggedBoolean((((ctorHere.fnName())) == cname)))
                        }
                    }
                }
            }
            return (EvValueBridge.taggedBoolean(false))
        }

        ; Evaluate both sides for other operators. Binary expressions always have
        ; both operands; evaluate them directly instead of seeding two throwaway
        ; null EvalValues (which used to be the single largest source of interpreter
        ; heap allocations).
        if (null? node.left) {
            return (EvValueBridge.taggedNull())
        }
        if (null? node.right) {
            return (EvValueBridge.taggedNull())
        }
        ; A non-logical binary operator READS both operands and builds its own
        ; result; it never hands an operand object on. So an operand may come
        ; out of an expression slot, and `f(i * 2 + 1)` pays for the escaping
        ; sum alone rather than for the product as well. The short-circuiting
        ; operators are the exception -- `a || b` answers WITH an operand -- and
        ; they returned above, before this point.
        def lNode:TSNode (unwrap node.left)
        def rNode:TSNode (unwrap node.right)
        def left:EvHandle (EvValueBridge.taggedNull())
        def right:EvHandle (EvValueBridge.taggedNull())
        if ((this.nodeKindOf(lNode)) == 5) {
            left = (this.evaluateExprTransient(lNode))
        } {
            left = (this.evaluateExpr(lNode))
        }
        ; D-EVALORDER: the LEFT operand is evaluated first, and an exception
        ; from it ends the expression. Running the right one anyway let its
        ; throw replace the left's -- `x() + y()`, both throwing, reported "y"
        ; where every reading of the grammar says "x".
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        if ((this.nodeKindOf(rNode)) == 5) {
            right = (this.evaluateExprTransient(rNode))
        } {
            right = (this.evaluateExpr(rNode))
        }

        ; `key in obj` / `index in array` — property/element presence test.
        if (opK == 43) {
            ; The right operand must be an OBJECT. A primitive is a TypeError,
            ; not a quiet false -- and a FUNCTION is an object, which is what
            ; makes `"MAX_VALUE" in Number` true now that the built-in
            ; constructors are function values.
            def inKey:string (this.toPropertyKey(left))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            def inHolds:boolean false
            if (right.isArrayValue()) { inHolds = true }
            if (right.isObject()) { inHolds = true }
            if (right.isFunction()) { inHolds = true }
            if (right.isMap()) { inHolds = true }
            if (right.isSet()) { inHolds = true }
            if (false == inHolds) {
                return (this.throwSpecError("TypeError" "Cannot use 'in' operator on a non-object"))
            }
            ; D-PROXY: `k in p` is the `has` trap.
            if (this.isProxyValue(right)) {
                return (EvValueBridge.taggedBoolean((this.objHasKeyUpChain(right inKey))))
            }
            if (this.objHasKey(right inKey)) {
                return (EvValueBridge.taggedBoolean(true))
            }
            ; `in` walks the PROTOTYPE CHAIN -- it is not hasOwnProperty.
            def inWalk:EvHandle right
            def inDepth:int 0
            while (inDepth < 16) {
                if (false == (inWalk.hasProto())) {
                    return (EvValueBridge.taggedBoolean(false))
                }
                inWalk = (inWalk.protoOf())
                if (this.objHasKey(inWalk inKey)) {
                    return (EvValueBridge.taggedBoolean(true))
                }
                inDepth = (inDepth + 1)
            }
            return (EvValueBridge.taggedBoolean(false))
        }
        
        return (this.applyBinaryOp(opK left right))
    }

    ; The VALUE-level operator table: arithmetic, bitwise, shifts,
    ; relational and equality on two already-evaluated operands. One
    ; implementation serves the tree-walker (evaluateBinaryExpr) and the
    ; bytecode VM, so the semantics cannot fork.
    ; Exact ToInt32 wrap for a raw int64 result: JS bitwise results are
    ; SIGNED 32-bit however wide the target's int is. On es6 the generated
    ; `&` is already 32-bit so this is an identity; on C++/Rust it folds
    ; the high bits away.
    ; Done in the double domain (same as toInt32Of) so targets whose int is
    ; signed 32-bit — Kotlin, Java, C# — can compile it: the old form used
    ; integer literals above Int.MAX_VALUE, which those languages reject.
    fn int32Wrap:int (n:int) {
        def t:double (to_double n)
        def m:double (this.wrapUint32(t))
        def half:double 2147483648.0
        if (m >= half) {
            m = (m - (half * 2.0))
        }
        return (to_int m)
    }

    ; JS `>>>` computed in the DOUBLE domain. ToUint32(left) lives in
    ; [0, 2^32) and need not fit a SIGNED 32-bit int -- `-1 >>> 0` is
    ; 4294967295 -- and Ranger's int IS 32 bits on the C++ target, where an
    ; int-typed mask both narrows the mask away again and cannot hold the
    ; result. The uint32 pattern as an exact double, divided by 2^count and
    ; floored, is exact IEEE arithmetic on every target.
    fn ushr32Of:EvHandle (left:EvHandle right:EvHandle) {
        def d:double (this.toNumberOf(left))
        def t:double 0.0
        if (d == d) {
            if (this.isFiniteNum(d)) {
                t = (this.floorNum(d))
                if (d < 0.0) {
                    t = (0.0 - (this.floorNum((0.0 - d))))
                }
            }
        }
        def u:double (this.wrapUint32(t))
        def cnt:int (bit_and (this.toInt32Of(right)) 31)
        def div:double (this.powNum(2.0 cnt))
        return (EvValueBridge.taggedNumber((this.floorNum((u / div)))))
    }

    ; D-BIGINT: every operator that either operand being a BigInt changes.
    ; Answers null when neither side is one, which is what lets the ordinary
    ; paths below stay exactly as they were.
    ;
    ; The rule the whole thing turns on: BigInt does NOT mix with Number in
    ; arithmetic. `1n + 1` is a TypeError, deliberately -- an implicit
    ; conversion either loses precision or loses the fraction, and the language
    ; refuses to pick. Comparison DOES mix, because comparing is lossless.
    fn bigIntBinaryOp:EvHandle (opK:int left:EvHandle right:EvHandle) {
        def lBig:boolean (this.isBigIntValue(left))
        def rBig:boolean (this.isBigIntValue(right))
        if ((false == lBig) && (false == rBig)) {
            return (EvValueBridge.taggedNull())
        }
        ; `+` with a string on either side is CONCATENATION, and reaches here
        ; only so the BigInt renders as its digits.
        if (opK == 20) {
            def lp0:EvHandle (this.toPrimitiveDefault(left))
            def rp0:EvHandle (this.toPrimitiveDefault(right))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            if ((lp0.isString()) || (rp0.isString())) {
                return (EvValueBridge.taggedString((this.toStringOf(lp0)) + (this.toStringOf(rp0))))
            }
        }
        ; Equality and relational comparison mix with Number; everything else
        ; requires both sides to be BigInt.
        def isCompare:boolean false
        if ((opK == 26) || ((opK == 27) || ((opK == 28) || (opK == 29)))) { isCompare = true }
        def isEquality:boolean false
        if ((opK == 30) || ((opK == 31) || ((opK == 32) || (opK == 33)))) { isEquality = true }
        if (isEquality) {
            ; `===` is only ever true between two BigInts; `==` compares across
            ; to a Number or a String by VALUE.
            def strict:boolean ((opK == 32) || (opK == 33))
            def same:boolean false
            if (lBig && rBig) {
                def eqL:BigNum (this.bigNumOf(left))
                def eqR:BigNum (this.bigNumOf(right))
                same = ((eqL.cmp(eqR)) == 0)
            } {
                if (false == strict) {
                    def otherV:EvHandle right
                    def bigV:EvHandle left
                    if (false == lBig) {
                        otherV = left
                        bigV = right
                    }
                    def op:EvHandle (this.toPrimitiveDefault(otherV))
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                    if (op.isString()) {
                        def sOk:[boolean]
                        push sOk false
                        def sBig:BigNum (BigNum.parse((op.stringOf()) sOk))
                        if (itemAt sOk 0) {
                            def eqB:BigNum (this.bigNumOf(bigV))
                            same = ((eqB.cmp(sBig)) == 0)
                        }
                    } {
                        if ((op.isNumber()) || (op.isBoolean())) {
                            def d:double (this.toNumberOf(op))
                            ; A non-integer or a NaN is equal to no BigInt at
                            ; all, which is why the comparison is on the value
                            ; and not on a rounded one.
                            if (d == d) {
                                if (this.isFiniteNum(d)) {
                                    if (d == (this.truncNum(d))) {
                                        def eqB2:BigNum (this.bigNumOf(bigV))
                                        def eqD:BigNum (BigNum.fromDouble(d))
                                        same = ((eqB2.cmp(eqD)) == 0)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if ((opK == 31) || (opK == 33)) {
                return (EvValueBridge.taggedBoolean((false == same)))
            }
            return (EvValueBridge.taggedBoolean(same))
        }
        if (isCompare) {
            def cmpR:int 0
            def known:boolean false
            if (lBig && rBig) {
                def cmpL:BigNum (this.bigNumOf(left))
                def cmpRr:BigNum (this.bigNumOf(right))
                cmpR = (cmpL.cmp(cmpRr))
                known = true
            } {
                ; Mixed: compare against the number as a real value. An integer
                ; number compares exactly; a fractional one decides the tie by
                ; its fraction, which is what comparing the truncations then the
                ; remainder amounts to.
                def numSide:EvHandle right
                def bigSide:EvHandle left
                if (false == lBig) {
                    numSide = left
                    bigSide = right
                }
                def op2:EvHandle (this.toPrimitive(numSide false))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                def dv:double (this.toNumberOf(op2))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                if (dv != dv) {
                    ; Any NaN makes every relational comparison false.
                    return (EvValueBridge.taggedBoolean(false))
                }
                def bigCmp:int 0
                if (false == (this.isFiniteNum(dv))) {
                    if (dv > 0.0) { bigCmp = (0 - 1) } { bigCmp = 1 }
                } {
                    def trunc:double (this.truncNum(dv))
                    def cmpB:BigNum (this.bigNumOf(bigSide))
                    def cmpD:BigNum (BigNum.fromDouble(trunc))
                    bigCmp = (cmpB.cmp(cmpD))
                    if (bigCmp == 0) {
                        ; Equal against the truncation: the fraction breaks the
                        ; tie, so 1n < 1.5 and 2n > 1.5.
                        if (dv > trunc) { bigCmp = (0 - 1) }
                        if (dv < trunc) { bigCmp = 1 }
                    }
                }
                cmpR = bigCmp
                if (false == lBig) { cmpR = (0 - cmpR) }
                known = true
            }
            if known {
                if (opK == 26) { return (EvValueBridge.taggedBoolean((cmpR < 0))) }
                if (opK == 27) { return (EvValueBridge.taggedBoolean((cmpR > 0))) }
                if (opK == 28) { return (EvValueBridge.taggedBoolean((cmpR <= 0))) }
                return (EvValueBridge.taggedBoolean((cmpR >= 0)))
            }
        }
        ; §6.1.6.2: everything else needs two BigInts.
        if ((false == lBig) || (false == rBig)) {
            return (this.throwSpecError("TypeError" "Cannot mix BigInt and other types, use explicit conversions"))
        }
        def a:BigNum (this.bigNumOf(left))
        def b:BigNum (this.bigNumOf(right))
        if (opK == 20) { return (this.makeBigIntValue((a.add(b)))) }
        if (opK == 21) { return (this.makeBigIntValue((a.sub(b)))) }
        if (opK == 22) { return (this.makeBigIntValue((a.mul(b)))) }
        if (opK == 23) {
            if (b.isZero()) {
                return (this.throwSpecError("RangeError" "Division by zero"))
            }
            return (this.makeBigIntValue((a.div(b))))
        }
        if (opK == 24) {
            if (b.isZero()) {
                return (this.throwSpecError("RangeError" "Division by zero"))
            }
            return (this.makeBigIntValue((a.rem(b))))
        }
        if (opK == 25) {
            if (b.neg) {
                return (this.throwSpecError("RangeError" "Exponent must be non-negative"))
            }
            return (this.makeBigIntValue((a.pow(b))))
        }
        if (opK == 37) { return (this.makeBigIntValue((a.bitwise(b 0)))) }
        if (opK == 38) { return (this.makeBigIntValue((a.bitwise(b 1)))) }
        if (opK == 39) { return (this.makeBigIntValue((a.bitwise(b 2)))) }
        if ((opK == 40) || (opK == 41)) {
            ; A shift by a huge count is not something to allocate for: past a
            ; few thousand bits the answer is 0 or -1 either way.
            def shiftBy:BigNum b
            def leftShift:boolean (opK == 40)
            if (shiftBy.neg) {
                leftShift = (false == leftShift)
                shiftBy = (shiftBy.negate())
            }
            if ((shiftBy.bitLength()) > 24) {
                if leftShift {
                    return (this.throwSpecError("RangeError" "BigInt is too large"))
                }
                if (a.neg) { return (this.bigFromIntValue((0 - 1))) }
                return (this.bigFromIntValue(0))
            }
            def k:int (to_int (shiftBy.toDouble()))
            if leftShift {
                return (this.makeBigIntValue((a.shiftLeft(k))))
            }
            return (this.makeBigIntValue((a.shiftRight(k))))
        }
        if (opK == 42) {
            ; §6.1.6.2.11: there is no unsigned right shift for BigInt -- a
            ; BigInt has no width for the sign bit to move out of.
            return (this.throwSpecError("TypeError" "BigInts have no unsigned right shift, use >> instead"))
        }
        return (EvValueBridge.taggedNull())
    }

    fn applyBinaryOp:EvHandle (opK:int left:EvHandle right:EvHandle) {
        ; D-BIGINT: a BigInt on either side changes what almost every operator
        ; means, so it is decided first. The check is two slot probes on values
        ; that are already objects, and every fast path below is untouched.
        if (left.isObject()) {
            def bigL:EvHandle (this.bigIntBinaryOp(opK left right))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            if (false == (bigL.isNull())) { return bigL }
        }
        if (right.isObject()) {
            def bigR:EvHandle (this.bigIntBinaryOp(opK left right))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            if (false == (bigR.isNull())) { return bigR }
        }
        ; Arithmetic
        if (opK == 20) {
            ; PERF fast path: two plain strings concatenate directly. The
            ; toPrimitive/toString dance below is a no-op for them, but on
            ; the native targets each toStringOf COPIES its operand first.
            if ((left.isString()) && (right.isString())) {
                return (EvValueBridge.taggedString((left.stringOf()) + (right.stringOf())))
            }
            ; two plain numbers add directly the same way
            if ((left.isNumber()) && (right.isNumber())) {
                return (EvValueBridge.taggedNumber(left.numberValue + right.numberValue))
            }
            ; D-TOPRIMITIVE: both operands convert FIRST, and only then does the
            ; string-vs-numeric decision get made -- an object with a valueOf
            ; returning a number must add, not concatenate.
            def lp:EvHandle (this.toPrimitiveDefault(left))
            def rp:EvHandle (this.toPrimitiveDefault(right))
            if ((lp.isString()) || (rp.isString())) {
                return (EvValueBridge.taggedString((this.toStringOf(lp)) + (this.toStringOf(rp))))
            }
            return (EvValueBridge.taggedNumber((this.toNumberOf(lp)) + (this.toNumberOf(rp))))
        }
        if (opK == 21) {
            return (EvValueBridge.taggedNumber((this.toNumberOf(left)) - (this.toNumberOf(right))))
        }
        if (opK == 22) {
            return (EvValueBridge.taggedNumber((this.toNumberOf(left)) * (this.toNumberOf(right))))
        }
        ; D-IEEE: division by zero is Infinity / -Infinity / NaN, not 0. The old
        ; guard returned 0, which is wrong arithmetic AND breaks the standard
        ; idiom for telling +0 from -0 (`1/a === 1/b`) — with both sides folding
        ; to 0 the two zeroes became indistinguishable.
        if (opK == 23) {
            ; ToNumber, not the raw value: a boxed number or an object with a
            ; valueOf has to convert, and reading numberValue off one gave 0.
            ; The LEFT operand converts first, so when both conversions throw it
            ; is the left one's exception that escapes.
            def leftNum:double (this.toNumberOf(left))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            def rightNum:double (this.toNumberOf(right))
            if (rightNum == 0.0) {
                ; `left * (1/right)` gets all three cases right at once, and
                ; crucially respects the SIGN of the zero divisor: 1/-0 is
                ; -Infinity, not Infinity. Branching on left's sign alone would
                ; miss that, because -0 == 0 compares true.
                def recip:double (1.0 / rightNum)
                return (EvValueBridge.taggedNumber((leftNum * recip)))
            }
            return (EvValueBridge.taggedNumber((leftNum / rightNum)))
        }
        if (opK == 24) {
            ; The remainder is a FLOATING-POINT one: 5.5 % 2 is 1.5. Truncating
            ; both operands to int threw the fraction away, and the sign follows
            ; the dividend.
            def leftMod:double (this.toNumberOf(left))
            def rightMod:double (this.toNumberOf(right))
            if (rightMod == 0.0) {
                ; x % 0 is NaN, not 0.
                return (EvValueBridge.taggedNumber((0.0 / 0.0)))
            }
            if (leftMod != leftMod) { return (EvValueBridge.taggedNumber(leftMod)) }
            if (rightMod != rightMod) { return (EvValueBridge.taggedNumber(rightMod)) }
            if (false == (this.isFiniteNum(leftMod))) {
                return (EvValueBridge.taggedNumber((0.0 / 0.0)))
            }
            if (false == (this.isFiniteNum(rightMod))) {
                return (EvValueBridge.taggedNumber(leftMod))
            }
            return (this.evaluateRemainder(leftMod rightMod))
        }

        ; Bitwise (JS coerces operands to int32; common idiom "x | 0" truncates to int)
        if (opK == 38) {
            def leftInt:int (this.toInt32Of(left))
            def rightInt:int (this.toInt32Of(right))
            return (EvHandle.fromInt((bit_or leftInt rightInt)))
        }
        if (opK == 37) {
            def leftInt:int (this.toInt32Of(left))
            def rightInt:int (this.toInt32Of(right))
            return (EvHandle.fromInt((bit_and leftInt rightInt)))
        }
        if (opK == 39) {
            def leftInt:int (this.toInt32Of(left))
            def rightInt:int (this.toInt32Of(right))
            return (EvHandle.fromInt((bit_xor leftInt rightInt)))
        }
        ; Shifts (JS coerces to int32; shift count masked to low 5 bits). Common in
        ; AssemblyScript fixed-point / bit-packing code.
        if (opK == 40) {
            def leftInt:int (this.toInt32Of(left))
            def cnt:int (bit_and (this.toInt32Of(right)) 31)
            return (EvHandle.fromInt((this.int32Wrap((bit_shl leftInt cnt)))))
        }
        if (opK == 41) {
            def leftInt:int (this.toInt32Of(left))
            def cnt:int (bit_and (this.toInt32Of(right)) 31)
            return (EvHandle.fromInt((bit_shr leftInt cnt)))
        }
        if (opK == 42) {
            return (this.ushr32Of(left right))
        }
        ; Exponentiation (a ** b), full Number::exponentiate. This used to
        ; truncate the exponent to an int32, so `2 ** 0.5` was 1.
        if (opK == 25) {
            return (EvValueBridge.taggedNumber((this.jsPow((left.toNumber()) (this.toNumberOf(right))))))
        }

        ; Comparison
        ; D-TOPRIMITIVE: the relational operators compare STRINGS when both
        ; operands convert to strings, and numbers otherwise. Comparing
        ; "10" < "9" numerically is wrong; lexicographic is correct.
        if ((opK == 26) || (opK == 27) || (opK == 28) || (opK == 29)) {
            def lr:EvHandle (this.toPrimitive(left false))
            def rr:EvHandle (this.toPrimitive(right false))
            if ((lr.isString()) && (rr.isString())) {
                def ls:string (lr.stringOf())
                def rs:string (rr.stringOf())
                def cmp:int (this.compareStrings(ls rs))
                if (opK == 26) { return (EvValueBridge.taggedBoolean((cmp < 0))) }
                if (opK == 27) { return (EvValueBridge.taggedBoolean((cmp > 0))) }
                if (opK == 28) { return (EvValueBridge.taggedBoolean((cmp <= 0))) }
                return (EvValueBridge.taggedBoolean((cmp >= 0)))
            }
            def ln2:double (this.toNumberOf(lr))
            def rn2:double (this.toNumberOf(rr))
            ; Any NaN makes every relational comparison false.
            if (ln2 != ln2) { return (EvValueBridge.taggedBoolean(false)) }
            if (rn2 != rn2) { return (EvValueBridge.taggedBoolean(false)) }
            if (opK == 26) { return (EvValueBridge.taggedBoolean((ln2 < rn2))) }
            if (opK == 27) { return (EvValueBridge.taggedBoolean((ln2 > rn2))) }
            if (opK == 28) { return (EvValueBridge.taggedBoolean((ln2 <= rn2))) }
            return (EvValueBridge.taggedBoolean((ln2 >= rn2)))
        }
        
        ; Equality. `===`/`!==` are strict (EvHandle.equals — value for
        ; primitives, reference identity for objects). `==`/`!=` are loose: the
        ; ONLY JS coercion this engine models is `null == undefined` (both are
        ; nullish), which matters now that a missing member reads as `undefined`
        ; (D-IDENTITY rule 6) — the guest idiom `x != null` must still hold.
        if (opK == 32) {
            return (EvValueBridge.taggedBoolean((left.equals(right))))
        }
        if (opK == 33) {
            return (EvValueBridge.taggedBoolean(((left.equals(right)) == false)))
        }
        if (opK == 30) {
            return (EvValueBridge.taggedBoolean((this.looseEquals(left right))))
        }
        if (opK == 31) {
            return (EvValueBridge.taggedBoolean(((this.looseEquals(left right)) == false)))
        }
        
        return (EvValueBridge.taggedNull())
    }

    ; JS loose equality (`==`/`!=`) restricted to the one coercion this engine
    ; models: `null == undefined` (and each equals itself). A nullish value is
    ; never loosely equal to a non-nullish one; every other pair defers to strict
    ; EvHandle.equals (no numeric/string cross-type coercion). This keeps the
    ; universal guest idiom `x != null` meaning "neither null nor undefined" now
    ; that a missing member reads as undefined (D-IDENTITY rule 6).
    ; D-LOOSEEQ: abstract equality. Previously `==` was `===` plus a
    ; null/undefined special case, so `1 == '1'`, `true == 1` and
    ; `[1] == 1` were all false -- the comparisons `==` exists to make.
    fn looseEquals:boolean (left:EvHandle right:EvHandle) {
        def ln:boolean ((left.isNull()) || (left.isUndefined()))
        def rn:boolean ((right.isNull()) || (right.isUndefined()))
        ; null and undefined equal each other and nothing else.
        if (ln || rn) {
            return (ln && rn)
        }
        ; A FUNCTION, a Map and a Set are object-like too. Leaving them out made
        ; both branches below miss, so `f == f` fell through to the numeric
        ; comparison and answered false for a value that is identical to itself.
        def lIsObj:boolean (this.isDescriptorObject(left))
        def rIsObj:boolean (this.isDescriptorObject(right))
        ; Two objects compare by reference, never by content.
        if (lIsObj && rIsObj) {
            return (left.equals(right))
        }
        ; One object: convert it to a primitive and retry.
        if lIsObj {
            def lp:EvHandle (this.toPrimitiveDefault(left))
            return (this.looseEquals(lp right))
        }
        if rIsObj {
            def rp:EvHandle (this.toPrimitiveDefault(right))
            return (this.looseEquals(left rp))
        }
        ; Same primitive type: strict comparison.
        if ((left.isString()) && (right.isString())) {
            return (left.equals(right))
        }
        if ((left.isNumber()) && (right.isNumber())) {
            return (left.equals(right))
        }
        if ((left.isBoolean()) && (right.isBoolean())) {
            return (left.equals(right))
        }
        ; Mixed primitives compare numerically, which is what makes
        ; 1 == '1' and true == 1 hold.
        def lnum:double (this.toNumberOf(left))
        def rnum:double (this.toNumberOf(right))
        if (lnum != lnum) { return false }
        if (rnum != rnum) { return false }
        return (lnum == rnum)
    }

    fn bindingExists:boolean (name:string) {
        return (context.has(name))
    }

    ; ==========================================================================
    ; D-ERRORS: spec error objects, and throwing where the spec throws.
    ; --------------------------------------------------------------------------
    ; A thrown error has to be catchable AND identifiable. Test262's assert.throws
    ; compares `thrown.constructor` against the global constructor BY IDENTITY and
    ; reads `.name` off it, so the constructors are seeded once per engine as
    ; singleton function values on hostScope and every error object points back at
    ; that same value. Creating a fresh constructor per throw would silently fail
    ; that identity check.
    ; --------------------------------------------------------------------------
    ; D-BUILTINPROTO: members of the engine's built-in constructor namespaces
    ; that are VALUES rather than calls. Returns null (valueType 0) when the
    ; name/property pair is not one of them, so the caller falls through.
    fn builtinNamespaceMember:EvHandle (nsName:string propName:string) {
        if (this.isBuiltinCtorName(nsName)) {
            if (propName == "prototype") {
                return (this.builtinPrototype(nsName))
            }
            if (propName == "name") {
                return (EvValueBridge.taggedString(nsName))
            }
        }
        if (nsName == "Number") {
            if (propName == "POSITIVE_INFINITY") { return (EvValueBridge.taggedNumber((1.0 / 0.0))) }
            if (propName == "NEGATIVE_INFINITY") { return (EvValueBridge.taggedNumber((0.0 - (1.0 / 0.0)))) }
            if (propName == "MAX_SAFE_INTEGER") { return (EvValueBridge.taggedNumber(9007199254740991.0)) }
            if (propName == "MIN_SAFE_INTEGER") { return (EvValueBridge.taggedNumber((0.0 - 9007199254740991.0))) }
            if (propName == "EPSILON") { return (EvValueBridge.taggedNumber(0.0000000000000002220446049250313)) }
            ; MAX_VALUE / MIN_VALUE come from string parsing rather than from a
            ; source literal: neither extreme survives the Ranger lexer, but the
            ; runtime's string-to-double conversion reproduces the exact bit
            ; pattern, which is what these tests actually check.
            if (propName == "MAX_VALUE") {
                def mx@(optional):double (to_double "1.7976931348623157e308")
                if mx {
                    return (EvValueBridge.taggedNumber((unwrap mx)))
                }
            }
            if (propName == "MIN_VALUE") {
                def mn@(optional):double (to_double "5e-324")
                if mn {
                    return (EvValueBridge.taggedNumber((unwrap mn)))
                }
            }
        }
        return (EvValueBridge.taggedNull())
    }

    ; D-INSTANCEOF: `v instanceof <BuiltinCtor>`. Answers 1 for yes, 0 for no,
    ; and -1 for "this constructor has nothing to say about that value", which
    ; leaves the caller's `__class__` / constructor-identity checks in charge.
    ;
    ; A primitive is never an instance of anything, which is why the wrapper
    ; constructors answer 0 for their own primitive: `'a' instanceof String` is
    ; false while `new String('a') instanceof String` is true.
    fn builtinInstanceOf:int (v:EvHandle cname:string) {
        if ((v.isNull()) || (v.isUndefined())) {
            return 0
        }
        def isObjectLike:boolean false
        if (v.isArrayValue()) { isObjectLike = true }
        if (v.isObject()) { isObjectLike = true }
        if (v.isFunction()) { isObjectLike = true }
        if (v.isMap()) { isObjectLike = true }
        if (v.isSet()) { isObjectLike = true }
        if (false == isObjectLike) {
            return 0
        }
        if (cname == "Object") {
            return 1
        }
        if (cname == "Function") {
            if (v.isFunction()) { return 1 }
            return 0
        }
        if (cname == "Array") {
            if (v.isArrayValue()) { return 1 }
            if ((this.protoChainKind(v)) == "array") { return 1 }
            return 0
        }
        if (cname == "Map") {
            if (v.isMap()) { return 1 }
            return 0
        }
        if (cname == "Set") {
            if (v.isSet()) { return 1 }
            return 0
        }
        if (this.isWrapperCtorName(cname)) {
            if (v.isObject()) {
                if (v.hasOwnData("__wrapper__")) {
                    return (this.boolAsInt(((this.objectClassOf(v)) == cname)))
                }
            }
            return 0
        }
        return (0 - 1)
    }

    fn boolAsInt:int (b:boolean) {
        if b { return 1 }
        return 0
    }

    ; ---- Typed arrays ----
    ;
    ; A typed array is backed by the ordinary array machinery and BRANDED with
    ; its element type, so every write goes through that type's coercion. The
    ; brand is what makes `new Int8Array([300])[0]` be 44 rather than 300 --
    ; without it a "typed" array would be an ordinary one wearing a name, which
    ; is worse than not having them at all.
    fn isTypedArrayCtorName:boolean (name:string) {
        if (name == "Int8Array") { return true }
        if (name == "Uint8Array") { return true }
        if (name == "Uint8ClampedArray") { return true }
        if (name == "Int16Array") { return true }
        if (name == "Uint16Array") { return true }
        if (name == "Int32Array") { return true }
        if (name == "Uint32Array") { return true }
        if (name == "Float32Array") { return true }
        if (name == "Float64Array") { return true }
        if (name == "BigInt64Array") { return true }
        if (name == "BigUint64Array") { return true }
        return false
    }

    fn typedArrayBrandOf:string (v:EvHandle) {
        if (false == (v.isArrayValue())) { return "" }
        def b:EvHandle (v.getMember("__tabrand__"))
        if (b.isString()) { return (b.stringOf()) }
        return ""
    }

    fn isTypedArrayValue:boolean (v:EvHandle) {
        return ((strlen (this.typedArrayBrandOf(v))) > 0)
    }

    ; The element a typed array of this kind actually stores for a given
    ; number: ToInteger then wrap into the type's width, with the two float
    ; kinds and the clamped byte handled by their own rules.
    fn typedArrayCoerce:double (kind:string n:double) {
        if (kind == "Float64Array") { return n }
        if (kind == "Float32Array") { return (this.toFloat32(n)) }
        if (kind == "Uint8ClampedArray") {
            ; §7.1.11 ToUint8Clamp: NaN is 0, out of range saturates, and an
            ; exact .5 rounds to EVEN.
            if (n != n) { return 0.0 }
            if (n <= 0.0) { return 0.0 }
            if (n >= 255.0) { return 255.0 }
            def fl:double (this.floorNum(n))
            def diff:double (n - fl)
            if (diff > 0.5) { return (fl + 1.0) }
            if (diff < 0.5) { return fl }
            def half:double (fl / 2.0)
            if ((half - (this.floorNum(half))) != 0.0) { return (fl + 1.0) }
            return fl
        }
        ; The integer kinds all go through ToInteger and then a modulo of
        ; their width; the signed ones fold the top half down.
        if (n != n) { return 0.0 }
        if (false == (this.isFiniteNum(n))) { return 0.0 }
        def t:double (this.truncNum(n))
        def width:double 256.0
        def signed:boolean false
        if (kind == "Int8Array") { signed = true }
        if (kind == "Uint8Array") { width = 256.0 }
        if (kind == "Int16Array") { width = 65536.0
            signed = true }
        if (kind == "Uint16Array") { width = 65536.0 }
        if (kind == "Int32Array") { width = 4294967296.0
            signed = true }
        if (kind == "Uint32Array") { width = 4294967296.0 }
        def m:double (t - (width * (this.floorNum((t / width)))))
        if signed {
            def halfW:double (width / 2.0)
            if (m >= halfW) { m = (m - width) }
        }
        return m
    }

    ; `new Int8Array(n)` / `new Int8Array([...])` / `new Int8Array(typedArray)`.
    ; ---- §24.1 ArrayBuffer, §24.2 DataView --------------------------------
    ; D-ARRAYBUFFER: neither existed at all, so every fixture that mentions one
    ; -- including the whole %TypedArray% harness, which loads
    ; `ArrayBuffer.prototype.resize` before it does anything else -- died on
    ; "ArrayBuffer is not defined" for a reason unrelated to what it tested.
    ; The bytes live in an ordinary array of numbers under `__abbytes__`; this
    ; realm has no linear memory to model, and every operation the spec defines
    ; over the block is expressible as element reads and writes.
    ; Floating-point remainder in the double domain. Ranger's `%` is integer.
    fn modNum:double (a:double b:double) {
        if (b == 0.0) { return (0.0 / 0.0) }
        def q:double (this.truncNum((a / b)))
        return (a - (q * b))
    }

    ; ---- IEEE 754 by arithmetic ------------------------------------------
    ; D-ARRAYBUFFER: DataView's float accessors need the BITS of a double, and
    ; nothing in this realm hands them over -- so they are computed. The
    ; exponent is found by scaling into [1, 2), the mantissa by the fractional
    ; part that leaves; the reverse builds the value back the same way. Written
    ; once for both widths, parameterised on the exponent size and bias.
    ; D-ARRAYBUFFER: a float's BYTES, computed rather than reinterpreted --
    ; nothing in this realm hands over the bit pattern of a double. Done byte by
    ; byte on purpose: a float64 pattern is 64 bits, which does NOT fit exactly
    ; in a double, so assembling it as one integer loses the low bits (a
    ; round-tripped 3.14159 came back as 3.1415900000001784). The mantissa
    ; stays under 2^52 throughout, where every value is exact.
    fn floatParts:[double] (v:double expBits:int mantBits:int) {
        def halfSpan:int (this.toIntPow2((expBits - 1)))
        def bias:int (halfSpan - 1)
        def maxBiased:int ((bias * 2) + 1)
        def mantScale:double (this.powNum(2.0 mantBits))
        def out:[double]
        def sign:double 0.0
        def a:double v
        if (v != v) {
            ; The canonical quiet NaN: exponent all ones, top mantissa bit set.
            push out 0.0
            push out (to_double maxBiased)
            push out (mantScale / 2.0)
            return out
        }
        if (v < 0.0) {
            sign = 1.0
            a = (0.0 - v)
        }
        if (v == 0.0) {
            if ((1.0 / v) < 0.0) { sign = 1.0 }
            push out sign
            push out 0.0
            push out 0.0
            return out
        }
        if (false == (this.isFiniteNum(a))) {
            push out sign
            push out (to_double maxBiased)
            push out 0.0
            return out
        }
        def e:int 0
        while (a >= 2.0) {
            a = (a / 2.0)
            e = (e + 1)
        }
        while (a < 1.0) {
            a = (a * 2.0)
            e = (e - 1)
        }
        def biased:int (e + bias)
        def mant:double 0.0
        if (biased <= 0) {
            def shift:int (1 - biased)
            def sub:double a
            def si:int 0
            while (si < shift) {
                sub = (sub / 2.0)
                si = (si + 1)
            }
            biased = 0
            mant = (this.roundHalfEven((sub * mantScale)))
        } {
            if (biased >= maxBiased) {
                biased = maxBiased
                mant = 0.0
            } {
                mant = (this.roundHalfEven(((a - 1.0) * mantScale)))
                ; Rounding the mantissa can carry it past the field.
                if (mant >= mantScale) {
                    mant = 0.0
                    biased = (biased + 1)
                }
            }
        }
        push out sign
        push out (to_double biased)
        push out mant
        return out
    }

    fn roundHalfEven:double (x:double) {
        def f:double (this.floorNum(x))
        def r:double (x - f)
        if (r > 0.5) { return (f + 1.0) }
        if (r < 0.5) { return f }
        ; Exactly halfway: to even.
        if ((this.modNum(f 2.0)) == 0.0) { return f }
        return (f + 1.0)
    }

    fn valueFromParts:double (sign:double biased:double mant:double expBits:int mantBits:int) {
        def halfSpan:int (this.toIntPow2((expBits - 1)))
        def bias:int (halfSpan - 1)
        def maxBiased:int ((bias * 2) + 1)
        def mantScale:double (this.powNum(2.0 mantBits))
        def s:double 1.0
        if (sign != 0.0) { s = (0.0 - 1.0) }
        def b:int (to_int biased)
        if (b == maxBiased) {
            if (mant == 0.0) {
                return (s * (1.0 / 0.0))
            }
            return (0.0 / 0.0)
        }
        if (b == 0) {
            if (mant == 0.0) {
                return (s * 0.0)
            }
            return (s * ((mant / mantScale) * (this.powNum2(2.0 (1 - bias)))))
        }
        def m:double (1.0 + (mant / mantScale))
        return (s * (m * (this.powNum2(2.0 (b - bias)))))
    }

    ; 2^n for a possibly NEGATIVE n; powNum takes a non-negative exponent.
    fn powNum2:double (base:double expn:int) {
        if (expn >= 0) {
            return (this.powNum(base expn))
        }
        return (1.0 / (this.powNum(base (0 - expn))))
    }

    fn toIntPow2:int (n:int) {
        def out:int 1
        def i:int 0
        while (i < n) {
            out = (out * 2)
            i = (i + 1)
        }
        return out
    }

    ; How many bytes one DataView element occupies.
    fn dataViewWidth:int (elemName:string) {
        if (elemName == "BigInt64") { return 8 }
        if (elemName == "BigUint64") { return 8 }
        if (elemName == "Int8") { return 1 }
        if (elemName == "Uint8") { return 1 }
        if (elemName == "Int16") { return 2 }
        if (elemName == "Uint16") { return 2 }
        if (elemName == "Int32") { return 4 }
        if (elemName == "Uint32") { return 4 }
        if (elemName == "Float32") { return 4 }
        if (elemName == "Float64") { return 8 }
        return 1
    }

    ; The unsigned integer the `width` bytes at `base` spell, in the requested
    ; byte order. Assembled in the DOUBLE domain: a Uint32 runs past the int.
    fn dataViewRawBits:double (bytes:EvHandle base:int width:int little:boolean) {
        def acc:double 0.0
        def i:int 0
        while (i < width) {
            def pos:int (base + i)
            if little {
                pos = ((base + width) - (1 + i))
            }
            def b:int (bit_and (this.toIntegerOf((bytes.arrayItemAt(pos)))) 255)
            acc = ((acc * 256.0) + (to_double b))
            i = (i + 1)
        }
        return acc
    }

    fn dataViewPutBits:void (bytes:EvHandle base:int width:int little:boolean bits:double) {
        def rest:double bits
        def i:int (width - 1)
        while (i >= 0) {
            def b:double (this.modNum(rest 256.0))
            rest = (this.floorNum((rest / 256.0)))
            def pos:int (base + i)
            if little {
                pos = ((base + width) - (1 + i))
            }
            bytes.setIndexAt(pos (EvValueBridge.taggedNumber(b)))
            i = (i - 1)
        }
    }

    ; A float's bytes, big-endian, laid out field by field so no intermediate
    ; ever exceeds the exact-integer range of a double.
    fn floatBytes:[double] (v:double width:int) {
        def out:[double]
        def expBits:int 11
        def mantBits:int 52
        if (width == 4) {
            expBits = 8
            mantBits = 23
        }
        def parts:[double] (this.floatParts(v expBits mantBits))
        def sign:double (itemAt parts 0)
        def biased:double (itemAt parts 1)
        def mant:double (itemAt parts 2)
        def i:int 0
        def lowBytes:int 6
        if (width == 4) { lowBytes = 2 }
        def rest:double mant
        def low:[double]
        while (i < lowBytes) {
            push low (this.modNum(rest 256.0))
            rest = (this.floorNum((rest / 256.0)))
            i = (i + 1)
        }
        ; `rest` now holds the mantissa bits that share a byte with the exponent.
        def b0:double 0.0
        def b1:double 0.0
        if (width == 8) {
            b0 = ((sign * 128.0) + (this.floorNum((biased / 16.0))))
            b1 = (((this.modNum(biased 16.0)) * 16.0) + rest)
        } {
            b0 = ((sign * 128.0) + (this.floorNum((biased / 2.0))))
            b1 = (((this.modNum(biased 2.0)) * 128.0) + rest)
        }
        push out b0
        push out b1
        def k:int (lowBytes - 1)
        while (k >= 0) {
            push out (itemAt low k)
            k = (k - 1)
        }
        return out
    }

    fn floatFromBytes:double (bytes:EvHandle base:int width:int little:boolean) {
        def expBits:int 11
        def mantBits:int 52
        def lowBytes:int 6
        if (width == 4) {
            expBits = 8
            mantBits = 23
            lowBytes = 2
        }
        def ordered:[double]
        def i:int 0
        while (i < width) {
            def pos:int (base + i)
            if little {
                pos = ((base + width) - (1 + i))
            }
            push ordered (to_double (bit_and (this.toIntegerOf((bytes.arrayItemAt(pos)))) 255))
            i = (i + 1)
        }
        def b0:double (itemAt ordered 0)
        def b1:double (itemAt ordered 1)
        def sign:double 0.0
        if (b0 >= 128.0) {
            sign = 1.0
            b0 = (b0 - 128.0)
        }
        def biased:double 0.0
        def topMant:double 0.0
        if (width == 8) {
            biased = ((b0 * 16.0) + (this.floorNum((b1 / 16.0))))
            topMant = (this.modNum(b1 16.0))
        } {
            biased = ((b0 * 2.0) + (this.floorNum((b1 / 128.0))))
            topMant = (this.modNum(b1 128.0))
        }
        def mant:double topMant
        def j:int 0
        while (j < lowBytes) {
            mant = ((mant * 256.0) + (itemAt ordered (2 + j)))
            j = (j + 1)
        }
        return (this.valueFromParts(sign biased mant expBits mantBits))
    }

    ; D-BIGINT: the 64-bit element kinds. A double cannot hold a 64-bit integer,
    ; which is the whole reason these exist, so they are assembled and taken
    ; apart a byte at a time through BigNum rather than through a number.
    fn bigFromBytes:BigNum (bytes:EvHandle base:int little:boolean signed:boolean) {
        def acc:BigNum (BigNum.zero())
        def i:int 7
        while (i >= 0) {
            def at:int (base + i)
            if little {
                at = (base + i)
            } {
                at = (base + (7 - i))
            }
            def byteV:int 0
            if (at < (bytes.denseLen())) {
                byteV = (to_int ((bytes.arrayItemAt(at)).toNumber()))
            }
            acc = ((acc.shiftLeft(8)).add((BigNum.fromInt((bit_and byteV 255)))))
            i = (i - 1)
        }
        if signed {
            return (acc.asIntN(64))
        }
        return acc
    }

    fn bigToBytes:void (b:BigNum bytes:EvHandle base:int little:boolean) {
        def u:BigNum (b.asUintN(64))
        def i:int 0
        while (i < 8) {
            def shifted:BigNum (u.shiftRight((i * 8)))
            def byteV:int (to_int ((shifted.asUintN(8)).toDouble()))
            def at:int (base + i)
            if (false == little) {
                at = (base + (7 - i))
            }
            if (at < (bytes.denseLen())) {
                bytes.setIndexAt(at (EvValueBridge.taggedNumber((to_double byteV))))
            }
            i = (i + 1)
        }
    }

    fn dataViewRead:EvHandle (bytes:EvHandle base:int elemName:string little:boolean) {
        def width:int (this.dataViewWidth(elemName))
        if (elemName == "BigInt64") {
            def sBig:BigNum (this.bigFromBytes(bytes base little true))
            return (this.makeBigIntValue(sBig))
        }
        if (elemName == "BigUint64") {
            def uBig:BigNum (this.bigFromBytes(bytes base little false))
            return (this.makeBigIntValue(uBig))
        }
        if (elemName == "Float32") {
            return (EvValueBridge.taggedNumber((this.floatFromBytes(bytes base 4 little))))
        }
        if (elemName == "Float64") {
            return (EvValueBridge.taggedNumber((this.floatFromBytes(bytes base 8 little))))
        }
        def raw:double (this.dataViewRawBits(bytes base width little))
        ; A SIGNED element wraps around half its range.
        def signed:boolean false
        if ((substring elemName 0 3) == "Int") { signed = true }
        if signed {
            def span:double (this.powNum(2.0 (width * 8)))
            def half:double (span / 2.0)
            if (raw >= half) {
                return (EvValueBridge.taggedNumber((raw - span)))
            }
        }
        return (EvValueBridge.taggedNumber(raw))
    }

    fn dataViewWrite:void (bytes:EvHandle base:int elemName:string little:boolean v:double) {
        def width:int (this.dataViewWidth(elemName))
        def isFloat:boolean false
        if (elemName == "Float32") { isFloat = true }
        if (elemName == "Float64") { isFloat = true }
        if isFloat {
            def fb:[double] (this.floatBytes(v width))
            def i:int 0
            while (i < width) {
                def pos:int (base + i)
                if little {
                    pos = ((base + width) - (1 + i))
                }
                bytes.setIndexAt(pos (EvValueBridge.taggedNumber((itemAt fb i))))
                i = (i + 1)
            }
            return
        }
        def span:double (this.powNum(2.0 (width * 8)))
        def t:double (this.truncNum(v))
        if (v != v) { t = 0.0 }
        if (false == (this.isFiniteNum(v))) { t = 0.0 }
        def m:double (this.modNum(t span))
        if (m < 0.0) { m = (m + span) }
        this.dataViewPutBits(bytes base width little m)
    }

    ; The computed properties of an ArrayBuffer, a DataView or a typed array.
    ; Answers a NULL handle when the name is not one of them, which is what the
    ; caller falls through on.
    fn bufferOwnProperty:EvHandle (v:EvHandle propName:string) {
        if (this.isArrayBufferValue(v)) {
            def abDetached:boolean (v.hasOwnData("__abdetached__"))
            if (propName == "byteLength") {
                ; A DETACHED buffer has no bytes at all, which is what makes
                ; `b.byteLength` zero after a transfer rather than unchanged.
                if abDetached {
                    return (EvHandle.fromInt(0))
                }
                return (EvHandle.fromInt(((this.arrayBufferBytes(v)).denseLen())))
            }
            if (propName == "detached") {
                return (EvValueBridge.taggedBoolean(abDetached))
            }
            if (propName == "maxByteLength") {
                if (v.hasOwnData("__abmax__")) {
                    return (v.getOwnData("__abmax__"))
                }
                if abDetached {
                    return (EvHandle.fromInt(0))
                }
                return (EvHandle.fromInt(((this.arrayBufferBytes(v)).denseLen())))
            }
            if (v.hasOwnData("__abshared__")) {
                if (propName == "growable") {
                    return (EvValueBridge.taggedBoolean((v.hasOwnData("__abmax__"))))
                }
            } {
                if (propName == "resizable") {
                    return (EvValueBridge.taggedBoolean((v.hasOwnData("__abmax__"))))
                }
            }
        }
        if (this.isDataViewValue(v)) {
            if (propName == "byteLength") {
                return (v.getOwnData("__dvlength__"))
            }
            if (propName == "byteOffset") {
                return (v.getOwnData("__dvoffset__"))
            }
            if (propName == "buffer") {
                return (v.getOwnData("__dvbuffer__"))
            }
        }
        def taBrand:string (this.typedArrayBrandOf(v))
        if ((strlen taBrand) > 0) {
            ; A view onto a DETACHED buffer has no elements: `a.length` is 0
            ; and `a.byteLength` is 0, however many the array held before the
            ; transfer. Reading an element already answered undefined; the
            ; length did not follow, so a loop over one still ran its old
            ; number of turns and read undefined every time.
            if (this.isBufferBackedView(v)) {
                def dvBuf:EvHandle (v.getOwnData("__tabuffer__"))
                if (this.isArrayBufferValue(dvBuf)) {
                    if (dvBuf.hasOwnData("__abdetached__")) {
                        if (propName == "length") { return (EvHandle.fromInt(0)) }
                        if (propName == "byteLength") { return (EvHandle.fromInt(0)) }
                        if (propName == "byteOffset") { return (EvHandle.fromInt(0)) }
                    }
                }
            }
            if (propName == "BYTES_PER_ELEMENT") {
                return (EvHandle.fromInt((this.typedArrayWidth(taBrand))))
            }
            if (propName == "byteLength") {
                return (EvHandle.fromInt(((v.denseLen()) * (this.typedArrayWidth(taBrand)))))
            }
            if (propName == "byteOffset") {
                if (v.hasOwnData("__taoffset__")) {
                    return (v.getOwnData("__taoffset__"))
                }
                return (EvHandle.fromInt(0))
            }
            ; A view answers the buffer it looks at; one built from a length or
            ; a list gets a buffer minted for it on demand, which is what the
            ; spec says it has had all along.
            if (propName == "buffer") {
                if (v.hasOwnData("__tabuffer__")) {
                    return (v.getOwnData("__tabuffer__"))
                }
                ; ...and one built from a LENGTH or a list has had a buffer all
                ; along, per the spec -- `new Int32Array(4).buffer` is an
                ; ArrayBuffer of 16 bytes, not undefined. The comment above used
                ; to claim this was minted on demand; nothing did it, and the
                ; property answered null.
                ;
                ; Minting it also makes the array a REGISTERED VIEW of it, which
                ; it has to be: handing back a detached copy would let `a[0] = 1`

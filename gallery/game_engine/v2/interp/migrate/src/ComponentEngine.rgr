    fn isBigTypedArrayKind:boolean (kind:string) {
        if (kind == "BigInt64Array") { return true }
        if (kind == "BigUint64Array") { return true }
        return false
    }

    fn typedArrayElemName:string (kind:string) {
        if (kind == "BigInt64Array") { return "BigInt64" }
        if (kind == "BigUint64Array") { return "BigUint64" }
        if (kind == "Int8Array") { return "Int8" }
        if (kind == "Uint8Array") { return "Uint8" }
        if (kind == "Uint8ClampedArray") { return "Uint8" }
        if (kind == "Int16Array") { return "Int16" }
        if (kind == "Uint16Array") { return "Uint16" }
        if (kind == "Int32Array") { return "Int32" }
        if (kind == "Uint32Array") { return "Uint32" }
        if (kind == "Float32Array") { return "Float32" }
        if (kind == "Float64Array") { return "Float64" }
        return "Uint8"
    }

    fn isBufferBackedView:boolean (v:EvHandle) {
        if (false == (v.isArrayValue())) { return false }
        return (v.hasOwnData("__tabuffer__"))
    }

    ; D-VIEWS: re-read a view's elements from the bytes it looks at. A buffer
    ; keeps the list of views over it, and a write through any one of them --

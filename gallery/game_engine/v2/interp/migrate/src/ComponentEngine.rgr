        def out:[int]
        def n:int (array_length cps)
        def i:int 0
        while (i < n) {
            def cp:int (itemAt cps i)
            if (this.isHangulSyllable(cp)) {
                def hd:[int] (this.hangulDecompose(cp))
                def hk:int 0

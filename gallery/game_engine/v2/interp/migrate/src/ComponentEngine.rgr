            if (composite >= 0) {
                set out starter composite
            } {
                if (c == 0) {
                    starter = (array_length out)
                    lastClass = (0 - 1)
                } {
                    lastClass = c
                }
                push out cp
            }
            i = (i + 1)
        }
        return out
    }

    ; §22.1.3.14 String.prototype.normalize. The two compatibility forms, NFKC
    ; and NFKD, are NOT implemented: they need a second and much larger mapping
    ; table, and they are lossy -- they fold ﬁ to fi and ² to 2 -- so a program
    ; that asks for one and silently gets a canonical form back would be worse
    ; off than one told it is missing.
    fn normalizeString:string (s:string form:string) {
        if (this.asciiOnly(s)) {
            return s
        }
        this.ensureNormTables()
        def cps:[int] (this.codePointsOf(s))
        def outCps:[int]
        if (form == "NFD") {
            outCps = (this.nfdPoints(cps))
        } {
            outCps = (this.nfcPoints(cps))
        }
        def out:string ""
        def i:int 0
        def n:int (array_length outCps)
        while (i < n) {
            out = (out + (this.cuFromCodePoint((itemAt outCps i))))
            i = (i + 1)
        }
        return out
    }


    ; ==========================================================================
    ; D-COLLATE: localeCompare.
    ; --------------------------------------------------------------------------
    ; It was a plain code-unit comparison, which is the one thing localeCompare
    ; is specified NOT to be. Every accented word landed after every unaccented
    ; one, so a sorted index came out with Éclair and Ångström in a clump at the
    ; end rather than under E and A.
    ;
    ; Three levels, in the shape of UTS #10: base letters, then accents, then
    ; case, then code units as a last resort. The weights are in
    ; UnicodeCollate.rgr (generated, see the tools/ script named at its head),
    ; which also records what this is not -- there are no locale tailorings, so
    ; Swedish å still sorts under a rather than at the end of the alphabet.
    fn ensureCollateTables:void () {
        if collTablesLoaded { return }
        collPunct = (UnicodeCollate.punctRuns())
        collExpand = (UnicodeCollate.expansions())
        collMarks = (UnicodeCollate.markRanks())
        collBases = (UnicodeCollate.baseLetters())
        collTablesLoaded = true
    }

    ; Punctuation sorts before digits and letters, in an order of its own that
    ; is not code-point order -- ICU puts '_' ahead of the digits. -1 when the
    ; character is not punctuation.
    fn collPunctRank:int (cp:int) {
        def n:int (array_length collPunct)
        def triples:int (this.intDiv(n 3))
        def lo:int 0
        def hi:int (triples - 1)
        while (lo <= hi) {
            def mid:int (bit_shr (lo + hi) 1)
            def base:int (mid * 3)
            def a:int (itemAt collPunct base)
            def b:int (itemAt collPunct (base + 1))
            if (cp < a) {
                hi = (mid - 1)
            } {
                if (cp > b) {
                    lo = (mid + 1)
                } {
                    return ((itemAt collPunct (base + 2)) + (cp - a))
                }
            }
        }
        return (0 - 1)
    }


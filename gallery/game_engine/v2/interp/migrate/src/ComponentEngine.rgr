                def preKey:string ""
                def preCurrent:EvHandle (EvValueBridge.taggedUndefined())
                def preResolved:boolean false
                ; D-EVALORDER (§13.15.2 step 1): a PLAIN assignment resolves
                ; its target reference before the right-hand side too -- only
                ; the READ below is peculiar to a compound. This gate used to
                ; be `opK != 1`, so `a[i] = f()` re-derived the index AFTER

            def arrAcc:[string] (v.ownGetterKeys())
            def aai:int 0
            while (aai < (array_length arrAcc)) {
                def aak:string (itemAt arrAcc aai)
                if ((this.canonicalArrayIndex(aak)) < 0) {
                    push out aak
                }
                aai = (aai + 1)
            }
            def arrSet:[string] (v.ownSetterKeys())
            def asi:int 0
            while (asi < (array_length arrSet)) {
                def ask:string (itemAt arrSet asi)
                if ((this.canonicalArrayIndex(ask)) < 0) {
                    if (false == (v.hasOwnGetter(ask))) {
                        push out ask
                    }
                }
                asi = (asi + 1)
            }
            def extra:[string] (v.ownDataKeys())
            def j:int 0
            while (j < (array_length extra)) {
                push out (itemAt extra j)
                j = (j + 1)
            }
        }
        return out
    }

    ; D-ATTRS: own ENUMERABLE keys. Object.keys/values/entries and JSON
    ; serialisation see only these; getOwnPropertyNames still sees everything.
    ; Before attributes existed the two were indistinguishable, so a property
    ; defined as non-enumerable still showed up in Object.keys.
    fn objectEnumerableKeys:[string] (v:EvHandle) {
        return (this.orderEnumKeys((this.objectEnumerableKeysRaw(v))))
    }

    fn objectEnumerableKeysRaw:[string] (v:EvHandle) {
        def out:[string]
        ; D-PROXY: which of a proxy's keys are ENUMERABLE is the
        ; getOwnPropertyDescriptor trap's answer, not the target's. Without
        ; asking, Object.keys listed everything ownKeys returned -- including
        ; the properties the handler had just described as non-enumerable.
        if (this.isProxyValue(v)) {
            def pAll:[string] (this.objectKeys(v))
            if scriptThrew {
                return out
            }
            def pi:int 0
            while (pi < (array_length pAll)) {
                def pk:string (itemAt pAll pi)
                def pd:EvHandle (this.ownPropertyDescriptorOf(v pk))
                if scriptThrew {
                    return out
                }
                if (this.isDescriptorObject(pd)) {
                    if ((this.getPropertyValue(pd "enumerable")).toBool()) {
                        push out pk
                    }
                }
                pi = (pi + 1)
            }
            return out
        }
        if (v.isArrayValue()) {
            ; An index is enumerable UNLESS defineProperty recorded otherwise --
            ; `Object.defineProperties(a, {"0": {value: 1}})` creates a
            ; non-enumerable element, and for-in must skip it.
            def arrAll:[string] (this.objectKeys(v))
            def ai2:int 0
            while (ai2 < (array_length arrAll)) {
                def ak2:string (itemAt arrAll ai2)
                if (v.isEnumerable(ak2)) {
                    push out ak2
                }
                ai2 = (ai2 + 1)
            }
            return out
        }
        if (v.isString()) {
            return (this.objectKeys(v))
        }
        def holdsProps:boolean (v.isObject())
        if (v.isFunction()) { holdsProps = true }
        if holdsProps {
            def all:[string] (this.objectKeys(v))
            def i:int 0
            while (i < (array_length all)) {
                def k:string (itemAt all i)
                if (v.isEnumerable(k)) {
                    push out k
                }
                i = (i + 1)
            }
        }
        return out
    }

    ; True if an object value owns `key` (distinguishes a present-but-null value
    ; from an absent key, which getMember cannot). Used by the `in` operator.
    fn objHasKey:boolean (v:EvHandle key:string) {
        if (v.isObject()) {
            return (v.hasOwnData(key))
        }
        ; D-FNPROPS: length, name and prototype are OWN properties of every
        ; function even though the engine synthesises them on read rather than
        ; storing them, so hasOwnProperty has to know about them by name.
        if (v.isFunction()) {
            if (v.hasOwnData(key)) {
                return true
            }
            ; A BUILT-IN stores its length and name, so a missing one there was
            ; deleted and must stay deleted. Only a user function synthesises
            ; them on read, and only it gets the fallback.
            if ((strlen (v.builtinNameOf())) > 0) {
                return false
            }
            ; A synthesised property that was DELETED stays deleted.
            if (v.hasSuppressed(key)) {
                return false
            }
            if (key == "length") { return true }
            if (key == "name") { return true }
            if (key == "prototype") { return true }
            return false
        }
        if (v.isArrayValue()) {
            if (v.hasOwnData(key)) {
                return true
            }
            if (key == "length") { return true }
            def ai@(optional):int (to_int key)
            if ai {
                def aidx:int (unwrap ai)
                ; D-HOLES: a hole is an ABSENT property, so `1 in [0,,2]` is
                ; false and hasOwnProperty("1") is false with it.
                if ((aidx >= 0) && (aidx < (v.denseLen()))) {
                    return (false == ((EvValueBridge.isHole((v.arrayItemAt(aidx))))))
                }
                return false
            }
            return false
        }
        return false
    }

    ; ---- JSON (ECMA-404) ----
    ; Quote+escape a string for JSON output (handles " \ and the common controls).
    fn jsonQuote:string (s:string) {
        def out:string "\""
        def i:int 0
        def L:int (strlen s)
        while (i < L) {
            def ch:string (substring s i (i + 1))
            def handled:boolean false
            if (ch == "\"") {
                out = (out + "\\\"")
                handled = true
            }
            if (false == handled) {
                if (ch == "\\") {
                    out = (out + "\\\\")
                    handled = true
                }
            }
            ; §24.3.2.2 QuoteJSONString: the five named escapes, then EVERY
            ; remaining C0 control as \u00XX. Only three of the five were
            ; written and the rest went through as raw control characters, so
            ; the text did not parse back as JSON.
            if (false == handled) {
                def cp:int (this.charCodePointOf(ch))
                if (cp == 8) {
                    out = (out + "\\b")
                    handled = true
                }
                if (cp == 9) {
                    out = (out + "\\t")
                    handled = true
                }
                if (cp == 10) {
                    out = (out + "\\n")
                    handled = true
                }
                if (cp == 12) {
                    out = (out + "\\f")
                    handled = true
                }
                if (cp == 13) {
                    out = (out + "\\r")
                    handled = true
                }
                if (false == handled) {
                    if ((cp >= 0) && (cp < 32)) {
                        ; LOWERCASE hex: `JSON.stringify` writes \u000b, and
                        ; hexPad is the uppercase form the escape sequences and
                        ; the URI encoder want.
                        out = (out + ("\\u" + (this.hexPadLower(cp 4))))
                        handled = true
                    }
                }
            }
            if (false == handled) {
                out = (out + ch)
            }
            i = (i + 1)
        }
        return (out + "\"")
    }

    ; Serialise a value to JSON. undefined/functions become null (JSON has no such
    ; types); the internal __class__ tag on class instances is omitted.
    ; ---- JSON.stringify, §24.3.2 -----------------------------------------
    ; D-JSONOPTS: the serializer used to take a value and nothing else, so
    ; `space`, both replacer forms, `toJSON` and cycle detection were all
    ; missing -- `JSON.stringify(o, null, 2)` answered the same compact text as
    ; `JSON.stringify(o)`, and a cyclic object recursed until the host stack
    ; gave out. The entry point below sets the state up and the three
    ; serialisers read it.
    fn jsonStringifyTop:EvHandle (v:EvHandle replacer:EvHandle space:EvHandle) {
        def savedGap:string jsonGap
        def savedIndent:string jsonIndent
        def savedHasFn:boolean jsonHasReplacerFn
        def savedHasList:boolean jsonHasPropList
        def savedList:[string] jsonPropList
        def savedSeen:[EvHandle] jsonSeen
        def freshList:[string]
        def freshSeen:[EvHandle]
        jsonGap = ""
        jsonIndent = ""
        jsonHasReplacerFn = false
        jsonHasPropList = false
        jsonPropList = freshList
        jsonSeen = freshSeen
        if (replacer.isFunction()) {
            jsonHasReplacerFn = true
            jsonReplacerFn = replacer
        } {
            ; An ARRAY replacer is a property LIST: only these names survive,
            ; in this order, and duplicates collapse. Only strings and numbers
            ; count as names -- anything else in the array is ignored.
            if (replacer.isArrayValue()) {
                jsonHasPropList = true
                def ri:int 0
                while (ri < (replacer.denseLen())) {
                    def rv:EvHandle (replacer.arrayItemAt(ri))
                    def rname:string ""
                    def rok:boolean false
                    if (rv.isString()) {
                        rname = (rv.stringOf())
                        rok = true
                    }
                    if (rv.isNumber()) {
                        rname = (rv.toString())
                        rok = true
                    }
                    if rok {
                        def dup:boolean false
                        def di:int 0
                        while (di < (array_length jsonPropList)) {
                            if ((itemAt jsonPropList di) == rname) { dup = true }
                            di = (di + 1)
                        }
                        if (false == dup) {
                            push jsonPropList rname
                        }
                    }
                    ri = (ri + 1)
                }
            }
        }
        ; `space` is a NUMBER of spaces (clamped to 10) or a string used
        ; verbatim (its first 10 characters). A boxed one unwraps first.
        def sp:EvHandle space
        if (this.isDescriptorObject(sp)) {
            def spk:string (this.receiverKind(sp))
            if (spk == "number") { sp = (EvValueBridge.taggedNumber((this.toNumberOf(sp)))) }
            if (spk == "string") { sp = (EvValueBridge.taggedString((this.toStringOf(sp)))) }
        }
        if (sp.isNumber()) {
            def spn:int (this.toIntegerOf(sp))
            if (spn > 10) { spn = 10 }
            def spi:int 0
            while (spi < spn) {
                jsonGap = (jsonGap + " ")
                spi = (spi + 1)
            }
        }
        if (sp.isString()) {
            def sps:string (sp.stringOf())
            if ((strlen sps) > 10) {
                sps = (substring sps 0 10)
            }
            jsonGap = sps
        }
        ; The value is serialised as the sole property of a synthetic wrapper,
        ; so a top-level replacer and a top-level toJSON both see a holder.
        def wk:[string]
        def wv:[EvHandle]
        def holder:EvHandle (EvValueBridge.taggedObject(wk wv))
        holder.setMember("" v)
        def text:string (this.jsonSerializeProp("" holder))
        def omitted:boolean jsonOmitted
        jsonGap = savedGap
        jsonIndent = savedIndent
        jsonHasReplacerFn = savedHasFn
        jsonHasPropList = savedHasList
        jsonPropList = savedList
        jsonSeen = savedSeen
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        ; A value with no JSON form answers UNDEFINED, not the string "null" --
        ; `JSON.stringify(undefined)` and `JSON.stringify(function(){})` are
        ; both undefined.
        if omitted {
            return (EvValueBridge.taggedUndefined())
        }
        return (EvValueBridge.taggedString(text))
    }

    ; SerializeJSONProperty: read holder[key], run toJSON and the replacer over
    ; it, then serialise whatever came back.
    fn jsonSerializeProp:string (key:string holder:EvHandle) {
        jsonOmitted = false
        def value:EvHandle (this.getPropertyValue(holder key))
        if scriptThrew { return "" }
        if (this.isDescriptorObject(value)) {
            def tj:EvHandle (this.getPropertyValue(value "toJSON"))
            if scriptThrew { return "" }
            if (tj.isFunction()) {
                def tjArgs:[EvHandle]
                push tjArgs (EvValueBridge.taggedString(key))
                value = (this.callFnValueWithValues((tj.withThisForCall(value)) tjArgs))
                if scriptThrew { return "" }
            }
        }
        if jsonHasReplacerFn {
            def rArgs:[EvHandle]
            push rArgs (EvValueBridge.taggedString(key))
            push rArgs value
            def rFn:EvHandle (unwrap jsonReplacerFn)
            value = (this.callFnValueWithValues((rFn.withThisForCall(holder)) rArgs))
            if scriptThrew { return "" }
        }
        return (this.jsonSerializeValue(value))
    }

    fn jsonSerializeValue:string (valueIn:EvHandle) {
        jsonOmitted = false
        def value:EvHandle valueIn
        ; A boxed Number, String or Boolean serialises as the primitive it
        ; wraps, which is what `new Number(3)` inside a structure has to become.
        if (this.isDescriptorObject(value)) {
            def bk:string (this.receiverKind(value))
            if (bk == "number") { value = (EvValueBridge.taggedNumber((this.toNumberOf(value)))) }
            if (bk == "string") { value = (EvValueBridge.taggedString((this.toStringOf(value)))) }
            if (bk == "boolean") { value = (EvValueBridge.taggedBoolean((value.toBool()))) }
            if scriptThrew { return "" }
        }
        ; §25.5.2: a BigInt has no JSON representation and JSON.stringify
        ; refuses it rather than inventing one. Serialising it as an object
        ; produced `{}`, which round-trips to something that is not the value.
        if (this.isBigIntValue(value)) {
            def _bj:EvHandle (this.throwSpecError("TypeError" "Do not know how to serialize a BigInt"))
            return ""
        }
        if (value.isNull()) {
            return "null"
        }
        if (value.isBoolean()) {
            if (value.toBool()) { return "true" }
            return "false"
        }
        if (value.isString()) {
            return (this.jsonQuote((value.stringOf())))
        }
        if (value.isNumber()) {
            def nv:double (value.toNumber())
            ; JSON has no NaN or Infinity; both serialise as null. Emitting the
            ; literal text produces JSON that will not parse back.
            if (nv != nv) { return "null" }
            def infJ:double (1.0 / 0.0)
            if (nv == infJ) { return "null" }
            if (nv == (0.0 - infJ)) { return "null" }
            return (value.toString())
        }
        ; A SYMBOL has no JSON form, and neither does a function or undefined.
        if (this.isSymbolValue(value)) {
            jsonOmitted = true
            return ""
        }
        if (value.isFunction()) {
            jsonOmitted = true
            return ""
        }
        if (value.isArrayValue()) {
            return (this.jsonSerializeArray(value))
        }
        if (this.isDescriptorObject(value)) {
            return (this.jsonSerializeObject(value))
        }
        jsonOmitted = true
        return ""
    }

    ; True when this exact object is already on the way out -- the cycle test.
    fn jsonSeenAlready:boolean (v:EvHandle) {
        def i:int 0
        while (i < (array_length jsonSeen)) {
            if ((v.identityIdOf()) == ((itemAt jsonSeen i).identityIdOf())) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    fn jsonSerializeArray:string (v:EvHandle) {
        if (this.jsonSeenAlready(v)) {
            def _c:EvHandle (this.throwSpecError("TypeError" "Converting circular structure to JSON"))
            return ""
        }
        push jsonSeen v
        def stepback:string jsonIndent
        jsonIndent = (jsonIndent + jsonGap)
        def parts:[string]
        def n:int (this.toIntegerOf((this.getPropertyValue(v "length"))))
        def i:int 0
        while (i < n) {
            def piece:string (this.jsonSerializeProp((to_string i) v))
            if scriptThrew {
                jsonIndent = stepback
                this.jsonPopSeen()
                return ""
            }
            ; An array ELEMENT with no JSON form becomes null; only an object
            ; property is omitted.
            if jsonOmitted {
                push parts "null"
            } {
                push parts piece
            }
            i = (i + 1)
        }
        def out:string (this.jsonJoinParts(parts "[" "]" stepback))
        jsonIndent = stepback
        this.jsonPopSeen()
        jsonOmitted = false
        return out
    }

    fn jsonSerializeObject:string (v:EvHandle) {
        if (this.jsonSeenAlready(v)) {
            def _c:EvHandle (this.throwSpecError("TypeError" "Converting circular structure to JSON"))
            return ""
        }
        push jsonSeen v
        def stepback:string jsonIndent
        jsonIndent = (jsonIndent + jsonGap)
        def ks:[string] jsonPropList
        if (false == jsonHasPropList) {
            ks = (this.objectKeys(v))
        }
        def parts:[string]
        def i:int 0
        while (i < (array_length ks)) {
            def k:string (itemAt ks i)
            def skipKey:boolean (this.isHiddenInstanceKey(k))
            ; A symbol key never serialises: its name is the "@@" spelling this
            ; engine gives it, which is not a property name JSON can carry.
            if ((substring k 0 2) == "@@") { skipKey = true }
            ; §25.5.2.2 SerializeJSONObject walks EnumerableOwnPropertyNames, so
            ; a non-enumerable own property is not serialised. The walk was over
            ; every own key, which is why `JSON.stringify(new Error('x'))`
            ; produced the name and message rather than the `{}` every other
            ; engine answers.
            if (false == jsonHasPropList) {
                if (v.hasOwnAttrs(k)) {
                    if (false == (v.isEnumerable(k))) { skipKey = true }
                }
            }
            if (false == skipKey) {
                def piece:string (this.jsonSerializeProp(k v))
                if scriptThrew {
                    jsonIndent = stepback
                    this.jsonPopSeen()
                    return ""
                }
                if (false == jsonOmitted) {
                    def entry:string (this.jsonQuote(k))
                    entry = (entry + ":")
                    if ((strlen jsonGap) > 0) {
                        entry = (entry + " ")
                    }
                    push parts (entry + piece)
                }
            }
            i = (i + 1)
        }
        def out:string (this.jsonJoinParts(parts "{" "}" stepback))
        jsonIndent = stepback
        this.jsonPopSeen()
        jsonOmitted = false
        return out
    }

    fn jsonPopSeen:void () {
        def keep:[EvHandle]
        def i:int 0
        def n:int ((array_length jsonSeen) - 1)
        while (i < n) {
            push keep (itemAt jsonSeen i)
            i = (i + 1)
        }
        jsonSeen = keep
    }

    ; The bracketing rule both serialisers share: compact when there is no gap,
    ; one part per line indented by the gap when there is.
    fn jsonJoinParts:string (parts:[string] open:string close:string stepback:string) {
        if ((array_length parts) == 0) {
            return (open + close)
        }
        def out:string open
        def sep:string ","
        if ((strlen jsonGap) > 0) {
            out = (out + ("\n" + jsonIndent))
            sep = ("," + ("\n" + jsonIndent))
        }
        def i:int 0
        while (i < (array_length parts)) {
            if (i > 0) {
                out = (out + sep)
            }
            out = (out + (itemAt parts i))
            i = (i + 1)
        }
        if ((strlen jsonGap) > 0) {
            out = (out + ("\n" + stepback))
        }
        return (out + close)
    }

    ; Kept for the callers that only want the compact form of a plain value.
    fn jsonStringify:string (v:EvHandle) {
        def r:EvHandle (this.jsonStringifyTop(v (EvValueBridge.taggedUndefined()) (EvValueBridge.taggedUndefined())))
        if (r.isString()) {
            return (r.stringOf())
        }
        return "null"
    }

    ; ---- JSON.parse: recursive descent over jsonSrc using the jsonPos cursor ----
    ; D-JSON: the JSON grammar is its OWN grammar, not a lenient subset of
    ; JavaScript. The parser here used to accept anything it was handed --
    ; `{a:1}`, `[1,]`, `01`, `'x'`, a bare `tru`, trailing junk -- and quietly
    ; produced a value, so half of built-ins/JSON was asserting a SyntaxError
    ; that never came. Every production now reports rather than guesses.
    fn jsonFail:void (msg:string) {
        if (false == jsonFailed) {
            jsonFailed = true
            jsonError = msg
        }
    }
    fn jsonPeek:string () {
        if (jsonPos < jsonLen) {
            return (substring jsonSrc jsonPos (jsonPos + 1))
        }
        return ""
    }
    ; JSON whitespace is exactly these four characters -- not the wider set the
    ; language allows, which is what the <TAB>/<CR>/<LF>/<SP> tests check.
    fn jsonSkipWs:void () {
        def looping:boolean true
        while (looping) {
            def c:string (this.jsonPeek())
            if ((c == " ") || (c == "\n") || (c == "\t") || (c == "\r")) {
                jsonPos = (jsonPos + 1)
            } {
                looping = false
            }
        }
    }
    ; A keyword must be spelled in full: `tru` and `nulll` are both errors.
    fn jsonWord:boolean (word:string) {
        def n:int (strlen word)
        if ((jsonPos + n) > jsonLen) {
            return false
        }
        if ((substring jsonSrc jsonPos (jsonPos + n)) != word) {
            return false
        }
        jsonPos = (jsonPos + n)
        return true
    }
    fn jsonParseValue:EvHandle () {
        if jsonFailed {
            return (EvValueBridge.taggedUndefined())
        }
        this.jsonSkipWs()
        def c:string (this.jsonPeek())
        if ((strlen c) == 0) {
            this.jsonFail("Unexpected end of JSON input")
            return (EvValueBridge.taggedUndefined())
        }
        if (c == "{") {
            return (this.jsonParseObject())
        }
        if (c == "[") {
            return (this.jsonParseArray())
        }
        if (c == "\"") {
            return (EvValueBridge.taggedString((this.jsonParseString())))
        }
        if (c == "t") {
            if (this.jsonWord("true")) {
                return (EvValueBridge.taggedBoolean(true))
            }
            this.jsonFail("Unexpected token in JSON")
            return (EvValueBridge.taggedUndefined())
        }
        if (c == "f") {
            if (this.jsonWord("false")) {
                return (EvValueBridge.taggedBoolean(false))
            }
            this.jsonFail("Unexpected token in JSON")
            return (EvValueBridge.taggedUndefined())
        }
        if (c == "n") {
            if (this.jsonWord("null")) {
                return (EvValueBridge.taggedNull())
            }
            this.jsonFail("Unexpected token in JSON")
            return (EvValueBridge.taggedUndefined())
        }
        if (c == "-") {
            return (this.jsonParseNumber())
        }
        if (this.isDigitStr(c)) {
            return (this.jsonParseNumber())
        }
        this.jsonFail(("Unexpected token " + (c + " in JSON")))
        return (EvValueBridge.taggedUndefined())
    }
    ; JSONString: double quotes, no raw control character below U+0020, and only
    ; the eight escapes the grammar names (plus \uXXXX with four hex digits).
    fn jsonParseString:string () {
        def out:string ""
        if ((this.jsonPeek()) != "\"") {
            this.jsonFail("Expected string in JSON")
            return ""
        }
        jsonPos = (jsonPos + 1)
        def L:int jsonLen
        def looping:boolean true
        def closed:boolean false
        while (looping && (jsonPos < L)) {
            def ch:string (substring jsonSrc jsonPos (jsonPos + 1))
            ; The code point of the CHARACTER just read, not the byte at the
            ; same offset. `substring` walks code points and `charAt` walks
            ; bytes, so on the byte target these were two different positions
            ; -- and every non-ASCII byte reads back NEGATIVE, which made the
            ; control-character check below reject any string holding one.
            ; JSON.parse of anything this engine itself had stringified with a
            ; non-ASCII character in it threw SyntaxError.
            def code:int (this.charCodePointOf(ch))
            if (ch == "\"") {
                jsonPos = (jsonPos + 1)
                closed = true
                looping = false
            } {
                if (code < 32) {
                    this.jsonFail("Bad control character in JSON string")
                    return out
                }
                if (ch == "\\") {
                    if ((jsonPos + 1) >= L) {
                        this.jsonFail("Unexpected end of JSON input")
                        return out
                    }
                    def esc:string (substring jsonSrc (jsonPos + 1) (jsonPos + 2))
                    def known:boolean true
                    if (esc == "n") { out = (out + "\n") } {
                    if (esc == "t") { out = (out + "\t") } {
                    if (esc == "r") { out = (out + "\r") } {
                    if (esc == "b") { out = (out + (strfromcode 8)) } {
                    if (esc == "f") { out = (out + (strfromcode 12)) } {
                    if (esc == "\"") { out = (out + "\"") } {
                    if (esc == "\\") { out = (out + "\\") } {
                    if (esc == "/") { out = (out + "/") } {
                    if (esc == "u") {
                        if ((jsonPos + 6) > L) {
                            this.jsonFail("Bad Unicode escape in JSON")
                            return out
                        }
                        def hex:string (substring jsonSrc (jsonPos + 2) (jsonPos + 6))
                        def hv:int 0
                        def hi:int 0
                        while (hi < 4) {
                            def hc:int (charAt hex hi)
                            def dv:int (0 - 1)
                            if ((hc >= 48) && (hc <= 57)) { dv = (hc - 48) }
                            if ((hc >= 97) && (hc <= 102)) { dv = ((hc - 97) + 10) }
                            if ((hc >= 65) && (hc <= 70)) { dv = ((hc - 65) + 10) }
                            if (dv < 0) {
                                this.jsonFail("Bad Unicode escape in JSON")
                                return out
                            }
                            hv = ((hv * 16) + dv)
                            hi = (hi + 1)
                        }
                        ; \uXXXX names a code UNIT: strfromcode emits one
                        ; byte on the byte target, so \u00e9 arrived as a
                        ; lone 0xE9 rather than as é.
                        out = (out + (this.cuFromCodePoint(hv)))
                        jsonPos = (jsonPos + 4)
                    } {
                        known = false
                    }}}}}}}}}
                    if (false == known) {
                        this.jsonFail("Bad escaped character in JSON")
                        return out
                    }
                    jsonPos = (jsonPos + 2)
                } {
                    out = (out + ch)
                    jsonPos = (jsonPos + 1)
                }
            }
        }
        if (false == closed) {
            this.jsonFail("Unterminated string in JSON")
        }
        return out
    }
    ; JSONNumber: an optional minus, then 0 or a non-zero-led integer, then an
    ; optional fraction with at least one digit, then an optional exponent with
    ; at least one digit. No leading plus, no leading zeros, no hex, no bare
    ; trailing dot -- all of which the previous character sweep accepted.
    fn jsonParseNumber:EvHandle () {
        def start:int jsonPos
        def L:int jsonLen
        if ((this.jsonPeek()) == "-") {
            jsonPos = (jsonPos + 1)
        }
        def intDigits:int 0
        def firstDigit:string (this.jsonPeek())
        if (firstDigit == "0") {
            jsonPos = (jsonPos + 1)
            intDigits = 1
            ; A digit straight after a leading zero is an error: `01` is not JSON.
            if (this.isDigitStr((this.jsonPeek()))) {
                this.jsonFail("Unexpected number in JSON")
                return (EvValueBridge.taggedUndefined())
            }
        } {
            while (this.isDigitStr((this.jsonPeek()))) {
                jsonPos = (jsonPos + 1)
                intDigits = (intDigits + 1)
            }
        }
        if (intDigits == 0) {
            this.jsonFail("Unexpected token in JSON")
            return (EvValueBridge.taggedUndefined())
        }
        if ((this.jsonPeek()) == ".") {
            jsonPos = (jsonPos + 1)
            def fracDigits:int 0
            while (this.isDigitStr((this.jsonPeek()))) {
                jsonPos = (jsonPos + 1)
                fracDigits = (fracDigits + 1)
            }
            if (fracDigits == 0) {
                this.jsonFail("Unexpected token in JSON")
                return (EvValueBridge.taggedUndefined())
            }
        }
        def ec:string (this.jsonPeek())
        if ((ec == "e") || (ec == "E")) {
            jsonPos = (jsonPos + 1)
            def sc:string (this.jsonPeek())
            if ((sc == "+") || (sc == "-")) {
                jsonPos = (jsonPos + 1)
            }
            def expDigits:int 0
            while (this.isDigitStr((this.jsonPeek()))) {
                jsonPos = (jsonPos + 1)
                expDigits = (expDigits + 1)
            }
            if (expDigits == 0) {
                this.jsonFail("Unexpected token in JSON")
                return (EvValueBridge.taggedUndefined())
            }
        }
        def numStr:string (substring jsonSrc start jsonPos)
        def d@(optional):double (to_double numStr)
        if d {
            return (EvValueBridge.taggedNumber((unwrap d)))
        }
        this.jsonFail("Unexpected number in JSON")
        return (EvValueBridge.taggedUndefined())
    }
    fn isDigitStr:boolean (ch:string) {
        if ((strlen ch) == 0) {
            return false
        }
        def code:int (charAt ch 0)
        if (code >= 48) {
            if (code <= 57) {
                return true
            }
        }
        return false
    }
    fn jsonParseArray:EvHandle () {
        def items:[EvHandle]
        jsonPos = (jsonPos + 1)
        this.jsonSkipWs()
        if ((this.jsonPeek()) == "]") {
            jsonPos = (jsonPos + 1)
            return (EvValueBridge.taggedArray(items))
        }
        def looping:boolean true
        while (looping) {
            push items (this.jsonParseValue())
            if jsonFailed {
                return (EvValueBridge.taggedArray(items))
            }
            this.jsonSkipWs()
            def c:string (this.jsonPeek())
            if (c == ",") {
                jsonPos = (jsonPos + 1)
                ; `[1,]` is not JSON: a comma must be followed by a value.
                this.jsonSkipWs()
                if ((this.jsonPeek()) == "]") {
                    this.jsonFail("Unexpected token ] in JSON")
                    return (EvValueBridge.taggedArray(items))
                }
            } {
                if (c == "]") {
                    jsonPos = (jsonPos + 1)
                    looping = false
                } {
                    this.jsonFail("Expected ',' or ']' in JSON array")
                    return (EvValueBridge.taggedArray(items))
                }
            }
        }
        return (EvValueBridge.taggedArray(items))
    }
    fn jsonParseObject:EvHandle () {
        def ks:[string]
        def vs:[EvHandle]
        jsonPos = (jsonPos + 1)
        this.jsonSkipWs()
        if ((this.jsonPeek()) == "}") {
            jsonPos = (jsonPos + 1)
            return (EvValueBridge.taggedObject(ks vs))
        }
        def looping:boolean true
        while (looping) {
            this.jsonSkipWs()
            ; A member name is a STRING. `{a: 1}` is JavaScript, not JSON.
            if ((this.jsonPeek()) != "\"") {
                this.jsonFail("Expected property name in JSON")
                return (EvValueBridge.taggedObject(ks vs))
            }
            def key:string (this.jsonParseString())
            if jsonFailed {
                return (EvValueBridge.taggedObject(ks vs))
            }
            this.jsonSkipWs()
            if ((this.jsonPeek()) != ":") {
                this.jsonFail("Expected ':' in JSON object")
                return (EvValueBridge.taggedObject(ks vs))
            }
            jsonPos = (jsonPos + 1)
            def val:EvHandle (this.jsonParseValue())
            if jsonFailed {
                return (EvValueBridge.taggedObject(ks vs))
            }
            push ks key
            push vs val
            this.jsonSkipWs()
            def c:string (this.jsonPeek())
            if (c == ",") {
                jsonPos = (jsonPos + 1)
                this.jsonSkipWs()
                if ((this.jsonPeek()) == "}") {
                    this.jsonFail("Unexpected token } in JSON")
                    return (EvValueBridge.taggedObject(ks vs))
                }
            } {
                if (c == "}") {
                    jsonPos = (jsonPos + 1)
                    looping = false
                } {
                    this.jsonFail("Expected ',' or '}' in JSON object")
                    return (EvValueBridge.taggedObject(ks vs))
                }
            }
        }
        def obj:EvHandle (EvValueBridge.taggedObject(ks vs))
        obj.setProto((this.builtinPrototype("Object")))
        return obj
    }
    ; §22.2.6.8 step 8a and its siblings: the `unicode` flag as the @@ methods
    ; read it -- off the RECEIVER with a full [[Get]], because they are generic
    ; over any object with the right shape, not only over a real RegExp.
    fn regExpFullUnicode:boolean (R:EvHandle) {
        def uv:EvHandle (this.getPropertyValue(R "unicode"))
        if scriptThrew { return false }
        return (uv.toBool())
    }

    ; §22.2.7.3 AdvanceStringIndex, for the scan loops that step past an EMPTY
    ; match so they cannot stall. One code unit ordinarily; under the `u` flag a
    ; surrogate pair is one position, so the cursor never lands between halves.
    fn advanceStringIndex:int (s:string pos:int uni:boolean) {
        if (uni == false) { return (pos + 1) }
        def hi:int (this.cuUnitAt(s pos))
        if ((hi < 55296) || (hi > 56319)) { return (pos + 1) }
        def lo:int (this.cuUnitAt(s (pos + 1)))
        if ((lo < 56320) || (lo > 57343)) { return (pos + 1) }
        return (pos + 2)
    }

    ; How many indices `substring` recognises in `s` -- code POINTS where the
    ; target stores bytes, and its own units otherwise. This is the measure any
    ; scanner that steps with `substring` has to use for its end test.
    fn substringUnitsOf:int (s:string) {
        if (this.unitsAreBytes()) {
            return (array_length (this.codePointsOf(s)))
        }
        return (strlen s)
    }

    fn jsonParse:EvHandle (src:string) {
        jsonSrc = src
        jsonLen = (this.substringUnitsOf(src))
        jsonPos = 0
        jsonFailed = false
        jsonError = ""
        def v:EvHandle (this.jsonParseValue())
        if (false == jsonFailed) {
            ; Nothing but whitespace may follow the top-level value: `1 2` and
            ; `{} garbage` are both errors, and running off the end of the text
            ; was the parser's only previous notion of "done".
            this.jsonSkipWs()
            if (jsonPos < jsonLen) {
                this.jsonFail("Unexpected non-whitespace character after JSON")
            }
        }
        if jsonFailed {
            return (this.throwSpecError("SyntaxError" jsonError))
        }
        return v
    }

    ; D-JSONOPTS: JSON.parse's second argument, §24.3.1.1. The reviver visits
    ; every value bottom-up, and what it answers REPLACES that value --
    ; answering undefined deletes the property outright. It was accepted and
    ; ignored, so `JSON.parse(t, f)` was indistinguishable from `JSON.parse(t)`.
    fn jsonReviveWalk:EvHandle (holder:EvHandle key:string reviver:EvHandle) {
        def val:EvHandle (this.getPropertyValue(holder key))
        if scriptThrew { return (EvValueBridge.taggedUndefined()) }
        if (val.isArrayValue()) {
            ; An element the reviver drops becomes a HOLE, which is what
            ; deleting an index leaves behind -- the array does not shorten.
            def revived:[EvHandle]
            def ai:int 0
            def alen:int (val.denseLen())
            while (ai < alen) {
                def newEl:EvHandle (this.jsonReviveWalk(val (to_string ai) reviver))
                if scriptThrew { return (EvValueBridge.taggedUndefined()) }
                if (newEl.isUndefined()) {
                    push revived (EvValueBridge.taggedHole())
                } {
                    push revived newEl
                }
                ai = (ai + 1)
            }
            val.arrSetItems(revived)
        } {
            if (this.isDescriptorObject(val)) {
                def oks:[string] (this.objectKeys(val))
                def oi:int 0
                while (oi < (array_length oks)) {
                    def ok:string (itemAt oks oi)
                    def newV:EvHandle (this.jsonReviveWalk(val ok reviver))
                    if scriptThrew { return (EvValueBridge.taggedUndefined()) }
                    if (newV.isUndefined()) {
                        val.removeOwnData(ok)
                    } {
                        val.setMember(ok newV)
                    }
                    oi = (oi + 1)
                }
            }
        }
        def rArgs:[EvHandle]
        push rArgs (EvValueBridge.taggedString(key))
        push rArgs val
        return (this.callFnValueWithValues((reviver.withThisForCall(holder)) rArgs))
    }

    ; JSON.parse(text, reviver) -- the whole static, so the AST call site and
    ; the value path can share one implementation.
    fn jsonParseWith:EvHandle (text:string reviver:EvHandle) {
        def v:EvHandle (this.jsonParse(text))
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        if (false == (reviver.isFunction())) {
            return v
        }
        def rk:[string]
        def rv:[EvHandle]
        def root:EvHandle (EvValueBridge.taggedObject(rk rv))
        root.setProto((this.builtinPrototype("Object")))
        root.setMember("" v)
        return (this.jsonReviveWalk(root "" reviver))
    }

    fn evaluateObjectExpr:EvHandle (node:TSNode) {
        def keys:[string]
        def values:[EvHandle]
        ; D-ACCESSORS: `get x() {}` / `set x(v) {}` in an object literal are
        ; collected separately and attached after the object exists, since the
        ; accessor maps live on the value rather than in the key/value lists.
        def accKeys:[string]
        def accFns:[EvHandle]
        def accKinds:[string]
        ; D-PROTOLIT: `{__proto__: p}` names the prototype, not a property.
        def protoFromLit:EvHandle (EvValueBridge.taggedNull())
        def hasProtoLit:boolean false

        def i:int 0
        while (i < (array_length node.children)) {
            def prop:TSNode (itemAt node.children i)
            if (prop.nodeType == "Property") {
                def key:string prop.name
                ; A NUMERIC key's property name is ToString of its VALUE, not
                ; the source text: `{1.0: v}` is the property "1" and
                ; `{1e21: v}` is "1e+21". The raw text was used, so both keyed
                ; under a name no numeric lookup could ever produce.
                if prop.numericKey {
                    key = (this.toStringOf((EvValueBridge.taggedNumber((this.stringToNumber(key))))))
                }
                ; `{ [expr]: v }` -- the parser leaves `name` empty and puts the
                ; key expression on `right`. Reading `name` regardless built the
                ; object with an EMPTY key, so `{[k]:1}` answered `{"":1}` and
                ; `o.x` read undefined. ToPropertyKey is ToString here, which is
                ; what every other key path in this function already assumes.
                if prop.computed {
                    if prop.right {
                        def keyNode:TSNode (unwrap prop.right)
                        def keyVal:EvHandle (this.evaluateExpr(keyNode))
                        ; ToPropertyKey, not ToString: a SYMBOL computed key
                        ; stands for itself, and stringifying it made
                        ; `{[sym]: v}` an ordinary "Symbol(k)" property.
                        key = (this.toPropertyKey(keyVal))
                    }
                }
                ; The parser tags an object-literal accessor on `kind`
                ; (get/set/init); `accessor` carries the same idea for a CLASS
                ; member. Accept either so both forms are handled.
                def akind:string prop.kind
                if ((strlen prop.accessor) > 0) {
                    akind = prop.accessor
                }
                if ((akind == "get") || (akind == "set")) {
                    if prop.left {
                        def afn:EvHandle (this.captureClosure((unwrap prop.left)))
                        ; D-FNNAME: an accessor is named for its KIND -- the
                        ; getter for `g` is "get g" -- and is not a constructor.
                        afn.addSuppressed("prototype")
                        afn.setAttrs("name" true false true)
                        afn.setMember("name" (EvValueBridge.taggedString((akind + (" " + (this.functionNameForKey(key)))))))
                        afn.setAttrs("name" false false true)
                        push accKeys key
                        push accFns afn
                        push accKinds akind
                    }
                } {
                    ; D-PROTOLIT: `{__proto__: p}` SETS the prototype rather than
                    ; defining a property. It was an ordinary key, so the object
                    ; inherited nothing and carried a stray own property.
                    if ((key == "__proto__") && (false == prop.computed)) {
                        if prop.left {
                            protoFromLit = (this.evaluateExpr((unwrap prop.left)))
                            hasProtoLit = true
                        }
                    } {
                    push keys key
                    if prop.left {
                        def valueNode:TSNode (unwrap prop.left)
                        def pv:EvHandle (this.evaluateExpr(valueNode))
                        ; D-FNNAME: a method shorthand and an anonymous function
                        ; value both take the property's name -- `{m(){}}.m.name`
                        ; is "m". A method is additionally not a constructor.
                        if (prop.method) {
                            pv.addSuppressed("prototype")
                        }
                        this.nameFunctionFromKey(pv key)
                        push values pv
                    } {
                        push values (EvValueBridge.taggedNull())
                    }
                    }
                }
            }
            ; Object-literal spread: {...o, k: v} copies o's own keys first.
            if (prop.nodeType == "SpreadElement") {
                def sv:EvHandle (EvValueBridge.taggedNull())
                if prop.left {
                    sv = (this.evaluateExpr((unwrap prop.left)))
                }
                if (sv.isObject()) {
                    def sks:[string] (this.objectKeys(sv))
                    def si:int 0
                    while (si < (array_length sks)) {
                        def sk:string (itemAt sks si)
                        push keys sk
                        ; D-PROXY: the value is read through the property path,
                        ; not off the map. objectKeys above already asks the
                        ; ownKeys trap, but the raw member read skipped `get`
                        ; entirely -- so `{...p}` over a proxy listed the right
                        ; keys and copied nothing for them.
                        push values (this.getPropertyValue(sv sk))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                        si = (si + 1)
                    }
                }
            }
            i = i + 1
        }

        def built:EvHandle (EvValueBridge.taggedObject(keys values))
        ; D-PROTO: an object literal inherits from Object.prototype. Without the
        ; link a plain object had no toString, hasOwnProperty or valueOf to
        ; inherit at all, so a guest override of one of them was invisible and
        ; ToPrimitive could not find the default either.
        built.setProto((this.builtinPrototype("Object")))
        ; A `__proto__` key in the literal replaces that link. `null` means no
        ; prototype at all; anything that is not an object is ignored outright.
        if hasProtoLit {
            if (protoFromLit.isObject()) {
                built.setProto(protoFromLit)
            }
        }
        def ai:int 0
        while (ai < (array_length accKeys)) {
            def ak:string (itemAt accKeys ai)
            def af:EvHandle (itemAt accFns ai)
            def akd:string (itemAt accKinds ai)
            if (akd == "get") {
                built.defineGetter(ak af)
            } {
                built.defineSetter(ak af)
            }
            ai = (ai + 1)
        }
        return built
    }

    ; ==========================================================================
    ; Utility Functions
    ; ==========================================================================
    
    fn trimText:string (text:string) {
        ; Simple trim - remove leading/trailing whitespace
        def result:string ""
        def started:boolean false
        def i:int 0
        def len:int (strlen text)
        
        while (i < len) {
            def c:int (charAt text i)
            def isWhitespace:boolean ((c == 32) || (c == 9) || (c == 10) || (c == 13))
            
            if started {
                result = result + (strfromcode c)
            } {
                if (isWhitespace == false) {
                    started = true
                    result = (strfromcode c)
                }
            }
            i = i + 1
        }
        
        ; Trim trailing
        def trimLen:int (strlen result)
        while (trimLen > 0) {
            def lastC:int (charAt result (trimLen - 1))
            if ((lastC == 32) || (lastC == 9) || (lastC == 10) || (lastC == 13)) {
                result = (substring result 0 (trimLen - 1))
                trimLen = trimLen - 1
            } {
                trimLen = 0
            }
        }
        
        return result
    }
    
    fn normalizeWhitespace:string (text:string) {
        ; Convert newlines/tabs to spaces and collapse multiple spaces to single space
        def result:string ""
        def lastWasSpace:boolean false
        def i:int 0
        def len:int (strlen text)
        
        while (i < len) {
            def c:int (charAt text i)
            def isWhitespace:boolean ((c == 32) || (c == 9) || (c == 10) || (c == 13))
            
            if isWhitespace {
                if (lastWasSpace == false) {
                    result = result + " "
                    lastWasSpace = true
                }
            } {
                result = result + (strfromcode c)
                lastWasSpace = false
            }
            i = i + 1
        }
        
        return result
    }
    
    ; Check if a string starts with punctuation that should attach to previous word
    fn startsWithPunctuation:boolean (s:string) {
        if ((strlen s) == 0) {
            return false
        }
        def first:int (charAt s 0)
        ; Common punctuation: , . ! ? : ; ) ] } ' " -
        if ((first == 44) || (first == 46) || (first == 33) || (first == 63) || (first == 58) || (first == 59)) {
            return true
        }
        ; ) ] }
        if ((first == 41) || (first == 93) || (first == 125)) {
            return true
        }
        ; ' " -
        if ((first == 39) || (first == 34) || (first == 45)) {
            return true
        }
        return false
    }
    
    ; Check if a string ends with punctuation that should attach to next word
    fn endsWithOpenPunctuation:boolean (s:string) {
        def len:int (strlen s)
        if (len == 0) {
            return false
        }
        def last:int (charAt s (len - 1))
        ; ( [ { ' " -
        if ((last == 40) || (last == 91) || (last == 123) || (last == 45)) {
            return true
        }
        return false
    }
    
    ; Smart join two text fragments, handling punctuation properly
    fn smartJoinText:string (existing:string newText:string) {
        if ((strlen existing) == 0) {
            return newText
        }
        if ((strlen newText) == 0) {
            return existing
        }
        ; Don't add space if new text starts with punctuation
        if (this.startsWithPunctuation(newText)) {
            return existing + newText
        }
        ; Don't add space if existing text ends with opening punctuation
        if (this.endsWithOpenPunctuation(existing)) {
            return existing + newText
        }
        ; Otherwise add space between
        return existing + " " + newText
    }
    
    fn unquote:string (s:string) {
        def len:int (strlen s)
        if (len < 2) {
            return s
        }
        def first:int (charAt s 0)
        def last:int (charAt s (len - 1))
        if (((first == 34) || (first == 39)) && (first == last)) {
            return (substring s 1 (len - 1))
        }
        return s
    }
    
    ; Evaluates ${...} template expressions within a template literal string
    ; Parses the string, finds ${...} patterns, evaluates them, and returns the result
    fn evaluateTemplateExpressions:string (templateStr:string) {
        def result:string ""
        def len:int (strlen templateStr)
        def i:int 0
        
        while (i < len) {
            ; A substitution that threw abandons the rest of the literal --
            ; the later ones are never evaluated.
            if scriptThrew { return result }
            def ch:string (at templateStr i)

            ; `\$` is an ESCAPED dollar: it contributes a literal `$` and the
            ; `{` after it is ordinary text, not the start of a substitution.
            ; The lexer leaves this one escape undecoded precisely so the two
            ; are still distinguishable here -- decoded earlier, `\${x}` read
            ; as a substitution and evaluated x.
            if (ch == "\\") {
                if ((i + 1) < len) {
                    if ((at templateStr (i + 1)) == "$") {
                        result = (result + "$")
                        i = (i + 2)
                        continue
                    }
                }
            }

            ; Check for ${...} pattern
            if (ch == "$") {
                if ((i + 1) < len) {
                    def nextCh:string (at templateStr (i + 1))
                    if (nextCh == "{") {
                        ; Found ${, now find the matching }
                        def exprStart:int (i + 2)
                        def braceDepth:int 1
                        def j:int exprStart
                        
                        while ((j < len) && (braceDepth > 0)) {
                            def c:string (at templateStr j)
                            if (c == "{") {
                                braceDepth = braceDepth + 1
                            }
                            if (c == "}") {
                                braceDepth = braceDepth - 1
                            }
                            if (braceDepth > 0) {
                                j = j + 1
                            }
                        }
                        
                        if (braceDepth == 0) {
                            ; Extract the expression
                            def exprStr:string (substring templateStr exprStart j)

                            ; Parse and evaluate the expression
                            def exprValue:string (this.evaluateTemplateExpression(exprStr))
                            result = result + exprValue
                            
                            ; Move past the closing }
                            i = j + 1
                        } {
                            ; No matching }, treat as literal
                            result = result + ch
                            i = i + 1
                        }
                    } {
                        ; Just a $ without {
                        result = result + ch
                        i = i + 1
                    }
                } {
                    ; $ at end of string
                    result = result + ch
                    i = i + 1
                }
            } {
                ; Regular character
                result = result + ch
                i = i + 1
            }
        }
        
        return result
    }
    
    ; Evaluates a single template expression string like "img.gps.latitude"
    ; D-TAGGED: split a template's text at its `${...}` boundaries. `wantParts`
    ; asks for the LITERAL segments; otherwise the interpolation SOURCES. The
    ; two lists are always one apart in length, which is the invariant a tag
    ; function relies on.
    fn splitTemplateText:[string] (text:string wantParts:boolean) {
        def out:[string]
        def cur:string ""
        def n:int (strlen text)
        def i:int 0
        while (i < n) {
            def ch:string (substring text i (i + 1))
            def opened:boolean false
            if (ch == "$") {
                if ((i + 1) < n) {
                    if ((substring text (i + 1) (i + 2)) == "{") {
                        opened = true
                    }
                }
            }
            if opened {
                if wantParts {
                    push out cur
                }
                cur = ""
                def depth:int 1
                def j:int (i + 2)
                def esrc:string ""
                while ((j < n) && (depth > 0)) {
                    def c:string (substring text j (j + 1))
                    if (c == "{") { depth = (depth + 1) }
                    if (c == "}") { depth = (depth - 1) }
                    if (depth > 0) {
                        esrc = (esrc + c)
                        j = (j + 1)
                    }
                }
                if (false == wantParts) {
                    push out esrc
                }
                i = (j + 1)
            } {
                cur = (cur + ch)
                i = (i + 1)
            }
        }
        if wantParts {
            push out cur
        }
        return out
    }

    ; The cooked and raw text of a TemplateLiteral node, as the parser left them.
    fn templateTextOf:string (quasiNode:TSNode wantRaw:boolean) {
        def out:string ""
        def i:int 0
        while (i < (array_length quasiNode.children)) {
            def el:TSNode (itemAt quasiNode.children i)
            if (el.nodeType == "TemplateElement") {
                if wantRaw {
                    out = (out + el.name)
                } {
                    out = (out + el.value)
                }
            }
            i = (i + 1)
        }
        return out
    }

    fn evaluateTaggedTemplate:EvHandle (node:TSNode) {
        if (null? node.left) { return (EvValueBridge.taggedUndefined()) }
        if (null? node.right) { return (EvValueBridge.taggedUndefined()) }
        def quasiNode:TSNode (unwrap node.right)
        ; §13.2.8.4 GetTemplateObject: one object per call SITE, reused on every
        ; evaluation. A fresh one each time is observably different -- a tag
        ; that memoises on `strings` (which is why the object is specified to be
        ; stable) re-parsed its template on every call and never hit its cache.
        def tplKey:string ((to_string currentSrcId) + (":" + (to_string quasiNode.start)))
        def cachedTpl@(optional):EvHandle (get templateObjCache tplKey)
        def cooked:string (this.templateTextOf(quasiNode false))
        def rawSrc:string (this.templateTextOf(quasiNode true))
        def cookedParts:[string] (this.splitTemplateText(cooked true))
        def rawParts:[string] (this.splitTemplateText(rawSrc true))
        def exprSrcs:[string] (this.splitTemplateText(cooked false))
        ; The strings object: an array of the cooked parts carrying `raw`.
        def cookedItems:[EvHandle]
        def ci:int 0
        while (ci < (array_length cookedParts)) {
            push cookedItems (EvValueBridge.taggedString((itemAt cookedParts ci)))
            ci = (ci + 1)
        }
        def rawItems:[EvHandle]
        def rj:int 0
        while (rj < (array_length rawParts)) {
            push rawItems (EvValueBridge.taggedString((itemAt rawParts rj)))
            rj = (rj + 1)
        }
        ; A raw list that came out a different length than the cooked one would
        ; break the invariant; fall back to the cooked text, which is what an
        ; escape-free template gives anyway.
        if ((array_length rawItems) != (array_length cookedItems)) {
            rawItems = cookedItems
        }
        def strings:EvHandle (EvValueBridge.taggedArray(cookedItems))
        def rawArr:EvHandle (EvValueBridge.taggedArray(rawItems))
        ; Both halves are FROZEN: the strings object is handed to guest code,
        ; and the spec makes it immutable so one tag cannot corrupt what the
        ; next call at the same site sees -- which matters precisely because
        ; the object is now shared across calls.
        rawArr.markAllNonConfigurable(true)
        rawArr.setFrozenObj(true)
        rawArr.setSealedObj(true)
        rawArr.setExtensible(false)
        strings.setMember("raw" rawArr)
        strings.markAllNonConfigurable(true)
        strings.setFrozenObj(true)
        strings.setSealedObj(true)
        strings.setExtensible(false)
        if cachedTpl {
            strings = (unwrap cachedTpl)
        } {
            set templateObjCache tplKey strings
        }
        def callArgs:[EvHandle]
        push callArgs strings
        def ei:int 0
        while (ei < (array_length exprSrcs)) {
            push callArgs (this.evaluateTemplateExprValue((itemAt exprSrcs ei)))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            ei = (ei + 1)
        }
        def tagV:EvHandle (this.evaluateExpr((unwrap node.left)))
        if scriptThrew {
            return (EvValueBridge.taggedUndefined())
        }
        if (false == (tagV.isFunction())) {
            return (this.throwSpecError("TypeError" "Tag is not a function"))
        }
        return (this.callFnValueWithValues(tagV callArgs))
    }

    ; The VALUE of one `${...}` source. evaluateTemplateExpression answers the
    ; string form, which is what interpolation needs and what a tag function
    ; must not be handed.
    fn evaluateTemplateExprValue:EvHandle (exprStr:string) {
        def lexerT:TSLexer (new TSLexer(exprStr))
        def tokensT:[Token] (lexerT.tokenize())
        def parserT:TSParserSimple (new TSParserSimple())
        parserT.initParser(tokensT)
        def astT:TSNode (parserT.parseProgram())
        if ((array_length astT.children) > 0) {
            def stmtT:TSNode (itemAt astT.children 0)
            if ((this.nodeKindOf(stmtT)) == 30) {
                if stmtT.left {
                    return (this.evaluateExpr((unwrap stmtT.left)))
                }
            }
            return (this.evaluateExpr(stmtT))
        }
        return (EvValueBridge.taggedUndefined())
    }

    fn evaluateTemplateExpression:string (exprStr:string) {
        ; Tokenize and parse the expression using the TypeScript parser
        def lexer:TSLexer (new TSLexer(exprStr))
        def tokens:[Token] (lexer.tokenize())
        def parser:TSParserSimple (new TSParserSimple())
        parser.initParser(tokens)
        def ast:TSNode (parser.parseProgram())

        ; The AST should have a Program with one ExpressionStatement
        if ((array_length ast.children) > 0) {
            def stmt:TSNode (itemAt ast.children 0)
            if ((this.nodeKindOf(stmt)) == 30) {
                if stmt.left {
                    def exprNode:TSNode (unwrap stmt.left)
                    def value:EvHandle (this.evaluateExpr(exprNode))
                    ; A substitution is rendered by ToString, not by the
                    ; engine's debug form: `${{}}` is "[object Object]" and an
                    ; object's own `toString` is what decides. The debug form
                    ; printed "{}" and never consulted the object.
                    if scriptThrew { return "" }
                    return (this.toStringOf(value))
                }
            }
            ; Try direct expression evaluation
            def value:EvHandle (this.evaluateExpr(stmt))
            if scriptThrew { return "" }
            return (this.toStringOf(value))
        }

        ; Fallback: return the original expression
        return ("${" + exprStr + "}")
    }
    
    ; Set print settings from Print element props
    fn setPrintSettings:void (format:string orientation:string width:double height:double) {
        printFormat = format
        printOrientation = orientation
        pageWidth = width
        pageHeight = height
        print "Print settings updated: " + format + " " + orientation + " " + (to_string width) + "x" + (to_string height)
    }
    
    ; Set print margins
    fn setPrintMargins:void (top:double right:double bottom:double left:double) {
        printMarginTop = top
        printMarginRight = right
        printMarginBottom = bottom
        printMarginLeft = left
    }
}

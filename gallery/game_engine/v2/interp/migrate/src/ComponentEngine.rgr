    fn isRegexValue:boolean (v:EvalValue) {
        if (v.valueType != 5) {
            return false
        }
        return (has v.objectMap "__regex__")
    }

    fn regexFlagsOf:string (v:EvalValue) {
        def f:EvalValue (v.getMember("flags"))
        if (f.isString()) {
            return f.stringValue

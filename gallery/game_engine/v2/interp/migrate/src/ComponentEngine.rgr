                            bcThis = (this.theGlobalObject())
                        } {
                            if (bcThis.isString()) { bcThis = (this.toObjectValue(bcThis)) }
                            if (bcThis.isNumber()) { bcThis = (this.toObjectValue(bcThis)) }
                            if (bcThis.isBoolean()) { bcThis = (this.toObjectValue(bcThis)) }
                        }
                    } {
                        if ((this.nodeKindOf(fnNode)) != 17) {
                            bcThis = (this.theGlobalObject())
                        }
                    }
                    ; place the handle arguments into the callee's param
                    ; slots (unboxing numbers/booleans on the way), then run
                    ; and box the result lanes once for this walker caller
                    def bcBase:int bcSp
                    def bcArgc:int (array_length argVals)
                    if (bcArgc > bcProg.paramCount) {
                        bcArgc = bcProg.paramCount
                    }
                    this.bcGrowTo((bcBase + bcArgc))
                    def bcAi:int 0
                    while (bcAi < bcArgc) {
                        this.bcSlotPut((bcBase + bcAi) (itemAt argVals bcAi))
                        bcAi = (bcAi + 1)
                    }
                    callDepth = (callDepth + 1)
                    this.runBytecode(bcProg bcArgc (unwrap parent) bcThis)
                    callDepth = (callDepth - 1)
                    currentModule = savedModule
                    scriptDidReturn = savedDidReturn
                    scriptReturnValue = savedReturnValue
                    return (this.bcRetBox())
                }
            }
        }
        ; Pooled frame: closureScopes length is the capture gate (see ctxPool).
        def framePoolMark:int (array_length closureScopes)
        context = (this.acquireFrame((unwrap parent)))
        def myFrame:EvalContext context
        ; PERF: binding `this` is a map insert on every call, and most bodies
        ; never read it. The memoised scan proves nothing in this function's
        ; lexical this-scope (arrows included, `super`/`eval` conservatively)
        ; can observe the binding, so an unread one is simply not written.
        def bindThisV:boolean (this.fnNeedsThis(fnNode))
        if (fnValue.hasBoundThis()) {
            ; D-THISCOERCE: a SLOPPY function called with no receiver -- or with
            ; null/undefined through call/apply -- gets the GLOBAL OBJECT, and a
            ; primitive receiver is boxed. A strict one keeps exactly what it was
            ; given. `Function("this.field = 1").apply()` turns on this rule.
            def rawThis:EvHandle (fnValue.boundThisOf())
            ; D-STRICT: whose strictness decides is the CALLEE's, and it was
            ; stamped on the value when the function was created. Asking
            ; strictForBody here folds in the ambient flag -- the CALLER's -- so
            ; a sloppy function called from strict code kept an undefined
            ; `this`, which is exactly what `"use strict";
            ; Function("return typeof this")()` reports.
            def calleeStrict:boolean (fnValue.strictFnOf())
            if (this.bodyOnlyStrict(fnNode)) {
                calleeStrict = true
            }
            if (false == calleeStrict) {
                if ((rawThis.isNull()) || (rawThis.isUndefined())) {
                    rawThis = (this.theGlobalObject())
                } {
                    if (rawThis.isString()) { rawThis = (this.toObjectValue(rawThis)) }
                    if (rawThis.isNumber()) { rawThis = (this.toObjectValue(rawThis)) }
                    if (rawThis.isBoolean()) { rawThis = (this.toObjectValue(rawThis)) }
                }
            }
            if bindThisV {
                context.define("this" rawThis)
            }
        } {
            ; D-THISCOERCE: a bare `f()` supplies no receiver at all, which is
            ; the undefined case -- so a SLOPPY callee still gets the global
            ; object. Leaving `this` unbound let it resolve up the scope chain
            ; to whatever the DEFINING scope had, which is not the same thing.
            ; An ARROW takes `this` lexically and must not be given one here --
            ; binding the global object would shadow the enclosing `this`.
            def bareStrict:boolean (fnValue.strictFnOf())
            if (this.bodyOnlyStrict(fnNode)) {
                bareStrict = true
            }
            if ((this.nodeKindOf(fnNode)) == 17) {
                bareStrict = true
            }
            if (false == bareStrict) {
                if bindThisV {
                    context.define("this" (this.theGlobalObject()))
                }
            } {
                ; A STRICT callee called bare has `this` UNDEFINED. Leaving it
                ; unbound let the name resolve up the scope chain to whatever
                ; the enclosing function had, so a strict function nested in a
                ; sloppy one saw the sloppy one's global object. An arrow is the
                ; exception: it genuinely has no `this` of its own.
                if ((this.nodeKindOf(fnNode)) != 17) {
                    if bindThisV {
                        context.define("this" (EvValueBridge.taggedUndefined()))
                    }
                }
            }
        }
        ; D-FNPROTO: arguments fixed by bind() come first, then the call site's.
        def effArgs:[EvHandle] argVals
        if ((fnValue.boundArgCount()) > 0) {
            def merged:[EvHandle]
            def bi:int 0
            while (bi < (fnValue.boundArgCount())) {
                push merged (fnValue.boundArgAt(bi))
                bi = (bi + 1)
            }
            def ci2:int 0
            while (ci2 < (array_length argVals)) {
                push merged (itemAt argVals ci2)
                ci2 = (ci2 + 1)
            }
            effArgs = merged
        }
        pendingCallee = fnValue
        pendingCalleeValid = true
        this.bindParams(fnNode effArgs)
        pendingCalleeValid = false
        ; D-STRICT: the function's OWN strictness governs the code it runs. It
        ; was taken from the body directive plus the ambient flag, so a strict
        ; callback handed to a sloppy helper -- which is exactly what
        ; assert.throws does -- ran sloppy.
        def savedStrict:boolean strictMode
        ; The function's LEXICAL strictness was stamped on the value when the
        ; closure was captured, so the ambient flag must not be folded in again:
        ; a function built by the Function constructor inside strict code is
        ; sloppy, and calling it from that strict code has to run it sloppy.
        strictMode = (this.bodyOnlyStrict(fnNode))
        if (fnValue.strictFnOf()) {
            strictMode = true
        }
        callDepth = (callDepth + 1)
        ; D-FNSRC: the code about to run came from this function's source, so a
        ; function IT defines belongs to the same string. Without the swap a
        ; closure returned by an eval'd factory would slice the main script.
        ; PERF: the ids say when the swap is a no-op -- the common case, since
        ; almost every callee was captured from the text already in effect --
        ; and a no-op swap otherwise copied the whole script three times.
        def savedSrcText:string ""
        def savedSrcId:int currentSrcId
        def srcSwapped:boolean false
        if (fnValue.hasSrcText()) {
            if ((fnValue.srcIdOf()) != currentSrcId) {
                savedSrcText = currentSource
                currentSource = (fnValue.srcTextOf())
                currentSrcId = (fnValue.srcIdOf())
                srcSwapped = true
            }
        }
        ; D-NEWTARGET: this frame's [[NewTarget]] -- whatever a construct site
        ; parked, or undefined for an ordinary call. Consumed here so the next
        ; call does not inherit it.
        def savedDerivedPV:boolean derivedCtorPending
        if pendingDerivedCtor {
            derivedCtorPending = true
            pendingDerivedCtor = false
        } {
            if ((this.nodeKindOf(fnNode)) != 17) {
                derivedCtorPending = false
            }
        }
        def savedNewTargetV:EvHandle currentNewTarget
        if hasPendingNewTarget {
            currentNewTarget = pendingNewTarget
            hasPendingNewTarget = false
        } {
            currentNewTarget = (EvValueBridge.taggedUndefined())
        }
        def result:EvHandle (EvValueBridge.taggedNull())
        ; D-GENRESUME: a generator call runs NOTHING. The activation just
        ; prepared -- parameters bound, `this` in place -- becomes the
        ; generator's own live scope, and the first next() starts the body on
        ; the resumable driver. The frame is deliberately NOT returned to the
        ; pool below: the generator outlives this call.
        ; D-ASYNC: an async call runs its body on the resumable driver and
        ; answers a PROMISE. Like the generator case the activation just
        ; prepared becomes the body's live scope, so the frame is not returned
        ; to the pool -- the suspended body outlives this call.
        def isAsyncCall:boolean false
        if fnNode.async {
            if (false == fnNode.generator) { isAsyncCall = true }
        }
        if isAsyncCall {
            def asyncCtx@(optional):EvalContext context
            def asyncRes:EvHandle (this.callAsyncBody(fnNode (unwrap asyncCtx)))
            if srcSwapped {
                currentSource = savedSrcText
                currentSrcId = savedSrcId
            }
            strictMode = savedStrict
            currentNewTarget = savedNewTargetV
            derivedCtorPending = savedDerivedPV
            callDepth = (callDepth - 1)
            context = savedContext
            currentModule = savedModule
            scriptDidReturn = savedDidReturn
            scriptReturnValue = savedReturnValue
            return asyncRes
        }
        def isGenCall:boolean fnNode.generator
        if isGenCall {
            if (this.genBodyResumable(fnNode)) {
                def genCtx@(optional):EvalContext context
                def genProtoV:EvHandle (fnValue.getMember("prototype"))
                def genv:EvHandle (this.makeResumableGeneratorOn(fnNode (unwrap genCtx) genProtoV))
                if srcSwapped {
                    def gst:GenState (this.genStateOf(genv))
                    gst.srcText = currentSource
                    gst.srcId = currentSrcId
                    gst.hasSrc = true
                    currentSource = savedSrcText
                    currentSrcId = savedSrcId
                }
                strictMode = savedStrict
                currentNewTarget = savedNewTargetV
                derivedCtorPending = savedDerivedPV
                callDepth = (callDepth - 1)
                context = savedContext
                currentModule = savedModule
                scriptDidReturn = savedDidReturn
                scriptReturnValue = savedReturnValue
                return genv
            }
        }
        ; The FALLBACK, for a body whose yield spine the driver cannot step:
        ; run it now and buffer the yields. See makeGeneratorValue.
        def savedGenCollect:[EvHandle] genCollect
        def savedGenDepth:int genDepth
        if isGenCall {
            def freshCollect:[EvHandle]
            genCollect = freshCollect
            genDepth = (genDepth + 1)
        }
        if fnNode.body {
            def body:TSNode (unwrap fnNode.body)
            if ((this.nodeKindOf(body)) == 34) {
                result = (this.callResultOf((this.evaluateFunctionBodyValue(body))))
            } {
                result = (this.evaluateExpr(body))
            }
        }
        if isGenCall {
            def produced:[EvHandle] genCollect
            genCollect = savedGenCollect
            genDepth = savedGenDepth
            result = (this.makeGeneratorValue(produced))
        }
        if srcSwapped {
            currentSource = savedSrcText
            currentSrcId = savedSrcId
        }
        strictMode = savedStrict
        currentNewTarget = savedNewTargetV
        derivedCtorPending = savedDerivedPV
        callDepth = (callDepth - 1)
        context = savedContext
        currentModule = savedModule
        scriptDidReturn = savedDidReturn
        scriptReturnValue = savedReturnValue
        if ((array_length closureScopes) == framePoolMark) {
            this.releaseFrame((unwrap myFrame))
        }
        return result
    }

    ; ==========================================================================
    ; JSX Evaluation
    ; ==========================================================================
    
    fn evaluateJSX:EvElement (node:TSNode) {
        def element (new EvElement())
        
        if (node.nodeType == "JSXElement") {
            return (this.evaluateJSXElement(node))
        }
        
        if (node.nodeType == "JSXFragment") {
            ; A fragment is its own KIND, not a `div`. Naming one renderer's
            ; container tag here is what made `<>...</>` render as a box that
            ; the source never asked for; a host that wants a wrapper can make
            ; one, and a host that wants the children spliced now can.
            element.isFragment = true
            this.evaluateChildren(element node)
            return element
        }
        
        if ((this.nodeKindOf(node)) == 23) {
            if node.left {
                def inner:TSNode (unwrap node.left)
                return (this.evaluateJSX(inner))
            }
        }
        
        ; Fallback: any other expression (e.g. a helper call that returns JSX,
        ; like hud() -> playHud(...)). Evaluate it and unwrap the element result.
        def val:EvHandle (this.evaluateExpr(node))
        if (val.isElement()) {
            if (val.hasElement()) {
                return (val.elementOf())
            }
        }
        
        return element
    }
    
    fn evaluateJSXElement:EvElement (jsxNode:TSNode) {
        ; Get tag name from opening element
        def tagName:string ""
        if jsxNode.left {
            def openingEl:TSNode (unwrap jsxNode.left)
            tagName = openingEl.name
        }
        
        ; Check if it's a component (not a primitive)
        if (this.isComponent(tagName)) {
            return (this.expandComponent(tagName jsxNode))
        }
        
        ; A host element. The TAG IS KEPT AS WRITTEN -- `View` stays `View`,
        ; not `div`. What a tag renders as, whether it is a text/image/path
        ; kind, and what a `Print` tag does to page geometry are all a
        ; renderer's business, and doing any of it here is what made the
        ; interpreter know one renderer's vocabulary before a document could
        ; name a tag.
        def element (new EvElement())
        element.tagName = tagName

        ; Parse attributes
        if jsxNode.left {
            def openingEl:TSNode (unwrap jsxNode.left)
            this.evaluateAttributes(element openingEl)
        }

        ; A TEXT tag's children are its text rather than elements. Which tags
        ; those are is the one piece of vocabulary that has to stay -- the JSX
        ; grammar itself does not say whether `<Label>x</Label>` means a child
        ; or a string -- so it is asked as a question a host can answer instead
        ; of being a hardcoded list of three names.
        if (this.tagHoldsText(tagName)) {
            element.isText = true
            element.textContent = (this.evaluateTextContent(jsxNode))
        } {
            ; Evaluate children
            this.evaluateChildren(element jsxNode)
        }

        return element
    }

    ; Does this tag's content read as TEXT rather than as child elements?
    ; Overridable by a host that names its text tags differently; the default
    ; answers for the tags this engine has always treated that way, so a host
    ; that says nothing keeps the old behaviour.
    fn tagHoldsText:boolean (tagName:string) {
        def i:int 0
        while (i < (array_length textTags)) {
            if ((itemAt textTags i) == tagName) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    ; Name a tag whose content is text. Additive: a host adds its own without
    ; losing the defaults.
    fn addTextTag:void (tagName:string) {
        if (this.tagHoldsText(tagName)) {
            return
        }
        push textTags tagName
    }
    
    fn isComponent:boolean (name:string) {
        if ((strlen name) == 0) {
            return false
        }
        
        ; Check if it's a primitive
        def i:int 0
        while (i < (array_length primitives)) {
            if ((itemAt primitives i) == name) {
                return false
            }
            i = i + 1
        }
        
        ; Check if first character is uppercase (A-Z is 65-90)
        def firstChar:int (charAt name 0)
        if ((firstChar >= 65) && (firstChar <= 90)) {
            return true
        }
        
        return false
    }
    
    fn expandComponent:EvElement (name:string jsxNode:TSNode) {
        ; Use the last registered match (hot reload upserts may leave older entries).
        def foundIdx:int -1
        def i:int 0
        while (i < (array_length localComponents)) {
            def sym:ImportedSymbol (itemAt localComponents i)
            if (sym.name == name) {
                foundIdx = i
            }
            i = i + 1
        }
        if (foundIdx >= 0) {
            def sym:ImportedSymbol (itemAt localComponents foundIdx)
            def props:EvHandle (this.evaluateProps(jsxNode))
            if sym.functionNode {
                def fnNode:TSNode (unwrap sym.functionNode)
                def hi:int 0
                while (hi < (array_length sym.helperFunctions)) {
                    def helperFn:TSNode (itemAt sym.helperFunctions hi)
                    def helperName:string helperFn.name
                    def __fnv:EvHandle (EvValueBridge.taggedFunction(helperFn))
                    __fnv.setStrictFn((this.strictForBody(helperFn)))
                    this.stampSrcOn(__fnv)
                    def helperValue:EvHandle __fnv
                    context.define(helperName helperValue)
                    print ("Registered helper function: " + helperName)
                    hi = hi + 1
                }
                return (this.evaluateFunctionWithProps(fnNode props))
            }
        }
        
        ; Not in the registry. The registry only ever held TOP-LEVEL function
        ; declarations, so every other way of writing a component was invisible
        ; to it: `const Hi = () => …`, `const Hi = function () {…}`, `let Hi =
        ; …`, and a `function Inner()` nested inside the render function. All
        ; four rendered as an empty <div> with a warning nothing reads.
        ;
        ; A component is not a special kind of declaration -- it is a FUNCTION,
        ; and the scope already knows every function by name. Looking the tag up
        ; as an ordinary value covers all four forms at once, and it goes
        ; through the normal call machinery, so a closure keeps the scope it
        ; captured (which is the whole point of `const Hi = () => …` inside
        ; another function).
        ;
        ; The registry is still consulted FIRST, above: it carries the helper
        ; functions an imported module brings with it, which a bare scope lookup
        ; has no way to know about.
        def asValue:EvHandle (context.lookup(name))
        if (asValue.isFunction()) {
            def vProps:EvHandle (this.evaluateProps(jsxNode))
            if scriptThrew {
                def threw1 (new EvElement())
                return threw1
            }
            def vArgs:[EvHandle]
            push vArgs vProps
            def vRes:EvHandle (this.callFnValueWithValues(asValue vArgs))
            if scriptThrew {
                def threw2 (new EvElement())
                return threw2
            }
            if (vRes.hasElement()) {
                return (vRes.elementOf())
            }
            ; A component that answers something other than an element -- null
            ; or false, the two conventional "render nothing" values -- becomes
            ; an empty FRAGMENT, which a host splices away rather than drawing.
            if ((vRes.isNull()) || ((vRes.isUndefined()) || (vRes.isBoolean()))) {
                def blank (new EvElement())
                blank.isFragment = true
                return blank
            }
        }

        ; Not found - return empty element
        print ("Warning: Unknown component: " + name)
        def empty (new EvElement())
        empty.tagName = "div"
        return empty
    }
    
    fn evaluateProps:EvHandle (jsxNode:TSNode) {
        def keys:[string]
        def values:[EvHandle]
        
        if jsxNode.left {
            def openingEl:TSNode (unwrap jsxNode.left)
            
            def i:int 0
            while (i < (array_length openingEl.children)) {
                def attr:TSNode (itemAt openingEl.children i)
                
                if (attr.nodeType == "JSXAttribute") {
                    def attrName:string attr.name
                    def attrValue:EvHandle (this.evaluateAttributeValue(attr))
                    
                    push keys attrName
                    push values attrValue
                }
                
                i = i + 1
            }
        }
        
        ; Also collect JSX children and add as "children" prop
        ; Only if there are children and no explicit children prop
        def hasExplicitChildren:boolean false
        def ci:int 0
        while (ci < (array_length keys)) {
            if ((itemAt keys ci) == "children") {
                hasExplicitChildren = true
            }
            ci = ci + 1
        }
        
        if (hasExplicitChildren == false) {
            def childElements:[EvHandle] (this.collectChildElements(jsxNode))
            if ((array_length childElements) > 0) {
                push keys "children"
                if ((array_length childElements) == 1) {
                    ; Single child - pass as element directly
                    push values (itemAt childElements 0)
                } {
                    ; Multiple children - pass as array
                    push values (EvValueBridge.taggedArray(childElements))
                }
            }
        }
        
        return (EvValueBridge.taggedObject(keys values))
    }
    
    ; Collect child JSX elements as EvHandle elements
    fn collectChildElements:[EvHandle] (jsxNode:TSNode) {
        def results:[EvHandle]
        
        def i:int 0
        while (i < (array_length jsxNode.children)) {
            def child:TSNode (itemAt jsxNode.children i)
            
            if (child.nodeType == "JSXElement") {
                def el:EvElement (this.evaluateJSXElement(child))
                if ((strlen el.tagName) > 0) {
                    push results (EvValueBridge.taggedElement(el))
                }
            }
            
            if (child.nodeType == "JSXText") {
                ; Only include non-whitespace text as children
                def text:string (this.trimText(child.value))
                if ((strlen text) > 0) {
                    ; Create a text element
                    def textEl (new EvElement())
                    textEl.tagName = "text"
                    textEl.textContent = text
                    push results (EvValueBridge.taggedElement(textEl))
                }
            }
            
            if (child.nodeType == "JSXExpressionContainer") {
                if child.left {
                    def exprNode:TSNode (unwrap child.left)
                    def exprValue:EvHandle (this.evaluateExpr(exprNode))
                    
                    if (exprValue.isElement()) {
                        push results exprValue
                    }
                    if (exprValue.isArrayValue()) {
                        ; Flatten array elements into children
                        def ai:int 0
                        while (ai < (exprValue.denseLen())) {
                            def arrItem:EvHandle (exprValue.arrayItemAt(ai))
                            if (arrItem.isElement()) {
                                push results arrItem
                            }
                            ai = ai + 1
                        }
                    }
                }
            }
            
            i = i + 1
        }
        
        return results
    }
    
    fn evaluateAttributeValue:EvHandle (attr:TSNode) {
        if attr.right {
            def rightNode:TSNode (unwrap attr.right)
            
            ; String literal
            if ((this.nodeKindOf(rightNode)) == 8) {
                return (EvValueBridge.taggedString((this.unquote(rightNode.value))))
            }
            
            ; Expression container
            if (rightNode.nodeType == "JSXExpressionContainer") {
                if rightNode.left {
                    def exprNode:TSNode (unwrap rightNode.left)
                    return (this.evaluateExpr(exprNode))
                }
            }
        }
        
        ; Boolean attribute (no value means true)
        return (EvValueBridge.taggedBoolean(true))
    }
    
    fn evaluateAttributes:void (element:EvElement openingNode:TSNode) {
        def i:int 0
        while (i < (array_length openingNode.children)) {
            def attr:TSNode (itemAt openingNode.children i)
            
            if (attr.nodeType == "JSXAttribute") {
                def rawAttrName:string attr.name
                def attrValue:EvHandle (this.evaluateAttributeValue(attr))
                ; The VALUE, not its text. Every attribute used to go through
                ; toString() on the way in, so `onClick={fn}` arrived as
                ; "[Function: fn]" and a number arrived as a string -- the host
                ; could not recover either. A host that wants text asks for it;
                ; one that wants the function can now have it.
                element.setProp(rawAttrName attrValue.body)
            }

            i = i + 1
        }
    }
    
    fn evaluateTextContent:string (jsxNode:TSNode) {
        def result:string ""
        
        def i:int 0
        while (i < (array_length jsxNode.children)) {
            def child:TSNode (itemAt jsxNode.children i)
            
            if (child.nodeType == "JSXText") {
                ; Get the actual text content
                def rawText:string child.value
                
                if ((strlen rawText) > 0) {
                    ; Use smart join to handle punctuation properly
                    result = (this.smartJoinText(result rawText))
                }
            }
            
            if (child.nodeType == "JSXExpressionContainer") {
                if child.left {
                    def exprNode:TSNode (unwrap child.left)
                    def exprValue:EvHandle (this.evaluateExpr(exprNode))
                    def exprStr:string (exprValue.toString())
                    
                    ; Use smart join to handle punctuation properly
                    result = (this.smartJoinText(result exprStr))
                }
            }
            
            i = i + 1
        }
        
        ; Now normalize and trim the complete text
        def normalizedText:string (this.normalizeWhitespace(result))
        def trimmedText:string (this.trimText(normalizedText))
        
        return trimmedText
    }
    
    fn evaluateChildren:void (element:EvElement jsxNode:TSNode) {
        def i:int 0
        def accumulatedText:string ""
        
        while (i < (array_length jsxNode.children)) {
            def child:TSNode (itemAt jsxNode.children i)
            
            if (child.nodeType == "JSXText") {
                ; Accumulate consecutive JSXText nodes with smart joining
                accumulatedText = (this.smartJoinText(accumulatedText child.value))
                i = i + 1
                continue
            }
            
            ; Flush accumulated text before processing other node types
            if ((strlen accumulatedText) > 0) {
                def normalizedText:string (this.normalizeWhitespace(accumulatedText))
                def text:string (this.trimText(normalizedText))
                if ((strlen text) > 0) {
                    def textEl (new EvElement())
                    textEl.tagName = "text"
                    textEl.textContent = text
                    element.addChild(textEl)
                }
                accumulatedText = ""
            }
            
            if (child.nodeType == "JSXElement") {
                this.addChildElement(element (this.evaluateJSXElement(child)))
            }
            
            if (child.nodeType == "JSXExpressionContainer") {
                this.evaluateExpressionChild(element child)
            }
            
            if (child.nodeType == "JSXFragment") {
                ; Flatten fragment children
                this.evaluateChildren(element child)
            }
            
            i = i + 1
        }
        
        ; Flush any remaining accumulated text at the end
        if ((strlen accumulatedText) > 0) {
            def normalizedText:string (this.normalizeWhitespace(accumulatedText))
            def text:string (this.trimText(normalizedText))
            if ((strlen text) > 0) {
                def textEl (new EvElement())
                textEl.tagName = "text"
                textEl.textContent = text
                element.addChild(textEl)
            }
        }
    }
    
    ; A `{ ... }` child position. The expression is EVALUATED, and whatever it
    ; produced becomes children.
    ;
    ; This used to be four hand-rolled walkers -- one that pattern-matched
    ; `.map` and re-implemented calling the callback, one for `?:`, one for
    ; `&&`, and a fallback -- each inspecting the AST instead of running it.
    ; Every one of them could only see a JSX LITERAL where an element was
    ; wanted, so anything that COMPUTED its element was silently dropped: a
    ; `function (x)` map callback (the hand-rolled binder only knew arrows), a
    ; ternary branch that called a helper, an array of arrays. They also could
    ; not be fixed one at a time, because each was a separate partial copy of
    ; the evaluator.
    ;
    ; Running the expression is all four cases at once, and it is only possible
    ; because an element is now an ordinary value: `xs.map(f)` answers an array
    ; of them, `c ? a : b` answers one, `c && a` answers one or `false`.
    fn evaluateExpressionChild:void (element:EvElement exprContainer:TSNode) {
        if exprContainer.left {
            def exprNode:TSNode (unwrap exprContainer.left)
            def value:EvHandle (this.evaluateExpr(exprNode))
            if scriptThrew {
                return
            }
            this.appendChildValue(element value)
        }
    }

    ; Append what a child expression produced. An element becomes a child, an
    ; array contributes each of its items (to any depth -- a nested list is
    ; still a list), a string or number becomes a text node, and everything
    ; else -- null, undefined, false, an object -- contributes nothing, which
    ; is what makes `{cond && <X/>}` read as "or nothing".
    fn appendChildValue:void (element:EvElement value:EvHandle) {
        if (value.isElement()) {
            if (value.hasElement()) {
                this.addChildElement(element (value.elementOf()))
            }
            return
        }
        if (value.isArrayValue()) {
            def ai:int 0
            while (ai < (value.denseLen())) {
                this.appendChildValue(element (value.arrayItemAt(ai)))
                ai = (ai + 1)
            }
            return
        }
        if ((value.isString()) || (value.isNumber())) {
            def textEl (new EvElement())
            textEl.isText = true
            textEl.textContent = (value.toString())
            element.addChild(textEl)
        }
    }

    ; A blank element -- no tag, no text, not a fragment -- is what a failed
    ; evaluation leaves behind, and appending it puts a phantom child in the
    ; tree. A FRAGMENT legitimately has no tag, so it cannot be tested for by
    ; tag alone.
    fn isRenderableElement:boolean (el:EvElement) {
        if ((strlen el.tagName) > 0) { return true }
        if el.isFragment { return true }
        if el.isText { return true }
        return false
    }

    ; Append one element as a child of another. A FRAGMENT contributes its
    ; CHILDREN rather than itself -- `<><A/><B/></>` inside a parent means two
    ; children OF that parent, which is the entire reason the syntax exists.
    ; Appending the fragment itself would leave a phantom node that every host
    ; would then have to know to skip, and dropping it (what the tag-length
    ; test below used to do, since a fragment has no tag) lost the children
    ; altogether. Recursive, so nested fragments flatten in one pass.
    fn addChildElement:void (element:EvElement childEl:EvElement) {
        if childEl.isFragment {
            def fi:int 0
            while (fi < (array_length childEl.children)) {
                this.addChildElement(element (itemAt childEl.children fi))
                fi = (fi + 1)
            }
            return
        }
        if (this.isRenderableElement(childEl)) {
            element.addChild(childEl)
        }
    }

    ; ==========================================================================
    ; Expression Evaluation
    ; ==========================================================================
    
    fn evaluateExpr:EvHandle (node:TSNode) {
        def exprK:int (this.nodeKindOf(node))
        ; Fast dispatch: the node types that dominate evaluation of real scripts
        ; (variable reads, member/array access, calls, arithmetic) are checked
        ; first so the common case does not fall through the whole if-chain.
        if (exprK == 1) {
            ; Resolution memo: an identifier read walks the scope chain hashing
            ; its name at every level. The depth is a property of the syntactic
            ; position, so it is walked once and reused -- and RE-VERIFIED, so a
            ; stale memo costs one probe and a fallback rather than answering
            ; with the wrong binding. A `with` scope makes depth meaningless.
            if (false == anyWithScope) {
                if (node.scopeHops >= 0) {
                    def memoHit@(optional):EvHandle (context.tryLookupAtDepth(node.name node.scopeHops))
                    if memoHit {
                        return (unwrap memoHit)
                    }
                } {
                    node.scopeHops = (context.depthOfBinding(node.name))
                }
            }
            return (this.lookupIdentifier(node.name))
        }
        ; D-ASYNC: `await x` reached through the EAGER FALLBACK path -- an async
        ; body whose spine the resumable driver cannot step. The body is running
        ; on the host stack, so it cannot suspend; instead the awaited value is
        ; settled by DRAINING the job queue until it is, and the result becomes
        ; this expression's value (or is thrown here, so a surrounding
        ; try/catch still sees it).
        ;
        ; This differs from a stepped await in ORDERING -- the rest of the
        ; caller does not get to run first -- but it produces the right values
        ; and the call still answers a promise, where before it silently
        ; answered undefined and the function returned its result raw. The
        ; stepped path, which is the one nearly all code takes, is exact.
        if (exprK == 50) {
            def awV:EvHandle (EvValueBridge.taggedUndefined())
            if node.left {
                awV = (this.evaluateExpr((unwrap node.left)))
            }
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            return (this.awaitBlocking(awV))
        }
        ; `yield x` reached through the EAGER FALLBACK path: the value joins
        ; the buffer the generator call is collecting, and the expression
        ; evaluates to undefined because there is no suspension to receive a
        ; value back into. A body the resumable driver accepts never gets here
        ; -- its yields are stepped by genStepValue instead.
        if (exprK == 26) {
            def yv:EvHandle (EvValueBridge.taggedUndefined())
            if node.left {
                yv = (this.evaluateExpr((unwrap node.left)))
            }
            if (genDepth > 0) {
                if ((array_length genCollect) >= genLimit) {
                    this.throwSpecError("RangeError" "generator produced too many values: this engine collects a generator eagerly, so an unbounded generator cannot be consumed lazily")
                    return (EvValueBridge.taggedUndefined())
                }
                ; `yield* xs` delegates: the operand's items join the buffer
                ; one at a time rather than the iterable joining as one value.
                if node.delegate {
                    def sub:[EvHandle] (this.forOfItemList(yv))
                    def di:int 0
                    while (di < (array_length sub)) {
                        push genCollect (itemAt sub di)
                        di = (di + 1)
                    }
                } {
                    push genCollect yv
                }
            }
            return (EvValueBridge.taggedUndefined())
        }
        ; PERF: a numeric literal is held as source TEXT, so evaluating it means
        ; parsing that text -- and a loop bound is evaluated once per iteration.
        ; The parse is memoised on the node, and the case sits at the front
        ; rather than fifteen string comparisons down the chain.
        ; D-BIGINT: `123n`. The lexer keeps the suffix, so it is trimmed here and
        ; the digits parsed exactly -- which is the point: the value is the one
        ; the source wrote, not the nearest double to it.
        ; D-DYNIMPORT: `import(spec)`. It answers a PROMISE for the module's
        ; namespace, and the promise is the whole point -- a caller writes
        ; `import(p).then(...)` or awaits it, and a failure to resolve has to
        ; arrive as a REJECTION rather than as a thrown exception out of an
        ; expression. There was no case for the node at all, so `import(p)`
        ; evaluated to null and `.then` of null was a TypeError.
        ;
        ; The module is loaded through the same door a static import uses, so
        ; the two cannot disagree about resolution, caching or cycles.
        if (exprK == 63) {
            def impCap:EvHandle (this.newPromiseCapability((this.builtinGlobalObject("Promise"))))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            def impSpec:string ""
            if node.left {
                def specV:EvHandle (this.evaluateExpr((unwrap node.left)))
                if scriptThrew {
                    return (this.promiseRejectWith(impCap))
                }
                impSpec = (this.toStringOf(specV))
                if scriptThrew {
                    return (this.promiseRejectWith(impCap))
                }
            }
            if ((strlen impSpec) == 0) {
                def _ie:EvHandle (this.throwSpecError("TypeError" "import() requires a module specifier"))
                return (this.promiseRejectWith(impCap))
            }
            def nsValue:EvHandle (this.importModuleNamespace(impSpec))
            if scriptThrew {
                return (this.promiseRejectWith(impCap))
            }
            def _ir:EvHandle (this.capInvoke(impCap "__cap_resolve__" nsValue))
            if scriptThrew {
                return (EvValueBridge.taggedUndefined())
            }
            return (this.capPromiseOf(impCap))
        }
        if (exprK == 62) {
            def bigText:string node.value
            def bl:int (strlen bigText)
            if (bl > 0) {
                if ((substring bigText (bl - 1) bl) == "n") {
                    bigText = (substring bigText 0 (bl - 1))
                }
            }
            def blOk:[boolean]
            push blOk false
            def parsedBig:BigNum (BigNum.parse(bigText blOk))
            if (false == (itemAt blOk 0)) {
                return (this.throwSpecError("SyntaxError" "Invalid BigInt literal"))
            }
            return (this.makeBigIntValue(parsedBig))
        }
        if (exprK == 2) {
            if (false == node.numScanned) {
                node.numScanned = true
                def parsedNum@(optional):double (to_double node.value)
                if parsedNum {
                    node.numValue = (unwrap parsedNum)
                }
            }
            ; The VALUE is memoised too, not just the parse. Below 4096 the
            ; shared pool already answers; above it, minting a fresh EvHandle
            ; per evaluation made a loop bound cost one allocation per iteration.
            def numPool:EvalConstPool (EvalConstPool.__singleton())
            if (node.numCacheId >= 0) {
                return (numPool.literalAt(node.numCacheId))
            }
            def litVal:EvHandle (EvValueBridge.taggedNumber(node.numValue))
            node.numCacheId = (numPool.addLiteral(litVal))
            return litVal
        }
        ; D-OPTCHAIN: the chain's ROOT. Below it every link passes the
        ; short-circuit upward; here the value is consumed, so the flag is
        ; cleared and the whole chain answers undefined.
        if (exprK == 3) {
            def mOut:EvHandle (this.evaluateMemberExpr(node))
            if optChainAborted {
                if (optChainDepth == 0) {
                    optChainAborted = false
                }
                return (EvValueBridge.taggedUndefined())
            }
            return mOut
        }
        if (exprK == 4) {
            def cOut:EvHandle (this.evaluateCallExpr(node))
            if optChainAborted {
                if (optChainDepth == 0) {
                    optChainAborted = false
                }
                return (EvValueBridge.taggedUndefined())
            }
            return cOut
        }
        if (exprK == 16) {
            return (this.evaluateNewExpr(node))
        }
        ; D-HOLES: an array elision is an ABSENT element. It reads as undefined
        ; wherever a value is wanted, and `0 in [,1]` is false.
        if (exprK == 22) {
            return (EvValueBridge.taggedHole())
        }
        ; D-REGEX: `/pattern/flags` as a value.
        if (exprK == 21) {
            return (this.regexFromLiteral(node.value))
        }
        ; The comma operator evaluates every operand and yields the LAST. It had
        ; no case at all, so `(1, 2)` evaluated to undefined and any side effect
        ; in an earlier operand never ran.
        if (exprK == 19) {
            def seqOut:EvHandle (EvValueBridge.taggedUndefined())
            def si:int 0
            while (si < (array_length node.children)) {
                seqOut = (this.evaluateExpr((itemAt node.children si)))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                si = (si + 1)
            }
            return seqOut
        }
        if (exprK == 20) {
            ; D-SUPERCALL: inside a derived constructor `this` does not exist
            ; until super() has run.
            if derivedCtorPending {
                return (this.throwSpecError("ReferenceError" "Must call super constructor in derived class before accessing 'this'"))
            }
            ; D-GLOBALTHIS: outside any function, `this` is the global object.
            if (false == (context.has("this"))) {
                ; D-STRICT: a strict function called without a receiver has
                ; `this` undefined -- there is no substitution of the global
                ; object, which is what the suite checks a strict function's
                ; identity with.
                if strictMode {
                    if (this.insideFunctionCall()) {
                        return (EvValueBridge.taggedUndefined())
                    }
                }
                return (this.theGlobalObject())
            }
            return (context.lookup("this"))
        }
        if (exprK == 5) {
            return (this.evaluateBinaryExpr(node))
        }
        ; Assignment / update in value position: x = (y = 5), let d = c++, arr[i]++
        if (exprK == 6) {
            return (this.evaluateAssignValue(node))
        }
        if (exprK == 7) {
            return (this.evaluateUpdateValue(node))
        }
        ; Arrow / function expression as a value: capture the defining scope so the
        ; resulting closure is lexical when stored, returned or passed around.
        ; D-CLASSEXPR: `var C = class { ... }`. The class table is keyed by name,
        ; so an anonymous class expression is registered under a generated one
        ; and the value carries that key. `new C()` then resolves through the
        ; value rather than through the source-level name, which it does not have.
        if (exprK == 24) {
            return (this.registerClassExpression(node))
        }
        if (exprK == 17) {
            return (this.captureClosure(node))
        }
        if (exprK == 18) {
            return (this.captureClosure(node))
        }
        ; Literals
        if (exprK == 2) {
            def numVal@(optional):double (to_double node.value)
            if numVal {
                return (EvValueBridge.taggedNumber((unwrap numVal)))
            }
            return (EvValueBridge.taggedNumber(0.0))
        }
        
        if (exprK == 8) {
            ; The lexer already removed the delimiters, so unquoting again ate
            ; real characters whenever the CONTENT began and ended with the same
            ; quote: `'\'hi\''` became `hi`, and `eval('"BJ"')` was handed the
            ; identifier BJ. That is the "lexer drops escaped quotes" gap -- it
            ; was never the lexer.
            return (EvValueBridge.taggedString(node.value))
        }
        
        ; D-TAGGED: `tag`a${x}b`` calls tag with the LITERAL parts as an array
        ; -- carrying a `raw` of the same length -- and the substitution values
        ; after them. The node had no case at all, so a tagged template
        ; evaluated to nothing.
        if (exprK == 48) {
            return (this.evaluateTaggedTemplate(node))
        }
        if (exprK == 11) {
            ; Template literals have TemplateElement children with the text
            ; The text may contain ${...} expressions that need to be evaluated
            def templateText:string ""
            def ti:int 0
            while (ti < (array_length node.children)) {
                def templateChild:TSNode (itemAt node.children ti)
                if (templateChild.nodeType == "TemplateElement") {
                    ; Parse and evaluate any ${...} expressions in the template text
                    def rawText:string templateChild.value
                    def processedText:string (this.evaluateTemplateExpressions(rawText))
                    templateText = templateText + processedText
                }
                ti = ti + 1
            }
            return (EvValueBridge.taggedString(templateText))
        }
        
        ; D-NEWTARGET: `new.target` is the only meta property.
        if (exprK == 49) {
            return currentNewTarget
        }
        if (exprK == 9) {
            return (EvValueBridge.taggedBoolean((node.value == "true")))
        }
        
        if (exprK == 10) {
            return (EvValueBridge.taggedNull())
        }
        
        ; Identifier (variable lookup)
        if (exprK == 1) {
            return (this.lookupIdentifier(node.name))
        }
        
        ; Binary expression
        if (exprK == 5) {
            return (this.evaluateBinaryExpr(node))
        }
        
        ; Unary expression
        if (exprK == 12) {
            return (this.evaluateUnaryExpr(node))
        }
        
        ; Conditional expression (ternary)
        if (exprK == 13) {
            return (this.evaluateConditionalExpr(node))
        }
        
        ; Member expression
        if (exprK == 3) {
            def mOut2:EvHandle (this.evaluateMemberExpr(node))
            if optChainAborted {
                if (optChainDepth == 0) {
                    optChainAborted = false
                }
                return (EvValueBridge.taggedUndefined())
            }
            return mOut2
        }
        
        ; Array expression
        if (exprK == 14) {
            return (this.evaluateArrayExpr(node))
        }
        
        ; Object expression
        if (exprK == 15) {
            return (this.evaluateObjectExpr(node))
        }
        
        ; Parenthesized expression
        if (exprK == 23) {
            if node.left {
                def inner:TSNode (unwrap node.left)
                return (this.evaluateExpr(inner))
            }
        }

        ; Type assertion (expr as Type) — runtime ignores the type
        ; `expr as Type` — a sized-int Type performs AS truncation (u8/i32/…);
        ; any other type is erased (operand returned unchanged).
        if (node.nodeType == "TSAsExpression") {
            if node.left {
                def av:EvHandle (this.evaluateExpr((unwrap node.left)))
                return (this.applyTypeCast(node av))
            }
        }

        ; Non-null assertion (expr!) — runtime evaluates the operand
        if (node.nodeType == "TSNonNullExpression") {
            if node.left {
                return (this.evaluateExpr((unwrap node.left)))
            }
        }

        ; Angle-bracket type assertion (<Type>expr) — same as `expr as Type`.
        if (node.nodeType == "TSTypeAssertion") {
            if node.left {
                def tv:EvHandle (this.evaluateExpr((unwrap node.left)))
                return (this.applyTypeCast(node tv))
            }
        }
        
        ; JSX Element as expression (for props like children={<View/>})
        if (node.nodeType == "JSXElement") {
            def el:EvElement (this.evaluateJSXElement(node))
            return (EvValueBridge.taggedElement(el))
        }
        
        ; JSX Fragment as expression. The SAME evaluation as the JSX path, not
        ; a second one beside it: this branch used to mint a `div` container of
        ; its own, so `<>…</>` was a fragment when it was the whole body and a
        ; renderer's box when it was an expression -- which is what a component
        ; written `const Hi = () => <>…</>` hit.
        if (node.nodeType == "JSXFragment") {
            return (EvValueBridge.taggedElement((this.evaluateJSX(node))))
        }
        
        ; Call Expression (function calls)
        if (exprK == 4) {
            return (this.evaluateCallExpr(node))
        }
        
        return (EvValueBridge.taggedNull())
    }
    
    ; Evaluate a call expression (function call)
    ; Returns the function's return value as EvHandle
    fn evaluateCallExpr:EvHandle (node:TSNode) {
        ; §13.3.9 optional CALL: `f?.()` answers undefined when f is null or
        ; undefined and calls it otherwise. It shared the ordinary call path,
        ; which reached "f is not a function" -- the one thing the syntax exists
        ; to avoid. The callee is evaluated ONCE here, receiver and all, because
        ; falling through would evaluate it a second time.
        if (node.nodeType == "OptionalCallExpression") {
            if node.left {
                def ocCallee:TSNode (unwrap node.left)
                def ocIsMember:boolean ((this.nodeKindOf(ocCallee)) == 3)
                def ocThis:EvHandle (EvValueBridge.taggedUndefined())
                def ocFn:EvHandle (EvValueBridge.taggedUndefined())
                if ocIsMember {
                    if ocCallee.left {
                        optChainDepth = (optChainDepth + 1)
                        ocThis = (this.evaluateExpr((unwrap ocCallee.left)))
                        optChainDepth = (optChainDepth - 1)
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                        if optChainAborted {
                            return (EvValueBridge.taggedUndefined())
                        }
                    }
                    def ocKey:string ocCallee.name
                    if ocCallee.computed {
                        if ocCallee.right {
                            def ocKeyV:EvHandle (this.evaluateExpr((unwrap ocCallee.right)))
                            if scriptThrew {
                                return (EvValueBridge.taggedUndefined())
                            }
                            ocKey = (this.toPropertyKey(ocKeyV))
                            if scriptThrew {
                                return (EvValueBridge.taggedUndefined())
                            }
                        }
                    }
                    ; The RECEIVER is not what `?.` guards here -- `o.f?.()`
                    ; with o undefined is still a TypeError, so the read runs
                    ; and reports it.
                    ocFn = (this.getPropertyValue(ocThis ocKey))
                } {
                    optChainDepth = (optChainDepth + 1)
                    ocFn = (this.evaluateExpr(ocCallee))
                    optChainDepth = (optChainDepth - 1)
                }
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                if optChainAborted {
                    return (EvValueBridge.taggedUndefined())
                }
                if ((ocFn.isUndefined()) || (ocFn.isNull())) {
                    ; `f?.()` short-circuits the REST of the chain too, so
                    ; `o.f?.().x` is undefined rather than a read of undefined.
                    optChainAborted = true
                    return (EvValueBridge.taggedUndefined())
                }
                def ocArgs:[EvHandle] (this.collectCallArgs(node))
                if scriptThrew {
                    return (EvValueBridge.taggedUndefined())
                }
                if (false == (ocFn.isFunction())) {
                    return (this.throwSpecError("TypeError" "expression is not a function"))
                }
                if ocIsMember {
                    return (this.callFnValueWithValues((ocFn.withThisForCall(ocThis)) ocArgs))
                }
                return (this.callFnValueWithValues(ocFn ocArgs))
            }
        }
        if node.left {
            def callee:TSNode (unwrap node.left)
            
            ; Handle method calls (e.g., arr.map(), num.toFixed())
            if ((this.nodeKindOf(callee)) == 3) {
                ; D-SUPER: `super.m(...)` is not a member call on a VALUE --
                ; there is nothing to evaluate on the left. It resolves m on
                ; the executing method's home-class PARENT chain and runs it
                ; against the current `this`. Intercepted before the receiver
                ; evaluation below, which would only manufacture undefined.
                if callee.left {
                    def supRecv:TSNode (unwrap callee.left)
                    if (supRecv.nodeType == "Super") {
                        return (this.callSuperMethod(node callee))
                    }
                }
                ; Get the object and method name
                def obj:EvHandle (EvValueBridge.taggedNull())
                def methodName:string ""
                
                ; Get the object (left side of the member expression)
                if callee.left {
                    def objNode:TSNode (unwrap callee.left)
                    optChainDepth = (optChainDepth + 1)
                    obj = (this.evaluateExpr(objNode))
                    optChainDepth = (optChainDepth - 1)
                    if optChainAborted {
                        return (EvValueBridge.taggedUndefined())
                    }
                    ; `o?.m()` -- the callee is an OPTIONAL member, so a nullish
                    ; receiver ends the chain instead of being called on.
                    if callee.optional {
                        if ((obj.isNull()) || (obj.isUndefined())) {
                            optChainAborted = true
                            return (EvValueBridge.taggedUndefined())
                        }
                    }
                    ; A throw while evaluating the RECEIVER is the exception that
                    ; propagates. Carrying on called a method on the undefined
                    ; the aborted expression left behind, and the resulting
                    ; "not a function" TypeError replaced the real one --
                    ; `new RegExp("[b-a]").exec("a")` reported a TypeError where
                    ; the SyntaxError from the constructor was the answer.
                    if scriptThrew {
                        return (EvValueBridge.taggedUndefined())
                    }
                }
                
                ; D-COMPUTEDCALL: `o[expr]()` calls whatever KEY the index
                ; expression evaluates to -- never the text of the index node.
                ; Taking the node text made `fns[i]()` look up a method
                ; literally called "i". The key is evaluated exactly once,
                ; here, after the receiver (the order the spec fixes), and
                ; the by-name dispatch below resolves the resulting string --
                ; so `arr["push"](x)` still reaches the registry built-in.
                if callee.computed {
                    if callee.right {
                        def ckNode:TSNode (unwrap callee.right)
                        def ckVal:EvHandle (this.evaluateExpr(ckNode))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                        methodName = (this.toPropertyKey(ckVal))
                        if scriptThrew {
                            return (EvValueBridge.taggedUndefined())
                        }
                    }
                } {
                    ; Get the method name - try callee.name first (direct
                    ; property) then fall back to callee.right for a literal key
                    methodName = callee.name
                    if ((strlen methodName) == 0) {
                        if callee.right {
                            def propNode:TSNode (unwrap callee.right)
                            methodName = propNode.name
                            if ((strlen methodName) == 0) {
                                methodName = propNode.value
                            }
                        }
                    }
                }
                
                if (false == quiet) {
                    this.trace("Method call: " + methodName + " on value type=" + (obj.kindName()))
                }

                ; INLINE CACHE: this call site already resolved to a registry
                ; built-in under the current dispatch epoch. The guards prove
                ; the full resolution would reach the same place: the receiver
                ; is a clean array (right kind, no own properties, no
                ; per-instance prototype — arrays are never class instances),
                ; and the epoch proves no built-in prototype was minted,
                ; written or suppressed since the slow pass resolved. Opcodes
                ; are population-gated on ARITY too, so each body below is
                ; exactly the registry body for its shape.
                if (node.callSiteOp > 0) {
                    def icEp:EvDispatchEpoch (EvDispatchEpoch.__singleton())
                    if (node.callSiteEpoch == icEp.n) {
                        if (obj.isArrayValue()) {
                            if ((false == (obj.hasProto())) && (obj.ownPropsEmpty())) {
                                ; op 1: single-argument Array#push
                                if (node.callSiteOp == 1) {
                                    def icArgNode:TSNode (itemAt node.children 0)
                                    ; A transient-admitted argument (`i * 2`)
                                    ; evaluates into its expression slot and the
                                    ; NUMBER is stored without ever becoming a
                                    ; value object — the push allocates nothing.
                                    if (this.transientOperandOk(icArgNode 0)) {
                                        def icTv:EvHandle (this.evaluateExprTransient(icArgNode))
                                        if scriptThrew {
                                            return (EvValueBridge.taggedUndefined())
